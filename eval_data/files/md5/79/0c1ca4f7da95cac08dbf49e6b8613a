{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all elements across all possible odd-length subarrays.\n    It iterates through all subarrays, checking their length before summing.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i, n):\n            current_subarray = arr[i : j+1]\n            if len(current_subarray) % 2 != 0:\n                total_sum += sum(current_subarray)\n    return total_sum\n```"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"\n    Calculates the number of positive divisors for an integer and\n    returns True if the count is even, False otherwise.\n    \"\"\"\n    if number == 0:\n        return True  # 0 has 0 positive divisors, and 0 is an even number.\n\n    abs_N = abs(number)\n    divisor_count = 0\n\n    i = 1\n    # Iterate from 1 up to the square root of abs_N, without using math.sqrt directly.\n    while i * i <= abs_N:\n        if abs_N % i == 0:\n            if i * i == abs_N:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/767", "solution": "```python\nfrom collections import Counter\n\ndef get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"Counts pairs in a list that sum to a target value, handling duplicate numbers efficiently.\"\"\"\n    freq_map = Counter(numbers)\n    pair_count = 0\n\n    # Iterate over a copy of keys because the dictionary will be modified\n    for num in list(freq_map.keys()):\n        if num not in freq_map:\n            # This number has already been processed as a complement\n            continue\n\n        count_num = freq_map[num]\n        complement = target_sum - num\n\n        if complement in freq_map:\n            if num == complement:\n                # Case 1: Number is its own complement (e.g., 2 for target 4)\n                # Count combinations: n * (n - 1) / 2\n                pair_count += (count_num * (count_num - 1)) // 2\n            else:\n                # Case 2: Number and complement are different\n                # Add count_num * count_complement pairs\n                count_complement = freq_map[complement]\n                pair_count += count_num * count_complement\n\n            # Remove both numbers from the map to prevent double-counting\n            # and to mark them as processed.\n            del freq_map[num]\n            if complement in freq_map: # Complement might have been num itself\n                del freq_map[complement]\n\n    return pair_count\n```"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all elements across all odd-length subarrays of the input array.\n    It iterates all subarrays, summing elements if their length is odd.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n    return total_sum\n```"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(input_list: list[tuple]) -> list[tuple]:\n    \"\"\"\n    Calculates all unique combinations of sums of two distinct tuples from the input list.\n    Returns a list of unique sum tuples.\n    \"\"\"\n    unique_sums = set()\n    for tuple_a, tuple_b in itertools.combinations(input_list, 2):\n        sum_tuple = tuple(x + y for x, y in zip(tuple_a, tuple_b))\n        unique_sums.add(sum_tuple)\n    return list(unique_sums)"}
{"task_id": "Mbpp/770", "solution": "```python\ndef _validate_input(n: any) -> None:\n    \"\"\"\n    This function's original design was to validate input 'n'.\n    However, adding validation checks and raising exceptions for edge cases is forbidden by critical requirements.\n    \"\"\"\n    pass\n\ndef _calculate_odd_power_sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of the fourth power of the first n odd natural numbers.\n    It iterates from 1 to n, calculating (2*i - 1)^4 and summing the results.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_num = (2 * i - 1)\n        total_sum += odd_num ** 4\n    return total_sum\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    It orchestrates input (no-op) validation and the core sum computation.\n    \"\"\"\n    _validate_input(n)\n    return _calculate_odd_power_sum(n)\n```"}
{"task_id": "Mbpp/784", "solution": "```python\nfrom typing import List, Optional\n\nclass Number:\n    \"\"\"Encapsulates an integer number and provides parity checks.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self._value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the number.\"\"\"\n        return self._value\n\nclass NumberList:\n    \"\"\"Manages a list of Number objects and provides methods to find specific types.\"\"\"\n    def __init__(self, numbers_data: List[int]):\n        self._numbers: List[Number] = [Number(val) for val in numbers_data]\n\n    def get_first_even_number(self) -> Optional[int]:\n        \"\"\"Finds the first even number in the list.\"\"\"\n        for num_obj in self._numbers:\n            if num_obj.is_even():\n                return num_obj.get_value()\n        return None\n\n    def get_first_odd_number(self) -> Optional[int]:\n        \"\"\"Finds the first odd number in the list.\"\"\"\n        for num_obj in self._numbers:\n            if num_obj.is_odd():\n                return num_obj.get_value()\n        return None\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Calculates the product of the first even and first odd number in a given list.\n    Returns 0 if either the first even or first odd number is not found.\n    \"\"\"\n    num_list = NumberList(numbers)\n    first_even = num_list.get_first_even_number()\n    first_odd = num_list.get_first_odd_number()\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return 0\n```"}
{"task_id": "Mbpp/785", "solution": "```python\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple (e.g., \"(7, 8, 9)\")\n    into an actual tuple of integers (e.g., (7, 8, 9)).\n    \"\"\"\n    # Remove parentheses and split by comma.\n    elements_str = tuple_string.strip('()').split(',')\n    # Convert each element to an integer, filtering empty strings.\n    integer_elements = tuple(int(s.strip()) for s in elements_str if s.strip())\n    return integer_elements\n```"}
{"task_id": "Mbpp/785", "solution": "```python\ndef tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual integer tuple.\n    It parses the string by removing parentheses, splitting by comma, and converting elements to integers.\n    \"\"\"\n    # Extract the content inside the parentheses.\n    inner_str = tuple_str[1:-1]\n\n    # If the inner string is empty (for \"()\"), return an empty tuple.\n    if not inner_str:\n        return ()\n\n    # Split elements by comma, strip whitespace from each, and convert to integers.\n    elements = [int(s.strip()) for s in inner_str.split(',')]\n\n    return tuple(elements)\n```"}
{"task_id": "Mbpp/786", "solution": "```python\ndef right_insertion(sorted_list: list, value: any) -> int:\n    \"\"\"\n    Determines the rightmost insertion index for a value in a sorted list.\n    This function uses a binary search approach to efficiently find the insertion point.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else:  # value >= sorted_list[mid] ensures rightmost for duplicates\n            low = mid + 1\n    return low\n```"}
{"task_id": "Mbpp/786", "solution": "```python\nfrom typing import List, Any\n\ndef right_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Determines the index where 'value' should be inserted into 'sorted_list' to maintain sorted order,\n    placing it after all existing occurrences of 'value'.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
