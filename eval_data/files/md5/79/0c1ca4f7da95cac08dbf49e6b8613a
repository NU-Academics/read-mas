{"task_id": "Mbpp/440", "solution": "```python\nimport re\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a given word is an adverb using a simple heuristic and a small dictionary.\n    Checks for common '-ly' endings and a predefined list of adverbs.\n    \"\"\"\n    word_lower = word.lower()\n    common_adverbs = {\n        \"very\", \"often\", \"now\", \"then\", \"here\", \"there\", \"always\", \"never\", \"well\", \"fast\",\n        \"just\", \"soon\", \"early\", \"late\", \"almost\", \"already\", \"away\", \"back\", \"down\", \"far\",\n        \"forward\", \"in\", \"out\", \"up\", \"yet\", \"still\", \"too\", \"quite\", \"really\", \"so\", \"such\",\n        \"today\", \"tomorrow\", \"tonight\", \"yesterday\", \"ago\", \"hard\", \"low\", \"high\", \"near\",\n        \"straight\", \"only\", \"even\", \"alone\", \"together\", \"around\", \"everywhere\", \"somewhere\",\n        \"anywhere\", \"nowhere\", \"indoors\", \"outdoors\", \"upstairs\", \"downstairs\", \"sometimes\",\n        \"seldom\", \"frequently\", \"usually\", \"generally\", \"rarely\", \"scarcely\", \"hardly\", \"ever\"\n    }\n\n    if word_lower in common_adverbs:\n        return True\n\n    if len(word_lower) > 2 and word_lower.endswith(\"ly\"):\n        # Exclude common adjectives that end in -ly to reduce false positives.\n        adjective_ly_exceptions = {\n            \"friendly\", \"lovely\", \"ugly\", \"lonely\", \"silly\", \"holy\", \"daily\", \"early\",\n            \"ghostly\", \"heavenly\", \"jolly\", \"lively\", \"manly\", \"masterly\", \"melancholy\",\n            \"oily\", \"orderly\", \"scholarly\", \"stately\", \"timely\", \"unruly\", \"weekly\", \"yearly\",\n            \"comely\", \"costly\", \"curly\", \"deadly\", \"earthly\", \"elderly\", \"ghastly\", \"goodly\",\n            \"kingly\", \"leisurely\", \"likely\", \"lowly\", \"monthly\", \"princely\",\n            \"saintly\", \"seemly\", \"shapely\", \"spindly\", \"slovenly\", \"unlikely\", \"worldly\"\n        }\n        if word_lower not in adjective_ly_exceptions:\n            return True\n\n    return False\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\n    It tokenizes the sentence to identify words and checks each against simple adverb rules.\n    \"\"\"\n    word_pattern = re.compile(r'[a-zA-Z]+')\n\n    for match in word_pattern.finditer(sentence):\n        word_value = match.group(0)\n        original_start_index = match.start()\n\n        if _is_adverb(word_value):\n            original_end_index = original_start_index + len(word_value)\n            return (original_start_index, original_end_index, word_value)\n\n    return None\n```"}
{"task_id": "Mbpp/440", "solution": "```python\n_PUNCTUATION_CHARS = '!\\\"#$%&\\'()*+,-./:;<=>?@[\\\\]^_`{|}~'\n\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Strips punctuation from the beginning and end of a word.\"\"\"\n    return word.strip(_PUNCTUATION_CHARS)\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a word is an adverb using a simple heuristic.\"\"\"\n    common_adverbs = {'very', 'quickly', 'clearly', 'beautifully', 'loudly'}\n    if word.lower() in common_adverbs:\n        return True\n    return len(word) > 2 and word.lower().endswith('ly')\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"Finds the first adverb and its position in the sentence.\"\"\"\n    current_pos = 0\n    words = sentence.split()\n\n    for raw_word in words:\n        start_of_raw_word_in_sentence = sentence.find(raw_word, current_pos)\n\n        stripped_word = _strip_punctuation(raw_word)\n\n        if _is_adverb(stripped_word):\n            relative_start_in_raw = raw_word.find(stripped_word)\n            final_start_idx = start_of_raw_word_in_sentence + relative_start_in_raw\n            final_end_idx = final_start_idx + len(stripped_word)\n            return (final_start_idx, final_end_idx, stripped_word)\n\n        # Update current_pos to search for the next word, skipping any whitespace.\n        current_pos = start_of_raw_word_in_sentence + len(raw_word)\n        while current_pos < len(sentence) and sentence[current_pos].isspace():\n            current_pos += 1\n\n    return (-1, -1, \"\")\n```"}
