{"task_id": "Mbpp/119", "solution": "```python\nfrom typing import List, Union\n\ndef search(arr: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the element that appears only once in a sorted array.\n    The array is guaranteed to have exactly one unique element, with other elements appearing twice.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # Check if mid is the unique element.\n        # Case 1: mid is the first element.\n        if mid == 0:\n            if arr[mid] != arr[mid + 1]:\n                return arr[mid]\n            else:\n                low = mid + 2 # Skip the pair.\n        # Case 2: mid is the last element.\n        elif mid == len(arr) - 1:\n            if arr[mid] != arr[mid - 1]:\n                return arr[mid]\n            else:\n                high = mid - 2 # Skip the pair.\n        # Case 3: mid is in the middle.\n        else:\n            if arr[mid] != arr[mid - 1] and arr[mid] != arr[mid + 1]:\n                return arr[mid]\n            # If mid is part of a pair.\n            elif arr[mid] == arr[mid - 1]: # Current element is part of a left pair.\n                # Adjust search range based on the pair's starting index parity.\n                if (mid - 1) % 2 == 0:\n                    low = mid + 1\n                else:\n                    high = mid - 2\n            elif arr[mid] == arr[mid + 1]: # Current element is part of a right pair.\n                # Adjust search range based on the pair's starting index parity.\n                if mid % 2 == 0:\n                    low = mid + 2\n                else:\n                    high = mid - 1\n\n    # This return should ideally not be reached given the problem's constraints.\n    return -1\n```\n"}
{"task_id": "Mbpp/119", "solution": "```python\ndef search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array.\n    Assumes the array is sorted and all elements except one appear an even number of times.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Adjust mid to ensure it's at the beginning of a potential pair (an even index).\n        # This simplifies the logic for checking pairs (arr[mid], arr[mid+1]).\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If the current pair matches, the unique element must be in the right half.\n        if arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        # If the current pair doesn't match, the unique element is in the left half, including mid.\n        else:\n            high = mid\n\n    return arr[low]\n```"}
{"task_id": "Mbpp/120", "solution": "```python\ndef max_product_tuple(list_of_tuples: list[tuple[int, int]]) -> int:\n    \"\"\"Calculates the maximum absolute product from a list of integer tuples.\n    Assumes valid input structure as per type hint.\"\"\"\n    max_abs_product = 0\n    for num1, num2 in list_of_tuples:\n        product = num1 * num2\n        abs_product = abs(product)\n        max_abs_product = max(max_abs_product, abs_product)\n    return max_abs_product\n```"}
{"task_id": "Mbpp/123", "solution": "```python\ndef _sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer n.\n    Proper divisors include 1 but exclude n itself.\"\"\"\n    if n <= 1:\n        return 0\n\n    total = 1\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            total += i\n            if i * i != n:\n                total += n // i\n    return total\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all unique amicable numbers up to the specified limit.\n    It identifies amicable pairs (a, b) where sum_proper_divisors(a) = b and sum_proper_divisors(b) = a.\"\"\"\n    found_amicable_numbers = set()\n\n    for i in range(1, limit):\n        d_i = _sum_proper_divisors(i)\n\n        # Check conditions for a potential amicable pair (a, b) where a=i, b=d_i:\n        # d_i must be within the limit, not equal to i, and greater than 1.\n        if 1 < d_i < limit and d_i != i:\n            d_di = _sum_proper_divisors(d_i)\n\n            # If d_di equals i, then (i, d_i) is an amicable pair.\n            if d_di == i:\n                found_amicable_numbers.add(i)\n                found_amicable_numbers.add(d_i)\n\n    return sum(found_amicable_numbers)\n```"}
{"task_id": "Mbpp/123", "solution": "```python\nimport math\n\ndef calculate_proper_divisors_sum(num: int) -> int:\n    \"\"\"Calculates the sum of all proper divisors for a given positive integer.\n    Proper divisors include 1 but exclude the number itself.\"\"\"\n    if num <= 1:\n        return 0\n\n    sum_div = 1\n    for i in range(2, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            sum_div += i\n            if i * i != num:\n                sum_div += num // i\n    return sum_div\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Finds all unique amicable numbers up to n and returns their total sum.\n    It uses a helper function to calculate sums of proper divisors.\"\"\"\n    amicable_numbers_found = set()\n    for a in range(1, n + 1):\n        sum_div_a = calculate_proper_divisors_sum(a)\n\n        if sum_div_a > a and sum_div_a <= n:\n            sum_div_b = calculate_proper_divisors_sum(sum_div_a)\n\n            if sum_div_b == a:\n                amicable_numbers_found.add(a)\n                amicable_numbers_found.add(sum_div_a)\n\n    return sum(amicable_numbers_found)\n```"}
