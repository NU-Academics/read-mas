n: return False per BR-005 behavior for invalid characters.\n        return False\n\n    validator = BracketValidator()\n    result = validator.validate(bs)\n    return result.isBalanced", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n\n    # Module-level constant (defined inline due to prompt constraints)\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    # Helper class InputString (defined inline due to prompt constraints)\n    class InputString:\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            return len(self.value)\n\n    # Helper class VowelCounter (defined inline due to prompt constraints)\n    class VowelCounter:\n        def __init__(self, vowels: set[str] = None):\n            self.vowels = vowels if vowels is not None else VOWELS\n\n        def count(self, s: str) -> int:\n            normalized_s = s.lower()\n            count = 0\n\n            for char in normalized_s:\n                if char in self.vowels:\n                    count += 1\n\n            # 'y' is counted only when it is the final character of the word.\n            if len(normalized_s) > 0 and normalized_s[-1] == 'y':\n                count += 1\n            \n            return count\n\n    # Public facade function: delegates to VowelCounter.\n    counter = VowelCounter()\n    return counter.count(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "class ErrorHandler:\n    @staticmethod\n    def raiseTypeError(message: str) -> None:\n        raise TypeError(message)\nclass IntegerInput:\n    def __init__(self, value: int):\n        self.value = value\n\n    def toDigitString(self) -> str:\n        return str(abs(self.value))\nclass ShiftParameter:\n    def __init__(self, value: int):\n        self.value = value\n\n    def normalizedValue(self) -> int:\n        return self.value\nclass DigitSequence:\n    def __init__(self, digits: str):\n        self.digits = digits\n\n    def length(self) -> int:\n        return len(self.digits)\n\n    def reverse(self) -> str:\n        return self.digits[::-1]\n\n    def rotateRight(self, positions: int) -> str:\n        n = self.length()\n        if n == 0:\n            return \"\"\n        actual_shift = positions % n\n        return self.digits[-actual_shift:] + self.digits[:-actual_shift]\nclass CircularShiftOperation:\n    def execute(self, ds: DigitSequence, s: ShiftParameter) -> str:\n        shift = s.normalizedValue()\n        n = ds.length()\n\n        if shift == 0:\n            return ds.digits\n        elif 0 < shift <= n:\n            return ds.rotateRight(shift)\n        elif shift > n:\n            return ds.reverse()\n        # The design implies shift will be non-negative.\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        ErrorHandler.raiseTypeError(\"x and shift must be integers\")\n\n    integer_input = IntegerInput(x)\n    shift_parameter = ShiftParameter(shift)\n\n    digits_str = integer_input.toDigitString()\n    digit_sequence = DigitSequence(digits_str)\n\n    operation = CircularShiftOperation()\n    result_str = operation.execute(digit_sequence, shift_parameter)\n\n    return result_str", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n\n    class FruitCounts:\n        \"\"\"Holds the parsed counts of apples and oranges.\"\"\"\n        def __init__(self, apples: int, oranges: int):\n            self.apples = apples\n            self.oranges = oranges\n\n    class Parser:\n        \"\"\"Parses the input string to extract fruit counts.\"\"\"\n        def parse(self, s: str) -> 'FruitCounts':\n            s = s.strip()\n            \n            try:\n                apples_part, oranges_full_part = s.split(\" apples and \", 1)\n            except ValueError:\n                raise ValueError(\"Invalid format: missing ' apples and ' separator.\")\n                \n            try:\n                apples = int(apples_part.strip())\n            except ValueError:\n                raise ValueError(f\"Invalid number format for apples: '{apples_part.strip()}'\")\n\n            try:\n                oranges_part, _ = oranges_full_part.split(\" oranges\", 1)\n            except ValueError:\n                raise ValueError(\"Invalid format: missing ' oranges' suffix.\")\n            \n            try:\n                oranges = int(oranges_part.strip())\n            except ValueError:\n                raise ValueError(f\"Invalid number format for oranges: '{oranges_part.strip()}'\")\n                \n            return FruitCounts(apples, oranges)\n\n    class Validator:\n        \"\"\"Validates the total fruit count and parsed individual counts.\"\"\"\n        def validate_n(self, n):\n            if not isinstance(n, int):\n                raise TypeError(\"n must be int\")\n\n        def validate_counts(self, apples: int, oranges: int):\n            if not isinstance(apples, int) or not isinstance(oranges, int):\n                raise ValueError(\"Parsed fruit counts must be integers.\") \n            if apples < 0 or oranges < 0:\n                raise ValueError(\"Fruit counts (apples, oranges) must be non-negative.\")\n\n    parser = Parser()\n    counts = parser.parse(s)\n    \n    validator = Validator()\n    validator.validate_n(n)\n    validator.validate_counts(counts.apples, counts.oranges)\n    \n    mango_count = n - counts.apples - counts.oranges\n    \n    return mango_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "class Result:\n    \"\"\"Encapsulates the value and index of a plucked node.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def to_list(self) -> list[int]:\n        \"\"\"Converts the result to the required list format [value, index].\"\"\"\n        return [self.value, self.index]\nclass Branch:\n    \"\"\"Manages a collection of nodes and implements the plucking logic.\"\"\"\n    def __init__(self, nodes: list[int]):\n        self.nodes = nodes\n        self.length = len(nodes)\n\n    def pluck(self) -> Result | list:\n        \"\"\"Finds the smallest even node, prioritizing the smallest index on ties.\"\"\"\n        if self.length == 0:\n            return []\n\n        best_value = None\n        best_index = None\n\n        for i, v in enumerate(self.nodes):\n            if v % 2 == 0:  # Check if the value is even\n                if best_value is None or v < best_value:\n                    best_value = v\n                    best_index = i\n                # If v == best_value, the existing best_index (first occurrence) is preserved.\n\n        if best_value is None:\n            return []  # No even numbers found\n        else:\n            return Result(best_value, best_index)\ndef pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even-valued node with the smallest index from an array.\n    Returns [value, index] or [] if no even values or the array is empty.\n    \"\"\"\n    branch = Branch(nodes=arr)\n    branch_result = branch.pluck()\n\n    if branch_result == []:\n        return []\n    else:\n        # branch_result is a Result object at this point\n        return branch_result.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass AsciiMapper:\n    def toAscii(self, c: str) -> int:\n        return ord(c)\nclass UppercaseCharacter:\n    def __init__(self, value: str):\n        self.value = value\n        self._ascii_mapper = AsciiMapper()\n\n    def isUppercase(self) -> bool:\n        # Explicitly checks whether 'A' <= value <= 'Z'.\n        return 'A' <= self.value <= 'Z'\n\n    def asciiCode(self) -> int:\n        # Returns ASCII code via AsciiMapper.toAscii(value); caller should ensure isUppercase() is True.\n        return self._ascii_mapper.toAscii(self.value)\nclass Result:\n    def __init__(self, sum: int = 0):\n        self.sum = sum\nclass DigitSumService:\n    def digitSum(self, s: str) -> int:\n        input_string = InputString(s)\n        result = Result()\n\n        for char_value in input_string.value:\n            uppercase_char = UppercaseCharacter(char_value)\n            if uppercase_char.isUppercase():\n                result.sum += uppercase_char.asciiCode()\n        return result.sum\ndef digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n\n    Examples:\n        digitSum(\"\") => 0\n        digitSum(\"abAB\") => 131\n        digitSum(\"abcCd\") => 67\n        digitSum(\"helloE\") => 69\n        digitSum(\"woArBld\") => 131\n        digitSum(\"aAaaaXa\") => 153\n    \"\"\"\n    # Top-level public function. Delegates to DigitSumService().digitSum(s).\n    service = DigitSumService()\n    return service.digitSum(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    from collections import Counter\n\n    def validate_input(lst_to_validate):\n        # Validates if the input list is non-empty and contains only positive integers.\n        if not isinstance(lst_to_validate, list) or not lst_to_validate:\n            raise ValueError(\"Input must be a non-empty list.\")\n        for x in lst_to_validate:\n            if not isinstance(x, int)