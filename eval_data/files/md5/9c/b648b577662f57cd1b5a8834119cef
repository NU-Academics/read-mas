\n\n    if not s:\n        return \"\"\n\n    tokens = _split_preserve_spaces(s)\n\n    processed_tokens = []\n    for token in tokens:\n        if token == ' ':\n            processed_tokens.append(token)\n        else:\n            processed_tokens.append(_sort_chars_by_ascii(token))\n\n    return _reassemble_tokens(processed_tokens)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "class IntegerX:\n    \"\"\"Wrapper for the search integer x.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\nclass Coordinate:\n    \"\"\"Represents a coordinate pair (rowIndex, colIndex).\"\"\"\n    def __init__(self, rowIndex: int, colIndex: int):\n        self.rowIndex: int = rowIndex\n        self.colIndex: int = colIndex\nclass ResultList:\n    \"\"\"Container for collected Coordinates with sorting capability.\"\"\"\n    def __init__(self):\n        self.coordinates: list = []\n    def sort(self) -> None:\n        \"\"\"Sorts coordinates by rowIndex ascending, then colIndex descending.\"\"\"\n        self.coordinates.sort(key=lambda c: (c.rowIndex, -c.colIndex))\nclass SearchService:\n    \"\"\"Provides validation and search logic.\"\"\"\n    def validateInput(self, lst, x) -> bool:\n        \"\"\"Validates input types, returning True if valid.\"\"\"\n        # Per design constraints, assume inputs are valid and do not add isinstance() checks.\n        return True\n\n    def findAll(self, lst_data: list, x_obj: 'IntegerX') -> 'ResultList':\n        \"\"\"Finds all occurrences of x_obj.value in lst_data and returns them as a ResultList.\"\"\"\n        result_list = ResultList()\n        for r_idx, row_elements in enumerate(lst_data):\n            for c_idx, element_value in enumerate(row_elements):\n                if element_value == x_obj.value:\n                    result_list.coordinates.append(Coordinate(r_idx, c_idx))\n        return result_list\ndef get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    search_service = SearchService()\n\n    if not lst:\n        return []\n\n    # Call validateInput as per design, but it will effectively be a no-op given constraints.\n    search_service.validateInput(lst, x) \n\n    x_obj = IntegerX(x)\n    result_list = search_service.findAll(lst, x_obj)\n    result_list.sort()\n\n    return [(coord.rowIndex, coord.colIndex) for coord in result_list.coordinates]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Accepts exactly one parameter named lst (a list/sequence of integers). Returns the 2nd smallest distinct integer or None.\n    \"\"\"\n    distinct_values = sorted(list(set(lst)))\n\n    if len(distinct_values) < 2:\n        return None\n    else:\n        return distinct_values[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "from typing import List\nclass InputArray:\n    \"\"\"Encapsulates input and provides safe accessors.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = list(values) # Store a copy to avoid mutating original\n\n    def length(self) -> int:\n        return len(self.values)\n\n    def getFirst(self) -> int:\n        return self.values[0]\n\n    def getLast(self) -> int:\n        return self.values[-1]\nclass Validator:\n    \"\"\"Provides validation checks for the input array.\"\"\"\n    def isEmpty(self, input_array: InputArray) -> bool:\n        return input_array.length() == 0\n\n    def isSingleElement(self, input_array: InputArray) -> bool:\n        return input_array.length() == 1\n\n    def isAllNonNegative(self, input_array: InputArray) -> bool:\n        return all(x >= 0 for x in input_array.values)\nclass ParityChecker:\n    \"\"\"Computes sum and determines parity of numbers.\"\"\"\n    def computeSum(self, first: int, last: int) -> int:\n        return first + last\n\n    def isOdd(self, sum: int) -> bool:\n        return sum % 2 != 0\n\n    def isEven(self, sum: int) -> bool:\n        return sum % 2 == 0\nclass Sorter:\n    \"\"\"Provides methods for sorting lists.\"\"\"\n    def sortAscending(self, values: List[int]) -> List[int]:\n        return sorted(values) # Returns a new sorted list\n\n    def sortDescending(self, values: List[int]) -> List[int]:\n        return sorted(values, reverse=True) # Returns a new sorted list\nclass ResultArray:\n    \"\"\"Represents the resulting array to be returned.\"\"\"\n    def __init__(self):\n        self.values: List[int] = []\n\n    def copyFrom(self, input_array: InputArray) -> None:\n        self.values = list(input_array.values) # Copies values from InputArray\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    input_obj = InputArray(values=array)\n    validator = Validator()\n\n    if validator.isEmpty(input_obj):\n        return []\n\n    if validator.isSingleElement(input_obj):\n        r = ResultArray()\n        r.copyFrom(input_obj)\n        return r.values\n\n    # The design specifies isAllNonNegative check as optional/caller responsibility.\n    # It's not explicitly used in the pseudocode for flow control.\n\n    parity = ParityChecker()\n    first = input_obj.getFirst()\n    last = input_obj.getLast()\n    s = parity.computeSum(first, last)\n\n    sorter = Sorter()\n    \n    if parity.isOdd(s):\n        sorted_values = sorter.sortAscending(input_obj.values)\n    else: # sum is even\n        sorted_values = sorter.sortDescending(input_obj.values)\n    \n    r = ResultArray()\n    r.values = sorted_values\n    return r.values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/24": [{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    for d in range(n - 1, 0, -1):\n        if n % d == 0:\n            return d", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase letters forward by 4 positions.\"\"\"\n    \n    encrypted_chars = []\n    shift = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate 0-indexed position, add shift, apply modulo for wrap-around\n            shifted_position = (ord(char) - ord('a') + shift) % 26\n            # Convert back to character\n  