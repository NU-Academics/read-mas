{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\n\ndef _is_tuple_divisible(current_tuple: Tuple[int, ...], k: int) -> bool:\n    \"\"\"\n    Determines if all elements within a single tuple are perfectly divisible by k.\n    Raises ValueError if k is zero.\n    \"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor 'k' cannot be zero.\")\n    for element in current_tuple:\n        if element % k != 0:\n            return False\n    return True\n\ndef find_tuples(input_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    This function leverages a helper `_is_tuple_divisible` for per-tuple checks.\n    \"\"\"\n    filtered_tuples: List[Tuple[int, ...]] = []\n    for current_tuple in input_tuples:\n        if _is_tuple_divisible(current_tuple, k):\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples"}
