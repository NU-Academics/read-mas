{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Calculates the product of the first even and first odd numbers in the input list.\n    Returns None if either number is not found.\n    \"\"\"\n    def _find_first_even(numbers: list[int]) -> int | None:\n        \"\"\"Finds the first even number in the list, or None if not found.\"\"\"\n        for num in numbers:\n            if num % 2 == 0:\n                return num\n        return None\n\n    def _find_first_odd(numbers: list[int]) -> int | None:\n        \"\"\"Finds the first odd number in the list, or None if not found.\"\"\"\n        for num in numbers:\n            if num % 2 != 0:\n                return num\n        return None\n\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int | float]) -> int | float:\n    \"\"\"Calculates the sum of all elements across all possible odd-length subarrays for a given input array.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 != 0:\n                total_sum += sum(subarray)\n\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value: 'Comparable') -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This function uses binary search to find the correct index.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of a tuple to an actual tuple of integers.\n    For example, \"(7, 8, 9)\" becomes (7, 8, 9).\n    \"\"\"\n    content = tuple_string[1:-1].strip()\n    if not content:\n        return ()\n\n    numeric_strings = [s.strip() for s in content.split(',') if s.strip()]\n    return tuple(int(s) for s in numeric_strings)"}
