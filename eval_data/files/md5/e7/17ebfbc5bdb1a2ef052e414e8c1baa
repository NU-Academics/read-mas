{"task_id": "Mbpp/170", "solution": "def sum_range_list(list_of_numbers: list[int], start_index: int, end_index: int) -> int:\n    \"\"\"Calculates the sum of elements within a specified range in a list.\n    Returns 0 if the list is empty or indices are out of bounds or invalid.\"\"\"\n    \n    n = len(list_of_numbers)\n\n    # Validate if the list is empty\n    if n == 0:\n        return 0\n\n    # Validate start_index\n    if not (0 <= start_index < n):\n        return 0\n\n    # Validate end_index\n    if not (0 <= end_index < n):\n        return 0\n\n    # Validate range order\n    if start_index > end_index:\n        return 0\n\n    # Calculate the sum using list slicing\n    return sum(list_of_numbers[start_index : end_index + 1])"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles the special case where n=0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    power = 1\n    # Doubles 'power' until it is at least 'n'.\n    while power < n:\n        power *= 2\n    \n    return power"}
{"task_id": "Mbpp/166", "solution": "class Integer:\n    \"\"\"Represents a single integer value and provides methods to determine its parity.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Returns True if the integer is even, False otherwise.\"\"\"\n        return self._value % 2 == 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the integer is odd, False otherwise.\"\"\"\n        return self._value % 2 != 0\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Integer):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash(self._value)\n\n    def __lt__(self, other):\n        \"\"\"Enable comparison for consistent ordering in pairs.\"\"\"\n        if not isinstance(other, Integer):\n            return NotImplemented\n        return self._value < other._value\n\nclass IntegerPair:\n    \"\"\"Represents a unique pair of Integer objects and determines if their bitwise XOR sum is even.\"\"\"\n    def __init__(self, first: Integer, second: Integer):\n        # Ensure consistent ordering for uniqueness (e.g., (5,4) == (4,5))\n        if first < second:\n            self._first = first\n            self._second = second\n        else:\n            self._first = second\n            self._second = first\n\n    def getXORResult(self) -> int:\n        \"\"\"Returns the bitwise XOR result of the two integers in the pair.\"\"\"\n        return self._first._value ^ self._second._value\n\n    def isXOREven(self) -> bool:\n        \"\"\"Returns True if the XOR result is even, False otherwise.\"\"\"\n        return self.getXORResult() % 2 == 0\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, IntegerPair):\n            return NotImplemented\n        return (self._first == other._first and self._second == other._second)\n\n    def __hash__(self) -> int:\n        return hash((self._first, self._second))\n\nclass IntegerList:\n    \"\"\"Manages a collection of Integer objects and generates all unique pairs from them.\"\"\"\n    def __init__(self, values: list[int]):\n        self._integers = [Integer(value) for value in values]\n\n    def addInteger(self, integer: Integer):\n        \"\"\"Adds an Integer object to the list.\"\"\"\n        self._integers.append(integer)\n\n    def getUniquePairs(self) -> set[IntegerPair]:\n        \"\"\"Generates and returns a set of all unique IntegerPair objects from the list.\"\"\"\n        unique_pairs = set()\n        n = len(self._integers)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pair = IntegerPair(self._integers[i], self._integers[j])\n                unique_pairs.add(pair)\n        return unique_pairs\n\ndef find_even_pair(input_list: list[int]) -> int:\n    \"\"\"Counts the number of pairs of integers in input_list that XOR to an even number.\"\"\"\n    integer_list = IntegerList(input_list)\n    unique_pairs = integer_list.getUniquePairs()\n\n    count = 0\n    for pair in unique_pairs:\n        if pair.isXOREven():\n            count += 1\n    return count"}
