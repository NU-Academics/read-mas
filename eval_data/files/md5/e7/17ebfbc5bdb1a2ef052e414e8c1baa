{"task_id": "Mbpp/448", "solution": "_perrin_cache = {0: 3, 1: 0, 2: 2}\n\ndef _get_perrin_number(index: int) -> int:\n    \"\"\"Calculates the Perrin number at a given index (P(index)).\"\"\"\n    if index < 0:\n        raise ValueError(\"Perrin number index cannot be negative.\")\n    if index in _perrin_cache:\n        return _perrin_cache[index]\n\n    _perrin_cache[index] = _get_perrin_number(index - 2) + _get_perrin_number(index - 3)\n    return _perrin_cache[index]\n\ndef cal_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(limit) (inclusive).\"\"\"\n    if limit < 0:\n        raise ValueError(\"Limit for Perrin sum cannot be negative.\")\n\n    total_sum = 0\n    for i in range(limit + 1):\n        total_sum += _get_perrin_number(i)\n    return total_sum"}
