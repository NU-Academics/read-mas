{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    This function iterates up to the square root of n to find all divisors.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list[list[any]]) -> dict[any, int]:\n    \"\"\"Flattens a nested list structure and returns a dictionary of element frequencies.\"\"\"\n\n    def _flatten_list_of_lists(nested_list: list[list[any]]) -> list[any]:\n        \"\"\"Converts a list of lists into a single, one-dimensional list.\"\"\"\n        return [item for sublist in nested_list for item in sublist]\n\n    def _count_element_frequencies(flat_list: list[any]) -> dict[any, int]:\n        \"\"\"Calculates the frequency of each element in a given flat list.\"\"\"\n        frequency_map = {}\n        for item in flat_list:\n            frequency_map[item] = frequency_map.get(item, 0) + 1\n        return frequency_map\n\n    flattened_list = _flatten_list_of_lists(list_of_lists)\n    frequency_map = _count_element_frequencies(flattened_list)\n    return frequency_map"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string equivalent without leading zeros.\n    The number 0 is represented as '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    current_number = decimal_number\n    while current_number > 0:\n        remainder = current_number % 2\n        binary_digits.append(str(remainder))\n        current_number //= 2\n    \n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: Sequence[float]) -> float:\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Returns 0.0 if the input sequence is empty to prevent division by zero.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(input_integer: int) -> int:\n    \"\"\"Computes and returns the smallest palindrome strictly greater than the input integer.\"\"\"\n\n    def _is_palindrome(n: int) -> bool:\n        \"\"\"Checks if a number is a palindrome.\"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    def _get_next_number(n: int) -> int:\n        \"\"\"Returns the next integer after n.\"\"\"\n        return n + 1\n\n    current_number = input_integer + 1\n    while not _is_palindrome(current_number):\n        current_number = _get_next_number(current_number)\n    return current_number"}
{"task_id": "Mbpp/101", "solution": "def kth_element(arr: list, k: int):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    if not (1 <= k <= len(arr)):\n        raise IndexError(\"Index out of bounds\")\n    \n    # Convert 1-based index to 0-based index\n    zero_based_k = k - 1\n    return arr[zero_based_k]"}
