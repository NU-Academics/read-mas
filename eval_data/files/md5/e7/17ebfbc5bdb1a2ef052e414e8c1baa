{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from the input_list.\n\n    Args:\n        input_list: The list from which to remove consecutive duplicates.\n\n    Returns:\n        A new list with consecutive duplicates removed.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple.\n    Returns a new tuple where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_a: list[int], list_b: list[int]) -> list[int]:\n    \"\"\"\n    Performs element-wise summation of two input lists of integers.\n    Returns a new list where each element is the sum of corresponding elements from the input lists.\n    \"\"\"\n    result = []\n    for i in range(len(list_a)):\n        result.append(list_a[i] + list_b[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "def lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius 'r' and height 'h'.\n    It uses the formula LateralSurfaceArea = pi * r * l, where l = sqrt(r^2 + h^2).\n    \"\"\"\n    import math\n    \n    # Calculate slant height 'l'\n    l = math.sqrt(r**2 + h**2)\n    \n    # Calculate lateral surface area\n    lateral_surface_area = math.pi * r * l\n    \n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    \"\"\"\n    transformed_string = input_string.replace(' ', ':')\n    transformed_string = transformed_string.replace(',', ':')\n    transformed_string = transformed_string.replace('.', ':')\n    return transformed_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target number is not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(numbers: list) -> int:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists.\n\n    It iterates through all sublists, computes their product, and sums them up.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(numbers)\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= numbers[j]\n            total_sum_of_products += current_product\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    # Convert the number to its binary representation.\n    binary_repr = bin(number)[2:]\n\n    # Handle cases where there are 0, 1, or 2 bits (no 'middle' bits to toggle).\n    if len(binary_repr) <= 2:\n        return number\n\n    first_bit = binary_repr[0]\n    last_bit = binary_repr[-1]\n    middle_bits = binary_repr[1:-1]\n\n    # Toggle each bit in the middle segment.\n    toggled_middle_bits = ''.join('1' if bit == '0' else '0' for bit in middle_bits)\n\n    # Reconstruct the new binary string and convert back to an integer.\n    new_binary_repr = first_bit + toggled_middle_bits + last_bit\n    return int(new_binary_repr, 2)"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"Locates the left insertion point for a specified value in sorted order.\n\n    This function uses binary search to find the index where 'value' should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
