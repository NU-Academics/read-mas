{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th element removed (1-based index).\n    If k is out of bounds, a shallow copy of the original list is returned.\n    \"\"\"\n    n = len(input_list)\n    if k < 1 or k > n:\n        return input_list[:]\n    \n    # Convert 1-based k to 0-based index\n    idx = k - 1\n    \n    # Create a new list by concatenating slices before and after the element to remove\n    return input_list[:idx] + input_list[idx+1:]"}
{"task_id": "Mbpp/611", "solution": "from typing import List\n\ndef max_of_nth(matrix: List[List[int]], n: int) -> int:\n    \"\"\"\n    Finds the maximum value in the n-th column of a given matrix.\n    Assumes a non-empty matrix and a valid column index n.\n    \"\"\"\n    column_values = []\n    for row in matrix:\n        column_values.append(row[n])\n    return max(column_values)"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists: list[list[Any]]) -> list[list[Any]]:\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two lists,\n    separating first and second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n\n    Raises:\n        ValueError: If the input tuples do not have the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        result.append(tuple1[i] % tuple2[i])\n\n    return tuple(result)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_tuple: tuple[tuple[float | int, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple within a tuple of tuples.\n    Returns a list of float values, each being the calculated average of a corresponding inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in input_tuple:\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        average = float(current_sum) / current_count\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "class ListLengthMismatchError(ValueError):\n    def __init__(self, message: str = \"Input lists must have the same length.\"): # pragma: no cover\n        super().__init__(message)\n\nclass DivisionByZeroError(ValueError):\n    def __init__(self, message: str, index: int, divisor_value: float): # pragma: no cover\n        super().__init__(f\"{message} at index {index} (divisor was {divisor_value}).\")\n        self.index = index\n        self.divisor_value = divisor_value\n\ndef div_list(list1: list[float | int], list2: list[float | int]) -> list[float]:\n    \"\"\"\n    Divides elements of list1 by corresponding elements of list2 element-wise.\n    Handles length mismatch and division by zero with custom exceptions.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ListLengthMismatchError()\n\n    result_list = []\n    for i in range(len(list1)):\n        numerator = list1[i]\n        divisor = list2[i]\n\n        if divisor == 0:\n            raise DivisionByZeroError(message=\"Cannot divide by zero\", index=i, divisor_value=float(divisor))\n\n        result_list.append(float(numerator) / divisor)\n\n    return result_list"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers_list: list[float | int], exponent_n: int) -> list[float | int]:\n    \"\"\"\n    Calculates the n-th power for each number in the input list.\n    Returns a new list where each element is the n-th power of the corresponding element.\n    \"\"\"\n    return [num ** exponent_n for num in numbers_list]"}
{"task_id": "Mbpp/620", "solution": "import itertools\n\ndef _is_divisible(a: int, b: int) -> bool:\n    \"\"\"Checks if two numbers are mutually divisible, handling division by zero.\"\"\"\n    if a == 0 and b == 0:\n        return True\n    if a == 0: # 0 is divisible by any non-zero number.\n        return True\n    if b == 0: # A non-zero number is not divisible by 0.\n        return False\n    return a % b == 0 or b % a == 0\n\ndef _generate_subsets(numbers: list[int]) -> list[list[int]]:\n    \"\"\"Generates all possible subsets from a given list of numbers.\"\"\"\n    all_subsets = []\n    for i in range(len(numbers) + 1):\n        for subset_tuple in itertools.combinations(numbers, i):\n            all_subsets.append(list(subset_tuple))\n    return all_subsets\n\ndef _is_subset_divisible(subset: list[int]) -> bool:\n    \"\"\"Checks if every pair of numbers within a given subset is mutually divisible.\"\"\"\n    if len(subset) <= 1:\n        return True # Empty or single-element subsets are always considered divisible.\n    \n    for a, b in itertools.combinations(subset, 2):\n        if not _is_divisible(a, b):\n            return False\n    return True\n\ndef _find_largest_divisible_subset_size(all_subsets: list[list[int]]) -> int:\n    \"\"\"Finds the maximum size among all divisible subsets.\"\"\"\n    max_size = 0\n    for subset in all_subsets:\n        if _is_subset_divisible(subset):\n            max_size = max(max_size, len(subset))\n    return max_size\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"Finds the size of the largest subset of numbers where every pair is mutually divisible.\"\"\"\n    all_subsets = _generate_subsets(numbers)\n    return _find_largest_divisible_subset_size(all_subsets)"}
