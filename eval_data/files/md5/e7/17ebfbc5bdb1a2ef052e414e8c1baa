{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # Corresponds to J(0) and J(1)\n        for _ in range(2, n + 1):\n            a, b = b, a + 2 * b\n        return b"}
{"task_id": "Mbpp/753", "solution": "def min_k(input_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the k records with the minimum integer values from a list of tuples, sorted by value.\n    The result will contain min(k, len(input_list)) records.\n    \"\"\"\n    if not input_list:\n        return []\n\n    # Sort the list based on the integer value (second element) of each tuple.\n    sorted_list = sorted(input_list, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list.\n    return sorted_list[:k]"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list):\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n    Raises ValueError if there are fewer than two distinct numbers.\n    \"\"\"\n    distinct_numbers = sorted(list(set(numbers)))\n    \n    if len(distinct_numbers) < 2:\n        raise ValueError(\"List must contain at least two distinct numbers.\")\n    \n    return distinct_numbers[1]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds common elements from three lists where elements appear at the same index.\n    An element is considered common if it appears in all three input lists at the exact same index.\n    \"\"\"\n    common_elements = []\n    min_len = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_len):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n    return common_elements"}
{"task_id": "Mbpp/758", "solution": "import collections\n\ndef unique_sublists(input_list: list) -> dict[tuple, int]:\n    \"\"\"Counts occurrences of unique sublists within a given list.\n    It converts each sublist into an immutable tuple representation and counts its occurrences.\"\"\"\n    counts = collections.Counter()\n\n    for item in input_list:\n        if isinstance(item, list):\n            tuple_representation = tuple(item)\n            counts[tuple_representation] += 1\n\n    return dict(counts)"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique pairs of strings where one is the reverse of the other.\n    \"\"\"\n\n    def _get_reverse_string(s: str) -> str:\n        \"\"\"Computes the exact reverse of a given string.\"\"\"\n        return s[::-1]\n\n    def _normalize_pair(s1: str, s2: str) -> tuple[str, str]:\n        \"\"\"Creates a canonical representation of a pair for unique counting.\"\"\"\n        return tuple(sorted((s1, s2)))\n\n    class ReversePairCounter:\n        \"\"\"Encapsulates logic for identifying and counting unique reverse string pairs.\"\"\"\n        def count_pairs(self, string_list_to_process: list[str]) -> int:\n            seen_strings = set()\n            unique_pairs = set()\n\n            for s1 in string_list_to_process:\n                if s1 in seen_strings:\n                    continue\n                \n                reversed_s1 = _get_reverse_string(s1)\n\n                # Check if the reverse of s1 exists in the remaining list (or has been processed)\n                # and if it's not the string itself (unless it's a palindrome)\n                for s2 in string_list_to_process:\n                    if s1 == s2: # Don't pair a string with itself, unless explicitly desired for palindromes.\n                        continue # Our definition of pair implies two distinct strings.\n\n                    if reversed_s1 == s2:\n                        unique_pairs.add(_normalize_pair(s1, s2))\n                \n                seen_strings.add(s1)\n                seen_strings.add(reversed_s1) # Add both to prevent double-checking\n\n            return len(unique_pairs)\n\n    counter = ReversePairCounter()\n    return counter.count_pairs(string_list)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\"\"\"\n    n = len(arr)\n    # An array with 0 or 1 element is trivially a min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate from the last non-leaf node up to the root (index 0).\n    # The last non-leaf node is at index (n // 2) - 1.\n    for i in range(n // 2 - 1, -1, -1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if the input string is a decimal number with exactly two digits after the decimal point.\"\"\"\n    if not input_string:\n        return False\n    \n    # Regex pattern: optional sign, one or more digits, a decimal point, exactly two digits.\n    # ^ asserts position at the start of the string.\n    # [+-]? matches an optional '+' or '-' sign.\n    # \\d+ matches one or more digits before the decimal point.\n    # \\. matches the literal decimal point.\n    # \\d{2} matches exactly two digits after the decimal point.\n    # $ asserts position at the end of the string.\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers_list: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if the list contains exactly one distinct element, False otherwise.\n    \"\"\"\n    if not numbers_list:\n        return False\n    \n    first_element = numbers_list[0]\n    for element in numbers_list:\n        if element != first_element:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"Checks if the given month number corresponds to a month with 30 days.\n    Raises ValueError if month_number is not between 1 and 12.\n    \"\"\"\n    if not (1 <= month_number <= 12):\n        raise ValueError(\"Month number must be between 1 and 12\")\n\n    months_with_30_days = {4, 6, 9, 11}\n    return month_number in months_with_30_days"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, size):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    This implementation first sorts the array for efficient comparison of adjacent elements.\n    \"\"\"\n    if size < 2:\n        return float('inf')\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(size - 1):\n        diff = sorted_arr[i+1] - sorted_arr[i]\n        if diff < min_diff:\n            min_diff = diff\n            \n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"\n    Counts the number of numerical digits (0-9) in the given string.\n    Returns the total count of numerical digits in the string.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if '0' <= char <= '9':\n            digit_count += 1\n    return digit_count"}
