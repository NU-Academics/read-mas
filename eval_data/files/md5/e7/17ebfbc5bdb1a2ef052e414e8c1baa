{"task_id": "Mbpp/555", "solution": "def _calculate_sum_of_natural_numbers(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return n * (n + 1) // 2\n\ndef _calculate_sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first n natural numbers.\"\"\"\n    sum_n = _calculate_sum_of_natural_numbers(n)\n    return sum_n * sum_n\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_of_cubes_val = _calculate_sum_of_cubes(n)\n    sum_of_natural_numbers_val = _calculate_sum_of_natural_numbers(n)\n\n    return sum_of_cubes_val - sum_of_natural_numbers_val"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n    Uppercase letters become lowercase, and lowercase letters become uppercase.\"\"\"\n    result_chars = []\n    for char in input_string:\n        if char.islower():\n            result_chars.append(char.upper())\n        elif char.isupper():\n            result_chars.append(char.lower())\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
