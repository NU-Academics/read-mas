{"task_id": "Mbpp/103", "solution": "_memo = {}\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using a recursive definition with memoization.\n    \"\"\"\n    if (n, m) in _memo:\n        return _memo[(n, m)]\n\n    # Base case for A(0,0)\n    if n == 0 and m == 0:\n        _memo[(n, m)] = 1\n        return 1\n\n    # Base cases for m out of valid range [0, n-1] for n > 0\n    if m < 0 or m >= n:\n        _memo[(n, m)] = 0\n        return 0\n\n    # Recursive step: A(n, k) = (k+1)A(n-1, k) + (n-k)A(n-1, k-1)\n    result = (m + 1) * eulerian_num(n - 1, m) + \\\n             (n - m) * eulerian_num(n - 1, m - 1)\n\n    _memo[(n, m)] = result\n    return result"}
