{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"\n    Reverses the order of elements in the input array from the beginning\n    up to the K-th position (1-indexed).\n    \"\"\"\n    # Extract the portion of the array to be reversed and reverse it.\n    reversed_part = array[:k][::-1]\n    # Combine the reversed part with the remaining part of the array.\n    return reversed_part + array[k:]"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters students from the input dictionary whose height and weight are\n    greater than or equal to the specified minimal height and minimal weight.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        if height >= minimal_height and weight >= minimal_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[Union[int, float]]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost among all valid paths in a square matrix.\n    A valid path starts at (0,0), ends at (N-1, N-1), and moves only right or down.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the matrix with its cost and coordinates.\"\"\"\n        def __init__(self, cost: float, row: int, column: int):\n            self.cost: float = cost\n            self.row: int = row\n            self.column: int = column\n\n    class Path:\n        \"\"\"Represents a sequence of cells forming a valid path, with calculated properties.\"\"\"\n        def __init__(self, initial_cells: list[Cell]):\n            self.cells: list[Cell] = list(initial_cells)\n            self.totalCost: float = sum(cell.cost for cell in self.cells)\n            self.numberOfCells: int = len(self.cells)\n            self.averageCost: float = self.totalCost / self.numberOfCells if self.numberOfCells > 0 else 0.0\n\n        def add_cell(self, cell: Cell) -> None:\n            \"\"\"Adds a cell to the path and updates its properties.\"\"\"\n            self.cells.append(cell)\n            self.totalCost += cell.cost\n            self.numberOfCells += 1\n            self.averageCost = self.totalCost / self.numberOfCells if self.numberOfCells > 0 else 0.0\n\n    class PathFinder:\n        \"\"\"Finds all valid paths from top-left to bottom-right in a given matrix.\"\"\"\n        def __init__(self, matrix: list[list[Union[int, float]]]):\n            self._matrix: list[list[float]] = [[float(val) for val in row] for row in matrix]\n            self._N: int = len(matrix)\n            self._all_paths: list[Path] = []\n\n        def _is_valid_move(self, r: int, c: int) -> bool:\n            \"\"\"Checks if the given row and column indices are within matrix bounds.\"\"\"\n            return 0 <= r < self._N and 0 <= c < self._N\n\n        def _traverse(self, r: int, c: int, current_path_cells: list[Cell]) -> None:\n            \"\"\"Recursive helper to explore all valid paths.\"\"\"\n            current_cell = Cell(self._matrix[r][c], r, c)\n            current_path_cells.append(current_cell)\n\n            if r == self._N - 1 and c == self._N - 1:\n                self._all_paths.append(Path(current_path_cells))\n            else:\n                if self._is_valid_move(r, c + 1):\n                    self._traverse(r, c + 1, list(current_path_cells))\n                if self._is_valid_move(r + 1, c):\n                    self._traverse(r + 1, c, list(current_path_cells))\n\n        def find_all_paths(self) -> list[Path]:\n            \"\"\"Initiates the pathfinding process and returns all valid paths.\"\"\"\n            self._all_paths = []\n            if self._N == 0:\n                return []\n            self._traverse(0, 0, [])\n            return self._all_paths\n\n    path_finder = PathFinder(matrix)\n    all_valid_paths: list[Path] = path_finder.find_all_paths()\n\n    if not all_valid_paths:\n        return 0.0\n\n    max_avg = 0.0\n    for path in all_valid_paths:\n        if path.averageCost > max_avg:\n            max_avg = path.averageCost\n\n    return max_avg"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates the sum of all digits of 'base' raised to 'power'.\"\"\"\n    calculated_value = base ** power\n    calculated_value_str = str(calculated_value)\n    digit_sum = 0\n    for digit_char in calculated_value_str:\n        digit_sum += int(digit_char)\n    return digit_sum"}
