{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise ValueError(\"Input must be a tuple.\")\n\n    string_parts = []\n    for item in input_tuple:\n        if not isinstance(item, int) or item <= 0:\n            raise ValueError(\"All elements in the tuple must be positive integers.\")\n        string_parts.append(str(item))\n\n    concatenated_string = \"\".join(string_parts)\n    return int(concatenated_string)"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the single element that appears only once in a sorted array.\n    All other elements are assumed to appear exactly twice.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n\n        # Ensure mid is at an even index for pair comparison\n        # If mid is odd, make it even by decrementing\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the pair at mid and mid+1 is the same\n        if arr[mid] == arr[mid + 1]:\n            # The unique element is in the right half\n            left = mid + 2\n        else:\n            # The unique element is in the left half (or is arr[mid])\n            right = mid\n\n    return arr[left]"}
{"task_id": "Mbpp/111", "solution": "from typing import Any\n\ndef common_in_nested_lists(nested_lists: list[list[Any]]) -> set[Any]:\n    \"\"\"\n    Finds elements that are common to all inner lists within a given list of nested lists.\n    Returns these common elements as a set.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize the set of common elements with the first list\n    # If the first list is empty, no elements can be common to all lists\n    common_elements = set(nested_lists[0])\n    if not common_elements:\n        return set()\n\n    # Iterate through the remaining lists and intersect with the current common_elements set\n    for current_list in nested_lists[1:]:\n        common_elements.intersection_update(set(current_list))\n        # Optimization: If the set of common elements becomes empty, no further common elements can be found\n        if not common_elements:\n            break\n\n    return common_elements"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_abs_product = 0\n\n    for num1, num2 in list_of_tuples:\n        product = num1 * num2\n        abs_product = abs(product)\n        if abs_product > max_abs_product:\n            max_abs_product = abs_product\n            \n    return max_abs_product"}
{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of common divisors for two given positive integers.\"\"\"\n\n    def _get_divisors(n: int) -> set[int]:\n        \"\"\"Finds all positive divisors of a given positive integer n.\"\"\"\n        divs = set()\n        for i in range(1, int(n**0.5) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        return divs\n\n    divisors_num1 = _get_divisors(num1)\n    divisors_num2 = _get_divisors(num2)\n\n    common_divisors = divisors_num1.intersection(divisors_num2)\n    return sum(common_divisors)"}
{"task_id": "Mbpp/125", "solution": "def _validate_binary_string(s: str) -> None:\n    \"\"\"Validates that the input string consists only of '0's and '1's.\"\"\"\n    if not s.strip():\n        raise ValueError(\"Input string cannot be empty or whitespace.\")\n    if not all(char in ('0', '1') for char in s):\n        raise ValueError(\"Input string must contain only '0's and '1's.\")\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Computes the maximum difference between the count of '0's and '1's\n    for any substring of the given binary string.\n    \"\"\"\n    _validate_binary_string(binary_string)\n\n    # Transform '0' to 1 and '1' to -1.\n    transformed_array = [1 if char == '0' else -1 for char in binary_string]\n\n    max_so_far = float('-inf')\n    current_sum = 0\n    min_prefix_sum = 0 # Tracks the minimum prefix sum encountered so far\n\n    for x in transformed_array:\n        current_sum += x\n        # The difference for a substring ending at current_index is current_sum - min_prefix_sum\n        max_so_far = max(max_so_far, current_sum - min_prefix_sum)\n        min_prefix_sum = min(min_prefix_sum, current_sum)\n\n    return int(max_so_far)"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers from 1 up to a specified limit.\"\"\"\n\n    class Number:\n        \"\"\"Encapsulates a number and provides methods to calculate its proper divisors and their sum.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def get_proper_divisors(self) -> list[int]:\n            \"\"\"Calculates and returns a list of all proper divisors of the number, excluding itself.\"\"\"\n            if self._value <= 1:\n                return []\n            divisors = [1]\n            for i in range(2, int(self._value**0.5) + 1):\n                if self._value % i == 0:\n                    divisors.append(i)\n                    if i * i != self._value:\n                        divisors.append(self._value // i)\n            return divisors\n\n        def get_sum_of_proper_divisors(self) -> int:\n            \"\"\"Calculates and returns the sum of all proper divisors.\"\"\"\n            return sum(self.get_proper_divisors())\n\n    class AmicablePair:\n        \"\"\"Determines if two distinct numbers form an amicable pair based on their proper divisor sums.\"\"\"\n        def __init__(self, number1: Number, number2: Number):\n            self._number1 = number1\n            self._number2 = number2\n\n        def is_amicable(self) -> bool:\n            \"\"\"Checks if the two numbers form an amicable pair based on the sums of their proper divisors.\"\"\"\n            if self._number1._value == self._number2._value:\n                return False\n\n            sum_div_n1 = self._number1.get_sum_of_proper_divisors()\n            sum_div_n2 = self._number2.get_sum_of_proper_divisors()\n\n            return (sum_div_n1 == self._number2._value) and \\\n                   (sum_div_n2 == self._number1._value)\n\n    total_sum = 0\n    # Stores numbers already identified as part of an amicable pair to avoid re-calculation and double-counting.\n    found_amicable_numbers = set()\n\n    for m in range(1, limit + 1):\n        if m in found_amicable_numbers:\n            continue\n\n        num_m = Number(m)\n        sum_m = num_m.get_sum_of_proper_divisors()\n\n        # Check conditions for a potential amicable pair (m, sum_m).\n        if sum_m != m and sum_m <= limit and sum_m not in found_amicable_numbers:\n            num_sum_m = Number(sum_m)\n            sum_n = num_sum_m.get_sum_of_proper_divisors()\n\n            pair = AmicablePair(num_m, num_sum_m)\n            if pair.is_amicable():\n                total_sum += m\n                total_sum += sum_m\n                found_amicable_numbers.add(m)\n                found_amicable_numbers.add(sum_m)\n\n    return total_sum"}
