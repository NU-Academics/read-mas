{"task_id": "Mbpp/129", "solution": "from typing import List, Optional\n\nclass Matrix:\n    \"\"\"Represents the input two-dimensional array and its dimensions.\"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self.elements = elements\n        self.num_rows = len(elements)\n        self.num_cols = len(elements[0]) if self.num_rows > 0 else 0\n\nclass CalculatedSums:\n    \"\"\"Stores all intermediate and final sums derived from the matrix.\"\"\"\n    def __init__(self, row_sums: List[int], col_sums: List[int], main_diagonal_sum: int, anti_diagonal_sum: int, expected_magic_sum: Optional[int] = None):\n        self.row_sums = row_sums\n        self.col_sums = col_sums\n        self.main_diagonal_sum = main_diagonal_sum\n        self.anti_diagonal_sum = anti_diagonal_sum\n        self.expected_magic_sum = expected_magic_sum\n\ndef _is_square_matrix(matrix_obj: Matrix) -> bool:\n    \"\"\"Verifies if the input matrix is square.\"\"\"\n    return matrix_obj.num_rows > 0 and matrix_obj.num_rows == matrix_obj.num_cols\n\ndef _calculate_sums(matrix_obj: Matrix) -> CalculatedSums:\n    \"\"\"Calculates all row, column, main diagonal, and anti-diagonal sums.\"\"\"\n    n = matrix_obj.num_rows\n    elements = matrix_obj.elements\n\n    row_sums = [0] * n\n    col_sums = [0] * n\n    main_diagonal_sum = 0\n    anti_diagonal_sum = 0\n\n    for i in range(n):\n        for j in range(n):\n            val = elements[i][j]\n            row_sums[i] += val\n            col_sums[j] += val\n            if i == j:\n                main_diagonal_sum += val\n            if i + j == n - 1:\n                anti_diagonal_sum += val\n    \n    expected_magic_sum = row_sums[0] if n > 0 else None\n\n    return CalculatedSums(row_sums, col_sums, main_diagonal_sum, anti_diagonal_sum, expected_magic_sum)\n\ndef _compare_sums(calculated_sums: CalculatedSums) -> bool:\n    \"\"\"Compares all calculated sums to determine if they are equal.\"\"\"\n    if calculated_sums.expected_magic_sum is None:\n        return False\n\n    expected_sum = calculated_sums.expected_magic_sum\n\n    if any(r_sum != expected_sum for r_sum in calculated_sums.row_sums):\n        return False\n    \n    if any(c_sum != expected_sum for c_sum in calculated_sums.col_sums):\n        return False\n            \n    if calculated_sums.main_diagonal_sum != expected_sum:\n        return False\n        \n    if calculated_sums.anti_diagonal_sum != expected_sum:\n        return False\n        \n    return True\n\ndef magic_square_test(matrix_elements: List[List[int]]) -> bool:\n    \"\"\"Checks if a given matrix is a magic square.\"\"\"\n    matrix_obj = Matrix(matrix_elements)\n\n    if not _is_square_matrix(matrix_obj):\n        return False\n\n    calculated_sums = _calculate_sums(matrix_obj)\n    \n    return _compare_sums(calculated_sums)"}
