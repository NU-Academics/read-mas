{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list) -> int:\n    \"\"\"\n    Calculates the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    Handles all-negative lists by returning the largest (least negative) number.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_so_far = numbers[0]\n    current_max = numbers[0]\n\n    for i in range(1, len(numbers)):\n        current_max = max(numbers[i], current_max + numbers[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit differences between two integers.\n    Orchestrates digit extraction, padding, difference calculation, and summation.\n    \"\"\"\n    def _get_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts individual digits from a non-negative integer into a list.\n        \"\"\"\n        if number == 0:\n            return [0]\n        return [int(d) for d in str(number)]\n\n    def _pad_digits(digits1: list[int], digits2: list[int]) -> tuple[list[int], list[int]]:\n        \"\"\"\n        Pads the shorter list of digits with leading zeros to match the length of the longer list.\n        \"\"\"\n        len1 = len(digits1)\n        len2 = len(digits2)\n        max_len = max(len1, len2)\n\n        padded_digits1 = [0] * (max_len - len1) + digits1\n        padded_digits2 = [0] * (max_len - len2) + digits2\n        return padded_digits1, padded_digits2\n\n    def _calculate_digit_differences(digits1: list[int], digits2: list[int]) -> list[int]:\n        \"\"\"\n        Calculates the absolute difference for each pair of corresponding digits from two equally-sized digit lists.\n        \"\"\"\n        differences = []\n        for d1, d2 in zip(digits1, digits2):\n            differences.append(abs(d1 - d2))\n        return differences\n\n    def _sum_differences(differences: list[int]) -> int:\n        \"\"\"\n        Sums all the absolute digit differences calculated.\n        \"\"\"\n        return sum(differences)\n\n    digits1 = _get_digits(num1)\n    digits2 = _get_digits(num2)\n\n    padded_digits1, padded_digits2 = _pad_digits(digits1, digits2)\n\n    differences = _calculate_digit_differences(padded_digits1, padded_digits2)\n\n    total_sum = _sum_differences(differences)\n    return total_sum"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(list_of_integers: list[int], num_elements: int) -> int:\n    \"\"\"\n    Counts the number of unique pairs (a, b) from list_of_integers\n    such that (a ^ b) is an odd number.\n    \"\"\"\n    odd_pair_count = 0\n\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements):\n            element_a = list_of_integers[i]\n            element_b = list_of_integers[j]\n\n            xor_result = element_a ^ element_b\n\n            if xor_result & 1 == 1:\n                odd_pair_count += 1\n\n    return odd_pair_count"}
