{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number for a given non-negative integer n.\n    Uses dynamic programming and the recurrence relation B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k.\n    \"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    # Helper function for binomial coefficient C(n, k)\n    def combinations(n_val, k_val):\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        res = 1\n        for i_val in range(k_val):\n            res = res * (n_val - i_val) // (i_val + 1)\n        return res\n\n    bell = [0] * (n + 1)\n    bell[0] = 1\n\n    # Use the recurrence B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k\n    for i in range(1, n + 1):\n        current_bell_n = 0\n        for k in range(i):\n            current_bell_n += combinations(i - 1, k) * bell[k]\n        bell[i] = current_bell_n\n\n    return bell[n]"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list):\n    \"\"\"Checks if a sub_list is present contiguously and in order within a main_list.\"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True  # An empty list is always a sublist.\n    if m > n:\n        return False  # A sublist cannot be longer than the main list.\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list) -> bool:\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    is_increasing = True\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            is_increasing = False\n            break\n\n    is_decreasing = True\n    for i in range(n - 1):\n        if arr[i] < arr[i+1]:\n            is_decreasing = False\n            break\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the Comb Sort algorithm.\n    It returns a new sorted list, leaving the original list unchanged.\n    \"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return input_list[:] # Return a copy even for small lists\n\n    arr = input_list[:]  # Create a mutable copy to perform sorting\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(items: list[str], pattern_elements: list[str]) -> bool:\n    # Checks if the sequence of items follows the given pattern by establishing a consistent one-to-one mapping.\n    # Returns True if a consistent mapping exists, False otherwise.\n    if len(items) != len(pattern_elements):\n        return False\n\n    item_to_pattern = {}\n    pattern_to_item = {}\n\n    for item, pattern_element in zip(items, pattern_elements):\n        if item in item_to_pattern:\n            if item_to_pattern[item] != pattern_element:\n                return False\n        else:\n            item_to_pattern[item] = pattern_element\n\n        if pattern_element in pattern_to_item:\n            if pattern_to_item[pattern_element] != item:\n                return False\n        else:\n            pattern_to_item[pattern_element] = item\n\n    return True"}
