{"task_id": "Mbpp/739", "solution": "class TriangularNumber:\n    \"\"\"Encapsulates a triangular number's index, value, and provides methods to calculate its digit count.\"\"\"\n    def __init__(self, index: int):\n        self._index = index\n        self._value = index * (index + 1) // 2\n\n    def get_value(self) -> int:\n        \"\"\"Returns the calculated triangular number value.\"\"\"\n        return self._value\n\n    def get_digit_count(self) -> int:\n        \"\"\"Calculates and returns the number of digits in the triangular number's value.\"\"\"\n        return len(str(self._value))\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly 'n' digits.\n    Iteratively checks triangular numbers until one with 'n' digits is found.\n    \"\"\"\n    k = 1\n    while True:\n        tri_num = TriangularNumber(k)\n        if tri_num.get_digit_count() == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string):\n    \"\"\"\n    Checks if all characters in the input string are identical.\n    Handles empty and single-character strings as cases where all characters are \"the same\".\n    \"\"\"\n    if not input_string or len(input_string) == 1:\n        return True\n\n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n    return True"}
