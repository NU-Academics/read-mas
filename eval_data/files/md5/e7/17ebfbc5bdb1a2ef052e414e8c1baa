{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in an input string where the sum of the digits\n    of the substring is equal to the length of the substring.\n    \"\"\"\n    count = 0\n    n = len(input_string)\n\n    for i in range(n):  # Start index of substring\n        current_sum = 0\n        for j in range(i, n):  # End index of substring\n            current_sum += int(input_string[j]) # Add current digit to sum\n            current_length = (j - i) + 1 # Calculate current substring length\n\n            if current_sum == current_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Calculates the maximum difference between available pairs in the given tuple list.\n    It orchestrates the domain models to achieve the calculation.\n    \"\"\"\n\n    class AbsoluteDifference:\n        \"\"\"Encapsulates an integer value representing an absolute difference.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def get_value(self) -> int:\n            return self._value\n\n    class MaximumAbsoluteDifference:\n        \"\"\"Encapsulates an integer value representing the maximum absolute difference found.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def get_value(self) -> int:\n            return self._value\n\n    class Tuple:\n        \"\"\"Represents a pair of numerical elements and calculates their absolute difference.\"\"\"\n        def __init__(self, element1: int, element2: int):\n            self._element1 = element1\n            self._element2 = element2\n\n        def calculateAbsoluteDifference(self) -> AbsoluteDifference:\n            return AbsoluteDifference(abs(self._element1 - self._element2))\n\n    class TupleList:\n        \"\"\"Manages a collection of Tuple objects and orchestrates finding the maximum absolute difference.\"\"\"\n        def __init__(self, raw_tuples: list[tuple[int, int]]):\n            self._tuples = [Tuple(e1, e2) for e1, e2 in raw_tuples]\n\n        def findMaximumAbsoluteDifference(self) -> MaximumAbsoluteDifference:\n            if not self._tuples:\n                return MaximumAbsoluteDifference(0)\n\n            max_diff = 0\n            for tpl in self._tuples:\n                diff = tpl.calculateAbsoluteDifference().get_value()\n                if diff > max_diff:\n                    max_diff = diff\n            return MaximumAbsoluteDifference(max_diff)\n\n    tuple_list_obj = TupleList(tuple_list)\n    max_abs_diff_obj = tuple_list_obj.findMaximumAbsoluteDifference()\n    return max_abs_diff_obj.get_value()"}
