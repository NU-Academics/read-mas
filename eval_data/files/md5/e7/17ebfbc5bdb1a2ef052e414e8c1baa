{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: List[float]) -> int:\n    class InputList:\n        \"\"\"Encapsulates the input list of numbers and provides its length.\"\"\"\n        def __init__(self, numbers: List[float]):\n            self._numbers = numbers\n\n        def get_length(self) -> int:\n            \"\"\"Returns the total count of numbers in the list.\"\"\"\n            return len(self._numbers)\n\n        def get_numbers(self) -> List[float]:\n            \"\"\"Returns the original list of numbers.\"\"\"\n            return self._numbers\n\n    class Number:\n        \"\"\"Encapsulates a single number and provides its rounded integer value.\"\"\"\n        def __init__(self, value: float):\n            self._value = value\n\n        def get_rounded_value(self) -> int:\n            \"\"\"Returns the value rounded to the nearest integer.\"\"\"\n            return round(self._value)\n\n    class OutputValue:\n        \"\"\"Encapsulates the final calculated result.\"\"\"\n        def __init__(self, result: int):\n            self._final_result = result\n\n        def get_result(self) -> int:\n            \"\"\"Returns the encapsulated final result.\"\"\"\n            return self._final_result\n\n    input_list = InputList(numbers)\n\n    rounded_numbers_sum = 0\n    for num_value in input_list.get_numbers():\n        number_obj = Number(num_value)\n        rounded_numbers_sum += number_obj.get_rounded_value()\n\n    list_length = input_list.get_length()\n\n    final_result_value = rounded_numbers_sum * list_length\n\n    output_obj = OutputValue(final_result_value)\n    return output_obj.get_result()"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first 'n' natural numbers.\n    \"\"\"\n    total_sum_of_cubes = 0.0\n    for i in range(1, n + 1):\n        total_sum_of_cubes += float(i ** 3)\n\n    average_result = total_sum_of_cubes / n\n    return average_result"}
