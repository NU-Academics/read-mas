{"task_id": "Mbpp/293", "solution": "import math\n\nclass RightAngledTriangle:\n    \"\"\"A helper class to encapsulate the Pythagorean theorem logic.\"\"\"\n    def __init__(self):\n        pass\n\n    def calculate_third_side(self, side1: float, side2: float) -> float:\n        \"\"\"Calculates the hypotenuse given two legs of a right-angled triangle.\"\"\"\n        return math.sqrt(side1**2 + side2**2)\n\ndef otherside_rightangle(side1, side2):\n    \"\"\"\n    Calculates the length of the third side of a right-angled triangle,\n    assuming side1 and side2 are the lengths of the two legs.\n    \"\"\"\n    calculator = RightAngledTriangle()\n    return calculator.calculate_third_side(side1, side2)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Calculates the total number of inversions in a given array.\n\n    An inversion is defined as a pair of indices (i, j) such that i < j\n    and the element at index i is greater than the element at index j (arr[i] > arr[j]).\n    \"\"\"\n    n = len(arr)\n    inv_count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of name-score entries.\n    Returns (None, 0) if the input list is empty.\n    \"\"\"\n    if not entries:\n        return (None, 0)\n\n    aggregated_scores = {}\n    for name, score in entries:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = None\n    max_score = 0\n\n    for name, score in aggregated_scores.items():\n        if max_name is None or score > max_score:\n            max_name = name\n            max_score = score\n\n    return (max_name, max_score)"}
