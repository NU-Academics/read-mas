{"task_id": "Mbpp/794", "solution": "import re\n\nclass String:\n    \"\"\"Represents the input string to be matched.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string's value.\"\"\"\n        return self._value\n\nclass MatchResult:\n    \"\"\"Stores the boolean outcome of a match operation.\"\"\"\n    def __init__(self, is_match: bool):\n        self._is_match = is_match\n\n    def get_is_match(self) -> bool:\n        \"\"\"Returns the match status.\"\"\"\n        return self._is_match\n\nclass Pattern:\n    \"\"\"Encapsulates the specific pattern definition and its matching logic.\"\"\"\n    def __init__(self, definition: str):\n        self._definition = definition\n\n    def matches(self, text: String) -> MatchResult:\n        \"\"\"Evaluates if the given String matches this pattern using fullmatch.\"\"\"\n        match = re.fullmatch(self._definition, text.get_value())\n        return MatchResult(match is not None)\n\nclass Matcher:\n    \"\"\"Orchestrates the matching process between a String and a Pattern.\"\"\"\n    def match(self, text: String, pattern: Pattern) -> MatchResult:\n        \"\"\"Performs the matching operation.\"\"\"\n        return pattern.matches(text)\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"Public API function to match a string against the 'a' followed by anything, ending in 'b' pattern.\"\"\"\n    text_obj = String(text)\n    pattern_obj = Pattern(\"^a.*b$\")\n    matcher_obj = Matcher()\n    match_result_obj = matcher_obj.match(text_obj, pattern_obj)\n    return match_result_obj.get_is_match()"}
