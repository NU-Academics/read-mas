{"task_id": "Mbpp/588", "solution": "def big_diff(input_list):\n    \"\"\"Calculates the difference between the largest and smallest value in a given list.\n    Returns 0 for empty or single-element lists.\n    \"\"\"\n    if not input_list or len(input_list) == 1:\n        return 0\n\n    largest = max(input_list)\n    smallest = min(input_list)\n\n    return int(largest - smallest)"}
{"task_id": "Mbpp/589", "solution": "def perfect_squares(start, end):\n    \"\"\"\n    Finds perfect squares between two given numbers, inclusive.\n    Assumes positive integer inputs and start <= end.\n    \"\"\"\n    perfect_squares_list = []\n\n    if start < 0 or end < 0: # This case should ideally be handled by a Range class's validation as per design,\n        # but since we are not using classes here, we add a simple check to reflect the 'positive integers' rule.\n        return []\n\n    # Calculate the square roots of the range boundaries\n    start_sqrt = math.ceil(math.sqrt(start))\n    end_sqrt = math.floor(math.sqrt(end))\n\n    for i in range(int(start_sqrt), int(end_sqrt) + 1):\n        square = i * i\n        # Ensure the calculated square falls within the given inclusive range\n        if start <= square <= end:\n            perfect_squares_list.append(square)\n\n    return perfect_squares_list"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius, angleRadians):\n    \"\"\"\n    Converts polar coordinates (radius, angleRadians) to rectangular coordinates (x, y).\n    Calculates x and y using trigonometry.\n    \"\"\"\n    x = radius * math.cos(angleRadians)\n    y = radius * math.sin(angleRadians)\n    return x, y"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial co-efficients C(n, k) * C(n, k+1).\n    The sum is calculated for k from 0 to n-1.\n    \"\"\"\n\n    def _factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        if num < 0:\n            # For binomial coefficients, negative factorials result in 0 value.\n            # However, arguments to _factorial within BinomialCoefficient will always be non-negative due to checks.\n            return 0\n        res = 1\n        for i in range(1, num + 1):\n            res *= i\n        return res\n\n    class BinomialCoefficient:\n        \"\"\"Encapsulates the calculation of a single binomial coefficient C(n, k).\"\"\"\n        def __init__(self, n: int, k: int):\n            self._n = n\n            self._k = k\n\n        def calculateValue(self) -> int:\n            \"\"\"Calculates and returns the binomial coefficient C(n, k).\"\"\"\n            # C(n, k) is 0 if k < 0 or k > n.\n            if self._k < 0 or self._k > self._n:\n                return 0\n\n            numerator = _factorial(self._n)\n            denominator = _factorial(self._k) * _factorial(self._n - self._k)\n            \n            # Use integer division as binomial coefficients are always integers.\n            return numerator // denominator\n\n    class BinomialSumCalculator:\n        \"\"\"Orchestrates the calculation of the sum of the product of consecutive binomial coefficients.\"\"\"\n        def calculateSumOfProduct(self, n: int) -> int:\n            \"\"\"Computes the sum of C(n, k) * C(n, k+1) for k from 0 to n-1.\"\"\"\n            total_sum = 0\n            # The loop runs for k from 0 to n-1.\n            for k in range(n):\n                # Calculate C(n, k)\n                coeff_nk = BinomialCoefficient(n, k)\n                value_nk = coeff_nk.calculateValue()\n\n                # Calculate C(n, k+1)\n                coeff_nk_plus_1 = BinomialCoefficient(n, k + 1)\n                value_nk_plus_1 = coeff_nk_plus_1.calculateValue()\n\n                total_sum += value_nk * value_nk_plus_1\n            return total_sum\n\n    calculator = BinomialSumCalculator()\n    return calculator.calculateSumOfProduct(n)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_str: str) -> str:\n    \"\"\"Removes leading zeroes from an IP address string.\n    This is the main entry point for the utility.\n    \"\"\"\n    class IPAddress:\n        \"\"\"Encapsulates an IP address, handling parsing, cleaning, and formatting.\"\"\"\n        def __init__(self, raw_address: str):\n            self._raw_address = raw_address\n            self._octets = self._parse_and_clean_octets(raw_address)\n\n        def _parse_and_clean_octets(self, raw_address: str) -> list[str]:\n            \"\"\"Parses the raw IP address into octets and cleans each one.\"\"\"\n            octet_strings = raw_address.split('.')\n            cleaned_octets = [self._clean_octet(octet) for octet in octet_strings]\n            return cleaned_octets\n\n        def _clean_octet(self, octet_str: str) -> str:\n            \"\"\"Removes leading zeroes from a single octet string.\"\"\"\n            return str(int(octet_str))\n\n        def get_cleaned_address(self) -> str:\n            \"\"\"Returns the cleaned IP address string.\"\"\"\n            return \".\".join(self._octets)\n\n    ip_address = IPAddress(ip_address_str)\n    return ip_address.get_cleaned_address()"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    if number < 0:\n        return False\n\n    num_str = str(number)\n    n = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    \"\"\"\n\n    def _find_first_even(numbers: list[int]) -> int | None:\n        \"\"\"Finds the first even number in a list.\"\"\"\n        for num in numbers:\n            if num % 2 == 0:\n                return num\n        return None\n\n    def _find_first_odd(numbers: list[int]) -> int | None:\n        \"\"\"Finds the first odd number in a list.\"\"\"\n        for num in numbers:\n            if num % 2 != 0:\n                return num\n        return None\n\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first n natural numbers.\n\n    Raises a ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    sum_val = n * (n + 1) // 2\n    average_val = sum_val / n\n    return (sum_val, average_val)"}
