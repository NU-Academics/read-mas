{"task_id": "Mbpp/306", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\nInteger = int\n\ndef max_sum_increasing_subseq(arr: List[Number], n: Integer, i: Integer, k: Integer) -> Number:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i]\n    that includes arr[k] as a mandatory element, where k > i.\n    \"\"\"\n    if not arr or n == 0:\n        return 0\n\n    dp_sums = [0] * (i + 1)\n    actual_max_prefix_sum = 0\n\n    for current_idx in range(i + 1):\n        current_val = arr[current_idx]\n\n        if current_val < arr[k]:\n            current_max_ending_at_j = current_val\n            for prev_idx in range(current_idx):\n                if arr[prev_idx] < current_val:\n                    current_max_ending_at_j = max(current_max_ending_at_j, dp_sums[prev_idx] + current_val)\n            dp_sums[current_idx] = current_max_ending_at_j\n            actual_max_prefix_sum = max(actual_max_prefix_sum, current_max_ending_at_j)\n        else:\n            # Elements >= arr[k] cannot precede arr[k] in an increasing subsequence to `actual_max_prefix_sum`.\n            dp_sums[current_idx] = current_val\n\n    return actual_max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1: list, list2: list, k: int) -> list:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list, using a min-heap.\n    \"\"\"\n    import heapq\n\n    if k == 0:\n        return []\n\n    # Initialize a min-heap to store the k largest products found so far.\n    # The heap will store (product_value, original_product_index) to handle duplicate product values.\n    # We don't need the index for this problem, but it's good practice for general heap usage.\n    min_heap = []\n\n    for num1 in list1:\n        for num2 in list2:\n            product = num1 * num2\n            if len(min_heap) < k:\n                heapq.heappush(min_heap, product)\n            elif product > min_heap[0]:\n                heapq.heapreplace(min_heap, product)\n\n    # Extract elements from the min-heap and sort them in descending order.\n    # The heap contains the k largest products, but they are not sorted.\n    result = []\n    while min_heap:\n        result.append(heapq.heappop(min_heap))\n    \n    # heapq.nsmallest or nlargest would return sorted, but we built it manually.\n    # So we sort it explicitly.\n    result.sort(reverse=True)\n    \n    return result"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\nclass Word:\n    \"\"\"Represents a single word and provides methods for character-based checks.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def starts_with(self, letter: str) -> bool:\n        \"\"\"Checks if the word starts with the given letter (case-insensitive).\"\"\"\n        return self._value.lower().startswith(letter.lower())\n\n    def get_value(self) -> str:\n        \"\"\"Returns the raw string value of the word.\"\"\"\n        return self._value\n\nclass FilterCriteria:\n    \"\"\"Encapsulates the filtering condition for words.\"\"\"\n    def __init__(self, start_letter: str):\n        self._start_letter = start_letter\n\n    def matches(self, word: Word) -> bool:\n        \"\"\"Determines if a given Word object matches the criteria.\"\"\"\n        return word.starts_with(self._start_letter)\n\nclass WordList:\n    \"\"\"Manages a collection of raw input strings and provides a method to convert them into Word objects.\"\"\"\n    def __init__(self, raw_strings: List[str]):\n        self._raw_strings = raw_strings\n\n    def split_into_words(self) -> List[Word]:\n        \"\"\"Splits all raw strings into individual Word objects.\"\"\"\n        all_words = []\n        for s in self._raw_strings:\n            individual_words = [word for word in s.split() if word]\n            all_words.extend([Word(w) for w in individual_words])\n        return all_words\n\nclass WordProcessor:\n    \"\"\"Orchestrates the word filtering and extraction logic based on provided criteria.\"\"\"\n    def process(self, word_list: WordList, criteria: FilterCriteria) -> Tuple[str, str]:\n        \"\"\"Processes the word list, filters words, and returns the first two matching words as a tuple of strings.\"\"\"\n        all_words = word_list.split_into_words()\n        filtered_words_values = []\n\n        for word_obj in all_words:\n            if criteria.matches(word_obj):\n                filtered_words_values.append(word_obj.get_value())\n                if len(filtered_words_values) == 2:\n                    break\n\n        # This will raise an IndexError if fewer than two words are found,\n        # adhering to the example's expectation of always finding two.\n        return (filtered_words_values[0], filtered_words_values[1])\n\ndef start_withp(word_list_strings: List[str]) -> Tuple[str, str]:\n    \"\"\"The main entry point for the P-Word Extractor.\n    Processes a list of strings to find two words starting with 'p'.\n    \"\"\"\n    word_list = WordList(word_list_strings)\n    criteria = FilterCriteria('p')\n    processor = WordProcessor()\n    return processor.process(word_list, criteria)"}
