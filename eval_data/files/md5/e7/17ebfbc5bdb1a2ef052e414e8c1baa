{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    This function counts occurrences and identifies the most frequent item.\n    \"\"\"\n    if not input_list:\n        return None\n\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1\n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string, keeping non-vowels in place.\n    'y' is not considered a vowel.\n    \"\"\"\n    _VOWEL_SET = frozenset('aeiouAEIOU')\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return char in _VOWEL_SET\n\n    char_list = list(s)\n    vowels_found = []\n    vowel_indices = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowels_found.append(char)\n            vowel_indices.append(i)\n\n    vowels_found.reverse()\n\n    for i in range(len(vowel_indices)):\n        original_index = vowel_indices[i]\n        char_list[original_index] = vowels_found[i]\n\n    return \"\".join(char_list)"}
