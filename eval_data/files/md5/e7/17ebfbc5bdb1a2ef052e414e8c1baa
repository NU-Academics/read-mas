{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"Counts pairs in a list that sum to a target value, accounting for duplicates by index.\"\"\"\n    pair_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth powers of the first 'n' odd natural numbers.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    current_sum = 0\n    for k in range(1, n + 1):\n        odd_number = (2 * k - 1)\n        fourth_power = odd_number ** 4\n        current_sum += fourth_power\n    return current_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements present in list1 but not in list2.\n    The order of elements in the returned list is not guaranteed.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    difference = set1 - set2\n    return list(difference)"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the input_string.\n    Filters the list of words and then joins them back into a single string.\n    \"\"\"\n    words = input_string.split(' ')\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(list_of_numbers: list) -> bool:\n    \"\"\"\n    Checks whether every odd index contains an odd number in the given list.\n    Returns True if all numbers at odd indices are odd, False otherwise.\n    \"\"\"\n    for i, num in enumerate(list_of_numbers):\n        if i % 2 != 0:  # Check if the current index is odd\n            if num % 2 == 0:  # Check if the number at the odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/771", "solution": "OPENING_BRACKETS = {'(', '{', '['}\nCLOSING_BRACKETS = {')', '}', ']'}\nBRACKET_PAIRS = {'(': ')', '{': '}', '[': ']'}\n\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    It uses a stack to track opening brackets and ensures proper matching.\n    \"\"\"\n    stack = []\n    for char in expression_string:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in CLOSING_BRACKETS:\n            if not stack:\n                return False\n            last_opening = stack.pop()\n            if BRACKET_PAIRS[last_opening] != char:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(mainString: str, subString: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns a tuple (found_substring, start_index, length) if a match is found, otherwise returns None.\n    \"\"\"\n    start_index = mainString.find(subString)\n    if start_index == -1:\n        return None\n    else:\n        return (subString, start_index, len(subString))"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int | float:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    A non-repeated element appears exactly once in the list.\n    \"\"\"\n    from collections import Counter\n\n    if not input_list:\n        return 0\n\n    element_counts = Counter(input_list)\n    non_repeated_elements = [element for element, count in element_counts.items() if count == 1]\n\n    return sum(non_repeated_elements)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"Packs consecutive duplicates of list elements into sublists.\"\"\"\n    output_list = []\n\n    if not input_list:\n        return output_list\n\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        current_element = input_list[i]\n        if current_element == current_sublist[-1]:\n            current_sublist.append(current_element)\n        else:\n            output_list.append(current_sublist)\n            current_sublist = [current_element]\n\n    output_list.append(current_sublist)\n    return output_list"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given positive integer `n` is even.\n    Raises ValueError if `n` is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    def _calculate_divisors(num: int) -> list[int]:\n        \"\"\"\n        Computes all positive divisors for a given positive integer `num`.\n        \"\"\"\n        divs = []\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                divs.append(i)\n                if i * i != num:\n                    divs.append(num // i)\n            i += 1\n        return divs\n\n    divs = _calculate_divisors(n)\n    return len(divs) % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int | float, int | float]]) -> list[tuple[int | float, int | float]]:\n    \"\"\"\n    Calculates element-wise sums of distinct tuple pairs from a given list.\n    Returns an empty list if fewer than two tuples are provided.\n    \"\"\"\n    results = []\n\n    if len(tuple_list) < 2:\n        return results\n\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            t1 = tuple_list[i]\n            t2 = tuple_list[j]\n\n            sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n            results.append(sum_tuple)\n\n    return results"}
