{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Calculates the highest power of 2 less than or equal to n.\n    It determines this by repeatedly left-shifting a power of 2 until the next shift would exceed n.\n    \"\"\"\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Calculates the n'th Lucas number.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Converts three input lists into a list of nested dictionaries.\n    Elements are paired by their corresponding index.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same number of elements.\")\n\n    result = []\n    for i in range(len(list1)):\n        outer_key = list1[i]\n        inner_key = list2[i]\n        inner_value = list3[i]\n        result.append({outer_key: {inner_key: inner_value}})\n    return result"}
