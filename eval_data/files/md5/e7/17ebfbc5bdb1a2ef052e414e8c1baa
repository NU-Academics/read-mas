{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(cost_amount, selling_amount):\n    \"\"\"\n    Checks if a transaction results in no profit and no loss.\n    This is achieved when the cost amount is exactly equal to the selling amount.\n    \"\"\"\n    class Scenario:\n        \"\"\"\n        Encapsulates transaction details and provides logic for no-profit, no-loss determination.\n        \"\"\"\n        def __init__(self, cost: float, selling: float):\n            self._cost_amount = cost\n            self._selling_amount = selling\n\n        def is_no_profit_no_loss(self) -> bool:\n            \"\"\"\n            Compares cost and selling amounts to determine if there is no profit and no loss.\n            \"\"\"\n            return self._cost_amount == self._selling_amount\n\n    scenario = Scenario(cost_amount, selling_amount)\n    return scenario.is_no_profit_no_loss()"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"Sorts a list using the Heap Sort algorithm, returning a new sorted list.\"\"\"\n    arr = list(input_list) # Create a copy to avoid modifying the original list\n    n = len(arr)\n\n    # Helper function to maintain the max-heap property\n    def _heapify(arr: list, n: int, i: int):\n        largest = i  # Initialize largest as root\n        l = 2 * i + 1  # left child\n        r = 2 * i + 2  # right child\n\n        # See if left child of root exists and is greater than root\n        if l < n and arr[l] > arr[largest]:\n            largest = l\n\n        # See if right child of root exists and is greater than current largest\n        if r < n and arr[r] > arr[largest]:\n            largest = r\n\n        # Change root, if needed\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]  # swap\n            _heapify(arr, n, largest) # Recursively heapify the affected sub-tree\n\n    # Helper function to build a max-heap from an array\n    def _build_max_heap(arr: list):\n        # Build a maxheap. Start from the last non-leaf node and heapify upwards.\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    # Main heap sort logic\n    _build_max_heap(arr)\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Swap root (largest) with current last element\n        _heapify(arr, i, 0) # Call _heapify on the reduced heap\n\n    return arr"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity_kmh: float, temperature_celsius: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius.\n    The result is rounded to the nearest integer.\n    \"\"\"\n    v_power_0_16 = velocity_kmh ** 0.16\n    wci_raw = 13.12 + (0.6215 * temperature_celsius) - (11.37 * v_power_0_16) + (0.3965 * temperature_celsius * v_power_0_16)\n    return round(wci_raw)"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' at any position except the start or end.\n    Returns True if 'z' is found in the middle section, False otherwise.\n    \"\"\"\n    # If the string is too short, 'z' cannot be in the middle (not at start/end).\n    if len(input_string) < 3:\n        return False\n\n    # Check if 'z' exists anywhere in the string.\n    if 'z' not in input_string:\n        return False\n\n    # Check if 'z' is at the first or last position.\n    if input_string[0] == 'z' or input_string[-1] == 'z':\n        return False\n\n    # If 'z' is present and not at the start or end, it must be in the middle.\n    return True"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list) -> int:\n    \"\"\"The public entry point for the name length sum calculation.\n\n    Accepts a list of raw strings, creates a NameList, uses NameProcessor\n    to calculate the sum, and returns the result.\n    \"\"\"\n    class Name:\n        \"\"\"Represents a single name with its value and calculated length.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n            self.length = len(value)\n\n        def is_valid(self) -> bool:\n            \"\"\"Checks if the name starts with an uppercase letter (A-Z).\"\"\"\n            if not self.value:\n                return False\n            return 'A' <= self.value[0] <= 'Z'\n\n    class NameList:\n        \"\"\"A collection of Name objects, representing the input list.\"\"\"\n        def __init__(self, raw_names: list):\n            self.names: list[Name] = [Name(name) for name in raw_names]\n\n        def get_valid_names(self) -> list[Name]:\n            \"\"\"Returns a list of Name objects that are considered valid.\"\"\"\n            return [name for name in self.names if name.is_valid()]\n\n    class NameProcessor:\n        \"\"\"Orchestrates the filtering and summation of name lengths.\"\"\"\n        def calculate_sum_of_valid_name_lengths(self, name_list_obj: NameList) -> int:\n            \"\"\"Filters valid names from the given NameList and sums their lengths.\"\"\"\n            valid_names = name_list_obj.get_valid_names()\n            total_sum = 0\n            for name in valid_names:\n                total_sum += name.length\n            return total_sum\n\n    name_list_instance = NameList(names)\n    processor_instance = NameProcessor()\n    return processor_instance.calculate_sum_of_valid_name_lengths(name_list_instance)"}
