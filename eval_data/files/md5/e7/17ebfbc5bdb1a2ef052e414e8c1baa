{"task_id": "Mbpp/622", "solution": "from typing import List as PyList\n\ndef get_median(list1: PyList[float], list2: PyList[float], size: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size.\n    It finds the two middle elements of the combined 2 * size elements.\n    \"\"\"\n    i = 0 # Current index for list1\n    j = 0 # Current index for list2\n    m1 = -1.0 # To store the (size-1)-th element\n    m2 = -1.0 # To store the size-th element\n\n    # Iterate to find the two middle elements\n    # We need to find elements at positions 'size-1' and 'size' in the merged list.\n    # The loop runs 'size + 1' times to correctly identify m1 (element at size-1) and m2 (element at size).\n    for count in range(size + 1):\n        if i == size: # list1 exhausted\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n        elif j == size: # list2 exhausted\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        elif list1[i] <= list2[j]:\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        else:\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n    return (m1 + m2) / 2.0"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers):\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the even numbers.\n    The original input list remains unmodified.\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zeroes to the end of the given list while preserving the relative order of non-zero elements.\n    \"\"\"\n    non_zeros = []\n    zeros = []\n    for item in input_list:\n        if item == 0:\n            zeros.append(item)\n        else:\n            non_zeros.append(item)\n    return non_zeros + zeros"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(center_coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Calculates the 9 coordinates forming a 3x3 grid centered on the input coordinate.\n    \"\"\"\n    center_x, center_y = center_coordinate\n    adjacent_coords = []\n\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            new_x = center_x + dx\n            new_y = center_y + dy\n            adjacent_coords.append([new_x, new_y])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], length: int) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs in a list of integers.\n\n    The 'length' parameter is redundant and not used, as the list's length can be determined directly.\n    \"\"\"\n    total_xor_sum = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += numbers[i] ^ numbers[j]\n    return total_xor_sum"}
