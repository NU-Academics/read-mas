{"task_id": "Mbpp/440", "solution": "def find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its 0-indexed start and exclusive end positions\n    in the given sentence, stripping trailing punctuation from the adverb word.\n    Returns (start_position, end_position, adverb_word) or None if no adverb is found.\n    \"\"\"\n    import re\n    import string\n\n    def _is_adverb(word: str) -> bool:\n        \"\"\"Checks if a word is an adverb using a suffix-based heuristic and common adverb list.\"\"\"\n        lower_word = word.lower()\n        if lower_word.endswith(\"ly\"):\n            # Exclude words that end in -ly but are not adverbs (e.g., \"friendly\", \"lovely\")\n            # This is a simple heuristic; more robust solutions would use a dictionary.\n            if lower_word not in [\"friendly\", \"lovely\", \"ugly\", \"daily\", \"hourly\", \"early\", \"only\"]:\n                return True\n        # A small, hardcoded list of common adverbs that don't follow the -ly rule\n        common_adverbs = {\"very\", \"quite\", \"then\", \"there\", \"fast\", \"well\", \"never\", \"always\", \"often\", \"seldom\", \"sometimes\", \"here\", \"now\", \"today\", \"yesterday\", \"tomorrow\", \"soon\", \"late\", \"early\", \"once\", \"twice\", \"thrice\", \"alone\", \"together\", \"away\", \"back\", \"down\", \"in\", \"out\", \"up\"}\n        return lower_word in common_adverbs\n\n    def _strip_trailing_punctuation(word: str) -> str:\n        \"\"\"Strips trailing punctuation from a word.\"\"\"\n        return word.rstrip(string.punctuation)\n\n    # Use re.finditer to get words and their spans, including punctuation\n    # This regex matches sequences of word characters or single non-whitespace characters (like punctuation)\n    # The design context implies finding adverbs within words that might have trailing punctuation\n    # so we should capture words like \"clearly!!\" as \"clearly\" with its original span.\n    # A more robust tokenization might separate punctuation, but the example \"clearly!!\" suggests\n    # we should handle it as part of the word initially.\n    \n    # Let's iterate through words using a simpler split and then find positions\n    # based on index_of for more accurate character positions.\n    current_pos = 0\n    for word_match in re.finditer(r'\\S+', sentence):\n        word_text = word_match.group(0)\n        start_span = word_match.start(0)\n        end_span = word_match.end(0)\n\n        stripped_word = _strip_trailing_punctuation(word_text)\n\n        if stripped_word and _is_adverb(stripped_word):\n            # The start_span and end_span are for the original word including punctuation.\n            # We need to return the span of the *original* word as it appeared in the sentence,\n            # but the stripped word itself.\n            return (start_span, end_span, stripped_word)\n            \n    return None"}
