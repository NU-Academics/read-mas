{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 1\n\n    for rotation_count in range(1, n + 1):\n        rotated_string = input_string[rotation_count:] + input_string[:rotation_count]\n        if rotated_string == input_string:\n            return rotation_count\n    return n # Fallback, though the loop should always find a match"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Determines if two numbers differ at exactly one bit position.\n    \"\"\"\n    xor_result = num1 ^ num2\n\n    # Count the number of set bits in the XOR result (Brian Kernighan's algorithm)\n    count = 0\n    n = xor_result\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n        \n    return count == 1"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Orchestrates the process to find words at least 4 characters long in a string.\n    Identifies words, then filters them by length.\n    \"\"\"\n    def _identify_words(text: str) -> list[str]:\n        \"\"\"Splits an input string into a list of words based on whitespace.\"\"\"\n        return text.split()\n\n    def _filter_words_by_length(words: list[str], min_length: int) -> set[str]:\n        \"\"\"Filters a list of words, returning a set of those meeting the minimum length.\"\"\"\n        return {word for word in words if len(word) >= min_length}\n\n    identified_words = _identify_words(input_string)\n    filtered_words = _filter_words_by_length(identified_words, 4)\n    return filtered_words"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef _validate_inputs(list_of_numbers: list[int], n: int) -> None:\n    \"\"\"\n    Validates the input list and n against business rules.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    if not list_of_numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    if n > len(list_of_numbers):\n        raise ValueError(\"n cannot be greater than the length of the list.\")\n\ndef _find_largest_elements(list_of_numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Identifies the n largest integers from the input list using a min-heap.\n    The elements in the returned list are not guaranteed to be sorted.\n    \"\"\"\n    min_heap = []\n    for num in list_of_numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num) # More efficient than heappop then heappush\n    return min_heap\n\ndef _sort_descending(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a given list of integers in descending order.\n    \"\"\"\n    return sorted(numbers, reverse=True)\n\ndef heap_queue_largest(list_of_numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n    _validate_inputs(list_of_numbers, n)\n    \n    largest_elements_unsorted = _find_largest_elements(list_of_numbers, n)\n    result = _sort_descending(largest_elements_unsorted)\n    \n    return result"}
