{"task_id": "Mbpp/602", "solution": "from typing import Optional\n\ndef first_repeated_char(input_string: str) -> Optional[str]:\n    \"\"\"\n    Finds the first repeated character in a given string.\n    Returns the first repeated character (as a string of length 1) or None if no\n    repeated character is found.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates all Ludic numbers less than or equal to n using a sieve-like algorithm.\n    The first Ludic number is 1, and subsequent Ludic numbers are found by iteratively\n    removing specific elements from a sequence of natural numbers.\n    \"\"\"\n    if n < 1:\n        return []\n\n    candidates = list(range(1, n + 1))\n    ludic_numbers = []\n\n    # Continue as long as there are numbers in the candidates list to process.\n    while candidates:\n        # The first number in the candidates list is the next Ludic number.\n        current_ludic = candidates.pop(0)\n        ludic_numbers.append(current_ludic)\n\n        # If the current Ludic number is greater than 1, perform the sieving step.\n        # For L=1, no numbers are removed based on its value other than 1 itself.\n        if current_ludic > 1:\n            temp_candidates = []\n            count = 0\n            # Iterate through the remaining candidates to find numbers to keep.\n            for num in candidates:\n                count += 1\n                # Only add numbers that are not at the 'current_ludic'-th position in the sequence.\n                if count % current_ludic != 0:\n                    temp_candidates.append(num)\n            candidates = temp_candidates\n\n    return ludic_numbers"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for the first occurrence of a regex pattern.\n    Returns the matching substring, its start index, and its end index.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using a dynamic programming approach.\"\"\"\n    # Create a 2D table to store Bell numbers.\n    # bell[i][j] stores the number of partitions of a set of size i+1 into j+1 non-empty subsets.\n    # The nth Bell number is bell[n][0] after filling the table.\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base case: B(0) = 1\n    bell[0][0] = 1\n\n    # Fill the bell triangle\n    for i in range(1, n + 1):\n        # The first element of each row is the last element of the previous row.\n        # This property directly gives the Bell numbers.\n        bell[i][0] = bell[i - 1][i - 1]\n        for j in range(1, i + 1):\n            # The general rule for filling the triangle.\n            # bell[i][j] = bell[i-1][j-1] + bell[i][j-1]\n            bell[i][j] = bell[i - 1][j - 1] + bell[i][j - 1]\n\n    return bell[n][0]"}
