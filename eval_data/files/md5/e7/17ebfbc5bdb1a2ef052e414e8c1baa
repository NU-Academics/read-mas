{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are positive integers (>= 1).\n    \"\"\"\n    total_sum = 0\n    # Ensure l is at least 1, as numbers must be natural. If l is less than 1, start from 1.\n    current_num = max(1, l)\n\n    # Find the first odd number in the adjusted range [current_num, r].\n    if current_num % 2 == 0:\n        current_num += 1\n\n    # Iterate through odd numbers from current_num up to r (inclusive).\n    while current_num <= r:\n        total_sum += current_num\n        current_num += 2\n\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"Rotates the bits of a 32-bit unsigned integer to the left by d positions.\"\"\"\n    BITS = 32\n    # Ensure d is within the range [0, BITS-1]\n    d_effective = d % BITS\n    \n    # Perform the left shift and combine with the bits that wrap around from the MSB to LSB\n    rotated_number = ((number << d_effective) | (number >> (BITS - d_effective)))\n    \n    # Mask to ensure the result remains a 32-bit unsigned integer\n    return rotated_number & 0xFFFFFFFF"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers_list: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers_list:\n        return False  # Empty list, product is 1 (odd)\n\n    # Check for zero or any even number first for early exit\n    for num in numbers_list:\n        if num == 0:\n            return True  # Product is 0, which is even\n        if isinstance(num, int) and num % 2 == 0:\n            return True  # Product will be even if any integer factor is even\n\n    # If no zero or even integers were found, calculate the product\n    # and check its evenness.\n    product = 1\n    for num in numbers_list:\n        product *= num\n\n    # The product is even if it's an integer and divisible by 2.\n    # Floating point products are never considered \"even\" in the integer sense\n    # unless they effectively represent an even integer (e.g., 4.0).\n    return isinstance(product, int) and product % 2 == 0"}
