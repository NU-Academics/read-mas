{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Calculates the nth Newman-Shanks-Williams number based on its recurrence relation.\n    The sequence starts with S_0 = 1, S_1 = 1, and S_k = 2 * S_{k-1} + S_{k-2} for k >= 2.\n    \"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    s_k_minus_2 = 1  # Corresponds to S_0\n    s_k_minus_1 = 1  # Corresponds to S_1\n\n    for _ in range(2, n + 1):\n        s_k = 2 * s_k_minus_1 + s_k_minus_2\n        s_k_minus_2 = s_k_minus_1\n        s_k_minus_1 = s_k\n\n    return s_k_minus_1"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age: int) -> float:\n    \"\"\"Calculates a dog's age in dog years based on its human age.\n    The first two human years convert to 10.5 dog years each, and subsequent years convert to 4 dog years each.\n    \"\"\"\n    if human_age <= 2:\n        return float(human_age * 10.5)\n    else:\n        return 2 * 10.5 + (human_age - 2) * 4.0"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Returns 0 if n is less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    if n <= 0:\n        return 0\n    \n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        squared_value = odd_number * odd_number\n        total_sum += squared_value\n        \n    return total_sum"}
