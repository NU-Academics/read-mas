{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in an array.\n    This is achieved by finding the difference between the maximum and minimum elements.\n    \"\"\"\n    if not arr:\n        return 0  # Or handle as per specific requirement for empty arrays, 0 implies no difference\n    \n    min_val = arr[0]\n    max_val = arr[0]\n\n    for x in arr:\n        if x < min_val:\n            min_val = x\n        if x > max_val:\n            max_val = x\n            \n    return max_val - min_val"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        current_term = n - 2 * i\n        total_sum += current_term\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    def _is_english_alphabet_letter(char_val: str) -> bool:\n        \"\"\"Checks if a character is an English alphabet letter (a-z, case-insensitive).\"\"\"\n        return 'a' <= char_val <= 'z'\n\n    def _get_alphabetical_position(char_val: str) -> int:\n        \"\"\"Calculates the 1-based alphabetical position for a lowercase English alphabet letter.\"\"\"\n        return ord(char_val) - ord('a') + 1\n\n    count = 0\n    for index, char in enumerate(input_string):\n        lower_char = char.lower()\n        if _is_english_alphabet_letter(lower_char):\n            alphabetical_position = _get_alphabetical_position(lower_char)\n            if alphabetical_position == (index + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def _gcd(a, b):\n    \"\"\"\n    Computes the greatest common divisor of two integers using the Euclidean algorithm.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef _extended_gcd(a, b):\n    \"\"\"\n    Implements the Extended Euclidean Algorithm. It finds g = gcd(|a|, |b|)\n    and integers x, y such that ax + by = g.\n    \"\"\"\n    if b == 0:\n        # Base case: gcd(|a|, 0) = |a|. For ax + 0y = |a|, x is 1 (if a>=0) or -1 (if a<0), y is 0.\n        return (abs(a), 1 if a >= 0 else -1, 0)\n    \n    g, x_prime, y_prime = _extended_gcd(b, a % b)\n    x = y_prime\n    y = x_prime - (a // b) * y_prime\n    return (g, x, y)\n\ndef find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    # Handle the special case where both coefficients are zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)  # Any (x, y) satisfies 0*x + 0*y = 0. Return a simple solution.\n        else:\n            return None    # 0*x + 0*y = n (where n != 0) has no solution.\n\n    # Calculate the greatest common divisor of a and b.\n    # This g will always be non-negative.\n    g = _gcd(a, b)\n\n    # A solution exists only if n is divisible by g.\n    if n % g != 0:\n        return None\n\n    # Use the Extended Euclidean Algorithm to find x0, y0 such that ax0 + by0 = g.\n    # The _extended_gcd function is designed to return g as a positive value.\n    _, x0, y0 = _extended_gcd(a, b)\n\n    # Scale x0 and y0 to find a particular solution for ax + by = n.\n    # The scaling factor is n // g.\n    scale_factor = n // g\n    \n    x = x0 * scale_factor\n    y = y0 * scale_factor\n\n    return (x, y)"}
