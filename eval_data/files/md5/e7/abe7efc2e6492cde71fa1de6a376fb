{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n    mid = n // 2\n\n    if n % 2:  # Odd number of elements\n        return sorted_list[mid]\n    else:  # Even number of elements\n        return (sorted_list[mid - 1] + sorted_list[mid]) / 2"}
{"task_id": "HumanEval/44", "solution": "class BaseValidator:\n    @staticmethod\n    def is_valid(base: int) -> bool:\n        \"\"\"Checks if the base is a valid integer between 1 and 9.\"\"\"\n        return isinstance(base, int) and 0 < base < 10\n\n\nclass NumberConverter:\n    @staticmethod\n    def compute(x: int, base: int) -> str:\n        \"\"\"Converts an integer x to its string representation in the given base.\"\"\"\n        if x == 0:\n            return \"0\"\n\n        sign = \"-\" if x < 0 else \"\"\n        x = abs(x)\n        digits = []\n\n        while x:\n            digits.append(str(x % base))\n            x //= base\n\n        return sign + \"\".join(reversed(digits))\n\n\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not BaseValidator.is_valid(base):\n        raise ValueError(\"Base must be an integer less than 10.\")\n\n    return NumberConverter.compute(x, base)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the fib4 number sequence efficiently without recursion.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the sequence with the first four base values\n    dp = [0, 0, 2, 0]\n\n    # Iteratively compute fib4(i) for i from 4 up to n\n    for i in range(4, n + 1):\n        next_fib4 = dp[i-1] + dp[i-2] + dp[i-3] + dp[i-4]\n        dp.append(next_fib4)\n\n    return dp[n]"}
