{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift == num_digits:\n        return s_x\n    elif shift > num_digits:\n        return s_x[::-1]\n    else:\n        # Perform circular right shift\n        # Take the last 'shift' digits and prepend them to the remaining digits\n        return s_x[-shift:] + s_x[:-shift]"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Parses the number of apples and oranges from string `s` and subtracts them from `n` to find mangoes.\n    Assumes `s` is always in \"X apples and Y oranges\" format and `n` is sufficient.\n    \"\"\"\n    match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    return n - apples - oranges"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n            # If num == smallest_even_value, we do nothing because we already have the smallest index for that value.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = collections.Counter(lst)\n    \n    qualifying_numbers = []\n    for number, freq in frequencies.items():\n        if number > 0 and freq >= number:\n            qualifying_numbers.append(number)\n            \n    if not qualifying_numbers:\n        return -1\n    else:\n        return max(qualifying_numbers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left = 0\n    right = len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n    \n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly based on two conditions:\n    1. It is balanced (a palindromic list).\n    2. The sum of its elements is less than or equal to the maximum possible weight w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight_limit = (total_weight <= w)\n    \n    return is_balanced and is_within_weight_limit"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    if not (a > 0 and b > 0 and c > 0 and a + b > c and a + c > b and b + c > a):\n        return -1\n    \n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make the array palindromic.\n    It counts mismatches between elements at symmetric positions.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character count.\n    Returns the list with fewer total characters, or the first list in case of a tie.\n    \"\"\"\n    total_chars1 = sum(len(s) for s in lst1)\n    total_chars2 = sum(len(s) for s in lst2)\n\n    if total_chars1 <= total_chars2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    Checks if the given number is the multiplication of 3 prime numbers.\n    Knowing that (a) is less then 100.\n    \"\"\"\n    if a < 2:\n        return False\n\n    def _is_prime(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    prime_factors = []\n    temp_a = a\n    d = 2\n    while d * d <= temp_a:\n        if temp_a % d == 0:\n            prime_factors.append(d)\n            temp_a //= d\n        else:\n            d += 1\n    if temp_a > 1:\n        prime_factors.append(temp_a)\n\n    if len(prime_factors) == 3:\n        return all(_is_prime(p) for p in prime_factors)\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple power of n.\n    x is a simple power of n if there exists an integer k such that n**k = x.\n    \"\"\"\n    if n == 1:\n        # According to BR3, if n is 1, x must be 1 for it to be a simple power (1**k = 1).\n        return x == 1\n    \n    if x == 1:\n        # Any positive integer n (n > 0 as per BR1) raised to the power of 0 is 1.\n        return True\n\n    # If x is less than n (and x is not 1, n is not 1), it cannot be a power of n.\n    if x < n:\n        return False\n\n    # For n > 1 and x > 1, repeatedly divide x by n.\n    # If x is a power of n, it should eventually reduce to 1 without any remainder.\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    \n    return True"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    \n    # Calculate the integer cube root of the absolute value of 'a'.\n    # For typical integer ranges (like 32-bit), standard float precision for `**(1/3)` and `round` is sufficient.\n    root = round(abs(a)**(1/3))\n    \n    # Adjust the sign of the root to match the original number 'a'.\n    if a < 0:\n        root = -root\n            \n    # Check if the cube of this candidate root equals the original number 'a'.\n    return root * root * root == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (11), D (13).\"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for char in num:\n        if char in prime_hex_digits:\n            count += 1\n    return count"}
