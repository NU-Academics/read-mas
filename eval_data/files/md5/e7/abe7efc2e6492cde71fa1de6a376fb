{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\n    It applies a predefined grading scale to map each GPA value.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else:  # gpa == 0.0 (or less, as per table's final condition for 0.0)\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the string length is a prime number.\"\"\"\n    \n    def _is_prime(n):\n        \"\"\"Helper function to check if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    return _is_prime(len(string))"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \"\"\"\n    sum_digits = 0\n    # Calculate the sum of decimal digits.\n    for digit_char in str(N):\n        sum_digits += int(digit_char)\n    \n    # Convert the sum to its binary representation and return as a string.\n    return bin(sum_digits)[2:]"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Handle the special case for n=1 as specified in the design document.\n    if n == 1:\n        return 1\n\n    # Calculate 10^(n-1) and 10^(n-2) for the formula.\n    pow10_n_1 = 10**(n - 1)\n    pow10_n_2 = 10**(n - 2)\n\n    # Apply the closed-form formula from the design document.\n    return pow10_n_1 + 9 * pow10_n_2 - 1"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        # Check if the current index is odd (1, 3, 5, ...)\n        # In 0-based indexing, this means i % 2 != 0\n        if i % 2 != 0:\n            # Check if the element at this odd index is even\n            if lst[i] % 2 == 0:\n                total_sum += lst[i]\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    # Split the string by one or more spaces, keeping the space delimiters.\n    # This ensures that multiple consecutive spaces are preserved and handled\n    # as distinct tokens alongside words.\n    tokens = re.split(r'(\\s+)', s)\n\n    result_parts = []\n    for token in tokens:\n        if token:  # Filter out empty strings that re.split might produce at start/end.\n            if token.isspace():\n                # If the token is composed entirely of spaces, keep it as is.\n                result_parts.append(token)\n            else:\n                # If it's a word (non-space characters), sort its characters\n                # based on their ASCII/Unicode value and join them back.\n                result_parts.append(\"\".join(sorted(token)))\n    \n    # Join all processed parts back to form the final string.\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in a jagged list and returns a list of (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort by row ascending (coord[0]), then by column descending (negate coord[1] for ascending sort)\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array based on the parity of the sum of its first and last elements, returning a new sorted array.\n    The array is sorted ascending if the sum is odd, or descending if the sum is even.\n    \"\"\"\n    if len(array) <= 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    if sum_first_last % 2 == 1:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not S:\n        return 0\n\n    delimiters = {'.', '?', '!'}\n    count = 0\n    start = 0\n\n    for i, ch in enumerate(S):\n        if ch in delimiters:\n            # Extract sentence up to and including the delimiter\n            sentence = S[start:i+1].strip()\n            # A sentence starting with \"I\" must start with \"I \" to ensure \"I\" is a word\n            if sentence.startswith('I '):\n                count += 1\n            start = i + 1\n\n    # Handle the last potential sentence if the string doesn't end with a delimiter\n    if start < len(S):\n        sentence = S[start:].strip()\n        if sentence.startswith('I '):\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each lowercase alphabetic character down by four places, wrapping around the alphabet.\"\"\"\n    encrypted_chars = []\n    shift_amount = 4  # Shift down by two multiplied to two places (2 * 2 = 4)\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate new position: (current_offset + shift) % 26\n            new_position_in_alphabet = (ord(char) - ord('a') + shift_amount) % 26\n            encrypted_chars.append(chr(ord('a') + new_position_in_alphabet))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest element of the list, considering only distinct values.\n    Returns None if there is no such element.\n    \"\"\"\n    distinct_elements = sorted(list(set(lst)))\n    if len(distinct_elements) < 2:\n        return None\n    return distinct_elements[1]"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    # Check if all provided numbers are integers. This is a prerequisite for returning True.\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n    \n    # After ensuring they are integers, check if any number equals the sum of the other two.\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels with\n    the letter 2 places ahead in the alphabet.\n    \"\"\"\n    vowel_map = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            swapped_char = char.swapcase()\n            mapped_char = vowel_map.get(swapped_char, swapped_char)\n            encoded_chars.append(mapped_char)\n        else:\n            encoded_chars.append(char)\n    return ''.join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    largest_prime = -1\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    sum_digits = 0\n    if largest_prime > 0: # Ensure a prime was actually found\n        for digit_char in str(largest_prime):\n            sum_digits += int(digit_char)\n\n    return sum_digits"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if not key.islower():\n            is_all_lower = False\n        \n        if not key.isupper():\n            is_all_upper = False\n            \n    return is_all_lower or is_all_upper"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    primes = []\n    \n    def _is_prime(num):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        \n        limit = int(math.sqrt(num)) + 1\n        for i in range(3, limit, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n            \n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
