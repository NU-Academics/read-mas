{"task_id": "HumanEval/57", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass NumberList:\n    \"\"\"Represents a list of numbers for monotonicity checking.\"\"\"\n    elements: List[int]\n\nclass MonotonicChecker:\n    \"\"\"Checks if a given NumberList is monotonically increasing or decreasing.\"\"\"\n    def is_monotonic(self, number_list: NumberList) -> bool:\n        l = number_list.elements\n        n = len(l)\n\n        if n <= 1:\n            return True\n\n        is_increasing = True\n        is_decreasing = True\n\n        for i in range(1, n):\n            if l[i] > l[i-1]:\n                is_decreasing = False\n            elif l[i] < l[i-1]:\n                is_increasing = False\n\n            if not is_increasing and not is_decreasing:\n                return False\n        \n        return is_increasing or is_decreasing\n\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    number_list_obj = NumberList(elements=l)\n    checker = MonotonicChecker()\n    return checker.is_monotonic(number_list_obj)"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(list(common_elements))"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # First, handle factors of 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Then, iterate through odd divisors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        else:\n            raise ValueError(\"Input string must contain only '(' and ')' characters.\")\n\n        if balance < 0:\n            return False\n            \n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    return [i * xs[i] for i in range(1, len(xs))]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using an iterative approach for efficiency.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n\n    # Initialize variables for the last three FibFib numbers: fibfib(i-3), fibfib(i-2), fibfib(i-1)\n    a, b, c = 0, 0, 1\n\n    # Iterate from n=3 up to the requested n\n    for _ in range(3, n + 1):\n        next_fibfib = a + b + c\n        a, b, c = b, c, next_fibfib\n        \n    return c"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a word, where 'y' is a vowel only at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n            \n    return count"}
