{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_of_cubes = (n * n * (n + 1) * (n + 1)) // 4\n    sum_of_naturals = (n * (n + 1)) // 2\n    return sum_of_cubes - sum_of_naturals"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if 'a' <= char <= 'z':\n            toggled_chars.append(chr(ord(char) - 32))  # Convert lowercase to uppercase\n        elif 'A' <= char <= 'Z':\n            toggled_chars.append(chr(ord(char) + 32))  # Convert uppercase to lowercase\n        else:\n            toggled_chars.append(char)  # Keep non-alphabetic characters unchanged\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1, num2):\n    \"\"\"\n    Calculates the sum of per-digit differences between two integers.\n    Digits are processed from right-to-left, treating missing digits as zero.\n    \"\"\"\n    s_num1 = str(num1)\n    s_num2 = str(num2)\n    \n    # Reverse strings to process digits from right to left (least significant to most significant)\n    rev_s_num1 = s_num1[::-1]\n    rev_s_num2 = s_num2[::-1]\n    \n    total_distance = 0\n    max_len = max(len(rev_s_num1), len(rev_s_num2))\n    \n    for i in range(max_len):\n        digit1 = int(rev_s_num1[i]) if i < len(rev_s_num1) else 0\n        digit2 = int(rev_s_num2[i]) if i < len(rev_s_num2) else 0\n        \n        total_distance += abs(digit1 - digit2)\n        \n    return total_distance"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list[int], size: int) -> int:\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    A pair (a, b) has an odd XOR if one number is even and the other is odd.\n    \"\"\"\n    count = 0\n    # Iterate through all possible pairs (i, j) such that i < j\n    for i in range(size):\n        for j in range(i + 1, size):\n            # Calculate the XOR of the two elements\n            xor_val = array[i] ^ array[j]\n            # Check if the XOR value is odd\n            if xor_val % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], length: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of a contiguous sublist using Kadane's algorithm.\n    This function assumes the input list 'arr' is non-empty and 'length' is its correct length.\n    \"\"\"\n    max_sum = arr[0]\n    current_sum = arr[0]\n\n    for i in range(1, length):\n        current_sum = max(arr[i], current_sum + arr[i])\n        max_sum = max(max_sum, current_sum)\n\n    return max_sum"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Find the union of elements from two tuples and return in sorted order.\n    \"\"\"\n    combined_elements = tuple1 + tuple2\n    unique_elements = set(combined_elements)\n    sorted_unique_elements = sorted(unique_elements)\n    return tuple(sorted_unique_elements)"}
