{"task_id": "Mbpp/16", "solution": "def text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore.\n    \"\"\"\n    def _is_lowercase_sequence(sequence: str) -> bool:\n        \"\"\"Checks if a string sequence consists only of lowercase letters.\"\"\"\n        if not sequence:\n            return False\n        return all(char.islower() for char in sequence)\n\n    def _has_valid_structure(input_string: str) -> bool:\n        \"\"\"Validates the overall structure of the string for underscores.\"\"\"\n        if not input_string:\n            return False\n        if '_' not in input_string:\n            return False\n        if input_string.startswith('_') or input_string.endswith('_'):\n            return False\n        if '__' in input_string:\n            return False\n        return True\n\n    if not _has_valid_structure(input_string):\n        return False\n\n    parts = input_string.split('_')\n    return all(_is_lowercase_sequence(part) for part in parts)"}
{"task_id": "Mbpp/19", "solution": "import collections\n\ndef test_duplicate(array: list) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate elements.\n    Returns True if duplicates are found, False otherwise.\n    \"\"\"\n    seen = set()\n    for element in array:\n        if element in seen:\n            return True\n        seen.add(element)\n    return False"}
{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    def reverse_number(num: int) -> int:\n        \"\"\"\n        Reverses the digits of an integer.\n        For example, reverse_number(70) returns 7.\n        \"\"\"\n        # Convert to string, reverse, convert back to int\n        s = str(abs(num))\n        reversed_s = s[::-1]\n        reversed_num = int(reversed_s)\n        \n        # If the original number was negative, keep the sign (though design implies positive)\n        return -reversed_num if num < 0 else reversed_num\n\n    reversed_val = reverse_number(number)\n    twice_reversed_minus_one = (reversed_val * 2) - 1\n    \n    return number == twice_reversed_minus_one"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for a positive integer n.\n    \"\"\"\n    if number <= 0:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"\n    Removes characters from source_string that are present in filter_string.\n    Preserves the order of the remaining characters.\n    \"\"\"\n    if not source_string:\n        return \"\"\n    if not filter_string:\n        return source_string\n\n    # Create a set of characters from the filter_string for O(1) average time lookup.\n    filter_chars = set(filter_string)\n\n    result_chars = []\n    # Iterate through the source_string and append characters not in the filter set.\n    for char in source_string:\n        if char not in filter_chars:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/58", "solution": "def _is_positive(num: int) -> bool:\n    \"\"\"Checks if an integer is positive.\"\"\"\n    return num > 0\n\ndef _is_negative(num: int) -> bool:\n    \"\"\"Checks if an integer is negative.\"\"\"\n    return num < 0\n\ndef _is_zero(num: int) -> bool:\n    \"\"\"Checks if an integer is zero.\"\"\"\n    return num == 0\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Returns True if one is positive and the other is negative, False otherwise.\n    \"\"\"\n    if _is_zero(a) or _is_zero(b):\n        return False\n    \n    is_a_positive = _is_positive(a)\n    is_a_negative = _is_negative(a)\n    is_b_positive = _is_positive(b)\n    is_b_negative = _is_negative(b)\n\n    return (is_a_positive and is_b_negative) or (is_a_negative and is_b_positive)"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Find the largest number that can be formed with the given list of digits.\n\n    Args:\n        digits: List of integer digits (0-9)\n\n    Returns:\n        int: Largest possible number formed by arranging digits\n    \"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n    number_as_string = \"\".join(str(d) for d in sorted_digits)\n    return int(number_as_string) if number_as_string else 0"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Iterates through all substrings, calculates their digit sum, and compares it to their length.\n    \"\"\"\n    count = 0\n    n = len(s)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # Calculate the sum of digits for the substring s[i...j]\n            current_sum += int(s[j])\n            # Calculate the length of the current substring\n            current_length = j - i + 1\n            # Check if the sum of digits equals the length\n            if current_sum == current_length:\n                count += 1\n    return count"}
