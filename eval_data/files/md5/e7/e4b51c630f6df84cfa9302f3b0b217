{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(complex_number):\n    \"\"\"Convert complex number to polar coordinates.\n\n    Args:\n        complex_number: Complex number or real number\n\n    Returns:\n        tuple[float, float]: (magnitude, angle) in polar coordinates\n    \"\"\"\n    if isinstance(complex_number, (int, float)):\n        complex_number = complex(complex_number, 0)\n\n    magnitude = math.sqrt(complex_number.real**2 + complex_number.imag**2)\n    angle = math.atan2(complex_number.imag, complex_number.real)\n\n    return (magnitude, angle)"}
{"task_id": "Mbpp/256", "solution": "import math\n\ndef count_Primes_nums(number: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number.\n    Raises ValueError if the input number is negative.\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Input number must be non-negative.\")\n\n    count = 0\n    for num in range(2, number):\n        if _is_prime(num):\n            count += 1\n    return count\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given non-negative integer is a prime number.\n    Optimizes by checking divisors only up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
