{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple:\n    \"\"\"\n    Calculate sum and average of first n natural numbers.\n\n    Args:\n        n (int): Number of natural numbers to calculate (must be positive)\n\n    Returns:\n        tuple: (sum, average) where sum is int and average is float\n    \"\"\"\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/597", "solution": "from typing import List\n\ndef find_kth(array1: List[int], array2: List[int], k: int) -> int:\n    \"\"\"Find the kth smallest element from two sorted arrays.\"\"\"\n\n    # Ensure array1 is the shorter array for an optimized binary search range.\n    if len(array1) > len(array2):\n        array1, array2 = array2, array1\n\n    m, n = len(array1), len(array2)\n\n    # Define the binary search range for `i`, elements taken from array1.\n    # `i` ensures k-i elements are taken from array2, respecting array bounds.\n    low = max(0, k - n)\n    high = min(m, k)\n\n    while low <= high:\n        i = low + (high - low) // 2  # Elements from array1.\n        j = k - i                    # Elements from array2.\n\n        # Define boundary values for partitions, using infinities for conceptual edges.\n        arr1_left_max = array1[i-1] if i > 0 else float('-inf')\n        arr1_right_min = array1[i] if i < m else float('inf')\n        arr2_left_max = array2[j-1] if j > 0 else float('-inf')\n        arr2_right_min = array2[j] if j < n else float('inf')\n\n        # Adjust partition based on comparisons.\n        if arr1_left_max > arr2_right_min:\n            high = i - 1  # `i` is too large; need fewer from array1.\n        elif arr2_left_max > arr1_right_min:\n            low = i + 1   # `i` is too small; need more from array1.\n        else:\n            # Correct partition found. The kth element is the maximum of the left-most elements.\n            return max(arr1_left_max, arr2_left_max)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str:\n    \"\"\"\n    Finds the first character that appears more than once in the input string.\n    Processes characters from left to right sequentially.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(text):\n    \"\"\"\n    Splits the string into words, reverses their order, and joins them back.\n    \"\"\"\n    words = text.split(' ')\n    reversed_words = words[::-1]\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Handles edge cases for numbers less than or equal to 1.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
