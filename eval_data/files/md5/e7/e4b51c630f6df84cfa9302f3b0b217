{"task_id": "Mbpp/126", "solution": "def sum(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors between two numbers.\n    Utilizes helper functions to find divisors and their common elements.\n    \"\"\"\n    def _find_divisors(number: int) -> list[int]:\n        \"\"\"\n        Finds all divisors of a given number, including 1 and the number itself.\n        \"\"\"\n        divs = []\n        for i in range(1, int(number**0.5) + 1):\n            if number % i == 0:\n                divs.append(i)\n                if i * i != number:\n                    divs.append(number // i)\n        return sorted(divs)\n\n    def _find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n        \"\"\"\n        Identifies divisors common to both input lists.\n        \"\"\"\n        return sorted(list(set(divisors1) & set(divisors2)))\n\n    divisors_num1 = _find_divisors(num1)\n    divisors_num2 = _find_divisors(num2)\n    common_divs = _find_common_divisors(divisors_num1, divisors_num2)\n    return sum(common_divs)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n    max_diff_so_far = 0\n    current_max_diff = 0\n\n    for char in binary_string:\n        if char == '0':\n            current_max_diff += 1\n        else:  # char == '1'\n            current_max_diff -= 1\n\n        # If current_max_diff becomes negative, it means this sub-string\n        # is not contributing positively to the difference, so we reset it to 0\n        # and start a new potential sub-string from the next character.\n        if current_max_diff < 0:\n            current_max_diff = 0\n        \n        # Update the maximum difference found so far\n        max_diff_so_far = max(max_diff_so_far, current_max_diff)\n\n    return max_diff_so_far"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Uses internal helper functions for counting and finding the maximum.\n    \"\"\"\n\n    def _count_frequencies(items_list: list) -> dict:\n        \"\"\"Counts the frequency of each item in the input list.\"\"\"\n        frequencies = {}\n        for item in items_list:\n            frequencies[item] = frequencies.get(item, 0) + 1\n        return frequencies\n\n    def _find_max_frequency_item(frequencies_map: dict):\n        \"\"\"Finds the item with the maximum frequency from a frequency dictionary.\"\"\"\n        if not frequencies_map:\n            return None # Handle empty frequency map\n\n        max_item = None\n        max_freq = -1\n\n        for item, freq in frequencies_map.items():\n            if freq > max_freq:\n                max_freq = freq\n                max_item = item\n        return max_item\n\n    frequencies = _count_frequencies(items)\n    most_frequent_item = _find_max_frequency_item(frequencies)\n    return most_frequent_item"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\ndef _is_square(matrix: List[List[int]]) -> bool:\n    \"\"\"Checks if the given matrix is square and non-empty.\"\"\"\n    n = len(matrix)\n    if n == 0:\n        return False  # An empty matrix is not considered a magic square\n    for row in matrix:\n        if len(row) != n:\n            return False\n    return True\n\ndef _calculate_row_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n    row_sums = []\n    for row in matrix:\n        row_sums.append(sum(row))\n    return row_sums\n\ndef _calculate_column_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n    n = len(matrix)\n    column_sums = [0] * n\n    for i in range(n):\n        for j in range(n):\n            column_sums[j] += matrix[i][j]\n    return column_sums\n\ndef _calculate_main_diagonal_sum(matrix: List[List[int]]) -> int:\n    \"\"\"Calculates the sum of the main diagonal.\"\"\"\n    n = len(matrix)\n    main_diagonal_sum = 0\n    for i in range(n):\n        main_diagonal_sum += matrix[i][i]\n    return main_diagonal_sum\n\ndef _calculate_anti_diagonal_sum(matrix: List[List[int]]) -> int:\n    \"\"\"Calculates the sum of the anti-diagonal.\"\"\"\n    n = len(matrix)\n    anti_diagonal_sum = 0\n    for i in range(n):\n        anti_diagonal_sum += matrix[i][n - 1 - i]\n    return anti_diagonal_sum\n\ndef _all_sums_equal(sums: List[int]) -> bool:\n    \"\"\"Checks if all sums in a list are equal.\"\"\"\n    if not sums:\n        return True  # An empty list of sums trivially means all sums are equal (no sums to compare)\n    first_sum = sums[0]\n    for s in sums:\n        if s != first_sum:\n            return False\n    return True\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Validates whether a matrix is a magic square.\n\n    Args:\n        matrix: Two-dimensional list of positive integers\n\n    Returns:\n        bool: True if matrix is a magic square, False otherwise\n    \"\"\"\n    if not _is_square(matrix):\n        return False\n\n    # For a 1x1 matrix, it's always a magic square\n    if len(matrix) == 1:\n        return True\n\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    all_sums = row_sums + column_sums + [main_diag_sum, anti_diag_sum]\n\n    return _all_sums_equal(all_sums)"}
