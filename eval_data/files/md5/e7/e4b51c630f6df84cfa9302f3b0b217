{"task_id": "Mbpp/763", "solution": "def find_min_diff(array: tuple, length: int) -> int:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in a given array.\n    \"\"\"\n    if length < 2:\n        # As per design context, arrays with at least 2 elements are handled.\n        # This case is technically an edge case not explicitly required to raise an error.\n        # Returning 0 or similar is an option, but for valid inputs, this won't be hit.\n        # Given the prompt's constraints (\"DO NOT add isinstance() checks or raise exceptions for edge cases\"),\n        # we proceed with the assumption length >= 2 for the core logic.\n        return 0 # Or some other default if strictly necessary, but not specified.\n\n    # Convert tuple to list for sorting\n    arr_list = list(array)\n    arr_list.sort()\n\n    min_diff = float('inf')\n\n    # Iterate through sorted array to find minimum difference between adjacent elements\n    for i in range(1, length):\n        current_diff = arr_list[i] - arr_list[i-1]\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return min_diff"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Check whether the given month number contains 30 days.\n\n    Args:\n        month_number (int): Month number from 1 to 12\n\n    Returns:\n        bool: True if month has exactly 30 days, False otherwise\n    \"\"\"\n    THIRTY_DAY_MONTHS = {4, 6, 9, 11}\n    VALID_MONTH_RANGE = range(1, 13)\n\n    if month_number not in VALID_MONTH_RANGE:\n        return False\n\n    return month_number in THIRTY_DAY_MONTHS"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple\n\ndef pair_wise(input_list: List) -> List[Tuple]:\n    \"\"\"\n    Generate consecutive pairs from input list.\n\n    Returns an empty list if input has fewer than 2 items.\n    \"\"\"\n    pairs = []\n    for i in range(len(input_list) - 1):\n        pairs.append((input_list[i], input_list[i+1]))\n    return pairs"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculate sum of fourth powers of first n odd natural numbers.\n\n    Args:\n        n (int): Number of odd natural numbers to process\n\n    Returns:\n        int: Sum of fourth powers\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_num = 2 * i - 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals a target value.\n    Each distinct pair of elements (by index) is counted.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(first_list: list, second_list: list) -> list:\n    \"\"\"\n    Calculate difference between two lists.\n    Returns a list containing elements from first_list not in second_list,\n    preserving original order from first_list.\n    \"\"\"\n    # Convert second_list to a set for efficient O(1) average time lookups.\n    second_set = set(second_list)\n    \n    result = []\n    # Iterate through first_list to preserve the order of elements.\n    for item in first_list:\n        if item not in second_set:\n            result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of 2.\n    The function iterates through positive integers, skipping powers of 2, until the nth such number is found.\n    \"\"\"\n    polite_count = 0\n    current_num = 1\n    while True:\n        # A positive integer x is a power of 2 if x > 0 and (x & (x - 1)) == 0.\n        # Polite numbers are all positive integers EXCEPT powers of 2.\n        if current_num > 0 and (current_num & (current_num - 1)) == 0:\n            # current_num is a power of 2, so it is not polite. Skip it.\n            pass\n        else:\n            # current_num is not a power of 2, thus it's a polite number.\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of exactly k characters from the input string.\"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Supports parentheses `()`, square brackets `[]`, and curly braces `{}`.\n    \"\"\"\n    BRACKET_PAIRS = {'(': ')', '[': ']', '{': '}'}\n    OPENING_BRACKETS = set(BRACKET_PAIRS.keys())\n    CLOSING_BRACKETS = set(BRACKET_PAIRS.values())\n\n    stack = []\n\n    for char in expression:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in CLOSING_BRACKETS:\n            if not stack:\n                return False  # Closing bracket without a matching opening bracket\n            \n            last_opening_bracket = stack.pop()\n            if BRACKET_PAIRS[last_opening_bracket] != char:\n                return False # Mismatched opening and closing bracket pair\n        # Non-bracket characters are ignored as per design\n\n    return not stack # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, substring: str) -> tuple[str, int, int] | None:\n    start_position = source_string.find(substring)\n    if start_position == -1:\n        return None\n    \n    end_position = start_position + len(substring)\n    return (substring, start_position, end_position)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every odd-indexed element in the list is an odd number.\n    Returns True if all conditions are met, False otherwise.\n    \"\"\"\n    for i in range(len(input_list)):\n        # Check if the current index is odd (1, 3, 5, ...)\n        if (i + 1) % 2 == 0:  # i+1 to match 1-based indexing for \"odd position\"\n            # If the index is odd, check if the number at that index is odd\n            if input_list[i] % 2 == 0:\n                return False  # Found an even number at an odd position\n\n    return True  # All odd positions contain odd numbers, or no odd positions exist"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int:\n    # Counts occurrences of each element and sums elements that appear exactly once.\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    total_sum = 0\n    for item, count in counts.items():\n        if count == 1:\n            total_sum += item\n            \n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef _calculate_divisors(n: int) -> int:\n    \"\"\"\n    Calculates the total count of positive divisors for a given number.\n    Counts all positive divisors including 1 and n.\n    \"\"\"\n    count = 0\n    # Iterate up to the square root of n\n    for i in range(1, math.isqrt(n) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1  # i is a divisor, and n/i is the same i\n            else:\n                count += 2  # i and n/i are two distinct divisors\n    return count\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a given positive integer n is even.\n    Returns True if the count is even, False otherwise.\n    \"\"\"\n    divisor_count = _calculate_divisors(n)\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple\n\ndef find_combinations(tuple_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Calculate pairwise sums of tuples from input list, excluding self-combinations.\n    Returns a list of all unique pairwise sum combinations.\n    \"\"\"\n    \n    # Helper function for input validation, as per design.\n    # The design states no `isinstance` checks, but the overview mentions\n    # \"Validation Layer\", \"Explicit validation of input constraints\",\n    # and the sequence diagram shows `_validate_input` returning `validation_result`\n    # or raising `ValueError`. However, the detailed requirement is \"Do NOT add\n    # isinstance() checks or raise exceptions for edge cases\".\n    # Given the conflicting information, and the primary requirement to match the\n    # assert statement, we will proceed without explicit validation within the\n    # final implementation for the core logic, assuming valid input as per the\n    # assert.\n\n    # Helper function to calculate the element-wise sum of two tuples.\n    def _calculate_sum(tuple1: Tuple[int, int], tuple2: Tuple[int, int]) -> Tuple[int, int]:\n        return (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n\n    # Generate combinations of unique pairs of indices from the input list.\n    # The design specifies \"exclude self-pairing\" and \"unique pair combination only once\".\n    # `itertools.combinations` inherently handles these aspects by selecting unique\n    # pairs of distinct elements (indices in this case) without replacement and\n    # without considering order (i.e., (a,b) is the same as (b,a)).\n    \n    # `_generate_pairs` from the design would generate (i, j) where j > i.\n    # itertools.combinations(range(len(tuple_list)), 2) does exactly this,\n    # yielding pairs of indices (i, j) such that i < j.\n    \n    sum_combinations = []\n    for i, j in itertools.combinations(range(len(tuple_list)), 2):\n        tuple1 = tuple_list[i]\n        tuple2 = tuple_list[j]\n        sum_combinations.append(_calculate_sum(tuple1, tuple2))\n\n    return sum_combinations"}
{"task_id": "Mbpp/778", "solution": "from typing import List\n\ndef pack_consecutive_duplicates(input_list: List) -> List[List]:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Each sublist contains only consecutive identical elements from the original list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result: List[List] = []\n    current_group: List = []\n\n    for element in input_list:\n        if not current_group or element != current_group[-1]:\n            # If current_group is not empty, it means a new group is starting, so finalize the old one.\n            if current_group:\n                result.append(current_group)\n            # Start a new group with the current element\n            current_group = [element]\n        else:\n            # Element is the same as the last one in current_group, so add it to the current group.\n            current_group.append(element)\n\n    # After the loop, append the last current_group if it's not empty\n    if current_group:\n        result.append(current_group)\n\n    return result"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculate the sum of all odd-length subarrays.\n\n    Args:\n        arr: List of integers\n\n    Returns:\n        Integer sum of all odd-length subarrays\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate through all possible starting points\n    for i in range(n):\n        # Iterate through all possible ending points\n        for j in range(i, n):\n            # Extract the subarray\n            subarray = arr[i : j + 1]\n            # Check if the subarray has an odd length\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    The search for both numbers is sequential from the beginning of the list.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if num % 2 == 0:  # Check if the number is even\n            if first_even is None:\n                first_even = num\n        else:  # The number is odd\n            if first_odd is None:\n                first_odd = num\n\n        # If both first even and first odd numbers have been found, we can stop searching.\n        if first_even is not None and first_odd is not None:\n            break\n            \n    # Return the product of the first even and first odd numbers found.\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    \"\"\"\n    Convert string representation of tuple to integer tuple.\n\n    Args:\n        input_string (str): String representation of tuple in format \"(n1, n2, ...)\"\n\n    Returns:\n        tuple: Tuple containing integer elements\n\n    Raises:\n        ValueError: If input string is not in valid tuple format or elements are not integers.\n        TypeError: If input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Validate input format: must start with '(' and end with ')'\n    if not (input_string.startswith('(') and input_string.endswith(')')):\n        raise ValueError(\"Invalid tuple format: Must start with '(' and end with ')'.\")\n\n    # Extract content between parentheses and strip whitespace\n    content = input_string[1:-1].strip()\n\n    # Handle empty tuple case\n    if not content:\n        return ()\n\n    # Split content by comma, handling potential whitespace around elements\n    str_elements = [elem.strip() for elem in content.split(',')]\n\n    # Convert string elements to integers\n    integer_elements = []\n    for s_elem in str_elements:\n        try:\n            integer_elements.append(int(s_elem))\n        except ValueError:\n            raise ValueError(f\"Invalid tuple format: Element '{s_elem}' is not a valid integer.\")\n\n    return tuple(integer_elements)"}
