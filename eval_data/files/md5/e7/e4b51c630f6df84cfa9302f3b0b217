{"task_id": "Mbpp/141", "solution": "def flip(arr, i):\n    \"\"\"Reverses the sublist from index 0 to i (inclusive) in-place.\"\"\"\n    start = 0\n    while start < i:\n        arr[start], arr[i] = arr[i], arr[start]\n        start += 1\n        i -= 1\n\ndef find_max_index(arr, n):\n    \"\"\"Finds the index of the maximum element in arr[0...n-1].\"\"\"\n    max_val = arr[0]\n    max_idx = 0\n    for k in range(1, n):\n        if arr[k] > max_val:\n            max_val = arr[k]\n            max_idx = k\n    return max_idx\n\ndef pancake_sort(input_list):\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return input_list[:] # Return a copy for empty or single-element lists.\n\n    # Create a working copy to avoid modifying the original list.\n    working_list = input_list[:]\n\n    # Iterate from the full list size down to 2.\n    for current_size in range(n, 1, -1):\n        # Find the index of the largest element in the unsorted portion.\n        max_idx = find_max_index(working_list, current_size)\n\n        # If the largest element is not already at its correct position.\n        if max_idx != current_size - 1:\n            # If the largest element is not at the beginning, flip to bring it to index 0.\n            if max_idx != 0:\n                flip(working_list, max_idx)\n\n            # Flip the entire unsorted portion to move the largest element to its sorted position.\n            flip(working_list, current_size - 1)\n\n    return working_list"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical in the same position across three given lists.\n    Assumes lists are of equal length based on design context.\n    \"\"\"\n    count = 0\n    # Iterate through the lists using the index\n    for i in range(len(list1)):\n        # Check if the elements at the current position are identical in all three lists\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr) -> float:\n    \"\"\"\n    Calculate the maximum absolute difference between any two elements in an array.\n    Assumes the input array contains at least two numeric elements.\n    \"\"\"\n    n = len(arr)\n    max_difference = 0.0\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            current_diff = abs(arr[i] - arr[j])\n            if current_diff > max_difference:\n                max_difference = current_diff\n    return max_difference"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list: list, removal_list: list) -> list:\n    \"\"\"Removes all elements from the source_list that are present in the removal_list, returning a new list.\"\"\"\n    filtered_list = []\n    for element in source_list:\n        if element not in removal_list:\n            filtered_list.append(element)\n    return filtered_list"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Find the smallest power of 2 greater than or equal to n.\n    \"\"\"\n    if n <= 0:\n        return 1\n    \n    # Decrement n by 1 to handle cases where n itself is a power of 2.\n    # For example, if n=4, we want 4, not 8. n-1 will make it 3, so the loop\n    # finds the next power of 2 (4).\n    # If n=1, n-1=0, so the loop effectively finds 1.\n    n -= 1\n\n    # Propagate the most significant bit to the right\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 # For 64-bit integers\n\n    # Add 1 to get the next power of 2\n    return n + 1"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2,\n    including only positive terms.\n    \"\"\"\n    total_sum = 0\n    # Iterate 'i' from 0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        # Add the term to the sum only if it is greater than 0\n        if term > 0:\n            total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def _gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of a and b using the Euclidean algorithm.\"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef _extended_gcd(a_val: int, b_val: int) -> tuple[int, int, int]:\n    \"\"\"\n    Implements the Extended Euclidean Algorithm to find (g, x, y) such that a_val*x + b_val*y = g.\n    g is the greatest common divisor of a_val and b_val (always non-negative).\n    x and y are coefficients for the given a_val, b_val.\n    \"\"\"\n    if a_val == 0:\n        # Base case: gcd(0, b) = |b|. The equation becomes 0*x + b*y = |b|.\n        # We can set x=0. For y, it depends on the sign of b.\n        # If b is positive, y=1. If b is negative, y=-1. If b is zero, y=0.\n        return (abs(b_val), 0, (1 if b_val >= 0 else -1) if b_val != 0 else 0)\n    \n    g, x1, y1 = _extended_gcd(b_val % a_val, a_val)\n    x = y1 - (b_val // a_val) * x1\n    y = x1\n    return (g, x, y)\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    # Handle the special case where both coefficients are zero (0x + 0y = n).\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0) # Infinite solutions; (0,0) is a valid particular solution.\n        else:\n            return None # No solution if n is non-zero.\n\n    # Calculate g = gcd(a, b).\n    g = _gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Use the Extended Euclidean Algorithm to find a particular solution (x_g, y_g)\n    # for the equation a*x_g + b*y_g = g.\n    # The first return value of _extended_gcd is g, which we've already calculated.\n    _, x_g, y_g = _extended_gcd(a, b)\n\n    # Scale the particular solution (x_g, y_g) to satisfy ax + by = n.\n    # We have a*x_g + b*y_g = g.\n    # To get n on the right side, multiply the entire equation by (n // g):\n    # a*(x_g * (n // g)) + b*(y_g * (n // g)) = g * (n // g) = n.\n    factor = n // g\n    x = x_g * factor\n    y = y_g * factor\n\n    return (x, y)"}
{"task_id": "Mbpp/165", "solution": "def normalize_character(char: str) -> str:\n    \"\"\"Convert character to lowercase for comparison.\"\"\"\n    return char.lower()\n\ndef is_alphabet_position_match(char: str, position: int) -> bool:\n    \"\"\"Check if character matches alphabet position (a=0, b=1, etc.).\"\"\"\n    if not char.isalpha() or len(char) != 1:\n        return False\n    \n    alphabet_position = ord(char) - ord('a')\n    return alphabet_position == position\n\ndef count_char_position(s: str) -> int:\n    \"\"\"Count characters at matching alphabet positions (case-insensitive).\"\"\"\n    count = 0\n    for i, char in enumerate(s):\n        normalized_char = normalize_character(char)\n        if is_alphabet_position_match(normalized_char, i):\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    A pair (a, b) XORs to an even number if a and b have the same parity.\n    \"\"\"\n    even_xor_count = 0\n    n = len(numbers)\n\n    # Iterate through all unique pairs\n    for i in range(n):\n        for j in range(i + 1, n):\n            num1 = numbers[i]\n            num2 = numbers[j]\n\n            # Check if num1 and num2 have the same parity\n            # If (num1 % 2) == (num2 % 2), then their XOR is even.\n            # Example: odd ^ odd = even, even ^ even = even.\n            if (num1 % 2) == (num2 % 2):\n                even_xor_count += 1\n\n    return even_xor_count"}
