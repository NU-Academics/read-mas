{"task_id": "Mbpp/804", "solution": "import math\n\ndef is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    An empty list's product is conventionally 1, which is odd, but per design notes\n    it returns True (even) for an empty list.\n    \"\"\"\n    if not numbers:\n        # As per design (UC-005), an empty list should return True (even).\n        return True\n\n    product = 1\n    for num in numbers:\n        if num == 0:\n            return True # If any number is 0, the product is 0, which is even.\n        product *= num\n\n    return product % 2 == 0"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Returns True if all elements in tuple2 are smaller, False otherwise or if lengths differ.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    # For empty tuples, the condition \"each element of second tuple is smaller...\" is vacuously true.\n    if not tuple1:\n        return True\n\n    for i in range(len(tuple1)):\n        if tuple2[i] >= tuple1[i]:\n            return False\n    return True"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Find maximum run of consecutive uppercase characters in string.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
