{"task_id": "Mbpp/440", "solution": "import re\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_position, end_position, adverb_text) or (None, None, None) if not found.\n    \"\"\"\n\n    def _clean_punctuation(word: str) -> str:\n        \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n        return re.sub(r'^\\W+|\\W+$', '', word)\n\n    def _is_adverb(word: str) -> bool:\n        \"\"\"Determines if a word is an adverb using common patterns and a small list of exceptions.\"\"\"\n        lower_word = word.lower()\n        # A curated list of common adverbs that do not typically end in -ly\n        non_ly_adverbs = {\n            \"very\", \"well\", \"always\", \"never\", \"often\", \"sometimes\", \"fast\", \"hard\", \"late\", \"early\",\n            \"straight\", \"daily\", \"weekly\", \"monthly\", \"yearly\", \"quite\", \"rather\", \"almost\", \"already\",\n            \"just\", \"still\", \"yet\", \"ever\", \"hardly\", \"scarcely\", \"barely\", \"ago\", \"today\", \"tomorrow\",\n            \"yesterday\", \"here\", \"there\", \"everywhere\", \"anywhere\", \"nowhere\", \"soon\", \"then\", \"now\",\n            \"back\", \"far\", \"near\", \"only\", \"even\", \"much\", \"too\", \"enough\", \"around\", \"away\", \"down\", \"in\",\n            \"off\", \"on\", \"out\", \"over\", \"up\"\n        }\n        \n        if lower_word in non_ly_adverbs:\n            return True\n        \n        # Heuristic: check if the word ends with 'ly'\n        if lower_word.endswith('ly') and len(lower_word) > 2: # 'ly' itself is not an adverb\n            return True\n            \n        return False\n\n    def _tokenize_with_positions(sentence: str) -> list:\n        \"\"\"Splits the sentence into words (sequences of non-whitespace characters) while tracking their positions.\"\"\"\n        tokens = []\n        # Use regex to find all sequences of non-whitespace characters, treating them as words/tokens.\n        for match in re.finditer(r'\\S+', sentence):\n            tokens.append({\n                'text': match.group(0),\n                'start_pos': match.start(),\n                'end_pos': match.end()\n            })\n        return tokens\n\n    def _calculate_positions(sentence: str, word_start: int, clean_word: str) -> tuple:\n        \"\"\"\n        Calculates the exact start and end positions of the cleaned adverb within the original sentence.\n        `word_start` is the start index of the original token in `sentence`.\n        `clean_word` is the adverb text after punctuation removal.\n        \"\"\"\n        # Extract the portion of the sentence that contains the original token.\n        # We take a slice slightly larger than the clean_word to ensure we capture any trailing punctuation\n        # and correctly locate the clean_word within its original context.\n        original_token_segment = sentence[word_start : word_start + len(clean_word) + 10] # A heuristic length\n\n        # Find the starting index of the clean_word within this segment (case-insensitive search).\n        # This handles leading punctuation by finding where the actual clean_word begins.\n        relative_start_in_segment = original_token_segment.lower().find(clean_word.lower())\n\n        if relative_start_in_segment == -1:\n            # This case indicates an unexpected mismatch, though it should ideally not happen\n            # if clean_word is derived directly from a substring of sentence[word_start:].\n            return (None, None, None) \n        \n        final_start_pos = word_start + relative_start_in_segment\n        final_end_pos = final_start_pos + len(clean_word)\n        \n        return (final_start_pos, final_end_pos, clean_word)\n\n    # Main logic of the find_adverb_position function\n    tokens = _tokenize_with_positions(sentence)\n\n    for token_info in tokens:\n        original_text = token_info['text']\n        original_start_pos = token_info['start_pos']\n\n        cleaned_text = _clean_punctuation(original_text)\n\n        # Check if the cleaned text is not empty and is identified as an adverb\n        if cleaned_text and _is_adverb(cleaned_text):\n            # If an adverb is found, calculate its precise position in the original sentence\n            start, end, adverb_found = _calculate_positions(sentence, original_start_pos, cleaned_text)\n            # Return the first adverb found and its details\n            return (start, end, adverb_found)\n\n    # If the loop completes without finding any adverb, return (None, None, None)\n    return (None, None, None)"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(n).\n    The sequence is defined by P(0)=3, P(1)=0, P(2)=2, and P(k) = P(k-2) + P(k-3) for k > 2.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    # Initialize the Perrin sequence with its first three defined values.\n    perrin_numbers = [3, 0, 2]\n\n    # If n is a small index already covered by the initial values.\n    # We need to sum up to P(n), so we take n+1 elements.\n    if n < len(perrin_numbers):\n        return sum(perrin_numbers[:n + 1])\n\n    # Generate subsequent Perrin numbers up to P(n).\n    # The loop starts from P(3) (index 3) and goes up to P(n) (index n).\n    for i in range(len(perrin_numbers), n + 1):\n        next_perrin = perrin_numbers[i - 2] + perrin_numbers[i - 3]\n        perrin_numbers.append(next_perrin)\n\n    # Sum all the generated Perrin numbers from P(0) to P(n).\n    return sum(perrin_numbers)"}
