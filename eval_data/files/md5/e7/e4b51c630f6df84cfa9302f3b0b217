{"task_id": "Mbpp/573", "solution": "from functools import reduce\nimport operator\n\ndef unique_product(input_list):\n    \"\"\"Calculates the product of the unique numbers in a given list.\"\"\"\n    unique_numbers = set(input_list)\n    if not unique_numbers:\n        return 1\n    return reduce(operator.mul, unique_numbers)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if a list is a contiguous sublist of another list.\n    An empty list is considered a sublist of any list.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True # An empty list is always a sublist.\n\n    if len_sub > len_main:\n        return False # A non-empty sublist cannot be longer than the main list.\n\n    for i in range(len_main - len_sub + 1):\n        # Check if the slice of main_list matches the sub_list.\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative number.\n    \"\"\"\n    if number == 0:\n        return 1\n\n    factorial_value = 1\n    for i in range(1, number + 1):\n        factorial_value *= i\n    \n    return factorial_value % 10"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    # Handle empty list directly as an edge case\n    if not input_list:\n        return []\n\n    # Count occurrences of each number using a dictionary\n    occurrence_counts = {}\n    for num in input_list:\n        occurrence_counts[num] = occurrence_counts.get(num, 0) + 1\n\n    # Filter unique numbers while preserving their original order\n    result = []\n    for num in input_list:\n        if occurrence_counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleave three lists of equal length into a single flat list.\n    \"\"\"\n    interleaved_list = []\n    num_elements = len(list1)\n    for i in range(num_elements):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n    return interleaved_list"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple):\n    \"\"\"\n    Recursively filters a nested mixed tuple, removing odd integer elements.\n    Preserves even integers and the overall tuple structure.\n    \"\"\"\n    processed_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                processed_elements.append(element)\n        elif isinstance(element, tuple):\n            processed_elements.append(extract_even(element))\n        else:\n            processed_elements.append(element)\n    return tuple(processed_elements)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"\n    Finds elements that are present in one tuple but not in the other.\n    Returns the dissimilar elements as a sorted tuple for consistent order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements_set = set1 ^ set2  # Symmetric difference\n    return tuple(sorted(list(dissimilar_elements_set)))"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid with a given base edge and height.\n    The formula used is base area + 4 * triangular face area.\n    \"\"\"\n    base_area = base_edge * base_edge\n    \n    # Calculate the slant height using the Pythagorean theorem\n    # The apothem of the square base (distance from center to midpoint of a base edge) is base_edge / 2\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n    \n    # Calculate the area of one triangular face: 0.5 * base * slant_height\n    triangular_face_area = 0.5 * base_edge * slant_height\n    \n    # Total surface area is the sum of the base area and the areas of the four triangular faces\n    total_surface_area = base_area + 4 * triangular_face_area\n    \n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number using an iterative formula.\n    Assumes n is a non-negative integer (0-indexed).\n    \"\"\"\n    if n == 0:\n        return 1\n\n    catalan = 1\n    for k in range(1, n + 1):\n        catalan = catalan * (2 * (2 * k - 1)) // (k + 1)\n        \n    return catalan"}
