{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr) -> bool:\n    \"\"\"\n    Check if the given array represents a min heap.\n    It validates that each parent node is less than or equal to its children.\n    \"\"\"\n    n = len(arr)\n\n    # An empty or single-element array is considered a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all potential parent nodes.\n    # The last parent node with at least one child is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        # Only check if right child exists and its index is within bounds\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number.\n    J(n) = J(n-1) + 2*J(n-2) with J(0)=0, J(1)=1, J(2)=1.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1 or n == 2:\n        return 1\n\n    # Initialize for J(1) and J(2) as we start calculating from J(3)\n    # j_n_minus_2 holds the value for J(i-2)\n    # j_n_minus_1 holds the value for J(i-1)\n    j_n_minus_2 = 1  # Corresponds to J(1)\n    j_n_minus_1 = 1  # Corresponds to J(2)\n\n    for _ in range(3, n + 1):\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list, k):\n    \"\"\"\n    Finds the k records with the minimum second element from a list of tuples.\n    Returns the k smallest tuples, sorted by their second element.\n    \"\"\"\n    if k <= 0:\n        return []\n    \n    # Sort the list of tuples based on the second element (index 1)\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    \n    # Return the first k elements from the sorted list\n    return sorted_list[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    Returns a list of these common elements.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> number:\n    \"\"\"\n    Find the second smallest unique number in a list.\n\n    Args:\n        numbers (list): List of numerical values\n\n    Returns:\n        number: The second smallest unique value\n\n    Raises:\n        ValueError: If list has fewer than 2 unique values\n    \"\"\"\n    unique_numbers = list(set(numbers))\n    unique_numbers.sort()\n\n    if len(unique_numbers) < 2:\n        raise ValueError(\"List must contain at least two unique numbers.\")\n\n    return unique_numbers[1]"}
