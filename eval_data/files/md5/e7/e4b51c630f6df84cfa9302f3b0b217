{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(number: int) -> int:\n    \"\"\"\n    Finds the smallest perfect square greater than the given number.\n    Assumes positive integer input.\n    \"\"\"\n    # Calculate the integer part of the square root of the number.\n    # We add 1 to this integer to find the root of the next potential perfect square.\n    next_root = math.floor(math.sqrt(number)) + 1\n    # Square this next root to get the next perfect square.\n    return next_root * next_root"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculate the number of possible sequences of length n,\n    such that each element is a positive integer, is greater than or equal to\n    twice the previous element, and is less than or equal to m.\n    \"\"\"\n    # dp[k][v] stores the number of valid sequences of length k starting with value v.\n    # Initialize dp table with zeros. dp[k] will be a list of size (m+1).\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # suffix_sum[k][v] stores the sum of dp[k][x] for x from v to m.\n    # This helps in O(1) retrieval of sums. suffix_sum[k] will be a list of size (m+2).\n    # The extra element at index m+1 is for boundary conditions, effectively 0.\n    suffix_sum = [[0] * (m + 2) for _ in range(n + 1)]\n\n    # Base case: sequences of length 1\n    # Any positive integer from 1 to m can be a sequence of length 1.\n    for v in range(1, m + 1):\n        dp[1][v] = 1\n\n    # Calculate suffix_sum for length 1\n    for v in range(m, 0, -1):\n        suffix_sum[1][v] = dp[1][v] + suffix_sum[1][v + 1]\n\n    # Fill dp table for lengths from 2 to n\n    for length in range(2, n + 1):\n        # Iterate for current starting value 'v' from 1 to m\n        for v in range(1, m + 1):\n            # The next element in the sequence must be at least 2*v\n            min_next_val = v * 2\n\n            # If the minimum possible next value exceeds m, no valid sequence can extend from v.\n            if min_next_val <= m:\n                # The number of sequences of length 'length' starting with 'v'\n                # is the sum of sequences of length 'length-1' starting with any value 'x'\n                # where 'x' is between 'min_next_val' and 'm'.\n                # This sum is efficiently retrieved from suffix_sum[length-1][min_next_val].\n                dp[length][v] = suffix_sum[length - 1][min_next_val]\n            else:\n                # No valid next element, so no sequences of this length can start with v.\n                dp[length][v] = 0\n        \n        # After computing dp[length][v] for all v, calculate suffix_sum for current 'length'\n        for v in range(m, 0, -1):\n            suffix_sum[length][v] = dp[length][v] + suffix_sum[length][v + 1]\n\n    # The total number of sequences of length n is the sum of dp[n][v] for all v from 1 to m.\n    # This is equivalent to suffix_sum[n][1].\n    return suffix_sum[n][1]"}
{"task_id": "Mbpp/250", "solution": "def count_X(input_tuple: tuple, target_element: any) -> int:\n    \"\"\"\n    Count occurrences of target_element in input_tuple using exact equality.\n    Returns integer count of occurrences (0 if not found).\n    \"\"\"\n    count = 0\n    for element in input_tuple:\n        if element == target_element:\n            count += 1\n    return count"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculate the length of the longest palindromic subsequence.\n\n    Args:\n        s (str): Input string containing alphabetic characters and spaces\n\n    Returns:\n        int: Length of the longest palindromic subsequence\n    \"\"\"\n    n = len(s)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of length 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1 # j is the ending index of the current substring s[i...j]\n\n            if s[i] == s[j]:\n                # If the characters at the ends match, they contribute 2 to the LPS.\n                # We add 2 to the LPS of the inner substring s[i+1...j-1].\n                # If length is 2, the inner substring is empty (length 0), so its LPS is 0.\n                dp[i][j] = 2 + (dp[i+1][j-1] if length > 2 else 0)\n            else:\n                # If characters do not match, take the maximum of two options:\n                # 1. Exclude s[i] (LPS of s[i+1...j])\n                # 2. Exclude s[j] (LPS of s[i...j-1])\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n    # The result is the LPS of the entire string s[0...n-1]\n    return dp[0][n-1]"}
{"task_id": "Mbpp/251", "solution": "def insert_element(input_list: list, element: object) -> list:\n    \"\"\"\n    Inserts a given element before each element in the input list, returning a new list.\n    The original input list remains unchanged.\n    \"\"\"\n    result_list = []\n    for item in input_list:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    # Handle edge cases for empty or single-element arrays\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # dp_increasing[i] stores the maximum sum of an increasing subsequence ending at arr[i]\n    dp_increasing = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                dp_increasing[i] = max(dp_increasing[i], arr[i] + dp_increasing[j])\n\n    # dp_decreasing[i] stores the maximum sum of a decreasing subsequence starting at arr[i]\n    dp_decreasing = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(i + 1, n):\n            if arr[j] < arr[i]:\n                dp_decreasing[i] = max(dp_decreasing[i], arr[i] + dp_decreasing[j])\n\n    # Calculate the maximum bitonic sum by combining dp_increasing and dp_decreasing arrays\n    # For each element arr[i] acting as the peak of a bitonic subsequence,\n    # the sum is dp_increasing[i] + dp_decreasing[i] - arr[i].\n    # Subtract arr[i] because it's included in both increasing and decreasing sums.\n    max_bitonic_sum = 0\n    for i in range(n):\n        current_sum = dp_increasing[i] + dp_decreasing[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_sum)\n\n    return max_bitonic_sum"}
