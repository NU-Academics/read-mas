{"task_id": "Mbpp/453", "solution": "from typing import List\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"Calculates the sum of even factors for a given number using helper functions.\"\"\"\n\n    def _find_factors(num: int) -> List[int]:\n        \"\"\"Finds all factors of a given number.\"\"\"\n        factors = []\n        for i in range(1, num + 1):\n            if num % i == 0:\n                factors.append(i)\n        return factors\n\n    def _filter_even_factors(factors: List[int]) -> List[int]:\n        \"\"\"Filters a list of numbers to include only even numbers.\"\"\"\n        return [f for f in factors if f % 2 == 0]\n\n    def _calculate_sum(numbers: List[int]) -> int:\n        \"\"\"Calculates the sum of numbers in a list.\"\"\"\n        return sum(numbers)\n\n    all_factors = _find_factors(number)\n    even_factors = _filter_even_factors(all_factors)\n    total_sum = _calculate_sum(even_factors)\n    return total_sum"}
{"task_id": "Mbpp/450", "solution": "from typing import List\n\ndef extract_string(string_list: List[str], size: int) -> List[str]:\n    \"\"\"\n    Extract strings of specified length from a list of strings.\n\n    Args:\n        string_list: List of strings to filter\n        size: Target string length\n\n    Returns:\n        List of strings with length equal to size parameter\n    \"\"\"\n    return [s for s in string_list if len(s) == size]"}
{"task_id": "Mbpp/454", "solution": "import re\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains any words with the character 'z'.\n    Punctuation marks are treated as word separators, and matching is case-sensitive.\n    \"\"\"\n    def _extract_words(text: str) -> list[str]:\n        \"\"\"\n        Extracts words from the input text, treating non-alphanumeric characters as separators.\n        \"\"\"\n        return re.findall(r'[a-zA-Z0-9]+', text)\n\n    def _contains_z(word: str) -> bool:\n        \"\"\"\n        Checks if a word contains the case-sensitive character 'z'.\n        \"\"\"\n        return 'z' in word\n\n    # Handle empty strings as per design context for efficiency and clarity\n    if not input_string:\n        return False\n\n    words = _extract_words(input_string)\n    for word in words:\n        if _contains_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a month with 31 days.\n    Returns True for months 1, 3, 5, 7, 8, 10, 12, and False otherwise.\n    \"\"\"\n    MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n\n    # Validate the month number is within the standard range (1-12).\n    if not (1 <= month_number <= 12):\n        return False\n\n    # Check if the valid month number is in the set of 31-day months.\n    return month_number in MONTHS_WITH_31_DAYS"}
