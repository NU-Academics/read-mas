{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix_list: list[list[int]]) -> float:\n    \"\"\"\n    Finds a path with the maximum average cost from top-left to bottom-right in a matrix.\n    Paths only move right or down.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n        def __init__(self, row: int, column: int, cost: int):\n            self._row = row\n            self._column = column\n            self._cost = cost\n\n        def get_row(self) -> int:\n            return self._row\n\n        def get_column(self) -> int:\n            return self._column\n\n        def get_cost(self) -> int:\n            return self._cost\n\n        def __eq__(self, other) -> bool:\n            # Assuming 'other' is also a Cell instance for comparison.\n            return self._row == other._row and self._column == other._column and self._cost == other._cost\n\n        def __hash__(self):\n            return hash((self._row, self._column, self._cost))\n\n    class Path:\n        \"\"\"Manages a sequence of cells and calculates its average cost.\"\"\"\n        def __init__(self):\n            self._cells: list[Cell] = []\n\n        def add_cell(self, cell: Cell) -> None:\n            self._cells.append(cell)\n\n        def calculate_average(self) -> float:\n            total_cost = self.get_total_cost()\n            length = self.get_length()\n            return float(total_cost) / length if length > 0 else 0.0\n\n        def get_total_cost(self) -> int:\n            return sum(cell.get_cost() for cell in self._cells)\n\n        def get_length(self) -> int:\n            return len(self._cells)\n\n        def get_cells(self) -> list[Cell]:\n            # Returns a copy of the cells to prevent external modification.\n            return list(self._cells)\n\n    class Matrix:\n        \"\"\"Encapsulates matrix data and provides access methods.\"\"\"\n        def __init__(self, cells_data: list[list[int]]):\n            self._cells_data = cells_data\n            self._size = len(cells_data)\n\n        def get_cell_cost(self, row: int, col: int) -> int:\n            return self._cells_data[row][col]\n\n        def get_size(self) -> int:\n            return self._size\n\n        def is_valid_position(self, row: int, col: int) -> bool:\n            return 0 <= row < self._size and 0 <= col < self._size\n\n    class PathFinder:\n        \"\"\"Generates all paths and finds the one with the maximum average cost.\"\"\"\n        def __init__(self, matrix: 'Matrix'):\n            self._matrix = matrix\n            self._size = matrix.get_size()\n\n        def find_max_average_path(self) -> float:\n            \"\"\"Finds the maximum average path in the matrix.\"\"\"\n            all_paths = self._generate_all_paths()\n            if not all_paths:\n                return 0.0 # Handles cases where no paths are found.\n            \n            max_avg = 0.0\n            for path in all_paths:\n                max_avg = max(max_avg, path.calculate_average())\n            return max_avg\n\n        def _generate_all_paths(self) -> list[Path]:\n            \"\"\"Initializes and starts the recursive path generation.\"\"\"\n            start_cell_cost = self._matrix.get_cell_cost(0, 0)\n            \n            # current_path_obj is used for building a path with backtracking.\n            current_path_obj = Path()\n            current_path_obj.add_cell(Cell(0, 0, start_cell_cost))\n            \n            all_completed_paths: list[Path] = []\n            self._generate_paths_recursive(current_path_obj, 0, 0, all_completed_paths)\n            return all_completed_paths\n\n        def _generate_paths_recursive(self, current_path: Path, row: int, col: int, all_paths: list[Path]) -> None:\n            \"\"\"Recursively generates all valid paths using backtracking.\"\"\"\n            # Base case: Reached bottom-right cell.\n            if row == self._size - 1 and col == self._size - 1:\n                # Add a copy of the complete path to the list of all paths.\n                copied_path = Path()\n                for cell in current_path.get_cells():\n                    copied_path.add_cell(cell)\n                all_paths.append(copied_path)\n                return\n\n            # Move right\n            if col + 1 < self._size:\n                next_row, next_col = row, col + 1\n                cost = self._matrix.get_cell_cost(next_row, next_col)\n                current_path.add_cell(Cell(next_row, next_col, cost))\n                self._generate_paths_recursive(current_path, next_row, next_col, all_paths)\n                current_path._cells.pop() # Backtrack\n\n            # Move down\n            if row + 1 < self._size:\n                next_row, next_col = row + 1, col\n                cost = self._matrix.get_cell_cost(next_row, next_col)\n                current_path.add_cell(Cell(next_row, next_col, cost))\n                self._generate_paths_recursive(current_path, next_row, next_col, all_paths)\n                current_path._cells.pop() # Backtrack\n\n    # Main logic for maxAverageOfPath\n    matrix_obj = Matrix(matrix_list)\n    path_finder = PathFinder(matrix_obj)\n    return path_finder.find_max_average_path()"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of consecutive elements in a tuple.\n    Returns a new tuple where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Uses the formula \u03c0 * r * \u221a(r\u00b2 + h\u00b2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
