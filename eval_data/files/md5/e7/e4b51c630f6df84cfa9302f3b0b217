{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"Removes consecutive duplicates from a list, preserving the first occurrence and order.\"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != input_list[i-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    first_occurrence = -1\n\n    while left <= right:\n        mid = left + (right - left) // 2\n        if arr[mid] == target:\n            first_occurrence = mid\n            right = mid - 1  # Try to find an earlier occurrence in the left half\n        elif arr[mid] < target:\n            left = mid + 1\n        else:  # arr[mid] > target\n            right = mid - 1\n\n    return first_occurrence"}
{"task_id": "Mbpp/735", "solution": "def _get_bit_length(number: int) -> int:\n    \"\"\"Calculates the number of bits required to represent an integer.\"\"\"\n    if number == 0:\n        return 0\n    length = 0\n    temp_num = number\n    while temp_num > 0:\n        temp_num >>= 1\n        length += 1\n    return length\n\ndef _create_toggle_mask(bit_length: int) -> int:\n    \"\"\"Creates a bitmask to toggle all bits except the first and last.\"\"\"\n    if bit_length <= 2:\n        return 0\n    # Creates 'bit_length - 2' ones starting from position 0, then shifts them left by 1.\n    mask = ((1 << (bit_length - 2)) - 1) << 1\n    return mask\n\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    \"\"\"\n    bit_length = _get_bit_length(number)\n    toggle_mask = _create_toggle_mask(bit_length)\n    return number ^ toggle_mask"}
{"task_id": "Mbpp/734", "solution": "def generate_sublists(input_list: list) -> list:\n    \"\"\"Generates all contiguous sublists from the input list.\"\"\"\n    sublists = []\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i, n):\n            sublists.append(input_list[i : j + 1])\n    return sublists\n\ndef calculate_product(sublist: list) -> int:\n    \"\"\"Calculates the product of all elements in a given sublist.\"\"\"\n    if not sublist:\n        return 0\n    product = 1\n    for x in sublist:\n        product *= x\n    return product\n\ndef sum_products(products: list) -> int:\n    \"\"\"Sums a list of product values.\"\"\"\n    return sum(products)\n\ndef sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Finds the sum of products of all possible contiguous sublists of a given list.\n    It orchestrates sublist generation, individual product calculation, and final summation.\n    \"\"\"\n    all_sublists = generate_sublists(input_list)\n\n    list_of_products = []\n    for sublist in all_sublists:\n        list_of_products.append(calculate_product(sublist))\n\n    total_sum = sum_products(list_of_products)\n\n    return total_sum"}
