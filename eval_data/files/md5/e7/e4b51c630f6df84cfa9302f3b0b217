{"task_id": "Mbpp/724", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass MathematicalOperation:\n    \"\"\"Stores mathematical operation state and results.\"\"\"\n    base: int\n    power: int\n    result: int = 0\n    digit_sum: int = 0\n\nclass DigitProcessor:\n    \"\"\"Handles digit extraction and summation.\"\"\"\n    def extract_digits(self, number: int) -> list[int]:\n        \"\"\"Extract individual digits from number.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def sum_digits(self, digits: list[int]) -> int:\n        \"\"\"Sum list of digit values.\"\"\"\n        return sum(digits)\n\nclass PowerCalculator:\n    \"\"\"Orchestrates power calculation and digit sum computation.\"\"\"\n    def calculate_power(self, base: int, power: int) -> int:\n        \"\"\"Calculate base raised to power.\"\"\"\n        return base ** power\n\n    def power_base_sum(self, base: int, power: int) -> int:\n        \"\"\"Performs the main calculation workflow.\"\"\"\n        operation_data = MathematicalOperation(base=base, power=power)\n        \n        calculated_power = self.calculate_power(base, power)\n        operation_data.result = calculated_power\n        \n        digit_processor = DigitProcessor()\n        digits = digit_processor.extract_digits(calculated_power)\n        \n        sum_of_digits = digit_processor.sum_digits(digits)\n        operation_data.digit_sum = sum_of_digits\n        \n        return sum_of_digits\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculate sum of digits in base^power.\"\"\"\n    calculator = PowerCalculator()\n    return calculator.power_base_sum(base, power)"}
