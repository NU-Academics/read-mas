{"task_id": "Mbpp/111", "solution": "from typing import List\n\ndef common_in_nested_lists(nested_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Finds elements that are common to all sublists within a given nested list.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize the set of common elements with the elements of the first sublist.\n    # If the first sublist is empty, common_elements will be an empty set.\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the sublists to find the intersection.\n    # If common_elements becomes empty at any point, further intersections\n    # will also yield an empty set, so we can stop early.\n    for i in range(1, len(nested_lists)):\n        if not common_elements:\n            break\n        current_sublist_set = set(nested_lists[i])\n        common_elements.intersection_update(current_sublist_set)\n\n    # Convert the final set of common elements back to a list.\n    return list(common_elements)"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenating their digits.\n    Assumes valid input as per problem description (tuple of positive integers).\"\"\"\n    \n    # Convert each integer in the tuple to its string representation\n    string_integers = [str(num) for num in input_tuple]\n    \n    # Join all string representations to form a single concatenated string\n    concatenated_string = \"\".join(string_integers)\n    \n    # Convert the concatenated string back to an integer\n    # Handle the case of an empty tuple which would result in an empty string\n    if not concatenated_string:\n        return 0 # Or specify behavior for empty tuple if different is required; problem implies positive integers, so an empty tuple might return 0\n    \n    return int(concatenated_string)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, supporting optional leading signs.\n    Returns True for valid integers, False otherwise.\n    \"\"\"\n    s = input_string.strip()\n\n    if not s:\n        return False\n\n    start_index = 0\n    if s[0] == '+' or s[0] == '-':\n        start_index = 1\n\n    # After handling a potential sign, if the string is empty (e.g., \"+\", \"-\"), it's not a valid integer.\n    if start_index == len(s):\n        return False\n\n    for char in s[start_index:]:\n        if not ('0' <= char <= '9'):\n            return False\n\n    return True"}
{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"Finds the element that appears only once in a sorted array where other elements appear in pairs.\"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        if mid % 2 == 0:  # mid is at an even index\n            # If array[mid] == array[mid+1], then the pair (mid, mid+1) is complete.\n            # The unique element must be to the right of mid+1.\n            if array[mid] == array[mid+1]:\n                low = mid + 2\n            # Otherwise, array[mid] is either the unique element or the unique element\n            # is to its left (since (mid, mid+1) does not form a pair).\n            else:\n                high = mid\n        else:  # mid is at an odd index\n            # If array[mid] == array[mid-1], then the pair (mid-1, mid) is complete.\n            # The unique element must be to the right of mid.\n            if array[mid] == array[mid-1]:\n                low = mid + 1\n            # Otherwise, array[mid] is either the unique element or the unique element\n            # is to its left (since (mid-1, mid) does not form a pair).\n            else:\n                high = mid\n\n    # When the loop terminates, low == high, and this index points to the unique element.\n    return array[low]"}
