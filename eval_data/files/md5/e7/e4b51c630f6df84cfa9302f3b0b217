{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within a given array.\n    Handles positive, negative, and zero values efficiently in O(n) time.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    overall_max_product = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # Store max_so_far before updating, as min_so_far needs the old max_so_far\n        temp_max_so_far = max_so_far\n\n        # Update max_so_far: current number, product with previous max, product with previous min\n        max_so_far = max(num, num * temp_max_so_far, num * min_so_far)\n        # Update min_so_far: current number, product with previous max, product with previous min\n        min_so_far = min(num, num * temp_max_so_far, num * min_so_far)\n\n        # Update the overall maximum product\n        overall_max_product = max(overall_max_product, max_so_far)\n\n    return overall_max_product"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of array elements modulo n, preventing integer overflow.\n    \"\"\"\n    product = 1\n    for element in array:\n        product = (product * element) % n\n    return product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements in a tuple.\n    Returns a new tuple with the sums, or an empty tuple for inputs with less than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n\n    return tuple(sums)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers):\n    \"\"\"\n    Checks if a list contains consecutive numbers.\n    Assumes the input list contains only numeric values.\n    \"\"\"\n    if not numbers:\n        return False\n\n    # Sort the list to ensure numbers are in ascending order\n    # and handle cases where numbers are not initially sorted.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through the sorted list and check if each number\n    # is exactly 1 greater than the previous number.\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n    return True"}
