{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits.\n    This is calculated using the sum of squares of binomial coefficients.\n    \"\"\"\n    total_count = 0\n    # The total count is given by the sum from k=0 to n of (C(n, k))^2,\n    # where C(n, k) is the binomial coefficient \"n choose k\".\n    for k in range(n + 1):\n        combinations = math.comb(n, k)\n        total_count += combinations * combinations\n    \n    return float(total_count)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum depth of nested dictionaries within the given dictionary.\n    The root dictionary starts at depth 1.\n    \"\"\"\n\n    def _is_dictionary(obj: any) -> bool:\n        \"\"\"Checks if an object is an instance of a dictionary.\"\"\"\n        return isinstance(obj, dict)\n\n    def _calculate_max_depth(obj: any, current_depth: int) -> int:\n        \"\"\"\n        Recursively determines the maximum depth from the current object.\n        `current_depth` represents the depth of the current object if it were a dictionary.\n        \"\"\"\n        if not _is_dictionary(obj):\n            # If the current object is not a dictionary, this path does not add more depth.\n            # The depth contributed by this non-dictionary object is effectively one less than its potential.\n            return current_depth - 1\n\n        max_level_found = current_depth\n        for value in obj.values():\n            # Recursively find the maximum depth from each value, moving one level deeper.\n            max_level_found = max(max_level_found, _calculate_max_depth(value, current_depth + 1))\n        \n        return max_level_found\n\n    # Start the recursive calculation with the initial dictionary at depth 1.\n    return _calculate_max_depth(dictionary, 1)"}
{"task_id": "Mbpp/305", "solution": "def _split_words(text: str) -> list[str]:\n    \"\"\"Splits a string into individual words by whitespace.\"\"\"\n    return text.split()\n\ndef _starts_with_p(word: str) -> bool:\n    \"\"\"Checks if a word starts with the letter 'p' (case-insensitive).\"\"\"\n    return word.lower().startswith('p')\n\ndef _find_p_words(word_list: list[str]) -> list[str]:\n    \"\"\"Finds all words in a list of strings that start with 'p' (case-insensitive).\"\"\"\n    found_words = []\n    for text_block in word_list:\n        words = _split_words(text_block)\n        for word in words:\n            if _starts_with_p(word):\n                found_words.append(word)\n    return found_words\n\ndef start_withp(word_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p' (case-insensitive).\n    \"\"\"\n    p_words = _find_p_words(word_list)\n    return (p_words[0], p_words[1])"}
