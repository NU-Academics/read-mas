{"task_id": "Mbpp/616", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    def __init__(self, message: str, error_type: str = \"ValidationError\"):\n        super().__init__(message)\n        self.message = message\n        self.error_type = error_type\n\ndef validate_tuple_lengths(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"Validate that input tuples have equal length.\"\"\"\n    return len(tuple1) == len(tuple2)\n\ndef perform_element_wise_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Execute modulo operations on corresponding elements.\"\"\"\n    return tuple(e1 % e2 for e1, e2 in zip(tuple1, tuple2))\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Raises ValidationError if tuple lengths differ.\n    \"\"\"\n    if not validate_tuple_lengths(tuple1, tuple2):\n        raise ValidationError(\"Input tuples must have the same length.\")\n    return perform_element_wise_modulo(tuple1, tuple2)"}
{"task_id": "Mbpp/620", "solution": "import itertools\n\ndef largest_subset(numbers):\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    A pair (a, b) is divisible if a % b == 0 or b % a == 0.\n    \"\"\"\n    max_size = 0\n    if not numbers:\n        return max_size\n\n    # Sort the numbers to potentially optimize (though not strictly required for correctness here)\n    # and to ensure consistent behavior for subsets.\n    sorted_numbers = sorted(numbers)\n\n    # Generate all possible subsets from size 1 up to the full list size\n    for i in range(1, len(sorted_numbers) + 1):\n        for subset_tuple in itertools.combinations(sorted_numbers, i):\n            subset = list(subset_tuple)\n            \n            is_valid_subset = True\n            if len(subset) > 1:\n                # Check all pairs for divisibility in the current subset\n                for j in range(len(subset)):\n                    for k in range(j + 1, len(subset)):\n                        a, b = subset[j], subset[k]\n                        # A pair (a, b) is divisible if a % b == 0 or b % a == 0\n                        if not (a % b == 0 or b % a == 0):\n                            is_valid_subset = False\n                            break\n                    if not is_valid_subset:\n                        break\n            \n            if is_valid_subset:\n                max_size = max(max_size, len(subset))\n\n    return max_size"}
