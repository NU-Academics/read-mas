{"task_id": "Mbpp/593", "solution": "def is_valid_octet(octet: str) -> bool:\n    \"\"\"Checks if a string represents a valid IP octet (0-255).\"\"\"\n    if not octet.isdigit():\n        return False\n    num = int(octet)\n    return 0 <= num <= 255\n\ndef validate_ip_format(ip_address: str) -> bool:\n    \"\"\"Validates the overall format of an IPv4 address string.\"\"\"\n    parts = ip_address.split('.')\n    if len(parts) != 4:\n        return False\n    for part in parts:\n        if not is_valid_octet(part):\n            return False\n    return True\n\ndef parse_octets(ip_address: str) -> list[str]:\n    \"\"\"Splits an IP address string into its four octet strings.\"\"\"\n    return ip_address.split('.')\n\ndef remove_leading_zeros(octet: str) -> str:\n    \"\"\"Removes leading zeros from a single octet string.\"\"\"\n    return str(int(octet))\n\ndef reconstruct_ip(octets: list[str]) -> str:\n    \"\"\"Joins a list of octet strings back into an IP address string.\"\"\"\n    return \".\".join(octets)\n\ndef removezero_ip(ip_address: str) -> str:\n    \"\"\"\n    Removes leading zeroes from each octet of an IP address string.\n    If the IP address format is invalid, the original string is returned.\n    \"\"\"\n    if not validate_ip_format(ip_address):\n        return ip_address\n\n    octets = parse_octets(ip_address)\n    cleaned_octets = [remove_leading_zeros(octet) for octet in octets]\n    return reconstruct_ip(cleaned_octets)"}
{"task_id": "Mbpp/594", "solution": "from typing import List\n\ndef diff_even_odd(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    Assumes the list always contains at least one even and one odd number.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in input_list:\n        if num % 2 == 0:\n            first_even = num\n            break\n\n    for num in input_list:\n        if num % 2 != 0:\n            first_odd = num\n            break\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number is equal to the sum of its digits, each raised to the power of the number of digits.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    num_str = str(number)\n    num_digits = len(num_str)\n    \n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n        \n    return sum_of_powers == number"}
