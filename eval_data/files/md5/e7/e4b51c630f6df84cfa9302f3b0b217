{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    Uses the formula: 2 * pi * radius * height.\n    \"\"\"\n    return 2 * math.pi * radius * height"}
{"task_id": "Mbpp/232", "solution": "def get_unique_values(data: list) -> list:\n    \"\"\"Returns unique values while preserving order of first occurrence.\"\"\"\n    seen = set()\n    result = []\n    for item in data:\n        if item not in seen:\n            seen.add(item)\n            result.append(item)\n    return result\n\ndef sort_descending(data: list) -> list:\n    \"\"\"Sorts the input list in descending order.\"\"\"\n    return sorted(data, reverse=True)\n\ndef slice_top_n(data: list, n: int) -> list:\n    \"\"\"Returns the first n elements from the list.\"\"\"\n    return data[:n]\n\ndef handle_edge_cases(input_list: list, n: int) -> list:\n    \"\"\"Handles n exceeding list length by passing the list for further processing. This function doesn't alter the list content or n.\"\"\"\n    return list(input_list)\n\ndef larg_nnum(input_list: list, n: int) -> list:\n    \"\"\"Returns a list containing the n largest items from the input list.\"\"\"\n    # Apply edge case handling as specified in the design.\n    processed_list = handle_edge_cases(input_list, n)\n\n    # Process the list: get unique values, sort, and slice.\n    unique_items = get_unique_values(processed_list)\n    sorted_unique_items = sort_descending(unique_items)\n    result = slice_top_n(sorted_unique_items, n)\n\n    return result"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings of a given string using a mathematical formula.\n    \"\"\"\n    n = len(input_string)\n    return n * (n + 1) // 2"}
{"task_id": "Mbpp/237", "solution": "def check_occurences(tuple_list):\n    \"\"\"\n    Counts the occurrences of unique tuples in a list, treating tuples as equivalent regardless of element order.\n    Tuples are normalized by sorting their elements before counting.\n    \"\"\"\n    counts = {}\n    for original_tuple in tuple_list:\n        # Normalize the tuple by sorting its elements to create a canonical form.\n        normalized_tuple = tuple(sorted(original_tuple))\n        # Increment the count for the normalized tuple, initializing to 0 if not present.\n        counts[normalized_tuple] = counts.get(normalized_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(number: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits (0, 2, 4, 6, etc.) of the given number to 1.\n    Preserves all odd-positioned bits in the number.\n    \"\"\"\n    # A mask where all even-positioned bits are 1 and odd-positioned bits are 0.\n    # This 64-bit mask ensures that when OR'd with the number, all even bits are set.\n    even_bits_mask = 0x5555555555555555\n    \n    # Perform a bitwise OR operation to set all even bits in the number to 1.\n    return number | even_bits_mask"}
