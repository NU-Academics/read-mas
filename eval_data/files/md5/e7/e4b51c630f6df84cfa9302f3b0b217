{"task_id": "Mbpp/84", "solution": "class InputValidator:\n    \"\"\"Provides input validation services.\"\"\"\n    def validate_position(self, n: int) -> bool:\n        \"\"\"Validates if n is a positive integer.\"\"\"\n        # Per constraints, no isinstance checks or exceptions.\n        # Assumes n is an integer; validates if it's positive.\n        return n > 0\n\n    def is_positive_integer(self, value: any) -> bool:\n        \"\"\"Checks if a value is a positive integer.\"\"\"\n        # Per constraints, no isinstance checks or exceptions.\n        # Assumes value is an integer; checks if it's positive.\n        return value > 0\n\nclass NewmanConwayAlgorithm:\n    \"\"\"Executes Newman-Conway sequence computation with memoization.\"\"\"\n    def __init__(self):\n        self.memo = {1: 1, 2: 1}\n\n    def compute_sequence_value(self, n: int) -> int:\n        \"\"\"Calculates the nth Newman-Conway number using memoization.\"\"\"\n        if n in self.memo:\n            return self.memo[n]\n\n        p_n_minus_1 = self.compute_sequence_value(n - 1)\n        term1_index = p_n_minus_1\n        term1 = self.compute_sequence_value(term1_index)\n\n        term2_index = n - p_n_minus_1\n        term2 = self.compute_sequence_value(term2_index)\n\n        result = term1 + term2\n        self.memo[n] = result\n        return result\n\nclass SequencePosition:\n    \"\"\"Represents a sequence position value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.is_valid = False\n\n    def validate(self) -> bool:\n        \"\"\"Performs minimal validation of the position value.\"\"\"\n        self.is_valid = (self.value > 0)\n        return self.is_valid\n\nclass SequenceResult:\n    \"\"\"Encapsulates a sequence calculation result.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\nclass SequenceCalculator:\n    \"\"\"Main controller for the sequence calculation workflow.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.algorithm = NewmanConwayAlgorithm()\n\n    def calculate_newman_conway(self, position: int) -> int:\n        \"\"\"Orchestrates validation and algorithm execution to find the sequence value.\"\"\"\n        # Per constraints, no exceptions are raised based on validation outcome.\n        _is_valid = self.validator.validate_position(position)\n\n        result_value = self.algorithm.compute_sequence_value(position)\n        return result_value\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    This function orchestrates the calculation using internal helper classes.\n    \"\"\"\n    calculator = SequenceCalculator()\n    return calculator.calculate_newman_conway(n)"}
