{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Determine if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS\n\ndef _preserve_case(original_char: str, new_char: str) -> str:\n    \"\"\"Apply the case of the original character to the new character.\"\"\"\n    if original_char.isupper():\n        return new_char.upper()\n    return new_char.lower()\n\ndef _extract_vowels(text: str) -> list[tuple[str, int]]:\n    \"\"\"Extracts all vowel characters along with their original indices.\"\"\"\n    vowels_with_pos = []\n    for i, char in enumerate(text):\n        if _is_vowel(char):\n            vowels_with_pos.append((char, i))\n    return vowels_with_pos\n\ndef _reconstruct_string(original: str, reversed_vowels: list[str]) -> str:\n    \"\"\"Rebuilds the string by placing reversed vowels into their original positions.\"\"\"\n    result_chars = list(original)\n    reversed_vowel_ptr = 0\n\n    for i, char in enumerate(original):\n        if _is_vowel(char):\n            new_vowel_base = reversed_vowels[reversed_vowel_ptr]\n            result_chars[i] = _preserve_case(char, new_vowel_base)\n            reversed_vowel_ptr += 1\n    return \"\".join(result_chars)\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels of a given string while preserving consonant positions and case.\"\"\"\n    vowels_with_pos = _extract_vowels(input_string)\n\n    if not vowels_with_pos:\n        return input_string\n\n    # Extract just the vowel characters (their original case is not important for reversing, only for placing)\n    original_vowel_chars = [item[0] for item in vowels_with_pos]\n    reversed_vowel_chars = original_vowel_chars[::-1]\n\n    return _reconstruct_string(input_string, reversed_vowel_chars)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(array: list[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Handles division by zero by returning float('inf') or float('nan') as per standard float division.\"\"\"\n    zeros = 0\n    non_zeros = 0\n\n    for x in array:\n        if x == 0:\n            zeros += 1\n        else:\n            non_zeros += 1\n\n    return float(zeros) / non_zeros"}
