{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning it alternates between exactly two different digits and has at least 3 digits.\n    \"\"\"\n    if number < 100:  # Undulating numbers must have at least 3 digits\n        return False\n\n    s_num = str(number)\n    \n    # Identify the first two distinct digits\n    d1 = int(s_num[0])\n    d2 = -1  # Initialize to an invalid digit\n\n    # Find the second distinct digit\n    for i in range(1, len(s_num)):\n        current_digit = int(s_num[i])\n        if current_digit != d1:\n            d2 = current_digit\n            break\n    \n    # If no second distinct digit is found (e.g., 1111), or the number only has two digits and they are the same\n    if d2 == -1:\n        return False\n    \n    # Ensure the first two digits are used correctly for comparison\n    # The first digit should be d1, the second should be d2 if they are different\n    # If d1 and d2 are found, then check the pattern\n    \n    # Validate the alternating pattern\n    for i in range(len(s_num)):\n        current_digit = int(s_num[i])\n        if i % 2 == 0:  # Even index (0, 2, 4...) should match d1\n            if current_digit != d1:\n                return False\n        else:  # Odd index (1, 3, 5...) should match d2\n            if current_digit != d2:\n                return False\n                \n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(tuples: list):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Assumes the input list is not empty and tuples have at least two elements.\n    \"\"\"\n    min_tuple = min(tuples, key=lambda x: x[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n    Assumes the input list_of_lists is not empty and contains lists.\n    \"\"\"\n    min_length = len(list_of_lists[0])\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            \n    return min_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of divisors for a given integer n.\"\"\"\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/97", "solution": "def _flatten_lists(list_of_lists: list) -> list:\n    \"\"\"Flattens a list of lists into a single list by iterating through sublists.\"\"\"\n    flattened = []\n    for sublist in list_of_lists:\n        for item in sublist:\n            flattened.append(item)\n    return flattened\n\ndef _count_frequencies(flattened_list: list) -> dict:\n    \"\"\"Counts the frequency of each element in a flat list using a dictionary.\"\"\"\n    frequencies = {}\n    for item in flattened_list:\n        frequencies[item] = frequencies.get(item, 0) + 1\n    return frequencies\n\ndef frequency_lists(list_of_lists: list[list]) -> dict[any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    It orchestrates the flattening and counting operations.\n    \"\"\"\n    flattened_list = _flatten_lists(list_of_lists)\n    frequencies = _count_frequencies(flattened_list)\n    return frequencies"}
{"task_id": "Mbpp/98", "solution": "from typing import Union\n\ndef multiply_num(numbers: Union[list, tuple]) -> float:\n    \"\"\"\n    Multiplies all numbers in a collection and divides the product by the collection's length.\n    Assumes the input collection is not empty and contains only numeric values.\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    length = len(numbers)\n    return product / length"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Convert a decimal number to its binary string equivalent without leading zeros.\n    Handles the special case where the input is 0, returning '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    temp_number = decimal_number\n\n    while temp_number > 0:\n        remainder = temp_number % 2\n        binary_digits.append(str(remainder))\n        temp_number //= 2\n\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the input integer.\n    It iteratively checks numbers starting from n + 1 until a palindrome is found.\n    \"\"\"\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a number is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    # Start checking from the number immediately after n\n    candidate = n + 1\n    while True:\n        if is_palindrome(candidate):\n            return candidate\n        candidate += 1"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"\n    Convert a snake case string to a camel case string.\n    Capitalizes the first letter of each underscore-separated word and removes underscores.\n    \"\"\"\n    words = input_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/101", "solution": "import collections\n\n\ndef kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    array_length = len(array)\n\n    # Validate k using 1-based indexing\n    if not (1 <= k <= array_length):\n        raise IndexError(\"k is out of bounds for the array.\")\n\n    # Convert 1-based k to 0-based index\n    zero_based_index = k - 1\n\n    # Access and return the element\n    return array[zero_based_index]"}
{"task_id": "Mbpp/103", "solution": "def validate_inputs(n: int, m: int) -> bool:\n    \"\"\"\n    Validates input parameters n and m.\n    Always returns True given constraints against explicit type checking or error raising.\n    \"\"\"\n    return True\n\ndef compute_eulerian(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m) using its standard recursive definition.\n    It correctly handles base cases where m is out of bounds or n is zero.\n    \"\"\"\n    if m < 0 or m >= n:\n        return 0\n    if n == 0 and m == 0:\n        return 1\n\n    return (m + 1) * compute_eulerian(n - 1, m) + \\\n           (n - m) * compute_eulerian(n - 1, m - 1)\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m) by first validating inputs\n    and then performing the core computation.\n    \"\"\"\n    validate_inputs(n, m)\n    return compute_eulerian(n, m)"}
