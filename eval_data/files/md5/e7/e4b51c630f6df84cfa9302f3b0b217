{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Check if sublist appears as contiguous subsequence in main_list.\n    Handles edge cases like empty sublists and empty main lists.\n    \"\"\"\n    n = len(main_list)\n    m = len(sublist)\n\n    if m == 0:\n        return True  # An empty sublist is always considered a sublist.\n\n    if n == 0:\n        return False # A non-empty sublist cannot be found in an empty main list.\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm.\n    Returns a new sorted list without modifying the original.\n    \"\"\"\n    n = len(arr)\n    list_copy = arr[:]\n    gap = n\n    swapped = True\n    shrink_factor = 1.3\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n        for i in range(n - gap):\n            if list_copy[i] > list_copy[i + gap]:\n                list_copy[i], list_copy[i + gap] = list_copy[i + gap], list_copy[i]\n                swapped = True\n    return list_copy"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculate Bell number for given non-negative integer.\n\n    Args:\n        n: Non-negative integer input\n\n    Returns:\n        Integer representing the Bell number\n\n    Raises:\n        ValueError: If input is negative\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # Initialize a 2D array (Bell triangle) for dynamic programming.\n    # dp[i][j] represents the number of partitions of a set of i elements where the largest block has j elements,\n    # or more simply, a value in Aitken's array.\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: B_0 = 1, which corresponds to dp[0][0] in this array formulation.\n    dp[0][0] = 1\n\n    # Fill the Bell triangle using the recurrence relations.\n    for i in range(1, n + 1):\n        # The first element of row i is the last element of row i-1.\n        dp[i][0] = dp[i-1][i-1]\n        for j in range(1, i + 1):\n            # Subsequent elements are the sum of the element to the left in the same row\n            # and the element diagonally above in the previous row.\n            dp[i][j] = dp[i][j-1] + dp[i-1][j-1]\n\n    # The Bell number B_n is the first element of the n-th row (dp[n][0]).\n    return dp[n][0]"}
