{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' anywhere within a word,\n    excluding the first and last characters of that word.\n    \"\"\"\n\n    def is_word_boundary(char: str) -> bool:\n        \"\"\"Determines if a character is a word boundary.\"\"\"\n        return not char.isalnum()\n\n    def parse_words(text: str) -> list[str]:\n        \"\"\"Extracts words from the input string based on word boundaries.\"\"\"\n        words = []\n        current_word = []\n        for char in text:\n            if is_word_boundary(char):\n                if current_word:\n                    words.append(\"\".join(current_word))\n                    current_word = []\n            else:\n                current_word.append(char)\n        if current_word:\n            words.append(\"\".join(current_word))\n        return words\n\n    def is_middle_position(position: int, word_length: int) -> bool:\n        \"\"\"Checks if a character's position is not at the start or end of a word.\"\"\"\n        return 0 < position < word_length - 1\n\n    def check_middle_z(word: str) -> bool:\n        \"\"\"Checks if a word contains 'z' in a middle position.\"\"\"\n        if len(word) < 3:  # A word needs at least 3 characters for a 'middle'\n            return False\n        for i, char in enumerate(word):\n            if char == 'z' and is_middle_position(i, len(word)):\n                return True\n        return False\n\n    words = parse_words(input_string)\n    for word in words:\n        if check_middle_z(word):\n            return True\n    return False"}
