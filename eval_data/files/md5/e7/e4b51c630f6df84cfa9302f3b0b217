{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers using a min-heap.\n    Returns the result in descending order.\n    \"\"\"\n    if n <= 0 or not numbers:\n        return []\n\n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n\n    min_heap = []\n    for num in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            # Replace the smallest element in the heap with the current larger number\n            heapq.heapreplace(min_heap, num) # heappushpop could also be used here\n\n    min_heap.sort(reverse=True)\n    return min_heap"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(string: str, character: str) -> str:\n    \"\"\"\n    Remove first and last occurrence of specified character from string.\n    If the character appears only once, it removes that single occurrence.\n    \"\"\"\n    if not character or len(character) != 1:\n        return string # Character to remove must be a single character\n\n    first_index = -1\n    last_index = -1\n\n    # Find first occurrence\n    for i in range(len(string)):\n        if string[i] == character:\n            first_index = i\n            break\n\n    # If character not found, return original string\n    if first_index == -1:\n        return string\n\n    # Find last occurrence\n    for i in range(len(string) - 1, -1, -1):\n        if string[i] == character:\n            last_index = i\n            break\n            \n    # Reconstruct the string\n    if first_index == last_index: # Only one occurrence\n        return string[:first_index] + string[first_index+1:]\n    else: # Multiple occurrences\n        return string[:first_index] + string[first_index+1:last_index] + string[last_index+1:]"}
