{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even non-negative integer in an array, returning its value and smallest index.\n    Returns an empty list if no even values are found or the input array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_index = index\n            # If value == smallest_even_value, the current smallest_index is already the smallest one\n            # because we iterate from left to right. So, no update is needed.\n\n    if smallest_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_index]"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    apples_match = re.search(r'(\\d+)\\s+apples', s)\n    oranges_match = re.search(r'(\\d+)\\s+oranges', s)\n\n    apple_count = int(apples_match.group(1)) if apples_match else 0\n    orange_count = int(oranges_match.group(1)) if oranges_match else 0\n\n    mango_count = n - (apple_count + orange_count)\n    return mango_count\n```\n"}
{"task_id": "HumanEval/68", "solution": "```python\ndef pluck(arr):\n    \"\"\"Finds the smallest even-valued node and its index.\n    Returns [value, index] or [] if no even values or an empty array.\"\"\"\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_value == float('inf'):\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]\n```"}
{"task_id": "HumanEval/63", "solution": "```python\n_fibfib_memo = {}\n\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result\n\n```"}
{"task_id": "HumanEval/69", "solution": "```python\nimport collections\n\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Returns the greatest integer x from the list such that x > 0 and its frequency >= x.\n    If no such integer exists, it returns -1.\n    \"\"\"\n    # Calculate the frequency of each integer using collections.Counter.\n    frequency_map = collections.Counter(lst)\n\n    valid_candidates = []\n    # Iterate unique numbers, adding those where frequency >= value to candidates.\n    for x, freq in frequency_map.items():\n        if freq >= x:\n            valid_candidates.append(x)\n\n    # Return the greatest valid candidate, or -1 if none exist.\n    if not valid_candidates:\n        return -1\n    else:\n        return max(valid_candidates)\n```"}
{"task_id": "HumanEval/71", "solution": "```python\n# The Triangle class encapsulates triangle properties and business rules.\nclass Triangle:\n    def __init__(self, a: float, b: float, c: float):\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    # Checks if the given side lengths form a valid triangle.\n    def is_valid(self) -> bool:\n        return (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a)\n\n    # Calculates the area using Heron's formula and rounds to two decimal points.\n    def calculate_area(self) -> float:\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        # Heron's formula; using **0.5 for square root.\n        area = (s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c))**0.5\n        return round(area, 2)\n\n# Main entry point to calculate triangle area based on side lengths.\ndef triangle_area(a: float, b: float, c: float) -> float:\n    triangle = Triangle(a, b, c)\n    if triangle.is_valid():\n        return triangle.calculate_area()\n    else:\n        return -1\n```\n"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Sorts a list of integers by alternating minimum and maximum values from the remaining elements.\n    Returns a new list, leaving the original input list unchanged.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n\n    return result\n```"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    >>> circular_shift(12345, 2)\n    \"45123\"\n    >>> circular_shift(123, 4)\n    \"321\"\n    \"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        return s_x[::-1]\n    else:\n        # Perform circular right shift.\n        # Effective shift handles cases where shift >= num_digits.\n        effective_shift = shift % num_digits\n        if effective_shift == 0:\n            return s_x\n        return s_x[-effective_shift:] + s_x[:-effective_shift]\n\n```"}
{"task_id": "HumanEval/65", "solution": "```python\nclass DigitSequence:\n    \"\"\"Manages an integer's digits as a list of strings for manipulation.\"\"\"\n\n    def __init__(self, value: int):\n        \"\"\"Initializes the digit sequence from an integer.\"\"\"\n        self.digits = list(str(value))\n\n    def get_number_of_digits(self) -> int:\n        \"\"\"Returns the count of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def circular_shift_right(self, shift_amount: int):\n        \"\"\"Performs a circular right shift on the digits.\"\"\"\n        n = len(self.digits)\n        if n == 0:\n            return\n        effective_shift = shift_amount % n\n        self.digits = self.digits[-effective_shift:] + self.digits[:-effective_shift]\n\n    def reverse(self):\n        \"\"\"Reverses the order of the digits in place.\"\"\"\n        self.digits.reverse()\n\n    def to_string(self) -> str:\n        \"\"\"Converts the list of digits back into a single string.\"\"\"\n        return \"\".join(self.digits)\n\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    ds = DigitSequence(x)\n    num_digits = ds.get_number_of_digits()\n\n    if shift > num_digits:\n        ds.reverse()\n    else:\n        ds.circular_shift_right(shift)\n\n    return ds.to_string()\n```"}
{"task_id": "HumanEval/71", "solution": "import math\n\nclass Triangle:\n    \"\"\"Encapsulates triangle properties and provides methods for validation and area calculation.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the three sides form a valid triangle (positive sides and triangle inequality).\"\"\"\n        if not (self._side_a > 0 and self._side_b > 0 and self._side_c > 0):\n            return False\n        if not (\n            (self._side_a + self._side_b > self._side_c) and\n            (self._side_a + self._side_c > self._side_b) and\n            (self._side_b + self._side_c > self._side_a)\n        ):\n            return False\n        return True\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates the area of the triangle using Heron's formula. Assumes is_valid() is true.\"\"\"\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        area_squared = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        if area_squared < 0:\n            return 0.0\n        return math.sqrt(area_squared)\n\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return the area rounded to 2 decimal points if valid.\n    Otherwise, return -1.0 for an invalid triangle.\n    \"\"\"\n    triangle = Triangle(a, b, c)\n\n    if not triangle.is_valid():\n        return -1.0\n\n    area = triangle.calculate_area()\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "```python\ndef _is_palindrome(q: list) -> bool:\n    '''\n    Checks if a list q is a palindrome.\n    Returns True if q reads the same forwards and backwards.\n    '''\n    return q == q[::-1]\n\ndef _calculate_sum(q: list) -> int:\n    '''\n    Calculates the sum of all numeric elements in a list q.\n    This helper assumes elements in q are numbers.\n    '''\n    return sum(q)\n\ndef will_it_fly(q: list, w: int) -> bool:\n    '''\n    Determines if an object q will fly based on balance (palindrome) and weight.\n    Returns True if q is a palindrome AND its sum is less than or equal to w.\n    '''\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n\n    return is_balanced and total_weight <= w\n```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr: list[int]) -> int:\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef _is_palindrome(q: list) -> bool:\n    \"\"\"Checks if a list is palindromic.\n    Returns True if it reads the same forwards and backward, False otherwise.\"\"\"\n    return q == q[::-1]\n\ndef _calculate_sum(q: list) -> (int | float):\n    \"\"\"Calculates the sum of all numerical elements in a list.\n    Returns the total sum.\"\"\"\n    return sum(q)\n\ndef will_it_fly(q,w):\n    \"\"\"Determines if an object will fly based on balance and weight.\n    Returns True if balanced and within maximum weight, False otherwise.\"\"\"\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n    return is_balanced and total_weight <= w\n```"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr: list[int]) -> int:\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
