{"task_id": "HumanEval/86", "solution": "```python\nimport re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where characters within each word are sorted by ASCII value.\n    Word order and blank spaces are preserved in the output.\n    \"\"\"\n    # Split the input string by one or more spaces, capturing the spaces themselves.\n    # This allows preserving the exact whitespace structure between words.\n    segments = re.split(r'(\\s+)', s)\n\n    processed_segments = []\n    for segment in segments:\n        # If the segment contains non-whitespace characters, it's a word to be sorted.\n        if segment.strip():\n            # Convert the word to a list of characters, sort them by ASCII value, and rejoin.\n            sorted_chars = sorted(list(segment))\n            processed_segments.append(\"\".join(sorted_chars))\n        else:\n            # Otherwise, it's a space segment or an empty string, so preserve it as is.\n            processed_segments.append(segment)\n\n    # Join all processed segments back together to form the final string.\n    return \"\".join(processed_segments)\n```\n"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of an integer x in a nested list lst and returns their 0-indexed (row, column) coordinates.\n    Coordinates are sorted primarily by row ascending, and secondarily by column descending for the same row.\n    \"\"\"\n    found_coordinates = []\n\n    # Iterate through rows and columns to find target integer x.\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_index, col_index))\n\n    # Sort the collected coordinates primarily by row (ascending) and secondarily by column (descending).\n    if found_coordinates:\n        found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates\n```"}
{"task_id": "HumanEval/86", "solution": "```python\nclass Token:\n    \"\"\"Base class for tokens.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_word(self):\n        \"\"\"Checks if the token is a word.\"\"\"\n        return False\n\n    def is_space(self):\n        \"\"\"Checks if the token is a space.\"\"\"\n        return False\n\nclass Word(Token):\n    \"\"\"Represents a word token.\"\"\"\n    def is_word(self):\n        \"\"\"Checks if the token is a word.\"\"\"\n        return True\n\n    def sort_characters(self):\n        \"\"\"Sorts characters of the word in ascending ASCII order.\"\"\"\n        return \"\".join(sorted(self.value))\n\nclass Space(Token):\n    \"\"\"Represents a space token.\"\"\"\n    def is_space(self):\n        \"\"\"Checks if the token is a space.\"\"\"\n        return True\n\ndef _tokenize_string(s):\n    \"\"\"Parses the input string into a list of Word and Space tokens.\"\"\"\n    tokens = []\n    i = 0\n    n = len(s)\n    while i < n:\n        if s[i].isspace():\n            start = i\n            while i < n and s[i].isspace():\n                i += 1\n            tokens.append(Space(s[start:i]))\n        else:\n            start = i\n            while i < n and not s[i].isspace():\n                i += 1\n            tokens.append(Word(s[start:i]))\n    return tokens\n\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the input string where characters within words are sorted.\n    The original order of words and blank spaces is preserved.\n    \"\"\"\n    tokens = _tokenize_string(s)\n    result_parts = []\n    for token in tokens:\n        if token.is_word():\n            result_parts.append(token.sort_characters())\n        else:  # token.is_space()\n            result_parts.append(token.value)\n    return \"\".join(result_parts)\n```"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array based on the parity of the sum of its first and last elements.\n    Returns a sorted copy, not modifying the original array.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return array[:]\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_elements = first_element + last_element\n\n    if sum_elements % 2 == 1:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
