{"task_id": "HumanEval/27", "solution": "def is_lowercase(char: str) -> bool:\n    \"\"\"Checks if a character is a lowercase letter.\n    Returns True for 'a'-'z', False otherwise.\"\"\"\n    return 'a' <= char <= 'z'\n\ndef is_uppercase(char: str) -> bool:\n    \"\"\"Checks if a character is an uppercase letter.\n    Returns True for 'A'-'Z', False otherwise.\"\"\"\n    return 'A' <= char <= 'Z'\n\ndef to_uppercase(char: str) -> str:\n    \"\"\"Converts a lowercase character to its uppercase equivalent.\n    Returns the uppercase character or original if not lowercase.\"\"\"\n    if 'a' <= char <= 'z':\n        return chr(ord(char) - (ord('a') - ord('A')))\n    return char\n\ndef to_lowercase(char: str) -> str:\n    \"\"\"Converts an uppercase character to its lowercase equivalent.\n    Returns the lowercase character or original if not uppercase.\"\"\"\n    if 'A' <= char <= 'Z':\n        return chr(ord(char) + (ord('a') - ord('A')))\n    return char\n\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    Non-alphabetic characters are retained without modification.\n    \"\"\"\n    modified_chars = []\n    for char in string:\n        if is_lowercase(char):\n            modified_chars.append(to_uppercase(char))\n        elif is_uppercase(char):\n            modified_chars.append(to_lowercase(char))\n        else:\n            modified_chars.append(char)\n    return \"\".join(modified_chars)"}
