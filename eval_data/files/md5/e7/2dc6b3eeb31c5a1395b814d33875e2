{"task_id": "HumanEval/88", "solution": "import enum\n\nclass SortOrder(enum.Enum):\n    \"\"\"Enumeration to define the sorting direction.\"\"\"\n    ASCENDING = 1\n    DESCENDING = 2\n\ndef _is_empty(array: list[int]) -> bool:\n    \"\"\"Checks if the given array is empty.\"\"\"\n    return len(array) == 0\n\ndef _has_single_element(array: list[int]) -> bool:\n    \"\"\"Checks if the given array contains a single element.\"\"\"\n    return len(array) == 1\n\ndef _calculate_first_last_sum(array: list[int]) -> int:\n    \"\"\"Calculates the sum of the first and last elements of the array.\"\"\"\n    return array[0] + array[-1]\n\ndef _determine_sort_order(first_last_sum: int) -> SortOrder:\n    \"\"\"Determines the sort order based on the parity of the sum.\"\"\"\n    if first_last_sum % 2 != 0:\n        return SortOrder.ASCENDING\n    else:\n        return SortOrder.DESCENDING\n\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a new sorted array.\n    Sort order depends on the parity of the sum of the first and last elements.\n    \"\"\"\n    if _is_empty(array):\n        return []\n\n    if _has_single_element(array):\n        return array.copy()\n\n    copied_array = array.copy()\n    first_last_sum = _calculate_first_last_sum(copied_array)\n    sort_order = _determine_sort_order(first_last_sum)\n\n    if sort_order == SortOrder.ASCENDING:\n        copied_array.sort()\n    else: # SortOrder.DESCENDING\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase English letters down by four positions.\n    Non-lowercase letters remain unchanged.\"\"\"\n\n    def _shift_char(char, shift):\n        \"\"\"Shifts a single lowercase English character by the given amount, wrapping around 'z' to 'a'.\"\"\"\n        start_code = ord('a')\n        current_code = ord(char)\n        # Calculate new position relative to 'a', apply shift, then wrap around using modulo 26.\n        shifted_code = start_code + (current_code - start_code + shift) % 26\n        return chr(shifted_code)\n\n    encrypted_chars = []\n    shift_amount = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            encrypted_chars.append(_shift_char(char, shift_amount))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
