{"task_id": "HumanEval/39", "solution": "import math\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime.\n    Numbers less than 2 are not prime; it iterates up to sqrt(num) for divisors.\"\"\"\n    if num < 2:\n        return False\n    i = 2\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 1\n    return True\n\ndef is_fibonacci(num: int) -> bool:\n    \"\"\"Determines if a given number is a Fibonacci number.\n    It checks if 5*num^2 + 4 or 5*num^2 - 4 is a perfect square.\"\"\"\n    if num < 0:\n        return False\n\n    val1 = 5 * num * num + 4\n    val2 = 5 * num * num - 4\n\n    s1 = int(math.sqrt(val1))\n    s2 = int(math.sqrt(val2))\n\n    return (s1 * s1 == val1) or (s2 * s2 == val2)\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    current_num = 1\n\n    while True:\n        if is_fibonacci(current_num) and is_prime(current_num):\n            count += 1\n            if count == n:\n                return current_num\n        current_num += 1"}
