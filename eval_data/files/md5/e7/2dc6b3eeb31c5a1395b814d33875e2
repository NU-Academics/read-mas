{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value):\n    \"\"\"\n    Returns the integer closest to the numerical value of the input string.\n    Equidistant values are rounded away from zero.\n    \"\"\"\n    float_value = float(value)\n\n    floor_val = math.floor(float_value)\n    ceil_val = math.ceil(float_value)\n\n    # Check if the number is equidistant from two integers (e.g., X.5 or -X.5).\n    # The fractional part (abs(value - floor_val)) will be 0.5 in these cases.\n    if abs(float_value - floor_val) == 0.5:\n        # Apply \"round away from zero\" rule.\n        # For positive X.5, round up (e.g., 14.5 -> 15). For negative -X.5, round down (e.g., -14.5 -> -15).\n        if float_value >= 0:\n            return int(ceil_val)\n        else:\n            return int(floor_val)\n    else:\n        # For non-equidistant values, choose the integer that is numerically closest.\n        if abs(float_value - floor_val) < abs(float_value - ceil_val):\n            return int(floor_val)\n        else:\n            return int(ceil_val)\n```"}
{"task_id": "HumanEval/100", "solution": "```python\nfrom typing import List\n\ndef make_a_pile(n: int) -> List[int]:\n    \"\"\"\n    Generates a list of stone counts for n levels, starting with n stones.\n    Subsequent levels add 2 stones based on the initial parity of n.\n    \"\"\"\n    pile_list = []\n    pile_list.append(n)\n\n    current_stone_count = n\n    for _ in range(n - 1):\n        next_stone_count = current_stone_count + 2\n        pile_list.append(next_stone_count)\n        current_stone_count = next_stone_count\n\n    return pile_list\n```"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value: str) -> int:\n    \"\"\"\n    Converts a string to the closest integer, rounding away from zero for equidistant values.\n    E.g., \"14.5\" becomes 15, and \"-14.5\" becomes -15.\n    \"\"\"\n    num = float(value)\n\n    integer_part = int(num)\n    # Calculate the absolute fractional part to check for .5 cases.\n    fractional_part = abs(num - integer_part)\n\n    if fractional_part == 0.5:\n        # Round away from zero: positive numbers round up, negative numbers round down.\n        if num >= 0:\n            return integer_part + 1\n        else:\n            return integer_part - 1\n    else:\n        # For non-.5 cases, use standard rounding to the nearest integer.\n        # Python's round() handles this correctly for non-.5 values.\n        return int(round(num))"}
{"task_id": "HumanEval/98", "solution": "def is_uppercase_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an uppercase vowel (A, E, I, O, U).\"\"\"\n    return char in {'A', 'E', 'I', 'O', 'U'}\n\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0:  # Check for even index\n            if is_uppercase_vowel(char):\n                count += 1\n    return count"}
{"task_id": "HumanEval/91", "solution": "import re\n\nclass TextDocument:\n    def __init__(self, content: str):\n        self.content = content\n\nclass Sentence:\n    def __init__(self, text: str):\n        self.text = text\n\n    def starts_with_i(self) -> bool:\n        \"\"\"Checks if the sentence text (case-insensitive) starts with 'I'.\"\"\"\n        stripped_text = self.text.strip()\n        return stripped_text.lower().startswith('i')\n\nclass CountReport:\n    def __init__(self, i_sentence_count: int):\n        self.i_sentence_count = i_sentence_count\n\nclass SentenceParser:\n    def parse(self, text_content: str, delimiters: str) -> list:\n        \"\"\"Parses text content into a list of Sentence objects.\"\"\"\n        # Regex finds sequences of characters not including delimiters,\n        # followed by an optional delimiter or the end of the string.\n        pattern = r'[^' + re.escape(delimiters) + r']+(?:[' + re.escape(delimiters) + r']|$)'\n        raw_sentence_segments = re.findall(pattern, text_content)\n\n        sentences = []\n        for s_text in raw_sentence_segments:\n            if s_text.strip(): # Add only non-empty sentences after stripping whitespace.\n                sentences.append(Sentence(s_text))\n        return sentences\n\nclass SentenceCounterService:\n    def count_sentences_starting_with_i(self, doc: TextDocument, parser: SentenceParser) -> CountReport:\n        \"\"\"Orchestrates sentence parsing and counting sentences starting with 'I'.\"\"\"\n        delimiters = \".?!\" # Fixed delimiters as per problem statement.\n\n        sentences = parser.parse(doc.content, delimiters)\n        i_count = 0\n        for sentence in sentences:\n            if sentence.starts_with_i():\n                i_count += 1\n        return CountReport(i_count)\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with 'I' (case-insensitive) in the given string.\n    \"\"\"\n    input_text_document = TextDocument(S)\n    sentence_parser = SentenceParser()\n    sentence_counter_service = SentenceCounterService()\n\n    report = sentence_counter_service.count_sentences_starting_with_i(\n        input_text_document,\n        sentence_parser\n    )\n\n    return report.i_sentence_count"}
{"task_id": "HumanEval/100", "solution": "```python\ndef make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile\n```\n"}
