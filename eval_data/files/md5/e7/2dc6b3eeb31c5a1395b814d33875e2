{"task_id": "HumanEval/3", "solution": "```python\nfrom typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if at any point the balance of an account, starting with zero,\n    falls below zero after a series of deposit and withdrawal operations.\n    Returns True if the balance falls below zero at any point, False otherwise.\n    \"\"\"\n    balance = 0  # Initialize account balance to zero.\n    for operation in operations:  # Process each operation sequentially.\n        balance += operation  # Update the account balance.\n        if balance < 0:  # Detect if balance falls below zero.\n            return True  # Return True if below zero condition is met.\n    return False  # Return False if balance never falls below zero.\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Computes the arithmetic mean of a list of floating-point numbers.\"\"\"\n    return sum(numbers) / len(numbers)\n\n\ndef _calculate_absolute_differences(numbers: List[float], mean_value: float) -> List[float]:\n    \"\"\"Calculates the absolute differences between each number and the mean.\"\"\"\n    return [abs(x - mean_value) for x in numbers]\n\n\ndef _calculate_average(numbers: List[float]) -> float:\n    \"\"\"Computes the average of a list of floating-point numbers.\"\"\"\n    return sum(numbers) / len(numbers)\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    mean_value = _calculate_mean(numbers)\n    absolute_diffs = _calculate_absolute_differences(numbers, mean_value)\n    mad_value = _calculate_average(absolute_diffs)\n    return mad_value\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef _calculate_single_group_depth(group_string: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a given parentheses group string.\n    It tracks the current depth and updates the maximum depth encountered.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits the input string by spaces, filtering out empty strings.\n    This creates a list of individual parentheses group strings.\n    \"\"\"\n    return [group for group in input_string.split(' ') if group]\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    group_strings = _split_groups(paren_string)\n    depths = []\n    for group in group_strings:\n        depths.append(_calculate_single_group_depth(group))\n    return depths\n```\n"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of floating-point numbers.\n    It sums the numbers and divides by their count.\n    \"\"\"\n    return sum(numbers) / len(numbers)\n\ndef _calculate_absolute_differences_from_mean(numbers: List[float], mean_value: float) -> List[float]:\n    \"\"\"Computes the absolute difference between each number in a list and a given mean value.\n    Returns a new list containing these absolute differences.\n    \"\"\"\n    return [abs(number - mean_value) for number in numbers]\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    mean_value = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences_from_mean(numbers, mean_value)\n\n    return sum(absolute_differences) / len(absolute_differences)\n```\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns an empty list if the input `numbers` list is empty.\"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    for i, num in enumerate(numbers):\n        result_list.append(num)\n        if i < len(numbers) - 1:\n            result_list.append(delimeter)\n    return result_list"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result = []\n    if not numbers:\n        return result\n\n    result.append(numbers[0])\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef _calculate_single_group_depth(group_string: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single group of parentheses.\n    E.g. '(()())' -> 2, '((()))' -> 3, '()' -> 1.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string with multiple groups of parentheses separated by spaces.\n    Outputs the deepest level of nesting for each group.\n    \"\"\"\n    groups = paren_string.split(' ')\n    results = []\n    for group_string in groups:\n        if group_string:  # Ensure not to process empty strings from multiple spaces\n            depth = _calculate_single_group_depth(group_string)\n            results.append(depth)\n    return results\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The relative order of matching strings is preserved.\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings\n```"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product.\n    Handles empty lists by returning a sum of 0 and a product of 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    The algorithm finds the longest palindromic postfix and appends the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    prefix_to_reverse = \"\"\n\n    for i in range(n):\n        # Iterate through postfixes from longest to shortest (string[0:] to string[n-1:])\n        # If string[i:] is a palindrome, then string[:i] is the prefix before it.\n        if is_palindrome(string[i:]):\n            prefix_to_reverse = string[:i]\n            break # Found the longest palindromic postfix\n\n    return string + prefix_to_reverse[::-1]\n```"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result = []\n    current_max = None\n\n    for num in numbers:\n        if current_max is None or num > current_max:\n            current_max = num\n        result.append(current_max)\n\n    return result```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of rolling maximum elements.\n    Each element in the output is the maximum value encountered up to that point in the input sequence.\"\"\"\n    result_list = []\n\n    if not numbers:\n        return result_list\n\n    current_max = numbers[0]\n    result_list.append(current_max)\n\n    for i in range(1, len(numbers)):\n        next_number = numbers[i]\n        if next_number > current_max:\n            current_max = next_number\n        result_list.append(current_max)\n\n    return result_list\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    It does this by finding the longest palindromic postfix of the string and appending the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    if is_palindrome(string):\n        return string\n\n    longest_palindromic_postfix = \"\"\n    for i in range(len(string)):\n        current_postfix = string[i:]\n        if is_palindrome(current_postfix):\n            longest_palindromic_postfix = current_postfix\n            break # The first one found is the longest due to iteration order\n\n    prefix_before_postfix = string[:len(string) - len(longest_palindromic_postfix)]\n    reversed_prefix = prefix_before_postfix[::-1]\n\n    return string + reversed_prefix\n```"}
