xample:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    # Instantiate InputValidator and perform validation.\n    # Note: Validation logic (raising ValueError) is skipped due to critical constraints.\n    InputValidator().validate_inputs(operator, operand)\n\n    # Construct the algebraic expression string.\n    expression_string = _construct_expression_string(operator, operand)\n\n    # Create and evaluate the AlgebraicExpression.\n    algebraic_expression = AlgebraicExpression(expression_string)\n    numerical_result = algebraic_expression.evaluate()\n\n    return numerical_result\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Transforms a string: reverses letter case if letters are present, otherwise reverses the entire string.\"\"\"\n\n    def _is_letter(char: str) -> bool:\n        \"\"\"Checks if a given character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _reverse_case(char: str) -> str:\n        \"\"\"Reverses the case of a single letter character.\"\"\"\n        if char.isupper():\n            return char.lower()\n        else:\n            return char.upper()\n\n    def _has_letters(s: str) -> bool:\n        \"\"\"Checks if the input string contains any alphabetic letters.\"\"\"\n        for char in s:\n            if _is_letter(char):\n                return True\n        return False\n\n    def _transform_character_case(s: str) -> str:\n        \"\"\"Builds a new string by reversing case of letters and keeping others as is.\"\"\"\n        result_chars = []\n        for char in s:\n            if _is_letter(char):\n                result_chars.append(_reverse_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses the entire input string.\"\"\"\n        return s[::-1]\n\n    if _has_letters(s):\n        return _transform_character_case(s)\n    else:\n        return _reverse_string(s)\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef _has_letters(s: str) -> bool:\n    \"\"\"Checks if the input string contains any alphabetic letters.\"\"\"\n    for char_val in s:\n        if char_val.isalpha():\n            return True\n    return False\n\ndef _reverse_case_char(char_val: str) -> str:\n    \"\"\"Reverses the case of an alphabetic character, or returns it unchanged.\"\"\"\n    if char_val.isalpha():\n        if char_val.islower():\n            return char_val.upper()\n        else:\n            return char_val.lower()\n    return char_val\n\ndef _process_string_with_letters(s: str) -> str:\n    \"\"\"Applies case reversal to letters in a string, keeping non-letters as is.\"\"\"\n    transformed_chars = []\n    for char_val in s:\n        transformed_chars.append(_reverse_case_char(char_val))\n    return \"\".join(transformed_chars)\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the entire input string.\"\"\"\n    return s[::-1]\n\ndef solve(s: str) -> str:\n    \"\"\"Transforms a string: reverses case of letters if present, otherwise reverses the whole string.\"\"\"\n    if _has_letters(s):\n        return _process_string_with_letters(s)\n    else:\n        return _reverse_string(s)\n```"}
