{"task_id": "HumanEval/93", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Determines if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef _get_shifted_vowel(char: str) -> str:\n    \"\"\"Replaces a vowel with the letter two places ahead, maintaining case. Assumes input is an alphabetic vowel.\"\"\"\n    base = ord('a') if char.islower() else ord('A')\n    shifted_char_code = (ord(char) - base + 2) % 26 + base\n    return chr(shifted_char_code)\n\ndef _swap_case_consonant(char: str) -> str:\n    \"\"\"Swaps the case of an alphabetic character. Assumes input is an alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef _is_alphabetic(char: str) -> bool:\n    \"\"\"Determines if a character is an English letter.\"\"\"\n    return char.isalpha()\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if _is_alphabetic(char):\n            if _is_vowel(char):\n                encoded_chars.append(_get_shifted_vowel(char))\n            else:  # It's a consonant\n                encoded_chars.append(_swap_case_consonant(char))\n        else:  # Non-alphabetic (e.g., space)\n            encoded_chars.append(char)\n    return ''.join(encoded_chars)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"Encodes a message by swapping letter cases and shifting post-swap vowels.\"\"\"\n\n    def _swap_case(char):\n        return char.swapcase()\n\n    def _is_vowel(char):\n        return char.upper() in ('A', 'E', 'I', 'O', 'U')\n\n    def _shift_vowel(vowel_char):\n        if 'A' <= vowel_char <= 'Z':\n            base = ord('A')\n            return chr((ord(vowel_char) - base + 2) % 26 + base)\n        # Else, it must be lowercase as per the logic flow and problem assumptions.\n        base = ord('a')\n        return chr((ord(vowel_char) - base + 2) % 26 + base)\n\n    encoded_chars = []\n    for char in message:\n        if 'A' <= char <= 'Z' or 'a' <= char <= 'z':\n            swapped_char = _swap_case(char)\n            if _is_vowel(swapped_char):\n                shifted_char = _shift_vowel(swapped_char)\n                encoded_chars.append(shifted_char)\n            else:\n                encoded_chars.append(swapped_char)\n        else:\n            encoded_chars.append(char)\n    return ''.join(encoded_chars)\n```"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n):\n    \"\"\"Checks if an integer is a prime number.\n    Returns False if n is less than or equal to 1, or divisible by any number up to its square root.\n    \"\"\"\n    if n <= 1:\n        return False\n    # Iterate from 2 up to the integer part of n's square root.\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef sum_digits(n):\n    \"\"\"Calculates the sum of the digits of an integer.\n    It converts the number to a string and sums its absolute digits.\n    \"\"\"\n    digit_sum = 0\n    # Convert n to its absolute string representation to sum digits.\n    for digit_char in str(abs(n)):\n        digit_sum += int(digit_char)\n    return digit_sum\n\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    If no prime numbers are found, it returns 0.\n    \"\"\"\n    primes = []\n    for number in lst:\n        if is_prime(number):\n            primes.append(number)\n\n    if not primes:\n        return 0 # Returns 0 if no prime numbers are found in the input list.\n    else:\n        largest_prime = max(primes)\n        return sum_digits(largest_prime)```"}
{"task_id": "HumanEval/94", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"Helper function to check if a number is prime.\n    It handles numbers less than 2 and even numbers efficiently.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef find_largest_prime(numbers: list[int]) -> int:\n    \"\"\"Helper function to find the largest prime in a list.\n    Returns 0 if no prime is found as per the design specification.\n    \"\"\"\n    largest_prime = 0\n    for num in numbers:\n        if is_prime(num) and num > largest_prime:\n            largest_prime = num\n    return largest_prime\n\ndef calculate_digit_sum(n: int) -> int:\n    \"\"\"Helper function to compute the sum of the digits of a given integer.\n    It works by converting the number to a string and summing its digits.\n    \"\"\"\n    sum_digits = 0\n    str_n = str(n)\n    for digit_char in str_n:\n        sum_digits += int(digit_char)\n    return sum_digits\n\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime_val = find_largest_prime(lst)\n    return calculate_digit_sum(largest_prime_val)\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict: dict) -> bool:\n    \"\"\"Checks if all string keys in a dictionary are consistently lowercase or consistently uppercase.\n    Returns False if the dictionary is empty or contains string keys with mixed casing.\"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n        # Optimization: if both flags are false, we can stop early\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in the dictionary are uniformly lowercase or uniformly uppercase.\n    Returns False if the dictionary is empty or contains non-string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            is_all_lower = False\n        if not key.isupper():\n            is_all_upper = False\n\n        # If keys are neither all lowercase nor all uppercase, we can return early.\n        if not is_all_lower and not is_all_upper:\n            return False\n\n    return is_all_lower or is_all_upper\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef _is_prime(num):\n    \"\"\"Checks if a number is prime.\n    Returns True if prime, False otherwise.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_up_to(n):\n    \"\"\"Identifies and returns an array of prime numbers strictly less than n.\n    Handles edge cases for n=0 or n=1 by returning an empty list.\"\"\"\n    if n < 2:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n    return primes\n```"}
