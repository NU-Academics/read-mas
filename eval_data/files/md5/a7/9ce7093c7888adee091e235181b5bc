{"task_id": "HumanEval/112", "solution": "```python\ndef _remove_chars(s: str, chars_to_remove: str) -> str:\n    \"\"\"Removes characters from s that are present in chars_to_remove.\n    Uses a set for efficient character lookup.\"\"\"\n    chars_set = set(chars_to_remove)\n    result = []\n    for char_s in s:\n        if char_s not in chars_set:\n            result.append(char_s)\n    return \"\".join(result)\n\ndef _is_palindrome(text: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\n    Compares the string with its reverse.\"\"\"\n    return text == text[::-1]\n\ndef reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    processed_s = _remove_chars(s, c)\n    is_pal = _is_palindrome(processed_s)\n    return (processed_s, is_pal)\n```"}
{"task_id": "HumanEval/111", "solution": "```python\nclass LetterFrequencyMap:\n    \"\"\"Manages letter frequencies, providing methods to add letters, get counts, and find the maximum frequency.\"\"\"\n    def __init__(self):\n        self._frequencies: dict[str, int] = {}\n\n    def add_letter(self, letter: str):\n        \"\"\"Increments the frequency count for a given letter.\"\"\"\n        self._frequencies[letter] = self._frequencies.get(letter, 0) + 1\n\n    def get_frequency(self, letter: str) -> int:\n        \"\"\"Retrieves the frequency count for a specific letter.\"\"\"\n        return self._frequencies.get(letter, 0)\n\n    def get_all_frequencies(self) -> dict[str, int]:\n        \"\"\"Returns a copy of all stored letter frequencies.\"\"\"\n        return self._frequencies.copy()\n\n    def get_max_frequency(self) -> int:\n        \"\"\"Determines the highest frequency count among all letters.\"\"\"\n        return max(self._frequencies.values()) if self._frequencies else 0\n\n\nclass OutputHistogram:\n    \"\"\"Encapsulates the final dictionary of letters with highest frequencies.\"\"\"\n    def __init__(self, initial_map: dict[str, int]):\n        self._result: dict[str, int] = initial_map\n\n    def get_result(self) -> dict[str, int]:\n        \"\"\"Returns the stored result dictionary.\"\"\"\n        return self._result\n\n\ndef _count_frequencies(input_string: str) -> LetterFrequencyMap:\n    \"\"\"Parses the input string and counts frequencies of lowercase letters.\"\"\"\n    frequency_map = LetterFrequencyMap()\n\n    letters = input_string.split(' ')\n    for letter in letters:\n        # Assuming space-separated single lowercase letters based on examples\n        if letter.isalpha() and len(letter) == 1 and letter.islower():\n            frequency_map.add_letter(letter)\n    return frequency_map\n\n\ndef _find_highest_frequency(frequency_map: LetterFrequencyMap) -> int:\n    \"\"\"Identifies the maximum frequency count from the given frequency map.\"\"\"\n    return frequency_map.get_max_frequency()\n\n\ndef _filter_by_frequency(frequency_map: LetterFrequencyMap, max_frequency: int) -> OutputHistogram:\n    \"\"\"Constructs an OutputHistogram with letters matching the highest frequency.\"\"\"\n    filtered_result_map: dict[str, int] = {}\n    if max_frequency == 0:\n        return OutputHistogram(filtered_result_map)\n\n    all_frequencies = frequency_map.get_all_frequencies()\n    for letter, count in all_frequencies.items():\n        if count == max_frequency:\n            filtered_result_map[letter] = count\n    return OutputHistogram(filtered_result_map)\n\n\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string representing space-separated lowercase letters,\n    returns a dictionary of the letter(s) with the most repetition\n    and their corresponding count.\n    \"\"\"\n    if not test:\n        return {}\n\n    frequency_map = _count_frequencies(test)\n\n    if not frequency_map.get_all_frequencies():\n        return {}\n\n    max_frequency = _find_highest_frequency(frequency_map)\n    output_histogram = _filter_by_frequency(frequency_map, max_frequency)\n    return output_histogram.get_result()\n```"}
{"task_id": "HumanEval/112", "solution": "```python\ndef _remove_characters(s: str, chars_to_remove: str) -> str:\n    \"\"\"\n    Removes all characters from string s that are present in chars_to_remove.\n    The order of remaining characters is preserved.\n    \"\"\"\n    chars_to_remove_set = set(chars_to_remove)\n    modified_s_chars = [char for char in s if char not in chars_to_remove_set]\n    return \"\".join(modified_s_chars)\n\ndef _is_palindrome(s: str) -> bool:\n    \"\"\"\n    Checks if a string is a palindrome.\n    Empty strings are considered palindromes.\n    \"\"\"\n    return s == s[::-1]\n\ndef reverse_delete(s,c):\n    \"\"\"\n    Deletes all characters in s that are equal to any character in c,\n    then checks if the result string is a palindrome.\n    Returns a tuple containing the result string and True/False for the check.\n    \"\"\"\n    modified_s = _remove_characters(s, c)\n    is_palindrome = _is_palindrome(modified_s)\n    return (modified_s, is_palindrome)\n```"}
{"task_id": "HumanEval/111", "solution": "```python\ndef _parse_letters(input_string: str) -> list[str]:\n    \"\"\"Parses a space-separated string into a list of letters.\n    It uses split() to handle multiple spaces and discard empty strings.\n    \"\"\"\n    return input_string.split()\n\ndef _count_frequencies(letters: list[str]) -> dict[str, int]:\n    \"\"\"Counts the occurrences of each unique letter in a list.\n    It iterates through the list and stores counts in a dictionary.\n    \"\"\"\n    frequencies = {}\n    for letter in letters:\n        frequencies[letter] = frequencies.get(letter, 0) + 1\n    return frequencies\n\ndef _find_highest_frequency(frequencies: dict[str, int]) -> int:\n    \"\"\"Determines the maximum frequency count from a dictionary of letter frequencies.\n    It returns 0 if the input frequencies dictionary is empty.\n    \"\"\"\n    if not frequencies:\n        return 0\n    return max(frequencies.values())\n\ndef _filter_highest_frequency_letters(frequencies: dict[str, int], highest_freq: int) -> dict[str, int]:\n    \"\"\"Filters a frequency dictionary to include only letters with the specified highest frequency.\n    It creates a new dictionary containing only the highest frequency letters and their counts.\n    \"\"\"\n    highest_freq_letters = {}\n    for letter, count in frequencies.items():\n        if count == highest_freq:\n            highest_freq_letters[letter] = count\n    return highest_freq_letters\n\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string representing space separated lowercase letters, return a dictionary\n    of the letters with the most repetition and their corresponding count.\n    If several letters have the same highest occurrence, all are returned.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = _parse_letters(test)\n    if not letters:\n        return {}\n\n    frequencies = _count_frequencies(letters)\n    # If frequencies is empty, it implies no valid letters were found (e.g., input was \"   \").\n    # In this specific case, returning {} is consistent with histogram('') == {}.\n    if not frequencies:\n        return {}\n\n    highest_freq = _find_highest_frequency(frequencies)\n    return _filter_highest_frequency_letters(frequencies, highest_freq)\n```"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in each string and formats the output.\n    This function processes a list of digit-only strings.\"\"\"\n\n    def _count_odd_digits_in_string(s: str) -> int:\n        \"\"\"Counts the number of odd digits in a given string.\"\"\"\n        odd_digits = {'1', '3', '5', '7', '9'}\n        count = 0\n        for char in s:\n            if char in odd_digits:\n                count += 1\n        return count\n\n    def _format_output_string(count: int) -> str:\n        \"\"\"Generates the specific formatted output string.\"\"\"\n        return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    results_list = []\n    for input_string in lst:\n        odd_digit_count = _count_odd_digits_in_string(input_string)\n        formatted_string = _format_output_string(odd_digit_count)\n        results_list.append(formatted_string)\n    return results_list"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array of nums.\n    \"\"\"\n    min_so_far = float('inf')\n    min_ending_here = float('inf')\n\n    for num in nums:\n        # Update min_ending_here to be the minimum of the current number or extending the previous minimum sub-array\n        min_ending_here = min(num, min_ending_here + num)\n        # Update min_so_far with the overall minimum sum found\n        min_so_far = min(min_so_far, min_ending_here)\n\n    return min_so_far\n```"}
{"task_id": "HumanEval/113", "solution": "```python\nfrom typing import List\n\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results_list = []\n    for input_string in lst:\n        odd_digit_count = 0\n        for char in input_string:\n            if char in {'1', '3', '5', '7', '9'}:\n                odd_digit_count += 1\n\n        phrase = \"the number of odd elements in the string i of the input.\"\n        formatted_string = phrase.replace('i', str(odd_digit_count))\n        results_list.append(formatted_string)\n    return results_list\n```"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array within the given list of integers.\n    This implementation uses a variation of Kadane's algorithm to efficiently determine this minimum sum.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far\n```"}
