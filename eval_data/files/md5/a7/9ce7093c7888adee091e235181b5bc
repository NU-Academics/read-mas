{"task_id": "HumanEval/139", "solution": "```python\ndef _factorial(x):\n    \"\"\"Calculates the factorial of a non-negative integer x.\n    It computes the product of all positive integers up to x.\n    \"\"\"\n    if x == 0:\n        return 1\n    res = 1\n    for i in range(1, x + 1):\n        res *= i\n    return res\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as n! * (n-1)! * (n-2)! * ... * 1!\n    It computes the product of factorials from n down to 1.\n    \"\"\"\n    brazilian_fact_result = 1\n    for i in range(1, n + 1):\n        current_factorial = _factorial(i)\n        brazilian_fact_result *= current_factorial\n    return brazilian_fact_result\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces spaces with underscores, then replaces sequences of 3+ underscores with a hyphen.\n    This function processes an input string to modify its space characters as per design.\n    \"\"\"\n    # FR1: Replace every space character in the input string with an underscore.\n    underscored_text = text.replace(' ', '_')\n\n    # FR2 & FR3: Identify sequences of three or more consecutive underscore characters\n    # and replace each identified sequence with a single hyphen.\n    final_text = re.sub(r'_{3,}', '-', underscored_text)\n\n    # FR4: Return the final modified string after all transformations.\n    return final_text\n```"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the special factorial defined as n! * (n-1)! * ... * 1!.\n    It takes a positive integer n and returns the computed value.\n    \"\"\"\n    def _factorial(k):\n        # Helper to compute k! for a given positive integer k.\n        # It multiplies all integers from 1 up to k.\n        f = 1\n        for x in range(1, k + 1):\n            f *= x\n        return f\n\n    special_prod = 1\n    for i in range(n, 0, -1):\n        special_prod *= _factorial(i)\n    return special_prod"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules, returning 'Yes' or 'No'.\n    Rules include digit count, dot count, prefix content, and allowed extensions.\n    \"\"\"\n\n    # 1. Validate Digit Count\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    digit_count_valid = digit_count <= 3\n\n    # 2. Validate Dot Count and Position, and extract prefix/extension\n    parts = file_name.split('.')\n    dot_count_valid = len(parts) == 2\n\n    prefix = \"\"\n    extension = \"\"\n    if dot_count_valid:\n        prefix = parts[0]\n        extension = parts[1]\n\n    # 3. Validate Prefix Not Empty (only if dot count was valid)\n    prefix_not_empty_valid = bool(prefix) if dot_count_valid else False\n\n    # 4. Validate Prefix Start Character (only if dot count and prefix not empty were valid)\n    prefix_start_char_valid = False\n    if dot_count_valid and prefix_not_empty_valid:\n        first_char = prefix[0]\n        prefix_start_char_valid = ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n    # 5. Validate Extension Type (only if dot count was valid)\n    allowed_extensions = ['txt', 'exe', 'dll']\n    extension_type_valid = extension in allowed_extensions if dot_count_valid else False\n\n    # Aggregate all validation results\n    overall_valid = (\n        digit_count_valid and\n        dot_count_valid and\n        prefix_not_empty_valid and\n        prefix_start_char_valid and\n        extension_type_valid\n    )\n\n    return 'Yes' if overall_valid else 'No'\n\n```"}
{"task_id": "HumanEval/141", "solution": "```python\nimport re\nfrom dataclasses import dataclass\n\n# Define allowed extensions as per FR8/BR6\n_ALLOWED_EXTENSIONS = {'txt', 'exe', 'dll'}\n\n@dataclass\nclass FileNameDetails:\n    \"\"\"A data class to hold parsed components of a file name.\"\"\"\n    full_name: str\n    name_part: str\n    extension_part: str\n\ndef _is_digit_count_valid(full_name: str) -> bool:\n    \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n    digit_count = sum(1 for char in full_name if char.isdigit())\n    return digit_count <= 3\n\ndef _is_dot_count_valid(full_name: str) -> bool:\n    \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n    return full_name.count('.') == 1\n\ndef _is_name_part_not_empty(name_part: str) -> bool:\n    \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n    return bool(name_part)\n\ndef _starts_with_latin_letter(name_part: str) -> bool:\n    \"\"\"Checks if the substring before the dot starts with a Latin alphabet letter.\"\"\"\n    if not name_part:\n        return False\n    return name_part[0].isalpha()\n\ndef _is_extension_valid(extension_part: str) -> bool:\n    \"\"\"Checks if the substring after the dot is one of the allowed extensions.\"\"\"\n    return extension_part in _ALLOWED_EXTENSIONS\n\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Checks if a given file name string is valid based on a set of predefined rules.\n    Returns 'Yes' if the file name is valid, 'No' otherwise.\n    \"\"\"\n    # Check for exactly one dot first, crucial for parsing.\n    if not _is_dot_count_valid(file_name):\n        return 'No'\n\n    # Split the file name into name and extension parts.\n    parts = file_name.rsplit('.', 1)\n    name_part = parts[0]\n    extension_part = parts[1]\n\n    # Instantiate FileNameDetails as per design, even if not strictly needed for argument passing.\n    file_details = FileNameDetails(full_name=file_name, name_part=name_part, extension_part=extension_part)\n\n    # Apply all other validation rules in sequence.\n    if not _is_digit_count_valid(file_details.full_name):\n        return 'No'\n    if not _is_name_part_not_empty(file_details.name_part):\n        return 'No'\n    if not _starts_with_latin_letter(file_details.name_part):\n        return 'No'\n    if not _is_extension_valid(file_details.extension_part):\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, squaring elements at indices\n    multiples of 3, cubing at indices multiples of 4 (but not 3), and summing them up.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value * value\n        elif index % 4 == 0:\n            total_sum += value * value * value\n        else:\n            total_sum += value\n\n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef is_prime(n):\n    \"\"\"\n    Checks if a given integer n is a prime number.\n    Optimized to check divisors up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors starting from 3\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n    prime_length_words = []\n    words = sentence.split()\n\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a number is prime.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Preserves the original order of words in the output string.\n    \"\"\"\n    filtered_words = []\n    words = sentence.split(' ')\n\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)\n```"}
