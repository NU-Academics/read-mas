{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n\n    def _get_num_digits(n: int) -> int:\n        \"\"\"Helper to calculate the number of digits in an integer.\"\"\"\n        if n == 0:\n            return 1\n        return len(str(abs(n)))\n\n    def _perform_circular_shift(s: str, shift_amount: int) -> str:\n        \"\"\"Helper to perform a circular right shift on a digit string.\"\"\"\n        num_digits = len(s)\n        if num_digits == 0:\n            return \"\"\n        effective_shift = shift_amount % num_digits\n        return s[-effective_shift:] + s[:-effective_shift]\n\n    def _reverse_digits(s: str) -> str:\n        \"\"\"Helper to reverse the digits of a string.\"\"\"\n        return s[::-1]\n\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise ValueError(\"Inputs 'x' and 'shift' must be integers.\")\n\n    x_str = str(x)\n    num_digits = _get_num_digits(x)\n\n    if shift > num_digits:\n        return _reverse_digits(x_str)\n    else:\n        return _perform_circular_shift(x_str, shift)"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    is_negative = x < 0\n    abs_x_str = str(abs(x))\n\n    num_digits = len(abs_x_str)\n\n    result_digits_str = \"\"\n    if shift > num_digits:\n        result_digits_str = abs_x_str[::-1]\n    else:\n        effective_shift = shift % num_digits\n        result_digits_str = abs_x_str[-effective_shift:] + abs_x_str[:-effective_shift]\n\n    return \"-\" + result_digits_str if is_negative and result_digits_str != \"0\" else result_digits_str\n\n```"}
{"task_id": "HumanEval/67", "solution": "```python\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    This function extracts apple and orange counts from 's' and subtracts their sum from 'n'.\n    \"\"\"\n    # Parse apple count from the string 's'.\n    # For \"X apples and Y oranges\", this gets \"X\".\n    parts_apple_and_orange = s.split(\" apples and \")\n    apple_count = int(parts_apple_and_orange[0])\n\n    # Parse orange count from the remaining part of the string.\n    # From \"Y oranges\", this gets \"Y\".\n    orange_part = parts_apple_and_orange[1]\n    orange_count = int(orange_part.split(\" oranges\")[0])\n\n    # Calculate the total count of apples and oranges.\n    total_apples_oranges = apple_count + orange_count\n\n    # Subtract this sum from the total number of fruits 'n' to find mango count.\n    mango_count = n - total_apples_oranges\n    return mango_count\n```"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies the smallest even-valued node and its index from an array.\n    Returns an empty list if no even numbers are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even = None\n    smallest_index = -1\n\n    for index, element in enumerate(arr):\n        if element % 2 == 0:  # Check if the number is even\n            if smallest_even is None or element < smallest_even:\n                smallest_even = element\n                smallest_index = index\n            elif element == smallest_even and index < smallest_index:\n                # If values are equal, prioritize the one with the smaller index\n                smallest_index = index\n\n    if smallest_even is None:\n        return []\n    else:\n        return [smallest_even, smallest_index]"}
{"task_id": "HumanEval/59", "solution": "```python\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    This implementation efficiently finds the largest prime factor by iteratively dividing n.\"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd factors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2  # Move to the next odd number\n\n    # If n is still greater than 2, it means the remaining n is prime and the largest factor\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor\n```"}
{"task_id": "HumanEval/68", "solution": "```python\ndef pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its first occurrence index in a list.\n    Returns `[value, index]` or `[]` if no even number is found or the list is empty.\n    \"\"\"\n    if not arr:  # Handle empty array case.\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the number is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # If value == smallest_even_value, we do not update,\n            # preserving the index of the first occurrence.\n\n    if smallest_even_value == float('inf'):  # No even numbers found.\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]\n```"}
{"task_id": "HumanEval/69", "solution": "```python\ndef _calculate_frequencies(lst: list[int]) -> dict[int, int]:\n    \"\"\"Calculates the frequency of each integer in the input list.\n    Returns a dictionary mapping each integer to its frequency.\"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\n\ndef _find_candidates(frequencies: dict[int, int]) -> list[int]:\n    \"\"\"Identifies integers x such that its frequency is greater than or equal to x.\n    Returns a list of candidate integers that satisfy this condition.\"\"\"\n    candidates = []\n    for x, freq in frequencies.items():\n        if freq >= x:\n            candidates.append(x)\n    return candidates\n\ndef _determine_result(candidates: list[int]) -> int:\n    \"\"\"Selects the greatest candidate or returns -1 if no candidates exist.\n    Returns the maximum value from the candidates list, or -1 if the list is empty.\"\"\"\n    if not candidates:\n        return -1\n    return max(candidates)\n\ndef search(lst: list[int]) -> int:\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = _calculate_frequencies(lst)\n    candidates = _find_candidates(frequencies)\n    result = _determine_result(candidates)\n    return result\n```"}
{"task_id": "HumanEval/69", "solution": "```python\ndef _calculate_frequencies(lst):\n    \"\"\"Calculates the frequency of each unique integer in the list. Returns a dictionary mapping integers to their counts.\"\"\"\n    frequencies = {}\n    for x in lst:\n        frequencies[x] = frequencies.get(x, 0) + 1\n    return frequencies\n\ndef _identify_valid_integers(frequencies):\n    \"\"\"Identifies integers where the value is positive and its frequency is greater than or equal to its value. Returns a list of such valid integers.\"\"\"\n    valid_integers = []\n    for x, freq in frequencies.items():\n        if x > 0 and freq >= x:\n            valid_integers.append(x)\n    return valid_integers\n\ndef _get_greatest_integer(valid_integers):\n    \"\"\"Finds the greatest integer from a list of valid integers. If the list is empty, returns -1.\"\"\"\n    if not valid_integers:\n        return -1\n    return max(valid_integers)\n\ndef search(lst):\n    \"\"\"Given a non-empty list of positive integers, returns the greatest integer that is greater than zero, and has a frequency greater than or equal to the value of the integer itself. If no such a value exists, returns -1.\"\"\"\n    frequencies = _calculate_frequencies(lst)\n    valid_integers = _identify_valid_integers(frequencies)\n    result = _get_greatest_integer(valid_integers)\n    return result\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    This involves alternately picking the minimum and maximum from remaining elements.\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list.\n    internal_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    # Continue processing until all elements are moved to the result list.\n    while internal_list:\n        if is_min_turn:\n            # Append the minimum value from the remaining elements.\n            result_list.append(internal_list.pop(0))\n        else:\n            # Append the maximum value from the remaining elements.\n            result_list.append(internal_list.pop(-1))\n\n        # Alternate between selecting minimum and maximum.\n        is_min_turn = not is_min_turn\n\n    return result_list\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result_list = []\n    left_ptr = 0\n    right_ptr = len(sorted_list) - 1\n\n    while left_ptr <= right_ptr:\n        # Select minimum\n        result_list.append(sorted_list[left_ptr])\n        left_ptr += 1\n\n        # Select maximum, if elements remain\n        if left_ptr <= right_ptr:\n            result_list.append(sorted_list[right_ptr])\n            right_ptr -= 1\n\n    return result_list\n```"}
{"task_id": "HumanEval/71", "solution": "import math\n\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three sides, handling its validity and area calculation.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes a Triangle object and performs validation and area calculation.\"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n        self._is_valid = False\n        self._area = -1.0\n\n        if self._validate_sides():\n            self._is_valid = True\n            self._area = self._calculate_area()\n\n    def _validate_sides(self) -> bool:\n        \"\"\"Checks if the given side lengths form a valid triangle.\"\"\"\n        return (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a)\n\n    def _calculate_area(self) -> float:\n        \"\"\"Calculates the triangle's area using Heron's formula and rounds it.\"\"\"\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        area_squared = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        area = math.sqrt(area_squared)\n        return round(area, 2)\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the triangle is valid, False otherwise.\"\"\"\n        return self._is_valid\n\n    def get_area(self) -> float:\n        \"\"\"Returns the calculated area of the triangle.\"\"\"\n        return self._area\n\nclass TriangleCalculatorFacade:\n    \"\"\"\n    Provides a simplified interface for calculating triangle area.\n    It orchestrates the validation and calculation using the Triangle class.\n    \"\"\"\n    @staticmethod\n    def triangle_area(a: float, b: float, c: float) -> float:\n        \"\"\"\n        Calculates the area of a triangle given its three side lengths.\n        Returns the area rounded to 2 decimal places, or -1.0 if invalid.\n        \"\"\"\n        triangle = Triangle(a, b, c)\n        if triangle.is_valid():\n            return triangle.get_area()\n        else:\n            return -1.0\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    \"\"\"\n    return TriangleCalculatorFacade.triangle_area(a, b, c)"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a, b, c):\n    '''\n    Calculates the area of a triangle given its side lengths, rounded to 2 decimal places.\n    Returns -1 if the sides do not form a valid triangle.\n    '''\n    # Sides must be positive\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Check triangle inequality: sum of any two sides must be greater than the third\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate area using Heron's formula.\n    # Ensure the term under the square root is non-negative due to floating point precision.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    if area_squared < 0: # Handle potential tiny negative values for degenerate triangles\n        area_squared = 0\n\n    area = math.sqrt(area_squared)\n\n    # Round the calculated area to two decimal places\n    return round(area, 2)\n```\n"}
{"task_id": "HumanEval/72", "solution": "```python\ndef _is_palindromic(q: list) -> bool:\n    \"\"\"\n    Checks if a list is palindromic.\n    Returns True if the list reads the same forwards and backwards, False otherwise.\n    \"\"\"\n    return q == q[::-1]\n\ndef _calculate_sum(q: list) -> int:\n    \"\"\"\n    Calculates the sum of elements in a list.\n    Returns the total sum of all numbers in the list.\n    \"\"\"\n    return sum(q)\n\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q can fly based on balance (palindromic) and weight.\n    Returns True if q is palindromic AND its sum is less than or equal to w, False otherwise.\n    \"\"\"\n    if not _is_palindromic(q):\n        return False\n\n    total_weight = _calculate_sum(q)\n    return total_weight <= w\n```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes = 0\n    left_ptr = 0\n    right_ptr = len(arr) - 1\n\n    while left_ptr < right_ptr:\n        if arr[left_ptr] != arr[right_ptr]:\n            changes += 1\n        left_ptr += 1\n        right_ptr -= 1\n    return changes\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef _calculate_total_characters(lst: list[str]) -> int:\n    \"\"\"\n    Calculates the total number of characters across all strings in a list.\n    It sums the lengths of all strings in the provided list.\n    \"\"\"\n    total_count = 0\n    for s in lst:\n        total_count += len(s)\n    return total_count\n\ndef total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"\n    Compares two lists of strings by their total character count.\n    Returns the list with fewer total characters, or the first list in case of a tie.\n    \"\"\"\n    count1 = _calculate_total_characters(lst1)\n    count2 = _calculate_total_characters(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character counts.\n    Returns the list with fewer total characters, or the first list on a tie.\n    \"\"\"\n    total_len1 = sum(len(s) for s in lst1)\n    total_len2 = sum(len(s) for s in lst2)\n\n    if total_len1 < total_len2:\n        return lst1\n    elif total_len2 < total_len1:\n        return lst2\n    else:  # total_len1 == total_len2\n        return lst1\n```"}
