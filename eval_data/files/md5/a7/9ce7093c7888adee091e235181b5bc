{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n```"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    Find x such that poly(x) = 0, returning only one zero point.\n    Requires an even number of coefficients and a non-zero largest coefficient.\n    \"\"\"\n    if len(xs) % 2 != 0:\n        raise ValueError(\"The list of coefficients xs must have an even number of elements.\")\n    if xs[-1] == 0:\n        raise ValueError(\"The largest coefficient in xs must be non-zero.\")\n\n    low = -10000.0  # Initial search range for a zero point\n    high = 10000.0\n    tolerance = 1e-7\n\n    # Perform bisection to find a root within the range\n    for _ in range(100):  # Iterate a fixed number of times for precision\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        p_low = poly(xs, low)\n\n        # Adjust the search interval based on the signs of poly(low) and poly(mid)\n        if p_low * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n\n    return (low + high) / 2 # Return the midpoint of the final interval"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef compute_derivative_coefficients(coefficients: list) -> list:\n    \"\"\"\n    Computes coefficients for the derivative of a polynomial (lowest degree first).\n    For P(x) = c0 + c1*x + ... + cn*x^n, P'(x) = c1 + 2c2*x + ... + n*cn*x^(n-1).\n    \"\"\"\n    if not coefficients or len(coefficients) == 1:\n        return [0.0]\n\n    derivative_coeffs = []\n    for i in range(1, len(coefficients)):\n        derivative_coeffs.append(coefficients[i] * i)\n    return derivative_coeffs\n\n\ndef find_zero(xs: list) -> float:\n    \"\"\"\n    Finds a single root of a polynomial using the Newton-Raphson method.\n    It takes polynomial coefficients `xs` and returns the found root.\n    \"\"\"\n    TOLERANCE = 1e-6\n    MAX_ITERATIONS = 100\n\n    current_guess = 0.0\n    iteration_count = 0\n\n    derivative_coeffs = compute_derivative_coefficients(xs)\n\n    while iteration_count < MAX_ITERATIONS:\n        p_at_current_guess = poly(xs, current_guess)\n\n        if abs(p_at_current_guess) < TOLERANCE:\n            return current_guess\n\n        p_prime_at_current_guess = poly(derivative_coeffs, current_guess)\n\n        # If derivative is zero, return current guess as a potential root or approximation.\n        if p_prime_at_current_guess == 0:\n            return current_guess\n\n        current_guess = current_guess - (p_at_current_guess / p_prime_at_current_guess)\n        iteration_count += 1\n\n    return current_guess\n```"}
