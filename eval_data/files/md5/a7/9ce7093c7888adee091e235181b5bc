{"task_id": "HumanEval/122", "solution": "```python\ndef _validate_inputs(arr, k):\n    \"\"\"Validates the input array and integer k against NFRs.\n    Raises ValueError if validation fails.\"\"\"\n    arr_len = len(arr)\n    if not (1 <= arr_len <= 100):\n        raise ValueError(\"Array length must be between 1 and 100 inclusive.\")\n    if not (1 <= k <= arr_len):\n        raise ValueError(\"k must be between 1 and the length of arr inclusive.\")\n\ndef _has_at_most_two_digits(num):\n    \"\"\"Checks if an integer has at most two digits.\n    Returns True if its absolute value is less than 100, False otherwise.\"\"\"\n    return abs(num) < 100\n\ndef add_elements(arr, k):\n    \"\"\"Given an array arr and integer k, sums elements with at most two digits\n    from the first k elements of arr, adhering to specified constraints.\"\"\"\n    _validate_inputs(arr, k)\n\n    running_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if _has_at_most_two_digits(element):\n            running_sum += element\n    return running_sum\n```"}
{"task_id": "HumanEval/115", "solution": "```python\nimport math\n\ndef _calculate_water_per_well(grid):\n    \"\"\"Calculates the total water units for each well.\n    It sums the '1's in each row of the grid.\n    \"\"\"\n    water_units_per_well = []\n    for well_row in grid:\n        water_units_per_well.append(sum(well_row))\n    return water_units_per_well\n\ndef _calculate_lowerings_per_well(water_units_list, capacity):\n    \"\"\"Determines bucket lowering operations for each well.\n    Applies ceiling division (water_units / capacity) for each well.\n    \"\"\"\n    lowerings_per_well = []\n    for water_units in water_units_list:\n        lowerings_per_well.append(math.ceil(water_units / capacity))\n    return lowerings_per_well\n\ndef max_fill(grid, capacity):\n    \"\"\"Calculates the total number of times buckets must be lowered to empty all wells.\n    It orchestrates the calculation of water units and lowering operations.\n    \"\"\"\n    water_units_per_well = _calculate_water_per_well(grid)\n    lowerings_per_well = _calculate_lowerings_per_well(water_units_per_well, capacity)\n    total_lowerings = sum(lowerings_per_well)\n    return total_lowerings\n```"}
{"task_id": "HumanEval/121", "solution": "```python\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n\n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    calculated_sum = 0\n    for index, element in enumerate(lst):\n        # Check if the current position (index) is even and the element's value is odd.\n        if index % 2 == 0 and element % 2 != 0:\n            calculated_sum += element\n    return calculated_sum\n```"}
{"task_id": "HumanEval/123", "solution": "```python\nclass _CollatzTerm:\n    \"\"\"Represents a single term in the Collatz sequence and handles its properties and next term calculation.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the term's value is even.\"\"\"\n        return self._value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the term's value is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def calculate_next_term(self) -> '_CollatzTerm':\n        \"\"\"Calculates the next term in the Collatz sequence.\"\"\"\n        if self.is_even():\n            return _CollatzTerm(self._value // 2)\n        else:\n            return _CollatzTerm(3 * self._value + 1)\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the term.\"\"\"\n        return self._value\n\nclass _CollatzSequenceGenerator:\n    \"\"\"Responsible for generating the full Collatz sequence.\"\"\"\n    def __init__(self):\n        self._terms: list[_CollatzTerm] = []\n\n    def generate(self, initial_n: int) -> None:\n        \"\"\"Generates the Collatz sequence starting from initial_n until 1 is reached.\"\"\"\n        current_term_value = initial_n\n        while current_term_value != 1:\n            term = _CollatzTerm(current_term_value)\n            self._terms.append(term)\n            current_term_value = term.calculate_next_term().get_value()\n        self._terms.append(_CollatzTerm(1)) # Add the final '1' term\n\n    def get_terms(self) -> list[_CollatzTerm]:\n        \"\"\"Returns the list of Collatz terms generated.\"\"\"\n        return self._terms\n\nclass _OddNumbersCollector:\n    \"\"\"Gathers and sorts the odd numbers from a generated sequence.\"\"\"\n    def __init__(self):\n        self._odd_terms: list[int] = []\n\n    def add_if_odd(self, term: _CollatzTerm) -> None:\n        \"\"\"Adds the term's value to the collection if it is an odd number.\"\"\"\n        if term.is_odd():\n            self._odd_terms.append(term.get_value())\n\n    def get_sorted_values(self) -> list[int]:\n        \"\"\"Returns the collected odd numbers as a sorted list.\"\"\"\n        self._odd_terms.sort()\n        return self._odd_terms\n\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function calculates the Collatz sequence and extracts its odd numbers, returning them sorted.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    generator = _CollatzSequenceGenerator()\n    generator.generate(n)\n    all_collatz_terms = generator.get_terms()\n\n    collector = _OddNumbersCollector()\n    for term in all_collatz_terms:\n        collector.add_if_odd(term)\n\n    return collector.get_sorted_values()\n```"}
{"task_id": "HumanEval/123", "solution": "```python\nclass CollatzNumber:\n    \"\"\"Encapsulates a number and its odd/even property.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number's value is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass CollatzSequence:\n    \"\"\"Generates and stores the full Collatz sequence.\"\"\"\n    def __init__(self, initial_n: int):\n        self.terms = []\n        self.add_term(CollatzNumber(initial_n))\n\n    def generate_next_term(self, current_term: CollatzNumber) -> CollatzNumber:\n        \"\"\"Calculates the next term based on Collatz rules.\"\"\"\n        if current_term.value % 2 == 0:\n            next_val = current_term.value // 2\n        else:\n            next_val = 3 * current_term.value + 1\n        return CollatzNumber(next_val)\n\n    def add_term(self, term: CollatzNumber):\n        \"\"\"Adds a CollatzNumber term to the sequence.\"\"\"\n        self.terms.append(term)\n\n    def generate_sequence(self) -> None:\n        \"\"\"Generates the entire sequence until 1 is reached.\"\"\"\n        while self.terms[-1].value != 1:\n            current_term = self.terms[-1]\n            next_term = self.generate_next_term(current_term)\n            self.add_term(next_term)\n\nclass OddNumbersCollection:\n    \"\"\"Collects odd numbers and provides them in sorted order.\"\"\"\n    def __init__(self):\n        self.odd_terms = []\n\n    def add_odd_term(self, term: CollatzNumber):\n        \"\"\"Adds the value of an odd CollatzNumber to the collection.\"\"\"\n        if term.is_odd():\n            self.odd_terms.append(term.value)\n\n    def sort(self) -> None:\n        \"\"\"Sorts the collected odd numbers in increasing order.\"\"\"\n        self.odd_terms.sort()\n\n    def get_sorted_odd_numbers(self) -> list[int]:\n        \"\"\"Returns the sorted list of odd numbers.\"\"\"\n        return self.odd_terms\n\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    collatz_sequence = CollatzSequence(n)\n    collatz_sequence.generate_sequence()\n\n    odd_collection = OddNumbersCollection()\n    for term in collatz_sequence.terms:\n        odd_collection.add_odd_term(term)\n\n    odd_collection.sort()\n    return odd_collection.get_sorted_odd_numbers()\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nclass _DateComponents:\n    \"\"\"Internal helper to store parsed date components.\"\"\"\n    def __init__(self, month: int, day: int, year: int):\n        self.month = month\n        self.day = day\n        self.year = year\n\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a date string in 'mm-dd-yyyy' format.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    # FR1: Handle Empty Date String\n    if not date:\n        return False\n\n    # FR6: Validate Date String Format (length and hyphens)\n    if len(date) != 10 or date[2] != '-' or date[5] != '-':\n        return False\n\n    month_str = date[0:2]\n    day_str = date[3:5]\n    year_str = date[6:10]\n\n    # FR6: Ensure all parts are digits\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n\n    # Parsing to integers\n    month = int(month_str)\n    day = int(day_str)\n    year = int(year_str)\n\n    # Create internal _DateComponents object as per design\n    date_parts = _DateComponents(month, day, year)\n\n    # FR5: Validate Month Range\n    if not (1 <= date_parts.month <= 12):\n        return False\n\n    # Determine maximum days for the month (FR2, FR3, FR4)\n    max_days: int\n    if date_parts.month in {1, 3, 5, 7, 8, 10, 12}:\n        max_days = 31  # FR2\n    elif date_parts.month in {4, 6, 9, 11}:\n        max_days = 30  # FR3\n    elif date_parts.month == 2:\n        max_days = 29  # FR4 (Maximum 29 days for February, no leap year check required by spec)\n    else:\n        # This case should ideally not be reached if month range is already validated.\n        # However, it covers any unforeseen logic path.\n        return False\n\n    # FR2, FR3, FR4: Validate Day Range\n    if not (1 <= date_parts.day <= max_days):\n        return False\n\n    # FR7: All validations passed, return True\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"Validates a given date string in 'mm-dd-yyyy' format.\n    Returns True if the date is valid according to specified rules, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    try:\n        parts = date.split('-')\n        if len(parts) != 3:\n            return False\n\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n\n        if not (1 <= month <= 12):\n            return False\n\n        if month in [1, 3, 5, 7, 8, 10, 12]:\n            if not (1 <= day <= 31):\n                return False\n        elif month in [4, 6, 9, 11]:\n            if not (1 <= day <= 30):\n                return False\n        elif month == 2:\n            if not (1 <= day <= 29): # No explicit leap year calculations needed.\n                return False\n\n    except ValueError:\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef _contains_whitespace(text: str) -> bool:\n    \"\"\"Checks if the text contains any whitespace characters.\"\"\"\n    for char in text:\n        if char.isspace():\n            return True\n    return False\n\ndef _contains_comma(text: str) -> bool:\n    \"\"\"Checks if the text contains any comma characters.\"\"\"\n    return ',' in text\n\ndef _count_odd_ordered_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\n\ndef split_words(txt: str):\n    '''\n    Given a string, processes it based on a priority of delimiters or character analysis.\n    It either splits by whitespace, by commas, or counts odd-ordered lowercase letters.\n    '''\n    if _contains_whitespace(txt):\n        return txt.split()\n    elif _contains_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the given text contains any whitespace characters.\"\"\"\n    return any(char.isspace() for char in text)\n\ndef _split_by_whitespace(text: str) -> list[str]:\n    \"\"\"Splits the text by whitespace characters.\"\"\"\n    return text.split()\n\ndef _has_comma(text: str) -> bool:\n    \"\"\"Checks if the given text contains any comma characters.\"\"\"\n    return ',' in text\n\ndef _split_by_comma(text: str) -> list[str]:\n    \"\"\"Splits the text by comma characters.\"\"\"\n    return text.split(',')\n\ndef _is_lowercase_english_letter(char: str) -> bool:\n    \"\"\"Helper to check if a character is a lowercase English letter.\"\"\"\n    return 'a' <= char <= 'z'\n\ndef _get_alphabetical_order(char: str) -> int:\n    \"\"\"Helper to get the 0-indexed alphabetical order of a character.\"\"\"\n    return ord(char) - ord('a')\n\ndef _is_odd_ordered(order: int) -> bool:\n    \"\"\"Helper to check if an alphabetical order is odd.\"\"\"\n    return order % 2 != 0\n\ndef _count_odd_ordered_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase English letters with odd alphabetical order.\"\"\"\n    count = 0\n    for char in text:\n        if _is_lowercase_english_letter(char):\n            order = _get_alphabetical_order(char)\n            if _is_odd_ordered(order):\n                count += 1\n    return count\n\ndef split_words(txt):\n    \"\"\"\n    Splits a string based on priority: whitespace, then commas. If neither, counts odd-ordered lowercase letters.\n    Returns a list of strings or an integer count.\n    \"\"\"\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)\n```"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    '''\n    Checks if a list is sorted in ascending order and has no number appearing three or more times.\n    Returns True if both conditions are met, False otherwise.\n    '''\n    # Check for ascending order (FR3)\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Count number occurrences (FR4)\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] >= 3:\n            return False\n\n    # If both checks pass, the list meets the criteria (FR2)\n    return True\n```"}
{"task_id": "HumanEval/127", "solution": "```python\nimport math\n\ndef is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime. Returns True if prime, False otherwise.\"\"\"\n    if number <= 1:\n        return False\n    for i in range(2, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            return False\n    return True\n\nclass Interval:\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def calculate_length(self) -> int:\n        \"\"\"Calculates the length of the interval.\"\"\"\n        return self.end - self.start\n\n    def get_intersection(self, other_interval: 'Interval') -> 'Interval | None':\n        \"\"\"Determines the intersection with another interval.\"\"\"\n        new_start = max(self.start, other_interval.start)\n        new_end = min(self.end, other_interval.end)\n\n        if new_start > new_end:\n            return None\n        return Interval(new_start, new_end)\n\ndef intersection(interval1: tuple, interval2: tuple) -> str:\n    \"\"\"Checks if the length of the intersection of two intervals is a prime number.\"\"\"\n    interval1_obj = Interval(interval1[0], interval1[1])\n    interval2_obj = Interval(interval2[0], interval2[1])\n\n    intersection_obj = interval1_obj.get_intersection(interval2_obj)\n\n    if intersection_obj is None:\n        return \"NO\"\n    else:\n        length = intersection_obj.calculate_length()\n        if is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\n```"}
{"task_id": "HumanEval/120", "solution": "```python\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array to easily pick the largest elements.\n    arr.sort()\n\n    # Return the last k elements, which are the largest and already sorted.\n    return arr[len(arr) - k:]\n```"}
{"task_id": "HumanEval/126", "solution": "```python\nfrom collections import Counter\n\ndef _is_list_valid(lst: list) -> bool:\n    \"\"\"\n    Validates that the input list, as per NFRs, contains only non-negative integers.\n    Per critical requirements, inputs are trusted to be valid.\n    \"\"\"\n    return True\n\ndef _check_sorted_ascending(lst: list) -> bool:\n    \"\"\"\n    Checks if the list is sorted in ascending order.\n    Returns False if any element is greater than the subsequent element.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n    return True\n\ndef _check_excessive_duplicates(lst: list) -> bool:\n    \"\"\"\n    Checks if any number in the list appears more than twice.\n    Returns True if any number appears 3 or more times.\n    \"\"\"\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return True\n    return False\n\ndef is_sorted(lst: list) -> bool:\n    \"\"\"\n    Given a list of non-negative numbers, return whether or not they are sorted\n    in ascending order and if no number appears more than twice.\n    \"\"\"\n    if not _is_list_valid(lst):\n        return False\n\n    if not _check_sorted_ascending(lst):\n        return False\n\n    if _check_excessive_duplicates(lst):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/127", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime. Returns True if prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to n // 2 + 1, only odd numbers.\n    for i in range(3, n // 2 + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef _calculate_length(interval: tuple[int, int] | None) -> int:\n    \"\"\"Calculates the length of a closed interval. Returns 0 if no interval.\"\"\"\n    if interval is None:\n        return 0\n    start, end = interval\n    return end - start + 1\n\ndef _calculate_intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n    \"\"\"Determines the intersection of two closed intervals. Returns None if no intersection.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start <= intersection_end:\n        return (intersection_start, intersection_end)\n    else:\n        return None\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n    intersected_interval = _calculate_intersection(interval1, interval2)\n\n    if intersected_interval is None:\n        return \"NO\"\n\n    length = _calculate_length(intersected_interval)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs.\n    Returns None for an empty input array.\n    \"\"\"\n    def _get_magnitude(number: int) -> int:\n        \"\"\"\n        Returns the absolute value (magnitude) of a number.\n        \"\"\"\n        return abs(number)\n\n    def _get_sign(number: int) -> int:\n        \"\"\"\n        Determines the sign of a number (1 for positive, -1 for negative, 0 for zero).\n        \"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for number in arr:\n        sum_magnitudes += _get_magnitude(number)\n        product_signs *= _get_sign(number)\n\n    return sum_magnitudes * product_signs\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef _get_magnitude(number: int) -> int:\n    \"\"\"Calculates the absolute value of a given integer.\"\"\"\n    return abs(number)\n\ndef _get_sign(number: int) -> int:\n    \"\"\"Determines the sign of a given integer (1 for positive, -1 for negative, or 0 for zero).\"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\n\ndef _calculate_sum_of_magnitudes(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of magnitudes for all integers in an array.\"\"\"\n    total_magnitude = 0\n    for number in arr:\n        total_magnitude += _get_magnitude(number)\n    return total_magnitude\n\ndef _calculate_product_of_signs(arr: list[int]) -> int:\n    \"\"\"Calculates the product of signs for all integers in an array.\"\"\"\n    product_of_signs = 1\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n    return product_of_signs\n\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = _calculate_sum_of_magnitudes(arr)\n    product_signs = _calculate_product_of_signs(arr)\n\n    return sum_magnitudes * product_signs\n```"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    This function orchestrates input handling, grid representation, and pathfinding.\n    \"\"\"\n\n    class GridValidator:\n        \"\"\"\n        Validates grid dimensions and k; simplified due to critical requirements.\n        It assumes valid input and computes N from the grid.\n        \"\"\"\n        def validate_grid(self, grid: list[list[int]]) -> int:\n            # As per critical requirements, no validation checks or exceptions are performed.\n            # We trust the input and directly derive N.\n            N = len(grid)\n            return N\n\n        def validate_k(self, k: int, N: int) -> None:\n            # As per critical requirements, no validation checks or exceptions are performed.\n            # We trust the input k is valid.\n            pass\n\n    class Cell:\n        \"\"\"\n        Represents a single cell in the grid, storing its value and coordinates.\n        It can compute its valid neighbors within grid boundaries.\n        \"\"\"\n        def __init__(self, value: int, row: int, col: int):\n            self.value = value\n            self.row = row\n            self.col = col\n\n        def get_neighbors(self, N: int) -> list[tuple[int, int]]:\n            \"\"\"Returns a list of (row, col) tuples for valid adjacent cells.\"\"\"\n            neighbors = []\n            possible_moves = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n            for dr, dc in possible_moves:\n                nr, nc = self.row + dr, self.col + dc\n                if 0 <= nr < N and 0 <= nc < N:\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    class GridRepresentation:\n        \"\"\"\n        Encapsulates the grid data, converting raw input into a structured format of Cell objects.\n        It provides efficient access to Cell objects by coordinates.\n        \"\"\"\n        def __init__(self, grid_data: list[list[int]]):\n            self.N = len(grid_data)\n            self.grid_values = grid_data\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(grid_data[r][c], r, c)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the Cell object at the given row and column.\"\"\"\n            return self.cells[row][col]\n\n    class PathFinder:\n        \"\"\"\n        Implements the core algorithm to explore paths and find the lexicographically smallest one.\n        It uses a recursive approach for path generation.\n        \"\"\"\n        def find_min_path(self, grid_obj: GridRepresentation, k: int) -> list[int]:\n            \"\"\"\n            Initiates path exploration from every cell and returns the overall minimum path.\n            All valid paths of length k are generated and then sorted.\n            \"\"\"\n            candidate_paths = []\n            for r in range(grid_obj.N):\n                for c in range(grid_obj.N):\n                    start_cell = grid_obj.get_cell(r, c)\n                    # Start path with the current cell's value\n                    self._explore_paths([start_cell.value], start_cell, grid_obj, k, candidate_paths)\n\n            # Sort candidate paths lexicographically to find the minimum\n            candidate_paths.sort()\n            return candidate_paths[0]\n\n        def _explore_paths(self, current_path_values: list[int], current_cell: Cell,\n                           grid_obj: GridRepresentation, k: int,\n                           all_paths: list[list[int]]) -> None:\n            \"\"\"\n            Recursively explores paths from the current cell.\n            Base case: a path of length k is found and added to all_paths.\n            \"\"\"\n            if len(current_path_values) == k:\n                all_paths.append(current_path_values.copy())\n                return\n\n            neighbors_coords = current_cell.get_neighbors(grid_obj.N)\n            for nr, nc in neighbors_coords:\n                neighbor_cell = grid_obj.get_cell(nr, nc)\n                # Extend the current path with the neighbor's value and recurse\n                self._explore_paths(current_path_values + [neighbor_cell.value],\n                                     neighbor_cell, grid_obj, k, all_paths)\n\n    # --- minPath orchestration ---\n    validator = GridValidator()\n    N = validator.validate_grid(grid)\n    validator.validate_k(k, N)\n\n    grid_obj = GridRepresentation(grid)\n    path_finder = PathFinder()\n\n    min_path_values = path_finder.find_min_path(grid_obj, k)\n    return min_path_values\n```"}
{"task_id": "HumanEval/122", "solution": "def _validate_inputs(arr: list[int], k: int) -> None:\n    \"\"\"Validates input array 'arr' and integer 'k' against specified constraints.\n    Raises ValueError if constraints are violated.\"\"\"\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(\"Array length must be between 1 and 100, inclusive.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(\"k must be between 1 and the length of the array, inclusive.\")\n\ndef _has_at_most_two_digits(number: int) -> bool:\n    \"\"\"Determines if an integer has at most two digits (absolute value less than 100).\n    Returns True if abs(number) < 100, False otherwise.\"\"\"\n    return abs(number) < 100\n\ndef add_elements(arr: list[int], k: int) -> int:\n    \"\"\"Given an array 'arr' and an integer 'k', returns the sum of two-digit elements from the first 'k' elements.\n    Orchestrates validation, filtering, and summation.\"\"\"\n    _validate_inputs(arr, k)\n\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if _has_at_most_two_digits(element):\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n: int) -> list[int]:\n    \"\"\"Computes the first n + 1 numbers of a Tribonacci-like sequence.\n    Returns [tri(0), tri(1), ..., tri(n)].\n    \"\"\"\n    # Initialize trib_sequence of size n + 2, needed for tri(n+1) dependency.\n    trib_sequence = [0] * (n + 2)\n\n    # Base cases for tri(0) and tri(1).\n    if n >= 0:\n        trib_sequence[0] = 1\n    if n >= 1:\n        trib_sequence[1] = 3\n\n    # First pass: Compute all even numbers up to tri(n+1).\n    for k in range(2, n + 2):\n        if k % 2 == 0:\n            trib_sequence[k] = 1 + k // 2\n\n    # Second pass: Compute all odd numbers up to tri(n) using known values.\n    for k in range(3, n + 1):\n        if k % 2 != 0:\n            trib_sequence[k] = trib_sequence[k - 1] + trib_sequence[k - 2] + trib_sequence[k + 1]\n\n    # Return the requested slice of the sequence.\n    return trib_sequence[:n + 1]\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n: int) -> list[int]:\n    \"\"\"Calculates and returns a list of the first n + 1 Tribonacci numbers.\n    It handles base cases and the specific recurrence relations, including a forward dependency for odd terms.\n    \"\"\"\n    # Initialize sequence list with n + 2 elements to accommodate tri(n+1) for odd n.\n    sequence = [0] * (n + 2)\n\n    # Define base cases: tri(0) and tri(1).\n    sequence[0] = 1\n    if n >= 1:\n        sequence[1] = 3\n\n    # First pass: Populate all even terms from tri(2) up to tri(n+1).\n    for i in range(2, n + 2):\n        if i % 2 == 0:  # If i is even, apply recurrence relation FR5.\n            sequence[i] = 1 + i // 2\n\n    # Second pass: Populate odd terms from tri(3) up to tri(n) using the forward dependency.\n    for i in range(3, n + 1):\n        if i % 2 != 0:  # If i is odd, apply recurrence relation FR6.\n            sequence[i] = sequence[i - 1] + sequence[i - 2] + sequence[i + 1]\n\n    # Return the first n + 1 numbers of the sequence, from tri(0) to tri(n).\n    return sequence[:n + 1]\n```"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_value(self) -> int:\n            \"\"\"Returns the value of the cell.\"\"\"\n            return self._value\n\n        def get_row(self) -> int:\n            \"\"\"Returns the row index of the cell.\"\"\"\n            return self._row\n\n        def get_col(self) -> int:\n            \"\"\"Returns the column index of the cell.\"\"\"\n            return self._col\n\n    class Grid:\n        \"\"\"Manages the N x N grid of Cell objects and provides neighborhood queries.\"\"\"\n        def __init__(self, N: int, cell_values: list[list[int]]):\n            self._N = N\n            self._cells = [[None for _ in range(N)] for _ in range(N)]\n            for r in range(N):\n                for c in range(N):\n                    self._cells[r][c] = Cell(r, c, cell_values[r][c])\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n            return self._cells[row][col]\n\n        def get_neighbors(self, cell: Cell) -> list[Cell]:\n            \"\"\"Returns a list of adjacent Cell objects that are within grid boundaries.\"\"\"\n            neighbors = []\n            r, c = cell.get_row(), cell.get_col()\n            directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n\n            for dr, dc in directions:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < self._N and 0 <= nc < self._N:\n                    neighbors.append(self._cells[nr][nc])\n            return neighbors\n\n        def get_N(self) -> int:\n            \"\"\"Returns the dimension N of the grid.\"\"\"\n            return self._N\n\n    class Path:\n        \"\"\"Represents a path as a sequence of cells and their values for comparison.\"\"\"\n        def __init__(self, length_k: int, initial_cell: Cell):\n            self._length_k = length_k\n            self._sequence_of_cells = [initial_cell]\n            self._sequence_of_values = [initial_cell.get_value()]\n\n        def add_cell(self, cell: Cell) -> None:\n            \"\"\"Adds a cell to the end of the path.\"\"\"\n            self._sequence_of_cells.append(cell)\n            self._sequence_of_values.append(cell.get_value())\n\n        def remove_last_cell(self) -> None:\n            \"\"\"Removes the last cell from the path, used for backtracking.\"\"\"\n            if self._sequence_of_cells:\n                self._sequence_of_cells.pop()\n                self._sequence_of_values.pop()\n\n        def get_values_list(self) -> list[int]:\n            \"\"\"Returns the ordered list of values visited in the path.\"\"\"\n            return self._sequence_of_values\n\n        def get_current_length(self) -> int:\n            \"\"\"Returns the current number of cells in the path.\"\"\"\n            return len(self._sequence_of_cells)\n\n        def get_last_cell(self) -> Cell:\n            \"\"\"Returns the last Cell object added to the path.\"\"\"\n            return self._sequence_of_cells[-1]\n\n        def __lt__(self, other: 'Path') -> bool:\n            \"\"\"Compares two paths lexicographically based on their value sequences.\"\"\"\n            return self._sequence_of_values < other._sequence_of_values\n\n        def __eq__(self, other: 'Path') -> bool:\n            \"\"\"Checks if two paths are equal based on their value sequences.\"\"\"\n            return self._sequence_of_values == other._sequence_of_values\n\n    N = len(grid)\n    grid_obj = Grid(N, grid)\n\n    min_path_values = None\n\n    def explore_paths_recursive(current_path: Path):\n        \"\"\"\n        Recursively explores paths of length k starting from a given cell.\n        Updates the global minimum path if a smaller one is found.\n        \"\"\"\n        nonlocal min_path_values\n\n        if current_path.get_current_length() == k:\n            path_values = current_path.get_values_list()\n            # Python's list comparison handles lexicographical order naturally.\n            if min_path_values is None or path_values < min_path_values:\n                min_path_values = list(path_values) # Store a copy\n            return\n\n        if current_path.get_current_length() < k:\n            last_cell = current_path.get_last_cell()\n            neighbors = grid_obj.get_neighbors(last_cell)\n\n            for neighbor in neighbors:\n                current_path.add_cell(neighbor)\n                explore_paths_recursive(current_path)\n                current_path.remove_last_cell() # Backtrack\n\n    # Iterate through every cell as a potential starting point\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            initial_path = Path(k, start_cell)\n            explore_paths_recursive(initial_path)\n\n    return min_path_values"}
{"task_id": "HumanEval/131", "solution": "```python\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is an odd number.\n    Returns True if the digit is odd, False otherwise.\n    \"\"\"\n    return digit % 2 != 0\n\ndef _extract_digits(n: int) -> list[int]:\n    \"\"\"Extracts individual digits from a positive integer n.\n    Returns them as a list of integers.\n    \"\"\"\n    # Converting to string and then back to int for each character is robust.\n    return [int(d) for d in str(n)]\n\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    extracted_digits = _extract_digits(n)\n\n    product = 1\n    found_odd_digit = False\n\n    for digit in extracted_digits:\n        if _is_odd(digit):\n            product *= digit\n            found_odd_digit = True\n\n    if found_odd_digit:\n        return product\n    else:\n        return 0\n```"}
{"task_id": "HumanEval/131", "solution": "```python\nclass Digit:\n    \"\"\"Represents a single digit with value and odd/even check.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the digit.\"\"\"\n        return self._value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the digit is odd.\"\"\"\n        return self._value % 2 != 0\n\n\nclass PositiveInteger:\n    \"\"\"Holds a positive integer and extracts its digits.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer's value.\"\"\"\n        return self._value\n\n    def extract_digits(self) -> list['Digit']:\n        \"\"\"Extracts individual Digit objects from the integer.\"\"\"\n        digits_list = []\n        temp_value = self._value\n        while temp_value > 0:\n            digit_value = temp_value % 10\n            digits_list.append(Digit(digit_value))\n            temp_value //= 10\n        return digits_list[::-1]\n\n\nclass OddDigitProductCalculator:\n    \"\"\"Calculates the product of odd digits in a PositiveInteger.\"\"\"\n    def calculate_product_of_odd_digits(self, n: 'PositiveInteger') -> int:\n        \"\"\"Computes the product of all odd digits in the given PositiveInteger.\"\"\"\n        digits_list = n.extract_digits()\n        product = 1\n        found_odd_digit = False\n\n        for digit in digits_list:\n            if digit.is_odd():\n                product *= digit.get_value()\n                found_odd_digit = True\n\n        return product if found_odd_digit else 0\n\n\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    positive_int = PositiveInteger(n)\n    calculator = OddDigitProductCalculator()\n    return calculator.calculate_product_of_odd_digits(positive_int)\n```\n"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Checks for a nested pattern `[[ ]]` defined by four indices i < j < k < l.\n    It returns True if such a pattern exists, False otherwise.\n    \"\"\"\n    open_brackets_needed = 2\n    close_brackets_needed = 2\n\n    for char in string:\n        if char == '[':\n            if open_brackets_needed > 0:\n                open_brackets_needed -= 1\n        elif char == ']':\n            # We can only start looking for closing brackets if we've found two opening ones.\n            if open_brackets_needed == 0:\n                if close_brackets_needed > 0:\n                    close_brackets_needed -= 1\n                    # If two opening and two closing brackets are found in order, the pattern exists.\n                    if close_brackets_needed == 0:\n                        return True\n\n    return False\n```"}
{"task_id": "HumanEval/133", "solution": "```python\n# Helper function to calculate the ceiling of a number without math.ceil.\n# It rounds up positive numbers with fractional parts and truncates for negative numbers.\ndef _calculate_ceiling(num):\n    rounded_num = int(num)\n    if num > 0 and num != rounded_num:\n        rounded_num += 1\n    return rounded_num\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = _calculate_ceiling(num)\n        squared_num = rounded_num * rounded_num\n        total_sum += squared_num\n    return total_sum\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not part of a word.\n    A 'word' is defined as characters separated by spaces.\n    \"\"\"\n    # FR1: Return False if the input string is empty.\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # FR2: Return False if the last character is not alphabetical.\n    if not last_char.isalpha():\n        return False\n\n    # FR3: Return True if the string has only one alphabetical character.\n    if len(txt) == 1:\n        return True\n\n    # For strings with length greater than 1, check the character preceding the last one.\n    preceding_char = txt[-2]\n\n    # FR4: Return True if the last alphabetical character is preceded by a space.\n    if preceding_char == ' ':\n        return True\n    else:\n        # FR5: Return False if the last alphabetical character is preceded by a non-space character.\n        return False\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical letter\n    and is not part of a preceding word.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # If the string has more than one character, check the one before the last.\n    prev_char = txt[-2]\n    return prev_char == ' '\n```"}
