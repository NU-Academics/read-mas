{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n    def custom_sort_key(num):\n        if num < 0:\n            # For negative numbers, sort based on their decimal value (ascending)\n            # Group 0 ensures all negatives come before non-negatives\n            return (0, num)\n        else:\n            # For non-negative numbers, sort by bit count then decimal value\n            # Group 1 ensures all non-negatives come after negatives\n            return (1, num.bit_count(), num)\n\n    return sorted(arr, key=custom_sort_key)\n```\n"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right side of the word.\n    Returns the vowel or an empty string if not found.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return char in VOWELS\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English letter and not a vowel.\"\"\"\n        return char.isalpha() and char not in VOWELS\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    # The loop goes from index len(word) - 2 down to 1 (inclusive).\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i - 1]\n        next_char = word[i + 1]\n\n        if _is_vowel(current_char) and _is_consonant(prev_char) and _is_consonant(next_char):\n            return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef _is_even(number: int) -> bool:\n    \"\"\"Determines if a given integer is even.\"\"\"\n    return number % 2 == 0\n\ndef _count_odd_elements(lst: list[int]) -> int:\n    \"\"\"Counts the number of odd elements in the provided list.\"\"\"\n    count = 0\n    for item in lst:\n        if not _is_even(item):\n            count += 1\n    return count\n\ndef _count_even_elements(lst: list[int]) -> int:\n    \"\"\"Counts the number of even elements in the provided list.\"\"\"\n    count = 0\n    for item in lst:\n        if _is_even(item):\n            count += 1\n    return count\n\ndef exchange(lst1, lst2):\n    \"\"\"Determines if `lst1` can be made entirely of even numbers by exchanging elements with `lst2`.\n    Returns 'YES' if possible, 'NO' otherwise.\n    \"\"\"\n    odd_count_lst1 = _count_odd_elements(lst1)\n    even_count_lst2 = _count_even_elements(lst2)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a parentheses string is balanced.\n    A counter tracks the balance, returning false if it ever drops below zero.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"Checks if two strings can form a balanced parentheses string when concatenated.\n    It attempts both concatenation orders and returns 'Yes' if either is balanced.\"\"\"\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Concatenate in the first order: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Concatenate in the second order: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string of parentheses is balanced.\"\"\"\n    balance_count = 0\n    for char in s:\n        if char == '(':\n            balance_count += 1\n        elif char == ')':\n            balance_count -= 1\n        if balance_count < 0:\n            return False\n    return balance_count == 0\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if two strings of parentheses can be concatenated in any order to form a balanced string.\n    The input list `lst` is assumed to contain exactly two strings, each with only '(' or ')' characters.\n    \"\"\"\n    string1 = lst[0]\n    string2 = lst[1]\n\n    # Concatenation 1: string1 + string2\n    s1_s2 = string1 + string2\n    is_balanced_s1_s2 = _is_balanced(s1_s2)\n\n    # Concatenation 2: string2 + string1\n    s2_s1 = string2 + string1\n    is_balanced_s2_s1 = _is_balanced(s2_s1)\n\n    if is_balanced_s1_s2 or is_balanced_s2_s1:\n        return 'Yes'\n    else:\n        return 'No'\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between\n    two consonants from the right side of the word (case sensitive).\n\n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition.\n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n\n    # Helper function to check if a character is a vowel.\n    def _is_vowel(char: str) -> bool:\n        return char in {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    # Helper function to check if a character is a consonant.\n    def _is_consonant(char: str) -> bool:\n        return char.isalpha() and not _is_vowel(char)\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This ensures that the first and last characters are excluded from consideration.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n\n        # Check if the current character is a vowel and is surrounded by consonants.\n        if _is_vowel(current_char) and \\\n           _is_consonant(word[i-1]) and \\\n           _is_consonant(word[i+1]):\n            return current_char\n\n    # If no valid vowel is found after checking all characters, return an empty string.\n    return \"\"\n\n```"}
