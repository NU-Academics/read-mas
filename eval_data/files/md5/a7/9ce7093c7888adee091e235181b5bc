{"task_id": "HumanEval/93", "solution": "```python\n# src/message_encoder.py\n\n# Lowercase English alphabet for character indexing.\nALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n# Uppercase English alphabet for character indexing.\nALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n# Lowercase vowels used for identification.\nVOWELS_LOWER = 'aeiou'\n# Uppercase vowels used for identification.\nVOWELS_UPPER = 'AEIOU'\n\ndef _swap_case(char):\n    \"\"\"Swaps the case of a single letter. Non-letters are returned unchanged.\"\"\"\n    if char.islower():\n        return char.upper()\n    elif char.isupper():\n        return char.lower()\n    return char\n\ndef _replace_vowel(char):\n    \"\"\"Replaces a vowel with the letter two places ahead in the alphabet, maintaining case.\"\"\"\n    if char in VOWELS_LOWER:\n        idx = ALPHABET_LOWER.index(char)\n        return ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n    elif char in VOWELS_UPPER:\n        idx = ALPHABET_UPPER.index(char)\n        return ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n    return char\n\ndef encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if char.isalpha(): # Process only alphabetic characters.\n            is_original_vowel = char.lower() in VOWELS_LOWER # Check if original char is a vowel (case-insensitive).\n\n            processed_char = char\n            if is_original_vowel:\n                processed_char = _replace_vowel(char) # Apply vowel replacement.\n\n            final_char = _swap_case(processed_char) # Apply case swap to the result.\n            encoded_chars.append(final_char)\n        else:\n            encoded_chars.append(char) # Non-alphabetic characters are kept as is.\n    return \"\".join(encoded_chars)\n```\n```python\n# src/main.py\n\nimport argparse\nfrom .message_encoder import encode # Import the core encoding logic\n\nclass MainCLI:\n    \"\"\"Handles the command-line interface for the Message Encoder system.\"\"\"\n\n    def parse_arguments(self):\n        \"\"\"Parses command-line arguments to get the message string.\"\"\"\n        parser = argparse.ArgumentParser(description=\"Encode a text message.\")\n        parser.add_argument(\"--message\", type=str, required=True,\n                            help=\"The message string to be encoded.\")\n        return parser.parse_args()\n\n    def main(self):\n        \"\"\"Executes the CLI application: parses arguments, encodes, and prints the result.\"\"\"\n        args = self.parse_arguments()\n        input_message = args.message\n        \n        encoded_message = encode(input_message)\n        \n        print(encoded_message)\n\nif __name__ == \"__main__\":\n    cli = MainCLI()\n    cli.main()\n```"}
{"task_id": "HumanEval/94", "solution": "```python\nfrom typing import List, Optional\n\nclass Integer:\n    \"\"\"Encapsulates an integer value, providing primality testing and digit sum calculation.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\n\n    def is_prime(self) -> bool:\n        \"\"\"Determines if the integer is a prime number.\"\"\"\n        if self._value <= 1:\n            return False\n        if self._value <= 3:\n            return True\n        if self._value % 2 == 0 or self._value % 3 == 0:\n            return False\n        i = 5\n        while i * i <= self._value:\n            if self._value % i == 0 or self._value % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def calculate_digit_sum(self) -> int:\n        \"\"\"Calculates the sum of the individual decimal digits of the integer.\"\"\"\n        return sum(int(digit) for digit in str(self._value))\n\nclass IntegerList:\n    \"\"\"Manages a collection of Integer objects and finds the largest prime among them.\"\"\"\n    def __init__(self, integer_values: List[int]):\n        self._integers = [Integer(val) for val in integer_values]\n\n    def find_largest_prime(self) -> Optional[Integer]:\n        \"\"\"Identifies all primes and returns the Integer object with the largest value.\"\"\"\n        largest_prime = None\n        for integer_obj in self._integers:\n            if integer_obj.is_prime():\n                if largest_prime is None or integer_obj.get_value() > largest_prime.get_value():\n                    largest_prime = integer_obj\n        return largest_prime\n\ndef skjkasdkd(lst: List[int]) -> int:\n    \"\"\"\n    Finds the largest prime value in a list and returns the sum of its digits.\n    Returns 0 if the list is empty or contains no prime numbers.\n    \"\"\"\n    if not lst:\n        return 0\n\n    integer_list = IntegerList(lst)\n    largest_prime_integer = integer_list.find_largest_prime()\n\n    if largest_prime_integer:\n        return largest_prime_integer.calculate_digit_sum()\n    else:\n        return 0\n```"}
