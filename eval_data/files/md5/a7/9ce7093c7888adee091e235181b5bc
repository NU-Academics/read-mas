{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Counts n-digit positive integers that start or end with 1.\n    Handles n=1 as a special case, otherwise applies the inclusion-exclusion principle.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Applies inclusion-exclusion: (starts with 1) + (ends with 1) - (starts AND ends with 1).\n        # This simplifies to 18 * (10**(n - 2)) for n > 1.\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs into a corresponding list of letter grades.\n    This function applies a predefined grading scale to each GPA.\n    \"\"\"\n\n    def _convert_single_gpa(gpa: float) -> str:\n        # Converts a single numerical GPA to its corresponding letter grade using the grading scale.\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        elif gpa == 0.0:\n            return 'E'\n\n    letter_grades = []\n    for gpa_score in grades:\n        letter_grades.append(_convert_single_gpa(gpa_score))\n    return letter_grades\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef _is_prime(number):\n    \"\"\"Determines if a given integer is a prime number.\n    Handles special cases for numbers less than or equal to 1, and efficiently checks divisibility.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string):\n    \"\"\"Checks if the length of the input string is a prime number.\n    It returns True if the string's length is prime, False otherwise.\"\"\"\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s, n):\n    \"\"\"\n    Extracts apple and orange counts from a string and calculates the mango count\n    by subtracting them from a total count.\n    \"\"\"\n    # Extract apple count\n    apple_count = 0\n    apple_match = re.search(r'(\\d+)\\s+apples', s)\n    if apple_match:\n        apple_count = int(apple_match.group(1))\n\n    # Extract orange count\n    orange_count = 0\n    orange_match = re.search(r'(\\d+)\\s+oranges', s)\n    if orange_match:\n        orange_count = int(orange_match.group(1))\n\n    # Calculate mango count\n    mango_count = n - (apple_count + orange_count)\n\n    return mango_count\n```"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a corresponding list of letter grades.\n    Applies a predefined grading scale to each GPA value.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        elif gpa == 0.0:\n            letter_grades.append('E')\n    return letter_grades\n```"}
{"task_id": "HumanEval/82", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\n    It handles special cases and iterates through odd divisors up to the square root.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string: str) -> bool:\n    \"\"\"Checks if the length of the input string is a prime number.\n    It calculates the string length and uses a helper function for primality.\"\"\"\n    string_length = len(string)\n    return is_prime(string_length)"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    This uses the principle of inclusion-exclusion based on the problem design.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, the count is 19 * 10^(n-2)\n        # This comes from (starts with 1) + (ends with 1) - (starts and ends with 1)\n        # = 10^(n-1) + 10^(n-1) - 10^(n-2) = 2 * 10^(n-1) - 10^(n-2) = (20 - 1) * 10^(n-2)\n        return 19 * (10 ** (n - 2))\n```"}
