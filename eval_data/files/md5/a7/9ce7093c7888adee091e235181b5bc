{"task_id": "HumanEval/43", "solution": "```python\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n\n    # Return False if the list has fewer than two elements.\n    if n < 2:\n        return False\n\n    # Iterate through all distinct pairs (l[i], l[j]) and check their sum.\n    for i in range(n):\n        for j in range(i + 1, n):\n            if l[i] + l[j] == 0:\n                return True\n\n    # If no such pair is found after checking all combinations, return False.\n    return False\n```"}
{"task_id": "HumanEval/39", "solution": "```python\nimport math\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime. Optimizes by checking divisibility up to its square root.\"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for factors from 3 up to the square root of num, incrementing by 2.\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef generate_fibonacci_sequence():\n    \"\"\"A generator that yields Fibonacci numbers (1, 1, 2, 3...) indefinitely. It uses initial values 0 and 1.\"\"\"\n    a, b = 0, 1\n    while True:\n        yield b\n        a, b = b, a + b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    fib_gen = generate_fibonacci_sequence()\n\n    while True:\n        current_fib = next(fib_gen)\n        # Fibonacci numbers 0 and 1 are not prime; is_prime() handles num <= 1 as False.\n        # This allows the loop to correctly find prime Fibonacci numbers starting from 2.\n        if is_prime(current_fib):\n            count += 1\n            if count == n:\n                return current_fib\n```"}
{"task_id": "HumanEval/44", "solution": "```python\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Converts an integer x to a string representation in the specified base.\n    The base must be less than 10, and x is an integer.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    current_x = x\n\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n\n    # Reverse the collected digits and join them to form the final string.\n    return \"\".join(result_digits[::-1])\n```"}
{"task_id": "HumanEval/44", "solution": "```python\ndef change_base(x: int, base: int):\n    \"\"\"Converts an integer `x` from base 10 to its string representation in the specified target `base`.\n    The target base must be less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    result = ''\n    while x > 0:\n        digit = x % base\n        result = str(digit) + result\n        x = x // base\n    return result\n```"}
