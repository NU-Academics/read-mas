{"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name):\n    \"\"\"Calculates the strength of an extension as CAP - SM.\"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if 'A' <= char <= 'Z':\n            cap_count += 1\n        elif 'a' <= char <= 'z':\n            sm_count += 1\n    return cap_count - sm_count\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM, returning ClassName.StrongestExtensionName.\"\"\"\n    if not extensions:\n        return class_name\n\n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    for extension in extensions:\n        current_strength = _calculate_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/147", "solution": "```python\nclass ArrayElement:\n    \"\"\"Represents an array element with its 1-based index and calculated value.\"\"\"\n    def __init__(self, index: int):\n        self._index = index\n        self._value = index * index - index + 1\n\n    def get_value(self) -> int:\n        \"\"\"Returns the calculated value of the element.\"\"\"\n        return self._value\n\n    def get_index(self) -> int:\n        \"\"\"Returns the 1-based index of the element.\"\"\"\n        return self._index\n\nclass Triple:\n    \"\"\"Represents a combination of three ArrayElement objects.\"\"\"\n    def __init__(self, e1: ArrayElement, e2: ArrayElement, e3: ArrayElement):\n        self._element1 = e1\n        self._element2 = e2\n        self._element3 = e3\n        self._sum = self._element1.get_value() + self._element2.get_value() + self._element3.get_value()\n\n    def is_sum_multiple_of_3(self) -> bool:\n        \"\"\"Checks if the sum of the elements is a multiple of 3.\"\"\"\n        return self._sum % 3 == 0\n\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a'\n    where i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    a = []\n    for i in range(1, n + 1):\n        a.append(ArrayElement(i))\n\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                current_triple = Triple(a[i], a[j], a[k])\n                if current_triple.is_sum_multiple_of_3():\n                    count += 1\n    return count\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Counts even and odd digits in an integer's absolute value.\n    Returns a tuple (even_count, odd_count).\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Process the absolute value of the number to handle negatives correctly.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Checks if string b or any of its cyclic rotations is a substring of string a.\n    Handles empty strings and length mismatches as edge cases.\n    \"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    len_b = len(b)\n    for i in range(len_b):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a, b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    if len(b) == 0:\n        return True\n\n    if len(b) > len(a):\n        return False\n\n    b_doubled = b + b\n\n    for i in range(len(b)):\n        current_rotation = b_doubled[i : i + len(b)]\n        if current_rotation in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef _validate_input(number: int) -> None:\n    \"\"\"Validates if the input integer is within the allowed range [1, 1000].\n    Raises ValueError if validation fails.\"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input out of range: number must be between 1 and 1000.\")\n\ndef _convert_to_roman(number: int) -> str:\n    \"\"\"Converts a positive integer to its uppercase Roman numeral string equivalent.\"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result)\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000\n    \"\"\"\n    _validate_input(number)\n    uppercase_roman = _convert_to_roman(number)\n    return uppercase_roman.lower()\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    Raises ValueError if the input number is outside the specified range.\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input out of range\")\n\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result_roman = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result_roman.append(symbol)\n            number -= value\n\n    return \"\".join(result_roman).lower()"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Checks if three side lengths form a right-angled triangle using the Pythagorean theorem.\n    It returns True if a\u00b2 + b\u00b2 = c\u00b2 (or any permutation), False otherwise.\n    \"\"\"\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n    return (a_sq + b_sq == c_sq) or \\\n           (a_sq + c_sq == b_sq) or \\\n           (b_sq + c_sq == a_sq)\n```"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given three side lengths, determine if they form a right-angled triangle.\n    It checks if the square of one side equals the sum of the squares of the other two.\n    '''\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check all permutations for the Pythagorean theorem: a^2 + b^2 = c^2, etc.\n    if (a_sq + b_sq == c_sq) or \\\n       (a_sq + c_sq == b_sq) or \\\n       (b_sq + c_sq == a_sq):\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number: int, need: int, remaining: int) -> list[int]:\n    \"\"\"\n    Calculates total carrots eaten and remaining after a meal.\n    Accounts for scenarios where not enough carrots are in stock.\n    \"\"\"\n    total_eaten: int\n    carrots_left: int\n\n    if remaining >= need:\n        total_eaten = number + need\n        carrots_left = remaining - need\n    else:\n        total_eaten = number + remaining\n        carrots_left = 0\n\n    return [total_eaten, carrots_left]\n```"}
{"task_id": "HumanEval/158", "solution": "```python\nfrom typing import List\n\ndef _calculate_unique_char_count(s: str) -> int:\n    \"\"\"Calculates the number of unique characters in a string.\"\"\"\n    return len(set(s))\n\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    Applies lexicographical tie-breaking.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_string = \"\"\n\n    for current_string in words:\n        current_unique_count = _calculate_unique_char_count(current_string)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_string = current_string\n        elif current_unique_count == max_unique_count:\n            # Apply lexicographical tie-breaker\n            if current_string < result_string:\n                result_string = current_string\n\n    return result_string\n```"}
{"task_id": "HumanEval/158", "solution": "```python\nclass Word:\n    \"\"\"Encapsulates a string and provides its unique character count and lexicographical comparison.\"\"\"\n\n    def __init__(self, value: str):\n        \"\"\"Initializes with a string, calculating and caching its unique character count.\"\"\"\n        self._value = value\n        self._unique_char_count = len(set(value))\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated word string.\"\"\"\n        return self._value\n\n    def get_unique_char_count(self) -> int:\n        \"\"\"Returns the cached unique character count.\"\"\"\n        return self._unique_char_count\n\n    def __lt__(self, other: 'Word') -> bool:\n        \"\"\"Compares two Word objects lexicographically based on their string values.\"\"\"\n        return self._value < other._value\n\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters from a list of strings.\n    In case of ties, it returns the lexicographically smallest word.\n    \"\"\"\n    best_word_obj: Word | None = None\n    max_unique_count = -1\n\n    for word_string in words:\n        current_word_obj = Word(word_string)\n        current_unique_count = current_word_obj.get_unique_char_count()\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word_obj = current_word_obj\n        elif current_unique_count == max_unique_count:\n            if best_word_obj is None or current_word_obj < best_word_obj:\n                best_word_obj = current_word_obj\n\n    # Assumes words list is not empty based on problem statement examples.\n    # If the list could be empty, specific handling (e.g., returning \"\") would be needed.\n    return best_word_obj.get_value()\n\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    The counts are based on the absolute value of the input number.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through its digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef _is_integer(num):\n    \"\"\"Checks if a given number is an integer type.\"\"\"\n    # Directly checks if the element's type is exactly an integer.\n    return type(num) is int\n\ndef _is_positive(num: int):\n    \"\"\"Checks if an integer is positive.\"\"\"\n    return num > 0\n\ndef _is_odd(num: int):\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return num % 2 != 0\n\ndef _square(num: int):\n    \"\"\"Calculates the square of an integer.\"\"\"\n    return num * num\n\ndef double_the_difference(lst):\n    '''\n    Calculates the sum of squares of positive, odd integers from a list.\n    Ignores non-integers, negative numbers, and zero.\n    '''\n    total_sum = 0\n\n    # Return 0 if the input list is empty (FR2).\n    if not lst:\n        return 0\n\n    # Iterate through each element of the list (FR3).\n    for element in lst:\n        # Filter elements, considering only those that are integers (FR4).\n        if _is_integer(element):\n            # Further filter integer elements, considering only those that are positive (FR6).\n            if _is_positive(element):\n                # From the positive integers, identify and process only the odd ones (FR8).\n                if _is_odd(element):\n                    # Square each qualifying positive, odd integer (FR9).\n                    squared_value = _square(element)\n                    # Sum these squared values (FR10).\n                    total_sum += squared_value\n        # Non-integers (FR5), negative or zero integers (FR7) are ignored by the conditional flow.\n\n    # Return the final calculated sum (FR11).\n    return total_sum\n```\n"}
