al_water_units / bucket_capacity)\n\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the minimum number of bucket lowering operations to empty a grid of wells.\n    This function orchestrates data modeling and business logic execution.\n    \"\"\"\n    # Input validation, as per design, would typically be here.\n    # However, critical requirements forbid adding validation checks or exceptions for edge cases.\n    # Thus, inputs are trusted to be valid according to the original problem constraints.\n\n    grid_obj = Grid(grid)\n    bucket_obj = Bucket(capacity)\n\n    extraction_process = WaterExtractionProcess(grid_obj, bucket_obj)\n    calculated_operations = extraction_process.calculate_lowering_operations()\n\n    return calculated_operations\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, return a list of words from s\n    that contain exactly n consonants, preserving their original order.\"\"\"\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is a consonant (alphabetic and not a vowel, case-insensitive).\"\"\"\n        char_lower = char.lower()\n        return char_lower.isalpha() and char_lower not in \"aeiou\"\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        for char in word:\n            if _is_consonant(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    selected_words = []\n    words = s.split()\n    for word in words:\n        if _count_consonants(word) == n:\n            selected_words.append(word)\n\n    return selected_words\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted non-decreasingly by right shifts.\n    Returns True if sorted or can be sorted, False otherwise.\n    \"\"\"\n\n    def _is_sorted_non_decreasing(sub_arr: list) -> bool:\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\n        Returns True for empty or single-element arrays.\n        \"\"\"\n        if not sub_arr or len(sub_arr) == 1:\n            return True\n        for i in range(len(sub_arr) - 1):\n            if sub_arr[i] > sub_arr[i+1]:\n                return False\n        return True\n\n    def _perform_right_shift(sub_arr: list) -> list:\n        \"\"\"Performs a right shift operation on a copy of the array.\n        The last element moves to the beginning.\n        \"\"\"\n        if not sub_arr:\n            return []\n\n        shifted_arr = sub_arr[:] # Create a copy to avoid modifying the original\n        if len(shifted_arr) <= 1:\n            return shifted_arr\n\n        last_element = shifted_arr.pop()\n        shifted_arr.insert(0, last_element)\n        return shifted_arr\n\n    # Handle Empty Array\n    if not arr:\n        return True\n\n    # Check Initial State\n    current_arr = arr[:] # Work with a copy to preserve original input 'arr'\n    if _is_sorted_non_decreasing(current_arr):\n        return True\n\n    # Iterate through possible right shifts (N-1 additional shifts for N elements)\n    num_elements = len(arr)\n    for _ in range(num_elements - 1):\n        current_arr = _perform_right_shift(current_arr)\n        if _is_sorted_non_decreasing(current_arr):\n            return True\n\n    # If no sorted configuration is found after all shifts\n    return False\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns words with exactly n consonants.\"\"\"\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    result_words = []\n    words = s.split()  # Split by any whitespace and handle multiple spaces\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_words.append(word)\n\n    return result_words\n```\n"}
