{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression by interleaving operands and operators.\n    It then evaluates this expression, adhering to standard mathematical precedence.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n    return result\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s: str) -> str:\n    \"\"\"Modifies a string by reversing letter cases or reversing the whole string if no letters are present.\n    Non-letter characters remain unchanged.\"\"\"\n    modified_chars = []\n    has_letters = False\n\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            if char.islower():\n                modified_chars.append(char.upper())\n            else:  # char is uppercase\n                modified_chars.append(char.lower())\n        else:  # char is not a letter\n            modified_chars.append(char)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        return \"\".join(modified_chars)\n```\n"}
{"task_id": "HumanEval/161", "solution": "```python\ndef _contains_letters(s: str) -> bool:\n    \"\"\"Checks if a string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\n\ndef _reverse_char_case(char: str) -> str:\n    \"\"\"Reverses the case of a single alphabetic character.\n    Assumes input 'char' is an alphabetic character.\"\"\"\n    if char.islower():\n        return char.upper()\n    else:\n        return char.lower()\n\ndef solve(s: str) -> str:\n    \"\"\"Processes an input string based on conditional logic.\n\n    If 's' contains at least one letter, reverses the case of letters\n    and keeps non-letters as is. Otherwise, reverses the entire string.\n    \"\"\"\n    if _contains_letters(s):\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(_reverse_char_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n\n    # Calculate the MD5 hash of the UTF-8 encoded string and return its hexadecimal representation.\n    return hashlib.md5(text.encode('utf-8')).hexdigest()\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits_list = []\n\n    for number in range(min_val, max_val + 1):\n        # Identify numbers that are both even and single digits (0-9).\n        if 0 <= number <= 9 and number % 2 == 0:\n            even_digits_list.append(number)\n\n    # Sort the collected digits in ascending order as per design.\n    even_digits_list.sort()\n\n    return even_digits_list\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"Calculates total eaten carrots and remaining stock after a meal.\n    Returns an array of [totalEaten, carrotsLeft].\"\"\"\n\n    total_eaten = 0\n    carrots_left = 0\n\n    if remaining >= need:\n        total_eaten = number + need\n        carrots_left = remaining - need\n    else: # remaining < need\n        total_eaten = number + remaining\n        carrots_left = 0\n\n    return [total_eaten, carrots_left]\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    result = []\n\n    # Iterate through possible single-digit even numbers (2, 4, 6, 8)\n    # 0 is excluded because a and b are positive integers.\n    for digit in [2, 4, 6, 8]:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    return result\n```"}
