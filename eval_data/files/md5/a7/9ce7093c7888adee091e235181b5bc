{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions, x and n, is a whole number.\n    x and n are strings in \"numerator/denominator\" format.\"\"\"\n\n    # Input Parsing for x\n    x_parts = x.split('/')\n    x_num = int(x_parts[0])\n    x_den = int(x_parts[1])\n\n    # Input Parsing for n\n    n_parts = n.split('/')\n    n_num = int(n_parts[0])\n    n_den = int(n_parts[1])\n\n    # Fraction Multiplication\n    product_num = x_num * n_num\n    product_den = x_den * n_den\n\n    # Whole Number Check and Return Value\n    return product_num % product_den == 0\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of an integer. Returns 0 for 0.\"\"\"\n    s = 0\n    n = abs(n)\n    while n > 0:\n        s += n % 10\n        n //= 10\n    return s\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers primarily by sum of digits, secondarily by original index.\"\"\"\n    if not nums:\n        return []\n\n    # Create tuples: (sum_of_digits, original_index, original_number) for sorting.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        sum_of_digits = _sum_digits(num)\n        decorated_list.append((sum_of_digits, i, num))\n\n    # Sort the list of tuples; Python's default tuple sorting handles the criteria.\n    sorted_decorated_list = sorted(decorated_list)\n\n    # Extract the original numbers from the sorted tuples.\n    result = [item[2] for item in sorted_decorated_list]\n\n    return result\n```"}
{"task_id": "HumanEval/146", "solution": "def _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number.\n    Handles negative numbers by taking the absolute value first.\"\"\"\n    return int(str(abs(num))[0])\n\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number.\n    Handles negative numbers by taking the absolute value.\"\"\"\n    return abs(num) % 10\n\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return digit % 2 != 0\n\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Counts numbers greater than 10 with odd first and last digits.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            if _is_odd(first_digit):\n                last_digit = _get_last_digit(num)\n                if _is_odd(last_digit):\n                    count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "```python\ndef _calculate_sum_of_digits(num: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of a given integer.\n    It converts the absolute number to a string and sums its digits.\"\"\"\n    s = str(abs(num))\n    digit_sum = 0\n    for digit_char in s:\n        digit_sum += int(digit_char)\n    return digit_sum\n\nclass _SortableInteger:\n    \"\"\"Encapsulates an integer's value, original index, and pre-calculated sum of digits for sorting.\n    It defines the custom comparison logic using __lt__.\"\"\"\n    def __init__(self, value: int, original_index: int):\n        self.value = value\n        self.original_index = original_index\n        self.sum_of_digits = _calculate_sum_of_digits(value)\n\n    def __lt__(self, other: '_SortableInteger') -> bool:\n        \"\"\"Compares two _SortableInteger objects.\n        Primary sort is by sum_of_digits (ascending), secondary by original_index (ascending).\"\"\"\n        if self.sum_of_digits != other.sum_of_digits:\n            return self.sum_of_digits < other.sum_of_digits\n        return self.original_index < other.original_index\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers according to the sum of their digits and original index.\n    It transforms integers into sortable objects, sorts them, and extracts the original values.\"\"\"\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        sortable_items.append(_SortableInteger(num, i))\n\n    sortable_items.sort()\n\n    return [item.value for item in sortable_items]\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n        return abs(num) % 10\n\n    def _is_greater_than_ten(num: int) -> bool:\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _is_first_digit_odd(num: int) -> bool:\n        \"\"\"Checks if the first digit of a number is odd.\"\"\"\n        first_digit = _get_first_digit(num)\n        return _is_odd(first_digit)\n\n    def _is_last_digit_odd(num: int) -> bool:\n        \"\"\"Checks if the last digit of a number is odd.\"\"\"\n        last_digit = _get_last_digit(num)\n        return _is_odd(last_digit)\n\n    def _meets_all_criteria(num: int) -> bool:\n        \"\"\"Combines all filtering conditions to determine if a number is 'special'.\"\"\"\n        return _is_greater_than_ten(num) and \\\n               _is_first_digit_odd(num) and \\\n               _is_last_digit_odd(num)\n\n    count = 0\n    for num in nums:\n        if _meets_all_criteria(num):\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef _generate_array_a(n: int) -> list[int]:\n    \"\"\"\n    Creates and populates the integer array a using the given formula.\n    It generates values for conceptual indices from 1 to n.\n    \"\"\"\n    array_a = []\n    for i in range(1, n + 1):\n        value = i * i - i + 1\n        array_a.append(value)\n    return array_a\n\ndef _is_sum_multiple_of_3(val1: int, val2: int, val3: int) -> bool:\n    \"\"\"\n    Calculates the sum of three values and checks if the sum is a multiple of 3.\n    Returns True if the sum is divisible by 3, False otherwise.\n    \"\"\"\n    total_sum = val1 + val2 + val3\n    return total_sum % 3 == 0\n\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) such that i < j < k\n    and their sum a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    array_a = _generate_array_a(n)\n    count = 0\n\n    # Iterate through all unique triples (a[i], a[j], a[k]) where i < j < k\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if _is_sum_multiple_of_3(array_a[i], array_a[j], array_a[k]):\n                    count += 1\n    return count\n```\n"}
