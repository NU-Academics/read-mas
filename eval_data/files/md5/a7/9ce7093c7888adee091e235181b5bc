{"task_id": "HumanEval/75", "solution": "```python\nimport math\n\ndef is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime. Handles base cases and iterates for odd divisors.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef get_prime_factors(number: int) -> list[int]:\n    \"\"\"Returns a list of prime factors for a given number, checking primality of each potential factor as per design.\"\"\"\n    factors = []\n\n    # Handle factor 2\n    while number % 2 == 0:\n        factors.append(2)\n        number //= 2\n\n    # Handle odd factors starting from 3\n    i = 3\n    while i * i <= number:\n        # As specified in the design, explicitly check if 'i' is prime\n        if is_prime(i):\n            while number % i == 0:\n                factors.append(i)\n                number //= i\n        i += 2\n\n    # If the remaining number is greater than 1, it must be a prime factor\n    if number > 1:\n        # As specified in the design, explicitly check if the remaining 'number' is prime\n        if is_prime(number):\n            factors.append(number)\n\n    return factors\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Returns true if 'a' is the product of exactly three prime numbers, false otherwise.\n    Input 'a' must be less than 100.\"\"\"\n    # Validate input 'a' against the constraint 1 < a < 100\n    if a <= 1 or a >= 100:\n        return False\n\n    prime_factors = get_prime_factors(a)\n\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/75", "solution": "def is_prime(n):\n    \"\"\"Checks if an integer is a prime number.\n    Optimizes checks up to the square root of n.\"\"\"\n    if n <= 1:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\n# Pre-compute primes less than 100 as per design.\n_PRECOMPUTED_PRIMES = [n for n in range(2, 100) if is_prime(n)]\n\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 30:  # Smallest product of three primes is 2 * 3 * 5 = 30.\n        return False\n\n    # Iterate through precomputed primes allowing repeated factors.\n    for i, p1 in enumerate(_PRECOMPUTED_PRIMES):\n        for j, p2 in enumerate(_PRECOMPUTED_PRIMES[i:], i): # Start p2 from p1's index\n            for k, p3 in enumerate(_PRECOMPUTED_PRIMES[j:], j): # Start p3 from p2's index\n                product = p1 * p2 * p3\n\n                if product == a:\n                    return True\n                if product > a: # Optimization: break if product exceeds 'a'.\n                    break\n    return False"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root of the absolute value of 'a'.\n    # Using round() helps mitigate floating-point inaccuracies for exact cubes.\n    root_candidate = int(round(abs(a)**(1/3)))\n\n    # If the original number 'a' was negative, its cube root must also be negative.\n    if a < 0:\n        root_candidate = -root_candidate\n\n    # Check if the cube of the candidate root equals 'a'.\n    return root_candidate * root_candidate * root_candidate == a\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q,w):\n    '''\n    Determines if an object q will fly based on two conditions: being a palindrome and its sum being <= w.\n    Returns True if both conditions are met, False otherwise.\n    '''\n    is_palindrome = (q == q[::-1])\n    sum_elements = sum(q)\n    return is_palindrome and (sum_elements <= w)\n```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the minimum changes needed to make an array palindromic.\n    Compares elements from both ends and counts mismatches.\n    \"\"\"\n    changes = 0\n    n = len(arr)\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes\n```"}
{"task_id": "HumanEval/76", "solution": "```python\nimport math\n\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if x can be expressed as n raised to an integer power (n**k = x).\n    This handles various numerical inputs including positive, negative, and zero.\n    \"\"\"\n    if n == 1:\n        return x == 1\n\n    if n == 0:\n        return x == 0 or x == 1\n\n    if x == 1:\n        return True\n\n    # Handle cases where n > 0\n    if n > 0:\n        if x <= 0:\n            return False # Positive base to any integer power cannot yield zero or negative x\n\n        # Both x > 0 and n > 0. Use logarithms to find k.\n        try:\n            k = math.log(x) / math.log(n)\n            # Check if k is an integer within floating-point tolerance.\n            return math.isclose(k, round(k), rel_tol=1e-09, abs_tol=1e-12)\n        except (ValueError, ZeroDivisionError):\n            return False # Logarithm issues (e.g., log of non-positive, division by log(1))\n\n    # Handle cases where n < 0\n    if n < 0:\n        if x == 0:\n            return False # Negative base to any integer power cannot yield zero\n\n        abs_x = abs(x)\n        abs_n = abs(n)\n\n        # For n = -1, check if x is -1. (x=1 already handled by global x=1 check)\n        if abs_n == 1: # This means n is -1\n            return x == -1\n\n        # Use logarithms on absolute values to find k_abs such that abs(n)**k_abs = abs(x).\n        try:\n            k_abs = math.log(abs_x) / math.log(abs_n)\n            if math.isclose(k_abs, round(k_abs), rel_tol=1e-09, abs_tol=1e-12):\n                integer_k = round(k_abs)\n                # Check parity of the exponent based on signs of x and n.\n                if integer_k % 2 == 0: # Even power: result must be positive\n                    return x > 0\n                else: # Odd power: result must be negative\n                    return x < 0\n            else:\n                return False\n        except (ValueError, ZeroDivisionError):\\\n            return False\n\n    return False # Should not be reached if all cases are covered, but as a fallback.\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a: int) -> bool:\n    \"\"\"Determines if the input integer 'a' is a perfect cube.\n    Handles positive, negative, and zero integers correctly.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the absolute value of a, take its cube root, and round it.\n    # This gives the potential integer cube root in absolute terms.\n    potential_root_abs = round(abs(a)**(1/3))\n\n    # Reconstruct the potential root with its original sign.\n    reconstructed_root = potential_root_abs if a > 0 else -potential_root_abs\n\n    # Check if the cube of this reconstructed root equals the original 'a'.\n    return reconstructed_root**3 == a\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k == x for non-negative integer k).\n    This function handles various edge cases for x and n as specified in the design.\n    \"\"\"\n    if x == 1:\n        return True\n    if x == 0:\n        return n == 0\n    if x < 0:\n        return False\n    if n <= 1: # Covers n=0 and n=1 when x > 1\n        return False\n\n    # Main logic for x > 1 and n > 1\n    while x % n == 0:\n        x //= n\n    return x == 1\n```"}
