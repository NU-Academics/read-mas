{"task_id": "HumanEval/41", "solution": "class CollisionResult:\n    \"\"\"Encapsulates computed total collisions.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\nclass InputValidator:\n    \"\"\"Responsible for validating input n per requirements.\"\"\"\n    @staticmethod\n    def validate_n(n) -> bool:\n        \"\"\"Returns True if n is a non-negative integer, else False.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n# Module-level alias to InputValidator.validate_n as per design\nvalidate_n = InputValidator.validate_n\n\nclass CollisionCalculator:\n    \"\"\"Coordinates validation and computes total collisions.\"\"\"\n    def car_race_collision(self, n: int) -> int:\n        if not validate_n(n):\n            raise ValueError(\"Invalid input: n must be a non-negative integer\")\n        \n        total = n * n\n        # CollisionResult(total) # Optional construction for traceability as per design\n        return total\n\ndef car_race_collision(n: int):\n    \"\"\"\n    Outputs the number of collisions between two sets of n cars moving in opposite directions.\n    This function acts as the public API entrypoint.\n    \"\"\"\n    return CollisionCalculator().car_race_collision(n)"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(h, (int, float)):\n        raise TypeError(\"a and h must be numeric (int or float)\")\n    \n    return 0.5 * a * h"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\n    Base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    DIGITS = '0123456789'\n\n    # Validate inputs as per design\n    if not isinstance(x, int):\n        raise ValueError(\"Input 'x' must be an integer.\")\n    if not isinstance(base, int):\n        raise ValueError(\"Input 'base' must be an integer.\")\n    if base >= 10:\n        raise ValueError(\"Base must be less than 10.\")\n\n    # Handle the special case for x = 0\n    if x == 0:\n        return '0'\n\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = abs(x) # Convert absolute value; handle sign later\n\n    result_digits = []\n    while x > 0:\n        remainder = x % base\n        result_digits.append(DIGITS[remainder])\n        x //= base\n    \n    # The digits are collected in reverse order, so reverse them to get the correct representation.\n    result_str = ''.join(reversed(result_digits))\n    \n    if is_negative:\n        return '-' + result_str\n    else:\n        return result_str"}
{"task_id": "HumanEval/43", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    elements: list[int]\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass Element:\n    value: int\n    index: int\n\n@dataclass\nclass Pair:\n    a: Element\n    b: Element\n\n    def sum(self) -> int:\n        return self.a.value + self.b.value\n\n@dataclass\nclass Result:\n    value: bool\n\nclass PairsSumToZero:\n    \"\"\"\n    Evaluates an InputList for zero-sum pairs, ensuring distinct indices.\n    \"\"\"\n    def evaluate(self, input_list: InputList) -> Result:\n        n = len(input_list.elements)\n        for i in range(n):\n            for j in range(i + 1, n): # Iterate through distinct pairs (i != j)\n                if input_list.elements[i] + input_list.elements[j] == 0:\n                    return Result(True)\n        return Result(False)\n\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    input_list = InputList(elements=l)\n    evaluator = PairsSumToZero()\n    result = evaluator.evaluate(input_list)\n    return result.value"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    if n % 2 == 1:\n        # Odd number of elements, return the middle element\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements, return the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/46", "solution": "class InputParameter:\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass Result:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass SequenceState:\n    def __init__(self, a: int, b: int, c: int, d: int) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n        self.d = d\n\n    def advance(self) -> None:\n        next_fib = self.a + self.b + self.c + self.d\n        self.d = self.c\n        self.c = self.b\n        self.b = self.a\n        self.a = next_fib\n\nclass Fib4Calculator:\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 0\n        if n == 1:\n            return 0\n        if n == 2:\n            return 2\n        if n == 3:\n            return 0\n\n        # Initialize the state representing (fib4(3), fib4(2), fib4(1), fib4(0))\n        # a = fib4(3) = 0\n        # b = fib4(2) = 2\n        # c = fib4(1) = 0\n        # d = fib4(0) = 0\n        state = SequenceState(0, 2, 0, 0)\n\n        # Iterate from the 4th element up to the desired n-th element\n        for _ in range(4, n + 1):\n            state.advance()\n\n        return state.a\n\ndef fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    calculator = Fib4Calculator()\n    return calculator.compute(n)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
