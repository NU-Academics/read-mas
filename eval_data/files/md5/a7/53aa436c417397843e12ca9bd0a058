{"task_id": "HumanEval/121", "solution": "from typing import List\n\nclass Element:\n    \"\"\"Represents an element with its index and value.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return (self.value % 2 != 0)\n\n    def isAtEvenPosition(self) -> bool:\n        \"\"\"Checks if the element's index is an even position (zero-based).\"\"\"\n        return (self.index % 2 == 0)\n\nclass InputList:\n    \"\"\"Manages a list of Element objects and performs input validations.\"\"\"\n    def __init__(self, raw_list: list) -> None:\n        self.elements: List[Element] = [Element(i, value) for i, value in enumerate(raw_list)]\n        self.length: int = len(self.elements)\n\n    def validateNonEmpty(self) -> None:\n        \"\"\"Raises ValueError if the list is empty.\"\"\"\n        if self.length == 0:\n            raise ValueError(\"Input list cannot be empty.\")\n\n    def validateAllIntegers(self) -> None:\n        \"\"\"Raises ValueError if any element's value is not an integer.\"\"\"\n        for element in self.elements:\n            if not isinstance(element.value, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n\nclass Result:\n    \"\"\"Calculates and stores the sum of qualifying elements.\"\"\"\n    def __init__(self) -> None:\n        self.sum: int = 0\n\n    def generate(self, input_list: InputList) -> int:\n        \"\"\"Computes the sum of odd elements at even positions from the input list.\"\"\"\n        for element in input_list.elements:\n            if element.isAtEvenPosition() and element.isOdd():\n                self.sum += element.value\n        return self.sum\n\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    Raises ValueError for empty input or non-integer elements.\n    \"\"\"\n    il = InputList(lst)\n    il.validateNonEmpty()\n    il.validateAllIntegers()\n    res = Result()\n    return res.generate(il)"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    def _contains_whitespace(text: str) -> bool:\n        \"\"\"Detects if the text contains any whitespace characters.\"\"\"\n        for char in text:\n            if char.isspace():\n                return True\n        return False\n\n    def _contains_comma(text: str) -> bool:\n        \"\"\"Detects if the text contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _split_on_whitespace(text: str) -> list[str]:\n        \"\"\"Splits the text on whitespace characters.\"\"\"\n        return text.split()\n\n    def _split_on_commas(text: str) -> list[str]:\n        \"\"\"Splits the text on comma characters.\"\"\"\n        return text.split(',')\n\n    def _count_odd_lowercase(text: str) -> int:\n        \"\"\"Counts lowercase ASCII letters with odd zero-based alphabetical order.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                index = ord(char) - ord('a')\n                if index % 2 == 1:\n                    count += 1\n        return count\n\n    if _contains_whitespace(txt):\n        return _split_on_whitespace(txt)\n    elif _contains_comma(txt):\n        return _split_on_commas(txt)\n    else:\n        return _count_odd_lowercase(txt)"}
{"task_id": "HumanEval/123", "solution": "from typing import List\n\n# Module-level constant for the maximum number of iterations to prevent infinite loops.\nMAX_ITERATIONS = 1000\n\nclass Input:\n    \"\"\"\n    Represents and validates the input integer n.\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"\n        Returns True if n is a positive integer, False otherwise.\n        \"\"\"\n        return isinstance(self.n, int) and self.n > 0\n\nclass CollatzTerm:\n    \"\"\"\n    Represents a single term in the Collatz sequence with its value and position.\n    \"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the term's value is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the term's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass CollatzSequence:\n    \"\"\"\n    Holds an ordered list of CollatzTerm objects.\n    \"\"\"\n    def __init__(self):\n        self.terms: List[CollatzTerm] = []\n\n    def append(self, term: CollatzTerm) -> None:\n        \"\"\"Appends a CollatzTerm to the sequence.\"\"\"\n        self.terms.append(term)\n\nclass OddNumberCollection:\n    \"\"\"\n    Collects odd integers and provides sorting functionality.\n    \"\"\"\n    def __init__(self):\n        self.odds: List[int] = []\n\n    def add(self, v: int) -> None:\n        \"\"\"Adds an odd integer to the collection.\"\"\"\n        self.odds.append(v)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected odd numbers in increasing order.\"\"\"\n        self.odds.sort()\n\nclass Result:\n    \"\"\"\n    Wraps the sorted list of odd numbers for return.\n    \"\"\"\n    def __init__(self, sorted_odds: List[int]):\n        self.sorted_odds = sorted_odds\n\n    def toList(self) -> List[int]:\n        \"\"\"Returns the wrapped list of sorted odd numbers.\"\"\"\n        return self.sorted_odds\n\nclass CollatzCalculator:\n    \"\"\"\n    Orchestrates Collatz sequence generation, odd-value collection, and returns sorted odds.\n    \"\"\"\n    def __init__(self, max_iterations: int = MAX_ITERATIONS):\n        self._max_iterations = max_iterations\n\n    def generateSequence(self, n: int) -> List[int]:\n        \"\"\"\n        Generates the Collatz sequence from n until 1, returning a list of integers.\n        Raises RuntimeError if max iterations are exceeded.\n        \"\"\"\n        current_value = n\n        collatz_sequence_obj = CollatzSequence()\n        iterations = 0\n        position = 0\n\n        while current_value != 1:\n            if iterations >= self._max_iterations:\n                raise RuntimeError(\"max iterations exceeded\")\n\n            collatz_sequence_obj.append(CollatzTerm(current_value, position))\n\n            if current_value % 2 == 0:\n                current_value //= 2\n            else:\n                current_value = 3 * current_value + 1\n            \n            iterations += 1\n            position += 1\n        \n        collatz_sequence_obj.append(CollatzTerm(1, position)) # Add the terminal 1\n        \n        return [term.value for term in collatz_sequence_obj.terms]\n\n    def collectOdds(self, sequence: List[int]) -> List[int]:\n        \"\"\"\n        Returns a list of odd integers found in the given sequence.\n        \"\"\"\n        odd_numbers = []\n        for num in sequence:\n            if num % 2 != 0:\n                odd_numbers.append(num)\n        return odd_numbers\n\n    def getSortedOdds(self, n: int) -> List[int]:\n        \"\"\"\n        Generates the Collatz sequence for n, collects odd numbers, and returns them sorted.\n        \"\"\"\n        if n == 1:\n            return [1]\n\n        sequence_values = self.generateSequence(n)\n        \n        raw_odds = self.collectOdds(sequence_values)\n        \n        odd_collection = OddNumberCollection()\n        for odd_val in raw_odds:\n            odd_collection.add(odd_val)\n        \n        odd_collection.sortAscending()\n        \n        result_wrapper = Result(odd_collection.odds)\n        return result_wrapper.toList()\n\ndef get_odd_collatz(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    input_obj = Input(n)\n    if not input_obj.validate():\n        raise ValueError(\"input must be a positive integer\")\n\n    calculator = CollatzCalculator()\n    return calculator.getSortedOdds(n)"}
{"task_id": "HumanEval/122", "solution": "class Array:\n    \"\"\"Represents an array of integers and provides methods to access its elements.\"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def getFirstK(self, k: int) -> list[int]:\n        \"\"\"Returns the first k elements of the array.\"\"\"\n        return list(self.elements[:k])\n\nclass Element:\n    \"\"\"Represents an integer element and checks if it has at most two digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isTwoDigit(self) -> bool:\n        \"\"\"Returns True if the absolute value of the element is at most 99.\"\"\"\n        return abs(self.value) <= 99\n\nclass Validator:\n    \"\"\"Validates the input array length and the integer k.\"\"\"\n    def validateArrLength(self, arr: list[int]) -> bool:\n        \"\"\"Checks if the array length is between 1 and 100, inclusive.\"\"\"\n        return 1 <= len(arr) <= 100\n\n    def validateK(self, arr: list[int], k: int) -> bool:\n        \"\"\"Checks if k is between 1 and the length of the array, inclusive.\"\"\"\n        return 1 <= k <= len(arr)\n\nclass SumCalculator:\n    \"\"\"Calculates the sum of elements with at most two digits.\"\"\"\n    def sumTwoDigitElements(self, elements: list[int]) -> int:\n        \"\"\"Filters elements by the two-digit criterion and returns their sum.\"\"\"\n        total_sum = 0\n        for value in elements:\n            if abs(value) <= 99:\n                total_sum += value\n        return total_sum\n\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    v = Validator()\n    if not v.validateArrLength(arr):\n        raise ValueError(\"arr length outside [1,100]\")\n    if not v.validateK(arr, k):\n        raise ValueError(\"k must satisfy 1 <= k <= len(arr)\")\n\n    a = Array(arr)\n    first_k = a.getFirstK(k)\n\n    sc = SumCalculator()\n    return sc.sumTwoDigitElements(first_k)"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    # 1. The date string is not empty.\n    if not date:\n        return False\n\n    # 2. Check exact length (10 for mm-dd-yyyy) and fixed separator positions (2 and 5).\n    if len(date) != 10:\n        return False\n    if date[2] != '-' or date[5] != '-':\n        return False\n\n    # Extract substrings for month, day, year.\n    # Parse to integers, handling potential ValueError for non-numeric or malformed parts.\n    try:\n        month_str = date[0:2]\n        day_str = date[3:5]\n        year_str = date[6:10]\n\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # Year is parsed but not used for validation rules here.\n    except ValueError:\n        return False\n\n    # 3. Validate month range (1 <= month <= 12).\n    if not (1 <= month <= 12):\n        return False\n\n    # 2. Validate day lower bound (day >= 1).\n    if day < 1:\n        return False\n\n    # Determine month-specific max days. February is fixed at 29 days.\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    # 2. Validate day upper bound (day <= max_days for the specific month).\n    max_days = days_in_month.get(month)\n    if max_days is None or day > max_days:\n        return False\n\n    # If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/126", "solution": "import collections\nfrom typing import List, Dict\n\nclass OrderChecker:\n    '''\n    Verifies if a list of numbers is in non-decreasing order.\n    '''\n    def isNonDecreasing(self, items: List[int]) -> bool:\n        if len(items) <= 1:\n            return True\n        for i in range(len(items) - 1):\n            if items[i] > items[i+1]:\n                return False\n        return True\n\nclass DuplicateChecker:\n    '''\n    Checks for duplicate violations where a number appears more than maxAllowed times.\n    '''\n    maxAllowed: int = 2\n\n    def countOccurrences(self, items: List[int]) -> Dict[int, int]:\n        return collections.Counter(items)\n\n    def hasViolation(self, items: List[int]) -> bool:\n        counts = self.countOccurrences(items)\n        for count in counts.values():\n            if count > self.maxAllowed:\n                return True\n        return False\n\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    order_checker = OrderChecker()\n    duplicate_checker = DuplicateChecker()\n\n    order_ok = order_checker.isNonDecreasing(lst)\n    dup_violation = duplicate_checker.hasViolation(lst)\n\n    return order_ok and not dup_violation"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a non-negative integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    overlap_start = max(start1, start2)\n    overlap_end = min(end1, end2)\n\n    # If overlap_start > overlap_end, the intervals do not intersect.\n    if overlap_start > overlap_end:\n        return \"NO\"\n\n    overlap_length = overlap_end - overlap_start\n\n    if is_prime(overlap_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "import enum\nfrom typing import Optional, Iterator\n\nclass Sign(enum.Enum):\n    \"\"\"Represents the sign of a number.\"\"\"\n    POSITIVE = 1\n    NEGATIVE = -1\n    ZERO = 0\n\nclass ArrayElement:\n    \"\"\"Encapsulates an integer array element with sign and magnitude properties.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_sign(self) -> int:\n        \"\"\"Returns 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if self._value > 0:\n            return Sign.POSITIVE.value\n        elif self._value < 0:\n            return Sign.NEGATIVE.value\n        else:\n            return Sign.ZERO.value\n\n    def get_magnitude(self) -> int:\n        \"\"\"Returns the absolute value (magnitude) of the element.\"\"\"\n        return abs(self._value)\n\nclass IntegerArray:\n    \"\"\"A collection of ArrayElement objects.\"\"\"\n    def __init__(self, arr: list[int]):\n        self._elements = [ArrayElement(val) for val in arr]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def __iter__(self) -> Iterator[ArrayElement]:\n        \"\"\"Allows iteration over the ArrayElement objects.\"\"\"\n        return iter(self._elements)\n\nclass CalculationResult:\n    \"\"\"Wraps the final calculation result, which can be an integer or None.\"\"\"\n    def __init__(self, value: Optional[int]):\n        self._value = value\n\n    def get_value(self) -> Optional[int]:\n        \"\"\"Retrieves the stored calculation result.\"\"\"\n        return self._value\n\nclass ProdSignsFunction:\n    \"\"\"Orchestrates the calculation of product of signs and sum of magnitudes.\"\"\"\n    def prod_signs(self, arr: list[int]) -> Optional[int]:\n        \"\"\"\n        Calculates the sum of magnitudes multiplied by the product of signs.\n        Returns None for an empty input array.\n        \"\"\"\n        integer_array = IntegerArray(arr)\n\n        if len(integer_array) == 0:\n            return CalculationResult(None).get_value()\n\n        product_of_signs = 1\n        sum_of_magnitudes = 0\n\n        for element in integer_array:\n            sign = element.get_sign()\n            if sign == Sign.ZERO.value:\n                product_of_signs = 0\n                break \n            product_of_signs *= sign\n            sum_of_magnitudes += element.get_magnitude()\n        \n        return CalculationResult(product_of_signs * sum_of_magnitudes).get_value()\n\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    orchestrator = ProdSignsFunction()\n    return orchestrator.prod_signs(arr)"}
{"task_id": "HumanEval/131", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Represents a single decimal digit and provides oddness check.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Return True when value is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass Number:\n    \"\"\"Represent the input integer and provide access to its base-10 digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def getDigits(self) -> List[Digit]:\n        \"\"\"Parse Number.value into a list of Digit instances.\"\"\"\n        digits_list = []\n        for char_digit in str(self.value):\n            digits_list.append(Digit(int(char_digit)))\n        return digits_list\n\nclass Result:\n    \"\"\"Hold the computed integer result produced by processing.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass DigitsProcessor:\n    \"\"\"Executes use cases to filter odd digits and compute their product.\"\"\"\n    def productOfOddDigits(self, number: Number) -> int:\n        \"\"\"Return product of odd digits in number; return 0 if none.\"\"\"\n        all_digits = number.getDigits()\n        odd_digits = [d for d in all_digits if d.isOdd()]\n\n        if not odd_digits:\n            return 0\n\n        product = 1\n        for digit_obj in odd_digits:\n            product *= digit_obj.value\n        return product\n\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    number = Number(n)\n    processor = DigitsProcessor()\n    return processor.productOfOddDigits(number)"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Iterator, Optional\n\nclass ValidationError(Exception):\n    \"\"\"Concrete exception for validation failures.\"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        super().__init__(message)\n        self.code = code\n        self.message = message\n\nclass Cell:\n    \"\"\"Represents a single cell (row, col, value) and computes orthogonal neighbors.\"\"\"\n    def __init__(self, row: int, col: int, value: int, _grid_ref: 'Grid') -> None:\n        self.row = row\n        self.col = col\n        self.value = value\n        self._grid_ref = _grid_ref\n\n    def neighbors(self) -> List['Cell']:\n        \"\"\"Returns orthogonal neighbors within grid bounds in a deterministic order (up, down, left, right).\"\"\"\n        N = self._grid_ref.N\n        neighbors_list = []\n        # Define potential moves: (dr, dc) for (up, down, left, right)\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in moves:\n            n_row, n_col = self.row + dr, self.col + dc\n            if 0 <= n_row < N and 0 <= n_col < N:\n                neighbors_list.append(self._grid_ref.getCell(n_row, n_col))\n        return neighbors_list\n\nclass Grid:\n    \"\"\"Represents the N x N grid and provides access to cells.\"\"\"\n    def __init__(self, values: List[List[int]]) -> None:\n        self.values = values\n        self.N = len(values)\n\n    def getCell(self, r: int, c: int) -> Cell:\n        \"\"\"Returns a Cell object for the given row and column.\"\"\"\n        return Cell(r, c, self.values[r][c], self)\n\n    def getAllCells(self) -> List[Cell]:\n        \"\"\"Returns all cells in deterministic row-major order.\"\"\"\n        all_cells = []\n        for r in range(self.N):\n            for c in range(self.N):\n                all_cells.append(self.getCell(r, c))\n        return all_cells\n\nclass Path:\n    \"\"\"Represents an ordered sequence of visited Cells.\"\"\"\n    def __init__(self, cells: Optional[List[Cell]] = None) -> None:\n        self.cells = list(cells) if cells is not None else []\n\n    def append(self, cell: Cell) -> None:\n        \"\"\"Appends a cell to the path.\"\"\"\n        self.cells.append(cell)\n\n    def values(self) -> List[int]:\n        \"\"\"Returns an ordered list of values of cells in the path.\"\"\"\n        return [cell.value for cell in self.cells]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the path (number of cells visited).\"\"\"\n        return len(self.cells)\n\nclass Validator:\n    \"\"\"Validates grid shape, value set, and k parameter.\"\"\"\n    def validateGridShape(self, grid: List[List[int]]) -> None:\n        \"\"\"Validates that the grid is a square N x N matrix with N >= 2.\"\"\"\n        if not isinstance(grid, list) or not grid:\n            raise ValidationError(\"INVALID_SHAPE\", \"Grid must be a non-empty list of lists.\")\n        \n        N = len(grid)\n        if N < 2:\n            raise ValidationError(\"INVALID_SHAPE\", \"Grid must have at least 2 rows (N >= 2).\")\n        \n        for row in grid:\n            if not isinstance(row, list) or len(row) != N:\n                raise ValidationError(\"INVALID_SHAPE\", \"Grid must be square (N x N).\")\n            for val in row:\n                if not isinstance(val, int):\n                    raise ValidationError(\"INVALID_SHAPE\", \"Grid values must be integers.\")\n\n    def validateValueSet(self, grid: List[List[int]]) -> None:\n        \"\"\"Validates that all integers from 1 to N*N appear exactly once in the grid.\"\"\"\n        N = len(grid)\n        expected_size = N * N\n        \n        flattened_values = []\n        for row in grid:\n            flattened_values.extend(row)\n        \n        if len(flattened_values) != expected_size:\n            raise ValidationError(\"INVALID_VALUES\", f\"Expected {expected_size} values, got {len(flattened_values)}.\")\n            \n        unique_values = set(flattened_values)\n        if len(unique_values) != expected_size:\n            raise ValidationError(\"INVALID_VALUES\", \"Grid contains duplicate or missing values.\")\n            \n        expected_set = set(range(1, expected_size + 1))\n        if unique_values != expected_set:\n            raise ValidationError(\"INVALID_VALUES\", \"Grid must contain exactly integers from 1 to N*N.\")\n\n    def validateK(self, k: int) -> None:\n        \"\"\"Validates that k is a positive integer (k >= 1).\"\"\"\n        if not isinstance(k, int) or k < 1:\n            raise ValidationError(\"INVALID_K\", \"k must be a positive integer (k >= 1).\")\n\nclass MinPathService:\n    \"\"\"Computes the lexicographically minimal path of length k.\"\"\"\n\n    def findMinPath(self, grid_obj: Grid, k: int) -> List[int]:\n        \"\"\"Finds the lexicographically minimal path of length k in the grid.\"\"\"\n        min_path_values: Optional[List[int]] = None\n\n        for start_cell in grid_obj.getAllCells():\n            for path in self._generatePaths(start_cell, k):\n                current_path_values = path.values()\n                if min_path_values is None:\n                    min_path_values = current_path_values\n                else:\n                    if current_path_values < min_path_values:\n                        min_path_values = current_path_values\n        \n        return min_path_values\n\n    def _generatePaths(self, start_cell: Cell, k: int) -> Iterator[Path]:\n        \"\"\"Generates all paths of length k starting from start_cell using a recursive DFS.\"\"\"\n        path_cells_stack: List[Cell] = []\n\n        def _dfs_recursive_helper(current_cell: Cell):\n            path_cells_stack.append(current_cell)\n\n            if len(path_cells_stack) == k:\n                yield Path(list(path_cells_stack))\n            elif len(path_cells_stack) < k:\n                for neighbor in current_cell.neighbors():\n                    yield from _dfs_recursive_helper(neighbor)\n            \n            path_cells_stack.pop()\n        \n        yield from _dfs_recursive_helper(start_cell)\n\n    def _comparePathsLexicographically(self, a: Path, b: Path) -> int:\n        \"\"\"Compares two paths lexicographically by their values.\"\"\"\n        values_a = a.values()\n        values_b = b.values()\n\n        if values_a < values_b:\n            return -1\n        elif values_a > values_b:\n            return 1\n        else:\n            return 0\n\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns and a positive integer k, \n    find the minimum path of length k in the grid.\n    \"\"\"\n    validator = Validator()\n    validator.validateGridShape(grid)\n    validator.validateValueSet(grid)\n    validator.validateK(k)\n    \n    grid_obj = Grid(grid)\n    svc = MinPathService()\n    \n    return svc.findMinPath(grid_obj, k)"}
{"task_id": "HumanEval/130", "solution": "from typing import List, Dict\n\nclass SequenceResult:\n    \"\"\"Container for computed sequence terms.\"\"\"\n    def __init__(self, terms: List[int]):\n        self.terms = terms\n        self.length = len(terms)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the list of sequence terms.\"\"\"\n        return self.terms\n\nclass Validator:\n    \"\"\"Validates input n for the Tribonacci sequence calculation.\"\"\"\n    def validate(self, n) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass TribonacciCalculator:\n    \"\"\"Core computation for the Tribonacci sequence.\"\"\"\n    def __init__(self):\n        # Memoization dictionary to store computed terms.\n        self.memo: Dict[int, int] = {}\n\n    def computeEven(self, k: int) -> int:\n        \"\"\"Computes a Tribonacci term for an even index k.\"\"\"\n        return 1 + (k // 2)\n\n    def computeOdd(self, k: int) -> int:\n        \"\"\"Computes a Tribonacci term for an odd index k using previously calculated terms.\"\"\"\n        # Assumes dependencies memo[k-1], memo[k-2], memo[k+1] are already populated.\n        return self.memo[k-1] + self.memo[k-2] + self.memo[k+1]\n\n    def compute(self, n: int) -> SequenceResult:\n        \"\"\"Computes Tribonacci sequence terms from 0 up to n.\"\"\"\n        # Initialize memo with base cases as defined by the problem.\n        self.memo[0] = 1\n        self.memo[1] = 3\n\n        # Compute terms from index 2 up to n.\n        for i in range(2, n + 1):\n            if i % 2 == 0:  # If i is even, apply the even rule.\n                self.memo[i] = self.computeEven(i)\n            else:  # If i is odd, apply the odd rule after ensuring dependencies are met.\n                # For an odd term tri(i), tri(i+1) (which is even) is a dependency.\n                # Compute tri(i+1) if it's not already in memo. This handles n being odd.\n                if (i + 1) not in self.memo:\n                    self.memo[i+1] = self.computeEven(i+1)\n                self.memo[i] = self.computeOdd(i)\n        \n        # Collect the computed terms for the requested range [0, n].\n        result_terms = [self.memo[i] for i in range(n + 1)]\n        return SequenceResult(result_terms)\n\n\ndef tri(n):\n    \"\"\"\n    Returns a list of the first n + 1 numbers of the Tribonacci sequence.\n    \"\"\"\n    v = Validator()\n    if not v.validate(n):\n        raise ValueError(\"Invalid input: n must be an integer >= 0\")\n\n    calc = TribonacciCalculator()\n    seq_result = calc.compute(n)\n    return seq_result.to_list()"}
{"task_id": "HumanEval/134", "solution": "class TextInput:\n    \"\"\"Represents the input text and provides length/character access.\"\"\"\n    def __init__(self, content: str) -> None:\n        self._content = content\n\n    @property\n    def content(self) -> str:\n        return self._content\n\n    def length(self) -> int:\n        return len(self._content)\n\n    def char_at(self, index: int) -> str:\n        # Assumes index is always within valid bounds due to calling context.\n        return self._content[index]\n\nclass Character:\n    \"\"\"Wraps a single character and provides alphabetic check.\"\"\"\n    def __init__(self, value: str, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def is_alphabetic(self) -> bool:\n        return self.value.isalpha()\n\nclass Result:\n    \"\"\"Simple wrapper for a boolean result.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\nclass Checker:\n    \"\"\"Contains decision logic corresponding to business rules.\"\"\"\n    @staticmethod\n    def check_if_last_char_is_a_letter(txt: str) -> bool:\n        text_input = TextInput(txt)\n\n        # BR1: Handle empty string.\n        if text_input.length() == 0:\n            return False\n\n        last_char_value = text_input.char_at(text_input.length() - 1)\n        last_char = Character(last_char_value, text_input.length() - 1)\n\n        # BR2: Check if the last character is alphabetical.\n        if not last_char.is_alphabetic():\n            return False\n\n        # BR3: If the string has only one character and it's alphabetical.\n        if text_input.length() == 1:\n            return True\n\n        # For strings with more than one character, inspect the preceding character.\n        second_to_last_char_value = text_input.char_at(text_input.length() - 2)\n        # BR4: If the preceding character is a space, the last letter is not part of a word.\n        if second_to_last_char_value == ' ':\n            return True\n        \n        # BR5: If the preceding character is not a space (e.g., alphabetical, digit, symbol),\n        # the last letter is considered part of the preceding word/group of characters.\n        return False\n\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    return Checker.check_if_last_char_is_a_letter(txt)"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef validate_elements(lst):\n    \"\"\"Raises TypeError on first non-int/float element found.\"\"\"\n    for element in lst:\n        if not isinstance(element, (int, float)):\n            raise TypeError(f\"List elements must be int or float, got {type(element).__name__}\")\n\ndef apply_ceil(value):\n    \"\"\"Return math.ceil(value) as int.\"\"\"\n    return int(math.ceil(value))\n\ndef square(value):\n    \"\"\"Return value * value.\"\"\"\n    return value * value\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    if not lst:\n        return 0\n\n    validate_elements(lst)\n\n    total_sum = 0\n    for num in lst:\n        ceiled_num = apply_ceil(num)\n        squared_num = square(ceiled_num)\n        total_sum += squared_num\n    return total_sum"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element not greater than or equal to its predecessor, or -1.\"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n            \n    return -1"}
{"task_id": "HumanEval/132", "solution": "class InputString:\n    \"\"\"Represents the raw input string and provides basic accessors.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def length(self) -> int:\n        return len(self.raw)\n\n    def charAt(self, index: int) -> str:\n        return self.raw[index]\n\nclass Subsequence:\n    \"\"\"Represents a candidate subsequence with its indices and pattern.\"\"\"\n    def __init__(self, indices: list[int], input_str: InputString):\n        self.indices = indices\n        self.pattern = \"\".join(input_str.charAt(i) for i in indices)\n\n    def isInOrder(self) -> bool:\n        \"\"\"Checks if the indices are strictly increasing.\"\"\"\n        for i in range(len(self.indices) - 1):\n            if self.indices[i] >= self.indices[i+1]:\n                return False\n        return True\n\n    def isWellFormed(self) -> bool:\n        \"\"\"\n        Checks if the subsequence pattern is well-formed and contains nested brackets (max depth > 1).\n        A bracket sequence is considered 'nested' if it is balanced and its maximum depth is greater than 1.\n        \"\"\"\n        stack = []\n        max_depth = 0\n        current_depth = 0\n\n        for char in self.pattern:\n            if char == '[':\n                stack.append(char)\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ']':\n                if not stack:\n                    return False  # Unmatched closing bracket, not well-formed\n                stack.pop()\n                current_depth -= 1\n        \n        # The sequence must be balanced (stack empty) and have a max depth > 1 to be nested.\n        return not stack and max_depth > 1\n\nclass Result:\n    \"\"\"A value object encapsulating a boolean result.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\nclass IsNestedFunction:\n    \"\"\"Encapsulates the algorithmic logic to find nested subsequences.\"\"\"\n    def is_nested(self, string: str) -> bool:\n        \"\"\"Wrapper method for convenience, delegates to findNestedSubsequence.\"\"\"\n        input_obj = InputString(string)\n        return self.findNestedSubsequence(input_obj) is not None\n\n    def findNestedSubsequence(self, input_str: InputString) -> Subsequence | None:\n        \"\"\"\n        Searches for indices i < j < k < l such that input_str[i] == '[', \n        input_str[j] == '[', input_str[k] == ']', input_str[l] == ']'.\n        If such a sequence of characters is found, a Subsequence object is returned.\n        This implementation uses four nested loops as described in the design.\n        \"\"\"\n        n = input_str.length()\n        \n        for i in range(n):\n            if input_str.charAt(i) == '[':\n                for j in range(i + 1, n):\n                    if input_str.charAt(j) == '[':\n                        for k in range(j + 1, n):\n                            if input_str.charAt(k) == ']':\n                                for l in range(k + 1, n):\n                                    if input_str.charAt(l) == ']':\n                                        # Found indices i < j < k < l forming '[[]]' character pattern.\n                                        candidate_subseq = Subsequence([i, j, k, l], input_str)\n                                        \n                                        # Per design, `isWellFormed` includes check for nested pair(s).\n                                        # For a 4-character pattern '[[]]', `isWellFormed` will always be True\n                                        # given its `max_depth > 1` logic.\n                                        if candidate_subseq.isWellFormed():\n                                            return candidate_subseq\n        return None\n\ndef is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    # Construct InputString and delegate the search to IsNestedFunction as per design.\n    input_obj = InputString(string)\n    finder = IsNestedFunction()\n    subseq = finder.findNestedSubsequence(input_obj)\n    return subseq is not None"}
{"task_id": "HumanEval/136", "solution": "class IntegerElement:\n    \"\"\"Represent a single integer element and provide sign predicates.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if the integer value is positive.\"\"\"\n        return self.value > 0\n\n    def is_negative(self) -> bool:\n        \"\"\"Checks if the integer value is negative.\"\"\"\n        return self.value < 0\n\nclass ResultTuple:\n    \"\"\"Container for the result pair and conversion to native tuple.\"\"\"\n    def __init__(self, largest_negative: int | None, smallest_positive: int | None) -> None:\n        self.largest_negative = largest_negative\n        self.smallest_positive = smallest_positive\n\n    def as_tuple(self) -> tuple[int | None, int | None]:\n        \"\"\"Converts the result to a native Python tuple.\"\"\"\n        return (self.largest_negative, self.smallest_positive)\n\nclass Processor:\n    \"\"\"Encapsulates the processing algorithm for finding largest negative and smallest positive integers.\"\"\"\n    def largest_smallest_integers(self, lst: list) -> ResultTuple:\n        \"\"\"\n        Performs a single-pass scan of the list to find the largest negative and smallest positive integers.\n        Only considers elements of type int and excludes zero.\n        \"\"\"\n        largest_negative = None\n        smallest_positive = None\n\n        for element in lst:\n            if type(element) == int:\n                if element == 0:\n                    continue  # BR4: Exclude zeros\n\n                if element < 0:\n                    # BR5: Find the largest negative integer\n                    if largest_negative is None or element > largest_negative:\n                        largest_negative = element\n                elif element > 0:\n                    # BR6: Find the smallest positive integer\n                    if smallest_positive is None or element < smallest_positive:\n                        smallest_positive = element\n        \n        return ResultTuple(largest_negative, smallest_positive)\n\ndef largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    # FR1: Public API delegates to Processor for the core logic\n    return Processor().largest_smallest_integers(lst).as_tuple()"}
{"task_id": "HumanEval/137", "solution": "class NumericInput:\n    \"\"\"Encapsulates raw input and its parsed numeric value.\"\"\"\n    def __init__(self, raw_value):\n        self.raw_value = raw_value\n        self.input_type = None\n        self.numeric_value = None\n\n        if isinstance(raw_value, int):\n            self.input_type = 'int'\n        elif isinstance(raw_value, float):\n            self.input_type = 'float'\n        elif isinstance(raw_value, str):\n            self.input_type = 'string'\n\n    def parse(self):\n        \"\"\"Parses the raw_value to set numeric_value, handling string formats.\"\"\"\n        if self.input_type == 'int' or self.input_type == 'float':\n            self.numeric_value = float(self.raw_value)\n        elif self.input_type == 'string':\n            s_parsed = str(self.raw_value).replace(',', '.')\n            try:\n                self.numeric_value = float(s_parsed)\n            except ValueError:\n                self.numeric_value = None # Parsing failures set numeric_value to None internally\n\n\nclass ComparisonResult:\n    \"\"\"Holds the outcome of a comparison: winner's raw value, type, and numeric value.\"\"\"\n    def __init__(self, winner_raw, winner_type, winner_numeric):\n        self.winner_raw = winner_raw\n        self.winner_type = winner_type\n        self.winner_numeric = winner_numeric\n\n\nclass ComparisonEngine:\n    \"\"\"Compares two NumericInput instances based on their numeric_value.\"\"\"\n    def compare(self, a: NumericInput, b: NumericInput) -> ComparisonResult:\n        num_a = a.numeric_value\n        num_b = b.numeric_value\n\n        # Handle cases where parsing resulted in None for numeric_value (undefined behavior)\n        if num_a is None and num_b is None:\n            return ComparisonResult(None, None, None)\n        elif num_a is None: # Only b is a valid number, so b is considered larger\n            return ComparisonResult(b.raw_value, b.input_type, num_b)\n        elif num_b is None: # Only a is a valid number, so a is considered larger\n            return ComparisonResult(a.raw_value, a.input_type, num_a)\n\n        # Standard numeric comparison when both are valid floats\n        if num_a == num_b:\n            return ComparisonResult(None, None, None)\n        elif num_a > num_b:\n            return ComparisonResult(a.raw_value, a.input_type, num_a)\n        else: # num_b > num_a\n            return ComparisonResult(b.raw_value, b.input_type, num_b)\n\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    ai = NumericInput(a)\n    bi = NumericInput(b)\n\n    ai.parse()\n    bi.parse()\n\n    engine = ComparisonEngine()\n    result = engine.compare(ai, bi)\n\n    if result.winner_raw is None:\n        return None\n    return result.winner_raw"}
{"task_id": "HumanEval/139", "solution": "class Input:\n    \"\"\"Hold and validate the integer input n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\nclass FactorialCalculator:\n    \"\"\"Compute the standard factorial for a given integer k (k!).\"\"\"\n    def factorial(self, k: int) -> int:\n        if k == 0 or k == 1:\n            return 1\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\nclass SpecialFactorialCalculator:\n    \"\"\"Orchestrate computation of the Brazilian (special) factorial.\"\"\"\n    def __init__(self, factorial_calculator: FactorialCalculator = None):\n        self._factorial_calculator = factorial_calculator if factorial_calculator is not None else FactorialCalculator()\n\n    def compute(self, n: int) -> int:\n        # Per instructions, no explicit type or value checks for n are added.\n        overall_product = 1\n        for k in range(1, n + 1):\n            k_factorial = self._factorial_calculator.factorial(k)\n            overall_product *= k_factorial\n        return overall_product\n\nclass Result:\n    \"\"\"Hold the computed special factorial value for return.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    input_obj = Input(n)\n    sfc = SpecialFactorialCalculator()\n    computed_value = sfc.compute(input_obj.n)\n    result_obj = Result(computed_value)\n    return result_obj.value"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    return (n % 2 == 0) and (n >= 8)"}
{"task_id": "HumanEval/140", "solution": "from typing import List, Optional\n\nclass InputString:\n    \"\"\"Represents the input text.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"Holds the resulting transformed string value.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass SpaceRun:\n    \"\"\"Represents a contiguous run of space characters.\"\"\"\n    def __init__(self, start_index: int, length: int, chars: str):\n        self.startIndex = start_index\n        self.length = length\n        self.chars = chars\n\n    def isSpaceRun(self) -> bool:\n        \"\"\"Verifies if the run consists solely of spaces.\"\"\"\n        return all(c == ' ' for c in self.chars)\n\nclass ReplacementRule:\n    \"\"\"Defines a rule for replacing space runs.\"\"\"\n    def __init__(self, min_run: int, max_run: Optional[int], replacement: str, apply_per_char: bool = False):\n        self.minRun = min_run\n        self.maxRun = max_run\n        self.replacement = replacement\n        self.apply_per_char = apply_per_char\n\n    def matches(self, run_length: int) -> bool:\n        \"\"\"Checks if the run length matches this rule.\"\"\"\n        if run_length < self.minRun:\n            return False\n        if self.maxRun is not None and run_length > self.maxRun:\n            return False\n        return True\n\nclass FixSpacesFunction:\n    \"\"\"Encapsulates the logic for fixing spaces.\"\"\"\n    def fix_spaces(self, text: str) -> str:\n        \"\"\"Main method to process and transform the input text.\"\"\"\n        input_str = InputString(text)\n        \n        # If no spaces, return original text unchanged for efficiency.\n        if ' ' not in text:\n            return text\n\n        runs = self._identifySpaceRuns(input_str)\n        output_value = self._applyRules(runs, input_str)\n        \n        return output_value\n\n    def _identifySpaceRuns(self, input_str: InputString) -> List[SpaceRun]:\n        \"\"\"Identifies all contiguous runs of space characters.\"\"\"\n        runs = []\n        n = input_str.length()\n        i = 0\n        while i < n:\n            if input_str.value[i] == ' ':\n                run_start = i\n                run_length = 0\n                while i < n and input_str.value[i] == ' ':\n                    run_length += 1\n                    i += 1\n                runs.append(SpaceRun(run_start, run_length, ' ' * run_length))\n            else:\n                i += 1\n        return runs\n\n    def _applyRules(self, runs: List[SpaceRun], input_str: InputString) -> str:\n        \"\"\"Applies replacement rules to the identified space runs.\"\"\"\n        rules = [\n            ReplacementRule(1, 2, '_', apply_per_char=True),  # Runs of 1 or 2 spaces become '_' per space\n            ReplacementRule(3, None, '-', apply_per_char=False) # Runs of 3 or more spaces become a single '-'\n        ]\n        \n        output_parts = []\n        current_pos = 0\n        \n        for run in runs:\n            # Append non-space characters before the current run\n            if run.startIndex > current_pos:\n                output_parts.append(input_str.value[current_pos:run.startIndex])\n            \n            # Find and apply the matching rule for the space run\n            matched_rule = None\n            for rule in rules:\n                if rule.matches(run.length):\n                    matched_rule = rule\n                    break\n            \n            if matched_rule:\n                if matched_rule.apply_per_char:\n                    output_parts.append(matched_rule.replacement * run.length)\n                else:\n                    output_parts.append(matched_rule.replacement)\n            \n            current_pos = run.startIndex + run.length\n            \n        # Append any remaining non-space characters after the last run\n        if current_pos < input_str.length():\n            output_parts.append(input_str.value[current_pos:])\n            \n        return \"\".join(output_parts)\n\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    impl = FixSpacesFunction()\n    return impl.fix_spaces(text)"}
{"task_id": "HumanEval/141", "solution": "import collections\n\nclass FileName:\n    \"\"\"Represents a parsed file name with its components and counts.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n        self.prefix = \"\"\n        self.extension = \"\"\n        self.digit_count = 0\n        self.dot_count = 0\n\nclass ValidationResult:\n    \"\"\"Holds the result of a file name validation, including reasons for failure.\"\"\"\n    def __init__(self, is_valid: bool, reasons: list[str]) -> None:\n        self.is_valid = is_valid\n        self.reasons = reasons\n\n    def add_reason(self, reason: str) -> None:\n        self.reasons.append(reason)\n        self.is_valid = False\n\nclass ValidationRule:\n    \"\"\"Abstract base class for file name validation rules.\"\"\"\n    def __init__(self, id: str, description: str) -> None:\n        self.id = id\n        self.description = description\n\n    def evaluate(self, file_name: FileName) -> bool:\n        \"\"\"Evaluates the rule against a FileName object.\"\"\"\n        raise NotImplementedError\n\nclass DigitCountRule(ValidationRule):\n    \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n    def __init__(self) -> None:\n        super().__init__('BR2', 'Digit count across entire input <= 3')\n\n    def evaluate(self, file_name: FileName) -> bool:\n        return file_name.digit_count <= 3\n\nclass DotCountRule(ValidationRule):\n    \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n    def __init__(self) -> None:\n        super().__init__('BR3', 'Exactly one dot \".\"')\n\n    def evaluate(self, file_name: FileName) -> bool:\n        return file_name.dot_count == 1\n\nclass PrefixNonEmptyRule(ValidationRule):\n    \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n    def __init__(self) -> None:\n        super().__init__('BR4', 'Prefix (before the dot) non-empty')\n\n    def evaluate(self, file_name: FileName) -> bool:\n        return len(file_name.prefix) > 0\n\nclass PrefixStartsWithLetterRule(ValidationRule):\n    \"\"\"Checks if the substring before the dot starts with a latin letter.\"\"\"\n    def __init__(self) -> None:\n        super().__init__('BR5', 'Prefix starts with ASCII Latin letter A-Z or a-z')\n\n    def evaluate(self, file_name: FileName) -> bool:\n        if not file_name.prefix:\n            return False\n        first_char = file_name.prefix[0]\n        return 'a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'\n\nclass ExtensionAllowedRule(ValidationRule):\n    \"\"\"Checks if the substring after the dot is one of the allowed extensions.\"\"\"\n    def __init__(self) -> None:\n        super().__init__('BR6', \"Extension exactly one of ['txt','exe','dll']\")\n        self.allowed_extensions = ('txt', 'exe', 'dll')\n\n    def evaluate(self, file_name: FileName) -> bool:\n        return file_name.extension in self.allowed_extensions\n\nclass FileNameProcessor:\n    \"\"\"Parses file name, counts components, and orchestrates validation rules.\"\"\"\n    def __init__(self, rules: list[ValidationRule] = None) -> None:\n        if rules is None:\n            self.rules = [\n                DigitCountRule(),\n                DotCountRule(),\n                PrefixNonEmptyRule(),\n                PrefixStartsWithLetterRule(),\n                ExtensionAllowedRule()\n            ]\n        else:\n            self.rules = rules\n\n    def process(self, raw: str) -> ValidationResult:\n        \"\"\"Processes the raw file name string against all validation rules.\"\"\"\n        try:\n            file_name = FileName(raw)\n            initial_is_valid = True\n            reasons = []\n\n            for char in raw:\n                if char.isdigit():\n                    file_name.digit_count += 1\n                if char == '.':\n                    file_name.dot_count += 1\n\n            last_dot_index = raw.rfind('.')\n            if last_dot_index == -1:\n                file_name.prefix = raw\n                file_name.extension = \"\"\n            else:\n                file_name.prefix = raw[:last_dot_index]\n                file_name.extension = raw[last_dot_index + 1:]\n\n            for rule in self.rules:\n                if not rule.evaluate(file_name):\n                    initial_is_valid = False\n                    reasons.append(rule.description)\n\n            return ValidationResult(initial_is_valid, reasons)\n\n        except Exception:\n            return ValidationResult(is_valid=False, reasons=['internal_error'])\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    try:\n        if not isinstance(file_name, str) or not file_name:\n            return 'No'\n\n        processor = FileNameProcessor()\n        result = processor.process(file_name)\n\n        if result.is_valid:\n            return 'Yes'\n        else:\n            return 'No'\n    except Exception:\n        return 'No'"}
{"task_id": "HumanEval/142", "solution": "class InputList:\n    \"\"\"Represents the validated input list with entries.\"\"\"\n    def __init__(self, entries):\n        self.entries = entries\n        self.length = len(entries)\n\nclass ListEntry:\n    \"\"\"Represents an individual entry in the list with its original and transformed values.\"\"\"\n    def __init__(self, index, value):\n        self.index = index\n        self.originalValue = value\n        self.transformedValue = value\n\n    def applyTransformation(self, rule):\n        \"\"\"Applies the given transformation rule to the entry.\"\"\"\n        self.transformedValue = rule._operation_func(self.originalValue)\n\nclass TransformationRule:\n    \"\"\"Defines a transformation rule with its condition, operation, and precedence.\"\"\"\n    def __init__(self, name, condition_func, operation_func, precedence):\n        self.name = name\n        self._condition_func = condition_func\n        self._operation_func = operation_func\n        self.precedence = precedence\n\n    def appliesTo(self, index):\n        \"\"\"Checks if the rule applies to the given index.\"\"\"\n        return self._condition_func(index)\n\nclass SumResult:\n    \"\"\"Holds the final aggregated sum.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates the raw input list and converts it to an InputList domain object.\"\"\"\n    @staticmethod\n    def validate_input_list(lst_raw):\n        \"\"\"Validates the input and returns an InputList.\"\"\"\n        if not isinstance(lst_raw, list):\n            raise ValueError(\"Input must be a list.\")\n        \n        entries = []\n        for i, val in enumerate(lst_raw):\n            if not isinstance(val, int):\n                raise ValueError(f\"List element at index {i} is not an integer.\")\n            entries.append(ListEntry(i, val))\n        \n        return InputList(entries)\n\nclass SumCalculator:\n    \"\"\"Aggregates transformed values into a SumResult.\"\"\"\n    @staticmethod\n    def aggregate(entries):\n        \"\"\"Calculates the sum of transformed values.\"\"\"\n        total_sum = 0\n        for entry in entries:\n            total_sum += entry.transformedValue\n        return SumResult(total_sum)\n\nclass TransformationProcessor:\n    \"\"\"Orchestrates transformations based on rules and precedence.\"\"\"\n    def __init__(self):\n        # Square rule: index % 3 == 0 (higher precedence)\n        square_rule = TransformationRule(\n            name=\"SquareRule\",\n            condition_func=lambda index: index % 3 == 0,\n            operation_func=lambda x: x**2,\n            precedence=1\n        )\n        # Cube rule: index % 4 == 0 AND NOT index % 3 == 0 (lower precedence)\n        cube_rule = TransformationRule(\n            name=\"CubeRule\",\n            condition_func=lambda index: index % 4 == 0 and index % 3 != 0,\n            operation_func=lambda x: x**3,\n            precedence=2\n        )\n        self.rules = [square_rule, cube_rule]\n\n    def process(self, input_list):\n        \"\"\"Applies transformations to entries and returns the aggregated sum.\"\"\"\n        for entry in input_list.entries:\n            for rule in self.rules:\n                if rule.appliesTo(entry.index):\n                    entry.applyTransformation(rule)\n                    break # Apply first matching rule by precedence\n        \n        return SumCalculator.aggregate(input_list.entries)\n\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    input_list = Validator.validate_input_list(lst)\n\n    if input_list.length == 0:\n        return 0\n\n    processor = TransformationProcessor()\n    sum_result = processor.process(input_list)\n\n    return sum_result.value"}
{"task_id": "HumanEval/143", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Sentence:\n    text: str\n    length: int\n\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.length = len(text)\n\n@dataclass\nclass Word:\n    text: str\n    length: int\n    isPrime: bool = False\n\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.length = len(text)\n        self.isPrime = False\n\n@dataclass\nclass Result:\n    outputText: str\n\n    def __init__(self, outputText: str) -> None:\n        self.outputText = outputText\n\nclass PrimeChecker:\n    \"\"\"Checks if a number is prime using trial division.\"\"\"\n    @staticmethod\n    def isPrime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n <= 3: # 2 and 3 are prime\n            return True\n        if n % 2 == 0 or n % 3 == 0: # multiples of 2 or 3 are not prime\n            return False\n        i = 5\n        # Check divisibility by numbers of the form 6k +/- 1 up to sqrt(n)\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass WordSplitter:\n    \"\"\"Splits a Sentence into a list of Word objects.\"\"\"\n    @staticmethod\n    def split(sentence: Sentence) -> List[Word]:\n        words_text = sentence.text.split(' ')\n        return [Word(text) for text in words_text if text] # Filter out empty strings from multiple spaces\n\nclass WordFilter:\n    \"\"\"Filters a list of Word objects, keeping only those with prime lengths.\"\"\"\n    @staticmethod\n    def filter(words: List[Word]) -> List[Word]:\n        filtered_words = []\n        for word in words:\n            if PrimeChecker.isPrime(word.length):\n                word.isPrime = True\n                filtered_words.append(word)\n        return filtered_words\n\ndef _validate_input(sentence: str) -> Sentence:\n    \"\"\"Validates the input sentence for length and allowed characters.\"\"\"\n    if not isinstance(sentence, str):\n        raise ValueError(\"Input must be a string.\")\n    if not (1 <= len(sentence) <= 100):\n        raise ValueError(\"Sentence length must be between 1 and 100 characters.\")\n    for char in sentence:\n        if not ('a' <= char <= 'z' or 'A' <= char <= 'Z' or char == ' '):\n            raise ValueError(\"Sentence must contain only letters and spaces.\")\n    return Sentence(text=sentence)\n\ndef _build_result(filtered_words: List[Word]) -> Result:\n    \"\"\"Builds the final Result object from filtered words.\"\"\"\n    if not filtered_words:\n        return Result(\"\")\n    return Result(' '.join(word.text for word in filtered_words))\n\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    sentence_obj = _validate_input(sentence)\n    words = WordSplitter.split(sentence_obj)\n    filtered = WordFilter.filter(words)\n    result = _build_result(filtered)\n    return result.outputText"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents an immutable fraction with numerator, denominator, and original string.\"\"\"\n    def __init__(self, numerator: int, denominator: int, original: str):\n        self.numerator = numerator\n        self.denominator = denominator\n        self.original = original\n\n    @staticmethod\n    def fromString(s: str) -> \"Fraction\":\n        \"\"\"Parses a fraction string 'numerator/denominator' into a Fraction object.\"\"\"\n        parts = s.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator, s)\n\nclass Parser:\n    \"\"\"Stateless parser converting fraction strings to Fraction instances.\"\"\"\n    def parse(self, s: str) -> Fraction:\n        \"\"\"Parses a string into a Fraction object.\"\"\"\n        return Fraction.fromString(s)\n\nclass Product:\n    \"\"\"Represents the product of two fractions and encapsulates the whole-number test.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def isWhole(self) -> bool:\n        \"\"\"Checks if the product is a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\nclass Simplifier:\n    \"\"\"Orchestrates parsing, multiplication, and whole-number evaluation.\"\"\"\n    def __init__(self):\n        self._parser = Parser()\n\n    def simplify(self, xStr: str, nStr: str) -> bool:\n        \"\"\"Parses inputs, computes product, and returns if it's a whole number.\"\"\"\n        f_x = self._parser.parse(xStr)\n        f_n = self._parser.parse(nStr)\n        p = self.multiply(f_x, f_n)\n        return p.isWhole()\n\n    def multiply(self, f1: Fraction, f2: Fraction) -> Product:\n        \"\"\"Multiplies two Fraction objects and returns a Product object.\"\"\"\n        product_numerator = f1.numerator * f2.numerator\n        product_denominator = f1.denominator * f2.denominator\n        return Product(product_numerator, product_denominator)\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    simpl = Simplifier()\n    return simpl.simplify(x, n)"}
{"task_id": "HumanEval/146", "solution": "from typing import List, Union, Set\n\nclass DigitExtractor:\n    \"\"\"Stateless utility for computing absolute integer and extracting digits.\"\"\"\n    @staticmethod\n    def extractAbsInt(value: float) -> int:\n        \"\"\"Returns integer part of abs(value) using truncation toward zero.\"\"\"\n        return int(abs(value))\n\n    @staticmethod\n    def firstDigit(absInt: int) -> int:\n        \"\"\"Returns the most significant decimal digit; for 0 returns 0.\"\"\"\n        if absInt == 0:\n            return 0\n        while absInt >= 10:\n            absInt //= 10\n        return absInt\n\n    @staticmethod\n    def lastDigit(absInt: int) -> int:\n        \"\"\"Returns least significant decimal digit.\"\"\"\n        return absInt % 10\n\nclass NumberElement:\n    \"\"\"Encapsulate original numeric value and derived absolute integer + digit accessors.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value: float = value\n        self.absIntValue: int = DigitExtractor.extractAbsInt(value)\n\n    def firstDigit(self) -> int:\n        \"\"\"Returns the first digit of the absolute integer value.\"\"\"\n        return DigitExtractor.firstDigit(self.absIntValue)\n\n    def lastDigit(self) -> int:\n        \"\"\"Returns the last digit of the absolute integer value.\"\"\"\n        return DigitExtractor.lastDigit(self.absIntValue)\n\nclass InputArray:\n    \"\"\"Container mapping input list to NumberElement instances.\"\"\"\n    def __init__(self, nums: List[Union[int, float]]) -> None:\n        self.elements: List[NumberElement] = [NumberElement(float(num)) for num in nums]\n\nclass FilterCriteria:\n    \"\"\"Provide matching rule: value > minValue and both digits odd.\"\"\"\n    minValue: int = 10\n    oddDigits: Set[int] = {1, 3, 5, 7, 9}\n\n    def matches(self, n: NumberElement) -> bool:\n        \"\"\"Checks if the number element matches the filtering criteria.\"\"\"\n        return (n.value > self.minValue and\n                n.firstDigit() in self.oddDigits and\n                n.lastDigit() in self.oddDigits)\n\nclass Counter:\n    \"\"\"Aggregate matched NumberElement instances and return integer count.\"\"\"\n    def count(self, elements: List[NumberElement]) -> int:\n        \"\"\"Returns number of elements for which FilterCriteria.matches() is True.\"\"\"\n        criterion = FilterCriteria()\n        matched_count = 0\n        for n in elements:\n            if criterion.matches(n):\n                matched_count += 1\n        return matched_count\n\nclass Result:\n    \"\"\"Simple holder for final integer count.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count: int = count\n\ndef specialFilter(nums: List[Union[int, float]]) -> int:\n    \"\"\"\n    Takes an array of numbers as input and returns the number of elements in the array\n    that are greater than 10 and both first and last digits of a number are odd.\n    \"\"\"\n    input_array = InputArray(nums)\n    counter = Counter()\n    final_count = counter.count(input_array.elements)\n    result_obj = Result(final_count)\n    return result_obj.count"}
{"task_id": "HumanEval/145", "solution": "class IntegerItem:\n    \"\"\"Helper class to store an integer's value, its original index, and its computed digit sum.\"\"\"\n    def __init__(self, value: int, original_index: int):\n        self.value = value\n        self.original_index = original_index\n        self.digit_sum = 0 # This will be computed and assigned externally\n\n\ndef _calculate_digit_sum(n: int) -> int:\n    \"\"\"Calculates the sum of decimal digits of the absolute value of n.\"\"\"\n    s = 0\n    abs_n = abs(n)\n    if abs_n == 0:\n        return 0\n    while abs_n > 0:\n        s += abs_n % 10\n        abs_n //= 10\n    return s\n\n\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create IntegerItem objects, compute their digit sums, and store their original indices.\n    items_with_metadata = []\n    for i, num in enumerate(nums):\n        item = IntegerItem(num, i)\n        item.digit_sum = _calculate_digit_sum(num)\n        items_with_metadata.append(item)\n\n    # Sort the items: primary key is digit_sum (ascending), secondary key is original_index (ascending).\n    sorted_items = sorted(items_with_metadata, key=lambda item: (item.digit_sum, item.original_index))\n\n    # Extract the original values from the sorted list of IntegerItem objects.\n    return [item.value for item in sorted_items]"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from the generated array 'a' such that i < j < k and their sum is a multiple of 3.\n    The array a is defined by a[i] = i*i - i + 1 for 1 <= i <= n.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    f0 = 0  # count of elements % 3 == 0\n    f1 = 0  # count of elements % 3 == 1\n    f2 = 0  # count of elements % 3 == 2\n\n    # Calculate values and classify them by their modulo 3 remainder\n    for i in range(1, n + 1):\n        value = i * i - i + 1\n        mod3 = value % 3\n        if mod3 == 0:\n            f0 += 1\n        elif mod3 == 1:\n            f1 += 1\n        else:  # mod3 == 2\n            f2 += 1\n\n    # Helper function for combinations C(k, 3)\n    def combinations_3(k):\n        if k < 3:\n            return 0\n        return k * (k - 1) * (k - 2) // 6\n\n    # A triple (x, y, z) sums to a multiple of 3 if their modulo 3 remainders are:\n    # (0, 0, 0), (1, 1, 1), (2, 2, 2), or (0, 1, 2) in any order.\n    total_triples = 0\n    total_triples += combinations_3(f0)  # for (0, 0, 0)\n    total_triples += combinations_3(f1)  # for (1, 1, 1)\n    total_triples += combinations_3(f2)  # for (2, 2, 2)\n    total_triples += f0 * f1 * f2      # for (0, 1, 2)\n\n    return total_triples"}
{"task_id": "HumanEval/149", "solution": "from typing import List\n\n\ndef sorted_list_sum(lst: List[str]) -> List[str]:\n    \"\"\"Filters out strings with odd lengths and returns the remaining\n    strings sorted by length, then alphabetically.\n    \"\"\"\n    \n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    \n    # Sort primarily by length (ascending) and secondarily alphabetically\n    filtered_list.sort(key=lambda s: (len(s), s))\n    \n    return filtered_list"}
{"task_id": "HumanEval/148", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional, Tuple\n\n@dataclass\nclass Planet:\n    name: str\n    orderFromSun: int\n\nclass PlanetRepository:\n    def __init__(self) -> None:\n        self.planets: List[Planet] = [\n            Planet(\"Mercury\", 1),\n            Planet(\"Venus\", 2),\n            Planet(\"Earth\", 3),\n            Planet(\"Mars\", 4),\n            Planet(\"Jupiter\", 5),\n            Planet(\"Saturn\", 6),\n            Planet(\"Uranus\", 7),\n            Planet(\"Neptune\", 8),\n        ]\n\n    def get_by_name(self, name: str) -> Optional[Planet]:\n        for planet in self.planets:\n            if planet.name == name:\n                return planet\n        return None\n\n    def get_index(self, name: str) -> Optional[int]:\n        for i, planet in enumerate(self.planets):\n            if planet.name == name:\n                return i\n        return None\n\n    def get_ordered_names(self) -> List[str]:\n        return [planet.name for planet in self.planets]\n\nclass BFService:\n    def __init__(self, repository: Optional[PlanetRepository] = None) -> None:\n        self.repository = repository if repository is not None else PlanetRepository()\n\n    def bf(self, planet1: str, planet2: str) -> tuple:\n        if not self.validate(planet1) or not self.validate(planet2):\n            return ()\n\n        idx1 = self.repository.get_index(planet1)\n        idx2 = self.repository.get_index(planet2)\n\n        if idx1 is None or idx2 is None:\n            return ()\n\n        between_names = self.compute_between(idx1, idx2)\n        return tuple(between_names)\n\n    def validate(self, name: str) -> bool:\n        return self.repository.get_by_name(name) is not None\n\n    def compute_between(self, i1: int, i2: int) -> List[str]:\n        start_idx = min(i1, i2)\n        end_idx = max(i1, i2)\n\n        between_planets_names = []\n        for i in range(start_idx + 1, end_idx):\n            if 0 <= i < len(self.repository.planets):\n                between_planets_names.append(self.repository.planets[i].name)\n        \n        return between_planets_names\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    service = BFService()\n    return service.bf(planet1, planet2)"}
{"task_id": "HumanEval/150", "solution": "class PrimeChecker:\n    \"\"\"A deterministic primality checker.\n    It determines if an integer n is prime based on trial division.\n    \"\"\"\n    def isPrime(self, n):\n        \"\"\"Determines if a number n is prime, treating non-integers or n <= 1 as not prime.\"\"\"\n        if not isinstance(n, int) or n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        \n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    checker = PrimeChecker()\n    if checker.isPrime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    if not lst:\n        return 0\n\n    def is_integer(x):\n        \"\"\"Checks if the item is an integer.\"\"\"\n        return type(x) is int\n\n    def is_non_negative(x):\n        \"\"\"Checks if the item is non-negative.\"\"\"\n        return x >= 0\n\n    def is_odd(x):\n        \"\"\"Checks if the item is odd.\"\"\"\n        return x % 2 != 0\n\n    def filter_items(input_list):\n        \"\"\"Filters a list to include only non-negative odd integers.\"\"\"\n        filtered = []\n        for x in input_list:\n            if is_integer(x) and is_non_negative(x) and is_odd(x):\n                filtered.append(x)\n        return filtered\n\n    def square(n):\n        \"\"\"Returns the square of a number.\"\"\"\n        return n * n\n\n    def sum_squares(items):\n        \"\"\"Calculates the sum of squares for a list of numbers.\"\"\"\n        total = 0\n        for item in items:\n            total += square(item)\n        return total\n\n    filtered_numbers = filter_items(lst)\n    return sum_squares(filtered_numbers)"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"\n    Compares two lists of scores and guesses to determine how far off each guess was.\n    Returns a list of absolute differences, with 0 for correct guesses.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/154", "solution": "from typing import List, Optional\n\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n\n    # Helper function to generate cyclic rotations of a string, excluding the original string (0-shift).\n    def _generate_rotations(value: str) -> List[str]:\n        if not value:\n            return []\n        rotations_list = []\n        n = len(value)\n        # Generate n-1 rotations, starting from a shift of 1 character.\n        for i in range(1, n):\n            rotations_list.append(value[i:] + value[:i])\n        return rotations_list\n\n    # Domain classes as specified in the design context.\n    class InputString:\n        \"\"\"Encapsulates the target string 'a'.\"\"\"\n        def __init__(self, value: str) -> None:\n            self._value = value\n\n        def value(self) -> str:\n            return self._value\n\n    class Pattern:\n        \"\"\"Encapsulates the pattern string 'b' and provides methods for its properties.\"\"\"\n        def __init__(self, value: str) -> None:\n            self._value = value\n\n        def value(self) -> str:\n            return self._value\n\n        def length(self) -> int:\n            return len(self._value)\n\n        def rotations(self) -> List[str]:\n            \"\"\"Returns a list of cyclic rotations of the pattern, excluding the original string.\"\"\"\n            return _generate_rotations(self._value)\n\n    class Rotation:\n        \"\"\"Represents a single rotation value.\"\"\"\n        def __init__(self, value: str) -> None:\n            self._value = value\n\n        def value(self) -> str:\n            return self._value\n\n    class Result:\n        \"\"\"Encapsulates the outcome of the pattern check (matched status and optionally the matched rotation).\"\"\"\n        def __init__(self, matched: bool, matchedRotation: Optional[str]) -> None:\n            self.matched = matched\n            self.matchedRotation = matchedRotation\n\n    class CycPatternCheck:\n        \"\"\"Orchestrates the substring checks: direct pattern first, then its rotations.\"\"\"\n        def check(self, a_str: str, b_str: str) -> bool:\n            input_obj = InputString(a_str)\n            pattern_obj = Pattern(b_str)\n\n            # Step 1: Check if the pattern itself is a substring of the input string.\n            if pattern_obj.value() in input_obj.value():\n                return True\n\n            # Step 2: Generate rotations of the pattern and check each as a substring.\n            for rotation_str in pattern_obj.rotations():\n                if rotation_str in input_obj.value():\n                    return True\n\n            # Step 3: If no direct match or rotation match is found, return False.\n            return False\n\n    # The public API entry point delegates the core logic to an instance of CycPatternCheck.\n    return CycPatternCheck().check(a, b)"}
{"task_id": "HumanEval/153", "solution": "class ClassEntity:\n    \"\"\"Represents the input class name for output formatting.\"\"\"\n    def __init__(self, name: str) -> None:\n        self.name = name\n\nclass Extension:\n    \"\"\"Represents an extension and computes its strength based on CAP and SM letters.\"\"\"\n    def __init__(self, name: str) -> None:\n        self.name = name\n        self.CAP = 0\n        self.SM = 0\n        for char in name:\n            if 'A' <= char <= 'Z':\n                self.CAP += 1\n            elif 'a' <= char <= 'z':\n                self.SM += 1\n        self.strength = self.CAP - self.SM\n\nclass StrongestExtensionService:\n    \"\"\"Encapsulates the algorithm to find the strongest extension and format the result.\"\"\"\n    def get_strongest(self, class_name: str, extensions: list[str]) -> str:\n        strongest_extension_name = \"\"\n        max_strength = float('-inf')\n\n        for ext_name in extensions:\n            current_extension = Extension(ext_name)\n            if current_extension.strength > max_strength:\n                max_strength = current_extension.strength\n                strongest_extension_name = current_extension.name\n            # If strengths are equal, the first encountered (due to list order) is kept.\n\n        class_entity = ClassEntity(class_name)\n        return f\"{class_entity.name}.{strongest_extension_name}\"\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM strength and returns a formatted string.\n    If there are ties in strength, the extension that comes first in the list is chosen.\n    \"\"\"\n    service = StrongestExtensionService()\n    return service.get_strongest(class_name, extensions)"}
{"task_id": "HumanEval/155", "solution": "from typing import Tuple\n\nclass NumberInput:\n    \"\"\"Represents and validates incoming input; provides normalized absolute value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the stored value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n    def abs_value(self) -> int:\n        \"\"\"Returns the absolute value of the stored integer.\"\"\"\n        return abs(self.value)\n\nclass DigitCounter:\n    \"\"\"Counts even and odd digits of a non-negative integer.\"\"\"\n    def __init__(self):\n        self.even_count = 0\n        self.odd_count = 0\n\n    def count_digits(self, n: int) -> Tuple[int, int]:\n        \"\"\"Iterates base-10 digits of n and tallies even and odd digits.\"\"\"\n        if n == 0:\n            return (1, 0)\n\n        while n > 0:\n            digit = n % 10\n            if digit % 2 == 0:\n                self.even_count += 1\n            else:\n                self.odd_count += 1\n            n //= 10\n        return (self.even_count, self.odd_count)\n\nclass EvenOddService:\n    \"\"\"Orchestrates validation, normalization, and digit counting.\"\"\"\n    def even_odd_count(self, num: int) -> Tuple[int, int]:\n        \"\"\"Validates input, normalizes, counts digits, and returns the result.\"\"\"\n        ni = NumberInput(num)\n        if not ni.is_integer():\n            raise TypeError(\"num must be an int\")\n        \n        abs_n = ni.abs_value()\n        dc = DigitCounter()\n        return dc.count_digits(abs_n)\n\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    svc = EvenOddService()\n    return svc.even_odd_count(num)"}
{"task_id": "HumanEval/157", "solution": "from typing import List\n\nNUMERIC_ABS_TOL: float = 1e-9\n\nclass ValidationResult:\n    \"\"\"Represents the outcome of a validation operation.\"\"\"\n    def __init__(self, is_valid: bool, reason: str) -> None:\n        self.is_valid = is_valid\n        self.reason = reason\n\nclass Triangle:\n    \"\"\"Encapsulates triangle side lengths and related validation/computation.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def is_valid(self) -> ValidationResult:\n        \"\"\"Performs positivity and triangle inequality checks.\"\"\"\n        if not (self.a > 0 and self.b > 0 and self.c > 0):\n            return ValidationResult(False, \"Sides must be positive.\")\n        \n        if not (self.a + self.b > self.c and\n                self.a + self.c > self.b and\n                self.b + self.c > self.a):\n            return ValidationResult(False, \"Triangle inequality violated.\")\n            \n        return ValidationResult(True, \"Valid triangle.\")\n\n    def sides_sorted(self) -> List[float]:\n        \"\"\"Returns the side lengths sorted in ascending order.\"\"\"\n        return sorted([self.a, self.b, self.c])\n\n    def is_right_angled(self, tol: float = NUMERIC_ABS_TOL) -> bool:\n        \"\"\"Checks if the triangle is right-angled using Pythagorean theorem within tolerance.\"\"\"\n        s1, s2, long = self.sides_sorted()\n        \n        sum_of_squares_of_shorts = s1**2 + s2**2\n        square_of_long_side = long**2\n        \n        return abs(sum_of_squares_of_shorts - square_of_long_side) <= tol\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    '''\n    ta, tb, tc = float(a), float(b), float(c)\n    t = Triangle(ta, tb, tc)\n    \n    validation_result = t.is_valid()\n    if not validation_result.is_valid:\n        return False\n        \n    return t.is_right_angled(tol=NUMERIC_ABS_TOL)"}
{"task_id": "HumanEval/158", "solution": "import collections\nfrom typing import List\n\nclass Word:\n    \"\"\"Represents a word with its text and unique character count.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.uniqueCharCount = 0\n\n    def computeUniqueCharCount(self) -> int:\n        \"\"\"Computes and stores the number of unique characters in the word's text.\"\"\"\n        self.uniqueCharCount = len(set(self.text))\n        return self.uniqueCharCount\n\nclass WordsList:\n    \"\"\"A collection of Word objects.\"\"\"\n    def __init__(self, words_texts: List[str]) -> None:\n        self.words: List[Word] = [Word(text) for text in words_texts]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of words in the list.\"\"\"\n        return len(self.words)\n\nclass Analyzer:\n    \"\"\"Analyzes a list of words to find the one with maximum unique characters.\"\"\"\n\n    def findMaxUnique(self, words_list: WordsList) -> Word:\n        \"\"\"\n        Finds the Word object with the maximum number of unique characters,\n        breaking ties lexicographically.\n        \"\"\"\n        if not words_list.words:\n            return None\n\n        for word in words_list.words:\n            word.computeUniqueCharCount()\n\n        max_word = words_list.words[0]\n\n        for i in range(1, words_list.size()):\n            current_word = words_list.words[i]\n            if self.compareByUniqueThenLexicographic(current_word, max_word) < 0:\n                max_word = current_word\n        \n        return max_word\n\n    def compareByUniqueThenLexicographic(self, a: Word, b: Word) -> int:\n        \"\"\"\n        Compares two Word objects: first by unique character count (descending),\n        then by lexicographical order of text (ascending).\n        Returns -1 if a is preferred, 1 if b is preferred, 0 if they are equal.\n        \"\"\"\n        if a.uniqueCharCount > b.uniqueCharCount:\n            return -1\n        elif a.uniqueCharCount < b.uniqueCharCount:\n            return 1\n        else:\n            if a.text < b.text:\n                return -1\n            elif a.text > b.text:\n                return 1\n            else:\n                return 0\n\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Returns the word with the maximum number of unique characters from a list of strings.\n    If multiple strings have the maximum, returns the one that comes first\n    in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    words_list = WordsList(words_texts=words)\n    analyzer = Analyzer()\n    selected_word_obj = analyzer.findMaxUnique(words_list)\n    \n    return selected_word_obj.text if selected_word_obj else \"\""}
{"task_id": "HumanEval/159", "solution": "\nclass InputParameters:\n    \"\"\"Encapsulates input parameters and provides validation.\"\"\"\n    def __init__(self, number: int, need: int, remaining: int):\n        self.number = number\n        self.need = need\n        self.remaining = remaining\n\n    def validate(self) -> bool:\n        \"\"\"Validates that inputs are integers in the inclusive range [0, 1000].\"\"\"\n        for param_name, param_value in [(\"number\", self.number), (\"need\", self.need), (\"remaining\", self.remaining)]:\n            if not isinstance(param_value, int):\n                raise ValueError(f\"{param_name} must be an integer, but got {type(param_value)}\")\n            if not (0 <= param_value <= 1000):\n                raise ValueError(f\"{param_name} must be between 0 and 1000 inclusive, but got {param_value}\")\n        return True\n\nclass CarrotStock:\n    \"\"\"Manages the remaining carrot stock.\"\"\"\n    def __init__(self, remaining: int):\n        self._remaining = remaining\n\n    def available(self) -> int:\n        \"\"\"Returns the current number of remaining carrots.\"\"\"\n        return self._remaining\n\n    def decrement(self, amount: int) -> None:\n        \"\"\"Reduces the remaining carrots by the specified amount, ensuring non-negativity.\"\"\"\n        self._remaining = max(0, self._remaining - amount)\n\nclass EatResult:\n    \"\"\"Represents the outcome of the eating process.\"\"\"\n    def __init__(self, total_eaten: int, carrots_left: int):\n        self.total_eaten = total_eaten\n        self.carrots_left = carrots_left\n\nclass EatFunction:\n    \"\"\"Encapsulates the core logic for calculating carrot consumption.\"\"\"\n    def computeCarrotsToEat(self, need: int, remaining: int) -> int:\n        \"\"\"Determines the number of carrots to eat, limited by need and remaining stock.\"\"\"\n        return min(need, remaining)\n\n    def eat(self, number: int, need: int, remaining: int) -> EatResult:\n        \"\"\"Calculates the total eaten carrots and remaining stock after a meal.\"\"\"\n        carrots_to_eat = self.computeCarrotsToEat(need, remaining)\n        \n        total_eaten_after_meals = number + carrots_to_eat\n        \n        stock = CarrotStock(remaining)\n        stock.decrement(carrots_to_eat)\n        carrots_left_after_meals = stock.available()\n        \n        return EatResult(total_eaten_after_meals, carrots_left_after_meals)\n\ndef eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    input_params = InputParameters(number, need, remaining)\n    input_params.validate()\n\n    eat_function_logic = EatFunction()\n    result = eat_function_logic.eat(number, need, remaining)\n\n    return [result.total_eaten, result.carrots_left]"}
{"task_id": "HumanEval/156", "solution": "class ValidationResult:\n    \"\"\"Represents the outcome of a validation check.\"\"\"\n    def __init__(self, is_valid: bool, error_message: str = \"\") -> None:\n        self.is_valid = is_valid\n        self.error_message = error_message\n\n    def __bool__(self) -> bool:\n        \"\"\"Allows ValidationResult objects to be used in boolean contexts.\"\"\"\n        return self.is_valid\n\n\nclass ConversionRules:\n    \"\"\"Stores the mapping rules for integer to Roman numeral conversion.\"\"\"\n    def __init__(self) -> None:\n        self.symbol_map = [\n            (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n            (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n            (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n        ]\n        self.subtractive_pairs = ['IV', 'IX', 'XL', 'XC', 'CD', 'CM']\n\n    def get_symbol_map(self) -> list[tuple[int, str]]:\n        \"\"\"Returns the ordered list of (value, symbol) pairs for conversion.\"\"\"\n        return self.symbol_map\n\n\nclass RomanNumeralConverter:\n    \"\"\"Handles validation and conversion of integers to Roman numerals.\"\"\"\n    def __init__(self, rules: 'ConversionRules' | None = None) -> None:\n        self.rules = rules if rules is not None else ConversionRules()\n        self.min_value = 1\n        self.max_value = 1000\n\n    def validateType(self, value) -> 'ValidationResult':\n        \"\"\"Validates if the input value is an integer.\"\"\"\n        if not isinstance(value, int):\n            return ValidationResult(False, \"type must be int\")\n        return ValidationResult(True)\n\n    def validateRange(self, value) -> 'ValidationResult':\n        \"\"\"Validates if the integer is within the allowed range (1 to 1000).\"\"\"\n        if not (self.min_value <= value <= self.max_value):\n            return ValidationResult(False, f\"value must be between {self.min_value} and {self.max_value}\")\n        return ValidationResult(True)\n\n    def applySubtractiveRules(self, number: int) -> str:\n        \"\"\"Converts an integer to its canonical Roman numeral string (uppercase).\"\"\"\n        roman_numeral = []\n        temp_num = number\n        for value, symbol in self.rules.symbol_map:\n            while temp_num >= value:\n                roman_numeral.append(symbol)\n                temp_num -= value\n        return \"\".join(roman_numeral)\n\n    def convert(self, number: int) -> str:\n        \"\"\"Converts a validated integer to its canonical Roman numeral string.\"\"\"\n        return self.applySubtractiveRules(number)\n\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    conv = RomanNumeralConverter()\n\n    type_result = conv.validateType(number)\n    if not type_result.is_valid:\n        return type_result\n\n    range_result = conv.validateRange(number)\n    if not range_result.is_valid:\n        return range_result\n\n    roman_string = conv.convert(number)\n    return roman_string.lower()"}
{"task_id": "HumanEval/160", "solution": "class OperatorList:\n    \"\"\"Holds a list of operator tokens.\"\"\"\n    def __init__(self, operators: list):\n        self.operators = operators\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if all operators are from the allowed set.\"\"\"\n        allowed = {'+', '-', '*', '//', '**'}\n        return all(op in allowed for op in self.operators)\n\nclass OperandList:\n    \"\"\"Holds a list of integer operands.\"\"\"\n    def __init__(self, operands: list):\n        self.operands = operands\n\n    def are_non_negative_integers(self) -> bool:\n        \"\"\"Checks if all operands are non-negative integers.\"\"\"\n        return all(isinstance(op, int) and op >= 0 for op in self.operands)\n\nclass Validator:\n    \"\"\"Validates the input operator and operand lists.\"\"\"\n    allowed_operators = {'+', '-', '*', '//', '**'}\n\n    def validate_counts(self, oplist: list, operands: list) -> None:\n        \"\"\"Raises ValueError if the lengths of operator and operand lists are mismatched.\"\"\"\n        if not (len(oplist) == len(operands) - 1):\n            raise ValueError(\"Operator list length must be one less than operand list length.\")\n\n    def validate_operators(self, oplist: list) -> None:\n        \"\"\"Raises ValueError if any operator token is not allowed.\"\"\"\n        if not all(op in self.allowed_operators for op in oplist):\n            raise ValueError(f\"Unsupported operator found. Allowed: {', '.join(self.allowed_operators)}\")\n\n    def validate_operands(self, operands: list) -> None:\n        \"\"\"Raises ValueError if any operand is not a non-negative integer.\"\"\"\n        if not all(isinstance(op, int) and op >= 0 for op in operands):\n            raise ValueError(\"All operands must be non-negative integers.\")\n\nclass ExpressionBuilder:\n    \"\"\"Builds an infix algebraic expression string.\"\"\"\n    def build_infix(self, oplist: list, operands: list) -> str:\n        \"\"\"Interleaves operands and operators to form an infix expression string.\"\"\"\n        expression_parts = []\n        for i in range(len(oplist)):\n            expression_parts.append(str(operands[i]))\n            expression_parts.append(oplist[i])\n        expression_parts.append(str(operands[-1]))\n        return \" \".join(expression_parts)\n\nclass Evaluator:\n    \"\"\"Evaluates an infix algebraic expression string.\"\"\"\n    def evaluate(self, infix_expr: str) -> int:\n        \"\"\"Evaluates the given infix expression string respecting operator precedence and associativity.\n        It uses Python's built-in `eval` for robust evaluation, which handles precedence,\n        right-associative exponentiation, and raises `ZeroDivisionError` naturally.\n        \"\"\"\n        try:\n            result = eval(infix_expr)\n            return int(result)\n        except ZeroDivisionError:\n            raise # Re-raise directly as per design\n        except Exception as e:\n            raise ValueError(f\"Error evaluating expression: {e}\") from e\n\nclass Result:\n    \"\"\"Container for the integer evaluation result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Error:\n    \"\"\"Container for error details (used internally for structured messaging, though exceptions are raised).\"\"\"\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    oplist_obj = OperatorList(operator)\n    operands_list_obj = OperandList(operand)\n\n    validator = Validator()\n    validator.validate_counts(oplist_obj.operators, operands_list_obj.operands)\n    validator.validate_operators(oplist_obj.operators)\n    validator.validate_operands(operands_list_obj.operands)\n\n    builder = ExpressionBuilder()\n    infix = builder.build_infix(oplist_obj.operators, operands_list_obj.operands)\n\n    evaluator = Evaluator()\n    result_value = evaluator.evaluate(infix)\n\n    return int(result_value)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\n\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/161", "solution": "class Character:\n    def __init__(self, char: str) -> None:\n        self._char = char\n\n    def isLetter(self) -> bool:\n        return self._char.isalpha()\n\n    def isUpper(self) -> bool:\n        return self._char.isupper()\n\n    def isLower(self) -> bool:\n        return self._char.islower()\n\n    def value(self) -> str:\n        return self._char\n\n\nclass InputString:\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    def hasLetters(self) -> bool:\n        for char_val in self._value:\n            if Character(char_val).isLetter():\n                return True\n        return False\n\n    def value(self) -> str:\n        return self._value\n\n\nclass ResultString:\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    def toString(self) -> str:\n        return self._value\n\n\nclass CaseTransformer:\n    def __init__(self) -> None:\n        pass\n\n    def transform(self, s: InputString) -> ResultString:\n        if not s.hasLetters():\n            return self.reverseIfNoLetters(s)\n        \n        transformed_chars = []\n        for char_val in s.value():\n            char_obj = Character(char_val)\n            if char_obj.isLetter():\n                if char_obj.isUpper():\n                    transformed_chars.append(char_val.lower())\n                else: # Assuming it's a lowercase letter if it's a letter but not uppercase\n                    transformed_chars.append(char_val.upper())\n            else:\n                transformed_chars.append(char_val)\n        \n        return ResultString(\"\".join(transformed_chars))\n\n    def reverseIfNoLetters(self, s: InputString) -> ResultString:\n        return ResultString(s.value()[::-1])\n\n\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n    input_string = InputString(s)\n    transformer = CaseTransformer()\n    result_string_obj = transformer.transform(input_string)\n    return result_string_obj.toString()"}
{"task_id": "HumanEval/163", "solution": "class IntegerRange:\n    \"\"\"Represents an inclusive integer range.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.min_value = min(a, b)\n        self.max_value = max(a, b)\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a number is within the range.\"\"\"\n        return self.min_value <= n <= self.max_value\n\nclass EvenDigits:\n    \"\"\"Represents the fixed set of even single-digit integers.\"\"\"\n    def __init__(self) -> None:\n        self.values = [0, 2, 4, 6, 8]\n\n    def is_even_digit(self, n: int) -> bool:\n        \"\"\"Checks if a number is an even single-digit.\"\"\"\n        return n in self.values\n\nclass ResultList:\n    \"\"\"Collects and sorts unique integers.\"\"\"\n    def __init__(self) -> None:\n        self.items = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds a number if not already present.\"\"\"\n        if n not in self.items:\n            self.items.append(n)\n\n    def sort_ascending(self) -> None:\n        \"\"\"Sorts the collected items.\"\"\"\n        self.items.sort()\n\n    def to_list(self) -> list:\n        \"\"\"Returns the collected items as a list.\"\"\"\n        return list(self.items)\n\nclass GenerateIntegers:\n    \"\"\"Orchestrates the process of generating even digits in a range.\"\"\"\n    def validate_input(self, a: int, b: int) -> bool:\n        # Per strict requirement, validation checks and ValueError are omitted.\n        return True\n\n    def generate(self, a: int, b: int) -> list:\n        self.validate_input(a, b)\n\n        integer_range = IntegerRange(a, b)\n        even_digits_source = EvenDigits()\n        result_list = ResultList()\n\n        for digit in even_digits_source.values:\n            if integer_range.contains(digit):\n                result_list.add(digit)\n\n        result_list.sort_ascending()\n        return result_list.to_list()\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    generator = GenerateIntegers()\n    return generator.generate(a, b)"}
