{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the first four values of the sequence\n    # [fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1)]\n    # For n=4, we need fib4(0), fib4(1), fib4(2), fib4(3)\n    # The list holds [fib4(0), fib4(1), fib4(2), fib4(3)]\n    prev_values = [0, 0, 2, 0]\n\n    for i in range(4, n + 1):\n        # Calculate the current fib4(i) value\n        current_fib4 = sum(prev_values)\n        \n        # Shift the values: remove the oldest and add the new current_fib4\n        prev_values[0] = prev_values[1]\n        prev_values[1] = prev_values[2]\n        prev_values[2] = prev_values[3]\n        prev_values[3] = current_fib4\n    \n    # After the loop, prev_values[3] holds fib4(n)\n    return prev_values[3]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # For odd length lists, the median is the middle element.\n        return sorted_list[n // 2]\n    else:\n        # For even length lists, the median is the average of the two middle elements.\n        mid = n // 2\n        return (sorted_list[mid - 1] + sorted_list[mid]) / 2.0"}
