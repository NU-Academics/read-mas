{"task_id": "HumanEval/31", "solution": "```\n# prime_checker_app.py\nimport math\nfrom typing import List, Optional\n\nfrom fastapi import FastAPI, HTTPException, status, Query\nfrom fastapi.responses import HTMLResponse\nfrom fastapi.staticfiles import StaticFiles\nfrom pathlib import Path\n\n# --- Core Primality Logic ---\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is a prime number using an optimized trial division method.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True # 2 and 3 are prime\n    if n % 2 == 0 or n % 3 == 0:\n        return False # multiples of 2 or 3\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\n# --- FastAPI Application Setup ---\napp = FastAPI(\n    title=\"Prime Number Checker API\",\n    description=\"API to check primality of numbers and find primes in a range.\",\n    version=\"1.0.0\",\n)\n\n# Serve static files (like the frontend HTML, CSS, JS)\nstatic_dir = Path(\"static\")\nstatic_dir.mkdir(exist_ok=True) # Ensure the static directory exists\n\napp.mount(\"/static\", StaticFiles(directory=static_dir), name=\"static\")\n\n# --- Constants for input validation (based on NFRs) ---\n# For single number check (FR1): up to 10^7 response within 500ms\n# The optimized trial division is typically fast enough for 10^7 - 10^8\nMAX_SINGLE_NUMBER_CHECK = 10**8 \n\n# For range check (FR2): up to 10^5 numbers in range response within 2s\nMAX_RANGE_SIZE = 10**5 \n\n# --- API Endpoints ---\n\n@app.get(\"/api/prime/check/{n}\", summary=\"Check if a single number is prime\")\nasync def check_single_primality(n: int):\n    \"\"\"\n    Checks if a given integer `n` is a prime number.\n\n    - **n**: The integer to check.\n    \"\"\"\n    if n < 1:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=\"Input 'n' must be a positive integer.\")\n    if n > MAX_SINGLE_NUMBER_CHECK:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=f\"Number too large for efficient processing. Max allowed is {MAX_SINGLE_NUMBER_CHECK}.\")\n\n    is_prime_result = is_prime(n)\n    return {\"number\": n, \"is_prime\": is_prime_result}\n\n@app.get(\"/api/prime/range\", summary=\"Find prime numbers within a specified range\")\nasync def find_primes_in_range(start: int = Query(..., description=\"Start of the range (inclusive)\"),\n                                 end: int = Query(..., description=\"End of the range (inclusive)\")):\n    \"\"\"\n    Finds all prime numbers within an inclusive range `[start, end]`.\n\n    - **start**: The beginning of the range.\n    - **end**: The end of the range.\n    \"\"\"\n    if start < 1 or end < 1:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=\"Both 'start' and 'end' must be positive integers.\")\n    if start > end:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=\"'start' must be less than or equal to 'end'.\")\n\n    range_size = end - start + 1\n    if range_size > MAX_RANGE_SIZE:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST,\n                            detail=f\"Range too large for efficient processing. Max allowed range size is {MAX_RANGE_SIZE}.\")\n    \n    # Also ensure individual numbers within the range are not excessively large\n    if end > MAX_SINGLE_NUMBER_CHECK: \n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST,\n                            detail=f\"Individual numbers in the range are too large. Max allowed value for 'end' is {MAX_SINGLE_NUMBER_CHECK}.\")\n\n\n    primes = [n for n in range(start, end + 1) if is_prime(n)]\n    return {\"start\": start, \"end\": end, \"primes\": primes}\n\n# --- Frontend HTML Endpoint ---\n@app.get(\"/\", response_class=HTMLResponse, include_in_schema=False)\nasync def serve_frontend():\n    \"\"\"\n    Serves the main HTML page for the Prime Number Checker UI.\n    \"\"\"\n    try:\n        with open(static_dir / \"index.html\", \"r\") as f:\n            return f.read()\n    except FileNotFoundError:\n        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Frontend HTML not found. Ensure 'index.html' is in the 'static' directory.\")\n\n```"}
{"task_id": "HumanEval/31", "solution": "import math\n\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is prime.\n\n    A prime number is a natural number greater than 1 that has no positive\n    divisors other than 1 and itself.\n\n    >>> is_prime(2)\n    True\n    >>> is_prime(3)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(17)\n    True\n    >>> is_prime(0)\n    False\n    >>> is_prime(1)\n    False\n    >>> is_prime(-5)\n    False\n    >>> is_prime(97)\n    True\n    >>> is_prime(100)\n    False\n    \"\"\"\n    # F.4: Handle non-positive numbers and 1\n    if n <= 1:\n        return False\n\n    # F.2, F.3: Handle the smallest prime number (2)\n    if n == 2:\n        return True\n\n    # F.3: Handle all other even numbers (not prime)\n    if n % 2 == 0:\n        return False\n\n    # F.2, F.3: Check for odd divisors from 3 up to sqrt(n)\n    # We only need to check up to the square root of n because if n has a\n    # divisor greater than its square root, it must also have a divisor\n    # smaller than its square root.\n    # The step of 2 is used because we've already handled even numbers.\n    # math.isqrt provides an integer square root, which is efficient.\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n\n    # F.2: If no divisors are found, the number is prime\n    return True"}
{"task_id": "HumanEval/31", "solution": "```python\nimport math\nfrom typing import Optional\n\nfrom fastapi import FastAPI, HTTPException, Query\n\napp = FastAPI()\n\n# Max supported number based on the performance requirements (up to 10^18)\n# and common 64-bit integer limits. Processing numbers significantly larger\n# than this would violate the \"efficient processing\" NFR.\nMAX_SUPPORTED_NUMBER = 2**63 - 1  # Corresponds to max 64-bit signed integer\n\n\ndef is_prime_optimized(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    Optimized for performance using trial division.\n\n    Args:\n        n (int): The integer to test for primality.\n\n    Returns:\n        bool: True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime numbers\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False  # Divisible by 2 or 3, so not prime\n\n    # Check for factors from 5 onwards\n    # All primes greater than 3 can be expressed in the form 6k \u00b1 1.\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\n\n@app.get(\"/is_prime\")\nasync def get_is_prime(\n    number: Optional[str] = Query(None, description=\"The integer to test for primality.\")\n):\n    \"\"\"\n    Determines if a given number is prime.\n\n    Args:\n        number (str, optional): The integer to test for primality.\n                                This parameter is required.\n\n    Returns:\n        dict: A JSON object containing the number and a boolean indicating\n              if it is prime.\n\n    Raises:\n        HTTPException:\n            - 400 Bad Request if 'number' parameter is missing.\n            - 400 Bad Request if 'number' parameter is not a valid integer.\n            - 400 Bad Request if 'number' parameter is too large for\n              efficient processing.\n            - 500 Internal Server Error for unexpected issues.\n    \"\"\"\n    if number is None:\n        raise HTTPException(\n            status_code=400,\n            detail={\"error\": \"Missing 'number' parameter.\"}\n        )\n\n    try:\n        n_int = int(number)\n    except ValueError:\n        raise HTTPException(\n            status_code=400,\n            detail={\"error\": \"'number' parameter must be an integer.\"}\n        )\n\n    if n_int > MAX_SUPPORTED_NUMBER:\n        # Prevent excessively long computation times for very large numbers,\n        # adhering to NFR1 performance targets.\n        raise HTTPException(\n            status_code=400,\n            detail={\n                \"error\": (\n                    f\"'number' is too large for efficient processing. \"\n                    f\"Max supported: {MAX_SUPPORTED_NUMBER}.\"\n                )\n            }\n        )\n\n    try:\n        is_prime_result = is_prime_optimized(n_int)\n    except Exception as e:\n        # Catch any unexpected errors during primality test calculation\n        raise HTTPException(\n            status_code=500,\n            detail={\"error\": f\"An internal server error occurred: {str(e)}.\"}\n        )\n\n    return {\n        \"number\": n_int,\n        \"is_prime\": is_prime_result\n    }\n```"}
{"task_id": "HumanEval/31", "solution": "```python\nimport math\nfrom fastapi import FastAPI, HTTPException, Query\nfrom fastapi.responses import JSONResponse\nfrom fastapi.exceptions import RequestValidationError\nfrom pydantic import BaseModel, ValidationError\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:  # multiples of 2 or 3 are not prime\n        return False\n\n    # Optimized trial division: check divisors of the form 6k \u00b1 1\n    # All primes greater than 3 can be expressed in the form 6k \u00b1 1.\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\napp = FastAPI(\n    title=\"Prime Number Checker API\",\n    description=\"A simple API to check if a number is prime.\",\n    version=\"1.0.0\"\n)\n\nclass PrimeCheckResponse(BaseModel):\n    number: int\n    is_prime: bool\n\n# Custom exception handler for RequestValidationError (e.g., invalid query parameters)\n@app.exception_handler(RequestValidationError)\nasync def validation_exception_handler(request, exc):\n    \"\"\"\n    Handles validation errors for request parameters, ensuring HTTP 400 Bad Request\n    is returned with a consistent error message as per SRS FR2.\n    \"\"\"\n    for error in exc.errors():\n        # Check if the error specifically indicates a missing 'number' parameter\n        if error.get(\"loc\") == (\"query\", \"number\") and error.get(\"type\") == \"value_error.missing\":\n            return JSONResponse(\n                status_code=400,\n                content={\"error\": \"Missing required parameter: 'number'.\"}\n            )\n        # Check if the error indicates a type mismatch for 'number'\n        if error.get(\"loc\") == (\"query\", \"number\") and (\n            error.get(\"type\") == \"type_error.integer\" or \n            \"value is not a valid integer\" in error.get(\"msg\", \"\").lower()\n        ):\n            return JSONResponse(\n                status_code=400,\n                content={\"error\": \"Invalid input: 'number' parameter must be an integer.\"}\n            )\n\n    # Fallback for other potential validation errors, though the above should cover FR2.\n    return JSONResponse(\n        status_code=400,\n        content={\"error\": \"Invalid input: 'number' parameter must be an integer.\"}\n    )\n\n\n@app.exception_handler(Exception)\nasync def global_exception_handler(request, exc):\n    \"\"\"\n    Handles any unhandled exceptions, returning an HTTP 500 Internal Server Error\n    with a generic message as per SRS 3.3.3.\n    \"\"\"\n    # In a production environment, logging the exception details here is crucial.\n    # import logging\n    # logging.error(f\"Unhandled exception: {exc}\", exc_info=True)\n    return JSONResponse(\n        status_code=500,\n        content={\"error\": \"An unexpected error occurred. Please try again later.\"}\n    )\n\n@app.get(\"/is-prime\", response_model=PrimeCheckResponse, summary=\"Check if a number is prime\")\nasync def check_prime_number(\n    number: int = Query(\n        ...,  # This parameter is required\n        description=\"The integer to check for primality\",\n        # Defining typical 64-bit signed integer limits for robust validation\n        ge=-9223372036854775808,  # -2**63\n        le=9223372036854775807     # 2**63 - 1\n    )\n):\n    \"\"\"\n    Checks if the provided integer `number` is a prime number.\n    Returns `true` if prime, `false` otherwise.\n\n    - **number**: The integer to be evaluated for primality.\n    \"\"\"\n    # Pydantic's Query validation handles missing, non-integer, and out-of-range inputs\n    # by raising RequestValidationError, which is caught by our custom handler.\n    # The `is_prime` function then determines the primality for valid integer inputs.\n    \n    result = is_prime(number)\n    return {\"number\": number, \"is_prime\": result}\n```"}
{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n):\n    \"\"\"\n    Determines if a given integer n is a prime number.\n\n    Args:\n        n (int): The integer to check for primality.\n\n    Returns:\n        bool: True if n is a prime number, False otherwise.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    # FR-5: Input Validation\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    # FR-1: Handle numbers less than or equal to 1\n    if n <= 1:\n        return False\n\n    # FR-2: Handle 2 (the only even prime number)\n    if n == 2:\n        return True\n\n    # FR-3: Handle all other even numbers greater than 2\n    if n % 2 == 0:\n        return False\n\n    # FR-4: Optimized Trial Division for odd numbers greater than 2\n    # We only need to check for divisors up to the square root of n.\n    # We start checking from 3 and increment by 2 (skipping even numbers).\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n\n    # If no divisors were found, n is prime\n    return True\n```"}
{"task_id": "HumanEval/31", "solution": "```python\nimport math\n\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determines whether a given integer n is a prime number.\n\n    A prime number is a natural number greater than 1 that has no positive\n    divisors other than 1 and itself.\n\n    Args:\n        n: An integer to be checked for primality.\n\n    Returns:\n        True if n is a prime number, False otherwise.\n    \"\"\"\n    # Step 1: Handle edge cases (n <= 1)\n    if n <= 1:\n        return False\n\n    # Step 2 & 3: Iterate and check divisors for n > 1\n    # We only need to check for divisors up to the square root of n.\n    # math.isqrt(n) returns the integer square root of n.\n    # The loop range should include the integer square root.\n    for i in range(2, math.isqrt(n) + 1):\n        if n % i == 0:\n            return False  # Found a divisor, so n is not prime\n\n    # If the loop completes without finding any divisors, n is prime\n    return True\n```"}
