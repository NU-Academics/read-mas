{"task_id": "HumanEval/30", "solution": "```python\nfrom fastapi import FastAPI, status\nfrom fastapi.exceptions import RequestValidationError\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel, Field\nfrom starlette.exceptions import HTTPException as StarletteHTTPException\nimport logging\n\n# Configure logging for monitoring and debugging (NFR-R-002)\n# In a production environment, this would typically be configured to\n# output to structured logs or a log aggregation service.\nlogging.basicConfig(level=logging.INFO, format='%asctime)s - %levelname)s - %message)s')\nlogger = logging.getLogger(__name__)\n\n# Initialize FastAPI application (NFR-M-001 - well-documented)\napp = FastAPI(\n    title=\"Positive Number Filter Service\",\n    description=\"A stateless microservice designed to filter positive numbers from a given list, exposing a RESTful API.\",\n    version=\"1.0.0\",\n)\n\n# 3.1 Input Data Structure: Request Model (FR-002)\nclass NumberListRequest(BaseModel):\n    numbers: list[float | int] = Field(\n        ...,\n        description=\"An array of numbers (integers or floats) to be filtered. \"\n                    \"This field is mandatory and must contain only numeric values.\",\n        example=[-1, 2, -4, 5, 6, 0, 3.14, -2.5]\n    )\n\n# 3.2 Output Data Structure: Success Response Model (FR-008)\nclass PositiveNumberListResponse(BaseModel):\n    positive_numbers: list[float | int] = Field(\n        ...,\n        description=\"An array containing only the positive numbers (greater than zero) \"\n                    \"from the original input list.\",\n        example=[2, 5, 6, 3.14]\n    )\n\n# 3.2 Output Data Structure: Error Response Model (FR-005)\nclass ErrorResponse(BaseModel):\n    error: str = Field(\n        ...,\n        description=\"A descriptive error message indicating what went wrong with the request.\",\n        example=\"Invalid input: 'numbers' field must be an array of numeric values.\"\n    )\n\n# 4.3 Business Logic: Core filtering function (FR-006)\ndef get_positive_numbers_logic(numbers: list[float | int]) -> list[float | int]:\n    \"\"\"\n    Filters a list of numbers, returning a new list containing only those\n    numbers that are strictly greater than zero.\n\n    Args:\n        numbers: A list of integers or floats.\n\n    Returns:\n        A list of positive integers or floats.\n    \"\"\"\n    # This list comprehension provides O(N) performance, fulfilling NFR-P-001 for typical lists.\n    positive_numbers = [num for num in numbers if num > 0]\n    return positive_numbers\n\n# Custom Exception Handler for Pydantic validation errors (FR-005)\n# This converts FastAPI's default 422 Unprocessable Entity for Pydantic errors\n# into a 400 Bad Request with a custom message, as required by FR-005.\n@app.exception_handler(RequestValidationError)\nasync def validation_exception_handler(request, exc: RequestValidationError):\n    \"\"\"\n    Handles Pydantic `RequestValidationError` by returning an HTTP 400 Bad Request\n    with an informative error message, adhering to FR-005.\n    \"\"\"\n    error_detail = exc.errors()\n    error_message = \"Invalid request body.\"  # Default fallback message\n\n    if error_detail:\n        first_error = error_detail[0]\n        loc = first_error.get('loc')\n        msg = first_error.get('msg')\n\n        if loc and len(loc) > 1 and loc[0] == 'body' and loc[1] == 'numbers':\n            # Specific validation issues related to the 'numbers' field (FR-003, FR-004)\n            if 'field required' in msg:\n                error_message = \"'numbers' field is required.\"\n            elif 'value is not a valid list' in msg or 'value is not a valid array' in msg:\n                error_message = \"'numbers' field must be a valid JSON array.\"\n            elif 'not a valid float' in msg or 'not a valid integer' in msg:\n                # Attempt to pinpoint the exact index if available\n                if len(loc) == 3 and isinstance(loc[2], int):\n                    error_message = f\"Element at index {loc[2]} in 'numbers' array is not a valid number.\"\n                else:\n                    error_message = \"All elements in 'numbers' array must be valid numbers (integers or floats).\"\n            else:\n                error_message = f\"Invalid input for 'numbers' field: {msg}\"\n        elif loc and loc[0] == 'body' and len(loc) == 1:\n            # General body parsing error (e.g., non-JSON body when application/json is expected)\n            error_message = \"Invalid JSON request body: Expected a JSON object.\"\n        else:\n            # Fallback for other less specific Pydantic errors\n            error_message = f\"Invalid request input: {msg}\"\n    \n    logger.warning(f\"Validation error (HTTP 400): {error_message} | Details: {error_detail}\")\n    return JSONResponse(\n        status_code=status.HTTP_400_BAD_REQUEST,\n        content=ErrorResponse(error=error_message).model_dump()\n    )\n\n# Custom Exception Handler for general HTTPExceptions (e.g., 404 Not Found)\n@app.exception_handler(StarletteHTTPException)\nasync def http_exception_handler(request, exc: StarletteHTTPException):\n    \"\"\"\n    Handles general Starlette HTTPExceptions (e.g., 404 Not Found, or manual raises)\n    and formats them consistently using the ErrorResponse model.\n    \"\"\"\n    logger.error(f\"HTTP Error (Status {exc.status_code}): {exc.detail}\")\n    return JSONResponse(\n        status_code=exc.status_code,\n        content=ErrorResponse(error=exc.detail).model_dump()\n    )\n\n\n# 4.1 Positive Number Filtering Endpoint (ID: SF-001)\n@app.post(\n    \"/api/v1/filter/positive\",  # FR-001\n    response_model=PositiveNumberListResponse,\n    status_code=status.HTTP_200_OK,  # FR-007\n    responses={\n        status.HTTP_400_BAD_REQUEST: {\"model\": ErrorResponse, \"description\": \"Invalid Request Input (FR-005)\"}\n    },\n    summary=\"Filter a list of numbers to retrieve only positive ones (SF-001)\",\n    description=\"Accepts a JSON array of numbers and returns a new JSON array containing only numbers strictly greater than zero. \"\n                \"This endpoint performs robust input validation and returns an informative error for invalid requests.\"\n)\nasync def filter_positive_numbers(request: NumberListRequest):\n    \"\"\"\n    Processes an input array of numbers (`numbers` field in JSON request body)\n    and returns a filtered list containing only positive numbers.\n\n    - **Input Validation (FR-003, FR-004):** Handled automatically by Pydantic during deserialization\n      of `NumberListRequest`. Non-conforming inputs (e.g., `numbers` not an array, or containing\n      non-numeric elements) trigger a `RequestValidationError`, which is then processed by\n      the custom `validation_exception_handler` to return HTTP 400.\n    - **Core Filtering (FR-006):** Numbers strictly greater than zero are retained.\n    - **Response (FR-007, FR-008):** Returns HTTP 200 OK with a JSON object containing the\n      `positive_numbers` array.\n    \"\"\"\n    logger.info(f\"Received request for /api/v1/filter/positive. Input list size: {len(request.numbers)}\")\n\n    # Call the core business logic function\n    positive_numbers = get_positive_numbers_logic(request.numbers)\n\n    # Prepare and return the successful JSON response\n    response = PositiveNumberListResponse(positive_numbers=positive_numbers)\n    logger.info(f\"Successfully filtered positive numbers. Output list size: {len(positive_numbers)}\")\n    return response\n\n# To run this service:\n# 1. Ensure you have FastAPI and Uvicorn installed:\n#    pip install \"fastapi[all]\" uvicorn\n# 2. Save the code above as `main.py`.\n# 3. Run the application using Uvicorn:\n#    uvicorn main:app --host 0.0.0.0 --port 8000\n#\n# For production deployments, consider using Gunicorn with Uvicorn workers:\n#    gunicorn -w 4 -k uvicorn.workers.UvicornWorker main:app -b 0.0.0.0:8000\n#\n# Access the API documentation (Swagger UI) at: http://localhost:8000/docs\n# Access the alternative API documentation (ReDoc) at: http://localhost:8000/redoc\n```"}
