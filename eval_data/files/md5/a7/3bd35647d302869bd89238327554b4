{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Calculates the deepest level of nesting for multiple groups of parentheses\n    provided in a single string.\n\n    Args:\n        paren_string: A string where individual parenthesis groups are separated\n                      by single spaces. Each group will consist only of '(' and ')'\n                      characters.\n\n    Returns:\n        A list of integers, where each integer corresponds to the maximum nesting\n        depth of a respective parenthesis group from the input string.\n    \"\"\"\n    results: List[int] = []\n    \n    # FR2: Group Separation - Split the string based on space characters.\n    paren_groups = paren_string.split(' ')\n\n    # Iterate through each identified group of parentheses\n    for group in paren_groups:\n        current_depth: int = 0\n        max_depth_for_group: int = 0\n\n        # FR3: Nesting Depth Calculation - Iterate through characters in the group\n        for char in group:\n            if char == '(':\n                # The nesting depth increases by 1 for each opening parenthesis '('.\n                current_depth += 1\n            elif char == ')':\n                # The nesting depth decreases by 1 for each closing parenthesis ')'.\n                current_depth -= 1\n            \n            # The maximum depth reached during the traversal of a group is its nesting depth.\n            max_depth_for_group = max(max_depth_for_group, current_depth)\n        \n        # FR4: Output Generation - Store the maximum depth for the current group.\n        results.append(max_depth_for_group)\n            \n    return results\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Calculates the rolling maximum for a given list of integers.\n\n    :param numbers: A list of integers.\n    :return: A list where each element at index i is the maximum value\n             found in numbers[0...i].\n    \"\"\"\n    result = []\n    \n    if not numbers:\n        return result\n        \n    current_max = numbers[0]\n    result.append(current_max)\n    \n    for i in range(1, len(numbers)):\n        current_number = numbers[i]\n        if current_number > current_max:\n            current_max = current_number\n        result.append(current_max)\n        \n    return result\n```"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a string representing musical notes in a special ASCII format\n    and returns a list of integers corresponding to how many beats each\n    note lasts.\n\n    Legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quarter note, lasts one beat\n\n    Args:\n        music_string (str): A string representing musical notes, space-separated.\n\n    Returns:\n        List[int]: A list of integers, each representing the beat duration of a note.\n\n    Raises:\n        KeyError: If an unrecognized note token is found in the input string\n                  (assuming strict adherence to defined note types).\n\n    Example:\n        >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n        [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    note_map = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    note_tokens = music_string.split()\n    result_list = []\n\n    for token in note_tokens:\n        result_list.append(note_map[token])\n\n    return result_list\n```"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Converts a special ASCII musical notation string into a list of integer beat durations.\n\n    Args:\n        music_string (str): The input string representing musical notes in a special\n                            ASCII format, e.g., 'o o| .|'. Notes are separated by single spaces.\n\n    Returns:\n        List[int]: A list of integers, where each integer denotes the beat duration\n                   of a parsed note. Returns an empty list if the input string is empty\n                   or contains only whitespace.\n    \"\"\"\n    # Define note_durations mapping as specified in the SRS/SDD\n    note_durations = {\n        'o': 4,   # Whole note\n        'o|': 2,  # Half note\n        '.|': 1   # Quarter note\n    }\n\n    # Initialize the list to store beat durations\n    beats_list: List[int] = []\n\n    # Handle empty or whitespace-only input strings\n    if not music_string.strip():\n        return beats_list\n\n    # Tokenize the input string by splitting it at each space character\n    # This will produce a list of note symbols (tokens)\n    tokens = music_string.split(' ')\n\n    # Iterate through each token and map it to its corresponding beat duration\n    for token in tokens:\n        # Check if the token is a recognized note symbol\n        if token in note_durations:\n            # If recognized, append its beat duration to the results list\n            beats_list.append(note_durations[token])\n        # Unrecognized tokens (e.g., empty strings from multiple spaces, or invalid symbols)\n        # are implicitly ignored as per the design's \"Implicit Handling of Unknown Notes\".\n\n    # Return the final list of beat durations\n    return beats_list\n```"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\nNOTE_BEAT_MAP = {\n    'o': 4,   # whole note\n    'o|': 2,  # half note\n    '.|': 1   # quarter note\n}\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a specific ASCII musical notation string and converts it into a list\n    of beat durations.\n\n    Args:\n        music_string: A string containing space-separated musical notes\n                      (e.g., 'o o| .|').\n\n    Returns:\n        A list of integers, where each integer corresponds to the beat duration\n        of a parsed note.\n\n    Raises:\n        ValueError: If any note token within the input `music_string` does not\n                    correspond to a defined note in the `NOTE_BEAT_MAP`.\n    \"\"\"\n    # 1. Initial Input Check: Handle empty or whitespace-only input\n    if not music_string or music_string.strip() == '':\n        return []\n\n    # 2. String Tokenization: Split the music_string into individual note tokens\n    note_strings = music_string.split()\n\n    # 3. Note Mapping and Aggregation\n    beat_durations: List[int] = []\n    for note_string in note_strings:\n        # Attempt to retrieve its corresponding beat value\n        beat = NOTE_BEAT_MAP.get(note_string)\n\n        # Error Handling: If a note_string is not found, raise ValueError\n        if beat is None:\n            raise ValueError(f\"Unrecognized musical note: '{note_string}'\")\n\n        # If recognized, append its integer beat duration\n        beat_durations.append(beat)\n\n    # 4. Result Return\n    return beat_durations\n```"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a special ASCII musical notation string into a list of beat durations.\n\n    The function recognizes 'o' (whole note, 4 beats), 'o|' (half note, 2 beats),\n    and '.|' (quarter note, 1 beat). Unrecognized patterns are ignored.\n\n    Args:\n        music_string (str): A string containing space-separated musical note representations.\n\n    Returns:\n        List[int]: A list of integers, where each integer represents the beat\n                   duration of a parsed note in the order they appear in the input string.\n    \"\"\"\n    note_to_beats_map = {\n        'o': 4,   # Whole note\n        'o|': 2,  # Half note\n        '.|': 1   # Quarter note\n    }\n\n    result_beats: List[int] = []\n\n    # Split the input string into individual note tokens.\n    # str.split() without arguments handles arbitrary whitespace and returns\n    # a list of non-empty strings, effectively dealing with multiple spaces\n    # between tokens and leading/trailing whitespace.\n    note_tokens = music_string.split()\n\n    for token in note_tokens:\n        # Check if the token is a recognized note pattern\n        beats = note_to_beats_map.get(token)\n        if beats is not None:\n            result_beats.append(beats)\n        # If 'beats' is None, the token is unrecognized, and we simply ignore it\n        # as per FR1.5 and the detailed design.\n\n    return result_beats"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\n_NOTE_BEAT_MAP = {\n    'o': 4,   # Whole note\n    'o|': 2,  # Half note\n    '.|': 1   # Quarter note\n}\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a string representing musical notes and returns a list of their beat durations.\n\n    Args:\n        music_string (str): A string containing space-separated musical note symbols.\n\n    Returns:\n        List[int]: An ordered list of integers, where each integer represents the\n                   beat duration of a parsed note.\n\n    Raises:\n        ValueError: If an unknown musical note symbol is encountered in the input string.\n    \"\"\"\n    result_beats: List[int] = []\n    \n    # Split the input string by whitespace. str.split() handles multiple spaces\n    # and leading/trailing whitespace correctly, returning an empty list for\n    # empty or whitespace-only input after filtering out empty strings.\n    note_symbols = music_string.split()\n\n    for symbol in note_symbols:\n        if symbol in _NOTE_BEAT_MAP:\n            result_beats.append(_NOTE_BEAT_MAP[symbol])\n        else:\n            raise ValueError(f\"Unknown musical note symbol: '{symbol}'\")\n            \n    return result_beats\n```"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of musical notes and returns a list of their beat durations.\n    \"\"\"\n    beats_list: List[int] = []\n\n    note_to_beats_map = {\n        'o': 4,   # Whole note\n        'o|': 2,  # Half note\n        '.|': 1   # Quarter note\n    }\n\n    if not music_string:\n        return []\n\n    individual_notes = music_string.split(' ')\n\n    for note in individual_notes:\n        # As per SRS FR6, explicit error handling for unknown notes is not required.\n        # It's assumed valid inputs are always provided.\n        beats = note_to_beats_map[note]\n        beats_list.append(beats)\n\n    return beats_list\n```"}
