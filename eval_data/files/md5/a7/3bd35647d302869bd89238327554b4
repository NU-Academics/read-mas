{"task_id": "HumanEval/26", "solution": "```python\nimport sys\nimport argparse\nimport ast\nfrom collections import Counter\nfrom typing import List\n\nclass InputParser:\n    \"\"\"\n    Handles parsing and validation of the input string into a list of integers.\n    \"\"\"\n    @staticmethod\n    def parse(input_string: str) -> List[int]:\n        \"\"\"\n        Parses a string representing a Python list of integers and validates its content.\n\n        Args:\n            input_string: A string representing a Python list (e.g., \"[1, 2, 3]\").\n\n        Returns:\n            A list of integers.\n\n        Raises:\n            ValueError: If the input string is not a valid list literal, or\n                        if it contains non-integer elements.\n        \"\"\"\n        try:\n            # Safely evaluate the string as a Python literal.\n            # This prevents execution of arbitrary code, adhering to security design.\n            parsed_collection = ast.literal_eval(input_string)\n        except (ValueError, SyntaxError) as e:\n            raise ValueError(f\"Invalid input format. Input must be a valid Python list literal. Details: {e}\")\n\n        # Ensure the parsed result is a list or tuple (which can be iterated over)\n        if not isinstance(parsed_collection, (list, tuple)):\n            raise ValueError(\"Invalid input format. Input must represent a list or tuple.\")\n\n        # Validate that all elements are integers\n        result_list = []\n        for i, item in enumerate(parsed_collection):\n            if not isinstance(item, int):\n                raise ValueError(\n                    f\"Invalid list content at index {i}. All elements must be integers. \"\n                    f\"Found type {type(item).__name__} for value '{item}'.\"\n                )\n            result_list.append(item)\n            \n        return result_list\n\n\nclass DuplicateRemoverCore:\n    \"\"\"\n    Implements the core logic for identifying and removing elements that occur more than once,\n    preserving the order of unique elements.\n    \"\"\"\n    @staticmethod\n    def remove_duplicates(numbers: List[int]) -> List[int]:\n        \"\"\"\n        Processes a list of integers to identify and remove elements that occur more than once,\n        preserving the relative order of the remaining unique elements.\n\n        This implementation uses a two-pass approach to achieve O(N) time complexity\n        and O(N) space complexity.\n\n        Args:\n            numbers: A list of integers.\n\n        Returns:\n            A new list containing only elements that appear exactly once in the input list,\n            maintaining their original relative order.\n        \"\"\"\n        if not numbers:\n            return []\n\n        # First pass: Count frequencies of all numbers.\n        # collections.Counter is optimized for this.\n        # Time: O(N), Space: O(N) in worst case (all elements unique).\n        counts = Counter(numbers)\n\n        # Second pass: Build the result list by iterating through the original\n        # list again and appending only elements with a count of 1.\n        # This preserves the relative order of unique elements.\n        # Time: O(N).\n        result = []\n        for number in numbers:\n            if counts[number] == 1:\n                result.append(number)\n        \n        return result\n\n\nclass OutputFormatter:\n    \"\"\"\n    Handles formatting the processed list of unique integers into a user-friendly string format.\n    \"\"\"\n    @staticmethod\n    def format(processed_list: List[int]) -> str:\n        \"\"\"\n        Converts a list of integers into its string representation, similar to Python's list repr.\n\n        Args:\n            processed_list: A list of integers.\n\n        Returns:\n            A string representation of the list (e.g., \"[1, 3, 4]\").\n        \"\"\"\n        # Python's built-in str() for a list already provides the desired format.\n        return str(processed_list)\n\n\ndef main():\n    \"\"\"\n    Main entry point for the Command Line Interface (CLI) application.\n    Orchestrates input parsing, duplicate removal, and output formatting.\n    Handles command-line arguments and error reporting.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Process a list of integers to return a new list containing \"\n                    \"only elements that appear exactly once, maintaining their relative order.\"\n    )\n    parser.add_argument(\n        \"input_list_str\",\n        type=str,\n        help=\"A Python-style string representation of a list of integers, \"\n             \"e.g., \\\"[1, 2, 3, 2, 4]\\\"\"\n    )\n\n    args = parser.parse_args()\n\n    try:\n        # FR-1: Input Processing\n        input_numbers = InputParser.parse(args.input_list_str)\n\n        # FR-2: Duplicate Removal Logic (Core processing)\n        unique_numbers = DuplicateRemoverCore.remove_duplicates(input_numbers)\n\n        # FR-3: Output Generation\n        output_str = OutputFormatter.format(unique_numbers)\n        sys.stdout.write(output_str + \"\\n\")\n        sys.exit(0)  # Indicate successful execution\n        \n    except ValueError as e:\n        # Catch validation and parsing errors\n        sys.stderr.write(f\"Error: {e}\\n\")\n        sys.exit(1)  # Indicate an error and exit with non-zero status\n    except Exception as e:\n        # Catch any other unexpected errors\n        sys.stderr.write(f\"An unexpected error occurred: {e}\\n\")\n        sys.exit(1) # Indicate an unexpected error and exit with non-zero status\n\nif __name__ == \"__main__\":\n    main()\n```"}
