air: Tuple[float, float] = (sorted_numbers[0], sorted_numbers[1])\n\n    # Iterate through the sorted list, comparing each element with its successor.\n    # Time complexity: O(N)\n    for i in range(len(sorted_numbers) - 1):\n        n1 = sorted_numbers[i]\n        n2 = sorted_numbers[i+1]\n        current_diff = abs(n1 - n2)\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (n1, n2)\n            # Optimization: If min_diff is 0, we can't get any closer, so return early.\n            if min_diff == 0:\n                return closest_pair\n\n    # Return the pair with the smallest difference found.\n    # Since the list was sorted, n1 will always be <= n2, satisfying the output order requirement.\n    return closest_pair\n\n```"}
