ups.append(current_group)\n            start_index = i + 1\n\n    return groups\n```"}
{"task_id": "HumanEval/1", "solution": "```python\ndef separate_parenthesis_groups(input_string: str) -> list[str]:\n    \"\"\"\n    Separates an input string containing multiple, non-nested, balanced\n    groups of parentheses into a list of individual group strings.\n    Spaces in the input string are ignored.\n\n    Args:\n        input_string (str): The string containing parenthesis groups.\n                            Example: '( ) (( )) (( )( ))'\n\n    Returns:\n        list[str]: A list of strings, where each string is a balanced\n                   parenthesis group.\n                   Example: ['()', '(())', '(()())']\n    \"\"\"\n    # 1. Clean Input String\n    cleaned_string = input_string.replace(\" \", \"\")\n\n    # 2. Initialize Variables\n    groups = []\n    balance_counter = 0\n    current_group_start_index = 0\n\n    # 3. Iterate and Parse\n    for index, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        # Group Completion Check\n        if balance_counter == 0:\n            # Extract the substring\n            group = cleaned_string[current_group_start_index : index + 1]\n            # Add this group to the groups list\n            groups.append(group)\n            # Update current_group_start_index for the next potential group\n            current_group_start_index = index + 1\n\n    # 4. Return Result\n    return groups\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates an input string into distinct, balanced, top-level groups of\n    parentheses, ignoring spaces.\n\n    Args:\n        paren_string: A string containing parentheses and spaces. Other\n                      characters are treated as part of the group, similar to\n                      parentheses, but spaces are explicitly ignored.\n\n    Returns:\n        A list of strings, where each string is a separated, balanced\n        parenthesis group. Incomplete or unbalanced groups at the end\n        of the input string are discarded.\n\n    Examples:\n        >>> separate_paren_groups('( ) (( )) (( )( ))')\n        ['()', '(())', '(()())']\n        >>> separate_paren_groups('')\n        []\n        >>> separate_paren_groups('   ')\n        []\n        >>> separate_paren_groups('()')\n        ['()']\n        >>> separate_paren_groups('(()())')\n        ['(()())']\n        >>> separate_paren_groups('((())) (a)')\n        ['((()))', '(a)']\n        >>> separate_paren_groups('()((()') # Incomplete group at the end discarded\n        ['()']\n    \"\"\"\n    result: List[str] = []\n    current_group_chars: List[str] = []\n    balance: int = 0\n\n    for char in paren_string:\n        if char == ' ':\n            # FR-3: Ignore spaces\n            continue\n\n        # Accumulate all non-space characters into the current group\n        current_group_chars.append(char)\n\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # FR-1, FR-2, FR-4: If balance returns to zero and we have accumulated\n        # characters, it signifies a complete, balanced, top-level group.\n        if balance == 0 and current_group_chars:\n            group_str = \"\".join(current_group_chars)\n            result.append(group_str)\n            current_group_chars = []  # Reset for the next potential group\n\n    # QA-1: If the loop ends and current_group_chars is not empty, it means\n    # the last group was not balanced (balance != 0). Per design, these\n    # incomplete groups are discarded.\n\n    return result\n\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Parses a string containing multiple groups of nested parentheses,\n    separates them into individual balanced groups, and returns them\n    as a list of strings.\n\n    The function ignores whitespace characters and identifies top-level\n    balanced groups.\n\n    Args:\n        paren_string (str): A string containing parentheses and optionally spaces.\n\n    Returns:\n        List[str]: A list of strings, where each string is a separate,\n                   balanced, and top-level group of parentheses, in\n                   the order they appear in the input string.\n    \"\"\"\n    result: List[str] = []\n    current_group_chars: List[str] = []\n    balance: int = 0\n\n    # F.1: Ignore all space characters (' ')\n    cleaned_string: str = paren_string.replace(' ', '')\n\n    for char in cleaned_string:\n        # Append char to the current group being formed\n        current_group_chars.append(char)\n\n        # Update balance (F.2: Group Identification)\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # F.3: Top-Level Group Separation & F.4: Output Generation\n        # If balance returns to 0, a complete, balanced, and top-level group\n        # has just finished.\n        if balance == 0:\n            group_str = \"\".join(current_group_chars)\n            result.append(group_str)\n            # Reset for the next group\n            current_group_chars = []\n        # If balance is not 0, the current characters are part of a\n        # nested group or an incomplete top-level group.\n\n    return result\n\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates a string containing multiple groups of nested parentheses into a list of\n    individual, balanced, and non-nested groups.\n\n    Args:\n        paren_string (str): The input string containing parentheses and spaces.\n\n    Returns:\n        List[str]: A list of strings, where each string represents a balanced,\n                   top-level parenthesis group from the input.\n    \"\"\"\n    cleaned_string = paren_string.replace(' ', '')\n\n    result_groups: List[str] = []\n    balance = 0\n    current_group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n            if balance == 1:  # Start of a new top-level group\n                current_group_start_index = i\n        elif char == ')':\n            balance -= 1\n            if balance == 0:  # End of a top-level balanced group\n                if current_group_start_index != -1:  # Ensure a group was properly started\n                    group_string = cleaned_string[current_group_start_index : i + 1]\n                    result_groups.append(group_string)\n                    current_group_start_index = -1  # Reset for the next top-level group\n\n    return result_groups\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates a string containing multiple groups of nested parentheses into\n    individual, balanced top-level groups.\n\n    Args:\n        paren_string: The input string potentially containing multiple distinct,\n                      top-level, balanced groups of nested parentheses,\n                      interspersed with spaces.\n\n    Returns:\n        A list of strings, where each string is a separated, balanced paren group,\n        maintaining their original order. Returns an empty list if no valid\n        top-level paren groups are found.\n    \"\"\"\n    result: List[str] = []\n    current_group_chars: List[str] = []\n    balance: int = 0\n\n    # F1.2: Ignore all whitespace characters (spaces, tabs, newlines, etc.)\n    # str.split() without arguments splits on any whitespace and discards empty strings.\n    # \"\".join() then concatenates the non-whitespace parts.\n    cleaned_string: str = \"\".join(paren_string.split())\n\n    for char in cleaned_string:\n        if char == '(':\n            balance += 1\n            current_group_chars.append(char)\n        elif char == ')':\n            balance -= 1\n            current_group_chars.append(char)\n        # As per 2.4 General Constraints and the definition of 'Paren Group',\n        # other characters are ignored and do not contribute to the group structure or content.\n\n        # F2.1, F2.2: Identify and extract distinct, top-level, balanced groups.\n        # A balance of 0, coupled with an active current_group_chars, signifies\n        # the completion of a top-level, balanced group.\n        if balance == 0 and current_group_chars:\n            # F2.3: The extracted string for each group SHALL include all its contained parentheses.\n            result.append(\"\".join(current_group_chars))\n            # Reset current_group_chars for the next potential top-level group.\n            current_group_chars = []\n\n    # F3.3: If the input string (after space removal) contains no valid top-level\n    # paren groups, the system SHALL return an empty list (handled by initial result = []).\n    return result\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Parses an input string containing multiple groups of nested parentheses and\n    separates them into a list of individual, balanced string groups.\n\n    The function identifies distinct, top-level balanced groups of parentheses,\n    ignores any spaces within the input string, and returns these groups\n    as a list of strings.\n\n    Args:\n        paren_string: The string containing parenthesis groups.\n\n    Returns:\n        A list of strings, where each string represents a separated,\n        balanced parenthesis group. Spaces are removed from the output strings.\n\n    Examples:\n        >>> separate_paren_groups('( ) (( )) (( )( ))')\n        ['()', '(())', '(()())']\n        >>> separate_paren_groups('')\n        []\n        >>> separate_paren_groups('   ')\n        []\n        >>> separate_paren_groups('()')\n        ['()']\n        >>> separate_paren_groups('()()')\n        ['()', '()']\n        >>> separate_paren_groups('((()))')\n        ['((()))']\n        >>> separate_paren_groups('(()())()(())')\n        ['(()())', '()', '(())']\n        >>> separate_paren_groups(' ( ( ) ) ')\n        ['(())']\n        >>> separate_paren_groups('( ( )') # Unbalanced, won't be included\n        []\n    \"\"\"\n    result: List[str] = []\n    current_group_chars: List[str] = []\n    balance: int = 0\n\n    for char in paren_string:\n        if char == ' ':\n            # FR.4: Ignore space characters\n            continue\n\n        # Append character to the current group being built\n        current_group_chars.append(char)\n\n        # Update balance based on parenthesis type\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # FR.1, FR.2, FR.3: Check for completion of a top-level, balanced group\n        # If balance is 0 and we've collected characters, it's a complete group.\n        if balance == 0 and current_group_chars:\n            # FR.5: Join characters to form the group string (without spaces)\n            group_str = \"\".join(current_group_chars)\n            result.append(group_str)\n            # Reset for the next group\n            current_group_chars = []\n\n    # FR.5: Return the list of separated groups\n    return result\n\n```"}
{"task_id": "HumanEval/1", "solution": "```python\ndef separate_paren_groups(paren_string: str) -> list[str]:\n    \"\"\"\n    Separates distinct, balanced, and non-nested parenthetical groups from an input string.\n\n    Args:\n        paren_string: The input string containing zero or more parenthetical groups,\n                      possibly interspersed with spaces.\n\n    Returns:\n        A list of strings, where each string represents a separated parenthetical group.\n        Spaces are removed from the input and not included in the output groups.\n    \"\"\"\n    # 1. Preprocessing: Remove all spaces from the input string.\n    # This addresses FR2: Space Handling.\n    cleaned_string = \"\".join(char for char in paren_string if char != ' ')\n\n    # 2. Initialize variables for parsing\n    result: list[str] = []\n    balance_counter = 0\n    group_start_index = 0\n\n    # 3. Iterate through the cleaned string to find groups\n    # This addresses FR1: Group Identification and Separation, and FR3: Handling Nested Parentheses within Groups.\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        # 4. Check for the end of a top-level group\n        # A group ends when balance_counter returns to 0 after processing a ')'\n        if balance_counter == 0 and char == ')':\n            # Extract the complete group from group_start_index to current index (inclusive)\n            current_group = cleaned_string[group_start_index : i + 1]\n            result.append(current_group)\n\n            # Reset the start index for the next potential group\n            group_start_index = i + 1\n\n    # 5. Return the list of separated groups\n    # This addresses FR4: Output Format.\n    return result\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Extracts the decimal part of a positive floating-point number.\n\n    This function takes a positive floating-point number and returns \n    its decimal (fractional) component. For example, for 3.5, it returns 0.5.\n    For an integer like 7.0, it returns 0.0.\n\n    Args:\n        number (float): A positive floating-point number.\n\n    Returns:\n        float: The decimal part of the input number.\n\n    Examples:\n        >>> truncate_number(3.5)\n        0.5\n        >>> truncate_number(7.0)\n        0.0\n        >>> truncate_number(123.456789)\n        0.456789\n        >>> truncate_number(0.1)\n        0.1\n        >>> truncate_number(1.9999999999999999) # Demonstrates float precision\n        0.9999999999999999\n    \"\"\"\n    return number - int(number)\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Calculates and returns the decimal part of a given positive floating-point number.\n\n    Args:\n        number: A positive floating-point number.\n\n    Returns:\n        A float representing the decimal part of the input number.\n        The decimal part is defined as number - floor(number) for positive numbers.\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # FR2: Calculate the integer part of the input 'number'.\n    # For positive numbers, int() truncates towards zero, which is\n    # equivalent to the largest integer less than or equal to the number (floor).\n    integer_part = int(number)\n\n    # FR3: Subtract the calculated integer part from the original 'number'.\n    # FR4: Return the result of the subtraction as a 'float'.\n    # FR5: The returned value shall be greater than or equal to 0 and strictly less than 1.\n    # This approach naturally satisfies FR5 for positive inputs.\n    return number - integer_part\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Extracts the decimal part of a positive floating-point number.\n\n    The decimal part is defined as the number minus its floor. For a positive\n    number x, this is x - floor(x), resulting in a value d such that 0 <= d < 1.\n\n    Args:\n        number (float): A positive floating-point number (number >= 0).\n\n    Returns:\n        float: The decimal part of the input number, satisfying 0 <= d < 1.\n\n    Example:\n        >>> truncate_number(3.14)\n        0.14\n        >>> truncate_number(5.0)\n        0.0\n        >>> truncate_number(0.75)\n        0.75\n    \"\"\"\n    integer_part = int(number)  # For positive numbers, int() truncates towards zero, equivalent to floor().\n    decimal_part = number - integer_part\n    return decimal_part\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Extracts the decimal part of a positive floating-point number.\n\n    This function calculates the fractional component of a given positive float\n    by subtracting its integer part.\n\n    Args:\n        number (float): The positive floating-point number from which to\n                        extract the decimal part.\n\n    Returns:\n        float: The decimal part of the input number.\n               The result is always greater than or equal to 0.0 and less than 1.0.\n\n    Examples:\n        >>> truncate_number(3.5)\n        0.5\n        >>> truncate_number(1.0)\n        0.0\n        >>> truncate_number(0.123)\n        0.123\n        >>> truncate_number(0.0)\n        0.0\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part\n```"}
