where a or b is zero, as the general adjustment might involve division by zero or undesirable shifts.\n    if b == 0:\n        # If b is 0, ax = n, so x = n/a. y can be any integer, typically chosen as 0.\n        # x_particular and y_particular from egcd will already be (n/a, 0) in this scenario.\n        return (x_particular, y_particular)\n    if a == 0:\n        # If a is 0, by = n, so y = n/b. x can be any integer, typically chosen as 0.\n        # x_particular and y_particular from egcd will already be (0, n/b) in this scenario.\n        return (x_particular, y_particular)\n\n    # Calculate the step sizes for x and y when 't' changes by 1.\n    step_x = b // g\n    # step_y = a // g # Not strictly needed if we calculate t first\n\n    # Calculate 't' to shift x_particular to the smallest non-negative value.\n    # Python's % operator behaves such that x % m has the same sign as m.\n    # So, x_particular % step_x will give a value in [0, abs(step_x)-1] if step_x is positive.\n    # This 't' can be derived from: x_final = x_particular + step_x * t => t = (x_final - x_particular) // step_x\n    # Where x_final is x_particular % step_x.\n    t_shift = (x_particular % step_x - x_particular) // step_x\n\n    # Apply the shift to find the canonical solution.\n    x_final = x_particular + step_x * t_shift\n    y_final = y_particular - (a // g) * t_shift\n\n    return (x_final, y_final)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[25, 123, 7]]}], "Mbpp/166": [{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: List[int]) -> int:\n    \"\"\"\n    Return the number of unordered pairs whose XOR is even.\n\n    The XOR of two integers is even iff both are even or both are odd.\n    \"\"\"\n    count = 0\n    n = len(nums)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if (nums[i] ^ nums[j]) % 2 == 0:\n                count += 1\n    return count", "base_status": "fail", "plus_status": "fail