n    # dec[i] stores the maximum sum of a decreasing subsequence starting at array[i]\n    dec = [0] * n\n    for i in range(n - 1, -1, -1):\n        dec[i] = array[i]\n        for j in range(n - 1, i, -1):\n            if array[i] > array[j]:\n                dec[i] = max(dec[i], dec[j] + array[i])\n\n    max_bitonic_sum = float('-inf')\n\n    # The maximum sum of a bitonic subsequence with array[i] as the peak element\n    # is inc[i] + dec[i] - array[i] (since array[i] is included in both sums).\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, inc[i] + dec[i] - array[i])\n        \n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "def insert_element(input_list, element):\n    \"\"\"\n    Inserts the given element before each element in the input list.\n    Returns a new list with the modified sequence.\n    \"\"\"\n    result_list = []\n    for item in input_list:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(t: tuple, e: object) -> int:\n    \"\"\"\n    Count the number of times `e` occurs in the tuple `t`.\n\n    Parameters\n    ----------\n    t : tuple\n        The tuple to search.\n    e : object\n        The element to count.\n    \"\"\"\n    count = 0\n    for item in t:\n        if item == e:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n, such that each element is a positive integer,\n    greater than or equal to twice the previous element, 