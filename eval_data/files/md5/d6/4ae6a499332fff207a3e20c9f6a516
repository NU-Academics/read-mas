{"task_id": "Mbpp/123", "solution": "import math\n\ndef find_proper_divisors(number: int) -> list[int]:\n    \"\"\"Finds all positive proper divisors of a given number.\"\"\"\n    if number <= 0:\n        return []\n    divisors = {1} if number > 1 else set()\n    for i in range(2, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            divisors.add(i)\n            divisors.add(number // i)\n    return sorted(list(divisors))\n\ndef sum_proper_divisors(number: int) -> int:\n    \"\"\"Calculates the sum of all proper divisors of a given number.\"\"\"\n    return sum(find_proper_divisors(number))\n\ndef is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"Checks if two distinct numbers form an amicable pair.\"\"\"\n    if a == b:\n        return False\n    return sum_proper_divisors(a) == b and sum_proper_divisors(b) == a\n\ndef find_amicable_numbers(upper_limit: int) -> list[int]:\n    \"\"\"Identifies all amicable numbers within the range 1 to upper_limit.\"\"\"\n    amicable_nums_set = set()\n    for n in range(1, upper_limit + 1):\n        sum_d_n = sum_proper_divisors(n)\n\n        # To find distinct amicable pairs (a, b) where a != b,\n        # we only need to check if n < sum_d_n to avoid redundant checks\n        # and ensure each pair is identified once.\n        if 1 <= sum_d_n <= upper_limit and sum_d_n > n:\n            if is_amicable_pair(n, sum_d_n):\n                amicable_nums_set.add(n)\n                amicable_nums_set.add(sum_d_n)\n    return sorted(list(amicable_nums_set))\n\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to the specified upper_limit.\"\"\"\n    amicable_numbers = find_amicable_numbers(upper_limit)\n    return sum(amicable_numbers)"}
{"task_id": "Mbpp/126", "solution": "def _find_divisors(n: int) -> list[int]:\n    \"\"\"Finds all divisors of a given positive integer.\"\"\"\n    divs = []\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            divs.append(i)\n            if i * i != n:\n                divs.append(n // i)\n    return sorted(divs)\n\ndef _find_common_divisors(divisors_a: list[int], divisors_b: list[int]) -> list[int]:\n    \"\"\"Identifies common divisors between two sets of divisors.\"\"\"\n    return sorted(list(set(divisors_a) & set(divisors_b)))\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of common divisors between two given numbers.\"\"\"\n    divs_a = _find_divisors(a)\n    divs_b = _find_divisors(b)\n    common_divs = _find_common_divisors(divs_a, divs_b)\n    return builtins.sum(common_divs) # Use builtins.sum to avoid name collision with function name"}
