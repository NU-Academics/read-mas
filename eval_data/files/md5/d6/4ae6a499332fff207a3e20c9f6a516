{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is undulating, meaning it alternates between exactly two different digits.\n    \"\"\"\n    if number < 10:\n        return False\n\n    s_num = str(number)\n    digits = [int(d) for d in s_num]\n\n    if len(digits) < 2:\n        return False\n\n    first_digit = digits[0]\n    second_digit = digits[1]\n\n    if first_digit == second_digit:\n        return False\n\n    for i in range(2, len(digits)):\n        if i % 2 == 0:  # Even index, should match first_digit\n            if digits[i] != first_digit:\n                return False\n        else:  # Odd index, should match second_digit\n            if digits[i] != second_digit:\n                return False\n\n    return True"}
