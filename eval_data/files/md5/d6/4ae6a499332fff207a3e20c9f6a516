{"task_id": "Mbpp/111", "solution": "from typing import List, Set\n\ndef common_in_nested_lists(nested_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Find common elements across all sublists in a nested list structure.\n    If the input nested list is empty, an empty list is returned.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize the set of common elements with the first sublist\n    common_elements_set = set(nested_lists[0])\n\n    # Iterate through the rest of the sublists and find the intersection\n    for sublist in nested_lists[1:]:\n        common_elements_set.intersection_update(set(sublist))\n\n    return list(common_elements_set)"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple\n\ndef max_product_tuple(list_of_tuples: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Find the maximum absolute product between numbers in pairs of tuples.\n\n    Iterates through each tuple to calculate the absolute product and finds the maximum.\n    \"\"\"\n    max_absolute_product = 0.0\n    for num1, num2 in list_of_tuples:\n        current_product = num1 * num2\n        max_absolute_product = max(max_absolute_product, abs(current_product))\n    return max_absolute_product"}
