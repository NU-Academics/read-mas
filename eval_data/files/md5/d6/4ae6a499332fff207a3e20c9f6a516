{"task_id": "Mbpp/9", "solution": "def _rotate_string(s: str, positions: int) -> str:\n    \"\"\"Rotate string left by positions.\"\"\"\n    if not s:\n        return s\n    rotations = positions % len(s)\n    return s[rotations:] + s[:rotations]\n\ndef _get_divisors(n: int) -> list[int]:\n    \"\"\"Get all divisors of n in ascending order.\"\"\"\n    divs = []\n    for i in range(1, n + 1):\n        if n % i == 0:\n            divs.append(i)\n    return divs\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"Find minimum rotations greater than 0 to get same string.\"\"\"\n    s_len = len(s)\n    if s_len == 0:\n        return 0 # Or handle as per specific requirement for empty string, usually 0 or error.\n                 # Given \"greater than 0\" return, this case should ideally not occur or be defined.\n                 # For now, returning 0, though the problem states \"greater than 0\".\n                 # Assuming input will not be an empty string based on example \"aaaa\" and \"minimum number of rotations (greater than 0)\".\n    \n    divs = _get_divisors(s_len)\n    \n    for k in divs:\n        if _rotate_string(s, k) == s:\n            return k\n            \n    # This line should theoretically not be reached as s_len itself is a divisor and\n    # rotating by s_len always results in the original string.\n    return s_len"}
{"task_id": "Mbpp/6", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"Count the number of set bits in an integer using Brian Kernighan's algorithm.\"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count\n\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Check if two numbers differ at exactly one bit position.\"\"\"\n    xor_result = num1 ^ num2\n    return _count_set_bits(xor_result) == 1"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(string: str, character: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character is not found, or found only once, the string is adjusted accordingly.\n    \"\"\"\n    first_idx = -1\n    for i in range(len(string)):\n        if string[i] == character:\n            first_idx = i\n            break\n\n    if first_idx == -1:\n        return string # Character not found\n\n    last_idx = -1\n    for i in range(len(string) - 1, -1, -1):\n        if string[i] == character:\n            last_idx = i\n            break\n    \n    # If first_idx and last_idx are the same, it means the character appeared only once.\n    # In this case, we just remove that single occurrence.\n    if first_idx == last_idx:\n        return string[:first_idx] + string[first_idx+1:]\n    else:\n        # Remove both first_idx and last_idx\n        # Ensure removal order doesn't shift indices for the second removal\n        # by removing from left to right with slicing.\n        # String will be constructed as: part_before_first + part_between_first_and_last + part_after_last\n        return string[:first_idx] + string[first_idx+1:last_idx] + string[last_idx+1:]"}
