{"task_id": "Mbpp/462", "solution": "def _generate_binary_subsets(elements, size):\n    \"\"\"Generates all combinations by iterating through binary masks.\n    Elements within each subset are ordered in reverse of their appearance in the input list.\n    \"\"\"\n    all_combinations = []\n    num_combinations = 1 << size\n\n    for i in range(num_combinations):\n        current_combination = []\n        # Build the subset by iterating through the original list's indices in reverse order.\n        # This ensures elements are added to the subset in an order matching the assertion.\n        for j in range(size - 1, -1, -1):\n            if (i >> j) & 1:  # Check if the j-th bit is set in the mask 'i'\n                current_combination.append(elements[j])\n        all_combinations.append(current_combination)\n    return all_combinations\n\ndef _preserve_element_order(subset, original_list):\n    \"\"\"Ensures elements within a subset maintain the order as defined by the overall combination logic.\n    This function acts as an identity as subsets are already formed with the required internal order.\n    \"\"\"\n    return subset\n\ndef _sort_by_binary_order(combinations):\n    \"\"\"Sorts combinations according to their binary counting pattern.\n    This function acts as an identity as combinations are generated in binary counting order.\n    \"\"\"\n    return combinations\n\ndef combinations_list(input_list):\n    \"\"\"\n    Finds all possible combinations of the elements of a given list.\n    Combinations are returned in binary counting order, with elements within each subset\n    ordered in reverse of their appearance in the input list, as per the assertion.\n    \"\"\"\n    \n    # Generate all raw combinations. This function implicitly handles both\n    # the binary counting order for the overall list and the reverse internal\n    # element order as required by the assertion example.\n    raw_combinations = _generate_binary_subsets(input_list, len(input_list))\n\n    # The design specifies these helper calls for ordering and preservation.\n    # Given _generate_binary_subsets's implementation, these become identity operations.\n    ordered_combinations = []\n    for combo in raw_combinations:\n        ordered_combinations.append(_preserve_element_order(combo, input_list))\n    \n    final_combinations = _sort_by_binary_order(ordered_combinations)\n    \n    return final_combinations"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise sum of neighboring elements in a tuple.\n    Returns a new tuple where each element is the sum of input_tuple[i] and input_tuple[i+1].\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n    \n    return tuple(input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list) -> int:\n    # Handle the case of an empty array.\n    # Based on problem constraints and assert example, we assume arr is not empty.\n    # If arr could be empty and 0 is not the only possible answer,\n    # more robust error handling or a specified return value would be needed.\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n    current_min = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # If the current number is negative, swapping current_max and current_min\n        # ensures that current_min will hold the larger negative product,\n        # which when multiplied by another negative, might become the new max.\n        if num < 0:\n            current_max, current_min = current_min, current_max\n\n        # Update current_max and current_min for the product ending at the current position.\n        # A new subarray might start with 'num' itself, or extend the previous one.\n        current_max = max(num, current_max * num)\n        current_min = min(num, current_min * num)\n\n        # Update the overall maximum product found so far.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/472", "solution": "def _validate_input(numbers: list) -> bool:\n    # Checks if the input list is not empty.\n    return len(numbers) > 0\n\ndef _sort_numbers(numbers: list) -> list:\n    # Sorts the numbers and removes duplicates.\n    return sorted(list(set(numbers)))\n\ndef _verify_sequence(sorted_numbers: list) -> bool:\n    # Verifies if the sorted numbers form a consecutive sequence.\n    if len(sorted_numbers) < 2:\n        return False\n\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n    return True\n\ndef check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks whether the given list contains consecutive numbers.\n    \"\"\"\n    if not _validate_input(numbers):\n        return False\n    \n    processed_numbers = _sort_numbers(numbers)\n    return _verify_sequence(processed_numbers)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the intersection of tuples from two lists, treating tuples as order-independent.\n    Returns a set of matching tuples found in the first list.\n    \"\"\"\n    # Create a set of normalized tuples from list2 for efficient lookup.\n    # frozenset is used to make tuples order-independent and hashable.\n    normalized_list2_forms = set()\n    for t in list2:\n        normalized_list2_forms.add(frozenset(t))\n\n    result_set = set()\n    for t1 in list1:\n        # Normalize the tuple from list1 for order-independent comparison.\n        normalized_t1 = frozenset(t1)\n        if normalized_t1 in normalized_list2_forms:\n            # If a match is found, add the original tuple from list1 to the result set.\n            result_set.add(t1)\n\n    return result_set"}
