{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list: list) -> list:\n    \"\"\"\n    Finds all unique combinations of sums with tuples from the given tuple list.\n    Each combination is an element-wise sum of two distinct tuples from the input list.\n    \"\"\"\n    result = []\n    # Generate all unique pairs of tuples from the input list (without replacement)\n    for tuple1, tuple2 in itertools.combinations(tuple_list, 2):\n        # Perform element-wise addition for each pair of tuples\n        sum_tuple = tuple(x + y for x, y in zip(tuple1, tuple2))\n        result.append(sum_tuple)\n    return result"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Returns a list of sublists where each sublist contains consecutive duplicate elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays within a given array.\n    This function orchestrates subarray generation, filtering, and summation.\n    \"\"\"\n    def generate_subarrays(arr: list[int]) -> list[list[int]]:\n        \"\"\"Generates all contiguous subarrays from the input array.\"\"\"\n        subarrays = []\n        n = len(arr)\n        for i in range(n):\n            for j in range(i, n):\n                subarrays.append(arr[i : j + 1])\n        return subarrays\n\n    def is_odd_length(subarray: list[int]) -> bool:\n        \"\"\"Checks if a subarray has an odd length.\"\"\"\n        return len(subarray) % 2 == 1\n\n    def calculate_subarray_sum(subarray: list[int]) -> int:\n        \"\"\"Calculates the sum of elements in a subarray.\"\"\"\n        return sum(subarray)\n\n    total_sum = 0\n    all_subarrays = generate_subarrays(arr)\n    for subarray in all_subarrays:\n        if is_odd_length(subarray):\n            total_sum += calculate_subarray_sum(subarray)\n    return total_sum"}
