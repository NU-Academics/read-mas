{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(complex_input) -> tuple:\n    \"\"\"Convert complex number to polar coordinates.\n\n    Args:\n        complex_input: Complex number or real number\n\n    Returns:\n        tuple: (magnitude, angle) in polar coordinates\n    \"\"\"\n    real = float(complex_input.real) if hasattr(complex_input, 'real') else float(complex_input)\n    imag = float(complex_input.imag) if hasattr(complex_input, 'imag') else 0.0\n\n    magnitude = math.sqrt(real**2 + imag**2)\n    angle = math.atan2(imag, real)\n\n    return (magnitude, angle)"}
{"task_id": "Mbpp/256", "solution": "def _validate_input(number: int) -> bool:\n    \"\"\"\n    Validate that input is non-negative.\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Input number must be non-negative.\")\n    return True\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Check if a number is prime.\n    Uses an optimized trial division method.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_Primes_nums(number: int) -> int:\n    \"\"\"\n    Count prime numbers less than the given non-negative number.\n    Iterates through numbers and uses a helper to check primality.\n    \"\"\"\n    _validate_input(number)\n    count = 0\n    for i in range(number):\n        if _is_prime(i):\n            count += 1\n    return count"}
