{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(wind_velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculate the wind chill index using the standard formula and round to the next integer.\n    The formula is designed for temperature in Celsius and wind speed in km/h.\n    \"\"\"\n    # Convert wind velocity from km/h to m/s for formula compatibility if needed by the specific formula,\n    # but the given context implies formula directly uses km/h.\n    # The formula used is for the Canadian Wind Chill Index, adapted for km/h and Celsius.\n    # This formula is: WCI = 13.12 + 0.6215T - 11.37V^0.16 + 0.3965T V^0.16\n    # where T is temperature in Celsius and V is wind speed in km/h.\n    \n    # Calculate the raw wind chill index\n    raw_wind_chill = 13.12 + (0.6215 * temperature) - (11.37 * (wind_velocity**0.16)) + (0.3965 * temperature * (wind_velocity**0.16))\n    \n    # Round the result to the next integer using the ceiling function\n    return math.ceil(raw_wind_chill)"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, count):\n    \"\"\"\n    Calculates the sum of XOR operations for all unique pairs of numbers in the given list.\n    Helper functions are defined inline to perform pair generation, XOR calculation, and sum aggregation.\n    \"\"\"\n\n    def _generate_pairs(numbers_list):\n        \"\"\"Generates all unique pairs from input list excluding self-pairs.\"\"\"\n        pairs = []\n        n = len(numbers_list)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append((numbers_list[i], numbers_list[j]))\n        return pairs\n\n    def _calculate_xor(num1, num2):\n        \"\"\"Calculates the XOR operation between two numbers.\"\"\"\n        return num1 ^ num2\n\n    def _sum_xor_results(xor_results_list):\n        \"\"\"Sums all XOR results into a final total.\"\"\"\n        return sum(xor_results_list)\n\n    all_pairs = _generate_pairs(numbers)\n\n    xor_values = []\n    for num1, num2 in all_pairs:\n        xor_values.append(_calculate_xor(num1, num2))\n\n    total_xor_sum = _sum_xor_results(xor_values)\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of integers in ascending order using the heap sort algorithm.\n    Returns a new list with the sorted elements.\n    \"\"\"\n    if not arr:\n        return []\n\n    # Create a copy of the input array to sort in-place within the copy\n    arr_copy = list(arr)\n    n = len(arr_copy)\n\n    # Function to swap two elements in the array\n    def swap_elements(array_to_modify: list, i: int, j: int) -> None:\n        array_to_modify[i], array_to_modify[j] = array_to_modify[j], array_to_modify[i]\n\n    # Function to maintain the max-heap property for a subtree rooted at index i\n    def heapify(array_to_modify: list, heap_size: int, i: int) -> None:\n        largest = i  # Initialize largest as root\n        left = 2 * i + 1  # left child\n        right = 2 * i + 2  # right child\n\n        # See if left child of root exists and is greater than root\n        if left < heap_size and array_to_modify[left] > array_to_modify[largest]:\n            largest = left\n\n        # See if right child of root exists and is greater than current largest\n        if right < heap_size and array_to_modify[right] > array_to_modify[largest]:\n            largest = right\n\n        # Change root, if needed\n        if largest != i:\n            swap_elements(array_to_modify, i, largest)\n            # Heapify the root.\n            heapify(array_to_modify, heap_size, largest)\n\n    # Function to build a max heap from the array\n    def build_max_heap(array_to_modify: list) -> None:\n        for i in range(n // 2 - 1, -1, -1):\n            heapify(array_to_modify, n, i)\n\n    # Build a maxheap\n    build_max_heap(arr_copy)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        swap_elements(arr_copy, i, 0)\n        # Call heapify on the reduced heap\n        heapify(arr_copy, i, 0)\n\n    return arr_copy"}
