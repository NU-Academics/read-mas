{"task_id": "Mbpp/453", "solution": "from typing import List\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"Main function to calculate sum of even factors.\"\"\"\n\n    def _find_factors(num: int) -> List[int]:\n        \"\"\"Find all factors of the given number.\"\"\"\n        factors = []\n        for i in range(1, num + 1):\n            if num % i == 0:\n                factors.append(i)\n        return factors\n\n    def _filter_even_factors(factors_list: List[int]) -> List[int]:\n        \"\"\"Filter factors to include only even numbers.\"\"\"\n        even_factors = [factor for factor in factors_list if factor % 2 == 0]\n        return even_factors\n\n    def _calculate_sum(factors_to_sum: List[int]) -> int:\n        \"\"\"Calculate sum of given factors.\"\"\"\n        return sum(factors_to_sum)\n\n    all_factors = _find_factors(number)\n    even_factors = _filter_even_factors(all_factors)\n    total_sum = _calculate_sum(even_factors)\n    return total_sum"}
