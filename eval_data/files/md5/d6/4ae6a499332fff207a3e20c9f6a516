{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements: list) -> list:\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\"\"\"\n\n    def flip(arr: list, k: int):\n        \"\"\"Reverses elements from index 0 to k in the given list.\"\"\"\n        start = 0\n        while start < k:\n            arr[start], arr[k] = arr[k], arr[start]\n            start += 1\n            k -= 1\n\n    def find_max_index(arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element in the first n elements of the list.\"\"\"\n        max_val = arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            if arr[i] > max_val:\n                max_val = arr[i]\n                max_idx = i\n        return max_idx\n\n    arr = elements.copy()\n    n = len(arr)\n\n    for curr_size in range(n, 1, -1):\n        max_idx = find_max_index(arr, curr_size)\n\n        if max_idx != curr_size - 1:\n            if max_idx != 0:\n                flip(arr, max_idx)\n            flip(arr, curr_size - 1)\n            \n    return arr"}
{"task_id": "Mbpp/145", "solution": "def _validate_input(array):\n    \"\"\"\n    Validates if the input array has at least two elements.\n    Raises ValueError if the array contains fewer than two elements.\n    \"\"\"\n    if len(array) < 2:\n        raise ValueError(\"Array must contain at least 2 elements\")\n\ndef _find_min_max(array):\n    \"\"\"\n    Finds the minimum and maximum values in the given array.\n    Returns them as a tuple (min_val, max_val).\n    \"\"\"\n    return min(array), max(array)\n\ndef _calculate_difference(min_val, max_val):\n    \"\"\"\n    Calculates the absolute difference between two numeric values.\n    \"\"\"\n    return abs(max_val - min_val)\n\ndef max_Abs_Diff(array):\n    \"\"\"\n    Finds the maximum absolute difference between any two elements in a given array.\n    This is achieved by finding the minimum and maximum elements and calculating their absolute difference.\n    \"\"\"\n    _validate_input(array)\n    min_val, max_val = _find_min_max(array)\n    return _calculate_difference(min_val, max_val)"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts number of items that are identical in the same position of three given lists.\n    Assumes all input lists are of equal length.\n    \"\"\"\n    count = 0\n    # Assuming all lists have the same length based on the design context.\n    # We can take the length of any of the lists.\n    length = len(list1)\n\n    for i in range(length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            count += 1\n            \n    return count"}
