{"task_id": "Mbpp/259", "solution": "def maximize_elements(tuple1, tuple2):\n    \"\"\"\n    Maximizes elements from two input tuples, comparing corresponding nested tuple pairs.\n    It returns a new tuple containing the maximum values from each position.\n    \"\"\"\n    result = []\n    for i in range(len(tuple1)):\n        pair1 = tuple1[i]\n        pair2 = tuple2[i]\n        max_first = max(pair1[0], pair2[0])\n        max_second = max(pair1[1], pair2[1])\n        result.append((max_first, max_second))\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "import math\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef _is_newman_shanks_williams_prime(num: int) -> bool:\n    \"\"\"Checks if a prime number satisfies the Newman-Shanks-Williams criteria.\"\"\"\n    # The first Newman-Shanks-Williams prime is 2.\n    if num == 2:\n        return True\n\n    # The S_m sequence is defined by S_0=1, S_1=1, S_m = 2*S_{m-1} + S_{m-2}.\n    # NSW primes include 2, and prime numbers present in the S_m sequence (e.g., 3, 7, 17, 41, ...).\n    s_prev2 = 1  # Represents S_0\n    s_prev1 = 1  # Represents S_1\n\n    # Start generating S_m from S_2\n    s_current = 2 * s_prev1 + s_prev2 # S_2 = 2*1 + 1 = 3\n\n    while s_current <= num:\n        if s_current == num:\n            return True\n        s_prev2 = s_prev1\n        s_prev1 = s_current\n        s_current = 2 * s_prev1 + s_prev2\n    return False\n\ndef _generate_newman_shanks_williams_primes(count: int) -> list[int]:\n    \"\"\"Generates a list of Newman-Shanks-Williams primes up to the specified count.\"\"\"\n    nsw_primes = []\n    candidate = 2  # Start checking from the first prime number\n\n    while len(nsw_primes) < count:\n        if _is_prime(candidate):\n            if _is_newman_shanks_williams_prime(candidate):\n                nsw_primes.append(candidate)\n        candidate += 1\n    return nsw_primes\n\ndef newman_prime(n: int) -> int:\n    \"\"\"Finds the nth newman\u2013shanks\u2013williams prime number.\"\"\"\n    nsw_primes_list = _generate_newman_shanks_williams_primes(n)\n    return nsw_primes_list[n - 1]"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements by their original index modulo n.\n    Each sublist collects elements whose original index has the same remainder when divided by n.\n    \"\"\"\n    result_lists = [[] for _ in range(n)]\n\n    for i, element in enumerate(input_list):\n        target_sublist_index = i % n\n        result_lists[target_sublist_index].append(element)\n\n    return result_lists"}
