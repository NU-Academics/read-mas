{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    Handles empty arrays and single-element arrays as monotonic.\n    \"\"\"\n\n    def _is_non_decreasing(arr_internal):\n        \"\"\"Helper to check if an array is non-decreasing.\"\"\"\n        for i in range(len(arr_internal) - 1):\n            if arr_internal[i] > arr_internal[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr_internal):\n        \"\"\"Helper to check if an array is non-increasing.\"\"\"\n        for i in range(len(arr_internal) - 1):\n            if arr_internal[i] < arr_internal[i+1]:\n                return False\n        return True\n\n    if len(arr) <= 1:\n        return True\n\n    return _is_non_decreasing(arr) or _is_non_increasing(arr)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if a sublist exists as a contiguous sequence within a main list.\n    \"\"\"\n    if not sublist:\n        return True\n\n    if not main_list:\n        return False\n\n    n = len(main_list)\n    m = len(sublist)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list):\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm in ascending order.\n    \"\"\"\n    def _swap(arr, i, j):\n        \"\"\"\n        Swaps two elements in the list at the given indices.\n        \"\"\"\n        arr[i], arr[j] = arr[j], arr[i]\n\n    def _calculate_gap(gap):\n        \"\"\"\n        Calculates the next gap value for the comb sort algorithm.\n        \"\"\"\n        gap = int(gap / 1.3)\n        if gap < 1:\n            return 1\n        return gap\n\n    n = len(input_list)\n    if n <= 1:\n        return input_list\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = _calculate_gap(gap)\n        swapped = False\n\n        for i in range(n - gap):\n            if input_list[i] > input_list[i + gap]:\n                _swap(input_list, i, i + gap)\n                swapped = True\n    return input_list"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number for a given non-negative integer n.\n    The Bell number represents the number of ways to partition a set of n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the Bell triangle with the first row (for n=0, B_0 = 1)\n    # triangle[i][j] where i is the row index and j is the column index within that row.\n    # The Bell number B_n will be triangle[n][0].\n    triangle = [[1]]\n\n    # Build the Bell triangle row by row up to row n\n    for i in range(1, n + 1):\n        current_row = [0] * (i + 1)\n        \n        # The first element of the current row (T_i[0]) is the last element of the previous row (T_{i-1}[i-1])\n        current_row[0] = triangle[i-1][-1]\n        \n        # Calculate subsequent elements in the current row\n        for j in range(1, i + 1):\n            # Each element T_i[j] is the sum of the element to its left (T_i[j-1])\n            # and the element diagonally above and to its left (T_{i-1}[j-1])\n            current_row[j] = current_row[j-1] + triangle[i-1][j-1]\n            \n        triangle.append(current_row)\n\n    # The Bell number B_n is the first element of the n-th row of the Bell triangle\n    return triangle[n][0]"}
