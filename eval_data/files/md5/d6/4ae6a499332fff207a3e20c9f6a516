{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n.\n    Each element is a positive integer, greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    # Memoization dictionary to store results of subproblems.\n    # Key: (previous_element_value, remaining_length), Value: count_of_sequences\n    memo = {}\n\n    def _count_sequences_recursive(prev_val: int, remaining_len: int) -> int:\n        \"\"\"\n        Recursively counts valid sequences starting with prev_val and having remaining_len elements.\n        \"\"\"\n        # Base case: If no more elements are needed, we have successfully formed a sequence suffix.\n        if remaining_len == 0:\n            return 1\n        \n        # Check memoization cache to avoid redundant calculations.\n        if (prev_val, remaining_len) in memo:\n            return memo[(prev_val, remaining_len)]\n\n        current_count = 0\n        \n        # The next element must be at least twice the previous element.\n        start_next_val = 2 * prev_val\n        \n        # Iterate through all possible values for the next element.\n        # The next element must also be less than or equal to m.\n        for next_val in range(start_next_val, m + 1):\n            current_count += _count_sequences_recursive(next_val, remaining_len - 1)\n        \n        # Store the result in memo and return.\n        memo[(prev_val, remaining_len)] = current_count\n        return current_count\n\n    total_sequences = 0\n    # For the first element of the sequence, it can be any positive integer from 1 to m.\n    # Since n is a positive integer, n-1 is a non-negative integer representing remaining length.\n    for first_val in range(1, m + 1):\n        total_sequences += _count_sequences_recursive(first_val, n - 1)\n    \n    return total_sequences"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(number: float) -> int:\n    \"\"\"\n    Finds the next perfect square greater than a given number.\n    This function calculates the integer part of the square root of the input,\n    increments it, and then squares the result to find the next perfect square.\n    \"\"\"\n    root_val = int(math.sqrt(number))\n    next_root = root_val + 1\n    return next_root * next_root"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    # Handle edge cases: empty or single-element array.\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    def _calculate_increasing_sums(array_local: list[int]) -> list[int]:\n        \"\"\"Calculates the maximum sum of an increasing subsequence ending at each position.\"\"\"\n        n_local = len(array_local)\n        dp_inc = list(array_local) # Initialize with each element's value\n        for i in range(n_local):\n            for j in range(i):\n                if array_local[i] > array_local[j]:\n                    dp_inc[i] = max(dp_inc[i], dp_inc[j] + array_local[i])\n        return dp_inc\n\n    def _calculate_decreasing_sums(array_local: list[int]) -> list[int]:\n        \"\"\"Calculates the maximum sum of a decreasing subsequence starting at each position.\"\"\"\n        n_local = len(array_local)\n        dp_dec = list(array_local) # Initialize with each element's value\n        for i in range(n_local - 1, -1, -1): # Iterate from right to left\n            for j in range(n_local - 1, i, -1): # Iterate from right down to i+1\n                if array_local[i] > array_local[j]:\n                    dp_dec[i] = max(dp_dec[i], dp_dec[j] + array_local[i])\n        return dp_dec\n\n    # Calculate increasing subsequence sums for all elements\n    inc_sums = _calculate_increasing_sums(arr)\n\n    # Calculate decreasing subsequence sums for all elements (from right to left)\n    dec_sums = _calculate_decreasing_sums(arr)\n\n    # Combine increasing and decreasing sums to find the maximum bitonic sum.\n    # The sum for a bitonic subsequence peaking at arr[i] is inc_sums[i] + dec_sums[i] - arr[i].\n    # We initialize with negative infinity to handle potentially negative sums.\n    max_bitonic_sum = float('-inf')\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, inc_sums[i] + dec_sums[i] - arr[i])\n\n    return max_bitonic_sum"}
