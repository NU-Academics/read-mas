{"task_id": "Mbpp/440", "solution": "import string\n\ndef _clean_punctuation(word: str) -> str:\n    \"\"\"Removes leading/trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\n\n_ADVERB_SUFFIXES = ['ly']\n_COMMON_NON_LY_ADVERBS = {'very', 'always', 'often', 'never', 'well', 'fast', 'hard', 'too', 'quite', 'just', 'still', 'even', 'only', 'much', 'so', 'then', 'now', 'here', 'there', 'away'}\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a cleaned word is likely an adverb (case-insensitive).\"\"\"\n    lower_word = word.lower()\n    if lower_word in _COMMON_NON_LY_ADVERBS:\n        return True\n    for suffix in _ADVERB_SUFFIXES:\n        if lower_word.endswith(suffix) and len(lower_word) > len(suffix):\n            return True\n    return False\n\ndef _extract_words(sentence: str) -> list[str]:\n    \"\"\"Extracts words from a sentence by splitting on whitespace.\"\"\"\n    return sentence.split()\n\ndef _preserve_original_positions(sentence: str, clean_word: str, original_word: str, initial_start_index: int) -> tuple[int, int]:\n    \"\"\"\n    Adjusts positions to reflect the cleaned word's span within the original word's boundaries,\n    given the start index of the original word in the sentence.\n    \"\"\"\n    relative_start = original_word.find(clean_word)\n    adjusted_start = initial_start_index + relative_start\n    adjusted_end = adjusted_start + len(clean_word)\n    return (adjusted_start, adjusted_end)\n\ndef _calculate_positions(sentence: str, original_word: str, clean_word: str, word_list_index: int) -> tuple[int, int]:\n    \"\"\"\n    Calculates the start and end positions of the cleaned adverb within the sentence,\n    by finding the N-th occurrence of the original word and then adjusting for punctuation.\n    \"\"\"\n    current_search_start = 0\n    found_count = 0\n    initial_start_index_of_original_word = -1\n    \n    while True:\n        pos = sentence.find(original_word, current_search_start)\n        if pos == -1:\n            break\n        \n        if found_count == word_list_index:\n            initial_start_index_of_original_word = pos\n            break\n        \n        found_count += 1\n        current_search_start = pos + len(original_word)\n        \n    if initial_start_index_of_original_word != -1:\n        return _preserve_original_positions(sentence, clean_word, original_word, initial_start_index_of_original_word)\n    \n    return (-1, -1)\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n    original_words_list = _extract_words(sentence)\n    \n    for i, original_word in enumerate(original_words_list):\n        cleaned_word = _clean_punctuation(original_word)\n        \n        if _is_adverb(cleaned_word):\n            start_pos, end_pos = _calculate_positions(sentence, original_word, cleaned_word, i)\n            return (start_pos, end_pos, cleaned_word)\n            \n    return None"}
{"task_id": "Mbpp/448", "solution": "def _validate_input(n: int) -> bool:\n    \"\"\"\n    Validates the input parameter n.\n    Returns True for any integer input as non-positive cases are handled by sequence generation.\n    \"\"\"\n    # Per constraints: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # Given that `n` is typed as int, and non-positive `n` values (if interpreted as max index)\n    # are handled by _generate_perrin_sequence returning an empty or partially populated list,\n    # this validation can simply return True for any valid integer input.\n    return True\n\ndef _generate_perrin_sequence(count: int) -> list[int]:\n    \"\"\"\n    Generates the first 'count' Perrin numbers using the recurrence relation.\n    P(n) = P(n-2) + P(n-3) with P(0)=3, P(1)=0, P(2)=2.\n    \"\"\"\n    if count <= 0:\n        return []\n    if count == 1:\n        return [3]\n    if count == 2:\n        return [3, 0]\n\n    perrin_numbers = [3, 0, 2]\n    # Generate subsequent Perrin numbers until 'count' numbers are in the list\n    for i in range(3, count):\n        next_perrin = perrin_numbers[i - 2] + perrin_numbers[i - 3]\n        perrin_numbers.append(next_perrin)\n\n    return perrin_numbers\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to P(n).\n    \"\"\"\n    _validate_input(n)\n\n    # To satisfy `assert cal_sum(9) == 49` with the given Perrin sequence definition,\n    # 'n' must represent the maximum index, meaning we sum (n+1) numbers.\n    sequence_length = n + 1\n    \n    # Handle cases where n is negative, leading to non-positive sequence_length\n    if sequence_length <= 0:\n        return 0\n\n    sequence = _generate_perrin_sequence(sequence_length)\n    return sum(sequence)"}
