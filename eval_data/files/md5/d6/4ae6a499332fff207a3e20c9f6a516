{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    The sum is computed for (2k-1)^4 from k=1 to n.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_number = 2 * k - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: [int, float]) -> int:\n    \"\"\"\n    Counts the number of unique pairs (by index) in a list whose sum equals the target sum.\n    Handles duplicate values by considering their distinct positions.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "import math\n\ndef canBeExpressedAsConsecutiveSum(num: int) -> bool:\n    \"\"\"\n    Checks if a number can be expressed as the sum of two or more\n    consecutive positive integers.\n    \"\"\"\n    if num <= 0:\n        return False\n\n    # A number `num` can be expressed as the sum of `k` consecutive integers\n    # starting from `a` if `num = k*a + k*(k-1)/2`.\n    # Rearranging, `2*num = k * (2*a + k - 1)`.\n    # We need to find `k >= 2` and `a >= 1`.\n    # `2*a = (2*num / k) - k + 1`.\n    # For `a >= 1`, `(2*num / k) - k + 1` must be an even number and at least 2.\n\n    # Iterate `k` (number of terms) starting from 2.\n    # The upper bound for `k` is determined by `a >= 1`.\n    # If `a=1`, `2*num = k*(k+1)`. So `k*(k+1) <= 2*num`.\n    # This implies `k` is approximately `sqrt(2*num)`.\n    # We add a small buffer to ensure the loop covers all possibilities.\n    upper_k_bound = int(math.sqrt(2 * num)) + 2\n\n    for k in range(2, upper_k_bound):\n        # Check if `2*num` is divisible by `k`.\n        if (2 * num) % k == 0:\n            term_val_part = (2 * num) // k\n            \n            # Now, `2*a = term_val_part - k + 1`.\n            val_2a = term_val_part - k + 1\n            \n            # `val_2a` must be an even number and greater than or equal to 2\n            # for `a` to be a positive integer (`a >= 1`).\n            if val_2a % 2 == 0 and val_2a >= 2:\n                return True\n    return False\n\ndef isPoliteNumber(num: int) -> bool:\n    \"\"\"\n    Determines if a given number is a polite number.\n    A number is polite if it can be expressed as a sum of two or more\n    consecutive positive integers.\n    \"\"\"\n    return canBeExpressedAsConsecutiveSum(num)\n\ndef findNthPoliteNumber(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number in the sequence of polite numbers.\n    \"\"\"\n    polite_count = 0\n    current_num = 0\n\n    while True:\n        current_num += 1\n        if isPoliteNumber(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num"}
