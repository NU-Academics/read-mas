{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple (max_length, max_list).\n    \"\"\"\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    max_list_found = []\n\n    for sublist in list_of_lists:\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n            max_list_found = sublist\n    \n    return (max_len, max_list_found)"}
{"task_id": "Mbpp/286", "solution": "import math\n\ndef max_sub_array_sum_repeated(array, array_length, k):\n    \"\"\"\n    Calculates the maximum subarray sum for an array repeated k times.\n    Applies Kadane's algorithm and handles cases for repeated arrays.\n    \"\"\"\n    if array_length == 0:\n        return 0\n\n    # Kadane's algorithm for a single array\n    def kadane_algorithm(arr):\n        max_so_far = -math.inf\n        current_max = 0\n        for x in arr:\n            current_max += x\n            max_so_far = max(max_so_far, current_max)\n            if current_max < 0:\n                current_max = 0\n        return max_so_far if max_so_far != -math.inf else 0\n\n    # Case 1: k=1, just apply Kadane's on the original array\n    if k == 1:\n        return kadane_algorithm(array)\n\n    # Case 2: k > 1\n\n    # Apply Kadane's on a doubled array (array + array)\n    # This covers scenarios where the max subarray crosses the original array boundary once\n    max_sum_double = kadane_algorithm(array + array)\n\n    # Calculate the total sum of the original array\n    total_array_sum = sum(array)\n\n    if total_array_sum > 0:\n        # If the total sum of the array is positive,\n        # the maximum sum can be achieved by repeating the entire array multiple times,\n        # plus the max subarray sum from the beginning and end of a single array.\n        # max_sum_double already covers the case of 2 repetitions.\n        # For k > 2, it's (k-2) * total_array_sum + max_sum_double (which covers 2 repetitions).\n        return max_sum_double + (k - 2) * total_array_sum\n    else:\n        # If the total sum of the array is non-positive,\n        # repeating the array more than twice will not increase the sum.\n        # The maximum sum will be achieved within at most two repetitions.\n        return max_sum_double"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(array):\n    \"\"\"\n    Counts inversions in an array using a brute-force approach.\n    An inversion is a pair (i, j) such that i < j and array[i] > array[j].\n    \"\"\"\n    inversion_count = 0\n    n = len(array)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if array[i] > array[j]:\n                inversion_count += 1\n    return inversion_count"}
