{"task_id": "Mbpp/616", "solution": "def validate_tuple_lengths(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validates that input tuples have equal length.\n    Raises ValueError if lengths are not equal.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have equal length\")\n\ndef calculate_element_modulo(element1, element2):\n    \"\"\"Performs modulo operation on individual elements.\"\"\"\n    return element1 % element2\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo operation on two tuples of the same length.\n    Returns a new tuple with the results.\"\"\"\n    validate_tuple_lengths(tuple1, tuple2)\n\n    result_elements = []\n    for i in range(len(tuple1)):\n        result_elements.append(calculate_element_modulo(tuple1[i], tuple2[i]))\n        \n    return tuple(result_elements)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values across all tuples in a list.\n    This function flattens the list of tuples into a single list of numbers and then sums them.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for item in tpl:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_tuples: tuple) -> list:\n    \"\"\"\n    Calculates the average value for each corresponding element across inner tuples (column-wise average).\n    Returns a list of these averages as floats.\n    \"\"\"\n    if not input_tuples:\n        return []\n\n    # Determine the number of columns from the first inner tuple.\n    # Assumes all inner tuples have the same length for column-wise averaging.\n    num_columns = len(input_tuples[0])\n    if num_columns == 0:\n        return []\n\n    averages = []\n    # Iterate through columns\n    for j in range(num_columns):\n        column_sum = 0\n        column_count = 0\n        # Iterate through rows (inner tuples) for the current column\n        for i in range(len(input_tuples)):\n            column_sum += input_tuples[i][j]\n            column_count += 1\n        \n        # Calculate the average for the current column\n        averages.append(column_sum / column_count)\n\n    return averages"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Finds the maximum value in the specified n'th column of a matrix.\n    Assumes the matrix is non-empty with consistent row lengths and a valid column index.\n    \"\"\"\n    max_val = matrix[0][n]  # Initialize with the first element of the n'th column\n\n    for row in matrix:\n        if row[n] > max_val:\n            max_val = row[n]\n\n    return max_val"}
{"task_id": "Mbpp/619", "solution": "def _is_numeric(char: str) -> bool:\n    \"\"\"Checks if a given character is a numeric digit.\"\"\"\n    return '0' <= char <= '9'\n\ndef _separate_characters(input_string: str) -> tuple[list[str], list[str]]:\n    \"\"\"Separates a string into lists of non-numeric and numeric characters.\"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if _is_numeric(char):\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return non_numeric_chars, numeric_chars\n\ndef move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the given string, preserving relative order.\"\"\"\n    if not input_string:\n        return \"\"\n\n    non_numeric_chars, numeric_chars = _separate_characters(input_string)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list):\n    \"\"\"\n    Transpose a list of two-element sublists into two separate lists.\n    It collects the first elements into one list and second elements into another.\n    \"\"\"\n    first_elements = [sublist[0] for sublist in input_list]\n    second_elements = [sublist[1] for sublist in input_list]\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/620", "solution": "def _is_divisible_pair(a: int, b: int) -> bool:\n    \"\"\"Checks if one number in a pair divides the other.\"\"\"\n    if a == 0:\n        return b == 0\n    if b == 0:\n        return a == 0\n    return b % a == 0 or a % b == 0\n\ndef _generate_all_subsets(numbers: list[int]) -> list[list[int]]:\n    \"\"\"Generates all possible subsets of the given list of numbers.\"\"\"\n    all_subsets = [[]]\n    for num in numbers:\n        all_subsets.extend([subset + [num] for subset in all_subsets])\n    return all_subsets\n\ndef _is_valid_divisible_subset(subset: list[int]) -> bool:\n    \"\"\"Checks if every pair in the subset satisfies the divisibility condition.\"\"\"\n    if len(subset) <= 1:\n        return True\n    \n    for i in range(len(subset)):\n        for j in range(i + 1, len(subset)):\n            if not _is_divisible_pair(subset[i], subset[j]):\n                return False\n    return True\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers where every pair is divisible.\n    A pair (a, b) is divisible if a divides b or b divides a.\n    \"\"\"\n    all_subsets = _generate_all_subsets(numbers)\n    \n    max_size = 0\n    for subset in all_subsets:\n        if _is_valid_divisible_subset(subset):\n            max_size = max(max_size, len(subset))\n            \n    return max_size"}
