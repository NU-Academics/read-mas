{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list) -> int:\n    \"\"\"\n    Sums the length of names that start with an uppercase letter.\n    Filters out names starting with a lowercase letter and calculates the total length of the remaining names.\n    \"\"\"\n    filtered_names = []\n    for name in names:\n        if name and name[0].isupper():\n            filtered_names.append(name)\n\n    total_length = 0\n    for name in filtered_names:\n        total_length += len(name)\n\n    return total_length"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Check if string contains 'z' in middle of any word.\n\n    Args:\n        input_string: Text to validate\n\n    Returns:\n        True if 'z' found in middle position of any word, False otherwise\n    \"\"\"\n    def _parse_words(text: str) -> list[str]:\n        \"\"\"\n        Extract alphabetic words from text using non-alphabetic boundaries.\n        \"\"\"\n        words = []\n        current_word = []\n        for char in text:\n            if char.isalpha():\n                current_word.append(char)\n            else:\n                if current_word:\n                    words.append(\"\".join(current_word))\n                    current_word = []\n        if current_word:\n            words.append(\"\".join(current_word))\n        return words\n\n    def _check_middle_z(word: str) -> bool:\n        \"\"\"\n        Check if word contains 'z' in middle position.\n        \"\"\"\n        n = len(word)\n        if n < 3:\n            return False\n        # Iterate from the second character (index 1) up to the second to last character (index n-2)\n        for i in range(1, n - 1):\n            if word[i] == 'z':\n                return True\n        return False\n\n    words_list = _parse_words(input_string)\n    for word in words_list:\n        if _check_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, k):\n    \"\"\"Reverses the elements of an array from index 0 up to position k (exclusive).\"\"\"\n    \n    # Extract the portion of the array to be reversed\n    part_to_reverse = array[:k]\n    # Reverse the extracted portion\n    reversed_part = part_to_reverse[::-1]\n    # Get the remaining part of the array\n    remaining_part = array[k:]\n    # Concatenate the reversed part with the remaining part\n    return reversed_part + remaining_part"}
