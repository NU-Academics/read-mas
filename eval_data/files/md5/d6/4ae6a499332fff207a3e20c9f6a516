{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\ndef get_coordinates(coordinate_tuple: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple in a 3x3 grid,\n    including the original coordinate, maintaining row-major order.\n    \"\"\"\n    x_orig, y_orig = coordinate_tuple\n    adjacent_coords = []\n    offsets = [-1, 0, 1]\n\n    for dx in offsets:\n        for dy in offsets:\n            new_x = x_orig + dx\n            new_y = y_orig + dy\n            adjacent_coords.append([new_x, new_y])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in the given string.\n    Iterates through characters to perform the bidirectional transformation.\n    \"\"\"\n    transformed_chars = []\n    for char in input_string:\n        if char.isspace():\n            transformed_chars.append('_')\n        elif char == '_':\n            transformed_chars.append(' ')\n        else:\n            transformed_chars.append(char)\n    return \"\".join(transformed_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zeroes to the end of the given list while preserving the relative order of non-zero elements.\n    Returns a new list with the reorganized elements.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n    for item in input_list:\n        if item == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(item)\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
