{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two integers.\n    Pads the shorter number with leading zeros for comparison.\n    \"\"\"\n    def extract_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts digits from an integer, returning them in a list in reverse order.\n        For example, 123 becomes [3, 2, 1].\n        \"\"\"\n        number = abs(number)\n        if number == 0:\n            return [0]\n        digits = []\n        while number > 0:\n            digits.append(number % 10)\n            number //= 10\n        return digits\n\n    def calculate_differences(digits1: list[int], digits2: list[int]) -> list[int]:\n        \"\"\"\n        Calculates the absolute differences between corresponding digits,\n        padding the shorter list with zeros as needed.\n        \"\"\"\n        max_len = max(len(digits1), len(digits2))\n        differences = []\n        for i in range(max_len):\n            digit1 = digits1[i] if i < len(digits1) else 0\n            digit2 = digits2[i] if i < len(digits2) else 0\n            differences.append(abs(digit1 - digit2))\n        return differences\n\n    def sum_differences(differences: list[int]) -> int:\n        \"\"\"Sums all the values in a list of differences.\"\"\"\n        return sum(differences)\n\n    digits1 = extract_digits(num1)\n    digits2 = extract_digits(num2)\n    per_digit_diffs = calculate_differences(digits1, digits2)\n    total_sum = sum_differences(per_digit_diffs)\n    return total_sum"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\ndef max_sub_array_sum(array: List[int], length: int) -> int:\n    \"\"\"Finds the maximum sum of a contiguous sublist using Kadane's algorithm.\n    It handles lists with positive, negative, and mixed integers efficiently.\"\"\"\n    \n    # Initialize variables to track the maximum sum found so far and the maximum sum ending at the current position.\n    # Start with the first element to correctly handle cases where all numbers are negative.\n    max_so_far = array[0]\n    current_max = array[0]\n\n    # Iterate through the array starting from the second element.\n    for i in range(1, length):\n        # Update current_max: either extend the previous subarray or start a new one with the current element.\n        current_max = max(array[i], current_max + array[i])\n        \n        # Update max_so_far with the largest sum found globally.\n        max_so_far = max(max_so_far, current_max)\n            \n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list):\n    \"\"\"\n    Finds the length of the longest sublist within a list of sublists.\n    Assumes the input is a list of lists.\n    \"\"\"\n    max_length = 0\n    for sublist in input_list:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
{"task_id": "Mbpp/563", "solution": "def extract_values(input_string: str) -> list[str]:\n    \"\"\"Extract all text values enclosed in double quotation marks.\n\n    Args:\n        input_string: String containing quoted text segments\n\n    Returns:\n        List of extracted string values without quotation marks\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found opening quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found closing quote\n                in_quote = False\n                if start_index != -1:\n                    extracted_values.append(input_string[start_index:i])\n                start_index = -1\n    return extracted_values"}
