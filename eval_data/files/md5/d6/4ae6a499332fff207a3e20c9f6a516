{"task_id": "Mbpp/94", "solution": "def index_minimum(tuple_list):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Assumes the input list is non-empty and contains tuples with at least two elements.\n    \"\"\"\n    min_second_value = tuple_list[0][1]\n    result_first_value = tuple_list[0][0]\n\n    for item in tuple_list[1:]:\n        if item[1] < min_second_value:\n            min_second_value = item[1]\n            result_first_value = item[0]\n\n    return result_first_value"}
{"task_id": "Mbpp/98", "solution": "import math\n\ndef multiply_num(input_collection):\n    \"\"\"\n    Multiplies all numbers in a collection and divides the product by the collection's length.\n    Ensures the result is a float for precision testing.\n    \"\"\"\n    if not input_collection:\n        return 0.0\n\n    product = 1\n    for num in input_collection:\n        product *= num\n    \n    length = len(input_collection)\n    result = product / length\n    \n    return float(result)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent as a string with no leading zeros.\n    Handles the case where the input is 0.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n    \n    binary_string = ''\n    # Using a while loop for manual conversion\n    while decimal_number > 0:\n        remainder = decimal_number % 2\n        binary_string = str(remainder) + binary_string\n        decimal_number //= 2\n        \n    return binary_string"}
