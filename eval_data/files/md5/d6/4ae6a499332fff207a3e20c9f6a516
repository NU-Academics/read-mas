{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given number.\n    Returns 0 for numbers >= 5 because their factorials always end in 0.\n    \"\"\"\n    if number < 0:\n        # Factorial is undefined for negative numbers. As per design context\n        # to avoid exceptions and assuming valid non-negative input,\n        # return 0 as a neutral digit for unexpected negative inputs.\n        return 0\n\n    if number >= 5:\n        return 0  # Factorials of numbers greater than or equal to 5 always end in 0.\n\n    # Precomputed last digits for 0!, 1!, 2!, 3!, 4!\n    # 0! = 1 (last digit 1)\n    # 1! = 1 (last digit 1)\n    # 2! = 2 (last digit 2)\n    # 3! = 6 (last digit 6)\n    # 4! = 24 (last digit 4)\n    factorial_last_digits = [1, 1, 2, 6, 4]\n\n    return factorial_last_digits[number]"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in one tuple but not in the other.\n    Returns a tuple containing all dissimilar elements.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    dissimilar_elements = (set1 - set2) | (set2 - set1)\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if 'sub_list' is a contiguous sublist of 'main_list'.\n    Returns True if 'sub_list' is found, False otherwise.\n    \"\"\"\n\n    def _check_contiguous_match(main_list_local, sub_list_local, start_pos):\n        \"\"\"Compares a slice of the main list to the sublist starting at a given position.\"\"\"\n        if start_pos + len(sub_list_local) > len(main_list_local):\n            return False\n        return main_list_local[start_pos : start_pos + len(sub_list_local)] == sub_list_local\n\n    if not sub_list:\n        return True\n\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if _check_contiguous_match(main_list, sub_list, i):\n            return True\n\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Elements are taken sequentially from each list for each index.\"\"\"\n    result = []\n    length = len(list1)\n    for i in range(length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(baseEdge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    \"\"\"\n    base_area = baseEdge * baseEdge\n    # Calculate slant height using Pythagorean theorem\n    slant_height = math.sqrt(height**2 + (baseEdge / 2)**2)\n    # Area of one triangular face\n    triangular_face_area = 0.5 * baseEdge * slant_height\n    # Total surface area is base area + 4 times the area of one triangular face\n    total_surface_area = base_area + (4 * triangular_face_area)\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Remove odd integer elements from nested mixed tuple while preserving structure.\n\n    Args:\n        input_tuple: Nested tuple containing integers and other elements.\n\n    Returns:\n        Filtered tuple containing only even integers with preserved nesting and other elements.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            processed_sub_tuple = extract_even(item)\n            result.append(processed_sub_tuple)\n        else:\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n):\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    numerator = factorial(2 * n)\n    denominator = factorial(n + 1) * factorial(n)\n    return numerator // denominator"}
