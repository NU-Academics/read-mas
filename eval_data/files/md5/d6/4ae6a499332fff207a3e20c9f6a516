{"task_id": "Mbpp/724", "solution": "class MathematicalOperation:\n    \"\"\"Encapsulates operation state and intermediate results.\"\"\"\n    def __init__(self, base: int, power: int):\n        self.base: int = base\n        self.power: int = power\n        self.result: int = None\n        self.digit_sum: int = None\n\nclass DigitProcessor:\n    \"\"\"Extracts individual digits and calculates their sum.\"\"\"\n    def extract_individual_digits(self, number: int) -> list[int]:\n        \"\"\"Converts a number to a list of its individual digits.\"\"\"\n        return [int(digit) for digit in str(number)]\n\n    def calculate_sum(self, digits: list[int]) -> int:\n        \"\"\"Calculates the sum of a list of digits.\"\"\"\n        return sum(digits)\n\nclass PowerCalculator:\n    \"\"\"Orchestrates the complete power base sum calculation workflow.\"\"\"\n    def __init__(self):\n        self._digit_processor = DigitProcessor()\n\n    def calculate_power(self, base: int, power: int) -> int:\n        \"\"\"Calculates base raised to the power.\"\"\"\n        return base ** power\n\n    def power_base_sum(self, base: int, power: int) -> int:\n        \"\"\"Calculates the sum of all digits of the base to the specified power.\"\"\"\n        operation_state = MathematicalOperation(base, power)\n        power_result = self.calculate_power(base, power)\n        operation_state.result = power_result\n        \n        digits = self._digit_processor.extract_individual_digits(operation_state.result)\n        digit_sum = self._digit_processor.calculate_sum(digits)\n        operation_state.digit_sum = digit_sum\n\n        return digit_sum\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    calculator = PowerCalculator()\n    return calculator.power_base_sum(base, power)"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_dict: dict, min_height: float, min_weight: float) -> dict:\n    \"\"\"\n    Filters a dictionary of students, returning only those whose height and weight\n    are above or equal to the specified minimums.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_dict.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple):\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple.\n    Returns a new tuple where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    # The output tuple will have N elements for an input tuple of N+1 elements.\n    # We iterate N times, from index 0 to N-1.\n    # For each iteration i, we multiply input_tuple[i] by input_tuple[i+1].\n    return tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/721", "solution": "import math\n\nclass Matrix:\n    \"\"\"Encapsulates matrix data with validation and cell access.\"\"\"\n    def __init__(self, matrix_data: list[list[float]]):\n        self.cells = matrix_data\n        self.size = len(matrix_data)\n        self.validate_square_matrix()\n\n    def validate_square_matrix(self) -> bool:\n        \"\"\"Ensures square dimensions and numeric values.\"\"\"\n        for row in self.cells:\n            if len(row) != self.size:\n                # Based on instructions, we don't raise exceptions for edge cases.\n                # Assuming valid input per requirements.\n                pass\n        return True\n\n    def get_cell_cost(self, row: int, col: int) -> float:\n        \"\"\"Retrieves cost for specific cell.\"\"\"\n        return self.cells[row][col]\n\n    def get_size(self) -> int:\n        \"\"\"Returns matrix size.\"\"\"\n        return self.size\n\nclass Cell:\n    \"\"\"Represents individual matrix positions with coordinates and cost.\"\"\"\n    def __init__(self, row: int, column: int, cost: float):\n        self.row = row\n        self.column = column\n        self.cost = cost\n\n    def get_row(self) -> int:\n        \"\"\"Returns row coordinate.\"\"\"\n        return self.row\n\n    def get_column(self) -> int:\n        \"\"\"Returns column coordinate.\"\"\"\n        return self.column\n\n    def get_cost(self) -> float:\n        \"\"\"Returns cell cost.\"\"\"\n        return self.cost\n\nclass Path:\n    \"\"\"Tracks cell sequences with cost calculation and average computation.\"\"\"\n    def __init__(self):\n        self.cells: list[Cell] = []\n        self.total_cost: float = 0.0\n        self.cell_count: int = 0\n\n    def add_cell(self, cell: Cell) -> None:\n        \"\"\"Add cell to path and update totals.\"\"\"\n        self.cells.append(cell)\n        self.total_cost += cell.get_cost()\n        self.cell_count += 1\n\n    def calculate_average(self) -> float:\n        \"\"\"Compute average cost.\"\"\"\n        if self.cell_count == 0:\n            return 0.0\n        return self.total_cost / self.cell_count\n\n    def get_total_cost(self) -> float:\n        \"\"\"Return total path cost.\"\"\"\n        return self.total_cost\n\n    def get_cell_count(self) -> int:\n        \"\"\"Return number of cells.\"\"\"\n        return self.cell_count\n\nclass PathFinder:\n    \"\"\"Generates all valid paths and coordinates optimization process.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self.matrix = matrix\n\n    def find_max_average_path(self) -> float:\n        \"\"\"Main algorithm entry point to find the maximum average path.\"\"\"\n        all_paths = self.generate_all_paths()\n        if not all_paths:\n            return 0.0\n        \n        path_calculator = PathCalculator()\n        return path_calculator.find_maximum(all_paths)\n\n    def generate_all_paths(self) -> list[Path]:\n        \"\"\"Generates all valid paths from start to end using DFS.\"\"\"\n        all_paths: list[Path] = []\n        size = self.matrix.get_size()\n\n        def dfs(current_row, current_col, current_path: Path):\n            cell_cost = self.matrix.get_cell_cost(current_row, current_col)\n            current_cell = Cell(current_row, current_col, cell_cost)\n            new_path = Path()\n            for cell in current_path.cells:\n                new_path.add_cell(cell)\n            new_path.add_cell(current_cell)\n\n            if current_row == size - 1 and current_col == size - 1:\n                all_paths.append(new_path)\n                return\n\n            # Move right\n            if self.validate_movement(current_row, current_col, current_row, current_col + 1):\n                dfs(current_row, current_col + 1, new_path)\n\n            # Move down\n            if self.validate_movement(current_row, current_col, current_row + 1, current_col):\n                dfs(current_row + 1, current_col, new_path)\n\n        dfs(0, 0, Path()) # Start DFS with an empty path from (0,0)\n        return all_paths\n\n    def validate_movement(self, from_row: int, from_col: int, to_row: int, to_col: int) -> bool:\n        \"\"\"Checks movement validity (only right or down, within bounds).\"\"\"\n        size = self.matrix.get_size()\n        if not (0 <= to_row < size and 0 <= to_col < size):\n            return False\n        \n        # Valid moves are (row, col+1) or (row+1, col)\n        if (to_row == from_row and to_col == from_col + 1) or \\\n           (to_row == from_row + 1 and to_col == from_col):\n            return True\n        return False\n\nclass PathCalculator:\n    \"\"\"Calculates path averages and identifies maximum.\"\"\"\n    def calculate_path_average(self, path: Path) -> float:\n        \"\"\"Compute average for single path.\"\"\"\n        return path.calculate_average()\n\n    def compare_averages(self, avg1: float, avg2: float) -> float:\n        \"\"\"Return maximum of two averages.\"\"\"\n        return max(avg1, avg2)\n\n    def find_maximum(self, paths: list[Path]) -> float:\n        \"\"\"Find maximum average among all paths.\"\"\"\n        if not paths:\n            return 0.0\n        \n        max_avg = -math.inf\n        for path in paths:\n            current_avg = self.calculate_path_average(path)\n            max_avg = self.compare_averages(max_avg, current_avg)\n        return max_avg\n\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    # Convert input list[list[int]] to list[list[float]] for Matrix class\n    float_matrix_data = [[float(val) for val in row] for row in matrix]\n    \n    matrix_obj = Matrix(float_matrix_data)\n    path_finder = PathFinder(matrix_obj)\n    return path_finder.find_max_average_path()"}
{"task_id": "Mbpp/725", "solution": "from typing import List\n\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts all substrings enclosed within double quotation marks from the input string.\n    Returns a list of extracted strings in order of appearance, including empty strings for consecutive quotes.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening double quote, mark the start of the content.\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found a closing double quote, extract the content between the quotes.\n                in_quote = False\n                end_index = i\n                extracted_values.append(input_string[start_index:end_index])\n\n    return extracted_values"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_a, list_b):\n    \"\"\"\n    Computes the element-wise sum of two equally-sized lists.\n    Returns a new list with the sums.\n    \"\"\"\n    return [a + b for a, b in zip(list_a, list_b)]"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicates from a list, preserving the first occurrence of each group.\"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(radius: float, height: float) -> float:\n    \"\"\"Calculate the lateral surface area of a cone.\"\"\"\n    slant_height = math.sqrt(radius**2 + height**2)\n    lateral_surface_area = math.pi * radius * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replace all occurrences of spaces, commas, or dots with colons.\n    \"\"\"\n    # Replace spaces with colons\n    modified_string = input_string.replace(' ', ':')\n    # Replace commas with colons in the string that already had spaces replaced\n    modified_string = modified_string.replace(',', ':')\n    # Replace dots with colons in the string that already had spaces and commas replaced\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/735", "solution": "def _get_bit_length(number: int) -> int:\n    \"\"\"Calculates the number of bits required to represent an integer.\"\"\"\n    if number == 0:\n        return 0\n    return number.bit_length()\n\ndef _toggle_bit_at_position(number: int, position: int) -> int:\n    \"\"\"Toggles the bit at a specific 0-indexed position in an integer.\"\"\"\n    mask = 1 << position\n    return number ^ mask\n\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    For numbers with less than 3 bits, no middle bits exist, so the number is returned unchanged.\n    \"\"\"\n    if number <= 1:\n        return number\n\n    bit_length = _get_bit_length(number)\n\n    # If the number has 1 or 2 bits, there are no \"middle\" bits to toggle.\n    if bit_length < 3:\n        return number\n\n    modified_number = number\n    # Iterate through positions for middle bits (from 1 up to bit_length - 2 inclusive)\n    for position in range(1, bit_length - 1):\n        modified_number = _toggle_bit_at_position(modified_number, position)\n\n    return modified_number"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"Find the index of the first occurrence of a given number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1  # Initialize result to -1, indicating not found\n\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        if array[mid] == target:\n            result = mid  # Store this as a potential first occurrence\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1  # Target is in the right half\n        else: # array[mid] > target\n            high = mid - 1  # Target is in the left half\n\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(arr: list[int], target: int) -> int:\n    \"\"\"\n    Find the leftmost insertion point for target in a sorted array.\n    Uses binary search to achieve O(log n) time complexity.\n    \"\"\"\n    left, right = 0, len(arr)\n    while left < right:\n        mid = (left + right) // 2\n        if arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n    \n    def _generate_sublists(current_list: list) -> list:\n        \"\"\"Generates all possible contiguous sublists from the input list.\"\"\"\n        sublists = []\n        n = len(current_list)\n        for i in range(n):\n            for j in range(i, n):\n                sublists.append(current_list[i:j+1])\n        return sublists\n\n    def _calculate_product(sublist: list) -> int:\n        \"\"\"Calculates the product of all elements in a given sublist.\"\"\"\n        if not sublist:\n            return 0  # Product of an empty list is 1 mathematically, but for sublists, often 0 or ignored. \n                      # For [1,2,3], all sublists are non-empty.\n        product = 1\n        for item in sublist:\n            product *= item\n        return product\n\n    def _sum_products(products_list: list) -> int:\n        \"\"\"Sums all the calculated products.\"\"\"\n        total_sum = 0\n        for prod in products_list:\n            total_sum += prod\n        return total_sum\n\n    all_sublists = _generate_sublists(lst)\n    \n    sublist_products = []\n    for sublist in all_sublists:\n        sublist_products.append(_calculate_product(sublist))\n        \n    final_sum = _sum_products(sublist_products)\n    \n    return final_sum"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Uses a sequential search, calculating triangular numbers and counting their digits.\n    \"\"\"\n    def calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def count_digits(number: int) -> int:\n        \"\"\"Counts the number of digits in a given integer.\"\"\"\n        return len(str(number))\n\n    k = 1\n    while True:\n        triangular_value = calculate_triangular_number(k)\n        digit_count = count_digits(triangular_value)\n        if digit_count == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"Check if the given string starts with a vowel using regex, case-insensitively.\"\"\"\n    if not input_string:\n        return False\n    # The regex r'^[aeiou]' matches a string that starts with a, e, i, o, or u.\n    # The re.IGNORECASE flag makes the matching case-insensitive.\n    return bool(re.match(r'^[aeiou]', input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple into a dictionary using adjacent elements as key-value pairs.\n    Assumes an even-length tuple where elements at even indices are keys and odd indices are values.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(edge_length: float) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n    The formula used is \u221a3 \u00d7 edge_length\u00b2.\n    \"\"\"\n    # The surface area of a regular tetrahedron is given by the formula: A = sqrt(3) * a^2\n    # where 'a' is the edge length.\n    return math.sqrt(3) * (edge_length ** 2)"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"\n    Check whether all characters in a string are identical.\n\n    Returns True if all characters are the same, False otherwise.\n    \"\"\"\n    return len(set(input_string)) <= 1"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst: list, positions: int) -> list:\n    \"\"\"\n    Rotates a list to the right by a specified number of positions.\n    Returns a new list with the rotated elements.\n    \"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n\n    # Calculate the effective number of positions to rotate\n    effective_positions = positions % n\n\n    # Slice the list into two parts and concatenate them to rotate\n    return lst[n - effective_positions:] + lst[:n - effective_positions]"}
{"task_id": "Mbpp/744", "solution": "def check_none(input_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains any None values.\n    Returns True if at least one None is found, False otherwise.\n    \"\"\"\n    return any(element is None for element in input_tuple)"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words in a string where a word starts with a capital letter\n    and is preceded by a lowercase letter.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result = []\n    result.append(input_string[0])\n\n    for i in range(1, len(input_string)):\n        current_char = input_string[i]\n        previous_char = input_string[i-1]\n\n        # Insert space if current_char is uppercase and previous_char is lowercase\n        if current_char.isupper() and previous_char.islower():\n            result.append(\" \")\n        result.append(current_char)\n\n    return \"\".join(result)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Find numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded to prevent division by zero.\n    \"\"\"\n\n    def extract_digits(number: int) -> list[int]:\n        \"\"\"Extract individual digits from a number.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def contains_zero(number: int) -> bool:\n        \"\"\"Check if the number contains the digit 0.\"\"\"\n        return '0' in str(number)\n\n    def is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"Check if the number is divisible by all its non-zero digits.\"\"\"\n        digits = extract_digits(number)\n        for digit in digits:\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if contains_zero(num):\n            continue\n        if is_divisible_by_all_digits(num):\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(string_numbers: list[str]) -> list[int]:\n    \"\"\"Converts a list of string numbers to integers and sorts them numerically.\"\"\"\n    integer_numbers = [int(s) for s in string_numbers]\n    return sorted(integer_numbers)"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(input_list: list, input_tuple: tuple) -> list:\n    \"\"\"Combines a list and a tuple into a new list.\n\n    The original list and tuple remain unchanged, and their elements are appended in order.\n    \"\"\"\n    new_list = list(input_list)\n    new_list.extend(input_tuple)\n    return new_list"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min heap.\n    An empty array or an array with one element is considered a valid min heap.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes, which are at indices from 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        parent_value = array[i]\n        \n        # Check left child\n        left_child_idx = 2 * i + 1\n        if left_child_idx < n:\n            if parent_value > array[left_child_idx]:\n                return False\n        \n        # Check right child\n        right_child_idx = 2 * i + 2\n        if right_child_idx < n:\n            if parent_value > array[right_child_idx]:\n                return False\n                \n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements that appear in all three lists at the same index.\n    Returns a list of these common elements.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    common_elements = []\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple\n\ndef validate_inputs(tuple_list: List[Tuple[str, int]], k: int) -> None:\n    \"\"\"Validates input parameters.\"\"\"\n    pass\n\ndef sort_tuples(tuple_list: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"Sorts tuples by second element in ascending order.\"\"\"\n    return sorted(tuple_list, key=lambda x: x[1])\n\ndef select_k_tuples(sorted_list: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"Selects first k tuples from sorted list.\"\"\"\n    return sorted_list[:k]\n\ndef min_k(tuple_list: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"Main function to find minimum k records from tuple list.\"\"\"\n    validate_inputs(tuple_list, k)\n    sorted_data = sort_tuples(tuple_list)\n    result = select_k_tuples(sorted_data, k)\n    return result"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculate the nth Jacobsthal number using an iterative approach.\n    Handles base cases for n=0, 1, and 2 directly.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1 or n == 2:\n        return 1\n\n    # Initialize j_prev_prev to J(1) and j_prev to J(2)\n    j_prev_prev = 1\n    j_prev = 1\n\n    # Iterate from n=3 up to the desired n\n    for _ in range(3, n + 1):\n        current_j = j_prev + 2 * j_prev_prev\n        j_prev_prev = j_prev\n        j_prev = current_j\n\n    return j_prev"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"Check if string is valid decimal with exactly 2 decimal places.\"\"\"\n    if not isinstance(input_string, str):\n        return False\n\n    def _has_single_decimal_point(s: str) -> bool:\n        \"\"\"Check if string contains exactly one decimal point.\"\"\"\n        return s.count('.') == 1\n\n    def _has_exactly_two_decimal_places(s: str) -> bool:\n        \"\"\"Check if string has exactly 2 digits after decimal point.\"\"\"\n        parts = s.split('.')\n        return len(parts) == 2 and len(parts[1]) == 2\n\n    def _contains_only_valid_characters(s: str) -> bool:\n        \"\"\"Check if string contains only valid numeric characters and decimal point.\"\"\"\n        if not s:\n            return False\n        for char in s:\n            if not ('0' <= char <= '9' or char == '.'):\n                return False\n        return True\n\n    if not _contains_only_valid_characters(input_string):\n        return False\n    if not _has_single_decimal_point(input_string):\n        return False\n    if not _has_exactly_two_decimal_places(input_string):\n        return False\n\n    # Ensure there's at least one digit before the decimal point\n    parts = input_string.split('.')\n    if not parts[0]: # e.g. \".11\"\n        return False\n    \n    return True"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Union\n\ndef second_smallest(input_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the second smallest unique number in a list.\n    Handles lists with negative numbers, zero, and duplicate values.\n    \"\"\"\n\n    def _get_unique_sorted(lst: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"\n        Removes duplicates and sorts unique numerical values in ascending order.\n        \"\"\"\n        unique_elements = sorted(list(set(lst)))\n        return unique_elements\n\n    def _extract_second_smallest(unique_sorted_list: List[Union[int, float]]) -> Union[int, float]:\n        \"\"\"\n        Extracts the second element from a sorted unique list or raises a ValueError.\n        This handles cases where there are not enough unique values.\n        \"\"\"\n        if len(unique_sorted_list) < 2:\n            raise ValueError(\"Insufficient unique values to determine a second smallest.\")\n        return unique_sorted_list[1]\n\n    unique_sorted = _get_unique_sorted(input_list)\n    result = _extract_second_smallest(unique_sorted)\n    return result"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings):\n    \"\"\"\n    Counts pairs of strings in a list where one is the reverse of the other,\n    excluding palindromes and ensuring O(n) time complexity.\n    \"\"\"\n    if not strings:\n        return 0\n\n    seen_strings = set()\n    pairs_count = 0\n\n    for s in strings:\n        if s in seen_strings:\n            continue\n\n        reversed_s = s[::-1]\n\n        # Palindromes are not counted as pairs with themselves\n        if s == reversed_s:\n            seen_strings.add(s) # Mark palindrome as seen to avoid re-processing\n            continue\n\n        if reversed_s in seen_strings:\n            pairs_count += 1\n            # Mark both original and its reverse as \"processed\" to avoid double counting\n            # e.g., if 'best' and 'tseb' are found, both are removed from consideration\n            # for future iterations if we were using a mutable list or similar.\n            # With a set for 'seen_strings', we simply add the current string.\n            # The 'reversed_s' was already in 'seen_strings'.\n            # The goal is that once a pair (s, reversed_s) is counted,\n            # neither s nor reversed_s should contribute to another pair.\n            # Adding s to seen_strings here prevents it from being processed again.\n            # When reversed_s was added earlier, it essentially acted as a \"marker\"\n            # that a potential reverse was present.\n            seen_strings.add(s)\n        else:\n            seen_strings.add(s)\n\n    return pairs_count"}
{"task_id": "Mbpp/758", "solution": "import collections\nfrom typing import List, Dict, Tuple\n\ndef unique_sublists(input_list: List) -> Dict[Tuple, int]:\n    \"\"\"\n    Counts occurrences of sublists and returns them as a dictionary with tuple keys.\n    Each sublist is converted to a tuple to serve as a hashable dictionary key.\n    \"\"\"\n    tuple_list = [tuple(sublist) for sublist in input_list]\n    return collections.Counter(tuple_list)"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if only one distinct element, False otherwise.\n    \"\"\"\n    if not numbers:\n        return True\n    distinct_elements = set(numbers)\n    return len(distinct_elements) == 1"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in an array.\n    Assumes the array has at least two elements.\n    \"\"\"\n    min_diff = float('inf')\n    for i in range(length):\n        for j in range(i + 1, length):\n            diff = abs(array[i] - array[j])\n            if diff < min_diff:\n                min_diff = diff\n    return min_diff"}
