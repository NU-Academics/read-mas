{"task_id": "Mbpp/103", "solution": "import math\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using the explicit formula.\n    \"\"\"\n    result = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * math.comb(n + 1, k) * ((m + 1 - k)**n)\n        result += term\n    return result"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"Converts a snake_case string to a CamelCase string.\n\n    Splits the string by underscores, capitalizes each word, and joins them.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    words = input_string.split('_')\n    camel_words = [word.capitalize() for word in words]\n    return \"\".join(camel_words)"}
