{"task_id": "Mbpp/771", "solution": "from typing import List, Set, Dict\n\nclass BracketType:\n    OPENING_BRACKETS: Set[str] = {'(', '[', '{'}\n    CLOSING_BRACKETS: Set[str] = {')', ']', '}'}\n    BRACKET_PAIRS: Dict[str, str] = {')': '(', ']': '[', '}': '{'}\n\n    @staticmethod\n    def is_opening(char: str) -> bool:\n        \"\"\"Check if character is an opening bracket.\"\"\"\n        return char in BracketType.OPENING_BRACKETS\n\n    @staticmethod\n    def is_closing(char: str) -> bool:\n        \"\"\"Check if character is a closing bracket.\"\"\"\n        return char in BracketType.CLOSING_BRACKETS\n\n    @staticmethod\n    def get_matching(char: str) -> str:\n        \"\"\"Get the matching opening bracket for a closing bracket.\"\"\"\n        return BracketType.BRACKET_PAIRS.get(char)\n\nclass BracketStack:\n    def __init__(self):\n        self._items: List[str] = []\n\n    def push(self, bracket: str) -> None:\n        \"\"\"Adds a bracket to the top of the stack.\"\"\"\n        self._items.append(bracket)\n\n    def pop(self) -> str:\n        \"\"\"Removes and returns the bracket from the top of the stack.\"\"\"\n        if not self.is_empty():\n            return self._items.pop()\n        return None # Should not happen if `is_empty` is checked first\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\n    def peek(self) -> str:\n        \"\"\"Returns the bracket at the top of the stack without removing it.\"\"\"\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\nclass BracketValidator:\n    def check_balance(self, expression: str) -> bool:\n        \"\"\"Implements the core algorithm to check bracket balance.\"\"\"\n        stack = BracketStack()\n\n        for char in expression:\n            if BracketType.is_opening(char):\n                stack.push(char)\n            elif BracketType.is_closing(char):\n                if stack.is_empty():\n                    return False  # Closing bracket with no matching opening bracket\n                \n                top_bracket = stack.pop()\n                expected_opening = BracketType.get_matching(char)\n\n                if top_bracket != expected_opening:\n                    return False  # Mismatched brackets\n            # Ignore non-bracket characters\n\n        return stack.is_empty() # True if all opening brackets were matched\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"Main entry point to check if the given expression is balanced.\"\"\"\n    validator = BracketValidator()\n    return validator.check_balance(expression)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if no match is found.\n    \"\"\"\n    start_index = main_string.find(substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a positive integer is even.\n    Returns True if the count is even, False if the count is odd.\n    \"\"\"\n    # A positive integer has an odd number of divisors if and only if it is a perfect square.\n    # Therefore, the count of divisors is even if and only if the number is NOT a perfect square.\n    \n    root = int(math.sqrt(n))\n    is_perfect_square = (root * root == n)\n    \n    # Return True if the divisor count is even (i.e., n is not a perfect square).\n    return not is_perfect_square"}
