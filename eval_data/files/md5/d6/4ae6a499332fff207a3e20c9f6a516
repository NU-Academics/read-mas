{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 up to n // 2,\n    stopping if a term is less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    # Iterate 'i' from 0 up to n // 2 (inclusive).\n    for i in range(n // 2 + 1):\n        current_term = n - 2 * i\n        # If the current term is less than or equal to 0, stop adding terms.\n        if current_term <= 0:\n            break\n        total_sum += current_term\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    def _gcd(val_a: int, val_b: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        val_a, val_b = abs(val_a), abs(val_b)\n        while val_b:\n            val_a, val_b = val_b, val_a % val_b\n        return val_a\n\n    def _extended_euclidean_positive(val_a: int, val_b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm for non-negative integers.\n        Returns (g, x, y) such that a*x + b*y = g = gcd(a, b).\n        \"\"\"\n        x, prev_x = 0, 1\n        y, prev_y = 1, 0\n        while val_b != 0:\n            q = val_a // val_b\n            val_a, val_b = val_b, val_a % val_b\n            x, prev_x = prev_x - q * x, x\n            y, prev_y = prev_y - q * y, y\n        return val_a, prev_x, prev_y\n\n    def _extended_euclidean(val_a: int, val_b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Wrapper for the Extended Euclidean Algorithm that handles negative inputs.\n        Returns (g, x, y) such that val_a*x + val_b*y = g = gcd(abs(val_a), abs(val_b)).\n        \"\"\"\n        if val_a == 0 and val_b == 0:\n            return (0, 0, 0)\n        if val_a == 0:\n            return (abs(val_b), 0, 1 if val_b >= 0 else -1)\n        if val_b == 0:\n            return (abs(val_a), 1 if val_a >= 0 else -1, 0)\n\n        # Apply extended Euclidean algorithm to absolute values\n        g_abs, x_abs, y_abs = _extended_euclidean_positive(abs(val_a), abs(val_b))\n\n        # Adjust signs of x and y based on original val_a and val_b\n        x = x_abs if val_a >= 0 else -x_abs\n        y = y_abs if val_b >= 0 else -y_abs\n\n        return (g_abs, x, y)\n\n    # Handle the specific case where both 'a' and 'b' are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Calculate GCD and base coefficients using Extended Euclidean Algorithm\n    g, x_base, y_base = _extended_euclidean(a, b)\n\n    # If 'n' is not divisible by 'g', no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Scale the base solution (a*x_base + b*y_base = g) to ax + by = n\n    factor = n // g\n    x_particular = x_base * factor\n    y_particular = y_base * factor\n\n    # Normalize the solution. If b is non-zero, find the smallest non-negative x.\n    # Otherwise, x_particular is already the unique x and y_particular is 0.\n    if b != 0:\n        b_over_g = b // g\n        a_over_g = a // g\n\n        # Calculate x_final such that it is in [0, abs(b_over_g) - 1]\n        # Python's % operator returns a result with the same sign as the divisor.\n        # To ensure x_final is non-negative, we add abs(b_over_g) if it's negative.\n        x_final = x_particular % b_over_g\n        if x_final < 0:\n            x_final += abs(b_over_g)\n\n        # Calculate k_shift needed to transform x_particular to x_final\n        # x_final = x_particular + k_shift * b_over_g\n        k_shift = (x_final - x_particular) // b_over_g\n\n        # Adjust y_particular using the same k_shift\n        y_final = y_particular - k_shift * a_over_g\n        return (x_final, y_final)\n    else:\n        # If b is 0, x_particular is the unique x solution, and y_particular is 0.\n        return (x_particular, y_particular)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters whose position in the string matches their position in the alphabet (case-insensitive).\"\"\"\n    match_count = 0\n    for i, char in enumerate(input_string):\n        normalized_char = char.lower()\n        # Check if the character is an alphabet letter\n        if 'a' <= normalized_char <= 'z':\n            # Calculate its 0-indexed position in the alphabet\n            alphabet_position = ord(normalized_char) - ord('a')\n            # Compare with its 0-indexed position in the string\n            if alphabet_position == i:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/167", "solution": "import math\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculate the smallest power of 2 greater than or equal to n.\n\n    Args:\n        n (int): Input integer value\n\n    Returns:\n        int: Smallest power of 2 >= n\n\n    Examples:\n        >>> next_power_of_2(0)\n        1\n        >>> next_power_of_2(5)\n        8\n        >>> next_power_of_2(8)\n        8\n    \"\"\"\n    if n <= 1:\n        return 1\n    # Calculate the exponent k such that 2^k >= n, where k = ceil(log2(n)).\n    power = math.ceil(math.log2(n))\n    return 2**power"}
