{"task_id": "Mbpp/128", "solution": "def _parse_text(text: str) -> list[str]:\n    \"\"\"Parses input text into individual words, splitting by whitespace.\"\"\"\n    return text.split()\n\ndef _filter_words(words: list[str], threshold: int) -> list[str]:\n    \"\"\"Filters a list of words, returning only those longer than the given threshold.\"\"\"\n    return [word for word in words if len(word) > threshold]\n\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words.\n    The function parses the text into words, then filters them based on length.\n    \"\"\"\n    parsed_words = _parse_text(text)\n    filtered_words = _filter_words(parsed_words, n)\n    return filtered_words"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum absolute difference between the count of '0's and '1's\n    in any substring of the given binary string.\n    \"\"\"\n    n = len(binary_string)\n    if n == 0:\n        return 0\n\n    max_diff = 0\n\n    # Iterate through all possible substrings\n    for i in range(n):\n        for j in range(i, n):\n            current_substring = binary_string[i : j+1]\n\n            # Calculate the difference for the current substring\n            count_0 = current_substring.count('0')\n            count_1 = current_substring.count('1')\n            current_diff = abs(count_0 - count_1)\n\n            # Update the maximum difference found\n            max_diff = max(max_diff, current_diff)\n\n    return max_diff"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple\n\ndef is_square_matrix(matrix: List[List[int]]) -> bool:\n    \"\"\"Checks if the input matrix is a square matrix (n x n) and non-empty.\"\"\"\n    n = len(matrix)\n    if n == 0:  # Empty matrix is not a valid square matrix for magic square test (n >= 1)\n        return False\n    for row in matrix:\n        if len(row) != n:  # Check if all rows have the same length as the number of rows\n            return False\n    return True\n\ndef calculate_row_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef calculate_column_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n    n = len(matrix)\n    column_sums = [0] * n\n    for r in range(n):\n        for c in range(n):\n            column_sums[c] += matrix[r][c]\n    return column_sums\n\ndef calculate_diagonal_sums(matrix: List[List[int]]) -> Tuple[int, int]:\n    \"\"\"Calculates the sums of the main diagonal and the anti-diagonal.\"\"\"\n    n = len(matrix)\n    main_diag_sum = 0\n    anti_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n        anti_diag_sum += matrix[i][n - 1 - i]\n    return (main_diag_sum, anti_diag_sum)\n\ndef all_sums_equal(sums: List[int]) -> bool:\n    \"\"\"Checks if all values in a list of sums are equal.\"\"\"\n    if not sums:  # If there are no sums, by convention, they are considered equal\n        return True\n    first_sum = sums[0]\n    for s in sums:\n        if s != first_sum:\n            return False\n    return True\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if a given square matrix is a magic square.\n    A magic square has all rows, columns, and main diagonals summing to the same value.\n    \"\"\"\n    if not is_square_matrix(matrix):\n        return False\n\n    row_sums = calculate_row_sums(matrix)\n    column_sums = calculate_column_sums(matrix)\n    main_diag_sum, anti_diag_sum = calculate_diagonal_sums(matrix)\n\n    all_calculated_sums = row_sums + column_sums + [main_diag_sum, anti_diag_sum]\n\n    return all_sums_equal(all_calculated_sums)"}
{"task_id": "Mbpp/130", "solution": "def count_frequencies(input_list: list) -> dict:\n    \"\"\"Counts the occurrences of each item in the input list.\"\"\"\n    frequencies = {}\n    for item in input_list:\n        frequencies[item] = frequencies.get(item, 0) + 1\n    return frequencies\n\ndef find_max_frequency_item(frequencies: dict) -> any:\n    \"\"\"Identifies the item with the highest frequency from a frequency map.\"\"\"\n    if not frequencies:\n        return None\n    most_frequent_item = max(frequencies, key=frequencies.get)\n    return most_frequent_item\n\ndef max_occurrences(input_list: list) -> any:\n    \"\"\"Finds the item with the maximum frequency in a given list.\"\"\"\n    frequencies = count_frequencies(input_list)\n    return find_max_frequency_item(frequencies)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string.\n    'y' is not considered a vowel.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel.\"\"\"\n        return char in VOWELS\n\n    s_list = list(input_string)\n    \n    # Extract vowels and their positions\n    vowel_indices = []\n    extracted_vowels = []\n    for i, char in enumerate(s_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            extracted_vowels.append(char)\n    \n    # Reverse the extracted vowels\n    extracted_vowels.reverse()\n    \n    # Place reversed vowels back into the string list\n    for i, vowel_char in zip(vowel_indices, extracted_vowels):\n        s_list[i] = vowel_char\n        \n    return \"\".join(s_list)"}
