{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\ndef _get_square_root(number: int) -> int:\n    \"\"\"Calculate the integer square root of a number.\"\"\"\n    return math.isqrt(number)\n\ndef _is_perfect_square(number: int) -> bool:\n    \"\"\"Check if a number is a perfect square.\"\"\"\n    if number < 0:\n        return False\n    root = _get_square_root(number)\n    return root * root == number\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"Find all perfect squares in the inclusive range [start, end].\"\"\"\n    result = []\n    \n    if end < 0:\n        return []\n    \n    adjusted_start = max(0, start)\n    \n    current_root = _get_square_root(adjusted_start)\n    \n    if current_root * current_root < adjusted_start:\n        current_root += 1\n\n    while True:\n        square = current_root * current_root\n        \n        if square > end:\n            break\n        \n        result.append(square)\n        \n        current_root += 1\n        \n    return result"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius: float, theta: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts polar coordinates (radius, theta) to rectangular coordinates (x, y).\n    Returns a tuple containing the (x, y) coordinates and their complex number representation.\n    \"\"\"\n    x = radius * math.cos(theta)\n    y = radius * math.sin(theta)\n    return ((x, y), complex(x, y))"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list with the swapped elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return list(input_list) # Return a copy of the original list for short lists\n\n    # Create a mutable copy of the input list\n    temp_list = list(input_list)\n    \n    # Swap the first and last elements in the copied list\n    temp_list[0], temp_list[-1] = temp_list[-1], temp_list[0]\n    \n    return temp_list"}
{"task_id": "Mbpp/592", "solution": "def factorial(n: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n    res = 1\n    for i in range(1, n + 1):\n        res *= i\n    return res\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k) using factorials.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return factorial(n) // (factorial(k) * factorial(n - k))\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    The sum is taken for k from 0 to n-1.\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        coeff_k = binomial_coefficient(n, k)\n        coeff_k_plus_1 = binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
