{"task_id": "Mbpp/454", "solution": "import re\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains the character 'z'.\n    Punctuation and whitespace are treated as word separators.\n    \"\"\"\n    def _parse_words(text: str) -> list[str]:\n        \"\"\"Splits the input text into words using non-alphanumeric characters as delimiters.\"\"\"\n        # Use regex to split by any non-word character (includes punctuation and whitespace)\n        # Filter out empty strings that may result from multiple delimiters\n        return [word for word in re.split(r'\\W+', text) if word]\n\n    def _contains_z(word: str) -> bool:\n        \"\"\"Checks if a single word contains the lowercase character 'z'.\"\"\"\n        return 'z' in word\n\n    words = _parse_words(input_string)\n    for word in words:\n        if _contains_z(word):\n            return True\n    return False"}
