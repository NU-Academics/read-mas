{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculate the difference between sum of cubes and sum of natural numbers.\n    \"\"\"\n    sum_of_natural_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_natural_numbers ** 2\n    return sum_of_cubes - sum_of_natural_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, size):\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    Iterates through all possible pairs and checks their XOR sum.\n    \"\"\"\n    def _calculate_xor(a, b):\n        \"\"\"Calculates the XOR of two integers.\"\"\"\n        return a ^ b\n\n    def _is_odd(value):\n        \"\"\"Checks if a number is odd.\"\"\"\n        return (value % 2) != 0\n\n    count = 0\n    for i in range(size):\n        for j in range(i + 1, size):\n            xor_result = _calculate_xor(array[i], array[j])\n            if _is_odd(xor_result):\n                count += 1\n    return count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_str: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string, preserving non-alphabetic characters.\"\"\"\n    toggled_chars = []\n    for char in input_str:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
