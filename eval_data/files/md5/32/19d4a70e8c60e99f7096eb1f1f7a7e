{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_list):\n    \"\"\"\n    Finds elements that are common to all sublists within a nested list.\n    Returns a set of these common elements.\n    \"\"\"\n    if not nested_list:\n        return set()\n\n    # Convert the first sublist to a set to start the intersection\n    common_elements = set(nested_list[0])\n\n    # Iterate through the rest of the sublists and find their intersection with the current common_elements\n    for sublist in nested_list[1:]:\n        common_elements = common_elements.intersection(set(sublist))\n        if not common_elements:  # Optimization: if at any point the intersection is empty, no further elements can be common\n            return set()\n\n    return common_elements"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their string representations.\n    Handles an empty tuple by returning 0, as per the design context's implied behavior for a non-error case (empty string converted to int).\n    \"\"\"\n    if not input_tuple:\n        return 0\n    \n    # The design context indicates \"validate_input\" would handle validation,\n    # but since we are not to raise exceptions for edge cases and assert implies valid input,\n    # we proceed directly with concatenation.\n    \n    # Convert each integer in the tuple to a string, then join them.\n    concatenated_string = \"\".join(str(num) for num in input_tuple)\n    \n    # Convert the resulting string back to an integer.\n    return int(concatenated_string)"}
{"task_id": "Mbpp/109", "solution": "def _validate_binary_string(binary_string: str) -> bool:\n    \"\"\"Validates if the string contains only '0's and '1's.\"\"\"\n    if not binary_string:\n        return False\n    return all(char in '01' for char in binary_string)\n\ndef _rotate_left(binary_string: str) -> str:\n    \"\"\"Performs a single left rotation on a binary string.\"\"\"\n    if not binary_string:\n        return \"\"\n    return binary_string[1:] + binary_string[0]\n\ndef _convert_to_decimal(binary_string: str) -> int:\n    \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n    if not binary_string: # int(\"\", 2) raises ValueError, handle this case.\n        return 0\n    return int(binary_string, 2)\n\ndef _is_odd(decimal_value: int) -> bool:\n    \"\"\"Determines if a decimal integer value is odd.\"\"\"\n    return decimal_value % 2 != 0\n\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n    \"\"\"\n    if not _validate_binary_string(binary_string):\n        return 0  # Return 0 for invalid binary string as exceptions are forbidden.\n\n    if rotations < 0:\n        return 0  # Return 0 for negative rotations as exceptions are forbidden.\n    \n    current_rotated_string = binary_string\n    odd_count = 0\n\n    for _ in range(rotations):\n        current_rotated_string = _rotate_left(current_rotated_string)\n        decimal_value = _convert_to_decimal(current_rotated_string)\n        \n        if _is_odd(decimal_value):\n            odd_count += 1\n            \n    return odd_count"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer (positive, negative, or zero).\n    Handles optional leading signs and verifies all subsequent characters are digits.\n    \"\"\"\n    if not input_string:\n        return False\n\n    # Check for whitespace-only strings\n    if not input_string.strip():\n        return False\n\n    start_index = 0\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n\n    # The string must contain at least one digit after an optional sign\n    if len(input_string) <= start_index:\n        return False\n\n    # Check if all characters from start_index are digits\n    for char in input_string[start_index:]:\n        if not char.isdigit():\n            return False\n\n    return True"}
{"task_id": "Mbpp/88", "solution": "from typing import List, Dict\n\ndef freq_count(input_list: List) -> Dict:\n    \"\"\"\n    Count frequency of elements in a list and return as dictionary.\n    \"\"\"\n    frequencies = {}\n    for element in input_list:\n        frequencies[element] = frequencies.get(element, 0) + 1\n    return frequencies"}
{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear in pairs.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        if mid % 2 == 0:  # mid is an even index\n            if array[mid] == array[mid + 1]:\n                # The pair (array[mid], array[mid+1]) is correctly aligned.\n                # Unique element must be in the right half.\n                low = mid + 2\n            else:\n                # array[mid] is not equal to array[mid+1].\n                # The unique element is array[mid] or to its left.\n                high = mid\n        else:  # mid is an odd index\n            if array[mid] == array[mid - 1]:\n                # The pair (array[mid-1], array[mid]) is correctly aligned.\n                # Unique element must be in the right half.\n                low = mid + 1\n            else:\n                # array[mid] is not equal to array[mid-1].\n                # The unique element is array[mid] or to its left.\n                high = mid\n    \n    return array[low]"}
