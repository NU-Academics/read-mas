{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of elements from two tuples containing nested tuples.\n    Each nested tuple's corresponding elements are multiplied together.\n    \"\"\"\n    result = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        multiplied_inner_tuple = (\n            inner_tuple1[0] * inner_tuple2[0],\n            inner_tuple1[1] * inner_tuple2[1]\n        )\n        result.append(multiplied_inner_tuple)\n    return tuple(result)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple, search_elements):\n    \"\"\"\n    Counts the total occurrences of elements from a list within a tuple.\n    Iterates through each search element and sums its counts from the tuple.\n    \"\"\"\n    total_count = 0\n    for element in search_elements:\n        total_count += input_tuple.count(element)\n    return total_count"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\ndef find_adverb_position(sentence: str):\n    # A set of common adverbs for case-insensitive lookup.\n    # This list is illustrative and covers typical adverbs including those ending in -ly.\n    ADVERBS = {\n        \"clearly\", \"quickly\", \"slowly\", \"very\", \"always\", \"never\", \"often\",\n        \"sometimes\", \"hardly\", \"really\", \"badly\", \"fully\", \"easily\", \"happily\",\n        \"loudly\", \"softly\", \"early\", \"late\", \"well\", \"fast\", \"soon\", \"then\",\n        \"now\", \"here\", \"there\", \"everywhere\", \"anywhere\", \"somewhere\", \"nowhere\",\n        \"today\", \"tomorrow\", \"yesterday\", \"indeed\", \"almost\", \"just\", \"quite\",\n        \"rather\", \"ago\", \"forth\", \"back\", \"away\"\n    }\n\n    # Iterate through the sentence to find non-whitespace tokens and their spans.\n    # This allows identifying words along with any attached punctuation.\n    for match in re.finditer(r'\\S+', sentence):\n        token = match.group(0)\n        token_start_index = match.start()\n\n        # Strip punctuation from the token to get the clean word for adverb identification.\n        clean_word = token.strip(string.punctuation)\n\n        # Check if the cleaned word (case-insensitively) is in our list of adverbs.\n        if clean_word.lower() in ADVERBS:\n            # Calculate the end position based on the length of the clean adverb\n            # relative to the original token's start position.\n            adverb_text = clean_word\n            start_position = token_start_index\n            end_position = start_position + len(adverb_text)\n\n            return (start_position, end_position, adverb_text)\n\n    # If no adverb is found after checking all tokens, return None.\n    return None"}
