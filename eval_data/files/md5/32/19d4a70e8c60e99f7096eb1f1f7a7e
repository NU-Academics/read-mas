{"task_id": "Mbpp/564", "solution": "from typing import List\n\ndef count_Pairs(numbers: List[int], length: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs in a list of integers\n    where both elements are unequal.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    count = 0\n    # Iterate through all unique pairs (i, j) where i < j\n    for i in range(n):\n        for j in range(i + 1, n):\n            # If elements at indices i and j are different, increment the count\n            if numbers[i] != numbers[j]:\n                count += 1\n    return count"}
{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"\n    Checks if a list is sorted in ascending order.\n    Iterates through adjacent elements and returns False immediately upon finding an unsorted pair.\n    \"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return True\n    \n    for i in range(n - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"Calculate sum of digits in a non-negative integer.\"\"\"\n    if number == 0:\n        return 0\n\n    digit_sum = 0\n    while number > 0:\n        digit_sum += number % 10\n        number //= 10\n\n    return digit_sum"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists: list) -> list:\n    \"\"\"Sorts each sublist of strings in a given list of lists.\"\"\"\n    def validate_input(input_data: any) -> bool:\n        \"\"\"Validates that the input is a list of lists containing only strings.\"\"\"\n        if not isinstance(input_data, list):\n            raise ValueError(\"Input must be a list.\")\n        for sublist in input_data:\n            if not isinstance(sublist, list):\n                raise ValueError(\"All elements of the main list must be lists.\")\n            for item in sublist:\n                if not isinstance(item, str):\n                    raise ValueError(\"All elements within sublists must be strings.\")\n        return True\n\n    def sort_strings(string_list: list) -> list:\n        \"\"\"Sorts a list of strings lexicographically.\"\"\"\n        return sorted(string_list)\n\n    def process_main_list(main_list: list) -> list:\n        \"\"\"Processes the main list by sorting each sublist.\"\"\"\n        # Create a new list to store results without modifying the original input\n        processed_list = []\n        for sublist in main_list:\n            processed_list.append(sort_strings(sublist))\n        return processed_list\n\n    validate_input(list_of_lists)\n    return process_main_list(list_of_lists)"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    \"\"\"\n    Remove duplicate numbers from input list, returning only numbers that appear exactly once.\n    Preserves the original order of unique numbers.\n    \"\"\"\n    counts = {}\n    for num in input_list:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in input_list:\n        if counts[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/568", "solution": "def empty_list(n: int) -> list[dict]:\n    \"\"\"Create a list of N empty dictionaries.\"\"\"\n    return [{} for _ in range(n)]"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list: list) -> int:\n    \"\"\"\n    Calculate the product of unique numbers in a given list.\n\n    Args:\n        input_list (list): List of numeric values\n\n    Returns:\n        int: Product of unique numbers\n    \"\"\"\n    unique_elements = set(input_list)\n    product = 1\n    for number in unique_elements:\n        product *= number\n    return product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    For numbers 5 or greater, the last digit is always 0 due to prime factors 2 and 5.\n    \"\"\"\n    if number < 0:\n        # Factorial is typically defined for non-negative integers.\n        # As per design, no explicit error handling is required, but a common\n        # return for invalid input might be considered in a real system.\n        # For this problem, we'll assume valid non-negative input as per typical factorial definitions.\n        # However, a negative input would not have a meaningful last digit of factorial,\n        # so this path should ideally not be taken with valid inputs.\n        return 0 # Or raise an error, but problem statement says no exceptions.\n    elif number >= 5:\n        return 0\n    elif number == 0:\n        return 1\n    elif number == 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        return 4\n    # This path should not be reached with typical non-negative integer inputs."}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Check if sub_list is a contiguous sublist of main_list.\n    Returns True if sub_list is contiguous in main_list, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are taken in order: list1[i], list2[i], list3[i] for each index i.\n    \"\"\"\n    result_list = []\n    # All lists are assumed to have the same length as per design context\n    for i in range(len(list1)):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n    return result_list"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculate the surface area of a square pyramid.\n    Returns the total surface area of the square pyramid.\n    \"\"\"\n    base_area = base_edge * base_edge\n    # Assuming the 'height' parameter represents the slant height of the pyramid.\n    triangular_faces_area = 2 * base_edge * height\n    total_surface_area = base_area + triangular_faces_area\n    return total_surface_area"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in one tuple but not in the other, preserving original order.\n    \"\"\"\n\n    def _convert_to_sets(t1: tuple, t2: tuple) -> tuple[set, set]:\n        \"\"\"Converts input tuples to sets for efficient comparison.\"\"\"\n        return set(t1), set(t2)\n\n    def _calculate_symmetric_difference(s1: set, s2: set) -> set:\n        \"\"\"Calculates the symmetric difference between two sets.\"\"\"\n        return s1.symmetric_difference(s2)\n\n    def _preserve_order(original_tuple1: tuple, original_tuple2: tuple, difference_set: set) -> tuple:\n        \"\"\"Reconstructs the result tuple, preserving element order from original inputs.\"\"\"\n        result_list = []\n        added_to_result = set()\n\n        for item in original_tuple1:\n            if item in difference_set and item not in added_to_result:\n                result_list.append(item)\n                added_to_result.add(item)\n\n        for item in original_tuple2:\n            if item in difference_set and item not in added_to_result:\n                result_list.append(item)\n                added_to_result.add(item)\n        return tuple(result_list)\n\n    set1, set2 = _convert_to_sets(tuple1, tuple2)\n    difference_set = _calculate_symmetric_difference(set1, set2)\n    final_result = _preserve_order(tuple1, tuple2, difference_set)\n\n    return final_result"}
{"task_id": "Mbpp/583", "solution": "def factorial(k):\n    # Calculates the factorial of a non-negative integer k.\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef catalan_number(n: int) -> int:\n    # Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    numerator = factorial(2 * n)\n    denominator = factorial(n + 1) * factorial(n)\n    return numerator // denominator"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes odd integer elements from a nested mixed tuple, preserving structure.\n    Recursively processes tuple elements to filter out uneven integers.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            processed_sub_tuple = extract_even(item)\n            result.append(processed_sub_tuple)\n        elif isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        else:\n            result.append(item)\n    return tuple(result)"}
