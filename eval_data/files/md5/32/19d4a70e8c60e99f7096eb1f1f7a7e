{"task_id": "Mbpp/65", "solution": "import collections\n\ndef recursive_list_sum(input_list: list) -> (int | float):\n    \"\"\"Flattens a list and sums all of its numeric elements.\"\"\"\n    def _is_numeric(element) -> bool:\n        \"\"\"Determines if an element is numeric (int or float).\"\"\"\n        return isinstance(element, (int, float))\n\n    def _flatten_helper(nested_list: list) -> list:\n        \"\"\"Recursively flattens nested list structures.\"\"\"\n        flattened = []\n        for item in nested_list:\n            if isinstance(item, collections.abc.Iterable) and not isinstance(item, (str, bytes)):\n                flattened.extend(_flatten_helper(item))\n            else:\n                flattened.append(item)\n        return flattened\n\n    total_sum = 0\n    flattened_list = _flatten_helper(input_list)\n    for element in flattened_list:\n        if _is_numeric(element):\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number, representing the number of ways to partition a set of n elements.\n    It uses the Bell triangle method for efficient computation.\"\"\"\n    if n == 0:\n        return 1\n\n    bell_row = [1]  # Initialize the first row (B_0).\n\n    for i in range(1, n + 1):\n        # Start a new row; its first element is the last element of the previous row.\n        next_row = [bell_row[-1]]\n        # Compute subsequent elements in the new row based on the previous and current rows.\n        for j in range(i):\n            next_row.append(bell_row[j] + next_row[-1])\n        bell_row = next_row\n\n    return bell_row[0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Check if the given array is monotonic (either non-decreasing or non-increasing).\n    An empty array or a single-element array is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n        \n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
