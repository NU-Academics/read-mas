{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n    return char.lower() in VOWELS\n\ndef _extract_vowels(text: str) -> list:\n    \"\"\"Extracts all vowels from the input string in order.\"\"\"\n    extracted_vowels = []\n    for char in text:\n        if _is_vowel(char):\n            extracted_vowels.append(char)\n    return extracted_vowels\n\ndef _reconstruct_string(original: str, reversed_vowels: list) -> str:\n    \"\"\"Rebuilds the string with reversed vowels in their original positions.\"\"\"\n    original_chars = list(original)\n    vowel_idx = 0\n    for i in range(len(original_chars)):\n        if _is_vowel(original_chars[i]):\n            original_chars[i] = reversed_vowels[vowel_idx]\n            vowel_idx += 1\n    return \"\".join(original_chars)\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    \"\"\"\n    extracted = _extract_vowels(s)\n    reversed_v = extracted[::-1]\n    return _reconstruct_string(s, reversed_v)"}
{"task_id": "Mbpp/130", "solution": "def _count_frequencies(lst: list) -> dict:\n    \"\"\"Counts the occurrences of each item in the list.\"\"\"\n    frequencies = {}\n    for item in lst:\n        frequencies[item] = frequencies.get(item, 0) + 1\n    return frequencies\n\ndef _find_max_frequency_item(frequencies: dict) -> any:\n    \"\"\"Identifies the item with the highest frequency from a frequency dictionary.\n    Returns None if the dictionary is empty.\n    \"\"\"\n    if not frequencies:\n        return None\n    return max(frequencies, key=frequencies.get)\n\ndef max_occurrences(lst: list) -> any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Orchestrates frequency counting and maximum item identification.\n    \"\"\"\n    frequencies = _count_frequencies(lst)\n    max_item = _find_max_frequency_item(frequencies)\n    return max_item"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square is a square matrix where the sum of numbers in each row,\n    each column, and both main diagonals is the same.\n    \"\"\"\n\n    class MatrixValidator:\n        def __init__(self, matrix_data: list[list[int]]):\n            self.matrix = matrix_data\n            self.size = len(matrix_data)\n\n        def is_square(self) -> bool:\n            # An empty matrix or a non-square matrix cannot be a magic square.\n            if self.size == 0:\n                return False\n            for row in self.matrix:\n                if len(row) != self.size:\n                    return False\n            return True\n\n        def _calculate_target_sum(self) -> int:\n            # The target sum is determined by the sum of the first row.\n            return sum(self.matrix[0])\n\n        def _get_row_sum(self, row_index: int) -> int:\n            return sum(self.matrix[row_index])\n\n        def _get_column_sum(self, col_index: int) -> int:\n            return sum(self.matrix[row][col_index] for row in range(self.size))\n\n        def _get_main_diagonal_sum(self) -> int:\n            return sum(self.matrix[i][i] for i in range(self.size))\n\n        def _get_anti_diagonal_sum(self) -> int:\n            return sum(self.matrix[i][self.size - 1 - i] for i in range(self.size))\n\n        def validate_magic_square(self) -> bool:\n            if not self.is_square():\n                return False\n\n            # A 1x1 matrix is trivially a magic square.\n            if self.size == 1:\n                return True\n\n            target_sum = self._calculate_target_sum()\n\n            # Validate all row sums\n            for i in range(self.size):\n                if self._get_row_sum(i) != target_sum:\n                    return False\n\n            # Validate all column sums\n            for i in range(self.size):\n                if self._get_column_sum(i) != target_sum:\n                    return False\n\n            # Validate main diagonal sum\n            if self._get_main_diagonal_sum() != target_sum:\n                return False\n\n            # Validate anti-diagonal sum\n            if self._get_anti_diagonal_sum() != target_sum:\n                return False\n\n            return True\n\n    validator = MatrixValidator(matrix)\n    return validator.validate_magic_square()"}
