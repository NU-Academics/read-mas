{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Orchestrates power calculation and digit processing.\n    \"\"\"\n    # Calculate base raised to power\n    result_number = base ** power\n\n    # Convert the result to a string\n    result_string = str(result_number)\n\n    # Sum the individual digits\n    digit_sum = sum(int(digit) for digit in result_string)\n\n    return digit_sum"}
{"task_id": "Mbpp/721", "solution": "import collections\n\n# Utility Layer\nclass MathUtils:\n    \"\"\"Provides safe mathematical operations.\"\"\"\n    @staticmethod\n    def safe_divide(numerator, denominator):\n        \"\"\"Divides numerator by denominator, handling division by zero.\"\"\"\n        return float(numerator) / denominator if denominator != 0 else 0.0\n\nclass InputValidator:\n    \"\"\"Validates matrix format and constraints.\"\"\"\n    @staticmethod\n    def validate_input(matrix):\n        \"\"\"Checks if the input is a valid square matrix with integer values.\"\"\"\n        if not isinstance(matrix, list) or not matrix:\n            return False\n        size = len(matrix)\n        for row in matrix:\n            if not isinstance(row, list) or len(row) != size:\n                return False\n            for val in row:\n                if not isinstance(val, int):\n                    return False\n        return True\n\n# Data Model Layer\nclass Cell:\n    \"\"\"Represents a matrix position with its associated cost.\"\"\"\n    def __init__(self, row, column, cost):\n        self._row = row\n        self._column = column\n        self._cost = cost\n\n    def get_row(self):\n        \"\"\"Returns the row index of the cell.\"\"\"\n        return self._row\n\n    def get_column(self):\n        \"\"\"Returns the column index of the cell.\"\"\"\n        return self._column\n\n    def get_cost(self):\n        \"\"\"Returns the cost associated with the cell.\"\"\"\n        return self._cost\n\nclass Path:\n    \"\"\"Manages a sequence of cells forming a path, tracking its total cost and cell count.\"\"\"\n    def __init__(self):\n        self._cells = []\n        self._total_cost = 0\n        self._cell_count = 0\n\n    def add_cell(self, cell):\n        \"\"\"Adds a cell to the path and updates total cost and count.\"\"\"\n        self._cells.append(cell)\n        self._total_cost += cell.get_cost()\n        self._cell_count += 1\n\n    def calculate_average(self):\n        \"\"\"Calculates the average cost per cell for this path.\"\"\"\n        return MathUtils.safe_divide(self._total_cost, self._cell_count)\n\n    def get_total_cost(self):\n        \"\"\"Returns the total cost of the path.\"\"\"\n        return self._total_cost\n\n    def get_cell_count(self):\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return self._cell_count\n\n    def get_cells(self):\n        \"\"\"Returns the list of cells currently in the path.\"\"\"\n        return self._cells\n\nclass Matrix:\n    \"\"\"Encapsulates a square matrix, providing safe cell access.\"\"\"\n    def __init__(self, cells_data):\n        self._cells = cells_data\n        self._size = len(cells_data)\n\n    def get_cell_cost(self, row, col):\n        \"\"\"Returns the cost of the cell at (row, col).\"\"\"\n        return self._cells[row][col]\n\n    def get_size(self):\n        \"\"\"Returns the size (N) of the N*N matrix.\"\"\"\n        return self._size\n\n    def is_valid_position(self, row, col):\n        \"\"\"Checks if (row, col) is a valid position within the matrix.\"\"\"\n        return 0 <= row < self._size and 0 <= col < self._size\n\n# Core Algorithm Layer\nclass AverageCalculator:\n    \"\"\"Calculates individual path averages and finds the maximum among them.\"\"\"\n    @staticmethod\n    def calculate_path_average(path):\n        \"\"\"Calculates the average cost per cell for a given path.\"\"\"\n        return path.calculate_average()\n\n    @staticmethod\n    def find_maximum_average(paths):\n        \"\"\"Finds the maximum average cost among a list of paths.\"\"\"\n        if not paths:\n            return 0.0\n\n        max_avg = -float('inf')\n        for path in paths:\n            current_avg = AverageCalculator.calculate_path_average(path)\n            if current_avg > max_avg:\n                max_avg = current_avg\n        return max_avg\n\nclass PathGenerator:\n    \"\"\"Generates all valid paths from top-left to bottom-right in a matrix.\"\"\"\n    def __init__(self, matrix):\n        self._matrix = matrix\n        self._all_paths = []\n        self._N = matrix.get_size()\n\n    def generate_all_paths(self):\n        \"\"\"Initiates the recursive path generation process from (0,0).\"\"\"\n        self._generate_paths_recursive(0, 0, Path())\n        return self._all_paths\n\n    def _generate_paths_recursive(self, row, col, current_path_prefix):\n        \"\"\"Recursively explores paths by moving right or down.\"\"\"\n        # Create a new Path object for the current branch to avoid modifying shared state.\n        current_path_branch = Path()\n        for cell_in_prefix in current_path_prefix.get_cells():\n            current_path_branch.add_cell(cell_in_prefix)\n\n        # Add the current cell to this branch's path.\n        cell = Cell(row, col, self._matrix.get_cell_cost(row, col))\n        current_path_branch.add_cell(cell)\n\n        # Base case: Reached the bottom-right cell.\n        if row == self._N - 1 and col == self._N - 1:\n            self._all_paths.append(current_path_branch)\n            return\n\n        # Recursive step: Explore moving right.\n        if self._matrix.is_valid_position(row, col + 1):\n            self._generate_paths_recursive(row, col + 1, current_path_branch)\n\n        # Recursive step: Explore moving down.\n        if self._matrix.is_valid_position(row + 1, col):\n            self._generate_paths_recursive(row + 1, col, current_path_branch)\n\nclass PathFinder:\n    \"\"\"Orchestrates path generation and average calculation to find the maximum average path.\"\"\"\n    def __init__(self, matrix):\n        self._matrix = matrix\n        self._path_generator = PathGenerator(matrix)\n        self._average_calculator = AverageCalculator()\n\n    def find_max_average_path(self):\n        \"\"\"Generates all paths and returns the maximum average among them.\"\"\"\n        all_paths = self._path_generator.generate_all_paths()\n        max_avg = self._average_calculator.find_maximum_average(all_paths)\n        return max_avg\n\n# Algorithm Interface Layer\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down, that has the maximum average cost.\n    \"\"\"\n    # Assuming input matrix_data is valid as per problem description.\n    InputValidator.validate_input(matrix_data) # Per design, validator is called.\n\n    matrix = Matrix(matrix_data)\n    path_finder = PathFinder(matrix)\n    result = path_finder.find_max_average_path()\n    return result"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed within double quotation marks from a string.\n    Processes the string character by character to identify and collect quoted segments.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    current_quote = []\n\n    for char in input_string:\n        if char == '\"':\n            if in_quote:\n                extracted_values.append(\"\".join(current_quote))\n                current_quote = []\n                in_quote = False\n            else:\n                in_quote = True\n        elif in_quote:\n            current_quote.append(char)\n\n    return extracted_values"}
