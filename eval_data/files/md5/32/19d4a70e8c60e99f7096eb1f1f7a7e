{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n, where each element is a positive integer\n    and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    # dp[length_idx][last_element_value] stores the count of sequences of a given length\n    # ending with a specific value. Using 1-based indexing for convenience.\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # prefix_sums[length_idx][value] stores the sum of dp[length_idx][k] for k from 1 to value.\n    # This is used to efficiently calculate the sum of previous states.\n    prefix_sums = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: For sequences of length 1, any positive integer from 1 to m is valid.\n    for val_idx in range(1, m + 1):\n        dp[1][val_idx] = 1\n        prefix_sums[1][val_idx] = prefix_sums[1][val_idx - 1] + dp[1][val_idx]\n\n    # Fill the DP table for lengths from 2 up to n.\n    for len_idx in range(2, n + 1):\n        for val_idx in range(1, m + 1):\n            # The current element (val_idx) must be at least twice the previous element.\n            # Thus, the previous element (prev_val_idx) can be at most val_idx // 2.\n            max_prev_val = val_idx // 2\n            \n            # If a valid previous element exists (i.e., max_prev_val is at least 1),\n            # sum up all sequences of length (len_idx - 1) that could precede val_idx.\n            if max_prev_val >= 1:\n                dp[len_idx][val_idx] = prefix_sums[len_idx - 1][max_prev_val]\n        \n        # Update prefix sums for the current length_idx.\n        for val_idx in range(1, m + 1):\n            prefix_sums[len_idx][val_idx] = prefix_sums[len_idx][val_idx - 1] + dp[len_idx][val_idx]\n\n    # The total number of valid sequences of length n is the sum of all counts\n    # for sequences of length n ending with any value from 1 to m.\n    # This sum is stored in prefix_sums[n][m].\n    return prefix_sums[n][m]"}
{"task_id": "Mbpp/244", "solution": "import math\nfrom typing import Union\n\ndef next_Perfect_Square(number: Union[int, float]) -> int:\n    \"\"\"Find the next perfect square greater than the given number.\n    Calculates the square root, determines the next integer root, and returns its square.\n    \"\"\"\n    current_root = math.sqrt(number)\n    \n    # The next perfect square will be (floor(current_root) + 1)^2.\n    # This correctly handles both cases:\n    # 1. If 'number' is not a perfect square (e.g., 35), floor(sqrt(35)) = 5. Next root is 6. 6*6 = 36.\n    # 2. If 'number' is a perfect square (e.g., 36), floor(sqrt(36)) = 6. Next root is 7. 7*7 = 49.\n    next_integer_root = int(current_root) + 1\n    \n    return next_integer_root * next_integer_root"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculate the length of the longest palindromic subsequence.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence\n    # for the substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All substrings of length 1 have LPS length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if s[i] == s[j]:\n                if length == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    n = len(arr)\n\n    if n == 0:\n        return 0\n\n    # lis_sum[i] stores the maximum sum of an increasing subsequence ending with arr[i].\n    lis_sum = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n\n    # lds_sum[i] stores the maximum sum of a decreasing subsequence starting with arr[i].\n    lds_sum = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n\n    # The maximum sum of a bitonic subsequence is the maximum of (lis_sum[i] + lds_sum[i] - arr[i]) for all i.\n    # arr[i] is subtracted once because it is included in both increasing and decreasing sums.\n    max_bitonic_sum = arr[0]\n    for i in range(n):\n        current_sum = lis_sum[i] + lds_sum[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_sum)\n\n    return max_bitonic_sum"}
