{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a prime number.\n    Handles special cases for 1, 2, and even numbers, then checks for odd divisors up to its square root.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for odd divisors from 3 up to the square root of n\n    for i in range(3, int(math.isqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculate the nth Bell number using dynamic programming.\n\n    The Bell numbers count the number of partitions of a set with n elements.\n    \"\"\"\n    # Create a 2D list (Bell triangle) to store intermediate values.\n    # bell[i][j] represents the j-th element of the i-th row in the Bell triangle.\n    bell = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: B_0 = 1\n    bell[0][0] = 1\n\n    # Fill the Bell triangle using the recurrence relation.\n    for i in range(1, n + 1):\n        # The first element of row 'i' is the last element of row 'i-1'.\n        # This corresponds to B_i = bell[i-1][i-1] from the previous row.\n        bell[i][0] = bell[i-1][i-1]\n        \n        # Fill the remaining elements of the current row.\n        # bell[i][j] = bell[i-1][j-1] + bell[i][j-1]\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i-1][j-1] + bell[i][j-1]\n\n    # The nth Bell number is found at bell[n][0].\n    return bell[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(target_string: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"\n    Searches a string for the first occurrence of a regex pattern.\n    Returns the matching substring, its start index, and its end index, or None if no match is found.\n    \"\"\"\n    match = re.search(pattern, target_string)\n    if match:\n        return match.group(0), match.start(), match.end()\n    return None"}
