{"task_id": "Mbpp/626", "solution": "def triangle_area(radius: float) -> float or None:\n    \"\"\"Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns None for a negative radius, otherwise returns the area as radius squared.\n    \"\"\"\n    if radius < 0:\n        return None\n    \n    # For the largest triangle in a semicircle, the base is 2*radius (diameter)\n    # and the height is radius. Area = 0.5 * base * height = 0.5 * (2*radius) * radius = radius^2.\n    return radius * radius"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers: list) -> list:\n    \"\"\"\n    Filters a list of numbers, returning only the even numbers while preserving their original order.\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord_tuple):\n    \"\"\"\n    Extract all adjacent coordinates including diagonals for the given coordinate tuple.\n\n    Args:\n        coord_tuple (tuple): A tuple containing (x, y) coordinates as integers\n\n    Returns:\n        list: List of lists, each containing [x, y] coordinate pair in a specific order.\n    \"\"\"\n    x, y = coord_tuple\n    coordinates = []\n\n    # Iterate through x-offsets, then y-offsets to match the required output order.\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            coordinates.append([x + dx, y + dy])\n\n    return coordinates"}
{"task_id": "Mbpp/631", "solution": "def validate_input(input_string: str) -> bool:\n    \"\"\"Validates the input string. Always returns True as per design constraints.\"\"\"\n    return True\n\ndef perform_replacement(input_string: str) -> str:\n    \"\"\"Performs the character replacement logic: spaces to underscores and vice versa.\"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == ' ':\n            result_chars.append('_')\n        elif char == '_':\n            result_chars.append(' ')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"Replaces whitespaces with underscores and vice versa in the given string.\"\"\"\n    if validate_input(input_string):\n        return perform_replacement(input_string)"}
{"task_id": "Mbpp/632", "solution": "from typing import List\n\ndef move_zero(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Moves all zeroes to the end of the given list, preserving the relative order of non-zero elements.\n    Returns a new list with the modified order.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for element in input_list:\n        if element != 0:\n            non_zero_elements.append(element)\n        else:\n            zero_count += 1\n\n    return non_zero_elements + [0] * zero_count"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, count):\n    \"\"\"Calculate the sum of XOR operations for all unique pairs in the input list.\"\"\"\n    total_xor_sum = 0\n    # Iterate through all unique pairs of numbers\n    for i in range(count):\n        for j in range(i + 1, count):\n            # Calculate the XOR of the current pair and add to the total sum\n            total_xor_sum += numbers[i] ^ numbers[j]\n    return total_xor_sum"}
