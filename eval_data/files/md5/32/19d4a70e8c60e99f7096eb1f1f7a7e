{"task_id": "Mbpp/97", "solution": "import itertools\nfrom collections import Counter\n\ndef frequency_lists(list_of_lists: list) -> dict:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    \"\"\"\n    flattened_list = itertools.chain.from_iterable(list_of_lists)\n    frequency_counts = Counter(flattened_list)\n    return dict(frequency_counts)"}
{"task_id": "Mbpp/98", "solution": "import math\n\ndef multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a collection and divides the product by the collection's length.\n    Handles empty collections by returning 0 to avoid division by zero or an undefined product.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase by splitting words, capitalizing each, and joining them.\"\"\"\n    words = input_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/99", "solution": "def _validate_input(decimal: int) -> bool:\n    \"\"\"Validate the decimal input. Returns True if valid.\"\"\"\n    # Constraints forbid isinstance() checks or raising exceptions for edge cases.\n    return True\n\ndef _convert_to_binary(decimal: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if decimal == 0:\n        return '0'\n    \n    binary_digits = []\n    temp_decimal = decimal\n    while temp_decimal > 0:\n        remainder = temp_decimal % 2\n        binary_digits.append(str(remainder))\n        temp_decimal //= 2\n    \n    return \"\".join(reversed(binary_digits))\n\ndef _remove_leading_zeros(binary: str) -> str:\n    \"\"\"Ensures the binary string has no leading zeros, unless it's just '0'.\"\"\"\n    # The _convert_to_binary function naturally produces strings without leading zeros\n    # for positive numbers (e.g., '1000' for 8) and '0' for 0, making this a pass-through.\n    return binary\n\ndef decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent, represented as a string with no leading zeros.\n    \"\"\"\n    _validate_input(decimal)\n    binary_result = _convert_to_binary(decimal)\n    final_binary_string = _remove_leading_zeros(binary_result)\n    return final_binary_string"}
{"task_id": "Mbpp/101", "solution": "from typing import List\n\nclass IndexValidator:\n    \"\"\"Handles index validation and conversion for 1-based indexing.\"\"\"\n    def validate_range(self, k: int, array_length: int) -> bool:\n        \"\"\"Validates if k is within the valid 1-based range [1, array_length].\"\"\"\n        return 1 <= k <= array_length\n\n    def convert_to_zero_based(self, k: int) -> int:\n        \"\"\"Converts a 1-based index k to its corresponding 0-based index.\"\"\"\n        return k - 1\n\nclass ArrayAccessor:\n    \"\"\"Provides functionality to safely access elements in an array.\"\"\"\n    def get_element(self, array: List[int], index: int) -> int:\n        \"\"\"Retrieves the element at the given 0-based index from the array.\"\"\"\n        return array[index]\n\ndef kth_element(array: List[int], k: int) -> int:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises IndexError if k is out of the valid range.\n    \"\"\"\n    validator = IndexValidator()\n    accessor = ArrayAccessor()\n\n    if not validator.validate_range(k, len(array)):\n        raise IndexError(\"k is out of range for the given array.\")\n\n    zero_based_index = validator.convert_to_zero_based(k)\n    return accessor.get_element(array, zero_based_index)"}
{"task_id": "Mbpp/100", "solution": "def reverse_digits(n: int) -> int:\n    \"\"\"Reverse the digits of number n.\"\"\"\n    return int(str(n)[::-1])\n\ndef is_palindrome(n: int) -> bool:\n    \"\"\"Check if number n is a palindrome.\"\"\"\n    return n == reverse_digits(n)\n\ndef increment_to_next_palindrome(n: int) -> int:\n    \"\"\"Find next palindrome starting from n.\"\"\"\n    current_num = n\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Find the next smallest palindrome greater than n.\"\"\"\n    return increment_to_next_palindrome(n + 1)"}
{"task_id": "Mbpp/103", "solution": "def _compute_eulerian_recursive(n, m):\n    \"\"\"\n    Recursively calculates the Eulerian number A(n, m).\n    Handles base cases for n=0, m=0 and boundary conditions for m outside [0, n-1].\n    \"\"\"\n    # Base case: A(0,0) = 1\n    if n == 0 and m == 0:\n        return 1\n    \n    # Base cases: A(n,m) = 0 for m < 0 or m >= n\n    if m < 0 or m >= n:\n        return 0\n    \n    # Recursive step: A(n, m) = (m+1) * A(n-1, m) + (n-m) * A(n-1, m-1)\n    return (m + 1) * _compute_eulerian_recursive(n - 1, m) + \\\n           (n - m) * _compute_eulerian_recursive(n - 1, m - 1)\n\ndef eulerian_num(n, m):\n    \"\"\"\n    Finds the Eulerian number A(n, m).\n    This function uses a recursive approach to compute the value.\n    \"\"\"\n    return _compute_eulerian_recursive(n, m)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_list):\n    \"\"\"Sorts each sublist of strings alphabetically in a list of lists.\"\"\"\n    sorted_outer_list = []\n    for sublist in input_list:\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
