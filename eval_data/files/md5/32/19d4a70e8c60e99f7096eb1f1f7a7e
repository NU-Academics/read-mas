{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of integers using the comb sort algorithm.\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    arr = list(input_list) # Create a mutable copy to avoid modifying the original list\n    n = len(arr)\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n        \n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1: list, array2: list) -> bool:\n    \"\"\"\n    Check whether two arrays follow the same pattern.\n    Compares the structural sequence of elements in both arrays.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    def _get_pattern_representation(arr: list) -> list:\n        # Maps each unique element to an integer representing its first appearance order.\n        mapping = {}\n        pattern_list = []\n        next_unique_val = 0\n        for item in arr:\n            if item not in mapping:\n                mapping[item] = next_unique_val\n                next_unique_val += 1\n            pattern_list.append(mapping[item])\n        return pattern_list\n\n    pattern1_representation = _get_pattern_representation(array1)\n    pattern2_representation = _get_pattern_representation(array2)\n\n    return pattern1_representation == pattern2_representation"}
