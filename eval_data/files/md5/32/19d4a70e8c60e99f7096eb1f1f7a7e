{"task_id": "Mbpp/611", "solution": "from typing import List, Union\n\ndef max_of_nth(matrix: List[List[Union[int, float]]], column_index: int) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum value within a specified column of a given matrix.\n    Assumes valid matrix and column_index inputs as per type hints and problem constraints.\n    \"\"\"\n\n    def extract_column(m: List[List[Union[int, float]]], col_idx: int) -> List[Union[int, float]]:\n        \"\"\"Extracts all values from the specified column across matrix rows.\"\"\"\n        column_values = []\n        for row in m:\n            column_values.append(row[col_idx])\n        return column_values\n\n    def find_maximum(values: List[Union[int, float]]) -> Union[int, float]:\n        \"\"\"Finds the maximum value from a list of numeric values.\"\"\"\n        return max(values)\n\n    # Orchestrate the process: extract column values and then find their maximum.\n    col_values = extract_column(matrix, column_index)\n    maximum_value = find_maximum(col_values)\n    return maximum_value"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list):\n    \"\"\"\n    Transposes a list of two-element sublists into a list of two lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "import collections\nimport functools\nimport itertools\nimport math\nimport operator\nimport re\nimport sys\nimport types\nfrom typing import Any, Iterable, List, Tuple, Union\n\ndef cummulative_sum(tuple_list: List[Tuple]) -> Union[int, float]:\n    \"\"\"\n    Calculate the cumulative sum of all numeric values within a list of tuples.\n    This function iterates through the list and each tuple to sum up all numbers.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for item in tpl:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"\n    Calculate the average value for each tuple in a tuple of tuples.\n\n    Args:\n        tuple_of_tuples: A tuple containing inner tuples with numeric values\n\n    Returns:\n        A list of floating-point numbers representing the average of each inner tuple\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        # Calculate the arithmetic mean for each inner tuple using sum divided by count.\n        average = sum(inner_tuple) / len(inner_tuple)\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def _handle_division_by_zero(dividend: int, divisor: int) -> int:\n    \"\"\"Handles division by zero cases during a modulo operation.\n    Raises ZeroDivisionError if the divisor is zero.\"\"\"\n    if divisor == 0:\n        raise ZeroDivisionError(\"Modulo by zero is undefined.\")\n    return dividend % divisor\n\ndef _validate_input_length(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validates that both input tuples have the same length.\n    Raises ValueError if the lengths differ.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\ndef _perform_element_wise_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs the actual element-wise modulo operations.\n    It iterates through tuples and uses the division by zero handler.\"\"\"\n    results = []\n    for val1, val2 in zip(tuple1, tuple2):\n        results.append(_handle_division_by_zero(val1, val2))\n    return tuple(results)\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Raises ValueError if tuples have different lengths or ZeroDivisionError if a divisor is zero.\n    \"\"\"\n    _validate_input_length(tuple1, tuple2)\n    return _perform_element_wise_modulo(tuple1, tuple2)"}
{"task_id": "Mbpp/618", "solution": "import typing\n\ndef div_list(list1: typing.List[typing.Union[int, float]], list2: typing.List[typing.Union[int, float]]) -> typing.List[float]:\n    \"\"\"Perform element-wise division of two lists.\n    Returns a new list containing the quotient of corresponding elements as floats.\"\"\"\n    result_list = []\n    for val1, val2 in zip(list1, list2):\n        result_list.append(val1 / val2)\n    return result_list"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the given string, preserving relative order.\"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "from typing import List\nimport itertools\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers where every pair is divisible.\n    A pair (a, b) is divisible if a divides b or b divides a.\n    \"\"\"\n\n    def is_divisible(a: int, b: int) -> bool:\n        \"\"\"Checks if one number is divisible by another.\"\"\"\n        if a == 0 and b == 0: return True # Or False, depending on desired behavior for 0, but problem implies positive integers\n        if a == 0: return b == 0 # If a is 0, only divisible by 0 itself\n        if b == 0: return a == 0 # If b is 0, only divisible by 0 itself\n        return a % b == 0 or b % a == 0\n\n    def validate_subset(subset: List[int]) -> bool:\n        \"\"\"Validates if all pairs in a subset satisfy the divisibility condition.\"\"\"\n        n = len(subset)\n        if n <= 1:\n            return True\n        \n        for i in range(n):\n            for j in range(i + 1, n):\n                if not is_divisible(subset[i], subset[j]):\n                    return False\n        return True\n\n    def generate_subsets(numbers: List[int]) -> List[List[int]]:\n        \"\"\"Generates all possible subsets of the input list.\"\"\"\n        all_subsets = []\n        for i in range(len(numbers) + 1):\n            for combo in itertools.combinations(numbers, i):\n                all_subsets.append(list(combo))\n        return all_subsets\n\n    max_size = 0\n    all_subsets = generate_subsets(numbers)\n\n    for subset in all_subsets:\n        if validate_subset(subset):\n            max_size = max(max_size, len(subset))\n            \n    return max_size"}
{"task_id": "Mbpp/622", "solution": "from typing import List\n\ndef get_median(list1: List[int], list2: List[int], size: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a binary search approach.\n    This algorithm achieves O(log n) time complexity.\n    \"\"\"\n    n = size\n\n    # Binary search for the partition point 'i' in list1.\n    # 'i' represents the count of elements taken from list1 for the left half of the merged array.\n    low = 0\n    high = n\n\n    while low <= high:\n        i = (low + high) // 2\n        j = n - i # 'j' is the count of elements taken from list2 for the left half.\n\n        # Determine the four critical elements around the partition for both lists.\n        # Use -infinity and +infinity for boundary conditions (when i or j is 0 or n).\n        L1 = list1[i - 1] if i > 0 else -float('inf')\n        R1 = list1[i] if i < n else float('inf')\n\n        L2 = list2[j - 1] if j > 0 else -float('inf')\n        R2 = list2[j] if j < n else float('inf')\n\n        # Check if the partition is valid: L1 <= R2 and L2 <= R1.\n        # This ensures all elements in the left partition are less than or equal to all elements in the right partition.\n        if L1 <= R2 and L2 <= R1:\n            # If valid, the median is the average of the largest element in the left half\n            # and the smallest element in the right half of the combined sorted arrays.\n            return (max(L1, L2) + min(R1, R2)) / 2.0\n        elif L1 > R2:\n            # If L1 is too large, it means we took too many elements from list1.\n            # Adjust 'high' to search in the left half of the current search space.\n            high = i - 1\n        else: # L2 > R1\n            # If L2 is too large, it means we took too few elements from list1 (and too many from list2).\n            # Adjust 'low' to search in the right half of the current search space.\n            low = i + 1"}
