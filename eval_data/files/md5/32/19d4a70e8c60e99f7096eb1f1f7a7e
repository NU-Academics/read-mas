{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef count_reverse_pairs(string_list: List[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list, ignoring palindromes.\n    Each unique pair is counted exactly once.\n    \"\"\"\n    pair_count = 0\n    # Use a set for O(1) average-case lookup of existing strings\n    string_set = set(string_list)\n    # Use another set to mark strings that have already been processed\n    processed_strings = set()\n\n    for s in string_list:\n        # If the string has already been processed, skip it\n        if s in processed_strings:\n            continue\n\n        reversed_s = s[::-1]\n\n        # If the string is a palindrome, it should not be counted as a pair.\n        # Mark it as processed to prevent further evaluation of this string.\n        if s == reversed_s:\n            processed_strings.add(s)\n            continue\n\n        # Check if the reversed string exists in the original list (via string_set)\n        # and has not been processed yet.\n        if reversed_s in string_set and reversed_s not in processed_strings:\n            pair_count += 1\n            # Mark both the original string and its reverse as processed\n            # to avoid double-counting and re-processing.\n            processed_strings.add(s)\n            processed_strings.add(reversed_s)\n        else:\n            # If 's' does not form a valid reverse pair with an unprocessed string,\n            # mark 's' as processed to handle potential duplicates in the input list.\n            processed_strings.add(s)\n            \n    return pair_count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in the array.\n    It sorts the array first and then iterates through adjacent elements to find the minimum difference.\n    \"\"\"\n    sorted_array = sorted(array)\n    min_diff = float('inf')\n\n    for i in range(length - 1):\n        diff = sorted_array[i+1] - sorted_array[i]\n        if diff < min_diff:\n            min_diff = diff\n\n    return int(min_diff)"}
