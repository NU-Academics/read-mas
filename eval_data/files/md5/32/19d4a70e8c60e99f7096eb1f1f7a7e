{"task_id": "Mbpp/589", "solution": "from typing import List\nimport math\n\ndef _validate_input(start: int, end: int) -> bool:\n    \"\"\"Validate input parameters.\"\"\"\n    return start <= end\n\ndef _is_perfect_square(n: int) -> bool:\n    \"\"\"Check if a number is a perfect square.\"\"\"\n    if n < 0:\n        return False\n    root = int(math.sqrt(n))\n    return root * root == n\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"Find all perfect squares in the given range (inclusive).\"\"\"\n    if not _validate_input(start, end):\n        return []\n\n    # Perfect squares are non-negative, so adjust the lower bound of iteration.\n    effective_start = max(0, start)\n    \n    results = []\n    for num in range(effective_start, end + 1):\n        if _is_perfect_square(num):\n            results.append(num)\n            \n    return results"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"\n    Interchange the first and last elements in a list.\n    Returns a new list with the swapped elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return list(input_list) # Return a copy for empty or single-element lists\n\n    new_list = list(input_list) # Create a shallow copy to modify\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
{"task_id": "Mbpp/592", "solution": "def factorial(m: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer m.\"\"\"\n    if m == 0:\n        return 1\n    res = 1\n    for i in range(1, m + 1):\n        res *= i\n    return res\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0 # This case should not be reached with the loop range in sum_Of_product.\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k # Optimization: C(n, k) = C(n, n-k)\n    \n    numerator = factorial(n)\n    denominator = factorial(k) * factorial(n - k)\n    return numerator // denominator\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients.\n    The sum is from k=0 to n-1 of C(n, k) * C(n, k+1).\n    \"\"\"\n    total_sum = 0\n    for k in range(n): # Loop from k=0 to n-1\n        coeff_k = binomial_coefficient(n, k)\n        coeff_k_plus_1 = binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
