{"task_id": "Mbpp/751", "solution": "def _get_left_child_index(index: int) -> int:\n    \"\"\"Calculate left child index for given node index.\"\"\"\n    return 2 * index + 1\n\ndef _get_right_child_index(index: int) -> int:\n    \"\"\"Calculate right child index for given node index.\"\"\"\n    return 2 * index + 2\n\ndef check_min_heap(array: list) -> bool:\n    \"\"\"\n    Check if the given array represents a valid min heap.\n\n    Args:\n        array: List of integers representing heap elements\n\n    Returns:\n        bool: True if array represents valid min heap, False otherwise\n    \"\"\"\n    n = len(array)\n\n    # An empty array or a single-element array is always a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through the non-leaf nodes.\n    # The last parent node's index is (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = _get_left_child_index(i)\n        right_child_idx = _get_right_child_index(i)\n\n        # Check if left child exists and violates the min-heap property.\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check if right child exists and violates the min-heap property.\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculate the nth Jacobsthal number.\n\n    Args:\n        n (int): Non-negative integer position in the sequence\n\n    Returns:\n        int: The nth Jacobsthal number\n\n    Raises:\n        ValueError: If n is negative\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 1\n\n    # For n > 2, use the iterative approach with J(i) = J(i-1) + 2*J(i-2)\n    # Initialize with J(1) and J(2)\n    j_n_minus_2 = 1  # Represents J(i-2), initially J(1)\n    j_n_minus_1 = 1  # Represents J(i-1), initially J(2)\n\n    current_jacobsthal = 0\n    for _ in range(3, n + 1):\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n\n    return current_jacobsthal"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by their second element.\n    Returns the k smallest tuples in ascending order.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"\n    Counts occurrences of sublists within a list, converting each sublist to a tuple.\n    Returns a dictionary mapping these tuples to their counts.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists at the same index.\n    Returns a list of these common elements.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest unique number in a list.\n    Handles lists with negative numbers, zero, and duplicates.\n    \"\"\"\n    # Remove duplicate elements by converting to a set and then back to a list.\n    unique_numbers = list(set(numbers))\n\n    # Sort the unique numbers in ascending order.\n    unique_numbers.sort()\n\n    # If there are fewer than two unique numbers, a second smallest does not exist.\n    # Return None as per design context's implicit handling when exceptions are forbidden.\n    if len(unique_numbers) < 2:\n        return None\n\n    # The second smallest unique number is at index 1 after sorting.\n    return unique_numbers[1]"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input_string: str) -> bool:\n    # Check if the string matches a decimal number format (e.g., \"123\", \"123.45\", \"-123.45\")\n    # and then verify it has exactly two decimal places.\n    \n    # Regex for a decimal number with an optional sign, at least one digit, an optional decimal point,\n    # and any number of digits after the decimal.\n    # We use this lenient pattern first to check if it's generally a number.\n    pattern = re.compile(r\"^[+-]?\\d+(\\.\\d+)?$\")\n    if not pattern.match(input_string):\n        return False\n\n    # Check for exactly two decimal places.\n    # Split the string by the decimal point.\n    parts = input_string.split('.')\n\n    # If there's no decimal point, it doesn't have 2 decimal places.\n    if len(parts) < 2:\n        return False\n    \n    # If there is a decimal part, check its length.\n    decimal_part = parts[1]\n    return len(decimal_part) == 2"}
