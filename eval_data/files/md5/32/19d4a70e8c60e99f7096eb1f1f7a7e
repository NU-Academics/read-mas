{"task_id": "Mbpp/427", "solution": "def change_date_format(date_string: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    Raises ValueError for invalid input date formats.\n    \"\"\"\n    if len(date_string) != 10 or date_string[4] != '-' or date_string[7] != '-':\n        raise ValueError(\"Invalid date format. Expected 'yyyy-mm-dd'.\")\n\n    year_str = date_string[0:4]\n    month_str = date_string[5:7]\n    day_str = date_string[8:10]\n\n    if not (year_str.isdigit() and month_str.isdigit() and day_str.isdigit()):\n        raise ValueError(\"Invalid date format. Year, month, and day must be digits.\")\n\n    return f\"{day_str}-{month_str}-{year_str}\""}
{"task_id": "Mbpp/428", "solution": "def shell_sort(array: list) -> list:\n    \"\"\"\n    Sorts the given array using the Shell Sort algorithm.\n    It sorts elements in ascending order.\n    \"\"\"\n    n = len(array)\n    result = array[:]  # Create a copy to avoid modifying the original array\n\n    # Start with a large gap, then reduce the gap\n    gap = n // 2\n    while gap > 0:\n        # Do a gapped insertion sort for this gap size.\n        # The first gap elements result[0..gap-1] are already in gapped order\n        # keep adding one more element until the entire array is gap sorted\n        for i in range(gap, n):\n            # add result[i] to the elements that have been gap sorted\n            # save result[i] in temp and make a hole at position i\n            temp = result[i]\n\n            # shift earlier gap-sorted elements up until the correct location for result[i] is found\n            j = i\n            while j >= gap and result[j - gap] > temp:\n                result[j] = result[j - gap]\n                j -= gap\n\n            # put temp (the original result[i]) in its correct location\n            result[j] = temp\n        gap //= 2\n    return result"}
