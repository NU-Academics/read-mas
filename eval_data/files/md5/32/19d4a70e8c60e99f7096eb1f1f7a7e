{"task_id": "Mbpp/256", "solution": "import math\n\ndef _validate_input(number: int) -> bool:\n    \"\"\"\n    Validates that the input number is a non-negative integer.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    return number >= 0\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given number is prime.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef count_Primes_nums(number: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number.\n    Returns the count of prime numbers, or 0 if input is invalid.\n    \"\"\"\n    if not _validate_input(number):\n        return 0\n\n    prime_count = 0\n    for i in range(2, number):\n        if _is_prime(i):\n            prime_count += 1\n    return prime_count"}
