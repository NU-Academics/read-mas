{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of fourth powers of the first n odd natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        # Calculate the i-th odd number\n        odd_number = 2 * i - 1\n        # Calculate its fourth power and add to the total sum\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a: list[int], list_b: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list_a\n    that are not in list_b, while preserving order.\n    \"\"\"\n    \n    # Convert list_b to a set for efficient O(1) average time complexity lookups\n    exclusion_set = set(list_b)\n    \n    result = []\n    # Iterate through list_a and add elements not found in the exclusion_set to the result\n    for item in list_a:\n        if item not in exclusion_set:\n            result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals a specified target value.\n    Handles duplicate elements and ensures pairs (i,j) and (j,i) are counted once.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    polite_count = 0\n    current_num = 0\n    while polite_count < n:\n        current_num += 1\n        # A positive integer is a power of two if x > 0 and (x & (x - 1)) == 0.\n        is_power_of_two = (current_num > 0 and (current_num & (current_num - 1)) == 0)\n        \n        if not is_power_of_two:\n            polite_count += 1\n    return current_num"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a main string.\n    Returns a tuple (substring, start_position, end_position) or None if not found.\n    \"\"\"\n    start_position = main_string.find(substring)\n    if start_position == -1:\n        return None\n    \n    end_position = start_position + len(substring)\n    return (substring, start_position, end_position)"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with exactly k length from the given string.\n    The function splits the text into words, filters them by length, and then joins them back.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
