{"task_id": "Mbpp/120", "solution": "import math\n\ndef max_product_tuple(tuple_list):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Calculates cross-tuple products and returns the largest absolute value.\n    \"\"\"\n    if not tuple_list:\n        return 0\n\n    max_abs_product = 0.0\n\n    # Iterate through all possible pairs of tuples\n    for i in range(len(tuple_list)):\n        for j in range(i + 1, len(tuple_list)):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n\n            # Iterate through all combinations of numbers between the two tuples\n            # tuple1: (a, b), tuple2: (c, d)\n            # Products to check: a*c, a*d, b*c, b*d\n            for n1 in tuple1:\n                for n2 in tuple2:\n                    current_product = n1 * n2\n                    max_abs_product = max(max_abs_product, math.fabs(current_product))\n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "import math\n\nclass NumberRange:\n    \"\"\"Manages range boundaries and validation.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def contains(self, number: int) -> bool:\n        \"\"\"Checks if a number is within the range.\"\"\"\n        return self.start <= number <= self.end\n\nclass AmicableNumber:\n    \"\"\"Represents an amicable number entity with its partner.\"\"\"\n    def __init__(self, value: int, partner: int):\n        self.value = value\n        self.partner = partner\n\n    def validate(self) -> bool:\n        \"\"\"Validates the basic properties of the amicable relationship.\"\"\"\n        return self.value > 0 and self.partner > 0 and self.value != self.partner\n\nclass AmicableNumberCalculator:\n    \"\"\"Performs mathematical calculations for amicable number identification and summation.\"\"\"\n    def __init__(self):\n        self._div_sums_cache = {}\n\n    def sum_of_divisors(self, number: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n        if number <= 1:\n            return 0\n        if number in self._div_sums_cache:\n            return self._div_sums_cache[number]\n\n        total_sum = 1\n        limit = int(math.sqrt(number))\n        for i in range(2, limit + 1):\n            if number % i == 0:\n                total_sum += i\n                if i * i != number:\n                    total_sum += (number // i)\n        \n        self._div_sums_cache[number] = total_sum\n        return total_sum\n\n    def is_amicable_pair(self, num1: int, num2: int) -> bool:\n        \"\"\"Checks if two numbers form an amicable pair.\"\"\"\n        if num1 == num2 or num1 <= 1 or num2 <= 1:\n            return False\n        \n        sum_div1 = self.sum_of_divisors(num1)\n        sum_div2 = self.sum_of_divisors(num2)\n        \n        return sum_div1 == num2 and sum_div2 == num1\n\n    def find_amicable_numbers(self, upper_limit: int) -> list[int]:\n        \"\"\"Identifies all amicable numbers within the specified upper limit.\"\"\"\n        amicable_set = set()\n        range_checker = NumberRange(1, upper_limit)\n\n        for n in range(1, upper_limit + 1):\n            if n in amicable_set:\n                continue\n\n            sum_n_divisors = self.sum_of_divisors(n)\n\n            if sum_n_divisors > n and range_checker.contains(sum_n_divisors):\n                sum_partner_divisors = self.sum_of_divisors(sum_n_divisors)\n\n                if sum_partner_divisors == n:\n                    amicable1 = AmicableNumber(n, sum_n_divisors)\n                    amicable2 = AmicableNumber(sum_n_divisors, n)\n                    \n                    if amicable1.validate() and amicable2.validate():\n                        amicable_set.add(n)\n                        amicable_set.add(sum_n_divisors)\n        \n        return list(amicable_set)\n\n    def calculate_sum(self, upper_limit: int) -> int:\n        \"\"\"Calculates the sum of all amicable numbers up to the upper_limit.\"\"\"\n        amicable_numbers = self.find_amicable_numbers(upper_limit)\n        return sum(amicable_numbers)\n\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified number.\"\"\"\n    calculator = AmicableNumberCalculator()\n    return calculator.calculate_sum(upper_limit)"}
{"task_id": "Mbpp/126", "solution": "import builtins\n\n# Helper function to find all divisors of a number.\ndef find_divisors(n: int) -> list[int]:\n    \"\"\"\n    Finds all positive divisors of a given integer n.\n    Includes 1 and n itself in the list of divisors.\n    \"\"\"\n    divs = []\n    for i in range(1, n + 1):\n        if n % i == 0:\n            divs.append(i)\n    return divs\n\n# Helper function to find common elements between two lists of divisors.\ndef find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n    \"\"\"\n    Identifies and returns divisors that are present in both input lists.\n    Converts lists to sets for efficient intersection finding.\n    \"\"\"\n    set1 = set(divisors1)\n    set2 = set(divisors2)\n    return list(set1.intersection(set2))\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors of two given numbers.\n    It orchestrates finding individual divisors, then common ones, and finally their sum.\n    \"\"\"\n    divs_a = find_divisors(a)\n    divs_b = find_divisors(b)\n    common_divs = find_common_divisors(divs_a, divs_b)\n    return builtins.sum(common_divs)"}
