{"task_id": "Mbpp/160", "solution": "def _extended_gcd(a, b):\n    # Computes gcd(a, b) and Bezout coefficients x, y such that ax + by = gcd(a, b).\n    if a == 0:\n        return b, 0, 1\n    gcd, x1, y1 = _extended_gcd(b % a, a)\n    x = y1 - (b // a) * x1\n    y = x1\n    return gcd, x, y\n\ndef find_solution(a, b, n):\n    # Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    # Uses the Extended Euclidean Algorithm to find a particular solution and then adjusts it.\n\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    \n    if a == 0:\n        return (0, n // b) if n % b == 0 else None\n            \n    if b == 0:\n        return (n // a, 0) if n % a == 0 else None\n\n    gcd_val, x_g, y_g = _extended_gcd(a, b)\n\n    if n % gcd_val != 0:\n        return None\n\n    scale_factor = n // gcd_val\n    x_p = x_g * scale_factor\n    y_p = y_g * scale_factor\n\n    # Adjust (x_p, y_p) to find a \"standard\" solution, e.g., smallest non-negative x.\n    # General solutions are x = x_p + k * (b / gcd_val) and y = y_p - k * (a / gcd_val).\n    step_x = b // gcd_val\n    step_y = a // gcd_val\n\n    # Find k such that x_p + k * step_x is the desired x.\n    # Python's % operator handles negative numbers correctly for the smallest non-negative remainder.\n    x_final = x_p % step_x\n    k = (x_final - x_p) // step_x\n    \n    y_final = y_p - k * step_y\n    \n    return (x_final, y_final)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2,\n    including only terms greater than zero.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string):\n    \"\"\"\n    Counts characters in a string that match their alphabet position (case-insensitive).\n    String position 0 corresponds to 'a', 1 to 'b', and so on.\n    \"\"\"\n\n    def normalize_char(char: str) -> str:\n        \"\"\"Converts a character to its lowercase form.\"\"\"\n        return char.lower()\n\n    def is_alphabetic_char(char: str) -> bool:\n        \"\"\"Checks if a character is an English alphabet letter (a-z).\"\"\"\n        return 'a' <= char <= 'z'\n\n    def get_alphabet_letter(position: int) -> str:\n        \"\"\"Returns the alphabet letter at the given position (0-indexed).\"\"\"\n        return chr(ord('a') + position)\n\n    def is_valid_alphabet_position(position: int) -> bool:\n        \"\"\"Checks if a numerical position corresponds to a valid English alphabet index (0-25).\"\"\"\n        return 0 <= position < 26\n\n    count = 0\n    for position, char in enumerate(input_string):\n        normalized_char = normalize_char(char)\n        \n        if is_alphabetic_char(normalized_char) and is_valid_alphabet_position(position):\n            expected_letter = get_alphabet_letter(position)\n            if normalized_char == expected_letter:\n                count += 1\n                \n    return count"}
