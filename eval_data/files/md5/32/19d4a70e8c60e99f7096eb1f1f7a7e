{"task_id": "Mbpp/555", "solution": "def _sum_of_natural_numbers(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return n * (n + 1) // 2\n\ndef _sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of the first n natural numbers.\"\"\"\n    sum_natural = _sum_of_natural_numbers(n)\n    return sum_natural * sum_natural\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_cubes = _sum_of_cubes(n)\n    sum_natural = _sum_of_natural_numbers(n)\n    return sum_cubes - sum_natural"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, size):\n    \"\"\"\n    Count pairs of elements whose XOR is odd.\n\n    Args:\n        array (list): List of integers\n        size (int): Size of the array\n\n    Returns:\n        int: Count of pairs with odd XOR\n    \"\"\"\n    count_odd = 0\n    count_even = 0\n    for x in array:\n        if x % 2 == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n    \n    return count_odd * count_even"}
{"task_id": "Mbpp/558", "solution": "def extract_digits(number: int) -> list[int]:\n    \"\"\"Convert integer to list of digits, in reverse order for position alignment.\"\"\"\n    if number == 0:\n        return [0]\n    digits = []\n    while number > 0:\n        digits.append(number % 10)\n        number //= 10\n    return digits\n\ndef calculate_differences(digits1: list[int], digits2: list[int]) -> list[int]:\n    \"\"\"Calculate absolute differences between corresponding digits, treating missing digits as zero.\"\"\"\n    diffs = []\n    max_len = max(len(digits1), len(digits2))\n    for i in range(max_len):\n        d1 = digits1[i] if i < len(digits1) else 0\n        d2 = digits2[i] if i < len(digits2) else 0\n        diffs.append(abs(d1 - d2))\n    return diffs\n\ndef sum_differences(differences: list[int]) -> int:\n    \"\"\"Sum all difference values in a list.\"\"\"\n    return sum(differences)\n\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculate the sum of per-digit differences between two integers.\"\"\"\n    digits1 = extract_digits(num1)\n    digits2 = extract_digits(num2)\n    differences = calculate_differences(digits1, digits2)\n    return sum_differences(differences)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Uppercase letters become lowercase, and lowercase letters become uppercase.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char.isupper():\n            result_chars.append(char.lower())\n        elif char.islower():\n            result_chars.append(char.upper())\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
