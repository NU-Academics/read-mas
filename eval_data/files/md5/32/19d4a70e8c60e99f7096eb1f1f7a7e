{"task_id": "Mbpp/448", "solution": "def _generate_perrin_sequence(count):\n    \"\"\"\n    Generates the first 'count' Perrin numbers, starting from P(0).\n    The definition P(n) = P(n-2) + P(n-3) with P(0)=3, P(1)=0, P(2)=2 is used.\n    \"\"\"\n    if count <= 0:\n        return []\n    \n    perrin_numbers = [3]  # P(0)\n    if count == 1:\n        return perrin_numbers\n\n    perrin_numbers.append(0) # P(1)\n    if count == 2:\n        return perrin_numbers\n\n    perrin_numbers.append(2) # P(2)\n    if count == 3:\n        return perrin_numbers\n\n    # For count > 3, generate subsequent numbers using the recurrence\n    for i in range(3, count):\n        next_perrin = perrin_numbers[i-2] + perrin_numbers[i-3]\n        perrin_numbers.append(next_perrin)\n    \n    return perrin_numbers\n\ndef _calculate_sum(sequence):\n    \"\"\"\n    Calculates the sum of numbers in a given sequence.\n    \"\"\"\n    return sum(sequence)\n\ndef cal_sum(n):\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to P(n), inclusive.\n    This interprets 'n' as the highest index of the Perrin number to include in the sum.\n    \"\"\"\n    perrin_sequence = _generate_perrin_sequence(n + 1)\n    total_sum = _calculate_sum(perrin_sequence)\n    return total_sum"}
{"task_id": "Mbpp/450", "solution": "def extract_string(string_list, size):\n    \"\"\"\n    Filters a list of strings, returning only those with a length matching the specified size.\n    Preserves the original order of matching strings.\n    \"\"\"\n    result = []\n    for s in string_list:\n        if len(s) == size:\n            result.append(s)\n    return result"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input_string: str) -> str:\n    \"\"\"\n    Removes all whitespace characters (spaces, tabs, newlines) from the given string.\n    Returns a new string with whitespaces removed, preserving non-whitespace characters.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    # Using a list to collect characters and then joining them is efficient\n    # as string concatenation in a loop can be slow due to immutability.\n    cleaned_chars = []\n    for char in input_string:\n        if not char.isspace():\n            cleaned_chars.append(char)\n    return \"\".join(cleaned_chars)"}
{"task_id": "Mbpp/453", "solution": "from typing import List\n\ndef _calculate_factors(number: int) -> List[int]:\n    \"\"\"Calculates all factors of the given number.\"\"\"\n    factors = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            factors.append(i)\n    return factors\n\ndef _filter_even_factors(factors: List[int]) -> List[int]:\n    \"\"\"Filters a list of numbers to include only even numbers.\"\"\"\n    even_factors = []\n    for factor in factors:\n        if factor % 2 == 0:\n            even_factors.append(factor)\n    return even_factors\n\ndef _sum_factors(factors: List[int]) -> int:\n    \"\"\"Calculates the sum of a list of numbers.\"\"\"\n    return sum(factors)\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"\n    Finds the sum of even factors of a given number.\n    It orchestrates factor calculation, filtering, and summation.\n    \"\"\"\n    all_factors = _calculate_factors(number)\n    even_factors = _filter_even_factors(all_factors)\n    return _sum_factors(even_factors)"}
{"task_id": "Mbpp/454", "solution": "import re\n\ndef _contains_z(word: str) -> bool:\n    \"\"\"Checks if a word contains the character 'z'.\"\"\"\n    return 'z' in word\n\ndef _extract_words(text: str) -> list[str]:\n    \"\"\"Extracts words from a string using word boundaries, handling punctuation.\"\"\"\n    # Matches sequences of alphanumeric characters and underscores as words.\n    return re.findall(r'\\b\\w+\\b', text)\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Determines if the input string contains any word with the lowercase character 'z'.\n    The search is case-sensitive and considers words separated by non-word characters.\n    \"\"\"\n    words = _extract_words(input_string)\n    for word in words:\n        if _contains_z(word):\n            return True\n    return False"}
