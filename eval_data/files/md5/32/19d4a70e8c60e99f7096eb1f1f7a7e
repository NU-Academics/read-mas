{"task_id": "Mbpp/137", "solution": "def _count_zeros(array: list[int]) -> int:\n    \"\"\"Counts the number of zero values in an integer array.\"\"\"\n    count = 0\n    for x in array:\n        if x == 0:\n            count += 1\n    return count\n\ndef _count_non_zeros(array: list[int]) -> int:\n    \"\"\"Counts the number of non-zero values in an integer array.\"\"\"\n    count = 0\n    for x in array:\n        if x != 0:\n            count += 1\n    return count\n\ndef zero_count(array: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Handles division by zero scenarios by returning float('inf') or float('nan') as appropriate.\n    \"\"\"\n    num_zeros = _count_zeros(array)\n    num_non_zeros = _count_non_zeros(array)\n\n    # Python's float division naturally handles division by zero for floats:\n    # X / 0.0 results in float('inf') or float('-inf')\n    # 0.0 / 0.0 results in float('nan')\n    return float(num_zeros) / float(num_non_zeros)"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(tuple_list: list) -> set:\n    \"\"\"\n    Flatten a list of tuples into a single set of unique numbers.\n\n    Args:\n        tuple_list: List of tuples containing numeric values\n\n    Returns:\n        Set containing all unique numbers from the input tuples\n    \"\"\"\n    result_set = set()\n    for tuple_item in tuple_list:\n        for number in tuple_item:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Assumes lists are of equal length and contain comparable elements.\n    \"\"\"\n    count = 0\n    # The design context indicates helper functions validate_lists and compare_positions.\n    # However, the prompt states \"Do NOT call any helper that is not defined inline in your response\".\n    # Since these helpers are not provided for inline definition, their logic will be integrated directly.\n\n    # Validate lists (as per design, but integrated due to \"no helper\" rule)\n    # The requirement overview also states \"Handle lists of equal length\"\n    # and \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # so we proceed assuming equal length, as per requirement 2.\n    # if not (len(list1) == len(list2) == len(list3)):\n    #     # In a real scenario, this would raise an error or handle the mismatch.\n    #     # Given the constraints, we assume lists are of equal length.\n    #     pass\n\n    for i in range(len(list1)):\n        # Compare positions (as per design, but integrated due to \"no helper\" rule)\n        # check if the elements at the current index are identical across all three lists\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def flip(arr: list, k: int) -> list:\n    \"\"\"Reverse elements from index 0 to k.\"\"\"\n    start = 0\n    end = k\n    while start < end:\n        arr[start], arr[end] = arr[end], arr[start]\n        start += 1\n        end -= 1\n    return arr\n\ndef find_max_index(arr: list, n: int) -> int:\n    \"\"\"Find index of maximum element in first n elements.\"\"\"\n    max_val = arr[0]\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > max_val:\n            max_val = arr[i]\n            max_idx = i\n    return max_idx\n\ndef pancake_sort(elements: list) -> list:\n    \"\"\"Sort list using pancake sort algorithm with flip operations only.\"\"\"\n    arr = list(elements)  # Create a copy to avoid modifying the original list\n    n = len(arr)\n\n    # Start from the last element and reduce the search range\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion\n        max_idx = find_max_index(arr, current_size)\n\n        # If the maximum element is not already at its correct position\n        if max_idx != current_size - 1:\n            # First flip: bring the maximum element to the front if it's not already there\n            if max_idx != 0:\n                arr = flip(arr, max_idx)\n            \n            # Second flip: move the maximum element from the front to its correct sorted position\n            arr = flip(arr, current_size - 1)\n            \n    return arr"}
