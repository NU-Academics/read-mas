{"task_id": "Mbpp/2", "solution": "def similar_elements(tuple1, tuple2):\n    \"\"\"\n    Finds the shared elements between two tuples.\n    Returns a tuple containing the common elements.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    \n    # The intersection of the two sets gives the shared elements\n    shared_set = set1.intersection(set2)\n    \n    # Convert the resulting set back to a tuple. The order might not be preserved,\n    # but the requirement states \"return results convertible to set format for comparison\",\n    # and the assert uses set() on the result, making order irrelevant for the check.\n    # To match the example assert output (4, 5) which is ordered, we can sort the elements.\n    return tuple(sorted(list(shared_set)))"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Handles edge cases for empty and single-character strings, returning 1 for them.\n    \"\"\"\n    n = len(s)\n\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    # Use KMP's border array (LPS array) logic to find the smallest repeating period.\n    # The period is n - lps[n-1], where lps[n-1] is the length of the longest proper prefix\n    # of s that is also a suffix of s.\n    lps = [0] * n\n    length = 0\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # If n is perfectly divisible by (n - lps[n-1]), then (n - lps[n-1]) is the period.\n    # Otherwise, the string does not have a repeating pattern that forms the whole string,\n    # and thus the period is n.\n    period = n - lps[n - 1]\n    if n % period == 0:\n        return period\n    else:\n        return n"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers_list, n):\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n    def _validate_input(numbers_list_param, n_param):\n        \"\"\"\n        Validates input parameters and handles edge cases, ensuring n does not exceed list length.\n        \"\"\"\n        if n_param < 0:\n            n_param = 0\n        validated_n = min(n_param, len(numbers_list_param))\n        return numbers_list_param, validated_n\n\n    def _extract_largest(numbers_list_param, n_param):\n        \"\"\"\n        Uses the heap algorithm to extract n largest elements.\n        \"\"\"\n        return heapq.nlargest(n_param, numbers_list_param)\n\n    def _sort_descending(elements):\n        \"\"\"\n        Sorts elements in descending order.\n        \"\"\"\n        return sorted(elements, reverse=True)\n\n    validated_list, validated_n = _validate_input(numbers_list, n)\n    extracted_largest_elements = _extract_largest(validated_list, validated_n)\n    final_result = _sort_descending(extracted_largest_elements)\n    return final_result"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, character):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Returns the modified string with both occurrences removed, or the original string if not found.\n    \"\"\"\n\n    def find_first_occurrence(s, char_to_find):\n        \"\"\"Locates the leftmost index of the character.\"\"\"\n        return s.find(char_to_find)\n\n    def find_last_occurrence(s, char_to_find):\n        \"\"\"Locates the rightmost index of the character.\"\"\"\n        return s.rfind(char_to_find)\n\n    def remove_character_at_positions(s, positions):\n        \"\"\"Builds a new string by excluding characters at the specified positions.\"\"\"\n        if not positions:\n            return s\n        \n        # Sort positions to handle removal from left to right correctly\n        # and ensure uniqueness if first and last were the same.\n        sorted_unique_positions = sorted(list(set(positions)))\n\n        if not sorted_unique_positions:\n            return s\n        \n        result_parts = []\n        last_index = 0\n        \n        for pos in sorted_unique_positions:\n            # Append the substring before the current removal position\n            result_parts.append(s[last_index:pos])\n            # Move last_index past the removed character\n            last_index = pos + 1\n        \n        # Append any remaining part of the string after the last removal\n        result_parts.append(s[last_index:])\n        return \"\".join(result_parts)\n\n    first_idx = find_first_occurrence(input_string, character)\n    \n    # If the character is not found at all, return the original string\n    if first_idx == -1:\n        return input_string\n\n    last_idx = find_last_occurrence(input_string, character)\n\n    # Collect indices to remove. If first and last are the same, only one will be added.\n    positions_to_remove = [first_idx]\n    if first_idx != last_idx:\n        positions_to_remove.append(last_idx)\n    \n    return remove_character_at_positions(input_string, positions_to_remove)"}
