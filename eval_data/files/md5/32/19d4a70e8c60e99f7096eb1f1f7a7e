{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, count):\n    \"\"\"\n    Finds the specified number of largest products from two lists.\n    Selects one factor from each list to form products.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n\n    # Sort the products in descending order\n    all_products.sort(reverse=True)\n\n    # Return the top 'count' products\n    return all_products[:count]"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, length, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from the prefix until index i,\n    mandatorily including the element at index k (where k > i).\n    \"\"\"\n    # Initialize dp array to store the maximum sum of an increasing subsequence ending at each index j (<= i).\n    # Each element arr[j] itself forms an increasing subsequence of sum arr[j].\n    dp = [0] * (i + 1)\n    if i >= 0:\n        dp[0] = arr[0]\n\n    # Fill the dp array for elements up to index i\n    for j in range(1, i + 1):\n        dp[j] = arr[j] # Initialize with the element itself\n        for prev_j in range(j):\n            if arr[j] > arr[prev_j]:\n                dp[j] = max(dp[j], dp[prev_j] + arr[j])\n\n    # Now, find the maximum sum from dp[j] (j <= i) such that arr[j] < arr[k].\n    # This value will be the prefix sum, to which arr[k] will be added.\n    max_prefix_sum_value = 0\n\n    # Iterate through the calculated dp sums for the prefix.\n    # We only consider `dp[j]` if `arr[j]` can precede `arr[k]` in an increasing subsequence.\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum_value = max(max_prefix_sum_value, dp[j])\n\n    # The total maximum sum is the max_prefix_sum_value found (which could be 0 if no valid prefix exists)\n    # plus the mandatory element arr[k].\n    return max_prefix_sum_value + arr[k]"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculate the volume of a cone given radius and height.\n    Uses the formula V = (1/3) \u00d7 \u03c0 \u00d7 r\u00b2 \u00d7 h.\n    \"\"\"\n    volume = (1/3) * math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(number: int) -> int:\n    \"\"\"\n    Set the leftmost unset bit in the binary representation of the input number.\n    Returns the modified integer value.\n    \"\"\"\n    if number == 0:\n        return 1\n\n    # Find the position of the most significant bit (MSB).\n    # This determines the effective \"length\" of the number's binary representation.\n    msb_pos = number.bit_length() - 1\n\n    # Iterate from the MSB position downwards to find the first unset bit (0).\n    for i in range(msb_pos, -1, -1):\n        # Check if the i-th bit is 0 using a bitwise AND with a mask.\n        if not (number & (1 << i)):\n            # If the bit is unset, set it by ORing with a mask and return the result.\n            return number | (1 << i)\n            \n    # If the loop completes, it means all bits from MSB down to 0 are already set.\n    # In this case, the leftmost unset bit is effectively at the next position higher than the current MSB.\n    return number | (1 << (msb_pos + 1))"}
