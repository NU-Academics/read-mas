{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r,h):\n    \"\"\"\n    Calculate the lateral surface area of a cone.\n    The formula used is \u03c0 \u00d7 r \u00d7 \u221a(r\u00b2 + h\u00b2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/730", "solution": "from typing import List, Any\n\ndef consecutive_duplicates(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Remove consecutive duplicate elements from input list.\n\n    Args:\n        input_list: List of elements to process\n\n    Returns:\n        List with consecutive duplicates removed, preserving first occurrence\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] != input_list[i-1]:\n            result.append(input_list[i])\n\n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    Handles numbers with less than 3 bits by returning the number unchanged.\n    \"\"\"\n    if number < 3:  # Numbers like 0, 1, 2 have no \"middle\" bits to toggle\n        return number\n\n    # Determine the number of bits in the input number\n    num_bits = number.bit_length()\n\n    # If there are 2 or fewer bits, there are no middle bits to toggle\n    if num_bits <= 2:\n        return number\n\n    # Create a mask to identify the middle bits.\n    # The mask will have 1s in all middle bit positions and 0s elsewhere.\n    # For a number with num_bits, the MSB is at position num_bits-1, LSB at 0.\n    # Middle bits are from position 1 to num_bits-2.\n    \n    # Example: num_bits = 4 (for 9, which is 1001)\n    # Positions: 3 2 1 0\n    # Original:  1 0 0 1\n    # MSB at 3, LSB at 0. Middle bits at 2, 1.\n    # Mask should be 0110\n\n    # Start with a mask of all ones up to num_bits\n    all_ones_mask = (1 << num_bits) - 1\n\n    # Clear the MSB (most significant bit) by XORing with a mask that only has MSB set.\n    # Or, more simply, remove the MSB by subtracting (1 << (num_bits - 1))\n    mask_without_msb = all_ones_mask ^ (1 << (num_bits - 1))\n\n    # Clear the LSB (least significant bit) by XORing with 1 (0b0001)\n    # The final mask will have 1s only for the middle bits\n    middle_bits_mask = mask_without_msb ^ 1\n\n    # Toggle the middle bits using XOR operation with the generated mask\n    result = number ^ middle_bits_mask\n\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Uses a modified binary search algorithm.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Move left to find the first occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    Helper functions are defined internally for generating sublists and calculating products.\n    \"\"\"\n\n    def generate_contiguous_sublists(lst: list) -> list:\n        \"\"\"Generates all contiguous sublists from the input list.\"\"\"\n        sublists = []\n        n = len(lst)\n        for i in range(n):\n            for j in range(i, n):\n                sublists.append(lst[i : j + 1])\n        return sublists\n\n    def calculate_sublist_product(sublist: list) -> int:\n        \"\"\"Calculates the product of all elements in a given sublist.\"\"\"\n        if not sublist:\n            return 0  # Product of an empty list of numbers for summation context\n        product = 1\n        for item in sublist:\n            product *= item\n        return product\n\n    total_sum_of_products = 0\n    all_sublists = generate_contiguous_sublists(input_list)\n\n    for sublist in all_sublists:\n        total_sum_of_products += calculate_sublist_product(sublist)\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u) using regex.\n    Handles both uppercase and lowercase vowels.\n    \"\"\"\n    if not input_string:\n        return False\n    # The regex pattern matches a vowel (case-insensitive) at the beginning of the string.\n    pattern = r'^[aeiouAEIOU]'\n    return bool(re.match(pattern, input_string))"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"\n    Checks if all characters in the input string are identical.\n    Returns True for empty strings or strings with a single character.\n    \"\"\"\n    if len(input_string) <= 1:\n        return True\n    \n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, target_value):\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    Returns the index where the target_value should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < target_value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/740", "solution": "def _validate_input(input_tuple: tuple) -> bool:\n    \"\"\"Validate input tuple has an even number of elements.\"\"\"\n    return len(input_tuple) % 2 == 0\n\ndef _pair_elements(input_tuple: tuple) -> dict:\n    \"\"\"Create dictionary from adjacent tuple elements.\"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        result_dict[input_tuple[i]] = input_tuple[i+1]\n    return result_dict\n\ndef tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Convert tuple to dictionary by pairing adjacent elements.\n    Even-indexed elements become keys, odd-indexed elements become values.\n    \"\"\"\n    if not _validate_input(input_tuple):\n        return {}\n    \n    return _pair_elements(input_tuple)"}
