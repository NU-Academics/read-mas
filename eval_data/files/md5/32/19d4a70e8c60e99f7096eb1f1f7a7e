{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuples_list):\n    \"\"\"\n    Calculates the maximum aggregate value from a list of (name, value) tuples.\n    It sums values for each unique name and returns the name with the highest total.\n    \"\"\"\n\n    def _aggregate_by_name(data_list):\n        \"\"\"Aggregates numeric values by their corresponding names.\"\"\"\n        aggregates = {}\n        for name, value in data_list:\n            aggregates[name] = aggregates.get(name, 0) + value\n        return aggregates\n\n    def _find_maximum(aggregated_data):\n        \"\"\"Identifies the name with the highest aggregate value.\"\"\"\n        if not aggregated_data:\n            return (None, None)\n\n        max_name = None\n        max_value = -float('inf')\n\n        for name, total_value in aggregated_data.items():\n            if total_value > max_value:\n                max_value = total_value\n                max_name = name\n        return (max_name, max_value)\n\n    aggregated_sums = _aggregate_by_name(tuples_list)\n    return _find_maximum(aggregated_sums)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list) -> tuple:\n    \"\"\"\n    Extracts two words starting with 'p' from a list of strings.\n    Each string in the input list may contain multiple space-separated words.\n    \"\"\"\n    all_words = []\n    for item in word_list:\n        all_words.extend(item.split(' '))\n\n    p_words = []\n    for word in all_words:\n        if word.startswith('p'):\n            p_words.append(word)\n        elif word.startswith('P'):  # Case-sensitive match as per requirement \"handle case-sensitive matching for the letter 'p'\" and example\n            p_words.append(word)\n        if len(p_words) == 2:\n            break\n            \n    return (p_words[0], p_words[1])"}
