{"task_id": "Mbpp/771", "solution": "class BracketStack:\n    \"\"\"A simple stack implementation for tracking brackets.\"\"\"\n    def __init__(self):\n        self._items: list[str] = []\n\n    def push(self, item: str) -> None:\n        self._items.append(item)\n\n    def pop(self) -> str:\n        # Assumes stack is not empty based on BracketValidator's logic.\n        return self._items.pop()\n\n    def peek(self) -> str:\n        # Assumes stack is not empty based on BracketValidator's logic.\n        return self._items[-1]\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\n\n    def size(self) -> int:\n        return len(self._items)\n\nclass BracketMatcher:\n    \"\"\"Utility to identify bracket types and check for matching pairs.\"\"\"\n    def __init__(self):\n        self._opening_brackets: set[str] = {'(', '[', '{'}\n        self._closing_brackets: set[str] = {')', ']', '}'}\n        self._bracket_pairs: dict[str, str] = {')': '(', ']': '[', '}': '{'}\n\n    def is_opening_bracket(self, char: str) -> bool:\n        return char in self._opening_brackets\n\n    def is_closing_bracket(self, char: str) -> bool:\n        return char in self._closing_brackets\n\n    def is_matching_pair(self, opening: str, closing: str) -> bool:\n        return self._bracket_pairs.get(closing) == opening\n\nclass BracketValidator:\n    \"\"\"Core logic for validating bracket balance using a stack.\"\"\"\n    def __init__(self):\n        self._stack: BracketStack = BracketStack()\n        self._matcher: BracketMatcher = BracketMatcher()\n\n    def validate(self, expression: str) -> bool:\n        for char in expression:\n            if not self._process_character(char):\n                return False\n        return self._stack.is_empty()\n\n    def _process_character(self, char: str) -> bool:\n        if self._matcher.is_opening_bracket(char):\n            self._stack.push(char)\n        elif self._matcher.is_closing_bracket(char):\n            if self._stack.is_empty():\n                return False\n            \n            last_opening = self._stack.peek()\n            if self._matcher.is_matching_pair(last_opening, char):\n                self._stack.pop()\n            else:\n                return False\n        return True\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\"\"\"\n    validator = BracketValidator()\n    return validator.validate(expression)"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(input_list):\n    \"\"\"\n    Calculates the sum of non-repeated elements (unique values) in a list.\n    \"\"\"\n    def _count_occurrences(lst):\n        \"\"\"Counts the occurrences of each element in the list.\"\"\"\n        return collections.Counter(lst)\n\n    def _filter_unique_elements(occurrence_map):\n        \"\"\"Filters for all unique elements present in the occurrence map.\"\"\"\n        return list(occurrence_map.keys())\n\n    def _calculate_sum(elements):\n        \"\"\"Calculates the sum of a list of elements.\"\"\"\n        return sum(elements)\n\n    occurrence_map = _count_occurrences(input_list)\n    unique_elements = _filter_unique_elements(occurrence_map)\n    total_sum = _calculate_sum(unique_elements)\n    \n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Returns a list of sublists, where each sublist contains consecutive identical elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[-1]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist) # Append the last sublist\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "def _calculate_divisor_count(n: int) -> int:\n    \"\"\"Calculates the total number of divisors for a given integer.\"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks whether the count of divisors for a given integer is even.\"\"\"\n    divisor_count = _calculate_divisor_count(n)\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple, Iterator\n\ndef find_combinations(tuple_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Main interface to find combinations of sums with tuples in the given tuple list.\n    Generates all pairwise combinations and calculates their element-wise sums.\n    \"\"\"\n\n    def validate_input(t_list: List[Tuple[int, int]]) -> None:\n        \"\"\"Validates that the input is a list of two-element integer tuples.\"\"\"\n        # The design context explicitly states \"No ... raise exceptions for edge cases\"\n        # and \"No isinstance() checks\". We assume input is always valid based on this.\n        pass\n\n    def generate_combinations(t_list: List[Tuple[int, int]]) -> Iterator[Tuple[Tuple[int, int], Tuple[int, int]]]:\n        \"\"\"Generates all unique pairwise combinations of tuples from the input list.\"\"\"\n        return itertools.combinations(t_list, 2)\n\n    def tuple_sum(t1: Tuple[int, int], t2: Tuple[int, int]) -> Tuple[int, int]:\n        \"\"\"Calculates the element-wise sum of two 2-element tuples.\"\"\"\n        return (t1[0] + t2[0], t1[1] + t2[1])\n\n    def calculate_sums(combinations_iterator: Iterator[Tuple[Tuple[int, int], Tuple[int, int]]]) -> List[Tuple[int, int]]:\n        \"\"\"Calculates the sum for each tuple pair generated by the combinations iterator.\"\"\"\n        result_list = []\n        for t1, t2 in combinations_iterator:\n            result_list.append(tuple_sum(t1, t2))\n        return result_list\n\n    validate_input(tuple_list)\n    combinations = generate_combinations(tuple_list)\n    result = calculate_sums(combinations)\n    return result"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(array: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length contiguous subarrays within the input array.\n    \"\"\"\n    total_sum = 0\n    n = len(array)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Extract the current subarray\n            current_subarray = array[i : j + 1]\n            # Check if its length is odd\n            if len(current_subarray) % 2 != 0:\n                total_sum += sum(current_subarray)\n\n    return total_sum"}
