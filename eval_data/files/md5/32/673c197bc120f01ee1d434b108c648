{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer x in the nested list lst and returns their (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row_list in enumerate(lst):\n        for col_idx, element in enumerate(row_list):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort by row ascending (primary key), then by column descending (secondary key).\n    # Sorting by -coord[1] effectively sorts by column in descending order.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s: str) -> str:\n    \"\"\"\n    Returns a string where characters within each word are sorted by ASCII value.\n    Word order and all blank spaces are preserved.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    result_parts = []\n    current_word = []\n    for char in s:\n        if char == ' ':\n            if current_word:\n                result_parts.append(\"\".join(sorted(current_word)))\n                current_word = []\n            result_parts.append(' ')\n        else:\n            current_word.append(char)\n        \n    if current_word:\n        result_parts.append(\"\".join(sorted(current_word)))\n            \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer `x` in `lst` and returns 0-indexed `(row, column)` coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the array sorted based on the sum of its first and last elements.\n    Sort in ascending order if the sum is odd, or descending order if the sum is even, ensuring the original array remains unchanged.\n    \"\"\"\n    if not array or len(array) < 2:\n        return list(array)\n\n    copied_array = list(array)\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_elements = first_element + last_element\n\n    if sum_elements % 2 != 0:  # Odd sum, sort ascending\n        copied_array.sort()\n    else:  # Even sum, sort descending\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/86", "solution": "import re\nclass StringSplitter:\n    def split_by_spaces(self, s: str) -> list[str]:\n        \"\"\"\n        Splits a string into words and spaces, preserving order.\n        Example: \"Hello World\" -> [\"Hello\", \" \", \"World\"].\n        \"\"\"\n        parts = []\n        last_idx = 0\n        for match in re.finditer(r'(\\s+)', s):\n            if match.start() > last_idx:\n                parts.append(s[last_idx:match.start()])\n            parts.append(match.group(0))\n            last_idx = match.end()\n        if last_idx < len(s):\n            parts.append(s[last_idx:])\n        return parts\nclass WordSorter:\n    def sort_characters(self, word: str) -> str:\n        \"\"\"\n        Sorts characters within a single word based on ASCII values.\n        \"\"\"\n        return \"\".join(sorted(word))\nclass AntiShuffleService:\n    def __init__(self, string_splitter: StringSplitter = None, word_sorter: WordSorter = None):\n        self._string_splitter = string_splitter if string_splitter is not None else StringSplitter()\n        self._word_sorter = word_sorter if word_sorter is not None else WordSorter()\n\n    def anti_shuffle(self, s: str) -> str:\n        \"\"\"\n        Returns a string where characters within each word are sorted alphabetically by ASCII values.\n        The original word order and spacing are preserved.\n        \"\"\"\n        if not s:\n            return \"\"\n\n        parts = self._string_splitter.split_by_spaces(s)\n        result_parts = []\n        for part in parts:\n            if part.strip() == \"\":\n                result_parts.append(part)\n            else:\n                result_parts.append(self._word_sorter.sort_characters(part))\n        return \"\".join(result_parts)\ndef anti_shuffle(s):\n    \"\"\"\n    Convenience function to use AntiShuffleService directly.\n    \"\"\"\n    service = AntiShuffleService()\n    return service.anti_shuffle(s)"}
{"task_id": "HumanEval/89", "solution": "ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\nSHIFT_AMOUNT = 4\ndef encrypt(s):\n    \"\"\"Encrypts a string using an alphabet rotation cipher with a fixed shift.\n    Only lowercase English letters are shifted; other characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            current_index = ALPHABET.index(char)\n            shifted_index = (current_index + SHIFT_AMOUNT) % len(ALPHABET)\n            encrypted_chars.append(ALPHABET[shifted_index])\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 positions.\n    Non-alphabetic characters are preserved, and case is maintained.\n    \"\"\"\n    SHIFT_AMOUNT = 4\n    result = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_char_code = ((ord(char) - ord('a') + SHIFT_AMOUNT) % 26) + ord('a')\n            result.append(chr(shifted_char_code))\n        elif 'A' <= char <= 'Z':\n            shifted_char_code = ((ord(char) - ord('A') + SHIFT_AMOUNT) % 26) + ord('A')\n            result.append(chr(shifted_char_code))\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a sorted copy based on the sum of its first and last elements.\n    Sorts ascending if the sum is odd, descending if the sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    # Create a copy to ensure the original array is not modified.\n    copied_array = list(array)\n\n    if len(copied_array) == 1:\n        return copied_array\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    \n    # Determine sorting order based on the parity of the sum.\n    if (first_element + last_element) % 2 != 0:  # Sum is odd\n        copied_array.sort(reverse=False) # Ascending order\n    else:  # Sum is even\n        copied_array.sort(reverse=True)  # Descending order\n        \n    return copied_array"}
{"task_id": "HumanEval/90", "solution": "class ListProcessor:\n    @staticmethod\n    def get_unique_sorted_elements(lst: list[int]) -> list[int]:\n        \"\"\"\n        Returns a sorted list of unique elements from the input list.\n        Duplicates are removed before sorting.\n        \"\"\"\n        return sorted(list(set(lst)))\nclass NextSmallestService:\n    def find_second_smallest(self, lst: list[int]) -> int | None:\n        \"\"\"\n        Determines the second smallest unique element in the list.\n        Returns None if fewer than two unique elements exist.\n        \"\"\"\n        unique_sorted_list = ListProcessor.get_unique_sorted_elements(lst)\n        \n        if len(unique_sorted_list) < 2:\n            return None\n        else:\n            return unique_sorted_list[1]\ndef next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Finds the second smallest unique integer in a list.\n    Returns None if there isn't a second smallest unique element.\n    \"\"\"\n    service = NextSmallestService()\n    return service.find_second_smallest(lst)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if no such element exists (e.g., list is empty or has fewer than 2 distinct elements).\n    \"\"\"\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
{"task_id": "HumanEval/91", "solution": "class SentenceTokenizer:\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def tokenize(self, text: str) -> list[str]:\n        \"\"\"Splits the input text into a list of sentences.\"\"\"\n        temp_text = text\n        for delimiter in self.SENTENCE_DELIMITERS:\n            temp_text = temp_text.replace(delimiter, \"|SPLIT|\")\n\n        sentences = [\n            s.strip() for s in temp_text.split(\"|SPLIT|\") if s.strip()\n        ]\n        return sentences\nclass SentenceAnalyzer:\n    TARGET_WORD = \"I\"\n\n    def starts_with_i(self, sentence: str) -> bool:\n        \"\"\"Checks if the sentence starts with the word \"I\", case-insensitively.\"\"\"\n        cleaned_sentence = sentence.strip()\n        if not cleaned_sentence:\n            return False\n\n        words = cleaned_sentence.split()\n        if not words:\n            return False\n\n        return words[0].lower() == self.TARGET_WORD.lower()\nclass BoredomCounterService:\n    def __init__(self, tokenizer: SentenceTokenizer, analyzer: SentenceAnalyzer):\n        self.tokenizer = tokenizer\n        self.analyzer = analyzer\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Counts sentences starting with \"I\" using a tokenizer and analyzer.\"\"\"\n        sentences = self.tokenizer.tokenize(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self.analyzer.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S):\n    \"\"\"\n    Counts the number of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    tokenizer = SentenceTokenizer()\n    analyzer = SentenceAnalyzer()\n    service = BoredomCounterService(tokenizer, analyzer)\n    return service.count_boredoms(S)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    \n    SENTENCE_DELIMITERS = ['.', '?', '!']\n    \n    temp_text = S\n    for delim in SENTENCE_DELIMITERS:\n        temp_text = temp_text.replace(delim, delim + \"|SENTENCE_END|\")\n    \n    # Split by the marker, filter out empty strings, and strip whitespace.\n    sentences = [\n        s.strip() for s in temp_text.split(\"|SENTENCE_END|\") if s.strip()\n    ]\n\n    boredom_count = 0\n    for sentence in sentences:\n        # Check if the sentence starts with \"I\" as a standalone word.\n        if re.match(r\"^[Ii]\\b\", sentence):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    # Check if all numbers represent integer values.\n    # This relies on numerical types supporting the modulo operator.\n    if not (x % 1 == 0 and y % 1 == 0 and z % 1 == 0):\n        return False\n    \n    # Check if one of the numbers is equal to the sum of the other two.\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of the three numbers is equal to the sum of the other two,\n    and all numbers are integers.\n    \"\"\"\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by swapping letter case and replacing vowels as specified.\"\"\"\n    VOWELS_LOWERCASE = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPERCASE = {'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWERCASE = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPERCASE = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        processed_char = char # Non-alphabetic characters remain unchanged by default.\n\n        if char.isalpha():\n            is_vowel = False\n            # Determine if the original character is a vowel, respecting its case.\n            if char.islower() and char in VOWELS_LOWERCASE:\n                is_vowel = True\n            elif char.isupper() and char in VOWELS_UPPERCASE:\n                is_vowel = True\n\n            if is_vowel:\n                # If a vowel: replace it with the letter two places ahead (preserving original case),\n                # then swap the case of this newly obtained character.\n                if char.islower():\n                    idx = ALPHABET_LOWERCASE.index(char)\n                    shifted_char = ALPHABET_LOWERCASE[(idx + 2) % len(ALPHABET_LOWERCASE)]\n                    processed_char = shifted_char.upper() # Original 'a' -> 'c', then swap case to 'C'\n                else: # char.isupper()\n                    idx = ALPHABET_UPPERCASE.index(char)\n                    shifted_char = ALPHABET_UPPERCASE[(idx + 2) % len(ALPHABET_UPPERCASE)]\n                    processed_char = shifted_char.lower() # Original 'A' -> 'C', then swap case to 'c'\n            else:\n                # If a non-vowel letter: simply swap its case.\n                processed_char = char.swapcase()\n        \n        encoded_chars.append(processed_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n: int) -> int:\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Given a list of integers, find the largest prime and return the sum of its digits.\n    Returns 0 if no prime numbers are found in the list.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\n        Uses an optimized trial division method.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given integer n.\n        Works for non-negative integers.\n        \"\"\"\n        s = 0\n        # The while n: loop implicitly handles n=0 by returning 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = -1\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime == -1:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Assumes only letters for transformations; non-letters are passed through.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            # Pass non-alphabetic characters through unchanged, as per examples.\n            encoded_chars.append(char)\n            continue\n\n        # Swap case of the current letter as per FR1.\n        # This processed character will be used if it's a consonant,\n        # or as the base for vowel replacement if it's a vowel.\n        processed_char = char.swapcase()\n\n        # Check if the original character was a vowel (case-insensitive) as per FR2.\n        if char in VOWELS:\n            # If it was a vowel, apply the two-place shift to the processed character,\n            # preserving its current (swapped) case for the replacement.\n            if processed_char.islower():\n                alphabet = ALPHABET_LOWER\n            else:\n                alphabet = ALPHABET_UPPER\n\n            # Find the index of the processed (swapped) vowel in its alphabet.\n            original_index = alphabet.find(processed_char)\n            # Calculate the new index, shifted two places ahead with wrap-around.\n            new_index = (original_index + 2) % len(alphabet)\n            \n            # Get the replacement character and append it.\n            replacement_char = alphabet[new_index]\n            encoded_chars.append(replacement_char)\n        else:\n            # If the original character was not a vowel, just append the swapped-case character.\n            encoded_chars.append(processed_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Adhering to the critical requirement: \"Do NOT add isinstance() checks\".\n    # We assume all keys are strings for case validation; non-string keys would cause an AttributeError.\n\n    keys_view = dict.keys()\n\n    all_lower = True\n    for key in keys_view:\n        if key != key.lower():\n            all_lower = False\n            break\n\n    if all_lower:\n        return True\n\n    all_upper = True\n    for key in keys_view:\n        if key != key.upper():\n            all_upper = False\n            break\n\n    return all_upper"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Returns the product of the unit digits of two integers, assuming valid input.\n    E.g., `multiply(148, 412)` returns 16; `multiply(14, -15)` returns 20.\"\"\"\n    unit_digit_a = abs(a % 10)\n    unit_digit_b = abs(b % 10)\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Finds all prime numbers strictly less than n.\n    Returns an array of primes in ascending order.\n    \"\"\"\n\n    def _is_prime_local(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    if n <= 1:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime_local(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n\n    def is_prime(num):\n        \"\"\"\n        Checks if a number is prime using trial division up to its square root.\n        Numbers less than 2 are not prime.\n        \"\"\"\n        if num < 2:\n            return False\n        # Only need to check divisors up to the square root of num.\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    # Handle edge cases where no primes are strictly less than n.\n    if n <= 2:\n        return []\n\n    primes = []\n    # Iterate from 2 up to n-1 to find all primes strictly less than n.\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Validates if all string keys in a dictionary are uniformly lowercase or uppercase.\n    Returns False for empty dictionaries or if any key is not a string.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = []\n    has_non_string_keys = False\n    for key in dict.keys():\n        if isinstance(key, str):\n            string_keys.append(key)\n        else:\n            has_non_string_keys = True\n\n    if has_non_string_keys:\n        return False\n\n    # At this point, string_keys contains only actual string keys from the dictionary.\n    # If string_keys is empty, it implies the original dictionary was either empty\n    # (handled by the first `if not dict:`) or contained only non-string keys\n    # (handled by `if has_non_string_keys:`). Therefore, if code execution\n    # reaches this point, string_keys is guaranteed to be non-empty.\n\n    all_lower = all(key == key.lower() for key in string_keys)\n    all_upper = all(key == key.upper() for key in string_keys)\n\n    return all_lower or all_upper"}
