{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    The algorithm finds the longest palindromic suffix and prepends the reverse of the remaining prefix.\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n    \n    prefix_to_reverse = string[:len(string) - longest_palindromic_postfix_len]\n    \n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    This function computes the GCD using the Euclidean algorithm, handling signs and zero inputs.\n    \"\"\"\n    if a == 0 and b == 0:\n        return 0\n    elif a == 0:\n        return abs(b)\n    elif b == 0:\n        return abs(a)\n\n    a, b = abs(a), abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Find the longest palindromic postfix and append the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the starting index of the longest palindromic suffix.\n    # We iterate from the beginning of the string, checking if each suffix is a palindrome.\n    # The first one we find will be the longest suffix that is a palindrome.\n    longest_palindromic_suffix_start_index = 0\n    for i in range(len(string)):\n        if is_palindrome(string[i:]):\n            longest_palindromic_suffix_start_index = i\n            break\n\n    # The part of the string before this longest palindromic suffix needs to be reversed.\n    prefix_to_reverse = string[:longest_palindromic_suffix_start_index]\n\n    # Construct the shortest palindrome by appending the reversed prefix to the original string.\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"Return list of all prefixes from shortest to longest of the input string.\n    For example: all_prefixes('abc') returns ['a', 'ab', 'abc'].\n    \"\"\"\n    return [string[0:i+1] for i in range(len(string))]"}
