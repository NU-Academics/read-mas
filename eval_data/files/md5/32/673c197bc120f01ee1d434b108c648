{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    \"\"\"\n    tolerance = 1e-6\n    max_iterations = 100\n    a, b = -1000.0, 1000.0  # Default search range as per design\n\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    # The problem statement guarantees a solution and implies a suitable initial interval.\n    # No explicit error handling for invalid coefficients or non-bracketing interval is added\n    # as per critical requirements.\n\n    for _ in range(max_iterations):\n        c = (a + b) / 2\n        fc = poly(xs, c)\n\n        if abs(fc) < tolerance:\n            return c\n\n        if fa * fc < 0:\n            b = c\n            fb = fc\n        else:\n            a = c\n            fa = fc\n\n    # Return the last computed midpoint if max_iterations is reached.\n    # This adheres to not raising a RootNotFoundError.\n    return c"}
{"task_id": "HumanEval/32", "solution": "def poly(xs: list, x: float):\n    \"\"\"Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n.\n    \"\"\"\n    return sum([coeff * (x ** i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"Finds x such that poly(x) = 0 using Newton-Raphson.\n    Returns a single zero point for the polynomial.\n    \"\"\"\n    def calculate_derivative_coefficients(coefficients: list[float]) -> list[float]:\n        \"\"\"Calculates coefficients of the polynomial's derivative.\"\"\"\n        if len(coefficients) <= 1:\n            return [0.0]\n        derivative_coeffs = []\n        for i in range(1, len(coefficients)):\n            derivative_coeffs.append(i * coefficients[i])\n        return derivative_coeffs\n\n    DEFAULT_TOLERANCE = 1e-6\n    MAX_ITERATIONS = 100\n    x_current = 1.0\n\n    for _ in range(MAX_ITERATIONS):\n        poly_val = poly(xs, x_current)\n        \n        if abs(poly_val) < DEFAULT_TOLERANCE:\n            return x_current\n        \n        derivative_coeffs = calculate_derivative_coefficients(xs)\n        derivative_val = poly(derivative_coeffs, x_current)\n        \n        # Per critical requirements, no explicit error handling for derivative_val == 0.\n        x_current -= poly_val / derivative_val\n            \n    # Per critical requirements, no explicit error handling for non-convergence.\n    return x_current"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    seven_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            seven_count += str(i).count('7')\n    return seven_count"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    \"\"\"\n    \n    total_digit_count = 0\n    \n    # Iterate through numbers from 1 up to (but not including) n\n    for i in range(1, n):\n        # Check if the number is divisible by 11 or 13\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Count occurrences of the digit '7' in the current number\n            total_digit_count += str(i).count('7')\n            \n    return total_digit_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n    \n    result_list = l[:]\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n        \n    return result_list"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result_list = list(l)\n    even_idx_counter = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a number is prime.\n        \"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def generate_fibonacci_sequence():\n        \"\"\"\n        Generates an infinite sequence of Fibonacci numbers starting from 1, 1, 2, 3...\n        \"\"\"\n        a, b = 1, 1\n        yield a\n        while True:\n            yield b\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = generate_fibonacci_sequence()\n\n    for fib_num in fib_gen:\n        if is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "import math\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if the given number is a prime number.\n        Optimized by checking divisibility up to its square root.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    def generate_fibonacci_sequence():\n        \"\"\"\n        Generates an infinite sequence of Fibonacci numbers.\n        Starts with F(3)=2, then F(4)=3, F(5)=5, etc.\n        \"\"\"\n        yield 2 # The first prime Fibonacci number F(3)\n        a, b = 1, 2 # F(2), F(3) for the next iteration\n        while True:\n            next_fib = a + b\n            yield next_fib\n            a, b = b, next_fib\n\n    prime_fib_count = 0\n    fib_generator = generate_fibonacci_sequence()\n\n    for fib_num in fib_generator:\n        if is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
