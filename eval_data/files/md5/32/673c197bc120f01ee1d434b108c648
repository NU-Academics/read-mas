{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits (absolute value less than 100)\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements.\n    for i in range(k):\n        element = arr[i]\n        # Add element to sum if its absolute value has at most two digits.\n        if abs(element) < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/119", "solution": "class ParenthesesUtil:\n    @staticmethod\n    def is_balanced(s: str) -> bool:\n        \"\"\"Checks if the input string has balanced parentheses using a counter.\n        It returns true if the string is balanced, false otherwise.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass ParenthesesBalancerService:\n    def can_form_balanced_string(self, s1: str, s2: str) -> str:\n        \"\"\"Evaluates if concatenating s1 and s2 in any order forms a balanced string.\n        It uses ParenthesesUtil to check the balance of concatenated strings.\"\"\"\n        if ParenthesesUtil.is_balanced(s1 + s2):\n            return 'Yes'\n        \n        if ParenthesesUtil.is_balanced(s2 + s1):\n            return 'Yes'\n            \n        return 'No'\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"Checks if two parenthesis strings can form a balanced string when concatenated.\n    It delegates the balancing check to ParenthesesBalancerService.\"\"\"\n    s1, s2 = lst[0], lst[1]\n    \n    service = ParenthesesBalancerService()\n    return service.can_form_balanced_string(s1, s2)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of unique odd numbers from its Collatz sequence.\n    The sequence terminates when the number reaches 1, and 1 is always included.\n    \"\"\"\n    odd_numbers = set()\n    current_num = n\n\n    while current_num != 1:\n        if current_num % 2 != 0:\n            odd_numbers.add(current_num)\n            current_num = (3 * current_num) + 1\n        else:\n            current_num = current_num // 2\n    \n    odd_numbers.add(1) # 1 is always part of the sequence and is odd.\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    \n    # Generate the complete Collatz sequence for n.\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n    \n    # Extract unique odd numbers from the sequence and return them sorted.\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    \n    return odd_numbers"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas if no whitespace is present.\n    If neither is present, it counts lowercase letters with an odd 0-indexed alphabetical order.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string.\n    Returns True if the date is valid, otherwise False.\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    mm_str, dd_str, yyyy_str = parts\n\n    if not (len(mm_str) == 2 and len(dd_str) == 2 and len(yyyy_str) == 4):\n        return False\n\n    if not (mm_str.isdigit() and dd_str.isdigit() and yyyy_str.isdigit()):\n        return False\n\n    month = int(mm_str)\n    day = int(dd_str)\n    year = int(yyyy_str)\n\n    if not (1 <= month <= 12):\n        return False\n\n    days_in_month_map = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 28 \n    }\n    \n    max_days = days_in_month_map.get(month)\n\n    if month == 2:\n        is_leap_year = (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n        if is_leap_year:\n            max_days = 29\n        else:\n            max_days = 28\n    \n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. Return False if any number appears three or more times.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate count (no number appears three or more times).\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n\n    for count_val in counts.values():\n        if count_val > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and contains no more than one duplicate of any number.\n    \"\"\"\n    n = len(lst)\n\n    if n <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(n - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for more than one duplicate (i.e., 3 or more occurrences)\n    counts = {}\n    for x in lst:\n        counts[x] = counts.get(x, 0) + 1\n        if counts[x] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "alphabet_order_map = {\n    'a': 0, 'b': 1, 'c': 2, 'd': 3, 'e': 4, 'f': 5, 'g': 6, 'h': 7, 'i': 8, 'j': 9,\n    'k': 10, 'l': 11, 'm': 12, 'n': 13, 'o': 14, 'p': 15, 'q': 16, 'r': 17, 's': 18,\n    't': 19, 'u': 20, 'v': 21, 'w': 22, 'x': 23, 'y': 24, 'z': 25\n}\ndef split_words(txt):\n    '''\n    Splits a string by whitespace, then by comma if no whitespace, or counts odd-ordered lowercase letters otherwise.\n    Alphabetical order is 0-indexed ('a'=0, 'b'=1, etc.) for counting.\n    '''\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace:\n        return txt.split()\n\n    has_comma = ',' in txt\n\n    if has_comma:\n        return txt.split(',')\n\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = alphabet_order_map[char]\n            if order % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise.\"\"\"\n\n    import math\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given non-negative integer is a prime number.\n        Returns True if prime, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check divisibility by odd numbers from 3 up to the square root of n.\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def calculate_intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n        \"\"\"Calculates the intersection of two closed integer intervals.\n        Returns the intersection interval or None if they do not intersect.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        if intersection_start > intersection_end:\n            return None\n        return (intersection_start, intersection_end)\n\n    def calculate_length(interval: tuple[int, int]) -> int:\n        \"\"\"Calculates the length of a given closed integer interval.\n        Returns the integer length.\"\"\"\n        start, end = interval\n        return end - start\n\n    intersection_result = calculate_intersection(interval1, interval2)\n\n    if intersection_result is None:\n        return \"NO\"\n\n    length = calculate_length(intersection_result)\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"Validates a given date string for 'mm-dd-yyyy' format and date integrity.\n    Returns True if valid, False otherwise.\"\"\"\n\n    class DateParts:\n        def __init__(self, month: int, day: int, year: int):\n            self.month = month\n            self.day = day\n            self.year = year\n\n    def is_leap_year(year: int) -> bool:\n        \"\"\"Determines if a given year is a leap year.\"\"\"\n        return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n\n    DAYS_IN_MONTH_MAP: dict[int, int] = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 28\n    }\n\n    # Regex matches 'mm-dd-yyyy' where month is 01-12, day is 01-31, year is 1900-2099.\n    DATE_FORMAT_REGEX: str = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-(19|20)\\d{2}$\"\n\n    # 1. The date string is not empty.\n    if not date:\n        return False\n\n    # 4. The date should be in the format: mm-dd-yyyy\n    match = re.match(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    # Extract and parse date components from regex groups.\n    month = int(match.group(1))\n    day = int(match.group(2))\n    year = int(match.group(3))\n    date_parts = DateParts(month, day, year)\n\n    # 3. The months should not be less than 1 or higher than 12.\n    # This is implicitly handled by DATE_FORMAT_REGEX's month group (01-12).\n\n    # 2. Validate day based on month and leap year.\n    max_days_for_month = DAYS_IN_MONTH_MAP[date_parts.month] # Month is guaranteed 1-12 by regex.\n\n    if date_parts.month == 2:  # February\n        if is_leap_year(date_parts.year):\n            max_days_for_month = 29\n        else:\n            max_days_for_month = 28\n    \n    # Check if the extracted day is within the valid range for the specific month.\n    if not (1 <= date_parts.day <= max_days_for_month):\n        return False\n\n    # All validation rules are satisfied.\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise, or if intervals do not intersect.\"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _calculate_intersection(int1, int2):\n        \"\"\"Calculates the intersection of two closed integer intervals.\"\"\"\n        start1, end1 = int1\n        start2, end2 = int2\n\n        max_start = max(start1, start2)\n        min_end = min(end1, end2)\n\n        if max_start > min_end:\n            return None\n        else:\n            return (max_start, min_end)\n\n    def _calculate_length(interval):\n        \"\"\"Calculates the length of a given closed integer interval.\"\"\"\n        start, end = interval\n        return end - start\n\n    intersection_interval = _calculate_intersection(interval1, interval2)\n    \n    if intersection_interval is None:\n        return \"NO\"\n    \n    length = _calculate_length(intersection_interval)\n    \n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes multiplied by the product of signs of integers in an array.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for num in arr:\n        # Determine the sign of the current number (FR1)\n        current_sign = 0\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        \n        # Multiply into the running product of signs (FR2)\n        sign_product *= current_sign\n\n        # Calculate the absolute value (magnitude) and add to sum (FR3)\n        current_magnitude = abs(num)\n        magnitude_sum += current_magnitude\n\n    # Return the product of the sum of magnitudes and the product of signs (FR4)\n    return sign_product * magnitude_sum"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes sum of magnitudes multiplied by product of signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine sign of the current number\n        sign = 0\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n\n        # Determine magnitude of the current number\n        magnitude = abs(num)\n\n        # Update product of signs and sum of magnitudes\n        product_of_signs *= sign\n        sum_of_magnitudes += magnitude\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Calculates the product of odd digits in a positive integer.\n    Returns 0 if no odd digits are found.\"\"\"\n    product = 1\n    found_odd_digit = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n\n    return product if found_odd_digit else 0"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n        temp_n //= 10\n    \n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in a given grid.\n    All helper classes and functions are defined inline as required.\n    \"\"\"\n\n    class Cell:\n        def __init__(self, row: int, col: int, value: int):\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_coords(self) -> tuple[int, int]:\n            return (self._row, self._col)\n\n        def get_value(self) -> int:\n            return self._value\n\n        def get_row(self) -> int:\n            return self._row\n\n        def get_col(self) -> int:\n            return self._col\n\n    class Grid:\n        def __init__(self, grid_data: list[list[int]]):\n            self._N = len(grid_data)\n            self._cells: list[list[Cell]] = []\n            for r in range(self._N):\n                row_cells = []\n                for c in range(self._N):\n                    row_cells.append(Cell(r, c, grid_data[r][c]))\n                self._cells.append(row_cells)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            # Assumes valid coordinates due to critical constraint to trust caller's inputs.\n            return self._cells[row][col]\n\n        def get_neighbors(self, cell: Cell) -> list[Cell]:\n            neighbors = []\n            r, c = cell.get_coords()\n            directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n            N = self._N\n\n            for dr, dc in directions:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < N and 0 <= nc < N:\n                    neighbors.append(self.get_cell(nr, nc))\n            return neighbors\n\n        def get_N(self) -> int:\n            return self._N\n\n    class PathUtils:\n        @staticmethod\n        def is_lexicographically_smaller(path_a: list[int], path_b: list[int]) -> bool:\n            \"\"\"Compares two paths lexicographically. Returns True if path_a is smaller.\"\"\"\n            # Assumes paths have equal length k as per problem statement for final comparison.\n            for val_a, val_b in zip(path_a, path_b):\n                if val_a < val_b:\n                    return True\n                if val_a > val_b:\n                    return False\n            return False # Paths are equal\n\n    class MinPathFinder:\n        def __init__(self, grid_data: list[list[int]]):\n            self.grid_model = Grid(grid_data)\n            self.path_utils = PathUtils()\n            self.N = self.grid_model.get_N()\n\n        def find_min_path(self, k: int) -> list[int]:\n            # No input validation here, critical requirements state to trust caller inputs.\n            \n            # Initialize min_path with a path lexicographically larger than any possible path.\n            max_grid_val = self.N * self.N\n            min_path_container = [max_grid_val + 1] * k \n\n            for r in range(self.N):\n                for c in range(self.N):\n                    start_cell = self.grid_model.get_cell(r, c)\n                    current_path_prefix = [start_cell.get_value()]\n                    self._dfs(start_cell, current_path_prefix, k - 1, min_path_container)\n            \n            return min_path_container\n\n        def _dfs(self, current_cell: Cell, current_path: list[int], remaining_k: int, min_path_container: list[int]) -> None:\n            # Pruning: If the current path prefix is already lexicographically worse than min_path_container.\n            # Compare prefix of current_path with the corresponding prefix of min_path_container.\n            for i in range(len(current_path)):\n                if current_path[i] > min_path_container[i]:\n                    return  # Current path prefix is worse, prune branch.\n                if current_path[i] < min_path_container[i]:\n                    break  # Current path prefix is better, continue exploring this branch.\n\n            if remaining_k == 0:\n                # Base case: Path of length k found. Update min_path_container if current_path is smaller.\n                if self.path_utils.is_lexicographically_smaller(current_path, min_path_container):\n                    min_path_container[:] = current_path  # Update the global min_path_container in place.\n                return\n\n            neighbors = self.grid_model.get_neighbors(current_cell)\n            # Sort neighbors by value to potentially find smaller paths earlier for faster pruning.\n            neighbors.sort(key=lambda cell: cell.get_value()) \n            \n            for neighbor in neighbors:\n                self._dfs(neighbor, current_path + [neighbor.get_value()], remaining_k - 1, min_path_container)\n\n    # Main logic of the minPath function.\n    finder = MinPathFinder(grid)\n    return finder.find_min_path(k)"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[Union[int, float]]:\n    \"\"\"Calculates the Tribonacci sequence up to n.\n    Returns a list of the first n + 1 numbers.\"\"\"\n\n    memo: dict[int, Union[int, float]] = {}\n\n    def _get_term(k: int) -> Union[int, float]:\n        \"\"\"Recursively calculates the k-th Tribonacci term using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        result: Union[int, float]\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # n is even\n            result = 1 + k / 2\n        else:  # n is odd\n            term_k_minus_1 = _get_term(k - 1)\n            term_k_minus_2 = _get_term(k - 2)\n            term_k_plus_1 = _get_term(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        memo[k] = result\n        return result\n\n    sequence: list[Union[int, float]] = []\n    for k in range(n + 1):\n        sequence.append(_get_term(k))\n    return sequence"}
{"task_id": "HumanEval/130", "solution": "from typing import List, Dict\ndef tri(n: int) -> List[int]:\n    \"\"\"Calculates the first n + 1 Tribonacci numbers.\n    Utilizes memoization to efficiently compute terms based on recurrence rules.\"\"\"\n    \n    # The memoization dictionary, local to this `tri` function call.\n    # This ensures that memoization is fresh for each top-level invocation of `tri(n)`.\n    memo: Dict[int, int] = {}\n\n    def _get_tribonacci_term(k: int) -> int:\n        \"\"\"A nested helper function to recursively calculate the k-th Tribonacci term.\"\"\"\n        # Use memoization to avoid redundant computations for already calculated terms.\n        if k in memo:\n            return memo[k]\n\n        # Base cases: tri(0) and tri(1) as per FR1 and FR2.\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        # Recurrence relation for even n > 0 as per FR3.\n        elif k % 2 == 0:\n            result = 1 + k // 2\n        # Recurrence relation for odd n > 1 as per FR4.\n        else: # k is odd and k > 1 implicitly\n            # tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n            result = (\n                _get_tribonacci_term(k - 1)\n                + _get_tribonacci_term(k - 2)\n                + _get_tribonacci_term(k + 1)\n            )\n        \n        memo[k] = result\n        return result\n\n    # Generate the sequence list from tri(0) up to tri(n) as per FR5.\n    # For negative `n`, `range(n + 1)` will produce an empty range, resulting in an empty list.\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_term(i))\n    \n    return sequence"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers in the given list, after rounding each element up to the nearest integer (Ceiling).\"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of squared numbers in the given list,\n    after rounding each element to the upper integer (Ceiling) first.\n    \"\"\"\n    squared_ceiling_numbers = [math.ceil(n) ** 2 for n in lst]\n    return sum(squared_ceiling_numbers)"}
{"task_id": "HumanEval/129", "solution": "class MinPathError(Exception):\n    \"\"\"Base exception for min path finder errors.\"\"\"\n    pass\nclass InvalidGridError(MinPathError):\n    \"\"\"Raised when the grid input is invalid (e.g., not square, N < 2).\"\"\"\n    pass\nclass InvalidPathLengthError(MinPathError):\n    \"\"\"Raised when the path length k is invalid (e.g., not positive).\"\"\"\n    pass\nclass InvalidGridValueError(MinPathError):\n    \"\"\"Raised when grid values are invalid (e.g., not unique, out of range).\"\"\"\n    pass\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\nclass Grid:\n    \"\"\"Manages the 2D grid data, provides access to cell values, and identifies valid neighbors.\"\"\"\n    def __init__(self, data: list[list[int]]):\n        self._data = data\n        self._N = len(data)\n\n    def get_value(self, r: int, c: int) -> int:\n        \"\"\"Returns the value at the specified row and column.\"\"\"\n        return self._data[r][c]\n\n    def get_neighbors(self, r: int, c: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of valid (row, col) tuples for adjacent cells (up, down, left, right).\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < self._N and 0 <= nc < self._N:\n                neighbors.append((nr, nc))\n        return neighbors\n\n    def get_dimensions(self) -> tuple[int, int]:\n        \"\"\"Returns the dimensions of the grid as (N, N).\"\"\"\n        return (self._N, self._N)\n\n    def get_all_cells(self) -> list[Cell]:\n        \"\"\"Returns a list of all Cell objects in the grid.\"\"\"\n        all_cells = []\n        for r in range(self._N):\n            for c in range(self._N):\n                all_cells.append(Cell(r, c, self._data[r][c]))\n        return all_cells\nclass GridValidator:\n    \"\"\"Validates the structure and content of the input grid and the path length k.\"\"\"\n    def validate_grid(self, grid_data: list[list[int]]) -> None:\n        \"\"\"Checks if grid_data is a valid N x N grid with unique values in the range [1, N*N].\"\"\"\n        if not self._is_square(grid_data):\n            raise InvalidGridError(\"Grid must be square and N >= 2.\")\n\n        N = len(grid_data)\n        if not self._has_unique_values_in_range(grid_data, N):\n            raise InvalidGridValueError(f\"Grid values must be unique and in range [1, {N*N}].\")\n\n    def validate_k(self, k: int) -> None:\n        \"\"\"Checks if k is a positive integer.\"\"\"\n        if not isinstance(k, int) or k <= 0:\n            raise InvalidPathLengthError(\"Path length k must be a positive integer.\")\n\n    def _is_square(self, grid_data: list[list[int]]) -> bool:\n        \"\"\"Helper to check if the grid is square and N >= 2.\"\"\"\n        if not isinstance(grid_data, list) or not grid_data:\n            return False\n        N = len(grid_data)\n        if N < 2:\n            return False\n        for row in grid_data:\n            if not isinstance(row, list) or len(row) != N:\n                return False\n            for item in row:\n                if not isinstance(item, int):\n                    return False\n        return True\n\n    def _has_unique_values_in_range(self, grid_data: list[list[int]], N: int) -> bool:\n        \"\"\"Helper to check value constraints.\"\"\"\n        seen_values = set()\n        expected_max = N * N\n        for r in range(N):\n            for c in range(N):\n                val = grid_data[r][c]\n                if not (1 <= val <= expected_max):\n                    return False\n                if val in seen_values:\n                    return False\n                seen_values.add(val)\n        return len(seen_values) == expected_max\nclass MinPathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path of length k.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._k = k\n        self._N = grid.get_dimensions()[0]\n        self._min_lex_path: list[int] | None = None\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Orchestrates the search by iterating through all starting cells and calling the recursive helper.\"\"\"\n        for r in range(self._N):\n            for c in range(self._N):\n                self._find_paths_from_start(r, c, [])\n        \n        if self._min_lex_path is None:\n            raise MinPathError(\"No path of length k found. This should not happen per problem guarantee.\")\n        return self._min_lex_path\n\n    def _find_paths_from_start(self, r: int, c: int, current_path_values: list[int]) -> None:\n        \"\"\"Recursive DFS helper. Explores paths starting from (r, c), compares, and prunes.\"\"\"\n        current_path_values.append(self._grid.get_value(r, c))\n\n        if len(current_path_values) == self._k:\n            if self._min_lex_path is None or self._is_lexicographically_smaller(current_path_values, self._min_lex_path):\n                self._min_lex_path = list(current_path_values) # Store a deep copy.\n            current_path_values.pop() # Backtrack.\n            return\n\n        # Pruning: If current path prefix is already lexicographically greater than known minimum, stop.\n        if self._min_lex_path is not None and current_path_values > self._min_lex_path[:len(current_path_values)]:\n            current_path_values.pop() # Backtrack.\n            return\n\n        for nr, nc in self._grid.get_neighbors(r, c):\n            self._find_paths_from_start(nr, nc, current_path_values)\n        \n        current_path_values.pop() # Backtrack.\n\n    def _is_lexicographically_smaller(self, path_a: list[int], path_b: list[int]) -> bool:\n        \"\"\"Helper to compare two paths lexicographically.\"\"\"\n        return path_a < path_b\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid and a positive integer k, finds the minimum path of length k.\n    \"\"\"\n    validator = GridValidator()\n    validator.validate_grid(grid)\n    validator.validate_k(k)\n\n    grid_obj = Grid(grid)\n    finder = MinPathFinderService(grid_obj, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not part of a word.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    if txt[-2] == ' ':\n        return True\n\n    return False"}
