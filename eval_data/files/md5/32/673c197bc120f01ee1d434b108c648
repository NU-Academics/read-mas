{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube of some integer number.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    '''\n    if a == 0:\n        return True\n\n    # Determine the sign of the input number.\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the cube root of the absolute value, rounding to the nearest integer.\n    cbrt_abs_a = round(abs_a**(1/3))\n\n    # Check if the cube of the integer cube root (with original sign) matches the original number.\n    return (sign * cbrt_abs_a) ** 3 == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if the given integer 'a' is a perfect cube of some integer number.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    cbrt_a_approx = round(abs_a**(1/3))\n\n    return (sign * (cbrt_a_approx ** 3)) == a"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some integer k.\n    \"\"\"\n    if n <= 0:\n        return False\n    if x < 0:\n        return False\n\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    try:\n        k = math.log(x, n)\n        return math.isclose(k, round(k))\n    except ValueError:\n        return False"}
