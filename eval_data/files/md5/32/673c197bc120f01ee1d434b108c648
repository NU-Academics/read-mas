{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the product of exactly three prime numbers.\n    Assumes `a` is an integer less than 100, following problem constraints.\n    \"\"\"\n\n    # Helper function to check if a number is prime.\n    def is_prime(n: int) -> bool:\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    # The smallest product of three primes is 2 * 2 * 2 = 8.\n    if a < 8:\n        return False\n\n    # Generate a list of prime numbers up to the maximum possible factor (99 for a < 100).\n    primes = []\n    for num in range(2, 100):\n        if is_prime(num):\n            primes.append(num)\n\n    n_primes = len(primes)\n    # Iterate through all combinations of three prime numbers (allowing repetition).\n    for i in range(n_primes):\n        p1 = primes[i]\n        # Optimization: If p1 cubed is already greater than 'a', further products will also be greater.\n        if p1 * p1 * p1 > a:\n            break\n        for j in range(i, n_primes): # Start from i to allow p2 = p1\n            p2 = primes[j]\n            # Optimization: If p1 * p2 squared is already greater than 'a', further products will also be greater.\n            if p1 * p2 * p2 > a:\n                break\n            for k in range(j, n_primes): # Start from j to allow p3 = p2\n                p3 = primes[k]\n                product = p1 * p2 * p3\n                if product == a:\n                    return True\n                # Optimization: If the current product is greater than 'a', further p3 (which are larger) will also exceed 'a'.\n                if product > a:\n                    break\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n.\n    Returns True if n^k = x for some non-negative integer k, False otherwise.\n    \"\"\"\n    if x <= 0 or n <= 0:\n        return False\n\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    temp_x = x\n    while temp_x % n == 0:\n        temp_x //= n\n    \n    return temp_x == 1"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"\n    You have been tasked to write a function that receives\n    a hexadecimal number as a string and counts the number of hexadecimal\n    digits that are primes.\n    \"\"\"\n\n    class HexDigitUtil:\n        PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\n        @staticmethod\n        def is_prime_hex_digit(digit: str) -> bool:\n            \"\"\"Checks if a single hexadecimal digit is prime.\"\"\"\n            return digit in HexDigitUtil.PRIME_HEX_DIGITS\n\n    class HexKeyCounter:\n        def count_prime_digits(self, hex_string: str) -> int:\n            \"\"\"Counts prime hexadecimal digits in a string.\"\"\"\n            prime_count = 0\n            for digit in hex_string:\n                if HexDigitUtil.is_prime_hex_digit(digit):\n                    prime_count += 1\n            return prime_count\n\n    counter = HexKeyCounter()\n    return counter.count_prime_digits(num)"}
{"task_id": "HumanEval/75", "solution": "import itertools\ndef is_multiply_prime(a):\n    \"\"\"\n    Checks if 'a' is the product of exactly three distinct prime numbers.\n    Assumes 'a' is an integer between 1 and 99.\n    \"\"\"\n\n    # Helper function: Generates primes up to a limit using a sieve.\n    def _get_primes_up_to(limit: int) -> list[int]:\n        primes = []\n        if limit < 2:\n            return primes\n        # Sieve of Eratosthenes to find primes efficiently.\n        sieve = [True] * (limit + 1)\n        sieve[0] = sieve[1] = False\n        for p in range(2, int(limit**0.5) + 1):\n            if sieve[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    sieve[multiple] = False\n        for p in range(2, limit + 1):\n            if sieve[p]:\n                primes.append(p)\n        return primes\n\n    # The smallest product of three distinct primes is 2 * 3 * 5 = 30.\n    if a < 30:\n        return False\n\n    # Generate all primes up to 'a' as potential factors.\n    primes_list = _get_primes_up_to(a)\n\n    # Iterate through all unique combinations of three distinct primes.\n    for p1, p2, p3 in itertools.combinations(primes_list, 3):\n        if p1 * p2 * p3 == a:\n            return True\n\n    return False"}
