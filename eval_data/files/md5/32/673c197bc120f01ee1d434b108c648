{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(i * xs[i])\n    return derived_coefficients"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {}\ndef fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using memoization.\n    The sequence is defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial, where xs[i] is the coefficient of x^i.\n    This function returns the coefficients of the derivative polynomial in the same format.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(xs[i] * i)\n    return derivative_coeffs"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, treating 'y' as a vowel only if it's the last character.\n    Vowel checks are case-insensitive.\"\"\"\n    vowel_count = 0\n    if not s:\n        return 0\n\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        is_last_char = (i == len(s) - 1)\n\n        if lower_char in standard_vowels:\n            vowel_count += 1\n        elif lower_char == 'y' and is_last_char:\n            vowel_count += 1\n    return vowel_count"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {0: 0, 1: 0, 2: 1}\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence. This function computes the n-th element efficiently using memoization.\"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/64", "solution": "STANDARD_VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef vowels_count(s):\n    \"\"\"Counts vowels in a word, including 'y' only if it's the last character.\n    Vowels ('a', 'e', 'i', 'o', 'u') are counted case-insensitively.\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in STANDARD_VOWELS:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of integer x right by shift.\n    If shift exceeds number of digits, return digits reversed.\n    \"\"\"\n    x_str = str(x)\n    num_digits = len(x_str)\n\n    if shift > num_digits:\n        return x_str[::-1]\n    else:\n        effective_shift = shift % num_digits\n        return x_str[num_digits - effective_shift:] + x_str[:num_digits - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII codes for uppercase characters in a string.\n    Only characters from 'A' to 'Z' are considered uppercase.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circularly shifts the digits of an integer x to the right.\n    If shift > number of digits, the digits are reversed.\n    \"\"\"\n    is_negative = x < 0\n    x_abs_str = str(abs(x))\n    num_digits = len(x_abs_str)\n\n    shifted_str = \"\"\n    # Handle the case where the absolute value string might be empty, setting to \"0\".\n    if num_digits == 0:\n        shifted_str = \"0\"\n    elif shift > num_digits:\n        shifted_str = x_abs_str[::-1]  # Reverse the digits.\n    else:\n        effective_shift = shift % num_digits\n        shifted_str = x_abs_str[-effective_shift:] + x_abs_str[:-effective_shift]\n\n    if is_negative:\n        return \"-\" + shifted_str\n    return shifted_str"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    It parses apple and orange counts from a string and subtracts them from the total.\n    \"\"\"\n    counts_str = re.findall(r'\\d+', s)\n    \n    apples = int(counts_str[0])\n    oranges = int(counts_str[1])\n    \n    mangoes = n - apples - oranges\n    \n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node in an array, prioritizing smaller indices for ties.\n    Returns the node as [value, index] or an empty list if no even values or an empty array.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                smallest_even_index = i\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node in an array, breaking ties by smallest index.\n    Returns [value, index] or an empty list if no even values are found.\n    \"\"\"\n    if not arr:\n        return []\n\n    # Initialize to None; will store [value, index] of the best candidate.\n    smallest_even_node = None\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the current value is even.\n            if smallest_even_node is None:\n                # This is the first even number found.\n                smallest_even_node = [value, index]\n            elif value < smallest_even_node[0]:\n                # Found a smaller even number.\n                smallest_even_node = [value, index]\n            elif value == smallest_even_node[0] and index < smallest_even_node[1]:\n                # Same smallest even value, but with a smaller index.\n                smallest_even_node = [value, index]\n\n    # Return the identified node or an empty list if none was found.\n    return smallest_even_node if smallest_even_node is not None else []"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n\n    while left <= right:\n        # Append minimum\n        result.append(sorted_lst[left])\n        left += 1\n        if left > right:\n            break\n\n        # Append maximum\n        result.append(sorted_lst[right])\n        right -= 1\n    return result"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    Returns the greatest integer that is greater than zero, and has a frequency\n    greater than or equal to the value of the integer itself. If no such a value exists, return -1.\n    '''\n    freq_map = {}\n    for num in lst:\n        freq_map[num] = freq_map.get(num, 0) + 1\n\n    candidates = []\n    for num, freq in freq_map.items():\n        if freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n    else:\n        return max(candidates)"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Returns the greatest integer that is greater than zero and has a frequency greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n    \n    candidates = []\n    for num, freq in frequencies.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n    \n    if candidates:\n        return max(candidates)\n    else:\n        return -1"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    This function parses apple and orange counts from a string and subtracts them from the total fruits.\n    \"\"\"\n    apple_pattern = r\"(\\d+)\\s*apples\"\n    orange_pattern = r\"(\\d+)\\s*oranges\"\n\n    apple_match = re.search(apple_pattern, s)\n    apples = int(apple_match.group(1))\n\n    orange_match = re.search(orange_pattern, s)\n    oranges = int(orange_match.group(1))\n\n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given a list of integers, return a new list sorted in a strange alternating minimum-maximum order.\n    It starts by taking the minimum, then the maximum of remaining elements, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    working_list = sorted(lst)\n    result = []\n\n    left = 0\n    right = len(working_list) - 1\n    toggle = True # True for min, False for max\n\n    while left <= right:\n        if toggle:\n            result.append(working_list[left])\n            left += 1\n        else:\n            result.append(working_list[right])\n            right -= 1\n        toggle = not toggle\n    \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given three side lengths, calculate the triangle's area rounded to 2 decimal points.\n    Returns -1.0 if the sides do not form a valid triangle.\n    \"\"\"\n    # Validate if all sides are positive and satisfy the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and \\\n            a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area_raw = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Round the calculated area to two decimal places.\n    return round(area_raw, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    '''\n    # Validate for positive side lengths and the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and\n            (a + b > c) and (a + c > b) and (b + c > a)):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Return the area rounded to two decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    '''\n    Checks if object q will fly based on balance (palindrome) and total weight <= w.\n    Returns True if both conditions are met, False otherwise.\n    '''\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    \n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Find the minimum number of changes to make an array palindromic.\n    A change involves altering one element to any other value.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    changes_count = 0\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
