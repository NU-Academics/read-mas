{"task_id": "HumanEval/82", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\n    It uses an optimized trial division algorithm.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Checks if the length of a string is a prime number.\n    It determines if the string's length meets the primality criteria.\"\"\"\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Applies the principle of inclusion-exclusion:\n        # (Starts with 1) + (Ends with 1) - (Starts with 1 AND Ends with 1)\n        # For n > 1, this simplifies to 18 * 10^(n-2).\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The sum of N's decimal digits is computed and then converted to a binary string.\n    \"\"\"\n    digit_sum = 0\n    # Process N to sum its decimal digits.\n    # This loop correctly handles N=0, resulting in digit_sum = 0.\n    temp_N = N\n    while temp_N > 0:\n        digit_sum += temp_N % 10\n        temp_N //= 10\n\n    # Convert the calculated decimal sum to its binary string representation.\n    # An explicit check for sum=0 is needed because bin(0) is \"0b0\".\n    if digit_sum == 0:\n        return \"0\"\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n\n    # Calculate count of n-digit numbers that start with 1.\n    # For n=1, it's just the number 1. Otherwise, 1 followed by (n-1) digits (0-9).\n    if n == 1:\n        starts_with_one = 1\n    else:\n        starts_with_one = 10**(n - 1)\n\n    # Calculate count of n-digit numbers that end with 1.\n    # For n=1, it's the number 1. For n>=2, the first digit can be 1-9 (9 options)\n    # and the (n-2) middle digits can be 0-9 (10 options each).\n    if n == 1:\n        ends_with_one = 1\n    elif n == 0: # This case should not occur based on problem statement (\"positive integer n\")\n        ends_with_one = 0\n    else: # n >= 2\n        ends_with_one = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers that start AND end with 1.\n    # For n=1, it's the number 1. For n>=2, 1 followed by (n-2) digits (0-9) then 1.\n    if n == 1:\n        starts_and_ends_with_one = 1\n    elif n < 2: # This case should not occur for n=0 based on problem statement. If n=0, result 0.\n        starts_and_ends_with_one = 0\n    else: # n >= 2\n        starts_and_ends_with_one = 10**(n - 2)\n    \n    # Apply the principle of inclusion-exclusion to get the total count.\n    total_count = starts_with_one + ends_with_one - starts_and_ends_with_one\n    \n    return total_count"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"\n    Converts a list of numerical GPAs to a list of letter grades.\n    \"\"\"\n    # The grading scale defined in the specification, adjusted for '0.0: E' rule.\n    GRADES_SCALE = [\n        (4.0, \"A+\"),\n        (3.7, \"A\"),\n        (3.3, \"A-\"),\n        (3.0, \"B+\"),\n        (2.7, \"B\"),\n        (2.3, \"B-\"),\n        (2.0, \"C+\"),\n        (1.7, \"C\"),\n        (1.3, \"C-\"),\n        (1.0, \"D+\"),\n        (0.7, \"D\"),\n        (0.000001, \"D-\"),  # Represents GPAs strictly greater than 0.0\n        (0.0, \"E\"),        # For a GPA of exactly 0.0\n        (-0.1, \"E\")        # Sentinel for any GPA below 0.0\n    ]\n\n    converted_grades = []\n    for gpa in grades:\n        for threshold, letter_grade in GRADES_SCALE:\n            if gpa >= threshold:\n                converted_grades.append(letter_grade)\n                break\n    return converted_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The sum of N's decimal digits is computed and then converted to a binary string.\n    \"\"\"\n    \n    total_sum = 0\n    # Calculate the sum of decimal digits.\n    # The design includes an explicit check for N=0 for digit summation.\n    if N == 0:\n        total_sum = 0\n    else:\n        temp_N = N\n        while temp_N > 0:\n            total_sum += temp_N % 10\n            temp_N //= 10\n            \n    # Convert the calculated sum into its binary string representation.\n    # The design includes an explicit check for sum=0 for binary conversion.\n    if total_sum == 0:\n        return \"0\"\n    return bin(total_sum)[2:]"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into corresponding letter grades.\n    Adheres strictly to the provided grading scale for all conversions.\"\"\"\n    \n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        elif gpa == 0.0:\n            letter_grades.append(\"E\")\n        # Trusting caller's input based on requirements, GPAs are within [0.0, 4.0].\n    return letter_grades"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 != 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
