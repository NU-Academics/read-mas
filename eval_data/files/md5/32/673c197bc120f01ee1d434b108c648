{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    common_list = list(common_set)\n    common_list.sort()\n    return common_list"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"\n    Return True if list elements are monotonically increasing or decreasing.\n    This includes non-decreasing and non-increasing sequences.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    # Handles empty lists and single-element lists as monotonic (FR6, FR7).\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:  # Checks for non-decreasing trend (BR1).\n            is_increasing = False\n            break\n\n    is_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:  # Checks for non-increasing trend (BR2).\n            is_decreasing = False\n            break\n\n    # Returns True if either trend is found, False otherwise (FR4, FR5).\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/59", "solution": "import math\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2 to efficiently remove all factors of 2.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd numbers as potential prime factors up to sqrt(n).\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n\n    # If n is still greater than 2, the remaining n is a prime factor.\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
