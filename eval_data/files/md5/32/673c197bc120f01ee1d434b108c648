{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold. Returns True if such a pair exists, False otherwise.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sorting allows for checking only adjacent elements, achieving O(N log N) complexity.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n - 1):\n        if abs(sorted_numbers[i] - sorted_numbers[i+1]) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    A new list with the delimeter interspersed is returned.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    >>> intersperse([10], 5)\n    [10]\n    \"\"\"\n    if not numbers:\n        return []\n    \n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates distinct, balanced, non-nested groups of parentheses from a string.\n    Raises ValueError for malformed inputs like unbalanced parentheses or invalid characters.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    if not cleaned_string:\n        return []\n\n    groups: List[str] = []\n    current_group_start = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        else:\n            raise ValueError(f\"Invalid character '{char}' found in input string.\")\n\n        if balance < 0:\n            raise ValueError(\"Malformed input: Unbalanced parentheses (too many closing parentheses).\")\n\n        if balance == 0 and current_group_start <= i:\n            # Found a complete, balanced group\n            groups.append(cleaned_string[current_group_start : i + 1])\n            current_group_start = i + 1\n    \n    if balance != 0:\n        raise ValueError(\"Malformed input: Unbalanced parentheses (unclosed opening parentheses).\")\n\n    return groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    \n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    groups = []\n    balance = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # This condition extracts a complete, balanced group and moves the start_index.\n        if balance == 0 and i >= start_index:\n            group = cleaned_string[start_index : i + 1]\n            if group:\n                groups.append(group)\n            start_index = i + 1\n        # Discard the unbalanced part and restart the search for a new group.\n        elif balance < 0:\n            balance = 0 \n            start_index = i + 1 \n    \n    return groups"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD is the average absolute difference between each element and the mean.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # Calculate the mean of the dataset.\n    mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute differences from the mean for each number.\n    absolute_differences = [abs(x - mean) for x in numbers]\n\n    # Calculate the average of these absolute differences to get the MAD.\n    return sum(absolute_differences) / len(numbers)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the mean of the dataset directly within this function.\n    mean_val = sum(numbers) / len(numbers)\n\n    # Calculate the absolute differences from the mean for each number.\n    absolute_differences = [abs(x - mean_val) for x in numbers]\n\n    # Calculate the mean of these absolute differences.\n    mad_value = sum(absolute_differences) / len(numbers)\n\n    return mad_value"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns a new list with the delimeter interspersed.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sort the list to enable O(n log n) performance for proximity checks.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n - 1):\n        # Use <= to satisfy business rule 5.2 for threshold=0.\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) <= threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    This preserves the order of matching strings from the input list.\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    \n    groups = [g for g in paren_string.split(' ') if g]\n    results = []\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        results.append(max_depth)\n        \n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    def _calculate_max_depth(group: str) -> int:\n        \"\"\"Calculates the deepest level of nesting for a single group of parentheses.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string:\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group:\n            results.append(_calculate_max_depth(group))\n    return results"}
