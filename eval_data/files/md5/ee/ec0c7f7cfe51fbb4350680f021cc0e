{"task_id": "Mbpp/593", "solution": "```python\nfrom typing import List\n\nclass Octet:\n    \"\"\"\n    Encapsulates a single IP address octet, handling its parsing,\n    validation, and leading zero removal.\n    \"\"\"\n    def __init__(self, value_str: str):\n        self._original_value: str = value_str\n        try:\n            numeric_value = int(value_str)\n        except ValueError:\n            raise ValueError(f\"Octet '{value_str}' is not a valid number.\")\n\n        if not (0 <= numeric_value <= 255):\n            raise ValueError(f\"Octet value {numeric_value} is out of range (0-255).\")\n\n        self._numeric_value: int = numeric_value\n\n    def remove_leading_zeros(self) -> str:\n        \"\"\"Returns the octet string with leading zeros removed.\"\"\"\n        return str(self._numeric_value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the octet is numerically valid (0-255).\"\"\"\n        # This validation is performed during initialization.\n        return True\n\nclass IPAddress:\n    \"\"\"\n    Encapsulates an IPv4 address, managing its structure,\n    validation, and orchestrating octet processing.\n    \"\"\"\n    def __init__(self, ip_address_str: str):\n        self._original_value: str = ip_address_str\n        parts = ip_address_str.split('.')\n\n        if len(parts) != 4:\n            raise ValueError(f\"Invalid IPv4 format: '{ip_address_str}'. Expected 4 octets.\")\n\n        self._octets: List[Octet] = []\n        for part in parts:\n            try:\n                self._octets.append(Octet(part))\n            except ValueError as e:\n                raise ValueError(f\"Invalid octet in IP address '{ip_address_str}': {e}\") from e\n\n    def remove_leading_zeros(self) -> str:\n        \"\"\"Removes leading zeros from each octet and returns the modified IP string.\"\"\"\n        processed_octets = [octet.remove_leading_zeros() for octet in self._octets]\n        return \".\".join(processed_octets)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the overall IP address string is a valid IPv4 format.\"\"\"\n        # This validation is primarily performed during initialization.\n        return True\n\ndef removezero_ip(ip_address_str: str) -> str:\n    \"\"\"\n    Removes leading zeros from an IP address string.\n    Raises ValueError for invalid IP address formats.\n    \"\"\"\n    ip_address_obj = IPAddress(ip_address_str)\n    return ip_address_obj.remove_leading_zeros()\n```"}
{"task_id": "Mbpp/589", "solution": "def perfect_squares(num1, num2):\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive).\n    It efficiently determines the range of integers whose squares fall within the specified bounds.\n    \"\"\"\n    squares = []\n\n    # Calculate the smallest integer 'i' whose square is greater than or equal to num1.\n    # Start checking from this 'i'.\n    i = int(num1**0.5)\n    if i * i < num1:\n        i += 1\n\n    # Iterate, adding perfect squares to the list, until the square exceeds num2.\n    while i * i <= num2:\n        squares.append(i * i)\n        i += 1\n\n    return squares"}
{"task_id": "Mbpp/594", "solution": "```python\nfrom typing import List\n\nclass Integer:\n    \"\"\"\n    Represents an integer value and provides parity checks.\n    \"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the integer is even.\"\"\"\n        return self._value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the integer is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer's value.\"\"\"\n        return self._value\n\nclass IntegerList:\n    \"\"\"\n    Manages a list of Integer objects and finds the first even or odd.\n    \"\"\"\n    def __init__(self, values: List[int]):\n        self._numbers: List[Integer] = [Integer(val) for val in values]\n\n    def find_first_even(self) -> Integer:\n        \"\"\"Finds and returns the first even Integer object in the list.\"\"\"\n        for number_obj in self._numbers:\n            if number_obj.is_even():\n                return number_obj\n        # Non-functional requirements guarantee an even number is always present.\n\n    def find_first_odd(self) -> Integer:\n        \"\"\"Finds and returns the first odd Integer object in the list.\"\"\"\n        for number_obj in self._numbers:\n            if number_obj.is_odd():\n                return number_obj\n        # Non-functional requirements guarantee an odd number is always present.\n\n\nclass DifferenceCalculator:\n    \"\"\"\n    Calculates the absolute difference between the first even and first odd numbers from an IntegerList.\n    \"\"\"\n    def calculate(self, integer_list: IntegerList) -> int:\n        \"\"\"\n        Computes the absolute difference between the first even and first odd number found in the IntegerList.\n        \"\"\"\n        first_even_obj = integer_list.find_first_even()\n        first_odd_obj = integer_list.find_first_odd()\n\n        even_val = first_even_obj.get_value()\n        odd_val = first_odd_obj.get_value()\n\n        return abs(even_val - odd_val)\n\n\ndef diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the absolute difference between the first even and first odd number\n    in a list of integers, using a modular design.\n    \"\"\"\n    integer_list = IntegerList(numbers)\n    calculator = DifferenceCalculator()\n    result = calculator.calculate(integer_list)\n    return result\n```"}
{"task_id": "Mbpp/597", "solution": "from typing import List, TypeVar, Union\n\n# Define a type variable for comparable elements\nComparable = TypeVar('Comparable', bound=Union[int, float, str])\n\ndef find_kth(array1: List[Comparable], array2: List[Comparable], k: int) -> Comparable:\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays.\n    Assumes k is 1-indexed and within the combined length of the arrays.\n    \"\"\"\n    idx1, idx2 = 0, 0\n    # Iterate k-1 times to advance pointers past the elements smaller than the k-th.\n    for _ in range(k - 1):\n        if idx1 < len(array1) and (idx2 >= len(array2) or array1[idx1] <= array2[idx2]):\n            idx1 += 1\n        elif idx2 < len(array2):\n            idx2 += 1\n\n    # After the loop, the k-th element is at the current position of one of the pointers.\n    if idx1 == len(array1):\n        return array2[idx2]\n    if idx2 == len(array2):\n        return array1[idx1]\n    return min(array1[idx1], array2[idx2])"}
{"task_id": "Mbpp/598", "solution": "```python\ndef armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if the given integer is an Armstrong number.\n    Returns True if the number is an Armstrong number, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n\n    return sum_of_powers == number\n```"}
{"task_id": "Mbpp/597", "solution": "```python\ndef find_kth(array1: list[int], array2: list[int], k: int) -> int:\n    \"\"\"Finds the kth smallest element from two sorted arrays.\n    Uses a binary search approach to achieve optimal time complexity.\n    \"\"\"\n    # Ensure array1 is the shorter array to optimize binary search range.\n    if len(array1) > len(array2):\n        array1, array2 = array2, array1\n\n    m, n = len(array1), len(array2)\n\n    # Define the binary search range for `mid1`, the number of elements taken from array1.\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        mid1 = (low + high) // 2  # Number of elements to take from array1\n        mid2 = k - mid1           # Number of elements to take from array2\n\n        # Initialize boundary elements with sentinel values for correct comparisons.\n        L1 = float('-inf') if mid1 == 0 else array1[mid1 - 1]\n        R1 = float('inf') if mid1 == m else array1[mid1]\n        L2 = float('-inf') if mid2 == 0 else array2[mid2 - 1]\n        R2 = float('inf') if mid2 == n else array2[mid2]\n\n        # Check if the current partition is valid, meaning the kth element is found.\n        if L1 <= R2 and L2 <= R1:\n            return max(L1, L2)\n        elif L1 > R2:\n            # If L1 is greater than R2, too many elements are taken from array1.\n            high = mid1 - 1\n        else:  # L2 > R1\n            # If L2 is greater than R1, too few elements are taken from array1.\n            low = mid1 + 1\n\n    # This line should not be reached under valid constraints of k and array lengths.\n    return -1\n```"}
