{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef _get_divisor_count(number: int) -> int:\n    \"\"\"Calculates the total count of divisors for a given positive integer.\n    It efficiently iterates up to the square root of the number.\"\"\"\n    count = 0\n    if number == 0:\n        return 0 # Or handle based on specific problem definition for 0\n    # For a positive integer, iterate up to its square root.\n    for i in range(1, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n    return count\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"Checks whether the count of divisors is even.\n    Returns True if the count of divisors is even, False otherwise.\"\"\"\n    divisor_count = _get_divisor_count(number)\n    return divisor_count % 2 == 0\n```"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums from a given list of tuples.\n    Each resulting tuple is the sum of corresponding elements of two distinct tuples.\n    \"\"\"\n    result = []\n    # Generate all unique pairs of tuples from the input list.\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        # Sum the corresponding elements of the two tuples.\n        sum_first = t1[0] + t2[0]\n        sum_second = t1[1] + t2[1]\n        # Append the new sum tuple to the result list.\n        result.append((sum_first, sum_second))\n    return result"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays in the given array.\n    Args: arr: A list of integers. Returns: The total sum of all elements from all odd-length subarrays.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):  # Start index\n        for j in range(i, n):  # End index\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:  # Check if odd length\n                total_sum += sum(subarray)\n    return total_sum\n```"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"Calculates unique combinations of sums of pairs of tuples from a list.\n    Returns a list of resulting sum tuples.\"\"\"\n    result = []\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple_a = tuple_list[i]\n            tuple_b = tuple_list[j]\n\n            first_element_sum = tuple_a[0] + tuple_b[0]\n            second_element_sum = tuple_a[1] + tuple_b[1]\n\n            result.append((first_element_sum, second_element_sum))\n    return result"}
{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef _get_divisors(n: int) -> list[int]:\n    \"\"\"\n    Calculates all positive divisors of a given integer n.\n    Precondition: n is a positive integer.\n    \"\"\"\n    divs = set()\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return sorted(list(divs))\n\ndef _get_divisor_count(divisors: list[int]) -> int:\n    \"\"\"\n    Counts the number of divisors from a given list.\n    Precondition: divisors is a list of integers.\n    \"\"\"\n    return len(divisors)\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Determines if the count of divisors for n is even.\n    Precondition: n is a positive integer.\n    \"\"\"\n    divs = _get_divisors(n)\n    count = _get_divisor_count(divs)\n    return count % 2 == 0\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef _is_odd(number: int) -> bool:\n    \"\"\"Checks if a given integer is odd.\"\"\"\n    return number % 2 != 0\n\ndef _is_even(number: int) -> bool:\n    \"\"\"Checks if a given integer is even.\"\"\"\n    return number % 2 == 0\n\ndef _find_first_odd(numbers: list) -> int | None:\n    \"\"\"Finds the first odd number in a list of integers.\"\"\"\n    for num in numbers:\n        if _is_odd(num):\n            return num\n    return None\n\ndef _find_first_even(numbers: list) -> int | None:\n    \"\"\"Finds the first even number in a list of integers.\"\"\"\n    for num in numbers:\n        if _is_even(num):\n            return num\n    return None\n\ndef mul_even_odd(input_list: list) -> int:\n    \"\"\"Calculates the product of the first even and first odd number found in a list.\n    It orchestrates the identification of these numbers and their subsequent multiplication.\"\"\"\n    first_odd = _find_first_odd(input_list)\n    first_even = _find_first_even(input_list)\n    # As per design, assuming valid inputs where both first_odd and first_even exist.\n    return first_odd * first_even\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef is_odd(number: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return number % 2 != 0\n\ndef is_even(number: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\n\ndef find_first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Finds the first odd number in a list.\"\"\"\n    for num in numbers:\n        if is_odd(num):\n            return num\n    return None\n\ndef find_first_even(numbers: list[int]) -> int | None:\n    \"\"\"Finds the first even number in a list.\"\"\"\n    for num in numbers:\n        if is_even(num):\n            return num\n    return None\n\ndef mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Calculates the product of the first even and first odd numbers found in a list.\n    Returns None if either number is not found.\n    \"\"\"\n    first_odd = find_first_odd(numbers)\n    first_even = find_first_even(numbers)\n\n    if first_odd is not None and first_even is not None:\n        return first_odd * first_even\n    else:\n        return None\n```"}
{"task_id": "Mbpp/785", "solution": "```python\ndef tuple_str_int(input_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple of integers into an actual tuple of integers.\n    It parses the string by removing parentheses, splitting by commas, and converting elements to integers.\n    \"\"\"\n    cleaned_string = input_string.strip()\n    content = cleaned_string[1:-1].strip()\n\n    if not content:\n        return ()\n\n    elements = [int(item_str.strip()) for item_str in content.split(',')]\n    return tuple(elements)\n```"}
{"task_id": "Mbpp/786", "solution": "```python\ndef right_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the rightmost insertion point for a value in a sorted list.\n    Ensures all elements before the index are less than or equal to the value, and all at or after are strictly greater.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
