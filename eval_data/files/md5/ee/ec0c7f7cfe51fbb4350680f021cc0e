{"task_id": "Mbpp/12", "solution": "```python\nfrom typing import List\n\ndef sort_matrix(input_matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a matrix by the ascending sum of its rows.\n    This function encapsulates Row and Matrix class logic internally.\n    \"\"\"\n\n    class Row:\n        \"\"\"Encapsulates a single row, its elements, and its sum.\"\"\"\n        def __init__(self, elements: List[int]):\n            self._elements = elements\n            self._row_sum = self.calculate_sum()\n\n        def calculate_sum(self) -> int:\n            \"\"\"Calculates and stores the sum of row elements.\"\"\"\n            return sum(self._elements)\n\n        def get_elements(self) -> List[int]:\n            \"\"\"Returns the list of elements for this row.\"\"\"\n            return self._elements\n\n        def get_row_sum(self) -> int:\n            \"\"\"Returns the pre-calculated sum of the row's elements.\"\"\"\n            return self._row_sum\n\n    class Matrix:\n        \"\"\"Encapsulates the entire matrix and provides sorting functionality.\"\"\"\n        def __init__(self, input_matrix: List[List[int]]):\n            self._rows: List[Row] = []\n            for row_elements in input_matrix:\n                self._rows.append(Row(row_elements))\n\n        def sort_rows_by_sum(self) -> None:\n            \"\"\"Sorts the internal list of Row objects based on their sum.\"\"\"\n            self._rows.sort(key=lambda row_obj: row_obj.get_row_sum())\n\n        def get_sorted_matrix(self) -> List[List[int]]:\n            \"\"\"Returns the elements of the sorted rows as a list of lists of integers.\"\"\"\n            sorted_matrix_data: List[List[int]] = []\n            for row_obj in self._rows:\n                sorted_matrix_data.append(row_obj.get_elements())\n            return sorted_matrix_data\n\n    # Main logic for sort_matrix function\n    matrix_obj = Matrix(input_matrix)\n    matrix_obj.sort_rows_by_sum()\n    return matrix_obj.get_sorted_matrix()\n```"}
{"task_id": "Mbpp/56", "solution": "```python\ndef _reverse_integer(number: int) -> int:\n    \"\"\"Reverses the digits of an integer, preserving its sign and handling trailing zeros.\n    For example, _reverse_integer(70) returns 7, and _reverse_integer(-123) returns -321.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    is_negative = number < 0\n    abs_num = abs(number)\n\n    # Convert to string, reverse, convert back to int.\n    reversed_abs_str = str(abs_num)[::-1]\n    reversed_abs_num = int(reversed_abs_str)\n\n    return -reversed_abs_num if is_negative else reversed_abs_num\n\ndef check(number: int) -> bool:\n    \"\"\"Determines if the given integer is one less than twice its reverse.\n    It utilizes an internal helper function to perform the digit reversal.\n    \"\"\"\n    reversed_number = _reverse_integer(number)\n    return number == (2 * reversed_number) - 1\n```"}
{"task_id": "Mbpp/57", "solution": "```python\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"Arranges a list of digits to form the largest possible number.\n    Uses a custom comparison to sort digits for maximal concatenation.\"\"\"\n\n    str_digits = [str(d) for d in digits]\n\n    # Custom sort for the largest number: compare 'a+b' vs 'b+a'.\n    n = len(str_digits)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if str_digits[j] + str_digits[i] > str_digits[i] + str_digits[j]:\n                str_digits[i], str_digits[j] = str_digits[j], str_digits[i]\n\n    # Join the sorted digit strings and convert to an integer.\n    # If the input list is empty, \"\".join([]) results in \"\", which int(\"\") would error.\n    # Per instructions, trust caller's input, assuming non-empty for number formation.\n    return int(\"\".join(str_digits))\n\n```"}
{"task_id": "Mbpp/58", "solution": "```python\ndef opposite_Signs(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two given integers, num1 and num2, have opposite signs.\n    Returns True if one is positive and the other negative; False otherwise (including zeros).\n    \"\"\"\n    # Return False if either number is zero, as specified in FR8 and FR9.\n    if num1 == 0 or num2 == 0:\n        return False\n\n    # Check if their product is negative, which indicates opposite signs (FR4, FR5).\n    return (num1 * num2) < 0\n```"}
{"task_id": "Mbpp/57", "solution": "```python\ndef find_Max_Num(input_digits: list[int]) -> int:\n    \"\"\"\n    Forms the largest possible number from a given list of digits.\n    Sorts digits as strings using a custom comparison, then concatenates and converts to an integer.\n    \"\"\"\n    # Convert all digits to strings for comparison and concatenation.\n    string_digits = [str(digit) for digit in input_digits]\n\n    n = len(string_digits)\n    # Use a bubble-sort like approach with custom comparison logic.\n    for i in range(n):\n        for j in range(i + 1, n):\n            # If string_digits[j] followed by string_digits[i] forms a larger number\n            # than string_digits[i] followed by string_digits[j], swap them.\n            if string_digits[j] + string_digits[i] > string_digits[i] + string_digits[j]:\n                string_digits[i], string_digits[j] = string_digits[j], string_digits[i]\n\n    # Concatenate the sorted digit strings to form the largest number string.\n    largest_number_str = \"\".join(string_digits)\n\n    # Convert the resulting string to an integer. Handles leading zeros correctly (e.g., \"000\" becomes 0).\n    return int(largest_number_str)\n```"}
