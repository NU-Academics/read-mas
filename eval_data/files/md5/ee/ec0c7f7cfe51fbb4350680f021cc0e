{"task_id": "Mbpp/721", "solution": "```python\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from top-left to bottom-right\n    in a given square matrix, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n\n    # Determine the search range for binary search using min/max cell costs.\n    min_cost = float('inf')\n    max_cost = float('-inf')\n    for r in range(N):\n        for c in range(N):\n            min_cost = min(min_cost, matrix[r][c])\n            max_cost = max(max_cost, matrix[r][c])\n\n    low = float(min_cost)\n    high = float(max_cost)\n\n    # Helper function to check if a path with average 'target_avg' or higher exists.\n    def _check(target_avg: float) -> bool:\n        dp_transformed_sum = [[0.0] * N for _ in range(N)]\n\n        # Base case: cost of the starting cell adjusted by target_avg.\n        dp_transformed_sum[0][0] = matrix[0][0] - target_avg\n\n        # Fill the first row.\n        for j in range(1, N):\n            dp_transformed_sum[0][j] = dp_transformed_sum[0][j-1] + (matrix[0][j] - target_avg)\n\n        # Fill the first column.\n        for i in range(1, N):\n            dp_transformed_sum[i][0] = dp_transformed_sum[i-1][0] + (matrix[i][0] - target_avg)\n\n        # Fill the rest of the DP table using dynamic programming.\n        for i in range(1, N):\n            for j in range(1, N):\n                val_adjusted = matrix[i][j] - target_avg\n                dp_transformed_sum[i][j] = max(dp_transformed_sum[i-1][j], dp_transformed_sum[i][j-1]) + val_adjusted\n\n        # If the maximum transformed sum at the bottom-right cell is non-negative,\n        # it means a path with an average of 'target_avg' or higher is achievable.\n        return dp_transformed_sum[N-1][N-1] >= 0\n\n    # Perform binary search for a fixed number of iterations to achieve desired precision.\n    for _ in range(100):  # 100 iterations typically sufficient for float precision.\n        mid = (low + high) / 2\n        if _check(mid):\n            low = mid\n        else:\n            high = mid\n\n    return low\n```"}
{"task_id": "Mbpp/731", "solution": "```python\nimport math\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    The formula used is pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area\n```"}
{"task_id": "Mbpp/721", "solution": "```python\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.column = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"Manages the grid of cells, providing access and validation.\"\"\"\n    def __init__(self, matrix_data: list[list[float]]):\n        self.N = len(matrix_data)\n        self.cells: list[list[Cell]] = []\n        for r_idx, row_data in enumerate(matrix_data):\n            row_cells = []\n            for c_idx, cost_val in enumerate(row_data):\n                row_cells.append(Cell(r_idx, c_idx, cost_val))\n            self.cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a cell at the specified row and column.\"\"\"\n        return self.cells[row][col]\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within matrix bounds.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\n\nclass Path:\n    \"\"\"Represents a sequence of cells forming a path and its metrics.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self.sequence_of_cells: list[Cell] = [initial_cell]\n        self.total_cost: float = initial_cell.cost\n        self.number_of_cells: int = 1\n        self.average_cost: float = initial_cell.cost\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Adds a cell to the path sequence and updates raw metrics.\"\"\"\n        self.sequence_of_cells.append(cell)\n        self.total_cost += cell.cost\n        self.number_of_cells += 1\n\n    def calculate_metrics(self):\n        \"\"\"Computes the average cost based on the current path sequence.\"\"\"\n        if self.number_of_cells > 0:\n            self.average_cost = self.total_cost / self.number_of_cells\n        else:\n            self.average_cost = 0.0\n\nclass PathFinder:\n    \"\"\"Finds all valid paths in a matrix and identifies the maximum average path.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n        self._all_valid_paths: list[Path] = []\n        self._max_average_path: Path | None = None\n        self._max_average_cost: float = -1.0\n\n    def find_all_valid_paths(self) -> list[Path]:\n        \"\"\"Initiates DFS to find all valid paths from start to end.\"\"\"\n        start_cell = self._matrix.get_cell(0, 0)\n        initial_path = Path(start_cell)\n        self._dfs_find_paths(0, 0, initial_path)\n        return self._all_valid_paths\n\n    def _dfs_find_paths(self, row: int, col: int, current_path: Path):\n        \"\"\"Recursively explores paths using Depth-First Search, copying paths for branching.\"\"\"\n        if row == self._matrix.N - 1 and col == self._matrix.N - 1:\n            current_path.calculate_metrics()\n            self._all_valid_paths.append(current_path)\n            if current_path.average_cost > self._max_average_cost:\n                self._max_average_cost = current_path.average_cost\n                self._max_average_path = current_path\n            return\n\n        def create_path_copy_and_add_cell(base_path: Path, new_cell: Cell) -> Path:\n            \"\"\"Creates a new path by copying an existing one and appending a new cell.\"\"\"\n            new_path = Path(base_path.sequence_of_cells[0])\n            for cell_in_seq in base_path.sequence_of_cells[1:]:\n                new_path.add_cell(cell_in_seq)\n            new_path.add_cell(new_cell)\n            return new_path\n\n        # Move right\n        if self._matrix.is_valid_coordinate(row, col + 1):\n            next_cell_right = self._matrix.get_cell(row, col + 1)\n            new_path_right = create_path_copy_and_add_cell(current_path, next_cell_right)\n            self._dfs_find_paths(row, col + 1, new_path_right)\n\n        # Move down\n        if self._matrix.is_valid_coordinate(row + 1, col):\n            next_cell_down = self._matrix.get_cell(row + 1, col)\n            new_path_down = create_path_copy_and_add_cell(current_path, next_cell_down)\n            self._dfs_find_paths(row + 1, col, new_path_down)\n\n    def identify_max_average_path(self) -> Path | None:\n        \"\"\"Returns the path with the highest average cost found.\"\"\"\n        return self._max_average_path\n\n    def return_max_average_cost(self) -> float:\n        \"\"\"Returns the maximum average cost found across all paths.\"\"\"\n        return self._max_average_cost\n\n\ndef maxAverageOfPath(matrix_data: list[list[float]]) -> float:\n    \"\"\"Calculates the maximum average cost among all valid paths in a matrix.\"\"\"\n    matrix = Matrix(matrix_data)\n    path_finder = PathFinder(matrix)\n    path_finder.find_all_valid_paths()\n    return path_finder.return_max_average_cost()\n```"}
{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(array: list[int], target_number: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target_number:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target_number:\n            low = mid + 1\n        else:  # array[mid] > target_number\n            high = mid - 1\n    return result\n```"}
