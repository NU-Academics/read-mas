{"task_id": "Mbpp/631", "solution": "```python\ndef replace_spaces(text: str) -> str:\n    \"\"\"\n    Transforms the input string by simultaneously converting spaces to underscores\n    and underscores to spaces using temporary placeholders.\n    \"\"\"\n    # Step 1: Replace all original space characters with a unique temporary character (\\x01)\n    # This prevents original spaces from being converted to spaces again in step 4.\n    intermediate_step1 = text.replace(' ', '\\x01')\n\n    # Step 2: Replace all original underscore characters with another unique temporary character (\\x02)\n    # This prevents original underscores from being converted to underscores in step 3.\n    intermediate_step2 = intermediate_step1.replace('_', '\\x02')\n\n    # Step 3: Convert the first temporary character (\\x01) back to underscore characters\n    # These were originally spaces and are now intended to be underscores.\n    final_result = intermediate_step2.replace('\\x01', '_')\n\n    # Step 4: Convert the second temporary character (\\x02) back to space characters\n    # These were originally underscores and are now intended to be spaces.\n    final_result = final_result.replace('\\x02', ' ')\n\n    return final_result\n```"}
{"task_id": "Mbpp/631", "solution": "```python\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Transforms the input string by swapping whitespaces and underscores.\n    This function implements a three-step replacement strategy to avoid conflicts.\n    \"\"\"\n    # Step 1: Temporarily replace all whitespace characters with a unique placeholder.\n    temp_string = input_string.replace(' ', '__TEMP_WHITESPACE__')\n\n    # Step 2: Replace all underscore characters ('_') with a single space character (' ').\n    temp_string = temp_string.replace('_', ' ')\n\n    # Step 3: Replace the temporary placeholder with an underscore character ('_').\n    transformed_string = temp_string.replace('__TEMP_WHITESPACE__', '_')\n\n    return transformed_string\n```"}
{"task_id": "Mbpp/633", "solution": "```python\ndef pair_xor_Sum(numbers: list[int], n: int) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    It iterates through all distinct pairs and accumulates their XOR sum.\"\"\"\n    total_xor_sum = 0\n    # Iterate through all possible unique pairs of numbers\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Calculate the XOR of the current pair and add to the total sum\n            total_xor_sum += numbers[i] ^ numbers[j]\n    return total_xor_sum\n```"}
{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(input_list: list) -> list:\n    \"\"\"\n    Relocates all zero elements to the end of a list, preserving non-zero order.\n    Achieves O(N) time complexity and O(N) auxiliary space complexity as per design.\n    \"\"\"\n    non_zero_elements_list = []\n    zero_count = 0\n\n    for element in input_list:\n        if element != 0:\n            non_zero_elements_list.append(element)\n        else:\n            zero_count += 1\n\n    input_list.clear()\n    input_list.extend(non_zero_elements_list)\n    input_list.extend([0] * zero_count)\n\n    return input_list\n```"}
{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(list_of_numbers: list) -> list:\n    \"\"\"\n    Moves all zero elements to the end of the list while preserving\n    the relative order of non-zero elements.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for element in list_of_numbers:\n        if element != 0:\n            non_zero_elements.append(element)\n        else:\n            zero_count += 1\n\n    # Append all counted zeroes to the end of the non-zero elements list.\n    non_zero_elements.extend([0] * zero_count)\n\n    return non_zero_elements\n```"}
{"task_id": "Mbpp/633", "solution": "```python\ndef pair_xor_Sum(list, length):\n    \"\"\"\n    Calculates the sum of bitwise XOR operations for all unique pairs within a given list of integers.\n    Handles edge cases for empty or single-element lists by returning 0.\n    \"\"\"\n    total_xor_sum = 0\n\n    if length < 2:\n        return 0\n\n    for i in range(length - 1):\n        for j in range(i + 1, length):\n            num1 = list[i]\n            num2 = list[j]\n            xor_result = num1 ^ num2\n            total_xor_sum += xor_result\n\n    return total_xor_sum\n```"}
{"task_id": "Mbpp/635", "solution": "# Helper function to maintain the max-heap property.\ndef _heapify(data: list, n: int, i: int):\n    largest = i\n    left = 2 * i + 1\n    right = 2 * i + 2\n\n    if left < n and data[left] > data[largest]:\n        largest = left\n\n    if right < n and data[right] > data[largest]:\n        largest = right\n\n    if largest != i:\n        data[i], data[largest] = data[largest], data[i]\n        _heapify(data, n, largest)\n\n# Helper function to build a max-heap from an unsorted list.\ndef _build_max_heap(data: list):\n    n = len(data)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(data, n, i)\n\n# Sorts a list of comparable items using the heap sort algorithm.\ndef heap_sort(data: list) -> list:\n    n = len(data)\n    arr = list(data)  # Create a copy to avoid modifying the original list.\n\n    _build_max_heap(arr)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _heapify(arr, i, 0)\n\n    return arr"}
