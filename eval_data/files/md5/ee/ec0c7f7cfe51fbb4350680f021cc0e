{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(input_list: list):\n    \"\"\"\n    Identifies and returns the item with the highest frequency within a given input list.\n    This function counts occurrences of each item and then finds the one with the maximum count.\n    \"\"\"\n    frequencies = {}\n    for item in input_list:\n        frequencies[item] = frequencies.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1\n\n    # Find the item with the highest frequency\n    for item, count in frequencies.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item\n```"}
{"task_id": "Mbpp/129", "solution": "```python\nfrom typing import List\n\ndef _is_square_matrix(matrix: List[List[int]]) -> bool:\n    \"\"\"Checks if the input matrix is square.\n    Returns false if the matrix is empty or has inconsistent row lengths.\n    \"\"\"\n    if not matrix:\n        return False\n    num_rows = len(matrix)\n    for row in matrix:\n        if len(row) != num_rows:\n            return False\n    return True\n\ndef _calculate_row_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"Calculates the sum of elements for each row in the matrix.\n    Returns a list of these row sums.\n    \"\"\"\n    return [sum(row) for row in matrix]\n\ndef _calculate_column_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"Calculates the sum of elements for each column in the matrix.\n    Assumes a square matrix input.\n    \"\"\"\n    n = len(matrix)\n    column_sums = [0] * n\n    for i in range(n):\n        for j in range(n):\n            column_sums[j] += matrix[i][j]\n    return column_sums\n\ndef _calculate_main_diagonal_sum(matrix: List[List[int]]) -> int:\n    \"\"\"Calculates the sum of elements along the main diagonal.\n    Assumes a square matrix input.\n    \"\"\"\n    n = len(matrix)\n    main_diagonal_sum = 0\n    for i in range(n):\n        main_diagonal_sum += matrix[i][i]\n    return main_diagonal_sum\n\ndef _calculate_anti_diagonal_sum(matrix: List[List[int]]) -> int:\n    \"\"\"Calculates the sum of elements along the anti-diagonal.\n    Assumes a square matrix input.\n    \"\"\"\n    n = len(matrix)\n    anti_diagonal_sum = 0\n    for i in range(n):\n        anti_diagonal_sum += matrix[i][n - 1 - i]\n    return anti_diagonal_sum\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"Determines if a given square matrix is a magic square.\n    Checks if all row, column, and diagonal sums are equal.\n    \"\"\"\n    if not _is_square_matrix(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diagonal_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diagonal_sum = _calculate_anti_diagonal_sum(matrix)\n\n    expected_sum = row_sums[0]\n\n    if not all(s == expected_sum for s in row_sums):\n        return False\n    if not all(s == expected_sum for s in column_sums):\n        return False\n    if main_diagonal_sum != expected_sum:\n        return False\n    if anti_diagonal_sum != expected_sum:\n        return False\n\n    return True\n```"}
{"task_id": "Mbpp/129", "solution": "def _is_empty(matrix: list[list[int]]) -> bool:\n    \"\"\"Checks if the input matrix is empty.\n    Returns True if the matrix has no rows or its first row has no columns, False otherwise.\n    \"\"\"\n    if not matrix:\n        return True\n    if not matrix[0]:\n        return True\n    return False\n\ndef _is_square(matrix: list[list[int]]) -> bool:\n    \"\"\"Checks if the input matrix is a square matrix.\n    Returns True if the matrix has N rows and each row has N columns, False otherwise.\n    \"\"\"\n    n = len(matrix)\n    for row in matrix:\n        if len(row) != n:\n            return False\n    return True\n\ndef _calculate_row_sum(matrix: list[list[int]], row_index: int) -> int:\n    \"\"\"Calculates the sum of a specific row in the matrix.\n    Returns the sum of elements in the specified row_index.\n    \"\"\"\n    return sum(matrix[row_index])\n\ndef _calculate_column_sum(matrix: list[list[int]], col_index: int) -> int:\n    \"\"\"Calculates the sum of a specific column in the matrix.\n    Returns the sum of elements in the specified col_index.\n    \"\"\"\n    total_sum = 0\n    n = len(matrix)\n    for i in range(n):\n        total_sum += matrix[i][col_index]\n    return total_sum\n\ndef _calculate_main_diagonal_sum(matrix: list[list[int]]) -> int:\n    \"\"\"Calculates the sum of the main diagonal of the matrix.\n    Returns the sum of elements from top-left to bottom-right diagonal.\n    \"\"\"\n    total_sum = 0\n    n = len(matrix)\n    for i in range(n):\n        total_sum += matrix[i][i]\n    return total_sum\n\ndef _calculate_anti_diagonal_sum(matrix: list[list[int]]) -> int:\n    \"\"\"Calculates the sum of the anti-diagonal of the matrix.\n    Returns the sum of elements from top-right to bottom-left diagonal.\n    \"\"\"\n    total_sum = 0\n    n = len(matrix)\n    for i in range(n):\n        total_sum += matrix[i][n - 1 - i]\n    return total_sum\n\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"Determines if a given matrix is a magic square.\n    Returns True if the matrix is a magic square, False otherwise.\n    \"\"\"\n    if _is_empty(matrix):\n        return False\n    if not _is_square(matrix):\n        return False\n\n    n = len(matrix)\n    expected_sum = _calculate_row_sum(matrix, 0)\n\n    for i in range(n):\n        if _calculate_row_sum(matrix, i) != expected_sum:\n            return False\n\n    for j in range(n):\n        if _calculate_column_sum(matrix, j) != expected_sum:\n            return False\n\n    if _calculate_main_diagonal_sum(matrix) != expected_sum:\n        return False\n\n    if _calculate_anti_diagonal_sum(matrix) != expected_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "```python\nimport collections\nfrom typing import Any\n\ndef max_occurrences(input_list: list) -> Any:\n    \"\"\"Finds the item with the maximum frequency in a given list.\n    Returns the first such item encountered if multiple have the same max frequency.\"\"\"\n\n    # Calculate frequencies using collections.Counter.\n    counts = collections.Counter(input_list)\n\n    max_item = None\n    max_freq = -1\n\n    # Iterate through items and their counts to identify the item with the highest frequency.\n    for item, freq in counts.items():\n        if freq > max_freq:\n            max_freq = freq\n            max_item = item\n\n    return max_item\n```"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u), case-insensitive.\"\"\"\n    return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels within a given string `s`, excluding 'y'.\"\"\"\n    s_list = list(s)\n    vowels_found = []\n\n    # Identify and collect all vowels from the input string.\n    for char in s_list:\n        if _is_vowel(char):\n            vowels_found.append(char)\n\n    # Reverse the order of the collected vowels.\n    vowels_found.reverse()\n\n    # Replace the original vowels in the string list with the reversed ones.\n    vowel_idx = 0\n    for i in range(len(s_list)):\n        if _is_vowel(s_list[i]):\n            s_list[i] = vowels_found[vowel_idx]\n            vowel_idx += 1\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/131", "solution": "```python\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels in an input string, preserving non-vowel positions.\"\"\"\n    char_list = list(input_string)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(char_list):\n        if is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_idx in enumerate(vowel_indices):\n        char_list[original_idx] = vowels_found[i]\n\n    return \"\".join(char_list)\n```"}
