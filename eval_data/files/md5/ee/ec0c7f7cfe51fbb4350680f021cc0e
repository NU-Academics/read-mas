{"task_id": "Mbpp/113", "solution": "```python\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer (positive, negative, or zero).\n    Handles empty strings, floating-point numbers, and non-numeric characters.\n    \"\"\"\n    # 1. Empty String Check: An empty string is not a valid integer.\n    if not s:\n        return False\n\n    # 2. Sign Prefix Handling: Identify and skip an optional leading '+' or '-'.\n    start_index = 0\n    if s[0] == '+' or s[0] == '-':\n        start_index = 1\n\n    numeric_part = s[start_index:]\n\n    # If the string consists only of a sign (e.g., \"+\" or \"-\"), it's not a valid integer.\n    if not numeric_part:\n        return False\n\n    # 3. Digit Validation: Ensure the remaining part consists solely of digits.\n    # This check fails if `numeric_part` contains non-digit characters, including a decimal point.\n    if not numeric_part.isdigit():\n        return False\n\n    # 4. Floating-Point Check: As per the design, check for a decimal point.\n    # This step is reached only if `numeric_part` contains only digits (from step 3),\n    # so this check will always evaluate to False and is included per specification.\n    if '.' in numeric_part:\n        return False\n\n    # 5. Return True: If all checks pass, the string represents a valid integer.\n    return True\n```"}
{"task_id": "Mbpp/119", "solution": "```python\ndef search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear exactly twice.\n    It uses a binary search approach to achieve O(log N) time complexity.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure mid is at an even index to check pairs (mid, mid+1)\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at mid and mid+1 are the same, the unique element is to the right\n        if arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is at mid or to its left\n        else:\n            high = mid\n\n    return arr[low]\n```"}
{"task_id": "Mbpp/103", "solution": "```python\nimport math\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    The Eulerian number a(n, m) is the number of permutations of the set {1, ..., n}\n    in which exactly m elements are greater than the preceding element (i.e., have m ascents).\n\n    Args:\n        n: The first parameter (integer).\n        m: The second parameter (integer).\n\n    Returns:\n        The calculated Eulerian number a(n, m) as an integer.\n    \"\"\"\n    # Base cases and invalid inputs as per mathematical definition.\n    if m < 0 or m >= n:\n        return 0\n    if n == 0:\n        return 1 if m == 0 else 0\n    if m == 0:\n        return 1\n\n    result = 0\n    for k in range(m + 1):\n        # Binomial coefficient C(n+1, k)\n        term_nCr = math.comb(n + 1, k)\n\n        base = m + 1 - k\n        power_term = pow(base, n) # Calculate (m + 1 - k)^n\n\n        if k % 2 == 1:  # (-1)^k is negative\n            result -= term_nCr * power_term\n        else:  # (-1)^k is positive\n            result += term_nCr * power_term\n\n    return result\n```"}
{"task_id": "Mbpp/120", "solution": "```python\ndef max_product_tuple(data_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product from a list of two-element number tuples.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not data_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Initialize max_abs_product to a value guaranteed to be smaller than any possible absolute product.\n    # Since absolute products are non-negative, -1.0 is a suitable choice.\n    max_abs_product = -1.0\n\n    for num1, num2 in data_list:\n        current_abs_product = abs(num1 * num2)\n        max_abs_product = max(max_abs_product, current_abs_product)\n\n    return max_abs_product\n```"}
{"task_id": "Mbpp/123", "solution": "```python\ndef calculate_proper_divisors_sum(number: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer.\n    A proper divisor is a positive divisor of a number, excluding the number itself.\n    \"\"\"\n    if number <= 1:\n        return 0\n\n    divisor_sum = 1\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            divisor_sum += i\n            if i * i != number:\n                divisor_sum += number // i\n    return divisor_sum\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers strictly less than the specified limit.\n    Identifies amicable pairs (a, b) and sums each number in the pair exactly once.\n    \"\"\"\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit):\n        if a in found_amicable_numbers:\n            continue\n\n        sum_a = calculate_proper_divisors_sum(a)\n\n        if a != sum_a and sum_a < limit:\n            sum_b = calculate_proper_divisors_sum(sum_a)\n            if sum_b == a:\n                total_sum += a\n                total_sum += sum_a\n                found_amicable_numbers.add(a)\n                found_amicable_numbers.add(sum_a)\n\n    return total_sum\n```"}
{"task_id": "Mbpp/120", "solution": "```python\ndef max_product_tuple(list_of_tuples: list[tuple[float | int, float | int]]) -> float | int:\n    \"\"\"Calculates the maximum absolute product from a list of two-number tuples.\"\"\"\n    max_abs_product = float('-inf')\n\n    for num1, num2 in list_of_tuples:\n        current_product = num1 * num2\n        current_abs_product = abs(current_product)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n\n    return max_abs_product\n```"}
{"task_id": "Mbpp/119", "solution": "```python\ndef search(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the single unique element in a sorted list where all other elements appear exactly twice.\n    Leverages binary search to efficiently locate the unique element.\n    \"\"\"\n    low = 0\n    high = len(input_list) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # (mid ^ 1) gives mid+1 if mid is even, and mid-1 if mid is odd,\n        # providing the index of the \"natural\" pair partner.\n        if input_list[mid] == input_list[mid ^ 1]:\n            # If mid and its partner form a pair, the unique element is to the right.\n            # Advance low past this confirmed pair.\n            low = (mid | 1) + 1\n        else:\n            # If mid and its partner do not form a pair, the unique element is at or to the left of mid.\n            # Reduce high to mid.\n            high = mid\n\n    return input_list[low]\n```"}
