.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    from collections import Counter\n\n    # Calculate the frequency of each number in the list.\n    frequencies = Counter(lst)\n\n    qualifying_integers = []\n    # Iterate through the unique numbers and their frequencies.\n    for num, freq in frequencies.items():\n        # Check if the number meets the condition: greater than zero and frequency >= its value.\n        if num > 0 and freq >= num:\n            qualifying_integers.append(num)\n\n    # If no numbers satisfy the condition, return -1.\n    if not qualifying_integers:\n        return -1\n    else:\n        # Otherwise, return the greatest among the qualifying integers.\n        return max(qualifying_integers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\n    The conversion follows a specific grading scale, handling exact matches and greater-than thresholds.\n    \"\"\"\n\n    def _convert_single_gpa(gpa_value: float) -> str:\n        \"\"\"Helper to convert a single GPA to its letter grade.\"\"\"\n        if gpa_value == 4.0:\n            return \"A+\"\n        elif gpa_value > 3.7:\n            return \"A\"\n        elif gpa_value > 3.3:\n            return \"A-\"\n        elif gpa_value > 3.0:\n            return \"B+\"\n        elif gpa_value > 2.7:\n            return \"B\"\n        elif gpa_value > 2.3:\n            return \"B-\"\n        elif gpa_value > 2.0:\n            return \"C+\"\n        elif gpa_value > 1.7:\n            return \"C\"\n        elif gpa_value > 1.3:\n            return \"C-\"\n        elif gpa_value > 1.0:\n            return \"D+\"\n        elif gpa_value > 0.7:\n            return \"D\"\