or float comparison.\n    # If num is exactly X.5, round away from zero.\n    if abs(num - (floor_num + 0.5)) < 1e-9:\n        return int(ceil_num) if num >= 0 else int(floor_num)\n    else:\n        # For all other numbers, standard rounding is applied.\n        # Python's round() correctly handles numbers not ending in .5 for nearest integer.\n        return int(round(num))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/105": [{"task_id": "HumanEval/105", "solution": "_DIGIT_WORDS = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\"\n}\ndef by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n    if not arr:\n        return []\n\n    filtered_numbers = [\n        num for num in arr\n        if isinstance(num, int) and 1 <= num <= 9\n    ]\n\n    filtered_numbers.sort()\n\n    filtered_numbers.reverse()\n\n    result = [_DIGIT_WORDS[num] for num in filtered_numbers]\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/101": [{"task_id": "HumanEval/101", "solution": "import re\ndef words_string(s):\n    \"\"\"\n    You will be given a string of words separated by commas or spaces. Your task is\n    to split the string into words and return an array of the words.\n    \n    For example:\n    words_string(\"Hi, my name is John\") == [\"Hi\", \"my\", \"name\", \"is\", \"John\"]\n    words_string(\"One, two, three, four, five, six\") == [\"One\", \"two\", \"three\", \"four\", \"five, six\"]\n    \"\"\"\n    # Unify delimiters by replacing commas with spaces.\n    processed_s = s.replace(',', ' ')\n    # Split by one or more spaces, stripping leading/trailing whitespace and filtering out empty strings.\n    words = [word.strip() for word in re.split(r'\\s+', processed_s) if word.strip()]\n    return words", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/100": [{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n    \"\"\"\n    pile_levels = [n]\n    current_stones = n\n\n    for _ in range(1, n):\n        current_stones += 2\n        pile_levels.append(current_stones)\n\n    return pile_levels", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/103": [{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the average of integers from n through m, rounds to the nearest integer,\n    and converts to binary. Returns -1 if n > m.\"\"\"\n    if n > m:\n        return -1\n\n    # The average of an arithmetic series (n through m) is simply (n + m) / 2.\n    average_float = (n + m) / 2.0\n\n    # Round the average to the nearest integer.\n    # Python's built-in round() function rounds halves to the nearest even integer.\n    rounded_int = round(average_float)\n\n    # Convert the rounded integer to its binary string representation.\n    return bin(rounded_int)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/96": [{"task_id": "HumanEval/96", "solution": "import math\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a given integer num is a prime number.\n        It handles edge cases and optimizes by checking only odd divisors up to the square root.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n    return primes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/104": [{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n\n    def _has_no_even_digits(n: int) -> bool:\n        \"\"\"Checks if an integer contains any even digits.\"\"\"\n        s = str(n)\n        for digit_char in s:\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                return False\n        return True\n\n    result = []\n    for num in x:\n        if _has_no_even_digits(num):\n            result.append(num)\n    \n    result.sort()\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome by converting it to a string.\"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "from collections import Counter\nfrom typing import Dict\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test.strip():\n        return {}\n\n    letters = test.split()\n    if not letters:\n        return {}\n\n    letter_counts = Counter(letters)\n\n    if not letter_counts:\n        return {}\n\n    max_count = 0\n    for count in letter_counts.values():\n        if count > max_count:\n            max_count = count\n\n    result = {}\n    for letter, count in letter_counts.items():\n        if count == max_count:\n            result[letter] = count\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/108": [{"task_id": "HumanEval/108", "solution": "def _calculate_digit_sum(num):\n    \"\"\"\n    Calculates the sum of digits for an integer, handling negative numbers\n    where the first digit is negative.\n    \"\"\"\n    if num == 0:\n        return 0\n\n    s = str(abs(num))\n    digit_sum = 0\n\n    if num < 0:\n        digit_sum += -int(s[0])\n        for digit_char in s[1:]:\n            digit_sum += int(digit_char)\n    else:\n        for digit_char in s:\n            digit_sum += int(digit_char)\n    return digit_sum\ndef count_nums(arr):\n    \"\"\"\n    Counts the number of elements in an array whose sum of digits is > 0.\n    \"\"\"\n    count = 0\n    for num in arr:\n        if _calculate_digit_sum(num) > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/112": [{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n\n    def is_palindrome(s_to_check: str) -> bool:\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return s_to_check == s_to_check[::-1]\n\n    s_modified_chars = []\n    c_set = set(c) \n\n    for char_s in s:\n        if char_s not in c_set:\n            s_modified_chars.append(char_s)\n\n    s_modified = \"\".join(s_modified_chars)\n    is_palindrome_result = is_palindrome(s_modified)\n\n    return (s_modified, is_palindrome_result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/106": [{"task_id": "HumanEval/106", "solution": "class MathUtils:\n    @staticmethod\n    def factorial(k: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    @staticmethod\n    def sum_up_to(k: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 to k.\"\"\"\n        return k * (k + 1) // 2\nclass FactorialSumCalculator:\n    \"\"\"Calculates a list of numbers where elements are factorials or sums based on their 1-based index.\"\"\"\n    def __init__(self, math_utils: MathUtils):\n        \"\"\"Initializes the calculator with a MathUtils instance.\"\"\"\n        self.math_utils = math_utils\n\n    def calculate_list(self, n: int) -> list[int]:\n        \"\"\"\n        Generates a list of size n according to the specified rules.\n        Elements are factorial of i if i is even, or sum of 1 to i if i is odd.\n        \"\"\"\n        result_list = []\n        for i in range(1, n + 1):\n            if i % 2 == 0:  # Even index\n                result_list.append(self.math_utils.factorial(i))\n            else:  # Odd index\n                result_list.append(self.math_utils.sum_up_to(i))\n        return result_list\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    math_utils = MathUtils()\n    calculator = FactorialSumCalculator(math_utils)\n    return calculator.calculate_list(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums. Implements a variant of Kadane's algorithm.\n    \"\"\"\n    current_min_sum = nums[0]\n    overall_min_sum = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        current_min_sum = min(num, current_min_sum + num)\n        overall_min_sum = min(overall_min_sum, current_min_sum)\n\n    return overall_min_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in each string and formats a descriptive output.\n\n    For each string, it replaces 'i' in a template with the count of odd digits.\n    \"\"\"\n    results = []\n    output_template = \"the number of odd elements in the string i of the input.\"\n\n    for s in lst:\n        # Count the number of odd digits in the current string 's'\n        odd_digit_count = 0\n        for char_digit in s:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n\n        # Format the output string by replacing 'i' with the calculated count\n        formatted_string = output_template.replace('i', str(odd_digit_count))\n        results.append(formatted_string)\n\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "from typing import List\ndef move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n\n    def _is_sorted(current_arr: List[int]) -> bool:\n        \"\"\"Checks if an array is sorted in non-decreasing order.\"\"\"\n        if not current_arr:\n            return True\n        return all(current_arr[i] <= current_arr[i+1] for i in range(len(current_arr) - 1))\n\n    def _perform_right_shift(current_arr: List[int]) -> List[int]:\n        \"\"\"Performs a single right shift operation on the array.\"\"\"\n        if not current_arr:\n            return []\n        return [current_arr[-1]] + current_arr[:-1]\n\n    if not arr:\n        return True\n\n    n = len(arr)\n    current_arr_state = list(arr) # Create a mutable copy to perform shifts.\n\n    # Iterate N times to check all possible unique cyclic shifts.\n    for _ in range(n):\n        if _is_sorted(current_arr_state):\n            return True\n        current_arr_state = _perform_right_shift(current_arr_state)\n    \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\"\"\"\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    def custom_key(num: int):\n        if num < 0:\n            # Negative numbers are sorted purely by decimal value,\n            # using -1 as a primary key to group them before non-negative numbers.\n            return (-1, num)\n        else:\n            # Non-negative numbers sorted by bit count, then decimal value.\n            return (_count_set_bits(num), num)\n\n    return sorted(arr, key=custom_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 == 0:  # Check if position is even (0-indexed)\n            if element % 2 != 0:  # Check if element is odd\n                total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "VOWELS_SET = \"aeiouAEIOU\"\nALPHABET_SET = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \"\"\"\n    \n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel (case-sensitive).\"\"\"\n        return char in VOWELS_SET\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English consonant (case-sensitive).\"\"\"\n        return char in ALPHABET_SET and char not in VOWELS_SET\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and \\\n           _is_consonant(left_char) and \\\n           _is_consonant(right_char):\n            return current_char\n    \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in ascending order.\n    sorted_arr = sorted(arr)\n\n    # Return the last k elements, which are the k largest.\n    return sorted_arr[len(sorted_arr) - k:]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "class Utils:\n    def is_even(self, num: int) -> bool:\n        \"\"\"Checks if a given number is even.\"\"\"\n        return num % 2 == 0\nclass ListAnalyzer:\n    def __init__(self, utils: Utils = None):\n        self._utils = utils if utils is not None else Utils()\n\n    def count_odd_numbers(self, lst: list[int]) -> int:\n        \"\"\"Counts the number of odd integers in the given list.\"\"\"\n        return sum(1 for num in lst if not self._utils.is_even(num))\n\n    def count_even_numbers(self, lst: list[int]) -> int:\n        \"\"\"Counts the number of even integers in the given list.\"\"\"\n        return sum(1 for num in lst if self._utils.is_even(num))\nclass ExchangeSolver:\n    def __init__(self, list_analyzer: ListAnalyzer = None):\n        self._list_analyzer = list_analyzer if list_analyzer is not None else ListAnalyzer()\n\n    def can_exchange(self, lst1: list[int], lst2: list[int]) -> str:\n        \"\"\"Determines if it is possible to exchange elements between lst1 and lst2 to make lst1 a list of only even numbers.\"\"\"\n        odd_count_lst1 = self._list_analyzer.count_odd_numbers(lst1)\n        even_count_lst2 = self._list_analyzer.count_even_numbers(lst2)\n\n        if odd_count_lst1 <= even_count_lst2:\n            return \"YES\"\n        else:\n            return \"NO\"\ndef exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    solver = ExchangeSolver()\n    return solver.can_exchange(lst1, lst2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits (absolute value less than 100).\n        if -100 < element < 100:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word, case-insensitively.\"\"\"\n        count = 0\n        for char in word:\n            lower_char = char.lower()\n            if 'a' <= lower_char <= 'z' and lower_char not in VOWELS:\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n            \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The list includes unique odd numbers from the sequence, sorted in increasing order.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = []\n    current = n\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    sequence.append(1) # Ensure the final 1 is included in the sequence\n\n    odd_numbers = [num for num in sequence if num % 2 != 0]\n    return sorted(list(set(odd_numbers)))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    \n    # Check for whitespace\n    has_whitespace = any(c.isspace() for c in txt)\n    if has_whitespace:\n        return txt.split()\n\n    # If no whitespace, check for commas\n    has_comma = ',' in txt\n    if has_comma:\n        return txt.split(',')\n    \n    # If no whitespace and no commas, count odd-ordered lowercase letters\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = sum(abs(n) for n in arr)\n\n    product_signs = 1\n    for num in arr:\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n        else:\n            sign = 0\n        product_signs *= sign\n        # Optimization: if any number is zero, the product of signs becomes zero,\n        # so the final result will be zero. We can short-circuit.\n        if product_signs == 0:\n            break\n\n    return sum_magnitudes * product_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    # Enforce strict mm-dd-yyyy length\n    if len(parts[0]) != 2 or len(parts[1]) != 2 or len(parts[2]) != 4:\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2]) # Year is parsed but not used in validation rules\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if not (1 <= day): # Day cannot be less than 1\n        return False\n\n    # Define month-day constraints based on the rules.\n    DAYS_IN_MONTH_31 = [1, 3, 5, 7, 8, 10, 12]\n    DAYS_IN_MONTH_30 = [4, 6, 9, 11]\n    DAYS_IN_MONTH_29 = [2] # Max 29 for February, no leap year logic required.\n\n    if month in DAYS_IN_MONTH_31:\n        if not (day <= 31):\n            return False\n    elif month in DAYS_IN_MONTH_30:\n        if not (day <= 30):\n            return False\n    elif month in DAYS_IN_MONTH_29: # This implies month == 2\n        if not (day <= 29):\n            return False\n    else:\n        # This branch should ideally not be reached if month is already validated between 1 and 12,\n        # but serves as a safeguard.\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product_of_odd = 1\n    has_odd_digit = False\n\n    temp_n = n\n    if temp_n == 0: # Handle the case of n=0 if it were allowed, or a single '0' digit\n        return 0\n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odd *= digit\n            has_odd_digit = True\n        temp_n //= 10\n\n    if not has_odd_digit:\n        return 0\n    return product_of_odd", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    # Check for sorted order\n    if len(lst) <= 1:\n        pass # An empty or single-element list is considered sorted\n    else:\n        for i in range(len(lst) - 1):\n            if lst[i] > lst[i+1]:\n                return False\n    \n    # Check for duplicate rule: no number should appear more than twice\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num ** 2\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    def _is_balanced(s):\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not immediately preceded by another alphabetical character.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    second_last_char = txt[-2]\n    if second_last_char.isalpha():\n        return False\n    \n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["aaaaa aaaaa 1A"]]}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    largest_violation_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_violation_index = i\n    return largest_violation_index", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n    \n    return (largest_neg, smallest_pos)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "from typing import Tuple, Union\nclass Interval:\n    def __init__(self, start: int, end: int):\n        self._start = start\n        self._end = end\n\n    def length(self) -> int:\n        return self._end - self._start + 1\n\n    @property\n    def start(self) -> int:\n        return self._start\n\n    @property\n    def end(self) -> int:\n        return self._end\nclass IntervalService:\n    def get_intersection(self, i1: Interval, i2: Interval) -> Union[Interval, None]:\n        max_start = max(i1.start, i2.start)\n        min_end = min(i1.end, i2.end)\n\n        if max_start <= min_end:\n            return Interval(max_start, min_end)\n        return None\nclass MathUtils:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, 