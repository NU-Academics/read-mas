WELS_LOWER = \"aeiou\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n\n    encoded_chars = []\n    for char in message:\n        # Step 1: Swap case of the current character.\n        # This also handles non-letters by returning them unchanged.\n        swapped_char = char.swapcase()\n\n        # Step 2: Check if the *swapped* character (converted to lowercase) is a vowel.\n        if swapped_char.lower() in VOWELS_LOWER:\n            # Determine if the swapped character was originally uppercase to preserve its case.\n            is_upper_case_after_swap = swapped_char.isupper()\n\n            # Find the position of the vowel in the alphabet for shifting.\n            vowel_lower_for_lookup = swapped_char.lower()\n            alphabet_index = ALPHABET_LOWER.find(vowel_lower_for_lookup)\n\n            # Shift two places forward. The design implies no wrap-around for the defined vowels.\n            shifted_char_lower = ALPHABET_LOWER[alphabet_index + 2]\n\n            # Apply the preserved case to the shifted character.\n            if is_upper_case_after_swap:\n                encoded_chars.append(shifted_char_lower.upper())\n            else:\n                encoded_chars.append(shifted_char_lower)\n        else:\n            # If not a vowel (after case swap), just append the swapped character.\n            encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/24": [{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Iterate downwards from n-1 to find the first divisor.\n    for i in range(n - 1, 0, -1):\n        if n % i == 0:\n            return i", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    \n    # Use regular expression to split the string into sentences.\n    # The delimiters '.', '?' or '!' are removed by re.split.\n    # This ensures consistency with the behavior implied by the design's test cases\n    # for sentence splitting, where delimiters are not part of the sentence content.\n    raw_sentences = re.split(r'[.?!]', S)\n    \n    sentences = []\n    for s in raw_sentences:\n        # Trim leading/trailing whitespace from each segment.\n        # Only add non-empty segments (which become sentences) to the list.\n        trimmed_s = s.strip()\n        if trimmed_s:\n            sentences.append(trimmed_s)\n            \n    for sentence in sentences:\n        # Convert the sentence to lowercase for case-insensitive checking.\n        lower_sentence = sentence.lower()\n        \n        # A \"boredom\" is a sentence that starts with the word \"I\".\n        # This means it must either be exactly \"i\" (for single-word sentences like \"I.\")\n        # or start with \"i \" (for sentences like \"I am happy.\").\n        # This condition distinguishes \"I\" as a standalone word from words starting with \"I\" (e.g., \"Important\", \"I'm\").\n        if lower_sentence.startswith(\"i \") or lower_sentence == \"i\":\n            boredom_count += 1\n            \n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    if n <= 0:\n        return 0\n\n    total_count = 0\n    for i in range(1, n):\n    