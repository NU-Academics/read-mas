st xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    DEFAULT_TOLERANCE: float = 1e-6\n    MAX_ITERATIONS: int = 1000\n    SEARCH_RANGE_MIN: float = -100.0\n    SEARCH_RANGE_MAX: float = 100.0\n\n    if len(xs) % 2 != 0:\n        raise ValueError(\"Coefficients list must have an even length to guarantee a solution.\")\n\n    a = SEARCH_RANGE_MIN\n    b = SEARCH_RANGE_MAX\n\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    if a >= b:\n        raise ValueError(\"Search interval is invalid: a must be less than b.\")\n\n    # Bisection method requires f(a) and f(b) to have opposite signs.\n    if fa * fb > 0:\n        raise ValueError(\"Function has same sign at interval endpoints, no root guaranteed in this range by bisection.\")\n\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        fmid = poly(xs, mid)\n\n        if abs(fmid) < DEFAULT_TOLERANCE:\n            return mid\n\n        if fa * fmid < 0:\n            b = mid\n            fb = fmid\n        else:\n            a = mid\n            fa = fmid\n    \n    raise RuntimeError(\"Bisection method did not converge within maximum iterations.\")", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/37": [{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    resu