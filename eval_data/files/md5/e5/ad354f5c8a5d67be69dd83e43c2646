ew list with elements sorted in ascending order.\n    \"\"\"\n    # Create a mutable copy of the input list to perform sorting operations.\n    arr = list(lst)\n    n = len(arr)\n\n    # Helper function to reverse a sublist from index 0 up to `k` (inclusive).\n    def _flip(sub_arr, k):\n        start = 0\n        while start < k:\n            sub_arr[start], sub_arr[k] = sub_arr[k], sub_arr[start]\n            start += 1\n            k -= 1\n\n    # Iterate from the last element down to the second element.\n    # `i` represents the current end of the unsorted part of the array.\n    for i in range(n - 1, 0, -1):\n        # Find the index of the maximum element in the current unsorted part (arr[0...i]).\n        max_val = arr[0]\n        max_idx = 0\n        for j in range(1, i + 1):\n            if arr[j] > max_val:\n                max_val = arr[j]\n                max_idx = j\n\n        # If the maximum element is not already at its correct position (`i`),\n        # perform two flips to move it there.\n        if max_idx != i:\n            # First flip: Bring the maximum element to the front (index 0).\n            if max_idx != 0:\n                _flip(arr, max_idx)\n\n            # Second flip: Move the maximum element from the front to its sorted position (`i`).\n            _flip(arr, i)\n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "from typing import List, Any\ndef remove_elements(source_list: List[Any], filter_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Return a new list containing elements from source_list that are not present in filter_list.\n    Order of elements is preserved. The function is pure and does not modify the inputs.\n    \"\"\"\n    filter_set = set(filter_list)\n    return [item for item in source_list if item not in filter_set]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[