op variables are 1, -1.\n    # This means a*x0 + b*y0 = g is a*(1) + b*(-1) = g.\n    # For a=2, b=3: 2*(1) + 3*(-1) = 2 - 3 = -1. This is not g=1.\n\n    # The standard extended Euclidean algorithm returns x, y for ax + by = gcd(a,b)\n    # The variables in the loop need to be managed carefully.\n    # Let's use the standard recursive form or common iterative form\n    \n    # x, y for a*x + b*y = g\n    # Iterative extended Euclidean Algorithm\n    s0, s1 = 1, 0\n    t0, t1 = 0, 1\n    r0, r1 = a, b\n\n    while r1 != 0:\n        q = r0 // r1\n        r0, r1 = r1, r0 - q * r1\n        s0, s1 = s1, s0 - q * s1\n        t0, t1 = t1, t0 - q * t1\n    \n    # At this point, r0 is gcd(a, b) and s0, t0 are the coefficients\n    # such that a*s0 + b*t0 = r0 (which is g)\n    x_particular = s0\n    y_particular = t0\n\n    # Scale the particular solution to satisfy ax + by = n\n    scale_factor = n // g\n    final_x = x_particular * scale_factor\n    final_y = y_particular * scale_factor\n\n    return (final_x, final_y)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 3, 7]], "plus_fail_tests": [[25, 10, 500]]}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) ... until the term is less than or equal to zero.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    current_term = n\n    while current_term > 0:\n        total_sum += current_term\n        current_term -= 2\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/166": [{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers):\n    \"\"\"\n    Counts the number of unordered pairs of integers in a list that xor to an even number.\n    An even XOR sum occurs when both numbers have the same parity (both 