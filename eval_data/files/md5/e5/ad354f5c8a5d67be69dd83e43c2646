ent is at or before mid-1.\n        else:\n            if array[mid] == array[mid - 1]:\n                left = mid + 1\n            else:\n                right = mid - 1\n    return array[left]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/124": [{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(real: float, imag: float) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number.\n    Returns 0.0 if both real and imag are 0.\n    \"\"\"\n    if real == 0 and imag == 0:\n        return 0.0\n    return math.atan2(imag, real)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["0.0", "1j"]], "plus_fail_tests": [["0.0", "1j"]]}], "Mbpp/126": [{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of common divisors of two given numbers.\"\"\"\n    # Compute the greatest common divisor (GCD) using the Euclidean algorithm.\n    x, y = a, b\n    while y:\n        x, y = y, x % y\n    \n    # The GCD is now stored in x.\n    common_divisor_gcd = x\n\n    # Find and sum all divisors of the GCD.\n    total_sum = 0\n    i = 1\n    while i * i <= common_divisor_gcd:\n        if common_divisor_gcd % i == 0:\n            total_sum += i\n            if i * i != common_divisor_gcd:\n                total_sum += (common_divisor_gcd // i)\n        i += 1\n    \n    return total_sum", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/127": [{"task_id": "Mbpp/127", "solution": "def multiply_int(a, b):\n    \"\"\"\n    Multiplies two integers and returns their product.\n    \"\"\"\n    return a * b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/130": [{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Uses a frequency map to count occurrences and then finds the key with the highest count.\n    \"\"\"\n    frequency_map = {}\n    for item in items:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_count = -1\n    max_item = None\n    for item, count in frequency_map.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n            \n    return max_item", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/125": [{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the count of 0s and 1s in any substring.\n    The algorithm uses a single pass, converting '0' to 1 and '1' to -1, then\n    finds the maximum subarray sum using a variation of Kadane's algorithm.\n    \"\"\"\n    max_diff = 0\n    current_balance = 0\n    min_balance_so_far = 0\n\n    for char in binary_string:\n        if char == '0':\n            current_balance += 1\n        else: # char == '1'\n            current_balance -= 1\n\n        # The maximum difference ending at the current position is current_balance - min_balance_so_far.\n        max_diff = max(max_diff, current_balance - min_balance_so_far)\n        \n        # Update the minimum balance encountered so far.\n        min_balance_so_far = min(min_balance_so_far, current_balance)\n\n    return max_diff", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/128": [{"task_id": "Mbpp/128", "solution": "from typing import List\nclass InputString:\n    \"\"\"Represents the input text for processing.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\nclass Word:\n    \"\"\"Represents a single word with its text and length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\nclass LongWordsFunction:\n    \"\"\"Application layer use case to find words longer 