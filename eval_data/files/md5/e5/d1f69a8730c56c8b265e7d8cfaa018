{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Get first digit (absolute value)\n            s_num = str(abs(num))\n            first_digit = int(s_num[0])\n\n            # Get last digit (absolute value)\n            last_digit = int(s_num[-1])\n\n            # Check if first and last digits are odd\n            is_first_odd = (first_digit % 2 != 0)\n            is_last_odd = (last_digit % 2 != 0)\n\n            if is_first_odd and is_last_odd:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "from dataclasses import dataclass\ndef _calculate_digit_sum(num: int) -> int:\n    \"\"\"Computes the sum of digits for the absolute value of num.\"\"\"\n    s = 0\n    abs_num = abs(num)\n    for digit_char in str(abs_num):\n        s += int(digit_char)\n    return s\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    if not nums:\n        return []\n\n    elements = []\n    # Create _IntegerElement objects, calculating digit sum and preserving original index.\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        elements.append(_IntegerElement(num, i, digit_sum))\n\n    # Sort the elements primarily by digit_sum, then by original_index for ties.\n    sorted_elements = sorted(elements, key=lambda x: (x.digit_sum, x.original_index))\n\n    # Extract the original values from the sorted list.\n    result = [el.value for el in sorted_elements]\n\n    return result"}
{"task_id": "HumanEval/148", "solution": "class Planet:\n    '''Represents a celestial body with its name and order from the Sun.'''\n    def __init__(self, name: str, order_from_sun: int):\n        self._name = name\n        self._order_from_sun = order_from_sun\n\n    @property\n    def name(self) -> str:\n        return self._name\n\n    @property\n    def order_from_sun(self) -> int:\n        return self._order_from_sun\nclass SolarSystem:\n    '''Manages the collection of planets and provides methods for finding planets.'''\n    def __init__(self):\n        planet_names = [\n            \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n        ]\n        self._planets_list = [\n            Planet(name, i) for i, name in enumerate(planet_names)\n        ]\n        self._planet_names_to_order = {\n            name: i for i, name in enumerate(planet_names)\n        }\n\n    def get_planet_order(self, planet_name: str) -> int | None:\n        return self._planet_names_to_order.get(planet_name)\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> list[str]:\n        order1 = self.get_planet_order(planet1_name)\n        order2 = self.get_planet_order(planet2_name)\n\n        if order1 is None or order2 is None:\n            return []\n\n        start_idx = min(order1, order2)\n        end_idx = max(order1, order2)\n\n        between_planets = self._planets_list[start_idx + 1:end_idx]\n        return [planet.name for planet in between_planets]\n_solar_system = SolarSystem()\ndef bf(planet1, planet2):\n    between_names = _solar_system.get_planets_between(planet1, planet2)\n    return tuple(between_names)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    a = [0] * n\n    for i_val in range(1, n + 1):\n        # Populate array 'a' using 1-based i_val for the formula\n        # and 0-based index for the list.\n        a[i_val - 1] = i_val * i_val - i_val + 1\n\n    count = 0\n    # Iterate through all possible unique triples (a[i], a[j], a[k])\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                current_sum = a[i] + a[j] + a[k]\n                if current_sum % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to keep only even-length words, then sorts them by length and alphabetically.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute differences between actual game scores and guessed scores.\n    Returns an array of differences, with 0 for correct guesses and the absolute difference otherwise.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer, non-negative, and odd.\n        if isinstance(num, int) and num >= 0 and num % 2 != 0:\n            total_sum_of_squares += num * num\n    return total_sum_of_squares"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension from a list based on a strength calculation\n    and returns a formatted string 'ClassName.StrongestExtensionName'.\n    \"\"\"\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension name as (uppercase letters - lowercase letters).\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    if not extensions:\n        return f\"{class_name}.\"\n\n    strongest_ext_name = \"\"\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n        # If current_strength == max_strength, we keep the existing strongest_ext_name\n        # adhering to the \"first in the list\" tie-breaking rule.\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    def generate_cyclic_rotations(s: str) -> set[str]:\n        \"\"\"Generates all unique cyclic rotations of a given string s.\"\"\"\n        if not s:\n            return {\"\"} # An empty string has one rotation: itself.\n\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return rotations\n\n    b_rotations = generate_cyclic_rotations(b)\n\n    for rotation in b_rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input out of range [1, 1000]\")\n\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Sort the sides to easily identify the longest side (hypotenuse).\n    sides = sorted([a, b, c])\n    # x and y are the two shorter sides (legs), z is the longest side (hypotenuse).\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for floating-point comparison to account for precision errors.\n    EPSILON = 1e-9\n\n    # Apply the Pythagorean theorem: x^2 + y^2 = z^2.\n    # Return True if the equation holds true within the epsilon tolerance.\n    return abs(x*x + y*y - z*z) < EPSILON"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum, returns the lexicographically smallest.\n    \"\"\"\n    max_unique_count = -1\n    best_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the lexicographically smaller word\n            if word < best_word:\n                best_word = word\n\n    return best_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    total_eaten_carrots = 0\n    carrots_left = 0\n\n    if need <= remaining:\n        total_eaten_carrots = number + need\n        carrots_left = remaining - need\n    else:\n        # Not enough remaining carrots, eat all available\n        total_eaten_carrots = number + remaining\n        carrots_left = 0\n\n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand, build an algebraic expression and return its evaluation.\n    This function orchestrates input validation, expression construction, and evaluation.\n    \"\"\"\n    def _construct_expression_string(operator_list, operand_list):\n        \"\"\"Constructs a single string representation of the algebraic expression.\"\"\"\n        expression_parts = []\n        expression_parts.append(str(operand_list[0]))\n        for i in range(len(operator_list)):\n            expression_parts.append(operator_list[i])\n            expression_parts.append(str(operand_list[i+1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression_string(expression_str):\n        \"\"\"Evaluates the constructed algebraic expression string, respecting standard operator precedence.\"\"\"\n        # The eval() function in Python can safely evaluate basic arithmetic expressions.\n        return eval(expression_str)\n\n    expression_string = _construct_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_string)\n    return result"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letters(s_inner: str) -> bool:\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        for char in s_inner:\n            if char.isalpha():\n                return True\n        return False\n\n    def _reverse_case_char(char_inner: str) -> str:\n        \"\"\"Reverses the case of a single letter; returns unchanged if not a letter.\"\"\"\n        if char_inner.isalpha():\n            if char_inner.islower():\n                return char_inner.upper()\n            else: # char is uppercase\n                return char_inner.lower()\n        return char_inner\n\n    def _reverse_string(s_inner: str) -> str:\n        \"\"\"Reverses the order of all characters in the given string.\"\"\"\n        return s_inner[::-1]\n\n    if not _has_letters(s):\n        return _reverse_string(s)\n    else:\n        result_chars = []\n        for char in s:\n            result_chars.append(_reverse_case_char(char))\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n\n    import hashlib\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/163", "solution": "from typing import List\nclass InputProcessor:\n    \"\"\"Encapsulates the two input integers and determines their minimum and maximum values.\"\"\"\n    def __init__(self, a: int, b: int):\n        if not (isinstance(a, int) and isinstance(b, int) and a > 0 and b > 0):\n            raise ValueError(\"Both inputs 'a' and 'b' must be positive integers.\")\n        self._value_a = a\n        self._value_b = b\n\n    def determine_min(self) -> int:\n        \"\"\"Returns the minimum of the two input values.\"\"\"\n        return min(self._value_a, self._value_b)\n\n    def determine_max(self) -> int:\n        \"\"\"Returns the maximum of the two input values.\"\"\"\n        return max(self._value_a, self._value_b)\nclass EvenDigitIdentifier:\n    \"\"\"Identifies single-digit even numbers within a specified range.\"\"\"\n    _SINGLE_DIGIT_EVENS = {0, 2, 4, 6, 8}\n\n    def __init__(self, min_val: int, max_val: int):\n        self._min_val = min_val\n        self._max_val = max_val\n        self._identified_digits: List[int] = []\n\n    def identify_digits(self) -> None:\n        \"\"\"Populates the internal list with single-digit even numbers within the range.\"\"\"\n        for digit in sorted(list(self._SINGLE_DIGIT_EVENS)):\n            if self._min_val <= digit <= self._max_val:\n                self._identified_digits.append(digit)\n\n    def get_identified_digits(self) -> List[int]:\n        \"\"\"Returns the list of identified digits.\"\"\"\n        return self._identified_digits\nclass ResultFormatter:\n    \"\"\"Sorts the identified even numbers and provides the final result list.\"\"\"\n    def __init__(self, digits: List[int]):\n        self._digits = digits\n\n    def get_sorted_result(self) -> List[int]:\n        \"\"\"Returns the sorted list of digits. An explicit sort ensures the result is always ordered.\"\"\"\n        return sorted(self._digits)\ndef generate_integers(a: int, b: int) -> List[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    input_processor = InputProcessor(a, b)\n    min_val = input_processor.determine_min()\n    max_val = input_processor.determine_max()\n\n    even_digit_identifier = EvenDigitIdentifier(min_val, max_val)\n    even_digit_identifier.identify_digits()\n    identified_list = even_digit_identifier.get_identified_digits()\n\n    result_formatter = ResultFormatter(identified_list)\n    return result_formatter.get_sorted_result()"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    # The smallest sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    # The sum of any four even numbers must also be an even number.\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    # Any even number n >= 8 can be expressed as 2 + 2 + 2 + (n-6), where (n-6) is also a positive even number.\n    return True"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= _factorial(i)\n    return total_product"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace 3 or more consecutive spaces with a hyphen.\n    intermediate_text = re.sub(r' {3,}', '-', text)\n    # Second, replace exactly 2 consecutive spaces with two underscores.\n    intermediate_text = re.sub(r' {2}', '__', intermediate_text)\n    # Finally, replace single spaces with a single underscore.\n    final_text = re.sub(r' ', '_', intermediate_text)\n    return final_text"}
{"task_id": "HumanEval/137", "solution": "import numbers\nfrom typing import Union, Any, Type\nclass InputValue:\n    \"\"\"\n    Encapsulates an input value, its original type, and its numerical representation,\n    handling string parsing for comparison.\n    \"\"\"\n    def __init__(self, value: Union[int, float, str]):\n        self._original_value: Any = value\n        self._original_type: Type = type(value)\n        self._numerical_value: float = self._parse_to_numerical(value)\n\n    def _parse_to_numerical(self, value: Union[int, float, str]) -> float:\n        \"\"\"\n        Converts the input value to a float for numerical comparison.\n        Handles string parsing with comma or period decimal separators.\n        \"\"\"\n        if isinstance(value, numbers.Real):\n            return float(value)\n        elif isinstance(value, str):\n            if ',' in value and '.' not in value:\n                value = value.replace(',', '.')\n            try:\n                return float(value)\n            except ValueError:\n                raise ValueError(f\"Invalid string representation of a real number: {self._original_value}\")\n        else:\n            raise TypeError(f\"Unsupported input type: {self._original_type} for value: {self._original_value}\")\n\n    def get_original_value(self) -> Union[int, float, str]:\n        \"\"\"\n        Returns the original input value, preserving its type.\n        \"\"\"\n        return self._original_value\n\n    def get_numerical_value(self) -> float:\n        \"\"\"\n        Returns the numerical (float) representation of the input value.\n        \"\"\"\n        return self._numerical_value\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two real numbers (int, float, or string) and returns the larger one\n    in its original type, or None if equal.\n    \"\"\"\n    input_a = InputValue(a)\n    input_b = InputValue(b)\n\n    num_a = input_a.get_numerical_value()\n    num_b = input_b.get_numerical_value()\n\n    if num_a == num_b:\n        return None\n    elif num_a > num_b:\n        return input_a.get_original_value()\n    else: # num_b > num_a\n        return input_b.get_original_value()"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:  # This implicitly means i % 3 != 0 due to the 'elif'\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "import re\nfrom abc import ABC, abstractmethod\nclass FileName:\n    \"\"\"Parses and stores the components (prefix and extension) of a given file name string.\"\"\"\n    def __init__(self, name: str):\n        self._name: str = name\n        parts = name.rsplit('.', 1)\n        if len(parts) == 2:\n            self.prefix: str = parts[0]\n            self.extension: str = parts[1]\n        else:\n            self.prefix: str = name\n            self.extension: str = \"\"\n\n    def get_prefix(self) -> str:\n        \"\"\"Returns the prefix of the file name.\"\"\"\n        return self.prefix\n\n    def get_extension(self) -> str:\n        \"\"\"Returns the extension of the file name.\"\"\"\n        return self.extension\nclass ValidationRule(ABC):\n    \"\"\"Abstract base class defining the interface for all file name validation rules.\"\"\"\n    def __init__(self, description: str):\n        self.description = description\n\n    @abstractmethod\n    def is_valid(self, file_name_obj: FileName) -> bool:\n        pass\nclass DigitCountRule(ValidationRule):\n    \"\"\"Validates that the file name does not contain more than three digits.\"\"\"\n    def __init__(self):\n        super().__init__(\"File name should not contain more than three digits.\")\n\n    def is_valid(self, file_name_obj: FileName) -> bool:\n        digit_count = sum(1 for char in file_name_obj._name if char.isdigit())\n        return digit_count <= 3\nclass DotCountRule(ValidationRule):\n    \"\"\"Validates that the file name contains exactly one dot.\"\"\"\n    def __init__(self):\n        super().__init__(\"File name should contain exactly one dot.\")\n\n    def is_valid(self, file_name_obj: FileName) -> bool:\n        return file_name_obj._name.count('.') == 1\nclass PrefixNotEmptyRule(ValidationRule):\n    \"\"\"Validates that the substring before the dot is not empty.\"\"\"\n    def __init__(self):\n        super().__init__(\"The substring before the dot should not be empty.\")\n\n    def is_valid(self, file_name_obj: FileName) -> bool:\n        return bool(file_name_obj.get_prefix())\nclass PrefixStartsLetterRule(ValidationRule):\n    \"\"\"Validates that the substring before the dot starts with a Latin alphabet letter.\"\"\"\n    def __init__(self):\n        super().__init__(\"The substring before the dot should start with a latin alphapet letter.\")\n\n    def is_valid(self, file_name_obj: FileName) -> bool:\n        prefix = file_name_obj.get_prefix()\n        return bool(prefix) and prefix[0].isalpha()\nclass ExtensionTypeRule(ValidationRule):\n    \"\"\"Validates that the file extension is one of 'txt', 'exe', or 'dll'.\"\"\"\n    def __init__(self, allowed_extensions: list[str], description: str = \"Extension must be one of the allowed types.\"):\n        super().__init__(description)\n        self._allowed_extensions: list[str] = allowed_extensions\n\n    def is_valid(self, file_name_obj: FileName) -> bool:\n        return file_name_obj.get_extension() in self._allowed_extensions\nclass FileNameValidator:\n    \"\"\"Orchestrates the application of a collection of ValidationRule instances to a FileName object.\"\"\"\n    def __init__(self, rules: list[ValidationRule]):\n        self._rules: list[ValidationRule] = rules\n\n    def validate(self, file_name_obj: FileName) -> bool:\n        \"\"\"Iterates through all rules, returning False on the first failure, True if all pass.\"\"\"\n        for rule in self._rules:\n            if not rule.is_valid(file_name_obj):\n                return False\n        return True\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_obj = FileName(file_name)\n\n    rules = [\n        DigitCountRule(),\n        DotCountRule(),\n        PrefixNotEmptyRule(),\n        PrefixStartsLetterRule(),\n        ExtensionTypeRule(['txt', 'exe', 'dll'])\n    ]\n\n    validator = FileNameValidator(rules)\n\n    if validator.validate(file_obj):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    class Fraction:\n        \"\"\"Represents a fraction and provides arithmetic operations.\"\"\"\n        def __init__(self, numerator, denominator):\n            self._numerator = numerator\n            self._denominator = denominator\n            self._simplify_fraction()\n\n        @staticmethod\n        def parse(fraction_string):\n            \"\"\"Parses a string into a Fraction object.\"\"\"\n            num_str, den_str = fraction_string.split('/')\n            return Fraction(int(num_str), int(den_str))\n\n        def multiply(self, other):\n            \"\"\"Multiplies this fraction by another fraction.\"\"\"\n            new_numerator = self._numerator * other._numerator\n            new_denominator = self._denominator * other._denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self):\n            \"\"\"Checks if the fraction represents a whole number.\"\"\"\n            return self._denominator == 1\n\n        def _simplify_fraction(self):\n            \"\"\"Simplifies the fraction by dividing numerator and denominator by their GCD.\"\"\"\n            common_divisor = _gcd(self._numerator, self._denominator)\n            self._numerator //= common_divisor\n            self._denominator //= common_divisor\n\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence whose lengths are prime numbers,\n    maintaining original order.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _split_sentence(s):\n        return s.split(' ')\n\n    def _filter_words_by_prime_length(word_list):\n        result = []\n        for word in word_list:\n            if is_prime(len(word)):\n                result.append(word)\n        return result\n\n    def _join_words(word_list):\n        return ' '.join(word_list)\n\n    words = _split_sentence(sentence)\n    prime_length_words = _filter_words_by_prime_length(words)\n    return _join_words(prime_length_words)"}
