{"task_id": "HumanEval/26", "solution": "from typing import List, Set, Dict\nclass ListOfIntegers:\n    \"\"\"Manages a list of integers, providing methods to identify and remove repeating elements while preserving order.\"\"\"\n\n    def __init__(self, initial_list: List[int]) -> None:\n        \"\"\"Initializes the ListOfIntegers instance with an input list.\"\"\"\n        self._elements: List[int] = list(initial_list)\n\n    def identify_repeating_elements(self) -> Set[int]:\n        \"\"\"Identifies and returns a set of integers that appear more than once in _elements.\"\"\"\n        counts: Dict[int, int] = {}\n        for item in self._elements:\n            counts[item] = counts.get(item, 0) + 1\n\n        repeating_elements_set: Set[int] = {item for item, count in counts.items() if count > 1}\n        return repeating_elements_set\n\n    def remove_repeating_elements(self, repeating_elements: Set[int]) -> None:\n        \"\"\"Filters _elements in-place, removing all occurrences of integers present in repeating_elements.\"\"\"\n        self._elements = [item for item in self._elements if item not in repeating_elements]\n\n    def get_processed_list(self) -> List[int]:\n        \"\"\"Returns the current state of _elements after processing.\"\"\"\n        return self._elements\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    list_processor = ListOfIntegers(numbers)\n    repeating = list_processor.identify_repeating_elements()\n    list_processor.remove_repeating_elements(repeating)\n    return list_processor.get_processed_list()"}
{"task_id": "HumanEval/27", "solution": "def _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a given character is alphabetic.\"\"\"\n    return char.isalpha()\ndef _is_lowercase(char: str) -> bool:\n    \"\"\"Checks if a given character is a lowercase alphabetic character.\"\"\"\n    return char.islower()\ndef _is_uppercase(char: str) -> bool:\n    \"\"\"Checks if a given character is an uppercase alphabetic character.\"\"\"\n    return char.isupper()\ndef _to_uppercase(char: str) -> str:\n    \"\"\"Converts a given character to its uppercase equivalent.\"\"\"\n    return char.upper()\ndef _to_lowercase(char: str) -> str:\n    \"\"\"Converts a given character to its lowercase equivalent.\"\"\"\n    return char.lower()\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if _is_alphabetic(char):\n            if _is_lowercase(char):\n                flipped_chars.append(_to_uppercase(char))\n            elif _is_uppercase(char):\n                flipped_chars.append(_to_lowercase(char))\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_list = [s for s in strings if s.startswith(prefix)]\n    return filtered_list"}
