{"task_id": "Mbpp/71", "solution": "\"\"\"\nWrite a function to sort a list of elements.\nassert comb_sort([5, 15, 37, 25, 79]) == [5, 15, 25, 37, 79]\n\"\"\"\n```python\ndef comb_sort(arr):\n    \"\"\"Sorts array using comb sort algorithm with shrink factor of 1.3.\"\"\"\n    n = len(arr)\n    gap = n\n    swapped = True\n    \n    while gap > 1 or swapped:\n        gap = max(1, int(gap / 1.3))\n        swapped = False\n        \n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    \n    return arr\n```"}
{"task_id": "Mbpp/75", "solution": "\"\"\"\nWrite a function to find tuples which have all elements divisible by k from the given list of tuples.\nassert find_tuples([(6, 24, 12), (7, 9, 6), (12, 18, 21)], 6) == [(6, 24, 12)]\n\"\"\"\ndef find_tuples(tuples_list, k):\n    \"\"\"Returns tuples where all elements are divisible by k.\"\"\"\n    result = []\n    for tuple_item in tuples_list:\n        if all(element % k == 0 for element in tuple_item):\n            result.append(tuple_item)\n    return result"}
{"task_id": "Mbpp/75", "solution": "\"\"\"\nWrite a function to find tuples which have all elements divisible by k from the given list of tuples.\nassert find_tuples([(6, 24, 12), (7, 9, 6), (12, 18, 21)], 6) == [(6, 24, 12)]\n\"\"\"\ndef find_tuples(test_list, k):\n    \"\"\"Return tuples where all elements are divisible by k.\"\"\"\n    result = []\n    for tup in test_list:\n        if all(element % k == 0 for element in tup):\n            result.append(tup)\n    return result"}
{"task_id": "Mbpp/71", "solution": "\"\"\"\nWrite a function to sort a list of elements.\nassert comb_sort([5, 15, 37, 25, 79]) == [5, 15, 25, 37, 79]\n\"\"\"\n```python\ndef comb_sort(lst):\n    \"\"\"Sorts a list using the comb sort algorithm.\"\"\"\n    if len(lst) <= 1:\n        return lst\n    \n    arr = lst.copy()\n    gap = len(arr)\n    shrink = 1.3\n    sorted = False\n    \n    while not sorted:\n        gap = int(gap / shrink)\n        if gap <= 1:\n            gap = 1\n            sorted = True\n        \n        i = 0\n        while i + gap < len(arr):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                sorted = False\n            i += 1\n    \n    return arr\n```"}
{"task_id": "Mbpp/74", "solution": "\"\"\"\nWrite a function to check whether it follows the sequence given in the patterns array.\nassert is_samepatterns([\"red\",\"green\",\"green\"], [\"a\", \"b\", \"b\"])==True\n\"\"\"\ndef is_samepatterns(colors, patterns):\n    \"\"\"Check if colors follow the same pattern as the patterns array.\"\"\"\n    if len(colors) != len(patterns):\n        return False\n    \n    color_to_pattern = {}\n    pattern_to_color = {}\n    \n    for i in range(len(colors)):\n        color = colors[i]\n        pattern = patterns[i]\n        \n        if color in color_to_pattern:\n            if color_to_pattern[color] != pattern:\n                return False\n        else:\n            color_to_pattern[color] = pattern\n            \n        if pattern in pattern_to_color:\n            if pattern_to_color[pattern] != color:\n                return False\n        else:\n            pattern_to_color[pattern] = color\n    \n    return True"}
{"task_id": "Mbpp/74", "solution": "\"\"\"\nWrite a function to check whether it follows the sequence given in the patterns array.\nassert is_samepatterns([\"red\",\"green\",\"green\"], [\"a\", \"b\", \"b\"])==True\n\"\"\"\ndef is_samepatterns(colors, pattern):\n    \"\"\"Check if colors follow the same pattern as the given pattern array.\"\"\"\n    if len(colors) != len(pattern):\n        return False\n    \n    color_to_pattern = {}\n    pattern_to_color = {}\n    \n    for i in range(len(colors)):\n        color = colors[i]\n        pat = pattern[i]\n        \n        if color in color_to_pattern:\n            if color_to_pattern[color] != pat:\n                return False\n        else:\n            color_to_pattern[color] = pat\n            \n        if pat in pattern_to_color:\n            if pattern_to_color[pat] != color:\n                return False\n        else:\n            pattern_to_color[pat] = color\n    \n    return True"}
{"task_id": "Mbpp/77", "solution": "\"\"\"\nWrite a python function to find whether a number is divisible by 11.\nassert is_Diff (12345) == False\n\"\"\"\ndef is_Diff(n):\n    # Calculate alternating sum of digits to check divisibility by 11\n    alternating_sum = 0\n    sign = 1\n    while n > 0:\n        alternating_sum += sign * (n % 10)\n        sign *= -1\n        n //= 10\n    return alternating_sum % 11 == 0"}
{"task_id": "Mbpp/77", "solution": "\"\"\"\nWrite a python function to find whether a number is divisible by 11.\nassert is_Diff (12345) == False\n\"\"\"\ndef is_Diff(n):\n    \"\"\"Check if a number is divisible by 11 using alternating sum of digits.\"\"\"\n    n = abs(n)\n    alternating_sum = 0\n    sign = 1\n    \n    while n > 0:\n        digit = n % 10\n        alternating_sum += sign * digit\n        sign *= -1\n        n //= 10\n    \n    return alternating_sum % 11 == 0"}
