{"task_id": "Mbpp/771", "solution": "\"\"\"\nWrite a function to check if the given expression is balanced or not. \nassert check_expression(\"{()}[{}]\") == True\n\"\"\"\ndef check_expression(expression):\n    \"\"\"Check if brackets are balanced in the given expression.\"\"\"\n    stack = []\n    pairs = {'(': ')', '{': '}', '[': ']'}\n    \n    for char in expression:\n        if char in pairs:\n            stack.append(char)\n        elif char in pairs.values():\n            if not stack or pairs[stack.pop()] != char:\n                return False\n    \n    return len(stack) == 0"}
{"task_id": "Mbpp/771", "solution": "\"\"\"\nWrite a function to check if the given expression is balanced or not. \nassert check_expression(\"{()}[{}]\") == True\n\"\"\"\ndef check_expression(expression):\n    \"\"\"Check if brackets in expression are properly balanced.\"\"\"\n    stack = []\n    pairs = {'(': ')', '[': ']', '{': '}'}\n    \n    for char in expression:\n        if char in pairs:\n            stack.append(char)\n        elif char in pairs.values():\n            if not stack or pairs[stack.pop()] != char:\n                return False\n    \n    return len(stack) == 0"}
