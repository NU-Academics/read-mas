{"task_id": "Mbpp/119", "solution": "\"\"\"\nWrite a python function to find the element that appears only once in a sorted array.\nassert search([1,1,2,2,3]) == 3\n\"\"\"\ndef search(arr):\n    \"\"\"Find the element that appears only once in a sorted array.\"\"\"\n    left, right = 0, len(arr) - 1\n    \n    while left < right:\n        mid = (left + right) // 2\n        \n        # If mid is even, its pair should be at mid+1\n        # If mid is odd, its pair should be at mid-1\n        if mid % 2 == 0:\n            if arr[mid] == arr[mid + 1]:\n                left = mid + 2\n            else:\n                right = mid\n        else:\n            if arr[mid] == arr[mid - 1]:\n                left = mid + 1\n            else:\n                right = mid\n    \n    return arr[left]"}
{"task_id": "Mbpp/124", "solution": "\"\"\"\nWrite a function to get the angle of a complex number.\nassert math.isclose(angle_complex(0,1j), 1.5707963267948966, rel_tol=0.001)\n\"\"\"\n```python\nimport math\n\ndef angle_complex(real, imag):\n    \"\"\"Returns the angle of a complex number in radians.\"\"\"\n    return math.atan2(imag, real)\n```"}
{"task_id": "Mbpp/119", "solution": "\"\"\"\nWrite a python function to find the element that appears only once in a sorted array.\nassert search([1,1,2,2,3]) == 3\n\"\"\"\ndef search(arr):\n    \"\"\"Find the element that appears only once in a sorted array using binary search.\"\"\"\n    left, right = 0, len(arr) - 1\n    \n    while left < right:\n        mid = (left + right) // 2\n        \n        # If mid is even and arr[mid] == arr[mid+1], or mid is odd and arr[mid] == arr[mid-1]\n        # then the single element is in the right half\n        if (mid % 2 == 0 and mid + 1 < len(arr) and arr[mid] == arr[mid + 1]) or \\\n           (mid % 2 == 1 and arr[mid] == arr[mid - 1]):\n            left = mid + 1\n        else:\n            right = mid\n    \n    return arr[left]"}
{"task_id": "Mbpp/125", "solution": "\"\"\"\nWrite a function to find the maximum difference between the number of 0s and number of 1s in any sub-string of the given binary string.\nassert find_length(\"11000010001\") == 6\n\"\"\"\ndef find_length(binary_string):\n    \"\"\"Find max difference between 0s and 1s in any substring.\"\"\"\n    max_diff = 0\n    n = len(binary_string)\n    \n    for i in range(n):\n        zeros = 0\n        ones = 0\n        for j in range(i, n):\n            if binary_string[j] == '0':\n                zeros += 1\n            else:\n                ones += 1\n            max_diff = max(max_diff, abs(zeros - ones))\n    \n    return max_diff"}
{"task_id": "Mbpp/123", "solution": "\"\"\"\nWrite a function to sum all amicable numbers from 1 to a specified number.\nassert amicable_numbers_sum(999)==504\n\"\"\"\ndef amicable_numbers_sum(n):\n    \"\"\"Returns the sum of all amicable numbers from 1 to n.\"\"\"\n    def sum_of_divisors(num):\n        total = 0\n        for i in range(1, int(num**0.5) + 1):\n            if num % i == 0:\n                total += i\n                if i != 1 and i != num // i:\n                    total += num // i\n        return total\n    \n    amicable_sum = 0\n    for i in range(1, n + 1):\n        divisor_sum = sum_of_divisors(i)\n        if divisor_sum != i and divisor_sum <= n and sum_of_divisors(divisor_sum) == i:\n            amicable_sum += i\n    \n    return amicable_sum"}
{"task_id": "Mbpp/123", "solution": "\"\"\"\nWrite a function to sum all amicable numbers from 1 to a specified number.\nassert amicable_numbers_sum(999)==504\n\"\"\"\ndef amicable_numbers_sum(n):\n    \"\"\"Returns the sum of all amicable numbers from 1 to n.\"\"\"\n    def sum_proper_divisors(num):\n        if num <= 1:\n            return 0\n        divisor_sum = 1\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                divisor_sum += i\n                if i != num // i:\n                    divisor_sum += num // i\n        return divisor_sum\n    \n    amicable_sum = 0\n    for i in range(1, n + 1):\n        sum_i = sum_proper_divisors(i)\n        sum_sum_i = sum_proper_divisors(sum_i)\n        if i == sum_sum_i and i != sum_i:\n            amicable_sum += i\n    \n    return amicable_sum"}
{"task_id": "Mbpp/125", "solution": "\"\"\"\nWrite a function to find the maximum difference between the number of 0s and number of 1s in any sub-string of the given binary string.\nassert find_length(\"11000010001\") == 6\n\"\"\"\ndef find_length(binary_string):\n    # Convert to array where 0s become +1 and 1s become -1\n    arr = [1 if c == '0' else -1 for c in binary_string]\n    \n    # Find maximum subarray sum using Kadane's algorithm\n    max_sum = float('-inf')\n    current_sum = 0\n    \n    for num in arr:\n        current_sum = max(num, current_sum + num)\n        max_sum = max(max_sum, current_sum)\n    \n    return max_sum"}
{"task_id": "Mbpp/126", "solution": "\"\"\"\nWrite a python function to find the sum of common divisors of two given numbers.\nassert sum(10,15) == 6\n\"\"\"\ndef sum_common_divisors(a, b):\n    \"\"\"Find the sum of common divisors of two numbers.\"\"\"\n    def gcd(x, y):\n        while y:\n            x, y = y, x % y\n        return x\n    \n    g = gcd(a, b)\n    total = 0\n    for i in range(1, int(g**0.5) + 1):\n        if g % i == 0:\n            total += i\n            if i != g // i:\n                total += g // i\n    return total"}
