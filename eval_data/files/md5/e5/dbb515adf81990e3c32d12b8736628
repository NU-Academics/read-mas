{"task_id": "Mbpp/733", "solution": "\"\"\"\nWrite a function to find the index of the first occurrence of a given number in a sorted array.\nassert find_first_occurrence([2, 5, 5, 5, 6, 6, 8, 9, 9, 9], 5) == 1\n\"\"\"\n```python\ndef find_first_occurrence(arr, target):\n    \"\"\"Find the index of the first occurrence of target in sorted array.\"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n    \n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            right = mid - 1\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    \n    return result\n```"}
{"task_id": "Mbpp/733", "solution": "\"\"\"\nWrite a function to find the index of the first occurrence of a given number in a sorted array.\nassert find_first_occurrence([2, 5, 5, 5, 6, 6, 8, 9, 9, 9], 5) == 1\n\"\"\"\ndef find_first_occurrence(arr, target):\n    \"\"\"Find the index of the first occurrence of target in sorted array.\"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n    \n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            right = mid - 1\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    \n    return result"}
{"task_id": "Mbpp/736", "solution": "\"\"\"\nWrite a function to locate the left insertion point for a specified value in sorted order. \nassert left_insertion([1,2,4,5],6)==4\n\"\"\"\ndef left_insertion(arr, target):\n    \"\"\"Find the leftmost position where target can be inserted to maintain sorted order.\"\"\"\n    left, right = 0, len(arr)\n    while left < right:\n        mid = (left + right) // 2\n        if arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "Mbpp/734", "solution": "\"\"\"\nWrite a python function to find sum of products of all possible sublists of a given list. \nassert sum_Of_Subarray_Prod([1,2,3]) == 20\n\"\"\"\ndef sum_Of_Subarray_Prod(arr):\n    \"\"\"Find sum of products of all possible sublists.\"\"\"\n    total = 0\n    n = len(arr)\n    \n    for i in range(n):\n        for j in range(i, n):\n            product = 1\n            for k in range(i, j + 1):\n                product *= arr[k]\n            total += product\n    \n    return total"}
{"task_id": "Mbpp/734", "solution": "\"\"\"\nWrite a python function to find sum of products of all possible sublists of a given list. \nassert sum_Of_Subarray_Prod([1,2,3]) == 20\n\"\"\"\n```python\ndef sum_Of_Subarray_Prod(arr):\n    \"\"\"Find sum of products of all possible sublists.\"\"\"\n    total = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i, n):\n            product = 1\n            for k in range(i, j + 1):\n                product *= arr[k]\n            total += product\n    return total\n```"}
{"task_id": "Mbpp/736", "solution": "\"\"\"\nWrite a function to locate the left insertion point for a specified value in sorted order. \nassert left_insertion([1,2,4,5],6)==4\n\"\"\"\ndef left_insertion(arr, value):\n    \"\"\"Find the leftmost position where value can be inserted to keep array sorted.\"\"\"\n    left, right = 0, len(arr)\n    while left < right:\n        mid = (left + right) // 2\n        if arr[mid] < value:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "Mbpp/735", "solution": "\"\"\"\nWrite a python function to toggle bits of the number except the first and the last bit. \nassert toggle_middle_bits(9) == 15\n\"\"\"\ndef toggle_middle_bits(n):\n    \"\"\"Toggle all bits except the first and last bit of the number.\"\"\"\n    if n <= 3:\n        return n\n    \n    # Find the position of the most significant bit\n    msb_pos = n.bit_length() - 1\n    \n    # Create a mask with all middle bits set to 1\n    mask = ((1 << (msb_pos - 1)) - 1) << 1\n    \n    # Toggle the middle bits\n    return n ^ mask"}
{"task_id": "Mbpp/737", "solution": "\"\"\"\nWrite a function to check whether the given string is starting with a vowel or not using regex.\nassert check_str(\"annie\")\n\"\"\"\n```python\ndef check_str(string):\n    \"\"\"Check if string starts with a vowel using regex.\"\"\"\n    import re\n    return bool(re.match(r'^[aeiouAEIOU]', string))\n```"}
{"task_id": "Mbpp/735", "solution": "\"\"\"\nWrite a python function to toggle bits of the number except the first and the last bit. \nassert toggle_middle_bits(9) == 15\n\"\"\"\ndef toggle_middle_bits(n):\n    \"\"\"Toggle all bits except the first and last bit.\"\"\"\n    if n <= 3:\n        return n\n    \n    # Find the position of the highest set bit\n    temp = n\n    bit_count = 0\n    while temp:\n        bit_count += 1\n        temp >>= 1\n    \n    # Create mask for middle bits (all bits except first and last)\n    mask = ((1 << (bit_count - 2)) - 1) << 1\n    \n    return n ^ mask"}
{"task_id": "Mbpp/739", "solution": "\"\"\"\nWrite a python function to find the index of smallest triangular number with n digits. \nassert find_Index(2) == 4\n\"\"\"\ndef find_Index(n):\n    \"\"\"Find the index of smallest triangular number with n digits.\"\"\"\n    min_value = 10**(n-1)\n    index = 1\n    while True:\n        triangular = index * (index + 1) // 2\n        if triangular >= min_value:\n            return index\n        index += 1"}
