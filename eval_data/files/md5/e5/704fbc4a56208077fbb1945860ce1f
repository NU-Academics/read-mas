{"task_id": "HumanEval/31", "solution": "import math\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisors from 3 up to the square root of n, incrementing by 2\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n            \n    return True"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    max_val = l[0]\n    for element in l:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    l_prime = [None] * len(l)\n    divisible_by_three_elements = []\n    divisible_by_three_indices = []\n\n    for i in range(len(l)):\n        if i % 3 != 0:\n            l_prime[i] = l[i]\n        else:\n            divisible_by_three_elements.append(l[i])\n            divisible_by_three_indices.append(i)\n\n    divisible_by_three_elements.sort()\n\n    for i in range(len(divisible_by_three_indices)):\n        original_index = divisible_by_three_indices[i]\n        sorted_element = divisible_by_three_elements[i]\n        l_prime[original_index] = sorted_element\n\n    return l_prime"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a mutable copy of the input list to store the result\n    result_list = list(l)\n\n    # Collect elements at even indices\n    even_values = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_values.append(l[i])\n\n    # Sort the collected even-indexed values\n    even_values.sort()\n\n    # Place the sorted even values back into the even indices of the result list\n    even_idx_counter = 0\n    for i in range(len(result_list)):\n        if i % 2 == 0:\n            result_list[i] = even_values[even_idx_counter]\n            even_idx_counter += 1\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    low = -1000.0\n    high = 1000.0\n    tolerance = 1e-7\n    max_iterations = 1000\n\n    y_low = poly(xs, low)\n    y_high = poly(xs, high)\n\n    # Check if a boundary point is already a root.\n    if abs(y_low) < tolerance:\n        return low\n    if abs(y_high) < tolerance:\n        return high\n\n    for _ in range(max_iterations):\n        mid = (low + high) / 2.0\n        y_mid = poly(xs, mid)\n\n        # If the function value at mid is close to zero, it's a root.\n        if abs(y_mid) < tolerance:\n            return mid\n\n        # If the interval is sufficiently small, return its midpoint.\n        if (high - low) < tolerance:\n            return mid\n\n        # Narrow the interval based on the sign of y_mid.\n        if y_low * y_mid < 0:  # Root is in the left half [low, mid]\n            high = mid\n            y_high = y_mid\n        else:  # Root is in the right half [mid, high]\n            low = mid\n            y_low = y_mid\n\n    # Return the midpoint of the final interval after max_iterations.\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(x: int) -> bool:\n    \"\"\"Determines if an integer 'x' is divisible by 11 or 13.\"\"\"\n    return (x % 11 == 0) or (x % 13 == 0)\n\ndef _count_digit_7(x: int) -> int:\n    \"\"\"Counts the occurrences of the digit '7' within the decimal representation of an integer 'x'.\"\"\"\n    return str(x).count('7')\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens_count += _count_digit_7(i)\n    return total_sevens_count"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def generate_fibonacci_sequence():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    found_primes = 0\n    fib_gen = generate_fibonacci_sequence()\n\n    # Skip initial Fibonacci numbers that are not primes or too small (0, 1, 1)\n    # The first prime Fibonacci number is 2, which is fib(3) if sequence starts 0,1,1,2...\n    # The examples indicate we start counting from 2 as the 1st.\n    next(fib_gen) # yields 0\n    next(fib_gen) # yields 1\n    next(fib_gen) # yields 1\n\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            found_primes += 1\n            if found_primes == n:\n                return fib_num"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
