{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    max_prime_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        max_prime_factor = 2\n        n //= 2\n\n    # n must be odd at this point, so we can skip even numbers\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            max_prime_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, then it must be the largest prime factor\n    if n > 2:\n        max_prime_factor = n\n\n    return max_prime_factor"}
{"task_id": "HumanEval/62", "solution": "from typing import List\n\nclass Polynomial:\n    \"\"\"\n    Represents a polynomial by its coefficients.\n    coefficients[i] is the coefficient of x^i.\n    \"\"\"\n    def __init__(self, coefficients: List[float]):\n        self._coefficients = [float(c) for c in coefficients]\n\n    def get_coefficients(self) -> List[float]:\n        \"\"\"Returns the raw list of coefficients.\"\"\"\n        return self._coefficients\n\n    def calculate_derivative(self) -> 'Polynomial':\n        \"\"\"\n        Computes the derivative of this polynomial.\n        Returns a new Polynomial object representing the derivative.\n        \"\"\"\n        if not self._coefficients or len(self._coefficients) == 1:\n            return Polynomial([])\n\n        derivative_coeffs: List[float] = []\n        for i in range(1, len(self._coefficients)):\n            coeff = self._coefficients[i]\n            new_coeff = coeff * i\n            derivative_coeffs.append(new_coeff)\n\n        return Polynomial(derivative_coeffs)\n\ndef derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1.0, 4.0, 12.0, 20.0]\n    >>> derivative([1, 2, 3])\n    [2.0, 6.0]\n    \"\"\"\n    polynomial = Polynomial(xs)\n    derivative_polynomial = polynomial.calculate_derivative()\n    return derivative_polynomial.get_coefficients()"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if every opening bracket has a corresponding closing bracket.\n    Uses a counter to track the balance of opening and closing brackets.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # If balance drops below zero, a closing bracket appeared without a preceding opening bracket.\n        if balance < 0:\n            return False\n            \n    # After iterating, if balance is zero, all brackets are correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/64", "solution": "class _Character:\n    \"\"\"Represents a single character and provides methods to check its basic vowel properties.\"\"\"\n    def __init__(self, char_value: str):\n        self._value = char_value.lower()\n\n    def is_standard_vowel(self) -> bool:\n        \"\"\"Checks if the character is 'a', 'e', 'i', 'o', or 'u'.\"\"\"\n        return self._value in {'a', 'e', 'i', 'o', 'u'}\n\n    def is_y(self) -> bool:\n        \"\"\"Checks if the character is 'y'.\"\"\"\n        return self._value == 'y'\n\nclass _VowelDefinition:\n    \"\"\"Defines and applies the rules for identifying vowels.\"\"\"\n    def __init__(self):\n        self._standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(self, char: _Character, is_last_char: bool) -> bool:\n        \"\"\"Determines if a given character is a vowel based on its value and position.\"\"\"\n        if char.is_standard_vowel():\n            return True\n        if char.is_y() and is_last_char:\n            return True\n        return False\n\ndef vowels_count(s):\n    \"\"\"Counts the number of vowels in an input string according to the defined rules.\"\"\"\n    vowel_count = 0\n    vowel_definition = _VowelDefinition()\n\n    for i, char_value in enumerate(s):\n        char_obj = _Character(char_value)\n        is_last_char = (i == len(s) - 1)\n        if vowel_definition.is_vowel(char_obj, is_last_char):\n            vowel_count += 1\n    return vowel_count"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        # Reverse the digits if shift is greater than the number of digits\n        return s_x[::-1]\n    else:\n        # Perform a circular right shift\n        # The last 'shift' digits move to the beginning\n        # The remaining digits follow\n        return s_x[-shift:] + s_x[:-shift]"}
{"task_id": "HumanEval/63", "solution": "_memo: dict[int, int] = {}\n\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values for uppercase characters in a string.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits given a string of apple/orange counts and total fruits.\n    It delegates parsing to a helper function.\n    \"\"\"\n    def _parse_fruit_counts(s_inner):\n        \"\"\"\n        Parses the input string to extract apple and orange counts.\n        Returns them as a tuple (apple_count, orange_count).\n        \"\"\"\n        parts = s_inner.split(' apples and ')\n        apple_str = parts[0]\n        orange_str_with_suffix = parts[1]\n\n        apple_count = int(apple_str)\n        orange_count = int(orange_str_with_suffix.split(' oranges')[0])\n        \n        return apple_count, orange_count\n\n    apple_count, orange_count = _parse_fruit_counts(s)\n    total_known_fruits = apple_count + orange_count\n    mango_count = n - total_known_fruits\n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the node with the smallest even value and its index.\n    Returns [value, index] or an empty list if no even values or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n    found_even = False\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if not found_even:\n                smallest_even_value = value\n                smallest_even_index = i\n                found_even = True\n            elif value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value:\n                # If values are equal, choose the one with the smaller index\n                if i < smallest_even_index:\n                    smallest_even_index = i\n\n    if found_even:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    working_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            result.append(working_list.pop(0)) # Get and remove minimum\n        else:\n            result.append(working_list.pop(-1)) # Get and remove maximum\n        is_min_turn = not is_min_turn # Alternate between min and max turns\n\n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    def _is_palindrome(q_list):\n        # Checks if a list of integers is a palindrome.\n        return q_list == q_list[::-1]\n\n    def _sum_elements(q_list):\n        # Calculates the sum of all integer elements in the list.\n        return sum(q_list)\n\n    is_balanced = _is_palindrome(q)\n    current_weight = _sum_elements(q)\n\n    return is_balanced and (current_weight <= w)"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = collections.Counter(lst)\n    \n    valid_integers = []\n    for num, freq in frequencies.items():\n        if num > 0 and freq >= num:\n            valid_integers.append(num)\n            \n    if valid_integers:\n        return max(valid_integers)\n    else:\n        return -1"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Sides must be positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Check the triangle inequality theorem: sum of any two sides must be greater than the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Round the area to 2 decimal points.\n    return round(area, 2)"}
{"task_id": "HumanEval/74", "solution": "from typing import List\n\ndef _calculate_total_characters(string_list: List[str]) -> int:\n    \"\"\"Calculates the total number of characters for all strings in a list.\"\"\"\n    total_chars = 0\n    for s in string_list:\n        total_chars += len(s)\n    return total_chars\n\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Compares two lists of strings by total character counts and returns the list with fewer characters,\n    or the first list if counts are equal.\n    \"\"\"\n    total_chars_lst1 = _calculate_total_characters(lst1)\n    total_chars_lst2 = _calculate_total_characters(lst2)\n\n    if total_chars_lst1 < total_chars_lst2:\n        return lst1\n    elif total_chars_lst2 < total_chars_lst1:\n        return lst2\n    else:\n        return lst1"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes_count = 0\n    n = len(arr)\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes_count += 1\n    return changes_count"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _get_prime_factors(n):\n        \"\"\"Computes and returns a list of all prime factors for a given integer n, including multiplicity.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            if temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            else:\n                d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    if a <= 1 or a >= 100:\n        return False\n\n    prime_factors = _get_prime_factors(a)\n\n    if len(prime_factors) == 3:\n        # Verify that all factors are indeed prime numbers (redundant if _get_prime_factors is perfect, but safer)\n        for factor in prime_factors:\n            if not _is_prime(factor):\n                return False\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/78", "solution": "class PrimeHexadecimalDigitSet:\n    \"\"\"A central, immutable repository for the decimal values of prime hexadecimal digits.\"\"\"\n    _prime_decimal_values: frozenset[int] = frozenset([2, 3, 5, 7, 11, 13])\n\n    @staticmethod\n    def is_decimal_prime(decimal_value: int) -> bool:\n        \"\"\"Checks if a given decimal value is present in the set of prime hexadecimal digits.\"\"\"\n        return decimal_value in PrimeHexadecimalDigitSet._prime_decimal_values\n\nclass HexadecimalDigit:\n    \"\"\"Encapsulates a single hexadecimal character, provides its decimal equivalent, and determines if it represents a prime hexadecimal value.\"\"\"\n    def __init__(self, char_value: str):\n        self._char_value = char_value\n        self._decimal_value = self._to_decimal()\n\n    def _to_decimal(self) -> int:\n        \"\"\"Converts the hexadecimal character to its decimal equivalent.\"\"\"\n        return int(self._char_value, 16)\n\n    def is_prime(self) -> bool:\n        \"\"\"Checks if the hexadecimal digit (by its decimal value) is a known prime hexadecimal digit.\"\"\"\n        return PrimeHexadecimalDigitSet.is_decimal_prime(self._decimal_value)\n\ndef hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\n\n    Args:\n        num: The hexadecimal number as a string (e.g., 'AB', '1077E').\n\n    Returns:\n        The total count of prime hexadecimal digits (2, 3, 5, 7, B, D).\n    \"\"\"\n    prime_count = 0\n    for char in num:\n        hex_digit = HexadecimalDigit(char)\n        if hex_digit.is_prime():\n            prime_count += 1\n    return prime_count"}
{"task_id": "HumanEval/77", "solution": "import math\n\ndef iscube(a):\n    \"\"\"\n    Determines if an integer 'a' is the cube of some integer number.\n    \"\"\"\n    if a == 0:\n        return True\n\n    root_candidate = round(a**(1/3))\n    return root_candidate * root_candidate * root_candidate == a"}
{"task_id": "HumanEval/76", "solution": "import math\n\ndef is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    \"\"\"\n    if n == 1.0:\n        return x == 1.0\n\n    if n == 0.0:\n        return x == 0.0\n\n    if x == 1.0:\n        return True\n\n    if x == 0.0:\n        return False\n\n    if x < 0 or n < 0:\n        return False\n\n    try:\n        exponent = math.log(x, n)\n    except ValueError:\n        return False\n    except ZeroDivisionError:\n        return False\n\n    return math.isclose(exponent, round(exponent))"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal integer to a formatted binary string with 'db' prefix and suffix.\"\"\"\n    if decimal == 0:\n        raw_binary = \"0\"\n    else:\n        raw_binary = bin(decimal)[2:]\n\n    formatted_string = \"db\" + raw_binary + \"db\"\n    return formatted_string"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(number: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\n    A number is prime if it is an integer greater than 1 and has no positive\n    divisors other than 1 and itself.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the current three consecutive characters are distinct.\n        if not (s[i] != s[i+1] and s[i] != s[i+2] and s[i+1] != s[i+2]):\n            return False\n            \n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    if n == 1:\n        # For 1-digit numbers, 1 starts with 1 and ends with 1.\n        # Numbers are 1, 2, ..., 9. Only '1' satisfies the condition.\n        return 1\n\n    # Total n-digit numbers: 9 * 10^(n-1)\n    # Numbers starting with 1: 1 * 10^(n-1)\n    # Numbers ending with 1: 9 * 10^(n-2) for n > 1\n    # Numbers starting AND ending with 1: 1 * 10^(n-2) for n > 1\n\n    # Count of numbers starting with 1\n    count_starts_with_one = 10**(n - 1)\n\n    # Count of numbers ending with 1\n    # The first digit cannot be 0, so there are 9 choices for the first digit\n    # (2-9, or 1 if it's not also 1 at the start).\n    # And 10 choices for intermediate digits.\n    # If the number ends with 1: _ _ ... _ 1\n    # There are n-1 positions before the last digit.\n    # The first position can be 1-9 (9 choices).\n    # The remaining n-2 positions can be 0-9 (10^(n-2) choices).\n    count_ends_with_one = 9 * (10**(n - 2))\n\n    # Count of numbers starting with 1 AND ending with 1\n    # For n-digit numbers: 1 _ _ ... _ 1\n    # The middle n-2 digits can be any digit from 0-9.\n    count_starts_and_ends_with_one = 10**(n - 2)\n\n    # Apply the Inclusion-Exclusion Principle:\n    # P(A or B) = P(A) + P(B) - P(A and B)\n    total_count = count_starts_with_one + count_ends_with_one - count_starts_and_ends_with_one\n\n    return total_count"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades\n    based on a predefined grading scale.\n    \"\"\"\n    \n    result_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            result_grades.append('A+')\n        elif gpa > 3.7:\n            result_grades.append('A')\n        elif gpa > 3.3:\n            result_grades.append('A-')\n        elif gpa > 3.0:\n            result_grades.append('B+')\n        elif gpa > 2.7:\n            result_grades.append('B')\n        elif gpa > 2.3:\n            result_grades.append('B-')\n        elif gpa > 2.0:\n            result_grades.append('C+')\n        elif gpa > 1.7:\n            result_grades.append('C')\n        elif gpa > 1.3:\n            result_grades.append('C-')\n        elif gpa > 1.0:\n            result_grades.append('D+')\n        elif gpa > 0.7:\n            result_grades.append('D')\n        elif gpa > 0.0:\n            result_grades.append('D-')\n        elif gpa == 0.0:\n            result_grades.append('E')\n    \n    return result_grades"}
