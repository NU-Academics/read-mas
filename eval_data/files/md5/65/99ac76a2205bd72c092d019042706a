{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:  # Handles FR5: Empty input list\n        return []\n\n    filtered_strings: List[str] = []\n    # FR3 and FR4: Iterate and add strings containing the substring (case-sensitive).\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n\n    return filtered_strings\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef _calculate_group_depth(group_string: str) -> int:\n    \"\"\"\n    Calculates the deepest level of nesting for a single group of parentheses.\n    It tracks current depth and updates the maximum depth encountered.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    result_depths = []\n    groups = paren_string.split(' ')\n    for group_string in groups:\n        depth = _calculate_group_depth(group_string)\n        result_depths.append(depth)\n    return result_depths\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    output_list = []\n    if not numbers:\n        return output_list\n\n    current_max = numbers[0]\n    output_list.append(current_max)\n\n    for number in numbers[1:]:\n        current_max = max(current_max, number)\n        output_list.append(current_max)\n\n    return output_list\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of integers in a list.\n    Returns (0, 1) for an empty list.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    It identifies the longest palindromic suffix and prepends the reverse of the remaining prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:-longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the given string.\n    This helper function is used internally by make_palindrome.\"\"\"\n    return s[::-1]\n\n\ndef _find_longest_palindromic_postfix(s: str) -> str:\n    \"\"\"Finds the longest suffix of 's' that is also a palindrome.\n    It iterates through all possible postfixes, checking each for the palindromic property.\"\"\"\n    for i in range(len(s)):\n        postfix = s[i:]\n        if is_palindrome(postfix):\n            return postfix\n    return \"\"\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    It constructs this by reversing the prefix that precedes the longest palindromic postfix and appending it.\"\"\"\n    if not string:\n        return \"\"\n\n    longest_pal_postfix = _find_longest_palindromic_postfix(string)\n\n    prefix_len = len(string) - len(longest_pal_postfix)\n    prefix_to_reverse = string[:prefix_len]\n\n    reversed_prefix = _reverse_string(prefix_to_reverse)\n\n    return string + reversed_prefix\n```"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef _perform_bitwise_xor(char_a: str, char_b: str) -> str:\n    \"\"\"Performs a bitwise XOR operation on two single binary characters.\n    Returns '0' if characters are the same, '1' otherwise.\n    \"\"\"\n    return str(int(char_a) ^ int(char_b))\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars: List[str] = []\n    for char_a, char_b in zip(a, b):\n        result_chars.append(_perform_bitwise_xor(char_a, char_b))\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found: Optional[str] = None\n    max_length: int = -1\n\n    for current_string in strings:\n        current_string_length = len(current_string)\n        if current_string_length > max_length:\n            max_length = current_string_length\n            longest_found = current_string\n\n    return longest_found\n```"}
