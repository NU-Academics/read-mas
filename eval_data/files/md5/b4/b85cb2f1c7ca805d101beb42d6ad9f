{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    result_digits = []\n    while x > 0:\n        remainder = x % base\n        result_digits.append(str(remainder))\n        x //= base\n    \n    return \"\".join(result_digits[::-1])"}
{"task_id": "HumanEval/43", "solution": "from typing import List\nclass InputList:\n    \"\"\"Wraps a list of elements, preserving original indices.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = [Element(value, i) for i, value in enumerate(elements)]\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int): # -> Element\n        return self._elements[index]\nclass Element:\n    \"\"\"Represents a value with its original index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\nclass Result:\n    \"\"\"Encapsulates a boolean outcome.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\ndef _validate_input(l) -> bool:\n    \"\"\"Validates input type and minimum length.\"\"\"\n    return isinstance(l, list) and len(l) >= 2\ndef _build_inputlist(l: list) -> InputList:\n    \"\"\"Converts a raw list into an InputList of Element objects.\"\"\"\n    return InputList(l)\ndef _find_zero_sum_pair(input_list: InputList) -> bool:\n    \"\"\"\n    Determines if any distinct pair of elements in input_list sums to zero.\n    Distinctness is by index.\n    \"\"\"\n    seen_indices_for_value: dict[int, List[int]] = {}\n\n    for i in range(input_list.length()):\n        current_element = input_list.get(i)\n        \n        complement = -current_element.value\n        \n        if complement in seen_indices_for_value:\n            for complement_index in seen_indices_for_value[complement]:\n                if current_element.index != complement_index:\n                    return True\n        \n        if current_element.value not in seen_indices_for_value:\n            seen_indices_for_value[current_element.value] = []\n        seen_indices_for_value[current_element.value].append(current_element.index)\n        \n    return False\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if not _validate_input(l):\n        return Result(False).value\n\n    input_list_obj = _build_inputlist(l)\n    has_zero_sum_pair = _find_zero_sum_pair(input_list_obj)\n    \n    return Result(has_zero_sum_pair).value"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence. Computes the n-th element efficiently without recursion.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize accumulators with the first four fib4 values:\n    # w = fib4(i-4), x = fib4(i-3), y = fib4(i-2), z = fib4(i-1)\n    w, x, y, z = 0, 0, 2, 0  # fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for _ in range(4, n + 1):\n        next_val = z + y + x + w\n        # Shift values: current (x, y, z, next_val) becomes new (w, x, y, z)\n        w, x, y, z = x, y, z, next_val\n        \n    return z"}
{"task_id": "HumanEval/47", "solution": "class InputList:\n    def __init__(self, elements: list) -> None:\n        # Create a copy to ensure the original caller's list is not indirectly modified\n        self._elements = list(elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def sorted_copy(self) -> list:\n        \"\"\"Returns a new, sorted copy of the elements.\"\"\"\n        return sorted(self._elements)\ndef validate_input(l: list) -> bool:\n    # Per implementation constraints, no isinstance checks or exceptions are added here.\n    # This function acts as a placeholder for validation logic as per design FR-8.\n    return True\ndef compute_median(sorted_list: list) -> float:\n    \"\"\"Computes the median from an already sorted list of numbers.\"\"\"\n    n = len(sorted_list)\n    if n % 2 == 1:\n        # Odd number of elements, return the middle element\n        return float(sorted_list[n // 2])\n    else:\n        # Even number of elements, return the average of the two middle elements\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (float(mid1) + float(mid2)) / 2.0\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    validate_input(l)\n    \n    # Use InputList to manage the list and ensure non-mutation of the original.\n    input_wrapper = InputList(l)\n    sorted_elements = input_wrapper.sorted_copy()\n    \n    return compute_median(sorted_elements)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/49", "solution": "class InputParameter:\n    \"\"\"Typed holder for input parameters n and p.\"\"\"\n    def __init__(self, n: int, p: int):\n        self.n = n\n        self.p = p\nclass Validator:\n    \"\"\"Encapsulates validation rules for input parameters.\"\"\"\n    def validate_types(self, n, p) -> bool:\n        \"\"\"Verifies n and p are instances of int; raises TypeError for non-int.\"\"\"\n        if not isinstance(n, int) or not isinstance(p, int):\n            raise TypeError(\"Inputs n and p must be integers.\")\n        return True\n\n    def validate_modulus(self, p) -> bool:\n        \"\"\"Verifies p is not 0; raises ValueError for p == 0.\"\"\"\n        if p == 0:\n            raise ValueError(\"Modulus p cannot be zero.\")\n        return True\nclass ModularExponentiation:\n    \"\"\"Computes modular exponentiation using the binary method.\"\"\"\n    algorithm: str = \"binary modular exponentiation\"\n\n    def compute(self, n: int, p: int) -> int:\n        \"\"\"Implements 2^n mod p using binary modular exponentiation.\"\"\"\n        result = 1\n        base_mod = 2 % p\n\n        # Handles n=0 case by returning initial result=1, as the loop won't execute.\n        current_n = n\n        while current_n > 0:\n            if current_n & 1:  # Check if the least significant bit of current_n is 1\n                result = (result * base_mod) % p\n            base_mod = (base_mod * base_mod) % p\n            current_n >>= 1 # Right shift current_n by 1 (integer division by 2)\n\n        return result\nclass Result:\n    \"\"\"Typed holder for the computed integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    # Constructs InputParameter(n, p) as specified by the design.\n    input_params = InputParameter(n, p)\n\n    # Call Validator to validate input types and modulus.\n    validator = Validator()\n    validator.validate_types(n, p)\n    validator.validate_modulus(p)\n\n    # Call ModularExponentiation to perform the computation.\n    modular_exp = ModularExponentiation()\n    value = modular_exp.compute(n, p)\n\n    # Construct Result and return its value.\n    result_obj = Result(value=value)\n    return result_obj.value"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    Validate input and return decoded string by shifting each lowercase letter by -5 with modulo-26 wrap-around. Raises ValueError on invalid input.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    decoded_chars = []\n    for ch in s:\n        if not ('a' <= ch <= 'z'):\n            raise ValueError(\"input must contain only lowercase a-z\")\n        \n        # Shift character by -5 positions with modulo-26 wrap-around\n        shifted_ord = ((ord(ch) - ord('a') - 5) % 26) + ord('a')\n        decoded_chars.append(chr(shifted_ord))\n    \n    return \"\".join(decoded_chars)"}
{"task_id": "HumanEval/52", "solution": "import collections.abc\nfrom typing import Iterator\nclass InputList:\n    \"\"\"Represent the input list of numeric elements.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def __iter__(self) -> Iterator[float|int]:\n        return iter(self.elements)\nclass Threshold:\n    \"\"\"Represent the integer threshold parameter t.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass Result:\n    \"\"\"Represent the boolean result returned by the service.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\nclass BelowThresholdService:\n    \"\"\"Evaluate whether every element in InputList is strictly less than Threshold and produce a Result.\"\"\"\n    def below_threshold(self, l: 'InputList', t: 'Threshold') -> 'Result':\n        for element_value in l:\n            if element_value >= t.value:\n                return Result(False)\n        return Result(True)\ndef below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    \"\"\"\n    input_list = InputList(elements=l)\n    threshold = Threshold(value=t)\n    service = BelowThresholdService()\n    result = service.below_threshold(input_list, threshold)\n    return result.value"}
{"task_id": "HumanEval/51", "solution": "VOWELS = frozenset({'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'})\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel.\n\n    Returns True if the character is in the predefined VOWELS set, False otherwise.\n    \"\"\"\n    return char in VOWELS\ndef remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    result_chars = []\n    for char in text:\n        if not is_vowel(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
