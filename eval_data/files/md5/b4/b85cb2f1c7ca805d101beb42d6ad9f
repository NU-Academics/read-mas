{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result_list = []\n    for s in strings:\n        if substring in s:\n            result_list.append(s)\n    return result_list"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    return number - math.floor(number)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Iterate over all distinct unordered pairs of numbers\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Calculate the absolute difference between the two numbers\n            difference = abs(numbers[i] - numbers[j])\n            # Check if the difference is strictly less than the threshold\n            if difference < threshold:\n                return True\n    \n    # If no such pair is found after checking all combinations\n    return False"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    @dataclass(frozen=True)\n    class DepthResult:\n        group_index: int\n        max_depth: int\n\n    class Group:\n        def __init__(self, content: str, index: int) -> None:\n            self.content = content\n            self.index = index\n            self._current_depth = 0\n            self._max_depth = 0\n\n        def validate(self) -> bool:\n            \"\"\"Return True if every character in content is '(' or ')'.\"\"\"\n            for char in self.content:\n                if char not in ('(', ')'):\n                    return False\n            return True\n\n        def compute_max_depth(self) -> int:\n            \"\"\"Scan content left-to-right, increment _current_depth on '(', decrement on ')'.\n            Track _max_depth as maximum current_depth observed. Return _max_depth.\n            \"\"\"\n            self._current_depth = 0\n            self._max_depth = 0\n            for char in self.content:\n                if char == '(':\n                    self._current_depth += 1\n                elif char == ')':\n                    self._current_depth -= 1\n                self._max_depth = max(self._max_depth, self._current_depth)\n            return self._max_depth\n\n    class Parser:\n        def split_into_groups(self, paren_string: str) -> List[str]:\n            \"\"\"Split input string into group strings using spaces as separators.\"\"\"\n            return paren_string.split(' ')\n\n        def process_groups(self, groups: List[str]) -> List[int]:\n            \"\"\"For each group string, instantiate Group, compute max depth, collect results.\"\"\"\n            results: List[int] = []\n            for index, group_content in enumerate(groups):\n                group = Group(group_content, index)\n                # Validation is specified by design but no action on failure is defined.\n                # Assuming valid input as per problem example.\n                # if not group.validate():\n                #    # handle invalid group if requirements specify\n                #    pass\n                max_depth = group.compute_max_depth()\n                results.append(max_depth)\n            return results\n\n        def parse_nested_parens(self, paren_string: str) -> List[int]:\n            \"\"\"Orchestrates splitting groups and processing them for max depth.\"\"\"\n            groups = self.split_into_groups(paren_string)\n            return self.process_groups(groups)\n\n    parser_instance = Parser()\n    return parser_instance.parse_nested_parens(paren_string)"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Returns True if the running balance falls below zero at any point, otherwise False.\"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass MeanCalculator:\n    def compute_mean(self, numbers: List[float]) -> float:\n        \"\"\"Return arithmetic mean of numbers using Python float precision; do not mutate numbers.\"\"\"\n        return sum(numbers) / len(numbers)\nclass DeviationCalculator:\n    def compute_abs_diff(self, numbers: List[float], mean: float) -> List[float]:\n        \"\"\"Return a new list of absolute differences |x - mean| for each x in numbers; do not mutate numbers.\"\"\"\n        return [abs(x - mean) for x in numbers]\nclass MADCalculator:\n    def compute_mad(self, absDiffs: List[float]) -> float:\n        \"\"\"Return the arithmetic mean of absDiffs as a Python float. (Assumes at least one element per SRS preconditions.)\"\"\"\n        return sum(absDiffs) / len(absDiffs)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    mc = MeanCalculator()\n    mean = mc.compute_mean(numbers)\n    dc = DeviationCalculator()\n    abs_diffs = dc.compute_abs_diff(numbers, mean)\n    madc = MADCalculator()\n    result = madc.compute_mad(abs_diffs)\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\nclass ParenthesisString:\n    \"\"\"Holds raw input and normalizes it by removing whitespace.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def normalize(self) -> 'NormalizedString':\n        \"\"\"Removes all non-parenthesis characters (including whitespace).\"\"\"\n        content = \"\".join(char for char in self.raw if char in '()')\n        return NormalizedString(content)\nclass NormalizedString:\n    \"\"\"Holds whitespace-free content and provides length helper.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\nclass ParenGroup:\n    \"\"\"Represents a detected top-level parenthesis group.\"\"\"\n    def __init__(self, group_text: str, start_index: int, end_index: int, nesting_depth: int, sequence_position: int) -> None:\n        self.group_text = group_text\n        self.start_index = start_index\n        self.end_index = end_index  # Exclusive end index\n        self.nesting_depth = nesting_depth\n        self.sequence_position = sequence_position\nclass Parser:\n    \"\"\"Scans a NormalizedString to identify and emit top-level ParenGroup objects.\"\"\"\n    def __init__(self, input_str: NormalizedString) -> None:\n        self.input_str = input_str\n        self.groups: List[ParenGroup] = []\n\n    def parse(self) -> List[ParenGroup]:\n        \"\"\"Initiates the scan and returns the list of detected groups.\"\"\"\n        return self.scan_for_top_level_groups()\n\n    def scan_for_top_level_groups(self) -> List[ParenGroup]:\n        \"\"\"Performs a single-pass scan to find balanced top-level parenthesis groups.\"\"\"\n        counter = 0\n        start_index = -1\n        group_sequence_position = 0\n\n        for i, char in enumerate(self.input_str.content):\n            if char == '(':\n                if counter == 0:\n                    start_index = i\n                counter += 1\n            elif char == ')':\n                counter -= 1\n                if counter == 0:\n                    group_text = self.input_str.content[start_index : i + 1]\n                    self.groups.append(ParenGroup(group_text, start_index, i + 1, 0, group_sequence_position))\n                    group_sequence_position += 1\n                    start_index = -1  # Reset for the next top-level group\n        return self.groups\nclass ResultList:\n    \"\"\"Aggregates ParenGroup objects and produces the final list of strings.\"\"\"\n    def __init__(self) -> None:\n        self.groups: List[str] = []\n\n    def append_group(self, pg: ParenGroup) -> None:\n        \"\"\"Appends the group's text to the internal list.\"\"\"\n        self.groups.append(pg.group_text)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the collected group texts as a list of strings.\"\"\"\n        return self.groups\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    pstr = ParenthesisString(paren_string)\n    nstr = pstr.normalize()\n\n    parser = Parser(nstr)\n    paren_groups = parser.parse()\n\n    result = ResultList()\n    for pg in paren_groups:\n        result.append_group(pg)\n\n    return result.to_list()"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = numbers[0]\n\n    for x in numbers:\n        if x > current_max:\n            current_max = x\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str_found: Optional[str] = None\n    max_length = -1\n\n    for s in strings:\n        if longest_str_found is None or len(s) > max_length:\n            longest_str_found = s\n            max_length = len(s)\n\n    return longest_str_found"}
{"task_id": "HumanEval/11", "solution": "from typing import List\nclass BinaryString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the string contains only '0' or '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in self.value)\nclass XORFunction:\n    @staticmethod\n    def validate(a: str, b: str) -> None:\n        \"\"\"Validates binary strings for character content and equal length.\"\"\"\n        binary_a = BinaryString(a)\n        binary_b = BinaryString(b)\n\n        # Validate characters in string 'a'\n        if not binary_a.is_valid():\n            for char in a:\n                if char not in ('0', '1'):\n                    raise ValueError(f\"Invalid character in input: '{char}' (allowed: '0' or '1')\")\n        # Validate characters in string 'b'\n        if not binary_b.is_valid():\n            for char in b:\n                if char not in ('0', '1'):\n                    raise ValueError(f\"Invalid character in input: '{char}' (allowed: '0' or '1')\")\n\n        # Validate lengths are equal\n        if binary_a.length() != binary_b.length():\n            raise ValueError(f\"Inputs must have the same length: len(a)={binary_a.length()}, len(b)={binary_b.length()}\")\n\n    @staticmethod\n    def compute(a: str, b: str) -> str:\n        \"\"\"Performs per-position bitwise XOR on two binary strings.\"\"\"\n        result_chars = []\n        for char_a, char_b in zip(a, b):\n            xor_result = int(char_a) ^ int(char_b)\n            result_chars.append(str(xor_result))\n        return \"\".join(result_chars)\n\n    @staticmethod\n    def string_xor(a: str, b: str) -> str:\n        \"\"\"Orchestrates validation and computation for string_xor.\"\"\"\n        XORFunction.validate(a, b)\n        xor_value = XORFunction.compute(a, b)\n        return xor_value\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    return XORFunction.string_xor(a, b)"}
{"task_id": "HumanEval/14", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass PrefixList:\n    def __init__(self) -> None:\n        self._prefixes: List[str] = []\n    def append(self, prefix: str) -> None:\n        self._prefixes.append(prefix)\n    def to_list(self) -> List[str]:\n        return list(self._prefixes)\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    if len(string) == 0:\n        return []\n\n    input_obj = InputString(value=string)\n    prefixes = PrefixList()\n    for k in range(1, input_obj.length() + 1):\n        p = string[0:k]\n        prefixes.append(p)\n    return prefixes.to_list()"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef _longest_palindromic_suffix(s: str) -> int:\n    \"\"\" Compute the starting index of the longest suffix of s that is a palindrome. \"\"\"\n    n = len(s)\n    for i in range(n):\n        if is_palindrome(s[i:]):\n            return i\n    return n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    suffix_start_index = _longest_palindromic_suffix(string)\n    prefix_to_reverse = string[:suffix_start_index]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/15", "solution": "class Output:\n    def __init__(self, value: str, type: str = 'str'):\n        self.value = value\n        self.type = type\nclass Parameter:\n    def __init__(self, name: str, type: str, value: int):\n        self.name = name\n        self.type = type\n        self.value = value\n\n    def validate(self) -> None:\n        \"\"\"Enforce precondition that value is an int; raise TypeError if not an int.\"\"\"\n        if not isinstance(self.value, int):\n            raise TypeError(f\"Parameter '{self.name}' must be of type {self.type}, but got {type(self.value).__name__}.\")\nclass SequenceBuilder:\n    def build(self, n: int) -> str:\n        \"\"\"Produce output string composed of decimal representations of integers 0..n inclusive joined with a single ASCII space.\"\"\"\n        numbers = [str(i) for i in range(n + 1)]\n        return ' '.join(numbers)\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    param = Parameter(name='n', type='int', value=n)\n    param.validate()\n\n    builder = SequenceBuilder()\n    output_str = builder.build(n)\n\n    return Output(value=output_str).value"}
{"task_id": "HumanEval/13", "solution": "class IntegerInput:\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def validate(self) -> bool:\n        \"\"\"Validates if both stored inputs are integers.\"\"\"\n        return isinstance(self.a, int) and isinstance(self.b, int)\nclass GCDCalculator:\n    @staticmethod\n    def greatest_common_divisor(a: int, b: int) -> int:\n        \"\"\"\n        Computes the greatest common divisor using the Euclidean algorithm.\n        Handles zero inputs as specified in the design.\n        \"\"\"\n        if a == 0 and b == 0:\n            raise ValueError(\"GCD of (0,0) is undefined per BR-11; stakeholders to clarify.\")\n        if a == 0:\n            return abs(b)\n        if b == 0:\n            return abs(a)\n\n        # Euclidean algorithm for non-zero inputs, working with absolute values.\n        x, y = abs(a), abs(b)\n        while y:\n            x, y = y, x % y\n        return x\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Validate inputs using the IntegerInput helper.\n    inp = IntegerInput(a, b)\n    if not inp.validate():\n        raise TypeError(\"Inputs must be integers\")\n\n    # Delegate the GCD computation to the GCDCalculator.\n    result = GCDCalculator.greatest_common_divisor(a, b)\n\n    # Ensure the final result returned by the API is non-negative.\n    return abs(result)"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\"Return the number of distinct characters in `string` ignoring case.\n    If `string` is not a str, a TypeError is raised as a precondition check.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"string must be a str\")\n    \n    if string == \"\":\n        return 0\n    \n    seen = set()\n    for c in string:\n        seen.add(c.casefold())\n        \n    return len(seen)"}
