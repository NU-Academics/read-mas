{"task_id": "Mbpp/797", "solution": "```python\n# src/sum_in_range.py\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"Calculates the sum of all odd natural numbers in the inclusive range [l, r].\n    This uses an arithmetic series formula for efficient computation.\n    \"\"\"\n    start = max(l, 1)\n\n    if start > r:\n        return 0\n\n    first_odd = start if start % 2 == 1 else start + 1\n    last_odd = r if r % 2 == 1 else r - 1\n\n    if first_odd > last_odd:\n        return 0\n\n    n = ((last_odd - first_odd) // 2) + 1\n    total = n * (first_odd + last_odd) // 2\n\n    return total\n\n```\n```python\n# tests/test_sum_in_range.py\nfrom src.sum_in_range import sum_in_range\n\ndef test_sum_in_range() -> None:\n    \"\"\"Verifies the sum_in_range function behavior with various test cases,\n    including the example and edge conditions.\n    \"\"\"\n    assert sum_in_range(2, 5) == 8, \"Test failed for range (2, 5)\"\n    assert sum_in_range(1, 1) == 1, \"Test failed for range (1, 1)\"\n    assert sum_in_range(2, 2) == 0, \"Test failed for range (2, 2)\"\n    assert sum_in_range(-5, 0) == 0, \"Test failed for range (-5, 0)\"\n    assert sum_in_range(3, 3) == 3, \"Test failed for range (3, 3)\"\n    assert sum_in_range(3, 4) == 3, \"Test failed for range (3, 4)\"\n    assert sum_in_range(1, 10) == 25, \"Test failed for range (1, 10)\"\n    assert sum_in_range(5, 2) == 0, \"Test failed for l > r (5, 2)\"\n    assert sum_in_range(10, 1) == 0, \"Test failed for l > r (10, 1)\"\n    assert sum_in_range(100, 100) == 0, \"Test failed for even-only range (100, 100)\"\n    assert sum_in_range(99, 101) == 200, \"Test failed for large odd range (99, 101)\"\n    assert sum_in_range(0, 0) == 0, \"Test failed for range (0, 0)\"\n\n\ndef main() -> None:\n    \"\"\"The main entry point for running all tests in the harness.\"\"\"\n    test_sum_in_range()\n    print(\"All tests passed!\")\n\nif __name__ == '__main__':\n    main()\n\n```"}
{"task_id": "Mbpp/797", "solution": "```python\n# src/domain.py\n\nclass Range:\n    \"\"\"Value object holding the lower and upper bounds of a range.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n\nclass Number:\n    \"\"\"Represents an integer and provides predicates for oddness and naturalness.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the number's value is odd.\"\"\"\n        return self.value % 2 == 1\n\n    def is_natural(self) -> bool:\n        \"\"\"Returns True if the number's value is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\n\nclass Result:\n    \"\"\"A container for a computed integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n\nclass SumInRange:\n    \"\"\"Encapsulates a single sum request and provides methods to validate range and compute the sum.\"\"\"\n    def __init__(self, name: str, l: int, r: int):\n        self.name = name\n        self.l = l\n        self.r = r\n\n    def computeSum(self) -> int:\n        \"\"\"Computes and returns the sum of odd natural numbers in the effective range.\"\"\"\n        effective_l = max(self.l, 1)\n        total_sum = 0\n        for n in range(effective_l, self.r + 1):\n            number = Number(n)\n            if number.is_natural() and number.is_odd():\n                total_sum += n\n        return total_sum\n\n    def validateRange(self) -> bool:\n        \"\"\"Returns True if inputs are valid integers and effective_l <= r, False otherwise.\"\"\"\n        if not isinstance(self.l, int) or not isinstance(self.r, int):\n            return False\n        effective_l = max(self.l, 1)\n        return effective_l <= self.r\n\n\nclass TestCase:\n    \"\"\"Represents and runs a unit test case, comparing actual result to expected.\"\"\"\n    def __init__(self, input: tuple, expected: int):\n        self.input = input  # (l, r)\n        self.expected = expected\n        self.passed = False\n\n    def run(self) -> bool:\n        \"\"\"Invokes sum_in_range and compares the result to the expected value.\"\"\"\n        # Defer import to avoid circular dependency in general, though tests are typically external.\n        from src.sum_in_range import sum_in_range \n        actual_result = sum_in_range(*self.input)\n        self.passed = (actual_result == self.expected)\n        return self.passed\n```\n```python\n# src/sum_in_range.py\n\nfrom src.domain import SumInRange\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Computes and returns the sum of all odd natural numbers in the inclusive range [l, r].\n    Natural numbers are integers >= 1; effective lower bound = max(l, 1).\n    \"\"\"\n    sum_request = SumInRange(name='sum_in_range', l=l, r=r)\n    if not sum_request.validateRange():\n        return 0\n    return sum_request.computeSum()\n```\n```python\n# tests/test_sum_in_range.py\n\nfrom src.sum_in_range import sum_in_range\nfrom src.domain import TestCase\n\ndef test_sum_in_range_example():\n    \"\"\"Verifies sum_in_range(2, 5) equals 8 as per SRS example.\"\"\"\n    test_case = TestCase(input=(2, 5), expected=8)\n    assert test_case.run(), f\"Test case failed: input {test_case.input}, expected {test_case.expected}\"\n\n```"}
