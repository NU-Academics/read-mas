{"task_id": "Mbpp/451", "solution": "```python\ndef remove_whitespaces(input_string: str) -> str:\n    \"\"\"Removes all specified whitespace characters from the input string.\n    Preserves the relative order of non-whitespace characters and returns an empty string if input contains only whitespace.\n    \"\"\"\n    # The design specifies a minimal set of whitespace characters to remove (BR-2).\n    # This set is defined here directly within the function to meet critical inline requirements.\n    WHITESPACE_CHARS = {' ', '\\t', '\\n'}\n\n    # Use a list to efficiently build the resulting string by appending non-whitespace characters.\n    non_whitespace_chars = []\n    for char in input_string:\n        # Append the character if it is not one of the defined whitespace characters.\n        if char not in WHITESPACE_CHARS:\n            non_whitespace_chars.append(char)\n\n    # Join the collected characters to form the final string.\n    # If no non-whitespace characters were found, this correctly returns an empty string (FR-4/BR-5).\n    return \"\".join(non_whitespace_chars)\n```"}
{"task_id": "Mbpp/451", "solution": "```python\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"\n    Removes specified whitespace characters from the input string.\n    Preserves relative order of non-whitespace characters and returns a new string.\n    \"\"\"\n    # Whitespace characters to remove as per design: space (U+0020), tab (U+0009), \n    # newline (U+000A), and carriage return (U+000D).\n    _WHITESPACE_CHARS = {' ', '\\t', '\\n', '\\r'}\n\n    # This local helper function embodies the _is_whitespace concept from the design.\n    # It checks if a character is one of the strictly defined whitespace characters.\n    def _is_whitespace_char(char: str) -> bool:\n        return char in _WHITESPACE_CHARS\n\n    cleaned_chars = []\n    for char in input:\n        if not _is_whitespace_char(char):\n            cleaned_chars.append(char)\n            \n    return \"\".join(cleaned_chars)\n```"}
{"task_id": "Mbpp/453", "solution": "```python\n# src/sumofFactors.py\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all positive even divisors of an integer n.\n    Returns 0 if n is non-positive, as there are no positive divisors.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    # Iterate up to the square root of n to find divisors efficiently.\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            divisor1 = i\n            divisor2 = n // i\n\n            # Check if divisor1 is even and positive\n            if divisor1 % 2 == 0:\n                total_sum += divisor1\n\n            # Check if divisor2 is even, positive, and distinct from divisor1\n            if divisor2 % 2 == 0 and divisor1 != divisor2:\n                total_sum += divisor2\n    return total_sum\n\n# tests/test_sumofFactors.py\nfrom src.sumofFactors import sumofFactors\n\n# Required assertion per the software design specification.\nassert sumofFactors(18) == 26\n\ndef test_sumofFactors_18() -> None:\n    \"\"\"\n    Tests the sumofFactors function for the value n=18.\n    This test verifies that the sum of even factors of 18 is 26.\n    \"\"\"\n    assert sumofFactors(18) == 26\n```"}
{"task_id": "Mbpp/453", "solution": "```python\n# SumOfEvenFactors/__init__.py\nfrom .core import sumofFactors\n\n__all__ = ['sumofFactors'] # Public API re-export.\n```\n\n```python\n# SumOfEvenFactors/core.py\nimport math\n\ndef _validate_input(n: int) -> None:\n    \"\"\"Validates that n is an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\ndef _enumerate_divisors(n: int) -> list[int]:\n    \"\"\"Enumerates all positive divisors of n.\"\"\"\n    if n == 0:\n        return []\n    n_abs = abs(n)\n    divisors = []\n    # Find divisors by iterating up to the square root of n_abs.\n    for i in range(1, math.isqrt(n_abs) + 1):\n        if n_abs % i == 0:\n            divisors.append(i)\n            if i * i != n_abs:\n                divisors.append(n_abs // i)\n    return sorted(divisors)\n\ndef _is_even(f: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return f % 2 == 0\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Computes and returns the sum of even divisors of integer n.\n    Delegates to helpers for validation, enumeration, and filtering.\n    \"\"\"\n    _validate_input(n)\n    divisors = _enumerate_divisors(n)\n    even_divisors = [f for f in divisors if _is_even(f)]\n    return sum(even_divisors)\n```\n\n```python\n# tests/test_sumof_factors.py\nfrom SumOfEvenFactors import sumofFactors\n\ndef test_sumof_factors():\n    \"\"\"Acceptance test for sumofFactors function.\"\"\"\n    assert sumofFactors(18) == 26\n```"}
{"task_id": "Mbpp/454", "solution": "```python\n# src/text_match_wordz/models.py\nfrom typing import List\n\nclass TextInput:\n    \"\"\"Holds the raw input text and tokenized words.\"\"\"\n    def __init__(self, raw_text: str):\n        self.raw_text: str = raw_text\n        self.words: List['Word'] = []\n\n    def parse_words(self) -> None:\n        \"\"\"Populates self.words by tokenizing the raw text using the tokenizer.\"\"\"\n        from text_match_wordz import tokenizer # Local import to handle circular dependency\n        self.words = tokenizer.tokenize_words(self.raw_text)\n\nclass Word:\n    \"\"\"Represents a tokenized word.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\n    def has_lowercase_z(self) -> bool:\n        \"\"\"Checks if the word contains the lowercase letter 'z'.\"\"\"\n        return 'z' in self.value\n\nclass MatchResult:\n    \"\"\"Encapsulates the result of a word match operation.\"\"\"\n    def __init__(self, matched: bool):\n        self.matched: bool = matched\n\n```\n```python\n# src/text_match_wordz/tokenizer.py\nfrom typing import List\nfrom text_match_wordz import models\n\ndef _is_alpha_ascii(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII alphabetic character (A-Z or a-z).\"\"\"\n    return 'a' <= ch <= 'z' or 'A' <= ch <= 'Z'\n\ndef tokenize_words(input_text: str) -> List[models.Word]:\n    \"\"\"\n    Extracts contiguous ASCII alphabetic sequences as Word objects.\n    Adjacent punctuation is ignored; non-alphabetic characters break words.\n    \"\"\"\n    words: List[models.Word] = []\n    current_word_chars: List[str] = []\n\n    for char in input_text:\n        if _is_alpha_ascii(char):\n            current_word_chars.append(char)\n        else:\n            # If a non-alphabetic character is encountered, end the current word.\n            if current_word_chars:\n                words.append(models.Word(\"\".join(current_word_chars)))\n                current_word_chars = []\n            # Non-alphabetic characters act as word separators.\n            pass\n\n    # Add any remaining word characters if the input ends with an alphabetic sequence.\n    if current_word_chars:\n        words.append(models.Word(\"\".join(current_word_chars)))\n\n    return words\n\n```\n```python\n# src/text_match_wordz/core.py\nfrom typing import List\nfrom text_match_wordz import models\nfrom text_match_wordz import tokenizer # This import is not strictly used here, but in models.py via local import.\n\ndef _analyze_words(words: List[models.Word]) -> models.MatchResult:\n    \"\"\"Analyzes a list of Word objects for the presence of lowercase 'z'.\"\"\"\n    for word in words:\n        if word.has_lowercase_z():\n            return models.MatchResult(matched=True)\n    return models.MatchResult(matched=False)\n\nclass TextMatchFunction:\n    \"\"\"Orchestrates tokenization and analysis to find 'z' in words.\"\"\"\n    def text_match_wordz(self, input: str) -> bool:\n        \"\"\"\n        Public method to check if the input string contains a word with 'z'.\n        This method wraps the raw input, tokenizes, analyzes, and returns the result.\n        \"\"\"\n        text_input = models.TextInput(raw_text=input)\n        text_input.parse_words() # Populates text_input.words\n        match_result = _analyze_words(text_input.words)\n        return match_result.matched\n\n# Module-level function, the primary public API.\n_text_match_function_instance = TextMatchFunction()\n\ndef text_match_wordz(input: str) -> bool:\n    \"\"\"\n    Public API function to check if the input string contains a word with 'z'.\n    Delegates to an internal TextMatchFunction instance.\n    \"\"\"\n    return _text_match_function_instance.text_match_wordz(input)\n\n```\n```python\n# src/text_match_wordz/__init__.py\n\"\"\"\ntext_match_wordz package: Provides a function to detect 'z' in words.\nThis module re-exports the top-level text_match_wordz function.\n\"\"\"\nfrom .core import text_match_wordz\n```\n```python\n# src/main.py\nimport sys\nfrom typing import Optional, List\nfrom text_match_wordz import text_match_wordz\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Example entry point demonstrating the text_match_wordz function.\n    It shows assertion examples and prints results.\n    \"\"\"\n    print(\"Running text_match_wordz examples...\")\n\n    input_str_1 = \"pythonz.\"\n    result_1 = text_match_wordz(input_str_1)\n    print(f\"'{input_str_1}' contains 'z': {result_1}\")\n    assert result_1 is True, f\"Assertion failed for '{input_str_1}'\"\n\n    input_str_2 = \"hello world!\"\n    result_2 = text_match_wordz(input_str_2)\n    print(f\"'{input_str_2}' contains 'z': {result_2}\")\n    assert result_2 is False, f\"Assertion failed for '{input_str_2}'\"\n\n    input_str_3 = \"amazing, lazy fox.\"\n    result_3 = text_match_wordz(input_str_3)\n    print(f\"'{input_str_3}' contains 'z': {result_3}\")\n    assert result_3 is True, f\"Assertion failed for '{input_str_3}'\"\n\n    input_str_4 = \"z-score calculation 10z\"\n    result_4 = text_match_wordz(input_str_4)\n    print(f\"'{input_str_4}' contains 'z': {result_4}\")\n    assert result_4 is True, f\"Assertion failed for '{input_str_4}'\"\n\n    input_str_5 = \"\"\n    result_5 = text_match_wordz(input_str_5)\n    print(f\"'{input_str_5}' contains 'z': {result_5}\")\n    assert result_5 is False, f\"Assertion failed for '{input_str_5}'\"\n\n    print(\"All example assertions passed!\")\n    return 0\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```"}
