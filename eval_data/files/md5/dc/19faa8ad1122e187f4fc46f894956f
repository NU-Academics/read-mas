{"task_id": "Mbpp/757", "solution": "```python\n# src/__init__.py\nfrom .reverse_pair_counter import count_reverse_pairs\n\n__all__ = [\"count_reverse_pairs\"]\n\n```\n```python\n# src/domain.py\nfrom typing import List, Iterator\n\nclass StringItem:\n    \"\"\"Immutable value object for one input element.\n    Stores its original index and string value.\n    \"\"\"\n    def __init__(self, index: int, value: str) -> None:\n        self.index = index\n        self.value = value\n\n    def reversed(self) -> str:\n        \"\"\"Returns exact character-by-character reversal of value.\"\"\"\n        return self.value[::-1]\n\nclass StringList:\n    \"\"\"Lightweight wrapper over raw list of strings.\n    Produces indexed StringItem instances.\n    \"\"\"\n    def __init__(self, values: List[str]) -> None:\n        self.items = [StringItem(i, val) for i, val in enumerate(values)]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of StringItem instances in the list.\"\"\"\n        return len(self.items)\n\n    def __iter__(self) -> Iterator[StringItem]:\n        \"\"\"Allows iteration over StringItem instances.\"\"\"\n        return iter(self.items)\n\nclass ReversePair:\n    \"\"\"Value object representing one unordered reverse pair.\n    Stores indices and string values of the matched pair.\n    \"\"\"\n    def __init__(self, index1: int, index2: int, string1: str, string2: str) -> None:\n        self.index1 = index1\n        self.index2 = index2\n        self.string1 = string1\n        self.string2 = string2\n\n```\n```python\n# src/reverse_pair_counter.py\nfrom typing import List\nfrom .domain import StringList, StringItem, ReversePair\n\nclass ReversePairCounter:\n    \"\"\"Encapsulates algorithm to count unordered reverse-string pairs.\"\"\"\n    def count_reverse_pairs(self, list_of_strings: List[str]) -> int:\n        \"\"\"Counts unordered distinct index pairs (i < j) where list_of_strings[i] == reverse(list_of_strings[j]).\n        Comparison is exact and case-sensitive.\n        \"\"\"\n        string_list = StringList(list_of_strings)\n        count = 0\n        size = string_list.size()\n\n        # Use nested loops to compare each distinct pair.\n        for i in range(size):\n            item_i = string_list.items[i]\n            for j in range(i + 1, size): # Ensure distinct indices and i < j for unordered pairs.\n                item_j = string_list.items[j]\n                if item_i.value == item_j.reversed():\n                    # A ReversePair is found; increment count.\n                    count += 1\n        return count\n\ndef count_reverse_pairs(list_of_strings: List[str]) -> int:\n    \"\"\"Public API function counting unordered pairs of elements that are exact reverses of each other.\n    Delegates the counting logic to a ReversePairCounter instance.\n    \"\"\"\n    return ReversePairCounter().count_reverse_pairs(list_of_strings)\n\n```\n```python\n# tests/test_reverse_pair_counter.py\nfrom reverse_pair_counter import count_reverse_pairs\n\ndef test_acceptance_assertion():\n    \"\"\"Verifies the count_reverse_pairs function with the SRS acceptance assertion.\"\"\"\n    assert count_reverse_pairs([\"julia\", \"best\", \"tseb\", \"for\", \"ailuj\"]) == 2\n\n```"}
{"task_id": "Mbpp/757", "solution": "```python\nfrom typing import List\n\nclass StringItem:\n    \"\"\"Represents a string and its original position.\"\"\"\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n\n    def reverse(self) -> str:\n        \"\"\"Returns the reverse of the string value.\"\"\"\n        return self.value[::-1]\n\nclass StringList:\n    \"\"\"A collection of StringItem instances.\"\"\"\n    def __init__(self, items: List[StringItem]):\n        self.items = items\n\n    @classmethod\n    def from_strings(cls, strings: List[str]) -> 'StringList':\n        \"\"\"Creates a StringList from a list of raw strings.\"\"\"\n        items = [StringItem(value, i) for i, value in enumerate(strings)]\n        return cls(items)\n\nclass ReversePair:\n    \"\"\"Lightweight holder for an unordered pair of indices.\"\"\"\n    def __init__(self, index1: int, index2: int):\n        self.index1 = index1\n        self.index2 = index2\n\nclass CountReversePairs:\n    \"\"\"Encapsulates the core algorithm for counting reverse string pairs.\"\"\"\n    def count(self, strings: List[str]) -> int:\n        \"\"\"Counts unordered reverse string index pairs (i < j).\"\"\"\n        if not strings:\n            return 0\n\n        string_list = StringList.from_strings(strings)\n        total_count = 0\n        n = len(string_list.items)\n\n        for i in range(n - 1):\n            item_i = string_list.items[i]\n            for j in range(i + 1, n):\n                item_j = string_list.items[j]\n                if item_i.value == item_j.reverse():\n                    total_count += 1\n        return total_count\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Public API: counts reverse string pairs in a list of strings.\"\"\"\n    counter = CountReversePairs()\n    return counter.count(strings)\n```"}
