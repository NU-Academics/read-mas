[i] != arr_slice[j]:\n                    count += 1\n        return count\n\ndef count_Pairs(arr: List[int], n: int) -> int:\n    \"\"\"\n    Counts unordered pairs (i, j) with 0 <= i < j < n such that arr[i] != arr[j].\n    It slices the input array to its first n elements before counting.\n    \"\"\"\n    # Create ArrayInput (optional, as per design notes, but here for structure).\n    # ai = ArrayInput(arr, n) # The design noted this but then used arr[:n] directly.\n\n    arr_slice = arr[:n] # Slices arr to its first n elements as per design.\n\n    # Delegate computation to a PairCounter instance.\n    counter = PairCounter()\n    result_count = counter.countUnequalPairs(arr_slice)\n\n    # Returns the integer count directly as per the API signature.\n    return result_count\n\n```\n```python\n# tests/test_count_pairs.py\n# Import the public API function as specified in the design.\nfrom src.pair_counter import count_Pairs\n\n# The minimal test required by the specification.\ntest_arr = [1, 2, 1]\ntest_n = 3\nexpected_result = 2\n\nactual_result = count_Pairs(test_arr, test_n)\n\nassert actual_result == expected_result, f\"Test failed: Expected {expected_result}, got {actual_result}\"\n\n# Optional: Print a success message if the assertion passes.\nprint(f\"Test passed for count_Pairs({test_arr}, {test_n}) == {expected_result}\")\n\n```"}
{"task_id": "Mbpp/564", "solution": "```python\n# count_pairs_project/src/__init__.py\n\"\"\"Package initializer for src.\"\"\"\n__all__ = [\"count_Pairs\"]\n```\n\n```python\n# count_pairs_project/src/count_pairs.py\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputList:\n    \"\"\"Holds a list of integers and provides safe indexed access.\"\"\"\n    elements: List[int]\n    length: int\n\n    def __init__(self, elements: List[int]) -> None:\n        \"\"\"Initializes with the given elements and derives length.\"\"\"\n        self.elements = elements\n        self.length = len(elements)\n\n    def get(self, idx: int) -> int:\n        \"\"\"Returns the element at the given index, or raises IndexError.\"\"\"\n        if not (0 <= idx < self.length):\n            raise IndexError(f\"Index {idx} out of bounds for list of length {self.length}\")\n        return self.elements[idx]\n\n@dataclass\nclass IntegerPair:\n    \"\"\"Data holder for an unordered index pair and their corresponding values.\"\"\"\n    i: int\n    j: int\n    value_i: int\n    value_j: int\n\n@dataclass\nclass Result:\n    \"\"\"Data holder for the final computed count.\"\"\"\n    count: int\n\nclass PairCounter:\n    \"\"\"Encapsulates the algorithm to count unequal pairs within a given range.\"\"\"\n    _input: InputList\n    _n: int\n    _count: int\n\n    def __init__(self, input_list: InputList, n: int) -> None:\n        \"\"\"Initializes the counter with the input list and effective 'n' limit.\"\"\"\n        self._input = input_list\n        self._n = n\n        self._count = 0\n\n    def count_Pairs(self) -> int:\n        \"\"\"Executes the counting algorithm, produces a Result, and returns the total count.\"\"\"\n        self._compute_count()\n        result_obj = Result(count=self._count) # PairCounter produces Result\n        return result_obj.count\n\n    def _compute_count(self) -> None:\n        \"\"\"Iterates through all possible pairs and increments count for unequal values.\"\"\"\n        current_n = self._n\n        for i in range(current_n):\n            for j in range(i + 1, current_n):\n                value_i = self._input.get(i)\n                value_j = self._input.get(j)\n                if value_i != value_j:\n                    _ = IntegerPair(i, j, value_i, value_j) # PairCounter generates IntegerPair\n                    self._count += 1\n\ndef count_Pairs(list_of_integers: List[int], n: int) -> int:\n    \"\"\"\n    Public API function to count unordered index pairs where elements are unequal.\n    Enforces 'n' preconditions: raises ValueError if n < 0, clamps n if n > list length.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n cannot be negative.\")\n\n    effective_n = min(n, len(list_of_integers))\n\n    input_list = InputList(list_of_integers)\n    pair_counter = PairCounter(input_list, effective_n)\n    final_count = pair_counter.count_Pairs()\n    \n    return final_count\n```\n\n```python\n# count_pairs_project/tests/test_count_pairs.py\n\"\"\"Unit tests for the count_Pairs function.\"\"\"\nfrom src.count_pairs import count_Pairs\n\ndef test_example_assertion() -> None:\n    \"\"\"Tests the required example assertion for count_Pairs function.\"\"\"\n    assert count_Pairs([1,2,1], 3) == 2\n```"}
{"task_id": "Mbpp/566", "solution": "To implement the provided software design specification, the following files will be generated. The detailed design explicitly requires a multi-file structure, domain classes, validation, and unit tests, which takes precedence over generic \"CRITICAL REQUIREMENTS\" that appear to be for simpler, single-function generation tasks.\n\n```python\n# src/domain.py\nimport importlib\n\nclass SumDigitsFunction:\n    \"\"\"Encapsulates digit-sum computation.\n    Provides a method to compute the sum of decimal digits for an integer.\n    \"\"\"\n    def __init__(self):\n        self.name = \"Sum Digits Function\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the sum of decimal digits for a non-negative integer n.\"\"\"\n        return sum(int(digit) for digit in str(n))\n\nclass NonNegativeInteger:\n    \"\"\"Encapsulates a value and its non-negative validation rule.\n    Checks if the encapsulated integer value is non-negative.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the encapsulated integer value is non-negative.\"\"\"\n        return self.value >= 0\n\nclass TestAssertion:\n    \"\"\"Encapsulates a verification assertion for the sum_digits function.\n    It evaluates an expression and compares its result to an expected value.\n    \"\"\"\n    def __init__(self, expression: str, expected_result: any):\n        self.expression = expression\n        self.expectedResult = expected_result\n\n    def run(self) -> bool:\n        \"\"\"Evaluates the stored expression and compares its result to the expected result.\"\"\"\n        # Dynamically import sum_digits for evaluation context\n        sum_digits_module = importlib.import_module(\"src.sum_digits\")\n        # Ensure sum_digits is available in the eval context\n        evaluated_value = eval(self.expression, {'sum_digits': sum_digits_module.sum_digits})\n        return evaluated_value == self.expectedResult\n\n```\n\n```python\n# src/sum_digits.py\nfrom src.domain import SumDigitsFunction, NonNegativeInteger\n\ndef _to_non_negative_integer(n: int) -> NonNegativeInteger:\n    \"\"\"Internal helper to convert an int to a NonNegativeInteger object.\"\"\"\n    return NonNegativeInteger(n)\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Computes the sum of decimal digits for a non-negative integer.\n    Raises ValueError if input is not a non-negative integer.\n    \"\"\"\n    non_negative_n = _to_non_negative_integer(n)\n    if not non_negative_n.isValid():\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    calculator = SumDigitsFunction()\n    return calculator.compute(n)\n\n```\n\n```python\n# src/main.py\nfrom src.sum_digits import sum_digits\nfrom src.domain import TestAssertion\n\ndef main() -> None:\n    \"\"\"Demonstrates sum_digits function usage and runs the verification assertion.\n    It shows examples with valid and invalid inputs, and executes the required test assertion.\n    \"\"\"\n    print(\"--- Demonstrating sum_digits function ---\")\n\n    # Example usage\n    try:\n        print(f\"sum_digits(345) = {sum_digits(345)}\")\n        print(f\"sum_digits(0) = {sum_digits(0)}\")\n        print(f\"sum_digits(99) = {sum_digits(99)}\")\n    except ValueError as e:\n        print(f\"Error: {e}\")\n\n    # Invalid input demonstration\n    try:\n        print(f\"Attempting sum_digits(-10)...\")\n        print(f\"sum_digits(-10) = {sum_digits(-10)}\") # This line won't be reached\n    except ValueError as e:\n        print(f\"Caught expected error: {e}\")\n\n    print(\"\\n--- Running TestAssertion ---\")\n    # As per design, TestAssertion for sum_digits(345) == 12\n    required_assertion = TestAssertion(expression=\"sum_digits(345)\", expected_result=12)\n    assertion_passed = required_assertion.run()\n\n    if assertion_passed:\n        print(f\"Verification assertion passed: {required_assertion.expression} == {required_assertion.expectedResult}\")\n    else:\n        print(f\"Verification assertion FAILED: {required_assertion.expression} != {required_assertion.expectedResult}\")\n\nif __name__ == '__main__':\n    main()\n\n```\n\n```python\n# tests/test_sum_digits.py\nimport pytest\nfrom src.sum_digits import sum_digits\n\ndef test_sum_digits_345_equals_12() -> None:\n    \"\"\"Verifies that sum_digits(345) correctly returns 12.\n    This fulfills the explicit verification assertion requirement.\n    \"\"\"\n    assert sum_digits(345) == 12\n\ndef test_sum_digits_zero() -> None:\n    \"\"\"Verifies sum_digits handles zero correctly.\"\"\"\n    assert sum_digits(0) == 0\n\ndef test_sum_digits_single_digit() -> None:\n    \"\"\"Verifies sum_digits for a single digit number.\"\"\"\n    assert sum_digits(7) == 7\n\ndef test_sum_digits_multiple_digits() -> None:\n    \"\"\"Verifies sum_digits for another multi-digit number.\"\"\"\n    assert sum_digits(123) == 6\n\ndef test_sum_digits_negative_input_raises_error() -> None:\n    \"\"\"Verifies that sum_digits raises ValueError for negative inputs.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be a non-negative integer\"):\n        sum_digits(-5)\n\n```"}
{"task_id": "Mbpp/565", "solution": "```python\n# src/__init__.py\nfrom .string_splitter import split\n```\n```python\n# src/string_splitter.py\n\nclass Character:\n    \"\"\"Represents a single character with its position.\"\"\"\n    def __init__(self, value: str, position: int):\n        self._value = value\n        self._position = position\n\n    def to_str(self) -> str:\n        \"\"\"Returns the character's string value.\"\"\"\n        return self._value\n\n\nclass InputString:\n    \"\"\"Wraps an input string and provides its value and length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    @property\n    def value(self) -> str:\n        \"\"\"The wrapped string value.\"\"\"\n        return self._value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self._value)\n\n\nclass ResultList:\n    \"\"\"Collects Character objects and converts them to a list of strings.\"\"\"\n    def __init__(self):\n        self._items = []\n\n    def append(self, char: Character) -> None:\n        \"\"\"Adds a Character object to the list.\"\"\"\n        self._items.append(char)\n\n    def to_list(self) -> list:\n        \"\"\"Converts collected Character objects to a list of strings.\"\"\"\n        return [char.to_str() for char in self._items]\n\n\nclass StringSplitter:\n    \"\"\"Performs the core string splitting logic.\"\"\"\n    def split(self, input_str: str) -> list:\n        \"\"\"Splits an input string into a list of single-character strings.\"\"\"\n        input_obj = InputString(input_str)\n        result_list = ResultList()\n\n        for index, code_point in enumerate(input_obj.value):\n            character = Character(code_point, index)\n            result_list.append(character)\n        return result_list.to_list()\n\n\ndef split(input) -> list:\n    \"\"\"Splits an input string into a list of single-character strings.\"\"\"\n    # Type validation and error raising are omitted per critical requirements.\n    splitter = StringSplitter()\n    return splitter.split(input)\n```"}
