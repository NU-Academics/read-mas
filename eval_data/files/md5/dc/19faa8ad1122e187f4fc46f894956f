{"task_id": "Mbpp/108", "solution": "```python\n# src/models.py\nfrom typing import List\n\nclass InputList:\n    \"\"\"Data container for an input list.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements: List[int] = elements\n\nclass ResultList:\n    \"\"\"Data container for a result list.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements: List[int] = elements\n\nclass Element:\n    \"\"\"Data container for a single integer element.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\n# src/validator.py\nfrom typing import Any\n\ndef _is_integer(value: Any) -> bool:\n    \"\"\"Module-private helper: Checks if a value is an integer.\"\"\"\n    return isinstance(value, int)\n\nclass Validator:\n    \"\"\"Validates that inputs are lists of integers.\"\"\"\n    def validate_list(self, lst: Any) -> bool:\n        \"\"\"\n        Returns True if lst is a list and every element is an int; otherwise False.\n        \"\"\"\n        if not isinstance(lst, list):\n            return False\n        for item in lst:\n            if not _is_integer(item):\n                return False\n        return True\n\n# src/merger.py\nfrom typing import List\n\nclass Merger:\n    \"\"\"Merges three input lists into a single collection preserving multiplicity.\"\"\"\n    def merge_lists(self, listA: List[int], listB: List[int], listC: List[int]) -> List[int]:\n        \"\"\"\n        Returns a new list built by concatenation of the three input lists.\n        Preserves duplicates and multiplicity.\n        \"\"\"\n        return [*listA, *listB, *listC]\n\n# src/sorter.py\nfrom typing import List\n\nclass Sorter:\n    \"\"\"Sorts a list of integers in non-decreasing (ascending) order.\"\"\"\n    def sort(self, lst: List[int]) -> List[int]:\n        \"\"\"\n        Returns a new list with elements sorted in ascending (non-decreasing) order.\n        \"\"\"\n        return sorted(lst)\n\n# src/merge_sorted_list.py\nfrom typing import List, Any\nfrom .validator import Validator\nfrom .merger import Merger\nfrom .sorter import Sorter\nfrom .models import InputList, ResultList # For traceability to the domain model\n\ndef merge_sorted_list(listA: List[Any], listB: List[Any], listC: List[Any]) -> List[int]:\n    \"\"\"\n    Public API. Orchestrates validation, merging, and sorting.\n    Signature: merge_sorted_list(listA, listB, listC) -> List[int]\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_list(listA) or \\\n       not validator.validate_list(listB) or \\\n       not validator.validate_list(listC):\n        raise TypeError(\"Inputs must be lists of integers\")\n\n    merger = Merger()\n    merged = merger.merge_lists(listA, listB, listC)\n\n    sorter = Sorter()\n    sorted_list = sorter.sort(merged)\n\n    return sorted_list\n```"}
