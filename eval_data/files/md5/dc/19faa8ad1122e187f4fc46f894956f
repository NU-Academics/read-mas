lse, message=f\"Digit {digit_val} frequency ({freq_obj.count}) exceeds its value.\")\n                return False\n        \n        # Produces ValidationResult as per design, but returns its boolean value.\n        _ = ValidationResult(is_valid=True, message=\"All digit frequencies are valid.\")\n        return True\n\ndef validate(n: int) -> bool:\n    \"\"\"Public API per FR1: accept single integer and return boolean.\"\"\"\n    return Validator().validate(n)\n```"}
{"task_id": "Mbpp/282", "solution": "To implement the software design specification, the following files will be generated:\n\n```\nsrc/\n  __init__.py\n  sub_list.py\nrun_tests.py\ntests/\n  test_sub_list.py\n```\n\n---\n**File: `src/__init__.py`**\n```python\n# Purpose: Package marker for src module.\n```\n\n---\n**File: `src/sub_list.py`**\n```python\nfrom dataclasses import dataclass\nfrom typing import Sequence, List, Union\n\n\n@dataclass\nclass NumericElement:\n    \"\"\"Represents a numeric element in a list.\"\"\"\n    value: Union[int, float]\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the element's value is numeric.\"\"\"\n        return isinstance(self.value, (int, float))\n\n\n@dataclass\nclass InputList:\n    \"\"\"Represents an input list of numeric elements.\"\"\"\n    elements: Sequence[Union[int, float]]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input list.\"\"\"\n        return len(self.elements)\n\n    def __iter__(self):\n        \"\"\"Allows iteration over the elements.\"\"\"\n        return iter(self.elements)\n\n    def __getitem__(self, idx: int) -> Union[int, float]:\n        \"\"\"Allows indexing into the elements.\"\"\"\n        return self.elements[idx]\n\n\n@dataclass\nclass ResultList:\n    \"\"\"Represents a result list of numeric elements.\"\"\"\n    elements: List[Union[int, float]]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the result list.\"\"\"\n        return len(self.elements)\n\n    def to_list(self) -> List[Union[int, float]]:\n        \"\"\"Returns the elements as a plain Python list.\"\"\"\n        return self.elements\n\n\ndef _is_numeric(value) -> bool:\n    \"\"\"Module-level helper to check if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\n\ndef _validate_lists(a: Sequence, b: Sequence) -> None:\n    \"\"\"\n    Validates that inputs are sequences, contain only numeric elements, and have equal lengths.\n    Raises TypeError for non-numeric elements or if inputs are not sequences; ValueError for unequal lengths.\n    \"\"\"\n    if not isinstance(a, Sequence) or not isinstance(b, Sequence):\n        raise TypeError(\"Inputs must be list-like sequences.\")\n\n    for val in a:\n        if not _is_numeric(val):\n            raise TypeError(f\"List 'a' contains non-numeric element: {val}\")\n    for val in b:\n        if not _is_numeric(val):\n            raise TypeError(f\"List 'b' contains non-numeric element: {val}\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input lists must have equal lengths.\")\n\n\ndef sub_list(a: Sequence[Union[int, float]], b: Sequence[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Computes element-wise subtraction of two numeric lists.\n    Validates inputs and raises TypeError or ValueError on invalid data.\n    \"\"\"\n    _validate_lists(a, b)\n    result_elements = [a[i] - b[i] for i in range(len(a))]\n    return result_elements\n\n```\n\n---\n**File: `run_tests.py`**\n```python\nimport argparse\nimport sys\nimport unittest\nfrom typing import Optional, List\n\n# Assuming src is on the Python path or current directory\nfrom src.sub_list import sub_list\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    CLI entry point to demonstrate the example and execute unit tests.\n    Supports --stdout to print example and --example-delimiter for formatting.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Run example and tests for the sub_list function.\"\n    )\n    parser.add_argument(\n        \"--stdout\", action=\"store_true\", help=\"Print the example result to stdout.\"\n    )\n    parser.add_argument(\n        \"--example-delimiter\",\n        type=str,\n        default=\",\",\n        help=\"Delimiter for printed example output (default: ',').\",\n    )\n\n    args = parser.parse_args(argv)\n\n    if args.stdout:\n        example_a = [1, 2, 3]\n        example_b = [4, 5, 6]\n        try:\n            result = sub_list(example_a, example_b)\n            print(\n                f\"Example sub_list({example_a}, {example_b}) == \"\n                f\"[{args.example_delimiter.join(map(str, result))}]\"\n            )\n        except Exception as e:\n            print(f\"Error computing example: {e}\", file=sys.stderr)\n            return 1\n\n    print(\"\\n--- Running Unit Tests ---\")\n    # Discover tests in the 'tests' directory\n    loader = unittest.TestLoader()\n    suite = loader.discover('tests', pattern='test_*.py')\n\n    runner = unittest.TextTestRunner(verbosity=2)\n    result = runner.run(suite)\n\n    if not result.wasSuccessful():\n        return 1  # Indicate test failures\n\n    return 0  # Indicate success\n\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```\n\n---\n**File: `tests/test_sub_list.py`**\n```python\nimport unittest\nfrom src.sub_list import sub_list\n\n\nclass TestSubList(unittest.TestCase):\n    \"\"\"Unit tests for the sub_list function, covering acceptance and error cases.\"\"\"\n\n    def test_example(self):\n        \"\"\"Tests the basic element-wise subtraction example (FR5).\"\"\"\n        self.assertEqual(sub_list([1, 2, 3], [4, 5, 6]), [-3, -3, -3])\n\n    def test_non_numeric_raises_type_error(self):\n        \"\"\"Ensures TypeError is raised for non-numeric elements (FR6).\"\"\"\n        with self.assertRaises(TypeError) as cm:\n            sub_list([1, 2, \"a\"], [4, 5, 6])\n        self.assertIn(\"non-numeric\", str(cm.exception))\n\n        with self.assertRaises(TypeError) as cm:\n            sub_list([1, 2, 3], [4, None, 6])\n        self.assertIn(\"non-numeric\", str(cm.exception))\n\n    def test_unequal_length_raises_value_error(self):\n        \"\"\"Ensures ValueError is raised for unequal input list lengths (FR7).\"\"\"\n        with self.assertRaises(ValueError) as cm:\n            sub_list([1, 2, 3], [4, 5])\n        self.assertIn(\"equal lengths\", str(cm.exception))\n\n        with self.assertRaises(ValueError) as cm:\n            sub_list([1, 2], [4, 5, 6])\n        self.assertIn(\"equal lengths\", str(cm.exception))\n\n```"}
