{"task_id": "Mbpp/280", "solution": "```python\n# src/sequential_search.py\n\nfrom typing import Any, List, Tuple\n\nclass Array:\n    \"\"\"Lightweight wrapper representing the input list to search.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = elements\n\nclass Element:\n    \"\"\"Lightweight wrapper representing the search target.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\nclass SearchResult:\n    \"\"\"Data-holder for search outcome matching SRS tuple semantics.\"\"\"\n    def __init__(self, found: bool, index: int) -> None:\n        self.found = found\n        self.index = index\n\n    def as_tuple(self) -> Tuple[bool, int]:\n        \"\"\"Returns the search result as a (found: bool, index: int) tuple.\"\"\"\n        return (self.found, self.index)\n\nclass SequentialSearch:\n    \"\"\"Encapsulated search behavior object exposing sequential_search.\"\"\"\n    def sequential_search(self, array: Array, element: Element) -> SearchResult:\n        \"\"\"Performs a linear scan to find the element in the array.\"\"\"\n        for i, item in enumerate(array.elements):\n            if item == element.value:\n                return SearchResult(found=True, index=i)\n        return SearchResult(found=False, index=-1)\n\ndef sequential_search(array: List[Any], element: Any) -> Tuple[bool, int]:\n    \"\"\"Primary API \u2014 perform linear scan and return tuple (found, index).\"\"\"\n    # Delegates to the SequentialSearch class for the core logic.\n    _array = Array(array)\n    _element = Element(element)\n    search_engine = SequentialSearch()\n    result = search_engine.sequential_search(_array, _element)\n    return result.as_tuple()\n```\n```python\n# tests/test_sequential_search.py\n\nfrom src.sequential_search import sequential_search\nfrom typing import List, Any, Tuple\n\nclass TestCase:\n    \"\"\"Encapsulate a single test case and run/verify it.\"\"\"\n    def __init__(self, input_array: List[Any], target: Any, expected: Tuple[bool, int]) -> None:\n        self.input_array = input_array\n        self.target = target\n        self.expected = expected\n\n    def run(self) -> None:\n        \"\"\"Executes the sequential_search with test inputs and asserts the result.\"\"\"\n        actual = sequential_search(self.input_array, self.target)\n        assert actual == self.expected, \\\n            f\"Test failed for array={self.input_array}, target={self.target}. \" \\\n            f\"Expected {self.expected}, got {actual}.\"\n        print(f\"Test passed: sequential_search({self.input_array}, {self.target}) == {self.expected}\")\n\ndef main() -> None:\n    \"\"\"Runs the provided unit test case.\"\"\"\n    test_case = TestCase([11,23,58,31,56,77,43,12,65,19], 31, (True, 3))\n    test_case.run()\n\nif __name__ == '__main__':\n    main()\n```"}
