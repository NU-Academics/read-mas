{"task_id": "Mbpp/462", "solution": "from typing import Any, List, Iterator\n\n# Conceptual domain-holder classes as per design.\n# These are defined but not heavily instantiated in the main generation logic,\n# as combinations are returned as plain lists for API compatibility and minimal implementation.\n\nclass InputList:\n    \"\"\"Holds the input elements and provides length.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass Element:\n    \"\"\"Represents an element with its original value and index.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass Combination:\n    \"\"\"Conceptual holder for a single subset of elements.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = elements\n\nclass OutputList:\n    \"\"\"Collects generated combinations.\"\"\"\n    def __init__(self) -> None:\n        self.combinations: List[List[Any]] = []\n\n    def append(self, combination: List[Any]) -> None:\n        self.combinations.append(combination)\n\n    def size(self) -> int:\n        return len(self.combinations)\n\nclass CombinationGenerator:\n    \"\"\"Orchestrates the generation of all combinations based on bit enumeration.\"\"\"\n    def __init__(self, input_list: list) -> None:\n        self._input = input_list\n        self._n = len(input_list)\n\n    def combinations_list(self) -> List[List[Any]]:\n        \"\"\"Generates and returns the ordered list of all combinations using its internal state.\"\"\"\n        output_list = OutputList()\n        for bits_pattern in self._enumerate_bits():\n            combination = self._build_combination(bits_pattern)\n            output_list.append(combination)\n        return output_list.combinations\n\n    def _enumerate_bits(self) -> Iterator[int]:\n        \"\"\"Yields integers from 0 to 2^n - 1 for bit-index enumeration.\"\"\"\n        num_combinations = 1 << self._n # Equivalent to 2 raised to the power of self._n\n        for i in range(num_combinations):\n            yield i\n\n    def _build_combination(self, bits: int) -> List[Any]:\n        \"\"\"Builds a single combination by selecting elements based on bits, in descending index order.\"\"\"\n        current_combination: List[Any] = []\n        # Iterate from the highest index down to 0 (n-1 to 0)\n        for index in range(self._n - 1, -1, -1):\n            # Check if the bit at the current 'index' position is set (1)\n            if (bits >> index) & 1:\n                current_combination.append(self._input[index])\n        return current_combination\n\ndef combinations_list(input_list: list) -> List[List[Any]]:\n    \"\"\"\n    Public API function to generate all combinations of the input list.\n    Delegates the generation process to a CombinationGenerator instance.\n    \"\"\"\n    generator = CombinationGenerator(input_list)\n    return generator.combinations_list()"}
