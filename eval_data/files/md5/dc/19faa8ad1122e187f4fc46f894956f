{"task_id": "Mbpp/588", "solution": "```python\ndef _is_numeric(value) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_input(values):\n    \"\"\"\n    Validates the input list: ensures it is a list, not empty, and contains only numeric elements.\n    Raises TypeError or ValueError on invalid input.\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(\"Input must be a list.\")\n    if not values:\n        raise ValueError(\"Input list cannot be empty.\")\n    for element in values:\n        if not _is_numeric(element):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\ndef big_diff(values):\n    \"\"\"\n    Computes the difference between the maximum and minimum elements in a list of numbers.\n    Input `values` must be a non-empty list of int or float.\n    \"\"\"\n    _validate_input(values)\n    max_val = max(values)\n    min_val = min(values)\n    return max_val - min_val\n```"}
{"task_id": "Mbpp/589", "solution": "from typing import List, Tuple\nimport math\n\nclass Range:\n    \"\"\"Encapsulates an inclusive integer interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def as_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the range as a tuple (start, end).\"\"\"\n        return (self.start, self.end)\n\nclass PerfectSquare:\n    \"\"\"Represents a perfect square and its integer root.\"\"\"\n    def __init__(self, root: int) -> None:\n        self.root = root\n        self.value = root * root\n\nclass ResultList:\n    \"\"\"Accumulates perfect square integer values and exposes them as a native list.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def append(self, value: int) -> None:\n        \"\"\"Adds a perfect square value to the list.\"\"\"\n        self.values.append(value)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the accumulated values as a new list.\"\"\"\n        return self.values[:]\n\nclass PerfectSquareFunction:\n    \"\"\"Computes perfect squares within an inclusive range.\"\"\"\n    def perfect_squares(self, start: int, end: int) -> List[int]:\n        \"\"\"Calculates all perfect squares N^2 such that start <= N^2 <= end.\"\"\"\n        # Compute integer root bounds using math.ceil and math.floor.\n        # Assumes start >= 0 for math.sqrt to be well-defined.\n        root_min = math.ceil(math.sqrt(start))\n        root_max = math.floor(math.sqrt(end))\n\n        result_list = ResultList()\n\n        if root_min <= root_max:\n            for root in range(int(root_min), int(root_max) + 1):\n                ps = PerfectSquare(root)\n                result_list.append(ps.value)\n\n        return result_list.to_list()\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"Returns a list of perfect squares N^2 such that start <= N^2 <= end (inclusive).\"\"\"\n    psf = PerfectSquareFunction()\n    return psf.perfect_squares(start, end)"}
{"task_id": "Mbpp/589", "solution": "```python\nimport math\n\n# --- Supporting Domain Classes ---\n\nclass InputValidator:\n    \"\"\"Responsible for validating inputs.\n    The design's explicit type-checking is overridden by CRITICAL REQUIREMENTS.\n    \"\"\"\n    @staticmethod\n    def validate_integers(a, b) -> bool:\n        \"\"\"Returns True always, as direct type checking (e.g., isinstance) is forbidden.\n        This aligns with the instruction to \"Trust the caller's inputs\".\n        \"\"\"\n        return True\n\nclass NumberRange:\n    \"\"\"Represents an inclusive integer range [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start: int = start\n        self.end: int = end\n\nclass PerfectSquare:\n    \"\"\"Represents a single perfect square integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass ResultList:\n    \"\"\"Holds perfect square integers and provides list operations.\"\"\"\n    def __init__(self, squares: list):\n        self.squares: list[int] = squares\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list of squares is empty.\"\"\"\n        return not self.squares\n\n    def to_list(self) -> list[int]:\n        \"\"\"Returns the internal list of squares.\"\"\"\n        return self.squares\n\n# --- Public API Function ---\n\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Computes perfect squares within the inclusive range [start, end] in ascending order.\n    Returns an empty list if no perfect squares are found or if the range is invalid.\n    \"\"\"\n    # The design specifies input validation, but CRITICAL REQUIREMENTS forbid isinstance() checks.\n    # Therefore, InputValidator.validate_integers will always return True, and type errors\n    # for non-integer inputs will occur further down (e.g., math.sqrt).\n    if not InputValidator.validate_integers(start, end):\n        return [] # This branch is effectively unreachable under current constraints.\n\n    # Construct NumberRange as per design's class diagram relationship.\n    _ = NumberRange(start, end)\n\n    # If the range ends before any possible perfect square (i.e., less than 0), return empty.\n    if end < 0:\n        return []\n\n    # Perfect squares are non-negative. Adjust 'start' for sqrt calculation if it's negative.\n    sqrt_calc_start = max(0, start)\n\n    # Compute the integer roots that define the iteration range.\n    n_start = math.ceil(math.sqrt(sqrt_calc_start))\n    n_end = math.floor(math.sqrt(end))\n\n    collected_squares = []\n    # Iterate through potential integer roots and collect their squares.\n    for n in range(int(n_start), int(n_end) + 1):\n        square = n * n\n        # Filter results to ensure they fall within the original 'start' boundary.\n        if square >= start:\n            collected_squares.append(square)\n\n    # The design specifies returning a ResultList, then converting to list.\n    result_list = ResultList(collected_squares)\n    return result_list.to_list()\n```"}
{"task_id": "Mbpp/591", "solution": "```python\n# File: swap_list/src/__init__.py\n\"\"\"Package for the swap_List function.\"\"\"\nfrom .swap_list import swap_List\n\n__all__ = ['swap_List']\n\n# File: swap_list/src/swap_list.py\n\"\"\"Provides swap_List(input: list) -> list\"\"\"\n\n__all__ = ['swap_List']\n\ndef swap_List(input: list) -> list:\n    \"\"\"Return a list where the first and last elements are interchanged.\n    If len(input) < 2, returns a new list identical to input.\n    \"\"\"\n    if not isinstance(input, list):\n        raise TypeError(\"Input must be a list.\")\n\n    n = len(input)\n    if n < 2:\n        return list(input)  # Return a new list, unchanged.\n\n    new_list = list(input)  # Create a new list to avoid mutating the original\n    new_list[0], new_list[n-1] = new_list[n-1], new_list[0]\n    return new_list\n\n# File: swap_list/tests/test_swap_list.py\n\"\"\"Contains TestCase class and unit tests for swap_List function.\"\"\"\nfrom src.swap_list import swap_List\n\nclass TestCase:\n    \"\"\"Lightweight class for encapsulating a single test case.\"\"\"\n    def __init__(self, input_list: list, expected_output: list):\n        self.input = input_list\n        self.expected_output = expected_output\n\n    def run(self) -> bool:\n        \"\"\"Runs the test case and returns True if swap_List output matches expected.\"\"\"\n        return swap_List(self.input) == self.expected_output\n\ndef run_all_tests() -> None:\n    \"\"\"Runs all defined unit tests for swap_List, including the SRS assert and edge cases.\"\"\"\n    print(\"Running unit tests...\")\n\n    # SRS test case\n    srs_input = [12, 35, 9, 56, 24]\n    srs_expected = [24, 35, 9, 56, 12]\n    srs_test_case = TestCase(srs_input, srs_expected)\n\n    # Execute the exact SRS assert\n    assert swap_List(srs_input) == srs_expected, \\\n        f\"SRS direct assert failed: Expected {srs_expected}, got {swap_List(srs_input)}\"\n    print(f\"SRS direct assert passed for {srs_input}\")\n\n    # Assert TestCase.run() returns True for the same test\n    assert srs_test_case.run(), f\"SRS TestCase failed for {srs_input}\"\n    print(f\"SRS TestCase run passed for {srs_input}\")\n\n    # Edge-case behavior: empty list\n    empty_list_input = []\n    empty_list_expected = []\n    empty_list_test_case = TestCase(empty_list_input, empty_list_expected)\n    assert swap_List(empty_list_input) == empty_list_expected, \\\n        f\"Empty list test failed: Expected {empty_list_expected}, got {swap_List(empty_list_input)}\"\n    assert empty_list_test_case.run(), f\"Empty list TestCase failed for {empty_list_input}\"\n    print(f\"Edge case (empty list) passed for {empty_list_input}\")\n\n    # Edge-case behavior: single-element list\n    single_element_input = [7]\n    single_element_expected = [7]\n    single_element_test_case = TestCase(single_element_input, single_element_expected)\n    assert swap_List(single_element_input) == single_element_expected, \\\n        f\"Single-element list test failed: Expected {single_element_expected}, got {swap_List(single_element_input)}\"\n    assert single_element_test_case.run(), f\"Single-element TestCase failed for {single_element_input}\"\n    print(f\"Edge case (single element list) passed for {single_element_input}\")\n\n    # Additional test case: two elements\n    two_elements_input = [1, 2]\n    two_elements_expected = [2, 1]\n    two_elements_test_case = TestCase(two_elements_input, two_elements_expected)\n    assert swap_List(two_elements_input) == two_elements_expected, \\\n        f\"Two-element list test failed: Expected {two_elements_expected}, got {swap_List(two_elements_input)}\"\n    assert two_elements_test_case.run(), f\"Two-element TestCase failed for {two_elements_input}\"\n    print(f\"Normal case (two elements) passed for {two_elements_input}\")\n\n    # Test for non-list input (TypeError)\n    print(\"\\nTesting TypeError for non-list inputs...\")\n    try:\n        swap_List(None)\n        assert False, \"TypeError was not raised for None input.\"\n    except TypeError:\n        print(\"TypeError correctly raised for None input.\")\n    try:\n        swap_List(\"hello\")\n        assert False, \"TypeError was not raised for string input.\"\n    except TypeError:\n        print(\"TypeError correctly raised for string input.\")\n    try:\n        swap_List(123)\n        assert False, \"TypeError was not raised for int input.\"\n    except TypeError:\n        print(\"TypeError correctly raised for int input.\")\n\n    print(\"\\nAll tests passed\")\n\nif __name__ == '__main__':\n    run_all_tests()\n```"}
{"task_id": "Mbpp/591", "solution": "```python\n# src/swap_list.py\n\"\"\"Implementation of swap_List(list) per SRS; public API: swap_List(list) -> list\"\"\"\n\ndef _validate_input(lst: list) -> None:\n    \"\"\"Internal helper: performs minimal validation as per design constraints.\n    Per constraints, no type checks or exceptions are raised.\"\"\"\n    pass\n\ndef _perform_swap(lst: list) -> list:\n    \"\"\"Internal helper: swaps first and last elements of a list, returning a new list.\n    Creates a copy to avoid modifying the original list in place.\"\"\"\n    copied_list = lst.copy()\n    copied_list[0], copied_list[-1] = copied_list[-1], copied_list[0]\n    return copied_list\n\ndef swap_List(lst: list) -> list:\n    \"\"\"Public API: interchanges the first and last elements of a list when applicable.\n    Returns the original list unchanged if its length is less than 2.\"\"\"\n    _validate_input(lst)\n\n    if len(lst) < 2:\n        return lst\n    else:\n        return _perform_swap(lst)\n\n```\n\n```python\n# tests/test_swap_list.py\n\"\"\"Unit tests verifying SRS acceptance criteria for swap_List.\"\"\"\n\nfrom src.swap_list import swap_List\n\ndef test_empty_and_single():\n    \"\"\"Verifies that empty and single-element lists are returned unchanged.\"\"\"\n    assert swap_List([]) == []\n    assert swap_List([10]) == [10]\n    assert swap_List(['a']) == ['a']\n\ndef test_swap_behavior():\n    \"\"\"Verifies general swap correctness and preservation of middle elements.\"\"\"\n    assert swap_List([1, 2]) == [2, 1]\n    assert swap_List([1, 2, 3]) == [3, 2, 1]\n    assert swap_List(['first', 'middle', 'last']) == ['last', 'middle', 'first']\n    assert swap_List([1, 2, 3, 4, 5, 6]) == [6, 2, 3, 4, 5, 1]\n    assert swap_List([5, 5, 5, 5]) == [5, 5, 5, 5]\n\ndef test_example_assertion():\n    \"\"\"Verifies the specific example assertion provided in the SRS.\"\"\"\n    assert swap_List([12, 35, 9, 56, 24]) == [24, 35, 9, 56, 12]\n\n```"}
{"task_id": "Mbpp/590", "solution": "```python\n# polar_to_rect/src/polar_rect_converter.py\nimport math\n\nclass PolarCoordinate:\n    \"\"\"Stores polar inputs r and theta.\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\nclass RectangularCoordinate:\n    \"\"\"Holds rectangular coordinates and presents complex representation.\"\"\"\n    def __init__(self, x: float, y: float) -> None:\n        self.x = x\n        self.y = y\n\n    def toComplex(self) -> complex:\n        \"\"\"Returns the rectangular coordinates as a complex number.\"\"\"\n        return complex(self.x, self.y)\n\nclass PolarRectConverter:\n    \"\"\"Stateless converter for polar to rectangular coordinates.\"\"\"\n    @staticmethod\n    def polar_rect(r: float, theta: float) -> tuple:\n        \"\"\"\n        Converts polar coordinates (r, theta) to rectangular coordinates (x, y)\n        and returns a normalized polar pair and a complex number.\n        \"\"\"\n        x = r * math.cos(theta)\n        y = r * math.sin(theta)\n\n        rect = RectangularCoordinate(x, y)\n\n        r_norm = math.hypot(x, y)\n        theta_norm = math.atan2(y, x)\n\n        z = rect.toComplex()\n\n        return ((r_norm, theta_norm), z)\n\ndef polar_rect(r: float, theta: float) -> tuple:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates.\n    This is a module-level convenience function delegating to PolarRectConverter.\n    \"\"\"\n    return PolarRectConverter.polar_rect(r, theta)\n\n```\n```python\n# polar_to_rect/tests/test_polar_rect.py\nfrom src.polar_rect_converter import polar_rect\n\ndef run_example_assertion() -> None:\n    \"\"\"\n    Verifies the example assertion from the SRS.\n    \"\"\"\n    expected_result = ((5.0, 0.9272952180016122), (-2+2.4492935982947064e-16j))\n    actual_result = polar_rect(3, 4)\n    assert actual_result == expected_result, \\\n        f\"Assertion failed: Expected {expected_result}, got {actual_result}\"\n    print(\"Example assertion passed successfully!\")\n\nif __name__ == \"__main__\":\n    run_example_assertion()\n\n```"}
{"task_id": "Mbpp/592", "solution": "```python\n# src/sum_of_product.py\nimport math\nfrom typing import Any\n\ndef validate_n(n: Any) -> None:\n    \"\"\"Validates that n is a non-negative integer.\n    Raises ValueError for invalid inputs.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\ndef compute_binomial(n: int, k: int) -> int:\n    \"\"\"Computes the binomial coefficient C(n, k) using integer arithmetic.\n    This function leverages math.comb for efficiency and correctness.\"\"\"\n    return math.comb(n, k)\n\ndef compute_sum(n: int) -> int:\n    \"\"\"Computes S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    All calculations are performed using integer arithmetic.\"\"\"\n    total_sum = 0\n    for k in range(n):\n        term1 = compute_binomial(n, k)\n        term2 = compute_binomial(n, k + 1)\n        total_sum += term1 * term2\n    return total_sum\n\ndef sum_Of_product(n: Any) -> int:\n    \"\"\"Calculates the sum of products of consecutive binomial coefficients.\n    It validates input and computes S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\"\"\"\n    validate_n(n)\n    return compute_sum(n)\n\n```\n```python\n# tests/test_sum_of_product.py\nimport pytest\nfrom src.sum_of_product import sum_Of_product\n\ndef test_sum_of_product_example() -> None:\n    \"\"\"Verifies the specific example case sum_Of_product(3) == 15.\"\"\"\n    assert sum_Of_product(3) == 15\n\ndef test_sum_of_product_edge_cases() -> None:\n    \"\"\"Verifies edge cases for n=0 and n=1.\"\"\"\n    assert sum_Of_product(0) == 0\n    assert sum_Of_product(1) == 1 # C(1,0)*C(1,1) = 1*1 = 1\n    assert sum_Of_product(2) == 4 # C(2,0)*C(2,1) + C(2,1)*C(2,2) = 1*2 + 2*1 = 4\n\n\ndef test_invalid_inputs() -> None:\n    \"\"\"Tests that ValueError is raised for negative or non-integer inputs.\n    Includes cases like negative numbers, floats, strings, and other types.\"\"\"\n    invalid_inputs = [-1, -5, 2.5, \"3\", None, [1], True]\n    for n in invalid_inputs:\n        with pytest.raises(ValueError, match=\"n must be a non-negative integer\"):\n            sum_Of_product(n)\n\n```"}
{"task_id": "Mbpp/590", "solution": "```python\nimport math\n\ndef polar_rect(a, b):\n    \"\"\"\n    Interprets inputs a, b as rectangular coordinates (x, y).\n    Computes polar coordinates (r, theta) and returns them alongside complex(x, y).\n    \"\"\"\n    x, y = float(a), float(b)\n    \n    r = math.sqrt(x**2 + y**2)\n    theta = math.atan2(y, x)\n    \n    return ((r, theta), complex(x, y))\n```"}
{"task_id": "Mbpp/592", "solution": "def binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Computes the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Computes the sum of products of consecutive binomial coefficients.\"\"\"\n    total_sum = 0\n    for k in range(n):\n        term_k = binomial_coefficient(n, k)\n        term_k_plus_1 = binomial_coefficient(n, k + 1)\n        total_sum += term_k * term_k_plus_1\n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass Octet:\n    \"\"\"Represents a single octet substring and handles its normalization.\"\"\"\n    def __init__(self, rawValue: str) -> None:\n        self.rawValue: str = rawValue\n        self.normalizedValue: str = \"\"\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"Removes leading zeros, returning \"0\" for all-zero input.\"\"\"\n        self.normalizedValue = str(int(self.rawValue))\n        return self.normalizedValue\n\nclass IPAddress:\n    \"\"\"Manages the parsing, normalization, and reassembly of an IP address.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n        self.normalized: str = \"\"\n        self._octets: List[Octet] = [Octet(o) for o in raw.split('.')]\n\n    def getOctets(self) -> list:\n        \"\"\"Returns the list of Octet objects.\"\"\"\n        return self._octets\n\n    def setNormalized(self, normalized: str) -> None:\n        \"\"\"Sets the normalized IP address string.\"\"\"\n        self.normalized = normalized\n\n    def ensure_normalized(self) -> str:\n        \"\"\"Normalizes each octet and reassembles the IP address string.\"\"\"\n        normalized_octet_strings = [octet.removeLeadingZeros() for octet in self._octets]\n        self.setNormalized(\".\".join(normalized_octet_strings))\n        return self.normalized\n\nclass RemoveZeroIPFunction:\n    \"\"\"Orchestrates the IP address normalization process.\"\"\"\n    def __init__(self) -> None:\n        self.input: str = \"\"\n        self.output: str = \"\"\n\n    def removezero_ip(self, input_string: str) -> str:\n        \"\"\"Processes an IP address string to remove leading zeros.\"\"\"\n        ip_address = IPAddress(input_string)\n        return ip_address.ensure_normalized()\n\ndef removezero_ip(input_string: str) -> str:\n    \"\"\"Top-level function to remove leading zeros from an IPv4 address string.\"\"\"\n    function_instance = RemoveZeroIPFunction()\n    return function_instance.removezero_ip(input_string)"}
{"task_id": "Mbpp/593", "solution": "```python\n# src/removezero_ip.py\n\nfrom typing import List\n\nclass ValidationResult:\n    \"\"\"DTO for validation outcome.\"\"\"\n    def __init__(self, isValid: bool, message: str = \"\") -> None:\n        self.isValid = isValid\n        self.message = message\n\nclass Octet:\n    \"\"\"Represents a single IP octet and handles its normalization.\"\"\"\n    rawValue: str\n    normalizedValue: str\n    position: int\n\n    def __init__(self, rawValue: str, position: int) -> None:\n        self.rawValue = rawValue\n        self.position = position\n        self.normalizedValue = \"\"\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"Removes leading zeros, preserving a single '0' for zero octets.\"\"\"\n        if self.isZero():\n            self.normalizedValue = \"0\"\n        else:\n            self.normalizedValue = str(int(self.rawValue))\n        return self.normalizedValue\n\n    def isZero(self) -> bool:\n        \"\"\"Returns True if rawValue consists entirely of '0' characters.\"\"\"\n        return all(c == '0' for c in self.rawValue) and len(self.rawValue) >= 1\n\nclass IPv4Address:\n    \"\"\"Domain entity representing an IPv4 string, performs validation and normalization.\"\"\"\n    rawValue: str\n    normalizedValue: str\n    octetCount: int\n    octets: List[Octet]\n    validation: ValidationResult\n\n    def __init__(self, rawValue: str) -> None:\n        self.rawValue = rawValue\n        self.normalizedValue = \"\"\n        self.octetCount = 0\n        self.octets = []\n        self.validation = ValidationResult(True)\n\n    def validate(self) -> bool:\n        \"\"\"Validates that the rawValue splits into exactly four components.\"\"\"\n        parts = self.rawValue.split('.')\n        self.octetCount = len(parts)\n        if self.octetCount != 4:\n            self.validation = ValidationResult(False, \"Input must have exactly four octets.\")\n            return False\n        return True\n\n    def normalize(self) -> \"IPv4Address\":\n        \"\"\"Normalizes each octet and constructs the normalized IPv4 string.\"\"\"\n        parts = self.rawValue.split('.')\n        normalized_parts = []\n        for i, part in enumerate(parts):\n            octet = Octet(rawValue=part, position=i+1)\n            normalized_parts.append(octet.removeLeadingZeros())\n            self.octets.append(octet)\n\n        self.normalizedValue = \".\".join(normalized_parts)\n        return self\n\nclass RemoveZeroIPFunction:\n    \"\"\"Orchestrates validation and normalization for an IPv4 string.\"\"\"\n    name: str = \"removezero_ip\"\n\n    def execute(self, input: str) -> IPv4Address:\n        \"\"\"Creates, validates, and normalizes an IPv4Address object.\"\"\"\n        ipv4_address = IPv4Address(rawValue=input)\n        if ipv4_address.validate():\n            ipv4_address.normalize()\n        return ipv4_address\n\ndef removezero_ip(input: str) -> str:\n    \"\"\"Public API to remove leading zeros from IPv4-like strings.\"\"\"\n    runner = RemoveZeroIPFunction()\n    ipv4_address = runner.execute(input)\n    return ipv4_address.normalizedValue\n\n```\n```python\n# tests/test_removezero_ip.py\n\nfrom src.removezero_ip import removezero_ip\n\n# Acceptance test from the SRS example.\nassert removezero_ip(\"216.08.094.196\") == ('216.8.94.196')\n```"}
{"task_id": "Mbpp/594", "solution": "```python\ndef diff_even_odd(int_list):\n    \"\"\"Calculates the difference between the first even and first odd number found.\n    Scans the list from left-to-right to identify these numbers.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in int_list:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd\n```"}
