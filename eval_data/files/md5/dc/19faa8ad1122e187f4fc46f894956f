{"task_id": "Mbpp/724", "solution": "from typing import List\n\nclass InputParameters:\n    \"\"\"Encapsulates and validates inputs base and power.\"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        \"\"\"Validates that base and power are integers.\"\"\"\n        if not isinstance(base, int) or not isinstance(power, int):\n            raise TypeError(\"base and power must be integers\")\n        self.base = base\n        self.power = power\n\nclass PowerComputation:\n    \"\"\"Computes base**power using arbitrary-precision integer arithmetic.\"\"\"\n    def compute(self, base: int, power: int) -> 'BigIntegerResult':\n        \"\"\"Computes base raised to power and returns BigIntegerResult.\"\"\"\n        value = base ** power\n        return BigIntegerResult(value)\n\nclass BigIntegerResult:\n    \"\"\"Holds the computed integer result and provides decimal conversion.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_decimal_string(self) -> str:\n        \"\"\"Returns the decimal string of the integer value.\"\"\"\n        return str(self.value)\n\nclass DecimalRepresentation:\n    \"\"\"Represents decimal digits and provides digit extraction.\"\"\"\n    def __init__(self, digits: str) -> None:\n        \"\"\"Initializes with a string of decimal digits.\"\"\"\n        self.digits = digits\n\n    def to_digit_list(self) -> List[int]:\n        \"\"\"Converts each character to its numeric integer value.\"\"\"\n        return [int(ch) for ch in self.digits]\n\nclass DigitSumResult:\n    \"\"\"Holds the integer sum of digits.\"\"\"\n    def __init__(self, sum: int) -> None:\n        self.sum = sum\n\ndef power_base_sum(base, power) -> int:\n    \"\"\"\n    Computes the sum of decimal digits of base**power.\n    Orchestrates validation, computation, conversion, and summation.\n    \"\"\"\n    input_params = InputParameters(base, power)\n    big_integer_result = PowerComputation().compute(input_params.base, input_params.power)\n    digits_str = big_integer_result.to_decimal_string()\n    digits_list = DecimalRepresentation(digits_str).to_digit_list()\n    digit_sum = sum(digits_list)\n    return digit_sum"}
{"task_id": "Mbpp/724", "solution": "```python\n# src/audit_log.py\nimport datetime\n\nclass AuditLog:\n    \"\"\"Records timestamped messages for operations and errors.\"\"\"\n    def __init__(self):\n        self.entries = []\n\n    def record(self, message: str) -> None:\n        \"\"\"Adds a timestamped message to the log entries.\"\"\"\n        timestamp = datetime.datetime.now()\n        self.entries.append((timestamp, message))\n\n# src/big_integer.py\nclass BigInteger:\n    \"\"\"Wraps Python's arbitrary-precision int for design compliance.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def pow(self, exponent: int) -> 'BigInteger':\n        \"\"\"Computes base to the power of exponent using Python's int.\"\"\"\n        return BigInteger(self.value ** exponent)\n\n    def toDecimalString(self) -> str:\n        \"\"\"Converts the BigInteger's value to its decimal string representation.\"\"\"\n        return str(self.value)\n\n# src/digit_sum_result.py\nclass DigitSumResult:\n    \"\"\"Data container for the computed digit sum and its source decimal string.\"\"\"\n    def __init__(self, digit_sum: int, source_decimal: str):\n        self.digitSum = digit_sum\n        self.sourceDecimal = source_decimal\n\n# src/decimal_converter.py\nclass DecimalConverter:\n    \"\"\"Converts a BigInteger object into its decimal string representation.\"\"\"\n    @staticmethod\n    def to_decimal_string(big_int_value) -> str:\n        \"\"\"Performs the conversion using the BigInteger's internal method.\"\"\"\n        return big_int_value.toDecimalString()\n\n# src/digit_sum_calculator.py\nclass DigitSumCalculator:\n    \"\"\"Calculates the sum of decimal digits from a given decimal string.\"\"\"\n    @staticmethod\n    def sum_digits(decimal_string: str) -> 'DigitSumResult':\n        \"\"\"Sums the digits of the string, ignoring any leading sign.\"\"\"\n        digit_sum = sum(int(digit) for digit in decimal_string if digit.isdigit())\n        return DigitSumResult(digit_sum, decimal_string)\n\n# src/error_handler.py\nclass ErrorHandler:\n    \"\"\"Centralized utility for raising specific TypeError and ValueError exceptions.\"\"\"\n    @staticmethod\n    def raiseTypeError(msg: str) -> None:\n        \"\"\"Raises a TypeError with the provided message.\"\"\"\n        raise TypeError(msg)\n\n    @staticmethod\n    def raiseValueError(msg: str) -> None:\n        \"\"\"Raises a ValueError with the provided message.\"\"\"\n        raise ValueError(msg)\n\n# src/input_parameters.py\nclass InputParameters:\n    \"\"\"Encapsulates and validates the power input parameter.\"\"\"\n    def __init__(self, base: int, power: int):\n        self.base = base\n        self.power = power\n        self.error_handler = ErrorHandler()\n\n    def isValid(self) -> bool:\n        \"\"\"Validates that power is non-negative, as per requirements.\"\"\"\n        if self.power < 0:\n            self.error_handler.raiseValueError(\"Power must be non-negative.\")\n        return True\n\n# src/math_engine.py\nclass MathEngine:\n    \"\"\"Handles core mathematical operations like power computation and digit summation.\"\"\"\n    def __init__(self):\n        self.decimal_converter = DecimalConverter()\n        self.digit_sum_calculator = DigitSumCalculator()\n\n    def computePower(self, base: int, power: int) -> 'BigInteger':\n        \"\"\"Calculates base raised to the power, returning a BigInteger wrapper.\"\"\"\n        big_base = BigInteger(base)\n        return big_base.pow(power)\n\n    def sumDigits(self, value: 'BigInteger') -> int:\n        \"\"\"Converts BigInteger to string and sums its decimal digits.\"\"\"\n        decimal_string = self.decimal_converter.to_decimal_string(value)\n        result = self.digit_sum_calculator.sum_digits(decimal_string)\n        return result.digitSum\n\n# src/power_base_sum_function.py\nclass PowerBaseSumFunction:\n    \"\"\"Orchestrates the computation of digit sum for base raised to a power.\"\"\"\n    def __init__(self, base: int, power: int):\n        self.base = base\n        self.power = power\n        self.audit_logger = AuditLog()\n        self.error_handler = ErrorHandler()\n        self.math_engine = MathEngine()\n        self.input_parameters = InputParameters(base, power)\n\n    def validateInputs(self) -> None:\n        \"\"\"Performs input validation using InputParameters and raises errors.\"\"\"\n        self.input_parameters.isValid()\n\n    def execute(self) -> int:\n        \"\"\"Executes the full digit sum computation process, including validation and logging.\"\"\"\n        try:\n            self.validateInputs()\n            power_result_big_int = self.math_engine.computePower(self.base, self.power)\n            digit_sum = self.math_engine.sumDigits(power_result_big_int)\n\n            log_message = f\"Operation completed: base={self.base}, power={self.power}, result_digit_sum={digit_sum}\"\n            self.audit_logger.record(log_message)\n            return digit_sum\n        except (TypeError, ValueError) as e:\n            error_message = f\"Operation failed: base={self.base}, power={self.power}, error={e}\"\n            self.audit_logger.record(error_message)\n            raise # Re-raise the original exception\n\n# src/power_base_sum.py\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"Public entry point: computes base**power and returns the sum of its decimal digits.\"\"\"\n    pbf = PowerBaseSumFunction(base, power)\n    return pbf.execute()\n```"}
{"task_id": "Mbpp/725", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass QuotedSubstring:\n    value: str\n    start_index: int\n    end_index: int\n    order: int\n\n@dataclass\nclass ResultList:\n    items: List[str]\n\n    def count(self) -> int:\n        return len(self.items)\n\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"Public API. Parses input_string left-to-right, locating double-quote-delimited segments,\n    returns ordered list of substring contents excluding quotes.\n    \"\"\"\n    found_quoted_substrings: List[QuotedSubstring] = []\n    current_search_index = 0\n    order_counter = 0\n\n    while True:\n        first_quote_idx = input_string.find('\"', current_search_index)\n        if first_quote_idx == -1:\n            break\n\n        second_quote_idx = input_string.find('\"', first_quote_idx + 1)\n        if second_quote_idx == -1:\n            break\n\n        extracted_value = input_string[first_quote_idx + 1 : second_quote_idx]\n        order_counter += 1\n        found_quoted_substrings.append(\n            QuotedSubstring(\n                value=extracted_value,\n                start_index=first_quote_idx,\n                end_index=second_quote_idx,\n                order=order_counter\n            )\n        )\n        current_search_index = second_quote_idx + 1\n\n    result_items = [qs.value for qs in found_quoted_substrings]\n    final_result_list = ResultList(items=result_items)\n    return final_result_list.items"}
{"task_id": "Mbpp/725", "solution": "```\n# src/__init__.py\n\"\"\"Package marker for the src Python package.\"\"\"\n# No classes/functions; package init.\n```\n```python\n# src/extract_quotation.py\nimport re\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the raw input text value supplied to the extraction function.\"\"\"\n    value: str\n\n@dataclass\nclass QuotedSubstring:\n    \"\"\"Represents a substring found between double quotes and its sequence order.\"\"\"\n    value: str\n    sequence_order: int\n\n@dataclass\nclass ResultList:\n    \"\"\"Container for QuotedSubstring instances with a count accessor.\"\"\"\n    items: List[QuotedSubstring]\n\n    def count(self) -> int:\n        \"\"\"Returns the number of quoted substrings in the list.\"\"\"\n        return len(self.items)\n\ndef _parse_quoted_substrings(input_value: str) -> List[QuotedSubstring]:\n    \"\"\"Finds quoted substrings in a string and produces QuotedSubstring instances in sequence order.\"\"\"\n    found_substrings: List[QuotedSubstring] = []\n    sequence_order = 0\n    # Use a regular expression to find all non-greedy matches between double quotes.\n    for match in re.finditer(r'\"(.*?)\"', input_value):\n        sequence_order += 1\n        found_substrings.append(QuotedSubstring(value=match.group(1), sequence_order=sequence_order))\n    return found_substrings\n\ndef extract_quotation(input: str) -> list:\n    \"\"\"Extracts substring values contained between double quotation marks from an input string.\n    Returns an ordered list of substring values, or an empty list if none are found.\"\"\"\n    input_obj = InputString(value=input)\n    \n    parsed_items = _parse_quoted_substrings(input_obj.value)\n    result_list_container = ResultList(items=parsed_items)\n    \n    # Extract just the string values for the public API return type.\n    return [item.value for item in result_list_container.items]\n```\n```python\n# src/main.py\nfrom src.extract_quotation import extract_quotation\n\ndef _run_example() -> None:\n    \"\"\"Runs the SRS-provided example assertion to demonstrate extract_quotation.\"\"\"\n    example_string = 'Cortex \"A53\" Based \"multi\" tasking \"Processor\"'\n    expected_result = ['A53', 'multi', 'Processor']\n    actual_result = extract_quotation(example_string)\n\n    print(f\"Input: '{example_string}'\")\n    print(f\"Expected: {expected_result}\")\n    print(f\"Actual: {actual_result}\")\n\n    assert actual_result == expected_result, f\"Example assertion failed: Expected {expected_result}, Got {actual_result}\"\n    print(\"Example assertion passed successfully!\")\n\ndef main() -> None:\n    \"\"\"Main entry point to execute the SRS example.\"\"\"\n    _run_example()\n\nif __name__ == \"__main__\":\n    main()\n```\n```python\n# tests/test_extract_quotation.py\nfrom src.extract_quotation import extract_quotation\n\ndef test_example_extract_quotation() -> None:\n    \"\"\"Unit test that verifies the SRS-provided example assertion.\"\"\"\n    example_string = 'Cortex \"A53\" Based \"multi\" tasking \"Processor\"'\n    expected_result = ['A53', 'multi', 'Processor']\n    actual_result = extract_quotation(example_string)\n    assert actual_result == expected_result\n\ndef test_no_quotations() -> None:\n    \"\"\"Tests behavior when no quoted substrings are present.\"\"\"\n    example_string = 'No quotes here.'\n    expected_result = []\n    actual_result = extract_quotation(example_string)\n    assert actual_result == expected_result\n\ndef test_empty_string() -> None:\n    \"\"\"Tests behavior with an empty input string.\"\"\"\n    example_string = ''\n    expected_result = []\n    actual_result = extract_quotation(example_string)\n    assert actual_result == expected_result\n\ndef test_multiple_quotes_empty_content() -> None:\n    \"\"\"Tests string with empty quoted sections.\"\"\"\n    example_string = 'Text \"\" More \"\" End'\n    expected_result = ['', '']\n    actual_result = extract_quotation(example_string)\n    assert actual_result == expected_result\n\ndef test_quotes_at_start_and_end() -> None:\n    \"\"\"Tests string with quotes at the very beginning and end.\"\"\"\n    example_string = '\"Start\" content \"End\"'\n    expected_result = ['Start', 'End']\n    actual_result = extract_quotation(example_string)\n    assert actual_result == expected_result\n\ndef test_unclosed_quote() -> None:\n    \"\"\"Tests string with an unmatched opening quote (should ignore it).\"\"\"\n    example_string = 'Hello \"world'\n    expected_result = []\n    actual_result = extract_quotation(example_string)\n    assert actual_result == expected_result\n\ndef test_unmatched_closing_quote() -> None:\n    \"\"\"Tests string with an unmatched closing quote (should be ignored).\"\"\"\n    example_string = 'Hello world\"'\n    expected_result = []\n    actual_result = extract_quotation(example_string)\n    assert actual_result == expected_result\n```"}
