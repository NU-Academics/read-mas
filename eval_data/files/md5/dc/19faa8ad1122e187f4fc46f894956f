) -> None:\n        \"\"\"Executes the given function, stores the result, and asserts against expected.\n        This method will raise an AssertionError if the results do not match.\"\"\"\n        print(f\"Running test '{self.name}'...\")\n        self.actualResult = func(*args, **kwargs)\n        assert self.actualResult == self.expectedResult, \\\n            f\"Test '{self.name}' FAILED: Expected {self.expectedResult}, Got {self.actualResult}\"\n        print(f\"Test '{self.name}' PASSED.\")\n\n# The main test function as described in the design.\ndef test_check_monthnumb_number_assertion():\n    \"\"\"Verifies the check_monthnumb_number function for a 31-day month (May).\"\"\"\n    # Create a TestCase instance for the specific assertion required by FR3.\n    test_case = TestCase(name=\"Month 5 has 31 days\", expectedResult=True)\n    # Run the test, delegating the assertion to the TestCase's run method.\n    test_case.run(check_monthnumb_number, 5)\n\n# This part makes the test executable directly for verification.\nif __name__ == \"__main__\":\n    print(\"Executing tests directly...\")\n    try:\n        test_check_monthnumb_number_assertion()\n        print(\"\\nAll specified tests passed successfully!\")\n    except AssertionError as e:\n        print(f\"\\nTest FAILED: {e}\")\n    except Exception as e:\n        print(f\"\\nAn unexpected error occurred: {e}\")\n```"}
