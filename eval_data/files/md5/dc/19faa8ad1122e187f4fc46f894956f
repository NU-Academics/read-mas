{"task_id": "Mbpp/422", "solution": "```python\ndef find_Average_Of_Cube(n) -> float:\n    \"\"\"Computes the average of cubes of the first n natural numbers.\n\n    Assumes n is a positive integer and returns the result as a float.\n    \"\"\"\n    # The sum of the first n cubes is given by the formula (n*(n+1)/2)^2.\n    # The average is this sum divided by n.\n    # Average = ((n * (n + 1) / 2)**2) / n\n    # Simplifying: Average = (n**2 * (n + 1)**2 / 4) / n\n    # Average = (n * (n + 1)**2) / 4\n    \n    # Python's default division handles floats.\n    return (n * (n + 1)**2) / 4\n```"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"Computes the average of the cubes of the first n natural numbers.\n    Assumes n is a positive integer for direct computation.\n    \"\"\"\n    sum_of_cubes = (n * (n + 1) // 2) ** 2\n    return float(sum_of_cubes) / n"}
{"task_id": "Mbpp/424", "solution": "```python\ndef _get_last_char(s):\n    \"\"\"\n    Returns the last character of a string, or an empty string if the input is empty.\n    \"\"\"\n    return s[-1] if s else ''\n\ndef _validate_input(input_tuple):\n    \"\"\"\n    Validates that the input is a tuple.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\ndef _validate_element_is_string(element, index):\n    \"\"\"\n    Validates that a tuple element is a string.\n    Raises TypeError with a contextual message if the element is not a string.\n    \"\"\"\n    if not isinstance(element, str):\n        raise TypeError(f\"Element at index {index} must be a string, but received {type(element).__name__}.\")\n\ndef extract_rear(input_tuple):\n    \"\"\"\n    Extracts the last character of each string in the input tuple, preserving order.\n    Validates input and elements, raising TypeError on violations.\n    \"\"\"\n    _validate_input(input_tuple)\n\n    result = []\n    for index, element in enumerate(input_tuple):\n        _validate_element_is_string(element, index)\n        last_char = _get_last_char(element)\n        result.append(last_char)\n\n    return result\n```"}
{"task_id": "Mbpp/424", "solution": "```python\n# src/extract_rear.py\n\"\"\"Implementation of extract_rear function and associated type aliases.\n\nThis module provides the core logic as per the SRS design specification.\n\"\"\"\nfrom typing import List, Tuple\n\n# Type aliases for documenting expected input and output types.\nStringTuple = Tuple[str, ...]\nCharacterList = List[str]\n\n__all__ = ['extract_rear', 'StringTuple', 'CharacterList']\n\ndef extract_rear(input_tuple: StringTuple) -> CharacterList:\n    \"\"\"Extracts the last character from each string in the input tuple.\n\n    Returns a new list preserving the original order of elements.\n    \"\"\"\n    return [s[-1] for s in input_tuple]\n\n```\n```python\n# tests/test_extract_rear.py\n\"\"\"Unit tests for the extract_rear function, including the SRS assert-style test.\n\nThis module provides a TestCase class and an executable test suite.\n\"\"\"\n# No unittest module import is used for TestCase as per design's custom TestCase.\nfrom src.extract_rear import extract_rear, StringTuple, CharacterList\n\nclass TestCase:\n    \"\"\"Encapsulates test input and expected output for extract_rear verification.\"\"\"\n    def __init__(self, input_tuple: StringTuple, expected: CharacterList):\n        self.input_tuple = input_tuple\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Invokes extract_rear and asserts the result against the expected output.\"\"\"\n        result = extract_rear(self.input_tuple)\n        assert result == self.expected, f\"Failed: Input {self.input_tuple}, Expected {self.expected}, Got {result}\"\n        return True\n\ndef test_assert_example():\n    \"\"\"Executes the exact assert statement provided in the SRS.\"\"\"\n    assert extract_rear(('Mers', 'for', 'Vers')) == ['s', 'r', 's']\n    print('SRS assert test passed successfully.')\n\nif __name__ == '__main__':\n    # Run the specific SRS assert test when the module is executed directly.\n    test_assert_example()\n\n```"}
