{"task_id": "Mbpp/475", "solution": "```python\n# src/sort_counter.py\n# Module: src.sort_counter -- provides sort_counter(input_dict: dict) -> list[tuple]\n\ndef _validate_input(input_dict: dict) -> bool:\n    \"\"\"Returns True if input is a dict; used internally by sort_counter.\"\"\"\n    return isinstance(input_dict, dict)\n\ndef sort_counter(input_dict: dict) -> list[tuple]:\n    \"\"\"Accepts a dict and returns a list of (key, value) tuples sorted by value descending.\"\"\"\n    if not _validate_input(input_dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    items = list(input_dict.items())\n    sorted_items = sorted(items, key=lambda kv: kv[1], reverse=True)\n    return sorted_items\n```\n```python\n# tests/test_sort_counter.py\n# Test: tests.test_sort_counter -- runs assertion from SRS (FR5)\n\nfrom src.sort_counter import sort_counter\n\ndef test_assertion() -> None:\n    \"\"\"Verifies the required example assertion for sort_counter.\"\"\"\n    test_dict = {'Math': 81, 'Physics': 83, 'Chemistry': 87}\n    expected_output = [('Chemistry', 87), ('Physics', 83), ('Math', 81)]\n    assert sort_counter(test_dict) == expected_output\n```"}
{"task_id": "Mbpp/473", "solution": "```python\nfrom typing import List, Set, Tuple, Any\n\nclass TuplePair:\n    \"\"\"Represents a 2-element tuple, providing canonicalization and unordered-equality semantics.\"\"\"\n    def __init__(self, e1: Any, e2: Any) -> None:\n        self._e1 = e1\n        self._e2 = e2\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, TuplePair):\n            return NotImplemented\n        return self._e1 == other._e1 and self._e2 == other._e2\n\n    def __hash__(self) -> int:\n        return hash((self._e1, self._e2))\n\n    def canonicalize(self) -> 'TuplePair':\n        \"\"\"Returns a new TuplePair in canonical (min, max) order.\"\"\"\n        return TuplePair(min(self._e1, self._e2), max(self._e1, self._e2))\n\n    def equals_unordered(self, other: 'TuplePair') -> bool:\n        \"\"\"Checks if two TuplePair instances are equivalent ignoring order.\"\"\"\n        return self.canonicalize() == other.canonicalize()\n\n    def _as_native_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Internal helper to get elements as a Python tuple.\"\"\"\n        return (self._e1, self._e2)\n\nclass TupleSet:\n    \"\"\"Encapsulates a set of canonical Python tuples and supports intersection.\"\"\"\n    def __init__(self, iterable: 'Set[Tuple[Any, Any]]' = None) -> None:\n        \"\"\"Initializes TupleSet, expecting an iterable of canonical native Python tuples.\"\"\"\n        self._tuples: Set[Tuple[Any, Any]] = set()\n        if iterable is not None:\n            self._tuples.update(iterable)\n\n    def add(self, pair: 'TuplePair') -> None:\n        \"\"\"Adds a canonical TuplePair to the set, storing its native tuple form.\"\"\"\n        self._tuples.add(pair._as_native_tuple())\n\n    def contains(self, pair: 'TuplePair') -> bool:\n        \"\"\"Checks if the set contains the canonical form of the given TuplePair.\"\"\"\n        return pair._as_native_tuple() in self._tuples\n\n    def intersection(self, other: 'TupleSet') -> 'TupleSet':\n        \"\"\"Computes the intersection with another TupleSet, returning a new TupleSet.\"\"\"\n        result_native_tuples = self._tuples.intersection(other._tuples)\n        return TupleSet(result_native_tuples)\n\n    def as_python_set(self) -> Set[Tuple[Any, Any]]:\n        \"\"\"Returns the internal set of canonical Python tuples.\"\"\"\n        return self._tuples\n\nclass TupleList:\n    \"\"\"Adapter for input lists; constructs TuplePair instances and can produce a canonical TupleSet.\"\"\"\n    def __init__(self, tuples: list) -> None:\n        \"\"\"Initializes TupleList by wrapping native tuples into TuplePair instances.\"\"\"\n        self._tuples: List[TuplePair] = [TuplePair(e1, e2) for e1, e2 in tuples]\n\n    def add(self, pair: 'TuplePair') -> None:\n        \"\"\"Adds a TuplePair instance to the list.\"\"\"\n        self._tuples.append(pair)\n\n    def as_canonical_set(self) -> 'TupleSet':\n        \"\"\"Converts the list of TuplePairs to a TupleSet of canonical native tuples.\"\"\"\n        canonicalizer = Canonicalizer() # Instantiates Canonicalizer as it's stateless\n        canonical_native_tuples: Set[Tuple[Any, Any]] = set()\n        for pair in self._tuples:\n            canonical_pair = canonicalizer.canonicalize(pair)\n            canonical_native_tuples.add(canonical_pair._as_native_tuple())\n        return TupleSet(canonical_native_tuples)\n\nclass Canonicalizer:\n    \"\"\"Stateless service to canonicalize TuplePair instances to (min, max) TuplePair.\"\"\"\n    def canonicalize(self, pair: 'TuplePair') -> 'TuplePair':\n        \"\"\"Canonicalizes a TuplePair by returning a new TuplePair with elements in (min, max) order.\"\"\"\n        return pair.canonicalize()\n\nclass TupleIntersectionFunction:\n    \"\"\"Orchestrates canonicalization and set intersection to compute results.\"\"\"\n    def __init__(self, canonicalizer: 'Canonicalizer') -> None:\n        self._canonicalizer = canonicalizer\n\n    def tuple_intersection(self, listA: 'TupleList', listB: 'TupleList') -> 'TupleSet':\n        \"\"\"Computes the intersection of two TupleLists, returning a TupleSet of canonical results.\"\"\"\n        # Build canonical set A\n        canonical_set_a = TupleSet()\n        for pair in listA._tuples:\n            canonical_pair = self._canonicalizer.canonicalize(pair)\n            canonical_set_a.add(canonical_pair)\n\n        # Build canonical set B\n        canonical_set_b = TupleSet()\n        for pair in listB._tuples:\n            canonical_pair = self._canonicalizer.canonicalize(pair)\n            canonical_set_b.add(canonical_pair)\n\n        return canonical_set_a.intersection(canonical_set_b)\n\ndef tuple_intersection(listA: list, listB: list) -> Set[Tuple[Any, Any]]:\n    \"\"\"Accept Python lists of 2-element tuples and return a Python set of canonical 2-element tuples.\"\"\"\n    tuple_list_a = TupleList(listA)\n    tuple_list_b = TupleList(listB)\n\n    canonicalizer = Canonicalizer()\n    intersection_function = TupleIntersectionFunction(canonicalizer)\n\n    result_tuple_set = intersection_function.tuple_intersection(tuple_list_a, tuple_list_b)\n\n    return result_tuple_set.as_python_set()\n```"}
