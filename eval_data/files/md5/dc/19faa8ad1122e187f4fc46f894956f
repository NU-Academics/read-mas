{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence that includes arr[k].\n    The subsequence must use elements from arr[0..i] and arr[k].\n    \"\"\"\n    \n    # Initialize dp array to store the maximum sum of an increasing subsequence ending at each index j <= i.\n    # dp[j] will store the maximum sum of a strictly increasing subsequence ending with arr[j].\n    dp = [0] * (i + 1)\n\n    # Fill dp array using dynamic programming for prefix arr[0...i]\n    for j in range(i + 1):\n        dp[j] = arr[j]  # The subsequence can just be arr[j] itself\n        for p in range(j):\n            if arr[p] < arr[j]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n    # Find the maximum sum from dp array whose last element (arr[j]) is strictly less than arr[k]\n    best_prefix_sum = 0\n    threshold_k = arr[k]\n\n    for j in range(i + 1):\n        if arr[j] < threshold_k:\n            best_prefix_sum = max(best_prefix_sum, dp[j])\n\n    # The result is the best prefix sum plus arr[k]\n    return best_prefix_sum + threshold_k"}
{"task_id": "Mbpp/308", "solution": "```python\n# src/__init__.py\nfrom .large_product import large_product\n```\n```python\n# src/models.py\nfrom typing import List, Optional\n\nclass InputList:\n    \"\"\"Container for an input list, mirroring the INPUT_LIST data model.\"\"\"\n    def __init__(self, elements: List[int], role: Optional[str] = None) -> None:\n        self.elements = elements\n        self.role = role\n\nclass Product:\n    \"\"\"Represents a computed product and its source operands.\"\"\"\n    def __init__(self, element_from_a: int, element_from_b: int) -> None:\n        self.value = element_from_a * element_from_b\n        self.element_from_a = element_from_a\n        self.element_from_b = element_from_b\n\nclass Result:\n    \"\"\"Represents the return payload: a list of integer product values sorted descending.\"\"\"\n    def __init__(self, products: List[int]) -> None:\n        self.products = products\n```\n```python\n# src/large_product.py\nfrom typing import List\n# Note: InputList and Result are part of the design model but not strictly\n# used by these functions for parameter/return types, so only Product is imported for its conceptual role.\nfrom .models import Product\n\n\ndef _compute_all_products(list_a: List[int], list_b: List[int]) -> List[int]:\n    \"\"\"Computes all pairwise products from two lists of integers.\"\"\"\n    all_products = []\n    for a in list_a:\n        for b in list_b:\n            all_products.append(a * b) # Directly append the product value.\n    return all_products\n\ndef _select_top_k(products: List[int], k: int) -> List[int]:\n    \"\"\"Selects the k largest numeric values from a list and returns them sorted descending.\"\"\"\n    if k <= 0:\n        return []\n    if not products:\n        return []\n\n    # Sort all products in descending order.\n    products.sort(reverse=True)\n    # Return the first k elements, or fewer if not enough are available.\n    return products[:k]\n\ndef large_product(list_a: List[int], list_b: List[int], k: int) -> List[int]:\n    \"\"\"\n    Computes all pairwise products, selects the k largest, and returns them\n    sorted in descending order.\n    \"\"\"\n    if not list_a or not list_b or k <= 0:\n        return []\n\n    all_products = _compute_all_products(list_a, list_b)\n    top_k_products = _select_top_k(all_products, k)\n    return top_k_products\n```"}
{"task_id": "Mbpp/306", "solution": "```python\n# src/domain.py\nfrom typing import List, Optional\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass Element:\n    \"\"\"Represents an element with its value and original index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\nclass Array:\n    \"\"\"Represents the input array as a domain object.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the array.\"\"\"\n        return len(self.elements)\n\nclass Subsequence:\n    \"\"\"Represents a strictly increasing subsequence.\"\"\"\n    def __init__(self, elements: Optional[List[Element]] = None):\n        self.elements: List[Element] = [] if elements is None else list(elements) # Create a copy to prevent mutation issues\n\n    def append(self, element: Element) -> None:\n        \"\"\"Appends an element to the subsequence.\"\"\"\n        self.elements.append(element)\n\n    def sum(self) -> int:\n        \"\"\"Computes the sum of elements in the subsequence.\"\"\"\n        return sum(e.value for e in self.elements)\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"Checks if the subsequence elements are strictly increasing by value.\"\"\"\n        if not self.elements:\n            return True\n        for i in range(len(self.elements) - 1):\n            if self.elements[i].value >= self.elements[i+1].value:\n                return False\n        return True\n\nclass FunctionCall:\n    \"\"\"Encapsulates the parameters and execution logic for the max sum increasing subsequence computation.\"\"\"\n    def __init__(self, arr: Array, n: int, i: int, k: int):\n        self.arr = arr\n        self.n = n\n        self.i = i\n        self.k = k\n\n    def execute(self) -> int:\n        \"\"\"Performs the main computation logic to find the maximum sum.\"\"\"\n        val_k = self.arr.elements[self.k]\n        max_prefix_sum_found = 0\n\n        # dp[j] stores the Subsequence object that gives the maximum sum\n        # of an increasing subsequence ending at index j (inclusive) in arr[0..i].\n        dp: List[Optional[Subsequence]] = [None] * (self.i + 1)\n\n        for j in range(self.i + 1):\n            current_element = Element(self.arr.elements[j], j)\n            # Initialize with subsequence containing only current_element\n            max_sub_ending_j = Subsequence([current_element])\n\n            for p in range(j):\n                prev_sub = dp[p]\n                if prev_sub is not None and prev_sub.elements[-1].value < current_element.value:\n                    # Check if extending prev_sub gives a larger sum\n                    if prev_sub.sum() + current_element.value > max_sub_ending_j.sum():\n                        # Create a new subsequence by copying and appending\n                        max_sub_ending_j = Subsequence(prev_sub.elements)\n                        max_sub_ending_j.append(current_element)\n            \n            dp[j] = max_sub_ending_j\n\n            # If the last element of this prefix subsequence is less than arr[k],\n            # consider its sum for the overall maximum.\n            if current_element.value < val_k:\n                max_prefix_sum_found = max(max_prefix_sum_found, max_sub_ending_j.sum())\n        \n        # The result is the maximum found prefix sum plus arr[k].\n        return max_prefix_sum_found + val_k\n\n```\n```python\n# src/max_sum_increasing_subseq.py\nfrom src.domain import Array, FunctionCall, ValidationError\n\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of a strictly-increasing subsequence formed from\n    a prefix arr[0..i] followed by arr[k], with k > i.\n    \"\"\"\n    # Validate inputs as per design specifications.\n    if n != len(arr):\n        raise ValidationError(\"n != len(arr)\")\n    if not (0 <= i < n):\n        raise ValidationError(\"i out of range\")\n    if not (0 <= k < n and k > i):\n        raise ValidationError(\"k out of range or k <= i\")\n\n    # Create domain Array object.\n    array_obj = Array(arr)\n    # Delegate computation to FunctionCall object.\n    function_call_obj = FunctionCall(array_obj, n, i, k)\n    return function_call_obj.execute()\n\n```\n```python\n# tests/test_max_sum_increasing_subseq.py\nfrom src.max_sum_increasing_subseq import max_sum_increasing_subseq\nfrom src.domain import ValidationError # Import ValidationError to catch it in other tests if needed\n\ndef test_srs_example():\n    \"\"\"Verify the example provided in the SRS document.\"\"\"\n    arr = [1, 101, 2, 3, 100, 4, 5]\n    n = 7\n    i = 4\n    k = 6\n    # Expected result: [1, 2, 3] + 5 = 11.\n    assert max_sum_increasing_subseq(arr, n, i, k) == 11\n\n```"}
{"task_id": "Mbpp/308", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Represents validation errors raised by validate_inputs.\n    Contains a code and a message describing the error.\n    \"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(message)\n\nclass Product:\n    \"\"\"\n    Represents a computed product and indices of contributing elements.\n    Stores the product value and the original indices from list1 and list2.\n    \"\"\"\n    def __init__(self, value: float, elementA_index: int, elementB_index: int):\n        self.value = value\n        self.elementA_index = elementA_index\n        self.elementB_index = elementB_index\n\ndef validate_inputs(list1: list, list2: list, k: int) -> None:\n    \"\"\"\n    Validates that list1 and list2 are lists and k is a positive integer.\n    Raises ValidationError if inputs are invalid.\n    \"\"\"\n    if not isinstance(list1, list):\n        raise ValidationError(\"INVALID_LIST1_TYPE\", \"list1 must be a list.\")\n    if not isinstance(list2, list):\n        raise ValidationError(\"INVALID_LIST2_TYPE\", \"list2 must be a list.\")\n    if not isinstance(k, int) or k <= 0:\n        raise ValidationError(\"INVALID_K_VALUE\", \"k must be a positive integer.\")\n\ndef compute_pairwise_products(list1: list, list2: list) -> list[Product]:\n    \"\"\"\n    Computes all Cartesian products of elements from list1 and list2.\n    Returns a list of Product objects.\n    \"\"\"\n    products = []\n    for i in range(len(list1)):\n        for j in range(len(list2)):\n            # Design assumes numeric values in lists after input validation.\n            # Any TypeError from non-numeric elements will propagate.\n            product_value = list1[i] * list2[j]\n            products.append(Product(value=float(product_value), elementA_index=i, elementB_index=j))\n    return products\n\ndef sort_products_descending(products: list[float]) -> list[float]:\n    \"\"\"\n    Sorts a list of numeric values in descending order.\n    Returns a new list of numeric values.\n    \"\"\"\n    sorted_values = sorted(products, reverse=True)\n    return sorted_values\n\ndef select_top_k(products: list[float], k: int) -> list[float]:\n    \"\"\"\n    Selects the top k products from a descending-sorted list.\n    Returns all products if k exceeds the list length.\n    \"\"\"\n    if k >= len(products):\n        return products\n    return products[:k]\n\ndef large_product(list1: list, list2: list, k: int) -> list[float]:\n    \"\"\"\n    Finds the k largest pairwise products from two input lists.\n    Validates inputs, handles empty lists, computes and sorts products.\n    \"\"\"\n    validate_inputs(list1, list2, k)\n\n    if not list1 or not list2:\n        return []\n\n    products_objects = compute_pairwise_products(list1, list2)\n    numeric_products = [p.value for p in products_objects]\n    \n    sorted_products = sort_products_descending(numeric_products)\n    \n    return select_top_k(sorted_products, k)"}
