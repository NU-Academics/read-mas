{"task_id": "Mbpp/626", "solution": "```python\nfrom typing import Optional\n\nclass ValidationError:\n    \"\"\"Conceptual container for validation failure details.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n\nclass AreaResult:\n    \"\"\"Container for the computed area value.\"\"\"\n    def __init__(self, value: float):\n        self.value = float(value)\n\nclass Radius:\n    \"\"\"Value wrapper for radius with validation logic.\"\"\"\n    def __init__(self, value):\n        self.value = float(value) # Cast to float, accepting int or float input\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the radius value is non-negative.\"\"\"\n        return self.value >= 0\n\nclass TriangleAreaService:\n    \"\"\"Encapsulates validation and computation for triangle area.\"\"\"\n    def triangle_area(self, radius) -> Optional[float]:\n        \"\"\"Validates radius and computes the area for non-negative radii.\"\"\"\n        r_obj = Radius(radius)\n        if not r_obj.is_valid():\n            # Returning None for invalid radius as per specification.\n            return None\n        return self._compute_area(r_obj.value)\n\n    def _compute_area(self, radius_val: float) -> float:\n        \"\"\"Internal helper to compute the area as r * r.\"\"\"\n        # Area of the largest triangle inscribed in a semicircle is r * r.\n        return radius_val * radius_val\n\ndef triangle_area(radius) -> Optional[float]:\n    \"\"\"Calculates the area of the largest triangle in a semicircle.\n    Returns None for negative radii, else r*r.\n    \"\"\"\n    service = TriangleAreaService()\n    return service.triangle_area(radius)\n```"}
{"task_id": "Mbpp/628", "solution": "```python\n# src/replace_spaces.py\nfrom typing import List\n\nclass InputString:\n    \"\"\"Thin value object representing input (mirrors SRS).\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n        self.length: int = len(value)\n\nclass OutputString:\n    \"\"\"Thin value object representing output (mirrors SRS).\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass ReplaceSpacesFunction:\n    \"\"\"Implements FR2-FR7: returns a new string with each ' ' replaced by '%20'.\"\"\"\n    def replace(self, input: str) -> str:\n        \"\"\"Iterates input, builds list/buffer, appends '%20' on ' ', else appends char; returns ''.join(buffer).\"\"\"\n        output_buffer: List[str] = []\n        for char in input:\n            if char == ' ':\n                output_buffer.append('%20')\n            else:\n                output_buffer.append(char)\n        return \"\".join(output_buffer)\n\ndef replace_spaces(input: str) -> str:\n    \"\"\"Public function (FR1) - delegates to ReplaceSpacesFunction.replace.\"\"\"\n    return ReplaceSpacesFunction().replace(input)\n\n```\n```python\n# tests/test_replace_spaces.py\nfrom typing import List\nfrom src.replace_spaces import replace_spaces, ReplaceSpacesFunction\n\nclass TestCase:\n    \"\"\"Executes a single test by calling replace_spaces and comparing result to expected.\"\"\"\n    def __init__(self, description: str, input_value: str, expected: str):\n        self.description: str = description\n        self.input_value: str = input_value\n        self.expected: str = expected\n\n    def run(self) -> None:\n        \"\"\"Calls replace_spaces, compares output to expected, and raises AssertionError on mismatch.\"\"\"\n        actual_output = replace_spaces(self.input_value)\n        if actual_output != self.expected:\n            raise AssertionError(f\"Expected: '{self.expected}', Actual: '{actual_output}'\")\n\nTEST_CASES: List[TestCase] = [\n    TestCase(\n        description=\"FR8: SRS example assertion\",\n        input_value=\"My Name is Dawood\",\n        expected=\"My%20Name%20is%20Dawood\"\n    ),\n    TestCase(\n        description=\"FR5: Empty string input\",\n        input_value=\"\",\n        expected=\"\"\n    ),\n    TestCase(\n        description=\"FR6: No spaces in input\",\n        input_value=\"abc\",\n        expected=\"abc\"\n    ),\n    TestCase(\n        description=\"FR2: Single space input\",\n        input_value=\" \",\n        expected=\"%20\"\n    ),\n    TestCase(\n        description=\"FR4: Leading spaces\",\n        input_value=\"  a\",\n        expected=\"%20%20a\"\n    ),\n    TestCase(\n        description=\"FR4: Trailing spaces\",\n        input_value=\"a  \",\n        expected=\"a%20%20\"\n    ),\n    TestCase(\n        description=\"FR4: Consecutive spaces in middle\",\n        input_value=\"a  b\",\n        expected=\"a%20%20b\"\n    ),\n    TestCase(\n        description=\"FR3: Non-space characters preserved\",\n        input_value=\"Abc 123!@#\",\n        expected=\"Abc%20123!@#\"\n    ),\n    TestCase(\n        description=\"Mixed leading, trailing, and consecutive spaces\",\n        input_value=\"  hello   world  \",\n        expected=\"%20%20hello%20%20%20world%20%20\"\n    ),\n    TestCase(\n        description=\"String with only spaces\",\n        input_value=\"   \",\n        expected=\"%20%20%20\"\n    ),\n]\n\n```\n```python\n# tests/run_tests.py\nimport sys\nimport os\nfrom typing import List\n\n# Add the project root to sys.path to enable importing modules from src/\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))\n\nfrom tests.test_replace_spaces import TEST_CASES, TestCase\n\ndef run_all_tests(tests_to_run: List[TestCase]) -> int:\n    \"\"\"Runs all provided test cases and prints a summary of pass/fail counts.\"\"\"\n    print(\"Running tests...\")\n    total_tests = len(tests_to_run)\n    passed_tests = 0