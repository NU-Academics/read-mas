{"task_id": "Mbpp/478", "solution": "```python\n# remove_lowercase_service_srs_project/src/__init__.py\n# This file can be empty to mark the directory as a Python package.\n\n\n# remove_lowercase_service_srs_project/src/remove_lowercase_service.py\n\ndef _is_ascii_lower(c: str) -> bool:\n    \"\"\"Checks if a character is an ASCII lowercase letter.\"\"\"\n    return 'a' <= c <= 'z'\n\nclass InputString:\n    \"\"\"Encapsulates input string and provides small predicates.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if the string is empty.\"\"\"\n        return len(self._value) == 0\n\n    def contains_lowercase_ascii(self) -> bool:\n        \"\"\"Checks if the string contains any ASCII lowercase character.\"\"\"\n        return any(_is_ascii_lower(c) for c in self._value)\n\nclass OutputString:\n    \"\"\"Encapsulates result string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> str:\n        \"\"\"The resulting string.\"\"\"\n        return self._value\n\nclass RemoveLowercaseService:\n    \"\"\"Stateless service implementing removal algorithm.\"\"\"\n    def remove_lowercase(self, input: str) -> str:\n        \"\"\"\n        Removes contiguous ASCII lowercase substrings from the input string.\n        Preserves non-lowercase characters and returns the modified string.\n        \"\"\"\n        if InputString(input).is_empty():\n            return \"\"\n\n        preserved_chars = []\n        for char in input:\n            if not _is_ascii_lower(char):\n                preserved_chars.append(char)\n\n        return OutputString(''.join(preserved_chars)).value\n\ndef remove_lowercase(input: str) -> str:\n    \"\"\"\n    Public API to remove contiguous ASCII lowercase substrings from a string.\n    Delegates to RemoveLowercaseService for the actual removal logic.\n    \"\"\"\n    return RemoveLowercaseService().remove_lowercase(input)\n\n\n# remove_lowercase_service_srs_project/tests/test_remove_lowercase.py\nimport unittest\nfrom src.remove_lowercase_service import remove_lowercase\n\nclass UnitTest(unittest.TestCase):\n    \"\"\"Unit tests for the remove_lowercase function.\"\"\"\n    def test_example(self):\n        \"\"\"Asserts the example case from the SRS.\"\"\"\n        self.assertEqual(remove_lowercase(\"PYTHon\"), 'PYTH')\n```"}
{"task_id": "Mbpp/479", "solution": "```python\n# src/domain.py\n\nclass InputNumber:\n    \"\"\"A value object for the input number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass FirstDigitResult:\n    \"\"\"A value object for the computed first digit.\"\"\"\n    def __init__(self, digit: int):\n        self.digit = digit\n```\n```python\n# src/validator.py\n\nclass Validator:\n    \"\"\"Encapsulates validation logic for inputs.\"\"\"\n    def is_valid(self, n) -> bool:\n        \"\"\"Returns True if n is of built-in int type, else False.\"\"\"\n        return type(n) is int\n```\n```python\n# src/first_digit.py\nfrom src.validator import Validator\nfrom src.domain import InputNumber, FirstDigitResult\n\ndef first_Digit(n) -> int:\n    \"\"\"\n    Returns the first (most-significant) decimal digit of integer n.\n    Raises TypeError if input n is not an integer.\n    \"\"\"\n    validator = Validator()\n    if not validator.is_valid(n):\n        raise TypeError(\"Input must be an integer.\")\n\n    input_num = InputNumber(n)\n    value = input_num.value\n\n    if value == 0:\n        digit = 0\n    else:\n        value = abs(value)\n        while value >= 10:\n            value //= 10\n        digit = value\n\n    result = FirstDigitResult(digit)\n    return result.digit\n```\n```python\n# tests/test_first_digit.py\nfrom src.first_digit import first_Digit\nimport pytest\n\ndef test_example_first_digit():\n    \"\"\"Verifies the specified example: first_Digit(123) == 1.\"\"\"\n    assert first_Digit(123) == 1\n\ndef test_single_digit_number():\n    \"\"\"Tests a single-digit positive number.\"\"\"\n    assert first_Digit(5) == 5\n\ndef test_large_number():\n    \"\"\"Tests a multi-digit positive number.\"\"\"\n    assert first_Digit(987654321) == 9\n\ndef test_number_with_zeros():\n    \"\"\"Tests a number containing zeros.\"\"\"\n    assert first_Digit(1000) == 1\n    assert first_Digit(705) == 7\n\ndef test_zero_input():\n    \"\"\"Tests the input zero.\"\"\"\n    assert first_Digit(0) == 0\n\ndef test_negative_number():\n    \"\"\"Tests a negative integer input.\"\"\"\n    assert first_Digit(-123) == 1\n    assert first_Digit(-9876) == 9\n    assert first_Digit(-5) == 5\n\ndef test_invalid_input_type():\n    \"\"\"Tests that a TypeError is raised for non-integer inputs.\"\"\"\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        first_Digit(12.3)\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        first_Digit(\"123\")\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        first_Digit([1, 2, 3])\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        first_Digit(None)\n```"}
