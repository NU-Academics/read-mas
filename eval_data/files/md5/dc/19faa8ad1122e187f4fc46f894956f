{"task_id": "Mbpp/167", "solution": "**src/next_power_of_two/__init__.py**\n```python\n\"\"\"Package initializer; re-exports the public API function next_power_of_2.\"\"\"\nfrom .next_power_of_two import next_power_of_2\n```\n\n**src/next_power_of_two/validator.py**\n```python\n\"\"\"Input validation component ensuring n is a non-negative integer.\"\"\"\n\nclass InputValidator:\n    \"\"\"Validates that input n is an integer and n >= 0, raising ValueError for invalid inputs.\"\"\"\n\n    def validate_non_negative_integer(self, n) -> None:\n        \"\"\"Raise ValueError if n is not an int or n < 0; otherwise do nothing.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(f\"Input must be an integer, but received type {type(n).__name__}.\")\n        if n < 0:\n            raise ValueError(f\"Input must be a non-negative integer, but received {n}.\")\n```\n\n**src/next_power_of_two/checker.py**\n```python\n\"\"\"Power-of-two computation component; tests for power-of-two and computes next power.\"\"\"\n\nclass PowerOfTwoChecker:\n    \"\"\"Provides routines to test whether a number is a power of two and to compute the next power.\"\"\"\n\n    def is_power_of_two(self, n) -> bool:\n        \"\"\"Return True if n is a power of two (n > 0 and single 1-bit); False otherwise.\"\"\"\n        return n > 0 and (n & (n - 1)) == 0\n\n    def next_power_of_two(self, n) -> int:\n        \"\"\"Return smallest power of two >= n; return 1 if n == 0.\"\"\"\n        if n == 0:\n            return 1\n        if self.is_power_of_two(n):\n            return n\n        # For n > 0 and not a power of two, find the next power of two.\n        # This is equivalent to 2^(number of bits in n).\n        return 1 << n.bit_length()\n```\n\n**src/next_power_of_two/next_power_of_two.py**\n```python\n\"\"\"Public API module; defines NextPowerOf2Function and exposes next_power_of_2(n) as the API entry point.\"\"\"\nfrom .validator import InputValidator\nfrom .checker import PowerOfTwoChecker\n\nclass NextPowerOf2Function:\n    \"\"\"Orchestrates validation and computation to deliver the API result.\"\"\"\n\n    def next_power_of_2(self, n: int) -> int:\n        \"\"\"Validate n via InputValidator then compute via PowerOfTwoChecker.\"\"\"\n        validator = InputValidator()\n        validator.validate_non_negative_integer(n)\n\n        checker = PowerOfTwoChecker()\n        return checker.next_power_of_2(n)\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"Public API function; delegates to NextPowerOf2Function().next_power_of_2(n).\"\"\"\n    orchestrator = NextPowerOf2Function()\n    return orchestrator.next_power_of_2(n)\n```\n\n**tests/test_next_power_of_two.py**\n```python\n\"\"\"Unit test suite verifying requirements: zero case, power-of-two case, general case, and invalid inputs.\"\"\"\nimport unittest\nfrom src.next_power_of_two.next_power_of_two import next_power_of_2\n\nclass TestCase(unittest.TestCase):\n    \"\"\"Unit test harness exercising the API to verify FRs and invalid-input behavior.\"\"\"\n\n    def test_zero_case(self):\n        \"\"\"Asserts next_power_of_2(0) == 1.\"\"\"\n        self.assertEqual(next_power_of_2(0), 1)\n\n    def test_power_of_two_case(self):\n        \"\"\"Asserts next_power_of_2(n) == n when n is a power of two.\"\"\"\n        self.assertEqual(next_power_of_2(1), 1)\n        self.assertEqual(next_power_of_2(2), 2)\n        self.assertEqual(next_power_of_2(4), 4)\n        self.assertEqual(next_power_of_2(8), 8)\n        self.assertEqual(next_power_of_2(16), 16)\n        self.assertEqual(next_power_of_2(1024), 1024)\n\n    def test_general_case(self):\n        \"\"\"Asserts next_power_of_2(n) returns the smallest power of two greater than n.\"\"\"\n        self.assertEqual(next_power_of_2(3), 4)\n        self.assertEqual(next_power_of_2(5), 8)\n        self.assertEqual(next_power_of_2(6), 8)\n        self.assertEqual(next_power_of_2(7), 8)\n        self.assertEqual(next_power_of_2(9), 16)\n        self.assertEqual(next_power_of_2(15), 16)\n        self.assertEqual(next_power_of_2(17), 32)\n        self.assertEqual(next_power_of_2(1000), 1024)\n\n    def test_invalid_inputs(self):\n        \"\"\"Asserts ValueError is raised for negative and non-integer inputs.\"\"\"\n        with self.assertRaises(ValueError):\n            next_power_of_2(-1)\n        with self.assertRaises(ValueError):\n            next_power_of_2(-10)\n        with self.assertRaises(ValueError):\n            next_power_of_2(3.5)\n        with self.assertRaises(ValueError):\n            next_power_of_2(0.1)\n        with self.assertRaises(ValueError):\n            next_power_of_2(\"abc\")\n        with self.assertRaises(ValueError):\n            next_power_of_2(None)\n\nif __name__ == '__main__':\n    unittest.main()\n```"}
{"task_id": "Mbpp/167", "solution": "```python\n# next_power_of_2.py\n\n__all__ = [\"next_power_of_2\"]\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"Compute the smallest power of two >= n. Precondition: n is a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n    \n    power = 1\n    while power < n:\n        power <<= 1\n    return power\n\n```\n```python\n# test_next_power_of_2.py\n\nfrom next_power_of_2 import next_power_of_2\n\nassert next_power_of_2(0) == 1\n\n```"}
{"task_id": "Mbpp/168", "solution": "```python\n# src/domain.py\nfrom typing import List\n\nclass NumberList:\n    \"\"\"\n    Encapsulates an ordered collection of numeric elements.\n    \"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements: List[float] = [float(e) for e in elements]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int) -> float:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\nclass NumericValue:\n    \"\"\"\n    Wraps a single numeric target value.\n    \"\"\"\n    def __init__(self, value) -> None:\n        self._value: float = float(value)\n\n    def get(self) -> float:\n        \"\"\"Returns the wrapped numeric value.\"\"\"\n        return self._value\n\nclass CountResult:\n    \"\"\"\n    Encapsulates an integer count result.\n    \"\"\"\n    def __init__(self, count: int) -> None:\n        self._count: int = count\n\n    def getCount(self) -> int:\n        \"\"\"Returns the encapsulated integer count.\"\"\"\n        return self._count\n\n```\n```python\n# src/frequency.py\nfrom src.domain import NumberList, NumericValue, CountResult\n\ndef frequency(list, target) -> int:\n    \"\"\"\n    Counts the occurrences of target in list using domain objects.\n    \"\"\"\n    nl = NumberList(list)\n    tv = NumericValue(target)\n\n    count = 0\n    for i in range(nl.size()):\n        element = nl.get(i)\n        if element == tv.get():\n            count += 1\n            \n    cr = CountResult(count)\n    return cr.getCount()\n\n```"}
{"task_id": "Mbpp/170", "solution": "```python\nfrom typing import List, Union\n\n# Define Number type for clarity in type hints.\nNumber = Union[int, float]\n\ndef sum_range_list(values: List[Number], start_index: int, end_index: int) -> Number:\n    \"\"\"\n    Calculates the sum of numbers within an inclusive range of indices in a list.\n    Indices are 0-based and both start_index and end_index are included.\n    \"\"\"\n    # Slice the list to include elements from start_index up to and including end_index.\n    sublist = values[start_index : end_index + 1]\n    return sum(sublist)\n```"}
{"task_id": "Mbpp/170", "solution": "```python\nclass NumberElement:\n    \"\"\"Represents a number at a specific index within a list.\"\"\"\n    def __init__(self, index: int, value):\n        self.index = index\n        self.value = value\n\n\nclass NumberList:\n    \"\"\"Wraps a list of numbers, providing length and element access.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def get(self, index: int):\n        \"\"\"Retrieves the element at the given index.\"\"\"\n        return self.elements[index]\n\n\nclass Validation:\n    \"\"\"Utility for validating indices (type and bounds).\"\"\"\n    @staticmethod\n    def is_integer(x) -> bool:\n        \"\"\"Checks if a given value is an integer.\"\"\"\n        return isinstance(x, int)\n\n    @staticmethod\n    def in_bounds(numbers_list: NumberList, idx: int) -> bool:\n        \"\"\"Checks if an index is within the 0 to length-1 range.\"\"\"\n        return 0 <= idx < numbers_list.length()\n\n\nclass SumRangeFunction:\n    \"\"\"Computes the inclusive sum of a number list segment.\"\"\"\n    def __init__(self, numbers_list: NumberList, start_index: int, end_index: int):\n        self.numbers_list = numbers_list\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def execute(self):\n        \"\"\"Calculates the sum of elements from start_index to end_index (inclusive).\"\"\"\n        current_sum = 0\n        all_integers = True\n        for i in range(self.start_index, self.end_index + 1):\n            element = self.numbers_list.get(i)\n            if not isinstance(element, int):\n                all_integers = False\n            current_sum += element\n\n        if all_integers:\n            return int(current_sum)\n        else:\n            return float(current_sum)\n\n\ndef sum_range_list(numbers_list: list, start_index: int, end_index: int):\n    \"\"\"\n    Computes the inclusive sum of a list segment with validation.\n    Delegates validation and computation to internal classes.\n    \"\"\"\n    # Design-mandated validation order: type checks before bounds checks.\n    if not Validation.is_integer(start_index) or not Validation.is_integer(end_index):\n        raise TypeError(\"start_index and end_index must be integers.\")\n\n    # Convert input list to domain object for length/get access.\n    number_list_obj = NumberList(numbers_list)\n\n    if not Validation.in_bounds(number_list_obj, start_index) or \\\n       not Validation.in_bounds(number_list_obj, end_index):\n        raise IndexError(\"start_index and end_index must be within list bounds (0 <= idx < len(list)). Negative indices are out of bounds.\")\n\n    # Orchestrate computation using SumRangeFunction\n    sum_calculator = SumRangeFunction(number_list_obj, start_index, end_index)\n    return sum_calculator.execute()\n```"}
{"task_id": "Mbpp/171", "solution": "```python\nclass PerimeterPentagonFunction:\n    \"\"\"Encapsulates the multiplier and the perimeter computation logic.\n    It holds the constant multiplier for a pentagon's perimeter.\"\"\"\n    def __init__(self, name: str):\n        self.name: str = name\n        self._multiplier: int = 5\n\n    def compute(self, side_length: float) -> float:\n        \"\"\"Computes the perimeter using the stored multiplier and given side length.\"\"\"\n        return self._multiplier * side_length\n\nclass SideLength:\n    \"\"\"Represents the side length parameter for perimeter calculation.\n    It stores the raw input value provided to the function.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass PerimeterResult:\n    \"\"\"Holds the computed perimeter value as a simple data container.\n    This class wraps the final numeric result of the calculation.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\ndef perimeter_pentagon(side_length: int | float) -> float:\n    \"\"\"Public API for computing the perimeter of a regular pentagon.\n    It processes the side_length and delegates computation to domain objects.\"\"\"\n    param = SideLength(side_length)\n    compute_handler = PerimeterPentagonFunction(name=\"perimeter_pentagon_calculator\")\n    result_value = compute_handler.compute(float(param.value))\n    return result_value\n```"}
