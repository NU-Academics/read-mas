{"task_id": "Mbpp/644", "solution": "```python\n# src/reverse_array.py\ndef reverse_Array_Upto_K(arr, k):\n    \"\"\"Reverses the first k elements of a list, returning a new list.\n    Handles various k values as specified by the design.\n    \"\"\"\n    n = len(arr)\n\n    if k <= 0:\n        # If k is non-positive, return a shallow copy of the original array.\n        return arr.copy()\n    elif k >= n:\n        # If k is greater than or equal to the array length, reverse the entire array.\n        return arr[::-1]\n    else:\n        # Reverse the first k elements and append the rest of the array unchanged.\n        reversed_head = arr[0:k][::-1]\n        tail = arr[k:]\n        return reversed_head + tail\n\n\n# tests/test_reverse_array.py\nfrom src.reverse_array import reverse_Array_Upto_K\n\n# This assertion verifies the core functionality as required by the design.\nassert reverse_Array_Upto_K([1, 2, 3, 4, 5, 6], 4) == [4, 3, 2, 1, 5, 6]\n\n# Optional: Add more tests for full coverage based on design rules.\n# This test ensures k <= 0 case returns a shallow copy.\nassert reverse_Array_Upto_K([1, 2, 3], 0) == [1, 2, 3]\noriginal_arr_k0 = [1, 2, 3]\nresult_k0 = reverse_Array_Upto_K(original_arr_k0, 0)\nassert result_k0 is not original_arr_k0  # Must be a shallow copy, not the same object\n\n# This test ensures k <= 0 case with negative k.\nassert reverse_Array_Upto_K([1, 2, 3], -1) == [1, 2, 3]\n\n# This test ensures k >= len(arr) case for k == len(arr).\nassert reverse_Array_Upto_K([1, 2, 3], 3) == [3, 2, 1]\n\n# This test ensures k >= len(arr) case for k > len(arr).\nassert reverse_Array_Upto_K([1, 2, 3], 5) == [3, 2, 1]\n\n# Test with an empty array.\nassert reverse_Array_Upto_K([], 5) == []\nassert reverse_Array_Upto_K([], 0) == []\n\n# Test with k=1 (reverses only the first element, effectively no change for single element).\nassert reverse_Array_Upto_K([1, 2, 3], 1) == [1, 2, 3]\n\nprint(\"All assertions passed!\") # Indication that the test script ran successfully\n```"}
{"task_id": "Mbpp/722", "solution": "```python\n# src/filter_service.py\nfrom typing import Dict, Tuple\n\ndef filter_data(students: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"Return a new dict containing only students with height >= min_height and weight >= min_weight.\n    Preserves original tuples and keys, and does not mutate the input dictionary.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students\n\n# src/__init__.py\nfrom .filter_service import filter_data\n\n__all__ = [\"filter_data\"]\n\n# tests/test_filter_data.py\nimport pytest\nfrom src.filter_service import filter_data\n\ndef test_example_assertion():\n    \"\"\"Verify the provided example assertion works correctly.\"\"\"\n    students = {\n        'Cierra Vega': (6.2, 70),\n        'Alden Cantrell': (5.9, 65),\n        'Kierra Gentry': (6.0, 68),\n        'Pierre Cox': (5.8, 66)\n    }\n    assert filter_data(students, 6.0, 70) == {'Cierra Vega': (6.2, 70)}\n\ndef test_no_matches_returns_empty_dict():\n    \"\"\"Ensure an empty dictionary is returned when no students meet the criteria.\"\"\"\n    students = {\n        'Cierra Vega': (6.2, 70),\n        'Alden Cantrell': (5.9, 65)\n    }\n    assert filter_data(students, 7.0, 80) == {}\n\ndef test_input_immutable():\n    \"\"\"Verify the input dictionary remains unchanged after the function call.\"\"\"\n    original_students = {\n        'Cierra Vega': (6.2, 70),\n        'Alden Cantrell': (5.9, 65)\n    }\n    students_copy = original_students.copy()\n    \n    filter_data(original_students, 6.0, 70)\n    assert original_students == students_copy\n\ndef test_multiple_students_filtering():\n    \"\"\"Test filtering with multiple students, some matching, some not.\"\"\"\n    students = {\n        'StudentA': (6.5, 75.0),  # Matches\n        'StudentB': (5.8, 60.0),  # Fails height\n        'StudentC': (6.1, 72.5),  # Matches\n        'StudentD': (6.0, 68.0),  # Fails weight\n        'StudentE': (6.0, 70.0)   # Matches (boundary)\n    }\n    expected_result = {\n        'StudentA': (6.5, 75.0),\n        'StudentC': (6.1, 72.5),\n        'StudentE': (6.0, 70.0)\n    }\n    assert filter_data(students, 6.0, 70.0) == expected_result\n\ndef test_empty_input_dict():\n    \"\"\"Test behavior with an empty input dictionary.\"\"\"\n    assert filter_data({}, 6.0, 70.0) == {}\n\ndef test_exact_boundary_values():\n    \"\"\"Test students at the exact boundary of min_height and min_weight.\"\"\"\n    students = {\n        'BoundaryH': (6.0, 75.0), # Matches\n        'BoundaryW': (6.5, 70.0), # Matches\n        'BoundaryHW': (6.0, 70.0), # Matches\n        'SlightlyBelowH': (5.99, 70.0), # Fails\n        'SlightlyBelowW': (6.0, 69.99)  # Fails\n    }\n    expected_result = {\n        'BoundaryH': (6.0, 75.0),\n        'BoundaryW': (6.5, 70.0),\n        'BoundaryHW': (6.0, 70.0)\n    }\n    assert filter_data(students, 6.0, 70.0) == expected_result\n```"}
{"task_id": "Mbpp/721", "solution": "```python\n# src/max_average_of_path/domain.py\n\nclass Cell:\n    \"\"\"Represents a cell's coordinates and numeric cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = float(cost)\n\nclass Path:\n    \"\"\"Represents a candidate path and provides path metrics.\"\"\"\n    def __init__(self, cells: list[Cell]):\n        self.cells = cells\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the sum of costs for all cells in the path.\"\"\"\n        return sum(cell.cost for cell in self.cells)\n\n    def average(self) -> float:\n        \"\"\"Computes the average cost of the path.\"\"\"\n        path_length = self.length()\n        # Per design, valid paths are guaranteed for valid inputs, ensuring length > 0.\n        return self.totalCost() / path_length\n\nclass Matrix:\n    \"\"\"Represents an N x N matrix of cells and provides accessors.\"\"\"\n    def __init__(self, N: int, cells: list[Cell]):\n        self.N = N\n        self._cells_map = {(cell.row, cell.col): cell for cell in cells}\n\n    @classmethod\n    def from_raw_matrix(cls, raw_matrix: list[list[float]]):\n        \"\"\"Creates a Matrix instance from a raw list of lists.\"\"\"\n        N = len(raw_matrix)\n        cells = [Cell(r, c, raw_matrix[r][c]) for r in range(N) for c in range(N)]\n        return cls(N, cells)\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a cell at the given row and column.\"\"\"\n        return self._cells_map[(row, col)]\n\n```\n```python\n# src/max_average_of_path/validator.py\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised by Validator for invalid input.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Validates raw matrix input for shape and numeric entries.\"\"\"\n    def validate(self, matrix: list[list[float]]) -> bool:\n        \"\"\"\n        Validates the input matrix for square shape, non-empty, and numeric entries.\n        Raises ValidationError on invalid input.\n        \"\"\"\n        if not matrix:\n            raise ValidationError(\"Matrix cannot be empty.\")\n\n        N = len(matrix)\n        for row_idx, row in enumerate(matrix):\n            if len(row) != N:\n                raise ValidationError(f\"Matrix must be square. Row {row_idx} has length {len(row)}, expected {N}.\")\n            for col_idx, value in enumerate(row):\n                if not isinstance(value, (int, float)):\n                    raise ValidationError(f\"Matrix entry at ({row_idx}, {col_idx}) is not numeric: {value}.\")\n        return True\n\n```\n```python\n# src/max_average_of_path/enumerator.py\nfrom .domain import Matrix, Cell, Path\n\nclass PathEnumerator:\n    \"\"\"Enumerates all valid right/down paths from top-left to bottom-right.\"\"\"\n    def enumerate(self, matrix: Matrix) -> list[Path]:\n        \"\"\"\n        Generates all valid paths that move only right or down.\n        Starts at (0,0) and ends at (N-1, N-1).\n        \"\"\"\n        all_paths: list[Path] = []\n        N = matrix.N\n\n        def find_paths_recursive(current_row: int, current_col: int, current_path_cells: list[Cell]):\n            \"\"\"Recursive helper to find paths by moving right or down.\"\"\"\n            if current_row >= N or current_col >= N:\n                return\n\n            cell = matrix.getCell(current_row, current_col)\n            current_path_cells.append(cell)\n\n            if current_row == N - 1 and current_col == N - 1:\n                all_paths.append(Path(list(current_path_cells)))\n            else:\n                find_paths_recursive(current_row, current_col + 1, current_path_cells)\n                find_paths_recursive(current_row + 1, current_col, current_path_cells)\n\n            current_path_cells.pop() # Backtrack\n\n        find_paths_recursive(0, 0, [])\n        return all_paths\n\n```\n```python\n# src/max_average_of_path/evaluator.py\nfrom .domain import Path\n\nclass PathEvaluator:\n    \"\"\"Computes total cost and average for a provided Path.\"\"\"\n    def evaluate(self, path: Path) -> dict[str, float]:\n        \"\"\"Calculates the total cost and average cost for the given path.\"\"\"\n        total_cost = path.totalCost()\n        average_cost = path.average()\n        return {'totalCost': total_cost, 'average': average_cost}\n\n```\n```python\n# src/max_average_of_path/aggregator.py\nfrom .domain import Path\n\nclass Aggregator:\n    \"\"\"Finds the maximum average among provided Path instances.\"\"\"\n    def findMaxAverage(self, paths: list[Path]) -> float:\n        \"\"\"\n        Iterates through paths, calculates their averages, and returns the maximum.\n        Returns 0.0 if no paths are provided, although for valid input paths are expected.\n        \"\"\"\n        if not paths:\n            return 0.0\n\n        max_average = -float('inf')\n        for path in paths:\n            current_average = path.average()\n            if current_average > max_average:\n                max_average = current_average\n        return max_average\n\n```\n```python\n# src/max_average_of_path/result.py\n\nclass Result:\n    \"\"\"Container for the computed maximum average and formatting utilities.\"\"\"\n    def __init__(self, maxAverage: float):\n        self.maxAverage = maxAverage\n\n    def format(self) -> str:\n        \"\"\"Formats the maximum average as a string, typically to one decimal place.\"\"\"\n        return f\"Maximum average path cost: {self.maxAverage:.1f}\"\n\n```\n```python\n# src/max_average_of_path/api.py\nfrom .validator import Validator, ValidationError\nfrom .domain import Matrix, Path\nfrom .enumerator import PathEnumerator\nfrom .evaluator import PathEvaluator\nfrom .aggregator import Aggregator\nfrom .result import Result\n\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Computes the maximum average cost among all valid paths in a square matrix.\n    Paths start at (0,0), move only right or down, and end at (N-1, N-1).\n    \"\"\"\n    # 1. Validate raw matrix input\n    validator = Validator()\n    validator.validate(matrix)\n\n    # 2. Represent matrix and cells as domain objects\n    domain_matrix = Matrix.from_raw_matrix(matrix)\n\n    # 3. Enumerate all valid right/down paths\n    path_enumerator = PathEnumerator()\n    paths: list[Path] = path_enumerator.enumerate(domain_matrix)\n\n    # 4. Evaluate each path's totalCost and average (as per sequence diagram UC7)\n    # The return value from PathEvaluator is not explicitly consumed by Aggregator's input.\n    # Aggregator will directly use Path.average().\n    path_evaluator = PathEvaluator()\n    for path in paths:\n        _ = path_evaluator.evaluate(path)\n\n    # 5. Aggregate per-path averages to select the maximum\n    aggregator = Aggregator()\n    max_average = aggregator.findMaxAverage(paths)\n\n    # 6. Produce a Result container (as per sequence diagram UC8)\n    _ = Result(max_average) # The Result object is created but the API returns the float directly.\n\n    # 7. Return the computed maximum average as a float\n    return max_average\n\n```\n```python\n# src/max_average_of_path/__init__.py\nfrom .api import maxAverageOfPath\n\n__all__ = [\"maxAverageOfPath\"]\n\n```\n```python\n# src/main.py\nimport sys\nimport json\nfrom src.max_average_of_path.api import maxAverageOfPath\nfrom src.max_average_of_path.validator import ValidationError\n\ndef main(argv: list[str]) -> int:\n    \"\"\"\n    Minimal CLI wrapper to read a matrix literal from input or file and call maxAverageOfPath.\n    Usage: python -m src.main \"[[1,2],[3,4]]\"\n    \"\"\"\n    if len(argv) < 2:\n        print(\"Usage: python -m src.main '[[1,2],[3,4]]'\")\n        return 1\n\n    try:\n        matrix_str = argv[1]\n        matrix = json.loads(matrix_str)\n        \n        result = maxAverageOfPath(matrix)\n        print(f\"Maximum average path cost: {result}\")\n        return 0\n    except (json.JSONDecodeError, ValidationError) as e:\n        print(f\"Error: {e}\")\n        return 1\n    except Exception as e:\n        print(f\"An unexpected error occurred: {e}\")\n        return 1\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))\n\n```"}
{"task_id": "Mbpp/721", "solution": "```python\n# src/domain.py\nclass Cell:\n    \"\"\"Represents a single matrix cell with coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"Represents a square matrix of numeric costs.\"\"\"\n    def __init__(self, size: int, cells_data: list[list[float]]):\n        self.size = size\n        self.cells = cells_data\n\n    def getCell(self, r: int, c: int) -> Cell:\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        return Cell(r, c, self.cells[r][c])\n\nclass Path:\n    \"\"\"Represents a path (sequence of cells) and computes its cost, length, and average.\"\"\"\n    def __init__(self, cells: list[Cell]):\n        self.cells = cells\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the sum of costs of all cells in the path.\"\"\"\n        return sum(cell.cost for cell in self.cells)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def average(self) -> float:\n        \"\"\"Computes the average cost per cell for the path.\"\"\"\n        if not self.cells:\n            return 0.0\n        return self.totalCost() / self.length()\n\nclass Result:\n    \"\"\"Container for computed output, holding the maximum average and best path.\"\"\"\n    def __init__(self, maxAverage: float, bestPath: Path | None):\n        self.maxAverage = maxAverage\n        self.bestPath = bestPath\n\n# src/validator.py\nclass Validator:\n    \"\"\"Validates input matrix structure and numeric content.\"\"\"\n    def isNonEmpty(self, matrix: list[list]) -> bool:\n        \"\"\"Checks if the matrix is non-empty.\"\"\"\n        return bool(matrix) and bool(matrix[0])\n\n    def isSquare(self, matrix: list[list]) -> bool:\n        \"\"\"Checks if the matrix is square (N x N).\"\"\"\n        if not matrix:\n            return False\n        n = len(matrix)\n        return all(len(row) == n for row in matrix)\n\n    def allCellsNumeric(self, matrix: list[list]) -> bool:\n        \"\"\"Checks if all cells in the matrix contain numeric values.\"\"\"\n        for row in matrix:\n            for cell in row:\n                if not isinstance(cell, (int, float)):\n                    return False\n        return True\n\n# src/path_generator.py\n# Assuming this code is run in an environment where src/domain.py is accessible\n# For a single-file output, these imports would need to be re-evaluated or classes inlined.\n# For the purpose of implementing the design as described (multiple files), we use imports.\nfrom __main__ import Matrix, Cell, Path\n\nclass PathGenerator:\n    \"\"\"Generates or computes candidate path(s) obeying movement rules.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self.matrix = matrix\n\n    def _compute_max_sum_dp(self) -> Path:\n        \"\"\"Computes the maximum-sum path using dynamic programming.\"\"\"\n        n = self.matrix.size\n        if n == 0:\n            return Path([])\n        if n == 1:\n            return Path([self.matrix.getCell(0, 0)])\n\n        dp_sum = [[0.0] * n for _ in range(n)]\n        dp_path = [[[] for _ in range(n)] for _ in range(n)]\n\n        # Initialize top-left cell\n        dp_sum[0][0] = self.matrix.getCell(0, 0).cost\n        dp_path[0][0] = [self.matrix.getCell(0, 0)]\n\n        # Initialize first row (only move right)\n        for c in range(1, n):\n            current_cell = self.matrix.getCell(0, c)\n            dp_sum[0][c] = dp_sum[0][c-1] + current_cell.cost\n            dp_path[0][c] = dp_path[0][c-1] + [current_cell]\n\n        # Initialize first column (only move down)\n        for r in range(1, n):\n            current_cell = self.matrix.getCell(r, 0)\n            dp_sum[r][0] = dp_sum[r-1][0] + current_cell.cost\n            dp_path[r][0] = dp_path[r-1][0] + [current_cell]\n\n        # Fill the rest of the DP table\n        for r in range(1, n):\n            for c in range(1, n):\n                current_cell = self.matrix.getCell(r, c)\n                if dp_sum[r-1][c] > dp_sum[r][c-1]:\n                    dp_sum[r][c] = dp_sum[r-1][c] + current_cell.cost\n                    dp_path[r][c] = dp_path[r-1][c] + [current_cell]\n                else:\n                    dp_sum[r][c] = dp_sum[r][c-1] + current_cell.cost\n                    dp_path[r][c] = dp_path[r][c-1] + [current_cell]\n        \n        return Path(dp_path[n-1][n-1])\n\n    def generateAllPaths(self) -> list[Path]:\n        \"\"\"Produces a list containing only the best (max-sum) Path object.\"\"\"\n        return [self._compute_max_sum_dp()]\n\n    def generateGreedyPath(self) -> Path:\n        \"\"\"Generates a path by always choosing the locally optimal (larger) cell cost.\"\"\"\n        path_cells = []\n        r, c = 0, 0\n        n = self.matrix.size\n        if n == 0: return Path([])\n\n        while r < n and c < n:\n            current_cell = self.matrix.getCell(r, c)\n            path_cells.append(current_cell)\n\n            if r == n - 1 and c == n - 1:\n                break\n            elif r == n - 1: # Only can move right\n                c += 1\n            elif c == n - 1: # Only can move down\n                r += 1\n            else: # Can move down or right\n                down_cost = self.matrix.getCell(r + 1, c).cost\n                right_cost = self.matrix.getCell(r, c + 1).cost\n                if down_cost >= right_cost:\n                    r += 1\n                else:\n                    c += 1\n        return Path(path_cells)\n\n\n# src/average_calculator.py\nfrom __main__ import Path\n\nclass AverageCalculator:\n    \"\"\"Computes the average for a given Path.\"\"\"\n    def computeAverage(self, path: Path) -> float:\n        \"\"\"Calculates the average cost of cells in the given path.\"\"\"\n        return path.average()\n\n# src/max_average_of_path.py\nfrom __main__ import Matrix, Path, Result, Validator, PathGenerator, AverageCalculator\n\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Computes the maximum average path cost in a square matrix.\n    Paths start top-left, move right or down, end bottom-right.\n    \"\"\"\n    validator = Validator()\n    if not validator.isNonEmpty(matrix):\n        raise ValueError(\"Invalid input: Matrix cannot be empty.\")\n    if not validator.isSquare(matrix):\n        raise ValueError(\"Invalid input: Matrix must be square (N x N).\")\n    if not validator.allCellsNumeric(matrix):\n        raise ValueError(\"Invalid input: All matrix cells must contain numeric values.\")\n\n    n = len(matrix)\n    domain_matrix = Matrix(size=n, cells_data=matrix)\n\n    generator = PathGenerator(domain_matrix)\n    # generateAllPaths is optimized to return a list containing only the max-sum path.\n    candidate_paths = generator.generateAllPaths() \n\n    # For a valid N x N matrix (N>=1), candidate_paths will contain exactly one Path.\n    if not candidate_paths:\n        return 0.0 # Should not be reached for N>=1 due to validation\n\n    best_path = candidate_paths[0] # This path already has the max total sum.\n    \n    # AverageCalculator instance is not strictly needed here as Path itself can compute average,\n    # but the design specifies its usage in the wiring.\n    avg_calc = AverageCalculator()\n    max_avg_result = avg_calc.computeAverage(best_path)\n    \n    # The design mentioned constructing a Result object, but the public API returns a float.\n    # result = Result(maxAverage=max_avg_result, bestPath=best_path)\n    return float(max_avg_result)\n```"}
