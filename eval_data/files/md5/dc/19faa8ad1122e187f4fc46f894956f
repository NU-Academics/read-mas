{"task_id": "Mbpp/113", "solution": "```python\ndef check_integer(input: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, handling optional signs and whitespace.\n    Returns True for integer representations, False otherwise.\n    \"\"\"\n    s = input.strip()\n\n    if not s:\n        return False\n\n    # Handle optional leading sign\n    if s[0] in ('+', '-'):\n        s = s[1:]\n\n    # After sign removal, if empty or not all digits, it's not an integer\n    if not s:\n        return False\n    \n    return s.isdigit()\n```"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"Compute and return a set of elements common to every inner list in nested_lists.\n    If nested_lists is empty, an empty set is returned.\n    \"\"\"\n    if not nested_lists:\n        return set()\n    iterator = iter(nested_lists)\n    common = set(next(iterator))\n    for inner in iterator:\n        common &= set(inner)\n        if not common:\n            break\n    return common"}
{"task_id": "Mbpp/111", "solution": "```python\n# src/common_in_nested_lists.py\n\nclass CommonInNestedLists:\n    \"\"\"Encapsulates validation and computation of common elements across nested lists.\"\"\"\n    def __init__(self, list_of_lists):\n        \"\"\"Stores the provided list_of_lists without explicit validation.\"\"\"\n        self.list_of_lists = list_of_lists\n\n    def common_elements(self) -> set:\n        \"\"\"Returns a set of elements present in every inner list, preserving types.\"\"\"\n        if not self.list_of_lists:\n            return set()\n\n        # Initialize the result with elements from the first inner list.\n        result_set = set(self.list_of_lists[0])\n\n        # Intersect with subsequent inner lists to find common elements.\n        for inner_list in self.list_of_lists[1:]:\n            result_set = result_set.intersection(set(inner_list))\n            if not result_set: # Short-circuit if the intersection becomes empty.\n                break\n        return result_set\n\n\ndef common_in_nested_lists(list_of_lists):\n    \"\"\"\n    Finds common elements across a list of lists.\n    Delegates to CommonInNestedLists to return a set of unique common elements.\n    \"\"\"\n    processor = CommonInNestedLists(list_of_lists)\n    return processor.common_elements()\n```"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Encapsulates a binary string, providing validation and bit access.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the binary string contains only '0's and '1's and is not empty.\"\"\"\n        if self.length == 0:\n            return False\n        return all(bit in ('0', '1') for bit in self.value)\n\n    def bitAt(self, index: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.value[index]\n\nclass RotationOperation:\n    \"\"\"Generates a sequence of rotated strings based on left cyclic shifts.\"\"\"\n    def __init__(self, rotations: int):\n        self.rotations = rotations\n\n    def generateRotations(self, bs: BinaryString) -> list:\n        \"\"\"Produces a list of RotatedString objects for each cyclic shift.\"\"\"\n        rotated_strings = []\n        original_value = bs.value\n        n = bs.length\n        \n        if n == 0: # Handle empty string case gracefully.\n            return []\n\n        for i in range(self.rotations):\n            # Computes the left cyclic shift for rotation 'i'.\n            rotated_value = original_value[i % n:] + original_value[:i % n]\n            rotated_strings.append(RotatedString(rotated_value, i))\n        return rotated_strings\n\nclass RotatedString:\n    \"\"\"Represents a single rotated binary string and can determine its oddness.\"\"\"\n    def __init__(self, value: str, index: int):\n        self.value = value\n        self.index = index\n\n    def isOdd(self) -> bool:\n        \"\"\"Determines if the rotated string represents an odd number by its rightmost bit.\"\"\"\n        if not self.value: # An empty string cannot be odd.\n            return False\n        return self.value[-1] == '1'\n\nclass Result:\n    \"\"\"A data holder for the count of odd rotations and total rotations evaluated.\"\"\"\n    def __init__(self, oddCount: int, totalRotations: int):\n        self.oddCount = oddCount\n        self.totalRotations = totalRotations\n\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Counts how many rotated versions of a binary string have an odd value.\n    Rotations are left cyclic shifts; oddness is determined by the rightmost bit.\n    \"\"\"\n    # CRITICAL REQUIREMENT: Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\n    # The caller's inputs are trusted as per the critical requirements.\n\n    binary_str_obj = BinaryString(binary_string)\n    rotation_op = RotationOperation(rotations)\n    \n    rotated_states = rotation_op.generateRotations(binary_str_obj)\n    \n    odd_count = 0\n    for rs in rotated_states:\n        if rs.isOdd():\n            odd_count += 1\n            \n    return odd_count"}
{"task_id": "Mbpp/109", "solution": "from typing import Iterable, Iterator, Optional\n\n# src/binary_string.py\nclass BinaryString:\n    \"\"\"Encapsulates an immutable binary string and its rotation logic.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def at(self, index: int) -> str:\n        \"\"\"Returns the character at the given index.\"\"\"\n        return self.value[index]\n\n    def rotate(self, k: int) -> 'BinaryString':\n        \"\"\"\n        Performs a cyclic left rotation of the binary string by k positions.\n        Returns a new BinaryString instance with the rotated value.\n        \"\"\"\n        if not self.value:\n            return BinaryString(\"\")\n        effective_k = k % self.length()\n        rotated_value = self.value[effective_k:] + self.value[:effective_k]\n        return BinaryString(rotated_value)\n\n# src/validator.py\nclass Validator:\n    \"\"\"Validates binary strings and non-negative integers.\"\"\"\n    def is_binary(self, s: str) -> bool:\n        \"\"\"Checks if a string contains only '0' or '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in s)\n\n    def is_non_negative_int(self, n) -> bool:\n        \"\"\"Checks if a value is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n    def validate(self, s: str, n) -> None:\n        \"\"\"\n        Validates the binary string and rotations count; raises ValueError on failure.\n        The binary string must contain only '0' or '1', and rotations must be a non-negative integer.\n        \"\"\"\n        if not self.is_binary(s):\n            raise ValueError(\"binary_string must contain only '0' or '1' characters.\")\n        if not self.is_non_negative_int(n):\n            raise ValueError(\"rotations must be a non-negative integer.\")\n\n# src/rotation_engine.py\nclass RotationEngine:\n    \"\"\"Generates rotated strings from an original BinaryString.\"\"\"\n    def __init__(self, original: BinaryString):\n        self.original = original\n\n    def rotate(self, k: int) -> str:\n        \"\"\"\n        Generates the k-th rotated string (0-indexed).\n        This wraps k modulo the original string's length.\n        \"\"\"\n        return self.original.rotate(k).value\n\n    def rotations(self, count: int) -> Iterator[str]:\n        \"\"\"\n        Yields 'count' rotated strings, from 0 to count-1 rotations.\n        Each yielded string is the result of applying the corresponding rotation.\n        \"\"\"\n        for i in range(count):\n            yield self.rotate(i)\n\n# src/odd_checker.py\nclass OddChecker:\n    \"\"\"Determines if a binary string represents an odd number.\"\"\"\n    def is_odd(self, bstr: str) -> bool:\n        \"\"\"\n        Returns True if the binary string is non-empty and its least significant bit is '1'.\n        An empty string is considered not odd.\n        \"\"\"\n        return bool(bstr) and bstr[-1] == '1'\n\n# src/counter.py\nclass Counter:\n    \"\"\"Counts the number of odd binary strings within an iterable.\"\"\"\n    def __init__(self, odd_checker: Optional[OddChecker] = None):\n        self.odd_checker = odd_checker if odd_checker is not None else OddChecker()\n\n    def count_odd(self, rotations: Iterable[str]) -> int:\n        \"\"\"\n        Counts how many strings in the iterable are considered odd by the OddChecker.\n        \"\"\"\n        odd_count = 0\n        for bstr in rotations:\n            if self.odd_checker.is_odd(bstr):\n                odd_count += 1\n        return odd_count\n\n# src/odd_equivalent.py\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Counts how many of the 'rotations' distinct cyclic rotations of 'binary_string'\n    result in an odd-valued binary string (LSB == '1').\n    \"\"\"\n    Validator().validate(binary_string, rotations)\n    original_binary_string = BinaryString(binary_string)\n    rotation_engine = RotationEngine(original_binary_string)\n    rotations_iterator = rotation_engine.rotations(rotations)\n    counter = Counter(OddChecker())\n    return counter.count_odd(rotations_iterator)"}
