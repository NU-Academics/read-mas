{"task_id": "Mbpp/441", "solution": "```python\n# src/surfacearea.py\n\nclass Cube:\n    \"\"\"Represents a cube with a given side size.\"\"\"\n    def __init__(self, size: float) -> None:\n        self.size = size\n\n    def get_surface_area(self) -> float:\n        \"\"\"Calculates the surface area of the cube.\"\"\"\n        return 6 * self.size * self.size\n\nclass SurfaceAreaResult:\n    \"\"\"A value object to hold the computed surface area.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\ndef surfacearea_cube(size: float) -> float:\n    \"\"\"\n    Computes the surface area of a cube given its side size.\n    It uses internal Cube and SurfaceAreaResult domain objects.\n    \"\"\"\n    cube = Cube(size)\n    area_value = cube.get_surface_area()\n    # The SurfaceAreaResult is used internally as a domain type.\n    # The public API returns the raw float value as per design.\n    return area_value\n```\n```python\n# tests/test_surfacearea.py\n\nfrom src.surfacearea import surfacearea_cube\n\ndef run_tests() -> None:\n    \"\"\"\n    Executes the acceptance test for surfacearea_cube.\n    Asserts that surfacearea_cube(5) equals 150.\n    \"\"\"\n    expected_result = 150.0\n    actual_result = surfacearea_cube(5)\n\n    assert actual_result == expected_result, \\\n        f\"Test failed: Expected {expected_result}, got {actual_result}\"\n    print(f\"Acceptance test passed: surfacearea_cube(5) == {actual_result}\")\n\nif __name__ == \"__main__\":\n    run_tests()\n```"}
{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Union\n\n# Type alias for numeric elements.\nNumber = Union[int, float]\n\ndef multiply_inner_tuples(a_inner: Tuple[Number, ...], b_inner: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"Multiplies elements of two inner tuples index-wise.\n    Assumes inner tuples are of equal length and contain numeric elements.\n    \"\"\"\n    return tuple(a_inner[j] * b_inner[j] for j in range(len(a_inner)))\n\ndef index_multiplication(outerA: Tuple[Tuple[Number, ...], ...],\n                       outerB: Tuple[Tuple[Number, ...], ...]) -> Tuple[Tuple[Number, ...], ...]:\n    \"\"\"Performs index-wise multiplication of two outer tuples.\n    Assumes inputs conform to expected structure and element types without validation.\n    \"\"\"\n    results = []\n    for i in range(len(outerA)):\n        results.append(multiply_inner_tuples(outerA[i], outerB[i]))\n    return tuple(results)"}
{"task_id": "Mbpp/446", "solution": "```python\ndef count_Occurrence(t: tuple, lst: list) -> int:\n    \"\"\"Return the number of elements in tuple t that are equal (==) to any element in list lst.\n\n    Preconditions: t is a tuple, lst is a list (SRS assumes correct types). Behavior for other types is unspecified by SRS.\n    \"\"\"\n    # Iterate t and check membership in lst using 'in' which uses equality (==) semantics\n    count = 0\n    for elem in t:\n        if elem in lst:\n            count += 1\n    return count\n```"}
{"task_id": "Mbpp/445", "solution": "```python\n\"\"\"\nThis module provides the index_multiplication function for element-wise\nmultiplication of nested tuples, along with supporting validation helpers.\n\"\"\"\n\n__all__ = [\"index_multiplication\"]\n\ndef validate_numeric(element):\n    \"\"\"\n    Validates if an element is an integer or a float.\n    Raises TypeError if the element is not numeric.\n    \"\"\"\n    if not isinstance(element, (int, float)):\n        raise TypeError(\"All inner-most elements must be numeric (int or float).\")\n\ndef validate_inner_lengths(inner_a, inner_b):\n    \"\"\"\n    Validates if two inner structures are tuples and have equal length.\n    Raises TypeError if not tuples, ValueError if lengths mismatch.\n    \"\"\"\n    if not isinstance(inner_a, tuple) or not isinstance(inner_b, tuple):\n        raise TypeError(\"Elements within the top-level tuples must themselves be tuples.\")\n    if len(inner_a) != len(inner_b):\n        raise ValueError(\"Inner tuples must have equal length at corresponding indices.\")\n\ndef validate_top_level_lengths(tuple_a, tuple_b):\n    \"\"\"\n    Validates if top-level inputs are tuples and have equal length.\n    Raises TypeError if not tuples, ValueError if lengths mismatch.\n    \"\"\"\n    if not isinstance(tuple_a, tuple) or not isinstance(tuple_b, tuple):\n        raise TypeError(\"Top-level inputs must be tuples.\")\n    if len(tuple_a) != len(tuple_b):\n        raise ValueError(\"Top-level tuples must have equal length.\")\n\ndef index_multiplication(tuple_a, tuple_b):\n    \"\"\"\n    Performs index-wise multiplication of elements in two nested tuples.\n    It validates input structures and element types, returning a new tuple of tuples.\n    \"\"\"\n    validate_top_level_lengths(tuple_a, tuple_b)\n\n    results = []\n    for i in range(len(tuple_a)):\n        inner_a = tuple_a[i]\n        inner_b = tuple_b[i]\n        validate_inner_lengths(inner_a, inner_b)\n\n        inner_results = []\n        for j in range(len(inner_a)):\n            a_ij = inner_a[j]\n            b_ij = inner_b[j]\n            validate_numeric(a_ij)\n            validate_numeric(b_ij)\n            inner_results.append(a_ij * b_ij)\n        results.append(tuple(inner_results))\n\n    return tuple(results)\n```"}
{"task_id": "Mbpp/446", "solution": "def _count_with_membership(inputTuple: tuple, elements_set: set) -> int:\n    \"\"\"Counts occurrences in a tuple that are present in a set.\n    This helper iterates the tuple to find matches.\"\"\"\n    count = 0\n    for element in inputTuple:\n        if element in elements_set:\n            count += 1\n    return count\n\ndef count_Occurrence(inputTuple: tuple, elementsList: list) -> int:\n    \"\"\"Counts occurrences of list elements in a tuple.\n    Duplicates in the tuple are counted separately.\"\"\"\n    \n    # Convert elementsList to a set for efficient membership testing.\n    elements_set = set(elementsList)\n    \n    # Delegate actual counting to an internal helper function.\n    # The requirement to return 0 for empty inputs is naturally met\n    # by the counting logic if inputTuple or elements_set is empty.\n    return _count_with_membership(inputTuple, elements_set)"}
{"task_id": "Mbpp/448", "solution": "```python\n# src/__init__.py\n\"\"\"\nPackage initializer for the src module.\n\"\"\"\n```\n```python\n# src/input_validator.py\n\"\"\"\nInput validation for cal_sum parameters.\n\"\"\"\n\nclass InputValidator:\n    \"\"\"\n    Validates input for Perrin sum calculations.\n    Ensures 'n' is a non-negative integer.\n    \"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the InputValidator.\"\"\"\n        pass\n\n    def validate_n(self, n) -> bool:\n        \"\"\"\n        Validates if n is a non-negative integer.\n        Returns True if valid, False otherwise.\n        \"\"\"\n        return isinstance(n, int) and n >= 0\n\n```\n```python\n# src/perrin_sequence.py\n\"\"\"\nGenerates Perrin sequence values and provides value lookup.\n\"\"\"\n\nclass PerrinSequence:\n    \"\"\"\n    Generates Perrin numbers P0..Pn using memoization.\n    Defined by P0=3, P1=0, P2=2, and Pn = P(n-2) + P(n-3) for n >= 3.\n    \"\"\"\n    P0 = 3\n    P1 = 0\n    P2 = 2\n\n    def __init__(self) -> None:\n        \"\"\"\n        Initializes the PerrinSequence generator with base values.\n        A cache stores computed Perrin numbers for efficiency.\n        \"\"\"\n        self._cache: dict[int, int] = {\n            0: self.P0,\n            1: self.P1,\n            2: self.P2\n        }\n\n    def value(self, index: int) -> int:\n        \"\"\"\n        Calculates the Perrin number at a given index.\n        Uses memoization to avoid redundant computations.\n        \"\"\"\n        if index < 0:\n            raise ValueError(\"Perrin index must be non-negative.\")\n        if index not in self._cache:\n            self._cache[index] = self.value(index - 2) + self.value(index - 3)\n        return self._cache[index]\n\n    def generate(self, n: int) -> list[int]:\n        \"\"\"\n        Generates a list of Perrin numbers from P0 up to Pn inclusive.\n        Calls the value() method for each number.\n        \"\"\"\n        if n < 0:\n            return []\n        return [self.value(i) for i in range(n + 1)]\n\n```\n```python\n# src/sum_calculator.py\n\"\"\"\nComputes inclusive sum of Perrin numbers and exposes cal_sum(n).\n\"\"\"\nfrom src.input_validator import InputValidator\nfrom src.perrin_sequence import PerrinSequence\n\nclass SumCalculator:\n    \"\"\"\n    Orchestrates input validation, Perrin sequence generation, and summation.\n    Composes InputValidator and PerrinSequence instances.\n    \"\"\"\n    def __init__(self, validator: InputValidator = None, generator: PerrinSequence = None) -> None:\n        \"\"\"\n        Initializes SumCalculator with a validator and a generator.\n        Default instances are used if none are provided.\n        \"\"\"\n        self._validator = validator if validator is not None else InputValidator()\n        self._generator = generator if generator is not None else PerrinSequence()\n\n    def sum(self, sequence: list[int]) -> int:\n        \"\"\"\n        Calculates the sum of a given list of integers.\n        This is a simple helper for summation.\n        \"\"\"\n        return sum(sequence)\n\n# Public API entry point\n_calculator_instance = SumCalculator()\n\ndef cal_sum(n) -> int:\n    \"\"\"\n    Calculates the inclusive sum of Perrin numbers P0 through Pn.\n    Validates input 'n' and raises ValueError for invalid inputs.\n    \"\"\"\n    if not _calculator_instance._validator.validate_n(n):\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    perrin_sequence = _calculator_instance._generator.generate(n)\n    return _calculator_instance.sum(perrin_sequence)\n\n```\n```python\n# tests/test_cal_sum.py\n\"\"\"\nUnit test harness for verifying cal_sum function behavior.\nIncludes specific test cases like cal_sum(9) == 49 and edge cases.\n\"\"\"\nimport pytest\nfrom src.sum_calculator import cal_sum\n\nclass TestCase:\n    \"\"\"\n    Container for unit tests related to cal_sum functionality.\n    Includes an expected value for cal_sum(9).\n    \"\"\"\n    expected_cal_sum_9 = 49\n\n    def run(self) -> None:\n        \"\"\"\n        Conceptual run method; actual tests are executed by pytest.\n        This method serves as a placeholder as per design spec.\n        \"\"\"\n        pass # Pytest discovers and runs test_* functions automatically.\n\ndef test_cal_sum_9():\n    \"\"\"Verifies the sum of Perrin numbers up to P9 is 49.\"\"\"\n    assert cal_sum(9) == TestCase.expected_cal_sum_9\n\ndef test_cal_sum_0():\n    \"\"\"Verifies cal_sum(0) returns P0 (3).\"\"\"\n    assert cal_sum(0) == 3\n\ndef test_cal_sum_1():\n    \"\"\"Verifies cal_sum(1) returns P0 + P1 (3 + 0 = 3).\"\"\"\n    assert cal_sum(1) == 3\n\ndef test_cal_sum_2():\n    \"\"\"Verifies cal_sum(2) returns P0 + P1 + P2 (3 + 0 + 2 = 5).\"\"\"\n    assert cal_sum(2) == 5\n\ndef test_cal_sum_negative_input():\n    \"\"\"Ensures a ValueError is raised for negative integer input.\"\"\"\n    with pytest.raises(ValueError, match=\"Input 'n' must be a non-negative integer.\"):\n        cal_sum(-1)\n\ndef test_cal_sum_non_integer_input_string():\n    \"\"\"Ensures a ValueError is raised for non-integer string input.\"\"\"\n    with pytest.raises(ValueError, match=\"Input 'n' must be a non-negative integer.\"):\n        cal_sum(\"a\")\n\ndef test_cal_sum_non_integer_input_float():\n    \"\"\"Ensures a ValueError is raised for non-integer float input.\"\"\"\n    with pytest.raises(ValueError, match=\"Input 'n' must be a non-negative integer.\"):\n        cal_sum(3.7)\n\ndef test_cal_sum_empty_sequence_logic_not_reached():\n    \"\"\"Confirm internal logic prevents generating empty sequence for n=0 or positive.\"\"\"\n    # This test implicitly verifies that cal_sum(n) for n>=0 never returns 0 due to an empty sequence.\n    assert cal_sum(0) != 0 # P0 is 3, so sum is 3.\n    assert cal_sum(1) != 0 # P0+P1 is 3, so sum is 3.\n```"}
