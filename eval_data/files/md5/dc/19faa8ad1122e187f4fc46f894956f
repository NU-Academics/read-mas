{"task_id": "Mbpp/606", "solution": "```python\n# src/__init__.py\n# Marks src as a Python package.\n\n```\n```python\n# src/models.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass Angle:\n    \"\"\"Represents an angle in degrees.\"\"\"\n    degrees: float\n\n@dataclass\nclass RadianResult:\n    \"\"\"Represents an angle in radians.\"\"\"\n    radians: float\n```\n```python\n# src/radian_converter.py\nimport math\nfrom .models import Angle, RadianResult\n\nclass RadianConverter:\n    \"\"\"Converts angles from degrees to radians.\"\"\"\n\n    def radian_degree(self, degrees: float) -> float:\n        \"\"\"Converts degrees to radians using the formula degrees * pi / 180.\n        It uses an Angle model internally and creates a RadianResult.\n        \"\"\"\n        angle_input = Angle(degrees=degrees)\n        radians_value = angle_input.degrees * math.pi / 180.0\n        radian_output = RadianResult(radians=radians_value)\n        return radian_output.radians\n```\n```python\n# src/radian.py\nfrom .radian_converter import RadianConverter\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"Converts an angle from degrees to radians.\n    This public API function delegates the conversion to RadianConverter.\n    \"\"\"\n    converter = RadianConverter()\n    return converter.radian_degree(degrees)\n```\n```python\n# tests/test_radian.py\nimport unittest\nfrom src.radian import radian_degree\n\nclass UnitTest(unittest.TestCase):\n    \"\"\"Contains the acceptance test for radian_degree conversion.\"\"\"\n\n    def test_assert_radian_degree(self):\n        \"\"\"Verifies radian_degree(90) returns the expected radian value.\n        Uses assertAlmostEqual for robust floating-point comparison.\n        \"\"\"\n        expected_radians = 1.5707963267948966\n        actual_radians = radian_degree(90)\n        self.assertAlmostEqual(actual_radians, expected_radians, places=15)\n```"}
