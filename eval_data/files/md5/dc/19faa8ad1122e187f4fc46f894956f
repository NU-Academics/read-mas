{"task_id": "Mbpp/255", "solution": "```python\nfrom typing import Any, List, Tuple\n\ndef combinations_colors(input_list: List[Any], n: int) -> List[Tuple]:\n    \"\"\"\n    Generates all length-n combinations with repetition from input_list.\n    Preserves input_list element relative order in output ordering.\n    \"\"\"\n    output: List[Tuple] = []\n\n    def _generate_recursive(current_combination: List[Any], depth: int) -> None:\n        if depth == n:\n            output.append(tuple(current_combination))\n            return\n\n        for element in input_list:\n            _generate_recursive(current_combination + [element], depth + 1)\n\n    _generate_recursive([], 0)\n    return output\n```"}
{"task_id": "Mbpp/255", "solution": "```python\nfrom typing import List, Tuple, Any, Optional\n\nclass Element:\n    \"\"\"Represents an input element with its value and original position.\"\"\"\n    def __init__(self, value: Any, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass CombinationTuple:\n    \"\"\"Represents a single combination as an ordered tuple of element values.\n    In practice, CombinationsResult stores standard Python tuples.\n    \"\"\"\n    def __init__(self, elements: Tuple[Any, ...]) -> None:\n        self.elements = elements\n\nclass CombinationsResult:\n    \"\"\"Container for produced combinations, holding a list of immutable tuples.\"\"\"\n    def __init__(self, tuples: List[Tuple[Any, ...]]) -> None:\n        self.tuples = tuples\n\nclass ValidationResult:\n    \"\"\"Represents validation outcome and any immediate result.\"\"\"\n    def __init__(self, is_valid: bool, errors: List[str], immediate_result: Optional['CombinationsResult'] = None) -> None:\n        self.is_valid = is_valid\n        self.errors = errors\n        self.immediate_result = immediate_result\n\nclass CombinationsFunction:\n    \"\"\"Encapsulates validation and generation logic for combinations with repetition.\"\"\"\n    def __init__(self, input_list: List[Any], n: int) -> None:\n        self._input_list = input_list\n        self._n = n\n\n    def validate(self) -> ValidationResult:\n        \"\"\"Validates the input parameters according to the design specification.\"\"\"\n        errors: List[str] = []\n\n        # Validate n type and value as per design specification.\n        if not isinstance(self._n, int) or self._n < 0:\n            errors.append(\"n must be a non-negative integer.\")\n\n        if errors:\n            return ValidationResult(is_valid=False, errors=errors)\n\n        # Handle immediate results for specific edge cases.\n        if self._n == 0:\n            return ValidationResult(is_valid=True, errors=[], immediate_result=CombinationsResult([()]))\n\n        if not self._input_list and self._n > 0:\n            return ValidationResult(is_valid=True, errors=[], immediate_result=CombinationsResult([]))\n\n        return ValidationResult(is_valid=True, errors=[])\n\n    def generate(self) -> CombinationsResult:\n        \"\"\"Generates all combinations with repetition using non-decreasing index order.\"\"\"\n        k = len(self._input_list)\n        # Prepare elements with positions for canonical ordering as per design.\n        elements = [Element(value, i) for i, value in enumerate(self._input_list)]\n        result_tuples: List[Tuple[Any, ...]] = []\n\n        # Initialize indices for the first combination (e.g., [0, 0, ..., 0]).\n        # This will raise an error if self._n < 0, which `validate` should prevent.\n        indices = [0] * self._n\n\n        while True:\n            # Create a tuple for the current combination and add it to the results.\n            current_combination = tuple(elements[idx].value for idx in indices)\n            result_tuples.append(current_combination)\n\n            # Find the rightmost index that can be incremented while staying within bounds.\n            j = self._n - 1\n            while j >= 0 and indices[j] == k - 1:\n                j -= 1\n\n            # If no such index is found, all combinations have been generated.\n            if j < 0:\n                break\n\n            # Increment the found index and reset subsequent indices to maintain order.\n            indices[j] += 1\n            for l in range(j + 1, self._n):\n                indices[l] = indices[j]\n\n        return CombinationsResult(result_tuples)\n\ndef combinations_colors(input_list: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"Generates all combinations with repetition of elements from input_list of length n.\n    This is the primary public API function for the system.\n    \"\"\"\n    combinations_func = CombinationsFunction(input_list, n)\n    validation_result = combinations_func.validate()\n\n    # Return immediate results if validation indicates them (e.g., n=0, empty list).\n    if validation_result.immediate_result:\n        return validation_result.immediate_result.tuples\n    \n    # If validation failed and no immediate result was provided (e.g., n < 0).\n    # Per \"Do NOT raise exceptions\", returning an empty list is a safe default for invalid inputs.\n    if not validation_result.is_valid:\n        return []\n\n    combinations_result = combinations_func.generate()\n    return combinations_result.tuples\n```"}
{"task_id": "Mbpp/256", "solution": "```python\n# src/count_primes.py\nimport math\nimport numbers\nfrom typing import Union\n\ndef _validate_input(n: Union[int, float]) -> None:\n    \"\"\"\n    Validates that n is a finite, non-negative real number.\n    Raises ValueError for invalid inputs like negative, non-numeric, NaN, or infinite values.\n    \"\"\"\n    if not isinstance(n, numbers.Real):\n        raise ValueError(\"Input must be a numeric value.\")\n    if n < 0:\n        raise ValueError(\"Input must be non-negative.\")\n    if math.isinf(n):\n        raise ValueError(\"Input cannot be infinite.\")\n    if math.isnan(n):\n        raise ValueError(\"Input cannot be NaN.\")\n\ndef _is_prime(k: int) -> bool:\n    \"\"\"\n    Checks if an integer k is a prime number.\n    Uses trial division up to sqrt(k) for efficiency.\n    \"\"\"\n    if k < 2:\n        return False\n    if k == 2:\n        return True\n    if k % 2 == 0:\n        return False\n    limit = int(math.sqrt(k)) + 1\n    for i in range(3, limit, 2):\n        if k % i == 0:\n            return False\n    return True\n\ndef count_Primes_nums(n: Union[int, float]) -> int:\n    \"\"\"\n    Counts the number of prime integers strictly less than n.\n    Validates the input and uses a helper function for primality checking.\n    \"\"\"\n    _validate_input(n)\n\n    n_floor = math.floor(n)\n    if n_floor < 2:\n        return 0\n\n    count = 0\n    for k in range(2, n_floor):\n        if _is_prime(k):\n            count += 1\n    return count\n```\n\n```python\n# tests/test_count_primes.py\nimport pytest\nimport math\nfrom src.count_primes import count_Primes_nums\n\ndef test_count_primes_acceptance() -> None:\n    \"\"\"\n    Tests the primary acceptance criterion that count_Primes_nums(5) equals 2.\n    Verifies the function's core counting ability for a common case.\n    \"\"\"\n    assert count_Primes_nums(5) == 2\n    assert count_Primes_nums(5.0) == 2\n\ndef test_count_primes_edge_cases() -> None:\n    \"\"\"\n    Tests edge cases where the input `n` is less than 2, which should return 0 primes.\n    Includes integer and float inputs close to the boundary.\n    \"\"\"\n    assert count_Primes_nums(0) == 0\n    assert count_Primes_nums(1) == 0\n    assert count_Primes_nums(0.5) == 0\n    assert count_Primes_nums(1.999) == 0\n\ndef test_count_primes_invalid_input_raises_value_error() -> None:\n    \"\"\"\n    Tests that various invalid inputs correctly raise a ValueError.\n    Covers negative numbers, non-numeric types, infinity, and NaN.\n    \"\"\"\n    with pytest.raises(ValueError, match=\"non-negative\"):\n        count_Primes_nums(-1)\n    with pytest.raises(ValueError, match=\"non-negative\"):\n        count_Primes_nums(-10.5)\n\n    with pytest.raises(ValueError, match=\"numeric value\"):\n        count_Primes_nums(\"invalid\")\n    with pytest.raises(ValueError, match=\"numeric value\"):\n        count_Primes_nums(None)\n\n    with pytest.raises(ValueError, match=\"infinite\"):\n        count_Primes_nums(math.inf)\n    with pytest.raises(ValueError, match=\"NaN\"):\n        count_Primes_nums(math.nan)\n\ndef test_count_primes_various_valid_inputs() -> None:\n    \"\"\"\n    Tests `count_Primes_nums` with a range of valid integer and float inputs.\n    Confirms correct prime counting beyond the specified acceptance criteria.\n    \"\"\"\n    assert count_Primes_nums(2) == 0\n    assert count_Primes_nums(3) == 1  # Primes: [2]\n    assert count_Primes_nums(4) == 2  # Primes: [2, 3]\n    assert count_Primes_nums(6) == 3  # Primes: [2, 3, 5]\n    assert count_Primes_nums(7) == 3  # Primes: [2, 3, 5]\n    assert count_Primes_nums(10) == 4 # Primes: [2, 3, 5, 7]\n    assert count_Primes_nums(11) == 4 # Primes: [2, 3, 5, 7]\n    assert count_Primes_nums(2.1) == 0\n    assert count_Primes_nums(3.99) == 1\n    assert count_Primes_nums(13.0) == 5 # Primes: [2, 3, 5, 7, 11]\n```"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n):\n    \"\"\"\n    Counts prime integers strictly less than n.\n    Input validation (type/value errors) is omitted per critical requirements.\n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Per design, return 0 for n <= 2.\n    if n <= 2:\n        return 0\n\n    count = 0\n    # Adhering to \"simplest, most direct logic\" and the assertion count_Primes_nums(5) == 2,\n    # we use int(n) as the exclusive upper bound for the loop.\n    upper_exclusive_bound = int(n)\n\n    for num in range(2, upper_exclusive_bound):\n        if is_prime(num):\n            count += 1\n    return count"}
