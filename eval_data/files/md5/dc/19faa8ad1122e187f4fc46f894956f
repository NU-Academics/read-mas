{"task_id": "Mbpp/57", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker for the src directory.\"\"\"\n__all__ = [\"find_max_num\", \"models\"]\n```\n\n```python\n# src/models.py\n\"\"\"Domain model classes for digit collection, max number, and test cases.\"\"\"\n\nfrom typing import List\n\nclass DigitCollection:\n    \"\"\"Represents a collection of decimal digits.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits: List[int] = digits\n\nclass MaxNumber:\n    \"\"\"Represents the largest number formed from digits.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass TestCase:\n    \"\"\"A simple test case for the find_Max_Num function.\"\"\"\n    def __init__(self, input_digits: List[int], expected_output: int):\n        self.input: List[int] = input_digits\n        self.expected: int = expected_output\n\n    def run(self, func) -> bool:\n        \"\"\"Executes the test by calling the provided function and compares result.\"\"\"\n        actual_output = func(self.input)\n        return actual_output == self.expected\n```\n\n```python\n# src/find_max_num.py\n\"\"\"Module providing the public API find_Max_Num and its core service logic.\"\"\"\n\nfrom typing import List\nfrom .models import DigitCollection, MaxNumber # Required import from design\n\nclass FindMaxNumService:\n    \"\"\"Encapsulates validation, sorting, and composition logic for max numbers.\"\"\"\n\n    def find_Max_Num(self, digits: List[int]) -> int:\n        \"\"\"\n        Main service method to find the largest number from a list of digits.\n        Delegates to private methods for validation, sorting, and composition.\n        \"\"\"\n        self._validate(digits)\n        sorted_digits = self._sort_desc(digits)\n        max_number = self._compose_number(sorted_digits)\n        return max_number\n\n    def _validate(self, digits: List[int]) -> bool:\n        \"\"\"\n        Validates the input list of digits.\n        Raises ValueError if input is invalid (not list, non-int elements, out of 0-9 range).\n        \"\"\"\n        if not isinstance(digits, list):\n            raise ValueError(\"Input must be a list of digits.\")\n        if not digits:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        for digit in digits:\n            if not isinstance(digit, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n            if not (0 <= digit <= 9):\n                raise ValueError(\"Digits must be between 0 and 9 inclusive.\")\n        return True\n\n    def _sort_desc(self, digits: List[int]) -> List[int]:\n        \"\"\"Sorts the list of digits in descending order.\"\"\"\n        return sorted(digits, reverse=True)\n\n    def _compose_number(self, digits: List[int]) -> int:\n        \"\"\"Composes an integer from a list of sorted digits.\"\"\"\n        # Convert digits to strings, join them, then convert to int.\n        return int(\"\".join(map(str, digits)))\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Public API function to compute the largest integer from provided digits.\n    It delegates the core logic to an instance of FindMaxNumService.\n    \"\"\"\n    service = FindMaxNumService()\n    return service.find_Max_Num(digits)\n```\n\n```python\n# tests/test_find_max_num.py\n\"\"\"Unit tests for the find_Max_Num function.\"\"\"\n\nfrom src.find_max_num import find_Max_Num\nfrom src.models import TestCase\n\ndef test_find_Max_Num_example():\n    \"\"\"\n    Asserts the example: find_Max_Num([1,2,3]) == 321.\n    Includes additional tests for validation and duplicate preservation.\n    \"\"\"\n    # Basic test case\n    test_case = TestCase(input_digits=[1, 2, 3], expected_output=321)\n    assert test_case.run(find_Max_Num), f\"Test failed: Input {test_case.input}, Expected {test_case.expected}\"\n\n    # Validation tests\n    try:\n        find_Max_Num([])\n        assert False, \"ValueError was not raised for empty list.\"\n    except ValueError as e:\n        assert \"empty list\" in str(e), \"Incorrect ValueError for empty list.\"\n\n    try:\n        find_Max_Num([1, 10, 3])\n        assert False, \"ValueError was not raised for out-of-range digit.\"\n    except ValueError as e:\n        assert \"between 0 and 9\" in str(e), \"Incorrect ValueError for out-of-range digit.\"\n\n    try:\n        find_Max_Num([1, 'a', 3])\n        assert False, \"ValueError was not raised for non-integer digit.\"\n    except ValueError as e:\n        assert \"integers\" in str(e), \"Incorrect ValueError for non-integer digit.\"\n\n    try:\n        find_Max_Num(None)\n        assert False, \"ValueError was not raised for non-list input.\"\n    except ValueError as e:\n        assert \"list of digits\" in str(e), \"Incorrect ValueError for non-list input.\"\n\n    # Duplicate preservation and leading zero handling tests\n    assert find_Max_Num([2, 2, 1]) == 221, \"Duplicate digits not preserved.\"\n    assert find_Max_Num([0, 0, 1]) == 100, \"Leading zeros not handled correctly (001 -> 100).\"\n    assert find_Max_Num([0, 1]) == 10, \"Leading zero not handled correctly (01 -> 10).\"\n    assert find_Max_Num([9, 8, 7, 6, 5, 4, 3, 2, 1, 0]) == 9876543210\n```\n\n```python\n# tests/run_tests.py\n\"\"\"Simple test runner for the project's unit tests.\"\"\"\n\nfrom tests.test_find_max_num import test_find_Max_Num_example\n\nif __name__ == \"__main__\":\n    \"\"\"\n    Entry point to run all tests.\n    Calls test functions and prints a summary.\n    \"\"\"\n    print(\"Running tests...\")\n    try:\n        test_find_Max_Num_example()\n        print(\"test_find_Max_Num_example: PASSED\")\n    except AssertionError as e:\n        print(f\"test_find_Max_Num_example: FAILED - {e}\")\n    except Exception as e:\n        print(f\"test_find_Max_Num_example: ERROR - {e}\")\n\n    print(\"\\nAll tests finished.\")\n```"}
{"task_id": "Mbpp/61", "solution": "```python\n# src/count_substrings.py\nfrom typing import List\n\ndef _validate_input(s: str) -> None:\n    \"\"\"\n    Validates the input string 's'.\n    Raises ValueError if 's' is None, not a string, or contains non-digit characters.\n    \"\"\"\n    if s is None:\n        raise ValueError(\"Input cannot be None.\")\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string.\")\n    if not s.isdigit() and s != '':\n        raise ValueError(\"Input string must contain only digit characters (0-9).\")\n\ndef _digits_from_string(s: str) -> List[int]:\n    \"\"\"\n    Converts a validated string of digits into a list of integers.\n    Assumes 's' has already been validated to contain only digits.\n    \"\"\"\n    return [int(char) for char in s]\n\ndef _count_matching_substrings(digits: List[int]) -> int:\n    \"\"\"\n    Counts all contiguous substrings within the 'digits' list where the sum of digits equals the substring's length.\n    This implementation uses an O(n^2) approach for enumeration.\n    \"\"\"\n    match_count = 0\n    num_digits = len(digits)\n\n    for i in range(num_digits):\n        current_sum = 0\n        for j in range(i, num_digits):\n            current_sum += digits[j]\n            substring_length = j - i + 1\n            if current_sum == substring_length:\n                match_count += 1\n    return match_count\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings in 's' where the sum of digits equals their length.\n    It validates input, handles empty strings, and delegates to internal helpers.\n    \"\"\"\n    _validate_input(s)\n\n    if not s: # Requirement: Return 0 for empty input after validation.\n        return 0\n\n    digits = _digits_from_string(s)\n    return _count_matching_substrings(digits)\n\n```\n```python\n# src/__init__.py\nfrom .count_substrings import count_Substrings\n```"}
{"task_id": "Mbpp/61", "solution": "```python\nimport collections.abc\n\nclass Validator:\n    \"\"\"Utility class for validating string content.\"\"\"\n    @staticmethod\n    def is_all_digits(s: str) -> bool:\n        \"\"\"Checks if the given string contains only decimal digits.\"\"\"\n        return s.isdigit()\n\nclass Digit:\n    \"\"\"Represents an individual decimal digit (0-9).\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Substring:\n    \"\"\"Represents a contiguous substring and computes its digit sum.\"\"\"\n    def __init__(self, value: str, start: int, end: int):\n        self.value = value\n        self.start = start\n        self.end = end\n        self.length = end - start\n        self.sumDigits = 0 # sumDigits is computed by compute_sum\n\n    def compute_sum(self) -> int:\n        \"\"\"Calculates the arithmetic sum of digits in the substring.\"\"\"\n        current_sum = 0\n        for char_digit in self.value:\n            current_sum += int(char_digit)\n        self.sumDigits = current_sum\n        return current_sum\n\nclass InputString:\n    \"\"\"Represents the input string and provides methods to enumerate its substrings.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self.length = len(value)\n\n    def get_substring(self, start: int, end: int) -> 'Substring':\n        \"\"\"Retrieves a Substring object for the specified range.\"\"\"\n        return Substring(self._value[start:end], start, end)\n\n    def enumerate_substrings(self) -> collections.abc.Iterator[Substring]:\n        \"\"\"Generates all contiguous substrings of the input string.\"\"\"\n        for i in range(self.length):\n            for j in range(i + 1, self.length + 1):\n                yield Substring(self._value[i:j], i, j)\n\nclass Counter:\n    \"\"\"Accumulates the count of matching substrings.\"\"\"\n    def __init__(self):\n        self._count = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the internal counter.\"\"\"\n        self._count += 1\n\n    def get_count(self) -> int:\n        \"\"\"Returns the current accumulated count.\"\"\"\n        return self._count\n\nclass Result:\n    \"\"\"Encapsulates the final count for result processing.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\n    def as_int(self) -> int:\n        \"\"\"Converts the encapsulated count to an integer.\"\"\"\n        return self.count\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts contiguous substrings of a numeric string where the sum of digits equals the substring's length.\n    Raises ValueError for non-digit inputs and returns 0 for an empty string.\n    \"\"\"\n    if not Validator.is_all_digits(s):\n        raise ValueError(\"Input string must contain only digits (0-9).\")\n\n    if s == '':\n        return 0\n\n    input_obj = InputString(s)\n    counter = Counter()\n\n    for substr in input_obj.enumerate_substrings():\n        sum_v = substr.compute_sum()\n        if sum_v == substr.length:\n            counter.increment()\n\n    return Result(counter.get_count()).as_int()\n```"}
