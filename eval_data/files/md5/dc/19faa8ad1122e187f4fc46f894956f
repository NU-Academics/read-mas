{"task_id": "Mbpp/799", "solution": "To implement the software design specification, the code will be structured into the following files:\n\n**`src/integer32.py`**\n```python\n\"\"\"Integer32 class for extracting low-order 32 bits.\"\"\"\n\nclass Integer32:\n    \"\"\"Encapsulates extracting the low-order 32 bits from an integer input.\"\"\"\n    def __init__(self, raw_value: int):\n        \"\"\"Initializes with the raw integer value.\"\"\"\n        self._raw_value = raw_value\n\n    def get_low_order_32(self) -> int:\n        \"\"\"Returns the low-order 32 bits of the raw value.\"\"\"\n        return self._raw_value & 0xFFFFFFFF\n\n```\n\n**`src/rotationcount.py`**\n```python\n\"\"\"RotationCount class for validating and normalizing rotation counts.\"\"\"\n\nclass RotationCount:\n    \"\"\"Encapsulates validation and normalization (modulo 32) of the rotation count d.\"\"\"\n    def __init__(self, d: int):\n        \"\"\"Initializes with the raw rotation count d.\"\"\"\n        self._d = d\n\n    def normalize(self) -> int:\n        \"\"\"Validates d is a non-negative integer and returns it modulo 32.\n        Raises ValueError for invalid d.\"\"\"\n        if not isinstance(self._d, int) or self._d < 0:\n            raise ValueError(\"Rotation count 'd' must be a non-negative integer.\")\n        return self._d % 32\n\n```\n\n**`src/bitrotator.py`**\n```python\n\"\"\"BitRotator coordinator and module-level left_rotate API.\"\"\"\n\nfrom src.integer32 import Integer32\nfrom src.rotationcount import RotationCount\n\nMASK32: int = 0xFFFFFFFF\n\"\"\"A 32-bit mask constant (0xFFFFFFFF).\"\"\"\n\nclass BitRotator:\n    \"\"\"Orchestrates bit rotation, delegating to domain helpers.\"\"\"\n    def left_rotate(self, value: int, d: int) -> int:\n        \"\"\"Rotates the low-order 32 bits of value left by d positions.\n        Returns a 32-bit masked integer result.\"\"\"\n        low32 = Integer32(value).get_low_order_32()\n        n = RotationCount(d).normalize()\n\n        if n == 0:\n            result = low32\n        else:\n            # Perform the left rotation for 32-bit unsigned integer.\n            result = ((low32 << n) | (low32 >> (32 - n))) & MASK32\n        return result\n\n    def mask32(self, x: int) -> int:\n        \"\"\"Applies a 32-bit mask to an integer.\"\"\"\n        return x & MASK32\n    \n    def normalize_d(self, d: int) -> int:\n        \"\"\"Normalizes the rotation count d using the RotationCount helper.\"\"\"\n        return RotationCount(d).normalize()\n\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"Public function that rotates the low-order 32 bits of value left by d positions.\n    Forwards to BitRotator's implementation.\"\"\"\n    return BitRotator().left_rotate(value, d)\n\n```\n\n**`tests/test_bitrotator.py`**\n```python\n\"\"\"Test suite for the bit rotation functionality.\"\"\"\n\nimport sys\nimport os\n\n# Add the 'src' directory to the Python path to allow importing from 'src'\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))\n\nfrom src.bitrotator import left_rotate\n\nclass TestCase:\n    \"\"\"Provides a simple test harness for verifying left_rotate.\"\"\"\n    def __init__(self, input_value: int, d_value: int, expected_value: int):\n        \"\"\"Initializes test case with input, rotation count, and expected result.\"\"\"\n        self.input = input_value\n        self.d = d_value\n        self.expected = expected_value\n\n    def run(self) -> bool:\n        \"\"\"Executes the test case and asserts the result, returning True on success.\"\"\"\n        print(f\"Running test: left_rotate({self.input}, {self.d})\")\n        result = left_rotate(self.input, self.d)\n        print(f\"  Expected: {self.expected}, Got: {result}\")\n        assert result == self.expected, f\"Test failed: Expected {self.expected}, Got {result}\"\n        print(\"  Test passed.\")\n        return True\n\nif __name__ == \"__main__\":\n    print(\"Starting bit rotator tests...\")\n    # Example verification assert left_rotate(16, 2) == 64\n    tc = TestCase(16, 2, 64)\n    try:\n        tc.run()\n        print(\"\\nAll specified tests passed successfully!\")\n    except AssertionError as e:\n        print(f\"\\nTest failed: {e}\")\n        sys.exit(1)\n    except ValueError as e:\n        print(f\"\\nAn error occurred during test execution: {e}\")\n        sys.exit(1)\n\n```"}
{"task_id": "Mbpp/799", "solution": "```python\nMASK = 0xFFFFFFFF\n\nclass InputParameter:\n    \"\"\"Lightweight container for invocation parameters.\"\"\"\n    def __init__(self, n: int, d: int):\n        self.n = n\n        self.d = d\n\n    def masked_n(self) -> int:\n        \"\"\"Return n coerced to a 32-bit value.\"\"\"\n        return self.n & MASK\n\n    def d_mod(self) -> int:\n        \"\"\"Return the normalized rotation amount.\"\"\"\n        return self.d % 32\n\nclass RotationResult:\n    \"\"\"Container for the 32-bit masked integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass LeftRotateFunction:\n    \"\"\"Encapsulates the 32-bit circular left rotation algorithm.\"\"\"\n    @staticmethod\n    def left_rotate(n: int, d: int) -> int:\n        \"\"\"Perform 32-bit circular left rotation.\"\"\"\n        input_params = InputParameter(n, d)\n        n_masked = input_params.masked_n()\n        k = input_params.d_mod()\n\n        if k == 0:\n            result_value = n_masked\n        else:\n            ShiftLeft = (n_masked << k) & MASK\n            ShiftOverflow = (n_masked >> (32 - k)) & MASK\n            result_value = (ShiftLeft | ShiftOverflow) & MASK\n        \n        return RotationResult(result_value).value\n\ndef left_rotate(n: int, d: int) -> int:\n    \"\"\"Rotate 32-bit integer n left by d positions and return masked result.\"\"\"\n    return LeftRotateFunction.left_rotate(n, d)\n```"}
