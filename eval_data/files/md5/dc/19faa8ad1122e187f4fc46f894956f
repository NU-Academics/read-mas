{"task_id": "Mbpp/603", "solution": "```python\nfrom typing import List\n\n# --- src/ludic/list_model.py ---\nclass LudicNumber:\n    \"\"\"Value holder for a single integer Ludic number.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\n    def __lt__(self, other):\n        \"\"\"Allows sorting LudicNumber objects by their value.\"\"\"\n        if not isinstance(other, LudicNumber):\n            return NotImplemented\n        return self.value < other.value\n\n    def __eq__(self, other):\n        \"\"\"Checks equality of LudicNumber objects by their value.\"\"\"\n        if not isinstance(other, LudicNumber):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self):\n        \"\"\"Allows LudicNumber objects to be used in sets for deduplication.\"\"\"\n        return hash(self.value)\n\n\nclass LudicNumberList:\n    \"\"\"Holds LudicNumber objects and provides deduplicate/sort operations.\"\"\"\n    def __init__(self, ludic_numbers: List[LudicNumber]):\n        self.ludic_numbers: List[LudicNumber] = ludic_numbers\n\n    def deduplicate(self) -> None:\n        \"\"\"Removes duplicate LudicNumber objects from the list, preserving order.\"\"\"\n        seen = set()\n        deduped = []\n        for ln in self.ludic_numbers:\n            if ln.value not in seen:\n                seen.add(ln.value)\n                deduped.append(ln)\n        self.ludic_numbers = deduped\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the LudicNumber objects in ascending order by their value.\"\"\"\n        self.ludic_numbers.sort()\n\n\n# --- src/ludic/validator.py ---\nclass InputValidator:\n    \"\"\"Validates input presence and type according to business rules.\"\"\"\n    def validate(self, n) -> bool:\n        \"\"\"Raises ValueError for non-integer inputs, otherwise returns True.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer\")\n        return True\n\n\n# --- src/ludic/generator.py ---\nclass LudicNumberGenerator:\n    \"\"\"Orchestrates validation, generation, and list processing.\"\"\"\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Entrypoint for the generator, handles validation and processing.\"\"\"\n        validator = InputValidator()\n        validator.validate(n)\n\n        if n < 1:\n            return []\n\n        candidates: List[LudicNumber] = self.generateSequence(n)\n        \n        result_list = LudicNumberList(ludic_numbers=candidates)\n        result_list.deduplicate()\n        result_list.sortAscending()\n        \n        return [ln.value for ln in result_list.ludic_numbers]\n\n    def generateSequence(self, n: int) -> List[LudicNumber]:\n        \"\"\"Generates candidate ludic numbers up to n using a sieve process.\"\"\"\n        numbers_as_int = list(range(1, n + 1))\n        ludic_number_objects: List[LudicNumber] = []\n\n        while len(numbers_as_int) > 0:\n            ludic_val = numbers_as_int[0]\n            ludic_number_objects.append(LudicNumber(ludic_val))\n\n            if ludic_val == 1:\n                numbers_as_int.pop(0)\n                continue\n\n            next_numbers_as_int = []\n            current_sieve_pos = 0 \n            \n            # Iterate through remaining numbers_as_int after the current ludic (numbers_as_int[0]).\n            for i in range(1, len(numbers_as_int)):\n                current_sieve_pos += 1\n                if current_sieve_pos % ludic_val != 0:\n                    next_numbers_as_int.append(numbers_as_int[i])\n            \n            numbers_as_int = next_numbers_as_int\n        \n        return ludic_number_objects\n\n\n# --- src/ludic/__init__.py ---\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"Library entrypoint function (FR1). Delegates to LudicNumberGenerator.get_ludic.\"\"\"\n    generator = LudicNumberGenerator()\n    return generator.get_ludic(n)\n```"}
{"task_id": "Mbpp/604", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the raw input string for processing.\"\"\"\n    raw: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw input string.\"\"\"\n        return len(self.raw)\n\n@dataclass\nclass Word:\n    \"\"\"Represents a single word token.\"\"\"\n    text: str\n\n@dataclass\nclass OutputString:\n    \"\"\"Represents the final output string.\"\"\"\n    value: str\n\nclass Tokenizer:\n    \"\"\"Splits an input string into a list of word tokens.\"\"\"\n    def tokenize(self, input_str_obj: InputString) -> List[Word]:\n        \"\"\"Splits the raw string on spaces, handling multiple and leading/trailing spaces.\"\"\"\n        raw_words = input_str_obj.raw.split(' ')\n        filtered_words_text = [wt for wt in raw_words if wt]\n        return [Word(text=wt) for wt in filtered_words_text]\n\nclass Reverser:\n    \"\"\"Reverses the order of a list of word tokens.\"\"\"\n    def reverse(self, words: List[Word]) -> List[Word]:\n        \"\"\"Returns a new list with words in reversed order.\"\"\"\n        return words[::-1]\n\nclass Joiner:\n    \"\"\"Joins a list of word tokens into a single string.\"\"\"\n    def join(self, words: List[Word]) -> OutputString:\n        \"\"\"Concatenates word texts with single spaces.\"\"\"\n        word_texts = [word.text for word in words]\n        joined_string = ' '.join(word_texts)\n        return OutputString(value=joined_string)\n\ndef reverse_words(input: str) -> str:\n    \"\"\"Reverses the order of words in a string, handling spaces as delimiters.\n    Processes input through tokenizer, reverser, and joiner components.\n    \"\"\"\n    inp = InputString(raw=input)\n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(inp)\n    reverser = Reverser()\n    reversed_tokens = reverser.reverse(tokens)\n    joiner = Joiner()\n    output = joiner.join(reversed_tokens)\n    return output.value\n```"}
{"task_id": "Mbpp/605", "solution": "```python\ndef prime_num(n: int) -> bool:\n    \"\"\"Return True iff n is prime (n >= 2 and no divisors other than 1 and n).\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n```"}
{"task_id": "Mbpp/603", "solution": "```python\n# src/__init__.py\nfrom .ludic_service import get_ludic\n\n# src/input_parameter.py\nfrom typing import Any\n\nclass InputParameter:\n    \"\"\"Encapsulates input validation for 'n'.\"\"\"\n    def __init__(self, n: Any) -> None:\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Validates if 'n' is an integer, raising TypeError if not.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        return True\n\n# src/ludic_sequence.py\nfrom typing import List\n\nclass LudicSequence:\n    \"\"\"Implements the sieve-like algorithm for ludic number generation.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def generate(self, n: int) -> List[int]:\n        \"\"\"Generates ludic numbers up to n using a sieve process.\"\"\"\n        if n < 1:\n            return []\n\n        # Start with all natural numbers up to n.\n        current_numbers = list(range(1, n + 1))\n        ludic_numbers = []\n\n        while current_numbers:\n            # The first number in the current list is the next ludic number.\n            p = current_numbers.pop(0)\n            ludic_numbers.append(p)\n\n            if not current_numbers:\n                break # No more numbers to sieve.\n\n            # Sieve process: remove every p-th number from the remaining list.\n            new_current_numbers = []\n            skip_counter = 0\n            for number in current_numbers:\n                skip_counter += 1\n                if skip_counter == p:\n                    skip_counter = 0  # Reset counter for the next p-th removal.\n                else:\n                    new_current_numbers.append(number)\n            current_numbers = new_current_numbers\n            \n        return ludic_numbers\n\n# src/result.py\nfrom typing import List\n\nclass Result:\n    \"\"\"Encapsulates a list of values and provides post-processing utilities.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def sorted(self) -> List[int]:\n        \"\"\"Returns unique values from the list, sorted in ascending order.\"\"\"\n        return sorted(list(set(self.values)))\n\n# src/ludic_service.py\nfrom typing import List, Type, Any # Type for class type hinting, Any for flexible dependency injection\n# Relative imports for the modules in the src package.\nfrom .input_parameter import InputParameter\nfrom .ludic_sequence import LudicSequence\nfrom .result import Result\n\nclass LudicService:\n    \"\"\"Orchestrates validation, generation, and post-processing of ludic numbers.\"\"\"\n    def __init__(self, validator: InputParameter = None, generator: LudicSequence = None) -> None:\n        # Store the class/factory for InputParameter as it needs 'n' per call.\n        self._validator_factory: Type[InputParameter] = type(validator) if validator is not None else InputParameter\n        # Store the generator instance, or create a default one.\n        self._generator: LudicSequence = generator if generator is not None else LudicSequence()\n        # Store the Result class/factory to be instantiated with values.\n        self._result_factory: Type[Result] = Result # Result is simple enough not to require 'validator-like' injection flexibility here.\n\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Generates and returns all ludic numbers less than or equal to n.\"\"\"\n        # Validate the input parameter.\n        validator_instance = self._validator_factory(n)\n        validator_instance.validate() # This raises TypeError if n is not an integer.\n\n        # Handle case for n < 1 as per BR-7.\n        if n < 1:\n            return []\n\n        # Generate the ludic sequence.\n        raw_ludic_values = self._generator.generate(n)\n\n        # Post-process the results (sort and ensure uniqueness).\n        result_obj = self._result_factory(raw_ludic_values)\n        return result_obj.sorted()\n\n# Public API function as required.\n_ludic_service_instance = LudicService() # Create a singleton service instance.\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"Public API function to get ludic numbers up to n.\"\"\"\n    return _ludic_service_instance.get_ludic(n)\n\n```"}
{"task_id": "Mbpp/604", "solution": "```python\n# src/reverse_words.py\nfrom typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n    def split_by_space(self) -> List[str]:\n        \"\"\"Splits the string by ASCII space, ignoring empty tokens.\"\"\"\n        # Splits by ASCII space and filters out empty strings to collapse multiple spaces.\n        return [token for token in self.value.split(' ') if token]\n\n@dataclass\nclass Word:\n    value: str\n    original_position: int\n\n@dataclass\nclass OutputString:\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the output string.\"\"\"\n        return len(self.value)\n\nclass ReverseWordsFunction:\n    \"\"\"Encapsulates the algorithm and validation logic for reversing words.\"\"\"\n\n    def validate_input(self, input: str) -> bool:\n        \"\"\"Validates if the input is a string, raising TypeError if not.\"\"\"\n        if not isinstance(input, str):\n            raise TypeError(\"Input must be a string.\")\n        return True\n\n    def reverse_words(self, input: str) -> str:\n        \"\"\"Performs validation, splits, reverses, and joins words from the input string.\"\"\"\n        self.validate_input(input)\n\n        input_obj = InputString(input)\n        tokens = input_obj.split_by_space()\n\n        # The design implies manipulating Word instances, but for simple reversal,\n        # reversing the list of string tokens directly is functionally equivalent.\n        reversed_tokens = tokens[::-1]\n\n        output_value = \" \".join(reversed_tokens)\n        output_obj = OutputString(output_value)\n        return output_obj.value\n\n# Public API function: instantiates the functional class once for reuse.\n_reverse_words_func_instance = ReverseWordsFunction()\n\ndef reverse_words(input: str) -> str:\n    \"\"\"Reverses the order of words in a string, preserving characters within each word.\"\"\"\n    return _reverse_words_func_instance.reverse_words(input)\n\n```\n```python\n# tests/test_reverse_words.py\nimport unittest\nfrom src.reverse_words import reverse_words # Import the public API function\n\nclass TestReverseWords(unittest.TestCase):\n    \"\"\"Unit tests for the reverse_words function.\"\"\"\n\n    def test_example(self) -> None:\n        \"\"\"Asserts the required example: 'python program' -> 'program python'.\"\"\"\n        self.assertEqual(reverse_words(\"python program\"), \"program python\")\n\n    def test_single_word(self) -> None:\n        \"\"\"Tests handling of a single word.\"\"\"\n        self.assertEqual(reverse_words(\"hello\"), \"hello\")\n\n    def test_multiple_spaces_and_leading_trailing(self) -> None:\n        \"\"\"Tests handling of multiple and leading/trailing spaces, collapsing them.\"\"\"\n        self.assertEqual(reverse_words(\"  a  b  c   \"), \"c b a\")\n        self.assertEqual(reverse_words(\"  a b  \"), \"b a\")\n        self.assertEqual(reverse_words(\"a  b\"), \"b a\")\n        self.assertEqual(reverse_words(\" a b \"), \"b a\")\n\n    def test_empty_string(self) -> None:\n        \"\"\"Tests handling of an empty string or string containing only spaces.\"\"\"\n        self.assertEqual(reverse_words(\"\"), \"\")\n        self.assertEqual(reverse_words(\"   \"), \"\")\n\n    def test_non_string_input_raises_type_error(self) -> None:\n        \"\"\"Tests that a TypeError is raised for non-string or None inputs.\"\"\"\n        with self.assertRaises(TypeError):\n            reverse_words(123)\n        with self.assertRaises(TypeError):\n            reverse_words(None)\n        with self.assertRaises(TypeError):\n            reverse_words([\"a\", \"b\"])\n\n```"}
{"task_id": "Mbpp/605", "solution": "```python\n# src/__init__.py\n# Purpose: package marker for src.* imports\n# Contains: (empty)\n```\n```python\n# src/domain.py\n# Purpose: Domain data holders matching SRS domain classes\n# Contains: class IntegerInput, class PrimeResult\n\nclass IntegerInput:\n    \"\"\"Simple typed holder for the input integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass PrimeResult:\n    \"\"\"Simple typed holder for the boolean primality result.\"\"\"\n    def __init__(self, isPrime: bool) -> None:\n        self.isPrime = isPrime\n```\n```python\n# src/prime_checker.py\n# Purpose: Encapsulate primality logic in PrimeChecker and expose the required API function prime_num(n)\n# Contains: class PrimeChecker, function prime_num\n\nimport math\nfrom src.domain import IntegerInput, PrimeResult\n\nclass PrimeChecker:\n    \"\"\"Encapsulates the algorithm for deciding primality following SRS business rules.\"\"\"\n    def _is_divisible(self, a: int, b: int) -> bool:\n        \"\"\"Returns True if a is divisible by b.\"\"\"\n        return a % b == 0\n\n    def prime_num(self, n: int) -> bool:\n        \"\"\"Evaluates whether n is prime using SRS rules.\"\"\"\n        if n <= 1:\n            return False  # BR3: Return False for n <= 1\n        if n == 2:\n            return True   # BR4: Return True for n == 2\n        if self._is_divisible(n, 2):\n            return False  # BR5: Return False for any even integer n > 2\n\n        # BR2: Test odd divisors up to sqrt(n)\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if self._is_divisible(n, i):\n                return False\n        return True\n\n# Public API function prime_num(n) that delegates to PrimeChecker.\ndef prime_num(n: int) -> bool:\n    \"\"\"Public API function to check if an integer is a prime number.\"\"\"\n    checker = PrimeChecker()\n    return checker.prime_num(n)\n```\n```python\n# src/main.py\n# Purpose: Demonstration entry point executing the SRS-provided assertion\n# Contains: function main and the if __name__ == '__main__' guard\n\nfrom src.prime_checker import prime_num\n\ndef main() -> None:\n    \"\"\"Demonstrates prime_num usage and runs the SRS-provided assertion.\"\"\"\n    print(f\"Checking prime_num(13)...\")\n    result_13 = prime_num(13)\n    print(f\"prime_num(13) == {result_13}\")\n\n    # FR6: Acceptance example to satisfy\n    assert prime_num(13) == True\n    print(\"SRS assertion prime_num(13) == True passed.\")\n\nif __name__ == '__main__':\n    main()\n```\n```python\n# tests/test_prime.py\n# Purpose: Unit tests that verify FR2..FR6 acceptance tests specified in the SRS\n# Contains: test functions asserting expected prime_num behavior\n\nfrom src.prime_checker import prime_num\n\ndef test_prime_13():\n    \"\"\"Verifies FR6: prime_num(13) should be True.\"\"\"\n    assert prime_num(13) == True\n\ndef test_prime_2():\n    \"\"\"Verifies BR4: prime_num(2) should be True.\"\"\"\n    assert prime_num(2) == True\n\ndef test_not_prime_1():\n    \"\"\"Verifies BR3: prime_num(1) should be False.\"\"\"\n    assert prime_num(1) == False\n\ndef test_not_prime_4():\n    \"\"\"Verifies BR5: prime_num(4) should be False.\"\"\"\n    assert prime_num(4) == False\n\ndef test_not_prime_0():\n    \"\"\"Verifies BR3: prime_num(0) should be False.\"\"\"\n    assert prime_num(0) == False\n\ndef test_negative_number():\n    \"\"\"Verifies BR3: prime_num(-5) should be False.\"\"\"\n    assert prime_num(-5) == False\n\ndef test_large_prime():\n    \"\"\"Verifies a large prime number.\"\"\"\n    assert prime_num(997) == True\n\ndef test_large_non_prime():\n    \"\"\"Verifies a large non-prime number.\"\"\"\n    assert prime_num(1001) == False # 7 * 11 * 13\n\ndef test_even_number_greater_than_2():\n    \"\"\"Verifies BR5: prime_num(100) should be False.\"\"\"\n    assert prime_num(100) == False\n\ndef test_first_odd_non_prime():\n    \"\"\"Verifies composite odd number: prime_num(9