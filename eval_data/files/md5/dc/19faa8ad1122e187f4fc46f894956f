{"task_id": "Mbpp/792", "solution": "```python\n# src/count_list.py\n\nfrom typing import Any, List\n\n\"\"\"\nThis module provides the count_list function, which counts top-level list elements.\nIt also includes domain helper classes: InputList, ListElement, and CountResult.\n\"\"\"\n\nclass InputList:\n    \"\"\"Lightweight wrapper around a Python list to centralize input representation.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items: list = items\n\nclass ListElement:\n    \"\"\"Represents a single top-level element and provides an is_list() check.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value: Any = value\n\n    def is_list(self) -> bool:\n        \"\"\"Checks if the element's value is an instance of a Python list.\"\"\"\n        return isinstance(self.value, list)\n\nclass CountResult:\n    \"\"\"Container for the integer count result.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count: int = count\n\ndef count_list(input_list: list) -> int:\n    \"\"\"\n    Counts how many top-level elements of the input_list are Python lists.\n    This function processes the input non-recursively.\n    \"\"\"\n    wrapped_input = InputList(input_list)\n    count = 0\n\n    for item in wrapped_input.items:\n        element = ListElement(item)\n        if element.is_list():\n            count += 1\n\n    result = CountResult(count)\n    return result.count\n```\n```python\n# tests/test_count_list.py\n\nfrom src.count_list import count_list\n\n# Unit test verifying the SRS-provided example assertion.\nassert count_list([[1, 3], [5, 7], [9, 11], [13, 15, 17]]) == 4\nprint(\"Test passed: count_list([[1, 3], [5, 7], [9, 11], [13, 15, 17]]) == 4\")\n```"}
{"task_id": "Mbpp/793", "solution": "```\nlast_position_finder/src/last_position_finder/models.py\nfrom dataclasses import dataclass\nfrom typing import Any, List\n\n@dataclass(frozen=True)\nclass SortedList:\n    \"\"\"Immutable container for a sorted list, documenting the domain concept.\"\"\"\n    elements: List[Any]\n\n@dataclass(frozen=True)\nclass TargetValue:\n    \"\"\"Wrapper for the target search value, documenting the domain concept.\"\"\"\n    value: Any\n\n@dataclass(frozen=True)\nclass IndexResult:\n    \"\"\"Immutable container for an integer index result, documenting the domain concept.\"\"\"\n    index: int\n\n```\nlast_position_finder/src/last_position_finder/last.py\nfrom typing import Any, List\n\ndef _binary_search_rightmost(sorted_list: List[Any], target: Any) -> int:\n    \"\"\"Performs a rightmost binary search on a sorted list.\n    Returns the index of the last occurrence or -1 if not found.\"\"\"\n    low = 0\n    high = len(sorted_list) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] == target:\n            result = mid\n            low = mid + 1 # Continue searching in the right half for a later occurrence.\n        elif sorted_list[mid] < target:\n            low = mid + 1\n        else: # sorted_list[mid] > target\n            high = mid - 1\n    return result\n\ndef last(sorted_list: list, target: Any) -> int:\n    \"\"\"Returns the zero-based index of the last occurrence of the target value.\n    If the target is not found, it returns -1.\"\"\"\n    return _binary_search_rightmost(sorted_list, target)\n\n```\nlast_position_finder/src/last_position_finder/__init__.py\nfrom .last import last\n```"}
{"task_id": "Mbpp/794", "solution": "```\nREADME.md\n```\n# text_starta_endb Library\n\nThis library provides a single function, `text_starta_endb`, which checks if a given string\nstarts with 'a' and ends with 'b'.\n\n## Installation\n\nNo special installation is required. Simply place the `src` and `tests` directories\nin your project.\n\n## Usage\n\nImport the `text_starta_endb` function from the `src` package:\n\n```python\nfrom src.text_starta_endb import text_starta_endb\n\n# Example usage\nresult1 = text_starta_endb(\"aabbbb\")  # True\nresult2 = text_starta_endb(\"axbyb\")   # True\nresult3 = text_starta_endb(\"apple\")   # False\nresult4 = text_starta_endb(\"bapplea\") # False\nresult5 = text_starta_endb(\"a\")       # False\nresult6 = text_starta_endb(\"b\")       # False\nresult7 = text_starta_endb(\"ab\")      # True\nresult8 = text_starta_endb(\"\")        # False\n\nprint(f\"'aabbbb' -> {result1}\")\nprint(f\"'axbyb' -> {result2}\")\nprint(f\"'apple' -> {result3}\")\nprint(f\"'bapplea' -> {result4}\")\nprint(f\"'a' -> {result5}\")\nprint(f\"'b' -> {result6}\")\nprint(f\"'ab' -> {result7}\")\nprint(f\"'' -> {result8}\")\n```\n\n## Testing\n\nUnit tests are provided in the `tests` directory. To run them, navigate to the\nroot directory of the project (containing `src` and `tests`) and use a test runner\nlike `pytest`:\n\n```bash\npytest\n```\n```\n\n```\nsrc/__init__.py\n```\n\"\"\"\nPackage marker for the src directory.\nExposes the public API function `text_starta_endb`.\n\"\"\"\nfrom .text_starta_endb import text_starta_endb\n```\n\n```\nsrc/match_criteria.py\n```\n\"\"\"\nEncapsulates the start and end characters for matching.\nDefaults to 'a' and 'b' respectively.\n\"\"\"\nclass MatchCriteria:\n    def __init__(self, startChar: str = 'a', endChar: str = 'b') -> None:\n        self.startChar = startChar\n        self.endChar = endChar\n```\n\n```\nsrc/types.py\n```\n\"\"\"\nLightweight domain data types used for traceability within the system.\nThese classes wrap primitive types for conceptual clarity.\n\"\"\"\nclass InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass MatchResult:\n    def __init__(self, isMatch: bool) -> None:\n        self.isMatch = isMatch\n```\n\n```\nsrc/text_starta_endb.py\n```\n\"\"\"\nProvides the core function `text_starta_endb` and its implementation class.\nThis module integrates `MatchCriteria`, `InputString`, and `MatchResult` for matching logic.\n\"\"\"\nfrom src.match_criteria import MatchCriteria\nfrom src.types import InputString, MatchResult # InputString and MatchResult are included per design, though not directly used in the final match logic.\n\nclass TextStartAEndBFunction:\n    \"\"\"\n    Implements the core matching logic based on specified criteria.\n    Evaluates if an input string starts with a given char and ends with another.\n    \"\"\"\n    def __init__(self, criteria: MatchCriteria = None) -> None:\n        self.criteria = criteria if criteria is not None else MatchCriteria()\n\n    def match(self, input: str) -> bool:\n        \"\"\"\n        Checks if the input string starts with the criteria's startChar\n        and ends with the criteria's endChar.\n        \"\"\"\n        if len(input) < 2:\n            return False # String must be at least two characters long to meet criteria.\n\n        starts_correctly = input[0] == self.criteria.startChar\n        ends_correctly = input[-1] == self.criteria.endChar\n\n        return starts_correctly and ends_correctly\n\n# Global instance for the wrapper function to use, adhering to single responsibility.\n_text_starta_endb_matcher = TextStartAEndBFunction()\n\ndef text_starta_endb(input: str) -> bool:\n    \"\"\"\n    Determines if the input string starts with 'a' and ends with 'b'.\n    This is the primary public API function.\n    \"\"\"\n    return _text_starta_endb_matcher.match(input)\n```\n\n```\ntests/test_text_starta_endb.py\n```\n\"\"\"\nUnit tests for the text_starta_endb library function.\nContains the specific assertion required by the design.\n\"\"\"\nfrom src.text_starta_endb import text_starta_endb\n\ndef test_assert_text_starta_endb_provided_case() -> None:\n    \"\"\"\n    Tests the text_starta_endb function with the specific case\n    provided in the requirements.\n    \"\"\"\n    assert text_starta_endb(\"aabbbb\") == True\n```"}
{"task_id": "Mbpp/796", "solution": "```python\n# src/return_sum.py\n\ndef _is_numeric(value):\n    \"\"\"Return True if value is instance of int or float (per FR2/BR3).\"\"\"\n    return isinstance(value, (int, float))\n\ndef return_sum(dict_input):\n    \"\"\"Accepts a dictionary-like mapping and returns the arithmetic sum of its numeric values (int or float).\n    Raises TypeError if dict_input is not a dict or if any value is not numeric.\n    \"\"\"\n    if not isinstance(dict_input, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    total_sum = 0\n    for key, value in dict_input.items():\n        if not _is_numeric(value):\n            raise TypeError(f\"Value for key '{key}' is not numeric (int or float).\")\n        total_sum += value\n    return total_sum\n\n```\n```python\n# tests/test_return_sum.py\n\nfrom src.return_sum import return_sum\nimport sys\n\nclass TestCase:\n    \"\"\"A minimal test case class to encapsulate a single test assertion.\n    It stores test data and provides a method to run the assertion.\n    \"\"\"\n    def __init__(self, name: str, input: dict, expected_output: (int|float)) -> None:\n        self.name = name\n        self.input = input\n        self.expected_output = expected_output\n\n    def run(self) -> None:\n        \"\"\"Executes the test by invoking return_sum and asserting the result.\n        Raises AssertionError if the actual output does not match the expected output.\n        \"\"\"\n        print(f\"Running test: '{self.name}' with input {self.input}\")\n        actual_output = return_sum(self.input)\n        assert actual_output == self.expected_output, \\\n               f\"Test '{self.name}' failed: Expected {self.expected_output}, got {actual_output}\"\n        print(f\"Test '{self.name}' passed.\")\n\ndef main():\n    \"\"\"Main function to run the specific test case required by the SRS.\n    It constructs the test case and handles its execution and result reporting.\n    \"\"\"\n    print(\"Executing main test runner...\")\n    test_case = TestCase(\n        name='provided-test',\n        input={'a': 100, 'b': 200, 'c': 300},\n        expected_output=600\n    )\n    try:\n        test_case.run()\n        print(\"\\nAll required tests passed successfully!\")\n    except AssertionError as e:\n        print(f\"\\nTest failed: {e}\")\n        sys.exit(1)\n    except Exception as e:\n        print(f\"\\nAn unexpected error occurred during testing: {e}\")\n        sys.exit(1)\n\nif __name__ == '__main__':\n    main()\n\n```"}
