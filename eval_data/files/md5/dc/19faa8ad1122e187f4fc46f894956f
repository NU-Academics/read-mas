{"task_id": "Mbpp/6", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass IntegerValue:\n    \"\"\"Represents an integer value.\"\"\"\n    value: int\n\n@dataclass\nclass XORResult:\n    \"\"\"Represents the result of an XOR operation.\"\"\"\n    value: int\n\n@dataclass\nclass TestCase:\n    \"\"\"Represents a test case with inputs and expected output.\"\"\"\n    a: int\n    b: int\n    expected: bool\n\nclass DifferBitChecker:\n    \"\"\"Encapsulates domain logic for bit difference checks.\"\"\"\n    def compute_xor(self, a: int, b: int) -> int:\n        \"\"\"Return the bitwise XOR of two integers.\"\"\"\n        return a ^ b\n\n    def is_single_bit_set(self, x: int) -> bool:\n        \"\"\"Return True if x is a positive power of two.\"\"\"\n        return x > 0 and (x & (x - 1)) == 0\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Public API: returns True if two integers differ at exactly one bit position.\"\"\"\n    checker = DifferBitChecker()\n    x = checker.compute_xor(a, b)\n    return checker.is_single_bit_set(x)\n```"}
{"task_id": "Mbpp/3", "solution": "```python\n# src/is_not_prime.py\n\"\"\"Implementation module for is_not_prime(n: int) -> bool per SRS.\"\"\"\nfrom math import isqrt\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Return True iff n is not prime; False iff n is prime.\n\n    Args:\n        n (int): integer to evaluate\n\n    Returns:\n        bool: True if n is not prime, False if n is prime\n    \"\"\"\n    # Implementation: uses trial division up to isqrt(n)\n    # Behavior (per design):\n    # - if n <= 1: return True\n    if n <= 1:\n        return True\n    # - if n == 2: return False\n    if n == 2:\n        return False\n    # - if n % 2 == 0: return True\n    if n % 2 == 0:\n        return True\n    # - for i in range(3, isqrt(n)+1, 2): if n % i == 0: return True\n    for i in range(3, isqrt(n) + 1, 2):\n        if n % i == 0:\n            return True\n    # - return False\n    return False\n\n```\n```python\n# tests/test_is_not_prime.py\n\"\"\"Test harness that validates the SRS acceptance test: assert is_not_prime(2) == False\n\nRun with:\n    python3 tests/test_is_not_prime.py\n\"\"\"\nfrom src.is_not_prime import is_not_prime\n\ndef run_tests() -> None:\n    # Required acceptance assertion per SRS\n    assert is_not_prime(2) == False\n\nif __name__ == '__main__':\n    run_tests()\n    print('All tests passed (including assert is_not_prime(2) == False)')\n\n```"}
{"task_id": "Mbpp/6", "solution": "```python\ndef xor(a: int, b: int) -> int:\n    \"\"\"Computes the bitwise XOR of two integers.\n    This helper function directly applies the XOR operator.\n    \"\"\"\n    return a ^ b\n\ndef count_set_bits(x: int) -> int:\n    \"\"\"Counts the number of set bits (population count) in an integer.\n    Uses the efficient `int.bit_count()` method available in Python 3.10+.\n    \"\"\"\n    return x.bit_count()\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Checks if two integers differ at exactly one bit position.\n    This function computes the XOR of inputs and then counts the set bits in the result.\n    \"\"\"\n    xor_result = xor(a, b)\n    differing_bits = count_set_bits(xor_result)\n    return differing_bits == 1\n```"}
{"task_id": "Mbpp/4", "solution": "```python\nimport heapq\n\ndef _validate_inputs(numbers, n):\n    \"\"\"\n    Validates input types and values for the heap_queue_largest function.\n    Raises ValueError if inputs are invalid according to specifications.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input 'numbers' must be a list.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef _select_n_largest(numbers, n):\n    \"\"\"\n    Selects the n largest numeric values from a list and returns them sorted descending.\n    Handles edge cases like n=0 or n >= len(numbers) as per design.\n    \"\"\"\n    if n == 0:\n        return []\n    # heapq.nlargest efficiently finds the n largest elements and returns them in descending order.\n    return heapq.nlargest(n, numbers)\n\ndef heap_queue_largest(numbers, n):\n    \"\"\"\n    Finds the n largest numeric values from a list and returns them in descending order.\n    This function orchestrates input validation and the selection process.\n    \"\"\"\n    _validate_inputs(numbers, n)\n    return _select_n_largest(numbers, n)\n```"}
{"task_id": "Mbpp/3", "solution": "```python\n# File: is_not_prime.py\nimport math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Checks if an integer n is non-prime according to design rules.\n    Returns True for non-prime, False for prime.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to the integer square root of n.\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return True\n\n    return False\n\n```\n```python\n# File: tests/test_is_not_prime.py\nimport unittest\nfrom is_not_prime import is_not_prime\n\nclass TestIsNotPrime(unittest.TestCase):\n    \"\"\"\n    Unit tests for the is_not_prime function.\n    Verifies specific primality logic.\n    \"\"\"\n    def test_is_not_prime_2(self):\n        \"\"\"\n        Asserts that is_not_prime(2) correctly returns False.\n        \"\"\"\n        self.assertFalse(is_not_prime(2))\n\n```"}
{"task_id": "Mbpp/2", "solution": "from typing import Any, Iterable, Iterator, Sequence, List\n\n# 1. Element (class)\n# Responsibility summary: Lightweight value wrapper that holds an element value;\n# equality and access delegate to the underlying value.\nclass Element:\n    def __init__(self, value: Any) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> Any:\n        return self._value\n\n    def __eq__(self, other: object) -> bool:\n        # Compares the underlying value, handling other Element instances or direct values.\n        if isinstance(other, Element):\n            return self._value == other._value\n        return self._value == other\n\n    def __repr__(self) -> str:\n        return f\"Element({repr(self._value)})\"\n\n# 2. ResultIterable (class)\n# Responsibility summary: Container implementing the iterable protocol over the shared element values;\n# exposes conversion helper methods used in tests.\nclass ResultIterable:\n    def __init__(self, elements: Iterable[Any]) -> None:\n        self._elements: List[Any] = list(elements)\n\n    def __iter__(self) -> Iterator[Any]:\n        # Provides an iterator over the stored shared elements.\n        return iter(self._elements)\n\n    def to_set(self) -> set:\n        # Converts the internal list of elements to a set for comparison purposes.\n        return set(self._elements)\n\n    def __repr__(self) -> str:\n        return f\"ResultIterable({repr(self._elements)})\"\n\n\n# 3. SimilarElementsFunction (class)\n# Responsibility summary: Encapsulates the comparison algorithm that determines shared elements\n# between two input sequences, using language-standard equality semantics.\nclass SimilarElementsFunction:\n    def __init__(self, input1: Sequence[Any], input2: Sequence[Any]) -> None:\n        self._input1 = input1\n        self._input2 = input2\n\n    def execute(self) -> ResultIterable:\n        # Determines unique shared elements using sets for hashable types or a nested loop fallback for unhashable.\n        shared_elements: List[Any] = []\n        try:\n            # Attempt to use sets for efficiency if elements are hashable.\n            set1 = set(self._input1)\n            set2 = set(self._input2)\n            shared_elements = list(set1.intersection(set2))\n        except TypeError:\n            # Fallback for unhashable elements, performing iterative comparison and maintaining uniqueness.\n            for elem1 in self._input1:\n                is_shared_in_input2 = False\n                for elem2 in self._input2:\n                    if elem1 == elem2:\n                        is_shared_in_input2 = True\n                        break\n                \n                if is_shared_in_input2:\n                    # Check if elem1 is already collected to ensure uniqueness.\n                    is_already_collected = False\n                    for collected_elem in shared_elements:\n                        if elem1 == collected_elem:\n                            is_already_collected = True\n                            break\n                    if not is_already_collected:\n                        shared_elements.append(elem1)\n        \n        return ResultIterable(shared_elements)\n\n# 4. similar_elements (function)\n# Responsibility summary: Public library API function; accepts exactly two sequence parameters\n# and returns an iterable of shared elements (ordering unspecified).\ndef similar_elements(seq1: Sequence[Any], seq2: Sequence[Any]) -> Iterable[Any]:\n    # Instantiates the comparison logic and returns the resulting iterable of shared elements.\n    finder = SimilarElementsFunction(seq1, seq2)\n    return finder.execute()"}
{"task_id": "Mbpp/4", "solution": "```python\nimport heapq\nfrom typing import List\n\ndef heap_queue_largest(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Returns the n largest integers from the input list in descending order.\n    Duplicates are treated as separate entries.\n    \"\"\"\n    largest_n = heapq.nlargest(n, input_list)\n    largest_n.sort(reverse=True)\n    return largest_n\n```"}
{"task_id": "Mbpp/2", "solution": "```python\n# src/__init__.py\nfrom .similar_elements import similar_elements\n\n__all__ = [\"similar_elements\"]\n\n# src/similar_elements.py\nfrom typing import Sequence, Iterable, List, Any\n\ndef _unique_preserve_order(items: Iterable[Any]) -> List[Any]:\n    \"\"\"\n    Returns a list of unique items from the iterable, preserving their first-seen order.\n    Uses element-wise comparison for uniqueness, propagating equality exceptions.\n    \"\"\"\n    result = []\n    for item in items:\n        found = False\n        for existing_item in result:\n            if item == existing_item:\n                found = True\n                break\n        if not found:\n            result.append(item)\n    return result\n\ndef _collect_common_hashable(a: Sequence[Any], b: Sequence[Any]) -> List[Any]:\n    \"\"\"\n    Collects common elements efficiently using sets, assuming all elements are hashable.\n    This function will raise TypeError if elements are unhashable.\n    \"\"\"\n    # Optimize by building a set from the smaller sequence for 'in' checks.\n    if len(a) > len(b):\n        set_smaller = set(b)\n        iter_larger = a\n    else:\n        set_smaller = set(a)\n        iter_larger = b\n\n    common_elements = []\n    for item in iter_larger:\n        if item in set_smaller:\n            common_elements.append(item)\n    return common_elements\n\ndef _collect_common_unhashable(a: Sequence[Any], b: Sequence[Any]) -> List[Any]:\n    \"\"\"\n    Collects common elements using element-wise comparison for unhashable types.\n    This uses an O(N*M) approach, propagating any equality comparison exceptions.\n    \"\"\"\n    common_elements = []\n    for item_a in a:\n        if item_a in b:\n            common_elements.append(item_a)\n    return common_elements\n\ndef similar_elements(a: Sequence[Any], b: Sequence[Any]) -> Iterable[Any]:\n    \"\"\"\n    Finds elements common to both input sequences, returning them as a unique, order-preserving list.\n    Attempts hash-based collection first, falling back to element-wise comparison if elements are unhashable.\n    \"\"\"\n    # No explicit input type validation or TypeError raising for invalid sequence types\n    # due to critical requirements, assuming inputs are sequences.\n\n    try:\n        # Attempt hash-based approach first for efficiency (BR11).\n        # This will raise TypeError if any element in `a` or `b` is unhashable during set construction.\n        common = _collect_common_hashable(a, b)\n    except TypeError:\n        # Fallback to element-wise comparison if hashing fails (BR11).\n        common = _collect_common_unhashable(a, b)\n    except Exception:\n        # Propagate other exceptions if they occur during element processing (BR11).\n        raise # Re-raise the original exception.\n\n    # Post-process to ensure unique elements preserving first-seen order (BR3, BR9/BR10).\n    # This step is robust to unhashable items due to its element-wise comparison.\n    return _unique_preserve_order(common)\n```"}
