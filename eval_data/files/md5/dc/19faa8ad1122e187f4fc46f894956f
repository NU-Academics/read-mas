{"task_id": "Mbpp/740", "solution": "```python\ndef _validate_input_is_tuple(input_tuple):\n    \"\"\"\n    Validates if the input is a tuple.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\ndef _validate_even_length(input_tuple):\n    \"\"\"\n    Validates if the tuple has an even number of elements.\n    Raises ValueError if the tuple's length is odd.\n    \"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Tuple must have an even number of elements.\")\n\ndef tuple_to_dict(input_tuple):\n    \"\"\"\n    Converts an even-length tuple into a dictionary using adjacent elements as key:value pairs.\n    Raises TypeError for non-tuple inputs and ValueError for odd-length tuples.\n    \"\"\"\n    _validate_input_is_tuple(input_tuple)\n    _validate_even_length(input_tuple)\n\n    result_dict = {}\n    # Iterate over the tuple in steps of two to form key-value pairs.\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n\n    return result_dict\n```"}
{"task_id": "Mbpp/739", "solution": "```python\n# src/triangular_index_finder/input_validator.py\n\nclass InputValidator:\n    \"\"\"\n    Validates input 'n' for the find_Index function.\n    Ensures 'n' is an integer and is greater than or equal to 1.\n    \"\"\"\n    def validate(self, n) -> bool:\n        \"\"\"\n        Validates the input 'n'. Raises ValueError if invalid.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n        return True\n\n```\n```python\n# src/triangular_index_finder/triangular_number.py\n\nclass TriangularNumber:\n    \"\"\"\n    Computes the i-th triangular number.\n    Uses Python integer arithmetic for all calculations.\n    \"\"\"\n    def __init__(self, i: int):\n        \"\"\"Initializes with the index i for which to compute the triangular number.\"\"\"\n        self._i = i\n\n    def compute(self) -> int:\n        \"\"\"\n        Computes T(i) = i * (i + 1) // 2.\n        Returns the calculated triangular number.\n        \"\"\"\n        return self._i * (self._i + 1) // 2\n\n```\n```python\n# src/triangular_index_finder/digit_counter.py\n\nclass DigitCounter:\n    \"\"\"\n    Counts the number of decimal digits in an integer.\n    Handles positive integers, using string conversion.\n    \"\"\"\n    def count(self, value: int) -> int:\n        \"\"\"\n        Counts the decimal digits of the given integer value.\n        Converts the integer to a string to determine its length.\n        \"\"\"\n        return len(str(value))\n\n```\n```python\n# src/triangular_index_finder/index_finder.py\n\nfrom .triangular_number import TriangularNumber\nfrom .input_validator import InputValidator\nfrom .digit_counter import DigitCounter\n\nclass IndexFinder:\n    \"\"\"\n    Orchestrates finding the smallest index i for a triangular number T(i)\n    that has exactly 'n' decimal digits.\n    Composes InputValidator, TriangularNumber, and DigitCounter.\n    \"\"\"\n    def __init__(self):\n        \"\"\"\n        Initializes IndexFinder by creating instances of its helper components.\n        These components handle validation, triangular computation, and digit counting.\n        \"\"\"\n        self._input_validator = InputValidator()\n        self._digit_counter = DigitCounter()\n\n    def find_Index(self, n: int) -> int:\n        \"\"\"\n        Finds the smallest positive index i such that T(i) has exactly n digits.\n        Validates input, then iterates i from 1, computing and counting digits.\n        \"\"\"\n        self._input_validator.validate(n)\n\n        i = 1\n        while True:\n            triangular_calculator = TriangularNumber(i)\n            triangular_value = triangular_calculator.compute()\n            \n            num_digits = self._digit_counter.count(triangular_value)\n            \n            if num_digits == n:\n                return i\n            i += 1\n\n# Module-level wrapper function for the public API\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Public API function to find the index of the smallest triangular number\n    with 'n' digits. Delegates to the IndexFinder class for implementation.\n    \"\"\"\n    finder = IndexFinder()\n    return finder.find_Index(n)\n\n```\n```python\n# src/triangular_index_finder/__init__.py\n\nfrom .index_finder import find_Index\n\n__all__ = ['find_Index']\n\n```\n```python\n# tests/test_find_index.py\n\nimport sys\nimport os\n\n# Add the src directory to the Python path to allow importing the package\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))\n\nfrom triangular_index_finder import find_Index\n\nclass TestCase:\n    \"\"\"\n    Test case for the find_Index function.\n    Contains methods to run specific assertions.\n    \"\"\"\n    def __init__(self, name: str = 'find_index_test'):\n        \"\"\"Initializes the test case with a name.\"\"\"\n        self.name = name\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the main assertion for the find_Index function.\n        Returns True if all assertions pass, False otherwise.\n        \"\"\"\n        print(f\"Running test: {self.name}\")\n        try:\n            # Test case: find_Index(2) should return 4\n            result = find_Index(2)\n            expected = 4\n            assert result == expected, f\"Test failed: find_Index(2) returned {result}, expected {expected}\"\n            print(f\"Test passed: find_Index(2) == {result}\")\n\n            # Additional test cases (optional, but good for robustness)\n            # T(1)=1 (1 digit)\n            assert find_Index(1) == 1, f\"Test failed: find_Index(1) returned {find_Index(1)}, expected 1\"\n            print(f\"Test passed: find_Index(1) == {find_Index(1)}\")\n            \n            # T(4)=10 (2 digits) - already covered by assert find_Index(2) == 4\n            # T(13)=91 (2 digits)\n            # T(14)=105 (3 digits)\n            assert find_Index(3) == 14, f\"Test failed: find_Index(3) returned {find_Index(3)}, expected 14\"\n            print(f\"Test passed: find_Index(3) == {find_Index(3)}\")\n\n            # Test invalid inputs\n            try:\n                find_Index(0)\n                assert False, \"Test failed: find_Index(0) should raise ValueError\"\n            except ValueError as e:\n                assert \"n must be a positive integer\" in str(e), f\"Test failed: Expected specific ValueError message for 0, got {e}\"\n                print(\"Test passed: find_Index(0) correctly raised ValueError.\")\n            \n            try:\n                find_Index(-1)\n                assert False, \"Test failed: find_Index(-1) should raise ValueError\"\n            except ValueError as e:\n                assert \"n must be a positive integer\" in str(e), f\"Test failed: Expected specific ValueError message for -1, got {e}\"\n                print(\"Test passed: find_Index(-1) correctly raised ValueError.\")\n\n            try:\n                find_Index(3.5)\n                assert False, \"Test failed: find_Index(3.5) should raise ValueError\"\n            except ValueError as e:\n                assert \"n must be an integer\" in str(e), f\"Test failed: Expected specific ValueError message for float, got {e}\"\n                print(\"Test passed: find_Index(3.5) correctly raised ValueError.\")\n\n            print(f\"All assertions for {self.name} passed.\")\n            return True\n        except AssertionError as e:\n            print(f\"--- Test FAILED: {e} ---\")\n            return False\n        except Exception as e:\n            print(f\"--- An unexpected error occurred during test {self.name}: {e} ---\")\n            return False\n\nif __name__ == \"__main__\":\n    test_suite = TestCase()\n    if not test_suite.run():\n        sys.exit(1)\n\n```"}
{"task_id": "Mbpp/739", "solution": "```python\n# src/triangular/__init__.py\nfrom .api import find_Index\n\n# src/triangular/api.py\nfrom .calculator import TriangularNumberCalculator\n\ndef find_Index(n: int) -> int:\n    \"\"\"Public API that delegates to TriangularNumberCalculator.find_Index(n).\"\"\"\n    return TriangularNumberCalculator().find_Index(n)\n\n# src/triangular/calculator.py\nfrom .validator import InputValidator\nfrom .triangular_number import TriangularNumber\n\nclass TriangularNumberCalculator:\n    \"\"\"Orchestrates validation and computation to find minimal k such that T_k has n digits.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def find_Index(self, n: int) -> int:\n        \"\"\"Validates n, finds and returns minimal k for an n-digit triangular number.\"\"\"\n        self._validator.validate_positive_integer(n)\n\n        k = 1\n        while True:\n            tn_instance = TriangularNumber(k)\n            tn_instance.compute()\n            if tn_instance.digits == n:\n                return k\n            k += 1\n\n    def compute_triangular(self, k: int) -> int:\n        \"\"\"Computes the k-th triangular number T_k = k*(k+1)//2.\"\"\"\n        return k * (k + 1) // 2\n\n    def count_digits(self, value: int) -> int:\n        \"\"\"Returns the number of decimal digits in abs(value).\"\"\"\n        return 1 if value == 0 else len(str(abs(value)))\n\n# src/triangular/validator.py\nclass InputValidator:\n    \"\"\"InputValidator validates that n is a positive integer.\"\"\"\n    def validate_positive_integer(self, n: int) -> None:\n        \"\"\"Raises ValueError if n is not a positive integer.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer\")\n\n# src/triangular/triangular_number.py\nclass TriangularNumber:\n    \"\"\"Domain model representing a triangular number for a given k; compute value and digit count.\"\"\"\n    def __init__(self, k: int):\n        self._k = k\n        self._value = 0\n        self._digits = 0\n\n    def compute(self) -> None:\n        \"\"\"Computes the triangular number T_k and its decimal digit count.\"\"\"\n        self._value = self._k * (self._k + 1) // 2\n        self._digits = 1 if self._value == 0 else len(str(abs(self._value)))\n\n    @property\n    def value(self) -> int:\n        \"\"\"Returns the computed triangular number value.\"\"\"\n        return self._value\n\n    @property\n    def digits(self) -> int:\n        \"\"\"Returns the computed number of decimal digits.\"\"\"\n        return self._digits\n\n# tests/test_suite.py\nimport sys\nimport os\n\n# Add src/triangular to sys.path to allow imports when running tests directly.\ncurrent_dir = os.path.dirname(__file__)\nproject_root = os.path.abspath(os.path.join(current_dir, '..'))\nif project_root not in sys.path:\n    sys.path.insert(0, project_root)\n\nfrom src.triangular import find_Index\n\nclass TestSuite:\n    \"\"\"TestSuite verifies functional requirements by running assertions.\"\"\"\n    def run_tests(self) -> None:\n        \"\"\"Executes assertions; raises AssertionError or lets exceptions propagate if failures occur.\"\"\"\n        print(\"Running tests...\")\n\n        # Functional Requirement: assert find_Index(2) == 4\n        try:\n            result = find_Index(2)\n            assert result == 4, f\"find_Index(2) expected 4, got {result}\"\n            print(f\"Test find_Index(2): PASSED (result: {result})\")\n        except AssertionError as e:\n            print(f\"Test find_Index(2): FAILED - {e}\")\n        except Exception as e:\n            print(f\"Test find_Index(2): ERROR - {e}\")\n        \n        # Input Validation: raise ValueError if n is not a positive integer.\n        print(\"\\nTesting input validation (invalid inputs):\")\n        invalid_inputs = [-1, 0, 1.5, \"2\", None]\n        for invalid_n in invalid_inputs:\n            try:\n                find_Index(invalid_n)\n                print(f\"Test invalid input find_Index({repr(invalid_n)}): FAILED (did not raise ValueError)\")\n            except ValueError as e:\n                print(f\"Test invalid input find_Index({repr(invalid_n)}): PASSED (raised ValueError: {e})\")\n            except Exception as e:\n                print(f\"Test invalid input find_Index({repr(invalid_n)}): FAILED (raised unexpected error: {e})\")\n\n        print(\"\\nAll specified tests completed.\")\n\nif __name__ == '__main__':\n    TestSuite().run_tests()\n```"}
