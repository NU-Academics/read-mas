{"task_id": "Mbpp/437", "solution": "To implement the design while adhering to the critical requirements, the code will be structured into two files: `src/domain.py` and `src/remove_odd.py`. The `tests/test_remove_odd.py` file will not be generated as per the \"FORBIDDEN: DO NOT write unit tests\" critical requirement. Type validation and error raising will also be omitted from `remove_odd` as per \"FORBIDDEN: Do NOT add isinstance() checks, type guards, or raise exceptions\".\n\n**File: `src/domain.py`**\n```python\nfrom dataclasses import dataclass\nfrom typing import Iterator\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the input string with its value and length.\"\"\"\n    value: str\n    length: int\n\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def __iter__(self) -> Iterator['Character']:\n        \"\"\"Iterates over the input string, yielding Character objects with their 0-based index.\"\"\"\n        for i, char_value in enumerate(self.value):\n            yield Character(value=char_value, index=i)\n\n@dataclass\nclass Character:\n    \"\"\"Represents a single character from the input string with its original index.\"\"\"\n    value: str  # single-character string\n    index: int\n\n@dataclass\nclass OutputString:\n    \"\"\"Represents the resulting output string.\"\"\"\n    value: str\n\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass RemoveOddFunction:\n    \"\"\"\n    Implements the core logic for selecting characters at odd 0-based indices.\n    This class is stateless and performs the selection operation.\n    \"\"\"\n    def remove_odd(self, input_str: str) -> str:\n        \"\"\"\n        Selects characters from the input string located at odd 0-based indices (1,3,5,...).\n        Preserves original relative order and returns an empty string for empty input.\n        \"\"\"\n        input_obj = InputString(value=input_str)\n        collected_chars = []\n\n        for char_obj in input_obj:\n            if char_obj.index % 2 == 1:\n                collected_chars.append(char_obj.value)\n        \n        result_str = \"\".join(collected_chars)\n        output_obj = OutputString(value=result_str)\n        return output_obj.value\n\nclass TestCase:\n    \"\"\"\n    Represents a test case with an input string and its expected output.\n    Used for representing test scenarios and invoking the public API.\n    \"\"\"\n    input: str\n    expectedOutput: str\n\n    def __init__(self, input_val: str, expected_output_val: str) -> None:\n        self.input = input_val\n        self.expectedOutput = expected_output_val\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the test case by invoking the public `remove_odd` function.\n        Returns True if the actual output matches the expected output.\n        \"\"\"\n        # Local import to avoid circular dependency in a package structure.\n        from .remove_odd import remove_odd\n        actual_output = remove_odd(self.input)\n        return actual_output == self.expectedOutput\n\n```\n\n**File: `src/remove_odd.py`**\n```python\nfrom .domain import RemoveOddFunction\n\ndef remove_odd(input: str) -> str:\n    \"\"\"\n    Public API function to remove characters from a string at even 0-based indices.\n    Delegates the core logic to the RemoveOddFunction class.\n    \"\"\"\n    # Input type validation and error handling are excluded as per critical requirements.\n    # The function trusts the caller's input type.\n    return RemoveOddFunction().remove_odd(input)\n```"}
{"task_id": "Mbpp/439", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker for src; exports the public API symbol multiple_to_single.\"\"\"\nfrom .multiple_to_single import multiple_to_single\n```\n```python\n# src/multiple_to_single.py\n\"\"\"\nImplements multiple_to_single function per design spec. Handles input validation, negative numbers, and empty lists.\nInput must be a list of integers, negative integers preserve their '-' sign; empty list raises ValidationError.\n\"\"\"\n\nfrom typing import List\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for input validation failures.\n    Contains a message describing the validation failure reason.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass DecimalRepresentation:\n    \"\"\"\n    Holds the decimal digit string produced from an IntegerItem.\n    The digits attribute stores the string representation.\n    \"\"\"\n    def __init__(self, digits: str) -> None:\n        self.digits = digits\n\nclass IntegerItem:\n    \"\"\"\n    Holds a single integer value and provides its decimal string representation.\n    to_decimal_string converts the integer to its base-10 string.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_decimal_string(self) -> DecimalRepresentation:\n        \"\"\"Returns the base-10 decimal representation of the integer as a DecimalRepresentation object.\"\"\"\n        return DecimalRepresentation(str(self.value))\n\nclass IntegerList:\n    \"\"\"\n    A conceptual container for a list of IntegerItem objects.\n    This class is primarily for design modeling, holding items.\n    \"\"\"\n    def __init__(self, items: List[IntegerItem]) -> None:\n        self.items = items\n\nclass ConcatenatedResult:\n    \"\"\"\n    Holds the final integer value produced by concatenating decimal strings.\n    The value attribute stores the final integer.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass MultipleToSingleFunction:\n    \"\"\"\n    Orchestrates validation, per-item conversion, concatenation, and final integer conversion.\n    This class implements the core logic for the multiple_to_single operation.\n    \"\"\"\n    def multiple_to_single(self, integers: List[int]) -> int:\n        \"\"\"\n        Orchestrates the process of concatenating integer decimal representations.\n        Validates input, converts to strings, concatenates, and converts to int.\n        \"\"\"\n        self._validate_input(integers)\n        concatenated_string = self._concatenate_digits(integers)\n        result_value = int(concatenated_string)\n        return ConcatenatedResult(result_value).value\n\n    def _validate_input(self, integers: List[int]) -> None:\n        \"\"\"\n        Validates that the input is a list of integers and is not empty.\n        Raises ValidationError for invalid input types or an empty list.\n        \"\"\"\n        if not isinstance(integers, list):\n            raise ValidationError(\"Input must be a list.\")\n        if not integers:\n            raise ValidationError(\"Input list cannot be empty.\")\n        for item in integers:\n            if not isinstance(item, int):\n                raise ValidationError(\"All elements in the list must be integers.\")\n\n    def _concatenate_digits(self, integers: List[int]) -> str:\n        \"\"\"\n        Converts each integer to its decimal string representation and concatenates them.\n        Uses IntegerItem to perform the individual integer to string conversion.\n        \"\"\"\n        decimal_representations: List[str] = []\n        for integer_value in integers:\n            integer_item = IntegerItem(integer_value)\n            decimal_rep = integer_item.to_decimal_string()\n            decimal_representations.append(decimal_rep.digits)\n        return \"\".join(decimal_representations)\n\ndef multiple_to_single(integers: List[int]) -> int:\n    \"\"\"\n    Accepts a list of integers and returns a single integer equal to their decimal concatenation.\n    It validates input and handles specific edge cases like negative numbers.\n    \"\"\"\n    return MultipleToSingleFunction().multiple_to_single(integers)\n```\n```python\n# tests/test_multiple_to_single.py\nimport pytest\nfrom src.multiple_to_single import multiple_to_single, ValidationError\n\ndef test_multiple_to_single_example():\n    \"\"\"Verifies the core acceptance example as specified in the SRS.\"\"\"\n    assert multiple_to_single([11, 33, 50]) == 113350\n    assert multiple_to_single([-1, 2, -3]) == -12-3 # Tests negative number preservation.\n    assert multiple_to_single([0, 0, 0]) == 0 # Tests zero values.\n    assert multiple_to_single([100, 20, 0]) == 100200 # Tests combination of values.\n\ndef test_multiple_to_single_invalid_input():\n    \"\"\"Ensures non-list input raises a ValidationError as per BR2.\"\"\"\n    with pytest.raises(ValidationError, match=\"Input must be a list.\"):\n        multiple_to_single(123)\n    with pytest.raises(ValidationError, match=\"Input must be a list.\"):\n        multiple_to_single(\"not_a_list\")\n    with pytest.raises(ValidationError, match=\"Input must be a list.\"):\n        multiple_to_single({\"a\": 1})\n\ndef test_multiple_to_single_non_integer_element():\n    \"\"\"Ensures lists containing non-integer elements raise a ValidationError as per BR2.\"\"\"\n    with pytest.raises(ValidationError, match=\"All elements in the list must be integers.\"):\n        multiple_to_single([1, 2, \"three\"])\n    with pytest.raises(ValidationError, match=\"All elements in the list must be integers.\"):\n        multiple_to_single([1, 2, 3.0])\n    with pytest.raises(ValidationError, match=\"All elements in the list must be integers.\"):\n        multiple_to_single([1, None, 3])\n\ndef test_multiple_to_single_empty_list():\n    \"\"\"Ensures that an empty list input raises a ValidationError as per documented design choice.\"\"\"\n    with pytest.raises(ValidationError, match=\"Input list cannot be empty.\"):\n        multiple_to_single([])\n\n```"}
{"task_id": "Mbpp/439", "solution": "```python\nfrom typing import List, Iterator\n\nclass IntegerElement:\n    \"\"\"Represents a single integer element for concatenation.\n    It can return its base-10 string representation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_base10_string(self) -> str:\n        \"\"\"Returns the base-10 string representation of the integer value.\"\"\"\n        return str(self.value)\n\nclass IntegerList:\n    \"\"\"Encapsulates a list of integers, providing validation and iteration over elements.\n    It ensures the input is a list and contains only integers.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a list of integers, raising TypeError if invalid.\"\"\"\n        if not isinstance(self._elements, list):\n            raise TypeError(\"Input must be a list.\")\n        for element in self._elements:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def iter_elements(self) -> Iterator[IntegerElement]:\n        \"\"\"Yields IntegerElement instances for each element in the list.\"\"\"\n        for element in self._elements:\n            yield IntegerElement(element)\n\nclass ConcatenatedInteger:\n    \"\"\"Constructs and holds a single integer from concatenated string representations.\n    It provides a class method to build itself from a list of strings.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    @classmethod\n    def from_strings(cls, strings: List[str]) -> 'ConcatenatedInteger':\n        \"\"\"Concatenates string representations and converts the result to an integer.\"\"\"\n        concatenated_string = \"\".join(strings)\n        return cls(int(concatenated_string))\n\n    def as_int(self) -> int:\n        \"\"\"Returns the stored concatenated integer value.\"\"\"\n        return self._value\n\ndef multiple_to_single(list_of_integers: List[int]) -> int:\n    \"\"\"\n    Concatenates base-10 representations of a list of integers into a single integer.\n    Validates input type and element types, raising TypeError for invalid inputs.\n    \"\"\"\n    integer_list = IntegerList(list_of_integers)\n    integer_list.validate()\n\n    string_elements: List[str] = []\n    for element in integer_list.iter_elements():\n        string_elements.append(element.to_base10_string())\n\n    concatenated_integer = ConcatenatedInteger.from_strings(string_elements)\n    return concatenated_integer.as_int()\n```"}
{"task_id": "Mbpp/440", "solution": "```python\n# src/models.py\nfrom typing import Optional\n\nclass Sentence:\n    \"\"\"Represents the original sentence text.\"\"\"\n    def __init__(self, text: str, id: Optional[int] = None):\n        self.text = text\n        self.id = id\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sentence text.\"\"\"\n        return len(self.text)\n\nclass Token:\n    \"\"\"Represents a token from the sentence, with original and cleaned text and indices.\"\"\"\n    def __init__(self, raw_text: str, clean_text: str, start_index: int, end_index: int, pos_tag: Optional[str] = None):\n        self.rawText = raw_text\n        self.cleanText = clean_text\n        self.startIndex = start_index\n        self.endIndex = end_index\n        self.posTag = pos_tag\n\n    def is_punctuation(self) -> bool:\n        \"\"\"Checks if the token consists solely of punctuation characters.\"\"\"\n        punctuation_chars = \"!\\\"#$%&'()*+,-./:;<=>?@[\\\\]^_`{|}~\"\n        return all(char in punctuation_chars for char in self.rawText)\n\nclass Result:\n    \"\"\"Encapsulates the findings for the first adverb.\"\"\"\n    def __init__(self, start_index: int, end_index: int, adverb: str):\n        self.startIndex = start_index\n        self.endIndex = end_index\n        self.adverb = adverb\n\n```\n```python\n# src/tokenizer.py\nfrom typing import List, Optional\nfrom src.models import Sentence, Token\n\n_PUNCTUATION_CHARS = \"!\\\"#$%&'()*+,-./:;<=>?@[\\\\]^_`{|}~\"\n\ndef _is_punctuation(char: str) -> bool:\n    \"\"\"Determines if a character is a punctuation mark.\"\"\"\n    return char in _PUNCTUATION_CHARS\n\nclass Tokenizer:\n    \"\"\"Breaks down a sentence into a list of Token objects, preserving indices.\"\"\"\n    def tokenize(self, sentence: Sentence) -> List[Token]:\n        \"\"\"Tokenizes the given sentence, computing raw text, clean text, and original indices.\"\"\"\n        tokens: List[Token] = []\n        text = sentence.text\n        length = len(text)\n        current_char_index = 0\n\n        while current_char_index < length:\n            # Skip leading whitespace\n            while current_char_index < length and text[current_char_index].isspace():\n                current_char_index += 1\n            if current_char_index >= length:\n                break\n\n            word_start_in_sentence = current_char_index\n            \n            # Find the end of the current word/punctuation block\n            word_end_in_sentence = current_char_index\n            while word_end_in_sentence < length and not text[word_end_in_sentence].isspace():\n                word_end_in_sentence += 1\n\n            raw_text = text[word_start_in_sentence:word_end_in_sentence]\n\n            # Calculate cleanText and its start/end indices relative to the sentence\n            clean_text_start_offset_in_raw = 0\n            while clean_text_start_offset_in_raw < len(raw_text) and \\\n                  _is_punctuation(raw_text[clean_text_start_offset_in_raw]):\n                clean_text_start_offset_in_raw += 1\n\n            clean_text_end_offset_in_raw = len(raw_text)\n            while clean_text_end_offset_in_raw > clean_text_start_offset_in_raw and \\\n                  _is_punctuation(raw_text[clean_text_end_offset_in_raw - 1]):\n                clean_text_end_offset_in_raw -= 1\n            \n            clean_text = raw_text[clean_text_start_offset_in_raw:clean_text_end_offset_in_raw]\n            \n            token_clean_start_index = word_start_in_sentence + clean_text_start_offset_in_raw\n            token_clean_end_index = word_start_in_sentence + clean_text_end_offset_in_raw\n\n            if not clean_text:\n                # If after stripping punctuation, the token is empty (e.g., \"!!!\"), skip it.\n                current_char_index = word_end_in_sentence\n                continue\n\n            tokens.append(Token(\n                raw_text=raw_text,\n                clean_text=clean_text,\n                startIndex=token_clean_start_index,\n                endIndex=token_clean_end_index\n            ))\n            \n            current_char_index = word_end_in_sentence\n        return tokens\n\n```\n```python\n# src/pos_tagger.py\nfrom typing import List\nfrom src.models import Token\n\nclass POSTagger:\n    \"\"\"Assigns Part-Of-Speech tags to tokens using standard-English rule-based detection.\"\"\"\n    \n    # A simplified set of rules for adverbs, case-insensitive.\n    _ADVERB_SUFFIX = \"ly\"\n    _COMMON_ADVERBS = {\"very\", \"well\", \"always\", \"often\", \"never\", \"soon\", \"late\", \"fast\", \"hard\"}\n\n    def tag(self, tokens: List[Token]) -> List[Token]:\n        \"\"\"Tags each token with a POS tag, focusing on case-insensitive adverb detection.\"\"\"\n        for token in tokens:\n            clean_text_lower = token.cleanText.lower()\n            if (clean_text_lower.endswith(self._ADVERB_SUFFIX) and len(clean_text_lower) > len(self._ADVERB_SUFFIX)) or \\\n               (clean_text_lower in self._COMMON_ADVERBS):\n                token.posTag = \"RB\"  # Standard tag for adverb\n            else:\n                token.posTag = None\n        return tokens\n\n    def uses_standard_english_rules(self) -> bool:\n        \"\"\"Indicates that this tagger uses simplified standard English rules for POS tagging.\"\"\"\n        return True\n\n```\n```python\n# src/adverb_finder.py\nfrom typing import List, Optional\nfrom src.models import Token, Result\n\nclass AdverbFinder:\n    \"\"\"Locates the first (leftmost) adverb token and creates a Result object.\"\"\"\n    def findFirstAdverb(self, tokens: List[Token]) -> Optional[Result]:\n        \"\"\"Scans tagged tokens for the first adverb and returns its details.\"\"\"\n        for token in tokens:\n            if token.posTag == \"RB\": # 'RB' is the tag we assigned for adverbs\n                return Result(startIndex=token.startIndex, endIndex=token.endIndex, adverb=token.cleanText)\n        return None\n\n```\n```python\n# src/adverb_position.py\nfrom typing import Optional, Tuple\nfrom src.models import Sentence\nfrom src.tokenizer import Tokenizer, _is_punctuation\nfrom src.pos_tagger import POSTagger\nfrom src.adverb_finder import AdverbFinder\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Identifies the first (leftmost) adverb in an English sentence.\n    Returns (start_index, end_index, adverb) or None if no adverb is found.\n    \"\"\"\n    # BR9: Input precondition validation\n    if not isinstance(sentence, str):\n        return None\n    if not sentence: # Empty string\n        return None\n\n    # Check for punctuation-only or whitespace-only input\n    is_only_punctuation_or_whitespace = True\n    for char in sentence:\n        if not char.isspace() and not _is_punctuation(char):\n            is_only_punctuation_or_whitespace = False\n            break\n    if is_only_punctuation_or_whitespace:\n        return None\n\n    sentence_obj = Sentence(text=sentence)\n    \n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(sentence_obj)\n    \n    # BR11: Safe failure mode for tokenization errors (e.g., if tokenize returns empty list for valid input)\n    if not tokens:\n        return None\n\n    tagger = POSTagger()\n    tagged_tokens = tagger.tag(tokens)\n    \n    finder = AdverbFinder()\n    result = finder.findFirstAdverb(tagged_tokens)\n    \n    if result is not None:\n        return (result.startIndex, result.endIndex, result.adverb)\n    else:\n        return None\n\n```\n```python\n# src/__init__.py\nfrom .adverb_position import find_adverb_position\n\n```"}
{"task_id": "Mbpp/440", "solution": "from typing import List, Optional, Tuple, Set\nimport re\n\nclass Result:\n    \"\"\"Immutable data holder for API return.\"\"\"\n    def __init__(self, start_index: int, end_index: int, adverb_text: str) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.adverb_text = adverb_text\n\n    def to_tuple(self) -> Tuple[int, int, str]:\n        \"\"\"Converts Result dataclass to the required return tuple.\"\"\"\n        return (self.start_index, self.end_index, self.adverb_text)\n\nclass Word:\n    \"\"\"Represents a token with its text and original span.\"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int) -> None:\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass Sentence:\n    \"\"\"Holds original text for tokenization.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\nclass Tokenizer:\n    \"\"\"Tokenizes input sentence into Word objects preserving original offsets.\"\"\"\n    def tokenize(self, sentence: Sentence) -> List[Word]:\n        \"\"\"Splits sentence text into Word objects, recording start and end indices.\"\"\"\n        words: List[Word] = []\n        for match in re.finditer(r'\\S+', sentence.text):\n            text = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            words.append(Word(text, start_index, end_index))\n        return words\n\nclass PunctuationStripper:\n    \"\"\"Removes trailing punctuation and computes corrected exclusive end offset.\"\"\"\n    DEFAULT_PUNCTUATION_CHARS = {'.', ',', '!', '?', ';', ':', '\"', \"'\", ')', ']', '}', '(', '[', '{'}\n\n    def __init__(self, punctuation_chars: Optional[Set[str]] = None) -> None:\n        \"\"\"Initializes with a set of punctuation characters, using default if none provided.\"\"\"\n        self.punctuation_chars = punctuation_chars if punctuation_chars is not None else self.DEFAULT_PUNCTUATION_CHARS\n\n    def strip(self, word: Word, original_sentence_text: str) -> Tuple[str, int]:\n        \"\"\"Strips trailing punctuation from a word and returns corrected text and end index.\"\"\"\n        corrected_end_index = word.end_index\n        \n        for i in range(word.end_index - 1, word.start_index - 1, -1):\n            if original_sentence_text[i] in self.punctuation_chars:\n                corrected_end_index = i\n            else:\n                break\n        \n        stripped_text = original_sentence_text[word.start_index:corrected_end_index]\n        return stripped_text, corrected_end_index\n\nclass AdverbFinder:\n    \"\"\"Orchestrates tokenization, punctuation stripping, and adverb detection.\"\"\"\n    ADVERB_LEXICON = {\n        \"clearly\", \"quickly\", \"slowly\", \"very\", \"really\", \"always\",\n        \"never\", \"often\", \"seldom\", \"sometimes\", \"usually\", \"rarely\",\n        \"already\", \"soon\", \"today\", \"yesterday\", \"tomorrow\", \"now\",\n        \"here\", \"there\", \"everywhere\", \"anywhere\", \"nowhere\",\n        \"well\", \"badly\", \"hard\", \"softly\", \"loudly\", \"happily\", \"sadly\"\n    }\n\n    def __init__(self, tokenizer: Optional[Tokenizer] = None, stripper: Optional[PunctuationStripper] = None) -> None:\n        \"\"\"Initializes AdverbFinder with optional tokenizer and stripper instances.\"\"\"\n        self.tokenizer = tokenizer if tokenizer is not None else Tokenizer()\n        self.stripper = stripper if stripper is not None else PunctuationStripper()\n\n    def _is_adverb(self, text: str) -> bool:\n        \"\"\"Determines if the given text is an adverb using a simple lexicon lookup.\"\"\"\n        return text.lower() in self.ADVERB_LEXICON\n\n    def find_adverb_position(self, sentence_str: str) -> Optional[Tuple[int, int, str]]:\n        \"\"\"Locates the first adverb and returns its span and text, or None.\"\"\"\n        sentence_obj = Sentence(sentence_str)\n        words = self.tokenizer.tokenize(sentence_obj)\n\n        for word in words:\n            stripped_text, corrected_end_index = self.stripper.strip(word, sentence_str)\n            \n            if self._is_adverb(stripped_text):\n                result = Result(word.start_index, corrected_end_index, stripped_text)\n                return result.to_tuple()\n        \n        return None\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Given an input sentence string, returns the tuple (start_index, end_index, adverb_text)\n    referencing the original string with trailing punctuation excluded, or None if no adverb is found.\n    \"\"\"\n    finder = AdverbFinder()\n    return finder.find_adverb_position(sentence)"}
