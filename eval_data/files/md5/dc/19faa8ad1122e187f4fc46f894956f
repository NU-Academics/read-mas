{"task_id": "Mbpp/732", "solution": "```python\nfrom typing import List\n\nclass InputString:\n    \"\"\"A simple data wrapper for input strings.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass OutputString:\n    \"\"\"A simple data wrapper for output strings.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass ReplacementRule:\n    \"\"\"Defines a mapping from a target character to its replacement.\"\"\"\n    def __init__(self, target: str, replacement: str):\n        self.target = target\n        self.replacement = replacement\n\nclass ReplacementEngine:\n    \"\"\"Applies a set of replacement rules to an input string.\"\"\"\n    def __init__(self, rules: List[ReplacementRule]):\n        # Create a dictionary for efficient lookup of replacement rules.\n        self._rule_map = {rule.target: rule.replacement for rule in rules}\n\n    def applyRules(self, input_str: str) -> str:\n        \"\"\"Transforms the input string based on defined replacement rules.\"\"\"\n        result_chars = []\n        for char in input_str:\n            result_chars.append(self._rule_map.get(char, char))\n        return \"\".join(result_chars)\n\n# Fixed replacement rules for spaces, commas, and periods/dots to colons.\n_REPLACEMENT_RULES = [\n    ReplacementRule(' ', ':'),\n    ReplacementRule(',', ':'),\n    ReplacementRule('.', ':')\n]\n\n# Instantiate the ReplacementEngine once for consistent rule application.\n_ENGINE = ReplacementEngine(_REPLACEMENT_RULES)\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots in the input string with a colon.\n    This function serves as the public API entry point.\n    \"\"\"\n    # Wrap the input string as an InputString object as per design.\n    input_obj = InputString(input)\n    # Apply the defined replacement rules using the engine.\n    transformed_value = _ENGINE.applyRules(input_obj.value)\n    # Wrap the transformed string as an OutputString object and return its value.\n    output_obj = OutputString(transformed_value)\n    return output_obj.value\n```"}
{"task_id": "Mbpp/733", "solution": "```python\n# file: src/find_first_occurrence.py\n\"\"\"\nCore function to find the first occurrence and its supporting domain classes.\nThis module provides the main search logic as well as Array and SearchResult classes.\n\"\"\"\n\nclass Array:\n    \"\"\"\n    A wrapper class for a list of integers, providing utility methods.\n    Assumes elements are integers for this specific context.\n    \"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = elements\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"\n        Checks if the array is sorted in non-decreasing order.\n        This is an informational check; input arrays are assumed sorted per FR2.\n        \"\"\"\n        for i in range(self.length - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\n\nclass SearchResult:\n    \"\"\"\n    Represents the result of a search operation.\n    It contains the found index and a boolean indicating if the target was found.\n    \"\"\"\n    def __init__(self, index: int):\n        self.index = index\n        self.found = (index != -1)\n\ndef find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the zero-based index of the first (leftmost) occurrence of the target in a sorted array.\n    Returns -1 if the target is not present.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Move left to find the first occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n\n    return result\n\n```\n\n```python\n# file: src/main.py\n\"\"\"\nEntry point for demonstration, running the example test case.\nThis script demonstrates how to call the find_first_occurrence function.\n\"\"\"\n\n# The import assumes find_first_occurrence.py is directly importable,\n# e.g., if 'src' is treated as a package or if PYTHONPATH is set.\nfrom find_first_occurrence import find_first_occurrence\n\ndef main() -> None:\n    \"\"\"\n    Runs the example test case as specified in FR5.\n    Asserts that the function returns the expected index.\n    \"\"\"\n    arr = [2, 5, 5, 5, 6, 6, 8, 9, 9, 9]\n    target = 5\n    expected_result = 1\n\n    print(f\"Running example: find_first_occurrence({arr}, {target})\")\n    actual_result = find_first_occurrence(arr, target)\n\n    assert actual_result == expected_result, \\\n        f\"Test failed: Expected {expected_result}, got {actual_result}\"\n\n    print(f\"Example passed: find_first_occurrence({arr}, {target}) == {actual_result}\")\n\nif __name__ == '__main__':\n    main()\n\n```\n\n```python\n# file: tests/test_find_first_occurrence.py\n\"\"\"\nTest harness for verifying the find_first_occurrence function.\nContains TestCase class and functions to run all acceptance tests.\n\"\"\"\n\n# The import assumes find_first_occurrence.py is directly importable,\n# e.g., if 'src' is treated as a package or if PYTHONPATH is set.\nfrom find_first_occurrence import find_first_occurrence\n\nclass TestCase:\n    \"\"\"\n    Represents a single test case for the find_first_occurrence function.\n    Stores input array, target, and the expected result.\n    \"\"\"\n    def __init__(self, arr: list[int], target: int, expected: int, description: str = \"\"):\n        self.arr = arr\n        self.target = target\n        self.expected = expected\n        self.description = description\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the test case by calling find_first_occurrence and comparing the result.\n        Returns True if the actual result matches the expected result.\n        \"\"\"\n        actual_result = find_first_occurrence(self.arr, self.target)\n        is_passed = (actual_result == self.expected)\n        status = \"PASSED\" if is_passed else \"FAILED\"\n        print(f\"[{status}] {self.description}: arr={self.arr}, target={self.target}, \"\n              f\"Expected={self.expected}, Got={actual_result}\")\n        return is_passed\n\ndef run_all_tests() -> None:\n    \"\"\"\n    Executes all defined test cases for find_first_occurrence.\n    Includes the specific example from FR5 and other edge cases.\n    \"\"\"\n    test_cases = [\n        TestCase([2, 5, 5, 5, 6, 6, 8, 9, 9, 9], 5, 1, \"FR5 example test\"),\n        TestCase([1, 2, 3, 4, 5], 3, 2, \"Target in middle, unique\"),\n        TestCase([1, 2, 3, 4, 5], 1, 0, \"Target is first element\"),\n        TestCase([1, 2, 3, 4, 5], 5, 4, \"Target is last element\"),\n        TestCase([1, 2, 3, 4, 5], 6, -1, \"Target not present (greater)\"),\n        TestCase([1, 2, 3, 4, 5], 0, -1, \"Target not present (smaller)\"),\n        TestCase([], 5, -1, \"Empty array\"),\n        TestCase([7], 7, 0, \"Single element array, target found\"),\n        TestCase([7], 8, -1, \"Single element array, target not found\"),\n        TestCase([5, 5, 5, 5, 5], 5, 0, \"All elements are target\"),\n        TestCase([1, 1, 2, 2, 2, 3, 3], 2, 2, \"Multiple occurrences, target in middle\"),\n        TestCase([1, 1, 1, 1, 2, 3, 4], 1, 0, \"Multiple occurrences, target at start\"),\n        TestCase([1, 2, 3, 3, 3, 3], 3, 2, \"Multiple occurrences, target towards end\"),\n    ]\n\n    print(\"Running all find_first_occurrence tests...\")\n    all_passed = True\n    for case in test_cases:\n        if not case.run():\n            all_passed = False\n    \n    if all_passed:\n        print(\"\\nAll tests passed successfully!\")\n    else:\n        print(\"\\nSome tests failed.\")\n\nif __name__ == '__main__':\n    run_all_tests()\n\n```"}
{"task_id": "Mbpp/734", "solution": "```python\n# src/sum_of_subarray_prod.py\nfrom typing import Iterator, List, Tuple\n\ndef _product_of(iterable) -> float:\n    \"\"\"Calculates the product of all numbers in the given iterable.\n    It returns 1.0 for an empty iterable, though it should not be called with one.\"\"\"\n    product = 1.0\n    for item in iterable:\n        product *= item\n    return product\n\ndef _generate_contiguous_subarrays(elements: List) -> Iterator[Tuple[int, int, List]]:\n    \"\"\"Yields contiguous non-empty subarrays with their start and end indices.\n    Subarrays are ordered by their start index, then by length.\"\"\"\n    n = len(elements)\n    for i in range(n):  # start_index\n        for j in range(i, n):  # end_index_inclusive\n            subarray = elements[i : j + 1]\n            yield (i, j, subarray)\n\ndef sum_Of_Subarray_Prod(elements: List) -> float:\n    \"\"\"Computes the sum of products of all contiguous non-empty subarrays.\n    Returns 0.0 if the input list is empty.\"\"\"\n    if not elements:\n        return 0.0\n\n    total_sum_of_products = 0.0\n    for _, _, subarray in _generate_contiguous_subarrays(elements):\n        total_sum_of_products += _product_of(subarray)\n    return total_sum_of_products\n```\n```python\n# tests/test_sum_of_subarray_prod.py\nfrom src.sum_of_subarray_prod import sum_Of_Subarray_Prod\n\ndef run_assertion_test() -> None:\n    \"\"\"Runs the required assertion test for sum_Of_Subarray_Prod.\n    This function verifies the example case provided in the design.\"\"\"\n    assert sum_Of_Subarray_Prod([1,2,3]) == 20\n    print(\"Assertion passed: sum_Of_Subarray_Prod([1,2,3]) == 20\")\n\nif __name__ == \"__main__\":\n    run_assertion_test()\n```"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the 0-based index of the leftmost occurrence of the target in a sorted array.\n    Assumes the input array is sorted non-decreasingly and achieves O(log n) time, O(1) space.\n    \"\"\"\n    left = 0\n    right = len(array) - 1\n\n    # This binary search variant finds the first position 'left' where array[left] >= target.\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n\n    # After the loop, 'left' is the insertion point. Check if it matches the target.\n    if left < len(array) and array[left] == target:\n        return left\n    else:\n        return -1"}
{"task_id": "Mbpp/735", "solution": "```python\nclass IntegerValue:\n    \"\"\"Wraps an integer and provides its bit length.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def bit_length(self) -> int:\n        \"\"\"Returns the number of bits required to represent the integer.\"\"\"\n        return self.value.bit_length()\n\n\nclass BitMask:\n    \"\"\"Builds an integer mask to target middle bits.\"\"\"\n    def __init__(self):\n        self.mask_value = 0\n\n    def build(self, n: int) -> int:\n        \"\"\"Computes a mask with 1s for middle bits and 0s for MSB and LSB.\"\"\"\n        length = n.bit_length()\n        # Create a mask of all 1s for 'length' bits.\n        all_ones_mask = (1 << length) - 1\n        # Create a mask for the MSB, and for the LSB (1).\n        msb_mask = (1 << (length - 1))\n        # Remove MSB and LSB from the all_ones_mask by XORing them out.\n        self.mask_value = all_ones_mask ^ msb_mask ^ 1\n        return self.mask_value\n\n\nclass BitOperation:\n    \"\"\"Applies bitwise XOR to flip middle bits.\"\"\"\n    def __init__(self):\n        pass\n\n    def flipMiddleBits(self, n: int, mask: int) -> int:\n        \"\"\"Performs an XOR operation between the number and the mask to toggle bits.\"\"\"\n        return n ^ mask\n\n\nclass Result:\n    \"\"\"A simple holder for the resulting integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n\nclass ToggleMiddleBitsFunction:\n    \"\"\"Orchestrates the process of toggling middle bits as per the use case.\"\"\"\n    def toggle(self, n: int) -> int:\n        \"\"\"Executes the core logic to toggle middle bits or return n unchanged.\"\"\"\n        iv = IntegerValue(n)\n        bits = iv.bit_length()\n\n        if bits < 3:  # If bit length is less than 3, return n unchanged.\n            return n\n        else:  # Otherwise, build a mask and apply the bit flip.\n            bit_mask_builder = BitMask()\n            mask = bit_mask_builder.build(n)\n            \n            bit_operator = BitOperation()\n            res_int = bit_operator.flipMiddleBits(n, mask)\n            \n            result_holder = Result(res_int)\n            return result_holder.value\n\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Public API to toggle bits of a number except the most significant and least significant bits.\"\"\"\n    # Input validation (e.g., n being a non-negative integer) is assumed per critical requirements.\n    \n    use_case_executor = ToggleMiddleBitsFunction()\n    return use_case_executor.toggle(n)\n```"}
{"task_id": "Mbpp/734", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker; re-exports public API.\"\"\"\nfrom .sum_of_subarray_prod import sum_Of_Subarray_Prod\n```\n\n```python\n# src/domain.py\nfrom typing import List, Union\n\nclass InputList:\n    \"\"\"Encapsulates the input list and provides validation.\"\"\"\n    def __init__(self, elements: List[Union[int,float]]) -> None:\n        self.elements: List[Union[int,float]] = elements\n\n    def validate(self) -> bool:\n        \"\"\"Validates if elements is a list of numbers.\"\"\"\n        if not isinstance(self.elements, list):\n            return False\n        for item in self.elements:\n            if not isinstance(item, (int, float)):\n                return False\n        return True\n\nclass Subarray:\n    \"\"\"Represents a contiguous slice of the input list.\"\"\"\n    def __init__(self, start_index: int, end_index: int, elements: List[Union[int,float]]) -> None:\n        self.start_index: int = start_index\n        self.end_index: int = end_index\n        self.elements: List[Union[int,float]] = elements\n\n    def product(self) -> Union[int,float]:\n        \"\"\"Computes the product of all elements in the subarray.\"\"\"\n        if not self.elements:\n            return 1\n        res: Union[int,float] = 1\n        for x in self.elements:\n            res *= x\n        return res\n\nclass Result:\n    \"\"\"Holds the aggregated numeric value to return.\"\"\"\n    def __init__(self, value: Union[int,float]) -> None:\n        self.value: Union[int,float] = value\n```\n\n```python\n# src/product_calculation.py\nfrom typing import List, Union\nfrom .domain import InputList, Subarray, Result\n\nclass ProductCalculation:\n    \"\"\"Generates subarrays, computes products, and aggregates the sum.\"\"\"\n    def computeAllSubarrays(self, input_list_obj: InputList) -> List[Subarray]:\n        \"\"\"Generates all contiguous subarrays from the input list.\"\"\"\n        all_subarrays: List[Subarray] = []\n        n = len(input_list_obj.elements)\n        for i in range(n):\n            for j in range(i, n):\n                sub_elements = input_list_obj.elements[i : j + 1]\n                all_subarrays.append(Subarray(i, j, sub_elements))\n        return all_subarrays\n\n    def computeProduct(self, sub: Subarray) -> Union[int,float]:\n        \"\"\"Computes the product for a single Subarray instance.\"\"\"\n        return sub.product()\n\n    def sumProducts(self, subs: List[Subarray]) -> Union[int,float]:\n        \"\"\"Aggregates (sums) the products of a list of Subarray instances.\"\"\"\n        total_sum: Union[int,float] = 0\n        for sub in subs:\n            total_sum += self.computeProduct(sub)\n        return total_sum\n```\n\n```python\n# src/sum_of_subarray_prod.py\nfrom typing import List, Union\nfrom .domain import InputList, Result\nfrom .product_calculation import ProductCalculation\n\ndef sum_Of_Subarray_Prod(lst: List[Union[int,float]]) -> Union[int,float]:\n    \"\"\"Computes the sum of products of all contiguous sublists.\"\"\"\n    input_list = InputList(lst)\n    if not input_list.validate():\n        raise ValueError(\"Input list must contain only numeric values (int or float).\")\n\n    product_calc = ProductCalculation()\n    all_subarrays = product_calc.computeAllSubarrays(input_list)\n    aggregated_sum = product_calc.sumProducts(all_subarrays)\n    \n    final_result = Result(aggregated_sum)\n    return final_result.value\n```"}
{"task_id": "Mbpp/735", "solution": "```python\n\"\"\"\nImplements the toggle_middle_bits function as per SRS, encapsulating bit logic in domain classes.\nThe public API is toggle_middle_bits(n: int) -> int.\n\"\"\"\n\nclass Number:\n    \"\"\"\n    Represent an integer and provide bit-position queries for MSB and LSB.\n    MSB is the highest-index set bit; LSB is defined as bit position 0.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def find_msb(self) -> int:\n        \"\"\"\n        Return the index of the most significant set bit.\n        For n=0, bit_length() is 0, so this returns -1.\n        \"\"\"\n        return self.value.bit_length() - 1\n\n    def find_lsb(self) -> int:\n        \"\"\"\n        Return the index of the least significant bit position, which is 0.\n        This aligns with the design's definition of LSB as bit position 0.\n        \"\"\"\n        return 0\n\nclass BitMask:\n    \"\"\"\n    Creates integer masks for bits strictly between MSB and LSB.\n    This class is primarily a static factory for mask generation.\n    \"\"\"\n    @staticmethod\n    def create_between_mask(msb: int, lsb: int) -> int:\n        \"\"\"\n        Return an integer mask with 1s in positions strictly between msb and lsb, 0s elsewhere.\n        MSB and LSB positions themselves remain 0 in the generated mask.\n        \"\"\"\n        # If there are 0 or 1 bits strictly between MSB and LSB, no bits to toggle.\n        # This occurs when msb <= lsb + 1 (e.g., msb=0, lsb=0 for value 1; msb=1, lsb=0 for value 2 or 3).\n        if msb <= lsb + 1:\n            return 0\n        \n        # Calculate a mask with all bits set from 0 up to (msb-1).\n        mask_up_to_msb_minus_1 = (1 << msb) - 1\n        # Calculate a mask with all bits set from 0 up to lsb.\n        mask_up_to_lsb = (1 << (lsb + 1)) - 1\n        \n        # XORing these two masks results in 1s only for bits strictly between lsb and msb.\n        return mask_up_to_msb_minus_1 ^ mask_up_to_lsb\n\n\nclass ToggleOperation:\n    \"\"\"\n    Orchestrates the identification of MSB/LSB, mask creation, and bit toggling.\n    It handles cases where no middle bits exist to toggle.\n    \"\"\"\n    @staticmethod\n    def toggle_middle_bits(n: int) -> int:\n        \"\"\"\n        Implement the core algorithm to toggle bits strictly between MSB and LSB.\n        Returns n unchanged if no middle bits exist (e.g., binary length < 3).\n        \"\"\"\n        number_obj = Number(n)\n        msb = number_obj.find_msb()\n        lsb = number_obj.find_lsb()\n\n        mask = BitMask.create_between_mask(msb, lsb)\n\n        if mask == 0:\n            return n\n        else:\n            return n ^ mask\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Public API as required by the SRS. It toggles bits strictly between the MSB and LSB of n.\n    This function acts as a thin wrapper, delegating the core logic to ToggleOperation.\n    \"\"\"\n    return ToggleOperation.toggle_middle_bits(n)\n```"}
{"task_id": "Mbpp/736", "solution": "```python\nimport typing\n\ndef left_insertion(seq, value) -> int:\n    \"\"\"Return zero-based leftmost insertion index per SRS.\n    Preconditions: seq is sorted ascending (non-decreasing); elements and value are comparable.\n    \"\"\"\n    low = 0\n    high = len(seq)\n\n    while low < high:\n        mid = (low + high) // 2\n        if seq[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Computes the zero-based index for left-insertion into an ascending-sorted list.\n    Uses an O(log n) binary search algorithm to find the insertion point.\n    \"\"\"\n    lo = 0\n    hi = len(sorted_list)\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sorted_list[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
