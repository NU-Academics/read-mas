{"task_id": "Mbpp/806", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the input text and provides its length.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass UppercaseRun:\n    \"\"\"Represents a contiguous run of uppercase characters.\"\"\"\n    startIndex: int\n    length: int\n\n@dataclass\nclass Result:\n    \"\"\"Encapsulates the computed maximum run length.\"\"\"\n    maxLength: int\n\nclass UppercaseRunAnalyzer:\n    \"\"\"\n    Analyzes strings to find uppercase runs and determine the maximum run length.\n    It strictly enforces ASCII 'A' through 'Z' for uppercase classification.\n    \"\"\"\n\n    def isUppercase(self, c: str) -> bool:\n        \"\"\"Checks if a character is an ASCII uppercase letter (A-Z).\"\"\"\n        return 'A' <= c <= 'Z'\n\n    def findRuns(self, s: str) -> list[UppercaseRun]:\n        \"\"\"Scans a string to identify all contiguous uppercase runs.\"\"\"\n        runs: list[UppercaseRun] = []\n        current_run_start = -1\n        current_run_length = 0\n\n        for i, char in enumerate(s):\n            if self.isUppercase(char):\n                if current_run_start == -1:\n                    current_run_start = i\n                current_run_length += 1\n            else:\n                if current_run_start != -1:\n                    runs.append(UppercaseRun(startIndex=current_run_start, length=current_run_length))\n                current_run_start = -1\n                current_run_length = 0\n\n        if current_run_start != -1:\n            runs.append(UppercaseRun(startIndex=current_run_start, length=current_run_length))\n        return runs\n\n    def max_run_uppercase(self, s: str) -> int:\n        \"\"\"\n        Computes the maximum length among all uppercase runs found in the string.\n        Returns 0 if no uppercase runs are found.\n        \"\"\"\n        runs = self.findRuns(s)\n        if not runs:\n            return 0\n        \n        max_length = 0\n        for run in runs:\n            if run.length > max_length:\n                max_length = run.length\n        return max_length\n\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest contiguous run of ASCII uppercase letters (A-Z).\n    Delegates the analysis to an UppercaseRunAnalyzer instance.\n    \"\"\"\n    analyzer = UppercaseRunAnalyzer()\n    return analyzer.max_run_uppercase(s)\n```"}
