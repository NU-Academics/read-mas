{"task_id": "Mbpp/90", "solution": "```python\n# src/len_log.py\nfrom typing import List, Iterator\n\n\nclass Word:\n    \"\"\"Represents a single word value and provides its length.\"\"\"\n    def __init__(self, value: str):\n        \"\"\"Initializes a Word object with its string value.\"\"\"\n        self._value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self._value)\n\n\nclass WordList:\n    \"\"\"Represents a collection of Word objects.\"\"\"\n    def __init__(self, words: List[str]):\n        \"\"\"Initializes WordList by wrapping each string in a Word object.\"\"\"\n        self._words: List[Word] = []\n        for word_str in words:\n            self.add(word_str)\n\n    def add(self, word_str: str) -> None:\n        \"\"\"Adds a new Word object created from a string to the list.\"\"\"\n        self._words.append(Word(word_str))\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the word list is empty.\"\"\"\n        return not self._words\n\n    def __iter__(self) -> Iterator[Word]:\n        \"\"\"Returns an iterator over the Word objects in the list.\"\"\"\n        return iter(self._words)\n\n\nclass Result:\n    \"\"\"Holds the computed maximum length of a word list.\"\"\"\n    def __init__(self, max_length: int):\n        \"\"\"Initializes Result with the maximum length.\"\"\"\n        self._max_length = max_length\n\n    def as_int(self) -> int:\n        \"\"\"Returns the stored maximum length as an integer.\"\"\"\n        return self._max_length\n\n\nclass LenLogService:\n    \"\"\"Encapsulates validation and computation for finding the longest word length.\"\"\"\n    def len_log(self, words: List[str]) -> int:\n        \"\"\"Validates input, computes max length, and returns the result.\"\"\"\n        self._validate_input(words)\n        \n        word_list = WordList(words)\n        if word_list.is_empty():\n            return 0\n        \n        result = self._compute_max(word_list)\n        return result.as_int()\n\n    def _validate_input(self, words) -> None:\n        \"\"\"Raises TypeError if input is not a list or contains non-string elements.\"\"\"\n        if not isinstance(words, list):\n            raise TypeError(\"Input must be a list.\")\n        for element in words:\n            if not isinstance(element, str):\n                raise TypeError(\"All elements in the list must be strings.\")\n\n    def _compute_max(self, word_list: 'WordList') -> 'Result':\n        \"\"\"Computes the maximum length among words in a WordList.\"\"\"\n        max_len = 0\n        for word in word_list:\n            max_len = max(max_len, word.length())\n        return Result(max_len)\n\n\ndef len_log(words: List[str]) -> int:\n    \"\"\"\n    Returns the length of the longest string in a list of words.\n    Raises TypeError for invalid input, returns 0 for an empty list.\n    \"\"\"\n    return LenLogService().len_log(words)\n```\n```python\n# tests/test_len_log.py\nimport pytest\nfrom src.len_log import len_log\n\ndef test_acceptance_case():\n    \"\"\"Acceptance test: ensures the specified example works correctly.\"\"\"\n    assert len_log([\"python\",\"PHP\",\"bigdata\"]) == 7\n\ndef test_empty_list():\n    \"\"\"Tests the function with an empty list, expecting 0.\"\"\"\n    assert len_log([]) == 0\n\ndef test_single_word_list():\n    \"\"\"Tests with a list containing a single word.\"\"\"\n    assert len_log([\"hello\"]) == 5\n\ndef test_multiple_words_varying_lengths():\n    \"\"\"Tests with multiple words of different lengths.\"\"\"\n    assert len_log([\"a\", \"bb\", \"ccc\", \"dddd\", \"eee\"]) == 4\n\ndef test_words_with_same_max_length():\n    \"\"\"Tests when multiple words share the maximum length.\"\"\"\n    assert len_log([\"apple\", \"grape\", \"berry\"]) == 5\n\ndef test_list_with_empty_strings():\n    \"\"\"Tests with an empty string in the list.\"\"\"\n    assert len_log([\"\", \"a\", \"bb\"]) == 2\n    assert len_log([\"\"]) == 0\n\ndef test_non_list_input_raises_type_error():\n    \"\"\"Ensures a TypeError is raised when input is not a list.\"\"\"\n    with pytest.raises(TypeError, match=\"Input must be a list.\"):\n        len_log(None)\n    with pytest.raises(TypeError, match=\"Input must be a list.\"):\n        len_log(\"not a list\")\n    with pytest.raises(TypeError, match=\"Input must be a list.\"):\n        len_log(123)\n    with pytest.raises(TypeError, match=\"Input must be a list.\"):\n        len_log({\"a\": 1})\n\ndef test_list_with_non_string_elements_raises_type_error():\n    \"\"\"Ensures a TypeError is raised when list elements are not strings.\"\"\"\n    with pytest.raises(TypeError, match=\"All elements in the list must be strings.\"):\n        len_log([\"a\", 1, \"c\"])\n    with pytest.raises(TypeError, match=\"All elements in the list must be strings.\"):\n        len_log([True])\n    with pytest.raises(TypeError, match=\"All elements in the list must be strings.\"):\n        len_log([\"hello\", None])\n    with pytest.raises(TypeError, match=\"All elements in the list must be strings.\"):\n        len_log([\"hello\", 1.23])\n```"}
{"task_id": "Mbpp/90", "solution": "```python\nfrom typing import Optional, Iterator\n\nclass Word:\n    \"\"\"Represents a single word and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.value)\n\nclass WordList:\n    \"\"\"Encapsulates a list of words, provides validation, and iterates Word objects.\"\"\"\n    def __init__(self, words: list) -> None:\n        self.words = words\n\n    def validate(self) -> None:\n        \"\"\"Validates input type and element types, raising TypeError on invalid input.\"\"\"\n        if not isinstance(self.words, list):\n            raise TypeError(\"words must be a list of strings\")\n        for word_val in self.words:\n            if not isinstance(word_val, str):\n                raise TypeError(\"all elements of words must be str\")\n\n    def __iter__(self) -> Iterator['Word']:\n        \"\"\"Yields Word instances for each value in the list.\"\"\"\n        for word_val in self.words:\n            yield Word(word_val)\n\nclass Result:\n    \"\"\"Data holder for the computation outcome (longest_length and optional longest_word).\"\"\"\n    def __init__(self, longest_length: int, longest_word: Optional[str]) -> None:\n        self.longest_length = longest_length\n        self.longest_word = longest_word\n\nclass LenLogFunction:\n    \"\"\"Orchestrates validation, computation, and selection of maximum length.\"\"\"\n    def len_log(self, words) -> int:\n        \"\"\"Computes the length of the longest word after validation.\"\"\"\n        word_list = WordList(words)\n        word_list.validate() \n\n        if not word_list.words:\n            return 0 # Returns 0 for an empty list per BR5.\n\n        max_length = 0\n        longest_word_val: Optional[str] = None\n\n        for word_obj in word_list:\n            current_length = word_obj.length()\n            if current_length > max_length:\n                max_length = current_length\n                longest_word_val = word_obj.value\n\n        result = Result(max_length, longest_word_val)\n        return result.longest_length\n\ndef len_log(words) -> int:\n    \"\"\"\n    Public entry point to find the length of the longest word in a list of strings.\n    Validates input and returns 0 for an empty list, otherwise raises TypeError.\n    \"\"\"\n    return LenLogFunction().len_log(words)\n```"}
