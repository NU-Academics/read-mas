{"task_id": "Mbpp/809", "solution": "```python\n# src/__init__.py\nfrom .check_smaller import check_smaller, CheckSmaller, TupleInput, ComparisonResult, TestCase\n```\n```python\n# src/check_smaller.py\nfrom typing import Tuple, Any\n\nclass TupleInput:\n    \"\"\"Lightweight domain object representing an input tuple.\"\"\"\n    def __init__(self, elements: Tuple[Any, ...]):\n        if not isinstance(elements, tuple):\n            raise TypeError(\"TupleInput must be initialized with a tuple.\")\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated tuple.\"\"\"\n        return len(self.elements)\n\nclass ComparisonResult:\n    \"\"\"Holder for a boolean result of a comparison.\"\"\"\n    def __init__(self, value: bool):\n        if not isinstance(value, bool):\n            raise TypeError(\"ComparisonResult must be initialized with a boolean.\")\n        self.value = value\n\nclass CheckSmaller:\n    \"\"\"Encapsulates validation and element-wise comparison logic.\"\"\"\n    def check(self, a: Tuple[Any, ...], b: Tuple[Any, ...]) -> bool:\n        \"\"\"\n        Compares two tuples element-wise (b[i] < a[i]), handling type validation and length mismatch.\n        Raises TypeError for non-tuple inputs or non-comparable elements.\n        \"\"\"\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise TypeError(\"Both inputs 'a' and 'b' must be tuples.\")\n\n        if len(a) != len(b):\n            return False\n\n        for i in range(len(a)):\n            try:\n                if not (b[i] < a[i]):\n                    return False\n            except TypeError:\n                raise TypeError(f\"Elements at index {i} are not comparable: {b[i]} < {a[i]}\")\n\n        return True\n\nclass TestCase:\n    \"\"\"Represents a test scenario for check_smaller.\"\"\"\n    def __init__(self, inputA: Tuple[Any, ...], inputB: Tuple[Any, ...], expected: bool):\n        self.inputA = inputA\n        self.inputB = inputB\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes the test scenario and verifies the result.\"\"\"\n        checker = CheckSmaller()\n        actual_result = checker.check(self.inputA, self.inputB)\n        return actual_result == self.expected\n\ndef check_smaller(a: Tuple[Any, ...], b: Tuple[Any, ...]) -> bool:\n    \"\"\"\n    Checks if each element of tuple 'b' is smaller than its corresponding element in tuple 'a'.\n    This function validates types and element comparability, returning False on length mismatch.\n    \"\"\"\n    checker = CheckSmaller()\n    return checker.check(a, b)\n```\n```python\n# tests/test_check_smaller.py\nimport pytest\nfrom src.check_smaller import check_smaller, TestCase\n\ndef test_provided_assertion():\n    \"\"\"Verifies the specific test case required by the SRS: (1,2,3) vs (2,3,4).\"\"\"\n    assert check_smaller((1, 2, 3), (2, 3, 4)) == False\n\ndef test_all_true_case():\n    \"\"\"Tests an acceptance case where all elements in 'b' are smaller than 'a'.\"\"\"\n    assert check_smaller((5, 6, 7), (1, 2, 3)) == True\n\ndef test_length_mismatch_case():\n    \"\"\"Tests inputs with different lengths, expecting False per BR-4.\"\"\"\n    assert check_smaller((1, 2, 3), (1, 2)) == False\n    assert check_smaller((1, 2), (1, 2, 3)) == False\n\ndef test_empty_tuples_case():\n    \"\"\"Tests two empty tuples, expecting True per BR-5.\"\"\"\n    assert check_smaller((), ()) == True\n\ndef test_non_tuple_inputs_raise_type_error():\n    \"\"\"Tests non-tuple inputs, expecting TypeError per BR-1.\"\"\"\n    with pytest.raises(TypeError, match=\"Both inputs 'a' and 'b' must be tuples.\"):\n        check_smaller([1, 2], (1, 2))\n    with pytest.raises(TypeError, match=\"Both inputs 'a' and 'b' must be tuples.\"):\n        check_smaller((1, 2), [1, 2])\n    with pytest.raises(TypeError, match=\"Both inputs 'a' and 'b' must be tuples.\"):\n        check_smaller(1, 2)\n\ndef test_non_comparable_elements_raise_type_error():\n    \"\"\"Tests element pairings that are not comparable, expecting TypeError per BR-6.\"\"\"\n    with pytest.raises(TypeError, match=\"Elements at index 1 are not comparable: 2 < 'a'\"):\n        check_smaller((1, 'a', 3), (0, 2, 2))\n    with pytest.raises(TypeError, match=\"Elements at index 0 are not comparable: 'b' < 1\"):\n        check_smaller(('a', 2), ('b', 1))\n\ndef test_testcase_run():\n    \"\"\"Verifies the TestCase class correctly executes and reports test scenarios.\"\"\"\n    passing_scenario = TestCase((5, 6, 7), (1, 2, 3), True)\n    assert passing_scenario.run()\n\n    failing_scenario = TestCase((1, 2, 3), (2, 3, 4), False)\n    assert failing_scenario.run()\n\n    mismatch_length_scenario = TestCase((1, 2, 3), (1, 2), False)\n    assert mismatch_length_scenario.run()\n\n    with pytest.raises(TypeError):\n        non_comparable_scenario = TestCase((1, 'a'), (0, 2), False) # Expects TypeError from check_smaller\n        non_comparable_scenario.run()\n```"}
{"task_id": "Mbpp/476", "solution": "```python\n# src/__init__.py\nfrom .big_sum import big_sum\n\n__all__ = ['big_sum']\n```\n```python\n# src/big_sum.py\nfrom typing import Sequence, Tuple\n\ndef _find_min_max(arr: Sequence[float]) -> Tuple[float, float]:\n    \"\"\"Scans arr once to find the minimum and maximum values.\n    This implementation assumes `arr` is a non-empty sequence of numbers.\n    \"\"\"\n    current_min = arr[0]\n    current_max = arr[0]\n    for x in arr:\n        if x < current_min:\n            current_min = x\n        if x > current_max:\n            current_max = x\n    return current_min, current_max\n\ndef _compute_sum(min_val: float, max_val: float) -> float:\n    \"\"\"Returns the arithmetic sum of two given numeric values.\n    This simple helper adds min_val and max_val.\n    \"\"\"\n    return min_val + max_val\n\ndef big_sum(arr: Sequence[float]) -> float:\n    \"\"\"Accepts an array of numbers and returns the sum of its smallest and largest values.\n    It delegates finding min/max and computing the sum to internal helpers.\n    \"\"\"\n    min_val, max_val = _find_min_max(arr)\n    return _compute_sum(min_val, max_val)\n```"}
{"task_id": "Mbpp/470", "solution": "```python\n# src/add_pairwise.py\n\nfrom dataclasses import dataclass\nimport numbers\nfrom typing import Tuple\n\n@dataclass\nclass Element:\n    \"\"\"Represents a single numeric element with its position.\"\"\"\n    value: numbers.Number\n    position: int\n\n@dataclass\nclass InputTuple:\n    \"\"\"A validated input tuple containing numeric elements.\"\"\"\n    elements: Tuple[numbers.Number, ...]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\n@dataclass\nclass OutputTuple:\n    \"\"\"A tuple containing the results of pairwise sums.\"\"\"\n    elements: Tuple[numbers.Number, ...]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\ndef _validate_input(input_data: tuple) -> InputTuple:\n    \"\"\"Validates the input tuple according to specified preconditions.\n    Raises TypeError or ValueError for invalid inputs.\"\"\"\n    if not isinstance(input_data, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(input_data) < 2:\n        raise ValueError(\"Input tuple must have at least 2 elements for pairwise addition.\")\n\n    for i, element in enumerate(input_data):\n        if not isinstance(element, numbers.Number):\n            raise TypeError(f\"Element at index {i} is not a numeric type: {type(element).__name__}.\")\n\n    return InputTuple(elements=tuple(input_data))\n\ndef add_pairwise(input: tuple) -> tuple:\n    \"\"\"Computes pairwise sums of neighboring elements in the input tuple.\n    Validates input for type, numeric elements, and length.\"\"\"\n    validated_input = _validate_input(input)\n\n    output_elements = tuple(\n        validated_input.elements[i] + validated_input.elements[i+1]\n        for i in range(validated_input.length() - 1)\n    )\n\n    return output_elements\n```\n```python\n# src/__init__.py\n\n__all__ = [\"add_pairwise\"]\n\nfrom .add_pairwise import add_pairwise\n```"}
