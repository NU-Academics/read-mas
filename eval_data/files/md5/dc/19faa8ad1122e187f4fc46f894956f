{"task_id": "Mbpp/413", "solution": "```python\nfrom typing import Any, List, Iterator\n\nclass Validator:\n    \"\"\"\n    Validates the types of input parameters for the extraction function.\n    Raises TypeError for any type mismatches per design specifications.\n    \"\"\"\n    def validate_types(self, list_of_tuples: Any, n: Any) -> None:\n        \"\"\"\n        Checks if list_of_tuples is a list, its elements are tuples, and n is an integer.\n        Raises TypeError if any condition is not met.\n        \"\"\"\n        if not isinstance(list_of_tuples, list):\n            raise TypeError(\"Input 'list_of_tuples' must be a list.\")\n        for i, item in enumerate(list_of_tuples):\n            if not isinstance(item, tuple):\n                raise TypeError(f\"Element at index {i} in 'list_of_tuples' must be a tuple, got {type(item).__name__}.\")\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\nclass TupleList:\n    \"\"\"\n    A lightweight container for the input list of tuples.\n    Provides iteration and length capabilities.\n    \"\"\"\n    def __init__(self, tuples: list) -> None:\n        \"\"\"Initializes with the raw list of tuples.\"\"\"\n        self.tuples = tuples\n\n    def __iter__(self) -> Iterator[tuple]:\n        \"\"\"Returns an iterator over the contained tuples.\"\"\"\n        return iter(self.tuples)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of tuples in the list.\"\"\"\n        return len(self.tuples)\n\nclass ResultList:\n    \"\"\"\n    Accumulates extracted elements and provides a method to convert to a standard list.\n    Designed to hold the results of the extraction process.\n    \"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes an empty list to store elements.\"\"\"\n        self.elements: List[Any] = []\n\n    def append(self, item: Any) -> None:\n        \"\"\"Adds an item to the list of extracted elements.\"\"\"\n        self.elements.append(item)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the accumulated elements as a new list.\"\"\"\n        return list(self.elements)\n\ndef extract_nth_element(list_of_tuples: List[tuple], n: int) -> list:\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    Performs strict input validation and preserves element order.\n    \"\"\"\n    Validator().validate_types(list_of_tuples, n)\n\n    tuple_list_wrapper = TupleList(list_of_tuples)\n    result_list_wrapper = ResultList()\n\n    for tpl in tuple_list_wrapper:\n        # IndexError will be raised naturally here if n is out of bounds for any tuple.\n        extracted_element = tpl[n]\n        result_list_wrapper.append(extracted_element)\n\n    return result_list_wrapper.to_list()\n```"}
{"task_id": "Mbpp/414", "solution": "```python\nfrom collections.abc import Iterable\n\ndef _is_iterable(obj) -> bool:\n    \"\"\"\n    Checks if an object is an iterable using collections.abc.Iterable.\n    \"\"\"\n    return isinstance(obj, Iterable)\n\ndef _equals(a, b) -> bool:\n    \"\"\"\n    Compares two elements using Python's equality operator (==).\n    \"\"\"\n    return a == b\n\ndef overlapping(seqA, seqB) -> bool:\n    \"\"\"\n    Checks if any element from seqA exists in seqB using Python's equality.\n    Raises TypeError if either input is not an iterable.\n    \"\"\"\n    if not _is_iterable(seqA):\n        raise TypeError(f\"Input seqA must be an iterable, but received type {type(seqA).__name__}.\")\n    if not _is_iterable(seqB):\n        raise TypeError(f\"Input seqB must be an iterable, but received type {type(seqB).__name__}.\")\n\n    # Ensure a stable, non-consumable representation of seqB for repeated iteration.\n    # This avoids consuming single-pass iterators and does not mutate the original seqB.\n    stable_seqB = tuple(seqB)\n\n    for item_a in seqA:\n        for item_b in stable_seqB:\n            if _equals(item_a, item_b):\n                return True  # Short-circuit on first match\n    return False\n```"}
{"task_id": "Mbpp/415", "solution": "```python\nfrom typing import List, Tuple\n\nclass InsufficientElementsException(Exception):\n    \"\"\"\n    Exception raised when the input list has fewer than the required number of elements.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass PairResult:\n    \"\"\"\n    Represents a pair of integers and computes their product.\n    \"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        \"\"\"Returns the product of the two integers in the pair.\"\"\"\n        return self.a * self.b\n\nclass Validator:\n    \"\"\"\n    Validates preconditions on input lists.\n    \"\"\"\n    def ensure_minimum_length(self, numbers: List[int], min: int) -> None:\n        \"\"\"\n        Raises InsufficientElementsException if the list length is less than min.\n        \"\"\"\n        if len(numbers) < min:\n            raise InsufficientElementsException(f\"Input list must contain at least {min} elements.\")\n\nclass ProductCalculator:\n    \"\"\"\n    Enumerate unordered pairs and select one maximal-product pair.\n    \"\"\"\n    def all_unordered_pairs(self, numbers: List[int]) -> List[PairResult]:\n        \"\"\"\n        Generates all unordered pairs of distinct positions from the input list.\n        \"\"\"\n        pairs = []\n        n = len(numbers)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append(PairResult(numbers[i], numbers[j]))\n        return pairs\n\n    def max_product_pair(self, numbers: List[int]) -> PairResult:\n        \"\"\"\n        Returns one PairResult with the maximal product from the input list.\n        Ties may return any one valid pair.\n        \"\"\"\n        all_pairs = self.all_unordered_pairs(numbers)\n        \n        # After validation, numbers is guaranteed to have at least 2 elements,\n        # so all_pairs will contain at least one PairResult.\n        best_pair = all_pairs[0]\n        max_prod = best_pair.product()\n\n        for pair in all_pairs[1:]:\n            current_prod = pair.product()\n            if current_prod > max_prod:\n                max_prod = current_prod\n                best_pair = pair\n        return best_pair\n\ndef max_Product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from the list whose product is maximal.\n    Raises InsufficientElementsException if the list has fewer than two elements.\n    \"\"\"\n    validator = Validator()\n    product_calculator = ProductCalculator()\n\n    validator.ensure_minimum_length(numbers, 2)\n    \n    best_pair_result = product_calculator.max_product_pair(numbers)\n    return (best_pair_result.a, best_pair_result.b)\n```"}
{"task_id": "Mbpp/415", "solution": "```python\nfrom typing import List, Tuple\n\nclass ValidationError(Exception):\n    \"\"\"\n    Domain-specific exception for internal use.\n    Public contract uses ValueError for input validation.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Validator:\n    \"\"\"\n    Validates input constraints for the max_Product function.\n    Ensures the list contains at least two integers.\n    \"\"\"\n    def validate_count(self, nums: List[int]) -> None:\n        if len(nums) < 2:\n            raise ValueError(\"list must contain at least two integers\")\n\nclass IntegerList:\n    \"\"\"\n    A lightweight wrapper for a list of integers.\n    Provides basic access to elements and length.\n    \"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass IntegerPair:\n    \"\"\"\n    Encapsulates a pair of integers.\n    Provides methods to calculate their product and return them ordered.\n    \"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        return self.a * self.b\n\n    def ordered(self) -> Tuple[int, int]:\n        return (min(self.a, self.b), max(self.a, self.b))\n\ndef _compute_max_pair(nums: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Internal helper to find the pair with the maximal product and apply tie-breaking rules.\n    Assumes `nums` has at least two elements.\n    \"\"\"\n    n = len(nums)\n    # Initialize with the first valid pair, guaranteed by Validator check in max_Product.\n    initial_pair = IntegerPair(nums[0], nums[1])\n    best_product = initial_pair.product()\n    best_pair_indices = (0, 1) # Store indices for tie-breaking: (first_idx, second_idx)\n    best_pair_values = initial_pair.ordered() # Store values (min_val, max_val) for return\n\n    # Iterate through all distinct pairs (i, j) where i < j\n    for i in range(n):\n        for j in range(i + 1, n):\n            current_pair = IntegerPair(nums[i], nums[j])\n            current_product = current_pair.product()\n\n            if current_product > best_product:\n                # Found a new strictly greater product, update all bests.\n                best_product = current_product\n                best_pair_indices = (i, j)\n                best_pair_values = current_pair.ordered()\n            elif current_product == best_product:\n                # Product is equal, apply deterministic tie-breaker (earliest-by-index):\n                # 1. Choose the pair with the smallest first index.\n                if i < best_pair_indices[0]:\n                    best_pair_indices = (i, j)\n                    best_pair_values = current_pair.ordered()\n                # 2. If first indices are tied, choose the pair with the smallest second index.\n                elif i == best_pair_indices[0] and j < best_pair_indices[1]:\n                    best_pair_indices = (i, j)\n                    best_pair_values = current_pair.ordered()\n\n    return best_pair_values\n\ndef max_Product(nums: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of elements with distinct indices whose product is maximal.\n    Handles negative values and deterministic tie-breaking (earliest-by-index).\n    \"\"\"\n    # Validate input list length as per design specification.\n    Validator().validate_count(nums)\n    # Compute the maximal product pair using the internal helper.\n    # The helper already returns the pair values ordered (min, max).\n    result_values = _compute_max_pair(nums)\n    return result_values\n```\n```python\nfrom src.max_product import max_Product\n\ndef test_example_max_product():\n    \"\"\"\n    Tests the max_Product function with the required example assertion.\n    Verifies correct maximal product pair and deterministic tie-breaking.\n    \"\"\"\n    assert max_Product([1,2,3,4,7,0,8,4]) == (7,8)\n\n```"}
