{"task_id": "Mbpp/612", "solution": "```python\nfrom typing import Any, List\n\n# Type aliases for traceability to SRS domain classes\nSublist = List[Any]      # Represents a two-element list [first, second]\nInputList = List[Sublist]\nOutputList = List[List[Any]]\n\ndef merge(input_list: InputList) -> OutputList:\n    \"\"\"\n    Accepts a list of two-element sublists and returns [firsts, seconds].\n    Preserves input order and returns [[], []] for an empty input list.\n    \"\"\"\n    if not input_list:\n        return [[], []]\n    firsts, seconds = zip(*input_list)\n    return [list(firsts), list(seconds)]\n```"}
{"task_id": "Mbpp/614", "solution": "```python\n\"\"\"Implements cummulative_sum(list_of_tuples) -> number as specified in SRS.\"\"\"\n\ndef validate_input(list_of_tuples) -> None:\n    \"\"\"\n    Performs minimal structural checks on the input.\n    No validation logic is present to comply with critical requirements.\n    \"\"\"\n    pass\n\ndef cummulative_sum(list_of_tuples) -> float:\n    \"\"\"\n    Iterates each tuple in the provided list and each numeric value within each tuple,\n    accumulating and returning the total sum.\n    \"\"\"\n    validate_input(list_of_tuples)\n    running_total = 0\n    for tpl in list_of_tuples:\n        for value in tpl:\n            running_total += value\n    return running_total\n```"}
{"task_id": "Mbpp/615", "solution": "```python\ndef average_tuple(input_tuple: tuple[tuple]) -> list[float]:\n    \"\"\"Computes the arithmetic mean for each inner tuple in a tuple of tuples.\n    This function trusts the caller's input and performs no validation.\n    \"\"\"\n    return [sum(inner) / len(inner) for inner in input_tuple]\n```"}
{"task_id": "Mbpp/615", "solution": "```python\ndef average_tuple(input):\n    \"\"\"\n    Computes the arithmetic mean for each inner tuple in a tuple of tuples.\n    Returns a list of floats.\n    \"\"\"\n    results = []\n    for inner_tuple in input:\n        # Assuming inner_tuple is non-empty and contains only numeric elements.\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        results.append(current_sum / current_count)\n    return results\n```"}
{"task_id": "Mbpp/616", "solution": "```python\n# src/__init__.py\nfrom .tuple_modulo import tuple_modulo\n\n__all__ = [\"tuple_modulo\"]\n```\n```python\n# src/tuple_modulo.py\n\ndef tuple_modulo(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Compute element-wise modulo of two integer tuples.\n\n    Raises ValueError if len(a) != len(b).\n    Raises ZeroDivisionError if any element in b equals 0.\n    Returns a new tuple r where r[i] == a[i] % b[i].\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    for divisor in b:\n        if divisor == 0:\n            raise ZeroDivisionError(\"Cannot perform modulo by zero.\")\n\n    return tuple(a[i] % b[i] for i in range(len(a)))\n```\n```python\n# tests/test_tuple_modulo.py\nimport pytest\nfrom src.tuple_modulo import tuple_modulo\n\ndef test_example_assertion():\n    \"\"\"Verify the example assertion from the design document.\"\"\"\n    assert tuple_modulo((10, 4, 5, 6), (5, 6, 7, 5)) == (0, 4, 5, 1)\n\ndef test_length_mismatch_raises_ValueError():\n    \"\"\"Verify ValueError is raised for tuples of different lengths.\"\"\"\n    with pytest.raises(ValueError, match=\"Input tuples must have the same length.\"):\n        tuple_modulo((1, 2), (1, 2, 3))\n    with pytest.raises(ValueError):\n        tuple_modulo((1, 2, 3), (1, 2))\n\ndef test_zero_divisor_raises_ZeroDivisionError():\n    \"\"\"Verify ZeroDivisionError is raised when any divisor is zero.\"\"\"\n    with pytest.raises(ZeroDivisionError, match=\"Cannot perform modulo by zero.\"):\n        tuple_modulo((10, 4, 5), (2, 0, 3))\n    with pytest.raises(ZeroDivisionError):\n        tuple_modulo((10, 4, 5), (0, 6, 3))\n    with pytest.raises(ZeroDivisionError):\n        tuple_modulo((10, 4, 5), (2, 6, 0))\n\ndef test_return_types_are_int():\n    \"\"\"Verify that all elements in the returned tuple are integers.\"\"\"\n    result = tuple_modulo((10, 4, 5), (2, 6, 3))\n    assert isinstance(result, tuple)\n    assert all(isinstance(x, int) for x in result)\n\ndef test_inputs_unchanged_after_call():\n    \"\"\"Verify that the input tuples are not modified by the function.\"\"\"\n    a_original = (10, 4, 5)\n    b_original = (2, 6, 3)\n\n    tuple_modulo(a_original, b_original)\n\n    assert a_original == (10, 4, 5)\n    assert b_original == (2, 6, 3)\n\ndef test_empty_tuples():\n    \"\"\"Verify behavior with empty tuples.\"\"\"\n    assert tuple_modulo((), ()) == ()\n\ndef test_single_element_tuples():\n    \"\"\"Verify behavior with single-element tuples.\"\"\"\n    assert tuple_modulo((10,), (3,)) == (1,)\n    assert tuple_modulo((10,), (-3,)) == (1,)\n\ndef test_negative_numbers():\n    \"\"\"Verify behavior with negative numbers in input tuples.\"\"\"\n    assert tuple_modulo((-10, 4, -5), (3, -6, 2)) == (2, -2, 1)\n```"}
