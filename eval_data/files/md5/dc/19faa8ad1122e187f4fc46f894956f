ical is_Even function.\n\"\"\"\nfrom .even_checker import is_Even\n\n```\n\n```\ntests/test_is_even.py\n```python\n\"\"\"\nUnit test module containing SRS-specified assertions used to verify acceptance criteria.\n\"\"\"\n# The design specifies importing from the package for public API.\nfrom is_even import is_Even\n\ndef test_assertions() -> None:\n    \"\"\"Groups and executes SRS-specified assertions for the is_Even function.\"\"\"\n    # FR-07 verification: assert is_Even(1) == False\n    assert is_Even(1) == False, \"FR-07: is_Even(1) should be False\"\n    # Additional acceptance assertions for other FRs:\n    assert is_Even(2) == True, \"FR-03: is_Even(2) should be True\"\n    assert is_Even(0) == True, \"FR-05: is_Even(0) should be True\"\n    assert is_Even(-2) == True, \"FR-06: is_Even(-2) should be True\"\n    assert is_Even(-1) == False, \"FR-06: is_Even(-1) should be False\"\n\n```\n\n```\ntools/test_runner.py\n```python\n\"\"\"\nSimple test runner script that imports tests.test_is_even and executes its test_assertions,\nreporting results and returning non-zero exit code on failure.\n\"\"\"\nimport sys\nimport os\n\n# Add the project root to sys.path to ensure module imports work when run directly.\n# Assumes test_runner.py is in project_root/tools/.\nproject_root = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))\nsys.path.insert(0, project_root)\n\n# Import the test module after modifying sys.path.\nimport tests.test_is_even\n\ndef main() -> int:\n    \"\"\"\n    Entry point for the test runner. Executes all defined tests.\n    Returns 0 on success, 1 on failure.\n    \"\"\"\n    try:\n        tests.test_is_even.test_assertions()\n        print('All tests passed')\n        return 0\n    except AssertionError as e:\n        print(f'Test failed: {e}')\n        return 1\n    except Exception as e:\n        print(f'An unexpected error occurred: {e}')\n        return 1\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```"}
