e}\")\n        try:\n            self.actualResult = eval(self.assertion, {'rectangle_area': rectangle_area})\n            passed = (self.actualResult == self.expectedResult)\n            status = \"PASS\" if passed else \"FAIL\"\n            print(f\"  Status: {status}, Expected: {self.expectedResult}, Actual: {self.actualResult}\")\n            return passed\n        except Exception as e:\n            print(f\"  Error running test '{self.name}': {e}\")\n            return False\n\ndef run_concrete_test() -> None:\n    \"\"\"Executes the concrete assertion test case directly and via TestCase.\"\"\"\n    print(\"--- Executing concrete test via direct assert ---\")\n    test_result = rectangle_area(10, 20)\n    expected_result = 200\n    assert test_result == expected_result, f\"Direct Assert Test Failed: Expected {expected_result}, got {test_result}\"\n    print(f\"Direct Assert Test Passed: rectangle_area(10, 20) == {test_result}\")\n    print(\"--- Finished direct assert test ---\")\n\n    print(\"\\n--- Executing concrete test via TestCase class ---\")\n    concrete_test_case = TestCase(\n        name=\"Rectangle Area (10, 20) should be 200\",\n        expectedResult=200,\n        assertion=\"rectangle_area(10, 20)\"\n    )\n    concrete_test_case.run()\n    print(\"--- Finished TestCase class test ---\")\n\nif __name__ == \"__main__\":\n    run_concrete_test()\n```"}
