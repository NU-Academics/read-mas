{"task_id": "Mbpp/242", "solution": "```python\nclass InputString:\n    \"\"\"Data holder for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass CharacterCount:\n    \"\"\"Data holder for the character count total.\"\"\"\n    def __init__(self, total: int):\n        self.total: int = total\n\nclass CountCharac:\n    \"\"\"Encapsulates the character counting algorithm, including whitespace.\"\"\"\n    def count(self, s: str) -> int:\n        return len(s)\n\ndef count_charac(s: str) -> int:\n    \"\"\"Counts the total number of characters in a string, including whitespace.\"\"\"\n    input_obj = InputString(s)\n    impl = CountCharac()\n    total = impl.count(input_obj.value)\n    return total\n```"}
{"task_id": "Mbpp/240", "solution": "from typing import List, Any\n\n\"\"\"\nProvides the replace_list API.\nThis function returns a new list and does not mutate input lists; it raises ValueError for an empty first list.\n\"\"\"\n\nclass Validator:\n    \"\"\"Encapsulates precondition checks for list inputs.\"\"\"\n    def validate_non_empty(self, lst: List[Any]) -> bool:\n        \"\"\"Validates that the provided list is not empty, raising ValueError if it is.\"\"\"\n        if not lst:\n            raise ValueError(\"first list must contain at least one element\")\n        return True\n\nclass ReplaceListFunction:\n    \"\"\"Encapsulates the core business logic for list transformation.\"\"\"\n    def replace_list(self, list1: List[Any], list2: List[Any]) -> List[Any]:\n        \"\"\"Removes the last element of list1 and appends all elements of list2.\"\"\"\n        trimmed = self._trim_last(list1)\n        return self._append_second(trimmed, list2)\n\n    def _trim_last(self, src: List[Any]) -> List[Any]:\n        \"\"\"Returns a new list containing all but the last element of the source list.\"\"\"\n        return src[:-1]\n\n    def _append_second(self, trimmed: List[Any], second: List[Any]) -> List[Any]:\n        \"\"\"Returns a new list by concatenating the trimmed list with the second list.\"\"\"\n        return trimmed + second\n\ndef replace_list(list1: List[Any], list2: List[Any]) -> List[Any]:\n    \"\"\"\n    Replaces the last element of list1 with the elements of list2, returning a new list.\n    Raises ValueError if list1 is empty.\n    \"\"\"\n    validator = Validator()\n    validator.validate_non_empty(list1)\n    \n    impl = ReplaceListFunction()\n    return impl.replace_list(list1, list2)"}
{"task_id": "Mbpp/242", "solution": "```python\n# src/count_charac.py\nfrom datetime import datetime\n\n\"\"\"\nThis module implements the count_charac function, providing a public API\nfor character counting, and supporting domain classes.\n\"\"\"\n\nclass InputString:\n    \"\"\"\n    Represents the input string and provides its value and derived length.\n    Ensures input is a string upon creation.\n    \"\"\"\n    def __init__(self, value: str):\n        if not isinstance(value, str):\n            raise TypeError(\"Input value must be a string.\")\n        self._value = value\n        self._length = len(value)\n\n    @property\n    def value(self) -> str:\n        \"\"\"The actual string value.\"\"\"\n        return self._value\n\n    @property\n    def length(self) -> int:\n        \"\"\"The character count of the string.\"\"\"\n        return self._length\n\n\nclass CharacterCounter:\n    \"\"\"\n    Handles the core logic for counting characters and validating input type.\n    It is designed to be stateless for reusability.\n    \"\"\"\n    def count_charac(self, input_str_value: str) -> int:\n        \"\"\"\n        Counts all characters in the provided string, including spaces and punctuation.\n        Ensures the input is a string.\n        \"\"\"\n        if not isinstance(input_str_value, str):\n            raise TypeError(\"Input must be a string for character counting.\")\n        return len(input_str_value)\n\n\nclass Result:\n    \"\"\"\n    Models the result of a character count, encapsulating the length and computation time.\n    The computed_at timestamp is optional.\n    \"\"\"\n    def __init__(self, length: int, computed_at: datetime = None):\n        self.length = length\n        self.computed_at = computed_at if computed_at is not None else datetime.now()\n\n\ndef count_charac(input_str: str) -> int:\n    \"\"\"\n    Public API: validates input type, counts all characters (including spaces/punctuation),\n    and returns the integer count. Raises TypeError for non-string inputs.\n    \"\"\"\n    # Validate input type as per Requirement Overview and UC-2.\n    if not isinstance(input_str, str):\n        raise TypeError(\"Input must be a string for character counting.\")\n\n    # Create InputString object (as per UC-1 sequence diagram)\n    # InputString's __init__ will also validate, ensuring robustness.\n    input_obj = InputString(input_str)\n\n    # Delegate to CharacterCounter for the counting logic (as per UC-1, UC-3)\n    counter = CharacterCounter()\n    final_count = counter.count_charac(input_obj.value)\n\n    # Result class is a domain model, but the public API returns an int.\n    # Result(length=final_count) can be used internally if needed.\n\n    return final_count\n\n```\n```python\n# tests/test_count_charac.py\nimport pytest\nfrom src.count_charac import count_charac, InputString, CharacterCounter, Result\n\n\"\"\"\nTest module for the count_charac library, verifying its functional requirements.\nIncludes the TestCase class and specific unit tests.\n\"\"\"\n\nclass TestCase:\n    \"\"\"\n    Represents a single test case with an input, expected result, and optional description.\n    Provides a run method to execute the test.\n    \"\"\"\n    def __init__(self, input_str: str, expected: int, description: str = None):\n        self.input = input_str\n        self.expected = expected\n        self.description = description if description else f\"Test for input '{input_str}'\"\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the count_charac function with the test input and verifies the result.\n        Returns True if the assertion passes, False otherwise.\n        \"\"\"\n        try:\n            actual_result = count_charac(self.input)\n            return actual_result == self.expected\n        except Exception:\n            return False # Any exception during execution indicates a failed test.\n\n\ndef test_required_specific_case():\n    \"\"\"\n    Verifies the explicit test case: assert count_charac(\"python programming\") == 18.\n    This test ensures compliance with the primary example.\n    \"\"\"\n    assert count_charac(\"python programming\") == 18\n\ndef test_counting_with_spaces_and_punctuation():\n    \"\"\"\n    Verifies that counting includes spaces and punctuation, e.g., \"a b!\".\n    This checks the native string semantics.\n    \"\"\"\n    assert count_charac(\"a b!\") == 4\n\ndef test_non_string_input_raises_type_error():\n    \"\"\"\n    Verifies that calling count_charac with a non-string input raises TypeError.\n    This confirms the required input validation behavior.\n    \"\"\"\n    with pytest.raises(TypeError):\n        count_charac(123)\n    with pytest.raises(TypeError):\n        count_charac(None)\n    with pytest.raises(TypeError):\n        count_charac(['a', 'b'])\n    with pytest.raises(TypeError):\n        count_charac(b\"byte string\") # Python 3 distinguishes str and bytes\n\ndef test_empty_string_returns_zero():\n    \"\"\"\n    Verifies that an empty string correctly returns a count of zero.\n    This covers a basic edge case for string length.\n    \"\"\"\n    assert count_charac(\"\") == 0\n\ndef test_string_with_only_spaces():\n    \"\"\"\n    Verifies that a string containing only spaces is counted correctly.\n    This reinforces space counting.\n    \"\"\"\n    assert count_charac(\"   \") == 3\n\ndef test_string_with_unicode_characters():\n    \"\"\"\n    Verifies that Unicode characters are counted correctly, including emojis.\n    This ensures proper handling of multi-byte characters.\n    \"\"\"\n    assert count_charac(\"\u4f60\u597d\u4e16\u754c\") == 4\n    assert count_charac(\"hello\ud83c\udf0d\") == 6\n\ndef test_usage_of_testcase_class():\n    \"\"\"\n    Demonstrates the usage of the TestCase class to verify various scenarios.\n    This showcases the custom test harness as specified in the design.\n    \"\"\"\n    test_cases_data = [\n        (\"simple\", 6),\n        (\"with spaces\", 11),\n        (\"with! punctuation?\", 18),\n        (\"Python programming\", 18), # Another check using TestCase for the main case\n        (\"\", 0),\n        (\"12345\", 5)\n    ]\n\n    for input_str, expected_count in test_cases_data:\n        test_case = TestCase(input_str=input_str, expected=expected_count)\n        # Use pytest's assertion to check the boolean result of TestCase.run()\n        assert test_case.run(), f\"TestCase failed for input: '{input_str}', expected: {expected_count}\"\n\n```"}
{"task_id": "Mbpp/244", "solution": "```python\n# next_perfect_square.py\nimport math\n\ndef next_Perfect_Square(n):\n    \"\"\"Computes the smallest perfect square strictly greater than n.\n    It determines k = floor(sqrt(n)) + 1 and returns k*k as an integer.\n    \"\"\"\n    k = int(math.floor(math.sqrt(n))) + 1\n    return int(k * k)\n```\n\n```python\n# example_usage.py\nfrom next_perfect_square import next_Perfect_Square\n\n# required assertion from SRS\nassert next_Perfect_Square(35) == 36\n\nif __name__ == \"__main__\":\n    # Running the module will execute the assertion and exit normally if it passes.\n    assert next_Perfect_Square(35) == 36\n    print(\"Assertion passed for next_Perfect_Square(35) == 36\")\n\n```"}
{"task_id": "Mbpp/244", "solution": "```python\nfrom math import isqrt\n\ndef next_Perfect_Square(n):\n    \"\"\"Return the smallest perfect square strictly greater than integer n.\n    Assumes n is an integer; math.isqrt handles non-negative integers.\n    \"\"\"\n    k0 = isqrt(n)\n    k = k0 + 1\n    return k * k\n```"}
{"task_id": "Mbpp/245", "solution": "from typing import List, Optional\n\nclass ArrayInput:\n    \"\"\"Represents the input array as a domain object.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values: List[int] = values\n\nclass Element:\n    \"\"\"Represents a single element with value and index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value: int = value\n        self.index: int = index\n\nclass Subsequence:\n    \"\"\"Represents a subsequence and computes its sum.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements: List[Element] = elements\n\n    def sum(self) -> int:\n        return sum(e.value for e in self.elements)\n\nclass BitonicSubsequence(Subsequence):\n    \"\"\"Represents a bitonic subsequence and records its peak index.\"\"\"\n    def __init__(self, elements: List[Element], peakIndex: Optional[int] = None) -> None:\n        super().__init__(elements)\n        self.peakIndex: Optional[int] = peakIndex\n\nclass Result:\n    \"\"\"Encapsulates the algorithm's output.\"\"\"\n    def __init__(self, maxSum: int) -> None:\n        self.maxSum: int = maxSum\n\nclass Algorithm:\n    \"\"\"Implements the algorithm to compute the maximum sum bitonic subsequence.\"\"\"\n    def computeMaxSum(self, input: ArrayInput) -> Result:\n        values = input.values\n        n = len(values)\n\n        if n == 0:\n            return Result(0) # BR-7: If input is empty, return 0.\n\n        inc_sums = self._compute_increasing_sums(values)\n        dec_sums = self._compute_decreasing_sums(values)\n\n        # Initialize with the maximum single element in case no length > 1 bitonic sequence exists.\n        max_overall_sum = max(values)\n\n        # Combine increasing and decreasing sums for each potential peak.\n        # A valid peak at index `i` requires at least one element before `i` (for increasing part)\n        # and at least one element after `i` (for decreasing part).\n        for i in range(n):\n            if inc_sums[i] > values[i] and dec_sums[i] > values[i]:\n                current_sum = inc_sums[i] + dec_sums[i] - values[i]\n                max_overall_sum = max(max_overall_sum, current_sum)\n\n        return Result(max_overall_sum)\n\n    def _compute_increasing_sums(self, values: List[int]) -> List[int]:\n        \"\"\"Returns list of max-sum increasing subsequence sums ending at each index.\"\"\"\n        n = len(values)\n        if n == 0:\n            return []\n        inc_sums = [0] * n\n        for i in range(n):\n            inc_sums[i] = values[i]\n            for j in range(i):\n                if values[j] < values[i]: # Strictly increasing\n                    inc_sums[i] = max(inc_sums[i], values[i] + inc_sums[j])\n        return inc_sums\n\n    def _compute_decreasing_sums(self, values: List[int]) -> List[int]:\n        \"\"\"Returns list of max-sum decreasing subsequence sums starting at each index.\"\"\"\n        n = len(values)\n        if n == 0:\n            return []\n        dec_sums = [0] * n\n        for i in range(n - 1, -1, -1): # Iterate backwards\n            dec_sums[i] = values[i]\n            for j in range(n - 1, i, -1): # Look at elements after i (j > i)\n                if values[j] < values[i]: # Strictly decreasing\n                    dec_sums[i] = max(dec_sums[i], values[i] + dec_sums[j])\n        return dec_sums\n\ndef max_sum(array: List[int]) -> int:\n    \"\"\"Public API: returns int maximum sum of bitonic subsequence.\"\"\"\n    input_obj = ArrayInput(array)\n    algo = Algorithm()\n    result = algo.computeMaxSum(input_obj)\n    return result.maxSum"}
{"task_id": "Mbpp/245", "solution": "from typing import List\n\ndef compute_inc_sums(arr: List[int]) -> List[int]:\n    \"\"\"Computes the maximum sum of a strictly increasing subsequence ending at each index.\"\"\"\n    n = len(arr)\n    inc = [0] * n\n    for i in range(n):\n        inc[i] = arr[i]  # Initialize with the element itself\n        for j in range(i):\n            if arr[j] < arr[i]:\n                inc[i] = max(inc[i], inc[j] + arr[i])\n    return inc\n\ndef compute_dec_sums(arr: List[int]) -> List[int]:\n    \"\"\"Computes the maximum sum of a strictly decreasing subsequence starting at each index.\"\"\"\n    n = len(arr)\n    dec = [0] * n\n    for i in range(n - 1, -1, -1):\n        dec[i] = arr[i]  # Initialize with the element itself\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                dec[i] = max(dec[i], dec[j] + arr[i])\n    return dec\n\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of any bitonic subsequence in the given array.\n    A bitonic subsequence is strictly increasing then strictly decreasing; either part may be length 1.\n    \"\"\"\n    if not arr:\n        return 0\n\n    n = len(arr)\n    \n    # Compute maximum sum of increasing subsequences ending at each index\n    inc_sums = compute_inc_sums(arr)\n    \n    # Compute maximum sum of decreasing subsequences starting at each index\n    dec_sums = compute_dec_sums(arr)\n\n    max_overall_sum = float('-inf')\n\n    # Combine increasing and decreasing sums for each potential peak element\n    for i in range(n):\n        # For arr[i] as the peak, sum of increasing part ending at i + sum of decreasing part starting at i.\n        # Since arr[i] is included in both inc_sums[i] and dec_sums[i], subtract arr[i] once.\n        candidate_sum = inc_sums[i] + dec_sums[i] - arr[i]\n        max_overall_sum = max(max_overall_sum, candidate_sum)\n\n    return int(max_overall_sum)"}
