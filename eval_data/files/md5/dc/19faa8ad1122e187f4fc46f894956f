{"task_id": "Mbpp/392", "solution": "```python\nfrom typing import Dict, Optional\n\nclass MemoizationCache:\n    \"\"\"\n    Provides an in-memory cache for memoization.\n    It stores integer keys mapped to integer values.\n    \"\"\"\n    def __init__(self):\n        self.cache: Dict[int, int] = {}\n\n    def lookup(self, n: int) -> Optional[int]:\n        \"\"\"Looks up a value in the cache by key 'n'.\"\"\"\n        return self.cache.get(n)\n\n    def store(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache with key 'n'.\"\"\"\n        self.cache[n] = value\n\nclass RecurrenceEvaluator:\n    \"\"\"\n    Computes the recurrence f(n) = max(sum(f(floor(n/k))), n)\n    using integer division and a MemoizationCache.\n    \"\"\"\n    def __init__(self, memo: MemoizationCache):\n        self.memo = memo\n\n    def evaluate(self, n: int) -> int:\n        \"\"\"\n        Evaluates f(n) for a non-negative integer n, applying the recurrence relation.\n        It consults the memoization cache before computing.\n        \"\"\"\n        cached_value = self.memo.lookup(n)\n        if cached_value is not None:\n            return cached_value\n\n        if n == 0:\n            self.memo.store(0, 0)\n            return 0\n\n        # Compute subproblem indices using integer (floor) division\n        i2 = n // 2\n        i3 = n // 3\n        i4 = n // 4\n        i5 = n // 5\n\n        # Recursively evaluate subproblems\n        v2 = self.evaluate(i2)\n        v3 = self.evaluate(i3)\n        v4 = self.evaluate(i4)\n        v5 = self.evaluate(i5)\n\n        # Sum the results of subproblems\n        sum_of_subproblems = v2 + v3 + v4 + v5\n\n        # Apply the recurrence relation: max(sum, n)\n        result = max(sum_of_subproblems, n)\n\n        self.memo.store(n, result)\n        return result\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes f(n) = max( f(n/2) + f(n/3) + f(n/4) + f(n/5), n )\n    with base case f(0)=0 and memoization.\n    \"\"\"\n    memo = MemoizationCache()\n    evaluator = RecurrenceEvaluator(memo)\n    return evaluator.evaluate(n)\n```"}
{"task_id": "Mbpp/395", "solution": "```python\nfrom typing import Optional, Dict\n\nclass Character:\n    \"\"\"Represents a single character and its occurrence count.\"\"\"\n    def __init__(self, char: str, count: int) -> None:\n        self._char = char\n        self._count = count\n\n    def char(self) -> str:\n        \"\"\"Returns the character.\"\"\"\n        return self._char\n\n    def count(self) -> int:\n        \"\"\"Returns the occurrence count of the character.\"\"\"\n        return self._count\n\nclass FrequencyMap:\n    \"\"\"Builds and provides counts for characters in a string.\"\"\"\n    def __init__(self) -> None:\n        self._map: Dict[str, int] = {}\n\n    def build(self, input_str: str) -> None:\n        \"\"\"Populates the frequency map from the input string.\"\"\"\n        for char in input_str:\n            self._map[char] = self._map.get(char, 0) + 1\n\n    def get_count(self, c: str) -> int:\n        \"\"\"Returns the count of a given character.\"\"\"\n        return self._map.get(c, 0)\n\nclass Result:\n    \"\"\"Represents the function result: a single-character string or None.\"\"\"\n    def __init__(self, value: Optional[str]) -> None:\n        self.value = value\n        self.isNull = value is None\n\n    def is_null(self) -> bool:\n        \"\"\"Indicates if the result value is None.\"\"\"\n        return self.isNull\n\nclass FirstNonRepeatingFunction:\n    \"\"\"Orchestrates FrequencyMap and scanning to find the first non-repeating character.\"\"\"\n    @staticmethod\n    def first_non_repeating_character(input_str: str) -> Optional[str]:\n        \"\"\"Finds the first non-repeating character in the input string.\"\"\"\n        freq_map = FrequencyMap()\n        freq_map.build(input_str)\n\n        for char in input_str:\n            if freq_map.get_count(char) == 1:\n                return Result(char).value\n        return Result(None).value\n\ndef first_non_repeating_character(input: str) -> Optional[str]:\n    \"\"\"Public API entry point; delegates to the internal orchestration class.\"\"\"\n    return FirstNonRepeatingFunction.first_non_repeating_character(input)\n```"}
{"task_id": "Mbpp/395", "solution": "```python\n\"\"\"\nExposes the first_non_repeating_character(input: str) -> Optional[str] function.\nUsage example:\n    from src.first_non_repeating_character import first_non_repeating_character\n    assert first_non_repeating_character(\"abcabc\") is None\n\"\"\"\nfrom typing import Optional, Dict\n\n\nclass InputString:\n    \"\"\"Encapsulates the input string value and provides length retrieval.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n\nclass CharacterFrequencyMap:\n    \"\"\"Builds and exposes the frequency count mapping of characters.\"\"\"\n    def __init__(self):\n        self.frequencies: Dict[str, int] = {}\n\n    def build(self, input: str) -> None:\n        \"\"\"Builds the frequency map from the given input string.\"\"\"\n        for char in input:\n            self.frequencies[char] = self.frequencies.get(char, 0) + 1\n\n    def get(self, char: str) -> int:\n        \"\"\"Returns the frequency of a character, or 0 if not found.\"\"\"\n        return self.frequencies.get(char, 0)\n\n\nclass FirstNonRepeatingResult:\n    \"\"\"Represents the result of the search (character or absence) and queries existence.\"\"\"\n    def __init__(self, result: Optional[str]):\n        self.result: Optional[str] = result\n\n    def exists(self) -> bool:\n        \"\"\"Checks if a non-repeating character was found.\"\"\"\n        return self.result is not None\n\n\nclass NonRepeatingCharacterFinder:\n    \"\"\"Coordinates frequency computation and ordered scan to find the first non-repeating character.\"\"\"\n    def first_non_repeating_character(self, input: str) -> Optional[str]:\n        \"\"\"Finds the first non-repeating character in the input string.\"\"\"\n        freq_map = self._compute_frequencies(input)\n        result_obj = self._find_first(input, freq_map)\n        return result_obj.result\n\n    def _compute_frequencies(self, input: str) -> CharacterFrequencyMap:\n        \"\"\"Computes character frequencies for the given input string.\"\"\"\n        # InputString is a domain class to encapsulate the input string.\n        input_string_obj = InputString(input)\n        freq_map = CharacterFrequencyMap()\n        # The CharacterFrequencyMap builds its frequencies from the string value.\n        freq_map.build(input_string_obj.value)\n        return freq_map\n\n    def _find_first(self, input: str, freqMap: CharacterFrequencyMap) -> FirstNonRepeatingResult:\n        \"\"\"Scans the input string to find the first non-repeating character, returning a result object.\"\"\"\n        for char in input:\n            if freqMap.get(char) == 1:\n                return FirstNonRepeatingResult(char)\n        return FirstNonRepeatingResult(None)\n\n\ndef first_non_repeating_character(input: str) -> Optional[str]:\n    \"\"\"\n    Finds the first character that does not repeat elsewhere in the string, preserving input order.\n    Delegates to NonRepeatingCharacterFinder for implementation.\n    \"\"\"\n    finder = NonRepeatingCharacterFinder()\n    return finder.first_non_repeating_character(input)\n```"}
{"task_id": "Mbpp/397", "solution": "```python\n# src/median/median.py\nimport math\n\ndef _is_special_float(value: float) -> bool:\n    \"\"\"Checks if a float value is NaN or infinity.\"\"\"\n    return math.isnan(value) or math.isinf(value)\n\ndef _validate_numeric(value) -> None:\n    \"\"\"Validates if value is a valid number, raising exceptions if not.\n    If a float, it also checks for special values like NaN or infinity.\n    \"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(\"Inputs must be numeric (int or float).\")\n    if isinstance(value, float) and _is_special_float(value):\n        raise ValueError(\"Special float values (NaN or infinity) are not allowed.\")\n\ndef _to_float(value) -> float:\n    \"\"\"Converts a validated numeric input to float.\"\"\"\n    return float(value)\n\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Computes the median of three numeric inputs after validating them.\n    Returns the middle value as a float after sorting.\n    \"\"\"\n    _validate_numeric(a)\n    _validate_numeric(b)\n    _validate_numeric(c)\n\n    # Convert to float and store in a list for sorting\n    numbers = [_to_float(a), _to_float(b), _to_float(c)]\n    numbers.sort()\n\n    # The median is the middle element after sorting\n    return numbers[1]\n```\n\n```python\n# src/median/__init__.py\nfrom .median import median_numbers\n\n__all__ = [\"median_numbers\"]\n```"}
{"task_id": "Mbpp/397", "solution": "```python\n# src/median.py\nfrom typing import Any\n\nclass NumericArgument:\n    \"\"\"Wraps an input value and provides a numeric check.\n    Checks if the value is an integer or float.\n    \"\"\"\n    def __init__(self, value: Any):\n        self._value = value\n\n    def isNumeric(self) -> bool:\n        \"\"\"Returns True if the wrapped value is an int or float.\"\"\"\n        return isinstance(self._value, (int, float))\n\nclass Result:\n    \"\"\"Encapsulates the computed float median value.\"\"\"\n    def __init__(self, value: float):\n        self._value = value\n\n    def value(self) -> float:\n        \"\"\"Returns the encapsulated float median.\"\"\"\n        return self._value\n\nclass MedianFunction:\n    \"\"\"Implements validation and median computation logic.\n    Ensures O(1) time and space complexity.\n    \"\"\"\n    def validateInputs(self, a: Any, b: Any, c: Any) -> None:\n        \"\"\"Validates that all three inputs are numeric.\n        Raises TypeError if any input is not an int or float.\n        \"\"\"\n        if not NumericArgument(a).isNumeric():\n            raise TypeError(\"Input 'a' must be numeric (int or float).\")\n        if not NumericArgument(b).isNumeric():\n            raise TypeError(\"Input 'b' must be numeric (int or float).\")\n        if not NumericArgument(c).isNumeric():\n            raise TypeError(\"Input 'c' must be numeric (int or float).\")\n\n    def _compute_median(self, a: float, b: float, c: float) -> float:\n        \"\"\"Computes the median of three numeric values.\n        Uses sum - min - max for O(1) complexity.\n        \"\"\"\n        return float(a + b + c - min(a, b, c) - max(a, b, c))\n\n    def median_numbers(self, a: Any, b: Any, c: Any) -> float:\n        \"\"\"Validates inputs, computes median, and returns it as a float.\n        This method delegates to validation and computation helpers.\n        \"\"\"\n        self.validateInputs(a, b, c)\n        float_a, float_b, float_c = float(a), float(b), float(c)\n        median_val = self._compute_median(float_a, float_b, float_c)\n        return Result(median_val).value()\n\ndef median_numbers(a: Any, b: Any, c: Any) -> float:\n    \"\"\"Provides a top-level function to find the median of three numbers.\n    Delegates validation and computation to MedianFunction.\n    \"\"\"\n    return MedianFunction().median_numbers(a, b, c)\n\n```\n```python\n# tests/test_median.py\nimport sys\nimport os\n\n# Add src directory to Python path to import median_numbers\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'src')))\n\nfrom median import median_numbers\n\nclass UnitTest:\n    \"\"\"A simple test harness for the median_numbers function.\n    It runs the normative test case and verifies error handling.\n    \"\"\"\n    def run(self) -> None:\n        \"\"\"Executes the required test assertion and additional checks.\n        Reports test success or failure for each case.\n        \"\"\"\n        print(\"Running median_numbers tests...\")\n\n        # Normative example from SRS\n        result = median_numbers(25, 55, 65)\n        expected = 55.0\n        assert result == expected, f\"Test failed: Expected {expected}, got {result}\"\n        print(f\"PASS: median_numbers(25, 55, 65) == {result}\")\n\n        # Additional order invariance tests\n        assert median_numbers(65, 25, 55) == 55.0, \"FAIL: Order invariance (65,25,55)\"\n        print(f\"PASS: median_numbers(65, 25, 55) == 55.0\")\n        assert median_numbers(55, 65, 25) == 55.0, \"FAIL: Order invariance (55,65,25)\"\n        print(f\"PASS: median_numbers(55, 65, 25) == 55.0\")\n        assert median_numbers(25, 65, 55) == 55.0, \"FAIL: Order invariance (25,65,55)\"\n        print(f\"PASS: median_numbers(25, 65, 55) == 55.0\")\n\n        # Test with float inputs\n        assert median_numbers(1.0, 2.5, 3.0) == 2.5, \"FAIL: Float inputs test\"\n        print(f\"PASS: median_numbers(1.0, 