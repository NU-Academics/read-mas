{"task_id": "Mbpp/68", "solution": "```python\n# src/monotonic.py\nfrom typing import List\nimport numbers\n\nclass InputList:\n    \"\"\"Lightweight wrapper for the input sequence; normalized access to elements and length.\"\"\"\n    def __init__(self, items: List[numbers.Number]):\n        self.elements = items\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated list.\"\"\"\n        return len(self.elements)\n\nclass Validation:\n    \"\"\"Validates input structure and element types, enforcing BR6.\"\"\"\n    def is_list(self, input_value) -> bool:\n        \"\"\"Checks if the input_value is a list.\"\"\"\n        return isinstance(input_value, list)\n\n    def elements_are_numbers(self, input_value) -> bool:\n        \"\"\"Checks if all elements in the input_value are numeric.\"\"\"\n        for element in input_value:\n            if not isinstance(element, numbers.Number):\n                return False\n        return True\n\nclass Result:\n    \"\"\"Encapsulates boolean result and optional reasoning string.\"\"\"\n    def __init__(self, value: bool, reasoning: str = \"\"):\n        self.value = value\n        self.reasoning = reasoning\n\nclass MonotonicChecker:\n    \"\"\"Evaluates whether an InputList is monotonic using a single-pass algorithm.\"\"\"\n    def check_non_increasing(self, items: InputList) -> bool:\n        \"\"\"Checks if the InputList is entirely non-increasing.\"\"\"\n        if items.length() <= 1:\n            return True\n        for i in range(items.length() - 1):\n            if items.elements[i] < items.elements[i+1]:\n                return False\n        return True\n\n    def check_non_decreasing(self, items: InputList) -> bool:\n        \"\"\"Checks if the InputList is entirely non-decreasing.\"\"\"\n        if items.length() <= 1:\n            return True\n        for i in range(items.length() - 1):\n            if items.elements[i] > items.elements[i+1]:\n                return False\n        return True\n\n    def is_Monotonic(self, input_list: InputList) -> bool:\n        \"\"\"Coordinates non-increasing and non-decreasing checks to determine monotonicity.\"\"\"\n        if input_list.length() <= 1:\n            return Result(value=True, reasoning=\"Empty or single-element list is monotonic.\").value\n\n        is_non_increasing = self.check_non_increasing(input_list)\n        if is_non_increasing:\n            result_obj = Result(value=True, reasoning=\"List is non-increasing.\")\n        else:\n            is_non_decreasing = self.check_non_decreasing(input_list)\n            if is_non_decreasing:\n                result_obj = Result(value=True, reasoning=\"List is non-decreasing.\")\n            else:\n                result_obj = Result(value=False, reasoning=\"List is neither non-increasing nor non-decreasing.\")\n        return result_obj.value\n\ndef is_Monotonic(items: List[numbers.Number]) -> bool:\n    \"\"\"\n    Determines if a given list of numeric values is monotonic.\n    Validates input and delegates to MonotonicChecker for evaluation.\n    \"\"\"\n    validator = Validation()\n    if not validator.is_list(items):\n        raise TypeError(\"Input 'items' must be a list/sequence.\")\n    if not validator.elements_are_numbers(items):\n        raise TypeError(\"All elements in 'items' must be numeric.\")\n\n    input_list = InputList(items)\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(input_list)\n```\n```python\n# src/__init__.py\nfrom .monotonic import is_Monotonic\n```"}
{"task_id": "Mbpp/69", "solution": "```python\ndef is_sublist(main_list, sub_list):\n    \"\"\"Checks if sub_list appears as a contiguous subsequence in main_list.\n    Returns False if sub_list is longer, or if no contiguous match is found.\n    \"\"\"\n    if len(sub_list) > len(main_list):\n        return False\n\n    # An empty sublist is considered a contiguous sublist of any list.\n    if not sub_list:\n        return True\n\n    # Iterate through main_list to find a contiguous matching slice.\n    # The loop considers all possible starting positions for sub_list.\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i + len(sub_list)] == sub_list:\n            return True\n\n    return False\n```"}
{"task_id": "Mbpp/67", "solution": "```python\n# bell.py\n\n\"\"\"\nA minimal Python library module for computing Bell numbers.\nIt provides bell_number(n) to find the number of ways to partition a set of size n.\n\"\"\"\n\ndef validate(n):\n    \"\"\"\n    Ensures 'n' is a non-negative integer.\n    Raises ValueError if 'n' is not an int or is negative.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\ndef bell_number(n):\n    \"\"\"\n    Computes the Bell number for a non-negative integer 'n'.\n    Accepts `n` (int, n >= 0), returns `int`, and raises `ValueError` for invalid inputs.\n    \"\"\"\n    validate(n)\n\n    if n == 0:\n        return 1\n\n    # Uses the Bell triangle (Aitken's array) computation method.\n    bell_triangle_row = [1] # Current row, initialized for B_0\n\n    for i in range(1, n + 1):\n        next_row = [bell_triangle_row[-1]] # First element of next row is last of previous\n        for j in range(1, i + 1):\n            next_row.append(next_row[-1] + bell_triangle_row[j-1])\n        bell_triangle_row = next_row\n    \n    return bell_triangle_row[0] # B_n is the first element of the final row\n\n```\n```python\n# test_bell.py\n\n\"\"\"\nAutomated plain-Python test script for the bell module.\nIt asserts bell.bell_number(2) == 2 when executed.\n\"\"\"\n\nimport bell\n\ndef run_tests():\n    \"\"\"\n    Runs the unit tests for the bell module.\n    Asserts bell.bell_number(2) equals 2.\n    \"\"\"\n    assert bell.bell_number(2) == 2\n\nif __name__ == \"__main__\":\n    run_tests()\n\n```"}
{"task_id": "Mbpp/67", "solution": "```python\n# src/bellnumber/__init__.py\nfrom .calculator import bell_number\n\n__all__ = [\"bell_number\"]\n```\n```python\n# src/bellnumber/validator.py\nclass InputValidator:\n    \"\"\"\n    Encapsulates input validation rules.\n    Raises TypeError for non-int, ValueError for n < 0.\n    \"\"\"\n    @staticmethod\n    def validate(n):\n        \"\"\"\n        Validate input n.\n        Raises TypeError if not int; raises ValueError if n < 0.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n\n```\n```python\n# src/bellnumber/result.py\nclass BellNumberResult:\n    \"\"\"Lightweight BellNumberResult data holder for (n, value) pair.\"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\n\n```\n```python\n# src/bellnumber/calculator.py\nfrom .validator import InputValidator\n# from .result import BellNumberResult # Result holder not strictly needed for computeBell's return type.\n\nclass BellNumberCalculator:\n    \"\"\"\n    Computes Bell numbers using the Bell triangle method.\n    Orchestrates validation and computation.\n    \"\"\"\n    def computeBell(self, n: int) -> int:\n        \"\"\"\n        Compute Bell number B(n) for n >= 0.\n        Base case: n == 0 returns 1.\n        \"\"\"\n        if n == 0:\n            return 1\n\n        # Initialize a Bell triangle (dynamic programming)\n        bell = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: B(0) = 1\n        bell[0][0] = 1\n\n        # Fill the Bell triangle\n        for i in range(1, n + 1):\n            # The first element of each row is the last element of the previous row\n            bell[i][0] = bell[i-1][i-1]\n            for j in range(1, i + 1):\n                # Each subsequent element is the sum of the element above-left and the element to its left\n                bell[i][j] = bell[i-1][j-1] + bell[i][j-1]\n        \n        # The Bell number B(n) is the first element of row n\n        return bell[n][0]\n\n    def bell_number(self, n: int) -> int:\n        \"\"\"\n        Orchestrate validation and computation for Bell number B(n).\n        Returns the computed integer B(n).\n        \"\"\"\n        InputValidator.validate(n)\n        return self.computeBell(n)\n\n# Public API function required by SRS. Delegates to BellNumberCalculator.bell_number.\n_calculator = BellNumberCalculator()\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Provides the Bell number B(n) for a non-negative integer n.\n    Raises TypeError for non-integers, ValueError for negative integers.\n    \"\"\"\n    return _calculator.bell_number(n)\n\n```\n```python\n# tests/test_bell_number.py\nimport pytest\nfrom bellnumber import bell_number\n\ndef test_bell_number_known_values():\n    \"\"\"Asserts bell_number returns correct values for known inputs.\"\"\"\n    assert bell_number(0) == 1\n    assert bell_number(1) == 1\n    assert bell_number(2) == 2\n    assert bell_number(3) == 5\n    assert bell_number(4) == 15\n    assert bell_number(5) == 52\n\ndef test_bell_number_invalid_type():\n    \"\"\"Asserts TypeError for non-integer inputs.\"\"\"\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        bell_number(2.0)\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        bell_number(\"2\")\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        bell_number(None)\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        bell_number([2])\n\ndef test_bell_number_negative():\n    \"\"\"Asserts ValueError for negative integer inputs.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be a non-negative integer.\"):\n        bell_number(-1)\n    with pytest.raises(ValueError, match=\"Input must be a non-negative integer.\"):\n        bell_number(-10)\n\n```"}
{"task_id": "Mbpp/68", "solution": "```python\n# src/is_monotonic.py\n\ndef _is_non_increasing(array):\n    \"\"\"Checks if the array is non-increasing.\n    Allows equal adjacent elements.\"\"\"\n    for i in range(1, len(array)):\n        if array[i] > array[i-1]:\n            return False\n    return True\n\ndef _is_non_decreasing(array):\n    \"\"\"Checks if the array is non-decreasing.\n    Allows equal adjacent elements.\"\"\"\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            return False\n    return True\n\ndef is_Monotonic(array):\n    \"\"\"Return True if 'array' is monotonic (non-increasing OR non-decreasing), else False.\n    Input: array (list of numbers).\"\"\"\n    return _is_non_increasing(array) or _is_non_decreasing(array)\n```\n\n```python\n# tests/test_is_monotonic.py\n\nfrom src.is_monotonic import is_Monotonic\n\ndef test_provided_assertion():\n    \"\"\"Verify the core behavior with the specified acceptance test case.\n    This test asserts that [6, 5, 4, 4] is monotonic.\"\"\"\n    assert is_Monotonic([6, 5, 4, 4]) == True\n```"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list) -> bool:\n    \"\"\"\n    Checks if sub_list appears as a contiguous subsequence of main_list.\n    Returns True if found, False otherwise, including when sub_list is longer.\n    \"\"\"\n    if len(sub_list) > len(main_list):\n        return False\n\n    if not sub_list:  # An empty list is a sublist of any list.\n        return True\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/70", "solution": "```python\n# src/domain.py\n\"\"\"Domain datatypes for get_equal SRS\"\"\"\n\nfrom typing import List, Tuple as TypingTuple, Any\n\nclass Tuple:\n    \"\"\"Represent an ordered collection of elements with a length().\"\"\"\n    def __init__(self, elements: TypingTuple[Any, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass TupleList:\n    \"\"\"Represent a collection of Tuple domain objects.\"\"\"\n    def __init__(self, tuples: List[Tuple]) -> None:\n        self.tuples = tuples\n\n    def count(self) -> int:\n        \"\"\"Returns the number of tuples in the list.\"\"\"\n        return len(self.tuples)\n\n    def lengths(self) -> List[int]:\n        \"\"\"Returns a list of each tuple's length.\"\"\"\n        return [t.length() for t in self.tuples]\n\nclass BooleanResult:\n    \"\"\"Simple holder for a boolean result produced by get_equal.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\n```\n\n```python\n# src/get_equal.py\n\"\"\"Implementation of get_equal(tuple_list) -> bool as required by SRS\"\"\"\n\nfrom typing import List, Tuple as TypingTuple, Any\nfrom src.domain import TupleList, Tuple as DomainTuple, BooleanResult\n\ndef get_equal(tuple_list: list[tuple]) -> bool:\n    \"\"\"\n    Determines whether all tuples in the input list have equal length.\n    Returns True if all tuples have the same length, False otherwise.\n    \"\"\"\n    # Validate that tuple_list is a list; if not, raise TypeError.\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input 'tuple_list' must be a list.\")\n\n    # Wrap each input tuple into domain Tuple (DomainTuple) and construct a TupleList.\n    domain_tuples = []\n    for item in tuple_list:\n        # Check if item is a Python tuple before wrapping.\n        if not isinstance(item, TypingTuple):\n            raise TypeError(f\"All items in 'tuple_list' must be tuples, but found type {type(item).__name__}\")\n        domain_tuples.append(DomainTuple(item))\n\n    domain_tuple_list = TupleList(domain_tuples)\n\n    # If 0 or 1 tuple present, return True (documented choice).\n    if domain_tuple_list.count() <= 1:\n        return BooleanResult(True).value\n\n    # Compute lengths via TupleList.lengths().\n    lengths = domain_tuple_list.lengths()\n\n    # Compare lengths for equality.\n    # Return True if all lengths are equal, otherwise False.\n    first_length = lengths[0]\n    all_equal = all(length == first_length for length in lengths)\n    \n    return BooleanResult(all_equal).value\n\n```\n\n```python\n# tests/test_get_equal.py\n\"\"\"Unit tests that verify acceptance criteria from the SRS.\"\"\"\n\nfrom src.get_equal import get_equal\n\ndef test_get_equal_all_same_length():\n    \"\"\"\n    Verifies that get_equal returns True for a list of tuples with equal lengths.\n    Corresponds to FR2 acceptance criterion.\n    \"\"\"\n    assert get_equal([(11, 22, 33), (44, 55, 66)]) is True\n\ndef test_get_equal_different_lengths():\n    \"\"\"\n    Verifies that get_equal returns False for a list of tuples with different lengths.\n    Corresponds to FR3 acceptance criterion.\n    \"\"\"\n    assert get_equal([(1, 2), (3, 4, 5)]) is False\n\ndef test_get_equal_empty_list():\n    \"\"\"Verifies the documented behavior for an empty input list.\"\"\"\n    assert get_equal([]) is True\n\ndef test_get_equal_single_tuple_list():\n    \"\"\"Verifies the documented behavior for a list with a single tuple.\"\"\"\n    assert get_equal([(1, 2, 3)]) is True\n\ndef test_get_equal_non_list_input_raises_type_error():\n    \"\"\"Verifies that a non-list input raises TypeError.\"\"\"\n    try:\n        get_equal(\"not a list\") # type: ignore\n        assert False, \"TypeError was not raised for non-list input\"\n    except TypeError as e:\n        assert str(e) == \"Input 'tuple_list' must be a list.\"\n\ndef test_get_equal_list_with_non_tuple_item_raises_type_error():\n    \"\"\"Verifies that a list containing non-tuple items raises TypeError.\"\"\"\n    try:\n        get_equal([(1, 2), \"not a tuple\"]) # type: ignore\n        assert False, \"TypeError was not raised for non-tuple item\"\n    except TypeError as e:\n        assert str(e) == \"All items in 'tuple_list' must be tuples, but found type str\"\n\n```"}
