{"task_id": "Mbpp/84", "solution": "To implement the provided software design specification, we will create two files: `src/newman_conway.py` for the core logic and API, and `tests/test_sequence.py` for the unit test.\n\n```python\n# src/newman_conway.py\n\nclass NewmanConwaySequence:\n    \"\"\"\n    Computes Newman-Conway sequence values using recurrence and memoization.\n    Maintains a memoization dictionary for performance during a single computation.\n    \"\"\"\n    def __init__(self):\n        self.memo: dict[int, int] = {1: 1, 2: 1}\n\n    def a(self, n: int) -> int:\n        \"\"\"\n        Recursively computes the nth Newman-Conway number with memoization.\n        Fetches from memo if available, otherwise computes and stores.\n        \"\"\"\n        if n in self.memo:\n            return self.memo[n]\n\n        # For n > 2, a(n) = a(a(n-1)) + a(n - a(n-1))\n        prev_val = self.a(n - 1)\n        result = self.a(prev_val) + self.a(n - prev_val)\n        self.memo[n] = result\n        return result\n\n\nclass SequenceFunction:\n    \"\"\"\n    API fa\u00e7ade for the Newman-Conway sequence, handling input validation.\n    Delegates the actual computation to an instance of NewmanConwaySequence.\n    \"\"\"\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Validates input n to be a positive integer and returns the nth Newman-Conway number.\n        Raises ValueError for invalid inputs as per design.\n        \"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n        # Create a new computation core instance for each top-level call to ensure per-call memoization.\n        computation_core = NewmanConwaySequence()\n        return computation_core.a(n)\n\n# Module-level API entry point.\n# An instance of SequenceFunction is created once at module load.\n_sequence_api_facade = SequenceFunction()\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    The public API function to get the nth Newman-Conway sequence value.\n    This function delegates to the internal SequenceFunction for validation and computation.\n    \"\"\"\n    return _sequence_api_facade.sequence(n)\n\n```\n```python\n# tests/test_sequence.py\n\nimport unittest\nimport sys\nimport os\n\n# Adjusting the Python path to allow importing the module from 'src'\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.dirname(current_dir) # Go up from 'tests' to the project root\nsys.path.insert(0, os.path.join(project_root, 'src'))\n\nfrom newman_conway import sequence\n\nclass TestSequence(unittest.TestCase):\n    \"\"\"\n    Unit tests for the Newman-Conway sequence function.\n    Verifies key values and input validation as specified.\n    \"\"\"\n    def test_sequence_10_equals_6(self):\n        \"\"\"\n        Asserts that sequence(10) returns 6, verifying the regression test requirement.\n        \"\"\"\n        self.assertEqual(sequence(10), 6)\n\n    def test_invalid_input_raises_value_error(self):\n        \"\"\"\n        Tests that calling sequence with non-positive integers or non-integer types raises ValueError.\n        \"\"\"\n        with self.assertRaises(ValueError):\n            sequence(0)\n        with self.assertRaises(ValueError):\n            sequence(-1)\n        with self.assertRaises(ValueError):\n            sequence(3.14)\n        with self.assertRaises(ValueError):\n            sequence(\"ten\")\n\n```"}
