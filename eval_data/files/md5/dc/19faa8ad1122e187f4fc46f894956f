{"task_id": "Mbpp/99", "solution": "class Error:\n    \"\"\"A simple error message container.\"\"\"\n    def __init__(self, message: str):\n        self.message: str = message\n\nclass InvalidInputError(Exception):\n    \"\"\"Concrete exception raised for invalid inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message: str = message\n\nclass DecimalNumber:\n    \"\"\"Represents an integer input value.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass BinaryString:\n    \"\"\"Represents a binary output string.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass InputValidator:\n    \"\"\"Encapsulates validation policy for inputs.\"\"\"\n    @staticmethod\n    def is_integer(value) -> bool:\n        \"\"\"Return True if value is an instance of int.\"\"\"\n        return isinstance(value, int)\n\n    @staticmethod\n    def ensure_integer(value) -> None:\n        \"\"\"Raise InvalidInputError if value is not an int.\"\"\"\n        if not InputValidator.is_integer(value):\n            raise InvalidInputError(f\"Input must be an integer, got {type(value).__name__}.\")\n\nclass DecimalToBinary:\n    \"\"\"Stateless implementation of decimal to canonical binary string conversion.\"\"\"\n    @staticmethod\n    def decimal_to_binary(value: int) -> str:\n        \"\"\"Converts a validated integer to a canonical binary string.\"\"\"\n        if value == 0:\n            return \"0\"\n        return bin(value)[2:]\n\ndef decimal_to_binary(value: int) -> str:\n    \"\"\"Public API: Validates input, then converts decimal to canonical binary string.\"\"\"\n    InputValidator.ensure_integer(value)\n    return DecimalToBinary.decimal_to_binary(value)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a decimal integer to its binary string representation.\n    Handles non-negative integers; 0 returns \"0\", positive integers return binary without leading zeros.\n    \"\"\"\n    if n == 0:\n        return \"0\"\n\n    binary_string = []\n    while n > 0:\n        binary_string.append(str(n % 2))\n        n //= 2\n    return \"\".join(binary_string[::-1])"}
