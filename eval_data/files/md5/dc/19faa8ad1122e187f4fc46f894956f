{"task_id": "Mbpp/9", "solution": "```python\n# src/find_rotations/validator.py\nclass InvalidInputError(Exception):\n    \"\"\"Domain-specific exception for invalid input.\"\"\"\n    def __init__(self, message: str = \"Invalid input: empty string\"):\n        super().__init__(message)\n\nclass InputString:\n    \"\"\"Validates if a string is non-empty.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if the string is non-empty, False otherwise.\"\"\"\n        return bool(self.value)\n\n# src/find_rotations/rotation.py\nclass RotationOperation:\n    \"\"\"Handles cyclic string rotation operations.\"\"\"\n    def rotate(self, s: str, k: int) -> str:\n        \"\"\"Performs a cyclic shift of string s by k positions to the left.\"\"\"\n        if not s:\n            return s\n        actual_k = k % len(s)\n        return s[actual_k:] + s[:actual_k]\n\n# src/find_rotations/analyzer.py\nfrom .validator import InputString, InvalidInputError\nfrom .rotation import RotationOperation\n\nclass RotationResult:\n    \"\"\"A simple container for the rotation result k.\"\"\"\n    def __init__(self, k: int):\n        self.k = k\n\nclass RotationAnalyzer:\n    \"\"\"Analyzes a string to find its minimum positive rotation.\"\"\"\n    def find_Rotations(self, s: str) -> int:\n        \"\"\"Computes the minimum rotation k for a string s.\"\"\"\n        input_validator = InputString(s)\n        if not input_validator.validate():\n            raise InvalidInputError()\n\n        n = len(s)\n        rotation_op = RotationOperation()\n\n        for k in range(1, n + 1):\n            rotated_s = rotation_op.rotate(s, k)\n            if rotated_s == s:\n                return RotationResult(k).k\n        \n        # This part should ideally not be reached if the loop condition and logic are correct,\n        # as k=n always returns the original string.\n        return RotationResult(n).k\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive rotation k such that rotating s by k positions yields s again.\n    Raises InvalidInputError for empty input strings.\n    \"\"\"\n    analyzer = RotationAnalyzer()\n    return analyzer.find_Rotations(s)\n\n# src/find_rotations/__init__.py\nfrom .analyzer import find_Rotations\nfrom .validator import InvalidInputError\n\n__all__ = [\"find_Rotations\", \"InvalidInputError\"]\n```"}
{"task_id": "Mbpp/11", "solution": "```python\ndef remove_Occ(input_string, character):\n    \"\"\"Remove first and last occurrence of 'character' from 'input_string'.\n    Uses string.find, string.rfind, and slicing for removal.\n    \"\"\"\n    first_idx = input_string.find(character)\n    last_idx = input_string.rfind(character)\n\n    if first_idx == -1:\n        # Character not found at all, return original string.\n        return input_string\n    elif first_idx == last_idx:\n        # Character found only once, remove that single occurrence.\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Character found multiple times, remove both first and last.\n        # This constructs the new string by concatenating parts:\n        # before first_idx, between first_idx+1 and last_idx, and after last_idx+1.\n        return input_string[:first_idx] + input_string[first_idx + 1:last_idx] + input_string[last_idx + 1:]\n```"}
{"task_id": "Mbpp/11", "solution": "def find_first(input_string: str, character: str) -> int | None:\n    \"\"\"Finds the index of the first occurrence of a character.\n    Returns the index or None if not found.\"\"\"\n    idx = input_string.find(character)\n    if idx == -1:\n        return None\n    return idx\n\ndef find_last(input_string: str, character: str) -> int | None:\n    \"\"\"Finds the index of the last occurrence of a character.\n    Returns the index or None if not found.\"\"\"\n    idx = input_string.rfind(character)\n    if idx == -1:\n        return None\n    return idx\n\ndef remove_Occ(input_string: str, character: str) -> str:\n    \"\"\"Removes the first and last occurrence of a character from a string.\n    If the character appears only once, it is removed once.\"\"\"\n    first_idx = find_first(input_string, character)\n    \n    if first_idx is None:\n        return input_string  # Character not found\n    \n    last_idx = find_last(input_string, character)\n\n    if first_idx == last_idx:\n        # Only one occurrence found, remove it\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Multiple occurrences\n        # Remove the first occurrence\n        string_after_first_removal = input_string[:first_idx] + input_string[first_idx + 1:]\n        \n        # Adjust the last index because the string length changed due to the first removal.\n        # If last_idx was after first_idx, its position in the new string is shifted left by 1.\n        adjusted_last_idx = last_idx - 1 if last_idx > first_idx else last_idx\n        \n        # Remove the (adjusted) last occurrence\n        return string_after_first_removal[:adjusted_last_idx] + string_after_first_removal[adjusted_last_idx + 1:]"}
{"task_id": "Mbpp/9", "solution": "```python\n# find_rotations/rotation_algorithm.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass RotationResult:\n    \"\"\"A simple data holder for the rotation count k.\"\"\"\n    k: int\n\nclass RotationAlgorithm:\n    \"\"\"Core logic for finding string rotations and performing rotations.\"\"\"\n\n    def rotate(self, s: str, k: int) -> str:\n        \"\"\"Rotates string s left by k positions.\"\"\"\n        return s[k:] + s[:k]\n\n    def find_Rotations(self, s: str) -> int:\n        \"\"\"Finds the minimal positive integer k to rotate s back to itself.\"\"\"\n        n = len(s)\n        for k_val in range(1, n + 1):\n            if self.rotate(s, k_val) == s:\n                return k_val\n        return n # Return len(s) if no smaller rotation is found, as per design.\n\n# find_rotations/validator.py\nclass Validator:\n    \"\"\"Enforces input preconditions for string rotation functions.\"\"\"\n\n    def validate_type(self, s) -> None:\n        \"\"\"Checks if the input is a string, raising TypeError otherwise.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input must be a string.\")\n\n    def validate_non_empty(self, s: str) -> None:\n        \"\"\"Checks if the string is non-empty, raising ValueError otherwise.\"\"\"\n        if len(s) < 1:\n            raise ValueError(\"Input string cannot be empty.\")\n\n# find_rotations/__init__.py\nfrom find_rotations.rotation_algorithm import RotationAlgorithm\nfrom find_rotations.validator import Validator\n\ndef find_Rotations(s) -> int:\n    \"\"\"\n    Public entry point to find the minimal positive integer k (1 <= k <= len(s))\n    such that rotating s left by k returns s.\n    \"\"\"\n    validator = Validator()\n    algorithm = RotationAlgorithm()\n\n    validator.validate_type(s)\n    validator.validate_non_empty(s)\n\n    result_k = algorithm.find_Rotations(s)\n\n    # Ensure returned value is int and >= 1, as per design specification.\n    if not isinstance(result_k, int) or result_k < 1:\n        raise AssertionError(\"Internal algorithm returned an invalid rotation count.\")\n\n    return result_k\n\n# tests/test_find_rotations.py\nimport sys\nimport os\n\n# Add the parent directory of 'find_rotations' to sys.path\n# This allows importing 'find_rotations' as a package for direct script execution.\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))\n\nfrom find_rotations import find_Rotations\n\nclass TestCase:\n    \"\"\"A simple test case class to encapsulate input, expected, and assertion logic.\"\"\"\n    def __init__(self, name: str, input_str: str, expected: int):\n        self.name = name\n        self.input_str = input_str\n        self.expected = expected\n\n    def run(self):\n        \"\"\"Executes the test case by calling find_Rotations and asserting the result.\"\"\"\n        print(f\"Running test: {self.name} with input '{self.input_str}'\")\n        actual_result = find_Rotations(self.input_str)\n        assert actual_result == self.expected, \\\n            f\"Test '{self.name}' failed: Expected {self.expected}, got {actual_result}\"\n        print(f\"Test '{self.name}' passed.\")\n\n# Module-level test harness as specified in the design.\nif __name__ == \"__main__\":\n    print(\"Executing tests for find_Rotations package...\")\n\n    # The required assertion from the design specification.\n    test_case = TestCase(\"Required 'aaaa' test\", \"aaaa\", 1)\n    test_case.run()\n\n    print(\"\\nAll specified tests finished.\")\n```"}
{"task_id": "Mbpp/14", "solution": "```python\n# src/volume_calculator.py\n\nclass TriangularPrism:\n    \"\"\"Models a triangular prism with given dimensions.\n    Computes its volume based on these dimensions.\"\"\"\n\n    def __init__(self, base: float, height: float, length: float):\n        self.base = base\n        self.height = height\n        self.length = length\n\n    def volume(self) -> float:\n        \"\"\"Calculates the volume of the triangular prism.\n        Uses the formula 0.5 * base * height * length.\"\"\"\n        return 0.5 * self.base * self.height * self.length\n\n\nclass VolumeCalculator:\n    \"\"\"Provides a static method to calculate the volume of a triangular prism.\n    This class acts as a stateless service for volume computation.\"\"\"\n\n    @staticmethod\n    def find_Volume(base: float, height: float, length: float) -> float:\n        \"\"\"Calculates the volume by creating a TriangularPrism instance.\n        Delegates the actual volume computation to the TriangularPrism object.\"\"\"\n        prism = TriangularPrism(base, height, length)\n        return prism.volume()\n\n\ndef find_Volume(base, height, length):\n    \"\"\"Calculates the volume of a triangular prism using its base, height, and length.\n    This is the public entry point, delegating to VolumeCalculator for the computation.\"\"\"\n    return VolumeCalculator.find_Volume(base, height, length)\n\n```\n```python\n# tests/test_find_volume.py\n\nfrom src.volume_calculator import find_Volume\n\nclass UnitTest:\n    \"\"\"A simple unit test harness to run specific assertions.\n    It tracks the success status of its executed test.\"\"\"\n\n    def __init__(self, name: str):\n        self.name = name\n        self.passes = False\n\n    def run(self) -> bool:\n        \"\"\"Executes the required test assertion for find_Volume.\n        This method verifies find_Volume(10,8,6) == 240 and updates test status.\"\"\"\n        assert find_Volume(10, 8, 6) == 240\n        self.passes = True\n        return self.passes\n\n# Execute the required unit test directly as part of the module's top-level execution.\n# This fulfills the \"top-level test assertion\" and ensures it runs when the file is executed.\ntest_instance = UnitTest(\"TestTriangularPrismVolume\")\ntest_instance.run()\n\n```"}
{"task_id": "Mbpp/12", "solution": "```python\nfrom typing import List, Union, Any\n\n# Define Number type for clarity\nNumber = Union[int, float]\n\n# --- src/domain.py ---\nclass Row:\n    \"\"\"Represents a single row of numeric elements with its original index.\"\"\"\n    def __init__(self, elements: List[Number], index: int):\n        self.elements: List[Number] = list(elements)  # Copy elements for immutability\n        self.index: int = index\n\n    def sum(self) -> float:\n        \"\"\"Computes the arithmetic sum of the row's numeric elements.\"\"\"\n        return float(sum(self.elements))\n\nclass Matrix:\n    \"\"\"Aggregates Row objects and provides row-oriented operations.\"\"\"\n    def __init__(self, rows: List[Row]):\n        self.rows: List[Row] = list(rows) # Copy rows list itself for domain immutability\n\n    def get_row_sums(self) -> List[float]:\n        \"\"\"Calculates and returns a list of sums for each row.\"\"\"\n        return [row.sum() for row in self.rows]\n\n# --- src/validator.py ---\ndef validate_matrix(matrix_input: Any) -> None:\n    \"\"\"\n    Validates the input matrix for correct structure and numeric elements.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    if not isinstance(matrix_input, list):\n        raise TypeError(\"Input must be a list (matrix).\")\n\n    if not matrix_input: # An empty matrix is valid.\n        return\n\n    for i, row in enumerate(matrix_input):\n        if not isinstance(row, list):\n            raise TypeError(f\"Matrix row at index {i} must be a list.\")\n        for j, element in enumerate(row):\n            if not isinstance(element, (int, float)):\n                raise ValueError(\n                    f\"Matrix element at row {i}, column {j} must be a numeric type (int or float). \"\n                    f\"Got {type(element).__name__} with value {element}.\"\n                )\n\n# --- src/sum_calculator.py ---\ndef calculate_row_sums(matrix_domain: Matrix) -> List[float]:\n    \"\"\"Computes numeric sums for each row in the domain Matrix.\"\"\"\n    return matrix_domain.get_row_sums()\n\n# --- src/sort_engine.py ---\ndef stable_sort_rows(matrix_domain: Matrix, row_sums: List[float]) -> Matrix:\n    \"\"\"\n    Returns a new Matrix with rows sorted stably by their sums.\n    Original indices are used for tie-breaking to ensure stability.\n    \"\"\"\n    # Pair (row_sum, original_index, Row object) for sorting\n    rows_with_sums_and_indices = []\n    for i, row in enumerate(matrix_domain.rows):\n        rows_with_sums_and_indices.append((row_sums[i], row.index, row))\n\n    # Sort stably by row_sum, then by original_index for ties\n    sorted_rows_with_sums_and_indices = sorted(\n        rows_with_sums_and_indices, key=lambda x: (x[0], x[1])\n    )\n\n    # Extract sorted Row objects\n    sorted_domain_rows = [item[2] for item in sorted_rows_with_sums_and_indices]\n\n    # Return a new Matrix instance with the sorted rows\n    return Matrix(sorted_domain_rows)\n\n# --- src/output_formatter.py ---\ndef format_output(matrix_domain: Matrix) -> List[List[float]]:\n    \"\"\"Converts the domain Matrix object back into a plain nested Python list.\"\"\"\n    return [list(row.elements) for row in matrix_domain.rows]\n\n# --- src/sort_service.py ---\nclass SortService:\n    \"\"\"Orchestrates validation, domain construction, sum calculation, sorting, and formatting.\"\"\"\n    def sort_matrix(self, matrix_input: List[List[Number]]) -> List[List[Number]]:\n        \"\"\"\n        Sorts a matrix by row sums, ensuring validation, stability, and immutability.\n        Returns a new nested list.\n        \"\"\"\n        # 1. Validate input\n        validate_matrix(matrix_input)\n\n        # 2. Construct domain Matrix and Row objects (with original indices)\n        domain_rows = [Row(list(r), i) for i, r in enumerate(matrix_input)]\n        domain_matrix = Matrix(domain_rows)\n\n        # 3. Calculate row sums\n        row_sums = calculate_row_sums(domain_matrix)\n\n        # 4. Stable sort rows\n        sorted_domain_matrix = stable_sort_rows(domain_matrix, row_sums)\n\n        # 5. Format output\n        return format_output(sorted_domain_matrix)\n\n# --- src/sort_matrix.py (Public API Entrypoint) ---\ndef sort_matrix(matrix: List[List[Number]]) -> List[List[Number]]:\n    \"\"\"\n    Sorts a two-dimensional list of numeric values (matrix) by the ascending sum of its rows.\n    Ensures input validation, stable sort, and non-mutation of the input matrix.\n    \"\"\"\n    return SortService().sort_matrix(matrix)\n```"}
{"task_id": "Mbpp/12", "solution": "```python\n# src/domain.py\nfrom typing import List\nfrom functools import cmp_to_key\n\nclass Element:\n    \"\"\"Represents a single integer element in a matrix.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Row:\n    \"\"\"Represents a single row as an ordered list of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n        self._sum = sum(elements) \n\n    def sum(self) -> int:\n        \"\"\"Calculates and returns the sum of elements in the row.\"\"\"\n        return self._sum\n\nclass Matrix:\n    \"\"\"Represents a matrix as an ordered collection of Row objects.\"\"\"\n    def __init__(self, rows: List[Row]) -> None:\n        self.rows = rows\n\n    def get_row_sums(self) -> List[int]:\n        \"\"\"Returns a list containing the sum of each row.\"\"\"\n        return [row.sum() for row in self.rows]\n\nclass RowComparator:\n    \"\"\"Compares two Row instances based on their sums.\"\"\"\n    def compare(self, rowA: Row, rowB: Row) -> int:\n        \"\"\"\n        Compares two rows by their sums.\n        Returns -1 if rowA.sum < rowB.sum, 0 if equal, 1 if rowA.sum > rowB.sum.\n        \"\"\"\n        sum_a = rowA.sum()\n        sum_b = rowB.sum()\n        if sum_a < sum_b:\n            return -1\n        elif sum_a == sum_b:\n            return 0\n        else:\n            return 1\n\nclass SortService:\n    \"\"\"Provides the sorting operation for a Matrix based on row sums.\"\"\"\n    def __init__(self, comparator: RowComparator = None) -> None:\n        self.comparator = comparator if comparator is not None else RowComparator()\n\n    def sort_matrix(self, matrix: Matrix) -> Matrix:\n        \"\"\"\n        Sorts the rows of a matrix in ascending order by their sums.\n        Uses a stable sort, preserving original order for equal sums.\n        \"\"\"\n        # Python's list.sort() or sorted() is stable by default.\n        # We use cmp_to_key to adapt our RowComparator's compare method for the key argument.\n        sorted_rows = sorted(matrix.rows, key=cmp_to_key(self.comparator.compare))\n        return Matrix(sorted_rows)\n\n```\n\n```python\n# src/sort_matrix.py\nfrom typing import List, Any\nfrom src.domain import Row, Matrix, SortService, RowComparator\n\ndef _validate_matrix_input(matrix: Any) -> None:\n    \"\"\"\n    Validates that the input matrix is a list of lists of integers.\n    Raises ValueError for invalid input types.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise ValueError(\"Input matrix must be a list.\")\n    \n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise ValueError(f\"Row at index {i} must be a list, got {type(row).__name__}.\")\n        for j, element in enumerate(row):\n            if not isinstance(element, int):\n                raise ValueError(f\"Element at [{i}][{j}] must be an integer, got {type(element).__name__}.\")\n\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a matrix by the sum of its rows in ascending order.\n    Validates input and delegates sorting to domain services.\n    \"\"\"\n    _validate_matrix_input(matrix)\n\n    # Convert raw input to domain Row objects\n    domain_rows = [Row(elements=row) for row in matrix]\n    domain_matrix = Matrix(rows=domain_rows)\n\n    # Delegate to SortService for sorting\n    sorter = SortService(comparator=RowComparator())\n    sorted_domain_matrix = sorter.sort_matrix(matrix=domain_matrix)\n\n    # Convert sorted domain Matrix back to list of lists\n    return [row.elements for row in sorted_domain_matrix.rows]\n\n```\n\n```python\n# tests/test_sort_matrix.py\nimport pytest\nfrom src.sort_matrix import sort_matrix\n\ndef test_sort_matrix_example():\n    \"\"\"\n    Tests the sort_matrix function with the provided example (FR4).\n    Ensures the output matches the expected sorted matrix.\n    \"\"\"\n    input_matrix = [[1, 2, 3], [2, 4, 5], [1, 1, 1]]\n    expected_output = [[1, 1, 1], [1, 2, 3], [2, 4, 5]]\n    assert sort_matrix(input_matrix) == expected_output\n\ndef test_sort_matrix_empty_matrix():\n    \"\"\"Tests sorting an empty matrix.\"\"\"\n    assert sort_matrix([]) == []\n\ndef test_sort_matrix_single_row():\n    \"\"\"Tests sorting a matrix with a single row.\"\"\"\n    assert sort_matrix([[10, 20]]) == [[10, 20]]\n\ndef test_sort_matrix_rows_with_equal_sums():\n    \"\"\"Tests sorting with rows having equal sums, verifying stable sort.\"\"\"\n    input_matrix = [[1, 2], [3, 3], [4, 2], [2, 1]] # Sums: 3, 6, 6, 3\n    expected_output = [[2, 1], [1, 2], [3, 3], [4, 2]] # Sorted by sum, original order for ties\n    assert sort_matrix(input_matrix) == expected_output\n\ndef test_sort_matrix_negative_numbers():\n    \"\"\"Tests sorting with negative numbers.\"\"\"\n    input_matrix = [[-1, -2], [5, 0], [-10, 1]] # Sums: -3, 5, -9\n    expected_output = [[-10, 1], [-1, -2], [5, 0]]\n    assert sort_matrix(input_matrix) == expected_output\n\ndef test_sort_matrix_validation_not_list():\n    \"\"\"Tests validation for non-list matrix input.\"\"\"\n    with pytest.raises(ValueError, match=\"Input matrix must be a list.\"):\n        sort_matrix(\"not a list\")\n\ndef test_sort_matrix_validation_row_not_list():\n    \"\"\"Tests validation for a non-list row within the matrix.\"\"\"\n    with pytest.raises(ValueError, match=\"Row at index 1 must be a list\"):\n        sort_matrix([[1, 2], \"not a row\", [3, 4]])\n\ndef test_sort_matrix_validation_element_not_int():\n    \"\"\"Tests validation for a non-integer element within a row.\"\"\"\n    with pytest.raises(ValueError, match=\"Element at \\\\[0\\\\]\\\\[1\\\\] must be an integer.\"):\n        sort_matrix([[1, \"not an int\"], [3, 4]])\n\n```"}
