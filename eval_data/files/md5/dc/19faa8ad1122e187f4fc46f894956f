check_result)\n```"}
{"task_id": "Mbpp/20", "solution": "```python\n# src/woodall.py\nimport time\nfrom typing import Optional, Any, Union\n\n# Define a custom exception for exceeding time budget.\nclass TimeoutError(Exception):\n    \"\"\"Exception raised when a computation exceeds its allocated time.\"\"\"\n    pass\n\nclass ValidationError:\n    \"\"\"Container for validation or failure messages.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n\nclass IntegerInput:\n    \"\"\"Represents raw/validated integer input and performs validation.\"\"\"\n    def __init__(self, raw_input: Any):\n        self.raw_input = raw_input\n        self.value: Optional[int] = None\n        try:\n            # Attempt to convert to int. Floats like 3.0 are accepted, but type checking below handles strictness.\n            if isinstance(raw_input, (int, float)) and not isinstance(raw_input, bool):\n                self.value = int(raw_input)\n            elif isinstance(raw_input, str):\n                self.value = int(raw_input)\n        except (ValueError, TypeError):\n            self.value = None\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if the stored value is an integer (type int) and >= 1.\"\"\"\n        if isinstance(self.value, int) and self.value >= 1:\n            return True\n        self.value = None  # Ensure value is None if validation fails.\n        return False\n\nclass WoodallCandidate:\n    \"\"\"Represents a candidate k and its computed Woodall value.\"\"\"\n    def __init__(self, k: int):\n        self.k = k\n        self.value: Optional[int] = None\n        try:\n            # Python's integers handle arbitrary size, but large numbers can consume memory.\n            self.value = k * (2 ** k) - 1\n        except MemoryError:\n            self.value = None # Indicate failure to compute due to memory.\n\nclass Result:\n    \"\"\"Container for a boolean outcome.\"\"\"\n    def __init__(self, is_woodall: bool):\n        self.is_woodall = is_woodall\n\nclass WoodallChecker:\n    \"\"\"Domain logic for determining Woodall membership and producing candidates.\"\"\"\n    def __init__(self, k_max: Optional[int] = None, time_budget_seconds: Optional[float] = None):\n        # A practical cap for k, largely to prevent infinite loops if monotonicity fails or for very specific edge cases.\n        self._k_max = k_max if k_max is not None else 1_000_000\n        self._time_budget_seconds = time_budget_seconds\n\n    def is_woodall(self, n: Any) -> bool:\n        \"\"\"Determines if n is a Woodall number, handling validation and errors.\"\"\"\n        try:\n            integer_input = IntegerInput(n)\n            if not integer_input.validate():\n                return False # Input is non-integer or n < 1 per BR-2, BR-6.\n\n            # Delegate computation to find_k, which expects a validated integer.\n            found_k = self.find_k(integer_input.value)\n            return found_k is not None\n        except (MemoryError, TimeoutError):\n            return False # Catch computation overflow/time-limit as per BR-7.\n        except Exception:\n            return False # Catch any other unexpected errors and fail-safe.\n\n    def find_k(self, n: int) -> Optional[int]:\n        \"\"\"Finds the smallest integer k >= 1 such that n = k * 2^k - 1.\"\"\"\n        start_time = time.time()\n\n        k = 1\n        while True:\n            # Check for time budget exceeded.\n            if self._time_budget_seconds is not None and (time.time() - start_time) > self._time_budget_seconds:\n                raise TimeoutError(\"Computation exceeded time budget.\")\n\n            # Compute Woodall candidate value, catching potential memory issues.\n            try:\n                candidate_obj = WoodallCandidate(k)\n                candidate_value = candidate_obj.value\n            except MemoryError:\n                return None # Computation failed, treat as not found.\n\n            if candidate_value is None: # Indicates computation failure within WoodallCandidate.\n                return None\n\n            if candidate_value == n:\n                return k\n            if candidate_value > n:\n                return None # Due to monotonicity, further k values will only be larger.\n            \n            if k >= self._k_max: # Safeguard against excessively large k.\n                return None\n            \n            k += 1\n\n# Top-level convenience functions\ndef is_woodall(n: Any) -> bool:\n    \"\"\"Checks if n is a Woodall number. This function is a convenience wrapper.\"\"\"\n    checker = WoodallChecker()\n    return checker.is_woodall(n)\n\ndef find_k(n: Any) -> Optional[int]:\n    \"\"\"Finds k for a Woodall number n, if it exists. This function is a convenience wrapper.\"\"\"\n    integer_input = IntegerInput(n)\n    if not integer_input.validate():\n        return None # Return None for invalid input as per specification.\n    \n    checker = WoodallChecker()\n    try:\n        # WoodallChecker's find_k expects a validated integer.\n        return checker.find_k(integer_input.value)\n    except (MemoryError, TimeoutError):\n        return None # Fail-safe on computation errors.\n\n```\n```python\n# src/main.py\nimport sys\nfrom src.woodall import is_woodall\nfrom typing import Optional\n\ndef _parse_arg(arg: str) -> Optional[int]:\n    \"\"\"Attempts to parse a string argument into an integer.\"\"\"\n    try:\n        return int(arg)\n    except ValueError:\n        return None\n\ndef main(argv: list[str]) -> int:\n    \"\"\"Entry point for the Woodall number checker command-line interface.\"\"\"\n    if len(argv) < 2:\n        print(\"Usage: python -m src.main <number>\")\n        return 1\n\n    n_str = argv[1]\n    n = _parse_arg(n_str)\n\n    if n is None:\n        print(f\"Error: '{n_str}' is not a valid integer input.\")\n        return 1\n    \n    result = is_woodall(n)\n    print(result)\n    return 0\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))\n\n```\n```python\n# tests/test_woodall.py\nimport pytest\nfrom src.woodall import is_woodall\n\ndef test_is_woodall_383():\n    \"\"\"Asserts that 383 is correctly identified as a Woodall number.\"\"\"\n    assert is_woodall(383) == True\n\ndef test_is_woodall_non_woodall():\n    \"\"\"Tests a non-Woodall number.\"\"\"\n    assert is_woodall(10) == False\n\ndef test_is_woodall_invalid_input_string():\n    \"\"\"Tests handling of non-integer string input.\"\"\"\n    assert is_woodall(\"abc\") == False\n\ndef test_is_woodall_invalid_input_float():\n    \"\"\"Tests handling of float input.\"\"\"\n    assert is_woodall(3.14) == False\n\ndef test_is_woodall_input_zero():\n    \"\"\"Tests input n < 1 (n=0).\"\"\"\n    assert is_woodall(0) == False\n\ndef test_is_woodall_input_negative():\n    \"\"\"Tests input n < 1 (n=-10).\"\"\"\n    assert is_woodall(-10) == False\n\ndef test_is_woodall_first_woodall_number():\n    \"\"\"Tests for k=1, n = 1*2^1 - 1 = 1.\"\"\"\n    assert is_woodall(1) == True\n\ndef test_is_woodall_another_woodall_number():\n    \"\"\"Tests for k=2, n = 2*2^2 - 1 = 7.\"\"\"\n    assert is_woodall(7) == True\n\ndef test_is_woodall_large_woodall_number():\n    \"\"\"Tests for k=3, n = 3*2^3 - 1 = 23.\"\"\"\n    assert is_woodall(23) == True\n\ndef test_is_woodall_large_woodall_number_k_gt_10():\n    \"\"\"Tests a Woodall number with k > 10.\"\"\"\n    # k = 10, n = 10 * 2^10 - 1 = 10 * 1024 - 1 = 10240 - 1 = 10239\n    assert is_woodall(10239) == True\n    # k = 11, n = 11 * 2^11 - 1 = 11 * 2048 - 1 = 22528 - 1 = 22527\n    assert is_woodall(22527) == True\n\n```"}
{"task_id": "Mbpp/56", "solution": "```python\ndef check(n):\n    \"\"\"Checks if n is one less than twice its reverse.\n    The digit reversal operation drops leading zeros and preserves the number's sign.\n    \"\"\"\n    # Inlined _reverse logic\n    is_negative = n < 0\n    abs_n_str = str(abs(n))\n    reversed_str = abs_n_str[::-1]\n    reversed_n_val = int(reversed_str)\n    if is_negative:\n        reversed_n_val = -reversed_n_val\n\n    return n == (2 * reversed_n_val) - 1\n```"}
{"task_id": "Mbpp/20", "solution": "```\nsrc/woodall.py\n```python\nfrom dataclasses import dataclass\n\ndef _compute_woodall_value(k: int) -> int:\n    \"\"\"Computes the Woodall value for a given k: k * 2^k - 1.\"\"\"\n    return k * (2**k) - 1\n\n@dataclass\nclass Number:\n    \"\"\"Represents the input integer value.\"\"\"\n    value: int\n\n@dataclass\nclass CheckResult:\n    \"\"\"Represents the outcome including optional k found.\"\"\"\n    is_woodall: bool\n    k_found: int  # -1 when not found\n\nclass WoodallChecker:\n    \"\"\"Algorithmic logic to determine Woodall membership and find k.\"\"\"\n\n    def is_woodall(self, n: int) -> bool:\n        \"\"\"Determines if n is a Woodall number.\"\"\"\n        return self.find_k(n) != -1\n\n    def find_k(self, n: int) -> int:\n        \"\"\"Finds k such that n = k * 2^k - 1, or returns -1 if none exists.\"\"\"\n        if n < 1: # Woodall numbers are always positive for k >= 1\n            return -1\n\n        k = 1\n        while True:\n            computed_value = _compute_woodall_value(k)\n            if computed_value == n:\n                return k\n            elif computed_value > n:\n                # Since k * 2^k - 1 is monotonically increasing for k >= 1,\n                # if we've surpassed n, no larger k will match.\n                return -1\n            k += 1\n\ndef is_woodall(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a Woodall number.\"\"\"\n    checker = WoodallChecker()\n    return checker.is_woodall(n)\n\n```\n\n```\ntests/test_woodall.py\n```python\nfrom src.woodall import is_woodall\n\ndef test_is_woodall_383():\n    \"\"\"Acceptance test verifying 383 is a Woodall number.\"\"\"\n    assert is_woodall(383) == True\n\n```"}
