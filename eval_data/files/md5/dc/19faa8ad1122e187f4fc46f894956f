{"task_id": "Mbpp/463", "solution": "```python\nfrom typing import List, Sequence\n\nclass InputArray:\n    \"\"\"Represents and stores the input sequence of integers.\"\"\"\n    def __init__(self, values: Sequence[int]) -> None:\n        self.values = list(values)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input array.\"\"\"\n        return len(self.values)\n\nclass Subarray:\n    \"\"\"Represents a contiguous subarray.\"\"\"\n    def __init__(self, start: int, end: int, product: int) -> None:\n        self.start = start\n        self.end = end\n        self.product = product\n\nclass Result:\n    \"\"\"Encapsulates the final integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass ProductComputation:\n    \"\"\"Implements the algorithm to compute the maximum product of any contiguous subarray.\"\"\"\n    def compute_max_product(self, values: List[int]) -> int:\n        \"\"\"\n        Calculates the maximum product using current_max/current_min and global_max.\n        Handles zeros by resetting state.\n        \"\"\"\n        if not values:\n            return 0\n\n        global_max = float('-inf')\n        current_max = 1\n        current_min = 1\n\n        for num in values:\n            if num == 0:\n                current_max = 1\n                current_min = 1\n                global_max = max(global_max, 0)\n                continue\n\n            temp_max = current_max * num\n            temp_min = current_min * num\n\n            current_max = max(num, temp_max, temp_min)\n            current_min = min(num, temp_max, temp_min)\n\n            global_max = max(global_max, current_max)\n        \n        return int(global_max)\n\ndef max_subarray_product(array) -> int:\n    \"\"\"\n    Public API function to find the maximum product of any contiguous subarray.\n    Orchestrates input handling and computation.\n    \"\"\"\n    input_array = InputArray(array)\n    \n    product_computation = ProductComputation()\n    max_prod_value = product_computation.compute_max_product(input_array.values)\n    \n    result = Result(max_prod_value)\n    return result.value\n```"}
{"task_id": "Mbpp/468", "solution": "```python\n# src/__init__.py\n```\n\n```python\n# src/array_input.py\nfrom typing import List\n\nclass ArrayInput:\n    \"\"\"Lightweight wrapper for an input array, providing its numeric elements.\"\"\"\n    def __init__(self, numbers: List) -> None:\n        self.numbers = numbers\n\n    def __iter__(self) -> 'ArrayInput':\n        \"\"\"Allows iteration over the wrapped numbers.\"\"\"\n        return iter(self.numbers)\n```\n\n```python\n# src/subsequence.py\nfrom typing import List\n\nclass Subsequence:\n    \"\"\"Represents an increasing subsequence and computes its product.\"\"\"\n    def __init__(self, elements: List) -> None:\n        self.elements = elements\n\n    def product(self) -> float:\n        \"\"\"Computes and returns the numeric product of all elements in the subsequence.\"\"\"\n        res = 1.0\n        for x in self.elements:\n            res *= x\n        return res\n```\n\n```python\n# src/max_product_calculator.py\nfrom typing import List, Iterator\n\nfrom src.subsequence import Subsequence\n\nclass MaxProductCalculator:\n    \"\"\"Core engine for computing the maximum product of strictly increasing subsequences.\"\"\"\n\n    def max_product(self, numbers: List) -> float:\n        \"\"\"Computes and returns the maximum product from any strictly increasing subsequence.\"\"\"\n        if not numbers:\n            return 0.0 # Returns 0.0 for an empty input array, as no product can be formed.\n\n        all_products = list(self._compute_subsequence_products(numbers))\n        if not all_products:\n            return 0.0 # Returns 0.0 if no valid products were found (e.g., due to filtering).\n\n        return max(all_products)\n\n    def _compute_subsequence_products(self, numbers: List) -> Iterator[float]:\n        \"\"\"Generates products of all strictly increasing subsequences.\"\"\"\n        for subsequence_obj in self._enumerate_increasing_subsequences(numbers):\n            yield subsequence_obj.product()\n\n    def _enumerate_increasing_subsequences(self, numbers: List) -> Iterator[Subsequence]:\n        \"\"\"Generates all strictly increasing subsequences as Subsequence objects.\"\"\"\n        all_subsequences_ending_at_index: List[List[Subsequence]] = [[] for _ in numbers]\n\n        for i, current_num in enumerate(numbers):\n            # Add single-element subsequence.\n            single_element_subsequence = Subsequence([current_num])\n            all_subsequences_ending_at_index[i].append(single_element_subsequence)\n            yield single_element_subsequence\n\n            # Extend previous subsequences.\n            for j in range(i):\n                if current_num > numbers[j]:\n                    for prev_subsequence in all_subsequences_ending_at_index[j]:\n                        extended_elements = prev_subsequence.elements + [current_num]\n                        new_subsequence = Subsequence(extended_elements)\n                        all_subsequences_ending_at_index[i].append(new_subsequence)\n                        yield new_subsequence\n```\n\n```python\n# src/max_product.py\nfrom src.array_input import ArrayInput\nfrom src.max_product_calculator import MaxProductCalculator\n\ndef max_product(array: list) -> float:\n    \"\"\"\n    Computes the maximum product obtainable from any strictly increasing subsequence of the input array.\n    Single-element subsequences are allowed.\n    \"\"\"\n    array_input = ArrayInput(array)\n    calculator = MaxProductCalculator()\n    return calculator.max_product(array_input.numbers)\n```"}
{"task_id": "Mbpp/468", "solution": "```python\n# src/__init__.py\n# Package marker\n```\n\n```python\n# src/subsequence.py\nfrom typing import List, Union\n\nclass Subsequence:\n    \"\"\"Domain data class representing a subsequence, with isStrictlyIncreasing helper.\"\"\"\n    elements: List[Union[int, float]]\n    product: Union[int, float, None]\n\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n        self.product = None\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"Checks if the subsequence elements are strictly increasing.\"\"\"\n        if len(self.elements) < 2:\n            return True\n        for i in range(len(self.elements) - 1):\n            if self.elements[i] >= self.elements[i+1]:\n                return False\n        return True\n```\n\n```python\n# src/validator.py\nfrom typing import Any, Union, List\n\nclass Error:\n    \"\"\"Represents an error with a code and message.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n\nclass ValidationResult:\n    \"\"\"Holds the result of a validation, indicating validity and an optional error.\"\"\"\n    def __init__(self, is_valid: bool, error: Union[Error, None] = None):\n        self.is_valid = is_valid\n        self.error = error\n\nclass Validator:\n    \"\"\"Validates caller input per FR6.\"\"\"\n    def validate(self, input_value: Any) -> ValidationResult:\n        \"\"\"Validates input is a non-empty array/list of numeric values.\"\"\"\n        if not isinstance(input_value, list):\n            return ValidationResult(False, Error(\"INVALID_TYPE\", \"Input must be a list.\"))\n        if not input_value:\n            return ValidationResult(False, Error(\"EMPTY_LIST\", \"Input list cannot be empty.\"))\n        for item in input_value:\n            if not isinstance(item, (int, float)):\n                return ValidationResult(False, Error(\"NON_NUMERIC_ELEMENT\", \"All elements in the list must be numeric.\"))\n        return ValidationResult(True)\n```\n\n```python\n# src/product_calculator.py\nfrom typing import List, Union\n\nclass ProductCalculator:\n    \"\"\"Computes product of subsequence elements.\"\"\"\n    @staticmethod\n    def multiply(elements: List[Union[int, float]]) -> float:\n        \"\"\"Calculates the product of a list of numeric elements.\"\"\"\n        product = 1.0\n        for element in elements:\n            product *= element\n        return product\n```\n\n```python\n# src/enumerator.py\nfrom typing import List, Iterator, Union\nfrom src.subsequence import Subsequence\n\ndef generate_increasing_subsequences(values: List[Union[int, float]]) -> Iterator[Subsequence]:\n    \"\"\"Generates all strictly increasing subsequences from the input values.\"\"\"\n    n = len(values)\n\n    def _generate(index: int, current_elements: List[Union[int, float]]):\n        if current_elements:\n            yield Subsequence(list(current_elements))\n\n        for i in range(index, n):\n            if not current_elements or values[i] > current_elements[-1]:\n                yield from _generate(i + 1, current_elements + [values[i]])\n\n    yield from _generate(0, [])\n```\n\n```python\n# src/max_product.py\nfrom typing import List, Union\nimport math\n\nfrom src.validator import Validator, ValidationResult, Error\nfrom src.enumerator import generate_increasing_subsequences\nfrom src.product_calculator import ProductCalculator\nfrom src.subsequence import Subsequence\n\ndef max_product(input_array: List[Union[int, float]]) -> float:\n    \"\"\"Top-level function that returns the maximum product of a strictly increasing subsequence.\n    Raises ValueError for invalid input per FR6.\n    \"\"\"\n    validator = Validator()\n    validation_result: ValidationResult = validator.validate(input_array)\n\n    if not validation_result.is_valid:\n        error = validation_result.error\n        raise ValueError(f\"{error.code}: {error.message}\")\n\n    product_calculator = ProductCalculator()\n    \n    max_prod = float('-inf')\n\n    for sub in generate_increasing_subsequences(input_array):\n        current_product = product_calculator.multiply(sub.elements)\n        sub.product = current_product \n        \n        if current_product > max_prod:\n            max_prod = current_product\n    \n    return max_prod\n```\n\n```python\n# tests/test_max_product.py\nimport pytest\nfrom src.max_product import max_product\n\ndef test_example_max_product():\n    \"\"\"Tests the acceptance example: max_product([3,100,4,5,150,6]) == 3000.\"\"\"\n    assert max_product([3, 100, 4, 5, 150, 6]) == 3000.0\n\ndef test_single_element_array():\n    \"\"\"Tests an array with a single element.\"\"\"\n    assert max_product([5]) == 5.0\n\ndef test_decreasing_array():\n    \"\"\"Tests an array where no multi-element increasing subsequences exist.\"\"\"\n    assert max_product([5, 4, 3]) == 5.0\n    assert max_product([10, 2, 8, 1]) == 10.0\n\ndef test_mixed_array():\n    \"\"\"Tests an array with various increasing subsequences.\"\"\"\n    assert max_product([1, 2, 3, 0, 4, 5]) == 120.0\n    assert max_product([1, -2, 3, -4, 5]) == 15.0\n\ndef test_array_with_negatives():\n    \"\"\"Tests arrays containing negative numbers.\"\"\"\n    assert max_product([-10, -5, -1]) == 50.0\n    assert max_product([-1, -2, -3]) == -1.0\n    assert max_product([-5, -4, -3, -2, -1]) == 120.0\n    \ndef test_array_with_zeros():\n    \"\"\"Tests arrays containing zero.\"\"\"\n    assert max_product([0, 1, 2]) == 2.0\n    assert max_product([-2, -1, 0, 1, 2]) == 2.0\n    assert max_product([-1, 0, 1]) == 1.0\n    assert max_product([1, 0, 2]) == 2.0\n    \ndef test_invalid_input_empty():\n    \"\"\"Tests that an empty input list raises a ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"EMPTY_LIST\"):\n        max_product([])\n\ndef test_invalid_input_non_list():\n    \"\"\"Tests that non-list input raises a ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"INVALID_TYPE\"):\n        max_product(\"not a list\")\n    with pytest.raises(ValueError, match=\"INVALID_TYPE\"):\n        max_product(123)\n    with pytest.raises(ValueError, match=\"INVALID_TYPE\"):\n        max_product(None)\n\ndef test_invalid_input_non_numeric():\n    \"\"\"Tests that a list with non-numeric elements raises a ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"NON_NUMERIC_ELEMENT\"):\n        max_product([1, 2, \"a\", 4])\n    with pytest.raises(ValueError, match=\"NON_NUMERIC_ELEMENT\"):\n        max_product([1, None, 3])\n```"}
