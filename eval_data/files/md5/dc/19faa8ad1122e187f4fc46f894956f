{"task_id": "Mbpp/419", "solution": "```python\nfrom typing import List, Union\n\ndef _validate_numeric_list(numbers: List[object]) -> None:\n    \"\"\"Ensures each element is numeric (int or float) and raises TypeError otherwise.\"\"\"\n    for i, num in enumerate(numbers):\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"Element at index {i} is not a numeric type: {type(num).__name__}\")\n\nclass Number:\n    \"\"\"Holds a numeric value and computes its rounded integer value.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n        self.rounded_value = self.round()\n\n    def round(self) -> int:\n        \"\"\"Returns the integer result of language-default rounding.\"\"\"\n        return int(round(self.value))\n\nclass NumberList:\n    \"\"\"Represents a collection of Number objects and provides its length.\"\"\"\n    def __init__(self, raw_numbers: List[float]) -> None:\n        self.elements: List[Number] = [Number(num) for num in raw_numbers]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass Result:\n    \"\"\"Holds the computed sum, list length, and final product.\"\"\"\n    def __init__(self, sum_value: int, length: int) -> None:\n        self.sum = sum_value\n        self.length = length\n        self.product = sum_value * length\n\nclass Printer:\n    \"\"\"Isolates printing functionality to standard output.\"\"\"\n    def print(self, value: int) -> None:\n        \"\"\"Emits the textual representation of the value to stdout.\"\"\"\n        print(value)\n\nclass RoundAndSumFunction:\n    \"\"\"Coordinates validation, rounding, summation, multiplication, printing, and returning.\"\"\"\n    def round_and_sum(self, numbers: List[float]) -> int:\n        \"\"\"Orchestrates the round and sum logic as per design.\"\"\"\n        _validate_numeric_list(numbers)\n\n        number_list = NumberList(numbers)\n\n        sum_rounded_values = 0\n        for number_obj in number_list.elements:\n            sum_rounded_values += number_obj.rounded_value\n\n        result = Result(sum_rounded_values, number_list.length())\n\n        Printer().print(result.product)\n        return result.product\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds numbers, sums them, multiplies by list length, prints, and returns the product.\n    Delegates orchestration to RoundAndSumFunction.\n    \"\"\"\n    return RoundAndSumFunction().round_and_sum(numbers)\n```"}
{"task_id": "Mbpp/420", "solution": "```python\n# src/cube_sum.py\n\ndef _validate_n(n) -> None:\n    \"\"\"\n    Validates that n is an integer and n >= 1.\n    Raises ValueError on invalid input.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\ndef cube_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of cubes of the first n even natural numbers.\n    Input n is validated to be an integer >= 1.\n    \"\"\"\n    _validate_n(n)\n    # Using the closed-form formula: sum_{k=1..n} (2k)^3 = 2 * n**2 * (n+1)**2\n    result = 2 * n**2 * (n + 1)**2\n    return int(result)\n\n```\n```python\n# tests/test_cube_sum.py\n\nfrom src.cube_sum import cube_Sum\n\n# Mandated unit test assertion to verify correctness.\nassert cube_Sum(2) == 72\n\n# Example tests for validation (optional, but good for demonstrating functionality)\ndef test_cube_sum_basic():\n    \"\"\"Test cube_Sum with a valid input.\"\"\"\n    assert cube_Sum(1) == 16  # (2*1)^3 = 8\n    assert cube_Sum(2) == 72  # (2*1)^3 + (2*2)^3 = 8 + 64 = 72\n    assert cube_Sum(3) == 288 # 72 + (2*3)^3 = 72 + 216 = 288\n\ndef test_cube_sum_validation_non_integer():\n    \"\"\"Test cube_Sum with non-integer input to ensure ValueError.\"\"\"\n    import pytest\n    with pytest.raises(ValueError, match=\"n must be an integer >= 1\"):\n        cube_Sum(1.5)\n\ndef test_cube_sum_validation_less_than_one():\n    \"\"\"Test cube_Sum with input less than 1 to ensure ValueError.\"\"\"\n    import pytest\n    with pytest.raises(ValueError, match=\"n must be an integer >= 1\"):\n        cube_Sum(0)\n    with pytest.raises(ValueError, match=\"n must be an integer >= 1\"):\n        cube_Sum(-1)\n\n```"}
{"task_id": "Mbpp/420", "solution": "```python\n# src/cube_sum.py\n\nclass InputValidator:\n    \"\"\"Validates input parameters for the cube sum function.\"\"\"\n    @staticmethod\n    def validate_is_int(n):\n        \"\"\"Checks if n is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n    @staticmethod\n    def validate_non_negative(n):\n        \"\"\"Checks if n is non-negative.\"\"\"\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\nclass CubeSumFunction:\n    \"\"\"Encapsulates the closed-form computation for cube sums.\"\"\"\n    @staticmethod\n    def compute_sum_formula(n: int) -> int:\n        \"\"\"Computes the sum of cubes of first n even natural numbers using a closed-form formula.\"\"\"\n        # The formula is 8 * (n * (n + 1) / 2)^2, implemented with integer arithmetic.\n        return 8 * (n * (n + 1) // 2) ** 2\n\nclass EvenNumberSequence:\n    \"\"\"Generates a sequence of even natural numbers.\"\"\"\n    @staticmethod\n    def generate(n):\n        \"\"\"Generates the first n even natural numbers (2, 4, ..., 2n).\"\"\"\n        for k in range(1, n + 1):\n            yield 2 * k\n\nclass Result:\n    \"\"\"A simple container for the integer result value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef cube_Sum(n):\n    \"\"\"\n    Computes the sum of cubes of the first n even natural numbers.\n    This public API validates input and delegates computation.\n    \"\"\"\n    InputValidator.validate_is_int(n)\n    InputValidator.validate_non_negative(n)\n\n    if n == 0:\n        final_result = 0\n    else:\n        final_result = CubeSumFunction.compute_sum_formula(n)\n\n    return Result(final_result).value\n```\n```python\n# tests/test_cube_sum.py\nfrom src.cube_sum import cube_Sum\n\nclass TestSuite:\n    \"\"\"Runs a series of assertions to validate the cube_Sum function.\"\"\"\n    @staticmethod\n    def run_assertions():\n        \"\"\"Executes predefined test cases, including functional and error handling.\"\"\"\n        # Acceptance test cases\n        assert cube_Sum(0) == 0, \"Test Case 0 failed: cube_Sum(0) should be 0\"\n        assert cube_Sum(1) == 8, \"Test Case 1 failed: cube_Sum(1) should be 8 (2^3)\"\n        assert cube_Sum(2) == 72, \"Test Case 2 failed: cube_Sum(2) should be 72 (2^3 + 4^3 = 8 + 64)\"\n        assert cube_Sum(3) == 288, \"Test Case 3 failed: cube_Sum(3) should be 288 (2^3 + 4^3 + 6^3 = 8 + 64 + 216)\"\n        assert cube_Sum(4) == 800, \"Test Case 4 failed: cube_Sum(4) should be 800\"\n\n        # Exception handling tests\n        try:\n            cube_Sum(\"not_an_int\")\n            assert False, \"TypeError was not raised for string input.\"\n        except TypeError as e:\n            assert \"must be an integer\" in str(e), \"TypeError message mismatch for string input.\"\n        except Exception as e:\n            assert False, f\"Wrong exception type for string input: {type(e).__name__}.\"\n\n        try:\n            cube_Sum(3.14)\n            assert False, \"TypeError was not raised for float input.\"\n        except TypeError as e:\n            assert \"must be an integer\" in str(e), \"TypeError message mismatch for float input.\"\n        except Exception as e:\n            assert False, f\"Wrong exception type for float input: {type(e).__name__}.\"\n\n        try:\n            cube_Sum(-1)\n            assert False, \"ValueError was not raised for negative input.\"\n        except ValueError as e:\n            assert \"non-negative integer\" in str(e), \"ValueError message mismatch for negative input.\"\n        except Exception as e:\n            assert False, f\"Wrong exception type for negative input: {type(e).__name__}.\"\n            \n        print(\"All TestSuite assertions passed!\")\n\nif __name__ == '__main__':\n    TestSuite.run_assertions()\n```"}
{"task_id": "Mbpp/419", "solution": "```python\nimport math\nfrom dataclasses import dataclass\n\n@dataclass\nclass Result:\n    \"\"\"Holds the computed sum and product for the RoundAndSum operation.\n    It provides methods to print the product and return its value.\"\"\"\n    sum: int\n    product: int\n\n    def print(self) -> None:\n        \"\"\"Prints the product to standard output.\"\"\"\n        print(self.product)\n\n    def value(self) -> int:\n        \"\"\"Returns the product as an integer.\"\"\"\n        return self.product\n\ndef _validate_input(input_list: list) -> None:\n    \"\"\"Raises TypeError if input_list is not a list or contains non-numeric elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in input_list:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\ndef _round_half_up(value: float) -> int:\n    \"\"\"Returns int rounded per 'round half up' (fractional .5 rounded up toward +infinity).\"\"\"\n    # This rounding rule is equivalent to math.floor(value + 0.5) for all numbers.\n    return int(math.floor(value + 0.5))\n\ndef _compute_sum(rounded_values: list[int]) -> int:\n    \"\"\"Returns the integer sum of rounded_values.\"\"\"\n    return sum(rounded_values)\n\ndef _print_result(product: int) -> None:\n    \"\"\"Prints the integer product to stdout followed by newline.\"\"\"\n    print(product)\n\ndef round_and_sum(input_list: list) -> int:\n    \"\"\"Validate input, round each numeric value (round half up), compute sum, multiply by input length, print product to stdout, and return product as int.\"\"\"\n    _validate_input(input_list)\n\n    # Ensure all items are float before rounding to handle mixed int/float input consistently.\n    rounded_values = [_round_half_up(float(item)) for item in input_list]\n    total_sum = _compute_sum(rounded_values)\n    \n    list_length = len(input_list)\n    product = total_sum * list_length\n\n    _print_result(product)\n    \n    # The Result object is part of the design's domain artifacts, but the public API returns an int.\n    # Result(sum=total_sum, product=product) # Constructing it as per design, but not directly returning.\n    return product\n```"}
