{"task_id": "Mbpp/598", "solution": "```python\n# src/armstrong.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass Digit:\n    \"\"\"Represents an individual decimal digit.\"\"\"\n    value: int\n    position: int # Position is not strictly used in current logic but kept for design alignment.\n\n@dataclass\nclass Number:\n    \"\"\"Represents a number's computational state.\"\"\"\n    value: int\n    digits: list[int]\n    digit_count: int\n\n@dataclass\nclass Result:\n    \"\"\"Encapsulates the boolean outcome of the Armstrong check.\"\"\"\n    is_armstrong: bool\n\nclass ArmstrongFunction:\n    \"\"\"Encapsulates the algorithm for checking Armstrong numbers.\n    It handles digit extraction, sum-of-powers computation, and final evaluation.\"\"\"\n\n    def __init__(self) -> None:\n        pass\n\n    def compute_digits(self, n: int) -> list[int]:\n        \"\"\"Extracts decimal digits of n into a list of integers.\"\"\"\n        return [int(d) for d in str(n)]\n\n    def sum_of_powers(self, digits: list[int], p: int) -> int:\n        \"\"\"Computes the sum of each digit raised to the power p.\"\"\"\n        return sum(d ** p for d in digits)\n\n    def evaluate(self, n: int) -> Result:\n        \"\"\"Evaluates if n is an Armstrong number and returns the result.\"\"\"\n        digits_list = self.compute_digits(n)\n        digit_count = len(digits_list)\n        \n        # As per design, a Number instance is created to represent transient state.\n        _number_state = Number(value=n, digits=digits_list, digit_count=digit_count)\n        \n        computed_sum = self.sum_of_powers(digits_list, digit_count)\n        \n        return Result(is_armstrong=(computed_sum == n))\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Public API to determine if an integer n is an Armstrong number.\"\"\"\n    armstrong_checker = ArmstrongFunction()\n    result = armstrong_checker.evaluate(n)\n    return result.is_armstrong\n```\n\n```python\n# tests/test_armstrong.py\nfrom src.armstrong import armstrong_number\n\ndef test_armstrong_153():\n    \"\"\"Verifies that 153 is correctly identified as an Armstrong number.\"\"\"\n    assert armstrong_number(153) == True\n```"}
{"task_id": "Mbpp/597", "solution": "```python\nfrom typing import TypeVar, List, Union\n\nT = TypeVar('T')\n\nclass InvalidKException(Exception):\n    \"\"\"Exception raised when 'k' is an invalid value.\n    It includes an informative message about the out-of-range condition.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Element:\n    \"\"\"Wraps a single value of generic type T and provides comparison capabilities.\n    It enables direct comparison using Python's rich comparison operators.\n    \"\"\"\n    def __init__(self, value: T) -> None:\n        self.value = value\n\n    def compare_to(self, other: 'Element[T]') -> int:\n        \"\"\"Compares this element to another, returning -1 if self < other, 0 if equal, or 1 if self > other.\"\"\"\n        if self.value < other.value:\n            return -1\n        elif self.value == other.value:\n            return 0\n        else:\n            return 1\n\n    def __lt__(self, other: 'Element[T]') -> bool:\n        return self.value < other.value\n\n    def __le__(self, other: 'Element[T]') -> bool:\n        return self.value <= other.value\n\n    def __gt__(self, other: 'Element[T]') -> bool:\n        return self.value > other.value\n\n    def __ge__(self, other: 'Element[T]') -> bool:\n        return self.value >= other.value\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self.value == other.value\n\n    def __ne__(self, other: object) -> bool:\n        return not self.__eq__(other)\n\n    def __repr__(self) -> str:\n        return f\"Element({self.value})\"\n\n\nclass SortedArray:\n    \"\"\"Wraps a list of values, providing a consistent interface for length and element access.\n    It internally stores elements as Element wrappers for type consistency and comparison.\n    \"\"\"\n    def __init__(self, elements: List[T]) -> None:\n        self._elements: List[Element[T]] = [Element(val) for val in elements]\n\n    def length(self) -> int:\n        \"\"\"Returns the total number of elements contained within the array.\"\"\"\n        return len(self._elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Performs an optional runtime check to verify if the array's elements are in sorted order.\"\"\"\n        if not self._elements:\n            return True\n        for i in range(len(self._elements) - 1):\n            if self._elements[i] > self._elements[i+1]:\n                return False\n        return True\n\n    def get(self, index: int) -> Element[T]:\n        \"\"\"Retrieves an element at the specified index, ensuring the index is within bounds.\"\"\"\n        if not (0 <= index < self.length()):\n            raise IndexError(\"Array index out of range\")\n        return self._elements[index]\n\nclass FindKthFunction:\n    \"\"\"A stateless component responsible for validating inputs and computing the k-th smallest element.\n    It encapsulates the core algorithm for finding the k-th element across two sorted arrays.\n    \"\"\"\n    def find_kth(self, A: 'SortedArray[T]', B: 'SortedArray[T]', k: int) -> T:\n        \"\"\"Initiates the process of finding the k-th smallest element by first validating inputs.\"\"\"\n        self._validate_inputs(A, B, k)\n        return self._compute_kth(A, B, k).value\n\n    def _validate_inputs(self, A: 'SortedArray[T]', B: 'SortedArray[T]', k: int) -> None:\n        \"\"\"Ensures that the 1-based index 'k' is within the valid range for the combined lengths of A and B.\"\"\"\n        total_length = A.length() + B.length()\n        if not (1 <= k <= total_length):\n            raise InvalidKException(\n                f\"Invalid k value: {k}. k must be between 1 and {total_length} (inclusive).\"\n            )\n\n    def _compute_kth(self, A: 'SortedArray[T]', B: 'SortedArray[T]', k: int) -> 'Element[T]':\n        \"\"\"Implements a two-pointer merge algorithm to efficiently locate the k-th smallest element.\"\"\"\n        idx_a, idx_b = 0, 0\n        \n        while True:\n            # If array A is exhausted, the k-th smallest element must come from array B.\n            if idx_a == A.length():\n                return B.get(idx_b + k - 1)\n            \n            # If array B is exhausted, the k-th smallest element must come from array A.\n            if idx_b == B.length():\n                return A.get(idx_a + k - 1)\n            \n            # If k is 1, the k-th smallest is the minimum of the current head elements.\n            if k == 1:\n                return A.get(idx_a) if A.get(idx_a) < B.get(idx_b) else B.get(idx_b)\n\n            # In the general case, compare current elements and advance the pointer for the smaller one, decrementing k.\n            if A.get(idx_a) < B.get(idx_b):\n                idx_a += 1\n            else:\n                idx_b += 1\n            k -= 1\n\n# Public API entry point for the find_kth functionality.\ndef find_kth(A: Union[List[T], 'SortedArray[T]'], B: Union[List[T], 'SortedArray[T]'], k: int) -> T:\n    \"\"\"\n    Finds the k-th smallest element across two sorted arrays or SortedArray instances.\n    It handles input type flexibility by wrapping raw lists into SortedArray instances.\n    \"\"\"\n    # Convert list inputs to SortedArray wrappers for consistent processing if not already SortedArray.\n    a_wrapped: SortedArray[T] = A if isinstance(A, SortedArray) else SortedArray(A)\n    b_wrapped: SortedArray[T] = B if isinstance(B, SortedArray) else SortedArray(B)\n\n    # Instantiate the stateless FindKthFunction and delegate the core computation.\n    finder = FindKthFunction()\n    return finder.find_kth(a_wrapped, b_wrapped, k)\n```"}
{"task_id": "Mbpp/597", "solution": "```python\n# File: src/__init__.py\n# Package marker for src\n```\n\n```python\n# File: src/errors.py\n\"\"\"Defines the ValidationError class for input validation errors.\"\"\"\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n```\n\n```python\n# File: src/find_kth.py\nfrom typing import List, Any\n\ndef find_kth(arr1: List[Any], arr2: List[Any], k: int) -> Any:\n    \"\"\"Return the k-th smallest element (1-based) from two sorted arrays arr1 and arr2.\n    Assumes arr1 and arr2 are sorted in non-decreasing order and k is valid.\n    \"\"\"\n    ptr1 = 0\n    ptr2 = 0\n    \n    # Iterate k times to find the k-th element by consuming elements from the merged stream.\n    for _ in range(k):\n        # If arr1 is exhausted, take the next element from arr2.\n        if ptr1 == len(arr1):\n            result = arr2[ptr2]\n            ptr2 += 1\n            continue\n        \n        # If arr2 is exhausted, take the next element from arr1.\n        if ptr2 == len(arr2):\n            result = arr1[ptr1]\n            ptr1 += 1\n            continue\n\n        # Both arrays have elements, compare and take the smaller one.\n        # In case of ties, prioritize arr1, as duplicates are counted separately.\n        if arr1[ptr1] <= arr2[ptr2]:\n            result = arr1[ptr1]\n            ptr1 += 1\n        else:\n            result = arr2[ptr2]\n            ptr2 += 1\n            \n    return result\n```"}
{"task_id": "Mbpp/598", "solution": "```python\n# src/__init__.py\n\"\"\"Armstrong number checker package.\"\"\"\nfrom .armstrong_checker import armstrong_number, ArmstrongChecker\n\n# src/armstrong_checker.py\n\"\"\"\nModule containing the public API for Armstrong number checking.\nProvides the module-level armstrong_number function and the orchestrating ArmstrongChecker class.\n\"\"\"\nfrom .number import Number\nfrom .calculation import Calculation\n\nclass ArmstrongChecker:\n    \"\"\"\n    Orchestrates the process of checking if a number is an Armstrong number.\n    It uses Number to encapsulate the value and Calculation for computations.\n    \"\"\"\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"\n        Determines if the given integer n is an Armstrong number.\n        An Armstrong number equals the sum of its digits, each raised to the power of the number of digits.\n        \"\"\"\n        # Instantiate Number to represent the input value, as per design.\n        _ = Number(n) \n        calculator = Calculation()\n\n        # Compute the number of digits (which will be used as the power).\n        digit_count = calculator.compute_digit_count(n)\n\n        # Compute the sum of each digit raised to the determined power.\n        powered_sum = calculator.compute_powered_sum(n, digit_count)\n\n        # Compare the computed sum with the original number to determine if it's an Armstrong number.\n        return powered_sum == n\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Public API function to check if an integer is an Armstrong number.\n    This function acts as a convenience wrapper, instantiating and calling ArmstrongChecker.\n    \"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)\n\n# src/number.py\n\"\"\"Module for the Number value object.\"\"\"\n\nclass Number:\n    \"\"\"\n    Encapsulates an integer value and provides digit-related behaviors.\n    This class stores the number and can calculate its digit count.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digit_count(self) -> int:\n        \"\"\"\n        Calculates the number of digits in the stored integer value.\n        This method works by converting the number to a string and getting its length.\n        \"\"\"\n        return len(str(self.value))\n\n# src/calculation.py\n\"\"\"Module for computational utilities related to Armstrong numbers.\"\"\"\n\nclass Calculation:\n    \"\"\"\n    Provides stateless utility methods for numerical computations.\n    This includes counting digits and summing powers of digits for a given integer.\n    \"\"\"\n    def compute_digit_count(self, n: int) -> int:\n        \"\"\"\n        Computes the number of digits in the given integer n.\n        It converts the number to a string and returns the length of the string.\n        \"\"\"\n        return len(str(n))\n\n    def compute_powered_sum(self, n: int, power: int) -> int:\n        \"\"\"\n        Computes the sum of each digit of n raised to the given power.\n        Each digit is extracted by converting n to a string, then exponentiated and added to a total.\n        \"\"\"\n        total_sum = 0\n        # Iterate through digits of the number by converting it to a string.\n        for digit_char in str(n):\n            digit = int(digit_char)\n            total_sum += (digit ** power)\n        return total_sum\n\n# tests/test_armstrong.py\n\"\"\"Unit tests for the armstrong_number function.\"\"\"\nfrom src.armstrong_checker import armstrong_number\n\ndef test_armstrong_153() -> None:\n    \"\"\"Verifies that 153 is correctly identified as an Armstrong number.\"\"\"\n    assert armstrong_number(153) is True\n```"}
{"task_id": "Mbpp/599", "solution": "```python\n# src/__init__.py\n# Purpose: package initializer; export control; import sum_average\nfrom .sum_average import sum_average\n\n__all__ = [\"sum_average\"]\n```\n```python\n# src/validator.py\n# Purpose: Provide validation logic for input parameter n.\nclass Validator:\n    @staticmethod\n    def is_positive_integer(n) -> bool:\n        \"\"\"Return True if n is int and n >= 1, else False.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    @staticmethod\n    def raise_if_invalid(n) -> None:\n        \"\"\"Raise ValueError if n is not a positive integer. No return on success.\"\"\"\n        if not Validator.is_positive_integer(n):\n            raise ValueError(\"n must be an integer >= 1\")\n```\n```python\n# src/sum_average.py\n# Purpose: Provide public API sum_average(n).\nfrom typing import Tuple\nfrom .validator import Validator\n\ndef sum_average(n) -> Tuple[int, float]:\n    \"\"\"Validate n, compute sum using formula n*(n+1)//2, compute average as float, return (sum, average).\n    Raises ValueError if n is invalid.\n    \"\"\"\n    Validator.raise_if_invalid(n)\n    sum_value = n * (n + 1) // 2  # integer sum per FR3\n    average = sum_value / n       # float division per FR4\n    return (sum_value, average)\n```"}
{"task_id": "Mbpp/599", "solution": "```python\nfrom typing import Tuple\n\ndef sum_average(n: int) -> Tuple[int, float]:\n    \"\"\"Calculates the sum and arithmetic average of the first n natural numbers.\n    Returns a tuple containing the sum (int) and average (float).\n    \"\"\"\n    s = n * (n + 1) // 2\n    a = s / n\n    return (s, a)\n```"}
