{"task_id": "Mbpp/101", "solution": "```python\n# File: kth_element_module/__init__.py\n\"\"\"Package initializer for kth_element_module.\"\"\"\nfrom .kth_element import kth_element\n\n```python\n# File: kth_element_module/kth_element.py\n#!/usr/bin/env python3\n# Module: kth_element_module.kth_element\n# Public API: kth_element(array, k)\n\ndef _validate_k(array, k):\n    \"\"\"Validate k according to BR4-BR6 and return zero-based index.\n    Raises TypeError if k is not an integer, or IndexError for invalid bounds/empty array.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    n = len(array)\n    if n == 0:\n        raise IndexError(\"Cannot get kth element from an empty array.\")\n    \n    zero_based_k = k - 1 # k is 1-based, map to 0-based\n\n    if not (0 <= zero_based_k < n):\n        raise IndexError(f\"k ({k}) is out of 1-based range [1, {n}].\")\n\n    return zero_based_k\n\ndef kth_element(array, k):\n    \"\"\"Return the element at 1-based index k from array.\n    This function delegates validation to _validate_k and retrieves the element.\n    \"\"\"\n    idx = _validate_k(array, k)\n    return array[idx]\n\n```python\n# File: tests/test_kth_element.py\nfrom kth_element_module import kth_element\n\ndef run_assertion():\n    \"\"\"Runs the primary assertion and additional error case checks.\n    Verifies behavior as specified in the design document.\n    \"\"\"\n    # Provided assertion test\n    assert kth_element([12, 3, 5, 7, 19], 2) == 3\n    print(\"Assertion passed: kth_element([12, 3, 5, 7, 19], 2) == 3\")\n\n    # Additional tests for error semantics as per design\n    # BR4: TypeError for non-integer k\n    try:\n        kth_element([1, 2, 3], \"a\")\n        assert False, \"Expected TypeError for non-integer k, but none raised.\"\n    except TypeError as e:\n        assert str(e) == \"k must be an integer.\"\n        print(\"Passed: TypeError for non-integer k.\")\n    \n    # BR5/BR6: IndexError for k < 1\n    try:\n        kth_element([1, 2, 3], 0)\n        assert False, \"Expected IndexError for k < 1, but none raised.\"\n    except IndexError as e:\n        assert str(e) == \"k (0) is out of 1-based range [1, 3].\"\n        print(\"Passed: IndexError for k < 1.\")\n\n    # BR5/BR6: IndexError for k > len(array)\n    try:\n        kth_element([1, 2, 3], 4)\n        assert False, \"Expected IndexError for k > len(array), but none raised.\"\n    except IndexError as e:\n        assert str(e) == \"k (4) is out of 1-based range [1, 3].\"\n        print(\"Passed: IndexError for k > len(array).\")\n\n    # BR5/BR6: IndexError for empty array\n    try:\n        kth_element([], 1)\n        assert False, \"Expected IndexError for empty array, but none raised.\"\n    except IndexError as e:\n        assert str(e) == \"Cannot get kth element from an empty array.\"\n        print(\"Passed: IndexError for empty array.\")\n\nif __name__ == \"__main__\":\n    run_assertion()\n```"}
{"task_id": "Mbpp/102", "solution": "```python\nclass InputString:\n    \"\"\"A data holder for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass Segment:\n    \"\"\"Holds a string segment and provides an operation to capitalize its initial character.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def capitalize_initial(self) -> str:\n        \"\"\"Capitalizes the first character of the segment, preserving the rest of its case.\"\"\"\n        return _capitalize_initial(self.value)\n\nclass OutputString:\n    \"\"\"A data holder for the resulting CamelCase string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\ndef _capitalize_initial(segment: str) -> str:\n    \"\"\"Capitalizes the first character of a segment string.\n    Returns an empty string if the segment is empty; otherwise, uppercases the first character and appends the rest.\"\"\"\n    if not segment:\n        return ''\n    return segment[0].upper() + segment[1:]\n\ndef snake_to_camel(input: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase.\n    Splits the input on underscores, capitalizes the first letter of each resulting segment, and concatenates them.\"\"\"\n    input_obj = InputString(value=input)\n    segment_strings = input_obj.value.split('_')\n    segments = [Segment(value=s) for s in segment_strings]\n    capitalized_parts = [seg.capitalize_initial() for seg in segments]\n    output_value = ''.join(capitalized_parts)\n    return OutputString(value=output_value).value\n```"}
{"task_id": "Mbpp/100", "solution": "```python\n# src/__init__.py\nfrom .palindrome_service import next_smallest_palindrome\n\n```\n```python\n# src/palindrome_service.py\nfrom typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Exception type signaling validation failure.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass IntegerInput:\n    \"\"\"Lightweight value object representing input integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass PalindromeResult:\n    \"\"\"Lightweight value object encapsulating result integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass PalindromeService:\n    \"\"\"Stateless service implementing the palindrome computation algorithm and validation routines.\"\"\"\n\n    def next_smallest_palindrome(self, n: int) -> int:\n        \"\"\"Validate n then compute and return smallest palindrome strictly greater than n.\"\"\"\n        # 1. Validate that input n is integer (raise ValidationError if not)\n        if not isinstance(n, int):\n            raise ValidationError(\"Input must be an integer.\")\n        \n        # For negative inputs, the smallest palindrome strictly greater than n is 0.\n        if n < 0:\n            return 0 \n\n        # 2. Convert n to digits via to_digits.\n        digits = self.to_digits(n)\n        \n        # 3. If all digits are 9, call increment_middle which will expand digits and produce next palindrome (BR-5).\n        # This branch handles cases like 9, 99, 999 etc., resulting in a length increase (e.g., 99 -> 101).\n        if all(d == 9 for d in digits):\n            result_digits = self.increment_middle(digits)\n            return self.from_digits(result_digits)\n\n        # 4. Otherwise, create a mirrored candidate via mirror_left_to_right.\n        candidate_digits = self.mirror_left_to_right(digits)\n        candidate_val = self.from_digits(candidate_digits)\n        \n        # 5. If candidate > n, return candidate (converted to int via from_digits).\n        if candidate_val > n:\n            return candidate_val\n        \n        # 6. If candidate <= n, call increment_middle to adjust middle digits and propagate carry.\n        #    The increment_middle method itself handles internal mirroring to ensure a palindrome result.\n        result_digits = self.increment_middle(digits) \n        return self.from_digits(result_digits)\n\n    def is_palindrome(self, n: int) -> bool:\n        \"\"\"Check digit-wise palindrome property.\"\"\"\n        digits = self.to_digits(n)\n        return digits == digits[::-1]\n\n    def to_digits(self, n: int) -> List[int]:\n        \"\"\"Convert integer to most-significant-first digit list.\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        temp_n = n\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        return digits[::-1] # Reverse the list to get most-significant-first order\n\n    def from_digits(self, digits: List[int]) -> int:\n        \"\"\"Convert digit list back to integer.\"\"\"\n        if not digits:\n            return 0 # Handle empty digit lists, consistent with 0.\n        num = 0\n        for digit in digits:\n            num = num * 10 + digit\n        return num\n\n    def mirror_left_to_right(self, digits: List[int]) -> List[int]:\n        \"\"\"Mirror left half to right half to form candidate palindrome digits.\"\"\"\n        n = len(digits)\n        mirrored_digits = list(digits) # Work on a copy to avoid side effects\n        for i in range(n // 2):\n            mirrored_digits[n - 1 - i] = mirrored_digits[i]\n        return mirrored_digits\n\n    def increment_middle(self, digits: List[int]) -> List[int]:\n        \"\"\"Increment the middle digit(s) and propagate carry, expanding length for all-9s.\"\"\"\n        n = len(digits)\n        \n        # Special case: If all digits are 9, the number expands (e.g., 9 -> 11, 99 -> 101).\n        if all(d == 9 for d in digits):\n            return [1] + [0] * (n - 1) + [1] \n\n        new_digits = list(digits)\n        \n        # Determine the starting index for incrementing from the effective middle.\n        # This is the exact middle digit for odd length, or the rightmost digit of the left half for even length.\n        i = (n - 1) // 2 \n        \n        carry = 1\n        \n        # Propagate carry from the middle (or left-middle) towards the most significant digit.\n        while i >= 0 and carry > 0:\n            val = new_digits[i] + carry\n            new_digits[i] = val % 10\n            carry = val // 10\n            i -= 1\n        \n        # After incrementing and propagating carry, mirror the left half to the right to form a palindrome.\n        return self.mirror_left_to_right(new_digits)\n\n# Instantiate the stateless service for the module-level API.\n_palindrome_service_instance = PalindromeService()\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Public API entry point: Computes the smallest palindrome strictly greater than n.\"\"\"\n    return _palindrome_service_instance.next_smallest_palindrome(n)\n\n```\n```python\n# tests/test_palindrome.py\nimport pytest\nfrom src.palindrome_service import next_smallest_palindrome, ValidationError\n\ndef test_next_smallest_palindrome_99():\n    \"\"\"Verifies the specific acceptance criteria: 99 -> 101.\"\"\"\n    assert next_smallest_palindrome(99) == 101\n\ndef test_non_integer_input_raises():\n    \"\"\"Verifies that non-integer inputs raise a ValidationError.\"\"\"\n    with pytest.raises(ValidationError, match=\"Input must be an integer.\"):\n        next_smallest_palindrome('abc')\n    with pytest.raises(ValidationError, match=\"Input must be an integer.\"):\n        next_smallest_palindrome(12.34)\n\n```"}
{"task_id": "Mbpp/100", "solution": "```python\n# src/__init__.py\n# Python package marker; no runtime state.\n```\n```python\n# src/models.py\n\nclass InputInteger:\n    \"\"\"Simple immutable holder for the caller-provided integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass PalindromeResult:\n    \"\"\"Simple immutable holder for the computed palindrome result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n```\n```python\n# src/validator.py\nimport sys\n\nclass Validator:\n    \"\"\"Encapsulates input validation and overflow checks.\"\"\"\n\n    def validate_input_type(self, obj) -> bool:\n        \"\"\"Returns True if obj is an integer, otherwise raises TypeError per BR-7.\"\"\"\n        if not isinstance(obj, int):\n            raise TypeError(\"Input must be an integer.\")\n        return True\n\n    def check_overflow(self, value: int) -> bool:\n        \"\"\"Raises OverflowError if value exceeds practical platform integer bounds per BR-8.\"\"\"\n        # Python integers have arbitrary precision. sys.maxsize serves as a common proxy\n        # for \"platform integer bounds\" (e.g., maximum C long).\n        if abs(value) > sys.maxsize:\n            raise OverflowError(\"Result exceeds practical platform integer bounds.\")\n        return True\n```\n```python\n# src/palindrome_calculator.py\nfrom src.validator import Validator\nfrom src.models import InputInteger, PalindromeResult\n\nclass PalindromeCalculator:\n    \"\"\"Core algorithmic component finding minimal palindrome > input.\"\"\"\n\n    def is_palindrome(self, n: int) -> bool:\n        \"\"\"Checks if a number is a palindrome by comparing its string representation with its reverse.\"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    def generate_next_candidate(self, n: int) -> int:\n        \"\"\"Generates the next numerical candidate for palindrome search by incrementing the input.\"\"\"\n        return n + 1\n\n    def next_smallest_palindrome(self, n_val: int) -> int:\n        \"\"\"Finds the smallest palindrome integer strictly greater than the input by iterating candidates.\"\"\"\n        current_candidate = n_val\n        while True:\n            current_candidate = self.generate_next_candidate(current_candidate)\n            if self.is_palindrome(current_candidate):\n                return current_candidate\n\n# Top-level facade function required by FR-1.\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Facade matching FR-1; validates, delegates to PalindromeCalculator, verifies overflow, and returns int.\"\"\"\n    Validator().validate_input_type(n)\n    \n    # InputInteger and PalindromeResult are used for traceability as per design.\n    input_obj = InputInteger(n) \n    \n    calculator = PalindromeCalculator()\n    result_int = calculator.next_smallest_palindrome(input_obj.value)\n    \n    Validator().check_overflow(result_int)\n    \n    result_obj = PalindromeResult(result_int)\n    return result_obj.value\n```\n```python\n# src/main.py\nfrom src.palindrome_calculator import next_smallest_palindrome\n\ndef assert_example():\n    \"\"\"Contains the example test for next_smallest_palindrome(99) == 101.\"\"\"\n    assert next_smallest_palindrome(99) == 101\n    print(\"Example assertion passed: next_smallest_palindrome(99) == 101\")\n    # Additional test cases to demonstrate functionality.\n    assert next_smallest_palindrome(8) == 9\n    assert next_smallest_palindrome(100) == 101\n    assert next_smallest_palindrome(123) == 131\n    assert next_smallest_palindrome(131) == 141\n    assert next_smallest_palindrome(1) == 2\n    assert next_smallest_palindrome(19) == 22\n    assert next_smallest_palindrome(89) == 99\n    assert next_smallest_palindrome(98) == 99\n    print(\"Additional assertions passed.\")\n\nif __name__ == \"__main__\":\n    assert_example()\n```"}
