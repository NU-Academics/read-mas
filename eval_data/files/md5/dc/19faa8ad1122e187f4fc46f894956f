{"task_id": "Mbpp/572", "solution": "```python\ndef _count_frequencies(nums: list[int]) -> dict[int,int]:\n    \"\"\"Counts the occurrences of each integer in the input list.\n    Returns a dictionary mapping each integer to its frequency.\"\"\"\n    freq_map: dict[int, int] = {}\n    for num in nums:\n        freq_map[num] = freq_map.get(num, 0) + 1\n    return freq_map\n\ndef _select_unique_preserve_order(nums: list[int], freq: dict[int,int]) -> list[int]:\n    \"\"\"Selects elements that appear exactly once, preserving their original order.\n    It iterates the input list and checks frequencies from the provided map.\"\"\"\n    result: list[int] = []\n    for num in nums:\n        if freq.get(num) == 1:\n            result.append(num)\n    return result\n\ndef two_unique_nums(nums: list[int]) -> list[int]:\n    \"\"\"Returns a list of integers that occur exactly once, preserving first-appearance order.\n    The input list `nums` is not modified.\"\"\"\n    # Handle empty input list as per functional requirement.\n    if not nums:\n        return []\n\n    # Count frequencies of all numbers in the input list.\n    frequencies = _count_frequencies(nums)\n\n    # Select unique numbers while preserving their first-appearance order.\n    unique_elements = _select_unique_preserve_order(nums, frequencies)\n\n    return unique_elements\n```"}
{"task_id": "Mbpp/572", "solution": "```python\n# src/two_unique_nums.py\n\nfrom typing import List, Dict\n\nInputList = List[int]\nResultList = List[int]\n\nclass OccurrenceMap:\n    \"\"\"\n    Encapsulates logic for counting occurrences of integers in a list.\n    Stores the counts internally in a dictionary.\n    \"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[int, int] = {}\n\n    def count_occurrences(self, input_list: InputList) -> Dict[int, int]:\n        \"\"\"\n        Builds and returns a mapping from integer to its occurrence count.\n        Iterates the input list to populate the counts.\n        \"\"\"\n        for num in input_list:\n            self._counts[num] = self._counts.get(num, 0) + 1\n        return self._counts\n\ndef two_unique_nums(input_list: InputList) -> ResultList:\n    \"\"\"\n    Returns a sublist of integers that appear exactly once in the input,\n    preserving the order of their first occurrences.\n    \"\"\"\n    occurrence_map = OccurrenceMap()\n    counts = occurrence_map.count_occurrences(input_list)\n\n    result_list: ResultList = []\n    for num in input_list:\n        if counts.get(num) == 1:\n            result_list.append(num)\n            \n    return result_list\n```\n```python\n# tests/test_two_unique_nums.py\n\nfrom src.two_unique_nums import two_unique_nums\n\ndef test_two_unique_nums_example() -> None:\n    \"\"\"\n    Verifies the primary example assertion from the SRS.\n    Checks a mixed list with unique and duplicate numbers.\n    \"\"\"\n    assert two_unique_nums([1, 2, 3, 2, 3, 4, 5]) == [1, 4, 5]\n\ndef test_two_unique_nums_empty() -> None:\n    \"\"\"\n    Verifies behavior with an empty input list.\n    Expects an empty list as output.\n    \"\"\"\n    assert two_unique_nums([]) == []\n\ndef test_two_unique_nums_all_duplicates() -> None:\n    \"\"\"\n    Verifies behavior when all numbers in the input are duplicates.\n    Expects an empty list as no numbers occur exactly once.\n    \"\"\"\n    assert two_unique_nums([2, 2, 3, 3]) == []\n\ndef test_two_unique_nums_single() -> None:\n    \"\"\"\n    Verifies behavior with a single element list.\n    The single element should be returned as it's unique.\n    \"\"\"\n    assert two_unique_nums([7]) == [7]\n\n# SRS-provided module-level direct assertion (demonstration)\nassert two_unique_nums([1, 2, 3, 2, 3, 4, 5]) == [1, 4, 5]\n```"}
{"task_id": "Mbpp/573", "solution": "```python\nfrom typing import List, Set, Iterable, Union, Any\n\n# Define a type alias for clarity as specified in the design (\"Number -> Python int/float\")\nNumber = Union[int, float]\n\ndef _validate_input(numbers: Any) -> None:\n    \"\"\"\n    Validates that the input is a list and all elements are numeric.\n    Raises TypeError on invalid input with a descriptive message.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, num in enumerate(numbers):\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"List element at index {i} is not a number: {num}\")\n\ndef _deduplicate(numbers: List[Number]) -> Set[Number]:\n    \"\"\"\n    Returns a set of unique numeric values from the input list.\n    Uses Python set semantics for deduplication (e.g., 2 and 2.0 collapse).\n    \"\"\"\n    return set(numbers)\n\ndef _compute_product(values: Iterable[Number]) -> Number:\n    \"\"\"\n    Computes the product of an iterable of numeric values.\n    Returns 1 for an empty iterable (multiplicative identity).\n    \"\"\"\n    product: Number = 1  # Initialize with multiplicative identity\n    for value in values:\n        product *= value\n    return product\n\ndef unique_product(numbers: list) -> Number:\n    \"\"\"\n    Calculates the product of unique numeric values in a given list.\n    Orchestrates input validation, deduplication, and product computation.\n    \"\"\"\n    _validate_input(numbers)\n    # After _validate_input, 'numbers' is guaranteed to be a List[Number].\n    # mypy might complain about passing 'list' (from `numbers: list`) directly to `List[Number]`,\n    # but runtime type is guaranteed.\n    unique_values = _deduplicate(numbers) # type: ignore\n    result = _compute_product(unique_values)\n    return result\n```"}
{"task_id": "Mbpp/576", "solution": "```python\n# src/__init__.py\n# Package initializer for src package.\n```\n\n```python\n# src/subarray_checker.py\ndef _validate_input_is_list(obj, name) -> None:\n    \"\"\"Internal helper. Raises TypeError if obj is not a list.\"\"\"\n    if not isinstance(obj, list):\n        raise TypeError(f\"{name} must be a list\")\n\ndef _window_ranges(source_len: int, candidate_len: int):\n    \"\"\"Internal helper. Returns a range for sliding window starts.\"\"\"\n    if candidate_len > source_len:\n        return range(0)  # Returns an empty range\n    return range(0, source_len - candidate_len + 1)\n\ndef _window_matches(source: list, start: int, candidate: list) -> bool:\n    \"\"\"Internal helper. Compares a source segment to candidate elementwise.\"\"\"\n    return source[start : start + len(candidate)] == candidate\n\ndef is_Sub_Array(source, candidate) -> bool:\n    \"\"\"Public API. Checks if candidate is a contiguous sublist of source.\"\"\"\n    _validate_input_is_list(source, 'source')\n    _validate_input_is_list(candidate, 'candidate')\n\n    if not candidate:  # Handles empty candidate as per design decision\n        return True\n\n    for start in _window_ranges(len(source), len(candidate)):\n        if _window_matches(source, start, candidate):\n            return True\n    return False\n```\n\n```python\n# tests/__init__.py\n# Package initializer for tests package.\n```\n\n```python\n# tests/test_subarray_checker.py\nimport pytest\nfrom src.subarray_checker import is_Sub_Array\n\ndef test_example_non_match():\n    \"\"\"Verifies the normative example where candidate is not a sublist.\"\"\"\n    assert is_Sub_Array([1, 4, 3, 5], [1, 2]) is False\n\ndef test_exact_match():\n    \"\"\"Verifies that an exact match of the entire list returns True.\"\"\"\n    assert is_Sub_Array([1, 2, 3], [1, 2, 3]) is True\n    assert is_Sub_Array([1, 2, 3, 4, 5], [2, 3, 4]) is True\n\ndef test_candidate_longer_than_source():\n    \"\"\"Verifies that a candidate longer than source always returns False.\"\"\"\n    assert is_Sub_Array([1, 2], [1, 2, 3]) is False\n    assert is_Sub_Array([], [1]) is False\n\ndef test_empty_candidate_behavior_decision():\n    \"\"\"Documents and tests the convention that an empty candidate is a sublist.\"\"\"\n    assert is_Sub_Array([1, 2, 3], []) is True\n    assert is_Sub_Array([], []) is True\n\ndef test_raises_type_error_for_non_list_source():\n    \"\"\"Verifies TypeError is raised when the source input is not a list.\"\"\"\n    with pytest.raises(TypeError, match=\"source must be a list\"):\n        is_Sub_Array(\"not a list\", [1, 2])\n\ndef test_raises_type_error_for_non_list_candidate():\n    \"\"\"Verifies TypeError is raised when the candidate input is not a list.\"\"\"\n    with pytest.raises(TypeError, match=\"candidate must be a list\"):\n        is_Sub_Array([1, 2], \"not a list\")\n\ndef test_single_element_list():\n    \"\"\"Tests scenarios with single-element source and candidate lists.\"\"\"\n    assert is_Sub_Array([1], [1]) is True\n    assert is_Sub_Array([1, 2], [1]) is True\n    assert is_Sub_Array([1, 2], [2]) is True\n    assert is_Sub_Array([1], [2]) is False\n\ndef test_duplicate_elements():\n    \"\"\"Tests behavior with duplicate elements in source and candidate.\"\"\"\n    assert is_Sub_Array([1, 2, 1, 2, 3], [1, 2]) is True\n    assert is_Sub_Array([1, 1, 1], [1, 1]) is True\n    assert is_Sub_Array([1, 2, 3, 2, 3, 4], [2, 3]) is True\n\ndef test_no_match_but_partial_overlap():\n    \"\"\"Tests cases where elements match partially but not contiguously.\"\"\"\n    assert is_Sub_Array([1, 2, 4, 3, 5], [1, 3]) is False\n    assert is_Sub_Array([1, 2, 3, 4], [1, 3]) is False\n```"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, candidate_sublist):\n    \"\"\"\n    Checks if candidate_sublist is a contiguous sublist of main_list.\n    Handles empty candidate and length comparisons as specified.\n    \"\"\"\n    len_main = len(main_list)\n    len_candidate = len(candidate_sublist)\n\n    if len_candidate == 0:\n        return True\n    if len_candidate > len_main:\n        return False\n\n    for i in range(len_main - len_candidate + 1):\n        # Compare a slice of main_list with candidate_sublist\n        if main_list[i : i + len_candidate] == candidate_sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/578", "solution": "```python\nfrom typing import Any, List\n\nclass ValidationError(Exception):\n    \"\"\"Domain-specific exception for validation failure.\n    Raised when input lists do not meet required criteria.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputList:\n    \"\"\"Lightweight domain wrapper for an input list.\n    Provides a simple way to access elements and length.\n    \"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass InterleavedList:\n    \"\"\"Lightweight domain wrapper for the output interleaved list.\n    Holds the resulting flat list of interleaved elements.\n    \"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\nclass Interleaver:\n    \"\"\"Encapsulates validation and interleaving logic for lists.\n    It is designed to be stateless, processing inputs directly.\n    \"\"\"\n\n    def validate_lengths(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> None:\n        \"\"\"Checks if all three input lists have equal length.\n        Raises ValidationError if lengths are unequal.\n        \"\"\"\n        len1 = InputList(list1).length()\n        len2 = InputList(list2).length()\n        len3 = InputList(list3).length()\n        if not (len1 == len2 and len1 == len3):\n            raise ValidationError(\"Input lists must have equal length.\")\n\n    def interleave_lists(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n        \"\"\"Interleaves elements from three lists into a single flat list.\n        First validates lengths, then constructs the interleaved list.\n        \"\"\"\n        self.validate_lengths(list1, list2, list3)\n        \n        # All lists are guaranteed to have the same length after validation.\n        length = InputList(list1).length() \n        result_elements: List[Any] = []\n        for i in range(length):\n            result_elements.append(list1[i])\n            result_elements.append(list2[i])\n            result_elements.append(list3[i])\n        \n        # Returns the raw list from the InterleavedList DTO.\n        return InterleavedList(result_elements).elements\n\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"Public API to interleave three lists, delegating to Interleaver service.\n    Validates input lengths and produces a single flat interleaved list.\n    \"\"\"\n    interleaver = Interleaver()\n    return interleaver.interleave_lists(list1, list2, list3)\n```"}
{"task_id": "Mbpp/577", "solution": "```python\ndef last_Digit_Factorial(n):\n    \"\"\"Calculates the last decimal digit of n!.\n    Returns 0 for n >= 5, 1 for n=0, and the computed last digit for 1 <= n <= 4.\n    \"\"\"\n    if n >= 5:\n        return 0\n    elif n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n\n```"}
{"task_id": "Mbpp/577", "solution": "```python\n# src/main.py\nfrom last_digit_factorial.test_suite import TestSuite\n\ndef main():\n    \"\"\"Entry point to execute the TestSuite's assertions.\"\"\"\n    print(\"Starting main execution to run tests...\")\n    test_runner = TestSuite()\n    test_runner.run_assertions()\n    print(\"All tests completed.\")\n\nif __name__ == '__main__':\n    main()\n```\n\n```python\n# src/last_digit_factorial/__init__.py\nfrom .factorial_service import last_Digit_Factorial\n\n__all__ = [\"last_Digit_Factorial\"]\n```\n\n```python\n# src/last_digit_factorial/factorial_service.py\nfrom .input_validator import InputValidator\nfrom .factorial_calculator import FactorialCalculator\nfrom .error_handler import ErrorHandler\nfrom .result import Result\n\nclass FactorialService:\n    \"\"\"Orchestrates validation, computation, and error propagation for factorial last digit.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the service with its dependencies.\"\"\"\n        self._validator = InputValidator()\n        self._calculator = FactorialCalculator()\n        self._error_handler = ErrorHandler()\n\n    def last_Digit_Factorial(self, n) -> int:\n        \"\"\"Validates input, computes the last digit of n!, and returns it.\"\"\"\n        if not self._validator.is_integer(n):\n            self._error_handler.raise_value_error(\"input must be a non-negative integer\")\n        \n        if not self._validator.is_non_negative(n):\n            self._error_handler.raise_value_error(\"input must be a non-negative integer\")\n        \n        result_obj: Result = self._calculator.compute_last_digit(n)\n        return result_obj.last_digit\n\n# The public API function, re-exporting the service method\ndef last_Digit_Factorial(n) -> int:\n    \"\"\"\n    Public API: Accepts an integer n and returns the last decimal digit (0-9) of n!.\n    Raises ValueError for invalid inputs (non-integer or negative).\n    \"\"\"\n    return FactorialService().last_Digit_Factorial(n)\n```\n\n```python\n# src/last_digit_factorial/input_validator.py\nclass InputValidator:\n    \"\"\"Validates input type and sign per SRS preconditions.\"\"\"\n\n    def is_integer(self, value) -> bool:\n        \"\"\"Checks if the value is an integer type.\"\"\"\n        return isinstance(value, int)\n\n    def is_non_negative(self, n: int) -> bool:\n        \"\"\"Checks if the number is non-negative.\"\"\"\n        return n >= 0\n```\n\n```python\n# src/last_digit_factorial/factorial_calculator.py\nfrom .result import Result\n\nclass FactorialCalculator:\n    \"\"\"Computes factorial values and extracts their last decimal digit.\"\"\"\n\n    def compute_factorial(self, n: int) -> int:\n        \"\"\"Computes n! as an integer (0! is 1).\"\"\"\n        if n == 0:\n            return 1\n        \n        factorial_result = 1\n        for i in range(1, n + 1):\n            factorial_result *= i\n        return factorial_result\n\n    def compute_last_digit(self, n: int) -> Result:\n        \"\"\"Computes and returns the last decimal digit of n! within a Result object.\"\"\"\n        # For n >= 5, the last digit of n! is 0.\n        if n >= 5:\n            last_digit = 0\n        else:\n            factorial_value = self.compute_factorial(n)\n            last_digit = factorial_value % 10\n        \n        return Result(last_digit)\n```\n\n```python\n# src/last_digit_factorial/result.py\nclass Result:\n    \"\"\"A data transfer object (DTO) to hold the last digit of a factorial.\"\"\"\n\n    def __init__(self, last_digit: int):\n        \"\"\"Constructs a Result with the specified last_digit.\"\"\"\n        self.last_digit = last_digit\n\n    @property\n    def last_digit(self) -> int:\n        \"\"\"The last decimal digit (0-9).\"\"\"\n        return self._last_digit\n\n    @last_digit.setter\n    def last_digit(self, value: int):\n        if not 0 <= value <= 9:\n            raise ValueError(\"Last digit must be between 0 and 9.\")\n        self._last_digit = value\n```\n\n```python\n# src/last_digit_factorial/error_handler.py\nclass ErrorHandler:\n    \"\"\"Handles raising ValueError exceptions with consistent messages.\"\"\"\n\n    def raise_value_error(self, message: str):\n        \"\"\"Raises a ValueError with the provided message.\"\"\"\n        raise ValueError(message)\n```\n\n```python\n# src/last_digit_factorial/test_suite.py\nfrom .factorial_service import last_Digit_Factorial\n\nclass TestSuite:\n    \"\"\"Runs assertion-based unit tests for the last_Digit_Factorial function.\"\"\"\n\n    def run_assertions(self):\n        \"\"\"Executes the required assertion test.\"\"\"\n        print(\"Running assertion: assert last_Digit_Factorial(4) == 4\")\n        try:\n            assert last_Digit_Factorial(4) == 4\n            print(\"Assertion passed: last_Digit_Factorial(4) == 4\")\n        except AssertionError:\n            print(\"Assertion FAILED: last_Digit_Factorial(4) != 4\")\n            raise\n        except ValueError as e:\n            print(f\"Assertion failed due to unexpected ValueError: {e}\")\n            raise\n```"}
{"task_id": "Mbpp/578", "solution": "```python\n# src/interleave.py\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for validation failures during list interleaving.\n    Holds a message describing the error and an optional error code.\n    \"\"\"\n    def __init__(self, message: str, code: int = 0):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass InterleaveFunction:\n    \"\"\"\n    Encapsulates the logic for validating inputs and interleaving lists.\n    This class is stateless and its methods are static.\n    \"\"\"\n    @staticmethod\n    def validate_inputs(list1, list2, list3):\n        \"\"\"\n        Validates that all inputs are lists and have equal length.\n        Raises ValidationError if validation fails.\n        \"\"\"\n        if not all(isinstance(lst, list) for lst in [list1, list2, list3]):\n            raise ValidationError(message=\"inputs must be lists\", code=1)\n\n        len1, len2, len3 = len(list1), len(list2), len(list3)\n        if not (len1 == len2 == len3):\n            raise ValidationError(message=\"input lists must have equal length\", code=2)\n\n    @staticmethod\n    def build_output(list1, list2, list3):\n        \"\"\"\n        Builds and returns a new list by interleaving elements from the three input lists.\n        Elements are interleaved in the order list1[i], list2[i], list3[i].\n        \"\"\"\n        n = len(list1)\n        output_list = [None] * (3 * n) # Pre-allocate list for efficient filling.\n        \n        for i in range(n):\n            output_list[3 * i] = list1[i]\n            output_list[3 * i + 1] = list2[i]\n            output_list[3 * i + 2] = list3[i]\n        \n        return output_list\n\n    @staticmethod\n    def interleave_lists(list1, list2, list3):\n        \"\"\"\n        Orchestrates the validation and building of the interleaved list.\n        Delegates to validate_inputs and build_output.\n        \"\"\"\n        InterleaveFunction.validate_inputs(list1, list2, list3)\n        return InterleaveFunction.build_output(list1, list2, list3)\n\ndef interleave_lists(list1, list2, list3):\n    \"\"\"\n    Public API function to interleave three lists.\n    Delegates the core logic to InterleaveFunction.\n    \"\"\"\n    return InterleaveFunction.interleave_lists(list1, list2, list3)\n```\n```python\n# tests/test_interleave.py\n\nimport pytest\nfrom src.interleave import interleave_lists, ValidationError\n\ndef test_example_assertion():\n    \"\"\"\n    Verifies the canonical example assertion provided in the design specification.\n    Ensures the function correctly interleaves lists as expected.\n    \"\"\"\n    list1 = [1, 2, 3, 4, 5, 6, 7]\n    list2 = [10, 20, 30, 40, 50, 60, 70]\n    list3 = [100, 200, 300, 400, 500, 600, 700]\n    expected = [1, 10, 100, 2, 20, 200, 3, 30, 300, 4, 40, 400, 5, 50, 500, 6, 60, 600, 7, 70, 700]\n    assert interleave_lists(list1, list2, list3) == expected\n\ndef test_validation_errors():\n    \"\"\"\n    Asserts that ValidationError is raised for various invalid inputs.\n    Tests non-list inputs and lists with unequal lengths.\n    \"\"\"\n    # Test case 1: Non-list input for list1\n    with pytest.raises(ValidationError) as excinfo:\n        interleave_lists(\"not a list\", [1, 2], [3, 4])\n    assert excinfo.value.message == \"inputs must be lists\"\n    assert excinfo.value.code == 1\n\n    # Test case 2: Non-list input for list2\n    with pytest.raises(ValidationError) as excinfo:\n        interleave_lists([1, 2], None, [3, 4])\n    assert excinfo.value.message == \"inputs must be lists\"\n    assert excinfo.value.code == 1\n\n    # Test case 3: Non-list input for list3\n    with pytest.raises(ValidationError) as excinfo:\n        interleave_lists([1, 2], [3, 4], 123)\n    assert excinfo.value.message == \"inputs must be lists\"\n    assert excinfo.value.code == 1\n\n    # Test case 4: Mixed non-list inputs\n    with pytest.raises(ValidationError) as excinfo:\n        interleave_lists(1, 2, 3)\n    assert excinfo.value.message == \"inputs must be lists\"\n    assert excinfo.value.code == 1\n\n    # Test case 5: Unequal lengths (list1 shorter)\n    with pytest.raises(ValidationError) as excinfo:\n        interleave_lists([1], [10, 20], [100, 200])\n    assert excinfo.value.message == \"input lists must have equal length\"\n    assert excinfo.value.code == 2\n\n    # Test case 6: Unequal lengths (list2 shorter)\n    with pytest.raises(ValidationError) as excinfo:\n        interleave_lists([1, 2], [10], [100, 200])\n    assert excinfo.value.message == \"input lists must have equal length\"\n    assert excinfo.value.code == 2\n\n    # Test case 7: Unequal lengths (list3 shorter)\n    with pytest.raises(ValidationError) as excinfo:\n        interleave_lists([1, 2], [10, 20], [100])\n    assert excinfo.value.message == \"input lists must have equal length\"\n    assert excinfo.value.code == 2\n\n    # Test case 8: Empty lists (valid case, should not raise)\n    assert interleave_lists([], [], []) == []\n\n\ndef test_input_immutability():\n    \"\"\"\n    Verifies that the input lists are not modified by the interleave_lists function.\n    Checks immutability for both successful and error-raising calls.\n    \"\"\"\n    # Case 1: Successful call\n    list1_original = [1, 2, 3]\n    list2_original = [10, 20, 30]\n    list3_original = [100, 200, 300]\n\n    list1_copy = list(list1_original)\n    list2_copy = list(list2_original)\n    list3_copy = list(list3_original)\n\n    interleave_lists(list1_copy, list2_copy, list3_copy)\n\n    assert list1_copy == list1_original\n    assert list2_copy == list2_original\n    assert list3_copy == list3_original\n\n    # Case 2: Call resulting in ValidationError (type mismatch)\n    list1_original_err = [1, 2]\n    list2_original_err = [10, 20]\n    list3_original_err = [100, 200]\n\n    list1_copy_err = list(list1_original_err)\n    list2_copy_err = list(list2_original_err)\n    list3_copy_err = list(list3_original_err)\n\n    try:\n        interleave_lists(123, list2_copy_err, list3_copy_err)\n    except ValidationError:\n        pass # Expected error caught\n\n    assert list1_copy_err == list1_original_err\n    assert list2_copy_err == list2_original_err\n    assert list3_copy_err == list3_original_err\n\n    # Case 3: Call resulting in ValidationError (length mismatch)\n    list1_original_len_err = [1, 2]\n    list2_original_len_err = [10]\n    list3_original_len_err = [100, 200]\n\n    list1_copy_len_err = list(list1_original_len_err)\n    list2_copy_len_err = list(list2_original_len_err)\n    list3_copy_len_err = list(list3_original_len_err)\n\n    try:\n        interleave_lists(list1_copy_len_err, list2_copy_len_err, list3_copy_len_err)\n    except ValidationError:\n        pass # Expected error caught\n\n    assert list1_copy_len_err == list1_original_len_err\n    assert list2_copy_len_err == list2_original_len_err\n    assert list3_copy_len_err == list3_original_len_err\n```"}
{"task_id": "Mbpp/579", "solution": "```python\nfrom typing import Any, Tuple, List\n\ndef find_dissimilar(a: Tuple[Any, ...], b: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Finds elements unique to each tuple, preserving order and duplicates.\n    Returns elements from 'a' not in 'b', then elements from 'b' not in 'a'.\n    \"\"\"\n\n    def _collect_uniques_nested(src: Tuple[Any, ...], dst: Tuple[Any, ...]) -> List[Any]:\n        \"\"\"\n        Collects elements from src that are not in dst, preserving order and duplicates.\n        Membership is checked by element value equality.\n        \"\"\"\n        collected_elements = []\n        for item in src:\n            if item not in dst:\n                collected_elements.append(item)\n        return collected_elements\n\n    uniques_from_a = _collect_uniques_nested(a, b)\n    uniques_from_b = _collect_uniques_nested(b, a)\n    result_list = uniques_from_a + uniques_from_b\n    return tuple(result_list)\n```"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a, b) -> tuple:\n    \"\"\"Computes the symmetric difference of two tuples, preserving relative order and uniqueness.\n    Elements from 'a' appear first, then elements from 'b', both de-duplicated in their original order.\n    \"\"\"\n    result_list = []\n    seen = set()\n    \n    # Prepare sets for efficient membership checks.\n    set_a_elements = set(a)\n    set_b_elements = set(b)\n\n    # Add unique elements from 'a' that are not in 'b', preserving order.\n    for item in a:\n        if item not in set_b_elements and item not in seen:\n            result_list.append(item)\n            seen.add(item)\n\n    # Add unique elements from 'b' that are not in 'a', preserving order.\n    for item in b:\n        if item not in set_a_elements and item not in seen:\n            result_list.append(item)\n            seen.add(item)\n            \n    return tuple(result_list)"}
{"task_id": "Mbpp/580", "solution": "```python\n# src/extract_even.py\n\"\"\"\nPublic API: def extract_even(input: tuple) -> tuple\n\"\"\"\n\ndef _extract_even_recursive(obj):\n    \"\"\"\n    Recursively processes elements, removing odd integers and preserving order.\n    Returns the processed element or a sentinel (Ellipsis) if an odd integer is filtered.\n    \"\"\"\n    if isinstance(obj, tuple):\n        processed_elements = []\n        for item in obj:\n            processed_item = _extract_even_recursive(item)\n            if processed_item is not Ellipsis:  # Append only if not an odd integer filtered out\n                processed_elements.append(processed_item)\n        return tuple(processed_elements)\n    elif isinstance(obj, int):\n        return obj if obj % 2 == 0 else Ellipsis  # Return Ellipsis to signal removal of odd integers\n    else:\n        return obj  # Preserve non-integer, non-tuple elements unchanged\n\ndef extract_even(input: tuple) -> tuple:\n    \"\"\"\n    Public API to recursively traverse nested tuples and remove odd integers.\n    Returns a new tuple with even integers and preserved non-integers/non-tuples, maintaining structure.\n    \"\"\"\n    return _extract_even_recursive(input)\n\n```\n```python\n# tests/test_extract_even.py\nimport pytest\nfrom src.extract_even import extract_even\n\ndef test_extract_even_example():\n    \"\"\"\n    Verifies the function correctly handles the provided acceptance example.\n    This test ensures the core recursive filtering logic works as expected.\n    \"\"\"\n    input_tuple = (4, 5, (7, 6, (2, 4)), 6, 8)\n    expected_output = (4, (6, (2, 4)), 6, 8)\n    assert extract_even(input_tuple) == expected_output\n\ndef test_preserve_types_and_order():\n    \"\"\"\n    Checks that non-integer, non-tuple elements are preserved and order is maintained.\n    Includes tests for empty tuples, all odd, and all even numbers.\n    \"\"\"\n    assert extract_even(()) == ()\n    assert extract_even((1, 3, 5)) == ()\n    assert extract_even((2, 4, 6)) == (2, 4, 6)\n    assert extract_even((1, 2, \"a\", (3, 4, True), 5, [6], None)) == (2, \"a\", (4, True), [6], None)\n    assert extract_even((1, (2, 3), 4, (5, (6, 7)))) == ((2,), 4, ((6,)))\n    assert extract_even((1, \"text\", (3, None, 5, 6), 7)) == (\"text\", (None, 6))\n\ndef test_purity_and_identity():\n    \"\"\"\n    Ensures the function does not modify the input and always returns a new tuple.\n    Verifies that the output is indeed a tuple type.\n    \"\"\"\n    input_tuple = (4, 5, (7, 6, (2, 4)), 6, 8)\n    # Store a copy to compare later, ensuring input_tuple itself is not modified\n    original_input_copy = input_tuple \n\n    result = extract_even(input_tuple)\n\n    assert isinstance(result, tuple) # Ensure output is a tuple\n    assert result is not input_tuple # Ensure a new tuple instance is returned (unless input is () and result is ())\n    assert input_tuple == original_input_copy # Ensure the input tuple remains unchanged (purity)\n\n    # Test case where input and output are structurally identical but still a new object\n    input_all_even = (2, (4, 6))\n    result_all_even = extract_even(input_all_even)\n    assert result_all_even == input_all_even\n    assert result_all_even is not input_all_even\n\n```"}
{"task_id": "Mbpp/580", "solution": "```python\nfrom typing import Tuple, Any, Optional\n\ndef _extract_even_internal(obj: object) -> Optional[object]:\n    \"\"\"Returns: int for even integers, None for odd integers, tuple for nested tuples (may be empty tuple).\"\"\"\n    if isinstance(obj, int):\n        return obj if obj % 2 == 0 else None\n    else: # Trusting input that obj is either an int or a tuple, so this must be a tuple.\n        processed_elements = []\n        for item in obj:\n            result = _extract_even_internal(item)\n            if result is not None:\n                processed_elements.append(result)\n        return tuple(processed_elements)\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Accepts a tuple (which may contain integers and nested tuples) and returns a new tuple with odd integers removed recursively.\"\"\"\n    result_list = []\n    for item in input_tuple:\n        processed_item = _extract_even_internal(item)\n        if processed_item is not None:\n            result_list.append(processed_item)\n    return tuple(result_list)\n```"}
{"task_id": "Mbpp/583", "solution": "```python\ndef _binomial_coefficient(N: int, K: int) -> int:\n    \"\"\"Calculates (N choose K) using an iterative method.\n    It handles negative K or K > N by returning 0.\"\"\"\n    if K < 0 or K > N:\n        return 0\n    if K == 0 or K == N:\n        return 1\n    if K > N // 2:\n        K = N - K\n\n    res = 1\n    for i in range(K):\n        res = res * (N - i) // (i + 1)\n    return res\n\ndef catalan_number(n: int) -> int:\n    \"\"\"Computes the nth Catalan number.\n    Uses the formula C_n = (1 / (n + 1)) * (2n choose n).\"\"\"\n    if n < 0:\n        return 0\n    if n == 0:\n        return 1\n    \n    binom_val = _binomial_coefficient(2 * n, n)\n    return binom_val // (n + 1)\n```"}
{"task_id": "Mbpp/583", "solution": "```python\n# src/catalan_number.py\n\ndef _validate_n(n) -> None:\n    \"\"\"Validates that n is a non-negative integer.\n    Raises ValueError if n is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be non-negative.\")\n\ndef _compute_catalan(n: int) -> int:\n    \"\"\"Computes the nth Catalan number using dynamic programming.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # C[k] stores the kth Catalan number\n    C = [0] * (n + 1)\n    C[0] = 1\n\n    for k in range(1, n + 1):\n        current_Ck = 0\n        for i in range(k):\n            current_Ck += C[i] * C[k - 1 - i]\n        C[k] = current_Ck\n    return C[n]\n\ndef catalan_number(n: int) -> int:\n    \"\"\"Computes the nth Catalan number.\n    Validates input n and uses exact integer arithmetic.\n    \"\"\"\n    _validate_n(n)\n    return _compute_catalan(n)\n\n```\n```python\n# tests/test_catalan_number.py\n\nfrom catalan_number import catalan_number\n\ndef test_catalan_10():\n    \"\"\"Verifies that the 10th Catalan number is 16796.\n    This serves as an acceptance test for the catalan_number function.\n    \"\"\"\n    assert catalan_number(10) == 16796\n\n```"}
{"task_id": "Mbpp/581", "solution": "```python\n# src/input_validator.py\nclass InputValidator:\n    \"\"\"Provides utility for numeric input validation.\"\"\"\n    def is_numeric(self, value) -> bool:\n        \"\"\"Checks if a value is an int or float, but not a boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n```\n```python\n# src/square_pyramid.py\nfrom src.input_validator import InputValidator\n\nclass SquarePyramid:\n    \"\"\"Encapsulates square pyramid dimensions and computes its areas.\"\"\"\n    def __init__(self, base_edge, height):\n        validator = InputValidator()\n        if not validator.is_numeric(base_edge):\n            raise TypeError(\"base_edge must be int or float\")\n        if not validator.is_numeric(height):\n            raise TypeError(\"height must be int or float\")\n        self.base_edge = float(base_edge)\n        self.height = float(height)\n        self.base_area = None\n        self.lateral_area = None\n        self.surface_area = None\n\n    def compute_base_area(self) -> float:\n        \"\"\"Calculates and stores the base area.\"\"\"\n        self.base_area = self.base_edge * self.base_edge\n        return self.base_area\n\n    def compute_lateral_area(self) -> float:\n        \"\"\"Calculates and stores the lateral area.\"\"\"\n        self.lateral_area = 2 * self.base_edge * self.height\n        return self.lateral_area\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Computes and returns the total surface area, calculating sub-areas if needed.\"\"\"\n        if self.base_area is None:\n            self.compute_base_area()\n        if self.lateral_area is None:\n            self.compute_lateral_area()\n        self.surface_area = self.base_area + self.lateral_area\n        return self.surface_area\n```\n```python\n# src/surface_area.py\nfrom src.input_validator import InputValidator\nfrom src.square_pyramid import SquarePyramid\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Validates inputs and returns the surface area of a square pyramid.\n    Raises TypeError if inputs are not numeric.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_numeric(base_edge):\n        raise TypeError(\"base_edge must be int or float\")\n    if not validator.is_numeric(height):\n        raise TypeError(\"height must be int or float\")\n    pyramid = SquarePyramid(base_edge, height)\n    return pyramid.compute_surface_area()\n```"}
{"task_id": "Mbpp/581", "solution": "```python\nfrom typing import Union\n\ndef surface_Area(base_edge: Union[int, float], height: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Computes the surface area of a square pyramid.\n    The design mandates delegation to a SquarePyramid dataclass, but critical constraints require returning only the bare function. Thus, computation is performed directly here.\n    \"\"\"\n    return base_edge**2 + 2 * base_edge * height\n```"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(data, n):\n    \"\"\"\n    Selects up to n items with the highest price from an input dataset.\n    Orchestrates filtering, sorting, and selection of items.\n    \"\"\"\n    _validate_inputs(data, n)\n    \n    items_with_index = _filter_valid_items(data)\n    \n    sorted_items = _sort_items(items_with_index)\n    \n    return _select_top_n(sorted_items, n)\n\ndef _validate_inputs(data, n):\n    \"\"\"\n    Internal helper for input validation.\n    No validation is performed as per critical requirements.\n    \"\"\"\n    pass\n\ndef _filter_valid_items(data):\n    \"\"\"\n    Internal helper to process input data.\n    Assumes all input items are valid dictionaries with a numeric 'price' as per critical requirements.\n    \"\"\"\n    valid_items_with_index = []\n    for i, item in enumerate(data):\n        valid_items_with_index.append((i, item))\n    return valid_items_with_index\n\ndef _sort_items(items_with_index):\n    \"\"\"\n    Internal helper to stable sort valid items by price descending.\n    Python's sorted() is stable, preserving original relative order for equal prices.\n    \"\"\"\n    sorted_items_with_index = sorted(items_with_index, key=lambda x: x[1]['price'], reverse=True)\n    return [item_dict for _, item_dict in sorted_items_with_index]\n\ndef _select_top_n(sorted_items, n):\n    \"\"\"\n    Internal helper to select up to n items from a sorted list.\n    Handles n <= 0 by returning an empty list.\n    \"\"\"\n    if n <= 0:\n        return []\n    return sorted_items[:n]"}
{"task_id": "Mbpp/585", "solution": "```python\nfrom typing import List, Dict, Any\n\n# src/item.py\nclass Item:\n    \"\"\"Represents an item with a name and a numeric price.\"\"\"\n    def __init__(self, name: str, price: float) -> None:\n        self.name = name\n        self.price = price\n\n    @staticmethod\n    def from_dict(d: Dict[str, Any]) -> 'Item':\n        \"\"\"Creates an Item from a dictionary, validating keys and price.\"\"\"\n        if 'name' not in d or 'price' not in d:\n            raise ValueError(\"Item dictionary must contain 'name' and 'price' keys.\")\n        \n        try:\n            price_val = float(d['price'])\n        except (TypeError, ValueError) as e:\n            raise ValueError(f\"Price '{d['price']}' cannot be converted to float.\") from e\n        \n        return Item(name=str(d['name']), price=price_val)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the Item instance back to a dictionary.\"\"\"\n        return {'name': self.name, 'price': self.price}\n\n# src/item_collection.py\n# The following import is based on the design's specified module structure.\n# In a single-file output, Item is assumed to be defined previously.\n# from item import Item \n\nclass ItemCollection:\n    \"\"\"A collection of Item objects with methods for sorting and selecting top items.\"\"\"\n    def __init__(self, items: List[Item]) -> None:\n        self.items = list(items)\n\n    def sort_by_price_desc(self) -> List[Item]:\n        \"\"\"Returns a new list of items sorted by price in descending order.\"\"\"\n        # Python's sorted() is stable, preserving input order for equal prices.\n        return sorted(self.items, key=lambda it: it.price, reverse=True)\n\n    def get_top_n(self, n: int) -> List[Item]:\n        \"\"\"Returns the n most expensive items from the collection.\"\"\"\n        if n == 0:\n            return []\n        \n        sorted_items = self.sort_by_price_desc()\n        return sorted_items[:n]\n\n# src/expensive_items_service.py\n# The following imports are based on the design's specified module structure.\n# In a single-file output, Item and ItemCollection are assumed to be defined previously.\n# from item import Item\n# from item_collection import ItemCollection\n\nclass ExpensiveItemsService:\n    \"\"\"Stateless service to identify the n most expensive items.\"\"\"\n    def expensive_items(self, items_input: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n        \"\"\"Processes a list of item dictionaries to find the n most expensive.\"\"\"\n        items: List[Item] = []\n        for item_dict in items_input:\n            items.append(Item.from_dict(item_dict))\n\n        item_collection = ItemCollection(items)\n        top_items = item_collection.get_top_n(n)\n\n        return [item.to_dict() for item in top_items]\n\n# Public API function as specified by the design.\ndef expensive_items(items: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"Returns the n most expensive items from a list of item dictionaries.\"\"\"\n    service = ExpensiveItemsService()\n    return service.expensive_items(items, n)\n```"}
