{"task_id": "Mbpp/607", "solution": "```python\n# src/domain.py\nfrom dataclasses import dataclass\nfrom typing import Optional, Tuple\n\n@dataclass\nclass TextInput:\n    \"\"\"Holds content of the input text.\"\"\"\n    content: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the text content.\"\"\"\n        return len(self.content)\n\n@dataclass\nclass RegexPattern:\n    \"\"\"Holds the regex pattern and optional flags.\"\"\"\n    pattern: str\n    flags: Optional[str] = None\n\n@dataclass\nclass MatchResult:\n    \"\"\"Represents a found regex match with substring and indices.\"\"\"\n    substring: str\n    start_index: int\n    end_index: int\n\n    def to_tuple(self) -> Tuple[str, int, int]:\n        \"\"\"Converts the MatchResult to a (substring, start_index, end_index) tuple.\"\"\"\n        return (self.substring, self.start_index, self.end_index)\n\n```\n```python\n# src/finder_service.py\nimport re\nfrom typing import Optional, Tuple\n\nfrom src.domain import TextInput, RegexPattern, MatchResult\n\nclass FinderService:\n    \"\"\"Stateless service performing regex searches.\"\"\"\n    def find_literals(self, text: TextInput, pattern: RegexPattern) -> Optional[MatchResult]:\n        \"\"\"Searches for the first regex match in the text.\"\"\"\n        match = re.search(pattern.pattern, text.content)\n        if match:\n            return MatchResult(match.group(0), match.start(), match.end())\n        return None\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches the input text with a regex pattern and returns the first match.\n    Returns (substring, start_index, end_index) or None if no match.\n    \"\"\"\n    text_input = TextInput(content=text)\n    regex_pattern = RegexPattern(pattern=pattern)\n    \n    service = FinderService()\n    match_result = service.find_literals(text_input, regex_pattern)\n    \n    if match_result:\n        return match_result.to_tuple()\n    return None\n\n```"}
{"task_id": "Mbpp/607", "solution": "```python\nimport re\n\nclass Text:\n    \"\"\"Represents the input text string.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\nclass RegexPattern:\n    \"\"\"Represents the regex pattern provided by the caller.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        self.pattern = pattern\n\nclass MatchResult:\n    \"\"\"Holds the result of a successful match, including substring and indices.\"\"\"\n    def __init__(self, substring: str, start_index: int, end_index: int) -> None:\n        self.substring = substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the match result as a tuple (substring, start_index, end_index).\"\"\"\n        return (self.substring, self.start_index, self.end_index)\n\nclass Finder:\n    \"\"\"Encapsulates the search logic to find the first/left-most regex match.\"\"\"\n    def find_literals(self, text: str, pattern: str) -> tuple | None:\n        \"\"\"Uses Python's re.search to find the first match in the text.\"\"\"\n        match = re.search(pattern, text)\n        if match:\n            substring = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            return MatchResult(substring, start_index, end_index).as_tuple()\n        else:\n            return None\n\ndef find_literals(text, pattern):\n    \"\"\"Public API per SRS: find_literals(text, pattern) -> (substring, start, end) or None.\n    This function delegates the search to the stateless Finder class.\"\"\"\n    return Finder().find_literals(text, pattern)\n```"}
{"task_id": "Mbpp/608", "solution": "To implement the software design specification, the following files will be created:\n\n**`src/bell_number.py`**\n```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass Input:\n    \"\"\"Lightweight container for input 'n'.\"\"\"\n    n: int\n\n@dataclass\nclass Output:\n    \"\"\"Lightweight container for the computed Bell number 'value'.\"\"\"\n    value: int\n\n@dataclass\nclass Error:\n    \"\"\"Conceptual error container, used for traceability in design.\"\"\"\n    message: str\n\nclass BellSequence:\n    \"\"\"\n    Helper class to compute Bell numbers using the Bell triangle algorithm.\n    It iteratively builds and stores rows of the Bell triangle.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the Bell sequence with the first row (B_0).\"\"\"\n        self._sequence: list[list[int]] = [[1]] # B_0 = 1\n\n    def get(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number, extending the triangle if necessary.\n        Returns the Bell number B_n from the first element of row n.\n        \"\"\"\n        while n >= len(self._sequence):\n            prev_row = self._sequence[-1]\n            new_row = [prev_row[-1]] # First element of new row\n            for j in range(len(prev_row)):\n                new_row.append(new_row[-1] + prev_row[j])\n            self._sequence.append(new_row)\n        return self._sequence[n][0]\n\n# Instantiate a global BellSequence calculator to reuse computed values.\n_bell_sequence_calculator = BellSequence()\n\ndef bell_Number(n) -> int:\n    \"\"\"\n    Computes the nth Bell number B_n.\n    Validates input and delegates computation to a BellSequence helper.\n    \"\"\"\n    # Raises TypeError if n is not an integer.\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    # Raises ValueError if n is a negative integer.\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Create Input dataclass instance for design traceability.\n    input_data = Input(n=n)\n    bell_n_value = _bell_sequence_calculator.get(input_data.n)\n    # Create Output dataclass instance for design traceability.\n    output_data = Output(value=bell_n_value)\n    return output_data.value\n\n```\n\n**`tests/test_bell_number.py`**\n```python\nfrom src.bell_number import bell_Number\n\ndef test_assert_bell_2():\n    \"\"\"\n    Acceptance test verifying the nth Bell number for n=2.\n    Asserts that bell_Number(2) correctly returns 2.\n    \"\"\"\n    assert bell_Number(2) == 2\n\n```"}
{"task_id": "Mbpp/608", "solution": "```python\n# bell_number.py\n# Module-level note: # Implementation for SRS: provides bell_Number(n) per FR1..FR5, NFRs require Python 3.\n\n__all__ = [\"bell_Number\"]\n\ndef validate_input(n) -> None:\n    \"\"\"Validate parameter n: must be int and n >= 0. Raises TypeError for non-int and ValueError for negative int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef compute_bell(n: int) -> int:\n    \"\"\"Compute and return the nth Bell number as Python int; deterministic dynamic programming algorithm.\"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize Bell triangle\n    # bell[i][j] stores B(i, j)\n    # The Bell number B_n is bell[n][0] (if first element of row is the number itself)\n    # or bell[n][n] (if B(n,k) is defined as partitions of {1,...,n} into k non-empty sets)\n    # The standard Bell triangle construction:\n    # b[i][0] = b[i-1][i-1]\n    # b[i][j] = b[i-1][j-1] + b[i][j-1]\n\n    bell_triangle = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    bell_triangle[0][0] = 1 # B(0) = 1\n\n    for i in range(1, n + 1):\n        # The first element of each row is the Bell number for that index (B_i)\n        # It is equal to the last element of the previous row.\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element above it and the element to its left.\n            bell_triangle[i][j] = bell_triangle[i-1][j-1] + bell_triangle[i][j-1]\n            \n    return bell_triangle[n][0]\n\ndef bell_Number(n: int) -> int:\n    \"\"\"Public API: validate input and return nth Bell number. Raises ValueError for negative integers.\"\"\"\n    validate_input(n)\n    return compute_bell(n)\n\n```\n```python\n# test_bell_number.py\n\nfrom bell_number import bell_Number\n\ndef _assert_equal(actual, expected, message: str = None) -> None:\n    \"\"\"Test helper to assert equality; raises AssertionError on mismatch.\"\"\"\n    if actual != expected:\n        fail_message = f\"Assertion failed: Expected {expected}, got {actual}.\"\n        if message:\n            fail_message = f\"{message} {fail_message}\"\n        raise AssertionError(fail_message)\n    print(f\"PASS: Expected {expected}, Got {actual} ({message if message else 'Assertion ok'})\")\n\n\ndef _assert_raises(exc_type: type, callable_obj, *args, **kwargs) -> None:\n    \"\"\"Test helper asserting that a callable raises the given exception.\"\"\"\n    try:\n        callable_obj(*args, **kwargs)\n        raise AssertionError(f\"Assertion failed: Expected {exc_type.__name__} but no exception was raised.\")\n    except exc_type as e:\n        print(f\"PASS: Expected {exc_type.__name__} was raised. ({callable_obj.__name__}{args}, {kwargs})\")\n    except Exception as e:\n        raise AssertionError(f\"Assertion failed: Expected {exc_type.__name__} but got {type(e).__name__}.\")\n\ndef run_tests() -> None:\n    \"\"\"Runs tests including assert bell_Number(2) == 2, negative input test to assert ValueError, and possibly other acceptance checks (e.g., base cases).\"\"\"\n    print(\"Running Bell Number tests...\")\n\n    # FR5: Required unit test\n    _assert_equal(bell_Number(2), 2, \"FR5: bell_Number(2) == 2\")\n\n    # FR3: Base cases and standard indexing\n    _assert_equal(bell_Number(0), 1, \"FR3: bell_Number(0) == 1\")\n    _assert_equal(bell_Number(1), 1, \"FR3: bell_Number(1) == 1\")\n\n    # Additional acceptance tests\n    _assert_equal(bell_Number(3), 5, \"Acceptance: bell_Number(3) == 5\")\n    _assert_equal(bell_Number(4), 15, \"Acceptance: bell_Number(4) == 15\")\n    _assert_equal(bell_Number(5), 52, \"Acceptance: bell_Number(5) == 52\")\n    _assert_equal(bell_Number(6), 203, \"Acceptance: bell_Number(6) == 203\")\n\n    # FR4: Input validation tests\n    _assert_raises(ValueError, bell_Number, -1)\n    _assert_raises(ValueError, bell_Number, -100)\n    \n    _assert_raises(TypeError, bell_Number, 1.5)\n    _assert_raises(TypeError, bell_Number, \"abc\")\n    _assert_raises(TypeError, bell_Number, None)\n    _assert_raises(TypeError, bell_Number, [1])\n\n    print(\"\\nAll Bell Number tests passed successfully!\")\n\nif __name__ == \"__main__\":\n    run_tests()\n\n```"}
{"task_id": "Mbpp/610", "solution": "```python\nclass IndexK:\n    \"\"\"\n    Value object representing a 1-based index.\n    Provides validation for its range against a given list length.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid(self, length: int) -> bool:\n        \"\"\"\n        Checks if the 1-based index is within the valid range [1, length].\n        \"\"\"\n        return 1 <= self.value <= length\n\nclass ValidationResult:\n    \"\"\"\n    DTO to capture a validation outcome and an optional message.\n    \"\"\"\n    def __init__(self, is_valid: bool, message: str = \"\"):\n        self.is_valid = is_valid\n        self.message = message\n\nclass ExampleTest:\n    \"\"\"\n    Encapsulates the provided example test case.\n    Can run the test and compare the result.\n    \"\"\"\n    def __init__(self, input_list: list, k: int, expected: list):\n        self.input = input_list\n        self.k = k\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the remove_kth_element function with the stored inputs\n        and compares the result to the expected output.\n        \"\"\"\n        try:\n            result = remove_kth_element(self.input, self.k)\n            return result == self.expected\n        except Exception:\n            return False\n\ndef remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Removes the k'th element (1-based index) from a list, returning a new list.\n    Performs type and index range validation, raising TypeError or IndexError.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a Python list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    index_k_obj = IndexK(k)\n    if not index_k_obj.is_valid(len(input_list)):\n        raise IndexError(f\"k ({k}) is out of 1-based range for list of length {len(input_list)}.\")\n\n    # Construct the new list using slicing without mutating the original.\n    # k is 1-based, so Python's 0-based index for the element to remove is k-1.\n    return input_list[:k-1] + input_list[k:]\n```"}
{"task_id": "Mbpp/611", "solution": "def _extract_column(matrix, n):\n    \"\"\"Extracts values from the n-th column of the matrix.\n    Assumes matrix is a list of lists and n is a valid index for all rows.\n    \"\"\"\n    return [row[n] for row in matrix]\n\ndef max_of_nth(matrix, n):\n    \"\"\"Return maximum numeric value from n-th column in matrix.\n    Trusts the caller's inputs and performs no validation.\n    \"\"\"\n    column_values = _extract_column(matrix, n)\n    return max(column_values)"}
{"task_id": "Mbpp/610", "solution": "```python\n# src/remove_kth_element.py\n\n\"\"\"\nImplements remove_kth_element(lst, k) and ValidationError as per design specification.\nThis module provides functionality to remove the k-th element from a list with validation.\n\"\"\"\n\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception class for signaling invalid 'k' input parameters.\n    It inherits from Python's base Exception class.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef remove_kth_element(lst: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the element at the zero-based index 'k' removed.\n    Input 'k' is validated to be an integer and within the list's bounds.\n    \"\"\"\n    # Validate 'k' is an integer, raising ValidationError if not (FR6).\n    if not isinstance(k, int):\n        raise ValidationError('k must be an integer')\n\n    # Validate 'k' is within the valid zero-based range [0, len(lst)-1] (FR6).\n    if not (0 <= k < len(lst)):\n        raise ValidationError('k out of range')\n\n    # Create and return a new list by concatenating slices before and after index 'k'.\n    # This ensures non-mutation of the original list and order preservation (FR3, FR4).\n    return lst[:k] + lst[k+1:]\n```"}
