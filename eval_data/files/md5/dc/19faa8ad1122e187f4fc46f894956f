{"task_id": "Mbpp/426", "solution": "```python\nfrom typing import List\n\ndef filter_oddnumbers(input_list: List[int]) -> List[int]:\n    \"\"\"Return a list of odd integers from input_list, preserving relative order.\"\"\"\n    # This function adheres to O(N) time and O(M) space complexity, where M is the number of odd items.\n    output_list = []\n    for number in input_list:\n        if number % 2 != 0:\n            output_list.append(number)\n    return output_list\n```"}
{"task_id": "Mbpp/427", "solution": "```python\n# src/models.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass DateString:\n    \"\"\"Holds a raw date string.\"\"\"\n    raw: str\n\n@dataclass\nclass ParsedDate:\n    \"\"\"Holds parsed numeric components of a date.\"\"\"\n    year: int\n    month: int\n    day: int\n```\n```python\n# src/validator.py\nimport re\n\n# Compiled regex constant for yyyy-mm-dd format validation.\nDATE_FORMAT_REGEX = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\nclass Validator:\n    \"\"\"Validates date string format.\"\"\"\n\n    def is_valid_format(self, input_string: str) -> bool:\n        \"\"\"Returns True if the input matches yyyy-mm-dd format, otherwise False.\"\"\"\n        return bool(DATE_FORMAT_REGEX.match(input_string))\n\n```\n```python\n# src/date_converter.py\nfrom .validator import Validator\nfrom .models import ParsedDate\n\nclass DateConverter:\n    \"\"\"Converts date strings from yyyy-mm-dd to dd-mm-yyyy.\"\"\"\n\n    def change_date_format(self, input: str) -> str:\n        \"\"\"Validates, parses, and formats the date string.\n        Raises ValueError if the input format is invalid.\"\"\"\n        validator = Validator()\n        if not validator.is_valid_format(input):\n            raise ValueError(\"Input does not match required format yyyy-mm-dd\")\n\n        parsed = self._parse_input(input)\n        # Format day and month with leading zeros, year with four digits.\n        return f\"{parsed.day:02d}-{parsed.month:02d}-{parsed.year:04d}\"\n\n    def _parse_input(self, raw_date: str) -> ParsedDate:\n        \"\"\"Parses a yyyy-mm-dd string into its year, month, and day components.\"\"\"\n        year = int(raw_date[0:4])\n        month = int(raw_date[5:7])\n        day = int(raw_date[8:10])\n        return ParsedDate(year=year, month=month, day=day)\n\n```\n```python\n# src/change_date_format.py\nfrom .date_converter import DateConverter\n\ndef change_date_format(input: str) -> str:\n    \"\"\"Converts a date string from \"yyyy-mm-dd\" to \"dd-mm-yyyy\" format.\n    Validates input format and preserves leading zeros.\"\"\"\n    converter = DateConverter()\n    return converter.change_date_format(input)\n\n```\n```python\n# src/__init__.py\n# Package initialization file.\n```"}
