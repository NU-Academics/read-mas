{"task_id": "Mbpp/749", "solution": "```python\nfrom typing import List\n\n# Helper function to sort a list of integers in ascending order.\ndef sort_ascending(nums: List[int]) -> List[int]:\n    return sorted(nums)\n\n# Helper function to parse a string to an integer.\ndef parse_to_int(s: str) -> int:\n    return int(s)\n\n# Helper function for input validation.\n# Per CRITICAL REQUIREMENTS, it performs no checks and raises no exceptions.\ndef validate_input(input_list: List[str]) -> bool:\n    return True\n\ndef sort_numeric_strings(input_list: List[str]) -> List[int]:\n    \"\"\"\n    Sorts a list of numeric strings numerically in ascending order.\n    The function does not modify the original input list.\n    \"\"\"\n    validate_input(input_list)\n    parsed = [parse_to_int(s) for s in input_list]\n    return sort_ascending(parsed)\n```"}
{"task_id": "Mbpp/748", "solution": "```python\n# src/domain.py\n\nfrom typing import List\n\nclass InputString:\n    \"\"\"Represents the input string and its length.\n    Encapsulates input data and its length.\n    \"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n        self._length = len(value)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the raw string value.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return self._length\n\nclass OutputString:\n    \"\"\"Represents the output string and its length.\n    Encapsulates output data for the result.\n    \"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n        self._length = len(value)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the raw string value.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return self._length\n\nclass Character:\n    \"\"\"Represents a single character and provides case analysis.\n    Offers methods to check if the character is uppercase or lowercase.\n    \"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value # Assumed to be a single character\n\n    def isUpper(self) -> bool:\n        \"\"\"Checks if the character is uppercase.\"\"\"\n        return self._value.isupper()\n\n    def isLower(self) -> bool:\n        \"\"\"Checks if the character is lowercase.\"\"\"\n        return self._value.islower()\n\n    def get_value(self) -> str:\n        \"\"\"Returns the character's value.\"\"\"\n        return self._value\n\n```\n```python\n# src/capital_words_spaces.py\n\nfrom typing import List\nfrom src.domain import InputString, OutputString, Character\n\ndef capital_words_spaces(string: str) -> str:\n    \"\"\"Inserts spaces before uppercase letters that follow lowercase letters.\n    It preserves existing whitespace and non-letter characters.\n    \"\"\"\n    input_obj = InputString(string)\n    input_value = input_obj.get_value()\n    output_chars: List[str] = []\n\n    if not input_value:\n        return \"\"\n\n    output_chars.append(input_value[0]) # Always add the first character\n\n    for i in range(1, input_obj.get_length()):\n        current_char_obj = Character(input_value[i])\n        previous_char_obj = Character(input_value[i-1])\n\n        # BR6: per-character scan, insert space if prev is lower, current is upper, and not at first char (i > 0)\n        if previous_char_obj.isLower() and current_char_obj.isUpper():\n            output_chars.append(' ')\n        \n        output_chars.append(current_char_obj.get_value())\n    \n    final_output_value = \"\".join(output_chars)\n    output_obj = OutputString(final_output_value)\n    return output_obj.get_value()\n\n```\n```python\n# examples/usage.py\n\nfrom src.capital_words_spaces import capital_words_spaces\n\ndef example_usage():\n    \"\"\"Demonstrates usage of the capital_words_spaces function.\n    Reproduces SRS example assertions.\n    \"\"\"\n    print(\"--- Example Usage of capital_words_spaces ---\")\n\n    # SRS verification examples / acceptance criteria\n    print(f\"capital_words_spaces('Python') == '{capital_words_spaces('Python')}' (Expected: 'Python')\")\n    assert capital_words_spaces(\"Python\") == 'Python'\n\n    print(f\"capital_words_spaces('thisIsATest') == '{capital_words_spaces('thisIsATest')}' (Expected: 'this Is A Test')\")\n    assert capital_words_spaces(\"thisIsATest\") == 'this Is A Test'\n\n    print(f\"capital_words_spaces('HelloWorld') == '{capital_words_spaces('HelloWorld')}' (Expected: 'Hello World')\")\n    assert capital_words_spaces(\"HelloWorld\") == 'Hello World'\n    \n    print(f\"capital_words_spaces('helloWorld_test') == '{capital_words_spaces('helloWorld_test')}' (Expected: 'hello World_test')\")\n    assert capital_words_spaces(\"helloWorld_test\") == 'hello World_test'\n    print(f\"capital_words_spaces('APIResponseCode') == '{capital_words_spaces('APIResponseCode')}' (Expected: 'API Response Code')\")\n    assert capital_words_spaces(\"APIResponseCode\") == \"API Response Code\"\n\n    print(f\"capital_words_spaces('XMLParser') == '{capital_words_spaces('XMLParser')}' (Expected: 'XML Parser')\")\n    assert capital_words_spaces(\"XMLParser\") == 'XML Parser'\n    \n    # Additional cases\n    print(f\"capital_words_spaces('') == '{capital_words_spaces('')}' (Expected: '')\")\n    assert capital_words_spaces(\"\") == \"\"\n    print(f\"capital_words_spaces('lowercase') == '{capital_words_spaces('lowercase')}' (Expected: 'lowercase')\")\n    assert capital_words_spaces(\"lowercase\") == \"lowercase\"\n    print(f\"capital_words_spaces('UPPERCASE') == '{capital_words_spaces('UPPERCASE')}' (Expected: 'UPPERCASE')\")\n    assert capital_words_spaces(\"UPPERCASE\") == \"UPPERCASE\"\n    print(f\"capital_words_spaces('Already Spaced') == '{capital_words_spaces('Already Spaced')}' (Expected: 'Already Spaced')\")\n    assert capital_words_spaces(\"Already Spaced\") == \"Already Spaced\"\n    print(f\"capital_words_spaces('wordWith1Number') == '{capital_words_spaces('wordWith1Number')}' (Expected: 'word With1 Number')\")\n    assert capital_words_spaces(\"wordWith1Number\") == \"word With1 Number\"\n\n    print(\"\\nAll example assertions passed!\")\n\nif __name__ == \"__main__\":\n    example_usage()\n\n```"}
{"task_id": "Mbpp/750", "solution": "\"\"\"Implements add_tuple as specified in SRS.\"\"\"\n\ndef add_tuple(input_list, input_tuple) -> list:\n    \"\"\"Return a list equal to input_list with elements of input_tuple appended in order.\n\n    Args:\n        input_list: An ordered sequence of elements.\n        input_tuple: An ordered sequence of elements.\n\n    Returns:\n        A new list containing the concatenation of input_list and input_tuple elements in order.\n    \"\"\"\n    result = list(input_list)\n    for e in input_tuple:\n        result.append(e)\n    return result"}
{"task_id": "Mbpp/748", "solution": "```python\n# Helper predicates for character classification.\ndef _is_uppercase(ch: str) -> bool:\n    \"\"\"Checks if a character is an uppercase letter.\n    Uses Python's built-in string method for character case.\"\"\"\n    return ch.isupper()\n\ndef _is_lowercase(ch: str) -> bool:\n    \"\"\"Checks if a character is a lowercase letter.\n    Uses Python's built-in string method for character case.\"\"\"\n    return ch.islower()\n\ndef _is_digit(ch: str) -> bool:\n    \"\"\"Checks if a character is a digit.\n    Uses Python's built-in string method for digit classification.\"\"\"\n    return ch.isdigit()\n\n# Domain wrapper for input string.\nclass InputString:\n    \"\"\"Wraps an input string, providing its value and length.\n    This class serves as a domain model for the input data.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\n        It provides an abstraction over the raw string length.\"\"\"\n        return len(self.value)\n\n# Domain wrapper for output string.\nclass OutputString:\n    \"\"\"Wraps an output string, providing its value and length.\n    This class encapsulates the result of the transformation.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\n        It provides an abstraction over the raw string length.\"\"\"\n        return len(self.value)\n\n# DTO for internal validation results.\nclass ValidationResult:\n    \"\"\"Stores internal validation results, including emptiness and insertion count.\n    This DTO helps CapitalWordsSpacesFunction decide on the final return value.\"\"\"\n    def __init__(self, is_empty: bool = False, insertions_made: int = 0):\n        self.is_empty = is_empty\n        self.insertions_made = insertions_made\n\n# Algorithm class encapsulating the core processing logic.\nclass CapitalWordsSpacesFunction:\n    \"\"\"Scans an InputString and constructs an OutputString by inserting spaces.\n    It implements the core logic for the specified string transformation.\"\"\"\n    def process(self, input_value: InputString) -> OutputString:\n        \"\"\"Processes the input string to insert spaces based on design rules.\n        It iterates through the input to build the transformed output.\"\"\"\n        input_str = input_value.value\n        input_len = input_value.length()\n        result_buffer = []\n        insertions_count = 0\n\n        if input_len == 0:\n            return OutputString(\"\")\n\n        for i in range(input_len):\n            current_char = input_str[i]\n            # Check for insertion condition only for characters beyond the first.\n            if i > 0:\n                previous_char = input_str[i-1]\n                # Insert space if current char is uppercase and previous is lowercase or digit.\n                if _is_uppercase(current_char) and (_is_lowercase(previous_char) or _is_digit(previous_char)):\n                    result_buffer.append(' ')\n                    insertions_count += 1\n            result_buffer.append(current_char)\n\n        # Validate results to decide if the original input or modified string should be returned.\n        validation_result = ValidationResult(is_empty=False, insertions_made=insertions_count)\n\n        # Per requirement: \"Return input unchanged when no insertions are required.\"\n        if validation_result.insertions_made == 0:\n            return OutputString(input_str)\n        else:\n            return OutputString(\"\".join(result_buffer))\n\n# Public API function.\ndef capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before uppercase letters preceded by a lowercase letter or digit.\n    This function acts as the public entry point, delegating to CapitalWordsSpacesFunction.\n    \"\"\"\n    input_obj = InputString(value=input_string)\n    algo = CapitalWordsSpacesFunction()\n    output_obj = algo.process(input_obj)\n    return output_obj.value\n```"}
{"task_id": "Mbpp/749", "solution": "```python\n# src/__init__.py\nfrom .sort_numeric_strings import sort_numeric_strings\n```\n```python\n# src/sort_numeric_strings.py\nfrom typing import List\n\nclass StringNumber:\n    \"\"\"Wraps a string value and provides a method to convert it to an integer.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def to_integer(self) -> int:\n        \"\"\"Converts the wrapped string value to an integer using Python's int().\"\"\"\n        return int(self.value)\n\nclass IntegerNumber:\n    \"\"\"Wraps an integer value as a simple domain-aligned value object.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass SortedList:\n    \"\"\"A value object to encapsulate a list of sorted integers.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\ndef sort_numeric_strings(input_list: List[str]) -> List[int]:\n    \"\"\"Convert a list of strings (each representing an integer) to integers,\n    sort them in ascending numerical order, and return the result as a list of ints.\n    \"\"\"\n    converted_ints: List[int] = []\n    for s_num_str in input_list:\n        string_number_vo = StringNumber(s_num_str)\n        int_value = string_number_vo.to_integer()\n        _ = IntegerNumber(int_value) # IntegerNumber VO created per design, value extracted.\n        converted_ints.append(int_value)\n\n    converted_ints.sort() # Sorts the list of integers in ascending numerical order.\n    \n    sorted_list_vo = SortedList(converted_ints)\n    return sorted_list_vo.values\n```\n```python\n# tests/test_sort_numeric_strings.py\nfrom src.sort_numeric_strings import sort_numeric_strings\n\ndef test_example_assertion() -> None:\n    \"\"\"Tests the sort_numeric_strings function using the canonical assertion from the SRS.\"\"\"\n    assert sort_numeric_strings(['4','12','45','7','0','100','200','-12','-500']) == [-500, -12, 0, 4, 7, 12, 45, 100, 200]\n```"}
{"task_id": "Mbpp/751", "solution": "```python\n# src/min_heap_checker.py\n\nfrom typing import Any, List, TypeVar\n\n# Define a TypeVar for comparable elements, though not strictly enforced by Python's type system\n# it clarifies intent that elements should support comparison.\nComparable = TypeVar('Comparable', bound=Any)\n\nclass Array:\n    \"\"\"\n    Encapsulates a Python list, providing length and indexed access.\n    Acts as a wrapper for the input array.\n    \"\"\"\n    def __init__(self, elements: List[Comparable]) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the encapsulated list.\"\"\"\n        return len(self._elements)\n\n    def get(self, i: int) -> Comparable:\n        \"\"\"\n        Retrieves an element by its index.\n        Raises IndexError if the index is out of bounds.\n        \"\"\"\n        return self._elements[i]\n\nclass MinHeapProperty:\n    \"\"\"\n    Provides static methods for heap index arithmetic and element comparison.\n    Handles calculating child indices and comparing parent-child values.\n    \"\"\"\n    @staticmethod\n    def parent_index(i: int) -> int:\n        \"\"\"Calculates the parent index for a given child index.\"\"\"\n        return (i - 1) // 2\n\n    @staticmethod\n    def left_child_index(i: int) -> int:\n        \"\"\"Calculates the left child index for a given parent index.\"\"\"\n        return 2 * i + 1\n\n    @staticmethod\n    def right_child_index(i: int) -> int:\n        \"\"\"Calculates the right child index for a given parent index.\"\"\"\n        return 2 * i + 2\n\n    @staticmethod\n    def compare(parent: Comparable, child: Comparable) -> bool:\n        \"\"\"\n        Compares parent and child elements to check the min-heap property.\n        Raises TypeError if elements are not comparable.\n        \"\"\"\n        return parent <= child\n\nclass HeapChecker:\n    \"\"\"\n    Implements the core algorithm to verify the min-heap property.\n    It iterates through parent nodes and checks their children.\n    \"\"\"\n    def check_min_heap(self, arr_wrapper: Array) -> bool:\n        \"\"\"\n        Verifies if the given array (wrapped) satisfies the min-heap property.\n        Returns True if it's a min-heap, False otherwise.\n        \"\"\"\n        n = arr_wrapper.length()\n\n        # Empty and single-element arrays are valid min-heaps.\n        if n <= 1:\n            return True\n\n        # Iterate only through potential parent nodes.\n        # The last parent with at least one child is at index floor((n-2)/2).\n        for i in range(n // 2 - 1, -1, -1): # Optimized loop from bottom-up last parent.\n        # The design specified loop for i from 0 to floor((n-2)/2), which is also valid.\n        # Let's stick to the design's specified loop direction (top-down) for clarity.\n        # for i in range(0, (n - 2) // 2 + 1):\n        # A more robust upper bound for parent iteration is to check as long as left child exists.\n        # Iterate from the first parent (index 0) up to the last parent that could have children.\n        # The last parent index is (n // 2) - 1.\n        for i in range(n // 2): # This correctly covers all parents that could have children.\n            parent_val = arr_wrapper.get(i)\n\n            left_child_idx = MinHeapProperty.left_child_index(i)\n            right_child_idx = MinHeapProperty.right_child_index(i)\n\n            # Check left child if it exists.\n            if left_child_idx < n:\n                left_child_val = arr_wrapper.get(left_child_idx)\n                if not MinHeapProperty.compare(parent_val, left_child_val):\n                    return False\n\n            # Check right child if it exists.\n            if right_child_idx < n:\n                right_child_val = arr_wrapper.get(right_child_idx)\n                if not MinHeapProperty.compare(parent_val, right_child_val):\n                    return False\n        \n        return True\n\ndef check_min_heap(arr: List[Comparable]) -> bool:\n    \"\"\"\n    Checks if a given list of comparable elements represents a min-heap.\n    Delegates the verification to internal domain objects.\n    \"\"\"\n    array_wrapper = Array(arr)\n    heap_checker = HeapChecker()\n    return heap_checker.check_min_heap(array_wrapper)\n\n# src/__init__.py content would be:\n# from .min_heap_checker import check_min_heap\n# __all__ = [\"check_min_heap\"]\n```"}
{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap according to 0-based indexing rules.\n    It iterates parent indices up to floor((n-2)/2) and verifies the min-heap property.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate through parent indices from 0 up to floor((n-2)/2).\n    # The range function's end is exclusive, so add 1 to include the floor((n-2)/2) index.\n    for i in range((n - 2) // 2 + 1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # If left child exists, check if parent is less than or equal to left child.\n        if left_child_idx < n:\n            if array[i] > array[left_child_idx]:\n                return False\n\n        # If right child exists, check if parent is less than or equal to right child.\n        if right_child_idx < n:\n            if array[i] > array[right_child_idx]:\n                return False\n    \n    return True\n```"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"Returns k records with smallest numeric second elements, sorted ascending.\n    Handles k <= 0 and k >= len(records) by design specification.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    # Sort the records stably by their second element (numeric value).\n    sorted_records = sorted(records, key=lambda x: x[1])\n\n    if k >= len(sorted_records):\n        return sorted_records\n    else:\n        # Return the first k elements from the sorted list.\n        return sorted_records[:k]"}
{"task_id": "Mbpp/752", "solution": "```python\n# src/jacobsthal.py\n\ndef validate(n: int) -> bool:\n    \"\"\"\n    Validates if n is a non-negative integer.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    return isinstance(n, int) and n >= 0\n\ndef compute(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number using an iterative loop.\n    Handles base cases J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    return j_n_minus_1\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Public API to get the nth Jacobsthal number.\n    Validates input and computes the number, raising ValueError for invalid input.\n    \"\"\"\n    if not validate(n):\n        raise ValueError(\"n must be a non-negative integer\")\n    return compute(n)\n\n```\n```python\n# tests/test_jacobsthal.py\n\nimport pytest\nfrom src.jacobsthal import jacobsthal_num\n\ndef test_base_cases():\n    \"\"\"\n    Verifies the Jacobsthal base cases for n=0 and n=1.\n    Ensures J(0) is 0 and J(1) is 1.\n    \"\"\"\n    assert jacobsthal_num(0) == 0\n    assert jacobsthal_num(1) == 1\n\ndef test_recurrence_case():\n    \"\"\"\n    Verifies Jacobsthal numbers for n >= 2 using the recurrence and specific examples.\n    Checks values like J(2)=1, J(3)=3, J(5)=11, and J(6)=21.\n    \"\"\"\n    assert jacobsthal_num(2) == 1\n    assert jacobsthal_num(3) == 3\n    assert jacobsthal_num(4) == 5\n    assert jacobsthal_num(5) == 11\n    assert jacobsthal_num(6) == 21\n    assert jacobsthal_num(7) == 43\n    assert jacobsthal_num(8) == 85\n\ndef test_negative_input():\n    \"\"\"\n    Confirms that calling jacobsthal_num with a negative n raises a ValueError.\n    Checks the exact error message as specified.\n    \"\"\"\n    with pytest.raises(ValueError, match=\"n must be a non-negative integer\"):\n        jacobsthal_num(-1)\n    with pytest.raises(ValueError, match=\"n must be a non-negative integer\"):\n        jacobsthal_num(-5)\n\nif __name__ == \"__main__\":\n    pytest.main([__file__])\n\n```"}
{"task_id": "Mbpp/754", "solution": "```python\nfrom typing import Sequence, Any, List\n\ndef extract_index_list(l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> List[Any]:\n    \"\"\"Return a list containing elements where l1[i] == l2[i] == l3[i] for i in 0..min_len-1.\"\"\"\n    result = []\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n            \n    return result\n```"}
{"task_id": "Mbpp/753", "solution": "```python\n# src/domain.py\n\nclass TupleRecord:\n    def __init__(self, identifier: str, value: float) -> None:\n        \"\"\"Data-holder for a single (identifier, numeric_value) tuple.\"\"\"\n        self.identifier = identifier\n        self.value = value\n\n    def __eq__(self, other):\n        if not isinstance(other, TupleRecord):\n            return NotImplemented\n        return self.identifier == other.identifier and self.value == other.value\n\n    def __repr__(self):\n        return f\"TupleRecord(identifier='{self.identifier}', value={self.value})\"\n\nclass TupleList:\n    def __init__(self, items: list) -> None:\n        \"\"\"Data-holder for an ordered collection of TupleRecord.\"\"\"\n        self.items = items\n\n    @classmethod\n    def from_raw_list(cls, raw: list[tuple]) -> \"TupleList\":\n        \"\"\"Converts a raw list of tuples into a TupleList of TupleRecord objects.\"\"\"\n        return cls([TupleRecord(item[0], item[1]) for item in raw])\n\n    def __eq__(self, other):\n        if not isinstance(other, TupleList):\n            return NotImplemented\n        return self.items == other.items\n\n    def __repr__(self):\n        return f\"TupleList(items={self.items})\"\n\n```\n```python\n# src/min_k_service.py\nimport copy\n\nclass MinKService:\n    def min_k(self, tupleList: list[tuple], k: int) -> list[tuple]:\n        \"\"\"Encapsulates selection and sorting logic for k smallest tuples by numeric value.\"\"\"\n        # Operates on a shallow copy of the input list to ensure non-destructive behavior.\n        copied_list = copy.copy(tupleList)\n\n        # Sort the copied list based on the second element (numeric value) in ascending order.\n        sorted_list = sorted(copied_list, key=lambda x: x[1])\n\n        # Return the first k elements, which are the smallest by numeric value.\n        return sorted_list[:k]\n\n```\n```python\n# src/min_k.py\nfrom src.min_k_service import MinKService\n\ndef min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"Public API: returns k smallest tuples by numeric value (tuple[1]); non-destructive.\"\"\"\n    if k == 0:\n        return []\n    else:\n        # Delegate to MinKService for the core selection and sorting logic.\n        return MinKService().min_k(tuple_list, k)\n\n```\n```python\n# tests/test_min_k.py\nfrom src.min_k import min_k\n\ndef test_min_k_example():\n    \"\"\"Unit test containing the exact assertion required by SRS.\"\"\"\n    assert min_k([('Manjeet', 10), ('Akshat', 4), ('Akash', 2), ('Nikhil', 8)], 2) == [('Akash', 2), ('Akshat', 4)]\n\n```"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements common to three lists at the same index.\n    Returns a list of such values, preserving order and duplicates.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/752", "solution": "```cpp\n// include/jacobsthal/InvalidInputError.h\n#ifndef JACOBSTHAL_INVALIDINPUTERROR_H\n#define JACOBSTHAL_INVALIDINPUTERROR_H\n\n#include <stdexcept>\n#include <string>\n\nnamespace jacobsthal {\n\n/**\n * @brief Exception type for invalid input errors.\n *\n * Carries a message and a specific error code.\n */\nclass InvalidInputError : public std::exception {\npublic:\n    /**\n     * @brief Constructs an InvalidInputError exception.\n     * @param message A descriptive error message.\n     * @param code An error code identifying the type of error.\n     */\n    InvalidInputError(const std::string &message, const std::string &code);\n\n    /**\n     * @brief Returns a C-style character string describing the general cause of the current error.\n     * @return A C-style string with the error message.\n     */\n    const char* what() const noexcept override;\n\n    /**\n     * @brief Returns the error code.\n     * @return The error code as a string.\n     */\n    std::string getCode() const;\n\nprivate:\n    std::string message_; ///< The error message.\n    std::string code_;    ///< The error code.\n};\n\n} // namespace jacobsthal\n\n#endif // JACOBSTHAL_INVALIDINPUTERROR_H\n```\n\n```cpp\n// src/InvalidInputError.cpp\n#include \"jacobsthal/InvalidInputError.h\"\n\nnamespace jacobsthal {\n\nInvalidInputError::InvalidInputError(const std::string &message, const std::string &code)\n    : message_(message), code_(code) {}\n\nconst char* InvalidInputError::what() const noexcept {\n    return message_.c_str();\n}\n\nstd::string InvalidInputError::getCode() const {\n    return code_;\n}\n\n} // namespace jacobsthal\n```\n\n```cpp\n// include/jacobsthal/JacobsthalNumber.h\n#ifndef JACOBSTHAL_JACOBSTHALNUMBER_H\n#define JACOBSTHAL_JACOBSTHALNUMBER_H\n\nnamespace jacobsthal {\n\n/**\n * @brief Value object representing a Jacobsthal number at a specific index.\n */\nclass JacobsthalNumber {\npublic:\n    /**\n     * @brief Constructs a JacobsthalNumber.\n     * @param index The index (n) of the Jacobsthal number.\n     * @param value The value J_n of the Jacobsthal number.\n     */\n    JacobsthalNumber(int index, int value);\n\n    /**\n     * @brief Returns the index of the Jacobsthal number.\n     * @return The index.\n     */\n    int getIndex() const;\n\n    /**\n     * @brief Returns the value of the Jacobsthal number.\n     * @return The value.\n     */\n    int getValue() const;\n\nprivate:\n    int index_; ///< The index of the Jacobsthal number.\n    int value_; ///< The value of the Jacobsthal number.\n};\n\n} // namespace jacobsthal\n\n#endif // JACOBSTHAL_JACOBSTHALNUMBER_H\n```\n\n```cpp\n// src/JacobsthalNumber.cpp\n#include \"jacobsthal/JacobsthalNumber.h\"\n\nnamespace jacobsthal {\n\nJacobsthalNumber::JacobsthalNumber(int index, int value)\n    : index_(index), value_(value) {}\n\nint JacobsthalNumber::getIndex() const {\n    return index_;\n}\n\nint JacobsthalNumber::getValue() const {\n    return value_;\n}\n\n} // namespace jacobsthal\n```\n\n```cpp\n// include/jacobsthal/InputValidator.h\n#ifndef JACOBSTHAL_INPUTVALIDATOR_H\n#define JACOBSTHAL_INPUTVALIDATOR_H\n\n#include <any>\n#include \"jacobsthal/InvalidInputError.h\"\n\nnamespace jacobsthal {\n\n/**\n * @brief Utility class for validating input parameters.\n */\nclass InputValidator {\npublic:\n    /**\n     * @brief Validates if the given input is a non-negative integer.\n     *\n     * Throws an InvalidInputError if the input is not an integer or is negative.\n     * @param n The input to validate, expected to hold an int.\n     */\n    static void validateNonNegativeInteger(std::any n);\n};\n\n} // namespace jacobsthal\n\n#endif // JACOBSTHAL_INPUTVALIDATOR_H\n```\n\n```cpp\n// src/InputValidator.cpp\n#include \"jacobsthal/InputValidator.h\"\n#include <string>\n\nnamespace jacobsthal {\n\nvoid InputValidator::validateNonNegativeInteger(std::any n) {\n    if (!n.has_value()) {\n        throw InvalidInputError(\"Input value is empty.\", \"EMPTY_INPUT\");\n    }\n\n    if (n.type() != typeid(int)) {\n        throw InvalidInputError(\"Input must be an integer.\", \"NON_INTEGER_INPUT\");\n    }\n\n    int value = std::any_cast<int>(n);\n    if (value < 0) {\n        throw InvalidInputError(\"Input must be a non-negative integer.\", \"NEGATIVE_INPUT\");\n    }\n}\n\n} // namespace jacobsthal\n```\n\n```cpp\n// include/jacobsthal/JacobsthalCalculator.h\n#ifndef JACOBSTHAL_JACOBSTHALCALCULATOR_H\n#define JACOBSTHAL_JACOBSTHALCALCULATOR_H\n\n#include \"jacobsthal/InputValidator.h\"\n#include \"jacobsthal/JacobsthalNumber.h\"\n\nnamespace jacobsthal {\n\n/**\n * @brief Calculates Jacobsthal numbers using an iterative O(n) algorithm.\n */\nclass JacobsthalCalculator {\npublic:\n    /**\n     * @brief Computes the nth Jacobsthal number.\n     *\n     * Validates input and uses an iterative algorithm for computation.\n     * @param n The index of the Jacobsthal number to compute.\n     * @return The nth Jacobsthal number.\n     * @throws InvalidInputError If n is negative.\n     */\n    int jacobsthal_num(int n);\n\nprivate:\n    /**\n     * @brief Implements the iterative computation of J_n.\n     * @param n The non-negative index for which to compute the Jacobsthal number.\n     * @return The nth Jacobsthal number.\n     */\n    int computeIterative(int n);\n};\n\n} // namespace jacobsthal\n\n#endif // JACOBSTHAL_JACOBSTHALCALCULATOR_H\n```\n\n```cpp\n// src/JacobsthalCalculator.cpp\n#include \"jacobsthal/JacobsthalCalculator.h\"\n#include <stdexcept> // For std::any_cast errors, though we check type first\n\nnamespace jacobsthal {\n\nint JacobsthalCalculator::jacobsthal_num(int n) {\n    // Validate input using the InputValidator\n    InputValidator::validateNonNegativeInteger(std::any(n));\n\n    // Compute the number\n    int result = computeIterative(n);\n\n    // Create JacobsthalNumber value object (as per design, though not returned directly)\n    JacobsthalNumber jn(n, result); \n    // The value object itself is not returned, just its computed value.\n\n    return result;\n}\n\nint JacobsthalCalculator::computeIterative(int n) {\n    if (n == 0) {\n        return 0;\n    }\n    if (n == 1) {\n        return 1;\n    }\n\n    int j_prev2 = 0; // J_{i-2}\n    int j_prev1 = 1; // J_{i-1}\n    int j_current = 0;\n\n    for (int i = 2; i <= n; ++i) {\n        j_current = j_prev1 + 2 * j_prev2;\n        j_prev2 = j_prev1;\n        j_prev1 = j_current;\n    }\n\n    return j_current;\n}\n\n} // namespace jacobsthal\n```\n\n```cpp\n// include/jacobsthal/api.h\n#ifndef JACOBSTHAL_API_H\n#define JACOBSTHAL_API_H\n\n#include \"jacobsthal/JacobsthalCalculator.h\" // For internal documentation/type visibility\n\n// Public API function for calculating Jacobsthal numbers.\n// This function exposes the core library functionality.\nint jacobsthal_num(int n);\n\n#endif // JACOBSTHAL_API_H\n```\n\n```cpp\n// src/api.cpp\n#include \"jacobsthal/api.h\"\n#include \"jacobsthal/JacobsthalCalculator.h\"\n\n// Implements the public API function for the Jacobsthal Number Calculator library.\n// It forwards the call to the internal JacobsthalCalculator.\nint jacobsthal_num(int n) {\n    jacobsthal::JacobsthalCalculator calc;\n    return calc.jacobsthal_num(n);\n}\n```\n\n```cpp\n// src/main.cpp\n#include <iostream>\n#include <cassert>\n#include \"jacobsthal/api.h\"\n#include \"jacobsthal/InvalidInputError.h\" // For catching specific exceptions\n\n// Main entry point for the example/test harness.\n// It demonstrates calling the public API and asserts a specific value.\nint main() {\n    try {\n        // Acceptance assertion jacobsthal_num(5) == 11\n        int result = jacobsthal_num(5);\n        std::cout << \"jacobsthal_num(5) = \" << result << std::endl;\n        assert(result == 11);\n        std::cout << \"Assertion jacobsthal_num(5) == 11 PASSED.\" << std::endl;\n\n        // Example for J_0 and J_1\n        std::cout << \"jacobsthal_num(0) = \" << jacobsthal_num(0) << std::endl; // Should be 0\n        std::cout << \"jacobsthal_num(1) = \" << jacobsthal_num(1) << std::endl; // Should be 1\n        std::cout << \"jacobsthal_num(2) = \" << jacobsthal_num(2) << std::endl; // Should be 1\n        std::cout << \"jacobsthal_num(3) = \" << jacobsthal_num(3) << std::endl; // Should be 3\n\n        // Example of invalid input\n        std::cout << \"\\nTesting invalid input (negative):\" << std::endl;\n        try {\n            jacobsthal_num(-1);\n            std::cout << \"Error: Negative input did not throw an exception.\" << std::endl;\n        } catch (const jacobsthal::InvalidInputError& e) {\n            std::cout << \"Caught expected error: \" << e.what() << \" (Code: \" << e.getCode() << \")\" << std::endl;\n        } catch (const std::exception& e) {\n            std::cout << \"Caught unexpected standard exception: \" << e.what() << std::endl;\n        }\n\n    } catch (const std::exception& e) {\n        std::cerr << \"An unexpected error occurred: \" << e.what() << std::endl;\n        return 1; // Indicate failure\n    }\n\n    return 0; // Indicate success\n}\n```\n\n```markdown\n# Jacobsthal Number Calculator Library\n\nThis document describes how to use and build the Jacobsthal Number Calculator library.\n\n## Overview\n\nThe library provides a single public API function `jacobsthal_num(int n)` to compute the nth Jacobsthal number. It uses zero-based indexing (J_0=0, J_1=1) and the recurrence relation J_n = J_{n-1} + 2 * J_{n-2}. Input validation is performed, and `jacobsthal::InvalidInputError` is thrown for negative inputs.\n\n## API Usage Example\n\nTo use the library, include the `api.h` header and call the `jacobsthal_num` function:\n\n```cpp\n#include \"jacobsthal/api.h\"\n#include <iostream>\n\nint main() {\n    // Compute the 5th Jacobsthal number\n    int j5 = jacobsthal_num(5);\n    std::cout << \"J_5 = \" << j5 << std::endl; // Expected output: J_5 = 11\n\n    // Example of handling invalid input\n    try {\n        int j_negative = jacobsthal_num(-1);\n    } catch (const jacobsthal::InvalidInputError& e) {\n        std::cerr << \"Error computing Jacobsthal number: \" << e.what() << std::endl;\n    }\n    return 0;\n}\n```\n\n## Building the Project\n\nThis project uses C++17 or newer. A typical build process using a C++ compiler like g++ would involve compiling all `.cpp` files and linking them into an executable.\n\n**Example Build Steps (Linux/macOS with g++):**\n\n1.  **Navigate to the project root directory.**\n\n2.  **Compile source files:**\n\n    ```bash\n    g++ -std=c++17 -Iinclude src/*.cpp -o jacobsthal_calculator\n    ```\n\n    *   `-std=c++17`: Specifies C++17 standard, required for `std::any`.\n    *   `-Iinclude`: Tells the compiler to look for headers in the `include/` directory.\n    *   `src/*.cpp`: Compiles all `.cpp` files in the `src/` directory.\n    *   `-o jacobsthal_calculator`: Specifies the output executable name.\n\n3.  **Run the example/test harness:**\n\n    ```bash\n    ./jacobsthal_calculator\n    ```\n\n    The `main.cpp` file contains an acceptance assertion `jacobsthal_num(5) == 11`, which will be executed. If successful, it will print messages indicating passing assertions and results for various inputs, including an expected error for negative input.\n```"}
{"task_id": "Mbpp/755", "solution": "```python\n# src/__init__.py\nfrom .second_smallest import second_smallest\n\n```\n```python\n# src/second_smallest.py\nfrom typing import List, Sequence, Union, Set\n\nclass Number:\n    \"\"\"Represents a numeric value and provides basic comparison.\"\"\"\n    value: float\n\n    def __init__(self, value: Union[int, float]):\n        \"\"\"Initializes the Number with a given numeric value.\"\"\"\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"Number value must be an int or float.\")\n        self.value = float(value)\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two Number objects for equality.\"\"\"\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value == other.value\n\n    def __lt__(self, other: object) -> bool:\n        \"\"\"Compares if this Number is less than another.\"\"\"\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value < other.value\n\n    def __hash__(self) -> int:\n        \"\"\"Returns the hash of the Number's value.\"\"\"\n        return hash(self.value)\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation of the Number.\"\"\"\n        return f\"Number({self.value})\"\n\n    def compareTo(self, other: \"Number\") -> int:\n        \"\"\"Compares this Number to another, returning -1, 0, or 1.\"\"\"\n        if self.value < other.value:\n            return -1\n        elif self.value == other.value:\n            return 0\n        else:\n            return 1\n\n\nclass NumericList:\n    \"\"\"Wraps a list of numeric values and provides helper methods.\"\"\"\n    values: List[Number]\n\n    def __init__(self, input_values: Sequence[Union[int, float]]):\n        \"\"\"Initializes NumericList, converting input to Number objects.\"\"\"\n        if not isinstance(input_values, Sequence):\n            raise TypeError(\"Input to NumericList must be a sequence.\")\n        self.values = []\n        for val in input_values:\n            if not isinstance(val, (int, float)):\n                raise TypeError(f\"List contains non-numeric value: {val}\")\n            self.values.append(Number(val))\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.values)\n\n    def unique_values(self) -> List[float]:\n        \"\"\"Returns a sorted list of unique float values.\"\"\"\n        unique_set: Set[float] = {num.value for num in self.values}\n        return sorted(list(unique_set))\n\n\nclass SecondSmallestFunction:\n    \"\"\"Contains core logic for finding the second smallest distinct numeric value.\"\"\"\n\n    def validate_input(self, values: Sequence[Union[int, float]]) -> bool:\n        \"\"\"Validates if the input is a sequence of numeric values.\"\"\"\n        if not isinstance(values, (list, tuple)):\n            raise ValueError(\"Input must be a list or tuple of numbers.\")\n        for item in values:\n            if not isinstance(item, (int, float)):\n                raise ValueError(f\"Input contains non-numeric value: {item}\")\n        return True\n\n    def second_smallest(self, values: Sequence[Union[int, float]]) -> float:\n        \"\"\"Computes and returns the second smallest distinct numeric value.\"\"\"\n        self.validate_input(values) # Delegates input validation.\n\n        numeric_list = NumericList(values)\n        distinct_sorted_values = numeric_list.unique_values()\n\n        if len(distinct_sorted_values) < 2:\n            raise ValueError(\"Input must contain at least two distinct numeric values.\")\n\n        return distinct_sorted_values[1]\n\n\nclass TestCase:\n    \"\"\"Holds input and expected output for a test scenario.\"\"\"\n    input: NumericList\n    expected: Number\n\n    def __init__(self, input_list: Sequence[Union[int, float]], expected_value: Union[int, float]):\n        \"\"\"Initializes the test case with input and expected values.\"\"\"\n        self.input = NumericList(input_list)\n        self.expected = Number(expected_value)\n\n    def run(self) -> bool:\n        \"\"\"Runs the test by calling second_smallest and comparing results.\"\"\"\n        # Delegates to the module-level public API function.\n        actual_result = second_smallest(self.input.values_as_floats())\n        return actual_result == self.expected.value\n\n    # Helper method for TestCase to provide raw floats to the module-level function\n    def values_as_floats(self) -> List[float]:\n        \"\"\"Returns the internal values as a list of floats.\"\"\"\n        return [n.value for n in self.values]\n\n\n# Public API function (mandatory name)\ndef second_smallest(list_of_numbers: Sequence[Union[int, float]]) -> float:\n    \"\"\"\n    Finds the second smallest distinct numeric value in a list.\n    Raises ValueError for invalid input or insufficient distinct numbers.\n    \"\"\"\n    second_smallest_calculator = SecondSmallestFunction()\n    return second_smallest_calculator.second_smallest(list_of_numbers)\n\n```\n```python\n# tests/test_second_smallest.py\nimport pytest\nfrom src.second_smallest import second_smallest, Number, NumericList, SecondSmallestFunction, TestCase\n\ndef test_second_smallest_example():\n    \"\"\"Tests the exact assertion provided in the specification.\"\"\"\n    assert second_smallest([1, 2, -8, -2, 0, -2]) == -2\n\ndef test_second_smallest_duplicates():\n    \"\"\"Verifies correct handling of duplicate numbers.\"\"\"\n    assert second_smallest([1, 1, 2, 2, 3]) == 2\n    assert second_smallest([5, 5, 5, 5, 1, 1, 2]) == 2\n    assert second_smallest([10, 20, 10, 20, 30]) == 20\n\ndef test_second_smallest_floats():\n    \"\"\"Checks behavior with floating-point numbers and mixed types.\"\"\"\n    assert second_smallest([1.0, 2.5, 0.5, 3.0]) == 1.0\n    assert second_smallest([1, 2.5, -8.0, -2]) == -2.0\n    assert second_smallest([-0.5, -1.5, 0.0, 1.0]) == -0.5\n\ndef test_second_smallest_negative_numbers():\n    \"\"\"Ensures correct output for lists containing only negative numbers.\"\"\"\n    assert second_smallest([-10, -5, -8, -20]) == -10\n    assert second_smallest([-1, -1, -2, -3]) == -2\n\ndef test_second_smallest_large_numbers():\n    \"\"\"Tests with larger numeric values.\"\"\"\n    assert second_smallest([100, 50, 200, 150]) == 100\n\ndef test_second_smallest_already_sorted():\n    \"\"\"Tests lists that are already sorted.\"\"\"\n    assert second_smallest([1, 2, 3, 4, 5]) == 2\n    assert second_smallest([-5, -4, -3, -2]) == -4\n\ndef test_second_smallest_reverse_sorted():\n    \"\"\"Tests lists that are reverse sorted.\"\"\"\n    assert second_smallest([5, 4, 3, 2, 1]) == 2\n    assert second_smallest([-2, -3, -4, -5]) == -4\n\ndef test_second_smallest_single_distinct_value_raises_error():\n    \"\"\"Confirms ValueError is raised for fewer than two distinct values.\"\"\"\n    with pytest.raises(ValueError) as excinfo:\n        second_smallest([7])\n    assert \"at least two distinct numeric values\" in str(excinfo.value)\n\n    with pytest.raises(ValueError) as excinfo:\n        second_smallest([7, 7, 7])\n    assert \"at least two distinct numeric values\" in str(excinfo.value)\n\ndef test_second_smallest_empty_list_raises_error():\n    \"\"\"Confirms ValueError for an empty list.\"\"\"\n    with pytest.raises(ValueError) as excinfo:\n        second_smallest([])\n    assert \"at least two distinct numeric values\" in str(excinfo.value)\n\ndef test_second_smallest_non_numeric_input_raises_error():\n    \"\"\"Ensures ValueError is raised for non-numeric inputs.\"\"\"\n    with pytest.raises(ValueError) as excinfo:\n        second_smallest([1, 2, \"three\"])\n    assert \"non-numeric value\" in str(excinfo.value)\n\n    with pytest.raises(ValueError) as excinfo:\n        second_smallest([1, None, 3])\n    assert \"non-numeric value\" in str(excinfo.value)\n\n    with pytest.raises(ValueError) as excinfo:\n        second_smallest(\"not a list\")\n    assert \"Input must be a list or tuple of numbers.\" in str(excinfo.value)\n\n# Test cases for internal classes, ensuring they function as expected\ndef test_number_class_operations():\n    \"\"\"Tests the Number class's comparison and hashing operations.\"\"\"\n    n1 = Number(10)\n    n2 = Number(10.0)\n    n3 = Number(5)\n    n4 = Number(15)\n\n    assert n1 == n2\n    assert n1 != n3\n    assert n1 > n3\n    assert n1 < n4\n    assert n1.compareTo(n2) == 0\n    assert n1.compareTo(n3) == 1\n    assert n1.compareTo(n4) == -1\n    assert hash(n1) == hash(n2)\n\n    with pytest.raises(TypeError):\n        Number(\"invalid\")\n\ndef test_numericlist_class_operations():\n    \"\"\"Tests NumericList's length and unique_values methods.\"\"\"\n    nl = NumericList([1, 2, -8, -2, 0, -2, 1.0])\n    assert nl.length() == 7\n    assert nl.unique_values() == [-8.0, -2.0, 0.0, 1.0, 2.0]\n\n    with pytest.raises(TypeError):\n        NumericList([1, \"a\"])\n    with pytest.raises(TypeError):\n        NumericList(None) # Not a sequence\n\ndef test_secondsmallestfunction_class_delegation():\n    \"\"\"Tests the direct methods of SecondSmallestFunction.\"\"\"\n    ssf = SecondSmallestFunction()\n    assert ssf.second_smallest([1, 2, -8, -2, 0, -2]) == -2.0\n\n    with pytest.raises(ValueError):\n        ssf.second_smallest([5])\n    with pytest.raises(ValueError):\n        ssf.second_smallest([1, \"a\"])\n\n# This test case directly uses the TestCase class from src\n# Its run method uses the module-level second_smallest function.\ndef test_testcase_class_run():\n    \"\"\"Tests the TestCase class's run method.\"\"\"\n    tc1 = TestCase([1, 2, -8, -2, 0, -2], -2)\n    assert tc1.run() is True\n\n    tc2 = TestCase([1, 1, 2], 2)\n    assert tc2.run() is True\n\n    tc3 = TestCase([5, 4, 3, 2, 1], 2)\n    assert tc3.run() is True\n\n    # Test failure case\n    tc_fail = TestCase([1,2,3], 5)\n    assert tc_fail.run() is False\n\n    with pytest.raises(ValueError):\n        TestCase([5], 5).run() # Should raise error from second_smallest call\n\n```"}
