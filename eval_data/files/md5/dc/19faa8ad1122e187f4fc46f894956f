{"task_id": "Mbpp/16", "solution": "```python\nimport re\nfrom typing import Optional\n\nclass MatchResult:\n    \"\"\"Data object for regex match outcomes.\"\"\"\n    def __init__(self, matched: bool, matched_substring: Optional[str] = None) -> None:\n        self.matched: bool = matched\n        self.matched_substring: Optional[str] = matched_substring\n\nLOWERCASE_UNDERSCORE_REGEX: str = r\"[a-z]+_[a-z]+\"\n\nclass Pattern:\n    \"\"\"Encapsulates a regex pattern and matching operations.\"\"\"\n    def __init__(self, regex: str = None, description: str = None) -> None:\n        self.regex: str = regex if regex is not None else LOWERCASE_UNDERSCORE_REGEX\n        self.description: str = description or \"Lowercase letters, underscore, lowercase letters\"\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Checks if the pattern matches anywhere in the text.\"\"\"\n        return bool(re.search(self.regex, text))\n\n    def find_first(self, text: str) -> Optional[str]:\n        \"\"\"Finds the first substring that matches the pattern.\"\"\"\n        m = re.search(self.regex, text)\n        return m.group(0) if m else None\n\nclass TextAnalyzer:\n    \"\"\"Orchestrates text analysis using a Pattern.\"\"\"\n    def __init__(self, pattern: Pattern = None) -> None:\n        self._pattern: Pattern = pattern or Pattern()\n\n    def analyze(self, text: str) -> MatchResult:\n        \"\"\"Analyzes text for the presence of the defined pattern.\"\"\"\n        matched_substring = self._pattern.find_first(text)\n        matched = matched_substring is not None\n        return MatchResult(matched=matched, matched_substring=matched_substring)\n\n    def text_lowercase_underscore(self, text: str) -> bool:\n        \"\"\"Checks if text contains the lowercase_underscore pattern.\"\"\"\n        return self.analyze(text).matched\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Returns True if the input string contains at least one substring\n    matching [a-z]+_[a-z]+, otherwise False.\n    \"\"\"\n    analyzer = TextAnalyzer()\n    return analyzer.text_lowercase_underscore(text)\n```"}
{"task_id": "Mbpp/18", "solution": "```python\ndef _build_remove_set(remove: str) -> set:\n    \"\"\"Return a set of unique characters from the remove string for membership tests.\"\"\"\n    return set(remove)\n\ndef remove_dirty_chars(source: str, remove: str) -> str:\n    \"\"\"Return a new string containing characters from source with every character present in remove removed.\"\"\"\n    chars_to_remove = _build_remove_set(remove)\n    result_chars = []\n    for char in source:\n        if char not in chars_to_remove:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n```"}
{"task_id": "Mbpp/18", "solution": "class SourceString:\n    \"\"\"Encapsulates the source string for character removal.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the source string.\"\"\"\n        return len(self.value)\n\nclass Filters:\n    \"\"\"Encapsulates filter characters and provides unique set representation.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def uniqueChars(self) -> set:\n        \"\"\"Returns a set of unique characters from the filter string.\"\"\"\n        return set(self.value)\n\nclass CharacterSet:\n    \"\"\"A collection of characters, typically used for efficient lookup.\"\"\"\n    def __init__(self, chars: set):\n        self.chars = chars\n\nclass ResultString:\n    \"\"\"Encapsulates the string after character removal.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the result string.\"\"\"\n        return len(self.value)\n\ndef remove_dirty_chars(source: str, filters: str) -> str:\n    \"\"\"\n    Removes characters from the source string that are present in the filters string.\n    Preserves the relative order of the remaining characters.\n    \"\"\"\n    source_obj = SourceString(source)\n    filters_obj = Filters(filters)\n\n    filter_set = filters_obj.uniqueChars()\n    char_set_obj = CharacterSet(filter_set)\n\n    result_chars = []\n    for char in source_obj.value:\n        if char not in char_set_obj.chars:\n            result_chars.append(char)\n\n    final_result_str = \"\".join(result_chars)\n    result_obj = ResultString(final_result_str)\n\n    return result_obj.value"}
{"task_id": "Mbpp/19", "solution": "```python\n# src/__init__.py\n\"\"\"Package initializer for the duplicate_check_service.\"\"\"\n\nfrom .duplicate_check import test_duplicate\n\n__all__ = [\"test_duplicate\"]\n```\n```python\n# src/domain.py\n\"\"\"Domain model definitions for the duplicate check service.\"\"\"\n\nimport datetime\nfrom typing import List, Optional\n\n\nclass Array:\n    \"\"\"Encapsulates an ordered collection of integers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n\nclass IntegerValue:\n    \"\"\"A conceptual wrapper for a single integer element.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n\nclass DuplicateCheckResult:\n    \"\"\"Represents the outcome of a duplicate check.\"\"\"\n    def __init__(self, hasDuplicates: bool, checked_at: Optional[datetime.datetime] = None):\n        self.hasDuplicates = hasDuplicates\n        self.checked_at = checked_at or datetime.datetime.now()\n```\n```python\n# src/service.py\n\"\"\"DuplicateCheckService implementation for duplicate detection.\"\"\"\n\nfrom typing import List\nfrom src.domain import Array, DuplicateCheckResult, IntegerValue # DuplicateCheckResult, IntegerValue are imported per design spec, though not directly used in current test_duplicate method\n\n\nclass DuplicateCheckService:\n    \"\"\"Stateless service that evaluates an Array for duplicates.\"\"\"\n    def test_duplicate(self, arr: Array) -> bool:\n        \"\"\"Detects if the provided array contains any duplicate integers.\"\"\"\n        seen: set[int] = set()\n        for v in arr.elements:\n            if v in seen:\n                return True\n            seen.add(v)\n        return False\n```\n```python\n# src/duplicate_check.py\n\"\"\"Module-level API function for duplicate checking.\"\"\"\n\nfrom typing import List\nfrom src.domain import Array\nfrom src.service import DuplicateCheckService\n\n\ndef test_duplicate(array_of_ints: List[int]) -> bool:\n    \"\"\"Checks if a list of integers contains any duplicates.\"\"\"\n    # Per CRITICAL REQUIREMENTS, explicit type validation (e.g., isinstance checks for ints) is omitted.\n    # The design specifies validation, but CRITICAL REQUIREMENTS override this.\n    arr = Array(array_of_ints)\n    svc = DuplicateCheckService()\n    return svc.test_duplicate(arr)\n```\n```python\n# tests/test_duplicate.py\n\"\"\"Test harness for the duplicate check service.\"\"\"\n\nfrom src.duplicate_check import test_duplicate\n\n# Required assertion per SRS\nassert test_duplicate([1,2,3,4,5]) == False\n```"}
{"task_id": "Mbpp/56", "solution": "```python\n# src/reverse_twice_checker/__init__.py\nfrom .check import check\n\n\n# src/reverse_twice_checker/check.py\ndef reverse_digits(n: int) -> int:\n    \"\"\"Return integer formed by reversing decimal digits of n. Leading zeros dropped by int conversion.\"\"\"\n    sign = -1 if n < 0 else 1\n    s = str(abs(n))\n    reversed_s = s[::-1]\n    return sign * int(reversed_s)\n\ndef check(n: int) -> bool:\n    \"\"\"Return True iff n == 2 * reverse_digits(n) - 1\"\"\"\n    reversed_n = reverse_digits(n)\n    return n == 2 * reversed_n - 1\n```"}
