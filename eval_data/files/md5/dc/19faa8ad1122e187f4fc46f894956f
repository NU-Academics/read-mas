{"task_id": "Mbpp/554", "solution": "```python\n# src/__init__.py\n\"\"\"Package initializer for the split library.\"\"\"\nfrom .split import Split\n\n__all__ = [\"Split\"]\n\n```\n```python\n# src/split.py\nfrom typing import List, Iterator\n\nclass Integer:\n    \"\"\"Encapsulates an integer and provides an oddness check.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the encapsulated integer is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass IntegerList:\n    \"\"\"A lightweight wrapper for a list of integers, iterable as Integer objects.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def __iter__(self) -> Iterator[Integer]:\n        \"\"\"Yields Integer objects for each value in the list.\"\"\"\n        for value in self.values:\n            yield Integer(value)\n\nclass ResultList:\n    \"\"\"Accumulates odd integers and provides them as a standard Python list.\"\"\"\n    def __init__(self):\n        self.values: List[int] = []\n\n    def append(self, value: int):\n        \"\"\"Adds an integer to the accumulated list.\"\"\"\n        self.values.append(value)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the accumulated list of integers.\"\"\"\n        return self.values\n\nclass SplitProcessor:\n    \"\"\"Coordinates filtering an input list to extract only odd integers.\"\"\"\n    def __init__(self, input_list: List[int]):\n        self._input_list = IntegerList(input_list)\n        self._result_list = ResultList()\n\n    def filter_odds(self) -> List[int]:\n        \"\"\"Processes the input list, filtering for odd integers.\"\"\"\n        for integer_wrapper in self._input_list:\n            if integer_wrapper.is_odd():\n                self._result_list.append(integer_wrapper.value)\n        return self._result_list.to_list()\n\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Returns a list containing only the odd integers from the input list.\n    Preserves original order and handles negative odd integers.\n    \"\"\"\n    processor = SplitProcessor(input_list)\n    return processor.filter_odds()\n\n```\n```python\n# tests/test_split.py\n\"\"\"Unit tests for the Split function.\"\"\"\nfrom src.split import Split\n\ndef test_example_assertion():\n    \"\"\"Verify the example assertion from the problem statement.\"\"\"\n    assert Split([1, 2, 3, 4, 5, 6]) == [1, 3, 5]\n\ndef test_empty_and_no_odds():\n    \"\"\"Test with empty input and inputs containing no odd numbers.\"\"\"\n    assert Split([]) == []\n    assert Split([2, 4, 0, -2]) == []\n\ndef test_negative_odds():\n    \"\"\"Ensure negative odd numbers are correctly identified and included.\"\"\"\n    assert Split([-3, -2, 1]) == [-3, 1]\n\n```"}
{"task_id": "Mbpp/555", "solution": "```python\n# src/difference.py\n\ndef difference(n: int) -> int:\n    \"\"\"Entry point required by FR1. Returns sum_of_cubes - sum for first n natural numbers.\"\"\"\n    numbers = _generate_sequence(n)\n    sum_cubes = _sum_of_cubes(numbers)\n    sum_values = _sum(numbers)\n    return sum_cubes - sum_values\n\ndef _generate_sequence(n: int) -> list[int]:\n    \"\"\"Generates a sequence of natural numbers from 1 to n.\"\"\"\n    return list(range(1, n + 1))\n\ndef _sum_of_cubes(numbers: list[int]) -> int:\n    \"\"\"Computes the sum of cubes for a list of numbers.\"\"\"\n    return sum(x ** 3 for x in numbers)\n\ndef _sum(numbers: list[int]) -> int:\n    \"\"\"Computes the sum of a list of numbers.\"\"\"\n    return sum(numbers)\n```\n```python\n# tests/test_difference.py\nfrom src.difference import difference\n\ndef test_difference_example() -> None:\n    \"\"\"Verifies FR6: difference(3) should return 30.\"\"\"\n    assert difference(3) == 30\n```"}
{"task_id": "Mbpp/555", "solution": "```python\ndef difference(n: int) -> int:\n    \"\"\"\n    Computes the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using optimized formulas.\n    \"\"\"\n    sum_n = (n * (n + 1)) // 2\n    sum_cubes_n = sum_n * sum_n\n    return sum_cubes_n - sum_n\n```"}
{"task_id": "Mbpp/557", "solution": "```python\ndef _is_alphabetic(c: str) -> bool:\n    \"\"\"Return True if character c is alphabetic per runtime str.isalpha() definition.\"\"\"\n    return c.isalpha()\n\ndef _toggle_char(c: str) -> str:\n    \"\"\"Toggle the case of an alphabetic character.\n    Assumes the input character 'c' is alphabetic.\"\"\"\n    if c.islower():\n        return c.upper()\n    else: # c is alphabetic and not lowercase, so it must be uppercase.\n        return c.lower()\n\ndef toggle_string(input: str) -> str:\n    \"\"\"Return a new string with the case of every alphabetic character toggled.\n    Non-alphabetic characters remain unchanged.\"\"\"\n    if not input:\n        return \"\"\n\n    toggled_chars = []\n    for char in input:\n        if _is_alphabetic(char):\n            toggled_chars.append(_toggle_char(char))\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)\n```"}
{"task_id": "Mbpp/556", "solution": "```python\nfrom typing import List\n\nclass Element:\n    \"\"\"Represent a single input element and provide parity check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass Array:\n    \"\"\"Wrap a Python list of Element and provide length and slice helpers.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def slice_first_n(self, n: int) -> List[Element]:\n        \"\"\"Returns a slice containing the first n elements.\"\"\"\n        return self.elements[:n]\n\nclass Validator:\n    \"\"\"Validate input elements and normalize/clamp n per business rules.\"\"\"\n    def validate_elements(self, arr: list) -> bool:\n        \"\"\"Verifies all items in arr are integers.\"\"\"\n        return all(isinstance(item, int) for item in arr)\n\n    def validate_n(self, arr: list, n: int) -> int:\n        \"\"\"Clamps n to [0, len(arr)] and returns the normalized value.\"\"\"\n        return max(0, min(n, len(arr)))\n\nclass Result:\n    \"\"\"Simple container for the final count.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\nclass PairCounter:\n    \"\"\"Implement counting of unordered pairs with odd XOR using parity optimization.\"\"\"\n    def find_Odd_Pair(self, arr: list, n: int) -> int:\n        \"\"\"Orchestrates element conversion and counts odd XOR pairs, returning 0 when n < 2.\"\"\"\n        if n < 2:\n            return 0\n        \n        element_objects = [Element(val) for val in arr]\n        array_wrapper = Array(element_objects)\n        sliced_elements = array_wrapper.slice_first_n(n)\n        \n        return self.count_odd_xor_pairs(sliced_elements)\n\n    def count_odd_xor_pairs(self, elements: list) -> int:\n        \"\"\"Computes o * e where o = number of odd elements, e = number of even elements.\"\"\"\n        odd_count = 0\n        even_count = 0\n        for element in elements:\n            if element.is_odd():\n                odd_count += 1\n            else:\n                even_count += 1\n        return odd_count * even_count\n\ndef find_Odd_Pair(arr, n) -> int:\n    \"\"\"\n    Counts unordered index pairs (i < j) among the first n elements of arr \n    whose bitwise XOR is odd.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_elements(arr):\n        raise ValueError(\"arr must contain integers\")\n    n_clamped = validator.validate_n(arr, n)\n    counter = PairCounter()\n    return counter.find_Odd_Pair(arr, n_clamped)\n```"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"Return number of unordered pairs (i,j) with 0<=i<j<n such that arr[i] ^ arr[j] is odd.\n    This is computed by multiplying the count of even numbers by the count of odd numbers in the prefix.\n    \"\"\"\n    limit_n = min(n, len(arr))\n\n    if limit_n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(limit_n):\n        v = arr[i]\n        # The design specified raising TypeError for non-int, but critical requirements forbid isinstance checks.\n        # Assuming inputs are integers as per simplified critical requirements.\n        if v & 1:  # Check if odd (bitwise AND with 1)\n            odd_count += 1\n        else:  # Else, it's even\n            even_count += 1\n\n    return int(even_count * odd_count)"}
{"task_id": "Mbpp/558", "solution": "```python\nfrom typing import List\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass IntegerNumber:\n    \"\"\"Simple wrapper/value object for an input integer.\"\"\"\n    value: int\n\n@dataclass(frozen=True)\nclass Digit:\n    \"\"\"Represents a single decimal digit and its 0-based position.\"\"\"\n    value: int\n    position: int\n\n@dataclass(frozen=True)\nclass DigitDifference:\n    \"\"\"Represents absolute difference for a digit position.\"\"\"\n    position: int\n    difference: int\n\nclass DigitDistanceCalculator:\n    \"\"\"Encapsulates algorithm to compute sum of per-digit absolute differences.\"\"\"\n\n    def split_digits(self, n: int) -> List[Digit]:\n        \"\"\"Splits an integer into a list of Digit objects, LSB at position 0.\"\"\"\n        digits = []\n        s_n = str(n)\n        for i, char_digit in enumerate(reversed(s_n)):\n            digits.append(Digit(value=int(char_digit), position=i))\n        return digits\n\n    def compute_pairwise_differences(self, listA: List[Digit], listB: List[Digit]) -> List[DigitDifference]:\n        \"\"\"Computes absolute differences between digits at corresponding positions, padding with zeros.\"\"\"\n        differences = []\n        max_len = max(len(listA), len(listB))\n\n        dictA = {d.position: d.value for d in listA}\n        dictB = {d.position: d.value for d in listB}\n\n        for i in range(max_len):\n            val_a = dictA.get(i, 0)\n            val_b = dictB.get(i, 0)\n            diff = abs(val_a - val_b)\n            differences.append(DigitDifference(position=i, difference=diff))\n        return differences\n\n    def sum_differences(self, diffs: List[DigitDifference]) -> int:\n        \"\"\"Sums the absolute differences from a list of DigitDifference objects.\"\"\"\n        return sum(d.difference for d in diffs)\n\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        \"\"\"Main algorithm method: calculates sum of per-digit absolute differences.\"\"\"\n        digits_a = self.split_digits(a)\n        digits_b = self.split_digits(b)\n\n        pairwise_diffs = self.compute_pairwise_differences(digits_a, digits_b)\n        total_sum = self.sum_differences(pairwise_diffs)\n        return total_sum\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Public API function required by FR1. Delegates to DigitDistanceCalculator.digit_distance_nums.\"\"\"\n    return DigitDistanceCalculator().digit_distance_nums(a, b)\n```"}
{"task_id": "Mbpp/557", "solution": "```python\nfrom dataclasses import dataclass\n\n# Class: _Character (internal helper)\n# Responsibility: Represent a single character and provide utilities.\nclass _Character:\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_alphabetic(self) -> bool:\n        \"\"\"Checks if the character is alphabetic.\"\"\"\n        return self._value.isalpha()\n\n    def toggle_case(self) -> str:\n        \"\"\"Inverts case for alphabetic chars, returns original for others.\"\"\"\n        if self.is_alphabetic():\n            if self._value.islower():\n                return self._value.upper()\n            else:\n                return self._value.lower()\n        return self._value\n\n# Dataclass: InputString\n# Responsibility: Lightweight wrapper for the input string value.\n@dataclass\nclass InputString:\n    value: str\n\n# Dataclass: OutputString\n# Responsibility: Lightweight wrapper for the output string value.\n@dataclass\nclass OutputString:\n    value: str\n\n# Class: ToggleFunction\n# Responsibility: Encapsulate the toggling algorithm as a stateless service.\nclass ToggleFunction:\n    @staticmethod\n    def toggle_string(input: str) -> str:\n        \"\"\"\n        Processes an input string to toggle case of alphabetic characters.\n        Non-alphabetic characters are left unchanged.\n        \"\"\"\n        # Input validation for type (str) and raising TypeError is FORBIDDEN by critical requirement.\n        # Trusting the caller's input as per critical requirements.\n\n        input_obj = InputString(input)\n        toggled_chars = []\n        for char_value in input_obj.value:\n            char_obj = _Character(char_value)\n            toggled_chars.append(char_obj.toggle_case())\n\n        output_obj = OutputString(\"\".join(toggled_chars))\n        return output_obj.value\n\n# Module-level function: toggle_string\n# Responsibility: Public API that accepts a single string and returns transformed string.\ndef toggle_string(input: str) -> str:\n    \"\"\"\n    Public API function to toggle the case of alphabetic characters in a string.\n    It uses ToggleFunction to perform the core logic.\n    \"\"\"\n    # Input validation for type (str) and raising TypeError is FORBIDDEN by critical requirement.\n    # Trusting the caller's input as per critical requirements.\n\n    return ToggleFunction.toggle_string(input)\n```"}
{"task_id": "Mbpp/558", "solution": "```python\n# src/__init__.py\n__all__ = ['digit_distance_nums']\n```\n```python\n# src/digit_distance.py\n\ndef _to_base10_digits(n: int) -> list[int]:\n    \"\"\"Converts an integer's absolute value to a list of base-10 digits, least-significant-first.\n    Returns [0] for an input of 0.\n    \"\"\"\n    n = abs(n)\n    if n == 0:\n        return [0]\n    digits = []\n    while n > 0:\n        digits.append(n % 10)\n        n //= 10\n    return digits\n\nclass IntegerInput:\n    \"\"\"Represents an integer input and provides conversion to base-10 digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def to_base10_digits(self) -> list[int]:\n        \"\"\"Returns the integer's digits in least-significant-first order.\"\"\"\n        return _to_base10_digits(self.value)\n\nclass DigitDistanceResult:\n    \"\"\"A lightweight wrapper for the integer result of the digit distance calculation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def as_int(self) -> int:\n        \"\"\"Returns the stored integer value.\"\"\"\n        return self.value\n\nclass DigitDistanceCalculator:\n    \"\"\"Encapsulates the computation logic for per-digit comparison and summation.\"\"\"\n    @staticmethod\n    def compute_per_digit_differences(digits_a: list[int], digits_b: list[int]) -> list[int]:\n        \"\"\"Returns a list of absolute differences for each aligned digit pair, padding with zeros.\"\"\"\n        max_len = max(len(digits_a), len(digits_b))\n        \n        padded_digits_a = digits_a + [0] * (max_len - len(digits_a))\n        padded_digits_b = digits_b + [0] * (max_len - len(digits_b))\n        \n        differences = []\n        for i in range(max_len):\n            differences.append(abs(padded_digits_a[i] - padded_digits_b[i]))\n        return differences\n\n    @staticmethod\n    def digit_distance_nums(a: int, b: int) -> int:\n        \"\"\"Computes the sum of per-digit absolute differences between two integers.\"\"\"\n        input_a = IntegerInput(a)\n        input_b = IntegerInput(b)\n        digits_a = input_a.to_base10_digits()\n        digits_b = input_b.to_base10_digits()\n\n        diff_list = DigitDistanceCalculator.compute_per_digit_differences(digits_a, digits_b)\n        \n        total_difference = sum(diff_list)\n        result = DigitDistanceResult(total_difference)\n        return result.as_int()\n\ndef digit_distance_nums(a, b) -> int:\n    \"\"\"Public API to compute the sum of per-digit absolute differences between two integers.\"\"\"\n    return DigitDistanceCalculator.digit_distance_nums(a, b)\n```\n```python\n# tests/test_digit_distance.py\nfrom src.digit_distance import digit_distance_nums\n\ndef test_digit_distance_single_digit():\n    \"\"\"Verifies the function for single-digit inputs as per acceptance criteria.\"\"\"\n    assert digit_distance_nums(1, 2) == 1\n```"}
{"task_id": "Mbpp/559", "solution": "```python\n# src/input_validation.py\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\n    Holds a message explaining the validation error.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputArray:\n    \"\"\"Encapsulates array input and its expected length.\n    Validation methods perform no actual checks due to critical requirements.\"\"\"\n    def __init__(self, values, n):\n        self.values = values\n        self.n = n\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if inputs are valid. Always returns True as per critical requirements.\"\"\"\n        return True\n\n    def validate_or_raise(self) -> None:\n        \"\"\"Validates inputs or raises ValidationError. Performs no actual validation as per critical requirements.\"\"\"\n        pass\n\n```\n```python\n# src/result.py\nclass Result:\n    \"\"\"A simple value object to hold the computed integer sum.\n    Encapsulates the final maximum subarray sum.\"\"\"\n    def __init__(self, sum_value: int):\n        self.sum = sum_value\n\n```\n```python\n# src/max_sub_array.py\nfrom src.input_validation import InputArray, ValidationError\nfrom src.result import Result\n\nclass MaxSubArrayFunction:\n    \"\"\"Stateless class responsible for computing the maximum contiguous subarray sum.\"\"\"\n    def max_sub_array_sum(self, arr, n) -> int:\n        \"\"\"Instance method mirroring the API for internal use.\"\"\"\n        return self.compute(arr, n)\n\n    def compute(self, arr, n) -> int:\n        \"\"\"Computes the maximum contiguous subarray sum using a Kadane-like algorithm.\n        Initializes global_max to arr[0] to correctly handle all-negative arrays.\"\"\"\n        global_max = arr[0]\n        current_max = 0\n\n        for x in arr:\n            current_max += x\n            if current_max > global_max:\n                global_max = current_max\n            if current_max < 0:\n                current_max = 0\n        \n        return global_max\n\ndef max_sub_array_sum(arr, n) -> int:\n    \"\"\"Public API function to find the maximum contiguous subarray sum.\n    It performs validation (as a no-op) and computes the sum.\"\"\"\n    ia = InputArray(arr, n)\n    ia.validate_or_raise()\n    \n    result_value = MaxSubArrayFunction().compute(arr, n)\n    return Result(result_value).sum\n```"}
{"task_id": "Mbpp/559", "solution": "```python\n# src/__init__.py\nfrom .max_sub_array_sum import max_sub_array_sum\n\n```\n```python\n# src/types.py\nfrom typing import List\n\nclass Element:\n    \"\"\"Holds a single integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Array:\n    \"\"\"Represents an ordered collection of Element values.\"\"\"\n    def __init__(self, elements: List[int]):\n        # Accepts raw ints, constructs Element list.\n        self.elements: List[Element] = [Element(e) for e in elements]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Converts the Array back to a list of integers.\"\"\"\n        return [e.value for e in self.elements]\n\nclass Result:\n    \"\"\"Holds an integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n```\n```python\n# src/validator.py\nfrom typing import List\n\nclass Validator:\n    \"\"\"Validates if n equals the length of the input array.\"\"\"\n    def validate(self, arr: List[int], n: int) -> bool:\n        \"\"\"Returns True if n matches the array's length, False otherwise.\"\"\"\n        return n == len(arr)\n\n```\n```python\n# src/kadane.py\nfrom typing import List\n\nclass Kadane:\n    \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n    def compute(self, arr: List[int]) -> int:\n        \"\"\"Returns the maximum sum of any contiguous sublist.\"\"\"\n        if not arr:\n            return 0 \n\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n\n        return max_so_far\n\n```\n```python\n# src/max_sub_array_sum.py\nfrom typing import List\nfrom .types import Result # Import Result for return type\nfrom .validator import Validator\nfrom .kadane import Kadane\n\nclass FunctionCall:\n    \"\"\"Orchestrates validation and computation for the max subarray sum.\"\"\"\n    def __init__(self, arr: List[int], n: int, validator: Validator, kadane: Kadane):\n        self._arr = arr\n        self._n = n\n        self._validator = validator\n        self._kadane = kadane\n\n    def execute(self) -> Result:\n        \"\"\"Validates inputs and computes the max sum, raising ValueError on failure.\"\"\"\n        if not self._validator.validate(self._arr, self._n):\n            raise ValueError(\"Input validation error: n must equal the length of arr.\")\n        \n        computed_max = self._kadane.compute(self._arr)\n        return Result(computed_max)\n\ndef max_sub_array_sum(arr: List[int], n: int) -> int:\n    \"\"\"\n    Returns the maximum sum of any contiguous sublist of arr.\n    Raises ValueError if n does not equal the length of arr.\n    \"\"\"\n    # Construct FunctionCall with stateless components.\n    fc = FunctionCall(arr, n, validator=Validator(), kadane=Kadane())\n    result = fc.execute()\n    return result.value\n\n```\n```python\n# tests/test_max_sub_array_sum.py\nfrom src.max_sub_array_sum import max_sub_array_sum\n\n# Unit test verifying example behavior from SRS (FR3).\ndef test_example_assertion():\n    \"\"\"Verifies the specific example from the SRS.\"\"\"\n    assert max_sub_array_sum([-2, -3, 4, -1, -2, 1, 5, -3], 8) == 7\n\n```"}
{"task_id": "Mbpp/562", "solution": "```python\n# src/find_max_length.py\n#!/usr/bin/env python3\ndef Find_Max_Length(sublists: list) -> int:\n    \"\"\"Return the length of the longest sublist in 'sublists'.\n    This implementation returns 0 for an empty input list.\n    \"\"\"\n    max_len = 0\n    for sublist in sublists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n    return max_len\n\ndef __main_example() -> None:\n    \"\"\"Demonstrates usage of Find_Max_Length with the example data.\"\"\"\n    example = [[1],[1,4],[5,6,7,8]]\n    result = Find_Max_Length(example)\n    print(result)\n\nif __name__ == \"__main__\":\n    __main_example()\n\n```\n```python\n# tests/test_find_max_length.py\nfrom src.find_max_length import Find_Max_Length\n\ndef test_example_assertion() -> None:\n    \"\"\"Verifies the SRS-provided acceptance assertion for Find_Max_Length.\"\"\"\n    assert Find_Max_Length([[1],[1,4],[5,6,7,8]]) == 4\n\n```"}
{"task_id": "Mbpp/560", "solution": "```python\nclass TupleInput:\n    \"\"\"Encapsulates and exposes elements of an input tuple without mutation.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self._elements = elements\n\n    def get_elements(self) -> list:\n        \"\"\"Returns a shallow list copy of the tuple's elements for safe processing.\"\"\"\n        return list(self._elements)\n\n\nclass ElementSet:\n    \"\"\"Collects distinct elements and produces a sorted tuple representation.\"\"\"\n    def __init__(self) -> None:\n        self._elements = set()\n\n    def add(self, element) -> None:\n        \"\"\"Adds an element to the internal set, ensuring uniqueness.\"\"\"\n        self._elements.add(element)\n\n    def to_sorted_tuple(self) -> tuple:\n        \"\"\"Converts the unique elements to a sorted tuple.\"\"\"\n        return tuple(sorted(list(self._elements)))\n\n\nclass ResultTuple:\n    \"\"\"Holds the final tuple result and provides access to it.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self._elements = elements\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the encapsulated tuple result.\"\"\"\n        return self._elements\n\n\ndef union_elements(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"\n    Computes the set union of elements from two tuples, returning unique elements sorted ascending.\n    Input tuples are not modified by this operation.\n    \"\"\"\n    t1_input = TupleInput(t1)\n    t2_input = TupleInput(t2)\n\n    element_set = ElementSet()\n\n    for element in t1_input.get_elements():\n        element_set.add(element)\n\n    for element in t2_input.get_elements():\n        element_set.add(element)\n\n    sorted_unique_elements = element_set.to_sorted_tuple()\n    result_tuple = ResultTuple(sorted_unique_elements)\n\n    return result_tuple.as_tuple()\n```"}
{"task_id": "Mbpp/560", "solution": "```python\ndef union_elements(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"Computes the set-union of elements from two tuples and returns them sorted.\n    Elements are deduplicated and ordered ascending in the new tuple.\"\"\"\n    combined_elements = set(t1).union(set(t2))\n    sorted_elements = sorted(list(combined_elements))\n    return tuple(sorted_elements)\n```"}
