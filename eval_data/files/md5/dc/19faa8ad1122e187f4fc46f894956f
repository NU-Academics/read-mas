{"task_id": "Mbpp/726", "solution": "```python\n# src/domain.py\nfrom typing import Tuple, Union\n\nclass NumericTuple:\n    \"\"\"Represents an input tuple of numeric elements.\"\"\"\n    def __init__(self, elements: Tuple[Union[int, float], ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass ProductTuple:\n    \"\"\"Represents an output tuple of product elements.\"\"\"\n    def __init__(self, elements: Tuple[Union[int, float], ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass Element:\n    \"\"\"Represents a numeric element with its position.\"\"\"\n    def __init__(self, value: Union[int, float], position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to multiply_elements.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n# src/validator.py\nfrom src.domain import NumericTuple # Only for type annotation\n\nclass InputValidator:\n    \"\"\"Validates NumericTuple for minimum length and numeric element types.\"\"\"\n    def validateLength(self, t: NumericTuple) -> bool:\n        \"\"\"Checks if the tuple has at least two elements.\"\"\"\n        return t.length() >= 2\n\n    def validateElementTypes(self, t: NumericTuple) -> bool:\n        \"\"\"Checks if all elements in the tuple are integers or floats.\"\"\"\n        return all(isinstance(e, (int, float)) for e in t.elements)\n\n# src/multiply_elements.py\nfrom typing import Tuple, Union\nfrom src.domain import NumericTuple, ProductTuple, InvalidInputError\nfrom src.validator import InputValidator\n\nclass MultiplyElementsFunction:\n    \"\"\"Orchestrates validation and computes pairwise products of elements.\"\"\"\n    def __init__(self, validator: InputValidator = None) -> None:\n        self.validator = validator if validator is not None else InputValidator()\n\n    def execute(self, input: NumericTuple) -> ProductTuple:\n        \"\"\"Executes the validation and computation of pairwise products.\"\"\"\n        if not self.validator.validateLength(input):\n            raise InvalidInputError(\"Input tuple must contain at least two elements.\")\n        \n        if not self.validator.validateElementTypes(input):\n            raise InvalidInputError(\"All elements in the input tuple must be numbers (int or float).\")\n\n        products = []\n        for i in range(input.length() - 1):\n            products.append(input.elements[i] * input.elements[i+1])\n        \n        return ProductTuple(elements=tuple(products))\n\ndef multiply_elements(input: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Public API to compute pairwise products of numeric tuple elements.\n    Validates input length and element types, raising InvalidInputError if invalid.\n    \"\"\"\n    numeric_input = NumericTuple(elements=input)\n    engine = MultiplyElementsFunction()\n    product_tuple = engine.execute(numeric_input)\n    return product_tuple.elements\n```"}
{"task_id": "Mbpp/728", "solution": "```python\n# src/__init__.py\n\nfrom .sum_list import sum_list\n```\n```python\n# src/sum_list.py\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for validation failures in sum_list operations.\"\"\"\n    pass\n\nclass ListElement:\n    \"\"\"A lightweight wrapper for a numeric value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass InputList:\n    \"\"\"Wraps a Python list, providing length and element access.\"\"\"\n    def __init__(self, elements_raw: list):\n        self._elements = [ListElement(e) for e in elements_raw]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def __getitem__(self, index: int) -> ListElement:\n        \"\"\"Allows accessing elements by index.\"\"\"\n        return self._elements[index]\n\n    def __iter__(self):\n        \"\"\"Enables iteration over the wrapped ListElements.\"\"\"\n        return iter(self._elements)\n\nclass ResultList:\n    \"\"\"A container for ListElements representing the result.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def add_element(self, element: ListElement):\n        \"\"\"Adds a ListElement to the result list.\"\"\"\n        self._elements.append(element)\n\n    def to_list(self) -> list:\n        \"\"\"Converts the internal ListElements to a plain Python list of values.\"\"\"\n        return [e.value for e in self._elements]\n\nclass SumListFunction:\n    \"\"\"Encapsulates validation and computation logic for summing lists.\"\"\"\n    def validate_lengths(self, a: InputList, b: InputList):\n        \"\"\"Checks if two InputList instances have equal length.\"\"\"\n        if a.length() != b.length():\n            raise ValidationError(\"Input lists must have equal length.\")\n        return True\n\n    def validate_numeric_elements(self, a: InputList, b: InputList):\n        \"\"\"Checks if all elements in both InputList instances are numeric.\"\"\"\n        for elem_a, elem_b in zip(a, b):\n            if not isinstance(elem_a.value, (int, float)) or \\\n               not isinstance(elem_b.value, (int, float)):\n                raise ValidationError(\"All list elements must be numeric.\")\n        return True\n\n    def sum_list(self, a_raw: list, b_raw: list) -> list:\n        \"\"\"Validates inputs and computes the element-wise sum of two lists.\"\"\"\n        input_list_a = InputList(a_raw)\n        input_list_b = InputList(b_raw)\n\n        self.validate_lengths(input_list_a, input_list_b)\n        self.validate_numeric_elements(input_list_a, input_list_b)\n\n        result_list = ResultList()\n        for i in range(input_list_a.length()):\n            sum_val = input_list_a[i].value + input_list_b[i].value\n            result_list.add_element(ListElement(sum_val))\n\n        return result_list.to_list()\n\ndef sum_list(a: list, b: list) -> list:\n    \"\"\"Public API for summing two lists element-wise with validation.\"\"\"\n    return SumListFunction().sum_list(a, b)\n```\n```python\n# tests/test_sum_list.py\n\nfrom src.sum_list import sum_list\n\ndef test_example_sum_list():\n    \"\"\"Verifies the example test provided in the SRS.\"\"\"\n    assert sum_list([10, 20, 30], [15, 25, 35]) == [25, 45, 65]\n```"}
