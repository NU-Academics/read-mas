{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Tuple\n\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of overlapping consecutive 2-tuples from the input_list.\n    The input list is not modified, and an empty list is returned if it has fewer than two elements.\n    \"\"\"\n    result_pairs: List[Tuple[Any, Any]] = []\n\n    for i in range(len(input_list) - 1):\n        result_pairs.append((input_list[i], input_list[i+1]))\n\n    return result_pairs"}
{"task_id": "Mbpp/769", "solution": "from typing import Any, List\n\nclass Element:\n    \"\"\"Represents an element with its value and original position.\"\"\"\n    def __init__(self, value: Any, position: int):\n        self.value = value\n        self.position = position\n\nclass InputList:\n    \"\"\"Conceptual wrapper for an input list for documentation.\"\"\"\n    def __init__(self, items: List[Any]):\n        self.items = items\n\nclass OutputList:\n    \"\"\"Conceptual wrapper for a result list for documentation.\"\"\"\n    def __init__(self, items: List[Any]):\n        self.items = items\n\nclass DiffFunction:\n    \"\"\"Provides methods for computing list differences according to specific rules.\"\"\"\n\n    # Note: The design specified a validate_inputs method. However, critical requirements forbid\n    # isinstance() checks and raising exceptions, so its functionality is omitted.\n\n    def compute(self, a: list, b: list) -> list:\n        \"\"\"\n        Computes elements from list 'a' not present in 'b', maintaining order and duplicates.\n        Even-indexed elements appear first, followed by odd-indexed elements.\n        \"\"\"\n        even_indexed_candidates = []\n        odd_indexed_candidates = []\n\n        # Iterate through list 'a' using original indices\n        for i, item_a in enumerate(a):\n            # Determine if item_a is present in list 'b' using value equality\n            is_present_in_b = False\n            for item_b in b:\n                if item_a == item_b:\n                    is_present_in_b = True\n                    break\n            \n            # If item_a is not found in 'b', add it to the appropriate candidate list\n            if not is_present_in_b:\n                if i % 2 == 0:  # Even index\n                    even_indexed_candidates.append(item_a)\n                else:  # Odd index\n                    odd_indexed_candidates.append(item_a)\n        \n        # Concatenate the collected candidates: even-indexed first, then odd-indexed\n        return even_indexed_candidates + odd_indexed_candidates\n\ndef Diff(a: list, b: list) -> list:\n    \"\"\"\n    Computes elements from the first list not present in the second.\n    Results are ordered with even-indexed elements first, then odd-indexed.\n    \"\"\"\n    diff_service = DiffFunction()\n    # Per critical requirements, input validation (isinstance checks and TypeErrors) is omitted.\n    return diff_service.compute(a, b)"}
{"task_id": "Mbpp/770", "solution": "```python\n# File: src/odd_num_sum.py\nfrom typing import List\n\n\nclass OddNumber:\n    \"\"\"Represents a single odd natural number and computes its fourth power.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def fourth_power(self) -> int:\n        \"\"\"Computes the fourth power of the odd number's value.\"\"\"\n        return self.value ** 4\n\n\nclass OddNumberSequence:\n    \"\"\"Generates and holds a sequence of the first n odd natural numbers.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n        self.sequence: List[OddNumber] = []\n\n    def generate(self) -> List[OddNumber]:\n        \"\"\"Populates and returns the sequence of OddNumber instances.\"\"\"\n        for i in range(1, self.n + 1):\n            odd_value = 2 * i - 1\n            self.sequence.append(OddNumber(odd_value))\n        return self.sequence\n\n\nclass Result:\n    \"\"\"A simple value holder for a computed integer sum.\"\"\"\n    def __init__(self, sum_value: int) -> None:\n        self.sum = sum_value\n\n\nclass OddNumSumCalculator:\n    \"\"\"Coordinates generation of odd numbers and computes the sum of their fourth powers.\"\"\"\n    def odd_num_sum(self, n: int) -> int:\n        \"\"\"Calculates the sum of fourth powers for the first n odd numbers.\"\"\"\n        odd_sequence_generator = OddNumberSequence(n)\n        odd_numbers = odd_sequence_generator.generate()\n        final_sum = self._compute_power_sum(odd_numbers)\n        return final_sum\n\n    def _compute_power_sum(self, sequence: List[OddNumber]) -> int:\n        \"\"\"Helper to sum the fourth powers of OddNumber instances in a sequence.\"\"\"\n        total_sum = 0\n        for odd_num_obj in sequence:\n            total_sum += odd_num_obj.fourth_power()\n        result_obj = Result(total_sum)\n        return result_obj.sum\n\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"Public API: Computes the sum of fourth powers of the first n odd natural numbers.\"\"\"\n    calculator = OddNumSumCalculator()\n    return calculator.odd_num_sum(n)\n\n```\n```python\n# File: tests/test_odd_num_sum.py\nfrom src.odd_num_sum import odd_num_sum\n\n# Provided acceptance test.\nassert odd_num_sum(2) == 82\n\n```"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth powers of the first n odd natural numbers.\n    Trusts that n is an integer greater than or equal to 1.\"\"\"\n    return sum((2 * k - 1) ** 4 for k in range(1, n + 1))"}
{"task_id": "Mbpp/771", "solution": "```python\nfrom typing import List, Optional, Set, Dict\n\nclass Expression:\n    \"\"\"Represents the input expression string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass Bracket:\n    \"\"\"Represents a bracket character and provides matching logic.\"\"\"\n    _OPENING_SYMBOLS: Set[str] = {'(', '[', '{'}\n    _CLOSING_SYMBOLS: Set[str] = {')', ']', '}'}\n    _BRACKET_PAIRS_MAP: Dict[str, str] = {\n        '(': ')', ')': '(',\n        '[': ']', ']': '[',\n        '{': '}', '}': '{'\n    }\n    _BRACKET_KINDS: Dict[str, str] = {\n        '(': 'paren', ')': 'paren',\n        '[': 'square', ']': 'square',\n        '{': 'curly', '}': 'curly'\n    }\n\n    def __init__(self, symbol: str) -> None:\n        self.symbol = symbol\n        self.kind = self._BRACKET_KINDS.get(symbol, 'unknown')\n\n    def is_opening(self) -> bool:\n        \"\"\"Checks if the bracket is an opening type.\"\"\"\n        return self.symbol in self._OPENING_SYMBOLS\n\n    def is_closing(self) -> bool:\n        \"\"\"Checks if the bracket is a closing type.\"\"\"\n        return self.symbol in self._CLOSING_SYMBOLS\n\n    def matching_symbol(self) -> str:\n        \"\"\"Returns the corresponding matching bracket symbol.\"\"\"\n        return self._BRACKET_PAIRS_MAP.get(self.symbol, '')\n\nclass CheckResult:\n    \"\"\"Represents the boolean outcome of the bracket check.\"\"\"\n    def __init__(self, is_balanced: bool) -> None:\n        self.is_balanced = is_balanced\n\nclass Stack:\n    \"\"\"A simple Last-In, First-Out (LIFO) stack implementation.\"\"\"\n    def __init__(self) -> None:\n        self._items: List[str] = []\n\n    def push(self, item: str) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self) -> Optional[str]:\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        if not self.is_empty():\n            return self._items.pop()\n        return None\n\n    def peek(self) -> Optional[str]:\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\nclass CheckExpression:\n    \"\"\"Implements the core algorithm to check bracket balance.\"\"\"\n    _BRACKET_CHARS = {'(', ')', '[', ']', '{', '}'}\n\n    def check_expression(self, expr: str) -> bool:\n        \"\"\"Analyzes an expression for balanced and correctly nested brackets.\"\"\"\n        expression_obj = Expression(expr)\n        stack = Stack()\n\n        for char in expression_obj.value:\n            if char not in self._BRACKET_CHARS:\n                continue \n\n            current_bracket = Bracket(char)\n\n            if current_bracket.is_opening():\n                stack.push(current_bracket.symbol)\n            elif current_bracket.is_closing():\n                if stack.is_empty():\n                    # Closing bracket without a matching opening bracket\n                    return CheckResult(False).is_balanced\n                \n                top_symbol = stack.pop()\n                popped_bracket = Bracket(top_symbol)\n                \n                if popped_bracket.matching_symbol() != current_bracket.symbol:\n                    # Mismatched closing bracket\n                    return CheckResult(False).is_balanced\n        \n        return CheckResult(stack.is_empty()).is_balanced\n\ndef check_expression(expr: str) -> bool:\n    \"\"\"Public API function to check if the given expression is balanced.\"\"\"\n    checker = CheckExpression()\n    return checker.check_expression(expr)\n```"}
{"task_id": "Mbpp/772", "solution": "class InputString:\n    \"\"\"Data holder for input text.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\nclass Word:\n    \"\"\"Token representation with metadata.\"\"\"\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.length = len(text)\n        self.position = position\n\nclass ResultString:\n    \"\"\"Container for assembled output.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\ndef _tokenize_whitespace(input_text: str) -> list[Word]:\n    \"\"\"Tokenizes on whitespace sequences into Word instances with positions.\n    Positions are zero-based indices of words in the tokenized sequence.\"\"\"\n    words = []\n    token_strings = input_text.split()\n    for i, word_text in enumerate(token_strings):\n        words.append(Word(text=word_text, position=i))\n    return words\n\ndef _assemble_result(words: list[Word]) -> str:\n    \"\"\"Joins words' text with single spaces and ensures no leading/trailing whitespace.\n    An empty list of words results in an empty string.\"\"\"\n    return \" \".join([word.text for word in words])\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"Return a string with words of length k removed.\n    Orchestrates tokenization, filtering, and assembly.\"\"\"\n    tokens = _tokenize_whitespace(input_string)\n    filtered_tokens = [word for word in tokens if word.length != k]\n    result_text = _assemble_result(filtered_tokens)\n    return result_text"}
{"task_id": "Mbpp/773", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Tuple\n\n@dataclass(frozen=True)\nclass MatchResult:\n    \"\"\"Immutable dataclass to store details of a found substring match.\"\"\"\n    matched_substring: str\n    start_index: int\n    end_index: int\n\nclass OccuranceSubstring:\n    \"\"\"Encapsulates the logic for finding the first occurrence of a substring.\"\"\"\n    def __init__(self, source: str, substring: str) -> None:\n        self.source = source\n        self.substring = substring\n\n    def find(self) -> Optional[MatchResult]:\n        \"\"\"Locates the first occurrence of the substring in the source string.\"\"\"\n        index_found = self.source.find(self.substring)\n        if index_found != -1:\n            matched = self.substring\n            start_index = index_found\n            end_index = start_index + len(self.substring)\n            return MatchResult(matched, start_index, end_index)\n        return None\n\ndef occurance_substring(source: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence of a substring within a source string.\n    Returns a tuple (matched_substring, start_index, end_index) on match, or None otherwise.\n    \"\"\"\n    searcher = OccuranceSubstring(source, substring)\n    match_result = searcher.find()\n\n    if match_result:\n        return (match_result.matched_substring, match_result.start_index, match_result.end_index)\n    return None"}
{"task_id": "Mbpp/771", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker for src module.\"\"\"\n\n# No classes/functions required; empty or minimal package exports\n\n```\n```python\n# src/stack.py\n\"\"\"Simple LIFO Stack implementation.\"\"\"\n\nclass Stack:\n    \"\"\"A minimal LIFO Stack for managing items.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes an empty stack.\"\"\"\n        self._items: list[object] = []\n\n    def push(self, item: object) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self) -> object:\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        if not self._items:\n            raise IndexError(\"pop from empty stack\")\n        return self._items.pop()\n\n    def peek(self) -> object:\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if not self._items:\n            raise IndexError(\"peek from empty stack\")\n        return self._items[-1]\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\n```\n```python\n# src/models.py\n\"\"\"Lightweight domain models for expression checking.\"\"\"\n\nclass Expression:\n    \"\"\"A wrapper for the input expression string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        \"\"\"Initializes the expression with the raw string.\"\"\"\n        self.raw: str = raw\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw expression string.\"\"\"\n        return len(self.raw)\n\nclass BracketPair:\n    \"\"\"Represents a pair of opening and closing brackets.\"\"\"\n    def __init__(self, opening: str, closing: str) -> None:\n        \"\"\"Initializes a bracket pair.\"\"\"\n        self.opening: str = opening\n        self.closing: str = closing\n\n```\n```python\n# src/expression_checker.py\n#!/usr/bin/env python3\n\"\"\"Entry module exposing check_expression(expr: str) -> bool.\"\"\"\n\nfrom src.stack import Stack\nfrom src.models import Expression, BracketPair\n\n_PAIRS: dict[str, str] = {')': '(', '}': '{', ']': '['}\n\"\"\"Module-level constant mapping a closing bracket to its corresponding opening bracket.\"\"\"\n\nclass ExpressionChecker:\n    \"\"\"Internal coordinator for checking balanced brackets using a stack.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the checker with bracket pair mappings.\"\"\"\n        self._pairs: dict[str, str] = _PAIRS\n        self._opening_brackets: set[str] = set(self._pairs.values())\n        self._closing_brackets: set[str] = set(self._pairs.keys())\n\n    def check(self, expr: str) -> bool:\n        \"\"\"Implements the core algorithm to check for balanced brackets.\"\"\"\n        stack = Stack()\n        expression_obj = Expression(expr)\n\n        for char in expression_obj.raw:\n            if char in self._opening_brackets:\n                stack.push(char)\n            elif char in self._closing_brackets:\n                if stack.is_empty():\n                    return False  # An unmatched closing bracket found.\n                \n                last_opening = stack.pop()\n                if self._pairs[char] != last_opening:\n                    return False  # Mismatched bracket pair found.\n            # Other characters are ignored as per design.\n\n        return stack.is_empty() # True if all opening brackets were matched.\n\ndef check_expression(expr: str) -> bool:\n    \"\"\"Evaluates an expression for balanced and properly nested brackets.\n    Delegates to ExpressionChecker for the core logic.\n    \"\"\"\n    # As per CRITICAL REQUIREMENTS, type checks (e.g., isinstance(expr, str))\n    # and raising TypeErrors are skipped.\n    checker = ExpressionChecker()\n    return checker.check(expr)\n\n```"}
{"task_id": "Mbpp/772", "solution": "```python\nfrom typing import List\n\ndef remove_length(input: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the input string. Words are separated by one or more whitespace characters and joined by a single space.\"\"\"\n    tokens = input.split()\n    filtered_tokens = [token for token in tokens if len(token) != k]\n    return ' '.join(filtered_tokens)\n```"}
