{"task_id": "Mbpp/618", "solution": "```python\n# src/__init__.py\n# Purpose: Package marker.\n```\n```python\n# src/models.py\nfrom dataclasses import dataclass\nfrom typing import List, Union, Optional\n\n# Purpose: Domain data models per SRS.\n@dataclass\nclass NumberList:\n    \"\"\"Data holder for input list of numbers.\"\"\"\n    values: List[Union[int, float]]\n    id: Optional[int] = None\n\n@dataclass\nclass DivisionResult:\n    \"\"\"Data holder for output list of floats.\"\"\"\n    values: List[float]\n    id: Optional[int] = None\n```\n```python\n# src/validator.py\nimport numbers\nfrom typing import List, Union, TYPE_CHECKING\n\n# Forward reference for NumberList to avoid circular imports during type checking\nif TYPE_CHECKING:\n    from src.models import NumberList\n\n# Purpose: InputValidator responsible for validating list lengths and numeric content.\nclass InputValidator:\n    \"\"\"Stateless validation helpers for input lists.\"\"\"\n\n    @staticmethod\n    def validateSameLength(a: Union[List[Union[int, float]], \"NumberList\"],\n                           b: Union[List[Union[int, float]], \"NumberList\"]) -> bool:\n        \"\"\"Checks if two lists (or NumberList objects) have the same length.\"\"\"\n        list_a = a.values if hasattr(a, 'values') else a\n        list_b = b.values if hasattr(b, 'values') else b\n        return len(list_a) == len(list_b)\n\n    @staticmethod\n    def validateNumericElements(lst: Union[List[Union[int, float]], \"NumberList\"]) -> bool:\n        \"\"\"Checks if all elements in a list (or NumberList object) are numeric.\"\"\"\n        target_list = lst.values if hasattr(lst, 'values') else lst\n        return all(isinstance(element, numbers.Number) for element in target_list)\n\n```\n```python\n# src/div_list.py\nfrom typing import List, Union, TYPE_CHECKING\n\nfrom src.validator import InputValidator\n\n# Forward references for NumberList and DivisionResult for type checking\nif TYPE_CHECKING:\n    from src.models import NumberList, DivisionResult\n\n# Purpose: Implements the div_list function and optional DivListFunction wrapper.\ndef div_list(a: Union[List[Union[int, float]], \"NumberList\"],\n             b: Union[List[Union[int, float]], \"NumberList\"]) -> List[float]:\n    \"\"\"\n    Performs element-wise division of two input lists of numeric values.\n    Raises ValueError on validation failure; ZeroDivisionError may propagate.\n    \"\"\"\n    # Extract actual lists if NumberList objects are provided\n    list_a = a.values if hasattr(a, 'values') else a\n    list_b = b.values if hasattr(b, 'values') else b\n\n    # Validate inputs\n    if not InputValidator.validateSameLength(list_a, list_b):\n        raise ValueError(\"Input lists must have the same length.\")\n    if not InputValidator.validateNumericElements(list_a):\n        raise ValueError(\"All elements in the first list must be numeric.\")\n    if not InputValidator.validateNumericElements(list_b):\n        raise ValueError(\"All elements in the second list must be numeric.\")\n\n    # Compute element-wise division\n    results = [float(list_a[i]) / float(list_b[i]) for i in range(len(list_a))]\n\n    return results\n\nclass DivListFunction:\n    \"\"\"Wrapper class providing a class method to call div_list with NumberList objects.\"\"\"\n\n    @classmethod\n    def div_list(cls, a: \"NumberList\", b: \"NumberList\") -> List[float]:\n        \"\"\"Delegates to the module-level div_list function, accepting NumberList objects.\"\"\"\n        return div_list(a, b)\n```\n```python\n# src/main.py\nfrom src.div_list import div_list\n\n# Purpose: Example entry point that demonstrates calling div_list and runs the example assertion.\ndef run_example():\n    \"\"\"Demonstrates div_list usage and verifies the example assertion.\"\"\"\n    print(\"Running div_list example...\")\n    input_a = [4, 5, 6]\n    input_b = [1, 2, 3]\n    expected_result = [4.0, 2.5, 2.0]\n\n    result = div_list(input_a, input_b)\n\n    print(f\"div_list({input_a}, {input_b}) == {result}\")\n    assert result == expected_result\n    print(\"Example assertion passed!\")\n\nif __name__ == '__main__':\n    run_example()\n```"}
{"task_id": "Mbpp/618", "solution": "```\nsrc/\n\u251c\u2500\u2500 __init__.py\n\u251c\u2500\u2500 div_list.py\n\u251c\u2500\u2500 types.py\n\u2514\u2500\u2500 validator.py\ntests/\n\u2514\u2500\u2500 test_div_list.py\n```\n\n**src/types.py**\n```python\nfrom typing import List, Union\n\n# Define a type alias for numbers as specified in design's intent (int or float)\nNumeric = Union[int, float]\n\nclass ListElement:\n    \"\"\"Represents a single numeric element.\"\"\"\n    def __init__(self, value: Numeric):\n        self._value = value\n\n    def get_value(self) -> Numeric:\n        \"\"\"Returns the element's value.\"\"\"\n        return self._value\n\nclass InputList:\n    \"\"\"Encapsulates an input list of numeric elements.\"\"\"\n    def __init__(self, elements: List[Numeric]):\n        # Copy to preserve immutability of caller's list.\n        self._elements: List[Numeric] = list(elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return len(self._elements)\n\n    def get_element(self, idx: int) -> Numeric:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[idx]\n\nclass ResultList:\n    \"\"\"Encapsulates a result list of floating-point values.\"\"\"\n    def __init__(self):\n        self._elements: List[float] = []\n\n    def append(self, value: float) -> None:\n        \"\"\"Appends a floating-point value to the list.\"\"\"\n        self._elements.append(value)\n\n    def to_list(self) -> List[float]:\n        \"\"\"Returns the internal list as a native Python list.\"\"\"\n        return list(self._elements)\n\n```\n\n**src/validator.py**\n```python\nfrom typing import List, Union\nfrom .types import InputList, Numeric\n\n# Helper for generic access to list-like objects\ndef _get_length(obj: Union[List[Numeric], InputList]) -> int:\n    \"\"\"Returns the length of a list or InputList object.\"\"\"\n    if isinstance(obj, InputList):\n        return obj.length()\n    return len(obj)\n\ndef _get_element(obj: Union[List[Numeric], InputList], idx: int) -> Numeric:\n    \"\"\"Returns an element from a list or InputList object by index.\"\"\"\n    if isinstance(obj, InputList):\n        return obj.get_element(idx)\n    return obj[idx]\n\nclass Validator:\n    \"\"\"Implements validation routines for input lists.\"\"\"\n    @staticmethod\n    def validate_lengths(list1: Union[List[Numeric], InputList], list2: Union[List[Numeric], InputList]) -> bool:\n        \"\"\"Returns True if the lengths of the two lists are equal.\"\"\"\n        return _get_length(list1) == _get_length(list2)\n\n    @staticmethod\n    def validate_numeric(list_obj: Union[List[Numeric], InputList]) -> bool:\n        \"\"\"Returns True if all elements in the list are numeric (int or float).\"\"\"\n        length = _get_length(list_obj)\n        for i in range(length):\n            element = _get_element(list_obj, i)\n            if not isinstance(element, (int, float)):\n                return False\n        return True\n\n    @staticmethod\n    def check_no_zero_divisors(list2: Union[List[Numeric], InputList]) -> bool:\n        \"\"\"Returns True if no element in list2 is zero.\"\"\"\n        length = _get_length(list2)\n        for i in range(length):\n            element = _get_element(list2, i)\n            if element == 0:\n                return False\n        return True\n\n```\n\n**src/div_list.py**\n```python\nfrom typing import List, Union\nfrom .types import InputList, ResultList, ListElement, Numeric\nfrom .validator import Validator, _get_length, _get_element\n\nclass DivListFunction:\n    \"\"\"Performs element-wise division on validated inputs.\"\"\"\n    @staticmethod\n    def div_list(list1: Union[List[Numeric], InputList], list2: Union[List[Numeric], InputList]) -> ResultList:\n        \"\"\"Divides elements of list1 by elements of list2. Assumes inputs are validated.\"\"\"\n        result_list = ResultList()\n        length = _get_length(list1) # Lengths are already validated to be equal\n\n        for i in range(length):\n            numerator = _get_element(list1, i)\n            denominator = _get_element(list2, i)\n            result_list.append(float(numerator / denominator))\n        return result_list\n\ndef div_list(list1: List[Numeric], list2: List[Numeric]) -> List[float]:\n    \"\"\"Public API function for element-wise division of two lists.\n    Validates inputs and returns a list of floats.\n    \"\"\"\n    if not Validator.validate_lengths(list1, list2):\n        raise ValueError(\"mismatched lengths\")\n\n    if not Validator.validate_numeric(list1):\n        raise TypeError(\"non-numeric element in list1\")\n\n    if not Validator.validate_numeric(list2):\n        raise TypeError(\"non-numeric element in list2\")\n\n    if not Validator.check_no_zero_divisors(list2):\n        raise ZeroDivisionError(\"zero divisor detected\")\n\n    # Delegate to DivListFunction after validation\n    result_obj = DivListFunction.div_list(list1, list2)\n    return result_obj.to_list()\n\n```\n\n**src/__init__.py**\n```python\nfrom .div_list import div_list\n\n```\n\n**tests/test_div_list.py**\n```python\nimport pytest\nfrom src.div_list import div_list\n\ndef test_div_list_example():\n    \"\"\"Verifies the example from FR4: div_list([4,5,6],[1,2,3]) == [4.0, 2.5, 2.0].\"\"\"\n    assert div_list([4, 5, 6], [1, 2, 3]) == [4.0, 2.5, 2.0]\n\ndef test_mismatched_lengths():\n    \"\"\"Verifies ValueError is raised for lists of different lengths.\"\"\"\n    with pytest.raises(ValueError, match=\"mismatched lengths\"):\n        div_list([1, 2], [1, 2, 3])\n\ndef test_zero_divisor():\n    \"\"\"Verifies ZeroDivisionError is raised when list2 contains zero.\"\"\"\n    with pytest.raises(ZeroDivisionError, match=\"zero divisor detected\"):\n        div_list([1, 2, 3], [1, 0, 3])\n\ndef test_non_numeric_list1():\n    \"\"\"Verifies TypeError is raised for non-numeric elements in list1.\"\"\"\n    with pytest.raises(TypeError, match=\"non-numeric element in list1\"):\n        div_list([1, \"a\", 3], [1, 2, 3])\n\ndef test_non_numeric_list2():\n    \"\"\"Verifies TypeError is raised for non-numeric elements in list2.\"\"\"\n    with pytest.raises(TypeError, match=\"non-numeric element in list2\"):\n        div_list([1, 2, 3], [1, \"b\", 3])\n\ndef test_input_immutability():\n    \"\"\"Verifies that input lists are not modified by the function.\"\"\"\n    list1_original = [4, 5, 6]\n    list2_original = [1, 2, 3]\n    list1_copy = list(list1_original)\n    list2_copy = list(list2_original)\n\n    _ = div_list(list1_original, list2_original)\n\n    assert list1_original == list1_copy\n    assert list2_original == list2_copy\n\ndef test_determinism():\n    \"\"\"Verifies that repeated calls with same inputs yield identical outputs.\"\"\"\n    list1 = [7, 8, 9]\n    list2 = [1, 2, 3]\n\n    result1 = div_list(list1, list2)\n    result2 = div_list(list1, list2)\n\n    assert result1 == result2\n\n    # Test with different but valid inputs\n    list3 = [10, 20]\n    list4 = [2, 5]\n    result3 = div_list(list3, list4)\n    result4 = div_list(list3, list4)\n    assert result3 == result4\n\n```"}
{"task_id": "Mbpp/619", "solution": "def move_num(input: str) -> str:\n    \"\"\"\n    Moves all ASCII digit characters ('0'-'9') to the end of the input string.\n    Preserves the relative order of non-digit characters and digit characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input:\n        if '0' <= char <= '9':  # Classify as ASCII digit\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/619", "solution": "```python\n# Consolidated code from src/validator.py, src/separator.py, src/models.py, and src/move_num.py\n# to satisfy the \"all functions defined inline\" requirement.\n\n# --- src/validator.py components ---\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    \"\"\"Centralized component for input validation.\"\"\"\n    def validate(self, input: any) -> None:\n        \"\"\"Validates if the input is a string, raises ValidationError otherwise.\"\"\"\n        if not isinstance(input, str):\n            raise ValidationError(\"Input must be a string\")\n\n# --- src/separator.py components ---\nclass CharacterGroup:\n    \"\"\"Lightweight data holder for classified characters.\"\"\"\n    def __init__(self, type: str, chars: str) -> None:\n        self.type = type\n        self.chars = chars\n\nclass Separator:\n    \"\"\"Separates characters into non-digits and digits in a single pass.\"\"\"\n    def collectNonDigits(self, input: str) -> str:\n        \"\"\"Returns only the non-digit characters from the input.\"\"\"\n        return self.separate(input)[0]\n\n    def collectDigits(self, input: str) -> str:\n        \"\"\"Returns only the digit characters from the input.\"\"\"\n        return self.separate(input)[1]\n\n    def separate(self, input: str) -> tuple[str, str]:\n        \"\"\"Performs a single-pass separation of characters into non-digits and digits.\"\"\"\n        non_digits_chars: list[str] = []\n        digits_chars: list[str] = []\n\n        for ch in input:\n            if '0' <= ch <= '9':\n                digits_chars.append(ch)\n            else:\n                non_digits_chars.append(ch)\n\n        return (''.join(non_digits_chars), ''.join(digits_chars))\n\n# --- src/models.py components ---\nclass InputString:\n    \"\"\"Data holder for input string with its computed length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\nclass OutputString:\n    \"\"\"Data holder for the resulting output string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n# --- src/move_num.py components ---\nclass MoveNumFunction:\n    \"\"\"Orchestrates validation, character separation, and result concatenation.\"\"\"\n    def __init__(self, validator: Validator, separator: Separator) -> None:\n        self.validator = validator\n        self.separator = separator\n\n    def execute(self, input_str: str) -> str:\n        \"\"\"Executes the number moving logic by validating, separating, and concatenating.\"\"\"\n        self.validator.validate(input_str)\n        non_digits, digits = self.separator.separate(input_str)\n        result = non_digits + digits\n        return result\n\ndef move_num(input: str) -> str:\n    \"\"\"\n    Public API function to move all digit characters to the end of a string.\n    Non-digit characters appear first, followed by digit characters, preserving\n    their original relative order within their respective groups.\n    \"\"\"\n    validator = Validator()\n    separator = Separator()\n    move_num_service = MoveNumFunction(validator, separator)\n    return move_num_service.execute(input)\n```"}
{"task_id": "Mbpp/620", "solution": "```python\nimport math\n\n# Package/import notes: This file contains domain model classes for numbers, lists, subsets,\n# divisibility relations, and results, as specified in src/domain.py.\n\nclass Number:\n    \"\"\"\n    Represents an integer value within the domain model.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def gcd(self, other: 'Number') -> int:\n        \"\"\"\n        Computes the greatest common divisor with another Number.\n        \"\"\"\n        a, b = self.value, other.value\n        while b:\n            a, b = b, a % b\n        return abs(a)\n\n    def __eq__(self, other):\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self):\n        return hash(self.value)\n\n    def __lt__(self, other):\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value < other.value\n\n    def __repr__(self):\n        return f\"Number({self.value})\"\n\nclass NumberList:\n    \"\"\"\n    A collection of Number objects.\n    \"\"\"\n    def __init__(self, numbers: list[Number]):\n        self.numbers = numbers\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the number of elements in the list.\n        \"\"\"\n        return len(self.numbers)\n\nclass Subset:\n    \"\"\"\n    Represents a subset of Number objects.\n    \"\"\"\n    def __init__(self, members: list[Number]):\n        self.members = members\n\n    def size(self) -> int:\n        \"\"\"\n        Returns the cardinality of the subset.\n        \"\"\"\n        return len(self.members)\n\n    def isPairwiseDivisible(self, div_rel: 'DivisibilityRelation') -> bool:\n        \"\"\"\n        Checks if every unordered pair (a, b) in the subset satisfies divisibility.\n        Either a divides b or b divides a.\n        \"\"\"\n        n = len(self.members)\n        if n <= 1:\n            return True\n        for i in range(n):\n            for j in range(i + 1, n):\n                a = self.members[i]\n                b = self.members[j]\n                if not (div_rel.divides(a, b) or div_rel.divides(b, a)):\n                    return False\n        return True\n\nclass DivisibilityRelation:\n    \"\"\"\n    Stateless helper encapsulating divisibility semantics.\n    \"\"\"\n    def divides(self, a: 'Number', b: 'Number') -> bool:\n        \"\"\"\n        Checks if Number 'a' divides Number 'b'.\n        Encodes BR-6: \"zero divides 0 only\"; standard integer modulo semantics otherwise.\n        - If 'a' is 0: True only if 'b' is also 0.\n        - If 'a' is not 0: True if 'b' is 0 (any non-zero divides 0), or if b % a == 0.\n        \"\"\"\n        val_a = a.value\n        val_b = b.value\n\n        if val_a == 0:\n            return val_b == 0 # \"0 divides 0 only\"\n        \n        return val_b % val_a == 0 # For non-zero 'a', check if 'b' is a multiple of 'a'\n\nclass Result:\n    \"\"\"\n    Encapsulates the final result, specifically the size of the largest subset.\n    \"\"\"\n    def __init__(self, size: int):\n        self.size = size\n\n# Module-local helper function as specified in src/largest_subset.py.\ndef _to_NumberList(numbers: list[int]) -> NumberList:\n    \"\"\"\n    Converts a list of primitive integers to a NumberList of Number objects.\n    \"\"\"\n    return NumberList([Number(n) for n in numbers])\n\n# Public API function as specified in src/largest_subset.py.\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the size of the largest subset where every unordered pair (a, b)\n    satisfies divisibility (either a divides b or b divides a).\n    \"\"\"\n    if not numbers:\n        return 0 # BR-5: Empty list returns 0.\n\n    # Convert primitive integers to domain Number objects.\n    number_list_obj = _to_NumberList(numbers)\n    number_objects = number_list_obj.numbers\n\n    # Sort numbers for dynamic programming. Sorting by absolute value primarily,\n    # then by value for ties, helps ensure that for any chain a | b, a will appear\n    # before b in the sorted list if abs(a) <= abs(b), simplifying DP checks.\n    # BR-6 implies duplicates are treated as separate elements.\n    number_objects.sort(key=lambda x: (abs(x.value), x.value))\n\n    n = len(number_objects)\n    # dp[i] will store the length of the longest divisibility chain ending with number_objects[i].\n    dp = [1] * n\n    div_rel = DivisibilityRelation()\n\n    max_size = 0 if n == 0 else 1 # Minimum size is 1 for any non-empty list\n\n    for i in range(n):\n        for j in range(i):\n            # For a divisibility chain num_j | num_i, we need div_rel.divides(num_j, num_i) to be true.\n            # Due to sorting by absolute value, if number_objects[j].value divides number_objects[i].value,\n            # then abs(number_objects[j].value) will be less than or equal to abs(number_objects[i].value).\n            # This ensures we are always extending a chain with a \"larger\" (in magnitude) number that it divides.\n            if div_rel.divides(number_objects[j], number_objects[i]):\n                dp[i] = max(dp[i], 1 + dp[j])\n        max_size = max(max_size, dp[i])\n\n    return Result(max_size).size\n```"}
{"task_id": "Mbpp/620", "solution": "```python\ndef largest_subset(nums):\n    \"\"\"\n    Finds the size of the largest divisible subset in the given list of numbers.\n    The implementation is deterministic and side-effect-free.\n    \"\"\"\n    # Check if 0 is present in the input list.\n    has_zero = 0 in nums\n    \n    # Filter out zeros and sort the remaining numbers.\n    # Zeros are handled separately as they divide any non-zero number.\n    non_zero_nums = sorted([num for num in nums if num != 0])\n\n    max_size_for_non_zero = 0\n    if non_zero_nums:\n        # _compute_pairwise_divisibility_graph builds an adjacency list\n        # where graph[i] contains indices j (j < i) such that nums[j] and nums[i]\n        # satisfy the divisibility condition.\n        predecessors_graph = _compute_pairwise_divisibility_graph(non_zero_nums)\n\n        # _find_largest_subset_size computes the max length of a divisible subset chain\n        # using dynamic programming on the sorted numbers and the predecessors graph.\n        max_size_for_non_zero = _find_largest_subset_size(non_zero_nums, predecessors_graph)\n    \n    # If 0 was in the original list, it can be included with any other divisible subset\n    # to form a larger one, as any non-zero number divides 0.\n    # If only zeros were present, a subset containing one 0 has size 1.\n    if has_zero:\n        return max_size_for_non_zero + 1\n    else:\n        return max_size_for_non_zero\n\n\ndef _compute_pairwise_divisibility_graph(nums):\n    \"\"\"\n    Builds an adjacency list where graph[i] contains indices j (j < i) such that\n    nums[j] and nums[i] are divisible (a divides b or b divides a).\n    This function assumes `nums` contains no zeros.\n    \"\"\"\n    n = len(nums)\n    # predecessors_graph[i] stores indices j (where j < i) that can precede nums[i].\n    predecessors_graph = [[] for _ in range(n)]\n\n    for i in range(n):\n        for j in range(i):  # Check all previous numbers as potential predecessors.\n            # Check if nums[i] is divisible by nums[j] OR nums[j] is divisible by nums[i].\n            if nums[i] % nums[j] == 0 or nums[j] % nums[i] == 0:\n                predecessors_graph[i].append(j)\n    return predecessors_graph\n\n\ndef _find_largest_subset_size(nums, predecessors_graph):\n    \"\"\"\n    Computes the size of the largest divisible subset using dynamic programming.\n    dp[i] stores the length of the longest divisible subset ending with nums[i].\n    \"\"\"\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    # Initialize dp values to 1, as each number itself forms a subset of size 1.\n    dp = [1] * n\n\n    # Iterate through the numbers and update dp values based on divisibility relations.\n    for i in range(n):\n        # For each j in predecessors_graph[i], nums[j] can extend to nums[i].\n        for j in predecessors_graph[i]:\n            dp[i] = max(dp[i], dp[j] + 1)\n    \n    # The maximum value in dp is the size of the longest divisible subset found.\n    return max(dp)\n```"}
{"task_id": "Mbpp/622", "solution": "```python\n# src/models.py\nfrom typing import List, Union\n\nclass SortedList:\n    \"\"\"\n    Represents a sorted list of numeric elements.\n    Elements are stored as floats.\n    \"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self._elements = elements\n        self._n = len(elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return self._n\n\n    def elements(self) -> List[float]:\n        \"\"\"Returns the list of elements.\"\"\"\n        return self._elements\n\n    def is_sorted(self) -> bool:\n        \"\"\"\n        Checks if the list is sorted in non-decreasing order.\n        (Optional validation, caller is responsible for sorted input.)\n        \"\"\"\n        if not self._elements:\n            return True\n        for i in range(1, self._n):\n            if self._elements[i] < self._elements[i-1]:\n                return False\n        return True\n\nclass NumericElement:\n    \"\"\"\n    Represents a single numeric value, stored as a float.\n    Handles conversion from int or float.\n    \"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = float(value)\n\nclass MedianResult:\n    \"\"\"\n    Encapsulates the calculated median value.\n    The median is stored as a float.\n    \"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\n```\n```python\n# src/input_validator.py\nfrom typing import Sequence, Any, Union\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"\n    Module-private helper to check if a value is numeric.\n    Supports integers and floating-point numbers.\n    \"\"\"\n    return isinstance(value, (int, float))\n\nclass InputValidator:\n    \"\"\"\n    Provides static methods for validating input lists.\n    It is stateless and raises ValueError for invalid inputs.\n    \"\"\"\n    @staticmethod\n    def validate_lengths(list1: Sequence, list2: Sequence, n: int) -> None:\n        \"\"\"\n        Validates that both lists have length n and are of equal length.\n        Raises ValueError if length conditions are not met.\n        \"\"\"\n        if not (len(list1) == n and len(list2) == n and len(list1) == len(list2)):\n            raise ValueError(\n                f\"Input lists must each contain exactly n={n} elements. \"\n                f\"Got list1 length {len(list1)} and list2 length {len(list2)}.\"\n            )\n\n    @staticmethod\n    def validate_numeric(elements: Sequence[Union[int, float]]) -> None:\n        \"\"\"\n        Validates that all elements in the given sequence are numeric.\n        Raises ValueError if any non-numeric element is found.\n        \"\"\"\n        for element in elements:\n            if not _is_numeric(element):\n                raise ValueError(f\"Non-numeric element found: {element}\")\n\n```\n```python\n# src/median_service.py\nfrom typing import Sequence, Union\nfrom src.input_validator import InputValidator\n\n# The models are imported for type hints and conceptual design,\n# though not directly instantiated in the main get_median flow for this implementation.\nfrom src.models import SortedList, NumericElement, MedianResult # type: ignore\n\ndef _median_of_two_sorted_lists(a: Sequence[float], b: Sequence[float], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists, each of length n.\n    This module-private function assumes inputs are valid and sorted floats.\n    \"\"\"\n    i = 0  # Pointer for list a\n    j = 0  # Pointer for list b\n    m1 = 0.0 # Stores the (n)-th element of the merged list\n    m2 = 0.0 # Stores the (n+1)-th element of the merged list\n\n    # Iterate n+1 times to find the two middle elements (n-th and n+1-th for 0-indexing)\n    for count in range(n + 1):\n        # Update m1 with previous m2 before finding the next element\n        m1 = m2\n\n        if i == n:\n            # List a is exhausted, take from list b\n            m2 = b[j]\n            j += 1\n        elif j == n:\n            # List b is exhausted, take from list a\n            m2 = a[i]\n            i += 1\n        elif a[i] <= b[j]:\n            # Take from list a if its current element is smaller or equal\n            m2 = a[i]\n            i += 1\n        else:\n            # Take from list b\n            m2 = b[j]\n            j += 1\n\n    return (m1 + m2) / 2.0\n\ndef get_median(list1: Sequence[Union[int,float]], list2: Sequence[Union[int,float]], n: int) -> float:\n    \"\"\"\n    Computes the median of two sorted lists of numeric elements, each of length n.\n    This public API function validates inputs and orchestrates the median calculation.\n    \"\"\"\n    # Validate input lengths and numeric types\n    InputValidator.validate_lengths(list1, list2, n)\n    InputValidator.validate_numeric(list1)\n    InputValidator.validate_numeric(list2)\n\n    # Convert all elements to floats for consistent processing in the algorithm\n    float_list1 = [float(x) for x in list1]\n    float_list2 = [float(x) for x in list2]\n\n    # Compute median using the internal algorithm\n    median_value = _median_of_two_sorted_lists(a=float_list1, b=float_list2, n=n)\n\n    return median_value\n\n```\n```python\n# src/__init__.py\n\"\"\"\nThis package provides a MedianService library with a function to find the median\nof two sorted lists of equal size.\n\"\"\"\nfrom .median_service import get_median\n\n__all__ = ['get_median']\n\n```\n```python\n# tests/test_median.py\nfrom src.median_service import get_median\n\ndef test_example_assertion() -> None:\n    \"\"\"\n    Verifies the get_median function with the example provided in the SRS.\n    Checks the median of two specific sorted lists.\n    \"\"\"\n    assert get_median([1, 12, 15, 26, 38], [2, 13, 17, 30, 45], 5) == 16.0\n\nif __name__ == '__main__':\n    # This block allows running the test directly as a script\n    test_example_assertion()\n    print(\"SRS example test passed!\")\n\n```"}
{"task_id": "Mbpp/622", "solution": "```python\ndef get_median(a, b, n):\n    \"\"\"\n    Computes the median of two sorted lists of equal length n.\n    Assumes inputs are valid: len(a) == len(b) == n, n >= 1, and lists are sorted.\n    \"\"\"\n    i = 0  # Pointer for list a\n    j = 0  # Pointer for list b\n    \n    # These will store the (n-1)-th and n-th elements (0-indexed)\n    # which correspond to the n-th and (n+1)-th smallest elements (1-indexed).\n    val_n_minus_1 = 0.0\n    val_n = 0.0\n\n    # Iterate n + 1 times to find the elements at combined indices n-1 and n.\n    for count in range(n + 1): \n        current_element = 0.0\n\n        # Determine which list provides the next smallest element, handling list exhaustion.\n        if i < n and (j >= n or a[i] <= b[j]):\n            current_element = a[i]\n            i += 1\n        else:\n            current_element = b[j]\n            j += 1\n            \n        # Store the element if it's one of the two middle elements.\n        if count == n - 1:\n            val_n_minus_1 = float(current_element)\n        if count == n:\n            val_n = float(current_element)\n            break # We found both required elements\n\n    return (val_n_minus_1 + val_n) / 2.0\n```"}
