{"task_id": "Mbpp/566", "solution": "```python\n# src/sum_digits.py\nfrom dataclasses import dataclass\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to sum_digits.\"\"\"\n    pass\n\n@dataclass\nclass Number:\n    \"\"\"Represents the input number.\"\"\"\n    value: int\n\n@dataclass\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    value: int\n    position: int = 0\n\n@dataclass\nclass Result:\n    \"\"\"Holds the computed sum of digits.\"\"\"\n    value: int\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Computes the sum of the decimal digits of a non-negative integer.\n    Raises ValidationError for negative or non-integer inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer\")\n    if n < 0:\n        raise ValidationError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    # Convert number to string to easily iterate over digits.\n    for digit_char in str(n):\n        total_sum += int(digit_char)\n\n    return total_sum\n```\n```python\n# tests/test_sum_digits.py\nimport pytest\nfrom src.sum_digits import sum_digits, ValidationError\n\ndef test_sum_digits_valid_examples():\n    \"\"\"Verifies sum_digits with various valid non-negative integers.\"\"\"\n    assert sum_digits(345) == 12\n    assert sum_digits(123) == 6\n    assert sum_digits(99) == 18\n    assert sum_digits(7) == 7\n    assert sum_digits(100) == 1\n    assert sum_digits(987654321) == 45\n\ndef test_sum_digits_zero():\n    \"\"\"Confirms sum_digits correctly returns 0 for input 0.\"\"\"\n    assert sum_digits(0) == 0\n\ndef test_sum_digits_negative_raises():\n    \"\"\"Ensures sum_digits raises ValidationError for negative inputs.\"\"\"\n    with pytest.raises(ValidationError, match=\"n must be non-negative\"):\n        sum_digits(-1)\n    with pytest.raises(ValidationError, match=\"n must be non-negative\"):\n        sum_digits(-100)\n\ndef test_sum_digits_non_integer_raises():\n    \"\"\"Checks sum_digits raises ValidationError for non-integer inputs.\"\"\"\n    with pytest.raises(ValidationError, match=\"n must be an integer\"):\n        sum_digits(\"abc\")\n    with pytest.raises(ValidationError, match=\"n must be an integer\"):\n        sum_digits(3.14)\n    with pytest.raises(ValidationError, match=\"n must be an integer\"):\n        sum_digits(None)\n    with pytest.raises(ValidationError, match=\"n must be an integer\"):\n        sum_digits([1, 2, 3])\n```"}
{"task_id": "Mbpp/567", "solution": "```python\nclass ErrorHandler:\n    \"\"\"Handles invalid input by raising a TypeError.\"\"\"\n    def handle_invalid_input(self, input_value):\n        \"\"\"Raises a TypeError for invalid input values.\"\"\"\n        raise TypeError(f\"Input must be a list, but got {type(input_value).__name__}.\")\n\nclass Result:\n    \"\"\"A lightweight carrier for a boolean outcome.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates if the input is a list-like structure.\"\"\"\n    def validate_input(self, input_list) -> bool:\n        \"\"\"Checks if the provided input is an instance of a list.\"\"\"\n        return isinstance(input_list, list)\n\nclass Comparator:\n    \"\"\"Performs single-pass pairwise comparison to check non-decreasing order.\"\"\"\n    def is_non_decreasing(self, iterable) -> bool:\n        \"\"\"Checks if elements in the iterable are in non-decreasing order.\"\"\"\n        iterator = iter(iterable)\n        try:\n            prev_element = next(iterator)\n        except StopIteration:\n            return True  # Handles empty iterables.\n\n        for curr_element in iterator:\n            if curr_element < prev_element:\n                return False\n            prev_element = curr_element\n        return True\n\nclass InputList:\n    \"\"\"A domain holder for a list of elements.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass SortChecker:\n    \"\"\"Orchestrates the sorting check logic, including validation and comparison.\"\"\"\n    def issort_list(self, input_list: list) -> bool:\n        \"\"\"Determines if the provided list is sorted in non-decreasing order.\"\"\"\n        # Create an InputList wrapper as specified by the class diagram relationship.\n        input_wrapper = InputList(input_list)\n\n        # Short-circuit for empty or single-element lists.\n        if input_wrapper.length() <= 1:\n            return Result(True).value\n\n        # Delegate to the private pairwise check method.\n        is_sorted = self._check_pairwise(input_wrapper.elements)\n        return Result(is_sorted).value\n\n    def _check_pairwise(self, iterable) -> bool:\n        \"\"\"Private helper to delegate actual pairwise comparison.\"\"\"\n        comparator = Comparator()\n        return comparator.is_non_decreasing(iterable)\n\ndef issort_list(input_list) -> bool:\n    \"\"\"\n    Checks if a given list is sorted in non-decreasing order.\n    Delegates to internal components for validation and sorting logic.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_input(input_list):\n        ErrorHandler().handle_invalid_input(input_list)\n\n    checker = SortChecker()\n    return checker.issort_list(input_list)\n```"}
