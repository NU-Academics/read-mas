{"task_id": "Mbpp/777", "solution": "```python\n# find_sum.py\n\ndef _validate_input(input_list: list) -> None:\n    \"\"\"Validates that input_list is a list and contains only integers.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a Python list.\")\n    for element in input_list:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef _extract_unique(input_list: list) -> set:\n    \"\"\"Extracts distinct integers from the input list using set semantics.\"\"\"\n    return set(input_list)\n\ndef _compute_sum(unique_set: set) -> int:\n    \"\"\"Computes the integer sum of elements in a set.\"\"\"\n    return sum(unique_set)\n\ndef find_sum(input_list: list) -> int:\n    \"\"\"\n    Validates input, extracts distinct integers, and computes their sum.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    _validate_input(input_list)\n    unique_elements = _extract_unique(input_list)\n    total_sum = _compute_sum(unique_elements)\n    return total_sum\n\n```\n```python\n# test_find_sum.py\nfrom find_sum import find_sum\n\ndef test_example_assert():\n    \"\"\"Verifies the sum of distinct elements for the provided example.\"\"\"\n    assert find_sum([1,2,3,1,1,4,5,6]) == 21\n\ndef test_empty_list():\n    \"\"\"Checks that an empty list returns a sum of 0.\"\"\"\n    assert find_sum([]) == 0\n\ndef test_invalid_types():\n    \"\"\"Ensures TypeError is raised for non-list input or non-integer elements.\"\"\"\n    # Test non-list input\n    try:\n        find_sum(\"not a list\")\n        assert False, \"Expected TypeError for non-list input\"\n    except TypeError:\n        pass\n    except Exception as e:\n        assert False, f\"Expected TypeError, but got {type(e).__name__}\"\n\n    # Test list with non-integer element\n    try:\n        find_sum([1, 2, \"three\", 4])\n        assert False, \"Expected TypeError for list with non-int element\"\n    except TypeError:\n        pass\n    except Exception as e:\n        assert False, f\"Expected TypeError, but got {type(e).__name__}\"\n\n    # Test list with float element\n    try:\n        find_sum([1, 2, 3.0, 4])\n        assert False, \"Expected TypeError for list with float element\"\n    except TypeError:\n        pass\n    except Exception as e:\n        assert False, f\"Expected TypeError, but got {type(e).__name__}\"\n\nif __name__ == \"__main__\":\n    print(\"Running tests...\")\n    test_example_assert()\n    test_empty_list()\n    test_invalid_types()\n    print(\"All tests passed!\")\n\n```"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Groups consecutive equal elements from a list into sublists.\n    Returns an empty list if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_run = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == input_list[i-1]:\n            current_run.append(input_list[i])\n        else:\n            packed_list.append(current_run)\n            current_run = [input_list[i]]\n\n    packed_list.append(current_run)\n    return packed_list"}
{"task_id": "Mbpp/778", "solution": "```python\n# src/__init__.py\n__all__ = ['pack_consecutive_duplicates']\n```\n```python\n# src/pack_function.py\nfrom typing import TypeVar, List, Sequence\n\nT = TypeVar('T')\n\ndef pack_consecutive_duplicates(input_list: Sequence[T]) -> List[List[T]]:\n    \"\"\"Return a list of groups where each group is a sublist of consecutive equal elements.\n    Empty input_list results in an empty list of groups.\n    \"\"\"\n    groups: List[List[T]] = []\n    if not input_list:\n        return groups\n\n    current_group: List[T] = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[0]:\n            current_group.append(input_list[i])\n        else:\n            groups.append(current_group)\n            current_group = [input_list[i]]\n\n    # Append the last current_group after the loop finishes\n    groups.append(current_group)\n\n    return groups\n```\n```python\n# src/__main__.py\nfrom src.pack_function import pack_consecutive_duplicates\n\ndef run_example() -> None:\n    \"\"\"Executes the SRS-provided acceptance assertion example and prints the result.\n    This function demonstrates the public API and its expected output.\n    \"\"\"\n    example_input = [0, 0, 1, 2, 3, 4, 4, 5, 6, 6, 6, 7, 8, 9, 4, 4]\n    expected_output = [[0, 0], [1], [2], [3], [4, 4], [5], [6, 6, 6], [7], [8], [9], [4, 4]]\n    \n    result = pack_consecutive_duplicates(example_input)\n    \n    print(f\"Input: {example_input}\")\n    print(f\"Result: {result}\")\n    print(f\"Expected: {expected_output}\")\n    assert result == expected_output\n    print(\"Acceptance assertion passed!\")\n\nif __name__ == \"__main__\":\n    run_example()\n```\n```python\n# tests/test_pack_consecutive_duplicates.py\nfrom src.pack_function import pack_consecutive_duplicates\n\ndef test_pack_consecutive_duplicates_example() -> None:\n    \"\"\"Verifies the pack_consecutive_duplicates function against the SRS-provided acceptance assertion.\n    This automated test ensures the core functionality behaves as specified.\n    \"\"\"\n    example_input = [0, 0, 1, 2, 3, 4, 4, 5, 6, 6, 6, 7, 8, 9, 4, 4]\n    expected_output = [[0, 0], [1], [2], [3], [4, 4], [5], [6, 6, 6], [7], [8], [9], [4, 4]]\n    \n    assert pack_consecutive_duplicates(example_input) == expected_output\n```"}
{"task_id": "Mbpp/780", "solution": "```python\n# src/models.py\nfrom typing import NamedTuple\n\nclass TupleItem(NamedTuple):\n    \"\"\"Represents a 2-element integer tuple from the input list.\"\"\"\n    first: int\n    second: int\n\nclass TuplePairSum(NamedTuple):\n    \"\"\"Represents the sum of a pair of TupleItems, along with their original indices.\"\"\"\n    sum_first: int\n    sum_second: int\n    index_i: int\n    index_j: int\n```\n```python\n# src/validator.py\nfrom typing import Any, List, Tuple\n\ndef _is_two_int_tuple(obj: Any) -> bool:\n    \"\"\"Checks if an object is a 2-element tuple where both elements are integers.\"\"\"\n    return (isinstance(obj, tuple) and\n            len(obj) == 2 and\n            isinstance(obj[0], int) and\n            isinstance(obj[1], int))\n\nclass InputValidator:\n    \"\"\"Validates the input list for the find_combinations function.\"\"\"\n    @staticmethod\n    def validate(tuple_list: List[Tuple[int, int]]) -> None:\n        \"\"\"\n        Validates the input `tuple_list` against design requirements.\n        Raises TypeError for invalid inputs.\n        \"\"\"\n        if not isinstance(tuple_list, list):\n            raise TypeError('Input must be a list.')\n\n        for i, item in enumerate(tuple_list):\n            if not _is_two_int_tuple(item):\n                raise TypeError(f'List element at index {i} must be a 2-element integer tuple.')\n\n```\n```python\n# src/find_combinations.py\nfrom typing import List, Tuple\nfrom src.validator import InputValidator\nfrom src.models import TupleItem, TuplePairSum # Imported as per design for conceptual consumption/creation\n\ndef find_combinations(tuple_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Computes element-wise sums for all unique unordered pairs of 2-element integer tuples.\n    Returns results in deterministic order, validated by InputValidator.\n    \"\"\"\n    InputValidator.validate(tuple_list)\n\n    n = len(tuple_list)\n    if n < 2:\n        return []\n\n    results: List[Tuple[int, int]] = []\n    # Iterate through unique unordered pairs (i, j) where i < j\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            # Consume TupleItem models as per design\n            item_i = TupleItem(tuple_list[i][0], tuple_list[i][1])\n            item_j = TupleItem(tuple_list[j][0], tuple_list[j][1])\n\n            # Compute element-wise sums\n            sum_first = item_i.first + item_j.first\n            sum_second = item_i.second + item_j.second\n\n            # Create TuplePairSum object internally, as per design, though not returned directly\n            # tuple_pair_sum = TuplePairSum(sum_first, sum_second, i, j) \n\n            # Append the result as a 2-element tuple to the results list\n            results.append((sum_first, sum_second))\n\n    return results\n\n```"}
{"task_id": "Mbpp/780", "solution": "```python\ndef find_combinations(tuple_list):\n    \"\"\"\n    Computes element-wise sums for unique unordered pairs in a list of 2-element tuples.\n    Returns a list of summed 2-element tuples in lexicographical order of input indices.\n    \"\"\"\n    n = len(tuple_list)\n    result = []\n    for i in range(n - 1):\n        a_i, b_i = tuple_list[i]\n        for j in range(i + 1, n):\n            a_j, b_j = tuple_list[j]\n            result.append((a_i + a_j, b_i + b_j))\n    return result\n```"}
{"task_id": "Mbpp/781", "solution": "```python\n# src/count_divisors.py\nimport math\n\ndef count_divisors(n):\n    \"\"\"\n    Counts positive integer divisors of n and returns True if the count is even, False otherwise.\n    This implementation efficiently checks divisors up to sqrt(n).\n    \"\"\"\n    count = 0\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count % 2 == 0\n```\n\n```python\n# tests/test_count_divisors.py\nfrom src.count_divisors import count_divisors\n\ndef test_assert_count_divisors_10():\n    \"\"\"\n    Acceptance test verifying count_divisors(10) returns True.\n    This validates the core requirement for the specified input.\n    \"\"\"\n    assert count_divisors(10)\n```"}
{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef _count_positive_divisors(n: int) -> int:\n    \"\"\"Counts positive divisors of n efficiently.\n    Iterates up to the square root of n to find divisor pairs.\"\"\"\n    count = 0\n    for i in range(1, math.isqrt(n) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for n is even.\n    Assumes n is a positive integer as per critical requirements.\"\"\"\n    divisor_count = _count_positive_divisors(n)\n    return divisor_count % 2 == 0\n```"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr):\n    \"\"\"\n    Computes the sum of all elements of every contiguous odd-length subarray.\n    Handles an empty list by returning 0.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for start in range(n):\n        for end in range(start, n):\n            length = end - start + 1\n            if length % 2 == 1:\n                # This subarray has an odd length.\n                subarray_sum = sum(arr[start : end + 1])\n                total_sum += subarray_sum\n\n    return total_sum\n```"}
{"task_id": "Mbpp/782", "solution": "```python\n# src/odd_length_sum.py\n\ndef _odd_length_subarrays(input_list):\n    \"\"\"Module-private helper: yields all contiguous odd-length subarrays from the input list.\"\"\"\n    n = len(input_list)\n    for length in range(1, n + 1, 2):  # Iterate over odd lengths (1, 3, 5, ...)\n        for i in range(n - length + 1):  # Iterate over all possible start indices\n            yield input_list[i : i + length]\n\ndef odd_length_sum(input_list):\n    \"\"\"Public API: accepts a list of integers and returns int sum of all odd-length contiguous subarrays.\"\"\"\n    total_sum = 0\n    for subarray in _odd_length_subarrays(input_list):\n        total_sum += sum(subarray)\n    return total_sum\n\nif __name__ == \"__main__\":\n    # Demonstration guarded by __main__, prints a sample result.\n    sample = [1, 2, 4]\n    print(odd_length_sum(sample)) # Expected output: 14\n\n```\n```python\n# tests/test_odd_length_sum.py\n\nfrom src.odd_length_sum import odd_length_sum\n\ndef test_example_assertion():\n    \"\"\"Contains the required assertion to validate odd_length_sum with example input.\"\"\"\n    assert odd_length_sum([1,2,4]) == 14\n\n```"}
{"task_id": "Mbpp/784", "solution": "```python\n# src/models.py\nfrom typing import List\n\nclass InputList:\n    \"\"\"Encapsulates an ordered collection of numeric elements for typed interactions.\"\"\"\n    elements: List[int]\n\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\nclass Number:\n    \"\"\"Represents a single numeric element with convenience parity checks.\"\"\"\n    value: int\n\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass ProductResult:\n    \"\"\"Encapsulates the integer product result returned by mul_even_odd.\"\"\"\n    value: int\n\n    def __init__(self, value: int) -> None:\n        self.value = value\n```\n```python\n# src/finders.py\nfrom src.models import InputList, Number\n\nclass OddNumberFinder:\n    \"\"\"Scans an InputList left-to-right and returns the first Number with isOdd() true.\"\"\"\n    def findFirst(self, list: InputList) -> Number:\n        \"\"\"Iterates InputList elements and returns the first odd Number found.\"\"\"\n        for element_value in list.elements:\n            num = Number(element_value)\n            if num.isOdd():\n                return num\n\nclass EvenNumberFinder:\n    \"\"\"Scans an InputList left-to-right and returns the first Number with isEven() true.\"\"\"\n    def findFirst(self, list: InputList) -> Number:\n        \"\"\"Iterates InputList elements and returns the first even Number found.\"\"\"\n        for element_value in list.elements:\n            num = Number(element_value)\n            if num.isEven():\n                return num\n```\n```python\n# src/mul_even_odd.py\nfrom src.finders import OddNumberFinder, EvenNumberFinder\nfrom src.models import InputList, ProductResult\n\ndef mul_even_odd(list) -> int:\n    \"\"\"\n    Accepts a list, locates the first odd and first even elements, and returns their integer product.\n    This function coordinates finders and encapsulates the result.\n    \"\"\"\n    input_list = InputList(list)\n    odd = OddNumberFinder().findFirst(input_list)\n    even = EvenNumberFinder().findFirst(input_list)\n    result = ProductResult(odd.value * even.value)\n    return result.value\n```\n```python\n# tests/test_mul_even_odd.py\nfrom src.mul_even_odd import mul_even_odd\n\ndef test_example_mul_even_odd():\n    \"\"\"Verifies the example acceptance criterion for mul_even_odd.\"\"\"\n    assert mul_even_odd([1,3,5,7,4,1,6,8]) == 4\n```"}
{"task_id": "Mbpp/784", "solution": "```python\n__all__ = ['mul_even_odd']\n\ndef _is_even(value: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return (value % 2) == 0\n\ndef _is_odd(value: int) -> bool:\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return (value % 2) != 0\n\ndef mul_even_odd(input_list: list) -> int:\n    \"\"\"Return product of first odd and first even integer in index order.\n    Raises ValueError if list lacks at least one odd or at least one even integer.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for element in input_list:\n        if first_odd is None and _is_odd(element):\n            first_odd = element\n        if first_even is None and _is_even(element):\n            first_even = element\n\n        # Break early if both parities are found to optimize traversal.\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None or first_even is None:\n        raise ValueError('missing odd or even integer')\n    else:\n        return first_odd * first_even\n```"}
{"task_id": "Mbpp/785", "solution": "```python\nclass TupleString:\n    \"\"\"Represents the raw input string supplied to the parser.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\nclass Integer:\n    \"\"\"Represents a parsed integer token.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass IntegerTuple:\n    \"\"\"Represents the ordered collection of integers produced by the parser.\"\"\"\n    def __init__(self, elements: tuple[int, ...]):\n        self.elements = elements\n\n    def as_tuple(self) -> tuple[int, ...]:\n        \"\"\"Returns the elements as a native Python tuple.\"\"\"\n        return self.elements\n\nclass TupleParser:\n    \"\"\"Encapsulates parsing logic for parenthesized, comma-separated decimal integers.\"\"\"\n    def tuple_str_int(self, input_str: str) -> tuple[int, ...]:\n        \"\"\"Parses the input string into a tuple of integers.\"\"\"\n        tuple_string = TupleString(input_str)\n\n        # Remove outer parentheses. Trust input format, no explicit error handling for malformed strings.\n        trimmed_content = tuple_string.raw.strip()\n        \n        # Extract content within parentheses.\n        inner_str = trimmed_content[1:-1]\n\n        if not inner_str.strip(): # Handles \"()\" or \"(  )\"\n            return IntegerTuple(()).as_tuple()\n\n        str_tokens = inner_str.split(',')\n        integer_values = []\n        for token_str in str_tokens:\n            stripped_token = token_str.strip()\n            # Parse int. Trust inputs, no exception handling for invalid numeric tokens.\n            parsed_integer_value = int(stripped_token)\n            integer_values.append(parsed_integer_value)\n\n        # Aggregate into IntegerTuple and return its native tuple form.\n        return IntegerTuple(tuple(integer_values)).as_tuple()\n\ndef tuple_str_int(input: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a parenthesized, comma-separated decimal integer string\n    into an ordered tuple of integers.\n    \"\"\"\n    parser = TupleParser()\n    return parser.tuple_str_int(input)\n```"}
{"task_id": "Mbpp/785", "solution": "```python\nfrom typing import List\n\nclass ParseError(Exception):\n    \"\"\"Domain container for structured parse error messages.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass InputString:\n    \"\"\"Represents and operates on raw input string; provides trimmed version.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n    \n    def strip(self) -> str:\n        \"\"\"Returns the raw input string with leading/trailing whitespace removed.\"\"\"\n        return self.raw.strip()\n\nclass TupleStringParser:\n    \"\"\"Validates outer parentheses format and extracts element text tokens.\"\"\"\n    def __init__(self, input: str):\n        self.input = input\n    \n    def validate_format(self) -> bool:\n        \"\"\"Checks for correct outer parentheses and absence of inner ones.\"\"\"\n        if not self.input.startswith('(') or not self.input.endswith(')'):\n            return False\n        \n        inner_content = self.input[1:-1]\n        if '(' in inner_content or ')' in inner_content:\n            return False\n        \n        return True\n    \n    def extract_elements(self) -> List[str]:\n        \"\"\"Removes parentheses and splits inner content on commas to get elements.\"\"\"\n        if self.input == '()':\n            return []\n        \n        inner_content = self.input[1:-1]\n        return inner_content.split(',')\n\nclass IntegerConverter:\n    \"\"\"Converts trimmed element strings into integers.\"\"\"\n    def __init__(self, elements: List[str]):\n        self.elements = elements\n    \n    def to_integers(self) -> List[int]:\n        \"\"\"Converts each element, trimming whitespace, or raises ParseError.\"\"\"\n        converted_integers = []\n        for element_str in self.elements:\n            trimmed_element = element_str.strip()\n            if not trimmed_element:\n                raise ParseError(\"Cannot convert empty string to integer.\")\n            try:\n                converted_integers.append(int(trimmed_element))\n            except ValueError:\n                raise ParseError(f\"Could not convert '{element_str}' to an integer.\")\n        return converted_integers\n\nclass TupleFactory:\n    \"\"\"Aggregates integer values into a Python tuple.\"\"\"\n    def __init__(self, integers: List[int]):\n        self.integers = integers\n    \n    def create_tuple(self) -> tuple:\n        \"\"\"Creates a tuple from the list of integers, preserving order.\"\"\"\n        return tuple(self.integers)\n\ndef tuple_str_int(input_str: str) -> tuple:\n    \"\"\"Converts a tuple-formatted string into a Python tuple of integers.\"\"\"\n    inp = InputString(input_str)\n    trimmed = inp.strip()\n\n    parser = TupleStringParser(trimmed)\n    if not parser.validate_format():\n        raise ValueError('invalid tuple format')\n    elements = parser.extract_elements()\n\n    converter = IntegerConverter(elements)\n    try:\n        integers = converter.to_integers()\n    except ParseError as pe:\n        raise ValueError(pe.message)\n\n    factory = TupleFactory(integers)\n    return factory.create_tuple()\n```"}
