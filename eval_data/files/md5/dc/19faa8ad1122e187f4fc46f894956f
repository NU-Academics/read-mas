'white'], ['black', 'orange', 'white']]\n    assert sort_sublists(input_data) == expected_output\n\ndef test_type_error_on_non_string() -> None:\n    \"\"\"Asserts that a TypeError is raised when a non-string element is encountered.\n    This test verifies the fail-fast validation behavior.\n    \"\"\"\n    # Test with an integer\n    try:\n        sort_sublists([['a', 1]])\n        assert False, \"TypeError was expected for integer but not raised.\"\n    except TypeError:\n        pass # Expected behavior\n\n    # Test with None\n    try:\n        sort_sublists([['hello'], ['world', None]])\n        assert False, \"TypeError was expected for None but not raised.\"\n    except TypeError:\n        pass # Expected behavior\n\n    # Test with a float in an empty sublist context (still raises fail-fast)\n    try:\n        sort_sublists([[], ['data', 3.14]])\n        assert False, \"TypeError was expected for float but not raised.\"\n    except TypeError:\n        pass # Expected behavior\n\n```"}
