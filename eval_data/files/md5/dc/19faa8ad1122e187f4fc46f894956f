{"task_id": "Mbpp/233", "solution": "```python\nimport math\n\nclass InputValidator:\n    \"\"\"\n    Validates if a given value is a supported numeric type (int or float).\n    This class is stateless.\n    \"\"\"\n    @staticmethod\n    def isNumeric(value) -> bool:\n        \"\"\"Returns True if value is an int or float, False otherwise.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, complex)\n\nclass MathService:\n    \"\"\"\n    Encapsulates mathematical constants and computations for surface area.\n    It holds the value of pi and the lateral surface area formula.\n    \"\"\"\n    def __init__(self):\n        self.pi: float = math.pi\n\n    def computeLateralSurfaceArea(self, height: float, radius: float) -> float:\n        \"\"\"Computes and returns the lateral surface area of a cylinder.\"\"\"\n        return 2 * self.pi * radius * height\n\nclass Cylinder:\n    \"\"\"\n    Represents a cylinder domain entity with height and radius.\n    It delegates the actual surface area computation to MathService.\n    \"\"\"\n    def __init__(self, height: float, radius: float):\n        self.height: float = float(height)\n        self.radius: float = float(radius)\n        self.lateralSurfaceArea: float = None\n\n    def computeLateralSurfaceArea(self) -> float:\n        \"\"\"\n        Computes the lateral surface area using MathService\n        and stores the result.\n        \"\"\"\n        math_service = MathService()\n        self.lateralSurfaceArea = math_service.computeLateralSurfaceArea(self.height, self.radius)\n        return self.lateralSurfaceArea\n\nclass FunctionSignature:\n    \"\"\"\n    Data holder for documenting function name and parameter signature.\n    Used for traceability and reference.\n    \"\"\"\n    def __init__(self, name: str, parameters: str):\n        self.name: str = name\n        self.parameters: str = parameters\n\n# Documenting the public API function as per design specification.\n_lateralsuface_cylinder_signature = FunctionSignature(\n    name=\"lateralsuface_cylinder\",\n    parameters=\"(height, radius)\"\n)\n\ndef lateralsuface_cylinder(height, radius) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    It validates inputs, constructs a Cylinder object, and computes the area.\n    \"\"\"\n    # Validate inputs using InputValidator as specified.\n    # The design leaves specific handling of non-numeric inputs undefined.\n    InputValidator.isNumeric(height)\n    InputValidator.isNumeric(radius)\n\n    # Construct the Cylinder domain entity.\n    cylinder = Cylinder(height, radius)\n\n    # Compute the lateral surface area via the Cylinder object.\n    area = cylinder.computeLateralSurfaceArea()\n\n    # Return the computed float result.\n    return area\n```"}
{"task_id": "Mbpp/234", "solution": "To implement the design specification, the following files will be generated:\n\n```python\n# src/numeric_validator.py\nimport math\n\ndef is_numeric(x) -> bool:\n    \"\"\"Checks if x is an int or a finite float.\n    Returns True for ints and finite floats, False otherwise (e.g., NaN, Infinity).\n    \"\"\"\n    if isinstance(x, int):\n        return True\n    if isinstance(x, float):\n        return math.isfinite(x)\n    return False\n\n```\n\n```python\n# src/cube.py\nclass Cube:\n    \"\"\"Represents a cube with a given side length.\n    Provides a method to calculate its volume.\n    \"\"\"\n    def __init__(self, side_length: float) -> None:\n        \"\"\"Initializes a Cube instance with the specified side length.\"\"\"\n        self.side_length = side_length\n\n    def volume(self) -> float:\n        \"\"\"Calculates and returns the volume of the cube.\"\"\"\n        return self.side_length ** 3\n\n```\n\n```python\n# src/volume_calculator.py\nfrom src.numeric_validator import is_numeric\nfrom src.cube import Cube\n\ndef volume_cube(side_length: float) -> float:\n    \"\"\"Calculates the volume of a cube given its side length.\n    Validates input and uses the Cube domain class for computation.\n    \"\"\"\n    if not is_numeric(side_length):\n        raise TypeError(\"side_length must be a numeric (int or finite float) value.\")\n    \n    cube_instance = Cube(side_length)\n    return cube_instance.volume()\n\n```\n\n```python\n# src/__init__.py\nfrom .volume_calculator import volume_cube\n__all__ = ['volume_cube']\n\n```\n\n```python\n# tests/test_volume.py\nfrom src.volume_calculator import volume_cube\n\ndef assert_volume() -> None:\n    \"\"\"Executes the primary unit test assertion for volume_cube.\n    It verifies that volume_cube(3) correctly returns 27.\n    \"\"\"\n    assert volume_cube(3) == 27\n\nif __name__ == '__main__':\n    assert_volume()\n    print('Test for volume_cube(3) passed successfully.')\n\n```"}
{"task_id": "Mbpp/235", "solution": "To implement the software design specification, I will generate two Python files: `src/even_bit_set_number.py` and `tests/test_even_bit_set_number.py`.\n\n```python\n# src/even_bit_set_number.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputNumber:\n    \"\"\"Holds the input integer value for a function invocation.\"\"\"\n    value: int\n\n@dataclass\nclass ResultNumber:\n    \"\"\"Holds the resulting integer value returned by the function.\"\"\"\n    value: int\n\nclass BitMask:\n    \"\"\"Generates and applies an integer mask to set even-positioned bits.\"\"\"\n    mask: int\n\n    def __init__(self, mask: int):\n        \"\"\"Initializes the BitMask with a pre-generated mask.\"\"\"\n        self.mask = mask\n\n    @staticmethod\n    def generate_mask(bit_length: int) -> int:\n        \"\"\"\n        Generates a mask with bits set at even positions (1-based: 2, 4, 6...).\n        The mask is generated up to the specified bit_length.\n        \"\"\"\n        mask = 0\n        # Iterate through 0-based indices corresponding to 1-based even positions.\n        # (1-based positions 2, 4, 6, ... correspond to 0-based indices 1, 3, 5, ...)\n        for i in range(1, bit_length, 2):\n            mask |= (1 << i)\n        return mask\n\n    def apply_mask(self, value: int) -> int:\n        \"\"\"Returns the input value with its even-positioned bits set to 1.\"\"\"\n        return value | self.mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Public API function to set all even-positioned bits of an integer to 1.\n    Odd-positioned bits of the input number are preserved.\n    \"\"\"\n    input_num = InputNumber(value=n)\n    \n    # Determine the significant bit length of the input number.\n    # If n is 0, bit_length() returns 0, leading to a mask of 0.\n    bit_length = input_num.value.bit_length()\n\n    generated_mask_value = BitMask.generate_mask(bit_length)\n    bit_mask_instance = BitMask(mask=generated_mask_value)\n    \n    masked_value = bit_mask_instance.apply_mask(input_num.value)\n    \n    result_num = ResultNumber(value=masked_value)\n    return result_num.value\n\n```\n```python\n# tests/test_even_bit_set_number.py\nfrom src.even_bit_set_number import even_bit_set_number\n\nclass TestAssertion:\n    \"\"\"A helper class to encapsulate and run a specific assertion string.\"\"\"\n    expression: str\n\n    def __init__(self, expression: str):\n        \"\"\"Initializes the assertion with a string expression.\"\"\"\n        self.expression = expression\n\n    def run(self) -> None:\n        \"\"\"Executes the assertion defined by the expression string.\"\"\"\n        # eval() evaluates the boolean expression, and assert uses its result.\n        assert eval(self.expression)\n\ndef run_assertion() -> None:\n    \"\"\"\n    Executes the required test assertion directly and using the TestAssertion helper.\n    Ensures even_bit_set_number(10) correctly returns 10.\n    \"\"\"\n    # Direct assertion as specified\n    assert even_bit_set_number(10) == 10\n\n    # Assertion using the TestAssertion helper\n    test_assertion_helper = TestAssertion(\"even_bit_set_number(10) == 10\")\n    test_assertion_helper.run()\n\n    print(\"All assertions passed for even_bit_set_number(10) == 10.\")\n\n# To run the test, you would typically execute this file, e.g., via `python tests/test_even_bit_set_number.py`\nif __name__ == \"__main__\":\n    run_assertion()\n\n```"}
{"task_id": "Mbpp/235", "solution": "```python\ndef highest_bit_position(n: int) -> int:\n    \"\"\"Computes the highest 1-based bit position to consider for mask generation.\n    Returns 2 for n == 0, otherwise n.bit_length().\"\"\"\n    if n == 0:\n        return 2\n    return n.bit_length()\n\ndef generate_even_bit_mask(up_to_bit: int) -> int:\n    \"\"\"Generates an integer mask with even bits (1-based positions 2, 4, 6, ...) set to 1.\n    The mask covers bit positions up to the specified 'up_to_bit' value.\"\"\"\n    mask = 0\n    for bit_pos in range(2, up_to_bit + 1, 2):\n        mask |= (1 << (bit_pos - 1))\n    return mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Sets all even bit positions in a non-negative integer 'n' to 1 while preserving odd bits.\n    This function orchestrates helper calls to determine the mask and apply it.\"\"\"\n    # Input validation, as specified in the design, is omitted due to CRITICAL REQUIREMENTS.\n    up_to_bit = highest_bit_position(n)\n    mask = generate_even_bit_mask(up_to_bit)\n    return n | mask\n```"}
