{"task_id": "Mbpp/462", "solution": "```python\n# src/combinations.py\nfrom typing import Any, List\n\nclass InputList:\n    \"\"\"Represents the ordered input list for combination generation.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input list.\"\"\"\n        return len(self.elements)\n\nclass Element:\n    \"\"\"Represents a single element with its value and original index.\"\"\"\n    def __init__(self, value: Any, index: int):\n        self.value = value\n        self.index = index\n\nclass Combination:\n    \"\"\"Represents a generated subset, including its elements and the mask that created it.\"\"\"\n    def __init__(self, elements: List[Any], mask: int):\n        self.elements = elements\n        self.mask = mask\n\nclass CombinationGenerator:\n    \"\"\"Generates all combinations of a list using bitmask iteration.\"\"\"\n    def combinations_list(self, input_list: List[Any]) -> List[List[Any]]:\n        \"\"\"Computes all 2^n combinations for the given input list.\"\"\"\n        n = len(input_list)\n        total = 1 << n  # Equivalent to 2**n\n        result: List[List[Any]] = []\n        for i in range(total):\n            combo = self.build_from_mask(i, input_list)\n            result.append(combo.elements)\n        return result\n\n    def build_from_mask(self, mask: int, input_list: List[Any]) -> Combination:\n        \"\"\"Builds a single combination from a given mask, ordering elements by descending input index.\"\"\"\n        n = len(input_list)\n        elements = []\n        for j in range(n - 1, -1, -1):  # Iterate from highest index down to 0\n            if (mask >> j) & 1:\n                elements.append(input_list[j])\n        return Combination(elements=elements, mask=mask)\n\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"Fa\u00e7ade API to generate all combinations for the given input list.\"\"\"\n    # Type validation is omitted as per critical requirement.\n    return CombinationGenerator().combinations_list(input_list)\n\n```\n```python\n# src/assertion_test.py\nfrom typing import List, Any\nfrom src.combinations import combinations_list\n\ndef _expected_for_orange_red_green_blue() -> List[List[Any]]:\n    \"\"\"Helper function to construct the exact expected list for the FR6 sample assertion.\"\"\"\n    return [\n        [],\n        ['orange'],\n        ['red'],\n        ['red', 'orange'],\n        ['green'],\n        ['green', 'orange'],\n        ['green', 'red'],\n        ['green', 'red', 'orange'],\n        ['blue'],\n        ['blue', 'orange'],\n        ['blue', 'red'],\n        ['blue', 'red', 'orange'],\n        ['blue', 'green'],\n        ['blue', 'green', 'orange'],\n        ['blue', 'green', 'red'],\n        ['blue', 'green', 'red', 'orange']\n    ]\n\nclass AssertionTest:\n    \"\"\"Provides methods to run specific assertion tests, including the FR6 example.\"\"\"\n    def run_example_assertion(self) -> bool:\n        \"\"\"Executes the sample assertion for ['orange', 'red', 'green', 'blue'] and verifies the output.\"\"\"\n        sample = ['orange', 'red', 'green', 'blue']\n        actual = combinations_list(sample)\n        expected = _expected_for_orange_red_green_blue()\n        assert actual == expected, \"AssertionTest failed: Actual output does not match expected.\"\n        return True\n\n```\n```python\n# src/main.py\nfrom src.assertion_test import AssertionTest\n\ndef main() -> int:\n    \"\"\"Main entry point to run the example assertion and print the result.\"\"\"\n    try:\n        if AssertionTest().run_example_assertion():\n            print(\"AssertionTest.run_example_assertion() PASSED.\")\n            return 0\n    except AssertionError as e:\n        print(f\"AssertionTest.run_example_assertion() FAILED: {e}\")\n        return 1\n    return 1 # Should not be reached if assertion passes or fails with AssertionError\n\nif __name__ == '__main__':\n    exit(main())\n\n```"}
{"task_id": "Mbpp/463", "solution": "```python\ndef max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Computes the maximum product of any contiguous subarray within the given integer array.\n    Handles positive, negative, and zero numbers, and single-element arrays correctly.\n    \"\"\"\n    if not arr:\n        # Per the design, input validation is handled upstream and 'arr' is expected\n        # to be an array of integers. Assuming non-empty for standard algorithm.\n        # If an empty array is strictly allowed by caller, a specific return value (e.g., 0)\n        # would need to be defined, but not specified in design for this edge.\n        return 0 \n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    overall_max = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n        \n        # Store max_so_far before it's potentially updated for the current element\n        temp_max_so_far = max_so_far\n\n        # Current maximum product could be the number itself, or num * (previous max_so_far), or num * (previous min_so_far)\n        max_so_far = max(num, num * temp_max_so_far, num * min_so_far)\n        \n        # Current minimum product could be the number itself, or num * (previous max_so_far), or num * (previous min_so_far)\n        min_so_far = min(num, num * temp_max_so_far, num * min_so_far)\n        \n        overall_max = max(overall_max, max_so_far)\n        \n    return overall_max\n```"}
