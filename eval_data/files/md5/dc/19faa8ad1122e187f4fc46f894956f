{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Return the largest power of two (2^k) such that 2^k <= n.\n    This function processes positive integers to find the highest power of 2.\"\"\"\n    \n    power = 1\n    while (power << 1) <= n:\n        power = power << 1\n    return power"}
{"task_id": "Mbpp/311", "solution": "```python\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Scans bits from MSB to LSB, sets the first encountered 0 bit to 1, and returns the result.\n    If no unset bit is found, the original integer n is returned.\"\"\"\n    if n == 0:\n        return 1\n\n    length = n.bit_length()\n\n    for pos in range(length - 1, -1, -1):\n        if (n >> pos) & 1 == 0:\n            return n | (1 << pos)\n\n    return n\n```"}
{"task_id": "Mbpp/311", "solution": "```python\n# src/__init__.py\n\"\"\"Package for bit manipulation library.\"\"\"\nfrom .bit_manipulator import set_left_most_unset_bit\n```\n\n```python\n# src/models.py\nfrom typing import TYPE_CHECKING, List\n\nif TYPE_CHECKING:\n    from src.binary_representation import BinaryRepresentation\n\n\"\"\"Domain models for integer input and result.\"\"\"\nclass IntegerInput:\n    \"\"\"Encapsulates an input integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\n    def toBinary(self) -> 'BinaryRepresentation':\n        \"\"\"Converts the integer value to its minimal binary representation.\"\"\"\n        from src.binary_representation import bits_from_int, BinaryRepresentation\n        bits = bits_from_int(self.value)\n        return BinaryRepresentation(bits)\n\n\nclass Result:\n    \"\"\"Wrapper for the final integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\n```\n\n```python\n# src/binary_representation.py\nfrom typing import List, Optional\n\n\"\"\"Handles binary representation and bit-level operations.\"\"\"\nclass BinaryRepresentation:\n    \"\"\"Encapsulates a list of bits, MSB-first.\"\"\"\n    def __init__(self, bits: List[int]):\n        self.bits: List[int] = bits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of bits in the representation.\"\"\"\n        return len(self.bits)\n\n    def leftMostUnsetIndex(self) -> Optional[int]:\n        \"\"\"Finds the index of the left-most unset bit (0).\"\"\"\n        for i, bit in enumerate(self.bits):\n            if bit == 0:\n                return i\n        return None\n\n    def setBit(self, index: int) -> 'BinaryRepresentation':\n        \"\"\"Returns a new BinaryRepresentation with the bit at index set to 1.\"\"\"\n        if not (0 <= index < len(self.bits)):\n            raise IndexError(\"Bit index out of bounds.\")\n        new_bits = list(self.bits)\n        new_bits[index] = 1\n        return BinaryRepresentation(new_bits)\n\n\ndef bits_from_int(n: int) -> List[int]:\n    \"\"\"Converts an integer to its minimal binary representation as a list of bits.\"\"\"\n    if n == 0:\n        return [0]\n    binary_string = bin(n)[2:]\n    return [int(bit_char) for bit_char in binary_string]\n\n\ndef int_from_bits(bits: List[int]) -> int:\n    \"\"\"Converts a list of bits (MSB-first) to an integer.\"\"\"\n    if not bits:\n        return 0 # An empty list of bits represents 0\n    binary_string = \"\".join(str(bit) for bit in bits)\n    return int(binary_string, 2)\n\n```\n\n```python\n# src/bit_manipulator.py\n\"\"\"Public API for setting the left-most unset bit.\"\"\"\nfrom src.models import IntegerInput, Result\nfrom src.binary_representation import BinaryRepresentation, bits_from_int, int_from_bits\n\n\nclass BitManipulator:\n    \"\"\"Orchestrates the process of setting the left-most unset bit.\"\"\"\n    def set_left_most_unset_bit(self, n: int) -> int:\n        \"\"\"Sets the left-most unset bit in an integer and returns the new integer.\"\"\"\n        if n < 0:\n            raise ValueError(\"negative integers are not supported by set_left_most_unset_bit\")\n\n        integer_input = IntegerInput(n)\n        binary_rep = integer_input.toBinary()\n\n        unset_idx = binary_rep.leftMostUnsetIndex()\n\n        if unset_idx is None:\n            raise ValueError(\"input has no unset bit in minimal representation\")\n\n        modified_binary_rep = binary_rep.setBit(unset_idx)\n        result_int = int_from_bits(modified_binary_rep.bits)\n        return result_int\n\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Public API function to set the left-most unset bit of an integer.\"\"\"\n    manipulator = BitManipulator()\n    return manipulator.set_left_most_unset_bit(n)\n\n```\n\n```python\n# tests/test_set_left_most_unset_bit.py\n\"\"\"Unit tests for the set_left_most_unset_bit function.\"\"\"\nimport pytest\nfrom src.bit_manipulator import set_left_most_unset_bit\n\n\ndef test_example_assertion():\n    \"\"\"Verifies the example assertion: set_left_most_unset_bit(10) == 14.\"\"\"\n    assert set_left_most_unset_bit(10) == 14\n\n\ndef test_zero():\n    \"\"\"Checks the behavior for input n=0.\"\"\"\n    assert set_left_most_unset_bit(0) == 1\n\n\ndef test_all_ones_raises():\n    \"\"\"Ensures a ValueError is raised for integers with no unset bits.\"\"\"\n    with pytest.raises(ValueError):\n        set_left_most_unset_bit(7)  # 7 == 111\n\n\ndef test_negative_raises():\n    \"\"\"Ensures a ValueError is raised for negative input integers.\"\"\"\n    with pytest.raises(ValueError):\n        set_left_most_unset_bit(-1)\n\n```"}
