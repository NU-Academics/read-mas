{"task_id": "Mbpp/269", "solution": "```python\n# src/__init__.py\n\"\"\"\nPackage marker for the ascii_value module.\n\"\"\"\n\n# src/errors.py\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input to ascii_value.\n    Stores a message describing the validation failure.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n# src/ascii_value.py\nfrom typing import Any\nfrom .errors import ValidationError\n\ndef ascii_value(character: str) -> int:\n    \"\"\"\n    Validate that `character` is a single-character string and return its ASCII code as an int.\n\n    Raises:\n      ValidationError: if `character` is not a string of length 1.\n    \"\"\"\n    if not isinstance(character, str):\n        raise ValidationError(\"Input must be a string of length 1\")\n    if len(character) != 1:\n        raise ValidationError(\"Input must be a single character\")\n    return ord(character)\n\n# tests/test_ascii_value.py\nfrom src.ascii_value import ascii_value\nfrom src.errors import ValidationError\n\ndef test_ascii_A() -> None:\n    \"\"\"Test for the example usage: 'A' should return 65.\"\"\"\n    assert ascii_value('A') == 65\n\ndef test_empty_input_raises() -> None:\n    \"\"\"Test that an empty string input raises ValidationError.\"\"\"\n    try:\n        ascii_value('')\n    except ValidationError:\n        pass\n    else:\n        raise AssertionError(\"Expected ValidationError for empty input\")\n\ndef test_multi_char_raises() -> None:\n    \"\"\"Test that a multi-character string input raises ValidationError.\"\"\"\n    try:\n        ascii_value('AB')\n    except ValidationError:\n        pass\n    else:\n        raise AssertionError(\"Expected ValidationError for multi-character input\")\n\ndef test_non_string_raises() -> None:\n    \"\"\"Test that a non-string input raises ValidationError.\"\"\"\n    try:\n        # type: ignore[arg-type] is used to allow testing invalid types\n        ascii_value(123)  # type: ignore[arg-type]\n    except ValidationError:\n        pass\n    else:\n        raise AssertionError(\"Expected ValidationError for non-string input\")\n```"}
{"task_id": "Mbpp/269", "solution": "```python\n# project-root/src/__init__.py\nfrom .ascii_value import ascii_value\n\n\n# project-root/src/ascii_value.py\nfrom typing import Callable\n\nclass Character:\n    \"\"\"Represents input character and provides validation.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        # Handle None explicitly for len calculation, as per design pseudocode\n        self.length = len(value) if value is not None else 0\n\n    def is_single_char(self) -> bool:\n        \"\"\"Checks if the character value is a single-character string.\"\"\"\n        return isinstance(self.value, str) and self.length == 1\n\nclass AsciiCode:\n    \"\"\"Typed holder for the computed ASCII code.\"\"\"\n    def __init__(self, code: int):\n        self.code = code\n\nclass AsciiFunction:\n    \"\"\"Encapsulates logic to map a Character to an AsciiCode.\"\"\"\n    def ascii_value(self, char: str) -> int:\n        \"\"\"Processes the input character and returns its ASCII integer code.\"\"\"\n        c = Character(char)\n        if not c.is_single_char():\n            raise ValueError(\"Input must be exactly one character\")\n        code = ord(c.value)\n        return AsciiCode(code).code\n\nclass TestCase:\n    \"\"\"Represents a test expression, expected value, and pass/fail result.\"\"\"\n    def __init__(self, expression: str, expected: int):\n        self.expression = expression\n        self.expected = expected\n        self.passed = False\n\n    def evaluate(self, func: Callable[[str], int]) -> bool:\n        \"\"\"Evaluates the test case against the provided function.\"\"\"\n        # Simplified evaluation model per design; assumes 'A' for evaluation.\n        actual = func('A')\n        self.passed = (actual == self.expected)\n        return self.passed\n\ndef ascii_value(char: str) -> int:\n    \"\"\"\n    Validate char is a single-character string; return its ASCII code as int.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    return AsciiFunction().ascii_value(char)\n\n\n# project-root/src/main.py\nimport sys\nfrom .ascii_value import ascii_value\n\ndef _parse_args(args: list[str]) -> str | None:\n    \"\"\"Minimal helper to parse command line arguments for the example.\"\"\"\n    if \"--example\" in args:\n        try:\n            char_index = args.index(\"--example\") + 1\n            if char_index < len(args):\n                return args[char_index]\n        except (ValueError, IndexError):\n            pass\n    return None\n\ndef main(args: list[str]) -> int:\n    \"\"\"\n    Demonstrates usage of the ascii_value function.\n    Example: python src/main.py --example A\n    \"\"\"\n    print(\"--- ascii_value demonstration ---\")\n    char_to_test = _parse_args(args)\n\n    if char_to_test:\n        try:\n            result = ascii_value(char_to_test)\n            print(f\"ASCII value of '{char_to_test}' is: {result}\")\n        except ValueError as e:\n            print(f\"Error for input '{char_to_test}': {e}\")\n    else:\n        print(\"No character provided. Using default 'B' for demonstration.\")\n        try:\n            result_B = ascii_value('B')\n            print(f\"ASCII value of 'B' is: {result_B}\")\n        except ValueError as e:\n            print(f\"Error for default input 'B': {e}\")\n\n    return 0\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n\n\n# project-root/tests/test_ascii_value.py\nimport pytest\nfrom src.ascii_value import ascii_value, TestCase\n\ndef test_ascii_value_A_equals_65():\n    \"\"\"Verify ascii_value('A') returns 65, using direct assert and TestCase.\"\"\"\n    # Direct assertion as specified by FR-2\n    assert ascii_value('A') == 65\n\n    # Using the TestCase class as modeled in the design (UC-2 sequence)\n    test_case_A = TestCase(expression=\"ascii_value('A')\", expected=65)\n    result = test_case_A.evaluate(ascii_value)\n    assert result is True\n    assert test_case_A.passed is True\n\ndef test_ascii_value_invalid_inputs():\n    \"\"\"Verify empty string and multi-character inputs raise ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be exactly one character\"):\n        ascii_value(\"\")\n    with pytest.raises(ValueError, match=\"Input must be exactly one character\"):\n        ascii_value(\"AB\")\n    with pytest.raises(ValueError, match=\"Input must be exactly one character\"):\n        ascii_value(\"abc\")\n    with pytest.raises(ValueError, match=\"Input must be exactly one character\"):\n        ascii_value(\"  \") # Multiple spaces\n    with pytest.raises(ValueError, match=\"Input must be exactly one character\"):\n        ascii_value(None) # None results in length=0, not a single character\n\ndef test_ascii_value_other_valid_characters():\n    \"\"\"Verify ASCII values for other valid single characters.\"\"\"\n    assert ascii_value('B') == 66\n    assert ascii_value('b') == 98\n    assert ascii_value('Z') == 90\n    assert ascii_value('z') == 122\n    assert ascii_value('0') == 48\n    assert ascii_value('9') == 57\n    assert ascii_value('$') == 36\n    assert ascii_value('\\n') == 10 # Newline character\n    assert ascii_value('\\t') == 9  # Tab character\n    assert ascii_value(' ') == 32 # Single space\n```"}
{"task_id": "Mbpp/270", "solution": "```python\ndef sum_even_and_even_index(numbers: list[int]) -> int:\n    \"\"\"Return sum of even-valued integers at even (zero-based) indices.\n    The sum is 0 if no qualifying elements are found.\n    \"\"\"\n    total = 0\n    # Iterate indices 0, 2, 4, ...\n    for i in range(0, len(numbers), 2):\n        if numbers[i] % 2 == 0:\n            total += numbers[i]\n    return total\n```"}
{"task_id": "Mbpp/270", "solution": "```python\nfrom typing import List\n\n__all__ = [\"sum_even_and_even_index\"]\n\ndef sum_even_and_even_index(numbers: List[int]) -> int:\n    \"\"\"Return the sum of values that are even and whose indices are even (zero-based).\n    The computed sum is 0 if the list is empty or no matching elements are found.\n    \"\"\"\n    running_sum = 0\n    for index, value in enumerate(numbers):\n        if index % 2 == 0 and value % 2 == 0:\n            running_sum += value\n    return running_sum\n```"}
{"task_id": "Mbpp/271", "solution": "```python\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of the first n even natural numbers, each raised to the fifth power.\n    Example: even_Power_Sum(2) == 1056 (2^5 + 4^5).\n    \"\"\"\n    # Calculate the sum of (2*k)^5 for k from 1 to n using a generator expression.\n    return sum((2 * k) ** 5 for k in range(1, n + 1))\n```"}
