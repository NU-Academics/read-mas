{"task_id": "Mbpp/471", "solution": "```python\ndef _product_of_list(arr: list) -> int:\n    \"\"\"Computes the product of integers in a list; product of an empty list is 1.\"\"\"\n    current_product = 1\n    for x in arr:\n        current_product *= x\n    return current_product\n\nclass IntegerArray:\n    \"\"\"Wrapper for a list of integers, providing a product calculation.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def product(self) -> int:\n        \"\"\"Computes the product of elements by delegating to _product_of_list.\"\"\"\n        return _product_of_list(self.elements)\n\nclass Modulus:\n    \"\"\"Wrapper for an integer modulus n, providing a positivity check.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if the modulus n is positive (n > 0).\"\"\"\n        return self.n > 0\n\nclass Result:\n    \"\"\"Holds a computed value and applies modulo operation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def as_mod(self, n: int) -> int:\n        \"\"\"Returns the value modulo n using Python's semantics.\"\"\"\n        return self.value % n\n\ndef find_remainder(arr, n) -> int:\n    \"\"\"Computes the product of integers in arr and returns the result modulo n.\n    The product of an empty array is 1, and the result is in 0..n-1 for n > 0.\n    \"\"\"\n    integer_array = IntegerArray(arr)\n    product_value = integer_array.product()\n\n    # Instantiate Modulus as per design, even if its method is not explicitly called.\n    modulus_obj = Modulus(n)\n\n    result = Result(product_value)\n    final_remainder = result.as_mod(n)\n    return final_remainder\n```"}
{"task_id": "Mbpp/472", "solution": "```python\n# src/check_consecutive.py\nfrom typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    \"\"\"Represents a list of integers for processing.\"\"\"\n    elements: List[int]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return self.length() == 0\n\n@dataclass\nclass IntegerElement:\n    \"\"\"Represents a single integer element.\"\"\"\n    value: int\n\n@dataclass\nclass Result:\n    \"\"\"Encapsulates the boolean result of consecutiveness check.\"\"\"\n    is_consecutive: bool\n\nclass CheckConsecutive:\n    \"\"\"Algorithm for validating input and checking consecutiveness.\"\"\"\n\n    def validate_input(self, elements) -> bool:\n        \"\"\"\n        Validates that elements is a list of integers.\n        Raises TypeError for invalid input.\n        \"\"\"\n        if not isinstance(elements, list):\n            raise TypeError(\"Input must be a list.\")\n        for i, element in enumerate(elements):\n            if not isinstance(element, int):\n                raise TypeError(f\"Element at index {i} must be an integer, got {type(element).__name__}.\")\n        return True\n\n    def check(self, elements: List[int]) -> bool:\n        \"\"\"\n        Checks if the list elements form an ascending consecutive sequence.\n        Assumes input has already been validated.\n        \"\"\"\n        if len(elements) < 2:\n            return True # An empty or single-element list is trivially consecutive.\n\n        for i in range(1, len(elements)):\n            if elements[i] != elements[i-1] + 1:\n                return False\n        return True\n\ndef check_Consecutive(elements: List[int]) -> bool:\n    \"\"\"\n    Public API to check if a list of integers contains consecutive numbers.\n    Validates input and computes consecutiveness.\n    \"\"\"\n    algo = CheckConsecutive()\n    algo.validate_input(elements)\n    return algo.check(elements)\n\n```\n```python\n# tests/test_check_consecutive.py\nfrom src.check_consecutive import check_Consecutive\n\ndef test_assert_sequence():\n    \"\"\"Verifies the required acceptance test: [1,2,3,4,5] is consecutive.\"\"\"\n    assert check_Consecutive([1,2,3,4,5]) == True\n\n```"}
{"task_id": "Mbpp/472", "solution": "```python\n# src/check_consecutive.py\n\"\"\"\nThis module provides a function to check for strictly ascending consecutive integers.\nThe function name must be exactly 'check_Consecutive' (case-sensitive).\n\"\"\"\nfrom typing import List\n\n\ndef _is_list_of_ints(input_list: list) -> bool:\n    \"\"\"Return True if input_list is a list and every element is an integer.\"\"\"\n    return isinstance(input_list, list) and all(isinstance(x, int) for x in input_list)\n\n\ndef check_Consecutive(input_list: List[int]) -> bool:\n    \"\"\"Return True if input_list items are strictly ascending consecutive integers with adjacent diff 1; otherwise False.\"\"\"\n    if not _is_list_of_ints(input_list):\n        return False\n\n    if len(input_list) < 2:\n        return False\n\n    for i in range(len(input_list) - 1):\n        if input_list[i+1] - input_list[i] != 1:\n            return False\n\n    return True\n\n```\n```python\n# tests/test_check_consecutive.py\nfrom src.check_consecutive import check_Consecutive\n\nassert check_Consecutive([1,2,3,4,5]) == True\n\nif __name__ == '__main__':\n    assert check_Consecutive([1,2,3,4,5]) == True\n    print('Test passed')\n\n```"}
{"task_id": "Mbpp/473", "solution": "```python\nfrom typing import List, Set, Tuple as PyTupleType\n\nclass Tuple:\n    \"\"\"Represent a 2-element integer tuple and provide canonicalize() and equalsUnordered().\"\"\"\n    _a: int\n    _b: int\n\n    def __init__(self, a: int, b: int):\n        self._a = a\n        self._b = b\n\n    def canonicalize(self) -> 'Tuple':\n        \"\"\"Returns a new Tuple ordered (min, max).\"\"\"\n        return Tuple(min(self._a, self._b), max(self._a, self._b))\n\n    def equalsUnordered(self, other: 'Tuple') -> bool:\n        \"\"\"Compares two Tuples for unordered equality.\"\"\"\n        return {self._a, self._b} == {other._a, other._b}\n\n    def __eq__(self, other):\n        \"\"\"Compares two Tuples for exact equality of their ordered elements.\"\"\"\n        if not isinstance(other, Tuple):\n            return NotImplemented\n        return self._a == other._a and self._b == other._b\n\n    def __hash__(self):\n        \"\"\"Hashes the Tuple based on its ordered elements.\"\"\"\n        return hash((self._a, self._b))\n\n    def __repr__(self):\n        return f\"Tuple({self._a}, {self._b})\"\n\n    def to_python_tuple(self) -> PyTupleType[int, int]:\n        \"\"\"Converts the domain Tuple to a standard Python 2-element tuple.\"\"\"\n        return (self._a, self._b)\n\nclass TupleList:\n    \"\"\"Wrap a list of Tuple objects and provide copy().\"\"\"\n    _tuples: List[Tuple]\n\n    def __init__(self, tuples: List[Tuple]):\n        self._tuples = tuples\n\n    def copy(self) -> 'TupleList':\n        \"\"\"Returns a new TupleList with a shallow copy of its internal list.\"\"\"\n        return TupleList(list(self._tuples))\n\nclass TupleSet:\n    \"\"\"Maintain a set of canonical Tuple objects and provide add/contains.\"\"\"\n    _tuples: Set[Tuple]\n\n    def __init__(self):\n        self._tuples = set()\n\n    def add(self, t: Tuple) -> None:\n        \"\"\"Adds a canonical Tuple to the internal set.\"\"\"\n        self._tuples.add(t)\n\n    def contains(self, t: Tuple) -> bool:\n        \"\"\"Checks if a canonical Tuple is present in the internal set.\"\"\"\n        return t in self._tuples\n\n    def to_python_set(self) -> Set[PyTupleType[int, int]]:\n        \"\"\"Converts the internal set of domain Tuples to a set of Python tuples.\"\"\"\n        return {t.to_python_tuple() for t in self._tuples}\n\nclass TupleIntersectionService:\n    \"\"\"Computes intersection between two TupleList inputs and produces a TupleSet result.\"\"\"\n    def tuple_intersection(self, list1: TupleList, list2: TupleList) -> TupleSet:\n        \"\"\"Computes the intersection of two TupleLists using unordered equality.\"\"\"\n        result_set = TupleSet()\n        list1_copy = list1.copy()\n        list2_copy = list2.copy()\n\n        for t1 in list1_copy._tuples:\n            for t2 in list2_copy._tuples:\n                if t1.equalsUnordered(t2):\n                    canonical_t = t1.canonicalize()\n                    result_set.add(canonical_t)\n                    break # Break inner loop once a match is found for t1\n        return result_set\n\ndef tuple_intersection(list1: List[PyTupleType[int, int]], list2: List[PyTupleType[int, int]]) -> Set[PyTupleType[int, int]]:\n    \"\"\"\n    Computes intersection of two lists of 2-element integer tuples using unordered equality.\n    Returns canonical ordered tuples in a set.\n    \"\"\"\n    # Convert caller-provided Python lists to domain.TupleList objects.\n    domain_list1 = TupleList([Tuple(a, b) for a, b in list1])\n    domain_list2 = TupleList([Tuple(a, b) for a, b in list2])\n\n    # Delegate to TupleIntersectionService for the core logic.\n    service = TupleIntersectionService()\n    result_domain_set = service.tuple_intersection(domain_list1, domain_list2)\n\n    # Convert the resulting TupleSet to a Python set of canonical 2-element tuples for return.\n    return result_domain_set.to_python_set()\n```"}
{"task_id": "Mbpp/474", "solution": "```\n# src/__init__.py\n\"\"\"\nPackage marker for the src directory.\nAllows importing modules from this directory.\n\"\"\"\n```\n\n```python\n# src/replace_char.py\n\ndef validate_input(input_string, target_char, replacement_char) -> None:\n    \"\"\"\n    Validates input types and lengths, raising ValueError for invalid inputs.\n    Ensures input_string is str, target_char and replacement_char are single-character strings.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise ValueError(\"input_string must be a string.\")\n    if not isinstance(target_char, str) or len(target_char) != 1:\n        raise ValueError(\"target_char must be a single character string.\")\n    if not isinstance(replacement_char, str) or len(replacement_char) != 1:\n        raise ValueError(\"replacement_char must be a single character string.\")\n\ndef _perform_replacement(input_string: str, target_char: str, replacement_char: str) -> str:\n    \"\"\"\n    Performs the character replacement logic by scanning the string once.\n    Builds a new string using O(n) additional memory.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == target_char:\n            result_chars.append(replacement_char)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef replace_char(input_string: str, target_char: str, replacement_char: str) -> str:\n    \"\"\"\n    Validates inputs and returns a new string where every occurrence of target_char\n    is replaced with replacement_char, or raises ValueError.\n    \"\"\"\n    validate_input(input_string, target_char, replacement_char)\n\n    # Short-circuit special cases for efficiency and defined behavior.\n    if not input_string:  # Empty input string\n        return \"\"\n    if target_char == replacement_char:  # No actual replacement needed\n        return input_string\n    if target_char not in input_string: # Target character not found\n        return input_string\n\n    return _perform_replacement(input_string, target_char, replacement_char)\n\n```\n\n```python\n# tests/test_replace_char.py\nimport pytest\nfrom src.replace_char import replace_char\n\ndef test_replace_example():\n    \"\"\"\n    Verifies the core example from the problem statement.\n    Checks a basic replacement case.\n    \"\"\"\n    assert replace_char(\"polygon\", 'y', 'l') == \"pollgon\"\n\ndef test_invalid_inputs():\n    \"\"\"\n    Tests various invalid input types and lengths, expecting ValueError.\n    Covers non-string, multi-character, and empty-string character inputs.\n    \"\"\"\n    # input_string not str\n    with pytest.raises(ValueError, match=\"input_string must be a string\"):\n        replace_char(123, 'a', 'b')\n    with pytest.raises(ValueError, match=\"input_string must be a string\"):\n        replace_char(None, 'a', 'b')\n\n    # target_char not str or len != 1\n    with pytest.raises(ValueError, match=\"target_char must be a single character string\"):\n        replace_char(\"hello\", 1, 'b')\n    with pytest.raises(ValueError, match=\"target_char must be a single character string\"):\n        replace_char(\"hello\", \"aa\", 'b')\n    with pytest.raises(ValueError, match=\"target_char must be a single character string\"):\n        replace_char(\"hello\", \"\", 'b')\n\n    # replacement_char not str or len != 1\n    with pytest.raises(ValueError, match=\"replacement_char must be a single character string\"):\n        replace_char(\"hello\", 'a', 1)\n    with pytest.raises(ValueError, match=\"replacement_char must be a single character string\"):\n        replace_char(\"hello\", 'a', \"bb\")\n    with pytest.raises(ValueError, match=\"replacement_char must be a single character string\"):\n        replace_char(\"hello\", 'a', \"\")\n\ndef test_empty_input():\n    \"\"\"\n    Checks behavior when the input string is empty.\n    An empty string should result in an empty string.\n    \"\"\"\n    assert replace_char(\"\", 'a', 'b') == \"\"\n    assert replace_char(\"\", 'x', 'y') == \"\"\n\ndef test_noop_when_target_not_present():\n    \"\"\"\n    Verifies that the original string is returned when target_char is not found.\n    Ensures no modification occurs if the character isn't there.\n    \"\"\"\n    assert replace_char(\"hello\", 'x', 'y') == \"hello\"\n    assert replace_char(\"Python\", 'J', 'K') == \"Python\"\n\ndef test_noop_when_target_equals_replacement():\n    \"\"\"\n    Checks if the function returns the original string when target_char is identical to replacement_char.\n    No action is needed if the characters are the same.\n    \"\"\"\n    assert replace_char(\"banana\", 'a', 'a') == \"banana\"\n    assert replace_char(\"apple\", 'p', 'p') == \"apple\"\n\ndef test_preserve_order_and_case():\n    \"\"\"\n    Confirms that non-target characters maintain their original order and case.\n    Also tests case-sensitive replacement.\n    \"\"\"\n    assert replace_char(\"Hello World\", 'l', 'x') == \"Hexxo Worxd\"\n    assert replace_char(\"PyThoN\", 'P', 'J') == \"JyThoN\"\n    assert replace_char(\"AaBbCc\", 'a', 'X') == \"AXBbCc\" # Case sensitive\n    assert replace_char(\"Mississipppi\", 's', 'z') == \"Mizzizzizzzipppi\"\n```"}
