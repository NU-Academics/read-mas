{"task_id": "Mbpp/133", "solution": "```python\n# src/sum_negativenum.py\n\nfrom typing import List, Any\n\ndef sum_negativenum(numbers: List[Any]) -> float:\n    \"\"\"\n    Computes the arithmetic sum of negative numbers in the provided list.\n    Excludes zero and positive numbers, returning 0.0 if no negatives are present.\n    \"\"\"\n    total_sum = 0.0\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n    return total_sum\n```\n\n```python\n# src/domain.py\n\nfrom typing import List, Any\n\n# Forward declarations for type hinting\nclass NumberList:\n    pass\nclass Result:\n    pass\n\nclass Number:\n    \"\"\"Represents a single number from the SRS domain model.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def isNegative(self) -> bool:\n        \"\"\"Determines if the number's value is negative.\"\"\"\n        return self.value < 0\n\nclass NumberList:\n    \"\"\"Represents a collection of numbers, mirroring the SRS domain concept.\"\"\"\n    def __init__(self, items: List['Number']):\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the total count of numbers in the list.\"\"\"\n        return len(self.items)\n\nclass Result:\n    \"\"\"Encapsulates a computed sum, reflecting the output domain concept.\"\"\"\n    def __init__(self, sum_value: float):\n        self.sum = sum_value\n\nclass SumNegativeNumFunction:\n    \"\"\"A domain representation of the sum_negativenum function for traceability.\"\"\"\n    def __init__(self):\n        self.name = \"sum_negativenum\"\n        self.signature = \"def sum_negativenum(numbers: list) -> float\"\n\n    def sumNegatives(self, numbers: List[Any]) -> float:\n        \"\"\"Delegates the actual sum computation to the sum_negativenum implementation.\"\"\"\n        # Import inside method to prevent potential cyclic import issues.\n        from src.sum_negativenum import sum_negativenum\n        return sum_negativenum(numbers)\n\nclass TestCase:\n    \"\"\"Represents a specific test scenario for validating the function's behavior.\"\"\"\n    def __init__(self, input_list: NumberList, expected_result: Result):\n        self.input = input_list\n        self.expected = expected_result\n\n    def run(self) -> bool:\n        \"\"\"Executes the sum_negativenum function and compares the actual result with the expected one.\"\"\"\n        # Import inside method to prevent potential cyclic import issues.\n        from src.sum_negativenum import sum_negativenum\n        input_values_raw = [num_obj.value for num_obj in self.input.items]\n        actual_sum = sum_negativenum(input_values_raw)\n        return actual_sum == self.expected.sum\n```\n\n```python\n# tests/test_sum_negativenum.py\n\nimport pytest\nfrom src.sum_negativenum import sum_negativenum\nfrom src.domain import Number, NumberList, Result, TestCase # Import domain classes for traceability\n\ndef test_provided_assertion():\n    \"\"\"\n    Validates the sum_negativenum function by performing the exact assertion from the SRS.\n    Domain model entities are constructed as specified by the design.\n    \"\"\"\n    # Construct domain model entities for traceability, as per design.\n    input_list_raw = [2, 4, -6, -9, 11, -12, 14, -5, 17]\n    expected_sum_raw = -32.0 # Use float for consistency with the function's return type.\n\n    number_objects = [Number(val) for val in input_list_raw]\n    input_number_list = NumberList(number_objects)\n    expected_result = Result(expected_sum_raw)\n\n    # The TestCase is constructed for design traceability, although the direct assert is also performed.\n    test_case_for_traceability = TestCase(input_number_list, expected_result)\n\n    # Perform the exact assertion as specified in the SRS.\n    assert sum_negativenum([2, 4, -6, -9, 11, -12, 14, -5, 17]) == -32\n```"}
