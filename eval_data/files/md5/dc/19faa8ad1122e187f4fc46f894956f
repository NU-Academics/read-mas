{"task_id": "Mbpp/471", "solution": "class ModuloOperation:\n    \"\"\"Encapsulates modulus and provides canonical modular reduction.\"\"\"\n    def __init__(self, modulus):\n        self.modulus = modulus\n\n    def apply(self, value):\n        \"\"\"Returns value mod modulus in the canonical range [0, modulus-1].\"\"\"\n        return value % self.modulus\n\ndef find_remainder(arr, n):\n    \"\"\"Computes the product of array elements modulo n, performing modular reduction at each step.\n    Returns the result in the canonical range [0, n-1] for positive n.\n    \"\"\"\n    accumulator = 1\n    mod_op = ModuloOperation(n)\n\n    for element in arr:\n        accumulator = accumulator * element\n        accumulator = mod_op.apply(accumulator)\n\n    return mod_op.apply(accumulator)"}
{"task_id": "Mbpp/573", "solution": "```python\n# src/unique_product.py\nimport math\n\ndef unique_product(numbers: list) -> int | float:\n    \"\"\"\n    Computes the product of the unique numbers in 'numbers'.\n    Duplicates are ignored; the return type is int if all unique numbers are integers.\n    \"\"\"\n    unique_numbers = set(numbers)\n    return math.prod(unique_numbers)\n\n```\n```python\n# tests/test_unique_product.py\nfrom src.unique_product import unique_product\n\ndef test_acceptance_sample():\n    \"\"\"Verifies the concrete acceptance test case.\"\"\"\n    assert unique_product([10, 20, 30, 40, 20, 50, 60, 40]) == 720000000\n\ndef test_duplicate_handling():\n    \"\"\"Checks that duplicate numbers are handled correctly (multiplied only once).\"\"\"\n    assert unique_product([5, 5, 5]) == 5\n    assert unique_product([2, 2, 3]) == 6\n\ndef test_integer_return_type():\n    \"\"\"Ensures the return type is int when all unique inputs are integers.\"\"\"\n    result = unique_product([2, 3, 2])\n    assert isinstance(result, int)\n    assert result == 6\n\ndef test_empty_list():\n    \"\"\"Checks behavior with an empty input list (product of empty set is 1).\"\"\"\n    assert unique_product([]) == 1\n\ndef test_single_element_list():\n    \"\"\"Checks behavior with a single element list.\"\"\"\n    assert unique_product([7]) == 7\n    assert unique_product([7.5]) == 7.5\n\ndef test_mixed_types_and_floats():\n    \"\"\"Tests with mixed integer and float inputs, expecting a float result.\"\"\"\n    result = unique_product([2, 2.5, 3])\n    assert isinstance(result, float)\n    assert result == 15.0\n    result_mixed = unique_product([10, 20.0, 30])\n    assert isinstance(result_mixed, float)\n    assert result_mixed == 6000.0\n\n\nif __name__ == '__main__':\n    # Simple direct execution of tests\n    print(\"Running tests...\")\n    test_acceptance_sample()\n    test_duplicate_handling()\n    test_integer_return_type()\n    test_empty_list()\n    test_single_element_list()\n    test_mixed_types_and_floats()\n    print(\"All tests passed successfully!\")\n\n```"}
{"task_id": "Mbpp/796", "solution": "```python\nfrom typing import Any, Dict, Union\n\nclass Key:\n    \"\"\"Represents a dictionary key.\"\"\"\n    def __init__(self, name: str) -> None:\n        self.name: str = name\n\nclass Value:\n    \"\"\"Wraps a raw input value for type checking and conversion.\"\"\"\n    def __init__(self, raw: Any) -> None:\n        self.raw: Any = raw\n\n    def is_numeric(self) -> bool:\n        \"\"\"Determines if the raw value is an integer or float.\"\"\"\n        return isinstance(self.raw, (int, float))\n\n    def is_float(self) -> bool:\n        \"\"\"Determines if the raw value is specifically a float.\"\"\"\n        return isinstance(self.raw, float)\n\n    def to_number(self) -> Union[int, float]:\n        \"\"\"Returns the raw value as a numeric type.\"\"\"\n        return self.raw\n\nclass DictionaryInput:\n    \"\"\"Encapsulates the input dictionary for domain logic.\"\"\"\n    def __init__(self, items: Dict) -> None:\n        self.items: Dict = items\n        self.values: list[Value] = [Value(v) for v in items.values()]\n        self.keys: list[Key] = [Key(k) for k in items.keys()]\n\nclass ReturnResult:\n    \"\"\"Holds the computed sum and its determined type.\"\"\"\n    def __init__(self, sum: Union[int, float], type: str) -> None:\n        self.sum: Union[int, float] = sum\n        self.type: str = type\n\nclass ErrorCondition:\n    \"\"\"Describes an error condition, typically a TypeError.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.type: str = \"TypeError\"\n        self.message: str = message\n\nclass ReturnSumFunction:\n    \"\"\"The core domain service for processing dictionary sums.\"\"\"\n\n    def return_sum(self, input_dict: Dict) -> Union[int, float]:\n        \"\"\"\n        Coordinates validation, summation, and result type determination.\n        Returns 0 for empty input, raises TypeError for non-numeric values.\n        \"\"\"\n        dict_input = DictionaryInput(input_dict)\n        self.validate_values(dict_input.values)\n\n        if not input_dict:\n            return 0\n\n        computed_sum = self.compute_sum(dict_input.values)\n\n        has_float = any(v.is_float() for v in dict_input.values)\n        if has_float:\n            return float(computed_sum)\n        else:\n            return int(computed_sum)\n\n    def validate_values(self, values: list[Value]) -> bool:\n        \"\"\"\n        Validates that all values are numeric (int or float).\n        Raises TypeError if any value is not numeric.\n        \"\"\"\n        for value_obj in values:\n            if not value_obj.is_numeric():\n                raise TypeError(f\"Non-numeric value found: {value_obj.raw}\")\n        return True\n\n    def compute_sum(self, values: list[Value]) -> float:\n        \"\"\"\n        Computes the arithmetic sum of all numeric values.\n        Assumes values have already been validated as numeric.\n        \"\"\"\n        numeric_values = [v.to_number() for v in values]\n        return sum(numeric_values)\n\ndef return_sum(input: Dict) -> Union[int, float]:\n    \"\"\"\n    Top-level API to compute the sum of dictionary values.\n    Delegates the core logic to ReturnSumFunction.\n    \"\"\"\n    sum_calculator = ReturnSumFunction()\n    return sum_calculator.return_sum(input)\n```"}
{"task_id": "Mbpp/793", "solution": "```python\ndef _binary_search_rightmost(arr: list, value) -> int:\n    \"\"\"Performs a modified binary search to find the rightmost occurrence of value.\n    It returns the index of the rightmost occurrence, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == value:\n            result = mid  # Found a potential rightmost index\n            low = mid + 1 # Continue search in the right half for a later occurrence\n        elif arr[mid] < value:\n            low = mid + 1\n        else: # arr[mid] > value\n            high = mid - 1\n    return result\n\ndef last(arr: list, value) -> int:\n    \"\"\"Returns the zero-based index of the last (rightmost) occurrence of value in a sorted array.\n    Returns -1 if the value is not found in the array.\n    \"\"\"\n    return _binary_search_rightmost(arr, value)\n```"}
