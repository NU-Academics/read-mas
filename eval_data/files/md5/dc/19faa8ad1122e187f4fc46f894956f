{"task_id": "Mbpp/282", "solution": "```python\n# src/sub_list.py\nfrom typing import List, Union\n\ndef sub_list(listA: List[Union[int, float]], listB: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Performs element-wise subtraction of two lists.\n    Assumes inputs are numeric lists of equal length.\n    \"\"\"\n    return [a - b for a, b in zip(listA, listB)]\n```\n```python\n# src/domain.py\nfrom typing import List, Union\n\nclass NumericValue:\n    \"\"\"Wraps a single numeric value for domain clarity.\n    Provides a consistent interface to access the value.\n    \"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self._value = value\n\n    def value(self) -> Union[int, float]:\n        \"\"\"Returns the wrapped numeric value.\"\"\"\n        return self._value\n\nclass NumericList:\n    \"\"\"Wraps a sequence of numeric values.\n    Provides methods for length and indexed access.\n    \"\"\"\n    def __init__(self, values: List[Union[int, float]]) -> None:\n        # Internally wraps each value with NumericValue for consistency.\n        self._values = [NumericValue(v) for v in values]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return len(self._values)\n\n    def get(self, i: int) -> Union[int, float]:\n        \"\"\"Returns the numeric value at a given index.\"\"\"\n        return self._values[i].value()\n\nclass SubListFunction:\n    \"\"\"An adapter mirroring the sub_list API.\n    Delegates directly to the core function.\n    \"\"\"\n    def sub_list(self, listA: List[Union[int, float]], listB: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"Delegates to the core sub_list function for element-wise subtraction.\"\"\"\n        from src.sub_list import sub_list as core_sub_list\n        return core_sub_list(listA, listB)\n```\n```python\n# tests/test_sub_list.py\nimport sys\nimport os\nimport unittest\nfrom typing import List, Union\n\n# Add src directory to Python path to enable module imports\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'src')))\n\nfrom src.sub_list import sub_list\n\nclass UnitTest(unittest.TestCase):\n    \"\"\"Encapsulates the acceptance test for the sub_list function.\n    It extends unittest.TestCase for framework compatibility.\n    \"\"\"\n    def __init__(self, methodName: str = 'runTest', name: str = \"\", assertion: str = \"\") -> None:\n        super().__init__(methodName)\n        self._test_name = name\n        self._assertion_str = assertion\n\n    def run(self, result: unittest.TestResult = None) -> bool:\n        \"\"\"Executes the acceptance assertion.\n        Returns True on success, False otherwise.\n        \"\"\"\n        try:\n            expected_result: List[Union[int, float]] = [-3, -3, -3]\n            actual_result: List[Union[int, float]] = sub_list([1, 2, 3], [4, 5, 6])\n            self.assertEqual(actual_result, expected_result,\n                             f\"Assertion failed: {actual_result} != {expected_result}\")\n            print(f\"Test '{self._test_name}' PASSED: {self._assertion_str}\")\n            return True\n        except AssertionError as e:\n            print(f\"Test '{self._test_name}' FAILED: {e}\")\n            return False\n        except Exception as e:\n            print(f\"Test '{self._test_name}' ERRORED: {e}\")\n            return False\n\n    def test_acceptance_criteria(self):\n        \"\"\"Actual test method which calls the custom run logic.\n        This integrates with the standard unittest runner.\n        \"\"\"\n        self.run()\n\ndef main() -> int:\n    \"\"\"Test runner entry point.\n    Executes the acceptance test suite and reports the outcome.\n    \"\"\"\n    print(\"Running acceptance tests...\")\n    suite = unittest.TestSuite()\n    test_instance = UnitTest(\n        methodName='test_acceptance_criteria',\n        name=\"FR2 Acceptance Test\",\n        assertion=\"sub_list([1, 2, 3], [4, 5, 6]) == [-3, -3, -3]\"\n    )\n    suite.addTest(test_instance)\n\n    runner = unittest.TextTestRunner(verbosity=2)\n    result = runner.run(suite)\n\n    if result.wasSuccessful():\n        print(\"\\nAll acceptance tests PASSED.\")\n        return 0\n    else:\n        print(\"\\nSome acceptance tests FAILED.\")\n        return 1\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```"}
{"task_id": "Mbpp/284", "solution": "```python\n# src/check_element.py\n\"\"\"Module to implement the check_element function.\"\"\"\n\ndef check_element(list, element) -> bool:\n    \"\"\"\n    Checks if every item in the input list is equal to the provided element.\n    Returns True if all items match the element, False otherwise.\n    \"\"\"\n    for item in list:\n        if item != element:\n            return False\n    return True\n\n```\n```python\n# src/domain.py\n\"\"\"Module defining domain classes for traceability and test orchestration.\"\"\"\n\nfrom typing import Any, List as TypingList\nfrom .check_element import check_element\n\n\nclass List:\n    \"\"\"Represents a collection of items in the domain model.\"\"\"\n    def __init__(self, items: TypingList[Any]):\n        self.items = items\n\nclass Element:\n    \"\"\"Represents a single element value in the domain model.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\nclass CheckElementFunction:\n    \"\"\"Domain class mirroring the check_element function for traceability.\"\"\"\n    def __init__(self, name: str, list_obj: List, element_obj: Element):\n        self.name = name\n        self.list = list_obj.items\n        self.element = element_obj.value\n\n    def check(self) -> bool:\n        \"\"\"Executes the underlying check_element function.\"\"\"\n        return check_element(self.list, self.element)\n\nclass TestCase:\n    \"\"\"Represents a test case for the check_element function.\"\"\"\n    def __init__(self, input_list: List, input_element: Element, expected: bool):\n        self.input_list = input_list.items\n        self.input_element = input_element.value\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Runs the test case and compares the actual result to the expected outcome.\"\"\"\n        actual_result = check_element(self.input_list, self.input_element)\n        return actual_result == self.expected\n\n```\n```python\n# tests/test_check_element.py\n\"\"\"Unit tests for the check_element function, including the explicit test case from SRS.\"\"\"\n\nfrom src.check_element import check_element\n# The design specifies TestModule constructs TestCase, so importing domain classes is necessary.\nfrom src.domain import TestCase, List, Element\n\n\ndef test_explicit_case():\n    \"\"\"\n    Executes the explicit negative test case provided in the SRS.\n    Asserts that check_element returns False for the specified inputs.\n    \"\"\"\n    assert check_element([\"green\", \"orange\", \"black\", \"white\"], 'blue') == False\n\n```"}
