xample_input}\")\n    computed_sum = sum_negativenum(example_input)\n    print(f\"Computed sum: {computed_sum}\")\n\n    acceptance_test_case = TestCase(example_input, -32.0)\n    test_passed = acceptance_test_case.run()\n    print(f\"Acceptance test passed: {test_passed}\")\n\nif __name__ == \"__main__\":\n    main()\n\n# tests/test_sum_negativenum.py\nfrom src.negative_number_calculator import sum_negativenum\n\ndef test_sum_negativenum() -> None:\n    \"\"\"Unit test to verify the sum_negativenum function against the acceptance test.\"\"\"\n    assert sum_negativenum([2, 4, -6, -9, 11, -12, 14, -5, 17]) == -32\n```"}
