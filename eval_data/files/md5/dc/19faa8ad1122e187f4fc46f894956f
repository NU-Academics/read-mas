lt: bool = expectedResult\n\n    def run(self) -> bool:\n        \"\"\"Executes the test callable and compares the result to the expected value.\"\"\"\n        actual_result = self.test_callable(self.input_value)\n        return actual_result == self.expectedResult\n```\n\n```\ntests/test_check_monthnumb_number.py\n```python\n\"\"\"Unit test for the check_monthnumb_number function.\"\"\"\n\nfrom monthchecker import check_monthnumb_number\n\ndef test_check_monthnumb_number_5_returns_true() -> None:\n    \"\"\"Verifies that month 5 (May) correctly returns True for having 31 days.\"\"\"\n    assert check_monthnumb_number(5) is True\n```"}
{"task_id": "Mbpp/454", "solution": "```python\nfrom typing import List, Optional\n\nclass TextInput:\n    \"\"\"Represents the raw input string and provides derived metadata.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input content.\"\"\"\n        return len(self.content)\n\nclass Word:\n    \"\"\"Represents a token produced by Tokenizer; supports 'z' containment check.\"\"\"\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.position = position\n\n    def contains_z(self, pattern: 'Pattern') -> bool:\n        \"\"\"Checks if the word's text contains the target character from the pattern.\"\"\"\n        return pattern.matches(self.text)\n\nclass MatchResult:\n    \"\"\"Represents the result of a match operation.\"\"\"\n    def __init__(self, matched: bool, matched_words: Optional[List[Word]] = None):\n        self.matched = matched\n        self.matched_words = matched_words if matched_words is not None else []\n\nclass Pattern:\n    \"\"\"Encapsulates the matching target (lowercase 'z').\"\"\"\n    def __init__(self, target: str = 'z'):\n        self.target = target\n\n    def matches(self, token_text: str) -> bool:\n        \"\"\"Returns True if the target is found in the token_text.\"\"\"\n        return self.target in token_text\n\nclass Tokenizer:\n    \"\"\"Tokenize input strings into Word tokens, preserving adjacent punctuation.\"\"\"\n    def tokenize(self, content: str) -> List[Word]:\n        \"\"\"Splits content on whitespace, creating Word objects with positions.\"\"\"\n        tokens = content.split()\n        words = []\n        for i, token_text in enumerate(tokens):\n            words.append(Word(text=token_text, position=i))\n        return words\n\nclass Matcher:\n    \"\"\"Orchestrates tokenization and pattern matching.\"\"\"\n    def __init__(self, tokenizer: Optional[Tokenizer] = None, pattern: Optional[Pattern] = None):\n        self.tokenizer = tokenizer if tokenizer is not None else Tokenizer()\n        self.pattern = pattern if pattern is not None else Pattern()\n\n    def match(self, content: str) -> MatchResult:\n        \"\"\"Tokenizes content and checks each word against the pattern.\"\"\"\n        words = self.tokenizer.tokenize(content)\n        matched_words: List[Word] = []\n        matched = False\n        for word in words:\n            if word.contains_z(self.pattern):\n                matched = True\n                matched_words.append(word)\n        return MatchResult(matched=matched, matched_words=matched_words)\n\n    def text_match_wordz(self, content: str) -> bool:\n        \"\"\"Provides the boolean result of the match operation.\"\"\"\n        return self.match(content).matched\n\ndef text_match_wordz(input: str) -> bool:\n    \"\"\"Checks if the input string contains at least one word with a lowercase 'z'.\"\"\"\n    matcher = Matcher()\n    return matcher.text_match_wordz(input)\n```"}
