{"task_id": "Mbpp/103", "solution": "```python\n# src/eulerian.py\nfrom src.validator import InputValidator\nfrom src.calculator import EulerianCalculator\n# from src.result import Result # Result is not directly used in this orchestrator, only by Calculator if needed.\n\ndef eulerian_num(n, m) -> int:\n    \"\"\"\n    Public API returning integer a(n, m) after validation and computation.\n    \"\"\"\n    validator = InputValidator()\n\n    if not validator.isValidN(n):\n        return 0\n    if not validator.isValidM(n, m):\n        return 0\n    \n    calculator = EulerianCalculator()\n    return calculator.eulerian_num(n, m)\n\n```\n```python\n# src/validator.py\n\nclass InputValidator:\n    \"\"\"\n    Input validation utilities for n and m parameters.\n    \"\"\"\n    def isValidN(self, n) -> bool:\n        \"\"\"Return True if n is an int and n >= 0.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n    def isValidM(self, n, m) -> bool:\n        \"\"\"Return True if m is an int and 0 <= m < n.\"\"\"\n        return isinstance(m, int) and 0 <= m < n\n\n```\n```python\n# src/calculator.py\n# from src.result import Result # Result is not directly used, int is returned.\n\nclass EulerianCalculator:\n    \"\"\"\n    EulerianCalculator implementation that computes a(n, m).\n    \"\"\"\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Public compute method; uses _compute_iterative for performance.\"\"\"\n        # The top-level eulerian_num function in src/eulerian.py handles validation.\n        # This method assumes valid inputs: n >= 0, 0 <= m < n.\n        return self._compute_iterative(n, m)\n\n    def _compute_recursive(self, n: int, m: int) -> int:\n        \"\"\"\n        Reference recursive implementation: a(n,m) = (n-m)*a(n-1,m-1) + (m+1)*a(n-1,m).\n        \"\"\"\n        # Base cases\n        if m < 0 or m >= n:\n            return 0\n        if n == 0 and m == 0:\n            return 1\n        \n        # Recurrence relation\n        term1 = (n - m) * self._compute_recursive(n - 1, m - 1)\n        term2 = (m + 1) * self._compute_recursive(n - 1, m)\n        return term1 + term2\n\n    def _compute_iterative(self, n: int, m: int) -> int:\n        \"\"\"\n        Iterative DP: fill A[0..n][0..n] using base cases and return A[n][m].\n        \"\"\"\n        # Initialize a 2D table A[i][j] where i is n_val and j is m_val\n        # The table size is (n+1) x (n+1) to accommodate indices from 0 to n.\n        A = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: a(0,0) = 1\n        A[0][0] = 1\n\n        # Fill the table using the recurrence relation\n        for i in range(1, n + 1):  # Iterate for n from 1 to N\n            for j in range(i):  # Iterate for m from 0 to i-1\n                # a(i,j) = (i-j)*a(i-1,j-1) + (j+1)*a(i-1,j)\n                \n                # term1: (i-j) * A[i-1][j-1]\n                # If j-1 is out of bounds (i.e., j=0), a(i-1,-1) is 0.\n                term1 = (i - j) * (A[i-1][j-1] if j > 0 else 0)\n                \n                # term2: (j+1) * A[i-1][j]\n                term2 = (j + 1) * A[i-1][j]\n                \n                A[i][j] = term1 + term2\n        \n        # The result is the value at A[n][m]\n        return A[n][m]\n\n```\n```python\n# src/result.py\n\nclass Result:\n    \"\"\"\n    Simple data holder for the computation result.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n```"}
{"task_id": "Mbpp/103", "solution": "```python\n# src/eulerian_service.py\nfrom typing import Optional\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid inputs to Eulerian number calculations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputValidation:\n    \"\"\"Handles validation logic for Eulerian number inputs.\"\"\"\n    def __init__(self):\n        self.error_message: str = \"\"\n\n    def is_valid(self, n: int, m: int) -> bool:\n        \"\"\"Validates n and m based on Eulerian number domain rules.\"\"\"\n        if n < 0:\n            self.error_message = \"n must be non-negative.\"\n            return False\n        if n == 0:\n            if m != 0:\n                self.error_message = \"For n=0, m must be 0.\"\n                return False\n        else:  # n > 0\n            if not (0 <= m < n):\n                self.error_message = \"For n>0, m must be between 0 and n-1 (inclusive).\"\n                return False\n        return True\n\nclass EulerianNumber:\n    \"\"\"Domain data holder for (n, m, value) of an Eulerian number.\"\"\"\n    def __init__(self, n: int, m: int, value: int) -> None:\n        self.n = n\n        self.m = m\n        self.value = value\n\nclass EulerianService:\n    \"\"\"Service to validate inputs and compute Eulerian numbers.\"\"\"\n    def __init__(self):\n        self._memo = {} # Memoization dictionary for compute method.\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Public method to compute the Eulerian number a(n, m).\"\"\"\n        self.validate_inputs(n, m)\n        computed_value = self.compute(n, m)\n        return computed_value\n\n    def validate_inputs(self, n: int, m: int) -> None:\n        \"\"\"Validates inputs and raises ValidationError if invalid.\"\"\"\n        validator = InputValidation()\n        if not validator.is_valid(n, m):\n            raise ValidationError(validator.error_message)\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"Computes a(n, m) using base case and recurrence with memoization.\"\"\"\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        # Base case a(0,0) = 1\n        if n == 0 and m == 0:\n            result = 1\n        # Boundary conditions: a(n,m) = 0 if m < 0 or m >= n (for n >= 0).\n        # Also handles cases where n < 0, which are generally not defined.\n        elif n < 0 or m < 0 or m >= n:\n            result = 0\n        # Recurrence a(n,m) = (n - m) * a(n-1, m-1) + (m + 1) * a(n-1, m).\n        # This applies for n > 0 and 0 <= m < n, covered by the 'else'.\n        else:\n            term1 = (n - m) * self.compute(n - 1, m - 1)\n            term2 = (m + 1) * self.compute(n - 1, m)\n            result = term1 + term2\n        \n        self._memo[(n, m)] = result\n        return result\n\n# Top-level API function, delegates to a singleton service instance.\n_eulerian_service_instance = EulerianService()\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m) based on design specifications.\"\"\"\n    return _eulerian_service_instance.eulerian_num(n, m)\n\n```\n```python\n# tests/test_eulerian.py\nimport sys\nimport os\n\n# Adjusting path to import from src directory for robust execution.\n# This makes sure the project root is in sys.path when running tests.\nscript_dir = os.path.dirname(__file__)\nproject_root = os.path.abspath(os.path.join(script_dir, os.pardir))\nsys.path.insert(0, project_root)\n\n# Import the main API function and exception type.\nfrom src.eulerian_service import eulerian_num, ValidationError\n\nclass UnitTest:\n    \"\"\"Runs acceptance unit test for eulerian_num.\"\"\"\n    def run(self) -> bool:\n        \"\"\"Executes the required acceptance test and reports success or failure.\"\"\"\n        print(\"Running acceptance test: assert eulerian_num(3, 1) == 4\")\n        try:\n            result = eulerian_num(3, 1)\n            assert result == 4, f\"Test failed: Expected 4, got {result}\"\n            print(f\"Test passed: eulerian_num(3, 1) == {result}\")\n            return True\n        except ValidationError as e:\n            print(f\"Test failed due to validation error: {e}\")\n            return False\n        except AssertionError as e:\n            print(f\"Test failed: {e}\")\n            return False\n        except Exception as e:\n            print(f\"Test failed with unexpected error: {e}\")\n            return False\n\nif __name__ == '__main__':\n    test_runner = UnitTest()\n    if test_runner.run():\n        sys.exit(0) # Exit with code 0 for success.\n    else:\n        sys.exit(1) # Exit with code 1 for failure.\n\n```"}
