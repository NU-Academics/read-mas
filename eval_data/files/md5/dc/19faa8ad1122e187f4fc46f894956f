{"task_id": "Mbpp/84", "solution": "```python\n# src/validation_error.py\nclass ValidationError(Exception):\n    \"\"\"\n    Domain-specific exception for input validation failures.\n    Carries a message describing the validation issue.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n```python\n# src/result.py\nclass Result:\n    \"\"\"\n    Data holder for computed integer values.\n    Holds a single integer value.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n```python\n# src/input_validator.py\nclass InputValidator:\n    \"\"\"\n    Encapsulates logic for validating input parameters.\n    Checks if an input is a positive integer.\n    \"\"\"\n    def isPositiveInteger(self, n: int) -> bool:\n        \"\"\"\n        Returns True if n is an integer and n >= 1, else False.\n        \"\"\"\n        return isinstance(n, int) and n >= 1\n\n```python\n# src/sequence_calculator.py\nfrom typing import Dict\n\nclass SequenceCalculator:\n    \"\"\"\n    Computes Newman\u2013Conway numbers using recurrence and memoization.\n    Stores previously computed values in a memoization dictionary.\n    \"\"\"\n    def __init__(self):\n        \"\"\"\n        Initializes the calculator with base cases a(1)=1, a(2)=1.\n        \"\"\"\n        self._memo: Dict[int, int] = {1: 1, 2: 1}\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Returns the nth Newman\u2013Conway number.\n        Uses memoization to avoid redundant computations.\n        \"\"\"\n        if n in self._memo:\n            return self._memo[n]\n        \n        # Recurrence: a(n) = a(a(n-1)) + a(n-a(n-1))\n        an_minus_1 = self.compute(n - 1)\n        \n        index1 = an_minus_1\n        index2 = n - an_minus_1\n\n        result = self.compute(index1) + self.compute(index2)\n        \n        self._memo[n] = result\n        return result\n\n```python\n# src/sequence.py\nfrom .input_validator import InputValidator\nfrom .sequence_calculator import SequenceCalculator\nfrom .validation_error import ValidationError\n\nclass SequenceFunction:\n    \"\"\"\n    Orchestrates the computation of Newman\u2013Conway numbers.\n    Handles input validation and delegates recurrence calculation.\n    \"\"\"\n    def __init__(self, validator: InputValidator = None, calculator: SequenceCalculator = None):\n        \"\"\"\n        Initializes SequenceFunction with optional validator and calculator instances.\n        \"\"\"\n        self._validator = validator or InputValidator()\n        self._calculator = calculator or SequenceCalculator()\n\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Validates input 'n' and returns the nth Newman\u2013Conway number.\n        Raises ValidationError if 'n' is not a positive integer.\n        \"\"\"\n        if not self._validator.isPositiveInteger(n):\n            raise ValidationError('n must be a positive integer')\n        return self._calculator.compute(n)\n\n# Public API function as specified in the design\n_sequence_function_instance = SequenceFunction()\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Public API: Returns the nth Newman\u2013Conway number.\n    Delegates to SequenceFunction for validation and computation.\n    \"\"\"\n    return _sequence_function_instance.sequence(n)\n\n```python\n# src/__init__.py\n\"\"\"\nPackage initializer for src; re-exports the public API function sequence.\nThis allows callers to import 'sequence' directly from the 'src' package.\n\"\"\"\nfrom .sequence import sequence\nfrom .validation_error import ValidationError # Re-export for callers to catch it\n```"}
