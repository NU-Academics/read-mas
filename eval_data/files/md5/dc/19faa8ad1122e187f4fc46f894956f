{"task_id": "Mbpp/172", "solution": "```python\n# src/count_occurance.py\n\ndef count_occurance(input: str) -> int:\n    \"\"\"Return the number of non-overlapping occurrences of the substring 'std' in input.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n    return input.count(\"std\")\n```\n```python\n# tests/test_count_occurance.py\nfrom src.count_occurance import count_occurance\n\nclass TestCase:\n    \"\"\"Encapsulates a test expression, expected result, and provides a method to run the test.\"\"\"\n    def __init__(self, expression, expected, is_error_test: bool = False, error_type=None):\n        self.expression = expression\n        self.expected = expected\n        self.is_error_test = is_error_test\n        self.error_type = error_type\n\n    def run(self) -> bool:\n        \"\"\"Executes the test case, comparing actual output to expected, and returns True on success.\"\"\"\n        test_desc = f\"Testing count_occurance('{self.expression}')\"\n        if self.is_error_test:\n            test_desc += f\" (expecting {self.error_type.__name__})\"\n        else:\n            test_desc += f\" (expected: {self.expected})\"\n\n        print(f\"Running: {test_desc} ... \", end=\"\")\n        \n        try:\n            actual = count_occurance(self.expression)\n            if self.is_error_test:\n                print(f\"FAILED (expected error, got result: {actual})\")\n                return False\n            if actual == self.expected:\n                print(\"PASSED\")\n                return True\n            else:\n                print(f\"FAILED (actual: {actual})\")\n                return False\n        except Exception as e:\n            if self.is_error_test and isinstance(e, self.error_type):\n                print(f\"PASSED (caught expected {type(e).__name__})\")\n                return True\n            else:\n                print(f\"FAILED (unexpected exception: {type(e).__name__}: {e})\")\n                return False\n\ndef run_tests() -> None:\n    \"\"\"Constructs and runs all defined unit tests for count_occurance, reporting results.\"\"\"\n    print(\"--- Starting unit tests for count_occurance ---\")\n    tests = [\n        # Required assertion\n        TestCase(\"letstdlenstdporstd\", 3),\n\n        # Behavioral notes tests\n        TestCase(\"\", 0),  # Empty input\n        TestCase(\"no match here\", 0), # No match input\n        TestCase(\"std\", 1), # Single occurrence\n        TestCase(\"stdstdstd\", 3), # Multiple contiguous occurrences\n        TestCase(\"st dstd\", 1), # Occurrence with space\n        TestCase(\"standard\", 1), # 'std' as prefix\n        TestCase(\"mystd\", 1), # 'std' as suffix\n        \n        # Type enforcement tests\n        TestCase(123, None, is_error_test=True, error_type=TypeError),\n        TestCase(None, None, is_error_test=True, error_type=TypeError),\n        TestCase(['std'], None, is_error_test=True, error_type=TypeError),\n        \n        # Edge cases/variations (non-overlapping)\n        TestCase(\"stdostd\", 2),\n        TestCase(\"std\", 1),\n        TestCase(\"STD\", 0), # Case sensitive\n        TestCase(\"stdd\", 1), # 'std' followed by another char\n        TestCase(\"a\", 0),\n        TestCase(\"st\", 0),\n        TestCase(\"s\", 0),\n    ]\n\n    all_passed = True\n    for test_case in tests:\n        if not test_case.run():\n            all_passed = False\n    \n    print(\"--- Test Summary ---\")\n    if all_passed:\n        print(\"All tests PASSED!\")\n    else:\n        print(\"Some tests FAILED!\")\n        raise AssertionError(\"One or more tests failed.\")\n\nif __name__ == \"__main__\":\n    run_tests()\n```"}
