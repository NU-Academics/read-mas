{"task_id": "Mbpp/223", "solution": "```python\n# /src/__init__.py\nfrom .is_majority import is_majority\n\n```\n```python\n# /src/is_majority.py\nfrom typing import Sequence, Any\nfrom dataclasses import dataclass\nfrom .validator import Validator\n\n@dataclass\nclass Array:\n    \"\"\"Represents an input sequence for conceptual design.\"\"\"\n    values: Sequence[Any]\n    length: int\n\n@dataclass\nclass Element:\n    \"\"\"Represents the target element being checked.\"\"\"\n    value: Any\n\n@dataclass\nclass Result:\n    \"\"\"Holds the boolean outcome of a majority check.\"\"\"\n    isMajority: bool\n\nclass IsMajorityFunction:\n    \"\"\"Encapsulates the core algorithm for checking majority status.\"\"\"\n\n    @staticmethod\n    def is_majority(array: Sequence[Any], n: int, element: Any) -> bool:\n        \"\"\"\n        Determines if 'element' is the majority among the first 'n' elements.\n        It counts occurrences and checks if the count is strictly greater than n/2.\n        \"\"\"\n        if n <= 0:\n            return False\n\n        count = 0\n        # Iterate over the specified first 'n' elements, constrained by actual array length.\n        for i in range(min(n, len(array))):\n            if array[i] == element:\n                count += 1\n        \n        # 'count * 2 > n' accurately checks for strictly greater than n/2 for integers.\n        return count * 2 > n\n\ndef is_majority(array: Sequence[Any], n: int, element: Any) -> bool:\n    \"\"\"\n    Public API function: checks if an element is the majority element.\n    It performs lightweight input validation then delegates to the core logic.\n    \"\"\"\n    if not Validator.validate_input(array, n, element):\n        return False\n    \n    return IsMajorityFunction.is_majority(array, n, element)\n\n```\n```python\n# /src/validator.py\nfrom typing import Sequence, Any\n\nclass Validator:\n    \"\"\"A lightweight component for structural validation of inputs.\"\"\"\n\n    @staticmethod\n    def validate_input(array: Sequence[Any], n: int, element: Any) -> bool:\n        \"\"\"\n        Performs minimal checks: 'array' is a sequence and 'n' is a non-negative integer.\n        Returns False if validation fails, True otherwise; does not check sortedness.\n        \"\"\"\n        if not isinstance(array, Sequence):\n            return False\n        if not isinstance(n, int):\n            return False\n        if n < 0:\n            return False\n        return True\n\n```\n```python\n# /tests/test_is_majority.py\nimport pytest\nfrom src.is_majority import is_majority\n\ndef test_srs_example_is_majority():\n    \"\"\"Verifies the specified SRS example where 3 is a majority.\"\"\"\n    assert is_majority([1, 2, 3, 3, 3, 3, 10], 7, 3) is True\n\ndef test_non_majority_case():\n    \"\"\"Tests an array where the element is present but not a majority.\"\"\"\n    assert is_majority([1, 2, 3, 4, 5], 5, 3) is False\n\ndef test_empty_array_n_zero():\n    \"\"\"Tests an empty array with n=0, where no majority is possible.\"\"\"\n    assert is_majority([], 0, 5) is False\n\ndef test_empty_array_n_greater_than_zero():\n    \"\"\"Tests an empty array with n > 0, where no element can be a majority.\"\"\"\n    assert is_majority([], 3, 5) is False\n\ndef test_single_element_array_majority():\n    \"\"\"Tests a single-element array where the element is trivially a majority.\"\"\"\n    assert is_majority([5], 1, 5) is True\n\ndef test_single_element_array_non_majority():\n    \"\"\"Tests a single-element array where another element is checked.\"\"\"\n    assert is_majority([5], 1, 10) is False\n\ndef test_n_equals_length_array_majority():\n    \"\"\"Tests when 'n' matches array length and the element is a majority.\"\"\"\n    assert is_majority([1, 1, 1, 2, 3], 5, 1) is True\n\ndef test_n_equals_length_array_not_majority():\n    \"\"\"Tests when 'n' matches array length and the element is not a majority.\"\"\"\n    assert is_majority([1, 2, 3, 4, 5], 5, 1) is False\n\ndef test_n_less_than_length_array_majority():\n    \"\"\"Tests when 'n' is less than array length and the element is a majority in the considered sub-array.\"\"\"\n    assert is_majority([1, 1, 1, 2, 3, 4, 5], 3, 1) is True\n\ndef test_n_less_than_length_array_not_majority():\n    \"\"\"Tests when 'n' is less than array length and the element is not a majority.\"\"\"\n    assert is_majority([1, 2, 3, 1, 2, 3], 3, 1) is False\n\ndef test_n_greater_than_length_array_majority_present():\n    \"\"\"Tests when 'n' exceeds array length, element is majority within available values.\"\"\"\n    assert is_majority([1, 1, 1], 5, 1) is True # Count=3, n=5, 3 > 5/2 (2.5)\n\ndef test_n_greater_than_length_array_not_majority_present():\n    \"\"\"Tests when 'n' exceeds array length, element is present but not a majority.\"\"\"\n    assert is_majority([1, 1], 5, 1) is False # Count=2, n=5, 2 > 5/2 (2.5) is False.\n\ndef test_n_greater_than_length_array_not_majority_absent():\n    \"\"\"Tests when 'n' exceeds array length, element is not present.\"\"\"\n    assert is_majority([1, 2], 5, 3) is False\n\ndef test_no_element_present():\n    \"\"\"Tests a case where the target element is completely absent from the array.\"\"\"\n    assert is_majority([1, 2, 3, 4, 5], 5, 10) is False\n\ndef test_half_count_not_majority():\n    \"\"\"Tests a case where the count is exactly n/2, which is not strictly a majority.\"\"\"\n    assert is_majority([1, 1, 2, 2], 4, 1) is False # Count=2, n=4, 2*2 > 4 is False.\n\ndef test_invalid_array_type():\n    \"\"\"Tests with an invalid type for 'array' input.\"\"\"\n    assert is_majority(123, 5, 1) is False\n\ndef test_invalid_n_type():\n    \"\"\"Tests with an invalid type for 'n' input.\"\"\"\n    assert is_majority([1, 2, 3], \"5\", 1) is False\n\ndef test_negative_n_value():\n    \"\"\"Tests with a negative value for 'n' input.\"\"\"\n    assert is_majority([1, 2, 3], -1, 1) is False\n\ndef test_float_n_value():\n    \"\"\"Tests with a float value for 'n' input, which should be rejected.\"\"\"\n    assert is_majority([1, 2, 3], 3.0, 1) is False\n\ndef test_array_as_tuple():\n    \"\"\"Tests with a tuple as input 'array', which is a valid sequence.\"\"\"\n    assert is_majority((1, 1, 1, 2, 3), 5, 1) is True\n\ndef test_array_as_string_majority():\n    \"\"\"Tests with a string as input 'array' where a character is a majority.\"\"\"\n    assert is_majority(\"aaaabc\", 6, 'a') is True # Count=4, n=6, 4*2 > 6 is True.\n\n```"}
