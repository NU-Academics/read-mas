{"task_id": "Mbpp/165", "solution": "```python\n# src/__init__.py\n\"\"\"\nPackage marker for the src directory.\n\"\"\"\n```\n```python\n# src/input_string.py\n\"\"\"\nEncapsulates raw input string with length and emptiness checks.\n\"\"\"\n\nclass InputString:\n    \"\"\"Represents the input string for character position counting.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the encapsulated string is empty.\"\"\"\n        return self.length() == 0\n\n```\n```python\n# src/alphabet.py\n\"\"\"\nProvides the English alphabet and 1-based mapping functionality.\n\"\"\"\n\nclass Alphabet:\n    \"\"\"Manages the English alphabet for position-based lookups.\"\"\"\n    def __init__(self) -> None:\n        self.letters = \"abcdefghijklmnopqrstuvwxyz\"\n        self.size = 26\n\n    def letterAt(self, position: int) -> str:\n        \"\"\"\n        Returns the character at a given 1-based position in the alphabet.\n        Assumes position is within bounds (1 to 26).\n        \"\"\"\n        return self.letters[position - 1]\n\n```\n```python\n# src/position_match.py\n\"\"\"\nDetermines if a character at a specific position matches the alphabet mapping.\n\"\"\"\n\nfrom src.alphabet import Alphabet\n\nclass PositionMatch:\n    \"\"\"Represents a character at a specific 1-based position and evaluates if it's a match.\"\"\"\n    def __init__(self, position: int, character: str) -> None:\n        self.position = position\n        self.character = character\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Checks if the character is an English alphabet letter.\"\"\"\n        return self.character.isalpha()\n\n    def isMatch(self, alphabet: Alphabet) -> bool:\n        \"\"\"\n        Evaluates if the character matches its 1-based position in the given alphabet.\n        Checks for alphabetic nature and position within alphabet size.\n        \"\"\"\n        if not self.isAlphabetic():\n            return False\n        if self.position > alphabet.size or self.position < 1:\n            return False\n        return self.character.lower() == alphabet.letterAt(self.position)\n\n```\n```python\n# src/matcher.py\n\"\"\"\nProvides the core logic for matching a character at a given position.\n\"\"\"\n\nfrom src.alphabet import Alphabet\nfrom src.position_match import PositionMatch\n\nclass Matcher:\n    \"\"\"Determines if a character at a specific position is a match.\"\"\"\n    def __init__(self) -> None:\n        self._alphabet = Alphabet()\n\n    def matchesAt(self, position: int, character: str) -> bool:\n        \"\"\"\n        Checks if the character at the given 1-based position is a match.\n        Considers case-insensitivity, alphabetic nature, and position limits.\n        \"\"\"\n        # FR6: Treat positions > 26 as non-matching\n        if position > self._alphabet.size:\n            return False\n        # Positions must be 1-based and positive\n        if position < 1:\n            return False\n\n        position_match = PositionMatch(position, character)\n        return position_match.isMatch(self._alphabet)\n\n```\n```python\n# src/validator.py\n\"\"\"\nValidates input strings, primarily checking for emptiness.\n\"\"\"\n\nfrom src.input_string import InputString\n\nclass Validator:\n    \"\"\"Validates properties of an InputString, like emptiness.\"\"\"\n    def isValid(self, input: InputString) -> bool:\n        \"\"\"Checks if the input string is considered valid for processing (i.e., not empty).\"\"\"\n        # BR7: Return 0 for empty input, so an empty input is 'invalid' for counting matches.\n        return not input.isEmpty()\n\n```\n```python\n# src/counter.py\n\"\"\"\nIterates through an input string and accumulates character position matches.\n\"\"\"\n\nfrom src.input_string import InputString\nfrom src.matcher import Matcher\n\nclass Counter:\n    \"\"\"Counts matching characters in an InputString based on a Matcher.\"\"\"\n    def countMatches(self, input: InputString, matcher: Matcher) -> int:\n        \"\"\"\n        Iterates through the input string and counts characters that match their position.\n        \"\"\"\n        total_count = 0\n        for i in range(input.length()):\n            position = i + 1  # 1-based position\n            character = input.value[i]\n            if matcher.matchesAt(position, character):\n                total_count += 1\n        return total_count\n\n```\n```python\n# src/count_char_position.py\n\"\"\"\nMain entry point for the character position counting functionality.\n\"\"\"\n\nfrom src.input_string import InputString\nfrom src.validator import Validator\nfrom src.matcher import Matcher\nfrom src.counter import Counter\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based position in the alphabet.\n    Compares case-insensitively, excludes non-alphabetic chars and positions > 26.\n    \"\"\"\n    input_str_obj = InputString(input_string)\n    validator = Validator()\n\n    # FR7/BR7: Return 0 for empty input\n    if not validator.isValid(input_str_obj):\n        return 0\n\n    matcher = Matcher()\n    counter = Counter()\n\n    return counter.countMatches(input_str_obj, matcher)\n\n```"}
{"task_id": "Mbpp/165", "solution": "```python\n# src/__init__.py\nfrom .count_char_position import count_char_position\n\n# src/count_char_position.py\ndef _alphabet_index(c: str) -> int:\n    \"\"\"Helper to map a character to its 1-based alphabet index, or 0 if not a letter.\n    Converts input char to lowercase for case-insensitive comparison.\n    \"\"\"\n    c_norm = c.lower()\n    if 'a' <= c_norm <= 'z':\n        return ord(c_norm) - ord('a') + 1\n    else:\n        return 0\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same 1-based position as in the English alphabet.\n    Comparisons are case-insensitive; non A-Z letters are ignored for matching.\n    \"\"\"\n    if not input:\n        return 0\n\n    match_count = 0\n    # Iterate over characters with 1-based position.\n    for position, char in enumerate(input, 1):\n        # Characters at positions greater than 26 never match, as per design.\n        if position > 26:\n            continue\n\n        alpha_idx = _alphabet_index(char)\n\n        # A character matches if it's an English letter (alpha_idx != 0)\n        # and its alphabet index equals its 1-based position.\n        if alpha_idx != 0 and alpha_idx == position:\n            match_count += 1\n\n    return match_count\n```"}
{"task_id": "Mbpp/166", "solution": "def _count_combinations(n: int) -> int:\n    \"\"\"Calculates nC2 combinations. Returns 0 if n is less than 2.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\n\ndef find_even_pair(input: list[int]) -> int:\n    \"\"\"Counts pairs of integers whose bitwise XOR is even and elements have the same parity.\"\"\"\n    even_count = 0\n    odd_count = 0\n    for num in input:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return _count_combinations(even_count) + _count_combinations(odd_count)"}
{"task_id": "Mbpp/166", "solution": "```python\nfrom typing import List\n\ndef find_even_pair(values: List[int]) -> int:\n    \"\"\"Counts unordered index-pairs (i < j) whose bitwise XOR is even.\n    Returns 0 for input lists with fewer than two elements.\n    \"\"\"\n    n = len(values)\n    if n < 2:\n        return 0\n\n    n_even = 0\n    n_odd = 0\n    for v in values:\n        if (v % 2) == 0:\n            n_even += 1\n        else:\n            n_odd += 1\n\n    # The number of pairs is C(n_even, 2) + C(n_odd, 2)\n    # where C(k, 2) = k * (k - 1) / 2\n    return (n_even * (n_even - 1)) // 2 + (n_odd * (n_odd - 1)) // 2\n```"}
