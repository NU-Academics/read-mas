{"task_id": "Mbpp/237", "solution": "```python\n# src/domain.py\nclass TupleItem:\n    \"\"\"Represents a 2-element tuple item and provides normalization behavior.\n    It supports equality and hashing for use as dictionary keys.\n    \"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def normalize(self):\n        \"\"\"Returns a TupleItem with elements in ascending order.\"\"\"\n        if self.a <= self.b:\n            return TupleItem(self.a, self.b)\n        else:\n            return TupleItem(self.b, self.a)\n\n    def to_tuple(self):\n        \"\"\"Converts the TupleItem to a standard Python 2-element tuple.\"\"\"\n        return (self.a, self.b)\n\n    def __eq__(self, other):\n        \"\"\"Compares two TupleItem instances for equality based on their elements.\"\"\"\n        if not isinstance(other, TupleItem):\n            return NotImplemented\n        return self.a == other.a and self.b == other.b\n\n    def __hash__(self):\n        \"\"\"Provides a hash for TupleItem instances, making them suitable as dictionary keys.\"\"\"\n        return hash((self.a, self.b))\n\nclass CountEntry:\n    \"\"\"Associates a TupleItem key with an integer count.\"\"\"\n    def __init__(self, key: TupleItem, count: int = 0):\n        self.key = key\n        self.count = count\n\n\n# src/normalizer.py\nfrom src.domain import TupleItem\n\nclass Normalizer:\n    \"\"\"Encapsulates normalization logic for 2-element tuples.\"\"\"\n    def normalizeTuple(self, t: tuple) -> TupleItem:\n        \"\"\"Normalizes an input 2-element tuple into a TupleItem with ascending-order elements.\"\"\"\n        item = TupleItem(t[0], t[1])\n        return item.normalize()\n\n\n# src/result_dictionary.py\nfrom src.domain import TupleItem, CountEntry\n\nclass ResultDictionary:\n    \"\"\"Maintains counts for normalized TupleItem keys and produces the final dictionary.\"\"\"\n    def __init__(self):\n        self._data: dict[TupleItem, CountEntry] = {}\n\n    def increment(self, key: TupleItem) -> None:\n        \"\"\"Increments the count for a given normalized TupleItem key.\"\"\"\n        if key not in self._data:\n            self._data[key] = CountEntry(key, 0)\n        self._data[key].count += 1\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a dictionary with Python 2-element tuple keys and integer counts.\"\"\"\n        final_dict = {}\n        for tuple_item, count_entry in self._data.items():\n            final_dict[tuple_item.to_tuple()] = count_entry.count\n        return final_dict\n\n\n# src/check_occurences.py\nfrom src.normalizer import Normalizer\nfrom src.result_dictionary import ResultDictionary\nfrom src.domain import TupleItem # Imported for design consistency, though not directly used in function body.\n\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"Accepts a list of 2-element tuples and returns a dict mapping normalized 2-element tuples to int counts.\"\"\"\n    if not input_list:\n        return {}\n\n    normalizer = Normalizer()\n    result_store = ResultDictionary()\n\n    for item_tuple in input_list:\n        normalized_item = normalizer.normalizeTuple(item_tuple)\n        result_store.increment(normalized_item)\n\n    return result_store.to_dict()\n```"}
{"task_id": "Mbpp/238", "solution": "```python\n# src/substring_counter.py\n\"\"\"Module providing number_of_substrings(s: str) -> int per design.\"\"\"\n\ndef _compute_by_formula(n: int) -> int:\n    \"\"\"Compute n*(n+1)//2 using integer arithmetic.\"\"\"\n    return n * (n + 1) // 2\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"Public API: validate s is str, return 0 for empty string, otherwise return count.\n    Raises TypeError if s is not a str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n    n = len(s)\n    if n == 0:\n        return 0\n    return _compute_by_formula(n)\n\n```\n```python\n# tests/test_substring_counter.py\nimport pytest\nfrom substring_counter import number_of_substrings\n\ndef test_number_of_substrings_abc():\n    \"\"\"Asserts the correct count for 'abc'.\"\"\"\n    assert number_of_substrings(\"abc\") == 6\n\ndef test_number_of_substrings_empty():\n    \"\"\"Asserts that an empty string returns 0.\"\"\"\n    assert number_of_substrings(\"\") == 0\n\ndef test_number_of_substrings_invalid_type():\n    \"\"\"Verifies TypeError is raised for non-string inputs.\"\"\"\n    with pytest.raises(TypeError):\n        number_of_substrings(None)\n\n```"}
{"task_id": "Mbpp/237", "solution": "```python\n# src/occurrence_counter.py\n\nclass OccurrenceCounter:\n    def _normalize_pair(self, a, b) -> tuple:\n        \"\"\"Returns a 2-element tuple with its elements ordered non-decreasingly.\"\"\"\n        return (min(a, b), max(a, b))\n\n    def check_occurences(self, list_of_tuples) -> dict:\n        \"\"\"Counts occurrences of normalized tuples and returns a dictionary of counts.\"\"\"\n        counts = {}\n        for item_a, item_b in list_of_tuples:\n            normalized_tuple = self._normalize_pair(item_a, item_b)\n            counts[normalized_tuple] = counts.get(normalized_tuple, 0) + 1\n        return counts\n\ndef check_occurences(list_of_tuples) -> dict:\n    \"\"\"Public API: processes a list of 2-element tuples to count normalized occurrences.\"\"\"\n    return OccurrenceCounter().check_occurences(list_of_tuples)\n\n```\n```python\n# tests/test_check_occurences.py\n\nfrom src.occurrence_counter import check_occurences\n\ndef test_example_assertion():\n    \"\"\"Verifies the example acceptance test for normalized tuple occurrence counting.\"\"\"\n    input_list = [(3, 1), (1, 3), (2, 5), (5, 2), (6, 3)]\n    expected_output = {(1, 3): 2, (2, 5): 2, (3, 6): 1}\n    assert check_occurences(input_list) == expected_output\n\n```"}
{"task_id": "Mbpp/239", "solution": "```python\nfrom typing import List\n\nclass Parameters:\n    \"\"\"Holds the input parameters m and n.\"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Stub for validation, actual validation is done by Validator.\"\"\"\n        pass\n\nclass Validator:\n    \"\"\"Validates input parameters and raises ValueError for invalid inputs.\"\"\"\n    def validateParams(self, parameters: Parameters) -> None:\n        \"\"\"Ensures m and n are positive integers.\"\"\"\n        if not isinstance(parameters.m, int) or not isinstance(parameters.n, int):\n            self.raiseValueError(\"m and n must be integers.\")\n        if parameters.m <= 0 or parameters.n <= 0:\n            self.raiseValueError(\"m and n must be positive integers.\")\n\n    def raiseValueError(self, msg: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(msg)\n\nclass SequenceElement:\n    \"\"\"Represents a value at a specific position in a sequence.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\nclass Sequence:\n    \"\"\"A container for SequenceElement objects, capable of verifying its own validity.\"\"\"\n    def __init__(self, elements: List[SequenceElement]):\n        self.elements = elements\n\n    def isValid(self, parameters: Parameters) -> bool:\n        \"\"\"Verifies sequence constraints: 1 <= a_i <= m and a_i >= 2 * a_{i-1} for i > 1.\"\"\"\n        if not self.elements:\n            return False\n\n        # Check all elements against m and the doubling constraint.\n        for i in range(len(self.elements)):\n            current_val = self.elements[i].value\n            if not (1 <= current_val <= parameters.m):\n                return False\n            if i > 0:\n                prev_val = self.elements[i-1].value\n                if not (2 * prev_val <= current_val):\n                    return False\n        return True\n\n    def __eq__(self, other):\n        \"\"\"Checks if two sequences are equal by comparing their element values.\"\"\"\n        if not isinstance(other, Sequence):\n            return NotImplemented\n        return [e.value for e in self.elements] == [e.value for e in other.elements]\n\n    def __hash__(self):\n        \"\"\"Enables hashing for sequences, useful for deduplication.\"\"\"\n        return hash(tuple(e.value for e in self.elements))\n\nclass SequenceGenerator:\n    \"\"\"Generates all valid sequences given parameters.\"\"\"\n    def generateAll(self, parameters: Parameters) -> List[Sequence]:\n        \"\"\"Enumerates sequences of length n, satisfying constraints using backtracking.\"\"\"\n        all_sequences: List[Sequence] = []\n        \n        def backtrack(current_sequence_elements: List[SequenceElement]):\n            current_length = len(current_sequence_elements)\n\n            if current_length == parameters.n:\n                all_sequences.append(Sequence(list(current_sequence_elements)))\n                return\n\n            start_val = 1 if current_length == 0 else (2 * current_sequence_elements[-1].value)\n            \n            for value in range(start_val, parameters.m + 1):\n                # Prune if the current value itself exceeds m.\n                if value > parameters.m:\n                    break\n                \n                current_sequence_elements.append(SequenceElement(value, current_length + 1))\n                backtrack(current_sequence_elements)\n                current_sequence_elements.pop() # Backtrack\n\n        # For n = 1, sequences are simply 1-element sequences from 1 to m.\n        if parameters.n == 1:\n            for val in range(1, parameters.m + 1):\n                all_sequences.append(Sequence([SequenceElement(val, 1)]))\n        elif parameters.n > 1:\n            backtrack([])\n\n        return all_sequences\n\nclass Result:\n    \"\"\"Encapsulates the final count of sequences.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass SequenceCounter:\n    \"\"\"Counts distinct valid sequences and returns the total count.\"\"\"\n    def count(self, sequences: List[Sequence]) -> int:\n        \"\"\"Deduplicates sequences and returns the integer count.\"\"\"\n        distinct_sequences = set(sequences)\n        return len(distinct_sequences)\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of length n with elements in 1..m\n    subject to the doubling constraint a_i >= 2*a_{i-1}.\n    \"\"\"\n    parameters = Parameters(m, n)\n    Validator().validateParams(parameters)\n\n    if parameters.n == 1:\n        return parameters.m\n\n    sequences = SequenceGenerator().generateAll(parameters)\n    count = SequenceCounter().count(sequences)\n    \n    return count\n```"}
{"task_id": "Mbpp/239", "solution": "```python\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Counts ordered sequences of length n with values in [1, m] satisfying a_i >= 2 * a_{i-1}.\n    Uses a recursive helper with memoization to efficiently compute the count.\n    \"\"\"\n    \n    # Memoization cache for the recursive countFrom function.\n    memo = {}\n\n    def countFrom(current_val: int, remaining_elements: int) -> int:\n        \"\"\"\n        Recursively counts valid sequence extensions from `current_val` with `remaining_elements` to add.\n        The base case returns 1 if no more elements are needed, indicating a complete valid sequence.\n        \"\"\"\n        if (current_val, remaining_elements) in memo:\n            return memo[(current_val, remaining_elements)]\n\n        if remaining_elements == 0:\n            return 1\n\n        total_count_for_path = 0\n        \n        # Calculate the minimum possible value for the next element based on the doubling constraint.\n        next_min_val = 2 * current_val\n\n        # Iterate through all valid possible values for the next element, up to m.\n        for next_val in range(next_min_val, m + 1):\n            # Recursively count further extensions from this next_val.\n            total_count_for_path += countFrom(next_val, remaining_elements - 1)\n\n        memo[(current_val, remaining_elements)] = total_count_for_path\n        return total_count_for_path\n\n    total_sequences = 0\n    # Iterate through all possible values for the first element (a_1) of the sequence.\n    # Since n is a positive integer, n >= 1.\n    for first_val in range(1, m + 1):\n        # For each `first_val`, count how many sequences of length `n-1` can follow it.\n        total_sequences += countFrom(first_val, n - 1)\n\n    return total_sequences\n```"}
