{"task_id": "Mbpp/119", "solution": "```python\n# src/search.py\nfrom typing import List\n\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the unique integer that appears once in a sorted list,\n    where all other integers appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # If mid is at an even index, compare with the next element\n        if mid % 2 == 0:\n            if nums[mid] == nums[mid + 1]:\n                # The pair (nums[mid], nums[mid+1]) is normal; unique element is to the right.\n                low = mid + 2\n            else:\n                # The pattern is broken; unique element is at or to the left of mid.\n                high = mid\n        # If mid is at an odd index, compare with the previous element\n        else: # mid % 2 == 1\n            if nums[mid] == nums[mid - 1]:\n                # The pair (nums[mid-1], nums[mid]) is normal; unique element is to the right.\n                low = mid + 1\n            else:\n                # The pattern is broken; unique element is at or to the left of mid-1.\n                high = mid - 1\n\n    # When the loop terminates, low == high, pointing to the unique element.\n    return nums[low]\n\n```\n```python\n# tests/test_search.py\nfrom src.search import search\n\nassert search([1,1,2,2,3]) == 3\n\n```"}
{"task_id": "Mbpp/120", "solution": "```python\n# src/__init__.py\n__all__ = ['max_product_tuple']\nfrom .max_product_tuple import max_product_tuple\n\n```\n```python\n# src/max_product_tuple.py\n\nclass Tuple2:\n    \"\"\"Represents a 2-element numeric tuple and computes its product.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> float:\n        \"\"\"Computes and returns the product of the tuple's elements.\"\"\"\n        return self.a * self.b\n\n\nclass InputList:\n    \"\"\"Represents the input collection and validates its structure.\"\"\"\n    def __init__(self, raw_input: object) -> None:\n        self._raw = raw_input\n        self.tuples: list[Tuple2] = []\n\n    def validate(self) -> bool:\n        \"\"\"Validates the raw input and populates the internal list of Tuple2 instances.\n        Raises ValueError for invalid input or structure.\"\"\"\n        if not isinstance(self._raw, list):\n            raise ValueError(\"Input must be a list.\")\n\n        if not self._raw:\n            # Design decision: empty list after initial type check is considered invalid.\n            raise ValueError(\"Input list cannot be empty.\")\n\n        for i, item in enumerate(self._raw):\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(f\"Element at index {i} must be a 2-element tuple.\")\n            \n            a, b = item\n            if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n                raise ValueError(f\"Elements of tuple at index {i} must be numeric.\")\n            \n            self.tuples.append(Tuple2(float(a), float(b)))\n        \n        return True\n\n\nclass ProductCalculation:\n    \"\"\"Provides calculation utilities for products and absolute values.\"\"\"\n    def computeProduct(self, t: Tuple2) -> float:\n        \"\"\"Computes the product of a Tuple2 instance.\"\"\"\n        return t.product()\n\n    def absValue(self, n: float) -> float:\n        \"\"\"Returns the absolute value of a number.\"\"\"\n        return abs(n)\n\n\nclass Result:\n    \"\"\"Holds and updates the maximum absolute product during processing.\"\"\"\n    def __init__(self) -> None:\n        self.maxAbsoluteProduct: float | None = None\n\n    def set(self, value: float) -> None:\n        \"\"\"Updates the maximum absolute product if the new value is greater.\"\"\"\n        if self.maxAbsoluteProduct is None or value > self.maxAbsoluteProduct:\n            self.maxAbsoluteProduct = value\n\n    def get(self) -> float:\n        \"\"\"Returns the final maximum absolute product.\n        Raises ValueError if no product was set (e.g., from empty input).\"\"\"\n        if self.maxAbsoluteProduct is None:\n            raise ValueError(\"No maximum product could be determined from the input.\")\n        return self.maxAbsoluteProduct\n\n\ndef max_product_tuple(input_list: list[tuple]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Orchestrates validation, product calculation, and maximum selection.\n    \"\"\"\n    input_obj = InputList(input_list)\n    input_obj.validate()\n\n    calc = ProductCalculation()\n    result = Result()\n\n    for t in input_obj.tuples:\n        product = calc.computeProduct(t)\n        abs_prod = calc.absValue(product)\n        result.set(abs_prod)\n\n    return result.get()\n\n```\n```python\n# tests/test_max_product_tuple.py\nfrom src.max_product_tuple import max_product_tuple\n\n# SRS-provided unit assertion for verification.\nassert max_product_tuple([(2, 7), (2, 6), (1, 8), (4, 9)]) == 36\n\n```"}
{"task_id": "Mbpp/120", "solution": "```python\nfrom typing import List, Tuple, Iterator\nfrom dataclasses import dataclass\n\n@dataclass\nclass TuplePair:\n    \"\"\"Represents a pair of numbers for product computation.\"\"\"\n    a: float\n    b: float\n\n    def abs_product(self) -> float:\n        \"\"\"Computes the absolute product of the pair's elements.\"\"\"\n        return abs(self.a * self.b)\n\nclass TupleList:\n    \"\"\"A container for a list of TuplePair objects.\"\"\"\n    _tuples: List[TuplePair]\n\n    def __init__(self, tuples: List[Tuple[float, float]]) -> None:\n        \"\"\"Initializes TupleList from a list of raw (float, float) tuples.\"\"\"\n        self._tuples = [TuplePair(float(a), float(b)) for a, b in tuples]\n\n    def __iter__(self) -> Iterator[TuplePair]:\n        \"\"\"Returns an iterator over the contained TuplePair objects.\"\"\"\n        return iter(self._tuples)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of TuplePair objects in the list.\"\"\"\n        return len(self._tuples)\n\n@dataclass\nclass ProductResult:\n    \"\"\"Holds the result of a product calculation.\"\"\"\n    value: float\n\n    def as_number(self) -> float:\n        \"\"\"Returns the raw numeric value of the product result.\"\"\"\n        return self.value\n\ndef max_product_tuple(input_list: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Computes the maximum absolute product from a list of 2-element tuples.\n    Example: max_product_tuple([(2, 7), (2, 6), (1, 8), (4, 9)]) == 36.\n    \"\"\"\n    tuple_list_obj = TupleList(input_list)\n    absolute_products = [tp.abs_product() for tp in tuple_list_obj]\n    \n    # max() will raise ValueError for an empty list, adhering to \"simplest, most direct logic\".\n    max_val = max(absolute_products) \n    \n    return ProductResult(max_val).as_number()\n```"}
{"task_id": "Mbpp/119", "solution": "```python\n# src/__init__.py\nfrom src.search_function import search\n\n__all__ = [\"search\"]\n\n# src/domain.py\nfrom typing import Any\n\nclass Element:\n    \"\"\"Represents an element with its value and occurrences.\"\"\"\n    def __init__(self, value: int, occurrences: int) -> None:\n        self.value = value\n        self.occurrences = occurrences\n\nclass Result:\n    \"\"\"Wraps the result value of the search operation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass TestCase:\n    \"\"\"Represents a test case with an assertion string.\"\"\"\n    def __init__(self, assertion: str) -> None:\n        self.assertion = assertion\n\n    def run(self) -> None:\n        \"\"\"Executes the test case's assertion (conceptual).\"\"\"\n        pass\n\n\n# src/input_list.py\nfrom typing import List\n\ndef _is_non_decreasing(values: List[int]) -> bool:\n    \"\"\"Checks if a list of values is sorted in non-decreasing order.\"\"\"\n    if not values:\n        return True\n    for i in range(len(values) - 1):\n        if values[i] > values[i+1]:\n            return False\n    return True\n\nclass InputList:\n    \"\"\"A wrapper for input lists, providing validation utilities.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self._values = values\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if the wrapped list is sorted.\"\"\"\n        return _is_non_decreasing(self._values)\n\n\n# src/search_function.py\nfrom typing import List\nfrom src.input_list import InputList\nfrom src.domain import Result\n\nclass SearchFunction:\n    \"\"\"Encapsulates validation and the binary search algorithm.\"\"\"\n\n    @staticmethod\n    def validate_input(nums: List[int]) -> None:\n        \"\"\"Validates the input list for non-empty, sorted, and odd length.\"\"\"\n        if not nums:\n            raise ValueError(\"Input list must be non-empty, sorted, and contain exactly one unique element.\")\n        \n        input_wrapper = InputList(nums)\n        if not input_wrapper.is_sorted():\n            raise ValueError(\"Input list must be non-empty, sorted, and contain exactly one unique element.\")\n        \n        # Ensures list length allows for exactly one unique element with pairs.\n        if len(nums) % 2 == 0:\n            raise ValueError(\"Input list must be non-empty, sorted, and contain exactly one unique element.\")\n\n    @staticmethod\n    def _binary_search_unique(nums: List[int]) -> int:\n        \"\"\"Performs a binary search to find the unique element based on index parity.\"\"\"\n        low = 0\n        high = len(nums) - 1\n\n        while low < high:\n            mid = (low + high) // 2\n\n            if mid % 2 == 0:  # mid is at an even index\n                if nums[mid] == nums[mid+1]:\n                    # The current element is part of a pair (mid, mid+1).\n                    # The unique element must be further to the right.\n                    low = mid + 2\n                else:\n                    # The current element is not paired with mid+1.\n                    # The unique element is at or to the left of mid.\n                    high = mid\n            else:  # mid is at an odd index\n                if nums[mid] == nums[mid-1]:\n                    # The current element is part of a pair (mid-1, mid).\n                    # The unique element must be further to the right.\n                    low = mid + 1\n                else:\n                    # The current element is not paired with mid-1.\n                    # The unique element is at or to the left of mid.\n                    high = mid\n        \n        return nums[low]\n\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted integer list.\n    Every other element appears exactly twice.\n    \"\"\"\n    SearchFunction.validate_input(nums)\n    result_value = SearchFunction._binary_search_unique(nums)\n    return result_value\n```"}
{"task_id": "Mbpp/123", "solution": "```python\n# src/models.py\nfrom typing import List\n\nclass Number:\n    \"\"\"Represents an integer with its proper divisors and their sum.\"\"\"\n    def __init__(self, value: int, divisors: List[int]) -> None:\n        self.value = value\n        self.divisors = divisors\n        self.sumProperDivisors = sum(divisors)\n\nclass AmicablePair:\n    \"\"\"Represents a pair of amicable numbers.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\nclass Result:\n    \"\"\"Aggregates found amicable numbers and their total sum.\"\"\"\n    def __init__(self, members: List[int]) -> None:\n        self.members = members\n        self.sum = sum(members)\n\n```\n```python\n# src/amicable_calculator.py\nimport math\nfrom typing import List, Dict\n\nclass AmicableCalculator:\n    \"\"\"Calculates proper divisors, their sums, and sums of amicable numbers.\"\"\"\n    def __init__(self) -> None:\n        self._divisor_cache: Dict[int, List[int]] = {}\n\n    def _validate_limit(self, limit: int) -> None:\n        \"\"\"Validates that the limit is a positive integer.\"\"\"\n        if not isinstance(limit, int) or limit <= 0:\n            raise ValueError(\"Limit must be a positive integer.\")\n\n    def properDivisors(self, n: int) -> List[int]:\n        \"\"\"Computes and returns proper divisors of n, excluding n itself.\"\"\"\n        if n in self._divisor_cache:\n            return self._divisor_cache[n]\n        if n <= 1:\n            return []\n\n        divs = {1} # 1 is always a proper divisor for n > 1\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        \n        self._divisor_cache[n] = sorted(list(divs))\n        return self._divisor_cache[n]\n\n    def sumProperDivisors(self, n: int) -> int:\n        \"\"\"Returns the sum of proper divisors of n.\"\"\"\n        return sum(self.properDivisors(n))\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        \"\"\"Calculates the sum of all amicable numbers up to the given limit.\"\"\"\n        self._validate_limit(limit)\n        \n        found_amicable_numbers = set()\n        \n        for a in range(1, limit + 1):\n            b = self.sumProperDivisors(a)\n\n            # Check for amicable pair conditions: a != b, b <= limit, and sumProperDivisors(b) == a\n            if a != b and b <= limit:\n                if self.sumProperDivisors(b) == a:\n                    found_amicable_numbers.add(a)\n                    found_amicable_numbers.add(b)\n                    \n        return sum(found_amicable_numbers)\n\n```\n```python\n# src/main.py\nfrom amicable_calculator import AmicableCalculator\n\ndef main() -> None:\n    \"\"\"Runs the amicable numbers sum calculation for verification.\"\"\"\n    calculator = AmicableCalculator()\n    result = calculator.amicable_numbers_sum(999)\n\n    print(f\"Sum of amicable numbers up to 999: {result}\")\n    assert result == 504, \"Acceptance test failed: amicable_numbers_sum(999) should be 504\"\n    print(\"Verification successful: amicable_numbers_sum(999) == 504\")\n\nif __name__ == '__main__':\n    main()\n\n```\n```python\n# tests/test_amicable.py\nimport pytest\nfrom src.amicable_calculator import AmicableCalculator\n\n@pytest.fixture\ndef calculator():\n    \"\"\"Provides a fresh AmicableCalculator instance for each test.\"\"\"\n    return AmicableCalculator()\n\ndef test_proper_divisors_examples(calculator):\n    \"\"\"Verifies proper divisors for specific numbers.\"\"\"\n    assert calculator.properDivisors(1) == []\n    assert calculator.properDivisors(2) == [1]\n    assert calculator.properDivisors(6) == [1, 2, 3]\n    assert calculator.properDivisors(220) == [1, 2, 4, 5, 10, 11, 20, 22, 44, 55, 110]\n    assert calculator.properDivisors(284) == [1, 2, 4, 71, 142]\n\ndef test_sumProperDivisors_example(calculator):\n    \"\"\"Verifies sums of proper divisors for known cases.\"\"\"\n    assert calculator.sumProperDivisors(1) == 0\n    assert calculator.sumProperDivisors(2) == 1\n    assert calculator.sumProperDivisors(6) == 6\n    assert calculator.sumProperDivisors(220) == 284\n    assert calculator.sumProperDivisors(284) == 220\n\ndef test_amicable_numbers_sum_999(calculator):\n    \"\"\"Verifies the acceptance case for amicable numbers sum up to 999.\"\"\"\n    assert calculator.amicable_numbers_sum(999) == 504\n\ndef test_amicable_numbers_sum_limit_validation(calculator):\n    \"\"\"Ensures limit validation raises ValueError for invalid inputs.\"\"\"\n    with pytest.raises(ValueError, match=\"Limit must be a positive integer.\"):\n        calculator.amicable_numbers_sum(0)\n    with pytest.raises(ValueError, match=\"Limit must be a positive integer.\"):\n        calculator.amicable_numbers_sum(-10)\n    with pytest.raises(ValueError, match=\"Limit must be a positive integer.\"):\n        calculator.amicable_numbers_sum(10.5)\n    with pytest.raises(ValueError, match=\"Limit must be a positive integer.\"):\n        calculator.amicable_numbers_sum(\"abc\")\n\ndef test_amicable_numbers_sum_no_amicable_below_220(calculator):\n    \"\"\"Checks sums for limits where no amicable numbers should be found.\"\"\"\n    assert calculator.amicable_numbers_sum(219) == 0\n    assert calculator.amicable_numbers_sum(283) == 0\n\ndef test_amicable_numbers_sum_includes_first_pair(calculator):\n    \"\"\"Confirms 220 and 284 are correctly included for the first time.\"\"\"\n    assert calculator.amicable_numbers_sum(220) == 220\n    assert calculator.amicable_numbers_sum(284) == 504 # Includes both 220 and 284\n\ndef test_divisor_cache_efficiency(calculator, mocker):\n    \"\"\"Tests if properDivisors uses caching effectively.\"\"\"\n    spy_properDivisors = mocker.spy(calculator, 'properDivisors')\n\n    # First call should compute and cache\n    calculator.sumProperDivisors(220)\n    assert spy_properDivisors.call_count == 1\n\n    # Second call for the same number should use cache\n    calculator.sumProperDivisors(220)\n    assert spy_properDivisors.call_count == 2 # This spy tracks all calls, not just computation.\n                                            # The check for cache hit is internal.\n\n    # To specifically test cache hit, we need to inspect the _divisor_cache directly\n    # or mock math.sqrt or the divisor calculation loop.\n    # For now, rely on sumProperDivisors internal behavior.\n\n    # A more direct cache check\n    calculator.properDivisors(100)\n    assert 100 in calculator._divisor_cache\n    \n    initial_cache_size = len(calculator._divisor_cache)\n    calculator.properDivisors(100) # Should hit cache\n    assert len(calculator._divisor_cache) == initial_cache_size # No new entry\n\n    calculator.properDivisors(101) # Should add new entry\n    assert len(calculator._divisor_cache) == initial_cache_size + 1\n```"}
{"task_id": "Mbpp/124", "solution": "```python\n# src/__init__.py\n__all__ = ['angle_complex']\n\nfrom .angle_complex import angle_complex\n\n# src/angle_complex.py\nimport math\nfrom typing import Tuple, Union\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number's real and imag components.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\n    def to_polar(self) -> Tuple[float, float]:\n        \"\"\"Returns the magnitude and argument (r, theta) of the complex number.\"\"\"\n        r = math.hypot(self.real, self.imag)\n        theta = math.atan2(self.imag, self.real)\n        return (r, theta)\n\nclass AngleResult:\n    \"\"\"Simple holder for the resulting angle in radians.\"\"\"\n    def __init__(self, radians: float):\n        self.radians = radians\n\nclass InputValidator:\n    \"\"\"Centralized input validation and conversion to numeric types.\"\"\"\n    def validate_numeric(self, value: Union[int, float, str, complex], role: str = 'value') -> float:\n        \"\"\"Attempts to convert a value to float, handling complex literals for 'imag' role.\"\"\"\n        if isinstance(value, complex):\n            # Special handling for Python-style imaginary literals for 'imag' input\n            if role == 'imag':\n                return value.imag\n            else:\n                # For 'real' input, complex numbers are not expected\n                raise TypeError(f\"'{role}' input cannot be a complex number like '{value}'.\")\n        try:\n            return float(value)\n        except (ValueError, TypeError) as e:\n            raise TypeError(f\"'{role}' input must be numeric or convertible to numeric, got '{value}' of type {type(value).__name__}.\") from e\n\n    def validate_pair(self, real: Union[int, float, str, complex], imag: Union[int, float, str, complex]) -> Tuple[float, float]:\n        \"\"\"Validates and converts both real and imag inputs to floats.\"\"\"\n        real_f = self.validate_numeric(real, role='real')\n        imag_f = self.validate_numeric(imag, role='imag')\n        return (real_f, imag_f)\n\nclass AngleCalculator:\n    \"\"\"Computes the angle (argument) of a ComplexNumber.\"\"\"\n    def compute_angle(self, c: ComplexNumber) -> float:\n        \"\"\"Calculates the angle using math.atan2(imag, real).\"\"\"\n        return math.atan2(c.imag, c.real)\n\ndef angle_complex(real: Union[int, float, str, complex], imag: Union[int, float, str, complex]) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number from its real and imaginary parts.\n    Handles input validation and uses atan2(imag, real) for calculation.\n    \"\"\"\n    validator = InputValidator()\n    real_f, imag_f = validator.validate_pair(real, imag)\n\n    complex_num = ComplexNumber(real_f, imag_f)\n    calculator = AngleCalculator()\n    radians = calculator.compute_angle(complex_num)\n\n    angle_result = AngleResult(radians)\n    return angle_result.radians\n```"}
{"task_id": "Mbpp/123", "solution": "```python\n# src/models.py\n\nclass Number:\n    \"\"\"Represents a number with its properties related to amicable calculations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n        self.sumOfProperDivisors: int | None = None\n        self.isAmicable: bool = False\n\nclass AmicablePair:\n    \"\"\"Represents an identified amicable pair.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a: int = a\n        self.b: int = b\n\nclass Result:\n    \"\"\"Accumulates the sum of amicable numbers.\"\"\"\n    def __init__(self, sum_value: int = 0) -> None:\n        self.sum: int = sum_value\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the accumulated sum.\"\"\"\n        self.sum += value\n\n```\n```python\n# src/validator.py\n\nclass Validator:\n    \"\"\"Validates input parameters according to design rules.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validateInput(self, n) -> None:\n        \"\"\"Validates that n is an integer >= 1, raising ValueError otherwise.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be integer >= 1\")\n\n```\n```python\n# src/divisor_calculator.py\nimport math\n\nclass DivisorCalculator:\n    \"\"\"Computes the sum of proper divisors for a given integer, using an internal cache.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {}\n\n    def sumOfProperDivisors(self, m: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for m.\"\"\"\n        if m <= 0:\n            raise ValueError(\"m must be positive integer\")\n        if m in self._cache:\n            return self._cache[m]\n\n        if m == 1:\n            self._cache[m] = 0\n            return 0\n\n        total_sum = 1  # 1 is always a proper divisor for m > 1\n        limit = int(math.sqrt(m))\n        for i in range(2, limit + 1):\n            if m % i == 0:\n                total_sum += i\n                if i * i != m:\n                    total_sum += m // i\n        self._cache[m] = total_sum\n        return total_sum\n\n```\n```python\n# src/amicable_service.py\nfrom .validator import Validator\nfrom .divisor_calculator import DivisorCalculator\nfrom .models import Number, AmicablePair, Result\n\nclass AmicableService:\n    \"\"\"Orchestrates amicable number detection and summation.\"\"\"\n    def __init__(self, validator: Validator = None, divisor_calculator: DivisorCalculator = None) -> None:\n        self.validator = validator if validator is not None else Validator()\n        self.divisor_calculator = divisor_calculator if divisor_calculator is not None else DivisorCalculator()\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"Public entrypoint to calculate the sum of amicable numbers up to n.\"\"\"\n        self.validator.validateInput(n)\n        number_range = self.generateRange(n)\n        return self.sumAmicableNumbers(number_range)\n\n    def generateRange(self, n: int) -> list[int]:\n        \"\"\"Generates a list of integers from 1 to n.\"\"\"\n        return list(range(1, n + 1))\n\n    def sumAmicableNumbers(self, numbers: list[int]) -> int:\n        \"\"\"Identifies and sums amicable numbers within the provided list.\"\"\"\n        result = Result()\n        all_numbers_data: dict[int, Number] = {}\n        amicable_numbers_to_sum: set[int] = set()\n\n        # First pass: pre-calculate divisor sums for all numbers up to n.\n        for a_val in numbers:\n            num_a = all_numbers_data.get(a_val)\n            if not num_a:\n                num_a = Number(a_val)\n                all_numbers_data[a_val] = num_a\n            \n            if num_a.sumOfProperDivisors is None:\n                num_a.sumOfProperDivisors = self.divisor_calculator.sumOfProperDivisors(a_val)\n\n        # Second pass: check for amicable pairs using pre-calculated sums.\n        for a_val in numbers:\n            num_a = all_numbers_data[a_val]\n            b_val = num_a.sumOfProperDivisors\n\n            if a_val == b_val:\n                continue\n\n            # Ensure b_val is positive before attempting to get its divisors' sum.\n            if b_val <= 0:\n                continue\n\n            num_b = all_numbers_data.get(b_val)\n            # If b_val is outside the initial range (numbers list), create its Number object.\n            if not num_b:\n                num_b = Number(b_val)\n                all_numbers_data[b_val] = num_b # Cache it for future reference.\n            \n            if num_b.sumOfProperDivisors is None:\n                num_b.sumOfProperDivisors = self.divisor_calculator.sumOfProperDivisors(b_val)\n            \n            sum_b = num_b.sumOfProperDivisors\n\n            if sum_b == a_val:  # Amicable pair (a_val, b_val) found\n                num_a.isAmicable = True\n                num_b.isAmicable = True\n                AmicablePair(a_val, b_val) # Instantiate as per design.\n\n                # Add numbers to the sum if they are within the original 'n' range.\n                if a_val in numbers:\n                    amicable_numbers_to_sum.add(a_val)\n                if b_val in numbers:\n                    amicable_numbers_to_sum.add(b_val)\n\n        for val in amicable_numbers_to_sum:\n            result.add(val)\n        return result.sum\n\n# Module-level public API function\n_amicable_service_instance = AmicableService()\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to a specified number n.\"\"\"\n    return _amicable_service_instance.amicable_numbers_sum(n)\n\n```\n```python\n# tests/test_amicable.py\nimport pytest\nfrom src.amicable_service import amicable_numbers_sum\n\ndef test_amicable_numbers_sum_example() -> None:\n    \"\"\"Verification test for the specified example.\"\"\"\n    assert amicable_numbers_sum(999) == 504\n\ndef test_amicable_input_validation() -> None:\n    \"\"\"Validation tests for various invalid input types and values.\"\"\"\n    with pytest.raises(ValueError, match=\"n must be integer >= 1\"):\n        amicable_numbers_sum(0)\n    with pytest.raises(ValueError, match=\"n must be integer >= 1\"):\n        amicable_numbers_sum(-1)\n    with pytest.raises(ValueError, match=\"n must be integer >= 1\"):\n        amicable_numbers_sum(1.5)\n    with pytest.raises(ValueError, match=\"n must be integer >= 1\"):\n        amicable_numbers_sum(\"100\")\n\n```"}
{"task_id": "Mbpp/124", "solution": "```python\n# project-root/src/__init__.py\n# This file marks the directory as a Python package.\n\n# project-root/src/domain.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    real: float\n    imag: float\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts the dataclass instance to a built-in complex number.\"\"\"\n        return complex(self.real, self.imag)\n\n@dataclass\nclass AngleResult:\n    \"\"\"Holds the computed angle of a complex number in radians.\"\"\"\n    radians: float\n\n@dataclass\nclass TestCase:\n    \"\"\"Defines a test case for angle computation.\"\"\"\n    input: ComplexNumber\n    expected_value: float\n    rel_tolerance: float\n\n# project-root/src/angle_complex.py\nimport math\nfrom typing import Union\n\nfrom src.domain import ComplexNumber, AngleResult # AngleResult is imported per design.\n\ndef angle_complex(*args) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number in radians.\n    Supports angle_complex(z: complex) or angle_complex(real, imag) forms.\n    \"\"\"\n    real: float\n    imag: float\n\n    if len(args) == 1:\n        z = args[0]\n        # Assume z is a complex-like object with .real and .imag attributes.\n        real = float(z.real)\n        imag = float(z.imag)\n    elif len(args) == 2:\n        real_arg = args[0]\n        imag_arg = args[1]\n        \n        real = float(real_arg)\n        # If imag_arg has an 'imag' attribute (like a complex number), use it.\n        # Otherwise, coerce imag_arg directly to a float.\n        if hasattr(imag_arg, 'imag'):\n            imag = imag_arg.imag\n        else:\n            imag = float(imag_arg)\n    # Per design, implicitly handle valid inputs conforming to 1 or 2 arguments.\n    # No explicit error handling for other argument counts, trusting the caller.\n        \n    return math.atan2(imag, real)\n\nclass AngleCalculator:\n    \"\"\"An optional wrapper class for computing complex number angles.\"\"\"\n\n    def angle_complex(self, complex_number: ComplexNumber) -> float:\n        \"\"\"\n        Calculates the angle for a ComplexNumber instance.\n        Delegates the calculation to the module-level angle_complex function.\n        \"\"\"\n        return angle_complex(complex_number.real, complex_number.imag)\n```"}
{"task_id": "Mbpp/125", "solution": "```python\n# src/find_length.py\nclass BinaryString:\n    \"\"\"Represents a binary string and provides basic accessors.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the string contains only '0' and '1' characters.\"\"\"\n        return Validator().validate_binary_chars(self.value)\n\nclass Substring:\n    \"\"\"Represents a contiguous substring with its '0' and '1' counts.\"\"\"\n    def __init__(self, start: int, end: int, value: str):\n        self.start = start\n        self.end = end\n        self.value = value\n        self.zeros = 0\n        self.ones = 0\n        for char in value:\n            if char == '0':\n                self.zeros += 1\n            elif char == '1':\n                self.ones += 1\n\n    def difference(self) -> int:\n        \"\"\"Returns the difference (zeros - ones) for the substring.\"\"\"\n        return self.zeros - self.ones\n\nclass Validator:\n    \"\"\"Provides stateless utilities for validating binary string inputs.\"\"\"\n    def validate_binary_chars(self, s: str) -> bool:\n        \"\"\"Returns True if s consists only of '0' and '1' characters.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                return False\n        return True\n\nclass FindLengthFunction:\n    \"\"\"Orchestrates validation and computes the maximum difference.\"\"\"\n    def __init__(self, validator: Validator = None):\n        self.validator = validator if validator is not None else Validator()\n\n    def find_length(self, s: str) -> int:\n        \"\"\"Computes the maximum (count('0') - count('1')) over all substrings.\n        Raises ValueError for invalid input characters.\n        \"\"\"\n        if not self.validator.validate_binary_chars(s):\n            raise ValueError(\"input must contain only '0' and '1'\")\n\n        max_difference = 0\n        current_difference = 0\n\n        for char in s:\n            val = 1 if char == '0' else -1\n            current_difference += val\n            max_difference = max(max_difference, current_difference)\n            if current_difference < 0:\n                current_difference = 0\n        \n        return max_difference\n\ndef find_length(s: str) -> int:\n    \"\"\"Public API: Finds the maximum (zeros - ones) over all contiguous substrings of s.\n    Raises ValueError for invalid input characters.\n    \"\"\"\n    finder = FindLengthFunction()\n    return finder.find_length(s)\n\n```\n```python\n# src/__init__.py\nfrom .find_length import find_length\n\n```"}
{"task_id": "Mbpp/125", "solution": "```python\n# src/__init__.py\nfrom .analyzer_function import find_length\n\n__all__ = [\"find_length\"]\n```\n```python\n# src/analyzer_function.py\n\nclass BinaryString:\n    \"\"\"Encapsulates the input string and provides its length.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string content.\"\"\"\n        return len(self.content)\n\nclass Substring:\n    \"\"\"Immutable container for substring data and difference calculation.\"\"\"\n    def __init__(self, content: str, startIndex: int, endIndex: int):\n        self.content = content\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.zerosCount = content.count('0')\n        self.onesCount = content.count('1')\n\n    def difference(self) -> int:\n        \"\"\"Computes and returns the difference (zerosCount - onesCount).\"\"\"\n        return self.zerosCount - self.onesCount\n\nclass Result:\n    \"\"\"Holds the final maximum difference integer.\"\"\"\n    def __init__(self, maxDifference: int):\n        self.maxDifference = maxDifference\n\nclass AnalyzerFunction:\n    \"\"\"Orchestrates validation, substring generation, difference computation, and result production.\"\"\"\n\n    def find_length(self, binaryString: str) -> int:\n        \"\"\"\n        Orchestrates finding the maximum difference between zeros and ones.\n        Per critical requirements, input is trusted without explicit validation.\n        \"\"\"\n        binary_str_obj = BinaryString(binaryString)\n\n        # Per critical requirement, explicit input validation is skipped.\n        # self.validateBinaryString(binary_str_obj) is not called.\n\n        substrings = self.generateContiguousSubstrings(binary_str_obj)\n\n        if not substrings:\n            return 0  # No substrings for an empty input string, max difference is 0.\n\n        max_difference = -float('inf')\n\n        for sub in substrings:\n            difference = self.computeDifference(sub)\n            if difference > max_difference:\n                max_difference = difference\n\n        return Result(max_difference).maxDifference\n\n    def validateBinaryString(self, binaryString: BinaryString) -> bool:\n        \"\"\"\n        Placeholder method per design.\n        Actual validation logic is forbidden by critical requirements.\n        \"\"\"\n        return True # Always returns True as per \"Trust the caller's inputs\"\n\n    def generateContiguousSubstrings(self, binaryString: BinaryString) -> list[Substring]:\n        \"\"\"Generates all contiguous substrings from the BinaryString.\"\"\"\n        substrings = []\n        n = binaryString.length()\n        for i in range(n):\n            for j in range(i, n):\n                sub_content = binaryString.content[i : j + 1]\n                substrings.append(Substring(sub_content, i, j))\n        return substrings\n\n    def computeDifference(self, substring: Substring) -> int:\n        \"\"\"Computes the difference for a given Substring instance.\"\"\"\n        return substring.difference()\n\n# Module-level API as required by FR1 and design.\n_analyzer = AnalyzerFunction()\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Module-level API: finds the maximum difference (zeros - ones) in any substring.\n    Delegates to AnalyzerFunction and assumes valid input.\n    \"\"\"\n    return _analyzer.find_length(binary_string)\n```"}
{"task_id": "Mbpp/126", "solution": "```python\n# sum_common_divisors/__init__.py\nfrom .sum_function import sum\n__all__ = [\"sum\"]\n\n# sum_common_divisors/models.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputPair:\n    a: int\n    b: int\n\n@dataclass\nclass CommonDivisor:\n    value: int\n\n@dataclass\nclass Result:\n    sum_value: int\n\n# sum_common_divisors/gcd.py\nclass GCD:\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"Compute gcd(abs(a), abs(b)) using the Euclidean algorithm.\n        If both inputs are zero, returns 0 as per design.\n        \"\"\"\n        a, b = abs(a), abs(b)\n        if a == 0 and b == 0:\n            return 0\n        while b:\n            a, b = b, a % b\n        return a\n\n# sum_common_divisors/sum_function.py\nfrom .gcd import GCD\nfrom .models import InputPair, CommonDivisor, Result # Imported as per design's \"composes\" relationship\n\ndef _find_divisors(n: int) -> list[int]:\n    \"\"\"Return a list of positive divisors of n.\n    Handles n=0 by returning an empty list.\n    \"\"\"\n    if n == 0:\n        return []\n    divs = []\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            divs.append(i)\n            if i * i != n:\n                divs.append(n // i)\n    return sorted(divs)\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Computes the sum of all positive common divisors of two integers.\n    Uses GCD, enumerates its divisors, and sums them.\n    \"\"\"\n    # Input validation (e.g., TypeError for non-int) is explicitly forbidden by critical requirements,\n    # overriding BR5 from the design. Inputs are trusted to be integers.\n\n    gcd_calculator = GCD()\n    gcd_value = gcd_calculator.compute(a, b)\n\n    if gcd_value == 0: # This covers the both-zero input case and no positive common divisors.\n        return 0\n\n    divisors = _find_divisors(gcd_value)\n    return int(sum(divisors))\n\n# sum_common_divisors/tests.py\nfrom .sum_function import sum\n\ndef run_tests():\n    \"\"\"Executes the provided acceptance verification assertion.\"\"\"\n    assert sum(10,15) == 6, f\"Test failed: sum(10,15) expected 6, got {sum(10,15)}\"\n    print(\"Test passed: assert sum(10,15) == 6\")\n\nif __name__ == \"__main__\":\n    run_tests()\n```"}
{"task_id": "Mbpp/126", "solution": "import math\n\ndef sum(a, b) -> int:\n    \"\"\"Calculates the sum of common positive divisors for two integers.\n    It computes the GCD of absolute inputs, then sums its divisors.\"\"\"\n    n1 = abs(a)\n    n2 = abs(b)\n    \n    g = math.gcd(n1, n2)\n    \n    divisors = set()\n    # Enumerate divisors of g efficiently\n    for d in range(1, int(g**0.5) + 1):\n        if g % d == 0:\n            divisors.add(d)\n            if d != g // d:\n                divisors.add(g // d)\n                \n    return sum(divisors)"}
