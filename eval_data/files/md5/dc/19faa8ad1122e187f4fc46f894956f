{"task_id": "Mbpp/764", "solution": "```python\nclass InputString:\n    \"\"\"Represents the input string to be processed.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\n\nclass Result:\n    \"\"\"Represents the integer count result.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count: int = count\n\nclass DigitCounter:\n    \"\"\"Encapsulates digit-counting logic and holds intermediate count state.\"\"\"\n    def __init__(self) -> None:\n        self.count: int = 0\n\n    def increment(self, char: str) -> None:\n        \"\"\"Increments the count if the character is an ASCII digit (0-9).\"\"\"\n        if '0' <= char <= '9':\n            self.count += 1\n\n    def number_ctr(self, input_value: str) -> int:\n        \"\"\"Scans an input string for digits and returns the total count.\"\"\"\n        for char in input_value:\n            self.increment(char)\n        return self.count\n\ndef number_ctr(input: str) -> int:\n    \"\"\"\n    Counts ASCII digit characters (0-9) in a given string.\n    Orchestrates counting using InputString, DigitCounter, and Result classes.\n    \"\"\"\n    input_str_obj = InputString(input)\n    counter = DigitCounter()\n    final_count = counter.number_ctr(input_str_obj.value)\n    result_obj = Result(final_count)\n    return result_obj.count\n```"}
{"task_id": "Mbpp/763", "solution": "from typing import List, Tuple, Union\n\n# Helper function to compute the minimum difference among elements.\n# Assumes elements are numeric and there are at least two.\ndef compute_min_diff(elements: List[Union[int, float]]) -> int:\n    elements.sort()\n    min_diff = float('inf')\n    for i in range(len(elements) - 1):\n        diff = abs(elements[i+1] - elements[i])\n        if diff < min_diff:\n            min_diff = diff\n    return int(min_diff) # Truncates toward zero as per design spec.\n\n# Main function to find the minimum difference in a sequence.\n# It considers the first 'n' elements and computes the minimum absolute difference.\ndef find_min_diff(sequence: Union[Tuple[Union[int, float], ...], List[Union[int, float]]], n: int) -> int:\n    elements_to_consider = list(sequence[:n])\n    return compute_min_diff(elements_to_consider)"}
{"task_id": "Mbpp/765", "solution": "```python\n# src/models.py\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\n\n@dataclass\nclass Request:\n    \"\"\"Data holder for a client request.\"\"\"\n    n: int\n    timestamp: str = field(default_factory=lambda: datetime.now().isoformat())\n\n@dataclass\nclass PoliteNumber:\n    \"\"\"Data holder with index and value for polite numbers.\"\"\"\n    index: int\n    value: int\n\nclass InputError(Exception):\n    \"\"\"Exception subclass for validation errors.\"\"\"\n    def __init__(self, message: str, error_type: str = \"InputValidationError\"):\n        self.message = message\n        self.type = error_type\n        super().__init__(self.message)\n\n```\n```python\n# src/input_validator.py\nfrom src.models import InputError\n\nclass InputValidator:\n    \"\"\"Validates input n per the requirements.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"Raises InputError if n is not an integer or n < 1.\"\"\"\n        if not isinstance(n, int):\n            raise InputError(f\"Input 'n' must be an integer, but got {type(n).__name__}.\")\n        if n < 1:\n            raise InputError(f\"Input 'n' must be greater than or equal to 1, but got {n}.\")\n\n```\n```python\n# src/sequence_generator.py\nclass SequenceGenerator:\n    \"\"\"Generates the nth polite number.\"\"\"\n    def getNth(self, n: int) -> int:\n        \"\"\"Returns the nth polite number using 1-based indexing.\"\"\"\n        polite_count = 0\n        current_num = 0\n        while polite_count < n:\n            current_num += 1\n            # A number is polite if it's not a power of two.\n            # A positive integer x is a power of two if (x & (x - 1)) == 0.\n            if current_num > 0 and (current_num & (current_num - 1)) != 0:\n                polite_count += 1\n        return current_num\n\n```\n```python\n# src/polite_number_service.py\nfrom src.input_validator import InputValidator\nfrom src.sequence_generator import SequenceGenerator\nfrom src.models import InputError\n\nclass PoliteNumberService:\n    \"\"\"Orchestrates validation and sequence generation for polite numbers.\"\"\"\n    def __init__(self, validator: InputValidator = None, generator: SequenceGenerator = None):\n        \"\"\"Initializes the service with input validator and sequence generator.\"\"\"\n        self._validator = validator if validator is not None else InputValidator()\n        self._generator = generator if generator is not None else SequenceGenerator()\n\n    def is_polite(self, n: int) -> int:\n        \"\"\"Validates n and returns the nth polite number.\"\"\"\n        self._validator.validate(n) # Validation occurs prior to computation.\n        return self._generator.getNth(n)\n\n# Convenience wrapper exposing PoliteNumberService().is_polite(n)\n_polite_service_instance = PoliteNumberService()\ndef is_polite(n: int) -> int:\n    \"\"\"Returns the nth polite number using 1-based indexing.\"\"\"\n    return _polite_service_instance.is_polite(n)\n\n```\n```python\n# src/__init__.py\nfrom .polite_number_service import is_polite\n\n__all__ = ['is_polite']\n\n```\n```python\n# src/main.py\nfrom src.polite_number_service import is_polite\n\ndef main() -> None:\n    \"\"\"Demonstrates example invocation and runs the required unit assertion.\"\"\"\n    print(\"Polite Number Service Example:\")\n\n    # Example Invocations\n    try:\n        # Valid inputs\n        print(f\"The 1st polite number is: {is_polite(1)}\") # Expected: 3\n        print(f\"The 7th polite number is: {is_polite(7)}\") # Expected: 11\n\n        # Invalid inputs\n        print(\"\\nTesting invalid inputs:\")\n        is_polite(0) # Should raise InputError\n    except Exception as e:\n        print(f\"Caught expected error: {e}\")\n\n    try:\n        is_polite(\"abc\") # Should raise InputError\n    except Exception as e:\n        print(f\"Caught expected error: {e}\")\n\n    # Required Unit Test Assertion from the design spec\n    print(\"\\nRunning required unit test assertion:\")\n    expected_value = 11\n    actual_value = is_polite(7)\n    assert actual_value == expected_value, f\"is_polite(7) failed: Expected {expected_value}, got {actual_value}\"\n    print(f\"Assertion passed: is_polite(7) == {actual_value}\")\n\nif __name__ == '__main__':\n    main()\n\n```\n```python\n# tests/test_polite.py\nimport pytest\nfrom src.polite_number_service import is_polite\nfrom src.models import InputError\n\ndef test_is_polite_7_equals_11() -> None:\n    \"\"\"Verifies that the 7th polite number is 11 as per FR5.\"\"\"\n    assert is_polite(7) == 11\n\ndef test_is_polite_invalid_input_n_zero() -> None:\n    \"\"\"Tests that is_polite raises InputError for n < 1.\"\"\"\n    with pytest.raises(InputError, match=\"must be greater than or equal to 1\"):\n        is_polite(0)\n\ndef test_is_polite_invalid_input_n_not_integer() -> None:\n    \"\"\"Tests that is_polite raises InputError for non-integer n.\"\"\"\n    with pytest.raises(InputError, match=\"must be an integer\"):\n        is_polite(7.0)\n\ndef test_polite_number_sequence() -> None:\n    \"\"\"Tests the first few polite numbers in sequence.\"\"\"\n    # Polite numbers: 3, 5, 6, 7, 9, 10, 11, 12, 13, 14, 15... (skipping 1, 2, 4, 8, 16...)\n    expected_sequence = [3, 5, 6, 7, 9, 10, 11]\n    for i, expected in enumerate(expected_sequence):\n        assert is_polite(i + 1) == expected, f\"Failed for n={i+1}\"\n\n```\n```markdown\n# README.md\n# Polite Number Service\n\nThis project implements the Polite Number Service according to the provided software design specification.\n\n## Overview\n\nThe service provides a single public API function `is_polite(n)` that returns the nth polite number, using 1-based indexing. A polite number is defined as any positive integer that is not a power of two. The system includes input validation and sequence generation, with clear separation of concerns.\n\n## Project Structure\n\n```\n/ (root)\n\u251c\u2500 src