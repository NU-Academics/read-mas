{"task_id": "Mbpp/142", "solution": "```python\nfrom typing import List, Any\n\ndef count_samepair(list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n    \"\"\"Return count of positions i where list1[i] == list2[i] == list3[i].\n    Comparison range: indices 0 .. min(len(list1), len(list2), len(list3)) - 1.\n    \"\"\"\n    identical_count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            identical_count += 1\n\n    return identical_count\n```"}
{"task_id": "Mbpp/145", "solution": "```python\nfrom typing import Sequence, Union\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input to MaxAbsDiffFunction.\n    Maps to the domain's ValidationError.\n    \"\"\"\n    pass\n\nclass MaxAbsDiffFunction:\n    \"\"\"\n    Encapsulates logic for computing and validating maximum absolute difference.\n    Processes Sequence, produces Result, raises ValidationError.\n    \"\"\"\n    def validate(self, sequence: Sequence[Union[int, float]]):\n        \"\"\"\n        Validates the input sequence based on design rules.\n        Raises ValidationError for invalid type, length, or element types.\n        \"\"\"\n        if not isinstance(sequence, (list, tuple)):\n            raise ValidationError(\"Input must be a list or tuple.\")\n\n        if len(sequence) < 2:\n            raise ValidationError(\"Sequence must contain at least two elements.\")\n\n        for element in sequence:\n            if not isinstance(element, (int, float)):\n                raise ValidationError(\"All elements must be int or float.\")\n\n    def compute(self, sequence: Sequence[Union[int, float]]) -> Union[int, float]:\n        \"\"\"\n        Validates the sequence and computes the maximum absolute difference.\n        Delegates to validate() and finds min/max in a single pass.\n        \"\"\"\n        self.validate(sequence)\n\n        # O(n) approach to find min and max values in a single pass\n        min_value = sequence[0]\n        max_value = sequence[0]\n\n        for i in range(1, len(sequence)):\n            if sequence[i] < min_value:\n                min_value = sequence[i]\n            if sequence[i] > max_value:\n                max_value = sequence[i]\n\n        return max_value - min_value\n\ndef max_Abs_Diff(sequence: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Public API function to compute the maximum absolute difference in a sequence.\n    Delegates validation and computation to MaxAbsDiffFunction.\n    \"\"\"\n    return MaxAbsDiffFunction().compute(sequence)\n```"}
{"task_id": "Mbpp/160", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass Input:\n    \"\"\"Holds the input parameters a, b, and n.\"\"\"\n    a: int\n    b: int\n    n: int\n\n@dataclass\nclass Solution:\n    \"\"\"Holds a particular integer solution x and y.\"\"\"\n    x: int\n    y: int\n\nclass Validator:\n    \"\"\"Provides utilities for validating input values.\"\"\"\n    def isInteger(self, value) -> bool:\n        \"\"\"Checks if the given value is an integer. Trusting caller's input per spec.\"\"\"\n        return True # Per CRITICAL REQUIREMENTS: \"Trust the caller's inputs\"\n\n    def validateRange(self, value) -> bool:\n        \"\"\"Validates if the value is within an allowed range. Always true for ints.\"\"\"\n        return True # Per design, all integer values are allowed.\n\nclass GCDCalculator:\n    \"\"\"Computes the greatest common divisor of two integers.\"\"\"\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"Calculates gcd(a, b) as a non-negative integer using Euclidean algorithm.\"\"\"\n        a, b = abs(a), abs(b)\n        if a == 0:\n            return b\n        while b != 0:\n            a, b = b, a % b\n        return a\n\nclass ExtendedEuclid:\n    \"\"\"Implements the Extended Euclidean Algorithm to solve ax + by = gcd(a,b).\"\"\"\n    def solve(self, a: int, b: int) -> tuple[int, int, int]:\n        \"\"\"Returns (x, y, g) such that a*x + b*y = g and g = gcd(a, b).\"\"\"\n        s, old_s = 0, 1\n        t, old_t = 1, 0\n        r, old_r = b, a\n\n        while r != 0:\n            quotient = old_r // r\n            old_r, r = r, old_r - quotient * r\n            old_s, s = s, old_s - quotient * s\n            old_t, t = t, old_t - quotient * t\n\n        g = old_r\n        x, y = old_s, old_t\n\n        # Ensure g is non-negative as per design specification.\n        if g < 0:\n            g = -g\n            x = -x\n            y = -y\n\n        return (x, y, g)\n\nclass Solver:\n    \"\"\"Orchestrates the finding of integer solutions for a*x + b*y = n.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.gcd_calculator = GCDCalculator()\n        self.extended_euclid = ExtendedEuclid()\n\n    def find_solution(self, a: int, b: int, n: int) -> tuple[int, int] | None:\n        \"\"\"Finds integers x, y satisfying a*x + b*y = n, or None if no solution exists.\"\"\"\n        # Per CRITICAL REQUIREMENTS: \"Trust the caller's inputs\".\n        # The Validator methods are called as per design but perform no checks.\n        self.validator.isInteger(a)\n        self.validator.isInteger(b)\n        self.validator.isInteger(n)\n        self.validator.validateRange(a)\n        self.validator.validateRange(b)\n        self.validator.validateRange(n)\n\n        # Handle degenerate case: a == 0 and b == 0 (UC7)\n        if a == 0 and b == 0:\n            if n == 0:\n                return (0, 0)  # Canonical choice per design decision\n            else:\n                return None\n\n        # Handle special case: a == 0 (implies b != 0 due to previous check) (UC6)\n        if a == 0:\n            if n % b == 0:\n                return (0, n // b)\n            else:\n                return None\n\n        # Handle special case: b == 0 (implies a != 0 due to previous checks) (UC6)\n        if b == 0:\n            if n % a == 0:\n                return (n // a, 0)\n            else:\n                return None\n\n        # General case: a != 0 and b != 0\n        g = self.gcd_calculator.compute(a, b)\n\n        # Check solvability: n must be divisible by gcd(a, b) (UC3, UC5)\n        if n % g != 0:\n            return None\n\n        # Compute a particular solution using Extended Euclidean Algorithm (UC4)\n        x0, y0, g_euclid = self.extended_euclid.solve(a, b)\n\n        # Scale the particular solution (x0, y0) by n/g_euclid\n        k = n // g_euclid\n        x = x0 * k\n        y = y0 * k\n        return (x, y)\n\n# Public API entry point (module-level function as specified in design)\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Public API: Finds integers x, y satisfying a*x + b*y = n, or None if no solution exists.\"\"\"\n    return Solver().find_solution(a, b, n)\n```"}
{"task_id": "Mbpp/160", "solution": "```python\nfrom typing import Tuple, Optional\nfrom dataclasses import dataclass\n\n@dataclass\nclass Coefficients:\n    \"\"\"Holds the coefficients a, b, and n for the Diophantine equation.\"\"\"\n    a: int\n    b: int\n    n: int\n\n@dataclass\nclass GCDResult:\n    \"\"\"Holds the GCD (g) and Bezout coefficients (x0, y0) such that a*x0 + b*y0 = g.\"\"\"\n    g: int\n    x0: int\n    y0: int\n\n@dataclass\nclass Solution:\n    \"\"\"Holds a pair of integers (x, y) that satisfy the equation.\"\"\"\n    x: int\n    y: int\n\nclass LinearDiophantineSolver:\n    \"\"\"Core solver for linear Diophantine equations ax + by = n.\"\"\"\n\n    def compute_gcd(self, a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of a and b using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return abs(a)\n\n    def extended_gcd(self, a: int, b: int) -> GCDResult:\n        \"\"\"Computes g = gcd(a, b) and coefficients x0, y0 such that a*x0 + b*y0 = g.\"\"\"\n        if a == 0:\n            # Base case: gcd(0, b) = abs(b), with 0*0 + b*(+/-1) = abs(b)\n            return GCDResult(abs(b), 0, 1 if b >= 0 else -1)\n        \n        # Recursive step\n        gcd_res = self.extended_gcd(b % a, a)\n        g, x1, y1 = gcd_res.g, gcd_res.x0, gcd_res.y0\n        \n        x0 = y1 - (b // a) * x1\n        y0 = x1\n        return GCDResult(g, x0, y0)\n\n    def find_solution(self, a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n        \"\"\"\n        Finds a particular integer solution (x, y) for a*x + b*y = n.\n        Returns None if no integer solution exists.\n        \"\"\"\n        # Handle the special case where both a and b are zero\n        if a == 0 and b == 0:\n            if n == 0:\n                return (0, 0) # Canonical solution for 0x + 0y = 0\n            else:\n                return None # No solution for 0x + 0y = n where n != 0\n\n        g = self.compute_gcd(a, b)\n\n        # Check if n is divisible by g; if not, no integer solution exists\n        if n % g != 0:\n            return None\n\n        # Compute Bezout coefficients x0, y0 for a*x0 + b*y0 = g\n        gcd_result = self.extended_gcd(a, b)\n        \n        # Scale the Bezout coefficients to find a particular solution for a*x + b*y = n\n        scale_factor = n // g\n        x_particular = gcd_result.x0 * scale_factor\n        y_particular = gcd_result.y0 * scale_factor\n\n        # Canonicalize the solution to satisfy specific examples like (2,1) for (2,3,7)\n        if b != 0:\n            b_prime = b // g\n            x_final = x_particular % b_prime\n            # If x_final becomes negative and b_prime is positive, adjust it.\n            # Python's % operator on negative numbers gives results with the same sign as divisor.\n            # For 2,3,7: x_particular is -7, b_prime is 3. -7 % 3 is 2. This works directly.\n            y_final = (n - a * x_final) // b\n        elif a != 0: # b must be 0 here\n            x_final = n // a\n            y_final = 0\n        else: # Both a and b are 0, handled at the start\n            return (0, 0) # Should not be reached if first check is correct\n\n        return (x_final, y_final)\n\n# Instantiate the solver once as it is stateless\n_solver = LinearDiophantineSolver()\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y satisfying a*x + b*y = n as a tuple,\n    or None if no solution exists.\n    \"\"\"\n    return _solver.find_solution(a, b, n)\n```"}
{"task_id": "Mbpp/161", "solution": "```python\nfrom typing import Any, List\n\ndef remove_elements(source_list: List[Any], remove_list: List[Any]) -> List[Any]:\n    \"\"\"Return a new list with elements from source_list not present in remove_list.\n    Behavior per SRS/BRs: equality (==), preserve order, no mutation, shallow copy if remove_list empty, empty result if source_list empty.\n    \"\"\"\n    if not source_list:\n        return []\n\n    if not remove_list:\n        return list(source_list)\n\n    result_list = []\n    for s_elem in source_list:\n        found_in_remove = False\n        for r_elem in remove_list:\n            if s_elem == r_elem:\n                found_in_remove = True\n                break\n        if not found_in_remove:\n            result_list.append(s_elem)\n\n    return result_list\n```"}
{"task_id": "Mbpp/162", "solution": "```python\n# src/domain_models.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputParameter:\n    \"\"\"Represents the input parameter for the series calculation.\"\"\"\n    n: int\n\n@dataclass\nclass SeriesResult:\n    \"\"\"Represents the result of the series calculation.\"\"\"\n    value: int\n\n```python\n# src/series_calculator.py\nfrom src.domain_models import InputParameter, SeriesResult # Used for type hints as per design\n\nclass SeriesCalculator:\n    \"\"\"\n    Handles the core logic for calculating the sum of the series.\n    Performs input validation and the summation.\n    \"\"\"\n    def sum_series(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of strictly positive terms (n - 2*i) for i starting at 0.\n        Raises TypeError for non-integer input; returns 0 for n <= 0.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n        if n <= 0:\n            return 0\n\n        current_sum = 0\n        i = 0\n        while True:\n            term = n - 2 * i\n            if term > 0:\n                current_sum += term\n                i += 1\n            else:\n                break\n        return current_sum\n\n# Module-level API function that delegates to SeriesCalculator\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Module-level API required by the system.\n    Delegates the calculation to a SeriesCalculator instance.\n    \"\"\"\n    calculator = SeriesCalculator()\n    return calculator.sum_series(n)\n\n```python\n# src/__init__.py\n\"\"\"Package initialization and export of the public API.\"\"\"\nfrom .series_calculator import sum_series\n\n__all__ = [\"sum_series\"]\n\n```python\n# tests/test_sum_series.py\n\"\"\"Unit test for the sum_series function.\"\"\"\nfrom src.sum_series import sum_series # Import from the package's public API\n\ndef test_sum_series() -> None:\n    \"\"\"Asserts that sum_series(6) correctly computes to 12.\"\"\"\n    assert sum_series(6) == 12\n```"}
{"task_id": "Mbpp/162", "solution": "```python\ndef sum_series(n: int) -> int:\n    \"\"\"Computes the sum of terms (n - 2*i) for i from 0 to floor(n/2).\"\"\"\n    total = 0\n    for i in range(0, (n // 2) + 1):\n        term = n - 2 * i\n        total += term\n    return total\n```"}
