{"task_id": "Mbpp/92", "solution": "```python\n# src/undulating/validation.py\nfrom typing import Any\n\nclass Validation:\n    \"\"\"Provides input validation utilities for the Undulating Number Checker.\"\"\"\n\n    def is_integer(self, obj: Any) -> bool:\n        \"\"\"Checks if the given object is an integer.\"\"\"\n        return isinstance(obj, int)\n\n    def meets_preconditions(self, number: int) -> bool:\n        \"\"\"Validates if the input number meets the system's preconditions, raising TypeError if not.\"\"\"\n        if not self.is_integer(number):\n            raise TypeError(\"Input must be an integer.\")\n        return True\n\n```\n```python\n# src/undulating/model.py\nfrom typing import List, Set\n\nclass Number:\n    \"\"\"Encapsulates an integer value and provides methods for digit extraction.\"\"\"\n\n    def __init__(self, value: int):\n        \"\"\"Initializes a Number with an integer value.\"\"\"\n        self._value = value\n\n    def to_digits(self) -> List[int]:\n        \"\"\"Converts the absolute integer value into an ordered list of its decimal digits.\"\"\"\n        # Handle 0 separately, as abs(0) == 0 would lead to an empty list\n        if self._value == 0:\n            return [0]\n\n        abs_value = abs(self._value)\n        digits_reversed = []\n        while abs_value > 0:\n            digits_reversed.append(abs_value % 10)\n            abs_value //= 10\n        return digits_reversed[::-1]\n\n\nclass DigitSequence:\n    \"\"\"Encapsulates a sequence of digits and provides methods for analysis.\"\"\"\n\n    def __init__(self, digits: List[int]):\n        \"\"\"Initializes a DigitSequence with a list of digits.\"\"\"\n        self._digits: List[int] = digits\n        self._distinct_digits: Set[int] = set(digits)\n\n    def distinct_count(self) -> int:\n        \"\"\"Returns the count of distinct digits in the sequence.\"\"\"\n        return len(self._distinct_digits)\n\n    def is_strictly_alternating(self) -> bool:\n        \"\"\"Checks if the digits strictly alternate between two distinct digits for the entire length.\"\"\"\n        if len(self._digits) < 2:\n            return False\n\n        if self.distinct_count() != 2:\n            return False\n        \n        # We know there are exactly two distinct digits and at least two digits in sequence.\n        # The first two digits must be distinct to establish the alternating pattern.\n        first_digit = self._digits[0]\n        second_digit = self._digits[1]\n\n        if first_digit == second_digit:\n            return False # E.g., 1121 -> distinct_count=2, but 1st two are not alternating\n\n        # Check the full alternation pattern from the third digit onwards\n        for i in range(2, len(self._digits)):\n            if i % 2 == 0: # Even index, should match the first digit\n                if self._digits[i] != first_digit:\n                    return False\n            else: # Odd index, should match the second digit\n                if self._digits[i] != second_digit:\n                    return False\n        return True\n\n\nclass Result:\n    \"\"\"A simple Data Transfer Object (DTO) holding the boolean undulating result.\"\"\"\n\n    def __init__(self, undulating: bool):\n        \"\"\"Initializes the Result with the undulating status.\"\"\"\n        self.undulating: bool = undulating\n\n```\n```python\n# src/undulating/checker.py\nfrom typing import List\n\nfrom .model import Number, DigitSequence\nfrom .validation import Validation\n\nclass UndulatingChecker:\n    \"\"\"Orchestrates validation, parsing, and business-rule checks to determine if a number is undulating.\"\"\"\n\n    def is_undulating(self, number: int) -> bool:\n        \"\"\"Determines if the given number is undulating based on its decimal digits.\"\"\"\n        # Perform input validation; this method may raise TypeError.\n        Validation().meets_preconditions(number)\n\n        # Construct Number and extract its decimal digits.\n        num_obj = Number(number)\n        digits: List[int] = num_obj.to_digits()\n\n        # Create DigitSequence and evaluate its properties.\n        seq = DigitSequence(digits)\n\n        # A number is undulating if it has exactly two distinct digits that strictly alternate.\n        is_undulating_status = (\n            seq.distinct_count() == 2 and\n            seq.is_strictly_alternating()\n        )\n\n        # The Result DTO is part of the domain model, but the API returns a direct boolean.\n        # Result(is_undulating_status) would be used internally, but not directly returned.\n\n        return is_undulating_status\n\n```\n```python\n# src/undulating/__init__.py\nfrom .checker import UndulatingChecker\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"Public API to check if a number is undulating, delegating to UndulatingChecker.\"\"\"\n    return UndulatingChecker().is_undulating(number)\n\n```\n```python\n# tests/test_undulating.py\nimport pytest\nfrom src.undulating import is_undulating\n\ndef test_example_positive():\n    \"\"\"Verify the example acceptance case for an undulating number.\"\"\"\n    assert is_undulating(1212121) == True\n\ndef test_positive_cases():\n    \"\"\"Test various numbers that are expected to be undulating.\"\"\"\n    assert is_undulating(21212) == True\n    assert is_undulating(101010) == True\n    assert is_undulating(5858) == True\n    assert is_undulating(121) == True\n    assert is_undulating(212) == True\n    assert is_undulating(121212121212121212121212121) == True\n    assert is_undulating(-1212121) == True # Absolute value used for digit extraction\n    assert is_undulating(-5858) == True\n    assert is_undulating(-121) == True\n    assert is_undulating(-21212) == True\n    assert is_undulating(-10101) == True\n\ndef test_negative_cases():\n    \"\"\"Test various numbers that are expected not to be undulating.\"\"\"\n    assert is_undulating(11111) == False # One distinct digit\n    assert is_undulating(12212) == False # Not strictly alternating\n    assert is_undulating(12345) == False # More than two distinct digits\n    assert is_undulating(1213) == False # More than two distinct digits\n    assert is_undulating(1) == False # Too few digits (single digit)\n    assert is_undulating(0) == False # Single digit\n    assert is_undulating(11) == False # Only one distinct digit\n    assert is_undulating(12) == False # Two distinct, but not alternating (only two digits)\n    assert is_undulating(21) == False # Two distinct, but not alternating (only two digits)\n    assert is_undulating(1001) == False # Not strictly alternating\n    assert is_undulating(100) == False # Not alternating\n    assert is_undulating(33) == False # Two same digits\n    assert is_undulating(-111) == False\n    assert is_undulating(-123) == False\n    assert is_undulating(-100) == False\n\ndef test_invalid_input_raises_type_error():\n    \"\"\"Verify that non-integer inputs raise a TypeError as per policy.\"\"\"\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_undulating(\"abc\")\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_undulating(1.23)\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_undulating(None)\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_undulating([1, 2, 1])\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_undulating(True) # Booleans are technically integers, but typically considered invalid for this context\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_undulating(b'121') # Bytes are not integers\n\n# Ensure boolean inputs, though technically integers in Python, raise TypeError if strict validation is desired\n# (current implementation of Validation.is_integer allows bool, which inherits from int)\n# If bool should be rejected, Validation.is_integer would need to be `type(obj) is int`.\n# However, the spec only says `isinstance(obj, int)`, which bool satisfies.\n# For simplicity, and aligning with `isinstance(True, int)` being True, no specific test rejecting bool is added unless explicitly specified.\n\n```"}
{"task_id": "Mbpp/92", "solution": "```python\n# src/undulating/__init__.py\nfrom undulating.undulating_checker import is_undulating\n\n__all__ = ['is_undulating']\n\n# src/undulating/number_input.py\nfrom typing import List\nfrom undulating.digit_sequence import DigitSequence\n\ndef _int_to_digits(n: int) -> List[int]:\n    \"\"\"Converts an integer to a list of its base-10 digits.\n    Negative numbers are treated as their absolute value for digit extraction.\n    \"\"\"\n    s_num = str(abs(n))\n    return [int(d) for d in s_num]\n\nclass NumberInput:\n    \"\"\"Represents and validates an integer input, providing digit sequence.\"\"\"\n\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes with an integer value.\"\"\"\n        self.value = value\n        self._digits: List[int] = _int_to_digits(value)\n\n    def parseDigits(self) -> DigitSequence:\n        \"\"\"Parses the integer into a DigitSequence.\"\"\"\n        return DigitSequence(self._digits)\n\n# src/undulating/digit_sequence.py\nfrom typing import List\n\nclass DigitSequence:\n    \"\"\"Container for an ordered list of decimal digits.\"\"\"\n\n    def __init__(self, digits: List[int]) -> None:\n        \"\"\"Initializes with a list of digits (most-significant to least-significant).\"\"\"\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the digit at the specified index.\"\"\"\n        return self.digits[index]\n\n# src/undulating/undulating_result.py\nclass UndulatingResult:\n    \"\"\"Data holder for the result of an undulating number check.\"\"\"\n\n    def __init__(self, source_value: int, is_undulating: bool) -> None:\n        \"\"\"Initializes with the original input value and the boolean result.\"\"\"\n        self.source_value = source_value\n        self.is_undulating = is_undulating\n\n# src/undulating/undulating_checker.py\nfrom undulating.number_input import NumberInput\nfrom undulating.digit_sequence import DigitSequence\nfrom undulating.undulating_result import UndulatingResult\n\nclass UndulatingChecker:\n    \"\"\"Performs the core logic to determine if a number is undulating.\"\"\"\n\n    def validateInput(self, n) -> None:\n        \"\"\"Validates that the input is an integer, raising TypeError if not.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer (BR1).\")\n\n    def is_undulating(self, n) -> bool:\n        \"\"\"Determines if the integer n is an undulating number.\"\"\"\n        self.validateInput(n)\n\n        num = NumberInput(n)\n        digits = num.parseDigits()\n\n        # Undulating numbers require at least two distinct alternating digits.\n        if digits.length() < 2:\n            return False\n\n        digit_a = digits.get(0)\n        digit_b = None\n        found_digit_b = False\n\n        for i in range(digits.length()):\n            current_digit = digits.get(i)\n\n            if i % 2 == 0:  # Expected digit_a\n                if current_digit != digit_a:\n                    return False\n            else:  # Expected digit_b\n                if not found_digit_b:\n                    digit_b = current_digit\n                    found_digit_b = True\n                    # Check if the two distinct digits are actually distinct.\n                    if digit_a == digit_b:\n                        return False\n                elif current_digit != digit_b:\n                    return False\n        \n        # If length >= 2 and we never set digit_b, it means all digits were the same.\n        if digits.length() >= 2 and not found_digit_b:\n            return False\n        \n        # Internally create an UndulatingResult, though it's not directly returned by API.\n        _ = UndulatingResult(n, True)\n        return True\n\ndef is_undulating(n) -> bool:\n    \"\"\"Public API function to check if an integer is undulating.\"\"\"\n    checker = UndulatingChecker()\n    return checker.is_undulating(n)\n```"}
