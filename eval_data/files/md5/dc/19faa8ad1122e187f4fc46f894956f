{"task_id": "Mbpp/267", "solution": "def square_Sum(n):\n    \"\"\"Calculates the sum of the squares of the first n odd natural numbers.\n    The caller is trusted to provide a non-negative integer for n.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_number = 2 * k - 1\n        total_sum += odd_number * odd_number\n    return total_sum"}
{"task_id": "Mbpp/268", "solution": "```\n/src/exceptions.py\n```python\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\n    It stores a descriptive message about the validation failure.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n```\n\n```\n/src/models.py\n```python\nclass InputParameter:\n    \"\"\"Represents an input parameter 'n' for star number computation.\n    It provides a method to check if the value is a positive integer.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the input value is a positive integer (n >= 1).\"\"\"\n        return isinstance(self.value, int) and self.value >= 1\n\n\nclass StarNumber:\n    \"\"\"A value object holding a computed star number.\n    It simply encapsulates an integer value.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n```\n\n```\n/src/calculator.py\n```python\nclass StarNumberCalculator:\n    \"\"\"Stateless component designed to compute the nth star number.\n    It implements the mathematical formula for star numbers.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth star number using the formula 6n(n-1) + 1.\"\"\"\n        return 6 * n * (n - 1) + 1\n\n```\n\n```\n/src/star_number.py\n```python\nfrom src.models import InputParameter\nfrom src.calculator import StarNumberCalculator\nfrom src.exceptions import ValidationError\n\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Computes the nth star number after validating the input 'n'.\n    It raises ValidationError if 'n' is not a positive integer.\n    \"\"\"\n    param = InputParameter(n)\n    if not param.isPositive():\n        raise ValidationError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    calculator = StarNumberCalculator()\n    return calculator.compute(n)\n\n```\n\n```\n/src/__init__.py\n```python\nfrom .star_number import find_star_num\n\n```"}
{"task_id": "Mbpp/267", "solution": "```python\n# square_sum.py\n__all__ = [\"square_Sum\"]\n\ndef _validate_n(n):\n    \"\"\"\n    Validates the input n for type and value constraints.\n    Raises TypeError if n is not an int, ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input n cannot be negative.\")\n\ndef _generate_first_n_odd_numbers(n):\n    \"\"\"\n    Generates a list containing the first n odd natural numbers.\n    For n=0, an empty list is returned.\n    \"\"\"\n    return [2 * k + 1 for k in range(n)]\n\ndef square_Sum(n):\n    \"\"\"\n    Computes the sum of the squares of the first n odd natural numbers.\n    Input n is validated; returns 0 for n == 0 through natural computation.\n    \"\"\"\n    _validate_n(n)\n    odd_numbers = _generate_first_n_odd_numbers(n)\n    return sum(x * x for x in odd_numbers)\n\n```\n```python\n# test_square_sum.py\nfrom square_sum import square_Sum\n\ndef test_assertion():\n    \"\"\"\n    Tests the specific assertion required by the problem statement.\n    Verifies square_Sum(2) equals 10.\n    \"\"\"\n    expected = 10\n    result = square_Sum(2)\n    assert result == expected, f\"test_assertion failed: Expected {expected}, got {result}\"\n    print(\"test_assertion passed.\")\n\ndef test_zero():\n    \"\"\"\n    Tests the edge case where n is 0.\n    Verifies square_Sum(0) equals 0.\n    \"\"\"\n    expected = 0\n    result = square_Sum(0)\n    assert result == expected, f\"test_zero failed: Expected {expected}, got {result}\"\n    print(\"test_zero passed.\")\n\ndef test_type_error():\n    \"\"\"\n    Tests that TypeError is raised for non-integer inputs.\n    Checks with various invalid types like string, float, and None.\n    \"\"\"\n    invalid_inputs = [\"2\", 2.5, None, [1], {\"a\":1}]\n    for n in invalid_inputs:\n        try:\n            square_Sum(n)\n            assert False, f\"test_type_error failed: Expected TypeError for input {repr(n)}, but no exception was raised.\"\n        except TypeError:\n            print(f\"test_type_error for input {repr(n)} passed.\")\n        except Exception as e:\n            assert False, f\"test_type_error failed: Expected TypeError for input {repr(n)}, but got {type(e).__name__}: {e}\"\n    print(\"test_type_error overall passed.\")\n\ndef test_negative():\n    \"\"\"\n    Tests that ValueError is raised for negative integer inputs.\n    Verifies square_Sum(-1) raises ValueError.\n    \"\"\"\n    try:\n        square_Sum(-1)\n        assert False, \"test_negative failed: Expected ValueError for input -1, but no exception was raised.\"\n    except ValueError:\n        print(\"test_negative passed.\")\n    except Exception as e:\n        assert False, f\"test_negative failed: Expected ValueError for input -1, but got {type(e).__name__}: {e}\"\n    print(\"test_negative overall passed.\")\n\ndef run_all_tests():\n    \"\"\"\n    Executes all defined test functions and reports outcomes.\n    Raises AssertionError on any test failure.\n    \"\"\"\n    print(\"Running tests...\")\n    test_assertion()\n    test_zero()\n    test_type_error()\n    test_negative()\n    print(\"\\nAll tests passed successfully.\")\n\nif __name__ == '__main__':\n    run_all_tests()\n```"}
