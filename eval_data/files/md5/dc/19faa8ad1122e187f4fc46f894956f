{"task_id": "Mbpp/232", "solution": "```python\n# File: src/__init__.py\n\"\"\"\nPackage initializer for the src module.\n\"\"\"\n\n# File: src/larg_nnum.py\nfrom typing import List, Any\n\nclass Element:\n    \"\"\"Represents a single element in the domain model.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\nclass InputList:\n    \"\"\"Represents the input list in the domain model.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass ResultList:\n    \"\"\"Represents the result list in the domain model.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\ndef larg_nnum(input_list: list, n: int) -> list:\n    \"\"\"\n    Returns the n largest items from input_list, counting duplicates as distinct.\n    When len(input_list) >= n, the function returns exactly n items.\n    \"\"\"\n    # Sort the list in descending order to get largest items first.\n    sorted_list = sorted(input_list, reverse=True)\n    # Return the first 'n' elements from the sorted list.\n    return sorted_list[:n]\n\n# File: tests/test_larg_nnum.py\nimport pytest\nfrom src.larg_nnum import larg_nnum\n\ndef test_example_case():\n    \"\"\"\n    Validates the function against the provided acceptance test.\n    Checks if the set of returned largest numbers matches the expected set.\n    \"\"\"\n    input_data = [10, 20, 50, 70, 90, 20, 50, 40, 60, 80, 100]\n    expected_result_set = set([100, 90])\n    # The order of elements in the result is not specified, so use set for comparison.\n    assert set(larg_nnum(input_data, 2)) == expected_result_set\n\n```"}
{"task_id": "Mbpp/230", "solution": "```python\n# src/domain.py\n\nclass InputString:\n    \"\"\"Represents an input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __str__(self) -> str:\n        return self.value\n\nclass ReplacementChar:\n    \"\"\"Represents the single replacement character.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __str__(self) -> str:\n        return self.value\n\nclass OutputString:\n    \"\"\"Represents the output string produced.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __str__(self) -> str:\n        return self.value\n\nclass ReplaceBlankFunction:\n    \"\"\"Encapsulates behavior to replace spaces in an InputString.\"\"\"\n    def __init__(self, input_string_obj: InputString, replacement_char_obj: ReplacementChar) -> None:\n        self._input_string = input_string_obj\n        self._replacement_char = replacement_char_obj\n\n    def execute(self) -> str:\n        \"\"\"Performs replacement of literal ' ' with replacement_char.\"\"\"\n        modified_chars = []\n        for char in self._input_string.value:\n            if char == ' ':\n                modified_chars.append(self._replacement_char.value)\n            else:\n                modified_chars.append(char)\n        return \"\".join(modified_chars)\n\n\n# src/replace_blank.py\n\nfrom src.domain import InputString, ReplacementChar, ReplaceBlankFunction, OutputString\n\ndef _apply_replacement(input_string_obj: InputString, replacement_char_obj: ReplacementChar) -> OutputString:\n    \"\"\"Internal helper for character-by-character substitution.\"\"\"\n    modified_chars = []\n    for char in input_string_obj.value:\n        if char == ' ':\n            modified_chars.append(replacement_char_obj.value)\n        else:\n            modified_chars.append(char)\n    return OutputString(\"\".join(modified_chars))\n\ndef replace_blank(input_string: str, replacement_char: str) -> str:\n    \"\"\"\n    Public API to replace blank spaces in a string with a given character.\n    It orchestrates domain objects and calls the replacement logic.\n    \"\"\"\n    input_obj = InputString(input_string)\n    replacement_obj = ReplacementChar(replacement_char)\n    replacement_func = ReplaceBlankFunction(input_obj, replacement_obj)\n    result_string = replacement_func.execute()\n    return result_string\n\n\n# tests/test_replace_blank.py\n\nfrom src.replace_blank import replace_blank\n\nclass TestCase:\n    \"\"\"Represents and runs a single unit test scenario.\"\"\"\n    def __init__(self, input: str, replacement: str, expected: str) -> None:\n        self.input = input\n        self.replacement = replacement\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes the test and returns True if passed, False otherwise.\"\"\"\n        actual_output = replace_blank(self.input, self.replacement)\n        print(f\"Test Input: '{self.input}', Replacement: '{self.replacement}'\")\n        print(f\"Expected: '{self.expected}', Actual: '{actual_output}'\")\n        if actual_output == self.expected:\n            print(\"Test PASSED.\")\n            return True\n        else:\n            print(\"Test FAILED!\")\n            return False\n\ndef main_test() -> None:\n    \"\"\"Test runner for the SRS-provided assertion.\"\"\"\n    print(\"Running SRS unit test...\")\n    test_case = TestCase(\"hello people\", '@', \"hello@people\")\n    if test_case.run():\n        print(\"All SRS tests passed successfully.\")\n    else:\n        print(\"Some SRS tests failed.\")\n\nif __name__ == \"__main__\":\n    main_test()\n```"}
{"task_id": "Mbpp/234", "solution": "```python\n# src/__init__.py\n\"\"\"\nPackage marker for the src directory.\n\"\"\"\n```\n\n```python\n# src/cube.py\nfrom typing import Union\n\nclass Cube:\n    \"\"\"Represents a cube with a given side length and computes its volume.\"\"\"\n\n    def __init__(self, side_length: Union[float, int]) -> None:\n        \"\"\"Initializes the Cube with a side length.\"\"\"\n        self._side_length = side_length\n        self._volume = None  # Cached volume, initially None\n\n    def computeVolume(self) -> Union[float, int]:\n        \"\"\"Computes and returns the volume of the cube.\"\"\"\n        if self._volume is None:\n            self._volume = self._side_length ** 3\n        return self._volume\n```\n\n```python\n# src/volume_calculator.py\nfrom typing import Union\nfrom src.cube import Cube\n\ndef volume_cube(side_length: Union[float, int]) -> Union[float, int]:\n    \"\"\"Public API: compute cube volume.\n    Precondition: side_length is numeric (int or float).\n    \"\"\"\n    return Cube(side_length).computeVolume()\n\nclass VolumeCalculator:\n    \"\"\"Provides methods to calculate the volume of shapes, specifically cubes.\"\"\"\n\n    def volume_cube(self, side_length: Union[float, int]) -> Union[float, int]:\n        \"\"\"Instance method to compute cube volume.\n        Delegates to the Cube domain object for computation.\n        \"\"\"\n        return Cube(side_length).computeVolume()\n```\n\n```python\n# tests/test_volume.py\nfrom src.volume_calculator import volume_cube\n\ndef test_volume_cube_3_equals_27():\n    \"\"\"Verifies that the volume_cube function returns 27 for a side length of 3.\"\"\"\n    assert volume_cube(3) == 27\n```"}
