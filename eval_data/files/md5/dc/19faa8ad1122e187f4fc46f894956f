{"task_id": "Mbpp/137", "solution": "```python\n# src/domain.py\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass(frozen=True)\nclass IntegerElement:\n    \"\"\"Represents a single integer element and whether it is zero.\"\"\"\n    value: int\n\n    def is_zero(self) -> bool:\n        \"\"\"Returns True if the element's value is 0.\"\"\"\n        return self.value == 0\n\n@dataclass(frozen=True)\nclass InputArray:\n    \"\"\"Represents an input iterable/array of integer elements.\"\"\"\n    elements: List[IntegerElement]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n@dataclass(frozen=True)\nclass ZeroCountResult:\n    \"\"\"Holds computed result data: ratio, zero_count, non_zero_count.\"\"\"\n    ratio: float\n    zero_count: int\n    non_zero_count: int\n\n@dataclass(frozen=True)\nclass ValidationError:\n    \"\"\"Represents validation error messages.\"\"\"\n    message: str\n\n```\n```python\n# src/zero_count_service.py\nfrom typing import Iterable\nfrom .domain import IntegerElement, InputArray, ZeroCountResult # Required by design spec, even if not directly instantiated within zero_count for O(1) space.\n\ndef zero_count(arr: Iterable[int]) -> float:\n    \"\"\"\n    Computes the ratio of zero elements to non-zero elements in an array.\n    Raises TypeError if any element is not an int, ValueError for empty input or no non-zeroes.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n    total_elements = 0\n\n    # Iterate through the input for validation and counting (O(1) extra space).\n    for element in arr:\n        total_elements += 1\n        if not isinstance(element, int):\n            raise TypeError(\"input must contain only integers\")\n        if element == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    # Apply business rules for edge cases.\n    if total_elements == 0:\n        raise ValueError(\"input is empty\")\n    if non_zeroes == 0:\n        raise ValueError(\"no non-zero elements; ratio undefined\")\n\n    # Compute and return the ratio as a float.\n    ratio = float(zeroes) / non_zeroes\n    return ratio\n\nclass ZeroCountService:\n    \"\"\"\n    Optional thin wrapper for the zero_count function.\n    Delegates calls to the module-level zero_count function.\n    \"\"\"\n    def zero_count(self, arr: Iterable[int]) -> float:\n        \"\"\"\n        Computes the ratio of zero elements to non-zero elements using the module function.\n        \"\"\"\n        return zero_count(arr)\n\n```"}
{"task_id": "Mbpp/137", "solution": "```python\nfrom typing import Sequence\n\ndef zero_count(integer_array: Sequence[int]) -> float:\n    \"\"\"Compute and return (zero_count / non_zero_count) as a Python float.\n\n    Returns:\n        float: zeros / non-zeros as Python float. If non_zero_count == 0 and zero_count > 0 -> float('inf').\n               If non_zero_count == 0 and zero_count == 0 (empty input) -> float('nan').\n    \"\"\"\n    num_zeros = 0\n    num_non_zeros = 0\n\n    for element in integer_array:\n        if element == 0:\n            num_zeros += 1\n        else:\n            num_non_zeros += 1\n\n    if num_non_zeros == 0:\n        if num_zeros > 0:\n            return float('inf')\n        else: # num_zeros == 0, implying an empty input\n            return float('nan')\n    else:\n        return float(num_zeros / num_non_zeros)\n```"}
