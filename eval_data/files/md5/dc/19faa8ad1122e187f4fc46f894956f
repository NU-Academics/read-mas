{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"Return length of longest consecutive run of ASCII uppercase letters A-Z in s.\n\n    Args:\n        s: input string\n    Returns:\n        int: length of longest run of 'A'-'Z' in s\n    \"\"\"\n    currentRun = 0\n    maxRun = 0\n\n    for char_code in s:\n        if 'A' <= char_code <= 'Z':\n            currentRun += 1\n            if currentRun > maxRun:\n                maxRun = currentRun\n        else:\n            currentRun = 0\n    \n    return maxRun"}
{"task_id": "Mbpp/805", "solution": "```python\n# src/__init__.py\nfrom .max_sum_list import max_sum_list\n\n__all__ = [\"max_sum_list\"]\n\n```python\n# src/domain.py\nfrom typing import List, Sequence, Union\n\nclass NumericValue:\n    \"\"\"A conceptual wrapper for numeric values.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value: float = float(value)\n\nclass InnerList:\n    \"\"\"Encapsulates an inner list of numeric values and provides a sum method.\"\"\"\n    def __init__(self, values: List[Union[int, float]]):\n        self.values: List[float] = [float(v) for v in values]\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of the encapsulated numeric values.\"\"\"\n        return sum(self.values)\n\nclass ListOfLists:\n    \"\"\"A conceptual container for multiple InnerList objects.\"\"\"\n    def __init__(self, lists: List[InnerList]):\n        self.lists: List[InnerList] = lists\n\nclass Result:\n    \"\"\"A conceptual wrapper for the selected InnerList result.\"\"\"\n    def __init__(self, selected_list: InnerList):\n        self.selected_list: InnerList = selected_list\n\n```python\n# src/max_sum_list.py\nfrom typing import Sequence, List, Union\nfrom .domain import InnerList, ListOfLists, Result\n\ndef _validate_input(list_of_lists: Sequence[Sequence[Union[int, float]]]) -> None:\n    \"\"\"Validates if the input is a sequence of sequences of numeric values.\"\"\"\n    if not isinstance(list_of_lists, Sequence):\n        raise ValueError(\"Invalid input: expected sequence of sequences of numeric values\")\n    \n    for inner_list in list_of_lists:\n        if not isinstance(inner_list, Sequence):\n            raise ValueError(\"Invalid input: expected sequence of sequences of numeric values\")\n        for item in inner_list:\n            if not isinstance(item, (int, float)):\n                raise ValueError(\"Invalid input: expected sequence of sequences of numeric values\")\n\nclass MaxSumList:\n    \"\"\"Implements the logic for finding the inner list with the highest sum.\"\"\"\n    def execute(self, list_of_lists: Sequence[Sequence[Union[int, float]]]) -> Sequence[float]:\n        \"\"\"Validates input, computes sums, applies tie-breaker, and returns the selected list.\"\"\"\n        _validate_input(list_of_lists)\n\n        if not list_of_lists:\n            return []\n\n        # Convert to domain model for processing\n        domain_inner_lists = [InnerList(list(item)) for item in list_of_lists]\n        domain_container = ListOfLists(domain_inner_lists)\n\n        max_sum = -float('inf')\n        max_sum_list_index = -1\n\n        for i, inner_list_domain in enumerate(domain_container.lists):\n            current_sum = inner_list_domain.sum()\n            # Deterministic tie-breaker: return the first encountered inner list in input order (BR5).\n            if current_sum > max_sum:\n                max_sum = current_sum\n                max_sum_list_index = i\n        \n        selected_raw_list = list_of_lists[max_sum_list_index]\n        \n        # Conceptual Result wrapper, then extract actual list data for API return type.\n        result_domain = Result(InnerList(list(selected_raw_list)))\n        return result_domain.selected_list.values\n\ndef max_sum_list(list_of_lists: Sequence[Sequence[Union[int, float]]]) -> Sequence[float]:\n    \"\"\"\n    Returns the inner list from a list of lists whose sum of elements is highest.\n    Delegates the core logic to the MaxSumList service class.\n    \"\"\"\n    svc = MaxSumList()\n    return svc.execute(list_of_lists)\n```"}
