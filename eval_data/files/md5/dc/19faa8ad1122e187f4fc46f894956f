side 5 is 100.\"\"\"\n    assert lateralsurface_cube(5) == 100\n```"}
{"task_id": "Mbpp/265", "solution": "```python\n# src/list_split.py\ndef list_split(input_list, n):\n    \"\"\"\n    Split input_list into n sublists where sublist i contains elements at positions i, i+n, i+2n, ... (0-based).\n\n    Raises:\n      ValueError: If n < 1.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Parameter 'n' must be a positive integer greater than 0.\")\n\n    # Initialize n empty sublists.\n    outputs = [[] for _ in range(n)]\n\n    # Distribute elements into sublists based on their original index modulo n.\n    for k, e in enumerate(input_list):\n        outputs[k % n].append(e)\n\n    return outputs\n\n```\n\n```python\n# src/__init__.py\nfrom .list_split import list_split\n\n```"}
{"task_id": "Mbpp/265", "solution": "```python\nfrom typing import Any, List\n\ndef list_split(input_list: List[Any], n: int) -> List[List[Any]]:\n    \"\"\"Splits an input list into n sublists by distributing elements in an interleaved fashion.\n    Elements at indices i, i+n, i+2n, ... go into sublist i.\n    \"\"\"\n    result: List[List[Any]] = [[] for _ in range(n)]\n\n    for idx, val in enumerate(input_list):\n        result[idx % n].append(val)\n\n    return result\n```"}
