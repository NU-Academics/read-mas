{"task_id": "Mbpp/285", "solution": "```python\n# src/domain.py\nimport re\n\nclass InputString:\n    \"\"\"Represents the input text to be searched.\n    Stores the content and its length.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n        self.length = len(content)\n\nclass MatchPattern:\n    \"\"\"Encapsulates the regex pattern to be matched.\n    Defaults to \"abb|abbb\" as required.\"\"\"\n    def __init__(self, value: str = \"abb|abbb\"):\n        self.value = value\n\nclass MatchResult:\n    \"\"\"Stores the outcome of a pattern matching operation.\n    Indicates if a match was found and the matched substring.\"\"\"\n    def __init__(self, matched: bool, matched_substring: str = \"\"):\n        self.matched = matched\n        self.matched_substring = matched_substring\n\nclass TextMatcher:\n    \"\"\"Core class for performing text matching operations.\n    Handles input validation and regex searching.\"\"\"\n    def __init__(self):\n        self._compiled_pattern = re.compile(r\"abb|abbb\")\n\n    def _is_string(self, value) -> bool:\n        \"\"\"Checks if the given value is a string.\"\"\"\n        return isinstance(value, str)\n\n    def _search(self, input_string: InputString, pattern: MatchPattern) -> MatchResult:\n        \"\"\"Searches the input string content for the pre-compiled pattern.\n        Returns a MatchResult indicating the outcome.\"\"\"\n        match = self._compiled_pattern.search(input_string.content)\n        if match:\n            return MatchResult(True, match.group(0))\n        else:\n            return MatchResult(False, \"\")\n\n    def text_match_two_three(self, text) -> bool:\n        \"\"\"\n        Validates input, performs pattern matching, and returns the boolean result.\n        Raises TypeError for non-string inputs as per specification.\n        \"\"\"\n        if not self._is_string(text):\n            raise TypeError(\"Input must be a string.\")\n\n        input_obj = InputString(text)\n        pattern_obj = MatchPattern() # Uses default pattern \"abb|abbb\"\n        result = self._search(input_obj, pattern_obj)\n        return result.matched\n\n```\n```python\n# src/text_match_two_three.py\nfrom .domain import TextMatcher\n\ndef text_match_two_three(text):\n    \"\"\"\n    Checks if the input string contains \"abb\" or \"abbb\".\n    Delegates to TextMatcher and raises TypeError for non-string inputs.\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_two_three(text)\n\n```"}
{"task_id": "Mbpp/286", "solution": "```python\nfrom typing import List, Optional\n\nclass InputArray:\n    \"\"\"Represents the input list and its declared length.\"\"\"\n    def __init__(self, values: List[int], n: int):\n        self.values = values\n        self.n = n\n\nclass Repetition:\n    \"\"\"Represents the repetition count.\"\"\"\n    def __init__(self, k: int):\n        self.k = k\n\nclass RepeatedArray:\n    \"\"\"Conceptual representation of an array repeated k times.\"\"\"\n    def __init__(self, values: Optional[List[int]], length: int):\n        self.values = values # Values field is optional to avoid materializing for large k.\n        self.length = length\n\nclass SubarrayMetrics:\n    \"\"\"Stores aggregated metrics (sums, prefix, suffix, max subarray) for an array.\"\"\"\n    def __init__(self, totalSum: int, maxPrefixSum: int, maxSuffixSum: int, maxSubarraySum: int):\n        self.totalSum = totalSum\n        self.maxPrefixSum = maxPrefixSum\n        self.maxSuffixSum = maxSuffixSum\n        self.maxSubarraySum = maxSubarraySum\n\n\nclass MaxSubarrayService:\n    \"\"\"Encapsulates logic for input validation and computing the maximum subarray sum.\"\"\"\n\n    def max_sub_array_sum_repeated(self, array: List[int], n: int, k: int) -> int:\n        \"\"\"Service-level entry point to find the maximum subarray sum for k repetitions.\"\"\"\n        self.validateInput(array, n, k)\n        return self.computeRepeatedMax(array, k)\n\n    def validateInput(self, array: List[int], n: int, k: int):\n        \"\"\"Validates input parameters according to design requirements.\"\"\"\n        if n != len(array):\n            raise ValueError(\"n must equal len(array)\")\n        if not isinstance(k, int) or k < 1:\n            raise ValueError(\"k must be an integer >= 1\")\n        if not all(isinstance(x, int) for x in array):\n            raise ValueError(\"array elements must be integers\")\n\n    def computeSingleArrayMetrics(self, array: List[int]) -> SubarrayMetrics:\n        \"\"\"Computes various sums and max subarray sum for a single instance of the array.\"\"\"\n        if not array:\n            # For an empty array, all sums are conventionally 0.\n            return SubarrayMetrics(0, 0, 0, 0) \n\n        total_sum = sum(array)\n\n        # Kadane's algorithm for maxSubarraySum (assumes non-empty subarray, handles all negatives).\n        max_so_far = array[0]\n        current_max = array[0]\n        for num in array[1:]:\n            current_max = max(num, current_max + num)\n            max_so_far = max(max_so_far, current_max)\n        max_subarray_sum = max_so_far\n\n        # Max prefix sum (sum of any non-empty prefix).\n        max_prefix_sum = array[0]\n        current_prefix_sum = array[0]\n        for num in array[1:]:\n            current_prefix_sum += num\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n        \n        # Max suffix sum (sum of any non-empty suffix).\n        max_suffix_sum = array[-1]\n        current_suffix_sum = array[-1]\n        for num in reversed(array[:-1]): # Iterate from second-to-last to first element.\n            current_suffix_sum += num\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n        return SubarrayMetrics(total_sum, max_prefix_sum, max_suffix_sum, max_subarray_sum)\n\n    def computeRepeatedMax(self, array: List[int], k: int) -> int:\n        \"\"\"Computes the maximum contiguous subarray sum for the array repeated k times.\"\"\"\n        metrics = self.computeSingleArrayMetrics(array)\n\n        # The maximum sum could be entirely within one original array.\n        ans = metrics.maxSubarraySum\n\n        if k == 1:\n            return ans\n\n        # The maximum sum could span two repetitions (suffix of first + prefix of second).\n        ans = max(ans, metrics.maxSuffixSum + metrics.maxPrefixSum)\n\n        # The maximum sum could span multiple repetitions, including full middle arrays.\n        # This is only beneficial if the total sum of the array itself is positive.\n        if k > 2 and metrics.totalSum > 0:\n            ans = max(ans, metrics.maxSuffixSum + (k - 2) * metrics.totalSum + metrics.maxPrefixSum)\n        \n        return ans\n\n\ndef max_sub_array_sum_repeated(array: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array,\n    formed by repeating the given array k times.\n    \"\"\"\n    service = MaxSubarrayService()\n    return service.max_sub_array_sum_repeated(array, n, k)\n```"}
{"task_id": "Mbpp/287", "solution": "```python\n# src/square_sum.py\n\nclass EvenNumberSequence:\n    \"\"\"Generates a sequence of even natural numbers.\"\"\"\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Generates the first n even natural numbers.\"\"\"\n        return [2 * i for i in range(1, n + 1)]\n\nclass Result:\n    \"\"\"Wraps an integer result value.\"\"\"\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes Result with a value.\"\"\"\n        self.value = value\n\n    def get(self) -> int:\n        \"\"\"Returns the wrapped integer value.\"\"\"\n        return self.value\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of squares of the first n even natural numbers.\n    It calculates (2*1)^2 + (2*2)^2 + ... + (2*n)^2.\n    \"\"\"\n    ens = EvenNumberSequence()\n    even_numbers = ens.generate(n)\n    \n    sum_of_squares = 0\n    for num in even_numbers:\n        sum_of_squares += num * num\n        \n    result_wrapper = Result(sum_of_squares)\n    return result_wrapper.get()\n\n```\n```python\n# tests/test_square_sum.py\n\nimport sys\nimport os\n\n# Add the 'src' directory to Python's path to allow importing square_Sum.\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nsrc_dir = os.path.join(current_dir, '..', 'src')\nsys.path.insert(0, src_dir)\n\n# Import the square_Sum function from the main module.\nfrom square_sum import square_Sum\n\nclass TestCase:\n    \"\"\"Encapsulates and executes an assertion-based test.\"\"\"\n    def __init__(self, assertion: str) -> None:\n        \"\"\"Initializes the test case with an assertion string.\"\"\"\n        self.assertion = assertion\n\n    def run(self) -> None:\n        \"\"\"Executes the specific assertion: assert square_Sum(2) == 20.\"\"\"\n        print(f\"Running test: {self.assertion}\")\n        assert square_Sum(2) == 20\n        print(\"Assertion passed for square_Sum(2) == 20.\")\n\n# Top-level test invocation\nif __name__ == \"__main__\":\n    test_case = TestCase(\"assert square_Sum(2) == 20\")\n    test_case.run()\n\n```"}
{"task_id": "Mbpp/287", "solution": "```python\ndef _generate_even_series(n: int) -> list:\n    \"\"\"Generate a list of the first n even natural numbers.\n    Returns [] if n is 0.\n    \"\"\"\n    return list(range(2, 2 * n + 1, 2))\n\n\ndef square_Sum(n: int) -> int:\n    \"\"\"Compute the sum of squares of the first n even natural numbers.\n    Returns 0 if n is 0.\n    \"\"\"\n    even_numbers = _generate_even_series(n)\n    return sum(x * x for x in even_numbers)\n```"}
{"task_id": "Mbpp/290", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Any\n\n@dataclass\nclass ListOfLists:\n    \"\"\"Represents a collection of sublists, mapping to the SRS domain model.\"\"\"\n    lists: List[List[Any]]\n\n    def get_sublist(self, index: int) -> List[Any]:\n        \"\"\"Returns the sublist at the specified index.\"\"\"\n        return self.lists[index]\n\n@dataclass\nclass Sublist:\n    \"\"\"Represents a single sublist, mapping to the SRS domain model.\"\"\"\n    elements: List[Any]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in this sublist.\"\"\"\n        return len(self.elements)\n\n@dataclass\nclass ResultTuple:\n    \"\"\"Encapsulates the result of max_length as length and sublist.\"\"\"\n    length: int\n    sublist: List[Any]\n\n    def as_tuple(self) -> Tuple[int, List[Any]]:\n        \"\"\"Converts this result object into the required (length, sublist) tuple.\"\"\"\n        return (self.length, self.sublist)\n\ndef max_length(lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"Compute and return (length, sublist).\n\n    Tie-breaking: returns the first sublist encountered with maximal length.\n    Behavior for empty input: raise ValueError(\"lists must contain at least one sublist\").\n    \"\"\"\n    if not lists:\n        raise ValueError(\"lists must contain at least one sublist\")\n\n    list_of_lists_wrapper = ListOfLists(lists)\n\n    # Initialize with the first sublist to establish a baseline for comparison\n    # and satisfy the \"first sublist encountered\" tie-breaking rule.\n    first_sublist_data = list_of_lists_wrapper.get_sublist(0)\n    current_max_len = Sublist(first_sublist_data).length()\n    current_max_sublist = first_sublist_data\n\n    # Iterate through the remaining sublists to find any longer ones.\n    for i in range(1, len(list_of_lists_wrapper.lists)):\n        sublist_data = list_of_lists_wrapper.get_sublist(i)\n        sublist_length = Sublist(sublist_data).length()\n\n        if sublist_length > current_max_len:\n            current_max_len = sublist_length\n            current_max_sublist = sublist_data\n\n    result = ResultTuple(length=current_max_len, sublist=current_max_sublist)\n    return result.as_tuple()"}
