{"task_id": "Mbpp/388", "solution": "```python\n# src/highest_Power_of_2.py\n\nclass Parameter:\n    \"\"\"Encapsulates input parameter n and provides validation methods.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the stored parameter n is an integer.\"\"\"\n        return isinstance(self.n, int)\n\nclass PowerOfTwo:\n    \"\"\"Data container for a power of two, storing its value and exponent.\"\"\"\n    def __init__(self, value: int, exponent: int):\n        self.value = value\n        self.exponent = exponent\n\nclass Function:\n    \"\"\"Encapsulates the core computation logic for finding the highest power of two.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the largest power of two less than or equal to n.\n        n is guaranteed to be an integer >= 1 at this point.\n        \"\"\"\n        exponent = n.bit_length() - 1\n        value = 1 << exponent  # Calculate 2**exponent efficiently.\n        _ = PowerOfTwo(value, exponent) # Construct PowerOfTwo as per design's class diagram.\n        return value\n\ndef highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Returns the largest power of two (2^k, k >= 0) less than or equal to n.\n    Raises TypeError if n is not an integer, ValueError if n < 1.\n    \"\"\"\n    param = Parameter(n)\n\n    if not param.is_integer():\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n < 1:\n        raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\n    func = Function()\n    result_value = func.compute(n)\n    return result_value\n```\n```python\n# tests/test_highest_Power_of_2.py\n\nimport pytest\nfrom src.highest_Power_of_2 import highest_Power_of_2\n\ndef test_example_assertion():\n    \"\"\"Verify the primary example assertion from the SRS.\"\"\"\n    assert highest_Power_of_2(10) == 8\n\ndef test_non_integer_raises_TypeError():\n    \"\"\"Ensure a TypeError is raised for non-integer inputs.\"\"\"\n    with pytest.raises(TypeError) as excinfo:\n        highest_Power_of_2(10.5)\n    assert \"Input 'n' must be an integer.\" in str(excinfo.value)\n\n    with pytest.raises(TypeError) as excinfo:\n        highest_Power_of_2(\"abc\")\n    assert \"Input 'n' must be an integer.\" in str(excinfo.value)\n\ndef test_n_less_than_1_raises_ValueError():\n    \"\"\"Ensure a ValueError is raised for inputs less than 1.\"\"\"\n    with pytest.raises(ValueError) as excinfo:\n        highest_Power_of_2(0)\n    assert \"Input 'n' must be greater than or equal to 1.\" in str(excinfo.value)\n\n    with pytest.raises(ValueError) as excinfo:\n        highest_Power_of_2(-5)\n    assert \"Input 'n' must be greater than or equal to 1.\" in str(excinfo.value)\n\ndef test_exact_power_of_two():\n    \"\"\"Test when n is exactly a power of two.\"\"\"\n    assert highest_Power_of_2(1) == 1\n    assert highest_Power_of_2(2) == 2\n    assert highest_Power_of_2(4) == 4\n    assert highest_Power_of_2(8) == 8\n    assert highest_Power_of_2(16) == 16\n\ndef test_n_just_above_power_of_two():\n    \"\"\"Test when n is just above a power of two.\"\"\"\n    assert highest_Power_of_2(3) == 2\n    assert highest_Power_of_2(5) == 4\n    assert highest_Power_of_2(9) == 8\n    assert highest_Power_of_2(17) == 16\n\ndef test_large_n():\n    \"\"\"Test with a relatively large integer.\"\"\"\n    assert highest_Power_of_2(1_000_000_000) == 536870912 # 2^29\n    assert highest_Power_of_2(2**60) == 2**60\n    assert highest_Power_of_2((2**60) + 1) == 2**60\n```"}
{"task_id": "Mbpp/312", "solution": "```python\ndef volume_cone(radius, height):\n    \"\"\"Calculates the volume of a right circular cone using the formula V = (1/3) * pi * r^2 * h.\n    The PI constant is derived from the specified MathConstants value in the design document.\"\"\"\n    PI = 3.141592653589793\n    volume = (1/3) * PI * (radius ** 2) * height\n    return float(volume)\n```"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Computes the n-th Lucas number iteratively.\n    Assumes n is a non-negative integer as per critical constraints.\n    \"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        # Initialize L0 and L1\n        a, b = 2, 1\n        # Iterate from L2 up to Ln\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "Mbpp/389", "solution": "```python\n# src/lucas/lucas_impl.py\nclass InputParameter:\n    \"\"\"Holds an input index 'n'.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass LucasNumber:\n    \"\"\"Holds a computed Lucas number and its index.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\nclass LucasFunction:\n    \"\"\"Computes Lucas numbers with input validation and iterative calculation.\"\"\"\n\n    def validateInput(self, n: int) -> None:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _computeIterative(self, n: int) -> int:\n        \"\"\"Computes the n-th Lucas number iteratively for valid n.\"\"\"\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n\n        a, b = 2, 1  # L_0, L_1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Validates input n and computes the n-th Lucas number.\"\"\"\n        self.validateInput(n)\n        result = self._computeIterative(n)\n        return result\n\n```\n```python\n# src/lucas/__init__.py\nfrom .lucas_impl import LucasFunction\n\ndef find_lucas(n: int) -> int:\n    \"\"\"Computes the n-th Lucas number, delegating to LucasFunction.\"\"\"\n    lucas_calc = LucasFunction()\n    return lucas_calc.find_lucas(n)\n\n# Re-export LucasFunction for callers/tests.\n__all__ = [\"find_lucas\", \"LucasFunction\"]\n\n```\n```python\n# tests/test_lucas.py\nimport pytest\nfrom src.lucas import find_lucas # Relative import from the package root.\n\ndef test_base_cases() -> None:\n    \"\"\"Verifies the base cases L_0 and L_1.\"\"\"\n    assert find_lucas(0) == 2\n    assert find_lucas(1) == 1\n\ndef test_sequence_values() -> None:\n    \"\"\"Checks various Lucas numbers in the sequence.\"\"\"\n    assert find_lucas(2) == 3\n    assert find_lucas(3) == 4\n    assert find_lucas(4) == 7\n    assert find_lucas(5) == 11\n    assert find_lucas(6) == 18\n    assert find_lucas(7) == 29\n    assert find_lucas(8) == 47\n\ndef test_example_assertion() -> None:\n    \"\"\"Verifies the specific example assertion find_lucas(9) == 76.\"\"\"\n    assert find_lucas(9) == 76\n\ndef test_invalid_inputs() -> None:\n    \"\"\"Ensures invalid inputs raise ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"non-negative integer\"):\n        find_lucas(-1)\n    with pytest.raises(ValueError, match=\"non-negative integer\"):\n        find_lucas(1.5)\n    with pytest.raises(ValueError, match=\"non-negative integer\"):\n        find_lucas(\"abc\")\n\n```\n```python\n# tests/run_tests.py\nimport sys\nfrom src.lucas import find_lucas # Relative import from package root.\n\nclass TestAssertion:\n    \"\"\"Verifies a single Lucas number assertion.\"\"\"\n    def __init__(self, n: int, expected_value: int) -> None:\n        self.n = n\n        self.expected_value = expected_value\n\n    def run(self) -> bool:\n        \"\"\"Executes the Lucas number computation and compares to expected.\"\"\"\n        try:\n            actual_value = find_lucas(self.n)\n            if actual_value == self.expected_value:\n                print(f\"TestAssertion(n={self.n}): PASS (Expected {self.expected_value}, Got {actual_value})\")\n                return True\n            else:\n                print(f\"TestAssertion(n={self.n}): FAIL (Expected {self.expected_value}, Got {actual_value})\")\n                return False\n        except Exception as e:\n            print(f\"TestAssertion(n={self.n}): ERROR (Exception: {e})\")\n            return False\n\ndef main() -> int:\n    \"\"\"Main entry point to run the example assertion test.\"\"\"\n    test_assertion = TestAssertion(9, 76)\n    if test_assertion.run():\n        return 0  # Success\n    else:\n        return 1  # Failure\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```"}
{"task_id": "Mbpp/390", "solution": "```python\nfrom typing import Any, List\n\ndef _format_element(element: Any, format_string: str) -> str:\n    \"\"\"Converts an element to string and substitutes it into the format string.\"\"\"\n    return format_string.replace('{0}', str(element))\n\ndef add_string(input_list: List[Any], format_string: str) -> List[str]:\n    \"\"\"Applies a format string to each element in a list, returning a new formatted list.\"\"\"\n    result_list: List[str] = []\n    for element in input_list:\n        formatted_element = _format_element(element, format_string)\n        result_list.append(formatted_element)\n    return result_list\n```"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(identifiers, names, values):\n    \"\"\"\n    Converts three lists into a list of nested dictionaries, preserving order.\n    Assumes inputs are of equal length and valid as per critical requirements.\n    \"\"\"\n    result = []\n    for i in range(len(identifiers)):\n        inner_dict = {names[i]: values[i]}\n        outer_dict = {identifiers[i]: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/390", "solution": "```python\nfrom typing import List, Any\n\ndef add_string(input_list: List[Any], format_string: str) -> List[str]:\n    \"\"\"\n    Applies format_string to each element of input_list replacing occurrences of '{0}' with str(element).\n    Returns a new list of strings and does not mutate input_list.\n    \"\"\"\n    output_list: List[str] = []\n    for element in input_list:\n        str_e = str(element)\n        formatted = format_string.replace('{0}', str_e)\n        output_list.append(formatted)\n    return output_list\n```"}
{"task_id": "Mbpp/391", "solution": "class LengthMismatchError(Exception):\n    \"\"\"Exception raised when input lists for conversion have differing lengths.\n    It indicates a failure in input validation before processing.\n    \"\"\"\n    def __init__(self, message: str = None):\n        super().__init__(message)\n\n\ndef validate_lengths(outer_keys, inner_keys, values) -> None:\n    \"\"\"Validates that all three input lists have the same length.\n    Raises LengthMismatchError if the lengths are not equal.\n    \"\"\"\n    len_outer = len(outer_keys)\n    len_inner = len(inner_keys)\n    len_values = len(values)\n\n    if not (len_outer == len_inner == len_values):\n        message = (\n            f\"Input list lengths do not match: \"\n            f\"outer_keys={len_outer}, inner_keys={len_inner}, values={len_values}.\"\n        )\n        raise LengthMismatchError(message)\n\n\ndef build_nested_list(outer_keys, inner_keys, values) -> list:\n    \"\"\"Constructs a list of nested dictionaries from three equal-length input lists.\n    Each element is {outer_key: {inner_key: value}} preserving original order.\n    \"\"\"\n    result = []\n    for outer_key, inner_key, value in zip(outer_keys, inner_keys, values):\n        result.append({outer_key: {inner_key: value}})\n    return result\n\n\ndef convert_list_dictionary(outer_keys, inner_keys, values) -> list:\n    \"\"\"Public API to convert three lists into a list of nested dictionaries.\n    It validates list lengths and constructs the result, raising LengthMismatchError on mismatch.\n    \"\"\"\n    validate_lengths(outer_keys, inner_keys, values)\n    return build_nested_list(outer_keys, inner_keys, values)"}
{"task_id": "Mbpp/392", "solution": "```python\nfrom typing import Callable\n\n# Module-level memoization cache stores computed f(n) values.\n_memoization_cache: dict[int, int] = {}\n\nclass BaseCase:\n    \"\"\"Handles base case detection and value retrieval.\"\"\"\n    def __init__(self):\n        self._base_values = {0: 0, 1: 1}\n\n    def isBaseCase(self, n: int) -> bool:\n        \"\"\"Checks if n is a predefined base case.\"\"\"\n        return n in self._base_values\n\n    def value(self, n: int) -> int:\n        \"\"\"Returns the stored value for a base case n.\"\"\"\n        return self._base_values[n]\n\nclass Recurrence:\n    \"\"\"Computes the sum of recursive subcomponents as per the recurrence relation.\"\"\"\n    def decompose(self, n: int, f: Callable[[int], int]) -> int:\n        \"\"\"Calculates the sum f(n/2) + f(n/3) + f(n/4) + f(n/5) using integer division.\"\"\"\n        sum_components = (\n            f(n // 2) +\n            f(n // 3) +\n            f(n // 4) +\n            f(n // 5)\n        )\n        return sum_components\n\nclass GetMaxSumFunction:\n    \"\"\"Orchestrates the computation of f(n) using memoization, base cases, and recurrence.\"\"\"\n    def __init__(self):\n        self._cache = _memoization_cache\n        self._recurrence = Recurrence()\n        self._base_case = BaseCase()\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes f(n) for a given non-negative integer n, utilizing memoization.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        if self._base_case.isBaseCase(n):\n            result = self._base_case.value(n)\n        else:\n            decomposition_sum = self._recurrence.decompose(n, self.compute)\n            result = max(decomposition_sum, n)\n\n        self._cache[n] = result\n        return result\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"Primary API to compute the maximum sum f(n) for a non-negative integer n.\"\"\"\n    # Delegates the computation to an instance of GetMaxSumFunction.\n    return GetMaxSumFunction().compute(n)\n```"}
