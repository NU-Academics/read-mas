_call = original_tuple[:] # Create a shallow copy for comparison\n    \n    _ = check_tuplex(original_tuple, 1) # Call the function\n    assert original_tuple == tuple_before_call\n\n    _ = TupleSearchService.check_tuplex(original_tuple, 'test') # Call the static method\n    assert original_tuple == tuple_before_call\n\n```"}
{"task_id": "Mbpp/410", "solution": "```python\n# src/min_val.py\nfrom typing import Any, Optional, Union\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef min_val(input_list: list) -> Optional[Union[int, float]]:\n    \"\"\"\n    Finds the smallest numeric value in a list, ignoring non-numeric elements.\n    Returns None if no numeric elements are found.\n    \"\"\"\n    min_found = None\n    for item in input_list:\n        if _is_numeric(item):\n            if min_found is None or item < min_found:\n                min_found = item\n    return min_found\n```\n\n```python\n# tests/test_min_val.py\nfrom src.min_val import min_val\n\ndef run_tests() -> None:\n    \"\"\"\n    Executes acceptance and unit tests for the min_val function.\n    Asserts expected behavior for various input lists.\n    \"\"\"\n    # FR4: SRS Acceptance Test\n    assert min_val(['Python', 3, 2, 4, 5, 'version']) == 2, \"SRS Acceptance Test Failed\"\n\n    # Design Decision: No numeric elements returns None\n    assert min_val(['a', 'b', 'c']) is None, \"Test failed for list with no numeric elements\"\n    assert min_val([]) is None, \"Test failed for empty list\"\n\n    # Mixed numeric types (int and float)\n    assert min_val([10, 3.5, 2, -1.0, 7]) == -1.0, \"Test failed for mixed int/float list\"\n    assert min_val([10.5, 'text', 2.1, 'other', -5]) == -5, \"Test failed for mixed types with negative float\"\n    assert min_val([7]) == 7, \"Test failed for single numeric element\"\n    assert min_val(['one', 100]) == 100, \"Test failed for list with one numeric element among non-numerics\"\n    assert min_val([-10, -5.5, -2, -1.0]) == -10, \"Test failed for all negative numbers\"\n    assert min_val([0, 0.0, -1]) == -1, \"Test failed for zero and negative numbers\"\n\n    print(\"All tests passed!\")\n\nif __name__ == '__main__':\n    run_tests()\n```\n\n```markdown\n# min_val Utility\n\nThis project provides a minimal Python utility to find the minimum numeric value in a heterogeneous list.\n\n## Usage\n\nThe core functionality is provided by the `min_val` function in `src/min_val.py`.\n\n## Running Tests\n\nTo execute the acceptance tests and other unit assertions, navigate to the project root and run:\n\n```bash\npython -m tests.test_min_val\n```\n\nExpected output on success: `All tests passed!`\n```"}
{"task_id": "Mbpp/409", "solution": "```python\n# src/min_product.py\n\nfrom typing import Iterable, Tuple, Union, List, Any, Optional\n\nclass InputValidator:\n    \"\"\"Centralizes input validation logic.\"\"\"\n    @staticmethod\n    def validate_non_empty(input_list: List[Any]) -> None:\n        \"\"\"Validates that the input list is not empty.\"\"\"\n        if not input_list:\n            raise ValueError(\"input list is empty\")\n\n    @staticmethod\n    def validate_tuple_shape_and_types(item: Any, index: int) -> None:\n        \"\"\"Validates an element is a 2-element numeric tuple.\"\"\"\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(f\"element at index {index} is not a 2-element tuple\")\n        if not isinstance(item[0], (int, float)) or not isinstance(item[1], (int, float)):\n            raise TypeError(f\"element at index {index} contains non-numeric entries\")\n\nclass TuplePair:\n    \"\"\"Lightweight value object for a pair of numbers.\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]):\n        self.a = a\n        self.b = b\n\n    def product(self) -> Union[int, float]:\n        \"\"\"Computes the product of the two numbers.\"\"\"\n        return self.a * self.b\n\nclass Result:\n    \"\"\"Conceptual holder for the minimum product.\"\"\"\n    def __init__(self, min_product: Union[int, float]):\n        self.min_product = min_product\n\nclass MinProductCalculator:\n    \"\"\"Calculates the minimum product in a list of validated tuples.\"\"\"\n    def min_product_tuple(self, input_list: List[Any]) -> Union[int, float]:\n        \"\"\"Iterates input, computes products, and tracks the minimum.\"\"\"\n        current_min_product: Optional[Union[int, float]] = None\n\n        for index, item in enumerate(input_list):\n            InputValidator.validate_tuple_shape_and_types(item, index)\n            pair = TuplePair(item[0], item[1])\n            product_val = pair.product()\n\n            if current_min_product is None or product_val < current_min_product:\n                current_min_product = product_val\n        \n        # input_list is guaranteed non-empty by validate_non_empty,\n        # so current_min_product will always be initialized.\n        return current_min_product if current_min_product is not None else 0\n\ndef min_product_tuple(input_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"Validates input, computes products, and returns the minimum product.\n    Achieves O(n) time and O(1) additional memory.\"\"\"\n    InputValidator.validate_non_empty(input_list)\n\n    calculator = MinProductCalculator()\n    min_prod = calculator.min_product_tuple(input_list)\n\n    return min_prod\n\n# src/__init__.py content (conceptual within this single block)\n# from .min_product import min_product_tuple\n# __all__ = ['min_product_tuple']\n```"}
{"task_id": "Mbpp/410", "solution": "```python\ndef _extract_numerics(list_arg):\n    \"\"\"Internal helper. Returns an iterator of int or float elements from list_arg.\"\"\"\n    for item in list_arg:\n        if isinstance(item, (int, float)):\n            yield item\n\ndef _compute_minimum(numeric_iterable):\n    \"\"\"Internal helper. Returns the minimum numeric value from numeric_iterable.\"\"\"\n    return min(numeric_iterable)\n\ndef min_val(list_arg):\n    \"\"\"Public API. Extracts numeric elements and computes their minimum value.\n    Precondition: list_arg is a list containing at least one numeric element.\"\"\"\n    numeric_elements = _extract_numerics(list_arg)\n    minimum_value = _compute_minimum(numeric_elements)\n    return minimum_value\n```"}
