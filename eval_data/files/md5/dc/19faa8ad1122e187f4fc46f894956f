{"task_id": "Mbpp/227", "solution": "```python\n# src/min_of_three.py\n\"\"\"Provides the min_of_three function for finding the smallest of three numbers.\"\"\"\n\ndef min_of_three(a, b, c):\n    \"\"\"Returns the smallest of the three numeric arguments a, b, and c.\n    Ties are handled by returning the shared minimum value.\"\"\"\n    if a <= b and a <= c:\n        return a\n    if b <= a and b <= c:\n        return b\n    return c\n\n```\n```python\n# tests/test_min_of_three.py\nimport sys\nimport os\n\n# Add the 'src' directory to the Python path for importing min_of_three\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))\n\nfrom min_of_three import min_of_three\n\nclass NumericValue:\n    \"\"\"Models a single numeric value for use in test inputs.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass ParameterList:\n    \"\"\"Aggregates a list of NumericValue objects as function parameters.\"\"\"\n    def __init__(self, params: list[NumericValue]):\n        self.params = params\n\nclass TestCase:\n    \"\"\"Represents a single test case with an ID, input parameters, and an expected result.\"\"\"\n    def __init__(self, id: str, input: ParameterList, expected):\n        self.id = id\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes the test case by calling min_of_three and comparing the result.\"\"\"\n        if len(self.input.params) != 3:\n            raise ValueError(f\"Test case '{self.id}' expects 3 parameters, got {len(self.input.params)}\")\n\n        result = min_of_three(\n            self.input.params[0].value,\n            self.input.params[1].value,\n            self.input.params[2].value\n        )\n        return result == self.expected\n\ndef run_tests() -> None:\n    \"\"\"Executes the SRS-required assertion and additional acceptance checks.\"\"\"\n    print(\"Running tests for min_of_three...\")\n\n    # SRS-required assertion\n    srs_test = TestCase(\n        \"SRS_RequiredAssertion\",\n        ParameterList([NumericValue(10), NumericValue(20), NumericValue(0)]),\n        0\n    )\n    assert srs_test.run(), f\"Test '{srs_test.id}' failed!\"\n    print(f\"Test '{srs_test.id}' passed.\")\n\n    # Additional acceptance checks as per design\n    test_case_1 = TestCase(\n        \"Acceptance_DecreasingOrder\",\n        ParameterList([NumericValue(3), NumericValue(2), NumericValue(1)]),\n        1\n    )\n    assert test_case_1.run(), f\"Test '{test_case_1.id}' failed!\"\n    print(f\"Test '{test_case_1.id}' passed.\")\n\n    test_case_2 = TestCase(\n        \"Acceptance_TiedMinimum\",\n        ParameterList([NumericValue(2), NumericValue(2), NumericValue(3)]),\n        2\n    )\n    assert test_case_2.run(), f\"Test '{test_case_2.id}' failed!\"\n    print(f\"Test '{test_case_2.id}' passed.\")\n\n    test_case_3 = TestCase(\n        \"Acceptance_MixedNumbers\",\n        ParameterList([NumericValue(5.5), NumericValue(-1.2), NumericValue(3.0)]),\n        -1.2\n    )\n    assert test_case_3.run(), f\"Test '{test_case_3.id}' failed!\"\n    print(f\"Test '{test_case_3.id}' passed.\")\n\n    print(\"All specified tests passed successfully.\")\n\nif __name__ == '__main__':\n    run_tests()\n\n```"}
{"task_id": "Mbpp/227", "solution": "```python\n# Project root\n# \u251c\u2500\u2500 src/\n# \u2502   \u251c\u2500\u2500 __init__.py\n# \u2502   \u2514\u2500\u2500 min_of_three.py\n# \u2514\u2500\u2500 tests/\n#     \u2514\u2500\u2500 test_min_of_three.py\n\n# --- src/__init__.py ---\n# This file can be empty to signify a Python package.\n\n# --- src/min_of_three.py ---\nfrom dataclasses import dataclass\n\n@dataclass\nclass Number:\n    \"\"\"Lightweight data carrier for numeric value and textual type.\n    Represents numeric inputs for traceability within the system.\n    \"\"\"\n    value: float\n    type: str\n\ndef validateInputs(a, b, c):\n    \"\"\"Validate that a, b, c are numeric (int or float).\n    Raises TypeError if any argument is not numeric.\n    \"\"\"\n    for arg in [a, b, c]:\n        if not isinstance(arg, (int, float)):\n            raise TypeError(\"All arguments must be numeric (int or float).\")\n\ndef min_of_three(a, b, c):\n    \"\"\"Public API: return the smallest of three numeric arguments after validation.\n    This function first validates inputs then computes the minimum value.\n    \"\"\"\n    validateInputs(a, b, c)\n    return min(a, b, c)\n\n# --- tests/test_min_of_three.py ---\nfrom src.min_of_three import min_of_three\n\nclass TestCase:\n    \"\"\"Provides the executable unit test for the min_of_three function.\n    This class encapsulates the test assertion as defined in the design.\n    \"\"\"\n    def __init__(self, name):\n        self.name = name\n\n    def run(self):\n        \"\"\"Executes the required assertion for min_of_three(10, 20, 0) == 0.\n        Returns True on success, raises AssertionError on failure.\n        \"\"\"\n        assert min_of_three(10, 20, 0) == 0\n        return True\n\nif __name__ == '__main__':\n    t = TestCase('min_of_three_example')\n    try:\n        t.run()\n        print('TEST PASSED: assert min_of_three(10, 20, 0) == 0')\n    except AssertionError:\n        print('TEST FAILED: min_of_three(10, 20, 0) != 0')\n        raise\n```"}
