{"task_id": "Mbpp/398", "solution": "```python\nfrom typing import List, Iterator\n\nclass Digit:\n    \"\"\"Represents a single decimal digit (0..9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Number:\n    \"\"\"Represents a single integer and provides its decimal digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns decimal digits of the absolute value.\"\"\"\n        # Converts the number to its absolute string form and extracts digits as integers.\n        return [int(d) for d in str(abs(self.value))]\n\nclass IntegerList:\n    \"\"\"Encapsulates the input list of integers.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers = numbers\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Enables iteration over the encapsulated numbers.\"\"\"\n        return iter(self.numbers)\n\nclass SumResult:\n    \"\"\"Holds computed total sum of digits.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\nclass SumOfDigitsFunction:\n    \"\"\"Computes sum of decimal digits for all numbers in an IntegerList.\"\"\"\n    def compute(self, integer_list: IntegerList) -> int:\n        \"\"\"Iterates IntegerList, extracts digits, and accumulates sum.\"\"\"\n        total_sum = 0\n        for number_value in integer_list:\n            number_obj = Number(number_value)\n            digits_list = number_obj.digits()\n            total_sum += sum(digits_list)\n        return total_sum\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Public entry point for computing the sum of digits.\"\"\"\n    integer_list = IntegerList(numbers)\n    service = SumOfDigitsFunction()\n    return service.compute(integer_list)\n```"}
{"task_id": "Mbpp/398", "solution": "```python\n# src/sum_of_digits.py\n\nfrom dataclasses import dataclass\nfrom typing import List\n\nclass Digit:\n    \"\"\"Value object for a single decimal digit (0..9).\"\"\"\n    def __init__(self, value: int) -> None:\n        if not (0 <= value <= 9):\n            raise ValueError(\"Digit value must be between 0 and 9.\")\n        self.value = value\n\nclass Integer:\n    \"\"\"Wraps an integer and provides digit extraction, ignoring sign.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digits(self) -> List[Digit]:\n        \"\"\"Extracts decimal digits from the absolute value of the integer.\"\"\"\n        abs_value_str = str(abs(self.value))\n        if not abs_value_str:  # Handles 0 correctly\n            return [Digit(0)]\n        return [Digit(int(d)) for d in abs_value_str]\n\nclass IntegerList:\n    \"\"\"Represents and validates a list of integers, wrapping them as Integer objects.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        if not isinstance(elements, list):\n            raise TypeError(\"Input must be a list of integers.\")\n        \n        self.elements: List[Integer] = []\n        for item in elements:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n            self.elements.append(Integer(item))\n\n    def length(self) -> int:\n        \"\"\"Returns the number of Integer elements in the list.\"\"\"\n        return len(self.elements)\n\nclass Result:\n    \"\"\"Holds the aggregated total sum of digits.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\nclass SumOfDigitsFunction:\n    \"\"\"Encapsulates the computation algorithm for summing digits.\"\"\"\n    name: str = \"sum_of_digits\"\n\n    def compute(self, integer_list: IntegerList) -> Result:\n        \"\"\"Computes the total sum of all decimal digits from the IntegerList.\"\"\"\n        current_total = 0\n        for integer_obj in integer_list.elements:\n            for digit_obj in integer_obj.digits():\n                current_total += digit_obj.value\n        return Result(current_total)\n\ndef sum_of_digits(list_of_integers: List[int]) -> int:\n    \"\"\"\n    Public API to compute the sum of all decimal digits of each integer in the input list.\n    Ignores numeric sign and returns the aggregated total.\n    \"\"\"\n    integer_list_validated = IntegerList(list_of_integers)\n    calculator = SumOfDigitsFunction()\n    result = calculator.compute(integer_list_validated)\n    return result.total\n```\n```python\n# tests/test_sum_of_digits.py\n\nfrom src.sum_of_digits import sum_of_digits\n\ndef test_acceptance_sum_of_digits() -> None:\n    \"\"\"Automated verification of the acceptance test.\"\"\"\n    assert sum_of_digits([10, 2, 56]) == 14\n\n# Additional tests to cover design requirements (e.g., negative numbers, zero, empty list)\ndef test_single_digit_numbers() -> None:\n    assert sum_of_digits([1, 2, 3]) == 6\n\ndef test_mixed_positive_and_negative_numbers() -> None:\n    # Digits are extracted from absolute values\n    assert sum_of_digits([10, -20, 3]) == 1 + 0 + 2 + 0 + 3 == 6\n\ndef test_zero_and_large_numbers() -> None:\n    assert sum_of_digits([0, 123, -45]) == 0 + 1 + 2 + 3 + 4 + 5 == 15\n\ndef test_empty_list() -> None:\n    assert sum_of_digits([]) == 0\n\ndef test_list_with_only_zero() -> None:\n    assert sum_of_digits([0, 0, 0]) == 0\n\ndef test_large_numbers_with_zeros() -> None:\n    assert sum_of_digits([100, 2030, 4005]) == 1+0+0 + 2+0+3+0 + 4+0+0+5 == 15\n\nimport pytest\n\ndef test_invalid_input_not_list() -> None:\n    with pytest.raises(TypeError, match=\"Input must be a list of integers.\"):\n        sum_of_digits(\"not a list\") # type: ignore\n\ndef test_invalid_input_contains_non_integer() -> None:\n    with pytest.raises(TypeError, match=\"All elements in the list must be integers.\"):\n        sum_of_digits([1, 2.5, 3]) # type: ignore\n\n    with pytest.raises(TypeError, match=\"All elements in the list must be integers.\"):\n        sum_of_digits([1, \"string\", 3]) # type: ignore\n```"}
