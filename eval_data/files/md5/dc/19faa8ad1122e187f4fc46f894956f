{"task_id": "Mbpp/63", "solution": "To implement the software design specification, the following files are generated:\n\n***\n\n### `src/__init__.py`\n\n```python\n\"\"\"\nPackage initializer that re-exports the public API symbol(s).\n\"\"\"\nfrom .max_difference import max_difference\n```\n\n***\n\n### `src/max_difference.py`\n\n```python\nimport collections.abc\nfrom typing import Iterable, Tuple, Any\n\ndef _validate_and_iterate_pairs(pairs: Any) -> Iterable[Tuple[int, int]]:\n    \"\"\"Validates the input 'pairs' and yields validated (int, int) tuples.\n    Raises TypeError or ValueError for invalid input according to SRS.\n    \"\"\"\n    if not isinstance(pairs, collections.abc.Iterable):\n        raise TypeError(\"Input must be an iterable.\")\n\n    pairs_iterator = iter(pairs)\n    try:\n        first_element = next(pairs_iterator)\n    except StopIteration:\n        raise ValueError(\"Input iterable cannot be empty.\")\n\n    if not (isinstance(first_element, (tuple, list)) and len(first_element) == 2):\n        raise TypeError(\"Each element in the iterable must be a 2-element tuple-like structure.\")\n    if not (isinstance(first_element[0], int) and isinstance(first_element[1], int)):\n        raise TypeError(\"Both elements within each pair must be integers.\")\n    yield (first_element[0], first_element[1])\n\n    for element in pairs_iterator:\n        if not (isinstance(element, (tuple, list)) and len(element) == 2):\n            raise TypeError(\"Each element in the iterable must be a 2-element tuple-like structure.\")\n        if not (isinstance(element[0], int) and isinstance(element[1], int)):\n            raise TypeError(\"Both elements within each pair must be integers.\")\n        yield (element[0], element[1])\n\n\ndef max_difference(pairs: Iterable[Tuple[int, int]]) -> int:\n    \"\"\"Computes the maximum absolute difference between pairs of integers.\n    Validates input and raises TypeError/ValueError for invalid cases as per SRS.\n    \"\"\"\n    validated_pairs = _validate_and_iterate_pairs(pairs)\n\n    first_a, first_b = next(validated_pairs)\n    max_diff = abs(first_a - first_b)\n\n    for a, b in validated_pairs:\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff\n```\n\n***\n\n### `tests/test_max_difference.py`\n\n```python\nimport pytest\nfrom src.max_difference import max_difference\n\ndef test_example_assertion():\n    \"\"\"Verify the example assertion from the SRS documentation.\"\"\"\n    assert max_difference([(3, 5), (1, 7), (10, 3), (1, 2)]) == 7\n\n@pytest.mark.parametrize(\n    \"invalid_input, expected_exception, error_message_part\",\n    [\n        # Non-iterable inputs\n        (None, TypeError, \"Input must be an iterable.\"),\n        (123, TypeError, \"Input must be an iterable.\"),\n        (\"a_string\", TypeError, \"Input must be an iterable.\"),\n        # Empty iterable\n        ([], ValueError, \"Input iterable cannot be empty.\"),\n        (iter([]), ValueError, \"Input iterable cannot be empty.\"),\n        # Wrong-length tuple-like elements\n        ([(1,)], TypeError, \"Each element in the iterable must be a 2-element tuple-like structure.\"),\n        ([(1, 2, 3)], TypeError, \"Each element in the iterable must be a 2-element tuple-like structure.\"),\n        ([(1, ), (2, 3)], TypeError, \"Each element in the iterable must be a 2-element tuple-like structure.\"),\n        # Non-integer elements within pairs\n        ([(1, \"2\")], TypeError, \"Both elements within each pair must be integers.\"),\n        ([(\"1\", 2)], TypeError, \"Both elements within each pair must be integers.\"),\n        ([(1.0, 2)], TypeError, \"Both elements within each pair must be integers.\"),\n        ([(1, None)], TypeError, \"Both elements within each pair must be integers.\"),\n        ([(1, 2), (3, \"4\")], TypeError, \"Both elements within each pair must be integers.\"),\n        ([(1,2), (3, 4.0)], TypeError, \"Both elements within each pair must be integers.\"),\n    ]\n)\ndef test_invalid_inputs(invalid_input, expected_exception, error_message_part):\n    \"\"\"Test various invalid input cases for max_difference.\n    Asserts the correct exception type and message part.\n    \"\"\"\n    with pytest.raises(expected_exception) as excinfo:\n        max_difference(invalid_input)\n    assert error_message_part in str(excinfo.value)\n```"}
{"task_id": "Mbpp/64", "solution": "```python\nfrom typing import List, Tuple, Optional\n\nclass SubjectMark:\n    \"\"\"Immutable/readonly representation of a single (subject, marks) pair.\"\"\"\n    def __init__(self, subject: str, marks: int) -> None:\n        self.subject = subject\n        self.marks = marks\n\n    def as_tuple(self) -> Tuple[str, int]:\n        \"\"\"Returns the subject and marks as a tuple.\"\"\"\n        return (self.subject, self.marks)\n\nclass SubjectMarksList:\n    \"\"\"Holds an ordered collection of SubjectMark instances and provides collection operations.\"\"\"\n    def __init__(self, items: Optional[List[SubjectMark]] = None) -> None:\n        self.items = items if items is not None else []\n\n    def size(self) -> int:\n        \"\"\"Returns the number of SubjectMark items in the list.\"\"\"\n        return len(self.items)\n\n    def to_tuple_list(self) -> List[Tuple[str, int]]:\n        \"\"\"Converts the list of SubjectMark objects to a list of (subject, marks) tuples.\"\"\"\n        return [item.as_tuple() for item in self.items]\n\nclass SubjectMarksService:\n    \"\"\"Core service to accept subject/marks data, map to domain objects, and sort.\"\"\"\n    def subject_marks(self, list_of_tuples: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n        \"\"\"Accepts a list of (subject, marks) tuples, processes them, and returns a sorted list.\"\"\"\n        # Map input tuples to SubjectMark objects.\n        subject_mark_objects = [SubjectMark(s, m) for s, m in list_of_tuples]\n        \n        # Use SubjectMarksList to hold the collection (as per design's 'uses' relationship).\n        subject_marks_collection = SubjectMarksList(subject_mark_objects)\n        \n        # Convert back to tuples for the sortBySecondElementAsc method.\n        tuples_for_sorting = subject_marks_collection.to_tuple_list()\n\n        return self.sortBySecondElementAsc(tuples_for_sorting)\n\n    def sortBySecondElementAsc(self, list_of_tuples: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n        \"\"\"Sorts the input list of tuples by their second element in ascending order.\"\"\"\n        # Returns a new list containing the sorted tuples.\n        return sorted(list_of_tuples, key=lambda x: x[1])\n\ndef subject_marks(list_of_tuples: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"Public API function: sorts a list of (subject, marks) tuples by marks in ascending order.\"\"\"\n    # This function acts as a thin wrapper, delegating the task to SubjectMarksService.\n    service = SubjectMarksService()\n    return service.subject_marks(list_of_tuples)\n```"}
