{"task_id": "Mbpp/283", "solution": "```python\nimport collections\nimport collections.abc\n\nclass IntegerInput:\n    \"\"\"Represents the integer input value and provides its normalized decimal-string representation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_decimal_string(self) -> str:\n        \"\"\"Returns the decimal representation of the absolute integer value.\"\"\"\n        return str(abs(self.value))\n\nclass Digit:\n    \"\"\"Represents a single digit and its occurrence count.\"\"\"\n    def __init__(self, value: int, count: int) -> None:\n        self.value = value\n        self.count = count\n\nclass DigitFrequency:\n    \"\"\"Computes and maintains a mapping of digits to their counts from a decimal string.\"\"\"\n    def __init__(self, decimal_str: str) -> None:\n        self.digitsToCounts: dict[int, int] = collections.defaultdict(int)\n        for char_digit in decimal_str:\n            digit = int(char_digit)\n            self.digitsToCounts[digit] += 1\n\n    def get_count(self, digit: int) -> int:\n        \"\"\"Returns the count for a given digit, or 0 if the digit is not present.\"\"\"\n        return self.digitsToCounts.get(digit, 0)\n\n    def items(self) -> collections.abc.Iterable[tuple[int, int]]:\n        \"\"\"Returns an iterable of (digit, count) pairs.\"\"\"\n        return self.digitsToCounts.items()\n\nclass ValidationResult:\n    \"\"\"Encapsulates the boolean result of a validation.\"\"\"\n    def __init__(self, is_valid: bool) -> None:\n        self.is_valid = is_valid\n\nclass ValidateFunction:\n    \"\"\"Orchestrates validation: accepts IntegerInput, computes DigitFrequency, applies business rules, and returns ValidationResult.\"\"\"\n    def validate(self, integer_input: IntegerInput) -> ValidationResult:\n        \"\"\"Validates an IntegerInput based on digit frequency rules.\"\"\"\n        decimal_str = integer_input.to_decimal_string()\n        digit_frequency = DigitFrequency(decimal_str)\n\n        is_valid = True\n        for digit, count in digit_frequency.items():\n            if count > digit:\n                is_valid = False\n                break\n        \n        return ValidationResult(is_valid)\n\ndef validate(integer: int) -> bool:\n    \"\"\"Public API entry point for validating an integer's digit frequencies.\"\"\"\n    integer_input = IntegerInput(integer)\n    validator = ValidateFunction()\n    result = validator.validate(integer_input)\n    return result.is_valid\n```"}
