{"task_id": "Mbpp/96", "solution": "from math import isqrt\n\ndef divisor(n: int) -> int:\n    \"\"\"Compute and return the number of positive divisors of n.\"\"\"\n    count = 0\n    # The SRS leaves n <= 0 behavior unspecified; this implementation assumes integer input n > 0 is typical.\n    # For n=0, isqrt(0) is 0, range(1, 1) is empty, count=0 (correct for positive divisors).\n    # For n<0, math.isqrt will raise ValueError.\n    root = isqrt(n)\n    for i in range(1, root + 1):\n        if n % i == 0:\n            count += 1\n            j = n // i\n            if j != i:\n                count += 1\n    return count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(value: int) -> str:\n    \"\"\"\n    Converts a decimal integer to its binary string representation with no leading zeros.\n    Returns '0' for an input of 0.\n    \"\"\"\n    if value == 0:\n        return '0'\n\n    binary_digits = []\n    while value > 0:\n        remainder = value % 2\n        binary_digits.append(str(remainder))\n        value //= 2\n\n    return ''.join(reversed(binary_digits))"}
{"task_id": "Mbpp/98", "solution": "def validate_collection(collection):\n    \"\"\"\n    Validates that the input is a non-empty list or tuple containing only numeric elements.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(collection, (list, tuple)):\n        raise TypeError('input must be a list or tuple')\n    if not collection:\n        raise ValueError('input collection must not be empty')\n    for element in collection:\n        if not isinstance(element, (int, float)):\n            raise TypeError('all elements must be int or float')\n\ndef compute_product(elements) -> float:\n    \"\"\"\n    Computes the floating-point product of all numeric elements in a collection.\n    Initializes product as 1.0 to ensure a float result.\n    \"\"\"\n    product = 1.0\n    for num in elements:\n        product *= num\n    return product\n\ndef divide_by_length(product: float, length: int) -> float:\n    \"\"\"\n    Performs floating-point division of the product by the given length.\n    Ensures the result is a float.\n    \"\"\"\n    return product / length\n\ndef multiply_num(collection):\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides the product by the length of the collection.\n    Performs input validation and returns a float result.\n    \"\"\"\n    validate_collection(collection)\n    \n    product = compute_product(collection)\n    length = len(collection)\n    \n    result = divide_by_length(product, length)\n    \n    return result"}
{"task_id": "Mbpp/97", "solution": "import collections\nfrom typing import List, Dict\n\ndef validate_input(list_of_lists: List[List[int]]) -> None:\n    \"\"\"\n    Enforce input contract: top-level is list, each inner item is list of ints.\n    Raises TypeError on invalid input.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for i, sublist in enumerate(list_of_lists):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} must be a list, got {type(sublist).__name__}.\")\n        for j, element in enumerate(sublist):\n            if not isinstance(element, int):\n                raise TypeError(f\"Element at [{i}][{j}] must be an integer, got {type(element).__name__}.\")\n\ndef flatten(list_of_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Flattens a list of lists into a single list, preserving order and duplicates.\n    \"\"\"\n    return [item for sublist in list_of_lists for item in sublist]\n\ndef count_frequencies(flattened_list: List[int]) -> Dict[int, int]:\n    \"\"\"\n    Counts occurrences of each integer in the flattened list and returns a frequency map.\n    \"\"\"\n    return collections.Counter(flattened_list)\n\ndef frequency_lists(list_of_lists: List[List[int]]) -> Dict[int, int]:\n    \"\"\"\n    Validate -> Flatten -> Count -> Return dict[int,int]. Raises TypeError on invalid input.\n    \"\"\"\n    validate_input(list_of_lists)\n    flattened = flatten(list_of_lists)\n    result = count_frequencies(flattened)\n    return result"}
{"task_id": "Mbpp/100", "solution": "def _normalize_decimal_representation(value: int) -> str:\n    \"\"\"Removes leading sign and leading zeros for palindrome checks.\"\"\"\n    return str(abs(value))\n\nclass PalindromeChecker:\n    \"\"\"Checks if an integer's decimal representation is a palindrome.\"\"\"\n    def isPalindrome(self, value: int) -> bool:\n        \"\"\"Uses normalization to check the palindrome property.\"\"\"\n        normalized_str = _normalize_decimal_representation(value)\n        return normalized_str == normalized_str[::-1]\n\nclass PalindromeFinder:\n    \"\"\"Finds the next smallest palindrome greater than a given integer.\"\"\"\n    def __init__(self):\n        self._palindrome_checker = PalindromeChecker()\n\n    def next_smallest_palindrome(self, input_value: int) -> int:\n        \"\"\"Finds the smallest palindrome strictly greater than input_value.\"\"\"\n        candidate = input_value + 1\n        while True:\n            if self._palindrome_checker.isPalindrome(candidate):\n                return candidate\n            candidate = self._incrementCandidate(candidate)\n\n    def _incrementCandidate(self, candidate: int) -> int:\n        \"\"\"Returns the next candidate integer.\"\"\"\n        return candidate + 1\n\n    def _normalizeRepresentation(self, value: int) -> str:\n        \"\"\"Normalizes decimal representation for internal use, delegates to shared helper.\"\"\"\n        return _normalize_decimal_representation(value)\n\ndef next_smallest_palindrome(integer: int) -> int:\n    \"\"\"\n    Write a function to find the next smallest palindrome of a specified integer, returned as an integer.\n    assert next_smallest_palindrome(99)==101\n    \"\"\"\n    finder = PalindromeFinder()\n    return finder.next_smallest_palindrome(integer)"}
{"task_id": "Mbpp/101", "solution": "class KthElementError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputTypeError(KthElementError):\n    pass\n\nclass IndexOutOfRangeError(KthElementError):\n    pass\n\ndef _validate_arr(arr) -> None:\n    if not isinstance(arr, (list, tuple)):\n        raise InputTypeError(\"arr must be a list or tuple.\")\n\ndef _validate_k(k: int, length: int) -> None:\n    if not isinstance(k, int):\n        raise InputTypeError(\"k must be an integer.\")\n    if not (1 <= k <= length):\n        raise IndexOutOfRangeError(f\"k out of range: valid 1..{length}\")\n\ndef kth_element(arr, k):\n    \"\"\"Return element at 1-based index k from arr or raise descriptive error.\n\n    Args:\n        arr: a list/sequence of elements (must not be None)\n        k: integer index interpreted as 1-based (1..len(arr))\n\n    Raises:\n        InputTypeError: when arr is None or not list-like, or k is not integer.\n        IndexOutOfRangeError: when k < 1 or k > len(arr) (including empty arr).\n\n    Returns:\n        element at position k (arr[k-1])\n    \"\"\"\n    _validate_arr(arr)\n    \n    length = len(arr)\n\n    _validate_k(k, length)\n    \n    actual_index = k - 1\n    \n    return arr[actual_index]"}
{"task_id": "Mbpp/102", "solution": "class InputString:\n    \"\"\"Simple container for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass OutputString:\n    \"\"\"Simple container for the output string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates that the input is a string.\"\"\"\n    @staticmethod\n    def validate(input):\n        if not isinstance(input, str):\n            raise TypeError(\"input must be a string\")\n\nclass Tokenizer:\n    \"\"\"Splits an input string into tokens based on underscores.\"\"\"\n    def tokenize(self, input_str: str) -> list[str]:\n        return input_str.split('_')\n\nclass Capitalizer:\n    \"\"\"Capitalizes the first letter of each token, preserving empty tokens.\"\"\"\n    def capitalize(self, token: str) -> str:\n        if token == '':\n            return ''\n        else:\n            return token[0].upper() + token[1:]\n\nclass Concatenator:\n    \"\"\"Joins a list of strings into a single string without separators.\"\"\"\n    def concatenate(self, tokens: list[str]) -> str:\n        return ''.join(tokens)\n\ndef snake_to_camel(input_string):\n    \"\"\"\n    Converts a snake_case string to CamelCase (PascalCase).\n    \"\"\"\n    Validator.validate(input_string)\n    in_model = InputString(value=input_string)\n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(in_model.value)\n    capitalizer = Capitalizer()\n    capitalized_tokens = [capitalizer.capitalize(t) for t in tokens]\n    concatenator = Concatenator()\n    result = concatenator.concatenate(capitalized_tokens)\n    out_model = OutputString(value=result)\n    return out_model.value"}
{"task_id": "Mbpp/105", "solution": "def count(items):\n    \"\"\"Counts the number of True boolean values in a list.\n    It strictly checks for items that are of type bool and have a value of True.\n    \"\"\"\n    true_count = 0\n    for item in items:\n        if isinstance(item, bool) and item is True:\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/103", "solution": "class InputValidationError(ValueError):\n    \"\"\"Exception raised for invalid input parameters to Eulerian number calculation.\"\"\"\n    pass\n\n\nclass Parameters:\n    \"\"\"Data-holder for validated parameters n and m.\"\"\"\n    def __init__(self, n: int, m: int):\n        self.n = n\n        self.m = m\n\n\nclass Result:\n    \"\"\"Encapsulates a returned integer Eulerian value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n\nclass EulerianCalculator:\n    \"\"\"\n    Computes Eulerian numbers a(n, m) after validating inputs.\n    Uses an iterative dynamic programming approach based on a recurrence relation.\n    \"\"\"\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"\n        Validates parameters, computes a(n, m), and returns the integer result.\n        Raises InputValidationError on invalid input.\n        \"\"\"\n        self._validate_parameters(n, m)\n        return self._compute_iterative(n, m)\n\n    def _validate_parameters(self, n: int, m: int) -> Parameters:\n        \"\"\"\n        Enforces type and domain preconditions: n and m must be integers,\n        n >= 0, and 0 <= m < n. Raises InputValidationError on violation.\n        \"\"\"\n        if not isinstance(n, int):\n            raise InputValidationError(f\"Input 'n' must be an integer, but got {type(n).__name__}.\")\n        if not isinstance(m, int):\n            raise InputValidationError(f\"Input 'm' must be an integer, but got {type(m).__name__}.\")\n\n        if n < 0:\n            raise InputValidationError(f\"Input 'n' must be non-negative, but got {n}.\")\n        if not (n > 0 and 0 <= m < n):\n            raise InputValidationError(f\"Input 'm' must satisfy 0 <= m < n, but got n={n}, m={m}.\")\n\n        return Parameters(n, m)\n\n    def _compute_iterative(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) using an iterative dynamic programming approach.\n        The algorithm applies the recurrence A(i, j) = (j+1)A(i-1, j) + (i-j)A(i-1, j-1)\n        with A(0,0)=1 and A(i,j)=0 for j<0 or j>=i.\n        \"\"\"\n        # DP table: dp[i][j] stores A(i, j).\n        # We need rows up to 'n' and columns up to 'n-1' (since m < n).\n        # Initialize dp table with (n+1) rows and 'n' columns.\n        dp = [[0] * n for _ in range(n + 1)]\n\n        # Base case: A(0,0) = 1.\n        # This is only used for internal calculation; external inputs with n=0 are invalid per validation.\n        dp[0][0] = 1\n\n        # Fill the DP table using the recurrence relation.\n        for i in range(1, n + 1):  # For i from 1 to n (current n)\n            for j in range(i):      # For j from 0 to i-1 (current m)\n                term1 = 0\n                if j < n: # Ensure j is within column bounds for dp[i-1][j]\n                    term1 = (j + 1) * dp[i-1][j]\n\n                term2 = 0\n                if j - 1 >= 0: # Ensure j-1 is non-negative for dp[i-1][j-1]\n                    term2 = (i - j) * dp[i-1][j-1]\n                \n                dp[i][j] = term1 + term2\n        \n        return dp[n][m]\n\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m).\n    Raises InputValidationError for invalid input types or domain violations (n < 0 or not 0 <= m < n).\n    \"\"\"\n    calculator = EulerianCalculator()\n    return calculator.eulerian_num(n, m)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(container):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists.\n    Returns a new list of lists where each inner list is sorted lexicographically.\n    \"\"\"\n    def sort_sublist(sublist):\n        \"\"\"Returns a new list with sorted elements from the input sublist.\"\"\"\n        return sorted(sublist)\n\n    result_list = []\n    for sublist_item in container:\n        result_list.append(sort_sublist(sublist_item))\n    return result_list"}
