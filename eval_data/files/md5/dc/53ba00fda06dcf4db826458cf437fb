{"task_id": "Mbpp/801", "solution": "```python\ndef test_three_equal(a, b, c):\n    \"\"\"\n    Counts the number of equal numbers among three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are distinct.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0\n```"}
{"task_id": "Mbpp/804", "solution": "from typing import Iterable\nimport collections.abc\n\ndef _is_even(value: int) -> bool:\n    \"\"\"Checks if a given integer value is even.\"\"\"\n    return value % 2 == 0\n\ndef _validate_numbers(numbers: Iterable) -> None:\n    \"\"\"\n    Validates that the input is an iterable of integers.\n    Raises TypeError if input is not iterable, ValueError if elements are not integers.\n    \"\"\"\n    if not isinstance(numbers, collections.abc.Iterable):\n        raise TypeError(\"Input 'numbers' must be an iterable.\")\n    for number in numbers:\n        if not isinstance(number, int):\n            raise ValueError(\"All elements in 'numbers' must be integers.\")\n\ndef is_product_even(numbers: Iterable[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Raises TypeError if input is not iterable, ValueError if elements are not integers.\n    \"\"\"\n    _validate_numbers(numbers)\n    for number in numbers:\n        if _is_even(number):\n            return True\n    return False"}
{"task_id": "Mbpp/803", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Optional\n\n@dataclass\nclass Number:\n    value: int\n    def is_non_negative(self) -> bool:\n        return self.value >= 0\n\n@dataclass\nclass IntegerRoot:\n    k: int\n    def is_valid(self) -> bool:\n        return True\n\n@dataclass\nclass CheckResult:\n    is_perfect: bool\n    root: Optional[int] = None\n\nclass PerfectSquareChecker:\n    @staticmethod\n    def is_perfect_square(n: int) -> bool:\n        \"\"\"Determines if a number is a perfect square.\"\"\"\n        num_wrapper = Number(value=n)\n\n        if not num_wrapper.is_non_negative():\n            return False\n\n        k = math.isqrt(n)\n        root_wrapper = IntegerRoot(k=k)\n\n        is_perfect = (root_wrapper.k * root_wrapper.k == n)\n\n        return is_perfect\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if the given number is a perfect square.\"\"\"\n    return PerfectSquareChecker.is_perfect_square(n)"}
