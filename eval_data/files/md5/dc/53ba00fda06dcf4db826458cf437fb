{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"Return the first repeated character in s by scanning left-to-right.\n\n    Returns the first repeated character (single-character string) if found,\n    or None if no repeated character is found.\n    \"\"\"\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/603", "solution": "from typing import List\n\nclass LudicGenerator:\n    \"\"\"Encapsulates the logic for generating ludic numbers.\"\"\"\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Generates ludic numbers up to n, orchestrating candidate generation and sieve application.\"\"\"\n        if n < 1:\n            return []\n        if n == 1:\n            return [1]\n\n        # 1 is always the first ludic number\n        ludic_numbers = [1]\n        \n        # Generate candidates from 2 up to n\n        candidates_for_sieve = self.generateCandidates(n)\n        \n        # Apply the sieve to find ludic numbers starting from 2\n        ludics_from_sieve = self.applySieve(candidates_for_sieve)\n        \n        return ludic_numbers + ludics_from_sieve\n\n    def generateCandidates(self, limit: int) -> List[int]:\n        \"\"\"Returns an initial list of integers from 2 up to the given limit.\"\"\"\n        return list(range(2, limit + 1))\n\n    def applySieve(self, candidates: List[int]) -> List[int]:\n        \"\"\"Applies the ludic sieve algorithm to a list of candidates.\"\"\"\n        ludic_numbers_from_sieve = []\n        \n        # Work with a mutable copy of candidates\n        sieve_list = list(candidates)\n\n        while sieve_list:\n            next_ludic_factor = sieve_list[0]\n            ludic_numbers_from_sieve.append(next_ludic_factor)\n            \n            sieve_list.pop(0) # Remove the current ludic number from the list\n\n            if not sieve_list:\n                break\n\n            # Collect indices to remove, iterating backwards to avoid index issues during removal\n            indices_to_remove = []\n            for i in range(len(sieve_list)):\n                # If (i + 1) is a multiple of next_ludic_factor, it's a position to remove (1-indexed)\n                if (i + 1) % next_ludic_factor == 0:\n                    indices_to_remove.append(i)\n            \n            for index in sorted(indices_to_remove, reverse=True):\n                sieve_list.pop(index)\n                \n        return ludic_numbers_from_sieve\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"Returns all ludic numbers less than or equal to n.\"\"\"\n    generator = LudicGenerator()\n    return generator.get_ludic(n)"}
{"task_id": "Mbpp/606", "solution": "PiConstant = 3.141592653589793\n\ndef radian_degree(degrees) -> float:\n    \"\"\"Compute radians from degrees using PiConstant = 3.141592653589793.\n    The conversion formula is radians = degrees * PiConstant / 180.\n    \"\"\"\n    result = float(degrees) * PiConstant / 180\n    return result"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"Return a string with words reversed. Words are tokens separated by ASCII space (0x20).\"\"\"\n    tokens = input.split(' ')\n    reversed_tokens = list(reversed(tokens))\n    return ' '.join(reversed_tokens)"}
{"task_id": "Mbpp/605", "solution": "import math\n\nclass IntegerValue:\n    def __init__(self, v: int) -> None:\n        self.value: int = v\n    def getValue(self) -> int:\n        return self.value\n\nclass PrimeCheckResult:\n    def __init__(self, is_prime: bool) -> None:\n        self.is_prime: bool = is_prime\n    def get(self) -> bool:\n        return self.is_prime\n\nclass PrimeChecker:\n    def __init__(self, algorithm: str = \"trial_division\") -> None:\n        self._algorithm: str = algorithm\n\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Return True iff n is prime. Handles n < 2 and implements trial division for n >= 2.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\ndef prime_num(n: int) -> bool:\n    \"\"\"Checks if the given integer is a prime number.\"\"\"\n    # Input validation (e.g., for non-integer types) is omitted based on prompt instructions.\n    checker = PrimeChecker()\n    return checker.isPrime(n)"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import NamedTuple\n\nclass MatchResult(NamedTuple):\n    \"\"\"\n    Represents a successful match result with the matched text and its indices.\n    \"\"\"\n    matched_text: str\n    start_index: int\n    end_index: int\n\ndef find_literals(source: str, pattern: str) -> MatchResult:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring,\n    its 0-based start index, and its exclusive end index.\n    \"\"\"\n    match = re.search(pattern, source)\n    # The design specifies only successful-match behavior is required.\n    # We assume 'match' will not be None for the intended use cases based on design context.\n    matched_text = match.group(0)\n    start_index = match.start()\n    end_index = match.end()\n    return MatchResult(matched_text, start_index, end_index)"}
{"task_id": "Mbpp/608", "solution": "class InputParameter:\n    \"\"\"Validates the input parameter n for the Bell number calculation.\"\"\"\n    def __init__(self, n_val: int):\n        self._n = n_val\n\n    def validate(self) -> int:\n        \"\"\"Raises TypeError for non-integers or ValueError for negative integers.\"\"\"\n        if not isinstance(self._n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if self._n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n        return self._n\n\nclass IntegerArithmetic:\n    \"\"\"Computes the nth Bell number using the Bell triangle algorithm.\"\"\"\n    def compute(self, n_val: int) -> int:\n        \"\"\"Calculates the nth Bell number using integer arithmetic.\"\"\"\n        if n_val == 0:\n            return 1\n\n        bell_triangle = [[0] * (i + 1) for i in range(n_val + 1)]\n        bell_triangle[0][0] = 1\n\n        for i in range(1, n_val + 1):\n            bell_triangle[i][0] = bell_triangle[i-1][i-1]\n            for j in range(1, i + 1):\n                bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n        return bell_triangle[n_val][0]\n\nclass Result:\n    \"\"\"A simple value object to encapsulate the integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass BellNumberFunction:\n    \"\"\"Orchestrates the validation and computation of Bell numbers.\"\"\"\n    def bell_Number(self, n_val: int) -> int:\n        \"\"\"Delegates input validation and Bell number calculation.\"\"\"\n        validator = InputParameter(n_val)\n        validated_n = validator.validate()\n\n        calculator = IntegerArithmetic()\n        bell_num_value = calculator.compute(validated_n)\n\n        result_obj = Result(bell_num_value)\n        return result_obj.value\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number (zero-indexed).\n    Raises TypeError if n is not an int, ValueError if n is negative.\n    \"\"\"\n    return BellNumberFunction().bell_Number(n)"}
{"task_id": "Mbpp/610", "solution": "class ValidationError(IndexError):\n    \"\"\"Custom exception for validation errors, inheriting from IndexError.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputList:\n    \"\"\"Wrapper for an input list with utility methods.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def copy_elements(self) -> list:\n        \"\"\"Returns a shallow copy of the list's elements.\"\"\"\n        return self.elements[:]\n\nclass OutputList:\n    \"\"\"Wrapper for a resulting list.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\nclass IndexParameter:\n    \"\"\"Encapsulates a 1-based index and its validation.\"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n\n    def is_valid_for(self, input_list_obj: InputList) -> bool:\n        \"\"\"Checks if the index k is valid for the given input list.\"\"\"\n        return 1 <= self.k <= input_list_obj.length()\n\nclass RemoveKthElementFunction:\n    \"\"\"Encapsulates the logic for validating and removing the k'th element.\"\"\"\n    def __init__(self, input_list: list, k: int) -> None:\n        self._input_list = input_list\n        self._k = k\n\n    def execute(self) -> list:\n        \"\"\"Validates the index k and returns a new list with the k'th element removed.\"\"\"\n        input_list_obj = InputList(self._input_list)\n        index_param = IndexParameter(self._k)\n\n        if not index_param.is_valid_for(input_list_obj):\n            raise ValidationError(f\"Index {self._k} is out of range for list of length {input_list_obj.length()}\")\n\n        copied_list = input_list_obj.copy_elements()\n        del copied_list[self._k - 1]  # k is 1-based, convert to 0-based\n        \n        output_list_obj = OutputList(copied_list)\n        return output_list_obj.elements\n\ndef remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th element removed (1-based indexing).\n    Raises ValidationError (subclass of IndexError) if k is out of bounds.\n    \"\"\"\n    remover = RemoveKthElementFunction(input_list, k)\n    return remover.execute()"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List, Tuple\n\ndef _validate_pairs(pairs: List[List[Any]]) -> None:\n    \"\"\"\n    Validates that the input 'pairs' is a list of sublists,\n    where each sublist contains exactly two elements.\n    \"\"\"\n    for pair in pairs:\n        if not isinstance(pair, list) or len(pair) != 2:\n            raise ValueError(\"Each element of 'pairs' must be a sequence of length 2\")\n\ndef _split_pairs(pairs: List[List[Any]]) -> Tuple[List[Any], List[Any]]:\n    \"\"\"\n    Splits a list of 2-element sublists into two separate lists,\n    one for the first elements and one for the second.\n    \"\"\"\n    first_list = [pair[0] for pair in pairs]\n    second_list = [pair[1] for pair in pairs]\n    return first_list, second_list\n\ndef merge(pairs: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Merges a list of 2-element sublists into two separate lists.\n    The first output list contains the first elements of each sublist,\n    the second output list contains the second elements.\n    \"\"\"\n    _validate_pairs(pairs)\n    first_list, second_list = _split_pairs(pairs)\n    return [first_list, second_list]"}
{"task_id": "Mbpp/611", "solution": "class Row:\n    \"\"\"Thin wrapper for a single row; provides safe indexing.\"\"\"\n    def __init__(self, values: list):\n        self._values = values\n\n    def get_value(self, n: int):\n        \"\"\"Returns the value at index n, or raises IndexError if out of range.\"\"\"\n        if not (0 <= n < len(self._values)):\n            raise IndexError(\"Row index out of range\")\n        return self._values[n]\n\n\nclass Matrix:\n    \"\"\"Thin wrapper to represent and validate matrix input and extract column values.\"\"\"\n    def __init__(self, rows: list):\n        self._rows = [Row(row_values) for row_values in rows]\n\n    def validate_has_index(self, n: int) -> None:\n        \"\"\"Raises IndexError if any row lacks index n (BR-05).\"\"\"\n        for i, row in enumerate(self._rows):\n            try:\n                row.get_value(n)\n            except IndexError:\n                raise IndexError(f\"BR-05: Row {i} lacks index {n}\") from None\n\n    def get_column(self, n: int) -> list:\n        \"\"\"Returns a list of n-th values from each row.\"\"\"\n        return [row.get_value(n) for row in self._rows]\n\n\nclass MaxOfNth:\n    \"\"\"Computes the maximum of a list of comparable values.\"\"\"\n    def compute(self, column_values: list):\n        \"\"\"Returns the maximum value in the given list.\"\"\"\n        return max(column_values)\n\n\ndef max_of_nth(matrix, n):\n    \"\"\"Return the maximum value in the n-th column of matrix.\n\n    Parameters:\n    - matrix: list of lists where each inner list is a row\n    - n: int (zero-based column index)\n\n    Raises:\n    - IndexError: if any row lacks index n (BR-05)\n    - ValueError: if no values present to compute a maximum (e.g., empty matrix)\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    matrix_obj.validate_has_index(n)\n    column_values = matrix_obj.get_column(n)\n    return MaxOfNth().compute(column_values)"}
{"task_id": "Mbpp/614", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception raised for invalid input to the cummulative_sum function.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\ndef cummulative_sum(input_list):\n    \"\"\"\n    Calculates the cumulative sum of all integer values within a list of tuples.\n    Raises ValidationError for invalid input types.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise ValidationError(\"Input must be a list.\")\n\n    total_sum = 0\n    for item in input_list:\n        if not isinstance(item, tuple):\n            raise ValidationError(f\"All elements of the input list must be tuples, but found {type(item).__name__}.\")\n        for value in item:\n            if not isinstance(value, int):\n                raise ValidationError(f\"All elements within tuples must be integers, but found {type(value).__name__}.\")\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input):\n    \"\"\"Compute per-inner-tuple arithmetic means.\n    \"\"\"\n\n    def _is_numeric(value):\n        \"\"\"Return True if value is int or float; otherwise False.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validate_input(input_data):\n        \"\"\"Validate input per BR1-BR3; raise ValueError on violation.\"\"\"\n        if not isinstance(input_data, tuple):\n            raise ValueError(\"Input must be a tuple of tuples.\")\n        \n        for inner_tuple in input_data:\n            if not isinstance(inner_tuple, tuple):\n                raise ValueError(\"Each element of the input tuple must be a tuple.\")\n            if not inner_tuple:\n                raise ValueError(\"Each inner tuple must not be empty.\")\n            for value in inner_tuple:\n                if not _is_numeric(value):\n                    raise ValueError(\"All values within inner tuples must be numeric (int or float).\")\n\n    def compute_averages(input_data):\n        \"\"\"Assumes input validated; returns list[float] computed as sum(values)/len(values) for each inner tuple.\"\"\"\n        results = []\n        for inner_tuple in input_data:\n            results.append(float(sum(inner_tuple)) / len(inner_tuple))\n        return results\n\n    validate_input(input)\n    return compute_averages(input)"}
{"task_id": "Mbpp/616", "solution": "class Validator:\n    \"\"\"Encapsulates input validation logic for type, length, and zero divisors.\"\"\"\n    def check_type(self, value) -> None:\n        \"\"\"Raises TypeError if the value is not exactly a tuple.\"\"\"\n        if type(value) is not tuple:\n            raise TypeError(\"Both inputs must be tuples.\")\n\n    def check_length(self, a: tuple, b: tuple) -> None:\n        \"\"\"Raises ValueError if the lengths of the two tuples differ.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    def check_no_zero_divisor(self, b: tuple) -> None:\n        \"\"\"Raises ZeroDivisionError if any element in the divisor tuple is zero.\"\"\"\n        for divisor in b:\n            if divisor == 0:\n                raise ZeroDivisionError(\"Cannot perform modulo with zero as a divisor.\")\n\nclass TupleModuloFunction:\n    \"\"\"Orchestrates validation and element-wise modulo computation.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def _validate_types(self, a: tuple, b: tuple) -> None:\n        \"\"\"Validates that both inputs are exactly tuples.\"\"\"\n        self._validator.check_type(a)\n        self._validator.check_type(b)\n\n    def _validate_lengths(self, a: tuple, b: tuple) -> None:\n        \"\"\"Validates that both input tuples have the same length.\"\"\"\n        self._validator.check_length(a, b)\n\n    def _validate_divisors(self, b: tuple) -> None:\n        \"\"\"Validates that no divisor in tuple b is zero.\"\"\"\n        self._validator.check_no_zero_divisor(b)\n\n    def _compute_elementwise_modulo(self, a: tuple, b: tuple) -> tuple:\n        \"\"\"Performs the element-wise modulo computation.\"\"\"\n        return tuple(a[i] % b[i] for i in range(len(a)))\n\n    def tuple_modulo(self, a: tuple, b: tuple) -> tuple:\n        \"\"\"Validates inputs and computes element-wise modulo.\"\"\"\n        self._validate_types(a, b)\n        self._validate_lengths(a, b)\n        self._validate_divisors(b)\n        return self._compute_elementwise_modulo(a, b)\n\ndef tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Delegates to an internal orchestrator for validation and computation.\n    \"\"\"\n    processor = TupleModuloFunction()\n    return processor.tuple_modulo(a, b)"}
{"task_id": "Mbpp/618", "solution": "from typing import List\n\nclass LengthMismatchException(Exception):\n    def __init__(self, message: str = None):\n        super().__init__(message or \"Input lists must have the same length\")\n\ndef div_list(list1, list2) -> List[float]:\n    \"\"\"Compute element-wise division of two lists and return list of floats.\n    Raises LengthMismatchException if lengths differ.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise LengthMismatchException()\n\n    result = []\n    for i in range(len(list1)):\n        result.append(float(list1[i]) / float(list2[i]))\n    return result"}
{"task_id": "Mbpp/619", "solution": "class DigitCollector:\n    \"\"\"Collects ASCII digit characters from a string.\"\"\"\n    def collect(self, input_str: str) -> str:\n        digits = []\n        for char in input_str:\n            if '0' <= char <= '9':\n                digits.append(char)\n        return \"\".join(digits)\n\nclass NonDigitCollector:\n    \"\"\"Collects non-ASCII digit characters from a string.\"\"\"\n    def collect(self, input_str: str) -> str:\n        non_digits = []\n        for char in input_str:\n            if not ('0' <= char <= '9'):\n                non_digits.append(char)\n        return \"\".join(non_digits)\n\nclass MoveNumFunction:\n    \"\"\"Orchestrates the collection of digits and non-digits and combines them.\"\"\"\n    def __init__(self):\n        self._digit_collector = DigitCollector()\n        self._nondigit_collector = NonDigitCollector()\n\n    def move_num(self, input_str: str) -> str:\n        non_digit_seq = self._nondigit_collector.collect(input_str)\n        digit_seq = self._digit_collector.collect(input_str)\n        return non_digit_seq + digit_seq\n\ndef move_num(input: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving the relative order of both non-numeric and numeric characters.\n    \"\"\"\n    orchestrator = MoveNumFunction()\n    return orchestrator.move_num(input)"}
