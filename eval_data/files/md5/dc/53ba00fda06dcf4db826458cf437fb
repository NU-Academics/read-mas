{"task_id": "Mbpp/643", "solution": "def _is_ascii_alpha(ch: str) -> bool:\n    \"\"\"Returns True if the character is an ASCII alphabet (A-Z or a-z).\"\"\"\n    return ('A' <= ch <= 'Z') or ('a' <= ch <= 'z')\n\nclass Word:\n    \"\"\"\n    Represents an alphabetic word token with its text and original indices.\n    Provides behavior to detect an interior lowercase 'z'.\n    \"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int):\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def length(self) -> int:\n        return len(self.text)\n\n    def has_middle_z(self) -> bool:\n        \"\"\"\n        Checks if the word contains 'z' at an interior position (not first or last).\n        Words of length <= 2 cannot have a middle 'z'.\n        \"\"\"\n        if self.length() <= 2:\n            return False\n        \n        # Iterate from the second character to the second-to-last character (inclusive)\n        for i in range(1, self.length() - 1):\n            if self.text[i] == 'z':\n                return True\n        return False\n\nclass TextAnalyzer:\n    \"\"\"\n    Analyzes an input string by tokenizing it into words and checking\n    for the presence of an interior lowercase 'z' in any word.\n    \"\"\"\n    def __init__(self, input_text: str):\n        self.input_text = input_text\n\n    def extract_words(self) -> list[Word]:\n        \"\"\"\n        Identifies maximal ASCII alphabetic runs and constructs Word instances.\n        Non-alphabetic characters delimit words.\n        \"\"\"\n        words = []\n        start_of_word = -1  # Indicates if we are currently inside a word (-1 means not in a word)\n\n        for i, char in enumerate(self.input_text):\n            if _is_ascii_alpha(char):\n                if start_of_word == -1:  # Start of a new word\n                    start_of_word = i\n            else:  # Non-alphabetic character, potential word delimiter\n                if start_of_word != -1:  # A word just ended\n                    word_text = self.input_text[start_of_word:i]\n                    words.append(Word(word_text, start_of_word, i))\n                    start_of_word = -1  # Reset state\n\n        # Handle case where the string ends with a word\n        if start_of_word != -1:\n            word_text = self.input_text[start_of_word:]\n            words.append(Word(word_text, start_of_word, len(self.input_text)))\n            \n        return words\n\n    def contains_middle_z(self) -> bool:\n        \"\"\"\n        Checks if any extracted word contains an interior lowercase 'z'.\n        \"\"\"\n        words = self.extract_words()\n        for word in words:\n            if word.has_middle_z():\n                return True\n        return False\n\ndef text_match_wordz_middle(input_text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'z' in the middle of any word.\n    A word is a maximal contiguous sequence of ASCII alphabetic characters.\n    \"\"\"\n    analyzer = TextAnalyzer(input_text)\n    return analyzer.contains_middle_z()"}
{"task_id": "Mbpp/644", "solution": "from typing import List, Any\n\ndef reverse_Array_Upto_K(array: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Reverses a portion of an array up to a given position k, returning a new list.\n    Handles various k values: no change, partial reverse, or full reverse.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"array must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n\n    n = len(array)\n\n    if k <= 0:\n        return list(array)\n    elif k > n:\n        return array[::-1]\n    else: # 0 < k <= n\n        head = array[:k]\n        reversed_head = head[::-1]\n        tail = array[k:]\n        return reversed_head + tail"}
{"task_id": "Mbpp/723", "solution": "import collections.abc\n\ndef count_same_pair(list1, list2):\n    \"\"\"\n    Counts indices where values in two lists of the same length are identical.\n    Raises TypeError if inputs are not lists, or ValueError if lengths differ.\n    \"\"\"\n    if not isinstance(list1, collections.abc.Sequence) or isinstance(list1, str):\n        raise TypeError(\"list1 must be a sequence (e.g., list, tuple), not a string.\")\n    if not isinstance(list2, collections.abc.Sequence) or isinstance(list2, str):\n        raise TypeError(\"list2 must be a sequence (e.g., list, tuple), not a string.\")\n    \n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Any\n\n\nclass Cell:\n    \"\"\"Represent a single cell with row, column and numeric cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = float(cost) # Ensure cost is always float\n\n    def isNumeric(self) -> bool:\n        \"\"\"Checks if the cell's cost is numeric.\"\"\"\n        # Cost is always float due to __init__ conversion, so this always returns True for a valid Cell instance.\n        return True\n\n\nclass Matrix:\n    \"\"\"Represent an N x N matrix of numeric cell costs and provide accessors.\"\"\"\n    def __init__(self, raw_matrix: List[List[Any]]):\n        self._cells = raw_matrix # Store raw matrix for initial validation\n        self._size = 0\n        if raw_matrix and isinstance(raw_matrix, list):\n            self._size = len(raw_matrix)\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns a Cell object for the given coordinates.\"\"\"\n        return Cell(row, col, self._cells[row][col])\n\n    def getSize(self) -> int:\n        \"\"\"Returns the size N of the N*N matrix.\"\"\"\n        return self._size\n\n    def isSquare(self) -> bool:\n        \"\"\"Checks if the matrix is square.\"\"\"\n        if not self._cells:\n            return False # An empty matrix is not considered square for N*N\n        \n        n = self._size\n        if n == 0:\n            return False\n            \n        for row in self._cells:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n        return True\n\n\nclass Path:\n    \"\"\"Represent ordered sequence of Cells and support cost/average computations.\"\"\"\n    def __init__(self, cells: List[Cell]):\n        self.cells = cells\n        self.length = len(cells)\n        self._total_cost_cached = None # Cache for total cost\n\n    def computeTotalCost(self) -> float:\n        \"\"\"Computes and caches the total cost of the path.\"\"\"\n        if self._total_cost_cached is None:\n            self._total_cost_cached = sum(cell.cost for cell in self.cells)\n        return self._total_cost_cached\n\n    def computeAverage(self) -> float:\n        \"\"\"Computes the average cost per cell in the path.\"\"\"\n        if not self.length:\n            return 0.0 # Should not occur for valid paths (length 2N-1)\n        return self.computeTotalCost() / self.length\n\n\nclass Validator:\n    \"\"\"Validate matrix shape and numeric nature of cell values; raise ValueError on invalid input.\"\"\"\n    @staticmethod\n    def validateMatrix(m: Matrix) -> None:\n        \"\"\"Validates if the matrix is non-empty and square.\"\"\"\n        if not m._cells or m.getSize() == 0:\n            raise ValueError(\"Matrix cannot be empty.\")\n        \n        # Check if it's a list of lists structurally before checking square property\n        if not isinstance(m._cells, list):\n            raise ValueError(\"Input matrix must be a list of lists.\")\n        for row_idx, row in enumerate(m._cells):\n            if not isinstance(row, list):\n                raise ValueError(f\"Matrix row {row_idx} must be a list.\")\n\n        if not m.isSquare():\n            raise ValueError(\"Matrix must be square (N x N).\")\n\n    @staticmethod\n    def validateCellValues(m: Matrix) -> None:\n        \"\"\"Validates if all cell values in the matrix are numeric.\"\"\"\n        for r in range(m.getSize()):\n            for c in range(m.getSize()):\n                try:\n                    # Attempt to convert to float, which will fail if not numeric\n                    float(m._cells[r][c])\n                except (TypeError, ValueError):\n                    raise ValueError(f\"Cell ({r}, {c}) contains a non-numeric value: {m._cells[r][c]}\")\n\n\nclass PathCalculator:\n    \"\"\"Generate all valid right/down paths, compute totals and averages, and find maximum average.\"\"\"\n    @staticmethod\n    def _dfs(\n        matrix: Matrix,\n        r: int,\n        c: int,\n        current_path_cells: List[Cell],\n        all_paths: List[Path]\n    ) -> None:\n        \"\"\"Helper for depth-first search to find all paths.\"\"\"\n        n = matrix.getSize()\n\n        # Check bounds\n        if r >= n or c >= n:\n            return\n\n        # Add current cell to path (getCell ensures cost is float)\n        current_path_cells.append(matrix.getCell(r, c))\n\n        # If reached bottom-right, a path is found\n        if r == n - 1 and c == n - 1:\n            all_paths.append(Path(list(current_path_cells)))\n        else:\n            # Explore right\n            PathCalculator._dfs(matrix, r, c + 1, current_path_cells, all_paths)\n            # Explore down\n            PathCalculator._dfs(matrix, r + 1, c, current_path_cells, all_paths)\n\n        # Backtrack: remove current cell to explore other branches\n        current_path_cells.pop()\n\n    @staticmethod\n    def generatePaths(m: Matrix) -> List[Path]:\n        \"\"\"Generates all valid right/down paths from top-left to bottom-right.\"\"\"\n        all_paths: List[Path] = []\n        current_path_cells: List[Cell] = []\n        PathCalculator._dfs(m, 0, 0, current_path_cells, all_paths)\n        return all_paths\n\n    @staticmethod\n    def computePathTotal(p: Path) -> float:\n        \"\"\"Computes the total cost of a given path.\"\"\"\n        return p.computeTotalCost()\n\n    @staticmethod\n    def computePathAverage(p: Path) -> float:\n        \"\"\"Computes the average cost of a given path.\"\"\"\n        return p.computeAverage()\n\n    @staticmethod\n    def findMaxAverage(m: Matrix) -> float:\n        \"\"\"Finds the maximum average over all existing paths in the matrix.\"\"\"\n        all_paths = PathCalculator.generatePaths(m)\n        if not all_paths:\n            # This case should ideally be prevented by Validator for non-empty square matrices\n            return 0.0 \n        \n        max_avg = -float('inf')\n        for path in all_paths:\n            avg = PathCalculator.computePathAverage(path)\n            if avg > max_avg:\n                max_avg = avg\n        return max_avg\n\n\nclass Result:\n    \"\"\"Hold the resulting maximum average and expose it as a float.\"\"\"\n    def __init__(self, max_average: float):\n        self._maxAverage = max_average\n\n    def asFloat(self) -> float:\n        \"\"\"Returns the maximum average as a float.\"\"\"\n        return self._maxAverage\n\n\ndef maxAverageOfPath(matrix: List[List[float]]) -> float:\n    \"\"\"\n    Given a square matrix, finds the path from top-left to bottom-right with\n    the maximum average cost, moving only right or down.\n    \"\"\"\n    # Initial type check for the outermost structure before Matrix construction\n    if not isinstance(matrix, list):\n        raise ValueError(\"Input matrix must be a list of lists.\")\n\n    # Construct Matrix object. It initially stores raw values for validation.\n    matrix_obj = Matrix(matrix)\n\n    # Validate the matrix structure and cell values\n    Validator.validateMatrix(matrix_obj)\n    Validator.validateCellValues(matrix_obj)\n\n    # Calculate the maximum average path\n    max_avg_value = PathCalculator.findMaxAverage(matrix_obj)\n\n    # Encapsulate and return the result\n    result = Result(max_avg_value)\n    return result.asFloat()"}
