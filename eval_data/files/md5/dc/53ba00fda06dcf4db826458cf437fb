{"task_id": "Mbpp/479", "solution": "def first_Digit(value: int) -> int:\n    \"\"\"\n    Returns the most significant digit (0-9) of the integer magnitude of value.\n    Raises TypeError if value is not an int.\n    \"\"\"\n    if not isinstance(value, int):\n        raise TypeError(\"first_Digit: value must be int\")\n\n    num = abs(value)\n\n    if num == 0:\n        return 0\n\n    while num >= 10:\n        num //= 10\n\n    return num"}
{"task_id": "Mbpp/554", "solution": "def Split(inputList: list[int]) -> list[int]:\n    \"\"\"Return a list containing only the odd integers from inputList, preserving original order.\n    Preconditions: inputList is a list[int]. Behavior for other inputs is unspecified.\n    \"\"\"\n    odd_numbers = []\n    for item in inputList:\n        if item % 2 != 0:\n            odd_numbers.append(item)\n    return odd_numbers"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Set, Any\n\ndef tuple_intersection(listA: List[Tuple[Any, Any]], listB: List[Tuple[Any, Any]]) -> Set[Tuple[Any, Any]]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists irrespective of their order.\n    Returns a set of tuples, where each tuple's form is taken from listA for matches.\n    \"\"\"\n    if not listA or not listB:\n        return set()\n\n    # Create a set of frozensets from listB for efficient unordered comparison.\n    # Each frozenset represents an immutable, hashable unordered pair.\n    set_b_unordered = {frozenset({t[0], t[1]}) for t in listB}\n\n    # Initialize a set to store the intersection results.\n    intersection_result = set()\n\n    # Iterate through listA, normalize each tuple to an unordered pair,\n    # and check for its presence in set_b_unordered.\n    for t_a in listA:\n        unordered_t_a = frozenset({t_a[0], t_a[1]})\n        if unordered_t_a in set_b_unordered:\n            intersection_result.add(t_a)\n\n    return intersection_result"}
{"task_id": "Mbpp/555", "solution": "class NaturalNumberSequence:\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass SumOperation:\n    def compute_sum_cubes(self, seq: 'NaturalNumberSequence') -> int:\n        \"\"\"Computes the sum of cubes of the first n natural numbers using a formula.\"\"\"\n        n = seq.n\n        sum_of_first_n = n * (n + 1) // 2\n        return sum_of_first_n * sum_of_first_n\n\n    def compute_sum(self, seq: 'NaturalNumberSequence') -> int:\n        \"\"\"Computes the sum of the first n natural numbers using a formula.\"\"\"\n        n = seq.n\n        return n * (n + 1) // 2\n\nclass DifferenceFunction:\n    def difference(self, n: int) -> int:\n        \"\"\"Orchestrates the calculation of the difference between sums.\"\"\"\n        sequence = NaturalNumberSequence(n)\n        sum_operation = SumOperation()\n\n        sum_of_cubes = sum_operation.compute_sum_cubes(sequence)\n        sum_of_natural_numbers = sum_operation.compute_sum(sequence)\n\n        return sum_of_cubes - sum_of_natural_numbers\n\nclass Result:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    diff_calculator = DifferenceFunction()\n    return diff_calculator.difference(n)"}
{"task_id": "Mbpp/557", "solution": "def _toggle_char(c: str) -> str:\n    \"\"\"Toggles the case of an alphabetic character, otherwise returns it unchanged.\"\"\"\n    if c.isalpha():\n        if c.isupper():\n            return c.lower()\n        else:\n            return c.upper()\n    return c\n\ndef toggle_string(input: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string, preserving others.\"\"\"\n    result_chars = []\n    for char in input:\n        result_chars.append(_toggle_char(char))\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"Compute number of unordered index pairs (i, j) where arr[i] XOR arr[j] is odd, considering the first n elements.\n    This is equivalent to counting pairs with different parities: (even_count * odd_count).\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    arr_slice = arr[:n]\n\n    even_count = 0\n    odd_count = 0\n\n    for x in arr_slice:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return even_count * odd_count"}
{"task_id": "Mbpp/558", "solution": "def is_integer(obj) -> bool:\n    \"\"\"Checks if the given object is an integer.\"\"\"\n    return isinstance(obj, int)\n\ndef normalize(n: int) -> int:\n    \"\"\"Returns the absolute value of an integer.\"\"\"\n    return abs(n)\n\ndef split_digits(n: int) -> list:\n    \"\"\"Splits a non-negative integer into a list of decimal digits (LSB-first).\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    while n > 0:\n        digits.append(n % 10)\n        n //= 10\n    return digits\n\ndef sum_abs_differences(digitsA: list, digitsB: list) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences, padding with zeros for alignment.\"\"\"\n    len_a = len(digitsA)\n    len_b = len(digitsB)\n    max_len = max(len_a, len_b)\n    \n    total_diff = 0\n    for i in range(max_len):\n        digit_a = digitsA[i] if i < len_a else 0\n        digit_b = digitsB[i] if i < len_b else 0\n        total_diff += abs(digit_a - digit_b)\n    return total_diff\n\ndef digit_distance_nums(a, b) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Inputs must be integers; negative numbers are treated as their absolute values.\n    \"\"\"\n    if not is_integer(a) or not is_integer(b):\n        raise TypeError(\"Inputs must be integers\")\n\n    normalized_a = normalize(a)\n    normalized_b = normalize(b)\n\n    digits_a = split_digits(normalized_a)\n    digits_b = split_digits(normalized_b)\n\n    return sum_abs_differences(digits_a, digits_b)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(t1, t2):\n    \"\"\"\n    Finds the union of elements from two tuples, removes duplicates, and returns them in sorted order as a tuple.\n    Assumes input elements are comparable.\n    \"\"\"\n    combined_elements = list(t1) + list(t2)\n    unique_sorted_elements = sorted(set(combined_elements))\n    return tuple(unique_sorted_elements)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_sublists):\n    \"\"\"Compute and return the integer length of the longest sublist.\n\n    Returns 0 if input_sublists is empty.\n    \"\"\"\n    if not input_sublists:\n        return 0\n    return max(len(sublist) for sublist in input_sublists)"}
{"task_id": "Mbpp/559", "solution": "class InputList:\n    \"\"\"A conceptual class to hold list elements.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass Subarray:\n    \"\"\"A conceptual class representing a subarray with its start, end indices, and sum.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, sum: int):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.sum = sum\n\nclass Result:\n    \"\"\"Holds the maximum sum found along with its corresponding start and end indices.\"\"\"\n    def __init__(self, maxSum: int, startIndex: int, endIndex: int):\n        self.maxSum = maxSum\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\nclass MaxSubArrayService:\n    \"\"\"Handles validation and computation for the maximum subarray sum.\"\"\"\n    def max_sub_array_sum(self, data_list: list, size: int) -> int:\n        \"\"\"Validates input, computes the maximum subarray sum for the prefix, and returns it.\"\"\"\n        self.validate_input(data_list, size)\n        result = self.compute_maxsubarray(data_list, size)\n        return result.maxSum\n\n    def validate_input(self, data_list: list, size: int) -> None:\n        \"\"\"Validates that 'size' is an integer and within the valid range [1, len(data_list)].\"\"\"\n        if not isinstance(size, int):\n            raise ValueError(\"size must be an integer.\")\n        if not (1 <= size <= len(data_list)):\n            raise ValueError(f\"size must be between 1 and {len(data_list)} (inclusive).\")\n\n    def compute_maxsubarray(self, data_list: list, size: int) -> Result:\n        \"\"\"Implements Kadane's algorithm to find the maximum contiguous subarray sum within the first 'size' elements, tracking indices.\"\"\"\n        if size == 0:\n            return Result(0, 0, 0) # Should be prevented by validate_input\n\n        max_so_far = data_list[0]\n        current_max = data_list[0]\n        \n        start_index = 0\n        end_index = 0\n        current_start = 0\n\n        for i in range(1, size):\n            if data_list[i] > current_max + data_list[i]:\n                current_max = data_list[i]\n                current_start = i\n            else:\n                current_max += data_list[i]\n            \n            if current_max > max_so_far:\n                max_so_far = current_max\n                start_index = current_start\n                end_index = i\n        \n        return Result(max_so_far, start_index, end_index)\n\ndef max_sub_array_sum(list, size):\n    \"\"\"Public API for finding the sum of the largest contiguous sublist in the given list prefix.\"\"\"\n    service = MaxSubArrayService()\n    return service.max_sub_array_sum(list, size)"}
{"task_id": "Mbpp/563", "solution": "from dataclasses import dataclass\nfrom typing import List, Iterator\n\n@dataclass\nclass InputString:\n    raw: str\n    length: int\n\n@dataclass\nclass QuotedSubstring:\n    text: str\n    start_index: int\n    end_index: int\n\ndef _iter_quoted_substrings(input_string: InputString) -> Iterator[QuotedSubstring]:\n    \"\"\"\n    Scans the raw string for well-formed double-quote pairs and yields QuotedSubstring instances.\n    Unmatched or incomplete quotes are ignored.\n    \"\"\"\n    i = 0\n    while i < input_string.length:\n        start_quote_index = input_string.raw.find('\"', i)\n        if start_quote_index == -1:\n            break  # No more opening quotes\n\n        content_start_index = start_quote_index + 1\n        end_quote_index = input_string.raw.find('\"', content_start_index)\n\n        if end_quote_index == -1:\n            # Unmatched opening quote, advance past it and continue search\n            i = content_start_index\n            continue\n        \n        text = input_string.raw[content_start_index:end_quote_index]\n        yield QuotedSubstring(text=text, start_index=start_quote_index, end_index=end_quote_index)\n        \n        i = end_quote_index + 1 # Continue search after the closing quote\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed within double quotation marks from a given string.\n    Returns an ordered list of the extracted substrings.\n    \"\"\"\n    input_str_obj = InputString(raw=input, length=len(input))\n    return [qs.text for qs in _iter_quoted_substrings(input_str_obj)]"}
{"task_id": "Mbpp/564", "solution": "from dataclasses import dataclass\nfrom typing import List\n\nclass Result:\n    \"\"\"Aggregator for the count during enumeration.\"\"\"\n    def __init__(self) -> None:\n        self._count: int = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the internal count.\"\"\"\n        self._count += 1\n\n    def asInt(self) -> int:\n        \"\"\"Returns the current count as an integer.\"\"\"\n        return self._count\n\n@dataclass\nclass Pair:\n    \"\"\"Value object representing an unordered index pair and their values.\"\"\"\n    i: int\n    j: int\n    value_i: int\n    value_j: int\n\n    def isUnequal(self) -> bool:\n        \"\"\"Checks if the values in the pair are unequal.\"\"\"\n        return self.value_i != self.value_j\n\n@dataclass\nclass Subset:\n    \"\"\"Represents the first n elements chosen from InputList.\"\"\"\n    _values: List[int]\n\n    def __init__(self, values: List[int]):\n        self._values = values\n\n    def get(self, i: int) -> int:\n        \"\"\"Returns the element at the given index.\"\"\"\n        return self._values[i]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the subset.\"\"\"\n        return len(self._values)\n\n@dataclass\nclass InputList:\n    \"\"\"Lightweight wrapper around the provided list.\"\"\"\n    _values: List[int]\n\n    def __init__(self, values: List[int]):\n        self._values = values\n\n    def getSubset(self, n: int) -> 'Subset':\n        \"\"\"Returns a Subset containing the first n elements.\"\"\"\n        return Subset(self._values[:n])\n\ndef count_Pairs(values: List[int], n: int) -> int:\n    \"\"\"Select first n elements, enumerate unordered pairs i<j, count unequal-value pairs, return int.\"\"\"\n    input_list = InputList(values)\n    subset = input_list.getSubset(n)\n\n    if subset.size() < 2:\n        return 0\n\n    result = Result()\n    for i in range(subset.size() - 1):\n        for j in range(i + 1, subset.size()):\n            value_i = subset.get(i)\n            value_j = subset.get(j)\n            pair = Pair(i, j, value_i, value_j)\n            if pair.isUnequal():\n                result.increment()\n\n    return result.asInt()"}
{"task_id": "Mbpp/565", "solution": "from typing import List\n\ndef split(input: str) -> List[str]:\n    \"\"\"\n    Split input into characters and return a list of one-character strings.\n\n    Precondition: 'input' is expected to be a Python str.\n    Postcondition: Returns a list where each element is a single-character str;\n                   order preserved; empty input returns [].\n    \"\"\"\n    return list(input)"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N: int) -> list:\n    \"\"\"Return a list containing N independent empty dictionaries.\"\"\"\n    return [{} for _ in range(N)]"}
{"task_id": "Mbpp/566", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass IntegerInput:\n    \"\"\"Encapsulates an input value for validation.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated value is a non-negative integer.\"\"\"\n        return isinstance(self.value, int) and self.value >= 0\n\nclass SumResult:\n    \"\"\"Represents the computed sum of digits.\"\"\"\n    def __init__(self, total: int):\n        self.total = total\n\ndef _extract_and_sum_digits(n: int) -> int:\n    \"\"\"\n    Helper function to calculate the sum of digits for a non-negative integer.\n    Assumes `n` has already been validated as a non-negative integer and `n > 0`.\n    \"\"\"\n    total_sum = 0\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Raises ValidationError if the input is not a non-negative integer.\n    \"\"\"\n    input_obj = IntegerInput(n)\n    if not input_obj.is_non_negative():\n        raise ValidationError(\"input must be a non-negative integer\")\n\n    if n == 0:\n        return 0\n\n    return _extract_and_sum_digits(n)"}
{"task_id": "Mbpp/572", "solution": "from typing import List\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Returns a list of numbers from the input list that appear exactly once.\n    The relative order of the unique elements is preserved as in the original list.\n    \"\"\"\n    counts = {}\n    for num in input_list:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in input_list:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/567", "solution": "def _check_adjacent(a, b) -> bool:\n    \"\"\"Return True if a <= b using Python standard ordering operators; else False.\"\"\"\n    return a <= b\n\ndef issort_list(list) -> bool:\n    \"\"\"Return True if `list` is sorted in non-decreasing order, else False.\n    Does not modify the input list. Raises TypeError if elements are not comparable.\n    \"\"\"\n    if len(list) <= 1:\n        return True\n\n    for i in range(len(list) - 1):\n        if not _check_adjacent(list[i], list[i+1]):\n            return False\n    return True"}
{"task_id": "Mbpp/569", "solution": "from typing import List, Any\n\nclass SortSublistsFunction:\n    \"\"\"Implements validation and execution for sorting sublists per SRS.\"\"\"\n\n    def execute(self, input_list: List[List[str]]) -> List[List[str]]:\n        \"\"\"Validate input_list and return a new List[List[str]] where each sublist is sorted lexicographically.\n        Raises: TypeError if validation fails (outer not list, sub-element not list, or non-string item found).\n        \"\"\"\n        self.validateInput(input_list)\n        \n        new_list = []\n        for sublist in input_list:\n            # Create a shallow copy of the sublist to avoid mutating input.\n            copy_of_sublist = list(sublist)\n            # Sort the copy lexicographically and append to the new outer list.\n            sorted_sublist = sorted(copy_of_sublist)\n            new_list.append(sorted_sublist)\n        \n        return new_list\n\n    def validateInput(self, input_obj: Any) -> None:\n        \"\"\"Validate input_obj is a list of lists of strings; raise TypeError on failure.\"\"\"\n        if not isinstance(input_obj, list):\n            raise TypeError(\"Input must be a list.\")\n        \n        for i, sublist in enumerate(input_obj):\n            if not isinstance(sublist, list):\n                raise TypeError(f\"Element at index {i} must be a list, but got {type(sublist).__name__}.\")\n            for j, item in enumerate(sublist):\n                if not isinstance(item, str):\n                    raise TypeError(f\"Item at sublist index {i}, item index {j} must be a string, but got {type(item).__name__}.\")\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"Public API: delegates to SortSublistsFunction.execute and returns sorted copy.\"\"\"\n    executor = SortSublistsFunction()\n    return executor.execute(input_list)"}
{"task_id": "Mbpp/573", "solution": "from typing import List, Set, Union\n\nclass NumberList:\n    \"\"\"Wraps the input list and provides an operation to derive UniqueNumbers.\"\"\"\n    def __init__(self, numbers: list) -> None:\n        self.numbers = numbers\n\n    def get_unique(self) -> 'UniqueNumbers':\n        \"\"\"Extracts unique numbers and returns them as a UniqueNumbers object.\"\"\"\n        unique_values = set(self.numbers)\n        return UniqueNumbers(unique_values)\n\nclass UniqueNumbers:\n    \"\"\"Holds a set of distinct numeric values.\"\"\"\n    def __init__(self, values: set) -> None:\n        self.values = values\n\n    def to_list(self) -> list:\n        \"\"\"Converts the set of unique values to a list.\"\"\"\n        return list(self.values)\n\nclass ProductResult:\n    \"\"\"Encapsulates the numeric product result.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n\nclass ProductCalculator:\n    \"\"\"Computes the product of the values in a UniqueNumbers instance.\"\"\"\n    def compute(self, u: 'UniqueNumbers') -> ProductResult:\n        \"\"\"Calculates the product of all unique numbers.\"\"\"\n        product = 1\n        for num in u.values:\n            product *= num\n        return ProductResult(product)\n\ndef unique_product(list_of_numbers: list) -> Union[int, float]:\n    \"\"\"\n    Accepts a list of numbers and returns the product of its unique numbers.\n    Utilizes domain classes to process the list and calculate the product.\n    \"\"\"\n    nl = NumberList(list_of_numbers)\n    uniq = nl.get_unique()\n    calc = ProductCalculator()\n    result = calc.compute(uniq)\n    return result.value"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Accepts three lists of equal length and returns a single interleaved flat list.\n\n    Raises:\n        ValueError: if the input lists do not all have equal length.\n    \"\"\"\n    len1 = len(list1)\n    if len1 != len(list2) or len1 != len(list3):\n        raise ValueError(\"All input lists must have equal length.\")\n\n    result = []\n    for i in range(len1):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/583", "solution": "def compute_binomial_iterative(N_val, K_val):\n    \"\"\"Computes the binomial coefficient C(N_val, K_val) efficiently.\n    Uses an iterative multiplicative approach to avoid large factorials.\n    \"\"\"\n    if K_val < 0 or K_val > N_val:\n        return 0\n    if K_val == 0 or K_val == N_val:\n        return 1\n    # Optimization: C(N, K) = C(N, N - K)\n    if K_val > N_val // 2:\n        K_val = N_val - K_val\n\n    res = 1\n    for i in range(1, K_val + 1):\n        res = res * (N_val - K_val + i) // i\n    return res\n\ndef compute_catalan(n_param):\n    \"\"\"Computes the nth Catalan number using the formula C(2n, n) // (n + 1).\"\"\"\n    # Calculates C(2*n_param, n_param) first using the helper function.\n    binomial_coeff = compute_binomial_iterative(2 * n_param, n_param)\n    return binomial_coeff // (n_param + 1)\n\ndef catalan_number(n):\n    \"\"\"\n    Returns the nth Catalan number.\n    Assumes n is a non-negative integer based on problem constraints.\n    \"\"\"\n    # The design specifies validation, but the overarching constraint \"DO NOT add\n    # isinstance() checks or raise exceptions for edge cases\" means we proceed\n    # directly to computation, assuming valid input `n`.\n    return compute_catalan(n)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset, n):\n    \"\"\"\n    Finds the n most expensive items in a dataset, sorted by price in descending order.\n    The dataset is a list of dictionaries, each containing a numeric 'price' field.\n    \"\"\"\n\n    def _validate_price_fields(data):\n        \"\"\"Validates that each item in the dataset has a numeric 'price' field.\"\"\"\n        for item in data:\n            if 'price' not in item:\n                raise ValueError(\"Item is missing 'price' field.\")\n            if not isinstance(item['price'], (int, float)):\n                raise ValueError(f\"Price for item '{item.get('name', 'unknown')}' is not numeric.\")\n\n    def _select_and_sort_top_n(data, count):\n        \"\"\"Selects the top 'count' items by price, sorted in descending order.\"\"\"\n        # Sort the dataset by 'price' in descending order while preserving item structure.\n        sorted_items = sorted(data, key=lambda item: item['price'], reverse=True)\n        # Return the top 'count' items.\n        return sorted_items[:count]\n\n    _validate_price_fields(dataset)\n    return _select_and_sort_top_n(dataset, n)"}
{"task_id": "Mbpp/580", "solution": "def _is_even(n: int) -> bool:\n    \"\"\"Checks if an integer is an even number.\"\"\"\n    return n % 2 == 0\n\ndef _process_tuple(input_tuple: tuple) -> tuple:\n    \"\"\"Recursively processes a tuple, filtering out odd integers.\"\"\"\n    result_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if _is_even(element):\n                result_elements.append(element)\n        elif isinstance(element, tuple):\n            processed_nested_tuple = _process_tuple(element)\n            if processed_nested_tuple:\n                result_elements.append(processed_nested_tuple)\n    return tuple(result_elements)\n\ndef extract_even(input: tuple) -> tuple:\n    \"\"\"\n    Removes odd integers from a nested tuple, preserving the original structure and relative order.\n    \"\"\"\n    return _process_tuple(input)"}
{"task_id": "Mbpp/576", "solution": "def _validate_inputs(container, candidate) -> None:\n    \"\"\"Validate that both inputs are lists, raising TypeError otherwise.\"\"\"\n    if not isinstance(container, list) or not isinstance(candidate, list):\n        raise TypeError(\"container and candidate must be lists\")\n\ndef _scan_for_contiguous_match(container: list, candidate: list) -> bool:\n    \"\"\"\n    Scans the container for a contiguous match of the candidate sublist.\n    Assumes candidate is not empty and not longer than container.\n    \"\"\"\n    for start in range(len(container) - len(candidate) + 1):\n        if container[start : start + len(candidate)] == candidate:\n            return True\n    return False\n\ndef is_Sub_Array(container: list, candidate: list) -> bool:\n    \"\"\"\n    Checks if a list is a contiguous sublist of another list.\n    Performs type validation and handles edge cases for empty or longer candidate lists.\n    \"\"\"\n    _validate_inputs(container, candidate)\n\n    if not candidate:\n        return True\n\n    if len(candidate) > len(container):\n        return False\n\n    return _scan_for_contiguous_match(container, candidate)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"Compute ordered symmetric difference using equality-only checks and return a tuple.\n    Elements unique to t1 come first, then elements unique to t2, all deduplicated.\"\"\"\n    result = []\n    seen = []\n\n    # Process elements from t1\n    for e1 in t1:\n        # Check if e1 is present in t2 using equality comparison\n        e1_in_t2 = False\n        for x2 in t2:\n            if e1 == x2:\n                e1_in_t2 = True\n                break\n\n        # Check if e1 has already been added to result/seen (for deduplication)\n        e1_in_seen = False\n        for s_item in seen:\n            if e1 == s_item:\n                e1_in_seen = True\n                break\n\n        # If e1 is unique to t1 and not already in our result, add it\n        if not e1_in_t2 and not e1_in_seen:\n            result.append(e1)\n            seen.append(e1)\n\n    # Process elements from t2\n    for e2 in t2:\n        # Check if e2 is present in t1 using equality comparison\n        e2_in_t1 = False\n        for x1 in t1:\n            if e2 == x1:\n                e2_in_t1 = True\n                break\n\n        # Check if e2 has already been added to result/seen (for deduplication)\n        e2_in_seen = False\n        for s_item in seen:\n            if e2 == s_item:\n                e2_in_seen = True\n                break\n        \n        # If e2 is unique to t2 and not already in our result, add it\n        if not e2_in_t1 and not e2_in_seen:\n            result.append(e2)\n            seen.append(e2)\n\n    return tuple(result)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit in factorial of a given non-negative integer.\n    Raises ValueError for invalid inputs (non-integer or negative).\n    \"\"\"\n\n    def is_valid(num: int) -> bool:\n        \"\"\"Checks if the input is a non-negative integer.\"\"\"\n        return isinstance(num, int) and num >= 0\n\n    def raise_error(message: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(message)\n\n    def compute_factorial(num: int) -> int:\n        \"\"\"Computes the exact factorial for small non-negative numbers.\"\"\"\n        if num == 0:\n            return 1\n        res = 1\n        for i in range(1, num + 1):\n            res *= i\n        return res\n\n    def compute_last_digit(num: int) -> int:\n        \"\"\"Determines the last decimal digit of factorial, using optimization for n >= 5.\"\"\"\n        if num >= 5:\n            return 0\n        return compute_factorial(num) % 10\n\n    if not is_valid(n):\n        raise_error(\"n must be a non-negative integer\")\n\n    return compute_last_digit(n)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    The 'height' parameter is treated as the slant height of the pyramid.\n    \"\"\"\n    def compute_base_area(base_edge):\n        \"\"\"Calculates the area of the square base.\"\"\"\n        return base_edge ** 2\n\n    def compute_lateral_area(base_edge, height):\n        \"\"\"Calculates the lateral surface area using slant height.\"\"\"\n        return 2 * base_edge * height\n\n    base_area = compute_base_area(base_edge)\n    lateral_area = compute_lateral_area(base_edge, height)\n    return base_area + lateral_area"}
