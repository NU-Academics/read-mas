{"task_id": "Mbpp/128", "solution": "def validate_inputs(n, text) -> None:\n    \"\"\"Validate that n is int and text is str. Raises TypeError on failure.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string.\")\n\ndef split_text(text: str) -> list:\n    \"\"\"Split text on whitespace using str.split() and return list of tokens.\"\"\"\n    return text.split()\n\ndef filter_words(n: int, words: list) -> list:\n    \"\"\"Return list of words from 'words' whose length is strictly greater than n, preserving order.\"\"\"\n    return [word for word in words if len(word) > n]\n\ndef long_words(n, text) -> list:\n    \"\"\"Public API: validate inputs, split text, filter tokens, and return list of words with len > n.\n    Raises TypeError for invalid types.\n    \"\"\"\n    validate_inputs(n, text)\n    words_list = split_text(text)\n    return filter_words(n, words_list)"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Encapsulates matrix data and provides helpers for squareness and sum computations.\"\"\"\n    def __init__(self, data: list):\n        self.data = data\n        self.n = len(data)\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square (n x n).\"\"\"\n        if self.n == 0:\n            return False\n        for row in self.data:\n            if len(row) != self.n:\n                return False\n        return True\n\n    def row_sum(self, i: int) -> int:\n        \"\"\"Calculates the sum of the i-th row.\"\"\"\n        return sum(self.data[i])\n\n    def col_sum(self, j: int) -> int:\n        \"\"\"Calculates the sum of the j-th column.\"\"\"\n        return sum(self.data[row_idx][j] for row_idx in range(self.n))\n\n    def diag_sum(self, main: bool) -> int:\n        \"\"\"Calculates the sum of a main or anti-diagonal.\"\"\"\n        if main:\n            return sum(self.data[i][i] for i in range(self.n))\n        else: # Anti-diagonal\n            return sum(self.data[i][self.n - 1 - i] for i in range(self.n))\n\nclass MagicSquareTester:\n    \"\"\"Orchestrates validation, sum computation, and comparison for magic squares.\"\"\"\n    def magic_square_test(self, matrix: list) -> bool:\n        \"\"\"Tests if the given matrix is a magic square.\"\"\"\n        if not self.validate_square(matrix):\n            return False\n        \n        sums = self.compute_all_sums(matrix)\n        return self.compare_sums(sums)\n\n    def validate_square(self, matrix: list) -> bool:\n        \"\"\"Validates if the input is a non-empty square matrix.\"\"\"\n        matrix_obj = Matrix(matrix)\n        # A magic square must be a square matrix and have a size n >= 1.\n        return matrix_obj.n > 0 and matrix_obj.is_square()\n\n    def compute_all_sums(self, matrix: list) -> list:\n        \"\"\"Computes all row, column, and diagonal sums of the matrix.\"\"\"\n        matrix_obj = Matrix(matrix)\n        n = matrix_obj.n\n        \n        all_sums = []\n        \n        # Row sums\n        for i in range(n):\n            all_sums.append(matrix_obj.row_sum(i))\n            \n        # Column sums\n        for j in range(n):\n            all_sums.append(matrix_obj.col_sum(j))\n            \n        # Main diagonal sum\n        all_sums.append(matrix_obj.diag_sum(True))\n        \n        # Secondary diagonal sum\n        all_sums.append(matrix_obj.diag_sum(False))\n        \n        return all_sums\n\n    def compare_sums(self, sums: list) -> bool:\n        \"\"\"Compares a list of sums to check if all are equal.\"\"\"\n        # If there are no sums, it cannot be a magic square.\n        if not sums:\n            return False\n        # All sums must be equal, so the set of sums should contain only one unique value.\n        return len(set(sums)) == 1\n\ndef magic_square_test(matrix: list) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square is a square matrix where the sum of the numbers in each row,\n    each column, and both main diagonals is the same.\n    \"\"\"\n    tester = MagicSquareTester()\n    return tester.magic_square_test(matrix)"}
{"task_id": "Mbpp/130", "solution": "class FrequencyMap:\n    \"\"\"\n    A helper class to count item frequencies and track their first appearance\n    for deterministic tie-breaking.\n    \"\"\"\n    def __init__(self):\n        self._map = {}  # Stores item -> count\n        self._first_seen = []  # Stores items in order of their first appearance\n\n    def increment(self, item):\n        \"\"\"Increments the count for an item, recording it if seen for the first time.\"\"\"\n        if item not in self._map:\n            self._first_seen.append(item)\n            self._map[item] = 0\n        self._map[item] += 1\n\n    def get_max(self):\n        \"\"\"\n        Returns the item with the maximum frequency.\n        In case of a tie, the item that was first encountered is returned.\n        Returns None if no items have been recorded.\n        \"\"\"\n        if not self._map:\n            return None\n\n        max_frequency = 0\n        for count in self._map.values():\n            if count > max_frequency:\n                max_frequency = count\n        \n        # Iterate through items in their first-seen order to apply tie-breaking\n        for item in self._first_seen:\n            if self._map[item] == max_frequency:\n                return item\n        return None # Should not be reached if _map is not empty\n\ndef max_occurrences(items: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n\n    Raises TypeError if the input is not a list.\n    Returns None if the list is empty.\n    In case of a tie, the item first encountered (left-to-right) that reached\n    the maximum frequency is returned.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list\")\n\n    if not items:\n        return None\n\n    freq_map = FrequencyMap()\n    for item in items:\n        freq_map.increment(item)\n\n    return freq_map.get_max()"}
{"task_id": "Mbpp/132", "solution": "def tup_string(input_tuple: tuple) -> str:\n    \"\"\"Converts a tuple of characters into a single string by concatenating its elements.\"\"\"\n    return \"\".join(input_tuple)"}
{"task_id": "Mbpp/131", "solution": "VOWEL_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Return a new string with vowels reversed while preserving non-vowel positions.\"\"\"\n    if not s:\n        return \"\"\n\n    vowel_indices = []\n    vowels_found = []\n    for i, char in enumerate(s):\n        if char in VOWEL_SET:\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    if len(vowels_found) <= 1:\n        return s\n\n    # Reverse the collected vowels\n    reversed_vowels = vowels_found[::-1]\n\n    # Build a list of characters from s for mutable operations\n    s_list = list(s)\n\n    # Replace original vowel positions with reversed vowels\n    for i in range(len(vowel_indices)):\n        s_list[vowel_indices[i]] = reversed_vowels[i]\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/133", "solution": "import numbers\nfrom typing import List\n\nclass NumberList:\n    \"\"\"Encapsulates the input list, validation, and extraction of negative numbers.\"\"\"\n    def __init__(self, numbers: List[numbers.Number]):\n        self.numbers = numbers\n\n    def validate(self) -> bool:\n        \"\"\"Verifies each element is an int or float.\"\"\"\n        for num in self.numbers:\n            if not isinstance(num, (int, float)):\n                return False\n        return True\n\n    def getNegativeNumbers(self) -> List[numbers.Number]:\n        \"\"\"Returns elements with value < 0.\"\"\"\n        return [num for num in self.numbers if num < 0]\n\nclass NegativeNumber:\n    \"\"\"Value object for a strictly negative numeric value.\"\"\"\n    def __init__(self, value: numbers.Number):\n        self.value = value\n\nclass SumResult:\n    \"\"\"Value object encapsulating numeric sum result.\"\"\"\n    def __init__(self, value: numbers.Number):\n        self.value = value\n\nclass SumNegativeNumFunction:\n    \"\"\"Orchestrates validation, filtering, summation and produces SumResult.\"\"\"\n    def execute(self, number_list: NumberList) -> SumResult:\n        \"\"\"Validates, filters negatives, computes sum, and returns SumResult.\"\"\"\n        if not number_list.validate():\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n        \n        negative_nums = number_list.getNegativeNumbers()\n        total_sum = sum(negative_nums)\n        return SumResult(total_sum)\n\ndef sum_negativenum(list_of_numbers: List[numbers.Number]) -> numbers.Number:\n    \"\"\"Calculates the sum of the negative numbers in a given list.\"\"\"\n    number_list_obj = NumberList(numbers=list_of_numbers)\n    sum_function = SumNegativeNumFunction()\n    result_obj = sum_function.execute(number_list_obj)\n    return result_obj.value"}
{"task_id": "Mbpp/137", "solution": "from typing import List\n\ndef zero_count(input_list: List[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in a list of integers.\n    Returns float(count of zeros) / float(count of non-zeroes).\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n    for element in input_list:\n        if element == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n    return float(zeroes) / float(non_zeroes)"}
{"task_id": "Mbpp/135", "solution": "from typing import TypeAlias\n\nclass InputValidator:\n    \"\"\"Validates input parameter n to ensure it is an integer and n >= 1.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"Raises ValueError if n is not an integer or is less than 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n\nclass HexagonalNumber:\n    \"\"\"Represents a hexagonal number and computes its value.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n        self.value: int = 0 # Initialized here, computed later\n\n    def compute(self) -> int:\n        \"\"\"Computes and returns the nth hexagonal number using the formula n * (2 * n - 1).\"\"\"\n        self.value = self.n * (2 * self.n - 1)\n        return self.value\n\nclass HexagonalEngine:\n    \"\"\"Orchestrates validation and computation of hexagonal numbers.\"\"\"\n    def hexagonal_num(self, n: int) -> int:\n        \"\"\"Instantiates HexagonalNumber and computes its value.\"\"\"\n        hn = HexagonalNumber(n)\n        return hn.compute()\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth hexagonal number.\n    Validates input 'n' and delegates computation to an internal engine.\n    \"\"\"\n    InputValidator().validate(n)\n    return HexagonalEngine().hexagonal_num(n)"}
{"task_id": "Mbpp/138", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputNumber:\n    value: int\n    def isValid(self) -> bool:\n        return isinstance(self.value, int)\n\n@dataclass\nclass PowerOfTwo:\n    exponent: int\n    def value(self) -> int:\n        return 2 ** self.exponent\n\n@dataclass\nclass SumRepresentation:\n    terms: List[PowerOfTwo]\n    def evaluate(self) -> int:\n        return sum(term.value() for term in self.terms)\n    def isValidRepresentation(self, target: int) -> bool:\n        return self.evaluate() == target\n\n@dataclass\nclass FunctionResult:\n    result: bool\n\ndef is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if a given number can be represented as a sum of non-zero powers of 2.\n    Uses binary decomposition to construct and validate the representation.\n    \"\"\"\n    input_num = InputNumber(n)\n    if not input_num.isValid():\n        raise TypeError(\"Input must be an integer.\")\n\n    if n <= 0:\n        return False\n\n    terms_list: List[PowerOfTwo] = []\n    temp_n = n\n    exponent = 0\n    while temp_n > 0:\n        if (temp_n & 1) == 1:\n            terms_list.append(PowerOfTwo(exponent))\n        temp_n >>= 1\n        exponent += 1\n\n    sum_representation = SumRepresentation(terms_list)\n    return sum_representation.isValidRepresentation(n)"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Set, Any\n\ndef extract_singly(iterable_of_iterables: Iterable[Iterable[Any]]) -> Set[Any]:\n    \"\"\"Accept an iterable of iterables and return a set of numbers.\n\n    Flattens inner iterables and deduplicates elements into a single set.\n    \"\"\"\n    result = set()\n    for inner in iterable_of_iterables:\n        for item in inner:\n            result.add(item)\n    return result"}
{"task_id": "Mbpp/139", "solution": "import math\nfrom typing import Any\n\nclass MathConstants:\n    \"\"\"Holds mathematical constants like PI.\"\"\"\n    PI: float = math.pi\n\nclass Circle:\n    \"\"\"A data holder for circle properties.\"\"\"\n    def __init__(self, radius: float, circumference: float) -> None:\n        self.radius = radius\n        self.circumference = circumference\n\nclass CircleService:\n    \"\"\"Provides circle-related computations and input validation.\"\"\"\n\n    @staticmethod\n    def _validate_radius(radius: Any) -> None:\n        \"\"\"Validates the radius input for type and value, raising errors if invalid.\"\"\"\n        if not isinstance(radius, (int, float)):\n            raise TypeError(\"Radius must be a numeric value.\")\n        if radius < 0:\n            raise ValueError(\"Radius cannot be negative.\")\n\n    @staticmethod\n    def circle_circumference(radius: Any) -> float:\n        \"\"\"\n        Computes the circumference of a circle after validating the radius.\n        Delegates to _validate_radius for input checks.\n        \"\"\"\n        CircleService._validate_radius(radius)\n        r_float = float(radius)\n        circumference = 2 * MathConstants.PI * r_float\n        return circumference\n\ndef circle_circumference(radius):\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Delegates to CircleService for validation and computation.\n    \"\"\"\n    return CircleService.circle_circumference(radius)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence):\n    \"\"\"Compute the maximum absolute difference between any numeric elements in sequence.\n    Raises ValueError if the sequence contains fewer than 2 elements.\n    \"\"\"\n    if len(sequence) < 2:\n        raise ValueError(\"Input sequence must contain at least 2 elements.\")\n\n    min_val = min(sequence)\n    max_val = max(sequence)\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/142", "solution": "from typing import List, Any\n\ndef count_samepair(list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position across three lists.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "class InputList:\n    \"\"\"Thin wrapper for input list for traceability.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\nclass SortedList:\n    \"\"\"Thin wrapper for sorted output list.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\nclass FlipOperation:\n    \"\"\"Models a prefix reversal operation and applies it to a list.\"\"\"\n    def __init__(self, k: int):\n        self.k = k\n\n    def apply(self, target_list: list) -> None:\n        \"\"\"Reverses the first k elements of the target_list in-place.\"\"\"\n        target_list[:self.k] = target_list[:self.k][::-1]\n\nclass PancakeSorter:\n    \"\"\"Encapsulates the pancake sorting algorithm and issues flip operations.\"\"\"\n    def pancake_sort(self, elements: list) -> list:\n        \"\"\"Sorts a list in ascending order using only prefix reversals.\"\"\"\n        working_list = list(elements)\n        n = len(working_list)\n\n        # Iterate from the last unsorted element down to the second\n        for current_size in range(n, 1, -1):\n            # Find the index of the maximum element in the current sublist (0 to current_size-1)\n            max_index = self._find_max_index(working_list, current_size)\n\n            # If the maximum element is not already in its correct sorted position\n            if max_index != current_size - 1:\n                # 1. Bring the maximum element to the front (if it's not already there)\n                if max_index != 0:\n                    self._flip(working_list, max_index + 1)\n                \n                # 2. Bring the maximum element to its correct final position\n                self._flip(working_list, current_size)\n        \n        return working_list\n\n    def _find_max_index(self, target_list: list, n: int) -> int:\n        \"\"\"Returns the index of the maximum element among the first n elements.\"\"\"\n        max_val = target_list[0]\n        max_idx = 0\n        for i in range(1, n):\n            if target_list[i] > max_val:\n                max_val = target_list[i]\n                max_idx = i\n        return max_idx\n\n    def _flip(self, target_list: list, k: int) -> None:\n        \"\"\"Performs an in-place prefix reversal on the first k elements using FlipOperation.\"\"\"\n        flip_op = FlipOperation(k)\n        flip_op.apply(target_list)\n\ndef pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sorting algorithm.\n    All reordering is implemented using only prefix reversals.\n    \"\"\"\n    n = len(input_list)\n\n    # Handle edge cases for empty or single-element lists.\n    if n <= 1:\n        # Return a shallow copy for consistency with the main algorithm returning a new list.\n        return list(input_list)\n\n    sorter = PancakeSorter()\n    return sorter.pancake_sort(input_list)"}
{"task_id": "Mbpp/161", "solution": "from typing import Any, List\n\ndef remove_elements(source_list: List[Any], removal_list: List[Any]) -> List[Any]:\n    \"\"\"Return a new list containing only elements from source_list that are not present in removal_list.\n\n    A new list is returned (original source_list is not mutated by contract).\n    \"\"\"\n    removal_set = set(removal_list)\n    result_list = []\n    for item in source_list:\n        if item not in removal_set:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    For example, for n=6, the series is 6 + 4 + 2 + 0 = 12.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        total_sum += (n - 2 * i)\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "class GCDCalculator:\n    \"\"\"Calculates GCD and extended GCD (Bezout coefficients).\"\"\"\n\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    @staticmethod\n    def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Computes Bezout coefficients x, y and gcd g such that a*x + b*y = g.\n        Returns (x, y, g) where g = gcd(|a|, |b|) is always positive.\n        \"\"\"\n        if a == 0:\n            return 0, (1 if b >= 0 else -1), abs(b)\n        \n        x1, y1, g = GCDCalculator.extended_gcd(b % a, a)\n        x = y1 - (b // a) * x1\n        y = x1\n        return x, y, g\n\n\ndef find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    # Special-case handling (BR-6):\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        else:\n            return None\n    elif a == 0: # and b != 0\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    elif b == 0: # and a != 0\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n    else: # a != 0 and b != 0\n        x0_bezout, y0_bezout, g = GCDCalculator.extended_gcd(a, b)\n        \n        if n % g != 0:\n            return None\n        else:\n            # Scale Bezout coefficients to find a particular solution for ax + by = n\n            factor = n // g\n            x_particular = x0_bezout * factor\n            # y_particular = y0_bezout * factor # Not directly used after adjustment\n\n            # Adjust the particular solution to ensure a deterministic choice (e.g., smallest non-negative x).\n            # This step aligns with the unit test example assert find_solution(2, 3, 7) == (2, 1).\n            step_x = b // g\n            \n            # Use modulo to find x_final in the range [0, |step_x|-1] (if step_x is non-zero).\n            # The result of Python's % operator matches the sign of the divisor.\n            # We want a positive remainder, so we apply the common correction.\n            x_final = (x_particular % abs(step_x) + abs(step_x)) % abs(step_x)\n            \n            # Recalculate y using the Diophantine equation with the adjusted x_final.\n            y_final = (n - a * x_final) // b\n\n            return (x_final, y_final)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    A pair (a, b) XORs to an even number if both a and b are even, or both are odd.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:  # Check if the number is even\n            even_count += 1\n        else:  # The number is odd\n            odd_count += 1\n\n    # Calculate combinations for pairs of even numbers: C(n, 2) = n * (n - 1) // 2\n    pairs_from_evens = even_count * (even_count - 1) // 2\n    \n    # Calculate combinations for pairs of odd numbers: C(n, 2) = n * (n - 1) // 2\n    pairs_from_odds = odd_count * (odd_count - 1) // 2\n\n    # The total number of pairs that XOR to an even number is the sum of these combinations\n    return pairs_from_evens + pairs_from_odds"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match the English alphabet letter at the same 1-based position (case insensitive).\n    Positions greater than 26 are considered non-matching.\n    \"\"\"\n    count = 0\n    # Iterate up to 26 positions (1-based), as positions beyond 26 are defined as non-matching.\n    # The loop runs for min(length of string, 26) iterations.\n    for i in range(min(len(s), 26)):\n        current_char = s[i]\n        position_1_based = i + 1\n\n        # Convert the current character to lowercase to ensure case-insensitivity.\n        # This also acts as an implicit check for ASCII alphabetic characters, as non-ASCII or non-alphabetic\n        # characters (like digits or symbols) will not fall within 'a' through 'z'.\n        lower_char = current_char.lower()\n\n        # Check if the character is an ASCII alphabetic letter (a-z).\n        if 'a' <= lower_char <= 'z':\n            # Determine the expected English alphabet character for the current 1-based position.\n            # 'a' corresponds to position 1, 'b' to 2, and so on.\n            expected_char = chr(ord('a') + position_1_based - 1)\n\n            # If the lowercase character matches the expected alphabet character, increment the count.\n            if lower_char == expected_char:\n                count += 1\n    return count"}
{"task_id": "Mbpp/168", "solution": "from typing import List, Any\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    \"\"\"Lightweight wrapper for the input list.\"\"\"\n    elements: List[Any]\n\n@dataclass\nclass ListElement:\n    \"\"\"Represents an individual element from the list.\"\"\"\n    value: Any\n\n@dataclass\nclass TargetNumber:\n    \"\"\"Represents the target value to count.\"\"\"\n    value: Any\n\n@dataclass\nclass OccurrenceCount:\n    \"\"\"Represents the integer result count.\"\"\"\n    count: int\n\nclass FrequencyFunction:\n    \"\"\"\n    Encapsulates the algorithm to count occurrences of a number in a list.\n    Uses host-language value equality (==) for comparisons.\n    \"\"\"\n    def frequency(self, list: List[Any], number: Any) -> int:\n        \"\"\"\n        Counts occurrences of a target number in a list.\n        Returns 0 if the list is empty or the number is not found.\n        \"\"\"\n        count = 0\n        for element in list:\n            if element == number: # Host-language value equality semantics.\n                count += 1\n        return count\n\ndef frequency(list: List[Any], number: Any) -> int:\n    \"\"\"\n    Counts the number of occurrences of a number in a given list.\n    Delegates to FrequencyFunction for the core counting logic.\n    \"\"\"\n    return FrequencyFunction().frequency(list, number)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n    # Check if n is already a power of two using a bitwise trick for n > 0.\n    if (n & (n - 1) == 0):\n        return n\n    # For n > 0 and not a power of two, find the next power of two.\n    # n.bit_length() gives the number of bits required to represent n.\n    # 1 << n.bit_length() gives the smallest power of 2 strictly greater than n.\n    return 1 << n.bit_length()"}
{"task_id": "Mbpp/170", "solution": "def _validate_inputs(lst, start, end):\n    \"\"\"\n    Validates the input list and indices according to design specifications, raising exceptions on failure.\n    Ensures lst is a list, indices are valid integers within bounds, start <= end, and all list elements are numeric.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise ValueError(\"lst must be a list\")\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise ValueError(\"start and end must be integers\")\n    \n    # Handle empty list specifically for index bounds checks\n    if not lst:\n        if start != 0 or end != -1: # or other conditions that would make sense for an empty list, but based on the index checks, any positive start/end would fail.\n            # The general index check below will catch this: start >= len(lst) becomes start >= 0\n            pass \n\n    if start < 0 or end < 0 or start >= len(lst) or end >= len(lst):\n        # This covers cases where len(lst) is 0 and start/end are 0 or positive,\n        # as well as out-of-bounds for non-empty lists.\n        raise IndexError(\"start and/or end index out of range; negative indices are treated as invalid\")\n    \n    if start > end:\n        raise ValueError(\"start must be <= end\")\n\n    for v in lst:\n        if not isinstance(v, (int, float)):\n            raise ValueError(\"all elements of lst must be numeric\")\n    \n    return None\n\ndef sum_range_list(lst, start, end):\n    \"\"\"\n    Calculates the sum of numeric elements in a list within a specified index range [start, end] inclusive.\n    Performs input validation and ensures O(1) additional memory and O(k) time complexity.\n    \"\"\"\n    _validate_inputs(lst, start, end)\n\n    accumulator = 0\n    for i in range(start, end + 1):\n        accumulator += lst[i]\n    return accumulator"}
{"task_id": "Mbpp/172", "solution": "class InputString:\n    \"\"\"Container for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass OccurrenceResult:\n    \"\"\"Container for the returned count.\"\"\"\n    def __init__(self, occurrences: int):\n        self.occurrences = occurrences\n\nclass CountOccuranceFunction:\n    \"\"\"Encapsulates counting algorithm for 'std' with non-overlapping scanning.\"\"\"\n    name: str = \"count_occurance\"\n    pattern: str = \"std\"\n\n    def count(self, input_string: str) -> int:\n        \"\"\"Scans the input string for non-overlapping occurrences of 'std'.\"\"\"\n        count = 0\n        index = 0\n        pattern_len = len(self.pattern)\n        input_len = len(input_string)\n\n        while index < input_len:\n            found_index = input_string.find(self.pattern, index)\n            if found_index != -1:\n                count += 1\n                index = found_index + pattern_len\n            else:\n                break\n        return count\n\ndef count_occurance(input: str) -> int:\n    \"\"\"\n    Counts the number of non-overlapping occurrences of 'std' in a given string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\n    # Per design, InputString and OccurrenceResult are for traceability,\n    # but the core logic delegates to CountOccuranceFunction directly\n    # and returns a raw int.\n    # input_obj = InputString(input) # Example of traceability object creation\n\n    counter = CountOccuranceFunction()\n    occurrences = counter.count(input)\n\n    # result_obj = OccurrenceResult(occurrences) # Example of traceability object creation\n\n    return occurrences"}
{"task_id": "Mbpp/171", "solution": "class NumericInput:\n    \"\"\"Provides validation for numeric inputs (int or float).\"\"\"\n    def validate_numeric(self, value) -> bool:\n        \"\"\"Returns True if the value is an integer or float, False otherwise.\"\"\"\n        return isinstance(value, (int, float))\n\nclass Pentagon:\n    \"\"\"Represents a regular pentagon and computes its perimeter.\"\"\"\n    def __init__(self, side_length: float):\n        self.side_length = float(side_length)\n    def perimeter(self) -> float:\n        \"\"\"Calculates and returns the perimeter of the pentagon.\"\"\"\n        return 5 * self.side_length\n\nclass PerimeterCalculator:\n    \"\"\"Coordinates input validation and perimeter computation for a pentagon.\"\"\"\n    def __init__(self):\n        self.validator = NumericInput()\n    def perimeter_pentagon(self, side_length):\n        \"\"\"Validates input and computes the perimeter using the Pentagon class.\"\"\"\n        # As per design, validation occurs, but error response is unspecified for this context,\n        # and explicit exception raising is forbidden for the final function output.\n        self.validator.validate_numeric(side_length)\n        pentagon = Pentagon(side_length)\n        return pentagon.perimeter()\n\ndef perimeter_pentagon(side_length):\n    \"\"\"\n    Calculates the perimeter of a regular pentagon from its side length.\n    Delegates the computation to an internal PerimeterCalculator.\n    \"\"\"\n    return PerimeterCalculator().perimeter_pentagon(side_length)"}
{"task_id": "Mbpp/222", "solution": "def check_type(input_tuple):\n    \"\"\"\n    Checks if all elements in the given tuple have the same data type.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if not input_tuple:  # Empty tuple case\n        return True\n\n    # Get the type of the first element\n    first_type = type(input_tuple[0])\n\n    # Iterate through the rest of the elements and compare their types\n    for element in input_tuple[1:]:\n        if type(element) is not first_type:\n            return False\n\n    return True"}
