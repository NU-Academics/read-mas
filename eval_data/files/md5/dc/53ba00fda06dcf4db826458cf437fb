{"task_id": "Mbpp/805", "solution": "def _sum_list(inner_list):\n    \"\"\"Returns arithmetic sum of inner_list elements (returns 0 for empty inner_list).\"\"\"\n    return sum(inner_list)\n\ndef max_sum_list(list_of_lists):\n    \"\"\"Returns the list in a list of lists whose sum of elements is the highest.\"\"\"\n    max_sum = float('-inf')\n    max_list = None\n\n    for inner_list in list_of_lists:\n        current_sum = _sum_list(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n\n    return max_list"}
{"task_id": "Mbpp/806", "solution": "def _compute_runs(s: str) -> int:\n    \"\"\"Calculates the maximum run of uppercase characters in a string.\n    This internal helper iterates and tracks consecutive uppercase characters.\"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run\n\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"Finds the maximum run of uppercase characters in the given string.\n    Returns the length of the longest consecutive sequence of uppercase characters.\"\"\"\n    return _compute_runs(s)"}
{"task_id": "Mbpp/808", "solution": "def check_K(tuple_in, k):\n    \"\"\"Check membership of k in tuple_in.\n\n    Validates input type and returns a strict boolean indicating if k is present.\n    \"\"\"\n    if not isinstance(tuple_in, tuple):\n        raise TypeError(\"tuple_in must be a tuple\")\n    return k in tuple_in"}
{"task_id": "Mbpp/809", "solution": "class Validator:\n    \"\"\"Encapsulates tuple input validation logic. Returns True if input is a tuple, False otherwise.\"\"\"\n    def validate_tuple(self, input) -> bool:\n        \"\"\"Return True if input is a tuple, False otherwise.\"\"\"\n        return isinstance(input, tuple)\n\nclass Comparator:\n    \"\"\"Encapsulates element-by-element index-based comparison logic. Compares up to minimum length.\"\"\"\n    def compare_by_index(self, first_tuple, second_tuple) -> bool:\n        \"\"\"Return True only if for all i in 0..min_len-1, second_tuple[i] < first_tuple[i].\"\"\"\n        min_len = min(len(first_tuple), len(second_tuple))\n        for i in range(min_len):\n            if not (second_tuple[i] < first_tuple[i]):\n                return False\n        return True\n\ndef check_smaller(first_tuple, second_tuple) -> bool:\n    \"\"\"Public API: returns True iff every element of second_tuple is strictly smaller than corresponding element of first_tuple.\"\"\"\n    validator = Validator()\n    comparator = Comparator()\n\n    if not validator.validate_tuple(first_tuple) or not validator.validate_tuple(second_tuple):\n        return False\n\n    return comparator.compare_by_index(first_tuple, second_tuple)"}
