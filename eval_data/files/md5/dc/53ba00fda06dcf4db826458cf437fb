{"task_id": "Mbpp/84", "solution": "from typing import Callable\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to the sequence function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input for the Newman-Conway sequence.\"\"\"\n    def is_positive_integer(self, n) -> bool:\n        \"\"\"Checks if n is a positive integer.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def validate(self, n) -> None:\n        \"\"\"Raises ValidationError if n is not a positive integer.\"\"\"\n        if not self.is_positive_integer(n):\n            raise ValidationError(\"Input 'n' must be a positive integer.\")\n\nclass Result:\n    \"\"\"A simple container for integer values.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass NewmanConwayCalculator:\n    \"\"\"Calculates terms of the Newman-Conway sequence with memoization.\"\"\"\n    def __init__(self, sequence_callable: Callable[[int], int] = None):\n        \"\"\"Initializes with an optional callable for recursive calls and a memoization cache.\"\"\"\n        self._sequence_callable = sequence_callable\n        self._memo: dict[int, int] = {}\n\n    def compute(self, n: int) -> int:\n        \"\"\"Returns the nth Newman-Conway number, using memoization.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        if n == 1 or n == 2:\n            result = 1\n        else:\n            result = self._compute_recurrence(n)\n\n        self._memo[n] = result\n        return result\n\n    def _compute_recurrence(self, n: int) -> int:\n        \"\"\"Computes sequence(n) for n > 2 using the recurrence relation.\"\"\"\n        if self._sequence_callable is None:\n            raise RuntimeError(\"Sequence callable not provided for recurrence calculation.\")\n\n        p_n_minus_1 = self._sequence_callable(n - 1)\n        term1 = self._sequence_callable(p_n_minus_1)\n        term2 = self._sequence_callable(n - p_n_minus_1)\n        return term1 + term2\n\nclass SequenceFunction:\n    \"\"\"Orchestrates input validation and Newman-Conway sequence computation.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._calculator = NewmanConwayCalculator(sequence_callable=self.sequence)\n\n    def sequence(self, n) -> int:\n        \"\"\"Validates input and computes the nth Newman-Conway number.\"\"\"\n        self._validator.validate(n)\n        return self._calculator.compute(n)\n\ndef sequence(n) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    assert sequence(10) == 6\n    \"\"\"\n    return SequenceFunction().sequence(n)"}
{"task_id": "Mbpp/85", "solution": "import math\n\nclass Sphere:\n    \"\"\"Represents a sphere with a given radius and computes its surface area.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self.radius = radius\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Computes the surface area of the sphere using the formula 4 * pi * radius^2.\"\"\"\n        return 4 * math.pi * self.radius * self.radius\n\nclass SurfaceAreaCalculator:\n    \"\"\"Provides methods to calculate surface areas of geometric shapes.\"\"\"\n    def surfacearea_sphere(self, radius: float) -> float:\n        \"\"\"Calculates the surface area of a sphere.\"\"\"\n        sphere = Sphere(radius)\n        return sphere.compute_surface_area()\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Public API: accepts a single parameter radius and returns the float surface area of a sphere.\"\"\"\n    calculator = SurfaceAreaCalculator()\n    return calculator.surfacearea_sphere(radius)"}
{"task_id": "Mbpp/86", "solution": "class InputValidationError(Exception):\n    def __init__(self, message: str, type: str = 'validation_error'):\n        super().__init__(message)\n        self.message = message\n        self.type = type\n\nclass IntegerInput:\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        return isinstance(self.value, int)\n\n    def is_positive(self) -> bool:\n        return self.value >= 1\n\nclass HexagonalNumber:\n    def __init__(self, value: int):\n        self.value = value\n\ndef _validate_integer_input(n) -> IntegerInput:\n    \"\"\"Validates if n is a positive integer and returns an IntegerInput object.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise InputValidationError(\"n must be a positive integer\")\n    return IntegerInput(n)\n\ndef centered_hexagonal_number(n) -> int:\n    \"\"\"Calculates the nth centered hexagonal number using the formula H(n) = 3 * n * (n - 1) + 1.\"\"\"\n    validated_input = _validate_integer_input(n)\n    result = 3 * validated_input.value * (validated_input.value - 1) + 1\n    return result"}
{"task_id": "Mbpp/88", "solution": "def count_elements(elements: list) -> dict:\n    \"\"\"\n    Internal helper to iterate and compute element counts.\n    It returns a dictionary whose values are integers >= 1 for elements present in the input.\n    \"\"\"\n    frequency = {}\n    for item in elements:\n        frequency[item] = frequency.get(item, 0) + 1\n    return frequency\n\ndef freq_count(elements: list) -> dict:\n    \"\"\"\n    Counts the frequency of all the elements in a list, returned as a dictionary.\n    This function delegates the actual counting to an internal helper function.\n    \"\"\"\n    return count_elements(elements)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict1, dict2, dict3) -> dict:\n    \"\"\"Merges three dictionaries into a single dictionary, with values from earlier dictionaries taking precedence for duplicate keys.\"\"\"\n    merged_dict = {}\n    for d in (dict1, dict2, dict3):\n        for key, value in d.items():\n            if key not in merged_dict:\n                merged_dict[key] = value\n    return merged_dict"}
{"task_id": "Mbpp/90", "solution": "def len_log(words):\n    \"\"\"\n    Finds the length of the longest word in an iterable of words.\n    Returns 0 if the input iterable is empty.\n    \"\"\"\n    max_length = 0\n    for word in words:\n        current_length = len(word)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/89", "solution": "import math\n\ndef closest_num(n):\n    \"Return the largest integer strictly less than n. Raises TypeError for non-numeric inputs, ValueError for NaN or infinite inputs.\"\n    if n == math.floor(n):\n        return int(n) - 1\n    else:\n        return math.floor(n)"}
