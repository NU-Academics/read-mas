{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m, n) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n.\n    Each element is a positive integer, greater than or equal to\n    twice the previous element, and less than or equal to m.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Validates that m and n are positive integers.\"\"\"\n        def validate_m_n(self, m_val: int, n_val: int) -> None:\n            if not isinstance(m_val, int) or m_val < 1:\n                raise ValueError(\"m must be an integer >= 1\")\n            if not isinstance(n_val, int) or n_val < 1:\n                raise ValueError(\"n must be an integer >= 1\")\n\n    class SequenceCalculator:\n        \"\"\"Computes the number of valid sequences using recursion with memoization.\"\"\"\n        def __init__(self):\n            self._m: int = 0\n            self._memo: dict[tuple[int, int], int] = {}\n\n        def get_total_number_of_sequences(self, m_val: int, n_val: int) -> int:\n            if n_val == 1:\n                return m_val\n\n            self._m = m_val\n            self._memo = {}  # Clear memoization cache for each new calculation\n\n            total_count = 0\n            # For the first element (a1), it can be any integer from 1 to m_val\n            for a1 in range(1, m_val + 1):\n                # We need to find sequences of length n_val, so n_val - 1 more elements are needed after a1\n                total_count += self.countFrom(a1, n_val - 1)\n            return total_count\n\n        def countFrom(self, current_start_val: int, remaining_length: int) -> int:\n            \"\"\"\n            Counts valid sequences starting with `current_start_val` and needing `remaining_length` more elements.\n            \"\"\"\n            if remaining_length == 0:\n                # A sequence of the required length has been formed.\n                return 1\n\n            # Check memoization cache to avoid recomputing subproblems\n            if (current_start_val, remaining_length) in self._memo:\n                return self._memo[(current_start_val, remaining_length)]\n\n            count_for_this_path = 0\n            \n            # The next element (a_i) must be >= 2 * a_{i-1} and <= m\n            lower_bound_next_element = 2 * current_start_val\n            upper_bound_next_element = self._m\n\n            # If the lower bound for the next element exceeds the overall upper bound m,\n            # no valid next element exists, so no sequences can be formed from this path.\n            if lower_bound_next_element > upper_bound_next_element:\n                self._memo[(current_start_val, remaining_length)] = 0\n                return 0\n\n            # Iterate through all possible values for the next element\n            for next_element_val in range(lower_bound_next_element, upper_bound_next_element + 1):\n                count_for_this_path += self.countFrom(next_element_val, remaining_length - 1)\n\n            # Store result in memoization cache before returning\n            self._memo[(current_start_val, remaining_length)] = count_for_this_path\n            return count_for_this_path\n\n    # Main execution flow for the get_total_number_of_sequences function\n    validator = InputValidator()\n    validator.validate_m_n(m, n)\n\n    calculator = SequenceCalculator()\n    return calculator.get_total_number_of_sequences(m, n)"}
{"task_id": "Mbpp/244", "solution": "def next_Perfect_Square(n):\n    \"\"\"\n    Finds the next perfect square strictly greater than n.\n    Handles negative numbers by returning 0 as the smallest perfect square.\n    \"\"\"\n    if n < 0:\n        return 0\n    \n    # Calculate the integer part of the square root of n.\n    # This acts as floor(sqrt(n)).\n    root = int(n**0.5)\n    \n    # The next perfect square is always (root + 1)^2,\n    # whether n itself is a perfect square or not.\n    return (root + 1)**2"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: Every single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the dp table for substrings of length 2 to n\n    for current_length in range(2, n + 1):\n        for i in range(n - current_length + 1):\n            j = i + current_length - 1\n            if s[i] == s[j]:\n                # If characters match, they form a palindrome. Add 2 to the LPS of the inner substring.\n                # dp[i+1][j-1] is 0 if i+1 > j-1 (i.e., current_length is 2).\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                # If characters don't match, take the maximum of excluding s[i] or s[j].\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The length of the longest palindromic subsequence for the entire string s[0...n-1]\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "def _compute_lis_sum(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence ending at each index.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lis_sum = list(arr)\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i] and lis_sum[j] + arr[i] > lis_sum[i]:\n                lis_sum[i] = lis_sum[j] + arr[i]\n    return lis_sum\n\ndef _compute_lds_sum(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of a strictly decreasing subsequence starting at each index.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lds_sum = list(arr)\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i] and lds_sum[j] + arr[i] > lds_sum[i]:\n                lds_sum[i] = lds_sum[j] + arr[i]\n    return lds_sum\n\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A bitonic subsequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    lis_sums = _compute_lis_sum(arr)\n    lds_sums = _compute_lds_sum(arr)\n\n    # Initialize max_bitonic_sum with the sum from the first element\n    # This correctly handles cases where all bitonic sums might be negative.\n    max_bitonic_sum = lis_sums[0] + lds_sums[0] - arr[0]\n    \n    for i in range(1, n):\n        current_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        if current_sum > max_bitonic_sum:\n            max_bitonic_sum = current_sum\n\n    return max_bitonic_sum"}
