{"task_id": "Mbpp/418", "solution": "def Find_Max(list_input):\n    \"\"\"\n    Finds the element in a list with the maximum length.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not list_input:\n        raise ValueError('Find_Max requires a non-empty list')\n\n    current_max_element = list_input[0]\n    current_max_len = len(list_input[0])\n\n    for element in list_input[1:]:\n        element_len = len(element)\n        if element_len > current_max_len:\n            current_max_len = element_len\n            current_max_element = element\n            \n    return current_max_element"}
{"task_id": "Mbpp/415", "solution": "from dataclasses import dataclass, field\nfrom typing import Iterator, Iterable, List, Tuple\n\n@dataclass\nclass ProductCandidate:\n    \"\"\"Holds a candidate pair of integers and their product.\"\"\"\n    a: int\n    b: int\n    product: int = field(init=False)\n\n    def __post_init__(self):\n        self.product = self.a * self.b\n\n    def as_ordered_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the pair as a tuple, ordered (min, max).\"\"\"\n        return (min(self.a, self.b), max(self.a, self.b))\n\n@dataclass\nclass ResultTuple:\n    \"\"\"Represents the final ordered result tuple (min, max).\"\"\"\n    a: int\n    b: int\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Converts the ResultTuple to a standard Python tuple.\"\"\"\n        return (self.a, self.b)\n\ndef _validate(arr: List[int]) -> None:\n    \"\"\"Validates the input array based on design constraints.\"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"insufficient elements: need at least 2\")\n    if any(not isinstance(x, int) for x in arr):\n        raise TypeError(\"non-integer element found in arr\")\n\ndef _generate_candidate_pairs(arr: List[int]) -> Iterator[ProductCandidate]:\n    \"\"\"Generates all unique pairs of elements from the array by index.\"\"\"\n    n = len(arr)\n    for i in range(n):\n        for j in range(i + 1, n):\n            yield ProductCandidate(arr[i], arr[j])\n\ndef _select_best_candidate(candidates: Iterable[ProductCandidate]) -> ResultTuple:\n    \"\"\"Selects the best candidate pair based on product and tie-breaking rules.\"\"\"\n    \n    # Initialize best_candidate with the first available candidate.\n    # _validate ensures there are at least 2 elements, so candidates iterable won't be empty.\n    iterator = iter(candidates)\n    best_candidate = next(iterator)\n\n    for candidate in iterator:\n        if candidate.product > best_candidate.product:\n            best_candidate = candidate\n        elif candidate.product == best_candidate.product:\n            # Apply tie-breaking rules: largest max(element), then largest min(element)\n            current_best_max_element = max(best_candidate.a, best_candidate.b)\n            candidate_max_element = max(candidate.a, candidate.b)\n\n            if candidate_max_element > current_best_max_element:\n                best_candidate = candidate\n            elif candidate_max_element == current_best_max_element:\n                current_best_min_element = min(best_candidate.a, best_candidate.b)\n                candidate_min_element = min(candidate.a, candidate.b)\n\n                if candidate_min_element > current_best_min_element:\n                    best_candidate = candidate\n                # If still equal, the first encountered (best_candidate) remains selected.\n\n    # Return the selected pair as an ordered ResultTuple.\n    final_a, final_b = best_candidate.as_ordered_tuple()\n    return ResultTuple(final_a, final_b)\n\ndef max_Product(arr: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n\n    Handles validation, generates candidate pairs, applies tie-breaking, and returns\n    the selected pair as an ascending-ordered tuple (min, max).\n    \"\"\"\n    _validate(arr)\n    candidates = _generate_candidate_pairs(arr)\n    best_result_tuple = _select_best_candidate(candidates)\n    return best_result_tuple.to_tuple()"}
{"task_id": "Mbpp/419", "solution": "from dataclasses import dataclass\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom typing import List\n\n@dataclass\nclass NumberItem:\n    original_value: float\n    rounded_value: int\n\n@dataclass\nclass InputList:\n    items: List[NumberItem]\n    length: int = 0\n\n    def __post_init__(self) -> None:\n        self.length = len(self.items)\n\n@dataclass\nclass Computation:\n    sum_rounded: int\n    final_result: int\n\n@dataclass\nclass Result:\n    value: int\n\ndef _round_half_up(value: float) -> int:\n    \"\"\"Round a floating-point number to nearest integer using ROUND_HALF_UP semantics and return an int.\"\"\"\n    return int(Decimal(str(value)).quantize(Decimal(\"0\"), ROUND_HALF_UP))\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"Round elements, compute their sum, multiply by list length, and return the final integer result.\"\"\"\n    if not numbers:\n        return 0\n\n    number_items: List[NumberItem] = []\n    for num in numbers:\n        rounded = _round_half_up(float(num))\n        number_items.append(NumberItem(original_value=float(num), rounded_value=rounded))\n\n    input_list = InputList(items=number_items)\n\n    sum_rounded = sum(item.rounded_value for item in input_list.items)\n    final_result = sum_rounded * input_list.length\n\n    computation = Computation(sum_rounded=sum_rounded, final_result=final_result)\n    result = Result(value=computation.final_result)\n\n    return result.value"}
{"task_id": "Mbpp/420", "solution": "from src.even_sequence import EvenNumberSequence\nfrom src.calculation import Calculation\nfrom src.result import Result\n\ndef cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers.\n    Validates input and orchestrates sequence generation and summation.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    numbers = EvenNumberSequence().generate(n)\n    int_sum = Calculation().sum_of_cubes(numbers)\n    return int_sum"}
