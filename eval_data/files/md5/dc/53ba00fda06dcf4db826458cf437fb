{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Union\n\nNumber = Union[int, float]\nInnerTuple = Tuple[Number, Number]\nOuterTuple = Tuple[InnerTuple, ...]\nResultTuple = Tuple[InnerTuple, ...]\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures in tuple operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass IndexMultiplicationFunction:\n    \"\"\"Helper class to orchestrate validation and computation for index-wise tuple multiplication.\"\"\"\n\n    def validate_outer_length(self, tupleA: OuterTuple, tupleB: OuterTuple) -> None:\n        \"\"\"Raise ValidationError when the lengths of the outer tuples do not match.\"\"\"\n        if len(tupleA) != len(tupleB):\n            raise ValidationError(\"Outer tuple lengths mismatch.\")\n\n    def validate_inner_lengths(self, innerA: InnerTuple, innerB: InnerTuple) -> None:\n        \"\"\"Raise ValidationError if inner tuples are not of length 2.\"\"\"\n        if len(innerA) != 2 or len(innerB) != 2:\n            raise ValidationError(\"Inner tuple length mismatch: expected 2 elements.\")\n\n    def validate_numeric_elements(self, inner: InnerTuple) -> None:\n        \"\"\"Raise ValidationError if any element within an inner tuple is not numeric.\"\"\"\n        for element in inner:\n            if not isinstance(element, (int, float)):\n                raise ValidationError(\"Non-numeric element found in an inner tuple.\")\n\n    def index_multiplication(self, tupleA: OuterTuple, tupleB: OuterTuple) -> ResultTuple:\n        \"\"\"Orchestrates validation and computation for index-wise multiplication.\"\"\"\n        self.validate_outer_length(tupleA, tupleB)\n\n        result_list = []\n        for i in range(len(tupleA)):\n            a = tupleA[i]\n            b = tupleB[i]\n\n            self.validate_inner_lengths(a, b)\n            self.validate_numeric_elements(a)\n            self.validate_numeric_elements(b)\n\n            a_first, a_second = a\n            b_first, b_second = b\n            result_list.append((a_first * b_first, a_second * b_second))\n\n        return tuple(result_list)\n\ndef index_multiplication(tupleA: OuterTuple, tupleB: OuterTuple) -> ResultTuple:\n    \"\"\"Performs index-wise multiplication of tuple elements in two given tuples.\n    Raises ValidationError for input validation failures and returns an immutable tuple of tuples.\n    \"\"\"\n    impl = IndexMultiplicationFunction()\n    return impl.index_multiplication(tupleA, tupleB)"}
