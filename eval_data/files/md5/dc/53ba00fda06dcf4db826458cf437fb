{"task_id": "Mbpp/450", "solution": "def extract_string(list_of_strings, size):\n    \"\"\"\n    Extracts strings of a specified size from a list of strings.\n    Returns a new list containing only strings whose length matches `size`, preserving original order.\n    \"\"\"\n    result = []\n    for s in list_of_strings:\n        if len(s) == size:\n            result.append(s)\n    return result"}
{"task_id": "Mbpp/448", "solution": "from dataclasses import dataclass\nfrom typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\n\n@dataclass\nclass PerrinNumber:\n    \"\"\"Represents a Perrin number with its index and value.\"\"\"\n    index: int\n    value: int\n\n_perrin_cache = {0: 3, 1: 0, 2: 2}\n\ndef computePerrin(n: int) -> int:\n    \"\"\"\n    Computes the nth Perrin number using memoization.\n    Base cases: P(0)=3, P(1)=0, P(2)=2. Recurrence: P(n) = P(n-2) + P(n-3) for n >= 3.\n    \"\"\"\n    if n not in _perrin_cache:\n        _perrin_cache[n] = computePerrin(n - 2) + computePerrin(n - 3)\n    return _perrin_cache[n]\n\nclass PerrinSequence:\n    \"\"\"Manages a sequence of Perrin numbers and provides sum functionality.\"\"\"\n    def __init__(self):\n        self.numbers: List[PerrinNumber] = []\n\n    def generateUpTo(self, n: int) -> None:\n        \"\"\"Populates the sequence with Perrin numbers from P(0) up to P(n).\"\"\"\n        self.numbers = []\n        for i in range(n + 1):\n            self.numbers.append(PerrinNumber(index=i, value=computePerrin(i)))\n\n    def getSum(self) -> int:\n        \"\"\"Returns the sum of all Perrin numbers currently in the sequence.\"\"\"\n        return sum(pn.value for pn in self.numbers)\n\ndef validate(n) -> None:\n    \"\"\"\n    Validates if n is a non-negative integer.\n    Raises ValidationError if validation fails.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValidationError(\"Input 'n' must be a non-negative integer.\")\n\ndef cal_sum(n) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    Validates input 'n' and raises ValidationError for invalid inputs.\n    \"\"\"\n    validate(n)\n\n    perrin_seq = PerrinSequence()\n    perrin_seq.generateUpTo(n)\n\n    return perrin_seq.getSum()"}
{"task_id": "Mbpp/451", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass OutputString:\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass AssertionExample:\n    def __init__(self, input_str: str, expected_output: str):\n        self.input = input_str\n        self.expected_output = expected_output\n\nclass WhitespaceRemover:\n    def _is_whitespace(self, ch: str) -> bool:\n        \"\"\"Determines if a character is a space, tab, or newline.\"\"\"\n        return ch == ' ' or ch == '\\t' or ch == '\\n'\n\n    def remove_whitespaces(self, input_str: str) -> str:\n        \"\"\"Removes specified whitespace characters from the input string.\"\"\"\n        if not input_str:\n            return \"\"\n\n        result_chars = []\n        for char in input_str:\n            if not self._is_whitespace(char):\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\ndef remove_whitespaces(input_str):\n    \"\"\"Public API. Input: string. Output: string with whitespace removed.\"\"\"\n    remover = WhitespaceRemover()\n    return remover.remove_whitespaces(input_str)"}
{"task_id": "Mbpp/453", "solution": "def compute_divisors(n: int) -> list[int]:\n    \"\"\"Computes all positive divisors of a given positive integer n.\"\"\"\n    divisors = []\n    for i in range(1, n + 1):\n        if n % i == 0:\n            divisors.append(i)\n    return divisors\n\ndef filter_even(divisors: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning only the even numbers.\"\"\"\n    return [d for d in divisors if d % 2 == 0]\n\ndef sum_divisors(divisors: list[int]) -> int:\n    \"\"\"Calculates the sum of integers in a list, returning 0 for an empty list.\"\"\"\n    return sum(divisors)\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Finds the sum of all even factors of a given positive integer.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    all_divisors = compute_divisors(n)\n    even_divisors = filter_even(all_divisors)\n    return sum_divisors(even_divisors)"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List\n\nclass Word:\n    \"\"\"Represents a word with its content and position.\"\"\"\n    def __init__(self, content: str, position: int):\n        self.content = content\n        self.position = position\n\n    def containsZ(self) -> bool:\n        \"\"\"Checks if the word contains the lowercase character 'z'.\"\"\"\n        return 'z' in self.content\n\nclass Tokenizer:\n    \"\"\"Parses text into Word instances, ignoring punctuation.\"\"\"\n    def tokenize(self, text: str) -> List[Word]:\n        \"\"\"Extracts contiguous alphabetic sequences as Word objects.\"\"\"\n        words_content = re.findall(r\"[A-Za-z]+\", text)\n        words = []\n        for i, content in enumerate(words_content):\n            words.append(Word(content, i))\n        return words\n\nclass TextMatcher:\n    \"\"\"Orchestrates tokenization and matching logic.\"\"\"\n    def __init__(self) -> None:\n        self._tokenizer = Tokenizer()\n\n    def tokenize(self, text: str) -> List[Word]:\n        \"\"\"Delegates tokenization to the internal tokenizer.\"\"\"\n        return self._tokenizer.tokenize(text)\n\n    def anyWordContainsZ(self, words: List[Word]) -> bool:\n        \"\"\"Checks if any word in the list contains 'z'.\"\"\"\n        for word in words:\n            if word.containsZ():\n                return True\n        return False\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Tokenizes text and checks if any word contains 'z'.\"\"\"\n        words = self._tokenizer.tokenize(text)\n        return self.anyWordContainsZ(words)\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains at least one word with the character 'z'.\n    Words are defined as contiguous alphabetic characters, ignoring punctuation.\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz(text)"}
{"task_id": "Mbpp/456", "solution": "from typing import List, Iterator\n\nclass StringItem:\n    \"\"\"Wraps a single string and provides a reverse operation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def reverse(self) -> str:\n        \"\"\"Reverses the wrapped string.\"\"\"\n        return self.value[::-1]\n\nclass StringList:\n    \"\"\"Represents a list of StringItem objects.\"\"\"\n    def __init__(self, items: List[str]) -> None:\n        self.items: List[StringItem] = [StringItem(item) for item in items]\n\n    def to_plain_list(self) -> List[str]:\n        \"\"\"Converts the list of StringItem objects back to a list of plain strings.\"\"\"\n        return [item.value for item in self.items]\n    \n    def iter_items(self) -> Iterator[StringItem]:\n        \"\"\"Returns an iterator over the contained StringItem objects.\"\"\"\n        return iter(self.items)\n\nclass ReverseFunction:\n    \"\"\"Encapsulates processing logic to reverse each string in a StringList.\"\"\"\n    def __init__(self, input_list: StringList) -> None:\n        self._input_list = input_list\n\n    def reverse_string_list(self) -> List[str]:\n        \"\"\"Reverses each string in the input StringList and returns a new list of reversed strings.\"\"\"\n        reversed_strings: List[str] = []\n        for item in self._input_list.iter_items():\n            reversed_strings.append(item.reverse())\n        return reversed_strings\n\ndef reverse_string_list(strings: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    The function delegates the reversal logic to domain-specific classes.\n    \"\"\"\n    string_list_instance = StringList(strings)\n    reverse_function_instance = ReverseFunction(string_list_instance)\n    return reverse_function_instance.reverse_string_list()"}
{"task_id": "Mbpp/455", "solution": "class Month:\n    def __init__(self, number: int):\n        self.number = number\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the month number is between 1 and 12, inclusive.\"\"\"\n        return 1 <= self.number <= 12\n\n    def has_31_days(self) -> bool:\n        \"\"\"Returns True if the month has 31 days.\"\"\"\n        return self.number in {1, 3, 5, 7, 8, 10, 12}\n\nclass MonthChecker:\n    def check_monthnumb_number(self, month: int) -> bool:\n        \"\"\"Orchestrates the month check using the Month domain object.\"\"\"\n        month_obj = Month(month)\n        result = month_obj.has_31_days()\n        return result\n\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 31 days or not.\n    Delegates the check to an instance of MonthChecker.\n    \"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumb_number(month)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_sublists):\n    \"\"\"\n    Finds the sublist with the minimum length in a list of sublists.\n    Returns the first such sublist if multiple have the same minimum length.\n    \"\"\"\n\n    # Helper function to validate the input list of sublists.\n    def _validate_input(data):\n        if not isinstance(data, list):\n            raise ValueError(\"Input must be a list.\")\n        if not data:\n            raise ValueError(\"Input list cannot be empty.\")\n        for i, sublist in enumerate(data):\n            if not isinstance(sublist, list):\n                raise ValueError(f\"Element at index {i} is not a list.\")\n\n    # Helper function to find the index of the first minimum-length sublist.\n    def _find_first_min_index(data):\n        min_length = float('inf')\n        min_index = -1\n        for i, sublist in enumerate(data):\n            if len(sublist) < min_length:\n                min_length = len(sublist)\n                min_index = i\n        return min_index\n\n    _validate_input(list_of_sublists)\n    min_index = _find_first_min_index(list_of_sublists)\n    return list_of_sublists[min_index]"}
{"task_id": "Mbpp/458", "solution": "class NumericParameter:\n    \"\"\"Wraps a parameter value to check if it's numeric.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Returns True if the wrapped value is an int or float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass Rectangle:\n    \"\"\"Represents a rectangle with width and height, calculating its area.\"\"\"\n    def __init__(self, width: float, height: float):\n        self.width = width\n        self.height = height\n\n    def area(self) -> float:\n        \"\"\"Calculates and returns the area of the rectangle.\"\"\"\n        return self.width * self.height\n\nclass AreaResult:\n    \"\"\"Value object representing a computed area.\"\"\"\n    def __init__(self, value: float):\n        self._value = float(value)\n\n    @property\n    def value(self) -> float:\n        \"\"\"The computed area value.\"\"\"\n        return self._value\n\nclass AreaCalculator:\n    \"\"\"Calculates the area of a rectangle, validating inputs.\"\"\"\n    @staticmethod\n    def rectangle_area(width, height) -> float:\n        \"\"\"Validates width and height, then computes the rectangle's area.\"\"\"\n        numeric_width = NumericParameter(width)\n        numeric_height = NumericParameter(height)\n\n        if not numeric_width.is_numeric():\n            raise TypeError(f\"Width must be numeric (int or float), got {type(width).__name__}\")\n        if not numeric_height.is_numeric():\n            raise TypeError(f\"Height must be numeric (int or float), got {type(height).__name__}\")\n\n        rect = Rectangle(float(width), float(height))\n        computed_area = rect.area()\n        \n        area_result = AreaResult(computed_area)\n        return area_result.value\n\ndef rectangle_area(width, height):\n    \"\"\"Calculates the area of a rectangle given its width and height.\"\"\"\n    return AreaCalculator.rectangle_area(width, height)"}
{"task_id": "Mbpp/459", "solution": "def _is_ascii_uppercase(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII uppercase letter.\"\"\"\n    return 'A' <= ch <= 'Z'\n\nclass Character:\n    \"\"\"Represents a single character with an ASCII uppercase check.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def isAsciiUppercase(self) -> bool:\n        \"\"\"Determines if the character is an ASCII uppercase letter.\"\"\"\n        return _is_ascii_uppercase(self.char)\n\nclass InputString:\n    \"\"\"A lightweight wrapper for an input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass OutputString:\n    \"\"\"A lightweight wrapper for an output string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\ndef remove_uppercase(input: str) -> str:\n    \"\"\"Removes all ASCII uppercase letters from the input string.\"\"\"\n    input_obj = InputString(input)\n    output_chars = []\n    for char_str in input_obj.value:\n        char_obj = Character(char_str)\n        if not char_obj.isAsciiUppercase():\n            output_chars.append(char_str)\n    \n    output_str_value = \"\".join(output_chars)\n    output_obj = OutputString(output_str_value)\n    return output_obj.value"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list):\n    \"\"\"\n    Return list of first elements of each sublist in input_list, preserving input order.\n    Assumes input_list is a Python list of sublists, and each sublist has at least one element.\n    \"\"\"\n    result = []\n    for sublist in input_list:\n        result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/462", "solution": "from dataclasses import dataclass\nfrom typing import Any, List\n\n@dataclass\nclass Element:\n    \"\"\"Holds an element's value and its original index position.\"\"\"\n    value: Any\n    position: int\n\n@dataclass\nclass InputList:\n    \"\"\"Wraps the raw input list, creating Element instances.\"\"\"\n    elements: List[Element]\n\n    def __init__(self, raw_list: list):\n        self.elements = [Element(value, i) for i, value in enumerate(raw_list)]\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, index: int) -> Element:\n        return self.elements[index]\n\n@dataclass\nclass Subset:\n    \"\"\"Represents a subset composed of Element instances ordered descending by original position.\"\"\"\n    elements: List[Element]\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Converts the subset to a plain list of values.\"\"\"\n        return [element.value for element in self.elements]\n\n@dataclass\nclass CombinationResult:\n    \"\"\"Aggregates produced Subset instances and provides count metadata.\"\"\"\n    subsets: List[Subset]\n    count: int\n\n    def to_list_of_lists(self) -> List[List[Any]]:\n        \"\"\"Converts the result to a plain list-of-lists for callers.\"\"\"\n        return [subset.to_list() for subset in self.subsets]\n\nclass CombinationsFunction:\n    \"\"\"Encapsulates algorithm to compute deterministic power set.\"\"\"\n    def combinations_list(self, input_list: InputList) -> CombinationResult:\n        \"\"\"Computes all possible combinations (power set) of the elements.\"\"\"\n        n = len(input_list)\n        result_subsets: List[Subset] = []\n\n        # Enumerate masks from 0 to 2^n - 1 to determine subset enumeration order.\n        for mask in range(1 << n):\n            current_subset_elements: List[Element] = []\n            # Iterate through elements in reverse order of position for per-subset element ordering.\n            for i in range(n - 1, -1, -1): # From highest original index down to 0\n                if (mask >> i) & 1:  # Check if the i-th bit is set\n                    current_subset_elements.append(input_list[i])\n            result_subsets.append(Subset(elements=current_subset_elements))\n\n        return CombinationResult(subsets=result_subsets, count=len(result_subsets))\n\ndef combinations_list(input_list: list) -> list:\n    \"\"\"\n    Finds all possible combinations (power set) of the elements of a given list.\n    Subsets are ordered by ascending binary enumeration of inclusion bits,\n    and elements within each subset are ordered descending by original position.\n    \"\"\"\n    input_list_obj = InputList(raw_list=input_list)\n    combinator = CombinationsFunction()\n    result_obj = combinator.combinations_list(input_list_obj)\n    return result_obj.to_list_of_lists()"}
{"task_id": "Mbpp/471", "solution": "def _mod(value: int, n: int) -> int:\n    \"\"\"Computes the remainder of value divided by n.\"\"\"\n    return value % n\n\ndef apply_modular_multiplication(array: list[int], n: int) -> int:\n    \"\"\"\n    Computes the product of array elements modulo n, applying modulo after each multiplication.\n    Handles empty arrays by returning 1 (multiplicative identity).\n    \"\"\"\n    product = 1\n    for element in array:\n        product = _mod(product * element, n)\n    return product\n\ndef find_remainder(array: list[int], n: int) -> int:\n    \"\"\"\n    Finds the product of the array elements modulo n using modular multiplication.\n    This function delegates the core logic to apply_modular_multiplication.\n    \"\"\"\n    return apply_modular_multiplication(array, n)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\n\ndef add_pairwise(input_tuple: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in the given tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    n = len(input_tuple)\n    if n < 2:\n        return ()\n\n    results = []\n    for i in range(n - 1):\n        results.append(input_tuple[i] + input_tuple[i+1])\n\n    return tuple(results)"}
{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous non-empty subarray.\n    This O(n) algorithm handles positive, negative, and zero elements.\n    \"\"\"\n    # Initialize current max and min product ending at the current position,\n    # and the overall maximum product found so far.\n    current_max_product = arr[0]\n    current_min_product = arr[0]\n    overall_max = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # If the current number is negative, then current_max_product and current_min_product\n        # will swap their roles (max becomes min, min becomes max) when multiplied.\n        if num < 0:\n            current_max_product, current_min_product = current_min_product, current_max_product\n\n        # Update current max product ending at the current position.\n        # It's either the number itself (starting a new subarray) or\n        # extending the previous max product by multiplying with 'num'.\n        current_max_product = max(num, current_max_product * num)\n\n        # Update current min product ending at the current position.\n        # It's either the number itself (starting a new subarray) or\n        # extending the previous min product by multiplying with 'num'.\n        current_min_product = min(num, current_min_product * num)\n\n        # Update the overall maximum product found across all subarrays.\n        overall_max = max(overall_max, current_max_product)\n\n    return overall_max"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(input_dict: dict) -> dict:\n    \"\"\"\n    Returns a new dictionary with items whose values are None removed.\n    Raises TypeError if the input is not a dictionary.\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"drop_empty expects a dict as input\")\n    return {k: v for k, v in input_dict.items() if v is not None}"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0.0 # Return 0 for an empty array as there's no subsequence product.\n\n    # best_product[i] stores the maximum product of a strictly increasing subsequence ending at index i.\n    # Initialize with the elements themselves, as single-element subsequences are valid.\n    best_product = [float(x) for x in arr]\n\n    for i in range(n):\n        for j in range(i):\n            # If arr[i] can extend the strictly increasing subsequence ending at arr[j]\n            if arr[j] < arr[i]:\n                # Update best_product[i] if a larger product can be formed by\n                # appending arr[i] to a subsequence ending at arr[j].\n                best_product[i] = max(best_product[i], best_product[j] * arr[i])\n\n    # The overall maximum product is the maximum value found in the best_product array.\n    # If the array was empty, best_product would be empty, but we handled n=0.\n    # If all elements are non-positive, the max could still be a single element or product of two negatives.\n    return max(best_product)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(list: list) -> bool:\n    \"\"\"\n    Checks if the given list contains numbers that are consecutive and increasing by one.\n    The input list is not modified.\n    \"\"\"\n    n = len(list)\n    if n < 2:\n        return True\n\n    for i in range(1, n):\n        if list[i] != list[i-1] + 1:\n            return False\n            \n    return True"}
