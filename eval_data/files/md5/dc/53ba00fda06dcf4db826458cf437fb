{"task_id": "Mbpp/279", "solution": "class DecagonalError(Exception):\n    \"\"\"Custom exception for decagonal number service errors.\"\"\"\n    def __init__(self, message: str, code: int = 1) -> None:\n        self.message = message\n        self.code = code\n        super().__init__(self.message)\n\nclass InputValidator:\n    \"\"\"Validates input 'n' for decagonal number computation.\"\"\"\n    def isPositiveInteger(self, n: int) -> bool:\n        \"\"\"Checks if n is a positive integer.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def assertValid(self, n: int) -> None:\n        \"\"\"Raises DecagonalError if n is not a valid positive integer.\"\"\"\n        if not self.isPositiveInteger(n):\n            raise DecagonalError(\"Input 'n' must be an integer and >= 1.\", code=100)\n\nclass Calculator:\n    \"\"\"Computes decagonal numbers using the closed-form formula.\"\"\"\n    def calculate(self, n: int) -> int:\n        \"\"\"Returns the nth decagonal number.\"\"\"\n        return n * (4 * n - 3)\n\nclass DecagonalService:\n    \"\"\"Orchestrates validation and computation of decagonal numbers.\"\"\"\n    def __init__(self, validator: InputValidator = None, calculator: Calculator = None) -> None:\n        \"\"\"Initializes the service with optional validator and calculator.\"\"\"\n        self._validator = validator if validator is not None else InputValidator()\n        self._calculator = calculator if calculator is not None else Calculator()\n\n    def computeNth(self, n: int) -> int:\n        \"\"\"Validates n and returns the nth decagonal number.\"\"\"\n        self._validator.assertValid(n)\n        return self._calculator.calculate(n)\n\n    def D_formula(self, n: int) -> int:\n        \"\"\"Returns D(n) by delegating to Calculator.calculate.\"\"\"\n        return self._calculator.calculate(n)\n\ndef is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth decagonal number.\n\n    This function delegates validation and computation to an internal service,\n    raising DecagonalError for invalid inputs.\n    \"\"\"\n    return DecagonalService().computeNth(n)"}
{"task_id": "Mbpp/282", "solution": "from typing import List, Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors during list processing.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nInputList = List[float]\nResultList = List[float]\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a given value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_list(lst: Any, name: str) -> None:\n    \"\"\"Validates that the input is a list containing only numeric elements.\"\"\"\n    if not isinstance(lst, list):\n        raise ValidationError(f\"{name} must be a list, but got {type(lst).__name__}.\")\n    for i, item in enumerate(lst):\n        if not _is_numeric(item):\n            raise ValidationError(f\"Element at index {i} in {name} is not numeric: {item} (type {type(item).__name__}).\")\n\ndef sub_list(list1: InputList, list2: InputList) -> ResultList:\n    \"\"\"\n    Subtracts two lists element-wise, returning a new list.\n    Validates inputs for type, numeric elements, and equal lengths before subtraction.\n    \"\"\"\n    _validate_list(list1, 'list1')\n    _validate_list(list2, 'list2')\n\n    if len(list1) != len(list2):\n        raise ValidationError(f\"Lists must have equal length, but got {len(list1)} for list1 and {len(list2)} for list2.\")\n\n    result_list: ResultList = []\n    for i in range(len(list1)):\n        result_list.append(list1[i] - list2[i])\n\n    return result_list"}
