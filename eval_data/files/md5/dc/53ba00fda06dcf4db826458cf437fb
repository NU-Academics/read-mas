{"task_id": "Mbpp/283", "solution": "from typing import Dict, List\n\nclass IntegerInput:\n    \"\"\"Represents the input integer and provides its normalized decimal string.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def decimal_digits(self) -> str:\n        \"\"\"Returns the canonical decimal string of the absolute value.\"\"\"\n        return str(abs(self.value))\n\n    def normalize(self) -> None:\n        \"\"\"Semantic placeholder; ensures normalization if needed.\"\"\"\n        pass # Normalization is handled by decimal_digits using abs()\n\nclass DigitFrequency:\n    \"\"\"Maintains counts for digits present in an IntegerInput.\"\"\"\n    def __init__(self):\n        self.counts: Dict[int, int] = {}\n\n    def compute_counts(self, input_obj: IntegerInput) -> None:\n        \"\"\"Computes digit frequencies from the input integer.\"\"\"\n        decimal_str = input_obj.decimal_digits()\n        for digit_char in decimal_str:\n            digit = int(digit_char)\n            self.counts[digit] = self.counts.get(digit, 0) + 1\n\n    def get_count(self, digit: int) -> int:\n        \"\"\"Returns the count of a specific digit.\"\"\"\n        return self.counts.get(digit, 0)\n\nclass ValidationResult:\n    \"\"\"Represents the outcome of evaluation and textual violations.\"\"\"\n    def __init__(self, is_valid: bool, violations: List[str]):\n        self.is_valid = is_valid\n        self.violations = violations\n\nclass Validator:\n    \"\"\"Evaluates DigitFrequency against business rules.\"\"\"\n    def __init__(self):\n        pass\n\n    def validate(self, input_obj: IntegerInput) -> bool:\n        \"\"\"Validates an IntegerInput directly.\"\"\"\n        freq = DigitFrequency()\n        freq.compute_counts(input_obj)\n        result = self.evaluate(freq)\n        return result.is_valid\n\n    def evaluate(self, freq: DigitFrequency) -> ValidationResult:\n        \"\"\"Evaluates digit frequencies against the rule.\"\"\"\n        violations: List[str] = []\n        is_valid = True\n        for digit, count in freq.counts.items():\n            if count > digit:\n                is_valid = False\n                violations.append(f\"Digit {digit} has frequency {count}, which is greater than {digit}.\")\n        return ValidationResult(is_valid, violations)\n\ndef validate(value: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer\n    is less than or equal to the digit itself.\n    Public API: validate(value: int) -> bool (BR-1..BR-9)\n    \"\"\"\n    input_obj = IntegerInput(value)\n    validator = Validator()\n    return validator.validate(input_obj)"}
{"task_id": "Mbpp/285", "solution": "from typing import Optional\n\nclass InputString:\n    def __init__(self, content: str) -> None:\n        self.content = content\n\n    @property\n    def length(self) -> int:\n        return len(self.content)\n\nclass Pattern:\n    def __init__(self, expression: str, description: str = \"\") -> None:\n        self.expression = expression\n        self.description = description\n\n    def matches(self, substring: str) -> bool:\n        return substring == self.expression\n\nclass MatchResult:\n    def __init__(self, is_match: bool, matched_substring: Optional[str] = None, position: Optional[int] = None) -> None:\n        self.is_match = is_match\n        self.matched_substring = matched_substring\n        self.position = position\n\nclass TextMatcher:\n    def text_match_two_three(self, text: str) -> bool:\n        input_string = InputString(text)\n        pattern_abb = Pattern(\"abb\", \"pattern 'a' followed by two 'b's\")\n        pattern_abbb = Pattern(\"abbb\", \"pattern 'a' followed by three 'b's\")\n\n        if self._scan_for_pattern(input_string, pattern_abb) is not None:\n            return True\n        if self._scan_for_pattern(input_string, pattern_abbb) is not None:\n            return True\n        return False\n\n    def _scan_for_pattern(self, input_string: InputString, pattern: Pattern) -> Optional[int]:\n        pattern_length = len(pattern.expression)\n        \n        for i in range(input_string.length - pattern_length + 1):\n            substring = input_string.content[i : i + pattern_length]\n            if pattern.matches(substring):\n                return i\n        return None\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'a' followed by two or three 'b' characters.\n    Returns True if 'abb' or 'abbb' is found, False otherwise.\n    \"\"\"\n    return TextMatcher().text_match_two_three(text)"}
{"task_id": "Mbpp/286", "solution": "def validate_inputs(arr, n, k) -> None:\n    \"\"\"\n    Validates arr is list, elements are ints, n is int equal to len(arr), k is int.\n    Raises TypeError or ValueError on invalid inputs.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n != len(arr):\n        raise ValueError(\"Input 'n' must be equal to len(arr).\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if k < 0:\n        raise ValueError(\"Input 'k' cannot be negative.\")\n    if n == 0:\n        # If arr is empty, max(arr) in _apply_all_negative_rule would fail.\n        # The design implies n > 0 from the example and \"max(arr)\" rule.\n        raise ValueError(\"Input 'arr' cannot be empty (n must be > 0).\")\n\n\ndef _kadane(arr: list[int]) -> int:\n    \"\"\"\n    Single-pass Kadane algorithm returning max contiguous subarray sum for arr.\n    Handles arrays with all negative numbers by returning the largest negative number.\n    Assumes arr is not empty.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for x in arr[1:]:\n        current_max = max(x, current_max + x)\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\n\ndef _prefix_suffix_sums(arr: list[int]) -> tuple[int, int, int]:\n    \"\"\"\n    Computes maximum prefix sum, maximum suffix sum, and total sum for arr.\n    Assumes arr is not empty.\n    \"\"\"\n    n = len(arr)\n    total_sum = sum(arr)\n\n    max_prefix_sum = -float('inf')\n    current_sum = 0\n    for x in arr:\n        current_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_sum)\n    \n    max_suffix_sum = -float('inf')\n    current_sum = 0\n    for i in range(n - 1, -1, -1):\n        current_sum += arr[i]\n        max_suffix_sum = max(max_suffix_sum, current_sum)\n    \n    return max_prefix_sum, max_suffix_sum, total_sum\n\n\ndef _compute_with_k(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum contiguous subarray sum for arr repeated k times.\n    Combines Kadane's result, prefix/suffix sums, and total sum.\n    Assumes arr is not empty.\n    \"\"\"\n    if k == 0:\n        return 0 \n    \n    if k == 1:\n        return _kadane(arr)\n\n    kadane_single_arr = _kadane(arr)\n    max_prefix, max_suffix, total_sum = _prefix_suffix_sums(arr)\n\n    # Initial candidate is the max sum entirely within a single block.\n    max_overall_sum = kadane_single_arr\n\n    # Consider subarrays that span across the boundary of two blocks.\n    max_overall_sum = max(max_overall_sum, max_suffix + max_prefix)\n\n    # If total_sum is positive, we can gain by including full blocks in between\n    # the maximum suffix of the first and the maximum prefix of the last.\n    if total_sum > 0:\n        if k > 2: # Only apply if there's at least one full block in between (k-2 > 0)\n            max_overall_sum = max(max_overall_sum, max_suffix + (k - 2) * total_sum + max_prefix)\n        else: # If k=2, (k-2)*total_sum is 0, so max_suffix + max_prefix already covers it.\n            pass # No additional calculation needed beyond max_suffix + max_prefix for k=2 with positive total_sum.\n    \n    return max_overall_sum\n\n\ndef _apply_all_negative_rule(computed_max_sum: int, arr: list[int]) -> int:\n    \"\"\"\n    Applies the rule: if all contiguous sums are negative, return max(arr).\n    Otherwise, return the computed_max_sum. Assumes arr is not empty.\n    \"\"\"\n    if computed_max_sum < 0:\n        return max(arr)\n    return computed_max_sum\n\n\ndef max_sub_array_sum_repeated(arr, n, k) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array formed\n    by repeating the given array k times.\n    \"\"\"\n    validate_inputs(arr, n, k)\n    \n    computed_max_sum = _compute_with_k(arr, n, k)\n    final_result = _apply_all_negative_rule(computed_max_sum, arr)\n    \n    return final_result"}
