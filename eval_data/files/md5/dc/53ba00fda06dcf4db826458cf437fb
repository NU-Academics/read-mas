{"task_id": "Mbpp/253", "solution": "def _is_int_exact(value) -> bool:\n    \"\"\"Return True iff type(value) is int (explicitly excludes bool).\"\"\"\n    return type(value) is int\n\ndef count_integer(list_input):\n    \"\"\"Return the number of elements in list_input whose type is exactly int.\n    \"\"\"\n    count = 0\n    for element in list_input:\n        if _is_int_exact(element):\n            count += 1\n    return count"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(elements, n):\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list\n    and returns a list with a tuple for each combination.\n    \"\"\"\n    _validate_inputs(elements, n)\n    return list(_generate_combinations(elements, n))\n\ndef _validate_inputs(elements, n):\n    \"\"\"\n    Validates the input elements list and integer n.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise ValueError(\"Input 'elements' must be a list.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef _generate_combinations(elements, n):\n    \"\"\"\n    Recursively yields tuples representing combinations with repetition\n    of length n from the given elements.\n    \"\"\"\n    if n == 0:\n        yield ()\n        return\n\n    if not elements:\n        # If the elements list is empty and n > 0, no combinations are possible.\n        return\n\n    for element in elements:\n        for combo_suffix in _generate_combinations(elements, n - 1):\n            yield (element,) + combo_suffix"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(input):\n    \"\"\"Convert input (complex or numeric convertible to complex) to polar coordinates.\n    Returns tuple (r, theta) where both r and theta are Python floats.\n    Raises TypeError for inputs that cannot be interpreted as numeric/complex.\n    \"\"\"\n    try:\n        c = complex(input)\n    except Exception:\n        raise TypeError(\"input cannot be interpreted as numeric/complex\")\n    real = float(c.real)\n    imag = float(c.imag)\n    r = math.sqrt(real * real + imag * imag)\n    theta = math.atan2(imag, real)\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/257", "solution": "def _is_numeric(value):\n    \"\"\"\n    Checks if a given value is an integer or a float.\n    \"\"\"\n    return isinstance(value, (int, float))\n\ndef swap_numbers(a, b):\n    \"\"\"\n    Takes two numbers and returns a tuple with the second number and then the first number.\n    Validates that both inputs are numeric (int or float) and raises TypeError otherwise.\n    \"\"\"\n    if not _is_numeric(a) or not _is_numeric(b):\n        raise TypeError(\"swap_numbers expects numeric (int or float) arguments\")\n    return (b, a)"}
{"task_id": "Mbpp/256", "solution": "def validateInput(n: int) -> None:\n    \"\"\"Validates input n. Raises TypeError if not an int, ValueError if negative.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative number.\")\n\ndef isPrime(x: int) -> bool:\n    \"\"\"Checks if a number x is prime. Returns True if prime, False otherwise.\"\"\"\n    if x < 2:\n        return False\n    if x == 2:\n        return True\n    if x % 2 == 0:\n        return False\n    i = 3\n    while i * i <= x:\n        if x % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"Counts prime numbers strictly less than n.\"\"\"\n    validateInput(n)\n\n    if n <= 2:\n        return 0\n\n    count = 0\n    for i in range(2, n):\n        if isPrime(i):\n            count += 1\n    return count"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Return a new tuple-of-tuples where result[i][j] = max(a[i][j], b[i][j]).\n\n    Raises ValueError for shape mismatches and propagates TypeError for non-comparable elements.\n    \"\"\"\n\n    def _validate_outer_lengths(a: tuple, b: tuple) -> None:\n        \"\"\"Raises ValueError if the outer tuples have different lengths.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"outer length mismatch\")\n\n    def _validate_inner_lengths(a: tuple, b: tuple) -> None:\n        \"\"\"Raises ValueError if any corresponding inner tuples have different lengths.\"\"\"\n        for i in range(len(a)):\n            if len(a[i]) != len(b[i]):\n                raise ValueError(f\"inner length mismatch at index {i}\")\n\n    def _compute_elementwise_max(a: tuple, b: tuple) -> tuple:\n        \"\"\"Computes element-wise maxima and constructs the result as immutable tuple-of-tuples.\"\"\"\n        result_outer_list = []\n        for i in range(len(a)):\n            result_inner_list = []\n            for j in range(len(a[i])):\n                max_value = max(a[i][j], b[i][j])\n                result_inner_list.append(max_value)\n            result_outer_list.append(tuple(result_inner_list))\n        return tuple(result_outer_list)\n\n    _validate_outer_lengths(a, b)\n    _validate_inner_lengths(a, b)\n    return _compute_elementwise_max(a, b)"}
{"task_id": "Mbpp/260", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the newman_prime function.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass InputParameter:\n    \"\"\"Helper class to validate the input 'n' for the NSW sequence.\"\"\"\n    def __init__(self, n) -> None:\n        self._n = n\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(self._n, int) and self._n >= 0\n\n    def assert_valid(self) -> None:\n        \"\"\"Raises InvalidInputError if n is not a non-negative integer.\"\"\"\n        if not self.isValid():\n            raise InvalidInputError(\"n must be a non-negative integer\")\n\nclass NewmanShanksWilliamsSequence:\n    \"\"\"Computes terms of the Newman\u2013Shanks\u2013Williams (NSW) sequence.\"\"\"\n    S0: int = 1\n    S1: int = 1\n\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth term of the NSW sequence iteratively.\"\"\"\n        if n == 0:\n            return self.S0\n        if n == 1:\n            return self.S1\n\n        s_prev_prev = self.S0\n        s_prev = self.S1\n        s_current = 0\n\n        for _ in range(2, n + 1):\n            s_current = 2 * s_prev + s_prev_prev\n            s_prev_prev = s_prev\n            s_prev = s_current\n        return s_current\n\ndef newman_prime(n) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams (NSW) prime number by computing the nth NSW sequence term.\n    It uses the recurrence S_0 = 1, S_1 = 1, and S_n = 2*S_{n-1} + S_{n-2} for n >= 2.\n    \"\"\"\n    ip = InputParameter(n)\n    ip.assert_valid()\n    seq = NewmanShanksWilliamsSequence()\n    return seq.compute(n)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"Return (first_list, second_list) where first_list contains the first L elements of input_list and second_list contains the remaining elements in original order.\"\"\"\n    return input_list[:L], input_list[L:]"}
{"task_id": "Mbpp/261", "solution": "def _is_numeric(value: object) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_inputs(a: tuple, b: tuple) -> None:\n    \"\"\"Performs type, numeric element, and length validation for input tuples.\"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    \n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n    \n    for val in a:\n        if not _is_numeric(val):\n            raise TypeError(\"All elements in the first tuple must be numeric (int or float).\")\n    \n    for val in b:\n        if not _is_numeric(val):\n            raise TypeError(\"All elements in the second tuple must be numeric (int or float).\")\n\ndef division_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise true division on two tuples.\n    Raises TypeError, ValueError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n    _validate_inputs(a, b)\n\n    for val in b:\n        if val == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero: a zero element was found in the second tuple.\")\n            \n    results = [a[i] / b[i] for i in range(len(a))]\n    return tuple(results)"}
{"task_id": "Mbpp/264", "solution": "class CalculationRule:\n    \"\"\"Encapsulates the business rule for calculating dog years.\"\"\"\n    def __init__(self):\n        self.description = \"First two human years = 10.5 dog years each; additional years = 4 dog years each.\"\n\n    def apply(self, humanYears: float) -> float:\n        \"\"\"Applies the BR3 formula to convert human years to dog years.\"\"\"\n        if humanYears <= 2:\n            return humanYears * 10.5\n        else:\n            return 21 + (humanYears - 2) * 4\n\nclass DogAgeCalculator:\n    \"\"\"Orchestrates validation and calculation of dog years.\"\"\"\n    def __init__(self, rule: CalculationRule):\n        self._rule = rule\n\n    def validateInput(self, humanYears: float) -> bool:\n        \"\"\"Checks if humanYears is numeric and non-negative.\"\"\"\n        if not isinstance(humanYears, (int, float)):\n            return False\n        if humanYears < 0:\n            return False\n        return True\n\n    def dog_age(self, humanYears: float) -> float:\n        \"\"\"Calculates dog's age after validating input.\"\"\"\n        if not self.validateInput(humanYears):\n            raise ValueError(\"humanYears must be a non-negative numeric value.\")\n        return self._rule.apply(humanYears)\n\ndef dog_age(humanYears: float) -> float:\n    \"\"\"Calculates a dog's age in dog's years based on human years.\"\"\"\n    rule = CalculationRule()\n    calculator = DogAgeCalculator(rule)\n    return calculator.dog_age(humanYears)"}
{"task_id": "Mbpp/265", "solution": "def _validate_n(n: int) -> None:\n    \"\"\"Validates that n is a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\ndef list_split(items: list, n: int) -> list[list]:\n    \"\"\"Splits a list into n sublists, distributing elements by their original index modulo n.\"\"\"\n    _validate_n(n)\n    result = [[] for _ in range(n)]\n    for j, item in enumerate(items):\n        result[j % n].append(item)\n    return result"}
{"task_id": "Mbpp/266", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Cube:\n    \"\"\"Represents a cube with a given side length.\"\"\"\n    side_length: float\n\nclass LateralSurfaceCalculator:\n    \"\"\"Provides static methods to calculate geometric properties.\"\"\"\n    @staticmethod\n    def lateralsurface_cube(side_length: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cube using the formula 4 * side_length * side_length.\"\"\"\n        return 4 * side_length * side_length\n\ndef lateralsurface_cube(side_length: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    This function delegates the actual calculation to the LateralSurfaceCalculator.\n    \"\"\"\n    return LateralSurfaceCalculator.lateralsurface_cube(side_length)"}
{"task_id": "Mbpp/267", "solution": "class InputParameter:\n    \"\"\"Holds the input parameter n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass Result:\n    \"\"\"Holds the computed integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Validation:\n    \"\"\"Provides methods for validating input parameters.\"\"\"\n    def is_integer(self, n) -> bool:\n        return isinstance(n, int)\n\n    def is_non_negative(self, n: int) -> bool:\n        return n >= 0\n\nclass Computation:\n    \"\"\"Handles the numeric computation using a closed-form formula.\"\"\"\n    def formula(self, n: int) -> int:\n        \"\"\"Computes the sum of squares using the closed-form formula n*(4*n*n - 1)//3.\"\"\"\n        if n == 0:\n            return 0\n        return n * (4 * n * n - 1) // 3\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Validates input type and value, then computes the sum using an O(1) formula.\n    \"\"\"\n    param = InputParameter(n)\n    validator = Validation()\n\n    if not validator.is_integer(param.n):\n        raise TypeError(\"n must be an integer\")\n    if not validator.is_non_negative(param.n):\n        raise ValueError(\"n must be non-negative\")\n\n    comp = Computation()\n    value = comp.formula(param.n)\n    result = Result(value)\n    return result.value"}
{"task_id": "Mbpp/269", "solution": "def ascii_value(c: str) -> int:\n    \"\"\"\n    Returns the ASCII value of a single character.\n    Raises ValueError if the input is not a single-character string.\n    \"\"\"\n    if not isinstance(c, str) or len(c) != 1:\n        raise ValueError(\"ascii_value expects a single-character string\")\n    return ord(c)"}
{"task_id": "Mbpp/268", "solution": "class InputValidator:\n    \"\"\"Validates input n for star number calculation.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"Raises ValueError if n is not an integer or is less than 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n\nclass StarNumberFormula:\n    \"\"\"Computes the nth star number using the formula.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Returns S(n) = 6 * n * (n - 1) + 1.\"\"\"\n        return 6 * n * (n - 1) + 1\n\nclass StarNumberService:\n    \"\"\"Orchestrates validation and computation of star numbers.\"\"\"\n    def __init__(self, validator: InputValidator = None, formula: StarNumberFormula = None) -> None:\n        \"\"\"Initializes the service with optional validator and formula components.\"\"\"\n        self._validator = validator or InputValidator()\n        self._formula = formula or StarNumberFormula()\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Validates n, then computes and returns the nth star number.\"\"\"\n        self._validator.validate(n)\n        return self._formula.compute(n)\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Calculates the n'th star number using the formula S(n) = 6 * n * (n - 1) + 1.\n\n    Raises ValueError if n is not an integer or is less than 1.\n    \"\"\"\n    service = StarNumberService()\n    return service.find_star_num(n)"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n):\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    Handles input validation for type and sign.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(1, n + 1):\n        total_sum += (2 * k) ** 5\n    return total_sum"}
{"task_id": "Mbpp/270", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Wraps a Python list and provides length and element retrieval.\"\"\"\n    def __init__(self, elements: List) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int) -> 'ListElement':\n        \"\"\"Returns a ListElement for the given index and its value.\"\"\"\n        return ListElement(index, self._elements[index])\n\nclass ListElement:\n    \"\"\"Holds an element's index and value, providing parity checks.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\n    def is_even_index(self) -> bool:\n        \"\"\"Checks if the element's index is even.\"\"\"\n        return self.index % 2 == 0\n\n    def is_even_value(self) -> bool:\n        \"\"\"Checks if the element's value is an even integer.\"\"\"\n        return self.value % 2 == 0\n\nclass Result:\n    \"\"\"Accumulates integer values and provides the total sum.\"\"\"\n    def __init__(self, initial: int = 0) -> None:\n        self._sum = initial\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the accumulated sum.\"\"\"\n        self._sum += value\n\n    def value(self) -> int:\n        \"\"\"Returns the current accumulated sum.\"\"\"\n        return self._sum\n\ndef sum_even_and_even_index(lst: List) -> int:\n    \"\"\"\n    Finds the sum of even numbers at even positions (0-based) in a list.\n    It checks if an element's index is even and if its value is an even integer, then accumulates matching values.\n    \"\"\"\n    result_accumulator = Result()\n    input_wrapper = InputList(lst)\n\n    for i in range(input_wrapper.length()):\n        element = input_wrapper.get(i)\n        if element.is_even_index() and element.is_even_value():\n            result_accumulator.add(element.value)\n\n    return result_accumulator.value()"}
{"task_id": "Mbpp/272", "solution": "import collections\nfrom typing import List, Any, Tuple\n\ndef rear_extract(input_list: List[Tuple[Any, ...]]) -> List[Any]:\n    \"\"\"rear_extract(input_list)\n\n    Parameters:\n        input_list (list): A list of tuples. Each element must be a tuple.\n\n    Returns:\n        list: A list containing the last element of each tuple in input_list, in the same order.\n\n    Raises:\n        TypeError: If input_list is not a list, or if any element in input_list is not a tuple.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('input must be a list')\n\n    result_list = []\n    for item in input_list:\n        if not isinstance(item, tuple):\n            raise TypeError('All elements in the input list must be tuples.')\n        result_list.append(item[-1])\n    return result_list"}
{"task_id": "Mbpp/273", "solution": "from typing import Tuple\n\ndef _validate_is_tuple(obj: object, name: str) -> None:\n    \"\"\"Validates if an object is a tuple.\"\"\"\n    if not isinstance(obj, tuple):\n        raise ValueError(f\"{name} must be a tuple\")\n\ndef _validate_tuple_elements_numeric(t: tuple, name: str) -> None:\n    \"\"\"Validates if all elements in a tuple are numeric (int or float).\"\"\"\n    for i, element in enumerate(t):\n        if not isinstance(element, (int, float)):\n            raise ValueError(f\"{name} contains non-numeric element at index {i}\")\n\ndef _validate_inputs(first: tuple, second: tuple) -> None:\n    \"\"\"Validates both input tuples for type, length, and numeric elements.\"\"\"\n    _validate_is_tuple(first, 'first')\n    _validate_is_tuple(second, 'second')\n\n    if len(first) != len(second):\n        raise ValueError(\"Input tuples must have equal length\")\n\n    _validate_tuple_elements_numeric(first, 'first')\n    _validate_tuple_elements_numeric(second, 'second')\n\ndef _compute_elementwise_subtraction(first: tuple, second: tuple) -> tuple:\n    \"\"\"Computes element-wise subtraction of two tuples.\"\"\"\n    return tuple(first[i] - second[i] for i in range(len(first)))\n\ndef substract_elements(first: tuple, second: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple element-wise.\n    Raises ValueError for invalid input types, unequal lengths, or non-numeric elements.\n    \"\"\"\n    _validate_inputs(first, second)\n    return _compute_elementwise_subtraction(first, second)"}
{"task_id": "Mbpp/274", "solution": "class InputValidator:\n    def is_positive_integer(self, n) -> bool:\n        \"\"\"\n        Checks if n is a positive integer.\n        \"\"\"\n        return isinstance(n, int) and n > 0\n\nclass BinomialCalculator:\n    def binomial(self, n: int, k: int) -> int:\n        \"\"\"\n        Computes the binomial coefficient C(n, k) using an iterative multiplicative approach.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    def sum_even_coeffs(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of binomial coefficients C(n, k) for all even k where 0 <= k <= n.\n        \"\"\"\n        total_sum = 0\n        for k in range(0, n + 1, 2):\n            total_sum += self.binomial(n, k)\n        return total_sum\n\nclass Result:\n    def __init__(self, value: int):\n        \"\"\"\n        Value object holding an integer result.\n        \"\"\"\n        self.value = value\n\nclass EvenBinomialFunction:\n    def even_binomial_Coeff_Sum(self, n: int) -> int:\n        \"\"\"\n        Orchestrates validation, computation, and result packaging for the sum of even-indexed binomial coefficients.\n        \"\"\"\n        validator = InputValidator()\n        if not validator.is_positive_integer(n):\n            raise ValueError(\"Input n must be a positive integer.\")\n\n        calculator = BinomialCalculator()\n        computed_sum = calculator.sum_even_coeffs(n)\n\n        result = Result(computed_sum)\n        return result.value\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of even index binomial coefficients for a positive integer n.\n    \"\"\"\n    orchestrator = EvenBinomialFunction()\n    return orchestrator.even_binomial_Coeff_Sum(n)"}
