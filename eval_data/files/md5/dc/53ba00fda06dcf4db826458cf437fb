{"task_id": "Mbpp/623", "solution": "def nth_nums(list_of_numbers, n):\n    \"\"\"Return a new list where each element equals the corresponding element\n    of list_of_numbers raised to the power n. Does not mutate list_of_numbers.\"\"\"\n    result_list = []\n    for number in list_of_numbers:\n        result_list.append(number ** n)\n    return result_list"}
{"task_id": "Mbpp/622", "solution": "from typing import List\n\nclass InputError(Exception):\n    \"\"\"Exception raised for invalid input conditions.\"\"\"\n    pass\n\ndef get_median(list1: List[int], list2: List[int], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    Assumes lists are sorted in non-decreasing order.\n    \"\"\"\n    if n <= 0:\n        raise InputError(\"n must be greater than 0.\")\n    if len(list1) != n or len(list2) != n:\n        raise InputError(f\"Size mismatch: len(list1) ({len(list1)}) and len(list2) ({len(list2)}) must both be equal to n ({n}).\")\n\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    median_val_1 = -1 # Stores the n-th smallest element\n    median_val_2 = -1 # Stores the (n+1)-th smallest element\n\n    # Iterate n+1 times to find the n-th and (n+1)-th smallest elements\n    for count in range(n + 1):\n        if i == n: # All elements in list1 are processed\n            median_val_1 = median_val_2\n            median_val_2 = list2[j]\n            j += 1\n        elif j == n: # All elements in list2 are processed\n            median_val_1 = median_val_2\n            median_val_2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]: # Compare elements from both lists\n            median_val_1 = median_val_2\n            median_val_2 = list1[i]\n            i += 1\n        else: # list2[j] < list1[i]\n            median_val_1 = median_val_2\n            median_val_2 = list2[j]\n            j += 1\n\n    return (median_val_1 + median_val_2) / 2.0"}
{"task_id": "Mbpp/620", "solution": "from typing import List, Dict, Set\n\n# Error message constant for input validation as per design\nERROR_MSG_INVALID_INPUT = \"Input 'nums' must be a list of integers.\"\n\nclass DivisibilityRelation:\n    \"\"\"Encapsulates the divisibility predicate with zero handling.\"\"\"\n    def isDivisible(self, a: int, b: int) -> bool:\n        \"\"\"\n        Returns True if a % b == 0 or b % a == 0, guarding against zero division.\n        Operations that would cause modulo-by-zero are treated as not-divisible.\n        \"\"\"\n        is_a_divisible_by_b = False\n        if b != 0:\n            is_a_divisible_by_b = (a % b == 0)\n        \n        is_b_divisible_by_a = False\n        if a != 0:\n            is_b_divisible_by_a = (b % a == 0)\n            \n        return is_a_divisible_by_b or is_b_divisible_by_a\n\nclass LargestSubsetCalculator:\n    \"\"\"Calculates the size of the largest pairwise divisible subset using dynamic programming.\"\"\"\n    def __init__(self, div_rel: DivisibilityRelation = None):\n        self.div_rel = div_rel if div_rel is not None else DivisibilityRelation()\n\n    def largest_subset(self, nums: List[int]) -> int:\n        \"\"\"\n        Public entry point to compute the size of the largest pairwise divisible subset.\n        Delegates to graph building and a longest path search (interpreted as max clique).\n        \"\"\"\n        if not nums:\n            return 0\n        \n        adj_graph, sorted_values = self._buildDivisibilityGraph(nums)\n        return self._searchMaxClique(adj_graph, sorted_values)\n\n    def _buildDivisibilityGraph(self, nums: List[int]) -> (Dict[int, Set[int]], List[int]):\n        \"\"\"\n        Builds a directed acyclic graph (DAG) where an edge from j to i exists\n        if sorted_values[j] is a valid predecessor for sorted_values[i] in a divisible chain.\n        Returns the graph as an adjacency list and the sorted numbers.\n        \"\"\"\n        sorted_values = sorted(nums)\n        adj_graph: Dict[int, Set[int]] = {i: set() for i in range(len(sorted_values))}\n\n        for i in range(len(sorted_values)):\n            for j in range(i):\n                if self.div_rel.isDivisible(sorted_values[i], sorted_values[j]):\n                    adj_graph[i].add(j)\n        \n        return adj_graph, sorted_values\n\n    def _searchMaxClique(self, graph: Dict[int, Set[int]], values: List[int]) -> int:\n        \"\"\"\n        Finds the size of the longest path in the constructed DAG, corresponding to the\n        longest divisible subsequence (interpreted as the \"maximum clique\" in this context).\n        \"\"\"\n        if not values:\n            return 0\n\n        # dp[i] stores the length of the longest divisible subsequence ending with values[i].\n        dp = [1] * len(values)\n\n        for i in range(len(values)):\n            for j in graph[i]: # Iterate over predecessors in the divisible chain\n                dp[i] = max(dp[i], 1 + dp[j])\n        \n        return max(dp)\n\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    Validates input type and delegates computation to LargestSubsetCalculator.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise ValueError(ERROR_MSG_INVALID_INPUT)\n    for x in nums:\n        if not isinstance(x, int):\n            raise ValueError(ERROR_MSG_INVALID_INPUT)\n\n    calculator = LargestSubsetCalculator()\n    return calculator.largest_subset(nums)"}
