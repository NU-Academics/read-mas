{"task_id": "Mbpp/92", "solution": "class IntegerInput:\n    \"\"\"Simple data holder for the integer to evaluate.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> int:\n        return self._value\n\nclass UndulatingPattern:\n    \"\"\"Validates whether a sequence of digits forms an undulating pattern.\"\"\"\n    def __init__(self, digit_a: str, digit_b: str) -> None:\n        self.digit_a = digit_a\n        self.digit_b = digit_b\n\n    def is_valid(self, digits: list[str]) -> bool:\n        \"\"\"\n        Checks if the provided digits alternate between digit_a and digit_b\n        and if digit_a and digit_b are distinct.\n        \"\"\"\n        if self.digit_a == self.digit_b:\n            return False\n\n        if len(digits) < 2:\n            return False\n\n        for i, digit in enumerate(digits):\n            if i % 2 == 0:\n                if digit != self.digit_a:\n                    return False\n            else:\n                if digit != self.digit_b:\n                    return False\n        return True\n\nclass UndulatingResult:\n    \"\"\"Encapsulates the boolean result.\"\"\"\n    def __init__(self, result: bool) -> None:\n        self._result = result\n\n    @property\n    def result(self) -> bool:\n        return self._result\n\nclass UndulatingChecker:\n    \"\"\"Orchestrates the evaluation of whether an integer is undulating.\"\"\"\n    def is_undulating(self, n: int) -> bool:\n        \"\"\"\n        Checks if the given integer n forms an undulating pattern.\n        \"\"\"\n        integer_input = IntegerInput(n)\n        s_n = str(integer_input.value)\n        digits = list(s_n)\n\n        if len(digits) < 2:\n            return False\n\n        digit_a = digits[0]\n        digit_b = digits[1]\n\n        pattern = UndulatingPattern(digit_a, digit_b)\n        is_undulating_bool = pattern.is_valid(digits)\n\n        undulating_result = UndulatingResult(is_undulating_bool)\n        return undulating_result.result\n\n\ndef is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating or not.\n    An undulating number has an alternating sequence of exactly two distinct digits.\n    \"\"\"\n    checker = UndulatingChecker()\n    return checker.is_undulating(n)"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(tuples: list[tuple]) -> object:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Returns None if the input list is empty.\n    \"\"\"\n    \n    min_first_value = None\n    min_second_value = None\n    \n    for current_tuple in tuples:\n        current_first = current_tuple[0]\n        current_second = current_tuple[1]\n\n        if min_second_value is None or current_second < min_second_value:\n            min_second_value = current_second\n            min_first_value = current_first\n            \n    return min_first_value"}
