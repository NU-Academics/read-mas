{"task_id": "Mbpp/306", "solution": "class Array:\n    \"\"\"Encapsulates the input array and provides its length.\"\"\"\n    def __init__(self, values: list[int]):\n        self.values = values\n\n    def length(self) -> int:\n        return len(self.values)\n\nclass Element:\n    \"\"\"Represents an array element with its index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass IndexValidator:\n    \"\"\"Validates if indices i and k are within bounds and k > i.\"\"\"\n    def validate(self, i: int, k: int, n: int) -> bool:\n        return 0 <= i < n and 0 <= k < n and k > i\n\nclass SubsequenceSelector:\n    \"\"\"Selects prefix elements and computes maximum increasing subsequence sums ending at each prefix index.\"\"\"\n    def __init__(self):\n        self.prefix_elements: list[Element] = []\n        self.dp_sums: list[int] = []\n\n    def select_prefix(self, arr_obj: Array, i: int):\n        self.prefix_elements = []\n        self.dp_sums = []\n\n        if i < 0:\n            return\n\n        for j in range(i + 1):\n            current_value = arr_obj.values[j]\n            self.prefix_elements.append(Element(j, current_value))\n\n            max_prev_sum = 0\n            for t in range(j):\n                if self.prefix_elements[t].value < current_value:\n                    max_prev_sum = max(max_prev_sum, self.dp_sums[t])\n\n            self.dp_sums.append(current_value + max_prev_sum)\n\n    def max_sum_prefix_ending_before(self, value: int) -> int:\n        \"\"\"Finds the maximum sum from `dp_sums` where the corresponding element's value is less than the given value.\"\"\"\n        max_sum_found = 0\n        for j in range(len(self.prefix_elements)):\n            if self.prefix_elements[j].value < value:\n                max_sum_found = max(max_sum_found, self.dp_sums[j])\n        return max_sum_found\n\nclass SumCalculator:\n    \"\"\"Computes the final maximum sum by adding the best prefix sum and the k-th element's value.\"\"\"\n    def compute_max_sum(self, best_prefix_sum: int, k_element_value: int) -> int:\n        return best_prefix_sum + k_element_value\n\nclass Result:\n    \"\"\"A container for the final sum, primarily for design representation.\"\"\"\n    def __init__(self, s: int):\n        self.sum = s\n\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i] followed by arr[k].\n    \"\"\"\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n\n    validator = IndexValidator()\n    if not validator.validate(i, k, n):\n        raise ValueError(\"Invalid indices: require 0 <= i < n, 0 <= k < n, and k > i\")\n\n    array_obj = Array(arr)\n\n    selector = SubsequenceSelector()\n    selector.select_prefix(array_obj, i)\n\n    best_prefix_sum = selector.max_sum_prefix_ending_before(arr[k])\n\n    sum_calculator = SumCalculator()\n    result_sum = sum_calculator.compute_max_sum(best_prefix_sum, arr[k])\n\n    return result_sum"}
{"task_id": "Mbpp/310", "solution": "__all__ = [\"string_to_tuple\"]\n\ndef string_to_tuple(input_string: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of characters, excluding ASCII spaces.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be of type str\")\n\n    if input_string == \"\":\n        return tuple()\n\n    return tuple(char for char in input_string if char != ' ')"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n):\n    \"\"\"\n    Returns the integer obtained by setting the most-significant (left-most) unset bit in n.\n    \"\"\"\n\n    def set_bit(num, position):\n        \"\"\"Returns integer num with bit at position set to 1.\"\"\"\n        return num | (1 << position)\n\n    def identify_leftmost_unset_bit(num):\n        \"\"\"\n        Returns bit position index (0-based LSB) of the left-most unset bit.\n        If none in current bit-width, return next higher position (highest-set-bit+1).\n        \"\"\"\n        msb_pos = num.bit_length() - 1\n\n        # Iterate from the highest bit position down to 0.\n        # For num=0, msb_pos is -1, so range(-1, -1, -1) is empty.\n        for pos in range(msb_pos, -1, -1):\n            if not ((num >> pos) & 1):  # If the bit at 'pos' is 0 (unset)\n                return pos\n        \n        # If all bits from msb_pos down to 0 are set,\n        # the left-most unset bit is the next position after the highest set bit.\n        # This covers num=0 where msb_pos is -1, loop doesn't run, and returns -1 + 1 = 0.\n        return msb_pos + 1\n\n    position_to_set = identify_leftmost_unset_bit(n)\n    return set_bit(n, position_to_set)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height):\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    The formula used is V = (pi * radius^2 * height) / 3.\n    \"\"\"\n    return (math.pi * radius**2 * height) / 3"}
{"task_id": "Mbpp/388", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\n\ndef highest_Power_of_2(n):\n    \"\"\"Validate n and return the largest power of two less than or equal to n.\n    Raises ValidationError for invalid inputs (non-int or n < 1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer\")\n    if n < 1:\n        raise ValidationError(\"n must be >= 1\")\n\n    # The expression 1 << (n.bit_length() - 1) calculates the highest power of 2\n    # that is less than or equal to n.\n    # For example, if n is 10 (binary 1010), n.bit_length() is 4.\n    # 4 - 1 = 3. 1 << 3 results in 8 (binary 1000).\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "class InputValidator:\n    @staticmethod\n    def is_non_negative_integer(value) -> bool:\n        \"\"\"Checks if a value is a non-negative integer.\"\"\"\n        return isinstance(value, int) and value >= 0\n\nclass LucasFunction:\n    def __init__(self):\n        \"\"\"Initializes the LucasFunction with a cache for base cases L0 and L1.\"\"\"\n        self._cache: dict[int, int] = {0: 2, 1: 1}\n\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Delegates to the iterative computation method.\"\"\"\n        return self.compute_iterative(n)\n\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Lucas number iteratively, storing intermediate results in a cache.\n        This O(n) algorithm efficiently builds up the sequence.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        # Initialize with L(0) and L(1) to begin the iteration for n >= 2.\n        lucas_prev2 = self._cache[0] # Corresponds to L(i-2)\n        lucas_prev1 = self._cache[1] # Corresponds to L(i-1)\n\n        # Iterate from the first number not yet in cache (L2) up to Ln.\n        for i in range(2, n + 1):\n            if i not in self._cache:\n                current_lucas = lucas_prev2 + lucas_prev1\n                self._cache[i] = current_lucas\n            else:\n                # If 'i' is already cached, retrieve its value.\n                current_lucas = self._cache[i]\n            \n            # Update the previous two values for the next iteration.\n            lucas_prev2 = lucas_prev1\n            lucas_prev1 = current_lucas\n        \n        return self._cache[n]\n\n    def compute_recursive(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Lucas number recursively with memoization.\n        This method is provided for completeness but not the default computation strategy.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        result = self.compute_recursive(n - 1) + self.compute_recursive(n - 2)\n        self._cache[n] = result\n        return result\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using zero-based indexing.\n    Validates input and computes the number using an iterative approach.\n    \"\"\"\n    if not InputValidator.is_non_negative_integer(n):\n        if not isinstance(n, int):\n            raise TypeError(f\"n must be int; got {type(n).__name__}\")\n        raise ValueError(\"n must be non-negative\")\n    return LucasFunction().find_lucas(n)"}
