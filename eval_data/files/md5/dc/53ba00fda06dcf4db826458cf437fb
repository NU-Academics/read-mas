{"task_id": "Mbpp/7", "solution": "from typing import List\n\ndef _split_whitespace(input: str) -> List[str]:\n    \"\"\"Splits the input string by whitespace characters.\"\"\"\n    return input.split()\n\ndef _is_long_enough(token: str) -> bool:\n    \"\"\"Checks if a token's length is at least 4 characters.\"\"\"\n    return len(token) >= 4\n\ndef find_char_long(input: str) -> List[str]:\n    \"\"\"\n    Finds all words (tokens) in a string that are at least 4 characters long.\n    Tokens are separated by whitespace, and original casing is preserved.\n    \"\"\"\n    tokens = _split_whitespace(input)\n    return [t for t in tokens if _is_long_enough(t)]"}
{"task_id": "Mbpp/9", "solution": "def rotate(s: str, k: int) -> str:\n    \"\"\"Return s[k:]+s[:k] (cyclic left shift)\"\"\"\n    return s[k:] + s[:k]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"Return minimal k in 1..len(s) where rotate(s,k)==s, else len(s)\"\"\"\n    n = len(s)\n    if n == 0:\n        return 0 # Or handle as per specific requirement for empty string. Design implies non-empty.\n\n    for k in range(1, n + 1):\n        rotated_s = rotate(s, k)\n        if rotated_s == s:\n            return k\n    return n # Should not be reached if the string itself is considered a rotation of length n, but for completeness."}
{"task_id": "Mbpp/2", "solution": "from typing import Sequence, List\n\ndef similar_elements(a: Sequence, b: Sequence) -> List:\n    \"\"\"\n    Compute unique shared elements between two sequences.\n\n    Returns a list containing each element present in both inputs, with duplicates removed.\n    \"\"\"\n    set_a = set(a)\n    common_elements_set = set()\n    for item in b:\n        if item in set_a:\n            common_elements_set.add(item)\n    return list(common_elements_set)"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Returns True for non-prime integers (including those less than 2), False for prime integers.\n    \"\"\"\n    if n < 2:\n        # Numbers less than 2 (0, 1, negative integers) are considered non-prime.\n        return True\n    elif n == 2:\n        # 2 is a prime number, so it is not non-prime.\n        return False\n    else:\n        # For numbers greater than 2, check for divisors up to the square root of n.\n        limit = int(math.isqrt(n))\n        for d in range(2, limit + 1):\n            if n % d == 0:\n                return True # Found a divisor, so n is not prime.\n        # No divisors found, so n is prime.\n        return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\nclass IntegerElement:\n    def __init__(self, value: int, occurrence_index: int) -> None:\n        \"\"\"\n        Initializes an IntegerElement with its value and a unique occurrence index.\n        The occurrence_index helps distinguish elements with the same value for stable comparisons.\n        \"\"\"\n        self.value = value\n        self.occurrence_index = occurrence_index\n\n    def __lt__(self, other):\n        \"\"\"\n        Compares two IntegerElement objects, primarily by value and then by occurrence_index.\n        This enables proper ordering within a heap.\n        \"\"\"\n        if not isinstance(other, IntegerElement):\n            return NotImplemented\n        if self.value != other.value:\n            return self.value < other.value\n        return self.occurrence_index < other.occurrence_index\n\n    def __gt__(self, other):\n        \"\"\"\n        Compares two IntegerElement objects for greater than, primarily by value.\n        \"\"\"\n        if not isinstance(other, IntegerElement):\n            return NotImplemented\n        if self.value != other.value:\n            return self.value > other.value\n        return self.occurrence_index > other.occurrence_index\n\n    def __eq__(self, other):\n        \"\"\"\n        Compares two IntegerElement objects for equality.\n        \"\"\"\n        if not isinstance(other, IntegerElement):\n            return NotImplemented\n        return self.value == other.value and self.occurrence_index == other.occurrence_index\n\n\nclass IntegerList:\n    def __init__(self, values: list[int]) -> None:\n        \"\"\"\n        Wraps a list of integers.\n        \"\"\"\n        self.values = values\n\nclass ResultList:\n    def __init__(self, values: list[int]) -> None:\n        \"\"\"\n        Wraps a list of integers intended as a result.\n        \"\"\"\n        self.values = values\n\nclass HeapQueueLargest:\n    def __init__(self, input_list: list[int], n: int) -> None:\n        \"\"\"\n        Initializes the worker with the input list and the number of largest elements to find.\n        \"\"\"\n        self.input_list = IntegerList(input_list)\n        self.n = n\n\n    def compute(self) -> list[int]:\n        \"\"\"\n        Computes the n largest integers from the input list, treating duplicates separately.\n        It uses a min-heap to efficiently track the largest elements and returns them sorted descending.\n        \"\"\"\n        if self.n <= 0:\n            return []\n        if not self.input_list.values:\n            return []\n\n        min_heap = []\n\n        for i, val in enumerate(self.input_list.values):\n            element = IntegerElement(val, i)\n\n            if len(min_heap) < self.n:\n                heapq.heappush(min_heap, element)\n            else:\n                # If current element is larger than the smallest in the heap, replace it.\n                if element > min_heap[0]:\n                    heapq.heapreplace(min_heap, element)\n\n        # Extract values from the heap.\n        result_values = [elem.value for elem in min_heap]\n\n        # Sort the extracted values in descending order as required.\n        result_values.sort(reverse=True)\n\n        return ResultList(result_values).values\n\ndef heap_queue_largest(input_list: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    It delegates the core logic to the HeapQueueLargest worker class.\n    \"\"\"\n    worker = HeapQueueLargest(input_list, n)\n    return worker.compute()"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Assumes valid string inputs and 'char' is a single character.\n    \"\"\"\n    first_index = input_string.find(char)\n\n    if first_index == -1:\n        return input_string\n\n    last_index = input_string.rfind(char)\n\n    if first_index == last_index:\n        # Only one occurrence of the character\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Two or more occurrences, remove first and last\n        return input_string[:first_index] + input_string[first_index + 1:last_index] + input_string[last_index + 1:]"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Represents a triangular prism and stores its dimensions.\"\"\"\n    def __init__(self, base: float, triangle_height: float, length: float) -> None:\n        self.base = float(base)\n        self.triangle_height = float(triangle_height)\n        self.length = float(length)\n\n    def calculate_volume(self) -> float:\n        \"\"\"Calculates the volume of the triangular prism using its dimensions.\"\"\"\n        return 0.5 * self.base * self.triangle_height * self.length\n\nclass VolumeResult:\n    \"\"\"A container for the numeric volume value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = float(value)\n\ndef find_Volume(base, triangle_height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    \"\"\"\n    prism = TriangularPrism(base, triangle_height, length)\n    volume_value = prism.calculate_volume()\n    return volume_value"}
