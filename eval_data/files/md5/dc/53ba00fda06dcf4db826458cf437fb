{"task_id": "Mbpp/732", "solution": "```python\ndef replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    Each special character is replaced by a single colon.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"replace_specialchar expects a str argument\")\n\n    result_chars = []\n    for char in input_string:\n        if char == ' ' or char == ',' or char == '.':\n            result_chars.append(':')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n```"}
{"task_id": "Mbpp/731", "solution": "import math\n\nPI = math.pi\n\ndef computeSlantHeight(r: float, h: float) -> float:\n    \"\"\"Calculates the slant height of a cone.\"\"\"\n    return math.sqrt(r*r + h*h)\n\ndef computeLateralSurfaceArea(r: float, l: float) -> float:\n    \"\"\"Calculates the lateral surface area using radius and slant height.\"\"\"\n    return PI * r * l\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    The lateral surface area is computed as \u03c0 * r * l, where l is the slant height.\n    \"\"\"\n    l = computeSlantHeight(r, h)\n    area = computeLateralSurfaceArea(r, l)\n    return area"}
{"task_id": "Mbpp/733", "solution": "from typing import Sequence, Any\n\ndef find_first_occurrence(arr: Sequence[Any], target: Any) -> int:\n    \"\"\"Return 0-based index of first occurrence of target in sorted arr or -1 if not present.\"\"\"\n    if not arr:\n        return -1\n\n    low = 0\n    high = len(arr) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    \n    if low < len(arr) and arr[low] == target:\n        return low\n    else:\n        return -1"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n    Returns the number unchanged if it has fewer than three bits.\n    \"\"\"\n    def _generate_middle_mask(num: int) -> int:\n        \"\"\"\n        Generates a mask with 1s set for all middle bit positions (1 to bit_length-2).\n        Returns 0 if the number has fewer than three bits.\n        \"\"\"\n        bit_length = num.bit_length()\n        if bit_length < 3:\n            return 0\n        # Create a mask of (bit_length - 2) ones, starting from position 1.\n        # Example: for bit_length=4, we need 1s at positions 1 and 2 (0110).\n        # (1 << (bit_length - 2)) - 1 creates a sequence of (bit_length - 2) ones (e.g., for bit_length=4, this is (1<<2)-1 = 3, binary 0011).\n        # Shifting it left by 1 places these ones at positions 1 to bit_length-2 (e.g., 3 << 1 = 6, binary 0110).\n        mask = ((1 << (bit_length - 2)) - 1) << 1\n        return mask\n\n    bit_length = n.bit_length()\n    if bit_length < 3:\n        return n\n    \n    mask = _generate_middle_mask(n)\n    return n ^ mask"}
{"task_id": "Mbpp/734", "solution": "import math\n\nclass Result:\n    \"\"\"DTO for numeric result.\"\"\"\n    def __init__(self, value: float = 0.0) -> None:\n        self.value = value\n\nclass InputArray:\n    \"\"\"Encapsulate input list (validation skipped per output constraints).\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\n    def validate(self) -> None:\n        \"\"\"This method is a no-op as per specific output constraints (Do NOT add isinstance() checks or raise exceptions).\"\"\"\n        pass\n\nclass Subarray:\n    \"\"\"Represent a contiguous slice and compute its product.\"\"\"\n    def __init__(self, start: int, end: int, elements: list) -> None:\n        self.start = start\n        self.end = end\n        self.elements = elements[start:end]\n\n    def computeProduct(self) -> float:\n        \"\"\"Computes the product of elements in the subarray.\"\"\"\n        return float(math.prod(self.elements))\n\nclass ProductCalculator:\n    \"\"\"Core algorithm: generate contiguous Subarray instances, compute products, accumulate sum, produce Result.\"\"\"\n    def __init__(self, input_array: InputArray) -> None:\n        self.input_array = input_array\n        self.result = Result()\n\n    def generateSubarrays(self) -> list:\n        \"\"\"Generates all contiguous subarrays from the input array.\"\"\"\n        subarrays = []\n        n = self.input_array.length\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                subarrays.append(Subarray(i, j, self.input_array.elements))\n        return subarrays\n\n    def accumulateProducts(self, subarrays: list) -> float:\n        \"\"\"Accumulates the sum of products of all given subarrays.\"\"\"\n        total_sum_of_products = 0.0\n        for subarray in subarrays:\n            total_sum_of_products += subarray.computeProduct()\n        return total_sum_of_products\n\n    def sumOfSubarrayProd(self, arr: list) -> float:\n        \"\"\"Orchestrates generation and accumulation of subarray products.\"\"\"\n        # The 'arr' parameter is ignored here as the calculator uses its internal input_array\n        generated_subarrays = self.generateSubarrays()\n        self.result.value = self.accumulateProducts(generated_subarrays)\n        return self.result.value\n\ndef sum_Of_Subarray_Prod(arr: list) -> float:\n    \"\"\"\n    Finds the sum of products of all possible sublists (contiguous subarrays) of a given list.\n    Validation is skipped as per output constraints.\n    \"\"\"\n    input_array = InputArray(arr)\n    # input_array.validate() # This call is omitted as per output constraints\n\n    calculator = ProductCalculator(input_array)\n    total_sum = calculator.sumOfSubarrayProd(arr)\n    \n    return total_sum"}
