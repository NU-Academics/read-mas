{"task_id": "Mbpp/474", "solution": "from typing import dataclass\n\nclass ValidationError(Exception):\n    \"\"\"Domain-level exception for validation errors.\"\"\"\n    pass\n\n@dataclass\nclass InputParameters:\n    \"\"\"A dataclass-like container for input parameters.\"\"\"\n    original: str\n    old_char: str\n    new_char: str\n\nclass Validator:\n    \"\"\"Handles input validation for replace_char.\"\"\"\n    def validate_types(self, original: str, old_char: str, new_char: str) -> None:\n        \"\"\"Raises TypeError if inputs are not strings.\"\"\"\n        if not isinstance(original, str):\n            raise TypeError(\"Original must be a string.\")\n        if not isinstance(old_char, str):\n            raise TypeError(\"Old character must be a string.\")\n        if not isinstance(new_char, str):\n            raise TypeError(\"New character must be a string.\")\n\n    def validate_char_length(self, c: str) -> None:\n        \"\"\"Raises ValueError if character length is not 1.\"\"\"\n        if len(c) != 1:\n            raise ValueError(\"Old and new characters must be single-character strings.\")\n\nclass StringProcessor:\n    \"\"\"Performs the exact-match, case-sensitive character replacement.\"\"\"\n    def replace_exact(self, original: str, old_char: str, new_char: str) -> str:\n        \"\"\"Replaces all occurrences of old_char with new_char in original.\"\"\"\n        if original == \"\":\n            return \"\"\n        if old_char == new_char:\n            return original\n        if old_char not in original:\n            return original\n        return original.replace(old_char, new_char)\n\ndef replace_char(original: str, old_char: str, new_char: str) -> str:\n    \"\"\"\n    Replaces all occurrences of old_char with new_char in the original string.\n    Inputs are validated for type and length before replacement.\n    \"\"\"\n    validator = Validator()\n    processor = StringProcessor()\n\n    validator.validate_types(original, old_char, new_char)\n    validator.validate_char_length(old_char)\n    validator.validate_char_length(new_char)\n\n    return processor.replace_exact(original, old_char, new_char)"}
{"task_id": "Mbpp/478", "solution": "class Character:\n    \"\"\"Helper class to encapsulate a character and check its case.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isLowercase(self) -> bool:\n        \"\"\"Returns True if the character is an ASCII lowercase letter ('a' through 'z').\"\"\"\n        return 'a' <= self.value <= 'z'\n\ndef remove_lowercase(input_string: str) -> str:\n    \"\"\"Removes all ASCII lowercase alphabetical characters from the input string.\"\"\"\n    filtered_chars = []\n    for char_value in input_string:\n        char_obj = Character(char_value)\n        if not char_obj.isLowercase():\n            filtered_chars.append(char_value)\n    return \"\".join(filtered_chars)"}
