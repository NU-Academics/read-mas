{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are integers >= 1.\n    \"\"\"\n    total_sum = 0\n    start = max(1, l)\n\n    for num in range(start, r + 1):\n        if num % 2 == 1:\n            total_sum += num\n            \n    return total_sum"}
{"task_id": "Mbpp/798", "solution": "def _is_numeric(value):\n    \"\"\"Checks if a value is an instance of int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _sum(numbers):\n    \"\"\"\n    Calculates the sum of numbers in a list, validating that all elements are numeric.\n    Raises TypeError if input is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n\n    total = 0\n    for number in numbers:\n        if not _is_numeric(number):\n            raise TypeError(\"All elements of 'numbers' must be int or float\")\n        total += number\n    return total"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number `n` left by `d` positions.\n    Input `n` and the result are masked to 32 bits, and `d` is normalized modulo 32.\n    \"\"\"\n    \n    # Mask input n to its lower 32 bits (FR2 / BR1).\n    n_masked = n & 0xFFFFFFFF \n    \n    # Normalize rotation distance d to be within 0-31 (FR3 / BR2).\n    d_norm = d % 32\n    \n    # Perform the 32-bit left circular shift (BR3).\n    # This involves shifting left and combining with bits shifted out from the right.\n    rotated = (n_masked << d_norm) | (n_masked >> (32 - d_norm))\n    \n    # Mask the final result to ensure it stays within 32 bits (FR4 / BR4).\n    final_result = rotated & 0xFFFFFFFF\n\n    return final_result"}
