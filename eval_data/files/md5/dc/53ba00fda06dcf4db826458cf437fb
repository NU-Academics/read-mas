{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    # Compute base**power using Python's arbitrary-precision integers.\n    result_value = base ** power\n    \n    # Convert the large integer to its decimal string representation.\n    decimal_string = str(result_value)\n    \n    # Sum the digits by converting each character in the string to an integer.\n    digit_sum = sum(int(digit_char) for digit_char in decimal_string)\n    \n    return digit_sum"}
{"task_id": "Mbpp/722", "solution": "class Student:\n    \"\"\"Domain entity representing a student with name, height, and weight.\"\"\"\n    def __init__(self, name: str, height: float, weight: float):\n        self.name = name\n        self.height = float(height)\n        self.weight = float(weight)\n\nclass FilterCriteria:\n    \"\"\"Value object holding the minimum height and weight thresholds.\"\"\"\n    def __init__(self, min_height: float, min_weight: float):\n        self.min_height = float(min_height)\n        self.min_weight = float(min_weight)\n\nclass StudentRepository:\n    \"\"\"Adapts an input dictionary into Student objects.\"\"\"\n    def __init__(self, students: dict):\n        self._students = students\n\n    def get_all(self) -> list:\n        \"\"\"Converts stored student data into a list of Student objects.\"\"\"\n        student_objects = []\n        for name, (height, weight) in self._students.items():\n            student_objects.append(Student(name, height, weight))\n        return student_objects\n\nclass FilterService:\n    \"\"\"Encapsulates the filtering logic.\"\"\"\n    def filter_data(self, data, min_height, min_weight):\n        filter_criteria = FilterCriteria(min_height, min_weight)\n        repository = StudentRepository(data)\n        all_students = repository.get_all()\n\n        filtered_results = {}\n        for student in all_students:\n            if student.height >= filter_criteria.min_height and \\\n               student.weight >= filter_criteria.min_weight:\n                # Preserve the original tuple from the input data\n                filtered_results[student.name] = data[student.name]\n        return filtered_results\n\ndef filter_data(data, min_height, min_weight):\n    \"\"\"\n    Filters students based on height and weight above minimum thresholds.\n    Delegates to FilterService for filtering logic.\n    \"\"\"\n    service = FilterService()\n    return service.filter_data(data, min_height, min_weight)"}
