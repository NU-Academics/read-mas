{"task_id": "Mbpp/626", "solution": "class InputValidator:\n    def is_numeric(self, radius) -> bool:\n        \"\"\"Returns True if radius is an instance of int or float.\"\"\"\n        return isinstance(radius, (int, float))\n\n    def is_non_negative(self, radius) -> bool:\n        \"\"\"Returns True if radius is non-negative.\"\"\"\n        return radius >= 0\n\nclass Radius:\n    def __init__(self, value: float):\n        \"\"\"Initializes Radius with a float value.\"\"\"\n        self.value = float(value)\n\n    def as_float(self) -> float:\n        \"\"\"Returns the radius value as a float.\"\"\"\n        return self.value\n\nclass Triangle:\n    def __init__(self, base: float, height: float):\n        \"\"\"Initializes Triangle with base and height.\"\"\"\n        self._base = float(base)\n        self._height = float(height)\n\n    def area(self) -> float:\n        \"\"\"Calculates the area of the triangle.\"\"\"\n        return (self._base * self._height) / 2.0\n\nclass Result:\n    def __init__(self, value: float | None, status: str = ''):\n        \"\"\"Initializes Result with a value and an optional status.\"\"\"\n        self.value = value\n        self.status = status\n\nclass TriangleAreaService:\n    def __init__(self, validator: InputValidator = None):\n        \"\"\"Initializes the service with an InputValidator.\"\"\"\n        self._validator = validator if validator is not None else InputValidator()\n\n    def triangle_area(self, radius):\n        \"\"\"\n        Computes the area of the largest triangle in a semicircle.\n        Returns None for negative radius, otherwise returns radius * radius.\n        \"\"\"\n        if not self._validator.is_non_negative(radius):\n            return None\n        else:\n            return radius * radius\n\ndef triangle_area(radius):\n    \"\"\"\n    Finds the area of the largest triangle that can be inscribed in a semicircle with a given radius.\n    \"\"\"\n    service = TriangleAreaService()\n    return service.triangle_area(radius)"}
