{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"Compute and return the smallest numeric value from the provided iterable of numbers.\n    Behavior for empty iterables follows Python's built-in min() semantics (raises ValueError).\n    \"\"\"\n    return min(numbers)"}
{"task_id": "Mbpp/61", "solution": "class InputString:\n    \"\"\"Represents the full input string and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def __len__(self) -> int:\n        return self.length\n\nclass Substring:\n    \"\"\"Represents a contiguous substring and computes its digit sum.\"\"\"\n    def __init__(self, value: str, start_index: int, end_index: int) -> None:\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\n        self.length = len(value)\n\n    def digit_sum(self) -> int:\n        \"\"\"Calculates the sum of digits in the substring's value.\"\"\"\n        return sum(int(char) for char in self.value)\n\nclass Result:\n    \"\"\"Aggregates and holds the count of matching substrings.\"\"\"\n    def __init__(self, count: int = 0) -> None:\n        self.count = count\n\n    def increment(self, n: int = 1) -> None:\n        \"\"\"Increments the internal count.\"\"\"\n        self.count += n\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals the substring's length.\n    Assumes input_string contains only digit characters.\n    \"\"\"\n    input_str_obj = InputString(input_string)\n    n = input_str_obj.length\n    result = Result()\n\n    for i in range(n):\n        for j in range(i, n):\n            current_value = input_string[i:j+1]\n            substring_obj = Substring(value=current_value, start_index=i, end_index=j)\n            \n            s = substring_obj.digit_sum()\n            \n            if s == substring_obj.length:\n                result.increment()\n    \n    return result.count"}
{"task_id": "Mbpp/64", "solution": "def _score_key(item):\n    \"\"\"\n    Extracts the numeric score from a tuple for sorting.\n    \"\"\"\n    return item[1]\n\ndef _validate_input(subject_score_list):\n    \"\"\"\n    Validates the input list of subject-score tuples, raising TypeError or ValueError on invalid input.\n    \"\"\"\n    if not isinstance(subject_score_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for i, item in enumerate(subject_score_list):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} must be a tuple, got {type(item).__name__}.\")\n        if len(item) != 2:\n            raise ValueError(f\"Tuple at index {i} must have exactly 2 elements, got {len(item)}.\")\n        if not isinstance(item[0], str):\n            raise TypeError(f\"Subject name at index {i} must be string-like, got {type(item[0]).__name__}.\")\n        if not isinstance(item[1], (int, float)):\n            raise TypeError(f\"Score at index {i} must be numeric (int or float), got {type(item[1]).__name__}.\")\n\ndef subject_marks(subject_score_list):\n    \"\"\"\n    Sorts a list of tuples by the second value (score) in ascending order.\n    \"\"\"\n    _validate_input(subject_score_list)\n    return sorted(subject_score_list, key=_score_key)"}
{"task_id": "Mbpp/57", "solution": "class Validator:\n    \"\"\"Validation component to enforce digits are integers in 0..9.\"\"\"\n    @staticmethod\n    def validate_digits(digits: list[int]) -> None:\n        \"\"\"Validates each element is an integer between 0 and 9, raising ValueError for invalid elements.\"\"\"\n        if not isinstance(digits, list):\n            raise ValueError(\"Input must be a list of digits.\")\n        for digit in digits:\n            if not isinstance(digit, int) or not (0 <= digit <= 9):\n                raise ValueError(\n                    f\"Invalid digit '{digit}'. Digits must be integers between 0 and 9 (inclusive).\"\n                )\n\nclass Sorter:\n    \"\"\"Sorting component to produce a descending-ordered list of digits.\"\"\"\n    @staticmethod\n    def sort_desc(digits: list[int]) -> list[int]:\n        \"\"\"Sorts a list of digits in descending order, preserving multiplicity.\"\"\"\n        return sorted(digits, reverse=True)\n\nclass NumberBuilder:\n    \"\"\"Number-building component to concatenate digit decimal representations into an int.\"\"\"\n    @staticmethod\n    def concatenate(digits: list[int]) -> int:\n        \"\"\"Concatenates decimal representations of digits into a single integer.\"\"\"\n        return int(\"\".join(str(d) for d in digits))\n\nclass Digit:\n    \"\"\"Lightweight value object representing a single digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass DigitList:\n    \"\"\"Aggregate holding digits and delegating validation, sorting, and number building.\"\"\"\n    def __init__(self, digits: list[int]):\n        self.digits = digits\n\n    def validate(self) -> None:\n        \"\"\"Delegates validation to the Validator component.\"\"\"\n        Validator.validate_digits(self.digits)\n\n    def sort_desc(self) -> list[int]:\n        \"\"\"Delegates sorting to the Sorter component.\"\"\"\n        return Sorter.sort_desc(self.digits)\n\n    def build_number(self) -> int:\n        \"\"\"Sorts the digits and then delegates concatenation to the NumberBuilder component.\"\"\"\n        sorted_digits = self.sort_desc()\n        return NumberBuilder.concatenate(sorted_digits)\n\nclass ResultNumber:\n    \"\"\"Wrapper holding the final integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    This function orchestrates validation, sorting, and number building using domain components.\n    \"\"\"\n    dl = DigitList(digits)\n    dl.validate()\n    result = dl.build_number()\n    return result"}
{"task_id": "Mbpp/63", "solution": "def max_difference(list_of_pairs):\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in a given list of tuples.\n    Raises ValueError for invalid input or an empty input list.\n    \"\"\"\n\n    def _validate_input(data):\n        \"\"\"Validates that the input is a list of 2-element integer tuples.\"\"\"\n        if not isinstance(data, list):\n            raise ValueError(\"Input must be a list.\")\n        if not data:\n            raise ValueError(\"Input list cannot be empty.\")\n        for i, pair in enumerate(data):\n            if not isinstance(pair, tuple) or len(pair) != 2:\n                raise ValueError(f\"Element at index {i} must be a 2-element tuple.\")\n            if not isinstance(pair[0], int) or not isinstance(pair[1], int):\n                raise ValueError(f\"Elements of tuple at index {i} must be integers.\")\n\n    def _compute_abs(pair):\n        \"\"\"Computes the absolute difference between the two numbers in a tuple.\"\"\"\n        a, b = pair\n        return abs(a - b)\n\n    def _find_max(differences):\n        \"\"\"Finds the maximum value in a list of differences.\"\"\"\n        if not differences:\n            # This case should ideally not be reached if _validate_input correctly handled an empty input list.\n            raise ValueError(\"Differences list cannot be empty.\")\n        return max(differences)\n\n    _validate_input(list_of_pairs)\n    differences = [_compute_abs(pair) for pair in list_of_pairs]\n    return _find_max(differences)"}
{"task_id": "Mbpp/59", "solution": "class InputParameter:\n    \"\"\"Lightweight wrapper for input n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\nclass OutputValue:\n    \"\"\"Lightweight wrapper for output value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Formula:\n    \"\"\"Encapsulates the octagonal number formula expression and evaluates it.\"\"\"\n    def __init__(self, expression: str):\n        self.expression = expression\n\n    def evaluate(self, n: int) -> int:\n        \"\"\"Evaluates the formula 3*n^2 - 2*n.\"\"\"\n        return 3 * n * n - 2 * n\n\nclass OctagonalNumber:\n    \"\"\"Data holder for n and its computed octagonal value.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value = None\n\n    def compute(self, formula: Formula) -> None:\n        \"\"\"Uses formula.evaluate to set the octagonal value.\"\"\"\n        self.value = formula.evaluate(self.n)\n\nclass IsOctagonalFunction:\n    \"\"\"Validates input and computes nth octagonal number using Formula.\"\"\"\n    def __init__(self):\n        self._formula = Formula(expression=\"3*n^2 - 2*n\")\n\n    def validateInput(self, n) -> bool:\n        \"\"\"Returns True if n is an integer, False otherwise.\"\"\"\n        return isinstance(n, int)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth octagonal number, raising TypeError for invalid input.\"\"\"\n        if not self.validateInput(n):\n            raise TypeError(\"n must be integer\")\n        \n        octn = OctagonalNumber(n)\n        octn.compute(self._formula)\n        return octn.value\n\ndef is_octagonal(n) -> int:\n    \"\"\"\n    Computes the nth octagonal number.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    f = IsOctagonalFunction()\n    return f.compute(n)"}
{"task_id": "Mbpp/65", "solution": "def _traverse_and_sum(item: object) -> int:\n    \"\"\"\n    Recursively traverses an item, summing integers found within it or its sub-lists.\n    Non-integer, non-list items contribute 0 to the sum.\n    \"\"\"\n    current_item_sum = 0\n    if isinstance(item, int):\n        current_item_sum += item\n    elif isinstance(item, list):\n        for sub_item in item:\n            current_item_sum += _traverse_and_sum(sub_item)\n    return current_item_sum\n\ndef recursive_list_sum(input_list: list) -> int:\n    \"\"\"\n    Flattens a list, potentially containing nested lists, and sums all its integer elements.\n    \"\"\"\n    return _traverse_and_sum(input_list)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list) -> bool:\n    \"\"\"Return True iff sub_list appears as a contiguous subsequence in main_list.\n\n    Behavior per design:\n    - If len(sub_list) > len(main_list) return False immediately.\n    - Compare elements using == for equality.\n    - Return True if any contiguous window equals sub_list; otherwise return False.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_main:\n        return False\n    \n    if len_sub == 0:\n        return True # An empty list is always a sublist\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/68", "solution": "from typing import List\n\ndef is_Monotonic(lst: List) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (entirely non-increasing or non-decreasing).\n    Adjacent equal elements are allowed.\n    \"\"\"\n    n = len(lst)\n\n    if n <= 1:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n\n    for i in range(1, n):\n        if lst[i] < lst[i-1]:\n            non_decreasing = False\n        if lst[i] > lst[i-1]:\n            non_increasing = False\n            \n    return non_decreasing or non_increasing"}
{"task_id": "Mbpp/66", "solution": "def pos_count(input_list):\n    \"\"\"Return the count of items strictly greater than 0 in input_list.\n    Does not modify input_list.\"\"\"\n    count = 0\n    for number in input_list:\n        if number > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple, Any\n\ndef validate_input(list_of_tuples: Any) -> bool:\n    \"\"\"Validates if the input is a list and all its elements are tuples.\"\"\"\n    if not isinstance(list_of_tuples, list):\n        return False\n    for item in list_of_tuples:\n        if not isinstance(item, tuple):\n            return False\n    return True\n\ndef compute_lengths(list_of_tuples: List[Tuple[Any, ...]]) -> List[int]:\n    \"\"\"Computes the lengths of all tuples in the given list.\"\"\"\n    lengths = []\n    for tup in list_of_tuples:\n        lengths.append(len(tup))\n    return lengths\n\ndef compare_lengths(lengths: List[int]) -> bool:\n    \"\"\"Checks if all integers in the list of lengths are equal.\"\"\"\n    if not lengths:\n        return True\n    return len(set(lengths)) == 1\n\ndef get_equal(list_of_tuples: List[Tuple[Any, ...]]) -> bool:\n    \"\"\"Checks if all given tuples have equal length.\"\"\"\n    if not validate_input(list_of_tuples):\n        return False\n\n    lengths = compute_lengths(list_of_tuples)\n    return compare_lengths(lengths)"}
{"task_id": "Mbpp/72", "solution": "def _validate_type(n):\n    \"\"\"\n    Validates if the input is an integer.\n    Raises TypeError if the input is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"dif_Square: input must be int\")\n\ndef _is_representable(n):\n    \"\"\"\n    Checks if a number can be represented as the difference of two squares.\n    This is true for any integer not of the form 4k + 2.\n    \"\"\"\n    return (n % 4) != 2\n\ndef dif_Square(n):\n    \"\"\"\n    Checks if the given number can be represented as the difference of two squares.\n    This function performs type validation and then applies a modular arithmetic rule.\n    \"\"\"\n    _validate_type(n)\n    return _is_representable(n)"}
{"task_id": "Mbpp/67", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input type.\"\"\"\n    def __init__(self, message: str = \"Invalid input: n must be integer\"):\n        super().__init__(message)\n\nclass NegativeInputError(Exception):\n    \"\"\"Exception raised for negative input value.\"\"\"\n    def __init__(self, message: str = \"Invalid input: n must be >= 0\"):\n        super().__init__(message)\n\nclass InputParameter:\n    \"\"\"Encapsulates input validation logic.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def isInteger(self) -> bool:\n        \"\"\"Checks if the input is an integer.\"\"\"\n        return type(self.n) is int\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if the input is non-negative.\"\"\"\n        return self.n >= 0\n\nclass Result:\n    \"\"\"Wrapper for computed integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass IntegerArithmetic:\n    \"\"\"Provides arbitrary-precision integer arithmetic operations.\"\"\"\n    @staticmethod\n    def add(a: int, b: int) -> int:\n        \"\"\"Adds two arbitrary-precision integers.\"\"\"\n        return a + b\n\n    @staticmethod\n    def mul(a: int, b: int) -> int:\n        \"\"\"Multiplies two arbitrary-precision integers.\"\"\"\n        return a * b\n\n    @staticmethod\n    def factorial(n: int) -> int:\n        \"\"\"Computes factorial for a non-negative integer.\"\"\"\n        if n == 0:\n            return 1\n        res = 1\n        for i in range(1, n + 1):\n            res = IntegerArithmetic.mul(res, i)\n        return res\n\n    @staticmethod\n    def combinations(n: int, k: int) -> int:\n        \"\"\"Computes n choose k (binomial coefficient).\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        num = IntegerArithmetic.factorial(n)\n        den = IntegerArithmetic.mul(IntegerArithmetic.factorial(k), IntegerArithmetic.factorial(n - k))\n        return num // den\n\nclass BellNumberCalculator:\n    \"\"\"Calculates Bell numbers with input validation and memoization.\"\"\"\n    def __init__(self):\n        self._cache: dict[int, int] = {0: 1} # Base case B_0 = 1\n\n    def validateInput(self, n: int) -> None:\n        \"\"\"Validates the input parameter n.\"\"\"\n        param = InputParameter(n)\n        if not param.isInteger():\n            raise InvalidInputError()\n        if not param.isNonNegative():\n            raise NegativeInputError()\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the Bell number for n using the recurrence relation and memoization.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        # Recurrence relation: B_n = sum_{k=0 to n-1} (n-1 choose k) * B_k for n >= 1\n        bell_n = 0\n        for k in range(n):\n            combinations_val = IntegerArithmetic.combinations(n - 1, k)\n            bell_k = self.compute(k)\n            term = IntegerArithmetic.mul(combinations_val, bell_k)\n            bell_n = IntegerArithmetic.add(bell_n, term)\n        \n        self._cache[n] = bell_n\n        return bell_n\n\n_bell_calculator = BellNumberCalculator()\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Finds the number of ways to partition a set of size n, which is the nth Bell number.\n    This function computes the nth Bell number, validating input and using memoization.\n    \"\"\"\n    _bell_calculator.validateInput(n)\n    value = _bell_calculator.compute(n)\n    return Result(value).value"}
{"task_id": "Mbpp/71", "solution": "from typing import List, Any\n\nclass CombSort:\n    \"\"\"\n    Encapsulates the Comb Sort algorithm state and mechanics.\n    \"\"\"\n    def __init__(self) -> None:\n        self._gap: int = 0\n        self._shrink_factor: float = 1.3\n        self._swapped: bool = False\n\n    def initialize(self, n: int) -> None:\n        \"\"\"Initializes the gap and swapped flag for a new sort operation.\"\"\"\n        self._gap = n\n        self._swapped = True\n\n    def sort(self, lst: List[Any]) -> List[Any]:\n        \"\"\"\n        Performs Comb Sort on the provided list and returns a sorted copy.\n        The algorithm state (`_gap`, `_swapped`) must be initialized before calling.\n        \"\"\"\n        arr = lst[:]  # Work on a copy to fulfill return requirements\n        n = len(arr)\n\n        while self._gap > 1 or self._swapped:\n            if self._gap > 1:\n                self._gap = int(self._gap / self._shrink_factor)\n                if self._gap < 1:  # Ensure gap does not go to zero\n                    self._gap = 1\n\n            self._swapped = False\n            for i in range(n - self._gap):\n                if arr[i] > arr[i + self._gap]:\n                    arr[i], arr[i + self._gap] = arr[i + self._gap], arr[i]\n                    self._swapped = True\n        return arr\n\ndef comb_sort(lst: List[Any]) -> List[Any]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm in ascending order.\n    Returns a new list with the sorted elements.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorter = CombSort()\n    sorter.initialize(len(lst))\n    sorted_list = sorter.sort(lst)\n    return sorted_list"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Any, Dict\n\nclass Element:\n    def __init__(self, value: Any) -> None:\n        self.value = value\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self.value == other.value\n    def __hash__(self) -> int:\n        return hash(self.value)\n\nclass Token:\n    def __init__(self, symbol: Any) -> None:\n        self.symbol = symbol\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Token):\n            return NotImplemented\n        return self.symbol == other.symbol\n    def __hash__(self) -> int:\n        return hash(self.symbol)\n\nclass Sequence:\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = [Element(e) for e in elements]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get(self, i: int) -> 'Element':\n        return self.elements[i]\n\nclass Pattern:\n    def __init__(self, tokens: List[Any]) -> None:\n        self.tokens = [Token(t) for t in tokens]\n\n    def length(self) -> int:\n        return len(self.tokens)\n\n    def get(self, i: int) -> 'Token':\n        return self.tokens[i]\n\nclass ComparisonResult:\n    def __init__(self, matches: bool, reason: str = \"\") -> None:\n        self.matches = matches\n        self.reason = reason\n\nclass Mapping:\n    def __init__(self, tokenToElement: Dict[Any, Any]) -> None:\n        \"\"\"\n        Initializes the Mapping with a dictionary mapping Token objects to Element objects.\n        \"\"\"\n        self.tokenToElement = tokenToElement\n\n    def isConsistent(self) -> bool:\n        \"\"\"\n        Checks if the mapping is consistent.\n        Since PatternMapper.mapTokensToElements already performs the full consistency check,\n        this method primarily verifies that a valid, non-empty mapping was established.\n        \"\"\"\n        return bool(self.tokenToElement)\n\nclass PatternMapper:\n    def equivalenceClasses(self, lst: List[Any]) -> Dict[Any, int]:\n        \"\"\"\n        Computes equivalence classes for a list of Element or Token objects.\n        Each unique object is mapped to a unique integer ID based on its appearance order.\n        \"\"\"\n        eq_map: Dict[Any, int] = {}\n        next_id = 0\n        for item in lst:\n            if item not in eq_map:\n                eq_map[item] = next_id\n                next_id += 1\n        return eq_map\n\n    def mapTokensToElements(self, pattern: Pattern, sequence: Sequence) -> 'Mapping':\n        \"\"\"\n        Builds a consistent one-to-one mapping from pattern tokens to sequence elements.\n        It checks for consistency in both directions during construction.\n        \"\"\"\n        token_to_element_map: Dict[Token, Element] = {} # Maps Token objects to Element objects\n        element_to_token_map: Dict[Element, Token] = {} # Maps Element objects to Token objects (reverse map)\n\n        for i in range(pattern.length()):\n            token = pattern.get(i)\n            element = sequence.get(i)\n\n            # Check consistency for token -> element mapping\n            if token in token_to_element_map:\n                if token_to_element_map[token] != element:\n                    # Inconsistency: same token maps to different elements\n                    return Mapping({}) # Return an empty mapping to indicate failure\n            else:\n                token_to_element_map[token] = element\n\n            # Check consistency for element -> token (reverse) mapping\n            if element in element_to_token_map:\n                if element_to_token_map[element] != token:\n                    # Inconsistency: same element maps to different tokens\n                    return Mapping({}) # Return an empty mapping to indicate failure\n            else:\n                element_to_token_map[element] = token\n\n        return Mapping(token_to_element_map)\n\ndef is_samepatterns(sequence: List[Any], pattern: List[Any]) -> bool:\n    \"\"\"\n    Checks if a sequence follows the given pattern by comparing their equivalence classes.\n    Returns True if consistent, False otherwise.\n    \"\"\"\n    if len(sequence) != len(pattern):\n        return False\n\n    sequence_obj = Sequence(sequence)\n    pattern_obj = Pattern(pattern)\n\n    mapper = PatternMapper()\n    mapping = mapper.mapTokensToElements(pattern_obj, sequence_obj)\n    \n    return mapping.isConsistent()"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    Returns a new list containing only the matching tuples, preserving their original order.\n    \"\"\"\n    result = []\n    for t in list_of_tuples:\n        if all(e % k == 0 for e in t):\n            result.append(t)\n    return result"}
