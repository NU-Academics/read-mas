{"task_id": "Mbpp/391", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef validate_types(ids, names, values) -> None:\n    \"\"\"Validates that all inputs are lists.\"\"\"\n    if not (isinstance(ids, list) and isinstance(names, list) and isinstance(values, list)):\n        raise ValidationError(\"All inputs must be lists\")\n\ndef validate_lengths(ids, names, values) -> None:\n    \"\"\"Validates that all input lists have equal length.\"\"\"\n    if not (len(ids) == len(names) == len(values)):\n        raise ValidationError(\"Input lists must have equal length\")\n\ndef convert_list_dictionary(ids: list, names: list, values: list) -> list:\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    Each output entry is { id: { name: value } }.\n    \"\"\"\n    validate_types(ids, names, values)\n    validate_lengths(ids, names, values)\n\n    n = len(ids)\n    output = []\n    for i in range(n):\n        output.append({ids[i]: {names[i]: values[i]}})\n    return output"}
{"task_id": "Mbpp/392", "solution": "from typing import Dict\n\nclass BaseCase:\n    value: int = 0\n\nclass DivisionOperator:\n    def floorDivide(self, n: int, divisor: int) -> int:\n        \"\"\"Performs floor division.\"\"\"\n        return n // divisor\n\nclass RecurrenceFunction:\n    def __init__(self, memo: Dict[int, int], div_op: DivisionOperator, base_case: BaseCase) -> None:\n        \"\"\"Initializes the recurrence function with memoization, division operator, and base case.\"\"\"\n        self._memo = memo\n        self._div_op = div_op\n        self._base_case = base_case\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes f(n) using memoization.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n        if n == self._base_case.value:\n            return self._base_case.value\n        \n        result = self.applyRecurrence(n)\n        self._memo[n] = result\n        return result\n\n    def applyRecurrence(self, n: int) -> int:\n        \"\"\"Applies the recurrence relation.\"\"\"\n        n2 = self._div_op.floorDivide(n, 2)\n        n3 = self._div_op.floorDivide(n, 3)\n        n4 = self._div_op.floorDivide(n, 4)\n        n5 = self._div_op.floorDivide(n, 5)\n\n        sum_parts = self.compute(n2) + self.compute(n3) + self.compute(n4) + self.compute(n5)\n        return max(sum_parts, n)\n\nclass Input:\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass Result:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the given equation \n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    memo: Dict[int, int] = {}\n    div_op = DivisionOperator()\n    base_case = BaseCase()\n    engine = RecurrenceFunction(memo, div_op, base_case)\n    return engine.compute(n)"}
{"task_id": "Mbpp/395", "solution": "import typing\nfrom typing import Optional, Dict\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass Result:\n    value: Optional[str]\n\ndef _count_characters(s: str) -> Dict[str, int]:\n    \"\"\"Count occurrences of each character in s and return a mapping char -> count.\"\"\"\n    counts: Dict[str, int] = {}\n    for ch in s:\n        counts[ch] = counts.get(ch, 0) + 1\n    return counts\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Return the first character in s that occurs exactly once, or None if none exist.\"\"\"\n    counts = _count_characters(s)\n    for ch in s:\n        if counts.get(ch, 0) == 1:\n            return ch\n    return None"}
{"task_id": "Mbpp/397", "solution": "class Number:\n    \"\"\"Value object for numeric inputs.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isNumeric(self) -> bool:\n        \"\"\"Return True if value is int or float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass Result:\n    \"\"\"Value object representing the median result.\"\"\"\n    def __init__(self, value: float):\n        self.value: float = float(value)\n\n    def asFloat(self) -> float:\n        \"\"\"Return value as float.\"\"\"\n        return self.value\n\nclass MedianCalculator:\n    \"\"\"Calculates the median of three numbers.\"\"\"\n    def median_numbers(self, a, b, c) -> float:\n        \"\"\"Compute median and return float.\"\"\"\n        if not self.validate_inputs(a, b, c):\n            raise ValueError(\"Invalid input: all three arguments must be numeric\")\n\n        nums = sorted([self.to_float(a), self.to_float(b), self.to_float(c)])\n        median_value = nums[1]\n        \n        result_obj = Result(median_value)\n        return result_obj.asFloat()\n\n    def validate_inputs(self, a, b, c) -> bool:\n        \"\"\"Return True if all inputs are int or float.\"\"\"\n        num1 = Number(a)\n        num2 = Number(b)\n        num3 = Number(c)\n        return num1.isNumeric() and num2.isNumeric() and num3.isNumeric()\n\n    def to_float(self, n) -> float:\n        \"\"\"Convert numeric input n to float.\"\"\"\n        return float(n)\n\ndef median_numbers(a, b, c) -> float:\n    \"\"\"Public API: returns median of a, b, c as float.\"\"\"\n    calculator = MedianCalculator()\n    return calculator.median_numbers(a, b, c)"}
{"task_id": "Mbpp/398", "solution": "class Digit:\n    \"\"\"Data holder for a single decimal digit value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass IntegerNumber:\n    \"\"\"Wraps an integer and provides digit decomposition.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> list[int]:\n        \"\"\"Returns decimal digits derived from the absolute value of the integer.\"\"\"\n        if self.value == 0:\n            return [0]\n        abs_value = abs(self.value)\n        return [int(d) for d in str(abs_value)]\n\nclass InputList:\n    \"\"\"Wrapper for a list of integers, performing type validation.\"\"\"\n    def __init__(self, elements: list[int]):\n        if not isinstance(elements, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in elements:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n        self.elements = elements\n\nclass Result:\n    \"\"\"Holds the aggregate total sum of digits.\"\"\"\n    def __init__(self, total: int):\n        self.total = total\n\nclass SumOfDigitsFunction:\n    \"\"\"Encapsulates computation for summing decimal digits across numbers.\"\"\"\n    def compute(self, inputList: 'InputList') -> 'Result':\n        total_sum = 0\n        for num_val in inputList.elements:\n            integer_number = IntegerNumber(num_val)\n            for digit_val in integer_number.digits():\n                total_sum += digit_val\n        return Result(total_sum)\n\ndef sum_of_digits(list_of_ints: list[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number in a given list.\n    Validates input and aggregates digit sums.\n    \"\"\"\n    input_list = InputList(list_of_ints)\n    calculator = SumOfDigitsFunction()\n    result = calculator.compute(input_list)\n    return result.total"}
{"task_id": "Mbpp/404", "solution": "def minimum(a, b):\n    \"\"\"Return the smaller of a and b. If equal, return a.\"\"\"\n    if a <= b:\n        return a\n    else:\n        return b"}
