{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\nclass InputValidator:\n    \"\"\"Validates input types and order for perfect square calculations.\"\"\"\n    def validateIntegers(self, start, end) -> None:\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise ValueError(\"Start and end must be integers.\")\n\n    def validateOrder(self, start, end) -> None:\n        if start > end:\n            raise ValueError(\"Start cannot be greater than end.\")\n\nclass Range:\n    \"\"\"Encapsulates start and end bounds of a range.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def isValid(self) -> bool:\n        return self.start <= self.end\n\nclass SquareCalculator:\n    \"\"\"Computes integer perfect squares within a given Range.\"\"\"\n    def computeSquares(self, range_obj: Range) -> List[int]:\n        if range_obj.start > range_obj.end:\n            return []\n        \n        if range_obj.end < 0:\n            return []\n\n        # Effective start for sqrt calculation, as perfect squares are non-negative.\n        effective_start_for_sqrt = max(0, range_obj.start)\n\n        n_start = math.ceil(math.sqrt(effective_start_for_sqrt))\n        n_end = math.floor(math.sqrt(range_obj.end))\n\n        squares = []\n        for n in range(int(n_start), int(n_end) + 1):\n            squares.append(n * n)\n        \n        return squares\n\nclass ResultList:\n    \"\"\"Container for perfect squares, ensuring deterministic sorting.\"\"\"\n    def __init__(self, squares: List[int]):\n        self.squares = squares\n\n    def sortAscending(self) -> None:\n        self.squares.sort()\n\nclass PerfectSquaresService:\n    \"\"\"Orchestrates validation and computation of perfect squares.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._calculator = SquareCalculator()\n\n    def perfect_squares(self, start: int, end: int) -> List[int]:\n        self._validator.validateIntegers(start, end)\n        self._validator.validateOrder(start, end)\n\n        r = Range(start, end)\n        squares = self._calculator.computeSquares(r)\n        \n        result_list_obj = ResultList(squares)\n        result_list_obj.sortAscending()\n\n        return result_list_obj.squares\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    service = PerfectSquaresService()\n    return service.perfect_squares(start, end)"}
{"task_id": "Mbpp/591", "solution": "def _validate_input(input_list) -> None:\n    \"\"\"Validates that input_list is a list, raising TypeError otherwise.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\ndef swap_List(input_list: list) -> list:\n    \"\"\"Swaps the first and last elements of a list, returning a new list.\"\"\"\n    _validate_input(input_list)\n\n    n = len(input_list)\n\n    if n <= 1:\n        # For lists of length 0 or 1, return a shallow copy without modification.\n        return input_list.copy()\n    else:\n        # Create a shallow copy to avoid modifying the original list.\n        new_list = input_list.copy()\n        # Swap the first and last elements.\n        new_list[0], new_list[-1] = new_list[-1], new_list[0]\n        return new_list"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass Octet:\n    \"\"\"Encapsulates single-octet normalization rules.\"\"\"\n    def __init__(self, rawValue: str, position: int) -> None:\n        self.rawValue = rawValue\n        self.position = position\n\n    def normalize(self) -> str:\n        \"\"\"Removes leading zeros from the octet string; handles '00' -> '0'.\"\"\"\n        return str(int(self.rawValue))\n\n    def toInt(self) -> int:\n        \"\"\"Converts the raw octet value to an integer.\"\"\"\n        return int(self.rawValue)\n\nclass IPv4Address:\n    \"\"\"Parses, normalizes, and reassembles an IPv4 dotted-decimal address.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n        self.octets: List[Octet] = []\n        self._parse_octets()\n\n    def _parse_octets(self) -> None:\n        \"\"\"Splits the raw IP string into Octet objects.\"\"\"\n        parts = self.raw.split('.')\n        for i, part in enumerate(parts):\n            self.octets.append(Octet(part, i))\n\n    def normalize(self) -> str:\n        \"\"\"Returns the normalized IPv4 address string by processing each octet.\"\"\"\n        normalized_parts = [octet.normalize() for octet in self.octets]\n        return \".\".join(normalized_parts)\n\ndef removezero_ip(input: str) -> str:\n    \"\"\"\n    Public API: normalize IPv4 dotted-decimal string by removing leading zeros per octet.\n    Returns a string (no side-effects).\n    \"\"\"\n    ip = IPv4Address(input)\n    return ip.normalize()"}
{"task_id": "Mbpp/592", "solution": "import math\nfrom typing import overload\n\nclass BinomialCoefficient:\n    \"\"\"\n    Computes binomial coefficients C(n, k) exactly.\n    Uses math.comb for Python 3.8+ or a multiplicative algorithm otherwise.\n    \"\"\"\n    @staticmethod\n    def C(n: int, k: int) -> int:\n        if k < 0 or k > n:\n            return 0\n        \n        # Use math.comb if available (Python 3.8+)\n        if hasattr(math, 'comb'):\n            return math.comb(n, k)\n\n        # Fallback to multiplicative integer-only algorithm\n        # C(n, k) = C(n, n-k), choose the smaller k for efficiency\n        k = min(k, n - k)\n        result = 1\n        for i in range(1, k + 1):\n            # The formula is C(n, k) = product (n - i + 1) / i for i=1 to k\n            result = result * (n - i + 1) // i\n        return result\n\nclass Calculation:\n    \"\"\"\n    Encapsulates the algorithm for computing the sum S(n).\n    It iterates through terms and accumulates the total sum.\n    \"\"\"\n    def computeSum(self, n: int) -> int:\n        total = 0\n        for k in range(0, n):\n            term = self.computeTerm(n, k)\n            total += term\n        return total\n\n    def computeTerm(self, n: int, k: int) -> int:\n        \"\"\"\n        Computes a single term C(n,k) * C(n,k+1) for the sum.\n        Utilizes the BinomialCoefficient class for combinatorial calculations.\n        \"\"\"\n        c1 = BinomialCoefficient.C(n, k)\n        c2 = BinomialCoefficient.C(n, k + 1)\n        return c1 * c2\n\nclass SumOfProductFunction:\n    \"\"\"\n    Acts as a facade, delegating the computation of S(n) to the Calculation class.\n    This class handles the high-level coordination for the sum_Of_product function.\n    \"\"\"\n    def sum_Of_product(self, n: int) -> int:\n        return Calculation().computeSum(n)\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    \n    return SumOfProductFunction().sum_Of_product(n)"}
{"task_id": "Mbpp/590", "solution": "import math\n\nclass PolarCoordinate:\n    \"\"\"Represents a point in polar coordinates (r, theta).\"\"\"\n    def __init__(self, r: float, theta: float):\n        self.r = r\n        self.theta = theta\n\n    def normalize(self, range_hint: str = \"(-pi,pi]\") -> None:\n        \"\"\"Normalizes the angle theta within a specified range.\"\"\"\n        if range_hint == \"(-pi,pi]\":\n            self.theta = math.atan2(math.sin(self.theta), math.cos(self.theta))\n        # Other normalizations could be added here if needed by range_hint\n\nclass RectangularCoordinate:\n    \"\"\"Represents a point in rectangular coordinates (x, y).\"\"\"\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def toPolar(self) -> PolarCoordinate:\n        \"\"\"Converts rectangular coordinates to polar coordinates.\"\"\"\n        r = math.sqrt(self.x**2 + self.y**2)\n        theta = math.atan2(self.y, self.x)\n        return PolarCoordinate(r, theta)\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\n    def to_native(self) -> complex:\n        \"\"\"Converts to a native Python complex number.\"\"\"\n        return complex(self.real, self.imag)\n\nclass ConverterService:\n    \"\"\"Provides methods for coordinate conversions.\"\"\"\n    default_angle_units: str = 'radians'\n    tol: float = 1e-9\n\n    def polar_rect(self, a: float, b: float) -> (PolarCoordinate, ComplexNumber):\n        \"\"\"Converts between coordinate systems based on input interpretation.\n        Inputs (a,b) are interpreted as (r, theta) for polar to rectangular conversion.\n        \"\"\"\n        # Interpretation 1: Inputs a,b are (r, theta) - polar to rectangular\n        r = float(a)\n        theta = float(b)\n\n        # Compute rectangular coordinates from polar\n        x = r * math.cos(theta)\n        y = r * math.sin(theta)\n\n        polar_coord = PolarCoordinate(r, theta)\n        complex_num = ComplexNumber(x, y)\n\n        return (polar_coord, complex_num)\n\ndef polar_rect(a, b):\n    \"\"\"\n    Top-level API to convert polar coordinates (r, theta) to rectangular coordinates (x, y).\n    Inputs `a` and `b` are validated as numeric types, then interpreted as `r` and `theta` respectively.\n    Returns a tuple: ((r, theta), complex(x, y)).\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Both inputs must be numeric (int or float).\")\n\n    converter = ConverterService()\n    polar_coord, complex_num = converter.polar_rect(float(a), float(b))\n\n    return ((polar_coord.r, polar_coord.theta), complex_num.to_native())"}
{"task_id": "Mbpp/594", "solution": "from typing import List\n\ndef diff_even_odd(items: List[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Scans the list from left to right to identify the first occurrence of each.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for item in items:\n        if first_even is None and item % 2 == 0:\n            first_even = item\n        elif first_odd is None and item % 2 != 0:\n            first_odd = item\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    # As per design, behavior when a parity is missing is unspecified;\n    # for the given test case, both will always be found.\n    return first_even - first_odd"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Validate n, compute sum and average, return (sum, average). Raises ValueError if n is not a positive integer.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/596", "solution": "import sys\n\nclass Result:\n    \"\"\"Data holder for the computed size.\"\"\"\n    def __init__(self, size_bytes: int):\n        self.size_bytes = int(size_bytes)\n\n    def to_int(self) -> int:\n        \"\"\"Returns the size in bytes as an integer.\"\"\"\n        return int(self.size_bytes)\n\nclass SysLibrary:\n    \"\"\"Thin wrapper around Python sys.getsizeof.\"\"\"\n    def getsizeof(self, obj) -> int:\n        \"\"\"Calls sys.getsizeof(obj) and returns the result.\"\"\"\n        return sys.getsizeof(obj)\n\ndef tuple_size(tuple) -> int:\n    \"\"\"\n    Calculates the size in bytes of the given tuple using the defined architectural components.\n    \"\"\"\n    sys_library_instance = SysLibrary()\n    size_in_bytes = sys_library_instance.getsizeof(tuple)\n    \n    result_object = Result(size_in_bytes)\n    return result_object.to_int()"}
{"task_id": "Mbpp/598", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents an integer value and provides methods to extract its digits and count them.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def count_digits(self) -> int:\n        \"\"\"Returns the number of digits in the integer.\"\"\"\n        return len(str(self._value))\n\n    def extract_digits(self) -> List[int]:\n        \"\"\"Extracts and returns a list of individual digits from the integer.\"\"\"\n        return [int(d) for d in str(self._value)]\n\nclass Result:\n    \"\"\"A simple container for the boolean outcome of an Armstrong check.\"\"\"\n    def __init__(self, is_armstrong: bool):\n        self.is_armstrong = is_armstrong\n\nclass ArmstrongChecker:\n    \"\"\"Encapsulates the logic for checking if a number is an Armstrong number.\"\"\"\n    def armstrong_number(self, n: int) -> bool:\n        number_obj = Number(n)\n        digits = number_obj.extract_digits()\n        digit_count = number_obj.count_digits()\n\n        sum_of_powers = 0\n        for digit in digits:\n            sum_of_powers += digit ** digit_count\n\n        result_obj = Result(sum_of_powers == n)\n        return result_obj.is_armstrong\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)"}
{"task_id": "Mbpp/597", "solution": "class OutOfRangeError(Exception):\n    \"\"\"Error type for k out-of-range.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidOrderError(Exception):\n    \"\"\"Error type for unsorted input arrays.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validate input arrays are sorted and that k is in the valid 1-based range.\"\"\"\n    def validate_sorted(self, A: list, B: list) -> bool:\n        \"\"\"Returns True if both arrays non-decreasing; raises InvalidOrderError otherwise.\"\"\"\n        def _is_sorted(arr):\n            for i in range(len(arr) - 1):\n                if arr[i] > arr[i+1]:\n                    return False\n            return True\n\n        if not _is_sorted(A):\n            raise InvalidOrderError(\"Array A is not sorted in non-decreasing order.\")\n        if not _is_sorted(B):\n            raise InvalidOrderError(\"Array B is not sorted in non-decreasing order.\")\n        return True\n\n    def validate_k_range(self, k: int, total: int) -> bool:\n        \"\"\"Returns True if 1 <= k <= total; raises OutOfRangeError otherwise.\"\"\"\n        if not (1 <= k <= total):\n            raise OutOfRangeError(f\"k must be between 1 and {total}, but got {k}.\")\n        return True\n\nclass EmptyArrayHandler:\n    \"\"\"Provide logic to return the k-th element when one array is empty.\"\"\"\n    def handle_empty(self, A: list, B: list, k: int) -> int | None:\n        \"\"\"Returns the k-th element from the non-empty array (1-based), or None if both are non-empty.\"\"\"\n        if not A:\n            if not B: # Both A and B are empty. k is already validated for total_length=0 by validator.\n                return None\n            return B[k - 1]\n        elif not B:\n            return A[k - 1]\n        return None\n\ndef _kth_recursive(a: list, a_start: int, b: list, b_start: int, k: int) -> int:\n    \"\"\"\n    Recursively finds the k-th smallest element in the merged parts of two sorted arrays.\n    Operates by eliminating elements from either array in each step.\n    \"\"\"\n    len_a_rem = len(a) - a_start\n    len_b_rem = len(b) - b_start\n\n    if len_a_rem == 0:\n        return b[b_start + k - 1]\n    if len_b_rem == 0:\n        return a[a_start + k - 1]\n    if k == 1:\n        return min(a[a_start], b[b_start])\n\n    count_a = min(k // 2, len_a_rem)\n    count_b = min(k // 2, len_b_rem)\n    \n    val_a = a[a_start + count_a - 1]\n    val_b = b[b_start + count_b - 1]\n\n    if val_a <= val_b:\n        return _kth_recursive(a, a_start + count_a, b, b_start, k - count_a)\n    else:\n        return _kth_recursive(a, a_start, b, b_start + count_b, k - count_b)\n\ndef find_kth(A: list, B: list, k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from the given two sorted arrays.\n    Orchestrates validation, empty-array handling, and the selection algorithm.\n    \"\"\"\n    validator = InputValidator()\n    empty_handler = EmptyArrayHandler()\n\n    validator.validate_sorted(A, B)\n\n    total_length = len(A) + len(B)\n    validator.validate_k_range(k, total_length)\n\n    result_from_empty_handler = empty_handler.handle_empty(A, B, k)\n    if result_from_empty_handler is not None:\n        return result_from_empty_handler\n\n    return _kth_recursive(A, 0, B, 0, k)"}
