{"task_id": "Mbpp/745", "solution": "from typing import List\n\n# Helper function as specified in src/domain.py\ndef _digits_of(n: int) -> List[int]:\n    \"\"\"Extracts digits from an integer and returns them as a list of integers.\"\"\"\n    if n == 0:\n        return [0]\n    return [int(d) for d in str(n)]\n\n# Domain classes as specified in src/domain.py\nclass Digit:\n    \"\"\"Lightweight value object for a single decimal digit (0..9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Number:\n    \"\"\"Represents a candidate integer with helpers for digit-based checks.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.digits = _digits_of(value)\n\n    def contains_zero(self) -> bool:\n        \"\"\"Checks if the number contains the digit 0.\"\"\"\n        return 0 in self.digits\n\n    def all_digits_divide(self) -> bool:\n        \"\"\"Checks if every digit (non-zero) divides the number's value.\"\"\"\n        # This method assumes that numbers containing digit 0 are excluded before calling this.\n        for digit in self.digits:\n            if self.value % digit != 0:\n                return False\n        return True\n\nclass ResultList:\n    \"\"\"Collects qualifying integers and produces the sorted list.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds a qualifying number to the list.\"\"\"\n        self.values.append(n)\n\n    def sort_ascending(self) -> None:\n        \"\"\"Sorts the collected numbers in ascending order.\"\"\"\n        self.values.sort()\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the collected numbers as a list.\"\"\"\n        return self.values\n\nclass Range:\n    \"\"\"Value object representing an inclusive integer range.\"\"\"\n    def __init__(self, startnum: int, endnum: int) -> None:\n        self.startnum = startnum\n        self.endnum = endnum\n\nclass DivisibleByDigitsFunction:\n    \"\"\"Encapsulates the core algorithm for finding numbers divisible by their digits.\"\"\"\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"\n        Iterates through the given range to find numbers where every digit divides the number.\n        \"\"\"\n        result_list = ResultList()\n\n        for num_value in range(startnum, endnum + 1):\n            number = Number(num_value)\n\n            if number.contains_zero():\n                continue\n\n            if number.all_digits_divide():\n                result_list.add(num_value)\n        \n        result_list.sort_ascending()\n        return result_list.as_list()\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    \"\"\"\n    return DivisibleByDigitsFunction().divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/748", "solution": "class InputString:\n    \"\"\"Provides read-only access to the input string.\n    Offers methods for length and character retrieval.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def getChar(self, index: int) -> str:\n        return self.value[index]\n\nclass OutputString:\n    \"\"\"Accumulates result characters for the output string.\n    Provides an append method to build the final string.\"\"\"\n    def __init__(self):\n        self.value: str = ''\n\n    def append(self, char: str) -> None:\n        self.value += char\n\nclass Character:\n    \"\"\"Encapsulates a single character for classification.\n    Includes methods to check if the character is uppercase or lowercase.\"\"\"\n    def __init__(self, char: str):\n        self.char: str = char\n\n    def isUpper(self) -> bool:\n        return self.char.isupper()\n\n    def isLower(self) -> bool:\n        return self.char.islower()\n\nclass CapitalWordsService:\n    \"\"\"Implements the core logic to insert spaces between words.\n    Scans the input string and constructs the output based on character transitions.\"\"\"\n    def capital_words_spaces(self, input_string: str) -> str:\n        input_obj = InputString(input_string)\n        output_obj = OutputString()\n\n        for index in range(input_obj.length()):\n            current_char_str = input_obj.getChar(index)\n            current_char_obj = Character(current_char_str)\n\n            if index > 0:\n                prev_char_str = input_obj.getChar(index - 1)\n                prev_char_obj = Character(prev_char_str)\n\n                # Insert a space if the previous character was lowercase and the current is uppercase.\n                if prev_char_obj.isLower() and current_char_obj.isUpper():\n                    output_obj.append(' ')\n            \n            output_obj.append(current_char_str)\n        \n        return output_obj.value\n\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"Puts spaces between words starting with capital letters in a given string.\n    This function acts as the public API entry point.\"\"\"\n    service = CapitalWordsService()\n    return service.capital_words_spaces(input)"}
{"task_id": "Mbpp/751", "solution": "from typing import List, Sequence\n\nclass Element:\n    def __init__(self, value: object):\n        self.value = value\n\n    def compareTo(self, other: 'Element') -> int:\n        # Compares this element's value to another element's value.\n        # Returns -1 if less, 0 if equal, 1 if greater.\n        if self.value < other.value:\n            return -1\n        elif self.value == other.value:\n            return 0\n        else:\n            return 1\n\nclass Array:\n    def __init__(self, elements: Sequence[object]):\n        # Wraps a sequence of values into Element instances.\n        self.elements: List[Element] = [Element(val) for val in elements]\n\n    def length(self) -> int:\n        # Returns the number of elements in the array.\n        return len(self.elements)\n\n    def get(self, i: int) -> Element:\n        # Returns the Element at the specified index.\n        return self.elements[i]\n\nclass MinHeapChecker:\n    @staticmethod\n    def check_min_heap(arr: 'Array') -> bool:\n        # Checks if the given Array instance represents a min-heap.\n        # Iterates through parent nodes and compares them with their children.\n        n = arr.length()\n        for i in range(n // 2): # Iterate through potential parent nodes\n            parent_element = arr.get(i)\n\n            left_child_idx = 2 * i + 1\n            if left_child_idx < n:\n                left_child_element = arr.get(left_child_idx)\n                if parent_element.compareTo(left_child_element) > 0:\n                    return False\n\n            right_child_idx = 2 * i + 2\n            if right_child_idx < n:\n                right_child_element = arr.get(right_child_idx)\n                if parent_element.compareTo(right_child_element) > 0:\n                    return False\n        return True\n\ndef check_min_heap(arr) -> bool:\n    \"\"\"\n    Checks if the given array or sequence represents a min-heap.\n    \"\"\"\n    array_instance: Array\n    if not isinstance(arr, Array):\n        array_instance = Array(arr)\n    else:\n        array_instance = arr\n    \n    return MinHeapChecker.check_min_heap(array_instance)"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Records are sorted by their numeric value (second element) in ascending order.\n    \"\"\"\n    \n    def _is_numeric(value):\n        \"\"\"Checks if a value is an integer or a float, excluding booleans.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def _extract_value(record):\n        \"\"\"Extracts the numeric value (second element) from a record tuple.\"\"\"\n        return record[1]\n\n    def _validate_records(records_input, k_input):\n        \"\"\"Validates the input records and k. Raises ValueError if validation fails.\"\"\"\n        if not hasattr(records_input, '__iter__'):\n            raise ValueError(\"Records must be an iterable.\")\n        \n        for i, record in enumerate(records_input):\n            if not isinstance(record, tuple) or len(record) != 2:\n                raise ValueError(f\"Record at index {i} must be a 2-element tuple.\")\n            if not _is_numeric(record[1]):\n                raise ValueError(f\"Second element of record at index {i} must be numeric (int or float).\")\n        \n        if not isinstance(k_input, int):\n            raise ValueError(\"k must be an integer.\")\n        if k_input < 0:\n            raise ValueError(\"k must be a non-negative integer.\")\n\n    _validate_records(records, k)\n\n    # Sort the records based on their numeric value (second element)\n    # Python's sorted() is stable, preserving original order for equal keys.\n    sorted_records = sorted(records, key=_extract_value)\n\n    # Return the first min(k, len(records)) elements\n    return sorted_records[:min(k, len(records))]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"Return a list of values v such that there exists index i in 0..min(len(l1),len(l2),len(l3))-1 with l1[i] == l2[i] == l3[i]. Preserves increasing index order and allows duplicates.\"\"\"\n    \n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/752", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Represents an input validation failure.\n    \"\"\"\n    def __init__(self, message: str, code: int = 1):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass InputValidator:\n    \"\"\"\n    Encapsulates input validation logic.\n    \"\"\"\n    def isInteger(self, value) -> bool:\n        return type(value) is int\n\n    def isNonNegative(self, n: int) -> bool:\n        return n >= 0\n\nclass JacobsthalResult:\n    \"\"\"\n    Data holder for computed Jacobsthal results (n and value).\n    \"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\n\nclass JacobsthalCalculator:\n    \"\"\"\n    Implements Jacobsthal number calculation logic.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        return self.compute_iterative(n)\n\n    def compute_iterative(self, n: int) -> int:\n        a, b = 0, 1 # J0, J1\n        for _ in range(2, n + 1):\n            a, b = b, a + 2 * b\n        return b\n\n    def compute_recursive(self, n: int) -> int:\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        return self.compute_recursive(n - 1) + 2 * self.compute_recursive(n - 2)\n\ndef jacobsthal_num(n) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number, validating input according to design.\n    \"\"\"\n    validator = InputValidator()\n    calculator = JacobsthalCalculator()\n\n    if not validator.isInteger(n):\n        raise ValidationError(\"Input must be an integer.\", code=101)\n    if not validator.isNonNegative(n):\n        raise ValidationError(\"Input must be a non-negative integer.\", code=102)\n\n    result = calculator.compute(n)\n    return result"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(list):\n    \"\"\"Return the second smallest numeric value from the input list.\n    Raises ValueError if the list contains fewer than two elements.\n    \"\"\"\n    if len(list) < 2:\n        raise ValueError(\"Input list must contain at least two elements\")\n    ordered = sorted(list)\n    return ordered[1]"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"Return True if the provided list contains exactly one distinct element, else False.\n    An empty list is considered to have one distinct element (vacuous truth).\n    \"\"\"\n    return len(set(numbers)) <= 1"}
{"task_id": "Mbpp/757", "solution": "from typing import List\nfrom collections import Counter\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of strings in the list that are reverses of each other.\n    Each pair of distinct indices (i, j) where strings[j] == reverse(strings[i]) is counted once.\n    \"\"\"\n    freq_map = Counter(strings)\n    processed_strings = set()\n    pair_count = 0\n\n    for s in freq_map:\n        if s in processed_strings:\n            continue\n\n        r = s[::-1]\n        n_s = freq_map[s]\n\n        if s == r:  # Palindrome\n            # Count combinations of distinct palindromes from n_s occurrences\n            pair_count += n_s * (n_s - 1) // 2\n            processed_strings.add(s)\n        else:\n            if r in freq_map:\n                n_r = freq_map[r]\n                pair_count += n_s * n_r\n                processed_strings.add(s)\n                processed_strings.add(r)\n            else:\n                processed_strings.add(s)\n                \n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "def to_tuple(sublist):\n    \"\"\"Converts a sublist (list) to an immutable tuple preserving order.\"\"\"\n    return tuple(sublist)\n\ndef unique_sublists(input_list):\n    \"\"\"\n    Accepts a list of sublists and returns a dict mapping tuples to counts.\n    Each sublist is converted to an immutable tuple key for counting.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        key = to_tuple(sublist)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with exactly two fractional digits.\n    Returns True for strings matching the pattern ^\\d+\\.\\d{2}$, False otherwise.\n    \"\"\"\n    # Pattern: one or more digits, a literal dot, exactly two digits\n    # Anchors ^ and $ ensure the entire string must match the pattern.\n    pattern = r\"^\\d+\\.\\d{2}$\"\n    return re.fullmatch(pattern, s) is not None"}
{"task_id": "Mbpp/762", "solution": "from typing import Set\nfrom .domain import Month, Result # domain alignment; not required for API but included per SRS\n\n_THIRTY_DAY_MONTHS: Set[int] = {4, 6, 9, 11}\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Return True when month is one of 4,6,9,11; False otherwise for months in 1..12.\n    The SRS does not mandate behavior for inputs outside 1..12 or non-integers; this implementation assumes integer inputs as specified by FR2.\n    \"\"\"\n    return month in _THIRTY_DAY_MONTHS"}
{"task_id": "Mbpp/764", "solution": "class InputString:\n    \"\"\"Simple holder for input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __str__(self) -> str:\n        return self.value\n\nclass Digit:\n    \"\"\"Conceptual representation of a character that may be a digit.\"\"\"\n    def __init__(self, char: str) -> None:\n        self.char = char\n\nclass CountResult:\n    \"\"\"Encapsulate integer count produced by NumberCtr.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass NumberCtr:\n    \"\"\"Encapsulates counting logic for ASCII decimal digits.\"\"\"\n    def count(self, input: str) -> int:\n        \"\"\"Iterates over characters of input and counts occurrences of '0'..'9'.\"\"\"\n        count_val = 0\n        for char in input:\n            if '0' <= char <= '9':\n                count_val += 1\n        return count_val\n\ndef number_ctr(input: str) -> int:\n    \"\"\"Counts the number of ASCII decimal digits ('0'-'9') in the given string.\"\"\"\n    # Delegate counting to NumberCtr component.\n    counter = NumberCtr()\n    return counter.count(input)"}
{"task_id": "Mbpp/765", "solution": "import math\n\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    \n    # We are looking for a number 'x' such that the count of polite numbers less than or equal to 'x' is 'n'.\n    # The number of non-polite numbers (powers of 2) less than or equal to 'x' is floor(log2(x)) + 1.\n    # Therefore, x - (floor(log2(x)) + 1) = n.\n    \n    current_num = n  # The nth polite number will be at least n.\n    \n    while True:\n        # Calculate the count of powers of 2 (1, 2, 4, 8, ...) up to current_num.\n        # This count is floor(log2(current_num)) + 1.\n        powers_of_2_count = int(math.log2(current_num)) + 1\n        \n        # Calculate how many polite numbers exist up to current_num.\n        polite_numbers_up_to_current = current_num - powers_of_2_count\n        \n        if polite_numbers_up_to_current == n:\n            return current_num\n        else:\n            current_num += 1"}
{"task_id": "Mbpp/763", "solution": "class InputValidator:\n    \"\"\"Validates input parameters for length and numeric types.\"\"\"\n    def validate_length(self, iterable, n):\n        \"\"\"Raises ValueError if n is invalid or doesn't match iterable length.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Parameter 'n' must be an integer.\")\n        if n < 2:\n            raise ValueError(\"Parameter 'n' must be at least 2.\")\n        \n        try:\n            iterable_length = len(iterable)\n        except TypeError:\n            raise ValueError(\"Iterable does not have a measurable length (e.g., a generator).\")\n\n        if iterable_length != n:\n            raise ValueError(f\"Length of iterable ({iterable_length}) does not match 'n' ({n}).\")\n\n    def validate_numeric(self, iterable):\n        \"\"\"Raises ValueError if any element in the iterable is not numeric.\"\"\"\n        for element in iterable:\n            if not isinstance(element, (int, float)):\n                raise ValueError(\"All elements in the iterable must be numeric (int or float).\")\n\nclass IterableArray:\n    \"\"\"Adapts an input iterable to provide length, duplicate detection, and a sorted copy.\"\"\"\n    def __init__(self, iterable):\n        self._elements = list(iterable)\n\n    def length(self):\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def has_duplicates(self):\n        \"\"\"Checks if the array contains duplicate elements.\"\"\"\n        return len(set(self._elements)) != len(self._elements)\n\n    def sorted_copy(self):\n        \"\"\"Returns a new sorted list of the elements.\"\"\"\n        return sorted(self._elements)\n\nclass DifferenceComputer:\n    \"\"\"Computes the minimum absolute difference between adjacent elements in a sorted list.\"\"\"\n    def compute_min_difference(self, sorted_elements):\n        \"\"\"Calculates the minimum difference from a sorted list of numbers.\"\"\"\n        if len(sorted_elements) < 2:\n            return 0 # Safe guard for empty or single-element lists\n\n        min_diff = float('inf')\n        for i in range(1, len(sorted_elements)):\n            diff = abs(sorted_elements[i] - sorted_elements[i-1])\n            if diff < min_diff:\n                min_diff = diff\n        return min_diff\n\nclass Result:\n    \"\"\"Wraps a numeric value and provides an accessor.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def as_number(self):\n        \"\"\"Returns the wrapped numeric value.\"\"\"\n        return self._value\n\nclass FindMinDiff:\n    \"\"\"Orchestrates the validation, duplicate detection, and difference computation.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._difference_computer = DifferenceComputer()\n\n    def find(self, iterable, n):\n        \"\"\"Executes the logic to find the minimum difference.\"\"\"\n        self._validator.validate_length(iterable, n)\n        # Note: validate_numeric is called on the *original* iterable before materialization\n        # to ensure initial validation aligns with the given iterable, not just its materialized list form.\n        self._validator.validate_numeric(iterable) \n        \n        arr = IterableArray(iterable)\n        \n        if arr.has_duplicates():\n            return Result(0).as_number()\n        \n        sorted_elements = arr.sorted_copy()\n        value = self._difference_computer.compute_min_difference(sorted_elements)\n        return Result(value).as_number()\n\ndef find_min_diff(iterable, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    Orchestrates validation, duplicate checking, and difference calculation.\n    \"\"\"\n    orchestrator = FindMinDiff()\n    return orchestrator.find(iterable, n)"}
{"task_id": "Mbpp/766", "solution": "# -*- coding: utf-8 -*-\n\ndef pair_wise(input_list):\n    \"\"\"\n    Produce a list of 2-tuples of consecutive items from input_list.\n\n    Parameters:\n    - input_list: the list-like object passed by caller. Parameter name MUST be input_list per SRS.\n\n    Returns:\n    - list of 2-tuples: each tuple is (first, second) consecutive elements from input_list.\n\n    Behavior constraints: does not modify input_list; returns [] when len(input_list) < 2.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/770", "solution": "def _validate_n(n) -> None:\n    \"\"\"Raise TypeError if n is not int; raise ValueError if n < 0.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef _compute_sum_fourth_powers(n: int) -> int:\n    \"\"\"Return integer sum of (2k-1)**4 for k=1..n; return 0 for n==0.\"\"\"\n    if n == 0:\n        return 0\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_num = 2 * k - 1\n        total_sum += odd_num ** 4\n    return total_sum\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"Validate n and return sum_{k=1..n} (2k-1)**4 as int.\"\"\"\n    _validate_n(n)\n    return _compute_sum_fourth_powers(n)"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(nums, sum):\n    \"\"\"Counts pairs in a list that sum up to a target value.\"\"\"\n    n = len(nums)\n    if n < 2:\n        return 0\n\n    pair_count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if nums[i] + nums[j] == sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/771", "solution": "class Stack:\n    \"\"\"A simple LIFO stack implementation.\"\"\"\n    def __init__(self):\n        self._items = []\n\n    def push(self, item):\n        self._items.append(item)\n\n    def pop(self):\n        if not self.isEmpty():\n            return self._items.pop()\n        return None\n\n    def peek(self):\n        if not self.isEmpty():\n            return self._items[-1]\n        return None\n\n    def isEmpty(self):\n        return len(self._items) == 0\n\nclass Expression:\n    \"\"\"A wrapper for the raw expression string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\nclass Bracket:\n    \"\"\"Represents a single bracket character.\"\"\"\n    _OPENING_BRACKETS = '({['\n\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n\n    def isOpening(self) -> bool:\n        return self.symbol in Bracket._OPENING_BRACKETS\n\nclass ExpressionChecker:\n    \"\"\"Checks if an expression's brackets are balanced.\"\"\"\n    def __init__(self):\n        self._pairs = {')': '(', ']': '[', '}': '{'}\n        self._stack = Stack()\n\n    def check_expression(self, expression_str: str) -> bool:\n        expr = Expression(expression_str)\n        for ch in expr.raw:\n            bracket_char = Bracket(ch)\n            if bracket_char.isOpening():\n                self._stack.push(bracket_char)\n            elif ch in self._pairs: # It's a closing bracket\n                top = self._stack.peek()\n                if top is None or top.symbol != self._pairs[ch]:\n                    return False\n                self._stack.pop()\n        return self._stack.isEmpty()\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced and correctly nested brackets.\n    Supports parentheses (), braces {}, and square brackets [].\n    \"\"\"\n    checker = ExpressionChecker()\n    return checker.check_expression(expression)"}
{"task_id": "Mbpp/769", "solution": "import collections\n\ndef validate_inputs(a, b):\n    \"\"\"Validates that both parameters are Python lists, raising TypeError if not.\"\"\"\n    if not isinstance(a, list) or not isinstance(b, list):\n        raise TypeError(\"Both inputs to Diff must be lists.\")\n\ndef compute_difference(a, b):\n    \"\"\"\n    Computes the difference between list a and list b, preserving relative\n    order from a and handling duplicates as multiset difference.\n    \"\"\"\n    b_counts = collections.Counter(b)\n    result = []\n    for item in a:\n        if b_counts[item] == 0:\n            result.append(item)\n        else:\n            b_counts[item] -= 1\n    return result\n\ndef Diff(a, b):\n    \"\"\"\n    Returns a new list containing elements from list 'a' that are not present\n    in list 'b', preserving relative order and handling duplicates.\n    \"\"\"\n    validate_inputs(a, b)\n    return compute_difference(a, b)"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(input_string: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Search for the first occurrence of substring in input_string.\n    Return (substring, start_index, end_index) or None if not found.\n    \"\"\"\n    start_index = input_string.find(substring)\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/772", "solution": "def remove_length(s: str, k: int) -> str:\n    \"\"\"Removes all words with a specified length k from the given string.\"\"\"\n    words = s.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/775", "solution": "from collections.abc import Sequence\n\ndef check_index_is_odd(index):\n    \"\"\"Checks if an index is odd.\"\"\"\n    return index % 2 == 1\n\ndef check_value_is_odd_integer(value):\n    \"\"\"Checks if a value is an odd integer.\"\"\"\n    return isinstance(value, int) and (value % 2 == 1)\n\ndef validate_input(input_list):\n    \"\"\"Validates if the input is a sequence, raising TypeError if not.\"\"\"\n    if not isinstance(input_list, Sequence):\n        raise TypeError(\"input_list must be a sequence\")\n\ndef odd_position(input_list):\n    \"\"\"\n    Checks whether every odd index contains odd numbers of a given list.\n    Raises TypeError if input_list is not a sequence.\n    \"\"\"\n    validate_input(input_list)\n\n    for i in range(len(input_list)):\n        if check_index_is_odd(i):\n            value = input_list[i]\n            if not check_value_is_odd_integer(value):\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "class Element:\n    \"\"\"Value object for an integer and its count.\"\"\"\n    def __init__(self, value: int, count: int) -> None:\n        self.value = value\n        self.count = count\n\nclass FrequencyMap:\n    \"\"\"Manages frequency counts of elements in a list.\"\"\"\n    def __init__(self) -> None:\n        self.map: dict[int, int] = {}\n\n    def build(self, list_of_ints: list[int]) -> None:\n        \"\"\"Populates the frequency map from a list of integers.\"\"\"\n        for num in list_of_ints:\n            self.map[num] = self.map.get(num, 0) + 1\n\n    def get_count(self, value: int) -> int:\n        \"\"\"Returns the count of a specific value, or 0 if not present.\"\"\"\n        return self.map.get(value, 0)\n\nclass InputList:\n    \"\"\"Wrapper for an input list of integers.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\nclass Result:\n    \"\"\"Wrapper for an integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass TestCase:\n    \"\"\"Utility for running a test case.\"\"\"\n    def __init__(self, input: list[int], expected: int) -> None:\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes find_sum and compares the result with the expected value.\"\"\"\n        actual_result = find_sum(self.input)\n        return actual_result == self.expected\n\ndef find_sum(lst: list[int]) -> int:\n    \"\"\"Compute the sum of distinct elements in lst.\"\"\"\n    frequency_map = FrequencyMap()\n    frequency_map.build(lst)\n\n    # Sum the keys (distinct elements) of the frequency map to match the assertion output.\n    total_sum = sum(frequency_map.map.keys())\n            \n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\n\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"Return a list of sublists where each sublist is a maximal run of consecutive equal elements from input_list.\n\n    Args:\n        input_list: list-like iterable containing elements that support equality (==).\n\n    Returns:\n        list of lists representing maximal contiguous runs of equal elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result: List[List[Any]] = []\n    current_group: List[Any] = []\n\n    for element in input_list:\n        if not current_group or element == current_group[-1]:\n            current_group.append(element)\n        else:\n            result.append(current_group)\n            current_group = [element]\n    \n    if current_group:\n        result.append(current_group)\n            \n    return result"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple, Iterable\nimport numbers\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputTuple:\n    a: numbers.Number\n    b: numbers.Number\n    index: int\n\n@dataclass\nclass ResultTuple:\n    sumA: numbers.Number\n    sumB: numbers.Number\n    inputIndex1: int\n    inputIndex2: int\n\n    def as_tuple(self) -> Tuple[numbers.Number, numbers.Number]:\n        return (self.sumA, self.sumB)\n\ndef find_combinations(input_list):\n    \"\"\"\n    Compute pairwise elementwise sums for all unordered pairs i<j.\n    Returns a list of 2-element tuples (sumA, sumB) in lexicographic index order.\n    \"\"\"\n    if input_list is None or not isinstance(input_list, Iterable):\n        raise ValueError(\"Input must be an iterable.\")\n\n    processed_input = []\n    for i, item in enumerate(input_list):\n        if not isinstance(item, (tuple, list)) or len(item) != 2:\n            raise ValueError(f\"Element at index {i} must be a 2-element tuple or list.\")\n        a, b = item\n        if not isinstance(a, numbers.Number) or not isinstance(b, numbers.Number):\n            raise ValueError(f\"Elements of tuple at index {i} must be numeric.\")\n        processed_input.append(InputTuple(a, b, i))\n\n    if len(processed_input) < 2:\n        return []\n\n    results = []\n    n = len(processed_input)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            tuple1 = processed_input[i]\n            tuple2 = processed_input[j]\n            sumA = tuple1.a + tuple2.a\n            sumB = tuple1.b + tuple2.b\n            result = ResultTuple(sumA, sumB, i, j)\n            results.append(result.as_tuple())\n\n    return results"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(nums: List[int]) -> int:\n    \"\"\"Return the sum of all odd-length contiguous subarrays of nums.\n    This function iterates through all possible subarrays, checks their length, and sums those with odd lengths.\"\"\"\n    total_sum = 0\n    n = len(nums)\n    for i in range(n):\n        for j in range(i, n):\n            # The current subarray is nums[i:j+1]\n            if (j - i + 1) % 2 != 0:  # Check if the length is odd\n                total_sum += sum(nums[i : j + 1])\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "from dataclasses import dataclass\nfrom math import isqrt\n\n@dataclass\nclass IntegerInput:\n    value: int\n    def is_positive(self) -> bool:\n        \"\"\"Checks if the stored integer value is positive.\"\"\"\n        return self.value > 0\n\nclass Validator:\n    def validate_positive_integer(self, n: int) -> bool:\n        \"\"\"Validates if the input n is a positive integer by checking type and positivity.\"\"\"\n        return isinstance(n, int) and IntegerInput(n).is_positive()\n\nclass DivisorCounter:\n    def __init__(self, validator: Validator = None) -> None:\n        self.validator = validator or Validator()\n    \n    def count_positive_divisors(self, n: int) -> int:\n        \"\"\"Counts the number of positive divisors for a given integer n using an efficient square root approach.\"\"\"\n        count = 0\n        limit = isqrt(n)\n        for i in range(1, limit + 1):\n            if n % i == 0:\n                if i * i == n:\n                    count += 1\n                else:\n                    count += 2\n        return count\n    \n    def count_divisors(self, n: int) -> bool:\n        \"\"\"Checks if the count of positive divisors for n is even, raising ValueError for non-positive input.\"\"\"\n        if not self.validator.validate_positive_integer(n):\n            raise ValueError(\"n must be a positive integer\")\n        count = self.count_positive_divisors(n)\n        return (count % 2) == 0\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks whether the count of positive divisors for n is even.\"\"\"\n    return DivisorCounter().count_divisors(n)"}
{"task_id": "Mbpp/785", "solution": "class TupleStringInput:\n    \"\"\"Data holder for the raw input string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\nclass IntegerTupleOutput:\n    \"\"\"Data holder for the resulting tuple to return.\"\"\"\n    def __init__(self, values: tuple[int]):\n        self.values = values\n\nclass TupleStringConverter:\n    \"\"\"Stateless converter component for tuple strings.\"\"\"\n\n    def tuple_str_int(self, s: str) -> IntegerTupleOutput:\n        \"\"\"\n        Main conversion method; trims outer parentheses, tokenizes by commas,\n        strips whitespace per token, uses parse_numbers to convert tokens to ints,\n        and returns an IntegerTupleOutput.\n        \"\"\"\n        s_inner = s.strip('()')\n        if not s_inner:  # Handles \"()\" case resulting in an empty tuple\n            return IntegerTupleOutput(tuple())\n\n        # Split by comma, strip whitespace from each token, and filter out any empty tokens\n        token_list = [token.strip() for token in s_inner.split(',') if token.strip()]\n\n        # Convert numeric string tokens to integers\n        int_list = self.parse_numbers(token_list)\n\n        return IntegerTupleOutput(tuple(int_list))\n\n    def parse_numbers(self, token_list: list[str]) -> list[int]:\n        \"\"\"\n        Convert token_list of numeric strings to list[int] by applying int()\n        conversion on each token (assumes tokens already trimmed and not empty).\n        \"\"\"\n        return [int(token) for token in token_list]\n\ndef tuple_str_int(s: str) -> tuple[int]:\n    \"\"\"\n    Converts a string representing a tuple of integers to a Python tuple of integers.\n    This module-level public API delegates to TupleStringConverter for the actual parsing.\n    \"\"\"\n    converter = TupleStringConverter()\n    output_obj = converter.tuple_str_int(s)\n    return output_obj.values"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional, Iterator\n\nclass IntegerElement:\n    \"\"\"Represents an integer value and provides parity checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the integer is even.\"\"\"\n        return (self.value % 2) == 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the integer is odd.\"\"\"\n        return (self.value % 2) != 0\n\nclass IntegerList:\n    \"\"\"A lightweight wrapper around a list of integers, yielding IntegerElement instances.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = elements\n\n    def __iter__(self) -> Iterator[IntegerElement]:\n        \"\"\"Yields ephemeral IntegerElement objects for each value in the list.\"\"\"\n        for value in self._elements:\n            yield IntegerElement(value)\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\nclass MulEvenOddFunction:\n    \"\"\"Encapsulates the logic for finding and multiplying the first even and odd numbers.\"\"\"\n    _firstOdd: Optional[IntegerElement] = None\n    _firstEven: Optional[IntegerElement] = None\n\n    def mul_even_odd(self, input_list: 'IntegerList') -> int:\n        \"\"\"Scans the list and computes the product of the first odd and first even numbers.\"\"\"\n        self.scan_and_capture_firsts(input_list)\n        return self.compute_product()\n\n    def scan_and_capture_firsts(self, input_list: 'IntegerList') -> None:\n        \"\"\"Performs a single pass scan to find the first odd and even elements.\"\"\"\n        for element in input_list:\n            if self._firstOdd is None and element.isOdd():\n                self._firstOdd = element\n            if self._firstEven is None and element.isEven():\n                self._firstEven = element\n            if self._firstOdd is not None and self._firstEven is not None:\n                break\n\n    def compute_product(self) -> int:\n        \"\"\"Computes the product of the captured first odd and even numbers.\"\"\"\n        if self._firstOdd is None or self._firstEven is None:\n            raise ValueError(\"Missing odd or even element in the list.\")\n        return self._firstOdd.value * self._firstEven.value\n\ndef mul_even_odd(input_list):\n    \"\"\"\n    Finds the product of the first even and odd number of a given list.\n    Raises ValueError if either an odd or an even number is not found.\n    \"\"\"\n    if not isinstance(input_list, IntegerList):\n        input_list = IntegerList(list(input_list))\n    worker = MulEvenOddFunction()\n    return worker.mul_even_odd(input_list)"}
