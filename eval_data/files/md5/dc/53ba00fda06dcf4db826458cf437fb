{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Set\n\ndef common_in_nested_lists(nested_lists: List[List[Any]]) -> Set[Any]:\n    \"\"\"\n    Compute and return the set of elements that occur in every inner list of nested_lists.\n    The function converts each inner list to a set and computes the intersection across them.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize common_elements with the set of the first inner list\n    common_elements = set(nested_lists[0])\n\n    # Intersect with the sets of the remaining inner lists\n    for i in range(1, len(nested_lists)):\n        common_elements.intersection_update(set(nested_lists[i]))\n\n    return common_elements"}
{"task_id": "Mbpp/108", "solution": "from typing import List\n\ndef validate_elements_are_integers(values: list) -> bool:\n    \"\"\"Return True if all elements in values are ints; False otherwise.\"\"\"\n    return all(isinstance(element, int) for element in values)\n\ndef sort_ascending(values: list) -> list:\n    \"\"\"Return a new list sorted in ascending (non-decreasing) order.\"\"\"\n    return sorted(values)\n\ndef _merge_three_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Concatenate elements from three lists into a single list preserving multiplicity (no sorting).\"\"\"\n    return list1 + list2 + list3\n\nclass MergeSortedList:\n    def merge(self, list1: list, list2: list, list3: list) -> list:\n        \"\"\"Orchestrate validation, merging, and sorting. Returns sorted list.\"\"\"\n        if not (validate_elements_are_integers(list1) and\n                validate_elements_are_integers(list2) and\n                validate_elements_are_integers(list3)):\n            raise TypeError(\"All input lists must contain only integer elements.\")\n        \n        merged_list = _merge_three_lists(list1, list2, list3)\n        sorted_list = sort_ascending(merged_list)\n        return sorted_list\n\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"Public function. Validates inputs then returns sorted merged list.\n    Raises TypeError for invalid inputs (non-integers).\"\"\"\n    return MergeSortedList().merge(list1, list2, list3)"}
{"task_id": "Mbpp/109", "solution": "from typing import List\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass RotationResult:\n    \"\"\"Represents a single rotated string and its odd/even parity.\"\"\"\n    def __init__(self, value: str, is_odd: bool):\n        self.value = value\n        self.is_odd = is_odd\n\nclass BinaryString:\n    \"\"\"Encapsulates a binary string, its validation, and rotation logic.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Validate that value contains only '0' and '1' and is not empty.\"\"\"\n        if not self.value:\n            return False\n        return all(c in '01' for c in self.value)\n\n    def rotate(self, steps: int) -> 'BinaryString':\n        \"\"\"Return a new BinaryString rotated 'steps' times to the left.\"\"\"\n        if not self.value:\n            return BinaryString(\"\") # Consistent with empty string being invalid\n        actual_steps = steps % self.length\n        rotated_value = self.value[actual_steps:] + self.value[:actual_steps]\n        return BinaryString(rotated_value)\n\n    def char_at(self, index: int) -> str:\n        \"\"\"Return the character at the given index.\"\"\"\n        return self.value[index]\n\nclass RotationOperation:\n    \"\"\"Computes a sequence of rotations and produces RotationResult objects.\"\"\"\n    def __init__(self, k: int):\n        self.k = k\n\n    def perform(self, s: BinaryString) -> List[RotationResult]:\n        \"\"\"Produce up to k RotationResult entries, handling k=0 as per design.\"\"\"\n        rotations_list: List[RotationResult] = []\n        if self.k == 0:\n            # As per design: \"If k == 0, the design decision ... is to evaluate the original string once\"\n            rotated_bs = s.rotate(0) # 0 rotations is the original string\n            is_odd = (rotated_bs.char_at(-1) == '1')\n            rotations_list.append(RotationResult(rotated_bs.value, is_odd))\n        else:\n            for i in range(self.k):\n                rotated_bs = s.rotate(i) # Apply i single-step left rotations from original\n                # Parity is determined by the last character\n                is_odd = (rotated_bs.char_at(-1) == '1')\n                rotations_list.append(RotationResult(rotated_bs.value, is_odd))\n        return rotations_list\n\nclass OddCounter:\n    \"\"\"Counts how many RotationResult entries are odd.\"\"\"\n    def count_odd(self, rotations: List[RotationResult]) -> int:\n        \"\"\"Return integer count of rotations where is_odd is True.\"\"\"\n        count = 0\n        for rotation in rotations:\n            if rotation.is_odd:\n                count += 1\n        return count\n\ndef odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n    \"\"\"\n    if not isinstance(k, int) or k < 0:\n        raise InvalidInputError(\"k must be a non-negative integer.\")\n\n    binary_string = BinaryString(s)\n    if not binary_string.is_valid():\n        raise InvalidInputError(\"s must be a non-empty binary string containing only '0' or '1'.\")\n\n    rotation_op = RotationOperation(k)\n    rotations = rotation_op.perform(binary_string)\n\n    odd_counter = OddCounter()\n    return odd_counter.count_odd(rotations)"}
{"task_id": "Mbpp/113", "solution": "NAME = \"IntegerValidator\"\nALGORITHM = \"per-character digit check\"\nCOMPLEXITY = \"O(n)\"\n\nclass IntegerValidator:\n    \"\"\"Encapsulates the per-character ASCII-digit validation algorithm.\"\"\"\n    def __init__(self):\n        self.name = NAME\n        self.algorithm = ALGORITHM\n        self.complexity = COMPLEXITY\n\n    def is_ascii_digit(self, ch: str) -> bool:\n        \"\"\"Returns True iff ch is a single-character str in '0'..'9'.\"\"\"\n        return len(ch) == 1 and '0' <= ch <= '9'\n\n    def check_integer(self, s: str) -> bool:\n        \"\"\"Returns True iff s length >= 1 and every character is an ASCII digit.\"\"\"\n        if not s:\n            return False\n        for char in s:\n            if not self.is_ascii_digit(char):\n                return False\n        return True\n\ndef check_integer(s: str) -> bool:\n    \"\"\"Checks if a string represents an integer (one or more ASCII digits).\"\"\"\n    validator = IntegerValidator()\n    return validator.check_integer(s)"}
{"task_id": "Mbpp/118", "solution": "class SplitOperation:\n    \"\"\"Helper class to encapsulate the splitting logic.\"\"\"\n    delimiter: str = ' '\n\n    def perform(self, input_string: str) -> list:\n        \"\"\"Splits the input string by the defined delimiter.\"\"\"\n        return input_string.split(self.delimiter)\n\ndef string_to_list(input_string: str) -> list:\n    \"\"\"\n    Converts a string to a list of strings split on the space character.\n    Uses an internal SplitOperation to perform the split.\n    \"\"\"\n    splitter = SplitOperation()\n    return splitter.perform(input_string)"}
{"task_id": "Mbpp/116", "solution": "class Validator:\n    \"\"\"Provides methods for validating tuple input and its elements.\"\"\"\n\n    def validateIsTuple(self, input_data) -> None:\n        \"\"\"Raises TypeError if the input is not a tuple.\"\"\"\n        if not isinstance(input_data, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n    def validateElementsPositiveIntegers(self, input_tuple: tuple) -> None:\n        \"\"\"Raises ValueError if any element is not a positive integer.\"\"\"\n        for element in input_tuple:\n            if not isinstance(element, int) or element <= 0:\n                raise ValueError(\"All elements must be positive integers.\")\n\nclass Concatenator:\n    \"\"\"Provides a method for concatenating tuple elements into a string.\"\"\"\n\n    def concatenate(self, input_tuple: tuple) -> str:\n        \"\"\"Converts each element to string and joins them without separators.\"\"\"\n        return \"\".join(str(element) for element in input_tuple)\n\nclass TupleToIntService:\n    \"\"\"Orchestrates validation and concatenation to convert a tuple to an integer.\"\"\"\n\n    def __init__(self, validator: Validator, concatenator: Concatenator):\n        self.validator = validator\n        self.concatenator = concatenator\n\n    def tuple_to_int(self, input_tuple: tuple) -> int:\n        \"\"\"Validates the tuple, concatenates its elements, and converts to an integer.\"\"\"\n        self.validator.validateIsTuple(input_tuple)\n        self.validator.validateElementsPositiveIntegers(input_tuple)\n        concatenated_str = self.concatenator.concatenate(input_tuple)\n        return int(concatenated_str)\n\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n    Orchestrates validation and concatenation for the conversion.\n    \"\"\"\n    validator = Validator()\n    concatenator = Concatenator()\n    service = TupleToIntService(validator, concatenator)\n    return service.tuple_to_int(input_tuple)"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple\n\nclass TuplePair:\n    \"\"\"Represents a pair of numeric elements for product computation.\"\"\"\n    def __init__(self, element1: float, element2: float):\n        self.element1 = float(element1)\n        self.element2 = float(element2)\n\n    def abs_product(self) -> float:\n        \"\"\"Computes the absolute product of the two elements.\"\"\"\n        return abs(self.element1 * self.element2)\n\nclass MaxProductService:\n    \"\"\"Service to compute the maximum absolute product from a list of pairs.\"\"\"\n    def max_product_tuple(self, list_of_pairs: List[Tuple[float, float]]) -> float:\n        \"\"\"Consumes list_of_pairs, computes per-tuple abs product, and returns the maximum absolute product.\"\"\"\n        max_abs_product_found = 0.0\n        for pair in list_of_pairs:\n            tuple_pair_obj = TuplePair(pair[0], pair[1])\n            current_abs_product = tuple_pair_obj.abs_product()\n            if current_abs_product > max_abs_product_found:\n                max_abs_product_found = current_abs_product\n        return max_abs_product_found\n\ndef max_product_tuple(list_of_pairs: List[Tuple[float, float]]) -> float:\n    \"\"\"Public API matching SRS: accepts a list of 2-element numeric tuples and returns the maximum absolute product.\"\"\"\n    svc = MaxProductService()\n    return svc.max_product_tuple(list_of_pairs)"}
{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where\n    every other distinct element appears exactly twice.\n    \"\"\"\n\n    def validate_sorted(arr: List[int]) -> bool:\n        \"\"\"\n        Checks if the input list is valid: a non-empty, sorted list of integers\n        with an odd number of elements.\n        \"\"\"\n        if not isinstance(arr, list):\n            return False\n        if not arr:\n            return False\n        if len(arr) % 2 == 0:\n            return False\n        for i in range(len(arr)):\n            if not isinstance(arr[i], int):\n                return False\n            if i > 0 and arr[i] < arr[i-1]:\n                return False\n        return True\n\n    if not validate_sorted(nums):\n        raise ValueError(\"input list not sorted or invariants violated\")\n\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        \n        # Ensure mid is at an even index.\n        # This simplifies checking pairs as (nums[mid], nums[mid+1]).\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If nums[mid] and nums[mid+1] are equal, they form a pair.\n        # The unique element must be in the right half of the array.\n        if nums[mid] == nums[mid+1]:\n            low = mid + 2\n        # Otherwise, nums[mid] is either the unique element or the unique element\n        # is in the left half (before or at mid).\n        else:\n            high = mid\n            \n    return nums[low]"}
{"task_id": "Mbpp/123", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Dict, Set, List\n\n@dataclass\nclass Number:\n    value: int\n    def properDivisorSum(self) -> int:\n        \"\"\"Computes the sum of proper divisors for this number.\"\"\"\n        return _sum_proper_divisors(self.value)\n\n@dataclass\nclass DivisorSum:\n    number: int\n    sum: int\n\n@dataclass\nclass AmicablePair:\n    a: int\n    b: int\n\n@dataclass\nclass Result:\n    n: int\n    sum: int\n    members: List[int]\n\ndef _sum_proper_divisors(value: int) -> int:\n    \"\"\"\n    Computes the sum of proper divisors for a single integer value.\n    Proper divisors exclude the number itself.\n    \"\"\"\n    if value <= 1:\n        return 0\n    \n    total_sum = 1 \n    for i in range(2, int(math.sqrt(value)) + 1):\n        if value % i == 0:\n            total_sum += i\n            if i * i != value:\n                total_sum += value // i\n    return total_sum\n\ndef _compute_divisor_sums(limit: int) -> Dict[int, int]:\n    \"\"\"\n    Computes sum of proper divisors for every integer i in 1..limit using a sieve-like approach.\n    Returns a mapping from each number to its sum of proper divisors.\n    \"\"\"\n    if limit < 1:\n        return {}\n    \n    proper_divisor_sums = {i: 0 for i in range(1, limit + 1)}\n    \n    for i in range(1, limit // 2 + 1):\n        for multiple in range(2 * i, limit + 1, i):\n            proper_divisor_sums[multiple] += i\n            \n    return proper_divisor_sums\n\ndef _identify_amicable_numbers(limit: int, divisor_sums: Dict[int, int]) -> Set[int]:\n    \"\"\"\n    Identifies amicable numbers within the given limit using precomputed divisor sums.\n    Ensures that numbers are distinct (a != b) and within the specified limit.\n    \"\"\"\n    amicable_set: Set[int] = set()\n\n    for a in range(1, limit + 1):\n        s_a = divisor_sums.get(a, 0)\n\n        # Check conditions for an amicable pair (a, s_a)\n        # s_a must be within the limit and s_a != a to avoid self-referencing and out-of-bounds.\n        if s_a > a and s_a <= limit:\n            s_b = divisor_sums.get(s_a, 0)\n            if s_b == a:\n                amicable_set.add(a)\n                amicable_set.add(s_a)\n                \n    return amicable_set\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Compute and return the sum of unique amicable numbers within inclusive range [1, n].\n    \"\"\"\n    if n < 1:\n        return 0\n\n    divisor_sums = _compute_divisor_sums(n)\n    amicable_set = _identify_amicable_numbers(n, divisor_sums)\n    \n    total = sum(amicable_set)\n    \n    return total"}
{"task_id": "Mbpp/124", "solution": "import math\n\nclass AngleResult:\n    \"\"\"Holds the computed angle in radians.\"\"\"\n    def __init__(self, radians: float):\n        self.radians: float = float(radians)\n\n    def to_float(self) -> float:\n        \"\"\"Returns the angle as a float.\"\"\"\n        return self.radians\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real: float = float(real)\n        self.imag: float = float(imag)\n\n    def angle(self) -> float:\n        \"\"\"Computes the angle (argument) of the complex number.\"\"\"\n        return math.atan2(self.imag, self.real)\n\n    def magnitude(self) -> float:\n        \"\"\"Computes the magnitude of the complex number.\"\"\"\n        return math.hypot(self.real, self.imag)\n\nclass AngleCalculator:\n    \"\"\"Calculates the angle of complex-like inputs, handling parsing and validation.\"\"\"\n    def angle_complex(self, *args) -> AngleResult:\n        \"\"\"\n        Accepts either (z) single arg or (real, imag) two args.\n        Parses/validates inputs, computes atan2(imag, real), returns AngleResult.\n        \"\"\"\n        if len(args) == 1:\n            real, imag = self._parse_single(args[0])\n        elif len(args) == 2:\n            real = self._validate_numeric(args[0])\n            imag = self._validate_numeric(args[1])\n        else:\n            raise TypeError(\"angle_complex accepts either (z) or (real, imag)\")\n\n        radians = math.atan2(imag, real)\n        return AngleResult(radians)\n\n    def _parse_single(self, arg) -> tuple[float, float]:\n        \"\"\"\n        Extracts real and imag numeric components from complex-like arg.\n        Accepts Python native complex or objects exposing .real and .imag.\n        \"\"\"\n        if isinstance(arg, complex):\n            return float(arg.real), float(arg.imag)\n        elif hasattr(arg, 'real') and hasattr(arg, 'imag'):\n            try:\n                return float(arg.real), float(arg.imag)\n            except (TypeError, ValueError) as e:\n                raise TypeError(f\"Complex-like object attributes .real and .imag must be convertible to float: {e}\") from e\n        else:\n            raise TypeError(\"Single argument must be a complex number or an object with .real and .imag attributes.\")\n\n    def _validate_numeric(self, x) -> float:\n        \"\"\"\n        Validates and coerces numeric types (int, float) to float.\n        Raises TypeError for invalid types.\n        \"\"\"\n        if isinstance(x, (int, float)):\n            return float(x)\n        else:\n            raise TypeError(\"Real and imaginary parts must be numeric (int or float).\")\n\ndef angle_complex(*args) -> float:\n    \"\"\"\n    Public API: accepts either (z) or (real, imag). Returns angle in radians as float.\n    Raises: TypeError for invalid input forms.\n    \"\"\"\n    calculator = AngleCalculator()\n    if len(args) == 1:\n        result = calculator.angle_complex(args[0])\n    elif len(args) == 2:\n        result = calculator.angle_complex(args[0], args[1])\n    else:\n        raise TypeError(\"angle_complex accepts either (z) or (real, imag)\")\n    return result.radians"}
{"task_id": "Mbpp/126", "solution": "def _positive_divisors(n: int) -> set[int]:\n    \"\"\"\n    Finds all positive divisors of a non-negative integer n.\n    Returns a set of these divisors.\n    \"\"\"\n    if n == 0:\n        return set()\n    if n == 1:\n        return {1}\n\n    divs = {1, n}\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return divs\n\ndef _common_divisors(a: int, b: int) -> list[int]:\n    \"\"\"\n    Computes the set of positive common divisors for integers a and b.\n    Uses absolute values of inputs to determine common positive divisors.\n    \"\"\"\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    divs_a = _positive_divisors(a_abs)\n    divs_b = _positive_divisors(b_abs)\n\n    common = divs_a.intersection(divs_b)\n    return list(common)\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    It considers the absolute values of the input integers.\n    \"\"\"\n    common_divs = _common_divisors(a, b)\n    return sum(common_divs)"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring of a binary string.\n    The difference is calculated as (number of '0's) - (number of '1's).\n    Uses a single-pass O(n) time, O(1) space dynamic programming approach similar to Kadane's algorithm.\n    \"\"\"\n    if not s:\n        return 0\n\n    # Validate input contains only '0' and '1' characters.\n    for char in s:\n        if char not in ('0', '1'):\n            raise ValueError(\"Input string must contain only '0' and '1' characters.\")\n\n    max_overall_diff = -float('inf')\n    current_subarray_diff = 0\n\n    for char in s:\n        # Transform '0' to 1 and '1' to -1 for sum calculation\n        value = 1 if char == '0' else -1\n        \n        current_subarray_diff += value\n        \n        # Update the maximum difference found so far\n        max_overall_diff = max(max_overall_diff, current_subarray_diff)\n        \n        # If the current subarray sum becomes negative, reset it to 0.\n        # This is because a negative prefix will only decrease the sum of any future subarray.\n        if current_subarray_diff < 0:\n            current_subarray_diff = 0\n            \n    # Handle the case where all characters are '1' and max_overall_diff remained negative.\n    # In this specific scenario, current_subarray_diff would repeatedly reset to 0,\n    # and max_overall_diff would only capture single '1' differences (e.g., -1 for \"111\").\n    # If the input contains only '1's, the Kadane-like reset to 0 logic\n    # correctly finds the max difference of a single '1' substring, which is -1.\n    # If `max_overall_diff` is still -inf after the loop, it implies an empty string\n    # which is handled at the beginning. Thus, it will always be a valid number if `s` is not empty.\n    \n    return max_overall_diff"}
