{"task_id": "Mbpp/739", "solution": "from dataclasses import dataclass\nfrom typing import Any\n\n_ERROR_MSG = \"n must be a positive integer\"\n\n@dataclass\nclass TriangularNumber:\n    k: int\n    value: int\n    digits: int\n\ndef _compute_triangular(k: int) -> int:\n    \"\"\"Computes the k-th triangular number.\"\"\"\n    return k * (k + 1) // 2\n\ndef _digits_of(value: int) -> int:\n    \"\"\"Counts the number of decimal digits in an integer using string conversion.\"\"\"\n    return len(str(abs(value)))\n\ndef find_Index(n: int) -> int:\n    \"\"\"Finds the index of the smallest triangular number with n digits.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(_ERROR_MSG)\n\n    k = 1\n    while True:\n        triangular_value = _compute_triangular(k)\n        num_digits = _digits_of(triangular_value)\n        \n        current_triangular = TriangularNumber(k=k, value=triangular_value, digits=num_digits)\n\n        if current_triangular.digits == n:\n            return current_triangular.k\n        \n        k += 1"}
{"task_id": "Mbpp/737", "solution": "import re\nfrom typing import Optional\n\nclass InputString:\n    \"\"\"Encapsulates the provided input string and provides accessors.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n    def charAt(self, pos: int) -> str:\n        \"\"\"Returns the character at the specified position.\"\"\"\n        return self.value[pos]\n\nclass RegexPattern:\n    \"\"\"Encapsulates a regular expression and provides a match operation.\"\"\"\n    expr: str = '^[aeiou]'\n\n    def __init__(self, expr: Optional[str] = None) -> None:\n        self.expr = expr if expr is not None else RegexPattern.expr\n\n    def match(self, s: str) -> bool:\n        \"\"\"Checks if the given string matches the encapsulated pattern.\"\"\"\n        return bool(re.match(self.expr, s))\n\nclass CheckResult:\n    \"\"\"Represents the boolean outcome of the vowel-start check.\"\"\"\n    def __init__(self, isVowelStart: bool) -> None:\n        self.isVowelStart = isVowelStart\n\n    def asBoolean(self) -> bool:\n        \"\"\"Returns the boolean result.\"\"\"\n        return self.isVowelStart\n\nclass VowelChecker:\n    \"\"\"Orchestrates the check for a string starting with a vowel.\"\"\"\n    def __init__(self, pattern: Optional[RegexPattern] = None) -> None:\n        self.pattern = pattern if pattern is not None else RegexPattern()\n\n    def check_str(self, input: InputString) -> CheckResult:\n        \"\"\"Evaluates if the InputString starts with a vowel using the regex pattern.\"\"\"\n        match_outcome = self.pattern.match(input.value)\n        return CheckResult(match_outcome)\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks whether the given string is starting with a vowel using regex.\n    \"\"\"\n    input_obj = InputString(input_string)\n    checker = VowelChecker()\n    result = checker.check_str(input_obj)\n    return result.asBoolean()"}
