{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, remove: str) -> str:\n    # Build a set of characters from the 'remove' string for efficient lookup.\n    removal_set = set(remove)\n    \n    # Collect characters from 'source' that are not in the removal set.\n    collected_chars = []\n    for char in source:\n        if char not in removal_set:\n            collected_chars.append(char)\n            \n    # Join the collected characters to form the final string.\n    return ''.join(collected_chars)"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\nclass DuplicateDetector:\n    \"\"\"Encapsulates the algorithm to detect duplicate elements in an array.\"\"\"\n    def test_duplicate(self, array: List[int]) -> bool:\n        \"\"\"Determines if the array contains any duplicate elements.\"\"\"\n        return self._has_duplicate(array)\n\n    def _has_duplicate(self, array: List[int]) -> bool:\n        \"\"\"Private helper to check for duplicates using a set.\"\"\"\n        seen = set()\n        for v in array:\n            if v in seen:\n                return True\n            seen.add(v)\n        return False\n\ndef test_duplicate(array: List[int]) -> bool:\n    \"\"\"\n    Finds whether a given array of integers contains any duplicate element.\n    Returns True if duplicates are found, False otherwise.\n    \"\"\"\n    return DuplicateDetector().test_duplicate(array)"}
{"task_id": "Mbpp/12", "solution": "def _compute_row_sums(matrix: list) -> list:\n    \"\"\"Computes the sum for each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef _stable_sort_rows_by_sum(matrix: list, row_sums: list) -> list:\n    \"\"\"Stably sorts rows based on their pre-computed sums.\"\"\"\n    # Pair rows with their sums; Python's sorted() is stable.\n    paired_data = [(row_sums[i], matrix[i]) for i in range(len(matrix))]\n    \n    # Sort by the sum (first element of the tuple)\n    sorted_paired_data = sorted(paired_data, key=lambda x: x[0])\n    \n    # Extract just the sorted rows\n    sorted_matrix = [row for _, row in sorted_paired_data]\n    \n    return sorted_matrix\n\ndef sort_matrix(matrix: list) -> list:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    This function assumes valid input (a 2D list of numeric elements) as per direct instruction.\n    \"\"\"\n    if not matrix:\n        return []\n\n    row_sums = _compute_row_sums(matrix)\n    sorted_matrix = _stable_sort_rows_by_sum(matrix, row_sums)\n\n    return sorted_matrix"}
{"task_id": "Mbpp/16", "solution": "import re\n\nPATTERN_REGEX: str = \"[a-z]+_[a-z]+\"\n\nclass Pattern:\n    \"\"\"Represents the regex pattern for matching.\"\"\"\n    def __init__(self, regex: str = PATTERN_REGEX) -> None:\n        self.regex = regex\n\nclass TextInput:\n    \"\"\"A lightweight container for input string values.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass MatchResult:\n    \"\"\"A lightweight container for boolean match results.\"\"\"\n    def __init__(self, matched: bool) -> None:\n        self.matched = matched\n\nclass TextLowercaseUnderscoreFunction:\n    \"\"\"Encapsulates the logic for detecting the lowercase-underscore pattern.\"\"\"\n    name: str = \"text_lowercase_underscore\"\n    _compiled_pattern: re.Pattern\n\n    def __init__(self, pattern: Pattern) -> None:\n        self._compiled_pattern = re.compile(pattern.regex, flags=re.ASCII)\n\n    def execute(self, input: str) -> bool:\n        \"\"\"Executes the pattern search on the given input string.\"\"\"\n        return bool(self._compiled_pattern.search(input))\n\n_pattern_instance = Pattern(PATTERN_REGEX)\n_function_instance = TextLowercaseUnderscoreFunction(_pattern_instance)\n\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    return _function_instance.execute(input)"}
{"task_id": "Mbpp/56", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputNumber:\n    value: int\n\n@dataclass\nclass ReversedNumber:\n    value: int\n\nclass ReverseOperation:\n    @staticmethod\n    def compute(n: int) -> int:\n        \"\"\"\n        Computes the reversed integer, ignoring leading zeros in the reversed result.\n        \"\"\"\n        s = str(abs(n))\n        rev_s = s[::-1]\n        rev = int(rev_s)\n        return rev\n\nclass Comparator:\n    @staticmethod\n    def equalsTwiceMinusOne(n: int, rev: int) -> bool:\n        \"\"\"\n        Checks if n is one less than twice its reversed value.\n        \"\"\"\n        return n == 2 * rev - 1\n\ndef check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    input_num = InputNumber(value=n)\n    rev_val = ReverseOperation.compute(input_num.value)\n    reversed_num = ReversedNumber(value=rev_val)\n    return Comparator.equalsTwiceMinusOne(input_num.value, reversed_num.value)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    if n < 1:\n        return False\n\n    k = 1\n    while True:\n        candidate = k * (2**k) - 1\n        if candidate == n:\n            return True\n        if candidate > n:\n            return False\n        k += 1"}
