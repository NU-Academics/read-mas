{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\nclass Coordinate:\n    \"\"\"Data container for a single coordinate pair (x, y).\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = x\n        self.y = y\n\n    def to_list(self) -> List[int]:\n        \"\"\"Converts the Coordinate object to a list of two integers [x, y].\"\"\"\n        return [self.x, self.y]\n\nclass CoordinatesList:\n    \"\"\"Container for a list of Coordinate objects.\"\"\"\n    def __init__(self, coordinates: List[Coordinate]):\n        self.coordinates = coordinates\n\n    def size(self) -> int:\n        \"\"\"Returns the number of coordinates in the list.\"\"\"\n        return len(self.coordinates)\n\n    def to_list(self) -> List[List[int]]:\n        \"\"\"Converts the list of Coordinate objects to a list of lists of integers.\"\"\"\n        return [coord.to_list() for coord in self.coordinates]\n\nclass GetCoordinatesService:\n    \"\"\"Encapsulates neighbor generation, ordering, and conversion logic.\"\"\"\n\n    def get_coordinates(self, coord: Tuple[int, int]) -> List[List[int]]:\n        \"\"\"Generates, orders, and converts adjacent coordinates for a given (x, y) tuple.\"\"\"\n        x, y = coord\n        neighbor_coords = self._generate_neighbors(x, y)\n        ordered_coords = self._order_coordinates(neighbor_coords)\n        return self._to_list_repr(ordered_coords)\n\n    def _generate_neighbors(self, x: int, y: int) -> List[Coordinate]:\n        \"\"\"Generates all 9 adjacent Coordinate objects for a central (x, y).\"\"\"\n        neighbors = []\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                neighbors.append(Coordinate(x + dx, y + dy))\n        return neighbors\n\n    def _order_coordinates(self, coords: List[Coordinate]) -> List[Coordinate]:\n        \"\"\"Orders a list of Coordinate objects by ascending x then ascending y.\"\"\"\n        return sorted(coords, key=lambda c: (c.x, c.y))\n\n    def _to_list_repr(self, coords: List[Coordinate]) -> List[List[int]]:\n        \"\"\"Converts a list of Coordinate objects to its list-of-lists representation.\"\"\"\n        coords_list_wrapper = CoordinatesList(coords)\n        return coords_list_wrapper.to_list()\n\n\ndef get_coordinates(coord: tuple) -> list:\n    \"\"\"\n    get_coordinates(coord: tuple) -> list: returns ordered list of 9 [x,y] pairs.\n    Extracts all adjacent coordinates of the given coordinate tuple.\n    \"\"\"\n    service = GetCoordinatesService()\n    return service.get_coordinates(coord)"}
{"task_id": "Mbpp/631", "solution": "def is_whitespace(ch: str) -> bool:\n    \"\"\"Return True if ch is one of: space, '\\\\t', '\\\\n'.\"\"\"\n    return ch == ' ' or ch == '\\t' or ch == '\\n'\n\ndef is_underscore(ch: str) -> bool:\n    \"\"\"Return True if ch == '_'.\"\"\"\n    return ch == '_'\n\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"Replaces specific whitespace characters with underscores and vice versa in a string. Each character is processed once according to defined rules.\"\"\"\n    result_chars = []\n    for ch in input_string:\n        if is_whitespace(ch):\n            result_chars.append('_')\n        elif is_underscore(ch):\n            result_chars.append(' ')\n        else:\n            result_chars.append(ch)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"Accepts a Python list and returns a list with zeros moved to the end.\n\n    Args:\n        input_list: list\n\n    Returns:\n        list\n    \"\"\"\n    non_zero_buffer = []\n    zero_count = 0\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zero_buffer.append(element)\n    non_zero_buffer.extend([0] * zero_count)\n    return non_zero_buffer"}
