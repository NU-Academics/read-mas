{"task_id": "Mbpp/439", "solution": "from typing import List\n\ndef multiple_to_single(list_of_ints: List[int]) -> int:\n    \"\"\"\n    Joins a list of integers into a single integer by concatenating their string representations.\n    Returns 0 for an empty list.\n    \"\"\"\n    if not list_of_ints:\n        return 0\n    string_parts = [str(num) for num in list_of_ints]\n    concatenated_string = \"\".join(string_parts)\n    return int(concatenated_string)"}
{"task_id": "Mbpp/440", "solution": "import re\nfrom typing import List, Optional, Tuple\n\nclass Token:\n    \"\"\"Represents a token extracted from a sentence, including raw and normalized spans.\"\"\"\n    def __init__(self, raw_text: str, raw_start: int, raw_end: int):\n        self.raw_text: str = raw_text\n        self.start_index: int = raw_start  # may be adjusted by normalize\n        self.end_index: int = raw_end      # may be adjusted by normalize\n        self.is_punctuation: bool = False\n        self.is_adverb: bool = False\n\n    def normalize(self) -> str:\n        \"\"\"Strips surrounding punctuation and updates start_index/end_index to the alphabetic span.\"\"\"\n        original_text = self.raw_text\n        start_offset = 0\n        end_offset = len(original_text)\n\n        while start_offset < end_offset and not original_text[start_offset].isalnum():\n            start_offset += 1\n        while end_offset > start_offset and not original_text[end_offset - 1].isalnum():\n            end_offset -= 1\n\n        self.start_index = self.raw_start + start_offset\n        self.end_index = self.raw_start + end_offset\n        return original_text[start_offset:end_offset]\n\nclass Adverb(Token):\n    pass\n\ndef tokenize(text: str) -> List[Token]:\n    \"\"\"Splits text on whitespace and punctuation, producing Token instances with raw spans.\"\"\"\n    tokens = []\n    # Regex to split on whitespace and punctuation, keeping punctuation as separate tokens\n    # Also handles cases where punctuation is attached to words\n    pattern = re.compile(r\"(\\w+|[^\\w\\s]+|\\s+)\")\n    \n    current_index = 0\n    for match in pattern.finditer(text):\n        match_text = match.group(0)\n        start = match.start()\n        end = match.end()\n\n        if match_text.strip(): # Ignore empty strings from multiple spaces etc.\n            token = Token(match_text, start, end)\n            if not any(c.isalnum() for c in match_text): # Heuristic for pure punctuation tokens\n                token.is_punctuation = True\n            tokens.append(token)\n        current_index = end\n    return tokens\n\nclass AdverbDetector:\n    def is_adverb(self, token: Token) -> bool:\n        raise NotImplementedError\n\nclass DefaultAdverbDetector(AdverbDetector):\n    def is_adverb(self, token: Token) -> bool:\n        \"\"\"Detects adverbs using a conservative heuristic: ends with 'ly' (case-insensitive) and has alphabetic chars.\"\"\"\n        normalized_text = token.normalize()\n        return bool(normalized_text) and normalized_text.lower().endswith('ly') and any(c.isalpha() for c in normalized_text)\n\nclass Sentence:\n    \"\"\"Sentence domain class that holds original text, token list, tokenization and adverb-finding operations.\"\"\"\n    def __init__(self, text: str, detector: AdverbDetector):\n        self.text: str = text\n        self.tokens: List[Token] = []\n        self._detector = detector\n        self.tokenize() # Tokenize upon initialization\n\n    def tokenize(self) -> None:\n        \"\"\"Populate self.tokens by splitting text on whitespace and punctuation.\"\"\"\n        self.tokens = tokenize(self.text)\n\n    def find_first_adverb(self) -> Optional[Tuple[int,int,str]]:\n        \"\"\"Iterate tokens in order and return (start, end, text) for first adverb or None.\"\"\"\n        for token in self.tokens:\n            if self._detector.is_adverb(token):\n                return (token.start_index, token.end_index, token.normalize())\n        return None\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\"\"\"\n    detector = DefaultAdverbDetector()\n    s = Sentence(sentence, detector=detector)\n    return s.find_first_adverb()"}
{"task_id": "Mbpp/441", "solution": "import math\n\nclass InputValidator:\n    \"\"\"\n    Validates if a given value is numeric (int or float) and finite.\n    \"\"\"\n    def is_numeric(self, value) -> bool:\n        \"\"\"\n        Checks if the value is a finite number (integer or float).\n        \"\"\"\n        return isinstance(value, (int, float)) and math.isfinite(value)\n\nclass SurfaceAreaCalculator:\n    \"\"\"\n    Calculates the surface area of geometric shapes.\n    \"\"\"\n    def _calculate_surface_area(self, size) -> float:\n        \"\"\"\n        Calculates the surface area of a cube given its side length.\n        \"\"\"\n        return 6 * size * size\n\ndef surfacearea_cube(size) -> float:\n    \"\"\"\n    Calculates the surface area of a cube with a given side length.\n    Raises ValueError if the input 'size' is not a numeric value.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_numeric(size):\n        raise ValueError(\"size must be numeric\")\n\n    calculator = SurfaceAreaCalculator()\n    return calculator._calculate_surface_area(size)"}
