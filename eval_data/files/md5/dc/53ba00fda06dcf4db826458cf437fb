{"task_id": "Mbpp/223", "solution": "def is_majority(array, n, x):\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    def _lower_bound(arr, target):\n        \"\"\"\n        Finds the first index 'i' in a sorted array where arr[i] >= target.\n        Returns len(arr) if no such element is found.\n        \"\"\"\n        low, high = 0, len(arr)\n        ans = len(arr)\n        while low < high:\n            mid = low + (high - low) // 2\n            if arr[mid] >= target:\n                ans = mid\n                high = mid\n            else:\n                low = mid + 1\n        return ans\n\n    def _upper_bound(arr, target):\n        \"\"\"\n        Finds the first index 'i' in a sorted array where arr[i] > target.\n        Returns len(arr) if no such element is found.\n        \"\"\"\n        low, high = 0, len(arr)\n        ans = len(arr)\n        while low < high:\n            mid = low + (high - low) // 2\n            if arr[mid] > target:\n                ans = mid\n                high = mid\n            else:\n                low = mid + 1\n        return ans\n\n    def _count_occurrences(arr, element):\n        \"\"\"Counts occurrences of an element in a sorted array using binary search.\"\"\"\n        first_idx = _lower_bound(arr, element)\n\n        # If the element is not found at the first_idx position\n        if first_idx == len(arr) or arr[first_idx] != element:\n            return 0\n\n        # Find the index just after the last occurrence\n        last_idx = _upper_bound(arr, element)\n\n        return last_idx - first_idx\n\n    def _validate_parameters(arr, length):\n        \"\"\"Validates that n is non-negative and matches the array length.\"\"\"\n        if length < 0:\n            return False\n        if len(arr) != length:\n            return False\n        return True\n\n    # Main logic\n    if not _validate_parameters(array, n):\n        return False\n\n    if n == 0:\n        return False\n\n    count = _count_occurrences(array, x)\n\n    return count > (n / 2)"}
{"task_id": "Mbpp/227", "solution": "def min_of_three(a, b, c):\n    \"\"\"Validate a, b, c are numeric then return minimal value among them. Raises TypeError on invalid input.\"\"\"\n\n    def validate_inputs(val1, val2, val3):\n        \"\"\"Raise TypeError if any of val1, val2, val3 is not int or float.\"\"\"\n        if not isinstance(val1, (int, float)):\n            raise TypeError(f\"Input 'a' must be a numeric type (int or float), but got {type(val1).__name__}\")\n        if not isinstance(val2, (int, float)):\n            raise TypeError(f\"Input 'b' must be a numeric type (int or float), but got {type(val2).__name__}\")\n        if not isinstance(val3, (int, float)):\n            raise TypeError(f\"Input 'c' must be a numeric type (int or float), but got {type(val3).__name__}\")\n\n    def compute_min(val1, val2, val3):\n        \"\"\"Return the smallest of val1, val2, val3. Assumes inputs are numeric.\"\"\"\n        return min(val1, val2, val3)\n\n    validate_inputs(a, b, c)\n    return compute_min(a, b, c)"}
{"task_id": "Mbpp/234", "solution": "def volume_cube(side_length):\n    \"\"\"Compute and return the volume of a cube.\n\n    Signature required by SRS: volume_cube(side_length)\n    Formula (BR2): return side_length * side_length * side_length\n    \"\"\"\n    return side_length * side_length * side_length"}
{"task_id": "Mbpp/230", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input parameters.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass ReplacementChar:\n    \"\"\"\n    Value holder for the replacement character with validation logic.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        return len(self.value) == 1\n\nclass InputString:\n    \"\"\"\n    Value holder for the input string.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass OutputString:\n    \"\"\"\n    Value holder for the output string.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass StringProcessor:\n    \"\"\"\n    Encapsulates the logic for validating the character and replacing blank spaces.\n    \"\"\"\n    def replace_blank(self, input_string: str, replacement_char: str) -> str:\n        char_validator = ReplacementChar(replacement_char)\n        if not char_validator.is_valid():\n            raise ValidationError(\"replacement_char must be exactly one character long\")\n\n        return input_string.replace(' ', replacement_char)\n\ndef replace_blank(input_string: str, replacement_char: str) -> str:\n    \"\"\"\n    Replaces blank spaces in the string with the specified character and returns the modified string.\n    \"\"\"\n    processor = StringProcessor()\n    return processor.replace_blank(input_string, replacement_char)"}
{"task_id": "Mbpp/233", "solution": "import math\n\nclass Cylinder:\n    \"\"\"Represents a cylinder with a given height and radius.\"\"\"\n    def __init__(self, height: float, radius: float) -> None:\n        self.height = height\n        self.radius = radius\n\n    def lateral_surface_area(self) -> float:\n        \"\"\"Computes the lateral surface area of the cylinder.\"\"\"\n        return 2 * math.pi * self.radius * self.height\n\nclass NumericResult:\n    \"\"\"A data holder for a numeric float value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass LateraIServiceFunction:\n    \"\"\"Provides the service to compute the lateral surface area of a cylinder.\"\"\"\n    def __init__(self, name: str = \"lateralsuface_cylinder\") -> None:\n        self.name = name\n\n    def compute(self, height: float, radius: float) -> NumericResult:\n        \"\"\"Computes the lateral surface area for a cylinder and returns it as a NumericResult.\"\"\"\n        cylinder = Cylinder(height, radius)\n        area = cylinder.lateral_surface_area()\n        return NumericResult(area)\n\nclass ValidationTest:\n    \"\"\"Validates an actual value against an expected value with a relative tolerance.\"\"\"\n    def __init__(self, expected: float, rel_tol: float = 0.001) -> None:\n        self.expected = expected\n        self.rel_tol = rel_tol\n\n    def validate(self, actual: float) -> bool:\n        \"\"\"Compares actual and expected values using math.isclose.\"\"\"\n        return math.isclose(actual, self.expected, rel_tol=self.rel_tol)\n\ndef lateralsuface_cylinder(height, radius):\n    \"\"\"\n    Computes the lateral surface area of a cylinder.\n\n    The area is calculated using the formula: 2 * pi * radius * height.\n    \"\"\"\n    h = float(height)\n    r = float(radius)\n    svc = LateraIServiceFunction(name=\"lateralsuface_cylinder\")\n    result_obj = svc.compute(h, r)\n    return float(result_obj.value)"}
{"task_id": "Mbpp/232", "solution": "def larg_nnum(list_input, n):\n    \"\"\"\n    Returns a list containing the n largest items from the input list.\n    Handles n=0 by returning an empty list, and n > len(list_input) by returning all items.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Sort the list in ascending order to easily pick the largest items\n    sorted_list = sorted(list_input)\n\n    # Return the last n elements from the sorted list.\n    # If n is greater than the list's length, this slice will return the entire list.\n    return sorted_list[-n:]"}
{"task_id": "Mbpp/235", "solution": "class BitMask:\n    @staticmethod\n    def generate_for_width(width: int) -> int:\n        \"\"\"Construct an integer mask with 1s at every even position (1-indexed) up to width.\"\"\"\n        mask = 0\n        for p in range(2, width + 1, 2):\n            mask |= (1 << (p - 1)) # Convert 1-indexed position to 0-indexed bit\n        return mask\n\nclass BitManipulator:\n    @staticmethod\n    def even_bit_set_number(n: int) -> int:\n        \"\"\"Compute and return n | mask_of_even_positions.\"\"\"\n        # Derive width, ensuring at least 1 bit for n=0 case (n.bit_length() is 0 for n=0).\n        width = max(1, n.bit_length())\n        # Generate the appropriate even-bit mask for the determined width.\n        mask = BitMask.generate_for_width(width)\n        # Apply the mask using a bitwise OR operation.\n        return n | mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Public API: return integer equal to n with all even-positioned bits set to 1.\"\"\"\n    return BitManipulator.even_bit_set_number(n)"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s):\n    \"\"\"\n    Counts the number of non-empty contiguous substrings of a given string.\n    Uses a closed-form formula for efficiency.\n    \"\"\"\n    n = len(s)\n    return n * (n + 1) // 2"}
{"task_id": "Mbpp/237", "solution": "from typing import Any, Dict, Tuple, List\n\ndef _is_two_element_tuple(obj: Any) -> bool:\n    \"\"\"Checks if an object is a 2-element tuple.\"\"\"\n    return isinstance(obj, tuple) and len(obj) == 2\n\ndef _normalize_to_sorted_tuple(pair: tuple) -> tuple:\n    \"\"\"Returns a tuple with elements in non-decreasing order.\"\"\"\n    return tuple(sorted(pair))\n\nclass Validator:\n    \"\"\"Validates the input list structure.\"\"\"\n    def validate(self, input_list: list) -> None:\n        if not isinstance(input_list, list):\n            raise TypeError(\"input must be a list of 2-element tuples\")\n        for element in input_list:\n            if not _is_two_element_tuple(element):\n                raise TypeError(\"each element must be a 2-element tuple\")\n\nclass Counter:\n    \"\"\"Aggregates counts of normalized tuples.\"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[tuple, int] = {}\n\n    def increment(self, key: tuple) -> None:\n        \"\"\"Increments the count for a given tuple key.\"\"\"\n        self._counts[key] = self._counts.get(key, 0) + 1\n\n    def get_counts(self) -> Dict[tuple, int]:\n        \"\"\"Returns the dictionary of accumulated counts.\"\"\"\n        return self._counts\n\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"Validate input, normalize each 2-element tuple, count occurrences, and return a dictionary mapping normalized tuples to counts.\"\"\"\n    validator = Validator()\n    validator.validate(input_list)\n\n    counter = Counter()\n    for pair in input_list:\n        normalized = _normalize_to_sorted_tuple(pair)\n        counter.increment(normalized)\n\n    return counter.get_counts()"}
