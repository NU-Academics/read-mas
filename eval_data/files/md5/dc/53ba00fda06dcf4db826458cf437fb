{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple, Any\n\ndef max_length(input_list: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"Accepts a list of lists and returns a tuple (max_length:int, sublist:list).\n\n    If input_list is empty, return (0, []). If multiple sublists share maximum length, return the first such sublist.\n    \"\"\"\n    if not input_list:\n        return (0, [])\n\n    max_len = 0\n    max_sublist = []\n\n    for sublist in input_list:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_sublist = sublist\n            \n    return (max_len, max_sublist)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"\n    Computes the sum of squares of the first n even natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    result = (2 * n * (n + 1) * (2 * n + 1)) // 3\n    return result"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, List, Optional\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Return True if value is an int or float (exclude bool).\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef max_val(list: List[Any]) -> Optional[float]:\n    \"\"\"Return the highest numeric value in 'list' ignoring non-numeric elements; return None if no numeric elements found.\"\"\"\n    filtered_numerics = [v for v in list if _is_numeric(v)]\n    if not filtered_numerics:\n        return None\n    return max(filtered_numerics)"}
{"task_id": "Mbpp/293", "solution": "import math\n\nclass MathEngine:\n    \"\"\"Provides basic mathematical operations.\"\"\"\n    def square(self, x: float) -> float:\n        \"\"\"Returns the square of a number.\"\"\"\n        return float(x * x)\n\n    def sqrt(self, x: float) -> float:\n        \"\"\"Returns the square root of a number.\"\"\"\n        return float(math.sqrt(x))\n\nclass RightAngledTriangle:\n    \"\"\"Represents a right-angled triangle and computes its hypotenuse.\"\"\"\n    def __init__(self, a: float, b: float):\n        self.a = a\n        self.b = b\n        self.hypotenuse = 0.0\n\n    def computeHypotenuse(self) -> float:\n        \"\"\"Calculates the hypotenuse using the Pythagorean theorem.\"\"\"\n        engine = MathEngine()\n        a_sq = engine.square(self.a)\n        b_sq = engine.square(self.b)\n        sum_sq = a_sq + b_sq\n        self.hypotenuse = engine.sqrt(sum_sq)\n        return self.hypotenuse\n\ndef _compute_using_model(a: float, b: float) -> float:\n    \"\"\"Helper function to compute hypotenuse using the RightAngledTriangle model.\"\"\"\n    tri = RightAngledTriangle(a=a, b=b)\n    return tri.computeHypotenuse()\n\ndef otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given the lengths of the other two sides.\n    Assumes valid, finite numeric inputs.\n    \"\"\"\n    hyp = _compute_using_model(a, b)\n    return float(hyp)"}
{"task_id": "Mbpp/296", "solution": "def _count_and_merge(left: list, right: list) -> (list, int):\n    \"\"\"\n    Internal helper that merges two sorted lists and counts cross inversions.\n    Returns (merged_list, cross_inversions).\n    \"\"\"\n    merged_list = []\n    inversions = 0\n    i, j = 0, 0\n    len_left = len(left)\n\n    while i < len_left and j < len(right):\n        if left[i] <= right[j]:\n            merged_list.append(left[i])\n            i += 1\n        else:\n            # An inversion is found: left[i] > right[j].\n            # All remaining elements in left from index i onwards are also greater than right[j].\n            merged_list.append(right[j])\n            inversions += (len_left - i)\n            j += 1\n\n    merged_list.extend(left[i:])\n    merged_list.extend(right[j:])\n\n    return merged_list, inversions\n\nclass InversionCounter:\n    \"\"\"\n    Encapsulates divide-and-conquer algorithm. Provides count(values: list) -> int\n    used by get_Inv_Count.\n    \"\"\"\n    def count(self, values: list) -> (list, int):\n        \"\"\"\n        Recursive algorithm to count inversions and return a sorted list.\n        Returns (sorted_list, inversion_count).\n        \"\"\"\n        n = len(values)\n        if n <= 1:\n            return values, 0\n\n        mid = n // 2\n        left_half = values[:mid]\n        right_half = values[mid:]\n\n        sorted_left, left_inversions = self.count(left_half)\n        sorted_right, right_inversions = self.count(right_half)\n\n        merged_list, cross_inversions = _count_and_merge(sorted_left, sorted_right)\n\n        total_inversions = left_inversions + right_inversions + cross_inversions\n        return merged_list, total_inversions\n\ndef get_Inv_Count(values: list) -> int:\n    \"\"\"\n    Public function required by SRS. Accepts a single parameter (list/array).\n    Returns int inversion count. Must not modify input list.\n    \"\"\"\n    if not values:\n        return 0\n\n    # Create a shallow copy to preserve the original input list\n    values_copy = list(values)\n\n    counter = InversionCounter()\n    _, total_inversions = counter.count(values_copy)\n\n    return total_inversions"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input) -> list:\n    \"\"\"Public API per FR1/BR1. Returns a new flattened list per BR2/BR3/BR4/BR5.\"\"\"\n    flattened_output = []\n    for item in input:\n        _flatten_recursive(item, flattened_output)\n    return flattened_output\n\ndef _flatten_recursive(item, output) -> None:\n    \"\"\"Internal helper. Mutates output by appending non-list items found within item via depth-first, left-to-right traversal.\"\"\"\n    if isinstance(item, list):\n        for sub_item in item:\n            _flatten_recursive(sub_item, output)\n    else:\n        output.append(item)"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict\nfrom dataclasses import dataclass\nfrom collections import defaultdict\n\n@dataclass\nclass TupleEntry:\n    name: str\n    value: float\n\n@dataclass\nclass Aggregate:\n    name: str\n    total: float\n\nclass AggregatorService:\n    \"\"\"\n    Service to aggregate numeric values by name and select the maximum total.\n    This class contains the core logic for aggregation and selection.\n    \"\"\"\n    def aggregate(self, entries: List[Tuple[str, float]]) -> Dict[str, float]:\n        \"\"\"\n        Calculates the sum of values for each unique name from a list of entries.\n        It assumes input types are correct as per type hints.\n        \"\"\"\n        totals = defaultdict(float)\n        for name, value in entries:\n            totals[name] += value\n        return dict(totals)\n\n    def _select_max(self, aggregates: Dict[str, float]) -> Tuple[str, float]:\n        \"\"\"\n        Selects the name and total with the highest aggregate total.\n        Returns ('', 0.0) if the aggregates dictionary is empty.\n        \"\"\"\n        if not aggregates:\n            return ('', 0.0)\n\n        # Python's max() on dict items with a key will deterministically\n        # return the first-encountered item in case of ties for Python 3.7+.\n        return max(aggregates.items(), key=lambda item: item[1])\n\n    def max_aggregate(self, entries: List[Tuple[str, float]]) -> Tuple[str, float]:\n        \"\"\"\n        Orchestrates the aggregation and selection of the maximum aggregate.\n        This method computes aggregates and then finds the maximum.\n        \"\"\"\n        aggregates = self.aggregate(entries)\n        max_agg = self._select_max(aggregates)\n        return max_agg\n\ndef max_aggregate(entries: List[Tuple[str, float]]) -> Tuple[str, float]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    This public API function delegates the work to an AggregatorService instance.\n    \"\"\"\n    service = AggregatorService()\n    return service.max_aggregate(entries)"}
{"task_id": "Mbpp/301", "solution": "def validate(d) -> bool:\n    \"\"\"Checks if the input 'd' is an instance of a dictionary.\"\"\"\n    return isinstance(d, dict)\n\ndef dict_depth(d: dict) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of dictionaries.\n    Outermost dict is depth 1; only dict instances count toward depth.\n    \"\"\"\n    if not validate(d):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    max_nested_depth = 0\n    for value in d.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n\n    return 1 + max_nested_depth"}
{"task_id": "Mbpp/300", "solution": "import math\n\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Result:\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputValidator:\n    def __init__(self):\n        self.error_message = \"\"\n\n    def validate(self, n) -> bool:\n        if not isinstance(n, int) or n < 0:\n            self.error_message = \"n must be a non-negative integer\"\n            raise ValidationError(self.error_message)\n        return True\n\nclass BinomialCalculator:\n    def __init__(self):\n        self._comb_func = getattr(math, 'comb', self._fallback_comb)\n\n    def _fallback_comb(self, n, k):\n        \"\"\"Fallback for math.comb, computing C(n, k) using integer arithmetic.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    def binomial(self, n: int, k: int) -> int:\n        \"\"\"Computes C(n, k) using the selected method.\"\"\"\n        return self._comb_func(n, k)\n\n    def centralBinomial(self, n: int) -> int:\n        \"\"\"Computes the central binomial coefficient C(2n, n).\"\"\"\n        return self.binomial(2 * n, n)\n\nclass SequenceCounter:\n    def __init__(self):\n        self._validator = InputValidator()\n        self._binomCalc = BinomialCalculator()\n\n    def count_binary_seq(self, n: int) -> int:\n        \"\"\"\n        Orchestrates validation and computation for counting binary sequences.\n        It uses InputValidator for input checks and BinomialCalculator for combinatorial logic.\n        \"\"\"\n        try:\n            self._validator.validate(n)\n        except ValidationError as e:\n            raise ValueError(str(e))\n\n        value = self._binomCalc.centralBinomial(n)\n        return Result(value).value\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Finds the count of binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits.\n    \"\"\"\n    return SequenceCounter().count_binary_seq(n)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\nclass StartWithPFunction:\n    \"\"\"Helper class encapsulating the logic for finding 'p' words.\"\"\"\n\n    @staticmethod\n    def _tokenize(s: str) -> List[str]:\n        \"\"\"Splits a string by whitespace runs, using str.split().\"\"\"\n        return s.split()\n\n    @staticmethod\n    def _is_p_word(w: str) -> bool:\n        \"\"\"Checks if a word is non-empty and starts with 'p' or 'P'.\"\"\"\n        return bool(w) and w[0].lower() == 'p'\n\n    @staticmethod\n    def start_withp(input_list: List[str]) -> Tuple[str, str]:\n        \"\"\"Iterates through input strings to find the first two words starting with 'p'.\"\"\"\n        matches = []\n        for s in input_list:\n            for word in StartWithPFunction._tokenize(s):\n                if StartWithPFunction._is_p_word(word):\n                    matches.append(word)\n                    if len(matches) == 2:\n                        return (matches[0], matches[1])\n        \n        raise ValueError(\"insufficient matches: fewer than two words starting with 'p'\")\n\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings that start with 'p' or 'P'.\n    Raises ValueError if fewer than two such words are found.\n    \"\"\"\n    return StartWithPFunction.start_withp(input_list)"}
{"task_id": "Mbpp/308", "solution": "from typing import List\nimport heapq\n\ndef _compute_pairwise_products(list_a: List[int], list_b: List[int]) -> List[int]:\n    \"\"\"\n    Computes all products formed by multiplying one element from list_a with one from list_b.\n    Returns a list of integer product values.\n    \"\"\"\n    products = []\n    for a in list_a:\n        for b in list_b:\n            products.append(a * b)\n    return products\n\ndef _select_top_k(values: List[int], k: int) -> List[int]:\n    \"\"\"\n    Selects the k largest integer values from values and returns them sorted descending.\n    Uses heapq.nlargest for efficiency.\n    \"\"\"\n    return heapq.nlargest(k, values)\n\ndef large_product(list_a: List[int], list_b: List[int], k: int) -> List[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    all_products = _compute_pairwise_products(list_a, list_b)\n    top_k_products = _select_top_k(all_products, k)\n    return top_k_products"}
