{"task_id": "Mbpp/787", "solution": "PATTERN_VALUE = \"abbb\"\n\nclass InputString:\n    \"\"\"Wraps a string and provides its value and length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass Pattern:\n    \"\"\"Encapsulates the pattern value and provides matching logic.\"\"\"\n    def __init__(self):\n        self.value = PATTERN_VALUE\n\n    def matches(self, input_str: str) -> bool:\n        return self.value in input_str\n\nclass MatchResult:\n    \"\"\"Holds the boolean result of a match operation.\"\"\"\n    def __init__(self, matched: bool):\n        self.matched = matched\n\nclass TextMatchFunction:\n    \"\"\"Coordinates the matching process for the 'abbb' pattern.\"\"\"\n    def __init__(self):\n        self.name = \"text_match_three\"\n\n    def match(self, input_obj: InputString) -> MatchResult:\n        pattern = Pattern()\n        matched = pattern.matches(input_obj.value)\n        return MatchResult(matched)\n\ndef text_match_three(input_string) -> bool:\n    \"\"\"Return True if input_string contains the contiguous substring 'abbb'.\n\n    If input_string is not a str, TypeError is raised.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    input_obj = InputString(input_string)\n    matcher = TextMatchFunction()\n    result = matcher.match(input_obj)\n    return result.matched\n\n__all__ = [\"text_match_three\"]"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence, Any\n\ndef right_insertion(sequence: Sequence[Any], value: Any) -> int:\n    \"\"\"Computes the rightmost insertion index for `value` into a non-decreasingly sorted `sequence` (e.g., `right_insertion([1,2,4,5], 6) == 4`).\n    This function operates in O(log n) time and O(1) auxiliary space.\n    \"\"\"\n    lo = 0\n    hi = len(sequence)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sequence[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/790", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Represents a validated input list of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get(self, index: int) -> int:\n        return self.elements[index]\n\nclass Element:\n    \"\"\"Represents an element with its index and value.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the element's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass CheckerResult:\n    \"\"\"Encapsulates boolean result and optional reason.\"\"\"\n    def __init__(self, result: bool, reason: str = \"\") -> None:\n        self.result = result\n        self.reason = reason\n\nclass EvenIndexChecker:\n    \"\"\"Checks if every element at an even index is even.\"\"\"\n    def check(self, input: InputList) -> bool:\n        \"\"\"\n        Validates elements are integers and checks if even-indexed elements are even.\n        Raises TypeError if the input contains non-integer elements.\n        \"\"\"\n        for element_value in input.elements:\n            if not isinstance(element_value, int):\n                raise TypeError(\"All elements in the input list must be integers.\")\n\n        for i in range(0, input.length(), 2):\n            value = input.get(i)\n            element_obj = Element(i, value)\n            if not element_obj.isEven():\n                return False\n        return True\n\ndef even_position(input_list: List[int]) -> bool:\n    \"\"\"\n    Checks whether every even index contains an even number of a given list.\n    Raises TypeError if the input_list contains non-integer elements.\n    \"\"\"\n    input_obj = InputList(input_list)\n    checker = EvenIndexChecker()\n    return checker.check(input_obj)"}
{"task_id": "Mbpp/792", "solution": "def count_list(collection):\n    \"\"\"\n    Count and return the number of elements in 'collection' whose Python type is list.\n    Raises TypeError if 'collection' is not iterable.\n    \"\"\"\n    try:\n        iter(collection)\n    except TypeError:\n        raise TypeError(\"Input must be an iterable/collection\")\n    \n    count = 0\n    for element in collection:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/791", "solution": "NAME = \"remove_nested\"\n\ndef validate_input(input_tuple):\n    \"\"\"Raise TypeError if input_tuple is not of type tuple.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple\")\n\ndef remove_nested(input_tuple):\n    \"\"\"Return a new tuple composed of the non-tuple top-level elements of input_tuple.\n\n    Parameters:\n        input_tuple (tuple): input tuple to process\n\n    Returns:\n        tuple: new tuple with top-level tuple elements removed\n\n    Raises:\n        TypeError: if input_tuple is not a tuple\n    \"\"\"\n    validate_input(input_tuple)\n    result_list = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            result_list.append(element)\n    return tuple(result_list)"}
{"task_id": "Mbpp/793", "solution": "def last(array, value) -> int:\n    \"\"\"Return index of last occurrence of value in sorted array (zero-based), or -1 if not found.\"\"\"\n    low = 0\n    high = len(array) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == value:\n            result_index = mid  # Found a potential last occurrence\n            low = mid + 1       # Continue searching in the right half for a later occurrence\n        elif array[mid] < value:\n            low = mid + 1\n        else:  # array[mid] > value\n            high = mid - 1\n            \n    return result_index"}
{"task_id": "Mbpp/796", "solution": "def _sum_values(values) -> float:\n    \"\"\"Internal helper to sum numeric values from an iterable.\"\"\"\n    total = 0.0\n    for v in values:\n        total += v\n    return total\n\ndef return_sum(input_dict: dict) -> float:\n    \"\"\"Compute and return the sum of all numeric values in input_dict.\"\"\"\n    values = input_dict.values()\n    return _sum_values(values)"}
