tart_withp(lines)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/308": [{"task_id": "Mbpp/308", "solution": "from heapq import heappush, heappop\nfrom typing import List, Tuple, Set\ndef large_product(a: List[int], b: List[int], k: int) -> List[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    if not a or not b or k <= 0:\n        return []\n\n    a_sorted = sorted(a, reverse=True)\n    b_sorted = sorted(b, reverse=True)\n\n    n, m = len(a_sorted), len(b_sorted)\n\n    # Max-heap to store (-product, index_a, index_b) tuples\n    heap: List[Tuple[int, int, int]] = []\n    # Set to keep track of visited (index_a, index_b) pairs to avoid duplicates\n    visited: Set[Tuple[int, int]] = set()\n\n    # Start with the largest possible product from the two sorted lists\n    # Use negative product to simulate a max-heap with heapq (which is a min-heap)\n    heappush(heap, (-(a_sorted[0] * b_sorted[0]), 0, 0))\n    visited.add((0, 0))\n\n    results: List[int] = []\n\n    while heap and len(results) < k:\n        neg_product, i, j = heappop(heap)\n        current_product = -neg_product\n        results.append(current_product)\n\n        # Explore the next possible products by incrementing indices\n        # Neighbor (i+1, j)\n        if i + 1 < n and (i + 1, j) not in visited:\n            next_product = a_sorted[i + 1] * b_sorted[j]\n            heappush(heap, (-next_product, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Neighbor (i, j+1)\n        if j + 1 < m and (i, j + 1) not in visited:\n            next_product = a_sorted[i] * b_sorted[j + 1]\n            heappush(heap, (-next_product, i, j + 1))\n            visited.add((i, j + 1))\n\n    return results", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-14, 95, -14, true, -100, true, -93, -93, 28, -100, 