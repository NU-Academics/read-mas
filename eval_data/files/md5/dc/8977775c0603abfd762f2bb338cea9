ar: str) -> bool:\n    \"\"\"Checks if a character is a closing bracket.\"\"\"\n    return char in CLOSING_TO_OPEN\nclass Stack:\n    \"\"\"A simple stack implementation used for tracking brackets.\"\"\"\n    def __init__(self) -> None:\n        self._items: List[Tuple[str, int]] = []\n\n    def push(self, item: Tuple[str, int]) -> None:\n        self._items.append(item)\n\n    def pop(self) -> Tuple[str, int]:\n        return self._items.pop()\n\n    def peek(self) -> Optional[Tuple[str, int]]:\n        return self._items[-1] if self._items else None\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\ndef check_expression(expression: str, strict: bool = False) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\"\"\"\n    if expression is None:\n        return False\n\n    stack = Stack()\n\n    for i, ch in enumerate(expression):\n        if is_opening(ch):\n            stack.push((ch, i))\n        elif is_closing(ch):\n            if stack.is_empty():\n                return False  # Unmatched closing bracket\n            \n            open_ch, _ = stack.pop()\n            if CLOSING_TO_OPEN.get(ch) != open_ch:\n                return False  # Mismatched bracket type\n        else:\n            if strict:\n                return False  # Unexpected non-bracket character in strict mode\n            # else: ignore non-bracket characters in non-strict mode\n\n    return stack.is_empty() # Expression is balanced if stack is empty at the end", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "Mbpp/773": [{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (matched_substring, start_index, end_index) or None if no match.\n    \"\"\"\n    idx = text.find(pattern)\n    if idx == -1:\n        return None\n    \n    end_id