elf.validator.validate(cone)\n        return self.calculator.calculate_volume(cone)\nclass PackageAPI:\n    def __init__(self, service: ConeService) -> None:\n        self.service = service\n\n    def compute(self, radius: typing.Any, height: typing.Any) -> float:\n        # Cast inputs using safe_float before calling the service.\n        r_float = safe_float(radius)\n        h_float = safe_float(height)\n        return self.service.compute_volume(r_float, h_float)\n_default_api = PackageAPI(ConeService(ConeValidator(), VolumeCalculator()))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/391": [{"task_id": "Mbpp/391", "solution": "from typing import Sequence, Any, List, Dict, Optional\nfrom abc import ABC, abstractmethod\nclass ConversionError(Exception):\n    \"\"\"Custom exception for conversion-related errors.\"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\nclass ConversionInput:\n    \"\"\"DTO for capturing the input lists for conversion.\"\"\"\n    def __init__(self, keys: Sequence[str], nested_keys: Sequence[str], values: Sequence[Any]) -> None:\n        self.keys = keys\n        self.nested_keys = nested_keys\n        self.values = values\nclass ConversionResult:\n    \"\"\"DTO for representing the output of the conversion.\"\"\"\n    def __init__(self, result: List[Dict[str, Dict[str, Any]]]) -> None:\n        self.result = result\n\n    def to_list(self) -> List[Dict[str, Dict[str, Any]]]:\n        \"\"\"Returns the raw list representation of the conversion result.\"\"\"\n        return self.result\nclass ListValidator:\n    \"\"\"Validates incoming ConversionInput for type, length, and business rules.\"\"\"\n    ALLOWED_KEY_TYPES = (str,)\n\n    def validate(self, input: ConversionInput) -> None:\n        \"\"\"Runs all validation checks on the input and raises ConversionError on failure.\"\"\"\n        self._check_sequences(input)\n        self._check_lengths(input)\n        self._check_key_types(input)\n\n    def _check_sequences(self, input: ConversionInput) -> None:\n        \"\"\"Ensures input keys, nested_keys, and values are sequence types.\"\"\"\n        if not isinstance(input.keys, (list, tuple)):\n            raise ConversionError(\"INVALID_INPUT_TYPE\", \"keys must be a list or tuple.\")\n        if not isinstance(input.nested_keys, (list, tuple)):\n            raise ConversionError(\"INVALID_INPUT_TYPE\", \"nested_keys must be a list or tuple.\")\n        if not isinstance(input.values, (list, tuple)):\n            raise ConversionError(\"INVALID_INPUT_TYPE\", \"values must be a list or tuple.\")\n\n    def _check_lengths(self, input: ConversionInput) -> None:\n        \"\"\"Ensures all input lists have the same length.\"\"\"\n        if not (len(input.keys) == len(input.nested_keys) == len(input.values)):\n            raise ConversionError(\"LENGTH_MISMATCH\", \"keys, nested_keys and values must have the same length.\")\n\n    def _check_key_types(self, input: ConversionInput) -> None:\n        \"\"\"Ensures individual items in keys and nested_keys are of allowed types.\"\"\"\n        for i, key in enumerate(input.keys):\n            if not isinstance(key, self.ALLOWED_KEY_TYPES):\n                raise ConversionError(\"INVALID_KEY_TYPE\", f\"Key at index {i} must be one of {self.ALLOWED_KEY_TYPES}, got {type(key).__name__}.\")\n        for i, nested_key in enumerate(input.nested_keys):\n            if not isinstance(nested_key, self.ALLOWED_KEY_TYPES):\n                raise ConversionError(\"INVALID_NESTED_KEY_TYPE\", f\"Nested key at index {i} must be one of {self.ALLOWED_KEY_TYPES}, got {type(nested_key).__name__}.\")\nclass Repository(ABC):\n    \"\"\"Abstract Base Class for a repository to store conversion results.\"\"\"\n    @abstractmethod\n    def save(self, result: ConversionResult) -> None:\n        pass\n\n    @abstractmethod\n    def load(self) -> Optional[ConversionResult]:\n        pass\nclass InMemoryRepository(Repository):\n    \"\"\"An in-memory implementation of the Repository for transient storage.\"\"\"\n    def __init__(self) -> None:\n        self._store: Optional[ConversionResult] = None\n\n    def save(self, result: ConversionResult) -> None:\n        \"\"\"Saves the conversion result to memory.\"\"\"\n        self._store = result\n\n    def load(self) -> Optional[ConversionResult]:\n        \"\"\"Loads the conversion result from memory.\"\"\"\n        return self._store\nclass ListConverterService:\n    \"\"\"Orchestrates validation, conversion, and optional persistence of lists to nested dictionaries.\"\"\"\n    def __init__(self, validator: ListValidator, repository: Optional[Repository] = None) -> None:\n        self._validator = validator\n        self._repository = repository\n\n    def _build_nested(self, key: Any, nested_key: Any, value: Any) -> Dict[str, Dict[str, Any]]:\n        \"\"\"Creates a single nested dictionary element: {key: {nested_key: value}}.\"\"\"\n        return {key: {nested_key: value}}\n\n    def convert(self, input: ConversionInput) -> ConversionResult:\n        \"\"\"Validates input, builds the list of nested dictionaries, optionally saves, and returns the result.\"\"\"\n        self._validator.validate(input)\n        results = []\n        for k, nk, v in zip(input.keys, input.nested_keys, input.values):\n            results.append(self._build_nested(k, nk, v))\n        \n        conversion_result = ConversionResult(results)\n        if self._repository:\n            self._repository.save(conversion_result)\n        return conversion_result\ndef convert_list_dictionary(keys: Sequence[str], nested_keys: Sequence[str], values: Sequence[Any]) -> List[Dict[str, Dict[str, Any]]]:\n    \"\"\"Converts parallel lists into a list of nested dictionaries.\"\"\"\n    input_dto = ConversionInput(keys, nested_keys, values)\n    service = ListConverterService(ListValidator(), repository=InMemoryRepository())\n    result = service.convert(input_dto)\n    return result.to_list()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["A1", "A2", "A3", "A4"], [10, 20, 30, 40], [["a", "b"], ["c", "d", "e"], [1, 2, 3, 4], {"x": 1, "y": 2}]]]}], "Mbpp/404": [{"task_id": "Mbpp/404", "solution": "def minimum(a: float | int, b: float | int) -> float:\n    \"\"\"\n    Finds the minimum of two numbers and returns it as a float.\n    \"\"\"\n    return float(min(a, b))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[10000000000000000000000, -9999999999999999999999]]}], "Mbpp/395": [{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> str | None:\n    \"\"\"Finds the first non-repeated character in a string.\n    Uses a two-pass approach to count frequencies and then find the first unique character.\n    \"\"\"\n    freq: dict[str, int] = {}\n    for ch in s:\n        freq[ch] = freq.get(ch, 0) + 1\n\n    for ch in s:\n        if freq[ch] == 1:\n            return ch\n    return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/390": [{"task_id": "Mbpp/390", "solution": "from typing import Sequence, Any, List, Optional\nfrom dataclasses import dataclass\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass FormattingError(Exception):\n    \"\"\"Exception raised when an item fails to format.\"\"\"\n    def __init__(self, index: int, value: Any, cause: Exception) -> None:\n        super().__init__(f\"Formatting failed at index {index}: {cause}\")\n        self.index = index\n        self.value = value\n        self.cause = cause\nclass InputValidator:\n    \"\"\"Validates and normalizes input