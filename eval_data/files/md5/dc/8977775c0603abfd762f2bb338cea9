ry.\"\"\"\n        return {\"n\": self.n, \"value\": self.value}\nclass CacheRepository:\n    \"\"\"In-memory LRU cache for hexagonal numbers.\"\"\"\n    def __init__(self, max_size: int = 128) -> None:\n        self._store = OrderedDict()\n        self._max_size = max_size\n\n    def get(self, key: int):\n        \"\"\"Retrieves a value from the cache, marking it as recently used.\"\"\"\n        value = self._store.get(key)\n        if value is not None:\n            self._store.move_to_end(key)\n        return value\n\n    def set(self, key: int, value: int) -> None:\n        \"\"\"Adds or updates a value in the cache, evicting oldest if capacity is exceeded.\"\"\"\n        self._store[key] = value\n        self._store.move_to_end(key)\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False)\n\n    def clear(self) -> None:\n        \"\"\"Clears all items from the cache.\"\"\"\n        self._store.clear()\nclass HexagonalService:\n    \"\"\"Provides computation of hexagonal numbers with caching.\"\"\"\n    def __init__(self, cache_repo: CacheRepository, cache_size: int = 128) -> None:\n        self._cache = cache_repo\n\n    def compute(self, n: int) -> NumberResult:\n        \"\"\"Computes the nth hexagonal number, utilizing cache if available.\"\"\"\n        cached = self._cache.get(n)\n        if cached is not None:\n            return NumberResult(n=n, value=cached)\n        try:\n            value = self._compute_formula(n)\n        except Exception as e:\n            raise HexagonalError(str(e))\n        self._cache.set(n, value)\n        return NumberResult(n=n, value=value)\n\n    def _compute_formula(self, n: int) -> int:\n        \"\"\"Calculates the nth hexagonal number using its mathematical formula.\"\"\"\n        return n * (2 * n - 1)\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears the internal cache.\"\"\"\n        self._cache.clear()\ndef create_default_service(cache_size: int = None) -> HexagonalServi