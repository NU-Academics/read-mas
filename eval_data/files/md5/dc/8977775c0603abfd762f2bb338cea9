def max_occurrences(items: List[Any]) -> Any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Handles hashable/unhashable items, stable tie-breaking, and caching.\n    \"\"\"\n    import collections\n    import json\n    import hashlib\n    import os\n    import threading\n    import logging\n    from pathlib import Path\n    from typing import Any, List, Tuple, Optional, Dict, Callable\n\n    # Configure a basic logger for internal messages.\n    _logger = logging.getLogger(__name__)\n    _logger.setLevel(logging.WARNING)\n    if not any(isinstance(handler, logging.StreamHandler) for handler in _logger.handlers):\n        _handler = logging.StreamHandler()\n        _formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n        _handler.setFormatter(_formatter)\n        _logger.addHandler(_handler)\n\n\n    # --- 1. Inline Exceptions ---\n    class InvalidInputError(Exception):\n        \"\"\"Raised when the input is not a list-like object.\"\"\"\n        pass\n\n    class EmptyListError(Exception):\n        \"\"\"Raised when the input list is empty.\"\"\"\n        pass\n\n    class CacheIOError(Exception):\n        \"\"\"Raised when there's an error reading from or writing to the cache.\"\"\"\n        pass\n\n    # --- 2. Inline Utils ---\n    def normalize_item_for_json(item: Any) -> Any:\n        \"\"\"\n        Converts an item to a JSON-serializable format.\n        Falls back to its string representation if not directly serializable.\n        \"\"\"\n        try:\n            json.dumps(item)\n            return item\n        except TypeError:\n            return repr(item)\n\n    def compute_hash(items_list: List[Any]) -> str:\n        \"\"\"\n        Computes a stable SHA256 hash for a list of items.\n        Normalizes items to JSON-serializable forms first.\n        \"\"\"\n        normalized = [normalize_item_for_json(i) for i in items_list]\n        payload = json.dumps(normalized, sort_keys=False, separators=(\",\", \":\"), ensure_ascii=False)\n        return hashlib.sha256(payload.encode(\"utf-8\")).hexdigest()\n\n    def stable_first_max_index(items_list: List[Any], key: Callable[[Any], Any]) -> int:\n        \"\"\"\n        Finds the index of the first item in a list that yields the maximum value\n        when a key function is applied.\n        \"\"\"\n        if not items_list:\n            raise ValueError(\"Input list cannot be empty for stable_first_max_index.\")\n\n        max_val = None\n        max_idx = -1\n\n        for i, item in enumerate(items_list):\n            current_val = key(item)\n            if max_val is None or current_val > max_val:\n                max_val = current_val\n                max_idx = i\n        return max_idx\n\n    # --- 3. Inline Models ---\n    class ResultDTO:\n        \"\"\"Data Transfer Object for cached results, including item and count.\"\"\"\n        def __init__(self, item: Any, count: int, repr_fallback: bool = False) -> None:\n            self.item = item\n            self.count = count\n            self.repr_fallback = repr_fallback\n\n        def to_json(self) -> Dict[str, Any]:\n            \"\"\"Converts the DTO to a JSON-serializable dictionary.\"\"\"\n            data = {\"item\": self.item, \"count\": self.count}\n            if self.repr_fallback:\n                data[\"repr_fallback\"] = True\n            return data\n\n        @staticmethod\n        def from_json(d: Dict[str, Any]) -> 'ResultDTO':\n            \"\"\"Creates a ResultDTO from a dictionary (e.g., loaded from JSON).\"\"\"\n            return ResultDTO(\n                item=d[\"item\"],\n                count=d[\"count\"],\n                repr_fallback=d.get(\"repr_fallback\", False)\n            )\n\n    # --- 4. Inline Validators ---\n    class ListValidator:\n        \"\"\"Validates that the input is a non-empty list-like object.\"\"\"\n        def validate(self, items_input: Any) -> None:\n            \"\"\"\n            Validates if the input is a list-like object and is not empty.\n            Raises InvalidInputError or EmptyListError on failure.\n            \"\"\"\n            if not self._is_list_like(items_input):\n                raise InvalidInputError(\"Input must be a list or tuple.\")\n            if not items_input:\n                raise EmptyListError(\"Input list cannot be empty.\")\n\n        def _is_list_like(self, items_input: Any) -> bool:\n            \"\"\"Checks if an object is list-like (list or tuple).\"\"\"\n            return isinstance(items_input, (list, tuple))\n\n    # --- 5. Inline Repositories ---\n    class FrequencyRepository:\n        \"\"\"Manages JSON-backed cache for frequency results.\"\"\"\n        DEFAULT_CACHE_PATH = Path(\"data/cache.json\")\n\n        def __init__(self, cache_path: Path = DEFAULT_CACHE_PATH) -> None:\n            self._cache_path = cache_path\n            self._lock = threading.Lock()\n            self._cache_path.parent.mkdir(parents=True, exist_ok=True)\n            if not self._cache_path.exists():\n                try:\n                    self._write_cache({})\n                except CacheIOError:\n                    _logger.warning(f\"Failed to create empty cache file at {self._cache_path}\", exc_info=True)\n\n\n        def get(self, items_hash: str) -> Optional[ResultDTO]:\n            \"\"\"Retrieves a cached result by hash.\"\"\"\n            with self._lock:\n                try:\n                    cache = self._load_cache()\n                    cached_data = cache.get(items_hash)\n                    if cached_data:\n                        return ResultDTO.from_json(cached_data)\n                except CacheIOError as e:\n                    _logger.warning(f\"Cache read error: {e}. Proceeding without cache.\", exc_info=True)\n                return None\n\n        def save(self, items_hash: str, result: ResultDTO) -> None:\n            \"\"\"Saves a result to the cache.\"\"\"\n            with self._lock:\n                try:\n                    cache = self._load_cache()\n                    normalized_item_for_storage = normalize_item_for_json(result.item)\n                    is_repr_fallback_for_storage = (normalized_item_for_storage == repr(result.item)) and (normalized_item_for_storage != result.item)\n                    \n                    cache[items_hash] = ResultDTO(\n                        item=normalized_item_for_storage,\n                        count=result.count,\n                        repr_fallback=is_repr_fallback_for_storage\n                    ).to_json()\n                    self._write_cache(cache)\n                except CacheIOError as e:\n                    _logger.warning(f\"Cache write error: {e}. Result not cached.\", exc_info=True)\n\n        def _load_cache(self) -> Dict[str, Any]:\n            \"\"\"Loads the entire cache from the JSON file.\"\"\"\n            if not self._cache_path.exists():\n                return {}\n            try:\n                with open(self._cache_path, \"r\", encoding=\"utf-8\") as f:\n                    return json.load(f)\n            except (IOError, json.JSONDecodeError) as e:\n                raise CacheIOError(f\"Failed to load cache from {self._cache_path}: {e}\")\n\n        def _write_cache(self, cache: Dict[str, Any]) -> None:\n            \"\"\"Writes the entire cache to the JSON file atomically.\"\"\"\n            temp_path = self._cache_path.with_suffix(\".tmp\")\n            try:\n                with open(temp_path, \"w\", encoding=\"utf-8\") as f:\n                    json.dump(cache, f, indent=2, ensure_ascii=False)\n                os.replace(temp_path, self._cache_path)\n            except IOError as e:\n                if temp_path.exists():\n                    os.remove(temp_path)\n                raise CacheIOError(f\"Failed to write cache to {self._cache_path}: {e}\")\n\n    # --- 6. Inline Services ---\n    class MaxFrequencyService:\n        \"\"\"Core business logic for finding the most frequent item.\"\"\"\n        def __init__(self, repo: FrequencyRepository, hasher: Callable[[List[Any]], str]) -> None:\n            self._repo = repo\n            self._hasher = hasher\n\n        def find_max(self, items_list: List[Any]) -> Any:\n            \"\"\"Returns the most frequent item from the list.\"\"\"\n            item, _ = self.find_max_with_count(items_list)\n            return item\n\n        def find_max_with_count(self, items_list: List[Any]) -> Tuple[Any, int]:\n            \"\"\"\n            Computes the most frequent item and its count.\n            Handles unhashable items and stable tie-breaking.\n            \"\"\"\n            if not items_list:\n                raise EmptyListError(\"Empty list provided to service.\")\n\n            counter: Dict[Any, int]\n            is_repr_fallback_counter = False\n\n            try:\n                counter = collections.Counter(items_list)\n            except TypeError:\n                counter = {}\n                for item in items_list:\n                    key = repr(item)\n                    counter[key] = counter.get(key, 0) + 1\n                is_repr_fallback_counter = True\n\n            if not counter:\n                raise EmptyListError(\"Could not count items in list (internal error).\")\n\n            max_count = max(counter.values())\n\n            def get_item_count_key(item_to_check: Any) -> int:\n                \"\"\"Helper key function for stable_first_max_index to retrieve count.\"\"\"\n                if is_repr_fallback_counter:\n                    return counter.get(repr(item_to_check), 0)\n                else:\n                    return counter.get(item_to_check, 0)\n\n            max_idx = stable_first_max_index(items_list, key=get_item_count_key)\n            \n            return items_list[max_idx], max_count\n\n    # --- 7. Inline Controllers ---\n    class MaxOccurrencesController:\n        \"\"\"\n        Orchestrates validation, caching, and service invocation for max frequency operations.\n        \"\"\"\n        def __init__(self, service: MaxFrequencyService, validator: ListValidator, repo: FrequencyRepository) -> None:\n            self._service = service\n            self._validator = validator\n            self._repo = repo\n\n        def max_occurrences_handler(self, items_input: List[Any]) -> Any:\n            \"\"\"\n            Handles the request to find the item with maximum frequency.\n            \"\"\"\n            return self.find_max_with_count_handler(items_input)[0]\n\n        def find_max_with_count_handler(self, items_input: List[Any]) -> Tuple[Any, int]:\n            \"\"\"\n            Handles the request to find the item with maximum frequency and its count.\n            \"\"\"\n            self._validator.validate(items_input)\n\n            items_hash = compute_hash(items_input)\n\n            cached_result = self._repo.get(items_hash)\n            if cached_result:\n                return cached_result.item, cached_result.count\n\n            item, count = self._service.find_max_with_count(items_input)\n\n            result_to_cache = ResultDTO(item=item, count=count)\n            self._repo.save(items_hash, result_to_cache)\n\n            return item, count\n\n    # --- 8. Instantiate and Call Components ---\n    _repo = FrequencyRepository(cache_path=Path(\"data/cache.json\"))\n    _service = MaxFrequencyService(repo=_repo, hasher=compute_hash)\n    _validator = ListValidator()\n    _controller = MaxOccurrencesController(service=_service, validator=_validator, repo=_repo)\n\n    return _controller.max_occurrences_handler(items)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/141": [{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    It returns a new list with the elements sorted in ascending order.\n    \"\"\"\n\n    def _flip(current_arr: list, k: int) -> None:\n        \"\"\"Reverses the prefix of the list up to index k (inclusive) in-place.\"\"\"\n        i, j = 0, k\n        while i < j:\n            current_arr[i], current_arr[j] = current_arr[j], current_arr[i]\n            i += 1\n            j -= 1\n\n    a = list(arr) # Create a mutable copy to perform sorting\n    n = len(a)\n\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted subarray\n        max_idx = 0\n        for i in range(1, curr_size):\n            if a[i] > a[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at its correct sorted position\n        if max_idx != curr_size - 1:\n            # Flip the subarray from 0 to max_idx to bring the max element to the front\n            _flip(a, max_idx)\n            # Flip the entire current unsorted subarray to move the max element to its final position\n            _flip(a, curr_size - 1)\n            \n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series n + (n-2) + (n-4) ... until the term is non-positive.\n    It uses a closed-form formula for arithmetic progression.\"\"\"\n    # The number of terms in the series is floor((n + 1) / 2) for n >= 0.\n    m = (n + 1) // 2\n    # The sum of an arithmetic series is count * (first_term + last_term) / 2.\n    # Here, first_term = n, and last_term = n - 2*(m-1).\n    # Simplified formula: m * (2 * first_term - (m - 1) * common_difference) // 2\n    # Where common_difference is -2.\n    return m * (2 * n - (m - 1) * 2) // 2", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, to_remove: list) -> list:\n    \"\"\"Removes all elements