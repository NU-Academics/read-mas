\")\n\n    def validate_n(n_val: int) -> None:\n        \"\"\"Validates the 'n' parameter to be an integer >= 1.\"\"\"\n        if not isinstance(n_val, int) or n_val < 1:\n            raise InvalidInputError(\"Parameter 'n' must be an integer >= 1.\")\n\n    def stable_sort_key(item: Item) -> tuple[float, str, int]:\n        \"\"\"Generates a key for sorting by price descending, then name ascending, then original index ascending.\"\"\"\n        return (-item.price, item.name, item.index)\n\n    validate_n(n)\n\n    normalized_items: List[Item] = []\n    for idx, mapping in enumerate(items):\n        validate_item_mapping(mapping)\n        normalized_items.append(\n            Item(name=str(mapping[\"name\"]), price=float(mapping[\"price\"]), index=idx)\n        )\n\n    sorted_items = sorted(normalized_items, key=stable_sort_key)\n\n    top_n_dtos: List[ItemDTO] = []\n    for item in sorted_items[:n]:\n        top_n_dtos.append(ItemDTO.from_item(item))\n\n    return [dto.to_dict() for dto in top_n_dtos]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[{"name": "Item-1", "price": 100.13437547119709}, {"name": "Item-1", "price": 100.13437547119709}, {"name": "Item-4", "price": 555.22, "pricpricee": "Iteem-4"}, {"name": "Item-4", "price": 22.75}, {"name": "Item-1", "price": 100.13437547119709}], 2]]}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "import math\ndef isqrt(n: int) -> int:\n    \"\"\"Computes the integer square root of a non-negative integer.\"\"\"\n    return math.isqrt(n)\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a perfect square.\"\"\"\n    r = isqrt(n)\n    return r * r == n\ndef is_nonagonal(x: int) -> bool:\n    \"\"\"\n    Determines if an integer x is a nonagonal number.\n    A number x is nonagonal if n = (5 + sqrt(25 + 56x)) / 14 is a positive integer.\n    \"\"\"\n    D = 25 + 56 * x\n\n    if not is_perfect_square(D):\n        return False\n\n    sqrtD