0": [{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Remove duplicates and sort the numbers by their absolute values.\n    # This simplifies the dynamic programming approach, ensuring that potential divisors\n    # appear before their multiples (or numbers they are divisible by).\n    unique_sorted_nums = sorted(list(set(numbers)), key=abs)\n\n    n = len(unique_sorted_nums)\n    if n == 0:  # If all numbers were duplicates of 0, or an empty list (already handled).\n        return 0\n\n    # dp[i] stores the length of the longest divisible subset ending with unique_sorted_nums[i].\n    dp = [1] * n\n\n    for i in range(n):\n        current_num = unique_sorted_nums[i]\n        for j in range(i):\n            prev_num = unique_sorted_nums[j]\n\n            is_divisible_pair = False\n            if prev_num == 0:\n                # If 'prev_num' is 0, and 'current_num' is non-zero (due to sorting and uniqueness),\n                # the pair (0, current_num) is considered divisible because 0 % current_num == 0.\n                is_divisible_pair = True\n            elif current_num != 0 and prev_num != 0:\n                # For two non-zero numbers, check if 'current_num' is divisible by 'prev_num'.\n                # Due to sorting by absolute value, abs(prev_num) <= abs(current_num),\n                # so only one direction of divisibility needs to be checked.\n                is_divisible_pair = (abs(current_num) % abs(prev_num) == 0)\n            \n            if is_divisible_pair:\n                if dp[j] + 1 > dp[i]:\n                    dp[i] = dp[j] + 1\n\n    # The maximum value in the dp array is the size of the largest divisible subset.\n    return max(dp)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests":