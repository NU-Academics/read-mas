ory:\n    \"\"\"Simple in-memory cache for computed difference values.\"\"\"\n    def __init__(self, max_items: int = 1024):\n        self._store: Dict[int, int] = {}\n        self._max_items = max_items\n\n    def get(self, n: int) -> Optional[int]:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        if len(self._store) >= self._max_items:\n            # Evict an arbitrary item (e.g., oldest if dict preserves insertion order)\n            self._store.pop(next(iter(self._store)))\n        self._store[n] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass DifferenceService:\n    \"\"\"Orchestrates calculation, checking cache and delegating to FormulaCalculator.\"\"\"\n    def __init__(self, cache: 'CacheRepository', calculator: 'FormulaCalculator') -> None:\n        self._cache = cache\n        self._calculator = calculator\n\n    def compute(self, n: int) -> 'DifferenceResult':\n        cached_result = self._cache.get(n)\n        if cached_result is not None:\n            return DifferenceResult(n=n, result=cached_result)\n\n        calculated_value = self._calculator.difference(n)\n        self._cache.set(n, calculated_value)\n        return DifferenceResult(n=n, result=calculated_value)\n_cache = CacheRepository()\n_service = DifferenceService(_cache, FormulaCalculator())\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    result_dto = _service.compute(n)\n    return result_dto.result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/554": [{"task_id": "Mbpp/554", "solution": "from typing import List\ndef Split(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd ones while preserving order.\n    Assumes input `numbers` is a list containing only integers.\n    \"