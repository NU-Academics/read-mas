      arr = json.load(f)\n                except json.JSONDecodeError:\n                    arr = []\n        arr.append(record)\n        fd, tmp_filepath = tempfile.mkstemp(dir=os.path.dirname(self._storage_path))\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n            json.dump(arr, f, indent=2)\n        os.replace(tmp_filepath, self._storage_path)\n\n    def load_last(self) -> Optional[dict]:\n        if not os.path.exists(self._storage_path):\n            return None\n        with open(self._storage_path, \"r\", encoding=\"utf-8\") as f:\n            try:\n                arr = json.load(f)\n            except json.JSONDecodeError:\n                return None\n            return arr[-1] if arr else None\nclass MinService:\n    def __init__(self, repo: Optional[MinRepository] = None) -> None:\n        self._repo = repo\n\n    def min_of_three(self, a: float, b: float, c: float) -> float:\n        triple = NumberTriple(a, b, c)\n        triple.validate()\n        result = self._compute_min(triple)\n        if self._repo:\n            record = {\n                \"id\": str(uuid.uuid4()),\n                \"a\": triple.as_tuple()[0],\n                \"b\": triple.as_tuple()[1],\n                \"c\": triple.as_tuple()[2],\n                \"result\": result,\n                \"ts\": datetime.datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n            }\n            try:\n                self._repo.save_result(record)\n            except Exception:\n                pass\n        return result\n\n    def _compute_min(self, triple: NumberTriple) -> float:\n        a, b, c = triple.as_tuple()\n        return min(a, b, c)\n_default_service = MinService(repo=MinRepository())\ndef min_of_three(a: float, b: float, c: float) -> float:\n    \"\"\"Finds the minimum of three numbers, validating inputs and optionally persisting the result.\"\"\"\n    return _default_service.min_of_three(a, b, c)", "base_status": "pass", "plus_status": "pass", "base