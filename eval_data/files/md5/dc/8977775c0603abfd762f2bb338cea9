te for k=1 (representing A(0, j)): A(0,0)=1.\n        dp_prev = [1] \n\n        for k in range(1, n + 1): # k is the current 'n' in A(k,j)\n            # dp_current will hold A(k, j) values for j in [0, k-1].\n            dp_current = [0] * k\n\n            for j in range(k): # j from 0 to k-1\n                # Term 1: (k - j) * A(k-1, j-1)\n                term1 = (k - j) * (dp_prev[j-1] if j - 1 >= 0 and j - 1 < len(dp_prev) else 0)\n                # Term 2: (j + 1) * A(k-1, j)\n                term2 = (j + 1) * (dp_prev[j] if j < len(dp_prev) else 0)\n                dp_current[j] = term1 + term2\n            dp_prev = dp_current # Move to next row for the next iteration\n\n        # After the loop, dp_prev holds A(n, j) values.\n        return dp_prev[m] if 0 <= m < len(dp_prev) else 0\nclass ValidationUtils:\n    @staticmethod\n    def validate_non_negative_int(value: int, name: str) -> None:\n        if not isinstance(value, int):\n            raise InvalidInputError(f\"'{name}' must be an integer.\")\n        if value < 0:\n            raise InvalidInputError(f\"'{name}' must be a non-negative integer.\")\n\n    @staticmethod\n    def validate_range_m(n: int, m: int) -> None:\n        if n == 0:\n            if m != 0:\n                raise InvalidInputError(\"For n=0, m must be 0.\")\n        else: # n > 0\n            if not (0 <= m <= n - 1):\n                raise InvalidInputError(f\"For n={n}, m must be between 0 and {n-1} inclusive.\")\nclass EulerianResult:\n    def __init__(self, n: int, m: int, value: int) -> None:\n        self.n = n\n        self.m = m\n        self.value = value\nclass EulerianService:\n    def __init__(self, calculator: EulerianCalculator) -> None:\n        self._calculator = calculator\n\n    def compute(self, n: int, m: int) -> EulerianResult:\n        ValidationUtils.validate_non_negative_int(n, \"n\")\n        ValidationUtils.validate_non_negative_int(m, \"m\")\n        ValidationUtils.validate_range_m(n, m)\n        value = self._calculator.compute(n, m)\n        return EulerianResult(n=n, m=m, value=value)\nclass EulerianAPI:\n    def __init__(self, service: EulerianService) -> None:\n        self._service = service\n\n    def compute(self, n: int, m: int) -> int:\n        result = self._service.compute(n, m)\n        return result.value\n_default_cache = InMemoryCacheRepository()\n_default_calc = EulerianCalculator(cache_repo=_default_cache)\n_default_service = EulerianService(calculator=_default_calc)\n_default_api = EulerianAPI(service=_default_service)\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number A(n, m).\n    A(n, m) is the number of permutations of {1, ..., n} that have exactly m ascents.\n    \"\"\"\n    return _default_api.compute(n, m)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/104": [{"task_id": "Mbpp/104", "solution": "from typing import Iterable, List\ndef sort_sublists(sublists: Iterable[Iterable[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists lexicographically.\n    Returns a new list of sorted lists, without mutating the original input.\n    \"\"\"\n    return [sorted(list(sublist)) for sublist in sublists]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/108": [{"task_id": "Mbpp/108", "solution": "from typing import List, Sequence, Optional, Dict, Any, Tuple\nfrom abc import ABC, abstractmethod\nclass MergeError(Exception):\n    \"\"\"Domain-specific exception for merge-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\ndef is_sequence(obj: Any) -> bool:\n    \"\"\"Checks if an object is a list or tuple.\"\"\"\n    return isinstance(obj, (list, tuple))\ndef try_compare_items(a: Any, b: Any) -> bool:\n    \"\"\"Attempts to compare two items; raises MergeError if not comparable.\"\"\"\n    try:\n        _ = a < b\n        _ = a == b\n        return True\n    except TypeError:\n        raise MergeError(f\"Elements '{a}' and '{b}' are not comparable.\")\nclass ListInput:\n    \"\"\"Holds and normalizes input list sequences as Python lists.\"\"\"\n    def __init__(self, items_a: Sequence[Any], items_b: Sequence[Any], items_c: Sequence[Any]) -> None:\n        self._items_a = list(items_a)\n        self._items_b = list(items_b)\n        self._items_c = list(items_c)\n\n    def as_lists(self) -> Tuple[List[Any], List[Any], List[Any]]:\n        \"\"\"Returns the stored lists.\"\"\"\n        return self._items_a, self._items_b, self._items_c\nclass InputValidator:\n    \"\"\"Validates that inputs are sequences and elements are mutually comparable.\"\"\"\n    @staticmethod\n    def validate_lists(a: Sequence[Any], b: Sequence[Any], c: Sequence[Any]) -> None:\n        \"\"\"Validates input lists for sequence type and element comparability.\"\"\"\n        if not is_sequence(a) or not is_sequence(b) or not is_sequence(c):\n            raise MergeError(\"All inputs must be sequences (list or tuple).\")\n\n        all_lists = [a, b, c]\n        sample_elements = []\n        for lst in all_lists:\n            if lst:\n                sample_elements.append(lst[0])\n\n        # Check pairwise comparability of a few sample elements\n        if len(sample_elements) > 1:\n            for i in range(len(sample_elements)):\n                for j in range(i + 1, len(sample_elements)):\n                    try_compare_items(sample_elements[i], sample_elements[j])\n\n        # Also check within each list if it contains elements, to catch list-specific non-comparability\n        for lst in all_lists:\n            if len(lst) > 1:\n                for i in range(len(lst) - 1):\n                    try_compare_items(lst[i], lst[i+1])\nclass SortStrategy(ABC):\n    \"\"\"Abstract base class for merging algorithms.\"\"\"\n    @abstractmethod\n    def merge(self, a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n        pass\nclass BuiltinSortAlgorithm(SortStrategy):\n    \"\"\"Merges lists by concatenating and using Python's built-in sorted().\"\"\"\n    def merge(self, a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n        all_items = a + b + c\n        return sorted(all_items)\nclass ThreeWayMergeAlgorithm(SortStrategy):\n    \"\"\"Merges three lists using a three-pointer approach after sorting each individually.\"\"\"\n    def merge(self, a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n        sa = sorted(a)\n        sb = sorted(b)\n        sc = sorted(c)\n        return self._three_way_merge(sa, sb, sc)\n\n    def _three_way_merge(self, sa: List[Any], sb: List[Any], sc: List[Any]) -> List[Any]:\n        i = j = k = 0\n        res = []\n        while i < len(sa) or j < len(sb) or k < len(sc):\n            candidates = []\n            if i < len(sa):\n                candidates.append((\"a\", sa[i]))\n            if j < len(sb):\n                candidates.append((\"b\", sb[j]))\n            if k < len(sc):\n                candidates.append((\"c\", sc[k]))\n\n            if not candidates:\n                break # All lists exhausted\n\n            try:\n                label, value = min(candidates, key=lambda t: t[1])\n            except TypeError as e:\n                raise MergeError(f\"Elements encountered during merge are not comparable: {e}\") from e\n\n            res.append(value)\n            if label == \"a\":\n                i += 1\n            elif label == \"b\":\n                j += 1\n            else:\n                k += 1\n        return res\nclass MergeService:\n    \"\"\"Orchestrates validation, normalization, algorithm selection, and merging.\"\"\"\n    def __init__(self, algorithm_registry: Optional[Dict[str, SortStrategy]] = None) -> None:\n        if algorithm_registry is None:\n            self._algorithms = {\n                \"builtin\": BuiltinSortAlgorithm(),\n                \"three_way\": ThreeWayMergeAlgorithm(),\n            }\n        else:\n            self._algorithms = algorithm_registry\n\n    def merge(self, list_a: Sequence[Any], list_b: Sequence[Any], list_c: Sequence[Any], algorithm: Optional[str] = None) -> List[Any]:\n        \"\"\"Validates inputs, selects algorithm, and performs the merge.\"\"\"\n        InputValidator.validate_lists(list_a, list_b, list_c)\n        dto = ListInput(list_a, list_b, list_c)\n        a, b, c = dto.as_lists()\n        \n        algo_key = (algorithm or \"three_way\")\n        if algo_key not in self._algorithms:\n            raise MergeError(f\"Unsupported algorithm: {algo_key}\")\n        \n        try:\n            return self._algorithms[algo_key].merge(a, b, c)\n        except TypeError as e:\n            raise MergeError(f\"Elements not comparable: {e}\") from e\nclass SimpleAPI:\n    \"\"\"Provides a simple programmatic API wrapper for the merge service.\"\"\"\n    def merge_sorted_list(self, list_a: Sequence[int], list_b: Sequence[int], list_c: Sequence[int], algorithm: Optional[str] = None) -> List[int]:\n        \"\"\"Merges three lists into a single sorted list using a MergeService.\"\"\"\n        service = MergeService()\n        return service.merge(list_a, list_b, list_c, algorithm=algorithm)\ndef merge_sorted_list(list_a: Sequence[int], list_b: Sequence[int], list_c: Sequence[int], algorithm: Optional[str] = None) -> List[int]:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    Delegates to SimpleAPI for core logic, handling MergeError.\n    \"\"\"\n    try:\n        return SimpleAPI().merge_sorted_list(list_a, list_b, list_c, algorithm=algorithm)\n    except MergeError:\n        raise", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/119": [{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other