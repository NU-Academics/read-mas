 datetime.datetime.now(datetime.timezone.utc).strftime(TIMESTAMP_FORMAT)\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for persistence-related errors.\"\"\"\n    pass\nclass RegexProvider:\n    \"\"\"Provides and manages the compiled regular expression pattern.\"\"\"\n    def __init__(self, pattern_str: str = DEFAULT_PATTERN):\n        self._pattern_str = pattern_str\n        self._compiled = re.compile(self._pattern_str)\n\n    def get_pattern(self) -> re.Pattern:\n        \"\"\"Returns the compiled regex pattern.\"\"\"\n        return self._compiled\n\n    def set_pattern(self, pattern_str: str) -> None:\n        \"\"\"Sets a new regex pattern and recompiles it.\"\"\"\n        self._pattern_str = pattern_str\n        self._compiled = re.compile(self._pattern_str)\nclass ValidationRepository(ABC):\n    \"\"\"Abstract base class for validation result repositories.\"\"\"\n    @abstractmethod\n    def save(self, result: ValidationResult) -> None:\n        \"\"\"Saves a validation result.\"\"\"\n        pass\nclass FileValidationRepository(ValidationRepository):\n    \"\"\"Implements ValidationRepository to save results to a JSON Lines file.\"\"\"\n    def __init__(self, file_path: str = LOG_FILE_PATH, max_size_bytes: int = MAX_LOG_SIZE_BYTES):\n        self.file_path = file_path\n        self.max_size_bytes = max_size_bytes\n        self._logger = logging.getLogger(__name__)\n\n    def _rotate_if_needed(self) -> None:\n        \"\"\"Rotates the log file if its size exceeds the maximum allowed.\"\"\"\n        if os.path.exists(self.file_path) and os.path.getsize(self.file_path) > self.max_size_bytes:\n            timestamp = datetime.datetime.now().strftime(\"%Y%m%d%H%M%S\")\n            backup_path = f\"{self.file_path}.{timestamp}.bak\"\n            try:\n                os.rename(self.file_path, backup_path)\n                self._logger.info(f\"Rotated log file from {self.file_path} to {backup_path}\")\n            except OSError as e:\n                self._logger.error(f\"Failed to rotate log file {self.file_path}: {e}\")\n\n    def save(self, result: ValidationResult) -> None:\n        \"\"\"Appends a validation result as a JSON line to the log file.\"\"\"\n        try:\n            line = json.dumps(result.to_dict(), ensure_ascii=False)\n            with open(self.file_path, \"a\", encoding=\"utf-8\") as f:\n                f.write(line + \"\\n\")\n            self._rotate_if_needed()\n        except OSError as e:\n            raise RepositoryError(f\"Failed to save to repository file {self.file_path}: {e}\")\nclass TextLowercaseUnderscoreService:\n    \"\"\"Provides the core logic for validating strings against the lowercase-underscore pattern.\"\"\"\n    def __init__(self, regex_provider: RegexProvider = None, repository: ValidationRepository = None):\n        self._regex_provider = regex_provider or RegexProvider()\n        self._repository = repository\n        self._logger = logging.getLogger(__name__)\n\n    def validate(self, text: str, persist: bool = True) -> ValidationResult:\n        \"\"\"Validates the input text and optionally persists the result.\"\"\"\n        txt = ensure_str(text)\n        pattern = self._regex_provider.get_pattern()\n        matched = bool(pattern.fullmatch(txt))\n        reason = \"matched\" if matched else \"not matched\"\n        result = ValidationResult(text=txt, is_valid=matched, reason=reason, timestamp=current_timestamp())\n\n        if persist and self._repository:\n            try:\n                self._repository.save(result)\n            except RepositoryError as e:\n                self._logger.exception(f\"Failed to persist validation result for '{txt}'\")\n                result.reason = f\"{result.reason}; persistence_error: {str(e)}\"\n        return result\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Returns true if the input string contains sequences of lowercase letters\n    joined with an underscore and false otherwise.\n    \