       n_left = len(left_arr)\n\n        while i < n_left and j < len(right_arr):\n            if left_arr[i] <= right_arr[j]:\n                merged.append(left_arr[i])\n                i += 1\n            else:\n                merged.append(right_arr[j])\n                j += 1\n                inv_count += n_left - i\n        \n        merged.extend(left_arr[i:])\n        merged.extend(right_arr[j:])\n        return merged, inv_count\n\n    def _sort_and_count(current_arr):\n        \"\"\"Recursively sorts an array and counts inversions within it.\"\"\"\n        n = len(current_arr)\n        if n <= 1:\n            return current_arr, 0\n\n        mid = n // 2\n        \n        left_half, inv_left = _sort_and_count(current_arr[:mid])\n        right_half, inv_right = _sort_and_count(current_arr[mid:])\n        \n        merged_arr, inv_split = _merge_count(left_half, right_half)\n        \n        return merged_arr, inv_left + inv_right + inv_split\n\n    if not arr:\n        return 0\n\n    _, total_inversions = _sort_and_count(list(arr))\n    return total_inversions", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "def dict_depth(d):\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The outermost dictionary counts as depth 1.\n    \"\"\"\n    max_depth = 1\n    # Stack stores tuples of (current_dictionary, current_level)\n    stack = [(d, 1)]\n\n    while stack:\n        current_dict, current_level = stack.pop()\n        max_depth = max(max_depth, current_level)\n\n        for value in current_dict.values():\n            # If a value is another dictionary, it increases the depth\n            if isinstance(value, dict):\n                stack.append((value, current_level + 1))\n    \n    return max_depth", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence ending before or at index `i`\n    and then including the element at index `k`, where `k` > `i`.\n    \"\"\"\n    # Calculate MSIS values for the prefix up to and including index i.\n    # msis[j] stores the maximum sum of an increasing subsequence ending at index j (j <= i).\n    msis = [0] * (i + 1)\n    for current_idx in range(i + 1):\n        msis[current_idx] = arr[current_idx]  # Base case: subsequence is just the element itself\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                # If arr[current_idx] can extend a subsequence ending at arr[prev_idx]\n                # Update msis[current_idx] if a larger sum is found\n                if msis[current_idx] < msis[prev_idx] + arr[current_idx]:\n                    msis[current_idx] = msis[prev_idx] + arr[current_idx]\n\n    # Initialize the maximum sum with just arr[k] itself.\n    # This covers cases where no suitable prefix element is found.\n    max_total_sum = arr[k]\n\n    # Iterate through the prefix (0 to i) to find an element arr[j] that\n    # can precede arr[k] in an increasing subsequence.\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            # If arr[j] is smaller than arr[k], we can form a subsequence\n            # by taking the MSIS ending at j and adding arr[k].\n            current_total_sum = msis[j] + arr[k]\n            if current_total_sum > max_total_sum:\n                max_total_sum = current_total_sum\n\n    return max_total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/309": [{"task_id": "Mbpp/309", "solution": "from datetime import datetime\nfrom dataclasses import dataclass\nfrom typing import Any, List\nclass MaxPairError(Exception):\n    pass\nclass InvalidInputError(MaxPairError):\n    def __init