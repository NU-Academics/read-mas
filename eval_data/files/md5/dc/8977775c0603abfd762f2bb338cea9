 type for type hinting within the function scope\n    from typing import Tuple, Union, Any, List, Dict, Optional\n\n    Number = Union[int, float]\n\n    # --- Start of auxiliary definitions (models, exceptions, utils, validator, service) ---\n\n    class InvalidInputError(Exception):\n        \"\"\"Raised when an input value is invalid.\"\"\"\n        pass\n\n    class ShapeMismatchError(Exception):\n        \"\"\"Raised when input tuples have incompatible shapes.\"\"\"\n        pass\n\n    def is_number(value: Any) -> bool:\n        \"\"\"Checks if a value is a number (int or float) and not a boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def as_tuple_of_tuples(obj: Any) -> Tuple[Tuple[Number, ...], ...]:\n        \"\"\"Converts a list/tuple of lists/tuples to a canonical tuple-of-tuples, ensuring numeric inner elements.\"\"\"\n        if isinstance(obj, tuple):\n            outer = obj\n        elif isinstance(obj, list):\n            outer = tuple(obj)\n        else:\n            raise InvalidInputError(\"Input must be list/tuple of lists/tuples.\")\n        \n        converted = []\n        for inner in outer:\n            if isinstance(inner, (list, tuple)):\n                converted.append(tuple(inner))\n            else:\n                raise InvalidInputError(\"Inner elements must be list/tuple.\")\n        return tuple(converted)\n\n    class TuplePairDTO:\n        \"\"\"Data Transfer Object for a pair of validated tuples-of-tuples.\"\"\"\n        def __init__(self, a: Tuple[Tuple[Number, ...], ...], b: Tuple[Tuple[Number, ...], ...]) -> None:\n            self.a = a\n            self.b = b\n\n    class TupleValidator:\n        \"\"\"Validates and normalizes inputs into a TuplePairDTO.\"\"\"\n        @staticmethod\n        def validate(a: Any, b: Any) -> TuplePairDTO:\n            \"\"\"Validates two inputs, converting them to tuple-of-tuples and checking shapes and element types.\"\"\"\n            