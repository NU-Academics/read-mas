istence failures.\"\"\"\n        pass\n\n    class PolarCoord:\n        \"\"\"Represents a polar coordinate (radius, angle).\"\"\"\n        def __init__(self, r: float, theta: float) -> None:\n            self.r = r\n            self.theta = theta\n\n        def to_dict(self) -> dict:\n            \"\"\"Returns a dictionary representation of the polar coordinate.\"\"\"\n            return {\"r\": self.r, \"theta\": self.theta}\n\n        def to_tuple(self) -> Tuple[float, float]:\n            \"\"\"Returns a tuple representation (r, theta).\"\"\"\n            return (self.r, self.theta)\n\n    class ConversionResult:\n        \"\"\"Holds both polar and rectangular representations of a coordinate.\"\"\"\n        def __init__(self, polar: PolarCoord, rectangular: complex) -> None:\n            self.polar = polar\n            self.rectangular = rectangular\n\n        def to_dict(self) -> dict:\n            \"\"\"Returns a dictionary representation for serialization.\"\"\"\n            return {\n                \"polar\": self.polar.to_dict(),\n                \"rectangular\": {\n                    \"real\": self.rectangular.real,\n                    \"imag\": self.rectangular.imag,\n                    \"as_complex\": str(self.rectangular)\n                }\n            }\n\n        def to_tuple_format(self) -> Tuple[Tuple[float, float], complex]:\n            \"\"\"Returns the result in the specific tuple format expected by the top-level function.\"\"\"\n            return (self.polar.to_tuple(), self.rectangular)\n\n    class Utils:\n        \"\"\"Utility class for validation and safe mathematical operations.\"\"\"\n        @staticmethod\n        def is_finite_number(value: Any) -> bool:\n            \"\"\"Checks if a value is a finite number (float or int).\"\"\"\n            return isinstance(value, numbers.Real) and not (math.isinf(value) or math.isnan(value))\n\n        @staticmethod\n        def safe_hypot(x: float, y: float) -> float:\n            \"\"\"Computes the hypotenuse safely.\"\"\"\n            return math.hypot(x, y)\n\n        @staticmethod\n        def safe_atan2(y: float, x: float) -> float:\n            \"\"\"Computes atan2 safely.\"\"\"\n            return math.atan2(y, x)\n\n    class ConverterInterface(ABC):\n        \"\"\"Abstract base class defining the converter contract.\"\"\"\n        @abstractmethod\n        def convert_rect_to_polar(self, x: float, y: float) -> PolarCoord:\n            pass\n\n        @abstractmethod\n        def convert_polar_to_rect(self, r: float, theta: float) -> complex:\n            pass\n\n    class PolarConverter(ConverterInterface):\n        \"\"\"Implements conversion algorithms between rectangular and polar coordinates.\"\"\"\n        def __init__(self, utils: type[Utils] = Utils) -> None:\n            self._utils = utils\n\n        def convert_rect_to_polar(self, x: float, y: float) -> PolarCoord:\n            \"\"\"Converts rectangular (x, y) to polar (r, theta).\"\"\"\n            if not self._utils.is_finite_number(x) or not self._utils.is_finite_number(y):\n                raise ValidationError(\"x and y must be finite numbers\")\n            r = self._utils.safe_hypot(x, y)\n            theta = self._utils.safe_atan2(y, x)\n            return PolarCoord(r, theta)\n\n        def convert_polar_to_rect(self, r: float, theta: float) -> complex:\n            \"\"\"Converts polar (r, theta) to rectangular (complex number).\"\"\"\n            if not self._utils.is_finite_number(r) or r < 0:\n                raise ValidationError(\"r must be finite and non-negative\")\n            if not self._utils.is_finite_number(theta):\n                raise ValidationError(\"theta must be finite\")\n            return cmath.rect(r, theta)\n\n    class PolarController:\n        \"\"\"Orchestrates coordinate conversions and optional persistence.\"\"\"\n        def __init__(self, converter: ConverterInterface = None, serializer: Optional[Any] = None) -> None:\n            self._conve