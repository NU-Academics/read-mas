ries from the cache.\"\"\"\n        with self._lock:\n            self._store.clear()\nclass MathUtils:\n    \"\"\"Utility methods for mathematical computations.\"\"\"\n\n    @staticmethod\n    def binomial_coefficient(n: int, k: int) -> int:\n        \"\"\"Computes the binomial coefficient C(n, k) efficiently.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        k = min(k, n - k)  # C(n, k) = C(n, n-k)\n        result = 1\n        for i in range(1, k + 1):\n            result = result * (n - k + i) // i\n        return result\n\n    @staticmethod\n    def compute_via_dp(n: int) -> int:\n        \"\"\"Computes the nth Catalan number using dynamic programming.\"\"\"\n        if n <= 1:\n            return 1\n        C = [0] * (n + 1)\n        C[0] = 1\n        for i in range(1, n + 1):\n            for j in range(i):\n                C[i] += C[j] * C[i - 1 - j]\n        return C[n]\nclass CatalanService:\n    \"\"\"Manages the computation and caching of Catalan numbers.\"\"\"\n    def __init__(self, cache: CacheRepository, max_n: int = 1000):\n        self._cache = cache\n        self._max_n = max_n\n\n    def catalan_number(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Catalan number, using cache and error handling.\n        Prefers the binomial coefficient formula for efficiency.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValidationError(\"n must be a non-negative integer\")\n        if n > self._max_n:\n            raise LimitExceededError(f\"n ({n}) exceeds maximum allowed ({self._max_n})\")\n\n        cached = self._cache.get(n)\n        if cached is not None:\n            return cached\n\n        # Use binomial formula: C_n = C(2n, n) / (n+1)\n        # This is generally faster and more stable for moderate n than direct DP if C(2n,n) is efficient.\n        val = MathUtils.binomial_coefficient(2 * n, n) // (n + 1)\n        self._cache.set(n, val)\n        return val\n_default_service = CatalanService(CacheRepository(), max_n=1000)\ndef catalan_number(n: int) -> int:\n    \"\"\"Returns the nth Catalan number.\"\"\"\n    return _default_service.catalan_number(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/588": [{"task_id": "Mbpp/588", "solution": "def big_diff(items):\n    \"\"\"\n    Finds the difference between the largest and smallest value in a given list.\n    Assumes the input list is non-empty and contains numeric values.\n    \"\"\"\n    return float(max(items) - min(items))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/589": [{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import Any\nclass InvalidRangeError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ComputationError(RuntimeError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Range:\n    def __init__(self, low: int, high: int) -> None:\n        self.low: int = low\n        self.high: int = high\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a number is within the inclusive range.\"\"\"\n        return self.low <= n <= self.high\ndef ceil_sqrt(n: int) -> int:\n    \"\"\"Computes the smallest integer s such that s*s >= n.\"\"\"\n    if n <= 0:\n        return 0\n    s = math.isqrt(n)\n    if s * s < n:\n        s += 1\n    return s\nclass RangeValidator:\n    def validate(self, low: Any, high: Any) -> Range:\n        \"\"\"Validates and normalizes input bounds into a Range object.\"\"\"\n        low_i = self._to_int(low, \"low\")\n        high_i = self._to_int(high, \"high\")\n        if low_i > high_i:\n            raise InvalidRangeError(f\"low ({low_i}) must be <= high ({high_i})\")\n        return Range(low_i, high_i)\n\n    def _to_int(self, v: Any, name: str) -> int:\n        \"\"\"Helper to convert a value to an integer, raising InvalidRangeError if not possible.\"\"\"\n        if isinstance(v, int):\n            return v\n        if isinstance(v, float):\n            if v.is_integer():\n                return int(v)\n            raise InvalidRangeError(f\"{name} must be integer-valued\")\n        if isinstance(v, str):\n            if v.strip().lstrip(\"+-\").isdigit():\n                return int(v)\n            raise InvalidRangeError(f\"{name} string not an integer\")\n        raise InvalidRangeError(f\"{name} has unsupported type {type(v)}\")\nclass AlgorithmRepository:\n    def __init__(self):\n        self._cache: dict[tuple[int, int], list[int]] = {}\n\n    def get_squares(self, r: Range) -> list[int]:\n        \"\"\"Computes perfect squares within the given range using an efficient algorithm.\"\"\"\n        key = (r.low, r.high)\n        if key in self._cache:\n            return list(self._cache[key])\n\n        if r.high < 0:\n            self._cache[key] = []\n            return []\n        \n        start = max(0, ceil_sqrt(r.low))\n        end = math.isqrt(r.high)\n\n        if start > end:\n            self._cache[key] = []\n            return []\n        \n        try:\n            squares = [i * i for i in range(start, end + 1)]\n        except Exception as exc:\n            raise ComputationError(f\"Error during square computation: {exc}\")\n        \n        self._cache[key] = squares\n        return squares\nclass PerfectSquareService:\n    def __init__(self, repo: AlgorithmRepository, validator: RangeValidator) -> None:\n        \"\"\"Initializes the service with a repository and validator.\"\"\"\n        self.repo = repo\n        self.validator = validator\n\n    def perfect_squares(self, low: Any, high: Any) -> list[int]:\n        \"\"\"Orchestrates validation and computation to find perfect squares.\"\"\"\n        r = self.validator.validate(low, high)\n        return self.repo.get_squares(r)\ndef perfect_squares(low, high) -> list[int]:\n    \"\"\"Finds all perfect squares within the inclusive range [low, high].\"\"\"\n    service = PerfectSquareService(repo=AlgorithmRepository(), validator=RangeValidator())\n    return service.perfect_squares(low, high)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1, 0]]}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients using the identity C(2n, n+1).\n    The sum is defined as sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    return math.comb(2 * n, n + 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/594": [{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    The difference is calculated as (first even number - first odd number).\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even - first_odd", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/593": [{"task_id": "Mbpp/593", "solution": "from typing import List, Optional, Tuple\nclass InvalidIPAddressError(ValueError):\n    \"\"\"Exception raised for invalid IP addresses.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass RepositoryError(RuntimeError):\n    \"\"\"Exception raised for repository related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass IPParser:\n    \"\"\"Parses IP strings into octet strings and handles leading zero removal.\"\"\"\n    def strip_leading_zeros(self, octet_str: str) -> str:\n        if not octet_str:\n            raise InvalidIPAddressError(\"Empty octet\")\n        try:\n            # int() removes leading zeros and validates numeric content.\n            return str(int(octet_str))\n        except ValueError:\n            raise InvalidIPAddressError(f\"Non-numeric octet: {octet_str}\")\n\n    def parse(self, ip_str: str) -> list[str]:\n        \"\"\"Splits an IP string into normalized octet strings.\"\"\"\n        parts = ip_str.split(\".\")\n        if len(parts) != 4:\n            raise InvalidIPAddressError(\"IP must have four octets\")\n        return [self.strip_leading_zeros(p) for p in parts]\nclass IPValidator:\n    \"\"\"Validates the structure and numeric range of IP octets.\"\"\"\n    def is_valid_octet(self, octet_str: str) -> bool:\n        \"\"\"Checks if an octet string represents a valid number (0-255).\"\"\"\n        if not octet_str.isdigit():\n            return False\n        v = int(octet_str)\n        return 0 <= v <= 255\n\n    def validate_octets(self, octets: list[str]) -> None:\n        \"\"\"Ensures the list contains four valid octet strings.\"\"\"\n        if len(octets) != 4:\n            raise InvalidIPAddressError(\"Must be 4 octets\")\n        for o in octets:\n            if not self.is_valid_octet(o):\n                raise InvalidIPAddressError(f\"Invalid octet: {o}\")\nclass IPRepository:\n    \"\"\"Abstract base class for IP address repositories.\"\"\"\n    def save(self, original: str, normalized: str) -> None:\n        raise NotImplementedError\n\n    def list_all(self) -> List[Tuple[str,str]]:\n        raise NotImplementedError\nclass InMemoryIPRepository(IPRepository):\n    \"\"\"An in-memory implementation of the IP address repository.\"\"\"\n    def __init__(self) -> None:\n        self._store: List[Tuple[str, str]] = []\n\n    def save(self, original: str, normalized: str) -> None:\n        self._store.append((original, normalized))\n\n    def list_all(self) -> List[Tuple[str,str]]:\n        return list(self._store)\nclass IPService:\n    \"\"\"Orchestrates IP parsing, validation, and normalization.\"\"\"\n    def __init__(self, parser: IPParser, validator: IPValidator, repo: Optional[IPRepository]=None) -> None:\n        self._parser = parser\n        self._validator = validator\n        self._repo = repo\n\n    def remove_leading_zeros(self, ip_str: str) -> str:\n        \"\"\"Removes leading zeros from IP octets after parsing and validating.\"\"\"\n        octets = self._parser.parse(ip_str)\n        self._validator.validate_octets(octets)\n        return \".\".join(octets)\n\n    def normalize_and_record(self, ip_str: str) -> str:\n        \"\"\"Normalizes an IP address and optionally records the operation.\"\"\"\n        normalized = self.remove_leading_zeros(ip_str)\n        if self._repo:\n            try:\n                self._repo.save(ip_str, normalized)\n            except Exception as exc:\n                raise RepositoryError(str(exc))\n        return normalized\nclass IPController:\n    \"\"\"Facade for IP normalization operations.\"\"\"\n    def __init__(self, service: IPService) -> None:\n        self._service = service\n\n    def removezero_ip(self, ip_str: str) -> str:\n        \"\"\"Provides the main API to remove leading zeros from an IP address.\"\"\"\n        return self._service.normalize_and_record(ip_str)\nclass Application:\n    \"\"\"Factory for wiring up application components.\"\"\"\n    def build_controller(self, with_repo: bool=False) -> IPController:\n        \"\"\"Constructs and returns an IPController instance.\"\"\"\n        parser = IPParser()\n        validator = IPValidator()\n        repo = InMemoryIPRepository() if with_repo else None\n        service = IPService(parser, validator, repo)\n        return IPController(service)\ndef removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n    app = Application()\n    controller = app.build_controller(with_repo=False)\n    return controller.removezero_ip(ip_address)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["12.01.024"]], "plus_fail_tests": [["0.0.0.0"]]}], "Mbpp/596": [{"task_id": "Mbpp/596", "solution": "import sys\ndef tuple_size(value: tuple) -> int:\n    \"\"\"\n    Returns the size in bytes of the given tuple object, consistent with sys.getsizeof.\n    \"\"\"\n    return sys.getsizeof(value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/597": [{"task_id": "Mbpp/597", "solution": "from typing import List\ndef find_kth(a: List[int], b: List[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    The k-th element is 1-based, meaning k=1 returns the smallest element.\n    \"\"\"\n    # Ensure array 'a' is the shorter one to optimize binary search range.\n    if len(a) > len(b):\n        a, b = b, a\n\n    len_a = len(a)\n    len_b = len(b)\n\n    # Perform binary search for the split point 'i' in array 'a'.\n    # 'i' represents the number of elements taken from 'a' for the left partition.\n    # 'j' represents the number of elements taken from 'b' for the left partition.\n    # i + j = k\n    \n    # 'low' is the minimum possible number of elements from 'a'.\n    # It must be at least max(0, k - len_b) to ensure 'j' (k-i) does not exceed len_b.\n    low = max(0, k - len_b)\n    \n    # 'high' is the maximum possible number of elements from 'a'.\n    # It must be at most min(k, len_a) to ensure 'i' does not exceed len_a and is not greater than k.\n    high = min(k, len_a)\n\n    while low <= high:\n        i = (low + high) // 2  # Partition point in array 'a'\n        j = k - i              # Partition point in array 'b'\n\n        # Get the elements around the partition points.\n        # Use float('-inf') for left boundaries if i or j is 0.\n        # Use float('inf') for right boundaries if i or j is len_a or len_b.\n        Aleft = a[i - 1] if i > 0 else float('-inf')\n        Aright = a[i] if i < len_a else float('inf')\n        Bleft = b[j - 1] if j > 0 else float('-inf')\n        Bright = b[j] if j < len_b else float('inf')\n\n        # Check if the partition is correct:\n        # Aleft <= Bright (all elements in left partition are smaller than or equal to elements in right partition of B)\n        # Bleft <= Aright (all elements in left partition are smaller than or equal to elements in right partition of A)\n        if Aleft <= Bright and Bleft <= Aright:\n            # The k-th element is the maximum of the left partition's boundary elements.\n            return max(Aleft, Bleft)\n        elif Aleft > Bright:\n            # 'i' is too large; we need to take fewer elements from 'a'.\n            high = i - 1\n        else:  # Bleft > Aright\n            # 'i' is too small; we need to take more elements from 'a'.\n            low = i + 1\n\n    # This part should ideally not be reached if inputs are valid (k is within bounds).\n    # The problem statement ensures valid inputs for which a k-th element exists.", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3], [true, true, false], 3]]}], "Mbpp/600": [{"task_id": "Mbpp/600", "solution": "def is_Even(number):\n    \"\"\"\n    Checks if the given number is even.\n    Assumes `number` is an integer.\n    \"\"\"\n    return number % 2 == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/598": [{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number is equal to the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    if number < 0: