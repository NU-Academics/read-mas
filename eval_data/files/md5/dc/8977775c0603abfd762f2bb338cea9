gits[1]\n\n    # If the first two digits are the same, it cannot be undulating.\n    if digit0 == digit1:\n        return False\n\n    # Check that all subsequent digits follow the alternating pattern.\n    for i in range(len(digits)):\n        expected_digit = digit0 if i % 2 == 0 else digit1\n        if digits[i] != expected_digit:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/91": [{"task_id": "Mbpp/91", "solution": "class SubstringQuery:\n    \"\"\"DTO for passing validated values and query together.\"\"\"\n    def __init__(self, values: list, query: str) -> None:\n        self.values = values\n        self.query = query\nclass InputValidator:\n    \"\"\"Normalizes inputs for the substring search service.\"\"\"\n    def validate_values(self, values_input) -> list:\n        # BR3: None values in list are converted to \"None\" string representation before checking.\n        # Non-string list items are converted to str(value).\n        return [self._to_str_safe(item) for item in values_input]\n\n    def validate_query(self, query_input) -> str:\n        # BR2: Non-string items (implicitly including the query here) are converted to str.\n        return str(query_input)\n\n    def _to_str_safe(self, value) -> str:\n        \"\"\"Converts a value to string safely, handling None.\"\"\"\n        if value is None:\n            return \"None\"\n        return str(value)\nclass ListRepository:\n    \"\"\"Provides normalized list of strings from diverse input types.\"\"\"\n    def get_values(self, values_input: list) -> list:\n        # As per the API sequence, values_input is already a list of strings.\n        return values_input\nclass SubstringFinderService:\n    \"\"\"Encapsulates substring search algorithm.\"\"\"\n    def __init__(self, repo: ListRepository, validator: InputValidator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def find(self, query_dto: SubstringQuery) -> bool:\n        # BR1: Empty query string is considered a substring of every string\n        # and therefore should return True if values is non-empty.\n        if query_dto.query == \"\":\n            return bool(query_dto.values)\n\n        for v in query_dto.values:\n            if self._check_value_for_query(v, query_dto.query):\n                return True\n        return False\n\n    def _check_value_for_query(self, value: str, query: str) -> bool:\n        \"\"\"Checks if the query is a substring of the given value.\"\"\"\n        return query in value\ndef find_substring(values, query):\n    validator = InputValidator()\n    repo = ListRepository()\n    \n    # Validate and normalize inputs as per design context (without raising exceptions per instruction)\n    validated_values = validator.validate_values(values)\n    validated_query = validator.validate_query(query)\n    \n    dto = SubstringQuery(validated_values, validated_query)\n    service = SubstringFinderService(repo, validator)\n    \n    return service.find(dto)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/93": [{"task_id": "Mbpp/93", "solution": "import numbers\nimport math\nclass PowerError(Exception):\n    \"\"\"Base exception for powerlib errors.\"\"\"\n    pass\nclass InvalidBaseError(PowerError):\n    \"\"\"Raised when the base input is invalid.\"\"\"\n    pass\nclass InvalidExponentError(PowerError):\n    \"\"\"Raised when the exponent input is invalid.\"\"\"\n    pass\nclass MathDomainError(PowerError):\n    \"\"\"Raised for mathematical domain errors, e.g., 0^0.\"\"\"\n    pass\ndef to_number(value: any) -> float:\n    \"\"\"Converts a value to a float if it's numeric, otherwise raises ValueError.\"\"\"\n    if isinstance(value, numbers.Real):\n        return float(value)\n    try:\n        return float(value)\n    except (TypeError, ValueError):\n        raise ValueError(f\"Value '{value}' is not a valid number.\")\ndef to_int(value: any) -> int:\n    \"\"\"Converts a value to an integer if it's an integer or an integral float, otherwise raises ValueError.\"\"\"\n    if isinstance(value, int):\n        return value\n    if isinstance(value, numbers.Real):\n        if value == int(value):\n            return int(value)\n    try:\n        f_value = float(value)\n        if f_value == int(f_value):\n            return int(f_value)\n        else:\n            raise ValueError(f\"Value '{value}' is a float with fractional part and cannot be converted to integer.\")\n    except (TypeError, ValueError):\n        raise ValueError(f\"Value '{value}' is not a valid integer.\")\nclass InputValidator:\n    \"\"\"Validates and coerces input types for base and exponent.\"\"\"\n    def validate_base(self, value: any) -> float:\n        \"\"\"Ensures the value is numeric and returns it as a float.\"\"\"\n        try:\n            return to_number(value)\n        except ValueError as exc:\n            raise InvalidBaseError(str(exc))\n\n    def validate_exponent(self, value: any) -> int:\n        \"\"\"Ensures the exponent is an integer or integral float and returns it as an int.\"\"\"\n        try:\n            return to_int(value)\n        except ValueError as exc:\n            raise InvalidExponentError(str(exc))\nclass PowerService:\n    \"\"\"Core exponentiation algorithm implementation.\"\"\"\n    EPSILON: float = 1e-12\n\n    def power(self, base: float, exponent: int) -> float:\n        \"\"\"Computes base**exponent for an integer exponent, handling zero and negative exponents.\"\"\"\n        if exponent == 0:\n            if abs(base) < self.EPSILON:\n                raise MathDomainError(\"0^0 is undefined\")\n            return 1.0\n        if exponent < 0:\n            if abs(base) < self.EPSILON:\n                raise MathDomainError(\"division by zero for negative exponent\")\n            return 1.0 / self._fast_pow_positive(base, -exponent)\n        return self._fast_pow_positive(base, exponent)\n\n    def _fast_pow_positive(self, base: float, exponent: int) -> float:\n        \"\"\"Calculates base to a positive integer exponent using exponentiation by squaring.\"\"\"\n        result = 1.0\n        cur = base\n        e = exponent\n        while e > 0:\n            if e & 1:\n                result *= cur\n            cur *= cur\n            e >>= 1\n        return result\n_default_service = None\n_default_validator = None\ndef power(a: any, b: any) -> float:\n    \"\"\"Calculates 'a' to the power 'b' using robust input validation and an optimized algorithm.\"\"\"\n    global _default_service, _default_validator\n    if _default_service is None:\n        _default_service = PowerService()\n    if _default_validator is None:\n        _default_validator = InputValidator()\n\n    base = _default_validator.validate_base(a)\n    exp = _default_validator.validate_exponent(b)\n    return _default_service.power(base, exp)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/98": [{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Calculates the product of all numbers in a sequence and divides by its length.\n    It assumes the input sequence is non-empty and contains only numeric values.\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= float(num)\n\n    length = len(numbers)\n    # The design context explicitly states to not add error handling for edge cases.\n    # Therefore, we assume length > 0.\n    \n    return product / length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/99": [{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    The result will have no leading zeros, except for the input 0 which returns \"0\".\n    \"\"\"\n    if decimal_num == 0:\n        return \"0\"\n\n    binary_digits = []\n    while decimal_num > 0:\n        binary_digits.append(str(decimal_num % 2))\n        decimal_num //= 2\n    \n    return \"\".join(reversed(binary_digits))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/102": [{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_str: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase).\"\"\"\n\n    def _capitalize_component(comp: str) -> str:\n        if not comp:\n            return \"\"\n        # Capitalizes the first character and lowercases the rest.\n        # This handles single-character components (e.g., 'a' -> 'A')\n        # and multi-character components (e.g., 'python' -> 'Python').\n        return comp[0].upper() + comp[1:].lower()\n\n    if not snake_str:\n        return \"\"\n\n    normalized_str = snake_str.strip()\n    \n    # Split by underscore and filter out any empty strings resulting from\n    # multiple consecutive underscores (e.g., '__a_b__' -> ['', '', 'a', '_b', ''])\n    components = [\n        _capitalize_component(part)\n        for part in normalized_str.split(\"_\")\n        if part # Filter out empty parts\n    ]\n\n    return \"\".join(components)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["___python_program"]]}], "Mbpp/101": [{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Assumes valid inputs as per design context, without explicit validation here.\n    \"\"\"\n    return array[k - 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/94": [{"task_id": "Mbpp/94", "solution": "def index_minimum(items):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    If multiple tuples tie f