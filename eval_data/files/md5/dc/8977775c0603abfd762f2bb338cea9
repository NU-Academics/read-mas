mber W_n is defined as n * 2^n - 1 for n >= 1.\n    \"\"\"\n    if num < 1:\n        return False\n\n    def _compute_woodall_candidate(n: int) -> int:\n        \"\"\"Computes the n-th Woodall number W_n = n * 2^n - 1.\"\"\"\n        return n * (1 << n) - 1\n\n    def _get_upper_n_bound(m: int) -> int:\n        \"\"\"\n        Calculates a conservative upper bound for n in the search for m = n * 2^n - 1.\n        It finds the smallest n_val such that _compute_woodall_candidate(n_val) > m,\n        then returns n_val - 1 as the actual upper bound to check.\n        \"\"\"\n        if m < 1:\n            return 0\n        \n        n_val = 1\n        while True:\n            candidate_val = _compute_woodall_candidate(n_val)\n            if candidate_val > m:\n                return n_val - 1\n            # A practical safety cap for n_val to prevent infinite loops with extremely large 'm',\n            # as Woodall numbers grow very rapidly. n is usually very small.\n            if n_val > 100: \n                return n_val - 1\n            n_val += 1\n\n    upper_bound_n = _get_upper_n_bound(num)\n\n    for n in range(1, upper_bound_n + 1):\n        woodall_candidate = _compute_woodall_candidate(n)\n        if woodall_candidate == num:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/19": [{"task_id": "Mbpp/19", "solution": "def test_duplicate(array_of_integers):\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    It uses a set for efficient O(N) detection of duplicates.\n    \"\"\"\n    seen = set()\n    for num in array_of_integers:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/61": [{"task_id": "Mbpp/61", "solution": "def count_Substrings(s):\n    \"\"\"\n    Counts substrings where 