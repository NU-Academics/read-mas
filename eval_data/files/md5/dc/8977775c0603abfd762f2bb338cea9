Error):\n        \"\"\"Raised when a function parameter is invalid.\"\"\"\n        pass\n\n    class InvalidRecordError(MinKError):\n        \"\"\"Raised when a record has an invalid format or value.\"\"\"\n        pass\n\n    @dataclass(frozen=True)\n    class Record:\n        \"\"\"Data model for a single record with a name and a numeric value.\"\"\"\n        name: str\n        value: float\n\n        def to_tuple(self) -> Tuple[str, float]:\n            \"\"\"Converts the Record object back to a (name, value) tuple.\"\"\"\n            return (self.name, self.value)\n\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validate_and_convert_tuple(raw: Tuple[Any, Any]) -> Record:\n        \"\"\"Validates and converts a raw tuple into a Record object.\"\"\"\n        if not isinstance(raw, (list, tuple)) or len(raw) != 2:\n            raise InvalidRecordError(f\"Record must be a tuple or list of (name, value): {raw!r}\")\n        name, value = raw[0], raw[1]\n        if not isinstance(name, str):\n            raise InvalidRecordError(f\"Record name must be a string: {name!r}\")\n        if not is_numeric(value):\n            raise InvalidRecordError(f\"Record value must be numeric: {value!r}\")\n        return Record(name=name, value=float(value))\n\n    def stable_n_smallest(records_list: List[Record], num_k: int) -> List[Record]:\n        \"\"\"Returns the k smallest records, preserving original order for ties.\"\"\"\n        if num_k <= 0:\n            return []\n        # Use enumerate to preserve input order for ties when using heapq.nsmallest\n        enumerated = [(r.value, idx, r) for idx, r in enumerate(records_list)]\n        smallest = heapq.nsmallest(num_k, enumerated, key=lambda x: (x[0], x[1]))\n        return [t[2] for t in smallest]\n\n    class InputAdapter:\n        \"\"\"Adapts raw input data into a list of Record objects.\"\"\"\n        def from_list(self, raw_list: List[Tuple[Any, Any]]) -> List[Record]:\n            \"\"\"Converts a list of raw tuples to a list of Record objects.\"\"\"\n            return [validate_and_convert_tuple(item) for item in raw_list]\n\n    class MinKService:\n        \"\"\"Provides the core business logic for finding k minimum records.\"\"\"\n        def min_k(self, records_list: List[Record], num_k: int) -> List[Record]:\n            \"\"\"\n            Validates k and returns up to k smallest records.\n            Returns all records sorted ascending if k is greater than or equal to the total count.\n            \"\"\"\n            self._validate_k(num_k)\n            if num_k == 0:\n                return []\n            if num_k >= len(records_list):\n                # Return all records sorted ascending by value\n                return sorted(records_list, key=lambda r: r.value)\n            return stable_n_smallest(records_list, num_k)\n\n        def _validate_k(self, num_k: int) -> None:\n            \"\"\"Validates the input k parameter.\"\"\"\n            if not isinstance(num_k, int):\n                raise InvalidParameterError(\"k must be an integer\")\n            if num_k < 0:\n                raise InvalidParameterError(\"k must be non-negative\")\n\n    # Main logic: orchestrate the conversion and selection process\n    adapter = InputAdapter()\n    recs = adapter.from_list(records)\n    service = MinKService()\n    result = service.min_k(recs, k)\n    return [r.to_tuple() for r in result]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[], -1]]}], "Mbpp/759": [{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(s: str) -> bool:\n    \"\"\"Checks if a string represents a decimal number with exactly two fractional digits.\"\"\"\n    \n    def normalize_input(value: str) -> str:\n        \"\"\"Strips leading/trailing whitespace from the input string.\"\"\"\n        return value.strip()\n\n    # Regex 