f max_sub_array_sum_repeated(arr: list[int], n: int | None, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by\n    repeating the given array k times.\n    \"\"\"\n\n    def kadane(current_arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum contiguous subarray sum.\"\"\"\n        max_ending_here = current_arr[0]\n        max_so_far = current_arr[0]\n        for x in current_arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    def total_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the sum of all elements in the array.\"\"\"\n        return sum(current_arr)\n\n    def max_prefix_sum(current_arr: list[int]) -> int:\n        \"\"\"Finds the maximum sum of any prefix of the array.\"\"\"\n        best_prefix = current_arr[0]\n        current_sum = current_arr[0]\n        for x in current_arr[1:]:\n            current_sum += x\n            best_prefix = max(best_prefix, current_sum)\n        return best_prefix\n\n    def max_suffix_sum(current_arr: list[int]) -> int:\n        \"\"\"Finds the maximum sum of any suffix of the array.\"\"\"\n        best_suffix = current_arr[-1]\n        current_sum = current_arr[-1]\n        for x in reversed(current_arr[:-1]):\n            current_sum += x\n            best_suffix = max(best_suffix, current_sum)\n        return best_suffix\n\n    # Base case: k=1, the problem reduces to standard Kadane's algorithm on the single array.\n    if k == 1:\n        return kadane(arr)\n\n    # Calculate properties of the single array needed for repeated array logic.\n    single_array_sum = total_sum(arr)\n    max_sum_in_single = kadane(arr)\n    max_prefix = max_prefix_sum(arr)\n    max_suffix = max_suffix_sum(arr)\n\n    # Combine these properties to find the maximum subarray sum in the repeated array.\n    if single_array_sum > 0:\n        # If the total sum of the array is positive, repeating the array multiple times\n        # can potentially increase the maximum sum by including (k-2) full array sums.\n        return max(max_sum_in_single, max_prefix + max_suffix + (k - 2) * single_array_sum)\n    else:\n        # If the total sum is non-positive, adding full array sums would not help\n        # or would decrease the maximum sum. The best sum will either be entirely\n        # within a single copy or span across the boundary of two copies.\n        return max(max_sum_in_single, max_prefix + max_suffix)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/294": [{"task_id": "Mbpp/294", "solution": "from typing import Iterable, List, Any\nclass MaxFinderError(Exception):\n    \"\"\"Base exception for the MaxFinder library.\"\"\"\n    pass\nclass InvalidInputError(MaxFinderError):\n    \"\"\"Raised when the input is invalid (e.g., not iterable).\"\"\"\n    pass\nclass NoNumericValuesError(MaxFinderError):\n    \"\"\"Raised when no numeric values are found in the input list.\"\"\"\n    pass\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an int or float, excluding bool.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\nclass ListSanitizer:\n    \"\"\"Filters and validates list items for numeric values.\"\"\"\n    def validate_items(self, items: Any) -> None:\n        \"\"\"Ensures the input is an iterable.\"\"\"\n        if items is None:\n            raise InvalidInputError(\"Input must be an iterable, got None\")\n        try:\n            iter(items)\n        except TypeError:\n            raise InvalidInputError(\"Input must be iterable\")\n\n    def filter_numeric(self, items: Iterable[Any]) -> List[float | int]:\n        \"\"\"Returns a list of numeric values from the input iterable.\"\"\"\n        return [x for x in items if is_numeric(x)]\nclass MaxValueService:\n    \"\"\"Orchestrates validation, sanitization, and computation of the max value.\"\"\"\n    def __init__(self, sanitizer: ListSanitizer | None = None):\n        \"\"\"Initializes the service with an optional sanitizer.\"\"\"\n        self._sanitizer = sanitizer or ListSanitizer()\n\n    def compute_max(self, items: Iterable) -> float | int:\n        \"\"\"Computes the maximum numeric value from an iterable.\"\"\"\n        self._sanitizer.validate_items(items)\n        nums = self._sanitizer.filter_numeric(items)\n        if not nums:\n            raise NoNumericValuesError(\"No numeric values in input\")\n        return max(nums)\ndef max_val(items: list) -> float | int:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    \"\"\"\n    service = MaxValueService()\n    return service.compute_max(items)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["3.14", false, 7.5]]]}], "Mbpp/297": [{"task_id": "Mbpp/297", "solution": "def flatten_list(nested: list) -> list[Any]:\n    \"\"\"Flattens a given nested list structure into a single list using an iterative approach.\"\"\"\n    flattened_result = []\n    # The stack will hold iterators for lists to be processed, allowing depth-first traversal.\n    stack = [iter(nested)]\n\n    while stack:\n        try:\n            # Attempt to get the next item from the current top iterator on the stack.\n            current_item = next(stack[-1])\n        except StopIteration:\n            # If the current iterator is exhausted, remove it from the stack and continue.\n            stack.pop()\n            continue\n\n        if isinstance(current_item, list):\n            # If the item is a list, push its iterator onto the stack to process its elements next.\n            stack.append(iter(current_item))\n        else:\n            # If the item is not a list (an atomic value), append it to the final result list.\n            flattened_result.append(current_item)\n\n    return flattened_r