  current_arr[root_idx], current_arr[larger_child_idx] = current_arr[larger_child_idx], current_arr[root_idx]\n                root_idx = larger_child_idx  # Continue sifting down from the child's position\n            else:\n                # Heap property satisfied at root_idx, element is in correct place\n                break\n\n    def _build_max_heap(current_arr):\n        \"\"\"Builds a max-heap in-place from the given array.\"\"\"\n        # Iterate from the last parent node up to the root (index 0)\n        # The last parent of a 0-indexed array is at index (n // 2) - 1\n        for i in range(n // 2 - 1, -1, -1):\n            _sift_down(current_arr, i, n - 1)\n\n    # Build the initial max-heap\n    _build_max_heap(arr)\n\n    # Extract elements one by one from the heap to sort the array\n    # Start from the last element (n-1) down to the second element (1)\n    for i in range(n - 1, 0, -1):\n        # Swap the current largest element (at root, index 0) with the element at current end of heap\n        arr[i], arr[0] = arr[0], arr[i]\n        # Reduce the heap size by 1 and sift down the new root element\n        _sift_down(arr, 0, i - 1)\n\n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/631": [{"task_id": "Mbpp/631", "solution": "def replace_spaces(text):\n    \"\"\"\n    Replaces spaces with underscores or vice versa based on character predominance.\n    If spaces are more frequent or equally frequent as underscores, spaces become underscores; otherwise, underscores become spaces.\n    \"\"\"\n    spaces = text.count(\" \")\n    underscores = text.count(\"_\")\n\n    if spaces >= underscores:\n        return text.replace(\" \", \"_\")\n    else:\n        return text.replace(\"_\", \" \")", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/637": [{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(selling_price, cost_price):\n    \"