 n % i == 0:\n                factors.add(i)\n                factors.add(n // i)\n        return sorted(list(factors))\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Finds the sum of even factors of a given number.\n    Raises InvalidInputError if n is not an integer or is less than 1.\n    \"\"\"\n    validator = Validator()\n    service = FactorService(validator)\n    return service.sum_even_factors(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[false]]}], "Mbpp/454": [{"task_id": "Mbpp/454", "solution": "from .matcher_controller import MatcherController\nfrom .regex_matcher import RegexMatcher\nfrom .text_repository import TextRepository\nfrom .config import Config\nfrom .match_query import MatchQuery\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Checks if the text contains any word with 'z' using default configuration.\"\"\"\n    controller = MatcherController(RegexMatcher(Config()), TextRepository())\n    return controller.any_match(MatchQuery(text=text))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/457": [{"task_id": "Mbpp/457", "solution": "def Find_Min(lists: List[Sequence[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    If multiple sublists share the minimum length, the first one encountered is returned.\n    \"\"\"\n    # Convert all sub-sequences to lists for consistent processing and to handle tuples.\n    normalized_lists = [list(sublist) for sublist in lists]\n\n    # Find the sublist with the minimum length using the built-in min function with a key.\n    min_sublist = min(normalized_lists, key=len)\n\n    return min_sublist", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/456": [{"task_id": "Mbpp/456", "solution": "def reverse_string_list(values: list[str]) -> list[str]:\n    \"\"\"Reverses each string in a given list of st