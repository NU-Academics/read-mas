er, ...], ...]:\n            return self.items\n\n        def __len__(self) -> int:\n            return len(self.items)\n\n        def __getitem__(self, index: int) -> Tuple[Number, ...]:\n            return self.items[index]\n\n    class Validator:\n        def __init__(self) -> None:\n            pass\n\n        def validate_and_convert(self, raw: Sequence[Sequence[Number]]) -> TupleSequence:\n            if not isinstance(raw, (list, tuple)):\n                raise InvalidInputError(\"Input must be a sequence of sequences.\")\n            \n            for inner in raw:\n                if not isinstance(inner, (list, tuple)):\n                    raise InvalidInputError(\"Each outer element must be a sequence.\")\n\n            for inner in raw:\n                for v in inner:\n                    if not self._is_number(v):\n                        raise InvalidInputError(\"Non-numeric value found in sequence.\")\n            \n            return TupleSequence(raw)\n\n        def _is_number(self, value: object) -> bool:\n            return isinstance(value, (int, float))\n\n        def _validate_outer_shape(self, a: Sequence, b: Sequence) -> None:\n            if len(a) != len(b):\n                raise InvalidInputError(\"Outer sequence lengths do not match.\")\n\n        def _validate_inner_shape(self, inner_a: Sequence, inner_b: Sequence) -> None:\n            if len(inner_a) != len(inner_b):\n                raise InvalidInputError(\"Inner sequence lengths do not match.\")\n\n    class MaximizerService:\n        def __init__(self, validator: Validator = None) -> None:\n            self.validator = validator or Validator()\n\n        def maximize(self, seq_a: TupleSequence, seq_b: TupleSequence) -> TupleSequence:\n            self.validator._validate_outer_shape(seq_a, seq_b)\n\n            result = []\n            for a_inner, b_inner in zip(seq_a.to_tuple(), seq_b.to_tuple()):\n                self.validator._validate_inner_shape(a_inner, b_inner)\n       