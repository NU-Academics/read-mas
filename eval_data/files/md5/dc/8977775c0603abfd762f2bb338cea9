# Pattern 1: Split before capital after lowercase or digit\n        self._pattern1 = re.compile(r'(?<=[a-z0-9])(?=[A-Z])')\n        # Pattern 2: Split between acronym and next capital+lowercase\n        self._pattern2 = re.compile(r'(?<=[A-Z])(?=[A-Z][a-z])')\n\n    def split_tokens(self, text: str) -> List[str]:\n        \"\"\"Splits text into tokens, handling capital words and existing spaces.\"\"\"\n        if not StringUtils.is_str(text):\n            raise SplitterConfigurationError(\"text must be str\")\n\n        parts = re.split(r'(\\s+)', text)\n        tokens = []\n        for p in parts:\n            if p.isspace():\n                tokens.append(p)\n            else:\n                t = self._pattern2.sub(' ', p)\n                t = self._pattern1.sub(' ', t)\n                tokens.extend([tok for tok in t.split(' ') if tok != \"\"])\n        return tokens\nclass CapitalWordsSplitter:\n    \"\"\"Core business logic for splitting capital words.\"\"\"\n    DEFAULT_MAX_LENGTH = 10000\n\n    def __init__(self, strategy: ISplitStrategy, max_length: int = DEFAULT_MAX_LENGTH):\n        self._strategy = strategy\n        self._max_length = max_length\n\n    def split(self, text: str) -> SplitResult:\n        \"\"\"Splits the input text based on capital word boundaries.\"\"\"\n        if not StringUtils.is_str(text):\n            raise SplitterTypeError(\"text must be str\")\n        if len(text) > self._max_length:\n            raise SplitterTypeError(f\"text too long (max {self._max_length} characters)\")\n\n        tokens = self._strategy.split_tokens(text)\n        return SplitResult.from_tokens(text, tokens)\nclass CapitalWordsController:\n    \"\"\"API layer that validates inputs and delegates to the splitter service.\"\"\"\n    def __init__(self, splitter: CapitalWordsSplitter):\n        self._splitter = splitter\n\n    def capital_words_spaces(self, s: str) -> str:\n        \"\"\"Converts a string to have spaces before capital words.\"\"\"\n        if not StringUtils.is_str(s):\n            raise SplitterTypeError(\"Input must be a string\")\n        return self._splitter.split(s).result\nclass SplitterFactory:\n    \"\"\"Factory for creating configured splitter instances.\"\"\"\n    def create_default_splitter(self) -> CapitalWordsSplitter:\n        \"\"\"Creates a CapitalWordsSplitter with the default RegexSplitStrategy.\"\"\"\n        strategy = RegexSplitStrategy()\n        return CapitalWordsSplitter(strategy)\n\n    def create_default_splitter_controller(self) -> CapitalWordsController:\n        \"\"\"Creates a CapitalWordsController with the default splitter.\"\"\"\n        return CapitalWordsController(self.create_default_splitter())\ndef capital_words_spaces(s: str) -> str:\n    \"\"\"Inserts spaces between words starting with capital letters in a string.\"\"\"\n    factory = SplitterFactory()\n    controller = factory.create_default_splitter_controller()\n    return controller.capital_words_spaces(s)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/752": [{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(index: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number iteratively.\n    J(0)=0, J(1)=1, and J(n)=J(n-1)+2*J(n-2) for n >= 2.\n    \"\"\"\n    if index == 0:\n        return 0\n    if index == 1:\n        return 1\n    \n    a, b = 0, 1\n    for _ in range(2, index + 1):\n        a, b = b, b + 2 * a\n    return b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/755": [{"task_id": "Mbpp/755", "solution": "def second_smallest(lst):\n    \"\"\"\n    Finds the second smallest number in a list, allowing duplicates.\n    This implementation returns float('inf') if the list has fewer than two elements.\n    \"\"\"\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in lst:\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n       