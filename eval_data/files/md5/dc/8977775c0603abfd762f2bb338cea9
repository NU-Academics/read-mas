ts are not comparable for sorting, maintain current order.\n            pass\n    else:\n        # Fallback for unhashable elements, using nested loops and equality checks.\n        seen = [] # Tracks unique elements already added to `shared`.\n\n        for item_a in list_a:\n            found_in_b = False\n            for item_b in list_b:\n                if item_a == item_b:\n                    found_in_b = True\n                    break\n\n            if found_in_b:\n                already_seen = False\n                for s_item in seen:\n                    if item_a == s_item:\n                        already_seen = True\n                        break\n                if not already_seen:\n                    shared.append(item_a)\n                    seen.append(item_a) # Add to seen for future deduplication.\n\n        try:\n            shared.sort() # Attempt to sort for deterministic output.\n        except TypeError:\n            # If elements are not comparable, fallback to insertion order.\n            pass\n\n    return shared", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/4": [{"task_id": "Mbpp/4", "solution": "from typing import Iterable, List\nimport heapq\ndef heap_queue_largest(nums: Iterable[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list using a min-heap.\n    The heap maintains the n largest elements encountered, returned in descending order.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    min_heap = []\n    for x in nums:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, x)\n        else:\n            if x > min_heap[0]:\n                heapq.heapreplace(min_heap, x)\n    \n    return sorted(min_heap, reverse=True)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/9": [{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the Knuth-Morris-Pratt (KMP) prefix function to determine the string's minimal period.\n    \"\"\"\n    n = len(s)\n    # The problem implies non-empty strings by stating \"rotations (greater than 0)\".\n    # A string of length 0 cannot have rotations greater than 0.\n    # For 'aaaa', n=4, lps=[0,1,2,3]. period_candidate = 4 - 3 = 1. 4 % 1 == 0, returns 1.\n    # For 'abab', n=4, lps=[0,0,1,2]. period_candidate = 4 - 2 = 2. 4 % 2 == 0, returns 2.\n    # For 'abc', n=3, lps=[0,0,0]. period_candidate = 3 - 0 = 3. 3 % 3 == 0, returns 3.\n\n    # Compute the Longest Proper Prefix which is also Suffix (LPS) array\n    lps = [0] * n\n    length = 0  # Length of the previous longest prefix suffix\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                # This is tricky. We shift the pattern.\n                # 'length' becomes the length of the longest prefix suffix for s[0...length-1]\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # The minimal period of a string s of length n is n - lps[n-1].\n    # This period p is the length of the smallest repeating unit.\n    # If n is perfectly divisible by p, then p is the minimum rotation.\n    # Otherwise, no smaller rotation exists, and the string itself (n rotations) is the answer.\n    # This logic assumes n > 0.\n    period_candidate = n - lps[n - 1]\n\n    if n % period_candidate == 0:\n        return period_candidate\n    else:\n        return n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/8": [{"task_id": "Mbpp/8", "solution": "from typing import Any, List, Sequence, Union, Optional\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input is not a valid iterable or string.\"\"\"\n    pass\nclass NonNumericElementError(Exception):\n    \"\"\"Raised when an element cannot be converted to a number.\"\"\"\n    def __init__(self, element, message=\"Element is not numeric\"):\n        self.element = element\n        self.message = message\n        super().__init__(f\"{message}: {repr(element)}\")\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations.\"\"\"\n    @staticmethod\n    def safe_square(x: Union[int, float]) -> Union[int, float]:\n        \"\"\"Computes the square of a number.\"\"\"\n        return x * x\nclass InputValidator:\n    \"\"\"Validates and normalizes raw input into a list of numbers.\"\"\"\n    def _parse_element(self, elem: Any) -> Union[int, float]:\n        \"\"\"Converts an element to int or float, raising error for non-numeric.\"\"\"\n        try:\n            return int(elem)\n        except (ValueError, TypeError):\n            try:\n                return float(elem)\n            except (ValueError, TypeError) as e:\n                raise NonNumericElementError(elem, \"Cannot convert element to a number\") from e\n\n    def validate(self, values: Any) -> List[Union[int, float]]:\n        \"\"\"Validates and converts input values to a list of numbers.\"\"\"\n        if isinstance(values, str):\n            raw_elements = [s.strip() for s in values.replace(',', ' ').split() if s.strip()]\n        else:\n            try:\n                raw_elements = list(values)\n            except TypeError:\n                raise InvalidInputError(\"Input must be an iterable or a string\")\n\n        return [self._parse_element(e) for e in raw_elements]\nclass SquareService:\n    \"\"\"Core business logic for computing squares.\"\"\"\n    def __init__(self, validator: 'InputValidator') -> None:\n        self._validator = validator\n\n    def square_nums(self, values: Any) -> List[Union[int, float]]:\n        \"\"\"Validates input and returns a list of squared numbers.\"\"\"\n        nums = self._validator.validate(values)\n        return [MathUtils.safe_square(n) for n in nums]\nclass SquareController:\n    \"\"\"Orchestrates square computation for API consumers.\"\"\"\n    def __init__(self, service: 'SquareService', repo: Optional[Any] = None) -> None:\n        self._service = service\n        self._repo = repo # Placeholder as persistence is optional and not used in this path\n\n    def handle_square_request(self, raw_input: Any, persist: bool = False, persist_path: Optional[str] = None) -> List[Union[int, float]]:\n        \"\"\"Handles a request to square numbers.\"\"\"\n        squares = self._service.square_nums(raw_input)\n        return squares\ndef square_nums(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the square of each number in a list.\n    Returns a new list containing the squared values.\n    \"\"\"\n    validator = InputValidator()\n    service = SquareService(validator)\n    controller = SquareController(service)\n    return controller.handle_square_request(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/12": [{"task_id": "Mbpp/12", "solution": "from typing import List, Union\ndef sort_matrix(matrix: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    The sorting is stable, preserving the original relative order for rows with equal sums.\n    \"\"\"\n    # Pair each row with its original index to enable stable sorting.\n    indexed_rows = enumerate(matrix)\n\n    # Sort the rows based on the sum of elements in each row.\n    # If row sums are equal, the original index is used as a secondary key for stability.\n    sorted_indexed_rows = sorted(indexed_rows, key=lambda item: (sum(item[1]), item[0]))\n\n    # Extract only the sorted rows, discarding the temporary indices.\n    sorted_matrix = [row for _, row in sorted_indexed_rows]\n