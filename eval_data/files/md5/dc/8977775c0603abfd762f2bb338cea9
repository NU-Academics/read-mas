 FormatterService()\n\n    def format_all(self, request: FormatRequest) -> List[str]:\n        \"\"\"Validates the request and applies the format string to all items.\"\"\"\n        validated = self.validator.validate(request)\n        return self.service.format_all(validated)\ndef add_string(items: Sequence[Any], fmt: str) -> List[str]:\n    \"\"\"\n    Applies a given format string to all elements in a list.\n    E.g., add_string([1,2,3,4],'temp{0}') returns ['temp1', 'temp2', 'temp3', 'temp4'].\n    \"\"\"\n    facade = AddStringFacade()\n    return facade.format_all(FormatRequest(items=items, fmt=fmt))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/394": [{"task_id": "Mbpp/394", "solution": "def check_distinct(data: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    It uses a set for hashable elements and a fallback for unhashable ones.\n    \"\"\"\n    def _is_hashable(elem) -> bool:\n        try:\n            hash(elem)\n            return True\n        except TypeError:\n            return False\n\n    # Check if all elements are hashable\n    all_hashable = True\n    for item in data:\n        if not _is_hashable(item):\n            all_hashable = False\n            break\n\n    if all_hashable:\n        # Use set-based check for efficient duplicate detection\n        return len(set(data)) == len(data)\n    else:\n        # Fallback for sequences with unhashable elements\n        # This approach works for unhashable but comparable elements (e.g., lists)\n        seen = []\n        for item in data:\n            if item in seen:\n                return False\n            seen.append(item)\n        return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/392": [{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int, _memo: dict = None) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the given equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses memoization to cache results of subproblems.\n    \"\"\"\n    if _memo is None:\n        _memo = {}\n\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        return 0\n\n    # Recursively calculate the sum of f(n/k) for k in (2, 3, 4, 5) using floor division\n    sum_of_parts = (\n        get_max_sum(n // 2, _memo) +\n        get_max_sum(n // 3, _memo) +\n        get_max_sum(n // 4, _memo) +\n        get_max_sum(n // 5, _memo)\n    )\n\n    result = max(n, sum_of_parts)\n    _memo[n] = result\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/398": [{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns the total sum.\n    Handles numbers as integers or string representations of integers, ignoring signs for digit summation.\n    \"\"\"\n    total_digit_sum = 0\n    for number in numbers:\n        # Convert the number (which might be an int or a string) to an integer.\n        # The design context implies that non-integer floats or invalid strings should raise errors,\n        # but the completion instruction forbids explicit checks or exceptions here.\n        n_as_int = int(number)\n\n        # Get the absolute value to handle negative numbers as per design rules (e.g., -12 -> 1 + 2).\n        abs_n = abs(n_as_int)\n\n        # Convert the absolute integer to a string to easily iterate over its digits.\n        s_abs_n = str(abs_n)\n\n        # Sum the integer value of each character (digit) in the string.\n        current_number_digit_sum = sum(int(digit_char) for digit_char in s_abs_n)\n\n        total_digit_sum += current_number_digit_sum\n\n    return total_digit_sum", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[10, 20, 4, 5, "b", 70, "a"]]]], "plus_fail_tests": [[[10, -5, "abc", 0,