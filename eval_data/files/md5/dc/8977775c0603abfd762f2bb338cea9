rService:\n    \"\"\"Coordinates input validation, pattern matching, and metrics recording.\"\"\"\n    def __init__(self, regex_helper: RegexHelper, metrics_repo: MetricsRepository) -> None:\n        self._regex_helper = regex_helper\n        self._metrics_repo = metrics_repo\n\n    def match(self, text: str) -> bool:\n        \"\"\"Validates input, matches pattern, and records the call.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"text must be a str\", text)\n\n        matched = self._regex_helper.match_pattern(text)\n        try:\n            self._metrics_repo.record_call(text)\n        except Exception:\n            pass # Swallows metrics errors as they are non-critical.\n        return matched\nclass TextMatchController:\n    \"\"\"Public API interface for the text matching functionality.\"\"\"\n    def __init__(self, service: TextMatcherService) -> None:\n        self.service = service\n\n    def text_match_three(self, text: str) -> bool:\n        \"\"\"Delegates the matching request to the underlying service.\"\"\"\n        return self.service.match(text)\n_metrics_repository = MetricsRepository()\n_regex_helper = RegexHelper()\n_text_matcher_service = TextMatcherService(_regex_helper, _metrics_repository)\n_default_controller = TextMatchController(_text_matcher_service)\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains an 'a' followed by exactly three 'b's (\"abbb\").\n    Updates in-memory usage metrics.\n    \"\"\"\n    return _default_controller.text_match_three(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/720": [{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(t, d):\n    \"\"\"\n    Appends a dictionary as a single element to an existing tuple.\n    Returns a new tuple with the dictionary added at the end.\n    \"\"\"\n    return t + (d,)", "base_status": "pass", "plus_status": "pass", "base_fail_t