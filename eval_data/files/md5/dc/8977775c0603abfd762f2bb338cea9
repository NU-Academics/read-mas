lf.left = left\n        self.right = right\nclass Converter:\n    \"\"\"Helper for converting values to float.\"\"\"\n    def to_float(self, value: Any) -> float:\n        \"\"\"Converts a value to float, raising NonNumericElementError on failure.\"\"\"\n        try:\n            return float(value)\n        except (ValueError, TypeError) as exc:\n            raise NonNumericElementError(f\"Cannot convert {value!r} to float\", value=value) from exc\nclass Validator:\n    \"\"\"Validates input sequences and prepares them for division.\"\"\"\n    def __init__(self, converter: Converter) -> None:\n        self._converter = converter\n\n    def validate_and_prepare(self, a: Sequence[Any], b: Sequence[Any]) -> ListPair:\n        \"\"\"Checks inputs for length, numeric types, and zero divisors.\n        Returns a ListPair of converted float lists.\"\"\"\n        la = list(a)\n        lb = list(b)\n\n        if len(la) != len(lb):\n            raise LengthMismatchError(\"Input lists must have the same length\")\n\n        left = []\n        for i, x in enumerate(la):\n            try:\n                left.append(self._converter.to_float(x))\n            except NonNumericElementError as exc:\n                exc.index = i\n                raise exc\n\n        right = []\n        for i, x in enumerate(lb):\n            try:\n                f_val = self._converter.to_float(x)\n                if f_val == 0.0:\n                    raise DivisionByZeroError(f\"Division by zero at index {i}\", index=i)\n                right.append(f_val)\n            except NonNumericElementError as exc:\n                exc.index = i\n                raise exc\n\n        return ListPair(left, right)\nclass DividerService:\n    \"\"\"Core business logic for element-wise division.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def div_lists(self, pair: ListPair) -> List[float]:\n        \"\"\"Performs element-wise division on a ListPair.\"\"\"\n        return [l_val / r_val for l_val, r_val in zip(pair.left, pair.right)]\nclass DividerController:\n    \"\"\"Orchestrates validation and service calls.\"\"\"\n    def __init__(self, validator: Validator, service: DividerService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def divide(self, a: Sequence[Any], b: Sequence[Any]) -> List[float]:\n        \"\"\"Validates inputs, then performs element-wise division.\n        Propagates exceptions from validation and service layers.\"\"\"\n        pair = self._validator.validate_and_prepare(a, b)\n        return self._service.div_lists(pair)\ndef div_list(a: Sequence[Union[int, float]], b: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"Divides two lists element-wise, handling validation and error cases.\n    Returns a new list of floats with the division results.\"\"\"\n    converter = Converter()\n    validator = Validator(converter)\n    service = DividerService()\n    controller = DividerController(validator, service)\n    return controller.divide(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/623": [{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers, n):\n    \"\"\"\n    Computes the n-th power of each number in the input list.\n    Returns a new list with the results.\n    \"\"\"\n    return [num ** n for num in numbers]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/624": [{"task_id": "Mbpp/624", "solution": "def is_upper(value: str) -> str:\n    \"\"\"Converts a given string to its uppercase representation.\n\n    Raises ValidationError if the input is not a string.\"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for validation errors in the string transformation domain.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class Utils:\n        \"\"\"Provides utility me