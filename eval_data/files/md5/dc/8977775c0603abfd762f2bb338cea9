Finds the minimum absolute difference between any two elements in the given array.\n    The algorithm sorts the array and then checks adjacent elements for the minimum difference.\n    \"\"\"\n    nums_list = list(numbers)\n    nums_list.sort()\n\n    min_difference = float('inf')\n\n    for i in range(1, len(nums_list)):\n        diff = abs(nums_list[i] - nums_list[i-1])\n        if diff < min_difference:\n            min_difference = diff\n            if min_difference == 0:\n                break\n\n    return min_difference", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/745": [{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit zero are excluded.\n    \"\"\"\n    result = []\n\n    def _is_divisible_by_all_digits(n: int) -> bool:\n        # Convert the absolute value of the number to a string to iterate through its digits.\n        s_num = str(abs(n))\n        \n        for char_digit in s_num:\n            digit = int(char_digit)\n            \n            # If any digit is 0, the number is disqualified as per the problem statement.\n            # Division by zero is also undefined.\n            if digit == 0:\n                return False\n            \n            # Check if the number is divisible by the current digit.\n            if n % digit != 0:\n                return False\n                \n        # If all digits are non-zero and divide the number, it satisfies the condition.\n        return True\n\n    # Iterate through all numbers in the specified range, inclusive.\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_all_digits(num):\n            result.append(num)\n            \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_t