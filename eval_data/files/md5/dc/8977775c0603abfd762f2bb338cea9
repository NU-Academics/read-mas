     self._model_name = model\n        self._nlp: Optional[Any] = None # Will be spacy.language.Language object\n\n    def _load(self) -> None:\n        \"\"\"Lazily loads the spaCy model.\"\"\"\n        try:\n            import spacy\n            self._nlp = spacy.load(self._model_name, disable=[\"parser\", \"ner\"])\n        except ImportError:\n            raise AdapterUnavailableError(\n                \"spaCy is not installed. Please install it with 'pip install spacy' \"\n                \"and its model with 'python -m spacy download en_core_web_sm'.\"\n            )\n        except OSError:\n            raise AdapterUnavailableError(\n                f\"spaCy model '{self._model_name}' not found. Please download it with \"\n                f\"'python -m spacy download {self._model_name}'.\"\n            )\n\n    def tag_with_offsets(self, sentence: str) -> List[Tuple[str, str, int, int]]:\n        \"\"\"Tags a sentence with POS tags and returns (token_text, pos_tag, start, end).\"\"\"\n        if self._nlp is None:\n            self._load()\n        \n        doc = self._nlp(sentence)\n        return [(token.text, token.pos_, token.idx, token.idx + len(token.text)) for token in doc]\nDEFAULT_ADVERB_WHITELIST: Set[str] = {\"very\", \"well\", \"quite\", \"too\", \"just\", \"almost\", \"already\", \"enough\", \"far\"}\nclass AdverbDetector:\n    \"\"\"Detects the first adverb using either a heuristic or a spaCy adapter.\"\"\"\n    def __init__(self, spacy_adapter: Optional[SpacyAdapter] = None, whitelist: Optional[Set[str]] = None) -> None:\n        self._spacy_adapter = spacy_adapter\n        self._whitelist = set(whitelist or DEFAULT_ADVERB_WHITELIST)\n\n    def detect_first(self, tokens: List[Tuple[str, int, int]], sentence: str, mode: str = \"auto\") -> Tuple[int, int, str]:\n        \"\"\"\n        Detects the first adverb in the sentence using the specified mode.\n        Returns (start_index, end_index, adverb_text).\n        \"\"\"\n        use_spacy = (mode.lower() == \"spacy\") or (mode.lower() == \"auto\" and self._spacy_adapter is not None)\n\n        if use_spacy:\n            if self._spacy_adapter is None:\n                # This should only happen if mode was \"spacy\" directly and adapter not provided\n                raise AdapterUnavailableError(\"spaCy adapter not available or not initialized.\")\n            \n            try:\n                spacy_result = self._detect_with_spacy(sentence)\n                if spacy_result:\n                    return spacy_result\n                if mode.lower() == \"spacy\": # If spaCy was explicitly requested and found nothing\n                    raise AdverbNotFoundError(\"No adverb found using spaCy mode.\")\n            except AdapterUnavailableError as e:\n                if mode.lower() == \"spacy\": # If spaCy was explicitly requested but failed\n                    raise e # Re-raise immediately\n                # Otherwise, for 'auto' mode, fall back to heuristic\n                pass\n\n        # Fallback to heuristic if spaCy not used, failed, or didn't find anything\n        heuristic_result = self._detect_with_heuristic(tokens)\n        if heuristic_result:\n            return heuristic_result\n        \n        raise AdverbNotFoundError(\"No adverb found.\")\n\n    def _detect_with_spacy(self, sentence: str) -> Optional[Tuple[int, int, str]]:\n        \"\"\"Uses the spaCy adapter to find the first adverb.\"\"\"\n        if self._spacy_adapter is None:\n            return None # Should be handled by detect_first, but defensive\n        \n        tagged_tokens = self._spacy_adapter.tag_with_offsets(sentence)\n        for text, pos, start, end in tagged_tokens:\n            if pos == \"ADV\": # spaCy's coarse-grained POS tag for adverbs\n                return start, end, clean_token(text).lower()\n        return None\n\n    def _detect_with_heuristic(self, tokens: List[Tuple[str, int, int]]) -> Optional[Tuple[int, int, str]]:\n        \"\"\"Uses heuristic rules to find the first adverb.\"\"\"\n        for token_text, start, end in tokens:\n            if self._is_adverb_heuristic(token_text):\n                return start, end, clean_token(token_text).lower()\n        return None\n\n    def _is_adverb_heuristic(self, token: str) -> bool:\n        \"\"\"Determines if a token is an adverb using a simple heuristic.\"\"\"\n        cleaned_token = clean_token(token).lower()\n        return cleaned_token.endswith(\"ly\") and len(cleaned_token) > 2 or cleaned_token in self._whitelist # Ensure \"ly\" isn't a short word like \"fly\"\nclass AdverbService:\n    \"\"\"Orchestrates tokenization and adverb detection.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, detector: AdverbDetector) -> None:\n        self._tokenizer = tokenizer\n        self._detector = detector\n\n    def find_adverb_position(self, sentence: str, mode: str = \"auto\") -> Tuple[int, int, str]:\n        \"\"\"\n        Finds the first adverb and its position in the given sentence.\n        Returns a tuple of (start_index, end_index, adverb_string).\n        \"\"\"\n        if not isinstance(sentence, str) or not sentence.strip():\n            raise InvalidInputError(\"sentence must be a non-empty string\")\n        \n        tokens = self._tokenizer.tokenize(sentence)\n        return self._detector.detect_first(tokens, sentence, mode=mode)\ndef find_adverb_position(sentence: str, mode: str = \"auto\") -> Tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its position in the given sentence.\n    Returns a tuple of (start_index, end_index, adverb_string).\n    \"\"\"\n    # Instantiate core components\n    tokenizer = Tokenizer()\n    spacy_adapter = SpacyAdapter()\n    detector = AdverbDetector(spacy_adapter=spacy_adapter)\n    service = AdverbService(tokenizer=tokenizer, detector=detector)\n\n    return service.find_adverb_position(sentence, mode=mode)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tes