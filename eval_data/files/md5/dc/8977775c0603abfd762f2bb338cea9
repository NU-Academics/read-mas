tems\n\n        def clean(self, data: object, depth: int = 0) -> object:\n            if self._should_remove(data):\n                return None\n\n            if isinstance(data, dict):\n                if self._config.recursive:\n                    return self._clean_mapping(data, depth)\n                else:\n                    return data\n            elif isinstance(data, (list, tuple, set)): # Added set here for completeness\n                if self._config.recursive:\n                    # _clean_sequence is defined to return a list, as per design\n                    # If input was tuple/set, it becomes a list after cleaning nested items.\n                    cleaned_list = self._clean_sequence(data, depth)\n                    if isinstance(data, tuple):\n                        return tuple(cleaned_list) # Convert back to tuple if original was tuple\n                    if isinstance(data, set):\n                        return set(cleaned_list) # Convert back to set if original was set\n                    return cleaned_list\n                else:\n                    return data\n            return data\n\n    # Logic mimicking DictCleanerService.drop_empty method\n\n    config = Config() # Use default configuration\n    \n    if not is_mapping(data):\n        raise ValidationError(\"top-level input must be a mapping\")\n\n    data_to_clean = deep_copy_if_needed(data, config.inplace)\n    \n    _filter = EmptyFilter(config.treat_whitespace_as_empty)\n    _cleaner = Cleaner(_filter, config)\n\n    cleaned_result = _cleaner.clean(data_to_clean)\n\n    if cleaned_result is None:\n        return {}\n    \n    # Ensure the final result is a dict, as per the function's return type hint.\n    if not isinstance(cleaned_result, dict):\n        # This case should ideally not be reached if initial 'data' was a Mapping and Cleaner works as expected.\n        # But for safety, handle scenarios where top-level dict might clean into a non-dict (e.g., if it became No