he cache and marks it as dirty for persistence.\"\"\"\n        if self._cache.get(n) != value:\n            self._cache[n] = value\n            self._dirty = True\n            self._save_cache() # Persist changes immediately\n\n    def clear(self) -> None:\n        \"\"\"Clears the in-memory cache and deletes the cache file.\"\"\"\n        self._cache = {}\n        self._dirty = False\n        if os.path.exists(self.cache_path):\n            try:\n                os.remove(self.cache_path)\n            except OSError as e:\n                raise CacheError(f\"Failed to delete cache file {self.cache_path}: {e}\")\nclass NewmanShanksWilliamsService:\n    \"\"\"Orchestrates NSW number computation, primality testing, and caching.\"\"\"\n\n    def __init__(self, sequence: SequenceGenerator, checker: PrimeChecker, repo: FileCacheRepository, prime_search_limit: int = DEFAULT_PRIME_SEARCH_LIMIT):\n        \"\"\"Initializes the service with core components and configuration.\"\"\"\n        self.sequence = sequence\n        self.checker = checker\n        self.repo = repo\n        self.prime_search_limit = prime_search_limit\n\n    def newman_prime(self, n: int, mode: str = \"index\") -> int:\n        \"\"\"Finds the nth Newman\u2013Shanks\u2013Williams number or the nth NSW prime.\"\"\"\n        mode = validate_mode(mode)\n\n        if mode == \"index\":\n            idx = validate_non_negative_int(\"n\", n)\n            cached = self.repo.get(idx)\n            if cached is not None:\n                return cached\n            val = self.sequence.compute_s_n(idx)\n            self.repo.set(idx, val)\n            return val\n        elif mode == \"prime\":\n            k = validate_positive_int(\"n\", n)\n            return self._find_kth_prime(k)\n        # validate_mode ensures no other modes are possible.\n\n    def _find_kth_prime(self, k: int) -> int:\n        \"\"\"Searches for the k-th prime in the Newman\u2013Shanks\u2013Williams sequence.\"\"\"\n        prime_count =