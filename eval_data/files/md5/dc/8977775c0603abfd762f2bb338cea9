 = 1 for 1 <= v <= m_val\n        # Array size m_val+2 to handle 1-based indexing easily and prefix sum boundary\n        dp_prev = [0] * (m_val + 2)\n        for v_start in range(1, m_val + 1):\n            dp_prev[v_start] = 1\n\n        # Iterate for k from 2 to n_val (current sequence length)\n        for k_len in range(2, n_val + 1):\n            # Calculate prefix sums for dp_prev\n            prefix_sums = [0] * (m_val + 2)\n            for i in range(1, m_val + 1):\n                prefix_sums[i] = prefix_sums[i - 1] + dp_prev[i]\n\n            dp_curr = [0] * (m_val + 2)\n            # Maximum possible first element for a sequence of current length k_len\n            current_k_max_start = _DPComputer._effective_max_start(m_val, k_len)\n\n            if current_k_max_start < 1:\n                # If no sequence of length k_len can start, then no sequences of length > k_len can either.\n                return 0\n\n            for v_current in range(1, current_k_max_start + 1):\n                # For a sequence of length k_len starting with v_current, the second element must be >= 2*v_current\n                # We need to sum dp_prev[x] for x in range(2*v_current, m_val+1)\n                lower_bound_for_next_element = 2 * v_current\n                if lower_bound_for_next_element > m_val:\n                    dp_curr[v_current] = 0\n                else:\n                    dp_curr[v_current] = prefix_sums[m_val] - prefix_sums[lower_bound_for_next_element - 1]\n            dp_prev = dp_curr\n\n        # The final dp_prev contains counts for sequences of length n_val starting with v.\n        # We need to sum these up for all possible starting values for the full length n_val.\n        final_sum_limit = _DPComputer._effective_max_start(m_val, n_val)\n        total_sequences = sum(dp_prev[v_final] for v_final in range(1, final_sum_limit + 1))\n        return total_sequences\nclass _SequenceService:\n    \"\"\"Orchestrates caching and computation for sequence counting.\"\"\"\n\n    _cache: _ResultCache\n\n    def __init__(self, cache: _ResultCache | None = None) -> None:\n        self._cache = cache if cache is not None else _ResultCache()\n\n    def count_sequences(self, m_val: int, n_val: int) -> int:\n        \"\"\"\n        Calculates the number of possible sequences given m and n, utilizing caching.\n        Assumes m and n are positive integers.\n        \"\"\"\n        key = (m_val, n_val)\n        cached = self._cache.get(key)\n        if cached is not None:\n            return cached\n\n        result = _DPComputer.compute_dp(m_val, n_val)\n        self._cache.set(key, result)\n        return result\n_service = _SequenceService()\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element\n    is a positive integer, greater than or equal to twice the previous element,\n    and less than or equal to m.\n    \"\"\"\n    return _service.count_sequences(m, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\nimport re\nfrom typing import Any, Union\nfrom dataclasses import dataclass\nfrom pathlib import Path\nimport json\nfrom datetime import datetime\nclass ConversionError(Exception):\n    \"\"\"Raised for invalid inputs or conversion problems.\"\"\"\n    pass\nclass PersistenceError(ConversionError):\n    \"\"\"Raised for repository persistence failures.\"\"\"\n    pass\nNUMERIC_RE = re.compile(r'^\\s*[+-]?(\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?\\s*$')\nCOMPLEX_RE = re.compile(r'^[\\s\\d.+\\-eEjJ()]+$')\nclass ValidationUtils:\n    \"\"\"Provides utility methods for input validation and parsing.\"\"\"\n    @staticmethod\n    def parse_input(value: Any) -> complex:\n        \"\"\"Parses various input types into a complex number.\"\"\"\n        if isinstance(value, complex):\n            return value\n        if isinstance(value, (int, float)):\n            return complex(value, 0.0)\n        if isinstance(value, str):\n            s = value.strip()\n            if NUMERIC_RE.match(s) or COMPLEX_RE.match(s):\n                try:\n                    return complex(s)\n                except ValueError as ex:\n                    raise ConversionError(f\"Cannot parse complex from string: {s}\") from ex\n            raise ConversionError(f\"Unsafe or invalid numeric string: {s}\")\n        raise ConversionError(f\"Unsupported input type: {type(value)}\")\nclass ComplexConverter:\n    \"\"\"Converts a complex number to polar coordinates.\"\"\"\n    def convert(self, z: complex) -> PolarCoordinate:\n        \"\"\"Computes radius and angle from a complex number.\"\"\"\n        r = math.hypot(z.real, z.imag)\n        theta = math.atan2(z.imag, z.real)\n        return PolarCoordinate(r=r, theta=theta)\nclass ConversionRepository:\n    \"\"\"Manages storage of conversion records, with optional JSON persistence.\"\"\"\n    def __init__(self, save_path: Path | None = None):\n        self._storage = []\n        self._save_path = Path(save_path) if save_path else None\n\n    def add(self, record: ConversionRecord) -> None:\n        \"\"\"Adds a conversion record to storage and optionally persists it.\"\"\"\n        self._storage.append(record)\n        if self._save_path:\n            self._persist(record)\n\n    def list_all(self) -> list[ConversionRecord]:\n        \"\"\"Returns all stored conversion records.\"\"\"\n        return list(self._storage)\n\n    def _persist(self, record: ConversionRecord) -> None:\n        \"\"\"Appends a conversion record to the configured JSON file.\"\"\"\n        try:\n            if self._save_path.parent:\n                self._save_path.parent.mkdir(parents=True, exist_ok=True)\n            with open(self._save_path, \"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(record.__dict__) + \"\\n\")\n        except OSError as e:\n            raise PersistenceError(f\"Failed to persist record to {self._save_path}: {e}\") from e\nclass ConverterService:\n    \"\"\"Orchestrates input parsing, conversion, and record keeping.\"\"\"\n    def __init__(self, repo: ConversionRepository, converter: ComplexConverter):\n        self._repo = repo\n        self._converter = converter\n\n    def convert_and_record(self, value: Union[int, float, complex, str]) -> tuple[float, float]:\n        \"\"\"Converts an input value to polar coordinates and records the conversion.\"\"\"\n        z = ValidationUtils.parse_input(value)\n        polar = self._converter.convert(z)\n        rec = ConversionRecord(input_repr=str(value), r=polar.r, theta=polar.theta, ts=datetime.utcnow().isoformat(timespec='milliseconds') + \"Z\")\n        self._repo.add(rec)\n        return polar.to_tuple()\n_default_service = ConverterService(ConversionRepository(), ComplexConverter())\ndef convert(value: Union[int, float, complex, str]) -> tuple[float, float]:\n    \"\"\"\n    Converts a numeric-like value (int, float, complex, or string) to polar coordinates.\n    Returns a tuple (radius, angle in radians).\n    \"\"\"\n    return _default_service.convert_and_record(value)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"\n    Returns a tuple with the second number and then the first number.\n    \"\"\"\n    return (b, a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence in the given string.\n    The computation is case-insensitive by default.\n    \"\"\"\n    text = s.lower()\n    n = len(text)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence\n    # of the substring text[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All individual characters are palindromic subsequences of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of increasing length\n    for length in range(2, n + 1):\n        for i in range(0, n - length + 1):\n            j = i + length - 1  # End index of the current substring\n\n            if text[i] == text[j]:\n                # If characters at the ends match, they contribute 2 to the LPS length,\n                # plus the LPS length of the inner substring text[i+1...j-1].\n                # If i+1 > j-1 (i.e., substring is of length 2), the inner part is empty, contributing 0.\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if i + 1 <= j - 1 else 0)\n            else:\n                # If characters at the ends do not match, the LPS length is the maximum of:\n                # 1. LPS of text[i+1...j] (excluding text[i])\n                # 2. LPS of text[i...j-1] (excluding text[j])\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result for the entire string is stored in dp[0][n-1]\n    return dp[0][n - 1]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["xZQOogNh"]]}], "Mbpp/240": [{"task_id": "Mbpp/240", "solution": "def replace_list(a, b):\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n    Returns a new list with the modified elements.\n    \"\"\"\n    return a[:-1] + b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/96": [{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    The function uses prime factorization, caching results for performance.\n    \"\"\"\n    import os\n    import json\n    import logging\n\n    # Configure a minimal logger for internal errors (e.g., cache IO)\n    logger = logging.getLogger(__name__)\n    if not logger.handlers:\n        logger.addHandler(logging.NullHandler())\n\n    class NumberModel:\n        \"\"\"Represents and validates the input integer.\"\"\"\n        def __init__(self, value: int) -> None:\n            self._value = int(value)\n\n        def validate(self) -> None:\n            \"\"\"Validates that the number is not zero.\"\"\"\n            if self._value == 0:\n                raise ValueError(\"zero is not supported as input\")\n        \n        def to_int(self) -> int:\n            \"\"\"Returns the absolute value of the number.\"\"\"\n            return abs(self._value)\n\n    class PrimeUtils:\n        \"\"\"Utility class for prime factorization.\"\"\"\n        MAX_TRIAL_DIVISOR = 1_000_000\n\n        def __init__(self) -> None:\n            pass\n\n        def factorize(self, n: int) -> dict[int, int]:\n            \"\"\"\n            Computes the prime factorization of a number, returning a dictionary of prime factors and their exponents.\n            Handles numbers greater than 1.\n            \"\"\"\n            n = abs(n)\n            factors: dict[int, int] = {}\n            if n == 1:\n                return {} # 1 has no prime factors in this context\n\n            # Handle factor 2\n            while n % 2 == 0:\n                factors[2] = factors.get(2, 0) + 1\n                n //= 2\n\n            # Handle odd factors\n            f = 3\n            while f * f <= n:\n                while n % f == 0:\n                    factors[f] = factors.get(f, 0) + 1\n                    n //= f\n                f += 2\n\n            # If n is still greater than 1, it must be a prime factor itself\n            if n > 1:\n                factors[n] = factors.get(n, 0) + 1\n            return factors\n\n        def is_prime(self, n: int) -> bool:\n            \"\"\"Checks if a number is prime using trial division.\"\"\"\n            if n <= 1: return False\n            if n <= 3: return True\n            if n % 2 == 0 or n % 3 == 0: return False\n            i = 5\n            while i * i <= n:\n                if n % i == 0 or n % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n\n    class CacheRepository:\n        \"\"\"Manages persistent caching of divisor counts in a JSON file.\"\"\"\n        DEFAULT_CACHE_FILE = \"~/.divcount/cache.json\"\n\n        def __init__(self, path: str) -> None:\n            self.path = os.path.expanduser(path)\n            self._data: dict[str, int] | None = None\n            self._cache_dir = os.path.dirname(self.path)\n\n        def get(self, n: int) -> int | None:\n            \"\"\"Retrieves the divisor count for a number from the cache.\"\"\"\n            data = self._load()\n            return data.get(str(n))\n\n        def set(self, n: int, count: int) -> None:\n            \"\"\"Stores the divisor count for a number in the cache.\"\"\"\n            data = self._load()\n            data[str(n)] = count\n            self._save(data)\n\n        def _load(self) -> dict[str, int]:\n            \"\"\"Loads cache data from the JSON file into memory.\"\"\"\n            if self._data is not None:\n                return self._data\n            \n            if not os.path.exists(self._cache_dir):\n                os.makedirs(self._cache_dir, exist_ok=True)\n\n            if not os.path.exists(self.path):\n                self._data = {}\n                return self._data\n\n            try:\n                with open(self.path, 'r', encoding='utf-8') as f:\n                    self._data = {k: int(v) for k, v in json.load(f).items()}\n            except (IOError, json.JSONDecodeError) as e:\n                logger.warning(f\"Failed to load cache from '{self.path}'. Starting with empty cache. Error: {e}\")\n                self._data = {} # Initialize with empty cache on error\n            return self._data\n\n        def _save(self, data: dict[str, int]) -> None:\n            \"\"\"Saves in-memory cache data to the JSON file atomically.\"\"\"\n            if not os.path.exists(self._cache_dir):\n                os.makedirs(self._cache_dir, exist_ok=True)\n\n            temp_path = self.path + \".tmp\"\n            try:\n                with open(temp_path, 'w', encoding='utf-8') as f:\n                    json.dump(data, f)\n                os.replace(temp_path, self.path) # Atomic replacement\n            except IOError as e:\n                logger.error(f\"Failed to save cache to '{self.path}'. Cache will not be persistent. Error: {e}\")\n            except Exception as e:\n                logger.error(f\"An unexpected error occurred while saving cache: {e}\")\n\n\n    class DivisorService:\n        \"\"\"Orchestrates divisor count calculation, using caching and prime factorization.\"\"\"\n        def __init__(self, cache_repo: CacheRepository, utils: PrimeUtils) -> None:\n            self.cache_repo = cache_repo\n            self.utils = utils\n\n        def count_divisors(self, n: int) -> int:\n            \"\"\"\n            Returns the number of positive divisors for the absolute value of n.\n            Raises ValueError if n is zero or not an integer.\n            \"\"\"\n            model = NumberModel(n)\n            model.validate()\n            n_abs = model.to_int()\n\n            cached = self.cache_repo.get(n_abs)\n            if cached is not None:\n                return cached\n\n            factors = self.utils.factorize(n_abs)\n            count = self._compute_from_factors(factors)\n\n            try:\n                self.cache_repo.set(n_abs, count)\n            except Exception:\n                logger.exception(\"Failed to write to cache, continuing without persistent storage.\")\n            \n            return count\n\n        def _compute_from_factors(self, factors: dict[int, int]) -> int:\n            \"\"\"Computes the total number of divisors from a prime factorization map.\"\"\"\n            