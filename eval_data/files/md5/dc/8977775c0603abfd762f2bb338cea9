n        def _is_int_list(self, lst_param: List[Any]) -> bool:\n            return all(isinstance(x, int) and not isinstance(x, bool) for x in lst_param)\n\n    _checker = EvenPositionChecker()\n    _validator = ListValidator()\n\n    vr = _validator.validate(lst)\n    if not vr.valid:\n        raise InvalidInputError(vr.message or \"Invalid input\", {\"data\": lst})\n    return _checker.check(vr.data)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[2, 1, 4, 2, 6, 1, 8, 2, 10, 1, 12]]]}], "Mbpp/792": [{"task_id": "Mbpp/792", "solution": "import collections.abc\ndef count_list(lists: collections.abc.Sequence) -> int:\n    \"\"\"\n    Counts the number of immediate sub-lists within the given sequence.\n    Only counts items that are exact instances of Python's built-in list type.\n    \"\"\"\n    count = 0\n    for item in lists:\n        if isinstance(item, list):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/791": [{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple, recursive: bool = False) -> tuple:\n    \"\"\"Removes tuple elements from the given tuple. Optionally removes them recursively from nested structures.\"\"\"\n\n    def _remove_top_level_inline(value: tuple) -> tuple:\n        \"\"\"Removes only top-level elements that are tuples.\"\"\"\n        return tuple(item for item in value if not isinstance(item, tuple))\n\n    def _remove_recursive_inline(value):\n        \"\"\"Recursively inspects structures, removing tuple elements at each level.\"\"\"\n        if isinstance(value, tuple):\n            # Recursively process elements first, then filter out tuples at this level.\n            processed_elements = (_remove_recursive_inline(item) for item in value)\n            return tuple(item for item in processed_elements if not isinstance(item, tuple))\n        elif isinstance(value, list):\n            # Recurse into lists, processing each element.\n            return [_remove_recursive_inline(item) for item in value]\n        elif isinstance(value, dict):\n            # Recurse into dictionaries, processing both keys and values.\n            return {\n                _remove_recursive_inline(k): _remove_recursive_inline(v)\n                for k, v in value.items()\n            }\n        else:\n            # Return non-collection types as is.\n            return value\n\n    if recursive:\n        return _remove_recursive_inline(input_tuple)\n    else:\n        return _remove_top_level_inline(input_tuple)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/793": [{"task_id": "Mbpp/793", "solution": "from typing import List, TypeVar, Optional\nT = TypeVar(\"T\")\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass BinarySearchUtil:\n    \"\"\"Provides utility method for finding the last occurrence of an element.\"\"\"\n    @staticmethod\n    def search_last(arr: List[T], value: T) -> int:\n        if arr is None:\n            raise InvalidInputError(\"Input array cannot be None.\")\n\n        lo, hi = 0, len(arr) - 1\n        result = -1\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            if arr[mid] == value:\n                result = mid\n                lo = mid + 1\n            elif arr[mid] < value:\n                lo = mid + 1\n            else: # arr[mid] > value\n                hi = mid - 1\n        return result\nclass ArrayRepository:\n    \"\"\"Handles validation and access to the input array.\"\"\"\n    def get_array(self, arr: Optional[List[T]] = None) -> List[T]:\n        if arr is None:\n            raise InvalidInputError(\"Input array cannot be None.\")\n        if not isinstance(arr, list):\n            raise InvalidInputError(\"Input arr must be a list.\")\n        return arr\nclass LastPositionService:\n    \"\"\"Encapsulates the business logic for finding the last position.\"\"\"\n    def __init__(self, repo: ArrayRepository, util: BinarySearchUtil):\n        self._repo = repo\n        self._util = util\n\n    def find_last(self, arr: List[T], value: T) -> int:\n        validated_arr = self._repo.get_array(arr)\n        return self._util.search_last(validated_arr, value)\nclass LastController:\n    \"\"\"Exposes the public API for finding the last position.\"\"\"\n    def __init__(self, service: LastPositionService = None):\n        if service is None:\n            repo = ArrayRepository()\n            util = BinarySearchUtil()\n            service = LastPositionService(repo, util)\n        self._service = service\n\n    def last(self, arr: List[T], value: T) -> int:\n        return self._service.find_last(arr, value)\n_controller = LastController()\ndef last(arr, value) -> int:\n    \"\"\"Finds the last position of an element in a sorted array using binary search.\"\"\"\n    return _controller.last(arr, value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/794": [{"task_id": "Mbpp/794", "solution": "import re\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', contains any characters, and ends with 'b'.\n    The pattern 'a' followed by anything, ending in 'b' is matched using regex.\n    \"\"\"\n    pattern = r\"^a.*b$\"\n    return bool(re.match(pattern, text))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["xaabbyz1323ababb"]]}], "Mbpp/796": [{"task_id": "Mbpp/796", "solution": "def return_sum(data: dict) -> float:\n    \"\"\"Calculates the sum of all values in the given dictionary.\"\"\"\n    return sum(data.values())", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/797": [{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Assumes l and r are valid integers >= 1 and l <= r, as per design context.\n    \"\"\"\n    # Determine the first odd number in the range\n    first = l\n    if first % 2 == 0:\n        first += 1\n    \n    # If the first potential odd number is outside the range, no odd numbers exist.\n    if first > r:\n        return 0\n\n    # Determine the last odd number in the range\n    last = r\n    if last % 2 == 0:\n        last -= 1\n    \n    # If the last potential odd number is before the first, no odd numbers exist.\n    if last < first:\n        return 0\n\n    # Calculate sum using arithmetic progression: n * (first + last) / 2\n    # The step for odd numbers is 2.\n    n = (last - first) // 2 + 1\n    total_sum = n * (first + last) // 2\n    \n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/798": [{"task_id": "Mbpp/798", "solution": "from typing import Any, Optional, Union, Iterable, List\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str, index: Optional[int] = None, value: Any = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n        self.value = value\nclass ValidationError(InvalidInputError):\n    \"\"\"Specific exception for validation failures.\"\"\"\n    pass\nNumber = Union[int, float]\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n    try:\n        iter(obj)\n        return not isinstance(obj, (str, bytes))\n    except TypeError:\n        return False\ndef coerce_number(value: Any) -> Number:\n    \"\"\"Attempts to convert a value to an integer or float.\"\"\"\n    if isinstance(value, (int, float)):\n        return value\n    s = str(value).strip()\n    if s == '':\n        raise InvalidInputError(\"Empty string cannot be coerced to a number\")\n    try:\n        if '.' in s or 'e' in s.lower():\n            return float(s)\n        return int(s)\n    except ValueError:\n        raise InvalidInputError(f\"Value '{value}' cannot be coerced to a number\")\nclass Validator:\n    \"\"\"Validates and normalizes input arrays into numeric lists.\"\"\"\n    def validate_items(self, items: Iterable[Any]) -> List[Number]:\n        \"\"\"Ensures items is an iterable and all elements are numeric.\"\"\"\n        if items is None or not is_iterable(items):\n            raise ValidationError(\"Items must be an iterable\", value=items)\n        \n        result: List[Number] = []\n        for i, v in enumerate(items):\n            try:\n                n = coerce_number(v)\n            except InvalidInputError as e:\n                raise ValidationError(f\"Invalid element at index {i}: {e.message}\", index=i, value=v) from e\n            except Exception as e:\n                raise ValidationError(f\"Unexpected error processing element at index {i} ('{v}')\", index=i, value=v) from e\n            result.append(n)\n        return result\nclass SumRepository:\n    \"\"\"Placeholder for saving results, does nothing by default.\"\"\"\n    def save_result(self, result: Number) -> None:\n        pass\nclass SumService:\n    \"\"\"Provides core business logic for summation.\"\"\"\n    def __init__(self, validator: Validator, repository: Optional[SumRepository] = None) -> None:\n        self.validator = validator\n        self.repository = repository\n\n    def compute_sum(self, items: Iterable[Any]) -> Number:\n        \"\"\"Validates items and calculates their sum, handling mixed types.\"\"\"\n        nums = self.validator.validate_items(items)\n        \n        int_acc = 0\n        float_acc = 0.0\n        has_float = False\n        \n        for n in nums:\n            if isinstance(n, int):\n                int_acc += n\n            else: # Must be a float after validation\n                has_float = True\n                float_acc += n\n        \n        result: Number = (int_acc + float_acc) if has_float else int_acc\n        \n        if self.repository:\n            try:\n                self.repository.save_result(result)\n            except Exception:\n                pass \n        return result\ndef _sum(items: Iterable[Any]) -> Number:\n    \"\"\"Calculates the sum of numeric items in an array.\"\"\"\n    validator = Validator()\n    service = SumService(validator)\n    return service.compute_sum(items)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/799": [{"task_id": "Mbpp/799", "solution": "def left_rotate(n, d):\n    \"\"\"\n    Performs a 32-bit left bit rotation on the given number.\n    The rotation amount `d` is normalized to the 32-bit width.\n    \"\"\"\n    BIT_WIDTH = 32\n    MASK = (1 << BIT_WIDTH) - 1\n\n    # Normalize the shift amount\n    d = d % BIT_WIDTH\n\n    # If shift is 0, no rotation is needed, just mask the value\n    if d == 0:\n        return n & MASK\n\n    # Perform the left rotation\n    # Shift left, OR with bits shifted from the right (wrap-around), then mask to 32 bits\n    return ((n << d) | (n >> (BIT_WIDTH - d))) & MASK", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/800": [{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(text):\n    \"\"\"Removes all whitespace characters from the input string.\"\"\"\n    return ''.join(ch for ch in text if not ch.isspace())", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["python\nprogram"]]}], "Mbpp/804": [{"task_id": "Mbpp/804", "solution": "from typing import Sequence\ndef is_product_even(numbers: Sequence[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    An empty list's produc