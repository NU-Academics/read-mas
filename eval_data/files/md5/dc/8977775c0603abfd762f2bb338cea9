d returns them as a list of floats.\n        Raises InvalidInputError if any element is non-numeric.\n        \"\"\"\n        result = []\n        for i, v in enumerate(arr_input):\n            if isinstance(v, (int, float)):\n                result.append(float(v))\n            else:\n                raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n        return result\n\n    def _tokuda_gaps(n: int) -> list:\n        \"\"\"\n        Generates Tokuda's gap sequence for an array of size n, in descending order.\n        The sequence is derived from h_k = floor((9*4^k - 4)/5), ensuring gaps are < n.\n        \"\"\"\n        gaps = []\n        k = 0  # Start k from 0 to get initial gap of 1\n        while True:\n            # Tokuda's formula: h_k = floor((9 * 4^k - 4) / 5)\n            gap = int((9 * (4**k) - 4) / 5)\n            if gap >= n:  # Gaps must be strictly less than n\n                break\n            gaps.append(gap)\n            k += 1\n        \n        # The generated gaps are in ascending order and already filtered for values < n.\n        gaps.sort(reverse=True)  # Sort in descending order as required by the algorithm\n        return gaps\n\n    def _shell_sort_inplace(arr: list, gaps: list) -> None:\n        \"\"\"\n        Performs in-place Shell Sort on the given list using the specified gap sequence.\n        This function modifies the list directly.\n        \"\"\"\n        n = len(arr)\n        for gap in gaps:\n            # Perform gapped insertion sort for the current gap size\n            for i in range(gap, n):\n                temp = arr[i]\n                j = i\n                # Shift elements greater than temp to the right in this gapped sub-array\n                while j >= gap and arr[j - gap] > temp:\n                    arr[j] = arr[j - gap]\n                    j -= gap\n                arr[j] = temp\n\n    # Handle empty input list immediately as per assertion context\n    if not array:\n        return []\n\n    # Validate and create a mutable copy of the input array to sort\n    arr_to_sort = _validate_array(list(array))\n\n    # Generate the Tokuda gap sequence based on the array's length\n    gaps_sequence = _tokuda_gaps(len(arr_to_sort))\n    \n    # Perform the in-place Shell sort on the copied array\n    _shell_sort_inplace(arr_to_sort, gaps_sequence)\n\n    return arr_to_sort", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/432": [{"task_id": "Mbpp/432", "solution": "def median_trapezium(base1, base2, extra):\n    \"\"\"\n    Calculates the median length of a trapezium given its two parallel bases.\n    The third parameter 'extra' is ignored for compatibility.\n    \"\"\"\n    return (base1 + base2) / 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/430": [{"task_id": "Mbpp/430", "solution": "def parabola_directrix(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the directrix y-coordinate for a vertical parabola y = a*x^2 + b*x + c.\n    The directrix is found using the vertex (h,k) and focal length p: y = k - p.\n    \"\"\"\n    h = -b / (2 * a)\n    k = c - (b**2) / (4 * a)\n    p = 1 / (4 * a)\n    directrix_y = k - p\n    return directrix_y", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[5, 3, 2]], "plus_fail_tests": [[0, 0, 0]]}], "Mbpp/435": [{"task_id": "Mbpp/435", "solution": "def last_Digit(num):\n    \"\"\"\n    Finds the last digit of a given number.\n    Handles integers, floats (truncating toward zero), and numeric strings.\n    \"\"\"\n    return abs(int(num)) % 10", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/436": [{"task_id": "Mbpp/436", "solution": "def neg_nos(lst):\n    \"\"\"\n    Returns a new list containing only the negative numbers from the input list.\n    Preserves the original order of the negative numbers in the result.\n    \