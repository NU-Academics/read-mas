  elif length:\n            length = lps[length - 1]\n        else:\n            lps[i] = 0\n            i += 1\n    return lps\ndef kmp_search(haystack: Sequence[T], needle: Sequence[T]) -> bool:\n    \"\"\"Implements the Knuth-Morris-Pratt (KMP) algorithm to find a contiguous sublist.\"\"\"\n    if not needle:\n        return True\n    if len(needle) > len(haystack):\n        return False\n    \n    lps = build_lps(needle)\n    i = j = 0  # i for haystack, j for needle\n    while i < len(haystack):\n        if haystack[i] == needle[j]:\n            i += 1\n            j += 1\n            if j == len(needle):\n                return True\n        else:\n            if j:\n                j = lps[j - 1]\n            else:\n                i += 1\n    return False\ndef naive_search(haystack: Sequence[T], needle: Sequence[T]) -> bool:\n    \"\"\"Implements a naive search to find a contiguous sublist.\"\"\"\n    if not needle:\n        return True\n    if len(needle) > len(haystack):\n        return False\n    \n    n = len(haystack)\n    m = len(needle)\n    for i in range(n - m + 1):\n        if haystack[i:i+m] == needle:\n            return True\n    return False\ndef is_sublist(main_list: Sequence[Any], sub_list: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if a list contains the given sublist as a contiguous subsequence.\n    Uses KMP algorithm for efficiency, falling back to naive search for small inputs.\n    \"\"\"\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n\n    if len(sub_list) <= SMALL_INPUT_THRESHOLD:\n        return naive_search(main_list, sub_list)\n    else:\n        return kmp_search(main_list, sub_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/71": [{"task_id": "Mbpp/71", "solution": "from typing import List, Callable, Optional, TypeVar, Sequence\nT = TypeVar(\"T\")\ndef comb_sort(elements: Sequence[T], compare: Optional[Callable[[T, T], int]] = None) -> List[T]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    It returns a new sorted list, not modifying the original.\n    \"\"\"\n    # Constants for the Comb Sort algorithm, derived from design context.\n    SHRINK_FACTOR: float = 1.3\n    MIN_GAP: int = 1\n\n    def _next_gap(current_gap: int) -> int:\n        \"\"\"Calculates the next gap size for the comb sort algorithm.\"\"\"\n        new_gap = int(current_gap / SHRINK_FACTOR)\n        return max(MIN_GAP, new_gap)\n\n    def _default_compare(a: T, b: T) -> int:\n        \"\"\"Default comparison function using Python's rich comparison operators.\"\"\"\n        if a < b:\n            return -1\n        if a > b:\n            return 1\n        return 0\n\n    # Use the provided comparator or the default one.\n    current_compare = compare if compare is not None else _default_compare\n\n    # Create a mutable copy of the input elements as the algorithm modifies it in-place.\n    arr = list(elements)\n    n = len(arr)\n\n    gap = n\n    swapped = True\n\n    # Main comb sort loop\n    while gap > MIN_GAP or swapped:\n        gap = _next_gap(gap)\n        swapped = False\n\n        for i in range(n - gap):\n            if current_compare(arr[i], arr[i + gap]) > 0:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    \n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/72": [{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"\n    Checks if the given number can be represented as the difference of two squares.\n    A number n can be represented as a^2 - b^2 if and only if n is odd or divisible by 4.\n    \"\"\"\n    return (n % 4) != 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/85": [{"task_id": "Mbpp/85", "solution": "import math\nclass _SphereModel:\n    \"\"\"Represents a sphere