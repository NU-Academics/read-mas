able\nfrom decimal import Decimal\ndef min_val(items: list, parse_numeric_strings: bool = False) -> Union[int, float, Decimal]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    This function processes the list, optionally parsing numeric strings,\n    and returns the smallest numeric value found, handling various numeric types.\n    \"\"\"\n    class MinFinderError(Exception):\n        \"\"\"Base exception for minfinder module.\"\"\"\n        pass\n\n    class InvalidInputError(MinFinderError):\n        \"\"\"Raised when input is invalid (e.g., non-iterable).\"\"\"\n        pass\n\n    class NoNumericValueError(MinFinderError):\n        \"\"\"Raised when no numeric values are found in the input.\"\"\"\n        pass\n\n    class ParseError(MinFinderError):\n        \"\"\"Raised when a numeric string cannot be parsed.\"\"\"\n        pass\n\n    def _is_numeric(obj: Any) -> bool:\n        \"\"\"Checks if an object is an instance of a supported numeric type.\"\"\"\n        return isinstance(obj, (int, float, Decimal))\n\n    def _parse_numeric_string(s: str) -> Union[int, float, Decimal]:\n        \"\"\"Attempts to parse a string into an int, Decimal, or float.\"\"\"\n        try:\n            return int(s)\n        except ValueError:\n            pass\n        try:\n            return Decimal(s) # Prefer Decimal for precision.\n        except ValueError:\n            pass\n        try:\n            return float(s)\n        except ValueError as e:\n            raise ParseError(f\"Could not parse '{s}' as a numeric string.\") from e\n\n    def _normalize_numeric(value: Any) -> Union[int, float, Decimal, None]:\n        \"\"\"Normalizes a value to a numeric type or returns None if not numeric.\"\"\"\n        if _is_numeric(value):\n            return value\n        if isinstance(value, str) and parse_numeric_strings:\n            try:\n                return _parse_numeric_string(value)\n            except ParseError:\n                #