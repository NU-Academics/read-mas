 "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "from typing import List\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # inc[i] stores the maximum sum of an increasing subsequence ending at arr[i]\n    inc = [0] * n\n    # dec[i] stores the maximum sum of a decreasing subsequence starting at arr[i]\n    dec = [0] * n\n\n    # Calculate maximum sum of increasing subsequences ending at each position\n    for i in range(n):\n        inc[i] = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                inc[i] = max(inc[i], inc[j] + arr[i])\n\n    # Calculate maximum sum of decreasing subsequences starting at each position\n    for i in range(n - 1, -1, -1):\n        dec[i] = arr[i]\n        for j in range(n - 1, i, -1): # j iterates from right to i+1\n            if arr[j] < arr[i]:\n                dec[i] = max(dec[i], dec[j] + arr[i])\n\n    # The maximum sum bitonic subsequence is max(inc[i] + dec[i] - arr[i])\n    # arr[i] is subtracted because it's counted in both increasing and decreasing parts.\n    max_bitonic_sum = 0\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, inc[i] + dec[i] - arr[i])\n\n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "def insert_element(lst, elem):\n    \"\"\"\n    Inserts an element before each element in a list, returning a new list.\n    Handles an empty input list by returning an empty list.\n    \"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n\n    result = [None] * (2 * n)\n    for i, item in enumerate(lst):\n        result[2 * i] = elem\n 