    \"\"\"Checks if the bit at the given index is set in num.\"\"\"\n        return ((num >> index) & 1) == 1\n\n    def _set_bit(num: int, index: int) -> int:\n        \"\"\"Sets the bit at the given index in num.\"\"\"\n        return num | (1 << index)\n\n    if n == 0:\n        # For n=0, the left-most unset bit is at index 0, result is 1.\n        msb_index = 0\n    else:\n        # Find the index of the most significant set bit (0-based).\n        msb_index = n.bit_length() - 1\n\n    # Find the highest bit position (from msb_index down to 0) where the bit is unset.\n    target_index = -1\n    for i in range(msb_index, -1, -1):\n        if not _is_bit_set(n, i):\n            target_index = i\n            break\n\n    if target_index != -1:\n        # If an unset bit is found, set it.\n        return _set_bit(n, target_index)\n    else:\n        # If all bits from 0 to msb_index are set, set the bit at msb_index + 1.\n        return _set_bit(n, msb_index + 1)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[15]], "plus_fail_tests": [[255]]}], "Mbpp/388": [{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is less than or equal to 0.\"\"\"\n    if n <= 0:\n        return 0\n    # For positive n, calculate 2 raised to the power of (n's most significant bit position).\n    # n.bit_length() gives the number of bits required to represent n, which is equivalent to\n    # (index of MSB + 1). So, (n.bit_length() - 1) gives the index of the MSB.\n    return 1 << (n.bit_length() - 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/312": [{"task_id": "Mbpp/312", "solution": "import math\nimport typing\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Compute and return the volume of a cone. Delegates to internal service.\n    \"\"\"\n    # This implementation 