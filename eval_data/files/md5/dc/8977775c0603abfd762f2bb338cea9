rovides methods for normalizing pair tuples to a canonical form.\"\"\"\n    def normalize(self, pair: Tuple[int, int]) -> Tuple[int, int]:\n        \"\"\"Returns a canonical tuple with elements in non-decreasing order.\"\"\"\n        a, b = pair\n        return (a, b) if a <= b else (b, a)\nclass OccurrenceRepository:\n    \"\"\"In-memory repository for storing and managing pair counts.\"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[Tuple[int, int], int] = collections.defaultdict(int)\n\n    def add(self, pair: Tuple[int, int], count: int = 1) -> None:\n        \"\"\"Increments the count for a given canonical pair.\"\"\"\n        self._counts[pair] += count\n\n    def get_all(self) -> Dict[Tuple[int, int], int]:\n        \"\"\"Returns a shallow copy of the current counts.\"\"\"\n        return dict(self._counts)\n\n    def clear(self) -> None:\n        \"\"\"Clears all stored counts.\"\"\"\n        self._counts.clear()\nclass OccurrenceService:\n    \"\"\"Business logic for counting occurrences of normalized pairs.\"\"\"\n    def __init__(self, repository: OccurrenceRepository, normalizer: Normalizer) -> None:\n        self.repository = repository\n        self.normalizer = normalizer\n\n    def count_occurrences(self, pairs: List[Tuple[int, int]]) -> Dict[Tuple[int, int], int]:\n        \"\"\"\n        Counts occurrences of normalized pairs in the given list,\n        validating each pair and storing results in the repository.\n        \"\"\"\n        self.repository.clear()\n        for idx, raw_pair in enumerate(pairs):\n            validate_pair(raw_pair, idx)\n            canonical_pair = self.normalizer.normalize(raw_pair)\n            self.repository.add(canonical_pair)\n        return self.repository.get_all()\ndef check_occurences(pairs: List[Tuple[int, int]]) -> Dict[Tuple[int, int], int]:\n    \"\"\"\n    Counts occurrences of 2-element integer tuples, normalizing them\n    to a canonical (min, max) form, and returns the counts.\n    \