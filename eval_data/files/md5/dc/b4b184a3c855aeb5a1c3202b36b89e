d side (hypotenuse) of a right-angled triangle given two legs,\n    using an internal Triangle class for calculation as per design.\n    \"\"\"\n    import math\n\n    class Triangle:\n        \"\"\"A simple domain entity to encapsulate triangle sides and calculation.\"\"\"\n        def __init__(self, sideA: float, sideB: float):\n            self.sideA = sideA\n            self.sideB = sideB\n\n        def calculateThirdSide(self) -> float:\n            \"\"\"Calculates the hypotenuse using the Pythagorean theorem.\"\"\"\n            return math.sqrt(self.sideA**2 + self.sideB**2)\n\n    triangle_instance = Triangle(sideA, sideB)\n    return triangle_instance.calculateThirdSide()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/296": [{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"\n    Counts the number of inversions in an array using a modified merge sort algorithm.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # Create a mutable copy of the array as merge sort typically modifies the array in-place.\n    temp_arr = list(arr) \n\n    def _merge_and_count_subarrays(current_arr, l, m, r):\n        \"\"\"\n        Merges two sorted subarrays current_arr[l...m] and current_arr[m+1...r] while counting\n        the inversions between elements from these two segments.\n        \"\"\"\n        temp = []\n        i = l  # Pointer for the left subarray current_arr[l...m]\n        j = m + 1  # Pointer for the right subarray current_arr[m+1...r]\n        inv_count = 0\n\n        while i <= m and j <= r:\n            if current_arr[i] <= current_arr[j]:\n                temp.append(current_arr[i])\n                i += 1\n            else:\n                temp.append(current_arr[j])\n                j += 1\n                # When an element from the right subarray is picked, it implies it's smaller than\n                # all remaining elements in the left subarray, forming inversions.\n                inv_count += (m - i + 1)\n\n        while i <= m:\n            temp.append(current_arr[i])\n            i += 1\n        \n        while j <= r:\n            temp.append(current_arr[j])\n            j += 1\n\n        for k in range(len(temp)):\n            current_arr[l + k] = temp[k]\n        \n        return inv_count\n\n    def _merge_sort_and_count(current_arr, l, r):\n        \"\"\"\n        Recursively sorts the array segment current_arr[l...r] and aggregates inversion counts.\n        \"\"\"\n        inv_count = 0\n        if l < r:\n            m = (l + r) // 2\n            inv_count += _merge_sort_and_count(current_arr, l, m)\n            inv_count += _merge_sort_and_count(current_arr, m + 1, r)\n            inv_count += _merge_and_count_subarrays(current_arr, l, m, r)\n        return inv_count\n\n    return _merge_sort_and_count(temp_arr, 0, n - 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\ndef max_aggregate(input_list):\n    \"\"\"Calculates the sum of scores for each name and returns the name with the highest aggregate score.\n    It aggregates scores from a list of (name, score) tuples.\"\"\"\n    aggregates = defaultdict(int)\n\n    for name, score in input_list:\n        aggregates[name] += score\n\n    # Find the name with the maximum aggregate score.\n    # This will raise a ValueError if aggregates is empty (e.g., if input_list was empty).\n    return max(aggregates.items(), key=lambda item: item[1])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/305": [{"task_id": "Mbpp/305", "solution": "def start_withp(words: list[str]) -> tuple[str, ...]:\n    \"\"\"\n    Extracts up to two words starting with 'p' (case-insensitive) from a list of strings.\n    Returns a 