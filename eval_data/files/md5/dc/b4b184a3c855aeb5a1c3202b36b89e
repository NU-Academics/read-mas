tom-right\n    cell in a square matrix, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n\n    class Cell:\n        \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n        def __init__(self, r, c, cost):\n            self.row = r\n            self.col = c\n            self.cost = cost\n\n    class Matrix:\n        \"\"\"Encapsulates the matrix data, providing access to individual cells.\"\"\"\n        def __init__(self, raw_matrix_list):\n            self.size = len(raw_matrix_list)\n            self.cells = []\n            for r in range(self.size):\n                row_cells = []\n                for c in range(self.size):\n                    row_cells.append(Cell(r, c, raw_matrix_list[r][c]))\n                self.cells.append(row_cells)\n\n        def get_cell(self, r, c):\n            return self.cells[r][c]\n\n    class Path:\n        \"\"\"Represents a sequence of cells forming a path, with methods for cost and average.\"\"\"\n        def __init__(self, cells_list):\n            self.cells = cells_list\n            self.total_cost = sum(c.cost for c in cells_list)\n            self.length = len(cells_list)\n\n        def average(self):\n            return self.total_cost / self.length if self.length > 0 else 0.0\n\n    class PathCalculator:\n        \"\"\"Calculates the path with the maximum total cost using dynamic programming.\"\"\"\n        def __init__(self, matrix_obj):\n            self.matrix = matrix_obj\n            self.N = matrix_obj.size\n\n        def find_max_average_path(self):\n            N = self.N\n            if N == 0:\n                return Path([])\n\n            # dp_sum[r][c] stores the maximum total cost to reach cell (r,c)\n            dp_sum = [[0] * N for _ in range(N)]\n\n            # Initialize base case (top-left cell)\n            dp_sum[0][0] = self.matrix.get_cell(0, 0).cost\n\n            # Initialize first row (can only move right)\n            for c in range(1, N):\n                dp_sum[0][c] = self.matrix.get_cell(0, c).cost + dp_sum[0][c - 1]\n\n            # Initialize first column (can only move down)\n            for r in range(1, N):\n                dp_sum[r][0] = self.matrix.get_cell(r, 0).cost + dp_sum[r - 1][0]\n\n            # Fill the rest of the DP table\n            for r in range(1, N):\n                for c in range(1, N):\n                    current_cell_cost = self.matrix.get_cell(r, c).cost\n                    dp_sum[r][c] = current_cell_cost + max(dp_sum[r - 1][c], dp_sum[r][c - 1])\n\n            # Reconstruct the path by backtracking from the bottom-right cell\n            path_cells = []\n            curr_r, curr_c = N - 1, N - 1\n\n            while True:\n                path_cells.append(self.matrix.get_cell(curr_r, curr_c))\n                if curr_r == 0 and curr_c == 0:\n                    break\n                elif curr_r == 0: # Only option is to move left\n                    curr_c -= 1\n                elif curr_c == 0: # Only option is to move up\n                    curr_r -= 1\n                else: # Choose path that yielded max sum\n                    if dp_sum[curr_r - 1][curr_c] > dp_sum[curr_r][curr_c - 1]:\n                        curr_r -= 1 # Came from above\n                    else:\n                        curr_c -= 1 # Came from left (or if equal, default to left)\n            \n            path_cells.reverse() # Path was built in reverse order\n            return Path(path_cells)\n\n    # Main logic execution\n    matrix_obj = Matrix(matrix)\n    calculator = PathCalculator(matrix_obj)\n    \n    max_path = calculator.find_max_average_path()\n    return max_path.average()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/748": [{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(text):\n    \"\"\"\n    Inserts spaces before words starting with capital letters in a given string.\n    This function processes the input string