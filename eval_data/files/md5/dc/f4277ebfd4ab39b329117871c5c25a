][0] = dp_sum[r-1][0] + float(matrix[r][0])\n\n    # Fill the rest of the dp_sum table\n    for r in range(1, N):\n        for c in range(1, N):\n            # To reach (r,c), choose the path from (r-1,c) or (r,c-1) that yields the maximum sum.\n            dp_sum[r][c] = float(matrix[r][c]) + max(dp_sum[r-1][c], dp_sum[r][c-1])\n\n    # The total number of cells in any valid path from (0,0) to (N-1, N-1) is fixed.\n    num_cells_in_path = (2 * N) - 1\n\n    # The maximum total cost for a path to the bottom-right cell (N-1, N-1)\n    max_total_cost = dp_sum[N-1][N-1]\n\n    # The maximum average is the maximum total cost divided by the number of cells in the path.\n    max_average = max_total_cost / num_cells_in_path\n\n    return max_average", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix_input):\n    \"\"\"\n    Given a square matrix, finds the path from top-left to bottom-right with the maximum average cost.\n    Movement is restricted to right or down.\n    \"\"\"\n\n    # Validator Class: Ensures the input matrix adheres to basic structural requirements.\n    class Validator:\n        def validate_matrix_input(self, matrix):\n            # Assumes matrix_input is a list of lists due to constraints; checks for non-emptiness.\n            if not matrix:\n                return False\n            return self.is_square_matrix(matrix)\n\n        def is_square_matrix(self, matrix):\n            # Verifies if the matrix has equal number of rows and columns.\n            num_rows = len(matrix)\n            if num_rows == 0:\n                return False\n            for row in matrix:\n                if len(row) != num_rows:\n                    return False\n            return True\n\n    # Cell Class: Represents an individual element in the matrix with its coordinates and cost.\n    class Cell:\n        def __init__(self, row, col, cost):\n            self._row = row\n            self._col = col\n            self._cost = cost\n\n        def get_row(self):\n            return self._row\n\n        def get_col(self):\n            return self._col\n\n        def get_cost(self):\n            return self._cost\n\n    # Matrix Class: Manages the square matrix data, providing access and validation methods.\n    class Matrix:\n        def __init__(self, cells_input):\n            self._size = len(cells_input)\n            self._cells = []\n            for r in range(self._size):\n                row_cells = []\n                for c in range(self._size):\n                    row_cells.append(Cell(r, c, cells_input[r][c]))\n                self._cells.append(row_cells)\n\n        def get_cell_cost(self, row, col):\n            # Returns the cost of the cell at the specified row and column.\n            if self.is_valid_position(row, col):\n                return self._cells[row][col].get_cost()\n            return None \n\n        def get_size(self):\n            return self._size\n\n        def is_valid_position(self, row, col):\n            # Checks if the given row and column coordinates are within matrix bounds.\n            return 0 <= row < self._size and 0 <= col < self._size\n\n    # Path Class: Represents a sequence of cells from start to end, tracking total cost and count.\n    class Path:\n        def __init__(self, cells=None, total_cost=0.0, cell_count=0):\n            # Initializes a path with an optional list of cells, accumulated cost, and cell count.\n            self._cells = list(cells) if cells is not None else []\n            self._total_cost = total_cost\n            self._cell_count = cell_count\n\n        def add_cell(self, cell):\n            # Adds a cell to the path and updates its total cost and count.\n            self._cells.append(cell)\n            self._total_cost += cell.get_cost()\n            self._cell_count += 1\n\n        def calculate_average(self):\n            # Computes the average cost of cells in the path.\n            if self._cell_count == 0:\n                return 0.0\n            return self._total_cost / self._cell_count\n\n        def get_total_cost(self):\n            return self._total_cost\n\n        def get_cell_count(self):\n            return self._cell_count\n\n        def clone(self):\n            # Creates a new Path object that is a deep copy of the current path's state.\n            return Path(list(self._cells), self._total_cost, self._cell_count)\n\n    # AverageCalculator Class: Provides methods for calculating and finding the maximum path average.\n    class AverageCalculator:\n        def calculate_path_average(self, path):\n            # Delegates the average calculation to the Path object itself.\n            return path.calculate_average()\n\n        def find_maximum_average(self, paths):\n            # Iterates through a list of paths to find the one with the highest average cost.\n            if not paths:\n                return 0.0\n            max_avg = 0.0\n            for path in paths:\n                avg = self.calculate_path_average(path)\n                if avg > max_avg:\n                    max_avg = avg\n            return max_avg\n\n    # PathFinder Class: Discovers all valid paths and coordinates finding the maximum average path.\n    class PathFinder:\n        def __init__(self, matrix):\n            self._matrix = matrix\n            self._all_paths = []\n\n        def find_max_average_path(self):\n            # Orchestrates path generation and returns the maximum average among them.\n            self.generate_all_paths()\n            return AverageCalculator().find_maximum_average(self._all_paths)\n\n        def generate_all_paths(self):\n            # Initiates a Depth-First Search (DFS) to find all possible paths.\n            start_cell = self._matrix._cells[0][0]\n            initial_path = Path()\n            initial_path.add_cell(start_cell)\n            self._dfs(0, 0, initial_path)\n\n        def _dfs(self, current_row, current_col, current_path):\n            # Recursively explores paths by moving either right or down from the current cell.\n            size = self._matrix.get_size()\n            \n            if current_row == size - 1 and current_col == size - 1:\n                self._all_paths.append(current_path)\n                return\n\n            # Explore moving Right\n            if self._matrix.is_valid_position(current_row, current_col + 1):\n                next_cell = self._matrix._cells[current_row][current_col + 1]\n                new_path = current_path.clone()\n                new_path.add_cell(next_cell)\n                self._dfs(current_row, current_col + 1, new_path)\n\n            # Explore moving Down\n            if self._matrix.is_valid_position(current_row + 1, current_col):\n                next_cell = self._matrix._cells[current_row + 1][current_col]\n                new_path = current_path.clone()\n                new_path.add_cell(next_cell)\n                self._dfs(current_row + 1, current_col, new_path)\n\n    # Main function logic starts here\n    validator = Validator()\n    # As per constraints, we assume valid input and do not raise exceptions for validation failures.\n    # The validation call ensures fidelity to the design context.\n    validator.validate_matrix_input(matrix_input) \n\n    matrix_obj = Matrix(matrix_input)\n    path_finder = PathFinder(matrix_obj)\n    max_average = path_finder.find_max_average_path()\n\n    return max_average", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[0, 0, 0], [0, 0, 0], [0, 0, -1]]]]}], "Mbpp/723": [{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts the number of indices where two lists have the same value.\n    Assumes list1 and list2 are of the same length.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n     