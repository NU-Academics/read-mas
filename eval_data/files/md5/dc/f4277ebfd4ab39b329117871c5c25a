roper_divisors(b) == a, with a != b.\n        \"\"\"\n        if a == b:\n            return False\n        return sum_of_proper_divisors(a) == b and sum_of_proper_divisors(b) == a\n\n    def find_amicable_numbers(limit: int) -> list[int]:\n        \"\"\"\n        Identifies all amicable numbers within the range from 1 to the specified limit.\n        It stores found amicable numbers in a set to ensure uniqueness.\n        \"\"\"\n        amicable_nums_found = set()\n        # Iterate through numbers from 1 up to the limit.\n        for a in range(1, limit + 1):\n            sum_div_a = sum_of_proper_divisors(a)\n            b = sum_div_a\n\n            # Check conditions for 'b' to be a potential amicable partner.\n            # 'b > a' avoids checking pairs twice and ensures a != b.\n            if b > a and b <= limit:\n                if is_amicable_pair(a, b):\n                    amicable_nums_found.add(a)\n                    amicable_nums_found.add(b)\n        # Return a sorted list of unique amicable numbers found.\n        return sorted(list(amicable_nums_found))\n\n    # The main logic: find all amicable numbers and sum them.\n    amicable_numbers_list = find_amicable_numbers(limit)\n    return sum(amicable_numbers_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/123", "solution": "def find_proper_divisors(number: int) -> list[int]:\n    \"\"\"\n    Calculates the proper divisors of a given number.\n    Proper divisors are positive divisors excluding the number itself.\n    \"\"\"\n    if number <= 1:\n        return []\n    divs = [1]\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            divs.append(i)\n            if i * i != number:\n                divs.append(number // i)\n    return sorted(divs)\ndef sum_divisors(divisors: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of a list of numbers (divisors).\n    \"\"\"\n    return sum(divisors)\