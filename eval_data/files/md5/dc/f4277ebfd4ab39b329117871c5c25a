thod\n    def is_strictly_increasing(elements: list[int]) -> bool:\n        if len(elements) <= 1:\n            return True\n        for i in range(len(elements) - 1):\n            if elements[i] >= elements[i+1]:\n                return False\n        return True\n\n    @staticmethod\n    def is_strictly_decreasing(elements: list[int]) -> bool:\n        if len(elements) <= 1:\n            return True\n        for i in range(len(elements) - 1):\n            if elements[i] <= elements[i+1]:\n                return False\n        return True\n\n    @staticmethod\n    def is_bitonic(subsequence: Subsequence) -> bool:\n        elements = subsequence.get_elements()\n        n = len(elements)\n\n        # A bitonic sequence \"first increasing and then decreasing\" must have a peak\n        # that is not the first or last element, implying at least 3 elements.\n        if n < 3:\n            return False\n\n        # Find the peak (first occurrence of the maximum element in the subsequence)\n        peak_idx = 0\n        for i in range(1, n):\n            if elements[i] > elements[peak_idx]:\n                peak_idx = i\n        \n        # For a non-degenerate bitonic sequence (as per problem description),\n        # the peak cannot be the first or the last element.\n        if peak_idx == 0 or peak_idx == n - 1:\n            return False\n\n        # Check increasing part (from start to peak, including peak)\n        if not SubsequenceValidator.is_strictly_increasing(elements[:peak_idx+1]):\n            return False\n\n        # Check decreasing part (from peak to end, including peak)\n        if not SubsequenceValidator.is_strictly_decreasing(elements[peak_idx:]):\n            return False\n        \n        return True\nclass BitonicFinder:\n    \"\"\"Identifies and filters bitonic subsequences.\"\"\"\n    def find_all_subsequences(self, array_obj: Array) -> list[Subsequence]:\n        original_data = array_obj.get_data()\n        n = array_obj.get_size()\n        all