{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance_count = 0\n    for char in brackets:\n        if char == '<':\n            balance_count += 1\n        elif char == '>':\n            balance_count -= 1\n        \n        # If balance drops below zero, a closing bracket appeared without a matching opening one\n        if balance_count < 0:\n            return False\n            \n    # For correct bracketing, the final balance must be zero\n    return balance_count == 0"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1).\")\n\n    if n == 1:\n        return 1\n    elif n == 2:\n        return 1\n    \n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a list with a single element is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] >= l[i+1]: # Check for strictly increasing\n            is_increasing = False\n        if l[i] <= l[i+1]: # Check for strictly decreasing\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            largest_factor = i\n            while n % i == 0:\n                n //= i\n        i += 1\n    if n > 1:\n        largest_factor = n\n    return largest_factor"}
