{"task_id": "HumanEval/148", "solution": "```python\nPLANET_ORDER: tuple[str, ...] = (\n    \"Mercury\",\n    \"Venus\",\n    \"Earth\",\n    \"Mars\",\n    \"Jupiter\",\n    \"Saturn\",\n    \"Uranus\",\n    \"Neptune\"\n)\n\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not valid planet names.\n    \"\"\"\n\n    # Helper to find the index of a planet, handling case-insensitivity.\n    def _find_planet_index(planet_name: str) -> int:\n        try:\n            return [p.lower() for p in PLANET_ORDER].index(planet_name.lower())\n        except ValueError:\n            return -1\n\n    idx1 = _find_planet_index(planet1)\n    idx2 = _find_planet_index(planet2)\n\n    # Return empty tuple if either planet is invalid.\n    if idx1 == -1 or idx2 == -1:\n        return ()\n\n    # Determine the correct start and end indices for slicing.\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # If planets are adjacent or the same, there are no planets strictly between them.\n    if end_idx - start_idx <= 1:\n        return ()\n\n    return tuple(PLANET_ORDER[start_idx + 1:end_idx])\n```\n"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, removing odd-length words.\n    Returns the remaining strings sorted by length then alphabetically.\n    \"\"\"\n    # Filter out strings that have odd lengths.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list first by length, then alphabetically for ties.\n    sorted_result = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_result\n```"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    is_n_prime = False\n    if n <= 1:\n        is_n_prime = False\n    elif n == 2:\n        is_n_prime = True\n    elif n % 2 == 0:\n        is_n_prime = False\n    else:\n        # Check for odd divisors from 3 up to the square root of n.\n        is_n_prime = True \n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    if is_n_prime:\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates \"n choose k\" (C(n, k)). Returns 0 if k > n or k < 0.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    \n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef _count_remainders(n: int) -> tuple[int, int]:\n    \"\"\"Counts the number of elements a[x] (for 1 <= x <= n) that have a remainder of 0 or 1 when divided by 3.\"\"\"\n    count_rem0 = 0\n    count_rem1 = 0\n    for i in range(1, n + 1):\n        val = i * i - i + 1\n        if val % 3 == 0:\n            count_rem0 += 1\n        elif val % 3 == 1:\n            count_rem1 += 1\n    return count_rem0, count_rem1\n\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n    if n < 3:\n        return 0\n\n    count_rem0, count_rem1 = _count_remainders(n)\n\n    # A sum (A + B + C) is a multiple of 3 if:\n    # 1. A%3=0, B%3=0, C%3=0\n    # 2. A%3=1, B%3=1, C%3=1\n    # (A%3=2 is not possible for a[x] = x*x - x + 1)\n\n    num_000_triples = _combinations(count_rem0, 3)\n    num_111_triples = _combinations(count_rem1, 3)\n    \n    return num_000_triples + num_111_triples\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game, guess):\n    \"\"\"\n    Compares actual game scores against user guesses, returning absolute differences.\n    If a guess is correct, the value is 0, otherwise it's the absolute numerical difference.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        diff = abs(game[i] - guess[i])\n        differences.append(diff)\n    return differences\n```"}
