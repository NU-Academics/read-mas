{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # Replace 3 or more consecutive spaces with a single hyphen first.\n    text = re.sub(r' {3,}', '-', text)\n    # Then replace 1 or 2 consecutive spaces with an underscore.\n    text = re.sub(r' {1,2}', '_', text)\n    return text\n"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces single spaces with underscores. Sequences of three or more spaces become a single hyphen.\n    Two consecutive spaces are treated as two single spaces, resulting in two underscores.\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores.\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text\n```"}
{"task_id": "HumanEval/139", "solution": "```python\nclass FactorialUtils:\n    @staticmethod\n    def simple_factorial(k: int) -> int:\n        \"\"\"Computes the standard factorial for a given non-negative integer k.\n        Raises ValueError for negative inputs and TypeError for non-integer inputs.\n        \"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"Input must be an integer.\")\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if k == 0:\n            return 1\n        \n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\nclass SpecialFactorialCalculator:\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the Brazilian factorial for a given positive integer n.\n        It multiplies factorials from 1! up to n!.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        brazilian_factorial_result = 1\n        for i in range(1, n + 1):\n            brazilian_factorial_result *= FactorialUtils.simple_factorial(i)\n        return brazilian_factorial_result\n\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    calculator = SpecialFactorialCalculator()\n    return calculator.calculate(n)\n```"}
{"task_id": "HumanEval/141", "solution": "```python\nimport string\n\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    MAX_DIGITS = 3\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension\n    parts = file_name.rsplit('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule: Prefix not empty and starts with a Latin letter\n    if not prefix or prefix[0] not in string.ascii_letters:\n        return 'No'\n\n    # Rule: Extension is one of the allowed types\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # Rule: Not more than three digits in the entire file name\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > MAX_DIGITS:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    MAX_DIGITS = 3\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # FR1: Check digit count\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > MAX_DIGITS:\n        return 'No'\n\n    # FR2: Check for exactly one dot\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    prefix = parts[0]\n    extension = parts[1]\n\n    # FR3: Check if the substring before the dot is not empty\n    if not prefix:\n        return 'No'\n\n    # FR4: Check if the substring before the dot starts with a Latin letter\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # FR5: Check if the extension is one of the allowed extensions\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'\n```"}
