{"task_id": "HumanEval/61", "solution": "```python\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of parentheses is correctly balanced and nested.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not isinstance(brackets, str):\n        raise TypeError(\"Input 'brackets' must be a string.\")\n\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # If balance drops below zero, a closing bracket appeared without a matching open one.\n        if balance < 0:\n            return False\n\n    return balance == 0\n```"}
{"task_id": "HumanEval/70", "solution": "```python\nfrom typing import List, Any\n\n# Custom exception for self-containment.\nclass InvalidInputTypeError(TypeError):\n    \"\"\"Custom exception for invalid input types to strange_sort_list.\"\"\"\n    def __init__(self, message: str = \"Input must be a list of integers.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef _validate_input(lst: Any) -> None:\n    \"\"\"Validates that the input is a list of integers.\n    Raises InvalidInputTypeError if validation fails.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise InvalidInputTypeError(\"Input must be a list.\")\n    if not all(isinstance(item, int) for item in lst):\n        raise InvalidInputTypeError(\"All elements in the list must be integers.\")\n\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers by repeatedly taking the minimum, then maximum of remaining.\n    The original list remains unchanged, and a new sorted list is returned.\n    \"\"\"\n    _validate_input(lst)\n\n    if not lst:\n        return []\n\n    # Sort the list initially to efficiently pick min (pop(0)) and max (pop()).\n    temp_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while temp_list:\n        if is_min_turn:\n            result_list.append(temp_list.pop(0)) # Appends smallest remaining element.\n        else:\n            result_list.append(temp_list.pop()) # Appends largest remaining element.\n        is_min_turn = not is_min_turn\n\n    return result_list\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in lst):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    # Create a sorted copy to efficiently pick min/max from ends.\n    working_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            # Append current minimum (first element).\n            result.append(working_list.pop(0))\n        else:\n            # Append current maximum (last element).\n            result.append(working_list.pop())\n        is_min_turn = not is_min_turn\n    return result\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given three side lengths, calculate the triangle's area or return -1 if invalid.\n    Uses Heron's formula for valid triangles and rounds the result to two decimal places.\n    \"\"\"\n    # Validate if all side lengths are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.00\n    \n    # Validate if the sides satisfy the triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.00\n\n    # Calculate the semi-perimeter for Heron's formula.\n    s = (a + b + c) / 2\n    \n    # Calculate the value under the square root in Heron's formula.\n    # Adjust for potential floating-point inaccuracies that might result in a tiny negative.\n    area_squared_term = s * (s - a) * (s - b) * (s - c)\n    if area_squared_term < 0:\n        area_squared_term = 0\n\n    # Calculate the raw area.\n    raw_area = math.sqrt(area_squared_term)\n\n    # Return the calculated area, rounded to two decimal places.\n    return round(raw_area, 2)\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q, w):\n    \"\"\"\n    Checks if a list 'q' is a palindrome and if the sum of its elements\n    is less than or equal to 'w'.\n    \"\"\"\n    if not isinstance(q, list):\n        raise TypeError(\"Input 'q' must be a list.\")\n    if not isinstance(w, int):\n        raise TypeError(\"Input 'w' must be an integer.\")\n\n    # Check if 'q' is a palindrome. An empty list or single-element list is a palindrome.\n    is_pal = (q == q[::-1])\n\n    # Calculate the sum of elements in 'q'.\n    list_sum = sum(q)\n\n    # Return True if both conditions are met, False otherwise.\n    return is_pal and (list_sum <= w)\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\nclass TriangleValidator:\n    def is_valid(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if all sides are positive and satisfy the triangle inequality theorem.\"\"\"\n        if not (self._is_positive(a) and self._is_positive(b) and self._is_positive(c)):\n            return False\n        return self._satisfies_inequality(a, b, c)\n\n    def _is_positive(self, side: float) -> bool:\n        \"\"\"Private helper to check if a single side length is strictly greater than zero.\"\"\"\n        return side > 0\n\n    def _satisfies_inequality(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Private helper to check if the sum of any two sides is greater than the third side.\"\"\"\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\nclass TriangleCalculator:\n    def calculate_herons_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"Computes the area of a triangle given its three sides and rounds the result.\"\"\"\n        s = self._calculate_semi_perimeter(a, b, c)\n        # Handle potential floating point inaccuracies that might result in a tiny negative value.\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        if area_squared < 0:\n            area_squared = 0.0\n        area = math.sqrt(area_squared)\n        return self._round_area(area)\n\n    def _calculate_semi_perimeter(self, a: float, b: float, c: float) -> float:\n        \"\"\"Private helper to calculate the semi-perimeter s = (a + b + c) / 2.\"\"\"\n        return (a + b + c) / 2\n\n    def _round_area(self, area: float) -> float:\n        \"\"\"Private helper to round a given float value to two decimal places.\"\"\"\n        return round(area, 2)\n\nclass TriangleService:\n    INVALID_TRIANGLE_RETURN_VALUE = -1.00\n\n    def __init__(self, validator: TriangleValidator, calculator: TriangleCalculator):\n        \"\"\"Constructor that injects instances of TriangleValidator and TriangleCalculator.\"\"\"\n        self._validator = validator\n        self._calculator = calculator\n\n    def triangle_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"Calculates the area of a triangle, returning -1.00 if sides are invalid.\"\"\"\n        if not self._validator.is_valid(a, b, c):\n            return self.INVALID_TRIANGLE_RETURN_VALUE\n        \n        return self._calculator.calculate_herons_area(a, b, c)\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1.\n    \"\"\"\n    validator = TriangleValidator()\n    calculator = TriangleCalculator()\n    service = TriangleService(validator, calculator)\n    return service.triangle_area(a, b, c)\n```"}
