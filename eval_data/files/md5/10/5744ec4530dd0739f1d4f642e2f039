{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n    \n    last_char = txt[-1]\n    \n    if not last_char.isalpha():\n        return False\n            \n    # If it's a single character string, it's a letter and not \"part of a word\"\n    # (it is the word itself).\n    if len(txt) == 1:\n        return True\n            \n    # Check the character before the last one.\n    char_before_last = txt[-2]\n        \n    # If the character before the last one is a space, then the last char\n    # is a letter and not part of a word.\n    if char_before_last == ' ':\n        return True\n            \n    return False"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr: list[int | float]) -> int:\n    \"\"\"\n    Returns the largest index where an array element is out of non-decreasing order.\n    Returns -1 if no such element exists, or if the array is too short.\n    \"\"\"\n    if not arr or len(arr) < 2:\n        return -1\n\n    largest_disorder_idx = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_disorder_idx = i\n    return largest_disorder_idx\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical character.\n    An isolated character is either the only character or preceded by a space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    if txt[-2] == ' ':\n        return True\n\n    return False\n```"}
{"task_id": "HumanEval/126", "solution": "```python\nfrom collections import Counter\n\ndef is_sorted(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of numbers is sorted in ascending order and adheres to a duplicate rule.\n    Returns False if any number appears more than twice; otherwise, returns True if sorted.\n    \"\"\"\n    # Check for the business rule regarding duplicate numbers.\n    # A list is invalid if any number appears more than twice.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check if the list is sorted in ascending order.\n    # An empty list or a single-element list is considered sorted.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or\n    equal to the element immediately preceding it. If no such element\n    exists then return -1. The given array will not contain duplicate values.\"\"\"\n    if not arr or len(arr) < 2:\n        return -1\n\n    largest_violation_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_violation_index = i\n    return largest_violation_index\n```"}
