{"task_id": "HumanEval/106", "solution": "```python\ndef _factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\n    Raises ValueError for negative input.\n    \"\"\"\n    if num < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n    if num == 0:\n        return 1\n    res = 1\n    for i in range(1, num + 1):\\\n        res *= i\n    return res\n\ndef _sum_up_to(num: int) -> int:\n    \"\"\"Calculates the sum of integers from 1 to a positive integer.\n    Raises ValueError for non-positive input.\n    \"\"\"\n    if num <= 0:\n        raise ValueError(\"Sum up to must be for a positive number.\")\n    return num * (num + 1) // 2\n\ndef f(n: int) -> list[int]:\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even\n            result_list.append(_factorial(i))\n        else:  # Odd\n            result_list.append(_sum_up_to(i))\n    return result_list\n```"}
{"task_id": "HumanEval/107", "solution": "```python\nclass PalindromeChecker:\n    def is_palindrome(self, num: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a palindrome.\n        \"\"\"\n        if num < 0:\n            return False\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\nclass PalindromeService:\n    def __init__(self, palindrome_checker: PalindromeChecker):\n        self._palindrome_checker = palindrome_checker\n\n    def count_even_odd_palindromes(self, n: int) -> tuple[int, int]:\n        \"\"\"\n        Counts even and odd integer palindromes within the range [1, n].\n        \"\"\"\n        even_count = 0\n        odd_count = 0\n        for i in range(1, n + 1):\n            if self._palindrome_checker.is_palindrome(i):\n                if i % 2 == 0:\n                    even_count += 1\n                else:\n                    odd_count += 1\n        return (even_count, odd_count)\n\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if not (1 <= n <= 1000):\n        raise ValueError(\"Input 'n' must be between 1 and 1000 (inclusive).\")\n\n    checker = PalindromeChecker()\n    service = PalindromeService(checker)\n    return service.count_even_odd_palindromes(n)\n```"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S):\n    \"\"\"\n    Counts \"boredom\" sentences (starting with the exact word \"I\") in a given string.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input 'S' must be a string.\")\n\n    # Internal helper class for splitting text into sentences.\n    class SentenceSplitter:\n        SENTENCE_DELIMITERS = ['.', '?', '!']\n\n        def split_sentences(self, text: str) -> list[str]:\n            \"\"\"Splits the input text into a list of cleaned sentences.\"\"\"\n            temp_text = text\n            for delim in self.SENTENCE_DELIMITERS:\n                temp_text = temp_text.replace(delim, '###SENTENCE_SPLIT###')\n            \n            raw_sentences = temp_text.split('###SENTENCE_SPLIT###')\n            \n            result_sentences = []\n            for s in raw_sentences:\n                cleaned_s = s.strip()\n                if cleaned_s:\n                    result_sentences.append(cleaned_s)\n            return result_sentences\n\n    # Internal helper class for identifying and counting \"boredom\" sentences.\n    class BoredomCounter:\n        def __init__(self):\n            \"\"\"Initializes the BoredomCounter, internally using a SentenceSplitter.\"\"\"\n            self._sentence_splitter = SentenceSplitter()\n\n        def _is_bored_sentence(self, sentence: str) -> bool:\n            \"\"\"Checks if a sentence starts with the exact word 'I' (case-sensitive).\"\"\"\n            clean_sentence = sentence.strip()\n            # A boredom is \"I\" followed by a space or \"I\" at the end of the sentence.\n            return clean_sentence == \"I\" or clean_sentence.startswith(\"I \")\n\n        def count_boredoms(self, sentences: list[str]) -> int:\n            \"\"\"Iterates through a list of sentences and counts how many are boredoms.\"\"\"\n            boredom_count = 0\n            for sentence in sentences:\n                if self._is_bored_sentence(sentence):\n                    boredom_count += 1\n            return boredom_count\n\n    # Orchestrate the counting process using the helper classes.\n    splitter = SentenceSplitter()\n    sentences = splitter.split_sentences(S)\n    \n    counter = BoredomCounter()\n    return counter.count_boredoms(sentences)\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"\n    Determines if an array can be sorted by right shifts.\n    Returns True if sortable, False otherwise.\n    \"\"\"\n\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    def _is_sorted(current_arr: list) -> bool:\n        \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n        for i in range(len(current_arr) - 1):\n            if current_arr[i] > current_arr[i+1]:\n                return False\n        return True\n\n    def _find_break_point(current_arr: list) -> int:\n        \"\"\"Finds the index where non-decreasing order is broken.\"\"\"\n        break_point = -1\n        for i in range(len(current_arr) - 1):\n            if current_arr[i] > current_arr[i+1]:\n                if break_point != -1:  # Second break point found\n                    return -2\n                break_point = i\n        return break_point\n\n    break_point_index = _find_break_point(arr)\n\n    if break_point_index == -1:\n        # Array is already sorted.\n        return True\n    elif break_point_index == -2:\n        # More than one break point, cannot be sorted by a single rotation.\n        return False\n    else:\n        # Exactly one break point found; rotate and check if sorted.\n        rotated_arr = arr[break_point_index + 1:] + arr[:break_point_index + 1]\n        return _is_sorted(rotated_arr)\n```\n"}
