{"task_id": "HumanEval/150", "solution": "```python\nimport math\nfrom typing import Any\n\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if an integer num is a prime number.\n        Raises TypeError if num is not an integer.\n        \"\"\"\n        if not isinstance(num, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if num < 2:\n            return False\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Calculates the count of even and odd digits in an integer.\n    Ignores the sign and treats 0 as an even digit.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input 'num' must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n    \n    # Handle the absolute value to ignore the sign\n    abs_num = abs(num)\n    \n    # Special case for 0\n    if abs_num == 0:\n        return (1, 0) # 0 is an even digit\n\n    num_str = str(abs_num)\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple with the count of even and odd digits.\n\n    The sign of the number is ignored, and 0 is considered an even digit.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n\n    # Convert to absolute string representation to iterate through digits.\n    s_num = str(abs(num))\n\n    for char_digit in s_num:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return even_count, odd_count\n```"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP = {\n    1000: 'm', 900: 'cm', 500: 'd', 400: 'cd',\n    100: 'c', 90: 'xc', 50: 'l', 40: 'xl',\n    10: 'x', 9: 'ix', 5: 'v', 4: 'iv', 1: 'i'\n}\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in _ROMAN_MAP.items():\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its cyclic rotations is a substring in the first word.\n    Handles input validation and empty strings as per specification.\n    \"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise ValueError(\"Inputs 'a' and 'b' must be strings.\")\n    \n    if not a or not b:\n        # An empty string cannot contain a pattern, nor can an empty pattern be found.\n        return False\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\"\"\"\n        if not s:\n            return []\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef _generate_rotations(s: str) -> set[str]:\n    \"\"\"Generates all unique cyclic rotations of a given string.\n    Returns `{\" \"}` if `s` is empty.\n    \"\"\"\n    if not s:\n        return {\"\"}\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return rotations\n\ndef cycpattern_check(a , b):\n    \"\"\"Checks if the second word (b) or any of its rotations is a substring in the first word (a).\n    Returns True if a rotation of b is found, False otherwise.\n    \"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n    if len(b) > len(a):\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/153", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import Callable\n\n@dataclass(frozen=True)\nclass ExtensionStrength:\n    name: str\n    strength: int\n\nclass ExtensionStrengthCalculator:\n    def calculate_strength(self, extension_name: str) -> int:\n        \"\"\"Counts uppercase and lowercase letters in the name and returns their difference.\"\"\"\n        if not isinstance(extension_name, str):\n            raise TypeError(\"Extension name must be a string.\")\n\n        uppercase_count = sum(1 for char in extension_name if char.isupper())\n        lowercase_count = sum(1 for char in extension_name if char.islower())\n        return uppercase_count - lowercase_count\n\nclass StrongestExtensionSelector:\n    def __init__(self, calculate_strength_func: Callable[[str], int]):\n        \"\"\"Initializes the selector with a strength calculation function.\"\"\"\n        self._calculate_strength_func = calculate_strength_func\n\n    def select_strongest(self, extensions: list[str]) -> str:\n        \"\"\"Finds the strongest extension from the provided list, applying tie-breaking rules.\"\"\"\n        if not extensions:\n            raise ValueError(\"Extensions list cannot be empty.\")\n\n        strongest_extension = \"\"\n        max_strength = -float('inf') \n\n        for ext in extensions:\n            if not isinstance(ext, str):\n                raise TypeError(\"All extensions in the list must be strings.\")\n            \n            current_strength = self._calculate_strength_func(ext)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension = ext\n        \n        return strongest_extension\n\nclass StrongExtensionService:\n    def __init__(self, calculator: ExtensionStrengthCalculator, selector: StrongestExtensionSelector):\n        \"\"\"Initializes the service with instances of the calculator and selector.\"\"\"\n        self._calculator = calculator\n        self._selector = selector\n\n    def find_strongest_extension(self, class_name: str, extensions: list[str]) -> str:\n        \"\"\"Coordinates the process to find the strongest extension and formats the output.\"\"\"\n        if not isinstance(class_name, str):\n            raise TypeError(\"Class name must be a string.\")\n\n        strongest_ext_name = self._selector.select_strongest(extensions)\n        return f\"{class_name}.{strongest_ext_name}\"\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Calculates the 'strength' of extensions and returns the strongest one in 'ClassName.StrongestExtensionName' format.\n    Strength is (uppercase - lowercase letters), with ties broken by the first occurrence.\n    \"\"\"\n    calculator = ExtensionStrengthCalculator()\n    selector = StrongestExtensionSelector(calculator.calculate_strength)\n    service = StrongExtensionService(calculator, selector)\n    return service.find_strongest_extension(class_name, extensions)\n```"}
{"task_id": "HumanEval/156", "solution": "```python\nclass InvalidNumberError(ValueError):\n    \"\"\"Custom exception for numbers outside the valid Roman numeral range.\"\"\"\n    pass\n\nROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n]\nMIN_NUM = 1\nMAX_NUM = 1000\n\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Converts a positive integer into its lowercase Roman numeral equivalent.\n    Supports integers within the range 1 to 1000, inclusive.\n    \"\"\"\n    if not isinstance(number, int) or not (MIN_NUM <= number <= MAX_NUM):\n        raise InvalidNumberError(\n            f\"Number must be an integer between {MIN_NUM} and {MAX_NUM}, inclusive.\"\n        )\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple strings have the maximum unique characters, returns the one that comes first lexicographically.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # Initialize with the first word from the list.\n    best_word = words[0]\n    max_unique_count = len(set(words[0]))\n\n    # Iterate through the remaining words to find the best match.\n    for word in words[1:]:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            # For ties in unique character count, choose the lexicographically smaller word.\n            if word < best_word:\n                best_word = word\n                \n    return best_word\n```"}
