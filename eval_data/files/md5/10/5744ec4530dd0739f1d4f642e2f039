{"task_id": "HumanEval/21", "solution": "```python\nfrom typing import List\n\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"\n    Applies a linear transformation to a list of numbers to scale them to the [0, 1] range.\n    The smallest number maps to 0.0 and the largest to 1.0.\n    \"\"\"\n    min_list_length = 2\n\n    if len(numbers) < min_list_length:\n        raise ValueError(f\"Input list must contain at least {min_list_length} elements.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if min_val == max_val:\n        # If all numbers are the same, they all map to 0.0\n        return [0.0] * len(numbers)\n\n    # Apply the linear transformation\n    rescaled_numbers = [(x - min_val) / (max_val - min_val) for x in numbers]\n    return rescaled_numbers\n```"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List, Dict\n\nclass InvalidNumberWordError(ValueError):\n    \"\"\"Custom exception for invalid number words.\"\"\"\n    def __init__(self, word: str):\n        super().__init__(f\"\\'{word}\\' is not a valid number word (expected \\'zero\\' through \\'nine\\').\")\n        self.word = word\n\nclass NumberWordMap:\n    \"\"\"Utility class for converting between number words and integers.\"\"\"\n\n    NUMBER_WORD_MAP: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    INT_WORD_MAP: Dict[int, str] = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    @staticmethod\n    def get_int_from_word(word: str) -> int:\n        \"\"\"Returns the integer for a given number word. Raises `InvalidNumberWordError` if the word is unknown.\"\"\"\n        if word not in NumberWordMap.NUMBER_WORD_MAP:\n            raise InvalidNumberWordError(word)\n        return NumberWordMap.NUMBER_WORD_MAP[word]\n\n    @staticmethod\n    def get_word_from_int(num: int) -> str:\n        \"\"\"Returns the number word for a given integer. Raises `ValueError` if the integer is unknown.\"\"\"\n        if num not in NumberWordMap.INT_WORD_MAP:\n            raise ValueError(f\"\\'{num}\\' is not a valid integer for number word conversion.\")\n        return NumberWordMap.INT_WORD_MAP[num]\n\nclass NumberSorter:\n    \"\"\"A class to sort space-delimited number words from smallest to largest.\"\"\"\n\n    def sort_numbers(self, numbers_str: str) -> str:\n        \"\"\"\n        Sorts a space-delimited string of number words ('zero' through 'nine') in ascending order.\n        Raises `InvalidNumberWordError` for invalid words.\n        \"\"\"\n        if not numbers_str.strip():\n            return \"\"\n\n        words = numbers_str.split(' ')\n        words = [word for word in words if word] # Filter out empty strings from multiple spaces\n        \n        int_numbers = self._convert_words_to_ints(words)\n        int_numbers.sort()\n        sorted_words = self._convert_ints_to_words(int_numbers)\n        \n        return ' '.join(sorted_words)\n\n    def _convert_words_to_ints(self, words: List[str]) -> List[int]:\n        \"\"\"Converts a list of number words to a list of integers. Raises `InvalidNumberWordError` for unknown words.\"\"\"\n        return [NumberWordMap.get_int_from_word(word) for word in words]\n\n    def _convert_ints_to_words(self, ints: List[int]) -> List[str]:\n        \"\"\"Converts a list of integers to a list of number words.\"\"\"\n        return [NumberWordMap.get_word_from_int(num) for num in ints]\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"\n    Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    sorter = NumberSorter()\n    return sorter.sort_numbers(numbers)\n```"}
