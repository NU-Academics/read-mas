{"task_id": "HumanEval/108", "solution": "def _get_signed_digits(num: int) -> list[int]:\n    \"\"\"Extracts signed digits from a number, handling the first digit for negatives.\"\"\"\n    if not isinstance(num, int):\n        raise TypeError(f\"Input must be an integer, got {type(num)}\")\n\n    if num == 0:\n        return [0]\n    \n    s_num = str(num)\n    digits = []\n    if s_num.startswith('-'):\n        digits.append(-int(s_num[1]))\n        for char_digit in s_num[2:]:\n            digits.append(int(char_digit))\n    else:\n        for char_digit in s_num:\n            digits.append(int(char_digit))\n    return digits\n\ndef _calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of digits, with special handling for negative numbers.\"\"\"\n    if not isinstance(num, int):\n        raise TypeError(f\"Input must be an integer, got {type(num)}\")\n\n    if num == 0:\n        return 0\n    elif num > 0:\n        return sum(int(digit) for digit in str(num))\n    else: # num < 0\n        signed_digits = _get_signed_digits(num)\n        return sum(signed_digits)\n\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts elements in an array whose sum of digits is greater than 0.\n    Handles non-integer array elements by raising TypeError.\n    \"\"\"\n    count = 0\n    for num in arr:\n        if not isinstance(num, int):\n            raise TypeError(f\"Array element must be an integer, got {type(num)}\")\n            \n        if _calculate_digit_sum(num) > 0:\n            count += 1\n    return count\n"}
{"task_id": "HumanEval/108", "solution": "```python\ndef count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of their digits is greater than 0.\n    Utilizes a helper to correctly sum digits, especially for negative numbers.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for an integer.\n        The first signed digit of negative numbers is treated as negative.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s = str(num)\n        digit_sum = 0\n        if s[0] == '-':\n            # The first digit after the negative sign is treated as negative.\n            digit_sum += int(s[1]) * -1\n            # Subsequent digits are added as positive.\n            for digit_char in s[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # For positive numbers, all digits are summed as positive.\n            for digit_char in s:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    if not arr:  # FR6: Return 0 if the input array is empty.\n        return 0\n\n    for num in arr:\n        if _calculate_digit_sum(num) > 0:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"Determines if the array can be sorted by right shifts.\n    Returns True if sortable, False otherwise.\n    \"\"\"\n\n    def _is_sorted(current_arr_to_check):\n        \"\"\"Checks if the given array is sorted non-decreasingly.\n        Returns True if sorted, False otherwise.\n        \"\"\"\n        if not current_arr_to_check:\n            return True\n        for i in range(len(current_arr_to_check) - 1):\n            if current_arr_to_check[i] > current_arr_to_check[i+1]:\n                return False\n        return True\n\n    if not arr:\n        return True\n\n    n = len(arr)\n    # Create a mutable copy to perform shifts without altering the original input array.\n    current_arr_state = list(arr) \n\n    for _ in range(n):\n        if _is_sorted(current_arr_state):\n            return True\n        \n        # Perform one right shift as per BR3. This operation creates a new list.\n        current_arr_state = [current_arr_state[-1]] + current_arr_state[:-1]\n            \n    return False\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef is_even(num: int) -> bool:\n    \"\"\"Checks if a given integer is even. This is a helper for number parity checks.\"\"\"\n    return num % 2 == 0\n\ndef is_odd(num: int) -> bool:\n    \"\"\"Checks if a given integer is odd. This is a helper for number parity checks.\"\"\"\n    return num % 2 != 0\n\ndef _count_odd_numbers(numbers: list[int]) -> int:\n    \"\"\"Counts odd integers in a list. This is a helper for the main exchange function.\"\"\"\n    return sum(1 for num in numbers if is_odd(num))\n\ndef _count_even_numbers(numbers: list[int]) -> int:\n    \"\"\"Counts even integers in a list. This is a helper for the main exchange function.\"\"\"\n    return sum(1 for num in numbers if is_even(num))\n\ndef exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    odd_count_lst1 = _count_odd_numbers(lst1)\n    even_count_lst2 = _count_even_numbers(lst2)\n\n    if even_count_lst2 >= odd_count_lst1:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
