{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given three side lengths, determine if they form a right-angled triangle.\n    It validates inputs for positivity and triangle inequality before applying the Pythagorean theorem with tolerance.\n    \"\"\"\n    EPSILON = 1e-9 # Tolerance for floating-point comparisons.\n\n    # FR1: Accept three numerical inputs and handle non-numerical types.\n    if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n        raise TypeError(\"Side lengths must be numeric (int or float).\")\n\n    # Convert all inputs to float for consistent calculations.\n    a_f, b_f, c_f = float(a), float(b), float(c)\n\n    # FR2: Validate that all three input side lengths are positive numbers.\n    if not (a_f > 0 and b_f > 0 and c_f > 0):\n        raise ValueError(\"All side lengths must be positive numbers.\")\n\n    # FR3: Validate that the three input side lengths can form a valid triangle.\n    if not (a_f + b_f > c_f and a_f + c_f > b_f and b_f + c_f > a_f):\n        raise ValueError(\"The given side lengths do not form a valid triangle.\")\n\n    # FR4: Apply the Pythagorean theorem (a\u00b2 + b\u00b2 = c\u00b2).\n    # Sort the squares of the sides to ensure the two smallest sum to the largest.\n    sides_squared = sorted([a_f**2, b_f**2, c_f**2])\n    \n    # FR5 & FR6: Return True if right-angled, False otherwise.\n    # Compare with EPSILON for floating-point accuracy.\n    return abs(sides_squared[0] + sides_squared[1] - sides_squared[2]) < EPSILON\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Simulates a rabbit's carrot consumption based on its needs and available stock.\n    Returns [total_eaten_carrots, carrots_left_after_meals].\n    \"\"\"\n    MIN_CARROT_VALUE = 0\n    MAX_CARROT_VALUE = 1000\n\n    if not isinstance(number, int):\n        raise TypeError(\"number must be an integer.\")\n    if not (MIN_CARROT_VALUE <= number <= MAX_CARROT_VALUE):\n        raise ValueError(\n            f\"number must be between {MIN_CARROT_VALUE} and {MAX_CARROT_VALUE} inclusive, \"\n            f\"but got {number}.\"\n        )\n\n    if not isinstance(need, int):\n        raise TypeError(\"need must be an integer.\")\n    if not (MIN_CARROT_VALUE <= need <= MAX_CARROT_VALUE):\n        raise ValueError(\n            f\"need must be between {MIN_CARROT_VALUE} and {MAX_CARROT_VALUE} inclusive, \"\n            f\"but got {need}.\"\n        )\n\n    if not isinstance(remaining, int):\n        raise TypeError(\"remaining must be an integer.\")\n    if not (MIN_CARROT_VALUE <= remaining <= MAX_CARROT_VALUE):\n        raise ValueError(\n            f\"remaining must be between {MIN_CARROT_VALUE} and {MAX_CARROT_VALUE} inclusive, \"\n            f\"but got {remaining}.\"\n        )\n\n    carrots_eaten_from_stock = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_from_stock\n    carrots_left_in_stock = remaining - carrots_eaten_from_stock\n\n    return [total_eaten_carrots, carrots_left_in_stock]\n```"}
{"task_id": "HumanEval/157", "solution": "```python\nimport math\n\nclass InvalidTriangleError(Exception):\n    \"\"\"Custom exception for invalid triangle side lengths.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass TriangleSides:\n    \"\"\"A DTO to hold three side lengths and provide them sorted.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n            raise TypeError(\"Side lengths must be numbers.\")\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\n    def get_sides(self) -> list[float]:\n        \"\"\"Returns a sorted list of the side lengths.\"\"\"\n        return sorted([self.a, self.b, self.c])\n\nclass TriangleValidator:\n    \"\"\"Validates triangle properties based on side lengths.\"\"\"\n    def validate_positive_sides(self, a: float, b: float, c: float) -> None:\n        \"\"\"Checks if all three side lengths are positive.\"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            raise ValueError(\"All side lengths must be positive.\")\n\n    def validate_triangle_inequality(self, a: float, b: float, c: float) -> None:\n        \"\"\"Checks if the side lengths satisfy the triangle inequality theorem.\"\"\"\n        if not (a + b > c and a + c > b and b + c > a):\n            raise InvalidTriangleError(\"The given side lengths cannot form a valid triangle.\")\n\nclass TriangleService:\n    \"\"\"Contains business logic for right-angle triangle determination.\"\"\"\n    def __init__(self, validator: TriangleValidator = None):\n        self.validator = validator if validator is not None else TriangleValidator()\n\n    def _check_pythagorean(self, s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Checks if s1^2 + s2^2 = s3^2 with a small tolerance.\"\"\"\n        return math.isclose(s1**2 + s2**2, s3**2, rel_tol=1e-9)\n\n    def is_right_angle_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Determines if the given side lengths form a right-angled triangle. This involves validation and applying the Pythagorean theorem.\"\"\"\n        sides_obj = TriangleSides(a, b, c) # Handles TypeError for non-numeric inputs.\n        sides = sides_obj.get_sides() # Sorted: s[0] <= s[1] <= s[2]\n\n        self.validator.validate_positive_sides(sides[0], sides[1], sides[2])\n        self.validator.validate_triangle_inequality(sides[0], sides[1], sides[2])\n\n        # The longest side (sides[2]) must be the hypotenuse for a right-angled triangle.\n        return self._check_pythagorean(sides[0], sides[1], sides[2])\n\n_triangle_validator_instance = TriangleValidator()\n_triangle_service_instance = TriangleService(validator=_triangle_validator_instance)\n\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Given three side lengths, determine if they form a right-angled triangle.\n    This function validates inputs and applies the Pythagorean theorem.\n    \"\"\"\n    return _triangle_service_instance.is_right_angle_triangle(a, b, c)\n```"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s: str) -> str:\n    \"\"\"Transforms a string based on character rules.\n    Letters have their case reversed; if no letters are present, the entire string is reversed.\"\"\"\n\n    has_letters = any(c.isalpha() for c in s)\n\n    if not has_letters:\n        # If the string contains no letters, reverse the entire string.\n        return s[::-1]\n    else:\n        # If letters are present, iterate and reverse case for letters, keep others unchanged.\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Simulates a rabbit's carrot consumption based on needs and available stock.\n    Returns the total eaten carrots and the remaining stock as a list [total_eaten, carrots_left].\n    \"\"\"\n    # Validate input types and ranges as per constraints.\n    if not all(isinstance(arg, int) for arg in [number, need, remaining]):\n        raise ValueError(\"All input parameters must be integers.\")\n    if not (0 <= number <= 1000 and 0 <= need <= 1000 and 0 <= remaining <= 1000):\n        raise ValueError(\"Input parameters must be between 0 and 1000, inclusive.\")\n\n    # Determine actual carrots consumed during this meal.\n    consumed_carrots = min(need, remaining)\n\n    # Calculate total carrots eaten after this meal.\n    total_eaten = number + consumed_carrots\n\n    # Calculate carrots left in stock.\n    carrots_left = remaining - consumed_carrots\n\n    return [total_eaten, carrots_left]\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Reverses the case of letters in a string. If no letters are present, the entire string is reversed.\"\"\"\n\n    # Determine if the input string contains any alphabetic characters.\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        # If no alphabetic characters are found, reverse the entire string.\n        return s[::-1]\n    else:\n        # If letters are present, iterate and modify the string character by character.\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                # Reverse the case of alphabetic characters.\n                if char.islower():\n                    result_chars.append(char.upper())\n                elif char.isupper():\n                    result_chars.append(char.lower())\n                else:\n                    # Keep as is if alphabetic but not strictly lower or upper.\n                    result_chars.append(char)\n            else:\n                # Keep non-alphabetic characters unchanged.\n                result_chars.append(char)\n        # Return the newly constructed string.\n        return \"\".join(result_chars)\n```\n"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input to the do_algebra function.\"\"\"\n        pass\n\n    ALLOWED_OPERATORS = ['+', '-', '*', '//', '**']\n\n    def _validate_inputs(op_list: list[str], val_list: list[int]) -> None:\n        \"\"\"Validates the input operator and operand lists.\"\"\"\n        if not val_list:\n            raise InvalidInputError(\"Operand list cannot be empty.\")\n        if len(op_list) != len(val_list) - 1:\n            raise InvalidInputError(\n                f\"Length of operator list ({len(op_list)}) must be \"\n                f\"one less than length of operand list ({len(val_list)}).\"\n            )\n\n        for i, val in enumerate(val_list):\n            if not isinstance(val, int) or val < 0:\n                raise InvalidInputError(\n                    f\"Operand at index {i} must be a non-negative integer, got {val}.\"\n                )\n\n        for i, op in enumerate(op_list):\n            if not isinstance(op, str) or op not in ALLOWED_OPERATORS:\n                raise InvalidInputError(\n                    f\"Operator at index {i} must be one of \"\n                    f\"{ALLOWED_OPERATORS}, got '{op}'.\"\n                )\n\n    def _build_expression_string(op_list: list[str], val_list: list[int]) -> str:\n        \"\"\"Constructs the algebraic expression as a string.\"\"\"\n        expression_parts = [str(val_list[0])]\n        for i in range(len(op_list)):\n            expression_parts.append(op_list[i])\n            expression_parts.append(str(val_list[i+1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression(expression_string: str) -> int:\n        \"\"\"Evaluates the given algebraic expression string.\"\"\"\n        try:\n            result = eval(expression_string)\n            return int(result)\n        except ZeroDivisionError:\n            raise\n        except Exception as e:\n            raise InvalidInputError(f\"Error evaluating expression '{expression_string}': {e}\")\n\n    _validate_inputs(operator, operand)\n    expression_str = _build_expression_string(operator, operand)\n    return _evaluate_expression(expression_str)\n\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Computes the MD5 hash of the input string, or None if the string is empty.\n    Strings are encoded as UTF-8 before hashing.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()\n```"}
{"task_id": "HumanEval/160", "solution": "```python\nclass AlgebraError(Exception):\n    \"\"\"Base exception for algebra evaluator errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidOperatorError(AlgebraError):\n    \"\"\"Raised when an invalid operator is encountered.\"\"\"\n    pass\n\nclass InvalidOperandError(AlgebraError):\n    \"\"\"Raised when an invalid operand is encountered.\"\"\"\n    pass\n\nclass InputMismatchError(AlgebraError):\n    \"\"\"Raised when input list lengths or counts are incorrect.\"\"\"\n    pass\n\nclass CalculationError(AlgebraError):\n    \"\"\"Raised when an arithmetic calculation error occurs.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates the input operator and operand lists.\"\"\"\n    VALID_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def validate(self, operators: list[str], operands: list[int]) -> None:\n        \"\"\"Orchestrates all validation checks.\"\"\"\n        self._validate_operator_list(operators)\n        self._validate_operand_list(operands)\n        self._validate_lengths(operators, operands)\n\n    def _validate_operator_list(self, operators: list[str]) -> None:\n        \"\"\"Checks if operators is a list and contains only valid operator strings.\"\"\"\n        if not isinstance(operators, list):\n            raise InvalidOperatorError(\"Operators must be a list.\")\n        for op in operators:\n            if not isinstance(op, str) or op not in self.VALID_OPERATORS:\n                raise InvalidOperatorError(f\"Invalid operator found: '{op}'. Allowed: {', '.join(self.VALID_OPERATORS)}\")\n\n    def _validate_operand_list(self, operands: list[int]) -> None:\n        \"\"\"Checks if operands is a list and contains only non-negative integers.\"\"\"\n        if not isinstance(operands, list):\n            raise InvalidOperandError(\"Operands must be a list.\")\n        for opd in operands:\n            if not isinstance(opd, int) or opd < 0:\n                raise InvalidOperandError(f\"Invalid operand found: '{opd}'. Operands must be non-negative integers.\")\n\n    def _validate_lengths(self, operators: list[str], operands: list[int]) -> None:\n        \"\"\"Checks input list lengths and counts.\"\"\"\n        if not operators or not operands or len(operators) < 1 or len(operands) < 2:\n            raise InputMismatchError(\"Operator list must have at least one operator, and operand list at least two operands.\")\n        if len(operators) != len(operands) - 1:\n            raise InputMismatchError(f\"Length of operators ({len(operators)}) must be one less than length of operands ({len(operands)}).\")\n\nclass ExpressionParser:\n    \"\"\"Converts separate lists of operators and operands into a single token list.\"\"\"\n    def parse(self, operators: list[str], operands: list[int]) -> list[str]:\n        \"\"\"Combines operators and operands into a single token list.\"\"\"\n        return self._interleave(operators, operands)\n\n    def _interleave(self, operators: list[str], operands: list[int]) -> list[str]:\n        \"\"\"Helper to interleave the elements.\"\"\"\n        expression_tokens = []\n        for i in range(len(operands)):\n            expression_tokens.append(str(operands[i]))\n            if i < len(operators):\n                expression_tokens.append(operators[i])\n        return expression_tokens\n\nclass AlgebraEvaluator:\n    \"\"\"Evaluates a tokenized algebraic expression respecting operator precedence.\"\"\"\n    _precedence = {\n        '+': 1, '-': 1,\n        '*': 2, '//': 2,\n        '**': 3\n    }\n\n    def evaluate(self, expression_tokens: list[str]) -> int:\n        \"\"\"Evaluates the given list of expression tokens.\"\"\"\n        output_queue = []\n        operator_stack = []\n\n        for token in expression_tokens:\n            if token.isdigit():\n                output_queue.append(int(token))\n            elif token in self._precedence:\n                while (operator_stack and\n                       self._get_precedence(operator_stack[-1]) >= self._get_precedence(token)):\n                    op = operator_stack.pop()\n                    val2 = output_queue.pop()\n                    val1 = output_queue.pop()\n                    output_queue.append(self._apply_operator(op, val1, val2))\n                operator_stack.append(token)\n\n        while operator_stack:\n            op = operator_stack.pop()\n            val2 = output_queue.pop()\n            val1 = output_queue.pop()\n            output_queue.append(self._apply_operator(op, val1, val2))\n\n        return output_queue[0]\n\n    def _apply_operator(self, op: str, val1: int, val2: int) -> int:\n        \"\"\"Performs the arithmetic operation based on the operator string.\"\"\"\n        if op == '+':\n            return val1 + val2\n        elif op == '-':\n            return val1 - val2\n        elif op == '*':\n            return val1 * val2\n        elif op == '//':\n            if val2 == 0:\n                raise CalculationError(\"Division by zero.\")\n            return val1 // val2\n        elif op == '**':\n            return val1 ** val2\n        else:\n            raise CalculationError(f\"Unknown operator during calculation: {op}\")\n\n    def _get_precedence(self, op: str) -> int:\n        \"\"\"Returns the precedence level for a given operator.\"\"\"\n        return self._precedence.get(op, 0)\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    try:\n        validator = InputValidator()\n        validator.validate(operator, operand)\n\n        parser = ExpressionParser()\n        expression_tokens = parser.parse(operator, operand)\n\n        evaluator = AlgebraEvaluator()\n        result = evaluator.evaluate(expression_tokens)\n\n        return result\n    except AlgebraError as e:\n        # Re-raise custom exceptions for the client.\n        raise e\n    except Exception as e:\n        # Catch unexpected errors and wrap them in a generic AlgebraError.\n        raise AlgebraError(f\"An unexpected error occurred: {e}\")\n```\n"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even integers between a\n    and b (inclusive), in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    even_numbers = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n    return even_numbers\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    even_digits_in_range = []\n\n    # Iterate through the range of numbers (inclusive)\n    for i in range(min_val, max_val + 1):\n        # Check if the number is a single digit (0-9) and is even.\n        # Since 'a' and 'b' are positive, 'i' will be >= 1.\n        if 0 <= i <= 9 and i % 2 == 0:\n            even_digits_in_range.append(i)\n\n    return even_digits_in_range\n```"}
