{"task_id": "HumanEval/120", "solution": "```python\nclass InputValidator:\n    \"\"\"Utility class for validating input arrays and k values.\"\"\"\n    @staticmethod\n    def validate_array(arr: list[int]) -> None:\n        \"\"\"Validates the input array against specified constraints.\"\"\"\n        if not isinstance(arr, list):\n            raise ValueError(\"Input 'arr' must be a list.\")\n        if not (1 <= len(arr) <= 1000):\n            raise ValueError(\"Length of 'arr' must be in the range [1, 1000].\")\n        for item in arr:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in 'arr' must be integers.\")\n            if not (-1000 <= item <= 1000):\n                raise ValueError(\"All elements in 'arr' must be in the range [-1000, 1000].\")\n\n    @staticmethod\n    def validate_k(k: int, arr_len: int) -> None:\n        \"\"\"Validates the integer k against specified constraints.\"\"\"\n        if not isinstance(k, int):\n            raise ValueError(\"Input 'k' must be an integer.\")\n        if not (0 <= k <= arr_len):\n            raise ValueError(f\"Input 'k' must be in the range [0, {arr_len}].\")\n\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    InputValidator.validate_array(arr)\n    InputValidator.validate_k(k, len(arr))\n\n    if k == 0:\n        return []\n\n    sorted_arr = sorted(arr)\n    return sorted_arr[len(sorted_arr) - k:]\n\n```"}
{"task_id": "HumanEval/120", "solution": "```python\ndef maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Identifies the k largest numbers from the input array arr.\n    Returns them as a new sorted list in ascending order.\n    \"\"\"\n    if not isinstance(arr, list) or not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"Input 'arr' must be a list of integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if not (0 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 0 and {len(arr)} (inclusive).\")\n\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to find the largest quickly.\n    sorted_arr = sorted(arr, reverse=True)\n\n    # Select the top k elements.\n    k_largest = sorted_arr[:k]\n\n    # Sort these k elements in ascending order for the final output.\n    return sorted(k_largest)\n```"}
{"task_id": "HumanEval/121", "solution": "```python\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    # Validate the input list for type and content, raising appropriate errors.\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n    for item in lst:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    # Calculate the sum of odd elements at even positions (0-indexed).\n    total_sum = 0\n    for i in range(len(lst)):\n        if i % 2 == 0:  # Check if the current position is even.\n            if lst[i] % 2 != 0:  # Check if the element at this even position is odd.\n                total_sum += lst[i]\n    return total_sum\n```"}
{"task_id": "HumanEval/122", "solution": "```python\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    An element has at most two digits if its absolute value is less than 100.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits (between -99 and 99 inclusive).\n        if -100 < element < 100:\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    The Collatz sequence rules are: if even, divide by 2; if odd, multiply by 3 and add 1, until 1 is reached.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    odd_numbers_set = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:\n            odd_numbers_set.add(current_term)\n\n        if current_term % 2 == 0:\n            current_term = current_term // 2\n        else:\n            current_term = 3 * current_term + 1\n            \n    odd_numbers_set.add(1) # Always include 1, as it's the sequence termination and an odd number.\n\n    return sorted(list(odd_numbers_set))\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list of unique odd numbers in its Collatz sequence.\n    The sequence follows the Collatz conjecture rules until it reaches 1, and the result is sorted in increasing order.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current_num = n\n\n    while current_num != 1:\n        if current_num % 2 != 0:\n            odd_numbers.add(current_num)\n\n        if current_num % 2 == 0:\n            current_num //= 2\n        else:\n            current_num = 3 * current_num + 1\n    \n    odd_numbers.add(1)\n\n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nimport re\n\nDAYS_IN_MONTH_MAP = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29  # Assuming fixed 29 days for February as per requirements, no leap year logic\n}\n\nclass DateValidationError(Exception):\n    \"\"\"Custom exception for date validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass DateValidator:\n    \"\"\"Encapsulates all logic required to validate a date string.\"\"\"\n    @staticmethod\n    def valid_date(date_string: str) -> bool:\n        \"\"\"Validates a date string against predefined rules.\"\"\"\n        if not DateValidator._is_not_empty(date_string):\n            return False\n\n        is_format_correct, month, day, year = DateValidator._has_correct_format(date_string)\n        if not is_format_correct:\n            return False\n\n        if not DateValidator._is_month_valid(month):\n            return False\n\n        if not DateValidator._is_day_valid(day, month):\n            return False\n\n        return True\n\n    @staticmethod\n    def _is_not_empty(date_string: str) -> bool:\n        \"\"\"Checks if the date string is not empty.\"\"\"\n        return bool(date_string)\n\n    @staticmethod\n    def _has_correct_format(date_string: str) -> tuple[bool, int, int, int]:\n        \"\"\"Validates 'mm-dd-yyyy' format and extracts components.\"\"\"\n        match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date_string)\n        if not match:\n            return False, 0, 0, 0\n        \n        try:\n            month = int(match.group(1))\n            day = int(match.group(2))\n            year = int(match.group(3))\n            return True, month, day, year\n        except ValueError:\n            return False, 0, 0, 0 \n\n    @staticmethod\n    def _is_month_valid(month: int) -> bool:\n        \"\"\"Checks if the month is within the valid range [1, 12].\"\"\"\n        return 1 <= month <= 12\n\n    @staticmethod\n    def _is_day_valid(day: int, month: int) -> bool:\n        \"\"\"Checks if the day is valid for the given month.\"\"\"\n        if month not in DAYS_IN_MONTH_MAP: \n            return False \n        \n        max_days = DAYS_IN_MONTH_MAP[month]\n        return 1 <= day <= max_days\n\ndef valid_date(date: str) -> bool:\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n    \"\"\"\n    return DateValidator.valid_date(date)\n```"}
{"task_id": "HumanEval/125", "solution": "```python\nfrom typing import List, Union\n\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Splits text by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    Alphabetical order starts with 'a' at 0.\n    \"\"\"\n    if ' ' in txt:\n        return txt.split(' ')\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas, or counts specific lowercase letters.\n    The processing order is strict: whitespace split takes precedence.\n    \"\"\"\n    \n    # Check for whitespace characters (FR1)\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    # Check for commas if no whitespace (FR2)\n    if ',' in txt:\n        return txt.split(',')\n\n    # Count lowercase letters with odd alphabetical order if no delimiters (FR3)\n    count = 0\n    alphabet_offset = ord('a') # 0-indexed alphabetical order starts from 'a'\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - alphabet_offset\n            if order % 2 != 0:  # Check if the order is odd\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nimport re\n\n# Constants for date validation rules, following the design specification.\n_DAYS_IN_MONTH_MAP = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 28 # Default days for February, adjusted for leap years below.\n}\n# Regular expression to validate \"mm-dd-yyyy\" format and preliminary ranges.\n_DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])-\\d{4}$\"\n\ndef _is_leap_year(year):\n    \"\"\"Determines if a year is a leap year according to business rule BRule7.\"\"\"\n    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n\ndef valid_date(date):\n    \"\"\"\n    Validates a given date string based on predefined rules.\n    Returns True if the date is valid, otherwise False.\n    \"\"\"\n    # FR1: Validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # FR2: Validate that the date string adheres to the \"mm-dd-yyyy\" format.\n    # The regex also implicitly validates month (01-12) and day (01-31) formats.\n    match = re.match(_DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    try:\n        month = int(date[0:2])\n        day = int(date[3:5])\n        year = int(date[6:10])\n    except ValueError:\n        # This catch is a safeguard; robust regex should prevent this for valid format.\n        return False\n\n    # FR3 (Month range) is largely covered by the regex `(0[1-9]|1[0-2])`.\n    # FR4: Validate the day component based on the month and year.\n    max_days_for_month = _DAYS_IN_MONTH_MAP[month] # Month is guaranteed 1-12 by regex.\n\n    if month == 2: # February\n        if _is_leap_year(year):\n            max_days_for_month = 29\n        # Else, max_days_for_month remains 28 as per _DAYS_IN_MONTH_MAP default.\n    \n    # Check if the day is within the valid range for the specific month and year.\n    if not (1 <= day <= max_days_for_month):\n        return False\n\n    # FR5: Return True if all validation rules are satisfied.\n    return True\n```"}
{"task_id": "HumanEval/126", "solution": "```python\nfrom collections import Counter\n\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted ascendingly and has at most one duplicate of any number.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate count (more than 1 duplicate means 3 or more occurrences)\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/127", "solution": "```import math\n\nclass Interval:\n    def __init__(self, start: int, end: int):\n        if not start <= end:\n            raise ValueError(\"Interval start must be less than or equal to end.\")\n        self.start = start\n        self.end = end\n\n    def get_length(self) -> int:\n        return self.end - self.start + 1\n\n    def __repr__(self):\n        return f\"Interval({self.start}, {self.end})\"\n\nclass PrimeChecker:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\nclass IntervalService:\n    def calculate_intersection_prime_length(self, interval1: Interval, interval2: Interval) -> str:\n        intersection_interval = self._get_intersection(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = intersection_interval.get_length()\n        if PrimeChecker.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\n\n    def _get_intersection(self, interval1: Interval, interval2: Interval) -> Interval | None:\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n\n        if max_start <= min_end:\n            return Interval(max_start, min_end)\n        else:\n            return None\n\ndef intersection(interval1, interval2):\n    \"\"\"Checks if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if it is prime, \"NO\" otherwise, or if there's no intersection.\n    \"\"\"\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    service = IntervalService()\n    return service.calculate_intersection_prime_length(int1_obj, int2_obj)"}
