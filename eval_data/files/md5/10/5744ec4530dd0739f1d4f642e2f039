{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    VOWELS_SET = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character (index n-2) down to the second character (index 1).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        # Check if current_char is a vowel, and its neighbors are consonants.\n        is_current_vowel = current_char in VOWELS_SET\n        is_left_consonant = left_char.isalpha() and left_char not in VOWELS_SET\n        is_right_consonant = right_char.isalpha() and right_char not in VOWELS_SET\n\n        if is_current_vowel and is_left_consonant and is_right_consonant:\n            return current_char\n            \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "```python\n_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel, case-insensitive.\"\"\"\n    return char.lower() in _VOWELS\n\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant, case-insensitive.\"\"\"\n    # Assumes char is an English letter as per problem constraints.\n    return char.isalpha() and not _is_vowel(char)\n\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right that is between two consonants. Vowels at the beginning or end of the word are ignored, and an empty string is returned if no such vowel is found.\"\"\"\n    n = len(word)\n    # A vowel needs a preceding and following character, so word must have at least 3 characters.\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and n-1).\n    # The loop considers indices from n-2 down to 1.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        # Check if the current character is a vowel surrounded by two consonants.\n        if (_is_vowel(current_char) and\n                _is_consonant(left_char) and\n                _is_consonant(right_char)):\n            return current_char\n            \n    return \"\"\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a given string of parentheses is balanced.\n    It uses a counter to ensure all parentheses are matched and prefixes are valid.\n    \"\"\"\n    count = 0\n    for char in s:\n        if char == '(':\n            count += 1\n        elif char == ')':\n            count -= 1\n        if count < 0:\n            return False\n    return count == 0\n\ndef match_parens(lst):\n    \"\"\"Checks if concatenating two strings of parentheses in any order forms a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two given parentheses strings can form a balanced string by concatenation.\n    Returns 'Yes' if a good string can be formed, 'No' otherwise.\n    \"\"\"\n    def is_valid_input_char(char: str) -> bool:\n        \"\"\"Checks if a single character is a valid parenthesis.\"\"\"\n        return char == '(' or char == ')'\n\n    def is_balanced(s: str) -> bool:\n        \"\"\"Determines if a string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False  # Closing parenthesis without an opening one.\n        return balance == 0\n\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise ValueError(\"Input must be a list containing exactly two strings.\")\n\n    s0, s1 = lst[0], lst[1]\n\n    for s_item in [s0, s1]:\n        if not isinstance(s_item, str):\n            raise ValueError(\"All elements in the list must be strings.\")\n        for char in s_item:\n            if not is_valid_input_char(char):\n                raise ValueError(f\"Invalid character '{char}' found in input string.\")\n\n    combined1 = s0 + s1\n    combined2 = s1 + s0\n\n    if is_balanced(combined1) or is_balanced(combined2):\n        return 'Yes'\n    else:\n        return 'No'"}
