{"task_id": "HumanEval/57", "solution": "```python\ndef monotonic(l: list) -> bool:\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    A list is monotonic if it is either entirely non-decreasing or entirely non-increasing.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if len(l) <= 1:\n        return True\n\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List elements must be numbers (int or float).\")\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing\n```"}
{"task_id": "HumanEval/59", "solution": "import math\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors by iterating up to the square root of n.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n\n    # If n remains greater than 2, it is the largest prime factor.\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor\n"}
{"task_id": "HumanEval/58", "solution": "from typing import List, Any\n\nclass ListUtils:\n    \"\"\"Utility methods for list and set operations.\n    Provides functions to get unique elements, sort lists, and intersect sets.\n    \"\"\"\n\n    @staticmethod\n    def get_unique_elements(input_list: List[Any]) -> set:\n        \"\"\"Converts a list to a set to efficiently obtain unique elements.\n        Elements in the input list must be hashable for set conversion.\n        \"\"\"\n        return set(input_list)\n\n    @staticmethod\n    def sort_list(input_list: List[Any]) -> List[Any]:\n        \"\"\"Sorts a given list in ascending order.\n        Elements in the input list must be comparable.\n        \"\"\"\n        return sorted(input_list)\n\n    @staticmethod\n    def intersect_sets(set1: set, set2: set) -> set:\n        \"\"\"Computes the intersection of two sets.\n        This operation efficiently finds elements common to both sets.\n        \"\"\"\n        return set1.intersection(set2)\n\nclass CommonElementsFinder:\n    \"\"\"Orchestrates finding unique, sorted common elements between two lists.\n    It leverages ListUtils for individual list and set operations.\n    \"\"\"\n\n    def find_common(self, l1: List[Any], l2: List[Any]) -> List[Any]:\n        \"\"\"\n        Return sorted unique common elements for two lists.\n        This method converts lists to sets for efficient intersection and then sorts the result.\n        \"\"\"\n        set1 = ListUtils.get_unique_elements(l1)\n        set2 = ListUtils.get_unique_elements(l2)\n        \n        common_set = ListUtils.intersect_sets(set1, set2)\n        \n        return ListUtils.sort_list(list(common_set))\n\ndef common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    finder = CommonElementsFinder()\n    return finder.find_common(l1, l2)"}
