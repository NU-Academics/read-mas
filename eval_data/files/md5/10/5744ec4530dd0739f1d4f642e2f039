{"task_id": "HumanEval/101", "solution": "import re\n\ndef words_string(s):\n    \"\"\"\n    Splits a string into words using commas or spaces as delimiters.\n    Handles multiple consecutive delimiters and filters empty strings.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Split by one or more commas or spaces, then filter out any empty strings.\n    words = re.split(r'[, ]+', s)\n    return [word for word in words if word]"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Checks if a bank account balance, starting at zero, ever falls below zero.\n    Returns True if the balance drops below zero at any point, False otherwise.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/30", "solution": "```python\nfrom typing import List, Union\n\nclass IFilterStrategy:\n    \"\"\"Interface for filtering strategies.\n    Defines the contract for any filtering strategy.\n    \"\"\"\n    def filter_numbers(self, numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n        raise NotImplementedError\n\nclass PositiveNumberFilter(IFilterStrategy):\n    \"\"\"A filter strategy to return only positive numbers from a list.\n    It implements the IFilterStrategy to retain only positive numbers.\n    \"\"\"\n    def filter_numbers(self, numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"Returns a new list containing only positive numbers from the input list.\n        It iterates through the input `numbers` and returns a new list.\n        \"\"\"\n        return [num for num in numbers if num > 0]\n\ndef get_positive(l: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Return only positive numbers in the list.\n    This function delegates the filtering task to PositiveNumberFilter.\n    \"\"\"\n    filter_strategy = PositiveNumberFilter()\n    return filter_strategy.filter_numbers(l)\n```"}
{"task_id": "HumanEval/66", "solution": "```python\ndef digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of only uppercase English letters in the input string.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum\n```"}
{"task_id": "HumanEval/105", "solution": "```python\ndef by_length(arr):\n    \"\"\"\n    Filters integers between 1-9, sorts them, reverses, and converts to English names.\n    Ignores out-of-range or non-integer elements as per specification.\n    \"\"\"\n    if not arr:\n        return []\n\n    MIN_DIGIT = 1\n    MAX_DIGIT = 9\n    DIGIT_NAMES = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    filtered_arr = []\n    for num in arr:\n        if isinstance(num, int) and MIN_DIGIT <= num <= MAX_DIGIT:\n            filtered_arr.append(num)\n\n    filtered_arr.sort()\n    filtered_arr.reverse()\n\n    result_names = [DIGIT_NAMES[digit] for digit in filtered_arr]\n\n    return result_names\n```"}
{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char in s:\n            # Convert char to int and check for oddness.\n            digit = int(char)\n            if digit % 2 != 0:\n                odd_digit_count += 1\n        \n        # Format the output string using the specified pattern.\n        formatted_string = (\n            f'the number of odd elements {odd_digit_count}n the str'\n            f'{odd_digit_count}ng {odd_digit_count} of the {odd_digit_count}nput.'\n        )\n        results.append(formatted_string)\n    return results\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\nclass InvalidInputFormatException(ValueError):\n    \"\"\"Custom exception for invalid fruit distribution input string format.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass FruitParser:\n    \"\"\"Parses fruit counts from a string using a predefined regex pattern.\"\"\"\n    FRUIT_PATTERN = re.compile(r\"(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges\")\n\n    @staticmethod\n    def parse_fruit_string(s: str) -> tuple[int, int]:\n        \"\"\"\n        Parses the input string to extract integer counts of apples and oranges.\n        Raises InvalidInputFormatException on parsing failure.\n        \"\"\"\n        match = FruitParser.FRUIT_PATTERN.match(s)\n        if not match:\n            raise InvalidInputFormatException(\n                f\"Input string '{s}' does not match expected format 'X apples and Y oranges'.\"\n            )\n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n            return apples, oranges\n        except ValueError as e:\n            raise InvalidInputFormatException(\n                f\"Could not parse fruit counts from string '{s}'. Details: {e}\"\n            ) from e\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket given counts of apples and oranges\n    in a string, and the total number of fruits.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Total fruit count 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Total fruit count 'n' cannot be negative.\")\n\n    apples, oranges = FruitParser.parse_fruit_string(s)\n\n    # Regex ensures non-negative integer counts; this check serves as a general safeguard.\n    if apples < 0 or oranges < 0:\n        raise ValueError(\"Apple and orange counts cannot be negative.\")\n\n    total_known_fruits = apples + oranges\n    if total_known_fruits > n:\n        raise ValueError(\n            f\"Sum of apples ({apples}) and oranges ({oranges}) \"\n            f\"exceeds total fruits ({n}).\"\n        )\n\n    return n - total_known_fruits\n```"}
