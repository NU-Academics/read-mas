{"task_id": "HumanEval/103", "solution": "```python\nimport math\nfrom typing import Union\n\ndef rounded_avg(n: int, m: int) -> Union[str, int]:\n    \"\"\"Computes the average of integers from n through m, rounds it, and converts to binary.\n    Returns -1 if n is greater than m.\"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the sum of integers using the arithmetic progression formula.\n    count = m - n + 1\n    sum_of_range = (count * (n + m)) // 2\n\n    # Compute the average and round to the nearest integer.\n    average = sum_of_range / count\n    rounded_average = round(average)\n\n    # Convert the rounded average to its binary string representation.\n    return bin(rounded_average)\n```"}
{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \n    Note: Returned list should be sorted in increasing order.\n    \"\"\"\n    \n    # Define the set of even digits for efficient lookup.\n    EVEN_DIGITS = {0, 2, 4, 6, 8}\n\n    filtered_list = []\n    for number in x:\n        # Check if the current number contains any even digit.\n        has_even = False\n        num_str = str(number)\n        for digit_char in num_str:\n            if int(digit_char) in EVEN_DIGITS:\n                has_even = True\n                break # An even digit was found, no need to check further.\n        \n        if not has_even:\n            filtered_list.append(number)\n            \n    filtered_list.sort()\n    return filtered_list\n```"}
{"task_id": "HumanEval/103", "solution": "```python\nfrom typing import Union\n\nclass AverageCalculator:\n    \"\"\"Handles arithmetic operations for average calculation, including sum, count, and rounding.\"\"\"\n    def calculate_sum(self, n: int, m: int) -> int:\n        \"\"\"Calculates the sum of integers from n to m using the arithmetic series formula.\"\"\"\n        count = m - n + 1\n        return (count * (n + m)) // 2\n\n    def calculate_count(self, n: int, m: int) -> int:\n        \"\"\"Calculates the number of integers in the range [n, m].\"\"\"\n        return m - n + 1\n\n    def calculate_average(self, n: int, m: int) -> float:\n        \"\"\"Computes the floating-point average of integers in the range [n, m].\"\"\"\n        total_sum = self.calculate_sum(n, m)\n        count = self.calculate_count(n, m)\n        return total_sum / count\n\n    def round_average(self, avg: float) -> int:\n        \"\"\"Rounds a floating-point average to the nearest integer using standard rules.\"\"\"\n        return round(avg)\n\nclass BinaryConverter:\n    \"\"\"Converts integers to their binary string representation.\"\"\"\n    def to_binary_string(self, value: int) -> str:\n        \"\"\"Returns the binary string for an integer, including the '0b' prefix.\"\"\"\n        return bin(value)\n\nclass RoundedAverageService:\n    \"\"\"Orchestrates the computation of the rounded binary average, handling validation and delegation.\"\"\"\n    def __init__(self, calculator: AverageCalculator, converter: BinaryConverter):\n        \"\"\"Initializes the service with calculator and converter dependencies.\"\"\"\n        self.calculator = calculator\n        self.converter = converter\n\n    def compute_rounded_binary_average(self, n: int, m: int) -> Union[int, str]:\n        \"\"\"Validates inputs, calculates the rounded average, and converts it to a binary string.\"\"\"\n        if n > m:\n            return -1\n\n        avg_float = self.calculator.calculate_average(n, m)\n        rounded_int = self.calculator.round_average(avg_float)\n        return self.converter.to_binary_string(rounded_int)\n\ndef rounded_avg(n: int, m: int) -> Union[int, str]:\n    \"\"\"\n    You are given two positive integers n and m, and your task is to compute the\n    average of the integers from n through m (including n and m). \n    Round the answer to the nearest integer and convert that to binary.\n    If n is greater than m, return -1.\n    Example:\n    rounded_avg(1, 5) => \"0b11\"\n    rounded_avg(7, 5) => -1\n    rounded_avg(10, 20) => \"0b1111\"\n    rounded_avg(20, 33) => \"0b11010\"\n    \"\"\"\n    calculator = AverageCalculator()\n    converter = BinaryConverter()\n    service = RoundedAverageService(calculator, converter)\n    return service.compute_rounded_binary_average(n, m)\n```"}
{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Filters a list of positive integers, returning a sorted list of numbers with only odd digits. The final list is sorted in increasing order.\n    \"\"\"\n\n    def has_only_odd_digits(number: int) -> bool:\n        \"\"\"Checks if all digits in the given number are odd. Assumes number is a positive integer.\n        \"\"\"\n        # Handles 0, though problem implies positive integers (number > 0).\n        if number == 0:\n            return False\n        \n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return False\n            temp_num //= 10\n        return True\n\n    filtered_list = []\n    for number in x:\n        if has_only_odd_digits(number):\n            filtered_list.append(number)\n    \n    filtered_list.sort()\n    return filtered_list\n```"}
