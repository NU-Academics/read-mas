{"task_id": "HumanEval/144", "solution": "```python\nclass MathUtils:\n    \"\"\"Provides common mathematical utility functions.\"\"\"\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\nclass Fraction:\n    \"\"\"Represents a mathematical fraction and provides methods for basic arithmetic.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self) -> int:\n        \"\"\"Returns the numerator of the fraction.\"\"\"\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        \"\"\"Returns the denominator of the fraction.\"\"\"\n        return self._denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object and returns a new product Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def simplify(self) -> 'Fraction':\n        \"\"\"Returns a new Fraction object representing this fraction in its simplest form.\"\"\"\n        common_divisor = MathUtils.gcd(self.numerator, self.denominator)\n        return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the simplified fraction represents a whole number.\"\"\"\n        simplified_fraction = self.simplify()\n        return simplified_fraction.denominator == 1\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two Fraction objects for equality.\"\"\"\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        return self.numerator == other.numerator and self.denominator == other.denominator\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation of the Fraction object.\"\"\"\n        return f\"Fraction({self.numerator}/{self.denominator})\"\n\nclass FractionService:\n    \"\"\"Provides business logic for parsing, multiplying, and checking if a fraction is a whole number.\"\"\"\n    @staticmethod\n    def parse_fraction(fraction_str: str) -> Fraction:\n        \"\"\"Parses a string representation of a fraction into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    @staticmethod\n    def multiply_fractions(f1: Fraction, f2: Fraction) -> Fraction:\n        \"\"\"Multiplies two Fraction objects.\"\"\"\n        return f1.multiply(f2)\n\n    @staticmethod\n    def is_product_whole_number(f1: Fraction, f2: Fraction) -> bool:\n        \"\"\"Determines if the product of two fractions is a whole number.\"\"\"\n        product = FractionService.multiply_fractions(f1, f2)\n        return product.is_whole_number()\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fractions is a whole number.\n    It parses fraction strings, multiplies them, and checks the product.\n    \"\"\"\n    fraction_x = FractionService.parse_fraction(x)\n    fraction_n = FractionService.parse_fraction(n)\n    return FractionService.is_product_whole_number(fraction_x, fraction_n)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where both first and last digits are odd (using absolute value).\"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a single digit is odd.\"\"\"\n        return digit in (1, 3, 5, 7, 9)\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of a number, considering its absolute value.\"\"\"\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of a number, considering its absolute value.\"\"\"\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[-1])\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/144", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Fraction:\n    numerator: int\n    denominator: int\n\n    def __repr__(self) -> str:\n        return f\"{self.numerator}/{self.denominator}\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        # Compares fractions by their unreduced numerator and denominator.\n        return self.numerator == other.numerator and self.denominator == other.denominator\n\nclass FractionParser:\n    def parse_fraction(self, fraction_str: str) -> Fraction:\n        # Splits the string by '/' and converts parts to integers to form a Fraction object.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\nclass FractionCalculator:\n    def multiply_fractions(self, f1: Fraction, f2: Fraction) -> Fraction:\n        # Multiplies two fractions by multiplying their numerators and denominators.\n        product_numerator = f1.numerator * f2.numerator\n        product_denominator = f1.denominator * f2.denominator\n        return Fraction(product_numerator, product_denominator)\n\n    def is_whole_number(self, f: Fraction) -> bool:\n        # Checks if a fraction represents a whole number using the modulo operator.\n        return f.numerator % f.denominator == 0\n\nclass SimplifyService:\n    def __init__(self, parser: FractionParser, calculator: FractionCalculator):\n        self.parser = parser\n        self.calculator = calculator\n\n    def simplify(self, x: str, n: str) -> bool:\n        # Orchestrates parsing fraction strings, multiplying them, and checking if the product is a whole number.\n        fraction_x = self.parser.parse_fraction(x)\n        fraction_n = self.parser.parse_fraction(n)\n        \n        product_fraction = self.calculator.multiply_fractions(fraction_x, fraction_n)\n        \n        return self.calculator.is_whole_number(product_fraction)\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    parser = FractionParser()\n    calculator = FractionCalculator()\n    simplify_service = SimplifyService(parser, calculator)\n    \n    return simplify_service.simplify(x, n)\n```"}
