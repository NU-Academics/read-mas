{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List, Dict, Tuple\n\n# Defines the canonical mapping of ASCII musical note patterns to their beat durations.\n_RAW_NOTE_MAPPINGS: Dict[str, int] = {\n    'o|': 2,  # Half note\n    '.|': 1,  # Quarter note\n    'o': 4,   # Whole note\n}\n\n# Pre-sorts the mappings by key length in descending order for efficient parsing.\n# This ensures longer patterns like 'o|' are checked before shorter ones like 'o'.\n_SORTED_NOTE_MAPPINGS: List[Tuple[str, int]] = sorted(\n    _RAW_NOTE_MAPPINGS.items(), key=lambda item: len(item[0]), reverse=True\n)\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a string representing musical notes in a special ASCII format\n    and returns a list of integers corresponding to how many beats each note lasts.\n    \"\"\"\n    if not isinstance(music_string, str):\n        raise TypeError(\"Input 'music_string' must be a string.\")\n\n    beat_durations: List[int] = []\n    i = 0\n    while i < len(music_string):\n        matched = False\n        for pattern, beats in _SORTED_NOTE_MAPPINGS:\n            if music_string.startswith(pattern, i):\n                beat_durations.append(beats)\n                i += len(pattern)\n                matched = True\n                break\n        \n        if not matched:\n            # Ignores unidentifiable note patterns or characters by skipping one.\n            i += 1\n            \n    return beat_durations\n```"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n\nclass NumberWordMapper:\n    \"\"\"Manages the mapping between number words and their integer values.\"\"\"\n    NUMBER_WORD_MAP: dict[str, int] = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n    }\n    INT_TO_WORD_MAP: dict[int, str] = {v: k for k, v in NUMBER_WORD_MAP.items()}\n\n    def get_int(self, word: str) -> int:\n        \"\"\"Returns the integer value for a given number word.\"\"\"\n        if word not in self.NUMBER_WORD_MAP:\n            raise ValueError(f\"Invalid number word: {word}\")\n        return self.NUMBER_WORD_MAP[word]\n\n    def get_word(self, integer: int) -> str:\n        \"\"\"Returns the number word for a given integer value.\"\"\"\n        if integer not in self.INT_TO_WORD_MAP:\n            raise ValueError(f\"Invalid integer for number word: {integer}\")\n        return self.INT_TO_WORD_MAP[integer]\n\nclass StringUtil:\n    \"\"\"Provides utility methods for common string operations.\"\"\"\n    def split_string(self, input_string: str) -> list[str]:\n        \"\"\"Splits a string by spaces into a list of substrings.\"\"\"\n        return input_string.split(' ')\n\n    def join_strings(self, word_list: list[str]) -> str:\n        \"\"\"Joins a list of strings into a single space-delimited string.\"\"\"\n        return ' '.join(word_list)\n\nclass NumberWordSorter:\n    \"\"\"Orchestrates the process of sorting a string of number words.\"\"\"\n    def __init__(self, mapper: NumberWordMapper, string_util: StringUtil):\n        self._mapper = mapper\n        self._string_util = string_util\n\n    def sort_number_words(self, input_string: str) -> str:\n        \"\"\"Sorts a space-delimited string of number words numerically.\"\"\"\n        if not input_string:\n            return \"\"\n\n        words = self._string_util.split_string(input_string)\n        \n        try:\n            integers = [self._mapper.get_int(word) for word in words]\n        except ValueError as e:\n            raise ValueError(f\"Error converting word to integer: {e}\") from e\n\n        integers.sort()\n        \n        sorted_words = [self._mapper.get_word(i) for i in integers]\n        \n        return self._string_util.join_strings(sorted_words)\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest.\n    \"\"\"\n    mapper = NumberWordMapper()\n    string_util = StringUtil()\n    sorter = NumberWordSorter(mapper, string_util)\n    return sorter.sort_number_words(numbers)"}
{"task_id": "HumanEval/20", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"Identifies and returns the two numerically closest elements from the input list.\n    The function handles input validation and returns the pair ordered from smallest to largest.\"\"\"\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n\n    MIN_LIST_LENGTH = 2\n    if len(numbers) < MIN_LIST_LENGTH:\n        raise ValueError(f\"Input list must contain at least {MIN_LIST_LENGTH} elements.\")\n\n    # Pre-validate all elements to ensure they are numeric (int or float).\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    # Sort the list to find the closest pair in O(N log N) time.\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0)\n\n    for i in range(len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i+1]\n\n        current_diff = abs(float(num2) - float(num1))\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (float(num1), float(num2))\n\n    return closest_pair\n```"}
