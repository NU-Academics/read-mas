{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be a number.\")\n    if number < 0:\n        raise ValueError(\"Input number must be positive.\")\n    return number - math.floor(number)"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating-point number, it returns its decimal part.\n    Raises ValueError for negative input and TypeError for non-numeric input.\n\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be a number (int or float).\")\n    if number < 0:\n        raise ValueError(\"Input number must be positive or zero.\")\n    return number - int(number)\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Checks if any two numbers in the list are closer to each other than the given threshold.\n    Raises ValueError if the threshold is not a positive float.\n    \"\"\"\n    if not isinstance(threshold, (int, float)) or threshold <= 0:\n        raise ValueError(\"Threshold must be a positive floating-point number.\")\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates multiple groups of nested parentheses into separate strings.\n    Separate groups are balanced and not nested within each other, ignoring spaces.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    result_groups: List[str] = []\n    balance_counter = 0\n    current_group_start = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance_counter == 0:\n                current_group_start = i\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        if balance_counter == 0 and current_group_start != -1:\n            # Found a top-level balanced group.\n            result_groups.append(cleaned_string[current_group_start : i + 1])\n            current_group_start = -1 # Reset for the next group.\n        elif balance_counter < 0:\n            # Unbalanced closing parenthesis, reset counters.\n            balance_counter = 0\n            current_group_start = -1\n    \n    return result_groups\n```"}
{"task_id": "HumanEval/3", "solution": "```python\nfrom typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Checks if a bank account balance, starting at zero, ever falls below zero given a list of operations.\n    Returns True if the balance falls below zero at any point, False otherwise.\n    \"\"\"\n    if not isinstance(operations, list):\n        raise ValueError(\"Input 'operations' must be a list.\")\n\n    current_balance = 0\n\n    for i, operation in enumerate(operations):\n        if not isinstance(operation, int):\n            raise ValueError(f\"Operation at index {i} is not an integer: {operation}\")\n        \n        current_balance += operation\n        \n        if current_balance < 0:\n            return True\n            \n    return False\n```"}
