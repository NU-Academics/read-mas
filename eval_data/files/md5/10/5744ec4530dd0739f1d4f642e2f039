{"task_id": "HumanEval/91", "solution": "```python\nimport re\n\nclass SentenceSplitter:\n    \"\"\"Utility class for splitting text into sentences.\"\"\"\n\n    @staticmethod\n    def split(text: str, delimiters: list[str]) -> list[str]:\n        \"\"\"\n        Splits the input text into a list of sentences based on provided delimiters.\n        Handles multiple delimiters and filters out empty strings.\n        \"\"\"\n        if not text:\n            return []\n\n        # Create a regex pattern for splitting.\n        # Escape delimiters and join them with '|' for OR.\n        pattern = '|'.join(re.escape(d) for d in delimiters)\n        sentences = re.split(f'[{pattern}]', text)\n\n        # Filter out empty strings and strip whitespace from each sentence.\n        return [s.strip() for s in sentences if s.strip()]\n\n\nclass SentenceCounter:\n    \"\"\"\n    Counts sentences that start with the word 'I' (case-insensitive).\n    \"\"\"\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def is_bored(self, S: str) -> int:\n        \"\"\"\n        Given a string S, counts the number of sentences that start with the word 'I'.\n        Sentences are delimited by '.', '?' or '!'.\n        \"\"\"\n        if not isinstance(S, str):\n            raise TypeError(\"Input S must be a string.\")\n\n        if not S:\n            return 0\n\n        sentences = SentenceSplitter.split(S, self.SENTENCE_DELIMITERS)\n        bored_count = 0\n        for sentence in sentences:\n            if self._starts_with_i(sentence):\n                bored_count += 1\n        return bored_count\n\n    def _starts_with_i(self, sentence: str) -> bool:\n        \"\"\"\n        Checks if a sentence starts with 'I' (case-insensitive), ignoring leading whitespace.\n        \"\"\"\n        # Strip leading whitespace and check if it starts with 'I' and is a word.\n        cleaned_sentence = sentence.lstrip()\n        if cleaned_sentence.lower().startswith('i') and \\\n           (len(cleaned_sentence) == 1 or not cleaned_sentence[1].isalpha()):\n            return True\n        return False\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    \"\"\"\n    counter = SentenceCounter()\n    return counter.is_bored(S)\n```"}
