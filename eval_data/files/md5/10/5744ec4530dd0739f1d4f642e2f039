{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\nclass ParenValidator:\n    @staticmethod\n    def is_balanced(s: str) -> bool:\n        stack = []\n        for char in s:\n            if char == '(':\n                stack.append(char)\n            elif char == ')':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\nclass ParenGroupSeparator:\n    def separate_groups(self, paren_string: str) -> List[str]:\n        cleaned_string = paren_string.replace(\" \", \"\")\n        if not cleaned_string:\n            return []\n\n        groups = []\n        balance_count = 0\n        start_index = 0\n\n        for i, char in enumerate(cleaned_string):\n            if char == '(':\n                balance_count += 1\n            elif char == ')':\n                balance_count -= 1\n\n            if balance_count == 0 and start_index <= i:\n                # Found a top-level balanced group.\n                current_group = cleaned_string[start_index : i + 1]\n                # Double check balance for robustness, although balance_count == 0 implies it.\n                if ParenValidator.is_balanced(current_group):\n                    groups.append(current_group)\n                start_index = i + 1\n            elif balance_count < 0:\n                # Unbalanced closing parenthesis, reset and look for next group.\n                balance_count = 0\n                start_index = i + 1\n        \n        return groups\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string of parentheses into a list of individual, balanced, and non-nested groups.\n    Ignores spaces and returns an empty list for no valid groups.\n    \"\"\"\n    separator = ParenGroupSeparator()\n    return separator.separate_groups(paren_string)\n```"}
