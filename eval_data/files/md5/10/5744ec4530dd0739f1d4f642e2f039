{"task_id": "HumanEval/39", "solution": "```python\nfrom typing import Iterator\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        # Checks if a number is prime using trial division.\n        # Handles numbers less than 2 as non-prime efficiently.\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def _fibonacci_sequence_generator() -> Iterator[int]:\n        # Generates an infinite sequence of Fibonacci numbers starting 0, 1, 1, 2...\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    fib_gen = _fibonacci_sequence_generator()\n    prime_fib_count = 0\n        \n    # Skip the first Fibonacci number (0) as it's not prime.\n    next(fib_gen) \n\n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    It returns True if three distinct elements in the list sum to zero, False otherwise.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(l) < 3:\n        return False\n\n    l.sort() # Sorting the list allows for efficient two-pointer traversal.\n    n = len(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for 'i' to avoid redundant calculations for same value triplets.\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False\n```"}
{"task_id": "HumanEval/39", "solution": "```python\nfrom typing import Iterator\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\n\nclass FibonacciGenerator:\n    \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n\n    def generate_sequence(self) -> Iterator[int]:\n        \"\"\"Yields Fibonacci numbers starting from 0, 1, 1, 2, ...\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\nclass PrimalityChecker:\n    \"\"\"Checks if a given number is prime efficiently.\"\"\"\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Determines if a number is prime using trial division up to its square root.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\nclass PrimeFibCalculator:\n    \"\"\"Calculates the Nth number that is both a Fibonacci number and a prime.\"\"\"\n\n    def __init__(self, fib_generator: FibonacciGenerator, primality_checker: PrimalityChecker):\n        \"\"\"Initializes with dependencies for Fibonacci generation and primality checking.\"\"\"\n        self._fib_generator = fib_generator\n        self._primality_checker = primality_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th Fibonacci number that is also prime.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        prime_fib_count = 0\n        for fib_num in self._fib_generator.generate_sequence():\n            # 0 and 1 are Fibonacci but not prime by definition.\n            if fib_num <= 1:\n                continue\n            if self._primality_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciGenerator()\n    primality_checker = PrimalityChecker()\n    calculator = PrimeFibCalculator(fib_generator, primality_checker)\n    return calculator.find_nth_prime_fib(n)\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Uses a sorting and two-pointer approach for efficiency.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to efficiently use the two-pointer technique.\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first pointer to avoid redundant calculations.\n        if i > 0 and sorted_l[i] == sorted_l[i-1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False\n```"}
