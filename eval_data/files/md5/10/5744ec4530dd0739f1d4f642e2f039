{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Checks if 'a' is a product of exactly three prime numbers.\n    Returns True if so, False otherwise, for positive integers less than 100.\"\"\"\n\n    def _is_prime(n):\n        \"\"\"Helper to check if a number is prime.\n        Returns True if prime, False otherwise.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    # Numbers outside the valid range (1, 100) are not considered.\n    if a <= 1 or a >= 100:\n        return False\n\n    primes = []\n    # Collect all primes less than 'a' for factoring.\n    for i in range(2, a):\n        if _is_prime(i):\n            primes.append(i)\n\n    # Iterate through combinations of three primes (p1 <= p2 <= p3).\n    for p1 in primes:\n        if p1 * p1 * p1 > a: # Optimization: p1 cubed cannot exceed 'a'.\n            break\n        for p2 in primes:\n            if p2 < p1: # Ensure p2 is at least p1.\n                continue\n            if p1 * p2 * p2 > a: # Optimization: p1 * p2 squared cannot exceed 'a'.\n                break\n            for p3 in primes:\n                if p3 < p2: # Ensure p3 is at least p2.\n                    continue\n                product = p1 * p2 * p3\n                if product == a:\n                    return True\n                if product > a: # Optimization: if product exceeds 'a', no larger p3 will work.\n                    break\n    \n    return False\n```"}
{"task_id": "HumanEval/75", "solution": "```python\nfrom itertools import combinations\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer n is a prime number.\n    Raises TypeError if n is not an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef _get_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates a list of all prime numbers strictly less than limit.\n    Raises TypeError if limit is not an integer.\"\"\"\n    if not isinstance(limit, int):\n        raise TypeError(\"Limit must be an integer.\")\n    if limit < 2:\n        return []\n    primes = []\n    for i in range(2, limit):\n        if _is_prime(i):\n            primes.append(i)\n    return primes\n\nMAX_INPUT_VALUE = 99\n\ndef is_multiply_prime(a) -> bool:\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if not isinstance(a, int):\n        raise TypeError(\"Input 'a' must be an integer.\")\n    if not (0 < a <= MAX_INPUT_VALUE):\n        raise ValueError(f\"Input 'a' must be between 1 and {MAX_INPUT_VALUE} (inclusive).\")\n\n    primes = _get_primes_up_to(a)\n    \n    if len(primes) < 3:\n        return False\n\n    for combo in combinations(primes, 3):\n        p1, p2, p3 = combo\n        if p1 * p2 * p3 == a:\n            return True\n            \n    return False\n```"}
{"task_id": "HumanEval/76", "solution": "```python\nimport math\n\nFLOAT_TOLERANCE = 1e-9\n\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple integer power of n (n^k = x for non-negative int k).\n    Handles edge cases like x=1, n=1, and non-positive inputs gracefully.\n    \"\"\"\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    if x <= 0 or n <= 0:\n        return False\n\n    try:\n        power = math.log(x, n)\n        return abs(power - round(power)) < FLOAT_TOLERANCE\n    except ValueError:\n        return False\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    \"\"\"Checks if an integer is a perfect cube. Handles positive, negative, and zero inputs.\"\"\"\n    if a == 0:\n        return True\n    \n    sign = 1 if a >= 0 else -1\n    # Calculate cube root of absolute value and round to nearest integer for precision.\n    root = round(abs(a)**(1/3))\n    \n    # Verify by cubing the rounded root and re-applying the original sign.\n    return (root * root * root * sign) == a\n```"}
{"task_id": "HumanEval/76", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some non-negative integer k.\"\"\"\n    \n    if not isinstance(x, int) or not isinstance(n, int):\n        raise TypeError(\"Inputs x and n must be integers.\")\n    \n    if x < 1 or n < 1:\n        raise InvalidInputError(\"Inputs x and n must be greater than or equal to 1.\")\n\n    if x == 1:\n        return True\n    \n    if n == 1:\n        return False\n\n    while x % n == 0:\n        x //= n\n    \n    return x == 1\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root using floating-point, then round to the nearest integer.\n    # This mitigates floating-point inaccuracies and correctly handles both positive and negative bases after abs().\n    root = round(abs(a)**(1/3))\n\n    # Check if the cube of the integer root matches the original number, preserving the sign.\n    if a > 0:\n        return root * root * root == a\n    else:  # a < 0\n        return -root * -root * -root == a\n```"}
