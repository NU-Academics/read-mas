{"task_id": "HumanEval/112", "solution": "```python\ndef reverse_delete(s, c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    \n    result_s_chars = []\n    for char_s in s:\n        if char_s not in c:\n            result_s_chars.append(char_s)\n    \n    result_s = \"\".join(result_s_chars)\n    is_palindrome = result_s == result_s[::-1]\n    \n    return (result_s, is_palindrome)\n```"}
{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst):\n    \"\"\"\n    Counts odd digits in each string of a list and formats the results.\n    Each string in the input list must consist solely of digits.\n    \"\"\"\n\n    def _is_odd(digit_char: str) -> bool:\n        \"\"\"Checks if a single digit character represents an odd number.\"\"\"\n        return int(digit_char) % 2 != 0\n\n    def _format_output_string(count: int) -> str:\n        \"\"\"Formats the output string with the given odd digit count.\"\"\"\n        return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char in s:\n            if _is_odd(char):\n                odd_digit_count += 1\n        results.append(_format_output_string(odd_digit_count))\n    return results\n```"}
{"task_id": "HumanEval/114", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to minSubArraySum.\n    It inherits from ValueError to indicate an issue with argument values.\"\"\"\n    pass\n\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This function uses a dynamic programming approach (Kadane's algorithm variation) for O(n) complexity.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise InvalidInputError(\"Input 'nums' must be a list.\")\n    if not nums:\n        raise InvalidInputError(\"Input 'nums' cannot be empty for non-empty sub-array sum.\")\n    if not all(isinstance(x, int) for x in nums):\n        raise InvalidInputError(\"All elements in 'nums' must be integers.\")\n\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far\n```"}
{"task_id": "HumanEval/114", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to min_sub_array_sum function.\"\"\"\n    def __init__(self, message=\"Invalid input provided.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    if not isinstance(nums, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not nums:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n    for item in nums:\n        if not isinstance(item, int):\n            raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    min_so_far = float('inf')\n    current_min = 0\n\n    for num in nums:\n        current_min += num\n        min_so_far = min(min_so_far, current_min)\n        # If current_min becomes positive, starting a new subarray might yield a smaller sum.\n        if current_min > 0:\n            current_min = 0\n            \n    return min_so_far\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"\n    Given a string s and a natural number n, returns a list of all words from string s\n    that contain exactly n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    if not s:\n        return []\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\n        Non-alphabetic characters are ignored based on problem assumptions.\n        \"\"\"\n        consonant_count = 0\n        for char in word:\n            char_lower = char.lower()\n            if 'a' <= char_lower <= 'z' and char_lower not in VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_words.append(word)\n            \n    return result_words\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers by set bit count, then by decimal value.\n    Returns a new sorted array without modifying the original.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    return sorted(arr, key=lambda x: (bin(abs(x)).count('1'), x))\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"\n    Filters words from a string that contain exactly n consonants.\n    Returns a list of matching words in their original order.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\" # Defines English vowels for consonant counting.\n\n    if not s.strip(): # Handles empty or whitespace-only input strings.\n        return []\n\n    words = s.split() # Splits the input string into individual words by whitespace.\n    result = []\n    for word in words:\n        consonant_count = 0\n        for char in word: # Iterates through each character to count consonants.\n            if char.isalpha() and char not in VOWELS:\n                consonant_count += 1\n        \n        if consonant_count == n: # Appends word to result if consonant count matches n.\n            result.append(word)\n            \n    return result\n```"}
