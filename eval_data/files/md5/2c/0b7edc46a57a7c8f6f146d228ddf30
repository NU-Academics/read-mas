{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the KMP prefix function (LPS array) to find the smallest repeating unit.\n    \"\"\"\n    n = len(s)\n    \n    # KMP prefix function computation (LPS array)\n    lps = [0] * n\n    length = 0\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n    \n    # The length of the longest proper prefix of s that is also a suffix of s.\n    # This value indicates the length of the repeated unit.\n    k = n - lps[n - 1]\n    \n    # If n is perfectly divisible by k, then k is the minimum rotation.\n    # Otherwise, the string does not repeat itself with a unit shorter than its full length,\n    # so n rotations are required.\n    return k if n % k == 0 else n"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, List\n\ndef similar_elements(a: Iterable[Any], b: Iterable[Any], keep_order: bool = True) -> List[Any]:\n    list_a = list(a)\n    list_b = list(b)\n\n    if len(list_a) <= len(list_b):\n        set_a = set(list_a)\n        intersection_set = set_a.intersection(list_b)\n    else:\n        set_b = set(list_b)\n        intersection_set = set_b.intersection(list_a)\n\n    if keep_order:\n        result = []\n        seen = set()\n        for x in list_a:\n            if x in intersection_set and x not in seen:\n                result.append(x)\n                seen.add(x)\n        return result\n    else:\n        try:\n            return sorted(intersection_set)\n        except TypeError:\n            return list(intersection_set)"}
{"task_id": "Mbpp/11", "solution": "import time\nfrom collections import deque\nfrom typing import Protocol\n\nclass InvalidCharacterError(ValueError):\n    \"\"\"Raised when the character to remove is invalid.\"\"\"\n    pass\n\nclass ValidationError(ValueError):\n    \"\"\"Raised for generic validation errors.\"\"\"\n    pass\n\nclass RemoveRequest:\n    \"\"\"Data transfer object for remove operation request.\"\"\"\n    def __init__(self, input_string: str, char: str) -> None:\n        self.input_string = input_string\n        self.char = char\n\nclass RemoveResponse:\n    \"\"\"Data transfer object for remove operation response.\"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\n\nclass OperationRecord:\n    \"\"\"Record of a completed operation.\"\"\"\n    def __init__(self, timestamp: float, input_string: str, char: str, result: str) -> None:\n        self.timestamp = timestamp\n        self.input_string = input_string\n        self.char = char\n        self.result = result\n\nclass HistoryRepository(Protocol):\n    \"\"\"Interface for an operation history repository.\"\"\"\n    def save(self, record: OperationRecord) -> None:\n        ...\n\n    def get_recent(self, limit: int) -> list[OperationRecord]:\n        ...\n\nclass InMemoryHistoryRepository(HistoryRepository):\n    \"\"\"In-memory implementation of HistoryRepository.\"\"\"\n    DEFAULT_MAX_HISTORY = 100\n\n    def __init__(self, max_records: int = DEFAULT_MAX_HISTORY) -> None:\n        self._max_records = max_records\n        self._records = deque(maxlen=max_records)\n\n    def save(self, record: OperationRecord) -> None:\n        self._records.append(record)\n\n    def get_recent(self, limit: int) -> list[OperationRecord]:\n        return list(self._records)[-limit:]\n\nclass Validator:\n    \"\"\"Validates RemoveRequest objects.\"\"\"\n    def validate_request(self, request: RemoveRequest) -> None:\n        if not isinstance(request.input_string, str):\n            raise TypeError(\"Input string must be a string.\")\n        if not isinstance(request.char, str):\n            raise TypeError(\"Character to remove must be a string.\")\n        if not request.char:\n            raise InvalidCharacterError(\"Character to remove cannot be empty.\")\n        if len(request.char) != 1:\n            raise InvalidCharacterError(\"Character to remove must be a single character.\")\n\ndef remove_first_last(s: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character occurs once, only that occurrence is removed.\n    \"\"\"\n    first = s.find(ch)\n    if first == -1:\n        return s\n    last = s.rfind(ch)\n    if first == last:\n        return s[:first] + s[first+1:]\n    return s[:first] + s[first+1:last] + s[last+1:]\n\nclass RemoveOccurrenceService:\n    \"\"\"Orchestrates removal of character and records the operation.\"\"\"\n    def __init__(self, repository: HistoryRepository, validator: Validator) -> None:\n        self._repository = repository\n        self._validator = validator\n\n    def remove(self, request: RemoveRequest) -> RemoveResponse:\n        self._validator.validate_request(request)\n        result = remove_first_last(request.input_string, request.char)\n        record = OperationRecord(time.time(), request.input_string, request.char, result)\n        try:\n            self._repository.save(record)\n        except Exception:\n            # In a real system, this would be logged. For now, swallow error to prevent crashing.\n            pass\n        return RemoveResponse(result)\n\ndef create_default_service() -> RemoveOccurrenceService:\n    \"\"\"Creates a default RemoveOccurrenceService instance with in-memory history.\"\"\"\n    repo = InMemoryHistoryRepository()\n    validator = Validator()\n    return RemoveOccurrenceService(repo, validator)\n\ndef remove_Occ(s: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Delegates to an internal service that handles validation and history recording.\n    \"\"\"\n    svc = create_default_service()\n    req = RemoveRequest(s, ch)\n    return svc.remove(req).result"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ by exactly one bit position.\n\n    Returns True if the numbers' XOR sum is a positive power of two, False otherwise.\n    \"\"\"\n    xor_result = a ^ b\n    # A number differs at exactly one bit position if its XOR sum with the other number\n    # has exactly one bit set. This is equivalent to checking if the XOR sum is a power of two.\n    # The condition (xor_result > 0) ensures that identical numbers (xor_result == 0) return False.\n    return (xor_result > 0) and ((xor_result & (xor_result - 1)) == 0)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list of numbers, returned in descending order.\n    Uses a min-heap for efficiency when n is small, or sorting for larger n.\n    \"\"\"\n    HEAP_THRESHOLD = 1000\n\n    if n <= 0:\n        return []\n\n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n\n    if n < HEAP_THRESHOLD:\n        # Use a min-heap to keep track of the n largest elements\n        min_heap = []\n        for x in numbers:\n            if len(min_heap) < n:\n                heapq.heappush(min_heap, x)\n            elif x > min_heap[0]:\n                heapq.heapreplace(min_heap, x)\n        # The heap elements are not guaranteed to be sorted, so sort them in descending order.\n        return sorted(min_heap, reverse=True)\n    else:\n        # If n is large (closer to len(numbers)), sorting the whole list might be more efficient\n        # or comparable, and simpler.\n        return sorted(numbers, reverse=True)[:n]"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list) -> list:\n    \"\"\"\n    Computes the square of each element in a list of numbers.\n    \"\"\"\n    return [x * x for x in numbers]"}
