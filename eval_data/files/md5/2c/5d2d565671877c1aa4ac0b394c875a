{"task_id": "HumanEval/0", "solution": "from typing import List\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if any two numbers in the list are closer to each other than the given threshold.\n\n    Parameters\n    ----------\n    numbers : List[float]\n        List of numeric values to evaluate.\n    threshold : float\n        Minimum allowed distance between any two distinct elements.\n        If any pair of elements is closer than this value, returns True.\n\n    Returns\n    -------\n    bool\n        True if any pair of elements is closer than threshold, False otherwise.\n\n    Examples\n    --------\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to reduce comparisons: adjacent pairs are the only ones that can be\n    # closest after sorting.\n    sorted_vals = sorted(numbers)\n\n    for i in range(1, len(sorted_vals)):\n        if abs(sorted_vals[i] - sorted_vals[i - 1]) < threshold:\n            return True\n\n    return False\n"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separate a string containing multiple groups of nested parentheses into individual\n    balanced parentheses strings.\n\n    Parameters\n    ----------\n    paren_string : str\n        Input string containing groups of nested parentheses. Spaces are ignored.\n\n    Returns\n    -------\n    List[str]\n        A list of strings, each representing a balanced group of parentheses.\n\n    Examples\n    --------\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Remove all whitespace for easier processing\n    cleaned = paren_string.replace(' ', '')\n    result: List[str] = []\n    current: List[str] = []\n    depth = 0\n\n    for ch in cleaned:\n        if ch not in ('(', ')'):\n            continue\n\n        if ch == '(':\n            depth += 1\n        current.append(ch)\n\n        if ch == ')':\n            depth -= 1\n            # When depth returns to zero, we have completed a balanced group\n            if depth == 0:\n                result.append(''.join(current))\n                current = []\n\n    return result\n\n# Basic sanity check\nif __name__ == \"__main__\":\n    sample = \"( ) (( )) (( )( ))\"\n    print(separate_paren_groups(sample))\n    # Expected output: ['()', '(())', '(()())']"}
{"task_id": "HumanEval/2", "solution": "import math\nfrom typing import Union\n\ndef truncate_number(number: Union[int, float]) -> float:\n    \"\"\"Return the decimal part of a positive floating point number.\n\n    The decimal part is the fractional remainder after removing the\n    integer part of the number. The returned value is always between\n    0 (inclusive) and 1 (exclusive), or 0 if the input number has no\n    fractional component.\n\n    Examples\n    --------\n    >>> truncate_number(3.5)\n    0.5\n    >>> truncate_number(2)\n    0.0\n    >>> truncate_number(0.00123)\n    0.00123\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"truncate_number expects an int or float\")\n\n    if number < 0:\n        raise ValueError(\"truncate_number expects a non-negative number\")\n\n    # `math.modf` returns (fractional_part, integer_part)\n    fractional_part, _ = math.modf(number)\n    return fractional_part\n"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detect whether the account balance ever goes below zero.\n\n    The account starts with a zero balance. Each integer in ``operations`` represents a\n    deposit (positive) or withdrawal (negative). If at any point the accumulated\n    balance becomes negative, the function returns ``True``. If the balance never\n    goes below zero, the function returns ``False``.\n\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for amount in operations:\n        balance += amount\n        if balance < 0:\n            return True\n    return False\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    Calculate the Mean Absolute Deviation (MAD) of a list of numeric values.\n\n    MAD is defined as the average absolute difference between each value and the arithmetic mean of the list.\n\n    Parameters\n    ----------\n    numbers : List[float]\n        The list of numbers for which the MAD will be calculated.\n\n    Returns\n    -------\n    float\n        The mean absolute deviation of the input values.\n\n    Raises\n    ------\n    ValueError\n        If the input list is empty.\n\n    Examples\n    --------\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    >>> mean_absolute_deviation([5])\n    0.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"The input list 'numbers' must contain at least one element.\")\n\n    mean_val = sum(numbers) / len(numbers)\n    abs_diff_sum = sum(abs(x - mean_val) for x in numbers)\n    return abs_diff_sum / len(numbers)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n\n    Parameters\n    ----------\n    numbers : List[int]\n        List of integers to intersperse.\n    delimeter : int\n        The integer to insert between consecutive elements.\n\n    Returns\n    -------\n    List[int]\n        A new list with `delimeter` inserted between each pair of original elements.\n        If the input list is empty or has a single element, it is returned unchanged.\n\n    Examples\n    --------\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if len(numbers) <= 1:\n        return numbers.copy()\n\n    # Build the interleaved list by iterating over pairs of elements\n    result: List[int] = []\n    for i in range(len(numbers) - 1):\n        result.append(numbers[i])\n        result.append(delimeter)\n    result.append(numbers[-1])\n    return result\n\n\n# Unit tests\n\nimport unittest\n\n\nclass TestIntersperse(unittest.TestCase):\n    def test_empty(self):\n        self.assertEqual(intersperse([], 99), [])\n\n    def test_single_element(self):\n        self.assertEqual(intersperse([42], 0), [42])\n\n    def test_two_elements(self):\n        self.assertEqual(intersperse([1, 2], 5), [1, 5, 2])\n\n    def test_multiple_elements(self):\n        self.assertEqual(intersperse([10, 20, 30, 40], 0), [10, 0, 20, 0, 30, 0, 40])\n\n    def test_negative_delimiter(self):\n        self.assertEqual(intersperse([1, 2, 3], -1), [1, -1, 2, -1, 3])\n\n    def test_non_integer_numbers(self):\n        # Although the type hint expects int, test robustness\n        with self.assertRaises(TypeError):\n            intersperse(['a', 'b'], 1)\n\n    def test_non_integer_delimiter(self):\n        with self.assertRaises(TypeError):\n            intersperse([1, 2], 'x')\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    For each group of parentheses separated by spaces, return the maximum depth of nesting.\n\n    Args:\n        paren_string: A string containing groups of parentheses separated by whitespace.\n\n    Returns:\n        A list of integers where each integer is the deepest level of nesting\n        for the corresponding group.\n\n    Example:\n        >>> parse_nested_parens('(()()) ((())) () ((())()())')\n        [2, 3, 1, 3]\n    \"\"\"\n    def max_depth(group: str) -> int:\n        depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                depth += 1\n                if depth > max_depth:\n                    max_depth = depth\n            elif char == ')':\n                depth -= 1\n                if depth < 0:\n                    raise ValueError(f\"Unbalanced parentheses in group: {group!r}\")\n        if depth != 0:\n            raise ValueError(f\"Unbalanced parentheses in group: {group!r}\")\n        return max_depth\n\n    groups = paren_string.strip().split()\n    return [max_depth(group) for group in groups]"}
