e\n\n        def starts_with_i(self, sentence: Sentence) -> bool:\n            # Checks if a sentence starts with the exact word \"I\", respecting case sensitivity.\n            # It normalizes the start of the sentence by ignoring leading non-word characters.\n            normalized_text = sentence.text.strip()\n            \n            match = re.match(r\"^\\W*(\\w+)\", normalized_text)\n            \n            if not match:\n                return False\n            \n            first_actual_word = match.group(1)\n\n            if self._case_sensitive:\n                return first_actual_word == \"I\"\n            else:\n                return first_actual_word.lower() == \"i\"\n\n    # Inline definition of InMemoryBoredomRepository (from repository.py)\n    # This minimal repository is used to satisfy BoredomService's constructor,\n    # but actual persistence operations are skipped as `is_bored` does not persist.\n    class InMemoryBoredomRepository:\n        def __init__(self):\n            pass\n        def save(self, record):\n            return \"dummy_id\"\n        def get(self, id: str):\n            return None\n        def list(self, limit: int = 100):\n            return []\n\n    # Inline definition of BoredomService (from service.py)\n    class BoredomService:\n        def __init__(self, tokenizer: SentenceTokenizer, detector: IStartDetectorImpl,\n                     repo: Optional[InMemoryBoredomRepository], config: AppConfig):\n            self._tokenizer = tokenizer\n            self._detector = detector\n            self._repo = repo\n            self._config = config\n\n        def analyze(self, text: str, persist: bool = False) -> int:\n            \"\"\"Orchestrates tokenization, detection, and counts boredoms.\"\"\"\n            sentences = self._tokenizer.tokenize(text)\n            \n            boredom_count = 0\n            for sentence in sentences:\n                if self._detector.starts_with_i(sentence):\n                    boredom_count += 1\n            \n            # Persistence is controlled by `persist` parameter and `_config.persist`.\n            # For `is_bored`, `persist` is False and `_config.persist` is False by default,\n            # so the repository will not be used for saving.\n            return boredom_count\n\n    # Instantiate components with default settings for the convenience function.\n    default_config = AppConfig(case_sensitive=True, persist=False)\n    tokenizer = SentenceTokenizer()\n    detector = IStartDetectorImpl(case_sensitive=default_config.case_sensitive)\n    repo = InMemoryBoredomRepository() \n\n    service = BoredomService(tokenizer=tokenizer, detector=detector, repo=repo, config=default_config)\n\n    # Call the core analysis logic.\n    return service.analyze(S, persist=False)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}, {"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts the number of boredoms in a string. A boredom is a sentence that\n    starts with the word \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n\n    def _trim_and_get_first_token(s_content: str) -> str | None:\n        \"\"\"Helper to trim leading punctuation/whitespace and extract the first token.\"\"\"\n        s_content = s_content.lstrip()\n        # Trim common opening punctuation/quotes as per design rules.\n        # This list specifically excludes '.', '?', '!' so they are treated as content if present initially.\n        while s_content and s_content[0] in ('\"', \"'\", '(', '[', '{'):\n            s_content = s_content[1:].lstrip()\n        \n        if not s_content:\n            return None\n        return s_content.split(None, 1)[0]\n\n    boredom_count = 0\n    # Split the text into segments. The regex ensures the delimiter remains part\n    # of the preceding segment, and splits on any whitespace following a delimiter.\n    # An empty match at the start (e.