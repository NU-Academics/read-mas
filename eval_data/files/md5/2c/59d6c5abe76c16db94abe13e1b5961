/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of n, which is the product of k! for k from 1 to n.\n    This function computes n! * (n-1)! * ... * 1! iteratively.\n    \"\"\"\n    current_factorial = 1\n    special_factorial_result = 1\n    for k in range(1, n + 1):\n        current_factorial *= k  # Calculate k!\n        special_factorial_result *= current_factorial  # Multiply k! into the total product\n    return special_factorial_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/139", "solution": "_factorial_cache = {0: 1, 1: 1}\ndef _factorial_helper(k):\n    \"\"\"Computes k! using memoization by checking and updating a shared cache.\"\"\"\n    if k in _factorial_cache:\n        return _factorial_cache[k]\n\n    # Find the largest cached factorial less than k to compute incrementally\n    max_cached_k = max(c for c in _factorial_cache if c < k)\n    current_factorial_value = _factorial_cache[max_cached_k]\n\n    for i in range(max_cached_k + 1, k + 1):\n        current_factorial_value *= i\n        _factorial_cache[i] = current_factorial_value\n    return _factorial_cache[k]\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    brazilian_fact = 1\n    for k in range(1, n + 1):\n        k_fact = _factorial_helper(k)\n        brazilian_fact *= k_fact\n    return brazilian_fact", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}