ction should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:  # Check if the dictionary is empty\n        return False\n\n    def is_key_lower(key_str: str) -> bool:\n        \"\"\"\n        Determines if a string key adheres to lower-case rules.\n        Keys without cased characters (e.g., \"123\") are considered to match both lower and upper case rules.\n        \"\"\"\n        if not any(c.isalpha() for c in key_str):\n            return True\n        return key_str.islower()\n\n    def is_key_upper(key_str: str) -> bool:\n        \"\"\"\n        Determines if a string key adheres to upper-case rules.\n        Keys without cased characters (e.g., \"123\") are considered to match both lower and upper case rules.\n        \"\"\"\n        if not any(c.isalpha() for c in key_str):\n            return True\n        return key_str.isupper()\n\n    all_lower_case = True\n    all_upper_case = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):  # Check if all keys are strings\n            return False\n        \n        all_lower_case = all_lower_case and is_key_lower(key)\n        all_upper_case = all_upper_case and is_key_upper(key)\n\n    return all_lower_case or all_upper_case", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[{"p": "pineapple", "5": "banana", "a": "apple"}]], "plus_fail_tests": [[{"1": "apple", "2": "banana", "3": "cherry"}]]}, {"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if len(dict) == 0:\n        return False\n\n    all_keys_are_strings = True\n    for k in dict.keys():\n        if not isinstance(k, str):\n            all_keys_are_strings = False\n            break\n    if not all_keys_are_strings:\n        return False\n\n    alpha_groups = []\n    for k in dict.keys():\n        alpha_groups.append(\"\".join(ch for ch in k if ch.isalpha()))\n\n    has_alphabetic_chars = any(len(g) > 0 for g in alpha_groups)\n    if not has_alphabetic_chars:\n        return False\n\n    is_all_lower = True\n    for g in alpha_groups:\n        if len(g) > 0 and not (g.lower() == g):\n            is_all_lower = False\n            break\n\n    is_all_upper = True\n    for g in alpha_groups:\n        if len(g) > 0 and not (g.upper() == g):\n            is_all_upper = False\n            break\n\n    return is_all_lower or is_all_upper", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[{"p": "pineapple", "5": "banana", "a": "apple"}]], "plus_fail_tests": [[{"FIRST_NAME": "John", "LAST_NAME": "DOE", "AGE": 35, "CITY": "NK", "INCOME": "$50,000", "1": 35}]]}], "HumanEval/96": [{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array 'sieve' where sieve[i] is true if i is prime.\n    # Using bytearray for memory efficiency; 0 for not prime, 1 for prime.\n    sieve = bytearray(b\"\\x01\") * n\n    sieve[0:2] = b\"\\x00\\x00\"  # 0 and 1 are not prime.\n\n    # Iterate from 2 up to the square root of n.\n    for i in range(2, int(n**0.5) + 1):\n        if sieve[i]:  # If i is prime\n            # Mark all multiples of i (starting from i*i) as not prime.\n            # Multiples less than i*i would have already been marked by smaller primes.\n            for multiple in range(i * i, n, i):\n                sieve[multiple] = 0\n\n    # Collect all numbers that are marked as prime.\n    primes = [i for i, is_prime in enumerate(sieve) if is_prime]\n    return primes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/96", "solution": "from typing import List, Optional, Dict, Any\nclass ValidationError(Exception):\n    \"\"\"Custom exception for invalid input arguments.\"\"\"\n    pass\ndef validate_non_negative_int(value: Any) -> int:\n    \"\"\"Validates if the input is a non-negative integer.\"\"\"\n    if not isinstance(value, int):\n        raise ValidationError(\"Input must be an integer.\")\n    if value < 0:\n        raise ValidationError(\"Input must be a non-negative integer.\")\n    return value\nclass PrimeCalculator:\n    \"\"\"Calculates prime numbers using the Sieve of Eratosthenes.\"\"\"\n\n    @staticmethod\n    def sieve(n: int) -> List[int]:\n        \"\"\"Computes primes less than n using the Sieve of Eratosthenes.\"\"\"\n        if n <= 2:\n            return []\n        is_prime = bytearray(b'\\x01') * n\n        is_prime[0:2] = b'\\x00\\x00'\n\n        for p in range(2, int(n**0.5) + 1):\n            if is_prime[p]:\n                for multiple in range(p*p, n, p):\n                    is_prime[multiple] = b'\\x00'\n        \n        return [i for i, prime_flag in enumerate(is_prime) if prime_flag]\nclass PrimeRepository:\n    \"\"\"Manages an in-memory cache for prime number lists.\"\"\"\n\n    def __init__(self, persist: bool = False, path: Optional[str] = None):\n        \"\"\"Initializes an in-memory cache. Disk persistence is ignored for this context.\"\"\"\n        self._cache: Dict[str, List[int]] = {}\n        self._persist = False # Enforce no disk persistence for this inline version\n        self._path = None\n\n    def get(self, n: int) -> Optional[List[int]]:\n        \"\"\"Retrieves cached primes for a given n, or None if not found.\"\"\"\n        return self._cache.get(str(n))\n\n    def set(self, n: int, primes: List[int]) -> None:\n        \"\"\"Stores a list of primes for a given n in the cache.\"\"\"\n        self._cache[str(n)] = primes\nclass PrimeService:\n    \"\"\"Orchestrates prime number calculation, validation, and caching.\"\"\"\n\n    def __init__(self, repository: PrimeRepository, calculator: PrimeCalculator):\n        \"\"\"Initializes the service with a repository and calculator dependency.\"\"\"\n        self._repo = repository\n        self._calculator = calculator\n\n    def get_primes_less_than(self, n: int) -> List[int]:\n        \"\"\"Validates input, checks cache, calculates if necessary, and returns primes less than n.\"\"\"\n        n = validate_non_negative_int(n)\n\n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n\n        primes = self._calculator.sieve(n)\n        self._repo.set(n, primes)\n        return primes\n\n    def count_up_to(self, n: int) -> List[int]:\n        \"\"\"Alias for get_primes_less_than to match the requested function signature.\"\"\"\n        return self.get_primes_less_than(n)\n_default_repo = PrimeRepository(persist=False)\n_default_calc = PrimeCalculator()\n_default_service = PrimeService(_default_repo, _default_calc)\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    return _default_service.count_up_to(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[5]], "plus_fail_tests": [[12]]}], "HumanEval/97": [{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit 