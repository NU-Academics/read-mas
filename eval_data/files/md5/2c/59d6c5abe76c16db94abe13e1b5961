:\n            raise ValueError(\"Iterable is empty\")\n        for item in it:\n            if item > current_max:\n                current_max = item\n        return current_max\nclass MaxElementResult:\n    \"\"\"Data transfer object for the result of a max element computation.\"\"\"\n    def __init__(self, value: Any, computed_at: datetime):\n        self.value = value\n        self.computed_at = computed_at\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation of the result.\"\"\"\n        return {\"value\": self.value, \"computed_at\": self.computed_at.isoformat()}\nclass ListValidator:\n    \"\"\"Validates input lists before computation.\"\"\"\n    MIN_LIST_LENGTH = 1\n\n    def validate(self, l: Any) -> None:\n        \"\"\"Ensures the input is a non-empty, comparable list or tuple.\"\"\"\n        if not isinstance(l, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple\", \"TYPE_ERROR\")\n        if len(l) < self.MIN_LIST_LENGTH:\n            raise InvalidInputError(\"Input list must not be empty\", \"EMPTY\")\n        \n        # Check comparability of a small sample (first 3 elements)\n        if len(l) >= 2 and not self._elements_comparable_sample(l[:3]):\n            raise InvalidInputError(\"Elements are not mutually comparable\", \"NOT_COMPARABLE\")\n\n    def _elements_comparable_sample(self, elements: Sequence[Any]) -> bool:\n        \"\"\"Checks if elements in a sample can be compared without TypeError.\"\"\"\n        if len(elements) < 2:\n            return True\n        \n        for i in range(len(elements)):\n            for j in range(i + 1, len(elements)):\n                a, b = elements[i], elements[j]\n                try:\n                    _ = a < b\n                    _ = a > b\n                except TypeError:\n                    return False\n                except Exception: # Catch other potential comparison errors\n                    return False\n        return True\nclass MaxElementService:\n    \"\"\"Orchestrates validation and maximum element computation.\"\"\"\n    def __init__(self, validator: ListValidator, algorithm: CoreAlgorithm):\n        self.validator = validator\n        self.algorithm = algorithm\n\n    def compute_max_from_list(self, l: list) -> MaxElementResult:\n        \"\"\"Validates the list, computes its maximum element, and returns a result DTO.\"\"\"\n        self.validator.validate(l)\n        try:\n            value = self.algorithm.compute_max(l)\n        except ValueError as e:\n            # This case should ideally be caught by the validator's emptiness check.\n            raise InvalidInputError(str(e), \"EMPTY\")\n        return MaxElementResult(value=value, computed_at=datetime.utcnow())\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    validator = ListValidator()\n    algorithm = CoreAlgorithm()\n    service = MaxElementService(validator, algorithm)\n    \n    result = service.compute_max_from_list(l)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty sequence\")\n\n    max_val = l[0]\n    for item in l[1:]:\n        try:\n            if item > max_val:\n                max_val = item\n        except TypeError:\n            # Rely on standard Python TypeError for incomparable types.\n            raise TypeError(f\"unorderable types: {type(item).__name__}() > {type(max_val).__name__}()\") from None\n    return max_val", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/41": [{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Computes the number of collisions for n cars moving in opposite directions.\n    Each car from one set collides with every car from the other set.\n    \"\"\"\n    return n * n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Calculates the number of collisions between n left-to-right and n right-to-left cars.\n    Each car moving in one direction collides with every car moving in the opposite direction.\n    \"\"\"\n    return n * n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/40": [{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Uses a sorting and two-pointer approach for O(n^2) time complexity.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to efficiently use the two-pointer technique\n    nums_sorted = sorted(l)\n\n    # Iterate through each element as a potential first element of the triple\n    for i in range(n - 2):\n        # Initialize two pointers for the remaining part of the list\n        left, right = i + 1, n - 1\n\n        while left < right:\n            current_sum = nums_sorted[i] + nums_sorted[left] + nums_sorted[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                # Sum is too small, increment the left pointer to get a larger value\n                left += 1\n            else:\n                # Sum is too large, decrement the right pointer to get a smaller value\n                right -= 1\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    nums = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate values for the first element to avoid redundant checks.\n        if i > 0 and nums[i] == nums[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        target_sum = -nums[i]\n\n        while left < right:\n            current_sum = nums[left] + nums[right]\n\n            if current_sum == target_sum:\n                return True # Found a triplet with distinct indices i, left, right\n            elif current_sum < target_sum:\n                left += 1\n            else:\n                right -= 1\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "import abc\nimport random\nfrom typing import Iterator, Optional\nclass PrimeFibError(Exception):\n    \"\"\"Base exception for primefib module errors.\"\"\"\n    pass\nclass ComputationLimitError(PrimeFibError):\n    \"\"\"Exception raised when computation exceeds defined limits.\"\"\"\n    pass\nclass InvalidArgumentError(PrimeFibError):\n    \"\"\"Exception raised for invalid function arguments.\"\"\"\n    pass\nclass FibonacciNumber:\n    \"\"\"Data transfer object for a Fibonacci number with its index.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\nclass IPrimeFibRepository(abc.ABC):\n    \"\"\"Abstract interface for a repository storing prime Fibonacci numbers.\"\"\"\n    @abc.abstractmethod\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves the n-th prime Fibonacci number.\"\"\"\n        pass\n\n    @abc.abstractmethod\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores the n-th prime Fibonacci number.\"\"\"\n        pass\n\n    @abc.abstractmethod\n    def clear(self) -> None:\n        \"\"\"Clears all stored prime Fibonacci numbers.\"\"\"\n        pass\nclass InMemoryRepository(IPrimeFibRepository):\n    \"\"\"In-memory implementation of IPrimeFibRepository.\"\"\"\n    def __init__(self):\n        self._store = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves the n-th prime Fibonacci number from memory.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores the n-th prime Fibonacci number in memory.\"\"\"\n        self._store[n] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears all stored prime Fibonacci numbers from memory.\"\"\"\n        self._store.clear()\nclass PrimeUtils:\n    \"\"\"Utility class for primality testing and Fibonacci number generation.\"\"\"\n    DEFAULT_MILLER_RABIN_ROUNDS = 8\n\n    def is_prime(self, n: int, k: int = DEFAULT_MILLER_RABIN_ROUNDS) -> bool:\n        \"\"\"Performs a probabilistic Miller-Rabin primality test.\"\"\"\n        if n < 2: return False\n        if n == 2 or n == 3: return True\n        if n % 2 == 0: return False\n\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for _ in range(k):\n            a = random.randrange(2, n - 1)\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False\n        return True\n\n    def fib(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number using fast doubling.\"\"\"\n        if n < 0:\n            raise ValueError(\"Fibonacci is not defined for negative indices\")\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        def _fib_fast_doubling_pair(idx: int):\n            if idx == 0:\n                return (0, 1) # (F(0), F(1))\n\n            a, b = _fib_fast_doubling_pair(idx // 2)\n            \n            c = a * (2 * b - a) # F(2k) = F(k) * (2*F(k+1) - F(k))\n            d = b*b + a*a      # F(2k+1) = F(k+1)^2 + F(k)^2\n\n            if idx % 2 == 0:\n                return (c, d) # (F(2k), F(2k+1))\n            else:\n                return (d, c + d) # (F(2k+1), F(2k+2))\n\n        return _fib_fast_doubling_pair(n)[0]\n\n    def fib_generator(self, start_index: int = 0) -> Iterator[FibonacciNumber]:\n        \"\"\"Generates Fibonacci numbers starting from a given index.\"\"\"\n        a, b = 0, 1\n        index = 0\n        while True:\n            if index >= start_index:\n                yield FibonacciNumber(index, a)\n            a, b = b, a + b\n            index += 1\nclass PrimeFibService:\n    \"\"\"Orchestrates computation and caching of prime Fibonacci numbers.\"\"\"\n    def __init__(self, repo: IPrimeFibRepository, utils: PrimeUtils, max_iterations: int = 1_000_000):\n        self.repo = repo\n        self.utils = utils\n        self.max_iterations = max_iterations\n\n    def _ensure_valid_n(self, n: int) -> None:\n        \"\"\"Validates the input 'n'.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise InvalidArgumentError(\"n must be an integer and n >= 1\")\n\n    def get_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Returns the n-th Fibonacci number that is also prime.\"\"\"\n        self._ensure_valid_n(n)\n\n        cached_value = self.repo.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        found_prime_fib_count = 0\n        # Determine the number of prime fibs already cached\n        for i in range(1, n): # Check up to n-1\n            if self.repo.get(i) is not None:\n                found_prime_fib_count = i\n            else:\n                # If cache is not sequential, we must re-compute from the last known good.\n                # Or, for simplicity and adherence to sequence diagram, just start from 0 if `n` is missing.\n                # The current logic below will fill gaps correctly by iterating from start_index 0.\n                pass\n\n        fib_iterator = self.utils.fib_generator(start_index=0)\n        iterations_taken = 0\n\n        # Iterate until the n-th prime Fibonacci is found or limit is reached.\n        while found_prime_fib_count < n:\n            if iterations_taken >= self.max_iterations:\n                raise ComputationLimitError(\n                    f\"Exceeded max_iterations ({self.max_iterations}) while searching for \"\n                    f\"the {n}-th prime Fibonacci number.\"\n                )\n            \n            fib_obj = next(fib_iterator)\n\n            if self.utils.is_prime(fib_obj.value):\n                found_prime_fib_count += 1\n                try:\n                    self.repo.set(found_prime_fib_count, fib_obj.value)\n                except Exception:\n                    # Log error in real app, but proceed without persistence\n                    pass\n\n                if found_prime_fib_count == n:\n                    return fib_obj.value\n            \n            iterations_taken += 1\n        \n        # This line should ideally not be reached if the loop successfully finds `n` or raises an error.\n        # It's a fallback in case of unexpected loop termination.\n        final_value = self.repo.get(n)\n        if final_value is not None:\n            return final_value\n        raise ComputationLimitError(f\"Could not find the {n}-th prime Fibonacci number within limits.\")\nDEFAULT_MAX_ITERATIONS = 1_000_000\ndef prime_fib(n: int, repo: Optional[IPrimeFibRepository] = None, max_iterations: Optional[int] = None) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    actual_repo = repo if repo is not None else InMemoryRepository()\n    utils = PrimeUtils()\n    actual_max_iterations = max_iterations if max_iterations is not None else DEFAULT_MAX_ITERATIONS\n    \n    service = PrimeFibService(repo=actual_repo, utils=utils, max_iterations=actual_max_iterations)\n    return service.get_nth_prime_fib(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import os\n    import json\n    import tempfile\n    import dataclasses\n    from typing import Optional, Dict, Tuple, Iterator, List\n\n    # Define custom exceptions as per design\n    class InvalidInputError(ValueError):\n        pass\n\n    class ComputationError(RuntimeError):\n        pass\n\n    # Define DTO as per design\n    @dataclasses.dataclass\n    class PrimeFibResult:\n        n: int\n        value: int\n        index: Optional[int] = None\n        def to_dict(self) -> Dict:\n            return {\"n\": self.n, \"value\": self.value, \"index\": self.index}\n\n    # Math utility functions as per design (src/primefib/utils/math_utils.py)\n    def fast_doubling(k: int) -> Tuple[int, int]:\n        if k == 0:\n            return (0, 1)\n        a, b = fast_doubling(k >> 1)\n        c = a * (2 * b - a)\n        d = a * a + b * b\n        if k & 1:\n            return (d, c + d)\n        else:\n            return (c, d)\n\n    def miller_rabin_deterministic(val: int) -> bool:\n        if val < 2: ret