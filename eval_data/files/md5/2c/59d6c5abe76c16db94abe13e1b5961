n": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    # Check if text contains any whitespace characters.\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace:\n        # If whitespace exists, split on whitespace and return list of tokens.\n        return txt.split()\n\n    # If no whitespace, check if text contains a comma.\n    if ',' in txt:\n        # Split by comma and strip surrounding whitespace from each token.\n        return [token.strip() for token in txt.split(',')]\n\n    # If neither whitespace nor comma, count lowercase letters with odd alphabetical order.\n    count = 0\n    lower_a_ord = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':\n            # Calculate alphabetical index (ord('a')=0, ord('b')=1, ...)\n            idx = ord(char) - lower_a_ord\n            if idx % 2 == 1:  # Check if index is odd\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    # Check if the list is sorted in non-decreasing order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i + 1]:\n            return False\n\n    # Check if any number appears more than twice.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    # Use a dictionary to keep track of counts for each number.\n    counts = {}\n    prev_num = lst[0]\n\n    for i in range(len(lst)):\n        current_num = lst[i]\n\n        # Check for ascending order (non-decreasing).\n        if current_num < prev_num:\n            return False\n\n        # Update count for the current number.\n        counts[current_num] = counts.get(current_num, 0) + 1\n\n        # Check duplicate rule: a number can appear at most twice.\n        if counts[current_num] > 2:\n            return False\n\n        prev_num = current_num\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Checks if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Determines if a non-negative integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersect_start = max(start1, start2)\n    intersect_end = min(end1, end2)\n\n    if intersect_start > intersect_end:\n        return \"NO\"\n\n    intersection_length = intersect_end - intersect_start\n\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if it is, \"NO\" otherwise.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _intersection_length(int1, int2) -> int:\n        \"\"\"Calculates the length of the intersection of two intervals.\"\"\"\n        start1, end1 = int1\n        start2, end2 = int2\n\n        # Calculate the start and end of the intersection interval\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        # If intersection_start > intersection_end, intervals do not overlap\n        # The length is max(0, intersection_end - intersection_start)\n        return max(0, intersection_end - intersection_start)\n\n    length = _intersection_length(interval1, interval2)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in the grid.\n    The path starts at the cell containing value 1 and at each step moves to the neighbor with the smallest value.\n    \"\"\"\n    N = len(grid)\n\n    # Find the starting coordinates of value 1\n    start_row, start_col = -1, -1\n    for r in range(N):\n        for c in range(N):\n            if grid[r][c] == 1:\n                start_row, start_col = r, c\n                break\n        if start_row != -1:\n            break\n\n    current_row, current_col = start_row, start_col\n    path_values = []\n\n    # Define possible movements (up, down, left, right)\n    DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    for _ in range(k):\n        path_values.append(grid[current_row][current_col])\n\n        if len(path_values) == k:\n            break\n\n        min_neighbor_value = float('inf')\n        next_row, next_col = -1, -1\n\n        # Find the neighbor with the minimum value\n        for dr, dc in DIRECTIONS:\n            neighbor_r, neighbor_c = current_row + dr, current_col + dc\n\n            # Check if neighbor is within grid boundaries\n            if 0 <= neighbor_r < N and 0 <= neighbor_c < N:\n                neighbor_value = grid[neighbor_r][neighbor_c]\n                if neighbor_value < min_neighbor_value:\n                    min_neighbor_value = neighbor_value\n                    next_row, next_col = neighbor_r, neighbor_c\n        \n        # Move to the chosen neighbor\n        current_row, current_col = next_row, next_col\n\n    return path_values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Position:\n        def __init__(self, row: int, col: int):\n            self.row = row\n            self.col = col\n\n        def __eq__(self, other):\n            return isinstance(other, Position) and self.row == other.row and self.col == other.col\n\n        def __hash__(self):\n            return hash((self.row, self.col))\n\n        def neighbors(self, grid_instance) -> list['Position']:\n            \"\"\"Returns orthogonal neighbors within grid bounds.\"\"\"\n            deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n            out = []\n            for dr, dc in deltas:\n                r, c = self.row + dr, self.col + dc\n                if 0 <= r < grid_instance.rows and 0 <= c < grid_instance.cols:\n                    out.append(Position(r, c))\n            return out\n\n    class Grid:\n        def __init__(self, cells: list[list[int]]):\n            self.cells = [list(row) for row in cells]\n            self.rows = len(cells)\n            self.cols = len(cells[0])\n            self.value_to_pos: dict[int, Position] = {}\n            for r in range(self.rows):\n                for c in range(self.cols):\n                    self.value_to_pos[self.cells[r][c]] = Position(r, c)\n\n        def get_value(self, pos: Position) -> int:\n            \"\"\"Returns the integer value at a given position.\"\"\"\n            return self.cells[pos.row][pos.col]\n\n        def get_neighbors(self, pos: Position) -> list[Position]:\n            \"\"\"Returns a list of neighboring Position objects.\"\"\"\n            return pos.neighbors(self)\n\n        def find_position_for_value(self, value: int) -> Position:\n            \"\"\"Returns the Position for a given value.\"\"\"\n            return self.value_to_pos[value]\n\n    class PathFinderService:\n        def __init__(self, grid_instance: Grid):\n            self.grid = grid_instance\n\n        def find_min_path(self, length: int) -> list[int]:\n            \"\"\"Computes the lexicographically minimal path of given length.\"\"\"\n            min_value = min(self.grid.value_to_pos.keys())\n            start_pos = self.grid.find_position_for_value(min_value)\n\n            result = [min_value]\n            frontier = {start_pos}\n\n            for _ in range(1, length):\n                next_val, frontier = self._next_frontier(frontier)\n                result.append(next_val)\n            return result\n\n        def _next_frontier(self, current_frontier: set[Position]) -> tuple[int, set[Position]]:\n            \"\"\"Finds the minimal neighbor value and the set of positions achieving it.\"\"\"\n            best_val = None\n            best_positions = set()\n\n            for pos in current_frontier:\n                for nb in self.grid.get_neighbors(pos):\n                    v = self.grid.get_value(nb)\n                    if best_val is None or v < best_val:\n                        best_val = v\n                        best_positions = {nb}\n                    elif v == best_val:\n                        best_positions.add(nb)\n            return best_val, best_positions\n\n    # Main logic for minPath function\n    grid_obj = Grid(grid)\n    service = PathFinderService(grid_obj)\n    return service.find_min_path(k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    def sign_of(value: int) -> int:\n        \"\"\"Returns the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if value > 0:\n            return 1\n        if value < 0:\n            return -1\n        return 0\n\n    def product(iterable):\n        \"\"\"Calculates the product of numbers in an iterable, short-circuiting to 0 if a zero is encountered.\"\"\"\n        prod = 1\n        for v in iterable:\n            if v == 0:\n                return 0\n            prod *= v\n        return prod\n\n    if not arr:\n        return None\n\n    sum_mags = sum(abs(x) for x in arr)\n    sign_prod = product(sign_of(x) for x in arr)\n\n    return sum_mags * sign_prod", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_sign(value: int) -> int:\n        \"\"\"Determines the sign of an integer (1 for positive, -1 for negative, 0 for zero).\"\"\"\n        if value > 0:\n            return 1\n        if value < 0:\n            return -1\n        return 0\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for x in arr:\n        sum_of_magnitudes += abs(x)\n\n        sign_val = _get_sign(x)\n        if sign_val == 0:\n            product_of_signs = 0\n            # If any element is 0, the total product of signs will be 0.\n            # We can short-circuit the product calculation, but still need the full sum of magnitudes.\n            # No break here, as sum_of_magnitudes still needs full iteration.\n            # product_of_signs will correctly remain 0 for subsequent multiplications with 1 or -1.\n        else:\n            product_of_signs *= sign_val\n\n    return product_of_signs * sum_of_magnitudes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n > 1, the count is derived from (numbers starting with 1) +\n    # (numbers ending with 1) - (numbers starting and ending with 1).\n    # This simplifies to 18 * 10**(n-2).\n    return 18 * (10 ** (n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n >= 2, the formula is 10^(n-1) + 9*10^(n-2) - 10^(n-2) = 18 * 10^(n-2).\n    return 18 * (10 ** (n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n\n    class InvalidBracketStringError(Exception):\n        \"\"\"Custom exception for invalid bracket strings.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class BracketString:\n        \"\"\"Domain model for bracket strings.\"\"\"\n        def __init__(self, raw: str) -> None:\n            self.raw: str = raw\n\n        def normalized(self) -> str:\n            return self.raw.strip()\n\n        def length(self) -> int:\n            return len(self.normalized())\n\n        def is_empty(self) -> bool:\n            return self.length() == 0\n\n    class BracketValidator:\n        \"\"\"Validates input strings for allowed characters.\"\"\"\n        ALLOWED_CHARS = {\"[\", \"]\"}\n\n        def validate(self, s: str) -> None:\n            invalid = {c for c in set(s) if c not in self.ALLOWED_CHARS}\n            if invalid:\n                raise InvalidBracketStringError(f\"Invalid characters: {sorted(list(invalid))}\")\n\n    class SubsequenceFinder:\n        \"\"\"Finds if a nested bracket subsequence exists.\"\"\"\n        def find_nested_subsequence(self, s: str) -> bool:\n            # We look for a subsequence of the form `[[ ]]`.\n            # This requires finding four characters `s[i] = '[', s[j] = '[', s[k] = ']', s[l] = ']'\n            # such that their original indices in the string satisfy `i < j < k < l`.\n            first_open_idx = -1\n            second_open_idx = -1\n            first_close_after_second_open_idx = -1\n            second_close_after_first_close_idx = -1\n\n            for idx, char in enumerate(s):\n                if char == '[':\n                    if first_open_idx == -1:\n                        first_open_idx = idx\n                    elif second_open_idx == -1: # Found second open after the first\n                        second_open_idx = idx\n                elif char == ']':\n                    # This ']' is potentially the first closing bracket for the second open `[`\n                    if second_open_idx != -1 and first_close_after_second_open_idx == -1:\n                        first_close_after_second_open_idx = idx\n                    # This ']' is potentially the second closing bracket, completing the outer pair\n                    elif first_close_after_second_open_idx != -1 and second_close_after_first_close_idx == -1:\n                        second_close_after_first_close_idx = idx\n                \n                # If all four parts are found in the correct order, a nested subsequence exists.\n                if (first_open_idx != -1 and\n                    second_open_idx != -1 and\n                    first_close_after_second_open_idx != -1 and\n                    second_close_after_first_close_idx != -1):\n                    return True\n            return False\n\n    class NestingService:\n        \"\"\"Coordinates validation and subsequence finding.\"\"\"\n        def __init__(self, validator: BracketValidator, finder: SubsequenceFinder) -> None:\n            self._validator = validator\n            self._finder = finder\n\n        def is_nested(self, bracket: BracketString) -> bool:\n            s = bracket.normalized()\n            self._validator.validate(s)\n            if bracket.is_empty():\n                return False\n            return self._finder.find_nested_subsequence(s)\n\n    # Instantiate the required components\n    validator = BracketValidator()\n    finder = SubsequenceFinder()\n    service = NestingService(validator, finder)\n\n    # Create the BracketString model and call the service\n    model = BracketString(string)\n    return service.is_nested(model)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}, {"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    opens = [i for i, ch in enumerate(string) if ch == \"[\"]\n    closes = [i for i, ch in enumerate(string) if ch == \"]\"]\n\n    # A nested subsequence like \"[[]]\" requires at least two open and two close brackets.\n    if len(opens) < 2 or len(closes) < 2:\n        return False\n\n    # Precompute the number of closing brackets strictly after each position.\n    closes_after = [0] * (len(string) + 1)\n    total_closes_count = 0\n    for idx in reversed(range(len(string))):\n        if string[idx] == \"]\":\n            total_closes_count += 1\n        closes_after[idx] = total_closes_count\n\n    # Iterate through each potential \"inner\" opening bracket (must have at least one '[' before it).\n    for open_pos in opens[1:]:\n        # If there are two or more ']' brackets strictly after this 'open_pos',\n        # then we have found a subsequence of the form '[ [ ] ]'.\n        if closes_after[open_pos + 1] >= 2:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a string is an alphabetical\n    character and is not part of a word (i.e., it's a standalone letter token).\n    \"\"\"\n    if not txt:\n        return False\n    \n    # Trim trailing spaces to find the actual end of meaningful text\n    s = txt.rstrip()\n    \n    # If the string becomes empty after trimming, no last character to check\n    if not s:\n        return False\n    \n    # Split the string by spaces to get tokens (words)\n    tokens = s.split()\n    \n    # If there are no tokens, it means the string was empty or just spaces\n    if not tokens:\n        return False\n        \n    # Get the last token\n    last_token = tokens[-1]\n    \n    # Check if the last token consists of a single alphabetical character\n    return len(last_token) == 1 and last_token.isalpha()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["eeeee e "]], "plus_fail_tests": [["apple pi\ne"]]}, {"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n\n    Examples:\n    check_if_last_char_is_a_letter(\"apple pie\") \u279e False\n    check_if_last_char_is_a_letter(\"apple pi e\") \u279e True\n    check_if_last_char_is_a_letter(\"apple pi e \") \u279e False\n    check_if_last_char_is_a_letter(\"\") \u279e False \n    '''\n    if not txt:\n        return False\n    \n    # If the last character is a space, it cannot be an alphabetical character.\n    if txt[-1].isspace():\n        return False\n    \n    last_char_index = len(txt) - 1\n    last_char = txt[last_char_index]\n    \n    # Check if the last character is alphabetical.\n    if not last_char.isalpha():\n        return False\n        \n    # Check if the character is \"not a part of a word\", meaning it's standalone.\n    # It's standalone if it's the first character, or if the character before it is a space.\n    is_left_separated = (last_char_index == 0) or (txt[last_char_index - 1] == ' ')\n    \n    # The right side is always the end of the string, which implies separation.\n    \n    return is_left_separated", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    s_n = str(n)\n    odd_digits = []\n    for char_digit in s_n:\n        digit = int(char_digit)\n        if digit % 2 == 1:\n            odd_digits.append(digit)\n\n    if not odd_digits:\n        return 0\n\n    product = 1\n    for d in odd_digits:\n        product *= d\n    return product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    found_odd = False\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 == 1:\n            product *= digit\n            found_odd = True\n    \n    if found_odd:\n        return product\n    else:\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        total_sum += ceiled_num ** 2\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    import math\n\n    def _ceil_int(value: float) -> int:\n        \"\"\"Returns the ceiling of a float value as an integer.\"\"\"\n        return int(math.ceil(value))\n\n    total = 0\n    for v in lst:\n        # Round each element to the upper integer (Ceiling)\n        c = _ceil_int(float(v))\n        # Square the rounded integer and add to total\n        total += c * c\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    # Scan from right to left to find the largest index i where arr[i] < arr[i-1].\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n\n    # If no such element is found, return -1.\n    return -1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is strictly less than the element preceding it.\n    If no such element exists, returns -1.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    # Iterate from the second-to-last element down to the second element\n    # to find the largest index i where arr[i] < arr[i-1].\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n            \n 