    def _get_current_iso_timestamp():\n        \"\"\"Returns the current UTC time formatted as an ISO 8601 string.\"\"\"\n        return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')\n\n    class MathUtils:\n        \"\"\"Provides pure mathematical functions for calculations.\"\"\"\n        def factorial(self, i: int) -> int:\n            \"\"\"Calculates the factorial of i.\"\"\"\n            result = 1\n            for k in range(1, i + 1):\n                result *= k\n            return result\n\n        def sum_to_n(self, i: int) -> int:\n            \"\"\"Calculates the sum of integers from 1 to i.\"\"\"\n            return i * (i + 1) // 2\n\n    class SequenceResult:\n        \"\"\"Encapsulates the generated sequence and its metadata.\"\"\"\n        def __init__(self, sequence: list[int], n: int, timestamp: str):\n            self.sequence = sequence\n            self.n = n\n            self.timestamp = timestamp\n\n    class SequenceGeneratorService:\n        \"\"\"Orchestrates the generation of the sequence.\"\"\"\n        def __init__(self, math_utils_instance: MathUtils):\n            self.math_utils = math_utils_instance\n\n        def generate(self, n: int) -> SequenceResult:\n            \"\"\"Generates the sequence based on the given parameter n.\"\"\"\n            seq = []\n            for i in range(1, n + 1):\n                if i % 2 == 0:\n                    seq.append(self.math_utils.factorial(i))\n                else:\n                    seq.append(self.math_utils.sum_to_n(i))\n            return SequenceResult(sequence=seq, n=n, timestamp=_get_current_iso_timestamp())\n\n    math_utils_instance = MathUtils()\n    service = SequenceGeneratorService(math_utils_instance)\n    result = service.generate(n)\n    return result.sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n\n    def factorial(k):\n        \"\"\"Calculates the factorial of k.\"\"\"\n        res = 1\n        for x in range(1, k + 1):\n            res *= x\n        return res\n\n    def sum_to(k):\n        \"\"\"Calculates the sum of numbers from 1 to k.\"\"\"\n        return k * (k + 1) // 2\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:\n            result.append(factorial(i))\n        else:\n            result.append(sum_to(i))\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    def is_palindrome(value: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        s = str(value)\n        return s == s[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    \"\"\"\n    def _is_palindrome(value: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\