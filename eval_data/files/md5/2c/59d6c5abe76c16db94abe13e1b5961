           if num < 0:\n                current_sum_of_digits += -int(s_num_abs[0])\n                for digit_char in s_num_abs[1:]:\n                    current_sum_of_digits += int(digit_char)\n            else: \n                for digit_char in s_num_abs:\n                    current_sum_of_digits += int(digit_char)\n        \n        if current_sum_of_digits > 0:\n            count += 1\n            \n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by performing\n    any number of right shift operations.\n    \"\"\"\n    if not arr or len(arr) < 2:\n        return True\n\n    drops = 0\n    n = len(arr)\n\n    for i in range(n - 1):\n        if arr[i] > arr[i + 1]:\n            drops += 1\n            if drops > 1:\n                return False\n\n    # If there's one drop, it must be the wrap-around point,\n    # so the last element must be less than or equal to the first.\n    if drops == 1:\n        return arr[-1] <= arr[0]\n        \n    # If there are no drops, the array is already sorted.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Count the number of places where arr[i] > arr[i + 1]\n    # This represents \"breaks\" in the non-decreasing order within the linear sequence.\n    drops = 0\n    for i in range(n - 1):\n        if arr[i] > arr[i + 1]:\n            drops += 1\n\n    # Based on the number of drops:\n    if drops == 0:\n        # The array is already sorted in non-decreasing order (e.g., [1, 2, 3, 4, 5]).\n        return True\n    elif drops == 1:\n        # There is exactly one drop (e.g., [3, 4, 5, 1, 2]).\n        # For it to be a rotated sorted array, the last element must be less than or equal to the first element.\n        # This condition ensures that the single \"break\" can be \"closed\" by rotation.\n        return arr[n - 1] <= arr[0]\n    else: # drops > 1\n        # More than one drop means the array cannot be sorted by a single rotation.\n        # (e.g., [3, 5, 4, 1, 2] or [1, 5, 3, 4]).\n        return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if elements can be exchanged between lst1 and lst2 to make lst1 consist only of even numbers.\"\"\"\n    def is_even(n: int) 