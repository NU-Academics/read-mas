_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression from lists of operators and operands.\n    \"\"\"\n\n    # --- Helper data and functions (defined inline) ---\n\n    # Operator precedence and associativity mapping\n    _OPERATOR_INFO = {\n        '+': {'precedence': 1, 'associativity': 'left', 'func': lambda a, b: a + b},\n        '-': {'precedence': 1, 'associativity': 'left', 'func': lambda a, b: a - b},\n        '*': {'precedence': 2, 'associativity': 'left', 'func': lambda a, b: a * b},\n        '//': {'precedence': 2, 'associativity': 'left', 'func': lambda a, b: a // b},\n        '**': {'precedence': 3, 'associativity': 'right', 'func': lambda a, b: a ** b},\n    }\n    \n    class EvaluationError(Exception):\n        pass\n\n    def get_precedence(op_str):\n        return _OPERATOR_INFO[op_str]['precedence']\n\n    def is_right_associative(op_str):\n        return _OPERATOR_INFO[op_str]['associativity'] == 'right'\n\n    def apply_operator(op_str, left, right):\n        try:\n            return _OPERATOR_INFO[op_str]['func'](left, right)\n        except ZeroDivisionError as e:\n            raise EvaluationError(\"division by zero\") from e\n\n    # --- Step 1: Build infix token sequence ---\n    # Token format: ('operand', value) or ('operator', symbol)\n    tokens = []\n    # Problem statement guarantees len(operator) == len(operand) - 1.\n    for i in range(len(operand)):\n        tokens.append(('operand', operand[i]))\n        if i < len(operator):\n            tokens.append(('operator', operator[i]))\n\n    # --- Step 2: Convert infix tokens to Reverse Polish Notation (RPN) ---\n    output_queue = []  # Stores tokens in RPN order\n    operator_stack = []  # Temporarily holds operators during conversion\n\n    for token_type, token_value in tokens:\n        if token_type == 'operand':\n            output_queue.append((token_type, token_value))\n        elif token_type == 'operator':\n            while operator_stack:\n       