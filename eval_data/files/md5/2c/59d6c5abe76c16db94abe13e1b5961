elf.timestamp = timestamp\n        self.arr = arr\n        self.k = k\n        self.result = result\nclass Config:\n    \"\"\"Configuration values.\"\"\"\n    def __init__(self, run_log_path: str, max_log_records: int):\n        self.run_log_path = run_log_path\n        self.max_log_records = max_log_records\ndef get_default_config() -> Config:\n    \"\"\"Returns the default configuration.\"\"\"\n    return Config(run_log_path=\"./runs/log.json\", max_log_records=10000)\ndef parse_arr_string(s: str) -> list[int]:\n    \"\"\"Parses a comma-separated string of integers into a list.\"\"\"\n    try:\n        return [int(x.strip()) for x in s.split(',')]\n    except ValueError as e:\n        raise InvalidInputError(f\"Failed to parse array string '{s}': {e}\")\ndef is_at_most_two_digits(n: int) -> bool:\n    \"\"\"Checks if an integer has at most two digits (absolute value < 100).\"\"\"\n    return -100 < n < 100\ndef current_iso_timestamp() -> str:\n    \"\"\"Returns the current UTC timestamp in ISO8601 format.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds') + 'Z'\ndef make_uuid() -> str:\n    \"\"\"Generates a UUID4 hex string.\"\"\"\n    return str(uuid.uuid4())\nclass InputValidator:\n    \"\"\"Validates and normalizes inputs.\"\"\"\n    def validate(self, arr: object, k: object) -> InputDTO:\n        if isinstance(arr, str):\n            arr_list = parse_arr_string(arr)\n        elif isinstance(arr, (list, tuple)):\n            arr_list = list(arr)\n        else:\n            raise InvalidInputError(\"arr must be list[int], tuple[int], or comma-separated string\")\n        if not all(isinstance(x, int) for x in arr_list):\n            raise InvalidInputError(\"all elements of arr must be integers\")\n        if not isinstance(k, int):\n            raise InvalidInputError(\"k must be an integer\")\n        if not (1 <= len(arr_list) <= 100):\n            raise InvalidInputError(\"len(arr) must be between 1 and 100\")\n        if not (1 <= k <= len(arr_list)):\n            raise InvalidInputError(\"k must satisfy 1 <= k <= len(arr)\")\n        return InputDTO(arr_list, k)\nclass AddService:\n    \"\"\"Core business logic to compute sum.\"\"\"\n    def compute(self, input_dto: InputDTO) -> int:\n        total = 0\n        for n in input_dto.arr[:input_dto.k]:\n            if not isinstance(n, int):\n                # This should ideally not happen if InputValidator is robust\n                raise InvalidInputError(\"unexpected non-int in validated arr\")\n            if is_at_most_two_digits(n):\n                total += n\n        return total\nclass JSONRunRepository:\n    \"\"\"Persists and reads run records to a local JSON file.\"\"\"\n    def __init__(self, path: str, max_records: int):\n        self.path = path\n        self.max_records = max_records\n        os.makedirs(os.path.dirname(path), exist_ok=True)\n\n    def append(self, record: RunRecord) -> None:\n        \"\"\"Appends a run record to the log file, truncating if necessary.\"\"\"\n        try:\n            records = []\n            if os.path.exists(self.path):\n                with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                    try:\n                        records = json.load(f)\n                    except json.JSONDecodeError:\n                        records = [] # Handle corrupt file by starting fresh\n            records.append(record.__dict__)\n            if len(records) > self.max_records:\n                records = records[-self.max_records:]\n            \n            tmp_path = self.path + \".tmp\"\n            with open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(records, f, ensure_ascii=False, indent=2)\n            os.replace(tmp_path, self.path)\n        except Exception as e:\n            raise PersistenceError(f\"Failed to write run record to '{self.path}': {e}\")\nclass AddController:\n    \"\"\"Coordinates validator, service, and repository.\"\"\"\n