):\n            return Decimal(str(value))\n        elif isinstance(value, str):\n            normalized_s = _normalize_str_number(value)\n            try:\n                return Decimal(normalized_s)\n            except InvalidOperation:\n                raise # Propagate InvalidOperation if the string is not a valid number.\n        else:\n            # For any other type, attempt a conversion via string.\n            # This will raise InvalidOperation if the type cannot be represented as a number.\n            try:\n                return Decimal(str(value))\n            except InvalidOperation:\n                raise # Propagate InvalidOperation for unparseable non-string types.\n\n    # Parse both inputs to Decimal for accurate comparison.\n    a_parsed = _parse_to_decimal(a)\n    b_parsed = _parse_to_decimal(b)\n\n    # Compare the parsed Decimal values.\n    if a_parsed == b_parsed:\n        return None\n    elif a_parsed > b_parsed:\n        return a # Return the original 'a' value, preserving its type.\n    else: # b_parsed > a_parsed\n        return b # Return the original 'b' value, preserving its type.", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/137", "solution": "from decimal import Decimal, InvalidOperation\nfrom typing import Optional, Union\nclass InvalidNumericError(ValueError):\n    def __init__(self, param_name: str, value: object, message: str) -> None:\n        super().__init__(f\"Invalid numeric input for '{param_name}': '{value}' - {message}\")\n        self.param_name = param_name\n        self.value = value\n        self.message = message\nclass DecimalParseResult:\n    def __init__(self, decimal: Decimal, original: object, type_name: str) -> None:\n        self.decimal = decimal\n        self.original = original\n        self.type_name = type_name\ndef normalise_decimal_string(s: str) -> str:\n    s = s.strip()\n    # Check for multiple decimal separators or mixed separators, which are invalid.\n    if (s.count(',') > 1) or (s.count('.') > 1) or (',' in s and '.' in s):\n        raise InvalidNumericError(\"value\", s, \"invalid decimal string format: multiple or mixed separators\")\n    return s.replace(',', '.')\nclass NumberParser:\n    def parse(self, value: object) -> DecimalParseResult:\n        if isinstance(value, int):\n            return DecimalParseResult(Decimal(value), value, \"int\")\n        if isinstance(value, float):\n            # Convert float to string first to avoid potential binary float precision issues.\n            try:\n                dec = Decimal(str(value))\n            except InvalidOperation:\n                raise InvalidNumericError(\"value\", value, \"could not convert float to Decimal\")\n            return DecimalParseResult(dec, value, \"float\")\n        if isinstance(value, str):\n            try:\n                normalized_s = normalise_decimal_string(value)\n                dec = Decimal(normalized_s)\n            except (InvalidOperation, InvalidNumericError):\n                raise InvalidNumericError(\"value\", value, \"invalid numeric string format\")\n            return DecimalParseResult(dec, value, \"string\")\n        \n        raise InvalidNumericError(\"value\", value, \"unsupported type for comparison\")\nclass CompareService:\n    def __init__(self, parser: NumberParser) -> None:\n        self._parser = parser\n\n    def compare(self, a: object, b: object) -> object | None:\n        left = self._parser.parse(a)\n        right = self._parser.parse(b)\n        \n        if left.decimal == right.decimal:\n            return None\n        winner = left.original if left.decimal > right.decimal else right.original\n        return winner\n_parser = NumberParser()\n_service = CompareService(parser=_parser)\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    return _service.compare(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    import re\n\n    def _replace_space_run(match):\n        run = match.group(0)\n        if len(run) >= 3:\n            return \"-\"\n        return \"_\" * len(run)\n\n    return re.sub(r\" +\", _replace_space_run, text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    out_chars = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] != ' ':\n            out_chars.append(text[i])\n            i += 1\n            continue\n        \n        # Found a space run\n        j = i\n        while j < n and text[j] == ' ':\n            j += 1\n        run_len = j - i\n        \n        if run_len >= 3:\n            out_chars.append(\"-\")\n        else:\n            out_chars.extend(\"_\" * run_len)\n        i = j\n    \n    return \"\".join(out_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:  # This implicitly means i % 3 != 0 due to the 'elif'\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += x ** 2\n        elif i % 4 == 0: # This condition implicitly means i % 3 != 0 due to the `elif`\n            total_sum += x ** 3\n        else:\n            total_sum += x\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific criteria.\"\"\"\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    dot_index = file_name.find('.')\n    basename = file_name[:dot_index]\n    extension = file_name[dot_index + 1:]\n\n    # Condition 3: The substring before the dot should not be empty\n    if not basename:\n        return 'No'\n\n    # Condition 3: ...and it starts with a letter from the latin alphabet ('a'-'z' and 'A'-'Z').\n    if not basename[0].isalpha():\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension.lower() not in allowed_extensions:\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':  # Equivalent to char.isdigit() but explicit for clarity\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["example.TXt"]]}, {"task_id": "HumanEval/141", "solution": "from typing import List, Optional, Tuple\nDEFAULT_ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\nDEFAULT_CASE_SENSITIVE = True\nclass ValidationError(Exception):\n    \"\"\"Exception raised for unexpected internal validation issues.\"\"\"\n    pass\nclass ConfigurationError(Exception):\n    \"\"\"Exception raised for invalid configuration settings.\"\"\"\n    pass\ndef is_latin_letter(ch: str) -> bool:\n    \"\"\"Checks if a character is a single Latin letter (a-z or A-Z).\"\"\"\n    return len(ch) == 1 and ('a' <= ch <= 'z' or 'A' <= ch <= 'Z')\ndef count_digits(s: str) -> int:\n    \"\"\"Counts the number of digit characters ('0'-'9') in a string.\"\"\"\n    return sum(1 for c in s if '0' <= c <= '9')\nclass ValidationResult:\n    \"\"\"Represents the outcome of a file name validation, including reasons for failure.\"\"\"\n    def __init__(self, is_valid: bool, reasons: Optional[List[str]] = None) -> None:\n        self.is_valid = is_valid\n        self.reasons = reasons or []\n\n    def to_bool(self) -> bool:\n        \"\"\"Returns the boolean validity status.\"\"\"\n        return self.is_valid\nclass ValidatorConfig:\n    \"\"\"Holds configuration settings for the file name validator.\"\"\"\n    def __init__(self, allowed_extensions: List[str], case_sensitive_extensions: bool = True) -> None:\n        self.allowed_extensions = allowed_extensions\n        self.case_sensitive_extensions = case_sensitive_extensions\nclass ExtensionRepository:\n    \"\"\"Manages and provides the list of allowed file extensions.\"\"\"\n    def __init__(self, allowed: Optional[List[str]] = None) -> None:\n        if allowed is None:\n            self._allowed = []\n        else:\n            if isinstance(allowed, list) and len(allowed) == 0:\n                raise ConfigurationError(\"allowed extensions list must not be empty\")\n            self._allowed = list(allowed)\n\n    def get_allowed(self) -> List[str]:\n        \"\"\"Returns a copy of the list of allowed extensions.\"\"\"\n        return list(self._allowed)\nclass FileNameValidator:\n    \"\"\"Encapsulates the core logic for validating a file name against defined rules.\"\"\"\n    def __init__(self, config: ValidatorConfig, ext_repo: ExtensionRepository) -> None:\n        self._config = config\n        self._ext_repo = ext_repo\n\n    def validate(self, filename: str) -> ValidationResult:\n        \"\"\"Performs all validation checks on the given filename.\"\"\"\n        if not isinstance(filename, str):\n            raise TypeError(\"filename must be a str\")\n\n        reasons: List[str] = []\n\n        # Rule 1: Exactly one dot\n        dot_count = filename.count('.')\n        if dot_count != 1:\n            reasons.append(\"Filename must contain exactly one dot\")\n            # If dot count is not 1, we cannot reliably split for further checks.\n            return ValidationResult(False, reasons)\n\n        prefix, suffix = filename.rsplit('.', 1)\n\n        # Rule 2: Prefix non-empty and starts with a Latin letter\n        if len(prefix) == 0:\n            reasons.append(\"Prefix before dot must not be empty\")\n        elif not is_latin_letter(prefix[0]):\n            reasons.append(\"Prefix must start with a Latin letter\")\n\n        # Rule 3: Extension in allowed list\n        allowed_extensions = self._ext_repo.get_allowed()\n        \n        ext_to_check = suffix\n        if not self._config.case_sensitive_extensions:\n            ext_to_check = suffix.lower()\n            allowed_extensions = [ext.lower() for ext in allowed_extensions]\n\n        if ext_to_check not in allowed_extensions:\n            reasons.append(f\"Extension '{suffix}' is not allowed\")\n\n        # Rule 4: No more than three digits\n        digits = count_digits(filename)\n        if digits > 3:\n            reasons.append(\"Filename must not contain more than three digits\")\n\n        return ValidationResult(is_valid=(len(reasons) == 0), reasons=reasons)\nclass ValidatorController:\n    \"\"\"Translates validation results from the service into simplified string and exit code formats.\"\"\"\n    def __init__(self, validator: FileNameValidator) -> None:\n        self._validator = validator\n\n    def check_and_format(self, filename: str) -> Tuple[str, int]:\n        \"\"\"Validates the filename and returns a ('Yes'/'No', exit_code) tuple.\"\"\"\n        try:\n            result = self._validator.validate(filename)\n        except Exception as e:\n            # Wrap any unexpected errors during validation for consistent error handling.\n            raise ValidationError(str(e))\n        \n        if result.to_bool():\n            return \"Yes\", 0\n        else:\n            return \"No\", 2\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    config = ValidatorConfig(allowed_extensions=DEFAULT_ALLOWED_EXTENSIONS,\n                             case_sensitive_extensions=DEFAULT_CASE_SENSITIVE)\n    ext_repo = ExtensionRepository(config.allowed_extensions)\n    validator = FileNameValidator(config, ext_repo)\n    controller = ValidatorController(validator)\n    result_text, _ = controller.check_and_format(file_name)\n    return result_text", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    def _gcd(a, b):\n        \"\"\"Computes the greatest common divisor of two integers using Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Parse the first fraction x\n    num1_str, den1_str = x.split('/')\n    num1 = int(num1_str)\n    den1 = int(den1_str)\n\n    # Parse the second fraction n\n    num2_str, den2_str = n.split('/')\n    num2 = int(num2_str)\n    den2 = int(den2_str)\n\n    # Multiply the numerators and denominators\n    product_num = num1 * num2\n    product_den = den1 * den2\n\n    # Reduce the resulting fraction\n    common_divisor = _gcd(product_num, product_den)\n    # The reduced fraction is product_num / common_divisor over product_den / common_divisor\n    # For a whole number, the reduced denominator must be 1.\n    return (product_den // common_divisor) == 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/144", "solution": "class FractionError(Exception):\n    \"\"\"Base exception for fraction-related errors.\"\"\"\n    pass\nclass ParseError(FractionError):\n    \"\"\"Exception raised for errors during fraction string parsing.\"\"\"\n    pass\nclass ValidationError(FractionError):\n    \"\"\"Exception raised for invalid fraction values.\"\"\"\n    pass\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations.\"\"\"\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return abs(a)\nclass Fraction:\n    \"\"\"Represents a rational number as an immutable value object.\"\"\"\n    def __init__(self, numerator: int, denominator: int) -> None:\n        \"\"\"Initializes a Fraction, normalizing negative denominators.\"\"\"\n        if denominator == 0:\n            raise ValidationError(\"Denominator cannot be zero.\")\n        if denominator < 0:\n            numerator = -numerator\n            denominator = -denominator\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self) -> int:\n        \"\"\"Returns the numerator of the fraction.\"\"\"\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        \"\"\"Returns the denominator of the fraction.\"\"\"\n        return self._denominator\n\n    def multiply(self, other: \"Fraction\") -> \"Fraction\":\n        \"\"\"Returns a new Fraction representing the product of this fraction and another.\"\"\"\n        return Fraction(self.numerator * other.numerator, self.denominator * other.denominator).reduce()\n\n    def reduce(self) -> \"Fraction\":\n        \"\"\"Returns a new Fraction reduced to its lowest terms.\"\"\"\n        common_divisor = MathUtils.gcd(self.numerator, self.denominator)\n        return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n    def is_whole(self) -> bool:\n        \"\"\"Returns True if the fraction evaluates to a whole number, False otherwise.\"\"\"\n        reduced = self.reduce()\n        return reduced.denominator == 1\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator},{self.denominator})\"\nclass FractionParser:\n    \"\"\"Parses fraction strings into Fraction objects.\"\"\"\n    def parse(self, fraction_str: str) -> Fraction:\n        \"\"\"Parses a string of the format 'numerator/denominator' into a Fraction.\"\"\"\n        try:\n            num_s, den_s = fraction_str.split(\"/\")\n        except ValueError:\n            raise ParseError(\"Fraction string must contain exactly one '/'\")\n        try:\n            numerator = int(num_s)\n            denominator = int(den_s)\n        except ValueError:\n            raise ParseError(\"Numerator and denominator must be valid integers.\")\n        return Fraction(numerator, denominator)\ndef simplify(x, n):\n    \"\"\"Simplifies the expression x * n and returns True if it's a whole number, False otherwise.\"\"\"\n    parser = FractionParser()\n    fx = parser.parse(x)\n    fn = parser.parse(n)\n    product = fx.multiply(fn)\n    return product.is_whole()", "base_status": "pass", "plus_status": "pass", "b