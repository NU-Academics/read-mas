esponding elements of two lists.\n    Returns a new list containing these differences.\"\"\"\n    \n    result = []\n    for score, _guess in zip(game, guess):\n        result.append(abs(score - _guess))\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    result = []\n    for s, g in zip(game, guess):\n        if s == g:\n            result.append(0)\n        else:\n            result.append(abs(s - g))\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if num == 0:\n        return (1, 0)\n\n    even_count = 0\n    odd_count = 0\n    \n    n = abs(num)\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        n //= 10\n        \n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple with the number of even and odd digits respectively.\"\"\"\n    \n    evens = 0\n    odds = 0\n    \n    # Handle the special case for 0 as per requirements.\n    if num == 0:\n        return (1, 0)\n\n    # Work with the absolute value to ignore the sign.\n    n = abs(num)\n\n    # Iterate through the digits of the number.\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 0:\n            evens += 1\n        else:\n            odds += 1\n        n //= 10\n            \n    return (evens, odds)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # As per design, if pattern 'b' is empty, return True only if 'a' is also empty.\n    if len(b) == 0:\n        return len(a) == 0\n\n    n = len(b)\n    # Concatenate 'b' with itself to easily generate all its cyclic rotations using slicing.\n    b_double = b + b\n\n    # Check each possible rotation of 'b' as a substring of 'a'.\n    for i in range(n):\n        rotation = b_double[i : i + n]\n        if rotation in a:\n            return True\n\n    # If no rotation of 'b' is found in 'a', return False.\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["racanagramecar", ""]]}, {"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    # The trick for checking if any rotation of 'b' is a substring of 'a'\n    # is to check if 'a' contains 'b' concatenated with itself.\n    # Any cyclic shift of 'b' will be a substring of 'b' + 'b'.\n    return b in (a + a) if len(b) == len(a) else b in (a + a) or (b + b) in a # This optimization applies to the case where lengths are equal, but the general case covers it too.\n    # More specifically, the general solution from the design is:\n    # return any(b[i:] + b[:i] in a for i in range(len(b)))\n\n    # A more direct implementation as per the design context for 'any_rotation_in':\n    # concat_b = b + b\n    # len_b = len(b)\n    # for i in range(len_b):\n    #     rotation = concat_b[i : i + len_b]\n    #     if rotation in a:\n    #         return True\n    # return False\n\n    # Actually, the most robust and direct way for the general case,\n    # without special handling for len(a) == len(b) vs len(a) > len(b)\n    # and directly implementing the \"check if (needle + needle) contains haystack\" logic for rotation detection\n    # but applying it to the substring problem:\n    # Does 'a' contain any of 'b's rotations?\n    # This is equivalent to checking if 'b' is a substring of 'a+a' only if len(a) == len(b).\n    # For the general case, the design explicitly says:\n    # \"Optimized: build concat = needle + needle; for i in range(len(needle)): if concat[i:i+L] in haystack: return True.\"\n    # Let's use that specific logic directly.\n\n    len_b = len(b)\n    doubled_b = b + b # Construct b concatenated with itself\n\n    # Iterate through all possible rotations of b (which are substrings of doubled_b)\n    # and check if any of them exist in 'a'.\n    for i in range(len_b):\n        rotation = doubled_b[i : i + len_b]\n        if rotation in a:\n            return True\n\n    return False", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["efef", "fee"]], "plus_fail_tests": [["banana", "nab"]]}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the difference between uppercase and lowercase letters.\n    Returns the class name combined with the strongest extension name.\n    \"\"\"\n    if not extensions:\n        return \"\" # As per no exceptions rule, return empty string for empty list, though problem implies non-empty.\n\n    strongest_extension_name = \"\"\n    max_strength = -float('inf') # Initialize with a very low strength\n\n    for i, ext in enumerate(extensions):\n        caps = sum(1 for char in ext if char.isupper())\n        lowers = sum(1 for char in ext if char.islower())\n        current_strength = caps - lowers\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext\n        # The problem states: \"If there are two or more extensions with the same strength,\n        # you should choose the one that comes first in the list.\"\n        # This is implicitly handled by only updating if current_strength > max_strength,\n        # not current_strength >= max_strength.\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strength of each extension and returns the strongest one.\n    Strength is CAP - SM, where CAP is uppercase count and SM is lowercase count.\n    \"\"\"\n    strongest_extension_name = None\n    max_strength = -float('inf')  # Initialize with a very low number to ensure first extension is picked\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        # If the current extension has a higher strength, it becomes the strongest.\n        # The strict '>' comparison ensures that if strengths are equal,\n        # the first extension encountered (due to list order) remains the strongest.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n    \n    # Format the result string as required.\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    result = []\n    current_num = number\n\n    # Iterate through the Roman numeral map from largest to smallest value.\n    for value, symbol in roman_map:\n        count = current_num // value\n        result.append(symbol * count)\n        current_num -= value * count\n        # Optimization: if current_num becomes zero, all parts have been converted.\n        if current_num == 0:\n            break\n\n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result_parts = []\n    current_number = number\n    for value, numeral in roman_map:\n        while current_number >= value:\n            result_parts.append(numeral)\n            current_number -= value\n\n    return \"\".join(result_parts).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    \n    epsilon = 1e-9 # Numeric tolerance for float comparisons.\n\n    # Define an inline helper for float comparison as specified in design context.\n    def _almost_equal_inline(val1, val2, eps):\n        return abs(val1 - val2) <= eps * max(1.0, abs(val1), abs(val2))\n\n    # Sort the sides to identify the two shorter legs and the potential hypotenuse.\n    sides = sorted([a, b, c])\n    \n    # Assign the sorted sides: x and y are the legs, z is the longest side (hypotenuse candidate).\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem: a^2 + b^2 = c^2.\n    # Use the inline almost_equal function for float precision.\n    return _almost_equal_inline(x*x + y*y, z*z, epsilon)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Define a default tolerance for floating point comparisons, as suggested in design context.\n    DEFAULT_TOLERANCE = 1e-9\n\n    # Ensure all sides are positive numbers.\n    if not (isinstance(a, (int, float)) and isinstance(b, (int, float)) and isinstance(c, (int, float))):\n        return False\n    \n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Sort the sides to easily identify the potential hypotenuse (z).\n    x, y, z = sorted([float(a), float(b), float(c)])\n\n    # Check the triangle inequality: the sum of the lengths of any two sides of a triangle must be greater than the length of the third side.\n    if not (x + y > z):\n        return False\n\n    # Apply the Pythagorean theorem: a^2 + b^2 = c^2, using sorted sides x, y, z where z is the hypotenuse.\n    # Use a tolerance for floating-point comparison, scaled by the magnitude of the largest side squared.\n    if abs(x*x + y*y - z*z) <= DEFAULT_TOLERANCE * max(1.0, z*z):\n        return True\n    else:\n        return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicograph