acter to a new character based on the shift.\"\"\"\n        if not ch or len(ch) != 1 or not ch.isalpha():\n            raise ValueError(\"map_vowel expects a single alphabetic character\")\n        is_upper = ch.isupper()\n        idx = self._alphabet.index(ch.lower())\n        mapped = self._alphabet[(idx + self._shift) % len(self._alphabet)]\n        return mapped.upper() if is_upper else mapped\nclass CharTransformer:\n    \"\"\"Applies character-specific transformations (vowel mapping, case swap).\"\"\"\n    def __init__(self, vowel_mapper: VowelMapper) -> None:\n        self._vowel_mapper = vowel_mapper\n\n    def transform_char(self, ch: str) -> str:\n        \"\"\"Transforms a single character based on encoding rules.\"\"\"\n        if ch == ' ':\n            return ch\n        if ch.lower() in _VOWELS:\n            mapped = self._vowel_mapper.map_vowel(ch)\n        else:\n            mapped = ch\n        # Swap case for final output.\n        return mapped.swapcase()\n\n    def transform(self, message: str) -> str:\n        \"\"\"Transforms an entire message by applying character transformations.\"\"\"\n        return ''.join(self.transform_char(ch) for ch in message)\nclass EncoderService:\n    \"\"\"Orchestrates message validation and character transformation.\"\"\"\n    def __init__(self, char_transformer: CharTransformer, validator: Validator) -> None:\n        self._char_transformer = char_transformer\n        self._validator = validator\n\n    def encode(self, message: str) -> str:\n        \"\"\"Encodes a message by validating and transforming its characters.\"\"\"\n        self._validator.validate_message(message)\n        return self._char_transformer.transform(message)\n_default_encoder = EncoderService(\n    char_transformer=CharTransformer(VowelMapper()),\n    validator=Validator()\n)\ndef encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a \n    way that it swaps case of all letters, replaces all vowel