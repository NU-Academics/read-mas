   def __init__(self, extractor: CharSetExtractor = None, validator: InputValidator = None) -> None:\n        self._extractor = extractor or CharSetExtractor()\n        self._validator = validator or InputValidator()\n\n    def are_same_chars(self, a: str, b: str) -> bool:\n        self._validator.validate_string(a, \"s0\")\n        self._validator.validate_string(b, \"s1\")\n        return self._extractor.extract(a) == self._extractor.extract(b)\nclass CoreFacade:\n    def __init__(self, service: SameCharsService = None) -> None:\n        self._service = service or SameCharsService(CharSetExtractor(), InputValidator())\n\n    def are_same(self, a: str, b: str) -> bool:\n        return self._service.are_same_chars(a, b)\ndef same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    \"\"\"\n    return CoreFacade().are_same(s0, s1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters, ignoring multiplicity and order.\n    None inputs are treated as empty strings.\n    \"\"\"\n    chars0 = set(s0 or \"\")\n    chars1 = set(s1 or \"\")\n    return chars0 == chars1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/55": [{"task_id": "HumanEval/55", "solution": "import logging\nimport time\nfrom abc import ABC, abstractmethod\nclass FibError(Exception):\n    \"\"\"Base exception for Fibonacci service errors.\"\"\"\n    pass\nclass ValidationError(FibError):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    pass\nclass AppConfig:\n    \"\"\"Centralized configuration for the Fibonacci application.\"\"\"\n    DEFAULT_MAX_N: int = 10_000_000\n    DEFAULT_CACHE_TTL: int = 3600 # 1 hour\n\n    def __init__(self, max_n: int = DEFAULT_MAX_N, cache_ttl: int = DEFAULT_CACHE_TTL):\n        self.max_n = max_n\n        self.cache_ttl = cache_ttl\n        # cache_backend and redis_url are part of the full design but not strictly needed for this `fib` func's context here.\nclass FibResult:\n    \"\"\"Data Transfer Object for Fibonacci results.\"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a serializable dictionary representation of the result.\"\"\"\n        return {\"n\": self.n, \"value\": self.value}\nclass InputValidator:\n    \"\"\"Validates input 'n' against defined rules.\"\"\"\n    def validate_n(self, n: int, max_n: int) -> None:\n        \"\"\"Raises ValidationError if n is invalid.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(f\"Input 'n' must be an integer, got {type(n).__name__}\")\n        if n < 0:\n            raise ValidationError(\"Input 'n' cannot be negative.\")\n        if n > max_n:\n            raise ValidationError(f\"Input 'n' exceeds maximum allowed value of {max_n}.\")\ndef setup_logger(name: str = \"fib_app\") -> logging.Logger:\n    \"\"\"Sets up and returns a logger instance.\"\"\"\n    logger = logging.getLogger(name)\n    if not logger.handlers:\n        handler = logging.StreamHandler()\n        formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n        handler.setFormatter(formatter)\n        logger.addHandler(handler)\n        logger.setLevel(logging.INFO) # Default log level\n    return logger\nclass FibonacciCalculator:\n    \"\"\"Provides pure computation algorithms for Fibonacci numbers.\"\"\"\n    def iterative(self, n: int) -> int:\n        \"\"\"Computes F(n) using an O(n) iterative method.\"\"\"\n        if n == 0:\n            return 0\n        a, b = 0, 1\n        for _ in range(1, n):\n            a, b = b, a + b\n        return b\n\n    def fast_doubling(self, n: int) -> int:\n        \"\"\"Computes F(n) in O(log n) using the fast-doubling algorithm.\"\"\"\n        if n == 0:\n            return 0\n\n        # Helper to compute (F(k), F(k+1))\n        def _fib_pair(k):\n            if k == 0:\n                return (0, 1) # (F(0), F(1))\n            \n            a, b = _fib_pair(k // 2) # (F(k/2), F(k/2 + 1))\n            \n            # F(2k) = F(k) * (2*F(k+1) - F(k))\n            fk_2k = a * (2 * b - a)\n            \n            # F(2k+1) = F(k+1)^2 + F(k)^2\n            fk_2k_plus_1 = b*b + a*a\n            \n            if k % 2 == 0: # k is even\n                return (fk_2k, fk_2k_plus_1)\n            else: # k is odd, need F(2k+1) and F(2k+2)\n                return (fk_2k_plus_1, fk_2k_plus_1 + fk_2k)\n\n        res, _ = _fib_pair(n)\n        return res\nclass CacheRepository(ABC):\n    \"\"\"Abstract Base Class for cache repositories.\"\"\"\n    @abstractmethod\n    def get(self, key: str) -> int | None:\n        \"\"\"Retrieves a value from the cache.\"\"\"\n        pass\n\n    @abstractmethod\n    def set(self, key: str, value: int, ttl: int | None = None) -> None:\n        \"\"\"Stores a value in the cache with an optional time-to-live.\"\"\"\n        pass\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"An in-memory implementation of CacheRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[str, int] = {}\n        self._expirations: dict[str, float] = {}\n\n    def get(self, key: str) -> int | None:\n        \"\"\"Retrieves a value from the in-memory cache.\"\"\"\n        expiration_time = self._expirations.get(key)\n        if expiration_time is not None and time.time() > expiration_time:\n            self._store.pop(key, None)\n            self._expirations.pop(key, None)\n            return None\n        return self._store.get(key)\n\n    def set(self, key: str, value: int, ttl: int | None = None) -> None:\n        \"\"\"Stores a value in the in-memory cache.\"\"\"\n        self._store[key] = value\n        if ttl is not None:\n            self._expirations[key] = time.time() + ttl\n        else:\n            self._expirations.pop(key, None) # No TTL, remove if existed\nclass FibonacciService:\n    \"\"\"Orchestrates Fibonacci number computation, including validation, caching, and algorithm selection.\"\"\"\n    def __init__(self, calculator: FibonacciCalculator, cache: CacheRepository, validator: InputValidator, config: AppConfig, logger: logging.Logger):\n        self._calculator = calculator\n        self._cache = cache\n        self._validator = validator\n        self._config = config\n        self._logger = logger\n\n    def _cache_key(self, n: int) -> str:\n        \"\"\"Generates a cache key for a given Fibonacci number 'n'.\"\"\"\n        return f\"fib:{n}\"\n\n    def compute(self, n: int) -> FibResult:\n        \"\"\"Computes the n-th Fibonacci number, utilizing cache and validation.\"\"\"\n        self._validator.validate_n(n, self._config.max_n)\n\n        key = self._cache_key(n)\n        try:\n            cached = self._cache.get(key)\n            if cached is not None:\n                self._logger.debug(f\"Cache hit for fib({n})\")\n                return FibResult(n=n, value=cached)\n        except Exception:\n            self._logger.exception(f\"Cache get failed for fib({n}), continuing with computation\")\n\n        value = self._calculator.fast_doubling(n) # Using fast-doubling as per design\n        \n        try:\n            self._cache.set(key, value, ttl=self._config.cache_ttl)\n            self._logger.debug(f\"Cache set for fib({n})\")\n        except Exception:\n            self._logger.exception(f\"Cache set failed for fib({n}), continuing without caching\")\n            \n        return FibResult(n=n, value=value)\n_logger = setup_logger(__name__)\n_app_config = AppConfig()\n_input_validator = InputValidator()\n_fib_calculator = FibonacciCalculator()\n_cache_repository: CacheRepository = InMemoryCacheRepository()\n_fib_service = FibonacciService(\n    calculator=_fib_calculator,\n    cache=_cache_repository,\n    validator=_input_validator,\n    config=_app_config,\n    logger=_logger\n)\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    # Delegates the computation to the pre-initialized FibonacciService.\n    result = _fib_service.compute(n)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/55", "solution": "import logging\nimport time\nimport threading\nfrom abc import ABC, abstractmethod\nfrom datetime import datetime, timezone\nfrom typing import Optional, Dict, Tuple, Any\n_logger = logging.getLogger(__name__)\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when input n is invalid.\"\"\"\n    pass\nclass AppConfig:\n    \"\"\"Application configuration with default values.\"\"\"\n    def __init__(self, cache_ttl: int = 3600, max_n: int = 10_000_000, redis_url: Optional[str] = None):\n        self.cache_ttl = cache_ttl\n        self.max_n = max_n\n        self.redis_url = redis_url\nclass FibonacciResult:\n    \"\"\"DTO for a computed Fibonacci result.\"\"\"\n    def __init__(self, n: int, value: int, cached: bool, computed_at: datetime):\n        self.n = n\n        self.value = value\n        self.cached = cached\n        self.computed_at = computed_at\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a JSON-serializable dictionary representation.\"\"\"\n        return {\n            \"n\": self.n,\n            \"value\": self.value,\n            \"cached\": self.cached,\n            \"computed_at\": self.computed_at.isoformat()\n        }\nclass CacheRepository(ABC):\n    \"\"\"Abstract base class for cache repositories.\"\"\"\n    @abstractmethod\n    def get(self, key: str) -> Optional[int]:\n        pass\n\n    @abstractmethod\n    def set(self, key: str, value: int, ttl: Optional[int]) -> None:\n        pass\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"In-memory implementation of CacheRepository.\"\"\"\n    def __init__(self):\n        self._store: Dict[str, Tuple[int, float]] = {}\n        self._lock = threading.Lock()\n\n    def get(self, key: str) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache if it exists and is not expired.\"\"\"\n        with self._lock:\n            entry = self._store.get(key)\n            if not entry:\n                return None\n            value, expiry = entry\n            if expiry != 0 and time.time() > expiry:\n                del self._store[key]\n                return None\n            return value\n\n    def set(self, key: str, value: int, ttl: Optional[int]) -> None:\n        \"\"\"Stores a value in the cache with an optional time-to-live.\"\"\"\n        expiry = (time.time() + ttl) if ttl is not None else 0\n        with self._lock:\n            self._store[key] = (value, expiry)\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the in-memory cache.\"\"\"\n        with self._lock:\n            self._store.clear()\nclass FibCalculator:\n    \"\"\"Computes Fibonacci numbers efficiently using the fast doubling method.\"\"\"\n    def fast_doubling(self, n: int) -> int:\n        \"\"\"Calculates the n-th Fibonacci number.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"n must be >= 0 for Fibonacci calculation.\")\n        return self._fast_doubling_rec(n)[0]\n\n    def _fast_doubling_rec(self, n: int) -> Tuple[int, int]:\n        \"\"\"Recursive helper for fast doubling, returns (F(n), F(n+1)).\"\"\"\n        if n == 0:\n            return (0, 1)\n\n        a, b = self._fast_doubling_rec(n // 2)\n        c = a * (2 * b - a)\n        d = a * a + b * b\n\n        if n % 2 == 0:\n            return (c, d)\n        else:\n            return (d, c + d)\ndef key_for_n(n: int) -> str:\n    \"\"\"Generates a cache key for a given n.\"\"\"\n    return f\"fib:{n}\"\nclass FibonacciService:\n    \"\"\"Orchestrates Fibonacci number computation, caching, and validation.\"\"\"\n    def __init__(self, repo: CacheRepository, calculator: FibCalculator, config: AppConfig, logger: logging.Logger):\n        self.repo = repo\n        self.calculator = calculator\n        self.config = config\n        self.logger = logger\n\n    def compute(self, n: int, use_cache: bool = True) -> FibonacciResult:\n        \"\"\"Computes the n-th Fibonacci number, utilizing cache if enabled.\"\"\"\n        validate_n(n, self.config.max_n)\n        key = key_for_n(n)\n        \n        if use_cache:\n            try:\n                cached = self.repo.get(key)\n                if cached is not None:\n                    self.logger.debug(f\"Cache hit for fib({n})\")\n                    return FibonacciResult(n=n, value=cached, cached=True, computed_at=datetime.now(timezone.utc))\n            except Exception as e:\n                self.logger.warning(f\"Cache get failed for fib({n}): {e}\")\n        \n        self.logger.debug(f\"Cache miss or bypassed for fib({n}), computing...\")\n        value = self.calculator.fast_doubling(n)\n        \n        try:\n            if use_cache:\n                self.repo.set(key, value, self.config.cache_ttl)\n                self.logger.debug(f\"Cached fib({n}) with value {value}\")\n        except Exception as e:\n            self.logger.warning(f\"Cache set failed for fib({n}): {e}\")\n            \n        return FibonacciResult(n=n, value=value, cached=False, computed_at=datetime.now(timezone.utc))\n_fib_config = AppConfig()\n_fib_calculator = FibCalculator()\n_fib_cache_repo = InMemoryCacheRepository()\n_fib_service = FibonacciService(repo=_fib_cache_repo, calculator=_fib_calculator, config=_fib_config, logger=_logger)\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    # The service handles validation, caching, and computation according to design.\n    # It returns a FibonacciResult, so we extract the integer value.\n    result = _fib_service.compute(n, use_cache=True)\n    return result.value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[10]], "plus_fail_tests": [[0]]}], "HumanEval/56": [{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n\n        if balance < 0:\n            return False\n\n    return balance == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    stack = 0\n    for char in brackets:\n        if char == \"<\":\n            stack += 1\n        elif char == \">\":\n            if stack == 0:\n                return False\n            stack -= 1\n    return stack == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/57": [{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a list with a single element is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    increasing = True\n    decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            increasing = False\n        if l[i] < l[i+1]:\n            decreasing = False\n        if not increasing and not decreasing:\n            return False\n\n    return True", "base_status": "pas