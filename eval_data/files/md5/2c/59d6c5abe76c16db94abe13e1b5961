p of parentheses.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n            # Note: Error checks for unbalanced parentheses (e.g., current_depth < 0\n            # or current_depth != 0 at the end) are explicitly omitted as per\n            # the \"DO NOT add isinstance() checks or raise exceptions for edge cases\" instruction.\n        return max_depth\n\n    groups = _split_groups(paren_string)\n    \n    results = []\n    for group in groups:\n        depth = _compute_max_depth(group)\n        results.append(depth)\n        \n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/6", "solution": "class ParseError(Exception):\n    \"\"\"Custom exception for parsing-related errors with metadata.\"\"\"\n    def __init__(self, message: str, group_index: int | None = None, group: str | None = None) -> None:\n        self.message = message\n        self.group_index = group_index\n        self.group = group\n        super().__init__(self.__str__())\n\n    def __str__(self) -> str:\n        details = []\n        if self.group_index is not None:\n            details.append(f\"group_index={self.group_index}\")\n        if self.group is not None:\n            details.append(f\"group='{self.group}'\")\n        detail_str = f\" ({', '.join(details)})\" if details else \"\"\n        return f\"ParseError: {self.message}{detail_str}\"\nclass InputValidator:\n    \"\"\"Validates raw input and group content, splitting the input string into groups.\"\"\"\n    ALLOWED_CHARS = {'(', ')'}\n\n    def validate_input(self, s: str) -> list[str]:\n        # Requirement: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # The type hint `paren_string: str` implies input is a string.\n        raw = s.split()\n        cleaned_groups = [g for g in raw if g != \"\"]\n        return cleaned_groups\n\n    def validate_group(self, group: str) -> None:\n        \"\"\"Ensures a group contains only allowed characters.\"\"\"\n        if any(ch not in self.ALLOWED_CHARS for ch in group):\n            raise ParseError(\"Group contains invalid characters\", group=group)\nclass ParenParser:\n    \"\"\"Core algorithm to compute nesting depth for a single group and multiple groups.\"\"\"\n    def compute_depth(self, group: str) -> int:\n        \"\"\"Computes the maximum nesting depth for a single parenthesis group.\"\"\"\n        cur = 0\n        max_depth = 0\n        for i, ch in enumerate(group):\n            if ch == '(':\n                cur += 1\n                if cur > max_depth:\n                    max_depth = cur\n            elif ch == ')':\n                cur -= 1\n                if cur < 0:\n                    raise ParseError(\"Unbalanced: closing without opening\", group_index=None, group=group)\n            # The validate_group method in InputValidator should catch invalid characters earlier.\n            # However, for robustness, including a check here.\n            else:\n                 raise ParseError(\"Invalid character encountered during depth computation\", group_index=None, group=group)\n        if cur != 0:\n            raise ParseError(\"Unbalanced: mismatched parentheses\", group_index=None, group=group)\n        return max_depth\n\n    def compute_depths(self, groups: list[str], ignore_errors: bool = False) -> list[int]:\n        \"\"\"Computes depths for multiple groups, optionally ignoring errors.\"\"\"\n        results = []\n        for idx, group in enumerate(groups):\n            try:\n                # First validate the characters in the group\n                InputValidator().validate_group(group) # Re-instantiate as InputValidator is stateless\n                depth = self.compute_depth(group)\n                results.append(depth)\n            except ParseError as e:\n                if not ignore_errors:\n                    # Enrich error with group index before re-raising\n                    e.group_index = idx\n                    raise e\n                # If ignore_errors is True, simply skip this group\n        return results\nclass ParserService:\n    \"\"\"Orchestrates validation and parsing logic.\"\"\"\n    def __init__(self, validator: InputValidator, parser: ParenParser) -> None:\n        self.validator = validator\n        self.parser = parser\n\n    def parse_string(self, paren_string: str, ignore_errors: bool = False) -> list[int]:\n        \"\"\"Parses the input string, validates groups, and computes nesting depths.\"\"\"\n        # Validate overall input and split into groups\n        cleaned_groups = self.validator.validate_input(paren_string)\n\n        # Compute depths for all groups\n        depths = self.parser.compute_depths(cleaned_groups, ignore_errors=ignore_errors)\n        return depths\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    validator = InputValidator()\n    parser = ParenParser()\n    service = ParserService(validator, parser)\n    return service.parse_string(paren_string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/7": [{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The filtering is case-sensitive and preserves the original order of elements.\n    \"\"\"\n    return [s for s in strings if substring in s]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = sum(numbers)\n\n    total_product = 1\n    for num in numbers:\n        total_product *= num\n\n    return (total_sum, total_product)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution":