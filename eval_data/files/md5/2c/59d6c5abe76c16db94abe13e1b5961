 half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    TOKEN_MAP = {\"o\": 4, \"o|\": 2, \".|\": 1}\n    \n    # Split the music string into individual tokens based on whitespace.\n    # The default split() method handles multiple spaces and leading/trailing spaces correctly.\n    tokens = music_string.split()\n    \n    # Map each token to its corresponding beat value using the TOKEN_MAP.\n    beats = [TOKEN_MAP[token] for token in tokens]\n    \n    return beats", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/17", "solution": "from typing import List, Optional, Dict\nclass ParseError(Exception):\n    \"\"\"Domain-specific error for parsing issues, carrying token and position info.\"\"\"\n    def __init__(self, message: str, token: Optional[str]=None, position: Optional[int]=None) -> None:\n        super().__init__(message)\n        self.token = token\n        self.position = position\nclass Tokenizer:\n    \"\"\"Converts a raw music string into a list of individual tokens.\"\"\"\n    def __init__(self, sep_pattern: Optional[str]=None) -> None:\n        self.sep_pattern = sep_pattern or None\n\n    def tokenize(self, music_string: str) -> List[str]:\n        if not music_string or music_string.strip() == \"\":\n            return []\n        # split() without args splits on any whitespace and handles multiple spaces\n        return music_string.strip().split(self.sep_pattern)\nclass MusicParser:\n    \"\"\"Validates tokens and maps them to their corresponding beat durations.\"\"\"\n    SUPPORTED_TOKENS: Dict[str, int] = {\"o\": 4, \"o|\": 2, \".|\": 1}\n\n    def __init__(self, tokenizer: Tokenizer) -> None:\n        self.tokenizer = tokenizer\n\n    def parse(self, tokens: List[str]) -> List[int]:\n        result = []\n        for i, t in enumerate(tokens):\n            result.append(self._map_token(t, i))\n        return result\n\n    def _map_token(self, token: str, index: int) -> int:\n        if token in self.SUPPORTED_TOKENS:\n            return self.SUPPORTED_TOKENS[token]\n        raise ParseError(f\"Invalid token '{token}'\", token=token, position=index)\nclass ParseService:\n    \"\"\"Orchestrates tokenization and parsing of a music string.\"\"\"\n    def __init__(self, parser: MusicParser) -> None:\n        self.parser = parser\n\n    def parse(self, music_string: str, save: bool=False) -> List[int]:\n        tokens = self.parser.tokenizer.tokenize(music_string)\n        beats = self.parser.parse(tokens)\n        return beats\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    tokenizer = Tokenizer()\n    parser = MusicParser(tokenizer)\n    service = ParseService(parser)\n    return service.parse(music_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/19": [{"task_id": "HumanEval/19", "solution": "class ValidationError(Exception):\n    def __init__(self, invalid_tokens: List[str], message: str = 'Invalid numeral tokens found.'):\n        self.invalid_tokens = invalid_tokens\n        self.message = message\n        super().__init__(self.message + f\" Invalid tokens: {', '.join(invalid_tokens)}\")\nclass MappingError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass Utils:\n    MAX_TOKENS = 10000\n\n    @staticmethod\n    def split_input(text: str) -> List[str]:\n        return [token for token in text.strip().split() if token]\n\n    @staticmethod\n    def join_output(words: List[str]) -> str:\n        return ' '.join(words)\nclass NumeralMapper:\n    WORD_TO_INT = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    INT_TO_WORD = {v: k for k, v in WORD_TO_INT.items()}\n\n    def word_to_int(self, word: str) -> int:\n        key = word.lower()\n        if key not in self.WORD_TO_INT:\n            raise MappingError(f\"Unknown numeral word: {word}\")\n        return self.WORD_TO_INT[key]\n\n    def int_to_word(self, n: int) -> str:\n        if n not in self.INT_TO_WORD:\n            raise MappingError(f\"Integer {n} is out of range (0-9).\")\n        return self.INT_TO_WORD[n]\n\n    def is_valid_word(self, word: str) -> bool:\n        return word.lower() in self.WORD_TO_INT\n\n    def valid_words(self) -> List[str]:\n        return list(self.WORD_TO_INT.keys())\nclass Validator:\n    def __init__(self, mapper: NumeralMapper):\n        self.mapper = mapper\n\n    def validate_input(self, text: str) -> List[str]:\n        tokens = Utils.split_input(text)\n        invalid = [t for t in tokens if not self.mapper.is_valid_word(t)]\n        if invalid:\n            raise ValidationError(invalid)\n        return [t.lower() for t in tokens]\nclass SortService:\n    def __init__(self, mapper: NumeralMapper, validator: Validator):\n        self.mapper = mapper\n        self.validator = validator\n\n    def sort_words(self, words: List[str]) -> List[str]:\n        nums = [self.mapper.word_to_int(w) for w in words]\n        nums.sort()\n        return [self.mapper.int_to_word(n) for n in nums]\n\n    def sort_text(self, text: str) -> str:\n        normalized_tokens = self.validator.validate_input(text)\n        sorted_tokens = self.sort_words(normalized_tokens)\n        return Utils.join_output(sorted_tokens)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    mapper = NumeralMapper()\n    validator = Validator(mapper)\n    service = SortService(mapper, validator)\n    return service.sort_text(numbers)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/19", "solution": "VALID_WORDS = [\"zero\", \"one\", \"two\", \"three\", \"four\", \"five\", \"six\", \"seven\", \"eight\", \"nine\"]\nWORD_TO_INT = {word: i for i, word in enumerate(VALID_WORDS)}\nINT_TO_WORD = {i: word for i, word in enumerate(VALID_WORDS)}\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InvalidNumberWordError(Exception):\n    def __init__(self, invalid_tokens: List[str]) -> None:\n        super().__init__(f\"Invalid number words found: {', '.join(invalid_tokens)}\")\n        self.invalid_tokens = invalid_tokens\nclass MappingError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass NumberToken:\n    def __init__(self, word: str, value: int) -> None:\n        if not isinstance(word, str):\n            raise TypeError(\"Word must be a string.\")\n        if not isinstance(value, int):\n            raise TypeError(\"Value must be an integer.\")\n        self._word = word\n        self._value = value\n\n    @property\n    def word(self) -> str:\n        return self._word\n\n    @property\n    def value(self) -> int:\n        return self._value\n\n    def __repr__(self) -> str:\n        return f\"NumberToken(word='{self.word}', value={self.value})\"\ndef normalize_input(