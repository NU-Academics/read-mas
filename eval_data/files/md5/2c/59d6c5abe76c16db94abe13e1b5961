g string parsing.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass RoundingError(Exception):\n    \"\"\"Custom exception for errors during rounding or integer conversion.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass NumericUtils:\n    \"\"\"Utility methods for numeric string manipulation.\"\"\"\n    @staticmethod\n    def is_numeric_string(value: str) -> bool:\n        \"\"\"Checks if a stripped string broadly matches a numeric pattern.\"\"\"\n        if not value:\n            return False\n        # Matches optional sign, followed by digits (with optional decimal part)\n        # or a decimal part starting with '.', optionally followed by an exponent.\n        pattern = r\"^[+-]?(\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?$\"\n        return bool(re.fullmatch(pattern, value))\n\n    @staticmethod\n    def normalize_string(value: str) -> str:\n        \"\"\"Strips leading/trailing whitespace from the input string.\"\"\"\n        return value.strip()\nclass ValueParser:\n    \"\"\"Parses numeric strings into Decimal objects with validation.\"\"\"\n    DEFAULT_PRECISION = 28\n\n    def parse(self, value: str) -> Decimal:\n        \"\"\"\n        Parses a string into a Decimal, validating its format and finiteness.\n        Raises ParsingError for invalid or non-finite inputs.\n        \"\"\"\n        if value is None:\n            raise ParsingError(\"No value provided\")\n        s = NumericUtils.normalize_string(value)\n        if not s or not NumericUtils.is_numeric_string(s):\n            raise ParsingError(f\"Invalid numeric string: {value!r}\")\n        try:\n            with localcontext() as ctx:\n                ctx.prec = self.DEFAULT_PRECISION\n                dec = Decimal(s)\n        except InvalidOperation:\n            raise ParsingError(f\"Could not parse decimal from: {value!r}\")\n        if not dec.is_finite():\n            raise ParsingError(\"Value is not finite (NaN or Inf)\")\n        return dec\nclass RoundingService:\n    \"\"\"Provides rounding logic for Decimal values.\"\"\"\n    def round_to_nearest(self, value: Decimal) -> int:\n        \"\"\"\n        Rounds a Decimal to the nearest integer, rounding halves away from zero.\n        Raises RoundingError if the result is out of integer range.\n        \"\"\"\n        sign_val = Decimal(1) if value >= Decimal(0) else Decimal(-1)\n        abs_val = value.copy_abs()\n\n        # Get the integer part of the absolute value, truncated towards zero.\n        int_part_abs = abs_val.to_integral_value(rounding='ROUND_FLOOR')\n\n        # Calculate the fractional part.\n        frac = abs_val - int_part_abs\n\n        if frac < Decimal(\"0.5\"):\n            # If fractional part is less than 0.5, round towards zero.\n            res_abs = int_part_abs\n        else: # frac >= Decimal(\"0.5\"), including exactly 0.5\n            # If fractional part is 0.5 or greater, round away from zero.\n            res_abs = int_part_abs + Decimal(1)\n\n        result_decimal = res_abs * sign_val\n\n        try:\n            return int(result_decimal)\n        except (OverflowError, ValueError) as exc:\n            raise RoundingError(\"Result out of range for integer conversion\") from exc\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    parser = ValueParser()\n    service = RoundingService()\n    dec = parser.parse(value)\n    return service.round_to_nearest(dec)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-578000000007654321.12345"]]}, {"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    '''\n    import re\n    from decimal import Decimal, ROUND_HALF_UP\n\n    class InvalidNumberError(ValueError):\n        \"\"\"Custom exception for invalid numeric input.\"\"\"\n        pass\n\n    class InputValidator:\n        \"\"\"Validates that a string looks like a number.\"\"\"\n        NUMERIC_RE = re.compile(r\"^[+-]?(\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?$\")\n\n        def validate_format(self, value: str) -> None:\n            \"\"\"Raises InvalidNumberError if the string format is not numeric.\"\"\"\n            if not value:\n                raise InvalidNumberError(\"Input value cannot be empty.\")\n            if not self.NUMERIC_RE.fullmatch(value):\n                raise InvalidNumberError(f\"Invalid numeric format: '{value}'\")\n\n    class NumberParser:\n        \"\"\"Parses a string into a Decimal.\"\"\"\n        def __init__(self, validator=None):\n            self._validator = validator if validator else InputValidator()\n\n        def parse(self, value: str) -> Decimal:\n            \"\"\"Normalizes input, validates, and returns Decimal.\"\"\"\n            if value is None:\n                raise InvalidNumberError(\"Input value cannot be None.\")\n            \n            trimmed_value = value.strip()\n            self._validator.validate_format(trimmed_value)\n\n            try:\n                return Decimal(trimmed_value)\n            except Exception as e:\n                raise InvalidNumberError(f\"Failed to parse '{trimmed_value}' into a number: {e}\") from e\n\n    class RoundingService:\n        \"\"\"Implements 'round half away from zero' for Decimal values.\"\"\"\n        def round_to_closest(self, value: Decimal) -> int:\n            \"\"\"Returns the nearest integer, rounding halves away from zero.\"\"\"\n            rounded_decimal = value.quantize(Decimal('1'), rounding=ROUND_HALF_UP)\n            return int(rounded_decimal)\n\n    validator_instance = InputValidator()\n    parser_instance = NumberParser(validator=validator_instance)\n    rounder_instance = RoundingService()\n\n    decimal_value = parser_instance.parse(value)\n    return rounder_instance.round_to_closest(decimal_value)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-578000000007654321.12345"]]}], "HumanEval/100": [{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    pile = []\n    current_stones = n\n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n\n    return pile", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n    \"\"\"\n    levels = []\n    current_stones = n\n    step = 2  # The increment is always 2 to maintain parity\n    for _ in range(n):\n        levels.append(current_stones)\n        current_stones += step\n    return levels", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/101": [{"task_id": "HumanEval/101", "solution": "import re\ndef words_string(s):\n    \"\"\"\n    Splits a string into words, handling commas and spaces as separators.\n    Strips leading/trailing punctuation from each word.\n    \"\"\"\n    if not s:\n        return []\n\n    # Replace all specified separators with a single space\n    # The design context indicates \"commas, spaces, tabs, newlines, or combinations.\"\n    # The example snippet in the design context used re.sub(r\"[{},\\t\\n]+\".format(\"\"), \" \", text)\n    # which implies we should handle spaces too.\n    # The full set of separators in `DEFAULT_SEPARATORS` from the design context is \", \\t\\n\".\n    normalized = re.sub(r\"[, \\t\\n]+\", \" \", s)\n\n    # Split by whitespace to get raw tokens\n    raw_tokens = normalized.split()\n\n    words = []\n    punctuation_to_strip = '''.,;:?!()[]{}\"'''\n\n    for token in raw_tokens:\n        # Strip leading and trailing punctuation as per design context\n        stripped_token = token.strip(punctuation_to_strip)\n        if stripped_token:  # Only add non-empty tokens\n            words.append(stripped_token)\n\n    return words", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["Hi, my    name   is John. How     are    you?   "]]}, {"task_id": "HumanEval/101", "solution": "import re\nimport uuid\nimport datetime\nimport os\nimport json\nimport sys\nPUNCTUATION_CHARS = '.,;:!?()[]\"\\''\nDEFAULT_HISTORY_PATH = \"./wordparser_history.ndjson\"\nclass Validator:\n    \"\"\"Utility for input validation.\"\"\"\n    @staticmethod\n    def validate_input(s):\n        \"\"\"Validates that the input is a string and not None.\"\"\"\n        if s is None or not isinstance(s, str):\n            raise ValueError(\"Input must be a non-null string.\")\nclass FileHistoryRepository:\n    \"\"\"Repository for persisting history records to a local NDJSON file.\"\"\"\n    def __init__(self, path: str = DEFAULT_HISTORY_PATH):\n        self.path = path\n        self._ensure_store()\n\n    def append(self, record: dict) -> None:\n        \"\"\"Appends a record to the history file.\"\"\"\n        try:\n            with open(self.path, 'a', encoding='utf-8') as f:\n                f.write(json.dumps(record) + '\\n')\n        except IOError as e:\n            print(f\"Error writing to history file {self.path}: {e}\", file=sys.stderr)\n\n    def _ensure_store(self) -> None:\n        \"\"\"Ensures the directory for the history file exists.\"\"\"\n        os.makedirs(os.path.dirname(self.path) or '.', exist_ok=True)\n        if not os.path.exists(self.path):\n            try:\n                # Create an empty file if it doesn't exist\n                open(self.path, 'a', encoding='utf-8').close()\n            except IOError as e:\n                print(f\"Error creating history file {self.path}: {e}\", file=sys.stderr)\nclass StringNormalizer:\n    \"\"\"Normalizes tokens by stripping leading/trailing punctuation.\"\"\"\n    def __init__(self, punctuation_chars: str = PUNCTUATION_CHARS):\n        self.punctuation_chars = punctuation_chars\n        # Regex to match leading or trailing punctuation characters\n        self._trim_re = re.compile(rf'^[{re.escape(self.punctuation_chars)}]+|[{re.escape(self.punctuation_chars)}]+$')\n\n    def normalize(self, token: str) -> str:\n        \"\"\"Trims punctuation from both ends of a token.\"\"\"\n        if token is None:\n            return ''\n        t = token.strip()\n        t = self._trim_re.sub('', t)\n        return t\nclass WordList:\n    \"\"\"Data