tains only letters\n    \"\"\"\n    import re\n\n    def is_prime(num):\n        if num <= 1:\n            return False\n        if num <= 3:  # 2 and 3 are prime\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    normalized_sentence = re.sub(r'\\s+', ' ', sentence.strip())\n    \n    if not normalized_sentence:\n        return \"\"\n\n    words = normalized_sentence.split(' ')\n\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, maintaining original order for ties.\n    \"\"\"\n    def _digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of the digits of an integer.\"\"\"\n        s = 0\n        x = abs(n)\n        while x:\n            s += x % 10\n            x //= 10\n        return s\n\n    # Create tuples of (digit_sum, original_index, number)\n    # The original_index ensures stable sorting for items with the same digit_sum.\n    indexed_nums = []\n    for idx, n in enumerate(nums):\n        indexed_nums.append((_digit_sum(n), idx, n))\n\n    # Sort the list of tuples based on digit_sum, then original_index\n    indexed_nums.sort(key=lambda x: (x[0], x[1]))\n\n    # Extract the original numbers in their new sorted order\n    return [item[2] for item in indexed_nums]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}, {"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n\n    def _compute_digit_sum(n):\n        \"\"\"Computes the sum of the absolute value of digits for a number.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # Create a list of tuples: (digit_sum, original_index, original_value).\n    # This structure is used for sorting, allowing a stable tie-break by original index.\n    augmented_nums = []\n    for i, num in enumerate(nums):\n        digit_sum = _compute_digit_sum(num)\n        augmented_nums.append((digit_sum, i, num))\n\n    # Sort the augmented list using the digit_sum as the primary key\n    # and the original_index as the secondary tie-breaking key.\n    sorted_augmented_nums = sorted(augmented_nums, key=lambda x: (x[0], x[1]))\n\n    # Extract only the original integer values from the sorted list.\n    result = [item[2] for item in sorted_augmented_nums]\n\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of triples (a[i], a[j], a[k]) from the sequence a[i] = i*i - i + 1,\n    where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def _choose3(val):\n        \"\"\"Calculates combinations C(val, 3), returning 0 if val < 3.\"\"\"\n        if val < 3:\n            return 0\n        return (val * (val - 1) * (val - 2)) // 6\n\n    def _get_residue_counts(num):\n        \"\"\"\n        Determines the counts of a[i] values that are congruent to 0, 1, or 2 (mod 3)\n        for i from 1 to num, based on the pattern a[i] = i*i - i + 1.\n        \"\"\"\n        # Analyze a[i] = i*i - i + 1 (mod 3):\n        # If i % 3 == 0, then a[i] % 3 == 1\n        # If i % 3 == 1, then a[i] % 3 == 1\n        # If i % 3 == 2, then a[i] % 3 == 0\n\n        # Calculate counts of indices i (from 1 to num) for each remainder modulo 3.\n        # count_i_mod[0] = count of i where i % 3 == 0\n        # count_i_mod[1] = count of i where i % 3 == 1\n        # count_i_mod[2] = count of i where i % 3 == 2\n\n        q = num // 3\n        rem = num % 3\n\n        count_i_mod = [q] * 3 # Initialize with counts for full cycles of 3 indices.\n\n        # Adjust counts for the remaining elements (rem), considering 1-based indexing.\n        # Indices 1, 4, 7... have i % 3 == 1.\n        # Indices 2, 5, 8... have i % 3 == 2.\n        # Indices 3, 6, 9... have i % 3 == 0.\n        if rem >= 1:\n            count_i_mod[1] += 1\n        if rem >= 2:\n            count_i_mod[2] += 1\n        # count_i_mod[0] already correct for i%3==0 (multiples of 3)\n\n        # Map these counts to the residues of a[i] modulo 3.\n        count0_a = count_i_mod[2]  # a[i] % 3 == 0 if i % 3 == 2\n        count1_a = count_i_mod[0] + count_i_mod[1] # a[i] % 3 == 1 if i % 3 == 0 or i % 3 == 1\n        count2_a = 0  # a[i] % 3 is never 2 for any i.\n\n        return (count0_a, count1_a, count2_a)\n\n    # Get the counts of a[i] values for each residue modulo 3.\n    r0, r1, r2 = _get_residue_counts(n)\n\n    # The sum (a[i] + a[j] + a[k]) is a multiple of 3 if (residue_i + residue_j + residue_k) % 3 == 0.\n    # Possible combinations of residues (modulo 3) that sum to a multiple of 3 are:\n    # 1. (0, 0, 0)\n    # 2. (1, 1, 1)\n    # 3. (2, 2, 2) - This case is impossible because r2 is always 0.\n    # 4. (0, 1, 2) - This case is impossible because r2 is always 0.\n\n    total_triples = _choose3(r0)  # Count triples of numbers with residue 0.\n    total_triples += _choose3(r1)  # Count triples of numbers with residue 1.\n    total_triples += _choose3(r2)  # Count triples of numbers with residue 2 (always 0).\n    total_triples += r0 * r1 * r2  # Count triples with one of each residue (always 0).\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    The sequence a is defined by a[i] = i*i - i + 1.\n    \"\"\"\n\n    def n_choose_k(N, K):\n        \"\"\"Calculates N choose K using integer arithmetic, returning 0 for invalid K.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K\n\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    if n < 3:\n        return 0\n\n    # The residue pattern for a[i] = i*i - i + 1 modulo 3 is:\n    # i % 3 == 0 => a[i] % 3 == 1\n    # i % 3 == 1 => a[i] % 3 == 1\n    # i % 3 == 2 => a[i] % 3 == 0\n    #\n    # So, a[i] % 3 == 0 when i % 3 == 2\n    # a[i] % 3 == 1 when i % 3 == 0 or i % 3 == 1\n\n    # Count of elements whose value is 0 mod 3 (i.e., i % 3 == 2)\n    # For i = 1 to n, these are 2, 5, 8, ...\n    # This count is floor((n + 1) / 3)\n    count_mod_0 = (n + 1) // 3\n\n    # Count of elements whose value is 1 mod 3 (i.e., i % 3 == 0 or i % 3 == 1)\n    count_mod_1 = n - count_mod_0\n\n    # A sum of three elements a[i] + a[j] + a[k] is a multiple of 3 if:\n    # 1. All three elements are 0 mod 3 (0 + 0 + 0 = 0 mod 3)\n    # 2. All three elements are 1 mod 3 (1 + 1 + 1 = 3 = 0 mod 3)\n    # Other combinations (e.g., 0+0+1, 0+1+1) do not sum to 0 mod 3.\n\n    # Number of ways to choose 3 elements from count_mod_0\n    triples_0_mod_3 = n_choose_k(count_mod_0, 3)\n\n    # Number of ways to choose 3 elements from count_mod_1\n    triples_1_mod_3 = n_choose_k(count_mod_1, 3)\n\n    return triples_0_mod_3 + triples_1_mod_3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both \n    first and last digits odd (1, 3, 5, 7, 9).\n    \"\"\"\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for item in nums:\n        # Convert item to integer, ignoring non-numeric or None types implicitly\n        # as per \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # Assume item can be converted to int.\n        num = int(item)\n        \n        # Check if the number is greater than 10\n        if num > 10:\n            # Use absolute value for digit extraction\n            s_num = str(abs(num))\n            \n            # Extract first and last digits\n            first_digit = int(s_num[0])\n            last_digit = int(s_num[-1])\n            \n            # Check if both first and last digits are odd\n            if first_digit in odd_digits and last_digit in odd_digits:\n                count += 1\n                \n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 with both first and last digits odd.\"\"\"\n\n    ODD_DIGITS = {1, 3, 5, 7, 9}\n\n    def _is_odd_digit(d: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return d in ODD_DIGITS\n\n    def _first_digit(n: int) -> int:\n        \"\"\"Extracts the first decimal digit of the absolute value of n.\"\"\"\n        n_abs = abs(n)\n        if n_abs == 0:\n            return 0\n        while n_abs >= 10:\n            n_abs //= 10\n        return n_abs\n\n    def _last_digit(n: int) -> int:\n        \"\"\"Extracts the last decimal digit of the absolute value of n.\"\"\"\n        return abs(n) % 10\n\n    count = 0\n    for num in nums:\n        # Assumes num is an integer or can be safely converted to one.\n        current_num_val = int(num)\n\n        if current_num_val > 10:\n            first = _first_digit(current_num_val)\n            last = _last_digit(current_num_val)\n            if _is_odd_digit(first) and _is_odd_digit(last):\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    \n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n    \n    p1_norm = planet1.strip().title()\n    p2_norm = planet2.strip().title()\n\n    try:\n        idx1 = planets.index(p1_norm)\n        idx2 = planets.index(p2_norm)\n    except ValueError:\n        return ()\n\n    if idx1 == idx2:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    return tuple(planets[start_idx + 1:end_idx])