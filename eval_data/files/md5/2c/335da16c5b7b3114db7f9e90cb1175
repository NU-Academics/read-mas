{"task_id": "HumanEval/128", "solution": "from .prod_signs import prod_signs\nfrom typing import List, Optional\nclass IntegerList:\n    \"\"\"Analysis class: encapsulates a List[int] and offers simple queries.\"\"\"\n    def __init__(self, data: List[int]):\n        self.data = data\n\n    def is_empty(self) -> bool:\n        return not self.data\n\n    def contains_zero(self) -> bool:\n        return 0 in self.data\n\n    def __iter__(self):\n        return iter(self.data)\nclass SignMapper:\n    \"\"\"Map an integer to its sign value: +1, \u20131 or 0.\"\"\"\n    def __init__(self):\n        pass\n\n    def map(self, value: int) -> int:\n        if value > 0:\n            return 1\n        if value < 0:\n            return -1\n        return 0\nclass Accumulator:\n    \"\"\"Accumulates sign product and sum of absolute values.\"\"\"\n    def __init__(self):\n        self.product_sign = 1\n        self.sum_abs = 0\n\n    def add(self, value: int, sign: int) -> None:\n        # If product_sign is already 0, it remains 0.\n        # This condition is robust even though ProdSignsService handles zero early.\n        if self.product_sign != 0:\n            self.product_sign *= sign\n        self.sum_abs += abs(value)\n\n    def result(self) -> int:\n        return self.product_sign * self.sum_abs\nclass ProdSignsService:\n    \"\"\"Public service implementing the prod_signs function logic.\"\"\"\n    @staticmethod\n    def compute(arr: List[int]) -> Optional[int]:\n        \"\"\"Return product of sign values times sum of absolute values.\"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"arr must be a list of integers\")\n\n        int_list = IntegerList(arr)\n        if int_list.is_empty():\n            return None\n        if int_list.contains_zero():\n            return 0\n\n        mapper = SignMapper()\n        accumulator = Accumulator()\n\n        for val in int_list:\n            sign = mapper.map(val)\n            accumulator.add(val, sign)\n\n        return accumulator.result()\nprod_signs = ProdSignsService.compute"}
{"task_id": "HumanEval/129", "solution": "import typing\ndef minPath(grid: typing.List[typing.List[int]], k: int) -> typing.List[int]:\n    \"\"\"\n    Returns the lexicographically minimal sequence of values of a path of length `k`\n    on the given `grid`. The path can start from any cell, move only to\n    orthogonally adjacent cells, and may revisit cells.\n    All values in `grid` are distinct and form the set {1, 2, ..., N*N}.\n\n    Parameters\n    ----------\n    grid : List[List[int]]\n        N x N grid with unique integers from 1 to N*N.\n    k : int\n        Desired length of the path (number of cells visited).\n\n    Returns\n    -------\n    List[int]\n        The values on the cells along the minimal path.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    n = len(grid)\n    if n == 0 or k > 10000:   # guard against extreme cases\n        return []\n\n    # Locate the cell containing the value 1 \u2013 the inevitable start.\n    start_i = start_j = None\n    for i in range(n):\n        for j in range(n):\n            if grid[i][j] == 1:\n                start_i, start_j = i, j\n                break\n        if start_i is not None:\n            break\n\n    # If 1 is missing (should not happen given the constraints) return empty.\n    if start_i is None:\n        return []\n\n    # Precompute neighbor offsets.\n    neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    path_vals = [1]\n    cur_i, cur_j = start_i, start_j\n\n    for _ in range(1, k):          # already placed first cell\n        min_val = None\n        next_i = next_j = None\n        for di, dj in neighbors:\n            ni, nj = cur_i + di, cur_j + dj\n            if 0 <= ni < n and 0 <= nj < n:\n                val = grid[ni][nj]\n                if min_val is None or val < min_val:\n                    min_val = val\n                    next_i, next_j = ni, nj\n        # Append the chosen value and move current position.\n        path_vals.append(min_val)\n        cur_i, cur_j = next_i, next_j\n\n    return path_vals"}
