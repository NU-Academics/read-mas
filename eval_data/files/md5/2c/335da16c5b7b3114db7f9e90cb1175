{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"Replace spaces with underscores; groups of more than two consecutive spaces are replaced with a single hyphen.\"\"\"\n    def repl(match: re.Match) -> str:\n        space_seq = match.group()\n        return '-' if len(space_seq) > 2 else '_' * len(space_seq)\n\n    return re.sub(r' +', repl, text)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name: str) -> str:\n    \"\"\"\n    Validate a file name according to the following rules:\n    1. The name must contain exactly one dot '.' separating the base name and the extension.\n    2. The base name must not be empty and must start with a Latin letter (a-z or A-Z).\n    3. The extension must be one of ['txt', 'exe', 'dll'].\n    4. The total number of digits in the entire file name must not exceed three.\n\n    Parameters\n    ----------\n    file_name : str\n        The file name to validate.\n\n    Returns\n    -------\n    str\n        'Yes' if the file name is valid, 'No' otherwise.\n    \"\"\"\n    # 1. Exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    base, ext = file_name.split('.', 1)\n\n    # 2. Base name non-empty and starts with a letter\n    if not base or not base[0].isalpha():\n        return 'No'\n\n    # 3. Valid extension\n    if ext not in {'txt', 'exe', 'dll'}:\n        return 'No'\n\n    # 4. At most three digits in the whole file name\n    digits_count = sum(ch.isdigit() for ch in file_name)\n    if digits_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(start: int, end: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of all integers within a specified inclusive range.\n\n    Args:\n        start: The beginning of the inclusive range.\n        end: The end of the inclusive range.\n\n    Returns:\n        The sum of squares of integers from 'start' to 'end' (inclusive).\n        Returns 0 if 'start' is greater than 'end' (representing an empty range).\n    \"\"\"\n    if start > end:\n        return 0\n\n    return sum(i * i for i in range(start, end + 1))"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Return the words from the original sentence whose lengths are prime numbers,\n    preserving the original order.\n\n    Parameters\n    ----------\n    sentence : str\n        A sentence containing only letters and spaces.\n\n    Returns\n    -------\n    str\n        A space\u2010separated string of words with prime length. If no such words\n        exist, an empty string is returned.\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Check if an integer n > 0 is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        divisor = 3\n        while divisor * divisor <= n:\n            if n % divisor == 0:\n                return False\n            divisor += 2\n        return True\n\n    return \" \".join(word for word in sentence.split() if _is_prime(len(word)))"}
{"task_id": "HumanEval/144", "solution": "def simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Returns True if the product of the fractions represented by the strings x and n\n    is a whole number, False otherwise.\n\n    Parameters\n    ----------\n    x : str\n        A string in the form \"<numerator>/<denominator>\" representing a fraction.\n    n : str\n        A string in the form \"<numerator>/<denominator>\" representing a fraction.\n\n    Returns\n    -------\n    bool\n        True if the product is an integer, False otherwise.\n\n    Examples\n    --------\n    >>> simplify(\"1/5\", \"5/1\")\n    True\n    >>> simplify(\"1/6\", \"2/1\")\n    False\n    >>> simplify(\"7/10\", \"10/2\")\n    False\n    \"\"\"\n    def parse_fraction(frac: str):\n        numerator, denominator = frac.split(\"/\")\n        return int(numerator), int(denominator)\n\n    a, b = parse_fraction(x)\n    c, d = parse_fraction(n)\n\n    product_numerator = a * c\n    product_denominator = b * d\n\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sort the given list of integers in ascending order based on the sum of their digits.\n    If multiple integers have the same digit sum, their relative order in the original list is preserved.\n\n    Parameters\n    ----------\n    nums : list[int]\n        The list of integers to sort.\n\n    Returns\n    -------\n    list[int]\n        The sorted list according to the criteria.\n\n    Examples\n    --------\n    >>> order_by_points([1, 11, -1, -11, -12])\n    [1, -1, 11, -11, -12]\n    >>> order_by_points([])\n    []\n    \"\"\"\n    def digit_sum(n: int) -> int:\n        \"\"\"Return the sum of the absolute digits of n.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # Enumerate to keep original indices for stable sort\n    indexed = list(enumerate(nums))\n    # Sort by digit_sum and original index\n    indexed.sort(key=lambda x: (digit_sum(x[1]), x[0]))\n    # Extract sorted numbers\n    return [num for _, num in indexed]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Return the count of numbers in ``nums`` that are greater than 10 and\n    have odd digits at both the first and last positions.\n\n    The function treats negative numbers the same as positive ones with\n    respect to digit extraction \u2013 the sign is ignored when determining the\n    first and last digits.\n\n    Parameters\n    ----------\n    nums : Iterable[int]\n        An iterable of integers.\n\n    Returns\n    -------\n    int\n        The number of integers satisfying the conditions.\n    \"\"\"\n    def is_odd_digit(d: int) -> bool:\n        return d in {1, 3, 5, 7, 9}\n\n    count = 0\n    for n in nums:\n        if n <= 10:\n            continue\n        abs_n = abs(n)\n        s = str(abs_n)\n        first_digit = int(s[0])\n        last_digit = int(s[-1])\n        if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n            count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Compute the number of triples (a[i], a[j], a[k]) such that\n    i < j < k and a[i] + a[j] + a[k] is divisible by 3.\n    \n    The array a is defined by a[i] = i*i - i + 1 for 1-indexed i.\n    \n    Observation: a[i] modulo 3 depends only on i modulo 3.\n        i % 3 == 0 or 1  -> a[i] % 3 == 1\n        i % 3 == 2       -> a[i] % 3 == 0\n    \n    Hence the only residues available are 0 and 1.\n    A sum of three such residues is divisible by 3 if they are all 0 or all 1.\n    Therefore the answer is the number of 3\u2011combinations of indices yielding\n    residue 0 plus the number of 3\u2011combinations yielding residue 1.\n    \n    Parameters\n    ----------\n    n : int\n        Length of the array.\n    \n    Returns\n    -------\n    int\n        Count of valid triples.\n    \"\"\"\n    def comb3(x: int) -> int:\n        \"\"\"Return x choose 3 (0 if x < 3).\"\"\"\n        return x * (x - 1) * (x - 2) // 6 if x >= 3 else 0\n\n    # Count indices with residue 0 (i % 3 == 2).\n    count0 = (n + 1) // 3          # positions 2,5,8,...\n    # Remaining indices have residue 1.\n    count1 = n - count0\n\n    return comb3(count0) + comb3(count1)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Return a tuple of planets that lie between two given planets in the solar system\n    (ordered from the Sun outward). If either planet name is invalid, return an empty tuple.\n    \"\"\"\n    # Ordered list of planets from the Sun\n    planets = [\n        \"Mercury\",\n        \"Venus\",\n        \"Earth\",\n        \"Mars\",\n        \"Jupiter\",\n        \"Saturn\",\n        \"Uranus\",\n        \"Neptune\",\n    ]\n\n    # Validate input planets\n    if planet1 not in planets or planet2 not in planets:\n        return tuple()\n\n    # Determine indices\n    idx1 = planets.index(planet1)\n    idx2 = planets.index(planet2)\n\n    # If planet1 comes before planet2\n    if idx1 < idx2:\n        between = planets[idx1 + 1:idx2]\n    else:\n        # planet1 comes after planet2\n        between = planets[idx2 + 1:idx1]\n\n    return tuple(between)"}
