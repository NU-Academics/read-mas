{"task_id": "HumanEval/150", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"\n    Return True if n is a prime number, otherwise False.\n    Uses an efficient trial division algorithm.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n: int, x: int, y: int) -> int:\n    \"\"\"\n    Return x if n is a prime number, otherwise return y.\n\n    Parameters\n    ----------\n    n : int\n        The number to test for primality.\n    x : int\n        The value to return if n is prime.\n    y : int\n        The value to return if n is not prime.\n\n    Returns\n    -------\n    int\n        x if n is prime, else y.\n\n    Raises\n    ------\n    TypeError\n        If any argument is not an integer.\n    ValueError\n        If the integer is too large to safely process.\n\n    Examples\n    --------\n    >>> x_or_y(7, 34, 12)\n    34\n    >>> x_or_y(15, 8, 5)\n    5\n    \"\"\"\n    if not all(isinstance(v, int) for v in (n, x, y)):\n        raise TypeError(\"All arguments must be integers.\")\n\n    try:\n        int(n)  # defensive check against overflow\n    except OverflowError as exc:\n        raise ValueError(\"Integer too large.\") from exc\n\n    return x if _is_prime(n) else y"}
{"task_id": "HumanEval/151", "solution": "from typing import List, Union, Iterable\ndef double_the_difference(nums: Iterable[Union[int, float]]) -> int:\n    \"\"\"\n    Compute the sum of squares of numbers that are odd, non\u2011negative integers.\n    \n    Numbers that are negative or not integers are ignored.\n    \n    Parameters\n    ----------\n    nums : Iterable[Union[int, float]]\n        Input sequence of numbers.\n        \n    Returns\n    -------\n    int\n        Sum of squares of qualifying numbers. Returns 0 for an empty input.\n    \"\"\"\n    total = 0\n    for n in nums:\n        if isinstance(n, int) and n >= 0 and (n & 1):\n            total += n * n\n    return total"}
{"task_id": "HumanEval/152", "solution": "from typing import List, Sequence\ndef compare(game: Sequence[int], guess: Sequence[int]) -> List[int]:\n    \"\"\"\n    Return the absolute difference between each pair of scores and guesses.\n    If the guess matches the score exactly, the difference is 0.\n\n    Parameters\n    ----------\n    game : Sequence[int]\n        A sequence of integer scores.\n    guess : Sequence[int]\n        A sequence of integer guesses of the same length as `game`.\n\n    Returns\n    -------\n    List[int]\n        A list containing the difference for each match.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Both lists must have the same length.\")\n\n    return [0 if g == s else abs(g - s) for g, s in zip(guess, game)]"}
