{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"\n    Compute the n-th element of the fib4 sequence.\n\n    The fib4 sequence is defined as:\n        fib4(0) -> 0\n        fib4(1) -> 0\n        fib4(2) -> 2\n        fib4(3) -> 0\n        fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4)   for n >= 4\n\n    This implementation uses an iterative approach with O(1) additional space\n    and O(n) time complexity.\n\n    Parameters\n    ----------\n    n : int\n        The index of the element to compute. Must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        The n-th fib4 number.\n\n    Raises\n    ------\n    ValueError\n        If n is negative.\n\n    Examples\n    --------\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    >>> fib4(0)\n    0\n    >>> fib4(2)\n    2\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    base = [0, 0, 2, 0]  # fib4(0), fib4(1), fib4(2), fib4(3)\n    if n < 4:\n        return base[n]\n\n    a, b, c, d = base\n    for _ in range(4, n + 1):\n        next_val = a + b + c + d\n        a, b, c, d = b, c, d, next_val\n    return d"}
{"task_id": "HumanEval/47", "solution": "from typing import List, Sequence, Union\nimport pytest\nfrom median import median\nNumber = Union[int, float]\ndef median(values: Sequence[Number]) -> float:\n    \"\"\"\n    Return the median of the elements in ``values``.\n    \n    The function does not modify the original input sequence.\n    \n    Parameters\n    ----------\n    values : Sequence[Number]\n        A sequence (e.g., list or tuple) of numeric values.\n    \n    Returns\n    -------\n    float\n        The median value. For an odd number of items the middle element\n        is returned. For an even number of items the average of the two\n        middle elements is returned.\n    \n    Raises\n    ------\n    ValueError\n        If ``values`` is empty or contains non-numeric entries.\n\n    Examples\n    --------\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not values:\n        raise ValueError(\"Cannot compute median of an empty sequence\")\n\n    # Ensure all items are numeric\n    try:\n        sorted_values = sorted(values)\n    except TypeError as exc:\n        raise ValueError(\"All items must be numeric\") from exc\n\n    n = len(sorted_values)\n    mid = n // 2\n\n    if n % 2:\n        return float(sorted_values[mid])\n    else:\n        return (sorted_values[mid - 1] + sorted_values[mid]) / 2.0"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if the given string is a palindrome.\n\n    This function performs an exact character-by-character comparison\n    from the start and end of the string, moving inward until a mismatch\n    is found or the indices cross. It runs in O(n) time and O(1) space.\n\n    Parameters:\n        text (str): The string to test.\n\n    Returns:\n        bool: True if ``text`` is a palindrome, False otherwise.\n\n    Examples\n    --------\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    left, right = 0, len(text) - 1\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n    return True"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"\n    Compute (2**n) % p efficiently using binary exponentiation.\n\n    Parameters\n    ----------\n    n : int\n        The exponent, must be non\u2011negative.\n    p : int\n        The modulus, must be a positive integer.\n\n    Returns\n    -------\n    int\n        The remainder after dividing 2**n by p.\n\n    Raises\n    ------\n    ValueError\n        If p is not a positive integer or n is negative.\n\n    Examples\n    --------\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if p <= 0:\n        raise ValueError(\"Modulus p must be a positive integer\")\n    if n < 0:\n        raise ValueError(\"Exponent n must be non\u2011negative\")\n\n    result = 1\n    base = 2 % p\n    exponent = n\n    while exponent:\n        if exponent & 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        exponent >>= 1\n    return result"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str) -> str:\n    \"\"\"\n    Decode a string that was encoded with `encode_shift` by shifting each\n    lowercase alphabetic character backward by 5 positions.\n\n    Parameters\n    ----------\n    s : str\n        The encoded string consisting only of lowercase letters 'a'-'z'.\n\n    Returns\n    -------\n    str\n        The decoded, original string.\n\n    Raises\n    ------\n    TypeError\n        If ``s`` is not a string.\n    ValueError\n        If ``s`` contains characters outside the range 'a'-'z'.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n    for ch in s:\n        if not ('a' <= ch <= 'z'):\n            raise ValueError(\"input string must contain only lowercase letters 'a' to 'z'\")\n    return \"\".join([chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])"}
{"task_id": "HumanEval/51", "solution": "def remove_vowels(text: str) -> str:\n    \"\"\"\n    Remove all English vowels (case-insensitive) from the input string.\n\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\\\nghijklm\")\n    'bcdf\\\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = set(\"aeiouAEIOU\")\n    return \"\".join(char for char in text if char not in vowels)"}
{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int) -> bool:\n    \"\"\"\n    Return True if all numbers in the list *l* are below the threshold *t*.\n    This function is type\u2011annotated and includes a comprehensive docstring\n    with doctest examples.\n\n    Parameters\n    ----------\n    l : list\n        List of numeric values (int or float). Non\u2011numeric elements will\n        raise a ``ValueError`` to enforce strict type usage.\n    t : int\n        Threshold value to compare against.\n\n    Returns\n    -------\n    bool\n        ``True`` if every element in ``l`` is strictly less than ``t``,\n        otherwise ``False``.\n    \"\"\"\n    if not isinstance(t, (int, float)):\n        raise ValueError(f\"Threshold must be a number, got {t!r}\")\n\n    for idx, x in enumerate(l):\n        if not isinstance(x, (int, float)):\n            raise ValueError(f\"Element at index {idx} is not numeric: {x!r}\")\n        if x >= t:\n            return False\n    return True"}
