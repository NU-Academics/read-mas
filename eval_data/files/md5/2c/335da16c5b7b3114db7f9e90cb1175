{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Count the number of sentences that start with the word \"I\" in a given string.\n\n    Sentences are delimited by '.', '?' or '!'. The function is case-sensitive and\n    only counts a sentence if the very first word after any leading whitespace is\n    the capital letter 'I' followed by a space or the end of the sentence.\n\n    Parameters\n    ----------\n    S : str\n        The input string containing one or more sentences.\n\n    Returns\n    -------\n    int\n        The count of sentences that start with \"I\".\n\n    Examples\n    --------\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    # Split the string into fragments using punctuation that ends sentences.\n    fragments = re.split(r'[.!?]', S)\n\n    count = 0\n    for frag in fragments:\n        stripped = frag.strip()\n        if not stripped:\n            continue\n        # Extract the first word\n        first_word = stripped.split(maxsplit=1)[0]\n        if first_word == \"I\":\n            count += 1\n    return count"}
{"task_id": "HumanEval/92", "solution": "from typing import Any\ndef any_int(x: Any, y: Any, z: Any) -> bool:\n    \"\"\"\n    Returns ``True`` if one of the arguments is the sum of the other two and\n    **all three** arguments are integers. Otherwise returns ``False``.\n\n    Parameters\n    ----------\n    x, y, z : Any\n        Three numeric values to be examined.\n\n    Returns\n    -------\n    bool\n        ``True`` when the conditions are met, otherwise ``False``.\n\n    Examples\n    --------\n    >>> any_int(5, 2, 7)\n    True\n    >>> any_int(3, 2, 2)\n    False\n    >>> any_int(3, -2, 1)\n    True\n    >>> any_int(3.6, -2.2, 2)\n    False\n    \"\"\"\n    def _is_int(val: Any) -> bool:\n        \"\"\"Check if val is an integer but not a boolean.\"\"\"\n        return isinstance(val, int) and not isinstance(val, bool)\n\n    if not (_is_int(x) and _is_int(y) and _is_int(z)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encode a message by swapping the case of every letter and\n    replacing each vowel with the letter that appears two places\n    ahead of that vowel in the English alphabet.\n\n    The function assumes that the input contains only alphabetic\n    characters.\n\n    Parameters\n    ----------\n    message : str\n        The string to encode.\n\n    Returns\n    -------\n    str\n        The transformed string.\n\n    Examples\n    --------\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    # Mapping from lowercase vowel to its successor two places ahead.\n    vowel_map = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n\n    result = []\n\n    for ch in message:\n        swapped = ch.swapcase()                    # Step 1: swap case\n        lower_swapped = swapped.lower()\n\n        if lower_swapped in vowel_map:\n            # Replace vowel, keeping the case of the swapped character.\n            new_char = vowel_map[lower_swapped]\n            if swapped.isupper():\n                new_char = new_char.upper()\n        else:\n            new_char = swapped\n\n        result.append(new_char)\n\n    return ''.join(result)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Return the sum of the digits of the largest prime number in lst.\n\n    Parameters\n    ----------\n    lst : list[int]\n        List of integers to search.\n\n    Returns\n    -------\n    int\n        Sum of digits of the largest prime. If no prime is found, returns 0.\n\n    Raises\n    ------\n    TypeError\n        If any element in ``lst`` is not an integer.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list\")\n\n    # Validate elements\n    for val in lst:\n        if not isinstance(val, int):\n            raise TypeError(f\"All elements must be integers, got {type(val).__name__}\")\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Check if ``n`` is a prime number (n > 1).\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        w = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += w\n            w = 6 - w  # switch between +2 and +4\n        return True\n\n    def digit_sum(n: int) -> int:\n        \"\"\"Return the sum of the decimal digits of n.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # Find the largest prime\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    return digit_sum(largest_prime) if largest_prime is not None else 0"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(d: dict) -> bool:\n    \"\"\"\n    Checks whether all keys in the given dictionary are strings and that \n    they are either all lower-case or all upper-case. Returns False if the \n    dictionary is empty or any key does not satisfy the condition.\n    \"\"\"\n    if not d:\n        return False\n\n    # Ensure all keys are strings\n    if not all(isinstance(k, str) for k in d.keys()):\n        return False\n\n    # Determine if all keys are lower-case or all upper-case\n    lower_flags = [k.islower() for k in d.keys()]\n    upper_flags = [k.isupper() for k in d.keys()]\n\n    # If all are lower-case or all are upper-case, return True\n    if all(lower_flags) or all(upper_flags):\n        return True\n\n    return False"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n: int):\n    \"\"\"\n    Return a list of all prime numbers less than n.\n\n    Parameters:\n    n (int): A non-negative integer.\n\n    Returns:\n    list[int]: Prime numbers less than n in ascending order.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    def is_prime(x: int) -> bool:\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        limit = int(x**0.5) + 1\n        for d in range(3, limit, 2):\n            if x % d == 0:\n                return False\n        return True\n\n    primes = []\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n    return primes"}
