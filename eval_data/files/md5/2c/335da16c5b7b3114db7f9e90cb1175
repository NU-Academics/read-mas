{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\"\n    Filter an input list of strings, keeping only those that start with the given prefix.\n\n    Args:\n        strings (List[str]): The list of strings to filter.\n        prefix (str): The prefix to filter by.\n\n    Returns:\n        List[str]: A new list containing only strings that start with `prefix`.\n\n    Examples:\n        >>> filter_by_prefix([], 'a')\n        []\n        >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n        ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list[int]) -> list[int]:\n    \"\"\"\n    Returns a new list containing only the positive numbers from the input list.\n\n    This function iterates through the given list of integers and filters out\n    any numbers that are greater than 0, collecting them into a new list.\n\n    Args:\n        l: A list of integers.\n\n    Returns:\n        A new list containing only integers greater than 0 from the input list.\n        The order of positive numbers is maintained.\n\n    Examples:\n        >>> get_positive([1, -2, 3, 0, 4, -5])\n        [1, 3, 4]\n        >>> get_positive([])\n        []\n        >>> get_positive([-1, -2, -3, 0])\n        []\n        >>> get_positive([5, 10, 15])\n        [5, 10, 15]\n    \"\"\"\n    return [x for x in l if x > 0]"}
{"task_id": "HumanEval/31", "solution": "import math\nimport doctest\nfrom typing import Optional\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer 'n' is a prime number.\n\n    A prime number is a natural number greater than 1 that has no positive\n    divisors other than 1 and itself.\n    Handles edge cases for n <= 1 by returning False.\n    Checks divisibility by 2 separately for efficiency.\n    Then, iterates through odd divisors up to the square root of n.\n\n    >>> is_prime(0)\n    False\n    >>> is_prime(1)\n    False\n    >>> is_prime(2)\n    True\n    >>> is_prime(3)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(5)\n    True\n    >>> is_prime(7)\n    True\n    >>> is_prime(9)\n    False\n    >>> is_prime(11)\n    True\n    >>> is_prime(13)\n    True\n    >>> is_prime(25)\n    False\n    >>> is_prime(49)\n    False\n    >>> is_prime(97)\n    True\n    >>> is_prime(100)\n    False\n    >>> is_prime(-5)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import List\ndef poly(xs: List[float], x: float) -> float:\n    \"\"\"Evaluate a polynomial with coefficients xs at point x.\n\n    Parameters\n    ----------\n    xs : List[float]\n        Coefficients of the polynomial in ascending order.  The coefficient\n        of x**i is xs[i].\n    x : float\n        The point at which to evaluate the polynomial.\n\n    Returns\n    -------\n    float\n        The value of the polynomial at x.\n    \"\"\"\n    return sum(coeff * math.pow(x, i) for i, coeff in enumerate(xs))\ndef find_zero(xs: List[float]) -> float:\n    \"\"\"Find one real zero of a polynomial.\n\n    The function assumes that *xs* contains an odd degree polynomial\n    (i.e. the number of coefficients is even) and that the leading\n    coefficient is non\u2011zero.  Under these conditions the Fundamental\n    Theorem of Algebra guarantees at least one real root.\n\n    The algorithm searches for a sign change in the polynomial values\n    between two symmetric bounds, then applies a bisection method to\n    refine the root.\n\n    Parameters\n    ----------\n    xs : List[float]\n        Coefficients of the polynomial in ascending order.\n\n    Returns\n    -------\n    float\n        A real root of the polynomial.\n\n    Examples\n    --------\n    >>> round(find_zero([1, 2]), 2)\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2)\n    1.0\n    \"\"\"\n    # Helper to evaluate polynomial\n    def f(val: float) -> float:\n        return poly(xs, val)\n\n    # Start with symmetric bounds\n    low = -1.0\n    high = 1.0\n    step = 1.0\n    # Expand bounds until we find opposite signs or a zero at a bound\n    while f(low) * f(high) > 0:\n        if f(low) == 0:\n            return low\n        if f(high) == 0:\n            return high\n\n        low -= step\n        high += step\n        step *= 2\n        if step > 1e12:\n            raise ValueError(\"Unable to find bounds with sign change within reasonable range.\")\n\n    # If either bound is exactly zero, return it\n    if f(low) == 0:\n        return low\n    if f(high) == 0:\n        return high\n\n    # Bisection method\n    tolerance = 1e-12\n    max_iter = 200\n\n    for _ in range(max_iter):\n        mid = (low + high) / 2\n        f_mid = f(mid)\n\n        if abs(f_mid) < tolerance:\n            return mid\n\n        if abs(high - low) < tolerance:\n            return (low + high) / 2\n\n        if f(low) * f_mid <= 0:\n            high = mid\n        else:\n            low = mid\n\n    return (low + high) / 2"}
{"task_id": "HumanEval/33", "solution": "from typing import List\ndef sort_third(l: List[int]) -> List[int]:\n    \"\"\"\n    Return a new list where elements at indices divisible by three\n    are sorted, and other positions remain unchanged.\n    \n    Parameters\n    ----------\n    l : List[int]\n        Input list of integers.\n    \n    Returns\n    -------\n    List[int]\n        A new list with the third-indexed elements sorted.\n    \n    Examples\n    --------\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    # Find positions where the index is divisible by 3\n    third_indices = [i for i in range(len(l)) if i % 3 == 0]\n    \n    # Extract and sort the values at these positions\n    sorted_third_values = sorted(l[i] for i in third_indices)\n    \n    # Build the result list by copying the original and replacing sorted values\n    result = l.copy()\n    for i, val in zip(third_indices, sorted_third_values):\n        result[i] = val\n    \n    return result"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"\n    Return sorted unique elements in a list.\n\n    Parameters\n    ----------\n    l : list\n        The list of elements to process.\n\n    Returns\n    -------\n    list\n        A new list containing the unique elements of ``l``, sorted in ascending order.\n\n    Examples\n    --------\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert the input list to a set to remove duplicates,\n    # then sort the resulting unique values.\n    return sorted(set(l))"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"\n    Return the maximum element of a list.\n\n    Raises:\n        ValueError: If the list is empty.\n\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([3, 1, 2])\n    3\n    >>> max_element([-1, -5, -2])\n    -1\n    >>> max_element([5])\n    5\n    >>> max_element([])\n    Traceback (most recent call last):\n        ...\n    ValueError: max_element() arg is an empty sequence\n    >>> max_element([1.1, 2.2, 0.5])\n    2.2\n    >>> max_element(['apple', 'banana', 'cherry'])\n    'cherry'\n    >>> max_element(['zoo', 'apple', 'banana'])\n    'zoo'\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty sequence\")\n    return max(l)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"\n    Return the number of times the digit 7 appears in integers less than ``n`` that are\n    divisible by 11 or 13.\n\n    Parameters\n    ----------\n    n : int\n        The upper bound (exclusive) for the range of integers to consider.\n\n    Examples\n    --------\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    count = 0\n    for num in range(1, n):\n        if num % 11 == 0 or num % 13 == 0:\n            count += str(num).count(\"7\")"}
{"task_id": "HumanEval/37", "solution": "from typing import List, Any\ndef sort_even(l: List[Any]) -> List[Any]:\n    \"\"\"\n    Return a copy of ``l`` where elements at even indices are sorted, while odd indices remain unchanged.\n\n    Parameters\n    ----------\n    l : List[Any]\n        The input list.\n\n    Returns\n    -------\n    List[Any]\n        A new list with even-index elements sorted.\n\n    Examples\n    --------\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    >>> sort_even([])\n    []\n    >>> sort_even([10])\n    [10]\n    >>> sort_even([9, 1, 5, 2, 7])\n    [5, 1, 7, 2, 9]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at even indices and sort them\n    even_indices = list(range(0, len(l), 2))\n    even_values = sorted(l[i] for i in even_indices)\n\n    # Build the result list\n    result = l.copy()\n    for idx, val in zip(even_indices, even_values):\n        result[idx] = val\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"Decodes a string by cyclically right-shifting groups of 3 characters.\n\n    Groups shorter than 3 characters are left unchanged. This reverses\n    the encoding performed by `encode_cyclic`.\n\n    Args:\n        s: The cyclically encoded string to decode.\n\n    Returns:\n        The original string.\n    \"\"\"\n    return \"\".join(\n        (\n            (s[i + 2] + s[i] + s[i + 1]) if (i + 2 < len(s)) else s[i:i + 3]\n            for i in range(0, len(s), 3)\n        )\n    )"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    Return the *n*-th prime number that also appears in the Fibonacci sequence.\n    The sequence begins with 2, 3, 5, 13, 89, ...\n\n    Parameters\n    ----------\n    n : int\n        The position in the list of prime Fibonacci numbers (1\u2011based).\n\n    Raises\n    ------\n    ValueError\n        If *n* is not a positive integer.\n\n    Examples\n    --------\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    def _is_prime(x: int) -> bool:\n        \"\"\"Simple primality test for non\u2011negative integers.\"\"\"\n        if x < 2:\n            return False\n        if x in (2, 3):\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        w = 2\n        while i * i <= x:\n            if x % i == 0:\n                return False\n            i += w\n            w = 6 - w\n        return True\n\n    # Generate Fibonacci numbers and test for primality\n    count = 0\n    a, b = 0, 1          # starts from 0, 1\n    while True:\n        a, b = b, a + b  # next Fibonacci number\n        if a >= 2 and _is_prime(a):\n            count += 1\n            if count == n:\n                return a"}
{"task_id": "HumanEval/40", "solution": "import random\nfrom typing import List, Tuple\ndef triples_sum_to_zero(l: List[int]) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n    l_sorted = sorted(l)\n    for i in range(n - 2):\n        if i > 0 and l_sorted[i] == l_sorted[i - 1]:\n            continue\n        left, right = i + 1, n - 1\n        while left < right:\n            total = l_sorted[i] + l_sorted[left] + l_sorted[right]\n            if total == 0:\n                return True\n            elif total < 0:\n                left += 1\n            else:\n                right -= 1\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Compute the total number of collisions between two sets of cars moving in opposite\n    directions on an infinitely long straight line when both sets start far apart.\n\n    Parameters\n    ----------\n    n : int\n        Number of cars in each set. Must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        Number of collisions that will occur.\n\n    Notes\n    -----\n    Since all cars move at the same speed and the two sets start with all left\u2011to\u2011right\n    cars positioned to the left of all right\u2011to\u2011left cars, every left\u2011to\u2011right car\n    collides with every right\u2011to\u2011left car exactly once, leading to n*n collisions.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "import unittest\nfrom typing import List\ndef incr_list(l: List[int]) -> List[int]:\n    \"\"\"\n    Return a new list with each integer element incremented by 1.\n\n    Parameters\n    ----------\n    l : List[int]\n        A list of integers.\n\n    Returns\n    -------\n    List[int]\n        A new list where every element is the corresponding element of `l`\n        incremented by 1.\n\n    Raises\n    ------\n    TypeError\n        If `l` is not a list or contains non\u2011integer elements.\n\n    Examples\n    --------\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list\")\n    if not all(isinstance(x, int) for x in l):\n        raise TypeError(\"All elements in the list must be integers\")\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/43", "solution": "def find_zero_sum_pairs(numbers):\n    \"\"\"\n    Finds all unique pairs of numbers in a given list that sum to zero.\n\n    A pair (a, b) is considered unique if the set of its values {a, b} has not been\n    found before.\n    For example, if the input is [1, -1, 1], only one pair (-1, 1) will be returned.\n    If the input contains multiple zeros, e.g., [0, 0, 0], only one pair (0, 0) will be\n    returned.\n\n    Args:\n        numbers: A list of integers or floats.\n\n    Returns:\n        A list of tuples, where each tuple (a, b) represents a unique zero-sum pair.\n        The numbers within each pair are sorted in ascending order (e.g., (-1, 1)\n        instead of (1, -1)).\n    \"\"\"\n    zero_sum_pairs = []\n    seen_numbers = set()\n    # Use a set of frozensets to efficiently track unique pairs regardless of element order.\n    seen_pairs_set = set() \n\n    for num in numbers:\n        complement = -num\n        if complement in seen_numbers:\n            # A potential zero-sum pair is found.\n            \n            # Sort the pair to ensure a consistent representation (e.g., (-1, 1) rather\n            # than (1, -1)).\n            pair_values_tuple = tuple(sorted((num, complement)))\n            \n            # Create a frozenset for the pair to check for uniqueness, as frozensets\n            # are hashable and treat {a, b} and {b, a} as the same.\n            frozenset_pair = frozenset((num, complement))\n\n            if frozenset_pair not in seen_pairs_set:\n                zero_sum_pairs.append(pair_values_tuple)\n                seen_pairs_set.add(frozenset_pair)\n        # Add the current number to the set of seen numbers for future lookups.\n        seen_numbers.add(num)\n\n    return zero_sum_pairs"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"\n    Converts a non-negative integer x to its string representation in a target base.\n\n    Args:\n        x: A non-negative integer.\n        base: The target base, must be between 2 and 9 inclusive.\n\n    Returns:\n        The string representation of x in the specified base.\n\n    Raises:\n        ValueError: If the base is not within the range [2, 9].\n    \"\"\"\n    if not (2 <= base <= 9):\n        raise ValueError(\"Base must be an integer between 2 and 9 inclusive.\")\n\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    return \"\".join(reversed(digits))"}
