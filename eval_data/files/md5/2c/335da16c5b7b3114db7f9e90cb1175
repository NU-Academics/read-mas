{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    \"\"\"\n    Count the number of uppercase vowels present at even indices of the string `s`.\n\n    Parameters\n    ----------\n    s : str\n        The input string to inspect.\n\n    Returns\n    -------\n    int\n        The count of uppercase vowels located at even positions (0\u2011based index).\n\n    Examples\n    --------\n    >>> count_upper('aBCdEf')\n    1\n    >>> count_upper('abcdefg')\n    0\n    >>> count_upper('dBBE')\n    0\n    \"\"\"\n    vowels = set('AEIOU')\n    return sum(1 for idx, ch in enumerate(s) if idx % 2 == 0 and ch in vowels)"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value: str) -> int:\n    \"\"\"\n    Return the integer that is closest to the numeric string ``value``.\n    \n    Parameters\n    ----------\n    value : str\n        String representation of a number.  It may contain leading or\n        trailing whitespace and may represent an integer or a floating-point\n        number.\n    \n    Returns\n    -------\n    int\n        The integer closest to the parsed number.  If the number is exactly\n        halfway between two integers, the result is rounded *away* from zero.\n    \n    Examples\n    --------\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n    >>> closest_integer(\"14.5\")\n    15\n    >>> closest_integer(\"-14.5\")\n    -15\n    \"\"\"\n    import math\n\n    num = float(value)\n\n    lower = math.floor(num)\n    upper = math.ceil(num)\n\n    lower_dist = abs(num - lower)\n    upper_dist = abs(upper - num)\n\n    if lower_dist < upper_dist:\n        return lower\n    if upper_dist < lower_dist:\n        return upper\n\n    # Tie case \u2013 round away from zero\n    return upper if num >= 0 else lower"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a list with the number of stones in each level of the pile.\n\n    The first level has `n` stones. For each subsequent level, the number of stones\n    is the next odd number if the current level has an odd number of stones;\n    otherwise, it is the next even number.\n\n    Parameters\n    ----------\n    n : int\n        The number of stones in the first level; must be a positive integer.\n\n    Returns\n    -------\n    list[int]\n        A list of integers where each element represents the stones on that level.\n\n    Examples\n    --------\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    >>> make_a_pile(4)\n    [4, 6, 8, 10]\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"`n` must be a positive integer\")\n\n    stones = []\n    current = n\n    for _ in range(n):\n        stones.append(current)\n        if current % 2 == 0:\n            current += 2  # next even\n        else:\n            current += 2  # next odd\n\n    return stones"}
