{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Insert a number ``delimeter`` between every two consecutive elements of the input list ``numbers``.\n\n    Args:\n        numbers: A list of integers.\n        delimeter: The integer to insert between each pair of elements.\n\n    Returns:\n        A new list with ``delimeter`` inserted between consecutive elements.\n        If ``numbers`` has zero or one element, the original list is returned unchanged.\n\n    Examples:\n        >>> intersperse([], 4)\n        []\n        >>> intersperse([1], 4)\n        [1]\n        >>> intersperse([1, 2, 3], 4)\n        [1, 4, 2, 4, 3]\n    \"\"\"\n    # Early return for empty or single-element lists\n    if len(numbers) < 2:\n        return list(numbers)\n\n    # Build the result by inserting the delimiter after each element except the last\n    result: List[int] = []\n    for i, value in enumerate(numbers):\n        result.append(value)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    depths: List[int] = []\n\n    for group in paren_string.split():\n        max_depth = 0\n        current_depth = 0\n        for ch in group:\n            if ch == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif ch == ')':\n                current_depth -= 1\n        depths.append(max_depth)\n\n    return depths"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"\n    Filter an input list of strings, keeping only those that contain the given substring.\n\n    Parameters\n    ----------\n    strings : List[str]\n        The list of strings to filter.\n    substring : str\n        The substring to look for in each string.\n\n    Returns\n    -------\n    List[str]\n        A new list with only strings that contain ``substring``. The relative order\n        of the elements is preserved.\n\n    Raises\n    ------\n    TypeError\n        If ``strings`` is not an iterable of strings or if ``substring`` is not a\n        string.\n\n    Examples\n    --------\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not isinstance(substring, str):\n        raise TypeError(\"substring must be a string\")\n\n    result: List[str] = []\n    for item in strings:\n        if not isinstance(item, str):\n            raise TypeError(\"all elements of strings must be strings\")\n        if substring in item:\n            result.append(item)\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nimport math\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Return a tuple containing the sum and the product of a list of integers.\n\n    Parameters\n    ----------\n    numbers : List[int]\n        A list of integer values.\n\n    Returns\n    -------\n    Tuple[int, int]\n        The first element is the sum of all integers in the input list.\n        The second element is the product of all integers in the input list.\n        For an empty list the sum is 0 and the product is 1.\n\n    Examples\n    --------\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = sum(numbers)\n    total_product = math.prod(numbers) if numbers else 1\n    return total_sum, total_product"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"Generate a list of rolling maximum elements encountered up to each index in the input list.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A list of the same length where each element is the maximum value seen so far in the input list.\n\n    Examples:\n        >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n        [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    max_so_far = numbers[0]\n    result: List[int] = [max_so_far]\n    for num in numbers[1:]:\n        if num > max_so_far:\n            max_so_far = num\n        result.append(max_so_far)\n    return result"}
{"task_id": "HumanEval/10", "solution": "import unittest\nfrom typing import List\ndef is_palindrome(string: str) -> bool:\n    \"\"\"Return True if *string* is a palindrome, False otherwise.\"\"\"\n    return string == string[::-1]\ndef _longest_palindromic_suffix(s: str) -> int:\n    \"\"\"\n    Find the starting index of the longest suffix of *s* that is a palindrome.\n\n    Returns an integer `i` such that `s[i:]` is the longest palindromic suffix.\n    \"\"\"\n    for i in range(len(s)):\n        if is_palindrome(s[i:]):\n            return i\n    # `s` itself is a palindrome\n    return 0\ndef make_palindrome(string: str) -> str:\n    \"\"\"\n    Return the shortest palindrome that starts with *string*.\n\n    The algorithm is:\n      1. Find the longest suffix of *string* that is already a palindrome.\n      2. Append the reverse of the remaining prefix to the end.\n\n    Examples\n    --------\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    >>> make_palindrome('abcd')\n    'abcdcba'\n    >>> make_palindrome('race')\n    'racecar'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    idx = _longest_palindromic_suffix(string)\n    prefix = string[:idx]\n    return string + prefix[::-1]"}
