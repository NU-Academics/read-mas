{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same unique characters.\n\n    Returns True if both strings contain exactly the same set of characters,\n    regardless of order or frequency. Otherwise returns False.\n\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"\n    Return the n-th Fibonacci number.\n\n    Parameters\n    ----------\n    n : int\n        The index of the Fibonacci sequence to return (0-indexed).\n        Must be a non-negative integer.\n\n    Returns\n    -------\n    int\n        The n-th Fibonacci number.\n\n    Examples\n    --------\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Check if a string composed of '<' and '>' is properly bracketed.\n\n    Parameters\n    ----------\n    brackets : str\n        The string to validate. It should contain only '<' and '>' characters.\n\n    Returns\n    -------\n    bool\n        ``True`` if every opening bracket '<' has a corresponding closing bracket '>'\n        and the brackets are correctly nested; ``False`` otherwise.\n\n    Examples\n    --------\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == \"<\":\n            counter += 1\n        elif char == \">\":\n            counter -= 1\n            if counter < 0:\n                return False\n        else:\n            return False\n    return counter == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 2:\n        return True\n\n    # Find the sign of the first non-zero difference\n    sign = 0\n    for i in range(1, len(l)):\n        diff = l[i] - l[i - 1]\n        if diff != 0:\n            sign = 1 if diff > 0 else -1\n            break\n\n    # If all elements are equal\n    if sign == 0:\n        return True\n\n    for i in range(1, len(l)):\n        diff = l[i] - l[i - 1]\n        if diff != 0:\n            current_sign = 1 if diff > 0 else -1\n            if current_sign != sign:\n                return False\n    return True"}
