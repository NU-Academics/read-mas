{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Return True if any rotation of *b* (including *b* itself) is a substring of *a*.\"\"\"\n    if not b:\n        return False\n    # Build a string that contains all rotations of b concatenated together:\n    # This can be achieved by doubling b: b + b. Then every rotation of b\n    # is a substring of b + b with length len(b).\n    doubled = b + b\n    n = len(b)\n    # Slide through doubled string and search in a. The rotation check\n    # can be done by looking for each possible rotation as a substring of a.\n    # To avoid O(n^2) we can build a set of rotations first.\n    rotations = {doubled[i:i + n] for i in range(n)}\n    return any(rot in a for rot in rotations)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"\n    Return a tuple with the count of even and odd digits in an integer.\n\n    Parameters\n    ----------\n    num : int\n        The integer to analyze. Negative numbers are allowed.\n\n    Returns\n    -------\n    tuple[int, int]\n        A tuple where the first element is the number of even digits and\n        the second element is the number of odd digits.\n\n    Notes\n    -----\n    * Zero is considered an even digit.\n    * The function treats the absolute value of the number; the sign is ignored.\n    * The function has O(n) time complexity and O(1) space complexity,\n      where n is the number of decimal digits.\n\n    Examples\n    --------\n    >>> even_odd_count(-12)\n    (1, 1)\n    >>> even_odd_count(123)\n    (1, 2)\n    >>> even_odd_count(0)\n    (1, 0)\n    \"\"\"\n    num = abs(num)\n    even_count = odd_count = 0\n\n    # Special case: num == 0\n    if num == 0:\n        even_count = 1\n        return even_count, odd_count\n\n    while num:\n        digit = num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        num //= 10\n\n    return even_count, odd_count"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Convert a positive integer into its Roman numeral representation in lowercase.\n    \n    The function accepts values in the inclusive range 1 <= number <= 1000.\n    \n    Parameters\n    ----------\n    number : int\n        The integer to convert. Must be in the range 1 to 1000.\n    \n    Returns\n    -------\n    str\n        The Roman numeral representation of ``number`` using lowercase characters.\n    \n    Raises\n    ------\n    ValueError\n        If ``number`` is outside the allowed range.\n    \n    Examples\n    --------\n    >>> int_to_mini_roman(19)\n    'xix'\n    >>> int_to_mini_roman(152)\n    'clii'\n    >>> int_to_mini_roman(426)\n    'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number must be between 1 and 1000 inclusive.\")\n\n    # List of numeral mappings from largest to smallest.\n    numerals = [\n        (1000, \"m\"),\n        (900,  \"cm\"),\n        (500,  \"d\"),\n        (400,  \"cd\"),\n        (100,  \"c\"),\n        (90,   \"xc\"),\n        (50,   \"l\"),\n        (40,   \"xl\"),\n        (10,   \"x\"),\n        (9,    \"ix\"),\n        (5,    \"v\"),\n        (4,    \"iv\"),\n        (1,    \"i\"),\n    ]\n\n    result_parts = []\n    remaining = number\n    for value, symbol in numerals:\n        if remaining == 0:\n            break\n        count, remaining = divmod(remaining, value)\n        result_parts.append(symbol * count)\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/157", "solution": "import math\nfrom typing import Union\ndef right_angle_triangle(\n    a: Union[int, float],\n    b: Union[int, float],\n    c: Union[int, float],\n    *,\n    tolerance: float = 1e-9\n) -> bool:\n    \"\"\"\n    Determine whether the three side lengths `a`, `b`, `c` form a right-angled\n    triangle.\n\n    A triangle is considered right-angled if the length of the longest side\n    (hypotenuse) satisfies the Pythagorean theorem within the given tolerance.\n\n    Parameters\n    ----------\n    a, b, c : int | float\n        Lengths of the sides of a triangle. Must be positive real numbers.\n    tolerance : float, optional\n        Acceptable absolute error tolerance for the Pythagorean check.\n        Defaults to 1e-9.\n\n    Returns\n    -------\n    bool\n        True if the sides can form a right-angled triangle, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If any side length is non-positive or the side lengths cannot form a\n        triangle (triangle inequality violated).\n\n    Examples\n    --------\n    >>> right_angle_triangle(3, 4, 5)\n    True\n    >>> right_angle_triangle(1, 2, 3)\n    False\n    \"\"\"\n    # Validate input type\n    if not all(isinstance(x, (int, float)) for x in (a, b, c)):\n        raise TypeError(\"Side lengths must be int or float\")\n\n    # Validate side positivity\n    if any(x <= 0 for x in (a, b, c)):\n        raise ValueError(\"All side lengths must be positive\")\n\n    # Triangle inequality check\n    sides = sorted([a, b, c])\n    if sides[0] + sides[1] <= sides[2]:\n        return False\n\n    # Pythagorean theorem check\n    hypotenuse_sq = sides[2] ** 2\n    leg_sum_sq = sides[0] ** 2 + sides[1] ** 2\n    return math.isclose(hypotenuse_sq, leg_sum_sq, abs_tol=tolerance)"}
{"task_id": "HumanEval/158", "solution": "import collections\nfrom typing import List, Iterable\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Return the word with the maximum number of unique characters.\n\n    If several words have the same maximum unique\u2011character count,\n    the lexicographically smallest word is returned.\n\n    Parameters\n    ----------\n    words : List[str]\n        A list of string words.  Raises :class:`TypeError` if the\n        argument is not a list of strings.\n\n    Returns\n    -------\n    str\n        The chosen word, or the empty string when *words* is empty.\n    \"\"\"\n    # --- Validation -------------------------------------------------\n    if not isinstance(words, Iterable) or isinstance(words, (str, bytes)):\n        raise TypeError(\"find_max expects an iterable of strings\")\n    for w in words:\n        if not isinstance(w, str):\n            raise TypeError(\"find_max expects all elements to be strings\")\n\n    best_word = \"\"\n    best_count = -1\n\n    # --- Compute -------------------------------------------------------\n    for w in words:\n        unique = len(set(w))\n        if unique > best_count or (unique == best_count and w < best_word):\n            best_count = unique\n            best_word = w\n\n    return best_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Return [total_number_of_eaten_carrots, number_of_carrots_left].\n\n    Parameters\n    ----------\n    number : int\n        Carrots already eaten.\n    need : int\n        Additional carrots needed.\n    remaining : int\n        Carrots available to eat.\n\n    Returns\n    -------\n    list[int]\n        [total eaten, remaining left]\n    \"\"\"\n    # The rabbit can eat at most the smaller of the carrots it needs or those left in stock\n    eaten = min(need, remaining)\n    total_eaten = number + eaten\n    left = remaining - eaten\n    return [total_eaten, left]"}
{"task_id": "HumanEval/160", "solution": "from typing import List\n_OPERATOR_PRECEDENCE = {\n    \"**\": 4,\n    \"*\": 3,\n    \"//\": 3,\n    \"+\": 2,\n    \"-\": 2,\n}\n_OPERATOR_ASSOCIATIVITY = {\n    \"**\": \"right\",\n    \"*\": \"left\",\n    \"//\": \"left\",\n    \"+\": \"left\",\n    \"-\": \"left\",\n}\n_ALLOWED_OPERATORS = set(_OPERATOR_PRECEDENCE.keys())\ndef _to_rpn(operators: List[str], operands: List[int]):\n    \"\"\"Convert operand/operator lists to Reverse Polish Notation (RPN).\"\"\"\n    output_queue = []\n    op_stack = []\n\n    it_ops = iter(operators)\n    for idx, operand in enumerate(operands):\n        # Append operand\n        output_queue.append((operand,))\n        # If this is the last operand, no more operators\n        if idx == len(operators):\n            break\n        op = next(it_ops)\n\n        while op_stack:\n            top = op_stack[-1]\n            if (\n                (_OPERATOR_ASSOCIATIVITY[op] == \"left\"\n                 and _OPERATOR_PRECEDENCE[op] <= _OPERATOR_PRECEDENCE[top])\n                or (_OPERATOR_ASSOCIATIVITY[op] == \"right\"\n                    and _OPERATOR_PRECEDENCE[op] < _OPERATOR_PRECEDENCE[top])\n            ):\n                output_queue.append((op,))\n                op_stack.pop()\n            else:\n                break\n        op_stack.append(op)\n\n    # Drain remaining operators\n    while op_stack:\n        output_queue.append((op_stack.pop(),))\n\n    return output_queue\ndef _evaluate_rpn(rpn):\n    \"\"\"Evaluate an expression given in RPN form.\"\"\"\n    stack = []\n\n    for token in rpn:\n        if len(token) == 1 and isinstance(token[0], int):\n            stack.append(token[0])\n            continue\n\n        op = token[0]\n        if len(stack) < 2:\n            raise ValueError(\"Insufficient operands for operator\")\n\n        b = stack.pop()\n        a = stack.pop()\n\n        if op == \"+\":\n            result = a + b\n        elif op == \"-\":\n            result = a - b\n        elif op == \"*\":\n            result = a * b\n        elif op == \"//\":\n            if b == 0:\n                raise ZeroDivisionError(\"division by zero\")\n            result = a // b\n        elif op == \"**\":\n            result = a ** b\n        else:\n            raise ValueError(f\"Unsupported operator: {op}\")\n\n        stack.append(result)\n\n    if len(stack) != 1:\n        raise ValueError(\"Malformed expression\")\n\n    return stack[0]\ndef do_algebra(operators: List[str], operands: List[int]) -> int:\n    \"\"\"\n    Evaluate an arithmetic expression represented by operand and operator lists.\n\n    Args:\n        operators: List of operator strings. Length must be len(operands)-1.\n        operands: List of non\u2011negative integers. Length at least 2.\n\n    Returns:\n        The resulting integer after evaluating the expression.\n\n    Raises:\n        TypeError: If inputs are not lists of the correct types.\n        ValueError: If input sizes or contents are invalid.\n        ZeroDivisionError: If a floor division by zero occurs.\n    \"\"\"\n    # Input validation\n    if not isinstance(operators, list) or not isinstance(operands, list):\n        raise TypeError(\"operators and operands must be lists\")\n    if len(operands) < 2:\n        raise ValueError(\"operands list must contain at least two elements\")\n    if len(operators) != len(operands) - 1:\n        raise ValueError(\n            \"operator list length must be one less than operands list length\"\n        )\n    if not all(isinstance(op, str) for op in operators):\n        raise TypeError(\"All operators must be strings\")\n    if not all(isinstance(x, int) and x >= 0 for x in operands):\n        raise TypeError(\"All operands must be non\u2011negative integers\")\n    if not all(op in _ALLOWED_OPERATORS for op in operators):\n        raise ValueError(\"Unsupported operator detected in operators list\")\n\n    rpn = _to_rpn(operators, operands)\n    return _evaluate_rpn(rpn)"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"\n    Transform the input string according to the following rules:\n\n    1. If the string contains at least one alphabetic character,\n       reverse the case of each alphabetic character:\n       - Lowercase letters are converted to uppercase.\n       - Uppercase letters are converted to lowercase.\n       Non\u2011alphabetic characters remain unchanged.\n\n    2. If the string contains no alphabetic characters at all,\n       return the string reversed.\n\n    Parameters\n    ----------\n    s : str\n        The input string to process.\n\n    Returns\n    -------\n    str\n        The resulting string after applying the transformation rules.\n    \"\"\"\n    has_letters = any(c.isalpha() for c in s)\n    if has_letters:\n        return ''.join(c.swapcase() if c.isalpha() else c for c in s)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Return the MD5 hash of a non\u2011empty string ``text`` as a hexadecimal string.\n    If ``text`` is empty, ``None`` is returned.\n\n    Parameters\n    ----------\n    text : str\n        The input string to hash.\n\n    Returns\n    -------\n    Optional[str]\n        The MD5 hex digest of ``text`` or ``None`` if ``text`` is empty.\n\n    Examples\n    --------\n    >>> string_to_md5('Hello world')\n    '3e25960a79dbc69b674cd4ec67a72c62'\n    >>> string_to_md5('')\n    None\n\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode(\"utf-8\"))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Return a list of even integers between a and b (inclusive),\n    sorted in ascending order. The order of a and b does not\n    matter. If there are no even numbers in the range, an empty\n    list is returned.\n    \"\"\"\n    start, end = sorted((a, b))\n    return [x for x in range(start, end + 1) if x % 2 == 0]"}
