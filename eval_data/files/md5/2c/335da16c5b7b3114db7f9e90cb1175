{"task_id": "HumanEval/82", "solution": "def prime_length(s: str) -> bool:\n    \"\"\"Return True if the length of *s* is a prime number, otherwise False.\n\n    Examples\n    --------\n    >>> prime_length('Hello')\n    True\n    >>> prime_length('abcdcba')\n    True\n    >>> prime_length('kittens')\n    True\n    >>> prime_length('orange')\n    False\n    \"\"\"\n    n = len(s)\n\n    if n < 2:\n        return False\n\n    # 2 and 3 are prime\n    if n in (2, 3):\n        return True\n\n    # Even numbers > 2 are not prime\n    if n % 2 == 0:\n        return False\n\n    limit = int(n ** 0.5) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    # For single-digit numbers, the only number that starts or ends with 1 is 1 itself.\n    if n == 1:\n        return 1\n\n    # Calculate powers of 10 needed for the formula.\n    pow10_n_minus_2 = 10 ** (n - 2)\n    pow10_n_minus_1 = pow10_n_minus_2 * 10\n\n    # Count numbers that start with 1: 10^(n-1)\n    start_with_1 = pow10_n_minus_1\n\n    # Count numbers that end with 1: 9 * 10^(n-2)\n    end_with_1 = 9 * pow10_n_minus_2\n\n    # Numbers that both start and end with 1 are counted twice, subtract them once.\n    both_start_and_end = pow10_n_minus_2\n\n    return start_with_1 + end_with_1 - both_start_and_end"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"\n    Return the binary representation of the sum of the decimal digits of N.\n\n    Parameters\n    ----------\n    N : int\n        A non\u2011negative integer, 0 \u2264 N \u2264 10000.\n\n    Returns\n    -------\n    str\n        Binary string without the '0b' prefix.\n    \"\"\"\n    if not isinstance(N, int):\n        raise TypeError(\"N must be an integer\")\n    if N < 0 or N > 10000:\n        raise ValueError(\"N must be in the range 0 \u2264 N \u2264 10000\")\n\n    digit_sum = sum(int(ch) for ch in str(N))\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"\n    Return the sum of all even elements that are at odd indices in the list.\n    \n    Parameters\n    ----------\n    lst : list[int]\n        Non\u2011empty list of integers.\n\n    Returns\n    -------\n    int\n        Sum of all even numbers whose positions are at odd indices.\n        An empty qualifying set yields 0.\n    \n    Example\n    -------\n    >>> add([4, 2, 6, 7])\n    2\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty\")\n    if any(not isinstance(x, int) for x in lst):\n        raise ValueError(\"All elements must be integers\")\n    \n    return sum(x for i, x in enumerate(lst) if i % 2 == 1 and x % 2 == 0)"}
{"task_id": "HumanEval/86", "solution": "import typing\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Return a new string in which each non\u2011space word from *s* has its characters sorted\n    in ascending order of their ASCII values. The relative order of words and the\n    placement of spaces are preserved unchanged.\n\n    Parameters\n    ----------\n    s : str\n        The input string.\n\n    Returns\n    -------\n    str\n        The string with each word sorted independently.\n\n    Examples\n    --------\n    >>> anti_shuffle('Hi')\n    'Hi'\n    >>> anti_shuffle('hello')\n    'ehllo'\n    >>> anti_shuffle('Hello World!!!')\n    'Hello !!!Wdlor'\n\n    Notes\n    -----\n    * Words are defined as any maximal sequence of non\u2011space characters.\n    * Consecutive spaces, leading, or trailing spaces are preserved verbatim.\n    * The function uses O(n log m) time where n is the length of the string and\n      m is the maximum word length.\n    \"\"\"\n    # Split the string on spaces; the result keeps empty strings for consecutive spaces,\n    # thereby preserving the original spacing pattern.\n    parts: typing.List[str] = s.split(' ')\n    # Sort the characters of each non\u2011empty part.\n    sorted_parts: typing.List[str] = [\n        ''.join(sorted(part)) if part else '' for part in parts\n    ]\n    # Re\u2011join the parts with a single space separator, which restores the original spacing.\n    return ' '.join(sorted_parts)"}
{"task_id": "HumanEval/87", "solution": "import typing\ndef get_row(lst: typing.List[typing.List[int]], x: int) -> typing.List[tuple]:\n    \"\"\"\n    Find all occurrences of `x` in a ragged 2\u2011dimensional list and return their coordinates.\n    \n    Each coordinate is a tuple `(row_index, column_index)` (both zero\u2011based).\n    The resulting list is sorted by row index in ascending order, and for entries in\n    the same row the column indices are sorted in descending order.\n    \n    Parameters\n    ----------\n    lst : List[List[int]]\n        A list of lists, which may have rows of different lengths.\n    x : int\n        The integer value to search for.\n    \n    Returns\n    -------\n    List[Tuple[int, int]]\n        A list of coordinates sorted as described above.\n    \n    Examples\n    --------\n    >>> get_row([\n    ...   [1,2,3,4,5,6],\n    ...   [1,2,3,4,1,6],\n    ...   [1,2,3,4,5,1]\n    ... ], 1)\n    [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    \n    >>> get_row([], 1)\n    []\n    \n    >>> get_row([[], [1], [1, 2, 3]], 3)\n    [(2, 2)]\n    \"\"\"\n    coordinates: typing.List[tuple] = []\n\n    for row_index, row in enumerate(lst):\n        # If the row is empty skip\n        if not row:\n            continue\n        for col_index, value in enumerate(row):\n            if value == x:\n                coordinates.append((row_index, col_index))\n\n    # Sort by row ascending, then column descending for same row\n    coordinates.sort(key=lambda t: (t[0], -t[1]))\n    return coordinates"}
