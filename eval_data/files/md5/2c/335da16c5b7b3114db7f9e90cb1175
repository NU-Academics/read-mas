{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Checks if there are any two distinct elements in a list of numbers that\n    differ by less than a specified threshold.\n\n    The comparison uses absolute distance: `abs(a - b) < threshold`.\n\n    Args:\n        numbers: A list of float numbers.\n        threshold: The maximum absolute difference allowed for elements to be\n                   considered \"close\". This parameter must be non-negative.\n\n    Returns:\n        True if any two distinct elements in `numbers` have an absolute\n        difference less than `threshold`, False otherwise.\n\n    Raises:\n        ValueError: If `threshold` is a negative number.\n\n    Complexity:\n        O(n log n) due to sorting, where n is the number of elements in `numbers`.\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"Threshold must be a non-negative number.\")\n\n    if len(numbers) < 2:\n        return False\n\n    # Create a sorted copy of the list. This ensures the original list\n    # is not modified, adhering to the \"pure function\" requirement.\n    # Sorting takes O(n log n) time.\n    sorted_numbers = sorted(numbers)\n\n    # After sorting, if there exist any two distinct elements 'a' and 'b'\n    # such that abs(a - b) < threshold, then there must exist an adjacent\n    # pair in the sorted list whose difference is also less than threshold.\n    # Iterating through adjacent elements takes O(n) time.\n    for i in range(len(sorted_numbers) - 1):\n        # We check sorted_numbers[i+1] - sorted_numbers[i] because\n        # sorted_numbers[i+1] >= sorted_numbers[i], so this is already\n        # an absolute difference.\n        if sorted_numbers[i+1] - sorted_numbers[i] < threshold:\n            return True  # Early exit once a sufficiently close pair is found.\n\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separate balanced, non-nested groups of parentheses from a string.\n\n    Args:\n        paren_string: A string containing multiple groups of nested parentheses.\n                      Spaces are ignored. Each group is a balanced parenthesis\n                      expression that is not nested within another group.\n\n    Returns:\n        A list of strings, each representing a top\u2011level balanced group.\n        The original spacing is removed in the returned strings.\n\n    Raises:\n        ValueError: If the input string contains unmatched parentheses\n                    or if the parentheses are improperly nested.\n\n    Examples:\n        >>> separate_paren_groups('( ) (( )) (( )( ))')\n        ['()', '(())', '(()())']\n    \"\"\"\n    # Remove spaces for easier processing\n    s = paren_string.replace(\" \", \"\")\n    groups: List[str] = []\n    depth = 0\n    start_index = None\n\n    for i, ch in enumerate(s):\n        if ch not in \"()\" :\n            # Any character other than parentheses is unexpected\n            raise ValueError(f\"Invalid character '{ch}' at position {i}\")\n\n        if ch == '(':\n            if depth == 0:\n                # Start of a new top-level group\n                start_index = i\n            depth += 1\n        else:  # ch == ')'\n            depth -= 1\n            if depth < 0:\n                raise ValueError(f\"Unmatched closing parenthesis at position {i}\")\n            if depth == 0 and start_index is not None:\n                # End of a top-level group\n                groups.append(s[start_index:i+1])\n                start_index = None\n\n    if depth != 0:\n        raise ValueError(\"Unmatched opening parenthesis remaining\")\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "import math\nimport doctest\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Return the decimal part of a positive floating point number.\n\n    Parameters\n    ----------\n    number : float\n        A positive floating point number.\n\n    Returns\n    -------\n    float\n        The fractional part of the number (always >= 0 and < 1).\n\n    Raises\n    ------\n    TypeError\n        If ``number`` is not a numeric type.\n    ValueError\n        If ``number`` is negative.\n\n    Examples\n    --------\n    >>> truncate_number(3.5)\n    0.5\n    >>> truncate_number(10.0)\n    0.0\n    >>> truncate_number(0.9999)\n    0.9999\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be a numeric type\")\n    if number < 0:\n        raise ValueError(\"Input must be non-negative\")\n\n    return number - math.floor(number)"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detect if a bank account balance goes below zero.\n\n    The account starts with a zero balance; each integer in *operations* represents\n    a deposit (positive) or withdrawal (negative).  If the running balance ever\n    becomes negative, the function immediately returns True; otherwise it\n    returns False after all operations have been processed.\n\n    Parameters\n    ----------\n    operations : List[int]\n        List of integer operations (positive for deposits, negative for\n        withdrawals).\n\n    Returns\n    -------\n    bool\n        ``True`` if the balance falls below zero at any point, otherwise\n        ``False``.\n\n    Examples\n    --------\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for amount in operations:\n        balance += amount\n        if balance < 0:\n            return True\n    return False"}
