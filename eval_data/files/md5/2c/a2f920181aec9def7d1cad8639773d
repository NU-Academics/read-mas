ns.\"\"\"\n    id: Optional[int]\n    input_json: str\n    result: str\n    origin: str\n    timestamp: str\n```\n\n```\nsrc/strconcat/utils.py\n```python\nimport json\nfrom typing import List\nfrom datetime import datetime\n\nfrom .exceptions import InvalidInputError, LengthExceededError\n\ndef validate_strings(strings: List[str], max_length: int) -> None:\n    \"\"\"Validates that the input is a list of strings and its total length is within limits.\"\"\"\n    if not isinstance(strings, list):\n        raise InvalidInputError(\"Input must be a list of strings.\")\n    total_len = 0\n    for i, s in enumerate(strings):\n        if not isinstance(s, str):\n            raise InvalidInputError(f\"Element at index {i} is not a string.\")\n        total_len += len(s)\n        if total_len > max_length:\n            raise LengthExceededError(\"Concatenated result would exceed maximum allowed length.\")\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time as an ISO 8601 formatted string.\"\"\"\n    return datetime.utcnow().isoformat(timespec='milliseconds') + \"Z\"\n```\n\n```\nsrc/strconcat/repositories.py\n```python\nimport sqlite3\nimport json\nfrom abc import ABC, abstractmethod\nfrom typing import List, Optional\nimport os # For os.makedirs\n\nfrom .models import OperationRecord\nfrom .exceptions import RepositoryError\n\nclass HistoryRepository(ABC):\n    \"\"\"Abstract base class for history repositories.\"\"\"\n    @abstractmethod\n    def save(self, record: OperationRecord) -> int:\n        \"\"\"Saves an operation record and returns its ID.\"\"\"\n        pass\n    \n    @abstractmethod\n    def list(self, limit: int = 100) -> List[OperationRecord]:\n        \"\"\"Retrieves a list of recent operation records.\"\"\"\n        pass\n    \n    @abstractmethod\n    def close(self) -> None:\n        \"\"\"Closes the repository connection.\"\"\"\n        pass\n\nclass SqliteHistoryRepository(HistoryRepository):\n    \"\"\"SQLite implementation of HistoryRepository.\"\"\"\n    def __init__(self, db_path: str):\n        self.db_path = db_path\n        # Ensure data directory exists\n        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)\n        # Use check_same_thread=False for FastAPI/async applications,\n        # but manage connections carefully if heavy concurrent writes are expected.\n        self._conn = sqlite3.connect(self.db_path, check_same_thread=False)\n        self._ensure_schema()\n\n    def _ensure_schema(self) -> None:\n        \"\"\"Ensures the necessary database schema exists.\"\"\"\n        cur = self._conn.cursor()\n        cur.execute(\"\"\"\n        CREATE TABLE IF NOT EXISTS operations (\n          id INTEGER PRIMARY KEY AUTOINCREMENT,\n          input_json TEXT NOT NULL,\n          result TEXT NOT NULL,\n          origin TEXT,\n          timestamp TEXT NOT NULL\n        );\n        \"\"\")\n        cur.execute(\"CREATE INDEX IF NOT EXISTS idx_ops_timestamp ON operations(timestamp);\")\n        self._conn.commit()\n\n    def save(self, record: OperationRecord) -> int:\n        \"\"\"Saves an operation record to the SQLite database.\"\"\"\n        try:\n            cur = self._conn.cursor()\n            cur.execute(\n                \"INSERT INTO operations (input_json, result, origin, timestamp) VALUES (?, ?, ?, ?)\",\n                (record.input_json, record.result, record.origin, record.timestamp)\n            )\n            self._conn.commit()\n            return cur.lastrowid\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"SQLite save error: {e}\") from e\n\n    def list(self, limit: int = 100) -> List[OperationRecord]:\n        \"\"\"Retrieves a list of recent operation records from SQLite.\"\"\"\n        try:\n            cur = self._conn.cursor()\n            cur.execute(\n                \"SELECT id, input_json, result, origin, timestamp FROM operations ORDER BY timestamp DESC LIMIT ?\", \n                (limit,)\n            )\n            rows = cur.fetchall()\n            return [\n                OperationRecord(id=r[0], input_json=r[1], result=r[2], origin=r[3], timestamp=r[4]) \n                for r in rows\n            ]\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"SQLite list error: {e}\") from e\n\n    def close(self) -> None:\n        \"\"\"Closes the SQLite database connection.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n```\n\n```\nsrc/strconcat/services.py\n```python\nimport json\nimport logging\nfrom typing import List, Optional\n\nfrom .models import ConcatResponse, OperationRecord\nfrom .utils import validate_strings, now_iso\nfrom .exceptions import InvalidInputError, LengthExceededError, RepositoryError\nfrom .config import AppConfig\nfrom .repositories import HistoryRepository # For type hinting\n\nlogger = logging.getLogger(__name__)\n\nclass StringConcatService:\n    \"\"\"Core business logic service for concatenating strings and persisting operations.\"\"\"\n    def __init__(self, repo: Optional[HistoryRepository], config: AppConfig):\n        self.repo = repo\n        self.config = config\n\n    def concatenate(self, strings: List[str], origin: str = \"unknown\") -> ConcatResponse:\n        \"\"\"Concatenates a list of strings and optionally persists the operation.\"\"\"\n        validate_strings(strings, self.config.max_result_length)\n        result = \"\".join(strings)\n\n        if self.repo and self.config.persist:\n            rec = OperationRecord(\n                id=None, \n                input_json=json.dumps(strings), \n                result=result, \n                origin=origin, \n                timestamp=now_iso()\n            )\n            try:\n                self.repo.save(rec)\n            except RepositoryError:\n                # Log error but do not re-raise, as per FR2 error handling (unless configured otherwise).\n                logger.exception(\"Failed to persist operation to history.\")\n        \n        return ConcatResponse(result=result)\n```\n\n```\nsrc/strconcat/controllers.py\n```python\nimport argparse\nimport sys\nfrom typing import List\n\nfrom .models import ConcatRequest, ConcatResponse\nfrom .services import StringConcatService\nfrom .exceptions import InvalidInputError, LengthExceededError, RepositoryError\n\nclass CLIController:\n    \"\"\"Controller for handling command-line interface requests.\"\"\"\n    def __init__(self, service: StringConcatService):\n        self.service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses CLI arguments, performs concatenation, and prints result.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"strconcat-cli\",\n            description=\"Concatenate strings and optionally persist the operation.\"\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", required=True, help=\"Subcommand\")\n\n        concat_parser = subparsers.add_parser(\n            \"concat\", \n            help=\"Concatenate a list of strings.\"\n        )\n        concat_parser.add_argument(\n            \"strings\", \n            nargs=\"+\", \n            help=\"Strings to concatenate (space-separated).\"\n        )\n        concat_parser.add_argument(\n            \"--persist\", \n            action=\"store_true\", \n            help=\"Persist the operation history to the database.\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.command == \"concat\":\n            # Override persistence config if --persist flag is used\n            original_persist_setting = self.service.config.persist\n            if args.persist:\n                self.service.config.persist = True \n            \n            try:\n                response = self.service.concatenate(args.strings, origin=\"cli\")\n                print(response.result)\n                return 0\n            except InvalidInputError as e:\n                print(f\"Error: Invalid input: {e}\", file=sys.stderr)\n                return 3\n            except LengthExceededError as e:\n                print(f\"Error: Result length exceeded: {e}\", file=sys.stderr)\n                return 3\n            except Exception as e: # Catch other unexpected errors\n                print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n                return 1\n            finally:\n                # Restore original persistence setting for other potential uses of the service instance\n                self.service.config.persist = original_persist_setting\n        \n        return 1 # Should not be reached if command is required\n\n\nclass APIController:\n    \"\"\"Controller for handling HTTP API requests.\"\"\"\n    def __init__(self, service: StringConcatService):\n        self.service = service\n\n    def post_concatenate(self, request: ConcatRequest) -> ConcatResponse:\n        \"\"\"Processes a POST /concatenate request.\"\"\"\n        return self.service.concatenate(request.strings, origin=\"http\")\n```\n\n```\nsrc/strconcat/app.py\n```python\nimport atexit\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel, Field\nfrom typing import List, Optional\n\nfrom .config import AppConfig\nfrom .repositories import SqliteHistoryRepository, HistoryRepository\nfrom .services import StringConcatService\nfrom .controllers import APIController\nfrom .exceptions import InvalidInputError, LengthExceededError, RepositoryError\nfrom .models import ConcatRequest, ConcatResponse\n\nclass ConcatRequestSchema(BaseModel):\n    \"\"\"Pydantic schema for the POST /concatenate request body.\"\"\"\n    strings: List[str] = Field(..., description=\"List of strings to concatenate.\")\n\nclass ConcatResponseSchema(BaseModel):\n    \"\"\"Pydantic schema for the POST /concatenate response body.\"\"\"\n    result: str = Field(..., description=\"The concatenated string.\")\n\ndef create_app(config: AppConfig, repo: Optional[HistoryRepository] = None) -> FastAPI:\n    \"\"\"\n    Creates and configures the FastAPI application.\n    Initializes service, controllers, and defines API routes and error handlers.\n    \"\"\"\n    # If repo is not provided and persistence is enabled, create a new one.\n    # This instance will be managed by the application's lifecycle.\n    if repo is None and config.persist:\n        repo = SqliteHistoryRepository(config.db_path)\n    \n    service = StringConcatService(repo, config)\n    controller = APIController(service)\n    app = FastAPI(\n        title=\"String Concatenation Service\",\n        description=\"A simple service to concatenate lists of strings.\",\n        version=\"0.1.0\"\n    )\n\n    @app.post(\n        \"/concatenate\", \n        response_model=ConcatResponseSchema, \n        summary=\"Concatenate strings\",\n        description=\"Joins a list of strings into a single string.\"\n    )\n    async def concatenate_endpoint(req_schema: ConcatRequestSchema):\n        \"\"\"\n        HTTP endpoint to concatenate a list of strings.\n        Handles validation errors and returns the concatenated result.\n        \"\"\"\n        try:\n            # Map Pydantic schema to internal DTO\n            concat_request = ConcatRequest(strings=req_schema.strings)\n            resp = controller.post_concatenate(concat_request)\n            # Map internal DTO to Pydantic response schema\n            return ConcatResponseSchema(result=resp.result)\n        except InvalidInputError as e:\n            raise HTTPException(status_code=400, detail=str(e))\n        except LengthExceededError as e:\n            raise HTTPException(status_code=413, detail=str(e))\n        except RepositoryError as e:\n            # As per FR2 and HTTP API error handling:\n            # If persistence fails, return 500 for server errors.\n            raise HTTPException(status_code=500, detail=\"Internal repository error. Please check server logs.\")\n        except Exception as e:\n            raise HTTPException(status_code=500, detail=f\"An unexpected server error occurred: {e}\")\n\n    return app\n\nclass AsgiApp:\n    \"\"\"ASGI application wrapper for FastAPI, managing app and repository lifecycle.\"\"\"\n    _app: Optional[FastAPI] = None\n    _config: Optional[AppConfig] = None\n    _repo: Optional[HistoryRepository] = None\n\n    @classmethod\n    def get_app(cls) -> FastAPI:\n        \"\"\"\n        Initializes and returns the FastAPI application instance.\n        Ensures a single instance and handles repository setup and shutdown.\n        \"\"\"\n        if cls._app is None:\n            cls._config = AppConfig.from_env()\n            cls._repo = SqliteHistoryRepository(cls._config.db_path) if cls._config.persist else None\n            cls._app = create_app(cls._config, cls._repo)\n            \n            # Register atexit handler for the repository to ensure it's closed on application exit.\n            if cls._repo:\n                atexit.register(cls._close_repo)\n        return cls._app\n\n    @classmethod\n    def _close_repo(cls):\n        \"\"\"Internal method to close the repository connection.\"\"\"\n        if cls._repo:\n            cls._repo.close()\n            cls._repo = None # Clear reference after closing\n\n# The entry point for uvicorn (e.g., `uvicorn src.strconcat.app:app`)\napp = AsgiApp.get_app() \n```\n\n```\nsrc/strconcat/cli.py\n```python\nimport sys\nimport os\nimport logging\nfrom typing import Optional\n\nfrom .config import AppConfig\nfrom .repositories import SqliteHistoryRepository\nfrom .controllers import CLIController\nfrom .services import StringConcatService # Import for direct instantiation\n\n# Configure basic logging for CLI\nlogging.basicConfig(level=os.getenv(\"STRCONCAT_LOG_LEVEL\", \"INFO\").upper(),\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\ndef main() -> int:\n    \"\"\"\n    Main entry point for the command-line interface.\n    Initializes configuration, repository, and controller to run CLI commands.\n    \"\"\"\n    config = AppConfig.from_env()\n    \n    repo: Optional[SqliteHistoryRepository] = None\n    if config.persist:\n        try:\n            repo = SqliteHistoryRepository(config.db_path)\n            logger.info(f\"Persistence enabled. Using database: {config.db_path}\")\n        except Exception as e:\n            logger.error(f\"Failed to initialize repository at {config.db_path}: {e}\")\n            print(f\"Error: Could not initialize database. Persistence disabled for this operation.\", file=sys.stderr)\n            repo = None # Disable persistence if DB init fails\n            config.persist = False # Reflect the actual state\n\n    service = StringConcatService(repo, config)\n    controller = CLIController(service)\n\n    exit_code = controller.run(sys.argv[1:])\n    \n    if repo:\n        try:\n            repo.close()\n        except Exception as e:\n            logger.error(f\"Error closing repository connection: {e}\")\n\n    return exit_code\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```toml\npyproject.toml\n```toml\n[tool.poetry]\nname = \"strconcat\"\nversion = \"0.1.0\"\ndescription = \"A Python library and service to concatenate lists of strings.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{include = \"strconcat\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\nfastapi = \"^0.104.1\"\nuvicorn = {extras = [\"standard\"], version = \"^0.24.0.post1\"}\npydantic = \"^2.5.2\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^7.4.3\"\npytest-cov = \"^4.1.0\"\nflake8 = \"^6.1.0\"\nmypy = \"^1.7.0\"\nruff = \"^0.1.6\"\n\n[tool.poetry.scripts]\nstrconcat-cli = \"strconcat.cli:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n# Optional: MyPy configuration\n[tool.mypy]\npython_version = \"3.9\"\nstrict = true\nignore_missing_imports = true # Temporarily for packages like fastapi/pydantic if stubs are missing/incomplete\nplugins = [\"pydantic.mypy\"] # For Pydantic v2 type checking\n\n# Optional: Ruff configuration\n[tool.ruff]\nline-length = 100\nselect = [\"E\", \"F\", \"W\", \"I\", \"C\", \"N\"] # Common error, flake8, warnings, imports, complexity, names\n# D for docstrings can be added, but might be too strict initially.\nignore = [\"E501\"] # Line too long\n```\n\n```markdown\nREADME.md\n```markdown\n# String Concatenation Service\n\nThis project provides a Python library and a small service to concatenate lists of strings. It offers both a command-line interface (CLI) and an HTTP API, along with optional operation history persistence using SQLite.\n\n## Features\n\n-   **Concatenation**: Join a list of strings into a single string.\n-   **Persistence**: Optionally record a history of concatenate operations (input, result, timestamp, origin) to a SQLite database.\n-   **CLI**: A command-line tool `strconcat-cli` for direct usage.\n-   **HTTP API**: A FastAPI-based service exposing a `/concatenate` endpoint.\n-   **Validation**: Input validation for type and maximum result length.\n\n## Installation\n\nThis project uses Poetry for dependency management.\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-username/strconcat.git\n    cd strconcat\n    ```\n\n2.  **Install dependencies:**\n    ```bash\n    poetry install\n    ```\n\n3.  **Activate the virtual environment:**\n    ```bash\n    poetry shell\n    ```\n\n## Usage\n\n### Command-Line Interface (CLI)\n\nUse the `strconcat-cli` command:\n\n```bash\n# Concatenate strings without persisting history\nstrconcat-cli concat hello world python\n\n# Expected output:\n# helloworldpython\n\n# Concatenate strings and persist the operation for this specific command\nstrconcat-cli concat --persist \"alpha beta\" gamma\n\n# Use environment variables to enable global persistence for the CLI\nSTRCONCAT_PERSIST=true strconcat-cli concat \"env persist\" example\n```\n\n### HTTP API\n\nThe HTTP API is powered by FastAPI.\n\n1.  **Run the service:**\n    ```bash\n    # Ensure you are in the poetry shell\n    uvicorn src.strconcat.app:app --host 0.0.0.0 --port 8000 --reload\n    ```\n    (Remove `--reload` for production deployments)\n\n2.  **Access the API:**\n    The service will be available at `http://0.0.0.0:8000`.\n    You can test it using `curl` or a tool like Postman/Insomnia:\n\n    ```bash\n    curl -X POST \"http://localhost:8000/concatenate\" \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"strings\": [\"hello\", \"fastapi\", \"world\"]}'\n    ```\n\n    **Expected response (HTTP 200 OK):**\n    ```json\n    {\"result\": \"hellofastapiworld\"}\n    ```\n\n    **Error example (HTTP 400 Bad Request for invalid input):**\n    ```bash\n    curl -X POST \"http://localhost:8000/concatenate\" \\\n         -H \"Content-Type: application/json\" \\\n         -d '{\"strings\": [\"a\", 123]}'\n    ```\n\n    **Expected response:**\n    ```json\n    {\"detail\":\"Element at index 1 is not a string.\"}\n    ```\n\n    **Documentation:**\n    Access the interactive API documentation (Swagger UI) at `http://localhost:8000/docs`.\n\n## Configuration\n\nThe application can be configured using environment variables:\n\n-   `STRCONCAT_DB_PATH`: Path to the SQLite database file. Default: `./data/strconcat.db`\n-   `STRCONCAT_PERSIST`: Set to `true` (or `1`, `yes`) to enable operation history persistence. Default: `false`\n-   `STRCONCAT_MAX_RESULT_LENGTH`: Maximum allowed length for the concatenated string. Default: `1000000` (1 million characters)\n-   `STRCONCAT_LOG_LEVEL`: Log level for CLI (e.g., `DEBUG`, `INFO`, `WARNING`, `ERROR`). Default: `INFO`\n\n## Project Structure\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 strconcat/\n\u2502       \u251c\u2500\u2500 __init__.py         # Package init (version, exports)\n\u2502       \u251c\u2500\u2500 config.py           # AppConfig, constants, DEFAULTS\n\u2502       \u251c\u2500\u2500 exceptions.py       # Custom exceptions\n\u2502       \u251c\u2500\u2500 models.py           # DTOs: ConcatRequest, ConcatResponse, OperationRecord\n\u2502       \u251c\u2500\u2500 utils.py            # Validation utilities\n\u2502       \u251c\u2500\u2500 repositories.py     # HistoryRepository (interface) and SqliteHistoryRepository\n\u2502       \u251c\u2500\u2500 services.py         # StringConcatService (core business logic)\n\u2502       \u251c\u2500\u2500 controllers.py      # CLIController & APIController (adapters)\n\u2502       \u251c\u2500\u2500 app.py              # FastAPI app factory and ASGI app\n\u2502       \u2514\u2500\u2500 cli.py              # CLI entrypoint\n\u251c\u2500\u2500 data/                       # Default directory for SQLite DB\n\u251c\u2500\u2500 pyproject.toml              # Build config, dependencies\n\u2514\u2500\u2500 README.md\n```\n\n## Development\n\n### Running Tests\n\n```bash\npoetry run pytest\n```\n\n### Type Checking\n\n```bash\npoetry run mypy src/\n```\n\n### Linting\n\n```bash\npoetry run ruff check src/\n```\n\n## License\n\nThis project is licensed under the MIT License. See the `LICENSE` file for details.\n```\n\n```\nLICENSE\n```\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```"}
