{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) == [0, 1, 2, 3, 4]\n    \"\"\"\n    def get_sort_key(n: int):\n        # Negative numbers are sorted by their numeric value only.\n        if n < 0:\n            return (0, n)\n        # Non-negative numbers sorted by bit count then numeric value.\n        return (1, bin(n).count('1'), n)\n\n    return sorted(arr, key=get_sort_key)\n```"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns words from s with exactly n consonants.\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _count_consonants_in_word(word_text: str) -> int:\n        \"\"\"Counts consonants in a single word, assuming it's alphabetic.\"\"\"\n        count = 0\n        for char in word_text.lower():\n            if char.isalpha() and char not in VOWELS:\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    result = []\n    words = s.split()\n\n    for word in words:\n        consonant_count = _count_consonants_in_word(word)\n        if consonant_count == n:\n            result.append(word)\n            \n    return result"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n\n    # Defines an inline helper for bit counting.\n    def _bit_count(n):\n        return bin(n).count('1')\n\n    # Handles negative numbers by sorting numerically ascending.\n    if any(x < 0 for x in arr):\n        return sorted(arr)\n    else:\n        # Sorts by bit count then by numeric value for non-negative numbers.\n        keyed_values = [(_bit_count(x), x) for x in arr]\n        keyed_values.sort()\n        return [value for _, value in keyed_values]\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns words with exactly n consonants.\n    Words are tokenized by space, and 'y' is considered a consonant.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    result_words = []\n\n    # Split the sentence into words, filtering out any empty strings that result from multiple spaces.\n    words = [word for word in s.split(' ') if word]\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            # Check if the character is an alphabet letter.\n            if char.isalpha():\n                # If it's a letter and not a vowel (case-insensitive), it's a consonant.\n                if char.lower() not in vowels:\n                    consonant_count += 1\n        \n        # If the word's consonant count matches n, add it to the result list.\n        if consonant_count == n:\n            result_words.append(word)\n            \n    return result_words\n```"}
{"task_id": "HumanEval/118", "solution": "_VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\ndef _is_vowel(ch: str) -> bool:\n    \"\"\"Checks if a character is a vowel.\"\"\"\n    return ch in _VOWELS\n\ndef _is_consonant(ch: str) -> bool:\n    \"\"\"Checks if a character is a consonant (an English letter not in _VOWELS).\"\"\"\n    return ch.isalpha() and ch not in _VOWELS\n\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels at the beginning or ending of the word are ignored.\n    \"\"\"\n    n = len(word)\n    if n < 3: \n        return \"\"\n\n    # Iterate from the second-to-last character (index n-2) down to the second character (index 1).\n    # This range excludes the first and last characters of the word.\n    for i in range(n - 2, 0, -1):\n        # Check if the current character is a vowel and its immediate neighbors are consonants.\n        if _is_vowel(word[i]) and _is_consonant(word[i-1]) and _is_consonant(word[i+1]):\n            return word[i]\n            \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    s1 = lst[0]\n    s2 = lst[1]\n\n    def _net_balance(s):\n        \"\"\"Calculates the net balance of parentheses in a string.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n        return balance\n\n    def _min_prefix_balance(s):\n        \"\"\"Calculates the minimum prefix balance of parentheses in a string.\"\"\"\n        balance = 0\n        min_bal = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            min_bal = min(min_bal, balance)\n        return min_bal\n\n    def _is_good_concatenation(first, second):\n        \"\"\"Checks if concatenating 'first' then 'second' results in a good string.\"\"\"\n        # Ensure 'first' string itself never drops below zero balance.\n        if _min_prefix_balance(first) < 0:\n            return False\n\n        net_bal_first = _net_balance(first)\n        net_bal_second = _net_balance(second)\n\n        # Total net balance of the combined string must be zero.\n        if net_bal_first + net_bal_second != 0:\n            return False\n\n        # Ensure the combined string (first + second) never drops below zero balance\n        # at any point in the 'second' part.\n        if _min_prefix_balance(second) + net_bal_first < 0:\n            return False\n\n        return True\n\n    if _is_good_concatenation(s1, s2) or _is_good_concatenation(s2, s1):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n\n    # Define the set of vowels for character classification.\n    vowels = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\n    def is_vowel(ch: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return ch in vowels\n\n    def is_consonant(ch: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return ch.isalpha() and ch not in vowels\n\n    n = len(word)\n\n    # A word must have at least 3 characters for a vowel to be between two consonants.\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # This range excludes the first and last characters as per the requirements.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_neighbor = word[i-1]\n        right_neighbor = word[i+1]\n\n        # Check if the current character is a vowel and its neighbors are consonants.\n        if is_vowel(current_char) and is_consonant(left_neighbor) and is_consonant(right_neighbor):\n            return current_char\n\n    # If no such vowel is found after scanning, return an empty string.\n    return \"\"\n```"}
{"task_id": "HumanEval/119", "solution": "from typing import List\n\ndef match_parens(lst: List[str]) -> str:\n    '''\n    Checks if two parentheses strings can form a balanced string by concatenation.\n    Assumes valid input: a list of exactly two strings containing only '(' and ')'.\n    '''\n    # Helper function for checking if a string of parentheses is balanced.\n    def _is_balanced(s: str) -> bool:\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            else:\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2 concatenation\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check s2 + s1 concatenation\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "import heapq\n\ndef maximum(arr, k):\n    \"\"\"\n    Returns the top-k maximum numbers from arr as a sorted list.\n    The list will have length k, sorted ascending.\n    \"\"\"\n    if k == 0:\n        return []\n\n    n = len(arr)\n    # Use heap for smaller k (O(N log K)), sort for larger k (O(N log N)).\n    # A simple heuristic is to choose heap when k is less than half the array length.\n    if k <= n // 2:\n        top_k = heapq.nlargest(k, arr)\n        return sorted(top_k)\n    else:\n        # For larger k, a full sort is often efficient due to optimized implementations.\n        return sorted(arr)[-k:]"}
{"task_id": "HumanEval/120", "solution": "```python\nimport heapq\n\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, returns a sorted list\n    of length k with the maximum k numbers in arr. Uses heapq.nlargest for efficiency.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Efficiently finds the k largest elements. The result is then sorted ascending.\n    largest_elements = heapq.nlargest(k, arr)\n    return sorted(largest_elements)\n```"}
