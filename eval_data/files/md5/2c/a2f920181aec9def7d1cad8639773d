{"task_id": "HumanEval/53", "solution": "```python\n# src/mycalc/__init__.py\n__version__ = \"0.1.0\"\n\nfrom .arithmetic import add\nfrom .models.number_pair import NumberPair\nfrom .models.operation_record import OperationRecord\nfrom .services.calculator_service import CalculatorService\nfrom .controllers.cli_controller import CLIController\nfrom .controllers.api_controller import APIController\nfrom .repositories.operation_repository import OperationRepository\nfrom .utils.validators import Validator\nfrom .errors import ValidationError, CalculationError, RepositoryError\nfrom .config import (\n    PERSISTENCE_ENABLED, DB_PATH, API_ENABLED, API_HOST, API_PORT\n)\n```\n\n```python\n# src/mycalc/errors.py\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass CalculationError(Exception):\n    \"\"\"Exception raised for errors during arithmetic operations.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for errors during data persistence.\"\"\"\n    pass\n```\n\n```python\n# src/mycalc/config.py\nimport os\n\nPERSISTENCE_ENABLED: bool = os.getenv(\"MYCALC_PERSISTENCE_ENABLED\", \"false\").lower() == \"true\"\nDB_PATH: str = os.getenv(\"MYCALC_DB_PATH\", \"operations.db\")\nAPI_ENABLED: bool = os.getenv(\"MYCALC_API_ENABLED\", \"false\").lower() == \"true\"\nAPI_HOST: str = os.getenv(\"MYCALC_API_HOST\", \"127.0.0.1\")\nAPI_PORT: int = int(os.getenv(\"MYCALC_API_PORT\", \"8000\"))\nAPI_AUTH_KEY: str | None = os.getenv(\"MYCALC_API_KEY\", None)\n```\n\n```python\n# src/mycalc/arithmetic.py\nfrom .errors import CalculationError\n\nclass Arithmetic:\n    \"\"\"Core arithmetic operations.\"\"\"\n    @staticmethod\n    def add(a: int, b: int) -> int:\n        \"\"\"Adds two integers.\"\"\"\n        try:\n            return a + b\n        except Exception as e:\n            raise CalculationError(\"Arithmetic failure during addition\") from e\n\ndef add(x: int, y: int) -> int:\n    \"\"\"Add two numbers x and y.\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    return Arithmetic.add(x, y)\n```\n\n```python\n# src/mycalc/models/number_pair.py\nfrom typing import Any, Tuple\n\nclass NumberPair:\n    \"\"\"Data Transfer Object for a pair of numbers.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    @classmethod\n    def from_values(cls, a: Any, b: Any) -> \"NumberPair\":\n        \"\"\"Creates a NumberPair from given values.\"\"\"\n        # Validation is typically done by Validator, but for DTO creation,\n        # we assume values are already validated or convert without loss.\n        return cls(int(a), int(b))\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the pair as a tuple.\"\"\"\n        return (self.a, self.b)\n```\n\n```python\n# src/mycalc/models/operation_record.py\nfrom typing import Optional, Dict, Any\nfrom datetime import datetime\n\nclass OperationRecord:\n    \"\"\"Data model for a recorded arithmetic operation.\"\"\"\n    def __init__(self, a: int, b: int, result: int,\n                 created_at: Optional[datetime] = None,\n                 id: Optional[int] = None):\n        self.id = id\n        self.a = a\n        self.b = b\n        self.result = result\n        self.created_at = created_at if created_at is not None else datetime.now()\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the record to a dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"a\": self.a,\n            \"b\": self.b,\n            \"result\": self.result,\n            \"created_at\": self.created_at.isoformat()\n        }\n```\n\n```python\n# src/mycalc/utils/validators.py\nfrom typing import Any\nfrom ..errors import ValidationError\n\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def validate_int(value: Any) -> int:\n        \"\"\"Validates if a value can be converted to an integer without loss.\"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            if value.lstrip('-').isdigit(): # Allows positive and negative integers as strings\n                return int(value)\n        raise ValidationError(f\"Expected integer, got {value!r} of type {type(value).__name__}\")\n```\n\n```python\n# src/mycalc/repositories/operation_repository.py\nimport sqlite3\nimport logging\nfrom typing import List, Optional\nfrom datetime import datetime\nfrom ..models.operation_record import OperationRecord\nfrom ..errors import RepositoryError\n\nlogger = logging.getLogger(__name__)\n\nclass OperationRepository:\n    \"\"\"Handles persistence of operation records to SQLite.\"\"\"\n    def __init__(self, db_path: str):\n        self._db_path = db_path\n        self.create_tables()\n\n    def _get_connection(self) -> sqlite3.Connection:\n        \"\"\"Establishes a connection to the SQLite database.\"\"\"\n        try:\n            conn = sqlite3.connect(self._db_path)\n            conn.row_factory = sqlite3.Row\n            return conn\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to connect to database at {self._db_path}\") from e\n\n    def create_tables(self) -> None:\n        \"\"\"Creates the operations table if it does not exist.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\"\"\"\n                    CREATE TABLE IF NOT EXISTS operations (\n                        id INTEGER PRIMARY KEY AUTOINCREMENT,\n                        a INTEGER NOT NULL,\n                        b INTEGER NOT NULL,\n                        result INTEGER NOT NULL,\n                        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n                    )\n                \"\"\")\n                cursor.execute(\"CREATE INDEX IF NOT EXISTS idx_operations_created_at ON operations(created_at DESC);\")\n                cursor.execute(\"CREATE INDEX IF NOT EXISTS idx_operations_a_b ON operations(a, b);\")\n                conn.commit()\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to create tables in {self._db_path}\") from e\n\n    def add_record(self, record: OperationRecord) -> int:\n        \"\"\"Inserts a new operation record into the database.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"INSERT INTO operations (a, b, result, created_at) VALUES (?, ?, ?, ?)\",\n                    (record.a, record.b, record.result, record.created_at.isoformat())\n                )\n                conn.commit()\n                return cursor.lastrowid # type: ignore\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to add record: {record.to_dict()}\") from e\n\n    def list_records(self, limit: int = 100) -> List[OperationRecord]:\n        \"\"\"Retrieves recent operation records from the database.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"SELECT id, a, b, result, created_at FROM operations ORDER BY created_at DESC LIMIT ?\",\n                    (limit,)\n                )\n                rows = cursor.fetchall()\n                records = []\n                for row in rows:\n                    created_at_dt = datetime.fromisoformat(row[\"created_at\"])\n                    records.append(OperationRecord(\n                        id=row[\"id\"],\n                        a=row[\"a\"],\n                        b=row[\"b\"],\n                        result=row[\"result\"],\n                        created_at=created_at_dt\n                    ))\n                return records\n        except sqlite3.Error as e:\n            raise RepositoryError(\"Failed to list records.\") from e\n```\n\n```python\n# src/mycalc/services/calculator_service.py\nimport logging\nfrom typing import Optional\n\nfrom ..models.number_pair import NumberPair\nfrom ..models.operation_record import OperationRecord\nfrom ..utils.validators import Validator\nfrom ..arithmetic import Arithmetic\nfrom ..repositories.operation_repository import OperationRepository\nfrom ..errors import CalculationError, RepositoryError\n\nlogger = logging.getLogger(__name__)\n\nclass CalculatorService:\n    \"\"\"Orchestrates arithmetic operations, validation, and optional persistence.\"\"\"\n    def __init__(self, validator: Validator, repo: Optional[OperationRepository] = None):\n        self._validator = validator\n        self._repo = repo\n\n    def add_numbers(self, pair: NumberPair) -> int:\n        \"\"\"Performs addition of two numbers and optionally logs the operation.\"\"\"\n        a, b = pair.a, pair.b # Assumes pair.a and pair.b are already validated integers\n        \n        try:\n            result = Arithmetic.add(a, b)\n        except CalculationError:\n            raise # Re-raise calculation errors directly\n        except Exception as e:\n            raise CalculationError(f\"Unexpected error during calculation: {e}\") from e\n\n        if self._repo:\n            self._log_operation(a, b, result)\n            \n        return result\n\n    def _log_operation(self, a: int, b: int, result: int) -> None:\n        \"\"\"Creates an OperationRecord and attempts to persist it.\"\"\"\n        try:\n            record = OperationRecord(a=a, b=b, result=result)\n            self._repo.add_record(record) # type: ignore\n        except RepositoryError as e:\n            logger.error(f\"Failed to log operation {a}+{b}={result}: {e}\")\n        except Exception as e:\n            logger.error(f\"Unexpected error logging operation {a}+{b}={result}: {e}\")\n```\n\n```python\n# src/mycalc/controllers/cli_controller.py\nimport sys\nimport argparse\nimport logging\nfrom typing import List, Optional\n\nfrom ..services.calculator_service import CalculatorService\nfrom ..models.number_pair import NumberPair\nfrom ..errors import ValidationError, CalculationError\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"CLI interface for the calculator service.\"\"\"\n    def __init__(self, service: CalculatorService):\n        self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses CLI arguments, performs the operation, and prints the result.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"mycalc\",\n            description=\"A simple integer calculator.\"\n        )\n        parser.add_argument(\n            \"command\",\n            choices=[\"add\"],\n            help=\"Operation to perform (currently only 'add').\"\n        )\n        parser.add_argument(\n            \"a\",\n            type=str, # Parse as string, then validate to allow custom error messages\n            help=\"First integer operand.\"\n        )\n        parser.add_argument(\n            \"b\",\n            type=str, # Parse as string, then validate to allow custom error messages\n            help=\"Second integer operand.\"\n        )\n        parser.add_argument(\n            \"--debug\",\n            action=\"store_true\",\n            help=\"Enable debug output (e.g., stack traces).\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.debug:\n            logging.basicConfig(level=logging.DEBUG)\n        else:\n            logging.basicConfig(level=logging.INFO, format='%(message)s')\n\n        try:\n            # Validator is used implicitly via service construction,\n            # but CLI needs direct validation on raw args.\n            validated_a = self._service._validator.validate_int(args.a)\n            validated_b = self._service._validator.validate_int(args.b)\n            \n            pair = NumberPair(validated_a, validated_b)\n            result = self._service.add_numbers(pair)\n            print(result)\n            return 0\n        except ValidationError as e:\n            logger.error(f\"Error: Invalid input: {e}\")\n            return 1\n        except CalculationError as e:\n            logger.error(f\"Calculation error: {e}\")\n            if args.debug:\n                logger.exception(\"Debug information:\")\n            return 1\n        except Exception as e:\n            logger.error(f\"An unexpected error occurred: {e}\")\n            if args.debug:\n                logger.exception(\"Debug information:\")\n            return 1\n```\n\n```python\n# src/mycalc/controllers/api_controller.py\nimport logging\nfrom typing import Dict, Any, Optional\n\ntry:\n    from fastapi import FastAPI, HTTPException, status, Depends\n    from pydantic import BaseModel\n    from starlette.responses import JSONResponse\nexcept ImportError:\n    # Fallback for when FastAPI is not installed, provide a mock\n    # This keeps the core library functional without the API dependencies\n    class FastAPI:\n        def __init__(self, *args, **kwargs):\n            logging.warning(\"FastAPI not installed. API functionality will be limited or unavailable.\")\n        def post(self, path: str):\n            def decorator(func):\n                return func\n            return decorator\n        def get(self, path: str):\n            def decorator(func):\n                return func\n            return decorator\n    class HTTPException(Exception):\n        def __init__(self, status_code: int, detail: str):\n            super().__init__(detail)\n            self.status_code = status_code\n            self.detail = detail\n    class BaseModel:\n        pass\n    class JSONResponse:\n        def __init__(self, content: Any, status_code: int = 200, *args, **kwargs):\n            self.body = content\n            self.status_code = status_code\n    class Depends:\n        def __init__(self, dependency):\n            self.dependency = dependency\n\nfrom ..services.calculator_service import CalculatorService\nfrom ..models.number_pair import NumberPair\nfrom ..errors import ValidationError, CalculationError\nfrom ..config import API_AUTH_KEY\n\nlogger = logging.getLogger(__name__)\n\nclass AddRequest(BaseModel):\n    \"\"\"Pydantic model for the add request payload.\"\"\"\n    a: int\n    b: int\n\nclass APIController:\n    \"\"\"Provides a REST API using FastAPI for arithmetic operations.\"\"\"\n    def __init__(self, service: CalculatorService):\n        self._service = service\n        self.app = FastAPI(title=\"MyCalc API\", version=\"0.1.0\")\n        self._register_routes()\n\n    def _register_routes(self):\n        \"\"\"Registers API endpoints.\"\"\"\n        if API_AUTH_KEY:\n            def verify_api_key(x_api_key: str = Depends(lambda header: header.headers.get(\"X-API-KEY\"))):\n                if not x_api_key or x_api_key != API_AUTH_KEY:\n                    raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Invalid API Key\")\n                return x_api_key\n            \n            dependencies = [Depends(verify_api_key)]\n        else:\n            dependencies = []\n\n        @self.app.post(\"/add\", dependencies=dependencies, summary=\"Add two integers\")\n        async def post_add(request_body: AddRequest) -> Dict[str, int]:\n            \"\"\"Handles POST requests to /add, performing addition.\"\"\"\n            try:\n                # Validation of 'a' and 'b' to int is handled by Pydantic's AddRequest\n                pair = NumberPair(request_body.a, request_body.b)\n                result = self._service.add_numbers(pair)\n                return {\"result\": result}\n            except ValidationError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=f\"Validation Error: {e}\")\n            except CalculationError as e:\n                logger.exception(\"Calculation Error during API call:\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"Calculation Error: {e}\")\n            except Exception as e:\n                logger.exception(\"Unhandled Exception during API call:\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"Internal Server Error: {e}\")\n\n        @self.app.get(\"/health\", summary=\"Health check endpoint\")\n        async def health_check() -> Dict[str, str]:\n            \"\"\"Provides a basic health check endpoint.\"\"\"\n            return {\"status\": \"ok\"}\n\n    def get_app(self):\n        \"\"\"Returns the FastAPI application instance.\"\"\"\n        return self.app\n```\n\n```python\n# src/mycalc/integrations/external_client.py\nimport requests\nimport subprocess\nimport json\nimport sys\nfrom typing import List, Dict, Any\n\nclass ExternalClient:\n    \"\"\"A client for interacting with the mycalc API and CLI for testing/examples.\"\"\"\n\n    def call_add_via_api(self, url: str, a: int, b: int, api_key: Optional[str] = None) -> Dict[str, Any]:\n        \"\"\"Calls the /add API endpoint.\"\"\"\n        headers = {\"Content-Type\": \"application/json\"}\n        if api_key:\n            headers[\"X-API-KEY\"] = api_key\n        payload = {\"a\": a, \"b\": b}\n        response = requests.post(f\"{url}/add\", headers=headers, json=payload)\n        response.raise_for_status()\n        return response.json()\n\n    def call_add_via_cli(self, argv: List[str]) -> Dict[str, Any]:\n        \"\"\"Invokes the CLI command in a subprocess.\"\"\"\n        cmd = [sys.executable, \"-m\", \"mycalc.cli\"] + argv\n        try:\n            result = subprocess.run(cmd, capture_output=True, text=True, check=True)\n            return {\n                \"stdout\": result.stdout.strip(),\n                \"stderr\": result.stderr.strip(),\n                \"returncode\": result.returncode\n            }\n        except subprocess.CalledProcessError as e:\n            return {\n                \"stdout\": e.stdout.strip(),\n                \"stderr\": e.stderr.strip(),\n                \"returncode\": e.returncode\n            }\n```\n\n```python\n# src/mycalc/cli.py\nimport sys\nimport logging\nfrom typing import List, Optional\n\nfrom .config import PERSISTENCE_ENABLED, DB_PATH\nfrom .utils.validators import Validator\nfrom .repositories.operation_repository import OperationRepository\nfrom .services.calculator_service import CalculatorService\nfrom .controllers.cli_controller import CLIController\n\nlogger = logging.getLogger(__name__)\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entrypoint for the CLI application.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    validator = Validator()\n    \n    repo: Optional[OperationRepository] = None\n    if PERSISTENCE_ENABLED:\n        try:\n            repo = OperationRepository(db_path=DB_PATH)\n            repo.create_tables() # Ensure tables exist on startup if persistence enabled\n            logger.info(f\"Operation history persistence enabled to {DB_PATH}\")\n        except Exception as e:\n            logger.error(f\"Failed to initialize operation repository. Persistence disabled. Error: {e}\")\n            repo = None # Disable persistence if repo init fails\n\n    calculator_service = CalculatorService(validator=validator, repo=repo)\n    cli_controller = CLIController(service=calculator_service)\n\n    return cli_controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# pyproject.toml\n[project]\nname = \"mycalc\"\nversion = \"0.1.0\"\ndescription = \"A small, well-tested, distributable Python library for integer addition.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\ndependencies = [\n    # No mandatory dependencies for the core library\n]\n\n[project.optional-dependencies]\napi = [\n    \"fastapi~=0.110.0\",\n    \"uvicorn~=0.27.0\",\n    \"pydantic~=2.6.0\"\n]\ndev = [\n    \"pytest~=7.0\",\n    \"black~=24.0\",\n    \"flake8~=7.0\",\n    \"mypy~=1.8\",\n    \"requests~=2.31.0\"\n]\n\n[project.scripts]\nmycalc = \"mycalc.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools]\npackages = [\"mycalc\", \"mycalc.models\", \"mycalc.services\", \"mycalc.controllers\", \"mycalc.repositories\", \"mycalc.utils\", \"mycalc.integrations\"]\npackage-dir = {\"\" = \"src\"}\n\n[tool.black]\nline-length = 120\ntarget-version = ['py38']\n\n[tool.flake8]\nmax-line-length = 120\nexclude = [\".git\", \"__pycache__\", \"venv\", \".venv\", \"build\", \"dist\"]\n\n[tool.mypy]\npython_version = \"3.8\"\nstrict = true\nignore_missing_imports = true\n```\n\n```markdown\n# README.md\n# MyCalc Library\n\nMyCalc is a small, well-tested Python library that provides integer addition functionality through various interfaces: a direct library function, a service, a CLI, and an HTTP JSON API. It supports optional operation history logging to SQLite.\n\n## Features\n\n- **Library Function**: `mycalc.add(x, y)` for direct use.\n- **Calculator Service**: `mycalc.CalculatorService` for programmatic integration.\n- **CLI Tool**: `mycalc add <a> <b>` for interactive use.\n- **HTTP JSON API**: `POST /add` endpoint via FastAPI for remote calls.\n- **Optional Persistence**: Log operations to a SQLite database.\n- **Packaging**: Ready for CI/CD with `pyproject.toml`.\n\n## Installation\n\nYou can install MyCalc using pip:\n\n```bash\npip install mycalc\n```\n\nFor API functionality, install with the `api` extra:\n\n```bash\npip install \"mycalc[api]\"\n```\n\nFor development, install with the `dev` extra:\n\n```bash\npip install \"mycalc[dev]\"\n```\n\n## Usage\n\n### Library Function\n\n```python\nfrom mycalc import add\n\nresult = add(10, 20)\nprint(result) # Output: 30\n```\n\nThe `add` function includes doctests for quick verification.\n\n### Calculator Service\n\n```python\nfrom mycalc import CalculatorService, Validator, NumberPair, OperationRepository\nfrom mycalc.config import DB_PATH, PERSISTENCE_ENABLED\n\nvalidator = Validator()\nrepo = OperationRepository(db_path=DB_PATH) if PERSISTENCE_ENABLED else None\nservice = CalculatorService(validator=validator, repo=repo)\n\npair = NumberPair(a=100, b=200)\nresult = service.add_numbers(pair)\nprint(result) # Output: 300\n\n# Optionally list records if persistence is enabled\nif repo:\n    records = repo.list_records(limit=5)\n    for record in records:\n        print(f\"Operation: {record.a} + {record.b} = {record.result} at {record.created_at}\")\n```\n\n### Command Line Interface (CLI)\n\n```bash\n# Add two numbers\nmycalc add 5 8\n# Output: 13\n\n# With debug mode for errors\nmycalc add 5 invalid --debug\n# Output:\n# Error: Invalid input: Expected integer, got 'invalid' of type str\n# (and stack trace if --debug is active)\n```\n\n### HTTP JSON API\n\nFirst, ensure you have installed MyCalc with the `api` extra: `pip install \"mycalc[api]\"`.\n\nTo run the API server (requires `uvicorn`):\n\n```bash\nuvicorn mycalc.controllers.api_controller:APIController.app --host 127.0.0.1 --port 8000\n```\n(Note: the APIController.app is an instance, so it should be `mycalc.controllers.api_controller:app` or similar, depending on how it's exposed. The `APIController.get_app()` method provides the instance. For `uvicorn`, typically a top-level `app` object is expected. In `src/mycalc/cli.py` or a dedicated `api_main.py` we can expose it.)\n\nExample `api_main.py` to expose the app:\n```python\n# api_main.py\nimport logging\nfrom mycalc.controllers.api_controller import APIController\nfrom mycalc.services.calculator_service import CalculatorService\nfrom mycalc.utils.validators import Validator\nfrom mycalc.repositories.operation_repository import OperationRepository\nfrom mycalc.config import DB_PATH, PERSISTENCE_ENABLED, API_HOST, API_PORT\n\nlogging.basicConfig(level=logging.INFO)\n\nvalidator = Validator()\nrepo = None\nif PERSISTENCE_ENABLED:\n    try:\n        repo = OperationRepository(db_path=DB_PATH)\n        repo.create_tables()\n        logging.info(f\"API persistence enabled to {DB_PATH}\")\n    except Exception as e:\n        logging.error(f\"Failed to initialize API operation repository. Persistence disabled. Error: {e}\")\n        repo = None\n\nservice = CalculatorService(validator=validator, repo=repo)\napi_controller = APIController(service=service)\napp = api_controller.get_app() # The FastAPI app instance\n\nif __name__ == \"__main__\":\n    import uvicorn\n    uvicorn.run(app, host=API_HOST, port=API_PORT)\n```\nThen run with:\n```bash\npython api_main.py\n```\n\nThen you can make requests using `curl` or `requests`:\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": 15, \"b\": 25}' http://127.0.0.1:8000/add\n# Output: {\"result\": 40}\n\n# With an API key (if MYCALC_API_KEY env var is set on the server)\n# export MYCALC_API_KEY=\"mysecretkey\" # on server\n# curl -X POST -H \"Content-Type: application/json\" -H \"X-API-KEY: mysecretkey\" -d '{\"a\": 15, \"b\": 25}' http://127.0.0.1:8000/add\n\n# Health check\ncurl http://127.0.0.1:8000/health\n# Output: {\"status\": \"ok\"}\n```\n\n## Configuration\n\nMyCalc uses environment variables for configuration:\n\n- `MYCALC_PERSISTENCE_ENABLED`: Set to `true` to enable operation logging to SQLite (default: `false`).\n- `MYCALC_DB_PATH`: Path to the SQLite database file (default: `operations.db`).\n- `MYCALC_API_ENABLED`: (Not directly used by the library, but by external runner scripts like `api_main.py` if designed to be toggled)\n- `MYCALC_API_HOST`: Host for the API server (default: `127.0.0.1`).\n- `MYCALC_API_PORT`: Port for the API server (default: `8000`).\n- `MYCALC_API_KEY`: If set, API requires `X-API-KEY` header for authentication.\n\n## Development\n\n1. **Clone the repository:**\n   ```bash\n   git clone https://github.com/your-org/mycalc.git\n   cd mycalc\n   ```\n2. **Create and activate a virtual environment:**\n   ```bash\n   python -m venv .venv\n   source .venv/bin/activate\n   ```\n3. **Install development dependencies:**\n   ```bash\n   pip install -e \".[dev,api]\"\n   ```\n4. **Run tests:**\n   ```bash\n   pytest\n   ```\n5. **Run linting and formatting checks:**\n   ```bash\n   black --check src/\n   flake8 src/\n   mypy src/\n   ```\n6. **Apply formatting:**\n   ```bash\n   black src/\n   ```\n\n## CI/CD\n\nThe project includes a GitHub Actions workflow (`.github/workflows/ci.yml`) to automatically run tests, linting, and type checking on every push and pull request.\n\n## License\n\nThis project is licensed under the MIT License.\n```\n\n```yaml\n# .github/workflows/ci.yml\nname: CI/CD Pipeline\n\non:\n  push:\n    branches:\n      - main\n  pull_request:\n    branches:\n      - main\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n    - uses: actions/checkout@v4\n\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v5\n      with:\n        python-version: ${{ matrix.python-version }}\n        cache: 'pip' # Cache pip dependencies\n\n    - name: Install dependencies\n      run: |\n        python -m pip install --upgrade pip\n        pip install -e \".[dev,api]\"\n\n    - name: Run Black formatter check\n      run: |\n        black --check src/\n\n    - name: Run Flake8 linter\n      run: |\n        flake8 src/\n\n    - name: Run MyPy type checker\n      run: |\n        mypy src/\n\n    - name: Run Pytest with coverage\n      run: |\n        pytest --cov=src/mycalc --cov-report=xml\n      env:\n        # Enable persistence during tests to ensure repository logic is tested\n        MYCALC_PERSISTENCE_ENABLED: \"true\"\n        MYCALC_DB_PATH: \":memory:\" # Use in-memory DB for tests\n\n    - name: Upload coverage reports to Codecov\n      uses: codecov/codecov-action@v4\n      with:\n        token: ${{ secrets.CODECOV_TOKEN }}\n        slug: your-org/mycalc # Replace with your GitHub username/organization and repository name\n```"}
{"task_id": "HumanEval/54", "solution": "```python\nimport unicodedata\nimport sys\nimport os\nimport argparse\nfrom typing import Any, List, Set\nfrom fastapi import FastAPI, HTTPException, Request, status\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel, ValidationError\n\n# --- src/samechars/errors.py ---\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input types or formats.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass InputTooLargeError(InvalidInputError):\n    \"\"\"Exception raised when an input string exceeds the allowed size.\"\"\"\n    def __init__(self, size: int, max_size: int) -> None:\n        self.size = size\n        self.max_size = max_size\n        super().__init__(f\"Input too large: {size} bytes > {max_size} bytes\")\n\n# --- src/samechars/config.py ---\nDEFAULT_MAX_INPUT_BYTES = 10_000_000\n\nclass AppConfig:\n    \"\"\"Application configuration settings.\"\"\"\n    def __init__(self, max_input_bytes: int = DEFAULT_MAX_INPUT_BYTES, debug: bool = False) -> None:\n        self.max_input_bytes = max_input_bytes\n        self.debug = debug\n\n# --- src/samechars/models.py ---\nclass SameCharsRequest(BaseModel):\n    \"\"\"Data transfer object for same_chars request.\"\"\"\n    s0: str\n    s1: str\n\nclass SameCharsResponse(BaseModel):\n    \"\"\"Data transfer object for same_chars response.\"\"\"\n    same: bool\n\n# --- src/samechars/normalizer.py ---\nDEFAULT_NF = \"NFC\"\n\nclass Normalizer:\n    \"\"\"Handles Unicode normalization, optional case-folding, and input size checks.\"\"\"\n    def __init__(self, max_input_bytes: int = DEFAULT_MAX_INPUT_BYTES,\n                 nf: str = DEFAULT_NF,\n                 casefold: bool = False) -> None:\n        self.max_input_bytes = max_input_bytes\n        self.nf = nf\n        self.casefold = casefold\n\n    def validate_type(self, s: Any) -> None:\n        \"\"\"Raises InvalidInputError if input is not a string.\"\"\"\n        if not isinstance(s, str):\n            raise InvalidInputError(f\"Expected str, got {type(s).__name__}\")\n\n    def normalize(self, s: str) -> str:\n        \"\"\"Returns the normalized string, checking size and applying casefolding.\"\"\"\n        self.validate_type(s)\n        size = len(s.encode(\"utf-8\"))\n        if size > self.max_input_bytes:\n            raise InputTooLargeError(size=size, max_size=self.max_input_bytes)\n        \n        out = unicodedata.normalize(self.nf, s)\n        if self.casefold:\n            out = out.casefold()\n        return out\n\n# --- src/samechars/char_set_service.py ---\nclass CharSetService:\n    \"\"\"Core logic for comparing unique character sets of two strings.\"\"\"\n    def __init__(self, normalizer: Normalizer) -> None:\n        self._normalizer = normalizer\n\n    def same_chars(self, s0: str, s1: str) -> bool:\n        \"\"\"Returns True if unique characters of s0 and s1 are equal.\"\"\"\n        n0 = self._normalizer.normalize(s0)\n        n1 = self._normalizer.normalize(s1)\n        return self._unique_chars(n0) == self._unique_chars(n1)\n\n    def _unique_chars(self, s: str) -> Set[str]:\n        \"\"\"Computes the set of unique characters from a string.\"\"\"\n        return set(s)\n\n# --- src/samechars/controller.py ---\nclass SameCharsController:\n    \"\"\"Provides FastAPI app and endpoint wiring for the same_chars service.\"\"\"\n    def __init__(self, service: CharSetService, config: AppConfig) -> None:\n        self.service = service\n        self.config = config\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Returns a configured FastAPI application instance.\"\"\"\n        app = FastAPI(debug=self.config.debug)\n\n        @app.exception_handler(InvalidInputError)\n        async def invalid_input_exception_handler(request: Request, exc: InvalidInputError):\n            return JSONResponse(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                content={\"detail\": exc.message},\n            )\n\n        @app.exception_handler(InputTooLargeError)\n        async def input_too_large_exception_handler(request: Request, exc: InputTooLargeError):\n            return JSONResponse(\n                status_code=status.HTTP_413_PAYLOAD_TOO_LARGE,\n                content={\"detail\": f\"Input too large: {exc.size} bytes > {exc.max_size} bytes\"},\n            )\n        \n        @app.exception_handler(ValidationError)\n        async def validation_error_handler(request: Request, exc: ValidationError):\n            return JSONResponse(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                content={\"detail\": exc.errors()},\n            )\n\n        # Register _post_same_chars as the route handler.\n        # This approach uses an adapter function to align FastAPI's Pydantic model\n        # input with the _post_same_chars method's dict payload.\n        @app.post(\"/same-chars\", response_model=SameCharsResponse)\n        async def post_same_chars_route(request_data: SameCharsRequest):\n            try:\n                # Call the internal controller method with a dictionary payload\n                result_dict = self._post_same_chars(request_data.model_dump())\n                return SameCharsResponse(**result_dict)\n            except Exception as e:\n                # This should ideally be logged for unexpected errors\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail=\"An unexpected server error occurred.\"\n                )\n        return app\n\n    def _post_same_chars(self, payload: dict) -> dict:\n        \"\"\"\n        Internal handler for the /same-chars endpoint, expects a dictionary payload.\n        Handles service call and re-raises specific exceptions for FastAPI handlers.\n        \"\"\"\n        s0 = payload.get(\"s0\")\n        s1 = payload.get(\"s1\")\n\n        # Basic type check before passing to service, though Pydantic covers much.\n        # This ensures InvalidInputError is raised if payload is malformed in a way\n        # Pydantic didn't strictly validate (e.g., if we bypassed Pydantic at some point).\n        if not isinstance(s0, str) or not isinstance(s1, str):\n            raise InvalidInputError(\"s0 and s1 must be strings.\")\n\n        same = self.service.same_chars(s0, s1)\n        return {\"same\": same}\n\n\n# --- src/samechars/cli.py ---\nclass CLI:\n    \"\"\"CLI entrypoint to call CharSetService and print results.\"\"\"\n    def __init__(self, service: CharSetService) -> None:\n        self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Runs the CLI with the given arguments, prints result, and returns exit code.\n        Expects two positional string arguments.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"same-chars\",\n            description=\"Check if two strings contain the same set of unique characters.\"\n        )\n        parser.add_argument(\"s0\", help=\"The first string to compare.\")\n        parser.add_argument(\"s1\", help=\"The second string to compare.\")\n\n        try:\n            args = parser.parse_args(argv)\n        except SystemExit as e:\n            # Argparse prints help/error messages automatically.\n            # We just need to capture the exit code.\n            return e.code\n\n        try:\n            result = self._service.same_chars(args.s0, args.s1)\n            print(str(result))\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except InputTooLargeError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n# --- src/samechars/__init__.py ---\n__version__ = \"0.1.0\"\n\n_normalizer_default = Normalizer()\n_service_default = CharSetService(normalizer=_normalizer_default)\n\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two strings contain the same set of characters using default settings.\n    This function uses default normalization (NFC, case-sensitive).\n    \"\"\"\n    return _service_default.same_chars(s0, s1)\n\n# --- src/samechars/__main__.py ---\ndef main():\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    config = AppConfig() # Use default config\n    normalizer = Normalizer(max_input_bytes=config.max_input_bytes)\n    service = CharSetService(normalizer=normalizer)\n    cli = CLI(service=service)\n    sys.exit(cli.run(sys.argv[1:]))\n\nif __name__ == \"__main__\":\n    main()\n\n# --- pyproject.toml ---\n# [tool.poetry]\n# name = \"samechars\"\n# version = \"0.1.0\"\n# description = \"A library and service to determine if two strings contain the same set of characters.\"\n# authors = [\"Your Name <you@example.com>\"]\n# license = \"MIT\"\n# readme = \"README.md\"\n# packages = [{include = \"samechars\", from=\"src\"}]\n\n# [tool.poetry.dependencies]\n# python = \">=3.10\"\n# fastapi = \"^0.111.0\"\n# uvicorn = {extras = [\"standard\"], version = \"^0.30.1\"}\n# pydantic = \"^2.0\"\n\n# [tool.poetry.group.dev.dependencies]\n# pytest = \"^8.0\"\n# httpx = \"^0.27.0\"\n\n# [tool.poetry.scripts]\n# same-chars = \"samechars.__main__:main\"\n\n# [build-system]\n# requires = [\"poetry-core\"]\n# build-backend = \"poetry.core.masonry.api\"\n\n# --- requirements.txt ---\n# fastapi>=0.111.0,<0.112.0\n# uvicorn[standard]>=0.30.1,<0.31.0\n# pydantic>=2.0,<3.0\n\n# --- README.md ---\n# # SameChars\n#\n# A Python library and microservice to determine if two strings contain the same set of unique characters, ignoring counts and order.\n#\n# ## Features\n# -   Core `same_chars` function for library use.\n# -   Command-Line Interface (CLI) for quick checks.\n# -   HTTP REST API for integration with other services.\n# -   Unicode NFC normalization by default.\n# -   Configurable input size limits.\n#\n# ## Installation\n#\n# You can install the package using pip:\n#\n# ```bash\n# pip install samechars\n# ```\n#\n# If you are developing, clone the repository and install with poetry:\n#\n# ```bash\n# git clone https://github.com/yourusername/samechars.git\n# cd samechars\n# poetry install\n# ```\n#\n# ## Usage\n#\n# ### As a Library\n#\n# ```python\n# from samechars import same_chars\n#\n# print(same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')) # Output: True\n# print(same_chars('abcd', 'dddddddabce'))           # Output: False\n# ```\n#\n# ### Command-Line Interface (CLI)\n#\n# ```bash\n# same-chars \"eabcdzzzz\" \"dddzzzzzzzddeddabc\"\n# # Output: True\n#\n# same-chars \"eabcd\" \"dddddddabc\"\n# # Output: False\n#\n# same-chars 123 \"abc\"\n# # Output: Error: Expected str, got int (exit code 2)\n# ```\n#\n# ### HTTP API Service\n#\n# 1.  **Run the service:**\n#     ```bash\n#     uvicorn samechars.controller:app --host 0.0.0.0 --port 8000\n#     ```\n#     (Note: `app` is globally exposed by `create_app` in `__main__.py` or typically by a separate entrypoint for uvicorn. To align with uvicorn's `module:app` pattern, you'd typically have `app = SameCharsController(...).create_app()` in `__init__.py` or a dedicated `api.py`.)\n#\n#     For this specific design, to run the service you'd need a small wrapper file, e.g., `run_api.py`:\n#     ```python\n#     # run_api.py\n#     from samechars.config import AppConfig\n#     from samechars.normalizer import Normalizer\n#     from samechars.char_set_service import CharSetService\n#     from samechars.controller import SameCharsController\n#\n#     config = AppConfig()\n#     normalizer = Normalizer(max_input_bytes=config.max_input_bytes)\n#     service = CharSetService(normalizer=normalizer)\n#     controller = SameCharsController(service=service, config=config)\n#     app = controller.create_app() # This 'app' variable is what uvicorn expects\n#     ```\n#     Then run: `uvicorn run_api:app --host 0.0.0.0 --port 8000`\n#\n# 2.  **Make a request:**\n#     ```bash\n#     curl -X POST http://127.0.0.1:8000/same-chars \\\n#          -H \"Content-Type: application/json\" \\\n#          -d '{\"s0\": \"eabcdzzzz\", \"s1\": \"dddzzzzzzzddeddabc\"}'\n#     # Output: {\"same\":true}\n#\n#     curl -X POST http://127.0.0.1:8000/same-chars \\\n#          -H \"Content-Type: application/json\" \\\n#          -d '{\"s0\": \"abcd\", \"s1\": \"dddddddabce\"}'\n#     # Output: {\"same\":false}\n#\n#     curl -X POST http://127.0.0.1:8000/same-chars \\\n#          -H \"Content-Type: application/json\" \\\n#          -d '{\"s0\": \"e\\u0301\", \"s1\": \"\\u00e9\"}'\n#     # Output: {\"same\":true}\n#\n#     curl -X POST http://127.0.0.1:8000/same-chars \\\n#          -H \"Content-Type: application/json\" \\\n#          -d '{\"s0\": \"abc\"}' # Missing s1\n#     # Output: {\"detail\":[{\"type\":\"missing\",\"loc\":[\"body\",\"s1\"],\"msg\":\"Field required\",\"input\":{\"s0\":\"abc\"},\"url\":\"https://errors.pydantic.dev/2.5/v/missing\"}]} (HTTP 400)\n#     ```\n#\n# ## Development and Testing\n#\n# To run tests:\n#\n# ```bash\n# poetry run pytest\n# ```\n# or\n# ```bash\n# python -m pytest\n# ```\n#\n# ## Project Structure\n#\n# ```\n# .\n# \u251c\u2500\u2500 src/\n# \u2502   \u2514\u2500\u2500 samechars/\n# \u2502       \u251c\u2500\u2500 __init__.py\n# \u2502       \u251c\u2500\u2500 char_set_service.py\n# \u2502       \u251c\u2500\u2500 normalizer.py\n# \u2502       \u251c\u2500\u2500 controller.py\n# \u2502       \u251c\u2500\u2500 cli.py\n# \u2502       \u251c\u2500\u2500 models.py\n# \u2502       \u251c\u2500\u2500 config.py\n# \u2502       \u251c\u2500\u2500 errors.py\n# \u2502       \u2514\u2500\u2500 __main__.py\n# \u251c\u2500\u2500 tests/\n# \u2502   \u251c\u2500\u2500 test_char_set_service.py\n# \u2502   \u251c\u2500\u2500 test_controller.py\n# \u2502   \u2514\u2500\u2500 test_cli.py\n# \u251c\u2500\u2500 pyproject.toml\n# \u251c\u2500\u2500 requirements.txt\n# \u2514\u2500\u2500 README.md\n# ```\n\n# --- tests/test_char_set_service.py ---\nimport pytest\n\nclass TestCharSetService:\n    @pytest.fixture\n    def normalizer(self):\n        \"\"\"Fixture for a default Normalizer instance.\"\"\"\n        return Normalizer()\n\n    @pytest.fixture\n    def service(self, normalizer):\n        \"\"\"Fixture for a CharSetService instance.\"\"\"\n        return CharSetService(normalizer=normalizer)\n\n    def test_same_chars_examples(self, service):\n        \"\"\"Tests core logic with examples from the specification.\"\"\"\n        assert service.same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc') is True\n        assert service.same_chars('abcd', 'dddddddabc') is True\n        assert service.same_chars('dddddddabc', 'abcd') is True\n        assert service.same_chars('eabcd', 'dddddddabc') is False\n        assert service.same_chars('abcd', 'dddddddabce') is False\n        assert service.same_chars('eabcdzzzz', 'dddzzzzzzzddddabc') is False\n\n    def test_unicode_normalization(self, service):\n        \"\"\"Tests if Unicode NFC normalization works correctly.\"\"\"\n        # e + combining acute accent vs. precomposed \u00e9\n        assert service.same_chars('cafe\\u0301', 'caf\\u00e9') is True\n        assert service.same_chars('e\\u0301', '\\u00e9') is True # FR4 example\n        \n        # Test with NFD (should fail if normalizer uses NFC)\n        normalizer_nfd = Normalizer(nf=\"NFD\")\n        service_nfd = CharSetService(normalizer=normalizer_nfd)\n        assert service_nfd.same_chars('cafe\\u0301', 'caf\\u00e9') is True # Still True because unique chars are the same after NFD on both\n\n        # Test characters that normalize differently when combined\n        # Example from Unicode.org: \"\u0152\" (U+0152) and \"OE\" (U+004F U+0045)\n        # NFC: \u0152 -> \u0152 ; OE -> OE\n        # NFD: \u0152 -> O E ; OE -> OE\n        normalizer_nfc = Normalizer(nf=\"NFC\")\n        service_nfc = CharSetService(normalizer=normalizer_nfc)\n        assert service_nfc.same_chars(\"\u0152\", \"OE\") is False # Different unique sets\n        \n        normalizer_nfd = Normalizer(nf=\"NFD\")\n        service_nfd = CharSetService(normalizer=normalizer_nfd)\n        # After NFD, \"\u0152\" becomes \"O\" + \"E\" (two chars), \"OE\" is \"O\" + \"E\" (two chars).\n        # So, the set of chars {O, E} would be the same.\n        assert service_nfd.same_chars(\"\u0152\", \"OE\") is True\n\n\n    def test_empty_strings(self, service):\n        \"\"\"Tests behavior with empty strings.\"\"\"\n        assert service.same_chars('', '') is True\n        assert service.same_chars('', ' ') is False\n        assert service.same_chars(' ', '') is False\n        assert service.same_chars('abc', '') is False\n\n    def test_non_string_input(self, service):\n        \"\"\"Ensures InvalidInputError is raised for non-string inputs.\"\"\"\n        with pytest.raises(InvalidInputError, match=\"Expected str, got int\"):\n            service.same_chars(123, 'abc')\n        with pytest.raises(InvalidInputError, match=\"Expected str, got list\"):\n            service.same_chars('abc', ['d'])\n        with pytest.raises(InvalidInputError, match=\"Expected str, got NoneType\"):\n            service.same_chars('abc', None)\n\n    def test_large_input_rejected(self):\n        \"\"\"Tests if inputs exceeding max_input_bytes are rejected.\"\"\"\n        small_max_normalizer = Normalizer(max_input_bytes=10) # 10 bytes max\n        small_max_service = CharSetService(normalizer=small_max_normalizer)\n        \n        # A 5-char string, e.g., \"hello\", is 5 bytes.\n        # A 20-char string is 20 bytes (UTF-8).\n        # \"a\" is 1 byte, \"\u4f60\u597d\" is 6 bytes.\n        \n        with pytest.raises(InputTooLargeError, match=\"Input too large: 11 bytes > 10 bytes\"):\n            small_max_service.same_chars(\"abcdefghijk\", \"l\")\n        \n        with pytest.raises(InputTooLargeError, match=\"Input too large: 11 bytes > 10 bytes\"):\n            small_max_service.same_chars(\"a\", \"abcdefghijk\")\n        \n        assert small_max_service.same_chars(\"abc\", \"cba\") is True # 3 bytes each, allowed\n\n    def test_casefolding_option(self):\n        \"\"\"Tests the optional casefolding behavior of the Normalizer.\"\"\"\n        normalizer_casefold = Normalizer(casefold=True)\n        service_casefold = CharSetService(normalizer=normalizer_casefold)\n\n        normalizer_no_casefold = Normalizer(casefold=False)\n        service_no_casefold = CharSetService(normalizer=normalizer_no_casefold)\n\n        # Case-sensitive\n        assert service_no_casefold.same_chars(\"abc\", \"Abc\") is False\n        assert service_no_casefold.same_chars(\"ABC\", \"abc\") is False\n\n        # Case-insensitive (casefolded)\n        assert service_casefold.same_chars(\"abc\", \"Abc\") is True\n        assert service_casefold.same_chars(\"ABC\", \"abc\") is True\n        assert service_casefold.same_chars(\"Stra\u00dfe\", \"strasse\") is True # Special casefolding\n\n# --- tests/test_controller.py ---\nfrom httpx import AsyncClient\n\n@pytest.fixture(scope=\"module\")\ndef app_instance():\n    \"\"\"Fixture to create a FastAPI app instance for testing.\"\"\"\n    config = AppConfig(max_input_bytes=10_000_000)\n    normalizer = Normalizer(max_input_bytes=config.max_input_bytes)\n    service = CharSetService(normalizer=normalizer)\n    controller = SameCharsController(service=service, config=config)\n    return controller.create_app()\n\n@pytest.fixture(scope=\"module\")\nasync def client(app_instance):\n    \"\"\"Fixture for an HTTPX TestClient.\"\"\"\n    async with AsyncClient(app=app_instance, base_url=\"http://test\") as ac:\n        yield ac\n\nclass TestSameCharsController:\n    async def test_post_same_chars_success(self, client):\n        \"\"\"Tests successful API call.\"\"\"\n        response = await client.post(\n            \"/same-chars\",\n            json={\"s0\": \"eabcdzzzz\", \"s1\": \"dddzzzzzzzddeddabc\"}\n        )\n        assert response.status_code == 200\n        assert response.json() == {\"same\": True}\n\n        response = await client.post(\n            \"/same-chars\",\n            json={\"s0\": \"abcd\", \"s1\": \"dddddddabce\"}\n        )\n        assert response.status_code == 200\n        assert response.json() == {\"same\": False}\n\n        response = await client.post(\n            \"/same-chars\",\n            json={\"s0\": \"e\\u0301\", \"s1\": \"\\u00e9\"}\n        )\n        assert response.status_code == 200\n        assert response.json() == {\"same\": True}\n\n    async def test_post_same_chars_invalid_input(self, client):\n        \"\"\"Tests API call with invalid input types or missing fields.\"\"\"\n        # s0 is not a string\n        response = await client.post(\n            \"/same-chars\",\n            json={\"s0\": 123, \"s1\": \"abc\"}\n        )\n        assert response.status_code == 400\n        assert \"detail\" in response.json()\n        assert \"string\" in str(response.json()[\"detail\"]) # Pydantic validation error\n\n        # s1 is missing\n        response = await client.post(\n            \"/same-chars\",\n            json={\"s0\": \"abc\"}\n        )\n        assert response.status_code == 400\n        assert \"detail\" in response.json()\n        assert \"missing\" in str(response.json()[\"detail\"]) # Pydantic validation error\n\n        # both missing\n        response = await client.post(\n            \"/same-chars\",\n            json={}\n        )\n        assert response.status_code == 400\n        assert \"detail\" in response.json()\n        assert \"missing\" in str(response.json()[\"detail\"])\n\n    async def test_post_same_chars_input_too_large(self, app_instance):\n        \"\"\"Tests API call with inputs exceeding the size limit.\"\"\"\n        # C