tr]:\n        \"\"\"\n        Generator variant for streaming large inputs efficiently.\n        Yields strings that start with the given prefix.\n        \"\"\"\n        for s in strings:\n            if s.startswith(prefix):\n                yield s\n```\n\n```python\n# src/stringutils/service.py\nfrom typing import list, Optional\nfrom .filter_impl import PrefixFilter\nfrom .validator import InputValidator\nfrom .exceptions import InvalidInputError\n\nclass FilterService:\n    \"\"\"\n    Application service orchestrating input validation and prefix filtering.\n    Acts as an injection point for different filter implementations and validators.\n    \"\"\"\n    def __init__(self, filter_impl: Optional[PrefixFilter] = None, validator: Optional[InputValidator] = None) -> None:\n        \"\"\"\n        Initializes the FilterService with optional PrefixFilter and InputValidator instances.\n        Defaults to creating new instances if none are provided.\n        \"\"\"\n        self._filter_impl = filter_impl or PrefixFilter()\n        self._validator = validator or InputValidator()\n\n    def filter(self, strings: list[str], prefix: str) -> list[str]:\n        \"\"\"\n        Validates inputs and then applies prefix filtering using the injected implementation.\n        Raises InvalidInputError if inputs are not valid according to the validator.\n        \"\"\"\n        self._validator.validate_strings(strings)\n        self._validator.validate_prefix(prefix)\n        return self._filter_impl.filter(strings, prefix)\n```\n\n```python\n# src/stringutils/validator.py\nfrom typing import Any, list\nfrom .exceptions import InvalidInputError\n\nMAX_STRING_LENGTH = 10_000_000 # Defensive cap to prevent excessively long strings\n\nclass InputValidator:\n    \"\"\"\n    Provides methods to validate various inputs, ensuring type correctness and adherence to business rules.\n    Raises InvalidInputError for any validation failures.\n    \"\"\"\n    def __init__(self, max_length: int = MAX_STRING_LENGTH) -> None:\n        \"\"\"Initializes the validator with a maximum allowed string length.\"\"\"\n        self._max_length = max_length\n\n    def validate_strings(self, strings: list[Any]) -> None:\n        \"\"\"\n        Ensures the 'strings' input is a list and all its elements are strings.\n        Also checks if any string exceeds the maximum allowed length.\n        \"\"\"\n        if not isinstance(strings, list):\n            raise InvalidInputError(\"Input 'strings' must be a list of str.\")\n        for i, s in enumerate(strings):\n            if not isinstance(s, str):\n                raise InvalidInputError(f\"Element at index {i} in 'strings' is not a str.\")\n            if len(s) > self._max_length:\n                raise InvalidInputError(f\"Element at index {i} exceeds max length of {self._max_length}.\")\n\n    def validate_prefix(self, prefix: Any) -> None:\n        \"\"\"\n        Ensures the 'prefix' input is a string.\n        An empty string prefix is considered valid.\n        \"\"\"\n        if not isinstance(prefix, str):\n            raise InvalidInputError(\"Input 'prefix' must be a str.\")\n```\n\n```python\n# src/stringutils/exceptions.py\nclass InvalidInputError(ValueError):\n    \"\"\"\n    Custom exception raised for invalid input parameters.\n    Inherits from ValueError to be easily catchable for input-related issues.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        \"\"\"Initializes the exception with a specific error message.\"\"\"\n        super().__init__(message)\n        self.message = message\n```\n\n```python\n# src/stringutils/controllers.py\nfrom typing import Iterable, Iterator\nfrom .service import FilterService\n\nclass CLIController:\n    \"\"\"\n    Orchestrates CLI interactions by parsing inputs, invoking the FilterService,\n    and preparing results for output. It handles basic I/O streaming for CLI.\n    \"\"\"\n    def __init__(self, service: Optional[FilterService] = None) -> None:\n        \"\"\"\n        Initializes the CLIController with an optional FilterService instance.\n        Defaults to creating a new FilterService if none is provided.\n        \"\"\"\n        self._service = service or FilterService()\n\n    def run(self, prefix: str, input_lines: Iterable[str]) -> Iterator[str]:\n        \"\"\"\n        Processes a stream of input lines, filters them by prefix, and yields matching lines.\n        Input lines are stripped of trailing newlines before processing.\n        \"\"\"\n        # Read all lines into a list for service.filter, which expects list[str]\n        # stripping newline characters from each line.\n        lines = [line.rstrip(\"\\n\") for line in input_lines]\n        # FilterService.filter returns list, so iterate over it\n        for match in self._service.filter(lines, prefix):\n            yield match\n\n    def run_from_file(self, prefix: str, file_path: str, encoding: str = \"utf-8\") -> Iterator[str]:\n        \"\"\"\n        Reads lines from a specified file, filters them by prefix, and yields matching lines.\n        Handles file opening and closing, streaming content from the file.\n        \"\"\"\n        with open(file_path, \"r\", encoding=encoding) as f:\n            yield from self.run(prefix, f)\n```\n\n```python\n# src/stringutils/cli.py\nimport argparse\nimport sys\nfrom typing import Optional, list\n\nfrom .controllers import CLIController\nfrom .exceptions import InvalidInputError\n\ndef main(argv: Optional[list[str]] = None) -> int:\n    \"\"\"\n    Main entry-point for the command-line interface.\n    Parses arguments, orchestrates the CLIController, and handles error output/exit codes.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"stringutils\",\n        description=\"A utility for string manipulation.\"\n    )\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # Create the parser for the \"filter-prefix\" command\n    filter_prefix_parser = subparsers.add_parser(\n        \"filter-prefix\",\n        help=\"Filter a list of strings by a given prefix.\"\n    )\n    filter_prefix_parser.add_argument(\n        \"--prefix\",\n        required=True,\n        help=\"The prefix to filter strings by (case-sensitive).\"\n    )\n    filter_prefix_parser.add_argument(\n        \"--input-file\",\n        required=False,\n        help=\"Path to a file containing newline-separated strings. If not provided, reads from stdin.\"\n    )\n\n    args = parser.parse_args(argv)\n\n    if args.command != \"filter-prefix\":\n        parser.print_help(sys.stderr)\n        return 1\n\n    controller = CLIController()\n\n    try:\n        if args.input_file:\n            # Run from file\n            output_iterator = controller.run_from_file(args.prefix, args.input_file)\n        else:\n            # Run from stdin\n            output_iterator = controller.run(args.prefix, sys.stdin)\n\n        for line in output_iterator:\n            sys.stdout.write(line + \"\\n\")\n        return 0 # Success\n    except InvalidInputError as e:\n        sys.stderr.write(f\"Error: Invalid input: {e.message}\\n\")\n        return 2 # Invalid input error\n    except FileNotFoundError as e:\n        sys.stderr.write(f\"Error: File not found: {e}\\n\")\n        return 3 # File I/O error\n    except IOError as e:\n        sys.stderr.write(f\"Error: File I/O issue: {e}\\n\")\n        return 3 # File I/O error\n    except Exception as e:\n        sys.stderr.write(f\"Error: An unexpected error occurred: {e}\\n\")\n        return 1 # Generic error\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```toml\n# pyproject.toml\n[project]\nname = \"stringutils\"\nversion = \"0.1.0\"\ndescription = \"A Python utility to filter lists of strings by a given prefix.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nkeywords = [\"string\", \"filter\", \"prefix\", \"utility\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Topic :: Utilities\",\n]\n\n[project.dependencies]\n# No runtime dependencies beyond standard library\n\n[project.optional-dependencies]\ntest = [\"pytest\"]\n\n[project.scripts]\nstringutils = \"stringutils.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\n```\n\n```markdown\n# stringutils\n\nA Python utility to filter lists of strings by a given prefix. This project provides both a reusable library function and a command-line interface (CLI) tool.\n\n## Features\n\n- **Library Function**: A simple `filter_by_prefix(strings, prefix)` function for use in other Python projects.\n- **CLI Tool**: `stringutils filter-prefix` to process strings from stdin or a file and output matches to stdout.\n- **Robust Input Validation**: Ensures correct data types and raises clear errors on invalid input.\n- **Modular Design**: Follows best practices for maintainability and extensibility, using dependency injection.\n- **Testable**: Designed for easy unit and integration testing.\n\n## Installation\n\nYou can install `stringutils` using `pip`:\n\n```bash\npip install stringutils\n```\n\nIf you prefer to install from source for development:\n\n```bash\ngit clone https://github.com/yourusername/stringutils.git # Replace with actual repo\ncd stringutils\npip install -e .\n```\n\n## Usage\n\n### Library Usage\n\nThe core filtering logic is exposed via a simple function:\n\n```python\nfrom stringutils import filter_by_prefix, InvalidInputError\n\n# Basic usage\nstrings = ['apple', 'banana', 'apricot', 'cherry']\nprefix = 'ap'\nresult = filter_by_prefix(strings, prefix)\nprint(f\"Filtered for '{prefix}': {result}\")\n# Output: Filtered for 'ap': ['apple', 'apricot']\n\n# Empty prefix matches all\nresult_all = filter_by_prefix(strings, '')\nprint(f\"Empty prefix: {result_all}\")\n# Output: Empty prefix: ['apple', 'banana', 'apricot', 'cherry']\n\n# Case-sensitive matching\nresult_case = filter_by_prefix(strings, 'A')\nprint(f\"Case-sensitive 'A': {result_case}\")\n# Output: Case-sensitive 'A': []\n\n# Error handling for invalid input\ntry:\n    filter_by_prefix(['hello', 123, 'world'], 'h')\nexcept InvalidInputError as e:\n    print(f\"Caught expected error: {e}\")\n    # Output: Caught expected error: Element at index 1 in 'strings' is not a str.\n```\n\nYou can also use the `FilterService` class directly for more control or dependency injection scenarios:\n\n```python\nfrom stringutils.service import FilterService\n\nservice = FilterService()\nstrings = ['test', 'taste', 'trust']\nprefix = 'tast'\nresult = service.filter(strings, prefix)\nprint(f\"Service filter: {result}\")\n# Output: Service filter: ['taste']\n```\n\n### CLI Usage\n\nThe `stringutils` command provides a `filter-prefix` subcommand:\n\n```bash\nstringutils filter-prefix --help\n```\n\n#### Filtering from `stdin`\n\nPipe a list of strings to `stringutils filter-prefix`:\n\n```bash\necho -e \"apple\\nbanana\\napricot\\ncherry\" | stringutils filter-prefix --prefix ap\n```\nOutput:\n```\napple\napricot\n```\n\n#### Filtering from a file\n\nCreate a file named `fruits.txt`:\n```\napple\nbanana\napricot\ncherry\ndate\n```\n\nThen run the command:\n\n```bash\nstringutils filter-prefix --prefix da --input-file fruits.txt\n```\nOutput:\n```\ndate\n```\n\n#### Error Handling in CLI\n\nInvalid inputs or file errors will result in an error message to `stderr` and a non-zero exit code:\n\n```bash\n# Example: Non-string input (conceptually, if reading from file or a bad pipe)\necho -e \"abc\\n123\\ndef\" | stringutils filter-prefix --prefix a\n```\nOutput (to stderr):\n```\nError: Invalid input: Element at index 1 in 'strings' is not a str.\n```\nExit code will be `2`.\n\n```bash\nstringutils filter-prefix --prefix a --input-file non_existent_file.txt\n```\nOutput (to stderr):\n```\nError: File not found: [Errno 2] No such file or directory: 'non_existent_file.txt'\n```\nExit code will be `3`.\n\n## Development\n\n### Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 stringutils/\n\u2502       \u251c\u2500\u2500 __init__.py         # Package exports, top-level function\n\u2502       \u251c\u2500\u2500 filter_impl.py      # Core PrefixFilter logic (stateless)\n\u2502       \u251c\u2500\u2500 service.py          # Application service layer (orchestrates validation and filtering)\n\u2502       \u251c\u2500\u2500 validator.py        # Input validation logic\n\u2502       \u251c\u2500\u2500 exceptions.py       # Custom exception types\n\u2502       \u251c\u2500\u2500 controllers.py      # CLI specific logic, streams input/output\n\u2502       \u2514\u2500\u2500 cli.py              # Command-line entry point, arg parsing\n\u251c\u2500\u2500 pyproject.toml              # Project metadata and dependencies\n\u251c\u2500\u2500 README.md                   # This file\n\u2514\u2500\u2500 .github/\n    \u2514\u2500\u2500 workflows/\n        \u2514\u2500\u2500 ci.yml              # GitHub Actions CI workflow\n```\n\n### Running Tests (Not provided in this generation)\n\nWhile this code generation did not include the actual test files, the project is designed for unit testing using `pytest`.\n\nTo run tests (assuming `pytest` is installed as a dev dependency):\n\n```bash\npip install -e \".[test]\"\npytest\n```\n\n### CI/CD\n\nThe `.github/workflows/ci.yml` file defines a GitHub Actions workflow to run tests automatically on pushes and pull requests.\n\n```yaml\n# .github/workflows/ci.yml\nname: CI\n\non:\n  push:\n    branches:\n      - main\n 