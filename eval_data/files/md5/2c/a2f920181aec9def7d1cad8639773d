{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Computes the Collatz sequence for a positive integer n and returns its odd numbers, sorted ascending.\n    The sequence stops when 1 is reached; no validation for n > 0 is performed per critical requirements.\n    \"\"\"\n    current_value = n\n    sequence = [n]\n\n    while current_value != 1:\n        if current_value % 2 == 0:\n            current_value //= 2\n        else:\n            current_value = 3 * current_value + 1\n        sequence.append(current_value)\n\n    odd_numbers = sorted(list(set(x for x in sequence if x % 2 != 0)))\n    return odd_numbers\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    The list contains unique odd numbers from the sequence, including 1 and n if odd.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n\n    # Add the starting number if it's odd.\n    if current_n % 2 != 0:\n        odd_numbers.add(current_n)\n\n    # Generate the Collatz sequence until 1.\n    while current_n != 1:\n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n        \n        # Add current term to set if odd.\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n            \n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"This function validates a date string in mm-dd-yyyy format according to specific rules.\n    It returns True if the date is valid, otherwise False.\n    \"\"\"\n    if not date:\n        return False\n\n    date_regex = r'^\\d{2}-\\d{2}-\\d{4}$'\n    if not re.match(date_regex, date):\n        return False\n\n    try:\n        month_s, day_s, year_s = date.split('-')\n        month = int(month_s)\n        day = int(day_s)\n        year = int(year_s) # Year doesn't have specific range rules beyond 4 digits for this problem.\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if not (1 <= day):\n        return False\n\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        return day <= 31\n    elif month in {4, 6, 9, 11}:\n        return day <= 30\n    elif month == 2:\n        return day <= 29 # February allows up to 29 days, no leap year check required.\n    \n    return False"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in mm-dd-yyyy format against specific rules.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    s = str(date).strip()\n\n    if not s:\n        return False\n\n    parts = s.split('-')\n\n    if len(parts) != 3:\n        return False\n\n    # FR4: Ensure all segments are numeric\n    for part in parts:\n        if not part.isdigit():\n            return False\n\n    month, day, year = int(parts[0]), int(parts[1]), int(parts[2])\n\n    # FR2: Validate month range\n    if not (1 <= month <= 12):\n        return False\n\n    # FR3: Validate days per month\n    DAYS_31 = {1, 3, 5, 7, 8, 10, 12}\n    DAYS_30 = {4, 6, 9, 11}\n    FEBRUARY = 2\n    FEB_MAX = 29 # February max day is 29, ignoring leap year check as per spec\n\n    max_day = 0\n    if month in DAYS_31:\n        max_day = 31\n    elif month in DAYS_30:\n        max_day = 30\n    elif month == FEBRUARY:\n        max_day = FEB_MAX\n    else:\n        # This case should logically not be reached if month is already 1-12,\n        # but included for explicit coverage.\n        return False \n\n    if not (1 <= day <= max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    \"\"\"\n    Splits text based on prioritized rules: whitespace, then commas, otherwise counts specific lowercase letters.\n    The function returns a list of words or an integer count.\n    \"\"\"\n    # 1. Prioritized: Split on whitespace if any whitespace character is present.\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace:\n        # Split by any whitespace and filter out empty strings after splitting.\n        return [word for word in txt.split() if word]\n\n    # 2. Next priority: Split on commas if no whitespace was found.\n    if ',' in txt:\n        # Split by comma, strip leading/trailing whitespace from each token, and filter out empty strings.\n        return [word.strip() for word in txt.split(',') if word.strip()]\n\n    # 3. Fallback: Count lowercase letters with an odd 0-indexed alphabetical order.\n    odd_order_count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            # Calculate the 0-indexed alphabetical order (a=0, b=1, ...).\n            order = ord(char) - ord('a')\n            if order % 2 == 1:  # Check if the order is odd.\n                odd_order_count += 1\n    return odd_order_count\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Splits a string based on rules: whitespace, then commas, otherwise counts specific lowercase letters.\n    ord('a') is 0, 'b') is 1, etc.\n    '''\n    if any(char.isspace() for char in txt):\n        return txt.split()\n\n    if ',' in txt:\n        return [t.strip() for t in txt.split(',')]\n\n    count = 0\n    for char_code in map(ord, txt):\n        if ord('a') <= char_code <= ord('z'):\n            if (char_code - ord('a')) % 2 == 1:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/126", "solution": "import collections\n\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order with\n    the rule that no integer may appear more than twice. Returns True if\n    both conditions are met, False otherwise.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = collections.Counter(lst)\n    for value_count in counts.values():\n        if value_count >= 3:\n            return False\n\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Checks if a list of non-negative integers is sorted in ascending order and has no value appearing more than twice.\n    Assumes valid input types with non-negative integers.\n    '''\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals do not intersect.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a non-negative integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval boundaries.\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If the calculated start is greater than the end, there is no intersection.\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the closed intersection interval.\n    intersection_length = intersection_end - intersection_start\n\n    # Determine if the intersection length is a prime number.\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n\n```"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, otherwise \"NO\". If intervals don't intersect, returns \"NO\".\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n in (2, 3):\n            return True\n        if n % 2 == 0:\n            return False\n        # Optimized trial division up to the integer square root of n.\n        limit = int(n**0.5)\n        i = 3\n        while i <= limit:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection of the two intervals.\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    # If inter_start is greater than inter_end, the intervals do not intersect.\n    if inter_start > inter_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection.\n    length = inter_end - inter_start\n\n    # Determine if the length is a prime number.\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Computes sum of magnitudes multiplied by product of signs for an integer array.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n    \n    # Calculate product of signs and sum of magnitudes\n    # The presence of any zero makes the final sign product zero.\n    for x in arr:\n        magnitude_sum += abs(x)\n        if x == 0:\n            sign_product = 0 # Short-circuit sign product to 0\n            # We still need to sum magnitudes, so don't break early here\n        elif x < 0:\n            sign_product *= -1\n        # If x > 0, sign is 1, so sign_product remains unchanged\n\n    return sign_product * magnitude_sum\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes multiplied by the product of signs for an integer array.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    # Helper function for sign as per specification.\n    def _get_sign(n: int) -> int:\n        if n > 0:\n            return 1\n        if n < 0:\n            return -1\n        return 0\n\n    current_product_of_signs = 1\n    total_sum_of_magnitudes = 0\n    has_zero_sign = False\n\n    for x in arr:\n        s = _get_sign(x)\n        if s == 0:\n            has_zero_sign = True\n        else:\n            current_product_of_signs *= s\n        \n        total_sum_of_magnitudes += abs(x)\n    \n    final_product_of_signs = 0 if has_zero_sign else current_product_of_signs\n\n    return final_product_of_signs * total_sum_of_magnitudes\n```"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Computes the lexicographically minimum path of length k on a grid.\n    The path starts at value 1 and greedily selects the minimum value neighbor at each step.\n    \"\"\"\n    N = len(grid)\n\n    value_to_coords = {}\n    for r_idx in range(N):\n        for c_idx in range(N):\n            value_to_coords[grid[r_idx][c_idx]] = (r_idx, c_idx)\n\n    def get_neighbors_coords(row, col, N):\n        possible_moves = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n        neighbors = []\n        for dr, dc in possible_moves:\n            new_row, new_col = row + dr, col + dc\n            if 0 <= new_row < N and 0 <= new_col < N:\n                neighbors.append((new_row, new_col))\n        return neighbors\n\n    current_row, current_col = value_to_coords[1]\n    \n    path_values = [grid[current_row][current_col]]\n\n    for _ in range(1, k):\n        min_neighbor_value = float('inf')\n        next_cell_coords = None\n\n        for neighbor_r, neighbor_c in get_neighbors_coords(current_row, current_col, N):\n            neighbor_value = grid[neighbor_r][neighbor_c]\n            if neighbor_value < min_neighbor_value:\n                min_neighbor_value = neighbor_value\n                next_cell_coords = (neighbor_r, neighbor_c)\n        \n        path_values.append(min_neighbor_value)\n        current_row, current_col = next_cell_coords\n\n    return path_values"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"Computes the lexicographically minimal path of length k in the grid, allowing orthogonal moves and revisiting cells.\"\"\"\n    n = len(grid)\n\n    def get_neighbors(r, c, grid_size):\n        \"\"\"Returns valid orthogonal neighbors for a given (row, col) position within the grid.\"\"\"\n        possible_moves = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]\n        valid_neighbors = set()\n        for nr, nc in possible_moves:\n            if 0 <= nr < grid_size and 0 <= nc < grid_size:\n                valid_neighbors.add((nr, nc))\n        return valid_neighbors\n\n    # Initialize the frontier with all possible starting positions as (row, col) tuples.\n    frontier = set()\n    for r_idx in range(n):\n        for c_idx in range(n):\n            frontier.add((r_idx, c_idx))\n\n    result_path = []\n\n    # Iterate k times to build the path of length k.\n    for step in range(k):\n        current_candidates = set()\n        if step == 0:\n            # For the first step, all cells in the initial frontier are candidates.\n            current_candidates = frontier\n        else:\n            # For subsequent steps, candidates are neighbors of the current frontier positions.\n            current_candidates = set().union(*(get_neighbors(r, c, n) for r, c in frontier))\n\n        # Find the minimum value among the current candidates.\n        min_val_for_step = float('inf')\n        for r, c in current_candidates:\n            min_val_for_step = min(min_val_for_step, grid[r][c])\n\n        result_path.append(min_val_for_step)\n\n        # Update the frontier for the next step: it consists of all candidate positions that contain this minimum value.\n        new_frontier = set()\n        for r, c in current_candidates:\n            if grid[r][c] == min_val_for_step:\n                new_frontier.add((r, c))\n\n        frontier = new_frontier\n\n    return result_path\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"\n    Computes the first n+1 numbers of a specified Tribonacci variant.\n    Memoizes computed terms to avoid repeated calculations.\n    \"\"\"\n    memo = {}\n\n    def calculate_term(k):\n        \"\"\"\n        Calculates a single term of the Tribonacci sequence based on its rules.\n        Uses the shared memoization cache for efficiency.\n        \"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            val = 1\n        elif k == 1:\n            val = 3\n        elif k % 2 == 0:  # k is even and k >= 2\n            val = 1 + (k // 2)\n        else:  # k is odd\n            # tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n            val = calculate_term(k - 1) + calculate_term(k - 2) + calculate_term(k + 1)\n        \n        memo[k] = val\n        return val\n\n    result = []\n    for i in range(n + 1):\n        result.append(calculate_term(i))\n\n    return result\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Computes the first n+1 terms of the non-standard Tribonacci sequence.\n    Applies rules for even and odd indices including computing n+1 if needed for odd n.\n    \"\"\"\n    sequence = []\n\n    # Handle base cases for tri(0) and tri(1)\n    if n >= 0:\n        sequence.append(1)  # tri(0) = 1\n    if n >= 1:\n        sequence.append(3)  # tri(1) = 3\n\n    # Compute terms from tri(2) up to tri(n)\n    for i in range(2, n + 1):\n        if i % 2 == 0:\n            # tri(n) = 1 + n / 2, if n is even (using integer division)\n            sequence.append(1 + i // 2)\n        else:\n            # tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n            # For an odd i, i+1 is even, so tri(i+1) is calculated using the even rule.\n            tri_i_plus_1 = 1 + (i + 1) // 2\n            term = sequence[i - 1] + sequence[i - 2] + tri_i_plus_1\n            sequence.append(term)\n            \n    return sequence\n```"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odds = 1\n    has_odd_digit = False\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product_of_odds *= digit\n            has_odd_digit = True\n\n    if not has_odd_digit:\n        return 0\n    return product_of_odds"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    '''\n    Determines if a string of square brackets contains a valid subsequence with nesting.\n    A nested subsequence exists if two opening brackets are followed by two closing brackets in order.\n    '''\n    first_open_found = False\n    second_open_found = False\n    close_after_second_open_found = False\n\n    for char in string:\n        if char == '[':\n            if not first_open_found:\n                first_open_found = True\n            elif not second_open_found:\n                second_open_found = True\n        else: # char == ']'\n            if second_open_found:\n                if not close_after_second_open_found:\n                    close_after_second_open_found = True\n                else:\n                    return True\n    return False\n```"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = None\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if (digit % 2) == 1:\n            if product is None:\n                product = digit\n            else:\n                product *= digit\n    return product if product is not None else 0"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"Computes the sum of squares for a list of numbers.\n    Each number is rounded up (ceiling) before being squared and added to the total.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        total_sum += ceiled_num * ceiled_num\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"Computes the sum of squared numbers in a list after applying ceiling to each element.\n    This function adheres to strict constraints for simplicity and direct logic.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        squared_num = ceiled_num * ceiled_num\n        total_sum += squared_num\n    return total_sum\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Checks if the last non-space character of a string is a standalone alphabetical character.\n    Returns True if it's a letter, separated by a space or start of string, and no trailing spaces.\n    '''\n    def _is_alpha(char):\n        # Checks if a character is an ASCII letter.\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _is_space(char):\n        # Checks if a character is a space.\n        return char == ' '\n\n    if not txt:\n        return False\n    \n    # As per example \"apple pi e \" -> False, the presence of any trailing space makes it False.\n    if _is_space(txt[-1]):\n        return False\n\n    # At this point, txt is not empty and does not end with a space.\n    # The last character of txt is effectively the last non-space character.\n    last_char = txt[-1]\n\n    if not _is_alpha(last_char):\n        return False\n\n    if len(txt) == 1:\n        # If it's a single character and it's an alpha, it's standalone.\n        return True\n    \n    # Check the character immediately preceding the last character.\n    prev_char = txt[-2]\n    \n    if _is_space(prev_char):\n        # If the character before is a space, the last letter is standalone.\n        return True\n    else:\n        # If the character before is not a space, it's part of a word.\n        return False\n\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Checks if a bracket-only string contains a valid subsequence of nested square brackets.\n    Nesting means a subsequence like '[[]]' (two open brackets followed by two closing brackets).\n    \"\"\"\n    open_count = 0\n    found_nested_condition = False\n\n    for char in string:\n        if char == '[':\n            open_count += 1\n        elif char == ']':\n            # If there are at least two open brackets currently,\n            # then this closing bracket signifies that the innermost pair is nested\n            # within another open bracket.\n            if open_count >= 2:\n                found_nested_condition = True\n            \n            # Decrement open_count if there's an open bracket to match.\n            # Unmatched ']'s (when open_count is 0) are ignored as they don't contribute to nesting.\n            if open_count > 0:\n                open_count -= 1\n                \n    return found_nested_condition\n```"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last significant character is an isolated ASCII letter, ensuring no trailing spaces.\n    Returns True if conditions met, False otherwise.\n    \"\"\"\n    # Business rule: Trailing spaces invalidate the condition (a trailing space means last character is not a letter).\n    # This implies an immediate check for trailing spaces in the original string.\n    if not txt or txt.endswith(' '):\n        return False\n\n    # FR1: Trim trailing spaces. If no trailing spaces were present, rstrip will not change the string.\n    trimmed_txt = txt.rstrip(' ')\n\n    # FR1: If trimmed string is empty (e.g., input was only spaces or empty after trimming), return False.\n    if not trimmed_txt:\n        return False\n\n    # FR1: Split by ASCII spaces into tokens, filtering out any empty tokens.\n    tokens = [token for token in trimmed_txt.split(' ') if token]\n\n    # If no tokens remain after splitting (e.g., string contained only non-alphabetic separators), return False.\n    if not tokens:\n        return False\n\n    # FR1: Inspect the last token.\n    last_token = tokens[-1]\n\n    # FR1: If length == 1 and token is an alphabetic character (A-Z or a-z)\n    is_ascii_alpha = len(last_token) == 1 and ('a' <= last_token <= 'z' or 'A' <= last_token <= 'Z')\n\n    return is_ascii_alpha"}
