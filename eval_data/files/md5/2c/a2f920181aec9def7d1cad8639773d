{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string, counting overlapping cases.\n    Returns 0 if the substring is empty to prevent infinite loops.\n    \"\"\"\n    if not substring:\n        return 0\n\n    count = 0\n    start_index = 0\n    while True:\n        idx = string.find(substring, start_index)\n        if idx == -1:\n            break\n        count += 1\n        start_index = idx + 1\n    return count"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Input is a space-delimited string of numerals. Returns the string with numbers sorted from smallest to largest.\"\"\"\n    word_to_value = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    value_to_word = {v: k for k, v in word_to_value.items()}\n\n    if numbers is None:\n        return \"\"\n\n    # Tokenize, normalize case, and filter out empty strings.\n    tokens = [t.lower() for t in numbers.strip().split() if t.strip()]\n\n    # Map tokens to their numeric value, preserving original index for stable sort.\n    sortable_items = []\n    for i, token in enumerate(tokens):\n        # Assumes all tokens are valid per \"Trust the caller's inputs\" critical requirement.\n        sortable_items.append((word_to_value[token], i))\n\n    # Sort numerically; Python's sorted is stable, preserving original relative order for equal values.\n    sortable_items.sort(key=lambda x: x[0])\n\n    # Convert sorted numeric values back to words.\n    sorted_words = [value_to_word[val] for val, _ in sortable_items]\n\n    return \" \".join(sorted_words)"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Sorts space-delimited spelled digits numerically ascending.\n    Assumes valid input words from 'zero' to 'nine' only, case-insensitive.\n    \"\"\"\n\n    word_to_int = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    int_to_word = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    trimmed_input = numbers.strip()\n    if not trimmed_input:\n        return \"\"\n\n    tokens = [token.lower() for token in trimmed_input.split()]\n\n    int_values = []\n    for token in tokens:\n        int_values.append(word_to_int[token])\n\n    int_values.sort()\n\n    sorted_words = [int_to_word[val] for val in int_values]\n\n    return \" \".join(sorted_words)\n```"}
{"task_id": "HumanEval/20", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_nums = sorted(numbers)\n\n    min_distance = float('inf')\n    closest_pair = (sorted_nums[0], sorted_nums[1])\n\n    for i in range(1, len(sorted_nums)):\n        num1 = sorted_nums[i - 1]\n        num2 = sorted_nums[i]\n        current_distance = abs(num2 - num1)\n\n        if current_distance < min_distance:\n            min_distance = current_distance\n            closest_pair = (num1, num2)\n\n    return closest_pair\n```"}
