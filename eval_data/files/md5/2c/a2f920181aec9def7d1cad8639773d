{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to efficiently check adjacent pairs.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through adjacent pairs to find if any are closer than the threshold.\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Normalize the input string by removing all whitespace characters.\n    # This directly implements the Utility.normalize_input function from the design.\n    normalized_s = ''.join(ch for ch in paren_string if ch not in ' \\t\\n\\r')\n\n    if not normalized_s:\n        return []\n\n    # Implement the core splitting logic, adapted from ParserService._split_core.\n    # CRITICAL: Error handling for invalid characters or overall unbalanced input is omitted\n    # as per the \"FORBIDDEN: Do NOT add ... raise exceptions for edge cases\" instruction.\n    groups_text: List[str] = []\n    balance_count = 0\n    current_group_start_index: int = -1\n\n    for i, char in enumerate(normalized_s):\n        if char == '(':\n            if balance_count == 0:\n                current_group_start_index = i\n            balance_count += 1\n        elif char == ')':\n            balance_count -= 1\n            if balance_count == 0:\n                if current_group_start_index != -1:\n                    groups_text.append(normalized_s[current_group_start_index : i + 1])\n                current_group_start_index = -1\n\n    return groups_text\n```"}
{"task_id": "HumanEval/1", "solution": "```python\n# src/paren_splitter/exceptions.py\nclass ParenSplitterError(Exception):\n    \"\"\"Base exception for the paren_splitter library.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidCharactersError(ParenSplitterError):\n    \"\"\"Raised when the input string contains invalid characters.\"\"\"\n    pass\n\nclass UnbalancedGroupsError(ParenSplitterError):\n    \"\"\"Raised when the input string cannot be split into balanced groups.\"\"\"\n    pass\n\n```python\n# src/paren_splitter/utils.py\nimport re\n\ndef normalize_input(paren_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\"\"\"\n    # Matches space, tab, newline, carriage return, form feed, vertical tab.\n    return re.sub(r'\\s+', '', paren_string)\n\n```python\n# src/paren_splitter/models.py\nclass ParenGroup:\n    \"\"\"Represents a single balanced parenthesis group.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\n    def as_str(self) -> str:\n        \"\"\"Returns the string representation of the group.\"\"\"\n        return self.content\n\n```python\n# src/paren_splitter/validation.py\nfrom typing import Set, Optional\nfrom .exceptions import InvalidCharactersError, UnbalancedGroupsError\n\nclass ValidationService:\n    \"\"\"Provides routines for validating parenthesis input strings.\"\"\"\n    DEFAULT_ALLOWED_CHARS: Set[str] = {'(', ')', ' ', '\\t', '\\n', '\\r'}\n    MAX_INPUT_LENGTH: int = 1_000_000  # Guard against extremely large inputs\n\n    def __init__(self, allowed_chars: Optional[Set[str]] = None) -> None:\n        self.allowed_chars = allowed_chars or self.DEFAULT_ALLOWED_CHARS\n\n    def validate_characters(self, paren_string: str) -> None:\n        \"\"\"Ensures the input string contains only allowed characters.\"\"\"\n        if len(paren_string) > self.MAX_INPUT_LENGTH:\n            raise InvalidCharactersError(f\"Input string exceeds maximum allowed length of {self.MAX_INPUT_LENGTH} characters.\")\n        for i, ch in enumerate(paren_string):\n            if ch not in self.allowed_chars:\n                raise InvalidCharactersError(f\"Invalid character '{ch}' at position {i}\")\n\n    def quick_balance_check(self, normalized: str) -> None:\n        \"\"\"Performs a quick check for overall parenthesis balance.\"\"\"\n        if normalized.count(\"(\") != normalized.count(\")\"):\n            raise UnbalancedGroupsError(\"Total number of '(' does not match ')'\")\n\n```python\n# src/paren_splitter/parser_service.py\nfrom typing import List, Optional\nfrom .validation import ValidationService\nfrom .utils import normalize_input\nfrom .exceptions import UnbalancedGroupsError, InvalidCharactersError\n\nclass ParserService:\n    \"\"\"Core service for parsing and separating parenthesis groups.\"\"\"\n    def __init__(self, validation_service: Optional[ValidationService] = None) -> None:\n        self._validation = validation_service or ValidationService()\n\n    def separate_groups(self, paren_string: str) -> List[str]:\n        \"\"\"Separates an input string into a list of balanced parenthesis groups.\"\"\"\n        self._validation.validate_characters(paren_string)\n        normalized = normalize_input(paren_string)\n        self._validation.quick_balance_check(normalized)\n        return self._scan_and_split(normalized)\n\n    def _scan_and_split(self, normalized: str) -> List[str]:\n        \"\"\"Performs a single-pass scan to split the normalized string.\"\"\"\n        if not normalized:\n            return []\n\n        results: List[str] = []\n        depth = 0\n        start = 0\n\n        for i, ch in enumerate(normalized):\n            if ch == \"(\":\n                depth += 1\n            elif ch == \")\":\n                depth -= 1\n\n            if depth < 0:\n                raise UnbalancedGroupsError(f\"Unmatched closing parenthesis at position {i} in normalized string.\")\n\n            if depth == 0:\n                # Found a balanced group\n                results.append(normalized[start:i+1])\n                start = i + 1\n        \n        if depth != 0:\n            raise UnbalancedGroupsError(\"Unclosed parenthesis after scanning the entire string.\")\n        \n        return results\n\n```python\n# src/paren_splitter/__init__.py\nfrom typing import List\nfrom .parser_service import ParserService\nfrom .exceptions import InvalidCharactersError, UnbalancedGroupsError\n\n__version__ = \"0.1.0\"\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Accepts a string containing multiple groups of parentheses and returns a list of\n    balanced parenthesis group strings.\n    \"\"\"\n    return ParserService().separate_groups(paren_string)\n\n```python\n# src/paren_splitter/cli.py\nimport argparse\nimport sys\nimport json\nfrom typing import List, Optional\n\nfrom .parser_service import ParserService\nfrom .exceptions import ParenSplitterError, InvalidCharactersError, UnbalancedGroupsError\n\nclass CLIController:\n    \"\"\"Manages command-line interface interactions for parensplit.\"\"\"\n    EXIT_OK = 0\n    EXIT_VALIDATION_ERROR = 2\n    EXIT_UNEXPECTED_ERROR = 1\n\n    def __init__(self, parser_service: Optional[ParserService] = None) -> None:\n        self._parser_service = parser_service or ParserService()\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, processes input, and prints formatted output.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Split a string of parentheses into balanced groups.\",\n            epilog=\"Example: parensplit '( ) (( ))' -> prints '()\\\\n(())'\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        parser.add_argument(\n            \"input_string\",\n            nargs=\"?\",\n            help=\"The string containing parenthesis groups to separate.\",\n            default=None\n        )\n        parser.add_argument(\n            \"--file\", \"-f\",\n            type=str,\n            help=\"Read input from a specified file instead of a string argument.\"\n        )\n        parser.add_argument(\n            \"--json\", \"-j\",\n            action=\"store_true\",\n            help=\"Output results as a JSON array.\"\n        )\n        parser.add_argument(\n            \"--version\",\n            action=\"version\",\n            version=f\"%(prog)s {__import__('paren_splitter').__version__}\"\n        )\n\n        args = parser.parse_args(argv[1:])\n\n        if not args.input_string and not args.file:\n            print(\"Error: Either an input string or --file must be provided.\", file=sys.stderr)\n            parser.print_help(sys.stderr)\n            return self.EXIT_VALIDATION_ERROR\n\n        if args.input_string and args.file:\n            print(\"Error: Cannot specify both an input string and --file.\", file=sys.stderr)\n            return self.EXIT_VALIDATION_ERROR\n        \n        input_data: str = \"\"\n        if args.file:\n            try:\n                with open(args.file, 'r', encoding='utf-8') as f:\n                    input_data = f.read()\n            except FileNotFoundError:\n                print(f\"Error: File not found: {args.file}\", file=sys.stderr)\n                return self.EXIT_VALIDATION_ERROR\n            except Exception as e:\n                print(f\"Error reading file {args.file}: {e}\", file=sys.stderr)\n                return self.EXIT_UNEXPECTED_ERROR\n        else:\n            input_data = args.input_string\n\n        try:\n            groups = self._parser_service.separate_groups(input_data)\n            output = self._format_output(groups, args.json)\n            print(output)\n            return self.EXIT_OK\n        except (InvalidCharactersError, UnbalancedGroupsError) as e:\n            print(f\"Validation Error: {e.message}\", file=sys.stderr)\n            return self.EXIT_VALIDATION_ERROR\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return self.EXIT_UNEXPECTED_ERROR\n\n    def _format_output(self, groups: List[str], json_out: bool) -> str:\n        \"\"\"Formats the list of groups as a JSON array or one-per-line strings.\"\"\"\n        if json_out:\n            return json.dumps(groups)\n        else:\n            return \"\\n\".join(groups)\n\n```python\n# src/paren_splitter/__main__.py\nimport sys\nfrom .cli import CLIController\n\ndef main():\n    \"\"\"CLI entrypoint for the paren_splitter module.\"\"\"\n    controller = CLIController()\n    sys.exit(controller.run(sys.argv))\n\nif __name__ == \"__main__\":\n    main()\n\n```python\n# tests/test_validation.py\nimport pytest\nfrom src.paren_splitter.validation import ValidationService\nfrom src.paren_splitter.exceptions import InvalidCharactersError, UnbalancedGroupsError\n\ndef test_validate_characters_allowed():\n    \"\"\"Test with valid characters including whitespace.\"\"\"\n    service = ValidationService()\n    service.validate_characters(\" ( ) (( )) \\t\\n\\r\")  # Should not raise\n\ndef test_validate_characters_invalid():\n    \"\"\"Test with an invalid character.\"\"\"\n    service = ValidationService()\n    with pytest.raises(InvalidCharactersError, match=\"Invalid character 'a' at position 1\"):\n        service.validate_characters(\"(a)\")\n\ndef test_validate_characters_empty():\n    \"\"\"Test with an empty string.\"\"\"\n    service = ValidationService()\n    service.validate_characters(\"\") # Should not raise\n\ndef test_validate_characters_custom_allowed():\n    \"\"\"Test with a custom set of allowed characters.\"\"\"\n    service = ValidationService(allowed_chars={'a', 'b', 'c'})\n    service.validate_characters(\"abc\")\n    with pytest.raises(InvalidCharactersError):\n        service.validate_characters(\"(a)\")\n\ndef test_quick_balance_check_balanced():\n    \"\"\"Test quick balance check with balanced parentheses.\"\"\"\n    service = ValidationService()\n    service.quick_balance_check(\"()(())\") # Should not raise\n\ndef test_quick_balance_check_unbalanced_count():\n    \"\"\"Test quick balance check with unequal total counts.\"\"\"\n    service = ValidationService()\n    with pytest.raises(UnbalancedGroupsError, match=\"Total number of '\\\\(' does not match '\\\\)'\"):\n        service.quick_balance_check(\"(()\")\n    with pytest.raises(UnbalancedGroupsError, match=\"Total number of '\\\\(' does not match '\\\\)'\"):\n        service.quick_balance_check(\"())\")\n\ndef test_quick_balance_check_empty():\n    \"\"\"Test quick balance check with an empty string.\"\"\"\n    service = ValidationService()\n    service.quick_balance_check(\"\") # Should not raise\n\ndef test_input_length_limit():\n    \"\"\"Test that extremely long inputs raise an error.\"\"\"\n    service = ValidationService()\n    long_string = \"(\" * (service.MAX_INPUT_LENGTH + 1)\n    with pytest.raises(InvalidCharactersError, match=f\"Input string exceeds maximum allowed length of {service.MAX_INPUT_LENGTH} characters.\"):\n        service.validate_characters(long_string)\n    \n    # Test valid length\n    valid_string = \"(\" * service.MAX_INPUT_LENGTH\n    service.validate_characters(valid_string) # Should not raise\n\n```python\n# tests/test_parser_service.py\nimport pytest\nfrom src.paren_splitter import separate_paren_groups\nfrom src.paren_splitter.parser_service import ParserService\nfrom src.paren_splitter.validation import ValidationService\nfrom src.paren_splitter.exceptions import InvalidCharactersError, UnbalancedGroupsError\n\n# --- Tests for separate_paren_groups (public API) ---\ndef test_public_api_sample():\n    \"\"\"Test the public API with the example from the spec.\"\"\"\n    assert separate_paren_groups(\"( ) (( )) (( )( ))\") == [\"()\", \"(())\", \"(()())\"]\n\ndef test_public_api_simple_adjacent():\n    \"\"\"Test public API with simple adjacent groups.\"\"\"\n    assert separate_paren_groups(\"()(())\") == [\"()\", \"(())\"]\n\ndef test_public_api_empty_string():\n    \"\"\"Test public API with an empty input string.\"\"\"\n    assert separate_paren_groups(\"\") == []\n\ndef test_public_api_only_whitespace():\n    \"\"\"Test public API with only whitespace.\"\"\"\n    assert separate_paren_groups(\"  \\t\\n  \") == []\n\ndef test_public_api_invalid_char():\n    \"\"\"Test public API raises InvalidCharactersError.\"\"\"\n    with pytest.raises(InvalidCharactersError, match=\"Invalid character 'a'\"):\n        separate_paren_groups(\"(a)\")\n\ndef test_public_api_unbalanced_groups_prefix():\n    \"\"\"Test public API raises UnbalancedGroupsError for unmatched closing prefix.\"\"\"\n    with pytest.raises(UnbalancedGroupsError, match=\"Unmatched closing parenthesis at position 0\"):\n        separate_paren_groups(\")()\")\n\ndef test_public_api_unbalanced_groups_suffix():\n    \"\"\"Test public API raises UnbalancedGroupsError for unmatched open suffix.\"\"\"\n    with pytest.raises(UnbalancedGroupsError, match=\"Unclosed parenthesis after scan\"):\n        separate_paren_groups(\"(()\")\n\ndef test_public_api_unbalanced_overall_count():\n    \"\"\"Test public API raises UnbalancedGroupsError for unequal total counts.\"\"\"\n    with pytest.raises(UnbalancedGroupsError, match=\"Total number of '\\\\(' does not match '\\\\)'\"):\n        separate_paren_groups(\"((()))(\" + \"   \")\n\n# --- Tests for ParserService directly ---\n@pytest.fixture\ndef parser_service():\n    \"\"\"Fixture for ParserService with default ValidationService.\"\"\"\n    return ParserService()\n\ndef test_parser_service_simple_groups(parser_service: ParserService):\n    \"\"\"Test ParserService with multiple simple groups.\"\"\"\n    assert parser_service.separate_groups(\"()()()\") == [\"()\", \"()\", \"()\"]\n\ndef test_parser_service_nested_groups(parser_service: ParserService):\n    \"\"\"Test ParserService with nested groups.\"\"\"\n    assert parser_service.separate_groups(\"((()))\") == [\"((()))\"]\n\ndef test_parser_service_mixed_groups(parser_service: ParserService):\n    \"\"\"Test ParserService with mixed simple and nested groups.\"\"\"\n    assert parser_service.separate_groups(\"() (()) ((()()))\") == [\"()\", \"(())\", \"((()()))\"]\n\ndef test_parser_service_no_groups(parser_service: ParserService):\n    \"\"\"Test ParserService with no parenthesis.\"\"\"\n    assert parser_service.separate_groups(\"\") == []\n    assert parser_service.separate_groups(\"    \") == []\n\ndef test_parser_service_complex_example(parser_service: ParserService):\n    \"\"\"Test ParserService with a more complex input string.\"\"\"\n    input_str = \" ( ( ) ( () ) ) ( () ) \"\n    expected = [\"((()()))\", \"(()())\"]\n    assert parser_service.separate_groups(input_str) == expected\n\ndef test_parser_service_validation_delegation_invalid_char():\n    \"\"\"Test ParserService delegates invalid char validation.\"\"\"\n    mock_validation = ValidationService()\n    mock_validation.validate_characters = lambda x: (_ for _ in ()).throw(InvalidCharactersError(\"Mock Error\"))\n    service = ParserService(validation_service=mock_validation)\n    with pytest.raises(InvalidCharactersError, match=\"Mock Error\"):\n        service.separate_groups(\"invalid input\")\n\ndef test_parser_service_validation_delegation_unbalanced_quick_check():\n    \"\"\"Test ParserService delegates quick balance check.\"\"\"\n    mock_validation = ValidationService()\n    mock_validation.quick_balance_check = lambda x: (_ for _ in ()).throw(UnbalancedGroupsError(\"Mock Balance Error\"))\n    service = ParserService(validation_service=mock_validation)\n    with pytest.raises(UnbalancedGroupsError, match=\"Mock Balance Error\"):\n        service.separate_groups(\"((()))(\")\n\ndef test_parser_service_unbalanced_during_scan_unmatched_closing(parser_service: ParserService):\n    \"\"\"Test ParserService raises UnbalancedGroupsError during scan for unmatched closing.\"\"\"\n    with pytest.raises(UnbalancedGroupsError, match=\"Unmatched closing parenthesis at position 0\"):\n        parser_service.separate_groups(\")(\"),\n    with pytest.raises(UnbalancedGroupsError, match=\"Unmatched closing parenthesis at position 1\"):\n        parser_service.separate_groups(\"())\")\n\ndef test_parser_service_unbalanced_during_scan_unclosed_remaining(parser_service: ParserService):\n    \"\"\"Test ParserService raises UnbalancedGroupsError during scan for unclosed parentheses.\"\"\"\n    with pytest.raises(UnbalancedGroupsError, match=\"Unclosed parenthesis after scan\"):\n        parser_service.separate_groups(\"(()\")\n    with pytest.raises(UnbalancedGroupsError, match=\"Unclosed parenthesis after scan\"):\n        parser_service.separate_groups(\"((()))((\")\n\ndef test_parser_service_max_input_length():\n    \"\"\"Test that ParserService respects ValidationService's max input length.\"\"\"\n    validation_service = ValidationService()\n    validation_service.MAX_INPUT_LENGTH = 10  # Temporarily override for test\n    parser = ParserService(validation_service=validation_service)\n\n    with pytest.raises(InvalidCharactersError, match=\"Input string exceeds maximum allowed length\"):\n        parser.separate_groups(\"((()))(())\") # 10 chars, so this is 11\n\n    # Test exact limit\n    parser.separate_groups(\"((()))()\") # 10 chars, should be OK\n\n```python\n# tests/test_cli.py\nimport pytest\nfrom unittest.mock import MagicMock, patch\nimport io\nimport sys\nimport os\n\nfrom src.paren_splitter.cli import CLIController\nfrom src.paren_splitter.parser_service import ParserService\nfrom src.paren_splitter.exceptions import InvalidCharactersError, UnbalancedGroupsError\n\n@pytest.fixture\ndef mock_parser_service():\n    \"\"\"Mock ParserService for CLI tests.\"\"\"\n    mock = MagicMock(spec=ParserService)\n    mock.separate_groups.return_value = [\"()\", \"(())\"]\n    return mock\n\n@pytest.fixture\ndef cli_controller(mock_parser_service):\n    \"\"\"CLIController with a mocked ParserService.\"\"\"\n    return CLIController(parser_service=mock_parser_service)\n\n@pytest.fixture\ndef capsys_output(capsys):\n    \"\"\"Fixture to capture stdout and stderr.\"\"\"\n    return capsys\n\ndef test_cli_run_string_input_default_format(cli_controller: CLIController, capsys_output, mock_parser_service: MagicMock):\n    \"\"\"Test CLI with string input and default (one-per-line) output.\"\"\"\n    argv = [\"parensplit\", \"( ) ( ( ) )\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_OK\n    captured = capsys_output.readouterr()\n    assert captured.out == \"()\\n(())\\n\"\n    assert captured.err == \"\"\n    mock_parser_service.separate_groups.assert_called_once_with(\"( ) ( ( ) )\")\n\ndef test_cli_run_string_input_json_format(cli_controller: CLIController, capsys_output, mock_parser_service: MagicMock):\n    \"\"\"Test CLI with string input and JSON output.\"\"\"\n    argv = [\"parensplit\", \"--json\", \"( ) ( ( ) )\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_OK\n    captured = capsys_output.readouterr()\n    assert captured.out.strip() == '[\"()\", \"(())\"]'\n    assert captured.err == \"\"\n    mock_parser_service.separate_groups.assert_called_once_with(\"( ) ( ( ) )\")\n\ndef test_cli_run_file_input_default_format(cli_controller: CLIController, capsys_output, mock_parser_service: MagicMock, tmp_path):\n    \"\"\"Test CLI with file input and default output.\"\"\"\n    file_content = \"( ) ( ( ) )\"\n    input_file = tmp_path / \"input.txt\"\n    input_file.write_text(file_content)\n\n    argv = [\"parensplit\", \"--file\", str(input_file)]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_OK\n    captured = capsys_output.readouterr()\n    assert captured.out == \"()\\n(())\\n\"\n    assert captured.err == \"\"\n    mock_parser_service.separate_groups.assert_called_once_with(file_content)\n\ndef test_cli_run_file_input_json_format(cli_controller: CLIController, capsys_output, mock_parser_service: MagicMock, tmp_path):\n    \"\"\"Test CLI with file input and JSON output.\"\"\"\n    file_content = \"( ) ( ( ) )\"\n    input_file = tmp_path / \"input.txt\"\n    input_file.write_text(file_content)\n\n    argv = [\"parensplit\", \"--file\", str(input_file), \"--json\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_OK\n    captured = capsys_output.readouterr()\n    assert captured.out.strip() == '[\"()\", \"(())\"]'\n    assert captured.err == \"\"\n    mock_parser_service.separate_groups.assert_called_once_with(file_content)\n\ndef test_cli_run_no_input(cli_controller: CLIController, capsys_output):\n    \"\"\"Test CLI when no input string or file is provided.\"\"\"\n    argv = [\"parensplit\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_VALIDATION_ERROR\n    captured = capsys_output.readouterr()\n    assert \"Error: Either an input string or --file must be provided.\" in captured.err\n    assert \"usage: parensplit\" in captured.err # argparse help message\n    assert captured.out == \"\"\n\ndef test_cli_run_both_string_and_file_input(cli_controller: CLIController, capsys_output, tmp_path):\n    \"\"\"Test CLI when both string and file input are provided.\"\"\"\n    input_file = tmp_path / \"input.txt\"\n    input_file.write_text(\"()\")\n    argv = [\"parensplit\", \"()\", \"--file\", str(input_file)]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_VALIDATION_ERROR\n    captured = capsys_output.readouterr()\n    assert \"Error: Cannot specify both an input string and --file.\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_run_file_not_found(cli_controller: CLIController, capsys_output):\n    \"\"\"Test CLI when the specified input file does not exist.\"\"\"\n    argv = [\"parensplit\", \"--file\", \"non_existent_file.txt\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_VALIDATION_ERROR\n    captured = capsys_output.readouterr()\n    assert \"Error: File not found: non_existent_file.txt\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_run_invalid_characters_error(cli_controller: CLIController, capsys_output, mock_parser_service: MagicMock):\n    \"\"\"Test CLI handles InvalidCharactersError.\"\"\"\n    mock_parser_service.separate_groups.side_effect = InvalidCharactersError(\"Contains 'x'\")\n    argv = [\"parensplit\", \"(x)\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_VALIDATION_ERROR\n    captured = capsys_output.readouterr()\n    assert \"Validation Error: Contains 'x'\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_run_unbalanced_groups_error(cli_controller: CLIController, capsys_output, mock_parser_service: MagicMock):\n    \"\"\"Test CLI handles UnbalancedGroupsError.\"\"\"\n    mock_parser_service.separate_groups.side_effect = UnbalancedGroupsError(\"Unclosed bracket\")\n    argv = [\"parensplit\", \"(()\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_VALIDATION_ERROR\n    captured = capsys_output.readouterr()\n    assert \"Validation Error: Unclosed bracket\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_run_unexpected_error(cli_controller: CLIController, capsys_output, mock_parser_service: MagicMock):\n    \"\"\"Test CLI handles an unexpected error.\"\"\"\n    mock_parser_service.separate_groups.side_effect = ValueError(\"Something went wrong\")\n    argv = [\"parensplit\", \"()\"]\n    exit_code = cli_controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_UNEXPECTED_ERROR\n    captured = capsys_output.readouterr()\n    assert \"An unexpected error occurred: Something went wrong\" in captured.err\n    assert captured.out == \"\"\n\ndef test_cli_version_flag(capsys_output):\n    \"\"\"Test the --version flag.\"\"\"\n    # We need to test the actual CLIController without a mock to get the real version from __init__.py\n    controller = CLIController()\n    with pytest.raises(SystemExit) as excinfo:\n        controller.run([\"parensplit\", \"--version\"])\n    \n    assert excinfo.value.code == 0\n    captured = capsys_output.readouterr()\n    # Assuming __version__ is '0.1.0'\n    assert \"parensplit 0.1.0\" in captured.out\n    assert captured.err == \"\"\n\n# Integration test: ensures CLIController can instantiate default ParserService\ndef test_cli_controller_with_default_parser_service(capsys_output):\n    \"\"\"Test CLIController with no injected ParserService, using real logic.\"\"\"\n    controller = CLIController()\n    argv = [\"parensplit\", \"( ) ( ( ) )\"]\n    exit_code = controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_OK\n    captured = capsys_output.readouterr()\n    assert captured.out == \"()\\n(())\\n\"\n    assert captured.err == \"\"\n\ndef test_cli_controller_with_default_parser_service_error_handling(capsys_output):\n    \"\"\"Test CLIController with default ParserService handles real errors.\"\"\"\n    controller = CLIController()\n    argv = [\"parensplit\", \"((())\"] # Unbalanced\n    exit_code = controller.run(argv)\n\n    assert exit_code == CLIController.EXIT_VALIDATION_ERROR\n    captured = capsys_output.readouterr()\n    assert \"Validation Error: Unclosed parenthesis after scan\" in captured.err\n\n```toml\n# pyproject.toml\n[project]\nname = \"paren-splitter\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI to split strings into balanced parenthesis groups.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nlicense = { file = \"LICENSE\" }\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"parentheses\", \"parsing\", \"cli\", \"library\"]\nclassifiers = [\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.8\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Text Processing\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/paren-splitter\"\nRepository = \"https://github.com/yourusername/paren-splitter\"\n\n[project.scripts]\nparensplit = \"paren_splitter.__main__:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n```markdown\n# README.md\n\n## paren-splitter\n\nA Python library and command-line interface (CLI) to split strings containing multiple groups of parentheses into a list of balanced parenthesis group strings.\n\n## Features\n\n- **Library Function**: `separate_paren_groups(paren_string: str) -> List[str]` for easy integration into your Python projects.\n- **CLI Tool**: `parensplit` for interactive use or scripting, supporting string or file input and JSON output.\n- **Robust Validation**: Detects invalid characters and unbalanced parenthesis groups with clear error messages.\n- **Pure Python**: No external C dependencies, compatible with Python 3.8+.\n- **Modular Design**: Follows SOLID principles with dependency injection for testability.\n- **Well-tested**: Comprehensive unit tests for core logic and CLI.\n\n## Installation\n\nYou can install `paren-splitter` via pip:\n\n```bash\npip install paren-splitter\n```\n\n## Usage\n\n### As a Python Library\n\n```python\nfrom paren_splitter import separate_paren_groups, InvalidCharactersError, UnbalancedGroupsError\n\n# Example 1: Basic usage\ninput_string = \"( ) (( )) (( )( ))\"\ngroups = separate_paren_groups(input_string)\nprint(groups)\n# Output: ['()', '(())', '(()())']\n\n# Example 2: Adjacent groups\ninput_string_2 = \"()(())\"\ngroups_2 = separate_paren_groups(input_string_2)\nprint(groups_2)\n# Output: ['()', '(())']\n\n# Example 3: Empty input\ninput_string_3 = \"\"\ngroups_3 = separate_paren_groups(input_string_3)\nprint(groups_3)\n# Output: []\n\n# Example 4: Handling invalid characters\ntry:\n    separate_paren_groups(\"(a)\")\nexcept InvalidCharactersError as e:\n    print(f\"Error: {e.message}\")\n# Output: Error: Invalid character 'a' at position 1\n\n# Example 5: Handling unbalanced groups\ntry:\n    separate_paren_groups(\"(()\")\nexcept UnbalancedGroupsError as e:\n    print(f\"Error: {e.message}\")\n# Output: Error: Unclosed parenthesis after scan\n```\n\n### As a Command-Line Tool\n\nThe `parensplit` command allows you to use the functionality directly from your terminal.\n\n```bash\n# Get help\nparensplit --help\n\n# Split a string, output one group per line\nparensplit \"( ) (( )) (( )( ))\"\n# Output:\n# ()\n# (())\n# (()())\n\n# Split a string, output as JSON\nparensplit --json \"() (())\"\n# Output: [\"()\",\"(())\"]\n\n# Read input from a file\necho \"() (())\" > input.txt\nparensplit --file input.txt\n# Output:\n# ()\n# (())\n\n# Error: Invalid characters\nparensplit \"(abc)\"\n# Output (to stderr): Validation Error: Invalid character 'a' at position 1\n\n# Error: Unbalanced groups\nparensplit \"(()\"\n# Output (to stderr): Validation Error: Unclosed parenthesis after scan\n```\n\n## Development\n\n### Setup\n\n1. Clone the repository:\n   ```bash\n   git clone https://github.com/yourusername/paren-splitter.git\n   cd paren-splitter\n   ```\n2. (Optional) Create and activate a virtual environment:\n   ```bash\n   python -m venv .venv\n   source .venv/bin/activate # On Windows: .venv\\Scripts\\activate\n   ```\n3. Install dependencies (including dev dependencies for testing):\n   ```bash\n   pip install -e \".[dev]\"\n   ```\n   (Note: The `[dev]` extra is typically defined in `pyproject.toml` or `setup.cfg` to include `pytest` and `pytest-cov`. For this specific `pyproject.toml`, you would manually install `pytest` and `pytest-cov`.)\n\n   ```bash\n   pip install pytest pytest-cov\n   ```\n\n### Running Tests\n\n```bash\npytest\npytest --cov=src/paren_splitter --cov-report=term-missing\n```\n\n### Building and Distributing\n\n```bash\npython -m build\n# This will create `dist/` with .whl and .tar.gz files.\n```\n\n## License\n\nThis project is licensed under the MIT License - see the [LICENSE](LICENSE) file for details.\n```\n```\n# LICENSE\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n\n    return False\n```"}
