r = argparse.ArgumentParser(\n            prog=\"digitops shift\",\n            description=\"Perform circular shift on digits of an integer.\"\n        )\n        parser.add_argument(\n            \"x\",\n            type=str,\n            help=\"The integer whose digits are to be shifted (e.g., 123).\"\n        )\n        parser.add_argument(\n            \"shift\",\n            type=str,\n            help=\"The number of positions to shift right (e.g., 1).\"\n        )\n\n        try:\n            parsed_args = parser.parse_args(args)\n            resp = self.service.shift(parsed_args.x, parsed_args.shift)\n            self._print_result(resp.result)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Input error: {e}\", file=self.err)\n            return 2\n        except (ShiftError, Exception) as e:\n            print(f\"Error: {e}\", file=self.err)\n            return 1\n\n    def _print_result(self, result: str) -> None:\n        \"\"\"\n        Prints the operation result to the standard output.\n        \"\"\"\n        print(result, file=self.out)\n\ndef main():\n    \"\"\"\n    Console script entry point for 'digitops shift'.\n    \"\"\"\n    handler = CLIHandler(DEFAULT_SHIFT_SERVICE)\n    sys.exit(handler.run(sys.argv[2:])) # argv[0] is 'python', argv[1] is 'digitops', argv[2] is 'shift'\n\nif __name__ == '__main__':\n    # This block is for direct testing of cli.py, typically 'python -m src.digitops.cli shift 123 1'\n    # For actual CLI entry point, 'main()' is used.\n    handler = CLIHandler(DEFAULT_SHIFT_SERVICE)\n    sys.exit(handler.run(sys.argv[1:]))\n\n```\n```python\n# src/digitops/api.py\nfrom typing import Optional\nfrom fastapi import FastAPI, HTTPException, Header, Depends\nfrom fastapi.responses import JSONResponse\nimport uvicorn\n\nfrom digitops.service import ShiftService\nfrom digitops.schemas import ShiftRequest, ShiftResponse\nfrom digitops.exceptions import InvalidInputError, ShiftError\nfrom digitops