{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' with even-indexed elements sorted.\n    Odd-indexed elements remain in their original positions.\n    \"\"\"\n    result = list(l) # Create a mutable copy to preserve the original list.\n\n    even_indices_values = []\n    for i in range(0, len(l), 2):\n        even_indices_values.append(l[i])\n\n    even_indices_values.sort() # Sort the extracted even-indexed values in ascending order.\n\n    sorted_value_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indices_values[sorted_value_idx]\n        sorted_value_idx += 1\n\n    return result\n```"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    sorted_even_values = sorted(even_indexed_values)\n    result_list = list(l)\n    for i, val in enumerate(sorted_even_values):\n        result_list[i * 2] = val\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string by cycling groups of three characters to their original position.\n    It reverses the encoding performed by encode_cyclic.\n    \"\"\"\n    # Split string into groups of three characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Cycle elements in each group right by one, if group has 3 elements.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
