nt(f\"Error: {e}\") # Output: Error: Input bit strings must have equal length\n\ntry:\n    string_xor(\"020\", \"110\")\nexcept Exception as e:\n    print(f\"Error: {e}\") # Output: Error: Invalid characters in bit string: {'2'}\n```\n\n### Command Line Interface (CLI)\n\nThe `bitxor` command provides quick XOR computation from your terminal:\n\n```bash\n# Basic XOR operation\nbitxor xor \"010\" \"110\"\n# Output: 100\n\n# Error for differing lengths\nbitxor xor \"01\" \"110\"\n# Output: Error: Input bit strings must have equal length\n# Exits with non-zero status\n\n# Error for invalid characters\nbitxor xor \"020\" \"110\"\n# Output: Error: Invalid characters in bit string: {'2'}\n# Exits with non-zero status\n\n# Error for missing arguments\nbitxor xor\n# Output: Error: Usage: bitxor xor <bitstring_a> <bitstring_b>\n# Exits with non-zero status\n```\n\n## Development\n\nTo run tests:\n\n```bash\npip install -e .[dev]\npytest\n```\n```\n\n# src/bitxor/__init__.py\n```python\n\"\"\"Package for bitxor library and CLI.\"\"\"\n\nfrom .api import string_xor\n\n__all__ = [\"string_xor\"]\n```\n\n# src/bitxor/errors.py\n```python\n\"\"\"Domain-specific exceptions for bit string operations.\"\"\"\n\nclass InvalidBitStringError(Exception):\n    \"\"\"Raised when a bit string fails validation.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n```\n\n# src/bitxor/models.py\n```python\n\"\"\"Domain model for a bit string.\"\"\"\n\nfrom typing import Iterator\n\nclass BitString:\n    \"\"\"An immutable representation of a bit string.\"\"\"\n    def __init__(self, value: str) -> None:\n        # Assumes input 'value' has been validated before creation.\n        self.value: str = value\n\n    def __len__(self) -> int:\n        \"\"\"Return the length of the bit string.\"\"\"\n        return len(self.value)\n\n    def __iter__(self) -> Iterator[str]:\n        \"\"\"Iterate over characters of the bit string.\"\"\"\n        return iter(self.value)\n\n    def as_str(self) -> str:\n        \"\"\"Return the underlying string value.\"\"\"\n        return self.value\n```\n\n# src/bitxor/validator.py\n```python\n\"\"\"Utility functions for validating bit string inputs.\"\"\"\n\nfrom .errors import InvalidBitStringError\n\ndef validate_bitstring(value: str) -> None:\n    \"\"\"Validates if a string is a non-empty bit string ('0' and '1').\"\"\"\n    if not value:\n        raise InvalidBitStringError(\"Bit string must be non-empty.\")\n    invalid = {c for c in value if c not in (\"0\", \"1\")}\n    if invalid:\n        raise InvalidBitStringError(f\"Invalid characters in bit string: {sorted(list(invalid))}.\")\n\ndef validate_equal_length(a: str, b: str) -> None:\n    \"\"\"Validates if two strings have equal length.\"\"\"\n    if len(a) != len(b):\n        raise InvalidBitStringError(\"Input bit strings must have equal length.\")\n```\n\n# src/bitxor/utils.py\n```python\n\"\"\"General utility functions and optimized XOR implementation.\"\"\"\n\nDEFAULT_CHUNK_SIZE = 4096\n\ndef chunked_xor(a: str, b: str, chunk_size: int = DEFAULT_CHUNK_SIZE) -> str:\n    \"\"\"Performs bitwise XOR on two strings in chunks for efficiency.\"\"\"\n    n = len(a)\n    result_parts = []\n    for i in range(0, n, chunk_size):\n        a_chunk = a[i : i + chunk_size]\n        b_chunk = b[i : i + chunk_size]\n        # Perform element-wise XOR for the current chunk.\n        result_parts.append(''.join('1' if x != y else '0' for x, y in zip(a_chunk, b_chunk)))\n    return ''.join(result_parts)\n```\n\n# src/bitxor/services.py\n```python\n\"\"\"Business logic for bitwise XOR operations.\"\"\"\n\nfrom .models import BitString\nfrom .validator import validate_bitstring, validate_equal_length\nfrom . import utils\n\nclass XORService:\n    \"\"\"Provides the core business logic for computing bitwise XOR.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def xor(self, a: BitString, b: BitString) -> BitString:\n        \"\"\"Computes the bitwise XOR of two BitString objects.\"\"\"\n        validate_bitstring(a.value)\n        validate_bitstring(b.value)\n        validate_equal_length(a.value, b.value)\n        result_str = utils.chunked_xor(a.value, b.value)\n        return BitString(result_str)\n```\n\n# src/bitxor/api.py\n```python\n\"\"\"Public API for the bitxor library.\"\"\"\n\nfrom .models import BitString\nfrom .services import XORService\nfrom .validator import validate_bitstring, validate_equal_length\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Computes the bitwise XOR of two equal-length binary strings.\n\n    Raises InvalidBitStringError for invalid inputs (non-binary characters, differing lengths, empty strings).\n    \"\"\"\n    validate_bitstring(a)\n    validate_bitstring(b)\n    validate_equal_length(a, b)\n    service = XORService()\n    result = service.xor(BitString(a), BitString(b))\n    return result.as_str()\n```\n\n# src/bitxor/controllers.py\n```python\n\"\"\"CLI adapter for the bitxor application.\"\"\"\n\nimport sys\nfrom typing import List\n\nfrom .models import BitString\nfrom .services import XORService\nfrom .errors import InvalidBitStringError\n\nclass CLIController:\n    \"\"\"Handles command-line argument parsing and output for the bitxor CLI.\"\"\"\n    EXIT_SUCCESS = 0\n    EXIT_FAILURE = 1\n\n    def __init__(self, service: XORService):\n        self.service = service\n\n    def _print_result(self, result: str) -> None:\n        \"\"\"Prints the successful result to standard output.\"\"\"\n        print(result)\n\n    def _print_error(self, message: str) -> None:\n        \"\"\"Prints an error message to standard error.\"\"\"\n        print(f\"Error: {message}\", file=sys.stderr)\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Main entry point for the CLI command.\"\"\"\n        try:\n            if not argv or argv[0] != \"xor\":\n                self._print_error(\"Usage: bitxor xor <bitstring_a> <bitstring_b>\")\n                return self.EXIT_FAILURE\n            \n            # The 'xor' subcommand is expected to be argv[0]\n            if len(argv) != 3:\n                self._print_error(\"Usage: bitxor xor <bitstring_a> <bitstring_b>\")\n                return self.EXIT_FAILURE\n\n            a_str, b_str = argv[1], argv[2]\n            \n            # The service takes BitString objects, which are constructed from validated strings.\n            # Validation happens within the service.xor method via Validator.\n            result_bitstring = self.service.xor(BitString(a_str), BitString(b_str))\n            self._print_result(result_bitstring.as_str())\n            return self.EXIT_SUCCESS\n        except InvalidBitStringError as e:\n            self._print_error(str(e))\n            return self.EXIT_FAILURE\n        except Exception as e:\n            self._print_error(f\"An unexpected error occurred: {e}\")\n            return self.EXIT_FAILURE\n```\n\n# src/bitxor/__main__.py\n```python\n\"\"\"Entry point for the bitxor CLI application.\"\"\"\n\nimport sys\nfrom .services import XORService\nfrom .controllers import CLIController\n\ndef main() -> None:\n    \"\"\"Instantiates the CLIController and runs the command.\"\"\"\n    service = XORService()\n    controller = CLIController(service)\n    # Pass arguments excluding the script name itself (sys.argv[0])\n    sys.exit(controller.run(sys.argv[1:]))\n\nif __name__ == \"__main__\":\n    main()\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, returning the first encountered in case of ties. Returns None if the input list is empty.\"\"\"\n    if not strings:\n        return None\n\n    max_len = -1\n    longest_string = None\n\n    for s in strings:\n        if len(s) > max_len:\n            max_len = len(s)\n            longest_string = s\n    \n    return longest_string\n```"}
