{"task_id": "HumanEval/48", "solution": "import unicodedata\n\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome, using default normalization.\n    Normalization: case-insensitive, remove non-alphanumeric, NFKC Unicode.\n    \"\"\"\n    # Apply unicode normalization (NFKC)\n    normalized_text = unicodedata.normalize(\"NFKC\", text)\n\n    # Convert to lowercase\n    normalized_text = normalized_text.lower()\n\n    # Remove non-alphanumeric characters\n    cleaned_text = \"\"\n    for char in normalized_text:\n        if char.isalnum():\n            cleaned_text += char\n    \n    # Check if the cleaned string is a palindrome\n    return cleaned_text == cleaned_text[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Computes 2^n modulo p using modular exponentiation (repeated squaring).\n    This method efficiently handles large exponents by reducing intermediate products modulo p.\n    \"\"\"\n    result = 1 % p\n    base = 2 % p\n    exponent = n\n    while exponent > 0:\n        if exponent & 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        exponent >>= 1\n    return result"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p using iterative exponentiation by squaring.\n    This method avoids floating point errors and handles large integers efficiently.\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if n == 0:\n        return 1 % p\n    result = 1\n    base = 2 % p\n    exp = n\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        exp >>= 1\n    return result"}
{"task_id": "HumanEval/50", "solution": "def encode_shift(s: str):\n    \"\"\"\n    Returns an encoded string by shifting every lowercase alphabetic character by 5 positions.\n    Characters wrap around the alphabet (e.g., 'z' shifted by 5 becomes 'e').\n    \"\"\"\n    return \"\".join([chr(((ord(ch) - ord(\"a\") + 5) % 26) + ord(\"a\")) for ch in s])\n\n\ndef decode_shift(s: str):\n    \"\"\"\n    Decodes a string that was encoded using the encode_shift function.\n    Each character is shifted back by 5 positions, with wrap-around.\n    \"\"\"\n    return \"\".join([chr(((ord(ch) - ord(\"a\") - 5) % 26) + ord(\"a\")) for ch in s])"}
{"task_id": "HumanEval/50", "solution": "def encode_shift(s: str):\n    \"\"\"\n    returns encoded string by shifting every character by 5 in the alphabet.\n    \"\"\"\n    return \"\".join([chr(((ord(ch) + 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])\n\ndef decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    # To decode, apply a negative shift (inverse of +5).\n    return \"\".join([chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])"}
