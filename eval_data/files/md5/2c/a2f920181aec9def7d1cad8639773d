``python\n# src/gcd_app/controllers.py\n\"\"\"Controllers for CLI and HTTP API interactions.\"\"\"\n\nimport logging\nfrom typing import List, Optional\nimport typer\nfrom fastapi import FastAPI, HTTPException, status\nfrom pydantic import BaseModel, Field\n\nfrom .services import GcdService\nfrom .exceptions import InvalidInputError, ComputationError\nfrom .utils import Validator\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"Handles Command-Line Interface requests for GCD computation.\"\"\"\n    def __init__(self, service: GcdService) -> None:\n        self._service = service\n        self._typer_app = typer.Typer()\n        self._typer_app.command()(self._run_command)\n\n    def _run_command(\n        self,\n        a: int = typer.Argument(..., help=\"First integer.\"),\n        b: int = typer.Argument(..., help=\"Second integer.\"),\n        algorithm: Optional[str] = typer.Option(\n            None, \"--algorithm\", \"-a\", help=\"Algorithm to use (euclidean or stein).\"\n        ),\n        enable_persistence: Optional[bool] = typer.Option(\n            None, \"--persist/--no-persist\", help=\"Enable/disable persistence for this run.\"\n        ),\n    ) -> None:\n        \"\"\"Computes the GCD of two integers and prints the result.\"\"\"\n        try:\n            if algorithm:\n                self._service.set_algorithm(algorithm)\n            if enable_persistence is not None:\n                self._service.set_persistence_enabled(enable_persistence)\n\n            result = self._service.compute(a, b)\n            typer.echo(f\"GCD({result.a}, {result.b}) = {result.gcd} (using {result.algorithm})\")\n            typer.Exit(code=0)\n        except InvalidInputError as e:\n            typer.echo(f\"Error: {e.message}\", err=True)\n            raise typer.Exit(code=2)\n        except ComputationError as e:\n            typer.echo(f\"Computation error: {e.message}\", err=True)\n            raise typer.Exit(code=1)\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            typer.echo(f\"An unexpected error occurred: {e}\", err=True)\n            raise typer.Exit(code=1)\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Entry point for the CLI application.\"\"\"\n        # Typer handles argv parsing internally if not provided\n        self._typer_app(prog_name=\"gcd-cli\")\n        return 0 # Typer exits itself via raise typer.Exit\n\n\nclass GcdRequest(BaseModel):\n    \"\"\"Pydantic model for the GCD HTTP request body.\"\"\"\n    a: int = Field(..., description=\"First integer operand.\")\n    b: int = Field(..., description=\"Second integer operand.\")\n    algorithm: Optional[str] = Field(None, description=\"Optional algorithm choice: 'euclidean' or 'stein'.\")\n\nclass ApiController:\n    \"\"\"Handles HTTP API requests for GCD computation.\"\"\"\n    def __init__(self, service: GcdService) -> None:\n        self._service = service\n\n    def create_routes(self, app: FastAPI) -> None:\n        \"\"\"Attaches API routes to the FastAPI application.\"\"\"\n        @app.post(\"/gcd\", summary=\"Compute the greatest common divisor\")\n        async def compute_gcd_endpoint(request: GcdRequest):\n            \"\"\"\n            Computes the greatest common divisor (GCD) of two integers.\n            The result is cached and optionally persisted.\n            \"\"\"\n            try:\n                # Temporarily change algorithm if specified in request\n                original_algorithm = self._service._algorithm_name # Access internal state for current algo\n                if request.algorithm:\n                    self._service.set_algorithm(request.algorithm)\n\n                result = self._service.compute(request.a, request.b)\n\n                # Revert algorithm if it was changed\n                if request.algorithm and request.algorithm != original_algorithm:\n                    self._service.set_algorithm(original_algorithm)\n\n                response_data = result.to_dict()\n                response_data[\"persisted\"] = self._service._persistence_enabled # Add persistence status\n                return response_data\n            except InvalidInputError as e:\n                logger.warning(\"Invalid input for /gcd: %s\", e.message)\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=f\"Invalid input: {e.message}\")\n            except ComputationError as e:\n                logger.error(\"Computation error for /gcd: %s\", e.message)\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"Computation error: {e.message}\")\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred processing /gcd request.\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"Internal server error: {e}\")\n```\n```python\n# src/gcd_app/adapters/http.py\n\"\"\"HTTP server adapter for the FastAPI application.\"\"\"\n\nimport logging\nfrom fastapi import FastAPI\nimport uvicorn\nfrom typing import Optional\n\nfrom .controllers import ApiController\nfrom .services import GcdService\nfrom .utils import LoggerConfig\nfrom .config import AppConfig\n\nlogger = logging.getLogger(__name__)\n\nclass HttpServer:\n    \"\"\"Factory and runner for the FastAPI application.\"\"\"\n\n    @staticmethod\n    def create_app(service: GcdService) -> FastAPI:\n        \"\"\"Creates and configures a FastAPI application instance.\"\"\"\n        app = FastAPI(\n            title=\"GCD Service\",\n            description=\"A robust service for computing the greatest common divisor.\",\n            version=\"0.1.0\",\n        )\n\n        # Attach API routes\n        api_controller = ApiController(service)\n        api_controller.create_routes(app)\n\n        # Optional: Add global exception handlers if not handled by individual routes\n        @app.exception_handler(Exception)\n        async def generic_exception_handler(request, exc):\n            logger.exception(\"Unhandled exception: %s\", exc)\n            return HTTPException(\n                status_code=500, detail=\"An unexpected server error occurred.\"\n            )\n\n        logger.info(\"FastAPI application created.\")\n        return app\n\n    @staticmethod\n    def run(\n        service: GcdService,\n        host: str = \"127.0.0.1\",\n        port: int = 8000,\n        log_level: str = AppConfig.LOG_LEVEL,\n    ) -> None:\n        \"\"\"Runs the FastAPI application using Uvicorn.\"\"\"\n        LoggerConfig.configure(log_level)\n        app = HttpServer.create_app(service)\n        logger.info(\"Starting Uvicorn server on http://%s:%d\", host, port)\n        uvicorn.run(app, host=host, port=port)\n```\n```python\n# src/gcd_app/main.py\n\"\"\"Application entrypoints and dependency wiring.\"\"\"\n\nimport logging\nfrom typing import List, Optional\nimport sys\n\nfrom fastapi import FastAPI\n\nfrom .config import AppConfig\nfrom .utils import LoggerConfig\nfrom .repository import GcdSqlRepository, GcdCacheRepository\nfrom .services import GcdService\nfrom .controllers import CLIController\nfrom .adapters.http import HttpServer\n\nlogger = logging.getLogger(__name__)\n\nclass Application:\n    \"\"\"Manages application startup, configuration, and dependency injection.\"\"\"\n    def __init__(self) -> None:\n        # Initialize logging early\n        LoggerConfig.configure(AppConfig.LOG_LEVEL)\n        logger.info(\"Application initializing...\")\n\n    def create_service(self, config: Optional[dict] = None) -> GcdService:\n        \"\"\"Constructs and returns a GcdService instance with its dependencies.\"\"\"\n        if config is None:\n            config = AppConfig.get_config_dict()\n\n        db_path = config.get(\"db_path\", AppConfig.DEFAULT_DB_PATH)\n        persistence_enabled = config.get(\"persistence_enabled\", AppConfig.PERSISTENCE_ENABLED)\n        algorithm_name = config.get(\"algorithm\", AppConfig.DEFAULT_ALGORITHM)\n        cache_size = config.get(\"cache_size\", AppConfig.DEFAULT_CACHE_SIZE)\n\n        logger.info(\"Creating GcdService with config: %s\", config)\n\n        repo = GcdSqlRepository(db_path=db_path)\n        repo.ensure_schema() # Ensure DB schema at service creation\n        cache = GcdCacheRepository(cache_size=cache_size)\n\n        service = GcdService(\n            algorithm_name=algorithm_name,\n            repo=repo,\n            cache=cache,\n            persistence_enabled=persistence_enabled,\n        )\n        return service\n\n    def cli_entrypoint(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Main entrypoint for the CLI application.\"\"\"\n        service = self.create_service()\n        cli_controller = CLIController(service=service)\n        \n        # Typer handles sys.argv by default, but we can pass it if needed for testing.\n        # However, typer's `app()` call itself does not return an int, it calls `sys.exit`.\n        # The design specification for FR2 (CLI) states \"exit 0\" or \"exit code != 0\".\n        # Typer's `run` or `app()` calls handle this automatically.\n        # CLIController.run is designed to be called by typer.\n        \n        # When called as a console script, typer directly replaces `sys.argv`\n        # and manages the process exit code. We just need to call its `run` method\n        # which internally uses typer.app().\n        \n        try:\n            # typer.run() directly invokes sys.exit()\n            cli_controller._typer_app(argv or sys.argv[1:]) \n            return 0 # This line might not be reached if typer exits\n        except Exception:\n            # Typer exits with appropriate codes on errors.\n            # If an unexpected error somehow bypasses typer's handlers,\n            # we'd reach here, but typer's design usually prevents that.\n            return 1\n\n    def asgi_app(self, config: Optional[dict] = None) -> FastAPI:\n        \"\"\"Creates and returns the FastAPI ASGI application.\"\"\"\n        service = self.create_service(config)\n        app = HttpServer.create_app(service)\n        return app\n\n# Global entrypoint for console script (poetry run gcd-cli)\ndef cli_entrypoint():\n    \"\"\"Wrapper function for CLI entry, called by pyproject.toml.\"\"\"\n    app_instance = Application()\n    app_instance.cli_entrypoint()\n\n# Global entrypoint for ASGI server (uvicorn src.gcd_app.main:asgi_app)\ndef asgi_app(config: Optional[dict] = None) -> FastAPI:\n    \"\"\"Wrapper function for ASGI entry, called by uvicorn.\"\"\"\n    app_instance = Application()\n    return app_instance.asgi_app(config)\n```"}
