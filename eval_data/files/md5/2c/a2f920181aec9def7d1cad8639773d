{"task_id": "HumanEval/14", "solution": "```python\n# src/prefixlib/__init__.py\n\"\"\"\nPrefixlib package exports.\nProvides a convenient top-level function `all_prefixes` and the main `PrefixService`.\n\"\"\"\nimport logging\nfrom typing import List, Optional\n\n# Dependencies for factory function, will be injected\nfrom .validators import StringValidator\nfrom .generators import PrefixGenerator\nfrom .services import PrefixService\n\n# Flask app factory (optional dependency)\ntry:\n    from flask import Flask\n    from .api import create_app as _create_app_factory\nexcept ImportError:\n    Flask = None\n    _create_app_factory = None\n\n# Initialize default service components\n_default_validator = StringValidator()\n_default_generator = PrefixGenerator()\n_default_service = PrefixService(validator=_default_validator, generator=_default_generator)\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"\n    Returns a list of all prefixes of the input string, from shortest to longest.\n    Validates input string for type and length.\n    \"\"\"\n    return _default_service.generate_prefixes(string)\n\n# Explicitly export key components\n__all__ = [\"all_prefixes\", \"PrefixService\", \"create_app\", \"ValidationError\", \"PrefixError\", \"DEFAULT_MAX_LENGTH\"]\n\n# Re-export exceptions and constants for easy access\nfrom .exceptions import ValidationError, PrefixError\nfrom .utils import DEFAULT_MAX_LENGTH\n\ndef create_app(config: Optional[dict] = None) -> \"Flask\":\n    \"\"\"\n    Flask application factory.\n    Raises ImportError if Flask is not installed.\n    \"\"\"\n    if _create_app_factory is None:\n        raise ImportError(\"Flask is not installed. Install with 'pip install Flask' to use the HTTP API.\")\n    return _create_app_factory(config)\n\n\n# src/prefixlib/main.py\n\"\"\"\nCLI entrypoint for the prefixes application.\nParses command-line arguments and orchestrates the CLIController.\n\"\"\"\nimport sys\nimport argparse\nimport json\nimport logging\nfrom typing import List, Optional\n\nfrom .controllers import CLIController\nfrom .services import PrefixService\nfrom .validators import StringValidator\nfrom .generators import PrefixGenerator\nfrom .exceptions import ValidationError\nfrom .utils import get_logger\n\nCLI_EXIT_SUCCESS = 0\nCLI_EXIT_VALIDATION_ERROR = 2\nCLI_EXIT_FAILURE = 1\n\nlogger = get_logger(__name__)\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main function for the CLI entrypoint.\n    Parses arguments, executes the CLIController, and returns an exit code.\n    \"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    parser = argparse.ArgumentParser(\n        description=\"Compute and display all prefixes of a string.\"\n    )\n    parser.add_argument(\n        \"string\",\n        type=str,\n        nargs='?', # make it optional to show usage on no args\n        help=\"The input string to compute prefixes for.\"\n    )\n    parser.add_argument(\n        \"-v\", \"--verbose\",\n        action=\"store_true\",\n        help=\"Enable verbose logging.\"\n    )\n\n    args = parser.parse_args(argv)\n\n    if args.verbose:\n        logging.basicConfig(level=logging.INFO)\n    else:\n        logging.basicConfig(level=logging.WARNING)\n\n    # Manual dependency injection for the CLI\n    validator = StringValidator()\n    generator = PrefixGenerator()\n    service = PrefixService(validator, generator)\n    controller = CLIController(service)\n\n    return controller.run(args.string)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n\n# src/prefixlib/controllers.py\n\"\"\"\nControllers for CLI and HTTP API.\nHandle request parsing, delegation to service, and response formatting.\n\"\"\"\nimport sys\nimport json\nimport logging\nfrom typing import List, Dict, Any, Tuple, Optional\n\nfrom .services import PrefixService\nfrom .dto import PrefixRequest, PrefixResponse\nfrom .exceptions import ValidationError\nfrom .utils import get_logger\n\n# Optional Flask dependency for ApiController\ntry:\n    from flask import Flask, request, jsonify\n    from werkzeug.wrappers import Response as FlaskResponse\nexcept ImportError:\n    Flask = None\n    request = None\n    jsonify = None\n    FlaskResponse = None # type: ignore\n\nlogger = get_logger(__name__)\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface interactions.\n    Parses arguments, calls PrefixService, and prints formatted output to stdout/stderr.\n    \"\"\"\n    def __init__(self, service: PrefixService) -> None:\n        self._service = service\n\n    def run(self, input_string: Optional[str]) -> int:\n        \"\"\"\n        Executes the CLI logic.\n        Returns an exit code (0 for success, 1 for general error, 2 for validation error).\n        \"\"\"\n        if input_string is None:\n            print(\"Usage: prefixes <string>\", file=sys.stderr, flush=True)\n            return 2 # argparse already handles this gracefully, but an explicit check is safer\n\n        try:\n            prefixes = self._service.generate_prefixes(input_string)\n            print(self._format_output(prefixes))\n            return 0\n        except ValidationError as e:\n            logger.error(f\"Validation Error: {e}\")\n            print(f\"Error: {e}\", file=sys.stderr, flush=True)\n            return 2\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(\"An internal error occurred.\", file=sys.stderr, flush=True)\n            return 1\n\n    def _format_output(self, prefixes: List[str]) -> str:\n        \"\"\"\n        Formats the list of prefixes into a JSON string.\n        \"\"\"\n        response_dto = PrefixResponse(prefixes=prefixes)\n        return json.dumps(response_dto.to_dict(), ensure_ascii=False)\n\n\nif Flask:\n    class ApiController:\n        \"\"\"\n        Handles HTTP API interactions using Flask.\n        Parses JSON requests, calls PrefixService, and returns JSON responses.\n        \"\"\"\n        def __init__(self, service: PrefixService) -> None:\n            self._service = service\n\n        def register_routes(self, app: Flask) -> None:\n            \"\"\"\n            Registers the /prefixes POST route with the given Flask app.\n            \"\"\"\n            app.add_url_rule(\"/prefixes\", \"handle_prefixes\", self.handle_prefixes, methods=[\"POST\"])\n\n        def handle_prefixes(self) -> Tuple[FlaskResponse, int]:\n            \"\"\"\n            HTTP POST /prefixes endpoint handler.\n            Processes request, calls service, and returns JSON response with status code.\n            \"\"\"\n            try:\n                if not request.is_json:\n                    return jsonify({\"error\": \"Content-Type must be application/json\"}), 400\n\n                data = request.get_json()\n                if not isinstance(data, dict):\n                    return jsonify({\"error\": \"Request body must be a JSON object\"}), 400\n\n                request_dto = PrefixRequest.from_dict(data)\n                prefixes = self._service.generate_prefixes(request_dto.input)\n                response_dto = PrefixResponse(prefixes=prefixes)\n                return jsonify(response_dto.to_dict()), 200\n\n            except ValidationError as e:\n                logger.warning(f\"API Validation Error (400): {e}\")\n                return jsonify({\"error\": str(e)}), 400\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred during API request processing (500).\")\n                return jsonify({\"error\": \"Internal server error\"}), 500\nelse:\n    class ApiController: # type: ignore\n        def __init__(self, service: PrefixService) -> None:\n            logger.warning(\"Flask not available, ApiController functionality will be disabled.\")\n            self._service = service\n        def register_routes(self, app: \"Flask\") -> None:\n            logger.warning(\"Flask not available, cannot register API routes.\")\n        def handle_prefixes(self) -> Tuple[Any, int]:\n            return jsonify({\"error\": \"API not available (Flask not installed)\"}), 503\n\n\n# src/prefixlib/services.py\n\"\"\"\nApplication layer service orchestrating validation and prefix generation.\n\"\"\"\nimport logging\nfrom typing import List\n\nfrom .validators import StringValidator\nfrom .generators import PrefixGenerator\nfrom .exceptions import PrefixError, ValidationError\nfrom .utils import get_logger\n\nlogger = get_logger(__name__)\n\nclass PrefixService:\n    \"\"\"\n    Coordinates string validation and prefix generation.\n    This is the core business logic layer.\n    \"\"\"\n    def __init__(self, validator: StringValidator, generator: PrefixGenerator) -> None:\n        self._validator = validator\n        self._generator = generator\n\n    def generate_prefixes(self, string: str) -> List[str]:\n        \"\"\"\n        Validates the input string and generates its prefixes.\n        Raises ValidationError for invalid inputs.\n        \"\"\"\n        logger.debug(f\"PrefixService.generate_prefixes called with string length: {len(str(string)) if string is not None else 'None'}\")\n        self._validator.validate(string) # Validation happens first\n\n        try:\n            return self._generator.generate(string)\n        except Exception as e:\n            # Wrap unexpected errors from generator in a domain-specific exception\n            logger.exception(\"Error during prefix generation.\")\n            raise PrefixError(\"Failed to generate prefixes due to an internal error.\") from e\n\n\n# src/prefixlib/generators.py\n\"\"\"\nContains the core logic for generating string prefixes.\nProvides both list and iterator based methods.\n\"\"\"\nfrom typing import List, Iterator\n\nclass PrefixGenerator:\n    \"\"\"\n    Pure logic for computing all prefixes of a string.\n    Stateless and side-effect free.\n    \"\"\"\n    @staticmethod\n    def generate(string: str) -> List[str]:\n        \"\"\"\n        Returns a list of all prefixes of `string`, from shortest to longest.\n        Example: generate(\"abc\") -> [\"a\", \"ab\", \"abc\"]\n        \"\"\"\n        return [string[:i] for i in range(1, len(string) + 1)]\n\n    @staticmethod\n    def generate_iter(string: str) -> Iterator[str]:\n        \"\"\"\n        Yields prefixes of `string` one by one, from shortest to longest.\n        Useful for large strings to avoid materializing the entire list in memory.\n        \"\"\"\n        for i in range(1, len(string) + 1):\n            yield string[:i]\n\n\n# src/prefixlib/validators.py\n\"\"\"\nInput validation for strings, including type and length checks.\n\"\"\"\nimport logging\nfrom typing import Any\n\nfrom .exceptions import ValidationError\nfrom .utils import DEFAULT_MAX_LENGTH, get_logger\n\nlogger = get_logger(__name__)\n\nclass StringValidator:\n    \"\"\"\n    Validates string inputs based on predefined rules like type and maximum length.\n    \"\"\"\n    def __init__(self, max_length: int = DEFAULT_MAX_LENGTH) -> None:\n        \"\"\"\n        Initializes the validator with a maximum allowed string length.\n        \"\"\"\n        if not isinstance(max_length, int) or max_length <= 0:\n            logger.error(f\"Invalid max_length provided: {max_length}. Using default {DEFAULT_MAX_LENGTH}.\")\n            self._max_length = DEFAULT_MAX_LENGTH\n        else:\n            self._max_length = max_length\n        logger.debug(f\"StringValidator initialized with max_length: {self._max_length}\")\n\n    def validate(self, string: Any) -> None:\n        \"\"\"\n        Validates the input. Raises ValidationError if the input is:\n        - None\n        - Not an instance of str\n        - Longer than the configured max_length\n        \"\"\"\n        if string is None:\n            logger.warning(\"Validation failed: input is None.\")\n            raise ValidationError(\"Input cannot be None.\")\n        if not isinstance(string, str):\n            logger.warning(f\"Validation failed: input type is {type(string).__name__}, expected str.\")\n            raise ValidationError(\"Input must be a string.\")\n        if len(string) > self._max_length:\n            logger.warning(f\"Validation failed: input length {len(string)} exceeds max length {self._max_length}.\")\n            raise ValidationError(f\"Input string length ({len(string)}) exceeds maximum allowed length ({self._max_length}).\")\n\n\n# src/prefixlib/dto.py\n\"\"\"\nData Transfer Objects (DTOs) for API request and response bodies.\n\"\"\"\nfrom typing import List, Dict, Any, Type, TypeVar\n\n# A generic type variable for class methods\nT = TypeVar('T', bound='PrefixRequest')\n\nclass PrefixRequest:\n    \"\"\"\n    DTO for incoming API requests for prefix generation.\n    Expected JSON format: {\"input\": \"<string>\"}\n    \"\"\"\n    def __init__(self, input: str) -> None:\n        self.input = input\n\n    @classmethod\n    def from_dict(cls: Type[T], d: Dict[str, Any]) -> T:\n        \"\"\"\n        Creates a PrefixRequest instance from a dictionary.\n        Performs basic dictionary shape validation.\n        \"\"\"\n        input_str = d.get(\"input\")\n        if input_str is None:\n            raise ValidationError(\"Missing 'input' field in request body.\")\n        if not isinstance(input_str, str):\n            raise ValidationError(\"'input' field must be a string.\")\n        return cls(input=input_str)\n\nclass PrefixResponse:\n    \"\"\"\n    DTO for outgoing API responses containing generated prefixes.\n    Returns JSON format: {\"prefixes\": [...]}\n    \"\"\"\n    def __init__(self, prefixes: List[str]) -> None:\n        self.prefixes = prefixes\n\n    def to_dict(self) -> Dict[str, List[str]]:\n        \"\"\"\n        Converts the PrefixResponse instance to a dictionary for JSON serialization.\n        \"\"\"\n        return {\"prefixes\": self.prefixes}\n\n\n# src/prefixlib/exceptions.py\n\"\"\"\nCustom exception classes for domain-specific errors.\n\"\"\"\n\nclass PrefixError(Exception):\n    \"\"\"Base exception for all prefixlib errors.\"\"\"\n    pass\n\nclass ValidationError(PrefixError, ValueError):\n    \"\"\"\n    Exception raised for invalid input data.\n    Inherits from ValueError and PrefixError for broader exception handling.\n    \"\"\"\n    pass\n\n\n# src/prefixlib/utils.py\n\"\"\"\nUtility functions and configuration constants.\n\"\"\"\nimport logging\nimport os\n\nDEFAULT_MAX_LENGTH: int = 1_000_000 # Default maximum string length to prevent DoS\n\ndef get_logger(name: str) -> logging.Logger:\n    \"\"\"\n    Configures and returns a logger instance.\n    Sets basic configuration if not already configured.\n    \"\"\"\n    logger = logging.getLogger(name)\n    # Configure root logger if not already configured\n    if not logging.root.handlers:\n        logging.basicConfig(level=os.environ.get(\"LOG_LEVEL\", \"INFO\").upper(),\n                            format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    return logger\n\n\n# src/prefixlib/api.py\n\"\"\"\nFlask application factory for the HTTP API.\n\"\"\"\nimport logging\nfrom typing import Optional, Dict, Any\n\n# Flask is an optional dependency\ntry:\n    from flask import Flask\nexcept ImportError:\n    Flask = None\n    logging.warning(\"Flask not installed. HTTP API functionality will be disabled.\")\n\nfrom .controllers import ApiController\nfrom .services import PrefixService\nfrom .validators import StringValidator\nfrom .generators import PrefixGenerator\nfrom .utils import get_logger\n\nlogger = get_logger(__name__)\n\ndef create_app(config: Optional[Dict[str, Any]] = None) -> Flask:\n    \"\"\"\n    Creates and configures a Flask application instance.\n    Injects dependencies into the ApiController.\n    \"\"\"\n    if Flask is None:\n        raise ImportError(\"Flask is required to run the HTTP API. Please install it (e.g., pip install Flask).\")\n\n    app = Flask(__name__)\n    app.config.from_mapping(config or {})\n\n    # Initialize components and inject into controller\n    validator = StringValidator()\n    generator = PrefixGenerator()\n    service = PrefixService(validator, generator)\n    controller = ApiController(service)\n\n    # Register routes with the Flask app\n    controller.register_routes(app)\n\n    logger.info(\"Flask app created and routes registered.\")\n    return app\n\nif __name__ == \"__main__\":\n    # Example for local development\n    # To run: python -m prefixlib.api\n    # Then access with: curl -X POST -H \"Content-Type: application/json\" -d '{\"input\": \"hello\"}' http://127.0.0.1:5000/prefixes\n    app = create_app()\n    app.run(debug=True, port=5000)\n\n```\n```toml\n# pyproject.toml\n[tool.poetry]\nname = \"prefixlib\"\nversion = \"0.1.0\"\ndescription = \"A Python library to compute all prefixes of a string.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{include = \"prefixlib\", from = \"src\"}]\nrepository = \"https://github.com/yourusername/prefixlib\"\nkeywords = [\"string-processing\", \"prefixes\", \"library\", \"cli\", \"api\"]\n\n[tool.poetry.dependencies]\npython = \">=3.8.1,<4.0\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.0.0\"\nflake8 = \"^7.0.0\"\nblack = \"^24.0.0\"\n\n[tool.poetry.group.http_api.dependencies]\nFlask = \"^3.0.0\"\n\n[tool.poetry.scripts]\nprefixes = \"prefixlib.main:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.pytest.ini_options]\nmin_version = \"6.0\"\naddopts = \"--strict-markers --strict-config --cov=src/prefixlib --cov-report=term-missing\"\ntestpaths = [\n    \"tests\",\n]\n\n[tool.black]\nline-length = 120\ntarget-version = ['py38']\n```\n```text\n# requirements.txt\n# This file is for users who prefer pip over Poetry.\n# Install with: pip install -r requirements.txt\n# For HTTP API functionality, also install: pip install Flask\n\n# Core dependencies\n# No direct core runtime dependencies other than standard library for this package\n\n# Optional HTTP API dependencies\n# Flask==3.0.3 # Uncomment if Flask is needed for the HTTP API\n\n# Development dependencies (for running tests, linting, etc.)\npytest==8.0.0\nflake8==7.0.0\nblack==24.1.1\n```\n```markdown\n# README.md\n# Prefixlib: String Prefix Computation Library\n\n`prefixlib` is a reliable, well-tested Python library to compute all prefixes of a string from shortest to longest. It exposes functionality as a library API, a command-line interface (CLI), and a minimal HTTP API.\n\n## Features\n\n- **Library API**: Easily integrate prefix computation into your Python applications.\n- **Command-Line Interface (CLI)**: Quickly get prefixes from your terminal.\n- **HTTP API**: A minimal RESTful endpoint for integrations and testing.\n- **Robust Validation**: Handles invalid inputs gracefully with clear error messages.\n- **Performance**: Efficiently computes prefixes with configurable maximum string length to prevent resource exhaustion.\n- **Python 3.8+ Support**: Built for modern Python environments.\n\n## Installation\n\nYou can install `prefixlib` using pip:\n\n```bash\npip install prefixlib\n```\n\nTo enable the HTTP API, you will also need to install Flask:\n\n```bash\npip install \"prefixlib[http_api]\"\n# or manually\npip install Flask\n```\n\n## Usage\n\n### Library API\n\nImport `all_prefixes` and use it directly:\n\n```python\nfrom prefixlib import all_prefixes, ValidationError\n\ntry:\n    result = all_prefixes(\"example\")\n    print(result) # Output: ['e', 'ex', 'exa', 'exam', 'examp', 'example']\n\n    result_empty = all_prefixes(\"\")\n    print(result_empty) # Output: []\n\n    # Example of invalid input\n    all_prefixes(123)\nexcept ValidationError as e:\n    print(f\"Error: {e}\") # Output: Error: Input must be a string.\n```\n\n### Command-Line Interface (CLI)\n\nUse the `prefixes` command directly from your terminal:\n\n```bash\nprefixes \"hello world\"\n```\nOutput:\n```json\n{\"prefixes\": [\"h\", \"he\", \"hel\", \"hell\", \"hello\", \"hello \", \"hello w\", \"hello wo\", \"hello wor\", \"hello worl\", \"hello world\"]}\n```\n\nFor invalid input:\n```bash\nprefixes\n```\nOutput:\n```\nUsage: prefixes <string>\n```\n\n```bash\nprefixes \"\"\n```\nOutput:\n```json\n{\"prefixes\": []}\n```\n\n### HTTP API\n\nStart the Flask server (requires `Flask` to be installed):\n\n```bash\npython -m prefixlib.api\n```\n\nThe server will typically run on `http://127.0.0.1:5000`.\n\nYou can then send POST requests to the `/prefixes` endpoint:\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"input\": \"test\"}' http://127.0.0.1:5000/prefixes\n```\nOutput:\n```json\n{\"prefixes\":[\"t\",\"te\",\"tes\",\"test\"]}\n```\n\nFor invalid input:\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"input\": null}' http://127.0.0.1:5000/prefixes\n```\nOutput:\n```json\n{\"error\":\"Input cannot be None.\"}\n```\n\n## Development and Testing\n\n### Running Tests\n\nThis project uses `pytest` for testing. You can run tests after installing development dependencies:\n\n```bash\npip install poetry # if not using poetry already\npoetry install --with dev,http_api\npoetry run pytest\n```\n(Or `pip install -r requirements.txt` and then `pytest` if not using poetry)\n\n## Design and Architecture\n\nThe library is structured into modular layers:\n\n- **Presentation**: `CLIController`, `ApiController` for user/integrator interaction.\n- **Application/Service**: `PrefixService` orchestrates validation and generation.\n- **Domain/Utility**: `PrefixGenerator` (pure logic), `StringValidator` (policy enforcement).\n- **Cross-cutting**: `exceptions`, `utils` (logging, config).\n\n## Configuration\n\nThe maximum allowed string length for prefix computation is configurable via the `StringValidator` or using the `DEFAULT_MAX_LENGTH` constant in 