es import PrimeRepository\n\n# Path to the cli_entrypoint script\nCLI_SCRIPT = \"primefactor\"\n\ndef run_cli(args, expected_exit_code=0, input_n=None):\n    \"\"\"Helper to run the CLI command and capture output.\"\"\"\n    command = [CLI_SCRIPT] + args\n    if input_n is not None:\n        command = [CLI_SCRIPT, \"factorize\", str(input_n)] + args\n    \n    process = subprocess.run(\n        command,\n        capture_output=True,\n        text=True,\n        check=False # Don't raise CalledProcessError for non-zero exit codes\n    )\n    assert process.returncode == expected_exit_code, \\\n        f\"Expected exit code {expected_exit_code}, got {process.returncode}. \" \\\n        f\"Stdout: '{process.stdout}', Stderr: '{process.stderr}'\"\n    return process.stdout.strip(), process.stderr.strip()\n\ndef test_cli_help():\n    \"\"\"Test CLI help message.\"\"\"\n    stdout, stderr = run_cli([\"--help\"])\n    assert \"usage: primefactor\" in stdout\n    assert \"Available commands\" in stdout\n    assert not stderr\n\n    stdout, stderr = run_cli([\"factorize\", \"--help\"])\n    assert \"usage: primefactor factorize\" in stdout\n    assert \"positional arguments:\" in stdout\n    assert \"--cache\" in stdout\n    assert \"--no-cache\" in stdout\n    assert not stderr\n\ndef test_cli_success():\n    \"\"\"Test CLI factorization for valid input.\"\"\"\n    stdout, stderr = run_cli([\"factorize\", \"70\"])\n    assert json.loads(stdout) == [2, 5, 7]\n    assert not stderr\n\n    stdout, stderr = run_cli([\"factorize\", \"8\"])\n    assert json.loads(stdout) == [2, 2, 2]\n    assert not stderr\n\ndef test_cli_invalid_input():\n    \"\"\"Test CLI handles invalid input and returns non-zero exit code.\"\"\"\n    stdout, stderr = run_cli([\"factorize\", \"1\"], expected_exit_code=2)\n    assert not stdout\n    assert \"Error: n must be integer >= 2, got: 1\" in stderr\n\n    stdout, stderr = run_cli([\"factorize\", \"0\"], expected_exit_code=2)\n    assert not stdout\n  