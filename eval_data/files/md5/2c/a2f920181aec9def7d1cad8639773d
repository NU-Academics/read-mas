{"task_id": "HumanEval/43", "solution": "```python\n# The following code block implements the `pairs_sum_to_zero` function\n# strictly adhering to the \"CRITICAL REQUIREMENTS\" section of the prompt.\n# It is a bare function, with no class wrapper, no external calls not defined\n# within this block, and minimal internal validation or error handling.\n\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    It returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    seen = set()\n    zero_count = 0\n    for x in l:\n        if x == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                return True\n        if -x in seen:\n            return True\n        seen.add(x)\n    return False\n\n```\n```python\n# src/pairs_sum/exceptions.py\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\nclass ControllerError(Exception):\n    \"\"\"Exception raised for issues within the controller layer.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for issues within the repository layer.\"\"\"\n    pass\n\n```\n```python\n# src/pairs_sum/config.py\n\nclass AppConfig:\n    \"\"\"Central configuration values for the application.\"\"\"\n    DEFAULT_ENCODING: str = \"utf-8\"\n\n```\n```python\n# src/pairs_sum/models.py\n\nfrom typing import Optional\n\nclass PairResult:\n    \"\"\"Data model to hold the result and details of a pair sum operation.\"\"\"\n    def __init__(self, result: bool, a: Optional[int] = None, b: Optional[int] = None) -> None:\n        self.result = result\n        self.a = a\n        self.b = b\n\n```\n```python\n# src/pairs_sum/validator.py\n\nfrom typing import Sequence\nfrom .exceptions import ValidationError\n\nclass Validator:\n    \"\"\"Validates input sequences for numerical integrity.\"\"\"\n    def validate_numbers(self, numbers: Sequence[int]) -> None:\n        \"\"\"\n        Checks if the input is an iterable of integers, raising ValidationError if not.\n        Specifically treats booleans as invalid, even though they are technically ints.\n        \"\"\"\n        if not hasattr(numbers, \"__iter__\"):\n            raise ValidationError(\"Input must be an iterable (e.g., list, tuple) of integers.\")\n        \n        for i, v in enumerate(numbers):\n            if not isinstance(v, int) or isinstance(v, bool):\n                raise ValidationError(f\"Element at index {i} is not a valid integer: {v!r}.\")\n\n```\n```python\n# src/pairs_sum/repository.py\n\nimport json\nfrom typing import List, Sequence\nfrom .config import AppConfig\nfrom .exceptions import RepositoryError\n\nclass ListRepository:\n    \"\"\"Repository for storing and loading lists of integers, with optional JSON persistence.\"\"\"\n    def __init__(self) -> None:\n        self._numbers: List[int] = []\n\n    def store(self, numbers: Sequence[int]) -> None:\n        \"\"\"Stores a copy of the given sequence of numbers in memory.\"\"\"\n        self._numbers = list(numbers)\n\n    def get_all(self) -> Sequence[int]:\n        \"\"\"Returns the currently stored sequence of numbers.\"\"\"\n        return self._numbers\n\n    def load_from_json(self, path: str) -> None:\n        \"\"\"Loads numbers from a JSON array in the specified file.\"\"\"\n        try:\n            with open(path, \"r\", encoding=AppConfig.DEFAULT_ENCODING) as f:\n                data = json.load(f)\n            if not isinstance(data, list):\n                raise RepositoryError(\"JSON file must contain a top-level list.\")\n            for i, item in enumerate(data):\n                if not isinstance(item, int) or isinstance(item, bool):\n                    raise RepositoryError(f\"JSON list contains non-integer element at index {i}: {item!r}.\")\n            self._numbers = data\n        except (IOError, json.JSONDecodeError) as e:\n            raise RepositoryError(f\"Failed to load from JSON file '{path}': {e}\") from e\n\n    def save_to_json(self, path: str) -> None:\n        \"\"\"Writes the currently stored numbers to a JSON file.\"\"\"\n        try:\n            with open(path, \"w\", encoding=AppConfig.DEFAULT_ENCODING) as f:\n                json.dump(self._numbers, f, indent=2)\n        except IOError as e:\n            raise RepositoryError(f\"Failed to save to JSON file '{path}': {e}\") from e\n\n```\n```python\n# src/pairs_sum/service.py\n\nfrom typing import Sequence, Set, Optional, Tuple\nfrom .models import PairResult\n\nclass PairService:\n    \"\"\"Core business logic for finding pairs that sum to zero.\"\"\"\n\n    def find_pair_sum_zero(self, numbers: Sequence[int]) -> bool:\n        \"\"\"\n        Determines if two distinct elements in the sequence sum to zero.\n        Uses an O(n) algorithm with a set for efficient lookups.\n        \"\"\"\n        result, _, _ = self._find_with_set(numbers)\n        return result\n\n    def find_pair_details(self, numbers: Sequence[int]) -> PairResult:\n        \"\"\"\n        Finds two distinct elements that sum to zero, returning details in a PairResult object.\n        This provides more information than just a boolean, useful for internal calls.\n        \"\"\"\n        found, a, b = self._find_with_set(numbers)\n        return PairResult(found, a, b)\n\n    def _find_with_set(self, numbers: Sequence[int]) -> Tuple[bool, Optional[int], Optional[int]]:\n        \"\"\"\n        Internal implementation to find a pair summing to zero using a set.\n        Returns a tuple (found_pair: bool, element_a: Optional[int], element_b: Optional[int]).\n        \"\"\"\n        seen: Set[int] = set()\n        zero_count = 0\n        for x in numbers:\n            if x == 0:\n                zero_count += 1\n                if zero_count >= 2:\n                    return True, 0, 0\n            \n            complement = -x\n            if complement in seen:\n                return True, x, complement\n            \n            seen.add(x)\n        return False, None, None\n\n```\n```python\n# src/pairs_sum/controller.py\n\nfrom typing import Sequence\nfrom .service import PairService\nfrom .validator import Validator\nfrom .exceptions import ValidationError, ControllerError\n\nclass PairController:\n    \"\"\"Public API controller for checking number pairs, handling validation and delegation.\"\"\"\n    def __init__(self, service: PairService, validator: Validator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def pairs_sum_to_zero(self, numbers: Sequence[int]) -> bool:\n        \"\"\"\n        Validates the input and delegates to the PairService to determine if\n        any two distinct numbers sum to zero.\n        \"\"\"\n        try:\n            self.validator.validate_numbers(numbers)\n            return self.service.find_pair_sum_zero(numbers)\n        except ValidationError:\n            raise\n        except Exception as e:\n            raise ControllerError(f\"An unexpected error occurred in the controller: {e}\") from e\n\n```\n```python\n# src/pairs_sum/utils.py\n\nimport re\nfrom typing import List\nfrom .exceptions import ValidationError\n\ndef parse_cli_input(text: str) -> List[int]:\n    \"\"\"\n    Parses a string input from the CLI into a list of integers.\n    Supports space, comma, or Python-list-like formats.\n    \"\"\"\n    if text.startswith('[') and text.endswith(']'):\n        text = text[1:-1]\n    \n    parts = re.split(r'[, ]\\s*', text.strip())\n    \n    numbers: List[int] = []\n    for part in parts:\n        if not part:\n            continue\n        try:\n            num = int(part)\n            numbers.append(num)\n        except ValueError as e:\n            raise ValidationError(f\"Invalid number format in CLI input: '{part}'\") from e\n    return numbers\n\n```\n```python\n# src/pairs_sum/cli.py\n\nimport sys\nfrom typing import Sequence, List\nfrom .controller import PairController\nfrom .service import PairService\nfrom .validator import Validator\nfrom .utils import parse_cli_input\nfrom .exceptions import ValidationError, ControllerError\n\ndef main(argv: Sequence[str] = sys.argv) -> int:\n    \"\"\"\n    CLI entrypoint for the pairs-sum-zero command.\n    Parses arguments, calls the PairController, and prints the result.\n    \"\"\"\n    if len(argv) < 2:\n        print(\"Usage: pairs-sum-zero <numbers...>\", file=sys.stderr)\n        print(\"Example: pairs-sum-zero 1 2 -1\", file=sys.stderr)\n        print(\"Example: pairs-sum-zero \\\"1, 2, -1\\\"\", file=sys.stderr)\n        print(\"Example: pairs-sum-zero \\\"[1 2 -1]\\\"\", file=sys.stderr)\n        return 2\n\n    raw_input_str = \" \".join(argv[1:])\n\n    try:\n        numbers: List[int] = parse_cli_input(raw_input_str)\n        \n        service = PairService()\n        validator = Validator()\n        controller = PairController(service, validator)\n        \n        result = controller.pairs_sum_to_zero(numbers)\n        print(\"True\" if result else \"False\")\n        return 0\n    except (ValidationError, ControllerError) as e:\n        print(f\"Error: {e}\", file=sys.stderr)\n        return 1\n    except Exception as e:\n        print(f\"An unexpected internal error occurred: {e}\", file=sys.stderr)\n        return 1\n\n```\n```python\n# src/pairs_sum/__init__.py\n\n# Export the standalone convenience function (with type hints for library usage)\nfrom typing import List, Sequence, Set\n\ndef pairs_sum_to_zero(l: Sequence[int]) -> bool:\n    \"\"\"\n    pairs_sum_to_zero takes a sequence of integers as an input.\n    It returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    seen: Set[int] = set()\n    zero_count = 0\n    for x in l:\n        if x == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                return True\n        if -x in seen:\n            return True\n        seen.add(x)\n    return False\n\n# Export classes for dependency injection and broader use\nfrom .controller import PairController\nfrom .service import PairService\nfrom .repository import ListRepository\nfrom .validator import Validator\nfrom .exceptions import ValidationError, ControllerError, RepositoryError\nfrom .models import PairResult\nfrom .config import AppConfig\n\n__all__ = [\n    \"pairs_sum_to_zero\",\n    \"PairController\",\n    \"PairService\",\n    \"ListRepository\",\n    \"Validator\",\n    \"ValidationError\",\n    \"ControllerError\",\n    \"RepositoryError\",\n    \"PairResult\",\n    \"AppConfig\",\n]\n\n```\n```toml\n# pyproject.toml\n\n[project]\nname = \"pairs-sum-zero\"\nversion = \"0.1.0\"\ndescription = \"Python library and CLI to find if two distinct elements in a list sum to zero.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"algorithm\", \"sum-zero\", \"pair-finding\", \"cli\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.8\",\n    \"Programming Language :: 3.9\",\n    \"Programming Language :: 3.10\",\n    \"Programming Language :: 3.11\",\n    \"Programming Language :: 3.12\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/pairs-sum-zero\"\n\"Bug Tracker\" = \"https://github.com/yourusername/pairs-sum-zero/issues\"\n\n[project.dependencies]\n# No runtime dependencies beyond standard library\n\n[project.scripts]\npairs-sum-zero = \"pairs_sum.cli:main\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\nminversion = \"6.