berEntry]:\n            raise ValueError(\"Simulated repository error\")\n\n    service = SpecialFilterService(BadRepo())\n    with pytest.raises(ServiceError, match=\"Internal error calculating candidates\"):\n        service.count_candidates()\n```\n\n```python\n# tests/test_controller.py\n\"\"\"Unit tests for the CLIController.\"\"\"\n\nimport pytest\n\nfrom src.specialfilter.controller import CLIController\nfrom src.specialfilter.exceptions import ServiceError, ValidationError\nfrom src.specialfilter.repository import NumberRepository\nfrom src.specialfilter.service import SpecialFilterService\nfrom src.specialfilter.validators import InputValidator\n\n\n# Mock dependencies for CLIController\nclass MockInputValidator(InputValidator):\n    def validate_and_coerce_numbers(self, nums):\n        if \"bad\" in nums:\n            raise ValidationError(\"Mock validation error\")\n        return [int(float(x)) if isinstance(x, str) and \".\" in x else int(x) for x in nums]\n\n\nclass MockNumberRepository(NumberRepository):\n    def __init__(self, numbers):\n        super().__init__(numbers)\n\n\nclass MockSpecialFilterService(SpecialFilterService):\n    def __init__(self, repo):\n        super().__init__(repo)\n        self.count_called = 0\n\n    def count_candidates(self) -> int:\n        self.count_called += 1\n        # Return a predictable count based on number of valid candidates\n        # For simplicity, let's just count numbers > 10\n        # For a more robust mock, we could pre-set a return value\n        return sum(1 for entry in self._repo.all() if entry.value > 10)\n\n\n@pytest.fixture\ndef controller_with_mocks():\n    \"\"\"Provides a CLIController instance with mocked dependencies.\"\"\"\n    # Temporarily replace classes with mocks\n    original_validator = InputValidator\n    original_repository = NumberRepository\n    original_service = SpecialFilterService\n\n    InputValidator.__bases__ = (MockInputValidator,)\n    NumberRepository.__bases__ = (MockNumberRepository,)\n    SpecialFilterService.__bases__ = (MockSpecialFilterService,)\n\n    # Create controller, it will use the mocked classes\n    controller = CLIController()\n\n    # Restore original classes after test\n    yield controller\n\n    InputValidator.__bases__ = (original_validator.__bases__[0],)\n    NumberRepository.__bases__ = (original_repository.__bases__[0],)\n    SpecialFilterService.__bases__ = (original_service.__bases__[0],)\n\n\n@pytest.fixture\ndef controller():\n    \"\"\"Provides a CLIController instance with real dependencies.\"\"\"\n    return CLIController()\n\n\n@pytest.mark.parametrize(\n    \"input_nums, expected_count\",\n    [\n        ([15, -73, 14, -15], 1),\n        ([33, -2, -3, 45, 21, 109], 2),\n        ([\"15\", \"33\", \"109\"], 3),  # Validate strings\n        ([11, 13, 15], 3),\n        ([], 0),\n    ],\n)\ndef test_special_filter_success(\n    controller: CLIController, input_nums: list, expected_count: int\n):\n    \"\"\"Test special_filter method with valid inputs and expected counts.\"\"\"\n    assert controller.special_filter(input_nums) == expected_count\n\n\n@pytest.mark.parametrize(\n    \"input_nums, expected_error_msg\",\n    [\n        ([1, \"abc\"], \"Invalid element: 'abc'\"),\n        ([1.5], \"Invalid element: 1.5\"),\n        ([\"not a number\"], \"Invalid element: 'not a number'\"),\n    ],\n)\ndef test_special_filter_validation_error(\n    controller: CLIController, input_nums: list, expected_error_msg: str\n):\n    \"\"\"Test special_filter raises ValidationError for invalid inputs.\"\"\"\n    with pytest.raises(ValidationError, match=expected_error_msg):\n        controller.special_filter(input_nums)\n\n\ndef test_special_filter_service_error(mocker):\n    \"\"\"Test special_filter propagates ServiceError.\"\"\"\n    # Mock SpecialFilterService.count_candidates to raise ServiceError\n    mocker.patch.object(\n        SpecialFilterService,\n        \"count_candidates\",\n        side_effect=ServiceE