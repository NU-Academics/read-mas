{"task_id": "HumanEval/105", "solution": "```python\ndef by_length(arr):\n    # CRITICAL: LIMIT doc strings and code comments to at most 2 sentences.\n    \"\"\"\n    Transforms an array of integers by filtering 1-9, sorting, reversing,\n    and mapping to English names. Non-digit values are ignored.\n    \"\"\"\n\n    # CRITICAL: Do NOT call helper functions or utilities that are not defined in the same code block.\n    # DIGIT_NAME_MAP and _coerce_to_int are defined inline as required.\n    DIGIT_NAME_MAP = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # CRITICAL: Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\n    def _coerce_to_int(value):\n        try:\n            return int(value)\n        except (ValueError, TypeError):\n            return None\n\n    filtered_digits = []\n    # Trust the caller's inputs for 'arr' being iterable.\n    for item in arr:\n        n = _coerce_to_int(item)\n        if n is not None and 1 <= n <= 9:\n            filtered_digits.append(n)\n\n    # Sort the valid digits in ascending order.\n    sorted_digits = sorted(filtered_digits)\n\n    # Reverse the sorted list to get descending order.\n    reversed_sorted_digits = list(reversed(sorted_digits))\n\n    # Map each digit to its corresponding English name.\n    result_names = [DIGIT_NAME_MAP[d] for d in reversed_sorted_digits]\n\n    return result_names\n```"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n    \"\"\"\n    digit_names = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Sort the entire array, then reverse it, as shown in the example `[1, -1, 55]` behavior.\n    reversed_sorted_arr = sorted(arr, reverse=True)\n\n    result = []\n    for num in reversed_sorted_arr:\n        # Only map numbers within the 1-9 range after sorting and reversing.\n        if 1 <= num <= 9:\n            result.append(digit_names[num])\n    return result"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n):\n    \"\"\"Computes an integer sequence of length n where element at index i (1-based) is\n    factorial(i) if i is even, or sum(1..i) if i is odd.\n    \"\"\"\n    sequence = []\n    current_factorial_value = 1  # This will store factorial(i-1) at start of loop iteration i.\n\n    for i in range(1, n + 1):\n        # Update current_factorial_value to factorial(i) for the current iteration.\n        current_factorial_value *= i\n\n        if i % 2 == 0:  # i is even\n            sequence.append(current_factorial_value)\n        else:  # i is odd\n            sum_to_i = i * (i + 1) // 2\n            sequence.append(sum_to_i)\n\n    return sequence\n```"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n):\n    \"\"\"Implement the function f that takes n as a parameter.\n    It returns a list of size n based on whether index i is even or odd, using cached values.\n    \"\"\"\n\n    # Initialize caches as function attributes; they persist across calls to f.\n    if not hasattr(f, 'factorials_cache'):\n        f.factorials_cache = {0: 1, 1: 1}\n    if not hasattr(f, 'sums_cache'):\n        f.sums_cache = {0: 0, 1: 1}\n\n    def _factorial(k):\n        \"\"\"Computes factorial of k, caching results to improve performance.\"\"\"\n        if k in f.factorials_cache:\n            return f.factorials_cache[k]\n\n        max_cached_k = max((c for c in f.factorials_cache if c < k), default=0)\n        current_val = f.factorials_cache[max_cached_k]\n        for x in range(max_cached_k + 1, k + 1):\n            current_val *= x\n        f.factorials_cache[k] = current_val\n        return current_val\n\n    def _sum_range(k):\n        \"\"\"Computes the sum of integers from 1 to k, caching results.\"\"\"\n        if k in f.sums_cache:\n            return f.sums_cache[k]\n\n        val = k * (k + 1) // 2\n        f.sums_cache[k] = val\n        return val\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result.append(_factorial(i))\n        else:  # i is odd\n            result.append(_sum_range(i))\n    return result\n```"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes in the range [1, n] inclusive.\n    Assumes n is a positive integer as per problem statement.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    def _is_palindrome(num: int) -> bool:\n        # Converts number to string to check if it reads the same forwards and backwards.\n        s = str(num)\n        return s == s[::-1]\n\n    for num in range(1, n + 1):\n        if _is_palindrome(num):\n            if num % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
