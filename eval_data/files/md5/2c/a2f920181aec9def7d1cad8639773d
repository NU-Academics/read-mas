changed. Raises CodecError on invalid input.\n        \"\"\"\n        text = validate_text(text)\n        chunks = chunk_string(text, self._chunk_size)\n        out_chunks = []\n        for chunk in chunks:\n            if len(chunk) == self._chunk_size:\n                out_chunks.append(chunk[1:] + chunk[0])\n            else:\n                out_chunks.append(chunk)\n        return \"\".join(out_chunks)\n\n    def decode(self, text: str) -> str:\n        \"\"\"\n        Decodes text by rotating every full group of chunk_size characters right by one position.\n        This reverses the encode operation. Raises CodecError on invalid input.\n        \"\"\"\n        text = validate_text(text)\n        chunks = chunk_string(text, self._chunk_size)\n        out_chunks = []\n        for chunk in chunks:\n            if len(chunk) == self._chunk_size:\n                out_chunks.append(chunk[-1] + chunk[:-1])\n            else:\n                out_chunks.append(chunk)\n        return \"\".join(out_chunks)\n```\n\nsrc/cycliccodec/dto.py\n```python\n\"\"\"\nDTOs: TextRequest(text: str), TextResponse(result: str).\n\"\"\"\n\nclass TextRequest:\n    \"\"\"\n    Data Transfer Object for incoming text requests.\n    \"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\nclass TextResponse:\n    \"\"\"\n    Data Transfer Object for outgoing text responses.\n    \"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\n```\n\nsrc/cycliccodec/exceptions.py\n```python\n\"\"\"\nApplication-specific error types.\n\"\"\"\n\nclass CodecError(Exception):\n    \"\"\"\n    Base exception for cyclic codec errors, typically due to invalid input.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n```\n\nsrc/cycliccodec/utils/__init__.py\n```python\n\"\"\"\nInitialization for utility module.\n\"\"\"\n```\n\nsrc/cycliccodec/utils/chunker.py\n```python\n\"\"\"\nChunker utilities: chunk_string(s: str, size: int)->List[str].\n\"\"\"\nfrom typing import List\n\ndef chunk_string(s: str, size: int) -> List[str]:\n    \"\"\"\n    Partitions a string into contiguous segments of `size`.\n    The final chunk may be shorter. Raises ValueError if size < 1.\n    \"\"\"\n    if size < 1:\n        raise ValueError(\"size must be >= 1\")\n    return [s[i:i+size] for i in range(0, len(s), size)]\n```\n\nsrc/cycliccodec/utils/validator.py\n```python\n\"\"\"\nInput validators: validate_text(text: Any)->str.\n\"\"\"\nfrom typing import Any\nfrom ..exceptions import CodecError\n\ndef validate_text(value: Any) -> str:\n    \"\"\"\n    Ensures the value is a string. If bytes, it attempts UTF-8 decoding.\n    Raises CodecError for unsupported types or decoding failures.\n    \"\"\"\n    if isinstance(value, str):\n        return value\n    if isinstance(value, bytes):\n        try:\n            return value.decode('utf-8')\n        except UnicodeDecodeError as e:\n            raise CodecError(f\"Failed to decode bytes input as UTF-8: {e}\") from e\n    raise CodecError(f\"Invalid input type: expected str or bytes, got {type(value).__name__}\")\n```\n\nsrc/cycliccodec/controllers/__init__.py\n```python\n\"\"\"\nInitialization for controllers module.\n\"\"\"\n```\n\nsrc/cycliccodec/controllers/cli.py\n```python\n\"\"\"\nCLIController: run_cli(args: List[str])->int.\n\"\"\"\nimport argparse\nimport sys\nfrom typing import List\nfrom ..encoder import CyclicEncoder\nfrom ..exceptions import CodecError\n\nclass CLIController:\n    \"\"\"\n    Manages command-line interface operations for encoding/decoding.\n    Parses arguments, interacts with CyclicEncoder, and prints results.\n    \"\"\"\n    def __init__(self, encoder: CyclicEncoder) -> None:\n        \"\"\"\n        Initializes the CLI controller with an encoder instance.\n        \"\"\"\n        self._encoder = encoder\n\n    def run(self, args: List[str]) -> int:\n        \"\"\"\n        Parses command-line arguments, performs the encode/decode operation.\n        Prints results to stdout, errors to stderr. Returns 0 on success, 2 on error.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Encode or decode strings using cyclic shift.\"\n        )\n        parser.add_argument(\n            \"--mode\",\n            choices=(\"encode\", \"decode\"),\n            required=True,\n            help=\"Operation mode: 'encode' or 'decode'.\"\n        )\n        parser.add_argument(\n            \"--text\",\n            type=str,\n            help=\"Text to process. If not provided, reads from stdin.\"\n        )\n\n        try:\n            ns = parser.parse_args(args)\n            text_input = ns.text\n            if text_input is None:\n                text_input = sys.stdin.read()\n\n            if ns.mode == \"encode\":\n                result = self._encoder.encode(text_input)\n            else:\n                result = self._encoder.decode(text_input)\n\n            sys.stdout.write(result)\n            sys.stdout.flush() # Ensure output is immediately visible\n            return 0\n        except CodecError as e:\n            sys.stderr.write(f\"Error: {e}\\n\")\n            return 2\n        except Exception as e:\n            sys.stderr.write(f\"An unexpected error occurred: {e}\\n\")\n            return 1\n```\n\nsrc/cycliccodec/controllers/http.py\n```python\n\"\"\"\nHTTPController (optional): create_app() -> FastAPI.\n\"\"\"\nfrom typing import Optional\n\nfrom ..encoder import CyclicEncoder\nfrom ..dto import TextRequest, TextResponse\nfrom ..exceptions import CodecError\n\ntry:\n    from fastapi import FastAPI, HTTPException, status\n    from pydantic import BaseModel\n    FASTAPI_INSTALLED = True\nexcept ImportError:\n    FASTAPI_INSTALLED = False\n    # Define placeholder classes/types to allow the module to be imported\n    # without FastAPI, but `create_app` will raise an error.\n    class FastAPI: pass\n    class HTTPException: pass\n    class status:\n        HTTP_400_BAD_REQUEST = 400\n        HTTP_500_INTERNAL_SERVER_ERROR = 500\n    class BaseModel: pass\n\n\nif FASTAPI_INSTALLED:\n    # Redefine DTOs using Pydantic for FastAPI validation\n    class PydanticTextRequest(BaseModel):\n        text: str\n\n    class PydanticTextResponse(BaseModel):\n        result: str\n\nclass HTTPController:\n    \"\"\"\n    HTTP API adapter using FastAPI to expose encode/decode endpoints.\n    Requires FastAPI to be installed.\n    \"\"\"\n    def __init__(self, encoder: CyclicEncoder) -> None:\n        \"\"\"\n        Initializes the HTTP controller with an encoder instance.\n        \"\"\"\n        self._encoder = encoder\n\n    def create_app(self) -> FastAPI:\n        \"\"\"\n        Creates and configures a FastAPI application with /encode and /decode endpoints.\n        Raises RuntimeError if FastAPI is not installed.\n        \"\"\"\n        if not FASTAPI_INSTALLED:\n            raise RuntimeError(\"FastAPI is not installed. Please install it with 'pip install fastapi uvicorn'.\")\n\n        app = FastAPI(\n            title=\"Cyclic Codec API\",\n            description=\"API for cyclic string encoding and decoding.\",\n            version=\"1.0.0\"\n        )\n\n        @app.post(\"/encode\", response_model=PydanticTextResponse, status_code=status.HTTP_200_OK)\n        async def encode_text(request: PydanticTextRequest) -> PydanticTextResponse:\n            \"\"\"\n            Encodes the provided text using the cyclic algorithm.\n            \"\"\"\n            try:\n                encoded_text = self._encoder.encode(request.text)\n                return PydanticTextResponse(result=encoded_text)\n            except CodecError as e:\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=f\"Encoding error: {e.message}\"\n                ) from e\n            except Exception as e:\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail=f\"An unexpected server error occurred during encoding: {e}\"\n                ) from e\n\n        @app.post(\"/decode\", response_model=PydanticTextResponse, status_code=status.HTTP_200_OK)\n        async def decode_text(request: PydanticTextRequest) -> PydanticTextResponse:\n            \"\"\"\n            Decodes the provided text using the cyclic algorithm.\n            \"\"\"\n            try:\n                decoded_text = self._encoder.decode(request.text)\n                return PydanticTextResponse(result=decoded_text)\n            except CodecError as e:\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=f\"Decoding error: {e.message}\"\n                ) from e\n            except Exception as e:\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail=f\"An unexpected server error occurred during decoding: {e}\"\n                ) from e\n\n        return app\n```\n\nsrc/cycliccodec/scripts/main.py\n```python\n\"\"\"\nConsole entrypoint wrappers that call CLIController.\n\"\"\"\nimport sys\nfrom typing import Optional, List\n\n# Local imports\nfrom ..encoder import CyclicEncoder\nfrom ..controllers.cli import CLIController\nfrom ..config import DEFAULT_CHUNK_SIZE\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the CLI script.\n    Constructs dependencies and delegates execution to CLIController.\n    \"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    # Dependency injection: create CyclicEncoder and CLIController\n    encoder = CyclicEncoder(chunk_size=DEFAULT_CHUNK_SIZE)\n    cli_controller = CLIController(encoder=encoder)\n\n    return cli_controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\npyproject.