 5, 7])}\") # Expected: True\nprint(f\"Simple function [0, 0]: {pairs_sum_to_zero([0, 0])}\") # Expected: True\nprint(f\"Simple function [0]: {pairs_sum_to_zero([0])}\") # Expected: False\n\n# --- Using the robust, validated API ---\nservice = PairService()\nvalidator = Validator()\ncontroller = PairController(service=service, validator=validator)\n\n# Valid input\nnumbers1 = [1, 3, 5, 0]\nprint(f\"Controller API {numbers1}: {controller.pairs_sum_to_zero(numbers1)}\") # Expected: False\n\nnumbers2 = [2, 4, -5, 3, 5, 7]\nprint(f\"Controller API {numbers2}: {controller.pairs_sum_to_zero(numbers2)}\") # Expected: True\n\n# Invalid input (raises ValidationError)\ntry:\n    controller.pairs_sum_to_zero([1, 'a', 3])\nexcept ValidationError as e:\n    print(f\"Controller API invalid input error: {e}\") # Expected: ValidationError\n```\n\n### 3.2. CLI Usage\n\nThe package installs a command-line tool named `pairs-sum-zero`.\n\n```bash\n# Check a space-separated list\npairs-sum-zero 1 3 -2 1\n\n# Check a comma-separated list (quote if spaces are present)\npairs-sum-zero \"1,3,-2,1\"\n\n# Check a Python-list-like string\npairs-sum-zero \"[2, 4, -5, 3, 5, 7]\"\n\n# Example output for a list with a zero-sum pair\n$ pairs-sum-zero \"[2, 4, -5, 3, 5, 7]\"\nTrue\n\n# Example output for a list without a zero-sum pair\n$ pairs-sum-zero 1 2 3\nFalse\n\n# Example output for invalid input\n$ pairs-sum-zero 1 a 3\nError: Invalid number format in CLI input: 'a'\n```\n\n## 4. Development & Contribution\n\n### Setup Development Environment\n\n```bash\n# Clone the repository\ngit clone https://github.com/yourusername/pairs-sum-zero.git\ncd pairs-sum-zero\n\n# Install poetry (if not already installed)\npip install poetry\n\n# Install dependencies\npoetry install\n\n# Activate the virtual environment\npoetry shell\n```\n\n### Running Tests\n\n```bash\npytest\n```\n\nTo run tests with coverage:\n\n```bash\npytest --cov=src/pairs_sum --cov-report=term-missing --cov-fail-under=90\n```\n\n### Linting and Type Checking\n\n```bash\nruff check .\nmypy src\n```\n\n### Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 pairs_sum/\n\u2502       \u251c\u2500\u2500 __init__.py         # Package entry, exposes primary API and classes\n\u2502       \u251c\u2500\u2500 config.py           # Configuration constants\n\u2502       \u251c\u2500\u2500 models.py           # Data Transfer Objects (DTOs)\n\u2502       \u251c\u2500\u2500 exceptions.py       # Custom exception classes\n\u2502       \u251c\u2500\u2500 validator.py        # Input validation logic\n\u2502       \u251c\u2500\u2500 repository.py       # Optional data persistence (in-memory/JSON)\n\u2502       \u251c\u2500\u2500 service.py          # Core business logic / algorithm\n\u2502       \u251c\u2500\u2500 controller.py       # API boundary, handles validation and delegates\n\u2502       \u251c\u2500\u2500 cli.py              # Command-line interface entry point\n\u2502       \u2514\u2500\u2500 utils.py            # Utility functions (e.g., CLI argument parsing)\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 test_service.py\n\u2502   \u251c\u2500\u2500 test_controller.py\n\u2502   \u2514\u2500\u2500 test_cli.py\n\u251c\u2500\u2500 .github/\n\u2502   \u2514\u2500\u2500 workflows/\n\u2502       \u2514\u2500\u2500 ci.yml              # GitHub Actions CI workflow\n\u251c\u2500\u2500 pyproject.toml              # Project metadata, dependencies, build config\n\u2514\u2500\u2500 README.md                   # Project documentation\n```\n\n## 5. License\n\nThis project is licensed under the MIT License. See the LICENSE file for details.\n```\n```python\n# tests/test_service.py\n\nimport pytest\nfrom src.pairs_sum.service import PairService\nfrom src.pairs_sum.models import PairResult\n\n@pytest.fixture\ndef service() -> PairService:\n    \"\"\"Provides a PairService instance for tests.\"\"\"\n    return PairService()\n\ndef test_find_pair_sum_zero_examples(service: PairService) -