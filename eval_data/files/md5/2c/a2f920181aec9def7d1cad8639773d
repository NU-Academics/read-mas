:\n        \"\"\"Compares two CharacterSet instances based on their character sets.\"\"\"\n        if not isinstance(other, CharacterSet):\n            return NotImplemented\n        return self.chars() == other.chars()\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a debug representation of the CharacterSet.\"\"\"\n        return f\"CharacterSet(value='{self._value}')\"\n```\n\n```\nsrc/samechars/SameCharsService.py\n```python\n# Implements the core business logic for character set comparison.\n# It uses an injected InputValidator and creates CharacterSet instances.\nfrom .CharacterSet import CharacterSet\nfrom .InputValidator import InputValidator\n\nclass SameCharsService:\n    \"\"\"\n    Provides the core logic to compare character sets of two strings.\n    It relies on an InputValidator for input safety and CharacterSet for abstraction.\n    \"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        \"\"\"Injects the InputValidator dependency.\"\"\"\n        self._validator = validator\n\n    def same_chars(self, s0: str, s1: str) -> bool:\n        \"\"\"\n        Determines if two strings contain the same set of characters.\n        Inputs are validated before comparison.\n        \"\"\"\n        s0_v = self._validator.validate(s0, name=\"s0\")\n        s1_v = self._validator.validate(s1, name=\"s1\")\n        return CharacterSet(s0_v) == CharacterSet(s1_v)\n```\n\n```\nsrc/samechars/InputValidator.py\n```python\n# Validates string inputs for type and length, and provides an extension point for normalization.\n# Raises InvalidInputError for any validation failures.\nfrom typing import Any, Optional\nfrom .InvalidInputError import InvalidInputError\n\nclass InputValidator:\n    \"\"\"\n    Validates and optionally normalizes input strings.\n    Enforces type and maximum length constraints.\n    \"\"\"\n    DEFAULT_MAX_LENGTH = 10_000_000\n\n    def validate(self, s: Any, name: str = \"input\", max_length: Optional[int] = None) -> str:\n        \"\"\"\n        Validates an input value to ensure it is a non-null string\n        and adheres to an optional maximum length.\n        \"\"\"\n        if s is None:\n            raise InvalidInputError(f\"{name} cannot be null.\")\n        if not isinstance(s, str):\n            raise InvalidInputError(f\"{name} must be a string.\")\n        \n        effective_max_length = max_length if max_length is not None else self.DEFAULT_MAX_LENGTH\n        if len(s) > effective_max_length:\n            raise InvalidInputError(f\"{name} exceeds maximum length of {effective_max_length}.\")\n        \n        return self.normalize(s)\n\n    def normalize(self, s: str) -> str:\n        \"\"\"\n        Applies any required normalization to the string.\n        By default, this is an identity function, allowing for future extensions.\n        \"\"\"\n        return s\n```\n\n```\nsrc/samechars/InvalidInputError.py\n```python\n# Custom exception for signaling invalid input errors.\n# Carries a message and an HTTP-like status code.\nclass InvalidInputError(Exception):\n    \"\"\"\n    Custom exception for invalid input data.\n    Includes a message and an HTTP-like status code for API responses.\n    \"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        \"\"\"Initializes the error with a message and an optional status code.\"\"\"\n        super().__init__(message)\n        self.message = message\n        self.code = code\n```\n\n```\nsrc/samechars/utils.py\n```python\n# Helper functions for character set creation and unicode normalization.\n# These utilities support the core CharacterSet and InputValidator.\nimport unicodedata\nfrom typing import Set\n\nUNICODE_NORMALIZATION = \"NFC\"\n\ndef safe_set_from_str(s: str) -> Set[str]:\n    \"\"\"\n    Creates a set of unique characters from a string.\n    This function expects a valid string input.\n    \"\"\"\n    return set(s)\n\ndef normalize_unicode(s: str) -> str:\n    \"\"\"\n    Applies Unicode normalization to a string using the configured form.\n    This helps in canonical representation of Unicode characters.\n    \"\"\"\n    return unicodedata.normalize(UNICODE_NORMALIZATION, s)\n```\n\n```\nsrc/samechars/CLI.py\n```python\n# Command-line interface controller for the same-chars functionality.\n# Parses arguments, invokes the service, and prints results with appropriate exit codes.\nimport sys\nimport argparse\nfrom typing import List\n\nfrom .SameCharsService import SameCharsService\nfrom .InputValidator import InputValidator\nfrom .InvalidInputError import InvalidInputError\n\nclass CLI:\n    \"\"\"\n    Command-line interface to check if two strings have the same characters.\n    It integrates the SameCharsService and InputValidator.\n    \"\"\"\n    def __init__(self, service: SameCharsService, validator: InputValidator) -> None:\n        \"\"\"Injects the core service and validator dependencies.\"\"\"\n        self._service = service\n        self._validator = validator\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI logic, parsing arguments and returning an exit code.\n        Handles errors by printing to stderr and returning non-zero exit codes.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Check if two strings contain the same set of characters.\"\n        )\n        parser.add_argument(\"s0\", help=\"First string for comparison.\")\n        parser.add_argument(\"s1\", help=\"Second string for comparison.\")\n\n        try:\n            args = parser.parse_args(argv[1:])\n            result = self._service.same_chars(args.s0, args.s1)\n            print(result)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n# Entry point for console script\ndef main():\n    \"\"\"Main function to instantiate CLI and run it with system arguments.\"\"\"\n    validator = InputValidator()\n    service = SameCharsService(validator)\n    cli = CLI(service, validator)\n    sys.exit(cli.run(sys.argv))\n\nif __name__ == \"__main__\":\n    main()\n```\n\n```\nsrc/samechars/SameCharsAPI.py\n```python\n# Flask-based HTTP API controller for the same-chars functionality.\n# Provides a POST endpoint to compare two strings' character sets.\nfrom flask import Flask, request, jsonify\nfrom .SameCharsService import SameCharsService\nfrom .InputValidator import InputValidator\nfrom .InvalidInputError import InvalidInputError\n\nclass SameCharsAPI:\n    \"\"\"\n    Provides a factory function to create a Flask application for the same-chars service.\n    Exposes a POST /same-chars endpoint for character set comparison.\n    \"\"\"\n    @staticmethod\n    def create_app(service: SameCharsService, validator: InputValidator) -> Flask:\n        \"\"\"\n        Creates and configures a Flask application with the given service and validator.\n        Registers the POST /same-chars route.\n        \"\"\"\n        app = Flask(__name__)\n\n        @app.route(\"/same-chars\", methods=[\"POST\"])\n        def same_chars_endpoint():\n            \"\"\"\n            Handles POST requests to /same-chars.\n            Expects JSON with 's0' and 's1' strings, returns boolean result.\n            \"\"\"\n            if not request.is_json:\n                return jsonify({\"error\": \"Request must be JSON\"}), 400\n            \n            data = request.get_json()\n            s0 = data.get(\"s0\")\n            s1 = data.get(\"s1\")\n\n            try:\n                # Validation is handled by service internally, but API layer validates JSON structure.\n                # The service will then apply its own string validation.\n                result = service.same_chars(s0, s1)\n                return jsonify({\"same\": result}), 200\n            except InvalidInputError as e:\n                return jsonify({\"error\": e.message}), e.code\n            except Exception:\n                return jsonify({\"error\": \"Internal server error\"}), 500\n        \n        return app\n\n# Example for local development\nif __name__ == \"__main__\":\n    validator = InputValidator()\n    service = SameCharsService(validator)\n    app = SameCharsAPI.create_app(service, validator)\n    app.run(debug=True, port=5000)\n```\n\n```\ntests/test_same_chars.py\n```python\n# Unit tests for the samechars package, covering core logic and convenience function.\n# Includes doctest cases and various edge conditions.\nimport pytest\nfrom src.samechars import same_chars\nfrom src.samechars.SameCharsService import SameCharsService\nfrom src.samechars.InputValidator import InputValidator\nfrom src.samechars.CharacterSet import CharacterSet\nfrom src.samechars.InvalidInputError import InvalidInputError\n\n@pytest.fixture\ndef same_chars_service():\n    \"\"\"Provides an instance of SameCharsService with a default InputValidator.\"\"\"\n    validator = InputValidator()\n    return SameCharsService(validator)\n\ndef test_doctests_cases(same_chars_service):\n    \"\"\"Tests the core service with provided doctest examples.\"\"\"\n    assert same_chars_service.same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc') is True\n    assert same_chars_service.same_chars('abcd', 'dddddddabc') is True\n    assert same_chars_service.same_chars('dddddddabc', 'abcd') is True\n    assert same_chars_service.same_chars('eabcd', 'dddddddabc') is False\n    assert same_chars_service.same_chars('abcd', 'dddddddabce') is False\n    assert same_chars_service.same_chars('eabcdzzzz', 'dddzzzzzzzddddabc') is False\n\ndef test_same_chars_convenience_function():\n    \"\"\"Tests the top-level convenience function with basic cases.\"\"\"\n    assert same_chars('a', 'a') is True\n    assert same_chars('a', 'b') is False\n\ndef test_empty_strings(same_chars_service):\n    \"\"\"Checks character set equality for empty strings.\"\"\"\n    assert same_chars_service.same_chars('', '') is True\n    assert same_chars_service.same_chars('a', '') is False\n    assert same_chars_service.same_chars('', 'a') is False\n\ndef test_unicode_characters(same_chars_service):\n    \"\"\"Verifies handling of various Unicode characters.\"\"\"\n    assert same_chars_service.same_chars('\u4f60\u597d\u4e16\u754c', '\u4e16\u754c\u4f60\u597d') is True\n    assert same_chars_service.same_chars('\u4f60\u597d\u4e16\u754c', '\u4f60\u597d\u4e16\u754c\uff01') is False\n    assert same_chars_service.same_chars('\u00e9\u00e8\u00e0', '\u00e0\u00e9\u00e8') is True\n\ndef test_case_sensitivity(same_chars_service):\n    \"\"\"Confirms that character comparison is case-sensitive by default.\"\"\"\n    assert same_chars_service.same_chars('a', 'A') is False\n    assert same_chars_service.same_chars('abc', 'Abc') is False\n\ndef test_multiplicity_ignored(same_chars_service):\n    \"\"\"Ensures that character multiplicity does not affect equality.\"\"\"\n    assert same_chars_service.same_chars('aaabbb', 'ab') is True\n    assert same_chars_service.same_chars('aabba', 'aba') is True\n\ndef test_same_chars_with_special_characters(same_chars_service):\n    \"\"\"Tests strings containing numbers, symbols, and whitespace.\"\"\"\n    assert same_chars_service.same_chars('123!@#', '#!@321') is True\n    assert same_chars_service.same_chars('hello world', 'world hello') is True\n    assert same_chars_service.same_chars('h e l l o', 'hello') is False # space is a character\n\ndef test_invalid_input_types(same_chars_service):\n    \"\"\"Verifies that invalid input types raise InvalidInputError.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"s0 must be a string\"):\n        same_chars_service.same_chars(123, \"test\")\n    with pytest.raises(InvalidInputError, match=\"s1 cannot be null\"):\n        same_chars_service.same_chars(\"test\", None)\n\n# Tests for CharacterSet directly\ndef test_character_set_creation():\n    \"\"\"Tests the CharacterSet initialization and character extraction.\"\"\"\n    cs = CharacterSet(\"hello\")\n    assert cs.value() == \"hello\"\n    assert cs.chars() == {'h', 'e', 'l', 'o'}\n\ndef test_character_set_equality():\n    \"\"\"Tests equality comparison between CharacterSet instances.\"\"\"\n    cs1 = CharacterSet(\"abc\")\n    cs2 = CharacterSet(\"bca\")\n    cs3 = CharacterSet(\"abd\")\n    assert cs1 == cs2\n    assert cs1 != cs3\n    assert CharacterSet(\"aaa\") == CharacterSet(\"a\")\n\ndef test_character_set_repr():\n    \"\"\"Tests the string representation of CharacterSet.\"\"\"\n    cs = CharacterSet(\"test\")\n    assert repr(cs) == \"CharacterSet(value='test')\"\n```\n\n```\ntests/test_validator.py\n```python\n# Unit tests for the InputValidator class.\n# Covers validation rules for type, nulls, and maximum length.\nimport pytest\nfrom src.samechars.InputValidator import InputValidator\nfrom src.samechars.InvalidInputError import InvalidInputError\nfrom src.samechars import utils\n\n@pytest.fixture\ndef validator():\n    \"\"\"Provides a fresh instance of InputValidator for each test.\"\"\"\n    return InputValidator()\n\ndef test_validate_valid_string(validator):\n    \"\"\"Ensures a valid string passes validation and is returned.\"\"\"\n    s = \"valid string\"\n    assert validator.validate(s) == s\n\ndef test_validate_null_input(validator):\n    \"\"\"Checks that null input raises an InvalidInputError.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"input cannot be null\"):\n        validator.validate(None)\n    with pytest.raises(InvalidInputError, match=\"my_param cannot be null\"):\n        validator.validate(None, name=\"my_param\")\n\ndef test_validate_non_string_input(validator):\n    \"\"\"Confirms that non-string inputs raise InvalidInputError.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"input must be a string\"):\n        validator.validate(123)\n    with pytest.raises(InvalidInputError, match=\"input must be a string\"):\n        validator.validate(['a', 'b'])\n    with pytest.raises(InvalidInputError, match=\"input must be a string\"):\n        validator.validate(True)\n\ndef test_validate_max_length_exceeded(validator):\n    \"\"\"Verifies that strings exceeding max_length raise InvalidInputError.\"\"\"\n    max_len = 5\n    long_string = \"0123456\"\n    with pytest.raises(InvalidInputError, match=f\"input exceeds maximum length of {max_len}\"):\n        validator.validate(long_string, max_length=max_len)\n\ndef test_validate_max_length_at_limit(validator):\n    \"\"\"Ensures strings at the maximum length are still valid.\"\"\"\n    max_len = 5\n    at_limit_string = \"01234\"\n    assert validator.validate(at_limit_string, max_length=max_len) == at_limit_string\n\ndef test_validate_default_max_length(validator):\n    \"\"\"Checks that the default max length is applied when not specified.\"\"\"\n    # A string longer than default max length would fail, but for a normal string, it passes.\n    short_string = \"short\"\n    assert validator.validate(short_string) == short_string\n    # To test actual default max length, we'd need a very long string, impractical for unit test.\n    # The mechanism is already tested by test_validate_max_length_exceeded.\n\ndef test_normalize_default_identity(validator):\n    \"\"\"Confirms that the default normalize method returns the input string unchanged.\"\"\"\n    s = \"Hello World\"\n    assert validator.normalize(s) == s\n    s_unicode = \"caf\u00e9\"\n    assert validator.normalize(s_unicode) == s_unicode\n\ndef test_normalize_unicode_helper():\n    \"\"\"Tests the standalone unicode normalization helper function.\"\"\"\n    s_nfd = \"co\ufb00ee\" # Ligature ff\n    s_nfc = \"coffee\" # Normalized form\n    assert utils.normalize_unicode(s_nfd) == unicodedata.normalize(\"NFC\", s_nfd)\n    assert utils.normalize_unicode(s_nfc) == unicodedata.normalize(\"NFC\", s_nfc)\n```\n\n```\npyproject.toml\n```toml\n[project]\nname = \"samechars\"\nversion = \"0.1.0\"\ndescription = \"A library and tools to check if two strings have the same character set.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n]\ndependencies = [] # Core library has no external dependencies beyond stdlib\n\n[project.optional-dependencies]\napi = [\"Flask>=2.0\"]\n\n[project.scripts]\nsamechars-cli = \"samechars.CLI:main\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n\n```\nREADME.md\n```markdown\n# SameChars Library\n\nThis project provides a reliable, well-tested library for determining whether two strings contain the same set of characters. It also includes a command-line interface (CLI) and an optional HTTP API for this functionality.\n\n## Features\n\n-   `same_chars(s0, s1)`: A Python library function to compare character sets.\n-   `samechars-cli`: A command-line tool for quick checks.\n-   HTTP API: An optional Flask-based API for programmatic access (POST `/same-chars`).\n-   Robust input validation.\n\n## Installation\n\nYou can install the library directly from source or via pip once published.\n\n```bash\n# Clone the repository\ngit clone https://github.com/yourusername/samechars.git\ncd samechars\n\n# Install the core library\npip install .\n\n# To install with API support\npip install \".[api]\"\n```\n\n## Usage\n\n### Library\n\n```python\nfrom samechars import same_chars\n\n# Example usage\nprint(same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')) # Output: True\nprint(same_chars('abcd', 'dddddddabce'))           # Output: False\nprint(same_chars('hello', 'olleh'))               # Output: True\nprint(same_chars('Hello', 'hello'))               # Output: False (case-sensitive)\n```\n\n### CLI\n\nAfter installation, you can use the `samechars-cli` command:\n\n```bash\nsamechars-cli \"eabcdzzzz\" \"dddzzzzzzzddeddabc\"\n# Output: True\n\nsamechars-cli \"abcd\" \"dddddddabce\"\n# Output: False\n\nsamechars-cli \"unicode \u4e16\u754c\" \"\u4e16\u754c unicode\"\n# Output: True\n```\n\n### API (Optional)\n\nIf you installed with API support, you can run the Flask application:\n\n```bash\nexport FLASK_APP=src/samechars/SameCharsAPI.py\nflask run\n# Or if running from project root using the example script:\npython src/samechars/SameCharsAPI.py\n```\n\nThen, you can send POST requests to `http://127.0.0.1:5000/same-chars`:\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"s0\": \"eabcdzzzz\", \"s1\": \"dddzzzzzzzddeddabc\"}' http://127.0.0.1:5000/same-chars\n# Expected JSON output: {\"same\": true}\n\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"s0\": \"abcd\", \"s1\": \"dddddddabce\"}' http://127.0.0.1:5000/same-chars\n# Expected JSON output: {\"same\": false}\n\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"s0\": null, \"s1\": \"test\"}' http://127.0.0.1:5000/same-chars\n# Expected JSON output: {\"error\": \"s0 cannot be null\"}, HTTP 400\n```\n\n## Development\n\n### Running Tests\n\nInstall `pytest` and run tests from the project root:\n\n```bash\npip install pytest\npytest\n```\n```"}
