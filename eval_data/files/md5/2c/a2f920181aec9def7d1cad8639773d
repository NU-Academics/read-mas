tors\n\ndef test_cli_with_no_cache_flag(tmp_path):\n    \"\"\"Test CLI with --no-cache flag, ensuring no file is created.\"\"\"\n    cache_file = tmp_path / \"no_cache.json\"\n    n_val = 12345\n    factors = [3, 5, 823] # Known factors\n\n    # Run with --no-cache\n    stdout, stderr = run_cli([\"factorize\", str(n_val), \"--no-cache\"])\n    assert json.loads(stdout) == factors\n    assert not stderr\n    assert not cache_file.exists() # Cache file should NOT exist\n\n    # Also check that even if cache file exists, --no-cache overrides it\n    cache_file_pre_existing = tmp_path / \"pre_existing_cache.json\"\n    repo = PrimeRepository(str(cache_file_pre_existing))\n    repo.set(n_val, [1,1,1]) # Set some dummy data\n    repo._persist_cache()\n    assert cache_file_pre_existing.exists()\n\n    stdout, stderr = run_cli([\"factorize\", str(n_val), \"--no-cache\"])\n    assert json.loads(stdout) == factors\n    assert not stderr\n    # No changes to the pre-existing cache file (its timestamp/content should be old)\n    with open(cache_file_pre_existing, 'r') as f:\n        cache_data = json.load(f)\n    assert cache_data[\"entries\"][str(n_val)] == [1,1,1] # Original content, not updated\n\ndef test_cli_with_cache_env_var(tmp_path, monkeypatch):\n    \"\"\"Test CLI with cache path specified via environment variable.\"\"\"\n    env_cache_file = tmp_path / \"env_cache.json\"\n    monkeypatch.setenv(CLI.DEFAULT_CACHE_ENV, str(env_cache_file))\n\n    n_val = 14\n    factors = [2, 7]\n\n    # Run without --cache or --no-cache; should use env var\n    stdout, stderr = run_cli([\"factorize\", str(n_val)])\n    assert json.loads(stdout) == factors\n    assert not stderr\n    assert env_cache_file.exists()\n\n    with open(env_cache_file, 'r') as f:\n        cache_data = json.load(f)\n    assert cache_data[\"entries\"][str(n_val)] == factors\n```"}
