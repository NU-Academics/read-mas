{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |.\n    \"\"\"\n    # Compute the arithmetic mean of the numbers.\n    mean_val = sum(numbers) / len(numbers)\n\n    # Compute the sum of absolute differences from the mean.\n    absolute_differences_sum = sum(abs(x - mean_val) for x in numbers)\n\n    # Return the average of these absolute differences.\n    return absolute_differences_sum / len(numbers)\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'. \"\"\"\n    if not numbers:\n        return []\n    out: List[int] = []\n    for i, v in enumerate(numbers):\n        out.append(v)\n        if i != len(numbers) - 1:\n            out.append(delimeter)\n    return out\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    Calculates the Mean Absolute Deviation (MAD) around the mean for a list of numbers.\n    MAD is the average absolute difference between each element and the dataset's mean.\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_deviations = [abs(x - data_mean) for x in numbers]\n    mad = sum(absolute_deviations) / len(numbers)\n    return mad\n\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`. \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n\n    result: List[int] = []\n    for i, v in enumerate(numbers):\n        result.append(v)\n        if i != n - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Computes the deepest nesting level for each space-separated group.\n    This implementation assumes valid parenthesis groups based on critical requirements to trust input.\n    \"\"\"\n    if not paren_string:\n        return []\n\n    groups = [g for g in paren_string.split() if g]\n    depths = []\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == \"(\":\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == \")\":\n                current_depth -= 1\n        depths.append(max_depth)\n\n    return depths\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Computes the maximum nesting depth for multiple parenthesis groups in a string.\n    Each group is space-separated, and results are returned as a list of integers.\n    \"\"\"\n\n    groups = [g for g in paren_string.strip().split() if g]\n    depths = []\n\n    for group in groups:\n        max_depth = 0\n        current_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n            # Per \"CRITICAL REQUIREMENTS\", specific error checks and raising exceptions\n            # for malformed inputs are omitted. The logic proceeds assuming well-formed input.\n        depths.append(max_depth)\n\n    return depths\n```"}
