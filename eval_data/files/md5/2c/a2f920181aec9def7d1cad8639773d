{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as n! * (n-1)! * ... * 1!.\n    The function computes this for a given positive integer n.\n    \"\"\"\n\n    def _factorial(k):\n        \"\"\"Helper to compute k! iteratively.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    total = 1\n    for k in range(1, n + 1):\n        total *= _factorial(k)\n    return total\n```"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of n.\n    brazilian_factorial(n) = n! * (n-1)! * ... * 1!\n    \"\"\"\n\n    def _factorial(k):\n        \"\"\"Computes the factorial of k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    product_of_factorials = 1\n    for k in range(1, n + 1):\n        product_of_factorials *= _factorial(k)\n    return product_of_factorials"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Normalizes whitespace in a string by replacing runs of spaces.\n    Runs of 1 or 2 spaces become a single underscore; runs of 3+ spaces become a single dash.\n    \"\"\"\n    def _replace_run(match: re.Match) -> str:\n        run_len = len(match.group(0))\n        if run_len >= 3:\n            return \"-\"\n        return \"_\"\n    return re.sub(r\" +\", _replace_run, text)"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces runs of 1 or 2 spaces with underscores, and runs of 3 or more spaces with a hyphen.\n    All other characters remain unchanged.\n    \"\"\"\n\n    def _replace_runs(match):\n        \"\"\"Replaces matched space runs based on their length.\"\"\"\n        run_len = len(match.group(1))\n        if run_len >= 3:\n            return \"-\"\n        return \"_\" * run_len\n\n    return re.sub(r\"( +)\", _replace_runs, text)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file name is valid based on specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n\n    def _count_digits(s):\n        \"\"\"Counts the number of digit characters in a string.\"\"\"\n        return sum(1 for char in s if '0' <= char <= '9')\n\n    def _is_latin_letter(ch):\n        \"\"\"Checks if a character is a Latin letter (A-Z or a-z).\"\"\"\n        return ('a' <= ch <= 'z') or ('A' <= ch <= 'Z')\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into name and extension parts\n    name_part, ext_part = file_name.split('.')\n\n    # Rule: The substring before the dot should not be empty\n    if not name_part:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a letter from the latin alphapet\n    if not _is_latin_letter(name_part[0]):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = {'txt', 'exe', 'dll'}\n    if ext_part.lower() not in allowed_extensions:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules.\"\"\"\n\n    # Helper function to count digits in a string.\n    def _count_digits(s):\n        count = 0\n        for char in s:\n            if '0' <= char <= '9':\n                count += 1\n        return count\n\n    # Helper function to check if a character is a Latin alphabet letter.\n    def _is_latin_letter(char):\n        return ('a' <= char <= 'z') or ('A' <= char <= 'Z')\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the filename into name and extension parts.\n    name_part, ext_part = file_name.rsplit('.', 1)\n\n    # Rule: The substring before the dot should not be empty, and it starts with a latin alphabet letter.\n    if not name_part or not _is_latin_letter(name_part[0]):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll'] (case-insensitive).\n    allowed_extensions = {'txt', 'exe', 'dll'}\n    if ext_part.lower() not in allowed_extensions:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') anywhere in the file's name.\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Computes a transformed sum of integer list entries.\n    Entries at indices multiple of 3 are squared, others are cubed if index is a multiple of 4 (but not 3), and unchanged otherwise.\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(lst):\n        transformed_value = value\n        if i % 3 == 0:\n            transformed_value = value ** 2\n        elif i % 4 == 0:\n            transformed_value = value ** 3\n        \n        total_sum += transformed_value\n\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Computes a transformed sum of integer list elements based on index-based rules.\n    Indexes divisible by 3 are squared; indexes divisible by 4 but not 3 are cubed.\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(lst):\n        transformed_value = value\n        if i % 3 == 0:\n            transformed_value = value ** 2\n        elif i % 4 == 0:\n            transformed_value = value ** 3\n        \n        total_sum += transformed_value\n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers.\n    Returns words in original order, separated by single spaces.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime. Optimized for small integers.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words_list = [word for word in sentence.strip().split(' ') if word]\n\n    prime_length_words = []\n    for word in words_list:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Determines if the product of two fractions, x and n, is a whole number.\n    Fractions are given as strings \"<numerator>/<denominator>\".\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Computes the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Parse fraction x\n    x_parts = x.split('/')\n    x_numerator = int(x_parts[0])\n    x_denominator = int(x_parts[1])\n\n    # Parse fraction n\n    n_parts = n.split('/')\n    n_numerator = int(n_parts[0])\n    n_denominator = int(n_parts[1])\n\n    # Apply cross-cancellation using GCD to simplify the product\n    # Let x = a/b and n = c/d\n    a, b = x_numerator, x_denominator\n    c, d = n_numerator, n_denominator\n\n    # Simplify (a, d) and (c, b)\n    g1 = _gcd(a, d)\n    a //= g1\n    d //= g1\n\n    g2 = _gcd(c, b)\n    c //= g2\n    b //= g2\n\n    # The product is (a*c) / (b*d). Check if the denominator divides the numerator.\n    final_numerator = a * c\n    final_denominator = b * d\n\n    return final_numerator % final_denominator == 0"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers.\n    Preserves original word order in the returned string.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer n is a prime number.\n        This helper is defined inline as required by the specifications.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"\n    Checks if the product of two fractions x and n is a whole number.\n    Fractions are given as strings \"<numerator>/<denominator>\".\n    \"\"\"\n    x_parts = x.split('/')\n    n_parts = n.split('/')\n\n    num_x = int(x_parts[0])\n    den_x = int(x_parts[1])\n    num_n = int(n_parts[0])\n    den_n = int(n_parts[1])\n\n    # Perform cross-cancellation using GCD to simplify before multiplication.\n    # This prevents intermediate numbers from becoming excessively large.\n    gcd1 = math.gcd(num_x, den_n)\n    num_x //= gcd1\n    den_n //= gcd1\n\n    gcd2 = math.gcd(num_n, den_x)\n    num_n //= gcd2\n    den_x //= gcd2\n\n    # Calculate the product of the simplified fractions.\n    final_numerator = num_x * num_n\n    final_denominator = den_x * den_n\n\n    # The product is a whole number if the final denominator divides the final numerator.\n    return final_numerator % final_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits (absolute value),\n    maintaining original order for ties.\n    \"\"\"\n\n    def calculate_digit_sum(number):\n        \"\"\"Calculates the sum of digits for a number's absolute value.\"\"\"\n        return sum(int(d) for d in str(abs(number)))\n\n    # Pair each number with its calculated digit sum and original index for stable sorting.\n    # The tuple structure (digit_sum, original_index, original_number) ensures stability.\n    decorated_list = []\n    for index, number in enumerate(nums):\n        digit_sum = calculate_digit_sum(number)\n        decorated_list.append((digit_sum, index, number))\n\n    # Sort the list. Python's sort is stable, and the key (digit_sum, index)\n    # explicitly ensures the tie-breaking rule by original input order.\n    decorated_list.sort(key=lambda item: (item[0], item[1]))\n\n    # Extract and return the original numbers from the sorted list.\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their absolute decimal digits.\n    Elements with equal digit sums maintain their original relative order.\n    \"\"\"\n\n    def _sum_of_digits(n):\n        \"\"\"Calculates the sum of decimal digits for the absolute value of an integer.\"\"\"\n        s = 0\n        for digit_char in str(abs(n)):\n            s += int(digit_char)\n        return s\n\n    return sorted(nums, key=_sum_of_digits)\n```"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where both first and last digits are odd.\n    Absolute value is used for digit inspection.\"\"\"\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for num in nums:\n        if num <= 10:\n            continue\n\n        abs_num_str = str(abs(num))\n        first_digit = int(abs_num_str[0])\n        last_digit = int(abs_num_str[-1])\n\n        if first_digit in odd_digits and last_digit in odd_digits:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of ordered index triples (i < j < k) for an integer n\n    where a[i] = i*i - i + 1 and a[i] + a[j] + a[k] is divisible by 3.\n    \"\"\"\n\n    if n < 3:\n        return 0\n\n    def _nCk_3(N):\n        # Calculates N choose 3, returning 0 if N < 3.\n        return N * (N - 1) * (N - 2) // 6\n\n    # Determine residue pattern for a[i] = i*i - i + 1 modulo 3.\n    # a[i] % 3 is 0 when i % 3 == 2.\n    # a[i] % 3 is 1 when i % 3 == 0 or i % 3 == 1.\n\n    # Count indices 'i' (from 1 to n) where a[i] % 3 == 0 (i.e., i % 3 == 2).\n    # These indices are 2, 5, 8, ..., up to n.\n    count0 = max(0, (n - 2) // 3 + 1)\n\n    # Count indices 'i' (from 1 to n) where a[i] % 3 == 1.\n    count1 = n - count0\n    \n    # For a[i] + a[j] + a[k] to be divisible by 3, their residues modulo 3 must sum to 0.\n    # Since a[x] % 3 can only be 0 or 1, the valid residue combinations are:\n    # (0, 0, 0) or (1, 1, 1).\n    \n    total_triples = _nCk_3(count0) + _nCk_3(count1)\n    \n    return total_triples"}
