{"task_id": "HumanEval/58", "solution": "```toml\n# pyproject.toml\n[project]\nname = \"common-elements\"\nversion = \"0.1.0\"\ndescription = \"A Python library to compute sorted, unique, common elements between two lists.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nkeywords = [\"lists\", \"common\", \"unique\", \"sorted\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n]\n\n[project.dependencies]\npython = \">=3.9\"\n\n[project.optional-dependencies]\ndev = [\n    \"pytest>=7.0\",\n    \"pytest-cov>=4.0\",\n]\n\n[project.scripts]\ncommon-elements = \"common_elements.__main__:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n\n```python\n# src/common_elements/__init__.py\n\"\"\"\nCommon Elements: A library for finding sorted unique common elements between lists.\n\"\"\"\nfrom typing import List, Any\n\n# Export custom exceptions for direct import\nfrom .exceptions import InvalidInputError, FileAdapterError\n\n# Export core components for programmatic use\nfrom .models import ListPair, Result\nfrom .utils import ListNormalizer\nfrom .repositories.memory_repository import MemoryRepository\nfrom .adapters.file_adapter import FileAdapter\nfrom .services import CommonService\nfrom .controllers import APIController\n\n# Initialize core services as singletons for the top-level common function.\n_normalizer = ListNormalizer()\n_memory_repo = MemoryRepository()\n_common_service = CommonService(normalizer=_normalizer, repo=_memory_repo)\n_api_controller = APIController(service=_common_service)\n\ndef common(l1: List[Any], l2: List[Any]) -> List[Any]:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    return _api_controller.common(l1, l2)\n\n__all__ = [\n    \"common\",\n    \"CommonService\",\n    \"ListNormalizer\",\n    \"MemoryRepository\",\n    \"FileAdapter\",\n    \"APIController\",\n    \"InvalidInputError\",\n    \"FileAdapterError\",\n    \"ListPair\",\n    \"Result\",\n]\n```\n\n```python\n# src/common_elements/models.py\nfrom typing import Any, List, Dict\nimport json\n\nclass ListPair:\n    \"\"\"Represents a pair of lists for input.\"\"\"\n    def __init__(self, l1: List[Any], l2: List[Any]) -> None:\n        self.l1 = l1\n        self.l2 = l2\n\n    @staticmethod\n    def from_iterables(l1: List[Any], l2: List[Any]) -> \"ListPair\":\n        \"\"\"Creates a ListPair from two iterables.\"\"\"\n        return ListPair(list(l1), list(l2))\n\nclass Result:\n    \"\"\"Represents the computed common elements result.\"\"\"\n    def __init__(self, common: List[Any]) -> None:\n        self.common = common\n\n    def to_json(self) -> str:\n        \"\"\"Returns a JSON string representation of the common elements.\"\"\"\n        return json.dumps(self.common)\n```\n\n```python\n# src/common_elements/exceptions.py\nfrom typing import Optional, Dict\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data types or formats.\"\"\"\n    def __init__(self, message: str, details: Optional[Dict] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details or {}\n\nclass FileAdapterError(Exception):\n    \"\"\"Exception raised for errors during file reading or parsing.\"\"\"\n    def __init__(self, message: str, path: str, original: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.path = path\n        self.original = original\n```\n\n```python\n# src/common_elements/utils.py\nimport json\nimport hashlib\nfrom typing import Any, List, Hashable, Iterable, Dict, Tuple, Union\n\nfrom .exceptions import InvalidInputError\n\nDEFAULT_ENCODING = \"utf-8\"\n\nclass ListNormalizer:\n    \"\"\"Normalizes lists for consistent processing, hashing, and sorting.\"\"\"\n    def __init__(self) -> None:\n        # Cache for complex object conversion to hashable tuples.\n        self._hashable_cache: Dict[int, Hashable] = {}\n\n    def _to_hashable_recursive(self, item: Any) -> Hashable:\n        \"\"\"Recursively converts an item into a hashable representation.\"\"\"\n        item_id = id(item)\n        if item_id in self._hashable_cache:\n            return self._hashable_cache[item_id]\n\n        if isinstance(item, (int, float, str, bool, type(None))):\n            return item\n\n        if isinstance(item, (list, tuple)):\n            hashable_item = tuple(self._to_hashable_recursive(sub_item) for sub_item in item)\n        elif isinstance(item, dict):\n            sorted_items = sorted(\n                ((self._to_hashable_recursive(k), self._to_hashable_recursive(v)) for k, v in item.items()),\n                key=lambda x: str(x[0])\n            )\n            hashable_item = tuple(sorted_items)\n        elif isinstance(item, set):\n            hashable_item = tuple(sorted(self._to_hashable_recursive(sub_item) for sub_item in item, key=lambda x: str(x)))\n        else:\n            try:\n                hash(item)\n                hashable_item = item\n            except TypeError:\n                raise InvalidInputError(f\"Element of type {type(item)} is not hashable and cannot be normalized.\")\n\n        # Cache the result for complex objects.\n        if not isinstance(item, (int, float, str, bool, type(None))):\n            self._hashable_cache[item_id] = hashable_item\n        return hashable_item\n\n    def normalize_list(self, l: List[Any]) -> List[Hashable]:\n        \"\"\"Validates and converts all elements in a list to hashable types.\"\"\"\n        if not isinstance(l, list):\n            raise InvalidInputError(\"Input must be a list type.\")\n        return [self._to_hashable_recursive(item) for item in l]\n\n    def canonical_key(self, l1: List[Any], l2: List[Any]) -> str:\n        \"\"\"Generates a stable, canonical string key for two lists.\"\"\"\n        norm_l1 = sorted(self.normalize_list(l1), key=lambda x: str(x))\n        norm_l2 = sorted(self.normalize_list(l2), key=lambda x: str(x))\n\n        class CanonicalEncoder(json.JSONEncoder):\n            def default(self, o):\n                if isinstance(o, (tuple, list)):\n                    return list(o)\n                if isinstance(o, set):\n                    return sorted(list(o))\n                return super().default(o)\n\n        serialized_data = json.dumps((norm_l1, norm_l2), sort_keys=True, cls=CanonicalEncoder)\n        return hashlib.sha256(serialized_data.encode(DEFAULT_ENCODING)).hexdigest()\n\n    def sort_unique(self, iterable: Iterable[Any]) -> List[Any]:\n        \"\"\"Returns a sorted list of unique elements from an iterable.\"\"\"\n        unique_elements = list(set(iterable))\n        try:\n            return sorted(unique_elements)\n        except TypeError as e:\n            raise InvalidInputError(f\"Elements in list are incomparable for sorting: {e}\")\n```\n\n```python\n# src/common_elements/repositories/memory_repository.py\nfrom collections import OrderedDict\nfrom typing import Any, List, Optional\n\nclass MemoryRepository:\n    \"\"\"In-memory LRU cache for storing computation results.\"\"\"\n    def __init__(self, capacity: int = 128) -> None:\n        if not isinstance(capacity, int) or capacity <= 0:\n            raise ValueError(\"Cache capacity must be a positive integer.\")\n        self._cache: OrderedDict[str, List[Any]] = OrderedDict()\n        self._capacity = capacity\n\n    def get(self, key: str) -> Optional[List[Any]]:\n        \"\"\"Retrieves a value from the cache by key, moving it to the front.\"\"\"\n        if key not in self._cache:\n            return None\n        value = self._cache.pop(key)\n        self._cache[key] = value\n        return value\n\n    def set(self, key: str, value: List[Any]) -> None:\n        \"\"\"Stores a value in the cache, evicting the least recently used if capacity is exceeded.\"\"\"\n        if key in self._cache:\n            self._cache.pop(key)\n        self._cache[key] = value\n        if len(self._cache) > self._capacity:\n            self._cache.popitem(last=False)\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._cache.clear()\n```\n\n```python\n# src/common_elements/adapters/file_adapter.py\nimport json\nimport os\nfrom typing import Any, List\n\nfrom common_elements.exceptions import FileAdapterError\n\nclass FileAdapter:\n    \"\"\"Reads list data from files in supported formats (JSON or newline-separated).\"\"\"\n    def read(self, path: str) -> List[Any]:\n        \"\"\"Detects file format and reads list data.\"\"\"\n        if not os.path.exists(path):\n            raise FileAdapterError(f\"File not found: {path}\", path=path)\n        if not os.path.isfile(path):\n            raise FileAdapterError(f\"Path is not a file: {path}\", path=path)\n\n        _, ext = os.path.splitext(path)\n        try:\n            if ext.lower() == '.json':\n                return self._read_json(path)\n            else:\n                return self._read_lines(path)\n        except (IOError, OSError) as e:\n            raise FileAdapterError(f\"IO error reading file: {e}\", path=path, original=e)\n        except Exception as e:\n            raise FileAdapterError(f\"Failed to parse file: {e}\", path=path, original=e)\n\n    def _read_json(self, path: str) -> List[Any]:\n        \"\"\"Reads a list from a JSON file.\"\"\"\n        with open(path, 'r', encoding='utf-8') as fh:\n            data = json.load(fh)\n        if not isinstance(data, list):\n            raise FileAdapterError(\"JSON file must contain a top-level array.\", path=path)\n        return data\n\n    def _read_lines(self, path: str) -> List[Any]:\n        \"\"\"Reads a list from a newline-separated plain text file.\"\"\"\n        items = []\n        with open(path, 'r', encoding='utf-8') as fh:\n            for line in fh:\n                stripped_line = line.strip()\n                if not stripped_line:\n                    continue\n                try:\n                    items.append(int(stripped_line))\n                except ValueError:\n                    try:\n                        items.append(float(stripped_line))\n                    except ValueError:\n                        items.append(stripped_line)\n        return items\n```\n\n```python\n# src/common_elements/services.py\nfrom typing import Any, List, Set\n\nfrom .exceptions import InvalidInputError\nfrom .utils import ListNormalizer\nfrom .repositories.memory_repository import MemoryRepository\n\nclass CommonService:\n    \"\"\"Core service to compute sorted unique common elements, with caching.\"\"\"\n    def __init__(self, normalizer: ListNormalizer, repo: MemoryRepository, use_cache: bool = True) -> None:\n        self._normalizer = normalizer\n        self._repo = repo\n        self._use_cache = use_cache\n\n    def find_common(self, l1: List[Any], l2: List[Any]) -> List[Any]:\n        \"\"\"Computes and returns sorted unique common elements between two lists.\"\"\"\n        if not isinstance(l1, list) or not isinstance(l2, list):\n            raise InvalidInputError(\"Both inputs must be list types.\")\n\n        cache_key: str = self._normalizer.canonical_key(l1, l2)\n\n        if self._use_cache:\n            cached_result = self._repo.get(cache_key)\n            if cached_result is not None:\n                return cached_result\n\n        try:\n            norm_l1: List[Hashable] = self._normalizer.normalize_list(l1)\n            norm_l2: List[Hashable] = self._normalizer.normalize_list(l2)\n\n            set_l1: Set[Hashable] = set(norm_l1)\n            set_l2: Set[Hashable] = set(norm_l2)\n\n            intersection: Set[Hashable] = set_l1.intersection(set_l2)\n            sorted_unique_common: List[Any] = self._normalizer.sort_unique(intersection)\n\n            if self._use_cache:\n                self._repo.set(cache_key, sorted_unique_common)\n            return sorted_unique_common\n        except InvalidInputError:\n            raise # Re-raise normalization errors\n        except Exception as e:\n            raise InvalidInputError(f\"An unexpected error occurred during common elements computation: {e}\", details={\"error\": str(e)})\n```\n\n```python\n# src/common_elements/controllers.py\nimport argparse\nimport json\nimport sys\nfrom typing import List, Any\n\nfrom .services import CommonService\nfrom .adapters import FileAdapter\nfrom .exceptions import InvalidInputError, FileAdapterError\n\nclass APIController:\n    \"\"\"Lightweight facade for programmatic API calls.\"\"\"\n    def __init__(self, service: CommonService) -> None:\n        self._service = service\n\n    def common(self, l1: List[Any], l2: List[Any]) -> List[Any]:\n        \"\"\"Provides a direct programmatic interface to find common elements.\"\"\"\n        return self._service.find_common(l1, l2)\n\nclass CLIController:\n    \"\"\"Handles command-line argument parsing and execution flow.\"\"\"\n    def __init__(self, service: CommonService, file_adapter: FileAdapter) -> None:\n        self._service = service\n        self._file_adapter = file_adapter\n\n    def _parse_list_string(self, s: str) -> List[Any]:\n        \"\"\"Parses a string into a list, supporting JSON or comma-separated values.\"\"\"\n        try:\n            data = json.loads(s)\n            if not isinstance(data, list):\n                raise ValueError(\"JSON string must represent a list.\")\n            return data\n        except json.JSONDecodeError:\n            items = [item.strip() for item in s.split(',')]\n            converted_items = []\n            for item in items:\n                try:\n                    converted_items.append(int(item))\n                except ValueError:\n                    try:\n                        converted_items.append(float(item))\n                    except ValueError:\n                        converted_items.append(item)\n            return converted_items\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, executes the common elements computation, and prints results.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"common-elements\",\n            description=\"Find unique common elements between two lists or files, sorted.\"\n        )\n        input_group = parser.add_mutually_exclusive_group(required=True)\n        input_group.add_argument(\n            '--file', nargs=2, metavar=('FILE1', 'FILE2'),\n            help='Paths to two files containing list data (JSON or newline-separated).'\n        )\n        input_group.add_argument(\n            '--lists', nargs=2, metavar=('LIST1_STR', 'LIST2_STR'),\n            help='Two string representations of lists (e.g., \"[1,2,3]\" or \"1,2,3,4\").'\n        )\n        parser.add_argument(\n            '--no-cache', action='store_true',\n            help='Disable caching for this request.'\n        )\n\n        args = parser.parse_args(argv[1:])\n\n        try:\n            l1, l2 = [], []\n            if args.file:\n                l1 = self._file_adapter.read(args.file[0])\n                l2 = self._file_adapter.read(args.file[1])\n            elif args.lists:\n                l1 = self._parse_list_string(args.lists[0])\n                l2 = self._parse_list_string(args.lists[1])\n\n            # Temporarily configure service for no-cache option\n            original_use_cache = self._service._use_cache\n            if args.no_cache:\n                self._service._use_cache = False\n\n            result = self._service.find_common(l1, l2)\n\n            # Restore original cache setting\n            if args.no_cache:\n                self._service._use_cache = original_use_cache\n\n            print(json.dumps(result))\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: Invalid input data. {e.message}\", file=sys.stderr)\n            if e.details:\n                print(f\"Details: {e.details}\", file=sys.stderr)\n            return 2\n        except FileAdapterError as e:\n            print(f\"File Error for '{e.path}': {e.message}\", file=sys.stderr)\n            if e.original:\n                print(f\"Original system error: {e.original}\", file=sys.stderr)\n            return 3\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n```\n\n```python\n# src/common_elements/__main__.py\nimport sys\nfrom typing import Optional\n\n# Import core components to setup the CLI environment.\nfrom .services import CommonService\nfrom .utils import ListNormalizer\nfrom .repositories.memory_repository import MemoryRepository\nfrom .adapters import FileAdapter\nfrom .controllers import CLIController\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the command-line interface.\"\"\"\n    # Initialize dependencies.\n    normalizer = ListNormalizer()\n    memory_repo = MemoryRepository()\n    common_service = CommonService(normalizer=normalizer, repo=memory_repo)\n    file_adapter = FileAdapter()\n    \n    cli_controller = CLIController(service=common_service, file_adapter=file_adapter)\n    return cli_controller.run(argv if argv is not None else sys.argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    max_prime_factor = 1\n\n    # Divide out any factors of 2\n    while n % 2 == 0:\n        max_prime_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    f = 3\n    while f * f <= n:\n        while n % f == 0:\n            max_prime_factor = f\n            n //= f\n        f += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        max_prime_factor = n\n\n    return max_prime_factor"}
