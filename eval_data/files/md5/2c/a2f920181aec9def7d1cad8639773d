t.b is None\n\n    result = service.find_pair_details([])\n    assert result.result is False\n    assert result.a is None and result.b is None\n\n    result = service.find_pair_details([0])\n    assert result.result is False\n    assert result.a is None and result.b is None\n\n```\n```python\n# tests/test_controller.py\n\nimport pytest\nfrom unittest.mock import Mock\nfrom typing import Sequence\n\nfrom src.pairs_sum.controller import PairController\nfrom src.pairs_sum.service import PairService\nfrom src.pairs_sum.validator import Validator\nfrom src.pairs_sum.exceptions import ValidationError, ControllerError\n\n@pytest.fixture\ndef mock_service() -> Mock:\n    \"\"\"Provides a mock PairService.\"\"\"\n    return Mock(spec=PairService)\n\n@pytest.fixture\ndef mock_validator() -> Mock:\n    \"\"\"Provides a mock Validator.\"\"\"\n    return Mock(spec=Validator)\n\n@pytest.fixture\ndef controller(mock_service: Mock, mock_validator: Mock) -> PairController:\n    \"\"\"Provides a PairController with mocked dependencies.\"\"\"\n    return PairController(service=mock_service, validator=mock_validator)\n\ndef test_pairs_sum_to_zero_success(controller: PairController, mock_service: Mock, mock_validator: Mock) -> None:\n    \"\"\"Tests successful invocation of pairs_sum_to_zero.\"\"\"\n    test_numbers: Sequence[int] = [1, -1, 2]\n    mock_service.find_pair_sum_zero.return_value = True\n\n    result = controller.pairs_sum_to_zero(test_numbers)\n\n    mock_validator.validate_numbers.assert_called_once_with(test_numbers)\n    mock_service.find_pair_sum_zero.assert_called_once_with(test_numbers)\n    assert result is True\n\ndef test_pairs_sum_to_zero_validation_error(controller: PairController, mock_validator: Mock) -> None:\n    \"\"\"Tests that ValidationError from validator is propagated.\"\"\"\n    test_numbers: Sequence[int] = [1, 'a', 2]\n    mock_validator.validate_numbers.side_effect = ValidationError(\"Invalid input\")\n\n    with pytest.raises(ValidationError, match=\"Invalid input\"):\n        controller.pairs_sum_to_zero(test_numbers)\n\n    mock_validator.validate_numbers.assert_called_once_with(test_numbers)\n    controller.service.find_pair_sum_zero.assert_not_called()\n\ndef test_pairs_sum_to_zero_service_unexpected_error(controller: PairController, mock_service: Mock) -> None:\n    \"\"\"Tests that unexpected errors from service are wrapped in ControllerError.\"\"\"\n    test_numbers: Sequence[int] = [1, 2, 3]\n    mock_service.find_pair_sum_zero.side_effect = ValueError(\"Service internal error\")\n\n    with pytest.raises(ControllerError, match=\"An unexpected error occurred in the controller: Service internal error\"):\n        controller.pairs_sum_to_zero(test_numbers)\n\n    mock_service.find_pair_sum_zero.assert_called_once_with(test_numbers)\n    controller.validator.validate_numbers.assert_called_once_with(test_numbers)\n\ndef test_pairs_sum_to_zero_empty_list(controller: PairController, mock_service: Mock, mock_validator: Mock) -> None:\n    \"\"\"Tests with an empty list.\"\"\"\n    test_numbers: Sequence[int] = []\n    mock_service.find_pair_sum_zero.return_value = False\n    result = controller.pairs_sum_to_zero(test_numbers)\n    assert result is False\n    mock_validator.validate_numbers.assert_called_once_with(test_numbers)\n    mock_service.find_pair_sum_zero.assert_called_once_with(test_numbers)\n\ndef test_pairs_sum_to_zero_single_element(controller: PairController, mock_service: Mock, mock_validator: Mock) -> None:\n    \"\"\"Tests with a single-element list.\"\"\"\n    test_numbers: Sequence[int] = [5]\n    mock_service.find_pair_sum_zero.return_value = False\n    result = controller.pairs_sum_to_zero(test_numbers)\n    assert result is False\n    mock_validator.validate_numbers.assert_called_once_with(test_numbers)\n    mock_service.find_pair_sum_zero.assert_called_once_with(test_numbers)\n\ndef test_pairs_sum_to_zero_integration_success() -> None:\n    \"\"\"Integration test for controller, service, and validator success path.\"\"\"\n    service = PairService()\n    validator = Validator()\n    controller = PairController(service=service, validator=validator)\n    \n    assert controller.pairs_sum_to_zero([2, 4, -5, 3, 5, 7]) is True\n    assert controller.pairs_sum_to_zero([1, 3, 5, 0]) is False\n    assert controller.pairs_sum_to_zero([0, 0]) is True\n\ndef test_pairs_sum_to_zero_integration_validation_failure() -> None:\n    \"\"\"Integration test for controller, service, and validator validation failure.\"\"\"\n    service = PairService()\n    validator = Validator()\n    controller = PairController(service=service, validator=validator)\n\n    with pytest.raises(ValidationError):\n        controller.pairs_sum_to_zero([1, 2.5, 3])\n    \n    with pytest.raises(ValidationError):\n        controller.pairs_sum_to_zero(123)\n\n    with pytest.raises(ValidationError):\n        controller.pairs_sum_to_zero([True, False])\n\n```\n```python\n# tests/test_cli.py\n\nimport pytest\nimport sys\nfrom unittest.mock import patch\nfrom io import StringIO\nfrom typing import List\n\nfrom src.pairs_sum import cli\nfrom src.pairs_sum.exceptions import ValidationError\n\ndef run_cli_main(args: List[str]) -> tuple[int, str, str]:\n    \"\"\"\n    Runs the cli.main function with given arguments and captures stdout/stderr.\n    Returns (exit_code, stdout_output, stderr_output).\n    \"\"\"\n    original_stdout = sys.stdout\n    original_stderr = sys.stderr\n    sys.stdout = StringIO()\n    sys.stderr = StringIO()\n    \n    try:\n        exit_code = cli.main(['pairs-sum-zero'] + args)\n        stdout_output = sys.stdout.getvalue()\n        stderr_output = sys.stderr.getvalue()\n    finally:\n        sys.stdout = original_stdout\n        sys.stderr = original_stderr\n    \n    return exit_code, stdout_output, stderr_output\n\ndef test_cli_success_found_space_separated() -> None:\n    \"\"\"Tests CLI with space-separated numbers that sum to zero.\"\"\"\n    exit_code, stdout, std