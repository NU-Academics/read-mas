{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by replacing vowels and swapping case of letters.\"\"\"\n    result = []\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    alphabet = 'abcdefghijklmnopqrstuvwxyz'\n    \n    for char in message:\n        if char.isalpha():\n            is_upper = char.isupper()\n            lower_char = char.lower()\n            \n            # Apply vowel replacement if character is a vowel\n            if lower_char in vowels:\n                idx = alphabet.index(lower_char)\n                shifted_char = alphabet[(idx + 2) % 26]\n                \n                # Preserve original case for the shifted vowel\n                if is_upper:\n                    interim_char = shifted_char.upper()\n                else:\n                    interim_char = shifted_char\n            else:\n                interim_char = char # Non-vowel letters remain unchanged at this step\n            \n            # Swap the case of the (possibly vowel-shifted) alphabetical character\n            result.append(interim_char.swapcase())\n        else:\n            # Non-letter characters (spaces, punctuation) are preserved\n            result.append(char)\n            \n    return \"\".join(result)"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\n    Returns None if no prime number is found in the list.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number n is prime using trial division.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the absolute value of digits of a number.\"\"\"\n        s = 0\n        for digit in str(abs(n)):\n            s += int(digit)\n        return s\n\n    largest_prime = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is not None:\n        return sum_digits(largest_prime)\n    else:\n        return None\n```"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Handles primality up to 64-bit integers efficiently.\"\"\"\n\n    # Nested helper function for primality testing\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is prime using trial division and Miller-Rabin.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n\n        # Trial division for numbers up to a moderate size.\n        if n < 1_000_000: # An arbitrary threshold to switch from trial division to Miller-Rabin.\n            i = 5\n            while i * i <= n:\n                if n % i == 0 or n % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n        \n        # Miller-Rabin primality test for larger numbers, using deterministic bases for 64-bit integers.\n        # Bases for n < 3,317,044,064,679,887,385 (maximum 64-bit unsigned integer).\n        DETERMINISTIC_BASES_64 = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in DETERMINISTIC_BASES_64:\n            # Skip bases larger than or equal to n, though for well-chosen bases, this case is rare for numbers\n            # that reach the Miller-Rabin stage.\n            if a >= n:\n                continue\n\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else: # If the loop completes without x == n - 1, then n is composite.\n                return False\n        return True\n\n    # Nested helper function to calculate the sum of digits\n    def sum_digits(num: int) -> int:\n        \"\"\"Calculates the sum of decimal digits of an integer's absolute value.\"\"\"\n        total_sum = 0\n        # Convert to string to iterate over digits; use absolute value as digits are positive.\n        for digit_char in str(abs(num)):\n            total_sum += int(digit_char)\n        return total_sum\n\n    largest_prime_found = None\n\n    # Iterate through the input list to find the largest prime value.\n    for number in lst:\n        # No isinstance() checks or type guards as per critical requirements.\n        # Assume 'number' is an integer or can be implicitly handled by `is_prime`.\n        if is_prime(number):\n            if largest_prime_found is None or number > largest_prime_found:\n                largest_prime_found = number\n\n    # If no prime number was found in the list, return 0.\n    if largest_prime_found is None:\n        return 0\n    else:\n        # Otherwise, calculate and return the sum of the digits of the largest prime.\n        return sum_digits(largest_prime_found)"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all keys in a dictionary are either all-uppercase or all-lowercase strings.\n    Returns False for empty dictionaries, non-string keys, or mixed case keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower_compatible = True\n    is_all_upper_compatible = True\n\n    for key in dict.keys():\n        # Non-string keys cause the function to return False per business rules and examples.\n        if not isinstance(key, str):\n            return False\n        \n        # Determine if the string key has any cased characters to handle \"12345\"-like keys.\n        has_cased_chars = False\n        for char in key:\n            if char.islower() or char.isupper():\n                has_cased_chars = True\n                break\n\n        # A key is considered compliant if it matches the case or has no cased characters.\n        lower_compliant = key.islower() or not has_cased_chars\n        upper_compliant = key.isupper() or not has_cased_chars\n\n        if not lower_compliant:\n            is_all_lower_compatible = False\n        \n        if not upper_compliant:\n            is_all_upper_compatible = False\n    \n    return is_all_lower_compatible or is_all_upper_compatible\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all keys in a dictionary are uniformly lower-case or upper-case strings,\n    and contain at least one cased character. Returns False for empty or invalid.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Helper function to check if a string contains at least one alphabetic character.\n    # This is required for .islower()/.isupper() to be meaningful per business rules.\n    def _has_cased_character(s: str) -> bool:\n        return any(ch.isalpha() for ch in s)\n\n    keys = list(dict.keys())\n\n    # Check if all keys are lower-case\n    all_lower = True\n    for k in keys:\n        # Per critical requirements, type checks (isinstance) are forbidden.\n        # If 'k' is not a string, calling .islower() or _has_cased_character() will raise an AttributeError.\n        if not _has_cased_character(k) or not k.islower():\n            all_lower = False\n            break\n\n    if all_lower:\n        return True\n\n    # Check if all keys are upper-case\n    all_upper = True\n    for k in keys:\n        # Per critical requirements, type checks (isinstance) are forbidden.\n        # If 'k' is not a string, calling .isupper() or _has_cased_character() will raise an AttributeError.\n        if not _has_cased_character(k) or not k.isupper():\n            all_upper = False\n            break\n\n    if all_upper:\n        return True\n\n    return False\n```"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Generates prime numbers strictly less than n using the Sieve of Eratosthenes.\n    Returns an array of these primes in ascending order.\"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array; mark 0 and 1 as not prime.\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    # Iterate up to the square root of n to mark multiples.\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            # Mark all multiples of p as not prime.\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Collect all numbers that are still marked as prime.\n    primes = [i for i, prime_status in enumerate(is_prime) if prime_status]\n    return primes"}
