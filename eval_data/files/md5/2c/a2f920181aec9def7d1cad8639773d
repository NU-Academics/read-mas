shifting them right by `shift`\n        positions, and return the result as a string.\n\n        If `shift` is greater than the number of digits, the digits are returned reversed.\n\n        Args:\n            x (int): The integer whose digits are to be shifted.\n            shift (int): The number of positions to shift right.\n\n        Returns:\n            str: The digits after the circular shift, as a string.\n\n        Raises:\n            ShiftError: If `shift` is negative.\n        \"\"\"\n        digits = self._to_digits(x)\n        n = len(digits)\n\n        if shift < 0:\n            raise ShiftError(\"shift must be non-negative\")\n        if n == 0:\n            return \"\"\n        if shift == 0:\n            return digits\n\n        # Business rule: If shift > number of digits, return digits reversed.\n        if shift > n:\n            return digits[::-1]\n\n        k = shift % n # Effective shift amount\n        return digits[-k:] + digits[:-k]\n\n    def _to_digits(self, x: int) -> str:\n        \"\"\"\n        Converts an integer to its string representation of digits.\n        Ensures '0' is returned for x=0.\n        \"\"\"\n        return str(int(x))\n\n```\n```python\n# src/digitops/validators.py\nfrom typing import Any\nfrom digitops.exceptions import InvalidInputError\n\nclass InputValidator:\n    \"\"\"\n    Validates and normalizes input values for x and shift.\n    Ensures types, ranges, and reasonable limits are met.\n    \"\"\"\n    MAX_DIGITS = 1000\n\n    def validate_x(self, x: Any) -> int:\n        \"\"\"\n        Validates if x is a non-negative integer within reasonable digit limits.\n        \"\"\"\n        try:\n            xi = int(x)\n        except (TypeError, ValueError):\n            raise InvalidInputError(\"x must be an integer.\")\n        if xi < 0:\n            raise InvalidInputError(\"x must be non-negative.\")\n        if len(str(xi)) > self.MAX_DIGITS:\n            raise InvalidInputError(f\"x has too many digits (max {self.MAX_DIGITS}).\")\n        return xi\n\n    def validate_shift(self, shift: Any) -> int:\n        \"\"\"\n        Validates if shift is a non-negative integer.\n        \"\"\"\n        try:\n            si = int(shift)\n        except (TypeError, ValueError):\n            raise InvalidInputError(\"shift must be an integer.\")\n        if si < 0:\n            raise InvalidInputError(\"shift must be non-negative.\")\n        return si\n\n    def validate_request(self, x: Any, shift: Any) -> tuple[int, int]:\n        \"\"\"\n        Validates both x and shift, returning their normalized integer values.\n        \"\"\"\n        validated_x = self.validate_x(x)\n        validated_shift = self.validate_shift(shift)\n        return validated_x, validated_shift\n\n```\n```python\n# src/digitops/service.py\nfrom typing import Any\nfrom digitops.core import CircularShifter\nfrom digitops.validators import InputValidator\nfrom digitops.schemas import ShiftResponse\nfrom digitops.exceptions import InvalidInputError, ShiftError\n\nclass ShiftService:\n    \"\"\"\n    Application service that orchestrates input validation and the circular shift operation.\n    It acts as a facade for the core algorithm and validation logic.\n    \"\"\"\n    def __init__(self, validator: InputValidator, shifter: CircularShifter):\n        \"\"\"\n        Initializes the ShiftService with a validator and a shifter instance.\n        Uses dependency injection for testability and flexibility.\n        \"\"\"\n        self.validator = validator\n        self.shifter = shifter\n\n    def shift(self, x: Any, shift: Any) -> ShiftResponse:\n        \"\"\"\n        Performs the end-to-end circular shift operation.\n        Validates inputs, calls the core algorithm, and returns a structured response.\n\n        Args:\n            x (Any): The raw input for the number to be shifted.\n            shift (Any): The raw input for the shift amount.\n\n        Returns:\n            ShiftResponse: An objec