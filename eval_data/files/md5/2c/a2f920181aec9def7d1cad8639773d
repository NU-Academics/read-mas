{"task_id": "HumanEval/34", "solution": "```python\nimport abc\nimport datetime\nimport json\nimport os\nimport uuid\nfrom typing import Callable, List, Optional\n\n\n# Exception definitions\nclass ValidationError(Exception):\n    \"\"\"Domain exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass StrategyError(Exception):\n    \"\"\"Domain exception for strategy errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n\n# Configuration constants\nDEFAULT_STRATEGY: str = \"builtin\"\nRESULTS_PATH: str = \"results.json\"\nMAX_PERSIST_SIZE: int = 10_000_000  # bytes\n\n\n# SortStrategy interface\nclass SortStrategy(abc.ABC):\n    \"\"\"Abstract strategy interface for sorting algorithms.\"\"\"\n    @abc.abstractmethod\n    def sort(self, items: list) -> list:\n        \"\"\"Return a sorted list of items without mutating input.\"\"\"\n        pass\n\n# BuiltinSortStrategy implementation\nclass BuiltinSortStrategy(SortStrategy):\n    \"\"\"Default sort using Python's built-in sorted().\"\"\"\n    def __init__(self, key: Optional[Callable] = None):\n        self._key = key\n\n    def sort(self, items: list) -> list:\n        \"\"\"Returns sorted items using Python's sorted function.\"\"\"\n        return sorted(items, key=self._key)\n\n# CountingSortStrategy implementation\nclass CountingSortStrategy(SortStrategy):\n    \"\"\"Counting sort for integer lists within a defined range.\"\"\"\n    def __init__(self, min_value: Optional[int] = None, max_value: Optional[int] = None) -> None:\n        self._min_value = min_value\n        self._max_value = max_value\n\n    def sort(self, items: list) -> list:\n        \"\"\"Sorts integers using counting sort. Assumes valid integer input due to constraints.\"\"\"\n        if not items:\n            return []\n        # CRITICAL CONSTRAINT: No isinstance checks or exception raises for edge cases.\n        # Assume items are integers and range is reasonable.\n        mn = min(items) if self._min_value is None else self._min_value\n        mx = max(items) if self._max_value is None else self._max_value\n        size = mx - mn + 1\n        counts = [0] * size\n        for v in items:\n            counts[v - mn] = 1\n        return [i + mn for i, c in enumerate(counts) if c]\n\n# InputValidator implementation\nclass InputValidator:\n    \"\"\"Validates input list structure and element comparability.\"\"\"\n    def validate(self, input_list: list) -> None:\n        \"\"\"Performs no validation due to critical constraints.\"\"\"\n        # CRITICAL CONSTRAINT: No isinstance checks or exception raises for edge cases.\n        # This method is effectively a no-op as per the critical requirements.\n        pass\n\n# ResultRepository implementation\nclass ResultRepository:\n    \"\"\"Optional persistence of result records to a JSON file.\"\"\"\n    def __init__(self, path: str = RESULTS_PATH) -> None:\n        self._path = path\n\n    def save(self, record: dict) -> None:\n        \"\"\"Appends a record to the results JSON file.\"\"\"\n        line = json.dumps(record, default=str)\n        with open(self._path, \"a\", encoding=\"utf-8\") as f:\n            f.write(line + \"\\n\")\n\n    def load_all(self) -> List[dict]:\n        \"\"\"Loads all records from the results JSON file.\"\"\"\n        if not os.path.exists(self._path):\n            return []\n        with open(self._path, \"r\", encoding=\"utf-8\") as f:\n            return [json.loads(line) for line in f if line.strip()]\n\n# UniqueService orchestrator\nclass UniqueService:\n    \"\"\"Orchestrates validation, deduplication, sorting, and optional persistence.\"\"\"\n    def __init__(self, validator: InputValidator, strategy_factory: Callable[[Optional[str]], SortStrategy], repository: Optional[ResultRepository] = None) -> None:\n        self._validator = validator\n        self._strategy_factory = strategy_factory\n        self._repository = repository\n\n    def process(self, input_list: list, strategy_name: Optional[str] = None, persist: bool = False) -> list:\n        \"\"\"Processes a list to return sorted unique elements.\"\"\"\n        self._validator.validate(input_list) # This call is effectively a no-op due to constraints.\n        unique_items = list(set(input_list))\n        strategy = self._strategy_factory(strategy_name)\n\n        # CRITICAL CONSTRAINT: Do NOT raise exceptions for edge cases.\n        # Strategy errors will propagate directly without wrapping.\n        sorted_list = strategy.sort(unique_items)\n\n        if persist and self._repository:\n            record = {\n                \"id\": str(uuid.uuid4()),\n                \"timestamp\": datetime.datetime.utcnow().isoformat() + \"Z\",\n                \"input\": input_list,\n                \"output\": sorted_list,\n                \"strategy\": strategy.__class__.__name__,\n                \"success\": True\n            }\n            try:\n                self._repository.save(record)\n            except Exception:\n                # Design allows logging persistence errors but not blocking the result.\n                pass\n        return sorted_list\n\n\n# Helpers for the public unique function\n_validator = InputValidator()\ndef _strategy_factory(name: str = None) -> SortStrategy:\n    \"\"\"Factory to create sorting strategy instances.\"\"\"\n    if (name or DEFAULT_STRATEGY) == \"counting\":\n        return CountingSortStrategy()\n    return BuiltinSortStrategy()\n\n_default_repo = ResultRepository(RESULTS_PATH)\n\n\n# Public API function unique\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements from a list.\"\"\"\n    svc = UniqueService(_validator, _strategy_factory, repository=_default_repo)\n    # CRITICAL CONSTRAINT: Use EXACT function signature from problem statement.\n    # Strategy and persist parameters are not exposed publicly via this function.\n    return svc.process(l, strategy_name=DEFAULT_STRATEGY, persist=False)\n```"}
{"task_id": "HumanEval/35", "solution": "```python\n# src/maxfinder/__init__.py\n__version__ = \"0.1.0\"\n\n\n# src/maxfinder/exceptions/invalid_input_error.py\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input types or formats.\"\"\"\n    def __init__(self, message: str = \"Invalid input provided.\"):\n        self.message = message\n        super().__init__(self.message)\n\n\n# src/maxfinder/exceptions/empty_list_error.py\nclass EmptyListError(InvalidInputError):\n    \"\"\"Exception raised when an empty list is provided as input.\"\"\"\n    def __init__(self, message: str = \"Input list is empty.\"):\n        super().__init__(message)\n\n\n# src/maxfinder/exceptions/persistence_error.py\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for errors during data persistence operations.\"\"\"\n    def __init__(self, message: str = \"Failed to persist data.\"):\n        self.message = message\n        super().__init__(self.message)\n\n\n# src/maxfinder/utils/time_provider.py\nfrom datetime import datetime, timezone\n\nclass TimeProvider:\n    \"\"\"Provides current timestamps, useful for testability.\"\"\"\n    def now_iso(self) -> str:\n        \"\"\"Returns the current UTC time in ISO 8601 format.\"\"\"\n        return datetime.now(timezone.utc).isoformat(timespec='seconds') + \"Z\"\n\n\n# src/maxfinder/validators/validator.py\nfrom maxfinder.exceptions.invalid_input_error import InvalidInputError\nfrom maxfinder.exceptions.empty_list_error import EmptyListError\n\nclass Validator:\n    \"\"\"Validates raw input data for type and content.\"\"\"\n    def validate(self, values: object) -> None:\n        \"\"\"Checks if the input is a non-empty list or tuple of numbers.\"\"\"\n        if not isinstance(values, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple.\")\n        if len(values) == 0:\n            raise EmptyListError(\"Input list is empty.\")\n        for v in values:\n            if not self._is_number(v):\n                raise InvalidInputError(f\"Non-numeric element found: {v}\")\n\n    def _is_number(self, v: object) -> bool:\n        \"\"\"Helper to check if a value is an int or float.\"\"\"\n        return isinstance(v, (int, float))\n\n\n# src/maxfinder/models/max_result.py\nfrom dataclasses import dataclass, asdict\nfrom typing import List, Any\n\n@dataclass\nclass MaxResult:\n    \"\"\"Data Transfer Object for maximum computation results.\"\"\"\n    timestamp: str\n    max_value: float\n    input_size: int\n    input_preview: List[float]\n\n    def to_dict(self) -> dict[str, Any]:\n        \"\"\"Converts the MaxResult instance to a serializable dictionary.\"\"\"\n        return asdict(self)\n\n    @staticmethod\n    def from_dict(d: dict[str, Any]) -> \"MaxResult\":\n        \"\"\"Creates a MaxResult instance from a dictionary.\"\"\"\n        return MaxResult(\n            timestamp=d[\"timestamp\"],\n            max_value=float(d[\"max_value\"]),\n            input_size=int(d[\"input_size\"]),\n            input_preview=list(d.get(\"input_preview\", []))\n        )\n\n\n# src/maxfinder/models/input_payload.py\nfrom dataclasses import dataclass\nfrom typing import List, Any\nfrom maxfinder.exceptions.invalid_input_error import InvalidInputError\n\n@dataclass\nclass InputPayload:\n    \"\"\"DTO for incoming input values, typically from API or CLI.\"\"\"\n    values: List[float]\n\n    @staticmethod\n    def from_raw(raw: Any) -> \"InputPayload\":\n        \"\"\"Parses and normalizes raw input into a list of floats.\"\"\"\n        if isinstance(raw, list):\n            try:\n                values = [float(x) for x in raw]\n            except (ValueError, TypeError) as e:\n                raise InvalidInputError(f\"List contains non-numeric elements: {e}\")\n        elif isinstance(raw, str):\n            try:\n                # Handle comma-separated string, allowing empty parts\n                values = [float(x.strip()) for x in raw.split(\",\") if x.strip()]\n            except (ValueError, TypeError) as e:\n                raise InvalidInputError(f\"String input is not a valid comma-separated list of numbers: {e}\")\n        elif isinstance(raw, dict) and \"values\" in raw:\n            return InputPayload.from_raw(raw[\"values\"]) # Recursively handle dict payload\n        else:\n            raise InvalidInputError(\"Input must be a list, comma-separated string, or dict with 'values' key.\")\n        return InputPayload(values=values)\n\n\n# src/maxfinder/repositories/list_repository.py\nfrom abc import ABC, abstractmethod\nfrom typing import List\nfrom maxfinder.models.max_result import MaxResult\n\nclass ListRepository(ABC):\n    \"\"\"Abstract Base Class defining the interface for a list persistence repository.\"\"\"\n    @abstractmethod\n    def save(self, result: MaxResult) -> None:\n        \"\"\"Saves a single MaxResult object to the repository.\"\"\"\n        pass\n\n    @abstractmethod\n    def load_all(self) -> List[MaxResult]:\n        \"\"\"Loads all stored MaxResult objects from the repository.\"\"\"\n        pass\n\n\n# src/maxfinder/repositories/file_repository.py\nimport json\nimport tempfile\nimport threading\nfrom pathlib import Path\nfrom typing import List\nfrom maxfinder.models.max_result import MaxResult\nfrom maxfinder.exceptions.persistence_error import PersistenceError\nfrom maxfinder.repositories.list_repository import ListRepository\n\nclass FileRepository(ListRepository):\n    \"\"\"Implements ListRepository for persistence to a local JSON file.\"\"\"\n    DEFAULT_PATH = \"results.json\"\n\n    def __init__(self, path: str = DEFAULT_PATH):\n        \"\"\"Initializes the repository with a file path and ensures the file exists.\"\"\"\n        self._path = Path(path)\n        self._lock = threading.Lock() # For concurrent safe writes\n        self._ensure_file()\n\n    def _ensure_file(self) -> None:\n        \"\"\"Creates an empty JSON array file if it doesn't exist.\"\"\"\n        with self._lock:\n            if not self._path.exists():\n                try:\n                    self._path.write_text(\"[]\")\n                except IOError as e:\n                    raise PersistenceError(f\"Failed to create persistence file: {e}\")\n\n    def save(self, result: MaxResult) -> None:\n        \"\"\"Appends a MaxResult to the JSON file using an atomic write.\"\"\"\n        with self._lock:\n            try:\n                # Read existing data\n                current_data: List[dict] = []\n                if self._path.exists() and self._path.stat().st_size > 0:\n                    content = self._path.read_text()\n                    if content.strip(): # Check if content is not empty\n                        current_data = json.loads(content)\n                \n                # Append new result\n                current_data.append(result.to_dict())\n\n                # Atomic write: write to temp file, then replace original\n                with tempfile.NamedTemporaryFile(mode=\"w\", delete=False, encoding=\"utf-8\") as tf:\n                    json.dump(current_data, tf, ensure_ascii=False, indent=2)\n                \n                temp_path = Path(tf.name)\n                temp_path.replace(self._path) # Atomically replace the old file\n            except (IOError, json.JSONDecodeError, Exception) as e:\n                raise PersistenceError(f\"Failed to save result to {self._path}: {e}\")\n\n    def load_all(self) -> List[MaxResult]:\n        \"\"\"Loads all MaxResult objects from the JSON file.\"\"\"\n        with self._lock:\n            if not self._path.exists() or self._path.stat().st_size == 0:\n                return []\n            try:\n                data = json.loads(self._path.read_text())\n                return [MaxResult.from_dict(d) for d in data]\n            except (IOError, json.JSONDecodeError) as e:\n                # Log error but return empty list for robustness if file is corrupted\n                print(f\"Warning: Could not load historical results from {self._path}: {e}\")\n                return []\n\n\n# src/maxfinder/config.py\n\"\"\"Central configuration settings for the MaxFinder application.\"\"\"\n\nPERSISTENCE_PATH: str = \"results.json\"\nENABLE_API_AUTH: bool = False\nAPI_KEY: str | None = None # Set via environment variable or direct config for security\n\n\n# src/maxfinder/services/max_service.py\nfrom typing import List\nfrom maxfinder.models.max_result import MaxResult\nfrom maxfinder.repositories.list_repository import ListRepository\nfrom maxfinder.validators.validator import Validator\nfrom maxfinder.utils.time_provider import TimeProvider\nfrom maxfinder.exceptions.persistence_error import PersistenceError\n\nclass MaxService:\n    \"\"\"Business logic for computing the maximum element and orchestrating persistence.\"\"\"\n    def __init__(self, repo: ListRepository | None, validator: Validator, time_provider: TimeProvider):\n        \"\"\"Initializes the service with optional repository, validator, and time provider.\"\"\"\n        self._repo = repo\n        self._validator = validator\n        self._time_provider = time_provider\n\n    def find_max(self, values: List[float], persist: bool = True) -> MaxResult:\n        \"\"\"\n        Computes the maximum value in a list, validates inputs, and optionally persists the result.\n        Raises InvalidInputError or EmptyListError for invalid inputs.\n        \"\"\"\n        self._validator.validate(values)\n\n        # Assuming values is guaranteed non-empty by validator\n        it = iter(values)\n        current_max = float(next(it)) # Initialize with first element\n        for x in it:\n            if x > current_max:\n                current_max = x\n\n        result = MaxResult(\n            timestamp=self._time_provider.now_iso(),\n            max_value=current_max,\n            input_size=len(values),\n            input_preview=list(values[:10]) # Store first 10 elements for preview\n        )\n\n        if persist and self._repo:\n            try:\n                self._repo.save(result)\n            except PersistenceError as e:\n                # Re-raise with context if needed, or log and continue\n                print(f\"Warning: Could not persist result: {e}\") \n        return result\n\n\n# src/maxfinder/cli.py\nimport argparse\nimport sys\nimport json\nimport os\nfrom typing import List, Any\nfrom maxfinder.services.max_service import MaxService\nfrom maxfinder.repositories.file_repository import FileRepository\nfrom maxfinder.validators.validator import Validator\nfrom maxfinder.utils.time_provider import TimeProvider\nfrom maxfinder.exceptions.invalid_input_error import InvalidInputError, EmptyListError\nfrom maxfinder.exceptions.persistence_error import PersistenceError\nfrom maxfinder import config # Import config for defaults\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions for the MaxFinder application.\"\"\"\n    def __init__(self, service: MaxService):\n        \"\"\"Initializes the CLI controller with a MaxService instance.\"\"\"\n        self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, computes max, prints result, and returns exit code.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"maxfinder\",\n            description=\"Finds the maximum element in a list of numbers.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        group = parser.add_mutually_exclusive_group(required=True)\n        group.add_argument(\n            \"--list\",\n            help=\"Comma-separated list of numbers (e.g., '1,2,3.5,-4').\"\n        )\n        group.add_argument(\n            \"--file\",\n            help=\"Path to a JSON file containing a list of numbers (e.g., '{\\\"values\\\": [1,2,3]}' or '[1,2,3]').\"\n        )\n        parser.add_argument(\n            \"--no-persist\",\n            action=\"store_true\",\n            help=\"Do not persist the computation result to file.\"\n        )\n        \n        args = parser.parse_args(argv[1:]) # Skip script name\n\n        try:\n            values: List[float]\n            if args.list:\n                values = self._parse_list_string(args.list)\n            elif args.file:\n                values = self._read_file(args.file)\n            else:\n                # Should not be reached due to mutually_exclusive_group and required=True\n                print(\"Error: Provide --list or --file argument.\", file=sys.stderr)\n                return 1 # Internal logic error\n\n            result = self._service.find_max(values, persist=not args.no_persist)\n            print(f\"Maximum value: {result.max_value}\")\n            return 0\n        except (InvalidInputError, EmptyListError) as e:\n            print(f\"Error: Invalid input: {e.message}\", file=sys.stderr)\n            return 1 # Bad Request equivalent\n        except PersistenceError as e:\n            print(f\"Error: Persistence failed: {e.message}\", file=sys.stderr)\n            return 3 # Persistence error\n        except FileNotFoundError:\n            print(f\"Error: File not found at '{args.file}'.\", file=sys.stderr)\n            return 4 # File not found\n        except json.JSONDecodeError:\n            print(f\"Error: Invalid JSON format in file '{args.file}'.\", file=sys.stderr)\n            return 5 # Invalid file format\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 99 # General unexpected error\n\n    def _parse_list_string(self, input_str: str) -> List[float]:\n        \"\"\"Parses a comma-separated string of numbers into a list of floats.\"\"\"\n        try:\n            return [float(x.strip()) for x in input_str.split(\",\") if x.strip()]\n        except ValueError as e:\n            raise InvalidInputError(f\"Cannot parse --list string: {e}. Ensure all elements are numbers.\")\n\n    def _read_file(self, path: str) -> List[float]:\n        \"\"\"Reads a list of numbers from a JSON file.\"\"\"\n        if not os.path.exists(path):\n            raise FileNotFoundError(f\"File not found: {path}\")\n        \n        with open(path, 'r', encoding='utf-8') as f:\n            content = f.read()\n        \n        data: Any = json.loads(content)\n        \n        # Handle both direct list and {\"values\": [...]} payload\n        if isinstance(data, dict) and \"values\" in data:\n            if not isinstance(data[\"values\"], list):\n                raise InvalidInputError(\"JSON file with 'values' key must contain a list.\")\n            return [float(x) for x in data[\"values\"]]\n        elif isinstance(data, list):\n            return [float(x) for x in data]\n        else:\n            raise InvalidInputError(\"JSON file must contain a list of numbers or an object with a 'values' key pointing to a list.\")\n\ndef main_cli():\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    # Dependency Injection setup\n    time_provider = TimeProvider()\n    validator = Validator()\n    \n    # Configure repository with path from config\n    repo = FileRepository(path=config.PERSISTENCE_PATH) \n    \n    service = MaxService(repo=repo, validator=validator, time_provider=time_provider)\n    controller = CLIController(service=service)\n    sys.exit(controller.run(sys.argv))\n\nif __name__ == \"__main__\":\n    main_cli()\n\n\n# src/maxfinder/api_app.py\nfrom fastapi import FastAPI, HTTPException, Header, status\nfrom pydantic import BaseModel\nfrom typing import List, Optional, Any\nfrom maxfinder.services.max_service import MaxService\nfrom maxfinder.validators.validator import Validator\nfrom maxfinder.utils.time_provider import TimeProvider\nfrom maxfinder.repositories.file_repository import FileRepository\nfrom maxfinder.models.max_result import MaxResult\nfrom maxfinder.exceptions.invalid_input_error import InvalidInputError, EmptyListError\nfrom maxfinder.exceptions.persistence_error import PersistenceError\nfrom maxfinder import config # Import config for defaults\n\nclass InputPayloadModel(BaseModel):\n    \"\"\"Pydantic model for validating API request body.\"\"\"\n    values: List[float]\n\ndef create_app(\n    service: MaxService | None = None,\n    persistence_path: str = config.PERSISTENCE_PATH,\n    enable_api_auth: bool = config.ENABLE_API_AUTH,\n    api_key: str | None = config.API_KEY,\n) -> FastAPI:\n    \"\"\"\n    Creates and configures the FastAPI application.\n    Allows injecting dependencies for testing.\n    \"\"\"\n    app = FastAPI(\n        title=\"MaxFinder API\",\n        description=\"A simple service to compute the maximum element in a list of numbers.\",\n        version=\"0.1.0\"\n    )\n\n    if service is None:\n        # Default dependency setup for production/standalone run\n        time_provider = TimeProvider()\n        validator = Validator()\n        repo = FileRepository(path=persistence_path)\n        service = MaxService(repo=repo, validator=validator, time_provider=time_provider)\n\n    @app.post(\"/max\", response_model=MaxResult)\n    async def compute_max(\n        payload_model: InputPayloadModel, \n        x_api_key: Optional[str] = Header(None)\n    ) -> Any:\n        \"\"\"\n        Computes the maximum value from a list of numbers provided in the request body.\n        Persists the result by default.\n        \"\"\"\n        if enable_api_auth:\n            if not api_key:\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, \n                    detail=\"API authentication enabled but API_KEY not configured.\"\n                )\n            if x_api_key != api_key:\n                raise HTTPException(\n                    status_code=status.HTTP_401_UNAUTHORIZED, \n                    detail=\"Invalid or missing API key.\"\n                )\n        \n        try:\n            result = service.find_max(payload_model.values)\n            return result.to_dict()\n        except EmptyListError as e:\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST, \n                detail=e.message\n            )\n        except InvalidInputError as e:\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST, \n                detail=e.message\n            )\n        except PersistenceError as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, \n                detail=f\"Persistence error: {e.message}\"\n            )\n        except Exception as e:\n            # Catch any unexpected errors\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, \n                detail=f\"An unexpected error occurred: {e}\"\n            )\n    \n    return app\n\n# Example of how to run the app (e.g., in a uvicorn command)\n# uvicorn maxfinder.api_app:app_instance --host 0.0.0.0 --port 8000\n# The 'app_instance' would be created in a module-level scope for uvicorn to pick up\n# For this code, a simple way would be:\napp_instance = create_app(\n    api_key=os.getenv(\"MAXFINDER_API_KEY\", config.API_KEY),\n    enable_api_auth=os.getenv(\"MAXFINDER_ENABLE_API_AUTH\", str(config.ENABLE_API_AUTH)).lower() == 'true',\n    persistence_path=os.getenv(\"MAXFINDER_PERSISTENCE_PATH\", config.PERSISTENCE_PATH)\n)\n```"}
