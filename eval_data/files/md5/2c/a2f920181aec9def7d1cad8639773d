{"task_id": "HumanEval/16", "solution": "import unicodedata\nimport re\n\ndef count_distinct_characters(string: str) -> int:\n    \"\"\"Given a string, find out how many distinct characters (regardless of case) does it consist of.\n    Applies Unicode normalization and whitespace collapsing before counting.\n    \"\"\"\n    normalized_text = unicodedata.normalize(\"NFC\", string)\n    normalized_text = re.sub(r'\\s+', ' ', normalized_text).strip()\n    \n    folded_text = normalized_text.casefold()\n    \n    return len(set(folded_text))"}
{"task_id": "HumanEval/17", "solution": "```python\nfrom dataclasses import dataclass\nfrom enum import Enum\nfrom typing import List, Optional\n\n# --- Start of src/music_parser/config.py content ---\nVALID_TOKENS: dict[str, int] = {\"o\": 4, \"o|\": 2, \".|\": 1}\n# --- End of src/music_parser/config.py content ---\n\n# --- Start of src/music_parser/note_type.py content ---\nclass NoteType(Enum):\n    WHOLE = \"WHOLE\"\n    HALF = \"HALF\"\n    QUARTER = \"QUARTER\"\n# --- End of src/music_parser/note_type.py content ---\n\n# --- Start of src/music_parser/note.py content ---\n@dataclass(frozen=True)\nclass Note:\n    id: int\n    token: str\n    beats: int\n\n    def to_int(self) -> int:\n        return self.beats\n# --- End of src/music_parser/note.py content ---\n\n# --- Start of src/music_parser/exceptions.py content ---\nclass ParseError(Exception):\n    \"\"\"Represents a parsing error with token and position metadata.\"\"\"\n    token: str\n    position: int\n\n    def __init__(self, message: str, token: str = \"\", position: int = -1):\n        super().__init__(message)\n        self.token = token\n        self.position = position\n\n    def __str__(self) -> str:\n        if self.token:\n            return f\"ParseError at position {self.position}: Unknown token '{self.token}'\"\n        return super().__str__()\n\nclass ValidationError(Exception):\n    \"\"\"Represents an input validation error.\"\"\"\n    message: str\n\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return f\"ValidationError: {self.message}\"\n# --- End of src/music_parser/exceptions.py content ---\n\n# --- Start of src/music_parser/utils.py content ---\nclass Utils:\n    \"\"\"Provides utility methods for validation and string normalization.\"\"\"\n    @staticmethod\n    def is_valid_token(token: str) -> bool:\n        \"\"\"Checks if a token is valid.\"\"\"\n        return token in VALID_TOKENS\n\n    @staticmethod\n    def normalize_whitespace(s: str) -> str:\n        \"\"\"Replaces multiple whitespaces with single spaces and strips.\"\"\"\n        return ' '.join(s.split()).strip()\n# --- End of src/music_parser/utils.py content ---\n\n# --- Start of src/music_parser/tokenizer.py content ---\nclass Tokenizer:\n    \"\"\"Splits an input music string into a list of tokens.\"\"\"\n    def tokenize(self, music_string: str) -> List[str]:\n        \"\"\"Converts raw music_string into tokens.\"\"\"\n        normalized = Utils.normalize_whitespace(music_string)\n        if not normalized:\n            return []\n        return normalized.split(\" \")\n# --- End of src/music_parser/tokenizer.py content ---\n\n# --- Start of src/music_parser/note_factory.py content ---\nclass NoteFactory:\n    \"\"\"Creates Note objects from token strings.\"\"\"\n    def create(self, token: str, index: int = 0) -> Note:\n        \"\"\"Maps a token string to a Note domain object.\"\"\"\n        # Per CRITICAL REQUIREMENTS: no explicit ParseError raising.\n        # Trust input; if token is bad, VALID_TOKENS[token] will raise KeyError.\n        beats = VALID_TOKENS[token]\n        return Note(id=index, token=token, beats=beats)\n# --- End of src/music_parser/note_factory.py content ---\n\n# --- Start of src/music_parser/parser_service.py content ---\nclass ParserService:\n    \"\"\"Orchestrates tokenization, note creation, and beat extraction.\"\"\"\n    def __init__(self, tokenizer: Optional[Tokenizer] = None, factory: Optional[NoteFactory] = None):\n        self._tokenizer = tokenizer or Tokenizer()\n        self._factory = factory or NoteFactory()\n\n    def parse(self, music_string: str) -> List[int]:\n        \"\"\"Parses a music string into a list of beat durations.\"\"\"\n        # Per CRITICAL REQUIREMENTS: no isinstance check for music_string.\n        tokens = self._tokenizer.tokenize(music_string)\n        notes = [self._factory.create(tok, idx) for idx, tok in enumerate(tokens)]\n        return [n.to_int() for n in notes]\n# --- End of src/music_parser/parser_service.py content ---\n\n# Global instance of ParserService for the public API function.\n_default_parser = ParserService()\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a simple ASCII musical notation string into a list of beat durations.\n    'o' -> 4 beats, 'o|' -> 2 beats, '.|' -> 1 beat.\n    \"\"\"\n    return _default_parser.parse(music_string)\n\n```"}
