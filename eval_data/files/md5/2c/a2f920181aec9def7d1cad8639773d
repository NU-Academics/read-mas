{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Transforms words in a string by sorting characters in ascending ASCII order,\n    preserving word order and all whitespace.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string into parts, capturing whitespace as separate elements.\n    # E.g., 'Hello World' -> ['Hello', ' ', 'World']\n    # E.g., ' Hello  World ' -> ['', ' ', 'Hello', '  ', 'World', ' ']\n    parts = re.split(r'(\\s+)', s)\n    transformed_parts = []\n\n    for part in parts:\n        if not part: # Handle empty strings that re.split might produce for leading/trailing whitespace\n            transformed_parts.append(\"\")\n        elif re.fullmatch(r'\\s+', part):\n            # If the part is entirely whitespace, preserve it.\n            transformed_parts.append(part)\n        else:\n            # If it's a word (non-whitespace), sort its characters by ASCII value.\n            sorted_chars = sorted(part, key=ord)\n            transformed_parts.append(''.join(sorted_chars))\n\n    return ''.join(transformed_parts)"}
{"task_id": "HumanEval/86", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass WordToken:\n    \"\"\"Represents a token, either a word or a sequence of spaces.\"\"\"\n    text: str\n    is_space: bool\n\ndef is_space_char(ch: str) -> bool:\n    \"\"\"Checks if a character is a whitespace character.\"\"\"\n    return ch.isspace()\n\ndef tokenize(text: str) -> List[WordToken]:\n    \"\"\"Splits text into contiguous space and non-space tokens.\"\"\"\n    tokens = []\n    if not text:\n        return tokens\n\n    buf = []\n    current_is_space = is_space_char(text[0])\n\n    for ch in text:\n        if is_space_char(ch) == current_is_space:\n            buf.append(ch)\n        else:\n            tokens.append(WordToken(''.join(buf), current_is_space))\n            buf = [ch]\n            current_is_space = is_space_char(ch)\n    \n    if buf:\n        tokens.append(WordToken(''.join(buf), current_is_space))\n        \n    return tokens\n\ndef sort_word(word: str) -> str:\n    \"\"\"Sorts characters in a word by their ASCII value.\"\"\"\n    return ''.join(sorted(word, key=ord))\n\ndef anti_shuffle(s):\n    \"\"\"\n    Transforms a string by sorting characters within each word.\n    Preserves original spacing and word order in the output.\n    \"\"\"\n    tokens = tokenize(s)\n    result_parts = []\n    for token in tokens:\n        if token.is_space:\n            result_parts.append(token.text)\n        else:\n            result_parts.append(sort_word(token.text))\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer x in a ragged 2D list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending within each row.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((r_idx, c_idx))\n    \n    found_coordinates.sort(key=lambda rc: (rc[0], -rc[1]))\n    \n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new sorted list, leaving the original array unchanged.\n    \"\"\"\n    if not array or len(array) <= 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    sum_first_last = first_element + last_element\n    \n    if sum_first_last % 2 != 0:  # Odd sum, sort ascending\n        return sorted(list(array))\n    else:  # Even sum, sort descending\n        return sorted(list(array), reverse=True)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds occurrences of x in an irregular 2D list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending within each row.\n    \"\"\"\n    from typing import List, Tuple\n\n    found_coordinates: List[Tuple[int, int]] = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort by column descending first, then by row ascending (Python's sort is stable).\n    found_coordinates.sort(key=lambda coord: coord[1], reverse=True)\n    found_coordinates.sort(key=lambda coord: coord[0])\n\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    based on the parity of the sum of its first and last elements.\n    \"\"\"\n    if len(array) <= 1:\n        return list(array) # Return a shallow copy for empty or single-element arrays\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    s = first_element + last_element\n    \n    if s % 2 != 0:  # s is odd\n        return sorted(array) # Sort in ascending order\n    else:  # s is even\n        return sorted(array, reverse=True) # Sort in descending order"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by a fixed offset.\n    Letters shift down by four positions, preserving case; non-alphabetic characters are unchanged.\n    \"\"\"\n    SHIFT = 4\n    ALPHABET_SIZE = 26\n    ASCII_LOWER_START = ord('a')\n    ASCII_UPPER_START = ord('A')\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ASCII_LOWER_START\n            offset = (ord(char) - base + SHIFT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(base + offset))\n        elif 'A' <= char <= 'Z':\n            base = ASCII_UPPER_START\n            offset = (ord(char) - base + SHIFT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(base + offset))\n        else:\n            encrypted_chars.append(char)\n    return ''.join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "```python\n# pyproject.toml\n# This file is for configuring the Python project packaging and tools.\n# It defines metadata, dependencies, and entry points for the package.\n\n[project]\nname = \"next-smallest-pkg\"\nversion = \"0.1.0\"\ndescription = \"Python library and CLI to find the second smallest distinct integer in a list.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\ndependencies = [] # No runtime third-party dependencies for core logic.\n\n[project.scripts]\nnext-smallest = \"next_smallest_pkg.__main__:main\"\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/next-smallest-pkg\"\nIssues = \"https://github.com/yourusername/next-smallest-pkg/issues\"\n\n[tool.setuptools]\npackages = [\"next_smallest_pkg\"]\npackage-dir = {\"\" = \"src\"}\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\ntestpaths = [\"tests\"]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.ruff]\n# Ruff configuration for linting and formatting.\nline-length = 100\nselect = [\"E\", \"F\", \"W\", \"I\", \"N\"] # Error, Flake8, Warnings, Isort, Naming.\nignore = []\n\n[tool.mypy]\n# Mypy configuration for type checking.\npython_version = \"3.8\"\nwarn_unused_configs = true\nwarn_redundant_casts = true\nwarn_unused_ignores = true\ndisallow_untyped_defs = true\ndisallow_incomplete_defs = true\ncheck_untyped_defs = true\nno_implicit_optional = true\nshow_error_context = true\npretty = true\n\n```\n\n```python\n# README.md\n# README.md\n# next-smallest-pkg\n\nA Python library and command-line interface (CLI) to find the second smallest *distinct* integer from a list of integers.\n\n## Features\n\n-   **Reliable Function:** `next_smallest(lst)` returns the second smallest distinct integer or `None` if not available.\n-   **CLI Utility:** Quickly compute the second smallest from a comma-separated list via `next-smallest --list \"...\"`.\n-   **Robust Validation:** Handles invalid input types and formats gracefully.\n-   **Efficient:** O(n) time complexity and O(1) space complexity for core algorithm.\n-   **Testable & Maintainable:** Follows clean design principles with unit tests and CI configuration.\n\n## Installation\n\nThis project is not yet published to PyPI. To install from source:\n\n1.  Clone the repository:\n    ```bash\n    git clone https://github.com/yourusername/next-smallest-pkg.git\n    cd next-smallest-pkg\n    ```\n2.  Install in a virtual environment:\n    ```bash\n    python -m venv .venv\n    source .venv/bin/activate # On Windows: .venv\\Scripts\\activate\n    pip install .\n    ```\n\n## Usage\n\n### Library API\n\nImport and use the `next_smallest` function in your Python code:\n\n```python\nfrom next_smallest_pkg import next_smallest, InvalidInputError\n\n# Basic usage\nprint(f\"Second smallest in [1, 2, 3, 4, 5]: {next_smallest([1, 2, 3, 4, 5])}\")\n# Output: Second smallest in [1, 2, 3, 4, 5]: 2\n\nprint(f\"Second smallest in [5, 1, 4, 3, 2]: {next_smallest([5, 1, 4, 3, 2])}\")\n# Output: Second smallest in [5, 1, 4, 3, 2]: 2\n\n# Edge cases\nprint(f\"Second smallest in []: {next_smallest([])}\")\n# Output: Second smallest in []: None\n\nprint(f\"Second smallest in [1, 1]: {next_smallest([1, 1])}\")\n# Output: Second smallest in [1, 1]: None\n\nprint(f\"Second smallest in [1, 2, 2, 3]: {next_smallest([1, 2, 2, 3])}\")\n# Output: Second smallest in [1, 2, 2, 3]: 2\n\n# Invalid input\ntry:\n    next_smallest([1, \"a\", 3])\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\")\n# Output: Error: Item at index 1 is not an int: 'a'\n```\n\n### Command-Line Interface (CLI)\n\nUse the `next-smallest` command from your terminal:\n\n```bash\n# Using the installed script\nnext-smallest --list \"1,2,3,4,5\"\n# Output: 2\n\nnext-smallest --list \"5,1,4,3,2\"\n# Output: 2\n\nnext-smallest --list \"1,1\"\n# Output: None\n\nnext-smallest --list \"\"\n# Output: None\n\nnext-smallest --list \"1,a,3\"\n# Output: Error: Could not parse token 'a' as int\n# Exit code: 2\n\n# Using python -m\npython -m next_smallest_pkg --list \"10,20,5,15,30\"\n# Output: 15\n\npython -m next_smallest_pkg --list \" 1 , 2 , 3 \"\n# Output: 2\n```\n\n## Development\n\n### Running Tests\n\nThis project uses `pytest` for unit and integration testing.\n\n```bash\n# After activating your virtual environment\npytest\n```\n\n### Type Checking\n\nThis project uses `mypy` for static type checking.\n\n```bash\n# After activating your virtual environment\nmypy src\n```\n\n### Linting\n\nThis project uses `ruff` for linting and formatting.\n\n```bash\n# After activating your virtual environment\nruff check src tests\nruff format src tests\n```\n\n### Building the Package\n\n```bash\npython -m build\n```\n\nThis will create distribution files (`.whl` and `.tar.gz`) in the `dist/` directory.\n\n## Design Decisions & Constraints\n\n-   **Language:** Python 3.8+\n-   **Dependencies:** No external third-party libraries for core logic (standard library only). `pytest` is used for testing.\n-   **Algorithm:** O(n) time, O(1) space for finding the second smallest distinct element.\n-   **Validation:** Strict input validation (list/tuple of integers only). Non-integer types or invalid list structures raise `InvalidInputError`.\n-   **Distinct Values:** Only distinct values are considered when determining the second smallest. E.g., `[1, 1, 2]` has `1` as the smallest and `2` as the second smallest.\n\n---\n```\n\n```python\n# src/next_smallest_pkg/__init__.py\n\"\"\"Public API for the next_smallest_pkg library.\"\"\"\n\nfrom typing import List, Optional\n\nfrom .exceptions import InvalidInputError\nfrom .service import NextSmallestService\nfrom .validator import ListValidator\n\n\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Returns the second smallest distinct integer from a list.\n    Returns None if there are fewer than two distinct integers.\n    \"\"\"\n    validator = ListValidator()\n    validated_list = validator.validate(lst)\n    service = NextSmallestService()\n    return service.find_second_smallest(validated_list)\n\n\n# Export the custom exception for library users.\n__all__ = [\"next_smallest\", \"InvalidInputError\"]\n\n```\n\n```python\n# src/next_smallest_pkg/__main__.py\n\"\"\"\nCLI entry point for the next_smallest_pkg module.\nThis allows running the package directly via `python -m next_smallest_pkg`.\n\"\"\"\n\nimport sys\n\nfrom .controller import CLIController\nfrom .service import NextSmallestService\nfrom .validator import ListValidator\n\n\ndef main() -> None:\n    \"\"\"Main function for the CLI entry point.\"\"\"\n    service = NextSmallestService()\n    validator = ListValidator()\n    controller = CLIController(service, validator)\n    sys.exit(controller.run(sys.argv[1:]))\n\n\nif __name__ == \"__main__\":\n    main()\n\n```\n\n```python\n# src/next_smallest_pkg/controller.py\n\"\"\"CLI and programmatic controller for next_smallest operations.\"\"\"\n\nimport argparse\nimport sys\nfrom typing import List, Optional\n\nfrom .exceptions import InvalidInputError\nfrom .service import NextSmallestService\nfrom .utils import format_result, parse_list_string\nfrom .validator import ListValidator\n\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface logic, parsing arguments and coordinating operations.\n    It orchestrates interactions between the validator and service layers.\n    \"\"\"\n\n    EXIT_OK = 0\n    EXIT_VALIDATION_ERROR = 2\n\n    def __init__(self, service: NextSmallestService, validator: ListValidator) -> None:\n        \"\"\"Initializes the CLIController with service and validator dependencies.\"\"\"\n        self._service = service\n        self._validator = validator\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Main entrypoint for the CLI. Parses arguments, handles requests, and returns an exit code.\n        Prints results or error messages to standard output.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Find the second smallest distinct integer in a list.\"\n        )\n        parser.add_argument(\n            \"--list\",\n            type=str,\n            required=True,\n            help='Comma-separated list of integers, e.g., \"1,2,3,4,5\"',\n        )\n\n        try:\n            args = parser.parse_args(argv)\n            result = self.handle_list_input(args.list)\n            print(format_result(result))\n            return self.EXIT_OK\n        except InvalidInputError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return self.EXIT_VALIDATION_ERROR\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return self.EXIT_VALIDATION_ERROR\n\n    def handle_list_input(self, list_str: str) -> Optional[int]:\n        \"\"\"\n        Parses a comma-separated string, validates it, and finds the second smallest.\n        This method allows programmatic use of the CLI's input handling logic.\n        \"\"\"\n        raw_list = parse_list_string(list_str)\n        validated_list = self._validator.validate(raw_list)\n        return self._service.find_second_smallest(validated_list)\n\n```\n\n```python\n# src/next_smallest_pkg/exceptions.py\n\"\"\"Custom exceptions for specific domain-related errors.\"\"\"\n\n\nclass InvalidInputError(Exception):\n    \"\"\"\n    Exception raised for invalid input data.\n    This includes non-list inputs or elements that are not integers.\n    \"\"\"\n\n    def __init__(self, message: str) -> None:\n        \"\"\"Initializes the InvalidInputError with a descriptive message.\"\"\"\n        super().__init__(message)\n        self.message = message\n\n```\n\n```python\n# src/next_smallest_pkg/service.py\n\"\"\"Service layer containing the core algorithm for finding the second smallest element.\"\"\"\n\nfrom typing import List, Optional, Tuple\n\n\nclass NextSmallestService:\n    \"\"\"\n    Provides the core logic to find the second smallest distinct integer in a list.\n    The algorithm is optimized for O(n) time complexity and O(1) space.\n    \"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the NextSmallestService.\"\"\"\n        pass\n\n    def find_second_smallest(self, lst: List[int]) -> Optional[int]:\n        \"\"\"\n        Computes the second smallest distinct integer in the provided list.\n        Returns None if there are fewer than two distinct integers.\n        \"\"\"\n        min1: Optional[int] = None  # Stores the smallest distinct value found.\n        min2: Optional[int] = None  # Stores the second smallest distinct value found.\n\n        for x in lst:\n            if min1 is None or x < min1:\n                if min1 is not None:\n                    min2 = min1\n                min1 = x\n            elif x != min1 and (min2 is None or x < min2):\n                min2 = x\n        return min2\n\n    def _two_minima_pass(self, lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n        \"\"\"\n        Helper method to compute the first and second distinct minima.\n        Primarily for internal use or detailed testing of the core logic.\n        \"\"\"\n        min1: Optional[int] = None\n        min2: Optional[int] = None\n        for x in lst:\n            if min1 is None or x < min1:\n                if min1 is not None:\n                    min2 = min1\n                min1 = x\n            elif x != min1 and (min2 is None or x < min2):\n                min2 = x\n        return min1, min2\n\n```\n\n```python\n# src/next_smallest_pkg/utils.py\n\"\"\"Utility functions for parsing, formatting, and other common operations.\"\"\"\n\nfrom typing import List, Optional\n\nfrom .exceptions import InvalidInputError\n\n\ndef parse_list_string(s: str) -> List[int]:\n    \"\"\"\n    Converts a comma-separated string of integers into a list of integers.\n    Raises InvalidInputError if any token cannot be parsed as an integer.\n    \"\"\"\n    if not s.strip():\n        return []\n    tokens = [t.strip() for t in s.split(\",\")]\n    result = []\n    for t in tokens:\n        if t == \"\":  # Allow for \"1,,2\" or trailing commas \"1,2,\"\n            continue\n        try:\n            result.append(int(t))\n        except ValueError as e:\n            raise InvalidInputError(f\"Could not parse token {t!r} as int\") from e\n    return result\n\n\ndef format_result(res: Optional[int]) -> str:\n    \"\"\"\n    Formats an optional integer result into a string for display.\n    Returns \"None\" if the input is None, otherwise returns the string representation of the integer.\n    \"\"\"\n    return \"None\" if res is None else str(res)\n\n```\n\n```python\n# src/next_smallest_pkg/validator.py\n\"\"\"Input validation layer for the next_smallest_pkg.\"\"\"\n\nfrom typing import Any, List\n\nfrom .exceptions import InvalidInputError\n\n\nclass ListValidator:\n    \"\"\"\n    Validates input to ensure it is a list or tuple of integers.\n    Raises InvalidInputError for non-list inputs or elements that are not integers.\n    \"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the ListValidator.\"\"\"\n        pass\n\n    def validate(self, lst: Any) -> List[int]:\n        \"\"\"\n        Validates that the input is a list or tuple containing only integers.\n        Returns a new list with the validated integers.\n        \"\"\"\n        if not isinstance(lst, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple of integers\")\n\n        validated_list: List[int] = []\n        for i, item in enumerate(lst):\n            if not isinstance(item, int):\n                raise InvalidInputError(f\"Item at index {i} is not an int: {item!r}\")\n            validated_list.append(item)\n        return validated_list\n\n```\n\n```python\n# tests/test_cli.py\n\"\"\"Unit and integration tests for the CLIController and CLI entry point.\"\"\"\n\nimport sys\nfrom io import StringIO\nfrom unittest.mock import patch\n\nimport pytest\n\nfrom next_smallest_pkg.controller import CLIController\nfrom next_smallest_pkg.exceptions import InvalidInputError\nfrom next_smallest_pkg.service import NextSmallestService\nfrom next_smallest_pkg.validator import ListValidator\n\n\n@pytest.fixture\ndef cli_controller():\n    \"\"\"Provides a CLIController instance with mocked dependencies for testing.\"\"\"\n    service = NextSmallestService()\n    validator = ListValidator()\n    return CLIController(service, validator)\n\n\ndef test_cli_success_prints_value(cli_controller):\n    \"\"\"Test successful CLI execution with a valid list, verifying output and exit code.\"\"\"\n    mock_argv = [\"--list\", \"5,1,4,3,2\"]\n    with patch(\"sys.stdout\", new=StringIO()) as fake_stdout:\n        exit_code = cli_controller.run(mock_argv)\n        assert exit_code == cli_controller.EXIT_OK\n        assert fake_stdout.getvalue().strip() == \"2\"\n\n\ndef test_cli_success_prints_none(cli_controller):\n    \"\"\"Test CLI execution for cases returning None, verifying output and exit code.\"\"\"\n    mock_argv = [\"--list\", \"1,1\"]\n    with patch(\"sys.stdout\", new=StringIO()) as fake_stdout:\n        exit_code = cli_controller.run(mock_argv)\n        assert exit_code == cli_controller.EXIT_OK\n        assert fake_stdout.getvalue().strip() == \"None\"\n\n\ndef test_cli_invalid_list_input_returns_error_code(cli_controller):\n    \"\"\"Test CLI execution with invalid list string, verifying error message and exit code.\"\"\"\n    mock_argv = [\"--list\", \"1,a,3\"]\n    with patch(\"sys.stderr\", new=StringIO()) as fake_stderr:\n        exit_code = cli_controller.run(mock_argv)\n        assert exit_code == cli_controller.EXIT_VALIDATION_ERROR\n        assert \"Error: Could not parse token 'a' as int\" in fake_stderr.getvalue()\n\n\ndef test_cli_invalid_list_type_input_returns_error_code(cli_controller):\n    \"\"\"Test CLI execution with a list containing non-integer types, verifying error message and exit code.\"\"\"\n    # Simulate parse_list_string allowing non-ints, then validator catches it.\n    with patch(\"next_smallest_pkg.utils.parse_list_string\", return_value=[1, \"a\", 3]):\n        mock_argv = [\"--list\", \"1,a,3\"]\n        with patch(\"sys.stderr\", new=StringIO()) as fake_stderr:\n            exit_code = cli_controller.run(mock_argv)\n            assert exit_code == cli_controller.EXIT_VALIDATION_ERROR\n            assert \"Error: Item at index 1 is not an int: 'a'\" in fake_stderr.getvalue()\n\n\ndef test_cli_missing_list_arg_returns_error_code(cli_controller):\n    \"\"\"Test CLI execution without the required --list argument, verifying help message and exit code.\"\"\"\n    mock_argv = []\n    with patch(\"sys.stderr\", new=StringIO()) as fake_stderr:\n        exit_code = cli_controller.run(mock_argv)\n        assert exit_code == cli_controller.EXIT_VALIDATION_ERROR\n        assert \"the following arguments are required: --list\" in fake_stderr.getvalue()\n\n\ndef test_handle_list_input_valid():\n    \"\"\"Test handle_list_input directly with valid string input.\"\"\"\n    service = NextSmallestService()\n    validator = ListValidator()\n    controller = CLIController(service, validator)\n    result = controller.handle_list_input(\"10,2,5,8,1\")\n    assert result == 2\n\n\ndef test_handle_list_input_invalid_parse():\n    \"\"\"Test handle_list_input directly with string unparseable to int.\"\"\"\n    service = NextSmallestService()\n    validator = ListValidator()\n    controller = CLIController(service, validator)\n    with pytest.raises(InvalidInputError, match=\"Could not parse token 'x' as int\"):\n        controller.handle_list_input(\"1,x,3\")\n\n\ndef test_handle_list_input_invalid_validate():\n    \"\"\"Test handle_list_input directly with input that passes parse but fails validation.\"\"\"\n    # This scenario is harder to trigger directly via string input\n    # as parse_list_string will catch non-ints.\n    # It would be more relevant if parse_list_string returned mixed types.\n    # For now, it implicitly tests that validator would raise for non-int list if utils allowed it.\n    pass # covered by cli_invalid_list_type_input_returns_error_code\n\n```\n\n```python\n# tests/test_service.py\n\"\"\"Unit tests for the NextSmallestService and its core algorithm.\"\"\"\n\nimport pytest\n\nfrom next_smallest_pkg.service import NextSmallestService\n\n\n@pytest.fixture\ndef service():\n    \"\"\"Provides a fresh NextSmallestService instance for each test.\"\"\"\n    return NextSmallestService()\n\n\n# Test cases for find_second_smallest\n@pytest.mark.parametrize(\n    \"input_list, expected_output\",\n    [\n        ([1, 2, 3, 4, 5], 2),\n        ([5, 1, 4, 3, 2], 2),\n        ([], None),\n        ([1], None),\n        ([1, 1], None),\n        ([1, 2, 2, 3], 2),\n        ([10, 20, 5, 15, 30], 10),\n        ([-5, -10, 0], -5),\n        ([7, 7, 7], None),\n        ([5, 5, 10, 10, 20], 10),\n        ([100, 1, 50, 20, 5], 5),\n        ([10, 10, 20, 20], 20),\n        ([0, 0, 1], 1),\n        ([-1, -2, -2, -3], -2),\n        ([100, 50, 10, 1], 10),\n        ([1, 100, 10, 50], 10),\n    ],\n)\ndef test_find_second_smallest(service, input_list, expected_output):\n    \"\"\"Tests the find_second_smallest method with various valid integer lists.\"\"\"\n    assert service.find_second_smallest(input_list) == expected_output\n\n\n# Test cases for _two_minima_pass (internal helper)\n@pytest.mark.parametrize(\n    \"input_list, expected_min1, expected_min2\",\n    [\n        ([1, 2, 3, 4, 5], 1, 2),\n        ([5, 1, 4, 3, 2], 1, 2),\n        ([], None, None),\n        ([1], 1, None),\n        ([1, 1], 1, None),\n        ([1, 2, 2, 3], 1, 2),\n        ([10, 20, 5, 15, 30], 5, 10),\n        ([-5, -10, 0], -10, -5),\n        ([7, 7, 7], 7, None),\n        ([5, 5, 10, 10, 20], 5, 10),\n        ([10, 10, 20, 20], 10, 20),\n        ([0, 0, 1], 0, 1),\n        ([-1, -2, -2, -3], -3, -2),\n    ],\n)\ndef test_two_minima_pass(service, input_list, expected_min1, expected_min2):\n    \"\"\"Tests the internal _two_minima_pass method to ensure correct first and second minima.\"\"\"\n    min1, min2 = service._two_minima_pass(input_list)\n    assert min1 == expected_min1\n    assert min2 == expected_min2\n\n```\n\n```python\n# tests/test_validator.py\n\"\"\"Unit tests for the ListValidator class.\"\"\"\n\nimport pytest\n\nfrom next_smallest_pkg.exceptions import InvalidInputError\nfrom next_smallest_pkg.validator import ListValidator\n\n\n@pytest.fixture\ndef validator():\n    \"\"\"Provides a fresh ListValidator instance for each test.\"\"\"\n    return ListValidator()\n\n\ndef test_validate_valid_list_of_ints(validator):\n    \"\"\"Tests validation with a standard list of integers.\"\"\"\n    lst = [1, 2, 3, 4, 5]\n    result = validator.validate(lst)\n    assert result == lst\n    assert isinstance(result, list)\n\n\ndef test_validate_valid_tuple_of_ints(validator):\n    \"\"\"Tests validation with a tuple of integers.\"\"\"\n    tup = (10, 20, 30)\n    result = validator.validate(tup)\n    assert result == list(tup)\n    assert isinstance(result, list)\n\n\ndef test_validate_empty_list(validator):\n    \"\"\"Tests validation with an empty list.\"\"\"\n    lst: List[int] = []\n    result = validator.validate(lst)\n    assert result == []\n    assert isinstance(result, list)\n\n\ndef test_validate_non_list_or_tuple_input_raises_error(validator):\n    \"\"\"Tests that non-list/tuple inputs raise InvalidInputError.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"Input must be a list or tuple of integers\"):\n        validator.validate(\"not a list\")\n    with pytest.raises(InvalidInputError, match=\"Input must be a list or tuple of integers\"):\n        validator.validate(123)\n    with pytest.raises(InvalidInputError, match=\"Input must be a list or tuple of integers\"):\n        validator.validate(None)\n\n\ndef test_validate_list_with_non_integer_elements_raises_error(validator):\n    \"\"\"Tests that lists containing non-integer elements raise InvalidInputError.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"Item at index 1 is not an int: 'b'\"):\n        validator.validate([1, \"b\", 3])\n    with pytest.raises(InvalidInputError, match=\"Item at index 0 is not an int: 1.0\"):\n        validator.validate([1.0, 2, 3])\n    with pytest.raises(InvalidInputError, match=\"Item at index 2 is not an int: None\"):\n        validator.validate([1, 2, None])\n    with pytest.raises(InvalidInputError, match=\"Item at index 0 is not an int: \\\\[1\\\\]\"):\n        validator.validate([[1], 2, 3])\n\n\ndef test_validate_list_with_mixed_types_raises_error(validator):\n    \"\"\"Tests that lists with mixed valid and invalid types raise an error at the first invalid element.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"Item at index 2 is not an int: 3.5\"):\n        validator.validate([1, 2, 3.5, 4])\n\n\ndef test_validate_large_list(validator):\n    \"\"\"Tests validation with a moderately large list of integers.\"\"\"\n    large_list = list(range(10**5))\n    result = validator.validate(large_list)\n    assert len(result) == 10**5\n    assert all(isinstance(x, int) for x in result)\n\n```\n\n```python\n# tox.ini\n# tox.ini\n# This file configures tox, a generic virtualenv management and test tool.\n# It defines test environments for various Python versions and tools like pytest, mypy, and ruff.\n\n[tox]\nmin_version = 4.0\nenv_list =\n    py{38,39,310,311}-test\n    py-lint\n    py-type\n\n[testenv]\npackage = skip\nbase_python = python{env_major}{env_minor}\nisolated_build = True\nset_env =\n    PYTHONPATH = {tox_root}/src\ncommands =\n    pytest {posargs:tests}\n\n[testenv:py-lint]\ndescription = Run linters\nbase_python = python3.11\ndeps =\n    ruff\ncommand