tance(arr, (list, tuple)):\n        raise ValidationError(\"Input must be a list or tuple.\")\n\n    if not arr:\n        return []\n\n    validated_arr = []\n    for i, item in enumerate(arr):\n        if isinstance(item, int):\n            validated_arr.append(item)\n        elif isinstance(item, str):\n            try:\n                validated_arr.append(int(item))\n            except ValueError:\n                raise ValidationError(f\"Element at index {i} is not a valid integer: '{item}'.\")\n        else:\n            raise ValidationError(f\"Element at index {i} is not an integer: '{item}'.\")\n    return validated_arr\n\n```\n```python\n# src/smallest_change/RequestLogRepository.py\nfrom typing import List, Dict, Any, Optional\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nclass RequestLogRepository:\n    \"\"\"Abstract repository interface for storing request logs.\"\"\"\n    def insert(self, payload: Dict[str, Any]) -> None:\n        \"\"\"Persist a payload dictionary.\"\"\"\n        raise NotImplementedError\n\n    def query_recent(self, limit: int = 100) -> List[Dict[str, Any]]:\n        \"\"\"Return most recent logs up to a limit.\"\"\"\n        raise NotImplementedError\n\nclass InMemoryRequestLogRepository(RequestLogRepository):\n    \"\"\"In-memory implementation of RequestLogRepository for testing or fallback.\"\"\"\n    def __init__(self):\n        self._store: List[Dict[str, Any]] = []\n\n    def insert(self, payload: Dict[str, Any]) -> None:\n        \"\"\"Append payload to the in-memory store.\"\"\"\n        self._store.append(payload)\n        logger.debug(f\"Logged to in-memory: {payload}\")\n\n    def query_recent(self, limit: int = 100) -> List[Dict[str, Any]]:\n        \"\"\"Return a slice of the in-memory store.\"\"\"\n        return self._store[-limit:]\n\n```\n```python\n# src/smallest_change/SQLiteAdapter.py\nimport sqlite3\nimport json\nfrom typing import List, Dict, Any, Optional\nfrom .RequestLogRepository import RequestLogRepository\nfrom .Exceptions import PersistenceError\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nCREATE_TABLE_SQL = \"\"\"\nCREATE TABLE IF NOT EXISTS request_log (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    source TEXT NOT NULL,\n    payload TEXT NOT NULL,\n    result INTEGER NOT NULL,\n    ts TEXT NOT NULL\n);\n\"\"\"\nCREATE_INDEX_TS_SQL = \"CREATE INDEX IF NOT EXISTS idx_request_log_ts ON request_log(ts DESC);\"\nCREATE_INDEX_SOURCE_SQL = \"CREATE INDEX IF NOT EXISTS idx_request_log_source ON request_log(source);\"\n\nclass SQLiteAdapter(RequestLogRepository):\n    \"\"\"SQLite-backed implementation of RequestLogRepository.\"\"\"\n    def __init__(self, db_path: str):\n        self.db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n        self._ensure_tables()\n\n    @property\n    def conn(self) -> sqlite3.Connection:\n        \"\"\"Lazy loads and returns the database connection.\"\"\"\n        if self._conn is None:\n            try:\n                self._conn = sqlite3.connect(self.db_path, check_same_thread=False)\n                self._conn.row_factory = sqlite3.Row # Allows dict-like access\n            except sqlite3.Error as e:\n                raise PersistenceError(f\"Failed to connect to SQLite DB at {self.db_path}: {e}\")\n        return self._conn\n\n    def _ensure_tables(self) -> None:\n        \"\"\"Create necessary tables and indexes if they don't exist.\"\"\"\n        try:\n            cursor = self.conn.cursor()\n            cursor.execute(CREATE_TABLE_SQL)\n            cursor.execute(CREATE_INDEX_TS_SQL)\n            cursor.execute(CREATE_INDEX_SOURCE_SQL)\n            self.conn.commit()\n            logger.info(f\"SQLite tables ensured in {self.db_path}\")\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Failed to ensure SQLite tables: {e}\")\n\n    def insert(self, payload: Dict[str, Any]) -> None:\n        \"\"\"Insert a log entry into the request_log table.\"\"\"\n        try:\n            payload_json = json.dumps(payload[\"payload\"])\n            cursor = self.conn.cursor()\n            cursor.execute(\n                \"INSERT INTO request_log (source, payload, result, ts) VALUES (?, ?, ?, ?)\",\n                (payload[\"source\"], payload_json, payload[\"result\"], payload[\"ts\"].isoformat())\n            )\n            self.conn.commit()\n            logger.debug(f\"Inserted log into SQLite: {payload}\")\n        except sqlite3.OperationalError as e:\n            # Catch specific DB locking/busy errors to allow retries or graceful degradation\n            self.conn.rollback()\n            raise PersistenceError(f\"SQLite operational error during insert: {e}\")\n        except sqlite3.Error as e:\n            self.conn.rollback()\n            raise PersistenceError(f\"Failed to insert log into SQLite: {e}\")\n        except Exception as e:\n            raise PersistenceError(f\"Unexpected error during SQLite insert: {e}\")\n\n    def query_recent(self, limit: int = 100) -> List[Dict[str, Any]]:\n        \"\"\"Query recent log entries from the request_log table.\"\"\"\n        try:\n            cursor = self.conn.cursor()\n            cursor.execute(\n                \"SELECT id, source, payload, result, ts FROM request_log ORDER BY ts DESC LIMIT ?\",\n                (limit,)\n            )\n            rows = cursor.fetchall()\n            results = []\n            for row in rows:\n                row_dict = dict(row)\n                row_dict[\"payload\"] = json.loads(row_dict[\"payload\"])\n                results.append(row_dict)\n            return results\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Failed to query recent logs from SQLite: {e}\")\n\n```\n```python\n# src/smallest_change/adapters/AsyncLogger.py\nimport logging\nfrom concurrent.futures import ThreadPoolExecutor\nfrom typing import Dict, Any, List\nfrom ..RequestLogRepository import RequestLogRepository\nfrom ..Exceptions import PersistenceError\n\nlogger = logging.getLogger(__name__)\n\nclass AsyncLogger(RequestLogRepository):\n    \"\"\"Wraps a RequestLogRepository to perform insertions asynchronously using a ThreadPoolExecutor.\"\"\"\n    def __init__(self, repo: RequestLogRepository, max_workers: int = 2):\n        self.repo = repo\n        self.executor = ThreadPoolExecutor(max_workers=max_workers)\n        logger.info(f\"AsyncLogger initialized with {max_workers} workers.\")\n\n    def _insert_task(self, payload: Dict[str, Any]) -> None:\n        \"\"\"The actual insert operation executed in a separate thread.\"\"\"\n        try:\n            self.repo.insert(payload)\n        except PersistenceError as e:\n            logger.warning(f\"Async logging failed for payload {payload.get('source', 'unknown')}/{payload.get('ts', 'unknown')}: {e}\")\n        except Exception as e:\n            logger.error(f\"Unexpected error in async logging task for {payload.get('source', 'unknown')}/{payload.get('ts', 'unknown')}: {e}\", exc_info=True)\n\n    def insert(self, payload: Dict[str, Any]) -> None:\n        \"\"\"Submit an insert operation to the thread pool executor.\"\"\"\n        try:\n            self.executor.submit(self._insert_task, payload)\n        except Exception as e:\n            logger.error(f\"Failed to submit log to async executor for {payload.get('source', 'unknown')}/{payload.get('ts', 'unknown')}: {e}\", exc_info=True)\n            self._insert_task(payload) # Attempt synchronous fallback if submission fails\n\n    def query_recent(self, limit: int = 100) -> List[Dict[str, Any]]:\n        \"\"\"Delegates query_recent synchronously to the underlying repository.\"\"\"\n        return self.repo.query_recent(limit)\n\n    def shutdown(self, wait: bool = True) -> None:\n        \"\"\"Shutdown the thread pool executor.\"\"\"\n        logger.info(\"Shutting down AsyncLogger executor...\")\n        self.executor.shutdown(wait=wait)\n        logger.info(\"AsyncLogger executor shut down.\")\n\n```\n```python\n# src/smallest_change/Config.py\nimport os\nimport logging\nfrom typing import Optional\n\nfrom .RequestLogRepository import RequestLogRepository, InMemoryRequestLogRepository\nfrom .SQLiteAdapter import SQLiteAdapter\nfrom .adapters.AsyncLogger import AsyncLogger\n\nlogger = logging.getLogger(__name__)\n\nclass Config:\n    \"\"\"Centralized application configuration and dependency injection factory.\"\"\"\n    DEFAULT_DB_PATH = \"smallest_change.db\"\n    DEFAULT_RETENTION_DAYS = 90\n\n    def __init__(self,\n                 db_path: str,\n                 api_host: str,\n                 api_port: int,\n                 enable_auth: bool,\n                 api_key: Optional[str],\n                 log_async_batch_size: int = 1, # Not explicitly used for batching in AsyncLogger current impl\n                 async_logging_enabled: bool = True):\n        self.DB_PATH = db_path\n        self.API_HOST = api_host\n        self.API_PORT = api_port\n        self.ENABLE_AUTH = enable_auth\n        self.API_KEY = api_key\n        self.LOG_ASYNC_BATCH_SIZE = log_async_batch_size\n        self.ASYNC_LOGGING_ENABLED = async_logging_enabled\n\n    @classmethod\n    def from_env(cls) -> \"Config\":\n        \"\"\"Construct Config from environment variables, falling back to defaults.\"\"\"\n        db_path = os.getenv(\"SMALLEST_CHANGE_DB_PATH\", cls.DEFAULT_DB_PATH)\n        api_host = os.getenv(\"SMALLEST_CHANGE_API_HOST\", \"127.0.0.1\")\n        api_port = int(os.getenv(\"SMALLEST_CHANGE_API_PORT\", \"8000\"))\n        enable_auth = os.getenv(\"SMALLEST_CHANGE_ENABLE_AUTH\", \"false\").lower() == \"true\"\n        api_key = os.getenv(\"SMALLEST_CHANGE_API_KEY\") if enable_auth else None\n        async_logging = os.getenv(\"SMALLEST_CHANGE_ASYNC_LOGGING\", \"true\").lower() == \"true\"\n\n        logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n\n        return cls(\n            db_path=db_path,\n            api_host=api_host,\n            api_port=api_port,\n            enable_auth=enable_auth,\n            api_key=api_key,\n            async_logging_enabled=async_logging\n        )\n\n    def create_request_logger(self) -> RequestLogRepository:\n        \"\"\"Create and return the configured RequestLogRepository instance.\"\"\"\n        try:\n            sqlite_adapter = SQLiteAdapter(self.DB_PATH)\n            if self.ASYNC_LOGGING_ENABLED:\n                logger.info(\"Using AsyncLogger for request logging.\")\n                return AsyncLogger(repo=sqlite_adapter)\n            else:\n                logger.info(\"Using synchronous SQLiteAdapter for request logging.\")\n                return sqlite_adapter\n        except PersistenceError as e:\n            logger.error(f\"Failed to initialize SQLiteAdapter, falling back to InMemoryRequestLogRepository: {e}\")\n            return InMemoryRequestLogRepository()\n        except Exception as e:\n            logger.error(f\"Unexpected error creating request logger, falling back to InMemory: {e}\")\n            return InMemoryRequestLogRepository()\n\n```\n```python\n# src/smallest_change/SmallestChangeService.py\nfrom typing import List\nimport logging\nfrom .RequestDTO import RequestDTO\nfrom .ResponseDTO import ResponseDTO\nfrom .RequestLogRepository import RequestLogRepository, InMemoryRequestLogRepository\nimport json # Used for payload serialization (implicitly handled by SQLiteAdapter)\n\nlogger = logging.getLogger(__name__)\n\nclass SmallestChangeService:\n    \"\"\"Core algorithm and service orchestration for computing smallest changes.\"\"\"\n    def __init__(self, logger_repo: RequestLogRepository = None) -> None:\n        self.logger: RequestLogRepository = logger_repo if logger_repo is not None else InMemoryRequestLogRepository()\n\n    def smallest_change(self, arr: List[int]) -> int:\n        \"\"\"Computes the minimum number of changes to make an array palindromic.\"\"\"\n        n = len(arr)\n        count = 0\n        for i in range(n // 2):\n            if arr[i] != arr[n - 1 - i]:\n                count += 1\n        return count\n\n    def compute_and_log(self, req: RequestDTO) -> ResponseDTO:\n        \"\"\"Computes the result and asynchronously logs the request and result.\"\"\"\n        changes = self.smallest_change(req.array)\n        resp = ResponseDTO(changes=changes)\n\n        log_payload = {\n            \"source\": req.source,\n            \"payload\": req.array,\n            \"result\": resp.changes,\n            \"ts\": req.timestamp\n        }\n        try:\n            self.logger.insert(log_payload)\n        except Exception as e:\n            logger.warning(f\"Failed to log request for source {req.source} at {req.timestamp}: {e}\")\n\n        return resp\n\n```\n```python\n# src/smallest_change/controllers/CLIController.py\nimport sys\nimport argparse\nimport json\nfrom typing import List, Any\n\nfrom ..SmallestChangeService import SmallestChangeService\nfrom ..RequestDTO import RequestDTO\nfrom ..ResponseDTO import ResponseDTO\nfrom ..Validators import validate_array\nfrom ..Exceptions import ValidationError\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"Handles command-line interface parsing and orchestration for smallest-change.\"\"\"\n    def __init__(self, service: SmallestChangeService):\n        self.service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, computes, logs, and prints results for CLI requests.\"\"\"\n        parser = argparse.ArgumentParser(description=\"Compute smallest changes to make an array palindromic.\")\n        subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n        compute_parser = subparsers.add_parser(\"compute\", help=\"Compute smallest changes for an array.\")\n        compute_parser.add_argument(\"--json\", type=str, help=\"JSON string representing the integer array, e.g., '[1,2,3]'.\")\n        compute_parser.add_argument(\"integers\", nargs=\"*\", type=str, help=\"Whitespace-separated integers, e.g., '1 2 3'.\")\n\n        args = parser.parse_args(argv[1:])\n\n        arr_raw: Any = None\n        if args.json:\n            try:\n                arr_raw = json.loads(args.json)\n            except json.JSONDecodeError:\n                print(json.dumps({\"error\": \"Invalid JSON input for --json argument.\"}), file=sys.stderr)\n                return 2\n        elif args.integers:\n            arr_raw = args.integers\n        else:\n            print(json.dumps({\"error\": \"Please provide input using --json or whitespace-separated integers.\"}), file=sys.stderr)\n            return 2\n\n        try:\n            validated_arr = validate_array(arr_raw)\n            req = RequestDTO(array=validated_arr, source=\"cli\")\n            resp = self.service.compute_and_log(req)\n            print(json.dumps(resp.to_dict()))\n            return 0\n        except ValidationError as e:\n            print(json.dumps({\"error\": e.message}), file=sys.stderr)\n            return 2\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI computation.\")\n            print(json.dumps({\"error\": \"An internal server error occurred.\"}), file=sys.stderr)\n            return 1\n\n```\n```python\n# src/smallest_change/controllers/APIController.py\nfrom fastapi import FastAPI, HTTPException, status, Request, Header\nfrom fastapi.responses import JSONResponse\nfrom typing import Dict, Any, Optional\nimport logging\nimport uvicorn\n\nfrom ..SmallestChangeService import SmallestChangeService\nfrom ..RequestDTO import RequestDTO\nfrom ..ResponseDTO import ResponseDTO\nfrom ..Validators import validate_array\nfrom ..Exceptions import ValidationError\nfrom ..Config import Config\nfrom ..__version__ import __version__\n\nlogger = logging.getLogger(__name__)\n\nclass APIController:\n    \"\"\"FastAPI application factory and route definitions for the smallest-change API.\"\"\"\n    def __init__(self, service: SmallestChangeService, config: Config):\n        self.service = service\n        self.config = config\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Creates and configures the FastAPI application.\"\"\"\n        app = FastAPI(\n            title=\"Smallest Change Palindrome API\",\n            description=\"API to compute the minimum changes to make an array palindromic.\",\n            version=__version__\n        )\n\n        @app.middleware(\"http\")\n        async def auth_middleware(request: Request, call_next):\n            \"\"\"Middleware for optional API key authentication.\"\"\"\n            if self.config.ENABLE_AUTH:\n                api_key = request.headers.get(\"X-API-KEY\")\n                if not api_key or api_key != self.config.API_KEY:\n                    return JSONResponse(\n                        status_code=status.HTTP_401_UNAUTHORIZED,\n                        content={\"error\": \"Unauthorized\"}\n                    )\n            response = await call_next(request)\n            return response\n\n        @app.post(\"/api/v1/smallest-change\", response_model=ResponseDTO, status_code=status.HTTP_200_OK)\n        async def compute_smallest_change(payload: Dict[str, Any]):\n            \"\"\"\n            Computes the minimum number of changes to make an array palindromic.\n            Accepts a JSON object with an \"array\" field containing a list of integers.\n            \"\"\"\n            try:\n                arr_raw = payload.get(\"array\")\n                if arr_raw is None:\n                    raise ValidationError(\"Request body must contain an 'array' field.\")\n\n                validated_arr = validate_array(arr_raw)\n                req = RequestDTO(array=validated_arr, source=\"api\")\n                resp = self.service.compute_and_log(req)\n                return {\"changes\": resp.changes}\n            except ValidationError as e:\n                raise HTTPException(status_code=e.status_code, detail={\"error\": e.message})\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred during API computation.\")\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": \"An internal server error occurred.\"}\n                )\n\n        @app.get(\"/api/v1/health\", status_code=status.HTTP_200_OK)\n        async def health_check():\n            \"\"\"Health check endpoint.\"\"\"\n            return {\"status\": \"ok\", \"version\": __version__}\n        \n        return app\n\n```\n```python\n# src/smallest_change/main.py\nimport sys\nimport os\nimport uvicorn\nimport logging\nfrom typing import List\n\nfrom .Config import Config\nfrom .controllers.CLIController import CLIController\nfrom .controllers.APIController import APIController\nfrom .SmallestChangeService import SmallestChangeService\nfrom .adapters.AsyncLogger import AsyncLogger\n\nlogger = logging.getLogger(__name__)\n\ndef run_cli(argv: List[str]) -> int:\n    \"\"\"Initializes config, services, and runs the CLI controller.\"\"\"\n    config = Config.from_env()\n    request_logger = config.create_request_logger()\n    service = SmallestChangeService(logger_repo=request_logger)\n    cli_controller = CLIController(service=service)\n    \n    try:\n        return cli_controller.run(argv)\n    finally:\n        if isinstance(request_logger, AsyncLogger):\n            request_logger.shutdown(wait=True)\n            \ndef run_api() -> None:\n    \"\"\"Initializes config, services, and runs the FastAPI application.\"\"\"\n    config = Config.from_env()\n    request_logger = config.create_request_logger()\n    service = SmallestChangeService(logger_repo=request_logger)\n    api_controller = APIController(service=service, config=config)\n    app = api_controller.create_app()\n\n    @app.on_event(\"shutdown\")\n    async def shutdown_event():\n        if isinstance(request_logger, AsyncLogger):\n            request_logger.shutdown(wait=True)\n            logger.info(\"FastAPI application shutdown complete, AsyncLogger gracefully stopped.\")\n\n    logger.info(f\"Starting API server on {config.API_HOST}:{config.API_PORT}\")\n    uvicorn.run(app, host=config.API_HOST, port=config.API_PORT)\n\nif __name__ == \"__main__\":\n    if len(sys.argv) > 1 and sys.argv[1] == \"api\":\n        run_api()\n    else: # Default to CLI, or if subcommand is 'compute'\n        sys.exit(run_cli(sys.argv))\n\n```\n```toml\n# pyproject.toml\n[tool.poetry]\nname = \"smallest-change\"\nversion = \"0.1.0\"\ndescription = \"Python library, CLI, and API for computing the minimum changes to make an array palindromic.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{include = \"smallest_change\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \"^3.9\"\nfastapi = \"^0.111.0\"\nuvicorn = {extras = [\"standard\"], version = \"^0.30.1\"}\npydantic = \"^2.7.4\"\npydantic-settings = \"^2.3.4\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\nmypy = \"^1.10.0\"\nblack = \"^24.4.2\"\nflake8 = \"^7.1.0\"\n\n[tool.poetry.scripts]\nsmallest-change = \"smallest_change.main:run_cli\"\nsmallest-change-api = \"smallest_change.main:run_api\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n```\n```markdown\n# README.md\n# Smallest Change Palindrome Project\n\nThis project provides a Python library, a command-line interface (CLI) tool, and a small HTTP API to compute the minimum number of element changes required to turn an integer array into a palindrome.\n\n## Features\n\n-   **Core Library**: `smallest_change(arr: List[int]) -> int` function to compute the changes.\n-   **CLI Tool**: `smallest-change compute` to get results from the command line with JSON input/output.\n-   **HTTP API**: A REST endpoint `POST /api/v1/smallest-change` for programmatic integration.\n-   **Auditing**: All requests and results are logged asynchronously to a local SQLite database.\n\n## Installation\n\n### Prerequisites\n\n-   Python 3.9+\n-   Poetry (recommended for dependency management)\n\n### Steps\n\n1.  **Clone the repository**:\n    ```bash\n    git clone https://github.com/yourusername/smallest-change.git\n    cd smallest-change\n    ```\n\n2.  **Install dependencies using Poetry**:\n    ```bash\n    poetry install\n    ```\n\n    If you prefer `pip` or other tools, you can generate a `requirements.txt` from `pyproject.toml` using `poetry export -f requirements.txt --output requirements.txt --without-hashes` and then `pip install -r requirements.txt`.\n\n## Usage\n\n### CLI Tool\n\nThe CLI tool is available via the `smallest-change` command after installation.\n\n**Compute changes from JSON input:**\n\n```bash\npoetry run smallest-change compute --json '[1,2,3,5,4,7,9,6]'\n# Expected Output: {\"changes\": 4}\n\npoetry run smallest-change compute --json '[1,2,3,4,3,2,2]'\n# Expected Output: {\"changes\": 1}\n```\n\n**Compute changes from whitespace-separated integers:**\n\n```bash\npoetry run smallest-change compute 1 2 3 5 4 7 9 6\n# Expected Output: {\"changes\": 4}\n\npoetry run smallest-change compute 1 2 3 2 1\n# Expected Output: {\"changes\": 0}\n```\n\n**Error Handling (CLI):**\n\n```bash\npoetry run smallest-change compute --json '[1,2,\"three\"]'\n# Expected Output to stderr: {\"error\": \"Element at index 2 is not an integer: 'three'.\"}\n```\n\n### HTTP API\n\nThe HTTP API can be started using the `smallest-change-api` command.\n\n**Start the API server:**\n\n```bash\npoetry run smallest-change-api\n# Info: Uvicorn will start on http://127.0.0.1:8000 (default)\n```\n\n**Send a POST request:**\n\n```bash\ncurl -X POST \"http://127.0.0.1:8000/api/v1/smallest-change\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"array\": [1,2,3,5,4,7,9,6]}'\n# Expected Output: {\"changes\": 4}\n```\n\n**Health Check:**\n\n```bash\ncurl http://127.0.0.1:8000/api/v1/health\n# Expected Output: {\"status\": \"ok\", \"version\": \"0.1.0\"}\n```\n\n**Error Handling (API):**\n\n```bash\ncurl -X POST \"http://127.0.0.1:8000/api/v1/smallest-change\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"array\": [1,2,\"invalid\"]}'\n# Expected Output (HTTP 400): {\"detail\":{\"error\":\"Element at index 2 is not an integer: 'invalid'.\"}}\n```\n\n### Configuration (Environment Variables)\n\nYou can configure the application using environment variables:\n\n-   `SMALLEST_CHANGE_DB_PATH`: Path to the SQLite database file (default: `smallest_change.db`).\n-   `SMALLEST_CHANGE_API_HOST`: Host for the API server (default: `127.0.0.1`).\n-   `SMALLEST_CHANGE_API_PORT`: Port for the API server (default: `8000`).\n-   `SMALLEST_CHANGE_ENABLE_AUTH`: Set to `true` to enable API key authentication (default: `false`).\n-   `SMALLEST_CHANGE_API_KEY`: The API key to use if `SMALLEST_CHANGE_ENABLE_AUTH` is `true`.\n-   `SMALLEST_CHANGE_ASYNC_LOGGING`: Set to `false` to disable asynchronous logging (default: `true`).\n\nExample with authentication:\n\n```bash\nexport SMALLEST_CHANGE_ENABLE_AUTH=true\nexport SMALLEST_CHANGE_API_KEY=\"mysecrettoken123\"\npoetry run smallest-change-api\n```\n\nThen, to access the API:\n\n```bash\ncurl -X POST \"http://127.0.0.1:8000/api/v1/smallest-change\" \\\n     -H \"Content-Type: application/json\" \\\n     -H \"X-API-KEY: mysecrettoken123\" \\\n     -d '{\"array\": [1,2,3]}'\n```\n\n## Database and Logging\n\nAll API and CLI requests and their computed results are logged to a SQLite database. By default, this is stored in `smallest_change.db` in the project root.\n\nThe logging is performed asynchronously to avoid blocking the request/response cycle, ensuring good performance.\n\n### Database Cleanup Script\n\nAn optional script is provided to clean up old log entries.\n\n```bash\npython scripts/cleanup_db.py --days 90\n```\nThis will delete log entries older than 90 days. You can configure the default retention period in `src/smallest_change/Config.py` or specify it via the `--days` argument.\n\n## Development\n\n### Running Tests\n\nUnit and integration tests are located in the `tests/` directory.\n\n```bash\npoetry run pytest\n```\n\n### Code Formatting and Linting\n\n```bash\npoetry run black src/ tests/ scripts/\npoetry run flake8 src/ tests/ scripts/\n```\n\n## License\n\nThis project is licensed under the MIT License. See the `LICENSE` file for details.\n```\n```python\n# LICENSE\nMIT License\n\nCopyright (c) 2024 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n```\n```python\n# scripts/cleanup_db.py\nimport sqlite3\nimport os\nimport argparse\nfrom datetime import datetime, timedelta\nimport logging\n\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\ntry:\n    from src.smallest_change.Config import Config\n    DEFAULT_DB_PATH = Config.DEFAULT_DB_PATH\n    DEFAULT_RETENTION_DAYS = Config.DEFAULT_RETENTION_DAYS\nexcept ImportError:\n    logger.warning(\"Could not import Config from smallest_change, using script defaults.\")\n    DEFAULT_DB_PATH = \"smallest_change.db\"\n    DEFAULT_RETENTION_DAYS = 90\n\ndef cleanup_old_logs(db_path: str, retention_days: int) -> int:\n    \"\"\"Deletes log entries older than retention_days from the specified SQLite database.\"\"\"\n    if not os.path.exists(db_path):\n        logger.warning(f\"Database file not found at '{db_path}'. No cleanup performed.\")\n        return 0\n\n    conn = None\n    deleted_rows = 0\n    try:\n        conn = sqlite3.connect(db_path)\n        cursor = conn.cursor()\n\n        cutoff_date = datetime.now() - timedelta(days=retention_days)\n        cutoff_date_str = cutoff_date.isoformat()\n\n        logger.info(f\"Cleaning up logs in '{db_path}' older than {retention_days} days (before {cutoff_date_str})...\")\n\n        cursor.execute(\"DELETE FROM request_log WHERE ts < ?\", (cutoff_date_str,))\n        deleted_rows = cursor.rowcount\n        conn.commit()\n        logger.info(f\"Successfully deleted {deleted_rows} old log entries.\")\n\n    except sqlite3.Error as e:\n        logger.error(f\"SQLite error during cleanup: {e}\")\n        if conn:\n            conn.rollback()\n    except Exception as e:\n        logger.error(f\"An unexpected error occurred during cleanup: {e}\")\n    finally:\n        if conn:\n            conn.close()\n    return deleted_rows\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(description=\"Cleanup old request logs from the SQLite database.\")\n    parser.add_argument(\"--db-path\", type=str, default=DEFAULT_DB_PATH,\n                        help=f\"Path to the SQLite database file (default: {DEFAULT_DB_PATH}).\")\n    parser.add_argument(\"--days\", type=int, default=DEFAULT_RETENTION_DAYS,\n                        help=f\"Number of days to retain logs; older logs will be deleted (default: {DEFAULT_RETENTION_DAYS} days).\")\n    \n    args = parser.parse_args()\n    \n    cleanup_old_logs(args.db_path, args.days)\n\n```"}
