{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Tests if the given string is a palindrome.\"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    It uses a KMP-based trick to find the longest palindromic suffix efficiently.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # KMP trick: find length of the longest prefix of `reversed(string)`\n    # that is also a suffix of `string`. This directly gives the longest palindromic suffix of the original string.\n    rev_string = string[::-1]\n    \n    # Create a combined string for the KMP prefix function.\n    # The '#' character is a unique separator to prevent matches across its boundary.\n    combined = rev_string + '#' + string\n    \n    # Compute the KMP prefix function (failure function).\n    # pi[i] stores the length of the longest proper prefix of combined[0...i] that is also a suffix of combined[0...i].\n    pi = [0] * len(combined)\n    for i in range(1, len(combined)):\n        j = pi[i-1]\n        while j > 0 and combined[i] != combined[j]:\n            j = pi[j-1]\n        if combined[i] == combined[j]:\n            j += 1\n        pi[i] = j\n    \n    # pi[-1] is the length of the longest palindromic suffix of the original string.\n    # This is derived from the KMP algorithm's property when applied to `reversed + # + original`.\n    longest_palindromic_suffix_len = pi[-1]\n    \n    # The part of the string to append to make it a palindrome is the reverse of the prefix.\n    # This prefix is `string` up to the start of its longest palindromic suffix.\n    to_append_part = string[:len(string) - longest_palindromic_suffix_len][::-1]\n    \n    return string + to_append_part"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\"\"\"\n    return string == string[::-1]\n\n\ndef _longest_palindromic_suffix_start(s: str) -> int:\n    \"\"\"Finds the start index of the longest palindromic suffix.\n    Returns index i such that s[i:] is a palindrome and i is minimal.\n    \"\"\"\n    n = len(s)\n    for i in range(n):\n        if s[i:] == s[i:][::-1]:\n            return i\n    return n # This case handles an empty string where n=0 and the loop is skipped.\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    Find the longest palindromic suffix and append the reverse of its prefix.\n    \"\"\"\n    if string == \"\":\n        return \"\"\n    start_index = _longest_palindromic_suffix_start(string)\n    prefix_to_reverse = string[:start_index]\n    return string + prefix_to_reverse[::-1]"}
