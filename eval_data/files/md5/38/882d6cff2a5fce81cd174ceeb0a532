{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n\n    class Number:\n        \"\"\"Encapsulates a numeric value and checks if it's positive.\"\"\"\n        def __init__(self, value: float):\n            self.value = value\n\n        def is_positive(self) -> bool:\n            \"\"\"Checks if the stored number is greater than zero.\"\"\"\n            return self.value > 0\n        \n        def get_value(self) -> float:\n            \"\"\"Returns the raw numeric value.\"\"\"\n            return self.value\n\n    class NumberList:\n        \"\"\"Manages a list of Number objects and provides filtering capabilities.\"\"\"\n        def __init__(self, numbers: list):\n            self.numbers = [Number(num) for num in numbers]\n\n        def filter_positive(self) -> list:\n            \"\"\"Filters the list and returns a new list containing only positive Number objects.\"\"\"\n            return [num_obj for num_obj in self.numbers if num_obj.is_positive()]\n\n    # Convert the input list of raw numbers into a NumberList of Number objects.\n    number_list_instance = NumberList(l)\n    # Filter for positive Number objects.\n    filtered_number_objects = number_list_instance.filter_positive()\n    # Extract the raw numeric values from the filtered Number objects.\n    return [num_obj.get_value() for num_obj in filtered_number_objects]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    The function checks for primality by testing divisibility up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    third_elements = []\n    # Extract elements at indices divisible by three.\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n    \n    # Sort the extracted elements.\n    third_elements.sort()\n    \n    result_list = []\n    sorted_idx_ptr = 0\n    # Rebuild the list with sorted elements at the specific indices.\n    for i in range(len(l)):\n        if i % 3 == 0:\n            result_list.append(third_elements[sorted_idx_ptr])\n            sorted_idx_ptr += 1\n        else:\n            result_list.append(l[i])\n            \n    return result_list"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    seen = set()\n    unique_elements = []\n    for item in l:\n        if item not in seen:\n            seen.add(item)\n            unique_elements.append(item)\n    return sorted(unique_elements)"}
