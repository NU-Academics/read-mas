{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    EPSILON = 1e-7  # Tolerance for checking if a value is close to zero.\n    MAX_BISECTION_ITERATIONS = 100 # Maximum iterations for the bisection method.\n\n    # Define a wide but practical search range for finding the first interval.\n    # Starting from a negative value and increasing helps in finding the 'smallest' root first.\n    search_range_start = -1000.0\n    search_range_end = 1000.0\n    initial_step = 0.001 # Granularity of the initial sweep for bracketing a root.\n\n    x_current = search_range_start\n    y_current = poly(xs, x_current)\n\n    # Check if the start of the range is already a root.\n    if abs(y_current) < EPSILON:\n        return x_current\n\n    # Iterate through the search range to find an interval [a, b] where poly(a) and poly(b) have opposite signs,\n    # or find a root directly.\n    while x_current < search_range_end:\n        x_next = x_current + initial_step\n        # Cap x_next to search_range_end to avoid overshooting due to floating point arithmetic\n        if x_next > search_range_end:\n            x_next = search_range_end\n            if x_next == x_current: # Prevent infinite loop if x_current is very close to search_range_end\n                break\n\n        y_next = poly(xs, x_next)\n\n        # If y_next is very close to zero, we found an exact root.\n        if abs(y_next) < EPSILON:\n            return x_next\n        \n        # If there's a sign change, a root is bracketed within [x_current, x_next].\n        if y_current * y_next < 0:\n            a = x_current\n            b = x_next\n            \n            # Apply bisection method to refine the root within the found interval.\n            for _ in range(MAX_BISECTION_ITERATIONS):\n                mid = (a + b) / 2\n                y_mid = poly(xs, mid)\n\n                if abs(y_mid) < EPSILON:\n                    return mid # Root found within tolerance\n\n                if poly(xs, a) * y_mid < 0: # Root is in the left half [a, mid]\n                    b = mid\n                else: # Root is in the right half [mid, b]\n                    a = mid\n            return (a + b) / 2 # Return the midpoint of the final interval after max iterations\n\n        x_current = x_next\n        y_current = y_next\n    \n    # As per the problem statement, a solution is guaranteed because polynomials\n    # with an even number of coefficients and largest non-zero coefficient have an odd degree,\n    # and odd-degree polynomials always have at least one real root.\n    # If the iterative search did not find a root within its range, it means the root\n    # is outside this range. In such a case, we apply bisection on a very large\n    # interval to guarantee finding *a* root. This might not be the \"smallest\"\n    # if it was outside the `search_range_start/end`, but it respects the guarantee.\n    \n    fallback_a = -1e5\n    fallback_b = 1e5\n\n    # Bisect within this large interval.\n    for _ in range(MAX_BISECTION_ITERATIONS):\n        mid = (fallback_a + fallback_b) / 2\n        y_mid = poly(xs, mid)\n\n        if abs(y_mid) < EPSILON:\n            return mid\n\n        y_a = poly(xs, fallback_a)\n        if abs(y_a) < EPSILON:\n            return fallback_a\n        \n        if y_a * y_mid < 0:\n            fallback_b = mid\n        else:\n            fallback_a = mid\n            \n    return (fallback_a + fallback_b) / 2 # Return result from fallback bisection"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    # Iterate through integers from 1 up to (but not including) n.\n    for i in range(1, n):\n        # Check if the current number is divisible by 11 or 13.\n        if i % 11 == 0 or i % 13 == 0:\n            # Convert the number to a string to easily count occurrences of the digit '7'.\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = list(l)\n    even_indexed_elements = []\n    for i in range(0, len(l), 2):\n        even_indexed_elements.append(l[i])\n    \n    even_indexed_elements.sort()\n    \n    current_sorted_index = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_indexed_elements[current_sorted_index]\n        current_sorted_index += 1\n        \n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    count = 0\n    a, b = 0, 1 # Initialize Fibonacci sequence with F(0) and F(1)\n\n    while True:\n        fib_num = a + b # Calculate the next Fibonacci number F(k)\n        a, b = b, fib_num # Update a and b to move to the next pair (F(k-1), F(k))\n\n        if fib_num == 1: # The Fibonacci number 1 is not prime; skip it.\n            continue\n\n        if is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
