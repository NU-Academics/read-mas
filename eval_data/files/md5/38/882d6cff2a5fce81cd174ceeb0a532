{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"\n    xs represent coefficients of a polynomial: xs[0] + xs[1] * x + xs[2] * x^2 + ....\n    Returns the derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n    return derived_coefficients"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using an iterative approach.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize with base cases for n=0, n=1, n=2\n    # f(n-3), f(n-2), f(n-1)\n    a, b, c = 0, 0, 1\n\n    # Iterate from n=3 up to the requested n\n    for _ in range(3, n + 1):\n        next_fibfib = a + b + c\n        a = b\n        b = c\n        c = next_fibfib\n    \n    return c"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        return s_x[::-1]\n    else:\n        effective_shift = shift % num_digits\n        # Perform right circular shift\n        # The last `effective_shift` digits move to the front\n        # The remaining digits follow\n        return s_x[-effective_shift:] + s_x[:-effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of uppercase characters in the input string.\"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':  # Check if the character is an uppercase letter\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' if it's at the end.\"\"\"\n    count = 0\n    vowels = \"aeiou\"\n    \n    for i, char in enumerate(s):\n        if char.lower() in vowels:\n            count += 1\n        elif char.lower() == 'y' and i == len(s) - 1:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apples and oranges and the total fruit count.\n    Parses the input string to extract apple and orange counts and subtracts them from the total.\n    \"\"\"\n    # Extract the number of apples\n    apples_str = s.split(\" apples\")[0]\n    num_apples = int(apples_str)\n\n    # Extract the number of oranges\n    oranges_part = s.split(\" and \")[1]\n    oranges_str = oranges_part.split(\" oranges\")[0]\n    num_oranges = int(oranges_str)\n\n    # Calculate the number of mangoes\n    num_mangoes = n - num_apples - num_oranges\n    return num_mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its first index in an array.\n    Returns [value, index] or [] if no even numbers are found or array is empty.\n    \"\"\"\n    min_even_value = float('inf')\n    min_even_index = None\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < min_even_value:\n                min_even_value = num\n                min_even_index = i\n\n    if min_even_index is not None:\n        return [min_even_value, min_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    Return the greatest integer x > 0 such that its frequency f(x) in lst\n    satisfies f(x) >= x. Return -1 if no such integer exists.\n    '''\n    freq = {}\n    for num in lst:\n        freq[num] = freq.get(num, 0) + 1\n\n    candidates = [x for x, count in freq.items() if count >= x]\n\n    return max(candidates) if candidates else -1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left = 0\n    right = len(sorted_lst) - 1\n\n    while left <= right:\n        # Append the current minimum\n        result.append(sorted_lst[left])\n        left += 1\n\n        # If there are still elements, append the current maximum\n        if left <= right:\n            result.append(sorted_lst[right])\n            right -= 1\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check for valid triangle inequality\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n    \n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n    \n    # Calculate area using Heron's formula\n    area = (s * (s - a) * (s - b) * (s - c)) ** 0.5\n    \n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if an object (list q) will fly based on being palindromic and its sum\n    being less than or equal to the maximum weight w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    sum_elements = sum(q)\n    is_within_weight_limit = (sum_elements <= w)\n\n    return is_balanced and is_within_weight_limit"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    # Iterate from the beginning to the middle of the array.\n    for i in range(n // 2):\n        # If symmetric elements differ, increment the change counter.\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    Checks if the given number is the multiplication of exactly three prime numbers.\n    The input 'a' is less than 100.\n    \"\"\"\n    if a < 8:  # Smallest product of three primes is 2*2*2 = 8\n        return False\n\n    factors = []\n    d = 2\n    temp_a = a\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            factors.append(d)\n            temp_a //= d\n        d += 1\n    if temp_a > 1:\n        factors.append(temp_a)\n\n    return len(factors) == 3"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character count and returns the list with fewer characters.\n    If counts are equal, the first list is returned.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n, meaning x = n**k for some integer k.\n    This function iteratively divides x by n to determine if it's a perfect power.\n    \"\"\"\n    if x == 1:\n        return True\n    if x <= 0:\n        return False\n    if n <= 1:\n        return False\n\n    # At this point, x > 1 and n >= 2\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    return True"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Return True if a is a perfect cube, else False.\n    '''\n    if a == 0:\n        return True\n    root = round(abs(a) ** (1/3))\n    return root ** 3 == abs(a) and (root ** 3 == a if a > 0 else -root ** 3 == a)"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    prefixed and suffixed with 'db'.\n    \"\"\"\n    if decimal == 0:\n        binary_str = \"0\"\n    else:\n        binary_digits = []\n        temp_decimal = decimal\n        while temp_decimal > 0:\n            binary_digits.append(str(temp_decimal % 2))\n            temp_decimal //= 2\n        binary_str = \"\".join(binary_digits[::-1])\n\n    return \"db\" + binary_str + \"db\""}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"\n    Counts the number of prime hexadecimal digits in a given hexadecimal string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (decimal 11), D (decimal 13).\n    \"\"\"\n\n    class PrimeDigitSet:\n        \"\"\"Manages the set of prime hexadecimal digits for primality checks.\"\"\"\n        PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\n        @staticmethod\n        def is_prime(hex_char):\n            \"\"\"Checks if a given hexadecimal character is a prime digit.\"\"\"\n            return hex_char in PrimeDigitSet.PRIME_HEX_DIGITS\n\n    class HexDigit:\n        \"\"\"Represents a single hexadecimal digit and provides primality checking.\"\"\"\n        def __init__(self, value):\n            self.value = value.upper()\n\n        def is_prime(self):\n            \"\"\"Determines if this hexadecimal digit is a prime digit.\"\"\"\n            return PrimeDigitSet.is_prime(self.value)\n\n    class HexNumber:\n        \"\"\"Represents a hexadecimal number as a string and counts its prime digits.\"\"\"\n        def __init__(self, hex_string):\n            self.hex_string = hex_string\n\n        def count_prime_digits(self):\n            \"\"\"Iterates through the hex string to count prime hexadecimal digits.\"\"\"\n            count = 0\n            for char in self.hex_string:\n                digit = HexDigit(char)\n                if digit.is_prime():\n                    count += 1\n            return count\n\n    hex_number_obj = HexNumber(num)\n    return hex_number_obj.count_prime_digits()"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if the string is happy: length >= 3 and every 3 consecutive letters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n    for i in range(len(s) - 2):\n        triplet = s[i:i+3]\n        if len(set(triplet)) != 3:\n            return False\n    return True"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    import math\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime in O(sqrt(n)) time.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    class PrimeLengthChecker:\n        \"\"\"Domain class for determining if a string's length is prime.\"\"\"\n        def is_prime_length(self, input_string: str) -> bool:\n            \"\"\"Computes string length and checks its primality.\"\"\"\n            length = len(input_string)\n            return _is_prime(length)\n\n    checker = PrimeLengthChecker()\n    return checker.is_prime_length(string)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n > 1, the formula is 10^(n-1) (numbers starting with 1)\n    # + 9 * 10^(n-2) (numbers ending with 1, not starting with 1)\n    # This simplifies to 10**(n-1) + 9 * 10**(n-2)\n    return 10**(n-1) + 9 * 10**(n-2)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\n    The conversion follows a predefined grading scale with specific thresholds.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        elif gpa == 0.0:\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n    \n    # Calculate the sum of the digits of N.\n    digit_sum = 0\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n    \n    # Convert the sum of digits to its binary representation as a string.\n    # The bin() function returns a string with a \"0b\" prefix, which we slice off.\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 != 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/87", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Find all occurrences of integer `x` in a jagged list `lst` and return\n    their coordinates as a list of tuples (row, column). The result is\n    sorted by row ascending and column descending within each row.\n    \"\"\"\n    coordinates: List[Coordinate] = []\n\n    for row_index, row in enumerate(lst):\n        for col_index, value in enumerate(row):\n            if value == x:\n                coordinates.append(Coordinate(row=row_index, column=col_index))\n\n    # Sort by row ascending, then column descending.\n    coordinates.sort(key=lambda c: (c.row, -c.column))\n\n    return [(c.row, c.column) for c in coordinates]"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string while preserving word order and spaces.\n    Words are delimited by spaces, and punctuation is considered part of the word.\n    \"\"\"\n    result = []\n    current_word = []\n    for char in s:\n        if char == ' ':\n            if current_word:\n                result.append(\"\".join(sorted(current_word)))\n                current_word = []\n            result.append(' ')\n        else:\n            current_word.append(char)\n    \n    if current_word:\n        result.append(\"\".join(sorted(current_word)))\n            \n    return \"\".join(result)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    # Calculate sum of first and last elements\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    # Create a copy to avoid modifying the original array\n    copied_array = list(array)\n\n    # Determine sorting order based on sum parity\n    if sum_first_last % 2 == 1:  # Sum is odd, sort in ascending order\n        return sorted(copied_array)\n    else:  # Sum is even, sort in descending order\n        return sorted(copied_array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting alphabetic characters down by four places, wrapping around the alphabet.\n    Non-alphabetic characters remain unchanged.\"\"\"\n    result = []\n    shift = 4 # The alphabet shifts down by two multiplied to two places (2 * 2 = 4)\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            shifted_char_code = (ord(char) - start + shift) % 26 + start\n            result.append(chr(shifted_char_code))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            shifted_char_code = (ord(char) - start + shift) % 26 + start\n            result.append(chr(shifted_char_code))\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    smallest = None\n    second_smallest = None\n\n    for value in lst:\n        if smallest is None or value < smallest:\n            if smallest is not None and value != smallest:\n                second_smallest = smallest\n            smallest = value\n        elif value != smallest:\n            if second_smallest is None or value < second_smallest:\n                second_smallest = value\n    \n    return second_smallest"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    import re\n\n    class Sentence:\n        \"\"\"Represents a single sentence and checks if it starts with 'I'.\"\"\"\n        def __init__(self, text):\n            self.text = text\n\n        def starts_with_i(self):\n            \"\"\"Checks if the trimmed sentence text starts with 'I'.\"\"\"\n            trimmed_text = self.text.strip()\n            return trimmed_text.startswith(\"I\")\n\n    class Parser:\n        \"\"\"Parses an input string into a list of Sentence objects.\"\"\"\n        def __init__(self, delimiters=\".?!\"):\n            self.split_pattern = f'[{re.escape(delimiters)}]'\n\n        def parse(self, text):\n            \"\"\"Splits the text into sentences, creating Sentence objects.\"\"\"\n            sentences = []\n            # Split by delimiters. re.split handles cases with no delimiters or trailing delimiters.\n            parts = re.split(self.split_pattern, text)\n\n            for part in parts:\n                trimmed_part = part.strip()\n                if trimmed_part: # Ignore empty strings that result from splitting\n                    sentences.append(Sentence(trimmed_part))\n            return sentences\n\n    class BoredomCounter:\n        \"\"\"Counts sentences that start with 'I' from a list of Sentence objects.\"\"\"\n        def count_boredoms(self, sentences):\n            \"\"\"Iterates through sentences and counts those starting with 'I'.\"\"\"\n            count = 0\n            for sentence in sentences:\n                if sentence.starts_with_i():\n                    count += 1\n            return count\n\n    if not S:\n        return 0\n\n    parser = Parser()\n    sentence_objects = parser.parse(S)\n    \n    counter = BoredomCounter()\n    boredom_count = counter.count_boredoms(sentence_objects)\n    \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    if not all(isinstance(v, int) for v in (x, y, z)):\n        return False\n    \n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    VOWEL_MAP = {c: chr(ord(c) + 2) for c in VOWELS}\n\n    encoded_chars = []\n    for char in message:\n        # First, swap the case of the character. Non-letters remain unchanged by swapcase().\n        swapped_char = char.swapcase()\n\n        # If the character (after case swap) is a vowel, replace it.\n        if swapped_char in VOWEL_MAP:\n            encoded_chars.append(VOWEL_MAP[swapped_char])\n        else:\n            # Otherwise, keep the swapped character (or original non-letter).\n            encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def _digit_sum(n):\n        \"\"\"Calculates the sum of digits of a number.\"\"\"\n        s = 0\n        # Handle negative numbers by taking absolute value for digit sum\n        # Though context implies positive primes, sum of digits of 0 is 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    largest_prime = -1\n    for num in lst:\n        if _is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == -1:\n        return 0\n    else:\n        return _digit_sum(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict:\n        if not isinstance(key, str):\n            return False\n        \n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n            \n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    if n <= 2:\n        # There are no prime numbers strictly less than 2.\n        return []\n\n    primes = []\n\n    def _is_prime(num):\n        # Checks if a number is prime using trial division.\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    for candidate in range(2, n):\n        if _is_prime(candidate):\n            primes.append(candidate)\n\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
