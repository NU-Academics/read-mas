{"task_id": "Mbpp/8", "solution": "def square_nums(input_list):\n    \"\"\"\n    Compute and return a new list containing squares of each element from input_list.\n    Does not modify input_list.\n    \"\"\"\n    squared_list = []\n    for num in input_list:\n        squared_list.append(num * num)\n    return squared_list"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef _validate_input(n):\n    \"\"\"\n    Validates that the input n is an integer.\n    Raises TypeError if n is not an int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if an integer n is prime based on its mathematical definition.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    limit = int(n**0.5)\n    while i <= limit:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies non-prime numbers.\n    Returns True if n is not prime, False if n is prime.\n    \"\"\"\n    _validate_input(n)\n    return not _is_prime(n)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(seq1, seq2):\n    \"\"\"Return an iterable with elements present in both seq1 and seq2.\n\n    Returns an iterable of shared elements; order is not guaranteed.\n    \"\"\"\n    set1 = set(seq1)\n    set2 = set(seq2)\n    return list(set1.intersection(set2))"}
{"task_id": "Mbpp/7", "solution": "from typing import Iterable, List\n\nclass InputString:\n    \"\"\"Encapsulates the raw input string.\"\"\"\n    def __init__(self, raw: str):\n        self._raw = raw\n\n    def raw(self) -> str:\n        return self._raw\n\nclass Word:\n    \"\"\"Represents a single word token with its text and length.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._length = len(text)\n\n    def text(self) -> str:\n        return self._text\n\n    def length(self) -> int:\n        return self._length\n\nclass WordCollection:\n    \"\"\"Manages a collection of Word objects and provides filtering capabilities.\"\"\"\n    def __init__(self, raw_tokens: Iterable[str]):\n        self._words = [Word(token) for token in raw_tokens]\n\n    def filter_long(self, min_len: int = 4) -> List[str]:\n        return [word.text() for word in self._words if word.length() >= min_len]\n\ndef find_char_long(text: str) -> Iterable[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a given string.\n    This function tokenizes the input, filters words by length, and preserves casing.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    tokens = text.split()\n    collection = WordCollection(tokens)\n    result = collection.filter_long(min_len=4)\n    return result"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\ndef heap_queue_largest(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Handles edge cases for n <= 0, empty input lists, and n >= list length.\n    \"\"\"\n    if n <= 0 or not input_list:\n        return []\n\n    if n >= len(input_list):\n        return sorted(input_list, reverse=True)\n\n    return heapq.nlargest(n, input_list)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b) -> bool:\n    \"\"\"Return True iff integers a and b differ in exactly one bit position.\n\n    Args:\n        a (int): first integer operand\n        b (int): second integer operand\n\n    Returns:\n        bool: True if exactly one bit differs, False otherwise\n\n    Raises:\n        TypeError: if a or b is not an int\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both operands must be integers.\")\n\n    # Compute the XOR of the two numbers. The set bits in 'x' indicate\n    # positions where 'a' and 'b' differ.\n    x = a ^ b\n\n    # Count the number of set bits (population count) in 'x' using its\n    # binary string representation.\n    popcount = bin(x).count('1')\n\n    # Return True if exactly one bit differs, False otherwise.\n    return popcount == 1"}
{"task_id": "Mbpp/9", "solution": "class StringInput:\n    \"\"\"Represents and validates input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n        self._length = len(value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if value is str and length >= 1.\"\"\"\n        return isinstance(self._value, str) and self._length >= 1\n\nclass RotationResult:\n    \"\"\"Encapsulates the computed minimal rotation integer k.\"\"\"\n    def __init__(self, k: int) -> None:\n        self._k = k\n\n    def get_k(self) -> int:\n        \"\"\"Returns the encapsulated rotation count k.\"\"\"\n        return self._k\n\nclass RotationService:\n    \"\"\"Stateless service computing minimal positive rotation.\"\"\"\n    def find_Rotations(self, s: str) -> int:\n        \"\"\"Orchestrates computation of minimal rotation and returns it.\"\"\"\n        minimal_k = self.compute_min_rotation(s)\n        result = RotationResult(minimal_k)\n        return result.get_k()\n\n    def compute_min_rotation(self, s: str) -> int:\n        \"\"\"Evaluates k from 1 to len(s) to find minimal k for which s rotates to itself.\"\"\"\n        n = len(s)\n        for k in range(1, n + 1):\n            if self.is_rotation(s, k):\n                return k\n        # A string always rotates to itself after len(s) rotations, so a k will always be found.\n        return n # This line should theoretically be unreachable if n >= 1.\n\n    def is_rotation(self, s: str, k: int) -> bool:\n        \"\"\"Checks if rotating string s by k positions yields s.\"\"\"\n        rotated_s = s[k:] + s[:k]\n        return s == rotated_s\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"Public API per SRS: returns minimal positive rotation k (1 <= k <= len(s)).\"\"\"\n    input_validator = StringInput(s)\n    # As per design context and instructions, input is assumed valid (precondition met).\n    # The call to is_valid() serves design adherence, but its return is not acted upon here.\n    input_validator.is_valid() \n\n    rotation_service = RotationService()\n    k_value = rotation_service.find_Rotations(s)\n    return k_value"}
{"task_id": "Mbpp/11", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass SourceString:\n    \"\"\"Holds the source string and provides methods for length and finding character indices.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def indexOf(self, ch: str) -> int:\n        return self.value.find(ch)\n\n    def lastIndexOf(self, ch: str) -> int:\n        return self.value.rfind(ch)\n\n@dataclass\nclass CharacterParam:\n    \"\"\"Validates the character parameter.\"\"\"\n    value: str\n\n    def isSingleChar(self) -> bool:\n        return isinstance(self.value, str) and len(self.value) == 1\n\n    def validate_or_raise(self) -> None:\n        if not self.isSingleChar():\n            raise ValueError(\"ch must be a single-character string\")\n\n@dataclass\nclass ResultString:\n    \"\"\"Holds the resulting string.\"\"\"\n    value: str\n\ndef remove_Occ(source: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    char_param = CharacterParam(ch)\n    char_param.validate_or_raise()\n\n    src_str = SourceString(source)\n    \n    first_idx = src_str.indexOf(ch)\n    if first_idx == -1:\n        return source\n\n    last_idx = src_str.lastIndexOf(ch)\n\n    if first_idx == last_idx:\n        # Only one occurrence\n        result = source[:first_idx] + source[first_idx+1:]\n    else:\n        # Multiple occurrences\n        result = source[:first_idx] + source[first_idx+1:last_idx] + source[last_idx+1:]\n    \n    return ResultString(result).value"}
{"task_id": "Mbpp/16", "solution": "import re\n\nclass Pattern:\n    \"\"\"Holds the regular expression pattern.\"\"\"\n    regex: str = \"^[a-z]+_[a-z]+$\"\n\nclass PatternMatcher:\n    \"\"\"Performs full string matching against a given regex.\"\"\"\n    def matches(self, input_string: str, regex: str) -> bool:\n        \"\"\"Returns True if the input_string fully matches the regex, False otherwise.\"\"\"\n        return re.fullmatch(regex, input_string) is not None\n\ndef text_lowercase_underscore(input_string):\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters \n    joined with an underscore (e.g., \"abc_def\").\n    \"\"\"\n    if not isinstance(input_string, str):\n        return False\n    pattern = Pattern()\n    matcher = PatternMatcher()\n    return matcher.matches(input_string, pattern.regex)"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length):\n    \"\"\"Return the perimeter of a square given side_length (numeric).\"\"\"\n    return 4 * side_length"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Represents the dimensions of a triangular prism.\"\"\"\n    def __init__(self, base, height, length):\n        self.base = base\n        self.height = height\n        self.length = length\n\nclass Validator:\n    \"\"\"Validates inputs for prism dimensions.\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validateDimensions(self, prism: TriangularPrism) -> bool:\n        \"\"\"Validates that all dimensions of a prism are numeric.\"\"\"\n        return (self.isNumeric(prism.base) and\n                self.isNumeric(prism.height) and\n                self.isNumeric(prism.length))\n\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a triangular prism.\"\"\"\n    def computeVolume(self, prism: TriangularPrism) -> float:\n        \"\"\"Computes the volume using the formula (0.5 * base * height) * length.\"\"\"\n        return (0.5 * prism.base * prism.height) * prism.length\n\ndef find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism given its base, height, and length.\n    Raises TypeError if any input dimension is not numeric.\n    \"\"\"\n    validator = Validator()\n    prism = TriangularPrism(base, height, length)\n    if not validator.validateDimensions(prism):\n        raise TypeError(\"Non-numeric input for prism dimensions\")\n    calculator = VolumeCalculator()\n    return calculator.computeVolume(prism)"}
{"task_id": "Mbpp/12", "solution": "import collections\nfrom typing import List, Any\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass Row:\n    elements: List[float]\n    sum: float\n    index: int\n\n\n@dataclass\nclass Matrix:\n    rows: List[Row]\n    row_count: int\n\n    def row_sums(self) -> List[float]:\n        return [row.sum for row in self.rows]\n\n\ndef _validate_matrix(matrix: Any) -> None:\n    \"\"\"Raises ValueError if matrix is not a 2D list of numeric values.\"\"\"\n    if not isinstance(matrix, list):\n        raise ValueError(\"Input matrix must be a list.\")\n    if not all(isinstance(row, list) for row in matrix):\n        raise ValueError(\"All rows in the matrix must be lists.\")\n    if not all(isinstance(val, (int, float)) for row in matrix for val in row):\n        raise ValueError(\"All elements in the matrix must be numeric (int or float).\")\n\n\ndef _compute_row_sums(matrix: List[List[float]]) -> List[float]:\n    \"\"\"Return list of sums for each row in the input matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\n\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"Public API: returns a new matrix (List[List[float]]) whose rows are ordered by ascending row sum.\"\"\"\n    _validate_matrix(matrix)\n\n    rows_with_sums = []\n    for i, row_elements in enumerate(matrix):\n        row_sum = sum(row_elements)\n        rows_with_sums.append(Row(elements=row_elements, sum=row_sum, index=i))\n\n    sorted_rows = sorted(rows_with_sums, key=lambda r: r.sum)\n\n    return [row.elements for row in sorted_rows]"}
{"task_id": "Mbpp/18", "solution": "from typing import Set, Iterable\n\nclass SourceString:\n    \"\"\"Immutable wrapper for the source string value.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n    def getValue(self) -> str:\n        return self._value\n\nclass CharacterSet:\n    \"\"\"Encapsulates a set of characters used for efficient membership checks.\"\"\"\n    def __init__(self, chars: Iterable[str]):\n        self._chars: Set[str] = set(chars)\n    def contains(self, ch: str) -> bool:\n        return ch in self._chars\n\nclass RemoveChars:\n    \"\"\"Immutable wrapper for the remove_chars string and conversion to a CharacterSet.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._char_set = CharacterSet(value)\n    def getValue(self) -> str:\n        return self._value\n    def toCharSet(self) -> CharacterSet:\n        return self._char_set\n\nclass ResultString:\n    \"\"\"Immutable wrapper for the resulting string after removals.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n    def getValue(self) -> str:\n        return self._value\n\ndef remove_dirty_chars(source: str, remove_chars: str) -> str:\n    \"\"\"\n    Removes characters from the first string which are present in the second string.\n    Preserves the relative order of remaining characters.\n    \"\"\"\n    if not source:\n        return \"\"\n    if not remove_chars:\n        return source\n\n    remove_set_wrapper = RemoveChars(remove_chars)\n    char_set_to_remove = remove_set_wrapper.toCharSet()\n\n    cleaned_chars = []\n    source_wrapper = SourceString(source)\n    for char_in_source in source_wrapper.getValue():\n        if not char_set_to_remove.contains(char_in_source):\n            cleaned_chars.append(char_in_source)\n\n    result_wrapper = ResultString(\"\".join(cleaned_chars))\n    return result_wrapper.getValue()"}
{"task_id": "Mbpp/56", "solution": "def reverse(n: int) -> int:\n    \"\"\"\n    Returns the integer formed by reversing the decimal digits of n;\n    leading zeros in the reversed representation are ignored.\n    \"\"\"\n    s = str(n)\n    rs = s[::-1]\n    return int(rs)\n\ndef check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    reversed_n = reverse(n)\n    value = 2 * reversed_n - 1\n    return n == value"}
{"task_id": "Mbpp/20", "solution": "import math\nfrom typing import Optional\n\nclass IntegerInput:\n    \"\"\"Encapsulates input validation for integers.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def validate(self) -> int:\n        \"\"\"Raises TypeError if not an int, otherwise returns the validated integer.\"\"\"\n        if not isinstance(self.value, int):\n            raise TypeError(\"Input must be an integer.\")\n        return self.value\n\nclass WoodallResult:\n    \"\"\"Holds result metadata for Woodall number check.\"\"\"\n    def __init__(self, is_woodall: bool, k: Optional[int]):\n        self.is_woodall = is_woodall\n        self.k = k\n\nclass WoodallChecker:\n    \"\"\"Implements the algorithm to determine Woodall membership.\"\"\"\n    def is_woodall(self, n: int) -> bool:\n        \"\"\"Checks if a number is a Woodall number.\"\"\"\n        result = self._find_k_for(n)\n        return result is not None\n\n    def _find_k_for(self, n: int) -> Optional[int]:\n        \"\"\"Iterates k to find if n is a Woodall number k * 2^k - 1.\"\"\"\n        if n <= 0:  # Woodall numbers are positive\n            return None\n\n        k = 1\n        while True:\n            candidate = k * (2**k) - 1\n            if candidate == n:\n                return k\n            if candidate > n:\n                return None\n            k += 1\n\ndef is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is defined as m = k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    validated_n = IntegerInput(n).validate()\n    checker = WoodallChecker()\n    found_k = checker._find_k_for(validated_n)\n    result = WoodallResult(found_k is not None, found_k)\n    return result.is_woodall"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of integers contains any duplicate elements.\n    Uses a set for efficient O(n) duplicate detection.\n    \"\"\"\n    seen_elements = set()\n    for element in arr:\n        if element in seen_elements:\n            return True\n        seen_elements.add(element)\n    return False"}
{"task_id": "Mbpp/57", "solution": "from typing import List\n\ndef _validate_digits(digits: List[int]) -> None:\n    \"\"\"Validates the input list of digits for type, non-emptiness, and range constraints.\"\"\"\n    if not isinstance(digits, list):\n        raise ValueError(\"Input must be a list.\")\n    if not digits:\n        raise ValueError(\"Input list cannot be empty.\")\n    for digit in digits:\n        if not isinstance(digit, int) or not (0 <= digit <= 9):\n            raise ValueError(\"All elements must be integers between 0 and 9.\")\n\ndef _concatenate_sorted_digits(sorted_digits: List[int]) -> int:\n    \"\"\"Concatenates sorted digits into a string and converts to an integer, handling all-zero case.\"\"\"\n    if not sorted_digits: # Should be caught by validation, but defensive.\n        return 0\n\n    if all(d == 0 for d in sorted_digits):\n        return 0\n\n    s = \"\".join(map(str, sorted_digits))\n    return int(s)\n\nclass Digit:\n    \"\"\"Represents a single digit (0-9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass ResultNumber:\n    \"\"\"Encapsulates the final integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_int(self) -> int:\n        return self.value\n\nclass DigitList:\n    \"\"\"Encapsulates input digit list and provides validation and sorting capabilities.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self.digits = digits\n\n    def validate(self) -> None:\n        \"\"\"Validates the digits using the module-private helper function.\"\"\"\n        _validate_digits(self.digits)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the digit list is empty.\"\"\"\n        return not self.digits\n\n    def as_sorted_desc(self) -> List[int]:\n        \"\"\"Returns the digits sorted in descending order.\"\"\"\n        return sorted(self.digits, reverse=True)\n\nclass FindMaxNum:\n    \"\"\"Orchestrates the process of finding the maximum number from a list of digits.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self._digit_list = DigitList(digits)\n\n    def find_Max_Num(self) -> int:\n        \"\"\"Validates, sorts, and concatenates digits to form the largest possible number.\"\"\"\n        self._digit_list.validate()\n        sorted_digits = self._digit_list.as_sorted_desc()\n        result_int = _concatenate_sorted_digits(sorted_digits)\n        return ResultNumber(result_int).to_int()\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    The function validates input, sorts digits in descending order,\n    and concatenates them to form the largest possible integer.\n    \"\"\"\n    orchestrator = FindMaxNum(digits)\n    return orchestrator.find_Max_Num()"}
{"task_id": "Mbpp/58", "solution": "def determine_sign(x: int) -> int:\n    \"\"\"\n    Determines the sign of an integer.\n    Returns 1 for positive, -1 for negative, and 0 for zero.\n    \"\"\"\n    if x > 0:\n        return 1\n    elif x < 0:\n        return -1\n    else:\n        return 0\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Returns True if one is positive and the other is negative, False otherwise.\n    \"\"\"\n    sign_a = determine_sign(a)\n    sign_b = determine_sign(b)\n    return sign_a * sign_b == -1"}
{"task_id": "Mbpp/59", "solution": "class InputValidator:\n    \"\"\"Validates input n according to constraints, raising ValueError for invalid inputs.\"\"\"\n    def is_positive_integer(self, n) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 1; otherwise False.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def validate(self, n) -> None:\n        \"\"\"Raises ValueError if n is not a positive integer; otherwise returns None.\"\"\"\n        if not self.is_positive_integer(n):\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass OctagonalService:\n    \"\"\"Performs the octagonal-number computation.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes O_n = 3*n^2 - 2*n; assumes input n is validated.\"\"\"\n        return 3 * n * n - 2 * n\n\nclass Parameter:\n    \"\"\"Simple domain data holder for a single integer parameter.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass Result:\n    \"\"\"Simple domain data holder for an integer result value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef is_octagonal(n) -> int:\n    \"\"\"\n    Computes the nth octagonal number after validating the input.\n    Raises ValueError if n is not a positive integer (n >= 1).\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    service = OctagonalService()\n    return service.compute(n)"}
{"task_id": "Mbpp/61", "solution": "class Validator:\n    \"\"\"Validates if a string contains only digit characters, allowing empty strings.\"\"\"\n    def validate(self, s: str) -> None:\n        if not s:\n            return\n        for char in s:\n            if not char.isdigit():\n                raise ValueError(\"Input string must contain only digits.\")\n\nclass Substring:\n    \"\"\"Represents a substring with its properties like length and digit sum.\"\"\"\n    def __init__(self, start: int, end: int, value: str) -> None:\n        self.start = start\n        self.end = end\n        self.value = value\n        self.length = len(value)\n        self.digit_sum = sum(int(ch) for ch in value)\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"Counts substrings where the sum of digits equals the substring's length.\"\"\"\n    validator = Validator()\n    validator.validate(s)\n\n    if not s:\n        return 0\n\n    count = 0\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            sub_val = s[i:j+1]\n            sub = Substring(i, j, sub_val)\n            if sub.digit_sum == sub.length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/62", "solution": "from typing import List, Union\n\ndef smallest_num(list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Finds the smallest number in a list of numeric values.\n    Assumes a non-empty list of numeric values as input.\"\"\"\n    \n    min_val = list[0] \n    \n    for x in list:\n        if x < min_val:\n            min_val = x\n            \n    return min_val"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple, Any\nfrom numbers import Number\n\ndef _score_key(item: Tuple[Any, Number]) -> Number:\n    \"\"\"Returns the numeric score from a subject-score tuple for sorting.\"\"\"\n    return item[1]\n\ndef subject_marks(list_of_tuples: List[Tuple[str, Number]]) -> List[Tuple[str, Number]]:\n    \"\"\"Sorts a list of (subject, score) tuples by the score in ascending order.\"\"\"\n    if not list_of_tuples:\n        return []\n    if len(list_of_tuples) == 1:\n        return list_of_tuples\n    return sorted(list_of_tuples, key=_score_key)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(inputList):\n    \"\"\"\n    Flattens a list and sums all of its elements.\n    Delegates to an internal helper for recursive traversal and aggregation.\n    \"\"\"\n    \n    def _sum_elements(element):\n        \"\"\"\n        Recursively sums integer elements within a given element (int or list).\n        \"\"\"\n        total = 0\n        if isinstance(element, int):\n            total += element\n        elif isinstance(element, list):\n            for item in element:\n                total += _sum_elements(item)\n        return total\n\n    return _sum_elements(inputList)"}
{"task_id": "Mbpp/63", "solution": "from typing import Iterable as TypingIterable, Tuple, Union, Iterator, Any\nfrom dataclasses import dataclass\nfrom collections.abc import Iterable\n\n\n@dataclass\nclass TuplePair:\n    \"\"\"Represents a pair of numeric values for difference calculation.\"\"\"\n    a: Union[int, float]\n    b: Union[int, float]\n\n    def difference(self) -> float:\n        \"\"\"Calculates the absolute difference between the pair's elements.\"\"\"\n        return abs(self.a - self.b)\n\n\n@dataclass\nclass DifferenceResult:\n    \"\"\"Represents the result of a difference calculation.\"\"\"\n    value: float\n\n\ndef _to_tuplepair(item: Any) -> TuplePair:\n    \"\"\"\n    Validates an item and converts it into a TuplePair object.\n    Raises TypeError if the item is not a 2-element sequence of numbers.\n    \"\"\"\n    if not isinstance(item, (tuple, list)) or len(item) != 2:\n        raise TypeError(f\"Each item in 'pairs' must be a 2-element sequence, but got {type(item).__name__} of length {len(item) if hasattr(item, '__len__') else 'N/A'}.\")\n\n    val_a, val_b = item\n    if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n        raise TypeError(f\"Elements of each pair must be numeric (int or float), but got {type(val_a).__name__} and {type(val_b).__name__}.\")\n\n    return TuplePair(val_a, val_b)\n\n\ndef _iter_differences(pairs: TypingIterable[Any]) -> Iterator[float]:\n    \"\"\"\n    Generates absolute differences for each valid pair in the input iterable.\n    Performs item-level validation via _to_tuplepair.\n    \"\"\"\n    for item in pairs:\n        tuple_pair = _to_tuplepair(item)\n        yield tuple_pair.difference()\n\n\ndef max_difference(pairs: TypingIterable[Tuple[Union[int, float], Union[int, float]]]) -> float:\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in the given tuple list.\n    Validates input and raises TypeError or ValueError for invalid cases.\n    \"\"\"\n    if not isinstance(pairs, Iterable):\n        raise TypeError(f\"Input 'pairs' must be an iterable, but got {type(pairs).__name__}.\")\n    \n    differences_generator = _iter_differences(pairs)\n    \n    try:\n        # Get the first difference to initialize max_diff; handles empty generator.\n        max_diff = next(differences_generator)\n    except StopIteration:\n        raise ValueError(\"Input 'pairs' cannot be empty.\")\n    \n    # Iterate through remaining differences to find the maximum.\n    for diff in differences_generator:\n        if diff > max_diff:\n            max_diff = diff\n    \n    return float(max_diff)"}
