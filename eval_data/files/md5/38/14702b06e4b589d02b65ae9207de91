{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple, Iterator\nfrom dataclasses import dataclass\n\n@dataclass\nclass TupleEntry:\n    first: Any\n    second: Any\n\nclass TupleList:\n    \"\"\"A thin wrapper around a list of TupleEntry objects.\"\"\"\n    def __init__(self, raw_entries: List[Tuple[Any, Any]]) -> None:\n        \"\"\"Initializes TupleList by converting raw tuples to TupleEntry objects.\"\"\"\n        self.entries: List[TupleEntry] = [TupleEntry(first=t[0], second=t[1]) for t in raw_entries]\n\n    def __iter__(self) -> Iterator[TupleEntry]:\n        \"\"\"Allows iteration over the contained TupleEntry objects.\"\"\"\n        return iter(self.entries)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of entries in the list.\"\"\"\n        return len(self.entries)\n\ndef index_minimum(entries: List[Tuple[Any, Any]]) -> Any:\n    \"\"\"Return the first element of the tuple with the smallest second element.\"\"\"\n\n    # Normalize input to TupleList for iteration as TupleEntry objects.\n    # This aligns with the design's mention of iterating 'TupleEntry items'\n    # and assumes 'entries' is a List[Tuple[Any, Any]] as per the example and constraints.\n    tuple_list_wrapper = TupleList(entries)\n\n    current_min_second_value = float('inf')\n    result_first_value = None\n\n    for entry in tuple_list_wrapper:\n        if entry.second < current_min_second_value:\n            current_min_second_value = entry.second\n            result_first_value = entry.first\n    \n    return result_first_value"}
{"task_id": "Mbpp/92", "solution": "class Number:\n    \"\"\"Represents an integer and provides digit extraction, handling absolute value.\"\"\"\n    def __init__(self, value: int):\n        self.value = abs(value)\n\n    def getDigits(self) -> list[int]:\n        \"\"\"Returns a list of decimal digits, MSB to LSB.\"\"\"\n        return [int(d) for d in str(self.value)]\n\nclass DigitSequence:\n    \"\"\"Container for a list of digits and provides inspection operations.\"\"\"\n    def __init__(self, digits: list[int]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def distinctDigits(self) -> set[int]:\n        \"\"\"Returns a set of unique digits in the sequence.\"\"\"\n        return set(self.digits)\n\nclass UndulatingResult:\n    \"\"\"Wraps the boolean result of an undulating number check.\"\"\"\n    def __init__(self, isUndulating: bool):\n        self.isUndulating = isUndulating\n\nclass UndulatingChecker:\n    \"\"\"Applies business rules to Number/DigitSequence to determine if a number is undulating.\"\"\"\n    def __init__(self):\n        pass\n\n    def _check_alternation(self, digits: list[int]) -> bool:\n        \"\"\"Internal helper to ensure digits strictly alternate between two values for the full length.\"\"\"\n        # This helper assumes len(digits) >= 2 based on pre-checks in is_undulating.\n        \n        # The first two digits must be distinct for an alternating pattern.\n        if digits[0] == digits[1]:\n            return False\n\n        # Check that digits[i] is equal to digits[i-2] for i >= 2.\n        for i in range(2, len(digits)):\n            if digits[i] != digits[i-2]:\n                return False\n        return True\n\n    def is_undulating(self, number_obj: Number) -> UndulatingResult:\n        \"\"\"Evaluates if the given Number is undulating based on business rules.\"\"\"\n        digits = number_obj.getDigits()\n        digit_sequence = DigitSequence(digits)\n\n        # BR3: Require at least two digits for a number to be undulating.\n        if digit_sequence.length() < 2:\n            return UndulatingResult(False)\n\n        # BR2, BR6: A number is undulating if its decimal digits alternate between exactly two distinct digit values.\n        distinct_digits = digit_sequence.distinctDigits()\n        if len(distinct_digits) != 2:\n            return UndulatingResult(False)\n\n        # Check the strict alternation pattern.\n        is_alternating = self._check_alternation(digits)\n        \n        return UndulatingResult(is_alternating)\n\ndef is_undulating(number) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number's decimal digits strictly alternate between exactly two distinct digits for the entire length.\n    \"\"\"\n    # BR5: Consider negative numbers by evaluating the absolute value.\n    number_obj = Number(number)\n\n    # Delegate evaluation to UndulatingChecker.\n    checker = UndulatingChecker()\n    result = checker.is_undulating(number_obj)\n\n    # BR7: Return boolean True/False.\n    return result.isUndulating"}
{"task_id": "Mbpp/86", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input parameters.\n    It carries a message string describing the validation violation.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass CenteredHexagonalFunction:\n    \"\"\"\n    Stateless class responsible for validating input parameters and\n    computing the nth centered hexagonal number using the specified formula.\n    \"\"\"\n    def validateInput(self, n: int) -> None:\n        \"\"\"\n        Ensures n is an integer and n is greater than or equal to 1.\n        Raises ValidationError with an explanatory message if validation fails.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"n must be an integer.\")\n        if n < 1:\n            raise ValidationError(\"n must be an integer greater than or equal to 1.\")\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth centered hexagonal number using the formula 3 * n * (n - 1) + 1.\n        The input n is first validated to ensure it is an integer >= 1.\n        \"\"\"\n        self.validateInput(n)\n        return 3 * n * (n - 1) + 1\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth centered hexagonal number.\n    It validates the input 'n' to be an integer >= 1 and raises a ValidationError otherwise.\n    \"\"\"\n    calculator = CenteredHexagonalFunction()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"Compute and return the length of the shortest sublist in list_of_lists.\n\n    Args:\n        list_of_lists: A top-level list whose elements are themselves lists (List[List]).\n\n    Returns:\n        int: the minimum length among the sublists.\n    \"\"\"\n    return min(len(s) for s in list_of_lists)"}
{"task_id": "Mbpp/96", "solution": "from math import isqrt\n\ndef divisor(n: int) -> int:\n    \"\"\"Compute and return the number of positive divisors of n (including 1 and n).\n\n    Raises:\n      TypeError: if n is not an int.\n      ValueError: if n <= 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    sqrt_n = isqrt(n)\n    for i in range(1, sqrt_n + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(sequence):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides by its length, returning a float.\n    Validates input type and content before computation.\n    \"\"\"\n    if not isinstance(sequence, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n\n    if not sequence:\n        raise ValueError(\"Input sequence cannot be empty.\")\n\n    product = 1\n    for item in sequence:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n        product *= item\n\n    result = float(product) / len(sequence)\n    return result"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Dict, Iterable\n\ndef _validate_input(list_of_lists: Any) -> None:\n    \"\"\"Raise TypeError if top-level is not a list of lists.\"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements of the top-level list must be lists.\")\n\ndef _flatten(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"Return flattened list by concatenating sublists in order (single-level).\"\"\"\n    flattened_list = []\n    for sublist in list_of_lists:\n        flattened_list.extend(sublist)\n    return flattened_list\n\ndef _count(elements: Iterable[Any]) -> Dict[Any, int]:\n    \"\"\"Return frequency dict mapping element -> int count.\"\"\"\n    frequency_map = {}\n    for element in elements:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n    return frequency_map\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"Validate input, flatten one level, count occurrences, return dict.\"\"\"\n    _validate_input(list_of_lists)\n    elements = _flatten(list_of_lists)\n    return _count(elements)"}
{"task_id": "Mbpp/100", "solution": "def is_palindrome(n: int) -> bool:\n    \"\"\"Checks if the decimal representation of n is a palindrome.\"\"\"\n    s = str(n)\n    return s == s[::-1]\n\ndef _generate_next_candidate(current: int) -> int:\n    \"\"\"Returns the next integer candidate by incrementing the current number.\"\"\"\n    return current + 1\n\ndef next_smallest_palindrome(input: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the specified integer.\n    It incrementally checks integers until a palindrome is found.\n    \"\"\"\n    candidate = input + 1\n    while True:\n        if is_palindrome(candidate):\n            return candidate\n        candidate = _generate_next_candidate(candidate)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n\n    binary_digits = []\n    while n > 0:\n        binary_digits.append(str(n % 2))\n        n //= 2\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"Accepts a single string argument and returns a CamelCase string.\"\"\"\n    if not input_string:\n        return \"\"\n    \n    words = input_string.split('_')\n    camel_cased_words = []\n    for word in words:\n        if word:  # Skip empty strings resulting from consecutive underscores\n            camel_cased_words.append(word.capitalize())\n            \n    return \"\".join(camel_cased_words)"}
{"task_id": "Mbpp/105", "solution": "def count(values):\n    \"\"\"Return the number of elements in 'values' that are instances of bool and equal to True.\n\n    The function iterates through the input and counts only explicit boolean True values.\n    \"\"\"\n    total = 0\n    for item in values:\n        if isinstance(item, bool) and item is True:\n            total += 1\n    return total"}
{"task_id": "Mbpp/101", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Element:\n    def __init__(self, value: any, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass Array:\n    def __init__(self, elements: list) -> None:\n        self.elements = list(elements)\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get(self, index: int):\n        return Element(self.elements[index], index + 1)\n\ndef kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises ValidationError for invalid input types or out-of-range k.\n    \"\"\"\n    if not isinstance(array, Array):\n        try:\n            array_wrapper = Array(array)\n        except TypeError:\n            raise ValidationError(f\"Invalid array input: {array}. Must be a sequential collection.\")\n    else:\n        array_wrapper = array\n\n    if not isinstance(k, int):\n        raise ValidationError(f\"k must be an integer, got {type(k).__name__}\")\n\n    n = array_wrapper.length()\n\n    if not (1 <= k <= n):\n        raise ValidationError(f\"k out of range: expected 1..{n}, got {k}\")\n\n    element_obj = array_wrapper.get(k - 1)\n\n    if isinstance(element_obj, Element):\n        return element_obj.value\n    else:\n        return element_obj"}
{"task_id": "Mbpp/103", "solution": "class InputValidator:\n    \"\"\"Validates inputs for Eulerian number computation.\"\"\"\n    @staticmethod\n    def validate_types(n, m):\n        \"\"\"Ensures n and m are integers.\"\"\"\n        if not isinstance(n, int) or not isinstance(m, int):\n            raise ValueError(\"n and m must be integers\")\n\n    @staticmethod\n    def validate_range(n, m):\n        \"\"\"Ensures m is within valid range for a given n.\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n        elif n == 0:\n            if m != 0:\n                raise ValueError(\"For n=0, m must be 0\")\n        else: # n > 0\n            if not (0 <= m < n):\n                raise ValueError(f\"For n={n}, m must satisfy 0 <= m < n\")\n\nclass EulerianCalculator:\n    \"\"\"Calculates Eulerian numbers using recurrence relation with memoization.\"\"\"\n    def __init__(self):\n        self._memo = {}\n\n    def _compute_by_recurrence(self, n, m):\n        \"\"\"\n        Computes the Eulerian number a(n, m) using the recurrence relation.\n        Handles base cases and utilizes memoization.\n        \"\"\"\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        # Base cases\n        if m < 0 or m >= n:\n            result = 0\n        elif n == 0 and m == 0:\n            result = 1\n        elif m == 0: # For n > 0, a(n, 0) = 1\n            result = 1\n        else: # For n > 0 and 0 < m < n\n            # Recurrence relation: a(n, m) = (m+1) * a(n-1, m) + (n-m) * a(n-1, m-1)\n            term1 = (m + 1) * self._compute_by_recurrence(n - 1, m)\n            term2 = (n - m) * self._compute_by_recurrence(n - 1, m - 1)\n            result = term1 + term2\n\n        self._memo[(n, m)] = result\n        return result\n\ndef eulerian_num(n, m) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m).\n    Validates inputs and calculates the result using a recurrence relation.\n    \"\"\"\n    InputValidator.validate_types(n, m)\n    InputValidator.validate_range(n, m)\n    \n    calculator = EulerianCalculator()\n    return calculator._compute_by_recurrence(n, m)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List, Iterator, Any\n\nclass StringItem:\n    def __init__(self, value: str):\n        self.value = value\n\nclass Sublist:\n    def __init__(self, position: int, items: Sequence[str]):\n        self.position = position\n        self.items = list(items)\n\n    def sort_items(self) -> List[str]:\n        \"\"\"Returns the stored items, sorted lexicographically.\"\"\"\n        return sorted(self.items)\n\nclass SublistsCollection:\n    def __init__(self, sublists: List[Sublist]):\n        self._sublists = sublists\n\n    @classmethod\n    def from_sequence(cls, sequence_of_sublists: Sequence[Sequence[str]]) -> 'SublistsCollection':\n        \"\"\"Maps input elements to Sublist instances.\"\"\"\n        _sublists: List[Sublist] = []\n        for i, sublist_items in enumerate(sequence_of_sublists):\n            _sublists.append(Sublist(i, sublist_items))\n        return cls(_sublists)\n\n    def __iter__(self) -> Iterator['Sublist']:\n        \"\"\"Iterates through the encapsulated Sublist instances.\"\"\"\n        return iter(self._sublists)\n\nclass SortSublistsFunction:\n    def sort(self, sequence_of_sublists: Sequence[Sequence[str]]) -> List[List[str]]:\n        \"\"\"Processes sublists through SublistsCollection and collects sorted results.\"\"\"\n        collection = SublistsCollection.from_sequence(sequence_of_sublists)\n        results: List[List[str]] = []\n        for sub in collection:\n            results.append(sub.sort_items())\n        return results\n\ndef sort_sublists(sequence_of_sublists: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"Entry point to sort each sublist of strings, delegating orchestration to SortSublistsFunction.\"\"\"\n    orchestrator = SortSublistsFunction()\n    return orchestrator.sort(sequence_of_sublists)"}
{"task_id": "Mbpp/106", "solution": "def add_lists(list_input, tuple_input):\n    \"\"\"\n    Appends elements from a list to a tuple, returning a new tuple.\n    The input list and tuple are not modified.\n    \"\"\"\n    return tuple_input + tuple(list_input)"}
{"task_id": "Mbpp/108", "solution": "def _validate_input(lst: list[int]) -> None:\n    \"\"\"Validate that the input is a list of integers.\n    Raises TypeError if validation fails.\"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in lst:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef _concat_and_sort(list1: list[int], list2: list[int], list3: list[int]) -> list[int]:\n    \"\"\"Concatenate three lists and return a new sorted list.\"\"\"\n    combined_list = list1 + list2 + list3\n    return sorted(combined_list)\n\ndef merge_sorted_list(list1: list[int], list2: list[int], list3: list[int]) -> list[int]:\n    \"\"\"Merge three lists of integers into a single sorted list.\"\"\"\n    _validate_input(list1)\n    _validate_input(list2)\n    _validate_input(list3)\n    return _concat_and_sort(list1, list2, list3)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds the common elements present in every inner list of a given list of lists.\n    Returns an iterable containing unique common elements.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize common_elements with the set of the first inner list.\n    # The algorithm implicitly handles non-list elements by allowing set() to raise errors if types are incompatible.\n    common_elements = set(nested_lists[0])\n\n    # Intersect with the remaining inner lists.\n    for i in range(1, len(nested_lists)):\n        common_elements.intersection_update(nested_lists[i])\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "import re\n\ndef check_integer(input: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer using a regular expression.\n    Applies the regex ^[+-]?\\\\d+$ to the input string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"check_integer expects a str argument\")\n    return bool(re.fullmatch(r\"^[+-]?\\d+$\", input))"}
{"task_id": "Mbpp/109", "solution": "class ValidationError(ValueError):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    pass\n\nclass BinaryString:\n    \"\"\"Represents a binary string with validation and rotation capabilities.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def validate(self) -> None:\n        \"\"\"Validates that the string contains only '0' and '1'.\"\"\"\n        if not all(char in '01' for char in self.value):\n            raise ValidationError(\"Input string 's' must contain only '0' and '1'.\")\n\n    def rotate(self, shift: int) -> str:\n        \"\"\"Performs a cyclic rotation of the string.\"\"\"\n        length = self.length()\n        if length == 0:\n            return \"\"\n        actual_shift = shift % length\n        return self.value[actual_shift:] + self.value[:actual_shift]\n\nclass Rotation:\n    \"\"\"Represents a single rotation of a binary string and checks its oddness.\"\"\"\n    def __init__(self, index: int, rotatedValue: str) -> None:\n        self.index = index\n        self.rotatedValue = rotatedValue\n\n    def isOdd(self) -> bool:\n        \"\"\"Determines if the rotated string represents an odd number.\"\"\"\n        return self.rotatedValue and self.rotatedValue[-1] == '1'\n\nclass OddEquivalentService:\n    \"\"\"Orchestrates the process of counting odd-valued rotations.\"\"\"\n    def odd_Equivalent(self, s: str, n: int) -> int:\n        \"\"\"Public entry point for counting odd-valued rotations, including input validation.\"\"\"\n        binary = BinaryString(s)\n        binary.validate()\n\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n        return self.countOddRotations(binary, n)\n\n    def countOddRotations(self, binary: BinaryString, n: int) -> int:\n        \"\"\"Counts the number of odd-valued rotations up to n times.\"\"\"\n        odd_count = 0\n        for k in range(n):\n            rotated_str = binary.rotate(k)\n            rotation = Rotation(k, rotated_str)\n            if rotation.isOdd():\n                odd_count += 1\n        return odd_count\n\ndef odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"\n    Finds the number of rotations of a binary string that result in an odd value.\n    Delegates to OddEquivalentService for logic and validation.\n    \"\"\"\n    svc = OddEquivalentService()\n    return svc.odd_Equivalent(s, n)"}
