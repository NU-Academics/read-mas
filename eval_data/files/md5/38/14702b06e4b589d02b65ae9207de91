{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\n\ndef max_Product(integers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from the given list with the highest product.\n    The function returns a tuple of the two integers, preserving their original order of appearance.\n    \"\"\"\n    n = len(integers)\n    \n    # Initialize with the product of the first two elements and their indices\n    max_prod = integers[0] * integers[1]\n    best_i, best_j = 0, 1\n\n    # Iterate through all distinct pairs of indices (i, j) where i < j\n    for i in range(n):\n        for j in range(i + 1, n):\n            current_prod = integers[i] * integers[j]\n\n            # Update if current product is greater, or if it's equal but\n            # the current pair's indices are preferred by the tie-breaking rule.\n            if current_prod > max_prod:\n                max_prod = current_prod\n                best_i, best_j = i, j\n            elif current_prod == max_prod:\n                # Tie-breaking: prefer pair with earliest first index\n                if i < best_i:\n                    best_i, best_j = i, j\n                # If first indices are tied, prefer pair with earliest second index\n                elif i == best_i and j < best_j:\n                    best_i, best_j = i, j\n\n    return (integers[best_i], integers[best_j])"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Validate n and return sum_{k=1..n} (2k)^3 as int.\n    Raises TypeError for non-int and ValueError for negative int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Compute sum_{k=1..n} (2k)^3 using the closed-form formula: 2 * n^2 * (n+1)^2\n    result = 2 * (n ** 2) * ((n + 1) ** 2)\n    return result"}
{"task_id": "Mbpp/419", "solution": "from typing import Sequence\n\ndef _round_to_even(value: float) -> int:\n    \"\"\"Return integer obtained by rounding value using round-half-to-even (banker's rounding).\"\"\"\n    return round(value)\n\ndef _print_result(result: int) -> None:\n    \"\"\"Print the integer result to stdout.\"\"\"\n    print(result)\n\ndef round_and_sum(numbers: Sequence[float]) -> int:\n    \"\"\"Accepts a list/sequence of numeric values, rounds each using round-half-to-even, sums rounded integers, multiplies sum by length, prints and returns final int.\"\"\"\n    rounded_sum = 0\n    for num in numbers:\n        rounded_sum += _round_to_even(num)\n\n    final_result = rounded_sum * len(numbers)\n\n    _print_result(final_result)\n    return final_result"}
{"task_id": "Mbpp/424", "solution": "from dataclasses import dataclass\n\n# Type aliases as per design context\nStringTuple = tuple[str, ...]\nResultList = list[str]\n\n@dataclass\nclass StringElement:\n    value: str\n    def last_char(self) -> str:\n        return self.value[-1]\n\ndef extract_rear(input_tuple: tuple[str, ...]) -> list[str]:\n    \"\"\"Accepts a tuple of strings and returns a list of last-character strings in the same order.\n    For empty strings, an empty string is appended to the result.\n    \"\"\"\n    result = []\n    for s in input_tuple:\n        if s == '':\n            result.append('')\n        else:\n            element = StringElement(s)\n            result.append(element.last_char())\n    return result"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n) -> float:\n    \"\"\"\n    Finds the average of cubes of the first n natural numbers.\n    Validates input, computes cubes, and returns their arithmetic mean.\n    \"\"\"\n    _validate(n)\n    cubes = _compute_cubes(n)\n    return _compute_mean(cubes)\n\ndef _validate(n) -> None:\n    \"\"\"\n    Ensures n is an integer and n >= 1; raises ValueError otherwise.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        _raise_invalid_input(f\"n must be a positive integer >= 1; got: {n!r}\")\n\ndef _compute_cubes(n) -> list[int]:\n    \"\"\"\n    Computes cubes for integers from 1 to n.\n    \"\"\"\n    return [i ** 3 for i in range(1, n + 1)]\n\ndef _compute_mean(numbers) -> float:\n    \"\"\"\n    Calculates the arithmetic mean of a list of numbers.\n    Assumes the input list is non-empty.\n    \"\"\"\n    return float(sum(numbers)) / len(numbers)\n\ndef _raise_invalid_input(msg) -> None:\n    \"\"\"\n    Raises a ValueError with the given message for invalid input.\n    \"\"\"\n    raise ValueError(msg)"}
{"task_id": "Mbpp/425", "solution": "def _sublist_contains(sublist, element):\n    \"\"\"Checks if a sublist contains the specified element using equality (==).\"\"\"\n    for item in sublist:\n        if item == element:\n            return True\n    return False\n\ndef count_element_in_list(list_of_sublists, element):\n    \"\"\"Counts the number of sublists containing a particular element.\"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        if _sublist_contains(sublist, element):\n            count += 1\n    return count"}
{"task_id": "Mbpp/421", "solution": "DELIMITER: str = '-'\n\ndef concatenate_tuple(input_tuple: tuple) -> str:\n    \"\"\"\n    Concatenates elements of a tuple into a single string using a hyphen delimiter.\n    Converts all elements to their string representation before joining.\n    \"\"\"\n    if not input_tuple:\n        return ''\n\n    # Convert each element to its string representation\n    string_elements = [str(elem) for elem in input_tuple]\n\n    # Join the string elements with the delimiter\n    return DELIMITER.join(string_elements)"}
{"task_id": "Mbpp/426", "solution": "class Integer:\n    \"\"\"Encapsulates an integer value and provides a method to check if it's odd.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the encapsulated integer is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass IntegerList:\n    \"\"\"Wraps a list of integers, providing list-like access and iteration.\"\"\"\n    def __init__(self, items: list[int]) -> None:\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the item at the specified index.\"\"\"\n        return self.items[index]\n\n    def __iter__(self):\n        \"\"\"Allows iteration over the encapsulated items.\"\"\"\n        return iter(self.items)\n\nclass FilterOddNumbersFunction:\n    \"\"\"Provides the core logic for filtering odd numbers from an IntegerList.\"\"\"\n    def filter_oddnumbers(self, input_list: IntegerList) -> IntegerList:\n        \"\"\"Filters an IntegerList, returning a new IntegerList containing only odd numbers.\"\"\"\n        odd_numbers_raw = []\n        for value in input_list:\n            if Integer(value).is_odd():\n                odd_numbers_raw.append(value)\n        return IntegerList(odd_numbers_raw)\n\ndef filter_oddnumbers(input_list: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning a new list containing only odd numbers.\"\"\"\n    input_integer_list = IntegerList(input_list)\n    filter_func = FilterOddNumbersFunction()\n    result_integer_list = filter_func.filter_oddnumbers(input_integer_list)\n    return result_integer_list.items"}
{"task_id": "Mbpp/427", "solution": "class DateString:\n    \"\"\"Parses 'yyyy-mm-dd' raw input and emits 'dd-mm-yyyy' formatted output.\"\"\"\n    def __init__(self, raw: str, year: str, month: str, day: str) -> None:\n        self.raw = raw\n        self.year = year\n        self.month = month\n        self.day = day\n\n    @staticmethod\n    def parse(raw: str) -> 'DateString':\n        \"\"\"Creates a DateString instance by splitting the raw string.\"\"\"\n        parts = raw.split('-')\n        year, month, day = parts[0], parts[1], parts[2]\n        return DateString(raw, year, month, day)\n\n    def format_dd_mm_yyyy(self) -> str:\n        \"\"\"Returns the date formatted as 'dd-mm-yyyy'.\"\"\"\n        return f\"{self.day}-{self.month}-{self.year}\"\n\nclass DateConverter:\n    \"\"\"Orchestrates date format conversion using DateString.\"\"\"\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Converts a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy'.\"\"\"\n        ds = DateString.parse(date_str)\n        return ds.format_dd_mm_yyyy()\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\"\"\"\n    return DateConverter().change_date_format(date_str)"}
{"task_id": "Mbpp/428", "solution": "from typing import List, Any, Optional\n\nclass Element:\n    \"\"\"Wraps a comparable value for sorting and defines comparison operations.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\n    def __lt__(self, other: 'Element') -> bool:\n        return self.value < other.value\n\n    def __le__(self, other: 'Element') -> bool:\n        return self.value <= other.value\n\n    def __eq__(self, other: 'Element') -> bool:\n        return self.value == other.value\n    \n    def __repr__(self) -> str:\n        return f\"Element({self.value})\"\n\nclass Array:\n    \"\"\"Represents an ordered collection of Element items with length and access methods.\"\"\"\n    def __init__(self, elements: List['Element']) -> None:\n        self.elements: List[Element] = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, idx: int) -> 'Element':\n        return self.elements[idx]\n\n    def __setitem__(self, idx: int, value: 'Element') -> None:\n        self.elements[idx] = value\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Converts the Array of Elements back to a standard Python list of values.\"\"\"\n        return [e.value for e in self.elements]\n\nclass Comparator:\n    \"\"\"Provides a comparison method for two Element objects.\"\"\"\n    def compare(self, a: 'Element', b: 'Element') -> int:\n        if a < b:\n            return -1\n        elif a == b:\n            return 0\n        else: # a > b\n            return 1\n\nclass ShellSorter:\n    \"\"\"Encapsulates the Shell sort algorithm with gap computation and insertion sort.\"\"\"\n    def __init__(self, comparator: Optional[Comparator] = None) -> None:\n        self._comparator = comparator if comparator is not None else Comparator()\n\n    def shell_sort(self, arr: 'Array') -> 'Array':\n        \"\"\"Sorts the given Array using the Shell sort algorithm.\"\"\"\n        n = arr.length()\n        gaps = self.computeGaps(n)\n\n        for gap in gaps:\n            self.gapInsertionSort(arr, gap)\n        return arr\n\n    def computeGaps(self, n: int) -> List[int]:\n        \"\"\"Computes a sequence of gaps (Knuth's sequence in reverse) for Shell sort.\"\"\"\n        gaps = []\n        h = 1\n        while h < n // 3:\n            h = 3 * h + 1\n        \n        while h >= 1:\n            gaps.append(h)\n            h //= 3\n        return gaps\n\n    def gapInsertionSort(self, arr: 'Array', gap: int) -> None:\n        \"\"\"Performs a gap-based insertion sort on the array.\"\"\"\n        n = arr.length()\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and self._comparator.compare(arr[j - gap], temp) > 0:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n\ndef shell_sort(arr: List[Any]) -> List[Any]:\n    \"\"\"Public API. Accepts a Python list/sequence and returns a sorted Python list.\"\"\"\n    # Convert input list of raw values to Array of Element objects\n    domain_array = Array([Element(v) for v in arr])\n    \n    # Instantiate ShellSorter and perform the sort\n    sorter = ShellSorter()\n    sorted_domain_array = sorter.shell_sort(domain_array)\n    \n    # Convert sorted Array of Element objects back to a list of raw values\n    return sorted_domain_array.to_list()"}
{"task_id": "Mbpp/429", "solution": "class LengthMismatchException(Exception):\n    \"\"\"Raised when input tuple lengths differ.\"\"\"\n\ndef and_tuples(input_a: tuple[int, ...], input_b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Compute elementwise bitwise AND of two integer tuples.\n\n    Raises LengthMismatchException when len(input_a) != len(input_b).\n    \"\"\"\n    if len(input_a) != len(input_b):\n        raise LengthMismatchException(\"input tuples must have the same length\")\n\n    result_list = [a & b for a, b in zip(input_a, input_b)]\n    return tuple(result_list)"}
{"task_id": "Mbpp/432", "solution": "import math\n\ndef median_trapezium(a, b, c) -> float:\n    \"\"\"\n    Calculates the median length of a trapezium.\n    Raises ValueError if any input is not a finite number.\n    \"\"\"\n    if not math.isfinite(a):\n        raise ValueError(\"non-finite input parameter: a\")\n    if not math.isfinite(b):\n        raise ValueError(\"non-finite input parameter: b\")\n    if not math.isfinite(c):\n        raise ValueError(\"non-finite input parameter: c\")\n\n    return (a + b) / 2"}
{"task_id": "Mbpp/433", "solution": "from dataclasses import dataclass\nfrom typing import List, Any\n\n@dataclass\nclass NumberValue:\n    value: float\n\n@dataclass\nclass NumberArray:\n    elements: List[NumberValue]\n\n# BooleanResult represented as native bool\nBooleanResult = bool\n\ndef check_greater(arr: NumberArray, value: NumberValue) -> BooleanResult:\n    \"\"\"\n    Checks if the given value is strictly greater than every element in the array.\n    Supports both native Python types (list, number) and custom dataclasses (NumberArray, NumberValue).\n    \"\"\"\n    elements_to_check = arr.elements if isinstance(arr, NumberArray) else arr\n    compare_value = value.value if isinstance(value, NumberValue) else value\n\n    for element in elements_to_check:\n        element_value = element.value if isinstance(element, NumberValue) else element\n        if compare_value <= element_value:\n            return False\n    return True"}
