{"task_id": "Mbpp/125", "solution": "class BinaryString:\n    \"\"\"Represents a binary string and validates its content.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the string contains only '0' and '1', False otherwise.\"\"\"\n        return all(c in ('0', '1') for c in self.value)\n\nclass Substring:\n    \"\"\"Represents a contiguous substring for conceptual modeling.\"\"\"\n    def __init__(self, start: int, end: int, zeros: int, ones: int):\n        self.start = start\n        self.end = end\n        self.zeros = zeros\n        self.ones = ones\n\n    def score(self) -> int:\n        \"\"\"Returns the difference (zeros - ones) for the substring.\"\"\"\n        return self.zeros - self.ones\n\nclass Result:\n    \"\"\"Container for the maximum difference result.\"\"\"\n    def __init__(self, max_difference: int):\n        self.max_difference = max_difference\n\ndef _map_char(c: str) -> int:\n    \"\"\"Maps '0' to +1 and '1' to -1.\"\"\"\n    if c == '0':\n        return 1\n    else: # c == '1'\n        return -1\n\ndef _kadane(values: list[int]) -> int:\n    \"\"\"Implements Kadane's algorithm to find the maximum subarray sum.\"\"\"\n    if not values:\n        return 0\n\n    max_so_far = values[0]\n    current_max = values[0]\n\n    for i in range(1, len(values)):\n        current_max = max(values[i], current_max + values[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Uses Kadane's algorithm by mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    bs = BinaryString(s)\n\n    if not bs.is_valid():\n        raise ValueError(\"input must contain only '0' and '1'\")\n\n    if not s:\n        return 0\n\n    mapped_values = [_map_char(c) for c in bs.value]\n    return _kadane(mapped_values)"}
{"task_id": "Mbpp/123", "solution": "from typing import List, Set\n\nclass DivisorSumCalculator:\n    \"\"\"\n    Computes the sum of proper divisors for a given positive integer.\n    \"\"\"\n    def sumProperDivisors(self, m: int) -> int:\n        if m <= 1:\n            return 0\n        _sum = 1  # 1 is always a proper divisor for m > 1\n        i = 2\n        while i * i <= m:\n            if m % i == 0:\n                _sum += i\n                if i * i != m:\n                    _sum += m // i\n            i += 1\n        return _sum\n\nclass Number:\n    \"\"\"\n    Represents an integer value and its computed sum of proper divisors.\n    \"\"\"\n    def __init__(self, value: int, sumProperDivisors: int) -> None:\n        self.value = value\n        self.sumProperDivisors = sumProperDivisors\n\nclass AmicablePair:\n    \"\"\"\n    Represents a candidate amicable pair (a, b) and validates the amicability relationship.\n    \"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def isValid(self, divisor_calculator: DivisorSumCalculator) -> bool:\n        \"\"\"\n        Verify amicable condition: sumProperDivisors(a) == b AND sumProperDivisors(b) == a AND a != b.\n        Excludes perfect numbers via a != b and mutual verification.\n        \"\"\"\n        if self.a == self.b:\n            return False\n        \n        sum_a = divisor_calculator.sumProperDivisors(self.a)\n        sum_b = divisor_calculator.sumProperDivisors(self.b)\n\n        return sum_a == self.b and sum_b == self.a\n\nclass Result:\n    \"\"\"\n    Holds the final aggregation result for a given n.\n    \"\"\"\n    def __init__(self, n: int, amicableNumbers: List[int]) -> None:\n        self.n = n\n        self.amicableNumbers = amicableNumbers\n        self.sum = 0 # Initialized, will be computed by compute_sum\n\n    def compute_sum(self) -> int:\n        \"\"\"\n        Compute and set self.sum as sum(self.amicableNumbers) and return it.\n        \"\"\"\n        self.sum = sum(self.amicableNumbers)\n        return self.sum\n\nclass AmicableAnalyzer:\n    \"\"\"\n    Orchestrates computations across 1..n: compute divisor sums, identify amicable pairs,\n    filter perfect numbers and duplicates, aggregate unique amicable numbers and produce Result.\n    \"\"\"\n    def __init__(self, divisor_calculator: DivisorSumCalculator) -> None:\n        self.divisor_calculator = divisor_calculator\n\n    def _findPairs(self, n: int) -> List[AmicablePair]:\n        \"\"\"\n        Find and return list of valid amicable pairs where both members are in 1..n,\n        verify mutual condition, and exclude perfect numbers.\n        \"\"\"\n        found_pairs_set = set() # To store unique (a, b) tuples, ensuring no duplicates\n\n        # Iterate through all possible 'a' values from 1 to n\n        for a_val in range(1, n + 1):\n            # Calculate sum of proper divisors for 'a_val'\n            sum_a = self.divisor_calculator.sumProperDivisors(a_val)\n            \n            # 'sum_a' is a candidate for 'b_val'.\n            # Conditions for a potential candidate pair (a_val, b_val=sum_a):\n            # 1. b_val must be within the range [1, n].\n            # 2. a_val must be strictly less than b_val to avoid processing duplicate pairs\n            #    (e.g., (220, 284) and then (284, 220)) and implicitly exclude perfect numbers (where a_val == sum_a).\n            if 1 <= sum_a <= n and a_val < sum_a:\n                b_val = sum_a\n                \n                # Use the AmicablePair class to formally validate the pair, delegating divisor sum calculation\n                candidate_pair = AmicablePair(a_val, b_val)\n                if candidate_pair.isValid(self.divisor_calculator):\n                    # If valid, add the sorted tuple (min_val, max_val) to the set\n                    found_pairs_set.add(tuple(sorted((a_val, b_val))))\n        \n        # Convert the set of unique tuples back to a list of AmicablePair objects\n        return [AmicablePair(p[0], p[1]) for p in found_pairs_set]\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"\n        Primary orchestration method that returns integer sum for input n (delegates to findPairs and Result).\n        \"\"\"\n        # Find all amicable pairs within the range [1, n]\n        pairs = self._findPairs(n)\n        \n        # Collect unique amicable numbers from the found pairs into a set\n        unique_amicable_numbers: Set[int] = set()\n        for pair in pairs:\n            unique_amicable_numbers.add(pair.a)\n            unique_amicable_numbers.add(pair.b)\n        \n        # Create a Result object with the collected unique numbers, sorted for consistency\n        result_obj = Result(n, sorted(list(unique_amicable_numbers)))\n        \n        # Compute and return the sum\n        return result_obj.compute_sum()\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Returns the integer sum of all amicable numbers in the inclusive range 1..n.\n    \"\"\"\n    if n < 1:\n        return 0\n    \n    calculator = DivisorSumCalculator()\n    analyzer = AmicableAnalyzer(calculator)\n    return analyzer.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/126", "solution": "def _positive_divisors(n: int) -> set[int]:\n    \"\"\"Return set of positive divisors of n.\"\"\"\n    divs = set()\n    abs_n = abs(n)\n    if abs_n == 0:\n        return divs\n\n    for i in range(1, abs_n + 1):\n        if abs_n % i == 0:\n            divs.add(i)\n    return divs\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Return sum of all positive integers that divide both a and b.\"\"\"\n    divisors_a = _positive_divisors(a)\n    divisors_b = _positive_divisors(b)\n\n    common_divisors = divisors_a.intersection(divisors_b)\n\n    return sum(common_divisors)"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Any\n\nclass _ComplexNumber:\n    \"\"\"Internal representation of a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\n    def is_zero(self) -> bool:\n        \"\"\"Checks if the complex number is 0+0j.\"\"\"\n        return self.real == 0 and self.imag == 0\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts this internal representation to Python's built-in complex type.\"\"\"\n        return complex(self.real, self.imag)\n\ndef _to_complex_internal(value: Any) -> _ComplexNumber:\n    \"\"\"Converts an input value to an internal _ComplexNumber, validating its type.\"\"\"\n    if isinstance(value, complex):\n        return _ComplexNumber(value.real, value.imag)\n    elif isinstance(value, (int, float)):\n        return _ComplexNumber(float(value), 0.0)\n    else:\n        raise TypeError(\"Input must be an int, float, or complex number.\")\n\ndef _validate_types_internal(arg1: Any, arg2: Any) -> None:\n    \"\"\"Validates that both arguments are of allowed types (int, float, or complex).\"\"\"\n    allowed_types = (int, float, complex)\n    if not isinstance(arg1, allowed_types) or not isinstance(arg2, allowed_types):\n        raise TypeError(\"Arguments must be int, float, or complex numbers.\")\n\ndef _validate_nonzero_internal(z: complex) -> None:\n    \"\"\"Raises a ValueError if the complex number is 0+0j.\"\"\"\n    if z.real == 0 and z.imag == 0:\n        raise ValueError(\"Argument is undefined: complex number 0+0j.\")\n\ndef _compute_angle_internal(z: complex) -> float:\n    \"\"\"Computes the angle (argument) of a complex number using atan2.\"\"\"\n    return float(math.atan2(z.imag, z.real))\n\ndef angle_complex(arg1, arg2) -> float:\n    \"\"\"\n    Calculates the angle (argument) of the complex sum of two numbers.\n    The sum is computed as z = complex(arg1) + complex(arg2).\n    \"\"\"\n    _validate_types_internal(arg1, arg2)\n\n    c1 = _to_complex_internal(arg1).to_complex()\n    c2 = _to_complex_internal(arg2).to_complex()\n    \n    z = c1 + c2\n    \n    _validate_nonzero_internal(z)\n    \n    return _compute_angle_internal(z)"}
{"task_id": "Mbpp/130", "solution": "from collections import defaultdict\n\ndef _validate_input(list_input: list) -> None:\n    \"\"\"Validates the input list, ensuring it's a non-empty list of integers.\"\"\"\n    if not isinstance(list_input, list):\n        raise TypeError(\"Input must be a list.\")\n    if not list_input:\n        raise ValueError(\"Input list cannot be empty.\")\n    for item in list_input:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef _compute_frequency(list_input: list) -> dict:\n    \"\"\"Computes the frequency of each item in the list.\"\"\"\n    freq_map = defaultdict(int)\n    for item in list_input:\n        freq_map[item] += 1\n    return dict(freq_map)\n\ndef _get_most_frequent(freq_map: dict, list_input: list) -> int:\n    \"\"\"Finds the item with the maximum frequency, breaking ties by first appearance.\"\"\"\n    max_freq = max(freq_map.values())\n    max_freq_items = {item for item, freq in freq_map.items() if freq == max_freq}\n\n    for item in list_input:\n        if item in max_freq_items:\n            return item\n    # This point should theoretically not be reached if freq_map and list_input are consistent and non-empty.\n\ndef max_occurrences(list_input: list) -> int:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Handles input validation, frequency computation, and tie-breaking.\n    \"\"\"\n    _validate_input(list_input)\n    freq_map = _compute_frequency(list_input)\n    return _get_most_frequent(freq_map, list_input)"}
{"task_id": "Mbpp/128", "solution": "from typing import List\n\nclass Parser:\n    \"\"\"Parses input, converting strings to lists of tokens or shallow copying lists.\"\"\"\n    def parse(self, input_data):\n        if isinstance(input_data, str):\n            return input_data.split()\n        elif isinstance(input_data, list):\n            return list(input_data)\n        # Design implies valid input types are always provided.\n\nclass Word:\n    \"\"\"Represents a single word token and provides its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\nclass WordList:\n    \"\"\"Manages an ordered collection of Word instances and filters them by length.\"\"\"\n    def __init__(self, words: List[Word]):\n        self.words = words\n\n    def filter_longer(self, n: int) -> List[str]:\n        return [w.text for w in self.words if w.length() > n]\n\nclass Output:\n    \"\"\"Encapsulates the final list of strings to be returned.\"\"\"\n    def __init__(self, words: List[str]):\n        self.words = words\n\n    def as_list(self) -> List[str]:\n        return self.words\n\ndef long_words(n, words):\n    \"\"\"\n    Finds words longer than n characters from a given list of words or a space-separated string.\n    The input 'words' can be either a string or a list of strings.\n    \"\"\"\n    parser = Parser()\n    tokens = parser.parse(words)\n\n    word_objs = [Word(t) for t in tokens]\n\n    word_list_manager = WordList(word_objs)\n    filtered_strings = word_list_manager.filter_longer(n)\n\n    output_handler = Output(filtered_strings)\n    return output_handler.as_list()"}
{"task_id": "Mbpp/129", "solution": "import math\n\nclass ValidationResult:\n    \"\"\"Holds the result of a validation check.\"\"\"\n    def __init__(self, is_valid: bool, reason: str = \"\") -> None:\n        self.is_valid = is_valid\n        self.reason = reason\n\nclass Matrix:\n    \"\"\"\n    A wrapper class for a 2D matrix, providing read-only accessors for rows, columns, and diagonals.\n    \"\"\"\n    def __init__(self, rows: list[list[float | int]]) -> None:\n        self.rows = rows\n        self.n = len(rows)\n\n    def get_row(self, i: int) -> list[float | int]:\n        \"\"\"Returns the list of elements for the specified row.\"\"\"\n        return self.rows[i]\n\n    def get_col(self, j: int) -> list[float | int]:\n        \"\"\"Returns the list of elements for the specified column.\"\"\"\n        return [self.rows[i][j] for i in range(self.n)]\n\n    def get_main_diagonal(self) -> list[float | int]:\n        \"\"\"Returns the list of elements for the main diagonal.\"\"\"\n        return [self.rows[i][i] for i in range(self.n)]\n\n    def get_secondary_diagonal(self) -> list[float | int]:\n        \"\"\"Returns the list of elements for the secondary diagonal.\"\"\"\n        return [self.rows[i][self.n - 1 - i] for i in range(self.n)]\n\nclass MagicSquareTest:\n    \"\"\"\n    Encapsulates the logic for validating and checking a matrix for magic square properties.\n    \"\"\"\n    def validate_square(self, matrix_data: list[list[float | int]]) -> ValidationResult:\n        \"\"\"\n        Validates if the input is a non-empty square matrix with numeric elements.\n        Returns a ValidationResult indicating validity.\n        \"\"\"\n        if not matrix_data:\n            return ValidationResult(False, \"Matrix is empty.\")\n        \n        n = len(matrix_data)\n        \n        for row in matrix_data:\n            if not isinstance(row, list) or len(row) != n:\n                return ValidationResult(False, \"Matrix is not square or contains non-list rows.\")\n            for item in row:\n                if not isinstance(item, (int, float)):\n                    return ValidationResult(False, \"Matrix contains non-numeric elements.\")\n        \n        return ValidationResult(True)\n\n    def sum_list_elements(self, elements: list[float | int]) -> float:\n        \"\"\"Helper to sum numeric elements in a list.\"\"\"\n        return sum(elements)\n\n    def compute_target_sum(self, matrix_obj: Matrix) -> float:\n        \"\"\"Computes the target sum from the first row of the Matrix object.\"\"\"\n        return self.sum_list_elements(matrix_obj.get_row(0))\n\n    def sum_row(self, matrix_obj: Matrix, i: int) -> float:\n        \"\"\"Sums the elements of a given row in the matrix.\"\"\"\n        return self.sum_list_elements(matrix_obj.get_row(i))\n\n    def sum_col(self, matrix_obj: Matrix, j: int) -> float:\n        \"\"\"Sums the elements of a given column in the matrix.\"\"\"\n        return self.sum_list_elements(matrix_obj.get_col(j))\n\n    def sum_main_diagonal(self, matrix_obj: Matrix) -> float:\n        \"\"\"Sums the elements of the main diagonal in the matrix.\"\"\"\n        return self.sum_list_elements(matrix_obj.get_main_diagonal())\n\n    def sum_secondary_diagonal(self, matrix_obj: Matrix) -> float:\n        \"\"\"Sums the elements of the secondary diagonal in the matrix.\"\"\"\n        return self.sum_list_elements(matrix_obj.get_secondary_diagonal())\n\n    def magic_square_test(self, matrix_data: list[list[float | int]]) -> bool:\n        \"\"\"\n        Orchestrates the magic square test.\n        Validates input, computes the target sum, and checks all row, column, and diagonal sums.\n        \"\"\"\n        validation_result = self.validate_square(matrix_data)\n        if not validation_result.is_valid:\n            return False\n\n        matrix_obj = Matrix(matrix_data)\n        n = matrix_obj.n\n\n        target_sum = self.compute_target_sum(matrix_obj)\n\n        # Check all rows\n        for i in range(n):\n            if not math.isclose(self.sum_row(matrix_obj, i), target_sum):\n                return False\n\n        # Check all columns\n        for j in range(n):\n            if not math.isclose(self.sum_col(matrix_obj, j), target_sum):\n                return False\n\n        # Check main diagonal\n        if not math.isclose(self.sum_main_diagonal(matrix_obj), target_sum):\n            return False\n\n        # Check secondary diagonal\n        if not math.isclose(self.sum_secondary_diagonal(matrix_obj), target_sum):\n            return False\n\n        return True\n\ndef magic_square_test(matrix: list[list[float | int]]) -> bool:\n    \"\"\"\n    Calculates whether the matrix is a magic square.\n    Delegates the core logic to an internal MagicSquareTest instance.\n    \"\"\"\n    tester = MagicSquareTest()\n    return tester.magic_square_test(matrix)"}
{"task_id": "Mbpp/131", "solution": "from typing import List\n\ndef is_vowel(ch: str) -> bool:\n    \"\"\"Return True if ch is in {a,e,i,o,u} or uppercase equivalents.\"\"\"\n    return ch in \"aeiouAEIOU\"\n\ndef _extract_vowels(s: str) -> List[str]:\n    \"\"\"Return list of vowel characters from s in left-to-right order.\"\"\"\n    vowels = []\n    for char in s:\n        if is_vowel(char):\n            vowels.append(char)\n    return vowels\n\ndef _reconstruct_with_reversed_vowels(s: str, reversed_vowels: List[str]) -> str:\n    \"\"\"Return reconstructed string with reversed_vowels inserted at vowel positions.\"\"\"\n    result_chars = []\n    vowel_idx = 0\n    for char in s:\n        if is_vowel(char):\n            result_chars.append(reversed_vowels[vowel_idx])\n            vowel_idx += 1\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef reverse_vowels(input: str) -> str:\n    \"\"\"Public API: returns the input string with vowels reversed per design.\"\"\"\n    if not input:\n        return \"\"\n\n    vowels = _extract_vowels(input)\n\n    if len(vowels) <= 1:\n        return input\n\n    reversed_vowels = list(reversed(vowels))\n    return _reconstruct_with_reversed_vowels(input, reversed_vowels)"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"Compute the nth hexagonal number H(n) = n * (2*n - 1).\n\n    Raises: ValueError if n is not an integer or n < 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/133", "solution": "from typing import List\n\ndef sum_negativenum(numbers: List[float]) -> float:\n    \"\"\"Compute the sum of strictly negative numbers in the provided list.\n\n    Return 0.0 when there are no negative numbers or the list is empty.\n    \"\"\"\n    total_sum = 0.0\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/132", "solution": "def tup_string(tuple_input: tuple) -> str:\n    \"\"\"Converts a tuple of single-character strings into a single concatenated string.\n    Raises TypeError for non-tuple input and ValueError for invalid element types or lengths.\"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if not tuple_input:\n        return \"\"\n\n    result_list = []\n    for element in tuple_input:\n        if not isinstance(element, str):\n            raise ValueError(\"All tuple elements must be strings.\")\n        if len(element) != 1:\n            raise ValueError(\"All tuple elements must be single-character strings.\")\n        result_list.append(element)\n\n    return \"\".join(result_list)"}
{"task_id": "Mbpp/137", "solution": "from typing import List\n\nclass UndefinedRatioError(ValueError):\n    \"\"\"Exception raised when the ratio of zeros to non-zeros is undefined (no non-zero elements).\"\"\"\n    pass\n\nclass IntegerArray:\n    \"\"\"Holds a list of integers and provides methods to count zeros and non-zeros.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        if not isinstance(elements, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in elements:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n        self.elements = elements\n\n    def count_zeros(self) -> int:\n        \"\"\"Counts the number of zero elements in the array.\"\"\"\n        return self.elements.count(0)\n\n    def count_nonzeros(self) -> int:\n        \"\"\"Counts the number of non-zero elements in the array.\"\"\"\n        return len(self.elements) - self.count_zeros()\n\nclass ZeroCountResult:\n    \"\"\"Holds the computed ratio and provides it as a float.\"\"\"\n    def __init__(self, ratio: float) -> None:\n        self.ratio = ratio\n\n    def as_float(self) -> float:\n        \"\"\"Returns the stored ratio as a float.\"\"\"\n        return self.ratio\n\ndef zero_count(arr: List[int]) -> float:\n    \"\"\"\n    Computes the ratio of zeroes to non-zeroes in an array of integers.\n    Raises TypeError for invalid input or UndefinedRatioError if no non-zero elements.\n    \"\"\"\n    integer_array = IntegerArray(arr)\n    zeroes = integer_array.count_zeros()\n    non_zeroes = integer_array.count_nonzeros()\n\n    if non_zeroes == 0:\n        raise UndefinedRatioError(\"Ratio is undefined: no non-zero elements present.\")\n\n    ratio = float(zeroes) / non_zeroes\n    result = ZeroCountResult(ratio)\n    return result.as_float()"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if a number can be represented as a sum of non-zero powers of 2 (2^k, k>0).\n    Multiplicity of terms is permitted.\n    \"\"\"\n    if n < 2:\n        # Numbers less than 2 cannot be formed by summing powers of 2 where k > 0.\n        return False\n\n    def _generate_powers(limit: int) -> list[int]:\n        \"\"\"Generates a list of powers of two (2^k, k>0) up to the given limit.\"\"\"\n        powers_list = []\n        power_of_2 = 2  # Start with 2^1\n        while power_of_2 <= limit:\n            powers_list.append(power_of_2)\n            power_of_2 *= 2\n        return powers_list\n\n    def _can_represent(target: int, available_powers: list[int]) -> bool:\n        \"\"\"\n        Uses a greedy approach to determine if the target can be formed\n        by summing the available powers (multiplicity allowed).\n        \"\"\"\n        remaining_target = target\n        # Iterate powers in descending order to apply the greedy strategy\n        for p in reversed(available_powers):\n            if remaining_target >= p:\n                # Subtract p as many times as possible\n                remaining_target -= (remaining_target // p) * p\n            if remaining_target == 0:\n                break  # Target fully decomposed\n        return remaining_target == 0\n\n    # Generate all relevant powers of two (2^k, k>0)\n    powers = _generate_powers(n)\n\n    # Check if 'n' can be represented as a sum of these powers\n    return _can_represent(n, powers)"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius):\n    \"\"\"Calculates the circumference of a circle given its radius.\"\"\"\n    return 2 * math.pi * radius"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(iterable):\n    \"\"\"Accepts an iterable whose elements are iterables of numbers and returns a set of unique numbers.\n\n    The function iterates through inner iterables and adds all numeric elements to a set to ensure uniqueness.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in iterable:\n        for number in inner_iterable:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"Count positions i (0..min_len-1) where list1[i] == list2[i] == list3[i]. Returns integer count.\n\n    This implementation iterates up to min(len(list1), len(list2), len(list3)).\"\"\"\n    min_len = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def _validate_input_list(arg):\n    \"\"\"Raise TypeError if arg is not list-like.\"\"\"\n    if not isinstance(arg, list):\n        raise TypeError(\"pancake_sort expects a list-like argument\")\n\ndef _elements_mutually_comparable(lst):\n    \"\"\"Raise TypeError if any pair of elements in lst cannot be compared by Python natural ordering.\"\"\"\n    # An empty list or a list with one element always has mutually comparable elements.\n    if len(lst) <= 1:\n        return\n\n    try:\n        # Attempt to sort a copy to check for comparability.\n        # This will raise TypeError if elements are not mutually comparable.\n        sorted(list(lst))\n    except TypeError:\n        raise TypeError(\"elements are not mutually comparable\")\n\ndef _sort_process(lst):\n    \"\"\"Return a new list containing the elements of lst sorted in ascending (non-decreasing) order.\"\"\"\n    return sorted(lst)\n\ndef pancake_sort(input_list):\n    \"\"\"Public API: validate input, validate comparability, perform sort, and return a sorted list.\"\"\"\n    _validate_input_list(input_list)\n    _elements_mutually_comparable(input_list)\n    return _sort_process(input_list)"}
{"task_id": "Mbpp/161", "solution": "from typing import Any\n\ndef remove_elements(source_list: list, elements_to_remove: list) -> list:\n    \"\"\"Returns a new list with elements from source_list not present in elements_to_remove.\n    Preserves original order and does not mutate the input list.\n    \"\"\"\n    elements_to_remove_set = set(elements_to_remove)\n    result_list = []\n    for item in source_list:\n        if item not in elements_to_remove_set:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/160", "solution": "def _is_int_like(value) -> bool:\n    \"\"\"Helper to determine if a value is a Python int instance.\"\"\"\n    return isinstance(value, int)\n\nclass Validator:\n    \"\"\"\n    Validates that inputs a, b, n are integers.\n    \"\"\"\n    def validate_integers(self, a, b, n) -> bool:\n        \"\"\"\n        Returns True only when a, b, n are int instances.\n        \"\"\"\n        return _is_int_like(a) and _is_int_like(b) and _is_int_like(n)\n\ndef _extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Returns (g, x, y) such that a*x + b*y = g = gcd(a, b).\n    \"\"\"\n    if b == 0:\n        return (a, 1, 0)\n    g, x_prev, y_prev = _extended_gcd(b, a % b)\n    x = y_prev\n    y = x_prev - (a // b) * y_prev\n    return (g, x, y)\n\nclass Solver:\n    \"\"\"\n    Determines solvability and computes a deterministic canonical integer solution.\n    \"\"\"\n    def has_solution(self, a: int, b: int, n: int) -> bool:\n        \"\"\"\n        True iff gcd(a, b) divides n.\n        Handles the special case where a=0 and b=0.\n        \"\"\"\n        if a == 0 and b == 0:\n            return n == 0\n        g, _, _ = _extended_gcd(a, b)\n        return n % g == 0\n\n    def compute_solution(self, a: int, b: int, n: int) -> tuple[int, int] | None:\n        \"\"\"\n        Computes a deterministic canonical integer solution (x, y) for ax + by = n.\n        Returns None if no solution exists.\n        \"\"\"\n        if a == 0 and b == 0:\n            return (0, 0) if n == 0 else None\n\n        g, s, t = _extended_gcd(a, b)\n\n        if n % g != 0:\n            return None\n\n        # Base solution: a*s + b*t = g => a*(s*n/g) + b*(t*n/g) = n\n        x0 = s * (n // g)\n        y0 = t * (n // g)\n\n        # Normalize deterministically\n        if b == 0:\n            # If b=0, then a*x = n. Since g=abs(a), n must be divisible by a.\n            # x = n/a, y can be any integer. Choose y=0 for canonical form.\n            return (n // a, 0)\n        \n        # For b != 0, normalize x into a canonical range.\n        # The general solution is x = x0 + k * (b/g), y = y0 - k * (a/g)\n        # We want x in the range [0, abs(b/g) - 1].\n        \n        # Let m be abs(b // g).\n        # x_norm = x0 % m ensures x is in [0, m-1] if m > 0.\n        m = abs(b // g)\n        x_canonical = x0 % m\n\n        # Find k such that x_canonical = x0 + k * (b // g)\n        # k = (x_canonical - x0) / (b // g)\n        k = (x_canonical - x0) // (b // g)\n\n        # Compute the corresponding y\n        y_canonical = y0 - (a // g) * k\n\n        return (x_canonical, y_canonical)\n\ndef find_solution(a, b, n) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_integers(a, b, n):\n        raise TypeError(\"a, b, n must be integers\")\n\n    solver = Solver()\n    return solver.compute_solution(a, b, n)"}
{"task_id": "Mbpp/145", "solution": "from typing import Iterable, Tuple, Union\n\ndef _validate_and_find_min_max(iterable: Iterable[object]) -> Tuple[Union[int, float], Union[int, float]]:\n    \"\"\"Iterate once, validate numeric types, compute and return (min_value, max_value);\n    raise TypeError or ValueError on invalid input.\"\"\"\n    min_val: Union[int, float, None] = None\n    max_val: Union[int, float, None] = None\n    numeric_count = 0\n\n    for item in iterable:\n        if not isinstance(item, (int, float)):\n            raise TypeError(f\"non-numeric element encountered: '{item}'\")\n\n        if numeric_count == 0:\n            min_val = item\n            max_val = item\n        else:\n            if item < min_val: # type: ignore\n                min_val = item\n            if item > max_val: # type: ignore\n                max_val = item\n        numeric_count += 1\n\n    if numeric_count < 2:\n        raise ValueError(\"input must contain at least two numeric elements\")\n\n    return min_val, max_val # type: ignore\n\ndef max_Abs_Diff(iterable: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Validate input and return the maximum absolute difference between any two elements.\"\"\"\n    min_value, max_value = _validate_and_find_min_max(iterable)\n    return abs(max_value - min_value)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    For example, for n=6, the series is 6 + 4 + 2 + 0.\n    \"\"\"\n    total = 0\n    # The series terms are (n - 2*i) where i goes from 0 up to n // 2 (inclusive).\n    for i in range(n // 2 + 1):\n        total += (n - 2 * i)\n    return total"}
{"task_id": "Mbpp/165", "solution": "from typing import Iterable\n\nclass AlphabetService:\n    \"\"\"Provides 1-based alphabetical positions for characters.\"\"\"\n    _positions = {chr(ord('a') + i): i + 1 for i in range(26)}\n\n    def getPosition(self, c: str) -> int:\n        \"\"\"Returns the 1-based alphabet position for a character (a=1, z=26), or 0 if not an alphabet character.\"\"\"\n        return self._positions.get(c.lower(), 0)\n\nclass Character:\n    \"\"\"Represents a character with its value and 1-based index.\"\"\"\n    _alphabet_service = AlphabetService()\n\n    def __init__(self, value: str, index: int):\n        self.value = value\n        self.index = index\n\n    def isAlphabet(self) -> bool:\n        \"\"\"Checks if the character is an English alphabet letter.\"\"\"\n        return self._alphabet_service.getPosition(self.value) != 0\n\n    def alphabetPosition(self) -> int:\n        \"\"\"Returns the 1-based alphabet position of the character.\"\"\"\n        return self._alphabet_service.getPosition(self.value)\n\nclass StringInput:\n    \"\"\"Encapsulates an input string and provides character iteration with 1-based indexing.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the string is empty.\"\"\"\n        return self.length() == 0\n\n    def characters(self) -> Iterable[Character]:\n        \"\"\"Yields Character instances with 1-based indices from the string.\"\"\"\n        for i, char_value in enumerate(self.value):\n            yield Character(char_value, i + 1)\n\nclass PositionComparator:\n    \"\"\"Compares a character's alphabet position with its string index.\"\"\"\n    def __init__(self, alphabet_service: AlphabetService):\n        self._alphabet_service = alphabet_service\n\n    def matches(self, ch: Character) -> bool:\n        \"\"\"Checks if the character's 1-based alphabet position matches its 1-based string index.\"\"\"\n        if not ch.isAlphabet():\n            return False\n        return ch.alphabetPosition() == ch.index\n\nclass Counter:\n    \"\"\"Counts matching characters in a StringInput using a PositionComparator.\"\"\"\n    def __init__(self, comparator: PositionComparator):\n        self._comparator = comparator\n\n    def countMatches(self, input_str: StringInput) -> int:\n        \"\"\"Counts characters in the input string that match the comparator's criteria.\"\"\"\n        if input_str.isEmpty():\n            return 0\n\n        match_count = 0\n        for char_obj in input_str.characters():\n            if self._comparator.matches(char_obj):\n                match_count += 1\n        return match_count\n\ndef count_char_position(s: str) -> int:\n    \"\"\"Counts characters in a string whose 1-based alphabet position matches their 1-based string index.\"\"\"\n    string_input = StringInput(s)\n\n    if string_input.isEmpty():\n        return 0\n\n    alphabet_service = AlphabetService()\n    comparator = PositionComparator(alphabet_service)\n    counter = Counter(comparator)\n\n    return counter.countMatches(string_input)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef countSameParityPairs(evens: int, odds: int) -> int:\n    \"\"\"Calculates the number of pairs that can be formed from 'evens' even numbers and 'odds' odd numbers.\"\"\"\n    return evens * (evens - 1) // 2 + odds * (odds - 1) // 2\n\ndef find_even_pair(nums: List[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR is an even number.\n    A pair's XOR is even if and only if both integers have the same parity.\n    \"\"\"\n    if len(nums) < 2:\n        return 0\n\n    evens_count = 0\n    odds_count = 0\n\n    for num in nums:\n        if num % 2 == 0:\n            evens_count += 1\n        else:\n            odds_count += 1\n\n    return countSameParityPairs(evens_count, odds_count)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Finds the smallest power of 2 greater than or equal to n.\"\"\"\n    if n == 0:\n        return 1\n    # For n > 0, calculate 2 raised to the number of bits required to represent n-1.\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/168", "solution": "def frequency(list, value) -> int:\n    \"\"\"Count occurrences of value in list using value equality (==).\n    Returns: int (count of elements equal to value).\n    \"\"\"\n    count = 0\n    for element in list:\n        if element == value:\n            count += 1\n    return count"}
{"task_id": "Mbpp/170", "solution": "def _validate_indices(list_length, start_index, end_index):\n    \"\"\"Validate indices per SRS rules: zero-based, within bounds, start_index <= end_index. Raises IndexError on invalid inputs.\"\"\"\n    if not (0 <= start_index < list_length and 0 <= end_index < list_length):\n        raise IndexError(\"Indices are out of bounds for the list.\")\n    if start_index > end_index:\n        raise IndexError(\"start_index cannot be greater than end_index.\")\n\ndef sum_range_list(list_of_numbers, start_index, end_index):\n    \"\"\"Compute and return the arithmetic sum of list_of_numbers[start_index..end_index] (inclusive).\"\"\"\n    _validate_indices(len(list_of_numbers), start_index, end_index)\n    return sum(list_of_numbers[start_index : end_index + 1])"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length):\n    \"\"\"Calculates the perimeter of a regular pentagon.\n    It multiplies the side length by 5.\"\"\"\n    return 5 * side_length"}
{"task_id": "Mbpp/172", "solution": "SUBSTRING_LITERAL = \"std\"\n\ndef count_occurance(input_string: str) -> int:\n    \"\"\"\n    Counts non-overlapping, case-sensitive occurrences of 'std' in a string.\n    Raises TypeError if input is not a string as per BR-7.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    count = 0\n    n = len(input_string)\n    m = len(SUBSTRING_LITERAL)\n    i = 0\n\n    while i <= n - m:\n        if input_string[i:i+m] == SUBSTRING_LITERAL:\n            count += 1\n            i += m  # Advance by length of SUBSTRING_LITERAL for non-overlapping matches\n        else:\n            i += 1  # Advance by 1 character\n\n    return count"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n    The input `n` is assumed to be an integer.\"\"\"\n    return bin(n).count('1')"}
{"task_id": "Mbpp/222", "solution": "def check_type(tuple_input) -> bool:\n    \"\"\"Return True if all elements of tuple_input have the same runtime type; raise TypeError if input is not a tuple.\"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(tuple_input) <= 1:\n        return True\n\n    first_type = type(tuple_input[0])\n    for element in tuple_input[1:]:\n        if type(element) != first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(input: str) -> str:\n    \"\"\"Return a new string composed of characters from `input` at even indices (0,2,4,...).\"\"\"\n    result_chars = []\n    for i, char in enumerate(input):\n        if i % 2 == 0:\n            result_chars.append(char)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/227", "solution": "def min_of_three(a: float, b: float, c: float) -> float:\n    \"\"\"Return the smallest of a, b, and c.\n    Preconditions: a, b, c are numeric (int/float). Deterministic, side-effect-free.\n    Time complexity: O(1) \u2014 fixed number of comparisons.\n    \"\"\"\n    smallest = a\n    if b < smallest:\n        smallest = b\n    if c < smallest:\n        smallest = c\n    return smallest"}
{"task_id": "Mbpp/223", "solution": "class ArrayModel:\n    \"\"\"A lightweight wrapper for the input array providing read-only indexed access.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def get(self, index: int):\n        \"\"\"Returns the element at the given index.\"\"\"\n        return self.elements[index]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the total length of the wrapped array.\"\"\"\n        return len(self.elements)\n\nclass Validator:\n    \"\"\"Stateless validation of inputs for the majority element check.\"\"\"\n    def validate(self, array: list, n: int, element) -> bool:\n        \"\"\"Returns True if inputs are valid, False otherwise.\"\"\"\n        if array is None:\n            return False\n        \n        if not isinstance(n, int):\n            return False\n            \n        if n <= 0:\n            return False\n            \n        try:\n            array_len = len(array)\n        except TypeError: # If array is not a Sized object\n            return False\n\n        if n > array_len:\n            return False\n            \n        return True\n\nclass Result:\n    \"\"\"A small data container for the outcome of a majority check.\"\"\"\n    def __init__(self, is_majority: bool, count: int, n: int) -> None:\n        self.is_majority = is_majority\n        self.count = count\n        self.n = n\n\nclass MajorityChecker:\n    \"\"\"Encapsulates the core logic for finding majority elements using binary search.\"\"\"\n    def is_majority(self, array: 'ArrayModel', n: int, element) -> 'Result':\n        \"\"\"Determines if the element is a majority element.\"\"\"\n        first_occurrence = self.find_first_occurrence(array, n, element)\n        \n        if first_occurrence == -1:\n            return Result(False, 0, n)\n            \n        last_occurrence = self.find_last_occurrence(array, n, element)\n        \n        count = last_occurrence - first_occurrence + 1\n        is_maj = count > (n / 2)\n        \n        return Result(is_maj, count, n)\n\n    def find_first_occurrence(self, array: 'ArrayModel', n: int, element) -> int:\n        \"\"\"Performs binary search to find the leftmost index of an element.\"\"\"\n        low = 0\n        high = n - 1\n        result = -1\n        \n        while low <= high:\n            mid = low + (high - low) // 2\n            mid_val = array.get(mid)\n            \n            if mid_val == element:\n                result = mid\n                high = mid - 1 # Try to find an earlier occurrence\n            elif mid_val < element:\n                low = mid + 1\n            else: # mid_val > element\n                high = mid - 1\n        return result\n\n    def find_last_occurrence(self, array: 'ArrayModel', n: int, element) -> int:\n        \"\"\"Performs binary search to find the rightmost index of an element.\"\"\"\n        low = 0\n        high = n - 1\n        result = -1\n        \n        while low <= high:\n            mid = low + (high - low) // 2\n            mid_val = array.get(mid)\n            \n            if mid_val == element:\n                result = mid\n                low = mid + 1 # Try to find a later occurrence\n            elif mid_val < element:\n                low = mid + 1\n            else: # mid_val > element\n                high = mid - 1\n        return result\n\ndef is_majority(array, n, element) -> bool:\n    \"\"\"Checks if an element is the majority element in the first 'n' entries of a sorted array.\"\"\"\n    validator = Validator()\n    if not validator.validate(array, n, element):\n        return False\n\n    array_model = ArrayModel(array)\n    majority_checker = MajorityChecker()\n    result = majority_checker.is_majority(array_model, n, element)\n\n    return result.is_majority"}
{"task_id": "Mbpp/230", "solution": "class InputString:\n    \"\"\"Holds the input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass ReplacementCharacter:\n    \"\"\"Holds the replacement character value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass ReplaceBlankFunction:\n    \"\"\"Performs the replacement transformation.\"\"\"\n    def __init__(self, input_string: InputString, replacement_char: ReplacementCharacter) -> None:\n        self.input_string = input_string\n        self.replacement_char = replacement_char\n\n    def execute(self) -> str:\n        \"\"\"Replaces blank spaces in the input string with the replacement character.\"\"\"\n        return self.input_string.value.replace(' ', self.replacement_char.value)\n\ndef replace_blank(input_string: str, replacement_char: str) -> str:\n    \"\"\"Public API per SRS: replaces ASCII blank spaces ' ' with replacement_char and returns the resulting string.\"\"\"\n    input_obj = InputString(value=input_string)\n    char_obj = ReplacementCharacter(value=replacement_char)\n    transformer = ReplaceBlankFunction(input_obj, char_obj)\n    return transformer.execute()"}
{"task_id": "Mbpp/232", "solution": "from typing import List, Any, Optional\n\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass ValidationResult:\n    def __init__(self, is_valid: bool, error_message: Optional[str] = None):\n        self.is_valid = is_valid\n        self.error_message = error_message\n\ndef validateParameters(input_list: Any, n: Any) -> ValidationResult:\n    \"\"\"\n    Validate types and comparability of input_list and n.\n    Returns ValidationResult indicating success or failure with an error message.\n    \"\"\"\n    if not isinstance(input_list, list):\n        return ValidationResult(is_valid=False, error_message=\"Input 'input_list' must be a list.\")\n    if not isinstance(n, int):\n        return ValidationResult(is_valid=False, error_message=\"Input 'n' must be an integer.\")\n\n    if len(input_list) > 1:\n        # Check comparability by attempting to compare the first two elements.\n        # This acts as a representative comparison as per design.\n        try:\n            _ = input_list[0] > input_list[1]\n        except TypeError:\n            return ValidationResult(is_valid=False, error_message=\"Items in 'input_list' must be comparable.\")\n    elif len(input_list) == 1:\n        # Ensure the single element is self-comparable (implicitly handles basic types).\n        try:\n            _ = input_list[0] > input_list[0]\n        except TypeError:\n            return ValidationResult(is_valid=False, error_message=\"Item in 'input_list' is not comparable.\")\n\n    return ValidationResult(is_valid=True)\n\ndef selectTopN(input_list: List[Any], n: int) -> List[Any]:\n    \"\"\"\n    Returns a list of the n largest items from input_list, preserving multiplicity.\n    Assumes inputs are already validated for type and comparability.\n    \"\"\"\n    if n <= 0:\n        return []\n    if n >= len(input_list):\n        return list(input_list) # Return a copy of the original list\n\n    # Sort the list in descending order and take the first n elements.\n    sorted_list = sorted(input_list, reverse=True)\n    return sorted_list[:n]\n\ndef larg_nnum(input_list: List[Any], n: int) -> List[Any]:\n    \"\"\"\n    Returns a list containing the n largest items from the list.\n    Raises ValidationError for invalid input types or non-comparable items.\n    \"\"\"\n    vr = validateParameters(input_list, n)\n    if not vr.is_valid:\n        raise ValidationError(vr.error_message)\n\n    return selectTopN(input_list, n)"}
{"task_id": "Mbpp/234", "solution": "class Cube:\n    \"\"\"Represents a cube and computes its volume.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self.side_length = side_length\n\n    def get_volume(self) -> float:\n        \"\"\"Calculates and returns the volume of the cube.\"\"\"\n        return self.side_length ** 3\n\nclass VolumeCalculator:\n    \"\"\"Provides static methods for volume calculations.\"\"\"\n    @staticmethod\n    def volume_cube(side_length: float) -> float:\n        \"\"\"Calculates the volume of a cube by delegating to a Cube object.\"\"\"\n        cube = Cube(side_length)\n        return cube.get_volume()\n\ndef volume_cube(side_length: float) -> float:\n    \"\"\"\n    Calculates the volume of a cube given its side length.\n    This module-level function delegates the computation to VolumeCalculator.\n    \"\"\"\n    return VolumeCalculator.volume_cube(side_length)"}
{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(radius, height):\n    \"\"\"\n    Calculates the lateral surface area of a cylinder given its radius and height.\n    Validates input types and domain constraints before calculation.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n        raise TypeError(\"radius and height must be int or float\")\n    if radius < 0 or height < 0:\n        raise ValueError(\"radius and height must be non-negative\")\n\n    lateral_surface_area = 2 * math.pi * radius * height\n    return float(lateral_surface_area)"}
{"task_id": "Mbpp/235", "solution": "class BitMask:\n    \"\"\"Helper to generate a mask with 1-based even bit positions set to 1.\"\"\"\n    def __init__(self, max_bits: int = 64):\n        self._max_bits = max_bits\n        self.mask = 0\n\n    def generate_even_bit_mask(self) -> int:\n        \"\"\"Generates an integer mask with 1-based even bit positions set.\"\"\"\n        mask_val = 0\n        # Iterate through 0-based indices. 1-based even positions (2, 4, 6, ...)\n        # correspond to 0-based odd indices (1, 3, 5, ...).\n        for i in range(self._max_bits):\n            if (i % 2) != 0:\n                mask_val |= (1 << i)\n        self.mask = mask_val\n        return mask_val\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Sets all 1-based even bits of a given number to 1 while preserving odd bits.\"\"\"\n    # Determine the maximum number of bits for the mask, ensuring it covers\n    # the input number's length and at least up to position 64.\n    max_bits = max(n.bit_length() + 1, 64)\n\n    # Create BitMask and generate the mask with 1-based even positions set.\n    even_mask_generator = BitMask(max_bits)\n    mask = even_mask_generator.generate_even_bit_mask()\n\n    # Compute the result by OR-ing the input number with the generated mask.\n    return n | mask"}
{"task_id": "Mbpp/237", "solution": "from typing import Any\n\nclass TupleItem:\n    \"\"\"Represents a single input 2-element tuple as a domain object.\"\"\"\n    def __init__(self, a: Any, b: Any) -> None:\n        self.a = a\n        self.b = b\n\nclass CanonicalTuple:\n    \"\"\"Represents the canonical (sorted ascending) form of a 2-element tuple.\"\"\"\n    def __init__(self, first: Any, second: Any) -> None:\n        self.first = first\n        self.second = second\n\n    @staticmethod\n    def normalize(tuple_item: TupleItem) -> 'CanonicalTuple':\n        \"\"\"Returns a CanonicalTuple by sorting tuple_item.a and tuple_item.b.\"\"\"\n        if tuple_item.a <= tuple_item.b:\n            return CanonicalTuple(tuple_item.a, tuple_item.b)\n        else:\n            return CanonicalTuple(tuple_item.b, tuple_item.a)\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns a Python tuple (first, second) for use as a dict key.\"\"\"\n        return (self.first, self.second)\n\nclass OccurrenceMap:\n    \"\"\"Maintains a mapping from canonical tuple keys to integer counts.\"\"\"\n    def __init__(self) -> None:\n        self.map: dict[tuple, int] = {}\n\n    def increment(self, key: tuple) -> None:\n        \"\"\"Increments the count for the given canonical tuple key.\"\"\"\n        self.map[key] = self.map.get(key, 0) + 1\n\n    def get_map(self) -> dict:\n        \"\"\"Returns the underlying dictionary of canonical tuples to counts.\"\"\"\n        return self.map\n\ndef check_occurences(input_list) -> dict:\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique\n    canonical tuple to its occurrence count.\n    \"\"\"\n    occurrence_map = OccurrenceMap()\n\n    for item in input_list:\n        # Assuming input is a list of 2-element tuples as per design context\n        # and \"Do NOT add isinstance() checks or raise exceptions\" constraint.\n        tuple_item = TupleItem(item[0], item[1])\n        canonical_tuple = CanonicalTuple.normalize(tuple_item)\n        occurrence_map.increment(canonical_tuple.as_tuple())\n\n    return occurrence_map.get_map()"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings of a given string using the formula n*(n+1)//2.\n    Returns 0 for an empty string.\n    \"\"\"\n    def _compute_length(s: str) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(s)\n\n    def _apply_formula(n: int) -> int:\n        \"\"\"Applies the mathematical formula n*(n+1)//2 to compute substring count.\"\"\"\n        return n * (n + 1) // 2\n\n    n = _compute_length(s)\n    return _apply_formula(n)"}
