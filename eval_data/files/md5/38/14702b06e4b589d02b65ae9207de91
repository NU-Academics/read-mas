{"task_id": "Mbpp/410", "solution": "def min_val(values: list) -> float:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Raises ValueError if no numeric elements are found.\n    \"\"\"\n    def is_numeric(value):\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def filter_numeric(input_list: list) -> list:\n        \"\"\"Filters a list to include only numeric (int or float) values.\"\"\"\n        numeric_values = []\n        for val in input_list:\n            if is_numeric(val):\n                numeric_values.append(val)\n        return numeric_values\n\n    numeric_elements = filter_numeric(values)\n\n    if not numeric_elements:\n        raise ValueError(\"No numeric elements found in the list.\")\n\n    return min(numeric_elements)"}
{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple, Union\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for validation errors in input data.\n    \"\"\"\n    def __init__(self, message: str, code: str) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass TuplePair:\n    \"\"\"\n    Represents a 2-element numeric pair and computes its product.\n    \"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]) -> None:\n        self.a = float(a)\n        self.b = float(b)\n\n    def product(self) -> float:\n        \"\"\"\n        Computes and returns the product of the two elements.\n        \"\"\"\n        return self.a * self.b\n\nclass InputList:\n    \"\"\"\n    Container for a list of TuplePair instances.\n    \"\"\"\n    def __init__(self, tuples: List[TuplePair]) -> None:\n        self.tuples = tuples\n\nclass Result:\n    \"\"\"\n    Container for the minimum product value.\n    \"\"\"\n    def __init__(self, min_product: float) -> None:\n        self.min_product = min_product\n\nclass MinProductFunction:\n    \"\"\"\n    Core logic to validate InputList and compute the minimum product.\n    \"\"\"\n    def __init__(self, name: str = \"min_product_tuple\") -> None:\n        self.name = name\n\n    def execute(self, input_list: InputList) -> Result:\n        \"\"\"\n        Executes the algorithm to find the minimum product from validated TuplePairs.\n        \"\"\"\n        if not input_list.tuples:\n            raise ValidationError(\"Internal error: InputList received an empty list of tuples.\", \"EMPTY_INPUT_LIST_INTERNAL\")\n\n        min_val = float('inf')\n        for tuple_pair in input_list.tuples:\n            current_product = tuple_pair.product()\n            min_val = min(min_val, current_product)\n\n        return Result(min_val)\n\ndef min_product_tuple(input_list: List[Tuple[Union[int, float], Union[int, float]]]) -> float:\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n    Validates input and computes the minimum product in a single pass.\n    \"\"\"\n    if not isinstance(input_list, (list, tuple)):\n        raise ValidationError(\"Input must be a list or tuple.\", \"INVALID_INPUT_TYPE\")\n    if not input_list:\n        raise ValidationError(\"Input list cannot be empty.\", \"EMPTY_INPUT_LIST\")\n\n    validated_tuple_pairs: List[TuplePair] = []\n    for i, item in enumerate(input_list):\n        if not isinstance(item, (list, tuple)):\n            raise ValidationError(f\"Element at index {i} must be a tuple or list.\", \"INVALID_ELEMENT_TYPE\")\n        if len(item) != 2:\n            raise ValidationError(f\"Tuple at index {i} must have exactly 2 elements.\", \"INVALID_TUPLE_LENGTH\")\n\n        a, b = item[0], item[1]\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise ValidationError(f\"Elements in tuple at index {i} must be numeric.\", \"NON_NUMERIC_ELEMENT\")\n\n        validated_tuple_pairs.append(TuplePair(a, b))\n\n    domain_input_list = InputList(validated_tuple_pairs)\n    min_product_func = MinProductFunction()\n    result = min_product_func.execute(domain_input_list)\n\n    return result.min_product"}
