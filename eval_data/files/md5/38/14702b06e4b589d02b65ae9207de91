{"task_id": "Mbpp/430", "solution": "from typing import Union\n\nclass Parabola:\n    \"\"\"Represents a parabola with coefficients a, b, c and computes its directrix.\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float], c: Union[int, float]) -> None:\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\n    def compute_directrix(self) -> float:\n        \"\"\"Computes the directrix of the parabola using the formula c - (b**2 + 1) / (4 * a).\"\"\"\n        return self.c - (self.b**2 + 1) / (4 * self.a)\n\nclass InputValidator:\n    \"\"\"Provides static methods to validate inputs for parabola calculations.\"\"\"\n    @staticmethod\n    def is_numeric(a, b, c) -> bool:\n        \"\"\"Checks if all inputs are numeric (int or float).\"\"\"\n        return isinstance(a, (int, float)) and \\\n               isinstance(b, (int, float)) and \\\n               isinstance(c, (int, float))\n\n    @staticmethod\n    def is_valid_parabola(a) -> bool:\n        \"\"\"Checks if the 'a' coefficient is non-zero.\"\"\"\n        return a != 0\n\nclass Result:\n    \"\"\"A data transfer object for the computed directrix.\"\"\"\n    def __init__(self, directrix: float) -> None:\n        self.directrix = directrix\n\ndef parabola_directrix(a, b, c):\n    \"\"\"\n    Calculates the directrix of a parabola given its coefficients a, b, and c.\n    Raises TypeError for non-numeric inputs or ValueError if 'a' is zero.\n    \"\"\"\n    if not InputValidator.is_numeric(a, b, c):\n        raise TypeError(\"All inputs (a, b, c) must be numeric (int or float).\")\n\n    if not InputValidator.is_valid_parabola(a):\n        raise ValueError(\"Coefficient 'a' cannot be zero for a parabola.\")\n\n    parabola = Parabola(a, b, c)\n    directrix_value = parabola.compute_directrix()\n\n    # The Result DTO is instantiated as per design, though its value is directly returned.\n    result_obj = Result(directrix_value)\n\n    return result_obj.directrix"}
{"task_id": "Mbpp/436", "solution": "def neg_nos(input_list):\n    \"\"\"Return list of elements x from input_list such that x < 0, preserving input relative order.\"\"\"\n    negative_numbers = []\n    for number in input_list:\n        if number < 0:\n            negative_numbers.append(number)\n    return negative_numbers"}
{"task_id": "Mbpp/437", "solution": "def remove_odd(s: str) -> str:\n    \"\"\"Removes characters at 1-based odd positions, preserving 1-based even positions.\n    In 0-based indexing, this keeps characters at indices 1, 3, 5, etc.\"\"\"\n    result_chars = []\n    for i in range(len(s)):\n        if i % 2 == 1:  # Keep characters at 0-based odd indices\n            result_chars.append(s[i])\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/439", "solution": "from typing import List\n\ndef multiple_to_single(numbers: List[int]) -> int:\n    \"\"\"SRS-specified function: accepts a list of integers and returns a single integer equal to the decimal-string-concatenation of the inputs in order.\"\"\"\n    concatenated_str = ''.join(str(n) for n in numbers)\n    return int(concatenated_str) if concatenated_str != '' else 0"}
{"task_id": "Mbpp/441", "solution": "class InputValidator:\n    \"\"\"Provides validation primitives for input.\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Checks if the given value is numeric (int or float).\"\"\"\n        return isinstance(value, (int, float))\n\n    def isNonNegative(self, value) -> bool:\n        \"\"\"Checks if the given value is non-negative.\"\"\"\n        return value >= 0\n\nclass Cube:\n    \"\"\"Domain data holder for cube side length and surface area calculation.\"\"\"\n    def __init__(self, size: float):\n        self.size = float(size)\n\n    def getSurfaceArea(self) -> float:\n        \"\"\"Calculates and returns the surface area of the cube.\"\"\"\n        return 6 * self.size * self.size\n\nclass SurfaceAreaCalculator:\n    \"\"\"Orchestrates validation and computes cube surface area.\"\"\"\n    def surfacearea_cube(self, size: float) -> float:\n        \"\"\"Validates input and calculates the surface area of a cube.\"\"\"\n        validator = InputValidator()\n        if not validator.isNumeric(size):\n            raise ValueError(\"Input 'size' must be a numeric value.\")\n        if not validator.isNonNegative(size):\n            raise ValueError(\"Input 'size' must be non-negative.\")\n\n        cube = Cube(size)\n        return cube.getSurfaceArea()\n\ndef surfacearea_cube(size):\n    \"\"\"\n    Calculates the surface area of a cube given its side length.\n    Input must be numeric and non-negative, otherwise a ValueError is raised.\n    \"\"\"\n    calc = SurfaceAreaCalculator()\n    return calc.surfacearea_cube(size)"}
