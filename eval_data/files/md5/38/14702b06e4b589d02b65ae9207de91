{"task_id": "Mbpp/293", "solution": "from dataclasses import dataclass\nfrom math import sqrt, isfinite\n\n@dataclass\nclass NumericParameter:\n    value: float\n\n@dataclass\nclass CalculationResult:\n    value: float\n\n@dataclass\nclass RightAngledTriangle:\n    sideA: float\n    sideB: float\n\n    def calculateHypotenuse(self) -> CalculationResult:\n        sum_squares = self.sideA * self.sideA + self.sideB * self.sideB\n        value = sqrt(sum_squares)\n        return CalculationResult(value=value)\n\ndef _validate_numeric(v: object) -> bool:\n    \"\"\"Returns True if v is int or float and isfinite(v) is True, else False.\"\"\"\n    return isinstance(v, (int, float)) and isfinite(v)\n\ndef otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"\n    Computes the hypotenuse of a right-angled triangle given its two other sides.\n    Validates inputs and raises TypeError if validation fails.\n    \"\"\"\n    if not _validate_numeric(a) or not _validate_numeric(b):\n        raise TypeError(\"parameters must be numeric\")\n\n    triangle = RightAngledTriangle(sideA=float(a), sideB=float(b))\n    result = triangle.calculateHypotenuse()\n    return result.value"}
{"task_id": "Mbpp/296", "solution": "from typing import List\n\nclass InversionCounter:\n    \"\"\"Helper class to encapsulate the merge-sort based inversion counting algorithm.\"\"\"\n\n    @staticmethod\n    def get_Inv_Count(numbers: List[float]) -> int:\n        \"\"\"Compute inversion count using a merge-sort based algorithm.\n        This method uses nested helper functions for splitting, merging, and counting.\n        \"\"\"\n\n        def merge_and_count(left_arr: List[float], right_arr: List[float]) -> tuple[int, List[float]]:\n            \"\"\"Merges two sorted arrays and counts inversions between them.\"\"\"\n            merged_arr = []\n            inversions = 0\n            i, j = 0, 0\n            len_left, len_right = len(left_arr), len(right_arr)\n\n            while i < len_left and j < len_right:\n                if left_arr[i] <= right_arr[j]:\n                    merged_arr.append(left_arr[i])\n                    i += 1\n                else:\n                    merged_arr.append(right_arr[j])\n                    inversions += (len_left - i)  # Count inversions for elements remaining in left_arr\n                    j += 1\n\n            merged_arr.extend(left_arr[i:])\n            merged_arr.extend(right_arr[j:])\n            \n            return inversions, merged_arr\n\n        def merge_sort_and_count(arr: List[float]) -> tuple[int, List[float]]:\n            \"\"\"Recursively sorts the array and counts total inversions.\"\"\"\n            n = len(arr)\n            if n <= 1:\n                return 0, arr  # Base case: 0 or 1 element has no inversions\n\n            mid = n // 2\n            left_inv, left_sorted = merge_sort_and_count(arr[:mid])\n            right_inv, right_sorted = merge_sort_and_count(arr[mid:])\n\n            # Count inversions generated during the merge step\n            split_inv, merged_sorted = merge_and_count(left_sorted, right_sorted)\n\n            total_inversions = left_inv + right_inv + split_inv\n            return total_inversions, merged_sorted\n\n        # Initiate the merge-sort process with the input numbers\n        count, _ = merge_sort_and_count(numbers)\n        return count\n\ndef get_Inv_Count(numbers: List[float]) -> int:\n    \"\"\"Module-level API to count inversions in an array.\n    Delegates the core logic to the InversionCounter class for computation.\n    \"\"\"\n    return InversionCounter.get_Inv_Count(numbers)"}
{"task_id": "Mbpp/294", "solution": "class Element:\n    \"\"\"Base class for list elements, providing type information.\"\"\"\n    def __init__(self, value):\n        self.value = value\n        self.type_name = type(value).__name__\n\n    def is_numeric(self):\n        \"\"\"Checks if the element's value is an int or float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass NumericElement(Element):\n    \"\"\"Represents a numeric element from the input list.\"\"\"\n    def __init__(self, value):\n        super().__init__(value)\n        self.numeric_value = value\n\nclass NonNumericElement(Element):\n    \"\"\"Represents a non-numeric element from the input list.\"\"\"\n    def __init__(self, value):\n        super().__init__(value)\n        self.raw_value = value\n\nclass InputList:\n    \"\"\"Wrapper for the input list, validating its type and containing Element objects.\"\"\"\n    def __init__(self, raw_list):\n        if not isinstance(raw_list, list):\n            raise TypeError(\"Input must be a list.\")\n        self.elements = []\n        for item in raw_list:\n            if isinstance(item, (int, float)):\n                self.elements.append(NumericElement(item))\n            else:\n                self.elements.append(NonNumericElement(item))\n\nclass MaxResult:\n    \"\"\"Value object holding the computed maximum numeric value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass MaxValFunction:\n    \"\"\"Encapsulates the logic for finding the maximum value in a heterogeneous list.\"\"\"\n    def max_val(self, input_list_raw):\n        input_list = self._parse_input(input_list_raw)\n        numeric_elements, _ = self._classify_elements(input_list)\n        max_result = self._compute_max(numeric_elements)\n        return max_result.value\n\n    def _parse_input(self, raw_list):\n        \"\"\"Validates input type and wraps it into an InputList object.\"\"\"\n        return InputList(raw_list)\n\n    def _classify_elements(self, input_list: InputList):\n        \"\"\"Separates elements into numeric and non-numeric categories.\"\"\"\n        numeric_elements = []\n        non_numeric_elements = []\n        for element_wrapper in input_list.elements:\n            if element_wrapper.is_numeric():\n                numeric_elements.append(element_wrapper)\n            else:\n                non_numeric_elements.append(element_wrapper)\n        return numeric_elements, non_numeric_elements\n\n    def _compute_max(self, numeric_elements: list[NumericElement]):\n        \"\"\"Computes the maximum value from a list of NumericElement objects.\"\"\"\n        if not numeric_elements:\n            raise ValueError(\"No numeric elements found in the list.\")\n        \n        numeric_values = [ne.numeric_value for ne in numeric_elements]\n        \n        max_value = numeric_values[0]\n        for val in numeric_values[1:]:\n            if val > max_value:\n                max_value = val\n        \n        return MaxResult(max_value)\n\ndef max_val(list):\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    assert max_val(['Python', 3, 2, 4, 5, 'version'])==5\n    \"\"\"\n    processor = MaxValFunction()\n    return processor.max_val(list)"}
{"task_id": "Mbpp/297", "solution": "from typing import List, Any\n\ndef validate_input(nested_list: List[Any]) -> None:\n    \"\"\"Raise TypeError if any element is not int or list.\"\"\"\n    elements_to_check = [nested_list]\n    while elements_to_check:\n        current_item = elements_to_check.pop()\n        if isinstance(current_item, list):\n            for item in current_item:\n                elements_to_check.append(item)\n        elif not isinstance(current_item, int):\n            raise TypeError(\"List must contain only integers or nested lists.\")\n\ndef _flatten_iterative(nested_list: List[Any]) -> List[int]:\n    \"\"\"Iteratively traverse nested_list and return flattened list of ints.\"\"\"\n    flattened_list = []\n    processing_stack = list(reversed(nested_list))\n\n    while processing_stack:\n        element = processing_stack.pop()\n        if isinstance(element, list):\n            if element:\n                for item in reversed(element):\n                    processing_stack.append(item)\n        else:\n            flattened_list.append(element)\n    return flattened_list\n\ndef flatten_list(nested_list: List[Any]) -> List[int]:\n    \"\"\"Return a new list of ints flattened from nested_list without mutating nested_list.\n    Raises TypeError if nested_list contains non-int and non-list elements.\"\"\"\n    validate_input(nested_list)\n    return _flatten_iterative(nested_list)"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict\n\nclass NameValueTuple:\n    \"\"\"Represents a single input element (name and numeric value).\"\"\"\n    def __init__(self, name: str, value: float) -> None:\n        self.name = name\n        self.value = value\n\nclass AggregatedTotal:\n    \"\"\"Represents aggregated total for a unique name.\"\"\"\n    def __init__(self, name: str, total: float) -> None:\n        self.name = name\n        self.total = total\n\nclass MaxAggregateFunction:\n    \"\"\"Encapsulates aggregation and maximum-finding logic.\"\"\"\n    def __init__(self, input_list: List[Tuple[str, float]]) -> None:\n        self.input_list = input_list\n\n    def execute(self) -> AggregatedTotal:\n        \"\"\"Performs aggregation and finds the maximum aggregated total.\"\"\"\n        aggregated_data = self.aggregateByName()\n        max_total_entry = self.findMax(aggregated_data)\n        return max_total_entry\n\n    def aggregateByName(self) -> Dict[str, float]:\n        \"\"\"Aggregates numeric values by unique name.\"\"\"\n        aggregated_sums: Dict[str, float] = {}\n        for name, value in self.input_list:\n            aggregated_sums[name] = aggregated_sums.get(name, 0.0) + value\n        return aggregated_sums\n\n    def findMax(self, aggregated: Dict[str, float]) -> AggregatedTotal:\n        \"\"\"Finds the name with the largest aggregated total.\"\"\"\n        if not aggregated:\n            # As per design, empty input behavior is unspecified.\n            # Allowing natural Python behavior (ValueError from max() on empty iterable)\n            # or could return a default AggregatedTotal if specified.\n            # For now, following the spirit of \"not introducing policies\".\n            pass \n        \n        max_name, max_total = max(aggregated.items(), key=lambda item: item[1])\n        return AggregatedTotal(max_name, max_total)\n\ndef max_aggregate(input_list: List[Tuple[str, float]]) -> Tuple[str, float]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Returns the name and its total sum for the name with the highest aggregate.\n    \"\"\"\n    processor = MaxAggregateFunction(input_list)\n    result = processor.execute()\n    return (result.name, result.total)"}
{"task_id": "Mbpp/301", "solution": "from typing import Any\n\ndef is_dict(obj: Any) -> bool:\n    \"\"\"Checks if the given object is an instance of dict.\"\"\"\n    return isinstance(obj, dict)\n\ndef _compute_depth(dct: dict) -> int:\n    \"\"\"Recursively computes the maximum nesting depth of dictionary values.\"\"\"\n    max_child_depth = 0\n    for value in dct.values():\n        if isinstance(value, dict):\n            max_child_depth = max(max_child_depth, _compute_depth(value))\n    return 1 + max_child_depth\n\ndef dict_depth(input_dict: Any) -> int:\n    \"\"\"\n    Finds the maximum nesting depth of dictionary-valued entries in a dictionary.\n    The outermost dictionary counts as depth 1.\n    \"\"\"\n    if not is_dict(input_dict):\n        raise TypeError(\"Input must be a dictionary.\")\n    return _compute_depth(input_dict)"}
{"task_id": "Mbpp/300", "solution": "import math\nfrom dataclasses import dataclass\n\nclass InputN:\n    \"\"\"Represents and validates an integer input n for sequence calculations.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Validates if the input value is a non-negative integer.\"\"\"\n        return isinstance(self.value, int) and self.value >= 0\n\nclass BinomialUtils:\n    \"\"\"Provides exact integer combinatorial computations.\"\"\"\n    def binomial(self, n: int, k: int) -> int:\n        \"\"\"Computes the binomial coefficient C(n, k).\"\"\"\n        return math.comb(n, k)\n\n    def central_binomial(self, n: int) -> int:\n        \"\"\"Computes the central binomial coefficient C(2n, n).\"\"\"\n        return self.binomial(2 * n, n)\n\n@dataclass\nclass Result:\n    \"\"\"Simple data holder for a count result.\"\"\"\n    count: int\n\n@dataclass\nclass Error:\n    \"\"\"Simple data holder for error metadata.\"\"\"\n    type: str\n    message: str\n\nclass CountBinarySeq:\n    \"\"\"Orchestrates input validation and central binomial computation.\"\"\"\n    def count(self, n: int) -> int:\n        \"\"\"\n        Validates input n, then computes and returns the central binomial coefficient C(2n,n).\n        Raises ValueError for invalid inputs.\n        \"\"\"\n        input_n = InputN(value=n)\n        if not input_n.validate():\n            error_details = Error(type=\"ValueError\", message=\"Input 'n' must be a non-negative integer.\")\n            raise ValueError(error_details.message)\n\n        binomial_utils = BinomialUtils()\n        return binomial_utils.central_binomial(n)\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Finds the count of all binary sequences of length 2n such that\n    the sum of the first n bits is the same as the sum of the last n bits.\n    This count is equivalent to the central binomial coefficient C(2n, n).\n    \"\"\"\n    orchestrator = CountBinarySeq()\n    return orchestrator.count(n)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\nclass InputList:\n    \"\"\"Domain wrapper for input list.\"\"\"\n    def __init__(self, items: List[str]) -> None:\n        self.items = items\n\nclass Word:\n    \"\"\"Represents a token and tests whether it starts with 'p' or 'P'.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def startsWithP(self) -> bool:\n        \"\"\"Return True if value starts with 'p' or 'P' (inspect only first character).\"\"\"\n        return len(self.value) > 0 and self.value[0].lower() == 'p'\n\nclass ResultTuple:\n    \"\"\"Immutable holder for the two matched words and produces a Python tuple for return.\"\"\"\n    def __init__(self, first: str, second: str) -> None:\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> Tuple[str, str]:\n        return (self.first, self.second)\n\nclass StartWithP:\n    \"\"\"Orchestrates tokenization, filtering (startsWith 'p', case-insensitive), preserves order, returns first two matches.\"\"\"\n    def start_withp(self, items: List[str]) -> Tuple[str, str]:\n        \"\"\"Perform tokenization, filter tokens whose first character is 'p' or 'P', preserve ordering, return first two matches as tuple.\"\"\"\n        found_words: List[str] = []\n        input_list_wrapper = InputList(items)\n\n        for item_str in input_list_wrapper.items:\n            tokens = item_str.split()\n            for token in tokens:\n                word_obj = Word(token)\n                if word_obj.startsWithP():\n                    found_words.append(word_obj.value)\n                    if len(found_words) == 2:\n                        return ResultTuple(found_words[0], found_words[1]).as_tuple()\n\n        raise ValueError(\"fewer than two words starting with 'p'\")\n\ndef start_withp(items: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p'.\n    Raises ValueError if fewer than two words starting with 'p' are found.\n    \"\"\"\n    return StartWithP().start_withp(items)"}
