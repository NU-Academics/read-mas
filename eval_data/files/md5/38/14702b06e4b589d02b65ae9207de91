{"task_id": "Mbpp/440", "solution": "import typing\n\nclass Sentence:\n    \"\"\"Represents a sentence with its text content.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\nclass PunctuationHandler:\n    \"\"\"Handles stripping leading/trailing punctuation from tokens and detecting punctuation.\"\"\"\n    def is_punctuation(self, char: str) -> bool:\n        \"\"\"Determines if a character is considered boundary punctuation.\"\"\"\n        return not char.isalpha()\n\n    def strip(self, token_raw: str) -> tuple[str, int, int]:\n        \"\"\"\n        Strips leading/trailing punctuation from a raw token.\n        Returns the stripped text and its start/end offsets within the original raw token.\n        \"\"\"\n        first_alpha_offset = -1\n        last_alpha_offset = -1\n\n        for i, char in enumerate(token_raw):\n            if char.isalpha():\n                if first_alpha_offset == -1:\n                    first_alpha_offset = i\n                last_alpha_offset = i\n        \n        if first_alpha_offset == -1: # No alphabetic characters found\n            return \"\", 0, 0\n        \n        # last_alpha_offset is inclusive, but for slicing we need exclusive end\n        stripped_text = token_raw[first_alpha_offset : last_alpha_offset + 1]\n        return stripped_text, first_alpha_offset, last_alpha_offset + 1\n\nclass Token:\n    \"\"\"Represents a token with its raw text, original indices, and stripped form.\"\"\"\n    def __init__(self, raw_text: str, start_index: int, end_index: int) -> None:\n        self.raw_text = raw_text\n        self.start_index = start_index\n        self.end_index = end_index\n        self.stripped_text: str = \"\"\n        self._first_alpha_offset: int = 0\n        self._last_alpha_offset: int = 0\n\n    def alphabetic_text(self) -> str:\n        \"\"\"Returns the alphabetic characters from the stripped text, preserving casing.\"\"\"\n        return ''.join(char for char in self.stripped_text if char.isalpha())\n\n    def is_adverb(self) -> bool:\n        \"\"\"Checks if the token's alphabetic form ends with 'ly' (case-insensitive).\"\"\"\n        alpha_text = self.alphabetic_text()\n        return bool(alpha_text) and alpha_text.lower().endswith('ly')\n\nclass Tokenizer:\n    \"\"\"Splits a sentence into tokens while preserving their original positions.\"\"\"\n    def tokenize(self, sentence: Sentence) -> list[Token]:\n        \"\"\"Tokenizes the sentence text into a list of Token objects.\"\"\"\n        tokens: list[Token] = []\n        current_pos = 0\n        text_length = sentence.length()\n\n        while current_pos < text_length:\n            # Skip leading whitespace\n            while current_pos < text_length and sentence.text[current_pos].isspace():\n                current_pos += 1\n            \n            if current_pos == text_length:\n                break # Reached end of string\n\n            token_start = current_pos\n            # Find end of token (next whitespace or end of string)\n            token_end = token_start\n            while token_end < text_length and not sentence.text[token_end].isspace():\n                token_end += 1\n            \n            raw_text = sentence.text[token_start:token_end]\n            tokens.append(Token(raw_text, token_start, token_end))\n            current_pos = token_end\n        \n        return tokens\n\nclass AdverbResult:\n    \"\"\"A data transfer object for found adverb details.\"\"\"\n    def __init__(self, start_index: int, end_index: int, text: str) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.text = text\n\nclass AdverbDetector:\n    \"\"\"Detects the first adverb in a list of tokens based on the 'ly' suffix rule.\"\"\"\n    def find_first(self, tokens: list[Token]) -> AdverbResult | None:\n        \"\"\"Iterates through tokens to find the first adverb.\"\"\"\n        for token in tokens:\n            if token.is_adverb():\n                global_start = token.start_index + token._first_alpha_offset\n                global_end = token.start_index + token._last_alpha_offset\n                return AdverbResult(global_start, global_end, token.stripped_text)\n        return None\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    Returns (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    s = Sentence(sentence)\n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(s)\n    punct = PunctuationHandler()\n    \n    for token in tokens:\n        stripped_text, first_off, last_off = punct.strip(token.raw_text)\n        token.stripped_text = stripped_text\n        token._first_alpha_offset = first_off\n        token._last_alpha_offset = last_off\n    \n    detector = AdverbDetector()\n    result = detector.find_first(tokens)\n    \n    if result is None:\n        return None\n    return (result.start_index, result.end_index, result.text)"}
{"task_id": "Mbpp/446", "solution": "def _validate_types(input_tuple, input_list) -> None:\n    \"\"\"\n    Validates that the first argument is a tuple and the second is a list.\n    Raises TypeError if types are incorrect.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"First argument must be a tuple.\")\n    if not isinstance(input_list, list):\n        raise TypeError(\"Second argument must be a list.\")\n\ndef count_Occurrence(input_tuple: tuple, input_list: list) -> int:\n    \"\"\"\n    Counts the occurrences of elements from input_list within input_tuple.\n    Validates input types and handles empty inputs.\n    \"\"\"\n    _validate_types(input_tuple, input_list)\n\n    if not input_tuple or not input_list:\n        return 0\n\n    count = 0\n    for item_tuple in input_tuple:\n        if item_tuple in input_list:\n            count += 1\n    return count"}
{"task_id": "Mbpp/448", "solution": "class PerrinSequence:\n    \"\"\"\n    Generates Perrin numbers, utilizing a cache for efficiency.\n    P(0)=3, P(1)=0, P(2)=2; for n>=3: P(n)=P(n-2)+P(n-3).\n    \"\"\"\n    def __init__(self):\n        self._cache = {0: 3, 1: 0, 2: 2}\n\n    def getTerm(self, n: int) -> int:\n        \"\"\"Retrieves the nth Perrin number, computing it if not already cached.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n        \n        # Recursively compute and cache the term\n        p_n_minus_2 = self.getTerm(n - 2)\n        p_n_minus_3 = self.getTerm(n - 3)\n        self._cache[n] = p_n_minus_2 + p_n_minus_3\n        return self._cache[n]\n\nclass Calculator:\n    \"\"\"\n    Orchestrates the calculation of the sum of Perrin numbers.\n    It uses a PerrinSequence instance to get individual terms.\n    \"\"\"\n    def __init__(self):\n        self.sequence = PerrinSequence()\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\"\"\"\n        total_sum = 0\n        for i in range(n + 1):\n            total_sum += self.sequence.getTerm(i)\n        return total_sum\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n).\n    This function delegates the actual calculation to an internal Calculator instance.\n    \"\"\"\n    calculator_instance = Calculator()\n    return calculator_instance.cal_sum(n)"}
{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Union\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef _validate_outer_length(a: Tuple, b: Tuple) -> None:\n    \"\"\"Raise ValidationError('outer length mismatch') if len(a) != len(b).\"\"\"\n    if len(a) != len(b):\n        raise ValidationError(\"outer length mismatch\")\n\ndef _validate_inner_lengths(a: Tuple[Tuple, ...], b: Tuple[Tuple, ...]) -> None:\n    \"\"\"For each index i, raise ValidationError(f'inner length mismatch at index {i}') if len(a[i]) != len(b[i]).\"\"\"\n    for i in range(len(a)):\n        if len(a[i]) != len(b[i]):\n            raise ValidationError(f\"inner length mismatch at index {i}\")\n\ndef _multiply_inner_tuples(inner_a: Tuple[Union[int, float], ...],\n                           inner_b: Tuple[Union[int, float], ...]\n                          ) -> Tuple[Union[int, float], ...]:\n    \"\"\"Return tuple(inner_a[j] * inner_b[j] for j ...)\"\"\"\n    return tuple(inner_a[j] * inner_b[j] for j in range(len(inner_a)))\n\ndef index_multiplication(a: Tuple[Tuple[Union[int, float], ...], ...],\n                         b: Tuple[Tuple[Union[int, float], ...], ...]\n                        ) -> Tuple[Tuple[Union[int, float], ...], ...]:\n    \"\"\"Validate inputs and return a new tuple of inner tuples formed by index-wise multiplication.\n\n    Raises: ValidationError: if outer tuple lengths differ or any corresponding inner tuples differ in length.\n    \"\"\"\n    _validate_outer_length(a, b)\n    _validate_inner_lengths(a, b)\n\n    result_outer_tuple = []\n    for i in range(len(a)):\n        result_outer_tuple.append(_multiply_inner_tuples(a[i], b[i]))\n    return tuple(result_outer_tuple)"}
{"task_id": "Mbpp/450", "solution": "import typing\n\ndef extract_string(items: typing.List[str], size: int) -> typing.List[str]:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Returns a new list containing only the matching strings, preserving order.\n    \"\"\"\n    result = []\n    for item in items:\n        if len(item) == size:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/451", "solution": "DEFAULT_WHITESPACE_CHARS = ('\\u0020', '\\t', '\\n')\n\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all specified whitespace characters from the input string.\"\"\"\n    cleaned_chars = []\n    for char in input:\n        if char not in DEFAULT_WHITESPACE_CHARS:\n            cleaned_chars.append(char)\n    return \"\".join(cleaned_chars)"}
{"task_id": "Mbpp/453", "solution": "from typing import Iterable\n\ndef factors(n: int) -> Iterable[int]:\n    \"\"\"Yield positive divisors d > 0 of |n| such that n % d == 0.\"\"\"\n    abs_n = abs(n)\n    if abs_n == 0:\n        return # No positive factors for 0\n    for i in range(1, int(abs_n**0.5) + 1):\n        if abs_n % i == 0:\n            yield i\n            if i * i != abs_n:\n                yield abs_n // i\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"Return the sum of all even positive divisors of n as a Python int.\"\"\"\n    total_sum = 0\n    for factor in factors(n):\n        if factor % 2 == 0:\n            total_sum += factor\n    return total_sum"}
