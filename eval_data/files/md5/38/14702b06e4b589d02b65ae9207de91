{"task_id": "Mbpp/392", "solution": "from typing import Dict\n\nclass RecurrenceRule:\n    \"\"\"Holds the string expression of the recurrence rule for documentation.\"\"\"\n    expression: str = \"f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n)\"\n\nclass IntegerDivision:\n    \"\"\"Utility class for performing floor division.\"\"\"\n    @staticmethod\n    def floor_divide(n: int, d: int) -> int:\n        \"\"\"Returns the floor of n divided by d.\"\"\"\n        return n // d\n\nclass GetMaxSumFunction:\n    \"\"\"Computes the maximum sum using the defined recurrence with memoization.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the cache for memoization.\"\"\"\n        self._cache: Dict[int, int] = {}\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes f(n) = max(n, f(n/2) + f(n/3) + f(n/4) + f(n/5)) using memoization.\n        \"\"\"\n        if n == 0:\n            return 0\n        if n in self._cache:\n            return self._cache[n]\n\n        n2 = IntegerDivision.floor_divide(n, 2)\n        n3 = IntegerDivision.floor_divide(n, 3)\n        n4 = IntegerDivision.floor_divide(n, 4)\n        n5 = IntegerDivision.floor_divide(n, 5)\n\n        sub_sum = self.compute(n2) + self.compute(n3) + self.compute(n4) + self.compute(n5)\n        result = max(n, sub_sum)\n        self._cache[n] = result\n        return result\n\n_DEFAULT_GMF: GetMaxSumFunction = GetMaxSumFunction()\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    # Assumes n is a non-negative integer as per design context.\n    return _DEFAULT_GMF.compute(n)"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Any, Dict\n\nclass Student:\n    \"\"\"\n    Lightweight value holder representing one logical row (id, name, score).\n    \"\"\"\n    def __init__(self, id: str, name: str, score: Any):\n        self.id = id\n        self.name = name\n        self.score = score\n\nclass NestedEntry:\n    \"\"\"\n    Represents the nested mapping for a single Student: { id : { name : score } }.\n    \"\"\"\n    def __init__(self, entry_id: str, name_val: str, score_val: Any):\n        self.id = entry_id\n        self.name_to_score = {name_val: score_val}\n\n    def to_dict(self) -> Dict[str, Dict[str, Any]]:\n        \"\"\"\n        Converts the NestedEntry object into a plain Python dictionary.\n        \"\"\"\n        return {self.id: self.name_to_score}\n\nclass OutputList:\n    \"\"\"\n    Maintains an ordered collection of NestedEntry objects and converts them to a list of dicts.\n    \"\"\"\n    def __init__(self):\n        self.entries: List[NestedEntry] = []\n\n    def append(self, nested_entry: NestedEntry) -> None:\n        \"\"\"\n        Appends a NestedEntry object to the internal list.\n        \"\"\"\n        self.entries.append(nested_entry)\n\n    def to_list(self) -> List[Dict[str, Dict[str, Any]]]:\n        \"\"\"\n        Converts the collection of NestedEntry objects into a list of dictionaries.\n        \"\"\"\n        return [entry.to_dict() for entry in self.entries]\n\nclass ListConverter:\n    \"\"\"\n    Encapsulates input validation (type and length) and the conversion logic.\n    \"\"\"\n    def validate_lists(self, ids: List[str], names: List[str], scores: List[Any]) -> None:\n        \"\"\"\n        Validates that all inputs are lists and have equal length, raising TypeError or ValueError.\n        \"\"\"\n        if not isinstance(ids, list):\n            raise TypeError(\"Input 'ids' must be a list.\")\n        if not isinstance(names, list):\n            raise TypeError(\"Input 'names' must be a list.\")\n        if not isinstance(scores, list):\n            raise TypeError(\"Input 'scores' must be a list.\")\n\n        if not (len(ids) == len(names) == len(scores)):\n            raise ValueError(\"Input lists must have equal length.\")\n\n    def convert(self, ids: List[str], names: List[str], scores: List[Any]) -> OutputList:\n        \"\"\"\n        Converts parallel lists into an OutputList of NestedEntry objects, preserving order.\n        \"\"\"\n        output_list = OutputList()\n        for i in range(len(ids)):\n            nested_entry = NestedEntry(ids[i], names[i], scores[i])\n            output_list.append(nested_entry)\n        return output_list\n\ndef convert_list_dictionary(ids: List[str], names: List[str], scores: List[Any]) -> List[Dict[str, Dict[str, Any]]]:\n    \"\"\"\n    Converts three parallel lists (ids, names, scores) into an ordered list of nested dictionaries.\n    It validates inputs and then constructs the nested mappings as specified.\n    \"\"\"\n    converter = ListConverter()\n    converter.validate_lists(ids, names, scores)\n    output_list_obj = converter.convert(ids, names, scores)\n    return output_list_obj.to_list()"}
{"task_id": "Mbpp/398", "solution": "from typing import List, Iterator\n\nclass Digit:\n    \"\"\"Lightweight representation of a single decimal digit value (0..9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\nclass SumResult:\n    \"\"\"Holds the integer total computed by accumulating Digit values.\"\"\"\n    def __init__(self, total: int = 0) -> None:\n        self._total = total\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds an integer to the total.\"\"\"\n        self._total += value\n\n    def get_total(self) -> int:\n        \"\"\"Returns the accumulated total.\"\"\"\n        return self._total\n\nclass IntegerElement:\n    \"\"\"Represents a single integer element and provides extraction of its decimal digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def extractDigits(self) -> List[int]:\n        \"\"\"Returns the list of decimal digits (0..9) for the element's absolute value (base-10).\"\"\"\n        if self._value == 0:\n            return [0]\n        \n        # Convert to string to easily extract digits, handling negative numbers by taking absolute value\n        return [int(d) for d in str(abs(self._value))]\n\nclass IntegerList:\n    \"\"\"Represents the ordered collection of IntegerElement items.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self._values: List[IntegerElement] = [IntegerElement(val) for val in values]\n\n    def __iter__(self) -> Iterator[IntegerElement]:\n        \"\"\"Iterate elements.\"\"\"\n        return iter(self._values)\n\nclass SumOfDigitsFunction:\n    \"\"\"Encapsulates the algorithm for verifying input, extracting digits, accumulating values, and producing a SumResult.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self._input_list = IntegerList(numbers)\n\n    def sum_of_digits(self) -> int:\n        \"\"\"Orchestrates digit extraction and sum computation.\"\"\"\n        sum_result = SumResult()\n        for integer_element in self._input_list:\n            digits = integer_element.extractDigits()\n            for digit_value in digits:\n                sum_result.add(digit_value)\n        return sum_result.get_total()\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number of a given list.\n    assert sum_of_digits([10,2,56])==14\n    \"\"\"\n    processor = SumOfDigitsFunction(numbers)\n    return processor.sum_of_digits()"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\n\ndef first_non_repeating_character(input: str) -> Optional[str]:\n    \"\"\"Return the first non-repeated character from input or None.\"\"\"\n    if not input:\n        return None\n\n    # Build a frequency map (dict) by iterating over input and counting characters.\n    char_counts = {}\n    for char in input:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    # Iterate over input again; for each character, if frequency_map[char] == 1, return char.\n    for char in input:\n        if char_counts[char] == 1:\n            return char\n\n    # If no such character found, return None.\n    return None"}
