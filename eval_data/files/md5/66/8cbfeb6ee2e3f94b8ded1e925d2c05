{"task_id": "Mbpp/103", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid inputs to eulerian_num.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass InputParameters:\n    \"\"\"Encapsulates n and m and provides validation helpers.\"\"\"\n    def __init__(self, n, m):\n        self.n = n\n        self.m = m\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if n and m are integers.\"\"\"\n        return isinstance(self.n, int) and isinstance(self.m, int)\n\n    def in_range(self) -> bool:\n        \"\"\"Checks if n and m satisfy 0 <= m < n and are non-negative.\"\"\"\n        return self.n >= 0 and self.m >= 0 and self.m < self.n\n\nclass EulerianFunction:\n    \"\"\"Implements computation of Eulerian numbers via recurrence relation.\"\"\"\n    def __init__(self):\n        self._memo = {} # Memoization table for (n, m) pairs\n\n    def compute_recurrence(self, n: int, m: int) -> int:\n        \"\"\"Computes the Eulerian number a(n, m) using the recurrence relation.\"\"\"\n        # Base cases\n        if m < 0 or m >= n:\n            return 0\n        if n == 0:\n            return 1 if m == 0 else 0\n\n        # Check memoization table\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        # Recurrence relation: a(n,m) = (n - m) * a(n-1, m-1) + (m + 1) * a(n-1, m)\n        res_m_minus_1 = self.compute_recurrence(n - 1, m - 1)\n        res_m = self.compute_recurrence(n - 1, m)\n\n        result = (n - m) * res_m_minus_1 + (m + 1) * res_m\n\n        self._memo[(n, m)] = result\n        return result\n\n    def compute_closed_form(self, n: int, m: int) -> int:\n        \"\"\"Placeholder for closed-form computation (not used by public API).\"\"\"\n        pass\n\ndef eulerian_num(n, m) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m).\n    Raises InvalidInputError for invalid inputs.\n    \"\"\"\n    params = InputParameters(n, m)\n    if not params.is_integer() or not params.in_range():\n        raise InvalidInputError(\"n and m must be integers with 0 <= m < n\")\n    \n    ef = EulerianFunction()\n    return ef.compute_recurrence(n, m)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\n\ndef sort_sublists(input_sequence: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"\n    Accepts: input_sequence (list or tuple) where each element is a sequence of strings.\n    Returns: list of lists of strings; each inner list is a sorted copy (ascending lexicographic) of the corresponding input sublist.\n    Behavior: Does not mutate the input; if input is not a list or tuple, or sublists are not sequences of strings, raises TypeError or ValueError (validation per design).\n    \"\"\"\n    if not isinstance(input_sequence, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of sequences.\")\n\n    result: List[List[str]] = []\n\n    for sub in input_sequence:\n        if not isinstance(sub, Sequence):\n            raise TypeError(\"Each element in the input sequence must be a sequence.\")\n\n        if not sub:\n            result.append([])\n        else:\n            for item in sub:\n                if not isinstance(item, str):\n                    raise TypeError(\"All elements within sublists must be strings.\")\n\n            inner = list(sub)\n            inner.sort()\n            result.append(inner)\n\n    return result"}
