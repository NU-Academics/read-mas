{"task_id": "Mbpp/84", "solution": "class NewmanConwayService:\n    \"\"\"Service to compute Newman-Conway sequence values with memoization.\"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the service with an empty memoization cache.\"\"\"\n        self.memo: dict[int, int] = {}\n\n    def sequence(self, n: int) -> int:\n        \"\"\"Validates input n and computes the nth Newman-Conway number.\"\"\"\n        self.validateInput(n)\n        return self.compute(n)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Recursively computes a(n) using base cases and memoization.\"\"\"\n        if n == 1 or n == 2:\n            return 1\n        \n        if n in self.memo:\n            return self.memo[n]\n        \n        val_n_minus_1 = self.compute(n - 1)\n        val_of_val_n_minus_1 = self.compute(val_n_minus_1)\n        val_n_minus_val_n_minus_1 = self.compute(n - val_n_minus_1)\n        \n        result = val_of_val_n_minus_1 + val_n_minus_val_n_minus_1\n        self.memo[n] = result\n        return result\n\n    def validateInput(self, n: int) -> None:\n        \"\"\"Stub for input validation. No actual validation performed due to prompt constraints.\"\"\"\n        pass\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    This function delegates to an internal service class for computation and memoization.\n    \"\"\"\n    service = NewmanConwayService()\n    return service.sequence(n)"}
{"task_id": "Mbpp/86", "solution": "__all__ = [\"centered_hexagonal_number\"]\n\n\nclass ErrorHandler:\n    \"\"\"Handles raising ValueErrors for invalid inputs.\"\"\"\n    def raise_value_error(self, message: str) -> None:\n        \"\"\"Raise ValueError with the specified message.\"\"\"\n        raise ValueError(message)\n\n\nclass InputValidator:\n    \"\"\"Validates input 'n' for type and range.\"\"\"\n    def validate_n(self, n) -> bool:\n        \"\"\"Return True if n is an integer and n >= 1, else False.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n\nclass CenteredHexagonalCalculator:\n    \"\"\"Computes the nth centered hexagonal number.\"\"\"\n    _formula: str = \"3*n*(n-1)+1\"\n\n    def centered_hexagonal_number(self, n: int) -> int:\n        \"\"\"Compute and return 3*n*(n-1)+1 using integer arithmetic.\"\"\"\n        return 3 * n * (n - 1) + 1\n\n\ndef centered_hexagonal_number(n):\n    \"\"\"Public API. Validates n and returns nth centered hexagonal number as int or raises ValueError.\"\"\"\n    validator = InputValidator()\n    calculator = CenteredHexagonalCalculator()\n    error_handler = ErrorHandler()\n\n    if not validator.validate_n(n):\n        error_handler.raise_value_error(\"n must be an integer and n >= 1.\")\n\n    return calculator.centered_hexagonal_number(n)"}
{"task_id": "Mbpp/88", "solution": "def freq_count(items: list) -> dict:\n    \"\"\"\n    Computes the frequency of elements in a list, returning them as a dictionary.\n    The input list is not modified by this function.\n    \"\"\"\n    counts = {}\n    for item in items:\n        counts[item] = counts.get(item, 0) + 1\n    return counts"}
{"task_id": "Mbpp/87", "solution": "from typing import Any, Dict\n\nclass KeyValuePair:\n    \"\"\"Data holder for a key-value pair.\"\"\"\n    def __init__(self, key: str, value: Any):\n        self.key = key\n        self.value = value\n\nclass Dictionary:\n    \"\"\"Wraps a native dict; provides essential dict-like operations.\"\"\"\n    def __init__(self, initial: Dict[str, Any] = None):\n        self.items = initial if initial is not None else {}\n\n    def keys(self) -> set:\n        \"\"\"Returns a set of all keys in the dictionary.\"\"\"\n        return set(self.items.keys())\n\n    def get(self, key: str) -> Any:\n        \"\"\"Retrieves the value for a given key.\"\"\"\n        return self.items.get(key)\n\n    def set(self, key: str, value: Any) -> None:\n        \"\"\"Sets the value for a given key.\"\"\"\n        self.items[key] = value\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the wrapper to a native Python dictionary.\"\"\"\n        return self.items\n\nclass MergeFunction:\n    \"\"\"Stateless class to perform the dictionary merge logic.\"\"\"\n    def merge(self, d1: Dict[str, Any], d2: Dict[str, Any], d3: Dict[str, Any]) -> Dictionary:\n        \"\"\"Merges three dictionaries into a single Dictionary wrapper.\"\"\"\n        merged_dict_wrapper = Dictionary()\n\n        # The design specifies \"construct merged mapping per FR3/FR4/FR5\".\n        # Iterating through dictionaries in order and setting values handles:\n        # FR3: Includes all keys as updates add new keys.\n        # FR4: Preserves unique mappings as they are added once.\n        # FR5: Preserves identical mappings as the same value overwrites itself.\n        # For keys with differing values (unspecified by BR7), the value from the later dictionary takes precedence.\n        for key, value in d1.items():\n            merged_dict_wrapper.set(key, value)\n        for key, value in d2.items():\n            merged_dict_wrapper.set(key, value)\n        for key, value in d3.items():\n            merged_dict_wrapper.set(key, value)\n\n        return merged_dict_wrapper\n\ndef merge_dictionaries_three(d1: Dict[str, Any], d2: Dict[str, Any], d3: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Public API: merges three dictionaries into a single dictionary.\"\"\"\n    mf = MergeFunction()\n    result_wrapper = mf.merge(d1, d2, d3)\n    return result_wrapper.to_dict()"}
