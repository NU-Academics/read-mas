{"task_id": "Mbpp/310", "solution": "def string_to_tuple(input: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of characters, omitting ASCII spaces.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    def _validate_input(input_val) -> None:\n        \"\"\"Raises TypeError if the input_val is not a string.\"\"\"\n        if not isinstance(input_val, str):\n            raise TypeError(\"input must be a string\")\n\n    _validate_input(input)\n\n    filtered_chars = []\n    for char in input:\n        if char != ' ':\n            filtered_chars.append(char)\n    return tuple(filtered_chars)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n):\n    \"\"\"\n    Sets the left-most unset bit in the minimal binary representation of n.\n    If all bits are set, it adds a new most significant bit (MSB) 1.\n    \"\"\"\n    # Find the position of the most significant bit (MSB) of n.\n    # For n=0, bit_length() is 0, leading to msb_pos = -1.\n    msb_pos = n.bit_length() - 1\n\n    # Iterate from the MSB position down to 0 to find the left-most unset bit.\n    for i in range(msb_pos, -1, -1):\n        # If the i-th bit is 0 (unset), set it and return the result.\n        if not (n & (1 << i)):\n            return n | (1 << i)\n\n    # If the loop completes, all bits up to msb_pos were already set (e.g., n is 0b1, 0b11, 0b111).\n    # In this case, set the next higher bit (add a new MSB 1).\n    # For n=0, msb_pos is -1, so (msb_pos + 1) becomes 0, setting the 0th bit (0b1).\n    return n | (1 << (msb_pos + 1))"}
{"task_id": "Mbpp/388", "solution": "class Input:\n    \"\"\"Encapsulates input value and performs validation as per design.\"\"\"\n    def __init__(self, n):\n        self.n = n\n    def validate(self) -> None:\n        \"\"\"Validates the input n, raising TypeError or ValueError if invalid.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"n must be an int\")\n        if self.n < 1:\n            raise ValueError(\"n must be >= 1\")\n\nclass PowerOfTwoCalculator:\n    \"\"\"Computes the highest power of two less than or equal to n.\"\"\"\n    def highest_Power_of_2(self, n: int) -> int:\n        return self._compute_using_bit_operations(n)\n    def _compute_using_bit_operations(self, n: int) -> int:\n        \"\"\"Finds the highest power of two <= n using bit shifts.\"\"\"\n        power = 1\n        while (power << 1) <= n:\n            power <<= 1\n        return power\n\nclass Result:\n    \"\"\"Data holder for the computed integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef highest_Power_of_2(n) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Validates input and returns the largest 2^k <= n.\n    \"\"\"\n    inp = Input(n)\n    inp.validate()\n    calc = PowerOfTwoCalculator()\n    value = calc.highest_Power_of_2(inp.n)\n    return int(value)"}
{"task_id": "Mbpp/312", "solution": "import math\n\nclass NumericValidator:\n    \"\"\"Validates if a value is numeric (int or float).\"\"\"\n    def is_numeric(self, value) -> bool:\n        \"\"\"Returns True if the value is an int or float, otherwise False.\"\"\"\n        return isinstance(value, (int, float))\n\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a cone.\"\"\"\n    @staticmethod\n    def volume_cone(radius: float, height: float) -> float:\n        \"\"\"Computes the volume of a cone using the formula (pi * radius^2 * height) / 3.\"\"\"\n        return (math.pi * radius ** 2 * height) / 3.0\n\ndef volume_cone(radius, height) -> float:\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    Validates inputs and raises TypeError if non-numeric.\n    \"\"\"\n    validator = NumericValidator()\n    if not validator.is_numeric(radius) or not validator.is_numeric(height):\n        raise TypeError(\"radius and height must be numeric (int or float)\")\n\n    result = VolumeCalculator.volume_cone(radius, height)\n    return float(result)"}
{"task_id": "Mbpp/389", "solution": "from src.lucas_calculator import LucasCalculator\nfrom src.validation import validate_input\nfrom src.models import ValidationResult\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using an iterative approach.\n    Raises ValueError for invalid non-negative integer input n.\n    \"\"\"\n    validation_result: ValidationResult = validate_input(n)\n\n    if not validation_result.isValid:\n        raise ValueError(validation_result.errorMessage)\n\n    calculator = LucasCalculator()\n    lucas_number_value = calculator.find_lucas(n)\n\n    return lucas_number_value"}
