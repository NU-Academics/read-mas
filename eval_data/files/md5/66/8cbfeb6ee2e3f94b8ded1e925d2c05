{"task_id": "Mbpp/89", "solution": "from math import floor\n\nclass ClosestNum:\n    \"\"\"Helper class to encapsulate validation and computation logic.\"\"\"\n    def validate_input(self, n):\n        \"\"\"Raise TypeError if n is not an int or float.\"\"\"\n        if not isinstance(n, (int, float)):\n            raise TypeError(\"Input must be an int or float.\")\n\n    def compute_for_integer(self, n: int) -> int:\n        \"\"\"Return n - 1 for integer inputs.\"\"\"\n        return n - 1\n\n    def compute_for_float(self, n: float) -> int:\n        \"\"\"Return floor(n) for float inputs.\"\"\"\n        return floor(n)\n\ndef closest_num(n):\n    \"\"\"\n    Returns the largest integer strictly less than n.\n    Raises TypeError for non-numeric inputs.\n    \"\"\"\n    helper = ClosestNum()\n    helper.validate_input(n)\n\n    if isinstance(n, int):\n        return helper.compute_for_integer(n)\n    elif isinstance(n, float):\n        return helper.compute_for_float(n)"}
