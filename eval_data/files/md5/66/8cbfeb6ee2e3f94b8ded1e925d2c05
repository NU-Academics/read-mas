{"task_id": "Mbpp/222", "solution": "def check_type(t: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in a tuple have the same data type.\n\n    Returns True if all elements share the same type or if the tuple is empty, False otherwise.\n    \"\"\"\n    if not t:\n        return True\n    \n    first_type = type(t[0])\n    for element in t:\n        if type(element) is not first_type:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input_string: str) -> int:\n    \"\"\"Counts non-overlapping, case-sensitive occurrences of 'std' in the given string.\n    Raises TypeError if the input is not a string.\"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    return input_string.count(\"std\")"}
{"task_id": "Mbpp/223", "solution": "def _first_occurrence(array, n, x):\n    \"\"\"Return index of first occurrence of x in array, or -1 if not found. Uses binary search and requires sorted array.\"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == x:\n            result = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif array[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef _last_occurrence(array, n, x):\n    \"\"\"Return index of last occurrence of x in array, or -1 if not found. Uses binary search and requires sorted array.\"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == x:\n            result = mid\n            low = mid + 1  # Search in the right half for a later occurrence\n        elif array[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef _count_occurrences(array, n, x):\n    \"\"\"Return integer count of x occurrences in array of length n. Uses first/last occurrence indices to compute count.\"\"\"\n    first_idx = _first_occurrence(array, n, x)\n    if first_idx == -1:\n        return 0\n    last_idx = _last_occurrence(array, n, x)\n    return last_idx - first_idx + 1\n\ndef is_majority(array, n, x):\n    \"\"\"\n    Determine whether x is the majority element in array of length n.\n\n    Returns:\n    - True if count_of(x) > n/2, else False.\n    \"\"\"\n    count = _count_occurrences(array, n, x)\n    return count > (n / 2)"}
