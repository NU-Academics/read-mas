{"task_id": "Mbpp/247", "solution": "from dataclasses import dataclass\n\nclass InputString:\n    \"\"\"Stores the input string and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the stored string.\"\"\"\n        return len(self.value)\n\n@dataclass\nclass Subsequence:\n    \"\"\"Represents a subsequence with its value and length.\"\"\"\n    sequence: str\n    length: int\n\n    def __init__(self, sequence: str) -> None:\n        self.sequence = sequence\n        self.length = len(sequence)\n\n@dataclass\nclass LPSResult:\n    \"\"\"Holds the length of a longest palindromic subsequence.\"\"\"\n    length: int\n\nclass LPSFunction:\n    \"\"\"Computes the length of the longest palindromic subsequence using dynamic programming.\"\"\"\n    def __init__(self, input_string: str) -> None:\n        self._input = InputString(input_string)\n\n    def compute(self) -> int:\n        \"\"\"Computes and returns the LPS length for the stored string.\"\"\"\n        s = self._input.value\n        n = self._input.length()\n\n        if n == 0:\n            return 0\n\n        # dp[i][j] stores the length of the longest palindromic subsequence\n        # of the substring s[i...j]\n        dp = [[0] * n for _ in range(n)]\n\n        # All substrings of length 1 have an LPS length of 1\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the DP table for substrings of increasing length,\n        # ensuring that required subproblems are already solved.\n        for i in range(n - 1, -1, -1):\n            for j in range(i + 1, n):\n                if s[i] == s[j]:\n                    # If characters at i and j match, add 2 to the LPS of the inner substring.\n                    # If j is i+1 (substring length 2), the inner substring is empty (LPS 0).\n                    dp[i][j] = (dp[i + 1][j - 1] + 2) if (j > i + 1) else 2\n                else:\n                    # If characters don't match, take the maximum of\n                    # LPS of s[i+1...j] (excluding s[i]) and LPS of s[i...j-1] (excluding s[j]).\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n        return dp[0][n - 1]\n\ndef lps(input_string: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    It delegates the computation to an internal LPSFunction class.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"lps requires a string input\")\n    processor = LPSFunction(input_string)\n    return processor.compute()"}
{"task_id": "Mbpp/252", "solution": "import math\n\nclass ComplexNumber:\n    \"\"\"A canonical representation for complex numbers with float real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\n    @staticmethod\n    def from_numeric(n):\n        \"\"\"Converts a numeric input (int, float, complex) to a ComplexNumber instance.\"\"\"\n        if isinstance(n, int) or isinstance(n, float):\n            return ComplexNumber(float(n), 0.0)\n        elif isinstance(n, complex):\n            return ComplexNumber(n.real, n.imag)\n\ndef _validate(z) -> None:\n    \"\"\"Validates if the input is an int, float, or complex number.\"\"\"\n    if not isinstance(z, (int, float, complex)):\n        raise TypeError(f\"convert() expected int, float, or complex, got {type(z).__name__}\")\n\ndef _magnitude(c: ComplexNumber) -> float:\n    \"\"\"Computes the magnitude (r) of a ComplexNumber.\"\"\"\n    return math.hypot(c.real, c.imag)\n\ndef _angle(c: ComplexNumber) -> float:\n    \"\"\"Computes the angle (theta) in radians of a ComplexNumber.\"\"\"\n    return math.atan2(c.imag, c.real)\n\ndef convert(z) -> (float, float):\n    \"\"\"Converts a numeric input (int, float, or complex) to polar coordinates (r, theta).\"\"\"\n    _validate(z)\n    c = ComplexNumber.from_numeric(z)\n    r = _magnitude(c)\n    theta = _angle(c)\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/255", "solution": "import collections.abc\nfrom dataclasses import dataclass\nfrom typing import Any, Iterator, List, Tuple\n\ndef _product_with_repetition(iterable: collections.abc.Iterable, repeat: int) -> Iterator[Tuple[Any, ...]]:\n    \"\"\"Yields tuples for the Cartesian product with repetition.\"\"\"\n    pool = tuple(iterable)\n    n = len(pool)\n    if repeat == 0:\n        yield ()\n        return\n    indices = [0] * repeat\n    yield tuple(pool[i] for i in indices)\n    while True:\n        for i in reversed(range(repeat)):\n            if indices[i] == n - 1:\n                indices[i] = 0\n            else:\n                indices[i] += 1\n                break\n        else:\n            return\n        yield tuple(pool[i] for i in indices)\n\n@dataclass\nclass InputList:\n    \"\"\"Lightweight wrapper preserving ordered sequence of input elements.\"\"\"\n    elements: List[Any]\n\n    def __iter__(self) -> Iterator[Any]:\n        return iter(self.elements)\n\n@dataclass\nclass Element:\n    \"\"\"Lightweight wrapper around a single value.\"\"\"\n    value: Any\n\n@dataclass\nclass Combination:\n    \"\"\"Wrap a tuple of element values; holds the combination.\"\"\"\n    elements: Tuple[Any, ...]\n\n    def as_tuple(self) -> Tuple[Any, ...]:\n        return self.elements\n\n@dataclass\nclass OutputList:\n    \"\"\"Collector for the returned combinations list.\"\"\"\n    combinations: List[Tuple[Any, ...]]\n\n    def append(self, combo: Tuple[Any, ...]) -> None:\n        self.combinations.append(combo)\n\n    def as_list(self) -> List[Tuple[Any, ...]]:\n        return self.combinations\n\nclass CombinationGenerator:\n    \"\"\"Generate all combinations (with repetition) of elements for length n.\"\"\"\n    def __init__(self, input_list_wrapper: InputList, n: int):\n        self._input_list = input_list_wrapper\n        self._n = n\n\n    def generate(self) -> List[Tuple[Any, ...]]:\n        \"\"\"Produce and return all combinations as a list of tuples.\"\"\"\n        output_list = OutputList([])\n        for combo_tuple in _product_with_repetition(self._input_list, self._n):\n            output_list.append(combo_tuple)\n        return output_list.as_list()\n\ndef combinations_colors(input_list: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list\n    and returns a list with a tuple for each combination.\n    \"\"\"\n    input_list_wrapper = InputList(input_list)\n    generator = CombinationGenerator(input_list_wrapper, n)\n    return generator.generate()"}
{"task_id": "Mbpp/256", "solution": "import math\n\ndef validate_input(n) -> float:\n    \"\"\"\n    Validates if the input is numeric and non-negative.\n    Raises TypeError for non-numeric input and ValueError for negative input.\n    \"\"\"\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"Input must be a numeric value.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative number.\")\n    return float(n)\n\ndef is_prime(p: int) -> bool:\n    \"\"\"\n    Checks if a given integer p is a prime number.\n    Returns True if p is prime, False otherwise.\n    \"\"\"\n    if p <= 1:\n        return False\n    if p == 2 or p == 3:\n        return True\n    if p % 2 == 0 or p % 3 == 0:\n        return False\n    i = 5\n    while i * i <= p:\n        if p % i == 0 or p % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef count_Primes_nums(n: float) -> int:\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number n.\n    Raises TypeError or ValueError if input validation fails.\n    \"\"\"\n    n_valid = validate_input(n)\n\n    if n_valid < 2:\n        return 0\n\n    count = 0\n    # Iterate through integers p such that 2 <= p < n_valid\n    for p in range(2, math.floor(n_valid)):\n        if is_prime(p):\n            count += 1\n    return count"}
{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"\n    Accept two arguments and return a tuple with the inputs swapped: (b, a).\n\n    Validation: both a and b must be numeric types (int or float). If either is not an instance of int or float, raise TypeError.\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Both inputs must be numeric (int or float).\")\n    return (b, a)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a, b):\n    \"\"\"\n    Computes element-wise maxima between two tuples of 2-tuples.\n    Raises TypeError for invalid types/shape or non-comparable elements, or ValueError for mismatched lengths.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Inputs 'a' and 'b' must be tuples.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples 'a' and 'b' must have the same length.\")\n\n    result = []\n    for i in range(len(a)):\n        elem_a = a[i]\n        elem_b = b[i]\n\n        if not isinstance(elem_a, tuple) or not isinstance(elem_b, tuple):\n            raise TypeError(f\"Elements at index {i} must be tuples.\")\n        if len(elem_a) != 2 or len(elem_b) != 2:\n            raise TypeError(f\"Elements at index {i} must be 2-tuples.\")\n\n        try:\n            first_max = max(elem_a[0], elem_b[0])\n            second_max = max(elem_a[1], elem_b[1])\n        except TypeError:\n            raise TypeError(f\"Elements within the 2-tuples at index {i} must be comparable numeric types.\")\n\n        result.append((first_max, second_max))\n\n    return tuple(result)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(humanYears):\n    \"\"\"Calculates a dog's age in dog years based on a common formula.\n    The first two human years count as 10.5 dog years each; additional years count as 4 dog years.\n    \"\"\"\n    if humanYears <= 2:\n        return float(humanYears * 10.5)\n    else:\n        return float(21 + (humanYears - 2) * 4)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(list, L):\n    \"\"\"\n    Return (first_list, second_list) where first_list == list[0:L] and second_list == list[L:].\n    This implementation follows Python slicing semantics for the nominal case required by the SRS.\n    \"\"\"\n    first_list = list[0:L]\n    second_list = list[L:]\n    return (first_list, second_list)"}
{"task_id": "Mbpp/260", "solution": "class ValidationError(Exception):\n    \"\"\"Specific exception type for validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    @staticmethod\n    def validate_integer_non_negative(n) -> None:\n        \"\"\"Checks if n is a non-negative integer, raising ValidationError if not.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValidationError(\"Input 'n' must be non-negative.\")\n\nclass NewmanShanksWilliamsSequence:\n    \"\"\"Computes terms of the Newman\u2013Shanks\u2013Williams sequence iteratively.\"\"\"\n    S0 = 1\n    S1 = 1\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes S(n) using the recurrence S(n)=2*S(n-1)+S(n-2).\"\"\"\n        if n == 0:\n            return self.S0\n        if n == 1:\n            return self.S1\n\n        s_prev_prev = self.S0\n        s_prev = self.S1\n\n        for _ in range(2, n + 1):\n            s_current = 2 * s_prev + s_prev_prev\n            s_prev_prev = s_prev\n            s_prev = s_current\n        return s_prev\n\nclass NEWMAN_PRIME:\n    \"\"\"Represents a Newman-Shanks-Williams prime number.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n\nclass SEQUENCE_TERM:\n    \"\"\"Represents a term in a sequence with its index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass VALIDATION_RULE:\n    \"\"\"Metadata for a validation rule.\"\"\"\n    def __init__(self, id: int, rule: str):\n        self.id = id\n        self.rule = rule\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number, which is S(n) of the sequence.\n    Validates input and computes the sequence term S(n) using iteration.\n    \"\"\"\n    InputValidator.validate_integer_non_negative(n)\n    return NewmanShanksWilliamsSequence().compute(n)"}
{"task_id": "Mbpp/265", "solution": "def list_split(inputList, n):\n    \"\"\"\n    Splits a list into n sublists, assigning each element at index i\n    of the input list to the sublist at index (i mod n), preserving order.\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for i, item in enumerate(inputList):\n        result[i % n].append(item)\n    return result"}
{"task_id": "Mbpp/266", "solution": "class Cube:\n    def __init__(self, side_length: float) -> None:\n        \"\"\"Initialize Cube with side_length; lateral_surface initially 0.0 or computed when compute_lateral_surface() is called.\"\"\"\n        self.side_length = side_length\n        self.lateral_surface = 0.0\n\n    def compute_lateral_surface(self) -> float:\n        \"\"\"Compute lateral_surface = 4 * side_length ** 2, store in self.lateral_surface and return it.\"\"\"\n        self.lateral_surface = 4 * self.side_length ** 2\n        return self.lateral_surface\n\nclass LateralSurfaceCalculator:\n    def lateralsurface_cube(self, side: float) -> float:\n        \"\"\"Compute lateral surface area for given side and return numeric result.\"\"\"\n        cube_instance = Cube(side)\n        return cube_instance.compute_lateral_surface()\n\ndef lateralsurface_cube(side) -> float:\n    \"\"\"Library entry point required by SRS. Accepts numeric side and returns numeric lateral surface area = 4 * side^2.\"\"\"\n    calculator = LateralSurfaceCalculator()\n    return calculator.lateralsurface_cube(side)"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple\n\ndef validate_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Raises ValueError if tuple lengths differ.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\ndef validate_numeric_elements(t: tuple) -> None:\n    \"\"\"Raises TypeError if any element is not an int or float.\"\"\"\n    for element in t:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All tuple elements must be numeric (int or float).\")\n\ndef validate_no_zero_elements(t: tuple) -> None:\n    \"\"\"Raises ZeroDivisionError if any element equals 0.\"\"\"\n    for element in t:\n        if element == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n\ndef compute(a: tuple, b: tuple) -> tuple:\n    \"\"\"Performs element-wise division and returns a tuple of results.\"\"\"\n    return tuple(a[i] / b[i] for i in range(len(a)))\n\ndef division_elements(first_tuple: tuple, second_tuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples after validating inputs.\n    Raises ValueError, TypeError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n    validate_lengths(first_tuple, second_tuple)\n    validate_numeric_elements(first_tuple)\n    validate_numeric_elements(second_tuple)\n    validate_no_zero_elements(second_tuple)\n    return compute(first_tuple, second_tuple)"}
{"task_id": "Mbpp/267", "solution": "def _validate_n(n):\n    \"\"\"Validates if n is an integer and non-negative.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\ndef _generate_odd_numbers(n):\n    \"\"\"Generates a list of the first n odd natural numbers.\"\"\"\n    return [2 * i - 1 for i in range(1, n + 1)]\n\ndef _sum_of_squares(seq):\n    \"\"\"Calculates the sum of squares for elements in a sequence.\"\"\"\n    return sum(x * x for x in seq)\n\ndef square_Sum(n):\n    \"\"\"\n    Returns the sum of the squares of the first n odd natural numbers.\n    Raises TypeError if n is not an int; raises ValueError if n < 0.\n    \"\"\"\n    _validate_n(n)\n    odd_numbers = _generate_odd_numbers(n)\n    return _sum_of_squares(odd_numbers)"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n):\n    \"\"\"\n    Calculates the n'th star number using the formula S(n) = 6 * n * (n - 1) + 1.\n    Returns -1 if n is less than 1.\n    \"\"\"\n    if n < 1:\n        return -1\n    # Python handles arbitrarily large integers, so explicit overflow checks for\n    # integer limits like in C's int or long long are not necessary unless\n    # a specific maximum value is defined for this Python context.\n    result = 6 * n * (n - 1) + 1\n    return result"}
