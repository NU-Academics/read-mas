{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents an integer input and provides its decimal digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        abs_value = abs(value)\n        if abs_value == 0:\n            self.digits = [0]\n        else:\n            self.digits = [int(d) for d in str(abs_value)]\n\n    def length(self) -> int:\n        \"\"\"Return the number of digits.\"\"\"\n        return len(self.digits)\n\nclass DigitSequence:\n    \"\"\"Container for ordered decimal digits with accessor operations.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self.digits = digits\n        self.length = len(digits)\n\n    def digitAt(self, pos: int) -> int:\n        \"\"\"Return the digit at the specified 0-based position.\"\"\"\n        return self.digits[pos]\n\nclass Result:\n    \"\"\"DTO carrying boolean result and optional reason text.\"\"\"\n    def __init__(self, undulating: bool, reason: str = \"\") -> None:\n        self.undulating = undulating\n        self.reason = reason\n\nclass UndulatingChecker:\n    \"\"\"Contains decision logic: extract digits and determine alternation.\"\"\"\n    def is_undulating(self, n: Number) -> Result:\n        \"\"\"Evaluate Number n and return Result (undulating + reason).\"\"\"\n        seq = self.extract_digits(n)\n        return self.check_alternation(seq)\n\n    def extract_digits(self, n: Number) -> DigitSequence:\n        \"\"\"Produce DigitSequence with digits in MSD -> LSD order.\"\"\"\n        return DigitSequence(n.digits)\n\n    def check_alternation(self, seq: DigitSequence) -> Result:\n        \"\"\"Determine whether seq alternates between exactly two distinct digits.\"\"\"\n        length = seq.length\n\n        if length < 2:\n            return Result(False, \"length < 2\")\n\n        d0 = seq.digitAt(0)\n        d1 = seq.digitAt(1)\n\n        if d0 == d1:\n            # Fails if the first two digits are identical (e.g., 11, 112)\n            return Result(False, f\"non-alternating at position 1 (first two digits are identical)\")\n\n        # The two distinct digits must be d0 and d1\n        for i in range(2, length):\n            current_digit = seq.digitAt(i)\n            if i % 2 == 0:  # Even position (0-indexed), should match d0\n                if current_digit != d0:\n                    return Result(False, f\"non-alternating at position {i} (expected {d0}, got {current_digit})\")\n            else:  # Odd position (0-indexed), should match d1\n                if current_digit != d1:\n                    return Result(False, f\"non-alternating at position {i} (expected {d1}, got {current_digit})\")\n        \n        return Result(True, f\"alternates between {d0} and {d1}\")\n\ndef is_undulating(n) -> bool:\n    \"\"\"Checks if the given number is undulating, where digits strictly alternate between two distinct digits.\"\"\"\n    num = Number(n)\n    checker = UndulatingChecker()\n    result = checker.is_undulating(num)\n    return result.undulating"}
{"task_id": "Mbpp/94", "solution": "from typing import Sequence, Any\n\ndef _validate_item(item: Any) -> None:\n    \"\"\"\n    Validates a single item for structure and type of its second element.\n    Raises TypeError if the item is not a sequence with at least two elements,\n    or its second element is not numeric-like and comparable.\n    \"\"\"\n    try:\n        # Check if item has at least two elements. This will raise TypeError if item\n        # is not a Sized object, or IndexError if item is not indexable up to 1.\n        if len(item) < 2:\n            raise TypeError(\"Each item must be a sequence with at least two elements.\")\n        # Attempt conversion to float to validate numeric-like and comparability of item[1].\n        # This will raise TypeError if item[1] is not convertible, or ValueError for non-numeric strings.\n        _ = float(item[1])\n    except (TypeError, ValueError, IndexError) as e:\n        # Consolidate various errors from len(item), item[1], float(item[1]) into a consistent TypeError.\n        raise TypeError(\n            f\"Malformed item '{item}': Must be a sequence with at least two elements, \"\n            \"and its second element must be numeric-like and comparable.\"\n        ) from e\n\n\ndef index_minimum(list_of_tuples: Sequence[Sequence[Any]]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n\n    Raises:\n        ValueError: If the input list `list_of_tuples` is empty.\n        TypeError: If any item is not a 2+-element sequence or its second element is not comparable/numeric.\n    \"\"\"\n    if not list_of_tuples:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_value = None\n    result_key = None\n\n    for item in list_of_tuples:\n        _validate_item(item)\n\n        current_key = item[0]\n        current_comparison_value = item[1]\n\n        # Initialize with the first valid item or update if current value is strictly smaller.\n        # This implements stable-first-occurrence tie-breaking.\n        if min_value is None or current_comparison_value < min_value:\n            min_value = current_comparison_value\n            result_key = current_key\n\n    return result_key"}
{"task_id": "Mbpp/95", "solution": "def _compute_lengths(list_of_lists):\n    \"\"\"Return [len(inner) for each inner in list_of_lists].\"\"\"\n    return [len(inner) for inner in list_of_lists]\n\ndef Find_Min_Length(list_of_lists):\n    \"\"\"Compute and return minimum inner-list length.\n    Parameters:\n      list_of_lists: list of lists (precondition: each element is a list)\n    Returns:\n      int: minimum length among inner lists\n    \"\"\"\n    lengths = _compute_lengths(list_of_lists)\n    return min(lengths)\n\nassert Find_Min_Length([[1],[1,2]]) == 1"}
{"task_id": "Mbpp/97", "solution": "def flatten(nestedLists):\n    \"\"\"Flatten helper: nestedLists (list of lists) -> flat list\"\"\"\n    flat_list = []\n    for sublist in nestedLists:\n        for item in sublist:\n            flat_list.append(item)\n    return flat_list\n\ndef computeFrequencies(flatList):\n    \"\"\"Counting helper: flatList (list) -> dict mapping element -> int\"\"\"\n    frequency_dict = {}\n    for item in flatList:\n        frequency_dict[item] = frequency_dict.get(item, 0) + 1\n    return frequency_dict\n\ndef frequency_lists(nestedLists):\n    \"\"\"Entry point: nestedLists (list of lists) -> dict mapping element -> int\"\"\"\n    flat_list = flatten(nestedLists)\n    frequency_dict = computeFrequencies(flat_list)\n    return frequency_dict"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n):\n    \"\"\"\n    Finds the number of positive divisors for a given integer n.\n    Raises TypeError if n is not an integer, ValueError if n is zero.\n    \"\"\"\n    def _validate_input(val):\n        \"\"\"Validates input type and value, returning absolute value for computation.\"\"\"\n        if not isinstance(val, int):\n            raise TypeError(\"Input must be an integer.\")\n        if val == 0:\n            raise ValueError(\"Zero has an infinite number of divisors, not supported.\")\n        return abs(val)\n\n    def _count_divisors_positive(m_val):\n        \"\"\"Counts positive divisors for a positive integer m_val using O(sqrt(m)) algorithm.\"\"\"\n        count = 0\n        i = 1\n        while i * i <= m_val:\n            if m_val % i == 0:\n                if i * i == m_val:\n                    count += 1\n                else:\n                    count += 2\n            i += 1\n        return count\n\n    positive_n = _validate_input(n)\n    return _count_divisors_positive(positive_n)"}
{"task_id": "Mbpp/99", "solution": "class DecimalNumber:\n    \"\"\"Represents a decimal integer input.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if the decimal number is non-negative.\"\"\"\n        return self.value >= 0\n\nclass BinaryString:\n    \"\"\"Represents the canonical binary string result.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass DecimalToBinaryConverter:\n    \"\"\"Validates inputs and converts DecimalNumber to canonical BinaryString.\"\"\"\n\n    def validate(self, value: int) -> bool:\n        \"\"\"Returns True iff value is an integer type and non-negative.\"\"\"\n        return isinstance(value, int) and value >= 0\n\n    def convert(self, input_decimal: DecimalNumber) -> str:\n        \"\"\"Converts a DecimalNumber object to its canonical binary string representation.\"\"\"\n        decimal_value = input_decimal.value\n\n        if decimal_value == 0:\n            return \"0\"\n\n        binary_digits = []\n        while decimal_value > 0:\n            remainder = decimal_value % 2\n            binary_digits.append(str(remainder))\n            decimal_value //= 2\n        \n        return \"\".join(reversed(binary_digits))\n\n    def decimal_to_binary(self, value: int) -> str:\n        \"\"\"Converts a primitive integer value to its canonical binary string.\"\"\"\n        decimal_num = DecimalNumber(value)\n        return self.convert(decimal_num)\n\ndef decimal_to_binary(value: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary equivalent.\n    Raises ValueError for invalid inputs (non-integer or negative).\n    \"\"\"\n    converter = DecimalToBinaryConverter()\n    if not converter.validate(value):\n        raise ValueError(\"Input must be a non-negative integer.\")\n    return converter.decimal_to_binary(value)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(sequence):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Assumes the sequence is non-empty and contains only numeric values.\n    \"\"\"\n    product = 1\n    for num in sequence:\n        product *= num\n\n    length = len(sequence)\n    result = float(product) / length\n    return result"}
{"task_id": "Mbpp/102", "solution": "class InputString:\n    \"\"\"Lightweight value carrier for the incoming snake_case string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass WordSegment:\n    \"\"\"Represents an individual substring and provides capitalization behavior.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def capitalize(self) -> str:\n        \"\"\"Returns the segment text with the first character capitalized.\"\"\"\n        return self.text.capitalize()\n\nclass OutputString:\n    \"\"\"Lightweight carrier for the resulting CamelCase string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass SnakeToCamel:\n    \"\"\"Encapsulates the transformation logic from snake_case to CamelCase.\"\"\"\n    def snake_to_camel(self, input: str) -> str:\n        \"\"\"Splits the input string, capitalizes each segment, and concatenates them.\"\"\"\n        segments = input.split('_')\n        camel_segments = [WordSegment(segment).capitalize() for segment in segments]\n        result_str = \"\".join(camel_segments)\n        return result_str\n\ndef snake_to_camel(input: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a CamelCase string.\n    This function acts as the public API using internal helper classes for transformation.\n    \"\"\"\n    input_obj = InputString(input)\n    converter = SnakeToCamel()\n    return converter.snake_to_camel(input_obj.value)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer n.\n    \"\"\"\n\n    def is_palindrome(val: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        s = str(val)\n        return s == s[::-1]\n\n    def _mirror_left_to_right(s_num_str: str) -> int:\n        \"\"\"Mirrors the left half of a string to form a palindrome candidate.\"\"\"\n        length = len(s_num_str)\n        left_half = s_num_str[:(length + 1) // 2]\n        \n        # Determine the suffix to mirror\n        # If the original length is odd, the middle digit is part of the left_half and should not be mirrored again.\n        # So, the suffix to reverse is left_half excluding its last character.\n        # If the original length is even, the left_half is exactly half, and the entire left_half should be mirrored.\n        if length % 2 == 1:\n            suffix_to_mirror = left_half[:-1]\n        else:\n            suffix_to_mirror = left_half\n        \n        candidate_str = left_half + suffix_to_mirror[::-1]\n        return int(candidate_str)\n\n    def _increment_middle(s_num_str: str) -> str:\n        \"\"\"Increments the middle digit(s) of a number represented as a string, handling carries.\"\"\"\n        n_len = len(s_num_str)\n        is_odd_length = (n_len % 2 == 1)\n        \n        # Extract the left half, including the middle digit if the original number has odd length\n        left_half_str = s_num_str[: n_len // 2 + (1 if is_odd_length else 0)]\n        left_half_int = int(left_half_str)\n\n        # Increment the integer value of this left half\n        incremented_left_half_int = left_half_int + 1\n        incremented_left_half_str = str(incremented_left_half_int)\n\n        # Reconstruct the string that represents the \"left half\" of the next candidate palindrome.\n        # This takes into account potential length changes (e.g., 9 to 10).\n        return incremented_left_half_str\n\n    s = str(n)\n    \n    # Step 1: Form a candidate palindrome by mirroring the left half of n.\n    candidate = _mirror_left_to_right(s)\n\n    # If this candidate is already strictly greater than n, it's the answer.\n    # The design implies `is_palindrome` check here, though `_mirror_left_to_right` guarantees a palindrome.\n    if candidate > n:\n        return candidate\n    \n    # Step 2: If the first candidate is not strictly greater, increment the \"middle part\"\n    # of the number to generate a new base string for the next palindrome.\n    # This ensures we get a larger number and correctly handles cases like 99 -> 101.\n    s_incremented_base = _increment_middle(s)\n    \n    # Step 3: Form the final candidate palindrome from this new base string.\n    # This new candidate will always be strictly greater than n.\n    final_candidate = _mirror_left_to_right(s_incremented_base)\n    \n    return final_candidate"}
