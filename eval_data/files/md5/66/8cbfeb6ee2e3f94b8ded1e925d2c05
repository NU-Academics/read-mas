{"task_id": "Mbpp/101", "solution": "from typing import Any, List, Union\n\n# Define Error class as an Exception subtype for explicit error signaling\nclass Error(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n# Define Element class to encapsulate an element's value and its 1-based position\nclass Element:\n    def __init__(self, value: Any, position: int):\n        self.value = value\n        self.position = position\n\n# Define Array class to wrap the input list, providing length and 1-based indexed access\nclass Array:\n    def __init__(self, elements: List[Any]):\n        # Store a copy of the input list to ensure the original array is not mutated\n        self._elements = list(elements)\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get_element_by_1based_index(self, k: int) -> Element:\n        # Access elements using 0-based indexing by converting the 1-based k\n        # This method assumes k has already been validated to be within a valid range.\n        return Element(self._elements[k - 1], k)\n\n# Define Index class to encapsulate the k value and provide validation logic\nclass Index:\n    def __init__(self, k: int):\n        self._k = k\n\n    def is_valid_for(self, arr: Array) -> bool:\n        # Validate that k is an integer and falls within the 1-based inclusive range [1, array_length]\n        if not isinstance(self._k, int):\n            return False\n        return 1 <= self._k <= arr.length()\n\n# Define KthElementFunction class to orchestrate the process of finding the kth element\nclass KthElementFunction:\n    @classmethod\n    def kth_element(cls, arr_input: Union[List[Any], Array], k_input: int) -> Any:\n        # If the input array is a raw list, wrap it in an Array instance for consistent handling\n        arr_obj = Array(arr_input) if isinstance(arr_input, list) else arr_input\n\n        # Validate the k-th index using the Index class\n        index_obj = Index(k_input)\n        if not index_obj.is_valid_for(arr_obj):\n            # Raise a specific Error if k is not an integer or is out of the array's bounds, as per design\n            if not isinstance(k_input, int):\n                raise Error(\"k must be an integer.\")\n            # If k is an integer but out of range\n            raise Error(f\"k ({k_input}) is out of range for array of length {arr_obj.length()}.\")\n\n        # Retrieve the element using the validated 1-based index and return its value\n        element = arr_obj.get_element_by_1based_index(k_input)\n        return element.value\n\ndef kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    This function validates k and raises an Error if k is invalid or out of range.\n    \"\"\"\n    # Delegate the core logic to the KthElementFunction class method\n    return KthElementFunction.kth_element(array, k)"}
