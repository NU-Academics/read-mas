{"task_id": "HumanEval/67", "solution": "import re\n\nclass FruitParser:\n    \"\"\"Extracts apple and orange counts from a formatted string.\"\"\"\n    _pattern = re.compile(r\"(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges\")\n\n    def parse_apples(self, s: str) -> int:\n        match = self._pattern.match(s)\n        return int(match.group(1))\n\n    def parse_oranges(self, s: str) -> int:\n        match = self._pattern.match(s)\n        return int(match.group(2))\n\nclass FruitBasket:\n    \"\"\"Holds fruit counts and computes mangoes.\"\"\"\n    def __init__(self, apples: int, oranges: int, total_fruits: int):\n        self.apples = apples\n        self.oranges = oranges\n        self.total_fruits = total_fruits\n\n    def calculate_mangoes(self) -> int:\n        return self.total_fruits - self.apples - self.oranges\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given apple and orange counts and total fruits.\n    It parses the input string for apple and orange counts and subtracts them from the total.\n    \"\"\"\n    parser = FruitParser()\n    apples = parser.parse_apples(s)\n    oranges = parser.parse_oranges(s)\n\n    basket = FruitBasket(apples, oranges, n)\n    return basket.calculate_mangoes()"}
