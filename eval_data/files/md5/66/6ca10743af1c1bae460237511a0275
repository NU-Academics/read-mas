{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make an array palindromic.\n    It compares elements from the ends inwards, incrementing a counter for each mismatch.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "from typing import List\n\nclass StringList:\n    \"\"\"\n    Encapsulates a list of strings and provides a method to compute\n    the total number of characters across all strings.\n    \"\"\"\n    def __init__(self, strings: List[str]) -> None:\n        self.strings = strings\n\n    def total_chars(self) -> int:\n        \"\"\"Return the sum of lengths of all strings in the list.\"\"\"\n        return sum(len(s) for s in self.strings)\n\nclass TotalMatchService:\n    \"\"\"\n    Service that compares two StringList instances and returns\n    the one with the smaller total character count.\n    \"\"\"\n    def compare(self, list1: StringList, list2: StringList) -> List[str]:\n        total1 = list1.total_chars()\n        total2 = list2.total_chars()\n\n        if total1 < total2:\n            return list1.strings\n        elif total2 < total1:\n            return list2.strings\n        else:\n            # Totals are equal \u2013 return the first list\n            return list1.strings\n\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Accepts two lists of strings and returns the list\n    with fewer total characters; if totals are equal, returns the first list.\n    \"\"\"\n    service = TotalMatchService()\n    return service.compare(StringList(lst1), StringList(lst2))"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Returns the list with the smaller total character count.\n    If counts are equal, the first list is returned.\n    '''\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three prime numbers.\n    The input number 'a' is less than 100.\n    \"\"\"\n    if a < 2:\n        return False\n\n    prime_factors = []\n    temp_a = a\n    d = 2\n\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            prime_factors.append(d)\n            temp_a //= d\n        d += 1\n\n    if temp_a > 1:\n        prime_factors.append(temp_a)\n\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the product of exactly three prime numbers, counting multiplicity.\"\"\"\n    count = 0\n    n = a\n    p = 2\n    while p * p <= n:\n        while n % p == 0:\n            count += 1\n            n //= p\n        p += 1 if p == 2 else 2\n    if n > 1:\n        count += 1\n\n    return count == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, meaning n**k = x for some integer k.\n    Handles base cases for n and x, then iteratively checks powers.\n    \"\"\"\n    if n <= 1 or x <= 0:\n        return False\n    \n    if x == 1:\n        # If x is 1, it's a simple power of any n > 1 (n^0 = 1).\n        return True\n\n    current_power = n\n    while current_power < x:\n        current_power *= n\n    \n    return current_power == x"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple power of n, meaning n**k == x for some integer k.\n    Assumes x and n are positive integers based on problem constraints.\n    \"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n\n    power_val = n\n    while power_val < x:\n        power_val *= n\n    return power_val == x"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer `a` is a perfect cube.\n    '''\n    # Calculate the cube root of 'a'. Python's ** (1/3) handles both positive and negative bases correctly.\n    # Round the result to the nearest integer to account for potential floating-point inaccuracies.\n    root = round(a**(1/3))\n    \n    # Return True if the cube of the rounded root equals the original number 'a'.\n    return root * root * root == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer is a perfect cube using binary search.\n    Handles positive, negative, and zero inputs correctly.\n    '''\n    if a == 0:\n        return True\n\n    # Set initial bounds for binary search\n    # For a > 0, search between 0 and a\n    # For a < 0, search between a and 0\n    low, high = (a, 0) if a < 0 else (0, a)\n\n    while low <= high:\n        mid = (low + high) // 2\n        \n        # Calculate cube; handle potential overflow if Python int didn't support arbitrary size\n        cube = mid * mid * mid\n\n        if cube == a:\n            return True\n        elif cube < a:\n            low = mid + 1\n        else: # cube > a\n            high = mid - 1\n            \n    return False"}
