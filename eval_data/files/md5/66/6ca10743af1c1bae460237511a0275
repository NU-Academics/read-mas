{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]  # Initialize with the first element.\n\n    for num in numbers:\n        current_max = max(current_max, num)  # Update current maximum.\n        result.append(current_max)  # Append the rolling maximum.\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # Found the longest palindromic postfix\n            # The prefix before this suffix is string[:i]\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    \n    # This case should ideally not be reached for non-empty strings because\n    # a single character (the last char) is always a palindrome,\n    # and the empty string is handled at the start.\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    result = []\n    for bit_a, bit_b in zip(a, b):\n        result.append('1' if bit_a != bit_b else '0')\n    return ''.join(result)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for char_a, char_b in zip(a, b):\n        xor_res = str(int(char_a) ^ int(char_b))\n        result.append(xor_res)\n    return \"\".join(result)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\nclass StringList:\n    \"\"\"A wrapper for a list of strings.\"\"\"\n    def __init__(self, strings: List[str]):\n        self.strings = strings\n\n\nclass LongestStringFinder:\n    \"\"\"Finds the longest string from a StringList, handling ties by returning the first.\"\"\"\n    def find_longest(self, string_list: StringList) -> Optional[str]:\n        if not string_list.strings:\n            return None\n\n        longest_str = string_list.strings[0]\n        for s in string_list.strings[1:]:\n            if len(s) > len(longest_str):\n                longest_str = s\n        return longest_str\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length, or None if the list is empty.\n    \"\"\"\n    string_list_obj = StringList(strings)\n    finder = LongestStringFinder()\n    return finder.find_longest(string_list_obj)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b using the Euclidean algorithm.\n    The result is always a positive integer.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
