{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates a string of nested parentheses into a list of top-level balanced groups. \"\"\"\n    cleaned_string = paren_string.replace(' ', '')\n    result = []\n    stack = []\n    current_group_start = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if not stack:  # Start of a new top-level group\n                current_group_start = i\n            stack.append(i)\n        elif char == ')':\n            stack.pop()\n            if not stack:  # End of a top-level group\n                result.append(cleaned_string[current_group_start : i + 1])\n                current_group_start = -1 # Reset for next group\n\n    return result"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string containing multiple groups of nested parentheses into a list of top-level balanced groups.\n    Ignores any spaces in the input string.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    groups = []\n    balance = 0\n    current_group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:\n                current_group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0:\n                groups.append(cleaned_string[current_group_start_index : i + 1])\n                current_group_start_index = -1 # Reset for the next group\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    class Number:\n        def __init__(self, value: float):\n            self.value = value\n            self.integerPart = 0\n            self.decimalPart = 0.0\n\n        def truncate(self) -> float:\n            if self.value <= 0:\n                raise ValueError(\"Number must be positive.\")\n            self.integerPart = int(self.value)\n            self.decimalPart = self.value - self.integerPart\n            return self.decimalPart\n\n    num_obj = Number(number)\n    return num_obj.truncate()\n```"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
