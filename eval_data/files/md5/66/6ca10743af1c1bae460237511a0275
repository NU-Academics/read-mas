{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace blocks of 3 or more consecutive spaces with a hyphen.\n    # This rule takes precedence for longer sequences of spaces.\n    text_with_hyphens = re.sub(r' {3,}', '-', text)\n    \n    # Next, replace any remaining blocks of 1 or 2 consecutive spaces with an underscore.\n    # These are individual spaces or pairs of spaces not caught by the first rule.\n    final_text = re.sub(r' {1,2}', '_', text_with_hyphens)\n    \n    return final_text"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of n, which is the product of factorials from n down to 1.\"\"\"\n\n    def _factorial(k):\n        \"\"\"Helper to compute k! for k >= 1.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    total_product = 1\n    for i in range(n, 0, -1):\n        total_product *= _factorial(i)\n    return total_product"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    if \" \" not in text:\n        return text\n\n    result = []\n    i = 0\n    length = len(text)\n\n    while i < length:\n        if text[i] != \" \":\n            result.append(text[i])\n            i += 1\n            continue\n\n        # Count consecutive spaces\n        space_start = i\n        while i < length and text[i] == \" \":\n            i += 1\n        space_count = i - space_start\n\n        # Apply rules: 1-2 spaces -> underscores, 3+ spaces -> hyphen\n        if space_count <= 2:\n            result.append(\"_\" * space_count)\n        else:\n            result.append(\"-\")\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    # Check for exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    base, ext = file_name.split('.', 1)\n\n    # Check if base name is empty or doesn't start with an alphabet letter\n    if not base or not base[0].isalpha():\n        return 'No'\n\n    # Check if the extension is valid\n    if ext not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    # Count digits in the entire file name\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on several conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    # Condition 1: There should not be more than three digits ('0'-'9')\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return \"No\"\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return \"No\"\n\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty,\n    # and it starts with a letter from the latin alphapet ('a'-'z' and 'A'-'Z').\n    if not prefix or not prefix[0].isalpha():\n        return \"No\"\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = {'txt', 'exe', 'dll'}\n    if extension not in allowed_extensions:\n        return \"No\"\n\n    # If all conditions are met\n    return \"Yes\""}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates the sum of modified list entries based on index: square if index is a multiple of 3,\n    cube if index is a multiple of 4 but not 3, otherwise use original value.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates the sum of transformed integers based on their index.\n    Indices that are multiples of 3 result in squaring, and indices that are multiples of 4 (but not 3) result in cubing.\n    \"\"\"\n    total = 0\n    for idx, value in enumerate(lst):\n        if idx % 3 == 0:\n            total += value ** 2\n        elif idx % 4 == 0:\n            total += value ** 3\n        else:\n            total += value\n    return total"}
{"task_id": "HumanEval/143", "solution": "def _is_prime(n):\n    \"\"\"Return True if n is a prime number.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef _split_sentence(sentence):\n    \"\"\"Split a sentence into words on single spaces.\"\"\"\n    return sentence.split(' ')\n\ndef _filter_prime_words(words):\n    \"\"\"Filter words whose lengths are prime numbers.\"\"\"\n    return [w for w in words if _is_prime(len(w))]\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Extract words of prime length from a sentence.\n    \"\"\"\n    words = _split_sentence(sentence)\n    prime_words = _filter_prime_words(words)\n    return ' '.join(prime_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fractions is a whole number.\n    Each fraction is given as a string \"numerator/denominator\".\n    \"\"\"\n    x_parts = x.split('/')\n    x_num = int(x_parts[0])\n    x_den = int(x_parts[1])\n\n    n_parts = n.split('/')\n    n_num = int(n_parts[0])\n    n_den = int(n_parts[1])\n\n    product_num = x_num * n_num\n    product_den = x_den * n_den\n\n    return product_num % product_den == 0"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Checks if the product of two fractions x and n evaluates to a whole number.\n    Each fraction is a string \"numerator/denominator\".\n    \"\"\"\n    x_parts = x.split('/')\n    x_numerator = int(x_parts[0])\n    x_denominator = int(x_parts[1])\n\n    n_parts = n.split('/')\n    n_numerator = int(n_parts[0])\n    n_denominator = int(n_parts[1])\n\n    product_numerator = x_numerator * n_numerator\n    product_denominator = x_denominator * n_denominator\n\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "class Number:\n    \"\"\"Stores an integer value and its pre-computed digit sum.\"\"\"\n    def __init__(self, value: int, digit_sum: int):\n        self.value = value\n        self.digitSum = digit_sum\n\ndef _digit_sum(value: int) -> int:\n    \"\"\"Calculates the sum of digits for the absolute value of an integer.\"\"\"\n    s = str(abs(value))\n    total = 0\n    for digit_char in s:\n        total += int(digit_char)\n    return total\n\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits.\n    Preserves original relative order for items with equal digit sums.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create Number instances for each number in the input list\n    # and compute their digit sums.\n    numbered_items = []\n    for num in nums:\n        sum_digits = _digit_sum(num)\n        numbered_items.append(Number(num, sum_digits))\n\n    # Sort the list of Number instances.\n    # Python's `sorted()` is stable, preserving original relative order for ties.\n    sorted_numbered_items = sorted(numbered_items, key=lambda item: item.digitSum)\n\n    # Extract and return the original integer values from the sorted list.\n    return [item.value for item in sorted_numbered_items]"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those whose lengths are prime numbers.\n    The order of the words in the new string is preserved.\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"Checks if a given number n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers in ascending order based on the sum of their digits.\n    If digit sums are equal, the original index in the list is used for tie-breaking.\n    \"\"\"\n\n    def _digit_sum(n):\n        \"\"\"\n        Computes the sum of the absolute value of the decimal digits of an integer n.\n        \"\"\"\n        s = 0\n        n_abs = abs(n)\n        if n_abs == 0:\n            return 0\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Create a list of tuples (number, original_index) to preserve original order for tie-breaking.\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort the list using a custom key: (digit_sum_of_number, original_index).\n    # Python's sorted function is stable, but explicitly including the index\n    # ensures deterministic ordering according to the problem statement.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (_digit_sum(item[0]), item[1]))\n\n    # Extract only the numbers from the sorted tuples.\n    return [num for num, _ in sorted_indexed_nums]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both first and last digits odd.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            abs_num_str = str(abs(num))\n            first_digit = int(abs_num_str[0])\n            last_digit = int(abs_num_str[-1])\n\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in `nums` that are >10 and have odd first and last digits.\"\"\"\n    \n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for num in nums:\n        if num <= 10:\n            continue\n\n        # Extract digits from the absolute value as per design,\n        # but the >10 check means `num` itself will be positive.\n        str_num = str(num)\n        \n        first_digit = int(str_num[0])\n        last_digit = num % 10\n\n        if first_digit in odd_digits and last_digit in odd_digits:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"Return the count of triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    The array `a` is generated such that `a[i] = i * i - i + 1`.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    a = [i * i - i + 1 for i in range(1, n + 1)]\n\n    count = 0\n    for i in range(n):\n        ai = a[i]\n        for j in range(i + 1, n):\n            aj = a[j]\n            for k in range(j + 1, n):\n                if (ai + aj + a[k]) % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    The elements a[i] are defined as i * i - i + 1.\n    \"\"\"\n    def combinations_3(k):\n        \"\"\"Calculates k_C_3 (number of ways to choose 3 items from k).\"\"\"\n        if k < 3:\n            return 0\n        return k * (k - 1) * (k - 2) // 6\n\n    # Determine a[i] % 3 based on i % 3:\n    # If i % 3 == 0 or i % 3 == 1, then (i*i - i + 1) % 3 == 1.\n    # If i % 3 == 2, then (i*i - i + 1) % 3 == 0.\n\n    # Count elements a[i] where a[i] % 3 == 0 (i.e., i % 3 == 2)\n    # These indices are 2, 5, 8, ...\n    if n < 2:\n        count_mod_0 = 0\n    else:\n        # The count of numbers `j` in range [1, n] such that `j % 3 == 2`.\n        # These numbers are 2, 5, 8, ... up to n.\n        # This can be calculated as (n - 2) // 3 + 1.\n        count_mod_0 = (n - 2) // 3 + 1\n    \n    # Count elements a[i] where a[i] % 3 == 1 (i.e., i % 3 == 0 or i % 3 == 1)\n    # This is simply the total number of elements minus those with remainder 0.\n    count_mod_1 = n - count_mod_0\n\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if and only if:\n    # 1. All three a values are 0 (mod 3)  (0 + 0 + 0 = 0)\n    # 2. All three a values are 1 (mod 3)  (1 + 1 + 1 = 3 which is 0 mod 3)\n    # Other combinations (e.g., 0+0+1, 0+1+1) do not sum to 0 mod 3.\n\n    # Calculate the number of triples for each valid case\n    triples_from_mod_0 = combinations_3(count_mod_0)\n    triples_from_mod_1 = combinations_3(count_mod_1)\n\n    return triples_from_mod_0 + triples_from_mod_1\n\n```"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\n\n_PLANET_ORDER_MAP = {planet: i for i, planet in enumerate(PLANETS)}\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the Sun. Returns an empty tuple for invalid inputs.\n    \"\"\"\n    idx1 = _PLANET_ORDER_MAP.get(planet1)\n    idx2 = _PLANET_ORDER_MAP.get(planet2)\n\n    if idx1 is None or idx2 is None:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Planets strictly between the two, so exclude start_idx and end_idx\n    return tuple(PLANETS[start_idx + 1:end_idx])"}
{"task_id": "HumanEval/148", "solution": "from typing import Tuple, Dict, List\n\nclass Planet:\n    \"\"\"Represents a planet with its name and orbital order from the Sun.\"\"\"\n    def __init__(self, name: str, order: int):\n        self.name = name\n        self.order = order\n\nclass PlanetRepository:\n    \"\"\"Manages access to planet data.\"\"\"\n    _PLANETS_DATA: List[Planet] = [\n        Planet(\"Mercury\", 1),\n        Planet(\"Venus\", 2),\n        Planet(\"Earth\", 3),\n        Planet(\"Mars\", 4),\n        Planet(\"Jupiter\", 5),\n        Planet(\"Saturn\", 6),\n        Planet(\"Uranus\", 7),\n        Planet(\"Neptune\", 8),\n    ]\n    _PLANETS_BY_NAME: Dict[str, Planet] = {p.name: p for p in _PLANETS_DATA}\n\n    def find_by_name(self, name: str) -> Planet:\n        \"\"\"Finds a planet by its name.\"\"\"\n        return self._PLANETS_BY_NAME[name]\n\n    def get_all_planets(self) -> List[Planet]:\n        \"\"\"Returns all known planets, sorted by order.\"\"\"\n        return sorted(self._PLANETS_DATA, key=lambda p: p.order)\n\nclass PlanetService:\n    \"\"\"Provides business logic for planet operations.\"\"\"\n    def __init__(self, repository: PlanetRepository):\n        self._repository = repository\n\n    def get_intermediate_planets(self, planet1_name: str, planet2_name: str) -> Tuple[str, ...]:\n        \"\"\"Returns planets between two given planets, sorted by proximity to the Sun.\"\"\"\n        try:\n            planet1 = self._repository.find_by_name(planet1_name)\n            planet2 = self._repository.find_by_name(planet2_name)\n        except KeyError:\n            return ()\n\n        min_order = min(planet1.order, planet2.order)\n        max_order = max(planet1.order, planet2.order)\n\n        intermediate_planets: List[str] = []\n        for planet in self._repository.get_all_planets():\n            if min_order < planet.order < max_order:\n                intermediate_planets.append(planet.name)\n        \n        return tuple(intermediate_planets)\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the Sun.\n    \"\"\"\n    repository = PlanetRepository()\n    service = PlanetService(repository)\n    return service.get_intermediate_planets(planet1, planet2)"}
{"task_id": "HumanEval/149", "solution": "class StringList:\n    def __init__(self, strings):\n        \"\"\"Initializes StringList with a copy of the input list.\"\"\"\n        self._strings = list(strings)\n\n    def filter_odd_length(self):\n        \"\"\"Removes strings with odd lengths from the list.\"\"\"\n        self._strings = [s for s in self._strings if len(s) % 2 == 0]\n        return self\n\n    def sort_alphabetically(self):\n        \"\"\"Sorts the internal list alphabetically.\"\"\"\n        self._strings.sort()\n        return self\n\n    def sort_by_length(self):\n        \"\"\"Sorts the internal list by string length, preserving relative order for ties.\"\"\"\n        self._strings.sort(key=len)\n        return self\n\n    def to_list(self):\n        \"\"\"Returns the processed list of strings.\"\"\"\n        return self._strings\n\n\ndef sorted_list_sum(lst):\n    \"\"\"\n    Accepts a list of strings, filters out odd-length strings,\n    and returns the remaining strings sorted by length then alphabetically.\n    \"\"\"\n    string_list_processor = StringList(lst)\n\n    # Apply operations using a fluent interface. The order of sorts (alphabetical then by length)\n    # leverages Python's stable sort to achieve the desired primary and secondary sorting criteria.\n    result = string_list_processor \\\n        .filter_odd_length() \\\n        .sort_alphabetically() \\\n        .sort_by_length() \\\n        .to_list()\n\n    return result"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    class PrimeChecker:\n        \"\"\"Determines if a given number is prime using an optimized trial division.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            if num <= 1:\n                return False\n            if num <= 3:  # Covers 2 and 3\n                return True\n            if num % 2 == 0 or num % 3 == 0:\n                return False\n            \n            i = 5\n            while i * i <= num:\n                if num % i == 0 or num % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    class XorYFunction:\n        \"\"\"Orchestrates the decision logic based on primality.\"\"\"\n        def __init__(self):\n            self.prime_checker = PrimeChecker()\n\n        def evaluate(self, num: int, val_x, val_y):\n            if self.prime_checker.is_prime(num):\n                return val_x\n            return val_y\n\n    return XorYFunction().evaluate(n, x, y)"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns x if n is prime, y otherwise.\"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
