{"task_id": "HumanEval/89", "solution": "class Character:\n    def __init__(self, value: str):\n        self.value = value\n\n    def isAlphabetic(self) -> bool:\n        return 'a' <= self.value <= 'z'\n\n    def shift(self, n: int) -> str:\n        if not self.isAlphabetic():\n            return self.value\n        offset = (ord(self.value) - ord('a') + n) % 26\n        return chr(ord('a') + offset)\n\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    return ''.join(\n        Character(ch).shift(4) if Character(ch).isAlphabetic() else ch\n        for ch in s\n    )"}
{"task_id": "HumanEval/90", "solution": "class IntegerList:\n    def __init__(self, elements):\n        self.elements = elements\n\n    def get_second_smallest(self):\n        \"\"\"\n        Returns the second smallest distinct element from the list, or None.\n        \"\"\"\n        distinct_elements = sorted(list(set(self.elements)))\n        if len(distinct_elements) < 2:\n            return None\n        return distinct_elements[1]\n\ndef next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list, or None if no such element.\n    \"\"\"\n    integer_list_instance = IntegerList(lst)\n    return integer_list_instance.get_second_smallest()"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    # Split the string by sentence delimiters. re.split handles multiple delimiters.\n    # It will also create empty strings if delimiters are at the beginning/end or consecutive.\n    potential_sentences = re.split(r'[.?!]', S)\n\n    for sentence_raw in potential_sentences:\n        # Remove leading/trailing whitespace from each potential sentence.\n        stripped_sentence = sentence_raw.strip()\n\n        # Only process non-empty strings.\n        if stripped_sentence:\n            # Split the stripped sentence into words.\n            # Using split() without arguments handles multiple spaces between words.\n            words = stripped_sentence.split()\n            \n            # Check if there's at least one word and the first word is exactly \"I\".\n            if words and words[0] == \"I\":\n                boredom_count += 1\n                \n    return boredom_count"}
