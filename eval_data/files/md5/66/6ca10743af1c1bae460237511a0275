{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"\n    Compares two arrays of scores and guesses, returning an array of absolute differences.\n    Each element in the result is 0 if the guess was correct, or the absolute difference otherwise.\n    \"\"\"\n    result = []\n    for s, g in zip(game, guess):\n        if s == g:\n            result.append(0)\n        else:\n            result.append(abs(s - g))\n    return result"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares actual game scores with guesses, returning the absolute difference for each match.\n    A correct guess results in a 0, otherwise it's the absolute difference between score and guess.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, non-negative integers in a list.\n    Non-integer values and negative numbers are ignored.\n    \"\"\"\n\n    class Number:\n        \"\"\"Represents a single number with methods for validation and squaring.\"\"\"\n        def __init__(self, value):\n            self._value = value\n\n        @property\n        def value(self):\n            return self._value\n\n        def is_integer(self):\n            return isinstance(self._value, int)\n\n        def is_non_negative(self):\n            return self._value >= 0\n\n        def is_odd(self):\n            return self._value % 2 != 0\n\n        def is_qualifying(self):\n            \"\"\"Checks if the number is an odd, non-negative integer.\"\"\"\n            return self.is_integer() and self.is_non_negative() and self.is_odd()\n\n        def square(self):\n            \"\"\"Returns the square of the number's value.\"\"\"\n            return self._value * self._value\n\n    class NumberList:\n        \"\"\"A collection of Number objects, capable of filtering qualifying numbers.\"\"\"\n        def __init__(self, raw_list):\n            self._numbers = [Number(item) for item in raw_list]\n\n        def get_qualifying_numbers(self):\n            \"\"\"Yields Number objects that meet the criteria.\"\"\"\n            for num in self._numbers:\n                if num.is_qualifying():\n                    yield num\n\n    class Processor:\n        \"\"\"Processes a NumberList to calculate the sum of squares.\"\"\"\n        def process(self, number_list_instance):\n            \"\"\"Computes the sum of squares for qualifying numbers in the list.\"\"\"\n            total_sum = 0\n            for num_obj in number_list_instance.get_qualifying_numbers():\n                total_sum += num_obj.square()\n            return total_sum\n\n    if not lst:\n        return 0\n\n    number_list_instance = NumberList(lst)\n    processor_instance = Processor()\n    return processor_instance.process(number_list_instance)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on character case count and returns the class name concatenated with it.\"\"\"\n    \n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':  # Check for uppercase using character range for efficiency\n                cap_count += 1\n            elif 'a' <= char <= 'z': # Check for lowercase using character range\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n        # If current_strength == max_strength, we keep the one that came first, so no action needed.\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP-SM strength and returns it formatted with the class name.\n    Ties are broken by choosing the first extension encountered with maximum strength.\"\"\"\n\n    def _strength(name: str) -> int:\n        \"\"\"Calculates the strength of an extension name as uppercase_count - lowercase_count.\"\"\"\n        cap = sum(1 for c in name if c.isupper())\n        sm = sum(1 for c in name if c.islower())\n        return cap - sm\n\n    # Calculate strength for each extension.\n    strengths = [_strength(ext) for ext in extensions]\n\n    # Find the maximum strength value.\n    max_strength_value = max(strengths)\n\n    # Find the index of the first occurrence of the maximum strength.\n    # This handles the tie-breaking rule by selecting the earliest extension.\n    max_index = strengths.index(max_strength_value)\n\n    strongest_extension_name = extensions[max_index]\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    Returns False if either input string is empty.\n    \"\"\"\n    # Business Rules 4 & 5: If either word is empty, return False.\n    if not a or not b:\n        return False\n\n    len_b = len(b)\n    # To efficiently generate all cyclic rotations of b,\n    # concatenate b with itself and take slices of length len_b.\n    b_doubled = b + b\n\n    # Iterate through all possible starting positions for a rotation in b_doubled.\n    for i in range(len_b):\n        rotation = b_doubled[i : i + len_b]\n        # Check if the current rotation is a substring of a.\n        if rotation in a:\n            return True\n\n    # If no rotation of b was found as a substring in a, return False.\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    len_a = len(a)\n    len_b = len(b)\n\n    # If b is longer than a, no rotation of b can be a substring of a,\n    # unless b is empty. An empty string is a substring of any string.\n    if len_b > len_a and len_b > 0:\n        return False\n    \n    # Handle the case where b is an empty string\n    if len_b == 0:\n        return True # An empty string is always a substring of any string.\n\n    # Generate all cyclic rotations of b\n    b_doubled = b + b\n    \n    for i in range(len_b):\n        rotation = b_doubled[i : i + len_b]\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    abs_num = abs(num)\n    even_count = 0\n    odd_count = 0\n    for digit_char in str(abs_num):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return even_count, odd_count"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    abs_num = abs(num)\n    even_count = 0\n    odd_count = 0\n\n    if abs_num == 0:\n        even_count = 1  # The digit 0 is even.\n    else:\n        while abs_num > 0:\n            digit = abs_num % 10\n            if digit % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n            abs_num //= 10\n            \n    return even_count, odd_count"}
{"task_id": "HumanEval/156", "solution": "roman_map = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n    (1, 'I')\n]\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its Roman numeral equivalent in lowercase.\n    \"\"\"\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n    \n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    \n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # Sides must be positive to form a valid triangle\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Check triangle inequality: sum of any two sides must be greater than the third\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Sort the sides to identify the longest side (potential hypotenuse)\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2] # x <= y <= z\n\n    # Apply Pythagorean theorem: x^2 + y^2 = z^2\n    # Use a small tolerance for floating-point comparisons to avoid precision issues\n    tolerance = 1e-9\n    return abs(x**2 + y**2 - z**2) < tolerance"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Sort the sides to identify the potential hypotenuse (the longest side).\n    sides = sorted([a, b, c])\n    \n    # Check if the square of the longest side equals the sum of the squares of the other two sides.\n    return sides[2]**2 == sides[0]**2 + sides[1]**2"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    In case of a tie, the lexicographically first word is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the one that comes first in lexicographical order\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters from a list of strings.\n    In case of a tie, the lexicographically smallest word is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    def _unique_chars(word: str) -> int:\n        \"\"\"Helper to count unique characters in a string.\"\"\"\n        return len(set(word))\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: if counts are equal, choose the lexicographically smaller word.\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    Returns an array: [total eaten, remaining after meal].\n    \"\"\"\n    \n    carrots_eaten_in_this_meal = min(need, remaining)\n\n    total_eaten_carrots = number + carrots_eaten_in_this_meal\n    carrots_left_after_meal = remaining - carrots_eaten_in_this_meal\n\n    return [total_eaten_carrots, carrots_left_after_meal]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from a list of operators and a list of operands,\n    respecting standard operator precedence without using `eval`.\n    \"\"\"\n\n    # Helper function to perform arithmetic operations\n    def _apply_op(op_symbol, val1, val2):\n        if op_symbol == '+':\n            return val1 + val2\n        elif op_symbol == '-':\n            return val1 - val2\n        elif op_symbol == '*':\n            return val1 * val2\n        elif op_symbol == '//':\n            return val1 // val2\n        elif op_symbol == '**':\n            return val1 ** val2\n        # All operators are guaranteed to be in the defined set by problem constraints.\n        return 0\n\n    # Create mutable copies of operands and operators to allow in-place modification\n    working_operands = list(operand)\n    working_operators = list(operator)\n\n    # Define operator precedence (higher number means higher precedence)\n    precedence = {'**': 3, '*': 2, '//': 2, '+': 1, '-': 1}\n\n    # Process operations iteratively until only one operand (the result) remains\n    while working_operators:\n        highest_prec = -1\n        op_to_perform_idx = -1\n\n        # Find the operator with the highest precedence.\n        # If multiple operators have the same highest precedence, the leftmost one is chosen.\n        for i, op_symbol in enumerate(working_operators):\n            current_prec = precedence[op_symbol]\n            if current_prec > highest_prec:\n                highest_prec = current_prec\n                op_to_perform_idx = i\n\n        # Get the operator and its two adjacent operands\n        op_symbol = working_operators[op_to_perform_idx]\n        val1 = working_operands[op_to_perform_idx]\n        val2 = working_operands[op_to_perform_idx + 1]\n\n        # Perform the arithmetic operation\n        result = _apply_op(op_symbol, val1, val2)\n\n        # Update the lists: remove the processed operator, and replace the two operands with their result\n        working_operators.pop(op_to_perform_idx)\n        working_operands[op_to_perform_idx] = result\n        working_operands.pop(op_to_perform_idx + 1)\n\n    # The final result is the single remaining value in the working_operands list\n    return working_operands[0]"}
{"task_id": "HumanEval/159", "solution": "def eat(number: int, need: int, remaining: int) -> list[int]:\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a meal.\n    The rabbit eats either what it needs or all remaining carrots, whichever is less.\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten = number + carrots_to_eat\n    remaining_after_meal = remaining - carrots_to_eat\n    \n    return [total_eaten, remaining_after_meal]"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from lists of operators and operands,\n    then evaluates it following standard operator precedence.\n    \"\"\"\n    expression_parts = []\n    \n    # Start the expression with the first operand\n    expression_parts.append(str(operand[0]))\n    \n    # Iterate through operators, appending each operator and the subsequent operand\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n        \n    # Join all parts to form the complete expression string\n    expression_string = \" \".join(expression_parts)\n    \n    # Evaluate the expression string using Python's built-in evaluation\n    return eval(expression_string)\n```"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters if present, otherwise reverses the entire string.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters or reverses the entire string if no letters are present.\"\"\"\n    has_letters = False\n    for char_s in s:\n        if char_s.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char_s in s:\n            if char_s.isalpha():\n                result_chars.append(char_s.swapcase())\n            else:\n                result_chars.append(char_s)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
