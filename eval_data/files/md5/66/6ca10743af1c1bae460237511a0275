{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_indices = list(range(0, len(l), 2))\n    even_values = sorted(l[i] for i in even_indices)\n    result = l.copy()\n    for idx, val in zip(even_indices, even_values):\n        result[idx] = val\n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = l.copy()\n\n    even_indices = list(range(0, len(l), 2))\n    even_elements = [l[i] for i in even_indices]\n\n    even_elements.sort()\n\n    for idx, val in zip(even_indices, even_elements):\n        result[idx] = val\n\n    return result"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    class PrimeChecker:\n        \"\"\"Helper to determine if a number is prime using trial division.\"\"\"\n        def isPrime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            if number == 2:\n                return True\n            if number % 2 == 0:\n                return False\n            for i in range(3, int(math.sqrt(number)) + 1, 2):\n                if number % i == 0:\n                    return False\n            return True\n\n    class FibonacciSequence:\n        \"\"\"Helper to generate Fibonacci numbers and find the nth prime one.\"\"\"\n        def getNthPrime(self, n_target: int) -> int:\n            prime_checker = PrimeChecker()\n            a, b = 1, 1  # Start with F(1)=1, F(2)=1\n            prime_fib_count = 0\n\n            while True:\n                current_fib = b\n                \n                # Check primality only for numbers greater than 1\n                if current_fib > 1 and prime_checker.isPrime(current_fib):\n                    prime_fib_count += 1\n                    if prime_fib_count == n_target:\n                        return current_fib\n                \n                # Generate the next Fibonacci number\n                a, b = b, a + b\n\n    fib_seq_generator = FibonacciSequence()\n    return fib_seq_generator.getNthPrime(n)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    class PrimeChecker:\n        \"\"\"Determines if a given number is prime using trial division.\"\"\"\n        def is_prime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            if number == 2:\n                return True\n            if number % 2 == 0:\n                return False\n            i = 3\n            while i * i <= number:\n                if number % i == 0:\n                    return False\n                i += 2\n            return True\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers by index (F_0=0, F_1=1).\"\"\"\n        def get_fibonacci(self, index: int) -> int:\n            if index == 0:\n                return 0\n            a, b = 0, 1\n            for _ in range(index - 1):\n                a, b = b, a + b\n            return b\n\n    class PrimeFibCalculator:\n        \"\"\"Orchestrates the finding of the n-th prime Fibonacci number.\"\"\"\n        def __init__(self):\n            self._fib_generator = FibonacciGenerator()\n            self._prime_checker = PrimeChecker()\n\n        def get_prime_fib(self, target_n: int) -> int:\n            found_count = 0\n            fib_index = 0 \n\n            while True:\n                fib_index += 1\n                fib_number = self._fib_generator.get_fibonacci(fib_index)\n                \n                if self._prime_checker.is_prime(fib_number):\n                    found_count += 1\n                    if found_count == target_n:\n                        return fib_number\n\n    calculator = PrimeFibC