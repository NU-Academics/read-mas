{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there is a valid subsequence of brackets where at least one bracket is nested.\n    \"\"\"\n\n    def is_valid(s):\n        \"\"\"Checks if a string of brackets forms a correctly matched sequence.\"\"\"\n        stack = []\n        for char in s:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    def has_nested_pattern(s):\n        \"\"\"\n        Determines if a valid bracket string contains a '[[ ' pattern, indicating nesting.\n        \"\"\"\n        for i in range(len(s) - 1):\n            if s[i] == '[' and s[i+1] == '[':\n                return True\n        return False\n\n    n = len(string)\n    \n    # Iterate through all possible subsequences using bit manipulation.\n    # Each integer 'i' from 0 to 2^n - 1 represents a unique subsequence.\n    # The j-th bit of 'i' determines if string[j] is included in the subsequence.\n    for i in range(1 << n):\n        current_subsequence_chars = []\n        for j in range(n):\n            if (i >> j) & 1:  # If the j-th bit is set, include string[j]\n                current_subsequence_chars.append(string[j])\n        \n        subsequence = \"\".join(current_subsequence_chars)\n        \n        # Only process non-empty subsequences for validity and nesting checks.\n        if subsequence:\n            if is_valid(subsequence):\n                if has_nested_pattern(subsequence):\n                    return True\n    \n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List\n\ndef sum_squares(lst: List[float]) -> int:\n    \"\"\"Returns the sum of squared numbers after rounding each to the upper integer.\n    \"\"\"\n    squared_sum = 0\n    for number in lst:\n        ceil_val = math.ceil(number)\n        squared_sum += ceil_val ** 2\n    return squared_sum"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    \n    # The function checks for the presence of a subsequence that forms '[[]]'.\n    # This pattern indicates a valid, nested bracket sequence.\n    # We use a state machine to track the discovery of the four required characters\n    # in their correct sequential order within the string.\n    \n    # Status 0: Looking for the first '['\n    # Status 1: Found the first '[', now looking for the second '['\n    # Status 2: Found the second '[', now looking for the first ']'\n    # Status 3: Found the first ']', now looking for the second ']'\n    \n    status = 0\n    \n    for char in string:\n        if char == '[':\n            if status == 0:\n                status = 1\n            elif status == 1:\n                status = 2\n            # If status is 2 or 3 and we encounter another '[', it means we are\n            # encountering an opening bracket for an even deeper potential nesting\n            # (e.g., '[[[' or '[[[]'). The current status of finding '[[' or '[[ ]'\n            # remains, as we are still looking for the subsequent closing brackets\n            # to complete the '[[ ] ]' pattern.\n        elif char == ']':\n            if status == 2:\n                status = 3\n            elif status == 3:\n                # We have found the sequence '[', '[', ']', ']' in order.\n                # This constitutes a valid nested subsequence.\n                return True\n    \n    # If the loop completes without finding the full '[[]]' subsequence,\n    # then no such nested subsequence exists.\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\n\nclass NumberElement:\n    \"\"\"Represents a single number, its rounded-up integer, and its square.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n        self.rounded_value = self._round_to_ceiling(value)\n        self.squared_value = self._square(self.rounded_value)\n\n    def _round_to_ceiling(self, val: float) -> int:\n        \"\"\"Rounds a float to the smallest integer greater than or equal to val.\"\"\"\n        return math.ceil(val)\n\n    def _square(self, val: int) -> int:\n        \"\"\"Squares an integer.\"\"\"\n        return val * val\n\nclass NumberList:\n    \"\"\"Represents a list of NumberElement objects.\"\"\"\n    def __init__(self, raw_numbers: list[float]):\n        self.id = id(self) # A unique identifier for this list instance.\n        self.elements = [NumberElement(num) for num in raw_numbers]\n\nclass SumSquaresCalculator:\n    \"\"\"Calculates the sum of squared, ceiling-rounded numbers from a NumberList.\"\"\"\n    def calculate(self, number_list: NumberList) -> int:\n        \"\"\"Sums the squared values of all elements in the NumberList.\"\"\"\n        total_sum = 0\n        for element in number_list.elements:\n            total_sum += element.squared_value\n        return total_sum\n\ndef sum_squares(lst: list[float]) -> int:\n    \"\"\"\n    Calculates the sum of squared, ceiling-rounded numbers in a list.\n    It delegates the core logic to domain entities as per design.\n    \"\"\"\n    number_list = NumberList(lst)\n    calculator = SumSquaresCalculator()\n    return calculator.calculate(number_list)"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a word.\n    \"\"\"\n    if not txt:\n        return False\n\n    # Remove trailing spaces as per design (FR5, and examples)\n    txt_stripped = txt.rstrip()\n\n    if not txt_stripped:\n        return False\n\n    last_char = txt_stripped[-1]\n\n    # Check FR1: if the last character is alphabetical\n    if not last_char.isalpha():\n        return False\n\n    # Check FR2: if the last character is not part of a word\n    # It's not part of a word if it's the only character or\n    # if the preceding character is a space.\n    if len(txt_stripped) == 1:\n        return True\n    \n    return txt_stripped[-2] == ' '"}
