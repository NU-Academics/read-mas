{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Generates the Collatz sequence for n, collects all odd numbers, and returns them sorted.\n    The sequence stops when it reaches 1.\n    \"\"\"\n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n            current = 3 * current + 1\n        else:\n            current = current // 2\n    \n    odd_numbers.add(1) # 1 is always part of the sequence and is odd.\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    def _generate_collatz_sequence(start_value):\n        \"\"\"Generates the Collatz sequence for a given start value.\"\"\"\n        sequence = []\n        current = start_value\n        while current != 1:\n            sequence.append(current)\n            if current % 2 == 0:\n                current //= 2\n            else:\n                current = 3 * current + 1\n        sequence.append(1)\n        return sequence\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    \n    odd_numbers = [num for num in collatz_sequence if num % 2 != 0]\n    \n    # The requirement specifies the returned list sorted in increasing order.\n    odd_numbers.sort() \n    \n    return odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string against the mm-dd-yyyy format and specific day-month rules.\"\"\"\n    if not date:\n        return False\n\n    if len(date) != 10:\n        return False\n\n    if date[2] != '-' or date[5] != '-':\n        return False\n\n    try:\n        month_str = date[0:2]\n        day_str = date[3:5]\n        year_str = date[6:10]\n\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # year is not directly validated by rules, but must be numeric\n    except ValueError:\n        return False\n\n    # Rule 3: Months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate day range based on month\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (1 <= day <= 31):\n            return False\n    elif month in [4, 6, 9, 11]:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2:\n        if not (1 <= day <= 29): # No leap year consideration based on rules\n            return False\n    else:\n        # This case should ideally not be reached if month is already validated\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a given date string against specific rules and format.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    # This implies a fixed length of 10 characters and hyphens at specific positions.\n    if len(date) != 10:\n        return False\n    if date[2] != '-' or date[5] != '-':\n        return False\n\n    # Extract month, day, year strings based on the mm-dd-yyyy format.\n    month_str = date[0:2]\n    day_str = date[3:5]\n    year_str = date[6:10]\n\n    # Attempt to convert parts to integers. If conversion fails, format is invalid.\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # The year itself is not validated beyond being an integer.\n    except ValueError:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: The number of days validation based on the month.\n    # Maximum days for each month category as per the rules.\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31, # Months with 31 days\n        4: 30, 6: 30, 9: 30, 11: 30,                         # Months with 30 days\n        2: 29                                              # February (max 29 days, no leap year consideration specified)\n    }\n\n    max_days = days_in_month.get(month)\n\n    # This check ensures the month is one of the keys in days_in_month, which it will be\n    # if the previous '1 <= month <= 12' check passed.\n    if max_days is None:\n        return False\n\n    if not (1 <= day <= max_days):\n        return False\n\n    # If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    odd_count += 1\n        return odd_count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by commas if no whitespace,\n    or counts odd-ordered lowercase letters otherwise.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count"}
{"task_id": "HumanEval/126", "solution": "class Number:\n        def __init__(self, value):\n            self.value = value\n\n    class NumberList:\n        def __init__(self, elements_raw):\n            self.elements = [Number(x) for x in elements_raw]\n\n        def is_sorted(self):\n            if not self.elements:\n                return True\n            for i in range(len(self.elements) - 1):\n                if self.elements[i].value > self.elements[i+1].value:\n                    return False\n            return True\n\n        def has_duplicates_within_limit(self):\n            # Allows at most 2 occurrences of any number (1 duplicate).\n            counts = {}\n            for num_obj in self.elements:\n                value = num_obj.value\n                counts[value] = counts.get(value, 0) + 1\n                if counts[value] > 2:\n                    return False\n            return True\n\n    number_list_instance = NumberList(lst)\n    return number_list_instance.is_sorted() and number_list_instance.has_duplicates_within_limit()"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of numbers is sorted in ascending order with at most two occurrences\n    of any single number.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    for i, num in enumerate(lst):\n        # Update and check counts for duplicates\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n        # Check for ascending order (non-decreasing)\n        if i > 0 and num < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Return True if n is a prime number (>1).\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # Check if intervals intersect\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    intersection_length = intersection_end - intersection_start + 1\n\n    # Check if the length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "class Interval:\n    \"\"\"Represents a closed interval with a start and end.\"\"\"\n    def __init__(self, start, end):\n        self.start = start\n        self.end = end\n\ndef is_prime(number):\n    \"\"\"Checks if a given number is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\"\"\"\n\n    # Create Interval objects from input tuples\n    int_obj1 = Interval(interval1[0], interval1[1])\n    int_obj2 = Interval(interval2[0], interval2[1])\n\n    # Calculate the start and end points of the intersection\n    max_start = max(int_obj1.start, int_obj2.start)\n    min_end = min(int_obj1.end, int_obj2.end)\n\n    # If max_start is greater than min_end, the intervals do not intersect\n    if max_start > min_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    intersection_length = min_end - max_start\n\n    # Check if the intersection length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "from typing import List, Optional\n\ndef prod_signs(arr: List[int]) -> Optional[int]:\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs of numbers in an array.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n        else:\n            sign = 0\n        product_signs *= sign\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        if num == 0:\n            product_of_signs = 0\n            break\n        sign = 1 if num > 0 else -1\n        product_of_signs *= sign\n        sum_of_magnitudes += abs(num)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in the grid.\n    Uses DFS with pruning to explore paths starting from every cell.\n    \"\"\"\n    N = len(grid)\n    min_found_path = None  # Stores the lexicographically smallest path found so far\n\n    # Define possible moves: (row_change, col_change) for Up, Down, Left, Right\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def solve_dfs(r, c, current_path_values):\n        nonlocal min_found_path\n\n        # Add the current cell's value to the path\n        current_path_values.append(grid[r][c])\n\n        # Base case: if the path has reached the desired length k\n        if len(current_path_values) == k:\n            # If this is the first path or it's lexicographically smaller\n            if min_found_path is None or current_path_values < min_found_path:\n                min_found_path = list(current_path_values)  # Store a copy of the path\n            current_path_values.pop()  # Backtrack\n            return\n\n        # Pruning: If a better path is already found, and the current path's prefix\n        # is already lexicographically greater than the best path's prefix of the same length,\n        # then this branch cannot lead to a better path.\n        if min_found_path is not None:\n            current_len = len(current_path_values)\n            if current_path_values[:current_len] > min_found_path[:current_len]:\n                current_path_values.pop()  # Backtrack\n                return\n\n        # Recursively explore neighbors\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n\n            # Check if the neighbor is within grid boundaries\n            if 0 <= nr < N and 0 <= nc < N:\n                solve_dfs(nr, nc, current_path_values)\n\n        current_path_values.pop()  # Backtrack: remove current cell's value\n\n    # Start DFS from every cell in the grid\n    for r_start in range(N):\n        for c_start in range(N):\n            solve_dfs(r_start, c_start, [])\n\n    return min_found_path"}
{"task_id": "HumanEval/129", "solution": "import collections\n\nclass Cell:\n    \"\"\"Represents a cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row, col, value):\n        self.row = row\n        self.col = col\n        self.value = value\n\nclass Grid:\n    \"\"\"Manages the grid structure and provides access to cells.\"\"\"\n    def __init__(self, cells):\n        self.N = len(cells)\n        self.cells = cells # 2D array of Cell objects\n\n    @staticmethod\n    def from_list(grid_list):\n        \"\"\"Converts a 2D list of integers to a Grid object of Cells.\"\"\"\n        N = len(grid_list)\n        cells = [[None for _ in range(N)] for _ in range(N)]\n        for r in range(N):\n            for c in range(N):\n                cells[r][c] = Cell(r, c, grid_list[r][c])\n        return Grid(cells)\n\nclass Path:\n    \"\"\"Encapsulates a sequence of Cell objects representing a path.\"\"\"\n    def __init__(self, sequence):\n        self.sequence = list(sequence) # Store as a copy to prevent external modification\n        self.length = len(sequence)\n\n    def values(self):\n        \"\"\"Returns the ordered list of values on the cells in the path.\"\"\"\n        return [cell.value for cell in self.sequence]\n\nclass Validator:\n    \"\"\"Validates the input grid's properties.\"\"\"\n    def validate_grid(self, grid_obj):\n        \"\"\"Checks if the grid dimensions and cell values are valid.\"\"\"\n        N = grid_obj.N\n        # Problem guarantees N >= 2 and values [1, N*N] unique, so validation would always pass if inputs adhere.\n        # This implementation follows the design for completeness, even if redundant due to problem guarantees.\n        \n        expected_values = set(range(1, N * N + 1))\n        actual_values = set()\n        for r in range(N):\n            for c in range(N):\n                val = grid_obj.cells[r][c].value\n                if not (1 <= val <= N * N) or val in actual_values:\n                    return False\n                actual_values.add(val)\n        return actual_values == expected_values\n\nclass PathGenerator:\n    \"\"\"Generates all admissible paths of a given length k.\"\"\"\n    def generate(self, grid_obj, k):\n        \"\"\"Generates all possible paths of length k in the grid.\"\"\"\n        N = grid_obj.N\n        all_paths = []\n\n        # Directions for neighbors (up, down, left, right)\n        dr = [-1, 1, 0, 0]\n        dc = [0, 0, -1, 1]\n\n        def dfs(current_path_cells, current_r, current_c, depth):\n            \"\"\"Recursive helper for Depth-First Search to find paths.\"\"\"\n            if depth == k:\n                all_paths.append(Path(current_path_cells))\n                return\n\n            # Explore neighbors\n            for i in range(4):\n                next_r, next_c = current_r + dr[i], current_c + dc[i]\n\n                # Check bounds\n                if 0 <= next_r < N and 0 <= next_c < N:\n                    next_cell = grid_obj.cells[next_r][next_c]\n                    current_path_cells.append(next_cell)\n                    dfs(current_path_cells, next_r, next_c, depth + 1)\n                    current_path_cells.pop() # Backtrack\n\n        # Start DFS from every cell in the grid\n        for r in range(N):\n            for c in range(N):\n                start_cell = grid_obj.cells[r][c]\n                dfs([start_cell], r, c, 1) # depth starts at 1 (first cell is visited)\n        \n        return all_paths\n\nclass LexicographicComparator:\n    \"\"\"Compares two paths lexicographically.\"\"\"\n    def compare(self, path_a, path_b):\n        \"\"\"Returns -1 if path_a < path_b, 1 if path_a > path_b, 0 if equal.\"\"\"\n        values_a = path_a.values()\n        values_b = path_b.values()\n        \n        # Paths are guaranteed to be of the same length k\n        for i in range(len(values_a)):\n            if values_a[i] < values_b[i]:\n                return -1\n            elif values_a[i] > values_b[i]:\n                return 1\n        return 0 # Paths are identical\n\nclass MinPathFinder:\n    \"\"\"Orchestrates the process of finding the minimum path.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.path_generator = PathGenerator()\n        self.comparator = LexicographicComparator()\n\n    def find_min_path(self, grid_obj, k):\n        \"\"\"Finds the lexicographically smallest path of length k.\"\"\"\n        # Per problem statement guarantees, the grid is valid, so validation is not strictly required here.\n        # if not self.validator.validate_grid(grid_obj):\n        #     # In a production system, an exception would be raised here.\n        #     pass\n\n        all_paths = self.path_generator.generate(grid_obj, k)\n\n        # The problem guarantees a unique answer and valid input, so all_paths will not be empty.\n        min_path = all_paths[0]\n        for i in range(1, len(all_paths)):\n            if self.comparator.compare(all_paths[i], min_path) < 0:\n                min_path = all_paths[i]\n        \n        return min_path\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid and an integer k, finds the minimum path of length k.\n    Uses helper classes for grid representation, path generation, and comparison.\n    \"\"\"\n    grid_obj = Grid.from_list(grid)\n    \n    finder = MinPathFinder()\n    min_path_obj = finder.find_min_path(grid_obj, k)\n    \n    return min_path_obj.values()"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"\n    Computes the Tribonacci sequence up to the n-th term using an iterative approach.\n\n    Returns a list of the first n + 1 numbers of the Tribonacci sequence.\n    \"\"\"\n    # The recurrence for odd n: tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1).\n    # This requires knowing tri(n + 1) to compute tri(n).\n    # Thus, our DP array needs to store values up to index n + 1.\n    dp = [0] * (n + 2) \n\n    # Base cases and initial values:\n    # tri(0) is derived from the even rule: 1 + 0/2 = 1\n    dp[0] = 1\n    # tri(1) is explicitly given as 3\n    if n >= 1:\n        dp[1] = 3\n\n    # First pass: Compute all even-indexed terms (which are directly calculable)\n    # and fill the dp array up to n + 1 as some odd terms depend on tri(k+1).\n    for k in range(2, n + 2): \n        if k % 2 == 0:  # k is even\n            dp[k] = 1 + k // 2\n\n    # Second pass: Compute all odd-indexed terms from 3 to n using their recurrence.\n    # At this stage, all required even terms (like tri(k-1) and tri(k+1))\n    # and smaller odd terms (like tri(k-2)) are already available in dp.\n    for k in range(3, n + 1): \n        if k % 2 != 0:  # k is odd\n            dp[k] = dp[k - 1] + dp[k - 2] + dp[k + 1]\n\n    # Return the first n + 1 numbers of the sequence, i.e., tri(0) to tri(n).\n    return dp[0 : n + 1]\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    It builds the sequence iteratively using a two-pass approach to handle look-ahead dependencies.\n    \"\"\"\n    # Initialize dp array with size n + 2 to hold indices 0 to n+1.\n    # This extra space is needed because tri(i) for odd i depends on tri(i+1).\n    dp = [0] * (n + 2)\n\n    # Base cases inferred from problem statement and examples.\n    # tri(0) = 1 (from example output for tri(3) = [1, 3, 2, 8])\n    dp[0] = 1\n    # tri(1) = 3 (explicitly given in problem definition)\n    if n >= 1:\n        dp[1] = 3\n\n    # First pass: Calculate all even-indexed terms directly.\n    # Even terms (tri(i) for i > 0) do not depend on future terms.\n    # We iterate up to n + 1 because an odd 'n' will require tri(n+1)\n    # for its calculation.\n    for i in range(2, n + 2):\n        if i % 2 == 0:  # If i is even\n            dp[i] = 1 + i // 2\n\n    # Second pass: Calculate all odd-indexed terms from 3 up to n.\n    # These terms depend on tri(i-1), tri(i-2), and tri(i+1).\n    # At this point, tri(i-1) (even), tri(i-2) (odd or even, if odd it was already computed)\n    # and crucially, tri(i+1) (which is even) are all available from previous steps.\n    for i in range(3, n + 1):  # Iterate from 3 up to n (inclusive)\n        if i % 2 != 0:  # If i is odd\n            dp[i] = dp[i-1] + dp[i-2] + dp[i+1]\n            \n    # The final result is the slice from index 0 to n (inclusive).\n    return dp[0:n+1]\n```"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odd = 1\n    found_odd_digit = False\n\n    # Iterate through digits of n using string conversion for simplicity.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odd *= digit\n            found_odd_digit = True\n\n    if found_odd_digit:\n        return product_of_odd\n    else:\n        return 0"}
