{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, preserving case.\n    \"\"\"\n    encoded_chars = []\n    vowel_map = {\n        'a': 'c', 'A': 'C',\n        'e': 'g', 'E': 'G',\n        'i': 'k', 'I': 'K',\n        'o': 'q', 'O': 'Q',\n        'u': 'w', 'U': 'W'\n    }\n\n    for char in message:\n        swapped_char = char.swapcase()\n        if swapped_char in vowel_map:\n            encoded_chars.append(vowel_map[swapped_char])\n        else:\n            encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping the case of all letters and replacing vowels\n    with the letter two places ahead in the alphabet, then swapping its case.\n    \"\"\"\n    encoded_chars = []\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    for char in message:\n        if 'a' <= char.lower() <= 'z':  # Check if it's an alphabet character\n            lower_char = char.lower()\n            \n            if lower_char in VOWELS:\n                # Calculate replacement character 2 places ahead in the alphabet\n                # e.g., 'a' (ASCII 97) -> 'c' (ASCII 99)\n                replacement_char_code = ord(lower_char) + 2\n                replacement_char = chr(replacement_char_code)\n                \n                # Then swap the case of this replacement character\n                final_char = replacement_char.swapcase()\n            else:  # It's a consonant\n                # Just swap its case\n                final_char = char.swapcase()\n        else:\n            # Not an alphabet character (e.g., space), preserve it as is\n            final_char = char\n        \n        encoded_chars.append(final_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\n    This function assumes at least one prime number will be found in the input list.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the decimal digits of a non-negative integer.\"\"\"\n        s = 0\n        current_num = n\n        while current_num > 0:\n            s += current_num % 10\n            current_num //= 10\n        return s\n\n    largest_prime_found = -1\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime_found:\n                largest_prime_found = num\n    \n    return sum_digits(largest_prime_found)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime using trial division up to sqrt(n).\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        digit_sum = 0\n        for digit_char in str(largest_prime):\n            digit_sum += int(digit_char)\n        return digit_sum"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are strings and uniformly cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries, non-string keys, or mixed-case string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n        \n        # Optimization: If we've already determined that keys are neither uniformly lower nor upper,\n        # we can exit early. This happens if a key is mixed case (like \"Name\")\n        # or if we've seen both a lowercase and an uppercase key.\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys are strings in lower case or all keys are strings in upper case.\n    Returns False if the dictionary is empty or contains non-string, mixed-case, or non-alphabetic keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    has_lower_keys = False\n    has_upper_keys = False\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        is_key_lower = key.islower()\n        is_key_upper = key.isupper()\n\n        # A key must be either entirely lower case or entirely upper case.\n        # This condition catches mixed-case strings (\"aB\"), empty strings (\"\"),\n        # and strings with no cased characters (\"123\", \"!!!\").\n        if not is_key_lower and not is_key_upper:\n            return False\n        \n        if is_key_lower:\n            has_lower_keys = True\n        if is_key_upper:\n            has_upper_keys = True\n\n    # If both lower and upper case keys were found, the dictionary keys are mixed.\n    # Otherwise (only lower or only upper), they are uniformly cased.\n    return not (has_lower_keys and has_upper_keys)"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef count_up_to(n):\n    \"\"\"\n    Returns a list of prime numbers strictly less than n.\n    Uses a trial division method for primality testing.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    primes = []\n    for candidate in range(2, n):\n        is_prime = True\n        # Check for divisibility from 2 up to the square root of the candidate\n        for divisor in range(2, int(math.sqrt(candidate)) + 1):\n            if candidate % divisor == 0:\n                is_prime = False\n                break\n        if is_prime:\n            primes.append(candidate)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Generates a list of prime numbers less than n using the Sieve of Eratosthenes.\"\"\"\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    primes = [i for i, prime_status in enumerate(is_prime) if prime_status]\n    return primes"}
