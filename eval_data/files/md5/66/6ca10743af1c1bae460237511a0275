{"task_id": "HumanEval/88", "solution": "class Array:\n    \"\"\"Encapsulates an array of integers with utility methods.\"\"\"\n    def __init__(self, elements):\n        self.elements = list(elements)\n\n    def firstElement(self):\n        return self.elements[0]\n\n    def lastElement(self):\n        return self.elements[-1]\n\n    def sumFirstLast(self):\n        return self.firstElement() + self.lastElement()\n\n    def copy(self):\n        \"\"\"Returns a new Array object that is a shallow copy of this Array's elements.\"\"\"\n        return Array(self.elements[:])\n    \n    def get_elements_list(self):\n        \"\"\"Returns a copy of the internal list of elements.\"\"\"\n        return self.elements[:]\n\nclass Sorter:\n    \"\"\"Sorts an Array object based on the parity of its first and last element sum.\"\"\"\n    def sort(self, array_obj_original):\n        # Create a mutable copy of the Array object for sorting\n        array_obj_to_sort = array_obj_original.copy()\n        \n        sum_val = array_obj_to_sort.sumFirstLast()\n        is_even = (sum_val % 2 == 0)\n        \n        if is_even:\n            array_obj_to_sort.elements.sort(reverse=True) # Sort descending\n        else:\n            array_obj_to_sort.elements.sort(reverse=False) # Sort ascending\n\n        return array_obj_to_sort\n\ndef sort_array(array):\n    if len(array) < 2:\n        return array[:]\n\n    input_array_domain_obj = Array(array)\n    sorter_instance = Sorter()\n    \n    sorted_array_domain_obj = sorter_instance.sort(input_array_domain_obj)\n    \n    return sorted_array_domain_obj.get_elements_list()"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Ascending if odd, descending if even; handles empty or single-element arrays.\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)  # Return a copy for consistency\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    is_ascending = (sum_first_last % 2 != 0)\n    \n    return sorted(array, reverse=not is_ascending)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each alphabetic character down by four places,\n    preserving case and leaving non-alphabetic characters unchanged.\"\"\"\n    result = []\n    shift = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_char = chr(((ord(char) - ord('a') + shift) % 26) + ord('a'))\n            result.append(shifted_char)\n        elif 'A' <= char <= 'Z':\n            shifted_char = chr(((ord(char) - ord('A') + shift) % 26) + ord('A'))\n            result.append(shifted_char)\n        else:\n            result.append(char)\n    return \"\".join(result)"}
