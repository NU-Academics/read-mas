{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    result_list = l[:]  # Create a shallow copy of the input list\n    even_indexed_elements = []\n\n    # Extract elements at even indices\n    for i in range(0, len(l), 2):\n        even_indexed_elements.append(l[i])\n\n    # Sort the extracted even-indexed elements\n    even_indexed_elements.sort()\n\n    # Place the sorted elements back into the even indices of the result_list\n    even_idx_buffer_ptr = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_indexed_elements[even_idx_buffer_ptr]\n        even_idx_buffer_ptr += 1\n\n    return result_list"}
{"task_id": "HumanEval/39", "solution": "import math\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    def _is_perfect_square(num: int) -> bool:\n        \"\"\"Checks if a given integer is a perfect square.\"\"\"\n        if num < 0:\n            return False\n        s = int(math.isqrt(num))\n        return s * s == num\n\n    def _is_fibonacci(num: int) -> bool:\n        \"\"\"Determines if a given integer is a Fibonacci number using a mathematical property.\"\"\"\n        return _is_perfect_square(5 * num * num + 4) or _is_perfect_square(5 * num * num - 4)\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def _generate_fibonacci_sequence():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = _generate_fibonacci_sequence()\n\n    while True:\n        fib_num = next(fib_gen)\n        if fib_num <= 1: # 0 and 1 are not prime\n            continue\n\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups, each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group if it has 3 elements.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    n = len(l)\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n\n    return False"}
