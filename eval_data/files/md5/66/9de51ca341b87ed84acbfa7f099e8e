{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisors from 3 up to the square root of n, incrementing by 2\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    unique_elements = list(set(l))\n    unique_elements.sort()\n    return unique_elements"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    result_list = list(l) # Create a shallow copy to avoid modifying the original list.\n    \n    indices_to_sort = []\n    values_to_sort = []\n\n    # Collect elements at indices divisible by three.\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(l[i])\n            \n    # Sort the collected values.\n    values_to_sort.sort()\n\n    # Place the sorted values back into their original divisible-by-three indices.\n    for j in range(len(indices_to_sort)):\n        original_index = indices_to_sort[j]\n        sorted_value = values_to_sort[j]\n        result_list[original_index] = sorted_value\n        \n    return result_list"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    tolerance = 1e-7\n    max_iterations = 1000\n\n    # Step 1: Find an initial interval [a, b] where poly(a) and poly(b) have opposite signs.\n    # This loop expands the interval exponentially. Due to the properties of odd-degree\n    # polynomials and the problem's guarantees, such an interval will always be found.\n    a = -1.0\n    b = 1.0\n    search_limit = 1e6 # Practical limit to prevent excessively large bounds\n\n    pa = poly(xs, a)\n    pb = poly(xs, b)\n\n    # Expand interval until a sign change is found or an exact root at a or b is hit.\n    # The `while` condition `abs(b) < search_limit` prevents unbounded growth.\n    # The problem guarantees a solution, implying an interval will be found within reasonable bounds.\n    while pa * pb >= 0 and abs(b) < search_limit:\n        if abs(pa) < tolerance:\n            return a\n        if abs(pb) < tolerance:\n            return b\n        a *= 2\n        b *= 2\n        pa = poly(xs, a)\n        pb = poly(xs, b)\n\n    # Step 2: Perform bisection within the found interval [a, b].\n    # At this point, it's guaranteed that poly(a) * poly(b) < 0 (or an exact root was returned).\n    for _ in range(max_iterations):\n        mid = (a + b) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        # Determine which half contains the root and update the interval bounds.\n        if pa * p_mid < 0:  # Root is in [a, mid]\n            b = mid\n            pb = p_mid\n        else:  # Root is in [mid, b]\n            a = mid\n            pa = p_mid\n\n    # Return the midpoint of the final interval as the approximate root.\n    return (a + b) / 2"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val"}
