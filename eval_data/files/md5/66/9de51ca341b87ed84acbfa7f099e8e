al - 2) // 6\n\n    # Case 2: Count triples where all three a[x] have a remainder of 1.\n    if c1_remainder_val >= 3:\n        total_triples += c1_remainder_val * (c1_remainder_val - 1) * (c1_remainder_val - 2) // 6\n\n    return total_triples"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    def _calculate_strength(extension_name):\n        \"\"\"Calculates the strength of an extension name based on uppercase and lowercase letter counts.\"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        return cap_count - sm_count\n\n    if not extensions:\n        # If the list of extensions is empty, return only the class name.\n        return class_name\n\n    # Initialize with the first extension as the strongest found so far.\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_strength(strongest_extension_name)\n\n    # Iterate through the remaining extensions to find the one with the highest strength.\n    for i in range(1, len(extensions)):\n        current_extension = extensions[i]\n        current_strength = _calculate_strength(current_extension)\n\n        # Update if a strictly stronger extension is found.\n        # For ties, the one encountered first (already stored) is preferred.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares two arrays of scores and guesses, returning an array of differences.\n    0 if the guess was correct, absolute difference otherwise.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length\")\n\n    differences = []\n    for i in range(len(game)):\n        actual_score = game[i]\n        guessed_score = guess[i]\n        \n        if actual_score == guessed_score:\n            differences.append(0)\n        else:\n            differences.append(abs(actual_score - guessed_score))\n            \n    return differences"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only even-length strings,\n    then sorts them by length and alphabetically for ties.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Process the absolute value of the number as per design.\n    abs_num = abs(num)\n\n    # Handle the special case where the number is 0.\n    if abs_num == 0:\n        return (1, 0)\n\n    # Iterate through each digit of the number.\n    while abs_num > 0:\n        digit = abs_num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        abs_num //= 10\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    running_sum = 0\n    for item in lst:\n        if isinstance(item, int) and item >= 0 and item % 2 != 0:\n            running_sum += (item * item)\n    return running_sum"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all cyclic rotations of a given string.\"\"\"\n        if not s:\n            return [\"\"]\n        rotations = []\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.append(rotated_s)\n        return rotations\n\n    def _is_substring(main_string: str, sub_string: str) -> bool:\n        \"\"\"Checks if a given substring exists within a main string.\"\"\"\n        return sub_string in main_string\n\n    if not b:\n        return True\n    \n    # Generate all rotations of b\n    b_rotations = _generate_rotations(b)\n\n    # Check if any rotation of b is a substring in a\n    for rotation in b_rotations:\n        if _is_substring(a, rotation):\n            return True\n            \n    return False"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numeral = []\n    temp_num = number\n\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    \n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters, returns the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    best_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            # If counts are equal, choose the one that comes first lexicographically\n            if word < best_word:\n                best_word = word\n    \n    return best_word"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n\n    # Helper function for robust floating-point comparison.\n    def are_nearly_equal(val1, val2, epsilon=1e-9):\n        \"\"\"Compares two floating-point numbers for approximate equality.\"\"\"\n        return abs(val1 - val2) < epsilon\n\n    # Helper class to encapsulate triangle properties and logic.\n    class Triangle:\n        \"\"\"Represents a triangle with three side lengths and provides validation and right-angle checks.\"\"\"\n\n        def __init__(self, side1, side2, side3):\n            self._side_a = float(side1)\n            self._side_b = float(side2)\n            self._side_c = float(side3)\n\n        def _is_positive(self):\n            \"\"\"Checks if all side lengths are positive.\"\"\"\n            return self._side_a > 0 and self._side_b > 0 and self._side_c > 0\n\n        def _satisfies_triangle_inequality(self):\n            \"\"\"Checks if the sides satisfy the triangle inequality theorem.\"\"\"\n            return (self._side_a + self._side_b > self._side_c and\n                    self._side_a + self._side_c > self._side_b and\n                    self._side_b + self._side_c > self._side_a)\n\n        def is_valid(self):\n            \"\"\"Determines if the side lengths form a valid triangle.\"\"\"\n            return self._is_positive() and self._satisfies_triangle_inequality()\n\n        def is_right_angled(self):\n            \"\"\"Checks if the triangle is right-angled using the Pythagorean theorem.\"\"\"\n            sides = sorted([self._side_a, self._side_b, self._side_c])\n            # The square of the two shorter sides must sum to the square of the longest side.\n            return are_nearly_equal(sides[0]**2 + sides[1]**2, sides[2]**2)\n\n    triangle = Triangle(a, b, c)\n\n    if not triangle.is_valid():\n        return False\n    \n    return triangle.is_right_angled()"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of eaten carrots and the number of carrots left in stock after a meal.\n    Returns an array of [total eaten carrots, carrots left].\n    \"\"\"\n    carrots_eaten_in_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_in_meal\n    carrots_left_in_stock = remaining - carrots_eaten_in_meal\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n\n    if not text:\n        return None\n    \n    # Encode the text to bytes before hashing\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    expression_parts = []\n    # Interleave operands and operators to form the algebraic expression string.\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    # Append the last operand to complete the expression.\n    expression_parts.append(str(operand[len(operator)]))\n\n    expression_string = \" \".join(expression_parts)\n    \n    # Evaluate the constructed expression string and return the result.\n    return eval(expression_string)"}
{"task_id": "HumanEval/161", "solution": "def _has_letters(s):\n    \"\"\"Checks if a string contains any alphabetic letters.\"\"\"\n    return any(char.isalpha() for char in s)\ndef _reverse_case(char):\n    \"\"\"Reverses the case of a single character if it's a letter, otherwise returns it unchanged.\"\"\"\n    if char.islower():\n        return char.upper()\n    elif char.isupper():\n        return char.lower()\n    return char\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    if not _has_letters(s):\n        return s[::-1] # Reverse the entire string\n    else:\n        transformed_chars = [_reverse_case(char) for char in s]\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    \n    result = []\n    for i in range(start, end + 1):\n        # Check if the number is a single-digit (0-9) and is even.\n        if 0 <= i <= 9 and i % 2 == 0:\n            result.append(i)\n            \n    return result"}
