{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of the input string is a prime number.\n    Uses a helper function `is_prime` to determine primality.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"\n        Determines if a given integer n is a prime number.\n        Handles edge cases for 0, 1, and 2, and efficiently checks divisors.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        # Check for divisors up to the square root of n\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Check if a number is prime using an efficient O(\u221an) algorithm.\n    Handles edge cases for numbers less than 2, 2, 3, and even numbers.\"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_length(string):\n    \"\"\"Checks if the length of the input string is a prime number.\n    Returns True if the length is prime, False otherwise.\"\"\"\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: list) -> list:\n    \"\"\"Converts a list of numerical GPA values to corresponding letter grades.\n    The conversion follows a standardized 13-level grading scale.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else: # gpa == 0.0\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values to corresponding letter grades.\n    Uses a predefined 13-tier grading scale from A+ to E, handling exact thresholds.\n    \"\"\"\n\n    def _convert_single_gpa(gpa):\n        \"\"\"Helper to convert a single GPA value to its letter grade based on the defined scale.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        elif gpa == 0.0:\n            return 'E'\n\n    result_grades = []\n    for gpa_value in grades:\n        result_grades.append(_convert_single_gpa(gpa_value))\n    \n    return result_grades\n```"}
{"task_id": "HumanEval/83", "solution": "class InputValidator:\n    \"\"\"Validates input parameter n according to specification.\"\"\"\n\n    def validate_positive_integer(self, n: int) -> bool:\n        \"\"\"Checks if n is a positive integer. (Validation skipped per prompt critical constraint).\"\"\"\n        return True\n\n    def check_range(self, n: int) -> bool:\n        \"\"\"Checks if n is within computational limits. (Validation skipped per prompt critical constraint).\"\"\"\n        return True\n\nclass DigitCounter:\n    \"\"\"Calculates counts of n-digit numbers with specific digit patterns.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def calculate_starting_with_1(self) -> int:\n        \"\"\"Returns the count of n-digit numbers starting with 1.\"\"\"\n        if self.n == 1:\n            return 1\n        return 10**(self.n - 1)\n\n    def calculate_ending_with_1(self) -> int:\n        \"\"\"Returns the count of n-digit numbers ending with 1.\"\"\"\n        if self.n == 1:\n            return 1\n        # For n > 1, the first digit can be any of 1-9 (9 options),\n        # the middle n-2 digits can be any of 0-9 (10 options each),\n        # and the last digit is fixed as 1.\n        return 9 * (10**(self.n - 2))\n\n    def calculate_both_start_end_with_1(self) -> int:\n        \"\"\"Returns the count of n-digit numbers both starting and ending with 1.\"\"\"\n        if self.n <= 2:\n            return 1 # For n=1, it's '1'. For n=2, it's '11'.\n        # For n > 2, the first and last digits are fixed as 1.\n        # The n-2 middle digits can be any of 0-9 (10 options each).\n        return 10**(self.n - 2)\n\nclass MathematicalCalculation:\n    \"\"\"Applies the inclusion-exclusion principle for the final count.\"\"\"\n    def __init__(self, starting: int, ending: int, both: int):\n        self.starting_count = starting\n        self.ending_count = ending\n        self.both_count = both\n\n    def calculate_total(self) -> int:\n        \"\"\"Calculates the total count using inclusion-exclusion.\"\"\"\n        return self.starting_count + self.ending_count - self.both_count\n\n    def validate_inputs(self) -> bool:\n        \"\"\"Validates component counts are non-negative. (Validation skipped per prompt critical constraint).\"\"\"\n        return True\n\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    validator = InputValidator()\n    # Input validation is skipped as per the critical requirement to trust caller's inputs.\n    validator.validate_positive_integer(n) \n\n    counter = DigitCounter(n)\n    starting_count = counter.calculate_starting_with_1()\n    ending_count = counter.calculate_ending_with_1()\n    both_count = counter.calculate_both_start_end_with_1()\n\n    calculator = MathematicalCalculation(starting_count, ending_count, both_count)\n    # Input validation is skipped as per the critical requirement to trust caller's inputs.\n    calculator.validate_inputs() \n    total_count = calculator.calculate_total()\n\n    return total_count"}
{"task_id": "HumanEval/83", "solution": "```python\nclass Result:\n    \"\"\"Encapsulates calculation results and validation status.\"\"\"\n    def __init__(self, count: int, is_valid: bool) -> None:\n        self.__count = count\n        self.__is_valid = is_valid\n\n    def get_count(self) -> int:\n        \"\"\"Retrieves the calculated count value.\"\"\"\n        return self.__count\n\n    def is_result_valid(self) -> bool:\n        \"\"\"Checks the validation status of the result.\"\"\"\n        return self.__is_valid\n\nclass InputValidator:\n    \"\"\"Validates input parameters against business constraints.\"\"\"\n    def validate_positive_integer(self, n: int) -> bool:\n        \"\"\"Checks if n is a positive integer. Assumes valid input per critical requirements.\"\"\"\n        return True\n\n    def check_range(self, n: int) -> bool:\n        \"\"\"Verifies n is within acceptable range. Assumes valid input per critical requirements.\"\"\"\n        return True\n\nclass MathematicalCalculator:\n    \"\"\"Performs mathematical computations for digit counting.\"\"\"\n    def calculate_power_of_10(self, exp: int) -> int:\n        \"\"\"Computes 10 to the power of exp.\"\"\"\n        return 10**exp\n\n    def calculate_digit_combinations(self, digits: int) -> int:\n        \"\"\"Calculates valid digit combinations, representing 10^digits.\"\"\"\n        return 10**digits\n\nclass DigitCounter:\n    \"\"\"Coordinates mathematical calculations and applies inclusion-exclusion principle.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.__n = n\n        self.__validator = InputValidator()\n        self.__calculator = MathematicalCalculator()\n        # Input validation is performed, but no exceptions are raised per critical requirements.\n        self.__validator.validate_positive_integer(n)\n        self.__validator.check_range(n)\n\n    def calculate_starting_with_1(self) -> int:\n        \"\"\"Counts n-digit numbers that start with 1.\"\"\"\n        # The first digit is 1, remaining n-1 digits can be 0-9.\n        return self.__calculator.calculate_power_of_10(self.__n - 1)\n\n    def calculate_ending_with_1(self) -> int:\n        \"\"\"Counts n-digit numbers that end with 1.\"\"\"\n        if self.__n == 1:\n            return 1\n        # The last digit is 1. The first digit can be 1-9 (9 choices),\n        # and n-2 middle digits can be 0-9.\n        return 9 * self.__calculator.calculate_power_of_10(self.__n - 2)\n\n    def calculate_starting_and_ending_with_1(self) -> int:\n        \"\"\"Counts n-digit numbers that start and end with 1.\"\"\"\n        if self.__n == 1:\n            return 1\n        # The first and last digits are 1. The n-2 middle digits can be 0-9.\n        return self.__calculator.calculate_power_of_10(self.__n - 2)\n\n    def get_result(self) -> int:\n        \"\"\"Applies inclusion-exclusion principle and returns the total count.\"\"\"\n        count_starts_1 = self.calculate_starting_with_1()\n        count_ends_1 = self.calculate_ending_with_1()\n        count_starts_and_ends_1 = self.calculate_starting_and_ending_with_1()\n\n        total_count = count_starts_1 + count_ends_1 - count_starts_and_ends_1\n        # The result is always valid as per critical requirements.\n        result_obj = Result(total_count, True)\n        return result_obj.get_count()\n\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    digit_counter = DigitCounter(n)\n    return digit_counter.get_result()\n```"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 \u2264 N \u2264 10000.\n    \"\"\"\n\n    def _validate_input(n: int) -> bool:\n        \"\"\"Validate input is within acceptable range. Raises ValueError if invalid.\"\"\"\n        if not (0 <= n <= 10000):\n            raise ValueError(\"Input out of range: 0 <= N <= 10000 is required.\")\n        return True\n\n    def _calculate_digit_sum(n: int) -> int:\n        \"\"\"Calculate the sum of all digits in the input number. It converts the number to a string to process each digit.\"\"\"\n        total_sum = 0\n        for digit_char in str(n):\n            total_sum += int(digit_char)\n        return total_sum\n\n    def _convert_to_binary(n: int) -> str:\n        \"\"\"Convert an integer to its binary string representation. The '0b' prefix is removed from the result.\"\"\"\n        return bin(n)[2:]\n\n    _validate_input(N)\n    digit_sum = _calculate_digit_sum(N)\n    binary_representation = _convert_to_binary(digit_sum)\n    return binary_representation"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"\n    Calculates the sum of digits for N and converts the result to its binary representation.\n    The input N is a positive integer within the range 0 to 10000.\n    \"\"\"\n    digit_sum = 0\n    # Calculate the sum of digits\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n\n    # Convert the digit sum to binary and return as a string without the \"0b\" prefix\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. Add the even elements that are at odd indices.\n    This function processes integer lists to calculate the sum of even elements at odd indices.\n    \"\"\"\n\n    def _validate_input(lst: list):\n        \"\"\"Validates the input list; always returns True due to strict requirements.\"\"\"\n        # Per CRITICAL REQUIREMENTS, assume inputs are valid and do not raise exceptions.\n        return True\n\n    def _is_odd_index(index: int):\n        \"\"\"Determines if a given zero-based index is odd.\"\"\"\n        return index % 2 != 0\n\n    def _is_even(number: int):\n        \"\"\"Determines if a number is even.\"\"\"\n        return number % 2 == 0\n\n    def _get_odd_indexed_evens(lst: list):\n        \"\"\"Extracts even numbers located at odd indices from the list.\"\"\"\n        result = []\n        for index, element in enumerate(lst):\n            if _is_odd_index(index) and _is_even(element):\n                result.append(element)\n        return result\n\n    def _calculate_sum(numbers: list):\n        \"\"\"Calculates the sum of numbers in a list.\"\"\"\n        total = 0\n        for num in numbers:\n            total += num\n        return total\n\n    # Main logic of the add function, following the specified pipeline.\n    _validate_input(lst) \n    odd_indexed_evens = _get_odd_indexed_evens(lst)\n    final_sum = _calculate_sum(odd_indexed_evens)\n    return final_sum\n```"}
{"task_id": "HumanEval/85", "solution": "```python\n# src/sum_calculator.py\nclass SumCalculator:\n    \"\"\"Calculates the sum of a list of integers.\"\"\"\n    def sum_elements(self, numbers: list[int]) -> int:\n        \"\"\"Returns the sum of all elements in the given list.\"\"\"\n        return sum(numbers)\n\n# src/even_filter.py\nclass EvenFilter:\n    \"\"\"Filters even numbers from a list.\"\"\"\n    def is_even(self, number: int) -> bool:\n        \"\"\"Determines if a given number is even.\"\"\"\n        return number % 2 == 0\n\n    def filter_even_numbers(self, elements: list[int]) -> list[int]:\n        \"\"\"Returns only the even numbers from the input list.\"\"\"\n        return [num for num in elements if self.is_even(num)]\n\n# src/index_filter.py\nclass IndexFilter:\n    \"\"\"Identifies elements at odd indices.\"\"\"\n    def is_odd_index(self, index: int) -> bool:\n        \"\"\"Determines if a given index is odd (1, 3, 5, etc. using 0-based indexing).\"\"\"\n        return index % 2 != 0\n\n    def get_odd_indexed_elements(self, lst: list[int]) -> list[int]:\n        \"\"\"Returns elements from the list that are located at odd indices.\"\"\"\n        return [element for index, element in enumerate(lst) if self.is_odd_index(index)]\n\n# src/math_utils.py\nfrom sum_calculator import SumCalculator\n\nclass MathUtils:\n    \"\"\"Provides mathematical utility operations.\"\"\"\n    def calculate_final_sum(self, numbers: list[int]) -> int:\n        \"\"\"Delegates to SumCalculator to compute the sum of numbers.\"\"\"\n        calculator = SumCalculator()\n        return calculator.sum_elements(numbers)\n\n# src/list_processor.py\nfrom index_filter import IndexFilter\nfrom even_filter import EvenFilter\n\nclass ListProcessor:\n    \"\"\"Coordinates the list processing pipeline.\"\"\"\n    def validate_input(self, lst: list[int]) -> bool:\n        \"\"\"Validates input constraints, always returning True as per design.\"\"\"\n        # No validation logic is implemented here as per critical requirements.\n        return True\n\n    def process_list(self, lst: list[int]) -> list[int]:\n        \"\"\"Orchestrates filtering elements at odd indices and then filtering even numbers.\"\"\"\n        self.validate_input(lst)\n        \n        index_filter = IndexFilter()\n        odd_indexed_elements = index_filter.get_odd_indexed_elements(lst)\n        \n        even_filter = EvenFilter()\n        filtered_even_numbers = even_filter.filter_even_numbers(odd_indexed_elements)\n        \n        return filtered_even_numbers\n\n# src/add_function.py\nfrom list_processor import ListProcessor\nfrom math_utils import MathUtils\n\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. Add the even elements that are at odd indices.\"\"\"\n    processor = ListProcessor()\n    math_utils = MathUtils()\n\n    filtered_elements = processor.process_list(lst)\n    return math_utils.calculate_final_sum(filtered_elements)\n```"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char == ' ':\n            if current_word_chars:\n                result_parts.append(\"\".join(sorted(current_word_chars)))\n                current_word_chars = []\n            result_parts.append(char)\n        else:\n            current_word_chars.append(char)\n\n    if current_word_chars:\n        result_parts.append(\"\".join(sorted(current_word_chars)))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def _find_coordinates(lst, x):\n    \"\"\"\n    Searches for all occurrences of x in the nested list and collects their coordinates.\n    Returns an unsorted list of (row, column) tuples.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((row_idx, col_idx))\n    return found_coordinates\n\ndef _sort_coordinates(coordinates):\n    \"\"\"\n    Sorts coordinates primarily by row ascending, and secondarily by column descending.\n    Uses a custom key for sorting.\n    \"\"\"\n    return sorted(coordinates, key=lambda coord: (coord[0], -coord[1]))\n\ndef get_row(lst, x):\n    \"\"\"\n    Search for integer x in 2D nested list and return sorted coordinates.\n    This function orchestrates finding and sorting coordinates.\n    \"\"\"\n    if not lst:\n        return []\n\n    unsorted_coords = _find_coordinates(lst, x)\n    sorted_coords = _sort_coordinates(unsorted_coords)\n    return sorted_coords"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version where characters within each word are sorted by ASCII value.\n    Preserves original word order and spacing.\n    \"\"\"\n\n    def _sort_word_characters(word_to_sort):\n        \"\"\"Sorts characters within a single word by their ASCII value.\"\"\"\n        return \"\".join(sorted(word_to_sort))\n\n    def _extract_words_and_spaces(input_string):\n        \"\"\"\n        Splits the input string into words and records the original positions of all spaces.\n        Returns a tuple containing: (list of words, list of space indices, original string length).\n        \"\"\"\n        words = []\n        space_indices = []\n        current_word_chars = []\n\n        for i, char in enumerate(input_string):\n            if char == ' ':\n                space_indices.append(i)\n                if current_word_chars:\n                    words.append(\"\".join(current_word_chars))\n                    current_word_chars = []\n            else:\n                current_word_chars.append(char)\n        \n        if current_word_chars: # Add the last word if it exists\n            words.append(\"\".join(current_word_chars))\n            \n        return (words, space_indices, len(input_string))\n\n    def _reconstruct_string(sorted_words, space_positions, original_length):\n        \"\"\"\n        Reconstructs the final string using processed words and the original space positions.\n        \"\"\"\n        # Create a list of characters, initially empty placeholders\n        result_chars = [''] * original_length\n        \n        # Place spaces back into their original positions\n        for pos in space_positions:\n            result_chars[pos] = ' '\n            \n        char_idx_in_result = 0\n        \n        # Iterate through the result_chars to fill in sorted word characters,\n        # skipping over positions already filled by spaces.\n        for sorted_word in sorted_words:\n            for char in sorted_word:\n                # Find the next available slot that is not a space\n                while char_idx_in_result < original_length and result_chars[char_idx_in_result] != '':\n                    char_idx_in_result += 1\n                \n                result_chars[char_idx_in_result] = char\n                char_idx_in_result += 1\n        \n        return \"\".join(result_chars)\n\n    # Main orchestration logic\n    words, space_indices, original_length = _extract_words_and_spaces(s)\n    \n    sorted_words = [_sort_word_characters(word) for word in words]\n    \n    return _reconstruct_string(sorted_words, space_indices, original_length)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Searches for an integer x in a 2D nested list with variable row lengths.\n    Returns a list of (row, column) coordinates, sorted by row ascending, then column descending.\n    \"\"\"\n    found_coordinates = []\n\n    # Iterate through rows and columns to find the target integer.\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort the coordinates: primarily by row (ascending), secondarily by column (descending).\n    sorted_coordinates = sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))\n\n    return sorted_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    # Handle empty array\n    if not array:\n        return []\n\n    # Handle single element array\n    if len(array) == 1:\n        return array.copy()\n\n    # Calculate sum of first and last elements\n    sum_first_last = array[0] + array[-1]\n\n    # Create copy and sort based on sum parity\n    if sum_first_last % 2 == 1:  # Odd sum - ascending order\n        return sorted(array.copy())\n    else:  # Even sum - descending order\n        return sorted(array.copy(), reverse=True)"}
{"task_id": "HumanEval/88", "solution": "import abc\n\nclass SortingStrategy(abc.ABC):\n    \"\"\"Abstract base class for sorting strategies.\"\"\"\n    @abc.abstractmethod\n    def sort(self, array: list[int]) -> list[int]:\n        \"\"\"Sorts a list of integers and returns a new sorted list.\"\"\"\n        pass\n\nclass AscendingSorter(SortingStrategy):\n    \"\"\"Implements ascending order sorting.\"\"\"\n    def sort(self, array: list[int]) -> list[int]:\n        \"\"\"Sorts the given array in ascending order.\"\"\"\n        return sorted(array)\n\nclass DescendingSorter(SortingStrategy):\n    \"\"\"Implements descending order sorting.\"\"\"\n    def sort(self, array: list[int]) -> list[int]:\n        \"\"\"Sorts the given array in descending order.\"\"\"\n        return sorted(array, reverse=True)\n\nclass SumCalculator:\n    \"\"\"Calculates the sum of first and last array elements.\"\"\"\n    def calculate_sum(self, array: list[int]) -> int:\n        \"\"\"Returns the sum of the first and last elements.\"\"\"\n        return array[0] + array[-1]\n\nclass ArrayProcessor:\n    \"\"\"Orchestrates sorting based on sum of first and last elements.\"\"\"\n    def __init__(self):\n        self._sum_calculator = SumCalculator()\n        self._ascending_sorter = AscendingSorter()\n        self._descending_sorter = DescendingSorter()\n\n    def process(self, array: list[int]) -> list[int]:\n        \"\"\"Processes the array, handling edge cases and applying the correct sorting strategy.\"\"\"\n        if not array:\n            return self._handle_empty_array()\n        if len(array) == 1:\n            return self._handle_single_element(array)\n        return self._handle_multi_element(array)\n\n    def _handle_empty_array(self) -> list[int]:\n        \"\"\"Returns an empty list for an empty input.\"\"\"\n        return []\n\n    def _handle_single_element(self, array: list[int]) -> list[int]:\n        \"\"\"Returns a copy of the single-element array.\"\"\"\n        return list(array)\n\n    def _handle_multi_element(self, array: list[int]) -> list[int]:\n        \"\"\"Calculates sum, selects sorter, and returns the sorted copy.\"\"\"\n        first_last_sum = self._sum_calculator.calculate_sum(array)\n        \n        if first_last_sum % 2 != 0:\n            sorter = self._ascending_sorter\n        else:\n            sorter = self._descending_sorter\n        \n        return sorter.sort(array)\n\ndef sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    processor = ArrayProcessor()\n    return processor.process(array)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each lowercase letter down by 4 positions.\n    Handles alphabet wraparound for letters beyond 'z', maintaining other characters.\"\"\"\n    \n    encrypted_chars = []\n    shift_amount = 4\n    \n    for char in s:\n        if 'a' <= char <= 'z':\n            relative_pos = ord(char) - ord('a')\n            shifted_pos = (relative_pos + shift_amount) % 26\n            encrypted_char = chr(ord('a') + shifted_pos)\n            encrypted_chars.append(encrypted_char)\n        else:\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each lowercase letter down by 4 positions with wraparound.\n    Non-lowercase letters remain unchanged.\"\"\"\n\n    SHIFT_VALUE = 4\n    ALPHABET_SIZE = 26\n    ORD_A = ord('a')\n    ORD_Z = ord('z')\n\n    def _calculate_position(char_code):\n        \"\"\"Calculates the 0-indexed position of a lowercase letter.\"\"\"\n        return char_code - ORD_A\n\n    def _wrap_position(position):\n        \"\"\"Applies wraparound logic for alphabet positions.\"\"\"\n        return position % ALPHABET_SIZE\n\n    def _shift_character(char):\n        \"\"\"Shifts a single lowercase character by SHIFT_VALUE with wraparound.\"\"\"\n        char_code = ord(char)\n        original_pos = _calculate_position(char_code)\n        shifted_pos = original_pos + SHIFT_VALUE\n        wrapped_pos = _wrap_position(shifted_pos)\n        return chr(wrapped_pos + ORD_A)\n\n    encrypted_chars = []\n    for char in s:\n        if ORD_A <= ord(char) <= ORD_Z:\n            encrypted_chars.append(_shift_character(char))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
