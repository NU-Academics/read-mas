{"task_id": "HumanEval/63", "solution": "def memoize(func):\n    \"\"\"Decorator for caching function results to avoid recomputing.\"\"\"\n    cache = {}\n    def wrapper(*args):\n        if args in cache:\n            return cache[args]\n        result = func(*args)\n        cache[args] = result\n        return result\n    return wrapper\n\n@memoize\ndef fibfib(n: int) -> int:\n    \"\"\"Calculates the n-th FibFib number using its recursive definition.\"\"\"\n    if n == 0 or n == 1:\n        return 0\n    elif n == 2:\n        return 1\n    else:\n        return fibfib(n-1) + fibfib(n-2) + fibfib(n-3)"}
{"task_id": "HumanEval/63", "solution": "def _validate_input(n: int) -> bool:\n    \"\"\"Validate input parameter. Per requirements, assumes valid input.\"\"\"\n    return True\n\ndef _compute_base_case(n: int) -> int:\n    \"\"\"Handle base cases for FibFib sequence.\"\"\"\n    if n == 0 or n == 1:\n        return 0\n    elif n == 2:\n        return 1\n    # This function is only called for n <= 2 by fibfib.\n    return -1 # Should not be reached\n\ndef _compute_recursive(n: int) -> int:\n    \"\"\"Compute FibFib value using iterative dynamic programming.\"\"\"\n    fib_values = [0] * (n + 1)\n    fib_values[0] = 0\n    fib_values[1] = 0\n    fib_values[2] = 1\n\n    for i in range(3, n + 1):\n        fib_values[i] = fib_values[i-1] + fib_values[i-2] + fib_values[i-3]\n\n    return fib_values[n]\n\ndef fibfib(n: int) -> int:\n    \"\"\"Calculate the n-th element of the FibFib sequence.\"\"\"\n    _validate_input(n)\n\n    if n <= 2:\n        return _compute_base_case(n)\n    else:\n        return _compute_recursive(n)"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of integer x right by shift positions.\n    If shift exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        # Reverse digits if shift is greater than the number of digits\n        return s_x[::-1]\n    else:\n        # Perform circular right shift\n        actual_shift = shift % num_digits\n        return s_x[-actual_shift:] + s_x[:-actual_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values for uppercase characters in the input string.\n    Ignores lowercase characters and non-alphabetic symbols, returning 0 for empty strings.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def _extract_digits(num: int) -> str:\n    \"\"\"Extract digits from integer as string.\"\"\"\n    return str(num)\n\ndef _count_digits(num: int) -> int:\n    \"\"\"Count number of digits in integer.\"\"\"\n    return len(str(num))\n\ndef _perform_shift(digits: str, shift: int) -> str:\n    \"\"\"Perform circular right shift on digit string.\"\"\"\n    n = len(digits)\n    effective_shift = shift % n\n    return digits[-effective_shift:] + digits[:-effective_shift]\n\ndef _reverse_digits(digits: str) -> str:\n    \"\"\"Reverse the order of digits in string.\"\"\"\n    return digits[::-1]\n\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    # Input Validation Layer: Handles negative numbers by converting to absolute value.\n    # No further input validation or error handling is performed based on critical requirements.\n    abs_x = abs(x)\n\n    # Digit Processing Layer: Extracts digits, determines operation, and manipulates them.\n    digits_str = _extract_digits(abs_x)\n    digit_count = _count_digits(abs_x)\n\n    processed_digits_str: str\n    if shift > digit_count:\n        processed_digits_str = _reverse_digits(digits_str)\n    else:\n        processed_digits_str = _perform_shift(digits_str, shift)\n\n    # Output Formatting Layer: Returns the processed digits as a string.\n    return processed_digits_str"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels ('a', 'e', 'i', 'o', 'u') in a string.\n    'y' is counted as a vowel only when it is the last character of the word.\"\"\"\n    vowels = \"aeiou\"\n    count = 0\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/64", "solution": "```python\n# target/vowels_count.py\ndef vowels_count(s):\n    \"\"\"Counts vowels in a string, with 'y' counting as a vowel only at the end.\"\"\"\n    vowels = \"aeiouAEIOU\"\n    count = 0\n    for i, char in enumerate(s):\n        if char in vowels:\n            count += 1\n        elif char.lower() == 'y' and i == len(s) - 1:\n            count += 1\n    return count\n\n```\n```python\n# config/test_config.py\nclass TestConfig:\n    \"\"\"Configuration settings for the test suite.\"\"\"\n    PERFORMANCE_TIME_LIMIT_MS = 100\n    COVERAGE_THRESHOLD = 100.0  # Percentage\n    TARGET_MODULE_PATH = 'target.vowels_count'\n    REPORTS_DIR = 'reports'\n    TEST_RESULTS_FILE = 'test_results.txt'\n    PERFORMANCE_REPORT_FILE = 'performance_report.txt'\n    COVERAGE_REPORT_HTML_FILE = 'coverage_report.html'\n    COVERAGE_REPORT_CONSOLE_FILE = 'coverage_report_console.txt'\n```\n```python\n# src/__init__.py\n\"\"\"Initialization for the src package.\"\"\"\n# This file can be empty.\n```\n```python\n# src/result_validator.py\nfrom dataclasses import dataclass\nfrom typing import List, Dict, Any\n\nclass TestResult:\n    \"\"\"Represents the outcome of a single test case execution.\"\"\"\n    def __init__(self, test_case_id: str, input_string: str, expected_output: int,\n                 actual_output: int, passed: bool, execution_time_ms: float,\n                 error_message: str = \"\"):\n        self.test_case_id = test_case_id\n        self.input_string = input_string\n        self.expected_output = expected_output\n        self.actual_output = actual_output\n        self.passed = passed\n        self.execution_time_ms = execution_time_ms\n        self.error_message = error_message\n\n    def is_passed(self) -> bool:\n        \"\"\"Checks if the test case passed.\"\"\"\n        return self.passed\n\n    def get_execution_time(self) -> float:\n        \"\"\"Returns the execution time in milliseconds.\"\"\"\n        return self.execution_time_ms\n\n    def get_details(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary of test result details.\"\"\"\n        return {\n            \"test_case_id\": self.test_case_id,\n            \"input_string\": self.input_string,\n            \"expected_output\": self.expected_output,\n            \"actual_output\": self.actual_output,\n            \"passed\": self.passed,\n            \"execution_time_ms\": self.execution_time_ms,\n            \"error_message\": self.error_message\n        }\n\n@dataclass\nclass ValidationSummary:\n    \"\"\"Summary of all test validation results.\"\"\"\n    total_tests: int = 0\n    passed_tests: int = 0\n    failed_tests: int = 0\n    total_execution_time_ms: float = 0.0\n    slowest_test_ms: float = 0.0\n    slowest_test_id: str = \"\"\n\nclass ResultValidator:\n    \"\"\"Validates test outcomes against expected results.\"\"\"\n    def validate_result(self, expected: int, actual: int) -> bool:\n        \"\"\"Compares expected and actual outputs for a single test.\"\"\"\n        return expected == actual\n\n    def validate_all_results(self, results: List[TestResult]) -> ValidationSummary:\n        \"\"\"Aggregates validation results from a list of TestResult objects.\"\"\"\n        summary = ValidationSummary()\n        summary.total_tests = len(results)\n        for result in results:\n            summary.total_execution_time_ms += result.execution_time_ms\n            if result.execution_time_ms > summary.slowest_test_ms:\n                summary.slowest_test_ms = result.execution_time_ms\n                summary.slowest_test_id = result.test_case_id\n            if result.is_passed():\n                summary.passed_tests += 1\n            else:\n                summary.failed_tests += 1\n        return summary\n\n    def check_expected_vs_actual(self, expected: int, actual: int) -> bool:\n        \"\"\"Determines if the actual output matches the expected output.\"\"\"\n        return expected == actual\n```\n```python\n# src/performance_analyzer.py\nimport time\nfrom typing import List, Callable, Tuple\nfrom dataclasses import dataclass\n\nfrom config.test_config import TestConfig\nfrom src.result_validator import TestResult\n\n@dataclass\nclass PerformanceReport:\n    \"\"\"Summary of performance analysis.\"\"\"\n    average_execution_time_ms: float = 0.0\n    max_execution_time_ms: float = 0.0\n    min_execution_time_ms: float = float('inf')\n    exceeded_time_limit_count: int = 0\n    time_limit_ms: float = TestConfig.PERFORMANCE_TIME_LIMIT_MS\n\nclass PerformanceAnalyzer:\n    \"\"\"Measures and analyzes test execution performance.\"\"\"\n    def __init__(self, time_limit_ms: float = TestConfig.PERFORMANCE_TIME_LIMIT_MS):\n        self.time_limit_ms = time_limit_ms\n\n    def measure_execution_time(self, func: Callable, args: Tuple) -> Tuple[float, Any]:\n        \"\"\"Measures the execution time of a function.\"\"\"\n        start_time = time.perf_counter()\n        result = func(*args)\n        end_time = time.perf_counter()\n        execution_time_ms = (end_time - start_time) * 1000\n        return execution_time_ms, result\n\n    def analyze_performance(self, results: List[TestResult]) -> PerformanceReport:\n        \"\"\"Analyzes performance across all test results.\"\"\"\n        report = PerformanceReport(time_limit_ms=self.time_limit_ms)\n        if not results:\n            return report\n\n        total_time = 0.0\n        for result in results:\n            total_time += result.execution_time_ms\n            report.max_execution_time_ms = max(report.max_execution_time_ms, result.execution_time_ms)\n            report.min_execution_time_ms = min(report.min_execution_time_ms, result.execution_time_ms)\n            if not self.check_time_limit(result.execution_time_ms):\n                report.exceeded_time_limit_count += 1\n\n        report.average_execution_time_ms = total_time / len(results)\n        return report\n\n    def check_time_limit(self, execution_time: float) -> bool:\n        \"\"\"Checks if execution time is within the defined limit.\"\"\"\n        return execution_time < self.time_limit_ms\n```\n```python\n# src/test_cases.py\nimport importlib.util\nimport sys\nfrom typing import Any, Tuple\n\nfrom src.result_validator import TestResult, ResultValidator\nfrom src.performance_analyzer import PerformanceAnalyzer\nfrom config.test_config import TestConfig\n\n# Dynamically load the target function\nspec = importlib.util.spec_from_file_location(\n    \"vowels_count_module\",\n    f\"{sys.path[0]}/target/vowels_count.py\"\n)\nvowels_count_module = importlib.util.module_from_spec(spec)\nsys.modules[\"vowels_count_module\"] = vowels_count_module\nspec.loader.exec_module(vowels_count_module)\nvowels_count = vowels_count_module.vowels_count\n\nclass TestCase:\n    \"\"\"Represents an individual test scenario.\"\"\"\n    def __init__(self, test_case_id: str, input_string: str, expected_output: int,\n                 description: str, category: str):\n        self.test_case_id = test_case_id\n        self.input_string = input_string\n        self.expected_output = expected_output\n        self.description = description\n        self.category = category\n        self.validator = ResultValidator()\n        self.performance_analyzer = PerformanceAnalyzer(TestConfig.PERFORMANCE_TIME_LIMIT_MS)\n\n    def execute(self) -> TestResult:\n        \"\"\"Executes the test case and returns its result.\"\"\"\n        execution_time_ms, actual_output = self.performance_analyzer.measure_execution_time(\n            vowels_count, (self.input_string,)\n        )\n        passed = self.validator.validate_result(self.expected_output, actual_output)\n        error_message = \"\"\n        if not passed:\n            error_message = f\"Expected {self.expected_output}, got {actual_output}\"\n        \n        return TestResult(\n            test_case_id=self.test_case_id,\n            input_string=self.input_string,\n            expected_output=self.expected_output,\n            actual_output=actual_output,\n            passed=passed,\n            execution_time_ms=execution_time_ms,\n            error_message=error_message\n        )\n\n    def validate(self, actual: int) -> bool:\n        \"\"\"Validates the actual output against the expected output.\"\"\"\n        return self.validator.validate_result(self.expected_output, actual)\n\n    def get_input(self) -> str:\n        \"\"\"Returns the input string for the test case.\"\"\"\n        return self.input_string\n\n    def get_expected(self) -> int:\n        \"\"\"Returns the expected output for the test case.\"\"\"\n        return self.expected_output\n\n# Define all individual test case implementations\nall_test_cases = [\n    # Comprehensive test cases\n    TestCase(\"TC001\", \"abcde\", 2, \"Basic test with mixed vowels/consonants\", \"Basic\"),\n    TestCase(\"TC002\", \"ACEDY\", 3, \"Mixed case, 'y' at end\", \"Basic\"),\n    TestCase(\"TC003\", \"aeiou\", 5, \"All vowels\", \"Vowel-Only\"),\n    TestCase(\"TC004\", \"bcdfgh\", 0, \"All consonants\", \"Consonant-Only\"),\n    TestCase(\"TC005\", \"\", 0, \"Empty string\", \"Edge Case\"),\n    TestCase(\"TC006\", \"y\", 1, \"'y' as only character\", \"Edge Case\"),\n    TestCase(\"TC007\", \"rhythm\", 0, \"'y' not at end, no other vowels\", \"Y-Handling\"),\n    TestCase(\"TC008\", \"happy\", 1, \"'y' at end, other vowel\", \"Y-Handling\"),\n    TestCase(\"TC009\", \"FLY\", 1, \"Uppercase 'Y' at end\", \"Y-Handling\"),\n    TestCase(\"TC010\", \"mystery\", 1, \"Lowercase 'y' at end\", \"Y-Handling\"),\n    TestCase(\"TC011\", \"analysis\", 3, \"Multiple 'y's, not at end\", \"Y-Handling\"),\n    TestCase(\"TC012\", \"AEIOU\", 5, \"Uppercase vowels\", \"Mixed Case\"),\n    TestCase(\"TC013\", \"PyThOn\", 1, \"Mixed case 'y' not at end\", \"Mixed Case\"),\n    TestCase(\"TC014\", \"programming\", 4, \"Normal word\", \"Basic\"),\n    TestCase(\"TC015\", \"education\", 5, \"Word with many vowels\", \"Basic\"),\n    TestCase(\"TC016\", \"rhythmically\", 1, \"'y' not at end, then 'a'\", \"Y-Handling\"),\n    TestCase(\"TC017\", \"AEIOUY\", 6, \"All vowels plus 'Y' at end\", \"Y-Handling\"),\n    TestCase(\"TC018\", \"syzygy\", 1, \"Multiple 'y's, one at end\", \"Y-Handling\"),\n    TestCase(\"TC019\", \"why\", 1, \"'y' is only vowel\", \"Y-Handling\"),\n    TestCase(\"TC020\", \"crypt\", 0, \"'y' is not at the end\", \"Y-Handling\"),\n    TestCase(\"TC021\", \"strength\", 1, \"One vowel, 'e'\", \"Basic\"),\n    TestCase(\"TC022\", \"supercalifragilisticexpialidocious\", 16, \"Long string\", \"Long String\"),\n    TestCase(\"TC023\", \"12345\", 0, \"Numbers only\", \"Special Characters\"),\n    TestCase(\"TC024\", \"!@#$%^&\", 0, \"Special characters only\", \"Special Characters\"),\n    TestCase(\"TC025\", \"h3ll0\", 1, \"Mixed alphanumeric\", \"Special Characters\"),\n    TestCase(\"TC026\", \"h\u00e9llo\", 1, \"Accented vowels (not counted by design)\", \"Special Characters\"),\n    TestCase(\"TC027\", \"aaaaa\", 5, \"Repeated vowels\", \"Vowel-Only\"),\n    TestCase(\"TC028\", \"bbbbb\", 0, \"Repeated consonants\", \"Consonant-Only\"),\n    TestCase(\"TC029\", \"yacht\", 1, \"'y' at start\", \"Y-Handling\"),\n    TestCase(\"TC030\", \"lovely\", 2, \"Lowercase 'y' at end\", \"Y-Handling\"),\n]\n```\n```python\n# src/test_suite.py\nfrom typing import List\n\nfrom src.test_cases import TestCase\nfrom src.result_validator import TestResult, ResultValidator\nfrom src.performance_analyzer import PerformanceAnalyzer\n\nclass TestSuite:\n    \"\"\"Organizes and manages test cases.\"\"\"\n    def __init__(self, name: str = \"Default Test Suite\"):\n        self.name = name\n        self.test_cases: List[TestCase] = []\n\n    def add_test_case(self, test_case: TestCase):\n        \"\"\"Adds a single test case to the suite.\"\"\"\n        self.test_cases.append(test_case)\n\n    def run_all_tests(self) -> List[TestResult]:\n        \"\"\"Executes all test cases in the suite and returns their results.\"\"\"\n        results: List[TestResult] = []\n        for test_case in self.test_cases:\n            result = test_case.execute()\n            results.append(result)\n        return results\n\n    def get_test_count(self) -> int:\n        \"\"\"Returns the total number of test cases in the suite.\"\"\"\n        return len(self.test_cases)\n\n    def filter_by_category(self, category: str) -> List[TestCase]:\n        \"\"\"Filters test cases by a specific category.\"\"\"\n        return [tc for tc in self.test_cases if tc.category == category]\n```\n```python\n# src/report_generator.py\nimport os\nimport sys\nfrom typing import List, TextIO, Dict, Any\nimport io\n\nfrom src.result_validator import TestResult, ValidationSummary\nfrom src.performance_analyzer import PerformanceReport\nfrom config.test_config import TestConfig\n\nclass OutputWriter:\n    \"\"\"Handles output formatting and writing to different destinations.\"\"\"\n    def __init__(self, output_stream: TextIO = sys.stdout):\n        self.output_stream = output_stream\n\n    def write_stdout(self, content: str):\n        \"\"\"Writes content directly to standard output.\"\"\"\n        print(content, file=self.output_stream)\n\n    def write_file(self, content: str, filename: str):\n        \"\"\"Writes content to a specified file.\"\"\"\n        os.makedirs(os.path.dirname(filename), exist_ok=True)\n        with open(filename, 'w', encoding='utf-8') as f:\n            f.write(content)\n\n    def format_with_delimiter(self, data: List[str], delimiter: str) -> str:\n        \"\"\"Formats a list of strings with a given delimiter.\"\"\"\n        return delimiter.join(data)\n\nclass ReportGenerator:\n    \"\"\"Generates formatted reports for test results and summaries.\"\"\"\n    def __init__(self, output_format: str = \"text\", output_writer: OutputWriter = None):\n        self.output_format = output_format\n        self.output_writer = output_writer if output_writer else OutputWriter()\n\n    def _format_test_result_text(self, result: TestResult, delimiter: str = \" | \") -> str:\n        \"\"\"Formats a single test result into a text line.\"\"\"\n        status = \"PASSED\" if result.is_passed() else \"FAILED\"\n        details = [\n            result.test_case_id,\n            result.description,\n            result.input_string,\n            str(result.expected_output),\n            str(result.actual_output),\n            status,\n            f\"{result.execution_time_ms:.2f} ms\"\n        ]\n        if result.error_message:\n            details.append(f\"Error: {result.error_message}\")\n        return self.output_writer.format_with_delimiter(details, delimiter)\n\n    def generate_test_report(self, results: List[TestResult], delimiter: str = \" | \") -> str:\n        \"\"\"Generates a detailed report for all test results.\"\"\"\n        report_lines = []\n        header = self.output_writer.format_with_delimiter([\n            \"ID\", \"Description\", \"Input\", \"Expected\", \"Actual\", \"Status\", \"Time\"\n        ], delimiter)\n        report_lines.append(header)\n        report_lines.append(self.output_writer.format_with_delimiter([\"---\"] * len(header.split(delimiter)), delimiter))\n\n        for result in results:\n            report_lines.append(self._format_test_result_text(result, delimiter))\n\n        return \"\\n\".join(report_lines)\n\n    def generate_summary_report(self, summary: ValidationSummary, performance_report: PerformanceReport) -> str:\n        \"\"\"Generates a summary report of test validation and performance.\"\"\"\n        report_lines = [\n            f\"--- Test Suite Summary ---\",\n            f\"Total Tests: {summary.total_tests}\",\n            f\"Passed: {summary.passed_tests}\",\n            f\"Failed: {summary.failed_tests}\",\n            f\"Total Execution Time: {summary.total_execution_time_ms:.2f} ms\",\n            f\"Average Execution Time: {performance_report.average_execution_time_ms:.2f} ms\",\n            f\"Max Execution Time: {performance_report.max_execution_time_ms:.2f} ms (Test ID: {summary.slowest_test_id})\",\n            f\"Min Execution Time: {performance_report.min_execution_time_ms:.2f} ms\",\n            f\"Tests Exceeding {performance_report.time_limit_ms}ms: {performance_report.exceeded_time_limit_count}\",\n            f\"--------------------------\"\n        ]\n        return \"\\n\".join(report_lines)\n    \n    def generate_performance_report(self, performance_report: PerformanceReport) -> str:\n        \"\"\"Generates a dedicated performance report.\"\"\"\n        report_lines = [\n            f\"--- Performance Report ---\",\n            f\"Time Limit per Test: {performance_report.time_limit_ms:.2f} ms\",\n            f\"Average Execution Time: {performance_report.average_execution_time_ms:.2f} ms\",\n            f\"Max Execution Time: {performance_report.max_execution_time_ms:.2f} ms\",\n            f\"Min Execution Time: {performance_report.min_execution_time_ms:.2f} ms\",\n            f\"Tests Exceeding Time Limit: {performance_report.exceeded_time_limit_count}\",\n            f\"--------------------------\"\n        ]\n        return \"\\n\".join(report_lines)\n\n\n    def write_to_file(self, content: str, filename: str):\n        \"\"\"Writes report content to a specified file.\"\"\"\n        self.output_writer.write_file(content, filename)\n\n    def format_results(self, results: List[TestResult], delimiter: str) -> str:\n        \"\"\"Formats a list of test results using a specified delimiter.\"\"\"\n        return self.generate_test_report(results, delimiter)\n```\n```python\n# src/coverage_analyzer.py\nimport coverage\nimport os\nfrom typing import List, Optional\nfrom dataclasses import dataclass\n\nfrom config.test_config import TestConfig\n\n@dataclass\nclass CoverageReport:\n    \"\"\"Summary of code coverage metrics.\"\"\"\n    total_statements: int = 0\n    covered_statements: int = 0\n    missing_statements: int = 0\n    coverage_percentage: float = 0.0\n    coverage_threshold: float = TestConfig.COVERAGE_THRESHOLD\n    is_threshold_met: bool = False\n    html_report_path: Optional[str] = None\n    console_report_path: Optional[str] = None\n\nclass CoverageAnalyzer:\n    \"\"\"Analyzes code coverage using coverage.py integration.\"\"\"\n    def __init__(self, target_module_path: str = TestConfig.TARGET_MODULE_PATH):\n        self.target_module_path = target_module_path\n        self._cov = coverage.Coverage(\n            source=[os.path.dirname(target_module_path.replace('.', os.sep))],\n            omit=['*/test_*.py', '*/__init__.py']\n        )\n        self._report_dir = TestConfig.REPORTS_DIR\n\n    def start_coverage_measurement(self):\n        \"\"\"Starts the code coverage measurement.\"\"\"\n        self._cov.start()\n\n    def stop_coverage_measurement(self):\n        \"\"\"Stops the code coverage measurement and saves data.\"\"\"\n        self._cov.stop()\n        self._cov.save()\n\n    def analyze_coverage(self) -> CoverageReport:\n        \"\"\"Calculates coverage metrics and returns a CoverageReport.\"\"\"\n        report = CoverageReport()\n        try:\n            analysis_data = self._cov.get_data()\n            if not analysis_data:\n                # No coverage data collected, possibly due to no tests run or incorrect path\n                return report\n\n            # Get summary for the target module only\n            total_statements = 0\n            covered_statements = 0\n            for file_path in analysis_data.measured_files():\n                if self.target_module_path.replace('.', os.sep) in file_path:\n                    _, _, _, _, _, statements, covered, missing, _ = self._cov.analysis2(file_path)\n                    total_statements += len(statements)\n                    covered_statements += len(covered)\n                    report.missing_statements += len(missing) # This might count missing from all files, better calculate from total/covered\n\n            if total_statements > 0:\n                report.total_statements = total_statements\n                report.covered_statements = covered_statements\n                report.missing_statements = total_statements - covered_statements\n                report.coverage_percentage = (covered_statements / total_statements) * 100\n            \n            report.is_threshold_met = self.check_coverage_threshold(report.coverage_percentage)\n\n        except coverage.exceptions.CoverageException as e:\n            print(f\"Coverage analysis error: {e}\")\n            pass # Return default empty report\n\n        return report\n\n    def generate_coverage_report(self, coverage_report_data: CoverageReport) -> str:\n        \"\"\"Generates coverage reports in HTML and console formats.\"\"\"\n        os.makedirs(self._report_dir, exist_ok=True)\n        \n        # HTML report\n        html_report_path = os.path.join(self._report_dir, TestConfig.COVERAGE_REPORT_HTML_FILE)\n        self._cov.html_report(directory=self._report_dir, outfile=TestConfig.COVERAGE_REPORT_HTML_FILE)\n        coverage_report_data.html_report_path = html_report_path\n\n        # Console report (text)\n        console_buffer = io.StringIO()\n        self._cov.report(file=console_buffer, show_missing=True)\n        console_report_content = console_buffer.getvalue()\n        \n        console_report_path = os.path.join(self._report_dir, TestConfig.COVERAGE_REPORT_CONSOLE_FILE)\n        with open(console_report_path, 'w', encoding='utf-8') as f:\n            f.write(console_report_content)\n        coverage_report_data.console_report_path = console_report_path\n\n        summary_lines = [\n            f\"--- Coverage Report ---\",\n            f\"Target Module: {self.target_module_path}\",\n            f\"Statements: {coverage_report_data.total_statements}\",\n            f\"Covered: {coverage_report_data.covered_statements}\",\n            f\"Missing: {coverage_report_data.missing_statements}\",\n            f\"Coverage Percentage: {coverage_report_data.coverage_percentage:.2f}%\",\n            f\"Coverage Threshold: {coverage_report_data.coverage_threshold:.2f}%\",\n            f\"Threshold Met: {'Yes' if coverage_report_data.is_threshold_met else 'No'}\",\n            f\"HTML Report: {os.path.abspath(html_report_path)}\",\n            f\"Console Report (Text): {os.path.abspath(console_report_path)}\",\n            f\"-----------------------\"\n        ]\n        return \"\\n\".join(summary_lines)\n\n    def check_coverage_threshold(self, percentage: float) -> bool:\n        \"\"\"Checks if the coverage percentage meets the defined threshold.\"\"\"\n        return percentage >= TestConfig.COVERAGE_THRESHOLD\n```\n```python\n# src/test_runner.py\nimport argparse\nimport sys\nimport os\nfrom typing import List, TextIO\n\n# Add the project root to sys.path to allow imports from config and target\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))\n\nfrom config.test_config import TestConfig\nfrom src.test_cases import all_test_cases, TestCase\nfrom src.test_suite import TestSuite\nfrom src.result_validator import ResultValidator\nfrom src.performance_analyzer import PerformanceAnalyzer\nfrom src.report_generator import ReportGenerator, OutputWriter\nfrom src.coverage_analyzer import CoverageAnalyzer\n\nclass TestRunner:\n    \"\"\"Main CLI entry point, orchestrates test execution.\"\"\"\n    def __init__(self, test_suite: TestSuite, output_writer: OutputWriter,\n                 result_validator: ResultValidator, performance_analyzer: PerformanceAnalyzer,\n                 report_generator: ReportGenerator, coverage_analyzer: CoverageAnalyzer):\n        self.test_suite = test_suite\n        self.output_writer = output_writer\n        self.result_validator = result_validator\n        self.performance_analyzer = performance_analyzer\n        self.report_generator = report_generator\n        self.coverage_analyzer = coverage_analyzer\n        self.delimiter = \" | \" # Default delimiter\n\n    def parse_cli_args(self, args: List[str]):\n        \"\"\"Parses command-line arguments.\"\"\"\n        parser = argparse.ArgumentParser(description=\"Run the vowels_count test suite.\")\n        parser.add_argument(\"--output\", default=\"stdout\",\n                            help=\"Output destination: 'stdout' or a filename (e.g., 'reports/test_results.txt').\")\n        parser.add_argument(\"--delimiter\", default=\" | \",\n                            help=\"Delimiter for test report columns (e.g., ',').\")\n        \n        parsed_args = parser.parse_args(args)\n        self.delimiter = parsed_args.delimiter\n\n        if parsed_args.output != \"stdout\":\n            self.output_writer.output_stream = parsed_args.output\n        else:\n            self.output_writer.output_stream = sys.stdout\n\n    def run_tests(self):\n        \"\"\"Runs the test suite and generates reports.\"\"\"\n        print(\"Starting test execution...\")\n\n        self.coverage_analyzer.start_coverage_measurement()\n        results = self.test_suite.run_all_tests()\n        self.coverage_analyzer.stop_coverage_measurement()\n\n        # Validate results\n        validation_summary = self.result_validator.validate_all_results(results)\n        \n        # Analyze performance\n        performance_report = self.performance_analyzer.analyze_performance(results)\n\n        # Generate and write reports\n        test_report_content = self.report_generator.generate_test_report(results, self.delimiter)\n        summary_report_content = self.report_generator.generate_summary_report(validation_summary, performance_report)\n        performance_report_content = self.report_generator.generate_performance_report(performance_report)\n        \n        # Coverage analysis and report\n        coverage_data = self.coverage_analyzer.analyze_coverage()\n        coverage_report_content = self.coverage_analyzer.generate_coverage_report(coverage_data)\n\n        # Write reports\n        if self.output_writer.output_stream == sys.stdout:\n            self.output_writer.write_stdout(test_report_content)\n            self.output_writer.write_stdout(\"\\n\" + summary_report_content)\n            self.output_writer.write_stdout(\"\\n\" + performance_report_content)\n            self.output_writer.write_stdout(\"\\n\" + coverage_report_content)\n        else:\n            report_filepath = os.path.join(TestConfig.REPORTS_DIR, os.path.basename(self.output_writer.output_stream))\n            self.output_writer.write_file(test_report_content, report_filepath)\n            \n            summary_filepath = os.path.join(TestConfig.REPORTS_DIR, TestConfig.TEST_RESULTS_FILE)\n            self.output_writer.write_file(summary_report_content + \"\\n\\n\" + performance_report_content + \"\\n\\n\" + coverage_report_content, summary_filepath)\n            \n            print(f\"Detailed test report written to: {report_filepath}\")\n            print(f\"Summary reports written to: {summary_filepath}\")\n            print(f\"HTML Coverage Report: {coverage_data.html_report_path}\")\n            print(f\"Console Coverage Report: {coverage_data.console_report_path}\")\n\n        print(\"\\nTest execution finished.\")\n        if validation_summary.failed_tests > 0:\n            print(f\"Tests Failed: {validation_summary.failed_tests}\")\n            sys.exit(1) # Indicate failure for CI/CD\n        if not coverage_data.is_threshold_met:\n            print(f\"Coverage threshold not met: {coverage_data.coverage_percentage:.2f}% < {coverage_data.coverage_threshold:.2f}%\")\n            sys.exit(1)\n        \n        print(\"All tests passed and coverage threshold met.\")\n        sys.exit(0)\n\n    def write_output(self, content: str):\n        \"\"\"Writes the final output based on the configured destination.\"\"\"\n        if self.output_writer.output_stream == sys.stdout:\n            self.output_writer.write_stdout(content)\n        else:\n            self.output_writer.write_file(content, self.output_writer.output_stream)\n\n\ndef main(args: List[str] = None):\n    \"\"\"Main function to initialize and run the test suite.\"\"\"\n    if args is None:\n        args = sys.argv[1:]\n\n    # Initialize components\n    test_suite = TestSuite(name=\"Vowels Count Function Test Suite\")\n    for tc in all_test_cases:\n        test_suite.add_test_case(tc)\n\n    output_writer = OutputWriter()\n    result_validator = ResultValidator()\n    performance_analyzer = PerformanceAnalyzer()\n    report_generator = ReportGenerator(output_writer=output_writer)\n    coverage_analyzer = CoverageAnalyzer(target_module_path=TestConfig.TARGET_MODULE_PATH)\n\n    runner = TestRunner(test_suite, output_writer, result_validator,\n                        performance_analyzer, report_generator, coverage_analyzer)\n    \n    runner.parse_cli_args(args)\n    runner.run_tests()\n\nif __name__ == \"__main__\":\n    main()\n\n```"}
