{"task_id": "HumanEval/36", "solution": "from typing import List\n\ndef is_divisible_by_11(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11.\n    Returns True if divisible, False otherwise.\"\"\"\n    return number % 11 == 0\n\ndef is_divisible_by_13(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 13.\n    Returns True if divisible, False otherwise.\"\"\"\n    return number % 13 == 0\n\ndef count_digit_in_number(digit: int, number: int) -> int:\n    \"\"\"Counts occurrences of a specific digit in a number.\n    Converts the number to a string to check for the digit.\"\"\"\n    return str(number).count(str(digit))\n\ndef find_divisible_numbers(n: int) -> List[int]:\n    \"\"\"Identifies all numbers less than n that are divisible by 11 or 13.\n    Iterates from 1 up to n-1 to find such numbers.\"\"\"\n    divisible_numbers = []\n    for i in range(1, n):\n        if is_divisible_by_11(i) or is_divisible_by_13(i):\n            divisible_numbers.append(i)\n    return divisible_numbers\n\ndef count_digit_seven(numbers: List[int]) -> int:\n    \"\"\"Counts total occurrences of the digit 7 in a list of numbers.\n    Iterates through the list and uses count_digit_in_number for each.\"\"\"\n    total_sevens = 0\n    for number in numbers:\n        total_sevens += count_digit_in_number(7, number)\n    return total_sevens\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This function orchestrates finding numbers and counting the digit 7.\"\"\"\n    divisible_nums = find_divisible_numbers(n)\n    total_sevens = count_digit_seven(divisible_nums)\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function sorts values at even indices in ascending order while preserving odd-indexed values.\n    It returns a new list without modifying the original.\n    \"\"\"\n    n = len(l)\n    if n == 0:\n        return []\n\n    even_indices_values = []\n    for i in range(0, n, 2):\n        even_indices_values.append(l[i])\n\n    even_indices_values.sort()\n\n    result = [None] * n\n\n    sorted_even_idx = 0\n    for i in range(n):\n        if i % 2 == 0:\n            result[i] = even_indices_values[sorted_even_idx]\n            sorted_even_idx += 1\n        else:\n            result[i] = l[i]\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11.\"\"\"\n        return number % 11 == 0\n\n    def _is_divisible_by_13(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by 13.\"\"\"\n        return number % 13 == 0\n\n    def _count_digit_7_in_number(number: int) -> int:\n        \"\"\"Counts occurrences of the digit 7 in a number.\"\"\"\n        return str(number).count('7')\n\n    total_sevens_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11(i) or _is_divisible_by_13(i):\n            total_sevens_count += _count_digit_7_in_number(i)\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list) -> list:\n    \"\"\"This function sorts elements at even indices of a list while preserving odd-indexed elements.\n    It returns a new list of the same length as the input.\n    \"\"\"\n    n = len(l)\n\n    if n <= 1:\n        return l[:] # Return a shallow copy for consistency with returning a new list\n\n    # Extract elements from even indices\n    even_elements = []\n    for i in range(0, n, 2):\n        even_elements.append(l[i])\n\n    # Sort the extracted even elements\n    even_elements.sort()\n\n    # Reconstruct the list, placing sorted even elements back into even positions\n    result = l[:]  # Create a shallow copy to preserve odd-indexed elements and structure\n    even_ptr = 0\n    for i in range(n):\n        if i % 2 == 0:\n            result[i] = even_elements[even_ptr]\n            even_ptr += 1\n            \n    return result\n```"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string into groups of 3 characters\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Reverse cycle for groups with exactly 3 characters, preserve shorter groups.\n    groups = [(group[2] + group[0:2]) if len(group) == 3 else group for group in groups]\n\n    # Join groups back into string\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "from typing import Iterator\n\ndef validate_input(n: int) -> bool:\n    \"\"\"\n    Validates if the input n is a positive integer.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    return isinstance(n, int) and n > 0\n\ndef is_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given number is prime.\n    Returns True if prime, False otherwise.\n    \"\"\"\n    if number < 2:\n        return False\n    if number == 2 or number == 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef fibonacci_generator() -> Iterator[int]:\n    \"\"\"\n    Generates an infinite sequence of Fibonacci numbers.\n    Yields numbers starting from 0, 1, 1, 2, 3, 5, ...\n    \"\"\"\n    a, b = 0, 1\n    while True:\n        yield a\n        a, b = b, a + b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not validate_input(n):\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    count = 0\n    nth_prime_fib = 0\n    fib_gen = fibonacci_generator()\n\n    for fib_num in fib_gen:\n        if is_prime(fib_num):\n            count += 1\n            if count == n:\n                nth_prime_fib = fib_num\n                break\n    return nth_prime_fib"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split into groups of three and reverse the cyclic shift for full groups.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    groups = [(group[-1:] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Check if a number is prime. Handles basic cases and checks odd divisors efficiently.\"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for odd divisors up to the square root of num.\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef fibonacci_generator():\n    \"\"\"Generates an infinite sequence of Fibonacci numbers starting from 0 and 1.\"\"\"\n    a, b = 0, 1\n    yield a\n    yield b\n    while True:\n        next_fib = a + b\n        yield next_fib\n        a = b\n        b = next_fib\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    fib_gen = fibonacci_generator()\n\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
