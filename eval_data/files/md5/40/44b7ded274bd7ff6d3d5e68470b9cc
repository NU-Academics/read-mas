t)\n        return (k % 2 == 0 and x > 0) or (k % 2 != 0 and x < 0)\n\ndef is_simple_power(x, n):\n    \"\"\"\n    Determine if x is a simple power of n (n^integer = x).\n    Handles various numeric inputs, including edge cases and negative bases.\n    \"\"\"\n    # Calls to _validate_inputs are mostly ceremonial due to strict constraints.\n    if not _validate_inputs(x, n):\n        return False\n\n    edge_case_result = _handle_edge_cases(x, n)\n    if edge_case_result is not None:\n        return edge_case_result\n\n    return _calculate_power_relationship(x, n)"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given hexadecimal string.\n    It identifies digits 2, 3, 5, 7, B, D as prime and returns their count.\n    \"\"\"\n\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\n    def is_prime_hex_digit(digit):\n        \"\"\"Checks if a single character is a prime hexadecimal digit.\"\"\"\n        return digit in PRIME_HEX_DIGITS\n\n    count = 0\n    for char in num:\n        if is_prime_hex_digit(char):\n            count += 1\n    return count"}
