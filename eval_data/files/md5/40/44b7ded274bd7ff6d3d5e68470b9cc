{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Orchestrates extension strength analysis and selection, returning a formatted result.\n    It identifies the strongest extension based on CAP-SM formula and tie-breaking rules.\"\"\"\n\n    def count_uppercase(text: str) -> int:\n        \"\"\"Counts the number of uppercase letters in a string.\n        Non-alphabetic characters are ignored.\"\"\"\n        cap_count = 0\n        for char in text:\n            if 'A' <= char <= 'Z':  # Check if char is an uppercase letter\n                cap_count += 1\n        return cap_count\n\n    def count_lowercase(text: str) -> int:\n        \"\"\"Counts the number of lowercase letters in a string.\n        Non-alphabetic characters are ignored.\"\"\"\n        sm_count = 0\n        for char in text:\n            if 'a' <= char <= 'z':  # Check if char is a lowercase letter\n                sm_count += 1\n        return sm_count\n\n    def calculate_strength(extension: str) -> int:\n        \"\"\"Calculates the strength of an extension using the CAP (uppercase) - SM (lowercase) formula.\"\"\"\n        cap = count_uppercase(extension)\n        sm = count_lowercase(extension)\n        return cap - sm\n\n    def find_strongest_extension(extensions_list: list[str]) -> str:\n        \"\"\"Identifies the extension with the highest strength, applying tie-breaking by list order.\n        It assumes the input list of extensions is not empty.\"\"\"\n        \n        strongest_ext = extensions_list[0]\n        max_strength = calculate_strength(strongest_ext)\n\n        for i in range(1, len(extensions_list)):\n            current_ext = extensions_list[i]\n            current_strength = calculate_strength(current_ext)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_ext = current_ext\n        return strongest_ext\n\n    def format_result(class_name_str: str, strongest_extension_name: str) -> str:\n        \"\"\"Formats the final result string as 'ClassName.StrongestExtensionName'.\"\"\"\n        return f\"{class_name_str}.{strongest_extension_name}\"\n\n    strongest_extension_name = find_strongest_extension(extensions)\n    return format_result(class_name, strongest_extension_name)"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension for a class based on CAP-SM strength, returning 'ClassName.StrongestExtensionName'.\n    Handles ties by selecting the first extension encountered in the list with the maximum strength.\n    \"\"\"\n\n    def _count_uppercase(text):\n        \"\"\"Counts uppercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.isupper())\n\n    def _count_lowercase(text):\n        \"\"\"Counts lowercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.islower())\n\n    def _calculate_strength(extension):\n        \"\"\"Computes extension strength using the CAP - SM formula.\"\"\"\n        cap = _count_uppercase(extension)\n        sm = _count_lowercase(extension)\n        return cap - sm\n\n    def _find_strongest_extension(extensions_list):\n        \"\"\"\n        Identifies the strongest extension from a list, breaking ties by original list order.\n        Assumes the input list 'extensions_list' is not empty.\n        \"\"\"\n        strongest_extension_name = extensions_list[0]\n        max_strength = _calculate_strength(strongest_extension_name)\n\n        for extension in extensions_list[1:]:\n            current_strength = _calculate_strength(extension)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension_name = extension\n        return strongest_extension_name\n\n    def _format_result(cls_name, ext_name):\n        \"\"\"Formats the final result string.\"\"\"\n        return f\"{cls_name}.{ext_name}\"\n\n    strongest_ext = _find_strongest_extension(extensions)\n    return _format_result(class_name, strongest_ext)\n\n```"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generate all possible rotations of the input string.\n    For 'abc', this generates ['abc', 'bca', 'cab'].\"\"\"\n    rotations = []\n    n = len(s)\n    if n == 0:\n        return rotations\n    for i in range(n):\n        rotation = s[i:] + s[:i]\n        rotations.append(rotation)\n    return rotations\n\ndef _check_substring(target: str, pattern: str) -> bool:\n    \"\"\"Check if pattern exists as a substring in the target string.\n    This uses Python's 'in' operator for direct substring matching.\"\"\"\n    return pattern in target\n\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Check if the second word or any of its rotations is a substring in the first word.\n    This function performs cyclic pattern matching.\"\"\"\n    \n    # First, check if the pattern itself is a substring in the target.\n    if _check_substring(a, b):\n        return True\n    \n    # If not, generate all rotations of the pattern.\n    rotations = _generate_rotations(b)\n    \n    # Check each rotation against the target string.\n    for rotation in rotations:\n        if _check_substring(a, rotation):\n            return True\n            \n    # If no pattern or rotation was found, return False.\n    return False"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Convert a positive integer to its lowercase Roman numeral equivalent.\n    This function handles integers within the range of 1 to 1000.\n    \"\"\"\n    ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numerals = []\n    for value, symbol in ROMAN_MAP:\n        while number >= value:\n            roman_numerals.append(symbol)\n            number -= value\n    return \"\".join(roman_numerals).lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    Negative signs are ignored during processing.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Handle negative integers by ignoring the negative sign\n    # Convert number to string to easily iterate through digits\n    num_str = str(abs(num))\n    \n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple with the count of even and odd digits respectively.\n    Negative signs are ignored during digit processing.\n    \"\"\"\n    if num == 0:\n        return (1, 0)\n\n    even_count = 0\n    odd_count = 0\n    abs_num = abs(num)\n\n    while abs_num > 0:\n        digit = abs_num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        abs_num //= 10\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result_numerals = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result_numerals.append(numeral)\n            number -= value\n    \n    return \"\".join(result_numerals).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    \n    def _check_floating_point_equality(val1, val2, tolerance=1e-9):\n        '''\n        Compares two floating-point values for equality within a specified tolerance.\n        Returns True if the absolute difference is less than the tolerance.\n        '''\n        return abs(val1 - val2) < tolerance\n\n    def _validate_pythagorean(side1, side2, potential_hypotenuse):\n        '''\n        Checks if side1 squared plus side2 squared equals potential_hypotenuse squared.\n        Uses floating-point equality for precision.\n        '''\n        return _check_floating_point_equality(side1**2 + side2**2, potential_hypotenuse**2)\n\n    # Check all permutations where each side could be the hypotenuse\n    if _validate_pythagorean(a, b, c):\n        return True\n    if _validate_pythagorean(a, c, b):\n        return True\n    if _validate_pythagorean(b, c, a):\n        return True\n    \n    return False"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Checks if three side lengths form a right-angled triangle using the Pythagorean theorem.\n    It identifies the longest side as the hypotenuse and compares squares with precision.\n    '''\n\n    # A small constant for floating-point comparisons to handle precision issues.\n    EPSILON = 1e-9\n\n    def _calculate_square(value):\n        \"\"\"Calculates the square of a given numeric value.\"\"\"\n        return value * value\n\n    def _find_longest_side(s1, s2, s3):\n        \"\"\"Identifies the longest side among three and returns it along with the other two.\"\"\"\n        sides = sorted([s1, s2, s3])\n        return sides[0], sides[1], sides[2] # side_a, side_b, hypotenuse_candidate\n\n    def _sum_squares(val1, val2):\n        \"\"\"Sums the squares of two numeric values.\"\"\"\n        return _calculate_square(val1) + _calculate_square(val2)\n\n    def _compare_with_precision(val1, val2):\n        \"\"\"Compares two floating-point values for approximate equality.\"\"\"\n        return abs(val1 - val2) < EPSILON\n\n    # Identify the two shorter sides and the longest side (candidate hypotenuse)\n    side1, side2, hypotenuse_candidate = _find_longest_side(a, b, c)\n\n    # Calculate the sum of squares of the two shorter sides\n    sum_of_squares = _sum_squares(side1, side2)\n\n    # Calculate the square of the longest side\n    hypotenuse_square = _calculate_square(hypotenuse_candidate)\n\n    # Compare the results with floating-point precision\n    return _compare_with_precision(sum_of_squares, hypotenuse_square)"}
{"task_id": "HumanEval/158", "solution": "def count_unique_chars(word: str) -> int:\n    \"\"\"Helper function to count unique characters in a string.\n    It uses a set to efficiently determine the number of distinct characters.\"\"\"\n    return len(set(word))\n\n\ndef find_max(words: List[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # Initialize with the first word to ensure valid starting comparison\n    result_word = words[0]\n    max_unique_count = count_unique_chars(words[0])\n\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_unique_count = count_unique_chars(current_word)\n\n        if current_unique_count > max_unique_count:\n            # Found a new word with strictly more unique characters\n            max_unique_count = current_unique_count\n            result_word = current_word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: if counts are equal, choose lexicographically smaller word\n            if current_word < result_word:\n                result_word = current_word\n    \n    return result_word"}
{"task_id": "HumanEval/158", "solution": "```python\nfrom typing import List\n\nclass StringAnalyzer:\n    \"\"\"\n    Counts unique characters and analyzes individual strings.\n    \"\"\"\n    @staticmethod\n    def count_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    def analyze_string(self, word: str) -> dict:\n        \"\"\"Returns a dictionary with the word and its unique character count.\"\"\"\n        return {\"word\": word, \"unique_char_count\": self.count_unique_chars(word)}\n\nclass ResultSelector:\n    \"\"\"\n    Identifies the string with the maximum unique character count,\n    applying lexicographic tie-breaking.\n    \"\"\"\n    def select_best(self, analyzed_strings: List[dict]) -> str:\n        \"\"\"Selects the optimal string based on unique character count and lexicographical order.\"\"\"\n        if not analyzed_strings:\n            return \"\"\n\n        max_count = self._find_maximum_count(analyzed_strings)\n        candidates = [\n            item for item in analyzed_strings if item[\"unique_char_count\"] == max_count\n        ]\n        \n        return self._apply_lexicographic_ordering(candidates)\n\n    def _find_maximum_count(self, analyzed_strings: List[dict]) -> int:\n        \"\"\"Finds the maximum unique character count among the analyzed strings.\"\"\"\n        # Assumes analyzed_strings is not empty due to check in select_best.\n        return max(item[\"unique_char_count\"] for item in analyzed_strings)\n\n    def _apply_lexicographic_ordering(self, candidates: List[dict]) -> str:\n        \"\"\"Applies lexicographic ordering to a list of candidate strings and returns the first one.\"\"\"\n        # Assumes candidates list is not empty.\n        best_word = candidates[0][\"word\"]\n        for i in range(1, len(candidates)):\n            current_word = candidates[i][\"word\"]\n            if current_word < best_word:\n                best_word = current_word\n        return best_word\n\nclass StringProcessor:\n    \"\"\"\n    Orchestrates the overall process of finding the string with\n    the maximum unique characters and tie-breaking.\n    \"\"\"\n    def __init__(self):\n        self._string_analyzer = StringAnalyzer()\n        self._result_selector = ResultSelector()\n\n    def _validate_input(self, words: List[str]) -> bool:\n        \"\"\"Performs input validation, returning True as per problem constraints.\"\"\"\n        return True\n\n    def find_max(self, words: List[str]) -> str:\n        \"\"\"\n        Processes a list of words to find the one with the maximum unique\n        characters, using lexicographic ordering for ties.\n        \"\"\"\n        self._validate_input(words)\n\n        if not words:\n            return \"\"\n\n        analyzed_data = []\n        for word in words:\n            analyzed_data.append(self._string_analyzer.analyze_string(word))\n        \n        return self._result_selector.select_best(analyzed_data)\n\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Accepts a list of strings and returns the word with the maximum number\n    of unique characters. In case of ties, it returns the lexicographically\n    first word.\n    \"\"\"\n    processor = StringProcessor()\n    return processor.find_max(words)\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining stock after a rabbit's meal.\n    The rabbit consumes carrots up to its need or until stock is depleted.\n    \"\"\"\n    consumed_amount = min(need, remaining)\n    total_eaten = number + consumed_amount\n    carrots_left = remaining - consumed_amount\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def has_letters(s):\n    \"\"\"Checks if the string contains any alphabetic characters.\n    It iterates through the string to find any letter.\n    \"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\n\ndef reverse_string(s):\n    \"\"\"Reverses the order of characters in the entire string.\n    This is achieved using string slicing.\n    \"\"\"\n    return s[::-1]\n\ndef solve(s):\n    \"\"\"Processes an input string by applying conditional transformation logic.\n    Reverses the case of letters, or reverses the entire string if no letters are present.\n    \"\"\"\n    if has_letters(s):\n        processed_chars = []\n        for char in s:\n            if char.isalpha():\n                processed_chars.append(char.swapcase())\n            else:\n                processed_chars.append(char)\n        return \"\".join(processed_chars)\n    else:\n        return reverse_string(s)"}
{"task_id": "HumanEval/159", "solution": "class InputValidator:\n    \"\"\"Validates input parameters for the eat function.\n    Raises ValueError for out-of-range parameters.\"\"\"\n    def validate_range(self, value: int, min_val: int, max_val: int) -> bool:\n        \"\"\"Checks if a value is within the specified inclusive range.\"\"\"\n        return min_val <= value <= max_val\n\n    def validate_parameters(self, number: int, need: int, remaining: int) -> None:\n        \"\"\"Validates all three parameters against their defined range [0, 1000].\"\"\"\n        if not self.validate_range(number, 0, 1000):\n            raise ValueError(f\"Parameter 'number' ({number}) must be between 0 and 1000.\")\n        if not self.validate_range(need, 0, 1000):\n            raise ValueError(f\"Parameter 'need' ({need}) must be between 0 and 1000.\")\n        if not self.validate_range(remaining, 0, 1000):\n            raise ValueError(f\"Parameter 'remaining' ({remaining}) must be between 0 and 1000.\")\n\nclass ConsumptionCalculator:\n    \"\"\"Calculates carrot consumption details based on business logic.\"\"\"\n    def calculate_consumption(self, need: int, remaining: int) -> int:\n        \"\"\"Determines the actual number of carrots consumed, limited by availability.\"\"\"\n        return min(need, remaining)\n\n    def calculate_total_eaten(self, number: int, consumed: int) -> int:\n        \"\"\"Calculates the rabbit's new total number of eaten carrots.\"\"\"\n        return number + consumed\n\n    def calculate_remaining(self, initial_remaining: int, consumed: int) -> int:\n        \"\"\"Calculates the number of carrots left in the stock after consumption.\"\"\"\n        return initial_remaining - consumed\n\nclass ResultFormatter:\n    \"\"\"Formats the final calculation results into the required array structure.\"\"\"\n    def format_result(self, total_eaten: int, remaining: int) -> list:\n        \"\"\"Returns the total eaten and remaining carrots as a two-element list.\"\"\"\n        return [total_eaten, remaining]\n\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates carrot consumption for a hungry rabbit, returning total eaten and remaining carrots.\n    It orchestrates validation, calculation, and formatting components.\n    \"\"\"\n    validator = InputValidator()\n    calculator = ConsumptionCalculator()\n    formatter = ResultFormatter()\n\n    validator.validate_parameters(number, need, remaining)\n\n    consumed_amount = calculator.calculate_consumption(need, remaining)\n    total_eaten = calculator.calculate_total_eaten(number, consumed_amount)\n    remaining_after = calculator.calculate_remaining(remaining, consumed_amount)\n\n    result_array = formatter.format_result(total_eaten, remaining_after)\n\n    return result_array"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    \n    def validate_inputs(operator_list, operand_list):\n        \"\"\"Checks input constraints, returning True for valid inputs or False otherwise.\"\"\"\n        if not (len(operator_list) == len(operand_list) - 1):\n            return False\n        if not (len(operand_list) >= 2):\n            return False\n        if not (len(operator_list) >= 1):\n            return False\n        \n        for op_val in operand_list:\n            if not (op_val >= 0):\n                return False\n        \n        # As per critical requirements, assuming operand_list contains integers due to type hint.\n        return True\n\n    def build_expression(operator_list, operand_list):\n        \"\"\"Constructs a mathematical expression string from operator and operand lists.\"\"\"\n        expression_parts = [str(operand_list[0])]\n        for i in range(len(operator_list)):\n            expression_parts.append(operator_list[i])\n            expression_parts.append(str(operand_list[i+1]))\n        return \" \".join(expression_parts)\n\n    def evaluate_expression(expression_str):\n        \"\"\"Evaluates a mathematical expression string and returns the integer result.\"\"\"\n        result = eval(expression_str)\n        return int(result)\n\n    if not validate_inputs(operator, operand):\n        raise ValueError(\"Invalid input constraints for operator or operand lists.\")\n\n    expression_string = build_expression(operator, operand)\n    final_result = evaluate_expression(expression_string)\n    \n    return final_result\n```"}
{"task_id": "HumanEval/160", "solution": "def get_operator_precedence(op):\n    \"\"\"Returns precedence value for given operator.\"\"\"\n    _OPERATOR_PRECEDENCE = {\n        '+': 1, '-': 1, '*': 2, '//': 2, '**': 3,\n    }\n    return _OPERATOR_PRECEDENCE.get(op, 0)\n\ndef apply_operation(op, left, right):\n    \"\"\"Performs specific mathematical operation.\"\"\"\n    if op == '+':\n        return left + right\n    elif op == '-':\n        return left - right\n    elif op == '*':\n        return left * right\n    elif op == '//':\n        return left // right\n    elif op == '**':\n        return left ** right\n\ndef validate_inputs(operator, operand):\n    \"\"\"Validates input constraints and relationships.\n    This function returns True due to the \"trust the caller's inputs\" constraint.\n    \"\"\"\n    return True\n\ndef build_expression(operator, operand):\n    \"\"\"Constructs a list of expression tokens from input lists.\"\"\"\n    tokens = []\n    for i in range(len(operand)):\n        tokens.append(operand[i])\n        if i < len(operator):\n            tokens.append(operator[i])\n    return tokens\n\ndef evaluate_with_precedence(tokens):\n    \"\"\"Evaluates expression following operator precedence using iterative reduction.\"\"\"\n    current_tokens = list(tokens)\n\n    for precedence_level in range(3, 0, -1): # Process highest precedence first (3, 2, 1)\n        i = 0\n        while i < len(current_tokens):\n            token = current_tokens[i]\n            # Check if it's an operator of the current precedence level\n            if isinstance(token, str) and get_operator_precedence(token) == precedence_level:\n                op = token\n                left_operand = current_tokens[i-1]\n                right_operand = current_tokens[i+1]\n\n                result = apply_operation(op, left_operand, right_operand)\n\n                # Replace the sub-expression [left_operand, operator, right_operand] with its result\n                current_tokens[i-1:i+2] = [result]\n                i -= 1 # Adjust index to re-evaluate the new element for subsequent operations\n            else:\n                i += 1\n    \n    return current_tokens[0]\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    validate_inputs(operator, operand) # Trusting inputs means this implicitly passes.\n    expression_tokens = build_expression(operator, operand)\n    result = evaluate_with_precedence(expression_tokens)\n    return result"}
{"task_id": "HumanEval/161", "solution": "def is_letter(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return char.isalpha()\n\ndef has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if is_letter(char):\n            return True\n    return False\n\ndef toggle_case(char: str) -> str:\n    \"\"\"Toggles the case of an alphabetic character.\"\"\"\n    if char.islower():\n        return char.upper()\n    elif char.isupper():\n        return char.lower()\n    return char\n\ndef reverse_string(s: str) -> str:\n    \"\"\"Reverses the order of characters in a string.\"\"\"\n    return s[::-1]\n\ndef solve(s: str) -> str:\n    \"\"\"You are given a string s.\n    If s[i] is a letter, reverse its case from lower to upper or vice versa,\n    otherwise keep it as it is. If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n    if has_letters(s):\n        result_chars = []\n        for char in s:\n            if is_letter(char):\n                result_chars.append(toggle_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return reverse_string(s)"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\nfrom typing import Optional\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    # Calculate the MD5 hash after encoding the string to UTF-8 bytes.\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    # Encode the string to UTF-8 bytes and compute the MD5 hash.\n    return hashlib.md5(text.encode('utf-8')).hexdigest()\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef _validate_inputs(a, b):\n    \"\"\"\n    Placeholder for input validation; assumes inputs are valid as per critical requirements.\n    Always returns True, trusting the caller's inputs are positive integers.\n    \"\"\"\n    # Critical requirements forbid actual validation checks, type guards, or exceptions.\n    return True\n\ndef _get_even_digits_in_range(min_val: int, max_val: int) -> list[int]:\n    \"\"\"\n    Filters the fixed set of single even digits to those within the given range.\n    Only considers 0, 2, 4, 6, 8 as potential even digits.\n    \"\"\"\n    even_single_digits = [0, 2, 4, 6, 8]\n    result = []\n    for digit in even_single_digits:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n    return result\n\ndef _sort_ascending(digits: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of digits in ascending order.\n    Returns a new list with sorted digits.\n    \"\"\"\n    return sorted(digits)\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    _validate_inputs(a, b) # Call the placeholder validator.\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # Filter for single even digits within the determined range.\n    even_digits = _get_even_digits_in_range(min_val, max_val)\n\n    # Sort the collected even digits in ascending order.\n    return _sort_ascending(even_digits)\n```"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    # Determine the effective range, handling reversed parameters automatically.\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result_digits = []\n    # Iterate through all single digits (0-9) to extract relevant even digits.\n    for digit in range(10):\n        # Include the digit if it falls within the specified range (inclusive) and is even.\n        if min_val <= digit <= max_val and digit % 2 == 0:\n            result_digits.append(digit)\n\n    # Ensure the final list is in ascending order, as specified by the design.\n    result_digits.sort()\n    return result_digits"}
