{"task_id": "HumanEval/74", "solution": "def _calculate_total_chars(lst: list) -> int:\n    \"\"\"Calculates the sum of lengths of all strings in a given list.\n    This function processes an empty list by returning 0.\"\"\"\n    return sum(len(s) for s in lst)\n\ndef _compare_and_select(lst1: list, lst2: list, count1: int, count2: int) -> list:\n    \"\"\"Compares two character counts and returns the corresponding list.\n    If counts are equal, the first list (lst1) is returned.\"\"\"\n    if count1 < count2:\n        return lst1\n    elif count2 < count1:\n        return lst2\n    else: # count1 == count2\n        return lst1\n\ndef total_match(lst1, lst2):\n    \"\"\"Compares two lists of strings by their total character counts.\n    Returns the list with fewer characters, or the first list if counts are equal.\"\"\"\n    count1 = _calculate_total_chars(lst1)\n    count2 = _calculate_total_chars(lst2)\n    return _compare_and_select(lst1, lst2, count1, count2)"}
{"task_id": "HumanEval/74", "solution": "```python\nfrom typing import List\n\ndef calculate_total_characters(string_list: List[str]) -> int:\n    \"\"\"Calculates the total number of characters in a string list.\n    Sums the length of all strings in the provided list.\"\"\"\n    total_chars = 0\n    for s in string_list:\n        total_chars += len(s)\n    return total_chars\n\ndef compare_lists(count1: int, count2: int) -> str:\n    \"\"\"Compares two character counts and determines the relationship.\n    Returns \"first_smaller\", \"second_smaller\", or \"equal\".\"\"\"\n    if count1 < count2:\n        return \"first_smaller\"\n    elif count2 < count1:\n        return \"second_smaller\"\n    else:\n        return \"equal\"\n\ndef select_result(lst1: List[str], lst2: List[str], comparison: str) -> List[str]:\n    \"\"\"Selects the appropriate list based on comparison result and business rules.\n    Applies business rules to return the correct list, including tie-breaking.\"\"\"\n    if comparison == \"first_smaller\":\n        return lst1\n    elif comparison == \"second_smaller\":\n        return lst2\n    else:  # comparison == \"equal\", return the first list as per requirement\n        return lst1\n\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"Accepts two lists of strings and returns the list that has fewer total characters.\n    If counts are equal, the first list is returned according to tie-breaking rules.\"\"\"\n    count1 = calculate_total_characters(lst1)\n    count2 = calculate_total_characters(lst2)\n\n    comparison_result = compare_lists(count1, count2)\n    selected_list = select_result(lst1, lst2, comparison_result)\n    \n    return selected_list\n```"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards.\n    \"\"\"\n\n    # This helper function handles edge cases as described by InputValidator's handle_edge_cases.\n    # It returns 0 for empty or single-element arrays, otherwise None to indicate further processing.\n    def _handle_array_edge_cases(array):\n        if len(array) <= 1:\n            return 0\n        return None\n\n    # This helper function implements the core algorithm, combining PalindromeAnalyzer's\n    # analyze_palindrome, is_palindromic, and count_changes into a single O(n) pass.\n    def _calculate_minimum_changes(array):\n        changes = 0\n        left = 0\n        right = len(array) - 1\n\n        while left < right:\n            # If elements at symmetric positions differ, a change is needed.\n            if array[left] != array[right]:\n                changes += 1\n            left += 1\n            right -= 1\n        return changes\n\n    # Main logic for the smallest_change function.\n    \n    # First, address input validation and edge cases as per the design.\n    edge_case_result = _handle_array_edge_cases(arr)\n    if edge_case_result is not None:\n        return edge_case_result\n\n    # For non-edge cases, calculate the minimum changes required.\n    # This single pass covers both checking if it's already a palindrome (returning 0 changes)\n    # and counting necessary modifications otherwise.\n    return _calculate_minimum_changes(arr)"}
{"task_id": "HumanEval/75", "solution": "def _is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime. Optimized for small integers.\"\"\"\n    if number < 2:\n        return False\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return False\n    return True\n\ndef _get_prime_factors(number: int) -> list[int]:\n    \"\"\"Retrieves the prime factors of a given number by trial division.\"\"\"\n    factors = []\n    temp_number = number\n    d = 2\n    while d <= temp_number:\n        if _is_prime(d) and temp_number % d == 0:\n            factors.append(d)\n            temp_number //= d\n        else:\n            d += 1\n    return factors\n\ndef _validate_input(number: int) -> bool:\n    \"\"\"Validates if the input number is an integer less than 100.\"\"\"\n    return number < 100\n\ndef _count_prime_factors(factors: list[int]) -> int:\n    \"\"\"Counts the number of prime factors in a given list.\"\"\"\n    return len(factors)\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Checks if a number is the product of exactly three prime numbers.\n    The number 'a' must be less than 100.\n    \"\"\"\n    if not _validate_input(a):\n        return False\n\n    prime_factors = _get_prime_factors(a)\n    num_factors = _count_prime_factors(prime_factors)\n\n    return num_factors == 3"}
{"task_id": "HumanEval/75", "solution": "def is_prime(n):\n    \"\"\"Check if a number is prime.\n    It returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef get_prime_factors(n):\n    \"\"\"Generate complete list of prime factors with repetitions.\n    This adheres to the design's explicit calls to `is_prime` for each factor found.\n    \"\"\"\n    factors = []\n    current_n = n\n    d = 2\n    while d <= current_n:\n        if current_n % d == 0:\n            # As per the architecture diagram, explicitly call is_prime for 'd'.\n            if is_prime(d):\n                factors.append(d)\n                current_n //= d\n            else:\n                # If d is composite (which should ideally not happen for smallest divisor), move to next d.\n                d += 1\n        else:\n            # d does not divide current_n, try the next divisor.\n            d += 1\n    return factors\n\ndef validate_input(a):\n    \"\"\"Validate input is positive integer less than 100.\n    Returns True if the input is valid, False otherwise.\n    \"\"\"\n    return 1 <= a < 100\n\ndef count_prime_factors(factors):\n    \"\"\"Count total prime factors including repetitions.\n    Returns the total number of prime factors in the given list.\n    \"\"\"\n    return len(factors)\n\ndef is_multiply_prime(a):\n    \"\"\"Determine if the given number is the product of exactly 3 prime numbers.\n    This orchestrates input validation, prime factorization, and factor counting.\n    \"\"\"\n    if not validate_input(a):\n        return False\n\n    prime_factors = get_prime_factors(a)\n    return count_prime_factors(prime_factors) == 3"}
{"task_id": "HumanEval/77", "solution": "```python\nimport math\n\ndef iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value of 'a' using floating-point arithmetic.\n    cube_root_approx = math.pow(abs(a), 1/3)\n\n    # Round the approximate cube root to the nearest integer.\n    # This integer is the candidate for the exact cube root.\n    candidate_root = round(cube_root_approx)\n\n    # If the original number 'a' was negative, the exact cube root must also be negative.\n    if a < 0:\n        candidate_root = -candidate_root\n\n    # Validate if the cubed candidate root precisely equals the original number 'a'.\n    return candidate_root ** 3 == a\n```"}
{"task_id": "HumanEval/77", "solution": "import math\n\ndef iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    # Calculate the cube root of the input number.\n    cube_root = math.cbrt(a)\n    # Round the floating-point cube root to the nearest integer.\n    rounded_root = round(cube_root)\n    # Check if cubing the rounded integer root reconstructs the original number.\n    return rounded_root ** 3 == a"}
{"task_id": "HumanEval/78", "solution": "def is_prime_hex_digit(digit: str) -> bool:\n    \"\"\"Check if single hex digit is prime.\n    Primes are '2', '3', '5', '7', 'B', 'D'.\n    \"\"\"\n    prime_digits = {'2', '3', '5', '7', 'B', 'D'}\n    return digit in prime_digits\n\ndef hex_key(num: str) -> int:\n    \"\"\"Count prime hexadecimal digits in string.\n    Iterates through the string and uses a helper to identify prime hex digits.\n    \"\"\"\n    count = 0\n    for digit in num:\n        if is_prime_hex_digit(digit):\n            count += 1\n    return count"}
{"task_id": "HumanEval/76", "solution": "import math\n\ndef _validate_inputs(x, n):\n    \"\"\"\n    Validates mathematical properties of inputs to avoid impossible scenarios.\n    Ensures general compatibility for potential power relationships.\n    \"\"\"\n    # If x is 0, n^k=0 implies n=0 (for k>0). If n!=0, then n^k cannot be 0.\n    if x == 0 and n != 0:\n        return False\n    # If x is negative and n is positive, n^k=x is impossible for any integer k.\n    if x < 0 and n >= 0:\n        return False\n    return True\n\ndef _handle_special_cases(x, n):\n    \"\"\"\n    Handles specific edge cases: n=1, x=1, n=0, n=-1.\n    Returns True/False if handled, None for general calculation.\n    \"\"\"\n    # Case: n = 1 (1^k = x implies x must be 1)\n    if n == 1:\n        return x == 1\n    \n    # Case: x = 1 (n^k = 1 implies k=0 for any n; also covers 0^0=1)\n    if x == 1:\n        return True \n    \n    # Case: n = 0 (and x != 1, already handled). 0^k=x implies x must be 0 (for k>0).\n    if n == 0:\n        return x == 0\n    \n    # Case: n = -1 (and x != 1, already handled). (-1)^k=x implies x must be -1 for odd k.\n    if n == -1:\n        return x == -1\n            \n    return None\n\ndef _get_candidate_exponent(base, value):\n    \"\"\"\n    Attempts to calculate an integer exponent k such that base^k = value.\n    Returns the integer k if found and verified, otherwise returns None.\n    \"\"\"\n    epsilon = 1e-9 \n\n    try:\n        # k = log_base(value). Requires base > 0, base != 1, and value > 0.\n        k_float = math.log(value, base)\n    except (ValueError, ZeroDivisionError):\n        # Catches cases like log(negative, positive), log(positive, 0), log(positive, 1)\n        return None\n\n    # Round the floating-point exponent to the nearest integer.\n    k_candidate = round(k_float)\n\n    # Verify if base raised to the candidate integer exponent approximately equals value.\n    if abs(base**k_candidate - value) < epsilon:\n        return k_candidate\n    \n    return None\n\ndef is_simple_power(x, n):\n    \"\"\"\n    Determines if a number x is a simple power of n.\n    Returns true if n**k = x for some integer k, false otherwise.\n    \"\"\"\n    # 1. Basic Input Validation: Checks for mathematically impossible combinations.\n    if not _validate_inputs(x, n):\n        return False\n\n    # 2. Handle Special Cases: Addresses specific values of x or n.\n    special_case_result = _handle_special_cases(x, n)\n    if special_case_result is not None:\n        return special_case_result\n\n    # 3. General Calculation: At this point, n != 0, 1, -1 and x != 0, 1.\n    # From _validate_inputs: if x < 0, then n must be < 0. If x > 0, n can be > 0 or < 0.\n\n    # Case: n > 0 (and n != 1, x != 1, x != 0)\n    # If n > 0, then x must also be > 0 (due to _validate_inputs rule x < 0 and n >= 0 returning False).\n    if n > 0:\n        return _get_candidate_exponent(n, x) is not None\n\n    # Case: n < 0 (and n != -1, x != 0, x != 1)\n    # If n < 0, x can be > 0 (e.g., (-2)^2 = 4) or x < 0 (e.g., (-2)^3 = -8).\n    # We find k such that abs(n)^k = abs(x) and then check k's parity for sign consistency.\n    k_candidate = _get_candidate_exponent(abs(n), abs(x))\n\n    if k_candidate is None:\n        return False \n\n    # If an integer exponent k_candidate is found for absolute values:\n    if k_candidate % 2 == 0:  # k is an even integer\n        # If k is even, n^k will always be positive. So x must be positive.\n        return x > 0\n    else:  # k is an odd integer\n        # If k is odd, n^k will have the same sign as n. So x must be negative (since n < 0 in this branch).\n        return x < 0"}
