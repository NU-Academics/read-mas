{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not (2 <= base < 10):\n        raise ValueError(\"Base must be between 2 and 9 (inclusive).\")\n\n    if x == 0:\n        return \"0\"\n\n    is_negative = x < 0\n    x = abs(x)\n    \n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    result = \"\".join(digits[::-1])\n    if is_negative:\n        result = \"-\" + result\n    \n    return result"}
{"task_id": "HumanEval/47", "solution": "def _sort_list(l: list) -> list:\n    \"\"\"Returns a new sorted list from the input, preserving the original list.\n    This ensures a non-destructive operation on the caller's data.\"\"\"\n    return sorted(l)\n\ndef _calculate_average(num1: (int, float), num2: (int, float)) -> float:\n    \"\"\"Calculates the arithmetic mean of two numeric values.\n    The result is always a float to maintain precision.\"\"\"\n    return (num1 + num2) / 2.0\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = _sort_list(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # Odd length list, return the middle element\n        return sorted_list[n // 2]\n    else:\n        # Even length list, return the average of the two middle elements\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return _calculate_average(mid1, mid2)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"\n    Computes the n-th element of the Fib4 sequence iteratively.\n    Handles base cases and uses a sliding window for n >= 4.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the sliding window with fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from the 4th element up to n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        a, b, c, d = b, c, d, next_fib4\n    \n    return d"}
{"task_id": "HumanEval/46", "solution": "```python\ndef fib4(n: int) -> int:\n    \"\"\"\n    Computes the n-th element of the Fib4 number sequence iteratively.\n    Handles base cases for n=0, 1, 2, 3 and calculates derived cases for n > 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the sliding window with fib4(0), fib4(1), fib4(2), fib4(3) values.\n    # These represent the four most recent Fib4 numbers needed for the next calculation.\n    a, b, c, d = 0, 0, 2, 0 \n\n    # Iterate from the 4th position up to n to compute the sequence iteratively.\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        # Update the sliding window, shifting values to the left and adding the new fib number.\n        a, b, c, d = b, c, d, next_fib\n    \n    # After the loop, 'd' holds the computed fib4(n) value.\n    return d\n```"}
{"task_id": "HumanEval/47", "solution": "```python\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd-length lists, the median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For even-length lists, the median is the average of the two middle elements.\n        # This aligns with the standard median definition for even lists (elements at n/2 - 1 and n/2).\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2\n\n```"}
