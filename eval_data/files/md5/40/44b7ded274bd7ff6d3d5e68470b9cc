{"task_id": "HumanEval/67", "solution": "def validate_string_format(input_string: str) -> bool:\n    \"\"\"\n    Validates if the input string matches the expected format.\n    Checks for the presence of keywords \"apples and\" and \"oranges\".\n    \"\"\"\n    return \"apples and\" in input_string and \"oranges\" in input_string\n\ndef validate_total_fruits(total: int) -> bool:\n    \"\"\"\n    Validates if the total fruit count is a non-negative integer.\n    Ensures the total is not less than zero.\n    \"\"\"\n    return total >= 0\n\ndef extract_numbers(input_string: str) -> list:\n    \"\"\"\n    Extracts all integer numbers from a given string.\n    It iterates through the string to identify and convert numeric sequences.\n    \"\"\"\n    numbers = []\n    current_number_str = \"\"\n    for char in input_string:\n        if '0' <= char <= '9':\n            current_number_str += char\n        else:\n            if current_number_str:\n                numbers.append(int(current_number_str))\n                current_number_str = \"\"\n    if current_number_str: # Add the last number if the string ends with digits.\n        numbers.append(int(current_number_str))\n    return numbers\n\ndef parse_apple_count(input_string: str) -> int:\n    \"\"\"\n    Parses and returns the apple count from the input string.\n    It assumes the apple count is the first number extracted.\n    \"\"\"\n    numbers = extract_numbers(input_string)\n    return numbers[0] if numbers else 0\n\ndef parse_orange_count(input_string: str) -> int:\n    \"\"\"\n    Parses and returns the orange count from the input string.\n    It assumes the orange count is the second number extracted.\n    \"\"\"\n    numbers = extract_numbers(input_string)\n    return numbers[1] if len(numbers) > 1 else 0\n\ndef validate_calculation(total: int, apples: int, oranges: int) -> bool:\n    \"\"\"\n    Validates if the total fruits are sufficient for apples and oranges.\n    Ensures that the total is greater than or equal to the sum of other fruits.\n    \"\"\"\n    return total >= (apples + oranges)\n\ndef calculate_mangos(total: int, apples: int, oranges: int) -> int:\n    \"\"\"\n    Calculates the number of mangoes.\n    It subtracts the counts of apples and oranges from the total fruits.\n    \"\"\"\n    return total - apples - oranges\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits from a string describing apples and oranges\n    and a total fruit count. It orchestrates string parsing and mathematical calculation.\n    \"\"\"\n    # Validation calls as per design, but their boolean returns are not used to control flow due to constraints.\n    _ = validate_string_format(s)\n    _ = validate_total_fruits(n)\n\n    apples = parse_apple_count(s)\n    oranges = parse_orange_count(s)\n\n    # Calculation validation call as per design, but its boolean return is ignored.\n    _ = validate_calculation(n, apples, oranges)\n    mangos = calculate_mangos(n, apples, oranges)\n\n    return mangos"}
{"task_id": "HumanEval/67", "solution": "import re\n\nclass StringParser:\n    \"\"\"\n    StringParser extracts numerical values from formatted strings and validates the string format.\n    It handles specific patterns like 'X apples and Y oranges'.\n    \"\"\"\n    def extractNumber(self, text: str, fruitType: str) -> int:\n        \"\"\"Extracts the number associated with a specific fruit type from the text.\"\"\"\n        match = re.search(r'(\\d+)\\s+' + re.escape(fruitType), text)\n        if match:\n            return int(match.group(1))\n        return 0\n\n    def validateFormat(self, text: str) -> bool:\n        \"\"\"Validates if the text matches the expected format 'X apples and Y oranges'.\"\"\"\n        pattern = r'^\\d+\\s+apples\\s+and\\s+\\d+\\s+oranges$'\n        return bool(re.match(pattern, text))\n\nclass FruitBasket:\n    \"\"\"\n    FruitBasket encapsulates fruit distribution data and manages fruit count properties.\n    It stores counts for apples, oranges, and mangoes, along with the total fruit count.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes a new FruitBasket with all fruit counts set to zero.\"\"\"\n        self._appleCount = 0\n        self._orangeCount = 0\n        self._mangoCount = 0\n        self._totalFruits = 0\n\n    def setAppleCount(self, count: int):\n        \"\"\"Sets the count of apples in the basket.\"\"\"\n        self._appleCount = count\n\n    def setOrangeCount(self, count: int):\n        \"\"\"Sets the count of oranges in the basket.\"\"\"\n        self._orangeCount = count\n\n    def setMangoCount(self, count: int):\n        \"\"\"Sets the count of mangoes in the basket.\"\"\"\n        self._mangoCount = count\n\n    def setTotalFruits(self, count: int):\n        \"\"\"Sets the total number of fruits in the basket.\"\"\"\n        self._totalFruits = count\n\n    def getAppleCount(self) -> int:\n        \"\"\"Returns the number of apples in the basket.\"\"\"\n        return self._appleCount\n\n    def getOrangeCount(self) -> int:\n        \"\"\"Returns the number of oranges in the basket.\"\"\"\n        return self._orangeCount\n\n    def getMangoCount(self) -> int:\n        \"\"\"Returns the number of mangoes in the basket.\"\"\"\n        return self._mangoCount\n\n    def getTotalFruits(self) -> int:\n        \"\"\"Returns the total number of fruits in the basket.\"\"\"\n        return self._totalFruits\n\nclass FruitDistributionCalculator:\n    \"\"\"\n    FruitDistributionCalculator orchestrates fruit calculation, validates business rules,\n    and implements core business logic for mango calculation.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the calculator with a StringParser instance.\"\"\"\n        self.parser = StringParser()\n\n    def parseAppleCount(self, fruitString: str) -> int:\n        \"\"\"Parses and returns the apple count from the fruit string.\"\"\"\n        return self.parser.extractNumber(fruitString, \"apples\")\n\n    def parseOrangeCount(self, fruitString: str) -> int:\n        \"\"\"Parses and returns the orange count from the fruit string.\"\"\"\n        return self.parser.extractNumber(fruitString, \"oranges\")\n\n    def _validateInput(self, fruitString: str, totalFruits: int) -> bool:\n        \"\"\"Validates the input string format.\"\"\"\n        return self.parser.validateFormat(fruitString)\n\n    def calculateMangos(self, fruitString: str, totalFruits: int) -> int:\n        \"\"\"\n        Calculates the number of mango fruits given the string of apples and oranges\n        and the total fruit count.\n        \"\"\"\n        self._validateInput(fruitString, totalFruits)\n\n        apple_count = self.parseAppleCount(fruitString)\n        orange_count = self.parseOrangeCount(fruitString)\n\n        basket = FruitBasket()\n        basket.setAppleCount(apple_count)\n        basket.setOrangeCount(orange_count)\n        basket.setTotalFruits(totalFruits)\n\n        mango_count = totalFruits - apple_count - orange_count\n        basket.setMangoCount(mango_count)\n\n        return basket.getMangoCount()\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket given the counts of apples and oranges\n    through string parsing and mathematical computation.\n    \"\"\"\n    calculator = FruitDistributionCalculator()\n    return calculator.calculateMangos(s, n)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Main entry point to find the smallest even value and its first index in an array.\n    Orchestrates helper functions for validation, filtering, and finding.\n    \"\"\"\n    if not _validate_input(arr):\n        # This branch might only be hit if length > 10000, as empty array returns True for validation.\n        return []\n\n    even_values_with_indices = _find_even_values(arr)\n\n    if not even_values_with_indices:\n        # Handles empty input array and arrays with no even values.\n        return []\n\n    smallest_even_value = _find_smallest_even(even_values_with_indices)\n    first_index = _find_first_index(even_values_with_indices, smallest_even_value)\n\n    return [smallest_even_value, first_index]\n\n\ndef _validate_input(arr):\n    \"\"\"\n    Validates the input array's length against system constraints.\n    Assumes elements are non-negative integers as per design and critical requirements.\n    \"\"\"\n    # The design specifies array length 0 to 10,000.\n    return len(arr) <= 10000\n\n\ndef _find_even_values(arr):\n    \"\"\"\n    Iterates through the array to collect all even values along with their original indices.\n    Returns a list of (value, index) tuples for all even numbers found.\n    \"\"\"\n    even_candidates = []\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            even_candidates.append((value, i))\n    return even_candidates\n\n\ndef _find_smallest_even(even_values):\n    \"\"\"\n    Determines the smallest numerical value from a list of (value, index) tuples.\n    This function assumes the input list 'even_values' is not empty.\n    \"\"\"\n    min_val = even_values[0][0]  # Initialize with the first even value's magnitude.\n    for value, _ in even_values:\n        if value < min_val:\n            min_val = value\n    return min_val\n\n\ndef _find_first_index(even_values, smallest_value):\n    \"\"\"\n    Locates the first occurrence index of a specific smallest_value within the even_values list.\n    Prioritizes the smallest index if multiple occurrences exist by returning the first match found.\n    \"\"\"\n    for value, index in even_values:\n        if value == smallest_value:\n            return index\n    # This point should theoretically not be reached if smallest_value came from even_values.\n    return -1"}
{"task_id": "HumanEval/69", "solution": "def validate_input(lst):\n    \"\"\"Ensures input meets positive integer and non-empty requirements.\"\"\"\n    if not lst:\n        return False\n    for x in lst:\n        if x <= 0:\n            return False\n    return True\n\ndef count_frequencies(lst):\n    \"\"\"Creates a frequency mapping for all integers in the list.\"\"\"\n    frequencies = {}\n    for x in lst:\n        frequencies[x] = frequencies.get(x, 0) + 1\n    return frequencies\n\ndef find_qualifying_integers(frequencies):\n    \"\"\"Identifies integers where frequency is greater than or equal to their value.\"\"\"\n    candidates = []\n    for val, freq in frequencies.items():\n        if freq >= val:\n            candidates.append(val)\n    return candidates\n\ndef get_maximum(candidates):\n    \"\"\"Selects the greatest value from qualifying candidates, or -1 if none.\"\"\"\n    if not candidates:\n        return -1\n    return max(candidates)\n\ndef search(lst):\n    \"\"\"Main algorithm entry point implementing the complete search logic.\"\"\"\n    if not validate_input(lst):\n        return -1\n\n    frequencies = count_frequencies(lst)\n    qualifying_candidates = find_qualifying_integers(frequencies)\n    result = get_maximum(qualifying_candidates)\n    return result"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n\n    def calculate_frequencies(input_list):\n        '''Calculates the frequency of each integer in the input list.'''\n        frequencies = {}\n        for num in input_list:\n            frequencies[num] = frequencies.get(num, 0) + 1\n        return frequencies\n\n    def find_qualifying_integers(frequencies_map):\n        '''Identifies integers whose frequency is greater than or equal to their value.'''\n        qualifying = []\n        for integer, frequency in frequencies_map.items():\n            if frequency >= integer:\n                qualifying.append(integer)\n        return qualifying\n\n    def get_maximum_or_default(candidates_list):\n        '''Returns the maximum integer from the candidates list or -1 if the list is empty.'''\n        if not candidates_list:\n            return -1\n        return max(candidates_list)\n\n    # Main algorithm orchestration\n    frequencies = calculate_frequencies(lst)\n    qualifying_integers = find_qualifying_integers(frequencies)\n    result = get_maximum_or_default(qualifying_integers)\n    \n    return result"}
{"task_id": "HumanEval/68", "solution": "def format_result(value, index):\n    \"\"\"Formats a successful result as a list [value, index].\"\"\"\n    return [value, index]\n\ndef format_empty_result():\n    \"\"\"Formats an empty result for edge cases.\"\"\"\n    return []\n\ndef is_non_negative_integer(value):\n    \"\"\"Placeholder for non-negative integer validation; assumes valid input.\"\"\"\n    return True\n\ndef check_array_size(arr):\n    \"\"\"Placeholder for array size validation; assumes valid input.\"\"\"\n    return True\n\ndef validate_array(arr):\n    \"\"\"Placeholder for overall array validation; assumes valid input.\"\"\"\n    return True\n\ndef find_even_values(arr):\n    \"\"\"Identifies even values and their zero-based indices from the input array.\"\"\"\n    even_candidates = []\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            even_candidates.append((value, i))\n    return even_candidates\n\ndef find_minimum_value(candidates):\n    \"\"\"Finds the smallest value from a list of (value, index) tuples.\"\"\"\n    if not candidates:\n        return None\n    min_val = candidates[0][0]\n    for val, _ in candidates:\n        if val < min_val:\n            min_val = val\n    return min_val\n\ndef resolve_index_ties(candidates, min_value):\n    \"\"\"Resolves index precedence for the smallest even value among candidates.\"\"\"\n    min_index = -1\n    for val, idx in candidates:\n        if val == min_value:\n            if min_index == -1 or idx < min_index:\n                min_index = idx\n    return min_index\n\ndef process_array(arr):\n    \"\"\"Implements core logic to find the smallest even value with index precedence.\"\"\"\n    even_candidates = find_even_values(arr)\n\n    if not even_candidates:\n        return None\n\n    smallest_even_value = find_minimum_value(even_candidates)\n    smallest_index = resolve_index_ties(even_candidates, smallest_even_value)\n    \n    return (smallest_even_value, smallest_index)\n\ndef _find_smallest_even(arr):\n    \"\"\"Orchestrates the core algorithm logic by delegating to ArrayProcessor.\"\"\"\n    return process_array(arr)\n\ndef _validate_input(arr):\n    \"\"\"Performs input array validation by delegating to InputValidator (no-op).\"\"\"\n    return validate_array(arr)\n\ndef pluck(arr):\n    \"\"\"\n    Given an array of non-negative integers, returns the smallest even value\n    and its zero-based index as [value, index], prioritizing smallest index in ties.\n    Returns [] if the array is empty or contains no even values.\n    \"\"\"\n    _validate_input(arr)\n\n    if not arr:\n        return format_empty_result()\n\n    result_tuple = _find_smallest_even(arr)\n\n    if result_tuple is None:\n        return format_empty_result()\n    else:\n        return format_result(result_tuple[0], result_tuple[1])"}
{"task_id": "HumanEval/70", "solution": "def _find_minimum(elements: list[int]) -> int:\n    \"\"\"Finds the minimum value in a list of integers.\"\"\"\n    return min(elements)\n\ndef _find_maximum(elements: list[int]) -> int:\n    \"\"\"Finds the maximum value in a list of integers.\"\"\"\n    return max(elements)\n\ndef _remove_first_occurrence(elements: list[int], value: int) -> list[int]:\n    \"\"\"Returns a new list with the first occurrence of value removed.\"\"\"\n    new_elements = []\n    removed = False\n    for item in elements:\n        if item == value and not removed:\n            removed = True\n        else:\n            new_elements.append(item)\n    return new_elements\n\ndef strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers using an alternating minimum-maximum selection.\n    Preserves the original list and handles edge cases.\n    \"\"\"\n    if not lst:\n        return []\n\n    result = []\n    remaining = list(lst) # Create a mutable copy to work with\n    is_min_turn = True\n\n    while remaining:\n        if is_min_turn:\n            current_value = _find_minimum(remaining)\n        else:\n            current_value = _find_maximum(remaining)\n        \n        result.append(current_value)\n        remaining = _remove_first_occurrence(remaining, current_value)\n        is_min_turn = not is_min_turn\n    \n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    result = []\n    remaining = lst.copy()\n    is_min_turn = True\n\n    while remaining:\n        if is_min_turn:\n            next_val = min(remaining)\n        else:\n            next_val = max(remaining)\n        \n        result.append(next_val)\n        remaining.remove(next_val)\n        is_min_turn = not is_min_turn\n        \n    return result"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    '''\n    # Validate triangle geometry: sides must be positive and obey the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and \\\n            a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter (s) as required for Heron's formula.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    # The term under the square root might be slightly negative due to floating-point inaccuracies for near-degenerate triangles; we cap it at zero.\n    area_squared_term = s * (s - a) * (s - b) * (s - c)\n    if area_squared_term < 0:\n        area_squared_term = 0 # This ensures we don't take the square root of a negative number.\n\n    area = area_squared_term**0.5\n\n    # Return the calculated area rounded to exactly two decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef validate_triangle_inequality(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Validates that three sides can form a valid triangle.\n    Checks if the sum of any two sides is greater than the third side.\n    \"\"\"\n    return (a + b > c) and \\\n           (a + c > b) and \\\n           (b + c > a)\n\ndef calculate_area_heron(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates triangle area using Heron's formula.\n    It expects a valid triangle configuration for a real-valued area.\n    \"\"\"\n    s = (a + b + c) / 2\n    # The term under the square root should always be non-negative for a valid triangle.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    return math.sqrt(area_squared)\n\ndef round_to_two_decimals(value: float) -> float:\n    \"\"\"\n    Rounds a numeric value to exactly 2 decimal places.\n    This uses Python's built-in `round` function.\n    \"\"\"\n    return round(value, 2)\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return its area.\n    Returns -1 if the sides do not form a valid triangle according to inequality constraints.\n    \"\"\"\n    if not validate_triangle_inequality(a, b, c):\n        return -1\n    \n    area = calculate_area_heron(a, b, c)\n    return round_to_two_decimals(area)"}
{"task_id": "HumanEval/72", "solution": "def is_palindrome(lst):\n    \"\"\"Checks if a list is palindromic using a two-pointer approach for O(1) space.\n    An empty or single-element list is considered palindromic.\"\"\"\n    left = 0\n    right = len(lst) - 1\n    while left < right:\n        if lst[left] != lst[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n\ndef calculate_sum(lst):\n    \"\"\"Calculates the sum of all numeric elements in a list.\n    Returns 0 for an empty list.\"\"\"\n    total = 0\n    for item in lst:\n        total += item\n    return total\n\ndef will_it_fly(q, w):\n    \"\"\"\n    Checks if an object can fly based on palindromic balance and weight constraints.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    balanced = is_palindrome(q)\n    total_weight = calculate_sum(q)\n    within_weight_limit = total_weight <= w\n\n    return balanced and within_weight_limit"}
{"task_id": "HumanEval/72", "solution": "def is_palindromic(lst):\n    \"\"\"\n    Checks if a list is palindromic.\n    Empty lists and single-element lists are considered palindromic.\n    \"\"\"\n    return lst == lst[::-1]\n\ndef calculate_sum(lst):\n    \"\"\"\n    Calculates the sum of all numeric elements in a list.\n    \"\"\"\n    return sum(lst)\n\ndef validate_conditions(is_balanced, weight_valid):\n    \"\"\"\n    Evaluates if both balance and weight conditions are met for flight.\n    \"\"\"\n    return is_balanced and weight_valid\n\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q can fly based on balance and weight constraints.\n    The object flies if it's palindromic and its total weight does not exceed w.\n    \"\"\"\n    is_balanced = is_palindromic(q)\n    total_weight = calculate_sum(q)\n    weight_valid = (total_weight <= w)\n    can_fly = validate_conditions(is_balanced, weight_valid)\n    return can_fly"}
