{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), using None if a category is absent.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num == 0:\n            continue\n        elif num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        else:  # num > 0\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/139", "solution": "def _factorial(num):\n    \"\"\"Calculate standard factorial of a number.\"\"\"\n    result = 1\n    for i in range(1, num + 1):\n        result *= i\n    return result\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    special_product = 1\n    for i in range(n, 0, -1):\n        current_factorial = _factorial(i)\n        special_product *= current_factorial\n    return special_product"}
{"task_id": "HumanEval/137", "solution": "def handle_decimal_separators(str_value):\n    \"\"\"Normalizes decimal separators from comma to period.\"\"\"\n    return str_value.replace(',', '.')\n\ndef convert_string_to_float(str_value):\n    \"\"\"Converts a string representation to float, handling comma decimal separators.\"\"\"\n    normalized_str = handle_decimal_separators(str_value)\n    return float(normalized_str)\n\ndef are_equal(val1, val2):\n    \"\"\"Compares two numeric values with a small floating-point tolerance.\"\"\"\n    epsilon = 1e-9 \n    return abs(val1 - val2) < epsilon\n\ndef normalize_value(value):\n    \"\"\"Converts input to numeric form while preserving its original value.\"\"\"\n    if isinstance(value, str):\n        numeric_value = convert_string_to_float(value)\n        return value, numeric_value\n    else:\n        return value, float(value)\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numeric values, preserving original data types,\n    and returns the larger value or None if equal.\n    \"\"\"\n    original_a, numeric_a = normalize_value(a)\n    original_b, numeric_b = normalize_value(b)\n\n    if are_equal(numeric_a, numeric_b):\n        return None\n    elif numeric_a > numeric_b:\n        return original_a\n    else:\n        return original_b"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if n % 2 != 0 or n < 8:\n        return False\n\n    # Iterate through combinations of four positive even numbers.\n    # The smallest possible sum of four positive even numbers is 2+2+2+2 = 8.\n    # To avoid duplicate combinations, we ensure e1 <= e2 <= e3 <= e4.\n    for e1 in range(2, n - 5, 2):  # e1 can be at most n - 2 - 2 - 2 = n - 6\n        for e2 in range(e1, n - e1 - 3, 2): # e2 can be at most n - e1 - 2 - 2 = n - e1 - 4\n            for e3 in range(e2, n - e1 - e2 - 1, 2): # e3 can be at most n - e1 - e2 - 2\n                e4 = n - e1 - e2 - e3\n                if e4 > 0 and e4 % 2 == 0 and e4 >= e3:\n                    return True\n    return False"}
{"task_id": "HumanEval/137", "solution": "```python\ndef parse_numeric_string(value):\n    \"\"\"Replaces comma decimal separators with periods in a string.\"\"\"\n    return value.replace(',', '.')\n\ndef convert_to_numeric(value):\n    \"\"\"Converts a numeric value or a parsed numeric string to a float.\"\"\"\n    return float(value)\n\ndef preserve_original_type(numeric_value, original_value):\n    \"\"\"Casts a numeric value back to the original value's type, preserving string decimal format.\"\"\"\n    if isinstance(original_value, int):\n        return int(numeric_value)\n    elif isinstance(original_value, float):\n        return float(numeric_value)\n    elif isinstance(original_value, str):\n        str_value = str(numeric_value)\n        if ',' in original_value:\n            return str_value.replace('.', ',')\n        else:\n            return str_value\n    # Trusting the caller's inputs, so no default else case needed for unknown types.\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numeric values (int, float, or string) and returns the larger\n    in its original type, or None if equal.\n    \"\"\"\n    a_original = a\n    b_original = b\n\n    a_numeric_ready = a\n    if isinstance(a, str):\n        a_numeric_ready = parse_numeric_string(a)\n    a_numeric = convert_to_numeric(a_numeric_ready)\n\n    b_numeric_ready = b\n    if isinstance(b, str):\n        b_numeric_ready = parse_numeric_string(b)\n    b_numeric = convert_to_numeric(b_numeric_ready)\n\n    if a_numeric == b_numeric:\n        return None\n    elif a_numeric > b_numeric:\n        return preserve_original_type(a_numeric, a_original)\n    else:\n        return preserve_original_type(b_numeric, b_original)\n```"}
{"task_id": "HumanEval/139", "solution": "def _factorial(num: int) -> int:\n    \"\"\"Calculates the standard factorial of a non-negative integer.\"\"\"\n    if num == 0 or num == 1:\n        return 1\n    \n    product = 1\n    for i in range(2, num + 1):\n        product *= i\n    return product\n\ndef _validate_input(n: int) -> bool:\n    \"\"\"Validates if the input n is a positive integer.\"\"\"\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n    return True\n\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    _validate_input(n)\n\n    special_fact_result = 1\n    for i in range(n, 0, -1):\n        current_factorial = _factorial(i)\n        special_fact_result *= current_factorial\n    \n    return special_fact_result"}
{"task_id": "HumanEval/138", "solution": "def is_even(num):\n    \"\"\"Checks if a number is positive and even.\"\"\"\n    return num > 0 and num % 2 == 0\n\ndef generate_even_combinations(target, count):\n    \"\"\"Checks if the target can be formed by summing exactly 'count' positive even numbers.\"\"\"\n    # The requirement specifies exactly 4 numbers for the sum.\n    if count != 4:\n        return False\n    \n    # The smallest sum of 4 positive even numbers is 2+2+2+2 = 8.\n    # The sum of four even numbers must also be an even number.\n    if target < 8 or target % 2 != 0:\n        return False\n\n    # Iterate through possible combinations of four positive even numbers.\n    # e1 can range from 2 up to target minus the minimums of the other three (2*3=6).\n    for e1 in range(2, target - 2*3 + 1, 2):\n        # e2 can range from 2 up to target - e1 minus the minimums of the other two (2*2=4).\n        for e2 in range(2, target - e1 - 2*2 + 1, 2):\n            # e3 can range from 2 up to target - e1 - e2 minus the minimum of the last one (2*1=2).\n            for e3 in range(2, target - e1 - e2 - 2 + 1, 2):\n                e4 = target - e1 - e2 - e3\n                # Check if the derived fourth number (e4) is positive and even.\n                if is_even(e4):\n                    return True\n    return False\n\ndef validate_integer(n):\n    \"\"\"Validates if the input is a suitable integer type.\"\"\"\n    # As per design, trust the caller's input and perform no type checks.\n    return True\n\ndef is_valid_input(n):\n    \"\"\"Performs comprehensive validation for the target number n.\"\"\"\n    # The target n must be at least 8 (2+2+2+2) and must also be an even number.\n    return validate_integer(n) and n >= 8 and n % 2 == 0\n\ndef can_form_sum(target, count):\n    \"\"\"Determines if the target can be formed from 'count' positive even numbers.\"\"\"\n    # This function delegates the core combination generation logic.\n    return generate_even_combinations(target, count)\n\ndef evaluate_combinations(n):\n    \"\"\"Orchestrates the combination evaluation process for the number n.\"\"\"\n    # This calls the sum formation logic with the required count of 4.\n    return can_form_sum(n, 4)\n\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    # First, validate the input number n itself, then evaluate combinations if valid.\n    if not is_valid_input(n):\n        return False\n    return evaluate_combinations(n)"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces single spaces with underscores and sequences of 3+ spaces with a single dash.\n    This function processes text transformations in-memory without external dependencies.\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single dash.\n    processed_text = re.sub(r' {3,}', '-', text)\n    # Then, replace any remaining single spaces with underscores.\n    processed_text = re.sub(r' ', '_', processed_text)\n    return processed_text"}
{"task_id": "HumanEval/140", "solution": "def _replace_space_sequence(sequence: str) -> str:\n    \"\"\"Helper to determine replacement character for a space sequence.\"\"\"\n    if len(sequence) <= 2:\n        return \"_\"\n    else:\n        return \"-\"\n\ndef _detect_space_sequences(text: str) -> list:\n    \"\"\"\n    Helper to identify and segment parts of the text into non-space and space sequences.\n    Returns a list of (segment_text, is_space_sequence) tuples.\n    \"\"\"\n    segments = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] == ' ':\n            j = i\n            while j < n and text[j] == ' ':\n                j += 1\n            segments.append((text[i:j], True))\n            i = j\n        else:\n            j = i\n            while j < n and text[j] != ' ':\n                j += 1\n            segments.append((text[i:j], False))\n            i = j\n    return segments\n\ndef _process_text_segments(text: str) -> str:\n    \"\"\"\n    Helper to process detected text segments and apply space replacement rules.\n    This function orchestrates pattern detection and replacement.\n    \"\"\"\n    segments = _detect_space_sequences(text)\n    processed_parts = []\n    for segment_text, is_space_sequence in segments:\n        if is_space_sequence:\n            processed_parts.append(_replace_space_sequence(segment_text))\n        else:\n            processed_parts.append(segment_text)\n    return \"\".join(processed_parts)\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Process input text by replacing space patterns according to specified rules.\n\n    Args:\n        text (str): Input string to process\n\n    Returns:\n        str: Processed string with space replacements applied\n    \"\"\"\n    return _process_text_segments(text)"}
{"task_id": "HumanEval/141", "solution": "def _is_latin_letter(char: str) -> bool:\n    \"\"\"Check if character is a latin alphabet letter.\"\"\"\n    return ('a' <= char <= 'z') or ('A' <= char <= 'Z')\n\ndef _is_digit(char: str) -> bool:\n    \"\"\"Check if character is a digit 0-9.\"\"\"\n    return '0' <= char <= '9'\n\ndef _count_digits(name: str) -> int:\n    \"\"\"Count digits in the file name.\"\"\"\n    digit_count = 0\n    for char in name:\n        if _is_digit(char):\n            digit_count += 1\n    return digit_count\n\ndef _has_exactly_one_dot(name: str) -> bool:\n    \"\"\"Check if file name has exactly one dot.\"\"\"\n    return name.count('.') == 1\n\ndef _validate_prefix(prefix: str) -> bool:\n    \"\"\"Validate prefix is non-empty and starts with letter.\"\"\"\n    if not prefix:\n        return False\n    return _is_latin_letter(prefix[0])\n\ndef _validate_extension(extension: str) -> bool:\n    \"\"\"Validate extension is in allowed list.\"\"\"\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    return extension in ALLOWED_EXTENSIONS\n\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Validates a file name according to specified rules.\n    Returns 'Yes' if valid, 'No' if invalid.\n    \"\"\"\n    # Rule: Maximum of three digits\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    # Rule: Exactly one dot\n    if not _has_exactly_one_dot(file_name):\n        return 'No'\n\n    # Split into prefix and extension\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule: Non-empty prefix that starts with a latin alphabet letter\n    if not _validate_prefix(prefix):\n        return 'No'\n\n    # Rule: Extension must be one of 'txt', 'exe', 'dll'\n    if not _validate_extension(extension):\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def _count_digits(file_name: str) -> int:\n    \"\"\"Counts the number of digit characters (0-9) in a string.\n    Used to enforce the maximum digit count rule.\"\"\"\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    return digit_count\n\ndef _validate_dot_count(file_name: str) -> bool:\n    \"\"\"Checks if the file name contains exactly one dot character.\n    This ensures proper separation of prefix and extension.\"\"\"\n    return file_name.count('.') == 1\n\ndef _validate_prefix(prefix: str) -> bool:\n    \"\"\"Validates the file name prefix: non-empty and starts with a latin letter.\n    Ensures a meaningful and correctly formatted file name beginning.\"\"\"\n    if not prefix:\n        return False\n    first_char = prefix[0]\n    return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\ndef _validate_extension(extension: str) -> bool:\n    \"\"\"Verifies if the file extension is one of the allowed types.\n    The allowed extensions are 'txt', 'exe', and 'dll'.\"\"\"\n    allowed_extensions = ['txt', 'exe', 'dll']\n    return extension in allowed_extensions\n\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules.\n    Returns 'Yes' for valid names, 'No' otherwise.\"\"\"\n\n    # Validate exactly one dot character presence\n    if not _validate_dot_count(file_name):\n        return 'No'\n\n    # Split the file name into prefix and extension after confirming a single dot\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Verify non-empty prefix starting with latin alphabet letter\n    if not _validate_prefix(prefix):\n        return 'No'\n\n    # Confirm extension is one of: txt, exe, or dll\n    if not _validate_extension(extension):\n        return 'No'\n        \n    # Ensure maximum of three digit characters (0-9)\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    # If all validation checks pass\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def _is_multiple_of_3(index):\n    \"\"\"Checks if an index is a multiple of 3.\"\"\"\n    return index % 3 == 0\n\ndef _is_multiple_of_4(index):\n    \"\"\"Checks if an index is a multiple of 4.\"\"\"\n    return index % 4 == 0\n\ndef _square_value(value):\n    \"\"\"Returns the square of a given value.\"\"\"\n    return value * value\n\ndef _cube_value(value):\n    \"\"\"Returns the cube of a given value.\"\"\"\n    return value * value * value\n\ndef sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, applying transformations based on index and returns the sum.\n    Indexes that are multiples of 3 are squared; multiples of 4 (but not 3) are cubed.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if _is_multiple_of_3(index):\n            total_sum += _square_value(value)\n        elif _is_multiple_of_4(index):\n            total_sum += _cube_value(value)\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "```python\nfrom typing import List\n\ndef sum_squares(lst: List[int]) -> int:\n    \"\"\"\n    This function processes a list of integers, applying conditional transformations based on index.\n    It then returns the sum of all processed entries.\n    \"\"\"\n\n    # Helper functions for IntegerList module\n    def is_empty(input_list: List[int]) -> bool:\n        \"\"\"Checks if the given list is empty.\"\"\"\n        return len(input_list) == 0\n\n    # Helper functions for MathOperations module\n    def square(value: int) -> int:\n        \"\"\"Squares an integer value (n\u00b2).\"\"\"\n        return value * value\n\n    def cube(value: int) -> int:\n        \"\"\"Cubes an integer value (n\u00b3).\"\"\"\n        return value * value * value\n\n    def sum_list(values: List[int]) -> int:\n        \"\"\"Calculates the sum of all values in a list.\"\"\"\n        current_sum = 0\n        for val in values:\n            current_sum += val\n        return current_sum\n\n    # Helper functions for IndexProcessor module\n    def is_multiple_of_3(index: int) -> bool:\n        \"\"\"Checks if an index is a multiple of 3.\"\"\"\n        return index % 3 == 0\n\n    def is_multiple_of_4(index: int) -> bool:\n        \"\"\"Checks if an index is a multiple of 4.\"\"\"\n        return index % 4 == 0\n\n    def should_square(index: int) -> bool:\n        \"\"\"Determines if an entry at the given index should be squared.\"\"\"\n        return is_multiple_of_3(index)\n\n    def should_cube(index: int) -> bool:\n        \"\"\"Determines if an entry at the given index should be cubed.\"\"\"\n        # Cube if it's a multiple of 4 and not a multiple of 3.\n        return is_multiple_of_4(index) and not is_multiple_of_3(index)\n\n    # Main processing logic\n    if is_empty(lst):\n        return 0\n\n    processed_values = []\n    for i, value in enumerate(lst):\n        if should_square(i):\n            processed_values.append(square(value))\n        elif should_cube(i):\n            processed_values.append(cube(value))\n        else:\n            processed_values.append(value) # Leave entry unchanged\n\n    return sum_list(processed_values)\n```"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime character lengths.\n    Maintains original word order and returns a space-separated string.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"\n        Checks if a given number is a prime number.\n        Returns True for prime numbers, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words in a sentence, returning only those with prime character lengths.\n    Maintains original word order and handles various spacing scenarios.\n    \"\"\"\n\n    def validate_input(s: str) -> bool:\n        \"\"\"\n        Validates the input string's length and character set.\n        Assumes valid input will be provided as per problem constraints.\n        \"\"\"\n        # The design specifies this component, but as per critical requirements,\n        # we trust the caller's inputs and assume validation passes.\n        # Original constraints: 1 <= len(sentence) <= 100, contains only letters and spaces.\n        return True\n\n    def split_into_words(s: str) -> list[str]:\n        \"\"\"\n        Splits a sentence into a list of words, handling multiple spaces.\n        Empty strings from extra spaces are removed.\n        \"\"\"\n        return [word for word in s.split(' ') if word]\n\n    def calculate_word_length(word: str) -> int:\n        \"\"\"\n        Calculates the character length of a given word.\n        \"\"\"\n        return len(word)\n\n    def is_prime(number: int) -> bool:\n        \"\"\"\n        Determines if a given number is a prime number.\n        Handles base cases for 0, 1, and 2 efficiently.\n        \"\"\"\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    def filter_prime_words(words: list[str]) -> list[str]:\n        \"\"\"\n        Filters a list of words, keeping only those whose lengths are prime numbers.\n        It uses the calculate_word_length and is_prime functions internally.\n        \"\"\"\n        prime_length_words = []\n        for word in words:\n            length = calculate_word_length(word)\n            if is_prime(length):\n                prime_length_words.append(word)\n        return prime_length_words\n\n    def format_output(words: list[str]) -> str:\n        \"\"\"\n        Formats a list of words into a single space-separated string.\n        Returns an empty string if the input list is empty.\n        \"\"\"\n        return ' '.join(words)\n\n    # Input Layer\n    _ = validate_input(sentence) # We assume validation passes as per critical requirements\n\n    # Processing Layer\n    words = split_into_words(sentence)\n\n    # Filtering Layer\n    filtered_words = filter_prime_words(words)\n\n    # Output Layer\n    return format_output(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Determines if the multiplication of two string-represented fractions results in a whole number.\n    It orchestrates parsing, multiplication, and whole number validation.\n    \"\"\"\n\n    def parse_fraction(fraction_str: str) -> tuple[int, int]:\n        \"\"\"\n        Parses a fraction string into its numerator and denominator integers.\n        Assumes valid \"numerator/denominator\" format.\n        \"\"\"\n        parts = fraction_str.split('/')\n        return int(parts[0]), int(parts[1])\n\n    def multiply_fractions(num1: int, den1: int, num2: int, den2: int) -> tuple[int, int]:\n        \"\"\"\n        Multiplies two fractions given their numerators and denominators.\n        Returns the resulting fraction as a tuple (numerator, denominator).\n        \"\"\"\n        result_numerator = num1 * num2\n        result_denominator = den1 * den2\n        return result_numerator, result_denominator\n\n    def is_whole_number(numerator: int, denominator: int) -> bool:\n        \"\"\"\n        Checks if a fraction represents a whole number.\n        Returns True if the numerator is evenly divisible by the denominator.\n        \"\"\"\n        return numerator % denominator == 0\n\n    num_x, den_x = parse_fraction(x)\n    num_n, den_n = parse_fraction(n)\n\n    result_num, result_den = multiply_fractions(num_x, den_x, num_n, den_n)\n\n    return is_whole_number(result_num, result_den)"}
{"task_id": "HumanEval/144", "solution": "def parse_fraction(fraction: str) -> tuple[int, int]:\n    \"\"\"Parses a fraction string into its numerator and denominator.\n    Assumes valid input format \"numerator/denominator\".\n    \"\"\"\n    numerator_str, denominator_str = fraction.split('/')\n    return int(numerator_str), int(denominator_str)\n\ndef multiply_fractions(f1: tuple[int, int], f2: tuple[int, int]) -> tuple[int, int]:\n    \"\"\"Multiplies two fractions represented as (numerator, denominator) tuples.\n    Returns a new tuple representing the product.\n    \"\"\"\n    num1, den1 = f1\n    num2, den2 = f2\n    return num1 * num2, den1 * den2\n\ndef is_whole_number(fraction: tuple[int, int]) -> bool:\n    \"\"\"Checks if a fraction tuple represents a whole number.\n    Returns True if the numerator is perfectly divisible by the denominator.\n    \"\"\"\n    numerator, denominator = fraction\n    return numerator % denominator == 0\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Checks if the multiplication of two fractions x and n results in a whole number.\n    Returns True if x * n is a whole number, False otherwise.\n    \"\"\"\n    fraction1 = parse_fraction(x)\n    fraction2 = parse_fraction(n)\n    product_fraction = multiply_fractions(fraction1, fraction2)\n    return is_whole_number(product_fraction)"}
{"task_id": "HumanEval/145", "solution": "```python\ndef digit_sum(num: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for a given integer using its absolute value.\n    This helper function processes numbers by converting them to strings to sum their digits.\n    \"\"\"\n    abs_num = abs(num)\n    return sum(int(d) for d in str(abs_num))\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits in ascending order.\n    If digit sums are identical, elements are ordered based on their original index for stability.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Pair each number with its original index to ensure stable sorting based on original position.\n    indexed_nums = list(enumerate(nums))\n\n    # Sort the paired items using a lambda key that prioritizes digit sum, then original index.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (digit_sum(item[1]), item[0]))\n\n    # Extract only the numbers from the stably sorted list of (index, number) pairs.\n    return [num for _, num in sorted_indexed_nums]\n```"}
{"task_id": "HumanEval/145", "solution": "class IntegerData:\n    \"\"\"\n    A data structure to hold an integer value along with its original index\n    and calculated digit sum for sorting purposes.\n    \"\"\"\n    def __init__(self, value: int, original_index: int, digit_sum: int):\n        self.value = value\n        self.original_index = original_index\n        self.digit_sum = digit_sum\n\n    def __repr__(self) -> str:\n        \"\"\"\n        Provides a string representation for debugging IntegerData objects.\n        \"\"\"\n        return f\"IntegerData(value={self.value}, index={self.original_index}, sum={self.digit_sum})\"\n\ndef _extract_digits(number: int) -> list[int]:\n    \"\"\"\n    Extracts individual digits from a non-negative integer.\n    E.g., 123 -> [1, 2, 3]; 0 -> [0].\n    \"\"\"\n    if number == 0:\n        return [0]\n    digits = []\n    temp_num = number\n    while temp_num > 0:\n        digits.append(temp_num % 10)\n        temp_num //= 10\n    return digits[::-1]\n\ndef calculate_digit_sum(number: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for an integer, handling negative numbers\n    by applying the negative sign only to the first digit.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    is_negative = number < 0\n    abs_number = abs(number)\n    digits = _extract_digits(abs_number)\n\n    if is_negative and digits:\n        digits[0] *= -1\n\n    return sum(digits)\n\ndef sort_by_digit_sum(integers_with_data: list) -> list: # list[IntegerData]\n    \"\"\"\n    Sorts a list of IntegerData objects stably, first by digit sum,\n    then by original index to preserve order.\n    \"\"\"\n    # Python's built-in sort is stable.\n    sorted_data = sorted(integers_with_data, key=lambda item: (item.digit_sum, item.original_index))\n    return sorted_data\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    maintaining stability for equal digit sums by original index.\n    \"\"\"\n    if not nums:\n        return []\n\n    integers_with_data = []\n    for i, num in enumerate(nums):\n        digit_sum = calculate_digit_sum(num)\n        int_data = IntegerData(value=num, original_index=i, digit_sum=digit_sum)\n        integers_with_data.append(int_data)\n\n    sorted_integers_with_data = sort_by_digit_sum(integers_with_data)\n\n    result = [item.value for item in sorted_integers_with_data]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums: list) -> int:\n    \"\"\"Counts numbers in an array that are greater than 10 and have both first and last digits as odd.\n    Handles negative numbers using absolute value for digit extraction.\"\"\"\n    count = 0\n\n    def is_odd_digit(digit: int) -> bool:\n        \"\"\"Determines if a digit is odd (1, 3, 5, 7, 9).\"\"\"\n        return digit in {1, 3, 5, 7, 9}\n\n    def extract_first_digit(num: float) -> int:\n        \"\"\"Extracts the first digit from a number's absolute value using string conversion.\"\"\"\n        s_num = str(abs(num))\n        for char in s_num:\n            if '0' <= char <= '9':\n                return int(char)\n        return 0 # Should not be reached with valid numeric input.\n\n    def extract_last_digit(num: float) -> int:\n        \"\"\"Extracts the last digit from a number's absolute value using string conversion.\"\"\"\n        s_num = str(abs(num))\n        for char in reversed(s_num):\n            if '0' <= char <= '9':\n                return int(char)\n        return 0 # Should not be reached with valid numeric input.\n\n    for num in nums:\n        if num > 10:\n            abs_num = abs(num)\n            first_digit = extract_first_digit(abs_num)\n            last_digit = extract_last_digit(abs_num)\n            \n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    \n    return count"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a generated array where i < j < k and their sum is divisible by 3.\n    The array a is created such that a[i] = i*i - i + 1 for i from 1 to n.\n    \"\"\"\n    \n    # Generate array: a[i] = i*i - i + 1 for i from 1 to n\n    array = []\n    for i in range(1, n + 1):\n        array.append(i * i - i + 1)\n\n    # Find all triples (a[i], a[j], a[k]) where i < j < k\n    count = 0\n    # Iterate through indices for a 0-indexed array of length n\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                # Calculate sum and check divisibility by 3\n                triple_sum = array[i] + array[j] + array[k]\n                if triple_sum % 3 == 0:\n                    count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/147", "solution": "def _validate_input(n):\n    \"\"\"Placeholder for input validation as per design.\n    This function currently trusts the caller's input based on critical requirements.\n    \"\"\"\n    pass\n\ndef _generate_array(n):\n    \"\"\"Creates an array of length n where elements are i*i - i + 1.\n    The array is generated for indices from 1 to n (inclusive).\n    \"\"\"\n    array = []\n    for i in range(1, n + 1):\n        array.append(i * i - i + 1)\n    return array\n\ndef _find_valid_triples(array):\n    \"\"\"Identifies all unique triples (a[i], a[j], a[k]) from the array where i < j < k.\n    It iterates through the array to form all possible ordered combinations of three distinct elements.\n    \"\"\"\n    triples = []\n    length = len(array)\n    for i in range(length):\n        for j in range(i + 1, length):\n            for k in range(j + 1, length):\n                triples.append((array[i], array[j], array[k]))\n    return triples\n\ndef _count_divisible_triples(triples):\n    \"\"\"Counts how many of the given triples have a sum divisible by 3.\n    It iterates through each triple and checks if the sum of its elements is a multiple of 3.\n    \"\"\"\n    count = 0\n    for triple in triples:\n        if sum(triple) % 3 == 0:\n            count += 1\n    return count\n\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    _validate_input(n)\n    arr = _generate_array(n)\n    all_triples = _find_valid_triples(arr)\n    valid_triples_count = _count_divisible_triples(all_triples)\n    return valid_triples_count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers in an array that are greater than 10 and have\n    both first and last digits odd.\n    \"\"\"\n\n    def extract_first_digit(number: int) -> int:\n        \"\"\"Extracts the first digit from a number's absolute value.\"\"\"\n        return int(str(abs(number))[0])\n\n    def extract_last_digit(number: int) -> int:\n        \"\"\"Extracts the last digit from a number's absolute value.\"\"\"\n        return abs(number) % 10\n\n    def is_odd_digit(digit: int) -> bool:\n        \"\"\"Checks if a digit is odd.\"\"\"\n        return digit in [1, 3, 5, 7, 9]\n\n    def is_greater_than_10(number: int) -> bool:\n        \"\"\"Checks if a number is greater than 10.\"\"\"\n        return number > 10\n\n    count = 0\n    for num in nums:\n        if is_greater_than_10(num):\n            first_digit = extract_first_digit(num)\n            last_digit = extract_last_digit(num)\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\ndef bf(planet1: str, planet2: str) -> tuple:\n    \"\"\"\n    Returns planets between two given planets' orbits, sorted by proximity to the Sun.\n    Returns an empty tuple if either planet name is invalid.\n    \"\"\"\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    idx1 = PLANETS.index(planet1)\n    idx2 = PLANETS.index(planet2)\n\n    start_index = min(idx1, idx2)\n    end_index = max(idx1, idx2)\n\n    planets_in_between = PLANETS[start_index + 1 : end_index]\n    return tuple(planets_in_between)"}
{"task_id": "HumanEval/149", "solution": "```python\nfrom typing import List\n\ndef sorted_list_sum(lst: List[str]) -> List[str]:\n    \"\"\"Filters strings with odd lengths and sorts the remaining by length then alphabetically.\n    Processes the input list through filtering and then a two-stage sorting.\"\"\"\n    \n    # Filter out strings that have odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    \n    # Sort the filtered strings, first by length in ascending order, then alphabetically for equal lengths.\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    \n    return sorted_result\n```"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\n    (\"Mercury\", 1), (\"Venus\", 2), (\"Earth\", 3), (\"Mars\", 4),\n    (\"Jupiter\", 5), (\"Saturn\", 6), (\"Uranus\", 7), (\"Neptune\", 8)\n)\n\ndef validate_planet(planet_name):\n    \"\"\"Validates if a planet name is recognized in our solar system.\"\"\"\n    for name, _ in PLANETS:\n        if name == planet_name:\n            return True\n    return False\n\ndef get_position(planet_name):\n    \"\"\"Gets the orbital position of a planet (1-8 from Sun).\"\"\"\n    for name, pos in PLANETS:\n        if name == planet_name:\n            return pos\n    return -1\n\ndef get_planets_between(pos1, pos2):\n    \"\"\"Extracts planet names between two orbital positions (exclusive).\"\"\"\n    intermediate_planets = []\n    start_pos = min(pos1, pos2)\n    end_pos = max(pos1, pos2)\n\n    for name, pos in PLANETS:\n        if start_pos < pos < end_pos:\n            intermediate_planets.append(name)\n    return intermediate_planets\n\ndef sort_by_proximity(planets_list):\n    \"\"\"Sorts planets by proximity to the Sun and returns them as a tuple.\"\"\"\n    planet_positions_map = {name: pos for name, pos in PLANETS}\n    sorted_planets = sorted(planets_list, key=lambda p: planet_positions_map.get(p))\n    return tuple(sorted_planets)\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Calculates planets located between two given planets in our solar system.\n    Returns a tuple of planet names, sorted by proximity to the Sun.\n    \"\"\"\n    if not validate_planet(planet1) or not validate_planet(planet2):\n        return ()\n\n    pos1 = get_position(planet1)\n    pos2 = get_position(planet2)\n\n    intermediate_planets = get_planets_between(pos1, pos2)\n    return sort_by_proximity(intermediate_planets)"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Checks if a number is prime.\n    This function efficiently determines primality for an integer n.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    This function uses an internal helper to determine primality.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/149", "solution": "def filter_even_length(strings):\n    \"\"\"Filters a list of strings, keeping only those with an even character length.\n    This helper function supports the main sorting logic.\"\"\"\n    filtered_strings = []\n    for s in strings:\n        if len(s) % 2 == 0:\n            filtered_strings.append(s)\n    return filtered_strings\n\ndef sort_by_length_and_alphabet(strings):\n    \"\"\"Sorts a list of strings first by length in ascending order, then alphabetically.\n    This ensures multi-level sorting as per business rules.\"\"\"\n    return sorted(strings, key=lambda x: (len(x), x))\n\ndef sorted_list_sum(lst):\n    \"\"\"Processes a list of strings by filtering out odd-length strings and then sorting the remainder.\n    Strings are sorted by length ascending, then alphabetically for equal lengths.\"\"\"\n    even_length_strings = filter_even_length(lst)\n    return sort_by_length_and_alphabet(even_length_strings)"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Helper function to determine if n is prime.\n    Handles numbers less than 2 as non-prime and uses an efficient check up to sqrt(n).\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"Main function implementing conditional logic based on prime checking.\n    Returns x if n is prime, otherwise returns y.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def is_valid_number(num):\n    \"\"\"Check if number is a positive integer.\"\"\"\n    return isinstance(num, int) and num > 0\n\ndef is_odd_integer(num):\n    \"\"\"Check if validated integer is odd.\"\"\"\n    return num % 2 != 0\n\ndef calculate_sum_of_squares(numbers):\n    \"\"\"Calculate sum of squares for list of numbers.\"\"\"\n    total = 0\n    for n in numbers:\n        total += n * n\n    return total\n\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    valid_odd_numbers = []\n    for item in lst:\n        if is_valid_number(item):\n            if is_odd_integer(item):\n                valid_odd_numbers.append(item)\n    return calculate_sum_of_squares(valid_odd_numbers)"}
