{"task_id": "HumanEval/92", "solution": "```python\ndef _is_integer(value) -> bool:\n    \"\"\"\n    Returns True if value is an integer type.\n    This function specifically checks if the given value is an instance of int.\n    \"\"\"\n    return isinstance(value, int)\n\ndef _check_sum_combinations(x: int, y: int, z: int) -> bool:\n    \"\"\"\n    Checks if any number equals the sum of the other two.\n    It evaluates all three possible sum relationships.\n    \"\"\"\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)\n\ndef any_int(x, y, z) -> bool:\n    \"\"\"\n    Determines if one number equals the sum of the other two, given all are integers.\n    Returns True if the condition is met and all inputs are integers, False otherwise.\n    \"\"\"\n    if _is_integer(x) and _is_integer(y) and _is_integer(z):\n        return _check_sum_combinations(x, y, z)\n    return False\n```"}
{"task_id": "HumanEval/92", "solution": "def _validate_integers(x, y, z) -> bool:\n    \"\"\"Helper function to validate all inputs are integers.\"\"\"\n    return isinstance(x, int) and isinstance(y, int) and isinstance(z, int)\n\ndef _check_sum_condition(x, y, z) -> bool:\n    \"\"\"Helper function to check sum equality conditions.\"\"\"\n    return (x + y == z) or (x + z == y) or (y + z == x)\n\ndef any_int(x, y, z) -> bool:\n    \"\"\"Main function that validates integers and checks sum conditions.\"\"\"\n    if not _validate_integers(x, y, z):\n        return False\n    return _check_sum_condition(x, y, z)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\".\n    Sentences are delimited by '.', '?', or '!'.\n    \"\"\"\n\n    def split_sentences(text: str) -> list[str]:\n        \"\"\"\n        Splits text into sentences based on '.', '?', '!' delimiters.\n        Handles various spacing and consecutive delimiters.\n        \"\"\"\n        sentences = []\n        current_sentence_chars = []\n        delimiters = {'.', '?', '!'}\n\n        for char in text:\n            current_sentence_chars.append(char)\n            if char in delimiters:\n                sentence = \"\".join(current_sentence_chars).strip()\n                if sentence:  # Only add non-empty sentences\n                    sentences.append(sentence)\n                current_sentence_chars = []\n\n        # Add any remaining part as a sentence if no final delimiter\n        remaining_sentence = \"\".join(current_sentence_chars).strip()\n        if remaining_sentence:\n            sentences.append(remaining_sentence)\n\n        return sentences\n\n    def get_first_word(sentence: str) -> str:\n        \"\"\"\n        Extracts the first word from a sentence, ignoring leading whitespace.\n        Returns an empty string if the sentence is empty or only whitespace.\n        \"\"\"\n        stripped_sentence = sentence.lstrip()\n        if not stripped_sentence:\n            return \"\"\n\n        space_index = stripped_sentence.find(' ')\n        if space_index == -1:\n            return stripped_sentence  # No space, the whole string is the word\n        else:\n            return stripped_sentence[:space_index]\n\n    def is_sentence_start_with_i(sentence: str) -> bool:\n        \"\"\"\n        Checks if a sentence starts with the word \"I\".\n        It is case-sensitive and checks for \"I\" as a standalone word.\n        \"\"\"\n        first_word = get_first_word(sentence)\n        return first_word == \"I\"\n\n    boredom_count = 0\n    sentences = split_sentences(S)\n\n    for sentence in sentences:\n        if is_sentence_start_with_i(sentence):\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Count the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    delimiters = {'.', '?', '!'}\n    sentences = []\n    current_sentence_chars = []\n    has_any_delimiter = False\n\n    for char in S:\n        if char in delimiters:\n            has_any_delimiter = True\n            sentence = \"\".join(current_sentence_chars).strip()\n            if sentence:\n                sentences.append(sentence)\n            current_sentence_chars = []\n        else:\n            current_sentence_chars.append(char)\n\n    last_fragment = \"\".join(current_sentence_chars).strip()\n    if last_fragment and (has_any_delimiter or not sentences):\n        # A last fragment counts as a sentence if there was at least one delimiter\n        # in the original string, or if it's the only text and has no delimiters\n        # (though per example \"Hello world\" -> 0, this case should only add if\n        # has_any_delimiter is True, or if 'sentences' already contains elements).\n        # The logic `if last_fragment and has_any_delimiter` directly handles\n        # \"Hello world\" yielding no sentences but \"A. I\" correctly counts \"I\".\n        # Re-evaluating based on \"Hello world\" -> 0 and \"I love this weather\" counting:\n        # If there are NO delimiters in the entire string, no sentences are formed.\n        # If there ARE delimiters, then text before and the final fragment count.\n        # The `has_any_delimiter` flag handles this distinction.\n        if has_any_delimiter: # This condition ensures \"Hello world\" doesn't add a sentence.\n            sentences.append(last_fragment)\n    elif last_fragment and not sentences and not has_any_delimiter:\n        # This is the \"Hello world\" case. No delimiters found, no sentences added yet.\n        # This fragment does NOT form a sentence.\n        pass\n\n    boredom_count = 0\n    for sentence in sentences:\n        words = sentence.split()\n        if words and words[0] == \"I\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Transforms a message by swapping character case and replacing vowels.\n    Non-letter characters are preserved in their original positions.\n    \"\"\"\n    # Vowel-to-replacement character mappings.\n    _LOWERCASE_VOWEL_REPLACEMENTS = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    _UPPERCASE_VOWEL_REPLACEMENTS = {'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'}\n    # Combined set for efficient vowel identification.\n    _ALL_VOWELS = set(_LOWERCASE_VOWEL_REPLACEMENTS.keys()) | set(_UPPERCASE_VOWEL_REPLACEMENTS.keys())\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a recognized vowel.\"\"\"\n        return char in _ALL_VOWELS\n\n    def _get_vowel_replacement(char: str) -> str:\n        \"\"\"Returns the shifted replacement for a given vowel.\"\"\"\n        if char.isupper():\n            return _UPPERCASE_VOWEL_REPLACEMENTS.get(char, char)\n        elif char.islower():\n            return _LOWERCASE_VOWEL_REPLACEMENTS.get(char, char)\n        return char\n\n    def _swap_case(char: str) -> str:\n        \"\"\"Swaps the case of an alphabetic character.\"\"\"\n        return char.swapcase()\n\n    def _process_character(char: str) -> str:\n        \"\"\"Applies encoding rules to a single character.\"\"\"\n        if char.isalpha():\n            if _is_vowel(char):\n                # Vowel: replace then swap case\n                replaced_char = _get_vowel_replacement(char)\n                return _swap_case(replaced_char)\n            else: # Consonant: just swap case\n                return _swap_case(char)\n        else: # Non-letter: preserve\n            return char\n\n    encoded_chars = []\n    for char in message:\n        encoded_chars.append(_process_character(char))\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n):\n    \"\"\"Determines if a number is prime.\n    Returns True if prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef find_largest_prime(numbers):\n    \"\"\"Finds the largest prime number from a list.\n    Returns the largest prime or None if no primes are found.\"\"\"\n    largest_prime = None\n    for num in numbers:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    return largest_prime\n\ndef sum_digits(number):\n    \"\"\"Calculates sum of all digits in a number.\n    Returns the sum of all digits.\"\"\"\n    digit_sum = 0\n    # Handle negative numbers by taking absolute value for digit sum\n    number = abs(number)\n    while number > 0:\n        digit_sum += number % 10\n        number //= 10\n    return digit_sum\n\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\"\"\"\n    largest_prime = find_largest_prime(lst)\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case and replacing vowels.\n    Vowels are replaced by the letter 2 positions ahead in the alphabet.\n    \"\"\"\n\n    def _is_vowel(char):\n        \"\"\"Determines if a character is a vowel (a, e, i, o, u), case-insensitive.\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _replace_vowel(char):\n        \"\"\"Replaces a vowel with the letter 2 positions ahead in the alphabet, preserving original case.\"\"\"\n        vowel_map_lower = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n        if char.isupper():\n            return vowel_map_lower[char.lower()].upper()\n        return vowel_map_lower[char.lower()]\n\n    def _swap_case(char):\n        \"\"\"Swaps the case of an alphabetic character, or returns the original if non-alphabetic.\"\"\"\n        return char.swapcase()\n\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            if _is_vowel(char):\n                # Apply vowel replacement, then swap case of the resulting character\n                replaced_char = _replace_vowel(char)\n                encoded_chars.append(_swap_case(replaced_char))\n            else:\n                # Only swap case for non-vowel alphabetic characters\n                encoded_chars.append(_swap_case(char))\n        else:\n            # Preserve non-alphabetic characters like spaces\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Validates dictionary key case consistency.\n    Returns True if all keys are strings in consistent case (all lowercase OR all uppercase), False otherwise.\n    \"\"\"\n    if not dict:\n        return False\n\n    expected_case = None\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if expected_case is None:\n            if key.islower():\n                expected_case = 'lower'\n            elif key.isupper():\n                expected_case = 'upper'\n            else:\n                return False\n        else:\n            if expected_case == 'lower' and not key.islower():\n                return False\n            if expected_case == 'upper' and not key.isupper():\n                return False\n                \n    return True"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are consistently lowercase or uppercase strings.\n    Returns False for empty dictionaries, mixed cases, or non-string keys.\n    \"\"\"\n\n    # Fail-fast for empty dictionary as per design and problem statement.\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        # As per design and problem example for non-string keys, check type.\n        if not isinstance(key, str):\n            return False\n\n        # Update flags based on current key's case.\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n    # Return True if either all keys were lowercase or all keys were uppercase.\n    return all_lower or all_upper"}
{"task_id": "HumanEval/94", "solution": "def is_valid_input(n: int) -> bool:\n    \"\"\"Checks if a number is within the valid range for prime processing.\n    Numbers must be positive integers greater than 1 and up to 99999.\"\"\"\n    return 1 < n <= 99999\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is a prime number.\n    This function expects positive integers greater than 1.\"\"\"\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef extract_digits(n: int) -> list[int]:\n    \"\"\"Extracts individual digits from a non-negative integer.\n    Returns a list of integers representing each digit.\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    temp_n = n\n    while temp_n > 0:\n        digits.append(temp_n % 10)\n        temp_n //= 10\n    return digits\n\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\n    It utilizes the extract_digits function to get the digits.\"\"\"\n    digits = extract_digits(n)\n    return sum(digits)\n\ndef find_primes(lst: list[int]) -> list[int]:\n    \"\"\"Identifies all prime numbers from a list of integers.\n    It filters invalid inputs and then checks for primality.\"\"\"\n    primes = []\n    for num in lst:\n        if is_valid_input(num):\n            if is_prime(num):\n                primes.append(num)\n    return primes\n\ndef find_largest_prime(primes: list[int]) -> int:\n    \"\"\"Finds the largest prime number from a given list of primes.\n    Returns 0 if the list of primes is empty.\"\"\"\n    if not primes:\n        return 0\n    return max(primes)\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    This orchestrates prime validation, processing, and digit calculation.\"\"\"\n    primes = find_primes(lst)\n    largest_prime = find_largest_prime(primes)\n    digit_sum = sum_digits(largest_prime)\n    return digit_sum"}
{"task_id": "HumanEval/96", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"Check if a number is prime using trial division.\n    It efficiently handles small numbers and iterates up to the square root.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef _validate_input(n: int) -> bool:\n    \"\"\"Validate input parameter constraints.\n    Ensures the input n is a non-negative integer.\"\"\"\n    # Per design, 'n' is a non-negative integer, so this check confirms that constraint.\n    return n >= 0\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    # The design specifies validating input, though per requirements 'n' is guaranteed non-negative.\n    if not _validate_input(n):\n        # This branch is primarily for design adherence; 'n' is expected to be valid.\n        return []\n\n    # Handle edge cases n=0, n=1, and n=2 as per the design.\n    # For n=2, primes less than 2 is an empty list.\n    if n <= 2:\n        return []\n\n    primes = []\n    # Iterate from 2 up to n-1 to find all primes less than n.\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Generates an array of prime numbers less than the given non-negative integer n.\n    Primes are returned in ascending order.\n    \"\"\"\n    def is_prime(number):\n        \"\"\"\n        Determines if a number is prime using an optimized trial division algorithm.\n        Checks for divisors only up to the square root of the number.\n        \"\"\"\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    if n <= 1:\n        return []\n\n    primes_list = []\n    for i in range(2, n):\n        if is_prime(i):\n            primes_list.append(i)\n\n    return primes_list"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    This function processes the string to find qualifying characters.\n    \"\"\"\n    def is_even_index(index: int) -> bool:\n        \"\"\"Check if index is even (0, 2, 4, etc.).\"\"\"\n        return index % 2 == 0\n\n    def is_uppercase_vowel(char: str) -> bool:\n        \"\"\"Check if character is an uppercase vowel (A, E, I, O, U).\"\"\"\n        return char in 'AEIOU'\n\n    count = 0\n    for index, char in enumerate(s):\n        if is_even_index(index) and is_uppercase_vowel(char):\n            count += 1\n    return count"}
{"task_id": "HumanEval/97", "solution": "```python\ndef _extract_unit_digit(number: int) -> int:\n    \"\"\"Extracts the unit digit from an integer using its absolute value.\n    This ensures correct handling for both positive and negative numbers.\"\"\"\n    return abs(number) % 10\n\ndef _calculate_product(digit1: int, digit2: int) -> int:\n    \"\"\"Calculates the product of two given integer digits.\"\"\"\n    return digit1 * digit2\n\ndef multiply(a: int, b: int) -> int:\n    \"\"\"Completes the function that takes two integers and returns\n    the product of their unit digits, handling negative numbers and zeros.\"\"\"\n    unit_digit_a = _extract_unit_digit(a)\n    unit_digit_b = _extract_unit_digit(b)\n    return _calculate_product(unit_digit_a, unit_digit_b)\n```"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    For example: count_upper('aBCdEf') returns 1\n    \"\"\"\n    count = 0\n    uppercase_vowels = \"AEIOU\"\n\n    for index, char in enumerate(s):\n        if index % 2 == 0 and char in uppercase_vowels:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "```python\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Convert string representation of number to closest integer.\n    Rounds equidistant values away from zero.\n    \"\"\"\n    num = float(value)\n\n    # `int(num)` truncates the number towards zero.\n    # `num - int(num)` gives the signed fractional part.\n    integer_part = int(num)\n    fractional_part = num - integer_part\n\n    if abs(fractional_part) == 0.5:\n        # Equidistant case: round away from zero.\n        # For positive X.5, round up. For negative -X.5, round down.\n        if num >= 0:\n            return integer_part + 1\n        else:\n            return integer_part - 1\n    else:\n        # Not equidistant: round to the mathematically closest integer.\n        # This is achieved by adding/subtracting 0.5 and truncating.\n        if num >= 0:\n            return int(num + 0.5)\n        else:\n            return int(num - 0.5)\n```"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    \"\"\"\n    Convert string representation of number to closest integer.\n    Rounds equidistant values away from zero.\n    \"\"\"\n    numeric_value = float(value)\n    if numeric_value >= 0:\n        return int(numeric_value + 0.5)\n    else:\n        return int(numeric_value - 0.5)"}
{"task_id": "HumanEval/101", "solution": "def _validate_input(s: str) -> bool:\n    \"\"\"\n    Validates input type. As per design, it trusts caller's input and simply returns True.\n    \"\"\"\n    return True\n\ndef _split_by_separators(s: str) -> list:\n    \"\"\"\n    Replaces commas with spaces and splits the string by space.\n    This step may produce empty strings for multiple consecutive separators.\n    \"\"\"\n    normalized_s = s.replace(',', ' ')\n    return normalized_s.split(' ')\n\ndef _clean_words(words: list) -> list:\n    \"\"\"\n    Removes any empty strings from the list of extracted words.\n    \"\"\"\n    return [word for word in words if word]\n\ndef words_string(s):\n    \"\"\"\n    You will be given a string of words separated by commas or spaces. Your task is\n    to split the string into words and return an array of the words.\n\n    For example:\n    words_string(\"Hi, my name is John\") == [\"Hi\", \"my\", \"name\", \"is\", \"John\"]\n    words_string(\"One, two, three, four, five, six\") == [\"One\", \"two\", \"three\", \"four\", \"five\", \"six\"]\n    \"\"\"\n    _validate_input(s)\n    split_words = _split_by_separators(s)\n    cleaned_words = _clean_words(split_words)\n    return cleaned_words"}
