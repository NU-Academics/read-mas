{"task_id": "HumanEval/57", "solution": "```python\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    This function processes numeric lists to determine monotonic properties in O(n) time and O(1) space.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n        if l[i] > l[i-1]:\n            is_decreasing = False\n        \n        # If the list is neither increasing nor decreasing, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n            \n    return is_increasing or is_decreasing\n```"}
{"task_id": "HumanEval/57", "solution": "def _is_increasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically increasing (non-decreasing).\n    It returns True for empty or single-element lists as well.\"\"\"\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            return False\n    return True\n\ndef _is_decreasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically decreasing (non-increasing).\n    It returns True for empty or single-element lists as well.\"\"\"\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            return False\n    return True\n\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    # An empty list or a list with one element is considered monotonic.\n    if len(l) <= 1:\n        return True\n    \n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    # Use set intersection to find common elements and automatically deduplicate.\n    common_set = set(l1) & set(l2)\n    # Convert the set to a list and sort it before returning.\n    return sorted(list(common_set))"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    d = 2\n\n    # Handle factor 2 by repeatedly dividing n until it is odd.\n    while n % d == 0:\n        largest_factor = d\n        n //= d\n\n    # Check for odd factors starting from 3 up to sqrt(n).\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2  # Increment by 2 to check only odd numbers.\n\n    # If n is still greater than 1, it must be the largest prime factor.\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def _find_intersection(l1: list, l2: list) -> set:\n    \"\"\"Find intersection of two lists using set operations.\"\"\"\n    return set(l1) & set(l2)\n\ndef _remove_duplicates_and_sort(elements: set) -> list:\n    \"\"\"Convert set to sorted list.\"\"\"\n    return sorted(list(elements))\n\ndef common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n\n    Args:\n        l1: First input list\n        l2: Second input list\n\n    Returns:\n        List of sorted unique common elements\n\n    Examples:\n        >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n        [1, 5, 653]\n        >>> common([5, 3, 2, 8], [3, 2])\n        [2, 3]\n    \"\"\"\n    intersection_set = _find_intersection(l1, l2)\n    sorted_unique_list = _remove_duplicates_and_sort(intersection_set)\n    return sorted_unique_list"}
{"task_id": "HumanEval/60", "solution": "```python\ndef sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    It uses Gauss's formula to efficiently calculate the sum of consecutive integers.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2\n```"}
{"task_id": "HumanEval/59", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime.\n    This function tests divisibility by numbers up to its square root.\"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\n\ndef _find_largest_prime_factor(n: int) -> int:\n    \"\"\"Implements the core algorithm to find the largest prime factor of n.\n    It identifies prime factors by using the _is_prime helper.\"\"\"\n    largest_prime = 1\n    \n    # Handle factor 2\n    if n % 2 == 0:\n        largest_prime = 2\n        while n % 2 == 0:\n            n //= 2\n    \n    # Check for odd factors starting from 3 up to sqrt(current n)\n    i = 3\n    while i * i <= n:\n        if n % i == 0: # If i is a factor of the remaining n\n            if _is_prime(i): # Verify if this factor i is prime as per design\n                largest_prime = i # Update largest_prime if i is a prime factor\n            while n % i == 0: # Remove all occurrences of this factor i\n                n //= i\n        i += 2\n    \n    # If n is greater than 1 after divisions, the remaining n is the largest prime factor.\n    if n > 1:\n        largest_prime = n\n            \n    return largest_prime\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    This function delegates the core factorization to a helper.\"\"\"\n    return _find_largest_prime_factor(n)"}
