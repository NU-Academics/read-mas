{"task_id": "HumanEval/151", "solution": "```python\nclass NumberList:\n    \"\"\"\n    Provides a wrapper for input list with utility operations.\n    It helps manage the collection of numbers.\n    \"\"\"\n    def __init__(self, lst: list):\n        self.numbers = lst\n        self.size = len(lst)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return self.size == 0\n\n    def __iter__(self):\n        \"\"\"Supports iteration over the numbers in the list.\"\"\"\n        return iter(self.numbers)\n\nclass ValidationResult:\n    \"\"\"\n    Encapsulates validation state for a single number.\n    It determines if a number is a positive, odd integer.\n    \"\"\"\n    def __init__(self, num):\n        # Check if the number is an integer type.\n        self.is_integer = type(num) is int\n        \n        # Only evaluate positivity and oddness if it's an actual integer.\n        if self.is_integer:\n            self.is_positive = num > 0\n            self.is_odd = num % 2 != 0\n        else:\n            self.is_positive = False\n            self.is_odd = False\n        \n        # 'is_valid' represents if the number is a positive integer.\n        self.is_valid = self.is_integer and self.is_positive\n\n    def should_include(self) -> bool:\n        \"\"\"\n        Returns whether the number should be included in the calculation.\n        It must be a positive, odd integer.\n        \"\"\"\n        return self.is_valid and self.is_odd\n\nclass Calculator:\n    \"\"\"\n    Manages sum calculation and accumulation of squared values.\n    It provides methods to add squares and retrieve the final total.\n    \"\"\"\n    def __init__(self):\n        self._sum_of_squares = 0\n\n    def add_square(self, value: int):\n        \"\"\"Adds a squared value to the running total.\"\"\"\n        self._sum_of_squares += value\n\n    def get_result(self) -> int:\n        \"\"\"Returns the final calculated sum.\"\"\"\n        return self._sum_of_squares\n\nclass NumberProcessor:\n    \"\"\"\n    Orchestrates the processing of input lists, coordinating validation and calculation.\n    It iterates through numbers, validates them, and calculates the sum of squares.\n    \"\"\"\n    def process_list(self, lst: list) -> int:\n        \"\"\"\n        Processes a list of numbers to find the sum of squares of positive, odd integers.\n        Returns 0 if the list is empty or contains no valid numbers.\n        \"\"\"\n        number_list = NumberList(lst)\n        if number_list.is_empty():\n            return 0\n\n        calculator = Calculator()\n\n        for num in number_list:\n            validation_result = ValidationResult(num)\n            if validation_result.should_include():\n                squared_value = self.calculate_square(num)\n                calculator.add_square(squared_value)\n        \n        return calculator.get_result()\n\n    def is_valid_number(self, num) -> bool:\n        \"\"\"Validates if a number is a positive integer.\"\"\"\n        return type(num) is int and num > 0\n\n    def is_odd(self, num) -> bool:\n        \"\"\"Checks if a number is odd.\"\"\"\n        return num % 2 != 0\n\n    def calculate_square(self, num) -> int:\n        \"\"\"Calculates the square of a number.\"\"\"\n        return num * num\n\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are positive, odd integers.\n    \"\"\"\n    processor = NumberProcessor()\n    return processor.process_list(lst)\n```"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    def _is_substring_match(text: str, pattern: str) -> bool:\n        \"\"\"Checks if the pattern string is a substring of the text string.\"\"\"\n        return pattern in text\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all cyclic rotations of an input string. Handles empty strings correctly.\"\"\"\n        if not s:\n            return [\"\"] \n        \n        rotations = []\n        n = len(s)\n        # Concatenate s with itself to easily extract all n rotations.\n        double_s = s + s \n        for i in range(n):\n            rotations.append(double_s[i : i + n])\n        return rotations\n\n    # Generate all possible rotations of string b.\n    b_rotations = _generate_rotations(b)\n\n    # Check if any of b's rotations is a substring within string a.\n    for rotation in b_rotations:\n        if _is_substring_match(a, rotation):\n            return True\n            \n    return False"}
