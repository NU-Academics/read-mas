{"task_id": "780", "solution": "def sum_combinations(tuple_list: list[tuple[int, ...]]) -> list[int]:\n    \"\"\"Compute all possible sums by picking exactly one element from each tuple in tuple_list.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list of tuples.\")\n    if not tuple_list:\n        return []\n\n    current_sums = [0]\n    for tup in tuple_list:\n        if not isinstance(tup, tuple):\n            raise TypeError(\"All items in the input list must be tuples.\")\n        if len(tup) == 0:\n            raise ValueError(\"Tuples must not be empty.\")\n        for elem in tup:\n            if not isinstance(elem, int):\n                raise TypeError(\"All elements in tuples must be integers.\")\n\n        new_sums = []\n        for sum_val in current_sums:\n            for elem in tup:\n                new_sums.append(sum_val + elem)\n        current_sums = new_sums\n\n    return current_sums"}
{"task_id": "781", "solution": "import math\nimport sys\nimport argparse\n\ndef count_divisors_is_even(n: int) -> bool:\n    \"\"\"\n    Determine if the number of positive divisors of n is even.\n\n    Parameters\n    ----------\n    n : int\n        The integer to analyze. Must be positive.\n\n    Returns\n    -------\n    bool\n        True if the divisor count is even, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If n <= 0.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return _count_divisors(n) % 2 == 0\n\ndef _count_divisors(n: int) -> int:\n    \"\"\"\n    Count the positive divisors of n.\n\n    Parameters\n    ----------\n    n : int\n        Positive integer.\n\n    Returns\n    -------\n    int\n        Number of positive divisors of n.\n    \"\"\"\n    count = 0\n    limit = math.isqrt(n)\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            complement = n // i\n            if complement == i:\n                count += 1\n            else:\n                count += 2\n    return count\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Check if the number of divisors of an integer is even.\")\n    parser.add_argument(\"number\", type=int, help=\"Integer to analyze (must be > 0)\")\n    args = parser.parse_args()\n\n    try:\n        result = count_divisors_is_even(args.number)\n        print(f\"{args.number} has an even number of divisors: {result}\")\n    except ValueError as e:\n        print(f\"Error: {e}\", file=sys.stderr)\n        sys.exit(1)\n\nif __name__ == \"__main__\":\n    main()\n"}
{"task_id": "782", "solution": "def sum_odd_length_subarrays(arr: list[int]) -> int:\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    n = len(arr)\n    if n == 0:\n        return 0\n    for idx, elem in enumerate(arr):\n        if not isinstance(elem, int):\n            raise TypeError(f\"Element at index {idx} is not an integer.\")\n    total = 0\n    for i, val in enumerate(arr):\n        count = (i + 1) * (n - i)\n        if count & 1:\n            total += val\n    return total"}
