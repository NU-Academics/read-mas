{"task_id": "563", "solution": "def extract_quoted_values(text: str) -> list[str]:\n    \"\"\"Extract all substrings that are enclosed in matching quotation marks\n    from the input string.\n\n    Parameters:\n        text: str \u2013 The string to parse.\n\n    Returns:\n        list[str] \u2013 A list of extracted quoted substrings in the order\n        they appear in the input.  The list is empty if no quoted\n        substrings are found.\n    \"\"\"\n    results: list[str] = []\n    in_quote: bool = False\n    quote_char: str = \"\"\n    current: list[str] = []\n\n    i = 0\n    n = len(text)\n    while i < n:\n        c = text[i]\n\n        if c in (\"'\", '\"'):\n            # Count preceding backslashes to determine escape status\n            backslash_count = 0\n            j = i - 1\n            while j >= 0 and text[j] == \"\\\\\":\n                backslash_count += 1\n                j -= 1\n            escaped = (backslash_count % 2 == 1)\n\n            if not escaped:\n                if not in_quote:\n                    # Start of a quoted substring\n                    in_quote = True\n                    quote_char = c\n                    current = []\n                elif in_quote and c == quote_char:\n                    # End of a quoted substring\n                    in_quote = False\n                    results.append(\"\".join(current))\n                    current = []\n                # else: quote character inside a different quote type; treated as normal char\n            else:\n                # Escaped quote; treat as normal character\n                if in_quote:\n                    current.append(c)\n        else:\n            if in_quote:\n                current.append(c)\n\n        i += 1\n\n    # Any unmatched opening quote is ignored\n    return results\n\n\n__all__ = [\"extract_quoted_values\"]"}
{"task_id": "564", "solution": "def count_unequal_pairs(nums: list[int]) -> int:\n    \"\"\"Return the number of unordered pairs of unequal elements in the input list.\n\n    Parameters\n    ----------\n    nums : list[int]\n        List of integers.\n\n    Returns\n    -------\n    int\n        Count of unordered unequal pairs.\n    \"\"\"\n    n = len(nums)\n    if n < 2:\n        return 0\n\n    freq: dict[int, int] = {}\n    for val in nums:\n        freq[val] = freq.get(val, 0) + 1\n\n    total_pairs = n * (n - 1) // 2\n    equal_pairs = 0\n    for count in freq.values():\n        equal_pairs += count * (count - 1) // 2\n\n    return total_pairs - equal_pairs"}
{"task_id": "565", "solution": "def split_into_characters(input_str: str) -> list[str]:\n    \"\"\"\n    Splits the given string into a list of its individual characters.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to split. Must not be None.\n\n    Returns\n    -------\n    list[str]\n        A list where each element is a single character from `input_str`.  \n        For an empty string, returns an empty list.\n\n    Raises\n    ------\n    TypeError\n        If `input_str` is not of type `str`.\n    ValueError\n        If `input_str` is None.\n\n    Examples\n    --------\n    >>> split_into_characters('hello')\n    ['h', 'e', 'l', 'l', 'o']\n    >>> split_into_characters('')\n    []\n    \"\"\"\n    if input_str is None:\n        raise ValueError(\"Input cannot be None\")\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string\")\n    return [char for char in input_str]"}
{"task_id": "566", "solution": "def sum_of_digits(n: int) -> int:\n    \"\"\"Return the sum of the decimal digits of a non\u2011negative integer.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer whose digits are to be summed.\n\n    Returns\n    -------\n    int\n        Sum of the decimal digits of `n`.\n\n    Raises\n    ------\n    TypeError\n        If `n` is not an instance of int.\n    ValueError\n        If `n` is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be non\u2011negative.\")\n    total = 0\n    while n > 0:\n        total += n % 10\n        n //= 10\n    return total"}
{"task_id": "567", "solution": "def _validate_input(lst: list[float]) -> None:\n    \"\"\"Validate that `lst` is a list of numeric values.\"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list of numbers.\")\n    for el in lst:\n        if not isinstance(el, (int, float)):\n            raise TypeError(\"All elements must be int or float.\")\n\n\ndef is_sorted(lst: list[float]) -> bool:\n    \"\"\"\n    Checks whether the provided list of numbers is sorted in\n    non\u2011decreasing order.\n\n    Parameters\n    ----------\n    lst : list[float]\n        List of numeric values to be checked.\n\n    Returns\n    -------\n    bool\n        True if the list is sorted (or empty / single element),\n        False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `lst` is not a list or contains non\u2011numeric elements.\n\n    Examples\n    --------\n    >>> is_sorted([1, 2, 2, 5])\n    True\n    >>> is_sorted([3, 1, 4])\n    False\n    \"\"\"\n    _validate_input(lst)\n    if len(lst) <= 1:\n        return True\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i + 1]:\n            return False\n    return True"}
{"task_id": "568", "solution": "def create_empty_dicts(n: int) -> list[dict]:\n    \"\"\"Return a list of n independent empty dictionaries.\n\n    Args:\n        n: The number of empty dictionaries to create. Must be non\u2011negative.\n\n    Returns:\n        A list containing n empty dictionary objects.\n\n    Raises:\n        ValueError: If n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    return [{} for _ in range(n)]"}
{"task_id": "569", "solution": "def sort_sublist_strings(data: list[list[str]]) -> list[list[str]]:\n    \"\"\"Return a new list where each inner list of strings is sorted alphabetically.\"\"\"\n    sorted_data: list[list[str]] = []\n    for sublist in data:\n        sorted_sublist = sorted(sublist)\n        sorted_data.append(sorted_sublist)\n    return sorted_data"}
{"task_id": "572", "solution": "def remove_duplicates_from_lists(lists: list[list[int]]) -> list[list[int]]:\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists of integers.\")\n    result: list[list[int]] = []\n    for inner in lists:\n        if not isinstance(inner, list):\n            raise TypeError(\"Each element of the input list must itself be a list of integers.\")\n        seen: set[int] = set()\n        unique: list[int] = []\n        for item in inner:\n            if not isinstance(item, int):\n                raise TypeError(\"All items in inner lists must be integers.\")\n            if item not in seen:\n                seen.add(item)\n                unique.append(item)\n        result.append(unique)\n    return result"}
{"task_id": "573", "solution": "def product_of_unique(numbers: list[float]) -> float:\n    \"\"\"\n    Calculate the product of the unique numbers in the given list.\n\n    Parameters\n    ----------\n    numbers : list[float]\n        A list of numeric values (int or float).\n\n    Returns\n    -------\n    float\n        The product of the unique elements.  The product of an empty list\n        is defined as 1.0.\n\n    Raises\n    ------\n    TypeError\n        If ``numbers`` is not a list or if any element is not a numeric\n        value.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n\n    unique_numbers = set(numbers)\n\n    product = 1.0\n    for num in unique_numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"all elements must be numeric\")\n        product *= num\n\n    return product\n"}
{"task_id": "574", "solution": "import math\n\ndef calculate_surface_area(height: float, radius: float) -> float:\n    \"\"\"\n    Calculate the surface area of a right circular cylinder.\n\n    Parameters\n    ----------\n    height : float\n        Height of the cylinder. Must be positive.\n    radius : float\n        Radius of the cylinder. Must be positive.\n\n    Returns\n    -------\n    float\n        Surface area of the cylinder computed as 2 * \u03c0 * r * (r + h).\n\n    Raises\n    ------\n    ValueError\n        If `height` or `radius` is not a positive number.\n    \"\"\"\n    if height <= 0:\n        raise ValueError(\"height must be a positive float\")\n    if radius <= 0:\n        raise ValueError(\"radius must be a positive float\")\n\n    return 2 * math.pi * radius * (radius + height)"}
{"task_id": "576", "solution": "from typing import Any, List\n\ndef is_sublist(sub: List[Any], main: List[Any]) -> bool:\n    \"\"\"\n    Determine whether `sub` appears as a contiguous subsequence of `main`.\n\n    Parameters\n    ----------\n    sub : list[Any]\n        The target sublist to find.\n    main : list[Any]\n        The source list to search within.\n\n    Returns\n    -------\n    bool\n        True if `sub` is a contiguous subsequence of `main`, otherwise False.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not a list.\n    \"\"\"\n    if not isinstance(sub, list) or not isinstance(main, list):\n        raise TypeError(\"Both arguments must be lists.\")\n\n    m, n = len(sub), len(main)\n\n    # Edge cases\n    if m == 0:\n        return True\n    if n == 0:\n        return False\n    if m > n:\n        return False\n\n    def build_failure(pattern: List[Any]) -> List[int]:\n        failure = [0] * m\n        j = 0\n        for i in range(1, m):\n            while j > 0 and pattern[i] != pattern[j]:\n                j = failure[j - 1]\n            if pattern[i] == pattern[j]:\n                j += 1\n            failure[i] = j\n        return failure\n\n    def kmp_search(text: List[Any], pattern: List[Any], failure: List[int]) -> bool:\n        j = 0\n        for i in range(n):\n            while j > 0 and text[i] != pattern[j]:\n                j = failure[j - 1]\n            if text[i] == pattern[j]:\n                j += 1\n                if j == m:\n                    return True\n        return False\n\n    failure_table = build_failure(sub)\n    return kmp_search(main, sub, failure_table)"}
{"task_id": "577", "solution": "def last_factorial_digit(n: int) -> int:\n    \"\"\"\n    Return the last decimal digit of the factorial of n.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer whose factorial's last digit is required.\n\n    Returns\n    -------\n    int\n        The last digit of n!.\n\n    Raises\n    ------\n    TypeError\n        If n is not an int.\n    ValueError\n        If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    if n >= 5:\n        return 0\n    fact = 1\n    for i in range(2, n + 1):\n        fact *= i\n    return fact % 10"}
{"task_id": "578", "solution": "def interleave_three_lists(list1: list[int], list2: list[int], list3: list[int]) -> list[int]:\n    if not isinstance(list1, list) or not isinstance(list2, list) or not isinstance(list3, list):\n        raise TypeError(\"All inputs must be lists.\")\n    if len(list1) != len(list2) or len(list1) != len(list3):\n        raise ValueError(\"All input lists must have the same length.\")\n    result: list[int] = []\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "579", "solution": "def find_dissimilar_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Return a tuple of elements that are not common to both input tuples.\n\n    Parameters\n    ----------\n    a : tuple\n        The first input tuple.\n    b : tuple\n        The second input tuple.\n\n    Returns\n    -------\n    tuple\n        A tuple containing elements that appear in only one of the inputs.\n\n    Raises\n    ------\n    TypeError\n        If either `a` or `b` is not a tuple.\n    \"\"\"\n    if not isinstance(a, tuple):\n        raise TypeError(\"First argument must be a tuple\")\n    if not isinstance(b, tuple):\n        raise TypeError(\"Second argument must be a tuple\")\n\n    freq_a = {}\n    freq_b = {}\n    for x in a:\n        freq_a[x] = freq_a.get(x, 0) + 1\n    for y in b:\n        freq_b[y] = freq_b.get(y, 0) + 1\n\n    result_list = []\n    seen = set()\n    for x in a:\n        if x not in freq_b and x not in seen:\n            result_list.append(x)\n            seen.add(x)\n    for y in b:\n        if y not in freq_a and y not in seen:\n            result_list.append(y)\n            seen.add(y)\n\n    return tuple(result_list)"}
{"task_id": "580", "solution": "def remove_odd_from_nested_tuple(data: tuple) -> tuple:\n    def _process(obj):\n        if isinstance(obj, int):\n            return None if obj % 2 else obj\n        if isinstance(obj, tuple):\n            processed = []\n            for el in obj:\n                p = _process(el)\n                if p is not None:\n                    processed.append(p)\n            return tuple(processed)\n        if isinstance(obj, list):\n            processed = []\n            for el in obj:\n                p = _process(el)\n                if p is not None:\n                    processed.append(p)\n            return processed\n        if isinstance(obj, set):\n            processed = set()\n            for el in obj:\n                p = _process(el)\n                if p is not None:\n                    processed.add(p)\n            return processed\n        if isinstance(obj, dict):\n            processed = {}\n            for key, val in obj.items():\n                p = _process(val)\n                if p is not None:\n                    processed[key] = p\n            return processed\n        return obj\n\n    return _process(data)"}
{"task_id": "581", "solution": "def pyramid_surface_area(base_edge: float, height: float) -> float:\n    if base_edge <= 0 or height <= 0:\n        raise ValueError(\"Base edge and height must be positive numbers.\")\n    half_base = base_edge / 2\n    slant_height = ((half_base ** 2) + (height ** 2)) ** 0.5\n    area = base_edge ** 2 + 2 * base_edge * slant_height\n    return area"}
