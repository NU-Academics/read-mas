{"task_id": "140", "solution": "def flatten_list_of_lists(l: list[list[float]]) -> set[float]:\n    \"\"\"Convert a nested list of numeric values into a flat set of floats.\n\n    Parameters\n    ----------\n    l : list[list[float]]\n        Outer list containing inner lists of numeric values.\n\n    Returns\n    -------\n    set[float]\n        A set containing each distinct numeric value from all inner lists,\n        cast to float.\n\n    Raises\n    ------\n    TypeError\n        If the outer structure is not a list or if any inner element is not a list.\n    ValueError\n        If any inner element is not an int or float.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    result: set[float] = set()\n    for inner in l:\n        if not isinstance(inner, list):\n            raise TypeError(\"Each element of the outer list must itself be a list.\")\n        for item in inner:\n            if not isinstance(item, (int, float)):\n                raise ValueError(f\"Non-numeric value detected: {item!r}\")\n            result.add(float(item))\n    return result"}
{"task_id": "141", "solution": "def sort_elements(elements: list[object]) -> list[object]:\n    \"\"\"Return a new list containing the elements of *elements* sorted in ascending order.\"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"sort_elements expects a list\")\n\n    def _merge_sort(lst: list[object]) -> list[object]:\n        if len(lst) <= 1:\n            return lst[:]  # shallow copy\n        mid = len(lst) // 2\n        left = _merge_sort(lst[:mid])\n        right = _merge_sort(lst[mid:])\n        merged = []\n        i = j = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged\n\n    return _merge_sort(elements)"}
{"task_id": "142", "solution": "def count_identical_positions(a: list[object], b: list[object], c: list[object]) -> int:\n    \"\"\"\n    Count positions where all three lists have identical items.\n\n    Parameters\n    ----------\n    a : list[object]\n        First input list.\n    b : list[object]\n        Second input list.\n    c : list[object]\n        Third input list.\n\n    Returns\n    -------\n    int\n        Count of positions with identical items across all three lists.\n\n    Raises\n    ------\n    TypeError\n        If any argument is not a list.\n    \"\"\"\n    if not (isinstance(a, list) and isinstance(b, list) and isinstance(c, list)):\n        raise TypeError(\"All arguments must be lists\")\n\n    min_len = min(len(a), len(b), len(c))\n    count = 0\n    for i in range(min_len):\n        if a[i] == b[i] == c[i]:\n            count += 1\n    return count"}
{"task_id": "143", "solution": "def count_lists_in_tuple(data: tuple) -> int:\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    def _helper(sub: tuple | list) -> int:\n        count = 0\n        for elem in sub:\n            if isinstance(elem, list):\n                count += 1\n            if isinstance(elem, (tuple, list)):\n                count += _helper(elem)\n        return count\n\n    return _helper(data)"}
{"task_id": "145", "solution": "def max_difference(arr: list[float]) -> float:\n    if not isinstance(arr, list):\n        raise ValueError(\"Input must be a list.\")\n    if len(arr) < 2:\n        raise ValueError(\"List must contain at least two elements.\")\n    for i, x in enumerate(arr):\n        if not isinstance(x, (int, float)):\n            raise ValueError(f\"Element at index {i} is not numeric.\")\n    min_val = max_val = arr[0]\n    for x in arr[1:]:\n        if x < min_val:\n            min_val = x\n        if x > max_val:\n            max_val = x\n    return max_val - min_val"}
{"task_id": "160", "solution": "def solve_diophantine(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Find integer solutions (x, y) to the linear Diophantine equation\n    a * x + b * y = n.\n\n    Parameters\n    ----------\n    a : int\n        Coefficient of x. Can be positive, negative, or zero.\n    b : int\n        Coefficient of y. Can be positive, negative, or zero.\n    n : int\n        Target value on the right\u2011hand side of the equation.\n\n    Returns\n    -------\n    tuple[int, int] | None\n        A tuple (x, y) that satisfies the equation, or None if\n        no integer solution exists.\n    \"\"\"\n    # Type validation\n    if not all(isinstance(v, int) for v in (a, b, n)):\n        raise TypeError(\"All arguments must be integers\")\n\n    # Handle trivial case where both coefficients are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Extended Euclidean algorithm (iterative)\n    def extended_gcd(x: int, y: int) -> tuple[int, int, int]:\n        old_r, r = x, y\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n        return old_r, old_s, old_t\n\n    g, s, t = extended_gcd(a, b)\n    g = abs(g)  # ensure gcd is non\u2011negative\n\n    # Check solvability\n    if n % g != 0:\n        return None\n\n    # Scale the base solution\n    k = n // g\n    x0 = s * k\n    y0 = t * k\n\n    return (x0, y0)"}
{"task_id": "161", "solution": "def remove_elements(source: list[object], to_remove: list[object]) -> list[object]:\n    \"\"\"Remove all occurrences of elements from `to_remove` in `source`.\n\n    Parameters\n    ----------\n    source : list[object]\n        The list from which elements will be removed.\n    to_remove : list[object]\n        The list containing elements to be removed from `source`.\n\n    Returns\n    -------\n    list[object]\n        A new list with elements of `source` that are not in `to_remove`.\n\n    Raises\n    ------\n    TypeError\n        If `source` or `to_remove` is not of type list.\n\n    Notes\n    -----\n    The function performs membership checks using the `in` operator, which relies on the\n    `__eq__` implementation of the elements. It preserves the order of `source`.\n    \"\"\"\n    if type(source) is not list or type(to_remove) is not list:\n        raise TypeError(\n            f\"Both arguments must be of type list; \"\n            f\"received {type(source)} and {type(to_remove)}.\"\n        )\n    remove_set = set(to_remove)\n    return [elem for elem in source if elem not in remove_set]"}
{"task_id": "162", "solution": "def sum_sequence(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    max_i = n // 2\n    total = 0\n    for i in range(max_i + 1):\n        total += n - 2 * i\n    return total"}
{"task_id": "163", "solution": "```python\n\"\"\"\npolygon_area_calculator.core\n\nProvides a single function to calculate the area of a regular polygon.\n\"\"\"\n\n# Constants\n_PI = 3.141592653589793\n\n\n# --- Helper Functions ---\n\ndef _tan(x: float) -> float:\n    \"\"\"\n    Approximate the tangent of x using a Taylor series expansion.\n    The series used: tan(x) = x + x^3/3 + 2x^5/15 + 17x^7/315 + 62x^9/2835\n    This provides good accuracy for |x| < pi/2.\n    \"\"\"\n    x2 = x * x\n    term1 = x\n    term3 = (x2 * x) / 3\n    term5 = (2 * x2 * x2 * x) / 15\n    term7 = (17 * x2 * x2 * x2 * x) / 315\n    term9 = (62 * x2 * x2 * x2 * x2 * x) / 2835\n    return term1 + term3 + term5 + term7 + term9\n\n\ndef _validate_inputs(side_length: float, num_sides: int) -> None:\n    \"\"\"\n    Validates input parameters.\n\n    Raises:\n        ValueError: If side_length <= 0 or num_sides < 3.\n    \"\"\"\n    if side_length <= 0:\n        raise ValueError(f\"side_length must be positive; got {side_length}\")\n    if num_sides < 3:\n        raise ValueError(f\"num_sides must be >= 3; got {num_sides}\")\n\n\n# --- Public API ---\n\ndef calculate_regular_polygon_area(side_length: float, num_sides: int) -> float:\n    \"\"\"\n    Calculates the area of a regular polygon.\n\n    Parameters:\n        side_length (float): Length of one side (must be > 0).\n        num_sides (int): Number of sides (must be >= 3).\n\n    Returns:\n        float: The area of the polygon.\n\n    Raises:\n        ValueError: If inputs are out of bounds.\n    \"\"\"\n    _validate_inputs(side_length, num_sides)\n\n    numerator = num_sides * (side_length * side_length)\n    denominator = 4 * _tan(_PI / num_sides)\n    return numerator / denominator\n```"}
{"task_id": "164", "solution": "import math\n\ndef _sum_of_divisors(n: int) -> int:\n    \"\"\"Compute the sum of all positive divisors of n.\n    Zero returns 0. Negative numbers are treated as their absolute values.\"\"\"\n    if n == 0:\n        return 0\n    m = abs(n)\n    total = 1\n    limit = int(math.isqrt(m))\n    for i in range(2, limit + 1):\n        if m % i == 0:\n            total += i\n            other = m // i\n            if other != i:\n                total += other\n    if m > 1:\n        total += m\n    return total\n\ndef have_same_divisor_sum(a: int, b: int) -> bool:\n    \"\"\"Determine if the sum of the positive divisors of integers a and b are equal.\n\n    Parameters:\n    - a: int \u2013 first integer to compare\n    - b: int \u2013 second integer to compare\n\n    Returns:\n    - bool \u2013 True if sum of divisors of a equals sum of divisors of b, otherwise False\"\"\"\n    return _sum_of_divisors(a) == _sum_of_divisors(b)"}
{"task_id": "165", "solution": "def count_alphabet_position_matches(text: str) -> int:\n    match_count = 0\n    for i, c in enumerate(text):\n        c_low = c.lower()\n        if not c_low.isalpha():\n            continue\n        alpha_pos = ord(c_low) - ord('a') + 1\n        if alpha_pos == i:\n            match_count += 1\n    return match_count"}
