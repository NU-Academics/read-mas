{"task_id": "395", "solution": "def first_non_repeated_char(s: str) -> str | None:\n    \"\"\"Return the first non-repeated character in the string `s`.\n\n    Parameters\n    ----------\n    s : str\n        The input string to search.\n\n    Returns\n    -------\n    str | None\n        The first non-repeated character, or None if no such character exists.\n\n    Raises\n    ------\n    TypeError\n        If `s` is not of type `str`.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    if not s:\n        return None\n\n    freq: dict[str, int] = {}\n    for ch in s:\n        freq[ch] = freq.get(ch, 0) + 1\n\n    for ch in s:\n        if freq[ch] == 1:\n            return ch\n\n    return None"}
{"task_id": "396", "solution": "def is_same_start_end(s: str) -> bool:\n    \"\"\"Return True if the first and last characters of the string are identical.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    length = len(s)\n    if length == 0:\n        return False\n    if length == 1:\n        return True\n    return s[0] == s[-1]"}
{"task_id": "397", "solution": "def median_of_three(a: float, b: float, c: float) -> float:\n    if a > b:\n        if a < c:\n            return a\n        elif b > c:\n            return b\n        else:\n            return c\n    else:\n        if b < c:\n            return b\n        elif a > c:\n            return a\n        else:\n            return c"}
{"task_id": "398", "solution": "def sum_of_digits_list(nums: list[int]) -> list[int]:\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    result: list[int] = []\n    for num in nums:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements must be integers.\")\n        digit_sum = sum(int(ch) for ch in str(abs(num)))\n        result.append(digit_sum)\n    return result"}
{"task_id": "399", "solution": "def xor_tuples(*tuples: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Compute the element\u2011wise bitwise XOR of multiple integer tuples.\n\n    Parameters\n    ----------\n    *tuples : tuple[int, ...]\n        One or more tuples containing integers. All tuples must have the same length.\n\n    Returns\n    -------\n    tuple[int, ...]\n        A tuple where each element is the XOR of the corresponding elements from the input tuples.\n\n    Raises\n    ------\n    ValueError\n        If no tuples are supplied.\n        If any tuple differs in length from the others.\n        If any element is not an integer.\n\n    Notes\n    -----\n    - The function uses the built\u2011in XOR operator '^'.\n    - No external libraries are required.\n    \"\"\"\n    if not tuples:\n        raise ValueError(\"At least one tuple must be provided.\")\n    expected_len = len(tuples[0])\n    for t in tuples:\n        if len(t) != expected_len:\n            raise ValueError(\"All tuples must have the same length.\")\n        for elem in t:\n            if not isinstance(elem, int):\n                raise ValueError(\"All elements must be integers.\")\n    result = []\n    for i in range(expected_len):\n        xor_val = 0\n        for t in tuples:\n            xor_val ^= t[i]\n        result.append(xor_val)\n    return tuple(result)"}
{"task_id": "400", "solution": "def count_unique_tuples(tuples: list[tuple]) -> int:\n    \"\"\"Count the number of unique tuples in the provided list.\n\n    Parameters\n    ----------\n    tuples : list[tuple]\n        List containing tuple objects to be evaluated.\n\n    Returns\n    -------\n    int\n        The number of distinct tuples present in the list.\n\n    Examples\n    --------\n    >>> count_unique_tuples([(1, 2), (3, 4), (1, 2)])\n    2\n    \"\"\"\n    seen = set()\n    for t in tuples:\n        seen.add(t)\n    return len(seen)"}
{"task_id": "401", "solution": "def nested_tuple_add(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"\n    Perform index\u2011wise addition of two nested tuples.\n\n    Parameters:\n        t1 (tuple): First nested tuple of numbers.\n        t2 (tuple): Second nested tuple of numbers.\n\n    Returns:\n        tuple: Nested tuple with element\u2011wise sums.\n\n    Raises:\n        ValueError: If the structures of t1 and t2 differ.\n        TypeError: If any leaf element is not int or float.\n    \"\"\"\n    if not isinstance(t1, tuple) or not isinstance(t2, tuple):\n        raise ValueError(\"Both arguments must be tuples\")\n\n    if len(t1) != len(t2):\n        raise ValueError(\"Tuples must have the same length\")\n\n    result = []\n\n    for e1, e2 in zip(t1, t2):\n        if isinstance(e1, tuple) and isinstance(e2, tuple):\n            result.append(nested_tuple_add(e1, e2))\n        else:\n            if not (isinstance(e1, (int, float)) and isinstance(e2, (int, float))):\n                raise TypeError(\"Leaf elements must be numeric\")\n            result.append(e1 + e2)\n\n    return tuple(result)"}
{"task_id": "404", "solution": "def min_of_two(a: float, b: float) -> float:\n    \"\"\"\n    Return the smaller of two numbers.\n    \n    Parameters:\n        a (float): First number.\n        b (float): Second number.\n    \n    Returns:\n        float: The minimum of a and b.\n    \n    Algorithm:\n        Compare a and b; return the smaller value.\n    \n    Complexity:\n        Time: O(1)\n        Space: O(1)\n    \"\"\"\n    return a if a < b else b"}
