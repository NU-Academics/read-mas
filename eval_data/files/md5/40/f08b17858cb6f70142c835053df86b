{"task_id": "555", "solution": "def difference_of_sums(n: int) -> int:\n    \"\"\"Compute the difference between the sum of cubes and the sum of the first *n* natural numbers.\n\n    The function uses the closed\u2011form formulas:\n\n    - Sum of first *n* natural numbers: `n(n+1)/2`\n    - Sum of first *n* cubes: `[n(n+1)/2]^2`\n\n    The difference is thus `[n(n+1)/2]^2 - n(n+1)/2`.\n\n    Parameters\n    ----------\n    n : int\n        The count of natural numbers to consider. Must be \u2265 1.\n\n    Returns\n    -------\n    int\n        The integer difference `sum_of_cubes - sum_of_natural`.\n\n    Raises\n    ------\n    ValueError\n        If `n` is not an integer or is less than 1.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer (\u2265 1)\")\n    half_sum = n * (n + 1) // 2\n    sum_cubes = half_sum * half_sum\n    return sum_cubes - half_sum"}
{"task_id": "556", "solution": "def count_xor_odd_pairs(nums: list[int]) -> int:\n    cnt_even = 0\n    cnt_odd = 0\n    for num in nums:\n        if num & 1:\n            cnt_odd += 1\n        else:\n            cnt_even += 1\n    return cnt_even * cnt_odd"}
{"task_id": "557", "solution": "def toggle_case(s: str) -> str:\n    result_chars = []\n    for ch in s:\n        if ch.islower():\n            result_chars.append(ch.upper())\n        elif ch.isupper():\n            result_chars.append(ch.lower())\n        else:\n            result_chars.append(ch)\n    return ''.join(result_chars)"}
{"task_id": "558", "solution": "def sum_per_digit_difference(a: int, b: int) -> int:\n    \"\"\"Compute the sum of the absolute differences between corresponding decimal digits\n    of two non-negative integers, padding the shorter number with leading zeros.\n\n    Parameters:\n        a (int): Non-negative integer.\n        b (int): Non-negative integer.\n\n    Returns:\n        int: Sum of absolute per-digit differences.\n\n    Raises:\n        ValueError: If either input is not an integer or is negative.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Inputs must be integers.\")\n    if a < 0 or b < 0:\n        raise ValueError(\"Inputs must be non-negative.\")\n    \n    total_diff = 0\n    while a > 0 or b > 0:\n        digit_a = a % 10\n        digit_b = b % 10\n        total_diff += abs(digit_a - digit_b)\n        a //= 10\n        b //= 10\n    return total_diff"}
{"task_id": "559", "solution": "def max_subarray_sum(nums: list[int]) -> int:\n    if not nums:\n        raise ValueError(\"Input list must contain at least one element.\")\n    for n in nums:\n        if not isinstance(n, int):\n            raise TypeError(\"All elements must be integers.\")\n    max_current = max_global = nums[0]\n    for x in nums[1:]:\n        max_current = x if x > max_current + x else max_current + x\n        max_global = max_global if max_global > max_current else max_current\n    return max_global"}
{"task_id": "560", "solution": "def union_sorted(t1: tuple, t2: tuple) -> list:\n    \"\"\"\n    Return a sorted list containing the unique elements from both input tuples.\n    \"\"\"\n    set1 = set(t1)\n    set2 = set(t2)\n    union_set = set1 | set2\n    sorted_list = sorted(union_set)\n    return sorted_list"}
