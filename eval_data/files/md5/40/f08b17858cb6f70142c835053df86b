{"task_id": "130", "solution": "def most_frequent_item(items: list[object]) -> object:\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list\")\n    if len(items) == 0:\n        raise ValueError(\"items list cannot be empty\")\n\n    freq = {}\n    max_count = 0\n    most_common = None\n\n    for idx, item in enumerate(items):\n        try:\n            hash(item)\n        except TypeError:\n            raise TypeError(f\"element at index {idx} is unhashable\")\n\n        count = freq.get(item, 0) + 1\n        freq[item] = count\n\n        if count > max_count:\n            max_count = count\n            most_common = item\n\n    return most_common"}
{"task_id": "131", "solution": "def reverse_vowels_only(s: str) -> str:\n    vowels = set(\"aeiouAEIOU\")\n    indices = []\n    vowel_chars = []\n    for i, ch in enumerate(s):\n        if ch in vowels:\n            indices.append(i)\n            vowel_chars.append(ch)\n    vowel_chars.reverse()\n    char_list = list(s)\n    for idx, ch in zip(indices, vowel_chars):\n        char_list[idx] = ch\n    return \"\".join(char_list)"}
