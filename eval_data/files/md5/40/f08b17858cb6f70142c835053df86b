{"task_id": "413", "solution": "def get_nth_element(lst: list[tuple], n: int) -> tuple:\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n    if not all(isinstance(item, tuple) for item in lst):\n        raise TypeError(\"All elements of lst must be tuples\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0 or n >= len(lst):\n        raise IndexError(\"n is out of bounds for the list\")\n    return lst[n]"}
{"task_id": "414", "solution": "\"\"\"Module containing has_common_element function.\n\nExample usage:\n    >>> has_common_element([1, 2, 3], {3, 4, 5})\n    True\n    >>> has_common_element(('a', 'b'), ['c', 'd'])\n    False\n    >>> has_common_element([], [1, 2])\n    False\n\"\"\"\n\ndef has_common_element(seq1: list, seq2: list) -> bool:\n    \"\"\"Return True if seq1 and seq2 share at least one element.\n\n    Parameters\n    ----------\n    seq1 : list\n        First sequence to test for commonality. Must not be None.\n    seq2 : list\n        Second sequence to test for commonality. Must not be None.\n\n    Returns\n    -------\n    bool\n        True if there is at least one element that appears in both sequences; False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If seq1 or seq2 is None.\n    TypeError\n        If either argument is not a sequence-like container (i.e., not iterable).\n\n    Complexity\n    ----------\n    Time: O(n + m) where n = len(seq1), m = len(seq2)\n    Space: O(n + m)\n\n    Examples\n    --------\n    >>> has_common_element([1, 2, 3], {3, 4, 5})\n    True\n    >>> has_common_element(('a', 'b'), ['c', 'd'])\n    False\n    >>> has_common_element([], [1, 2])\n    False\n    \"\"\"\n    if seq1 is None or seq2 is None:\n        raise TypeError(\"Input sequence must not be None.\")\n    try:\n        iter(seq1)\n    except TypeError:\n        raise TypeError(\"Input arguments must be sequence-like containers.\")\n    try:\n        iter(seq2)\n    except TypeError:\n        raise TypeError(\"Input arguments must be sequence-like containers.\")\n    set1 = set(seq1)\n    set2 = set(seq2)\n    return bool(set1 & set2)"}
{"task_id": "415", "solution": "def max_product_pair(nums: list[int]) -> tuple[int, int] | None:\n    if len(nums) < 2:\n        return None\n\n    max1: int | None = None\n    max2: int | None = None\n    min1: int | None = None\n    min2: int | None = None\n\n    for x in nums:\n        if max1 is None or x > max1:\n            max2 = max1\n            max1 = x\n        elif max2 is None or x > max2:\n            max2 = x\n\n        if min1 is None or x < min1:\n            min2 = min1\n            min1 = x\n        elif min2 is None or x < min2:\n            min2 = x\n\n    best_pair: tuple[int, int] | None = None\n    best_product: int | None = None\n\n    if max1 is not None and max2 is not None:\n        prod_pos = max1 * max2\n        best_product = prod_pos\n        best_pair = (max1, max2)\n\n    if min1 is not None and min2 is not None:\n        prod_neg = min1 * min2\n        if best_product is None or prod_neg > best_product:\n            best_product = prod_neg\n            best_pair = (min1, min2)\n\n    return best_pair"}
{"task_id": "417", "solution": "def find_common_first_element(tuples: list[tuple]) -> object | None:\n    \"\"\"Determines the common first element among all tuples in the provided list.\n\n    Parameters\n    ----------\n    tuples : list[tuple]\n        A list where each element is a tuple.\n\n    Returns\n    -------\n    object | None\n        The first element that appears in every tuple, or None if no such element exists.\n    \"\"\"\n    if not isinstance(tuples, list):\n        raise TypeError(\"Input must be a list of tuples.\")\n    if not tuples:\n        return None\n    for t in tuples:\n        if not isinstance(t, tuple):\n            raise TypeError(\"All elements in the list must be tuples.\")\n        if not t:  # Empty tuple\n            return None\n    candidate = tuples[0][0]\n    for t in tuples[1:]:\n        if t[0] != candidate:\n            return None\n    return candidate"}
{"task_id": "418", "solution": "def find_max_length_element(strings: list[str]) -> str:\n    \"\"\"Return the string with the maximum length from the input list.\n\n    Parameters\n    ----------\n    strings : list[str]\n        A list of string elements. Must not be empty.\n\n    Returns\n    -------\n    str\n        The string from ``strings`` that has the greatest length.\n        If more than one string has the same maximum length, the\n        first such string in the original order is returned.\n\n    Raises\n    ------\n    ValueError\n        If ``strings`` is empty.\n    \"\"\"\n    if not strings:\n        raise ValueError(\"The input list must not be empty.\")\n    max_elem = strings[0]\n    max_len = len(max_elem)\n    for s in strings[1:]:\n        cur_len = len(s)\n        if cur_len > max_len:\n            max_len = cur_len\n            max_elem = s\n    return max_elem"}
{"task_id": "419", "solution": "def process_numbers(numbers: list[float]) -> None:\n    \"\"\"Process a list of numbers by rounding, summing, and scaling.\n\n    Parameters\n    ----------\n    numbers : list[float]\n        A list of numeric values (int or float).\n\n    The function prints the final result but returns None.\n    \"\"\"\n    length = len(numbers)\n    if length == 0:\n        print(0)\n        return\n\n    rounded_sum = 0\n    for value in numbers:\n        rounded_sum += round(value)\n\n    final_result = rounded_sum * length\n    print(final_result)"}
{"task_id": "420", "solution": "def cube_sum_even(n: int) -> int:\n    \"\"\"Return the cube sum of the first *n* even natural numbers.\n\n    The cube sum is defined as the sum of the cubes of the first\n    *n* even numbers: 2\u00b3 + 4\u00b3 + \u2026 + (2*n)\u00b3. Using the closed\u2011form\n    expression this equals 2 * n\u00b2 * (n+1)\u00b2.\n\n    Parameters\n    ----------\n    n : int\n        The number of even natural numbers to include in the sum.\n        Must be a positive integer (n > 0).\n\n    Returns\n    -------\n    int\n        The cube sum of the first *n* even natural numbers.\n\n    Raises\n    ------\n    ValueError\n        If `n` is not a positive integer (i.e., n <= 0).\n\n    Examples\n    --------\n    >>> cube_sum_even(1)\n    8\n    >>> cube_sum_even(2)\n    72\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input `n` must be a positive integer.\")\n    if n <= 0:\n        raise ValueError(\"Input `n` must be a positive integer.\")\n    square_n = n * n\n    square_n_plus_1 = (n + 1) * (n + 1)\n    return 2 * square_n * square_n_plus_1"}
{"task_id": "421", "solution": "def concat_tuple_elements(t: tuple, delimiter: str) -> str:\n    if not isinstance(t, tuple):\n        raise TypeError(f\"Expected tuple, got {type(t).__name__}\")\n    if not isinstance(delimiter, str):\n        raise TypeError(f\"Expected str for delimiter, got {type(delimiter).__name__}\")\n    if not t:\n        return \"\"\n    return delimiter.join(str(e) for e in t)"}
{"task_id": "422", "solution": "def average_of_cubes(n: int) -> float:\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer\")\n    total = 0\n    for i in range(1, n + 1):\n        total += i ** 3\n    return total / n"}
{"task_id": "424", "solution": "def extract_rear_index_elements(strings: tuple[str, ...]) -> list[str]:\n    \"\"\"\n    Extract the last character (rear index element) from each string in a tuple.\n\n    Parameters\n    ----------\n    strings : tuple[str, ...]\n        A tuple containing zero or more string objects.\n\n    Returns\n    -------\n    list[str]\n        A list where each element is the last character of the corresponding\n        string in the input tuple. For an empty string, the corresponding\n        output element is an empty string.\n\n    Raises\n    ------\n    TypeError\n        If `strings` is not a tuple or if any element of the tuple is not a\n        string.\n    \"\"\"\n    if not isinstance(strings, tuple):\n        raise TypeError(\"Input must be a tuple of strings.\")\n    result: list[str] = []\n    for s in strings:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements of the input tuple must be strings.\")\n        result.append(s[-1] if s else \"\")\n    return result"}
{"task_id": "425", "solution": "def count_sublists_with_element(\n    sublists: list[list[object]],\n    element: object\n) -> int:\n    \"\"\"Counts how many sublists within 'sublists' contain 'element'.\n\n    Parameters:\n        sublists (list[list[object]]): Two\u2011dimensional list of arbitrary objects.\n        element (object): The element to search for within each sublist.\n\n    Returns:\n        int: Number of sublists that contain 'element' at least once.\n    \"\"\"\n    count = 0\n    for sublist in sublists:\n        if element in sublist:\n            count += 1\n    return count"}
{"task_id": "426", "solution": "def filter_odds(numbers: list[int]) -> list[int]:\n    \"\"\"Return a new list containing only odd integers from the input list.\n\n    Parameters:\n        numbers: A list of integers. Raises TypeError if any element is not an int.\n\n    Returns:\n        A new list of odd integers, preserving input order.\n    \"\"\"\n    # Validate all elements are integers\n    for n in numbers:\n        if type(n) is not int:\n            raise TypeError(\"All elements must be integers.\")\n\n    # Filter odds using list comprehension\n    return [n for n in numbers if n % 2 != 0]"}
{"task_id": "427", "solution": "from datetime import date\n\ndef convert_date(date_str: str) -> str:\n    \"\"\"Convert a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy'.\n\n    Parameters\n    ----------\n    date_str : str\n        The input date in ISO format 'yyyy-mm-dd'.\n\n    Returns\n    -------\n    str\n        The date in European format 'dd-mm-yyyy'.\n\n    Raises\n    ------\n    ValueError\n        If the input is not a valid ISO date string or represents\n        an impossible calendar date.\n    \"\"\"\n    _validate_format(date_str)\n    y, m, d = _parse_components(date_str)\n    _validate_date(y, m, d)\n    return _format_output(d, m, y)\n\ndef _validate_format(date_str: str) -> None:\n    if not date_str:\n        raise ValueError(\"Invalid input: input cannot be empty.\")\n    if len(date_str) != 10:\n        raise ValueError(f\"Invalid input: expected format 'yyyy-mm-dd' but got '{date_str}'.\")\n    if date_str[4] != '-' or date_str[7] != '-':\n        raise ValueError(\"Invalid input: expected '-' at positions 5 and 8.\")\n    parts = [date_str[:4], date_str[5:7], date_str[8:]]\n    if not all(part.isdigit() for part in parts):\n        raise ValueError(\"Invalid input: non-numeric characters found.\")\n\ndef _parse_components(date_str: str) -> tuple[int, int, int]:\n    return int(date_str[0:4]), int(date_str[5:7]), int(date_str[8:10])\n\ndef _is_leap_year(y: int) -> bool:\n    return (y % 4 == 0) and ((y % 100 != 0) or (y % 400 == 0))\n\ndef _validate_date(y: int, m: int, d: int) -> None:\n    if y == 0:\n        if not (1 <= m <= 12):\n            raise ValueError(f\"Invalid input: month {m} is out of range.\")\n        days_in_month = [31, 29 if _is_leap_year(y) else 28, 31, 30, 31, 30,\n                         31, 31, 30, 31, 30, 31]\n        if not (1 <= d <= days_in_month[m - 1]):\n            raise ValueError(f\"Invalid input: day {d} is out of range.\")\n    else:\n        try:\n            date(y, m, d)\n        except ValueError as exc:\n            raise ValueError(f\"Invalid input: {y:04d}-{m:02d}-{d:02d} is not a valid calendar date.\") from exc\n\ndef _format_output(d: int, m: int, y: int) -> str:\n    return f\"{d:02d}-{m:02d}-{y:04d}\""}
{"task_id": "428", "solution": "import numbers\n\ndef shell_sort(arr: list[float]) -> list[float]:\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list of numbers\")\n    for x in arr:\n        if not isinstance(x, numbers.Number):\n            raise TypeError(\"All elements must be numeric\")\n    n = len(arr)\n    sorted_arr = arr.copy()\n    gap = n // 2\n    while gap > 0:\n        for i in range(gap, n):\n            temp = sorted_arr[i]\n            j = i\n            while j >= gap and sorted_arr[j - gap] > temp:\n                sorted_arr[j] = sorted_arr[j - gap]\n                j -= gap\n            sorted_arr[j] = temp\n        gap //= 2\n    return sorted_arr"}
{"task_id": "429", "solution": "from typing import Tuple\n\ndef bitwise_and_tuples(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"Returns a tuple where each element is the bitwise AND of the\n    corresponding elements from tuples a and b.\n\n    Parameters\n    ----------\n    a : tuple[int, ...]\n        First tuple of integers.\n    b : tuple[int, ...]\n        Second tuple of integers.\n\n    Returns\n    -------\n    tuple[int, ...]\n        Tuple of bitwise AND results.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not a tuple or contains non\u2011integer elements.\n    ValueError\n        If the tuples have different lengths.\n    \"\"\"\n    if not isinstance(a, tuple):\n        raise TypeError(\"First argument must be a tuple of integers.\")\n    if not isinstance(b, tuple):\n        raise TypeError(\"Second argument must be a tuple of integers.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Tuples must have the same length.\")\n\n    for idx, (x, y) in enumerate(zip(a, b)):\n        if not isinstance(x, int):\n            raise TypeError(f\"Element {idx} of first tuple is not an int.\")\n        if not isinstance(y, int):\n            raise TypeError(f\"Element {idx} of second tuple is not an int.\")\n\n    return tuple(x & y for x, y in zip(a, b))"}
{"task_id": "430", "solution": "def directrix_of_parabola(a: float, b: float, c: float) -> float:\n    \"\"\"Calculate the directrix of a parabola defined by y = ax^2 + bx + c.\n\n    Parameters:\n        a (float): Quadratic coefficient (must not be zero).\n        b (float): Linear coefficient.\n        c (float): Constant term.\n\n    Returns:\n        float: The y-coordinate of the directrix.\n\n    Raises:\n        TypeError: If any coefficient is not numeric.\n        ValueError: If a == 0.\n    \"\"\"\n    _validate_inputs(a, b, c)\n    return _compute_directrix(a, b, c)\n\ndef _validate_inputs(a, b, c):\n    \"\"\"Validate that a, b, and c are numeric and that a is non-zero.\"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)) or not isinstance(c, (int, float)):\n        raise TypeError(_ERROR_MESSAGES[\"non_numeric\"])\n    if a == 0:\n        raise ValueError(_ERROR_MESSAGES[\"zero_a\"])\n\ndef _compute_vertex(a, b, c) -> tuple[float, float]:\n    \"\"\"Compute the vertex (h, k) of the parabola y = ax^2 + bx + c.\"\"\"\n    h = -b / (2 * a)\n    k = a * h * h + b * h + c\n    return h, k\n\ndef _compute_directrix(a, b, c) -> float:\n    \"\"\"Compute the y-coordinate of the directrix for y = ax^2 + bx + c.\"\"\"\n    _, k = _compute_vertex(a, b, c)\n    return k - 1 / (4 * a)\n\n_ERROR_MESSAGES = {\n    \"non_numeric\": \"Coefficients must be numeric.\",\n    \"zero_a\": \"Coefficient a must not be zero.\"\n}"}
{"task_id": "431", "solution": "def have_common_element(list1: list[object], list2: list[object]) -> bool:\n    \"\"\"\n    Determine whether two lists share at least one element.\n\n    Parameters\n    ----------\n    list1 : list[object]\n        First input list. Elements are expected to be hashable.\n    list2 : list[object]\n        Second input list. Elements are expected to be hashable.\n\n    Returns\n    -------\n    bool\n        True if there exists at least one element common to both lists,\n        False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not a list.\n\n    Examples\n    --------\n    >>> have_common_element([1, 2, 3], [4, 5, 6])\n    False\n    >>> have_common_element(['apple', 'banana'], ['cherry', 'banana'])\n    True\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both arguments must be of type list.\")\n\n    if len(list1) <= len(list2):\n        smaller, larger = list1, list2\n    else:\n        smaller, larger = list2, list1\n\n    seen = set(smaller)\n    for element in larger:\n        if element in seen:\n            return True\n    return False"}
{"task_id": "432", "solution": "def find_trapezium_median_length(base_a: float, base_b: float) -> float:\n    \"\"\"\n    Calculates the median length of a trapezium.\n\n    Parameters:\n        base_a (float): Length of the first parallel side (must be > 0).\n        base_b (float): Length of the second parallel side (must be > 0).\n\n    Returns:\n        float: The median length, computed as (base_a + base_b) / 2.\n\n    Raises:\n        TypeError: If either argument is not a real number.\n        ValueError: If either argument is <= 0.\n    \"\"\"\n    # Type validation\n    if not isinstance(base_a, (int, float)):\n        raise TypeError(f\"base_a must be a number, got {type(base_a)}\")\n    if not isinstance(base_b, (int, float)):\n        raise TypeError(f\"base_b must be a number, got {type(base_b)}\")\n\n    # Value validation\n    if base_a <= 0:\n        raise ValueError(f\"base_a must be positive, got {base_a}\")\n    if base_b <= 0:\n        raise ValueError(f\"base_b must be positive, got {base_b}\")\n\n    # Compute and return the median\n    return (base_a + base_b) / 2.0"}
{"task_id": "433", "solution": "import math\nimport numbers\n\ndef is_greater_than_all(nums: list[float], candidate: float) -> bool:\n    \"\"\"Return True if `candidate` is strictly greater than every element in `nums`,\n    otherwise False.\n\n    Raises:\n        TypeError: If `nums` is not a list, an element of `nums` is not numeric,\n                   or `candidate` is not numeric.\n        ValueError: If any element of `nums` is NaN or infinite, or if\n                    `candidate` is NaN or infinite.\n    \"\"\"\n    # Validate that nums is a list\n    if not isinstance(nums, list):\n        raise TypeError(f\"'nums' must be a list, got {type(nums).__name__}\")\n\n    # Validate that candidate is a numeric type\n    if not isinstance(candidate, numbers.Real):\n        raise TypeError(f\"'candidate' must be a numeric type, got {type(candidate).__name__}\")\n\n    # Candidate cannot be NaN or infinite\n    if isinstance(candidate, float) and (math.isnan(candidate) or math.isinf(candidate)):\n        raise ValueError(\"Candidate must be a finite number\")\n\n    # Handle empty array\n    if not nums:\n        return True\n\n    # Iterate over nums\n    for idx, num in enumerate(nums):\n        if not isinstance(num, numbers.Real):\n            raise TypeError(f\"Element at index {idx} is not numeric: {type(num).__name__}\")\n\n        if isinstance(num, float) and (math.isnan(num) or math.isinf(num)):\n            raise ValueError(f\"Element at index {idx} must be a finite number\")\n\n        if candidate <= num:\n            return False\n\n    return True"}
{"task_id": "434", "solution": "def match_ab(s: str) -> bool:\n    \"\"\"Return True if s matches the pattern 'a' followed by one or more 'b's.\"\"\"\n    if not s:\n        return False\n    if s[0] != 'a':\n        return False\n    if len(s) == 1:\n        return False\n    for ch in s[1:]:\n        if ch != 'b':\n            return False\n    return True\n\n__all__ = [\"match_ab\"]"}
