{"task_id": "796", "solution": "def sum_dict(data: dict[str, int | float]) -> float:\n    \"\"\"Sum the numeric values of a dictionary with string keys.\n\n    Parameters\n    ----------\n    data : dict[str, int | float]\n        A mapping where keys are strings and values are numeric (int or float).\n\n    Returns\n    -------\n    float\n        The total of all numeric values. The result is always a float, even if all\n        input values are integers.\n\n    Raises\n    ------\n    ValueError\n        If any key is not a string or if any value is not an int or float.\n        The error message includes the offending key and its type.\n\n    Examples\n    --------\n    >>> sum_dict({'a': 1, 'b': 2.5})\n    3.5\n\n    >>> sum_dict({})\n    0.0\n\n    # Invalid input\n    >>> sum_dict({'a': 1, 'b': 'two'})\n    ValueError: Value for key 'b' is not numeric: str\n    \"\"\"\n    total = 0.0\n    for key, value in data.items():\n        if not isinstance(key, str):\n            raise ValueError(f\"Key {key!r} is not a string: {type(key).__name__}\")\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"Value for key {key!r} is not numeric: {type(value).__name__}\")\n        total += float(value)\n    return total"}
{"task_id": "797", "solution": "def sum_odd_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Return the sum of all odd natural numbers in the inclusive range [l, r].\n\n    Parameters:\n        l (int): Lower bound of the range (natural number, \u2265 1).\n        r (int): Upper bound of the range (natural number, \u2265 1).\n\n    Returns:\n        int: Sum of odd numbers. Returns 0 if no odd numbers exist or l > r.\n    \"\"\"\n    if l > r:\n        return 0\n    if l % 2 == 0:\n        first_odd = l + 1\n    else:\n        first_odd = l\n    if r % 2 == 0:\n        last_odd = r - 1\n    else:\n        last_odd = r\n    if first_odd > last_odd:\n        return 0\n    count = ((last_odd - first_odd) // 2) + 1\n    total = count * (first_odd + last_odd) // 2\n    return total"}
{"task_id": "798", "solution": "def sum_numeric_array(values: list[float]) -> float:\n    \"\"\"Returns the sum of a numeric list.\n\n    Parameters\n    ----------\n    values : list[float]\n        A list containing numeric elements (int or float).\n\n    Returns\n    -------\n    float\n        The sum of all elements. Returns 0.0 for an empty list.\n\n    Raises\n    ------\n    TypeError\n        If 'values' is not a list, or any element is not int or float.\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(\"Input must be a list.\")\n    for v in values:\n        if not isinstance(v, (int, float)):\n            raise TypeError(\"All elements must be int or float.\")\n    return float(sum(values))"}
{"task_id": "799", "solution": "def rotate_left_32(value: int, shift: int) -> int:\n    if not isinstance(value, int):\n        raise TypeError(\"value must be an int\")\n    if not isinstance(shift, int):\n        raise TypeError(\"shift must be an int\")\n    if value < 0 or value > 0xFFFFFFFF:\n        raise ValueError(\"value out of 32\u2011bit range\")\n    if shift < 0:\n        raise ValueError(\"shift must be non\u2011negative\")\n    shift_mod = shift % 32\n    if shift_mod == 0:\n        return value\n    left = (value << shift_mod) & 0xFFFFFFFF\n    right = value >> (32 - shift_mod)\n    return (left | right) & 0xFFFFFFFF"}
{"task_id": "800", "solution": "def remove_whitespaces(s: str) -> str:\n    if not isinstance(s, str):\n        raise TypeError(\n            f\"remove_whitespaces() expects a string argument, got {type(s).__name__}\"\n        )\n    return \"\".join(c for c in s if not c.isspace())"}
{"task_id": "801", "solution": "def count_equal_numbers(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Count how many of the three integers are equal.\n    \n    Returns:\n        3 if all three integers are equal,\n        2 if any two integers are equal,\n        0 if all three integers are distinct.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    if a == b or b == c or a == c:\n        return 2\n    return 0"}
{"task_id": "802", "solution": "def count_rotations(arr: list[int]) -> int:\n    \"\"\"\n    Return the number of rotations required to transform the given list of integers\n    into a sorted ascending list. The function operates in O(log\u202fn) time using a\n    binary\u2011search approach and handles trivial cases (empty, single element, already sorted).\n\n    Parameters\n    ----------\n    arr : list[int]\n        List of integers that is a rotated sorted array.\n\n    Returns\n    -------\n    int\n        The index of the minimum element, which equals the rotation count.\n\n    Raises\n    ------\n    TypeError\n        If `arr` is not a list of integers.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list\")\n    for i, v in enumerate(arr):\n        if not isinstance(v, int):\n            raise TypeError(f\"All elements must be integers; element at index {i} is {type(v).__name__}\")\n\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    if _is_sorted(arr):\n        return 0\n\n    return _find_min_index(arr)\n\n\ndef _is_sorted(arr: list[int]) -> bool:\n    \"\"\"Return True if `arr` is sorted in ascending order, False otherwise.\"\"\"\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i + 1]:\n            return False\n    return True\n\n\ndef _find_min_index(arr: list[int]) -> int:\n    \"\"\"Binary\u2011search helper that returns the index of the minimum element.\"\"\"\n    low, high = 0, len(arr) - 1\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] > arr[high]:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n\n# End of module"}
{"task_id": "803", "solution": "import math\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Determine whether an integer is a perfect square.\n\n    Parameters\n    ----------\n    n : int\n        The integer to test.\n\n    Returns\n    -------\n    bool\n        True if n is a perfect square, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If n is not an instance of int.\n    ValueError\n        If n is negative.\n\n    Examples\n    --------\n    >>> is_perfect_square(16)\n    True\n    >>> is_perfect_square(17)\n    False\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Negative numbers cannot be perfect squares.\")\n    root = math.isqrt(n)\n    return root * root == n"}
{"task_id": "804", "solution": "def is_product_even(numbers: list[int]) -> bool:\n    \"\"\"Return True if the product of the list is even, otherwise False.\n    Handles empty list by returning True.\n    Non-integer elements are coerced to int; if conversion fails, the element is ignored.\"\"\"\n    if not numbers:\n        return True\n    for num in numbers:\n        try:\n            n = int(num)\n        except (ValueError, TypeError):\n            continue\n        if n % 2 == 0:\n            return True\n    return False"}
{"task_id": "805", "solution": "def _is_number(value: object) -> bool:\n    return isinstance(value, (int, float))\n\ndef _validate_lists(lists: list[list[float]]) -> None:\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists\")\n    for sub in lists:\n        if not isinstance(sub, list):\n            raise TypeError(\"Each element must be a list\")\n        for v in sub:\n            if not _is_number(v):\n                raise TypeError(\"List elements must be int or float\")\n\ndef max_sum_sublist(lists: list[list[float]]) -> list[float]:\n    \"\"\"Return the sublist with the highest sum of elements.\n\n    Parameters:\n        lists (list[list[float]]): A list of numeric sublists.\n\n    Returns:\n        list[float]: The sublist with the maximum sum, or [] if input is empty.\n\n    Raises:\n        TypeError: If the input is not a list of lists of numbers.\n    \"\"\"\n    _validate_lists(lists)\n    if not lists:\n        return []\n\n    max_sum = float('-inf')\n    best_sublist: list[float] = []\n\n    for sub in lists:\n        current_sum = sum(sub)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            best_sublist = sub\n\n    return best_sublist"}
{"task_id": "806", "solution": "def max_upper_run(s: str) -> int:\n    max_run = 0\n    current_run = 0\n    for c in s:\n        if c.isalpha() and c.isupper():\n            current_run += 1\n        else:\n            if current_run > max_run:\n                max_run = current_run\n            current_run = 0\n    if current_run > max_run:\n        max_run = current_run\n    return max_run"}
{"task_id": "807", "solution": "def find_first_odd(nums: list[int]) -> int | None:\n    for n in nums:\n        if n % 2 != 0:\n            return n\n    return None"}
{"task_id": "808", "solution": "def contains_value(*tuples: tuple, k: object) -> bool:\n    \"\"\"\n    Return True if any of the supplied tuples contains the target value k, otherwise False.\n\n    Parameters:\n        *tuples (tuple): Zero or more tuple arguments to search.\n        k (object): The value to search for within the tuples.\n\n    Returns:\n        bool: True if k is found in any tuple, False otherwise.\n\n    Raises:\n        TypeError: If any argument before k is not a tuple.\n        TypeError: If k is omitted.\n    \"\"\"\n    # Validate tuple arguments\n    for item in tuples:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Argument {item!r} is not a tuple\")\n\n    # Search for k in each tuple\n    for t in tuples:\n        if k in t:\n            return True\n    return False"}
{"task_id": "809", "solution": "def is_strictly_smaller(a: tuple[float, ...], b: tuple[float, ...]) -> bool:\n    \"\"\"\n    Returns True if every element of tuple b is strictly less than the\n    corresponding element in tuple a. Returns False if tuple lengths differ,\n    if any element is not comparable, or if any comparison fails.\n\n    Parameters:\n        a: tuple of numeric values (int or float).\n        b: tuple of numeric values (int or float).\n\n    Returns:\n        bool: True if b[i] < a[i] for all i; False otherwise.\n\n    Notes:\n        The function handles type errors gracefully by returning False\n        rather than raising an exception.\n    \"\"\"\n    # Verify both inputs are tuples\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        return False\n\n    # Length validation\n    if len(a) != len(b):\n        return False\n\n    # Element-wise comparison\n    for x, y in zip(a, b):\n        try:\n            if not (y < x):\n                return False\n        except Exception:\n            return False\n\n    return True"}
