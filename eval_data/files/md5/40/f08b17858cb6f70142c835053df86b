{"task_id": "101", "solution": "def kth_element(arr: list[int], k: int) -> int:\n    \"\"\"Retrieve the k\u2011th element from arr using 1\u2011based indexing.\n\n    Parameters\n    ----------\n    arr : list[int]\n        The input list from which to retrieve the element.\n    k : int\n        1\u2011based index specifying the desired element.\n\n    Returns\n    -------\n    int\n        The element at the specified position.\n\n    Raises\n    ------\n    ValueError\n        If k is not a positive integer.\n    IndexError\n        If k is larger than the length of arr.\n    \"\"\"\n    if k <= 0:\n        raise ValueError(f\"k must be a positive integer, got {k}\")\n    index = k - 1\n    if index >= len(arr):\n        raise IndexError(\n            f\"k={k} is out of bounds for array of length {len(arr)}\"\n        )\n    return arr[index]"}
{"task_id": "102", "solution": "def snake_to_camel(name: str) -> str:\n    \"\"\"Convert a snake_case string to camelCase.\n    \n    Parameters\n    ----------\n    name : str\n        The snake_case string to convert. Must contain only lowercase letters,\n        digits, and underscores. Leading, trailing, or consecutive underscores\n        are treated as separators and ignored.\n    \n    Returns\n    -------\n    str\n        The camelCase representation of *name*. If *name* is empty, an empty\n        string is returned.\n    \n    Raises\n    ------\n    ValueError\n        If *name* is not a string or contains characters outside the allowed\n        set [a\u2011z, 0\u20119, _].\n    \n    Examples\n    --------\n    >>> snake_to_camel('example_string_value')\n    'exampleStringValue'\n    >>> snake_to_camel('alreadyCamelCase')\n    Traceback (most recent call last):\n        ...\n    ValueError: Invalid character in snake_case string\n    \"\"\"\n    if not isinstance(name, str):\n        raise ValueError('Input must be a string')\n    if name == '':\n        return ''\n    # Validate allowed characters\n    for ch in name:\n        if not (('a' <= ch <= 'z') or ('0' <= ch <= '9') or ch == '_'):\n            raise ValueError('Invalid character in snake_case string')\n    parts = [p for p in name.split('_') if p]\n    if not parts:\n        return ''\n    result = [parts[0]]\n    for part in parts[1:]:\n        result.append(part[0].upper() + part[1:])\n    return ''.join(result)"}
{"task_id": "103", "solution": "def eulerian_number(n: int, m: int) -> int:\n    \"\"\"Compute the Eulerian number a(n, m) with memoization.\"\"\"\n    if not isinstance(n, int) or not isinstance(m, int):\n        raise TypeError(\"n and m must be integers\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if m < 0 or m >= n:\n        raise ValueError(\"m must satisfy 0 <= m < n\")\n\n    cache: dict[tuple[int, int], int] = {}\n\n    def _eulerian(n: int, m: int) -> int:\n        if n == 0 and m == 0:\n            return 1\n        if m < 0 or m >= n:\n            return 0\n        if m == 0:\n            return 1\n\n        key = (n, m)\n        if key in cache:\n            return cache[key]\n\n        term1 = (n - m) * _eulerian(n - 1, m - 1)\n        term2 = (m + 1) * _eulerian(n - 1, m)\n        result = term1 + term2\n        cache[key] = result\n        return result\n\n    return _eulerian(n, m)"}
