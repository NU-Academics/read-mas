{"task_id": "2", "solution": "import logging\nfrom typing import List, Any\n\n_logger = logging.getLogger(__name__)\nif not _logger.handlers:\n    handler = logging.StreamHandler()\n    formatter = logging.Formatter(\"%(levelname)s: %(message)s\")\n    handler.setFormatter(formatter)\n    _logger.addHandler(handler)\n    _logger.setLevel(logging.WARNING)\n\n\ndef _is_hashable(obj: Any) -> bool:\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\n\ndef intersect_lists(list_a: List[Any], list_b: List[Any]) -> List[Any]:\n    if not isinstance(list_a, list):\n        raise TypeError(f\"Expected list for list_a, got {type(list_a).__name__}\")\n    if not isinstance(list_b, list):\n        raise TypeError(f\"Expected list for list_b, got {type(list_b).__name__}\")\n\n    set_b = set()\n    for x in list_b:\n        if _is_hashable(x):\n            set_b.add(x)\n        else:\n            _logger.warning(f\"Ignored unhashable element in list_b: {x!r}\")\n\n    seen = set()\n    result = []\n\n    for x in list_a:\n        if not _is_hashable(x):\n            _logger.warning(f\"Ignored unhashable element in list_a: {x!r}\")\n            continue\n        if x in set_b and x not in seen:\n            result.append(x)\n            seen.add(x)\n\n    return result"}
{"task_id": "3", "solution": "import math\n\ndef is_non_prime(n: int) -> bool:\n    if not isinstance(n, int):\n        raise TypeError(f\"Input must be an integer, got {type(n).__name__}.\")\n    if n < 2:\n        return True\n    if n in (2, 3):\n        return False\n    if n % 2 == 0:\n        return True\n    limit = math.isqrt(n)\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "4", "solution": "def find_n_largest(nums: list[int], n: int) -> list[int]:\n    # Input validation\n    if not isinstance(nums, list):\n        raise TypeError(\"nums must be a list of integers\")\n    if not all(isinstance(x, int) for x in nums):\n        raise TypeError(\"nums must be a list of integers\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be a non-negative integer\")\n    if n < 0:\n        raise TypeError(\"n must be a non-negative integer\")\n\n    # Edge cases\n    if n == 0 or not nums:\n        return []\n\n    import heapq\n    heap: list[int] = []\n\n    for x in nums:\n        if len(heap) < n:\n            heapq.heappush(heap, x)\n        elif x > heap[0]:\n            heapq.heapreplace(heap, x)\n\n    return sorted(heap, reverse=True)"}
{"task_id": "6", "solution": "def differ_by_one_bit(a: int, b: int) -> bool:\n    \"\"\"\n    Determine if two unsigned integers differ in exactly one bit position.\n\n    Args:\n        a (int): First non-negative integer.\n        b (int): Second non-negative integer.\n\n    Returns:\n        bool: True if a and b differ by exactly one bit, False otherwise.\n\n    Raises:\n        TypeError: If either a or b is not an integer.\n        ValueError: If either a or b is negative.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers.\")\n    if a < 0 or b < 0:\n        raise ValueError(\"Inputs must be non-negative integers.\")\n\n    xor = a ^ b\n    # No difference or more than one bit difference\n    if xor == 0 or (xor & (xor - 1)) != 0:\n        return False\n    return True"}
{"task_id": "7", "solution": "import re\n\ndef find_long_words(text: str) -> list[str]:\n    \"\"\"\n    Extracts all words of length >= 4 from the input string.\n\n    Parameters:\n        text (str): The source string to search.\n\n    Returns:\n        list[str]: Ordered list of qualifying words.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    pattern = re.compile(r'\\b\\w+\\b')\n    return [w for w in pattern.findall(text) if len(w) >= 4]"}
{"task_id": "8", "solution": "def square_list(nums: list[float]) -> list[float]:\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n    squared = []\n    for x in nums:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements must be numeric.\")\n        squared.append(x * x)\n    return squared"}
{"task_id": "9", "solution": "def min_rotations(s: str) -> int:\n    \"\"\"\n    Compute the minimal positive rotation count that restores the original string.\n\n    Parameters:\n        s (str): Input string.\n\n    Returns:\n        int: Minimum rotation count (>0) that yields the original string.\n             Returns 0 for empty input.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    pi = [0] * n\n    for i in range(1, n):\n        j = pi[i - 1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n\n    period = n - pi[-1]\n    if n % period == 0:\n        return period\n    return n"}
{"task_id": "11", "solution": "def remove_first_last_occurrence(s: str, target: str) -> str:\n    \"\"\"Remove the first and last occurrence of `target` from `s`.\n    If `target` occurs fewer than two times, return `s` unchanged.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(f\"s must be a string, got {type(s).__name__}\")\n    if not s:\n        raise ValueError(\"s cannot be an empty string\")\n\n    if not isinstance(target, str):\n        raise ValueError(f\"target must be a string, got {type(target).__name__}\")\n    if len(target) != 1:\n        raise ValueError(\"target must be a single character string\")\n\n    first_index = s.find(target)\n    last_index = s.rfind(target)\n\n    if first_index == -1 or last_index == -1 or first_index == last_index:\n        return s\n\n    return s[:first_index] + s[first_index + 1:last_index] + s[last_index + 1:]\n"}
{"task_id": "12", "solution": "def sort_matrix_by_row_sum(matrix: list[list[float]]) -> list[list[float]]:\n    if not isinstance(matrix, list) or not matrix:\n        raise TypeError(\"matrix must be a non\u2011empty list of lists\")\n    for row in matrix:\n        if not isinstance(row, list):\n            raise TypeError(\"matrix must contain only lists\")\n    row_lengths = [len(row) for row in matrix]\n    if len(set(row_lengths)) != 1:\n        raise ValueError(\"all rows must have the same number of columns\")\n    for row in matrix:\n        for value in row:\n            if not isinstance(value, (int, float)):\n                raise TypeError(\"matrix elements must be numeric (int or float)\")\n    return sorted(matrix, key=lambda r: sum(r))"}
{"task_id": "14", "solution": "def triangular_prism_volume(base_area: float, height: float) -> float:\n    \"\"\"Calculate the volume of a triangular prism.\n\n    Parameters\n    ----------\n    base_area : float\n        Area of the triangular base. Must be a positive number.\n    height : float\n        Height of the prism. Must be a positive number.\n\n    Returns\n    -------\n    float\n        The volume of the prism.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not an int or float.\n    ValueError\n        If either argument is zero or negative.\n    \"\"\"\n    if not isinstance(base_area, (int, float)) or not isinstance(height, (int, float)):\n        raise TypeError(\"base_area and height must be numeric types (int or float)\")\n    base_area = float(base_area)\n    height = float(height)\n    if base_area <= 0 or height <= 0:\n        raise ValueError(f\"base_area and height must be positive; received base_area={base_area}, height={height}\")\n    return base_area * height"}
