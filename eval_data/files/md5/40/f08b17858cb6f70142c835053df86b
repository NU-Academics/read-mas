{"task_id": "133", "solution": "from collections.abc import Iterable\n\n__all__ = [\"sum_negative_numbers\"]\n\ndef sum_negative_numbers(nums: Iterable[float]) -> float:\n    \"\"\"Returns the sum of all negative numbers in the provided iterable.\n\n    Parameters:\n        nums (Iterable[float]): An iterable of numeric values (int or float).\n\n    Returns:\n        float: The sum of all negative numbers. Returns 0.0 if no negative numbers exist.\n    \"\"\"\n    total = 0.0\n    for x in nums:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\n                f\"All elements must be numeric, got {type(x).__name__}\"\n            )\n        if x < 0:\n            total += x\n    return total"}
{"task_id": "135", "solution": "def nth_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Return the nth hexagonal number.\n\n    A hexagonal number H_n is defined by the formula:\n        H_n = n * (2 * n - 1)\n\n    Parameters\n    ----------\n    n : int\n        The position in the hexagonal number sequence (1\u2011based).\n        Must be an integer >= 1.\n\n    Returns\n    -------\n    int\n        The value of the nth hexagonal number.\n\n    Raises\n    ------\n    ValueError\n        If n is not an integer or n < 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(f\"n must be an integer, got {type(n).__name__}\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    return n * (2 * n - 1)"}
{"task_id": "137", "solution": "def zero_to_nonzero_ratio(data: list[int]) -> float:\n    \"\"\"\n    Calculate the ratio of zero elements to non\u2011zero elements in a list of integers.\n\n    Parameters\n    ----------\n    data : list[int]\n        List containing integer elements.\n\n    Returns\n    -------\n    float\n        0.0 if the list is empty.\n        float('inf') if there are no non\u2011zero elements.\n        Otherwise the ratio ``count_zero / count_non_zero`` as a float.\n\n    Raises\n    ------\n    ValueError\n        If any element in ``data`` is not an integer. The exception message\n        includes the index and offending value.\n    \"\"\"\n    if len(data) == 0:\n        return 0.0\n\n    zero_count = 0\n    non_zero_count = 0\n\n    for idx, item in enumerate(data):\n        if not isinstance(item, int):\n            raise ValueError(f'Element at index {idx} is not an integer: {item}')\n        if item == 0:\n            zero_count += 1\n        else:\n            non_zero_count += 1\n\n    if non_zero_count == 0:\n        return float('inf')\n\n    return zero_count / non_zero_count"}
