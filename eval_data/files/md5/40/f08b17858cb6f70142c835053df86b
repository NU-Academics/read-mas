{"task_id": "245", "solution": "def max_bitonic_subsequence(arr: list[int]) -> int:\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    inc = [0] * n\n    for i in range(n):\n        inc[i] = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                val = inc[j] + arr[i]\n                if val > inc[i]:\n                    inc[i] = val\n\n    dec = [0] * n\n    for i in range(n - 1, -1, -1):\n        dec[i] = arr[i]\n        for j in range(i + 1, n):\n            if arr[j] < arr[i]:\n                val = dec[j] + arr[i]\n                if val > dec[i]:\n                    dec[i] = val\n\n    max_sum = 0\n    for i in range(n):\n        cur = inc[i] + dec[i] - arr[i]\n        if cur > max_sum:\n            max_sum = cur\n    return max_sum"}
{"task_id": "246", "solution": "def sqrt_babylonian(n: float) -> float:\n    \"\"\"\n    Compute the square root of a non\u2011negative number using the Babylonian method.\n\n    Parameters:\n        n (float): Non\u2011negative number to square\u2011root.\n\n    Returns:\n        float: Approximate square root of n.\n\n    Raises:\n        ValueError: If n is negative.\n    \"\"\"\n    if n < 0.0:\n        raise ValueError(\"sqrt_babylonian: negative input\")\n    if n == 0.0 or n == 1.0:\n        return n\n\n    epsilon: float = 1e-10\n    max_iterations: int = 1000\n\n    x: float = n / 2.0 if n >= 1.0 else 1.0\n\n    for _ in range(max_iterations):\n        x_next: float = (x + n / x) / 2.0\n        if abs(x_next - x) < epsilon:\n            return x_next\n        x = x_next\n\n    return x"}
{"task_id": "247", "solution": "def longest_palindromic_subsequence(s: str) -> int:\n    \"\"\"Return the length of the longest palindromic subsequence in string s.\"\"\"\n    n: int = len(s)\n    if n == 0:\n        return 0\n\n    dp: list[list[int]] = [[0] * n for _ in range(n)]\n\n    # Base case: single characters\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Build table for substrings of length >= 2\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j: int = i + length - 1\n            if s[i] == s[j]:\n                dp[i][j] = 2 if length == 2 else dp[i + 1][j - 1] + 2\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "248", "solution": "def harmonic_sum(n: int) -> float:\n    \"\"\"\n    Calculates the harmonic sum of n-1.\n\n    The harmonic sum H_m is defined as the sum of reciprocals of the first m positive integers:\n        H_m = 1 + 1/2 + 1/3 + ... + 1/m\n\n    Parameters\n    ----------\n    n : int\n        The integer whose harmonic sum of n-1 is desired. Must be >= 1.\n\n    Returns\n    -------\n    float\n        The harmonic sum H_{n-1}. For n == 1 the result is 0.0.\n\n    Raises\n    ------\n    ValueError\n        If n < 1.\n\n    Examples\n    --------\n    >>> harmonic_sum(5)\n    2.0833333333333335   # H_4 = 1 + 1/2 + 1/3 + 1/4\n\n    >>> harmonic_sum(1)\n    0.0\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    if n == 1:\n        return 0.0\n    total: float = 0.0\n    for k in range(1, n):\n        total += 1.0 / k\n    return total"}
