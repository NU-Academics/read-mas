{"task_id": "108", "solution": "def merge_three_lists(a: list[int], b: list[int], c: list[int]) -> list[int]:\n    \"\"\"Merge three lists into a single sorted list.\n\n    Parameters\n    ----------\n    a, b, c : list\n        Input lists containing comparable elements (int, float, or str).\n\n    Returns\n    -------\n    list\n        A new list containing all elements from the input lists sorted in non\u2011decreasing order.\n\n    Raises\n    ------\n    TypeError\n        If any argument is not a list, or if any element is not a comparable type, or if\n        lists contain incompatible types (e.g., mixing strings with numbers).\n    \"\"\"\n    # Validate that each argument is a list\n    for name, lst in ((\"a\", a), (\"b\", b), (\"c\", c)):\n        if not isinstance(lst, list):\n            raise TypeError(f\"Argument '{name}' must be a list, got {type(lst).__name__}\")\n\n    # Validate elements and collect types\n    element_types = set()\n    for name, lst in ((\"a\", a), (\"b\", b), (\"c\", c)):\n        for idx, item in enumerate(lst):\n            if not isinstance(item, (int, float, str)):\n                raise TypeError(\n                    f\"List '{name}' contains non-comparable element \"\n                    f\"{item!r} of type {type(item).__name__}\"\n                )\n            element_types.add(type(item))\n\n    # Ensure types are compatible: allow mixing int/float, but not with str\n    if len(element_types) > 1:\n        if str in element_types:\n            raise TypeError(\"Lists contain incompatible types (mixing strings with numbers)\")\n        # Mixed int and float is allowed; no further action needed\n\n    # Concatenate and sort\n    combined = a + b + c\n    return sorted(combined)"}
{"task_id": "109", "solution": "def count_odd_rotations(s: str) -> int:\n    \"\"\"Count the number of rotations of a binary string that evaluate to an odd integer.\n\n    An odd integer in binary has LSB == '1'. Each '1' in the original string\n    will appear as the LSB in exactly one rotation, so the answer is simply\n    the count of '1's.\n\n    Parameters\n    ----------\n    s : str\n        Binary string consisting only of characters '0' and '1'.\n\n    Returns\n    -------\n    int\n        Number of rotations that represent an odd integer.\n\n    Raises\n    ------\n    ValueError\n        If s is empty or contains any character other than '0' or '1'.\n    \"\"\"\n    if not s:\n        raise ValueError(\"Input string cannot be empty\")\n    count = 0\n    for c in s:\n        if c not in ('0', '1'):\n            raise ValueError(\"Input string must contain only '0' or '1'\")\n        if c == '1':\n            count += 1\n    return count"}
{"task_id": "111", "solution": "def common_elements(lists: list[list[object]]) -> list[object]:\n    \"\"\"Return the list of elements that are present in every sub\u2011list of ``lists``.\n    Elements are returned in the order they first appear in the first sub\u2011list.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    if not lists:\n        raise ValueError(\"Input must contain non\u2011empty sub\u2011lists.\")\n    # Validate sub\u2011lists\n    for sub in lists:\n        if not isinstance(sub, list):\n            raise TypeError(\"All elements of input must be lists.\")\n        if not sub:\n            raise ValueError(\"Input must contain non\u2011empty sub\u2011lists.\")\n    # Initialize the intersection set with the first sub\u2011list\n    common_set = set(lists[0])\n    # Intersect with subsequent sub\u2011lists\n    for sub in lists[1:]:\n        common_set.intersection_update(sub)\n        if not common_set:\n            return []  # Early exit if intersection becomes empty\n    # Preserve order from the first sub\u2011list and ensure uniqueness\n    result = []\n    seen = set()\n    for item in lists[0]:\n        if item in common_set and item not in seen:\n            result.append(item)\n            seen.add(item)\n    return result"}
{"task_id": "113", "solution": "def is_valid_integer(s: str) -> bool:\n    \"\"\"Return True if s is a valid integer string according to the spec.\"\"\"\n    trimmed = s.strip()\n    if not trimmed:\n        return False\n    if trimmed[0] in '+-':\n        trimmed = trimmed[1:]\n    if not trimmed:\n        return False\n    return trimmed.isdigit()"}
{"task_id": "115", "solution": "def are_all_dicts_empty(dict_list: list[dict]) -> bool:\n    \"\"\"Check whether all dictionaries in the provided list are empty.\n\n    Parameters\n    ----------\n    dict_list : list[dict]\n        List containing zero or more dictionary objects.\n\n    Returns\n    -------\n    bool\n        True if every dictionary in dict_list is empty; False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If dict_list is not a list or if any element in dict_list is not a dict.\n    \"\"\"\n    if not isinstance(dict_list, list):\n        raise TypeError(\"dict_list must be a list\")\n    for d in dict_list:\n        if not isinstance(d, dict):\n            raise TypeError(\"All elements in dict_list must be dictionaries\")\n        if d:  # non-empty dictionary evaluates to True\n            return False\n    return True"}
{"task_id": "116", "solution": "def concat_positive_integers(nums: tuple[int, ...]) -> int:\n    \"\"\"\n    Concatenates a tuple of positive integers into a single integer.\n\n    Parameters\n    ----------\n    nums : tuple[int, ...]\n        Tuple containing zero or more positive integers.\n\n    Returns\n    -------\n    int\n        The concatenated integer, or 0 if the tuple is empty.\n\n    Raises\n    ------\n    TypeError\n        If nums is not a tuple or any element is not an int.\n    ValueError\n        If any element is not a positive integer.\n    \"\"\"\n    if not isinstance(nums, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    if not nums:\n        return 0\n\n    for idx, val in enumerate(nums):\n        if not isinstance(val, int):\n            raise TypeError(f\"Element at index {idx} is not an int\")\n        if val <= 0:\n            raise ValueError(f\"Element at index {idx} is not positive\")\n\n    result_str = ''.join(str(val) for val in nums)\n    return int(result_str)"}
{"task_id": "117", "solution": "def convert_all_to_floats(\n    data: list[list[object]]\n) -> list[list[object]]:\n    \"\"\"\n    Convert each element that can be cast to float in a nested list structure.\n\n    Parameters\n    ----------\n    data : list[list[object]]\n        A list of lists containing arbitrary elements. The function treats\n        each element independently.\n\n    Returns\n    -------\n    list[list[object]]\n        A new list of lists with the same shape as *data*. Elements that\n        successfully cast to float are replaced with their float value;\n        elements that raise ValueError or TypeError remain unchanged.\n\n    Notes\n    -----\n    - The original *data* is not modified.\n    - Conversion failures are handled silently; no exception is propagated.\n    - This function is pure: repeated calls with the same *data* yield\n      identical results.\n    \"\"\"\n    result: list[list[object]] = []\n\n    for row in data:\n        new_row: list[object] = []\n        for item in row:\n            try:\n                new_row.append(float(item))\n            except (ValueError, TypeError):\n                new_row.append(item)\n        result.append(new_row)\n\n    return result"}
{"task_id": "118", "solution": "def split_string_to_list(input_str: str) -> list[str]:\n    \"\"\"Return a list of substrings split on the space character.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to be split. Must be a valid Python string.\n\n    Returns\n    -------\n    list[str]\n        A list of non\u2011empty substrings extracted from `input_str`.\n\n    Raises\n    ------\n    TypeError\n        If `input_str` is not of type `str`.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(f\"input_str must be a string, got type {type(input_str).__name__}\")\n    raw_tokens = input_str.split(' ')\n    return [token for token in raw_tokens if token]"}
{"task_id": "119", "solution": "def find_single(arr: list[int]) -> int:\n    \"\"\"\n    Find the element that appears only once in a sorted array where all\n    other elements appear exactly twice.\n\n    Parameters\n    ----------\n    arr : list[int]\n        A sorted list of integers. Must contain exactly one element\n        that occurs once; all other elements occur twice.\n\n    Returns\n    -------\n    int\n        The unique element.\n\n    Raises\n    ------\n    ValueError\n        If arr is empty or the pre\u2011conditions are not met.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array must not be empty\")\n\n    n = len(arr)\n    if n % 2 == 0:\n        raise ValueError(\"Array length must be odd (exactly one unique element)\")\n\n    low, high = 0, n - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        if mid % 2 == 1:\n            mid -= 1  # make mid even\n\n        if arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        else:\n            high = mid\n\n    return arr[low]"}
{"task_id": "120", "solution": "def max_abs_product(tuples: list[tuple[float, float]]) -> float:\n    \"\"\"Compute the maximum absolute product achievable by selecting one element\n    from each of two distinct tuples in the input list.\n\n    Parameters\n    ----------\n    tuples : list[tuple[float, float]]\n        A list where each element is a 2\u2011tuple containing numeric values.\n\n    Returns\n    -------\n    float\n        The largest absolute product of any two numbers chosen from two distinct tuples.\n        If the input contains fewer than two tuples, returns 0.\n\n    Raises\n    ------\n    ValueError\n        If the input is not a list of 2\u2011tuples of numeric types.\n    \"\"\"\n    if not isinstance(tuples, list):\n        raise ValueError(\"Input must be a list.\")\n    for idx, t in enumerate(tuples):\n        if not isinstance(t, tuple) or len(t) != 2:\n            raise ValueError(f\"Element at index {idx} is not a 2\u2011tuple.\")\n        for val in t:\n            if not isinstance(val, (int, float)):\n                raise ValueError(f\"Element {val} in tuple at index {idx} is not numeric.\")\n\n    if len(tuples) < 2:\n        return 0.0\n\n    max_prod = 0.0\n    n = len(tuples)\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            a1, a2 = tuples[i]\n            b1, b2 = tuples[j]\n            prod = abs(a1 * b1)\n            if prod > max_prod:\n                max_prod = prod\n            prod = abs(a1 * b2)\n            if prod > max_prod:\n                max_prod = prod\n            prod = abs(a2 * b1)\n            if prod > max_prod:\n                max_prod = prod\n            prod = abs(a2 * b2)\n            if prod > max_prod:\n                max_prod = prod\n\n    return max_prod"}
{"task_id": "123", "solution": "def validate_input(limit):\n    if not isinstance(limit, int) or limit <= 0:\n        raise ValueError(\"limit must be a positive integer\")\n\ndef compute_divisor_sums(limit):\n    div_sum = [0] * (limit + 1)\n    upper = limit // 2\n    for i in range(1, upper + 1):\n        step = i\n        start = i * 2\n        for j in range(start, limit + 1, step):\n            div_sum[j] += i\n    return div_sum\n\ndef find_amicable_numbers(limit, divisor_sums):\n    amicable_set = set()\n    for a in range(2, limit + 1):\n        b = divisor_sums[a]\n        if b > a and b <= limit and divisor_sums[b] == a:\n            amicable_set.add(a)\n            amicable_set.add(b)\n    return list(amicable_set)\n\ndef sum_amicable_numbers(limit):\n    \"\"\"\n    Return the sum of all amicable numbers <= limit.\n\n    Parameters\n    ----------\n    limit : int\n        Upper bound for amicable number search. Must be > 0.\n\n    Returns\n    -------\n    int\n        Sum of distinct amicable numbers within the bound.\n\n    Raises\n    ------\n    ValueError\n        If limit is not a positive integer.\n    \"\"\"\n    validate_input(limit)\n    divisor_sums = compute_divisor_sums(limit)\n    amicable_numbers = find_amicable_numbers(limit, divisor_sums)\n    return sum(amicable_numbers)"}
{"task_id": "124", "solution": "PI = 3.141592653589793\nPI_HALF = 1.5707963267948966  # PI / 2\n\ndef atan_approx(t: float) -> float:\n    \"\"\"Approximate arctangent of t for |t| <= 1 using a 13-term Taylor series.\"\"\"\n    result = 0.0\n    t_power = t  # t^(2n+1)\n    sign = 1.0\n    for n in range(13):  # 0 .. 12\n        term = sign * t_power / (2 * n + 1)\n        result += term\n        sign = -sign\n        t_power *= t * t  # increase exponent by 2\n    return result\n\ndef complex_angle(z: complex) -> float:\n    \"\"\"Compute the polar angle (in radians) of a complex number z.\n    The result is in the range -\u03c0 < \u03b8 <= \u03c0.\"\"\"\n    x = z.real\n    y = z.imag\n\n    if x == 0.0:\n        if y > 0.0:\n            return PI_HALF\n        if y < 0.0:\n            return -PI_HALF\n        return 0.0  # z == 0\n\n    t = y / x\n    if abs(t) <= 1.0:\n        atan_t = atan_approx(t)\n    else:\n        atan_t = PI_HALF - atan_approx(1.0 / t)\n\n    if x > 0.0:\n        theta = atan_t\n    else:  # x < 0.0\n        if y >= 0.0:\n            theta = atan_t + PI\n        else:\n            theta = atan_t - PI\n\n    return theta"}
{"task_id": "125", "solution": "def max_diff_binary_substring(s: str) -> int:\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string\")\n    if len(s) == 0:\n        return 0\n    max_ending_here = 0\n    max_so_far = 0\n    for i, c in enumerate(s):\n        if c == '0':\n            value = 1\n        elif c == '1':\n            value = -1\n        else:\n            raise ValueError(f\"Invalid character '{c}' at position {i}. Expected '0' or '1'.\")\n        max_ending_here = max(0, max_ending_here + value)\n        if max_ending_here > max_so_far:\n            max_so_far = max_ending_here\n    return max_so_far"}
{"task_id": "126", "solution": "def gcd(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of a and b.\"\"\"\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef get_divisors(n: int) -> list[int]:\n    \"\"\"Return a list of all positive divisors of n.\"\"\"\n    if n == 0:\n        return []\n    n = abs(n)\n    divisors: list[int] = []\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            divisors.append(i)\n            if i != n // i:\n                divisors.append(n // i)\n        i += 1\n    return divisors\n\ndef sum_common_divisors(a: int, b: int) -> int:\n    \"\"\"\n    Return the sum of all positive integers that divide both a and b.\n\n    Parameters:\n        a (int): First integer.\n        b (int): Second integer.\n\n    Returns:\n        int: Sum of common divisors of a and b.\n\n    Raises:\n        ValueError: If either argument is not an integer.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Both arguments must be integers.\")\n    if a == 0 or b == 0:\n        return 0\n    g = gcd(a, b)\n    if g == 1:\n        return 1\n    divisors = get_divisors(g)\n    return sum(divisors)"}
