{"task_id": "441", "solution": "def cube_surface_area(side_length: float) -> float:\n    \"\"\"\n    Calculate the surface area of a cube given the side length.\n\n    Parameters\n    ----------\n    side_length : float\n        Length of one side of the cube. Must be a non\u2011negative real number.\n\n    Returns\n    -------\n    float\n        The surface area of the cube calculated as 6 * side_length ** 2.\n\n    Raises\n    ------\n    TypeError\n        If side_length is not an int or float.\n    ValueError\n        If side_length is negative.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise TypeError(\"side_length must be a number (int or float).\")\n    if side_length < 0:\n        raise ValueError(\"side_length must be non\u2011negative.\")\n    return 6 * side_length ** 2"}
{"task_id": "442", "solution": "def compute_positive_ratio(nums: list[int]) -> float:\n    \"\"\"Calculate the ratio of positive integers in the provided list.\n\n    Parameters\n    ----------\n    nums : list[int]\n        A list of integers to analyze.\n\n    Returns\n    -------\n    float\n        The ratio of positive numbers to the total count of elements.\n        Returns 0.0 if the input list is empty.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list of integers.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers\")\n\n    total = len(nums)\n    if total == 0:\n        return 0.0\n\n    positive_count = 0\n    for value in nums:\n        if not isinstance(value, int):\n            raise TypeError(\"All elements must be integers\")\n        if value > 0:\n            positive_count += 1\n\n    return positive_count / total"}
{"task_id": "443", "solution": "def find_largest_negative(values: list[float]) -> float | None:\n    \"\"\"\n    Return the largest negative number from a list of numbers.\n\n    The function iterates over the provided list `values`, ignoring\n    non\u2011numeric elements and handling empty or non\u2011list inputs\n    gracefully by returning None.\n\n    Parameters\n    ----------\n    values : list[float]\n        A list that may contain integers or floats.\n\n    Returns\n    -------\n    float | None\n        The largest negative number found in `values`, or None if\n        the list is empty, contains no negatives, or is invalid.\n    \"\"\"\n    if not isinstance(values, list):\n        return None\n\n    largest_negative: float | None = None\n\n    for item in values:\n        if not isinstance(item, (int, float)):\n            continue\n\n        if item < 0:\n            if largest_negative is None or item > largest_negative:\n                largest_negative = item\n\n    return largest_negative"}
{"task_id": "444", "solution": "def trim_tuples(tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    if not isinstance(tuples, list):\n        raise TypeError(\"tuples must be a list of tuples\")\n    for t in tuples:\n        if not isinstance(t, tuple):\n            raise TypeError(\"each element of tuples must be a tuple\")\n        for item in t:\n            if not isinstance(item, int):\n                raise TypeError(\"tuple elements must be integers\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k < 0:\n        raise ValueError(\"k must be non\u2011negative\")\n\n    result: list[tuple[int, ...]] = []\n    for t in tuples:\n        if len(t) <= k:\n            result.append(())\n        else:\n            result.append(t[:len(t) - k])\n    return result"}
{"task_id": "445", "solution": "def multiply_tuples(a: tuple[float, ...], b: tuple[float, ...]) -> tuple[float, ...]:\n    \"\"\"Return a tuple containing the element\u2011wise product of two input tuples.\n\n    Parameters\n    ----------\n    a : tuple[float, ...]\n        First tuple of numeric values.\n    b : tuple[float, ...]\n        Second tuple of numeric values.\n\n    Returns\n    -------\n    tuple[float, ...]\n        A new tuple with each element equal to a[i] * b[i].\n\n    Raises\n    ------\n    TypeError\n        If the arguments are not tuples or contain non\u2011numeric elements.\n    ValueError\n        If the tuples have different lengths.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"First and second arguments must be tuples.\")\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n    result_list = []\n    for x, y in zip(a, b):\n        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):\n            raise TypeError(\"All tuple elements must be int or float.\")\n        result_list.append(x * y)\n    return tuple(result_list)"}
{"task_id": "446", "solution": "from collections import Counter\n\ndef count_occurrences(elements: list[object], items: tuple[object]) -> dict[object, int]:\n    \"\"\"Return a dictionary mapping each element from `elements` to the number of times it appears in `items`.\n\n    Parameters\n    ----------\n    elements : list[object]\n        List of items to count. Elements may be any hashable type.\n    items : tuple[object]\n        Tuple containing the data in which to count occurrences. Elements may be any hashable type.\n\n    Returns\n    -------\n    dict[object, int]\n        Dictionary where each key is an element from `elements` and its value is the count of that element within `items`.\n    \"\"\"\n    tuple_counter = Counter(items)\n    result = {e: tuple_counter.get(e, 0) for e in elements}\n    return result"}
{"task_id": "447", "solution": "def cube_elements(numbers: list[float]) -> list[float]:\n    if not isinstance(numbers, list):\n        raise TypeError(\"cube_elements expects a list of numbers.\")\n    if not numbers:\n        raise ValueError(\"cube_elements requires a non-empty list.\")\n    result = []\n    for idx, value in enumerate(numbers):\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Element at index {idx} is not a numeric type.\")\n        result.append(value ** 3)\n    return result"}
{"task_id": "448", "solution": "def sum_perrin_numbers(n: int) -> int:\n    \"\"\"Compute the sum of Perrin numbers from P(0) up to P(n).\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer indicating the highest index of the Perrin sequence to include in the sum.\n\n    Returns\n    -------\n    int\n        Integer sum of P(0) + P(1) + \u2026 + P(n).\n\n    Raises\n    ------\n    TypeError\n        If n is not an instance of int.\n    ValueError\n        If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    if n == 0:\n        return 3\n    if n == 1:\n        return 3 + 0\n    if n == 2:\n        return 3 + 0 + 2\n\n    prev3 = 3   # P(0)\n    prev2 = 0   # P(1)\n    prev1 = 2   # P(2)\n    sum_val = prev3 + prev2 + prev1\n\n    for _ in range(3, n + 1):\n        current = prev3 + prev2  # P(k) = P(k-2) + P(k-3)\n        sum_val += current\n        prev3, prev2, prev1 = prev2, prev1, current\n\n    return sum_val"}
{"task_id": "450", "solution": "# extraction.py\ndef extract_by_length(strings: list[str], length: int) -> list[str]:\n    \"\"\"\n    Return a list of strings from *strings* whose length equals *length*.\n\n    Parameters\n    ----------\n    strings : list[str]\n        A list containing string elements to be examined.\n    length : int\n        The target string length. Must be non\u2011negative.\n\n    Returns\n    -------\n    list[str]\n        A new list with all strings from *strings* that have length *length*.\n        The order of elements is preserved.\n\n    Raises\n    ------\n    ValueError\n        If *strings* contains non\u2011string elements, or if *length* is negative.\n    \"\"\"\n    _validate_input(strings, length)\n    return [s for s in strings if len(s) == length]\n\n\n# _validation.py\ndef _validate_input(strings: list[str], length: int) -> None:\n    \"\"\"\n    Validate inputs for extract_by_length.\n\n    Raises\n    ------\n    ValueError\n        If *strings* contains non\u2011string elements or if *length* is negative.\n    \"\"\"\n    if not isinstance(length, int) or length < 0:\n        raise ValueError(f\"length must be a non\u2011negative integer, got {length!r}\")\n    for idx, item in enumerate(strings):\n        if not isinstance(item, str):\n            raise ValueError(f\"element at index {idx} is not a string: {item!r}\")\n\n\n# __init__.py\nfrom .extraction import extract_by_length"}
{"task_id": "451", "solution": "```python\n# remove_whitespace/__init__.py\n__all__ = ['remove_whitespace']\nfrom .core import remove_whitespace\n\n\n# remove_whitespace/core.py\nUSE_REGEX = False\n\n\ndef _filter_iterative(s: str) -> str:\n    result_chars: list[str] = []\n    for ch in s:\n        if not ch.isspace():\n            result_chars.append(ch)\n    return \"\".join(result_chars)\n\n\ndef _filter_regex(s: str) -> str:\n    import re\n    _WHITESPACE_RE = re.compile(r\"\\s+\")\n    return _WHITESPACE_RE.sub(\"\", s)\n\n\ndef remove_whitespace(s: str) -> str:\n    \"\"\"\n    Return a new string with all whitespace characters removed.\n\n    Parameters\n    ----------\n    s : str\n        Input string (may be empty).\n\n    Returns\n    -------\n    str\n        String with all whitespace characters removed, preserving the\n        order of non-whitespace characters.\n    \"\"\"\n    if USE_REGEX:\n        return _filter_regex(s)\n    else:\n        return _filter_iterative(s)\n```"}
{"task_id": "452", "solution": "def calculate_loss(sale_price: float, cost_price: float) -> float:\n    \"\"\"Calculates the loss amount on a sale.\n\n    Parameters\n    ----------\n    sale_price : float\n        The price at which the item was sold.\n    cost_price : float\n        The original cost of the item.\n\n    Returns\n    -------\n    float\n        The loss amount if sale_price < cost_price, otherwise 0.0.\n    \"\"\"\n    if sale_price < cost_price:\n        return cost_price - sale_price\n    return 0.0"}
