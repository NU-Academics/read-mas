{"task_id": "457", "solution": "def find_min_length_sublist(input_list: list[list[object]]) -> list[object]:\n    \"\"\"\n    Return the sublist with the minimal length from a list of sublists.\n    Handles invalid input gracefully by returning None.\n    \"\"\"\n    if not isinstance(input_list, list):\n        return None\n\n    min_sublist = None\n    min_length = float(\"inf\")\n\n    for candidate in input_list:\n        if not isinstance(candidate, list):\n            continue\n        length = len(candidate)\n        if length < min_length:\n            min_length = length\n            min_sublist = candidate\n\n    return min_sublist if min_sublist is not None else None"}
{"task_id": "458", "solution": "```python\n\"\"\"\nrectangle_area.py\n\nProvides a single function to calculate the area of a rectangle.\n\"\"\"\n\ndef rectangle_area(length: float, width: float) -> float:\n    \"\"\"\n    Calculate the area of a rectangle.\n\n    Parameters\n    ----------\n    length : float\n        The length of the rectangle. Must be non\u2011negative.\n    width : float\n        The width of the rectangle. Must be non\u2011negative.\n\n    Returns\n    -------\n    float\n        The area of the rectangle.\n\n    Raises\n    ------\n    TypeError\n        If either `length` or `width` is not an int or float.\n    ValueError\n        If either `length` or `width` is negative.\n    \"\"\"\n    # Type checking\n    if not isinstance(length, (int, float)):\n        raise TypeError(\"length must be a number\")\n    if not isinstance(width, (int, float)):\n        raise TypeError(\"width must be a number\")\n\n    # Value checking\n    if length < 0:\n        raise ValueError(\"length must be non\u2011negative\")\n    if width < 0:\n        raise ValueError(\"width must be non\u2011negative\")\n\n    return float(length * width)\n```"}
{"task_id": "459", "solution": "def remove_uppercase_sequences(input_str: str) -> str:\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string\")\n    result = []\n    in_upper_seq = False\n    for char in input_str:\n        if 'A' <= char <= 'Z':\n            if not in_upper_seq:\n                in_upper_seq = True\n            # skip appending uppercase character\n        else:\n            in_upper_seq = False\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "460", "solution": "def get_first_elements(data: list[list[object]]) -> list[object]:\n    if not isinstance(data, list):\n        raise TypeError(\"data must be a list\")\n    result: list[object] = []\n    for i, sublist in enumerate(data):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} is not a list\")\n        if not sublist:\n            raise ValueError(f\"Sublist at index {i} is empty\")\n        result.append(sublist[0])\n    return result"}
{"task_id": "461", "solution": "def count_uppercase(s: str) -> int:\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    count = 0\n    for c in s:\n        if c.isupper():\n            count += 1\n    return count"}
{"task_id": "462", "solution": "def powerset(input_list: list[object]) -> list[list[object]]:\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be of type list\")\n    n = len(input_list)\n    if n == 0:\n        return [[]]\n    result = []\n    for mask in range(1 << n):\n        subset = [input_list[i] for i in range(n) if mask & (1 << i)]\n        result.append(subset)\n    return result"}
{"task_id": "463", "solution": "def max_product_subarray(nums: list[int]) -> int:\n    \"\"\"Return the maximum product of any contiguous sub\u2011array within the given non\u2011empty list of integers.\n\n    Parameters\n    ----------\n    nums : list[int]\n        Non\u2011empty list of integers.\n\n    Returns\n    -------\n    int\n        The maximum product achievable by any contiguous sub\u2011array of `nums`.\n\n    Raises\n    ------\n    TypeError\n        If `nums` is not a list or contains non\u2011integer elements.\n    ValueError\n        If `nums` is empty.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n    if not nums:\n        raise ValueError(\"Input list must contain at least one element.\")\n    if any(not isinstance(x, int) for x in nums):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    max_prod = min_prod = result = nums[0]\n\n    for num in nums[1:]:\n        if num < 0:\n            max_prod, min_prod = min_prod, max_prod\n\n        max_prod = max(num, max_prod * num)\n        min_prod = min(num, min_prod * num)\n\n        result = max(result, max_prod)\n\n    return result"}
{"task_id": "464", "solution": "def all_values_same(d: dict[str, object]) -> bool:\n    \"\"\"\n    Determine whether all values in the dictionary `d` are identical.\n\n    Parameters\n    ----------\n    d : dict[str, object]\n        The dictionary to inspect.\n\n    Returns\n    -------\n    bool\n        True if all values are equal (or the dictionary is empty), False otherwise.\n    \"\"\"\n    if not d:\n        return True\n    unique_vals = set(d.values())\n    return len(unique_vals) <= 1"}
{"task_id": "465", "solution": "def is_empty(value: object) -> bool:\n    \"\"\"Determine whether a value is considered empty.\n\n    Empty values are:\n        - None\n        - Empty string ''\n        - Empty list, tuple, set, or dict\n    \"\"\"\n    if value is None:\n        return True\n    if isinstance(value, str) and value == \"\":\n        return True\n    if isinstance(value, (list, tuple, set, dict)) and len(value) == 0:\n        return True\n    return False\n\n\ndef drop_empty_items(data: dict[str, object]) -> dict[str, object]:\n    \"\"\"Return a new dictionary with entries that have empty values removed.\n\n    Parameters\n    ----------\n    data : dict[str, object]\n        Input dictionary.\n\n    Returns\n    -------\n    dict[str, object]\n        New dictionary without empty entries.\n    \"\"\"\n    return {k: v for k, v in data.items() if not is_empty(v)}"}
{"task_id": "468", "solution": "def max_product_increasing_subsequence(arr: list[int]) -> int:\n    if not arr:\n        return 0\n    n = len(arr)\n    max_end = [0] * n\n    min_end = [0] * n\n    for i in range(n):\n        max_prod = arr[i]\n        min_prod = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                candidate_max = arr[i] * max_end[j]\n                candidate_min = arr[i] * min_end[j]\n                if candidate_max > max_prod:\n                    max_prod = candidate_max\n                if candidate_min < min_prod:\n                    min_prod = candidate_min\n        max_end[i] = max_prod\n        min_end[i] = min_prod\n    return max(max_end)"}
{"task_id": "470", "solution": "def pairwise_add(t: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    for idx, val in enumerate(t):\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"Element at index {idx} is not numeric: {val!r}\")\n    if len(t) < 2:\n        return ()\n    result: list[float | int] = []\n    for i in range(len(t) - 1):\n        result.append(t[i] + t[i + 1])\n    return tuple(result)"}
{"task_id": "471", "solution": "def product_modulo(arr: list[int], n: int) -> int:\n    \"\"\"\n    Compute the product of all integers in arr modulo n.\n\n    Parameters\n    ----------\n    arr : list[int]\n        List of integers to multiply.\n    n : int\n        Modulus value; must be positive.\n\n    Returns\n    -------\n    int\n        Result of (\u220f arr) mod n, or 0 if arr is empty.\n\n    Raises\n    ------\n    ValueError\n        If n <= 0.\n        If arr contains non\u2011int elements or n is not an int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"All inputs must be integers.\")\n    if n <= 0:\n        raise ValueError(\"Modulus must be a positive integer.\")\n\n    if not isinstance(arr, list):\n        raise ValueError(\"Array input must be a list of integers.\")\n    for element in arr:\n        if not isinstance(element, int):\n            raise ValueError(\"All inputs must be integers.\")\n\n    if not arr:\n        return 0\n\n    product = 1\n    for value in arr:\n        product = (product * value) % n\n    return product"}
{"task_id": "472", "solution": "def are_consecutive(nums: list[int]) -> bool:\n    \"\"\"\n    Determine if all integers in nums are consecutive in ascending order.\n\n    Parameters:\n        nums (list[int]): List of integers to check.\n\n    Returns:\n        bool: True if nums contains a consecutive sequence, False otherwise.\n    \"\"\"\n    if not nums:\n        return False\n    if len(nums) == 1:\n        return True\n    sorted_nums = sorted(nums)\n    for i in range(len(sorted_nums) - 1):\n        if sorted_nums[i + 1] - sorted_nums[i] != 1:\n            return False\n    return True"}
{"task_id": "473", "solution": "def tuple_intersection(tuples: list[tuple[object, ...]]) -> tuple[object, ...]:\n    if not tuples:\n        return ()\n    first = tuples[0]\n    if not first:\n        return ()\n    intersection_set = set(first)\n    for t in tuples[1:]:\n        intersection_set.intersection_update(t)\n        if not intersection_set:\n            return ()\n    return tuple(e for e in first if e in intersection_set)"}
{"task_id": "474", "solution": "def replace_chars(\n    original: str,\n    target: str,\n    replacement: str,\n    count: int | None = None\n) -> str:\n    \"\"\"Replace occurrences of a target character with a replacement character in a string.\n\n    Args:\n        original: The source string.\n        target: The character to be replaced. Must be a single non\u2011empty character.\n        replacement: The replacement character. Must be a single non\u2011empty character.\n        count: Optional maximum number of replacements. If None, all occurrences are replaced.\n\n    Returns:\n        A new string with the specified replacements applied.\n\n    Raises:\n        ValueError: If target or replacement is not a single character,\n                    or if count is provided and is not a positive integer.\n    \"\"\"\n    # Validate target and replacement\n    if len(target) != 1 or len(replacement) != 1:\n        raise ValueError(\"Target and replacement must be single characters.\")\n\n    # Validate count\n    if count is not None:\n        if not isinstance(count, int) or count <= 0:\n            raise ValueError(\"Count must be a positive integer or None.\")\n\n    # Perform replacement\n    if count is None:\n        return original.replace(target, replacement)\n    return original.replace(target, replacement, count)"}
{"task_id": "475", "solution": "def sort_dict_by_value(d: dict[str, int | float], descending: bool = False) -> list[tuple[str, int | float]]:\n    \"\"\"\n    Return a list of (key, value) tuples sorted by value.\n\n    Parameters\n    ----------\n    d : dict[str, int | float]\n        Dictionary to sort. Keys must be strings; values must be int or float.\n    descending : bool, optional\n        If True, sort from highest to lowest value. Default is False.\n\n    Returns\n    -------\n    list[tuple[str, int | float]]\n        List of key\u2011value pairs sorted by value (ascending by default).\n\n    Raises\n    ------\n    TypeError\n        If input is not a dictionary or values are not numeric.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    try:\n        sorted_items = sorted(\n            d.items(),\n            key=lambda item: (item[1], item[0]),\n            reverse=descending\n        )\n    except TypeError as exc:\n        raise TypeError(\"Dictionary values must be int or float.\") from exc\n\n    return sorted_items"}
{"task_id": "476", "solution": "def sum_largest_and_smallest(values: list[float]) -> float:\n    \"\"\"Compute the sum of the largest and smallest numeric values in a list.\n\n    Parameters\n    ----------\n    values : list[float]\n        A non\u2011empty list of numeric values (int or float). The list may contain duplicates.\n        The input list is not modified.\n\n    Returns\n    -------\n    float\n        The sum of the maximum and minimum elements of the list.\n\n    Raises\n    ------\n    TypeError\n        If ``values`` is not a list.\n        If any element in ``values`` is not an int or float.\n\n    ValueError\n        If ``values`` is an empty list.\n\n    Examples\n    --------\n    >>> sum_largest_and_smallest([1, 3, 2])\n    4.0\n    >>> sum_largest_and_smallest([0, -5, 2.5])\n    -2.5\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(\"Input must be a list of numeric values.\")\n    if not values:\n        raise ValueError(\"Input list must contain at least one element.\")\n\n    first = values[0]\n    if not isinstance(first, (int, float)):\n        raise TypeError(f\"Element at index 0 is not numeric: {first!r}\")\n\n    max_val = min_val = first\n    for idx, val in enumerate(values[1:], start=1):\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"Element at index {idx} is not numeric: {val!r}\")\n        if val > max_val:\n            max_val = val\n        if val < min_val:\n            min_val = val\n\n    return float(max_val + min_val)"}
{"task_id": "477", "solution": "def to_lowercase(value: str) -> str:\n    if not isinstance(value, str):\n        raise TypeError(f\"Expected a string but received {type(value)}.\")\n    return value.lower()"}
{"task_id": "478", "solution": "def remove_lowercase_substrings(s: str) -> str:\n    result_parts: list[str] = []\n    i: int = 0\n    n: int = len(s)\n    while i < n:\n        ch = s[i]\n        if 'a' <= ch <= 'z':\n            while i < n and 'a' <= s[i] <= 'z':\n                i += 1\n        else:\n            result_parts.append(ch)\n            i += 1\n    return \"\".join(result_parts)"}
{"task_id": "479", "solution": "def get_first_digit(number: float) -> int:\n    \"\"\"Return the first decimal digit of the given number.\n\n    Parameters\n    ----------\n    number : float\n        The numeric value to process. Integers are accepted via implicit conversion.\n\n    Returns\n    -------\n    int\n        The first digit (0\u20139) of the absolute value's decimal representation.\n\n    Raises\n    ------\n    TypeError\n        If the input is not an int or float.\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be an int or float.\")\n    value = abs(number)\n    s = str(value)\n    for c in s:\n        if c.isdigit():\n            return int(c)\n    return 0"}
