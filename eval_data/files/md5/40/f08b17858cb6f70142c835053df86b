{"task_id": "392", "solution": "_memo: dict[int, int] = {0: 0}\n\ndef max_revenue(n: int) -> int:\n    \"\"\"\n    Compute f(n) = max(f(n//2)+f(n//3)+f(n//4)+f(n//5), n) using memoization.\n    Parameters:\n        n (int): Non\u2011negative integer input.\n    Returns:\n        int: The computed value of f(n).\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n in _memo:\n        return _memo[n]\n    total = (\n        max_revenue(n // 2)\n        + max_revenue(n // 3)\n        + max_revenue(n // 4)\n        + max_revenue(n // 5)\n    )\n    result = n if n > total else total\n    _memo[n] = result\n    return result"}
{"task_id": "393", "solution": "def find_longest_list(lists: list[list[object]]) -> list[object]:\n    \"\"\"\n    Return the longest sublist from a list of lists.\n\n    Parameters\n    ----------\n    lists : list[list[object]]\n        The list containing sublists.\n\n    Returns\n    -------\n    list[object]\n        The longest sublist; the first one in case of ties.\n\n    Raises\n    ------\n    TypeError\n        If `lists` is not a list.\n        If any element in `lists` is not a list.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    longest: list[object] = []\n\n    for sub in lists:\n        if not isinstance(sub, list):\n            raise TypeError(\"All elements must be lists.\")\n        if len(sub) > len(longest):\n            longest = sub\n\n    return longest"}
