{"task_id": "224", "solution": "def count_set_bits(n: int) -> int:\n    \"\"\"\n    Count the number of set bits (1s) in the binary representation of a non\u2011negative integer.\n\n    Args:\n        n (int): Non\u2011negative integer to analyze.\n\n    Returns:\n        int: Number of bits set to 1.\n\n    Raises:\n        TypeError: If n is not an int.\n        ValueError: If n is negative.\n\n    Examples:\n        >>> count_set_bits(0)\n        0\n        >>> count_set_bits(13)   # 1101\u2082\n        3\n        >>> count_set_bits(255)  # 11111111\u2082\n        8\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    count = 0\n    while n:\n        n &= n - 1  # clears the lowest set bit\n        count += 1\n    return count"}
{"task_id": "226", "solution": "def remove_odd_indices(s: str) -> str:\n    \"\"\"\n    Return a new string with all characters at odd index positions removed from the input string.\n    \n    Parameters:\n    s (str): The input string.\n    \n    Returns:\n    str: A string containing only characters from even index positions of the original string.\n    \n    Raises:\n    TypeError: If the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    return s[::2]"}
{"task_id": "227", "solution": "import math\n\ndef min_of_three(a: float, b: float, c: float) -> float:\n    for name, val in ((\"a\", a), (\"b\", b), (\"c\", c)):\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"Argument {name} must be int or float, got {type(val).__name__}\")\n        if math.isnan(val):\n            raise ValueError(f\"Argument {name} is NaN\")\n    min_ab = a if a <= b else b\n    min_value = min_ab if min_ab <= c else c\n    return float(min_value)"}
{"task_id": "228", "solution": "def is_unset_range(value: int, start: int, end: int) -> bool:\n    \"\"\"Determine if all bits in a specified range are unset.\n    \n    Args:\n        value (int): Integer whose bits are examined.\n        start (int): Index of the least significant bit in the range (0 is LSB).\n        end (int): Index of the most significant bit in the range.\n    \n    Returns:\n        bool: ``True`` if all bits in the inclusive range `[start, end]` are 0,\n              otherwise ``False``.\n    \n    Raises:\n        ValueError: If ``start`` or ``end`` is negative, or if ``start > end``.\n    \"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise ValueError(\"Start and end indices must be integers.\")\n    if start < 0 or end < 0:\n        raise ValueError(\"Start and end indices must be non-negative.\")\n    if start > end:\n        raise ValueError(\"Start index must be less than or equal to end index.\")\n    \n    width = end - start + 1\n    mask = ((1 << width) - 1) << start\n    return (value & mask) == 0"}
{"task_id": "229", "solution": "def rearrange(arr: list[int], n: int) -> None:\n    negatives = []\n    positives = []\n    for i in range(n):\n        if arr[i] < 0:\n            negatives.append(arr[i])\n        else:\n            positives.append(arr[i])\n    idx = 0\n    for val in negatives:\n        arr[idx] = val\n        idx += 1\n    for val in positives:\n        arr[idx] = val\n        idx += 1"}
{"task_id": "230", "solution": "def replace_spaces(input_str: str, repl: str) -> str:\n    \"\"\"Replace all blank spaces in a string with a specified character.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to process.\n    repl : str\n        The single character to replace each space with.\n\n    Returns\n    -------\n    str\n        The modified string with spaces replaced by `repl`.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not a string.\n    ValueError\n        If `repl` is not exactly one character long.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string\")\n    if not isinstance(repl, str):\n        raise TypeError(\"repl must be a string\")\n    if len(repl) != 1:\n        raise ValueError(\"repl must be a single character\")\n    return input_str.replace(' ', repl)"}
{"task_id": "232", "solution": "from heapq import heapify, heappush, heappop\nfrom typing import List\n\ndef get_n_largest(items: List[object], n: int) -> List[object]:\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    k = min(n, len(items))\n    if k == 0:\n        return []\n\n    heap = items[:k]\n    heapify(heap)\n\n    for x in items[k:]:\n        if x > heap[0]:\n            heappop(heap)\n            heappush(heap, x)\n\n    result = []\n    while heap:\n        result.append(heappop(heap))\n    result.reverse()\n    return result"}
{"task_id": "233", "solution": "import math\n\ndef lateral_surface_area(radius: float, height: float) -> float:\n    \"\"\"Compute the lateral surface area of a right circular cylinder.\n\n    Parameters\n    ----------\n    radius : float\n        Radius of the cylinder (must be > 0).\n    height : float\n        Height of the cylinder (must be > 0).\n\n    Returns\n    -------\n    float\n        Lateral surface area computed as 2 * pi * radius * height.\n\n    Raises\n    ------\n    TypeError\n        If either radius or height is not a numeric type.\n    ValueError\n        If either radius or height is not positive.\n    \"\"\"\n    # Type validation\n    if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n        raise TypeError(\"radius and height must be numeric\")\n\n    # Value validation\n    if radius <= 0 or height <= 0:\n        raise ValueError(\"radius and height must be positive\")\n\n    # Computation\n    area = 2 * math.pi * float(radius) * float(height)\n\n    return float(area)"}
{"task_id": "234", "solution": "def cube_volume(side: float) -> float:\n    \"\"\"Compute the volume of a cube given its side length.\n\n    Parameters\n    ----------\n    side : float\n        The length of one side of the cube. Must be non\u2011negative.\n\n    Returns\n    -------\n    float\n        The volume of the cube (side ** 3).\n\n    Raises\n    ------\n    TypeError\n        If side is not a numeric type.\n    ValueError\n        If side is negative.\n    \"\"\"\n    if not isinstance(side, (int, float)):\n        raise TypeError(\"Side length must be a number.\")\n    if side < 0:\n        raise ValueError(\"Side length must be non\u2011negative.\")\n    return float(side ** 3)"}
{"task_id": "235", "solution": "def set_even_bits(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    bit_len = n.bit_length()\n    mask = 0\n    i = 0\n    while i <= bit_len:\n        mask |= 1 << i\n        i += 2\n    return n | mask"}
{"task_id": "237", "solution": "def count_tuples(tuples: list[tuple]) -> dict[tuple, int]:\n    \"\"\"Counts occurrences of each unique tuple in the provided list.\n\n    Parameters:\n        tuples (list[tuple]): List containing tuples to be counted.\n\n    Returns:\n        dict[tuple, int]: Dictionary mapping each unique tuple to its count.\n\n    Raises:\n        TypeError: If any element in 'tuples' is not a tuple.\n    \"\"\"\n    if not isinstance(tuples, list):\n        raise TypeError(f\"Expected a list, got {type(tuples).__name__}\")\n    counter: dict[tuple, int] = {}\n    for t in tuples:\n        if not isinstance(t, tuple):\n            raise TypeError(f\"Element {t!r} is not a tuple\")\n        counter[t] = counter.get(t, 0) + 1\n    return counter"}
