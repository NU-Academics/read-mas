{"task_id": "588", "solution": "def range_difference(values: list[int | float]) -> float:\n    \"\"\"Return the numerical difference between the largest and smallest values in `values`.\n\n    Raises:\n        ValueError: If `values` is empty.\n\n    Returns:\n        float: The difference (max - min) cast to float.\n    \"\"\"\n    if not values:\n        raise ValueError(\"Input list must contain at least one element.\")\n    min_val = max_val = values[0]\n    for val in values[1:]:\n        if val < min_val:\n            min_val = val\n        elif val > max_val:\n            max_val = val\n    return float(max_val - min_val)"}
{"task_id": "589", "solution": "import math\n\ndef find_perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"Return a list of all perfect squares between start and end inclusive.\"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"Both start and end must be integers\")\n\n    if start > end:\n        start, end = end, start\n\n    if end < 0:\n        return []\n\n    # Smallest integer whose square is >= start\n    if start <= 0:\n        ceil_sqrt = 0\n    else:\n        ceil_sqrt = math.isqrt(start)\n        if ceil_sqrt * ceil_sqrt < start:\n            ceil_sqrt += 1\n\n    # Largest integer whose square is <= end\n    floor_sqrt = math.isqrt(end)\n\n    if floor_sqrt < ceil_sqrt:\n        return []\n\n    return [i * i for i in range(ceil_sqrt, floor_sqrt + 1)]"}
{"task_id": "590", "solution": "import math\n\ndef polar_to_rectangular(r: float, theta: float) -> tuple[float, float]:\n    return r * math.cos(theta), r * math.sin(theta)"}
{"task_id": "591", "solution": "def swap_first_last(lst: list) -> None:\n    \"\"\"Swap the first and last elements of the provided list in place.\n\n    Parameters\n    ----------\n    lst : list\n        The list whose first and last elements will be exchanged.\n\n    Raises\n    ------\n    TypeError\n        If *lst* is not a list instance.\n\n    Returns\n    -------\n    None\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list\")\n    if len(lst) < 2:\n        return\n    lst[0], lst[-1] = lst[-1], lst[0]"}
{"task_id": "592", "solution": "def sum_consecutive_binomial_products(n: int) -> int:\n    if n <= 0:\n        return 0\n    coeff = [0] * (n + 1)\n    coeff[0] = 1\n    for k in range(1, n + 1):\n        coeff[k] = coeff[k - 1] * (n - k + 1) // k\n    total = 0\n    for k in range(n):\n        total += coeff[k] * coeff[k + 1]\n    return total"}
{"task_id": "593", "solution": "def remove_leading_zeroes(ip: str) -> str:\n    \"\"\"\n    Return the IPv4 address with leading zeroes removed from each octet.\n    Raises ValueError for malformed inputs.\n    \"\"\"\n    if not isinstance(ip, str):\n        raise ValueError(\"Input must be a string\")\n    parts = ip.split('.')\n    if len(parts) != 4:\n        raise ValueError(\"Invalid IP format: expected 4 octets\")\n    cleaned = []\n    for part in parts:\n        if not part.isdigit():\n            raise ValueError(f\"Invalid octet '{part}': not a number\")\n        num = int(part)\n        if num < 0 or num > 255:\n            raise ValueError(f\"Invalid octet '{part}': value out of range 0-255\")\n        cleaned.append(str(num))\n    return '.'.join(cleaned)"}
{"task_id": "594", "solution": "def first_even_odd_difference(nums: list[int]) -> int:\n    if not isinstance(nums, list):\n        raise ValueError(\"Input must be a list\")\n    for x in nums:\n        if not isinstance(x, int):\n            raise ValueError(\"All elements in the list must be integers\")\n    first_even = None\n    first_odd = None\n    for x in nums:\n        if first_even is None and x % 2 == 0:\n            first_even = x\n        elif first_odd is None and x % 2 != 0:\n            first_odd = x\n        if first_even is not None and first_odd is not None:\n            break\n    if first_even is None:\n        raise ValueError(\"No even number found in the list\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list\")\n    return first_even - first_odd"}
{"task_id": "595", "solution": "def min_swaps_to_convert(src: str, target: str) -> int:\n    \"\"\"Calculate the minimum number of swaps required to convert src to target.\n\n    Parameters\n    ----------\n    src : str\n        Binary string consisting only of characters '0' and '1'.\n    target : str\n        Binary string consisting only of characters '0' and '1'.\n\n    Returns\n    -------\n    int\n        Minimum number of swap operations required.\n\n    Raises\n    ------\n    ValueError\n        If either string contains non-binary characters, if the lengths differ,\n        or if any string is None.\n    \"\"\"\n    if src is None or target is None:\n        raise ValueError(\"Input strings cannot be None\")\n\n    if len(src) != len(target):\n        raise ValueError(\"Source and target must have equal length\")\n\n    if set(src).difference({'0', '1'}):\n        raise ValueError(\"Strings must contain only '0' and '1'\")\n    if set(target).difference({'0', '1'}):\n        raise ValueError(\"Strings must contain only '0' and '1'\")\n\n    if len(src) == 0:\n        return 0\n\n    mismatch_10 = 0\n    for s_bit, t_bit in zip(src, target):\n        if s_bit != t_bit and s_bit == '1' and t_bit == '0':\n            mismatch_10 += 1\n\n    return mismatch_10"}
{"task_id": "596", "solution": "\"\"\"\nTuple Memory Size Estimator\n\nThis module provides a single public function `tuple_memory_size` that estimates\nthe memory footprint of a Python tuple, including all nested tuples.  It\nhandles cyclic references by ensuring each object is counted only once.\n\nThe implementation uses only built\u2011in functions and methods, with no external\nimports, and is fully type\u2011hinted for Python\u00a03.9+.\n\"\"\"\n\ndef tuple_memory_size(obj: tuple) -> int:\n    \"\"\"\n    Return the approximate memory size in bytes of *obj* including nested tuples.\n\n    Parameters\n    ----------\n    obj : tuple\n        The tuple whose size is to be calculated.\n\n    Returns\n    -------\n    int\n        The estimated memory footprint in bytes.\n\n    Raises\n    ------\n    TypeError\n        If *obj* is not a tuple instance.\n\n    Notes\n    -----\n    - The function is recursive and will not double\u2011count objects that appear\n      multiple times due to cycles.\n    - Only built\u2011in functions and methods are used; no external imports.\n    \"\"\"\n    # Input validation (R1)\n    if not isinstance(obj, tuple):\n        raise TypeError(f\"Input must be a tuple, got {type(obj).__name__}\")\n\n    # Set to track processed object ids for cycle detection (R3)\n    seen_ids: set[int] = set()\n\n    def _size(o: tuple) -> int:\n        \"\"\"Recursive helper to compute size of a tuple and nested tuples.\"\"\"\n        oid = id(o)\n        # If we've already counted this object, skip to avoid double counting\n        if oid in seen_ids:\n            return 0\n        seen_ids.add(oid)\n\n        # Base size of the current tuple (R4)\n        total = o.__sizeof__()\n\n        # Recursively add sizes of nested tuples\n        for elem in o:\n            if isinstance(elem, tuple):\n                total += _size(elem)\n\n        return total\n\n    # Start recursion from the top\u2011level tuple (R2)\n    return _size(obj)"}
