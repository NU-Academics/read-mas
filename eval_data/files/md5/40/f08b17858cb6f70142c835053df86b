{"task_id": "407", "solution": "def next_bigger(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Input must be non-negative\")\n\n    digits = list(str(n))\n    d = len(digits)\n\n    i = d - 2\n    while i >= 0 and digits[i] >= digits[i + 1]:\n        i -= 1\n    if i == -1:\n        return -1\n\n    j = d - 1\n    while digits[j] <= digits[i]:\n        j -= 1\n\n    digits[i], digits[j] = digits[j], digits[i]\n    digits[i + 1:] = reversed(digits[i + 1:])\n\n    return int(''.join(digits))"}
{"task_id": "408", "solution": "import heapq\nfrom typing import List, Tuple\n\ndef k_smallest_pairs(a: List[int], b: List[int], k: int) -> List[Tuple[int, int]]:\n    if not a or not b or k <= 0:\n        return []\n\n    a_sorted = sorted(a)\n    b_sorted = sorted(b)\n\n    heap: List[Tuple[int, int, int]] = []\n    visited: set[Tuple[int, int]] = set()\n\n    heapq.heappush(heap, (a_sorted[0] + b_sorted[0], 0, 0))\n    visited.add((0, 0))\n\n    result: List[Tuple[int, int]] = []\n    while heap and len(result) < k:\n        sum_val, i, j = heapq.heappop(heap)\n        result.append((a_sorted[i], b_sorted[j]))\n\n        if i + 1 < len(a_sorted) and (i + 1, j) not in visited:\n            heapq.heappush(heap, (a_sorted[i + 1] + b_sorted[j], i + 1, j))\n            visited.add((i + 1, j))\n\n        if j + 1 < len(b_sorted) and (i, j + 1) not in visited:\n            heapq.heappush(heap, (a_sorted[i] + b_sorted[j + 1], i, j + 1))\n            visited.add((i, j + 1))\n\n    return result"}
{"task_id": "409", "solution": "def min_product(tuples: list[tuple[int, int]]) -> int:\n    if not isinstance(tuples, list):\n        raise TypeError(\"Expected a list of tuples\")\n\n    if len(tuples) == 0:\n        raise ValueError(\"Input list cannot be empty\")\n\n    min_prod: int | None = None\n\n    for item in tuples:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(\"Each element must be a tuple of two integers\")\n        a, b = item\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise TypeError(\"Each element must be a tuple of two integers\")\n\n        prod = a * b\n        if min_prod is None or prod < min_prod:\n            min_prod = prod\n\n    return min_prod"}
{"task_id": "410", "solution": "def find_min(values: list[object]) -> float:\n    \"\"\"Return the smallest numeric value (int or float) in a heterogeneous list.\"\"\"\n    min_val: float | None = None\n\n    for item in values:\n        if isinstance(item, (int, float)):\n            val = float(item)\n            if min_val is None or val < min_val:\n                min_val = val\n\n    if min_val is None:\n        raise ValueError(\"No numeric values found in the list.\")\n\n    return min_val"}
{"task_id": "411", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Convert a snake_case string to camelCase.\"\"\"\n    if not s:\n        return \"\"\n    parts = [part for part in s.split('_') if part]\n    if not parts:\n        return \"\"\n    camel_parts: list[str] = [parts[0].lower()]\n    for word in parts[1:]:\n        camel_parts.append(word.capitalize())\n    return \"\".join(camel_parts)"}
