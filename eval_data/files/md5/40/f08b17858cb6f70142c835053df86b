{"task_id": "306", "solution": "def max_inc_subseq_sum_with_element(arr: list[int], k: int, i: int) -> int:\n    \"\"\"Compute the maximum sum of an increasing subsequence that includes arr[k]\n    and uses only elements from indices 0..i (where i < k).\n\n    Parameters\n    ----------\n    arr : list[int]\n        Non\u2011empty list of integers.\n    k : int\n        Index of the mandatory element in arr.\n    i : int\n        Last index of the prefix allowed for the subsequence (must satisfy 0 <= i < k).\n\n    Returns\n    -------\n    int\n        Maximum sum of an increasing subsequence satisfying the constraints.\n\n    Raises\n    ------\n    ValueError\n        If arr is empty or not a list, or if k/i are out of bounds, or if i >= k.\n    \"\"\"\n    # Input validation\n    if not isinstance(arr, list) or len(arr) == 0:\n        raise ValueError(\"Input 'arr' must be a non\u2011empty list of integers.\")\n    if not isinstance(k, int) or not isinstance(i, int):\n        raise ValueError(\"Indices 'k' and 'i' must be integers.\")\n    n = len(arr)\n    if i < 0 or k >= n:\n        raise ValueError(\"Index 'k' is out of bounds.\")\n    if i >= k:\n        raise ValueError(\"Prefix limit 'i' must be strictly less than target index 'k'.\")\n\n    # Dynamic programming for prefix 0..i\n    dp = [0] * (i + 1)\n    for j in range(i + 1):\n        best = 0\n        for t in range(j):\n            if arr[t] < arr[j] and dp[t] > best:\n                best = dp[t]\n        dp[j] = arr[j] + best\n\n    # Find best previous sum that can be extended by arr[k]\n    best_prev = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k] and dp[j] > best_prev:\n            best_prev = dp[j]\n\n    return arr[k] + best_prev"}
{"task_id": "307", "solution": "def slice_tuple(data: tuple, start: int | None = None, end: int | None = None) -> tuple:\n    \"\"\"Return a sliced portion of the input tuple using standard Python slice syntax.\n\n    Parameters\n    ----------\n    data : tuple\n        The tuple to be sliced. Elements may be of any type.\n    start : int | None, optional\n        The start index of the slice. If None, the slice starts at the beginning of the tuple.\n    end : int | None, optional\n        The end index of the slice. If None, the slice ends at the end of the tuple.\n\n    Returns\n    -------\n    tuple\n        A new tuple containing the elements from data[start:end].\n\n    Raises\n    ------\n    TypeError\n        If ``data`` is not a tuple.\n        If ``start`` is not None and not an int.\n        If ``end`` is not None and not an int.\n    \"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(f\"Expected 'data' to be a tuple, got {type(data).__name__}\")\n    if start is not None and not isinstance(start, int):\n        raise TypeError(f\"Expected 'start' to be an int or None, got {type(start).__name__}\")\n    if end is not None and not isinstance(end, int):\n        raise TypeError(f\"Expected 'end' to be an int or None, got {type(end).__name__}\")\n\n    return data[start:end]"}
{"task_id": "308", "solution": "import heapq\nfrom typing import List\n\ndef top_k_products(A: List[float], B: List[float], k: int) -> List[float]:\n    if k <= 0 or not A or not B:\n        return []\n\n    n, m = len(A), len(B)\n    total_pairs = n * m\n    if k >= total_pairs:\n        all_products = [a * b for a in A for b in B]\n        all_products.sort(reverse=True)\n        return all_products[:k]\n\n    A_sorted = sorted(A, reverse=True)\n    B_sorted = sorted(B, reverse=True)\n\n    heap: List[tuple[float, int, int]] = []\n    visited: set[tuple[int, int]] = set()\n    result: List[float] = []\n\n    initial_prod = A_sorted[0] * B_sorted[0]\n    heapq.heappush(heap, (-initial_prod, 0, 0))\n    visited.add((0, 0))\n\n    while len(result) < k and heap:\n        neg_prod, i, j = heapq.heappop(heap)\n        prod = -neg_prod\n        result.append(prod)\n\n        if i + 1 < n and (i + 1, j) not in visited:\n            new_prod = A_sorted[i + 1] * B_sorted[j]\n            heapq.heappush(heap, (-new_prod, i + 1, j))\n            visited.add((i + 1, j))\n\n        if j + 1 < m and (i, j + 1) not in visited:\n            new_prod = A_sorted[i] * B_sorted[j + 1]\n            heapq.heappush(heap, (-new_prod, i, j + 1))\n            visited.add((i, j + 1))\n\n    return result"}
{"task_id": "309", "solution": "def max_of_two(a: float, b: float) -> float:\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"max_of_two: arguments must be numeric (int or float)\")\n    return float(max(a, b))"}
{"task_id": "310", "solution": "def get_chars(s: str) -> tuple[str]:\n    \"\"\"Convert a string into a tuple of its individual characters.\n\n    Parameters\n    ----------\n    s : str\n        The input string to be decomposed into characters.\n\n    Returns\n    -------\n    tuple[str]\n        A tuple containing every character from `s` in the same order.\n\n    Raises\n    ------\n    TypeError\n        If `s` is not of type `str`.\n\n    Notes\n    -----\n    - Empty strings are supported; the function returns an empty tuple in that case.\n    - Unicode strings are fully supported; each code point becomes an element.\n    - The function is pure and side\u2011effect free.\n\n    Examples\n    --------\n    >>> get_chars(\"hello\")\n    ('h', 'e', 'l', 'l', 'o')\n\n    >>> get_chars(\"\")\n    ()\n\n    >>> get_chars(123)\n    Traceback (most recent call last):\n        ...\n    TypeError: Expected a string, got <class 'int'> instead.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(f\"Expected a string, got {type(s)!r} instead.\")\n    return tuple(s)"}
{"task_id": "311", "solution": "def set_leftmost_unset_bit(n: int) -> int:\n    \"\"\"Set the leftmost unset bit of a non\u2011negative integer.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer whose leftmost unset bit will be set.\n\n    Returns\n    -------\n    int\n        New integer with the leftmost unset bit set to 1.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if n == 0:\n        return 1\n    for i in range(n.bit_length() - 1, -1, -1):\n        if (n >> i) & 1 == 0:\n            return n | (1 << i)\n    return n | (1 << n.bit_length())"}
{"task_id": "312", "solution": "import math\n\ndef cone_volume(radius: float, height: float) -> float:\n    \"\"\"\n    Calculate the volume of a right circular cone.\n\n    Parameters\n    ----------\n    radius : float\n        Radius of the cone's base. Must be a non\u2011negative real number.\n    height : float\n        Height of the cone from base to apex. Must be a non\u2011negative real number.\n\n    Returns\n    -------\n    float\n        Volume of the cone.\n\n    Raises\n    ------\n    ValueError\n        If `radius` or `height` is negative or not a real number.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n        raise ValueError(\n            f\"radius and height must be non\u2011negative numbers; received radius={radius}, height={height}\"\n        )\n    if radius < 0 or height < 0:\n        raise ValueError(\n            f\"radius and height must be non\u2011negative numbers; received radius={radius}, height={height}\"\n        )\n    base_area = math.pi * radius * radius\n    return (1.0 / 3.0) * base_area * height"}
{"task_id": "388", "solution": "def highest_power_of_two(n: int) -> int:\n    \"\"\"Return the greatest power of two that is less than or equal to n.\n\n    Parameters\n    ----------\n    n : int\n        A non-negative integer.\n\n    Returns\n    -------\n    int\n        The largest power of two <= n. If n is 0, returns 0.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    ValueError\n        If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n    exp = n.bit_length() - 1\n    return 1 << exp"}
{"task_id": "389", "solution": "def nth_lucas(n: int) -> int:\n    \"\"\"\n    Return the nth Lucas number.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer specifying the position in the Lucas sequence.\n\n    Returns\n    -------\n    int\n        The nth Lucas number.\n\n    Raises\n    ------\n    TypeError\n        If n is not an instance of int.\n    ValueError\n        If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    prev2, prev1 = 2, 1\n    for _ in range(2, n + 1):\n        current = prev1 + prev2\n        prev2, prev1 = prev1, current\n    return prev1"}
{"task_id": "390", "solution": "def format_elements(elements: list[object], fmt: str) -> list[str]:\n    \"\"\"Formats each element in `elements` using `fmt`.  \n    If an element cannot be formatted, its string representation is used unchanged.\n    \"\"\"\n    result: list[str] = []\n    for item in elements:\n        try:\n            formatted = fmt.format(item)\n        except Exception:\n            formatted = str(item)\n        result.append(formatted)\n    return result"}
