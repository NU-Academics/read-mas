{"task_id": "170", "solution": "def range_sum(numbers, start, end):\n    \"\"\"Return the sum of elements in ``numbers`` whose indices are within\n    the inclusive range ``[start, end]``.  Negative indices are interpreted\n    in the Pythonic way, and out\u2011of\u2011range indices are clamped to the bounds\n    of the list.  A ``ValueError`` is raised if ``start`` is greater than\n    ``end`` after normalization.  The function returns ``0.0`` for an empty\n    list or a range that contains no elements.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n\n    n = len(numbers)\n    if n == 0:\n        return 0.0\n\n    # Validate element types\n    for idx, value in enumerate(numbers):\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Element at index {idx} is not numeric\")\n\n    # Convert negative indices\n    if start < 0:\n        start += n\n    if end < 0:\n        end += n\n\n    # Clamp to list bounds\n    start = max(0, min(start, n - 1))\n    end = max(0, min(end, n - 1))\n\n    if start > end:\n        raise ValueError(\"Start index must be less than or equal to end index\")\n\n    total = 0.0\n    for value in numbers[start:end + 1]:\n        total += value\n\n    return float(total)"}
{"task_id": "171", "solution": "def pentagon_perimeter(side: float) -> float:\n    \"\"\"\n    Calculate the perimeter of a regular pentagon.\n\n    Parameters\n    ----------\n    side : float\n        Length of one side. Must be > 0.\n\n    Returns\n    -------\n    float\n        Perimeter of the pentagon.\n\n    Raises\n    ------\n    ValueError\n        If side is not positive.\n    \"\"\"\n    if side <= 0:\n        raise ValueError(\"Side length must be positive.\")\n    return 5 * side"}
