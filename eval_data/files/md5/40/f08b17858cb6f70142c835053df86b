{"task_id": "583", "solution": "def nth_catalan(n: int) -> int:\n    \"\"\"Compute the nth Catalan number using integer arithmetic.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative index of the Catalan sequence.\n\n    Returns\n    -------\n    int\n        Exact value of the nth Catalan number.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    ValueError\n        If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n\n    if n == 0:\n        return 1\n\n    numerator: int = 1\n    for k in range(1, n + 1):\n        numerator = numerator * (n + k) // k\n\n    return numerator // (n + 1)"}
{"task_id": "584", "solution": "def find_first_ly_adverb(text: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Find the first word ending with 'ly' in the given string.\n\n    Parameters\n    ----------\n    text : str\n        The input string to search.\n\n    Returns\n    -------\n    tuple[str, int, int] | None\n        A tuple containing the matching word, its start index, and its end index\n        (end index is exclusive).  Returns None if no such word exists.\n\n    Raises\n    ------\n    TypeError\n        If the supplied argument is not of type str.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Expected a string as input\")\n\n    start: int | None = None\n\n    for i, ch in enumerate(text):\n        if ch.isalpha():\n            if start is None:\n                start = i\n        else:\n            if start is not None:\n                end = i\n                word = text[start:end]\n                if word.lower().endswith(\"ly\"):\n                    return word, start, end\n                start = None\n\n    if start is not None:\n        end = len(text)\n        word = text[start:end]\n        if word.lower().endswith(\"ly\"):\n            return word, start, end\n\n    return None"}
{"task_id": "585", "solution": "import warnings\nfrom typing import Any, Dict, List\n\ndef top_n_expensive_items(\n    dataset: List[Dict[str, Any]],\n    n: int\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Return the n items with the highest 'price' from dataset.\n\n    Parameters\n    ----------\n    dataset : list[dict[str, any]]\n        List of items, each expected to be a dictionary.\n    n : int\n        Number of top items to return.\n\n    Returns\n    -------\n    list[dict[str, any]]\n        List of the n items with the highest 'price', sorted in descending order.\n        Original dictionaries are returned, not copies.\n\n    Raises\n    ------\n    TypeError\n        If `dataset` is not a list or `n` is not an int.\n    \"\"\"\n    # Validate inputs\n    if not isinstance(dataset, list):\n        raise TypeError(\"dataset must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\n    # Early exit for non-positive n\n    if n <= 0:\n        return []\n\n    valid_items: List[Dict[str, Any]] = []\n\n    for idx, item in enumerate(dataset):\n        # Check that item is a dictionary\n        if not isinstance(item, dict):\n            warnings.warn(\n                f\"Item at index {idx} is not a dict and will be skipped.\",\n                RuntimeWarning,\n            )\n            continue\n\n        # Check presence of 'price' key\n        if 'price' not in item:\n            warnings.warn(\n                f\"Item at index {idx} lacks a 'price' key and will be skipped.\",\n                RuntimeWarning,\n            )\n            continue\n\n        price = item['price']\n        # Check that price is numeric\n        if not isinstance(price, (int, float)):\n            warnings.warn(\n                f\"Item at index {idx} has a non-numeric 'price' ({price!r}) and will be skipped.\",\n                RuntimeWarning,\n            )\n            continue\n\n        valid_items.append(item)\n\n    # Sort valid items by price descending\n    sorted_items = sorted(valid_items, key=lambda x: x['price'], reverse=True)\n\n    # Slice to top n (handles n > len(valid_items))\n    return sorted_items[:n]"}
{"task_id": "586", "solution": "from typing import TypeVar, List\n\nT = TypeVar(\"T\")\n\ndef split_and_append(items: List[T], n: int) -> List[T]:\n    \"\"\"\n    Split a list at the nth element and append the first part to the end.\n\n    Parameters\n    ----------\n    items : list\n        The list to be split and reordered.\n    n : int\n        Zero\u2011based index indicating the number of elements in the first part.\n        Must satisfy 0 <= n <= len(items).\n\n    Returns\n    -------\n    list\n        A new list consisting of items[n:] followed by items[:n].\n\n    Raises\n    ------\n    TypeError\n        If 'items' is not a list or 'n' is not an int.\n    ValueError\n        If 'n' is negative or greater than len(items).\n\n    Notes\n    -----\n    - The function does not modify the original list.\n    - If 'items' is empty, an empty list is returned.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(f\"'items' must be a list; received {type(items).__name__}.\")\n    if not isinstance(n, int):\n        raise TypeError(f\"'n' must be an int; received {type(n).__name__}.\")\n\n    length = len(items)\n    if n < 0 or n > length:\n        raise ValueError(\n            f\"n must be between 0 and len(items) inclusive; received n={n}.\"\n        )\n\n    if length == 0:\n        return []\n\n    suffix = items[n:]\n    prefix = items[:n]\n    return suffix + prefix"}
