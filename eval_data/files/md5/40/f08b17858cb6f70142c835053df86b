{"task_id": "754", "solution": "def common_elements_at_same_index(\n    l1: list[object], \n    l2: list[object], \n    l3: list[object]\n) -> list[object]:\n    \"\"\"Return a list of elements that are equal at the same index in all three input lists.\n\n    Parameters\n    ----------\n    l1 : list[object]\n        First input list. Must be of type list.\n    l2 : list[object]\n        Second input list. Must be of type list.\n    l3 : list[object]\n        Third input list. Must be of type list.\n\n    Returns\n    -------\n    list[object]\n        A list containing all elements that are equal at the same index in l1, l2, and l3.\n        The length of the returned list is at most the length of the shortest input list.\n\n    Raises\n    ------\n    TypeError\n        If any of the arguments is not of type list.\n    \"\"\"\n    if not isinstance(l1, list):\n        raise TypeError(\"l1 must be a list\")\n    if not isinstance(l2, list):\n        raise TypeError(\"l2 must be a list\")\n    if not isinstance(l3, list):\n        raise TypeError(\"l3 must be a list\")\n\n    min_len = min(len(l1), len(l2), len(l3))\n    result: list[object] = []\n\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n\n    return result"}
{"task_id": "755", "solution": "def second_smallest(nums: list[float]) -> float:\n    \"\"\"Return the second smallest numeric value from nums.\n\n    Args:\n        nums: A non\u2011empty list of numbers (int or float).\n\n    Returns:\n        The second smallest number.\n\n    Raises:\n        ValueError: If the list has fewer than two distinct values.\n    \"\"\"\n    if len(nums) < 2:\n        raise ValueError(\"List must contain at least two elements\")\n\n    first = float(\"inf\")\n    second = float(\"inf\")\n\n    for num in nums:\n        if num < first:\n            second = first\n            first = num\n        elif num < second and num != first:\n            second = num\n\n    if second == float(\"inf\"):\n        raise ValueError(\"List must contain at least two distinct values\")\n\n    return second"}
{"task_id": "756", "solution": "def matches_pattern(s: str) -> bool:\n    if not s:\n        return False\n    if s[0] != 'a':\n        return False\n    rest = s[1:]\n    if not rest:\n        return False\n    for ch in rest:\n        if ch != 'b':\n            return False\n    return True"}
{"task_id": "757", "solution": "def _validate_input(strings: list[str]) -> None:\n    for s in strings:\n        if not isinstance(s, str):\n            raise TypeError(f\"All elements must be str, got {type(s).__name__}\")\n\n\ndef _build_frequency(strings: list[str]) -> dict[str, int]:\n    freq: dict[str, int] = {}\n    for s in strings:\n        freq[s] = freq.get(s, 0) + 1\n    return freq\n\n\ndef _count_pairs(freq: dict[str, int]) -> int:\n    pair_count = 0\n    for s, count_s in freq.items():\n        rev = s[::-1]\n        if s == rev:\n            pair_count += count_s * (count_s - 1) // 2\n        elif s < rev and rev in freq:\n            pair_count += count_s * freq[rev]\n    return pair_count\n\n\ndef count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"Count unordered pairs of strings where one is the reverse of the other.\n\n    Parameters\n    ----------\n    strings : list[str]\n        List of input strings.\n\n    Returns\n    -------\n    int\n        Number of unordered reverse string pairs.\n\n    Raises\n    ------\n    TypeError\n        If any element in `strings` is not a string.\n    \"\"\"\n    _validate_input(strings)\n    freq = _build_frequency(strings)\n    return _count_pairs(freq)"}
{"task_id": "758", "solution": "def count_list_occurrences(elements: list) -> dict[tuple, int]:\n    \"\"\"Count occurrences of list elements in a list.\n\n    Parameters\n    ----------\n    elements : list\n        A list containing arbitrary elements.\n\n    Returns\n    -------\n    dict[tuple, int]\n        A dictionary mapping each unique list (converted to a tuple)\n        to the number of times it appears in ``elements``.\n\n    Raises\n    ------\n    TypeError\n        If *elements* is not a list.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"Input must be a list\")\n\n    counts: dict[tuple, int] = {}\n    for item in elements:\n        if isinstance(item, list):\n            key = tuple(item)\n            counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "759", "solution": "def is_decimal_two_precision(s: str) -> bool:\n    \"\"\"\n    Returns True if the input string represents a decimal number with exactly two digits\n    after the decimal point; otherwise returns False.\n    \"\"\"\n    if not s:\n        return False\n    idx = 0\n    # Optional sign\n    if s[0] in '+-':\n        idx = 1\n        if len(s) == 1:\n            return False\n    # Must have at least one digit before decimal point\n    if idx >= len(s) or not s[idx].isdigit():\n        return False\n    # Find decimal point\n    dot_pos = s.find('.', idx)\n    if dot_pos == -1:\n        return False\n    # Ensure only one decimal point\n    if s.find('.', dot_pos + 1) != -1:\n        return False\n    # Integer part must be all digits\n    if dot_pos == idx:  # No digits before decimal point\n        return False\n    for ch in s[idx:dot_pos]:\n        if not ch.isdigit():\n            return False\n    # Fraction part must have exactly two digits\n    frac_part = s[dot_pos + 1:]\n    if len(frac_part) != 2:\n        return False\n    for ch in frac_part:\n        if not ch.isdigit():\n            return False\n    return True"}
{"task_id": "760", "solution": "def is_single_distinct_element(data):\n    \"\"\"\n    Determine whether a list contains exactly one distinct numeric element.\n\n    Parameters\n    ----------\n    data : list[int] | list[float]\n        A list of numeric values (integers or floats).  The list itself must be\n        a ``list``; nested or other iterable types are not accepted.\n\n    Returns\n    -------\n    bool\n        ``True`` if the list contains exactly one distinct numeric value.\n        ``False`` for empty lists or lists with more than one distinct value.\n\n    Raises\n    ------\n    TypeError\n        If *data* is not a list.\n        If any element of *data* is not an int or float.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list of numbers.\")\n\n    unique_values = set()\n    for index, element in enumerate(data):\n        if not isinstance(element, (int, float)):\n            raise TypeError(f\"Element at index {index} ({element!r}) is not a number.\")\n        unique_values.add(element)\n        if len(unique_values) > 1:\n            # Early exit: more than one distinct value found\n            return False\n\n    return len(unique_values) == 1"}
{"task_id": "762", "solution": "def has_30_days(month: int) -> bool:\n    \"\"\"Determine whether the given month number has exactly 30 days.\n\n    Parameters\n    ----------\n    month : int\n        An integer representing the month number (1 for January, 12 for December).\n\n    Returns\n    -------\n    bool\n        True if the month has 30 days, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If ``month`` is not an integer or is not between 1 and 12 inclusive.\n    \"\"\"\n    if not isinstance(month, int):\n        raise ValueError(\"Month must be an integer.\")\n    if not 1 <= month <= 12:\n        raise ValueError(\"Month must be between 1 and 12.\")\n    return month in {4, 6, 9, 11}"}
{"task_id": "763", "solution": "from typing import Sequence\n\ndef find_min_difference(arr: Sequence[float]) -> float:\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n    if len(arr) < 2:\n        raise ValueError(\"Array must contain at least two elements.\")\n    for x in arr:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements must be numeric.\")\n    sorted_arr = sorted(arr)\n    min_diff = float(\"inf\")\n    for i in range(len(sorted_arr) - 1):\n        diff = abs(sorted_arr[i + 1] - sorted_arr[i])\n        if diff < min_diff:\n            min_diff = diff\n            if min_diff == 0:\n                break\n    return float(min_diff)"}
{"task_id": "764", "solution": "def count_digits(s: str) -> int:\n    \"\"\"Return the number of digit characters in the input string.\n\n    Parameters\n    ----------\n    s : str\n        The string to analyze.\n\n    Returns\n    -------\n    int\n        The count of characters in `s` that are digits ('0'\u2013'9').\n    \"\"\"\n    count = 0\n    for c in s:\n        if c.isdigit():\n            count += 1\n    return count"}
{"task_id": "765", "solution": "def nth_polite_number(n: int) -> int:\n    \"\"\"Return the n-th polite number.\n    Polite numbers are positive integers that are not powers of two.\"\"\"\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    def f(k: int) -> int:\n        return k - k.bit_length()\n\n    low = 1\n    high = n + 100\n    while f(high) < n:\n        high <<= 1\n\n    while low < high:\n        mid = (low + high) // 2\n        if f(mid) >= n:\n            high = mid\n        else:\n            low = mid + 1\n    return low"}
{"task_id": "766", "solution": "def consecutive_pairs(items: list) -> list[tuple]:\n    if not isinstance(items, list):\n        raise TypeError(\"consecutive_pairs: input must be a list\")\n    n = len(items)\n    if n < 2:\n        return []\n    result: list[tuple] = []\n    for i in range(n - 1):\n        result.append((items[i], items[i + 1]))\n    return result"}
{"task_id": "767", "solution": "def count_pairs(nums: list[int | float], target: int | float) -> int:\n    \"\"\"\n    Count unordered index pairs (i, j) in `nums` such that nums[i] + nums[j] == target.\n    \"\"\"\n    if len(nums) < 2:\n        return 0\n    counts: dict[int | float, int] = {}\n    total = 0\n    for num in nums:\n        complement = target - num\n        if complement in counts:\n            total += counts[complement]\n        counts[num] = counts.get(num, 0) + 1\n    return total"}
{"task_id": "769", "solution": "def list_difference(a: list[object], b: list[object]) -> list[object]:\n    \"\"\"Return the elements of list 'a' that are not in list 'b', preserving order.\n\n    Parameters:\n        a (list[object]): The list to subtract from.\n        b (list[object]): The list of elements to subtract.\n\n    Returns:\n        list[object]: A new list containing elements from 'a' not present in 'b'.\n    \"\"\"\n    set_b = set(b)\n    result = []\n    for x in a:\n        if x not in set_b:\n            result.append(x)\n    return result"}
{"task_id": "770", "solution": "def _nth_odd(k: int) -> int:\n    \"\"\"Return the k\u2011th odd natural number.\"\"\"\n    return 2 * k - 1\n\n\ndef sum_fourth_powers_of_first_n_odd_numbers(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    total = 0\n    for k in range(1, n + 1):\n        odd = _nth_odd(k)\n        total += odd ** 4\n    return total"}
{"task_id": "771", "solution": "def is_opening(ch: str) -> bool:\n    \"\"\"Return True if ch is an opening delimiter.\"\"\"\n    return ch in \"([{\"\n\n\ndef is_closing(ch: str) -> bool:\n    \"\"\"Return True if ch is a closing delimiter.\"\"\"\n    return ch in \")]}\"\n\n\ndef matching(open_br: str, close_br: str) -> bool:\n    \"\"\"Return True if open_br and close_br form a matching pair.\"\"\"\n    pairs = {\"(\": \")\", \"[\": \"]\", \"{\": \"}\"}\n    return pairs.get(open_br) == close_br\n\n\ndef is_balanced(expr: str) -> bool:\n    \"\"\"\n    Check if the delimiters in expr are balanced.\n\n    Args:\n        expr: A string to validate.\n\n    Returns:\n        True if all delimiters are balanced, False otherwise.\n\n    Raises:\n        TypeError: If expr is not a string.\n    \"\"\"\n    if not isinstance(expr, str):\n        raise TypeError(\"Input must be a string\")\n\n    stack = []\n\n    for ch in expr:\n        if is_opening(ch):\n            stack.append(ch)\n        elif is_closing(ch):\n            if not stack:\n                return False\n            last_open = stack.pop()\n            if not matching(last_open, ch):\n                return False\n        # Non\u2011delimiter characters are ignored\n\n    return not stack  # True if stack is empty (balanced), else False\n\n\nif __name__ == \"__main__\":\n    # Simple demo (optional)\n    test_cases = [\n        (\"\", True),\n        (\"()\", True),\n        (\"([])\", True),\n        (\"([)]\", False),\n        (\"(((\", False),\n        (\"((()))\", True),\n        (\"{[()]}\", True),\n        (\"{[(])}\", False),\n        (\"a(b)c\", True),\n        (\"a(b]\", False),\n    ]\n    for s, expected in test_cases:\n        result = is_balanced(s)\n        print(f\"is_balanced({s!r}) = {result} (expected {expected})\")"}
{"task_id": "772", "solution": "import re\n\ndef remove_words_by_length(text: str, k: int) -> str:\n    \"\"\"Remove all words of length k from the input text.\n\n    Parameters\n    ----------\n    text : str\n        The input string from which words are to be removed.\n    k : int\n        The target word length. Must be a positive integer.\n\n    Returns\n    -------\n    str\n        The processed string with words of length k omitted.\n\n    Raises\n    ------\n    TypeError\n        If 'text' is not a string.\n    ValueError\n        If 'k' is not a positive integer.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer\")\n\n    # Pattern matches either a word (letters only) or a sequence of non-letters\n    token_pattern = re.compile(r\"[A-Za-z]+|[^A-Za-z]+\")\n    tokens = token_pattern.findall(text)\n\n    # Filter out words of length k\n    kept_tokens = [\n        token for token in tokens\n        if not (token.isalpha() and len(token) == k)\n    ]\n\n    # Reassemble and normalize whitespace\n    result = \"\".join(kept_tokens)\n    result = re.sub(r\"\\s+\", \" \", result).strip()\n\n    return result"}
{"task_id": "773", "solution": "def find_substring_occurrences(s: str, sub: str) -> tuple[int, list[int]] | None:\n    \"\"\"\n    Find all occurrences of a non\u2011empty substring `sub` within string `s`.\n\n    Parameters\n    ----------\n    s : str\n        Target string to search.\n    sub : str\n        Non\u2011empty substring to locate within `s`.\n\n    Returns\n    -------\n    tuple[int, list[int]] | None\n        If `sub` is found, returns a tuple where the first element is the\n        number of matches and the second element is a list of zero\u2011based start\n        indices.  If `sub` is not found, returns None.\n\n    Raises\n    ------\n    ValueError\n        If `sub` is an empty string.\n    \"\"\"\n    if sub == \"\":\n        raise ValueError(\"substring must not be empty\")\n\n    positions: list[int] = []\n    index = 0\n\n    while index < len(s):\n        found = s.find(sub, index)\n        if found == -1:\n            break\n        positions.append(found)\n        index = found + 1  # allow overlapping matches\n\n    return None if not positions else (len(positions), positions)"}
{"task_id": "775", "solution": "def odd_index_odd_numbers(lst: list[int]) -> bool:\n    for i, value in enumerate(lst):\n        if not isinstance(value, int):\n            raise TypeError(f\"Element at index {i} is not an int: {value!r}\")\n        if i & 1:  # odd index\n            if value % 2 == 0:\n                return False\n    return True"}
{"task_id": "776", "solution": "def count_vowel_neighbor_characters(s: str) -> int:\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    if any(ord(ch) > 127 for ch in s):\n        raise ValueError(\"Input string must contain only ASCII characters.\")\n    n = len(s)\n    if n < 3:\n        return 0\n    vowels = \"aeiou\"\n    lower_s = s.lower()\n    count = 0\n    for i in range(1, n - 1):\n        if lower_s[i - 1] in vowels and lower_s[i + 1] in vowels:\n            count += 1\n    return count"}
{"task_id": "777", "solution": "def sum_unique_elements(elements: list[float]) -> float:\n    if not isinstance(elements, list):\n        raise TypeError(\"Input must be a list\")\n\n    freq = {}\n    for x in elements:\n        if not isinstance(x, (int, float)) or isinstance(x, bool):\n            raise ValueError(\"All elements must be numeric (int or float)\")\n        key = (x, type(x))\n        freq[key] = freq.get(key, 0) + 1\n\n    total = 0.0\n    for (value, _), count in freq.items():\n        if count == 1:\n            total += value\n\n    return float(total)"}
{"task_id": "778", "solution": "def pack_consecutive_duplicates(lst: list[object]) -> list[list[object]]:\n    result: list[list[object]] = []\n    if not lst:\n        return result\n    current_group: list[object] = [lst[0]]\n    for e in lst[1:]:\n        if e == current_group[-1]:\n            current_group.append(e)\n        else:\n            result.append(current_group)\n            current_group = [e]\n    result.append(current_group)\n    return result"}
