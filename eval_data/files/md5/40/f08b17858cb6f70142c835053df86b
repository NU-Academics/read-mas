{"task_id": "56", "solution": "def is_one_less_than_twice_reverse(n):\n    \"\"\"Return True if n == 2 * reverse(n) - 1, where reverse(n) is the decimal\n    reversal of n (leading zeros discarded). Handles only non-negative\n    integers. Raises TypeError if n is not an int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        return False\n\n    rev = 0\n    temp = n\n    while temp > 0:\n        rev = rev * 10 + (temp % 10)\n        temp //= 10\n    # For n == 0, rev stays 0\n    return n == (2 * rev - 1)"}
{"task_id": "57", "solution": "def largest_number_from_digits(digits: list[int]) -> int:\n    \"\"\"Return the largest integer that can be formed from the given list of digits.\"\"\"\n    if not isinstance(digits, list):\n        raise ValueError(\"Input must be a list of single\u2011digit integers\")\n    for idx, d in enumerate(digits):\n        if not isinstance(d, int):\n            raise ValueError(f\"Found non\u2011digit integer: {d}\")\n        if not 0 <= d <= 9:\n            raise ValueError(f\"Found integer outside 0\u20139: {d}\")\n    if not digits:\n        return 0\n    sorted_digits = sorted(digits, reverse=True)\n    number_str = \"\".join(str(d) for d in sorted_digits)\n    return int(number_str)"}
{"task_id": "58", "solution": "def opposite_sign(a: int, b: int) -> bool:\n    \"\"\"Return True if a and b have opposite non\u2011zero signs; False otherwise.\"\"\"\n    if a == 0 or b == 0:\n        return False\n    return (a * b) < 0"}
{"task_id": "59", "solution": "def nth_octagonal(n: int) -> int:\n    \"\"\"\n    Return the nth octagonal number.\n\n    Parameters\n    ----------\n    n : int\n        The position in the octagonal sequence. Must be a positive integer.\n\n    Returns\n    -------\n    int\n        The nth octagonal number computed as n * (3 * n - 2).\n\n    Raises\n    ------\n    ValueError\n        If n is not an integer greater than or equal to 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer\")\n    return n * (3 * n - 2)"}
{"task_id": "61", "solution": "def count_balanced_substrings(digit_str: str) -> int:\n    \"\"\"\n    Count the number of contiguous substrings in `digit_str` where the sum of digits\n    equals the length of the substring.\n\n    Parameters:\n        digit_str (str): A string consisting only of characters '0'\u2013'9'.\n\n    Returns:\n        int: The count of such substrings.\n\n    Raises:\n        ValueError: If `digit_str` contains non-digit characters.\n    \"\"\"\n    if not digit_str:\n        return 0\n    if not digit_str.isdigit():\n        raise ValueError(\"Input string must contain only digits.\")\n    n = len(digit_str)\n    digits = [int(ch) for ch in digit_str]\n    pref = [0] * (n + 1)\n    for i in range(1, n + 1):\n        pref[i] = pref[i - 1] + digits[i - 1]\n    count = 0\n    for l in range(n):\n        for r in range(l, n):\n            length = r - l + 1\n            if pref[r + 1] - pref[l] == length:\n                count += 1\n    return count"}
{"task_id": "62", "solution": "def find_smallest(numbers: list[float]) -> float:\n    if not numbers:\n        raise ValueError(\"Input list is empty.\")\n    min_val = None\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements must be numeric.\")\n        if min_val is None or num < min_val:\n            min_val = num\n    return min_val"}
{"task_id": "63", "solution": "def max_difference(tuples: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Compute the maximum difference between any two integers across all tuples.\n\n    Parameters\n    ----------\n    tuples : list[tuple[int, int]]\n        A list where each element is a tuple containing exactly two integers.\n\n    Returns\n    -------\n    int\n        The maximum difference between any two integers. Returns 0 for an\n        empty list or a single\u2011tuple list.\n\n    Raises\n    ------\n    ValueError\n        If the input list contains elements that are not tuples of length\n        two, or if any tuple contains non\u2011integer values.\n\n    Examples\n    --------\n    >>> max_difference([(1, 3), (5, 7), (2, 9)])\n    7\n    >>> max_difference([])\n    0\n    >>> max_difference([(4, 4)])\n    0\n    \"\"\"\n    if not isinstance(tuples, list):\n        raise ValueError(\"Input must be a list of tuples.\")\n\n    n = len(tuples)\n    if n <= 1:\n        return 0\n\n    # Validate the first tuple and initialize min/max\n    first = tuples[0]\n    if not isinstance(first, tuple) or len(first) != 2:\n        raise ValueError(\"Tuple at index 0 must contain exactly two elements.\")\n    if not isinstance(first[0], int) or not isinstance(first[1], int):\n        raise ValueError(\"Non-integer value found in tuple at index 0.\")\n    min_val = max_val = first[0]\n    if first[1] < min_val:\n        min_val = first[1]\n    if first[1] > max_val:\n        max_val = first[1]\n\n    # Process remaining tuples\n    for i, t in enumerate(tuples[1:], start=1):\n        if not isinstance(t, tuple) or len(t) != 2:\n            raise ValueError(f\"Tuple at index {i} must contain exactly two elements.\")\n        if not isinstance(t[0], int) or not isinstance(t[1], int):\n            raise ValueError(f\"Non-integer value found in tuple at index {i}.\")\n        a, b = t\n        if a < min_val:\n            min_val = a\n        if b < min_val:\n            min_val = b\n        if a > max_val:\n            max_val = a\n        if b > max_val:\n            max_val = b\n\n    return max_val - min_val"}
{"task_id": "64", "solution": "def sort_by_second_value(data: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    if not isinstance(data, list):\n        raise TypeError(\"data must be a list\")\n    for t in data:\n        if not isinstance(t, tuple) or len(t) != 2:\n            raise TypeError(\"each element must be a tuple of length 2\")\n        if not isinstance(t[1], int):\n            raise TypeError(\"second element of each tuple must be an int\")\n    data_copy = list(data)\n    return sorted(data_copy, key=lambda t: t[1])"}
