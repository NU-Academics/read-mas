{"task_id": "80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"Compute the nth tetrahedral number.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer indicating which tetrahedral number to compute.\n\n    Returns\n    -------\n    int\n        The nth tetrahedral number.\n\n    Raises\n    ------\n    TypeError\n        If n is not of type int.\n    ValueError\n        If n is negative.\n\n    Notes\n    -----\n    The function uses the closed\u2011form formula:\n        T_n = n * (n + 1) * (n + 2) // 6\n    which runs in O(1) time.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"n must be an int, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    return n * (n + 1) * (n + 2) // 6"}
{"task_id": "82", "solution": "import math\n\ndef volume_of_sphere(radius: float) -> float:\n    \"\"\"Calculate the volume of a sphere given its radius.\n\n    Parameters\n    ----------\n    radius : float\n        Radius of the sphere. Must be a non\u2011negative real number.\n\n    Returns\n    -------\n    float\n        Volume of the sphere.\n\n    Raises\n    ------\n    TypeError\n        If radius cannot be converted to float.\n    ValueError\n        If radius is negative.\n\n    Examples\n    --------\n    >>> volume_of_sphere(1)\n    4.1887902047863905\n    >>> volume_of_sphere(0)\n    0.0\n    \"\"\"\n    try:\n        r = float(radius)\n    except (TypeError, ValueError):\n        raise TypeError(\"radius must be a numeric type convertible to float\")\n\n    if r < 0:\n        raise ValueError(\"radius must be non\u2011negative\")\n\n    return (4.0 / 3.0) * math.pi * r ** 3"}
{"task_id": "83", "solution": "def sum_ascii_mod26(s: str) -> str:\n    \"\"\"Return a single lowercase letter derived from the ASCII sum of `s` modulo 26.\n\n    Args:\n        s: The string to process.\n\n    Returns:\n        A single lowercase alphabetic character, or an empty string if `s` is empty.\n\n    Raises:\n        ValueError: If `s` is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string\")\n    if not s:\n        return \"\"\n    total = 0\n    for ch in s:\n        total += ord(ch)\n    offset = total % 26\n    return chr(ord('a') + offset)"}
{"task_id": "84", "solution": "def newman_conway(n: int) -> int:\n    \"\"\"Return the n-th term of the Newman\u2013Conway sequence.\n\n    a(1) = 1\n    a(2) = 1\n    a(n) = a(a(n-1)) + a(n - a(n-1))  for n > 2\n\n    Parameters:\n        n: positive integer index (1-based)\n\n    Returns:\n        The value of a(n).\n\n    Raises:\n        ValueError: if n <= 0\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    if n == 1 or n == 2:\n        return 1\n\n    seq = [0] * (n + 1)  # seq[0] unused\n    seq[1] = 1\n    seq[2] = 1\n    for i in range(3, n + 1):\n        prev = seq[i - 1]\n        seq[i] = seq[prev] + seq[i - prev]\n    return seq[n]"}
{"task_id": "85", "solution": "import math\n\ndef sphere_surface_area(radius: float) -> float:\n    \"\"\"Compute the surface area of a sphere.\n\n    Parameters\n    ----------\n    radius : float\n        Radius of the sphere in any consistent length units (e.g., meters, inches).\n\n    Returns\n    -------\n    float\n        Surface area of the sphere in square units.\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a numeric type.\")\n    if radius < 0.0:\n        raise ValueError(\"radius must be non\u2011negative.\")\n    area = 4.0 * math.pi * (radius ** 2)\n    return float(area)"}
{"task_id": "86", "solution": "def calculate_centered_hexagonal(n: int) -> int:\n    \"\"\"\n    Calculate the nth centered hexagonal number.\n\n    The centered hexagonal number sequence starts with 1, 7, 19, 37, ...\n    It is defined by the formula: H(n) = 3 * n * (n - 1) + 1.\n\n    Parameters\n    ----------\n    n : int\n        The position in the sequence (must be a positive integer).\n\n    Returns\n    -------\n    int\n        The nth centered hexagonal number.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    ValueError\n        If n is less than or equal to zero.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n    return 3 * n * (n - 1) + 1"}
{"task_id": "87", "solution": "def merge_dicts(\n    d1: dict[str, object],\n    d2: dict[str, object],\n    d3: dict[str, object]\n) -> dict[str, object]:\n    \"\"\"\n    Merge three dictionaries into one, overriding overlapping keys with\n    values from later dictionaries.\n\n    Parameters\n    ----------\n    d1 : dict[str, object]\n        First dictionary to merge.\n    d2 : dict[str, object]\n        Second dictionary to merge.\n    d3 : dict[str, object]\n        Third dictionary to merge; its values override previous ones.\n\n    Returns\n    -------\n    dict[str, object]\n        A new dictionary containing merged key/value pairs.\n\n    Raises\n    ------\n    TypeError\n        If any argument is not a dict instance.\n    \"\"\"\n    for name, arg in ((\"d1\", d1), (\"d2\", d2), (\"d3\", d3)):\n        if not isinstance(arg, dict):\n            raise TypeError(\n                f\"Argument {name} must be a dict, got {type(arg).__name__}\"\n            )\n    result: dict[str, object] = {}\n    result.update(d1)\n    result.update(d2)\n    result.update(d3)\n    return result"}
{"task_id": "88", "solution": "def frequency_counter(items: list[object]) -> dict[object, int]:\n    freq: dict[object, int] = {}\n    for element in items:\n        try:\n            hash(element)\n        except TypeError:\n            raise TypeError(\"Unhashable element encountered\")\n        if element in freq:\n            freq[element] += 1\n        else:\n            freq[element] = 1\n    return freq"}
{"task_id": "89", "solution": "def largest_integer_less_than(n: int) -> int:\n    \"\"\"Return the largest integer strictly less than the input integer `n`.\n\n    Parameters\n    ----------\n    n : int\n        The integer from which to subtract one.\n\n    Returns\n    -------\n    int\n        The integer `n - 1`.\n\n    Raises\n    ------\n    TypeError\n        If `n` is not an instance of int.\n\n    Examples\n    --------\n    >>> largest_integer_less_than(10)\n    9\n    >>> largest_integer_less_than(-3)\n    -4\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    return n - 1"}
{"task_id": "90", "solution": "def longest_word_length(s: str) -> int:\n    \"\"\"\n    Return the length of the longest contiguous sequence of alphabetic characters in the input string.\n\n    Parameters\n    ----------\n    s : str\n        The string to examine.\n\n    Returns\n    -------\n    int\n        The length of the longest word, or 0 if there are no alphabetic words.\n\n    Raises\n    ------\n    TypeError\n        If *s* is not a string (including None).\n\n    Examples\n    --------\n    >>> longest_word_length(\"Hello world!\")\n    5\n    >>> longest_word_length(\"abc123def\")\n    3\n    >>> longest_word_length(\"!!!\")\n    0\n    >>> longest_word_length(\"caf\u00e9\")\n    4\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    max_len = 0\n    curr_len = 0\n    for ch in s:\n        if ch.isalpha():\n            curr_len += 1\n        else:\n            if curr_len > max_len:\n                max_len = curr_len\n            curr_len = 0\n    if curr_len > max_len:\n        max_len = curr_len\n    return max_len"}
{"task_id": "91", "solution": "def contains_substring(substring: str, string_list: list[str]) -> bool:\n    \"\"\"\n    Return True if `substring` occurs in any string within `string_list`.\n\n    Parameters\n    ----------\n    substring : str\n        Target substring to search for.\n    string_list : list[str]\n        List of strings to search within.\n\n    Returns\n    -------\n    bool\n        True if `substring` is found in at least one element of `string_list`;\n        False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `substring` is not a str, or `string_list` is not a list,\n        or any element of `string_list` is not a str.\n\n    Examples\n    --------\n    >>> contains_substring('foo', ['bar', 'foobar', 'baz'])\n    True\n    >>> contains_substring('hello', ['world'])\n    False\n    \"\"\"\n    if not isinstance(substring, str):\n        raise TypeError(\"substring must be a str\")\n    if not isinstance(string_list, list):\n        raise TypeError(\"string_list must be a list\")\n    for idx, s in enumerate(string_list):\n        if not isinstance(s, str):\n            raise TypeError(f\"element at index {idx} of string_list is not a str\")\n        if substring in s:\n            return True\n    return False"}
{"task_id": "92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Determine whether an integer is undulating.\n\n    An undulating number is defined by consecutive digits that alternately increase\n    and decrease, starting with either pattern. Numbers with fewer than three digits\n    are not considered undulating. Negative signs are ignored.\n\n    Parameters\n    ----------\n    number : int\n        Any signed integer.\n\n    Returns\n    -------\n    bool\n        True if the absolute value of the integer is undulating, False otherwise.\n    \"\"\"\n    num_str = str(abs(number))\n    if len(num_str) < 3:\n        return False\n\n    digits = [int(ch) for ch in num_str]\n\n    def check(start_increase: bool) -> bool:\n        expect_increase = start_increase\n        for a, b in zip(digits, digits[1:]):\n            if expect_increase:\n                if a >= b:\n                    return False\n            else:\n                if a <= b:\n                    return False\n            expect_increase = not expect_increase\n        return True\n\n    return check(True) or check(False)"}
{"task_id": "93", "solution": "def power(a: int | float, b: int | float) -> int | float:\n    \"\"\"Compute a**b with robust error handling.\n\n    Parameters\n    ----------\n    a : int | float\n        Base.\n    b : int | float\n        Exponent.\n\n    Returns\n    -------\n    int | float\n        Result of a**b. Returned as int if both inputs are int and the result is integral,\n        otherwise as float.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not int or float.\n    ValueError\n        If 0 is raised to a negative exponent or if the operation is mathematically undefined\n        (e.g., negative base with fractional exponent).\n    \"\"\"\n    # Type validation\n    if not isinstance(a, (int, float)):\n        raise TypeError(f\"Base 'a' must be int or float, got {type(a).__name__}\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(f\"Exponent 'b' must be int or float, got {type(b).__name__}\")\n\n    # Zero-base handling\n    if a == 0:\n        if b < 0:\n            raise ValueError(\"0 cannot be raised to a negative exponent\")\n        if b == 0:\n            return 1.0\n        return 0.0\n\n    # Exponentiation using built-in pow\n    try:\n        result = pow(a, b)\n    except ValueError:\n        # Propagate domain errors (e.g., negative base with fractional exponent)\n        raise\n\n    # Decide return type\n    if isinstance(a, int) and isinstance(b, int):\n        if isinstance(result, int):\n            return result\n        if isinstance(result, float) and result.is_integer():\n            return int(result)\n\n    return float(result)"}
{"task_id": "94", "solution": "def first_of_min_second(lst: list[tuple]) -> object:\n    \"\"\"Return the first element of the tuple whose second element is the smallest.\n\n    Parameters\n    ----------\n    lst : list[tuple]\n        List of two\u2011element tuples. Elements can be of any type that supports comparison\n        on the second element.\n\n    Returns\n    -------\n    object\n        The first element of the tuple with the minimal second element.\n\n    Raises\n    ------\n    ValueError\n        If lst is empty.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Empty list\")\n    min_tuple = lst[0]\n    for t in lst[1:]:\n        if t[1] < min_tuple[1]:\n            min_tuple = t\n    return min_tuple[0]"}
{"task_id": "95", "solution": "def min_inner_list_length(lists: list[list]) -> int:\n    if not lists:\n        raise ValueError(\"Outer list is empty.\")\n    min_len = float('inf')\n    for inner in lists:\n        if not isinstance(inner, list):\n            raise ValueError(\"All items must be lists.\")\n        current_len = len(inner)\n        if current_len < min_len:\n            min_len = current_len\n    return int(min_len)"}
{"task_id": "96", "solution": "def count_divisors(n):\n    \"\"\"\n    Return the number of positive divisors of the integer n.\n\n    Parameters\n    ----------\n    n : int\n        The integer whose divisors are to be counted. Zero is treated as having zero divisors.\n\n    Returns\n    -------\n    int\n        Count of positive divisors of |n|.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    n = abs(n)\n    divisor_count = 0\n    sqrt_n = int(n**0.5)\n\n    for i in range(1, sqrt_n + 1):\n        if n % i == 0:\n            if i * i == n:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n    return divisor_count"}
