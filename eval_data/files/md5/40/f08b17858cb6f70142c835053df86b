{"task_id": "784", "solution": "def product_first_even_and_odd(numbers: list[int]) -> int | None:\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    first_even = None\n    first_odd = None\n    for x in numbers:\n        if first_even is None and x % 2 == 0:\n            first_even = x\n        elif first_odd is None and x % 2 != 0:\n            first_odd = x\n        if first_even is not None and first_odd is not None:\n            break\n    if first_even is None or first_odd is None:\n        return None\n    return first_even * first_odd"}
{"task_id": "785", "solution": "def convert_tuple_string(s: str) -> tuple[int, ...]:\n    s = s.strip()\n    if s.startswith('(') and s.endswith(')'):\n        s = s[1:-1].strip()\n    if not s:\n        return ()\n    parts = s.split(',')\n    result = []\n    for part in parts:\n        part = part.strip()\n        if not part:\n            raise ValueError(\"Empty tuple element\")\n        try:\n            num = int(part)\n        except ValueError:\n            raise ValueError(f\"Invalid integer value: {part}\") from None\n        result.append(num)\n    return tuple(result)"}
{"task_id": "786", "solution": "\"\"\"insertion_utils\n\nProvides a single function ``insertion_point`` that returns the index at which a\ntarget value should be inserted into a sorted list to preserve ascending order.\nThe function performs input validation and uses a binary search algorithm\nto achieve O(log\u202fn) time complexity.\n\"\"\"\n\ndef insertion_point(sorted_list: list[float], target: float) -> int:\n    \"\"\"Returns the index at which `target` should be inserted into `sorted_list`\n    to maintain ascending order.\n\n    Parameters\n    ----------\n    sorted_list : list[float]\n        A list of numeric values sorted in non\u2011decreasing order.\n    target : float\n        The value to insert.\n\n    Returns\n    -------\n    int\n        The insertion index.\n\n    Raises\n    ------\n    TypeError\n        If `sorted_list` is not a list or contains non\u2011numeric elements,\n        or if `target` is not numeric.\n    ValueError\n        If `sorted_list` is not sorted in ascending order.\n    \"\"\"\n    # Validate sorted_list is a list\n    if not isinstance(sorted_list, list):\n        raise TypeError(\"sorted_list must be a list\")\n\n    # Validate each element is numeric (int or float)\n    for i, element in enumerate(sorted_list):\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"sorted_list elements must be numeric\")\n\n    # Validate target is numeric\n    if not isinstance(target, (int, float)):\n        raise TypeError(\"target must be a numeric value\")\n\n    # Validate sorted_list is sorted in non\u2011decreasing order\n    for i in range(len(sorted_list) - 1):\n        if sorted_list[i] > sorted_list[i + 1]:\n            raise ValueError(\"sorted_list must be sorted in non\u2011decreasing order\")\n\n    # Binary search for the leftmost insertion point\n    left, right = 0, len(sorted_list)\n    while left < right:\n        mid = (left + right) // 2\n        if sorted_list[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "787", "solution": "import re\ndef matches_pattern(s: str) -> bool:\n    \"\"\"Return True if the input string contains the exact sequence 'a' followed\n    by three 'b' characters (i.e., the substring 'abbb'). The match is case-sensitive.\n\n    Parameters\n    ----------\n    s : str\n        The string to be examined.\n\n    Returns\n    -------\n    bool\n        True if 'abbb' is present; False otherwise.\n\n    Examples\n    --------\n    >>> matches_pattern('xxabbbxy')\n    True\n    >>> matches_pattern('abbbb')\n    True\n    >>> matches_pattern('aabb')\n    False\n    \"\"\"\n    return 'abbb' in s"}
{"task_id": "788", "solution": "def combine_and_tuple(input_str: str, input_list: list) -> tuple:\n    \"\"\"\n    Combine a string and a list into a single tuple.\n\n    Parameters:\n        input_str (str): The string whose characters will form the first part of the tuple.\n        input_list (list): The list whose elements will follow the string characters.\n\n    Returns:\n        tuple: A tuple containing all characters of input_str followed by all elements of input_list.\n\n    Raises:\n        TypeError: If input_str is not a str or input_list is not a list.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string.\")\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list.\")\n    return tuple(input_str) + tuple(input_list)"}
{"task_id": "790", "solution": "def check_even_indices(lst: list[int]) -> bool:\n    \"\"\"Check if every element at an even index in the list is an even integer.\n\n    Parameters\n    ----------\n    lst : list[int]\n        The list of integers to check.\n\n    Returns\n    -------\n    bool\n        True if all even\u2011indexed elements are even, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If any element in lst is not an int.\n    \"\"\"\n    for i in range(0, len(lst), 2):\n        value = lst[i]\n        if not isinstance(value, int):\n            raise TypeError(f\"Element at index {i} is not an int: {value!r}\")\n        if value % 2 != 0:\n            return False\n    return True"}
