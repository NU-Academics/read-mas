{"task_id": "66", "solution": "def count_positive_numbers(nums: list[float]) -> int:\n    \"\"\"Count the number of positive numbers in a list.\n\n    Parameters:\n        nums (list[float]): A list containing numeric values (int or float).\n\n    Returns:\n        int: The count of elements greater than zero.\n\n    Raises:\n        TypeError: If any element in the list is not an int or float.\n\n    Example:\n        >>> count_positive_numbers([1, -2, 3.5, 0, -0.1])\n        2\n    \"\"\"\n    for value in nums:\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"List element {value!r} is not a number.\")\n    count = 0\n    for value in nums:\n        if value > 0:\n            count += 1\n    return count"}
{"task_id": "67", "solution": "def compute_bell_number(n: int) -> int:\n    \"\"\"\n    Compute the Bell number B_n, the number of partitions of an n\u2011element set.\n\n    Parameters\n    ----------\n    n : int\n        Size of the set (must be non\u2011negative).\n\n    Returns\n    -------\n    int\n        The Bell number B_n.\n\n    Raises\n    ------\n    ValueError\n        If n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer, got: \" + str(n))\n    if n == 0:\n        return 1\n\n    triangle: list[list[int]] = [[1]]\n    for row_index in range(1, n + 1):\n        row: list[int] = [triangle[row_index - 1][-1]]\n        for col_index in range(1, row_index + 1):\n            row.append(triangle[row_index - 1][col_index - 1] + row[col_index - 1])\n        triangle.append(row)\n\n    return triangle[n][0]"}
{"task_id": "68", "solution": "from collections.abc import Iterable\n\ndef is_monotonic(seq: Iterable[float]) -> bool:\n    \"\"\"Return True if the sequence is monotonic (non\u2011decreasing or non\u2011increasing).\"\"\"\n    it = iter(seq)\n    try:\n        prev = next(it)\n    except StopIteration:\n        # Empty sequence\n        return True\n\n    if not isinstance(prev, (int, float)):\n        raise TypeError(\"Non\u2011numeric element found in sequence\")\n\n    # Find the first distinct pair to determine direction\n    for curr in it:\n        if not isinstance(curr, (int, float)):\n            raise TypeError(\"Non\u2011numeric element found in sequence\")\n        if curr != prev:\n            increasing = prev < curr\n            prev = curr\n            break\n    else:\n        # All elements equal or single element\n        return True\n\n    # Verify remaining elements follow the determined direction\n    for curr in it:\n        if not isinstance(curr, (int, float)):\n            raise TypeError(\"Non\u2011numeric element found in sequence\")\n        if increasing:\n            if prev > curr:\n                return False\n        else:\n            if prev < curr:\n                return False\n        prev = curr\n\n    return True"}
{"task_id": "69", "solution": "def contains_sublist(container: list, subseq: list) -> bool:\n    \"\"\"Determine whether a list contains a specified sublist in consecutive order.\n\n    Args:\n        container: The list in which to search.\n        subseq: The sublist to find within container.\n\n    Returns:\n        True if subseq appears contiguously in container; otherwise False.\n\n    Raises:\n        TypeError: If either argument is not a list.\n    \"\"\"\n    if not isinstance(container, list):\n        raise TypeError(\"container must be a list\")\n    if not isinstance(subseq, list):\n        raise TypeError(\"subseq must be a list\")\n\n    if not subseq:  # Empty subsequence is always contained\n        return True\n\n    len_container = len(container)\n    len_subseq = len(subseq)\n\n    if len_subseq > len_container:\n        return False\n\n    end = len_container - len_subseq\n    for i in range(end + 1):\n        if container[i:i + len_subseq] == subseq:\n            return True\n    return False"}
{"task_id": "70", "solution": "def check_tuples_equal_length(*tuples: tuple) -> bool:\n    # Validate all inputs\n    for t in tuples:\n        if not isinstance(t, tuple):\n            raise TypeError(\"All arguments must be tuples\")\n\n    # Trivial cases\n    if len(tuples) <= 1:\n        return True\n\n    target_len = len(tuples[0])\n    for t in tuples[1:]:\n        if len(t) != target_len:\n            return False\n    return True"}
