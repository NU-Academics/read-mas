{"task_id": "436", "solution": "class InvalidInputError(Exception):\n    \"\"\"Raised when the input to filter_negative_numbers is invalid.\"\"\"\n    pass\n\n\ndef filter_negative_numbers(data: list[float]) -> list[float]:\n    \"\"\"Return a list of negative numbers from the input list.\n\n    Parameters\n    ----------\n    data : list[float]\n        The list of numbers to be filtered. All elements must be int or float.\n\n    Returns\n    -------\n    list[float]\n        A new list containing only the negative numbers from ``data``,\n        preserving the original order.\n\n    Raises\n    ------\n    InvalidInputError\n        If ``data`` is not a list or contains non\u2011numeric elements.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    result: list[float] = []\n    for idx, value in enumerate(data):\n        if not isinstance(value, (int, float)):\n            raise InvalidInputError(\n                f\"Element at index {idx} is not numeric: {value!r}\"\n            )\n        if value < 0:\n            result.append(value)\n    return result"}
{"task_id": "437", "solution": "def remove_odd_characters(s: str) -> str:\n    \"\"\"Remove characters at odd indices from the input string.\n\n    Parameters\n    ----------\n    s : str\n        The input string.\n\n    Returns\n    -------\n    str\n        A new string containing only characters at even indices of s.\n\n    Raises\n    ------\n    TypeError\n        If s is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    return s[::2]"}
{"task_id": "438", "solution": "def count_bidirectional_pairs(pairs: list[tuple[object, object]]) -> int:\n    \"\"\"\n    Count the number of bidirectional tuple pairs in the provided list.\n\n    A bidirectional pair is defined as two tuples (a, b) and (b, a) both\n    present in the list. Self pairs (a, a) are not considered bidirectional.\n\n    Parameters\n    ----------\n    pairs : list[tuple[object, object]]\n        A list of 2-element tuples. Elements can be of any hashable type.\n\n    Returns\n    -------\n    int\n        The number of unique bidirectional pairs.\n\n    Raises\n    ------\n    TypeError\n        If `pairs` is not a list.\n    ValueError\n        If an element in `pairs` is not a 2-element tuple.\n    \"\"\"\n    if not isinstance(pairs, list):\n        raise TypeError(\"pairs must be a list\")\n\n    pair_set: set[tuple[object, object]] = set()\n    for idx, pair in enumerate(pairs):\n        if not isinstance(pair, tuple) or len(pair) != 2:\n            raise ValueError(f\"Element at index {idx} is not a tuple of length 2\")\n        pair_set.add(pair)\n\n    counted: set[frozenset] = set()\n    count = 0\n\n    for pair in pair_set:\n        a, b = pair\n        if a == b:\n            # Self pairs are not bidirectional\n            continue\n        reverse = (b, a)\n        if reverse in pair_set:\n            fs = frozenset(pair)\n            if fs not in counted:\n                counted.add(fs)\n                count += 1\n\n    return count"}
{"task_id": "439", "solution": "def _validate_input(numbers):\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input must be a list\")\n    for n in numbers:\n        if not isinstance(n, int):\n            raise ValueError(\"All elements must be integers\")\n        if n < 0:\n            raise ValueError(\"All integers must be non\u2011negative\")\n\ndef join_integers(numbers):\n    \"\"\"\n    Concatenate the decimal string representations of a list of non\u2011negative integers.\n\n    Parameters\n    ----------\n    numbers : list[int]\n        List of non\u2011negative integers.\n\n    Returns\n    -------\n    int\n        Integer obtained by concatenating the decimal representations of all input integers.\n\n    Raises\n    ------\n    ValueError\n        If the input is not a list, contains non\u2011int elements, or contains negative integers.\n    \"\"\"\n    _validate_input(numbers)\n    if not numbers:\n        return 0\n    parts = [str(n) for n in numbers]\n    concat_str = \"\".join(parts)\n    return int(concat_str)"}
