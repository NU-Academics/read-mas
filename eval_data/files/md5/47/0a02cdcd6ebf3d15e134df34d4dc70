1][j - 1] if i + 1 <= j - 1 else 0)\n                else:\n                    # If characters don't match, take the maximum from excluding either character.\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n        return dp[0][n - 1]\ndef lps(input_str: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    Returns 0 for an empty string.\n    \"\"\"\n    if not input_str:\n        return 0\n\n    input_obj = InputString(input_str)\n    calculator = PalindromeSubsequenceCalculator()\n    calculated_length = calculator.compute(input_obj.value)\n    result_obj = Result(calculated_length)\n    \n    return result_obj.length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\ndef convert(z):\n    \"\"\"Converts a complex number to its polar coordinates (magnitude, angle).\"\"\"\n    magnitude = math.hypot(z.real, z.imag)\n    angle = math.atan2(z.imag, z.real)\n    return (float(magnitude), float(angle))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified limit.\n    An amicable pair (a, b) consists of two different numbers such that the sum of the proper divisors of a is b and the sum of the proper divisors of b is a.\n    \"\"\"\n\n    def _sum_of_proper_divisors(num: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n        if num <= 1:\n            return 0\n        s = 1\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                s += i\n                if i * i != num:\n                    s += num // i\n        return s\n\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in ran