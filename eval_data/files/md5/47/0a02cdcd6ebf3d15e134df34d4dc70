if k_idx <= prefix_end_idx:\n                max_sum_leading_to_k = 0  # No preceding elements, just sequence[k_idx] itself.\n\n            # Also, check if sequence[k_idx] can extend an existing valid subsequence\n            # (one that started in the prefix and ends before k_idx).\n            for p in range(k_idx):\n                if sequence[p] < current_val and dp_prefix_valid[p] != float('-inf'):\n                    max_sum_leading_to_k = max(max_sum_leading_to_k, dp_prefix_valid[p])\n            \n            # If a valid path to sequence[k_idx] was found, update dp_final_with_k[k_idx].\n            if max_sum_leading_to_k != float('-inf'):\n                dp_final_with_k[j] = max_sum_leading_to_k + current_val\n        \n        # As per the design document's \"System Implementation\" -> \"Result Extraction\" section,\n        # the subsequence *must end* at k_idx. Therefore, calculations for j > k_idx in\n        # dp_final_with_k are not required for determining the final answer.\n\n    # As per \"System Implementation\" -> \"Result Extraction\":\n    # \"The answer is dp[k-1] after the DP table is fully populated, representing the maximum sum\n    # of a qualifying subsequence that ends at the required k element.\"\n    final_sum = dp_final_with_k[k_idx]\n    \n    # If no valid subsequence ending at k_idx was found, return 0.\n    if final_sum == float('-inf'):\n        return 0\n    return int(final_sum)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 101, 2, 3, 100, 4, 5], 7, 4, 6]], "plus_fail_tests": [[[5, 2, 4, 1, 3, 6], 6, 1, 3]]}], "Mbpp/310": [{"task_id": "Mbpp/310", "solution": "def string_to_tuple(input: str) -> tuple:\n    \"\"\"\n    Convert a string into a tuple of its characters.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(f\"Expected a string, got {type(input).__name__}\")\n    return tuple(input)", "base_status": "fail", "plus_status"