{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should be False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance: int = 0\n\n    for operation_amount in operations:\n        balance += operation_amount\n        if balance < 0:\n            return True\n\n    return False"}
{"task_id": "HumanEval/4", "solution": "def _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of numbers.\"\"\"\n    return sum(numbers) / len(numbers)\n\ndef _calculate_absolute_differences(numbers: List[float], mean: float) -> List[float]:\n    \"\"\"Calculates absolute differences between each number and the given mean.\"\"\"\n    return [abs(x - mean) for x in numbers]\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    mean_value = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, mean_value)\n\n    # The MAD is the mean of these absolute differences\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:\n        return []\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n\n    return False"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    result = []\n    groups = paren_string.split(' ')\n\n    for group_string in groups:\n        current_nesting = 0\n        max_nesting = 0\n        for char in group_string:\n            if char == '(':\n                current_nesting += 1\n                max_nesting = max(max_nesting, current_nesting)\n            elif char == ')':\n                current_nesting -= 1\n        result.append(max_nesting)\n\n    return result"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    return number - integer_part"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\nclass InputStringProcessor:\n    \"\"\"Handles cleaning the input string by removing spaces.\"\"\"\n    def __init__(self, raw_string: str):\n        self._raw_string = raw_string\n\n    def get_cleaned_string(self) -> str:\n        \"\"\"Returns the input string with all spaces removed.\"\"\"\n        return self._raw_string.replace(' ', '')\n\n\nclass ParenthesesGroup:\n    \"\"\"Represents a balanced parentheses group, storing its content and original indices for nesting checks.\"\"\"\n    def __init__(self, content: str, start_index: int, end_index: int):\n        self.content = content\n        self.start_index = start_index  # Start index in the cleaned string\n        self.end_index = end_index      # End index in the cleaned string\n\n    @staticmethod\n    def is_balanced(s: str) -> bool:\n        \"\"\"Checks if a given string `s` contains balanced parentheses.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:  # Unbalanced ')' before '('\n                return False\n        return balance == 0\n\n    def is_nested_within(self, other: 'ParenthesesGroup') -> bool:\n        \"\"\"Checks if this group is entirely contained within `other` group.\"\"\"\n        # A group is nested if its start and end indices are strictly within another group's indices.\n        return (self.start_index > other.start_index and\n                self.end_index < other.end_index)\n\n\nclass GroupCollection:\n    \"\"\"Manages a collection of ParenthesesGroup objects, filters out nested groups, and provides the final list of strings.\"\"\"\n    def __init__(self):\n        self._groups: List[ParenthesesGroup] = []\n\n    def add_group(self, group: ParenthesesGroup):\n        \"\"\"Adds a ParenthesesGroup to the collection.\"\"\"\n        self._groups.append(group)\n\n    def get_non_nested_groups(self) -> List[ParenthesesGroup]:\n        \"\"\"Returns a list of groups that are not nested within any other group in the collection.\"\"\"\n        if not self._groups:\n            return []\n\n        non_nested = []\n        # Sort groups by start index to simplify nesting checks\n        sorted_groups = sorted(self._groups, key=lambda g: g.start_index)\n\n        for i, current_group in enumerate(sorted_groups):\n            is_current_nested = False\n            for j, other_group in enumerate(sorted_groups):\n                if i == j: # Don't compare a group with itself\n                    continue\n                if current_group.is_nested_within(other_group):\n                    is_current_nested = True\n                    break\n            if not is_current_nested:\n                non_nested.append(current_group)\n        return non_nested\n\n    def to_string_list(self) -> List[str]:\n        \"\"\"Converts the non-nested groups into a list of their string contents.\"\"\"\n        non_nested = self.get_non_nested_groups()\n        return [group.content for group in non_nested]\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    input_processor = InputStringProcessor(paren_string)\n    cleaned_string = input_processor.get_cleaned_string()\n\n    all_groups_collection = GroupCollection()\n\n    # Use a stack to find all balanced groups and their indices\n    stack: List[int] = [] # Stores indices of open parentheses\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            stack.append(i)\n        elif char == ')':\n            if stack: # Found a closing parenthesis for an open one\n                start_idx = stack.pop()\n                end_idx = i\n                content = cleaned_string[start_idx : end_idx + 1]\n\n                # Check if this segment is actually balanced and a valid group\n                if ParenthesesGroup.is_balanced(content):\n                    all_groups_collection.add_group(ParenthesesGroup(content, start_idx, end_idx))\n            else:\n                pass # Mismatched ')' without a preceding '('; ignore it.\n\n    return all_groups_collection.to_string_list()"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    for char in a:\n        if char not in ('0', '1'):\n            raise ValueError(\"Input string 'a' contains invalid characters. Only '0's and '1's are allowed.\")\n    for char in b:\n        if char not in ('0', '1'):\n            raise ValueError(\"Input string 'b' contains invalid characters. Only '0's and '1's are allowed.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length for XOR operation.\")\n\n    result_bits = []\n    for i in range(len(a)):\n        bit_a = a[i]\n        bit_b = b[i]\n\n        if bit_a == bit_b:\n            result_bits.append('0')\n        else:\n            result_bits.append('1')\n\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    if n < 0:\n        return ''\n    return ' '.join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # Found the longest palindromic suffix\n            # The prefix that needs to be reversed is everything before this suffix\n            prefix_to_reverse = string[:i]\n            # Append the reversed prefix to the original string\n            return string + prefix_to_reverse[::-1]\n\n    # This case should ideally not be reached for a non-empty string,\n    # as at least a single character suffix is always a palindrome.\n    # However, as a fallback, if no palindrome is found (e.g., string is empty already handled)\n    # it means the whole string needs to be reversed and appended to itself (minus the last char)\n    # This scenario is covered by the loop as single character is a palindrome.\n    return string"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(longest_so_far):\n            longest_so_far = s\n    return longest_so_far"}
