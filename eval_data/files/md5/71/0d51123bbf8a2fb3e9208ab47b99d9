{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates multiple groups of nested parentheses into individual strings.\n    Spaces are ignored, and top-level balanced groups are collected.\n    \"\"\"\n    cleaned_string = paren_string.replace(' ', '')\n    result_groups: List[str] = []\n    balance_counter = 0\n    group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n            if balance_counter == 1:  # Start of a new top-level group\n                group_start_index = i\n        elif char == ')':\n            balance_counter -= 1\n            if balance_counter == 0 and group_start_index != -1:  # End of a balanced top-level group\n                result_groups.append(cleaned_string[group_start_index : i + 1])\n                group_start_index = -1 # Reset for the next top-level group\n    \n    return result_groups"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    \"\"\"\n\n    class Account:\n        \"\"\"Manages the account balance and checks its status.\"\"\"\n        def __init__(self):\n            self.balance: int = 0\n\n        def apply_operation(self, operation_value: int):\n            \"\"\"Applies a deposit or withdrawal operation to the balance.\"\"\"\n            self.balance += operation_value\n\n        def is_below_zero(self) -> bool:\n            \"\"\"Checks if the current balance is below zero.\"\"\"\n            return self.balance < 0\n\n    account = Account()\n    for operation in operations:\n        account.apply_operation(operation)\n        if account.is_below_zero():\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    \"\"\"\n    # Calculate the integer part of the number by truncating.\n    integer_part = int(number)\n    # Subtract the integer part from the original number to get the decimal part.\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    \n    class ParenthesesGroup:\n        \"\"\"Represents a single, balanced group of parentheses.\"\"\"\n        def __init__(self, group_string: str):\n            self._value = group_string\n\n        def get_value(self) -> str:\n            \"\"\"Returns the string value of the group.\"\"\"\n            return self._value\n\n    class ParenthesesString:\n        \"\"\"Manages the input string, cleans it, and extracts individual ParenthesesGroup objects.\"\"\"\n        def __init__(self, raw_string: str):\n            self._raw_value = raw_string\n            self._cleaned_value = self._remove_spaces(raw_string)\n            self._separated_groups: List[ParenthesesGroup] = []\n            self._separate_groups()\n\n        def _remove_spaces(self, s: str) -> str:\n            \"\"\"Removes all spaces from the input string.\"\"\"\n            return s.replace(' ', '')\n\n        def _separate_groups(self):\n            \"\"\"Identifies and extracts individual balanced, non-nested parentheses groups.\"\"\"\n            balance = 0\n            start_index = 0\n            for i, char in enumerate(self._cleaned_value):\n                if char == '(':\n                    balance += 1\n                elif char == ')':\n                    balance -= 1\n\n                if balance == 0:\n                    group_str = self._cleaned_value[start_index : i + 1]\n                    self._separated_groups.append(ParenthesesGroup(group_str))\n                    start_index = i + 1\n\n        def get_separated_group_values(self) -> List[str]:\n            \"\"\"Returns the string values of the separated groups.\"\"\"\n            return [group.get_value() for group in self._separated_groups]\n\n    parentheses_string_obj = ParenthesesString(paren_string)\n    return parentheses_string_obj.get_separated_group_values()"}
