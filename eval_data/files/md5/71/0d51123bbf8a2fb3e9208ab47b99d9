{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    Returns an empty list if `numbers` is empty.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\nclass Dataset:\n    \"\"\"Encapsulates the data and calculation steps for Mean Absolute Deviation.\"\"\"\n    def __init__(self, numbers: List[float]):\n        if not isinstance(numbers, list) or not all(isinstance(n, (int, float)) for n in numbers):\n            raise TypeError(\"Input must be a list of numbers.\")\n        if not numbers:\n            raise ValueError(\"Input list cannot be empty for MAD calculation.\")\n\n        self._numbers: List[float] = [float(n) for n in numbers]\n        self._mean: float = 0.0\n        self._absoluteDifferences: List[float] = []\n        self._meanAbsoluteDeviation: float = 0.0\n\n    def calculateMean(self) -> None:\n        \"\"\"Calculates the arithmetic mean of the numbers.\"\"\"\n        if not self._numbers:\n            self._mean = 0.0\n            return\n        self._mean = sum(self._numbers) / len(self._numbers)\n\n    def calculateAbsoluteDifferences(self) -> None:\n        \"\"\"Calculates the absolute difference of each number from the mean.\"\"\"\n        if not self._numbers:\n            self._absoluteDifferences = []\n            return\n        self._absoluteDifferences = [abs(x - self._mean) for x in self._numbers]\n\n    def calculateMeanAbsoluteDeviation(self) -> None:\n        \"\"\"Calculates the average of the absolute differences (MAD).\"\"\"\n        if not self._absoluteDifferences:\n            self._meanAbsoluteDeviation = 0.0\n            return\n        self._meanAbsoluteDeviation = sum(self._absoluteDifferences) / len(self._absoluteDifferences)\n\n    def getMeanAbsoluteDeviation(self) -> float:\n        \"\"\"Returns the calculated Mean Absolute Deviation.\"\"\"\n        return self._meanAbsoluteDeviation\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    dataset = Dataset(numbers)\n    dataset.calculateMean()\n    dataset.calculateAbsoluteDifferences()\n    dataset.calculateMeanAbsoluteDeviation()\n    return dataset.getMeanAbsoluteDeviation()"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Calculates the deepest nesting level for multiple groups of parentheses.\n    Each group is separated by spaces, and the results are returned in order.\n    \"\"\"\n\n    class NestingLevelCalculator:\n        \"\"\"Contains the logic to determine the deepest nesting level for a given parentheses group.\"\"\"\n        def calculate(self, group_value: str) -> int:\n            max_level = 0\n            current_level = 0\n            for char in group_value:\n                if char == '(':\n                    current_level += 1\n                    max_level = max(max_level, current_level)\n                elif char == ')':\n                    current_level -= 1\n            return max_level\n\n    class ParenthesesGroup:\n        \"\"\"Represents a single group of parentheses and delegates nesting level calculation.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def calculate_deepest_nesting(self) -> int:\n            return NestingLevelCalculator().calculate(self.value)\n\n    class ParenthesesString:\n        \"\"\"Manages the full input string and its decomposition into individual groups.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def parse_groups(self) -> List[ParenthesesGroup]:\n            group_strings = self.value.split(' ')\n            return [ParenthesesGroup(s) for s in group_strings]\n\n    class ResultList:\n        \"\"\"Collects and maintains the ordered list of deepest nesting levels.\"\"\"\n        def __init__(self):\n            self.levels: List[int] = []\n\n        def add_level(self, level: int) -> None:\n            self.levels.append(level)\n\n    ps_instance = ParenthesesString(paren_string)\n    groups = ps_instance.parse_groups()\n\n    rl_instance = ResultList()\n\n    for pg_instance in groups:\n        nesting_level = pg_instance.calculate_deepest_nesting()\n        rl_instance.add_level(nesting_level)\n\n    return rl_instance.levels"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _calculate_group_nesting_depth(group_string: str) -> int:\n    \"\"\"\n    Calculates the deepest level of nesting for a single parentheses group string.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = paren_string.split(' ')\n    results: List[int] = []\n\n    for group_str in groups:\n        if group_str:  # Only process non-empty group strings\n            depth = _calculate_group_nesting_depth(group_str)\n            results.append(depth)\n\n    return results"}
