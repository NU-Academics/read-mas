{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        # If the complement of the current number has been seen before,\n        # then we have found two distinct elements that sum to zero.\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    res = []\n    while x > 0:\n        remainder = x % base\n        res.append(str(remainder))\n        x //= base\n    return \"\".join(res[::-1])"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function computes the n-th element of the fib4 number sequence iteratively.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the four preceding values: fib4(0), fib4(1), fib4(2), fib4(3)\n    # a = fib4(n-4), b = fib4(n-3), c = fib4(n-2), d = fib4(n-1)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        # Calculate the next fib4 number\n        next_fib = d + c + b + a\n        # Shift the values to prepare for the next iteration\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    The list is assumed to be non-empty and contain numerical elements.\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements, return the middle element\n        return float(sorted_l[n // 2])\n    else:\n        # Even number of elements, return the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
