{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    if n == 1 or n == 2:\n        return 1\n\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        else:\n            return False  # Invalid character\n\n        if balance < 0:\n            return False  # Premature closing bracket\n\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def _is_increasing_check(l: list) -> bool:\n    \"\"\"Checks if the list is monotonically increasing.\"\"\"\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            return False\n    return True\ndef _is_decreasing_check(l: list) -> bool:\n    \"\"\"Checks if the list is monotonically decreasing.\"\"\"\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            return False\n    return True\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = _is_increasing_check(l)\n    is_decreasing = _is_decreasing_check(l)\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = list(set1.intersection(set2))\n    common_elements.sort()\n    return common_elements"}
