{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n\n    # Create a shallow copy of the input list to store the result.\n    result_list = list(l)\n\n    # Collect elements at indices divisible by three.\n    elements_to_sort = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_to_sort.append(l[i])\n\n    # Sort the collected elements in ascending order.\n    elements_to_sort.sort()\n\n    # Reinsert the sorted elements back into result_list at their original divisible-by-three indices.\n    sorted_idx_counter = 0\n    for i in range(len(result_list)):\n        if i % 3 == 0:\n            result_list[i] = elements_to_sort[sorted_idx_counter]\n            sorted_idx_counter += 1\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Helper for derivative calculation using polynomial coefficients.\n    def _poly_prime(coeffs: list, val: float):\n        prime_coeffs = [i * c for i, c in enumerate(coeffs)][1:]\n        return sum([c_prime * math.pow(val, i) for i, c_prime in enumerate(prime_coeffs)])\n\n    # Initial guess for x (common starting point for Newton's method).\n    x = 0.0\n\n    # Parameters for Newton's method convergence.\n    tolerance = 1e-6\n    max_iterations = 100\n\n    for _ in range(max_iterations):\n        fx = poly(xs, x)\n\n        # If the polynomial value is close to zero, we've found a root.\n        if abs(fx) < tolerance:\n            return x\n\n        f_prime_x = _poly_prime(xs, x)\n\n        # If the derivative is too small, Newton's method might become unstable.\n        # For the given problem constraints, return the current approximation.\n        if abs(f_prime_x) < tolerance:\n            return x\n\n        # Apply Newton-Raphson formula to update x.\n        x = x - fx / f_prime_x\n\n    # If max iterations are reached, return the current best approximation.\n    return x"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    max_val = l[0]\n    for item in l:\n        if item > max_val:\n            max_val = item\n    return max_val"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(number: int) -> bool:\n        \"\"\"Check if a number is divisible by 11 or 13.\"\"\"\n        return number % 11 == 0 or number % 13 == 0\n\n    def _count_digit_occurrences(number: int, digit: int) -> int:\n        \"\"\"Count occurrences of a specific digit in a number.\"\"\"\n        count = 0\n        s_number = str(number)\n        s_digit = str(digit)\n        for char in s_number:\n            if char == s_digit:\n                count += 1\n        return count\n\n    total_sum = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sum += _count_digit_occurrences(i, 7)\n    return total_sum"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result_list = list(l)  # Create a mutable copy of the input list.\n\n    even_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:  # If the index is even\n            even_elements.append(l[i])\n\n    even_elements.sort()  # Sort the collected even-indexed elements.\n\n    even_idx_counter = 0\n    for i in range(len(result_list)):\n        if i % 2 == 0:  # If the index is even\n            result_list[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n\n    return result_list"}
