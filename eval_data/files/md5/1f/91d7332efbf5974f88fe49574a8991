{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string.\n    Count overlapping cases.\n    \"\"\"\n    if not substring:\n        return 0\n    if not string:\n        return 0\n\n    count = 0\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i + len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"Finds the two numbers in a list that are closest to each other.\n    Returns them as a tuple, ordered from smaller to larger.\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (sorted_numbers[0], sorted_numbers[1]) # Initialize with first two elements\n\n    for i in range(len(sorted_numbers) - 1):\n        diff = abs(sorted_numbers[i+1] - sorted_numbers[i])\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n\n    return closest_pair"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"Finds the two closest numbers in a list of floats. Returns them as a tuple (smaller, larger).\"\"\"\n\n    sorted_numbers = sorted(numbers)\n\n    # Initialize with the first pair after sorting, as per CRITICAL requirement to trust input length.\n    min_diff = abs(sorted_numbers[1] - sorted_numbers[0])\n    closest_pair = (sorted_numbers[0], sorted_numbers[1])\n\n    # Iterate through adjacent elements to find the smallest difference.\n    for i in range(1, len(sorted_numbers) - 1):\n        diff = abs(sorted_numbers[i+1] - sorted_numbers[i])\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n\n    return closest_pair"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n_WORD_TO_INT_MAP = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\n_INT_TO_WORD_MAP = {\n    0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n    5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n}\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of number words from 'zero' to 'nine'.\n    It returns the string with numbers sorted from smallest to largest.\n    \"\"\"\n    if not numbers:\n        return \"\"\n\n    words: List[str] = numbers.split(' ')\n\n    int_numbers: List[int] = []\n    for word in words:\n        int_numbers.append(_WORD_TO_INT_MAP[word])\n\n    int_numbers.sort()\n\n    sorted_words: List[str] = []\n    for num in int_numbers:\n        sorted_words.append(_INT_TO_WORD_MAP[num])\n\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/17", "solution": "from typing import List\nNOTE_MAPPINGS: Dict[str, int] = {\n    'o|': 2,  # Half note\n    '.|': 1,  # Quarter note\n    'o': 4    # Whole note\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses an ASCII musical notation string into a list of beat durations, skipping whitespace.\n    It processes notes like 'o' (4 beats), 'o|' (2 beats), and '.|' (1 beat).\n    \"\"\"\n    result: List[int] = []\n    i = 0\n    while i < len(music_string):\n        if music_string[i].isspace():\n            i += 1\n            continue\n\n        matched = False\n        for note_str, beats in NOTE_MAPPINGS.items():\n            if music_string.startswith(note_str, i):\n                result.append(beats)\n                i += len(note_str)\n                matched = True\n                break\n\n        # Critical requirement: \"Trust the caller's inputs\" implies that all\n        # non-whitespace characters will form a valid note pattern.\n        # No error handling for unmatched patterns is implemented.\n    return result"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Sorts a space-delimited string of number words from smallest to largest.\n    Only words 'zero' through 'nine' are supported.\n    \"\"\"\n    WORD_TO_INT_MAP: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    INT_TO_WORD_MAP: Dict[int, str] = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    if not numbers.strip():\n        return \"\"\n\n    words: List[str] = numbers.split(' ')\n    ints: List[int] = [WORD_TO_INT_MAP[word] for word in words]\n    ints.sort()\n    sorted_words: List[str] = [INT_TO_WORD_MAP[num] for num in ints]\n\n    return \" \".join(sorted_words)"}
