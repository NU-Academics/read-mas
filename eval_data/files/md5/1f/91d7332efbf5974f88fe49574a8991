{"task_id": "HumanEval/64", "solution": "class VowelUtils:\n    \"\"\"Provides utility methods for determining if a character is a vowel.\n    It encapsulates vowel definition logic.\n    \"\"\"\n    STANDARD_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_standard_vowel(self, char: str) -> bool:\n        \"\"\"Checks if the character is a standard vowel, case-insensitively.\"\"\"\n        return char.lower() in self.STANDARD_VOWELS\n\n    def is_y_vowel(self, char: str, is_last_char: bool) -> bool:\n        \"\"\"Checks if the character 'y' is a vowel based on its position.\"\"\"\n        return char.lower() == 'y' and is_last_char\nclass VowelCounter:\n    \"\"\"Orchestrates the process of counting vowels in a string.\"\"\"\n    def __init__(self):\n        self._vowel_utils = VowelUtils()\n\n    def count_vowels(self, s: str) -> int:\n        \"\"\"Iterates through the input string and counts vowels according to rules.\"\"\"\n        vowel_count = 0\n        s_lower = s.lower()\n        n = len(s_lower)\n\n        for i, char in enumerate(s_lower):\n            if self._vowel_utils.is_standard_vowel(char):\n                vowel_count += 1\n            elif self._vowel_utils.is_y_vowel(char, i == n - 1):\n                vowel_count += 1\n        return vowel_count\ndef vowels_count(s):\n    \"\"\"Counts the number of vowels in a string s.\n    'y' is a vowel only if it is at the end of the given word.\n    \"\"\"\n    counter = VowelCounter()\n    return counter.count_vowels(s)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"Finds the smallest even non-negative integer and its index in `arr`.\n    Returns `[value, index]` or `[]` if no even numbers or the array is empty.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given apple and orange counts, and the total.\n    Counts unparseable fruit types as 0.\n    \"\"\"\n    apples = 0\n    oranges = 0\n\n    # Extract apple count. Defaults to 0 if not found.\n    apple_match = re.search(r\"(\\d+)\\s*apples\", s)\n    if apple_match:\n        apples = int(apple_match.group(1))\n\n    # Extract orange count. Defaults to 0 if not found.\n    orange_match = re.search(r\"(\\d+)\\s*oranges\", s)\n    if orange_match:\n        oranges = int(orange_match.group(1))\n\n    total_known_fruits = apples + oranges\n\n    # Calculate mangoes, ensuring a non-negative count.\n    mangoes = n - total_known_fruits\n\n    return max(0, mangoes)"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''Given a list of positive integers, return the greatest integer whose frequency is greater than or equal to its value. Return -1 if no such integer exists.'''\n    frequencies = {}\n    for x in lst:\n        frequencies[x] = frequencies.get(x, 0) + 1\n\n    max_valid_int = -1\n    for value, freq in frequencies.items():\n        if value > 0 and freq >= value:\n            if value > max_valid_int:\n                max_valid_int = value\n\n    return max_valid_int"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node and its index in an array. Prioritizes the smallest index if multiple nodes share the smallest even value, or returns `[]` if none.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Returns the greatest integer in a list whose frequency is greater than or equal to its value.\n    If no such integer exists, it returns -1.\n    \"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n\n    candidates = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n    else:\n        return max(candidates)"}
{"task_id": "HumanEval/67", "solution": "import re\nclass FruitCounts:\n    \"\"\"Stores apple and orange counts.\"\"\"\n    def __init__(self, apples, oranges):\n        self.apples = apples\n        self.oranges = oranges\nclass FruitParser:\n    \"\"\"Parses a string to extract fruit counts.\"\"\"\n    def parse_fruit_string(self, s):\n        apple_match = re.search(r'(\\d+)\\s*apples', s, re.IGNORECASE)\n        orange_match = re.search(r'(\\d+)\\s*oranges', s, re.IGNORECASE)\n        apples = int(apple_match.group(1))\n        oranges = int(orange_match.group(1))\n        return FruitCounts(apples, oranges)\nclass FruitCalculator:\n    \"\"\"Calculates mangoes based on total fruits and other counts.\"\"\"\n    def calculate_mangoes(self, total_fruits, counts):\n        total_known_fruits = counts.apples + counts.oranges\n        mangoes = total_fruits - total_known_fruits\n        return mangoes\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates mangoes from a string of apple/orange counts and total fruits.\n    It returns the number of mango fruits.\n    \"\"\"\n    parser = FruitParser()\n    fruit_counts = parser.parse_fruit_string(s)\n    calculator = FruitCalculator()\n    mangoes = calculator.calculate_mangoes(n, fruit_counts)\n    return mangoes"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    class ListManipulator:\n        \"\"\"Provides static utility methods for list manipulation.\"\"\"\n        @staticmethod\n        def find_min(data):\n            return min(data)\n\n        @staticmethod\n        def find_max(data):\n            return max(data)\n\n        @staticmethod\n        def remove_first_occurrence(data, value):\n            \"\"\"Returns a new list with the first occurrence of value removed.\"\"\"\n            new_list = data[:]\n            new_list.remove(value)\n            return new_list\n\n    class StrangeSorter:\n        \"\"\"Orchestrates the strange sorting process.\"\"\"\n        def __init__(self, initial_list):\n            self._working_list = initial_list[:] # Work on a copy of the input list.\n            self._result_list = []\n\n        def sort(self):\n            \"\"\"Executes the strange sorting algorithm, returning the result.\"\"\"\n            is_min_turn = True\n            while self._working_list:\n                if is_min_turn:\n                    value_to_add = ListManipulator.find_min(self._working_list)\n                else:\n                    value_to_add = ListManipulator.find_max(self._working_list)\n\n                self._result_list.append(value_to_add)\n                self._working_list = ListManipulator.remove_first_occurrence(self._working_list, value_to_add)\n                is_min_turn = not is_min_turn\n            return self._result_list\n\n    sorter = StrangeSorter(lst)\n    return sorter.sort()"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Starts with the minimum value, then maximum of remaining, then minimum, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a mutable copy and pre-sort, as per design's example and NFR1 consideration.\n    # This copy 'data' will be modified.\n    data = sorted(lst)\n    result = []\n\n    while data:\n        # Find and remove the minimum element from the remaining 'data' list.\n        min_val = min(data)\n        data.remove(min_val)\n        result.append(min_val)\n\n        if not data:\n            break\n\n        # Find and remove the maximum element from the remaining 'data' list.\n        max_val = max(data)\n        data.remove(max_val)\n        result.append(max_val)\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns -1.0 if the sides do not form a valid triangle.\n    \"\"\"\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    s = (a + b + c) / 2\n    # Use max(0, ...) to prevent math.sqrt errors due to floating-point inaccuracies.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    area = math.sqrt(max(0, area_squared))\n\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle, return its area rounded to 2 decimal places.\n    Returns -1.0 if the sides do not form a valid triangle.\n    '''\n    # Validate side lengths: must be positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n\n    # Validate triangle inequality: sum of any two sides must be greater than the third.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate area using Heron's formula.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Round the area to two decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n  '''\n  Write a function that returns True if the object q will fly, and False otherwise.\n  The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n  '''\n  # Check if q is a palindrome (balanced)\n  is_balanced = (q == q[::-1])\n\n  if not is_balanced:\n    return False\n\n  # Calculate the sum of elements (total weight)\n  total_weight = sum(q)\n\n  # Check if total_weight is less than or equal to maximum allowed weight w\n  is_under_weight = (total_weight <= w)\n\n  return is_under_weight"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Checks if a list q is a palindrome and its sum is within a weight w.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    is_palindrome = (q == q[::-1])\n    list_sum = sum(q)\n    is_sum_ok = (list_sum <= w)\n\n    return is_palindrome and is_sum_ok"}
