{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in a 2D ragged list and returns their\n    (row, column) coordinates, sorted by row ascending, then column descending.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row_list in enumerate(lst):\n        for c_idx, item in enumerate(row_list):\n            if item == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates: primary by row ascending, secondary by column descending.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sorts in ascending order if sum(first index value, last index value) is odd, or in descending order if even.\n    \"\"\"\n    if not array or len(array) <= 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integers x in the list and returns a list of tuples, [(x1, y1), (x2, y2) ...]\n    Sort coordinates initially by rows in ascending order, then by columns in descending order.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The sorting order depends on the parity of the sum of the first and last elements.\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    total_sum = first_val + last_val\n\n    reverse_sort = False\n    if total_sum % 2 == 0:\n        reverse_sort = True  # Sort descending if sum is even\n\n    copied_array = list(array)\n    return sorted(copied_array, reverse=reverse_sort)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not s:\n        return \"\"\n\n    result_parts = []\n    current_chunk = []\n\n    # Determine initial state based on the first character\n    # True if we are processing a word, False if processing spaces\n    is_processing_word = not s[0].isspace()\n\n    for char in s:\n        char_is_space = char.isspace()\n\n        if is_processing_word:\n            if char_is_space:\n                # End of a word, sort and append it\n                result_parts.append(\"\".join(sorted(current_chunk)))\n                # Start new chunk with the current space\n                current_chunk = [char]\n                is_processing_word = False\n            else:\n                # Still accumulating characters for the current word\n                current_chunk.append(char)\n        else:  # is_processing_spaces\n            if char_is_space:\n                # Still accumulating spaces\n                current_chunk.append(char)\n            else:\n                # End of a space block, append it as is\n                result_parts.append(\"\".join(current_chunk))\n                # Start new chunk with the current character (which is part of a word)\n                current_chunk = [char]\n                is_processing_word = True\n\n    # Append the last accumulated chunk after the loop finishes\n    if is_processing_word:\n        result_parts.append(\"\".join(sorted(current_chunk)))\n    else:\n        result_parts.append(\"\".join(current_chunk))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string using a rotational cipher with a fixed shift of 4.\n    Only lowercase English alphabetic characters are rotated.\n    \"\"\"\n    _shift = 4\n    _ALPHABET_SIZE = 26\n    _ASCII_LOWER_A = ord('a')\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            original_pos = ord(char) - _ASCII_LOWER_A\n            new_pos = (original_pos + _shift) % _ALPHABET_SIZE\n            encrypted_char = chr(_ASCII_LOWER_A + new_pos)\n            encrypted_chars.append(encrypted_char)\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
