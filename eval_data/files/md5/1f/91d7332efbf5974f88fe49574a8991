{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of the given string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    n = len(string)\n\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n\n    return True"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n\n    if length <= 1:\n        return False\n    i = 2\n    # Check for divisors up to the square root of the length.\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 1\n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Assumes n is a positive integer.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count of n-digit numbers starting with 1.\n    starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1.\n    ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting AND ending with 1.\n    starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the principle of inclusion-exclusion.\n    return starts_with_1 + ends_with_1 - starts_and_ends_with_1"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It converts a list of numerical GPAs into a list of letter grades.\n    The conversion follows a specific grading scale defined internally.\n    \"\"\"\n    result_grades = []\n    for gpa in grades:\n        letter_grade = 'E' # Default for GPAs 0.0 or less\n\n        if gpa == 4.0:\n            letter_grade = 'A+'\n        elif gpa > 3.7:\n            letter_grade = 'A'\n        elif gpa > 3.3:\n            letter_grade = 'A-'\n        elif gpa > 3.0:\n            letter_grade = 'B+'\n        elif gpa > 2.7:\n            letter_grade = 'B'\n        elif gpa > 2.3:\n            letter_grade = 'B-'\n        elif gpa > 2.0:\n            letter_grade = 'C+'\n        elif gpa > 1.7:\n            letter_grade = 'C'\n        elif gpa > 1.3:\n            letter_grade = 'C-'\n        elif gpa > 1.0:\n            letter_grade = 'D+'\n        elif gpa > 0.7:\n            letter_grade = 'D'\n        elif gpa > 0.0:\n            letter_grade = 'D-'\n        # For gpa <= 0.0, it remains 'E' as initialized\n\n        result_grades.append(letter_grade)\n    return result_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"\n    Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n\n    def calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of a given integer.\"\"\"\n        total_sum = 0\n        s_num = str(num)\n        for digit_char in s_num:\n            total_sum += int(digit_char)\n        return total_sum\n\n    def decimal_to_binary_string(decimal_val: int) -> str:\n        \"\"\"Converts a non-negative decimal integer into its binary string representation.\"\"\"\n        return bin(decimal_val)[2:]\n\n    sum_of_digits = calculate_digit_sum(N)\n    binary_sum_string = decimal_to_binary_string(sum_of_digits)\n    return binary_sum_string"}
