{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_values.sort()\n\n    result = l[:] # Create a shallow copy of the original list\n\n    sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_values[sorted_idx]\n        sorted_idx += 1\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"\n    This function sorts elements at even indices of a list, preserving odd-indexed elements.\n    It returns a new list with this specific transformation applied.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result_list = list(l)\n    even_idx_counter = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"Evaluates polynomial with coefficients xs at point x.\"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"Finds a single zero point for a polynomial with an even number of coefficients.\"\"\"\n    tolerance = 1e-6\n    max_iterations = 1000\n    low, high = -100.0, 100.0\n\n    f_low = poly(xs, low)\n\n    for _ in range(max_iterations):\n        mid = (low + high) / 2\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < tolerance:\n            return mid\n\n        if f_low * f_mid < 0:\n            high = mid\n        else:\n            low = mid\n            f_low = f_mid\n\n    return mid"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int) or n <= 1:\n        raise ValueError(\"Input 'n' must be an integer greater than 1.\")\n\n    total_sevens_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single real zero for a polynomial given its coefficients.\n    Uses the bisection method within a default range, assuming a root is bracketed.\n    \"\"\"\n    tolerance = 1e-6\n    max_iterations = 100\n\n    a, b = -100.0, 100.0  # Initial search range for bisection\n\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    # If an exact root is at an initial bound, return it immediately.\n    if abs(fa) < tolerance:\n        return round(a, 2)\n    if abs(fb) < tolerance:\n        return round(b, 2)\n\n    # Perform bisection to find a root.\n    for _ in range(max_iterations):\n        mid = (a + b) / 2.0\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < tolerance:\n            return round(mid, 2)\n\n        # Update the interval based on the signs of f_mid and fa.\n        if fa * f_mid < 0:\n            b = mid\n            fb = f_mid\n        else:\n            a = mid\n            fa = f_mid\n\n    # If maximum iterations are reached, return the midpoint of the final interval.\n    return round((a + b) / 2.0, 2)"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Generator\ndef is_prime(num: int) -> bool:\n    # Checks if a given number is prime using trial division.\\n\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # Initialize count for prime Fibonacci numbers found.\\n\n    prime_fib_count = 0\n    fib_generator = generate_fibonacci()\n\n    # Skip initial Fibonacci numbers 0, 1, 1 as per problem definition.\\n\n    next(fib_generator) # 0\n    next(fib_generator) # 1\n    next(fib_generator) # 1\n\n    while True:\n        current_fib = next(fib_generator)\n        if is_prime(current_fib):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return current_fib"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes an encoded string and returns its decoded form.\n    Reverses the cyclic shift applied by encode_cyclic.\n    \"\"\"\n\n    def _reverse_cycle_group(group: str) -> str:\n        \"\"\"Reverses the cyclic shift for a group of three characters.\"\"\"\n        if len(group) < 3:\n            return group\n        # Original: char0 char1 char2\n        # Encoded:  char1 char2 char0\n        return group[2] + group[0] + group[1]\n\n    decoded_parts = []\n    for i in range(0, len(s), 3):\n        group = s[i:i+3]\n        decoded_parts.append(_reverse_cycle_group(group))\n\n    return \"\".join(decoded_parts)"}
