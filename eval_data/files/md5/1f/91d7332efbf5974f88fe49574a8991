{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is defined as fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0,\n    and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3.\n    This function efficiently computes the n-th element iteratively.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four values, corresponding to fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        # Shift the values: b becomes a, c becomes b, d becomes c, and next_fib4 becomes d\n        a, b, c, d = b, c, d, next_fib4\n\n    return d"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    This function avoids recursion and handles base cases directly.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the first four values: a=fib4(i-4), b=fib4(i-3), c=fib4(i-2), d=fib4(i-1)\n    a, b, c, d = 0, 0, 2, 0 # Corresponds to fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        # Shift values for the next iteration\n        a, b, c, d = b, c, d, next_fib4\n    return d"}
{"task_id": "HumanEval/48", "solution": "import re\ndef is_palindrome(text: str) -> bool:\n    \"\"\"Checks if a given string is a palindrome, ignoring case and non-alphanumeric characters.\n    An empty string is considered a palindrome.\"\"\"\n\n    # Normalize the string by converting to lowercase and removing non-alphanumeric characters.\n    normalized_text = re.sub(r'[^a-z0-9]', '', text.lower())\n\n    # Compare the normalized string with its reverse.\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/48", "solution": "import re\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if a string is a palindrome, ignoring case and non-alphanumeric characters.\n    It returns True if the string reads the same forwards and backward.\n    \"\"\"\n    # Normalize the string: convert to lowercase and remove non-alphanumeric characters.\n    normalized_text = re.sub(r'[^a-z0-9]', '', text.lower())\n\n    # Check if the normalized string is equal to its reverse.\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements: return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements: return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
