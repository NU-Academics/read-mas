{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then commas, or counting odd-ordered lowercase letters.\n    Alphabetical order starts from 0 for 'a'.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"\n    Validates a date string against predefined rules.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    # Regex for 'mm-dd-yyyy' format, ensuring digits for month/day/year.\n    # It checks month 01-12 and day 01-31, but specific day limits per month are checked later.\n    DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$\"\n\n    match = re.match(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    parts = date.split('-')\n    month = int(parts[0])\n    day = int(parts[1])\n\n    # Day validation based on month rules.\n    MONTH_DAYS_31 = [1, 3, 5, 7, 8, 10, 12]\n    MONTH_DAYS_30 = [4, 6, 9, 11]\n    MONTH_DAYS_29 = [2] # February, max 29 days\n\n    if month in MONTH_DAYS_31:\n        if not (1 <= day <= 31):\n            return False\n    elif month in MONTH_DAYS_30:\n        if not (1 <= day <= 30):\n            return False\n    elif month in MONTH_DAYS_29: # February\n        if not (1 <= day <= 29):\n            return False\n    else:\n        # This case handles months outside 1-12, though the regex should prevent it.\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace or commas, or counts odd-ordered lowercase letters.\n    Whitespace splitting takes precedence over comma splitting.\n    \"\"\"\n\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n\n    if has_whitespace:\n        return txt.split()\n\n    if ',' in txt:\n        return txt.split(',')\n\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of odd numbers in its Collatz sequence.\n    The sequence is generated by halving even numbers or multiplying odd numbers by 3 and adding 1, until 1 is reached.\n    \"\"\"\n\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    # Filter out only the odd numbers from the generated sequence.\n    odd_numbers = [num for num in sequence if num % 2 != 0]\n\n    # Sort the list of odd numbers and return it.\n    return sorted(odd_numbers)"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"Checks if a list is sorted ascendingly and if no number appears more than twice.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    # Check if the list is sorted in ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate counts; no number should appear more than twice.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted in ascending order.\n    Also, returns False if any number appears more than twice.\n    \"\"\"\n    if not lst or len(lst) == 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for more than two occurrences of any number\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string according to 'mm-dd-yyyy' format and calendar rules.\"\"\"\n\n    # FR1: The system shall validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # FR2: The system shall validate that the date string adheres to the 'mm-dd-yyyy' format.\n    if len(date) != 10 or date[2] != '-' or date[5] != '-':\n        return False\n\n    try:\n        month = int(date[0:2])\n        day = int(date[3:5])\n        year = int(date[6:10])\n    except ValueError:\n        # If any part (month, day, year) cannot be converted to an integer, format is incorrect.\n        return False\n\n    # FR3: The system shall validate that the month component is between 1 and 12 (inclusive).\n    if not (1 <= month <= 12):\n        return False\n\n    # Helper function for leap year, defined inline as per constraints.\n    def _is_leap_year(yr):\n        return (yr % 4 == 0 and yr % 100 != 0) or (yr % 400 == 0)\n\n    # FR4: The system shall validate the day component based on the month and year.\n    if not (1 <= day): # Day cannot be zero or negative.\n        return False\n\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if day > 31:\n            return False\n    elif month in [4, 6, 9, 11]:\n        if day > 30:\n            return False\n    elif month == 2: # February\n        max_days_february = 29 if _is_leap_year(year) else 28\n        if day > max_days_february:\n            return False\n\n    # All validation checks passed.\n    return True"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    total_magnitude = 0\n    product_of_signs = 1\n\n    for num in arr:\n        # Calculate magnitude (absolute value)\n        total_magnitude += abs(num)\n\n        # Determine sign of the number\n        current_sign = 0\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n\n        # Multiply signs\n        product_of_signs *= current_sign\n\n    return total_magnitude * product_of_signs"}
{"task_id": "HumanEval/127", "solution": "import math\ndef intersection(interval1, interval2):\n    \"\"\"\n    You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start > min_end:\n        return \"NO\"\n\n    intersection_length = min_end - max_start\n\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty input array as specified.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number (FR1)\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n\n        # Calculate magnitude (absolute value) (FR2)\n        current_magnitude = abs(num)\n\n        # Update product of signs (FR3)\n        product_of_signs *= current_sign\n\n        # Update sum of magnitudes (FR4)\n        sum_of_magnitudes += current_magnitude\n\n    # Compute the final result (FR5)\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Uses memoization to avoid redundant computations for efficiency.\"\"\"\n\n    memo = {}\n\n    def _get_tri_value(k: int) -> float:\n        \"\"\"Internal helper to compute tri(k) with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            value = 1.0\n        elif k == 1:\n            value = 3.0\n        elif k % 2 == 0:  # k is even and k > 0\n            value = 1.0 + k / 2.0\n        else:  # k is odd and k > 1\n            # tri(k+1) uses the even rule since k+1 is always even\n            tri_k_plus_1 = 1.0 + (k + 1) / 2.0\n            value = _get_tri_value(k - 1) + _get_tri_value(k - 2) + tri_k_plus_1\n\n        memo[k] = value\n        return value\n\n    sequence = []\n    # Loop from 0 to n (inclusive) to get n + 1 numbers\n    for i in range(n + 1):\n        sequence.append(_get_tri_value(i))\n\n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits. If no odd digits are found, return 0.\"\"\"\n    product = 1\n    has_odd_digit = False\n\n    s_n = str(n)\n    for digit_char in s_n:\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n\n    if not has_odd_digit:\n        return 0\n\n    return product"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    Memoization is used to prevent redundant computations.\n    \"\"\"\n    memo = {\n        0: 1,  # tri(0) base case\n        1: 3   # tri(1) base case\n    }\n\n    # The maximum index for which an even term might be needed.\n    # This accounts for the tri(n+1) dependency for odd n.\n    upper_bound_for_even_terms = n + 1 if n % 2 != 0 else n\n\n    # Calculate all even terms in ascending order up to the determined upper bound.\n    for i in range(2, upper_bound_for_even_terms + 1):\n        if i % 2 == 0:\n            memo[i] = 1 + i // 2\n\n    # Calculate odd terms in descending order from n down to 3.\n    # This ensures that tri(i+1) (which is even) is already in memo.\n    for i in range(n, 1, -1):\n        if i % 2 != 0:\n            memo[i] = memo[i - 1] + memo[i - 2] + memo[i + 1]\n\n    # Compile the result list of the first n+1 Tribonacci numbers.\n    result = [memo[i] for i in range(n + 1)]\n    return result"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if no odd digits are present in n.\"\"\"\n    product = 1\n    has_odd_digit = False\n\n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            has_odd_digit = True\n        temp_n //= 10\n\n    if not has_odd_digit:\n        return 0\n    return product"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple\nclass Cell:\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\nclass Path:\n    def __init__(self, values: List[int], last_row: int, last_col: int):\n        self.values = values\n        self.last_row = last_row\n        self.last_col = last_col\n\n    def add_step(self, cell: Cell) -> 'Path':\n        \"\"\"Returns a new Path instance by extending the current path with the given cell.\"\"\"\n        new_values = self.values + [cell.value]\n        return Path(new_values, cell.row, cell.col)\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison for Path objects.\"\"\"\n        return self.values < other.values\nclass Grid:\n    def __init__(self, grid_values: List[List[int]]):\n        self._values = grid_values\n        self._N = len(grid_values)\n\n    def get_value(self, row: int, col: int) -> int:\n        return self._values[row][col]\n\n    def get_N(self) -> int:\n        return self._N\nclass GridUtils:\n    @staticmethod\n    def is_valid_coordinate(row: int, col: int, N: int) -> bool:\n        return 0 <= row < N and 0 <= col < N\n\n    @staticmethod\n    def get_neighbors(row: int, col: int, N: int) -> List[Tuple[int, int]]:\n        neighbors = []\n        DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n        for dr, dc in DIRECTIONS:\n            n_row, n_col = row + dr, col + dc\n            if GridUtils.is_valid_coordinate(n_row, n_col, N):\n                neighbors.append((n_row, n_col))\n        return neighbors\nclass PathFinderService:\n    _DIRECTIONS: List[Tuple[int, int]] = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Attribute as per design\n\n    def find_min_path(self, grid_values: List[List[int]], k: int) -> List[int]:\n        \"\"\"Initializes a priority queue and explores paths using a Dijkstra-like approach.\n        Returns the lexicographically smallest path of length `k`.\n        \"\"\"\n        grid = Grid(grid_values)\n        N = grid.get_N()\n\n        pq: List[Path] = [] # Priority queue stores Path objects\n\n        # Initialize with all possible starting cells\n        for r in range(N):\n            for c in range(N):\n                initial_value = grid.get_value(r, c)\n                heapq.heappush(pq, Path([initial_value], r, c))\n\n        min_path_found: List[int] = []\n\n        while pq:\n            current_path = heapq.heappop(pq)\n\n            # If path length is k, we've found a candidate.\n            # The first path of length k extracted is the lexicographically smallest.\n            if len(current_path.values) == k:\n                min_path_found = current_path.values\n                break # Guaranteed unique answer, so we can stop\n\n            # If path length is less than k, explore neighbors\n            for next_row, next_col in GridUtils.get_neighbors(current_path.last_row, current_path.last_col, N):\n                next_value = grid.get_value(next_row, next_col)\n                next_cell = Cell(next_row, next_col, next_value)\n                new_path = current_path.add_step(next_cell)\n                heapq.heappush(pq, new_path)\n\n        return min_path_found\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the given grid.\n    \"\"\"\n    service = PathFinderService()\n    return service.find_min_path(grid, k)"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Check if the length of the intersection of two intervals is a prime number.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    # Calculate the intersection points.\n    max_start = max(s1, s2)\n    min_end = min(e1, e2)\n\n    length = 0.0\n    # Calculate the length of the intersection if it exists.\n    if max_start <= min_end:\n        length = float(min_end - max_start)\n\n    # Determine if the integer part of the length is prime.\n    if is_prime(int(length)):\n        return 'YES'\n    else:\n        return 'NO'"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Returns the sum of squared numbers from a list, after rounding each number up to the nearest integer.\n    For example, `[1.4, 4.2, 0]` becomes `29` (ceil(1.4)=2, ceil(4.2)=5, ceil(0)=0; 2^2 + 5^2 + 0^2 = 4 + 25 + 0 = 29).\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of squares for numbers in a list, after rounding each up to the nearest integer.\n    Assumes valid numerical inputs in the list.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and not part of a word.\n    A character is \"not part of a word\" if it's a single letter or preceded by a space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # If it's a single letter string, it's not part of a word.\n    if len(txt) == 1:\n        return True\n\n    # Check the character before the last one.\n    char_before_last = txt[-2]\n    return char_before_last == ' '"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Finds the largest index i where arr[i] < arr[i-1].\n    Returns -1 if no such index exists.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a string is an alphabetical\n    character and is not part of a word, and False otherwise.\n    A \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    elif txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index i where arr[i] is strictly less than arr[i-1].\n    Returns -1 if no such index is found.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    # Iterate from right to left, starting from the second to last element.\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), with None if either is not found.\n    '''\n    negative_integers = [n for n in lst if n < 0]\n    positive_integers = [n for n in lst if n > 0]\n\n    largest_negative = max(negative_integers) if negative_integers else None\n    smallest_positive = min(positive_integers) if positive_integers else None\n\n    return largest_negative, smallest_positive"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive) or None if not found.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for item in lst:\n        # Update largest negative if current item is negative and larger\n        if item < 0:\n            if largest_negative is None or item > largest_negative:\n                largest_negative = item\n        # Update smallest positive if current item is positive and smaller\n        elif item > 0:\n            if smallest_positive is None or item < smallest_positive:\n                smallest_positive = item\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    \"\"\"\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    \"\"\"\n    def _is_valid_bracket_sequence(sub_string: str) -> bool:\n        \"\"\"\n        Determines if a given substring of brackets is a valid bracket sequence.\n        Balance increases for '[' and decreases for ']'; must not go negative and end at zero.\n        \"\"\"\n        balance = 0\n        for char in sub_string:\n            if char == '[':\n                balance += 1\n            elif char == ']':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    n = len(string)\n    if n < 4:  # Minimum length for a nested sequence like '[[]]'\n        return False\n\n    # Iterate through all possible combinations of four indices\n    for outer_open_idx in range(n):\n        if string[outer_open_idx] != '[':\n            continue\n        for outer_close_idx in range(outer_open_idx + 1, n):\n            if string[outer_close_idx] != ']':\n                continue\n\n            # FR1.4: Check if the substring string[outer_open_idx+1 : outer_close_idx] forms a valid bracket sequence.\n            if not _is_valid_bracket_sequence(string[outer_open_idx + 1 : outer_close_idx]):\n                continue\n\n            for inner_open_idx in range(outer_open_idx + 1, outer_close_idx): # outer_open_idx < inner_open_idx\n                if string[inner_open_idx] != '[':\n                    continue\n                for inner_close_idx in range(inner_open_idx + 1, outer_close_idx): # inner_open_idx < inner_close_idx < outer_close_idx\n                    if string[inner_close_idx] != ']':\n                        continue\n\n                    # FR1.3: Check if the substring string[inner_open_idx+1 : inner_close_idx] forms a valid bracket sequence.\n                    if _is_valid_bracket_sequence(string[inner_open_idx + 1 : inner_close_idx]):\n                        return True # Both conditions (FR1.3 and FR1.4) are met\n\n    return False"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values and returns the larger variable in its original type.\n    Returns None if the values are equal, handling string number representations with ',' or '.'\n    \"\"\"\n\n    def _normalize_to_float_local(value):\n        \"\"\"Helper to convert value to float, handling string decimal separators.\"\"\"\n        if isinstance(value, str):\n            # Replace comma with dot; Python's float() will raise ValueError for unparseable strings.\n            return float(value.replace(',', '.'))\n        return float(value)\n\n    float_a = _normalize_to_float_local(a)\n    float_b = _normalize_to_float_local(b)\n\n    if float_a == float_b:\n        return None\n    elif float_a > float_b:\n        return a\n    else:\n        return b"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Optional[Union[int, float, str]]:\n    \"\"\"\n    Compares two values (int, float, or string numbers) and returns the larger one\n    in its original type, or None if they are numerically equal.\n    \"\"\"\n\n    def _normalize_value(val: Union[int, float, str]) -> float:\n        \"\"\"Converts the input value to a float, handling string numeric representations with commas.\"\"\"\n        s_val = str(val)\n        normalized_s = s_val.replace(',', '.')\n        return float(normalized_s)\n\n    normalized_a = _normalize_value(a)\n    normalized_b = _normalize_value(b)\n\n    if normalized_a > normalized_b:\n        return a\n    elif normalized_b > normalized_a:\n        return b\n    else: # normalized_a == normalized_b\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    This is true for any even integer n >= 8.\n    \"\"\"\n    # The smallest sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    if n < 8:\n        return False\n\n    # The sum of 4 even numbers must always be an even number.\n    if n % 2 != 0:\n        return False\n\n    # Any even number n >= 8 can be represented as (n-6) + 2 + 2 + 2, where (n-6) is also a positive even number.\n    return True"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # The smallest sum of 4 positive even numbers (2+2+2+2) is 8.\n    # Any such sum must also be an even number.\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Parameter 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Parameter 'n' must be a positive integer.\")\n\n    def _calculate_standard_factorial(k: int) -> int:\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        factorial = 1\n        for i in range(1, k + 1):\n            factorial *= i\n        return factorial\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _calculate_standard_factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n    if k == 0:\n        return 1\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        single_fact = _factorial(i)\n        special_fact_result *= single_fact\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # First, handle multiple spaces (2 or more) with a hyphen\n    processed_text = re.sub(r' {2,}', '-', text)\n\n    # Then, handle single spaces with an underscore\n    # The order is crucial: replace multiple spaces first, then single spaces.\n    # This ensures that '  ' (two spaces) is replaced by '-' and not '__'.\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    '''\n\n    def is_valid_bracket_sequence(s: str) -> bool:\n        \"\"\"\n        Checks if a given string of square brackets forms a valid bracket sequence.\n        An empty string is considered a valid bracket sequence.\n        \"\"\"\n        stack = []\n        for char in s:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    open_brackets_indices = []\n    for i, char in enumerate(string):\n        if char == '[':\n            # When an opening bracket is found, push its index onto the stack\n            open_brackets_indices.append(i)\n        elif char == ']':\n            # When a closing bracket is found\n            if open_brackets_indices:\n                # If there's an unmatched opening bracket on the stack\n                open_idx = open_brackets_indices.pop()\n\n                # The problem defines \"nested\" as a valid subsequence [A] where A is non-empty and valid.\n                # This translates to finding an outer '[' at `open_idx` and an outer ']' at `i`\n                # such that the *substring* between them (`string[open_idx + 1 : i]`) is a\n                # non-empty and valid bracket sequence.\n                inner_substring = string[open_idx + 1:i]\n\n                # Check if the inner substring is non-empty and itself a valid bracket sequence\n                if inner_substring and is_valid_bracket_sequence(inner_substring):\n                    return True\n\n    # If no such nested and valid subsequence is found after checking all possible pairs\n    return False"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces sequences of three or more spaces with a hyphen.\n    Then replaces all remaining single spaces with underscores.\n    \"\"\"\n    import re\n\n    # Replace 3 or more consecutive spaces with a single hyphen\n    processed_text = re.sub(r' {3,}', '-', text)\n    # Replace any remaining single spaces (including those from '  ') with underscores\n    processed_text = processed_text.replace(' ', '_')\n    return processed_text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n\n    # Rule 1: No more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 2: The file's name contains exactly one dot '.'.\n    dot_count = 0\n    for char in file_name:\n        if char == '.':\n            dot_count += 1\n    if dot_count != 1:\n        return 'No'\n\n    # Split the filename into prefix and extension.\n    # This is safe because we've confirmed exactly one dot.\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule 3: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n\n    # Rule 4: The substring before the dot starts with a letter from the latin alphabet.\n    first_char_prefix = prefix[0]\n    if not ('a' <= first_char_prefix <= 'z' or 'A' <= first_char_prefix <= 'Z'):\n        return 'No'\n\n    # Rule 5: The substring after the dot should be one of the allowed extensions.\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # If all validation conditions are met.\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst: list[int]) -> int:\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    if not lst:\n        return 0\n\n    modified_elements = []\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            modified_elements.append(entry * entry)\n        elif i % 4 == 0:  # This condition implicitly means i % 3 != 0 due to the preceding if.\n            modified_elements.append(entry * entry * entry)\n        else:\n            modified_elements.append(entry)\n\n    return sum(modified_elements)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    def _count_digits(name: str) -> int:\n        \"\"\"Counts the number of digits in the given string.\"\"\"\n        return sum(1 for char in name if '0' <= char <= '9')\n\n    def _has_valid_digit_count(name: str) -> bool:\n        \"\"\"Checks if the file name has no more than three digits.\"\"\"\n        return _count_digits(name) <= 3\n\n    def _has_exactly_one_dot(name: str) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return name.count('.') == 1\n\n    def _get_prefix_and_suffix(name: str) -> tuple[str, str]:\n        \"\"\"Splits the file name into its prefix and suffix.\"\"\"\n        # Assumes exactly one dot, as per design.\n        parts = name.rsplit('.', 1)\n        return parts[0], parts[1]\n\n    def _has_valid_prefix(prefix: str) -> bool:\n        \"\"\"Checks if the prefix is not empty and starts with a Latin alphabet letter.\"\"\"\n        if not prefix:\n            return False\n        first_char = prefix[0]\n        return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n    def _has_valid_suffix(suffix: str) -> bool:\n        \"\"\"Checks if the suffix is one of the allowed extensions.\"\"\"\n        return suffix in ALLOWED_EXTENSIONS\n\n    if not _has_valid_digit_count(file_name):\n        return 'No'\n\n    if not _has_exactly_one_dot(file_name):\n        return 'No'\n\n    prefix, suffix = _get_prefix_and_suffix(file_name)\n\n    if not _has_valid_prefix(prefix):\n        return 'No'\n\n    if not _has_valid_suffix(suffix):\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"Filters words in a sentence, keeping only those whose lengths are prime numbers.\n    Preserves original word order and joins results with spaces.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if an integer `n` is a prime number.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    modified_sum = 0\n    for i, element in enumerate(lst):\n        if i % 3 == 0:\n            modified_sum += element * element\n        elif i % 4 == 0:\n            modified_sum += element * element * element\n        else:\n            modified_sum += element\n    return modified_sum"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"Filters words from a sentence, keeping only those with prime lengths.\n    The order of words is maintained in the output string.\"\"\"\n    words = sentence.split(' ')\n    prime_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_words.append(word)\n    return ' '.join(prime_words)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def get_numerator(self) -> int:\n        return self.numerator\n\n    def get_denominator(self) -> int:\n        return self.denominator\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}/{self.denominator})\"\nclass FractionService:\n    def parse_fraction(self, fraction_str: str) -> Fraction:\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    def multiply_fractions(self, f1: Fraction, f2: Fraction) -> Fraction:\n        new_numerator = f1.get_numerator() * f2.get_numerator()\n        new_denominator = f1.get_denominator() * f2.get_denominator()\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self, f: Fraction) -> bool:\n        return f.get_numerator() % f.get_denominator() == 0\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Simplifies the expression x * n and returns True if it evaluates to a whole number,\n    False otherwise. Both x and n are string representations of fractions.\n    \"\"\"\n    service = FractionService()\n    fraction_x = service.parse_fraction(x)\n    fraction_n = service.parse_fraction(n)\n\n    product_fraction = service.multiply_fractions(fraction_x, fraction_n)\n\n    return service.is_whole_number(product_fraction)"}
{"task_id": "HumanEval/145", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute value of digits of an integer.\n    The sum is based on the absolute value to handle negative numbers consistently.\"\"\"\n    s = 0\n    for digit in str(abs(n)):\n        s += int(digit)\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts the given list of integers by the sum of their digits in ascending order.\n    Ties are broken by the original index of the numbers.\"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        decorated_list.append((_sum_digits(num), i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/146", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is an odd number (1, 3, 5, 7, 9).\"\"\"\n    return digit in (1, 3, 5, 7, 9)\ndef _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n    abs_num = abs(num)\n    if abs_num == 0:\n        return 0\n    while abs_num >= 10:\n        abs_num //= 10\n    return abs_num\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n    return abs(num) % 10\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers greater than 10 where both the first and last digits are odd.\n    This function applies specific numerical and digit-based criteria.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"Sorts a list of integers by the sum of their digits, maintaining original relative order for ties.\n    Returns a new list with sorted integers.\"\"\"\n\n    def calculate_sum(number: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of the digits of an integer.\n        For example, calculate_sum(-123) would return 6.\"\"\"\n        s = 0\n        num_abs = abs(number)\n        while num_abs > 0:\n            s += num_abs % 10\n            num_abs //= 10\n        return s\n\n    if not nums:\n        return []\n\n    # Create tuples (digit_sum, original_index, number) to facilitate stable sorting.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = calculate_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sorts the decorated list. Python's Timsort is stable and sorts tuples lexicographically.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted tuples.\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and denominator.\"\"\"\n\n    @staticmethod\n    def _gcd(a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string like \"num/den\" into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return cls(numerator, denominator)\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number after simplification.\"\"\"\n        common_divisor = Fraction._gcd(self.numerator, self.denominator)\n        simplified_denominator = self.denominator // common_divisor\n        return simplified_denominator == 1\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def _combinations(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates 'n choose k'. Returns 0 if k > n or k < 0.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    count_mod_0 = 0  # Count of a[i] where a[i] % 3 == 0\n    count_mod_1 = 0  # Count of a[i] where a[i] % 3 == 1\n\n    # a[i] = i*i - i + 1.\n    # a[i] % 3 == 0 if i % 3 == 2.\n    # a[i] % 3 == 1 if i % 3 == 0 or i % 3 == 1.\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_mod_0 += 1\n        else: # i % 3 == 0 or i % 3 == 1\n            count_mod_1 += 1\n\n    # Triples (a[i], a[j], a[k]) sum to a multiple of 3 if:\n    # (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # Only combinations (0,0,0) and (1,1,1) satisfy this.\n    triples_from_mod_0 = _combinations(count_mod_0, 3)\n    triples_from_mod_1 = _combinations(count_mod_1, 3)\n\n    return triples_from_mod_0 + triples_from_mod_1"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Accepts a list of strings, deletes strings with odd lengths,\n    and returns the result sorted by length (ascending) then alphabetically.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    even_length_strings.sort(key=lambda s: (len(s), s))\n    return even_length_strings"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a'\n    where their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    arr = []\n    for x in range(1, n + 1):\n        arr.append(x * x - x + 1)\n\n    arr_mod_3 = [val % 3 for val in arr]\n\n    count = 0\n    num_elements = len(arr)\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements):\n            for k in range(j + 1, num_elements):\n                if (arr_mod_3[i] + arr_mod_3[j] + arr_mod_3[k]) % 3 == 0:\n                    count += 1\n\n    return count"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Identifies planets located between two specified planets in our solar system.\n    Returns an empty tuple if inputs are invalid or no planets are found between them.\n    \"\"\"\n    PLANET_ORDER = (\n        \"mercury\", \"venus\", \"earth\", \"mars\", \"jupiter\", \"saturn\", \"uranus\", \"neptune\"\n    )\n\n    normalized_planet1 = planet1.lower()\n    normalized_planet2 = planet2.lower()\n\n    try:\n        idx1 = PLANET_ORDER.index(normalized_planet1)\n    except ValueError:\n        idx1 = None\n\n    try:\n        idx2 = PLANET_ORDER.index(normalized_planet2)\n    except ValueError:\n        idx2 = None\n\n    if idx1 is None or idx2 is None:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    if end_idx - start_idx <= 1:\n        return ()\n\n    between_planets = []\n    for i in range(start_idx + 1, end_idx):\n        between_planets.append(PLANET_ORDER[i].capitalize())\n\n    return tuple(between_planets)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Accepts a list of strings, deletes strings with odd lengths,\n    and returns the result sorted by length then alphabetically.\n    \"\"\"\n    # Filter out strings with odd lengths, keeping only those with even lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list first by string length (ascending), then alphabetically (ascending).\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_list"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either input planet name is incorrect.\n    \"\"\"\n    # Define the ordered list of planets.\n    SOLAR_SYSTEM_PLANETS = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    # Helper function to get the 0-based index of a planet.\n    def _get_planet_index(planet_name):\n        try:\n            return SOLAR_SYSTEM_PLANETS.index(planet_name)\n        except ValueError:\n            return -1\n\n    index1 = _get_planet_index(planet1)\n    index2 = _get_planet_index(planet2)\n\n    # If either planet name is invalid, return an empty tuple.\n    if index1 == -1 or index2 == -1:\n        return ()\n\n    # Determine the slice boundaries, ensuring they are strictly between the inputs.\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    return SOLAR_SYSTEM_PLANETS[start_index + 1:end_index]"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares for numbers in the list that are positive and odd.\n    Numbers that are not positive are ignored.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for item in lst:\n        # Check if the item is positive and odd, without explicit type checking.\n        if item > 0 and item % 2 != 0:\n            total_sum += item * item\n    return total_sum"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns the value of x if n is prime, and y otherwise.\"\"\"\n\n    def is_prime_helper(num):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime_helper(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    def _is_prime(num):\n        # Checks if a number is prime using trial division up to its square root.\n        # Handles 1, 2, and even numbers, then iterates through odd divisors.\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if not isinstance(game, list) or not isinstance(guess, list):\n        raise ValueError(\"Input 'game' and 'guess' must be lists.\")\n\n    if len(game) != len(guess):\n        raise ValueError(\"Game scores and guess scores arrays must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n\n        if not isinstance(game_score, int) or not isinstance(guess_score, int):\n            raise ValueError(\"All scores in 'game' and 'guess' must be integers.\")\n\n        differences.append(abs(game_score - guess_score))\n    return differences"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Determines how far off each guess was for a series of matches.\n    Returns 0 for correct guesses and the absolute difference otherwise.\n    \"\"\"\n    return [abs(actual - predicted) for actual, predicted in zip(game, guess)]"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum_of_squares = 0\n    for item in lst:\n        # Check if the item is an integer, positive, and odd\n        if isinstance(item, int) and item > 0 and item % 2 != 0:\n            total_sum_of_squares += item * item\n    return total_sum_of_squares"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension for a given class name.\n    Strength is CAP - SM; ties are broken by first appearance.\n    \"\"\"\n\n    def _calculate_strength(text: str) -> int:\n        \"\"\"Calculates strength from uppercase and lowercase character counts.\"\"\"\n        cap_count = sum(1 for char in text if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in text if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    if not extensions:\n        # As per design specification, if extensions list is empty, return only the class name.\n        return class_name\n\n    strongest_ext_name = \"\"\n    max_strength = -float('inf') # Initialize with a very low strength\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n\n        # Update if a new extension is strictly stronger.\n        # Tie-breaking by 'first in list' is implicitly handled by not updating\n        # if current_strength == max_strength.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    Returns True if found, False otherwise.\n    \"\"\"\n    if not b: # An empty string is a substring of any string.\n        return True\n    if len(b) > len(a):\n        return False\n\n    # Generate all rotations of b by concatenating b with itself.\n    # Then check if any substring of length len(b) from the doubled string exists in a.\n    doubled_b = b + b\n\n    for i in range(len(b)):\n        rotation = doubled_b[i : i + len(b)]\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    # If the pattern string is empty, it's considered a substring of any target.\n    if not b:\n        return True\n\n    rotations = []\n    n = len(b)\n    # Generate all cyclic rotations of the pattern string.\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.append(rotated_b)\n\n    # Check if any unique rotation is a substring of the target string.\n    for rotation in set(rotations):\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/153", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional\nclass ExtensionStrengthCalculator:\n    \"\"\"\n    Calculates the strength of a single extension string.\n    Strength is defined as (uppercase letters) - (lowercase letters).\n    \"\"\"\n    def calculate(self, extension_name: str) -> int:\n        uppercase_count = sum(1 for char in extension_name if char.isupper())\n        lowercase_count = sum(1 for char in extension_name if char.islower())\n        return uppercase_count - lowercase_count\nclass StrongestExtensionFinder:\n    \"\"\"\n    Finds the strongest extension from a list of ExtensionInfo objects.\n    Resolves ties by choosing the first occurring extension in the list.\n    \"\"\"\n    def find(self, extensions_info: List[ExtensionInfo]) -> Optional[ExtensionInfo]:\n        if not extensions_info:\n            return None\n\n        strongest_info: Optional[ExtensionInfo] = None\n        max_strength = float('-inf')\n\n        for info in extensions_info:\n            if info.strength > max_strength:\n                max_strength = info.strength\n                strongest_info = info\n\n        return strongest_info\nclass StrongestExtensionService:\n    \"\"\"\n    Orchestrates finding the strongest extension and formatting the output.\n    It uses a calculator for strength and a finder for selection.\n    \"\"\"\n    def __init__(self, calculator: ExtensionStrengthCalculator, finder: StrongestExtensionFinder) -> None:\n        self._calculator = calculator\n        self._finder = finder\n\n    def get_strongest_extension(self, class_name: str, extensions: List[str]) -> str:\n        all_extensions_info: List[ExtensionInfo] = []\n        for ext_name in extensions:\n            strength = self._calculator.calculate(ext_name)\n            all_extensions_info.append(ExtensionInfo(name=ext_name, strength=strength))\n\n        strongest_ext_info = self._finder.find(all_extensions_info)\n\n        strongest_ext_name = strongest_ext_info.name if strongest_ext_info else \"None\"\n        return f\"{class_name}.{strongest_ext_name}\"\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class.\n    \"\"\"\n    calculator = ExtensionStrengthCalculator()\n    finder = StrongestExtensionFinder()\n    service = StrongestExtensionService(calculator, finder)\n    return service.get_strongest_extension(class_name, extensions)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"\n    Counts the occurrences of even and odd digits in an integer.\n    Handles negative numbers by using their absolute value and treats 0 as an even digit.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)\n\n    abs_num = abs(num)\n    num_str = str(abs_num)\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n\n    # Handle negative numbers by taking absolute value\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        # Check if digit is even or odd (0 is considered even)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n]\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    The function assumes valid input within the specified range for direct conversion.\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    roman_numeral_parts = []\n    num = number\n    for value, symbol in roman_map:\n        while num >= value:\n            roman_numeral_parts.append(symbol)\n            num -= value\n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the maximum number of unique characters from a list.\n    If ties exist, the lexicographically smallest string is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        # Calculate the number of unique characters in the current word.\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # For ties, choose the lexicographically smaller word.\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/157", "solution": "class InvalidSideLengthError(ValueError):\n    \"\"\"Custom exception for invalid triangle side lengths.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    if not all(isinstance(side, (int, float)) and side > 0 for side in [a, b, c]):\n        raise InvalidSideLengthError(\"All side lengths must be positive numbers.\")\n\n    sides = sorted([a, b, c])\n    # Check Pythagorean theorem: a^2 + b^2 = c^2\n    # Using a small tolerance for floating point comparisons to handle floating-point arithmetic inaccuracies\n    return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < 1e-9"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    Resolves ties by returning the lexicographically smallest string.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/157", "solution": "from math import isclose\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    EPSILON = 1e-9  # Tolerance for floating-point comparisons as per NFR1\n\n    # FR1: The system shall accept three numerical inputs\n    # FR2: The system shall validate that all three inputs are positive numbers.\n    # NFR3: Robustness - handle invalid inputs gracefully\n    if not all(isinstance(s, (int, float)) for s in [a, b, c]):\n        raise TypeError(\"Side lengths must be numeric.\")\n    if not (a > 0 and b > 0 and c > 0):\n        # Using ValueError as per the spirit of InvalidSideLengthError in design\n        raise ValueError(\"Side lengths must be positive.\")\n\n    # Sort sides to easily identify the potential hypotenuse (longest side)\n    sides = sorted([a, b, c])\n\n    # Calculate the squares of the sides\n    a_sq = sides[0] ** 2\n    b_sq = sides[1] ** 2\n    c_sq = sides[2] ** 2\n\n    # FR3: Apply the Pythagorean theorem\n    # Check if a^2 + b^2 is approximately equal to c^2 using tolerance\n    return isclose(a_sq + b_sq, c_sq, rel_tol=EPSILON)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and carrots left after a rabbit's meal.\n    The rabbit eats as much as it needs or all available carrots if stock is low.\n    \"\"\"\n    eaten_this_meal = min(need, remaining)\n\n    total_eaten = number + eaten_this_meal\n    carrots_left = remaining - eaten_this_meal\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining carrots after a rabbit's meal.\n    The rabbit eats the minimum of its need or available stock.\n    \"\"\"\n    carrots_to_eat_from_stock = min(need, remaining)\n    total_eaten = number + carrots_to_eat_from_stock\n    carrots_left = remaining - carrots_to_eat_from_stock\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms a string by reversing letter cases or reversing the whole string if no letters are present.\n    Non-letter characters remain unchanged in case reversal mode.\n    \"\"\"\n\n    def _is_letter(char: str) -> bool:\n        \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _reverse_char_case(char: str) -> str:\n        \"\"\"Reverses the case of a single letter character.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char\n\n    # Check if the input string contains any letter characters\n    has_letters = False\n    for char in s:\n        if _is_letter(char):\n            has_letters = True\n            break\n\n    if not has_letters:\n        # If no letters found, reverse the entire string\n        return s[::-1]\n    else:\n        # If letters are found, reverse the case of letter characters\n        transformed_chars = []\n        for char in s:\n            if _is_letter(char):\n                transformed_chars.append(_reverse_char_case(char))\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    VALID_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    if not isinstance(operator, list) or not all(isinstance(op, str) for op in operator):\n        raise ValueError(\"Operator list must be a list of strings.\")\n    if not isinstance(operand, list) or not all(isinstance(op, int) and op >= 0 for op in operand):\n        raise ValueError(\"Operand list must be a list of non-negative integers.\")\n\n    if len(operator) < 1:\n        raise ValueError(\"Operator list must have at least one operator.\")\n    if len(operand) < 2:\n        raise ValueError(\"Operand list must have at least two operands.\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"Length of operator list must be equal to length of operand list minus one.\")\n\n    for op in operator:\n        if op not in VALID_OPERATORS:\n            raise ValueError(f\"Invalid operator found: '{op}'. Allowed operators are {', '.join(VALID_OPERATORS)}.\")\n\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_string = \" \".join(expression_parts)\n\n    try:\n        result = eval(expression_string)\n        return int(result)\n    except (SyntaxError, TypeError, ZeroDivisionError) as e:\n        raise ValueError(f\"Error evaluating expression: {e}\")"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Manipulates a string by reversing letter cases or reversing the whole string.\n    If no letters are present, the entire string is reversed; otherwise, letter cases are flipped.\"\"\"\n\n    # Detect if the input string contains any alphabetic letters (FR5).\n    contains_letters = False\n    for char_s in s:\n        if char_s.isalpha():\n            contains_letters = True\n            break\n\n    # If the string contains no alphabetic letters, reverse the entire string (FR6).\n    if not contains_letters:\n        # StringReverser.reverse equivalent\n        return s[::-1]\n\n    # If letters are present, iterate and apply case reversal (FR1, F1).\n    result_chars = []\n    for char_s in s:  # FR1: Iterate character by character.\n        if char_s.isalpha():  # FR2: Determine if a character is an alphabetic letter.\n            # FR3: If alphabetic, reverse its case. CaseConverter.convert_case equivalent logic.\n            if char_s.islower():\n                result_chars.append(char_s.upper())\n            elif char_s.isupper():\n                result_chars.append(char_s.lower())\n            else:\n                # If char is alpha but not specifically lower/upper (e.g., title case), keep as is (F2 implicitly).\n                result_chars.append(char_s)\n        else:\n            # FR4: If not alphabetic, keep the character as is (F2).\n            result_chars.append(char_s)\n\n    # FR7: Return the resulted string.\n    return \"\".join(result_chars)"}
