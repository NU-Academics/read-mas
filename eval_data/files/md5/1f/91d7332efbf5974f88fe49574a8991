{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        # If balance drops below zero, it means an unmatched closing bracket.\n        if balance < 0:\n            return False\n\n    # If balance is zero at the end, all brackets are matched.\n    return balance == 0"}
