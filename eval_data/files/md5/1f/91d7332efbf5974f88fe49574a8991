{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer is a prime number.\n        Checks for divisibility up to its square root.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of the digits of an integer.\n        Handles both positive and negative input numbers.\"\"\"\n        n = abs(n)\n        total_sum = 0\n        while n > 0:\n            total_sum += n % 10\n            n //= 10\n        return total_sum\n\n    largest_prime = None\n    for number in lst:\n        if is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n\n    if largest_prime is not None:\n        return sum_digits(largest_prime)\n    return 0"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False if the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Check if all keys are strings, returning False if any is not.\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n    all_lower = True\n    all_upper = True\n\n    # Iterate through keys to determine if they are all lowercase or all uppercase.\n    for key in dict.keys():\n        if key != key.lower():\n            all_lower = False\n        if key != key.upper():\n            all_upper = False\n\n        # Optimization: if neither condition can be met, exit early.\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Generates all prime numbers strictly less than n using the Sieve of Eratosthenes.\n    Returns an empty list for n less than or equal to 2.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array 'is_prime' where is_prime[i] is True if i is potentially prime.\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False # 0 and 1 are not prime numbers.\n\n    # Iterate from p = 2 up to the square root of n.\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            # Mark multiples of p as not prime, starting from p*p.\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Collect all numbers that are marked as prime.\n    primes = [i for i, prime in enumerate(is_prime) if prime]\n    return primes"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    VOWEL_MAP_LOWER = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'\n    }\n    VOWEL_MAP_UPPER = {\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n\n    encoded_chars = []\n    for char in message:\n        # First, swap case of the character\n        if char.islower():\n            processed_char = char.upper()\n        elif char.isupper():\n            processed_char = char.lower()\n        else:\n            processed_char = char  # Non-letters or non-caseable characters remain unchanged\n\n        # Then, replace vowels in the *newly cased* character\n        if processed_char in VOWEL_MAP_LOWER:\n            encoded_chars.append(VOWEL_MAP_LOWER[processed_char])\n        elif processed_char in VOWEL_MAP_UPPER:\n            encoded_chars.append(VOWEL_MAP_UPPER[processed_char])\n        else:\n            encoded_chars.append(processed_char)  # Not a vowel, or not a letter\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of three numbers is the sum of the other two,\n    and all three numbers are strictly integers.\n    \"\"\"\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = []\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        string_keys.append(key)\n\n    if all(key.islower() for key in string_keys):\n        return True\n\n    if all(key.isupper() for key in string_keys):\n        return True\n\n    return False"}
{"task_id": "HumanEval/94", "solution": "class PrimeChecker:\n    \"\"\"Utility class for checking if a number is prime.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"\n        Checks if an integer is a prime number.\n        Numbers less than 2 are not prime; it uses trial division.\n        \"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\nclass DigitSummer:\n    \"\"\"Utility class for summing the digits of a number.\"\"\"\n    def sum_digits(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of the digits of an integer.\n        The sum is based on the absolute value of the number.\n        \"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"\n    You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    prime_checker = PrimeChecker()\n    digit_summer = DigitSummer()\n\n    largest_prime = 0\n    for num in lst:\n        if prime_checker.is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n\n    return digit_summer.sum_digits(largest_prime)"}
