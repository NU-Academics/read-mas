{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 positions.\n    Non-alphabetic characters remain unchanged, and rotation wraps around the alphabet.\"\"\"\n    encrypted_chars = []\n    rotation_amount = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            rotated_char = chr(start + (ord(char) - start + rotation_amount) % 26)\n            encrypted_chars.append(rotated_char)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            rotated_char = chr(start + (ord(char) - start + rotation_amount) % 26)\n            encrypted_chars.append(rotated_char)\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string s and returns a new string where each word from the\n    original string will have its characters sorted in ascending ASCII order.\n    The original order of words and spaces must be maintained.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not s:\n        return \"\"\n\n    parts = []\n    current_segment_chars = []\n    # Determine if the first character (if exists) starts a space segment or a word segment\n    is_current_segment_space = s[0].isspace()\n\n    for char in s:\n        # If the current character's type (space/non-space) matches the current segment type\n        if char.isspace() == is_current_segment_space:\n            current_segment_chars.append(char)\n        else:\n            # The type of character has changed, so the current segment ends\n            parts.append(\"\".join(current_segment_chars))\n            # Start a new segment with the current character\n            current_segment_chars = [char]\n            # Invert the segment type\n            is_current_segment_space = not is_current_segment_space\n\n    # After the loop, append the last collected segment\n    if current_segment_chars:\n        parts.append(\"\".join(current_segment_chars))\n\n    result_parts = []\n    for part in parts:\n        # If the segment consists only of spaces, preserve it as is\n        if part.isspace():\n            result_parts.append(part)\n        else:\n            # For words, sort their characters by ASCII value\n            sorted_word = ''.join(sorted(part))\n            result_parts.append(sorted_word)\n\n    # Join all processed parts back into a single string\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\" (case-insensitive).\n    \"\"\"\n    import re\n\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def _split_text_into_sentences(text: str) -> list[str]:\n        # Splits text into sentences using the defined delimiters, cleaning results.\n        pattern = '|'.join(re.escape(d) for d in SENTENCE_DELIMITERS)\n        sentences = re.split(f'[{pattern}]', text)\n        return [s.strip() for s in sentences if s.strip()]\n\n    def _is_bored_sentence(sentence: str) -> bool:\n        # Determines if a sentence starts with the standalone word \"I\".\n        trimmed_sentence = sentence.strip()\n        if not trimmed_sentence:\n            return False\n        return re.match(r\"^I\\\\b\", trimmed_sentence, re.IGNORECASE) is not None\n\n    sentences = _split_text_into_sentences(S)\n    boredom_count = 0\n    for sentence in sentences:\n        if _is_bored_sentence(sentence):\n            boredom_count += 1\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    if not S:\n        return 0\n\n    # Simulate sentence splitting logic based on the design's SentenceSplitter.\n    # Replaces delimiters with a unique marker to then split the text.\n    processed_text = S\n    for delimiter in SENTENCE_DELIMITERS:\n        processed_text = processed_text.replace(delimiter, delimiter + '###SENTENCE_END###')\n\n    # Splits by the marker, trims leading/trailing whitespace, and filters out empty strings.\n    sentences = [s.strip() for s in processed_text.split('###SENTENCE_END###') if s.strip()]\n\n    boredom_count = 0\n    # Counts \"boredoms\" according to Business Rule BR1.\n    for sentence in sentences:\n        if sentence.startswith(\"I\"): # Case-sensitive check for \"I\" at the beginning.\n            if len(sentence) == 1: # \"I\" as a standalone sentence.\n                boredom_count += 1\n            elif sentence[1] == ' ': # \"I \" followed by a space.\n                boredom_count += 1\n            elif sentence[1] in SENTENCE_DELIMITERS: # \"I\" followed immediately by a delimiter.\n                boredom_count += 1\n\n    return boredom_count"}
