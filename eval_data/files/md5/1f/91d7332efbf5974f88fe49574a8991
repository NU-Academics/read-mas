{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    if a == 0:\n        return True\n\n    # Calculate the approximate integer cube root.\n    # Adjust the sign for negative numbers and verify by cubing.\n    root_candidate = round(abs(a)**(1/3))\n\n    if a < 0:\n        root_candidate = -root_candidate\n\n    return root_candidate * root_candidate * root_candidate == a"}
{"task_id": "HumanEval/75", "solution": "def _get_prime_factors(n: int) -> list[int]:\n    \"\"\"Returns a list of all prime factors for a given positive integer, including duplicates.\"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    \"\"\"\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Checks if the given integer 'a' is a perfect cube.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value of 'a'.\n    abs_a = abs(a)\n    cbrt_a_float = math.cbrt(abs_a)\n\n    # Consider the floor and ceiling of the float cube root as integer candidates\n    # to account for potential floating-point inaccuracies.\n    cbrt_a_int_floor = int(math.floor(cbrt_a_float))\n    cbrt_a_int_ceil = int(math.ceil(cbrt_a_float))\n\n    candidate_root = None\n    if cbrt_a_int_floor ** 3 == abs_a:\n        candidate_root = cbrt_a_int_floor\n    elif cbrt_a_int_ceil ** 3 == abs_a:\n        candidate_root = cbrt_a_int_ceil\n    else:\n        return False # No integer root found for abs_a\n\n    # Once a positive integer root for abs_a is found, check if its cube\n    # (with the correct sign for 'a') matches the original number.\n    if a < 0:\n        return (-candidate_root) ** 3 == a\n    else:\n        return candidate_root ** 3 == a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n^k = x for non-negative integer k).\n    Handles various edge cases for x and n efficiently.\"\"\"\n\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    if n == 0:\n        if x == 0:\n            return True\n        else:\n            return False\n\n    if x <= 0:\n        # If x is negative or zero (and not 1), and n is positive (>1, as n=0 and n=1 handled),\n        # n^k will always be positive for k >= 0.\n        return False\n\n    current_power = n\n\n    while current_power < x:\n        current_power *= n\n\n    return current_power == x"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if 'a' is a product of exactly three prime numbers.\n    Assumes 'a' is an integer between 1 and 99, as per critical requirements.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def generate_primes_up_to(limit: int) -> list[int]:\n        \"\"\"Generates primes up to a limit.\"\"\"\n        primes = []\n        for num in range(2, limit + 1):\n            if is_prime(num):\n                primes.append(num)\n        return primes\n\n    # The largest possible prime factor for a product of three primes less than 100\n    # (e.g., 2*2*p3 < 100 implies p3 < 25) is 23."}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for a non-negative integer k.\n    \"\"\"\n    if x == 1:\n        return True\n    if x <= 0:\n        return False\n    if n == 1:\n        return False\n\n    current_power = 1\n    while current_power < x:\n        current_power *= n\n    return current_power == x"}
