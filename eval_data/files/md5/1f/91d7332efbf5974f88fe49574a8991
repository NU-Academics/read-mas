{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sort the list to optimize the comparison.\n    # After sorting, close elements will be adjacent or very near.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n - 1):\n        # Only compare adjacent elements after sorting, this is sufficient to find close pairs.\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    result: List[str] = []\n    balance_counter = 0\n    current_group_start = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        if balance_counter == 0 and char == ')':\n            # Found a balanced, top-level group.\n            result.append(cleaned_string[current_group_start : i + 1])\n            current_group_start = i + 1\n\n    return result"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    fractional_part, _ = math.modf(number)\n    return fractional_part"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if any two numbers in a list are closer to each other than the given threshold.\n    Returns True if an absolute difference strictly less than the threshold is found, False otherwise.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Simulates bank account operations starting with a zero balance.\n    Returns True if the balance falls below zero at any point, False otherwise.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates multiple groups of balanced and non-nested parentheses from a string.\n    Spaces and other non-parenthesis characters in the input are ignored.\n    \"\"\"\n    # Preprocess the input string to remove all space characters.\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    groups: List[str] = []\n    balance = 0\n    start_index = -1\n\n    # Iterate through the cleaned string to find balanced, non-nested groups.\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:  # Mark the start of a potential new top-level group.\n                start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            # If balance returns to 0, a top-level group has closed and is balanced.\n            if balance == 0 and start_index != -1:\n                # Extract the raw substring and then filter to include only parentheses.\n                current_group_raw = cleaned_string[start_index : i + 1]\n                filtered_group = \"\".join(c for c in current_group_raw if c in \"()\")\n                groups.append(filtered_group)\n                start_index = -1  # Reset start_index to look for the next group.\n        # Other characters are ignored in balance tracking.\n\n    # Collect all identified groups into a list and return it.\n    return groups"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of floating-point numbers.\"\"\"\n    # Assuming the input list is non-empty as per critical requirements.\n    return sum(numbers) / len(numbers)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation for a list of numbers around their mean.\n    MAD is the average absolute difference between each element and the dataset's mean.\n    \"\"\"\n    data_mean = _calculate_mean(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    return _calculate_mean(absolute_differences)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns a new list with the delimeter interspersed.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts 'delimeter' between consecutive elements of 'numbers'.\n    Returns a new list with the delimeter interspersed.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        # Add delimeter if it's not the last element in the original list.\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n\n    def _calculate_mean(data: List[float]) -> float:\n        return sum(data) / len(data)\n\n    def _calculate_absolute_differences(data: List[float], mean_val: float) -> List[float]:\n        return [abs(x - mean_val) for x in data]\n\n    mean_value = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, mean_value)\n\n    return _calculate_mean(absolute_differences)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n\n    def _analyze_group(group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single parentheses group string.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group_string in groups:\n        if group_string:  # Only analyze non-empty group strings\n            results.append(_analyze_group(group_string))\n    return results"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not substring:\n        return list(strings)\n\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass ParenthesesGroupAnalyzer:\n    \"\"\"Analyzes a single parentheses group to find its maximum nesting depth.\"\"\"\n    def analyze_group(self, group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level within a single parentheses group string.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n            elif char == ')':\n                current_depth -= 1\n            max_depth = max(max_depth, current_depth)\n        return max_depth\nclass ParenthesesParser:\n    \"\"\"Orchestrates parsing of multiple parentheses groups and delegates analysis.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the parser with a group analyzer.\"\"\"\n        self._group_analyzer = ParenthesesGroupAnalyzer()\n\n    def parse_nested_parens(self, paren_string: str) -> List[int]:\n        \"\"\"Splits the input string into groups and analyzes each for nesting depth.\"\"\"\n        results = []\n        # Split by spaces and filter out any empty strings that result from multiple spaces.\n        groups = [group for group in paren_string.split(' ') if group]\n        for group_str in groups:\n            depth = self._group_analyzer.analyze_group(group_str)\n            results.append(depth)\n        return results\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Analyzes space-separated parentheses groups and returns their maximum nesting depths.\n    This function delegates the core logic to a ParenthesesParser instance.\"\"\"\n    parser = ParenthesesParser()\n    return parser.parse_nested_parens(paren_string)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product.\n    Empty list sum is 0 and empty list product is 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of a list of integers.\n    Returns (0, 1) for an empty list as per design.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of the maximum element found until the given moment\n    in the sequence. For an empty input list, an empty list is returned.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf')  # type: ignore # Initialize with negative infinity for comparison.\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Performs a bitwise XOR operation on two binary strings.\n    Assumes inputs are valid binary strings of equal length.\"\"\"\n    result_bits = []\n    for i in range(len(a)):\n        bit_a = int(a[i])\n        bit_b = int(b[i])\n        xor_result = bit_a ^ bit_b\n        result_bits.append(str(xor_result))\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if a given string is a palindrome.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    It identifies the longest palindromic suffix and appends the reversed prefix.\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    n = len(string)\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    max_len = max(len(a), len(b))\n    padded_a = a.zfill(max_len)\n    padded_b = b.zfill(max_len)\n\n    result_list = []\n    for bit_a, bit_b in zip(padded_a, padded_b):\n        if bit_a == bit_b:\n            result_list.append('0')\n        else:\n            result_list.append('1')\n    return \"\".join(result_list)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Return the first one in case of multiple strings of the same length.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest_string = None\n    max_length = -1\n\n    for s in strings:\n        if current_longest_string is None or len(s) > max_length:\n            current_longest_string = s\n            max_length = len(s)\n\n    return current_longest_string"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Return the first one in case of multiple strings of the same length, or None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found = \"\"\n    max_length = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_found = s\n    return longest_found"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate from the start of the string to find the longest palindromic suffix.\n    # When `i` is 0, the suffix is the entire string.\n    # When `i` is `len(string) - 1`, the suffix is the last character.\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # The part of the string before the longest palindromic suffix is `string[:i]`.\n            # Reverse this prefix and append it to the original string to form the shortest palindrome.\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This line should theoretically not be reached if the input string is non-empty,\n    # as at least the last character (a single character) will always be a palindrome,\n    # and the loop will find it when `i = len(string) - 1`.\n    # However, for completeness and safety, if somehow no palindrome is found,\n    # return the original string, implying it might already be a palindrome or\n    # an edge case not covered by previous logic.\n    return string"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the greatest common divisor (GCD) of two integers using the Euclidean algorithm.\n    Handles positive, negative, and zero inputs.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"Return a list of all prefixes of the input string, ordered from shortest to longest.\n    For example: all_prefixes('abc') returns ['a', 'ab', 'abc'].\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
