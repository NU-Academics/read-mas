{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n\n    derivative_coefficients = []\n    for i in range(1, len(xs)):\n        derivative_coefficients.append(xs[i] * i)\n\n    return derivative_coefficients"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]  # Reverse the string\n    else:\n        effective_shift = shift % n\n        return s[-effective_shift:] + s[:-effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in a string.\n    An empty string input results in a sum of 0.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    digits_str = str(x)\n    num_digits = len(digits_str)\n\n    if shift > num_digits:\n        # Reverse the string if shift strictly exceeds the number of digits.\n        return digits_str[::-1]\n    else:\n        # Perform circular right shift.\n        # The modulo operator handles cases where shift >= num_digits but not strictly greater,\n        # ensuring correct shifting (e.g., shift = num_digits means no effective shift).\n        actual_shift = shift % num_digits\n        return digits_str[-actual_shift:] + digits_str[:-actual_shift]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string.\n    Vowels are 'a', 'e', 'i', 'o', 'u', and 'y' if it's the last character.\"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    s_lower = s.lower()\n    word_length = len(s_lower)\n\n    for i, char in enumerate(s_lower):\n        if not char.isalpha():\n            continue\n\n        if char in standard_vowels:\n            vowel_count += 1\n        elif char == 'y' and i == word_length - 1:\n            vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    # Compute recursively and store the result.\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {}\ndef fibfib(n: int) -> int:\n    \"\"\"\n    Computes the n-th element of the FibFib number sequence efficiently using memoization.\n    Assumes 'n' is a non-negative integer as per the design's preconditions.\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        # Recursively calculate the sum of the three preceding FibFib numbers.\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _fibfib_memo[n] = result\n    return result"}
