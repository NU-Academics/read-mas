{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array within a given array.\n    This function uses a modified Kadane's algorithm.\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Filters words from string s that contain exactly n consonants.\n    Words are returned in their original order.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    result_words = []\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if char.lower() not in VOWELS:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of words\n    from s that contain exactly n consonants, in their original order.\n    \"\"\"\n\n    # Defines the set of lowercase English vowels for efficient lookup.\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def count_consonants(word_to_check: str) -> int:\n        \"\"\"Calculates the number of consonants in a given word.\"\"\"\n        consonant_count = 0\n        lower_word = word_to_check.lower()\n        for char in lower_word:\n            if 'a' <= char <= 'z' and char not in VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    words = s.split(' ')\n    result_words = []\n\n    for word in words:\n        if word:\n            consonant_count = count_consonants(word)\n            if consonant_count == n:\n                result_words.append(word)\n    return result_words"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of length k with the k largest numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    arr.sort() # Sorts the array in ascending order in-place.\n    return arr[len(arr) - k:] # Returns the last k elements, which are the largest and already sorted."}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right, not at word ends, that is surrounded by two consonants (case sensitive).\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        return char.lower() in _VOWELS\n\n    def is_consonant(char: str) -> bool:\n        return char.isalpha() and not is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if is_vowel(current_char) and \\\n           is_consonant(left_char) and \\\n           is_consonant(right_char):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"Initializes services and checks if concatenation forms a balanced string.\n    Returns 'Yes' if balanced, 'No' otherwise.\n    \"\"\"\n    class ParensValidator:\n        def is_balanced(self, s: str) -> bool:\n            \"\"\"Checks if the given string s has balanced parentheses.\n            Returns True if balanced, False otherwise.\n            \"\"\"\n            count = 0\n            for char in s:\n                if char == '(':\n                    count += 1\n                elif char == ')':\n                    count -= 1\n                if count < 0:\n                    return False\n            return count == 0\n\n    class ParensMatcherService:\n        def __init__(self, validator: ParensValidator):\n            \"\"\"Constructor. Initializes the service with a ParensValidator instance.\"\"\"\n            self._validator = validator\n\n        def match_parens(self, lst_input: list[str]) -> str:\n            \"\"\"Determines if concatenating the two input strings in any order results in a balanced string.\n            Returns 'Yes' if balanced, 'No' otherwise.\n            \"\"\"\n            s1, s2 = lst_input[0], lst_input[1]\n\n            if self._validator.is_balanced(s1 + s2):\n                return 'Yes'\n\n            if self._validator.is_balanced(s2 + s1):\n                return 'Yes'\n\n            return 'No'\n\n    validator = ParensValidator()\n    matcher = ParensMatcherService(validator)\n    return matcher.match_parens(lst)"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    Positions are 0-indexed.\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right surrounded by consonants, excluding word ends.\n    Returns the vowel or an empty string if not found.\n    \"\"\"\n    vowels_set = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in vowels_set\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    # Indices to check range from len(word) - 2 down to 1.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if (_is_vowel(current_char) and\n            _is_consonant(left_char) and\n            _is_consonant(right_char)):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # A min-heap stores the k largest elements found so far.\n    # Elements are sorted before returning to meet the requirement.\n    heap = []\n    for num in arr:\n        if len(heap) < k:\n            heapq.heappush(heap, num)\n        elif num > heap[0]:\n            heapq.heapreplace(heap, num)\n\n    return sorted(heap)"}
