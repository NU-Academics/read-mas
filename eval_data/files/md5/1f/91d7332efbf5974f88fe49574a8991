{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        # If balance drops below zero, a closing bracket appeared without an opener.\n        if balance < 0:\n            return False\n    # All brackets are balanced if the final count is zero.\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n        # If it's neither increasing nor decreasing, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    open_brackets_count = 0\n    for char in brackets:\n        if char == '<':\n            open_brackets_count += 1\n        elif char == '>':\n            open_brackets_count -= 1\n        else:\n            # According to design, non-bracket characters invalidate the sequence.\n            return False\n\n        if open_brackets_count < 0:\n            return False\n\n    return open_brackets_count == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    is_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_decreasing = False\n            break\n\n    return is_decreasing"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    Decodes a string by shifting lowercase English alphabet characters backward by 5 positions,\n    handling wrap-around. Non-alphabetic characters remain unchanged.\n    \"\"\"\n    decoded_chars = []\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            shifted_char_code = ((ord(ch) - ord('a') - 5 + 26) % 26) + ord('a')\n            decoded_chars.append(chr(shifted_char_code))\n        else:\n            decoded_chars.append(ch)\n    return \"\".join(decoded_chars)"}
