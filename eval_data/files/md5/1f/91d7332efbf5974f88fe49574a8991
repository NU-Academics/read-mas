{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\"\n    Counts the number of distinct characters in a string, ignoring case.\n    All Unicode characters are considered, including letters, numbers, symbols, and whitespace.\n    \"\"\"\n    if not string:\n        return 0\n\n    # Convert the entire string to lowercase to handle case-insensitivity\n    lower_string = string.lower()\n\n    # Use a set to store unique characters, leveraging the set's inherent uniqueness property\n    distinct_chars = set()\n    for char in lower_string:\n        distinct_chars.add(char)\n\n    return len(distinct_chars)"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of \"\"\"\n    # Convert the string to lowercase for case-insensitivity.\n    lower_cased_string = string.lower()\n\n    # Use a set to store unique characters and return its size.\n    distinct_chars = set(lower_cased_string)\n\n    return len(distinct_chars)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    # The loop iterates through all possible starting positions for the substring,\n    # including those that allow for overlapping matches.\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count"}
