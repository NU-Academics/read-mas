{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    for i in range(-1000, 1001):\n        if abs(poly(xs, i)) < 1e-6:\n            return float(i)\n    raise RuntimeError(\"Zero not found within search bounds.\")"}
{"task_id": "HumanEval/35", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass IntegerList:\n    \"\"\"Represents a list of integers.\"\"\"\n    items: List[int]\n\nclass MaximumFinder:\n    \"\"\"Finds the maximum element within an IntegerList.\"\"\"\n    def find_max(self, integer_list: IntegerList) -> int:\n        \"\"\"Iterates through the list to find the maximum value.\"\"\"\n        max_val = integer_list.items[0]\n        for item in integer_list.items[1:]:\n            if item > max_val:\n                max_val = item\n        return max_val\n\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    integer_list_obj = IntegerList(items=l)\n    finder = MaximumFinder()\n    return finder.find_max(integer_list_obj)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    result = list(l)\n    \n    # Collect values from indices divisible by three\n    third_elements = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n            \n    # Sort these collected values\n    third_elements.sort()\n    \n    # Replace elements in the result list\n    sorted_idx = 0\n    for i in range(len(result)):\n        if i % 3 == 0:\n            result[i] = third_elements[sorted_idx]\n            sorted_idx += 1\n            \n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total = 0\n    for i in range(n):\n        if i % 11 == 0 or i % 13 == 0:\n            total += str(i).count('7')\n    return total"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = list(l)\n\n    even_values = []\n    for i in range(0, len(l), 2):\n        even_values.append(l[i])\n\n    even_values.sort()\n\n    sorted_even_idx = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_values[sorted_even_idx]\n        sorted_even_idx += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[2] + group[0:2]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    count = 0\n    a, b = 0, 1 \n\n    while True:\n        next_fib = a + b\n        a = b\n        b = next_fib\n\n        if is_prime(next_fib):\n            count += 1\n            if count == n:\n                return next_fib"}
