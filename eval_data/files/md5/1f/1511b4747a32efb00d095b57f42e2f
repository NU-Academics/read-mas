{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/56", "solution": "class BracketString:\n    \"\"\"Represents a bracket string and its validation status.\"\"\"\n    def __init__(self, content: str, is_valid: bool):\n        self.content = content\n        self.is_valid = is_valid\n\nclass BracketValidator:\n    \"\"\"Validates the correctness of bracket strings.\"\"\"\n    def validate(self, brackets: str) -> bool:\n        count = 0\n        for char in brackets:\n            if char == '<':\n                count += 1\n            elif char == '>':\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\nclass PersistenceManager:\n    \"\"\"Manages the persistence of BracketString objects.\"\"\"\n    def save(self, bracket_string: BracketString):\n        # This method simulates saving to a database as per design, without actual I/O.\n        pass\n\nclass Logger:\n    \"\"\"Handles logging of system events and validation results.\"\"\"\n    def log(self, message: str):\n        # This method simulates writing to a log file as per design, without actual I/O.\n        pass\n\n\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    validator = BracketValidator()\n    persistence_manager = PersistenceManager()\n    logger = Logger()\n\n    is_valid = validator.validate(brackets)\n    bracket_string = BracketString(brackets, is_valid)\n\n    persistence_manager.save(bracket_string)\n    log_message = f\"Validated '{brackets}': {'True' if is_valid else 'False'}\"\n    logger.log(log_message)\n\n    return is_valid"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check for monotonically increasing\n    increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            increasing = False\n            break\n\n    # Check for monotonically decreasing\n    decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            decreasing = False\n            break\n\n    return increasing or decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(list(common_elements))"}
{"task_id": "HumanEval/59", "solution": "import math\n\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Return True if n is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    if n <= 1:\n        raise ValueError(\"Input must be greater than 1.\")\n    if _is_prime(n):\n        raise ValueError(\"Input must not be a prime number.\")\n\n    largest = None\n    # Check divisibility by 2 first\n    while n % 2 == 0:\n        largest = 2\n        n //= 2\n    # Check odd divisors\n    divisor = 3\n    max_divisor = math.isqrt(n) + 1\n    while divisor <= max_divisor and n > 1:\n        while n % divisor == 0:\n            largest = divisor\n            n //= divisor\n            max_divisor = math.isqrt(n) + 1\n        divisor += 2\n    if n > 1:  # Remaining n is prime\n        largest = n\n    return largest"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # The sum of numbers from 1 to n can be calculated using the formula n * (n + 1) / 2.\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        # If balance drops below zero, a closing bracket appeared without a matching opening one.\n        if balance < 0:\n            return False\n    # After iterating, if balance is zero, all brackets were correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # The derivative of c_i * x^i is i * c_i * x^(i-1).\n    # The new coefficient at index 'j' corresponds to the original term at index 'j+1'.\n    # So, the new_coeff[j] = (j+1) * original_coeff[j+1]\n    derived_coeffs = []\n    for i in range(len(xs) - 1):\n        derived_coeffs.append((i + 1) * xs[i + 1])\n    return derived_coeffs"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using memoization for efficiency.\"\"\"\n    memo = {}\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    if n in memo:\n        return memo[n]\n\n    memo[0] = 0\n    memo[1] = 0\n    memo[2] = 1\n\n    for i in range(3, n + 1):\n        memo[i] = memo[i-1] + memo[i-2] + memo[i-3]\n\n    return memo[n]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, where 'y' is a vowel only at the end of the word.\"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    count = 0\n    s_lower = s.lower()\n    \n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n            \n    return count"}
