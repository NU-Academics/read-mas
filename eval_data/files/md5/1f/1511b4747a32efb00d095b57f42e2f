{"task_id": "HumanEval/46", "solution": "from typing import List\n\nclass Fib4Sequence:\n    \"\"\"Maintains a rolling cache of the last four fib4 values.\"\"\"\n\n    def __init__(self) -> None:\n        self.cache: List[int] = [0, 0, 2, 0]\n\n    def get(self, n: int) -> int:\n        if n < 4:\n            return self.cache[n]\n        for i in range(4, n + 1):\n            next_val = sum(self.cache)\n            self.cache.pop(0)\n            self.cache.append(next_val)\n        return self.cache[-1]\n\nclass Fib4Calculator:\n    \"\"\"Orchestrates the computation by delegating to Fib4Sequence.\"\"\"\n\n    def compute(self, n: int) -> int:\n        sequence = Fib4Sequence()\n        return sequence.get(n)\n\ndef fib4(n: int):\n    \"\"\"\n    Compute the n-th element of the fib4 sequence.\n    \"\"\"\n    calculator = Fib4Calculator()\n    return calculator.compute(n)"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Sort the list to find the median.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    # Calculate the median based on list length.\n    if n % 2 == 1:\n        # Odd length: return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even length: return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
