{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if any cyclic rotation of string b exists as a substring in string a.\n    Returns True if a match is found, False otherwise.\"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n    \n    for rotation in rotations:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension for a given class name based on a strength metric.\n    The strength of an extension is calculated as (uppercase letters - lowercase letters).\n    \"\"\"\n\n    def _count_uppercase(text):\n        \"\"\"Counts the number of uppercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.isupper())\n\n    def _count_lowercase(text):\n        \"\"\"Counts the number of lowercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.islower())\n\n    def _calculate_strength(extension_name):\n        \"\"\"Calculates the strength of an extension name.\"\"\"\n        cap = _count_uppercase(extension_name)\n        sm = _count_lowercase(extension_name)\n        return cap - sm\n\n    strongest_extension_name = None\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n\n        if strongest_extension_name is None or current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n        # If current_strength == max_strength, the existing strongest_extension_name\n        # (which appeared earlier in the list) is retained, satisfying the tie-breaker rule.\n\n    # Format the output string. If extensions was empty, strongest_extension_name will be None.\n    return f\"{class_name}.{strongest_extension_name}\"\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension for a given class name based on CAP - SM strength calculation.\n    If strengths are tied, the first encountered extension in the list is chosen.\n    \"\"\"\n    strongest_ext_name = \"\"\n    max_strength = -float('inf') # Initialize with a very low strength to ensure the first extension is chosen\n\n    for ext_name in extensions:\n        cap_count = sum(1 for char in ext_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in ext_name if 'a' <= char <= 'z')\n        current_strength = cap_count - sm_count\n        \n        # Update strongest extension if current strength is strictly greater\n        # This naturally handles the tie-breaking rule by retaining the first one encountered\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\"\n```"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    The absolute value of the number is used for counting digits.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    num_str = str(abs(num)) # Convert to absolute string to process digits.\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "```python\nROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n]\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    result = []\n    for value, symbol in ROMAN_MAP:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result)\n```"}
{"task_id": "HumanEval/156", "solution": "```python\nROMAN_MAP: dict[int, str] = {\n    1000: 'M', 900: 'CM', 500: 'D', 400: 'CD', 100: 'C',\n    90: 'XC', 50: 'L', 40: 'XL', 10: 'X', 9: 'IX', 5: 'V',\n    4: 'IV', 1: 'I'\n}\n\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. The input number is assumed to be between 1 and 1000.\n    \"\"\"\n    roman_numeral = []\n    for value, symbol in ROMAN_MAP.items():\n        while number >= value:\n            roman_numeral.append(symbol)\n            number -= value\n    return \"\".join(roman_numeral).lower()\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    Negative numbers are processed by their absolute value, and 0 is considered an even digit.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)\n\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Determines if three side lengths form a right-angled triangle.\n    It uses the Pythagorean theorem with a small floating-point tolerance.\n    \"\"\"\n    FLOAT_TOLERANCE = 1e-9\n\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check if the square of the longest side equals the sum of squares of the other two.\n    return abs(s1**2 + s2**2 - s3**2) < FLOAT_TOLERANCE\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"Checks if the second word (b) or any of its rotations is a substring\n    in the first word (a).\"\"\"\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all cyclic rotations of a given string.\n        Each rotation moves the first character to the end iteratively.\"\"\"\n        if not s:\n            return []\n        rotations = []\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.append(rotated_s)\n        return rotations\n\n    if not b:\n        return False # An empty pattern cannot be a substring per business rules.\n    if not a:\n        return False # An empty target cannot contain any non-empty substring.\n\n    if len(b) > len(a):\n        return False # Optimization: a longer pattern cannot be a substring.\n\n    rotations_of_b = _generate_rotations(b)\n    \n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n            \n    return False\n```"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the most unique characters, breaking ties lexicographically.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = words[0]\n    max_unique_chars = len(set(words[0]))\n\n    for word in words[1:]:\n        current_unique_chars = len(set(word))\n\n        if current_unique_chars > max_unique_chars:\n            max_unique_chars = current_unique_chars\n            best_word = word\n        elif current_unique_chars == max_unique_chars:\n            if word < best_word:\n                best_word = word\n\n    return best_word"}
{"task_id": "HumanEval/157", "solution": "```python\nimport math\n\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, determine if they form a right-angled triangle.\n    It applies the triangle inequality and Pythagorean theorem for validation.\n    \"\"\"\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check triangle inequality theorem: the sum of any two sides must be greater than the third.\n    # Since sides are sorted, only s1 + s2 > s3 needs to be explicitly checked.\n    if not (s1 + s2 > s3):\n        return False\n\n    # Apply Pythagorean theorem, using a small tolerance for floating-point comparison.\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=1e-9)\n```"}
