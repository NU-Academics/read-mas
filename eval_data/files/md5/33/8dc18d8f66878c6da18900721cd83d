{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not a part of a word. A \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        # Check the character before the last one.\n        char_before_last = txt[-2]\n        return char_before_last == ' '\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    '''\n    Checks if the input string contains a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n    This means finding indices i < j < k < l such that s[i]=='[', s[j]=='[', s[k]==']', s[l]==']'.\n    '''\n    # Find the first '['\n    first_open_idx = -1\n    for idx, char in enumerate(string):\n        if char == '[':\n            first_open_idx = idx\n            break\n    if first_open_idx == -1:\n        return False\n\n    # Find the second '[' after the first '['\n    second_open_idx = -1\n    for idx in range(first_open_idx + 1, len(string)):\n        if string[idx] == '[':\n            second_open_idx = idx\n            break\n    if second_open_idx == -1:\n        return False\n\n    # Find the first ']' after the second '['\n    first_close_idx = -1\n    for idx in range(second_open_idx + 1, len(string)):\n        if string[idx] == ']':\n            first_close_idx = idx\n            break\n    if first_close_idx == -1:\n        return False\n\n    # Find the second ']' after the first ']'\n    second_close_idx = -1\n    for idx in range(first_close_idx + 1, len(string)):\n        if string[idx] == ']':\n            second_close_idx = idx\n            break\n    if second_close_idx == -1:\n        return False\n\n    # If all four indices are found in the correct order, then it's nested\n    return True\n```"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element not greater than or equal to its\n    preceding element. Returns -1 if no such element exists.\n    \"\"\"\n    if not arr or len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"Finds the largest negative and smallest positive integers in a list.\n    Returns (None, None) for values not found or if the list is empty/contains only zeros.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n    \n    return largest_negative, smallest_positive"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or\n    equal to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    largest_index = -1\n    if not arr or len(arr) < 2:\n        return largest_index\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_index = i\n    return largest_index"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Returns a tuple (largest negative, smallest positive) from a list of integers.\n    Returns None for a component if no such integers exist.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n    \n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Checks if a string has at least one nested bracket subsequence like `[[...]]`.\n    This means finding indices i < j < k < l with s[i]='[', s[j]='[', s[k]=']', s[l]=']'.\n    \"\"\"\n    first_open = -1\n    second_open = -1\n    first_close = -1\n    second_close = -1\n\n    for i, char in enumerate(string):\n        if char == '[':\n            if first_open == -1:\n                first_open = i\n            elif second_open == -1:\n                second_open = i\n        elif char == ']':\n            if first_close == -1:\n                first_close = i\n            elif second_close == -1:\n                second_close = i\n\n    return (\n        first_open != -1 and\n        second_open != -1 and\n        first_close != -1 and\n        second_close != -1 and\n        first_open < second_open < first_close < second_close\n    )\n```"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    This is true for any even number n >= 8, otherwise false.\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/138", "solution": "```python\ndef is_equal_to_sum_even(n):\n    \"\"\"\n    Evaluates if n can be expressed as the sum of exactly 4 positive even numbers.\n    Returns True if n is even and n >= 8, False otherwise.\n    \"\"\"\n    # The smallest sum of four positive even numbers is 2+2+2+2=8.\n    # Any even number >= 8 can be represented as 2+2+2+(n-6), where (n-6) is a positive even number.\n    return n % 2 == 0 and n >= 8\n```"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representing a real number)\n    and returns the numerically larger value in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    # Convert inputs to a comparable float type, handling comma as a decimal separator.\n    # This assumes inputs are always convertible to a valid float representation.\n    float_a = float(str(a).replace(',', '.'))\n    float_b = float(str(b).replace(',', '.'))\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "def factorial(k: int) -> int:\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\n    Assumes k is an integer greater than or equal to 0.\n    \"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef special_factorial(n: int) -> int:\n    \"\"\"Calculates the special factorial for a positive integer n.\n    It computes n! * (n-1)! * ... * 1!.\n    \"\"\"\n    result = 1\n    for i in range(1, n + 1):\n        result *= factorial(i)\n    return result"}
{"task_id": "HumanEval/139", "solution": "```python\n# Global memoization dictionary for factorial calculations.\n_factorial_memo = {}\n\ndef _factorial_helper(k: int) -> int:\n    \"\"\"Calculates the factorial of a positive integer k, using memoization.\n    This helper assumes k is a positive integer.\n    \"\"\"\n    if k in _factorial_memo:\n        return _factorial_memo[k]\n    \n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    _factorial_memo[k] = res\n    return res\n\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as: n! * (n-1)! * ... * 1!.\n    This function assumes n is a positive integer.\n    \"\"\"\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= _factorial_helper(i)\n    return total_product\n```"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This ensures \"   \" becomes \"-\" before single spaces are touched.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores.\n    # This also converts \"  \" (two spaces) to \"__\".\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/137", "solution": "```python\nfrom typing import Union\n\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"Compares two numbers (int, float, or string) and returns the larger in its original type, or None if equal.\n    Handles string representations with comma or dot decimal separators.\"\"\"\n\n    def _normalize_to_float(value):\n        # Converts value to a float, handling comma decimal separators in strings.\n        # Invalid string inputs will raise a ValueError from float().\n        if isinstance(value, str):\n            return float(value.replace(',', '.'))\n        return float(value)\n\n    normalized_a = _normalize_to_float(a)\n    normalized_b = _normalize_to_float(b)\n\n    if normalized_a > normalized_b:\n        return a\n    elif normalized_b > normalized_a:\n        return b\n    else:\n        return None\n```"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces spaces in a string with underscores or hyphens based on consecutive count.\n    More than 2 consecutive spaces become a hyphen, single or two spaces become underscores.\n    \"\"\"\n    # Step 1: Replace sequences of 3 or more spaces with a single hyphen.\n    temp_text = re.sub(r' {3,}', '-', text)\n\n    # Step 2: Replace any remaining single spaces (including those from '  ') with underscores.\n    final_text = temp_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    \n    # Check if the file's name contains exactly one dot ('.').\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file_name into a prefix and a suffix.\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Check if the prefix is not empty and starts with a Latin alphabet letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Check if the suffix is one of ['txt', 'exe', 'dll'].\n    VALID_EXTENSIONS = ['txt', 'exe', 'dll']\n    if suffix not in VALID_EXTENSIONS:\n        return 'No'\n\n    # Count the number of digits in the entire file_name.\n    digit_count = sum(c.isdigit() for c in file_name)\n\n    # Check if the digit count is not more than three.\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions are met, return 'Yes'.\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates a sum from a list of integers, squaring elements at indices multiple of 3 and cubing those at indices multiple of 4 (but not 3).\n    Unchanged elements and the final sum are returned.\n    \"\"\"\n    # Create a mutable copy to avoid modifying the original list.\n    modified_lst = list(lst)\n\n    for i in range(len(modified_lst)):\n        # If index is a multiple of 3, square the entry.\n        if i % 3 == 0:\n            modified_lst[i] = modified_lst[i] ** 2\n        # Otherwise, if index is a multiple of 4 (and not a multiple of 3), cube the entry.\n        elif i % 4 == 0:\n            modified_lst[i] = modified_lst[i] ** 3\n        # For other indices, the entry remains unchanged.\n\n    # Return the sum of all entries in the (potentially modified) list.\n    return sum(modified_lst)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers.\n    The original order of words is preserved.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n\n    # FR3: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # FR2: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # FR4: The substring before the dot should not be empty, and it starts with a latin alphabet letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # FR5: The substring after the dot should be one of ['txt', 'exe', 'dll']\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n    \n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, applying transformations based on index.\n    It squares elements at indices that are multiples of 3, cubes elements at indices that are multiples of 4 but not 3,\n    and then returns the sum of all (potentially modified) elements.\n    \"\"\"\n    modified_list = list(lst)  # Create a mutable copy to avoid modifying the original list in place.\n\n    for i in range(len(modified_list)):\n        if i % 3 == 0:\n            modified_list[i] = modified_list[i] ** 2\n        elif i % 4 == 0:\n            modified_list[i] = modified_list[i] ** 3\n        # Elements at other indices remain unchanged as per the specification.\n\n    return sum(modified_list)"}
{"task_id": "HumanEval/143", "solution": "```python\ndef is_prime(n):\n    \"\"\"Checks if a number is prime. Returns True if prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\n\ndef words_in_sentence(sentence):\n    \"\"\"Filters words from a sentence, keeping only those with prime lengths.\"\"\"\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)\n```"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        # Initializes a fraction, simplifying it upon creation.\n        common = self._gcd(numerator, denominator)\n        self.numerator = numerator // common\n        self.denominator = denominator // common\n\n    def _gcd(self, a: int, b: int) -> int:\n        # Calculates the greatest common divisor for simplification.\n        while b:\n            a, b = b, a % b\n        return a\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        # Multiplies this fraction by another fraction and returns a new Fraction object.\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        # Checks if the fraction represents a whole number.\n        return self.denominator == 1\n\nclass FractionParser:\n    @staticmethod\n    def parse(fraction_str: str) -> Fraction:\n        # Parses a string representation of a fraction into a Fraction object.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\nclass FractionCalculator:\n    @staticmethod\n    def multiply(f1: 'Fraction', f2: 'Fraction') -> 'Fraction':\n        # Multiplies two Fraction objects by delegating to the Fraction's multiply method.\n        return f1.multiply(f2)\n\nclass FractionChecker:\n    @staticmethod\n    def is_whole_number(f: 'Fraction') -> bool:\n        # Checks if a fraction is a whole number by delegating to the Fraction's method.\n        return f.is_whole_number()\n\nclass FractionSimplifier:\n    @staticmethod\n    def simplify(x_str: str, n_str: str) -> bool:\n        # Orchestrates parsing, multiplication, and whole number checking for two fraction strings.\n        fraction_x = FractionParser.parse(x_str)\n        fraction_n = FractionParser.parse(n_str)\n        product_fraction = FractionCalculator.multiply(fraction_x, fraction_n)\n        return FractionChecker.is_whole_number(product_fraction)\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Checks if the product of two fractional numbers results in a whole number.\n    Input fractions are string representations in <numerator>/<denominator> format.\n    \"\"\"\n    return FractionSimplifier.simplify(x, n)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, the original relative order is preserved.\n    \"\"\"\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of an integer.\n        For example: _sum_digits(-12) returns 3 (1+2).\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (sum_of_digits, original_index, number) for stable sorting.\n    decorated_list = [(_sum_digits(num), i, num) for i, num in enumerate(nums)]\n\n    # Sort the decorated list. Python's default tuple sort handles primary and secondary keys.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted decorated list.\n    return [num for _, _, num in decorated_list]"}
{"task_id": "HumanEval/146", "solution": "def is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return digit % 2 != 0\n\ndef get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n    num_str = str(abs(num))\n    return int(num_str[0])\n\ndef get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n    return abs(num) % 10\n\ndef specialFilter(nums):\n    \"\"\"Filters numbers greater than 10 where both first and last digits are odd.\n    Returns the count of such special numbers.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            \n            if is_odd(first_digit) and is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in the array that are greater than 10 and have\n    both first and last digits odd.\"\"\"\n\n    def is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[0])\n\n    def get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n        abs_num_str = str(abs(num))\n        return int(abs_num_str[-1])\n\n    special_count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_odd(first_digit) and is_odd(last_digit):\n                special_count += 1\n    return special_count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits,\n    using original index as a tie-breaker.\n    \"\"\"\n    items_with_keys = []\n    for i, num in enumerate(nums):\n        # Inlined logic for calculating sum of absolute digits\n        s = str(abs(num))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        items_with_keys.append((digit_sum, i, num))\n\n    # Sort the list of tuples primarily by digit_sum, secondarily by original_index.\n    sorted_items = sorted(items_with_keys, key=lambda x: (x[0], x[1]))\n\n    # Extract the original values from the sorted tuples.\n    return [item[2] for item in sorted_items]"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and a denominator.\n    It supports multiplication and normalization of negative denominators.\n    \"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        # As per critical requirements, no type or value checks are performed for inputs.\n        if denominator < 0:\n            numerator *= -1\n            denominator *= -1\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def __eq__(self, other: object) -> bool:\n        # As per critical requirements, no isinstance check is performed.\n        return self.numerator == other.numerator and self.denominator == other.denominator\n\n    def __str__(self) -> str:\n        return f\"{self.numerator}/{self.denominator}\"\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}, {self.denominator})\"\n\nclass MathUtils:\n    \"\"\"Provides static utility methods for mathematical operations like GCD.\"\"\"\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        # Implements Euclidean algorithm for greatest common divisor.\n        while b:\n            a, b = b, a % b\n        return a\n\nclass FractionParser:\n    \"\"\"Parses string representations of fractions into Fraction objects.\"\"\"\n    def parse(self, fraction_str: str) -> Fraction:\n        # As per critical requirements, input format is assumed correct; no error handling.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\nclass FractionService:\n    \"\"\"Orchestrates the core business logic for fraction operations.\"\"\"\n    def __init__(self, parser: 'FractionParser'):\n        self._parser = parser\n\n    def multiply_fractions(self, f1: 'Fraction', f2: 'Fraction') -> 'Fraction':\n        return f1 * f2\n\n    def simplify_fraction(self, f: 'Fraction') -> 'Fraction':\n        common_divisor = MathUtils.gcd(abs(f.numerator), abs(f.denominator))\n        simplified_numerator = f.numerator // common_divisor\n        simplified_denominator = f.denominator // common_divisor\n        return Fraction(simplified_numerator, simplified_denominator)\n\n    def is_whole_number(self, f: 'Fraction') -> bool:\n        return f.denominator == 1\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Parses, multiplies, simplifies fractions, and checks if the product is a whole number.\"\"\"\n        fraction_x = self._parser.parse(x)\n        fraction_n = self._parser.parse(n)\n\n        product_fraction = self.multiply_fractions(fraction_x, fraction_n)\n        simplified_product = self.simplify_fraction(product_fraction)\n\n        return self.is_whole_number(simplified_product)\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"This function determines if the product of two fraction strings (x * n)\n    results in a whole number after simplification.\n    \"\"\"\n    parser = FractionParser()\n    service = FractionService(parser)\n    return service.simplify(x, n)"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    '''\n    Finds planets between two given planet names, sorted by proximity to the Sun.\n    Returns an empty tuple if inputs are invalid or no planets are found between them.\n    '''\n    PLANET_ORDER = [\n        \"Mercury\",\n        \"Venus\",\n        \"Earth\",\n        \"Mars\",\n        \"Jupiter\",\n        \"Saturn\",\n        \"Uranus\",\n        \"Neptune\"\n    ]\n\n    try:\n        idx1 = PLANET_ORDER.index(planet1)\n        idx2 = PLANET_ORDER.index(planet2)\n    except ValueError:\n        return () # Handles invalid planet names as per FR3\n\n    if idx1 == idx2:\n        return () # Handles cases where both planets are the same as per FR2 error handling\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    return tuple(PLANET_ORDER[start_idx + 1 : end_idx])\n\n```"}
{"task_id": "HumanEval/147", "solution": "import math\n\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a generated array\n    such that i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    count_0 = 0  # Count of a[i] such that a[i] % 3 == 0\n    count_1 = 0  # Count of a[i] such that a[i] % 3 == 1\n\n    for i in range(1, n + 1):\n        # The remainder of a[i] = i*i - i + 1 when divided by 3 follows a pattern:\n        # If i % 3 == 2, then a[i] % 3 == 0.\n        # If i % 3 == 0 or i % 3 == 1, then a[i] % 3 == 1.\n        i_mod_3 = i % 3\n        if i_mod_3 == 2:\n            count_0 += 1\n        else:\n            count_1 += 1\n            \n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if and only if\n    # (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # Since a[x]%3 can only be 0 or 1, this condition is met only if:\n    # 1. All three elements are 0 mod 3. (0+0+0)%3 = 0\n    # 2. All three elements are 1 mod 3. (1+1+1)%3 = 0\n\n    # Calculate combinations of 3 elements from those with remainder 0\n    triples_000 = math.comb(count_0, 3)\n    \n    # Calculate combinations of 3 elements from those with remainder 1\n    triples_111 = math.comb(count_1, 3)\n    \n    return triples_000 + triples_111"}
