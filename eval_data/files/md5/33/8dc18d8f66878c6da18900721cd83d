{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\", delimited by '.', '?' or '!'.\n    Trims whitespace and checks for case-sensitive \"I\".\n    \"\"\"\n    boredom_count = 0\n\n    # Split the text into sentences using '.', '?', '!' as delimiters.\n    # The re.split function effectively handles multiple adjacent delimiters\n    # by producing empty strings, which are then filtered out.\n    sentences_raw = re.split(r'[.?!]', S)\n\n    cleaned_sentences = []\n    for s in sentences_raw:\n        stripped_s = s.strip()\n        if stripped_s:  # Discard any empty strings resulting from the split\n            cleaned_sentences.append(stripped_s)\n\n    # Iterate through the cleaned sentences to count \"boredoms\".\n    for sentence in cleaned_sentences:\n        # Trim leading/trailing whitespace from the current sentence.\n        trimmed_sentence = sentence.strip()\n\n        if not trimmed_sentence:\n            continue # Skip if sentence is now empty\n\n        # Get the first word of the sentence.\n        # .split(maxsplit=1)[0] efficiently gets the first word, handling multiple\n        # spaces and ensuring we only consider the first distinct word.\n        first_word = trimmed_sentence.split(maxsplit=1)[0]\n\n        # Check if the first word is exactly \"I\" (case-sensitive).\n        if first_word == \"I\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string.\n    A boredom is a sentence that starts with the word \"I\", delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n\n    # Split the text into sentences based on delimiters '.', '?', '!'\n    # The regex splits *after* a delimiter, followed by optional whitespace.\n    sentences_raw = re.split(r'(?<=[.?!])\\s*', S)\n    \n    # Clean up sentences: strip whitespace and filter out any empty strings.\n    sentences = [s.strip() for s in sentences_raw if s.strip()]\n\n    for sentence in sentences:\n        # Extract the first word from the sentence, handling leading/trailing whitespace.\n        words = sentence.strip().split(maxsplit=1)\n        if words:\n            first_word = words[0]\n            # Check if the first word is \"I\" (case-sensitive).\n            if first_word == \"I\":\n                boredom_count += 1\n                \n    return boredom_count"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    If no prime numbers are found, it returns 0.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\n        A prime number must be a natural number greater than 1.\n        \"\"\"\n        if n <= 1:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given integer n.\n        Converts the number to a string and sums its integer digits.\n        \"\"\"\n        s = 0\n        n_str = str(n)\n        for digit_char in n_str:\n            s += int(digit_char)\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    # If no prime numbers were found, largest_prime remains 0, and its digit sum is 0.\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case and shifting vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, with wrap-around.\n    \"\"\"\n\n    VOWELS_LOWERCASE = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPERCASE = {'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWERCASE = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPERCASE = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char in VOWELS_LOWERCASE or char in VOWELS_UPPERCASE\n\n    def shift_char(char: str, places: int) -> str:\n        \"\"\"Shifts an alphabetic character forward, preserving case and wrapping around.\"\"\"\n        if char.islower():\n            if char in ALPHABET_LOWERCASE: # Ensure character is actually in the alphabet\n                idx = ALPHABET_LOWERCASE.index(char)\n                return ALPHABET_LOWERCASE[(idx + places) % len(ALPHABET_LOWERCASE)]\n        elif char.isupper():\n            if char in ALPHABET_UPPERCASE: # Ensure character is actually in the alphabet\n                idx = ALPHABET_UPPERCASE.index(char)\n                return ALPHABET_UPPERCASE[(idx + places) % len(ALPHABET_UPPERCASE)]\n        return char # Return non-alphabetic characters unchanged.\n\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n            continue\n\n        transformed_char = char\n        if is_vowel(char):\n            transformed_char = shift_char(char, 2)\n        \n        # Apply case swap to the (potentially) transformed character\n        if transformed_char.islower():\n            encoded_chars.append(transformed_char.upper())\n        else:\n            encoded_chars.append(transformed_char.lower())\n        \n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Determines if all string keys in a dictionary are uniformly cased (all lowercase or all uppercase).\n    Returns False if the dictionary is empty or contains non-string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Check if all keys are strings, as required by functional requirements and examples.\n    # This directly addresses cases like {\"a\":\"apple\", 8:\"banana\"} needing to return False.\n    if not all(isinstance(key, str) for key in dict.keys()):\n        return False\n\n    all_lowercase = all(key == key.lower() for key in dict.keys())\n    all_uppercase = all(key == key.upper() for key in dict.keys())\n\n    return all_lowercase or all_uppercase\n\n```"}
{"task_id": "HumanEval/96", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime.\n    A number is prime if it is greater than 1 and has no divisors other than 1 and itself.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_up_to(n):\n    \"\"\"Returns a list of all prime numbers strictly less than n.\n    This function assumes n is a non-negative integer.\"\"\"\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\n        This function assumes n is a non-negative integer.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of an integer n.\n        This function assumes n is a non-negative integer.\n        \"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/96", "solution": "```python\ndef _is_prime(num):\n    \"\"\"Checks if a number is prime using trial division.\n    It optimizes by checking divisors only up to its square root.\n    \"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_up_to(n):\n    \"\"\"Returns a list of prime numbers strictly less than n.\n    It iterates from 2 to n-1, using a helper to check primality for each number.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n    return primes\n```"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lowercase_consistent = True\n    all_uppercase_consistent = True\n\n    for key in dict.keys():\n        try:\n            # Check for lowercase consistency across all keys.\n            if key != key.lower():\n                all_lowercase_consistent = False\n            # Check for uppercase consistency across all keys.\n            if key != key.upper():\n                all_uppercase_consistent = False\n        except AttributeError:\n            # If a key does not have .lower() or .upper() (e.g., not a string), return False.\n            return False\n\n    return all_lowercase_consistent or all_uppercase_consistent"}
{"task_id": "HumanEval/93", "solution": "_VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n_ALPHABET_MAP_LOWER = {}\n_ALPHABET_MAP_UPPER = {}\n\n# Pre-compute alphabet shift mappings for efficiency.\nfor i in range(26):\n    char_lower = chr(ord('a') + i)\n    char_upper = chr(ord('A') + i)\n\n    _ALPHABET_MAP_LOWER[char_lower] = chr(ord('a') + (i + 2) % 26)\n    _ALPHABET_MAP_UPPER[char_upper] = chr(ord('A') + (i + 2) % 26)\n\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing\n    vowels with the letter 2 places ahead in the alphabet.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            is_lower = char.islower()\n            processed_char = char\n\n            # Apply vowel replacement first, preserving original case.\n            if char.lower() in _VOWELS_LOWER:\n                if is_lower:\n                    processed_char = _ALPHABET_MAP_LOWER[char]\n                else:\n                    processed_char = _ALPHABET_MAP_UPPER[char]\n\n            # Then, swap the case of the resulting alphabetic character.\n            if processed_char.islower():\n                processed_char = processed_char.upper()\n            else:\n                processed_char = processed_char.lower()\n        else:\n            # Preserve non-alphabetic characters without modification.\n            processed_char = char\n        encoded_chars.append(processed_char)\n    return \"\".join(encoded_chars)"}
