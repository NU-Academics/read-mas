{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube of some integer number.\n    Handles positive, negative, and zero inputs using floating-point cube root and rounding.\n    '''\n    if a == 0:\n        return True\n    \n    # Calculate the integer cube root of the absolute value of 'a'.\n    # `round()` mitigates floating-point inaccuracies for integer comparisons.\n    abs_a = abs(a)\n    cbrt_int = round(abs_a**(1/3))\n    \n    # Re-cube the integer root with the correct sign and compare with the original number.\n    if a < 0:\n        return (-cbrt_int)**3 == a\n    else:\n        return cbrt_int**3 == a\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    '''\n    if a == 0:\n        return True\n    \n    # Calculate the approximate cube root of the absolute value, then round to the nearest integer.\n    cube_root_approx = round(abs(a)**(1/3))\n    \n    # Cube the rounded root and compare with 'a', considering its original sign.\n    if a > 0:\n        return cube_root_approx * cube_root_approx * cube_root_approx == a\n    else: # a < 0\n        return -cube_root_approx * -cube_root_approx * -cube_root_approx == a"}
{"task_id": "HumanEval/75", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Helper function to check if a number is prime.\n    It returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef get_prime_factors(n: int) -> list[int]:\n    \"\"\"Helper function to find all distinct prime factors of a number.\n    It returns a sorted list of unique prime factors.\n    \"\"\"\n    factors = set()\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            factors.add(d)\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.add(temp_n)\n    return sorted(list(factors))\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    \"\"\"\n    if not (0 < a < 100):\n        return False\n\n    factors = get_prime_factors(a)\n    \n    if len(factors) != 3:\n        return False\n    \n    product = 1\n    for factor in factors:\n        product *= factor\n    \n    return product == a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases. x is a simple power of n if n**int=x\"\"\"\n\n    if n == 1:\n        return x == 1\n\n    if x == 1:\n        return True\n\n    current_power = n\n    while current_power < x:\n        current_power *= n\n    \n    return current_power == x"}
