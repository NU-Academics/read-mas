{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \"\"\"\n    def has_even_digit(number: int) -> bool:\n        \"\"\"Checks if an integer contains any even digits.\"\"\"\n        # Iterate through each digit of the number after converting it to a string.\n        for digit_char in str(number):\n            # If any digit is even, return True immediately.\n            if int(digit_char) % 2 == 0:\n                return True\n        return False\n\n    filtered_list = []\n    # Process each number in the input list based on digit parity.\n    for number in x:\n        if not has_even_digit(number):\n            filtered_list.append(number)\n    \n    # Sort the collected numbers in increasing order.\n    filtered_list.sort()\n    return filtered_list\n```"}
{"task_id": "HumanEval/104", "solution": "def _has_even_digit(n):\n    \"\"\"Checks if an integer contains any even digits (0, 2, 4, 6, 8).\"\"\"\n    s = str(n)\n    for digit_char in s:\n        if int(digit_char) % 2 == 0:\n            return True\n    return False\n\ndef unique_digits(x):\n    \"\"\"Filters a list of positive integers, keeping only numbers without even digits, then sorts the result.\"\"\"\n    result = []\n    for num in x:\n        if not _has_even_digit(num):\n            result.append(num)\n    result.sort()\n    return result"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers in a range and returns its binary string.\n    Returns -1 if the start integer n is greater than the end integer m.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the count of integers and their sum using the arithmetic progression formula.\n    count = m - n + 1\n    sum_val = count * (n + m) // 2\n\n    # Compute the floating-point average and then round it to the nearest integer.\n    average_float = sum_val / count\n    rounded_int = round(average_float)\n\n    # Convert the rounded integer to its binary string representation.\n    return bin(rounded_int)"}
{"task_id": "HumanEval/105", "solution": "```python\ndef by_length(arr):\n    \"\"\"\n    Processes an array of integers by filtering, sorting, reversing,\n    and converting specific digits to their English word representations.\n    \"\"\"\n    \n    digit_words = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    if not arr:\n        return []\n\n    # Filter to include only integers between 1 and 9, inclusive.\n    filtered_arr = [n for n in arr if 1 <= n <= 9]\n\n    # Sort the filtered integers in ascending order.\n    sorted_arr = sorted(filtered_arr)\n\n    # Reverse the order of the sorted integers.\n    reversed_arr = sorted_arr[::-1]\n\n    # Replace each integer with its corresponding English word name.\n    result_words = [digit_words[digit] for digit in reversed_arr]\n\n    return result_words\n```"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n):\n    \"\"\"Generates a list of `n` numbers. Each element `i` (1-based) is `i!` if `i` is even, or `sum(1..i)` if `i` is odd.\"\"\"\n\n    def _factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        if num < 0:\n            return 1 \n        res = 1\n        for i in range(1, num + 1):\n            res *= i\n        return res\n\n    def _sum_up_to_n(num: int) -> int:\n        \"\"\"Calculates the sum of positive integers from 1 up to num.\"\"\"\n        if num < 0:\n            return 0\n        return num * (num + 1) // 2\n\n    if n <= 0:\n        return []\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index (1-based)\n            result_list.append(_factorial(i))\n        else:  # Odd index (1-based)\n            result_list.append(_sum_up_to_n(i))\n    return result_list\n```"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    DIGIT_NAMES = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter: Keep numbers between 1 and 9 inclusive.\n    # Per critical requirements, no isinstance() checks are performed.\n    filtered_numbers = [num for num in arr if 1 <= num <= 9]\n\n    # Sort in ascending order.\n    filtered_numbers.sort()\n\n    # Reverse the sorted array.\n    reversed_numbers = filtered_numbers[::-1]\n\n    # Replace each digit by its corresponding name.\n    result_words = [DIGIT_NAMES.get(num, \"\") for num in reversed_numbers]\n\n    return result_words"}
{"task_id": "HumanEval/106", "solution": "def _calculate_factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\n    This internal helper assumes `num` is a positive integer or zero.\"\"\"\n    if num == 0:\n        return 1\n    result = 1\n    for k in range(1, num + 1):\n        result *= k\n    return result\n\ndef _calculate_sum_up_to(num: int) -> int:\n    \"\"\"Calculates the sum of numbers from 1 to num.\n    This internal helper uses the arithmetic series formula.\"\"\"\n    return num * (num + 1) // 2\n\ndef f(n: int) -> list[int]:\n    \"\"\"Implement the function f that takes n as a parameter,\n    and returns a list of size n based on index parity.\"\"\"\n    if n == 0:\n        return []\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result.append(_calculate_factorial(i))\n        else:  # i is odd\n            result.append(_calculate_sum_up_to(i))\n    return result"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Check if the number is a palindrome by comparing its string representation with its reverse.\n        if str(i) == str(i)[::-1]:\n            # Classify the palindrome as even or odd based on its modulo 2 result.\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n                \n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by any number of right shift operations.\n    Returns True if sortable or empty, False otherwise.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    pivot_count = 0\n    pivot_idx = -1\n\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            pivot_count += 1\n            pivot_idx = i\n\n    if pivot_count == 0:\n        # Already sorted.\n        return True\n    elif pivot_count == 1:\n        # Check if the array is cyclically sorted with one \"break\" point.\n        return arr[n-1] <= arr[0]\n    else:\n        # More than one break point, cannot be sorted by right shifts.\n        return False\n```"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array whose digit sum is positive, treating the first digit\n    of negative numbers as negative (e.g., -123 has digits -1, 2, 3).\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    def _calculate_signed_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for an integer, applying negative sign to the first digit if num is negative.\"\"\"\n        if num == 0:\n            return 0\n        \n        is_negative = num < 0\n        abs_num_str = str(abs(num))\n        \n        digits_list = []\n        for i, digit_char in enumerate(abs_num_str):\n            digit = int(digit_char)\n            if i == 0 and is_negative:\n                digits_list.append(-digit)\n            else:\n                digits_list.append(digit)\n        \n        return sum(digits_list)\n\n    count = 0\n    for num in arr:\n        digit_sum = _calculate_signed_digit_sum(num)\n        if digit_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/108", "solution": "def _sum_digits(n):\n    \"\"\"\n    Calculates the sum of digits for an integer, handling negative numbers\n    where the first digit is negative.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    s = str(n)\n    digit_sum = 0\n    \n    if s[0] == '-':\n        # The first digit after '-' is negative.\n        digit_sum += int(s[1]) * -1\n        # Sum the rest of the digits as positive.\n        for digit_char in s[2:]:\n            digit_sum += int(digit_char)\n    else:\n        # Sum all digits as positive.\n        for digit_char in s:\n            digit_sum += int(digit_char)\n            \n    return digit_sum\n\ndef count_nums(arr):\n    \"\"\"\n    Counts elements in an integer array where the sum of digits is positive.\n    The digit sum rule applies for negative numbers too.\n    \"\"\"\n    count = 0\n    for num in arr:\n        if _sum_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by right shifts.\n    Returns True if sortable, False otherwise.\"\"\"\n\n    if not arr:\n        return True\n\n    def is_sorted_helper(current_array_to_check):\n        \"\"\"Checks if the given array is sorted non-decreasingly.\n        Handles empty or single-element arrays as sorted.\"\"\"\n        if len(current_array_to_check) <= 1:\n            return True\n        for i in range(len(current_array_to_check) - 1):\n            if current_array_to_check[i] > current_array_to_check[i+1]:\n                return False\n        return True\n\n    def right_shift_helper(current_array_to_shift):\n        \"\"\"Performs a single right-shift operation on the array.\n        Moves the last element to the first position.\"\"\"\n        if not current_array_to_shift:\n            return []\n        return [current_array_to_shift[-1]] + current_array_to_shift[:-1]\n\n    n = len(arr)\n    current_arr = list(arr) # Create a mutable copy.\n\n    for _ in range(n):\n        if is_sorted_helper(current_arr):\n            return True\n        current_arr = right_shift_helper(current_arr)\n    \n    return False"}
{"task_id": "HumanEval/110", "solution": "```python\ndef exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can become all even by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n    \n    odd_count_lst1 = 0\n    for num in lst1:\n        if num % 2 != 0:\n            odd_count_lst1 += 1\n\n    even_count_lst2 = 0\n    for num in lst2:\n        if num % 2 == 0:\n            even_count_lst2 += 1\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of the letter(s) with the most repetitions and their corresponding count.\n    If several letters have the same occurrence, all of them are returned.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = [letter for letter in test.split(' ') if letter]\n\n    if not letters:\n        return {}\n\n    letter_counts = {}\n    for letter in letters:\n        letter_counts[letter] = letter_counts.get(letter, 0) + 1\n\n    max_count = 0\n    max_count = max(letter_counts.values())\n\n    result = {\n        letter: count\n        for letter, count in letter_counts.items()\n        if count == max_count\n    }\n    return result"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing space-separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\"\"\"\n\n    if not test:\n        return {}\n\n    tokens = test.split(' ')\n    \n    # Filter out empty strings that might result from multiple spaces or leading/trailing spaces.\n    letters = [token for token in tokens if token] \n\n    if not letters:\n        return {}\n\n    counts = {}\n    for letter in letters:\n        counts[letter] = counts.get(letter, 0) + 1\n        \n    max_count = max(counts.values())\n\n    result = {letter: count for letter, count in counts.items() if count == max_count}\n    return result"}
