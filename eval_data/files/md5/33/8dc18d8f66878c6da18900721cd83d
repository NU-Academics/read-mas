{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates groups of nested parentheses into individual strings.\n    It ignores spaces and extracts fully balanced, non-overlapping groups.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    groups: List[str] = []\n    balance = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # A group is complete when balance returns to 0 after a closing parenthesis\n        if balance == 0 and char == ')':\n            groups.append(cleaned_string[start_index : i + 1])\n            start_index = i + 1\n        \n    return groups\n\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates balanced, non-nested parenthesis groups from an input string, ignoring spaces.\n    Returns a list of these groups as strings.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    result: List[str] = []\n    current_group: List[str] = []\n    balance: int = 0\n\n    for char in paren_string:\n        if char == ' ':\n            continue\n\n        current_group.append(char)\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and current_group:\n            result.append(\"\".join(current_group))\n            current_group = []\n\n    return result\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Determines if any two numbers in the list are strictly closer than the threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n\n    if len(numbers) < 2:\n        return False\n\n    # Sort the list to optimize the comparison to O(N log N).\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a number 'delimeter' between every two consecutive elements of the input list.\n    It returns a new list with the delimeter interspersed.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    Calculates the Mean Absolute Deviation (MAD) for a given list of numbers.\n    MAD is the average absolute difference between each element and the mean\n    of the dataset.\n    \"\"\"\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(numbers)\n    return mad"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # FR1: Calculate Mean\n    mean_val = sum(numbers) / len(numbers)\n\n    # FR2: Calculate Absolute Differences\n    absolute_differences = [abs(x - mean_val) for x in numbers]\n\n    # FR3: Calculate Mean Absolute Deviation\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef _calculate_depth(group: str) -> int:\n    \"\"\"\n    Calculates the deepest level of nesting for a single group of parentheses.\n    It tracks the current and maximum nesting levels.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n            # Current depth might go negative for unmatched closing parens, but max_depth remains unaffected.\n    return max_depth\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of multiple groups for nested parentheses separated by spaces.\n    For each group, outputs the deepest level of nesting of parentheses.\n    \"\"\"\n    if not paren_string:\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        results.append(_calculate_depth(group))\n    return results\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'. \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"\n    Filters an input list of strings, returning only those that contain the given substring.\n    Raises TypeError if strings or substring is None.\n    \"\"\"\n    if strings is None:\n        raise TypeError(\"Input 'strings' list cannot be None.\")\n    if substring is None:\n        raise TypeError(\"Input 'substring' cannot be None.\")\n\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product.\n    An empty list should return a sum of 0 and a product of 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)\n```"}
