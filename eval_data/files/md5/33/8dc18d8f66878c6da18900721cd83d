{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n\n    def is_prime(n):\n        # Checks if a number is prime using an optimized trial division.\n        # No error checks for type or value, trusting input as per requirements.\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "```python\ndef prime_length(string):\n    \"\"\"Checks if the string length is a prime number.\n    Returns True if prime, False otherwise.\"\"\"\n\n    def _is_prime(number):\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    \n    # Calculate the sum of decimal digits of N.\n    decimal_sum = 0\n    temp_N = N\n    if temp_N == 0:\n        decimal_sum = 0\n    else:\n        while temp_N > 0:\n            decimal_sum += temp_N % 10\n            temp_N //= 10\n            \n    # Convert the calculated decimal sum into its binary string representation.\n    if decimal_sum == 0:\n        return \"0\"\n    \n    binary_digits = []\n    temp_num = decimal_sum\n    while temp_num > 0:\n        binary_digits.append(str(temp_num % 2))\n        temp_num //= 2\n    \n    return \"\".join(reversed(binary_digits))"}
{"task_id": "HumanEval/81", "solution": "from typing import List\n\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"Converts a list of numerical GPAs to a list of letter grades.\n    It uses a predefined grading scale to map each GPA.\n    \"\"\"\n    \n    def _convert_single_gpa(gpa: float) -> str:\n        \"\"\"Converts a single GPA to its corresponding letter grade.\"\"\"\n        if gpa >= 4.0:\n            return \"A+\"\n        elif gpa > 3.7:\n            return \"A\"\n        elif gpa > 3.3:\n            return \"A-\"\n        elif gpa > 3.0:\n            return \"B+\"\n        elif gpa > 2.7:\n            return \"B\"\n        elif gpa > 2.3:\n            return \"B-\"\n        elif gpa > 2.0:\n            return \"C+\"\n        elif gpa > 1.7:\n            return \"C\"\n        elif gpa > 1.3:\n            return \"C-\"\n        elif gpa > 1.0:\n            return \"D+\"\n        elif gpa > 0.7:\n            return \"D\"\n        elif gpa > 0.0:\n            return \"D-\"\n        else:\n            return \"E\"\n\n    return [_convert_single_gpa(gpa) for gpa in grades]"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The input N is an integer within 0 <= N <= 10000.\n    \"\"\"\n    \n    total_sum = 0\n    temp_N = N\n    if temp_N == 0:\n        total_sum = 0\n    else:\n        while temp_N > 0:\n            total_sum += temp_N % 10\n            temp_N //= 10\n            \n    decimal_num = total_sum\n    \n    if decimal_num == 0:\n        return \"0\"\n    \n    binary_representation = \"\"\n    temp_num = decimal_num\n    while temp_num > 0:\n        binary_representation = str(temp_num % 2) + binary_representation\n        temp_num //= 2\n    \n    return binary_representation"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Applies Inclusion-Exclusion: (starts with 1) + (ends with 1) - (starts and ends with 1).\n        # This simplifies to 18 * 10^(n-2) for n > 1.\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    \n    for gpa in grades:\n        if gpa > 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        else: # gpa <= 0.0, includes 0.0 and any negative values\n            letter_grades.append(\"E\")\n            \n    return letter_grades\n```"}
