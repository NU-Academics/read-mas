{"task_id": "HumanEval/103", "solution": "def _calculate_sum_range(n: int, m: int) -> int:\n    \"\"\"Calculates the sum of integers from n to m using the arithmetic series formula.\"\"\"\n    count = m - n + 1\n    return count * (n + m) // 2\n\ndef _calculate_count_range(n: int, m: int) -> int:\n    \"\"\"Calculates the number of integers in the range [n, m].\"\"\"\n    return m - n + 1\n\ndef _round_to_nearest_int(value: float) -> int:\n    \"\"\"Rounds a floating-point number to the nearest integer using Python's round-half-to-even behavior.\"\"\"\n    return round(value)\n\ndef _to_binary_string(value: int) -> str:\n    \"\"\"Converts an integer to its binary string representation, prefixed with '0b'.\"\"\"\n    return bin(value)\n\ndef rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers in a range and returns its binary string representation,\n    or -1 for invalid ranges.\n    \"\"\"\n    if n > m:\n        return -1\n\n    sum_val = _calculate_sum_range(n, m)\n    count_val = _calculate_count_range(n, m)\n    \n    average_float = sum_val / count_val\n    rounded_avg_int = _round_to_nearest_int(average_float)\n    \n    return _to_binary_string(rounded_avg_int)"}
