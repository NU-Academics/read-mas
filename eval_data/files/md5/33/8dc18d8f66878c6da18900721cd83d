{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of its first and last element sum.\n    Ascending if sum is odd, descending if sum is even; empty or single-element arrays are returned as is.\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    array_copy = list(array)\n\n    if sum_first_last % 2 != 0:\n        array_copy.sort()\n    else:\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the sum of its first and last elements.\n    Ascending if sum is odd, descending if sum is even.\n    \"\"\"\n    if not array or len(array) == 1:\n        return array[:]\n\n    copied_array = array[:]\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 != 0:\n        return sorted(copied_array)\n    else:\n        return sorted(copied_array, reverse=True)\n```"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer x in a nested list and returns their 0-indexed coordinates.\n    Coordinates are sorted by row ascending, then by column descending for elements in the same row.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, item in enumerate(row):\n            if item == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    return sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))\n```"}
{"task_id": "HumanEval/87", "solution": "```python\nfrom typing import List, Tuple\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of integer `x` in the nested list `lst` and returns their 0-indexed (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates: List[Tuple[int, int]] = []\n    for row_idx, row_list in enumerate(lst):\n        for col_idx, value in enumerate(row_list):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort by row ascending (coord[0]), then by column descending (-coord[1]).\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates\n```"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count of n-digit numbers starting with 1: first digit is 1, remaining n-1 digits can be 0-9.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1: last digit is 1, first digit 1-9 (9 choices),\n    # middle n-2 digits (if n>2) can be 0-9.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting AND ending with 1: first and last digits are 1,\n    # middle n-2 digits (if n>2) can be 0-9.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the Principle of Inclusion-Exclusion: |A U B| = |A| + |B| - |A intersect B|\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
