{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Calculates the area of a triangle given its three side lengths. Returns the area\n    rounded to 2 decimal places, or -1.0 if the sides do not form a valid triangle.\n    '''\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if the object q will fly based on its balance and total weight.\n    It returns True if q is palindromic and its sum is less than or equal to w.\n    \"\"\"\n    if q != q[::-1]:\n        return False\n\n    total_weight = sum(q)\n\n    return total_weight <= w"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\nclass MathUtils:\n    def round_to_two_decimals(self, value: float) -> float:\n        \"\"\"Rounds a float value to two decimal places.\"\"\"\n        return round(value, 2)\n\nclass TriangleService:\n    def __init__(self, math_utils: MathUtils):\n        self.math_utils = math_utils\n\n    def is_valid_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if side lengths form a valid triangle.\n        Considers positive sides and triangle inequality theorem.\n        \"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\n    def calculate_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"\n        Calculates triangle area using Heron's formula.\n        Assumes valid triangle input.\n        \"\"\"\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        # Handle potential floating point inaccuracies near zero for area_squared\n        if area_squared < 0:\n            area_squared = 0\n        return math.sqrt(area_squared)\n\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal points or -1 if invalid.\n    \"\"\"\n    math_utils = MathUtils()\n    triangle_service = TriangleService(math_utils)\n\n    if not triangle_service.is_valid_triangle(a, b, c):\n        return -1.0\n    \n    raw_area = triangle_service.calculate_area(a, b, c)\n    return math_utils.round_to_two_decimals(raw_area)\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef _count_total_chars(str_list):\n    \"\"\"\n    Calculates the total number of characters across all strings in a list.\n    Handles empty lists by returning 0.\n    \"\"\"\n    total = 0\n    for s in str_list:\n        total += len(s)\n    return total\n\ndef total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character count.\n    Returns the list with fewer characters; if counts are equal, the first list (lst1) is returned.\n    \"\"\"\n    count1 = _count_total_chars(lst1)\n    count2 = _count_total_chars(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    \"\"\"Compares two lists of strings by total character count, returning the one with fewer characters.\n    If counts are equal, the first list is returned.\"\"\"\n\n    def calculate_total_chars_inline(str_list):\n        \"\"\"Calculates the sum of lengths of all strings in a given list.\"\"\"\n        total_chars = 0\n        for s in str_list:\n            total_chars += len(s)\n        return total_chars\n\n    total_chars_lst1 = calculate_total_chars_inline(lst1)\n    total_chars_lst2 = calculate_total_chars_inline(lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2\n```"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the product of exactly three distinct prime numbers.\n    Assumes `a` is an integer between 1 and 99 (exclusive of 0 and 100).\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Determines if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _generate_primes_up_to(limit):\n        \"\"\"Generates a list of prime numbers less than the given limit.\"\"\"\n        primes = []\n        for num in range(2, limit):\n            if _is_prime(num):\n                primes.append(num)\n        return primes\n\n    primes = _generate_primes_up_to(a)\n\n    n_primes = len(primes)\n    # Iterate through all unique combinations of three distinct primes\n    for i in range(n_primes):\n        for j in range(i + 1, n_primes):\n            for k in range(j + 1, n_primes):\n                p1 = primes[i]\n                p2 = primes[j]\n                p3 = primes[k]\n                \n                # Check for multiplication overflow before actual product to avoid large numbers if a was larger\n                # Though for a < 100, direct multiplication is safe.\n                if p1 * p2 * p3 == a:\n                    return True\n                    \n    return False"}
