{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n.\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\"Finds a single real zero for a polynomial with coefficients xs.\n    The function assumes inputs satisfy preconditions guaranteeing a solution.\n    \"\"\"\n    # Internal helper to evaluate the polynomial, adhering to the \"same code block\" rule.\n    def _local_poly_eval(coefficients: list[float], point: float) -> float:\n        return sum([coeff * math.pow(point, i) for i, coeff in enumerate(coefficients)])\n\n    DEFAULT_TOLERANCE = 1e-6\n    MAX_ITERATIONS = 100\n    MAX_SEARCH_EXPANSIONS = 10 # Limit for expanding the initial search range\n\n    # Initialize search range\n    search_radius = 10.0\n    a, b = -search_radius, search_radius\n    fa = _local_poly_eval(xs, a)\n    fb = _local_poly_eval(xs, b)\n\n    # Expand the search range until a sign change is found or max expansions reached.\n    # This handles cases where initial [-10, 10] does not bracket a root.\n    for _ in range(MAX_SEARCH_EXPANSIONS):\n        if fa * fb <= 0:  # Found a bracket or a root at an endpoint\n            break\n        search_radius *= 2\n        a, b = -search_radius, search_radius\n        fa = _local_poly_eval(xs, a)\n        fb = _local_poly_eval(xs, b)\n    # If no bracket is found after expansions, we proceed with the last expanded range,\n    # trusting the caller's input implies a solution is findable.\n\n    # Bisection method implementation\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        f_mid = _local_poly_eval(xs, mid)\n\n        if abs(f_mid) < DEFAULT_TOLERANCE:\n            return mid\n\n        # Adjust the interval based on the sign of f_mid\n        if fa * f_mid < 0:\n            b = mid\n            fb = f_mid # Update function value for new 'b'\n        else:\n            a = mid\n            fa = f_mid # Update function value for new 'a'\n\n    # If max_iterations are exhausted, return the midpoint of the last interval.\n    # No error is raised as per critical requirements.\n    return (a + b) / 2\n```"}
{"task_id": "HumanEval/36", "solution": "class DigitCounter:\n    \"\"\"Counts occurrences of a specific digit within an integer.\"\"\"\n    def count_digit(self, number: int, digit: int) -> int:\n        \"\"\"Counts how many times a specific digit appears in the number.\"\"\"\n        count = 0\n        num_str = str(number)\n        digit_str = str(digit)\n        for char in num_str:\n            if char == digit_str:\n                count += 1\n        return count\n\nclass FizzBuzzCalculator:\n    \"\"\"Orchestrates the main logic for FizzBuzz digit counting.\"\"\"\n    def __init__(self, digit_counter: DigitCounter):\n        \"\"\"Initializes the calculator with a DigitCounter dependency.\"\"\"\n        self._digit_counter = digit_counter\n\n    def calculate_fizz_buzz(self, n: int) -> int:\n        \"\"\"Calculates the total number of '7's in qualifying numbers less than n.\"\"\"\n        # Input validation removed as per critical requirement.\n        total_sevens = 0\n        for i in range(1, n):\n            if self._is_divisible_by_11_or_13(i):\n                total_sevens += self._digit_counter.count_digit(i, 7)\n        return total_sevens\n\n    def _is_divisible_by_11_or_13(self, number: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (number % 11 == 0) or (number % 13 == 0)\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    digit_counter = DigitCounter()\n    calculator = FizzBuzzCalculator(digit_counter)\n    return calculator.calculate_fizz_buzz(n)"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    Groups of fewer than three characters remain unchanged.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    Takes as input a string encoded with encode_cyclic function and returns the decoded string.\n    This reverses the cyclic shift for groups of three characters.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    original_length = len(l)\n\n    even_elements = [l[i] for i in range(0, original_length, 2)]\n    odd_elements = [l[i] for i in range(1, original_length, 2)]\n\n    even_elements.sort()\n\n    result = [None] * original_length\n    even_idx_counter = 0\n    odd_idx_counter = 0\n\n    for i in range(original_length):\n        if i % 2 == 0:\n            result[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n        else:\n            result[i] = odd_elements[odd_idx_counter]\n            odd_idx_counter += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    Returns an encoded string by cyclically shifting groups of three characters.\n    Groups with fewer than three characters are not shifted.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string previously encoded with encode_cyclic, returning the original string.\n    It reverses the cyclic shift for groups of three characters, leaving others unchanged.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Determines if a given number is prime using trial division.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def _generate_fibonacci():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield b\n            a, b = b, a + b\n\n    fib_generator = _generate_fibonacci()\n    prime_fib_count = 0\n    while True:\n        fib_num = next(fib_generator)\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
