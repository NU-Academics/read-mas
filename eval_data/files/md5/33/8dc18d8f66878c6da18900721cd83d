{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shifting digits right by shift.\n    If shift is strictly greater than the number of digits, digits are reversed.\n    \"\"\"\n    s = str(abs(x)) # Convert absolute value to string.\n    n = len(s)\n\n    if n == 0:\n        return \"\"\n    \n    if shift > n: # If shift is strictly greater than number of digits, reverse.\n        return s[::-1]\n    else:\n        effective_shift = shift % n # Calculate effective shift for circular behavior.\n        return s[n - effective_shift:] + s[:n - effective_shift]"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits based on a string detailing apples and oranges and a total fruit count.\n    It extracts apple and orange counts and subtracts them from the total.\n    \"\"\"\n    # Pattern to extract apple and orange counts from the input string.\n    FRUIT_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n    \n    # The input string is trusted to always match the expected format.\n    match = re.fullmatch(FRUIT_PATTERN, s)\n    \n    # Extract apple and orange counts, converting them to integers.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    # Calculate the number of mangoes, assuming all counts are valid and non-negative.\n    return n - (apples + oranges)"}
{"task_id": "HumanEval/68", "solution": "```python\ndef pluck(arr: list[int]) -> list[int, int] | list:\n    \"\"\"\n    Finds the smallest even-valued node and its index from an array.\n    Handles tie-breaking by preferring the smallest index, and returns an empty list if no even values are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    if not arr:\n        return []\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []\n```"}
{"task_id": "HumanEval/69", "solution": "```python\ndef search(lst):\n    \"\"\"\n    Returns the greatest integer that is positive, and has a frequency greater than\n    or equal to its value. Returns -1 if no such value exists.\n    \"\"\"\n    frequency_map = {}\n    for item in lst:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    candidates = []\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n    else:\n        return max(candidates)\n```"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given counts of apples and oranges in a string,\n    and the total number of fruits. It ensures the mango count is non-negative.\n    \"\"\"\n    \n    # Extract apple and orange counts using a regular expression.\n    # The design assumes valid input string format \"X apples and Y oranges\".\n    match = re.search(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    \n    # Trusting caller's inputs as per critical requirements, assuming 'match' will not be None.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    total_known_fruits = apples + oranges\n    mangoes = n - total_known_fruits\n    \n    # Ensure the number of mangoes is non-negative, as per business rule BR1.\n    return max(0, mangoes)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"Finds the smallest even value and its index in a list, prioritizing the smallest index for ties.\n    Returns `[value, index]` or `[]` if no even numbers are found or the list is empty.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer whose frequency in the list is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n    \n    max_qualifying_number = -1\n    for num, freq in frequencies.items():\n        if freq >= num:\n            max_qualifying_number = max(max_qualifying_number, num)\n            \n    return max_qualifying_number"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting is min, then max of remaining, then min, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy to efficiently pick min/max and not modify original.\n    working_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            result.append(working_list.pop(0))\n        else:\n            result.append(working_list.pop())\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/70", "solution": "```python\nfrom typing import List\n\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    # Create a sorted copy of the input list to extract min and max values.\n    # This ensures the original list is not modified.\n    mutable_list = sorted(list(lst))\n    result = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            result.append(mutable_list.pop(0))  # Append the smallest remaining element\n        else:\n            result.append(mutable_list.pop())   # Append the largest remaining element\n        is_min_turn = not is_min_turn\n        \n    return result\n```"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
