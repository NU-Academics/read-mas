{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    # Checks if a given string of parentheses is balanced.\n    def is_balanced(s: str) -> bool:\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0: # The count of open parentheses must not fall below close parentheses.\n                return False\n        return balance == 0 # For a balanced string, the final count must be zero.\n\n    s1, s2 = lst[0], lst[1]\n\n    # Determine if either concatenation forms a balanced parentheses string.\n    if is_balanced(s1 + s2) or is_balanced(s2 + s1):\n        return 'Yes'\n    else:\n        return 'No'\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n    \"\"\"\n    \n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current_n = n\n\n    while current_n != 1:\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n        \n        if current_n % 2 == 0:\n            current_n //= 2\n        else:\n            current_n = 3 * current_n + 1\n            \n    odd_numbers.add(1) # 1 is always part of the sequence and is odd.\n    \n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The list includes all unique odd numbers from the sequence, sorted in increasing order.\n    \"\"\"\n    sequence = []\n    current = n\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    sequence.append(1)  # Always include 1 in the sequence.\n\n    odd_numbers = [num for num in sequence if num % 2 != 0]\n\n    # Convert to set for uniqueness, then back to list and sort.\n    return sorted(list(set(odd_numbers)))\n```"}
{"task_id": "HumanEval/124", "solution": "import re\n\n# Constants defined inline within the code block for `valid_date`.\nDAYS_IN_MONTH = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29  # Max days for February as per requirement\n}\n\nMM_DD_YYYY_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\d{4}$\"\n\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a given date string based on specified rules, returning True if valid.\n    Rules include non-empty string, \"mm-dd-yyyy\" format, and valid month/day ranges.\n    \"\"\"\n    # FR1: The system shall validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # FR2: The system shall validate that the date string adheres to the \"mm-dd-yyyy\" format.\n    match = re.match(MM_DD_YYYY_REGEX, date)\n    if not match:\n        return False\n\n    month = int(match.group(1))\n    day = int(match.group(2))\n    # year = int(match.group(3))  # Year is extracted but not further validated for range.\n\n    # FR3: The system shall validate that the month component is between 1 and 12 (inclusive).\n    # This is partially handled by the regex, but explicit check ensures full compliance.\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: The system shall validate that the day component is within the correct range for its corresponding month.\n    if month not in DAYS_IN_MONTH:\n        return False # Should not happen if month is already validated between 1 and 12.\n\n    max_days = DAYS_IN_MONTH[month]\n    if not (1 <= day <= max_days):\n        return False\n\n    # FR5: The system shall return True if all validation rules are satisfied, otherwise False.\n    return True"}
{"task_id": "HumanEval/125", "solution": "```python\nimport re\n\ndef split_words(txt):\n    '''\n    Given a string, it splits by whitespace, then commas if no whitespace.\n    Otherwise, it counts lowercase letters with odd alphabetical order (a=0, b=1,...z=25).\n    '''\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count\n```"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a date string against specific rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n\n    _DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    def _is_valid_format(date_string_inner: str) -> tuple[int, int, int] | None:\n        \"\"\"Checks if the date string matches 'mm-dd-yyyy' and extracts components.\"\"\"\n        if not date_string_inner:\n            return None\n        \n        match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date_string_inner)\n        if not match:\n            return None\n        \n        month = int(match.group(1))\n        day = int(match.group(2))\n        year = int(match.group(3))\n        return month, day, year\n\n    def _is_valid_month(month_inner: int) -> bool:\n        \"\"\"Validates if the month component is between 1 and 12.\"\"\"\n        return 1 <= month_inner <= 12\n\n    def _is_valid_day(day_inner: int, month_inner: int) -> bool:\n        \"\"\"Validates if the day component is valid for the given month.\"\"\"\n        if not (1 <= day_inner):\n            return False\n        \n        max_days = _DAYS_IN_MONTH.get(month_inner)\n        if max_days is None: \n            return False\n        \n        return day_inner <= max_days\n\n    # Main validation flow as per FR1\n    components = _is_valid_format(date)\n    if components is None:\n        return False\n    \n    month, day, year = components\n    \n    if not _is_valid_month(month):\n        return False\n    \n    if not _is_valid_day(day, month):\n        return False\n        \n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Processes a text string by splitting on whitespace or commas, or counting specific letters.\n    Whitespace splitting takes precedence, followed by comma splitting, then letter counting.\n    '''\n    # Check for common whitespace characters (space, tab, newline, carriage return).\n    if ' ' in txt or '\\t' in txt or '\\n' in txt or '\\r' in txt:\n        return txt.split()\n    # If no whitespace, check for commas.\n    elif ',' in txt:\n        return txt.split(',')\n    # If neither delimiter, count lowercase letters with odd 0-indexed alphabetical order.\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                # Calculate the 0-indexed alphabetical order and check if it's odd.\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list is sorted in ascending order and if no number appears more than twice.\n    Assumes all inputs are non-negative integers as per requirements.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    for i in range(len(lst)):\n        num = lst[i]\n\n        # Check duplicate constraint\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n        # Check ascending order\n        if i > 0 and lst[i] < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "class PrimeChecker:\n    def is_prime(self, n: int) -> bool:\n        \"\"\"\n        Checks if the given integer n is a prime number.\n        Uses trial division up to the square root of n for efficiency.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\nclass IntervalOperationsService:\n    def __init__(self, prime_checker: PrimeChecker):\n        \"\"\"Initializes the service with a PrimeChecker instance.\"\"\"\n        self._prime_checker = prime_checker\n\n    def find_intersection(self, interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n        \"\"\"\n        Determines the intersection of two closed integer intervals.\n        Returns the intersection interval or None if no intersection.\n        \"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        max_start = max(start1, start2)\n        min_end = min(end1, end2)\n\n        if max_start <= min_end:\n            return (max_start, min_end)\n        else:\n            return None\n\n    def calculate_length(self, interval: tuple[int, int]) -> int:\n        \"\"\"\n        Calculates the length of a given closed integer interval.\n        Returns the non-negative integer length.\n        \"\"\"\n        start, end = interval\n        return end - start\n\n    def check_intersection_prime_length(self, interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n        \"\"\"\n        Determines if the length of the intersection of two intervals is a prime number.\n        Returns \"YES\" if prime, \"NO\" otherwise.\n        \"\"\"\n        intersection_interval = self.find_intersection(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = self.calculate_length(intersection_interval)\n\n        if self._prime_checker.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"\n    Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" or \"NO\" based on the length's primality.\n    \"\"\"\n    prime_checker = PrimeChecker()\n    interval_service = IntervalOperationsService(prime_checker)\n    return interval_service.check_intersection_prime_length(interval1, interval2)"}
{"task_id": "HumanEval/126", "solution": "```python\nfrom collections import Counter\n\ndef is_sorted(lst):\n    '''\n    Checks if a list of non-negative integers is sorted in ascending order\n    and if no number appears more than twice.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending (non-decreasing) order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate constraint: no number appears more than twice.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_sign(num):\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_product_of_signs(signs_list):\n        product = 1\n        for sign_val in signs_list:\n            product *= sign_val\n        return product\n\n    def _get_sum_of_magnitudes(numbers_list):\n        total_magnitude_sum = 0\n        for n_val in numbers_list:\n            total_magnitude_sum += abs(n_val)\n        return total_magnitude_sum\n\n    signs = [_get_sign(n) for n in arr]\n    product_of_signs = _get_product_of_signs(signs)\n    sum_of_magnitudes = _get_sum_of_magnitudes(arr)\n\n    return sum_of_magnitudes * product_of_signs\n```"}
{"task_id": "HumanEval/128", "solution": "def _get_sign(n: int) -> int:\n    \"\"\"Returns the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n    if n > 0:\n        return 1\n    elif n < 0:\n        return -1\n    else:\n        return 0\n\ndef _sum_magnitudes(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of magnitudes (absolute values) of integers in an array.\"\"\"\n    return sum(abs(x) for x in arr)\n\ndef _product_signs(arr: list[int]) -> int:\n    \"\"\"Calculates the product of signs of integers in an array. Returns 0 immediately if any element is zero.\"\"\"\n    product = 1\n    for x in arr:\n        sign = _get_sign(x)\n        if sign == 0:\n            return 0\n        product *= sign\n    return product\n\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_mag = _sum_magnitudes(arr)\n    prod_s = _product_signs(arr)\n\n    return sum_mag * prod_s"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef _calculate_intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n    \"\"\"Calculates the intersection of two closed integer intervals.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start > min_end:\n        return None\n    return (max_start, min_end)\n\ndef _calculate_length(interval: tuple[int, int]) -> int:\n    \"\"\"Calculates the length of a closed integer interval as end - start.\"\"\"\n    start, end = interval\n    return end - start\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Determines if a given non-negative integer is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if no intersection.\n    \"\"\"\n    intersection_interval = _calculate_intersection(interval1, interval2)\n\n    if intersection_interval is None:\n        return \"NO\"\n\n    length = _calculate_length(intersection_interval)\n    \n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if no odd digits are found.\"\"\"\n    \n    product = 1\n    found_odd_digit = False\n    \n    # Iterate through the digits of n\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n            \n    return product if found_odd_digit else 0"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of its odd digits. Returns 0 if no odd digits are present.\"\"\"\n\n    product_of_odd = 1\n    found_odd = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product_of_odd *= digit\n            found_odd = True\n\n    return product_of_odd if found_odd else 0\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if n == 0:\n        return [1.0]\n\n    # Initialize sequence with space for tri(n+1) to calculate odd terms up to n.\n    tri_sequence = [0.0] * (n + 2)\n\n    tri_sequence[0] = 1.0\n    tri_sequence[1] = 3.0\n\n    # Calculate even terms first, up to tri(n+1) for later odd term calculations.\n    for k in range(2, n + 2):\n        if k % 2 == 0:\n            tri_sequence[k] = 1.0 + k / 2.0\n\n    # Then calculate odd terms up to tri(n), using previously computed values.\n    for k in range(3, n + 1):\n        if k % 2 != 0:\n            tri_sequence[k] = tri_sequence[k - 1] + tri_sequence[k - 2] + tri_sequence[k + 1]\n\n    return tri_sequence[:n + 1]\n```"}
{"task_id": "HumanEval/129", "solution": "import heapq\nimport functools\nfrom typing import List, Tuple, Any\n\ndef is_valid_coordinate(r: int, c: int, N: int) -> bool:\n    \"\"\"Checks if a coordinate is within grid boundaries.\"\"\"\n    return 0 <= r < N and 0 <= c < N\n\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_coords(self) -> Tuple[int, int]:\n        \"\"\"Returns the (row, col) coordinates of the cell.\"\"\"\n        return (self._row, self._col)\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value contained in the cell.\"\"\"\n        return self._value\n\n    def __eq__(self, other: Any) -> bool:\n        \"\"\"Compares two cells based on their coordinates.\"\"\"\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self._row == other._row and self._col == other._col\n\n    def __hash__(self) -> int:\n        \"\"\"Enables Cell objects to be used in sets/dicts (based on coordinates).\"\"\"\n        return hash((self._row, self._col))\n\n@functools.total_ordering\nclass Path:\n    \"\"\"Represents a sequence of visited cell values, tracking its length and last cell.\"\"\"\n    def __init__(self, values: List[int], last_cell: Cell, length: int):\n        self._values = values\n        self._last_cell = last_cell\n        self._length = length\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the ordered list of values of cells visited in this path.\"\"\"\n        return self._values\n\n    def get_last_cell(self) -> Cell:\n        \"\"\"Returns the Cell object representing the last cell visited.\"\"\"\n        return self._last_cell\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return self._length\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison for priority queue.\"\"\"\n        return self._values < other._values\n\n    def __eq__(self, other: Any) -> bool:\n        \"\"\"Compares two paths for equality based on their values.\"\"\"\n        if not isinstance(other, Path):\n            return NotImplemented\n        return self._values == other._values\n\nclass Grid:\n    \"\"\"Manages the 2D grid structure, providing access to cells and their neighbors.\"\"\"\n    def __init__(self, grid_data: List[List[int]]):\n        self._N = len(grid_data)\n        self._cells: List[List[Cell]] = [[\n            Cell(r, c, grid_data[r][c]) for c in range(self._N)\n        ] for r in range(self._N)]\n\n    def get_cell(self, r: int, c: int) -> Cell:\n        \"\"\"Returns the Cell object at (r, c).\"\"\"\n        return self._cells[r][c]\n\n    def get_neighbors(self, cell: Cell) -> List[Cell]:\n        \"\"\"Returns a list of valid Cell objects that are neighbors of the given cell.\"\"\"\n        neighbors_list: List[Cell] = []\n        r, c = cell.get_coords()\n        \n        dr = [-1, 1, 0, 0] # Row changes for Up, Down, Left, Right\n        dc = [0, 0, -1, 1] # Column changes for Up, Down, Left, Right\n\n        for i in range(4):\n            new_r, new_c = r + dr[i], c + dc[i]\n            if is_valid_coordinate(new_r, new_c, self._N):\n                neighbors_list.append(self.get_cell(new_r, new_c))\n        return neighbors_list\n\n    def get_N(self) -> int:\n        \"\"\"Returns the grid dimension N.\"\"\"\n        return self._N\n\nclass MinPathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path of length k.\"\"\"\n    def find_min_path(self, grid: Grid, k: int) -> List[int]:\n        \"\"\"Finds the lexicographically smallest path of length k in the given grid.\"\"\"\n        pq: List[Path] = [] \n\n        N = grid.get_N()\n        for r in range(N):\n            for c in range(N):\n                start_cell = grid.get_cell(r, c)\n                initial_path = Path(values=[start_cell.get_value()],\n                                    last_cell=start_cell,\n                                    length=1)\n                heapq.heappush(pq, initial_path)\n\n        while pq:\n            current_path = heapq.heappop(pq)\n\n            if current_path.get_length() == k:\n                return current_path.get_values()\n\n            if current_path.get_length() < k:\n                last_cell = current_path.get_last_cell()\n                neighbors = grid.get_neighbors(last_cell) \n\n                for neighbor_cell in neighbors:\n                    new_values = current_path.get_values() + [neighbor_cell.get_value()]\n                    new_path = Path(values=new_values,\n                                    last_cell=neighbor_cell,\n                                    length=current_path.get_length() + 1)\n                    heapq.heappush(pq, new_path)\n        \n        return []\n\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a given grid.\n    The path can start from any cell and move to adjacent cells, staying within boundaries.\n    \"\"\"\n    grid_obj = Grid(grid)\n    service = MinPathFinderService()\n    return service.find_min_path(grid_obj, k)"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a single cell in the grid.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def get_coordinates(self) -> tuple[int, int]:\n        \"\"\"Returns the coordinates (row, col) of the cell.\"\"\"\n        return (self.row, self.col)\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two Cell objects based on coordinates and value.\"\"\"\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col and self.value == other.value\n\n    def __hash__(self) -> int:\n        \"\"\"Enables Cell objects to be used in sets/dictionaries.\"\"\"\n        return hash((self.row, self.col, self.value))\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for debugging.\"\"\"\n        return f\"Cell(r={self.row}, c={self.col}, v={self.value})\"\n\n\nclass Path:\n    \"\"\"Represents an ordered sequence of Cell objects, forming a path.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self._cells: list[Cell] = [initial_cell]\n\n    def add_cell(self, cell: Cell) -> None:\n        \"\"\"Appends a Cell to the path.\"\"\"\n        self._cells.append(cell)\n\n    def remove_last_cell(self) -> None:\n        \"\"\"Removes the last Cell from the path for backtracking.\"\"\"\n        if self._cells:\n            self._cells.pop()\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current number of cells in the path.\"\"\"\n        return len(self._cells)\n\n    def to_values(self) -> list[int]:\n        \"\"\"Returns an ordered list of integer values from the cells in the path.\"\"\"\n        return [cell.value for cell in self._cells]\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison for two Path objects.\"\"\"\n        # Assumes paths are of the same length k for comparison.\n        for i in range(len(self._cells)):\n            if self._cells[i].value < other._cells[i].value:\n                return True\n            if self._cells[i].value > other._cells[i].value:\n                return False\n        return False  # Paths are equal, not less.\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two Path objects based on their cell sequences.\"\"\"\n        if not isinstance(other, Path):\n            return NotImplemented\n        return self.to_values() == other.to_values()\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for debugging.\"\"\"\n        return f\"Path({self.to_values()})\"\n\n\nclass GridPathFinder:\n    \"\"\"Orchestrates the search for the lexicographically smallest path.\"\"\"\n    DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n\n    def __init__(self, grid: list[list[int]], k: int):\n        self._grid = grid\n        self._N = len(grid)\n        self._k = k\n        self._min_path: Path | None = None\n\n    def _is_valid_move(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a given (row, col) is within grid boundaries.\"\"\"\n        return 0 <= row < self._N and 0 <= col < self._N\n\n    def _dfs(self, current_cell: Cell, current_path: Path) -> None:\n        \"\"\"Recursively explores paths using Depth-First Search.\"\"\"\n        if current_path.get_length() == self._k:\n            if self._min_path is None or current_path < self._min_path:\n                # Store a copy to prevent modification by subsequent DFS calls.\n                self._min_path = Path(current_path._cells[0])\n                for cell in current_path._cells[1:]:\n                    self._min_path.add_cell(cell)\n            return\n\n        for dr, dc in self.DIRECTIONS:\n            next_row, next_col = current_cell.row + dr, current_cell.col + dc\n            if self._is_valid_move(next_row, next_col):\n                next_cell_value = self._grid[next_row][next_col]\n                next_cell = Cell(next_row, next_col, next_cell_value)\n                \n                current_path.add_cell(next_cell)\n                self._dfs(next_cell, current_path)\n                current_path.remove_last_cell()  # Backtrack\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Initiates the path-finding process from all possible starting cells.\"\"\"\n        for r in range(self._N):\n            for c in range(self._N):\n                initial_cell = Cell(r, c, self._grid[r][c])\n                current_path = Path(initial_cell)\n                self._dfs(initial_cell, current_path)\n        \n        # Returns the values of the minimum path found.\n        if self._min_path:\n            return self._min_path.to_values()\n        return []\n\n\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    This function acts as the public entry point for the path-finding functionality.\n    \"\"\"\n    finder = GridPathFinder(grid, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not a part of a word. A \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # It's isolated if it's the only character, or if the character before it is a space.\n    if len(txt) == 1:\n        return True\n    elif txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates a list of the first n + 1 Tribonacci numbers based on specific recurrence relations.\"\"\"\n    memo = {}\n\n    def _calculate_single_term(idx: int) -> int:\n        if idx in memo:\n            return memo[idx]\n\n        result = 0\n        if idx == 0:\n            result = 1\n        elif idx == 1:\n            result = 3\n        elif idx % 2 == 0:  # idx is even and idx > 0\n            result = 1 + idx // 2\n        else:  # idx is odd and idx > 1\n            # Recurrence for odd idx depends on tri(idx-1), tri(idx-2), and tri(idx+1)\n            term_idx_minus_1 = _calculate_single_term(idx - 1)\n            term_idx_minus_2 = _calculate_single_term(idx - 2)\n            term_idx_plus_1 = _calculate_single_term(idx + 1)\n            result = term_idx_minus_1 + term_idx_minus_2 + term_idx_plus_1\n        \n        memo[idx] = result\n        return result\n\n    # Determine the maximum index that needs to be computed for dependencies.\n    # If n is odd and greater than 1, tri(n) requires tri(n+1) to be known.\n    max_idx_for_dependencies = n\n    if n % 2 != 0 and n > 1:\n        max_idx_for_dependencies = n + 1\n    \n    # Ensure all required terms up to max_idx_for_dependencies are calculated and cached.\n    for i in range(max_idx_for_dependencies + 1):\n        _calculate_single_term(i)\n    \n    # Construct the final sequence for indices 0 to n from the memoized values.\n    sequence = [_calculate_single_term(i) for i in range(n + 1)]\n    \n    return sequence"}
