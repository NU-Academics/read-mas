ger palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    counter = PalindromeCounter()\n\n    for i in range(1, n + 1):\n        palindrome_candidate = IntegerPalindrome(i)\n        if palindrome_candidate.is_palindrome():\n            counter.add_palindrome(palindrome_candidate)\n\n    return counter.get_counts()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/112": [{"task_id": "HumanEval/112", "solution": "def _delete_characters(s: str, c: str) -> str:\n    \"\"\"Removes characters from string s that are present in string c.\"\"\"\n    chars_to_delete = set(c)\n    result = []\n    for char in s:\n        if char not in chars_to_delete:\n            result.append(char)\n    return \"\".join(result)\ndef _is_palindrome(text: str) -> bool:\n    \"\"\"Checks if a given string reads the same backward as forward.\"\"\"\n    return text == text[::-1]\ndef reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    \"\"\"Deletes characters from s found in c, then checks if the resulting string is a palindrome.\"\"\"\n    result_string = _delete_characters(s, c)\n    is_palindrome_status = _is_palindrome(result_string)\n    return (result_string, is_palindrome_status)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    # Helper function to check if an array is sorted in non-decreasing order.\n    def _is_sorted(current_arr_to_check):\n        if not current_arr_to_check:\n            return True\n        for i in range(1, len(current_arr_to_check)):\n            if current_arr_to_check[i] < current_arr_to_check[i - 1]:\n                return False\n        return True\n\n    # Helper function to perform one right shift operation.\n    def _perform_right_shift(current_arr_to_shift):\n        if not current_arr_to_shift:\n            return []\n        # Shifts elements to the right; the last element moves to the front.\n        return current_arr_to_shift[-1:] + current_arr_to_shift[:-1]\n\n    # If the given array is empty, it is considered sorted.\n    if not arr:\n        return True\n\n    n = len(arr)\n    current_arr = list(arr) # Create a mutable copy to perform shifts.\n\n    # Iterate up to N times, as N unique right shifts will cover all permutations\n    # and return to the original state.\n    for _ in range(n):\n        if _is_sorted(current_arr):\n            return True\n        current_arr = _perform_right_shift(current_arr)\n    \n    # If no sorted configuration was found after all possible shifts.\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _count_odd_numbers(numbers: list[int]) -> int:\n        \"\"\"Counts the number of odd elements in an input list.\"\"\"\n        count = 0\n        for num in numbers:\n            if not _is_even(num):\n                count += 1\n        return count\n\n    def _count_even_numbers(numbers: list[int]) -> int:\n        \