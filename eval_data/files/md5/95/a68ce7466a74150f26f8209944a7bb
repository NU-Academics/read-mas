= -1.0:\n        return x == -1.0\n\n    # Case 6: x is negative and n is positive\n    # A positive base raised to any integer power (positive, negative, or zero) will always result in a positive number.\n    if x < 0.0 and n > 0.0:\n        return False\n\n    # General Case: Use logarithms to find the exponent k.\n    # If n**k = x, then k = log_n(x) = log(x) / log(n).\n    # We need to check if k is an integer.\n\n    try:\n        if n > 0.0: # Both x and n are positive (as x < 0 and n > 0 handled)\n            exponent = math.log(x) / math.log(n)\n            # Check if the exponent is an integer within floating-point tolerance.\n            return math.isclose(exponent, round(exponent), abs_tol=1e-9)\n        else: # n < -1.0 (as n=0, 1, -1 handled)\n            # For negative base n, we check the absolute values and then the sign/parity of the exponent.\n            abs_x = abs(x)\n            abs_n = abs(n)\n            \n            exponent_abs = math.log(abs_x) / math.log(abs_n)\n            \n            if not math.isclose(exponent_abs, round(exponent_abs), abs_tol=1e-9):\n                return False\n            \n            k = round(exponent_abs)\n            \n            if x > 0.0: # If target x is positive, k must be an even integer.\n                return k % 2 == 0\n            else: # If target x is negative, k must be an odd integer.\n                return k % 2 != 0\n\n    except (ValueError, ZeroDivisionError):\n        # ValueError occurs if math.log is called with a non-positive number.\n        # ZeroDivisionError occurs if math.log(n) is 0 (i.e., n is 1.0), which is already handled.\n        return False\n\n    return False # Should not be reached if all cases are covered.", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[4722366482869645213695, 4722366482869645213696]]}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "import collections\ndef hex_key(num):\n    \"\"\"Counts the n