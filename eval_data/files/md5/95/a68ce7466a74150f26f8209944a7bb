tor>\" into a Fraction object.\"\"\"\n        num_str, den_str = fraction_str.split('/')\n        return cls(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction, returning a new Fraction object.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    \n    product_fraction = fraction_x.multiply(fraction_n)\n    \n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "import math\nclass SortableInteger:\n    \"\"\"Encapsulates an integer's value, its original index, and calculates/stores the sum of its absolute digits.\"\"\"\n    def __init__(self, value: int, index: int):\n        self._original_value = value\n        self._original_index = index\n        self._sum_of_digits = self._calculate_sum_of_digits(value)\n\n    def get_original_value(self) -> int:\n        \"\"\"Returns the original integer value.\"\"\"\n        return self._original_value\n\n    def get_original_index(self) -> int:\n        \"\"\"Returns the original index.\"\"\"\n        return self._original_index\n\n    def get_sum_of_digits(self) -> int:\n        \"\"\"Returns the calculated sum of digits.\"\"\"\n        return self._sum_of_digits\n\n    def _calculate_sum_of_digits(self, num: int) -> int:\n        \"\"\"Calculates the sum of absolute digits for a given number.\"\"\"\n        s = 0\n        num_abs = abs(num)\n        if num_abs == 0:\n            return 0\n        while num_abs > 0:\n            s += num_abs % 10\n            num_abs //= 10\n        return s\nclass IntegerList:\n    \"\"\"Manages a collection of SortableInteger objects and provides sorting functionality.\"\"\"\n    def __init__(self):\n        self._items: list[SortableInteger] = []\n\n    def add_integer(self, value: int, index: int):\n        \"\"\"Creates and adds a SortableInteger to the collection.\"\"\"\n        self._items.append(SortableInteger(value, index))\n\n    def sort(self):\n        \"\"\"Sorts the internal list based on sum of digits and original index.\"\"\"\n        self._items.sort(key=lambda x: (x.get_sum_of_digits(), x.get_original_index()))\n\n    def get_sorted_values(self) -> list[int]:\n        \"\"\"Returns a list of original integer values from the sorted collection.\"\"\"\n        return [item.get_original_value() for item in self._items]\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If several items have a similar sum of digits, order them based on their original index.\n    \"\"\"\n    integer_list = IntegerList()\n    for i, num in enumerate(nums):\n        integer_list.add_integer(num, i)\n\n    integer_list.sort()\n    return integer_list.get_sorted_values()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Encapsulates file name validation logic.\"\"\"\n\n    def __init__(self, full_name: str):\n        self._full_name = full_name\n        self._prefix: str | None = None\n        self._extension: str | None = None\n        self._parse_components()\n\n    def _is_latin_letter(self, char: str) -> bool:\n        \"\"\"Checks if a character is a Latin letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _count_digits(self) -> int:\n        \"\"\"Counts digits in the full file name.\"\"\"\n        return sum(1 for char in self._full_name if '0' <= char <= '9')\n\n    def _check_dot_count(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self._full_name.count('.') == 1\n\n    def _parse_components(self) -> None:\n        \"\"\"Splits the full name into prefix and extension if a single dot exists.\"\"\"\n        if self._check_dot_count():\n            parts = self._full_name.split('.', 1)\n            self._prefix = parts[0]\n            self._extension = parts[1]\n\n    def _check_prefix_not_empty(self) -> bool:\n        \"\"\"Checks if the prefix is not empty.\"\"\"\n        return self._prefix is not None and len(self._prefix) > 0\n\n    def _check_prefix_starts_with_letter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a Latin letter.\"\"\"\n        return self._prefix is not None and len(self._prefix) > 0 and self._is_latin_letter(self._prefix[0])\n\n    def _check_extension_allowed(self) -> bool:\n        \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n        return self._extension in ['txt', 'exe', 'dll']\n\n    def validate(self) -> bool:\n        \"\"\"Runs all validation checks.\"\"\"\n        if self._count_digits() > 3:\n            return False\n        if not self._check_dot_count():\n            return False\n        if not self._check_prefix_not_empty():\n            return False\n        if not self._check_prefix_starts_with_letter():\n            return False\n        if not self._check_extension_allowed():\n            return False\n        return True\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    validator = FileName(file_name)\n    if validator.validate():\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "class Number:\n    \"\"\"Encapsulates an integer value and provides methods to check its properties.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def getFirstDigit(self) -> int:\n        \"\"\"Returns the first digit of the number, ignoring its sign.\"\"\"\n        return int(str(abs(self._value))[0])\n\n    def getLastDigit(self) -> int:\n        \"\"\"Returns the last digit of the number, ignoring its sign.\"\"\"\n        return int(str(abs(self._value))[-1])\n\n    def isGreaterThanTen(self) -> bool:\n        \"\"\"Checks if the number's value is greater than 10.\"\"\"\n        return self._value > 10\n\n    def isFirstDigitOdd(self) -> bool:\n        \"\"\"Checks if the first digit of the number is odd.\"\"\"\n        return self.getFirstDigit() % 2 != 0\n\n    def isLastDigitOdd(self) -> bool:\n        \"\"\"Checks if the last digit of the number is odd.\"\"\"\n        return self.getLastDigit() % 2 != 0\nclass NumberArray:\n    \"\"\"Manages a collection of Number objects.\"\"\"\n    def __init__(self, raw_numbers: list[int]):\n        self._numbers = [Number(num) for num in raw_numbers]\n\n    def get_numbers(self) -> list[Number]:\n        \"\"\"Returns the list of Number objects.\"\"\"\n        return self._numbers\nclass SpecialFilterProcessor:\n    \"\"\"Implements the core business logic to count special numbers.\"\"\"\n    def process(self, input_numbers: NumberArray) -> int:\n        \"\"\"Iterates through the NumberArray and returns the count of special numbers.\"\"\"\n        count = 0\n        for num_obj in input_numbers.get_numbers():\n            if (num_obj.isGreaterThanTen() and\n                num_obj.isFirstDigitOdd() and\n                num_obj.isLastDigitOdd()):\n                count += 1\n        return count\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    number_array = NumberArray(nums)\n    processor = SpecialFilterProcessor()\n    return processor.process(number_array)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Accepts a list of strings, deletes strings with odd lengths,\n    and returns the resulted list sorted by length (ascending)\n    and then alphabetically for same-length words.\n    \"\"\"\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))\n    return sorted_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "class Match:\n    \"\"\"Represents a single match comparison, holding actual and guessed scores and calculating their difference.\"\"\"\n    def __init__(self, actual_score: int, guessed_score: int):\n        self._actual_score = actual_score\n        self._guessed_score = guessed_score\n\n    def calculate_difference(self) -> int:\n        \"\"\"Computes and returns the absolute difference between the actual and guessed scores.\"\"\"\n        return abs(self._actual_score - self._guessed_score)\n\n    @property\n    def difference(self) -> int:\n        return self.calculate_difference()\ndef compare(game,guess):\n    \"\"\"Determines how far off each guess was for a series of matches.\"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length\")\n\n    differences = []\n    for actual_score, guessed_score in zip(game, guess):\n        match = Match(actual_score, guessed_score)\n        differences.append(match.difference)\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "from typing import List, Dict, Union, Tuple\nclass Planet:\n    \"\"\"Encapsulates the name and orbital order of a single planet.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Planet):\n            return NotImplemented\n        return self.name == other.name\n\n    def __hash__(self) -> int:\n        return hash(self.name)\nclass SolarSystem:\n    \"\"\"Manages the predefined, ordered list of solar system planets.\"\"\"\n    def __init__(self):\n        planet_data = [\n            (\"Mercury\", 0), (\"Venus\", 1), (\"Earth\", 2), (\"Mars\", 3),\n            (\"Jupiter\", 4), (\"Saturn\", 5), (\"Uranus\", 6), (\"Neptune\", 7)\n        ]\n        self._planets_list: List[Planet] = [Planet(name, order) for name, order in planet_data]\n        self._planet_map: Dict[str, Planet] = {planet.name: planet for planet in self._planets_list}\n\n    def get_planet_order(self, planet_name: str) -> Union[int, None]:\n        \"\"\"Returns the 0-based index (order) of a planet, or None if not found.\"\"\"\n        planet = self._planet_map.get(planet_name)\n        return planet.order_from_sun if planet else None\n\n    def is_valid_planet(self, planet_name: str) -> bool:\n        \"\"\"Checks if a given planet name exists in the solar system.\"\"\"\n        return planet_name in self._planet_map\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> List[Planet]:\n        \"\"\"Returns a sorted list of Planet objects located strictly between the two input planets.\"\"\"\n        order1 = self.get_planet_order(planet1_name)\n        order2 = self.get_planet_order(planet2_name)\n\n        if order1 is None or order2 is None:\n            return []\n\n        start_idx = min(order1, order2)\n        end_idx = max(order1, order2)\n\n        # Slice to get planets strictly between them\n        return self._planets_list[start_idx + 1:end_idx]\n_solar_system_instance = SolarSystem()\ndef bf(planet1, planet2):\n    '''\n    Returns a tuple of planets whose orbits are located between planet1 and planet2,\n    sorted by proximity to the sun, or an empty tuple if names are invalid.\n    '''\n    if not _solar_system_instance.is_valid_planet(planet1) or \\\n       not _solar_system_instance.is_valid_planet(planet2):\n        return ()\n\n    between_planets = _solar_system_instance.get_planets_between(planet1, planet2)\n    return tuple(planet.name for planet in between_planets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    is_n_prime = True\n    if n <= 1:\n        is_n_prime = False\n    elif n == 2:\n        is_n_prime = True\n    elif n % 2 == 0:\n        is_n_prime = False\n    else:\n        # Check for odd divisors from 3 up to sqrt(n)\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                is_n_prime = False\n                break\n            i += 2\n            \n    if is_n_prime:\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the difference between uppercase and lowercase letters,\n    and returns a formatted string: ClassName.StrongestExtensionName.\n    \"\"\"\n    def _calculate_strength(extension_name):\n        \"\"\"Calculates the strength of an extension name.\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    if not extensions:\n        return f\"{class_name}.\" # Or raise an error, but spec doesn't ask for error handling\n\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_extension = extensions[i]\n        current_strength = _calculate_strength(current_extension)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    total_sum = 0\n\n    for number in lst:\n        # Ignore negative numbers.\n        if number < 0:\n            continue\n\n        # Ignore non-integers. Check for int or float with zero fractional part.\n        if not (isinstance(number, int) or (isinstance(number, float) and number.is_integer())):\n            continue\n\n        num_as_int = int(number)\n\n        # Identify and process odd numbers.\n        if num_as_int % 2 != 0:\n            total_sum += num_as_int * num_as_int\n\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Convert the absolute value of the number to a string to iterate through its digits.\n    for digit_char in str(abs(num)):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    epsilon = 1e-9 # Use a small epsilon for floating-point comparisons.\n\n    sides = sorted([a, b, c])\n    s1, s2, longest_side = sides[0], sides[1], sides[2]\n\n    # Check if the Pythagorean theorem holds true, accounting for floating-point inaccuracies.\n    return abs(s1**2 + s2**2 - longest_side**2) < epsilon", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n    \n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    \n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "class Word:\n    \"\"\"Encapsulates a string, calculates its unique character count, and provides comparison logic.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._unique_char_count = len(set(value))\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the word.\"\"\"\n        return self._value\n\n    def get_unique_character_count(self) -> int:\n        \"\"\"Returns the number of unique characters in the word.\"\"\"\n        return self._unique_char_count\n\n    def __lt__(self, other: 'Word') -> bool:\n        \"\"\"Implements lexicographical comparison (less than) for tie-breaking.\"\"\"\n        return self._va