{"task_id": "Mbpp/12", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\nclass Element:\n    \"\"\"A conceptual wrapper for a numeric value.\"\"\"\n    def __init__(self, value: Number):\n        self.value = value\n\nclass Row:\n    \"\"\"Represents a row in a matrix, with its elements and original index.\"\"\"\n    def __init__(self, elements: List[Number], original_index: int):\n        self.elements = elements\n        self.original_index = original_index\n\n    def sum(self) -> Number:\n        \"\"\"Returns the numeric sum of elements in the row.\"\"\"\n        return sum(self.elements)\n\nclass Matrix:\n    \"\"\"Represents a matrix as a collection of Row objects.\"\"\"\n    def __init__(self, rows: List['Row']):\n        self.rows = rows\n\n    def sort_rows_by_sum(self) -> 'Matrix':\n        \"\"\"Sorts the rows in-place by their sum in ascending order.\"\"\"\n        self.rows.sort(key=lambda row: row.sum())\n        return self\n\n    def to_list(self) -> List[List[Number]]:\n        \"\"\"Converts the matrix back to a list of lists of numbers.\"\"\"\n        return [row.elements for row in self.rows]\n\ndef sort_matrix(input_matrix: List[List[Number]]) -> List[List[Number]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    \"\"\"\n    row_objects = [Row(elements=row, original_index=i) for i, row in enumerate(input_matrix)]\n    matrix_obj = Matrix(row_objects)\n    matrix_obj.sort_rows_by_sum()\n    return matrix_obj.to_list()"}
{"task_id": "Mbpp/18", "solution": "class SourceString:\n    \"\"\"Domain value object for source input.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass RemoveCharsSet:\n    \"\"\"Domain value object for removeChars input and parsed set of characters.\"\"\"\n    def __init__(self, rawValue: str) -> None:\n        self.rawValue = rawValue\n        self.chars = set(rawValue)\n\nclass ResultString:\n    \"\"\"Domain value object for result output.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass RemoveDirtyCharsFunction:\n    \"\"\"Encapsulates the algorithm to parse removeChars into a set and filter source.\"\"\"\n    def remove(self, source_raw: str, removeChars_raw: str) -> str:\n        source_obj = SourceString(source_raw)\n        remove_chars_obj = RemoveCharsSet(removeChars_raw)\n\n        if not removeChars_raw:\n            return source_obj.value\n        if not source_raw:\n            return ResultString(\"\").value\n\n        result_buffer = []\n        for char in source_obj.value:\n            if char not in remove_chars_obj.chars:\n                result_buffer.append(char)\n\n        return ResultString(\"\".join(result_buffer)).value\n\ndef remove_dirty_chars(source: str, removeChars: str) -> str:\n    \"\"\"Public API to remove characters from the first string that are present in the second string.\"\"\"\n    return RemoveDirtyCharsFunction().remove(source, removeChars)"}
{"task_id": "Mbpp/14", "solution": "from dataclasses import dataclass\nfrom typing import Union\n\nclass VolumeCalculator:\n    \"\"\"Encapsulates validation and computation logic for triangular prism volume.\"\"\"\n\n    def _validate_numeric(self, value) -> bool:\n        \"\"\"Assumes inputs are numeric-compatible, as per requirements.\"\"\"\n        return True\n\n    def _compute_area(self, base: float, height: float) -> float:\n        \"\"\"Calculates the area of the triangular base.\"\"\"\n        return 0.5 * base * height\n\n    def find_Volume(self, base, height, length) -> float:\n        \"\"\"Validates inputs and computes the volume of the triangular prism.\"\"\"\n        self._validate_numeric(base)\n        self._validate_numeric(height)\n        self._validate_numeric(length)\n\n        area = self._compute_area(base, height)\n        volume = area * length\n        return volume\n\ndef find_Volume(base, height, length):\n    \"\"\"Calculates the volume of a triangular prism using its base, height, and length.\"\"\"\n    calculator = VolumeCalculator()\n    return calculator.find_Volume(base, height, length)"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Leading zeros in the reversed number are ignored.\n    \"\"\"\n    s_n = str(n)\n    rev_s_n = s_n[::-1]\n    rev = int(rev_s_n)\n    return n == (2 * rev - 1)"}
{"task_id": "Mbpp/19", "solution": "from typing import Sequence\n\nclass InputArray:\n    \"\"\"Holds a sequence of integers.\"\"\"\n    def __init__(self, elements: Sequence[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass IntegerElement:\n    \"\"\"Represents an integer value and its position.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\nclass DuplicateCheckResult:\n    \"\"\"Holds the boolean result of a duplicate check.\"\"\"\n    def __init__(self, has_duplicates: bool):\n        self.has_duplicates = has_duplicates\n\nclass DuplicateChecker:\n    \"\"\"Encapsulates the algorithm to detect duplicates in a sequence of integers.\"\"\"\n    def test_duplicate(self, array: Sequence[int]) -> bool:\n        \"\"\"\n        Checks if the given array contains any duplicate elements.\n        Uses a set to track seen elements for O(n) average time complexity.\n        \"\"\"\n        seen = set()\n        for element in array:\n            if element in seen:\n                return True\n            seen.add(element)\n        return False\n\n    def run(self, array: Sequence[int]) -> bool:\n        \"\"\"Optional alias for test_duplicate method.\"\"\"\n        return self.test_duplicate(array)\n\ndef test_duplicate(array: Sequence[int]) -> bool:\n    \"\"\"\n    Checks if an array of integers contains any duplicate element.\n    Delegates the core logic to a DuplicateChecker instance.\n    \"\"\"\n    checker = DuplicateChecker()\n    return checker.test_duplicate(array)"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\n\n@dataclass\nclass InputString:\n    \"\"\"Data holder for raw input string.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\nclass RegexPattern:\n    \"\"\"Holds the literal regex pattern string.\"\"\"\n    pattern: str = \"[a-z]+_[a-z]+\"\n\n@dataclass\nclass MatchResult:\n    \"\"\"Container for match outcome.\"\"\"\n    matched: bool\n    matched_substring: Optional[str] = None\n    spans: Optional[List[Tuple[int, int]]] = None\n\n_compiled_pattern_instance: Optional[re.Pattern] = None\n\ndef _compile_pattern() -> re.Pattern:\n    \"\"\"Internal helper to compile the literal pattern into a regex Pattern object, caching it.\"\"\"\n    global _compiled_pattern_instance\n    if _compiled_pattern_instance is None:\n        _compiled_pattern_instance = re.compile(RegexPattern.pattern)\n    return _compiled_pattern_instance\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined with an underscore.\n    Returns True if a match is found, False otherwise.\n    \"\"\"\n    input_obj = InputString(value=input_string)\n    compiled_regex = _compile_pattern()\n    match = compiled_regex.search(input_obj.value)\n\n    if match:\n        # Per design, a MatchResult object is produced internally.\n        _ = MatchResult(\n            matched=True,\n            matched_substring=match.group(0),\n            spans=[(match.start(), match.end())]\n        )\n        return True\n    else:\n        # Per design, a MatchResult object is produced internally.\n        _ = MatchResult(matched=False)\n        return False"}
{"task_id": "Mbpp/20", "solution": "from typing import Optional\n\ndef find_witness(n: int) -> Optional[int]:\n    \"\"\"\n    Finds the witness k for a Woodall number n, if it exists.\n    Returns k if n = k * 2^k - 1 for some k >= 1, otherwise returns None.\n    \"\"\"\n    if n <= 0:\n        return None\n\n    k = 1\n    while True:\n        woodall_candidate = k * (2**k) - 1\n        if woodall_candidate == n:\n            return k\n        # Stop iteration early if candidate exceeds n due to monotonicity.\n        if woodall_candidate > n:\n            return None\n        k += 1\n\ndef is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A number n is Woodall if n = k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    if n <= 0:\n        return False\n    \n    # Delegates the core search to find_witness and returns boolean result.\n    return find_witness(n) is not None"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"Return True if integers a and b have opposite signs, otherwise False.\n\n    If a == 0 or b == 0, return False; otherwise, opposite signs are determined by a * b < 0.\n    \"\"\"\n    if a == 0 or b == 0:\n        return False\n    return (a * b) < 0"}
{"task_id": "Mbpp/57", "solution": "class Validator:\n    def is_list(self, v) -> bool:\n        \"\"\"Checks if the input value is a list.\"\"\"\n        return isinstance(v, list)\n\n    def is_digit(self, v) -> bool:\n        \"\"\"Checks if the input value is an integer digit between 0 and 9.\"\"\"\n        return isinstance(v, int) and 0 <= v <= 9\n\n    def validate_digits(self, digits: list) -> bool:\n        \"\"\"Validates if the input is a list of integer digits 0-9.\"\"\"\n        if not self.is_list(digits):\n            raise TypeError(\"Input must be a list.\")\n        for digit in digits:\n            if not self.is_digit(digit):\n                raise ValueError(\"All elements in the list must be integers between 0 and 9.\")\n        return True\n\nclass Digit:\n    def __init__(self, value: int):\n        \"\"\"Initializes a Digit object with an integer value.\"\"\"\n        self.value = value\n\nclass DigitList:\n    def __init__(self, digits: list):\n        \"\"\"Initializes DigitList with a list of integer digits.\"\"\"\n        self.digits = digits\n\n    def validate(self) -> bool:\n        \"\"\"Validates the digits within this list (redundant if Validator is used externally).\"\"\"\n        validator = Validator()\n        return validator.validate_digits(self.digits)\n\n    def sort_desc(self) -> list:\n        \"\"\"Sorts the digits in descending order.\"\"\"\n        return sorted(self.digits, reverse=True)\n\nclass MaxNumber:\n    @classmethod\n    def from_digits(cls, digits: list) -> int:\n        \"\"\"Forms the largest possible integer from a list of sorted digits.\"\"\"\n        if not digits:\n            return 0\n        s = \"\".join(map(str, digits))\n        return int(s)\n\ndef find_Max_Num(digits):\n    \"\"\"\n    Returns an integer formed by arranging the input digits in descending order.\n    Raises TypeError if digits is not a list; ValueError if an element is not an int in 0-9.\n    \"\"\"\n    validator = Validator()\n    validator.validate_digits(digits)\n\n    digit_list_obj = DigitList(digits)\n    sorted_digits = digit_list_obj.sort_desc()\n\n    result = MaxNumber.from_digits(sorted_digits)\n    return result"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Raises ValueError if the input string contains non-digit characters.\n    \"\"\"\n    def _validate_input(s: str) -> None:\n        \"\"\"Ensures all characters in the string are decimal digits.\"\"\"\n        if not s.isdigit() and s != \"\":\n            raise ValueError(\"Input string must contain only decimal digits.\")\n\n    def _digits_from_string(s: str) -> list[int]:\n        \"\"\"Converts a digit-only string into a list of integer digits.\"\"\"\n        return [int(char) for char in s]\n\n    def _count_matching_substrings(digits: list[int]) -> int:\n        \"\"\"Counts substrings whose digit sum equals their length.\"\"\"\n        count = 0\n        n = len(digits)\n        for i in range(n):\n            current_sum = 0\n            for j in range(i, n):\n                current_sum += digits[j]\n                substring_length = j - i + 1\n                if current_sum == substring_length:\n                    count += 1\n        return count\n\n    if not s:\n        return 0\n\n    _validate_input(s)\n    digits = _digits_from_string(s)\n    return _count_matching_substrings(digits)"}
{"task_id": "Mbpp/59", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Input:\n    \"\"\"Encapsulates raw input and validates it for octagonal number computation.\"\"\"\n    def __init__(self, raw):\n        self.raw = raw\n        self.n = None\n\n    def validate(self) -> bool:\n        \"\"\"Validates if raw input is a positive integer and sets self.n.\"\"\"\n        if not isinstance(self.raw, int):\n            raise ValidationError(\"Input must be an integer.\")\n        if self.raw < 1:\n            raise ValidationError(\"Input must be a positive integer (n >= 1).\")\n        self.n = self.raw\n        return True\n\nclass OctagonalNumber:\n    \"\"\"Computes and stores the nth octagonal number.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value = None\n\n    def compute(self) -> int:\n        \"\"\"Calculates the octagonal number using the formula O_n = 3*n^2 - 2*n.\"\"\"\n        self.value = 3 * self.n**2 - 2 * self.n\n        return self.value\n\n    def getValue(self) -> int:\n        \"\"\"Returns the stored octagonal number value.\"\"\"\n        return self.value\n\ndef is_octagonal(n) -> int:\n    \"\"\"\n    Finds the nth octagonal number using the formula O_n = 3*n^2 - 2*n.\n    Validates input to ensure n is a positive integer.\n    \"\"\"\n    input_validator = Input(raw=n)\n    input_validator.validate()\n\n    octagonal_calculator = OctagonalNumber(n=input_validator.n)\n    return octagonal_calculator.compute()"}
{"task_id": "Mbpp/63", "solution": "from typing import Iterable, Tuple, Union\n\ndef max_difference(pairs: Iterable[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between numbers in available pairs.\n    It iterates through pairs, computes absolute differences, and finds the maximum.\n    \"\"\"\n    max_diff = 0.0  # Initialize with 0.0, as absolute differences are non-negative.\n\n    for pair in pairs:\n        # Assuming each pair is a 2-element iterable as per design context,\n        # relying on Python's default behavior for unpacking.\n        a, b = pair\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff"}
