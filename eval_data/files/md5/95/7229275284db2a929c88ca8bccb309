{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(list_input):\n    \"\"\"\n    Recursively flattens a list and sums all of its integer elements.\n    Assumes elements are either integers or lists of integers/nested lists.\n    \"\"\"\n    total_sum = 0\n    for element in list_input:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        else:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/66", "solution": "def pos_count(list) -> int:\n    \"\"\"Count elements strictly greater than 0.\n\n    Non-numeric element comparisons will raise TypeError, which is allowed to propagate.\n    \"\"\"\n    count = 0\n    for item in list:\n        try:\n            if item > 0:\n                count += 1\n        except TypeError:\n            raise\n    return int(count)"}
{"task_id": "Mbpp/67", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputParameter:\n    \"\"\"Encapsulates and validates an input parameter n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def isInteger(self) -> bool:\n        \"\"\"Checks if n is an integer and not a boolean.\"\"\"\n        return isinstance(self.n, int) and not isinstance(self.n, bool)\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if n is a non-negative number.\"\"\"\n        return self.n >= 0\n\nclass BellNumberResult:\n    \"\"\"A value object to encapsulate the computed Bell number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass BellNumberCalculator:\n    \"\"\"Calculates Bell numbers and orchestrates input validation.\"\"\"\n    def bell_number(self, n) -> int:\n        \"\"\"Validates input n and delegates to compute the Bell number.\"\"\"\n        param = InputParameter(n)\n        if not param.isInteger() or not param.isNonNegative():\n            raise ValidationError(\"n must be a non-negative integer\")\n        \n        value = self.computeBellNumber(n)\n        return BellNumberResult(value).value\n\n    def computeBellNumber(self, n: int) -> int:\n        \"\"\"Computes the Bell number B_n using the Bell triangle algorithm.\"\"\"\n        if n == 0:\n            return 1\n\n        # Initialize a 2D list for the Bell triangle\n        bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: B_0 = 1\n        bell_triangle[0][0] = 1\n\n        for i in range(1, n + 1):\n            # The first element of each row is the last element of the previous row (which is B_{i-1})\n            bell_triangle[i][0] = bell_triangle[i-1][i-1]\n            for j in range(1, i + 1):\n                # Subsequent elements are the sum of the element above and the element to the left\n                bell_triangle[i][j] = bell_triangle[i-1][j-1] + bell_triangle[i][j-1]\n        \n        # The Bell number B_n is the first element of the nth row\n        return bell_triangle[n][0]\n\ndef bell_number(n) -> int:\n    \"\"\"\n    Computes the Bell number B_n, the number of partitions of a set of size n.\n    Validates input and raises ValidationError for invalid n.\n    \"\"\"\n    calculator = BellNumberCalculator()\n    return calculator.bell_number(n)"}
{"task_id": "Mbpp/69", "solution": "from typing import List\n\ndef is_sublist(main_list: List, sublist: List) -> bool:\n    \"\"\"\n    Checks if a sublist appears as a contiguous subsequence of a main list.\n    Raises TypeError if inputs are not lists; an empty sublist is considered present.\n    \"\"\"\n    if not isinstance(main_list, list) or not isinstance(sublist, list):\n        raise TypeError('main_list and sublist must be lists')\n    if len(sublist) == 0:\n        return True\n    if len(sublist) > len(main_list):\n        return False\n    max_start = len(main_list) - len(sublist)\n    for i in range(0, max_start + 1):\n        if main_list[i:i+len(sublist)] == sublist:\n            return True\n    return False"}
{"task_id": "Mbpp/68", "solution": "class MonotonicChecker:\n    \"\"\"Helper class to encapsulate monotonicity checks.\"\"\"\n\n    def is_non_increasing(self, arr):\n        \"\"\"Checks if the array is non-increasing (each element is less than or equal to the previous).\"\"\"\n        if len(arr) <= 1:\n            return True\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i-1]:\n                return False\n        return True\n\n    def is_non_decreasing(self, arr):\n        \"\"\"Checks if the array is non-decreasing (each element is greater than or equal to the previous).\"\"\"\n        if len(arr) <= 1:\n            return True\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i-1]:\n                return False\n        return True\n\n    def is_Monotonic(self, arr):\n        \"\"\"Checks if the array is monotonic, i.e., either non-increasing or non-decreasing.\"\"\"\n        return self.is_non_increasing(arr) or self.is_non_decreasing(arr)\n\ndef is_Monotonic(arr):\n    \"\"\"\n    Checks whether the given array is monotonic or not.\n    An array is monotonic if it is either entirely non-increasing or entirely non-decreasing.\n    \"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(arr)"}
{"task_id": "Mbpp/70", "solution": "from typing import List\n\nclass Tuple:\n    def __init__(self, elements: tuple) -> None:\n        self._elements = elements\n    def length(self) -> int:\n        return len(self._elements)\n\nclass Result:\n    def __init__(self, equal: bool) -> None:\n        self._equal = equal\n    def value(self) -> bool:\n        return self._equal\n\nclass TupleCollection:\n    def __init__(self, tuples: List[tuple]) -> None:\n        self._tuples = tuples\n    def all_lengths_equal(self) -> bool:\n        lengths = [len(t) for t in self._tuples]\n        return all(l == lengths[0] for l in lengths) if lengths else True\n\ndef get_equal(tuples: List[tuple]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n    Delegates evaluation to TupleCollection.\n    \"\"\"\n    collection = TupleCollection(tuples)\n    return collection.all_lengths_equal()"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list):\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm.\n    Returns a new list containing the same elements sorted in ascending order.\n    \"\"\"\n\n    def _next_gap(gap):\n        \"\"\"Computes the next gap value for the comb sort algorithm.\"\"\"\n        gap = int(gap / 1.3)\n        if gap < 1:\n            return 1\n        return gap\n\n    def _comb_sort_inplace(arr):\n        \"\"\"Performs the comb sort algorithm in-place on the given list.\"\"\"\n        n = len(arr)\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = _next_gap(gap)\n            swapped = False\n\n            for i in range(n - gap):\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n\n    n = len(list)\n    if n == 0:\n        return []\n    if n == 1:\n        return list[:]\n\n    arr = list[:]  # Create a shallow copy to avoid mutating the original list\n    _comb_sort_inplace(arr)\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"Return True if integer n can be represented as a difference of two integer squares.\n\n    Behavior: Implements BR-MATH: n is representable iff n % 4 != 2.\n    Input: n (expected int). Behavior for non-int inputs is unspecified in SRS; the function will evaluate using Python's % operator semantics and will surface Python exceptions for unsupported types.\n    Returns: bool\n    \"\"\"\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "import collections.abc\n\nclass Validator:\n    \"\"\"\n    Validates if an object is sequence-like.\n    \"\"\"\n    @staticmethod\n    def validate_sequence_like(obj) -> None:\n        if not isinstance(obj, collections.abc.Sequence):\n            raise TypeError(f\"Expected a sequence-like object, but got {type(obj)}\")\n\nclass PatternMapper:\n    \"\"\"\n    Builds and checks bidirectional maps to enforce bijection semantics.\n    \"\"\"\n    def __init__(self):\n        self.seqToPatternMap = {}\n        self.patternToSeqMap = {}\n\n    def matches(self, seq, pattern) -> bool:\n        \"\"\"\n        Performs a single-pass mapping and consistency check.\n        \"\"\"\n        self.seqToPatternMap = {}\n        self.patternToSeqMap = {}\n\n        for i in range(len(seq)):\n            s_elem = seq[i]\n            p_token = pattern[i]\n\n            # Check seq_element -> pattern_token mapping\n            if s_elem in self.seqToPatternMap:\n                if self.seqToPatternMap[s_elem] != p_token:\n                    return False\n            else:\n                self.seqToPatternMap[s_elem] = p_token\n\n            # Check pattern_token -> seq_element mapping\n            if p_token in self.patternToSeqMap:\n                if self.patternToSeqMap[p_token] != s_elem:\n                    return False\n            else:\n                self.patternToSeqMap[p_token] = s_elem\n        \n        return True\n\ndef is_samepatterns(seq, pattern) -> bool:\n    \"\"\"\n    Checks if a sequence follows the structural pattern defined by another sequence.\n    \"\"\"\n    Validator.validate_sequence_like(seq)\n    Validator.validate_sequence_like(pattern)\n\n    if len(seq) != len(pattern):\n        return False\n\n    if len(seq) == 0:\n        return True\n\n    mapper = PatternMapper()\n    return mapper.matches(seq, pattern)"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number) -> bool:\n    \"\"\"Return True if integer number is divisible by 11, otherwise False.\n       Business rule: divisibility defined as (number % 11 == 0).\n    \"\"\"\n    return number % 11 == 0"}
{"task_id": "Mbpp/75", "solution": "class Validator:\n    \"\"\"\n    Validates the input list and the divisor k according to specified rules.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n    def validate_input(self, input_list, k):\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an integer.\")\n        if k == 0:\n            raise ValueError(\"k cannot be zero for divisibility.\")\n\n        for item_index, item in enumerate(input_list):\n            if not isinstance(item, tuple):\n                raise TypeError(f\"List item at index {item_index} is not a tuple.\")\n            for element_index, element in enumerate(item):\n                if not isinstance(element, int):\n                    raise TypeError(f\"Tuple element at index {item_index},{element_index} is not an integer.\")\n\nclass Tuple:\n    \"\"\"\n    A helper class to wrap a tuple and provide divisibility check.\n    \"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def is_all_divisible(self, k: int) -> bool:\n        \"\"\"Checks if all elements in the tuple are divisible by k.\"\"\"\n        for element in self.elements:\n            if element % k != 0:\n                return False\n        return True\n\nclass ResultList:\n    \"\"\"\n    Accumulates qualifying tuples and provides them as a standard list.\n    \"\"\"\n    def __init__(self):\n        self._tuples = []\n\n    def add(self, t: tuple) -> None:\n        \"\"\"Adds a tuple to the internal list.\"\"\"\n        self._tuples.append(t)\n\n    def as_list(self) -> list:\n        \"\"\"Returns the accumulated list of tuples.\"\"\"\n        return self._tuples\n\ndef find_tuples(input_list, k):\n    \"\"\"\n    Finds tuples from the given list where all elements are divisible by k.\n    \"\"\"\n    validator = Validator()\n    validator.validate_input(input_list, k)\n\n    result_list = ResultList()\n    for original_tuple in input_list:\n        tuple_helper = Tuple(original_tuple)\n        if tuple_helper.is_all_divisible(k):\n            result_list.add(original_tuple)\n\n    return result_list.as_list()"}
{"task_id": "Mbpp/79", "solution": "class Word:\n    def __init__(self, text: str) -> None:\n        self._text = text\n    def length(self) -> int:\n        return len(self._text)\n\nclass Result:\n    def __init__(self, is_odd: bool) -> None:\n        self._is_odd = is_odd\n    def as_bool(self) -> bool:\n        return self._is_odd\n\ndef word_len(word: str) -> bool:\n    \"\"\"Return True if len(word) is odd, False otherwise. Raises TypeError if word is not a str.\"\"\"\n    if not isinstance(word, str):\n        raise TypeError(\"word must be a str\")\n    w = Word(word)\n    length = w.length()\n    result = Result(is_odd=(length % 2 == 1))\n    return result.as_bool()"}
{"task_id": "Mbpp/84", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters to the sequence function.\"\"\"\n    def __init__(self, message: str, code: int | None = None):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass MemoizationCache:\n    \"\"\"Stores and retrieves computed Newman-Conway sequence values by index.\"\"\"\n    def __init__(self):\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a value from the cache for a given index n.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache for a given index n.\"\"\"\n        self._store[n] = value\n\nclass NewmanConwaySequence:\n    \"\"\"Encapsulates the Newman-Conway recurrence logic and uses memoization.\"\"\"\n    def __init__(self, cache: MemoizationCache = None):\n        self._cache = cache if cache is not None else MemoizationCache()\n\n    def _base_cases(self, n: int) -> int:\n        \"\"\"Handles the base cases P(1)=1 and P(2)=1.\"\"\"\n        return 1\n\n    def compute(self, n: int) -> int:\n        \"\"\"Recursively computes the nth Newman-Conway number with memoization.\"\"\"\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        if n == 1 or n == 2:\n            value = self._base_cases(n)\n        else:\n            # P(n) = P(P(n-1)) + P(n - P(n-1))\n            p_n_minus_1 = self.compute(n - 1)\n            term1 = self.compute(p_n_minus_1)\n            term2 = self.compute(n - p_n_minus_1)\n            value = term1 + term2\n        \n        self._cache.set(n, value)\n        return value\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    Validates input n and uses a memoized recursive computation.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer\")\n    if n <= 0:\n        raise ValidationError(\"n must be > 0\")\n\n    calculator = NewmanConwaySequence()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/85", "solution": "import math\n\ndef surfacearea_sphere(radius):\n    \"\"\"\n    Calculates the surface area of a sphere given its radius.\n    \"\"\"\n    return 4 * math.pi * (radius ** 2)"}
{"task_id": "Mbpp/82", "solution": "import math\n\nclass MathConstant:\n    \"\"\"Holds mathematical constants used in calculations.\"\"\"\n    PI = math.pi\n\nclass Radius:\n    \"\"\"Represents and validates the raw radius input.\"\"\"\n    def __init__(self, raw_value):\n        \"\"\"Initializes a Radius object with a raw value.\"\"\"\n        self._raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the raw value is an integer or a float.\"\"\"\n        return isinstance(self._raw_value, (int, float))\n\n    @property\n    def value(self) -> float:\n        \"\"\"Returns the radius value as a float, assuming it is numeric.\"\"\"\n        return float(self._raw_value)\n\nclass VolumeResult:\n    \"\"\"Container for the computed volume value.\"\"\"\n    def __init__(self, value: float) -> None:\n        \"\"\"Initializes a VolumeResult object with a computed volume value.\"\"\"\n        self._value = value\n\n    @property\n    def value(self) -> float:\n        \"\"\"Returns the stored volume value.\"\"\"\n        return self._value\n\nclass SphereFunction:\n    \"\"\"Encapsulates sphere volume calculation and input validation logic.\"\"\"\n    def __init__(self, pi: float) -> None:\n        \"\"\"Initializes SphereFunction with the PI constant.\"\"\"\n        self._pi = pi\n\n    def validate_radius(self, radius_input) -> bool:\n        \"\"\"Validates if the given radius input is numeric.\"\"\"\n        radius_obj = Radius(radius_input)\n        return radius_obj.is_numeric()\n\n    def volume(self, radius: float) -> float:\n        \"\"\"Computes the volume of a sphere given its radius.\"\"\"\n        # Ensure radius is float for calculation, as it's validated to be numeric.\n        r_val = float(radius)\n        return (4.0 / 3.0) * self._pi * (r_val ** 3)\n\ndef volume_sphere(radius) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    Raises TypeError if the radius is not a numeric type.\n    \"\"\"\n    sphere_calculator = SphereFunction(MathConstant.PI)\n\n    if not sphere_calculator.validate_radius(radius):\n        raise TypeError(\"Radius must be a numeric type (int or float).\")\n\n    computed_volume = sphere_calculator.volume(radius)\n    result_container = VolumeResult(computed_volume)\n\n    return result_container.value"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"Calculates the nth tetrahedral number using the formula T(n) = n*(n+1)*(n+2)//6.\"\"\"\n    return n * (n + 1) * (n + 2) // 6"}
{"task_id": "Mbpp/86", "solution": "class Input:\n    \"\"\"Lightweight holder for the input integer n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass Result:\n    \"\"\"Lightweight container for the computed integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates if an input is a positive integer.\"\"\"\n    def is_positive_integer(self, value) -> bool:\n        \"\"\"Checks if the given value is an integer and greater than or equal to 1.\"\"\"\n        return isinstance(value, int) and value >= 1\n\n    def assert_valid(self, n: int) -> None:\n        \"\"\"Asserts that n is a positive integer, raising ValueError if invalid.\"\"\"\n        if not self.is_positive_integer(n):\n            raise ValueError(\"n must be a positive integer (n >= 1)\")\n\nclass CenteredHexagonalCalculator:\n    \"\"\"Calculates centered hexagonal numbers using a static formula.\"\"\"\n    @staticmethod\n    def formula(n: int) -> int:\n        \"\"\"Calculates the centered hexagonal number using the mathematical formula.\"\"\"\n        return 3 * n * (n - 1) + 1\n\n    @staticmethod\n    def compute(n: int) -> int:\n        \"\"\"Computes the nth centered hexagonal number.\"\"\"\n        return CenteredHexagonalCalculator.formula(n)\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number.\n\n    Validates input n and calculates the number using a dedicated calculator.\n    \"\"\"\n    validator = Validator()\n    validator.assert_valid(n)\n\n    # Input(n) is used for traceability as per design, but not directly in calculation flow\n    # input_obj = Input(n)\n\n    # CenteredHexagonalCalculator uses static methods, so instantiation is not strictly necessary\n    # but the design's class diagram and sequence diagram show it.\n    calculator = CenteredHexagonalCalculator()\n    calculated_value = calculator.compute(n)\n\n    # Result(calculated_value) is used for traceability as per design\n    # result_obj = Result(calculated_value)\n\n    return calculated_value"}
