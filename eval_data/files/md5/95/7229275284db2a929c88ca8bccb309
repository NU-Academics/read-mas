{"task_id": "Mbpp/287", "solution": "def generate_even_sequence(n: int) -> list[int]:\n    \"\"\"Generates a list of the first n even natural numbers.\"\"\"\n    return [2 * i for i in range(1, n + 1)]\n\ndef sum_of_squares(nums: list[int]) -> int:\n    \"\"\"Calculates the sum of squares for a given list of numbers.\"\"\"\n    return sum(x * x for x in nums)\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Returns the sum of squares of the first n even natural numbers.\n    For n=2, this calculates (2*1)^2 + (2*2)^2 = 4 + 16 = 20.\n    \"\"\"\n    even_numbers = generate_even_sequence(n)\n    return sum_of_squares(even_numbers)"}
{"task_id": "Mbpp/290", "solution": "from typing import Any, List, Tuple\n\ndef max_length(lists: list) -> tuple:\n    \"\"\"Validates 'lists' is a list of lists; returns (n, lst) where n is the maximum inner list length and lst is the first inner list with that length.\n    Returns (0, []) for an empty outer list; input validity is assumed.\n    \"\"\"\n    if not lists:\n        return (0, [])\n\n    max_len = -1\n    max_list = None\n\n    for inner in lists:\n        l = len(inner)\n        if l > max_len:\n            max_len = l\n            max_list = inner\n    \n    return (max_len, max_list)"}
