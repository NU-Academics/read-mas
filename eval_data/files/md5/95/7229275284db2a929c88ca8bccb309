{"task_id": "Mbpp/103", "solution": "def validate_params(n: int, m: int) -> None:\n    \"\"\"\n    Validates the input parameters n and m for Eulerian number computation.\n    Raises ValueError if inputs are invalid.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(m, int):\n        raise ValueError(\"n and m must be integers.\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1).\")\n    if not (0 <= m <= n - 1):\n        raise ValueError(f\"m must be between 0 and n-1 for n={n} (i.e., 0 <= m <= {n-1}).\")\n\n\nclass ComputationMethod:\n    \"\"\"\n    Computes the Eulerian number using dynamic programming.\n    \"\"\"\n    def __init__(self):\n        self._memo = {}\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"\n        Calculates a(n, m) using the recurrence relation with memoization.\n        \"\"\"\n        return self._compute_recursive(n, m)\n\n    def _compute_recursive(self, n: int, m: int) -> int:\n        \"\"\"\n        Recursive helper with memoization for Eulerian number calculation.\n        \"\"\"\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        # Base cases\n        if m < 0 or m >= n:\n            self._memo[(n, m)] = 0\n            return 0\n        if n == 1 and m == 0:\n            self._memo[(n, m)] = 1\n            return 1\n        if m == 0:  # A(n,0) = 1 for n >= 1\n            self._memo[(n, m)] = 1\n            return 1\n        if m == n - 1:  # A(n, n-1) = 1 for n >= 1\n            self._memo[(n, m)] = 1\n            return 1\n        \n        # Recurrence relation: A(n, m) = (m + 1) * A(n-1, m) + (n - m) * A(n-1, m-1)\n        result = (m + 1) * self._compute_recursive(n - 1, m) + \\\n                 (n - m) * self._compute_recursive(n - 1, m - 1)\n\n        self._memo[(n, m)] = result\n        return result\n\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    This function validates inputs and delegates computation.\n    \"\"\"\n    validate_params(n, m)\n    return ComputationMethod().compute(n, m)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\n\ndef _is_list_of_strings(obj: object) -> bool:\n    \"\"\"Checks if an object is a list containing only string elements.\"\"\"\n    return isinstance(obj, list) and all(isinstance(x, str) for x in obj)\n\ndef _validate_input(input_sequence: Sequence) -> None:\n    \"\"\"Validates the structure and content of the input sequence.\"\"\"\n    if not isinstance(input_sequence, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of sublists.\")\n    for element in input_sequence:\n        if not _is_list_of_strings(element):\n            raise TypeError(\"Each sublist in the input sequence must be a list of strings.\")\n\ndef sort_sublists(input_sequence: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"Validates input and returns a new list of lists with each sublist sorted.\n\n    Each sublist's strings are sorted ascending (lexicographic), preserving sublist order.\n    \"\"\"\n    _validate_input(input_sequence)\n\n    result = []\n    for sublist in input_sequence:\n        sorted_sublist = sorted(sublist)\n        result.append(sorted_sublist)\n    return result"}
{"task_id": "Mbpp/106", "solution": "def add_lists(list_input: list, tuple_input: tuple) -> tuple:\n    \"\"\"Appends the elements of a list to a tuple, returning a new tuple.\n    The original list and tuple inputs remain unchanged.\"\"\"\n    return tuple_input + tuple(list_input)"}
{"task_id": "Mbpp/108", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass ListInput:\n    elements: List[int]\n    length: int\n\n    def __post_init__(self):\n        self.length = len(self.elements)\n\n@dataclass\nclass ResultList:\n    elements: List[int]\n    length: int\n\n@dataclass\nclass TestCase:\n    input1: List[int]\n    input2: List[int]\n    input3: List[int]\n    expected: List[int]\n\ndef mergeArrays(a: List[int], b: List[int], c: List[int]) -> List[int]:\n    \"\"\"Merges three lists into a single flat list by concatenation.\"\"\"\n    return a + b + c\n\ndef sort(elements: List[int]) -> List[int]:\n    \"\"\"Sorts a list of elements in non-decreasing order.\"\"\"\n    return sorted(elements)\n\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"Merges three lists into a single list and sorts it in ascending order.\"\"\"\n    merged = mergeArrays(list1, list2, list3)\n    sorted_list = sort(merged)\n    return sorted_list"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Represents and validates an input binary string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n        self.validate()\n\n    def validate(self) -> bool:\n        \"\"\"Validates that value is non-empty and contains only '0' and '1', raising ValueError on invalid input.\"\"\"\n        if not self.value:\n            raise ValueError(\"Binary string cannot be empty.\")\n        if not all(c in '01' for c in self.value):\n            raise ValueError(\"Binary string must contain only '0' or '1' characters.\")\n        return True\n\n    def charAt(self, idx: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.value[idx]\n\nclass RotatedString:\n    \"\"\"Represents a rotated string value with its rotation index and provides an oddness check.\"\"\"\n    def __init__(self, value: str, rotationIndex: int):\n        self.value = value\n        self.rotationIndex = rotationIndex\n\n    def isOdd(self) -> bool:\n        \"\"\"Determines if the rotated string represents an odd number (LSB is '1').\"\"\"\n        return self.value[-1] == '1'\n\nclass RotationOperation:\n    \"\"\"Coordinates the rotation evaluation process and generates RotatedString instances.\"\"\"\n    def __init__(self, rotationsRequested: int):\n        self.rotationsRequested = rotationsRequested\n        self.rotationsPerformed = 0\n        self._last_value: str = \"\" # Stores the string from the previous rotation step.\n\n    def performRotation(self, s: BinaryString) -> RotatedString:\n        \"\"\"Produces the next RotatedString in the sequence, performing a right cyclic rotation if needed.\"\"\"\n        self.rotationsPerformed += 1\n        current_rotation_index = self.rotationsPerformed - 1\n\n        if current_rotation_index == 0:\n            current_value = s.value\n        else:\n            current_value = self._last_value[-1] + self._last_value[:-1]\n        \n        self._last_value = current_value\n        return RotatedString(current_value, current_rotation_index)\n\nclass ResultCount:\n    \"\"\"Accumulates the count of odd rotated strings and tracks total evaluations.\"\"\"\n    def __init__(self):\n        self.oddCount: int = 0\n        self.totalEvaluated: int = 0\n\n    def toInt(self) -> int:\n        \"\"\"Returns the total count of odd rotated strings.\"\"\"\n        return self.oddCount\n\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of times a binary string, when rotated a given number of times,\n    results in an odd number (LSB == '1').\n    \"\"\"\n    if not isinstance(binary_string, str):\n        raise ValueError(\"binary_string must be a string.\")\n    if not isinstance(rotations, int) or rotations < 1:\n        raise ValueError(\"rotations must be an integer and greater than or equal to 1.\")\n\n    binary_string_obj = BinaryString(binary_string)\n    rotation_op = RotationOperation(rotations)\n    result_count = ResultCount()\n\n    for _ in range(rotations):\n        rotated_str_obj = rotation_op.performRotation(binary_string_obj)\n        if rotated_str_obj.isOdd():\n            result_count.oddCount += 1\n        result_count.totalEvaluated += 1\n\n    return result_count.toInt()"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Set, Any\n\ndef validate_input(nested: Any) -> bool:\n    \"\"\"\n    Validates if the input is a list of lists of integers.\n    \"\"\"\n    if not isinstance(nested, list):\n        return False\n    for sublist in nested:\n        if not isinstance(sublist, list):\n            return False\n        for item in sublist:\n            if not isinstance(item, int):\n                return False\n    return True\n\ndef compute_intersection(nested: List[List[int]]) -> Set[int]:\n    \"\"\"\n    Computes the set intersection across provided sublists.\n    Returns an empty set if the input list is empty, any sublist is empty, or no common elements.\n    \"\"\"\n    if not nested:\n        return set()\n\n    # If any sublist is empty, their intersection must be empty\n    if any(not sublist for sublist in nested):\n        return set()\n\n    common_elements = set(nested[0])\n\n    for i in range(1, len(nested)):\n        common_elements = common_elements.intersection(set(nested[i]))\n        # Optimization: if at any point the intersection becomes empty, no further elements can be common.\n        if not common_elements:\n            return set()\n            \n    return common_elements\n\ndef common_in_nested_lists(list_of_sublists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Finds the common elements in given nested lists, returning them as a list.\n    \"\"\"\n    if not validate_input(list_of_sublists):\n        return []\n\n    # Handle an empty top-level list as per requirements\n    if not list_of_sublists:\n        return []\n\n    common_set = compute_intersection(list_of_sublists)\n    return list(common_set)"}
{"task_id": "Mbpp/113", "solution": "import re\n\nPATTERN: str = r'^[+-]?\\d+$'\n\ndef check_integer(input: str) -> bool:\n    \"\"\"\n    Return True if input is a non-empty string that fully matches PATTERN; otherwise return False.\n    Must not raise exceptions for invalid inputs (assumes input is a str).\n    \"\"\"\n    if input == \"\":\n        return False\n    return re.fullmatch(PATTERN, input) is not None"}
{"task_id": "Mbpp/116", "solution": "class Validator:\n    # Validates that the input is a tuple of positive integers.\n    def validate(self, input: tuple) -> bool:\n        if not isinstance(input, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        if len(input) == 0:\n            raise ValueError(\"Input tuple cannot be empty.\")\n        for element in input:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in the tuple must be integers.\")\n            if element <= 0:\n                raise ValueError(\"All elements in the tuple must be positive integers (> 0).\")\n        return True\n\ndef _concatenate_digits(elements: tuple) -> str:\n    # Converts each element to its string representation and concatenates them.\n    return \"\".join(str(e) for e in elements)\n\ndef tuple_to_int(input: tuple) -> int:\n    # Converts a tuple of positive integers into a single integer by concatenation.\n    validator = Validator()\n    validator.validate(input)\n    concatenated_str = _concatenate_digits(input)\n    return int(concatenated_str)"}
{"task_id": "Mbpp/118", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass StringInput:\n    value: str\n\n@dataclass\nclass SubstringList:\n    items: List[str]\n    def count(self) -> int:\n        return len(self.items)\n\ndef string_to_list(s: str) -> List[str]:\n    \"\"\"Converts a string to a list of strings by splitting on the space character ' '.\"\"\"\n    return s.split(' ')"}
{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(items: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    The function assumes the input list adheres to the preconditions: it's sorted,\n    contains integers, and exactly one element appears once while others appear twice.\n    \"\"\"\n    for i in range(0, len(items) - 1, 2):\n        if items[i] != items[i+1]:\n            # If the current element does not match the next, it must be the unique element.\n            return items[i]\n    \n    # If the loop completes, the unique element must be the last one in the array.\n    return items[-1]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\nimport math\n\nclass Result:\n    \"\"\"Holds the final maximum absolute product.\"\"\"\n    def __init__(self, max_abs_product: float):\n        self.max_abs_product = max_abs_product\n\nclass Product:\n    \"\"\"Holds a numeric product value and provides its absolute value.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = float(value)\n\n    def abs_value(self) -> float:\n        return abs(self.value)\n\nclass TuplePair:\n    \"\"\"Represents a two-element numeric pair and provides product computation.\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]):\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise ValueError(\"Tuple elements must be numeric (int or float).\")\n        self.a = float(a)\n        self.b = float(b)\n\n    def product(self) -> float:\n        return self.a * self.b\n\nclass MaxProductFunction:\n    \"\"\"Coordinates processing of a list of TuplePair instances and computes the maximum absolute product.\"\"\"\n    def compute(self, input_pairs: List[Tuple[Union[int, float], Union[int, float]]]) -> Result:\n        max_abs_prod = -math.inf # Initialize with negative infinity for correct max comparison\n\n        for pair_tuple in input_pairs:\n            try:\n                tuple_pair = TuplePair(pair_tuple[0], pair_tuple[1])\n            except ValueError as e:\n                # Re-raise with context if TuplePair validation fails due to non-numeric elements.\n                raise ValueError(f\"Invalid numeric element in tuple {pair_tuple}: {e}\") from e\n            \n            prod_value = tuple_pair.product()\n            prod_obj = Product(prod_value)\n            \n            abs_prod = prod_obj.abs_value()\n            \n            if abs_prod > max_abs_prod:\n                max_abs_prod = abs_prod\n        \n        return Result(max_abs_prod)\n\ndef max_product_tuple(input_list: list) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Raises ValueError for invalid inputs (empty list, non-tuple items, incorrect tuple length, non-numeric elements).\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    validated_raw_tuples: List[Tuple[Union[int, float], Union[int, float]]] = []\n    for i, item in enumerate(input_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\n                f\"Item at index {i} is not a two-element tuple. \"\n                f\"Found: {item} of type {type(item)} and length {len(item) if isinstance(item, tuple) else 'N/A'}.\"\n            )\n        # Type validation for elements will happen inside TuplePair constructor called by MaxProductFunction.\n        validated_raw_tuples.append(item)\n    \n    max_product_func = MaxProductFunction()\n    result_obj = max_product_func.compute(validated_raw_tuples)\n    return result_obj.max_abs_product"}
