{"task_id": "Mbpp/233", "solution": "import math\n\nclass NumericInput:\n    def __init__(self, value):\n        self.value = value\n    def validate(self) -> bool:\n        \"\"\"Validates if the stored value is an integer or a float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass MathModule:\n    pi: float = math.pi\n    def compute_lateral_surface(self, radius: float, height: float) -> float:\n        \"\"\"Computes the lateral surface area using the formula 2 * pi * radius * height.\"\"\"\n        return 2 * self.pi * radius * height\n\nclass Cylinder:\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius = radius\n        self.height = height\n    def lateral_surface_area(self) -> float:\n        \"\"\"Calculates the lateral surface area of the cylinder.\"\"\"\n        mm = MathModule()\n        return mm.compute_lateral_surface(self.radius, self.height)\n\nclass CalculationResult:\n    def __init__(self, value: float) -> None:\n        self.value = value\n    def as_float(self) -> float:\n        \"\"\"Returns the stored calculation result as a float.\"\"\"\n        return float(self.value)\n\ndef lateralsuface_cylinder(radius, height) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder given its radius and height.\n    Raises TypeError if radius or height are not numeric.\n    \"\"\"\n    r_in = NumericInput(radius)\n    h_in = NumericInput(height)\n    if not (r_in.validate() and h_in.validate()):\n        raise TypeError(\"radius and height must be numeric (int or float)\")\n    cylinder = Cylinder(float(radius), float(height))\n    result_value = cylinder.lateral_surface_area()\n    result = CalculationResult(result_value)\n    return result.as_float()"}
