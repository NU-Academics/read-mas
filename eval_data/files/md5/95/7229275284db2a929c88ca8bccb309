{"task_id": "Mbpp/123", "solution": "class DivisorCalculator:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer.\"\"\"\n    def sum_proper_divisors(self, k: int) -> int:\n        if k <= 1:\n            return 0\n        \n        div_sum = 1  # 1 is always a proper divisor for k > 1\n        i = 2\n        while i * i <= k:\n            if k % i == 0:\n                div_sum += i\n                if i * i != k:\n                    div_sum += k // i\n            i += 1\n        return div_sum\n\nclass NumberEntity:\n    \"\"\"Domain value object representing a number and its divisor sum.\"\"\"\n    def __init__(self, value: int, divisor_sum: int) -> None:\n        self.value = value\n        self.divisor_sum = divisor_sum\n\nclass AmicablePair:\n    \"\"\"Domain value object representing an amicable pair of NumberEntity instances.\"\"\"\n    def __init__(self, a: NumberEntity, b: NumberEntity) -> None:\n        self.a = a\n        self.b = b\n\nclass AmicableService:\n    \"\"\"Orchestrates amicable number discovery and sum accumulation.\"\"\"\n    def __init__(self, divisor_calc: DivisorCalculator | None = None) -> None:\n        self._divisor_calc = divisor_calc if divisor_calc is not None else DivisorCalculator()\n        self._seen: set[int] = set()\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        total_amicable_sum = 0\n        for k in range(1, n + 1):\n            if k in self._seen:\n                continue\n\n            partner = self._divisor_calc.sum_proper_divisors(k)\n\n            # Check if partner is a potential candidate (within range and not k itself)\n            if partner != k and 1 <= partner <= n:\n                back = self._divisor_calc.sum_proper_divisors(partner)\n\n                # If back calculation returns k, we found an amicable pair\n                if back == k:\n                    # Add k if not already seen\n                    if k not in self._seen:\n                        total_amicable_sum += k\n                        self._seen.add(k)\n                    # Add partner if not already seen\n                    if partner not in self._seen:\n                        total_amicable_sum += partner\n                        self._seen.add(partner)\n        return total_amicable_sum\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified number n.\"\"\"\n    service = AmicableService(divisor_calc=DivisorCalculator())\n    return service.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/127", "solution": "from typing import Any\n\ndef _validate_integer(value: Any, name: str) -> None:\n    \"\"\"Validates that a value is an integer, raising TypeError if not.\"\"\"\n    if not isinstance(value, int):\n        raise TypeError(f\"parameter {name} must be int\")\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Multiplies two integers after validating their types.\"\"\"\n    _validate_integer(a, \"a\")\n    _validate_integer(b, \"b\")\n    return a * b"}
{"task_id": "Mbpp/125", "solution": "class BinaryString:\n    def __init__(self, value: str):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if all characters in the string are '0' or '1'.\"\"\"\n        return all(c in ('0', '1') for c in self.value)\n\nclass FindLengthFunction:\n    def mapCharToWeight(self, c: str) -> int:\n        \"\"\"Maps '0' to +1 and '1' to -1 for difference calculation.\"\"\"\n        return 1 if c == '0' else -1\n\n    def computeMaxDifference(self, binary_string_obj: BinaryString) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum contiguous subarray sum.\"\"\"\n        max_so_far = 0\n        current_max = 0\n        \n        for char_val in binary_string_obj.value:\n            weight = self.mapCharToWeight(char_val)\n            current_max += weight\n            if current_max < 0:\n                current_max = 0\n            max_so_far = max(max_so_far, current_max)\n            \n        return max_so_far\n    \n    def find_length(self, binary_string_obj: BinaryString) -> int:\n        \"\"\"Entry point for the algorithm class to compute max difference.\"\"\"\n        return self.computeMaxDifference(binary_string_obj)\n\ndef _validate_and_wrap(s: str) -> BinaryString:\n    \"\"\"Validates the input string and wraps it into a BinaryString object.\"\"\"\n    binary_string_obj = BinaryString(s)\n    if not binary_string_obj.isValid():\n        raise ValueError(\"Input string must contain only '0' or '1' characters.\")\n    return binary_string_obj\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Applies Kadane's algorithm after mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    if not s:\n        return 0\n\n    binary_str_obj = _validate_and_wrap(s)\n    algo = FindLengthFunction()\n    return algo.find_length(binary_str_obj)"}
{"task_id": "Mbpp/128", "solution": "from typing import List, Union\n\nclass Input:\n    \"\"\"Encapsulates input parameters.\"\"\"\n    def __init__(self, n: int, words: Union[str, List[str]]):\n        self.n = n\n        self.words = words\n\nclass Word:\n    \"\"\"Value object representing a token.\"\"\"\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.position = position\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\n\nclass ResultList:\n    \"\"\"Container for final result words preserving order.\"\"\"\n    def __init__(self):\n        self._words: List[str] = []\n\n    def append(self, word_text: str) -> None:\n        \"\"\"Appends a word to the result list.\"\"\"\n        self._words.append(word_text)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the accumulated list of words.\"\"\"\n        return self._words\n\nclass WordFilter:\n    \"\"\"Applies the threshold rule (len > threshold) to a list of Word objects.\"\"\"\n    def __init__(self, threshold: int):\n        self.threshold = threshold\n\n    def filter(self, words_list: List[Word]) -> List[str]:\n        \"\"\"Filters words based on length and returns their text.\"\"\"\n        result_list = ResultList()\n        for word in words_list:\n            if word.length() > self.threshold:\n                result_list.append(word.text)\n        return result_list.to_list()\n\nclass LongWordsFunction:\n    \"\"\"Coordinates tokenization, mapping to Word objects, filtering, and producing the result.\"\"\"\n    def __init__(self, n: int, words: Union[str, List[str]]):\n        self.n = n\n        self.words = words\n\n    def execute(self) -> List[str]:\n        \"\"\"Executes the logic to find long words.\"\"\"\n        tokens_to_process: List[str]\n        if isinstance(self.words, str):\n            tokens_to_process = self.words.split()\n        else: # Assumed to be List[str] based on Union type hint\n            tokens_to_process = self.words\n\n        word_objects = [Word(token, i) for i, token in enumerate(tokens_to_process)]\n\n        word_filter = WordFilter(self.n)\n        filtered_words = word_filter.filter(word_objects)\n\n        return filtered_words\n\ndef long_words(n, words):\n    \"\"\"Public API as specified in SRS: long_words(n, words) -> list\"\"\"\n    # Create Input object (as per design, though not strictly used for passing to LWF)\n    # input_obj = Input(n, words)\n\n    # internal wiring: create LongWordsFunction, call execute(), return list\n    long_words_func = LongWordsFunction(n, words)\n    return long_words_func.execute()"}
{"task_id": "Mbpp/126", "solution": "import math\nfrom typing import List\n\nclass IntegerInput:\n    \"\"\"Encapsulates an integer input value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass DivisorSet:\n    \"\"\"Computes and holds positive divisors for an IntegerInput.\"\"\"\n    def __init__(self, integer_input: 'IntegerInput'):\n        self.integer_input = integer_input\n        self.divisors: List[int] = []\n\n    def computeDivisors(self) -> List[int]:\n        \"\"\"Computes positive divisors for the encapsulated integer input value.\"\"\"\n        n = abs(self.integer_input.value)\n        divs = set()\n\n        if n == 0:\n            self.divisors = []\n            return self.divisors\n        elif n == 1:\n            self.divisors = [1]\n            return self.divisors\n\n        for i in range(1, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        self.divisors = sorted(list(divs))\n        return self.divisors\n\nclass CommonDivisorSet:\n    \"\"\"Computes and holds the intersection of two DivisorSets.\"\"\"\n    def __init__(self, a: 'DivisorSet', b: 'DivisorSet'):\n        # Stores DivisorSet objects; computeCommon will use its own arguments.\n        self._div_set_a = a\n        self._div_set_b = b\n        self.commonDivisors: List[int] = []\n\n    def computeCommon(self, a: 'DivisorSet', b: 'DivisorSet') -> List[int]:\n        \"\"\"Computes common positive divisors between two DivisorSet objects.\"\"\"\n        divisors_a = set(a.computeDivisors())\n        divisors_b = set(b.computeDivisors())\n        self.commonDivisors = sorted(list(divisors_a.intersection(divisors_b)))\n        return self.commonDivisors\n\nclass Result:\n    \"\"\"Data holder for the integer sum of common divisors.\"\"\"\n    def __init__(self, sum_value: int):\n        self.sum = sum_value\n\nclass Function:\n    \"\"\"Orchestrates the computation of common divisors sum.\"\"\"\n    def __init__(self, name: str, parameters: List['IntegerInput']):\n        self.name = name\n        self.parameters = parameters\n\n    def execute(self) -> 'Result':\n        \"\"\"Executes the computation flow to find the sum of common divisors.\"\"\"\n        input_a = self.parameters[0]\n        input_b = self.parameters[1]\n\n        divisor_set_a = DivisorSet(input_a)\n        divisor_set_b = DivisorSet(input_b)\n\n        common_divisor_set = CommonDivisorSet(divisor_set_a, divisor_set_b)\n        common_divisors = common_divisor_set.computeCommon(divisor_set_a, divisor_set_b)\n        \n        sum_value = sum(common_divisors)\n        result = Result(sum_value)\n        return result\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common positive divisors of two given numbers.\n    This function orchestrates computation using domain-aligned classes as per design.\n    \"\"\"\n    input_a = IntegerInput(a)\n    input_b = IntegerInput(b)\n    \n    func = Function(name='sum', parameters=[input_a, input_b])\n    result_obj = func.execute()\n    \n    return result_obj.sum"}
{"task_id": "Mbpp/130", "solution": "class Element:\n    \"\"\"Data holder pairing a value and its frequency.\"\"\"\n    def __init__(self, value: object, frequency: int) -> None:\n        self.value = value\n        self.frequency = frequency\n\nclass Result:\n    \"\"\"Wraps the returned element value.\"\"\"\n    def __init__(self, element: object) -> None:\n        self.element = element\n\nclass FrequencyCounter:\n    \"\"\"Counts occurrences of elements in a list and finds the element with highest count.\"\"\"\n    def __init__(self) -> None:\n        self.counts: dict[object, int] = {}\n\n    def countAll(self, items: list) -> None:\n        \"\"\"Populates counts dictionary with frequencies of items.\"\"\"\n        for item in items:\n            self.counts[item] = self.counts.get(item, 0) + 1\n\n    def maxElement(self) -> Element:\n        \"\"\"Returns the Element with the highest frequency.\"\"\"\n        if not self.counts:\n            return Element(None, 0)\n\n        max_value_key = max(self.counts, key=self.counts.get)\n        max_frequency_val = self.counts[max_value_key]\n        return Element(max_value_key, max_frequency_val)\n\nclass MaxOccurrencesFunction:\n    \"\"\"Orchestrates frequency counting and selection.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.name: str = \"max_occurrences\"\n        self._input_list: list = items\n        self._counter: FrequencyCounter = FrequencyCounter()\n\n    def execute(self) -> object:\n        \"\"\"Performs the operation to find and return the max occurring element.\"\"\"\n        self._counter.countAll(self._input_list)\n        element_with_max_freq = self._counter.maxElement()\n        # The Result wrapper is internal, return the raw element value\n        return element_with_max_freq.value\n\ndef max_occurrences(items: list) -> object:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    assert max_occurrences([2,3,8,4,7,9,8,2,6,5,1,6,1,2,3,2,4,6,9,1,2])==2\n    \"\"\"\n    # According to design, MaxOccurrencesFunction handles empty list implicitly\n    # by returning None from maxElement if counts is empty.\n    orchestrator = MaxOccurrencesFunction(items)\n    return orchestrator.execute()"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Encapsulates matrix cells and provides accessors for rows, columns, and diagonals.\"\"\"\n    def __init__(self, cells: list[list[float]]):\n        self.cells = cells\n        self.size = len(cells) if cells else 0\n\n    def get_row(self, i: int) -> list[float]:\n        \"\"\"Returns the i-th row of the matrix.\"\"\"\n        return self.cells[i]\n\n    def get_col(self, j: int) -> list[float]:\n        \"\"\"Returns the j-th column of the matrix.\"\"\"\n        return [self.cells[i][j] for i in range(self.size)]\n\n    def get_main_diagonal(self) -> list[float]:\n        \"\"\"Returns the main diagonal elements.\"\"\"\n        return [self.cells[i][i] for i in range(self.size)]\n\n    def get_anti_diagonal(self) -> list[float]:\n        \"\"\"Returns the anti-diagonal elements.\"\"\"\n        return [self.cells[i][self.size - 1 - i] for i in range(self.size)]\n\nclass ValidationResult:\n    \"\"\"Represents validation outcome with a boolean and an optional reason.\"\"\"\n    def __init__(self, is_magic: bool, reason: str = \"\"):\n        self.is_magic = is_magic\n        self.reason = reason\n\nclass MagicSquareValidator:\n    \"\"\"Encapsulates the logic for validating if a matrix is a magic square.\"\"\"\n    def is_square(self, matrix: list[list[float]]) -> bool:\n        \"\"\"Checks if the matrix is non-empty, square, and contains only numeric elements.\"\"\"\n        if not matrix or not matrix[0]:\n            return False\n\n        n = len(matrix)\n        for row in matrix:\n            if len(row) != n:\n                return False\n            for element in row:\n                if not isinstance(element, (int, float)):\n                    return False\n        return True\n\n    def _get_matrix_object(self, matrix: list[list[float]]) -> Matrix:\n        \"\"\"Helper to create a Matrix object, assuming input matrix is valid.\"\"\"\n        return Matrix(matrix)\n\n    def determine_target_sum(self, matrix: list[list[float]]) -> float:\n        \"\"\"Determines the target sum from the first row of the matrix.\"\"\"\n        matrix_obj = self._get_matrix_object(matrix)\n        return sum(matrix_obj.get_row(0))\n\n    def compute_row_sums(self, matrix: list[list[float]]) -> list[float]:\n        \"\"\"Computes sums for each row of the matrix.\"\"\"\n        matrix_obj = self._get_matrix_object(matrix)\n        return [sum(matrix_obj.get_row(i)) for i in range(matrix_obj.size)]\n\n    def compute_col_sums(self, matrix: list[list[float]]) -> list[float]:\n        \"\"\"Computes sums for each column of the matrix.\"\"\"\n        matrix_obj = self._get_matrix_object(matrix)\n        return [sum(matrix_obj.get_col(j)) for j in range(matrix_obj.size)]\n\n    def compute_diagonal_sums(self, matrix: list[list[float]]) -> tuple[float, float]:\n        \"\"\"Computes sums for both main and anti-diagonals.\"\"\"\n        matrix_obj = self._get_matrix_object(matrix)\n        main_diag_sum = sum(matrix_obj.get_main_diagonal())\n        anti_diag_sum = sum(matrix_obj.get_anti_diagonal())\n        return main_diag_sum, anti_diag_sum\n\n    def validate(self, matrix: list[list[float]]) -> bool:\n        \"\"\"Orchestrates validation checks to determine if the matrix is a magic square.\"\"\"\n        if not self.is_square(matrix):\n            return False\n\n        # A 1x1 matrix with a single numeric element is trivially a magic square.\n        if len(matrix) == 1:\n            return True\n\n        target_sum = self.determine_target_sum(matrix)\n\n        if any(s != target_sum for s in self.compute_row_sums(matrix)):\n            return False\n\n        if any(s != target_sum for s in self.compute_col_sums(matrix)):\n            return False\n\n        main_diag_sum, anti_diag_sum = self.compute_diagonal_sums(matrix)\n        if main_diag_sum != target_sum or anti_diag_sum != target_sum:\n            return False\n\n        return True\n\n\ndef magic_square_test(matrix: list[list[float]]) -> bool:\n    \"\"\"\n    Determines if the given matrix is a magic square.\n    It validates input shape and element types, then checks if all row, column, and diagonal sums are equal.\n    \"\"\"\n    validator = MagicSquareValidator()\n    return validator.validate(matrix)"}
{"task_id": "Mbpp/132", "solution": "from typing import Tuple, Any\n\ndef tup_string(input_tuple: Tuple[Any, ...]) -> str:\n    \"\"\"Accepts a single tuple argument and returns the concatenation of its elements as a string.\"\"\"\n    return ''.join(map(str, input_tuple))"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n):\n    \"\"\"Compute the nth hexagonal number using H_n = n * (2 * n - 1).\n\n    Parameters:\n    - n (int): 1-based index of the hexagonal sequence.\n\n    Returns:\n    - int: the nth hexagonal number.\n    \"\"\"\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/133", "solution": "class NumberItem:\n    \"\"\"Represents a single numeric element and provides an isNegative() predicate.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isNegative(self):\n        \"\"\"Returns True if the value is negative, False otherwise.\"\"\"\n        return self.value < 0\n\nclass SumResult:\n    \"\"\"Encapsulates the computed numeric result.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass NumberList:\n    \"\"\"Lightweight wrapper for the input list/iterable.\"\"\"\n    def __init__(self, numbers):\n        self.numbers = numbers\n\nclass SumCalculator:\n    \"\"\"Encapsulates iteration, filtering of negatives, and accumulation algorithm.\"\"\"\n    @staticmethod\n    def sum_negativenum(numbers):\n        \"\"\"Calculates the sum of negative numbers in the given list.\"\"\"\n        number_list = NumberList(numbers)\n        current_sum = 0\n        for num_value in number_list.numbers:\n            item = NumberItem(num_value)\n            if item.isNegative():\n                current_sum += item.value\n        return SumResult(current_sum).value\n\ndef sum_negativenum(numbers):\n    \"\"\"\n    Calculates the sum of the negative numbers of a given list of numbers.\n    Returns 0 if no negative numbers are found or the list is empty.\n    \"\"\"\n    return SumCalculator.sum_negativenum(numbers)"}
{"task_id": "Mbpp/131", "solution": "VOWEL_SET = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverse only vowels in input_string; returns a Python str.\"\"\"\n    if not input_string:\n        return \"\"\n\n    vowel_positions = []\n    vowels = []\n    \n    for i, char in enumerate(input_string):\n        if char in VOWEL_SET:\n            vowel_positions.append(i)\n            vowels.append(char)\n            \n    if len(vowels) <= 1:\n        return input_string\n            \n    reversed_vowels = vowels[::-1]\n    \n    result_list = list(input_string)\n    for i, pos in enumerate(vowel_positions):\n        result_list[pos] = reversed_vowels[i]\n        \n    return \"\".join(result_list)"}
{"task_id": "Mbpp/137", "solution": "from typing import Sequence, List\nfrom dataclasses import dataclass\n\nclass DivisionByZeroError(Exception):\n    \"\"\"Exception raised when the non-zero count is zero, preventing ratio computation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass ArrayInput:\n    \"\"\"Holds the input array values and its length.\"\"\"\n    def __init__(self, values: Sequence[int]):\n        self.values: List[int] = list(values) # Store a copy to ensure non-mutation of original\n        self.length: int = len(self.values)\n\n@dataclass\nclass ZeroCountResult:\n    \"\"\"Holds the computed ratio and counts of zeroes and non-zeroes.\"\"\"\n    ratio: float\n    zeroCount: int\n    nonZeroCount: int\n\nclass ZeroCountFunction:\n    \"\"\"Stateless computation component for counting and ratio calculation.\"\"\"\n    def compute(self, values: Sequence[int]) -> float:\n        \"\"\"Counts zeros and nonzeros; computes ratio; raises DivisionByZeroError if nonZeroCount == 0.\"\"\"\n        zero_count = 0\n        non_zero_count = 0\n        for value in values:\n            if value == 0:\n                zero_count += 1\n            else:\n                non_zero_count += 1\n\n        if non_zero_count == 0:\n            raise DivisionByZeroError(\"non-zero count is zero; cannot compute ratio\")\n\n        return float(zero_count) / non_zero_count\n\ndef zero_count(values: Sequence[int]) -> float:\n    \"\"\"Public API. Delegates to ZeroCountFunction.compute and returns float. Preserves input.\"\"\"\n    function_instance = ZeroCountFunction()\n    return function_instance.compute(values)"}
{"task_id": "Mbpp/138", "solution": "from typing import List, Optional\nimport math\n\nclass NumberInput:\n    \"\"\"Represents the caller-provided integer and validates preconditions.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if input is a non-negative integer greater than or equal to 2.\"\"\"\n        return isinstance(self.value, int) and self.value >= 2\n\nclass PowerOfTwoTerm:\n    \"\"\"Represents a single term 2^k with exponent >= 1.\"\"\"\n    def __init__(self, exponent: int):\n        self.exponent = exponent\n        self.value = 2 ** exponent\n\nclass SumRepresentation:\n    \"\"\"Represents a candidate collection of PowerOfTwoTerm entries that sum to a total.\"\"\"\n    def __init__(self, terms: List[PowerOfTwoTerm]):\n        self.terms = terms\n\n    def is_non_empty(self) -> bool:\n        \"\"\"Checks if the representation contains at least one term.\"\"\"\n        return bool(self.terms)\n\n    def total(self) -> int:\n        \"\"\"Calculates the sum of all terms in the representation.\"\"\"\n        return sum(term.value for term in self.terms)\n\n    def all_exponents_non_zero(self) -> bool:\n        \"\"\"Checks if all exponents in the terms are non-zero (i.e., >= 1).\"\"\"\n        return all(term.exponent >= 1 for term in self.terms)\n\n    @classmethod\n    def from_value(cls, n: int) -> Optional['SumRepresentation']:\n        \"\"\"\n        Attempts to construct a SumRepresentation of n using powers of two with exponents >= 1.\n        Uses a greedy approach; returns None if no such representation is possible.\n        \"\"\"\n        if n < 2:  # Smallest possible sum of 2^k (k>=1) is 2^1 = 2\n            return None\n\n        remaining = n\n        terms: List[PowerOfTwoTerm] = []\n\n        while remaining > 0:\n            # Find the largest k such that 2^k <= remaining and k >= 1\n            if remaining == 1: # Cannot represent 1 with 2^k where k >= 1\n                return None\n            \n            k = int(math.log2(remaining))\n            if 2**k > remaining: # Adjust if floating point precision causes issue, though for powers of 2 it's usually fine\n                 k -= 1\n\n            # Ensure k >= 1 as required by \"non-zero powers\"\n            if k == 0:\n                # If remaining is 1 (e.g., after subtracting 2, 4, 8 from 15 gives 1),\n                # and 2^0 is 1, but k must be >= 1. So cannot represent.\n                return None\n            \n            term_value = 2**k\n            terms.append(PowerOfTwoTerm(k))\n            remaining -= term_value\n\n        return cls(terms) if terms else None\n\nclass Result:\n    \"\"\"Encapsulates the boolean result is_representable.\"\"\"\n    def __init__(self, is_representable: bool):\n        self.is_representable = is_representable\n\n\ndef is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number can be represented as a sum of non-zero powers of 2.\n    This means sum of 2^k where k >= 1 for each term.\n    \"\"\"\n    number_input = NumberInput(n)\n    if not number_input.is_valid():\n        return False\n\n    representation = SumRepresentation.from_value(n)\n\n    # The from_value method already ensures terms are valid (k>=1) and non-empty if successful\n    if representation:\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/139", "solution": "import math\n\nclass MathConstant:\n    \"\"\"Provides mathematical constants, specifically PI.\"\"\"\n    PI: float = math.pi\n\nclass Circle:\n    \"\"\"Represents a circle and computes its circumference.\"\"\"\n    def __init__(self, radius: float):\n        \"\"\"Initializes a Circle with a given radius.\"\"\"\n        self.radius = float(radius)\n        self.circumference = 0.0\n\n    def computeCircumference(self) -> float:\n        \"\"\"Computes, stores, and returns the circumference of the circle.\"\"\"\n        self.circumference = 2 * MathConstant.PI * self.radius\n        return self.circumference\n\nclass CircleService:\n    \"\"\"Stateless service to orchestrate circle circumference computation.\"\"\"\n    def circle_circumference(self, radius) -> float:\n        \"\"\"\n        Accepts a numeric radius, computes circumference, and returns it as a float.\n        Assumes radius is numeric (int or float) based on requirements.\n        \"\"\"\n        circle_instance = Circle(radius)\n        return circle_instance.computeCircumference()\n\ndef circle_circumference(radius):\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Delegates the computation to an internal CircleService.\n    \"\"\"\n    return CircleService().circle_circumference(radius)"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(input_collections):\n    \"\"\"Accepts a sequence of inner collections (list or tuple) containing numeric values.\n    Returns a set of unique numeric values found across all inner collections.\"\"\"\n    result_set = set()\n    for inner_collection in input_collections:\n        for element in inner_collection:\n            result_set.add(element)\n    return result_set"}
{"task_id": "Mbpp/145", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef max_Abs_Diff(seq):\n    \"\"\"\n    Finds the maximum absolute difference between any two numeric elements in a given sequence.\n\n    Handles input validation and edge cases as defined by the design.\n    \"\"\"\n    try:\n        iter(seq)\n    except TypeError:\n        raise ValidationError(\"input is not iterable\")\n\n    numeric_values = []\n    for idx, item in enumerate(seq):\n        if not isinstance(item, (int, float)):\n            raise ValidationError(f\"non-numeric element at index {idx}: {item!r}\")\n        numeric_values.append(item)\n\n    if len(numeric_values) < 2:\n        return 0\n\n    min_val = min(numeric_values)\n    max_val = max(numeric_values)\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/141", "solution": "class ComparisonError(Exception):\n    def __init__(self, message: str = None):\n        self.message = message\n        super().__init__(message)\n\ndef pancake_sort(inputList):\n    \"\"\"Sorts a list of elements in ascending order, raising errors for invalid input or non-comparable elements.\"\"\"\n    if not isinstance(inputList, list):\n        raise TypeError(\"Input must be a list.\")\n\n    try:\n        # Use Python's built-in sorted function to sort the list.\n        # This function handles comparisons and will raise a TypeError if elements are not mutually comparable.\n        sorted_list = sorted(inputList)\n    except TypeError as e:\n        # Catch TypeError for non-comparable elements and re-raise as ComparisonError.\n        raise ComparisonError(f\"Elements in the list are not mutually comparable: {e}\") from e\n\n    return sorted_list"}
{"task_id": "Mbpp/142", "solution": "from typing import Sequence, Any\n\ndef count_samepair(listA: Sequence[Any], listB: Sequence[Any], listC: Sequence[Any]) -> int:\n    \"\"\"\n    Counts items that are identical in the same position across three given lists.\n    Comparison is performed up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(listA), len(listB), len(listC))\n    match_count = 0\n\n    for i in range(min_length):\n        if listA[i] == listB[i] == listC[i]:\n            match_count += 1\n\n    return match_count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Compute and return the integer sum of terms t_i = n - 2*i for i = 0..(n // 2) inclusive.\n\n    The sum includes terms until n-x becomes less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    # The loop runs for i from 0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        total_sum += (n - 2 * i)\n    return total_sum"}
