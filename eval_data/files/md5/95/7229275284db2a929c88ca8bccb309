{"task_id": "Mbpp/250", "solution": "def validate_tuple(arg) -> None:\n    \"\"\"Raise TypeError if arg is not a tuple; otherwise return None.\"\"\"\n    if not isinstance(arg, tuple):\n        raise TypeError(\"First argument must be a tuple\")\n\ndef count_X(tuple_arg, element) -> int:\n    \"\"\"Validate tuple_arg is tuple and return integer count of elements equal (==) to element.\"\"\"\n    validate_tuple(tuple_arg)\n    count = 0\n    for item in tuple_arg:\n        if item == element:\n            count += 1\n    return count"}
{"task_id": "Mbpp/251", "solution": "from typing import Any, List\n\nclass Item:\n    \"\"\"Represent a single item value and its original index in an input list.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def __repr__(self) -> str:\n        return f\"Item(value={self.value!r}, index={self.index})\"\n\nclass InputList:\n    \"\"\"Encapsulate a sequence of Item instances representing the caller-supplied input list.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        \"\"\"Constructs Item objects with indices from primitive list values.\"\"\"\n        self.items: List[Item] = [Item(value, i) for i, value in enumerate(items)]\n\n    def __iter__(self):\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        return len(self.items)\n\nclass Element:\n    \"\"\"Represent the element value to be inserted before each item.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\nclass OutputList:\n    \"\"\"Encapsulate resulting list of interleaved element and original item values.\"\"\"\n    def __init__(self) -> None:\n        self.items: List[Any] = []\n\n    def append(self, value: Any) -> None:\n        self.items.append(value)\n\n    def to_primitive_list(self) -> List[Any]:\n        return self.items\n\nclass InsertElementFunction:\n    \"\"\"Implement the insertion algorithm that builds an OutputList.\"\"\"\n    def insert(self, inputList: InputList, element: Element) -> OutputList:\n        \"\"\"For each Item in inputList, append element.value then item.value into OutputList and return it.\"\"\"\n        output_list = OutputList()\n        for item in inputList:\n            output_list.append(element.value)\n            output_list.append(item.value)\n        return output_list\n\ndef insert_element(input_list, element):\n    \"\"\"Public API that converts primitives to domain objects, delegates, and returns a primitive list.\"\"\"\n    domain_input_list = InputList(input_list)\n    domain_element = Element(element)\n    \n    insert_service = InsertElementFunction()\n    result_output_list = insert_service.insert(domain_input_list, domain_element)\n    \n    return result_output_list.to_primitive_list()"}
{"task_id": "Mbpp/245", "solution": "class Validation:\n    \"\"\"Helper for input validation.\"\"\"\n    @staticmethod\n    def validate_array_of_ints(arr):\n        \"\"\"Validates that the input is a list or tuple of integers.\"\"\"\n        if not isinstance(arr, (list, tuple)):\n            raise ValueError(\"Input must be a list or tuple.\")\n        for item in arr:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the array must be integers.\")\n\nclass MaxSumCalculator:\n    \"\"\"Calculates the maximum sum of a bitonic subsequence.\"\"\"\n\n    def computeLISsum(self, arr):\n        \"\"\"Computes the maximum sum of an increasing subsequence ending at each index.\"\"\"\n        n = len(arr)\n        if n == 0:\n            return []\n        lis_sum = list(arr)\n\n        for i in range(1, n):\n            for j in range(i):\n                if arr[i] > arr[j]:\n                    lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n        return lis_sum\n\n    def computeLDSsum(self, arr):\n        \"\"\"Computes the maximum sum of a decreasing subsequence starting at each index.\"\"\"\n        n = len(arr)\n        if n == 0:\n            return []\n        lds_sum = list(arr)\n\n        for i in range(n - 2, -1, -1):\n            for j in range(n - 1, i, -1):\n                if arr[i] > arr[j]:\n                    lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n        return lds_sum\n\n    def max_sum(self, arr):\n        \"\"\"\n        Calculates the maximum sum of a bitonic subsequence in the given array.\n        A bitonic subsequence is first increasing and then decreasing.\n        \"\"\"\n        n = len(arr)\n        if n == 0:\n            return 0\n        if n == 1:\n            return arr[0]\n\n        lis_sums = self.computeLISsum(arr)\n        lds_sums = self.computeLDSsum(arr)\n\n        max_bitonic_sum = float('-inf')\n\n        for i in range(n):\n            # Combine LIS ending at i and LDS starting at i, subtracting arr[i] to avoid double-counting the peak\n            current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n            if current_bitonic_sum > max_bitonic_sum:\n                max_bitonic_sum = current_bitonic_sum\n\n        return max_bitonic_sum\n\ndef max_sum(arr):\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    Validation.validate_array_of_ints(arr)\n    calculator = MaxSumCalculator()\n    return calculator.max_sum(arr)"}
{"task_id": "Mbpp/255", "solution": "def _product_iter(elements, n):\n    \"\"\"\n    Internal generator that yields n-length combinations with repetition.\n    Preserves the order of input elements.\n    \"\"\"\n    if n == 0:\n        yield ()\n        return\n\n    # Start with a list containing an empty prefix (list)\n    current_combinations_lists = [[]]\n\n    # For each position in the n-length combination\n    for _ in range(n):\n        next_combinations_lists = []\n        for prefix in current_combinations_lists:\n            for item in elements:\n                next_combinations_lists.append(prefix + [item])\n        current_combinations_lists = next_combinations_lists\n    \n    # Convert lists of items to tuples before yielding\n    for combination_list in current_combinations_lists:\n        yield tuple(combination_list)\n\ndef combinations_colors(elements,n):\n    \"\"\"\n    Generates all combinations (with repetition) of elements of a list,\n    returning a list of tuples for each combination.\n    \"\"\"\n    return list(_product_iter(elements, n))"}
{"task_id": "Mbpp/252", "solution": "from typing import Tuple, Any\nimport math\n\ndef sqrt(x: float) -> float:\n    \"\"\"Computes the square root of x.\"\"\"\n    return math.sqrt(x)\n\ndef atan2(y: float, x: float) -> float:\n    \"\"\"Computes the arctangent of y/x.\"\"\"\n    return math.atan2(y, x)\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\n\nclass PolarCoordinates:\n    \"\"\"Represents polar coordinates with magnitude r and angle theta.\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\nclass Converter:\n    \"\"\"Converts ComplexNumber to PolarCoordinates.\"\"\"\n    def convert(self, input_val: Any) -> Tuple[float, float]:\n        \"\"\"Performs the conversion from a numeric or complex input to polar coordinates.\"\"\"\n        if isinstance(input_val, (int, float)):\n            # Normalize real numbers to complex(real, 0.0)\n            complex_num = ComplexNumber(float(input_val), 0.0)\n        else: # The design implies input will be complex if not int/float.\n            complex_num = ComplexNumber(input_val.real, input_val.imag)\n\n        r_val = sqrt(complex_num.real**2 + complex_num.imag**2)\n        theta_val = atan2(complex_num.imag, complex_num.real)\n\n        return (float(r_val), float(theta_val))\n\ndef convert(input: Any) -> Tuple[float, float]:\n    \"\"\"Converts a complex number or real number to polar coordinates (r, theta).\"\"\"\n    return Converter().convert(input)"}
{"task_id": "Mbpp/247", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass StringInput:\n    \"\"\"Wrapper for the raw input string.\"\"\"\n    value: str\n\n@dataclass\nclass PalindromicSubsequence:\n    \"\"\"Holds a candidate subsequence and its length.\"\"\"\n    sequence: str\n    length: int\n\n    def __post_init__(self):\n        \"\"\"Initializes length based on the sequence.\"\"\"\n        self.length = len(self.sequence)\n\n@dataclass\nclass LPSResult:\n    \"\"\"Holds the final integer length returned by lps.\"\"\"\n    length: int\n\nclass LPSFunction:\n    \"\"\"\n    Encapsulates the dynamic programming algorithm for LPS computation.\n    Uses a DP table (_dp) to store intermediate results.\n    \"\"\"\n    _s: str\n    _dp: list[list[int]]\n\n    def lps(self, input_str: str) -> int:\n        \"\"\"\n        Computes and returns the length of the longest palindromic subsequence\n        for the given input string using dynamic programming.\n        \"\"\"\n        string_input = StringInput(value=input_str)\n        self._s = string_input.value\n        n = len(self._s)\n\n        if n == 0:\n            return 0\n        \n        # Initialize DP table: dp[i][j] stores the LPS length for substring s[i..j]\n        self._dp = [[0] * n for _ in range(n)]\n\n        # Base case: All substrings of length 1 have LPS length 1\n        for i in range(n):\n            self._dp[i][i] = 1\n\n        # Fill the DP table for lengths from 2 to n\n        for current_length in range(2, n + 1):\n            for i in range(n - current_length + 1):\n                j = i + current_length - 1\n                if self._s[i] == self._s[j]:\n                    # If characters match, add 2 to LPS of inner substring\n                    # Handle length 2 case explicitly (inner substring is empty, so add 0)\n                    self._dp[i][j] = 2 + (self._dp[i + 1][j - 1] if current_length > 2 else 0)\n                else:\n                    # If characters don't match, take max of removing left or right char\n                    self._dp[i][j] = max(self._dp[i + 1][j], self._dp[i][j - 1])\n\n        final_length = self._dp[0][n - 1]\n        \n        # As per design, LPSResult object is created for traceability, but its length field is returned.\n        _ = LPSResult(length=final_length) \n        return final_length\n\ndef lps(input: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence in the given string.\n    \"\"\"\n    lps_calculator = LPSFunction()\n    return lps_calculator.lps(input)"}
{"task_id": "Mbpp/256", "solution": "def _is_prime(x: int) -> bool:\n    \"\"\"Returns True if x is a prime number, False otherwise.\n    This is an internal helper function for primality testing.\n    \"\"\"\n    if x < 2:\n        return False\n    if x == 2:\n        return True\n    if x % 2 == 0:\n        return False\n    i = 3\n    while i * i <= x:\n        if x % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"Returns the number of prime numbers strictly less than n.\n    Assumes n is a non-negative integer as per the problem description.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    count = 0\n    for num in range(2, n):\n        if _is_prime(num):\n            count += 1\n    return count"}
{"task_id": "Mbpp/257", "solution": "def validate_numeric(a, b) -> bool:\n    \"\"\"Return True iff both a and b are instances of int or float.\"\"\"\n    return isinstance(a, (int, float)) and isinstance(b, (int, float))\n\ndef swap_numbers(a, b) -> tuple:\n    \"\"\"Return a tuple (b, a) if validate_numeric(a, b) is True; raise TypeError otherwise.\"\"\"\n    if not validate_numeric(a, b):\n        raise TypeError(\"swap_numbers expects two numeric inputs (int or float)\")\n    return (b, a)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple, Union\n\n# Type aliases for clarity and adherence to design principles\nInputElementType = Tuple[Union[int, float], Union[int, float]]\nInputTupleType = Tuple[InputElementType, ...]\n\nclass Validator:\n    \"\"\"\n    Validates inputs for equal lengths and correct element shapes as per design.\n    \"\"\"\n    def validateLengths(self, a: InputTupleType, b: InputTupleType) -> None:\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have equal length.\")\n\n    def validateElementShape(self, elem: Union[InputElementType, object]) -> None:\n        if not isinstance(elem, tuple) or len(elem) != 2:\n            raise TypeError(\"Each element in the input tuples must be a two-element tuple.\")\n\nclass MaximizeFunction:\n    \"\"\"\n    Orchestrates validation and computes element-wise maxima to produce a new result tuple.\n    \"\"\"\n    def __init__(self, a: InputTupleType, b: InputTupleType, validator: 'Validator' = None) -> None:\n        self.a = a\n        self.b = b\n        self.validator = validator if validator is not None else Validator()\n\n    def execute(self) -> InputTupleType:\n        self.validator.validateLengths(self.a, self.b)\n\n        result_elements_list = []\n        for i in range(len(self.a)):\n            elem_a = self.a[i]\n            elem_b = self.b[i]\n\n            self.validator.validateElementShape(elem_a)\n            self.validator.validateElementShape(elem_b)\n\n            first_max = max(elem_a[0], elem_b[0])\n            second_max = max(elem_a[1], elem_b[1])\n            result_elements_list.append((first_max, second_max))\n\n        return tuple(result_elements_list)\n\ndef maximize_elements(a: InputTupleType, b: InputTupleType) -> InputTupleType:\n    \"\"\"\n    Maximizes elements of two tuples of equal length whose elements are two-element tuples.\n    Returns a new tuple whose elements are the component-wise maxima of the inputs.\n    \"\"\"\n    validator = Validator()\n    runner = MaximizeFunction(a, b, validator=validator)\n    return runner.execute()"}
{"task_id": "Mbpp/264", "solution": "class DogAgeCalculator:\n    def dog_age(self, human_years: int) -> int:\n        \"\"\"Return 5 * human_years + 1\"\"\"\n        return 5 * human_years + 1\n\ndef dog_age(human_years: int) -> int:\n    \"\"\"Compute dog years given human_years using formula defined in SRS: 5 * human_years + 1.\"\"\"\n    calculator = DogAgeCalculator()\n    return calculator.dog_age(human_years)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(inputList: list, L: int) -> tuple:\n    \"\"\"\n    Split inputList into two lists where the first has length L.\n    Returns (inputList[:L], inputList[L:]).\n    \"\"\"\n    first = inputList[:L]\n    second = inputList[L:]\n    return (first, second)"}
{"task_id": "Mbpp/261", "solution": "class Validator:\n    @staticmethod\n    def validate_length(tuple1, tuple2) -> None:\n        if len(tuple1) != len(tuple2):\n            raise ValueError(\"Input tuples must have the same length\")\n    @staticmethod\n    def validate_no_zero_denominator(tuple2) -> None:\n        for v in tuple2:\n            if v == 0:\n                raise ZeroDivisionError(\"Denominator contains zero\")\n\ndef division_elements(tuple1, tuple2) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples, coercing mathematically integer floats to ints.\n    Raises TypeError, ValueError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n    # Parameter type enforcement\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n    # Validations\n    Validator.validate_length(tuple1, tuple2)\n    Validator.validate_no_zero_denominator(tuple2)\n    # Division and coercion\n    results = []\n    for a, b in zip(tuple1, tuple2):\n        q = a / b  # Python 3 numeric division\n        # If q is float and mathematically integer, coerce to int\n        if isinstance(q, float) and q.is_integer():\n            results.append(int(q))\n        else:\n            results.append(q)\n    return tuple(results)"}
{"task_id": "Mbpp/266", "solution": "class Cube:\n    \"\"\"Represents a cube and provides methods for its geometric calculations.\"\"\"\n    def __init__(self, side: float):\n        self.side: float = side\n\n    def lateralSurface(self) -> float:\n        \"\"\"Calculates the lateral surface area of the cube.\"\"\"\n        return 4 * (self.side ** 2)\n\nclass LateralSurfaceService:\n    \"\"\"Service class for calculating the lateral surface area of a cube.\"\"\"\n    def lateralsurface_cube(self, side: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cube using an instance method.\"\"\"\n        cube = Cube(side)\n        return cube.lateralSurface()\n\n    @staticmethod\n    def lateralsurface_cube_static(side: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cube using a static method.\"\"\"\n        cube = Cube(side)\n        return cube.lateralSurface()\n\ndef lateralsurface_cube(side: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    Delegates the calculation to a service class.\n    \"\"\"\n    return LateralSurfaceService.lateralsurface_cube_static(side)"}
{"task_id": "Mbpp/260", "solution": "class NewmanShanksWilliamsSequence:\n    \"\"\"\n    Generates Newman\u2013Shanks\u2013Williams (NSW) sequence values using recurrence.\n    S0 = 1, S1 = 1, S_n = 2*S_{n-1} + S_{n-2}.\n    \"\"\"\n    def __init__(self):\n        # Initialize cache with S0 and S1 (0-based indexing)\n        self._sequence_cache = [1, 1] \n\n    def generate_up_to_index(self, target_index: int) -> None:\n        \"\"\"\n        Generates and caches NSW sequence values up to the given target_index (0-based).\n        \"\"\"\n        # Target index must be non-negative for internal consistency; \n        # external validation handles n < 1 for 1-based input.\n        while len(self._sequence_cache) <= target_index:\n            s_prev_prev = self._sequence_cache[-2]\n            s_prev = self._sequence_cache[-1]\n            s_curr = 2 * s_prev + s_prev_prev\n            self._sequence_cache.append(s_curr)\n\n    def get(self, index: int) -> int:\n        \"\"\"\n        Returns the NSW sequence value at the given 0-based index.\n        For newman_prime(n) (1-based n), this retrieves S_n (cache[n]).\n        \"\"\"\n        if index >= len(self._sequence_cache):\n            self.generate_up_to_index(index)\n        return self._sequence_cache[index]\n\nclass NewmanPrimeFunction:\n    \"\"\"\n    Helper class for Newman\u2013Shanks\u2013Williams prime number related utilities.\n    Encapsulates input validation logic for the newman_prime function.\n    \"\"\"\n    @staticmethod\n    def validate_input(n) -> None:\n        \"\"\"\n        Validates the input n for the newman_prime function.\n        Raises TypeError if n is not an integer, ValueError if n < 1.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (1-based index).\")\n\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams (NSW) number S_n.\n    'n' is a 1-based index, so newman_prime(3) returns S_3 (which is 7).\n    \"\"\"\n    NewmanPrimeFunction.validate_input(n)\n    \n    sequence_generator = NewmanShanksWilliamsSequence()\n    value = sequence_generator.get(n)\n    \n    return value"}
{"task_id": "Mbpp/265", "solution": "from typing import List, Any, Iterable\n\nclass ValidationError(Exception):\n    \"\"\"Exception for validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Element:\n    \"\"\"Represents a single input element and its original index.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass ListInput:\n    \"\"\"Encapsulates the input iterable/list as Element instances.\"\"\"\n    def __init__(self, elements_iterable: Iterable) -> None:\n        self.elements: List[Element] = []\n        for i, value in enumerate(elements_iterable):\n            self.elements.append(Element(value, i))\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\nclass Sublist:\n    \"\"\"Collects Element instances assigned to this sublist.\"\"\"\n    def __init__(self) -> None:\n        self.elements: List[Element] = []\n\n    def append(self, element: Element) -> None:\n        self.elements.append(element)\n\n    def size(self) -> int:\n        return len(self.elements)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Converts collected elements to a plain Python list of values.\"\"\"\n        return [e.value for e in self.elements]\n\nclass ListSplitter:\n    \"\"\"Implements validation and distribution logic.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_n(self, n: int) -> None:\n        \"\"\"Validates the integer n. (Validation logic skipped due to prompt constraints).\"\"\"\n        pass\n\n    def distribute(self, input_list_obj: ListInput, n: int) -> List[Sublist]:\n        \"\"\"Distributes elements into n sublists based on (index mod n).\"\"\"\n        sublists: List[Sublist] = [Sublist() for _ in range(n)]\n\n        for element in input_list_obj.elements:\n            target_sublist_index = element.index % n\n            sublists[target_sublist_index].append(element)\n\n        return sublists\n\n    def list_split(self, input_list_obj: ListInput, n: int) -> List[Sublist]:\n        \"\"\"Orchestrates validation and distribution.\"\"\"\n        self.validate_n(n)\n        return self.distribute(input_list_obj, n)\n\n\ndef list_split(input_list, n):\n    \"\"\"Splits a list into n sublists based on element index modulo n.\"\"\"\n    list_input_obj = ListInput(input_list)\n    splitter = ListSplitter()\n    sublists = splitter.list_split(list_input_obj, n)\n\n    return [s.to_list() for s in sublists]"}
{"task_id": "Mbpp/268", "solution": "class FindStarFunction:\n    \"\"\"Encapsulates the logic for computing star numbers.\"\"\"\n\n    def _compute_formula(self, n: int) -> int:\n        \"\"\"Computes the n-th star number using the mathematical formula.\"\"\"\n        return 6 * n * (n - 1) + 1\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Internal method to find the n-th star number, without external validation.\"\"\"\n        return self._compute_formula(n)\n\ndef find_star_num(n: int) -> int:\n    \"\"\"Finds the n'th star number (1-based indexing).\"\"\"\n    finder = FindStarFunction()\n    return finder.find_star_num(n)"}
{"task_id": "Mbpp/267", "solution": "class OddNumber:\n    \"\"\"Helper class to get the k-th odd natural number.\"\"\"\n    @staticmethod\n    def kth(k: int) -> int:\n        return 2 * k - 1\n\nclass Sequence:\n    \"\"\"Helper class to generate a sequence of odd numbers.\"\"\"\n    @staticmethod\n    def generate(n: int):\n        for k in range(1, n + 1):\n            yield OddNumber.kth(k)\n\ndef square_Sum(n):\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Handles n=0 by returning 0, and assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for odd_num in Sequence.generate(n):\n        total_sum += odd_num * odd_num\n\n    return total_sum"}
{"task_id": "Mbpp/269", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Character:\n    \"\"\"Represents a single character string.\"\"\"\n    value: str\n\n    def __post_init__(self):\n        if not isinstance(self.value, str) or len(self.value) != 1:\n            raise ValueError(\"Character must be a single-character string.\")\n\n@dataclass\nclass AsciiCode:\n    \"\"\"Represents an ASCII integer code.\"\"\"\n    value: int\n\ndef ascii_value(char: 'Character | str') -> int:\n    \"\"\"Returns the ASCII integer code of a single character.\"\"\"\n    if hasattr(char, 'value'):\n        return ord(char.value)\n    else:\n        return ord(char)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(lst):\n    \"\"\"Return the sum (int) of elements in lst that are even-valued and located at even indices (0-based).\"\"\"\n    total = 0\n    for i, v in enumerate(lst):\n        if i % 2 == 0 and v % 2 == 0:\n            total += v\n    return total"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n):\n    \"\"\"Compute sum \u03a3_{k=1..n} (2k)^5.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(1, n + 1):\n        total_sum += (2 * k) ** 5\n    return total_sum"}
