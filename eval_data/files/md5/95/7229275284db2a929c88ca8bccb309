{"task_id": "Mbpp/165", "solution": "from src.domain import InputString, Character, Result\nfrom src.alphabet_mapper import AlphabetMapper\n\ndef count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based position in the English alphabet.\n    Handles case-insensitivity and ignores non-alphabetic characters for counting.\n    \"\"\"\n    count = 0\n    input_string = InputString(s)\n\n    # Iterate through the string, obtaining characters and their 0-based indices.\n    for i, char_val in enumerate(input_string.value):\n        one_based_index = i + 1  # Convert to 1-based index for comparison as per requirement.\n\n        # Create a Character domain object to encapsulate character-specific logic.\n        character_obj = Character(char_val, one_based_index)\n\n        # Only process alphabetic characters for position matching.\n        if character_obj.isAlphabetic():\n            alphabet_pos = character_obj.alphabetPosition()\n            \n            # Compare the character's alphabet position with its 1-based index in the string.\n            if alphabet_pos == one_based_index:\n                count += 1\n    \n    # Return the final count of characters whose alphabet position matches their string position.\n    return count"}
{"task_id": "Mbpp/167", "solution": "class Validation:\n    \"\"\"Provides input validation utilities for functions.\"\"\"\n\n    @staticmethod\n    def is_integer(n) -> bool:\n        \"\"\"Returns True if n is a standard Python int; otherwise False.\"\"\"\n        return isinstance(n, int)\n\ndef next_power_of_2(n) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Returns 1 if n is 0.\n    \"\"\"\n    if not Validation.is_integer(n):\n        raise TypeError(\"n must be an int\")\n\n    if n == 0:\n        return 1\n\n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
