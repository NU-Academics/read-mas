{"task_id": "Mbpp/283", "solution": "from typing import Dict\nfrom dataclasses import dataclass\n\n@dataclass\nclass IntegerInput:\n    value: int\n    normalized_value: int\n\n@dataclass\nclass DigitFrequency:\n    digit: int\n    count: int\n\n@dataclass\nclass ValidationResult:\n    is_valid: bool\n    reason: str\n\n\ndef normalize(n: int) -> int:\n    \"\"\"Returns the absolute value of the input integer.\"\"\"\n    return abs(n)\n\ndef compute_frequencies(n: int) -> Dict[int, int]:\n    \"\"\"Computes a mapping of digit to its count for decimal digits in the integer.\"\"\"\n    freqs: Dict[int, int] = {}\n    s = str(n)\n    for char_digit in s:\n        digit = int(char_digit)\n        freqs[digit] = freqs.get(digit, 0) + 1\n    return freqs\n\ndef compare_frequencies(freqs: Dict[int, int]) -> bool:\n    \"\"\"Checks if the frequency of each digit is less than or equal to the digit itself.\"\"\"\n    for digit, count in freqs.items():\n        if count > digit:\n            return False\n    return True\n\ndef validate(n: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    Operates on the absolute value of the input integer.\n    \"\"\"\n    normalized_n = normalize(n)\n    frequencies = compute_frequencies(normalized_n)\n    return compare_frequencies(frequencies)"}
