turn list(rotations)\n\n    def _is_substring(main_string: str, potential_substring: str) -> bool:\n        \"\"\"Checks if a potential_substring is present within main_string.\"\"\"\n        return potential_substring in main_string\n\n    if not b:\n        # An empty string is a substring of any string, and its only rotation is itself.\n        return True\n\n    rotations_of_b = _generate_rotations(b)\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    def _count_unique_characters(s):\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(s))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_characters(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If counts are equal, choose the one that comes first lexicographically\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    carrots_eaten_in_meal = 0\n    carrots_left_in_stock = 0\n\n    if need <= remaining:\n        carrots_eaten_in_meal = need\n        carrots_left_in_stock = remaining - need\n    else:\n        carrots_eaten_in_meal = remaining\n        carrots_left_in_stock = 0\n\n    total_eaten_carrots = number + carrots_eaten_in_meal\n\n    return [total_eaten_carrots, carrots_left_in_stock]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    # Define operator precedence and associativity\n    op_precedence = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    op_associativity = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    def _apply_op(op, left, right):\n        \"\"\"Applies a given operation to two operands.\"\"\"\n        if op == '+':\n            return left + right\n        elif op == '-':\n            return left - right\n        elif op == '*':\n            return left * right\n        elif op == '//':\n            return left // right\n        elif op == '**':\n            return left ** right\n        return 0 # Should not be reached with valid operators\n\n    # Convert infix expression to Reverse Polish Notation (RPN) using Shunting-yard algorithm\n    output_queue = []\n    operator_stack = []\n\n    for i in range(len(operand)):\n        output_queue.append(operand[i])\n        if i < len(operator):\n            current_op = operator[i]\n            while operator_stack and operator_stack[-1] != '(' and \\\n                  (op_precedence[operator_stack[-1]] > op_precedence[current_op] or \\\n                   (op_precedence[operator_stack[-1]] == op_precedence[current_op] and \\\n                    op_associativity[current_op] == 'left')):\\\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(current_op)\n\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    # Evaluate the RPN expression\n    evaluation_stack = []\n    for token in output_queue:\n        if isinstance(token, int):\n            evaluation_stack.append(token)\n        else:\n            right_operand = evaluation_stack.pop()\n            left_operand = evaluation_stack.pop()\n            evaluation_stack.append(_apply_op(token, left_operand, right_operand))\n\n    return evaluation_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n\n    def _is_letter(char):\n        \"\"\"Helper to determine if a character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _reverse_case(char):\n        \"\"\"Helper to reverse the case of an alphabetic character.\"\"\"\n        return char.swapcase()\n\n    def _contains_letters(text):\n        \"\"\"Helper to check if a string contains any alphabetic letters.\"\"\"\n        for char in text:\n            if _is_letter(char):\n                return True\n        return False\n\n    if not _contains_letters(s):\n        # If the string contains no letters, reverse the entire string.\n        return s[::-1]\n    else:\n        # If the string contains letters, process character by character.\n        result_chars = []\n        for char in s:\n            if _is_letter(char):\n                result_chars.append(_reverse_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "{\"error\": \"agent_no_response\", \"message\": \"Agent returned no response.\"}", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Generates a list of even digits (0, 2, 4, 6, 8) that fall within the\n    inclusive range defined by 'a' and 'b'. The list is returned in\n    ascending order.\n    \"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    EVEN_DIGITS_CANDIDATES = [0, 2, 4, 6, 8]\n\n    even_digits_in_range = []\n\n    for digit in EVEN_DIGITS_CANDIDATES:\n        if lower_bound <= digit <= upper_bound:\n            even_digits_in_range.append(digit)\n\n    return even_digits_in_range", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive. \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    class InputValidator:\n        \"\"\"Handles input validation based on problem constraints.\"\"\"\n        @staticmethod\n        def validate_grid(grid_data):\n            # Problem statement guarantees N x N grid with N >= 2 and unique values [1, N*N].\n            # As per instruction, no explicit raises for edge cases.\n            pass\n\n        @staticmethod\n        def validate_k(k_val):\n            # Problem statement guarantees k is a positive integer.\n            # As per instruction, no explicit raises for edge cases.\n            pass\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self.row = row\n            self.col = col\n            self.value = value\n\n        def get_neighbors(self, N: int) -> list[tuple[int, int]]:\n            \"\"\"Returns a list of (row, col) tuples for valid adjacent cells within an N x N grid.\"\"\"\n            neighbors = []\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n            for dr, dc in moves:\n                new_row, new_col = self.row + dr, self.col + dc\n                if 0 <= new_row < N and 0 <= new_col < N:\n                    neighbors.append((new_row, new_col))\n            return neighbors\n\n    class Grid:\n        \"\"\"Manages the grid structure, providing access to individual cells.\"\"\"\n        def __init__(self, raw_grid_data: list[list[int]]):\n            self.N = len(raw_grid_data)\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(r, c, raw_grid_data[r][c])\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the Cell object at the specified coordinates.\"\"\"\n            return self.cells[row][col]\n\n    class PathSolver:\n        \"\"\"Implements the DFS algorithm to find the lexicographically smallest path of length k.\"\"\"\n        def __init__(self, grid_obj: Grid, k_val: int):\n            self._grid_obj = grid_obj\n            self._k = k_val\n            self._N = grid_obj.N\n            self._min_path_values: list[int] = None # Stores the values of the current lexicographically smallest path found.\n\n        def _is_lexicographically_smaller(self, path_a_values: list[int], path_b_values: list[int]) -> bool:\n            \"\"\"Compares two lists of integers lexicographically.\"\"\"\n            for i in range(len(path_a_values)):\n                if path_a_values[i] < path_b_values[i]:\n                    return True\n                elif path_a_values[i] > path_b_values[i]:\n                    return False\n            return False # Paths are identical or A is not smaller\n\n        def _dfs(self, current_cell: Cell, current_path_cells: list[Cell], current_path_values: list[int]):\n            \"\"\"Recursively explores paths.\"\"\"\n            current_path_cells.append(current_cell)\n            current_path_values.append(current_cell.value)\n\n            if len(current_path_values) == self._k:\n                # Path of length k found, compare and update minimum if smaller.\n                if self._min_path_values is None or self._is_lexicographically_smaller(current_path_values, self._min_path_values):\n                    self._min_path_values = list(current_path_values) # Make a copy\n\n                current_path_values.pop() # Backtrack\n                current_path_cells.pop()\n                return\n\n            # Explore neighbors\n            for next_row, next_col in current_cell.get_neighbors(self._N):\n                next_cell = self._grid_obj.get_cell(next_row, next_col)\n                self._dfs(next_cell, current_path_cells, current_path_values)\n\n            current_path_values.pop() # Backtrack\n            current_path_cells.pop()\n\n        def find_minimum_path_values(self) -> list[int]:\n            \"\"\"Orchestrates the pathfinding process, returns the final minimum path values.\"\"\"\n            for r in range(self._N):\n                for c in range(self._N):\n                    start_cell = self._grid_obj.get_cell(r, c)\n                    self._dfs(start_cell, [], [])\n            return self._min_path_values\n\n    # Main execution logic for minPath function\n    InputValidator.validate_grid(grid)\n    InputValidator.validate_k(k)\n\n    grid_obj = Grid(grid)\n    solver = PathSolver(grid_obj, k)\n    result = solver.find_minimum_path_values()\n\n    