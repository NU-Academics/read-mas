ars)))\n\n    return segments\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    segments = _tokenize_string(s)\n    result_parts = [segment.get_value() for segment in segments]\n    return ''.join(result_parts)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["Hello World!!!"]], "plus_fail_tests": [["\n\n123 456\n789\n"]]}], "HumanEval/85": [{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    current_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 != 0:  # Check if index is odd\n            if element % 2 == 0:  # Check if element is even\n                current_sum += element\n    return current_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n\n    class GradingRule:\n        \"\"\"Represents a single rule in the grading scale, defining a GPA range and its letter grade.\"\"\"\n        def __init__(self, min_gpa, max_gpa, letter_grade, inclusive_min, inclusive_max):\n            self.min_gpa = min_gpa\n            self.max_gpa = max_gpa\n            self.letter_grade = letter_grade\n            self.inclusive_min = inclusive_min\n            self.inclusive_max = inclusive_max\n\n        def applies_to(self, gpa):\n            \"\"\"Checks if a given GPA falls within this rule's range considering inclusivity.\"\"\"\n            min_check = gpa >= self.min_gpa if self.inclusive_min else gpa > self.min_gpa\n            max_check = gpa <= self.max_gpa if self.inclusive_max else gpa < self.max_gpa\n            return min_check and max_check\n\n    class GradingScale:\n        \"\"\"Manages the collection of grading rules and converts a single GPA to a letter grade.\"\"\"\n        def __init__(self):\n            # Rules are ordered from highest GPA to lowest to ensure correct matching precedence.\n            self._rules = [\n                GradingRule(4.0, 4.0, 'A+', True, True),  # GPA == 4.0\n                GradingRule(3.7, 4.0, 'A', False, False), # > 3.7 and < 4.0\n                GradingRule(3.3, 3.7, 'A-', False, True), # > 3.3 and <= 3.7\n                GradingRule(3.0, 3.3, 'B+', False, True), # > 3.0 and <= 3.3\n                GradingRule(2.7, 3.0, 'B', False, True),  # > 2.7 and <= 3.0\n                GradingRule(2.3, 2.7, 'B-', False, True), # > 2.3 and <= 2.7\n                GradingRule(2.0, 2.3, 'C+', False, True), # > 2.0 and <= 2.3\n                GradingRule(1.7, 2.0, 'C', False, True),  # > 1.7 and <= 2.0\n                GradingRule(1.3, 1.7, 'C-', False, True), # > 1.3 and <= 1.7\n                GradingRule(1.0, 1.3, 'D+', False, True), # > 1.0 and <= 1.3\n                GradingRule(0.7, 1.0, 'D', False, True),  # > 0.7 and <= 1.0\n                GradingRule(0.0, 0.7, 'D-', False, True), # > 0.0 and <= 0.7\n                GradingRule(0.0, 0.0, 'E', True, True)    # GPA == 0.0\n            ]\n\n        def get_letter_grade(self, gpa):\n            \"\"\"Returns the letter grade for a given numerical GPA by checking against defined rules.\"\"\"\n            for rule in self._rules:\n                if rule.applies_to(gpa):\n                    return rule.letter_grade\n            return \"Invalid GPA\" # Fallback for GPAs not covered by rules (e.g., negative)\n\n    # Initialize the grading scale\n    scale = GradingScale()\n\n    # Convert each GPA in the input list to its corresponding letter grade\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(scale.get_letter_grade(gpa))\n\n    return letter_grades", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the nested list lst and returns a sorted list of its coordinates.\n    Coordinates are sorted primarily by row (ascending) and secondarily by column (descending).\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting lowercase alphabetic characters down by 4 positions, with circular rotation.\n    Non-lowercase alphabetic characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    shift = 4  # The alphabet shifts down by two multiplied to two places, so 2 * 2 = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the new position with circular rotation\n            # 'a' corresponds to 0, 'b' to 1, ..., 'z' to 25\n            shifted_char_code = ((ord(char) - ord('a') + shift) % 26) + ord('a')\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            # Non-lowercase characters are not encrypted\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of sentences starting with 'I' in the given string S.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n    boredom_count = 0\n    # Split the string by sentence delimiters '.', '?', or '!'.\n    # re.split creates a list of strings, with the delimiters removed.\n    sentences = re.split(r'[.?!]', S)\n\n    for sentence in sentences:\n        # Remove leading/trailing whitespace from the sentence.\n        cleaned_sentence = sentence.strip()\n\n        # Check if the cleaned sentence is not empty.\n        if cleaned_sentence:\n            # Split the cleaned sentence into words.\n            # .split() without arguments handles multiple spaces.\n            words = cleaned_sentence.split()\n\n            # Check if there's at least one word in the sentence.\n            if words:\n                first_word = words[0]\n                # A boredom is a sentence that starts with the word \"I\" (case-sensitive).\n                if first_word ==