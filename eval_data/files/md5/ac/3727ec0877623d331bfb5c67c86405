us": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a class based on letter case count (CAP - SM).\n    Returns 'ClassName.StrongestExtensionName', choosing the first one in case of a tie.\n    \"\"\"\n    def _calculate_strength(extension_name):\n        \"\"\"Calculates the strength of an extension as uppercase count minus lowercase count.\"\"\"\n        uppercase_count = 0\n        lowercase_count = 0\n        for char in extension_name:\n            if char.isupper():\n                uppercase_count += 1\n            elif char.islower():\n                lowercase_count += 1\n        return uppercase_count - lowercase_count\n\n    if not extensions:\n        return class_name + \".\"\n\n    strongest_extension_name = None\n    max_strength = float('-inf')\n\n    for extension_name in extensions:\n        current_strength = _calculate_strength(extension_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n        # Tie-breaking: If current_strength == max_strength,\n        # we do not update, preserving the first encountered extension.\n\n    return class_name + \".\" + strongest_extension_name", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number out of range [1, 1000]\")\n\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n\n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no primes are found.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def find_primes(numbers: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers, returning a new list containing only the prime numbers.\"\"\"\n        prime_list = []\n        for num in numbers:\n            if is_prime(num):\n                prime_list.append(num)\n        return prime_list\n\n    def find_largest_prime(primes: list[int]) -> int | None:\n        \"\"\"Identifies and returns the largest integer from a given list of prime numbers.\"\"\"\n        if not primes:\n            return None\n        return max(primes)\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given integer, using its absolute value.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    prime_numbers = find_primes(lst)\n    largest_prime = find_largest_prime(prime_numbers)\n\n    if largest_prime is not None:\n        return sum_digits(largest_prime)\n    else:\n        return 0", "