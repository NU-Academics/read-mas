n    def count_digits(self):\n        \"\"\"Returns the number of digits in the name part.\"\"\"\n        return sum(1 for char in self._value if char.isdigit())\nclass FileName:\n    \"\"\"Encapsulates the full file name string and coordinates its validation.\"\"\"\n    def __init__(self, full_string):\n        self._full_string = full_string\n\n        parts = full_string.split('.')\n        self._has_exactly_one_dot = (len(parts) == 2)\n\n        if self._has_exactly_one_dot:\n            name_str = parts[0]\n            ext_str = parts[1]\n        else:\n            name_str = \"\"\n            ext_str = \"\"\n\n        self._name_part = NamePart(name_str)\n        self._extension_part = ExtensionPart(ext_str)\n\n    def check_validity(self):\n        \"\"\"Returns True if the file name is valid, False otherwise.\"\"\"\n        # Condition: The file's name contains exactly one dot '.'\n        if not self._has_exactly_one_dot:\n            return False\n\n        # Condition: There should not be more than three digits ('0'-'9') in the file's name.\n        if self._name_part.count_digits() > 3:\n            return False\n\n        # Condition: The substring before the dot should not be empty\n        if self._name_part.is_empty():\n            return False\n\n        # Condition: it starts with a letter from the latin alphapet ('a'-'z' and 'A'-'Z').\n        if not self._name_part.starts_with_letter():\n            return False\n\n        # Condition: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n        if not self._extension_part.is_allowed():\n            return False\n\n        return True\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_obj = FileName(file_name)\n    if file_obj.check_validity():\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n\n    def _is_multiple_of(number, factor):\n        \"\"\"Checks if a number is a multiple of a given factor.\"\"\"\n        return number % factor == 0\n\n    def _transform_value(value, index):\n        \"\"\"Applies transformation to a value based on its index.\"\"\"\n        if _is_multiple_of(index, 3):\n            return value * value\n        elif _is_multiple_of(index, 4):  # This implies not a multiple of 3\n            return value * value * value\n        else:\n            return value\n\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        transformed_value = _transform_value(value, index)\n        total_sum += transformed_value\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Parses two fraction strings, multiplies them, and determines if the product is a whole number.\n    Returns True if x * n evaluates to a whole number, False otherwise.\n    \"\"\"\n\n    class Fraction:\n        \"\"\"\n        Represents a fraction with a numerator and denominator, providing methods\n        for parsing, multiplication, and whole number checking.\n        \"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        @staticmethod\n        def parse(fraction_str: str) -> 'Fraction':\n            \"\"\"Parses a string \"<numerator>/<denominator>\" into a Fraction object.\"\"\"\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another fraction and returns a new Fraction object.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Checks if the fraction represents a whole number.\"\"\"\n            # A fraction is a whole number if its numerator is perfectly divisible by its denominator.\n            # Handle cases where the denominator could potentially be 1 implicitly, e.g., 5/1 is a whole number.\n            return self.denominator != 0 and (self.numerator % self.denominator == 0)\n\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()", "base_status": "p