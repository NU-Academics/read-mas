"\"\"\n    Sorts an array of integers based on two criteria:\n    1. Primary key: Count of set bits in the binary representation of the number's absolute value (ascending).\n    2. Secondary key: The actual decimal value of the number (ascending).\n    \"\"\"\n    return sorted(arr, key=lambda num: (_count_set_bits_for_sort_key(num), num))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    It integrates validation and calculation logic directly.\n    \"\"\"\n    if not (1 <= len(grid) <= 100):\n        raise ValueError(f\"Grid row count must be between 1 and 100, got {len(grid)}.\")\n\n    num_cols = len(grid[0])\n    if not (1 <= num_cols <= 100):\n        raise ValueError(f\"Well length (column count) must be between 1 and 100, got {num_cols}.\")\n\n    for i, row in enumerate(grid):\n        if len(row) != num_cols:\n            raise ValueError(f\"All wells must have the same length. Row {i} has length {len(row)}, expected {num_cols}.\")\n        for j, cell in enumerate(row):\n            if cell not in (0, 1):\n                raise ValueError(f\"Grid elements must be 0 or 1. Found {cell} at grid[{i}][{j}].\")\n\n    if not (1 <= capacity <= 10):\n        raise ValueError(f\"Bucket capacity must be between 1 and 10, got {capacity}.\")\n\n    total_operations = 0\n\n    for well_row in grid:\n        water_amount = sum(well_row)\n\n        operations_for_well = 0\n        if water_amount > 0:\n            operations_for_well = math.ceil(water_amount / capacity)\n\n        total_operations += operations_for_well\n\n    return total_operations", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(