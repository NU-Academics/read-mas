                return False\n        return balance == 0 # Balanced if final count is zero.\n\n    # Helper function to validate the input list structure.\n    def _validate_input_list(lst_input):\n        if not (isinstance(lst_input, list) and len(lst_input) == 2):\n            raise ValueError(\"Input must be a list of two elements.\")\n        if not (isinstance(lst_input[0], str) and isinstance(lst_input[1], str)):\n            raise ValueError(\"List elements must be strings.\")\n\n    # Helper function to validate string content.\n    def _validate_string_content(s_input):\n        for char in s_input:\n            if char not in ('(', ')'):\n                raise ValueError(\"String contains invalid characters.\")", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["()(", ")"]]], "plus_fail_tests": [[["(", "("]]]}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    def _fibonacci_generator():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield b\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = _fibonacci_generator()\n\n    while True:\n        fib_number = next(fib_gen)\n        if _is_prime(fib_number):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_number", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n\n    def _has_at_most_two_digits(num: int) -> bool:\n        \"\"\"Checks if an integer has at most two digits by comparing its absolute value to 100.\"\"\"\n        return abs(num) < 100\n\n    current_sum = 0\n    # Iterate over the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Add the element to the sum if it satisfies the two-digit condition.\n        if _has_at_most_two_digits(element):\n            current_sum += element\n\n    return current_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of length k containing the maximum k numbers from arr.\n    If k is 0, an empty list is returned.\n    \"\"\"\n    if k == 0:\n        return []\n\n    arr.sort()\n    return arr[-k:]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = [n]\n    current_term = n\n    while current_term != 1:\n        if current_term % 2 == 0:\n            current_term //= 2\n        else:\n            current_term = 3 * current_term + 1\n        sequence.append(current_term)\n\n    odd_numbers = [num for num in sequence if num % 2 != 0]\n    odd_numbers.sort()\n\n    return odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 == 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a given character is a vowel.\"\"\"\n    return char in VOWELS\ndef is_consonant(char: str) -> bool:\n    \"\"\"Checks if a given character is a consonant.\"\"\"\n    return char.isalpha() and char not in VOWELS\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between\n    two consonants from the right side of the word (case sensitive).\n\n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition.\n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    for i in range(len(word) - 2, 0, -1):\n        if is_vowel(word[i]):\n            if is_consonant(word[i - 1]) and is_consonant(word[i + 1]):\n                return word[i]\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example:\n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n\n    class Date:\n        \"\"\"A simple data structure to hold parsed date components.\"\"\"\n        def __init__(self, month: int, day: int, year: int):\n            self.month = month\n            self.day = day\n            self.year = year\n\n    def _is_not_empty(date_string: str) -> bool:\n        \"\"\"Checks if the input date string is not empty.\"\"\"\n        return bool(date_string)\n\n    def _has_correct_format(date_string: str) -> bool:\n        \"\"\"Validates if the date string adheres to the 'mm-dd-yyyy' format.\"\"\"\n        if len(date_string) != 10:\n            return False\n        if date_string[2] != '-' or date_string[5] != '-':\n            return False\n        try:\n            int(date_string[0:2])\n            int(date_string[3:5])\n            int(date_string[6:10])\n        except ValueError:\n            return False\n        return True\n\n    def _parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"Parses month, day, and year integers from a formatted date string.\"\"\"\n        try:\n            month = int(date_string[0:2])\n            day = int(date_string[3:5])\n            year = int(date_string[6:10])\n            return (month, day, year)\n        except ValueError:\n            return None\n\n    def _is_valid_month(month: int) -> bool:\n        \"\"\"Checks if the month component is within the valid range of 1 to 12.\"\"\"\n        return 1 <= month <= 12\n\n    def _is_valid_day_for_month(month: int, day: int) -> bool:\n        \"\"\"Validates the day component based on the specific month's rules.\"\"\"\n        if day < 1:\n            return False\n\n        months_31_days = {1, 3, 5, 7, 8, 10, 12}\n        months_30_days = {4, 6, 9, 11}\n\n        if month in months_31_days:\n            return day <= 31\n        elif month in months_30_days:\n            return day <= 30\n        elif month == 2:\n            # February allows up to 29 days, no leap year logic required.\n            return day <= 29\n        else:\n            return False\n\n    # Main logic of the valid_date function\n    if not _is_not_empty(date):\n        return False\n\n    if not _has_correct_format(date):\n        return False\n\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, year = components\n\n    # Create Date object as per design context, even if not explicitly used by subsequent checks.\n    _ = Date(month, day, year)\n\n    if not _is_valid_month(month):\n        return False\n\n    if not _is_valid_day_for_month(month, day):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    def _get_sign(number):\n        \"\"\"Determines the sign of a single integer.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number):\n        \"\"\"Determines the magnitude (absolute value) of a single integer.\"\"\"\n        return abs(number)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n        sum_of_magnitudes += _get_magnitude(number)\n\n    return sum_of_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not part of a word.\n    A \"word\" is defined as a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    preceding_char = txt[-2]\n    return preceding_char.isspace()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["apple pi\ne"]]}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n\n    def _check_non_negative_integers(lst_param: list) -> bool:\n        \"\"\"\n        Checks if all elements in the list are non-negative integers.\n        \"\"\"\n        for x in lst_param:\n            if not isinstance(x, int) or x < 0:\n                return False\n        return True\n\n    def _is_ascending_order(lst_param: list) -> bool:\n        \"\"\"\n        Checks if the list is sorted in ascending order.\n        \"\"\"\n        for i in range(len(lst_param) - 1):\n            if lst_param[i] > lst_param[i+1]:\n                return False\n        return True\n\n    def _has_valid_duplicates(lst_param: list) -> bool:\n        \"\"\"\n        Checks if any number in the list occurs more than two times.\n        \"\"\"\n        counts = {}\n        for x in lst_param:\n            counts[x] = counts.get(x, 0) + 1\n            if counts[x] > 2:\n                return False\n        return True\n\n    if not _check_non_negative_integers(lst):\n        return False\n\n    if not _is_ascending_order(lst):\n        return False\n\n    if not _has_valid_duplicates(lst):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    int_start = max(start1, start2)\n    int_end = min(end1, end2)\n\n    length = max(0, int_end - int_start)\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n    # Convert the number to a string to easily iterate through its digits.\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            has_odd_digit = True\n\n    # If no odd digits were found, return 0 as per the requirement.\n    if not has_odd_digit:\n        return 0\n    return product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        squared_number = int(rounded_number ** 2)\n        total_sum += squared_number\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    # Check if the text contains any whitespace character.\n    if any(char.isspace() for char in txt):\n        return txt.split()\n    # Check if the text contains a comma character.\n    elif ',' in txt:\