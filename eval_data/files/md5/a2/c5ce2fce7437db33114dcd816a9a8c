{"task_id": "HumanEval/32", "solution": "import math\n_DEFAULT_TOLERANCE = 1e-6\n_DEFAULT_MAX_ITERATIONS = 100\n_DEFAULT_SEARCH_LOWER_BOUND = -100.0\n_DEFAULT_SEARCH_UPPER_BOUND = 100.0\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n.\n    \"\"\"\n    if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"Coefficients must be a list of numbers.\")\n    if not isinstance(x, (int, float)):\n        raise ValueError(\"x must be a number.\")\n\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single real zero for a polynomial whose coefficients are given by xs.\n    The polynomial must have an odd degree (an even number of coefficients).\n    \"\"\"\n    if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"Coefficients must be a list of numbers.\")\n\n    if len(xs) % 2 != 0:\n        raise ValueError(\"Polynomial must have an even number of coefficients (odd degree) to guarantee a solution for find_zero.\")\n\n    lower_bound = _DEFAULT_SEARCH_LOWER_BOUND\n    upper_bound = _DEFAULT_SEARCH_UPPER_BOUND\n    tolerance = _DEFAULT_TOLERANCE\n    max_iterations = _DEFAULT_MAX_ITERATIONS\n\n    f_lower = poly(xs, lower_bound)\n    f_upper = poly(xs, upper_bound)\n\n    if f_lower * f_upper > 0:\n        raise ValueError(\"Function has same sign at both ends of the interval. Bisection method cannot guarantee a root within the default range.\")\n    if lower_bound >= upper_bound:\n        raise ValueError(\"Lower bound must be less than upper bound.\")\n\n    if abs(f_lower) < tolerance:\n        return float(lower_bound)\n    if abs(f_upper) < tolerance:\n        return float(upper_bound)\n\n    for _ in range(max_iterations):\n        mid = (lower_bound + upper_bound) / 2\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < tolerance:\n            return float(mid)\n\n        if f_lower * f_mid < 0:\n            upper_bound = mid\n            f_upper = f_mid\n        else:\n            lower_bound = mid\n            f_lower = f_mid\n    \n    raise ValueError(\"Bisection method did not converge within max_iterations.\")"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three,\n    while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at indices divisible by three\n    third_elements = [l[i] for i in range(len(l)) if i % 3 == 0]\n    third_elements.sort()\n\n    # Create a new list to store the result\n    result = list(l)  # Create a shallow copy\n\n    # Replace elements at indices divisible by three with sorted values\n    sorted_idx = 0\n    for i in range(len(result)):\n        if i % 3 == 0:\n            result[i] = third_elements[sorted_idx]\n            sorted_idx += 1\n    return result"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list.\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert to a set to remove duplicates, then convert back to a list and sort it.\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list `l`. Raises `ValueError` if `l` is empty.\"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    max_val = l[0]\n    for element in l:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Returns a new list containing only the unique elements from the input list, sorted in ascending order.\n    Raises TypeError if input is not a list or elements are not comparable.\"\"\"\n    \n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a Python list.\")\n    \n    # Convert the list to a set to extract unique elements, then back to a list.\n    unique_elements = list(set(l))\n    \n    # Sort the unique elements in ascending order.\n    # Python's sorted() will raise TypeError if elements are not comparable.\n    return sorted(unique_elements)"}
