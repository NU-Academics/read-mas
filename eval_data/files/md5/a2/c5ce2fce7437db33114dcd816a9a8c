{"task_id": "HumanEval/40", "solution": "from typing import List\ndef triples_sum_to_zero(l: List[int]) -> bool:\n    \"\"\"\n    Checks if three distinct elements in the list sum to zero.\n    Returns True if such a triplet exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to efficiently find triplets using a two-pointer approach.\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant checks.\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True  # A triplet summing to zero is found.\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n    return False  # No such triplet was found after checking all combinations."}
{"task_id": "HumanEval/41", "solution": "class InputValidator:\n    \"\"\"\n    Validates input parameters for the car race collision calculation.\n    \"\"\"\n    def validate_n(self, n: int) -> None:\n        \"\"\"\n        Validates that n is a non-negative integer.\n        Raises ValueError if n is not an integer or is negative.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\nclass CollisionCalculatorService:\n    \"\"\"\n    Provides the core business logic for calculating car race collisions.\n    \"\"\"\n    def calculate_collisions(self, n: int) -> int:\n        \"\"\"\n        Calculates the total number of collisions between two sets of n cars.\n        Returns the total number of collisions (n * n).\n        \"\"\"\n        return n * n\nclass CollisionController:\n    \"\"\"\n    Orchestrates the car race collision calculation, handling input validation\n    and delegating to the calculation service.\n    \"\"\"\n    def __init__(self, validator: InputValidator, calculator: CollisionCalculatorService):\n        self._validator = validator\n        self._calculator = calculator\n\n    def car_race_collision(self, n: int) -> int:\n        \"\"\"\n        Calculates the number of collisions in a car race scenario.\n        Validates n and then calculates and returns the collision count.\n        \"\"\"\n        self._validator.validate_n(n)\n        return self._calculator.calculate_collisions(n)\ndef car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right; simultaneously, a different set of n cars\n    are driving right to left. The two sets of cars start out being very far from\n    each other. All cars move in the same speed. Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    validator = InputValidator()\n    calculator = CollisionCalculatorService()\n    controller = CollisionController(validator, calculator)\n    return controller.car_race_collision(n)"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list) -> list:\n    \"\"\"Return a new list with all numeric elements incremented by 1.\n    Raises TypeError if input is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    incremented_list = []\n    for item in l:\n        if isinstance(item, (int, float)):\n            incremented_list.append(item + 1)\n        else:\n            raise TypeError(f\"List elements must be numeric (int or float), got {type(item).__name__}.\")\n    return incremented_list"}
{"task_id": "HumanEval/43", "solution": "from typing import List, Set, Any\ndef pairs_sum_to_zero(l: List[int]) -> bool:\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in l:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    seen_numbers: Set[int] = set()\n    for num in l:\n        complement = -num\n        # If the complement has been seen, we found two distinct elements from different indices.\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n\n    return False"}
