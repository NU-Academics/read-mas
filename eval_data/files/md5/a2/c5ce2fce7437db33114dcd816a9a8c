{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be a number.\")\n    if number < 0:\n        raise ValueError(\"Input number must be positive.\")\n    \n    return number - int(number)"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if any two numbers in the list are closer than or equal to the given threshold.\n    This helps identify potential data issues or specific numerical patterns.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Using <= to align with the provided test case for zero threshold,\n            # which expects True for identical numbers when threshold is 0.0.\n            if abs(numbers[i] - numbers[j]) <= threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    result = []\n    balance = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and i >= start_index: # Ensure we've processed at least one char for a group\n            group = cleaned_string[start_index : i + 1]\n            result.append(group)\n            start_index = i + 1\n            \n    return result"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    # Validate the input 'numbers' list and its elements.\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input 'numbers' must be a list.\")\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise ValueError(\"All elements in 'numbers' must be numeric (int or float).\")\n\n    # Validate the input 'threshold'.\n    if not isinstance(threshold, (int, float)):\n        raise ValueError(\"Input 'threshold' must be a number.\")\n    if threshold <= 0:\n        raise ValueError(\"Input 'threshold' must be a positive number.\")\n\n    # Handle lists with fewer than two elements, as no pairs can be formed.\n    if len(numbers) < 2:\n        return False\n\n    # Sort the list to optimize proximity checking to O(N log N).\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through adjacent elements to find a pair closer than the threshold.\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True # A close pair was found.\n\n    return False # No close pair was found after checking all possibilities."}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    result = []\n    current_group_chars = []\n    balance = 0\n    \n    for char in paren_string:\n        if char == '(':\n            balance += 1\n            current_group_chars.append(char)\n        elif char == ')':\n            balance -= 1\n            current_group_chars.append(char)\n        # Non-parenthesis characters are ignored.\n            \n        if balance == 0 and current_group_chars:\n            # A balanced group is found; add to result and reset.\n            result.append(\"\".join(current_group_chars))\n            current_group_chars = []\n        elif balance < 0:\n            # Imbalance detected; discard current partial group and reset balance.\n            current_group_chars = []\n            balance = 0\n\n    return result"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be a number.\")\n    if number < 0:\n        raise ValueError(\"Input number must be positive.\")\n\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Checks if a sequence of financial operations causes the account balance to fall below zero.\n    The account starts with a zero balance.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) for a list of numbers.\n    MAD is the average absolute difference from the mean of the dataset.\n    \"\"\"\n    if not numbers:\n        # Raise an error if the input list is empty.\n        raise ValueError(\"Input list cannot be empty.\")\n\n    if len(numbers) == 1:\n        # Return 0.0 for a single-element list as MAD is zero.\n        return 0.0\n\n    # Calculate the arithmetic mean of the input numbers.\n    mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute difference between each number and the mean.\n    absolute_differences = [abs(x - mean) for x in numbers]\n\n    # Calculate the average of these absolute differences to determine MAD.\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a delimiter between every two consecutive elements of the input list.\n    Returns a new list with the delimiter interspersed.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass MadException(Exception):\n    \"\"\"Custom exception for Mean Absolute Deviation calculation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    Calculates the Mean Absolute Deviation (MAD) of a dataset around its mean.\n    Raises MadException if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise MadException(\"Input list for Mean Absolute Deviation cannot be empty.\")\n\n    # Calculate the arithmetic mean of the dataset.\n    mean_value = sum(numbers) / len(numbers)\n\n    # Compute the absolute differences between each number and the mean.\n    absolute_differences = [abs(x - mean_value) for x in numbers]\n    \n    # Calculate the average of these absolute differences to get the MAD.\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Handles empty and single-element lists gracefully.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    # Add each number to the result, followed by the delimeter unless it's the last element.\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
