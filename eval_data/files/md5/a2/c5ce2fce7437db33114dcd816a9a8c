{"task_id": "HumanEval/62", "solution": "class InvalidPolynomialError(ValueError):\n    \"\"\"Custom exception for invalid polynomial inputs.\"\"\"\n    pass\ndef derivative(xs: list) -> list[float]:\n    \"\"\"\n    Calculates the derivative of a polynomial represented by a list of coefficients.\n    xs[i] is the coefficient of x^i.\n    \"\"\"\n    # Validate input type and content as per FR1 and Polynomial class constructor.\n    if not isinstance(xs, list):\n        raise InvalidPolynomialError(\"Coefficients must be a list.\")\n    for coeff in xs:\n        if not isinstance(coeff, (int, float)):\n            raise InvalidPolynomialError(\"All coefficients must be numeric.\")\n\n    # Convert all coefficients to float for consistent calculations and output.\n    processed_coeffs = [float(c) for c in xs]\n\n    # Handle empty list or constant polynomial as per FR4 and FR5.\n    if len(processed_coeffs) <= 1:\n        return []\n\n    # Calculate the derivative coefficients as per FR2.\n    derived_coeffs = []\n    for i in range(1, len(processed_coeffs)):\n        derived_coeffs.append(i * processed_coeffs[i])\n\n    return derived_coeffs"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, where 'y' is a vowel only if it is the last character.\n    Vowel identification is case-insensitive, and non-alphabetic characters are ignored.\n    \"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    if not s:\n        return 0\n\n    for i, char in enumerate(s):\n        char_lower = char.lower()\n        if char_lower in standard_vowels:\n            vowel_count += 1\n        elif char_lower == 'y' and i == len(s) - 1:\n            vowel_count += 1\n    return vowel_count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Performs a circular right shift on the digits of integer `x` by `shift` positions, returning the result as a string.\n    If `shift` is greater than the number of digits, the digits are reversed instead.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1] # Reverse the string\n    else:\n        effective_shift = shift % n\n        return s[n - effective_shift:] + s[:n - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII codes of only the uppercase characters in a string.\n    Returns 0 if no uppercase characters are found or if the string is empty.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        return s[-shift:] + s[:-shift]"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Returns the greatest integer whose frequency is greater than or equal to its value.\n    If no such integer exists in the list, -1 is returned.\n    \"\"\"\n    if not lst:\n        return -1\n\n    frequencies = Counter(lst)\n\n    # Sort unique positive numbers in descending order to find the greatest efficiently.\n    sorted_unique_numbers = sorted(frequencies.keys(), reverse=True)\n\n    for num in sorted_unique_numbers:\n        # Per requirements, only positive integers are considered.\n        if num > 0 and frequencies[num] >= num:\n            return num\n\n    return -1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in a strange order: min, then max of remaining, then min, and so on.\n    Handles empty lists by returning an empty list.\n    \"\"\"\n    if not lst:\n        return []\n\n    temp_list = sorted(lst) # Sorts the input list to simplify min/max extraction.\n    result = []\n    is_min_turn = True\n\n    while temp_list:\n        if is_min_turn:\n            result.append(temp_list.pop(0)) # Extracts the smallest remaining element.\n        else:\n            result.append(temp_list.pop())  # Extracts the largest remaining element.\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal places, or -1.0 if the sides do not form a valid triangle.\n    \"\"\"\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    raw_area = math.sqrt(area_squared)\n\n    return round(raw_area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\nclass TriangleValidator:\n    @staticmethod\n    def is_valid(a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if three side lengths form a valid triangle.\n        Returns True if valid, False otherwise (including non-positive sides).\n        \"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c) and (a + c > b) and (b + c > a)\nclass TriangleCalculator:\n    @staticmethod\n    def calculate_area(a: float, b: float, c: float) -> float:\n        \"\"\"\n        Calculates the area of a triangle using Heron's formula.\n        Assumes inputs form a valid triangle and rounds to two decimal places.\n        \"\"\"\n        s = (a + b + c) / 2\n        area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n        return round(area, 2)\nINVALID_TRIANGLE_RETURN_VALUE = -1.00\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    if not TriangleValidator.is_valid(a, b, c):\n        return INVALID_TRIANGLE_RETURN_VALUE\n    \n    return TriangleCalculator.calculate_area(a, b, c)"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    if not isinstance(brackets, str):\n        raise TypeError(\"Input 'brackets' must be a string.\")\n\n    stack = []\n    OPENING_BRACKET = '<'\n    CLOSING_BRACKET = '>'\n\n    for char in brackets:\n        if char == OPENING_BRACKET:\n            stack.append(char)\n        elif char == CLOSING_BRACKET:\n            if not stack:\n                return False  # Unmatched closing bracket found.\n            stack.pop()\n        # Other characters are ignored as per FR4.\n\n    return not stack  # Return True if all brackets are matched."}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr: list[int]) -> int:\n    \"\"\"Calculates the minimum changes to make an array palindromic.\n    It counts differing elements from the array's ends.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in the array must be integers.\")\n\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    left, right = 0, n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
