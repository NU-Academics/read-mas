{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple integer power of n.\n    x is a simple power of n if x = n**k for some integer k.\n    \"\"\"\n    EPSILON = 1e-9  # Tolerance for floating-point comparisons.\n\n    # Handle invalid inputs as per functional requirements.\n    if x < 0:\n        raise ValueError(\"x must be a non-negative number.\")\n    if n <= 0 and x > 0:\n        raise ValueError(\"n must be a positive number when x is positive.\")\n\n    # Handle specific edge cases.\n    if x == 0:\n        return n == 0\n    if n == 1:\n        return x == 1\n\n    # For the general case, calculate k = log_n(x) = log(x) / log(n).\n    power = math.log(x) / math.log(n)\n    return math.isclose(power, round(power), abs_tol=EPSILON)"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a cube of some integer number.\n    Assumes 'a' is a valid integer input.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root and round to the nearest integer.\n    # math.cbrt handles negative numbers correctly.\n    root = round(math.cbrt(a))\n\n    # Verify if cubing the integer root results in the original number.\n    return root * root * root == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Checks if the given integer 'a' is a perfect cube.\n    Assumes 'a' is always a valid integer.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Determine the sign of the number and calculate the cube root of its absolute value.\n    sign = 1 if a > 0 else -1\n    cube_root_candidate = round(abs(a)**(1/3))\n\n    # Verify if the candidate, when cubed with its correct sign, equals the original number.\n    return (sign * cube_root_candidate)**3 == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a string.\n    Returns the count of '2', '3', '5', '7', 'B', 'D' in the input string.\n    \"\"\"\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in PRIME_HEX_DIGITS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is 'happy': at least 3 characters long, with every 3 consecutive characters distinct.\n    Raises TypeError if input 's' is not a string.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if any two characters in the triplet are the same.\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n    return True"}
{"task_id": "HumanEval/82", "solution": "import math\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer `n` is a prime number.\n    It uses a trial division algorithm up to the square root of `n`.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 2:\n        return False\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"\n    Checks if the length of a string is a prime number.\n    This function calculates the string's length and delegates the primality check to a helper function.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    This uses the principle of inclusion-exclusion to sum counts and subtract overlaps.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Calculate count of n-digit numbers starting with 1.\n    # For n=1, this is 1 (the number 1). For n > 1, it's 1 followed by n-1 digits (10^(n-1)).\n    count_starts_with_1 = 10**(n - 1)\n\n    # Calculate count of n-digit numbers ending with 1.\n    # For n=1, this is 1 (the number 1). For n >= 2, the first digit has 9 choices (1-9)\n    # and the middle n-2 digits have 10 choices each (0-9), resulting in 9 * 10^(n-2).\n    if n == 1:\n        count_ends_with_1 = 1\n    else:\n        count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers starting AND ending with 1.\n    # For n=1, this is 1 (the number 1). For n=2, this is 1 (the number 11).\n    # For n > 2, it's 1 followed by n-2 digits (0-9) then 1, which is 10^(n-2).\n    if n == 1:\n        count_starts_and_ends_with_1 = 1\n    elif n == 2:\n        count_starts_and_ends_with_1 = 1\n    else:\n        count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the principle of inclusion-exclusion: P(A or B) = P(A) + P(B) - P(A and B).\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
{"task_id": "HumanEval/83", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    It uses the principle of inclusion-exclusion for an efficient O(1) computation.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return 1\n\n    # Count of n-digit numbers starting with 1. The first digit is 1, remaining n-1 digits can be 0-9.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1. The first digit has 9 choices (1-9), n-2 middle digits have 10 choices.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting AND ending with 1. First and last digits are 1, n-2 middle digits can be 0-9.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the Principle of Inclusion-Exclusion.\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n    return total_count"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    MIN_N = 0\n    MAX_N = 10000\n\n    # FR1: Validate input N against type and range constraints.\n    if not isinstance(N, int):\n        raise ValueError(\"Input N must be an integer.\")\n    if not (MIN_N <= N <= MAX_N):\n        raise ValueError(f\"Input N must be between {MIN_N} and {MAX_N}.\")\n\n    # FR2: Calculate the sum of the decimal digits of N.\n    sum_of_digits = 0\n    current_N = N\n    while current_N > 0:\n        sum_of_digits += current_N % 10\n        current_N //= 10\n\n    # FR3 & FR4: Convert the calculated sum to its binary string representation.\n    if sum_of_digits == 0:\n        return \"0\"\n    else:\n        return bin(sum_of_digits)[2:]"}
{"task_id": "HumanEval/84", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass DigitSumCalculator:\n    \"\"\"Calculates the sum of decimal digits of an integer.\"\"\"\n\n    def calculate(self, number: int) -> int:\n        \"\"\"Computes the sum of the decimal digits of the given number.\n        It handles non-negative integers as expected by the problem constraints.\n        \"\"\"\n        if number < 0:\n            number = abs(number)\n        \n        sum_digits = 0\n        num_str = str(number)\n        for digit_char in num_str:\n            sum_digits += int(digit_char)\n        return sum_digits\nclass BinaryConverter:\n    \"\"\"Converts an integer to its binary string representation.\"\"\"\n\n    def convert(self, number: int) -> str:\n        \"\"\"Converts a non-negative integer to its binary string representation.\n        Example: 6 -> \"110\".\n        \"\"\"\n        if number < 0:\n            raise ValueError(\"Cannot convert negative number to binary string directly.\")\n        \n        if number == 0:\n            return \"0\"\n            \n        return bin(number)[2:]\nclass Solver:\n    \"\"\"\n    Orchestrates the calculation of the sum of digits and its conversion to a binary string.\n    \"\"\"\n    def __init__(self):\n        self._digit_sum_calculator = DigitSumCalculator()\n        self._binary_converter = BinaryConverter()\n\n    def solve(self, N: int) -> str:\n        \"\"\"Given an integer N, calculates the sum of its digits and returns it in binary string format.\n        It validates N against constraints 0 <= N <= 10000.\n        \"\"\"\n        if not isinstance(N, int):\n            raise InvalidInputError(\"Input N must be an integer.\")\n        if not (0 <= N <= 10000):\n            raise InvalidInputError(f\"Input N must be between 0 and 10000, but got {N}.\")\n\n        sum_of_digits = self._digit_sum_calculator.calculate(N)\n        binary_sum_string = self._binary_converter.convert(sum_of_digits)\n        return binary_sum_string\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    solver_instance = Solver()\n    return solver_instance.solve(N)"}
{"task_id": "HumanEval/85", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to calculation methods.\"\"\"\n    pass\ndef add(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers, sum its even elements that are at odd indices.\n    Raises InvalidInputError if the list is empty or contains non-integer elements.\n    \"\"\"\n    if not lst:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n    \n    total_sum = 0\n    for i, element in enumerate(lst):\n        if not isinstance(element, int):\n            raise InvalidInputError(f\"List element at index {i} is not an integer: {element}\")\n        \n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Characters within each word are arranged in ascending ASCII order,\n    while preserving the original order of words and blank spaces.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not s:\n        return \"\"\n\n    WHITESPACE_PATTERN = r'(\\s+)' # Regex to split by whitespace and keep the delimiters.\n    segments = re.split(WHITESPACE_PATTERN, s)\n    processed_segments = []\n\n    for segment in segments:\n        # If a segment is not empty and not purely whitespace, it's considered a word.\n        if segment and not segment.isspace():\n            processed_segments.append(\"\".join(sorted(segment)))\n        else:\n            # Otherwise, it's whitespace or an empty string artifact from splitting; preserve it.\n            processed_segments.append(segment)\n\n    return \"\".join(processed_segments)"}
{"task_id": "HumanEval/86", "solution": "def sort_word_characters(word: str) -> str:\n    \"\"\"Sorts characters within a word in ascending ASCII order.\n    It returns a new string with the characters reordered.\"\"\"\n    return \"\".join(sorted(word))\ndef anti_shuffle(s: str) -> str:\n    \"\"\"Takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not s:\n        return \"\"\n\n    parts = []\n    current_segment = \"\"\n    # Tracks if the current_segment is accumulating spaces (True) or word characters (False).\n    is_space_segment = False \n\n    for char in s:\n        if char == ' ':\n            # If current segment was a word, finalize it before starting a new space segment.\n            if not is_space_segment and current_segment:\n                parts.append(current_segment)\n                current_segment = \"\"\n            is_space_segment = True\n        else: # char is not a space\n            # If current segment was spaces, finalize it before starting a new word segment.\n            if is_space_segment and current_segment:\n                parts.append(current_segment)\n                current_segment = \"\"\n            is_space_segment = False\n        current_segment += char\n\n    # Append any remaining segment after the loop.\n    if current_segment:\n        parts.append(current_segment)\n\n    processed_parts = []\n    for part in parts:\n        if ' ' in part: # This segment consists of one or more spaces, preserve it as is.\n            processed_parts.append(part)\n        else: # This segment is a word, sort its characters.\n            processed_parts.append(sort_word_characters(part))\n\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple, Any\nclass Coordinate:\n    \"\"\"\n    A simple Data Transfer Object for (row, column) coordinates.\n    Implements custom less-than for specified sorting rules.\n    \"\"\"\n    def __init__(self, row: int, column: int):\n        self.row = row\n        self.column = column\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Converts the Coordinate object into a standard (row, column) tuple.\"\"\"\n        return (self.row, self.column)\n\n    def __lt__(self, other: 'Coordinate') -> bool:\n        \"\"\"\n        Implements less-than comparison for sorting.\n        Primarily by row ascending, secondarily by column descending.\n        \"\"\"\n        if self.row != other.row:\n            return self.row < other.row\n        return self.column > other.column\n\n    def __repr__(self) -> str:\n        return f\"Coordinate({self.row}, {self.column})\"\nclass CoordinateFinder:\n    \"\"\"\n    Encapsulates logic to find target integers in a 2D list and sort their coordinates.\n    This class is stateless and its method can be called directly.\n    \"\"\"\n    @staticmethod\n    def find_coordinates(data: List[List[Any]], target: Any) -> List[Tuple[int, int]]:\n        \"\"\"\n        Finds all occurrences of target in data and returns their sorted coordinates.\n        Coordinates are sorted by row ascending, then column descending.\n        \"\"\"\n        found_coordinates: List[Coordinate] = []\n\n        # Handle flat list input by wrapping it in another list.\n        # This treats a flat list like [1, 2, 3] as a single row 0.\n        is_flat_list_input = not isinstance(data, list) or (data and not isinstance(data[0], (list, tuple)))\n        processed_data = [data] if is_flat_list_input else data\n\n        for r_idx, row in enumerate(processed_data):\n            # Ensure 'row' is iterable, handling cases where a 'row' element is not a list itself.\n            iterable_row = row if isinstance(row, (list, tuple)) else [row]\n\n            for c_idx, element in enumerate(iterable_row):\n                if element == target:\n                    found_coordinates.append(Coordinate(r_idx, c_idx))\n\n        # Sort the coordinates using the custom __lt__ method defined in Coordinate.\n        found_coordinates.sort()\n\n        return [coord.to_tuple() for coord in found_coordinates]\ndef get_row(lst: List[List[Any]], x: Any) -> List[Tuple[int, int]]:\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    return CoordinateFinder.find_coordinates(lst, x)"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character counts and returns the list with fewer characters.\n    If counts are equal, the first list is returned.\n    \"\"\"\n\n    def _calculate_total_characters(string_list: list[str]) -> int:\n        \"\"\"Calculates the sum of lengths of all strings in a list, validating input types.\"\"\"\n        if not isinstance(string_list, list):\n            raise TypeError(\"Input must be a list.\")\n        \n        total_chars = 0\n        for s in string_list:\n            if not isinstance(s, str):\n                raise TypeError(f\"List elements must be strings, found {type(s).__name__}.\")\n            total_chars += len(s)\n        return total_chars\n\n    sum1 = _calculate_total_characters(lst1)\n    sum2 = _calculate_total_characters(lst2)\n\n    if sum1 < sum2:\n        return lst1\n    elif sum2 < sum1:\n        return lst2\n    else:  # sum1 == sum2, return the first list as per business rule.\n        return lst1"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The sorting order depends on the parity of the sum of its first and last elements.\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    array_copy = list(array)  # Create a copy to ensure immutability.\n\n    if sum_first_last % 2 != 0:  # Odd sum, sort ascending.\n        array_copy.sort()\n    else:  # Even sum, sort descending.\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
{"task_id": "HumanEval/88", "solution": "class ArrayUtils:\n    @staticmethod\n    def is_sum_odd(first: int, last: int) -> bool:\n        \"\"\"Checks if the sum of two integers is odd.\"\"\"\n        return (first + last) % 2 != 0\n\n    @staticmethod\n    def is_sum_even(first: int, last: int) -> bool:\n        \"\"\"Checks if the sum of two integers is even.\"\"\"\n        return (first + last) % 2 == 0\ndef sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array based on the parity of the sum of its first and last elements, returning a new sorted array.\n    The original array remains unchanged.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    # Create a copy to ensure the original array is not modified.\n    copied_array = list(array)\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n\n    if ArrayUtils.is_sum_odd(first_element, last_element):\n        return sorted(copied_array)  # Sort in ascending order.\n    else:  # The sum is even.\n        return sorted(copied_array, reverse=True)  # Sort in descending order."}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string using a rotational cipher.\n    Alphabetic characters are rotated by 4 positions, preserving case.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    ROTATION_AMOUNT = 4\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z' or 'A' <= char <= 'Z':\n            is_upper = 'A' <= char <= 'Z'\n            \n            if is_upper:\n                start_ord = ord('A')\n            else:\n                start_ord = ord('a')\n            \n            shifted_ord = (ord(char) - start_ord + ROTATION_AMOUNT) % 26 + start_ord\n            encrypted_chars.append(chr(shifted_ord))\n        else:\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypts a string by shifting lowercase alphabetic characters\n    forward by 4 positions, wrapping around the alphabet.\n    Non-alphabetic characters are left unchanged.\n    \"\"\"\n    ALPHABET_SIZE = 26\n    SHIFT_AMOUNT = 4\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_char_code = ord('a')\n            char_code = ord(char)\n            shifted_char_code = start_char_code + (char_code - start_char_code + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    # Get unique elements and sort them.\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the second smallest unique element in a list of integers.\n    Returns None if there is no such element (e.g., fewer than two unique elements).\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Convert to a set to get unique elements, then convert back to list and sort.\n    unique_sorted_list = sorted(list(set(lst)))\n\n    # If the list has fewer than two unique elements, the second smallest does not exist.\n    if len(unique_sorted_list) < 2:\n        return None\n    else:\n        return unique_sorted_list[1]"}
{"task_id": "HumanEval/91", "solution": "class SentenceSplitter:\n    \"\"\"Utility for splitting text into sentences.\"\"\"\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def __init__(self):\n        \"\"\"Initializes the SentenceSplitter.\"\"\"\n        pass\n\n    def split(self, text: str) -> list[str]:\n        \"\"\"Splits the input text into a list of sentences based on delimiters.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input must be a string.\")\n        \n        # Replace delimiters with a unique marker to split\n        temp_text = text\n        for delimiter in self.SENTENCE_DELIMITERS:\n            temp_text = temp_text.replace(delimiter, delimiter + \"|SPLIT|\")\n        \n        # Split by the marker and filter out empty strings after stripping\n        sentences = [s.strip() for s in temp_text.split(\"|SPLIT|\") if s.strip()]\n        return sentences\nclass WordChecker:\n    \"\"\"Utility for checking the first word of a sentence.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the WordChecker.\"\"\"\n        pass\n\n    def starts_with_i(self, sentence: str) -> bool:\n        \"\"\"Checks if the trimmed sentence starts with the case-sensitive word 'I'.\"\"\"\n        if not isinstance(sentence, str):\n            raise TypeError(\"Input must be a string.\")\n            \n        trimmed_sentence = sentence.strip()\n        if not trimmed_sentence:\n            return False\n        \n        # Find the first word by splitting on space and taking the first element\n        first_word = trimmed_sentence.split(' ')[0]\n        return first_word == \"I\"\nclass BoredomCounter:\n    \"\"\"Orchestrates counting 'boredoms' in text using SentenceSplitter and WordChecker.\"\"\"\n\n    def __init__(self, sentence_splitter: SentenceSplitter, word_checker: WordChecker):\n        \"\"\"Initializes with instances of SentenceSplitter and WordChecker.\"\"\"\n        self.sentence_splitter = sentence_splitter\n        self.word_checker = word_checker\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Takes a string, splits it into sentences, and counts how many start with 'I'.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input must be a string.\")\n\n        sentences = self.sentence_splitter.split(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self.word_checker.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    splitter = SentenceSplitter()\n    checker = WordChecker()\n    counter = BoredomCounter(splitter, checker)\n    return counter.count_boredoms(S)"}
{"task_id": "HumanEval/91", "solution": "import re\nSENTENCE_DELIMITERS = ['.', '?', '!']\nTARGET_WORD = \"I\"\nclass SentenceSplitter:\n    \"\"\"Utility to split text into sentences based on predefined delimiters.\"\"\"\n    def split(self, text: str) -> list[str]:\n        # Temporarily replace delimiters with themselves followed by a space to aid splitting.\n        for delim in SENTENCE_DELIMITERS:\n            text = text.replace(delim, delim + ' ')\n        \n        # Split by any of the delimiters, then clean and filter out empty strings.\n        sentences = re.split(r'[.?!]', text)\n        return [s.strip() for s in sentences if s.strip()]\nclass WordChecker:\n    \"\"\"Utility to check if a sentence starts with the standalone word 'I'.\"\"\"\n    def starts_with_i(self, sentence: str) -> bool:\n        if not sentence:\n            return False\n        # Checks for 'I' as a whole word at the beginning of the sentence.\n        return bool(re.match(r'^' + re.escape(TARGET_WORD) + r'\\b', sentence))\nclass BoredomCounter:\n    \"\"\"Service to count \"boredom\" sentences using injected utilities.\"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter, word_checker: WordChecker):\n        self.sentence_splitter = sentence_splitter\n        self.word_checker = word_checker\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Counts sentences starting with \"I\" in the given text.\"\"\"\n        boredom_count = 0\n        sentences = self.sentence_splitter.split(text)\n        for sentence in sentences:\n            if self.word_checker.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    splitter = SentenceSplitter()\n    checker = WordChecker()\n    counter = BoredomCounter(splitter, checker)\n    return counter.count_boredoms(S)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if all three inputs are integers and if one is the sum of the other two.\n    Returns True if conditions are met, False otherwise.\n    \"\"\"\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n    \n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping the case of letters and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, with wrap-around.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        processed_char = char\n\n        if char.isalpha():\n            # First, apply vowel replacement if applicable.\n            if char.lower() in VOWELS_LOWER:\n                is_upper = char.isupper()\n                alphabet = ALPHABET_UPPER if is_upper else ALPHABET_LOWER\n                \n                index = alphabet.index(char)\n                shifted_index = (index + 2) % len(alphabet)\n                processed_char = alphabet[shifted_index]\n            \n            # Then, swap the case of the resulting character.\n            if processed_char.islower():\n                processed_char = processed_char.upper()\n            elif processed_char.isupper():\n                processed_char = processed_char.lower()\n        \n        encoded_chars.append(processed_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "import math\nclass NoPrimesFoundError(Exception):\n    \"\"\"Custom exception raised when no prime numbers are found in a list.\n    It provides a descriptive message for the error scenario.\n    \"\"\"\n    def __init__(self, message=\"No prime numbers found in the list.\"):\n        self.message = message\n        super().__init__(self.message)\nclass PrimeChecker:\n    \"\"\"Utility class responsible for determining if a given integer is a prime number.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if the input integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\nclass DigitSummer:\n    \"\"\"Utility class responsible for calculating the sum of the digits of a given integer.\"\"\"\n    def sum_digits(self, n: int) -> int:\n        \"\"\"Calculates the sum of the individual digits of the input integer n.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\nclass PrimeProcessor:\n    \"\"\"Orchestrates finding the largest prime in a list and then summing its digits.\n    It acts as the main entry point for the application's core logic.\n    \"\"\"\n    def __init__(self, prime_checker: PrimeChecker, digit_summer: DigitSummer):\n        \"\"\"Constructor for PrimeProcessor, injecting dependencies.\"\"\"\n        self.prime_checker = prime_checker\n        self.digit_summer = digit_summer\n\n    def find_largest_prime_and_sum_digits(self, lst: list[int]) -> int:\n        \"\"\"Finds the largest prime in the given list and returns the sum of its digits.\"\"\"\n        largest_prime = None\n\n        for num in lst:\n            if self.prime_checker.is_prime(num):\n                if largest_prime is None or num > largest_prime:\n                    largest_prime = num\n\n        if largest_prime is None:\n            raise NoPrimesFoundError()\n\n        return self.digit_summer.sum_digits(largest_prime)\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    prime_checker = PrimeChecker()\n    digit_summer = DigitSummer()\n    processor = PrimeProcessor(prime_checker, digit_summer)\n    return processor.find_largest_prime_and_sum_digits(lst)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function returns False if the dictionary is empty or contains non-string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys()) # Creates a list of keys for multiple checks.\n\n    # Return False if any key in the dictionary is not a string.\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    # Return True if all string keys are entirely in lowercase.\n    all_lower = all(key == key.lower() for key in keys)\n    if all_lower:\n        return True\n\n    # Return True if all string keys are entirely in uppercase.\n    all_upper = all(key == key.upper() for key in keys)\n    if all_upper:\n        return True\n\n    # Otherwise, return False for mixed-case string keys.\n    return False"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a string by swapping letter cases and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, preserving case.\n    \"\"\"\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    ALPHABET_MAP_LOWER = {\n        ALPHABET_LOWER[i]: ALPHABET_LOWER[(i + 2) % len(ALPHABET_LOWER)]\n        for i in range(len(ALPHABET_LOWER))\n    }\n    ALPHABET_MAP_UPPER = {\n        ALPHABET_UPPER[i]: ALPHABET_UPPER[(i + 2) % len(ALPHABET_UPPER)]\n        for i in range(len(ALPHABET_UPPER))\n    }\n\n    def _swap_case(char: str) -> str:\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    def _get_vowel_replacement(char: str) -> str:\n        if char in VOWELS_LOWER:\n            return ALPHABET_MAP_LOWER.get(char, char)\n        elif char in VOWELS_UPPER:\n            return ALPHABET_MAP_UPPER.get(char, char)\n        return char\n\n    encoded_chars = []\n    for char in message:\n        swapped_char = _swap_case(char)\n\n        if swapped_char in VOWELS_LOWER or swapped_char in VOWELS_UPPER:\n            final_char = _get_vowel_replacement(swapped_char)\n        else:\n            final_char = swapped_char\n        encoded_chars.append(final_char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "class MathUtils:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer is a prime number. Optimizes by checking divisors up to its square root.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of an integer's absolute value.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        return sum(int(digit) for digit in str(abs(n)))\nclass PrimeService:\n    def __init__(self, math_utils: MathUtils):\n        \"\"\"Initializes PrimeService with a MathUtils instance for mathematical operations.\"\"\"\n        self.math_utils = math_utils\n\n    def find_largest_prime_digit_sum(self, lst: list[int]) -> int:\n        \"\"\"\n        Finds the largest prime in a list and returns the sum of its digits. \n        Handles type validation and edge cases like empty lists or no primes.\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        if not all(isinstance(x, int) for x in lst):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        primes = self._find_primes_in_list(lst)\n        \n        if not primes:\n            return 0\n\n        largest_prime = self._find_largest_prime(primes)\n        return self.math_utils.sum_digits(largest_prime)\n\n    def _find_primes_in_list(self, lst: list[int]) -> list[int]:\n        \"\"\"Filters a list to return only the prime numbers using MathUtils.is_prime.\"\"\"\n        return [num for num in lst if self.math_utils.is_prime(num)]\n\n    def _find_largest_prime(self, primes: list[int]) -> int:\n        \"\"\"Finds the largest number in a list of primes. Returns 0 if the list is empty.\"\"\"\n        return max(primes) if primes else 0\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    math_utils = MathUtils()\n    prime_service = PrimeService(math_utils)\n    return prime_service.find_largest_prime_digit_sum(lst)"}
