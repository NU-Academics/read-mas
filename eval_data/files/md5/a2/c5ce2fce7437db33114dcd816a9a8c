{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if any cyclic rotation of string b is a substring of string a.\n    Generates all unique rotations of b and then checks for their presence in a.\n    \"\"\"\n    if not b:\n        return False\n\n    # Generate all unique cyclic rotations of b\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n\n    # Check if any generated rotation is a substring of a\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/63", "solution": "from typing import Dict\nclass FibFibCalculator:\n    \"\"\"Calculates FibFib numbers with memoization for O(n) efficiency.\n    Base cases (0, 1, 2) are pre-filled in the memoization dictionary.\n    \"\"\"\n    def __init__(self):\n        self._memo: Dict[int, int] = {\n            0: 0,\n            1: 0,\n            2: 1\n        }\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the n-th FibFib number, raising ValueError for negative n.\"\"\"\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n        return self._compute_recursive(n)\n\n    def _compute_recursive(self, n: int) -> int:\n        \"\"\"Recursive helper using memoization to avoid redundant computations.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        # Calculate using the recurrence relation and store the result.\n        result = (\n            self._compute_recursive(n - 1)\n            + self._compute_recursive(n - 2)\n            + self._compute_recursive(n - 3)\n        )\n        self._memo[n] = result\n        return result\n_calculator = FibFibCalculator()\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is defined by base cases and a recurrence relation.\n    This function efficiently computes the n-th element using memoization.\n    \"\"\"\n    return _calculator.calculate(n)"}
{"task_id": "HumanEval/67", "solution": "import re\nclass InvalidInputFormatException(Exception):\n    \"\"\"Custom exception for invalid input string format.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass FruitParser:\n    \"\"\"Logic for parsing fruit count strings.\"\"\"\n    FRUIT_PATTERN = r\"(\\d+)\\s+(apples|oranges)\"\n\n    def parse_fruit_counts(self, s: str) -> dict[str, int]:\n        \"\"\"Parses the input string to find the number of apples and oranges.\n        Throws InvalidInputFormatException if parsing fails.\n        \"\"\"\n        counts = {\"apples\": 0, \"oranges\": 0}\n        matches = re.findall(self.FRUIT_PATTERN, s)\n\n        found_apples = False\n        found_oranges = False\n\n        for count_str, fruit_type in matches:\n            if fruit_type == \"apples\":\n                counts[fruit_type] = int(count_str)\n                found_apples = True\n            elif fruit_type == \"oranges\":\n                counts[fruit_type] = int(count_str)\n                found_oranges = True\n        \n        if not (found_apples and found_oranges):\n            raise InvalidInputFormatException(f\"Missing apple or orange count in string: '{s}'\")\n\n        return counts\nclass FruitCalculator:\n    \"\"\"Core business logic for calculating mangoes.\"\"\"\n    def calculate_mangoes(self, total_fruits: int, apples: int, oranges: int) -> int:\n        \"\"\"Calculates the number of mangoes based on total fruits, apples, and oranges.\"\"\"\n        return total_fruits - (apples + oranges)\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Raises InvalidInputFormatException if the input string 's' cannot be parsed.\n    \"\"\"\n    parser = FruitParser()\n    calculator = FruitCalculator()\n\n    try:\n        fruit_counts = parser.parse_fruit_counts(s)\n        apples = fruit_counts.get(\"apples\", 0)\n        oranges = fruit_counts.get(\"oranges\", 0)\n        \n        return calculator.calculate_mangoes(n, apples, oranges)\n    except InvalidInputFormatException as e:\n        raise e"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    Applies lexicographical tie-breaking for words with equal unique character counts.\n    \"\"\"\n\n    def _count_unique_chars(word: str) -> int:\n        \"\"\"Counts unique characters in a string using a set.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If counts are equal, use lexicographical order to break ties.\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom dataclasses import dataclass\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a given grid.\n    Path length k means visiting exactly k cells (not necessarily distinct).\n    \"\"\"\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"Path length 'k' must be a positive integer.\")\n    if not isinstance(grid, list) or not all(isinstance(row, list) for row in grid):\n        raise ValueError(\"Grid must be a list of lists.\")\n    \n    N = len(grid)\n    if N < 2:\n        raise ValueError(\"Grid dimension N must be at least 2.\")\n    if not all(len(row) == N for row in grid):\n        raise ValueError(\"Grid must be square (N x N).\")\n\n    @dataclass(order=True)\n    class PathState:\n        values: tuple[int, ...]\n        row: int\n        col: int\n        length: int\n\n    def get_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        \"\"\"\n        Returns valid adjacent cell coordinates within the N x N grid.\n        Movement is restricted to cells sharing an edge.\n        \"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < N and 0 <= nc < N:\n                neighbors.append((nr, nc))\n        return neighbors\n\n    priority_queue: list[PathState] = []\n\n    for r in range(N):\n        for c in range(N):\n            initial_path_values = (grid[r][c],)\n            heapq.heappush(priority_queue, PathState(initial_path_values, r, c, 1))\n\n    while priority_queue:\n        current_path_state = heapq.heappop(priority_queue)\n\n        if current_path_state.length == k:\n            return list(current_path_state.values)\n\n        if current_path_state.length < k:\n            for nr, nc in get_neighbors(current_path_state.row, current_path_state.col):\n                new_path_values = current_path_state.values + (grid[nr][nc],)\n                new_path_state = PathState(new_path_values, nr, nc, current_path_state.length + 1)\n                heapq.heappush(priority_queue, new_path_state)\n    \n    # This part should theoretically not be reached due to problem guarantee.\n    return []"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Computes the MD5 hash of a string, returning None for empty strings.\n    The input string is encoded using UTF-8 before hashing.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/160", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Raised when input types or formats are incorrect.\"\"\"\n    pass\nclass InvalidExpressionError(ValueError):\n    \"\"\"Raised when the expression structure is invalid.\"\"\"\n    pass\nclass InvalidOperatorError(ValueError):\n    \"\"\"Raised when an unsupported operator is encountered.\"\"\"\n    pass\nclass EvaluationError(ValueError):\n    \"\"\"Raised when the expression evaluation fails.\"\"\"\n    pass\nALLOWED_OPERATORS = {\"+\", \"-\", \"*\", \"//\", \"**\"}\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists of operators and operands, build and evaluate an algebraic expression.\n    It returns the integer result of the expression evaluation.\n    \"\"\"\n    # FR1: Validate input types and operand non-negativity.\n    if not isinstance(operator, list) or not all(isinstance(op, str) for op in operator):\n        raise InvalidInputError(\"Operators must be a list of strings.\")\n    if not isinstance(operand, list) or not all(isinstance(op, int) and op >= 0 for op in operand):\n        raise InvalidInputError(\"Operands must be a list of non-negative integers.\")\n\n    # FR4, BR1.3: Operator list must have at least one operator.\n    if len(operator) < 1:\n        raise InvalidExpressionError(\"Operator list must have at least one operator.\")\n    \n    # FR3, BR1.4: Operand list must have at least two operands.\n    if len(operand) < 2:\n        raise InvalidExpressionError(\"Operand list must have at least two operands.\")\n\n    # FR2, BR1.1: Validate list lengths.\n    if len(operator) != len(operand) - 1:\n        raise InvalidExpressionError(\"Length of operator list must be equal to length of operand list minus one.\")\n\n    # FR7: Validate all operators are supported.\n    for op in operator:\n        if op not in ALLOWED_OPERATORS:\n            raise InvalidOperatorError(f\"Unsupported operator: '{op}'\")\n\n    # FR5: Construct the algebraic expression string.\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n    expression_string = \" \".join(expression_parts)\n\n    # FR6, FR8: Safely evaluate the expression and return integer result.\n    try:\n        # Using eval with restricted builtins for security; a custom parser is safer for untrusted inputs.\n        result = eval(expression_string, {\"__builtins__\": {}}, {})\n        if not isinstance(result, int):\n            raise EvaluationError(\"Expression did not evaluate to an integer.\")\n        return result\n    except ZeroDivisionError:\n        raise EvaluationError(\"Division by zero occurred during evaluation.\")\n    except Exception as e:\n        raise EvaluationError(f\"Failed to evaluate expression: {e}\")"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, returns all even integers between them (inclusive).\n    The list is returned in ascending order, or an empty list if no even integers are found.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    even_numbers = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n    return even_numbers"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a and b, in ascending order.\n    Returns an empty list if no even digits are found.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits = []\n    for i in range(min_val, max_val + 1):\n        # Check if 'i' is a single digit (0-9) and even.\n        if 0 <= i <= 9 and i % 2 == 0:\n            even_digits.append(i)\n\n    return sorted(list(set(even_digits)))"}
{"task_id": "HumanEval/160", "solution": "from enum import Enum\nfrom typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Exception for invalid input to the do_algebra function.\"\"\"\n    pass\nclass EvaluationError(Exception):\n    \"\"\"Exception for errors during expression evaluation.\"\"\"\n    pass\nclass Operator(Enum):\n    \"\"\"Defines supported algebraic operations.\"\"\"\n    ADD = \"+\"\n    SUBTRACT = \"-\"\n    MULTIPLY = \"*\"\n    FLOOR_DIVIDE = \"//\"\n    EXPONENTIATE = \"**\"\n\n    @staticmethod\n    def from_symbol(symbol: str) -> 'Operator':\n        \"\"\"Converts a string symbol to an Operator enum member.\"\"\"\n        for op in Operator:\n            if op.value == symbol:\n                return op\n        raise ValueError(f\"Unsupported operator symbol: {symbol}\")\nOPERATOR_PRECEDENCE = {\n    Operator.ADD: 1,\n    Operator.SUBTRACT: 1,\n    Operator.MULTIPLY: 2,\n    Operator.FLOOR_DIVIDE: 2,\n    Operator.EXPONENTIATE: 3,\n}\nclass AlgebraEvaluator:\n    \"\"\"Manages input validation, parsing, and expression evaluation.\"\"\"\n    def __init__(self):\n        self._precedence = OPERATOR_PRECEDENCE\n\n    def do_algebra(self, operator_symbols: List[str], operands: List[int]) -> int:\n        \"\"\"Public entry point: validates, parses, and evaluates an algebraic expression.\"\"\"\n        self._validate_inputs(operator_symbols, operands)\n        operators = self._parse_operators(operator_symbols)\n        return self._evaluate_expression(operators, operands)\n\n    def _validate_inputs(self, operator_symbols: List[str], operands: List[int]) -> None:\n        \"\"\"Validates input list lengths and operand values.\"\"\"\n        if not operator_symbols:\n            raise InvalidInputError(\"Operator list cannot be empty.\")\n        if len(operands) < 2:\n            raise InvalidInputError(\"Operand list must contain at least two operands.\")\n        if len(operator_symbols) != len(operands) - 1:\n            raise InvalidInputError(\"Length of operator list must be one less than operand list.\")\n        for operand in operands:\n            if not isinstance(operand, int) or operand < 0:\n                raise InvalidInputError(f\"Operand must be a non-negative integer, got: {operand}\")\n\n    def _parse_operators(self, operator_symbols: List[str]) -> List[Operator]:\n        \"\"\"Converts string operator symbols to Operator enum members.\"\"\"\n        parsed_operators = []\n        for symbol in operator_symbols:\n            try:\n                parsed_operators.append(Operator.from_symbol(symbol))\n            except ValueError as e:\n                raise InvalidInputError(str(e))\n        return parsed_operators\n\n    def _apply_operator(self, op: Operator, val1: int, val2: int) -> int:\n        \"\"\"Executes a single binary operation.\"\"\"\n        if op == Operator.ADD:\n            return val1 + val2\n        elif op == Operator.SUBTRACT:\n            return val1 - val2\n        elif op == Operator.MULTIPLY:\n            return val1 * val2\n        elif op == Operator.FLOOR_DIVIDE:\n            if val2 == 0:\n                raise EvaluationError(\"Division by zero is not allowed.\")\n            return val1 // val2\n        elif op == Operator.EXPONENTIATE:\n            return val1 ** val2\n        else:\n            raise EvaluationError(f\"Unknown operator during evaluation: {op.value}\")\n\n    def _evaluate_expression(self, operators: List[Operator], operands: List[int]) -> int:\n        \"\"\"Evaluates expression using precedence rules. Iterates through precedence levels to apply operators.\"\"\"\n        current_operands = list(operands)\n        current_operators = list(operators)\n\n        for precedence_level in sorted(set(self._precedence.values()), reverse=True):\n            i = 0\n            while i < len(current_operators):\n                op = current_operators[i]\n                if self._precedence[op] == precedence_level:\n                    val1 = current_operands.pop(i)\n                    val2 = current_operands.pop(i)\n                    result = self._apply_operator(op, val1, val2)\n                    current_operands.insert(i, result)\n                    current_operators.pop(i)\n                else:\n                    i += 1\n        \n        if len(current_operands) != 1 or len(current_operators) != 0:\n            raise EvaluationError(\"Expression evaluation resulted in an unexpected state.\")\n\n        return current_operands[0]\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. Uses these lists to build and evaluate an algebraic expression.\n    \"\"\"\n    evaluator = AlgebraEvaluator()\n    return evaluator.do_algebra(operator, operand)"}
