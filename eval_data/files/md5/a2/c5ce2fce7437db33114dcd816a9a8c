{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triple exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to efficiently use the two-pointer technique.\n    # This modifies the list in-place, which is acceptable for a utility function.\n    l.sort()\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first pointer to avoid redundant calculations.\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/46", "solution": "class Fib4Calculator:\n    \"\"\"Calculates the n-th Fib4 number iteratively.\"\"\"\n    def calculate(self, n: int) -> int:\n        # Handles base cases for n < 4 directly.\n        # This function uses a fixed-size list for O(1) space.\n        if n == 0:\n            return 0\n        if n == 1:\n            return 0\n        if n == 2:\n            return 2\n        if n == 3:\n            return 0\n\n        # last_four stores [fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1)] for current k.\n        # It's initialized with fib4(0), fib4(1), fib4(2), fib4(3) for k=4.\n        last_four = [0, 0, 2, 0]\n\n        for i in range(4, n + 1):\n            next_fib = last_four[0] + last_four[1] + last_four[2] + last_four[3]\n            last_four[0] = last_four[1]\n            last_four[1] = last_four[2]\n            last_four[2] = last_four[3]\n            last_four[3] = next_fib\n        \n        return last_four[3]\ndef fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    calculator = Fib4Calculator()\n    return calculator.calculate(n)"}
{"task_id": "HumanEval/33", "solution": "def _get_third_elements(l: list) -> tuple[list, list]:\n    \"\"\"Extracts elements at indices divisible by three along with their indices.\n    This helper identifies elements to be sorted and their original positions.\n    \"\"\"\n    third_elements = []\n    third_indices = []\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            third_elements.append(item)\n            third_indices.append(i)\n    return third_elements, third_indices\ndef _reconstruct_list(original_list: list, sorted_third_elements: list, third_indices: list) -> list:\n    \"\"\"Reconstructs a new list, placing sorted elements back into their original divisible-by-three indices.\n    Elements at other indices are copied from the original list.\n    \"\"\"\n    result_list = list(original_list)\n    sorted_idx = 0\n    for original_idx in third_indices:\n        result_list[original_idx] = sorted_third_elements[sorted_idx]\n        sorted_idx += 1\n    return result_list\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    third_elements, third_indices = _get_third_elements(l)\n\n    if not third_elements:\n        return list(l)\n\n    third_elements.sort()\n\n    return _reconstruct_list(l, third_elements, third_indices)"}
