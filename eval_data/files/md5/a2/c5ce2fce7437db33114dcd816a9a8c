{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Changes the numerical base of integer `x` to the specified `base`. Returns a string representation of the converted number.\"\"\"\n    MIN_BASE = 2\n    MAX_BASE = 9\n\n    if not (MIN_BASE <= base <= MAX_BASE):\n        raise ValueError(f\"Base must be between {MIN_BASE} and {MAX_BASE}.\")\n    if x < 0:\n        raise ValueError(\"Input number x must be non-negative.\")\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n    return \"\".join(reversed(result))"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise ValueError(\"Input number x must be a non-negative integer.\")\n    if not isinstance(base, int) or not (2 <= base < 10):\n        raise ValueError(\"Base must be an integer between 2 and 9.\")\n\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(result_digits[::-1])"}
