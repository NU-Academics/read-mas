{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sevens_count = 0\n    for i in range(1, n):\n        # Check divisibility by 11 or 13.\n        if i % 11 == 0 or i % 13 == 0:\n            # Count occurrences of '7' in the number.\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not l:\n        return []\n\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_elements.sort()\n\n    result = list(l)  # Create a new list, preserving odd-indexed elements.\n    even_sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_elements[even_sorted_idx]\n        even_sorted_idx += 1\n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a new list where odd-indexed elements are preserved,\n    and even-indexed elements are sorted in ascending order.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not l:\n        return []\n\n    even_indexed_elements = [l[i] for i in range(len(l)) if i % 2 == 0]\n    even_indexed_elements.sort()\n\n    result_list = [None] * len(l)\n    even_sorted_idx_counter = 0\n    for i in range(len(l)):\n        if i % 2 != 0:  # Odd index\n            result_list[i] = l[i]\n        else:  # Even index\n            result_list[i] = even_indexed_elements[even_sorted_idx_counter]\n            even_sorted_idx_counter += 1\n            \n    return result_list"}
{"task_id": "HumanEval/36", "solution": "class DigitCounter:\n    \"\"\"Utility to count digit occurrences in a number.\"\"\"\n    def count_digit_occurrences(self, number: int, digit: int) -> int:\n        \"\"\"Counts how many times a given digit appears in the number.\"\"\"\n        if not (0 <= digit <= 9):\n            raise ValueError(\"Digit to count must be a single digit (0-9).\")\n        \n        if number < 0:\n            number = abs(number) # Counts in absolute value.\n\n        count = 0\n        num_str = str(number)\n        for char in num_str:\n            if int(char) == digit:\n                count += 1\n        return count\nclass FizzBuzzCalculator:\n    \"\"\"Orchestrates the main logic for FizzBuzz-like calculations.\"\"\"\n    def __init__(self, digit_counter: DigitCounter):\n        \"\"\"Initializes the calculator with a DigitCounter instance.\"\"\"\n        self.digit_counter = digit_counter\n\n    def _is_divisible_by_11_or_13(self, num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (num % 11 == 0) or (num % 13 == 0)\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Performs the FizzBuzz-like calculation, counting '7's.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        total_sevens_count = 0\n        for i in range(1, n):\n            if self._is_divisible_by_11_or_13(i):\n                total_sevens_count += self.digit_counter.count_digit_occurrences(i, 7)\n        return total_sevens_count\ndef fizz_buzz(n: int) -> int:\n    \"\"\"\n    Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    \"\"\"\n    digit_counter = DigitCounter()\n    calculator = FizzBuzzCalculator(digit_counter)\n    return calculator.calculate(n)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Helper to reverse the cyclic shift for a 3-character block.\n    # e.g., \"bca\" -> \"abc\"\n    def _reverse_cyclic_shift_three(block: str) -> str:\n        return block[2] + block[0] + block[1]\n\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            decoded_groups.append(_reverse_cyclic_shift_three(group))\n        else:\n            # Groups with fewer than 3 elements were not cycled by encode_cyclic,\n            # so they remain unchanged.\n            decoded_groups.append(group)\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "import math\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass FibonacciGenerator:\n    @staticmethod\n    def _is_perfect_square(n: int) -> bool:\n        if n < 0:\n            return False\n        s = int(math.isqrt(n))\n        return s * s == n\n\n    @staticmethod\n    def is_fibonacci(num: int) -> bool:\n        \"\"\"Determines if a given number is a Fibonacci number.\"\"\"\n        if not isinstance(num, int) or num < 0:\n            raise InvalidInputError(\"Input 'num' must be a non-negative integer.\")\n        if num == 0 or num == 1:\n            return True\n        return FibonacciGenerator._is_perfect_square(5 * num * num + 4) or \\\n               FibonacciGenerator._is_perfect_square(5 * num * num - 4)\n\n    @staticmethod\n    def generate_fibonacci_sequence(limit: int) -> list[int]:\n        \"\"\"Generates a list of Fibonacci numbers up to a specified limit.\"\"\"\n        if not isinstance(limit, int) or limit < 0:\n            raise InvalidInputError(\"Input 'limit' must be a non-negative integer.\")\n        sequence = []\n        a, b = 0, 1\n        while a <= limit:\n            sequence.append(a)\n            a, b = b, a + b\n        return sequence\nclass PrimeChecker:\n    @staticmethod\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a given number is a prime number.\"\"\"\n        if not isinstance(num, int):\n            raise InvalidInputError(\"Input 'num' must be an integer.\")\n        if num <= 1:\n            raise InvalidInputError(\"Input 'num' must be a positive integer greater than 1.\")\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    count = 0\n    num = 2\n    while True:\n        if FibonacciGenerator.is_fibonacci(num) and PrimeChecker.is_prime(num):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
