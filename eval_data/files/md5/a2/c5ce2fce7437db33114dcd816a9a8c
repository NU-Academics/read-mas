{"task_id": "HumanEval/47", "solution": "from typing import Union\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n    Handles empty and non-numeric lists with appropriate errors.\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Validate that all elements are numeric.\n    if not all(isinstance(x, (int, float)) for x in l):\n        raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements, return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements, return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Raises ValueError for empty list, TypeError for non-numerical elements.\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    try:\n        sorted_l = sorted(l)\n    except TypeError as e:\n        raise TypeError(\"Input list must contain only numerical elements.\") from e\n\n    n = len(sorted_l)\n    if n % 2 == 1:\n        # For odd number of elements, return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For even number of elements, return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/48", "solution": "import re\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if a given string is a palindrome, ignoring case and non-alphanumeric characters.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Normalize the string by converting to lowercase and removing non-alphanumeric characters.\n    normalized_text = re.sub(r'[^a-z0-9]', '', text.lower())\n\n    # Compare the normalized string with its reverse to determine if it's a palindrome.\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/49", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef modp(n: int, p: int) -> int:\n    \"\"\"\n    Calculates (2^n) % p efficiently using Python's optimized pow.\n    Raises InvalidInputError if p is not a positive integer or inputs are not integers.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(p, int):\n        raise InvalidInputError(\"Inputs n and p must be integers.\")\n    if p <= 0:\n        raise InvalidInputError(\"Modulus p must be a positive integer.\")\n    \n    # Python's built-in pow(base, exp, mod) is highly optimized.\n    return pow(2, n, p)"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Calculates 2^n modulo p using efficient modular exponentiation.\n    Ensures n is a non-negative integer and p is a positive integer.\"\"\"\n\n    if not isinstance(n, int):\n        raise ValueError(\"Exponent 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n\n    if not isinstance(p, int):\n        raise ValueError(\"Modulus 'p' must be an integer.\")\n    if p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    return pow(2, n, p)"}
