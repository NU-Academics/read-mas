{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Checks if two strings are composed of the exact same set of unique characters.\n    This comparison is case-sensitive, ignoring character order and frequency.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/55", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to Fibonacci calculation.\"\"\"\n    def __init__(self, message: str = \"Input must be a positive integer (n >= 1).\"):\n        self.message = message\n        super().__init__(self.message)\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    Raises InvalidInputError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise InvalidInputError(f\"Input 'n' must be a positive integer (n >= 1), but received {n!r}.\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    # Use an iterative approach for performance, as required for N up to 90.\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a list with a single element is considered monotonic.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input 'l' must be a list.\")\n\n    n = len(l)\n    if n <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(n - 1):\n        # Validate that elements are numeric before comparison.\n        if not isinstance(l[i], (int, float)) or not isinstance(l[i+1], (int, float)):\n            raise TypeError(\"List elements must be numeric (int or float).\")\n\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n        # If it's neither increasing nor decreasing, it's not monotonic.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"Calculates the sum of all positive integers from 1 up to n using the arithmetic series formula.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    return n * (n + 1) // 2"}
