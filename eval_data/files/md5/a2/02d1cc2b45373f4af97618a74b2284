{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nclass IntegerList:\n    \"\"\"Encapsulates a list of integers, providing access to its elements.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = elements\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Returns the encapsulated list of integers.\"\"\"\n        return self._elements\nclass DuplicateRemover:\n    \"\"\"An application service for processing and removing duplicate integers from a list.\"\"\"\n    def remove_duplicates(self, numbers: List[int]) -> List[int]:\n        \"\"\"Processes the input list, removing duplicates while preserving order.\"\"\"\n        integer_list = IntegerList(numbers)\n        elements_to_process = integer_list.get_elements()\n\n        seen_elements = set()\n        result = []\n        for number in elements_to_process:\n            if number not in seen_elements:\n                result.append(number)\n                seen_elements.add(number)\n        return result\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    remover_service = DuplicateRemover()\n    return remover_service.remove_duplicates(numbers)"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\"\"\"\n    import math\n\n    class Number:\n        def __init__(self, value: int):\n            self.value = value\n\n    class Divisor:\n        def __init__(self, value: int):\n            self.value = value\n\n    class LargestDivisorService:\n        def calculate(self, n_val: int) -> Divisor:\n            \"\"\"Calculates the largest divisor of n_val, smaller than n_val, by iterating up to its square root.\"\"\"\n            largest_found_divisor = 1\n            for i in range(2, int(math.sqrt(n_val)) + 1):\n                if n_val % i == 0:\n                    largest_found_divisor = max(largest_found_divisor, i)\n                    largest_found_divisor = max(largest_found_divisor, n_val // i)\n            return Divisor(largest_found_divisor)\n\n    service = LargestDivisorService()\n    result_divisor_obj = service.calculate(n)\n    return result_divisor_obj.value"}
{"task_id": "HumanEval/28", "solution": "def concatenate(strings: List[str]) -> str:\n    \"\"\" Concatenate list of strings into a single string\n    >>> concatenate([])\n    ''\n    >>> concatenate(['a', 'b', 'c'])\n    'abc'\n    \"\"\"\n    return ''.join(strings)"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return ''.join(flipped_chars)"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix. \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [x for x in l if x > 0]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
