{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    result = \"\"\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result = str(remainder) + result\n        current_x = current_x // base\n    return result"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 sequence iteratively.\"\"\"\n    if n == 0 or n == 1 or n == 3:\n        return 0\n    if n == 2:\n        return 2\n\n    # Initialize the sequence with the first four values: fib4(0) to fib4(3)\n    values = [0, 0, 2, 0]\n    for i in range(4, n + 1):\n        next_val = sum(values[-4:])\n        values.append(next_val)\n    return values[n]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    mid = n // 2\n    if n % 2 == 1:\n        return sorted_l[mid]\n    else:\n        return (sorted_l[mid - 1] + sorted_l[mid]) / 2"}
