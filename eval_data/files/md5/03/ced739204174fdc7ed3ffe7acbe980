{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth decagonal number based on the formula n * (4 * n - 3).\n    Validates input 'n' to ensure it is an integer greater than or equal to 1.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid inputs, providing a message and an error code.\"\"\"\n        def __init__(self, message: str, code: int = 1) -> None:\n            super().__init__(message)\n            self.message = message\n            self.code = code\n\n    class InputValidator:\n        \"\"\"Handles validation of the input 'n' against specified criteria.\"\"\"\n        def validate(self, n_val: int) -> None:\n            if not isinstance(n_val, int):\n                raise InvalidInputError(\"n must be an integer.\", 1)\n            if n_val < 1:\n                raise InvalidInputError(\"n must be an integer >= 1.\", 1)\n\n    class DecagonalCalculator:\n        \"\"\"Computes the decagonal number for a given valid integer 'n'.\"\"\"\n        def compute(self, n_val: int) -> int:\n            return n_val * (4 * n_val - 3)\n\n    # Validate the input 'n'\n    validator = InputValidator()\n    validator.validate(n)\n\n    # Compute the decagonal number\n    calculator = DecagonalCalculator()\n    result = calculator.compute(n)\n\n    return result"}
{"task_id": "Mbpp/280", "solution": "from typing import List, Any, Tuple\nclass Array:\n    \"\"\"Wraps an array-like object, providing indexed access and length.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self._items = list(items)\n\n    def get(self, index: int) -> Any:\n        return self._items[index]\n\n    def length(self) -> int:\n        return len(self._items)\nclass Element:\n    \"\"\"Wraps an element's value, providing an equality comparison method.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self._value = value\n\n    def equals(self, other: 'Element') -> bool:\n        return self._value == other._value\nclass SearchResult:\n    \"\"\"Encapsulates the outcome of a search operation.\"\"\"\n    def __init__(self, found: bool, index: int) -> None:\n        self._found = found\n        self._index = index\n\n    def to_tuple(self) -> tuple:\n        return (self._found, self._index)\nclass SequentialSearch:\n    \"\"\"Performs a sequential search operation on an array.\"\"\"\n    def sequential_search(self, array, element) -> SearchResult:\n        \"\"\"Coordinates the search, including input validation and linear scanning.\"\"\"\n        if not self.validate_input(array):\n            return SearchResult(False, -1)\n\n        wrapped_array = Array(array)\n        wrapped_element = Element(element)\n        return self.linear_scan(wrapped_array, wrapped_element)\n\n    def validate_input(self, array) -> bool:\n        \"\"\"Validates if the provided array is array-like and iterable.\"\"\"\n        return isinstance(array, (list, tuple))\n\n    def linear_scan(self, array: Array, element: Element) -> SearchResult:\n        \"\"\"Performs a linear scan to find the element in the array.\"\"\"\n        for i in range(array.length()):\n            if element.equals(Element(array.get(i))):\n                return SearchResult(True, i)\n        return SearchResult(False, -1)\ndef sequential_search(array, element) -> Tuple[bool, int]:\n    \"\"\"\n    Searches for an element in an array using a sequential scan.\n    Returns a tuple (found: bool, index: int) where index is -1 if not found.\n    \"\"\"\n    searcher = SequentialSearch()\n    result = searcher.sequential_search(array, element)\n    return result.to_tuple()"}
