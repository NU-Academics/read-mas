{"task_id": "Mbpp/743", "solution": "def _normalize_n(n: int, length: int) -> int:\n    \"\"\"Normalizes the rotation count n against the list length.\n    Handles empty lists and ensures n is within [0, length-1].\"\"\"\n    if length == 0:\n        return 0\n    return n % length\ndef rotate_right(lst: list, n: int) -> list:\n    \"\"\"\n    Rotates a given list by specified number of items to the right direction.\n    Returns a new list without modifying the original.\n    \"\"\"\n    list_length = len(lst)\n    normalized_n = _normalize_n(n, list_length)\n\n    # Perform the rotation using slicing.\n    # The last `normalized_n` elements move to the front,\n    # and the remaining elements follow.\n    return lst[list_length - normalized_n:] + lst[:list_length - normalized_n]"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters,\n    except at the beginning of the string or if already preceded by whitespace.\n    \"\"\"\n    def _is_ascii_upper(ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII uppercase letter.\"\"\"\n        return len(ch) == 1 and 'A' <= ch <= 'Z'\n\n    def _is_whitespace(ch: str) -> bool:\n        \"\"\"Checks if a character is whitespace.\"\"\"\n        return ch.isspace()\n\n    output = []\n    for i, ch in enumerate(input_string):\n        if i > 0 and _is_ascii_upper(ch) and not _is_whitespace(input_string[i-1]):\n            output.append(' ')\n        output.append(ch)\n    return ''.join(output)"}
{"task_id": "Mbpp/745", "solution": "from typing import List, Iterator\nclass Digit:\n    \"\"\"Represents a single decimal digit (0-9).\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Number:\n    \"\"\"Wraps an integer and provides its digit decomposition.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> List[Digit]:\n        \"\"\"Returns a list of Digit objects representing the number's decimal digits.\"\"\"\n        digit_list = []\n        temp_value = abs(self.value)\n        if temp_value == 0:\n            return [Digit(0)]\n        \n        s_value = str(temp_value)\n        for char_digit in s_value:\n            digit_list.append(Digit(int(char_digit)))\n        return digit_list\nclass Range:\n    \"\"\"Represents an inclusive integer interval and allows iteration.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Iterates from start to end inclusive.\"\"\"\n        current = self.start\n        while current <= self.end:\n            yield current\n            current += 1\nclass Validator:\n    \"\"\"Provides utility methods for validating inputs and number properties.\"\"\"\n    def is_integer(self, value: object) -> bool:\n        \"\"\"Checks if the given value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def is_valid_range(self, rng: Range) -> bool:\n        \"\"\"Checks if the range's start is less than or equal to its end.\"\"\"\n        return rng.start <= rng.end\n\n    def contains_zero(self, number: Number) -> bool:\n        \"\"\"Determines if any digit in the number is zero.\"\"\"\n        for digit_obj in number.digits():\n            if digit_obj.value == 0:\n                return True\n        return False\nclass DivisibilityChecker:\n    \"\"\"Checks if all digits of a number divide the number evenly.\"\"\"\n    def all_digits_divide(self, number: Number) -> bool:\n        \"\"\"Returns True if every non-zero digit of the number divides the number.\"\"\"\n        for digit_obj in number.digits():\n            if digit_obj.value == 0: \n                return False # Should be filtered by contains_zero, but acts as safeguard.\n            if number.value % digit_obj.value != 0:\n                return False\n        return True\nclass ResultList:\n    \"\"\"Collects numbers and provides them as a sorted list.\"\"\"\n    def __init__(self):\n        self.results: List[int] = []\n\n    def add(self, number: Number) -> None:\n        \"\"\"Adds a number's value to the collection.\"\"\"\n        self.results.append(number.value)\n\n    def sorted(self) -> List[int]:\n        \"\"\"Returns the collected numbers in ascending order.\"\"\"\n        return sorted(self.results)\ndef divisible_by_digits(startnum, endnum) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded from the results.\n    \"\"\"\n    validator = Validator()\n\n    if not validator.is_integer(startnum) or not validator.is_integer(endnum):\n        return []\n\n    rng = Range(startnum, endnum)\n\n    if not validator.is_valid_range(rng):\n        return []\n\n    result_list = ResultList()\n    checker = DivisibilityChecker()\n\n    for n in rng:\n        current_number_obj = Number(n)\n\n        if validator.contains_zero(current_number_obj):\n            continue\n        \n        if checker.all_digits_divide(current_number_obj):\n            result_list.add(current_number_obj)\n\n    return result_list.sorted()"}
{"task_id": "Mbpp/752", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception raised for invalid input to Jacobsthal number calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass JacobsthalFunction:\n    \"\"\"Encapsulates validation and computation of Jacobsthal numbers.\"\"\"\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"\n        Calculates the nth Jacobsthal number.\n\n        Raises ValidationError if n is not a non-negative integer.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValidationError(\"n must be a non-negative integer\")\n\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        prev2 = 0  # J(0)\n        prev1 = 1  # J(1)\n\n        for _ in range(2, n + 1):\n            curr = prev1 + 2 * prev2\n            prev2 = prev1\n            prev1 = curr\n        return prev1\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number.\n\n    Delegates to an internal implementation for calculation and validation.\n    \"\"\"\n    return JacobsthalFunction().jacobsthal_num(n)"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(input_strings: list[str]) -> list[int]:\n    \"\"\"Sorts a list of numeric strings numerically in ascending order.\"\"\"\n\n    # Inline definition of domain model classes as per design context\n    class NumericString:\n        def __init__(self, raw_value: str):\n            self.raw_value = raw_value\n        def toInteger(self) -> int:\n            return int(self.raw_value)\n\n    class IntegerValue:\n        def __init__(self, value: int):\n            self.value = value\n\n    # InputList and ResultList are not strictly required for the return type but are part of the domain model.\n    class InputList:\n        def __init__(self, items: list[NumericString]):\n            self.items = items\n\n    class ResultList:\n        def __init__(self, items: list[IntegerValue]):\n            self.items = items\n\n    # Inline definition of Parser class as per design context\n    class Parser:\n        def parse(self, s: str) -> int:\n            # Parses the string to an integer, handling negatives as per FR4.\n            return int(s)\n\n    # Inline definition of Sorter class as per design context\n    class Sorter:\n        def sort(self, values: list[int]) -> list[int]:\n            # Sorts the list of integers in ascending order as per FR3.\n            return sorted(values)\n\n    # Orchestration logic for sort_numeric_strings as per design steps:\n    # 1. Use Parser to convert each string to its integer value (FR2, FR4).\n    parser = Parser()\n    parsed_integers: list[int] = []\n    for s in input_strings:\n        parsed_integers.append(parser.parse(s))\n\n    # 2. Use Sorter to sort the list of integers (FR3).\n    sorter = Sorter()\n    sorted_integers = sorter.sort(parsed_integers)\n\n    # 3. Return the sorted list of integers (as per FR1's return type).\n    return sorted_integers"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(inputList, inputTuple) -> list:\n    \"\"\"Public API. Validates inputs and returns concatenated list.\"\"\"\n\n    def validate_inputs(inputList, inputTuple) -> None:\n        \"\"\"Raises TypeError if types are invalid.\"\"\"\n        if not isinstance(inputList, list) or not isinstance(inputTuple, tuple):\n            raise TypeError(f\"add_tuple expects (list, tuple): got ({type(inputList).__name__} , {type(inputTuple).__name__})\")\n\n    def concatenate(inputList, inputTuple) -> list:\n        \"\"\"Returns a new list containing elements of inputList then inputTuple.\"\"\"\n        return list(inputList) + list(inputTuple)\n\n    validate_inputs(inputList, inputTuple)\n    return concatenate(inputList, inputTuple)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap, where each parent is less than or equal to its children.\n    Arrays with zero or one element are considered valid min-heaps.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate through all potential parent nodes.\n    # For a 0-indexed array, parent nodes are located at indices from 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the current parent node violates the min-heap property with its left child.\n        if left_child_idx < n:\n            if array[i] > array[left_child_idx]:\n                return False\n\n        # Check if the current parent node violates the min-heap property with its right child.\n        if right_child_idx < n:\n            if array[i] > array[right_child_idx]:\n                return False\n\n    # If no violations were found after checking all parent nodes, the array is a min-heap.\n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements common to all three lists at the same index.\n    Returns a new list containing these elements in ascending index order.\n    \"\"\"\n    result = []\n    min_length = min(len(l1), len(l2), len(l3))\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples, based on the second element.\n    It performs validation and handles various boundary conditions for k.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    if not isinstance(records, list):\n        raise TypeError(\"Input 'records' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    for i, record in enumerate(records):\n        if not isinstance(record, (tuple, list)):\n            raise TypeError(f\"Record at index {i} is not tuple-like (tuple or list).\")\n        if len(record) < 2:\n            raise ValueError(f\"Record at index {i} has fewer than two elements.\")\n        if not isinstance(record[1], (int, float)):\n            raise TypeError(f\"Second element of record at index {i} is not numeric.\")\n\n    sorted_records = sorted(records, key=lambda x: x[1])\n\n    if k >= len(sorted_records):\n        return sorted_records\n    \n    return sorted_records[:k]"}
{"task_id": "Mbpp/755", "solution": "import collections\nfrom dataclasses import dataclass\nfrom typing import List, Union\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\nNumber = Union[int, float]\ndef second_smallest(values: List[Number]) -> Number:\n    \"\"\"\n    Finds the second smallest number in a list after validating the input.\n    Handles duplicates and negative numbers correctly.\n    \"\"\"\n    if not isinstance(values, list):\n        raise ValidationError(\"input must be a list of numeric values\")\n\n    for item in values:\n        if not isinstance(item, (int, float)):\n            raise ValidationError(\"all items in values must be numeric (int or float)\")\n\n    if len(values) < 2:\n        raise ValueError(\"input list must contain at least two numeric values\")\n\n    sorted_values = sorted(values)\n    return sorted_values[1]"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, List, Tuple, Dict\ndef _sublist_to_tuple(sublist: list[object]) -> tuple[object, ...]:\n    \"\"\"Returns tuple(sublist) without modifying sublist.\"\"\"\n    return tuple(sublist)\ndef unique_sublists(input_list: list[list[object]]) -> dict[tuple, int]:\n    \"\"\"Counts identical sublists converting each to a tuple key. Matches SRS signature unique_sublists(input_list).\"\"\"\n    counts: dict[tuple, int] = {}\n    for sublist in input_list:\n        tuple_key = _sublist_to_tuple(sublist)\n        counts[tuple_key] = counts.get(tuple_key, 0) + 1\n    return counts"}
