{"task_id": "Mbpp/622", "solution": "from typing import List\nclass ValidationError(Exception):\n    \"\"\"Represents validation failures; carries message.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass SortedList:\n    \"\"\"Immutable read-only wrapper around a sequence of numeric items.\"\"\"\n    def __init__(self, items: List[float]):\n        self._items = list(items)\n        self._length = len(items)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return self._length\n\n    def get(self, index: int) -> float:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return float(self._items[index])\nclass InputValidator:\n    \"\"\"Validates input lists for length and sortedness.\"\"\"\n    def validateLengths(self, a: SortedList, b: SortedList, n: int) -> None:\n        \"\"\"Raises ValidationError if list lengths do not match n.\"\"\"\n        if a.length() != n:\n            raise ValidationError(f\"List 'a' has length {a.length()}, but expected {n}.\")\n        if b.length() != n:\n            raise ValidationError(f\"List 'b' has length {b.length()}, but expected {n}.\")\nclass MedianCalculator:\n    \"\"\"Calculates the median of two sorted lists.\"\"\"\n    def get_median(self, a: SortedList, b: SortedList, n: int) -> float:\n        \"\"\"Computes the median using the merge-and-pick method.\"\"\"\n        return self._mergeAndPickMedian(a, b, n)\n\n    def _mergeAndPickMedian(self, a: SortedList, b: SortedList, n: int) -> float:\n        \"\"\"Finds the nth and (n+1)th smallest elements by merging and returns their average.\"\"\"\n        i = 0\n        j = 0\n        count = 0\n        element_n = 0.0\n        element_n_plus_1 = 0.0\n\n        while count <= n:\n            current_element = 0.0\n            if i == n:\n                current_element = b.get(j)\n                j += 1\n            elif j == n:\n                current_element = a.get(i)\n                i += 1\n            elif a.get(i) <= b.get(j):\n                current_element = a.get(i)\n                i += 1\n            else:\n                current_element = b.get(j)\n                j += 1\n\n            if count == n - 1:\n                element_n = current_element\n            if count == n:\n                element_n_plus_1 = current_element\n            \n            count += 1\n        \n        return (element_n + element_n_plus_1) / 2.0\ndef get_median(a: List[float], b: List[float], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    It wraps input lists in SortedList, validates, and delegates to MedianCalculator.\n    \"\"\"\n    sorted_a = SortedList(a)\n    sorted_b = SortedList(b)\n\n    validator = InputValidator()\n    validator.validateLengths(sorted_a, sorted_b, n)\n\n    calculator = MedianCalculator()\n    return calculator.get_median(sorted_a, sorted_b, n)"}
{"task_id": "Mbpp/626", "solution": "class InputValidator:\n    def is_numeric(self, value):\n        \"\"\"Checks if the given value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def is_non_negative(self, value):\n        \"\"\"Checks if the given value is non-negative.\"\"\"\n        return value >= 0\nclass Triangle:\n    def compute_area_from_radius(self, radius):\n        \"\"\"Computes the area of the largest inscribed triangle (radius * radius).\"\"\"\n        return radius * radius\nclass TriangleAreaCalculator:\n    def triangle_area(self, radius):\n        \"\"\"Orchestrates validation and area computation.\"\"\"\n        validator = InputValidator()\n        if not validator.is_non_negative(radius):\n            return None\n        else:\n            triangle = Triangle()\n            return triangle.compute_area_from_radius(radius)\ndef triangle_area(radius):\n    \"\"\"Public API: returns area (radius * radius) for radius >= 0, None for negative radius.\"\"\"\n    calculator = TriangleAreaCalculator()\n    return calculator.triangle_area(radius)"}
