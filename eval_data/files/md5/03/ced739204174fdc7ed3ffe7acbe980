{"task_id": "Mbpp/123", "solution": "import math\nfrom dataclasses import dataclass, field\nfrom typing import List, Set\nclass AmicableCalculator:\n    \"\"\"\n    Handles the core logic for finding amicable numbers, including sum of proper divisors\n    and identifying amicable pairs up to a specified limit.\n    \"\"\"\n    def sum_of_proper_divisors(self, n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number n.\"\"\"\n        if n <= 1:\n            return 0\n        s = 1\n        # Iterate up to the square root of n to find divisors efficiently.\n        for i in range(2, int(math.isqrt(n)) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\n    def find_amicable_pairs(self, limit: int) -> List[AmicablePair]:\n        \"\"\"\n        Identifies all amicable pairs (a, b) such that a < b and both a, b are within the limit.\n        Uses a memoization technique (proper_divisor_sums) to avoid redundant calculations.\n        \"\"\"\n        proper_divisor_sums = {}\n        pairs = []\n\n        # Iterate through numbers from 2 up to the limit to find potential 'a' values.\n        for a in range(2, limit + 1):\n            sum_a = proper_divisor_sums.get(a)\n            if sum_a is None:\n                sum_a = self.sum_of_proper_divisors(a)\n                proper_divisor_sums[a] = sum_a\n\n            b_candidate = sum_a\n            \n            # Check conditions for an amicable pair: a < b, b within limit, and mutual sum.\n            if b_candidate > a and b_candidate <= limit:\n                sum_b = proper_divisor_sums.get(b_candidate)\n                if sum_b is None:\n                    sum_b = self.sum_of_proper_divisors(b_candidate)\n                    proper_divisor_sums[b_candidate] = sum_b\n                \n                if sum_b == a:\n                    pairs.append(AmicablePair(a=a, b=b_candidate))\n        return pairs\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        \"\"\"\n        Aggregates the sum of all amicable numbers found within the specified limit.\n        It finds pairs and uses the Result class to ensure each number is counted once.\n        \"\"\"\n        result = Result()\n        pairs = self.find_amicable_pairs(limit)\n\n        # Add both members of each valid amicable pair to the result.\n        for pair in pairs:\n            result.add_member(pair.a)\n            result.add_member(pair.b)\n            \n        return result.total_sum\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 to a specified limit (inclusive).\n    Validates the input and delegates the computation to AmicableCalculator.\n    \"\"\"\n    if not isinstance(limit, int) or limit < 1:\n        raise ValueError(\"Limit must be a positive integer (limit >= 1).\")\n\n    calculator = AmicableCalculator()\n    return calculator.amicable_numbers_sum(limit)"}
{"task_id": "Mbpp/126", "solution": "def sum(a: int, b: int) -> int:\n    \"\"\"\n    Computes the sum of common positive divisors of two integers.\n    Raises ValueError if inputs are not integers.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"sum expects two integers\")\n\n    total_sum = 0\n    \n    # Determine the upper bound for divisor iteration.\n    # This follows the guidance to iterate up to the smaller non-zero absolute value.\n    abs_a = abs(a)\n    abs_b = abs(b)\n    \n    upper_bound = 0\n    if abs_a == 0 and abs_b == 0:\n        # If both are zero, there are no common positive divisors with a finite sum.\n        # The design implies positive divisors, and 0 is not a positive divisor.\n        upper_bound = 0\n    elif abs_a == 0:\n        # Common positive divisors of 0 and b are the positive divisors of b.\n        upper_bound = abs_b\n    elif abs_b == 0:\n        # Common positive divisors of a and 0 are the positive divisors of a.\n        upper_bound = abs_a\n    else:\n        # For two non-zero numbers, common divisors cannot exceed the smaller absolute value.\n        upper_bound = min(abs_a, abs_b)\n\n    # Iterate from 1 up to the determined upper_bound (inclusive) to find common positive divisors.\n    for d in range(1, upper_bound + 1):\n        if a % d == 0 and b % d == 0:\n            total_sum += d\n            \n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "class Validator:\n    def validate(self, s: str) -> None:\n        \"\"\"Raise ValueError if s contains characters other than '0' or '1', or if s is empty.\"\"\"\n        if not s:\n            raise ValueError(\"invalid input: string must contain at least one '0' or '1'\")\n        for char in s:\n            if char not in ('0', '1'):\n                raise ValueError(\"invalid input: only '0' and '1' allowed\")\ndef find_length(s: str) -> int:\n    \"\"\"Computes the maximum difference between zeros and ones in any non-empty substring using Kadane's algorithm.\"\"\"\n    validator = Validator()\n    validator.validate(s)\n\n    first_mapped_value = 1 if s[0] == '0' else -1\n    running_sum = first_mapped_value\n    max_sum = running_sum\n\n    for i in range(1, len(s)):\n        char = s[i]\n        mapped_value = 1 if char == '0' else -1\n        \n        running_sum = max(mapped_value, running_sum + mapped_value)\n        max_sum = max(max_sum, running_sum)\n    \n    return max_sum"}
{"task_id": "Mbpp/128", "solution": "from typing import List, Any\ndef _parse_string_to_words(s: str) -> List[str]:\n    \"\"\"Splits a string by whitespace into a list of words.\"\"\"\n    return s.split()\ndef _validate_list_elements(lst: list) -> List[str]:\n    \"\"\"Validates all list elements are strings, raising TypeError if not.\"\"\"\n    for element in lst:\n        if not isinstance(element, str):\n            raise TypeError(\"List elements must be strings.\")\n    return lst\ndef long_words(n: int, words) -> List[str]:\n    \"\"\"\n    Finds words longer than n characters from a string or list of words.\n    Processes string inputs by splitting on whitespace; validates list elements.\n    \"\"\"\n    if isinstance(words, str):\n        tokens = _parse_string_to_words(words)\n    elif isinstance(words, list):\n        tokens = _validate_list_elements(words)\n    else:\n        raise TypeError(\"Input 'words' must be a string or a list of strings.\")\n\n    result = []\n    for word in tokens:\n        if len(word) > n:\n            result.append(word)\n            \n    return result"}
