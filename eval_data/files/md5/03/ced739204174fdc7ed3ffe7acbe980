{"task_id": "Mbpp/473", "solution": "from collections import Counter, defaultdict\nfrom typing import List, Tuple, Set, Any\ndef _normalize_tuple(t: Tuple[Any, ...]) -> Counter:\n    \"\"\"Returns a Counter for the tuple's elements, capturing multiplicities.\"\"\"\n    return Counter(t)\ndef _multiset_key(counter: Counter) -> frozenset[Tuple[Any, int]]:\n    \"\"\"Converts a Counter to a hashable frozenset for multiset comparison.\"\"\"\n    return frozenset(counter.items())\ndef tuple_intersection(list1: List[Tuple[Any, ...]], list2: List[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the tuple intersection of elements in two tuple lists, treating tuples as multisets.\n    Returned tuples preserve their original element order from list1.\n    \"\"\"\n    if not list1 or not list2:\n        return set()\n\n    # Store multiset keys for list2, grouped by their original tuple length for efficiency.\n    list2_keys_by_length: defaultdict[int, Set[frozenset[Tuple[Any, int]]]] = defaultdict(set)\n    for t2 in list2:\n        counter2 = _normalize_tuple(t2)\n        key2 = _multiset_key(counter2)\n        list2_keys_by_length[len(t2)].add(key2)\n\n    result_set: Set[Tuple[Any, ...]] = set()\n    # Keep track of conceptual multiset keys already added to ensure deduplication.\n    processed_keys: Set[frozenset[Tuple[Any, int]]] = set()\n\n    for t1 in list1:\n        t1_length = len(t1)\n        # Skip if no tuples of this length exist in list2.\n        if t1_length not in list2_keys_by_length:\n            continue\n\n        keys_for_current_length = list2_keys_by_length[t1_length]\n        \n        # Normalize the tuple from list1 to its multiset key.\n        t1_counter = _normalize_tuple(t1)\n        t1_key = _multiset_key(t1_counter)\n\n        # If the multiset key exists in list2 and hasn't been added to results yet, add the original t1.\n        if t1_key in keys_for_current_length and t1_key not in processed_keys:\n            result_set.add(t1)\n            processed_keys.add(t1_key)\n\n    return result_set"}
