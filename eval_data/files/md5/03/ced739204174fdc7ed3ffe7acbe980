{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input: str) -> str:\n    \"\"\"Remove ASCII lowercase letters 'a'..'z' from input and return result as string.\n    Raises TypeError if input is not an instance of str.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"remove_lowercase requires a string input\")\n\n    result_chars = []\n    for c in input:\n        if not ('a' <= c <= 'z'):\n            result_chars.append(c)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(integer_value: int) -> int:\n    \"\"\"Return the most significant (left-most) digit of integer_value as an int.\n\n    Treats negative numbers by absolute value and returns 0 for input 0.\n    \"\"\"\n    abs_value = abs(integer_value)\n    if abs_value == 0:\n        return 0\n    while abs_value >= 10:\n        abs_value //= 10\n    return abs_value"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list: list[int]) -> list[int]:\n    \"\"\"Return a list containing only the odd integers from input_list preserving order.\n\n    Args:\n        input_list: list[int] -- input list of integers.\n\n    Returns:\n        list[int] -- sublist of input_list with only odd integers (x % 2 != 0), preserving original order.\n    \"\"\"\n    return [x for x in input_list if x % 2 != 0]"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    from typing import Iterator\n\n    class Result:\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n    class NaturalNumberSequence:\n        def __init__(self, n_seq: int) -> None:\n            self.n = n_seq\n\n        def validate(self) -> bool:\n            # Assumes n is a positive integer (n >= 1) as per design context.\n            return self.n >= 1\n\n        def iterator(self) -> Iterator[int]:\n            for i in range(1, self.n + 1):\n                yield i\n\n    class CalculationService:\n        def sum_of_n(self, n_calc: int) -> int:\n            # Uses the formula for the sum of the first n natural numbers.\n            return n_calc * (n_calc + 1) // 2\n\n        def sum_of_cubes(self, n_calc: int) -> int:\n            # Uses the formula for the sum of cubes of the first n natural numbers.\n            sum_of_first_n = self.sum_of_n(n_calc)\n            return sum_of_first_n * sum_of_first_n\n\n        def difference(self, n_calc: int) -> int:\n            # Computes the difference based on sum of cubes and sum of n.\n            sum_cubes = self.sum_of_cubes(n_calc)\n            sum_n = self.sum_of_n(n_calc)\n            return sum_cubes - sum_n\n\n    # Instantiate NaturalNumberSequence for conceptual input validation.\n    # As per design, input `n` is assumed to be valid (n >= 1).\n    _ = NaturalNumberSequence(n).validate()\n\n    # Instantiate CalculationService to perform the core arithmetic.\n    calculator = CalculationService()\n\n    # Delegate the difference calculation and return the integer result.\n    final_result = calculator.difference(n)\n\n    return final_result"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Return a new string with case of every alphabetic character toggled.\n\n    Raises:\n        TypeError: if input is not of type 'str'.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"toggle_string expects a string input\")\n    return input.swapcase()"}
{"task_id": "Mbpp/556", "solution": "class ParityCounter:\n    def __init__(self):\n        self.evenCount: int = 0\n        self.oddCount: int = 0\n\n    def countParity(self, arr, n) -> None:\n        \"\"\"Count even/odd among first n elements of arr; does not modify arr.\"\"\"\n        for i in range(n):\n            if arr[i] % 2 == 0:\n                self.evenCount += 1\n            else:\n                self.oddCount += 1\n\n    def computeOddPairs(self) -> int:\n        \"\"\"Return evenCount * oddCount.\"\"\"\n        return self.evenCount * self.oddCount\ndef find_Odd_Pair(arr, n) -> int:\n    \"\"\"\n    Count the number of pairs whose xor value is odd.\n    The xor of two numbers is odd if and only if one number is even and the other is odd.\n    \"\"\"\n    effective_n = min(n, len(arr))\n    if effective_n <= 1:\n        return 0\n\n    pc = ParityCounter()\n    pc.countParity(arr, effective_n)\n    return pc.computeOddPairs()"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b):\n    \"\"\"\n    Calculates the sum of per-digit differences between two integers.\n    The function handles input validation, absolute values, and streaming digit processing.\n    \"\"\"\n\n    def _validate_inputs(val1, val2):\n        \"\"\"Raises TypeError if inputs are not integers.\"\"\"\n        if not isinstance(val1, int) or not isinstance(val2, int):\n            raise TypeError(\"Both inputs must be integers.\")\n\n    def _abs_and_decompose(n_val):\n        \"\"\"Yields decimal digits of abs(n_val) LSB-first; yields 0 at least once for n_val == 0.\"\"\"\n        n_val = abs(n_val)\n        if n_val == 0:\n            yield 0\n            return\n        while n_val > 0:\n            yield n_val % 10\n            n_val //= 10\n\n    def _pair_and_diff(digits_a_iter, digits_b_iter):\n        \"\"\"Consumes two digit iterators, yields abs(d1 - d2) per position, treating exhausted streams as zeros.\"\"\"\n        while True:\n            d1_exhausted = False\n            d2_exhausted = False\n\n            try:\n                d1 = next(digits_a_iter)\n            except StopIteration:\n                d1 = 0\n                d1_exhausted = True\n\n            try:\n                d2 = next(digits_b_iter)\n            except StopIteration:\n                d2 = 0\n                d2_exhausted = True\n\n            if d1_exhausted and d2_exhausted:\n                break\n            \n            yield abs(d1 - d2)\n\n    _validate_inputs(a, b)\n\n    digits_a_generator = _abs_and_decompose(a)\n    digits_b_generator = _abs_and_decompose(b)\n\n    total_distance = 0\n    for diff in _pair_and_diff(digits_a_generator, digits_b_generator):\n        total_distance += diff\n\n    return total_distance"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Compute the sorted union of elements from two input tuples and return as a tuple.\"\"\"\n    unique_elements = set(a) | set(b)\n    sorted_elements = sorted(unique_elements)\n    return tuple(sorted_elements)"}
