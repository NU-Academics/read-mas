{"task_id": "Mbpp/589", "solution": "from dataclasses import dataclass\nfrom typing import List\nimport math\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"Finds perfect squares within an inclusive integer range [start, end].\"\"\"\n    input_range = IntegerRange(start=start, end=end)\n    result_list_container = ResultList(items=[])\n\n    if input_range.end < 0:\n        return result_list_container.items\n\n    # Adjust start for sqrt calculation to handle negative start values correctly.\n    effective_start_for_sqrt = max(0, input_range.start)\n\n    # Calculate integer root bounds using math.ceil and math.floor.\n    k0 = math.ceil(math.sqrt(effective_start_for_sqrt))\n    k1 = math.floor(math.sqrt(input_range.end))\n\n    if k0 > k1:\n        return result_list_container.items\n\n    for k_val in range(int(k0), int(k1) + 1):\n        square = k_val * k_val\n        # Create PerfectSquare object for traceability, as per design.\n        _ = PerfectSquare(value=square, root=k_val)\n        result_list_container.items.append(square)\n\n    return result_list_container.items"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"Interchanges the first and last elements in a list, returning a new list.\"\"\"\n    list_len = len(input_list)\n\n    if list_len < 2:\n        return input_list\n    else:\n        # Create a new list with the first and last elements swapped.\n        # The middle elements remain in their original order.\n        return [input_list[-1]] + input_list[1:-1] + [input_list[0]]"}
{"task_id": "Mbpp/590", "solution": "from math import sqrt, atan2\nfrom typing import Tuple\ndef polar_rect(a, b) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"Validate inputs, compute r = sqrt(a*a + b*b), theta = atan2(b, a), construct z = complex(a, b), and return ((r, theta), z).\"\"\"\n    _validate_numeric(a)\n    _validate_numeric(b)\n\n    x, y = float(a), float(b)\n\n    r = sqrt(x*x + y*y)\n    theta = atan2(y, x)\n\n    z = complex(x, y)\n\n    return ((r, theta), z)"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n):\n    \"\"\"\n    Computes the sum of products of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    Validates input and ensures exact integer arithmetic.\n    \"\"\"\n    import math\n\n    class InputParameter:\n        def __init__(self, value):\n            self.value = value\n        def is_integer(self) -> bool:\n            return isinstance(self.value, int)\n        def is_non_negative(self) -> bool:\n            return self.value >= 0\n\n    class ExceptionHandler:\n        @staticmethod\n        def raise_type_error(msg: str) -> None:\n            raise TypeError(msg)\n        @staticmethod\n        def raise_value_error(msg: str) -> None:\n            raise ValueError(msg)\n\n    class BinomialCoefficient:\n        @staticmethod\n        def compute(n_val: int, k_val: int) -> int:\n            return math.comb(n_val, k_val)\n\n    class SumOfProductFunction:\n        def compute(self, n_val: int) -> int:\n            param = InputParameter(n_val)\n            if not param.is_integer():\n                ExceptionHandler.raise_type_error(\"n must be an integer\")\n            if not param.is_non_negative():\n                ExceptionHandler.raise_value_error(\"n must be non-negative\")\n\n            total_sum = 0\n            for k in range(n_val):\n                c_k = BinomialCoefficient.compute(n_val, k)\n                c_k_plus_1 = BinomialCoefficient.compute(n_val, k + 1)\n                total_sum += c_k * c_k_plus_1\n            return total_sum\n\n    return SumOfProductFunction().compute(n)"}
{"task_id": "Mbpp/593", "solution": "class Validator:\n    \"\"\"Provides validation utilities for IP address strings.\"\"\"\n    def validateOctetCount(self, ip: str) -> bool:\n        \"\"\"Checks if the IP string contains exactly four octets.\"\"\"\n        return len(ip.split('.')) == 4\n\n    def isDottedQuad(self, ip: str) -> bool:\n        \"\"\"Validates if the IP string is a dotted-quad with digit-only octets.\"\"\"\n        parts = ip.split('.')\n        if len(parts) != 4:\n            return False\n        for part in parts:\n            if not part.isdigit():\n                return False\n        return True\nclass Octet:\n    \"\"\"Represents a single octet of an IPv4 address and handles its normalization.\"\"\"\n    def __init__(self, raw: str, position: int):\n        \"\"\"Initializes an Octet with its raw string value and position.\"\"\"\n        self.raw: str = raw\n        self.position: int = position\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"Removes leading zeros from the octet string, preserving '0' for all-zero octets.\"\"\"\n        trimmed = self.raw.lstrip('0')\n        if not trimmed:\n            return '0'\n        return trimmed\nclass IPAddress:\n    \"\"\"Domain representation for an IPv4 textual address, orchestrating validation and normalization.\"\"\"\n    def __init__(self, raw: str):\n        \"\"\"Initializes an IPAddress object with the raw IP string.\"\"\"\n        self.raw: str = raw\n        self.normalized: str = ''\n\n    def validate(self) -> bool:\n        \"\"\"Delegates validation to Validator to check dotted-quad format.\"\"\"\n        validator = Validator()\n        return validator.isDottedQuad(self.raw)\n\n    def normalize(self) -> str:\n        \"\"\"Normalizes the IP address by removing leading zeros from each octet.\"\"\"\n        parts = self.raw.split('.')\n        normalized_parts = []\n        for i, part in enumerate(parts):\n            octet = Octet(part, i + 1)\n            normalized_parts.append(octet.removeLeadingZeros())\n        self.normalized = '.'.join(normalized_parts)\n        return self.normalized\ndef removezero_ip(ip: str) -> str:\n    \"\"\"Validate and normalize dotted-quad IPv4 string.\n    Raises:\n      ValueError: if input is not a valid dotted-quad of digit-only octets.\n    Returns:\n      Normalized dotted-decimal string with leading zeros removed per octet.\n    \"\"\"\n    ip_address = IPAddress(ip)\n    if not ip_address.validate():\n        raise ValueError(\"Invalid dotted-quad format or non-digit octet characters.\")\n    return ip_address.normalize()"}
