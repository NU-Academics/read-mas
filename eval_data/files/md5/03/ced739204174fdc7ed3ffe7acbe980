{"task_id": "Mbpp/430", "solution": "import math\nclass CalculationError(Exception):\n    \"\"\"Domain-specific exception for validation and computation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef is_finite_number(value) -> bool:\n    \"\"\"Checks if a value is a finite number (int or float, not NaN or inf).\"\"\"\n    if isinstance(value, (int, float)):\n        return math.isfinite(value)\n    return False\nclass InputValidator:\n    \"\"\"Validates inputs for parabola calculations.\"\"\"\n    @staticmethod\n    def validate(a, b, c) -> None:\n        if not (is_finite_number(a) and is_finite_number(b) and is_finite_number(c)):\n            raise CalculationError(\"Inputs a, b, and c must be finite real numbers.\")\n        if a == 0:\n            raise CalculationError(\"a must be non-zero; equation not a parabola.\")\nclass Vertex:\n    \"\"\"Value object for parabola vertex coordinates.\"\"\"\n    def __init__(self, h: float, k: float):\n        self.h = h\n        self.k = k\nclass Parabola:\n    \"\"\"Encapsulates parabola coefficients and computation logic.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\n    def computeVertex(self) -> Vertex:\n        \"\"\"Computes and returns the vertex (h, k) of the parabola.\"\"\"\n        h = -self.b / (2 * self.a)\n        k = self.c - self.b**2 / (4 * self.a)\n        return Vertex(h, k)\n\n    def computeFocalParameter(self) -> float:\n        \"\"\"Computes and returns the focal parameter 'p' of the parabola.\"\"\"\n        p = 1 / (4 * self.a)\n        return p\n\n    def computeDirectrix(self) -> float:\n        \"\"\"Computes and returns the y-value of the parabola's directrix.\"\"\"\n        vertex = self.computeVertex()\n        p = self.computeFocalParameter()\n        y_directrix = vertex.k - p\n        return y_directrix\ndef parabola_directrix(a, b, c):\n    \"\"\"\n    Computes the y-value of the directrix for a parabola given by y = ax^2 + bx + c.\n    Raises CalculationError for invalid inputs or if 'a' is zero.\n    \"\"\"\n    InputValidator.validate(a, b, c)\n    parabola = Parabola(a, b, c)\n    return parabola.computeDirectrix()"}
{"task_id": "Mbpp/436", "solution": "def neg_nos(input_list: list) -> list:\n    \"\"\"Returns a new list containing only the negative numbers from the input list, preserving order.\"\"\"\n    return [item for item in input_list if item < 0]"}
{"task_id": "Mbpp/437", "solution": "def remove_odd(input: str) -> str:\n    \"\"\"Removes characters at odd (1-based) positions from the input string.\"\"\"\n    result_chars = []\n    for idx, ch in enumerate(input, start=1):\n        if idx % 2 == 0:\n            result_chars.append(ch)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/433", "solution": "def check_greater(array, value) -> bool:\n    \"\"\"\n    Checks if the entered number is strictly greater than all elements in the given array.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    def _is_numeric(val) -> bool:\n        \"\"\"Helper to check if a value is an instance of int or float.\"\"\"\n        return isinstance(val, (int, float))\n\n    def _validate_inputs(arr, val) -> None:\n        \"\"\"\n        Validates the types of the array and its elements, and the numeric value.\n        Raises TypeError on the first validation failure.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"The first argument 'array' must be a list.\")\n        if not _is_numeric(val):\n            raise TypeError(\"The second argument 'value' must be numeric (int or float).\")\n        for i, element in enumerate(arr):\n            if not _is_numeric(element):\n                raise TypeError(f\"List element at index {i} is not numeric (int or float).\")\n\n    def _compare_all(arr, val) -> bool:\n        \"\"\"\n        Compares the numeric value against all elements in the array.\n        Returns False on the first element not strictly less than the value.\n        \"\"\"\n        for element in arr:\n            if not (val > element):\n                return False\n        return True\n\n    _validate_inputs(array, value)\n    return _compare_all(array, value)"}
