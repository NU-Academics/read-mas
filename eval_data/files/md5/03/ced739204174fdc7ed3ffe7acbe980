{"task_id": "Mbpp/440", "solution": "import re\nimport string\nfrom typing import List, Tuple, Optional\nclass Sentence:\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\nclass Token:\n    \"\"\"\n    Represents a token from the sentence, storing its raw form,\n    its stripped form (without leading/trailing punctuation),\n    and the start/end indices for both in the original sentence.\n    \"\"\"\n    def __init__(self, raw: str, raw_start_index: int, raw_end_index: int) -> None:\n        self.raw = raw\n        self.raw_start_index = raw_start_index\n        self.raw_end_index = raw_end_index\n        self.stripped: str = \"\"\n        self.start_index: int = raw_start_index\n        self.end_index: int = raw_end_index\n\n    def has_leading_punct(self) -> bool:\n        if not self.raw:\n            return False\n        return self.raw[0] in string.punctuation\n\n    def has_trailing_punct(self) -> bool:\n        if not self.raw:\n            return False\n        return self.raw[-1] in string.punctuation\nclass AdverbFinder:\n    def find_adverb_position(self, sentence_text: str) -> Tuple[int, int, str]:\n        sentence_obj = Sentence(sentence_text)\n        tokens = self._tokenize(sentence_obj)\n\n        for token in tokens:\n            processed_token = self._strip_punctuation(token)\n            if self._is_adverb(processed_token.stripped):\n                start_idx, end_idx = self._compute_indices(sentence_obj, processed_token)\n                return (start_idx, end_idx, processed_token.stripped)\n        \n        raise ValueError('No adverb found')\n\n    def _tokenize(self, sentence: Sentence) -> List[Token]:\n        \"\"\"\n        Tokenizes the sentence into raw tokens, capturing their original spans.\n        Tokens are sequences of non-whitespace characters.\n        \"\"\"\n        tokens: List[Token] = []\n        for match in re.finditer(r'\\S+', sentence.text):\n            raw_text = match.group(0)\n            start = match.start()\n            end = match.end()\n            tokens.append(Token(raw_text, start, end))\n        return tokens\n\n    def _strip_punctuation(self, token: Token) -> Token:\n        \"\"\"\n        Strips leading and trailing punctuation from a token's raw text,\n        updating its stripped form and adjusting its start/end indices.\n        \"\"\"\n        current_start = token.raw_start_index\n        current_end = token.raw_end_index\n        text = token.raw\n\n        while text and text[0] in string.punctuation:\n            text = text[1:]\n            current_start += 1\n\n        while text and text[-1] in string.punctuation:\n            text = text[:-1]\n            current_end -= 1\n        \n        token.stripped = text\n        token.start_index = current_start\n        token.end_index = current_end\n        return token\n\n    def _is_adverb(self, stripped: str) -> bool:\n        \"\"\"Checks if the stripped token ends with 'ly' (case-insensitive) and is not empty.\"\"\"\n        return bool(stripped) and stripped.lower().endswith('ly')\n\n    def _compute_indices(self, sentence: Sentence, token: Token) -> Tuple[int, int]:\n        \"\"\"\n        Returns the adjusted start and end indices of the stripped adverb\n        within the original sentence, as stored in the token.\n        \"\"\"\n        return (token.start_index, token.end_index)\ndef find_adverb_position(sentence: str) -> Tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Raises ValueError if no adverb is found.\n    \"\"\"\n    finder = AdverbFinder()\n    return finder.find_adverb_position(sentence)"}
