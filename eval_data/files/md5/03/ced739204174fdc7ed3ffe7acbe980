{"task_id": "Mbpp/439", "solution": "from typing import List, Optional\nclass JoinedInteger:\n    \"\"\"Holds a concatenated digit string and its numeric integer value.\n    Converts digits to an integer, handling potential representation limits.\"\"\"\n    def __init__(self, digits: str, value: int):\n        self.digits = digits\n        self.value = value\n\n    @classmethod\n    def from_digits(cls, digits: str) -> 'JoinedInteger':\n        \"\"\"Converts a digit string to an integer and constructs a JoinedInteger object.\"\"\"\n        try:\n            value = int(digits)\n        except ValueError:\n            raise ValueError(f\"Invalid integer string: '{digits}'\") from None\n        except OverflowError: # This is included per design's BR7, though rare in Python.\n            raise OverflowError(f\"Resulting integer from '{digits}' is too large to represent.\") from None\n        return cls(digits, value)\nclass Validator:\n    \"\"\"Validates the input list for non-emptiness and correct element types.\"\"\"\n    def validate(self, items: list[int]) -> None:\n        \"\"\"Raises ValueError if the list is empty or TypeError if elements are not integers.\"\"\"\n        if not items:\n            raise ValueError(\"Input list cannot be empty.\")\n        for i, item in enumerate(items):\n            if not isinstance(item, int):\n                raise TypeError(f\"List element at index {i} must be an integer, but got {type(item).__name__}.\")\nclass Concatenator:\n    \"\"\"Converts a list of integers into a single concatenated digit string.\"\"\"\n    def concatenate(self, items: list[int]) -> str:\n        \"\"\"Returns a single string by joining the string representation of each integer.\"\"\"\n        return \"\".join(str(item) for item in items)\nclass MultipleToSingleService:\n    \"\"\"Orchestrates validation, concatenation, and final integer conversion.\"\"\"\n    def __init__(self, validator: Optional[Validator] = None, concatenator: Optional[Concatenator] = None) -> None:\n        self._validator = validator if validator is not None else Validator()\n        self._concatenator = concatenator if concatenator is not None else Concatenator()\n\n    def multiple_to_single(self, items: list[int]) -> int:\n        \"\"\"Validates the input, concatenates integer strings, and returns the final integer.\"\"\"\n        self._validator.validate(items)\n        digits_string = self._concatenator.concatenate(items)\n        joined_integer = JoinedInteger.from_digits(digits_string)\n        return joined_integer.value\ndef multiple_to_single(items: list[int]) -> int:\n    \"\"\"\n    Joins a list of multiple integers into a single integer.\n    Example: [11, 33, 50] becomes 113350.\n    \"\"\"\n    service = MultipleToSingleService()\n    return service.multiple_to_single(items)"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(a, b):\n    \"\"\"\n    Performs index-wise multiplication of elements from two given tuples of 2-element tuples.\n    Assumes inputs are valid and of equal length containing numeric 2-element tuples.\n    \"\"\"\n    result = []\n    for inner_tuple_a, inner_tuple_b in zip(a, b):\n        multiplied_pair = (inner_tuple_a[0] * inner_tuple_b[0], inner_tuple_a[1] * inner_tuple_b[1])\n        result.append(multiplied_pair)\n    return tuple(result)"}
