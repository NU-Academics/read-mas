{"task_id": "Mbpp/573", "solution": "from typing import Iterable, Union\ndef _extract_unique(numbers: list) -> set:\n    \"\"\"Extracts unique numbers from a list.\"\"\"\n    return set(numbers)\ndef _compute_product(numbers: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Computes the product of all numbers in an iterable.\"\"\"\n    product = 1\n    for num in numbers:\n        product *= num\n    return product\ndef unique_product(numbers: list) -> Union[int, float]:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Duplicate values in the input list are treated as a single occurrence.\n    \"\"\"\n    unique_numbers = _extract_unique(numbers)\n    result = _compute_product(unique_numbers)\n    return result"}
{"task_id": "Mbpp/572", "solution": "from typing import List, Dict\nfrom dataclasses import dataclass\nclass InputList:\n    \"\"\"Wraps a list of integers, preserving original order as IntegerElement instances.\"\"\"\n    def __init__(self, raw_elements: List[int]) -> None:\n        self.elements: List[IntegerElement] = [IntegerElement(value=val, count=0) for val in raw_elements]\nclass FrequencyCounter:\n    \"\"\"Calculates the frequency of each integer value in an InputList.\"\"\"\n    def __init__(self) -> None:\n        self.counts: Dict[int, int] = {}\n\n    def count_elements(self, input_list: 'InputList') -> Dict[int, int]:\n        \"\"\"Counts occurrences of each integer value.\"\"\"\n        for element_wrapper in input_list.elements:\n            self.counts[element_wrapper.value] = self.counts.get(element_wrapper.value, 0) + 1\n        return self.counts\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Removes duplicate numbers from a list, returning only numbers that appear exactly once,\n    while preserving their original order.\n    \"\"\"\n    # 1. Wrap input_list as InputList.\n    input_wrapper = InputList(input_list)\n\n    # 2. Use FrequencyCounter.count_elements to compute counts dict.\n    counter = FrequencyCounter()\n    counts_map = counter.count_elements(input_wrapper)\n\n    # 3. Iterate InputList.elements in original order selecting IntegerElement.value where counts[value] == 1.\n    unique_elements_for_output: List[IntegerElement] = []\n    for ie in input_wrapper.elements:\n        if counts_map[ie.value] == 1:\n            # Create a new IntegerElement for the output, with its count explicitly set to 1.\n            unique_elements_for_output.append(IntegerElement(value=ie.value, count=1))\n\n    # 4. Build an OutputList and return OutputList.to_plain_list() (a List[int]).\n    output_wrapper = OutputList(unique_elements_for_output)\n    return output_wrapper.to_plain_list()"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(source, target):\n    \"\"\"\n    Checks if target is a contiguous sublist of source.\n    Raises TypeError if source or target are not lists.\n    \"\"\"\n    if not isinstance(source, list) or not isinstance(target, list):\n        raise TypeError(\"source and target must be lists\")\n\n    if len(target) > len(source):\n        return False\n\n    if not target: # An empty list is a sublist of any list\n        return True\n    \n    for i in range(len(source) - len(target) + 1):\n        if source[i:i+len(target)] == target:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/577", "solution": "LOOKUP = {0: 1, 1: 1, 2: 2, 3: 6, 4: 4}\ndef lookup_last_digit_small_n(n):\n    \"\"\"\n    Retrieves the last digit of n! from a lookup table for small n.\n    \"\"\"\n    return LOOKUP[n]\ndef last_Digit_Factorial(n):\n    \"\"\"\n    Finds the last digit in the factorial of a given number.\n    Returns 0 for n >= 5, otherwise uses a lookup table for 0 <= n <= 4.\n    \"\"\"\n    validate_input(n)\n\n    if n >= 5:\n        return 0\n    else:\n        return lookup_last_digit_small_n(n)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples, preserving order.\n    Elements unique to `a` appear first, followed by elements unique to `b`.\n    \"\"\"\n    result = []\n    \n    for item_a in a:\n        if item_a not in b:\n            result.append(item_a)\n            \n    for item_b in b:\n        if item_b not in a:\n            result.append(item_b)\n            \n    return tuple(result)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists are not of the same length.\n    \"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 == len3):\n        raise ValueError(\"Input lists must be of the same length.\")\n\n    interleaved_list = []\n    for i in range(len1):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n\n    return interleaved_list"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Accepts a native Python tuple (ints and nested tuples) and returns a new tuple with odd ints removed.\n       Preconditions: input_tuple is a tuple (elements assumed int or tuple).\"\"\"\n\n    def _recurse_tuple(t: tuple) -> tuple:\n        \"\"\"Private recursive helper that returns a processed tuple for input tuple t.\"\"\"\n        result_elements = []\n        for item in t:\n            if isinstance(item, int):\n                if item % 2 == 0:\n                    result_elements.append(item)\n            elif isinstance(item, tuple):\n                processed_nested_tuple = _recurse_tuple(item)\n                result_elements.append(processed_nested_tuple)\n        return tuple(result_elements)\n\n    return _recurse_tuple(input_tuple)"}
