{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(input_list):\n    \"\"\"\n    Filters a list to return only the odd numbers, preserving original order.\n    Validates input to ensure it is a list of integers, raising TypeError otherwise.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    odd_numbers = []\n    for item in input_list:\n        if not isinstance(item, int):\n            raise TypeError(f\"All elements in the list must be integers, but found type {type(item).__name__}.\")\n        if item % 2 != 0:\n            odd_numbers.append(item)\n    return odd_numbers"}
{"task_id": "Mbpp/422", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass AverageOfCubesFunction:\n    \"\"\"Stateless provider that validates and computes average of cubes.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"Validates n: must be an integer and n >= 1.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValidationError(\"Input 'n' must be a natural number (>= 1).\")\n\n    def compute(self, n: int) -> float:\n        \"\"\"Computes the average of cubes for the first n natural numbers.\"\"\"\n        self.validate(n)\n        \n        # Formula for sum of first n cubes: (n * (n + 1) / 2)^2\n        sum_of_cubes = (n * (n + 1) // 2) ** 2\n        \n        average = sum_of_cubes / n\n        return float(average)\ndef find_Average_Of_Cube(n) -> float:\n    \"\"\"Finds the average of cubes of the first n natural numbers, validating input n.\"\"\"\n    calculator = AverageOfCubesFunction()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists, element):\n    \"\"\"Return integer count of sublists that contain element using equality (==).\n    Each sublist is counted at most once, even if the element appears multiple times.\n    \"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        for item in sublist:\n            if item == element:\n                count += 1\n                break  # Count this sublist once and move to the next sublist\n    return count"}
{"task_id": "Mbpp/427", "solution": "import re\nfrom typing import Pattern\n_iso_date_regex: Pattern[str] | None = None\ndef _regex_for_iso_date() -> Pattern[str]:\n    \"\"\"Caches and returns the regex pattern for YYYY-MM-DD format.\"\"\"\n    global _iso_date_regex\n    if _iso_date_regex is None:\n        _iso_date_regex = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n    return _iso_date_regex\nclass DateString:\n    \"\"\"Encapsulates a date string and provides format validation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def is_valid_format(self) -> bool:\n        \"\"\"Checks if the date string is in YYYY-MM-DD format.\"\"\"\n        return bool(_regex_for_iso_date().match(self.value))\nclass DateComponents:\n    \"\"\"Holds parsed date components and can format them into a string.\"\"\"\n    def __init__(self, year: int, month: int, day: int) -> None:\n        self.year = year\n        self.month = month\n        self.day = day\n\n    @staticmethod\n    def from_date_string(s: str) -> 'DateComponents':\n        \"\"\"Parses a YYYY-MM-DD string into DateComponents.\"\"\"\n        parts = s.split('-')\n        year = int(parts[0])\n        month = int(parts[1])\n        day = int(parts[2])\n        return DateComponents(year, month, day)\n\n    def to_string(self, format: str) -> str:\n        \"\"\"Formats the date components into the specified string format.\"\"\"\n        return f\"{self.day:02d}-{self.month:02d}-{self.year}\"\ndef change_date_format(input: str) -> str:\n    \"\"\"\n    Converts a date string from YYYY-MM-DD format to DD-MM-YYYY format.\n    Raises ValueError if the input string format is invalid.\n    \"\"\"\n    ds = DateString(input)\n    if not ds.is_valid_format():\n        raise ValueError(\"input not in YYYY-MM-DD format\")\n\n    comps = DateComponents.from_date_string(input)\n    return comps.to_string('DD-MM-YYYY')"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list[int]) -> list[int]:\n    n = len(arr)\n    # Start with a large gap and reduce it by half each iteration.\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for the current gap size.\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n    return arr"}
{"task_id": "Mbpp/432", "solution": "def median_trapezium(a, b, c):\n    \"\"\"Calculates the median length of a trapezium.\n    Parameter 'c' is accepted for compatibility but not used in the calculation.\n    \"\"\"\n    return (float(a) + float(b)) / 2.0"}
{"task_id": "Mbpp/429", "solution": "from typing import Tuple\nclass TupleInput:\n    \"\"\"Domain representation of an input tuple of integers.\"\"\"\n    def __init__(self, elements: Tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\nclass ResultTuple:\n    \"\"\"Domain representation of the result tuple.\"\"\"\n    def __init__(self, elements: Tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\nclass Validator:\n    \"\"\"Encapsulates validation business rules.\"\"\"\n    def is_tuple(self, x) -> bool:\n        return isinstance(x, tuple)\n\n    def elements_are_int(self, x: Tuple[int, ...]) -> bool:\n        return all(isinstance(e, int) for e in x)\n\n    def same_length(self, a: TupleInput, b: TupleInput) -> bool:\n        return a.length() == b.length()\nclass AndOperation:\n    \"\"\"Computes elementwise bitwise AND.\"\"\"\n    def compute(self, a: TupleInput, b: TupleInput) -> ResultTuple:\n        result_elements = tuple(a.elements[i] & b.elements[i] for i in range(a.length()))\n        return ResultTuple(elements=result_elements)\ndef and_tuples(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the elementwise bitwise AND of two input tuples of integers.\n    Performs validation for input types, element types, and tuple lengths.\n    \"\"\"\n    validator = Validator()\n    and_operator = AndOperation()\n\n    if not validator.is_tuple(a) or not validator.is_tuple(b):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if not validator.elements_are_int(a) or not validator.elements_are_int(b):\n        raise TypeError(\"All elements in both tuples must be integers.\")\n\n    input_a = TupleInput(a)\n    input_b = TupleInput(b)\n\n    if not validator.same_length(input_a, input_b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    if input_a.length() == 0 and input_b.length() == 0:\n        return ()\n\n    result_tuple = and_operator.compute(input_a, input_b)\n    return result_tuple.elements"}
