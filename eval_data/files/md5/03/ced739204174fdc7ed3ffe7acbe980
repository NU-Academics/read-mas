{"task_id": "Mbpp/282", "solution": "def sub_list(list1: list, list2: list) -> list:\n    \"\"\"Subtracts two lists element-wise after validating their contents and lengths.\"\"\"\n\n    class ListInput:\n        \"\"\"Encapsulates a list of elements and its length.\"\"\"\n        def __init__(self, elements: list):\n            self.elements = elements\n            self.length = len(elements)\n\n    class NumericElement:\n        \"\"\"Represents a single numeric element with its index (domain concept).\"\"\"\n        def __init__(self, value, index: int):\n            self.value = value\n            self.index = index\n\n    class ResultList:\n        \"\"\"Encapsulates a computed result list and its length.\"\"\"\n        def __init__(self, elements: list):\n            self.elements = elements\n            self.length = len(elements)\n\n    class ValidationService:\n        \"\"\"Stateless utility for validating numeric types and list lengths.\"\"\"\n        def validate_numeric(self, lst: ListInput) -> bool:\n            \"\"\"Checks if all elements in the list are numeric (int or float).\"\"\"\n            for element in lst.elements:\n                if not isinstance(element, (int, float)):\n                    raise ValueError(\"List contains non-numeric elements.\")\n            return True\n\n        def validate_length(self, list1_input: ListInput, list2_input: ListInput) -> bool:\n            \"\"\"Checks if two ListInput objects have the same length.\"\"\"\n            if list1_input.length != list2_input.length:\n                raise ValueError(\"Input lists must have the same length.\")\n            return True\n\n    class SubListFunction:\n        \"\"\"Orchestrates validation and element-wise subtraction.\"\"\"\n        def __init__(self, validator: ValidationService):\n            self.validator = validator\n\n        def sub_list(self, list1_input: ListInput, list2_input: ListInput) -> ResultList:\n            \"\"\"Performs element-wise subtraction after validating inputs.\"\"\"\n            self.validator.validate_length(list1_input, list2_input)\n            self.validator.validate_numeric(list1_input)\n            self.validator.validate_numeric(list2_input)\n\n            result_elements = []\n            for i in range(list1_input.length):\n                result_elements.append(list1_input.elements[i] - list2_input.elements[i])\n\n            return ResultList(result_elements)\n\n    list1_input_dto = ListInput(list1)\n    list2_input_dto = ListInput(list2)\n\n    validator_service = ValidationService()\n    sub_list_processor = SubListFunction(validator_service)\n\n    result_list_dto = sub_list_processor.sub_list(list1_input_dto, list2_input_dto)\n\n    return result_list_dto.elements"}
{"task_id": "Mbpp/283", "solution": "def validate(value: int) -> bool:\n    \"\"\"Accept an integer and check if each digit's frequency is less than or equal to the digit itself.\"\"\"\n    import collections\n\n    class ValidationResult:\n        def __init__(self, result: bool, reason: str = \"\"):\n            self.result = result\n            self.reason = reason\n\n    class TypeValidator:\n        @staticmethod\n        def ensureInteger(val_input):\n            \"\"\"Raise TypeError if val_input is not an int.\"\"\"\n            if not isinstance(val_input, int):\n                raise TypeError(\"Input must be an integer.\")\n\n    class IntegerInput:\n        def __init__(self, val_input: int):\n            self.value = val_input\n\n        def digits(self) -> list[int]:\n            \"\"\"Return decimal digits extracted from absolute(self.value).\"\"\"\n            if self.value == 0:\n                return [0]\n            abs_value_str = str(abs(self.value))\n            return [int(digit_char) for digit_char in abs_value_str]\n\n    class FrequencyCounter:\n        @staticmethod\n        def countDigits(digits_list: list[int]) -> dict[int, int]:\n            \"\"\"Return mapping digit -> count. Only present digits included.\"\"\"\n            return dict(collections.Counter(digits_list))\n\n    class Comparator:\n        @staticmethod\n        def compare(freq_map_param: dict[int, int]) -> ValidationResult:\n            \"\"\"Return ValidationResult where result True if all counts <= digit, else False with reason.\"\"\"\n            for digit_val, count in freq_map_param.items():\n                if count > digit_val:\n                    return ValidationResult(False, f\"Digit {digit_val} has frequency {count}, which is greater than the digit itself.\")\n            return ValidationResult(True, \"All digit frequencies are less than or equal to the digit itself.\")\n\n    # Orchestration of the validation pipeline\n    TypeValidator.ensureInteger(value)\n    \n    int_obj = IntegerInput(value)\n    digits = int_obj.digits()\n    \n    freq_map = FrequencyCounter.countDigits(digits)\n    \n    result_obj = Comparator.compare(freq_map)\n    \n    return result_obj.result"}
{"task_id": "Mbpp/286", "solution": "class InputValidator:\n    \"\"\"Responsibility: validate arr, n, k.\"\"\"\n    def __init__(self):\n        self.error_message = \"\"\n\n    def validate(self, arr, n, k) -> bool:\n        \"\"\"Return True if inputs are valid, False otherwise.\"\"\"\n        if not isinstance(arr, list):\n            self.error_message = \"Input 'arr' must be a list.\"\n            return False\n        if not all(isinstance(x, int) for x in arr):\n            self.error_message = \"All elements in 'arr' must be integers.\"\n            return False\n        if not isinstance(n, int) or n != len(arr):\n            self.error_message = \"Input 'n' must be an integer equal to len(arr).\"\n            return False\n        if not isinstance(k, int) or k < 1:\n            self.error_message = \"Input 'k' must be a positive integer (k >= 1).\"\n            return False\n        return True\n\n    def get_error(self) -> str:\n        \"\"\"Return the last validation error message.\"\"\"\n        return self.error_message\nclass Array:\n    \"\"\"Encapsulate input integer array and length.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n        self.length = len(elements)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the underlying list of elements.\"\"\"\n        return self.elements\nclass Result:\n    \"\"\"Encapsulate integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass SubarraySumCalculator:\n    \"\"\"Compute maximum contiguous subarray sum for repeated array.\"\"\"\n    def __init__(self):\n        pass\n\n    def computeKadane(self, values: list) -> int:\n        \"\"\"Standard Kadane implementation, handling all-negative arrays by returning the maximal element.\"\"\"\n        if not values: # Should not happen based on input validation (n >= 1)\n            return 0 \n\n        max_so_far = values[0]\n        current_max = values[0]\n\n        for i in range(1, len(values)):\n            current_max = max(values[i], current_max + values[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def computeOptimized(self, arr_obj: Array, k: int) -> int:\n        \"\"\"Compute maximum subarray sum over k repetitions in O(n) time and O(1) extra memory.\"\"\"\n        arr = arr_obj.elements\n        n = arr_obj.length\n\n        max_subarray_sum_single = self.computeKadane(arr)\n        total_sum = sum(arr)\n\n        max_prefix_sum = -float('inf')\n        current_sum = 0\n        for x in arr:\n            current_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_sum)\n\n        max_suffix_sum = -float('inf')\n        current_sum = 0\n        for x in reversed(arr):\n            current_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_sum)\n\n        if k == 1:\n            return max_subarray_sum_single\n        else: # k >= 2\n            cross_array_sum = max_suffix_sum + max_prefix_sum\n            if k > 2:\n                # Add (k-2) full arrays, but only if their sum contributes positively.\n                if total_sum > 0:\n                    cross_array_sum += total_sum * (k - 2)\n            \n            return max(max_subarray_sum_single, cross_array_sum)\n\n    def computeMaxSum(self, arr_obj: Array, k: int) -> int:\n        \"\"\"Primary method for computing result, dispatching to the optimized algorithm.\"\"\"\n        return self.computeOptimized(arr_obj, k)\ndef max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"Return int: maximum contiguous subarray sum for arr repeated k times.\"\"\"\n    validator = InputValidator()\n    if not validator.validate(arr, n, k):\n        raise ValueError(validator.get_error())\n\n    arr_model = Array(arr)\n    calculator = SubarraySumCalculator()\n    calculated_sum = calculator.computeMaxSum(arr_model, k)\n\n    result_obj = Result(calculated_sum)\n    return result_obj.value"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Compute and return the sum of squares of first n even natural numbers.\n\n    Returns sum_{k=1..n} (2k)^2 implemented via the identity: (2 * n * (n + 1) * (2 * n + 1)) // 3.\n    \"\"\"\n    return (2 * n * (n + 1) * (2 * n + 1)) // 3"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"Return (max_length, sublist) where max_length is the length of the longest sublist in list_of_lists and sublist is a sublist from the input with that length.\n    Tie-breaking: returns the first sublist that attains the maximum length. Empty input: returns (0, []).\n    \"\"\"\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    longest_sublist: List[Any] = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_sublist = sublist\n            \n    return (max_len, longest_sublist)"}
{"task_id": "Mbpp/292", "solution": "import math\nfrom typing import Union\ndef find(a: Union[int, float], b: Union[int, float]) -> int:\n    \"\"\"\n    Finds the quotient of two numbers, rounded down to the nearest integer (floor division).\n    This function validates inputs and handles potential division by zero.\n    \"\"\"\n\n    def _validate_inputs(a_val: object, b_val: object) -> None:\n        \"\"\"Helper to validate that inputs are numeric and the divisor is not zero.\"\"\"\n        if not isinstance(a_val, (int, float)) or not isinstance(b_val, (int, float)):\n            raise TypeError(\"Inputs 'a' and 'b' must be numeric (int or float).\")\n        if b_val == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n\n    def _compute_floor_quotient(a_val: Union[int, float], b_val: Union[int, float]) -> int:\n        \"\"\"Helper to compute the floor of the quotient of two numeric values.\"\"\"\n        return int(math.floor(a_val / b_val))\n\n    _validate_inputs(a, b)\n    return _compute_floor_quotient(a, b)"}
{"task_id": "Mbpp/294", "solution": "def max_val(input_list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Returns None if no numeric elements are found.\n    \"\"\"\n\n    def filterNumeric(lst):\n        \"\"\"Filters the list to include only int or float elements.\"\"\"\n        return [item for item in lst if isinstance(item, (int, float))]\n\n    def findMax(numeric_lst):\n        \"\"\"Finds the maximum value in a list of numbers, or None if the list is empty.\"\"\"\n        if not numeric_lst:\n            return None\n        return max(numeric_lst)\n\n    numeric_elements = filterNumeric(input_list)\n    return findMax(numeric_elements)"}
{"task_id": "Mbpp/293", "solution": "import math\ndef _compute_hypotenuse(a, b) -> float:\n    \"\"\"Return math.sqrt(a*a + b*b) as float.\"\"\"\n    return math.sqrt(a*a + b*b)\ndef otherside_rightangle(a, b) -> float:\n    \"\"\"Validate a and b, compute hypotenuse = sqrt(a*a + b*b), return float (precision target 1e-12).\"\"\"\n    _validate_inputs(a, b)\n    hypotenuse = _compute_hypotenuse(a, b)\n    return hypotenuse"}
