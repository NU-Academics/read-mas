{"task_id": "Mbpp/269", "solution": "class InputError(Exception):\n    \"\"\"Exception raised for invalid input to ascii_value function.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass CharacterInput:\n    \"\"\"Encapsulates input character and provides validation methods.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def isSingleChar(self) -> bool:\n        \"\"\"Returns True if the input string has a length of 1.\"\"\"\n        return len(self.value) == 1\n\n    def isAscii(self) -> bool:\n        \"\"\"Returns True if the character's ordinal value is within the ASCII range (0-127).\"\"\"\n        if not self.isSingleChar():\n            return False\n        char_code = ord(self.value)\n        return 0 <= char_code <= 127\ndef ascii_value(input: str) -> int:\n    \"\"\"\n    Returns the ASCII integer code for a single-character input.\n    Raises InputError if the input is not a single character or not within the ASCII range (0-127).\n    \"\"\"\n    char_input = CharacterInput(input)\n\n    if not char_input.isSingleChar():\n        raise InputError('Input must be a single character.')\n\n    if not char_input.isAscii():\n        raise InputError('Input character is not an ASCII character (code not in 0..127).')\n\n    code = ord(input)\n    return code"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the first n even natural numbers each raised to the fifth power.\"\"\"\n\n    class InputValidator:\n        \"\"\"Validates that n is a positive integer.\"\"\"\n        def validate(self, n_val: int) -> bool:\n            if not isinstance(n_val, int) or n_val <= 0:\n                raise ValueError(\"Input 'n' must be a positive integer.\")\n            return True\n\n    class EvenNumber:\n        \"\"\"Represents an even natural number and computes its fifth power.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def pow5(self) -> int:\n            return self.value ** 5\n\n    class EvenNumberSequence:\n        \"\"\"Generates a sequence of EvenNumber objects.\"\"\"\n        def __init__(self, n_seq: int):\n            self._n = n_seq\n\n        def generate(self) -> list[EvenNumber]:\n            sequence = []\n            for k in range(1, self._n + 1):\n                sequence.append(EvenNumber(2 * k))\n            return sequence\n\n    class Result:\n        \"\"\"Accumulates an integer sum.\"\"\"\n        def __init__(self):\n            self._sum = 0\n\n        def add(self, value: int) -> None:\n            self._sum += value\n\n        @property\n        def sum(self) -> int:\n            return self._sum\n\n    # Orchestration logic as per design\n    validator = InputValidator()\n    validator.validate(n)\n\n    sequence_generator = EvenNumberSequence(n)\n    even_numbers = sequence_generator.generate()\n\n    accumulator = Result()\n    for even_num_obj in even_numbers:\n        fifth_power = even_num_obj.pow5()\n        accumulator.add(fifth_power)\n\n    return accumulator.sum"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(lst):\n    \"\"\"\n    Calculates the sum of even numbers found at even 0-based positions in a list.\n    Returns 0 if no such numbers are found.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 == 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
