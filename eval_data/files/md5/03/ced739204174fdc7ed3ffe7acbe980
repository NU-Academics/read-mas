{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate: tuple[int, int]) -> list[list[int, int]]:\n    \"\"\"\n    Extracts all 3x3 adjacent coordinates of the given coordinate tuple, including itself.\n    The coordinates are returned in row-major order.\n    \"\"\"\n    r, c = coordinate\n    adjacent_coords = []\n    for row_offset in range(-1, 2):\n        for col_offset in range(-1, 2):\n            adjacent_coords.append([r + row_offset, c + col_offset])\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "_WHITESPACE_CHARS = [' ', '\\t', '\\n', '\\r']\nclass Character:\n    \"\"\"Represents a single character and provides classification helpers.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def is_whitespace(self) -> bool:\n        \"\"\"Checks if the character is a canonical whitespace character.\"\"\"\n        return self.char in _WHITESPACE_CHARS\n\n    def is_underscore(self) -> bool:\n        \"\"\"Checks if the character is an underscore.\"\"\"\n        return self.char == '_'\nclass InputString:\n    \"\"\"Encapsulates an input string and provides properties for its content.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def contains_whitespace(self) -> bool:\n        \"\"\"Determines if the input string contains any whitespace characters.\"\"\"\n        for char_val in self.value:\n            if Character(char_val).is_whitespace():\n                return True\n        return False\n\n    def contains_underscore(self) -> bool:\n        \"\"\"Determines if the input string contains any underscore characters.\"\"\"\n        for char_val in self.value:\n            if Character(char_val).is_underscore():\n                return True\n        return False\nclass ReplaceSpacesFunction:\n    \"\"\"Encapsulates the logic for validating input and performing the string transformation.\"\"\"\n    def replace_spaces(self, input_str: str) -> str:\n        \"\"\"Public method to validate and transform the input string.\"\"\"\n        self.validate_input(input_str)\n        return self.transform(input_str)\n\n    def validate_input(self, input_val) -> None:\n        \"\"\"Validates that the input is a string, raising TypeError if not.\"\"\"\n        if not isinstance(input_val, str):\n            raise TypeError(\"input must be a string\")\n\n    def transform(self, input_str: str) -> str:\n        \"\"\"Performs the atomic two-way character swap based on input content.\"\"\"\n        input_obj = InputString(input_str)\n        has_whitespace = input_obj.contains_whitespace()\n        has_underscore = input_obj.contains_underscore()\n\n        if not has_whitespace and not has_underscore:\n            return input_str # Return original if no relevant characters are present\n\n        result_chars = []\n        for char_val in input_str:\n            char_obj = Character(char_val)\n            if char_obj.is_whitespace() and has_whitespace:\n                result_chars.append('_')\n            elif char_obj.is_underscore() and has_underscore:\n                result_chars.append(' ')\n            else:\n                result_chars.append(char_val)\n        return \"\".join(result_chars)\ndef replace_spaces(input: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in a given string.\n    Performs an atomic two-way swap to avoid cascading replacements.\n    \"\"\"\n    replacer = ReplaceSpacesFunction()\n    return replacer.replace_spaces(input)"}
