{"task_id": "Mbpp/93", "solution": "class Error(Exception):\n    \"\"\"Custom exception for validation and ambiguous cases.\"\"\"\n    def __init__(self, message: str, code: int = 1):\n        self.message = message\n        self.code = code\n        super().__init__(self.message)\nclass PowerFunction:\n    \"\"\"Encapsulates the logic for validating inputs and computing power.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def validateInputs(self):\n        \"\"\"Validates inputs for numeric type and handles ambiguous 0^0 case.\"\"\"\n        if not isinstance(self.a, (int, float)) or not isinstance(self.b, (int, float)):\n            raise Error(\"Inputs must be numeric (int or float).\", code=101)\n        if self.a == 0 and self.b == 0:\n            raise Error(\"Ambiguous operation: 0 to the power of 0 is undefined.\", code=102)\n\n    def compute(self):\n        \"\"\"Computes 'a' raised to the power 'b'.\"\"\"\n        return self.a ** self.b\ndef power(a, b):\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    Raises Error for non-numeric inputs or the ambiguous 0^0 case.\n    \"\"\"\n    pf = PowerFunction(a, b)\n    pf.validateInputs()\n    result_value = pf.compute()\n    return result_value"}
{"task_id": "Mbpp/92", "solution": "from typing import List, Set\nclass CheckResult:\n    \"\"\"Encapsulates the boolean result of an undulating check.\"\"\"\n    def __init__(self, isUndulating: bool):\n        self._isUndulating = isUndulating\n\n    @property\n    def isUndulating(self) -> bool:\n        return self._isUndulating\nclass Number:\n    \"\"\"Represents an integer value and provides its absolute decimal digit string.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def toDigitString(self) -> str:\n        \"\"\"Returns the decimal digit string of the absolute value.\"\"\"\n        return str(abs(self._value))\nclass DigitSequence:\n    \"\"\"Encapsulates an ordered sequence of digits with query methods.\"\"\"\n    def __init__(self, digit_string: str):\n        self._digits: List[int] = [int(d) for d in digit_string]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self._digits)\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the digit at the specified index.\"\"\"\n        return self._digits[index]\n\n    def distinctDigits(self) -> Set[int]:\n        \"\"\"Returns a set of unique digits in the sequence.\"\"\"\n        return set(self._digits)\nclass UndulatingChecker:\n    \"\"\"Evaluates whether a Number's digit sequence is undulating.\"\"\"\n    def is_undulating(self, n: Number) -> bool:\n        \"\"\"Checks if the given Number represents an undulating sequence.\"\"\"\n        digit_string = n.toDigitString()\n        digit_sequence = DigitSequence(digit_string)\n\n        if digit_sequence.length() < 2:\n            return CheckResult(isUndulating=False).isUndulating\n\n        distinct_digits = digit_sequence.distinctDigits()\n        if len(distinct_digits) != 2:\n            return CheckResult(isUndulating=False).isUndulating\n        \n        # Verify strict alternation: d_i must be different from d_{i-1}\n        # and d_i must be the same as d_{i-2} (for i >= 2).\n        for i in range(1, digit_sequence.length()):\n            current_digit = digit_sequence.get(i)\n            previous_digit = digit_sequence.get(i - 1)\n            \n            if current_digit == previous_digit:\n                return CheckResult(isUndulating=False).isUndulating\n            \n            if i >= 2:\n                two_back_digit = digit_sequence.get(i - 2)\n                if current_digit != two_back_digit:\n                    return CheckResult(isUndulating=False).isUndulating\n        \n        return CheckResult(isUndulating=True).isUndulating\ndef is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is an undulating number.\n    An undulating number's decimal digits strictly alternate between exactly two distinct digits.\n    \"\"\"\n    number_obj = Number(n)\n    checker = UndulatingChecker()\n    return checker.is_undulating(number_obj)"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Any\ndef Find_Min_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"Compute minimum length among inner lists using Python's built-in len().\n\n    Preconditions: list_of_lists is a Python list whose elements are lists.\n    \"\"\"\n    lengths = [len(inner) for inner in list_of_lists]\n    return min(lengths)"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, Sequence, Tuple as TypingTuple\nTupleList = Sequence[TypingTuple[Any, Any]]\ndef index_minimum(tuples: TupleList) -> Any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Tie-breaking: if multiple tuples share the minimal second value, return the first such tuple encountered.\n    \"\"\"\n    return min(tuples, key=lambda x: x[1])[0]"}
{"task_id": "Mbpp/96", "solution": "def compute_divisor_count(n: int) -> int:\n    \"\"\"Computes the number of positive divisors of n.\"\"\"\n    abs_n = abs(n)\n    if abs_n == 0:\n        return 0\n\n    count = 0\n    i = 1\n    while i * i <= abs_n:\n        if abs_n % i == 0:\n            if i * i == abs_n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\ndef divisor(n: int) -> int:\n    \"\"\"Finds the number of positive divisors of a given integer.\"\"\"\n    return compute_divisor_count(n)"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Dict\nclass FrequencyDictionary:\n    \"\"\"Stores and exposes mapping of element -> integer count.\"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[Any, int] = {}\n\n    def increment(self, element: Any) -> None:\n        \"\"\"Increments the count for the given element.\"\"\"\n        self._counts[element] = self._counts.get(element, 0) + 1\n\n    def get_counts(self) -> dict:\n        \"\"\"Returns a shallow copy of the internal counts dictionary.\"\"\"\n        return dict(self._counts)\nclass FrequencyCounter:\n    \"\"\"Incrementally counts elements by delegating storage to FrequencyDictionary.\"\"\"\n    def __init__(self, frequency_dict: 'FrequencyDictionary') -> None:\n        self._frequency_dict = frequency_dict\n\n    def count(self, element: Any) -> None:\n        \"\"\"Counts the given element by incrementing it in the underlying dictionary.\"\"\"\n        self._frequency_dict.increment(element)\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping each element to its count.\n    \"\"\"\n    frequency_dict = FrequencyDictionary()\n    frequency_counter = FrequencyCounter(frequency_dict)\n\n    for sublist in list_of_lists:\n        for element in sublist:\n            frequency_counter.count(element)\n\n    return frequency_dict.get_counts()"}
{"task_id": "Mbpp/99", "solution": "class ValidationError(Exception):\n    \"\"\"Represents input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass BinaryConverter:\n    \"\"\"Executes conversion logic from a non-negative integer to its binary string.\"\"\"\n    def decimal_to_binary(self, value: int) -> str:\n        \"\"\"Converts a validated non-negative integer to its binary string representation.\"\"\"\n        if value == 0:\n            return '0'\n\n        binary_string = ''\n        temp_value = value\n        while temp_value > 0:\n            remainder = temp_value % 2\n            binary_string = str(remainder) + binary_string\n            temp_value //= 2\n        return binary_string\ndef decimal_to_binary(value: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary equivalent as a string.\"\"\"\n    if not isinstance(value, int):\n        raise ValidationError(\"Input must be an integer.\")\n    if value < 0:\n        raise ValidationError(\"Input must be a non-negative integer.\")\n\n    converter = BinaryConverter()\n    return converter.decimal_to_binary(value)"}
{"task_id": "Mbpp/98", "solution": "import math\ndef multiply_num(numbers):\n    \"\"\"Multiply all numbers in the input sequence and divide by the length.\n    Validates input using nested helpers, then computes and returns the result.\"\"\"\n\n    def is_non_empty(numbers_arg):\n        \"\"\"Checks if the sequence is non-empty, raising ValueError if empty.\"\"\"\n        if not numbers_arg:\n            raise ValueError(\"Input sequence cannot be empty.\")\n        return True\n\n    def is_numeric_sequence(numbers_arg):\n        \"\"\"Checks if all elements are numeric, raising TypeError if not.\"\"\"\n        for item in numbers_arg:\n            if not isinstance(item, (int, float)):\n                raise TypeError(f\"All elements must be numeric, but found {type(item).__name__}.\")\n        return True\n\n    is_non_empty(numbers)\n    is_numeric_sequence(numbers)\n\n    product = 1\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/101", "solution": "class InputValidator:\n    @staticmethod\n    def validate(array, k) -> None:\n        \"\"\"Validates inputs for kth_element; raises TypeError or IndexError on failure.\"\"\"\n        if not isinstance(array, (list, tuple)):\n            raise TypeError(\"array must be a list or tuple\")\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an int\")\n        if k < 1 or k > len(array):\n            raise IndexError(\"k out of range\")\ndef kth_element(array, k):\n    \"\"\"Returns the element at 1-based index k from array after validating inputs.\"\"\"\n    InputValidator.validate(array, k)\n    return array[k - 1]"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input: str) -> str:\n    \"\"\"Convert snake_case string to CamelCase (PascalCase).\"\"\"\n    if not input:\n        return \"\"\n\n    parts = input.split('_')\n    camel_case_parts = []\n    for part in parts:\n        if part:  # Ignore empty segments\n            camel_case_parts.append(part.capitalize())\n    \n    return \"\".join(camel_case_parts)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    s = str(n)\n    length = len(s)\n\n    # Helper function to build a palindrome string by mirroring its first half.\n    # num_str is the base string from which the left half (and potentially middle) is taken.\n    def _mirror_string_to_palindrome(num_str: str) -> str:\n        s_len = len(num_str)\n        left_half = num_str[:s_len // 2]\n        if s_len % 2 == 1:\n            middle = num_str[s_len // 2]\n            return left_half + middle + left_half[::-1]\n        else:\n            return left_half + left_half[::-1]\n\n    # Special case: If n consists of all '9's (e.g., 9, 99, 999),\n    # the next smallest palindrome will be '1' followed by (length-1) '0's and a '1'.\n    # Example: 9 -> 11, 99 -> 101.\n    if all(c == '9' for c in s):\n        return int('1' + '0' * (length - 1) + '1')\n\n    # Calculate the \"root segment\", which is the left half of the number string,\n    # including the middle digit if the total length is odd. This segment is what is mirrored and potentially incremented.\n    root_segment_length = (length + 1) // 2\n    root_segment_str = s[:root_segment_length]\n\n    # 1. First attempt: Construct a candidate palindrome by mirroring the left half of the original number string `s`.\n    # This candidate might be less than or equal to `n`, especially if `n` itself is a palindrome or nearly so.\n    candidate_p_str = _mirror_string_to_palindrome(s)\n    candidate_p_int = int(candidate_p_str)\n\n    # If this mirrored candidate palindrome is strictly greater than `n`, it is our answer.\n    # This also handles cases where `n` itself is a palindrome (e.g., n=121, mirrored=121; 121 > 121 is false),\n    # leading to the increment step.\n    if candidate_p_int > n:\n        return candidate_p_int\n\n    # 2. If the mirrored candidate is not strictly greater than `n` (i.e., it's equal or smaller),\n    # we need to find a larger palindrome. This is achieved by incrementing the 'root segment'\n    # and then re-mirroring it to form the next palindrome.\n    incremented_root_segment_int = int(root_segment_str) + 1\n    new_root_segment_str = str(incremented_root_segment_int)\n\n    # Construct the final palindrome using the `new_root_segment_str`.\n    # The `new_root_segment_str` implicitly contains the incremented middle digit for odd lengths,\n    # or is the new left half for even lengths.\n    \n    # Extract the true left half for mirroring based on the original length,\n    # from the `new_root_segment_str`.\n    final_left_half_for_mirror = new_root_segment_str[:length // 2]\n    \n    final_p_str = \"\"\n    if length % 2 == 1: # Odd length palindrome\n        final_middle_digit = new_root_segment_str[length // 2]\n        final_p_str = final_left_half_for_mirror + final_middle_digit + final_left_half_for_mirror[::-1]\n    else: # Even length palindrome\n        final_p_str = final_left_half_for_mirror + final_left_half_for_mirror[::-1]\n\n    return int(final_p_str)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n, m):\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using a recursive approach with memoization.\n    It applies the base cases, boundary conditions, and the recurrence relation.\n    \"\"\"\n    memo = {}\n\n    def _compute(current_n, current_m):\n        # Boundary rule: if m < 0 or m >= n, then a(n, m) = 0\n        if current_m < 0 or current_m >= current_n:\n            return 0\n\n        # Base case: a(0, 0) = 1\n        if current_n == 0 and current_m == 0:\n            return 1\n        \n        # Check memoization cache\n        if (current_n, current_m) in memo:\n            return memo[(current_n, current_m)]\n\n        # Recurrence relation: a(n, m) = (n - m) * a(n-1, m-1) + (m + 1) * a(n-1, m)\n        val = (current_n - current_m) * _compute(current_n - 1, current_m - 1) + \\\n              (current_m + 1) * _compute(current_n - 1, current_m)\n        \n        memo[(current_n, current_m)] = val\n        return val\n\n    # Directly call the recursive helper.\n    # Input validation (e.g., n >= 0, integer types) is omitted due to specific constraints.\n    return _compute(n, m)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\nclass SortOperation:\n    \"\"\"Helper class to encapsulate the sorting operation for a single sublist.\"\"\"\n    def sort(self, items: Sequence[str]) -> List[str]:\n        \"\"\"Sorts a sequence of strings lexicographically and returns a new list.\"\"\"\n        return sorted(items)\ndef sort_sublists(sublists: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n\n    Returns a new list of lists where each inner list is sorted.\n    \"\"\"\n    sorter = SortOperation()\n    result = []\n    for sublist in sublists:\n        result.append(sorter.sort(sublist))\n    return result"}
