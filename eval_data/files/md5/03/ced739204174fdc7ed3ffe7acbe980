{"task_id": "Mbpp/409", "solution": "class ProductResult:\n    \"\"\"Holds the final minimum product value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self._value = value\n\n    def as_number(self) -> float:\n        \"\"\"Returns the numeric value of the product result.\"\"\"\n        return self._value\nclass TuplePair:\n    \"\"\"Represents a pair of numbers and can compute their product.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self._a = a\n        self._b = b\n\n    def product(self) -> float:\n        \"\"\"Computes the product of the two stored numbers.\"\"\"\n        return self._a * self._b\nclass InputList:\n    \"\"\"A wrapper for the input list, holding validated TuplePair instances.\"\"\"\n    def __init__(self, tuples: list) -> None:\n        # Assumes 'tuples' is a list of already validated 2-element numeric tuples/lists.\n        self._tuples = [TuplePair(float(t[0]), float(t[1])) for t in tuples]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of tuple pairs in the list.\"\"\"\n        return len(self._tuples)\n\n    def get(self, index: int) -> 'TuplePair':\n        \"\"\"Retrieves a TuplePair at the given index.\"\"\"\n        return self._tuples[index]\n\n    def __iter__(self):\n        \"\"\"Allows iteration over the contained TuplePair instances.\"\"\"\n        return iter(self._tuples)\nclass MinProductFunction:\n    \"\"\"Contains the business logic to compute the minimum product.\"\"\"\n    def computeMinProduct(self, input_list: 'InputList') -> 'ProductResult':\n        \"\"\"Iterate over input_list, compute each TuplePair.product(), track minimum, return ProductResult(min_value).\"\"\"\n        min_product_val = float('inf')\n        for tuple_pair in input_list:\n            current_product = tuple_pair.product()\n            if current_product < min_product_val:\n                min_product_val = current_product\n        return ProductResult(min_product_val)\ndef min_product_tuple(input_list) -> float:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    This function validates input and delegates computation to internal components.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    validated_items = []\n    for i, item in enumerate(input_list):\n        if not isinstance(item, (tuple, list)):\n            raise TypeError(f\"Element at index {i} must be a tuple or list, but got {type(item).__name__}.\")\n        if len(item) != 2:\n            raise TypeError(f\"Tuple/list at index {i} must have exactly 2 elements, but has {len(item)}.\")\n        \n        # Check if elements are numeric (int or float)\n        if not isinstance(item[0], (int, float)) or not isinstance(item[1], (int, float)):\n            raise TypeError(f\"Elements of tuple/list at index {i} must be numeric (int or float).\")\n        \n        validated_items.append(item)\n\n    # Wrap the validated input into an InputList object\n    input_wrapper = InputList(validated_items)\n\n    # Use MinProductFunction to compute the minimum product\n    min_prod_calculator = MinProductFunction()\n    result_obj = min_prod_calculator.computeMinProduct(input_wrapper)\n\n    # Return the numeric result\n    return result_obj.as_number()"}
{"task_id": "Mbpp/410", "solution": "def min_val(input_list) -> (int | float):\n    \"\"\"\n    Finds the minimum numeric value (int or float) in a heterogeneous list.\n    Non-numeric elements are ignored during the search.\n    \"\"\"\n\n    class Element:\n        \"\"\"Base class for list elements, providing a generic value and numeric check.\"\"\"\n        def __init__(self, value):\n            self.value = value\n\n        def isNumeric(self):\n            \"\"\"Returns True if the element's value is numeric (int or float).\"\"\"\n            return False\n\n    class NumericElement(Element):\n        \"\"\"Represents a numeric value (int or float) from the list.\"\"\"\n        def isNumeric(self):\n            \"\"\"Confirms this element is numeric.\"\"\"\n            return True\n\n        def to_number(self):\n            \"\"\"Returns the numeric value for comparison.\"\"\"\n            return self.value\n\n    class NonNumericElement(Element):\n        \"\"\"Represents a non-numeric value from the list.\"\"\"\n        pass\n\n    class InputList:\n        \"\"\"Normalizes a raw list into a container of Element objects.\"\"\"\n        def __init__(self, raw_list):\n            self._elements = []\n            for item in raw_list:\n                if isinstance(item, (int, float)):\n                    self._elements.append(NumericElement(item))\n                else:\n                    self._elements.append(NonNumericElement(item))\n\n        def __iter__(self):\n            \"\"\"Allows iteration over the contained Element objects.\"\"\"\n            return iter(self._elements)\n\n    def _to_input_list(raw_list):\n        \"\"\"Converts a raw list into an InputList of Element-derived objects.\"\"\"\n        return InputList(raw_list)\n\n    def _filter_numeric_values(input_list_obj: InputList):\n        \"\"\"Extracts and returns only the NumericElement objects from an InputList.\"\"\"\n        numeric_elements = []\n        for element in input_list_obj:\n            if element.isNumeric():\n                numeric_elements.append(element)\n        return numeric_elements\n\n    class MinValFunction:\n        \"\"\"Encapsulates the algorithm to find the minimum numeric value in a list.\"\"\"\n        @staticmethod\n        def _find_min_val(raw_list_arg):\n            \"\"\"Finds the minimum numeric value in a heterogeneous list.\"\"\"\n            input_list_obj = _to_input_list(raw_list_arg)\n            numeric_elements = _filter_numeric_values(input_list_obj)\n\n            if not numeric_elements:\n                raise ValueError(\"No numeric elements found in the list.\")\n\n            minimum = float('inf')\n            for num_element in numeric_elements:\n                numeric_value = num_element.to_number()\n                if numeric_value < minimum:\n                    minimum = numeric_value\n            return minimum\n\n    return MinValFunction._find_min_val(input_list)"}
