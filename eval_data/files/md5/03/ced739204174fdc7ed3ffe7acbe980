{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-sort based algorithm.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    from typing import List, Tuple\n\n    class InversionCounter:\n        \"\"\"\n        Encapsulates the merge-sort based inversion counting algorithm.\n        \"\"\"\n        def get_Inv_Count(self, arr_list: List[int]) -> int:\n            \"\"\"\n            Public method to get the inversion count for a given array.\n            Handles base cases for empty or single-element arrays.\n            \"\"\"\n            if len(arr_list) < 2:\n                return 0\n            # _sort_count returns (sorted_array, inversion_count), we only need the count\n            _, count = self._sort_count(arr_list)\n            return count\n\n        def _sort_count(self, arr_list: List[int]) -> Tuple[List[int], int]:\n            \"\"\"\n            Recursively sorts the array and counts inversions.\n            Returns a tuple of (sorted_array, inversion_count).\n            \"\"\"\n            n = len(arr_list)\n            if n < 2:\n                return arr_list, 0\n\n            mid = n // 2\n            left_half = arr_list[:mid]\n            right_half = arr_list[mid:]\n\n            sorted_left, inv_left = self._sort_count(left_half)\n            sorted_right, inv_right = self._sort_count(right_half)\n\n            merged_array, inv_merge = self._merge_count(sorted_left, sorted_right)\n\n            total_inversions = inv_left + inv_right + inv_merge\n            return merged_array, total_inversions\n\n        def _merge_count(self, left: List[int], right: List[int]) -> Tuple[List[int], int]:\n            \"\"\"\n            Merges two sorted arrays and counts inversions during the merge.\n            Returns a tuple of (merged_sorted_array, inversion_count).\n            \"\"\"\n            merged = []\n            inversions = 0\n            i, j = 0, 0\n\n            while i < len(left) and j < len(right):\n                if left[i] <= right[j]:\n                    merged.append(left[i])\n                    i += 1\n                else:\n                    # An inversion occurs: left[i] > right[j].\n                    # All remaining elements in left (from index i onwards) will be greater than right[j].\n                    inversions += (len(left) - i)\n                    merged.append(right[j])\n                    j += 1\n\n            # Add any remaining elements from left or right\n            merged.extend(left[i:])\n            merged.extend(right[j:])\n\n            return merged, inversions\n\n    # Instantiate and delegate to the InversionCounter class\n    counter_instance = InversionCounter()\n    return counter_instance.get_Inv_Count(arr)"}
{"task_id": "Mbpp/300", "solution": "from math import comb\nfrom typing import Any\ndef _central_binomial_coefficient(n: int) -> int:\n    \"\"\"Computes the central binomial coefficient C(2n, n).\"\"\"\n    return comb(2 * n, n)\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    _validate_input(n)\n    int_value = _central_binomial_coefficient(n)\n    return float(int_value)"}
{"task_id": "Mbpp/301", "solution": "class DictDepthFunction:\n    \"\"\"Encapsulates traversal and depth computation logic.\"\"\"\n    def compute(self, d: dict) -> int:\n        if not isinstance(d, dict):\n            raise TypeError(\"Input must be a dictionary.\")\n\n        max_child_depth = 0\n        for value in d.values():\n            if isinstance(value, dict):\n                child_depth = self.compute(value)\n                if child_depth > max_child_depth:\n                    max_child_depth = child_depth\n        return 1 + max_child_depth\ndef dict_depth(d: dict) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of a dictionary.\n    The top-level dictionary counts as depth 1.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"dict_depth expects a dict as single argument\")\n    return DictDepthFunction().compute(d)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries: list) -> tuple:\n    \"\"\"Groups entries by name, sums their values, and returns the name with the maximal sum.\"\"\"\n    from collections import defaultdict\n\n    name_sums = defaultdict(float)\n    for name, value in entries:\n        name_sums[name] += float(value)\n\n    # Find the name-sum pair with the largest aggregate sum.\n    max_name, max_sum = max(name_sums.items(), key=lambda item: item[1])\n\n    # Return integer if the sum is a whole number, otherwise float, to match example.\n    return (max_name, int(max_sum) if max_sum.is_integer() else max_sum)"}
