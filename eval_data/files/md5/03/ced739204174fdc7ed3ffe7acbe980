{"task_id": "Mbpp/308", "solution": "from dataclasses import dataclass\nfrom typing import List, Iterator, Union\nNumber = Union[int, float]\ndef _compute_pairwise_products(input_a: InputList, input_b: InputList) -> List[PairwiseProduct]:\n    \"\"\"Computes all pairwise products from two input lists.\"\"\"\n    pairwise_products = []\n    for a in input_a:\n        for b in input_b:\n            pairwise_products.append(PairwiseProduct(factor_a=a, factor_b=b))\n    return pairwise_products\ndef _select_top_k(products: List[PairwiseProduct], k: int) -> ResultList:\n    \"\"\"Sorts products and selects the top k, or all if k is greater than total products.\"\"\"\n    products.sort(key=lambda p: p.product, reverse=True)\n    \n    top_k_numeric_list = [p.product for p in products]\n\n    if k < len(top_k_numeric_list):\n        top_k_numeric_list = top_k_numeric_list[:k]\n    \n    return ResultList(products=top_k_numeric_list, k=k)\ndef large_product(list_a: List[Number], list_b: List[Number], k: int) -> List[Number]:\n    \"\"\"Compute pairwise products of elements from list_a and list_b and return k largest products in descending order.\"\"\"\n    input_a = InputList(list_a)\n    input_b = InputList(list_b)\n    \n    pairwise_products = _compute_pairwise_products(input_a, input_b)\n    \n    result_list = _select_top_k(pairwise_products, k)\n    \n    return result_list.get_top_k()"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple, Optional\nclass ResultTuple:\n    \"\"\"Container for two words to be returned as a tuple.\"\"\"\n    def __init__(self, first: str, second: str) -> None:\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> Tuple[str, str]:\n        \"\"\"Returns the stored words as a string tuple.\"\"\"\n        return (self.first, self.second)\nclass Word:\n    \"\"\"Represents a single word token and can check if it starts with 'p'.\"\"\"\n    def __init__(self, text: str, position: int) -> None:\n        self.text = text\n        self.position = position\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' in a case-insensitive manner.\"\"\"\n        return len(self.text) > 0 and self.text[0].lower() == 'p'\nclass ListElement:\n    \"\"\"Represents an input string element, tokenized into Word objects.\"\"\"\n    def __init__(self, content: str, index: int) -> None:\n        self.content = content\n        self.index = index\n        self.words: List[Word] = []\n\n    def tokenize(self) -> List[Word]:\n        \"\"\"Splits the content into words based on whitespace and stores them.\"\"\"\n        tokens = self.content.split()\n        self.words = [Word(token, i) for i, token in enumerate(tokens)]\n        return self.words\nclass StartWithPFunction:\n    \"\"\"Orchestrates parsing of the input list and finding a matching pair of words.\"\"\"\n    def __init__(self, input_list: List[str]) -> None:\n        self.input_list = input_list\n\n    def execute(self) -> Optional[Tuple[str, str]]:\n        \"\"\"Parses elements and finds the first element with two 'p' words.\"\"\"\n        elements = self.parse_elements()\n        return self.find_matching_pair(elements)\n\n    def parse_elements(self) -> List[ListElement]:\n        \"\"\"Creates ListElement objects from the input list and tokenizes them.\"\"\"\n        elements = []\n        for i, content in enumerate(self.input_list):\n            element = ListElement(content, i)\n            element.tokenize()\n            elements.append(element)\n        return elements\n\n    def find_matching_pair(self, elements: List[ListElement]) -> Optional[Tuple[str, str]]:\n        \"\"\"Iterates through elements to find one with exactly two words, both starting with 'p'.\"\"\"\n        for element in elements:\n            if len(element.words) == 2:\n                word1 = element.words[0]\n                word2 = element.words[1]\n                if word1.starts_with_p() and word2.starts_with_p():\n                    result = ResultTuple(word1.text, word2.text)\n                    return result.as_tuple()\n        return None\ndef start_withp(input_list: List[str]) -> Optional[Tuple[str, str]]:\n    \"\"\"Public API: finds two words from a list of words starting with 'p'.\n    Returns None if no matching element is found as per design decision.\"\"\"\n    processor = StartWithPFunction(input_list)\n    return processor.execute()"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"Convert input string to a tuple of characters excluding ASCII spaces (' ').\n\n    Raises:\n        TypeError: if s is not a str\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"string_to_tuple requires a str argument\")\n    s_no_spaces = s.replace(' ', '')\n    if s_no_spaces == '':\n        return ()\n    return tuple(s_no_spaces)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that includes arr[k] as its last element, where k > i.\n    \"\"\"\n    from typing import List\n\n    class ValidationError(Exception):\n        \"\"\"\n        Custom exception for input validation errors.\n        \"\"\"\n        pass\n\n    def _validate_inputs(arr: List[int], n: int, i: int, k: int) -> None:\n        if n != len(arr):\n            raise ValidationError(\"n must be equal to len(arr)\")\n        if not (0 <= i < n):\n            raise ValidationError(\"i is out of valid range [0, n-1]\")\n        if not (0 <= k < n):\n            raise ValidationError(\"k is out of valid range [0, n-1]\")\n        if k <= i:\n            raise ValidationError(\"k must be greater than i\")\n\n    def _compute_prefix_best_sums(arr: List[int], i: int) -> List[int]:\n        if i < 0:\n            return []\n\n        best_sums = [0] * (i + 1)\n        for j in range(i + 1):\n            current_val = arr[j]\n            max_prev_sum = 0\n            for t in range(j):\n                if arr[t] < current_val:\n                    max_prev_sum = max(max_prev_sum, best_sums[t])\n            best_sums[j] = current_val + max_prev_sum\n        return best_sums\n\n    _validate_inputs(arr, n, i, k)\n\n    prefix_best_sums = _compute_prefix_best_sums(arr, i)\n\n    max_prefix_sum_candidate = -1\n    found_candidate = False\n\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum_candidate = max(max_prefix_sum_candidate, prefix_best_sums[j])\n            found_candidate = True\n    \n    if not found_candidate:\n        return arr[k]\n    else:\n        return max_prefix_sum_candidate + arr[k]"}
{"task_id": "Mbpp/388", "solution": "def _compute_by_bits(n):\n    \"\"\"Compute the largest power of two less than or equal to n using bit operations.\"\"\"\n    # This leverages n.bit_length() which returns the number of bits required to represent n.\n    # The highest power of 2 less than or equal to n is 2^(n.bit_length() - 1).\n    return 1 << (n.bit_length() - 1)\ndef highest_Power_of_2(n):\n    \"\"\"Find the highest power of 2 that is less than or equal to n.\n    Raises ValueError for non-integer or non-positive inputs.\n    \"\"\"\n    _validate_integer_positive(n)\n    return _compute_by_bits(n)"}
{"task_id": "Mbpp/312", "solution": "import math\nimport datetime\nfrom typing import Optional\nclass CalculationResult:\n    \"\"\"Encapsulates computed volume, optional unit, and timestamp.\"\"\"\n    def __init__(self, volume: float, unit: Optional[str] = None, computedAt: Optional[datetime.datetime] = None) -> None:\n        self.volume = float(volume)\n        self.unit = unit\n        self.computedAt = computedAt if computedAt is not None else datetime.datetime.now(datetime.timezone.utc)\nclass MathConstants:\n    \"\"\"Provides mathematical constants like PI.\"\"\"\n    PI: float = math.pi\nclass VolumeCalculator:\n    \"\"\"Delegates computation of cone volume.\"\"\"\n    def _compute(self, radius: float, height: float) -> CalculationResult:\n        \"\"\"\n        Computes the volume of a cone using the given radius and height.\n        Returns a CalculationResult object.\n        \"\"\"\n        volume = (MathConstants.PI * radius**2 * height) / 3\n        return CalculationResult(volume, computedAt=datetime.datetime.now(datetime.timezone.utc))\n\n    def volume_cone(self, radius, height) -> float:\n        \"\"\"\n        Orchestrates the computation of cone volume.\n        Relies on Python's intrinsic type handling for input errors.\n        \"\"\"\n        result = self._compute(radius, height)\n        return result.volume\ndef volume_cone(radius, height) -> float:\n    \"\"\"\n    Computes the volume of a cone given its radius and height.\n    Delegates to VolumeCalculator for computation, returning a float.\n    \"\"\"\n    calculator = VolumeCalculator()\n    return calculator.volume_cone(radius, height)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the left-most unset bit in the given non-negative integer n.\n    Handles n=0 and cases where all bits up to bit_length are already set.\"\"\"\n    \n    if n == 0:\n        return 1\n\n    bit_len = n.bit_length()\n    # Iterate from the most significant bit down to 0 to find the first unset bit.\n    for i in range(bit_len - 1, -1, -1):\n        if not ((n >> i) & 1):  # If the bit at index i is 0 (unset)\n            return n | (1 << i) # Set this bit and return\n\n    # If the loop completes, all bits from 0 to bit_len-1 are set (n is all ones).\n    # In this case, set the bit at the next higher index (bit_len).\n    return n | (1 << bit_len)"}
{"task_id": "Mbpp/389", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, code: str, message: str):\n        super().__init__(message)\n        self.code = code\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates input for Lucas number computation.\"\"\"\n    def is_valid(self, n) -> bool:\n        return isinstance(n, int) and n >= 0\n\n    def validate(self, n) -> None:\n        \"\"\"Validates that n is a non-negative integer, raises InvalidInputError otherwise.\"\"\"\n        if not self.is_valid(n):\n            raise InvalidInputError('INVALID_INPUT', 'Input n must be a non-negative integer.')\nclass LucasCalculator:\n    \"\"\"Computes Lucas numbers.\"\"\"\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the nth Lucas number using an iterative method.\"\"\"\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n\n        a, b = 2, 1  # Represents L(0) and L(1)\n        for _ in range(2, n + 1):\n            next_lucas = a + b\n            a = b\n            b = next_lucas\n        return b\ndef find_lucas(n) -> int:\n    \"\"\"Validate and compute nth Lucas number; raises InvalidInputError on invalid input.\"\"\"\n    validator = InputValidator()\n    calculator = LucasCalculator()\n\n    validator.validate(n)\n\n    return calculator.compute_iterative(n)"}
{"task_id": "Mbpp/390", "solution": "def add_string(input_list: list, format_string: str) -> list:\n    \"\"\"Apply format_string to each element in input_list and return a new list of strings.\n    Converts non-string elements to str(element) before formatting, and returns [] for empty input_list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    for element in input_list:\n        str_value = str(element)\n        formatted = format_string.format(str_value)\n        result.append(formatted)\n    return result"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(listA, listB, listC):\n    \"\"\"\n    Accepts three lists (listA, listB, listC) and returns a list of nested dictionaries\n    [{listA[0]: {listB[0]: listC[0]}}, ...].\n    \"\"\"\n    result = []\n    for a, b, c in zip(listA, listB, listC):\n        result.append({a: {b: c}})\n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Public API to find the maximum sum possible by using the given equation\n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    from typing import Callable\n\n    class MemoCache:\n        def __init__(self):\n            self.cache = {}\n\n        def contains(self, n: int) -> bool:\n            return n in self.cache\n\n        def get(self, n: int) -> int:\n            return self.cache[n]\n\n        def set(self, n: int, value: int) -> None:\n            self.cache[n] = value\n\n    class RecurrenceFunction:\n        def evaluate(self, n: int, compute_callback: Callable[[int], int]) -> int:\n            \"\"\"\n            Computes the sum of subproblems (n/2, n/3, n/4, n/5) using the provided callback\n            and returns the maximum of this sum or n.\n            \"\"\"\n            sub_n2 = n // 2\n            sub_n3 = n // 3\n            sub_n4 = n // 4\n            sub_n5 = n // 5\n\n            sum_subs = (\n                compute_callback(sub_n2) +\n                compute_callback(sub_n3) +\n                compute_callback(sub_n4) +\n                compute_callback(sub_n5)\n            )\n            return max(sum_subs, n)\n\n    class GetMaxSum:\n        def __init__(self, cache: MemoCache = None):\n            self._cache = cache if cache is not None else MemoCache()\n            self._recurrence = RecurrenceFunction()\n\n        def compute(self, n: int) -> int:\n            \"\"\"\n            Public entry point to compute f(n), handling base cases, initial cache checks,\n            and delegating to the recursive evaluation mechanism.\n            \"\"\"\n            # Base-case: return n for n <= 1 as per design.\n            if n <= 1:\n                return n\n\n            # Check cache for a memoized result for 'n'.\n            if self._cache.contains(n):\n                return self._cache.get(n)\n            \n            # If not in cache, initiate the recursive computation via computeRecursive.\n            result = self.computeRecursive(n)\n            self._cache.set(n, result) # Store computed result in the cache.\n            return result\n\n        def computeRecursive(self, n: int) -> int:\n            \"\"\"\n            Internal recursive method that performs recurrence evaluation using RecurrenceFunction and cache checks.\n            This method is passed as a callback to RecurrenceFunction.evaluate for subproblem computation.\n            \"\"\"\n            # Base case: return n for n <= 1 to ensure termination.\n            if n <= 1:\n                return n\n\n            # Check cache for a memoized result for 'n'.\n            if self._cache.contains(n):\n                return self._cache.get(n)\n            \n            # If not in cache, compute the value for 'n' using the recurrence relation.\n            # The recurrence function, in turn, calls 'self.computeRecursive' for its subproblems.\n            computed_value = self._recurrence.evaluate(n, self.computeRecursive)\n            self._cache.set(n, computed_value) # Cache the newly computed value.\n            return computed_value\n\n    # Instantiate the orchestrator and compute the sum using its public method.\n    calculator = GetMaxSum()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/394", "solution": "from dataclasses import dataclass\ndef check_distinct(input_tuple: tuple) -> bool:\n    \"\"\"Return True when input_tuple contains no duplicate elements; otherwise False.\n\n    Args:\n      input_tuple (tuple): the tuple to check (requirement FR1)\n\n    Returns:\n      bool: True if all elements distinct (FR2), False if any duplicates (FR3).\n    \"\"\"\n    # For traceability, construct TupleValue\n    _ = TupleValue(elements=input_tuple)\n\n    is_distinct = len(set(input_tuple)) == len(input_tuple)\n\n    # For traceability, construct Result\n    _ = Result(value=is_distinct)\n\n    return is_distinct"}
{"task_id": "Mbpp/398", "solution": "from typing import List, Iterator\nclass Digit:\n    \"\"\"Value object representing a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass IntegerNumber:\n    \"\"\"Represents a single integer and extracts its decimal digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> List[Digit]:\n        \"\"\"Returns a list of Digit objects for the integer's decimal digits.\"\"\"\n        s_value = str(self.value)\n        return [Digit(int(char)) for char in s_value]\nclass IntegerList:\n    \"\"\"Represents an input collection of integers and provides iteration.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Allows iteration over the integer values.\"\"\"\n        return iter(self.values)\nclass SumOfDigitsFunction:\n    \"\"\"Orchestrates the computation of the total sum of decimal digits for an input list.\"\"\"\n    def sum_of_digits(self, numbers: List[int]) -> int:\n        \"\"\"Computes the total sum of decimal digits from a list of integers.\"\"\"\n        integer_list = IntegerList(numbers)\n        total_sum = 0\n        for num_value in integer_list:\n            integer_number = IntegerNumber(num_value)\n            for digit_obj in integer_number.digits():\n                total_sum += digit_obj.value\n        return total_sum\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Public API: Accepts a list of integers and returns the sum of their decimal digits.\"\"\"\n    calculator = SumOfDigitsFunction()\n    return calculator.sum_of_digits(numbers)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict\nclass StringInput:\n    \"\"\"Represents the input string and provides length information.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass CharacterFrequencyMap:\n    \"\"\"Builds and holds per-character frequency counts.\"\"\"\n    def __init__(self):\n        self.frequencies: Dict[str, int] = {}\n\n    def build_from(self, input: StringInput) -> None:\n        for char in input.value:\n            self.frequencies[char] = self.frequencies.get(char, 0) + 1\n\n    def get_count(self, ch: str) -> int:\n        return self.frequencies.get(ch, 0)\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no such character exists.\n    \"\"\"\n    input_obj = StringInput(s)\n    freq_map = CharacterFrequencyMap()\n    freq_map.build_from(input_obj)\n\n    for ch in input_obj.value:\n        if freq_map.get_count(ch) == 1:\n            return ch\n            \n    return None"}
