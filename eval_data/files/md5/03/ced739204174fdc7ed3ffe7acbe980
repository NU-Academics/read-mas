{"task_id": "Mbpp/419", "solution": "import sys\nfrom typing import List, Iterator, Union\nclass Printer:\n    \"\"\"Responsibility: Print the Result.value to standard output.\"\"\"\n    def print(self, result) -> None:\n        sys.stdout.write(str(result.value) + \"\\n\")\nclass RoundedNumber:\n    \"\"\"Responsibility: Represent integer result of rounding a Number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Number:\n    \"\"\"Responsibility: Wrap a numeric input value and provide numeric-checking and rounding operation.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"List elements must be numeric (int or float).\")\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the wrapped value is numeric.\"\"\"\n        return isinstance(self.value, (int, float))\n\n    def round_half_to_even(self) -> RoundedNumber:\n        \"\"\"Performs deterministic tie-to-even rounding.\"\"\"\n        rounded_val = round(self.value)\n        return RoundedNumber(rounded_val)\nclass InputList:\n    \"\"\"Responsibility: Represent and validate the input list of numbers; construct Number wrappers.\"\"\"\n    def __init__(self, raw_list: List[Union[int, float]]):\n        if not isinstance(raw_list, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n        self.elements: List[Number] = []\n        for item in raw_list:\n            # Number constructor handles type validation for individual elements\n            self.elements.append(Number(item))\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def __iter__(self) -> Iterator[Number]:\n        \"\"\"Provides an iterator over the Number elements.\"\"\"\n        return iter(self.elements)\nclass Result:\n    \"\"\"Responsibility: Represent the final integer result (sumRounded * length).\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass RoundAndSumFunction:\n    \"\"\"Responsibility: Encapsulates main computation pipeline.\"\"\"\n    def compute(self, input_list: InputList) -> Result:\n        total_rounded_sum = 0\n        for number_wrapper in input_list:\n            rounded_num = number_wrapper.round_half_to_even()\n            total_rounded_sum += rounded_num.value\n\n        list_length = input_list.length()\n        final_value = total_rounded_sum * list_length\n        return Result(final_value)\ndef round_and_sum(numbers: List[Union[int, float]]) -> int:\n    \"\"\"\n    Rounds every number of a given list of numbers and prints the total sum multiplied by the length of the list.\n    \"\"\"\n    # 1. Validate input and wrap in InputList\n    input_list = InputList(numbers)\n\n    # Handle empty list explicitly\n    if input_list.length() == 0:\n        result = Result(0)\n        printer = Printer()\n        printer.print(result)\n        return result.value\n\n    # 2. Compute the result\n    computer = RoundAndSumFunction()\n    result = computer.compute(input_list)\n\n    # 3. Print the result\n    printer = Printer()\n    printer.print(result)\n\n    # 4. Return the integer value\n    return result.value"}
