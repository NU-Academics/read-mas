{"task_id": "Mbpp/8", "solution": "def square_nums(input_list: list) -> list:\n    \"\"\"\n    Accepts: input_list - a list (sequence) of numeric elements (int/float).\n    Returns: a new list where each element is input_list[i] * input_list[i], order preserved.\n    \"\"\"\n    return [x * x for x in input_list]"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Return True if n is not prime, False if n is prime.\n\n    Prime numbers are natural numbers greater than 1 that have no positive divisors other than 1 and themselves.\n    \"\"\"\n    if n <= 1:\n        return True  # Numbers less than or equal to 1 are not prime\n    if n == 2:\n        return False # 2 is prime\n    if n % 2 == 0:\n        return True  # Even numbers greater than 2 are not prime\n\n    # Check for odd divisors from 3 up to the square root of n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return True\n        i += 2\n    return False # If no divisors found, n is prime"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b) -> bool:\n    \"\"\"Return True iff integers a and b differ in exactly one bit position.\n\n    Behavior per SRS/BR-5: Compute x = a ^ b; return True iff x != 0 and (x & (x - 1)) == 0.\n    \"\"\"\n    x = a ^ b\n    return x != 0 and (x & (x - 1)) == 0"}
{"task_id": "Mbpp/2", "solution": "from dataclasses import dataclass\nfrom typing import Any, List, Sequence, Set\nclass ValidationError(Exception):\n    \"\"\"Exception indicating an input validation failure.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\ndef _validate_input(seq) -> InputSequence:\n    \"\"\"Validates if the input sequence is a list or tuple and returns an InputSequence.\"\"\"\n    if not isinstance(seq, (list, tuple)):\n        raise ValidationError(\"Input must be a list or a tuple.\")\n    return InputSequence(seq_type=type(seq).__name__, elements=list(seq))\ndef _compute_intersection(is1: InputSequence, is2: InputSequence) -> Set[Any]:\n    \"\"\"Computes the set intersection of elements from two InputSequence objects.\"\"\"\n    return set(is1.elements) & set(is2.elements)\ndef _build_result_collection(shared_values: Set[Any]) -> ResultCollection:\n    \"\"\"Converts a set of shared values into a ResultCollection.\"\"\"\n    return ResultCollection(elements=list(shared_values))\ndef similar_elements(seq1, seq2) -> list:\n    \"\"\"\n    Finds shared elements from two sequences, returning a deduplicated list.\n    Raises ValidationError if inputs are not lists or tuples.\n    \"\"\"\n    input_seq1 = _validate_input(seq1)\n    input_seq2 = _validate_input(seq2)\n    shared_set = _compute_intersection(input_seq1, input_seq2)\n    result_collection = _build_result_collection(shared_set)\n    return result_collection.elements"}
{"task_id": "Mbpp/4", "solution": "from typing import List\nimport heapq\nfrom dataclasses import dataclass\nclass Heap:\n    \"\"\"Minimal min-heap wrapper to maintain a heap of size up to n.\"\"\"\n    def __init__(self) -> None:\n        self._store: List[IntegerElement] = []\n\n    def push(self, value: int) -> None:\n        heapq.heappush(self._store, IntegerElement(value))\n\n    def pop(self) -> int:\n        if not self._store:\n            raise IndexError(\"pop from an empty heap\")\n        return heapq.heappop(self._store).value\n\n    def peek(self) -> int:\n        if not self._store:\n            raise IndexError(\"peek from an empty heap\")\n        return self._store[0].value\n\n    def size(self) -> int:\n        return len(self._store)\nclass HeapQueueLargest:\n    \"\"\"Encapsulates validation and computation logic for top-n selection.\"\"\"\n    def __init__(self, input_list: List[int], n: int) -> None:\n        self._input_list = input_list\n        self._n = n\n        self._result: List[int] = []\n\n    def validate(self) -> None:\n        \"\"\"Validates inputs per BR6 and BR10. (Error raising logic omitted as per prompt constraint).\"\"\"\n        pass # Per prompt instruction, actual error raising for invalid types is omitted here.\n\n    def compute(self) -> List[int]:\n        \"\"\"Computes and returns the top-n list in descending order.\"\"\"\n        if self._n <= 0:\n            return []\n\n        if self._n > len(self._input_list):\n            # If n is strictly larger than list length, return all elements sorted descending.\n            return sorted(self._input_list, reverse=True)\n\n        # For 0 < n <= len(list): use a min-heap to find the n largest elements.\n        min_heap = Heap()\n        for item in self._input_list:\n            min_heap.push(item)\n            if min_heap.size() > self._n:\n                min_heap.pop()\n\n        # Extract elements from the heap, they will be in ascending order.\n        self._result = [min_heap.pop() for _ in range(min_heap.size())]\n        # Sort in descending order to match requirement.\n        self._result.sort(reverse=True)\n\n        return self._result\ndef heap_queue_largest(list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n    service = HeapQueueLargest(list, n)\n    service.validate() # As per design, a validation method is called.\n    return service.compute()"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive number of rotations required to get the same string.\n    A rotation by k is defined as s[k:] + s[:k].\n    \"\"\"\n    n = len(s)\n    for k in range(1, n + 1):\n        rotated_s = s[k:] + s[:k]\n        if rotated_s == s:\n            return k\n    # This line should theoretically not be reached as k=n will always result in the original string.\n    return n"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(s):\n    \"\"\"\n    Finds all words at least 4 characters long in a string, preserving case and order.\n    \"\"\"\n    return [word for word in s.split() if len(word) >= 4]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Raises ValueError if ch is not a single-character string.\n    \"\"\"\n    if not isinstance(ch, str) or len(ch) != 1:\n        raise ValueError(\"ch must be a single-character string\")\n\n    count = input_string.count(ch)\n\n    if count == 0:\n        return input_string\n    elif count == 1:\n        idx = input_string.find(ch)\n        return input_string[:idx] + input_string[idx+1:]\n    else: # count >= 2\n        idx_first = input_string.find(ch)\n        idx_last = input_string.rfind(ch)\n        return input_string[:idx_first] + input_string[idx_first+1:idx_last] + input_string[idx_last+1:]"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix (list of lists) in ascending order based on the sum of its rows.\n    \"\"\"\n    def _row_sum(row):\n        \"\"\"\n        Computes the arithmetic sum of elements in a given row.\n        \"\"\"\n        return sum(row)\n\n    # Use sorted with a lambda key that computes the sum of each row\n    # Python's Timsort (used by sorted()) is a stable sort.\n    return sorted(matrix, key=_row_sum)"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length):\n    \"\"\"Return numeric perimeter of square for given side_length. Computes 4 * side_length.\"\"\"\n    class Square:\n        \"\"\"Represents a square with a given side length and computes its perimeter.\"\"\"\n        def __init__(self, side_length):\n            self.side_length = side_length\n        def perimeter(self):\n            return 4 * self.side_length\n\n    s = Square(side_length)\n    return s.perimeter()"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Pattern\n_EXPRESSION: str = r\"[a-z]+_[a-z]+\"\n_PATTERN: Pattern = re.compile(_EXPRESSION, flags=re.ASCII)\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"Return True if input contains at least one substring matching [a-z]+_[a-z]+ (ASCII lowercase only).\n    The function does not modify the input string.\"\"\"\n    if not input:\n        return False\n    return _PATTERN.search(input) is not None"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Uses a private helper to reverse the integer.\n    \"\"\"\n    def _reverse_integer(num: int) -> int:\n        \"\"\"\n        Reverses the decimal digits of an integer, dropping leading zeros.\n        \"\"\"\n        return int(str(num)[::-1])\n\n    reversed_n = _reverse_integer(n)\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"Return True if arr contains at least one duplicate integer, otherwise False.\n\n    Boundary behavior (per SRS): empty list and single-element list return False.\n    \"\"\"\n    seen = set()\n    for x in arr:\n        if x in seen:\n            return True\n        seen.add(x)\n    return False"}
{"task_id": "Mbpp/14", "solution": "class Validator:\n    \"\"\"Validates inputs for numeric type and non-negativity.\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Checks if a value is numeric (int or float, excluding bool).\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def isNonNegative(self, value: float) -> bool:\n        \"\"\"Checks if a numeric value is non-negative.\"\"\"\n        return value >= 0\n\n    def validate_inputs(self, base, triangle_height, length) -> None:\n        \"\"\"Validates all inputs, raising TypeError or ValueError for invalid inputs.\"\"\"\n        inputs = {'base': base, 'triangle_height': triangle_height, 'length': length}\n        for name, value in inputs.items():\n            if not self.isNumeric(value):\n                raise TypeError(f\"Input '{name}' must be a numeric value (int or float). Got {type(value).__name__}.\")\n            if not self.isNonNegative(value):\n                raise ValueError(f\"Input '{name}' must be a non-negative value. Got {value}.\")\nclass VolumeCalculator:\n    \"\"\"Performs the arithmetic calculations for base area and prism volume.\"\"\"\n    def calculateBaseArea(self, base: float, triangle_height: float) -> float:\n        \"\"\"Calculates the area of the triangular base.\"\"\"\n        return 0.5 * base * triangle_height\n\n    def calculateVolume(self, base: float, triangle_height: float, length: float) -> float:\n        \"\"\"Calculates the volume of the triangular prism.\"\"\"\n        base_area = self.calculateBaseArea(base, triangle_height)\n        return base_area * length\ndef find_Volume(base, triangle_height, length):\n    \"\"\"\n    Public API for calculating the volume of a triangular prism.\n    Raises TypeError for non-numeric inputs and ValueError for negative inputs.\n    \"\"\"\n    validator = Validator()\n    validator.validate_inputs(base, triangle_height, length)\n    calculator = VolumeCalculator()\n    return calculator.calculateVolume(base, triangle_height, length)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number n is defined by n = k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    if n < 1:\n        return False\n\n    k = 1\n    while True:\n        candidate_value = k * (2**k) - 1\n        if candidate_value == n:\n            return True\n        elif candidate_value > n:\n            return False\n        k += 1"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, remove_chars: str) -> str:\n    \"\"\"Removes characters from the source string that are present in the remove_chars string.\n    Preserves the order of remaining characters and performs case-sensitive matching.\n    \"\"\"\n    # Create a set of characters to be removed for efficient O(1) lookup during iteration.\n    chars_to_remove = set(remove_chars)\n\n    # Build the result string by appending characters that are not in the removal set.\n    result_chars = []\n    for char in source:\n        if char not in chars_to_remove:\n            result_chars.append(char)\n\n    # Join the collected characters to form the final string.\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/57", "solution": "from typing import Sequence, List\ndef find_Max_Num(digits: Sequence[int]) -> int:\n    \"\"\"Public API per SRS: accept a list of digits and return the largest integer that can be formed.\"\"\"\n    ordered = _order_digits_desc(digits)\n    concatenated = _concatenate_digits(ordered)\n    return _convert_to_int(concatenated)\ndef _order_digits_desc(digits: Sequence[int]) -> List[int]:\n    \"\"\"Return a new list with digits sorted in descending numeric order.\"\"\"\n    return sorted(digits, reverse=True)\ndef _concatenate_digits(ordered_digits: Sequence[int]) -> str:\n    \"\"\"Concatenate the ordered digits into a string representation.\"\"\"\n    return \"\".join(str(d) for d in ordered_digits)\ndef _convert_to_int(concatenated_str: str) -> int:\n    \"\"\"Convert the concatenated string to an int and return it.\"\"\"\n    return int(concatenated_str)"}
