{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple):\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by decimal concatenation.\n    Raises ValueError if the tuple is empty or contains non-positive/non-integer elements.\n    \"\"\"\n\n    def _validate_element(value):\n        \"\"\"Checks if a value is a positive integer.\"\"\"\n        return isinstance(value, int) and value > 0\n\n    def _concatenate_elements(elements):\n        \"\"\"Concatenates decimal representations of integers into a single integer.\"\"\"\n        return int(\"\".join(str(e) for e in elements))\n\n    if not input_tuple:\n        raise ValueError(\"Input tuple cannot be empty.\")\n\n    for element in input_tuple:\n        if not _validate_element(element):\n            if not isinstance(element, int):\n                raise ValueError(f\"Tuple element '{element}' is not an integer.\")\n            else:\n                raise ValueError(f\"Tuple element '{element}' is not a positive integer.\")\n\n    return _concatenate_elements(input_tuple)"}
{"task_id": "Mbpp/119", "solution": "from typing import List\ndef search(nums: List[int]) -> int:\n    \"\"\"Return the unique integer that appears once in a sorted list where every other element appears twice.\n\n    Preconditions (assumed): nums is sorted in non-decreasing order and contains exactly one element that appears once; all other distinct elements appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        if mid % 2 == 0:  # mid is an even index\n            if nums[mid] == nums[mid + 1]:\n                # The pair is correctly formed, unique element is to the right\n                low = mid + 2\n            else:\n                # The unique element is at mid or to its left (mid is the first of a non-pair or the unique itself)\n                high = mid\n        else:  # mid is an odd index\n            if nums[mid] == nums[mid - 1]:\n                # The pair is correctly formed, unique element is to the right\n                low = mid + 1\n            else:\n                # The unique element is at mid or to its left (mid is the second of a non-pair or the unique itself)\n                high = mid - 1\n    \n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs: Sequence[Tuple[float, float]]) -> float:\n    \"\"\"\n    Calculates the maximum absolute product from pairs of numbers within a list of tuples.\n    Returns float('-inf') if the input list is empty, as specified by design notes for unspecified behavior.\n    \"\"\"\n    import math\n\n    max_abs_product = float('-inf')\n\n    for a, b in pairs:\n        current_product = math.fabs(a * b)\n        if current_product > max_abs_product:\n            max_abs_product = current_product\n\n    return max_abs_product"}
