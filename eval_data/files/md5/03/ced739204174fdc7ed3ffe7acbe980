{"task_id": "Mbpp/68", "solution": "from dataclasses import dataclass\nfrom typing import List, Any, Optional\nfrom datetime import datetime\nclass MonotonicChecker:\n    def is_Monotonic(self, arr_list: list) -> bool:\n        \"\"\"Return True iff arr is monotonic (non-increasing or non-decreasing), equality allowed.\"\"\"\n        arr = Array(arr_list)\n\n        if len(arr) <= 1:\n            return True\n\n        is_non_decreasing = True\n        is_non_increasing = True\n\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i-1]:\n                is_non_decreasing = False\n            if arr[i] > arr[i-1]:\n                is_non_increasing = False\n            \n            if not is_non_decreasing and not is_non_increasing:\n                return False\n                \n        return is_non_decreasing or is_non_increasing\ndef is_Monotonic(arr):\n    \"\"\"Public API: return True if arr is monotonic (non-increasing or non-decreasing), equality allowed.\"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(arr)"}
{"task_id": "Mbpp/71", "solution": "class NonComparableElementsError(Exception):\n    \"\"\"\n    Exception raised when elements in the list are not mutually comparable.\n    \"\"\"\n    pass\nclass CombSortFunction:\n    \"\"\"\n    Encapsulates the Comb Sort algorithm logic with configurable parameters.\n    \"\"\"\n    def __init__(self, shrinkFactor: float = 1.3) -> None:\n        \"\"\"\n        Initializes the CombSortFunction with a specified shrink factor (default 1.3).\n        \"\"\"\n        self.shrinkFactor = shrinkFactor\n\n    def sort(self, items: list) -> list:\n        \"\"\"\n        Sorts a list of elements using the Comb Sort algorithm and returns a new sorted list.\n        \"\"\"\n        n = len(items)\n        if n <= 1:\n            return items[:]\n\n        arr = items[:]  # Work on a copy of the input list\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            if gap > 1:\n                gap = int(gap / self.shrinkFactor)\n                if gap < 1: # Ensure gap doesn't become 0 before the final bubble pass\n                    gap = 1\n\n            swapped = False\n            for i in range(n - gap):\n                try:\n                    if arr[i] > arr[i + gap]:\n                        arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                        swapped = True\n                except TypeError as e:\n                    raise NonComparableElementsError(\n                        f\"Elements are not mutually comparable: {e}\"\n                    )\n        return arr\ndef comb_sort(list: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the Comb Sort algorithm.\n    Returns a new sorted list; raises NonComparableElementsError for incompatible types.\n    \"\"\"\n    sorter = CombSortFunction()\n    return sorter.sort(list)"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq, pattern):\n    \"\"\"\n    Checks if a sequence follows the pattern given, requiring a one-to-one mapping.\n    Ensures that values in `seq` correspond bijectively to values in `pattern`.\n    \"\"\"\n    list_seq = list(seq)\n    list_pattern = list(pattern)\n\n    if len(list_seq) != len(list_pattern):\n        return False\n\n    pattern_to_seq = {}\n    seq_to_pattern = {}\n\n    for i in range(len(list_seq)):\n        s_val = list_seq[i]\n        p_val = list_pattern[i]\n\n        if p_val in pattern_to_seq:\n            if pattern_to_seq[p_val] != s_val:\n                return False\n        else:\n            if s_val in seq_to_pattern:\n                # This means s_val is already mapped to a different p_val, breaking bijection.\n                return False\n            \n            pattern_to_seq[p_val] = s_val\n            seq_to_pattern[s_val] = p_val\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples, k):\n    \"\"\"\n    Find tuples where all elements are divisible by k from the given list of tuples.\n    \"\"\"\n    result = []\n    for current_tuple in list_of_tuples:\n        all_elements_divisible = True\n        for element in current_tuple:\n            # Assumes k is non-zero and element is an integer per problem constraints.\n            if element % k != 0:\n                all_elements_divisible = False\n                break\n        if all_elements_divisible:\n            result.append(current_tuple)\n    return result"}
{"task_id": "Mbpp/79", "solution": "def word_len(word: str) -> bool:\n    \"\"\"Public API: returns True if len(word) is odd, False otherwise.\"\"\"\n    class Word:\n        def __init__(self, text: str) -> None:\n            self.text: str = text\n        def length(self) -> int:\n            return len(self.text)\n\n    class WordLengthChecker:\n        def word_len(self, word: str) -> bool:\n            if not isinstance(word, str):\n                raise TypeError(\"word must be a str\")\n            w = Word(word)\n            return (w.length() % 2) == 1\n\n    return WordLengthChecker().word_len(word)"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number) -> bool:\n    \"\"\"\n    Checks if an integer is divisible by 11 using the alternating-digit-sum algorithm.\n    Evaluates divisibility for the absolute value of the input number.\n    \"\"\"\n    num_abs = abs(number)\n    alternating_sum = 0\n    sign = 1  # Start with positive for the rightmost digit\n\n    while num_abs > 0:\n        digit = num_abs % 10\n        alternating_sum += sign * digit\n        num_abs //= 10\n        sign *= -1  # Alternate the sign\n\n    return alternating_sum % 11 == 0"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number using the formula T(n) = n*(n+1)*(n+2)/6.\n    The result is always an integer.\n    \"\"\"\n    class TetrahedralFunction:\n        \"\"\"Encapsulates the computation logic for tetrahedral numbers.\"\"\"\n        @staticmethod\n        def tetrahedral_number_calc(n_val: int) -> int:\n            \"\"\"Delegates to the formula computation.\"\"\"\n            return TetrahedralFunction.compute_formula(n_val)\n\n        @staticmethod\n        def compute_formula(n_val: int) -> int:\n            \"\"\"Computes the tetrahedral number using the direct formula.\"\"\"\n            return (n_val * (n_val + 1) * (n_val + 2)) // 6\n\n    return TetrahedralFunction.tetrahedral_number_calc(n)"}
{"task_id": "Mbpp/82", "solution": "import math\ndef volume_sphere(radius: float) -> float:\n    \"\"\"Calculate the volume of a sphere given its radius.\"\"\"\n    r_float = float(radius)\n    volume = (4.0 / 3.0) * math.pi * (r_float ** 3)\n    return volume"}
{"task_id": "Mbpp/84", "solution": "class NewmanConwaySequence:\n    \"\"\"\n    Encapsulates computation and caching for the Newman-Conway sequence.\n    It uses memoization to store already computed terms, avoiding redundant calculations.\n    \"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {1: 1, 2: 1}\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Compute and return the nth term (1-indexed) of the Newman-Conway sequence.\n        Raises ValueError if n is less than 1.\n        \"\"\"\n        if n < 1:\n            raise ValueError(\"n must be a positive integer (1-indexed).\")\n        if n in self._cache:\n            return self._cache[n]\n        \n        # If not in cache, compute recursively\n        return self._compute_recursive(n)\n\n    def _compute_recursive(self, n: int) -> int:\n        \"\"\"\n        Internal recursive computation with memoization.\n        This method calculates a(n) = a(a(n-1)) + a(n - a(n-1)) using cached values.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        # Calculate a(n) = a(a(n-1)) + a(n - a(n-1))\n        # Important: Call `self.compute` for subproblems to ensure memoization is used\n        a_n_minus_1 = self.compute(n - 1)\n        term1_index = a_n_minus_1\n        term2_index = n - a_n_minus_1\n\n        val = self.compute(term1_index) + self.compute(term2_index)\n        self._cache[n] = val\n        return val\n_newman_conway_calculator = NewmanConwaySequence()\ndef sequence(n: int) -> int:\n    \"\"\"\n    Find the nth number in the Newman-Conway sequence.\n    Delegates to an internal memoized calculator to perform the computation efficiently.\n    \"\"\"\n    return _newman_conway_calculator.compute(n)"}
{"task_id": "Mbpp/85", "solution": "import math\ndef compute_area(radius: float) -> float:\n    \"\"\"Internal computation implementing the formula 4 * pi * radius**2.\"\"\"\n    return 4.0 * math.pi * (radius ** 2)\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Public API for calculating the surface area of a sphere.\"\"\"\n    return compute_area(radius)"}
{"task_id": "Mbpp/86", "solution": "class ValidationError(Exception):\n    \"\"\"Domain-specific exception for validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass InputParameter:\n    \"\"\"Encapsulates and validates input parameter n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def isInteger(self) -> bool:\n        \"\"\"Checks if the input is an integer type.\"\"\"\n        return type(self.n) is int\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the integer input is positive (>= 1).\"\"\"\n        return self.n >= 1\n\n    def validated_value(self) -> int:\n        \"\"\"Performs combined validation and returns the integer value or raises ValidationError.\"\"\"\n        if not self.isInteger():\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if not self.isPositive():\n            raise ValidationError(\"Input 'n' must be greater than or equal to 1.\")\n        return int(self.n)\nclass CenteredHexagonalNumber:\n    \"\"\"Represents a computed centered hexagonal number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    @staticmethod\n    def from_n(n: int) -> 'CenteredHexagonalNumber':\n        \"\"\"Computes the nth centered hexagonal number.\"\"\"\n        value = 3 * n * (n - 1) + 1\n        return CenteredHexagonalNumber(value)\nclass CenteredHexagonalCalculator:\n    \"\"\"Encapsulates the workflow to validate input and compute the centered hexagonal number.\"\"\"\n    def centered_hexagonal_number(self, n: int) -> int:\n        \"\"\"Validates input n and computes the nth centered hexagonal number.\"\"\"\n        input_param = InputParameter(n)\n        validated_n = input_param.validated_value()\n        centered_hex_num = CenteredHexagonalNumber.from_n(validated_n)\n        return centered_hex_num.value\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth centered hexagonal number.\n\n    This function acts as a facade, orchestrating input validation and computation.\n    \"\"\"\n    calculator = CenteredHexagonalCalculator()\n    return calculator.centered_hexagonal_number(n)"}
{"task_id": "Mbpp/88", "solution": "def freq_count(input_list: list) -> dict:\n    \"\"\"Calculates the frequency of elements in a list.\n    Returns a dictionary where keys are elements and values are their counts.\"\"\"\n    frequency = {}\n    for element in input_list:\n        frequency[element] = frequency.get(element, 0) + 1\n    return frequency"}
{"task_id": "Mbpp/89", "solution": "from math import floor\ndef closest_num(n: float) -> int:\n    \"\"\"Return the largest integer strictly less than n.\n    Computation (BR3): f = floor(n); if f < n then return f else return f - 1.\n    \"\"\"\n    f = floor(n)\n    if f < n:\n        return int(f)\n    return int(f - 1)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict1, dict2, dict3):\n    \"\"\"Merges three dictionaries into a single dictionary, with 'first input wins' conflict resolution.\n    Keys and values are expected to be strings.\"\"\"\n    result = {}\n    result.update(dict1)\n    for key, value in dict2.items():\n        if key not in result:\n            result[key] = value\n    for key, value in dict3.items():\n        if key not in result:\n            result[key] = value\n    return result"}
