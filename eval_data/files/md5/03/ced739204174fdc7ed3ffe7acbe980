{"task_id": "Mbpp/63", "solution": "from typing import Iterable, Tuple\ndef max_difference(pairs: Iterable[Tuple[float, float]]) -> float:\n    \"\"\"Computes the maximum absolute difference between pairs of numbers.\n    This function expects `pairs` to be a non-empty iterable of 2-element numeric tuples.\n    \"\"\"\n    differences = [abs(a - b) for a, b in pairs]\n    return float(max(differences))"}
{"task_id": "Mbpp/59", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str, code: int = 0):\n        super().__init__(message)\n        self.message = message\n        self.code = code\nclass InputValidator:\n    \"\"\"Validates if input 'n' is a positive integer.\"\"\"\n    def isValid(self, n: int) -> bool:\n        \"\"\"Checks if n is an integer and n is greater than or equal to 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def validateOrRaise(self, n: int) -> None:\n        \"\"\"Raises ValidationError if n is not a valid positive integer.\"\"\"\n        if not self.isValid(n):\n            raise ValidationError(\"Input 'n' must be a positive integer (n >= 1).\")\nclass OctagonalNumber:\n    \"\"\"Represents an octagonal number and computes its value.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value = None\n\n    def compute(self) -> int:\n        \"\"\"Computes the octagonal number using the formula n * (3 * n - 2).\"\"\"\n        self.value = self.n * (3 * self.n - 2)\n        return self.value\nclass OctagonalService:\n    \"\"\"Orchestrates input validation and octagonal number computation.\"\"\"\n    def __init__(self, validator: InputValidator = None):\n        self.validator = validator if validator is not None else InputValidator()\n\n    def is_octagonal(self, n: int) -> int:\n        \"\"\"Validates input n and computes the nth octagonal number.\"\"\"\n        self.validator.validateOrRaise(n)\n        octagonal_num = OctagonalNumber(n)\n        return octagonal_num.compute()\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth octagonal number.\n    Raises ValidationError if n is not a positive integer.\n    \"\"\"\n    service = OctagonalService()\n    return service.is_octagonal(n)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int:\n    \"\"\"Flattens a list and sums all of its elements using a recursive helper.\"\"\"\n\n    def _sum_list(current_list: list) -> int:\n        \"\"\"Private recursive helper that traverses the list and accumulates the sum.\"\"\"\n        total_sum = 0\n        for element in current_list:\n            if isinstance(element, list):\n                total_sum += _sum_list(element)\n            else:\n                total_sum += element\n        return total_sum\n\n    return _sum_list(input_list)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Raises ValueError if the input string contains non-digit characters.\n    \"\"\"\n    if not s.isdigit():\n        raise ValueError(\"input must consist only of digits\")\n\n    count = 0\n    n = len(s)\n\n    # Iterate through all possible starting positions of a substring.\n    for i in range(n):\n        current_sum_of_digits = 0\n        # Iterate through all possible ending positions for the current start.\n        for j in range(i, n):\n            # As we extend the substring s[i...j], add the new digit.\n            current_sum_of_digits += int(s[j])\n            \n            # The length of the current substring s[i...j].\n            current_substring_length = j - i + 1\n            \n            # Check if the sum of digits equals the substring's length.\n            if current_sum_of_digits == current_substring_length:\n                count += 1\n                \n    return count"}
{"task_id": "Mbpp/66", "solution": "from typing import List\nimport numbers\ndef pos_count(numbers: List[numbers.Number]) -> int:\n    \"\"\"\n    Counts the number of positive numbers in a list.\n    Performs a single-pass iteration for O(n) time complexity.\n    \"\"\"\n    count = 0\n    for number in numbers:\n        if number > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuple_list):\n    \"\"\"Accepts a list of tuple-like objects and returns a boolean indicating whether all tuples have equal length.\n\n    The function computes len(item) for each element.\n    \"\"\"\n    if not tuple_list:\n        return True\n\n    reference_length = len(tuple_list[0])\n    for item in tuple_list:\n        if len(item) != reference_length:\n            return False\n    return True"}
{"task_id": "Mbpp/69", "solution": "from typing import Sequence, Any\ndef is_sublist(main_list: Sequence[Any], sublist: Sequence[Any]) -> bool:\n    \"\"\"Checks if a sublist exists as a contiguous subsequence within a main list.\"\"\"\n    \n    # Fast-fail: if sublist is longer than main_list, it cannot be a sublist.\n    if len(sublist) > len(main_list):\n        return False\n\n    # An empty sublist is considered a sublist of any list.\n    if not sublist:\n        return True\n\n    n = len(main_list)\n    m = len(sublist)\n\n    # Use a sliding window to check for contiguous sublist matches.\n    for start in range(n - m + 1):\n        # Compare the current window in main_list with the sublist element by element.\n        match_found_in_window = True\n        for i in range(m):\n            if main_list[start + i] != sublist[i]:\n                match_found_in_window = False\n                break\n        \n        if match_found_in_window:\n            return True\n            \n    # If no contiguous sublist match was found after checking all windows.\n    return False"}
{"task_id": "Mbpp/67", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to bell_number function.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef computeBell(n: int) -> int:\n    \"\"\"Compute nth Bell number using integer-only dynamic programming (Bell triangle).\"\"\"\n    if n == 0:\n        return 1\n    \n    # Initialize the first row of the Bell triangle (for B(0))\n    row = [1] \n    \n    # Build Bell triangle row-by-row\n    for i in range(1, n + 1):\n        new_row = [row[-1]]  # First element of new row is the last of the previous row (B(i,0) = B(i-1,i-1))\n        for j in range(1, i + 1):\n            # B(i,j) = B(i,j-1) + B(i-1,j-1)\n            new_row.append(new_row[-1] + (row[j - 1] if j - 1 < len(row) else 0))\n        row = new_row\n        \n    # After building up to row n, the first element (B(n,0)) is the nth Bell number\n    return row[0]\ndef bell_number(n) -> int:\n    \"\"\"Public API: validate n and return nth Bell number as exact int.\n\n    Raises:\n        ValidationError: if n is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer\")\n    if n < 0:\n        raise ValidationError(\"n must be non-negative\")\n    return computeBell(n)"}
