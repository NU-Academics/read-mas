{"task_id": "Mbpp/255", "solution": "class ElementsList:\n    \"\"\"Encapsulates the input list of elements.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\nclass Combination:\n    \"\"\"Immutable wrapper holding a tuple of values for a single combination.\"\"\"\n    def __init__(self, values: tuple):\n        self.values = values\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the combination as a plain tuple.\"\"\"\n        return self.values\nclass CombinationSet:\n    \"\"\"Holds a list of Combination objects and provides conversion methods.\"\"\"\n    def __init__(self, combinations: list):\n        self.combinations = combinations\n\n    def to_tuple_list(self) -> list:\n        \"\"\"Converts the set of Combination objects to a list of tuples.\"\"\"\n        return [combo.as_tuple() for combo in self.combinations]\n\n    def count(self) -> int:\n        \"\"\"Returns the number of combinations in the set.\"\"\"\n        return len(self.combinations)\nclass CombinationGenerator:\n    \"\"\"Stateless generator that enumerates Cartesian product in nested-loop order.\"\"\"\n    def generate(self, elements: ElementsList, n: int) -> CombinationSet:\n        \"\"\"Generates all combinations with repetition of length n from elements.\"\"\"\n        if n == 0:\n            return CombinationSet([Combination(())])\n        elif n < 0:\n            return CombinationSet([])\n\n        input_elements = elements.elements\n        num_elements = len(input_elements)\n\n        if num_elements == 0 and n > 0:\n            return CombinationSet([])\n\n        current_indices = [0] * n\n        all_combinations_list = []\n\n        while True:\n            current_combination_tuple = tuple(input_elements[idx] for idx in current_indices)\n            all_combinations_list.append(Combination(current_combination_tuple))\n\n            i = n - 1\n            while i >= 0:\n                current_indices[i] += 1\n                if current_indices[i] < num_elements:\n                    break\n                else:\n                    current_indices[i] = 0\n                    i -= 1\n            if i < 0:\n                break\n\n        return CombinationSet(all_combinations_list)\ndef combinations_colors(elements: list, n: int) -> list:\n    \"\"\"\n    Generates all combinations (with repetition) of elements from the list of length n,\n    returning a list of tuples.\n    \"\"\"\n    elements_list_obj = ElementsList(elements)\n    generator = CombinationGenerator()\n    combination_set = generator.generate(elements_list_obj, n)\n    return combination_set.to_tuple_list()"}
{"task_id": "Mbpp/252", "solution": "import math\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\nclass MathFunctions:\n    \"\"\"Provides static wrappers for common math operations.\"\"\"\n    @staticmethod\n    def sqrt(x: float) -> float:\n        return math.sqrt(x)\n\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        return math.atan2(y, x)\nclass Converter:\n    \"\"\"Orchestrates the conversion from numeric to polar coordinates.\"\"\"\n    def convert(self, value) -> tuple[float, float]:\n        cnum = self._normalize_to_complex(value)\n        r = self._compute_r(cnum)\n        theta = self._compute_theta(cnum)\n        return (r, theta)\n\n    def _normalize_to_complex(self, value) -> ComplexNumber:\n        \"\"\"Normalizes numeric input to a ComplexNumber object.\"\"\"\n        z = complex(value) # Converts int, float, or complex to a complex number\n        return ComplexNumber(z.real, z.imag)\n\n    def _compute_r(self, cnum: ComplexNumber) -> float:\n        \"\"\"Computes the magnitude (r) from a ComplexNumber.\"\"\"\n        return MathFunctions.sqrt(cnum.real * cnum.real + cnum.imag * cnum.imag)\n\n    def _compute_theta(self, cnum: ComplexNumber) -> float:\n        \"\"\"Computes the angle (theta) from a ComplexNumber.\"\"\"\n        return MathFunctions.atan2(cnum.imag, cnum.real)\ndef convert(value) -> tuple[float, float]:\n    \"\"\"\n    Converts a numeric value (int, float, or complex) to polar coordinates (r, theta).\n    r is the magnitude and theta is the angle in radians.\n    \"\"\"\n    converter_instance = Converter()\n    return converter_instance.convert(value)"}
{"task_id": "Mbpp/256", "solution": "from math import floor, sqrt\nclass PrimeCounter:\n    \"\"\"Helper class to encapsulate prime-counting algorithm and primality test.\"\"\"\n\n    @staticmethod\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n (>1) is prime using trial division.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    @staticmethod\n    def count_Primes_nums(number) -> int:\n        \"\"\"Counts prime numbers less than the given number using the internal primality test.\"\"\"\n        count = 0\n        \n        # Determine the maximum integer candidate to check.\n        # If 'number' is an integer, primes must be strictly less than it.\n        max_candidate_to_check = floor(number)\n        if number == max_candidate_to_check:\n            max_candidate_to_check -= 1\n        \n        # Iterate from 2 up to max_candidate_to_check (inclusive).\n        for i in range(2, int(max_candidate_to_check) + 1):\n            if PrimeCounter._is_prime(i):\n                count += 1\n        return count\ndef count_Primes_nums(number) -> int:\n    \"\"\"Returns the number of prime numbers less than the given non-negative number.\"\"\"\n    if number < 2:\n        return 0\n    return PrimeCounter.count_Primes_nums(number)"}
{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"Returns a tuple with the second number and then the first number. For example, swap_numbers(10, 20) returns (20, 10).\"\"\"\n    return (b, a)"}
{"task_id": "Mbpp/259", "solution": "class Validator:\n    \"\"\"Encapsulates all input structure, length, and comparability validations.\"\"\"\n\n    def validate_outer_length(self, a: tuple, b: tuple) -> None:\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise TypeError(\"Inputs 'a' and 'b' must be tuples.\")\n        if len(a) != len(b):\n            raise ValueError(f\"Outer tuples must have equal length, but got {len(a)} and {len(b)}.\")\n\n    def validate_inner_lengths(self, a_i: tuple, b_i: tuple, index: int) -> None:\n        if not isinstance(a_i, tuple) or not isinstance(b_i, tuple):\n            raise TypeError(f\"Inner elements at index {index} must be tuples.\")\n        if len(a_i) != len(b_i):\n            raise ValueError(f\"Inner tuples at index {index} must have equal length, but got {len(a_i)} and {len(b_i)}.\")\n\n    def validate_comparability(self, x: object, y: object, i: int, j: int) -> None:\n        try:\n            max(x, y)\n        except TypeError as e:\n            raise TypeError(f\"Elements at [{i}][{j}] are not comparable: {x} and {y}.\") from e\ndef _process_pair(a_i: tuple, b_i: tuple, index: int, validator: Validator) -> tuple:\n    \"\"\"Computes element-wise maxima for a pair of inner tuples.\"\"\"\n    result_inner_list = []\n    for j in range(len(a_i)):\n        validator.validate_comparability(a_i[j], b_i[j], index, j)\n        result_inner_list.append(max(a_i[j], b_i[j]))\n    return tuple(result_inner_list)\ndef _assemble_result(per_index_results: list) -> tuple:\n    \"\"\"Converts a list of inner tuples into the final tuple-of-tuples.\"\"\"\n    return tuple(per_index_results)\ndef maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Return tuple-of-tuples where each element is the element-wise maximum of a and b.\n\n    Raises:\n      ValueError: if outer lengths differ or any pair of inner tuples differ in length.\n      TypeError: if inputs are not tuples or any element pairs are not comparable.\n    \"\"\"\n    validator = Validator()\n    validator.validate_outer_length(a, b)\n\n    per_index_results = []\n    for i in range(len(a)):\n        validator.validate_inner_lengths(a[i], b[i], i)\n        inner_res = _process_pair(a[i], b[i], i, validator)\n        per_index_results.append(inner_res)\n\n    return _assemble_result(per_index_results)"}
{"task_id": "Mbpp/261", "solution": "class TupleInput:\n    \"\"\"Lightweight wrapper for input tuple.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\nclass ResultTuple:\n    \"\"\"Wrapper for result tuple elements.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\nclass Validation:\n    \"\"\"Provides validation methods invoked before computation.\"\"\"\n    def validate_types(self, t: tuple) -> None:\n        \"\"\"Ensures the input is a tuple and all its elements are numeric.\"\"\"\n        if not isinstance(t, tuple):\n            raise TypeError(\"Inputs must be tuples.\")\n        for x in t:\n            if not isinstance(x, (int, float)):\n                raise TypeError(\"All elements must be numeric (int or float).\")\n\n    def validate_lengths(self, a: tuple, b: tuple) -> None:\n        \"\"\"Ensures input tuples have equal lengths.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have equal lengths.\")\n\n    def check_zero_division(self, b: tuple) -> None:\n        \"\"\"Checks if any element in the divisor tuple is zero.\"\"\"\n        for x in b:\n            if x == 0:\n                raise ZeroDivisionError(\"Cannot divide by zero.\")\nclass DivisionElements:\n    \"\"\"Orchestrates validation and performs element-wise division.\"\"\"\n    def division_elements(self, a: tuple, b: tuple) -> tuple:\n        \"\"\"Constructs inputs, validates, computes, and returns results.\"\"\"\n        ta = TupleInput(a)\n        tb = TupleInput(b)\n\n        v = Validation()\n\n        v.validate_types(ta.elements)\n        v.validate_types(tb.elements)\n        v.validate_lengths(ta.elements, tb.elements)\n        v.check_zero_division(tb.elements)\n\n        results = tuple(ta.elements[i] / tb.elements[i] for i in range(ta.length()))\n\n        return ResultTuple(results).elements\ndef division_elements(dividend_tuple: tuple, divisor_tuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two input tuples.\n    Validates inputs for types, lengths, and zero division before computation.\n    \"\"\"\n    impl = DivisionElements()\n    return impl.division_elements(dividend_tuple, divisor_tuple)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> int:\n    \"\"\"Return dog's age in dog years using formula: 5 * human_years + 1.\n\n    Args:\n        human_years (int): dog's age in human years.\n\n    Returns:\n        int: dog's age in dog years (5 * human_years + 1).\n    \"\"\"\n    return 5 * human_years + 1"}
{"task_id": "Mbpp/260", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass ExceptionHandler:\n    \"\"\"Handles raising specific exceptions consistently.\"\"\"\n    def raise_invalid_input(self, message: str) -> None:\n        \"\"\"Raises an InvalidInputError with the given message.\"\"\"\n        raise InvalidInputError(message)\nclass InputParameter:\n    \"\"\"Encapsulates and validates an input parameter.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the encapsulated value is a valid positive integer.\"\"\"\n        return isinstance(self.value, int) and self.value >= 1\nclass NewmanShanksWilliamsPrime:\n    \"\"\"A value object for a Newman\u2013Shanks\u2013Williams prime number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\ndef _is_prime(num: int) -> bool:\n    \"\"\"Helper function to check if a number is prime.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\nclass SequenceGenerator:\n    \"\"\"Generates Newman\u2013Shanks\u2013Williams sequence values iteratively.\"\"\"\n    def __init__(self):\n        self.reset()\n\n    def reset(self) -> None:\n        \"\"\"Resets the generator state to initial terms (a_0=1, a_1=1).\"\"\"\n        self._index = 0\n        self._a_prev = 1  # Corresponds to a(n-2)\n        self._a_curr = 1  # Corresponds to a(n-1)\n\n    def next(self) -> int:\n        \"\"\"Advances the generator and returns the next sequence term.\"\"\"\n        if self._index == 0:\n            self._index += 1\n            return 1 # a(0)\n        elif self._index == 1:\n            self._index += 1\n            return 1 # a(1)\n        else:\n            # Recurrence: a(n) = 2*a(n-1) + a(n-2)\n            next_term = 2 * self._a_curr + self._a_prev\n            self._a_prev = self._a_curr\n            self._a_curr = next_term\n            self._index += 1\n            return next_term\nclass NewmanPrimeService:\n    \"\"\"Coordinates validation and generation to find NSW primes.\"\"\"\n    def __init__(self, generator: SequenceGenerator = None, exception_handler: ExceptionHandler = None):\n        self._generator = generator if generator is not None else SequenceGenerator()\n        self._exception_handler = exception_handler if exception_handler is not None else ExceptionHandler()\n\n    def newman_prime(self, n) -> int:\n        \"\"\"Returns the nth Newman\u2013Shanks\u2013Williams prime number.\"\"\"\n        self._validate(n)\n        newman_shanks_williams_prime = self._generate_until(n)\n        return newman_shanks_williams_prime.value\n\n    def _validate(self, n) -> None:\n        \"\"\"Validates the input 'n' and raises an exception if invalid.\"\"\"\n        param = InputParameter(n)\n        if not param.is_valid():\n            self._exception_handler.raise_invalid_input(f\"Input 'n' must be a positive integer, but got {n}\")\n\n    def _generate_until(self, index: int) -> NewmanShanksWilliamsPrime:\n        \"\"\"Generates NSW sequence terms starting from a(index) until a prime is found.\"\"\"\n        self._generator.reset()\n\n        # Advance generator to the 'index'-th term (a_index) of the NSW sequence (0-indexed).\n        # The input 'index' is 1-based. To get a(index), we need to consume (index+1) terms.\n        # The loop consumes 'index' terms (a_0 to a_(index-1)).\n        for _ in range(index):\n            current_nsw_term = self._generator.next()\n        # One more call to get a(index).\n        current_nsw_term = self._generator.next()\n\n        # Starting from a(index), find the first prime term.\n        while True:\n            if _is_prime(current_nsw_term):\n                return NewmanShanksWilliamsPrime(current_nsw_term)\n            current_nsw_term = self._generator.next()\ndef newman_prime(n) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    The 'n' is interpreted such that newman_prime(3) == 7.\n    \"\"\"\n    service = NewmanPrimeService()\n    return service.newman_prime(n)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"\n    Splits a list into two parts, where the length of the first part is L (clamped).\n    Returns a tuple containing the two newly created lists.\n    \"\"\"\n    list_len = len(input_list)\n    # Clamp L to be within the valid range [0, list_len]\n    L_clamped = min(max(L, 0), list_len)\n\n    first_part = input_list[:L_clamped]\n    second_part = input_list[L_clamped:]\n\n    return (first_part, second_part)"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side):\n    \"\"\"\n    Calculates the lateral surface area of a cube.\n    The lateral surface area is given by the formula 4 * side^2.\n    \"\"\"\n    return 4 * side * side"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements by their original index modulo n.\n    The i-th sublist contains elements at indices i, i+n, i+2n, and so on.\n    \"\"\"\n    list_len = len(input_list)\n    result = [[] for _ in range(n)]\n\n    for i in range(list_len):\n        sublist_index = i % n\n        result[sublist_index].append(input_list[i])\n\n    return result"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the squares of the first n odd natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number * odd_number\n    return total_sum"}
