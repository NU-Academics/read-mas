{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"Finds the first odd number in a given list of numbers.\n    This function delegates validation and finding to inner helper functions.\n    \"\"\"\n\n    def validate_input(numbers_param):\n        \"\"\"Ensures the input is a list. Raises TypeError if not.\"\"\"\n        if not isinstance(numbers_param, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n\n    def find_first_odd(numbers_param):\n        \"\"\"Scans for and returns the first odd number in the list. Returns None if no odd number is found.\"\"\"\n        for n in numbers_param:\n            # As per design, Python will raise TypeError if an element does not support modulo.\n            if n % 2 != 0:\n                return n\n        return None\n\n    validate_input(numbers)\n    return find_first_odd(numbers)"}
{"task_id": "Mbpp/809", "solution": "def _is_second_element_smaller(a, b) -> bool:\n    \"\"\"Compares if the first element (from second tuple) is strictly smaller than the second element (from first tuple).\"\"\"\n    return a < b\ndef check_smaller(first: tuple, second: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Assumes inputs are tuples of equal length.\n    \"\"\"\n    for i in range(len(first)):\n        if not _is_second_element_smaller(second[i], first[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/806", "solution": "from dataclasses import dataclass\nclass MaxRunFunction:\n    \"\"\"Encapsulates the algorithm to find the maximum run of uppercase characters.\"\"\"\n\n    @staticmethod\n    def max_run_uppercase(s: str) -> int:\n        \"\"\"\n        Calculates the maximum contiguous run of uppercase ASCII characters in a string.\n        Any non-uppercase character terminates a run.\n        \"\"\"\n        current_run = 0\n        max_run = 0\n\n        for char_code in s:\n            if 'A' <= char_code <= 'Z':\n                current_run += 1\n            else:\n                if current_run > max_run:\n                    max_run = current_run\n                current_run = 0\n\n        if current_run > max_run:\n            max_run = current_run\n\n        return max_run\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum contiguous run of uppercase ASCII characters in the given string.\n    Delegates to MaxRunFunction for the core logic.\n    \"\"\"\n    return MaxRunFunction.max_run_uppercase(s)"}
{"task_id": "Mbpp/805", "solution": "from typing import List\nclass Number:\n    \"\"\"Represents a numeric value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = float(value)\nclass InnerList:\n    \"\"\"Represents a list of numeric elements.\"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self.elements = [Number(e) for e in elements]\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of its elements.\"\"\"\n        return sum(n.value for n in self.elements)\nclass OuterList:\n    \"\"\"Represents a list of InnerList objects.\"\"\"\n    def __init__(self, innerLists: List[InnerList]) -> None:\n        self.innerLists = innerLists\nclass MaxSumFunction:\n    \"\"\"Provides the core algorithm to find the inner list with the highest sum.\"\"\"\n    def max_sum_list(self, outerList_raw: List[List[float]]) -> List[float]:\n        \"\"\"\n        Computes sums for each inner list and returns the input inner list\n        with the highest sum.\n        \"\"\"\n        if not outerList_raw:\n            return []\n\n        inner_lists_domain = [InnerList(inner_raw) for inner_raw in outerList_raw]\n        outer_list_domain = OuterList(inner_lists_domain)\n\n        max_sum = float('-inf')\n        max_sum_list_result = []\n\n        for i, inner_list_obj in enumerate(outer_list_domain.innerLists):\n            current_sum = inner_list_obj.sum()\n            if current_sum > max_sum:\n                max_sum = current_sum\n                max_sum_list_result = outerList_raw[i]\n\n        return max_sum_list_result\ndef _validate_outer_list(outer_list) -> bool:\n    \"\"\"Performs basic validation on the outer list structure and its elements.\"\"\"\n    # As per instructions: \"DO NOT add isinstance() checks\".\n    # This function exists as a placeholder to satisfy the design call.\n    return True\ndef max_sum_list(outer_list: List[List[float]]) -> List[float]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    Delegates to MaxSumFunction for core logic after basic validation.\n    \"\"\"\n    _validate_outer_list(outer_list)\n\n    max_sum_calculator = MaxSumFunction()\n    return max_sum_calculator.max_sum_list(outer_list)"}
