{"task_id": "Mbpp/594", "solution": "from typing import List\ndef diff_even_odd(nums: List[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Returns first_even - first_odd, raising ValueError for invalid input or missing parities.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise ValueError(\"Input must be a list.\")\n\n    first_even = None\n    first_odd = None\n\n    for num in nums:\n        if not isinstance(num, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/598", "solution": "from typing import List\nclass Number:\n    \"\"\"Represents an integer input value and provides access to decimal digits and digit count.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digitCount(self) -> int:\n        \"\"\"Returns the number of decimal digits in the value.\"\"\"\n        return len(str(self.value))\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns a list of decimal digits of the value.\"\"\"\n        return [int(d) for d in str(self.value)]\nclass ArmstrongChecker:\n    \"\"\"Encapsulates Armstrong evaluation logic.\"\"\"\n    def armstrong_number(self, number: int) -> bool:\n        \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n        num_obj = Number(number)\n        sum_of_powers = self._sumOfPowers(num_obj)\n        return sum_of_powers == number\n\n    def _sumOfPowers(self, n: Number) -> int:\n        \"\"\"Computes the sum of each digit raised to the power of the total digit count.\"\"\"\n        digit_count = n.digitCount()\n        total_sum = 0\n        for digit in n.digits():\n            total_sum += digit ** digit_count\n        return total_sum\ndef armstrong_number(number: int) -> bool:\n    \"\"\"Public API: checks whether the given number is an Armstrong number.\"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(number)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first n natural numbers.\"\"\"\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(A: list, B: list, k: int) -> any:\n    \"\"\"Finds the kth smallest element from two sorted arrays A and B.\"\"\"\n    len_a = len(A)\n    len_b = len(B)\n    total_length = len_a + len_b\n\n    # Validate k is within the valid range [1, total_length].\n    if not (1 <= k <= total_length):\n        raise ValueError(f\"k must be between 1 and {total_length} (inclusive), but got {k}\")\n\n    idx_a = 0\n    idx_b = 0\n    result = None\n\n    # Iterate k times to find the kth smallest element.\n    for _ in range(k):\n        if idx_a < len_a and (idx_b >= len_b or A[idx_a] <= B[idx_b]):\n            result = A[idx_a]\n            idx_a += 1\n        else:\n            result = B[idx_b]\n            idx_b += 1\n            \n    return result"}
{"task_id": "Mbpp/600", "solution": "def is_Even(number: int) -> bool:\n    \"\"\"Return True if integer 'number' is even, False if odd. Raises TypeError on non-int.\"\"\"\n    def _validate_integer(n) -> None:\n        \"\"\"Raise TypeError if n is not an int.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'number' must be an integer.\")\n\n    _validate_integer(number)\n    return number % 2 == 0"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str | None:\n    \"Return the first character in s whose initial occurrence has at least one later occurrence, or None if none exists.\"\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"Return a string where words (split on ' ') from input are reversed in order.\n\n    Behavior: split on ' ' exactly (Python str.split(' ')), reverse token order, then join tokens with a single space.\n    \"\"\"\n    words = input.split(' ')\n    reversed_words = list(reversed(words))\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/605", "solution": "import math\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Returns False for numbers less than or equal to 1.\n    \"\"\"\n    if n <= 1:\n        return False\n    \n    # Check for divisibility from 2 up to sqrt(n)\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/603", "solution": "from typing import List\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Calculates all Ludic numbers less than or equal to n using a sieving method.\n    Returns an empty list for non-positive n.\n    \"\"\"\n    if n < 1:\n        return []\n\n    sequence = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while sequence:\n        p = sequence.pop(0)\n        ludic_numbers.append(p)\n\n        if p == 1:\n            # The first Ludic number, 1, does not sieve other numbers from the sequence.\n            continue\n\n        # Sieve out every p-th element from the remaining sequence\n        next_sequence = []\n        k = 0 # Counter for elements considered in the current sequence\n        for element in sequence:\n            k += 1\n            if k % p != 0:\n                next_sequence.append(element)\n        sequence = next_sequence\n\n    return ludic_numbers"}
{"task_id": "Mbpp/606", "solution": "class ConstantPi:\n    \"Provides the immutable pi constant value.\"\n    value: float = 3.141592653589793\nclass Angle:\n    \"Represents input degrees and provides conversion to radians.\"\n    def __init__(self, degrees: float) -> None:\n        self.degrees = float(degrees)\n\n    def toRadians(self, pi_value: float) -> float:\n        \"Computes radians from degrees using the given pi value.\"\n        return self.degrees * pi_value / 180.0\nclass RadianConverter:\n    \"Performs the conversion from degrees to radians.\"\n    def __init__(self, pi_provider: ConstantPi = ConstantPi()) -> None:\n        self._pi_provider = pi_provider\n\n    def radian_degree(self, degrees: float) -> float:\n        \"Converts degrees to radians.\"\n        angle_obj = Angle(degrees)\n        pi_val = self._pi_provider.value\n        radians_result = angle_obj.toRadians(pi_val)\n        return radians_result\ndef radian_degree(degrees: float) -> float:\n    \"Convert degrees to radians and return the numeric float value.\"\n    converter = RadianConverter()\n    return converter.radian_degree(degrees)"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"\n    Computes the nth Bell number using a dynamic programming approach\n    based on Stirling numbers of the second kind.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list to store Stirling numbers of the second kind, S(i, j)\n    # S[i][j] will store the number of ways to partition i elements into j non-empty subsets.\n    stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: S(0, 0) = 1 (one way to partition an empty set into zero subsets)\n    stirling[0][0] = 1\n\n    # Fill the Stirling numbers table\n    for i in range(1, n + 1):\n        # S(i, 0) is 0 for i >= 1, which is already handled by initialization.\n        for j in range(1, i + 1):\n            # Recurrence relation: S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n            stirling[i][j] = stirling[i-1][j-1] + j * stirling[i-1][j]\n\n    # The nth Bell number is the sum of Stirling numbers of the second kind for n:\n    # B_n = Sum_{k=0 to n} S(n, k)\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += stirling[n][k]\n\n    return bell_n"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom dataclasses import dataclass\nclass RegexEngine:\n    \"\"\"Engine to perform regex search operations.\"\"\"\n    def find_first_match(self, source: SourceString, pattern: Pattern) -> MatchResult | None:\n        \"\"\"Searches for the first match of the pattern in the source string, returning a MatchResult or None.\"\"\"\n        try:\n            compiled_pattern = re.compile(pattern.expression)\n        except re.error as e:\n            raise ValueError(f\"Invalid regex pattern: {pattern.expression}\") from e\n\n        match = compiled_pattern.search(source.value)\n\n        if match:\n            return MatchResult(match.group(0), match.start(), match.end())\n        else:\n            return None\ndef find_literals(source: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring, start, and end indices.\n    Returns None if no match is found, or raises ValueError for an invalid regex pattern.\n    \"\"\"\n    src_obj = SourceString(source)\n    pat_obj = Pattern(pattern)\n    engine = RegexEngine()\n\n    match_result = engine.find_first_match(src_obj, pat_obj)\n\n    if match_result is None:\n        return None\n    else:\n        return (match_result.text, match_result.start_index, match_result.end_index)"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: list) -> list:\n    \"\"\"\n    Transforms a list of two-element sublists into a list containing two lists:\n    one for first elements and one for second elements, preserving order.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Returns a new list with the k'th element removed from the input list.\n    k is a 1-based index, and the original list is not modified.\n    \"\"\"\n    _validate_k(input_list, k)\n    idx_to_remove = k - 1\n    return input_list[:idx_to_remove] + input_list[idx_to_remove + 1:]"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Union\nNumber = Union[int, float]\ndef _extract_column(matrix: List[List[Number]], n: int) -> List[Number]:\n    \"\"\"Extracts the nth column from the matrix.\"\"\"\n    return [row[n] for row in matrix]\ndef max_of_nth(matrix: List[List[Number]], n: int) -> Number:\n    \"\"\"Returns the maximum numeric value from the nth column of the given matrix.\"\"\"\n    _validate_inputs(matrix, n)\n    column_values = _extract_column(matrix, n)\n    return max(column_values)"}
{"task_id": "Mbpp/614", "solution": "def compute_sum(input_list):\n    \"\"\"\n    Computes the arithmetic sum of all numeric values across all tuples in the list.\n    Returns 0 if no numeric elements are found.\n    \"\"\"\n    total_sum = 0\n    for sub_tuple in input_list:\n        for item in sub_tuple:\n            total_sum += item\n    return total_sum\ndef cummulative_sum(input_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values present in a list of tuples.\n    It validates the input structure and then computes the sum.\n    \"\"\"\n    validate(input_list)\n    return compute_sum(input_list)"}
{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List, Any\nVALUE_ERROR_EMPTY = \"empty inner tuple\"\ndef average_tuple(input: Tuple[Tuple[Any, ...], ...]) -> List[float]:\n    \"\"\"\n    Calculates the average of each inner tuple within a tuple of tuples.\n\n    Raises TypeError for invalid input types and ValueError for empty inner tuples.\n    \"\"\"\n    def _validate_top_level(data: Tuple[Tuple[Any, ...], ...]) -> None:\n        if not isinstance(data, tuple):\n            raise TypeError(\"invalid input type\")\n        for i, inner_tuple in enumerate(data):\n            if not isinstance(inner_tuple, tuple):\n                raise TypeError(f\"invalid input type: element at index {i} is not a tuple\")\n\n    def _validate_inner_tuple(inner_tuple: Tuple[Any, ...], position: int) -> None:\n        if not inner_tuple: # Check if empty\n            raise ValueError(VALUE_ERROR_EMPTY)\n        for element in inner_tuple:\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"invalid element type: non-numeric found in inner tuple at index {position}\")\n\n    _validate_top_level(input)\n\n    averages = []\n    for i, inner_tup in enumerate(input):\n        _validate_inner_tuple(inner_tup, i)\n        current_sum = sum(inner_tup)\n        current_count = len(inner_tup)\n        averages.append(current_sum / current_count)\n\n    return averages"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Sequence, Union\nnumber = Union[int, float]\nclass InputList:\n    \"\"\"Represents an input list of numeric elements.\"\"\"\n    def __init__(self, elements: Sequence[number]) -> None:\n        self._elements: List[number] = list(elements)\n\n    def __len__(self) -> int:\n        return len(self._elements)\n\n    def __getitem__(self, index: int) -> number:\n        return self._elements[index]\nclass OutputList:\n    \"\"\"Represents an output list of floating-point quotients.\"\"\"\n    def __init__(self, elements: Sequence[float]) -> None:\n        self._elements: List[float] = list(elements)\n\n    def to_list(self) -> List[float]:\n        return self._elements\nclass ElementPair:\n    \"\"\"Pairs numerator and denominator to compute their quotient.\"\"\"\n    def __init__(self, numerator: number, denominator: number) -> None:\n        self.numerator: number = numerator\n        self.denominator: number = denominator\n\n    def get_quotient(self) -> float:\n        return float(self.numerator / self.denominator)\nclass DivListFunction:\n    \"\"\"Orchestrates element-wise division of two input lists.\"\"\"\n    def div(self, listA: List[number], listB: List[number]) -> List[float]:\n        input_list_a = InputList(listA)\n        input_list_b = InputList(listB)\n        \n        num_elements = len(input_list_a)\n        \n        quotients: List[float] = []\n        for i in range(num_elements):\n            pair = ElementPair(input_list_a[i], input_list_b[i])\n            quotients.append(pair.get_quotient())\n            \n        output_list = OutputList(quotients)\n        return output_list.to_list()\ndef div_list(listA: List[number], listB: List[number]) -> List[float]:\n    \"\"\"\n    Performs element-wise division of two lists, returning a list of floats.\n    Delegates the core logic to an internal DivListFunction instance.\n    \"\"\"\n    return DivListFunction().div(listA, listB)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input: str) -> str:\n    \"\"\"Moves all numbers in the input string to its end, preserving relative order.\"\"\"\n    if not input:\n        return \"\"\n\n    non_digits_chars = []\n    digit_chars = []\n\n    for char in input:\n        if '0' <= char <= '9':\n            digit_chars.append(char)\n        else:\n            non_digits_chars.append(char)\n\n    return \"\".join(non_digits_chars) + \"\".join(digit_chars)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    It returns a new tuple containing the results.\n    \"\"\"\n    return tuple(a_val % b_val for a_val, b_val in zip(a, b))"}
{"task_id": "Mbpp/620", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers where every pair is divisible.\n    It uses dynamic programming on a sorted list of elements to find the longest divisibility chain.\n    \"\"\"\n    n = len(numbers)\n\n    # FR3: Return 0 for empty input\n    if n == 0:\n        return 0\n\n    # FR4: Return 1 for single-element input\n    if n == 1:\n        return 1\n\n    # BR8: Duplicate values are treated as distinct occurrences.\n    # Create IntegerElement list, preserving original index.\n    elements = [IntegerElement(value, i) for i, value in enumerate(numbers)]\n\n    # Sort elements primarily by value. This is crucial for the Largest Divisible Subset DP\n    # approach, as it ensures elements[i].value >= elements[j].value when i > j.\n    elements.sort(key=lambda x: x.value)\n\n    # dp[i] will store the size of the largest divisible subset ending with elements[i].\n    # Each element itself forms a subset of size 1.\n    dp = [1] * n\n\n    # Initialize max_subset_size to 1, as a single element forms a valid subset.\n    max_subset_size = 1\n\n    # Iterate through elements to build up the DP table.\n    for i in range(n):\n        for j in range(i):\n            # FR2: Check divisibility. Since elements are sorted (elements[i].value >= elements[j].value),\n            # we only need to check if elements[i].value is divisible by elements[j].value.\n            # (Assuming non-zero divisors, as is typical for this problem class and implied by example).\n            if elements[i].value % elements[j].value == 0:\n                # If elements[i] is divisible by elements[j], it can extend the subset ending at elements[j].\n                dp[i] = max(dp[i], dp[j] + 1)\n        # Update the overall maximum subset size found so far.\n        max_subset_size = max(max_subset_size, dp[i])\n\n    return max_subset_size"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(input_list, n):\n    \"\"\"Compute and return a new list where each item of input_list is raised to the n-th power.\n\n    Args:\n        input_list (list): list of numeric elements\n        n (int): integer exponent\n\n    Returns:\n        list: list of results (same length and order as input_list)\n\n    Raises:\n        TypeError: if input_list is not list or n is not int\n        ValueError: if any element of input_list is not int or float\n    \"\"\"\n    validate_parameters(input_list, n)\n    validate_elements(input_list)\n    return [element ** n for element in input_list]"}
