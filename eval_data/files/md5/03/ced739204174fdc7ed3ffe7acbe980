{"task_id": "Mbpp/448", "solution": "def cal_sum(n):\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    # Initialize with base cases P(0)=3, P(1)=0, P(2)=2\n    perrin_sequence = [3, 0, 2]\n\n    # Compute subsequent Perrin numbers up to P(n) if necessary\n    for i in range(len(perrin_sequence), n + 1):\n        # P(i) = P(i-2) + P(i-3)\n        next_perrin = perrin_sequence[i - 2] + perrin_sequence[i - 3]\n        perrin_sequence.append(next_perrin)\n\n    # Sum the Perrin numbers from P(0) to P(n)\n    return sum(perrin_sequence[:n + 1])"}
{"task_id": "Mbpp/450", "solution": "class InputList:\n    def __init__(self, iterable):\n        \"\"\"Normalize an iterable to an internal list of StringItem instances.\"\"\"\n        if not hasattr(iterable, '__iter__'):\n            raise TypeError(\"Input 'list_of_strings' must be an iterable.\")\n        self._items = []\n        for item in iterable:\n            self._items.append(StringItem(item))\n\n    def __iter__(self):\n        \"\"\"Yield StringItem instances in their original order.\"\"\"\n        yield from self._items\nclass StringItem:\n    def __init__(self, value: str):\n        \"\"\"Validate value is a string and store it.\"\"\"\n        if not isinstance(value, str):\n            raise TypeError(\"All elements in 'list_of_strings' must be strings.\")\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Return the length of the stored string.\"\"\"\n        return len(self.value)\nclass ResultList:\n    def __init__(self):\n        \"\"\"Initialize an empty list to store matching StringItem instances.\"\"\"\n        self._items = []\n\n    def append(self, item: StringItem) -> None:\n        \"\"\"Add a StringItem to the result list.\"\"\"\n        self._items.append(item)\n\n    def to_list(self) -> list[str]:\n        \"\"\"Convert the stored StringItem instances back to a list of strings.\"\"\"\n        return [si.value for si in self._items]\nclass SizeParameter:\n    def __init__(self, value: int) -> None:\n        \"\"\"Validate and store the size parameter.\"\"\"\n        if not isinstance(value, int):\n            raise TypeError(\"Parameter 'size' must be an integer.\")\n        if value < 0:\n            raise ValueError(\"Parameter 'size' cannot be negative.\")\n        self.value = value\nclass ExtractStringFunction:\n    def extract(self, list_of_strings, size) -> list[str]:\n        \"\"\"Orchestrates the extraction of strings matching a specific length.\"\"\"\n        size_param = SizeParameter(size)\n        input_list = InputList(list_of_strings)\n        result_list = ResultList()\n\n        for item in input_list:\n            if item.length() == size_param.value:\n                result_list.append(item)\n\n        return result_list.to_list()\ndef extract_string(list_of_strings, size):\n    \"\"\"Validate inputs and return a list of strings from list_of_strings whose length == size.\"\"\"\n    extractor = ExtractStringFunction()\n    return extractor.extract(list_of_strings, size)"}
{"task_id": "Mbpp/451", "solution": "class InputString:\n    \"\"\"A lightweight data holder for the input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass OutputString:\n    \"\"\"A lightweight data holder for the output string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass WhitespaceRemover:\n    \"\"\"Encapsulates the algorithm for removing all whitespace characters from a string.\"\"\"\n    def remove_whitespaces(self, s: str) -> str:\n        input_obj = InputString(s)\n        \n        # Build a new string by appending only non-whitespace characters.\n        result_chars = []\n        for char in input_obj.value:\n            if not char.isspace():\n                result_chars.append(char)\n        \n        output_str = \"\".join(result_chars)\n        output_obj = OutputString(output_str)\n        return output_obj.value\ndef remove_whitespaces(s: str) -> str:\n    \"\"\"Removes all whitespace characters from the given string.\"\"\"\n    remover = WhitespaceRemover()\n    return remover.remove_whitespaces(s)"}
{"task_id": "Mbpp/453", "solution": "import math\nfrom typing import List\nclass Number:\n    \"\"\"Represents the input number for factor calculations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the number is a positive integer.\"\"\"\n        # Validation is primarily handled in the public sumofFactors function.\n        return isinstance(self.value, int) and self.value > 0\nclass Factor:\n    \"\"\"Represents a single factor and provides evenness check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Determines if the factor is an even number.\"\"\"\n        return self.value % 2 == 0\nclass SumResult:\n    \"\"\"A value object to hold the total sum of even factors.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\nclass SumOperation:\n    \"\"\"Orchestrates divisor enumeration, filtering, and summation.\"\"\"\n    def compute(self, number: Number) -> SumResult:\n        \"\"\"Computes the sum of even factors for the given number.\"\"\"\n        n = number.value\n        divisors = set()\n\n        # Enumerate divisors up to the square root of n, collecting pairs.\n        for i in range(1, int(math.isqrt(n)) + 1):\n            if n % i == 0:\n                divisors.add(i)\n                divisors.add(n // i)\n        \n        total_even_sum = 0\n        # Filter for even factors and sum their values.\n        for d in divisors:\n            factor_obj = Factor(d)\n            if factor_obj.isEven():\n                total_even_sum += d\n        \n        return SumResult(total_even_sum)\ndef sumofFactors(n):\n    \"\"\"\n    Finds the sum of even factors of a given number.\n    Raises TypeError if n is not an integer, or ValueError if n is not positive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n <= 0:\n        raise ValueError(\"Input must be > 0\")\n\n    number_obj = Number(n)\n    result_obj = SumOperation().compute(number_obj)\n    return result_obj.total"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List\nclass TextInput:\n    \"\"\"Encapsulates raw input string.\"\"\"\n    def __init__(self, rawText: str):\n        self.rawText = rawText\n\n    def getRaw(self) -> str:\n        \"\"\"Returns the raw input string.\"\"\"\n        return self.rawText\nclass Word:\n    \"\"\"Represents a tokenized word and checks for lowercase 'z'.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def containsLowercaseZ(self) -> bool:\n        \"\"\"Checks if the word contains the lowercase 'z' character.\"\"\"\n        return 'z' in self.text\nclass MatchResult:\n    \"\"\"Data holder for boolean match result.\"\"\"\n    def __init__(self, matched: bool):\n        self.matched = matched\nclass Tokenizer:\n    \"\"\"Extracts contiguous alphabetic tokens from raw text.\"\"\"\n    def tokenize(self, rawText: str) -> List[Word]:\n        \"\"\"Tokenizes raw text into a list of Word objects.\"\"\"\n        extracted_tokens = self._extract_alpha_tokens(rawText)\n        return [Word(token) for token in extracted_tokens]\n\n    def _extract_alpha_tokens(self, raw_text: str) -> List[str]:\n        \"\"\"Extracts alphabetic tokens using regex [A-Za-z]+.\"\"\"\n        return re.findall(r'[A-Za-z]+', raw_text)\nclass Matcher:\n    \"\"\"Determines if any Word object in a list contains lowercase 'z'.\"\"\"\n    def match(self, words: List[Word]) -> MatchResult:\n        \"\"\"Matches a list of Word objects for presence of lowercase 'z'.\"\"\"\n        for word in words:\n            if word.containsLowercaseZ():\n                return MatchResult(matched=True)\n        return MatchResult(matched=False)\ndef text_match_wordz(text) -> bool:\n    \"\"\"\n    Matches a word containing 'z' in the input text.\n    Extracts contiguous alphabetic tokens and checks if any contain lowercase 'z'.\n    \"\"\"\n    ti = TextInput(text)\n    tokens = Tokenizer().tokenize(ti.getRaw())\n    result = Matcher().match(tokens)\n    return result.matched"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list: list) -> list:\n    \"\"\"\n    Finds the sublist having the minimum length from a list of sublists.\n    If multiple sublists have the same minimum length, the first one encountered is returned.\n    \"\"\"\n    min_sublist = None\n    min_length = float('inf')\n\n    for sublist in input_list:\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            min_sublist = sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/456", "solution": "from typing import List\nclass StringItem:\n    \"\"\"Represents a single string element in the domain model.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass StringList:\n    \"\"\"Represents an input list of StringItem elements.\"\"\"\n    def __init__(self, items: List[StringItem]):\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\n    def as_plain_list(self) -> List[str]:\n        \"\"\"Converts the StringList to a plain Python list of strings.\"\"\"\n        return [item.value for item in self.items]\nclass ReversedStringList:\n    \"\"\"Represents an output list of reversed StringItem elements.\"\"\"\n    def __init__(self, items: List[StringItem]):\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\n    def as_plain_list(self) -> List[str]:\n        \"\"\"Converts the ReversedStringList to a plain Python list of strings.\"\"\"\n        return [item.value for item in self.items]\nclass ReverseStringListService:\n    \"\"\"A stateless domain service for reversing string items within a StringList.\"\"\"\n    def reverse_string_list(self, input_list_domain: StringList) -> ReversedStringList:\n        \"\"\"Reverses each string item in the input StringList and returns a new ReversedStringList.\"\"\"\n        reversed_items = []\n        for item in input_list_domain.items:\n            reversed_value = item.value[::-1]\n            reversed_items.append(StringItem(reversed_value))\n        return ReversedStringList(reversed_items)\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    This function acts as an adapter to a domain service for the core logic.\n    \"\"\"\n    # Convert the plain input list of strings into the domain's StringList object.\n    domain_input_items = [StringItem(s) for s in input_list]\n    domain_input_list = StringList(domain_input_items)\n\n    # Delegate the string reversal logic to the domain service.\n    service = ReverseStringListService()\n    domain_output_list = service.reverse_string_list(domain_input_list)\n\n    # Convert the domain's ReversedStringList object back to a plain list of strings.\n    return domain_output_list.as_plain_list()"}
{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(monthNumber: int) -> bool:\n    \"\"\"Check whether the given month number contains 31 days or not.\n    This function assumes valid integer input within the month range (1-12).\"\"\"\n    months_with_31_days = {1, 3, 5, 7, 8, 10, 12}\n    return monthNumber in months_with_31_days"}
{"task_id": "Mbpp/458", "solution": "class NumericParameter:\n    \"\"\"Validates if a given value is numeric.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Returns True if the value is an integer or float.\"\"\"\n        return isinstance(self.value, (int, float))\nclass Rectangle:\n    \"\"\"Represents a rectangle and computes its area.\"\"\"\n    def __init__(self, width: float, height: float):\n        self.width = width\n        self.height = height\n\n    def compute_area(self) -> float:\n        \"\"\"Calculates the product of width and height.\"\"\"\n        return self.width * self.height\nclass RectangleAreaCalculator:\n    \"\"\"Handles input validation and area calculation using Rectangle.\"\"\"\n    def rectangle_area(self, width, height):\n        \"\"\"Ensures inputs are numeric, then computes and returns the area.\"\"\"\n        if not NumericParameter(width).is_numeric():\n            raise TypeError(\"Width must be a numeric value.\")\n        if not NumericParameter(height).is_numeric():\n            raise TypeError(\"Height must be a numeric value.\")\n\n        rectangle = Rectangle(width, height)\n        return rectangle.compute_area()\ndef rectangle_area(width, height):\n    \"\"\"Calculates the area of a rectangle.\n    Raises TypeError if width or height are not numeric.\"\"\"\n    calculator = RectangleAreaCalculator()\n    return calculator.rectangle_area(width, height)"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Removes all uppercase alphabetic characters from the input string.\n    Preserves the order of remaining characters.\n    \"\"\"\n    return \"\".join(char for char in input_string if not char.isupper())"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list):\n    \"\"\"\n    Validates input and returns a list of the first element of each sublist, preserving order.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n\n    def _validate_input(input_list):\n        \"\"\"\n        Validate that input_list is a list of non-empty lists.\n        Raises TypeError if input_list or any sublist is not a list.\n        Raises ValueError if any sublist is empty.\n        \"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"input_list must be a list of sublists\")\n\n        for s in input_list:\n            if not isinstance(s, list):\n                raise TypeError(\"each sublist must be a list\")\n            if len(s) == 0:\n                raise ValueError(\"empty sublist encountered\")\n\n    _validate_input(input_list)\n    result = [s[0] for s in input_list]\n    return result"}
