{"task_id": "Mbpp/759", "solution": "def is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with exactly two digits after the decimal point.\n    Returns True if the string matches the pattern digits + '.' + digits{2}, False otherwise.\n    \"\"\"\n    if not s:\n        return False\n\n    def hasSingleDecimalPoint(input_str: str) -> bool:\n        \"\"\"Checks if the string contains exactly one decimal point.\"\"\"\n        return input_str.count('.') == 1\n\n    def hasDigitsBeforePoint(part_before_point: str) -> bool:\n        \"\"\"Checks if there is at least one digit before the decimal point.\"\"\"\n        return bool(part_before_point) and part_before_point.isdigit()\n\n    def hasExactlyTwoDigitsAfterPoint(part_after_point: str) -> bool:\n        \"\"\"Checks if there are exactly two digits after the decimal point.\"\"\"\n        return len(part_after_point) == 2 and part_after_point.isdigit()\n\n    if not hasSingleDecimalPoint(s):\n        return False\n\n    parts = s.split('.')\n    before_point = parts[0]\n    after_point = parts[1]\n\n    if not hasDigitsBeforePoint(before_point):\n        return False\n\n    if not hasExactlyTwoDigitsAfterPoint(after_point):\n        return False\n\n    return True"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(items: list[str]) -> int:\n    \"\"\"Counts the pairs of reverse strings in the given string list.\"\"\"\n\n    class StringItem:\n        def __init__(self, value: str, index: int):\n            self.value = value\n            self.index = index\n\n        def reverse(self) -> str:\n            return self.value[::-1]\n\n        def isPalindrome(self) -> bool:\n            return self.value == self.value[::-1]\n\n    class ReversePair:\n        def __init__(self, a: StringItem, b: StringItem):\n            self.a = a\n            self.b = b\n\n        def unordered_key(self) -> tuple[int, int]:\n            # Returns a canonical key for a pair, useful for deduplication.\n            return tuple(sorted((self.a.index, self.b.index)))\n\n    class CountReversePairsFunction:\n        def validateInput(self, items_input: list) -> None:\n            # Validates that the input is a list of strings.\n            if not isinstance(items_input, list):\n                raise TypeError(\"Input must be a list.\")\n            for item in items_input:\n                if not isinstance(item, str):\n                    raise TypeError(\"All elements in the list must be strings.\")\n\n        def findPairs(self, items_input: list[str]) -> list[ReversePair]:\n            str_to_string_items: dict[str, list[StringItem]] = {}\n            all_string_items: list[StringItem] = []\n\n            # Populate map and list of StringItem objects\n            for i, s_val in enumerate(items_input):\n                s_item = StringItem(s_val, i)\n                all_string_items.append(s_item)\n                if s_val not in str_to_string_items:\n                    str_to_string_items[s_val] = []\n                str_to_string_items[s_val].append(s_item)\n            \n            raw_pairs: list[ReversePair] = []\n\n            # Iterate through all StringItem objects to find matching reverse strings\n            for s_item_a in all_string_items:\n                reversed_s_val = s_item_a.reverse()\n\n                if reversed_s_val in str_to_string_items:\n                    for s_item_b in str_to_string_items[reversed_s_val]:\n                        # A pair is formed by two distinct StringItem objects\n                        # Ensure index 'a' comes before index 'b' to avoid redundant pairs (a,b) and (b,a)\n                        # and to correctly handle palindromes (an item cannot pair with itself)\n                        if s_item_a.index < s_item_b.index:\n                            raw_pairs.append(ReversePair(s_item_a, s_item_b))\n            \n            return raw_pairs\n\n        def count_reverse_pairs(self, items_input: list[str]) -> int:\n            self.validateInput(items_input)\n            \n            found_reverse_pairs = self.findPairs(items_input)\n            \n            # Use a set of unordered_keys to count unique pairs\n            unique_pair_keys = set()\n            for pair in found_reverse_pairs:\n                unique_pair_keys.add(pair.unordered_key())\n                \n            return len(unique_pair_keys)\n\n    # Instantiate the orchestrator and delegate the call\n    counter = CountReversePairsFunction()\n    return counter.count_reverse_pairs(items)"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(elements):\n    \"\"\"Return True iff all items in `elements` compare equal. Expect `elements` to be a list of numeric values (int or float). Raises TypeError for invalid inputs.\"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in elements:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List must contain only numeric items (int or float).\")\n\n    if not elements:\n        return True\n\n    distinct_elements = set(elements)\n    return len(distinct_elements) <= 1"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, n):\n    # Select the first n elements from the array.\n    selected_elements = array[:n]\n\n    # Sort the selected elements in ascending order.\n    sorted_values = sorted(selected_elements)\n\n    # Compute the minimum difference between adjacent elements in the sorted list.\n    min_difference = float('inf')\n    for i in range(1, len(sorted_values)):\n        diff = abs(sorted_values[i] - sorted_values[i-1])\n        if diff < min_difference:\n            min_difference = diff\n            \n    return min_difference"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of ASCII digits ('0'-'9') in the given string.\"\"\"\n    def _is_ascii_digit(c: str) -> bool:\n        \"\"\"Returns True if the character is an ASCII digit ('0' through '9').\"\"\"\n        return '0' <= c <= '9'\n\n    count = 0\n    for char in s:\n        if _is_ascii_digit(char):\n            count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    \n    # Helper function to check if a number is polite.\n    # A positive integer is polite if and only if it is not a power of 2.\n    def _is_polite_number(x: int) -> bool:\n        # x is a power of 2 if x > 0 and (x & (x - 1)) == 0.\n        # Thus, x is polite if x > 0 and it's not a power of 2.\n        return x > 0 and not (x & (x - 1) == 0)\n\n    polite_count = 0\n    current_num = 1  # Start checking from 1, as per natural numbers.\n\n    # Iterate through numbers, counting polite ones, until the nth is found.\n    while True:\n        if _is_polite_number(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple\ndef pair_wise(input_list: List) -> List[Tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n    \n    # Generates a new list of tuples, where each tuple contains two consecutive elements from the input list.\n    # The iteration stops at the second-to-last element to ensure each element has a successor for pairing.\n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/770", "solution": "class Result:\n    \"\"\"Value object carrying the integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass OddNumberSequence:\n    \"\"\"Utility to compute k-th odd number.\"\"\"\n    def get_odd(self, k: int) -> int:\n        return 2 * k - 1\nclass Computation:\n    \"\"\"Evaluates the summation formula and produces a Result.\"\"\"\n    formula: str = \"(2k-1)^4 summed k=1..n\"\n\n    def evaluate(self, n: int) -> Result:\n        total_sum = 0\n        odd_seq = OddNumberSequence()\n        for k in range(1, n + 1):\n            odd_num = odd_seq.get_odd(k)\n            total_sum += odd_num ** 4\n        return Result(total_sum)\nclass OddNumSumFunction:\n    \"\"\"Validates input and orchestrates the computation.\"\"\"\n    def odd_num_sum(self, n: int) -> int:\n        self.validate(n)\n        return self.compute_sum(n)\n\n    def validate(self, n: int) -> None:\n        \"\"\"Validates input n for type and value.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 1:\n            raise ValueError(\"n must be a positive integer\")\n\n    def compute_sum(self, n: int) -> int:\n        \"\"\"Computes the sum of fourth powers of first n odd natural numbers.\"\"\"\n        computation = Computation()\n        result = computation.evaluate(n)\n        return result.value\ndef odd_num_sum(n: int) -> int:\n    \"\"\"Finds the sum of fourth power of first n odd natural numbers.\"\"\"\n    return OddNumSumFunction().odd_num_sum(n)"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target_sum) -> int:\n    \"\"\"Counts the number of distinct index pairs (i < j) where numbers[i] + numbers[j] == target_sum.\n    Must not modify the input list.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "from typing import List, Any, Iterable\ndef Diff(list1: Iterable[Any], list2: Iterable[Any]) -> List[Any]:\n    \"\"\"Computes the difference between two lists, returning elements from list1 not in list2.\n    Surviving elements are ordered by original even indices first, then odd indices, preserving relative order within groups.\n    \"\"\"\n    even_indexed_survivors = []\n    odd_indexed_survivors = []\n\n    # Create a concrete list from list2 to allow multiple membership checks and prevent mutation.\n    list2_concrete = list(list2)\n\n    for i, item in enumerate(list1):\n        # Check if the item from list1 is present in list2 using equality comparison.\n        if item not in list2_concrete:\n            if i % 2 == 0:\n                even_indexed_survivors.append(item)\n            else:\n                odd_indexed_survivors.append(item)\n\n    return even_indexed_survivors + odd_indexed_survivors"}
{"task_id": "Mbpp/771", "solution": "from typing import Optional, Iterator\nclass Bracket:\n    \"\"\"\n    Represents a single bracket character and provides type (open/close) and matching logic.\n    \"\"\"\n    _PAIRS = {'(': ')', '[': ']', '{': '}'}\n    _OPENERS = set(_PAIRS.keys())\n    _CLOSERS = set(_PAIRS.values())\n\n    def __init__(self, value: str, kind: str) -> None:\n        self._value = value\n        self._kind = kind\n\n    @staticmethod\n    def from_char(c: str) -> 'Bracket':\n        \"\"\"Constructs a Bracket or raises ValueError for an invalid character.\"\"\"\n        if c in Bracket._OPENERS:\n            return Bracket(c, 'open')\n        elif c in Bracket._CLOSERS:\n            return Bracket(c, 'close')\n        else:\n            raise ValueError(f\"Character '{c}' is not a bracket.\")\n\n    def matches(self, other: 'Bracket') -> bool:\n        \"\"\"Checks if this bracket (an opener) matches the other bracket (a closer).\"\"\"\n        if self.is_open() and other.is_close():\n            return Bracket._PAIRS.get(self._value) == other._value\n        return False\n\n    def is_open(self) -> bool:\n        return self._kind == 'open'\n\n    def is_close(self) -> bool:\n        return self._kind == 'close'\nclass Stack:\n    \"\"\"\n    Lightweight LIFO container for Bracket instances.\n    \"\"\"\n    def __init__(self) -> None:\n        self._items: list[Bracket] = []\n\n    def push(self, b: Bracket) -> None:\n        self._items.append(b)\n\n    def pop(self) -> Bracket:\n        \"\"\"Removes and returns the top bracket.\"\"\"\n        return self._items.pop()\n\n    def peek(self) -> Optional[Bracket]:\n        \"\"\"Returns the top bracket without removing it, or None if empty.\"\"\"\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\nclass Expression:\n    \"\"\"\n    Encapsulates raw input string and provides iteration and bracket-only validation helpers.\n    \"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def is_bracket_only(self) -> bool:\n        \"\"\"Checks if the expression contains only bracket characters.\"\"\"\n        for char in self.raw:\n            if char not in Bracket._OPENERS and char not in Bracket._CLOSERS:\n                return False\n        return True\n\n    def __iter__(self) -> Iterator[str]:\n        return iter(self.raw)\nclass CheckResult:\n    \"\"\"\n    Encapsulates the result of checking (balanced boolean and optional error message).\n    \"\"\"\n    def __init__(self, balanced: bool, error_message: Optional[str] = None) -> None:\n        self.balanced = balanced\n        self.error_message = error_message\n\n    def as_bool(self) -> bool:\n        return self.balanced\ndef check_expression(expression: str) -> bool:\n    \"\"\"Return True if expression is bracket-only and balanced, False otherwise.\"\"\"\n    stack = Stack()\n    expression_obj = Expression(expression)\n\n    for char_val in expression_obj:\n        try:\n            current_bracket = Bracket.from_char(char_val)\n        except ValueError:\n            # Non-bracket character found, return False.\n            result = CheckResult(balanced=False, error_message=f\"Non-bracket character '{char_val}' found.\")\n            return result.as_bool()\n\n        if current_bracket.is_open():\n            stack.push(current_bracket)\n        elif current_bracket.is_close():\n            if stack.is_empty():\n                # Unmatched closing bracket.\n                result = CheckResult(balanced=False, error_message=\"Unmatched closing bracket.\")\n                return result.as_bool()\n            \n            top_bracket = stack.pop()\n            if not top_bracket.matches(current_bracket):\n                # Mismatch between opening and closing brackets.\n                result = CheckResult(balanced=False, error_message=\"Mismatched opening and closing brackets.\")\n                return result.as_bool()\n    \n    # After iterating, check if the stack is empty.\n    if stack.is_empty():\n        result = CheckResult(balanced=True)\n        return result.as_bool()\n    else:\n        # Unmatched opening brackets left on the stack.\n        result = CheckResult(balanced=False, error_message=\"Unmatched opening brackets.\")\n        return result.as_bool()"}
{"task_id": "Mbpp/772", "solution": "from typing import List\nclass Word:\n    \"\"\"Value object for a word token.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's text.\"\"\"\n        return len(self.text)\nclass Tokenizer:\n    \"\"\"Splits text into Word objects.\"\"\"\n    def tokenize(self, text: str) -> List[Word]:\n        \"\"\"Tokenizes the input string into a list of Word objects.\"\"\"\n        # Python's str.split() without arguments splits on any whitespace\n        # and removes empty strings, effectively collapsing multiple spaces.\n        tokens = text.split()\n        return [Word(t) for t in tokens]\nclass Filter:\n    \"\"\"Filters a list of Word objects by length.\"\"\"\n    def filterByLength(self, words: List[Word], k: int) -> List[Word]:\n        \"\"\"Removes words whose length equals k.\"\"\"\n        return [word for word in words if word.length() != k]\nclass Normalizer:\n    \"\"\"Normalizes a list of Word objects into a space-separated string.\"\"\"\n    def normalize(self, words: List[Word]) -> str:\n        \"\"\"Joins word texts with single spaces and trims.\"\"\"\n        word_texts = [word.text for word in words]\n        # ' '.join handles an empty list by returning an empty string.\n        return ' '.join(word_texts)\nclass RemoveLength:\n    \"\"\"Orchestrates tokenization, filtering, and normalization.\"\"\"\n    def __init__(self, input_string: str, k: int):\n        self.input_string = input_string\n        self.k = k\n\n    def execute(self) -> str:\n        \"\"\"Executes the sequence to remove words of length k.\"\"\"\n        tokenizer = Tokenizer()\n        tokens = tokenizer.tokenize(self.input_string)\n\n        word_filter = Filter()\n        kept_tokens = word_filter.filterByLength(tokens, self.k)\n\n        normalizer = Normalizer()\n        result_string = normalizer.normalize(kept_tokens)\n\n        return result_string\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words with k length from the given string.\n    \"\"\"\n    orchestrator = RemoveLength(input_string, k)\n    return orchestrator.execute()"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst: list[int]) -> bool:\n    \"\"\"Checks if every number at an odd index in the list is an odd number.\"\"\"\n    for i in range(len(lst)):\n        if i % 2 == 1:  # Check if the current index is odd\n            if lst[i] % 2 == 0:  # If at an odd index, check if the value is even\n                return False  # An odd index contains an even number, so return False\n    return True  # All odd-indexed numbers were odd (or there were no odd indices)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source, substring):\n    \"\"\"\n    Locate the first (leftmost) occurrence of 'substring' in 'source'.\n    Returns a tuple (substring, start_index, end_index) or None.\n    \"\"\"\n    start_index = source.find(substring)\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    This function performs a single pass over the input list to group identical adjacent elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[-1]:\n            current_group.append(input_list[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [input_list[i]]\n\n    packed_list.append(current_group) # Add the last group\n\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "import math\nclass Number:\n    \"\"\"A wrapper for integer input, providing validation capabilities.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"\n        Checks if the wrapped value is a valid integer.\n        This method is simplified to always return True to comply with the\n        strict output constraint of not adding 'isinstance()' checks.\n        \"\"\"\n        return True # Simplified to comply with \"DO NOT add isinstance() checks\"\nclass Result:\n    \"\"\"Encapsulates the divisor count and whether the count is even.\"\"\"\n    def __init__(self, divisor_count: int):\n        self.divisor_count = divisor_count\n        self.is_even = (divisor_count % 2 == 0)\nclass DivisorCounter:\n    \"\"\"Provides methods to count divisors and check their parity.\"\"\"\n    def count_divisors(self, n: int) -> int:\n        \"\"\"\n        Computes the number of positive divisors for a given integer n.\n        Handles non-positive n by considering the absolute value, returning 0 for n=0.\n        \"\"\"\n        if n == 0:\n            return 0\n        \n        abs_n = abs(n)\n        count = 0\n        limit = int(math.sqrt(abs_n))\n        for i in range(1, limit + 1):\n            if abs_n % i == 0:\n                if i * i == abs_n:\n                    count += 1\n                else:\n                    count += 2\n        return count\n\n    def is_count_even(self, n: int) -> bool:\n        \"\"\"Checks if the count of positive divisors for n is even.\"\"\"\n        divisor_count = self.count_divisors(n)\n        result = Result(divisor_count)\n        return result.is_even\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for n is even.\n    This function delegates to internal helper classes for computation.\n    \"\"\"\n    # Validate n using Number class as per design sequence.\n    # The actual validation logic in Number.is_valid is constrained to avoid 'isinstance'.\n    number_wrapper = Number(n)\n    if not number_wrapper.is_valid():\n        # Per strict output constraints, no explicit error raising here.\n        pass\n\n    counter = DivisorCounter()\n    return counter.is_count_even(n)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(values: list) -> int:\n    \"\"\"Calculates the sum of all odd-length contiguous subarrays of the input list.\"\"\"\n\n    # Define domain classes inline as per design context for self-containment.\n    class Validator:\n        def __init__(self):\n            pass\n\n        def validate_input(self, values: list) -> bool:\n            \"\"\"Validates if the input is a list of integers.\"\"\"\n            if not isinstance(values, list):\n                return False\n            for item in values:\n                if not isinstance(item, int):\n                    return False\n            return True\n\n    class Array:\n        def __init__(self, values: list):\n            self.values = values\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the array.\"\"\"\n            return len(self.values)\n\n        def get_subarray(self, start: int, end: int) -> list:\n            \"\"\"Returns a slice of the array.\"\"\"\n            return self.values[start:end]\n\n    class Subarray:\n        def __init__(self, values: list):\n            self.values = values\n            self.length = len(values)\n\n        def sum(self) -> int:\n            \"\"\"Calculates the sum of elements in the subarray.\"\"\"\n            return sum(self.values)\n\n    class Result:\n        def __init__(self, total_sum: int = 0):\n            self.total_sum = total_sum\n\n        def add(self, value: int) -> None:\n            \"\"\"Adds a value to the total sum.\"\"\"\n            self.total_sum += value\n\n    validator = Validator()\n    if not validator.validate_input(values):\n        raise TypeError(\"Input must be a list of integers.\")\n\n    array = Array(values)\n    result = Result()\n    n = array.length()\n\n    for start in range(n):\n        for end in range(start + 1, n + 1):\n            sub_values = array.get_subarray(start, end)\n            if len(sub_values) % 2 == 1:\n                subarray_obj = Subarray(sub_values)\n                result.add(subarray_obj.sum())\n\n    return result.total_sum"}
{"task_id": "Mbpp/780", "solution": "from typing import Sequence, Tuple, List\ndef find_combinations(input_list: Sequence[Tuple[float, float]]) -> List[Tuple[float, float]]:\n    \"\"\"\n    Calculates element-wise sums for every unique unordered pair of 2-element numeric tuples.\n    Returns an empty list if there are fewer than two input tuples.\n    \"\"\"\n    _validate_input(input_list)\n    n = len(input_list)\n    if n < 2:\n        return []\n    output: List[Tuple[float, float]] = []\n    for i in range(n - 1):\n        a_i, b_i = input_list[i]\n        for j in range(i + 1, n):\n            a_j, b_j = input_list[j]\n            output.append((float(a_i + a_j), float(b_i + b_j)))\n    return output"}
{"task_id": "Mbpp/777", "solution": "import numbers\nfrom typing import Dict, List\ndef find_sum(input_list: List) -> \"numbers.Number\":\n    \"\"\"\n    Finds the sum of non-repeated elements in a given list.\n    Raises TypeError if the input is not a list of numeric values.\n    \"\"\"\n\n    class Validator:\n        \"\"\"Validates that the input is a list of numeric elements.\"\"\"\n        def validate_input(self, input_list: List) -> bool:\n            if not isinstance(input_list, list):\n                return False\n            for element in input_list:\n                if not isinstance(element, numbers.Number):\n                    return False\n            return True\n\n    class FrequencyMap:\n        \"\"\"Builds and provides access to element frequencies.\"\"\"\n        def __init__(self, frequency_dict: Dict[numbers.Number, int]):\n            self.map = frequency_dict\n\n        @staticmethod\n        def build(input_list: List) -> \"FrequencyMap\":\n            freq_dict: Dict[numbers.Number, int] = {}\n            for item in input_list:\n                freq_dict[item] = freq_dict.get(item, 0) + 1\n            return FrequencyMap(freq_dict)\n\n        def get_count(self, value: \"numbers.Number\") -> int:\n            return self.map.get(value, 0)\n\n    class ResultSum:\n        \"\"\"Computes the sum of elements that appear exactly once.\"\"\"\n        @staticmethod\n        def compute(freqmap: FrequencyMap) -> \"numbers.Number\":\n            total_sum: \"numbers.Number\" = 0\n            for value, count in freqmap.map.items():\n                if count == 1:\n                    total_sum += value\n            return total_sum\n\n    validator = Validator()\n    if not validator.validate_input(input_list):\n        raise TypeError(\"input must be a list of numeric values\")\n\n    freq = FrequencyMap.build(input_list)\n    return ResultSum.compute(freq)"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\ndef _find_first_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"Scans left-to-right to find the first odd integer.\"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    return None\ndef _find_first_even(numbers: List[int]) -> Optional[int]:\n    \"\"\"Scans left-to-right to find the first even integer.\"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    return None\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and odd number of a given list.\n    If either is not found, the product is 0 as per unspecified behavior for missing parity.\n    \"\"\"\n    first_odd = _find_first_odd(numbers)\n    first_even = _find_first_even(numbers)\n\n    if first_odd is None or first_even is None:\n        return 0\n    else:\n        return first_odd * first_even"}
{"task_id": "Mbpp/785", "solution": "from typing import List, Tuple\nclass TupleString:\n    \"\"\"Holds the raw input string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\nclass IntegerTuple:\n    \"\"\"Holds a list of integer elements and provides tuple conversion.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def as_tuple(self) -> Tuple[int, ...]:\n        return tuple(self.elements)\nclass WhitespaceTrimmer:\n    \"\"\"Trims leading and trailing whitespace from a string.\"\"\"\n    def trim(self, s: str) -> str:\n        return s.strip()\nclass Parser:\n    \"\"\"Parses a tuple string into a list of integers.\"\"\"\n    def parse(self, s: str) -> List[int]:\n        # Validate s starts with '(' and ends with ')'.\n        if not (s.startswith('(') and s.endswith(')')):\n            raise ValueError(\"Input string must start with '(' and end with ')'.\")\n\n        # Extract inner content between parentheses.\n        inner_content = s[1:-1]\n\n        # Use WhitespaceTrimmer.trim on inner content.\n        trimmed_inner_content = WhitespaceTrimmer().trim(inner_content)\n\n        # Treat empty inner content (i.e., \"()\") as malformed.\n        if not trimmed_inner_content:\n            raise ValueError(\"Empty tuple '()' is not supported.\")\n\n        # Tokenize inner content by comma.\n        tokens = trimmed_inner_content.split(',')\n        \n        result_elements: List[int] = []\n        for token in tokens:\n            # Trim each token individually using WhitespaceTrimmer.trim.\n            trimmed_token = WhitespaceTrimmer().trim(token)\n            \n            # Convert each trimmed token to int, raising ValueError on conversion failure.\n            try:\n                result_elements.append(int(trimmed_token))\n            except ValueError:\n                raise ValueError(f\"Invalid integer token: '{token}'. Cannot convert to integer.\")\n\n        return result_elements\nclass TupleStrIntFunction:\n    \"\"\"Adapter to orchestrate parsing and model construction.\"\"\"\n    def tuple_str_int(self, input: str) -> Tuple[int, ...]:\n        _ = TupleString(input)\n\n        list_of_ints = Parser().parse(input)\n\n        integer_tuple_model = IntegerTuple(list_of_ints)\n\n        return integer_tuple_model.as_tuple()\ndef tuple_str_int(input: str) -> Tuple[int, ...]:\n    \"\"\"\n    Converts a tuple-formatted string of integers to an integer tuple.\n    Raises ValueError for malformed input or non-integer tokens.\n    \"\"\"\n    adapter = TupleStrIntFunction()\n    return adapter.tuple_str_int(input)"}
