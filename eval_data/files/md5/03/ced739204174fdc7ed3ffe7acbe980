{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2 inclusive.\n    Assumes n is an integer; no input validation is performed.\n    \"\"\"\n    total_sum = 0\n    # Calculate the upper bound for i (inclusive)\n    i_max = n // 2\n    \n    # Iterate from i = 0 up to i_max and sum the terms\n    for i in range(i_max + 1):\n        term = n - 2 * i\n        total_sum += term\n        \n    return total_sum"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    Delegates to an internal PairCounter class for O(n) calculation.\n    \"\"\"\n    # Helper for combinations C(n, 2)\n    def _combinations_2(n: int) -> int:\n        if n < 2:\n            return 0\n        return n * (n - 1) // 2\n\n    class PairCounter:\n        \"\"\"\n        Encapsulates counting strategies for pairs with even XOR.\n        \"\"\"\n        def count_same_parity_pairs(self, nums: list[int]) -> int:\n            \"\"\"\n            Counts pairs (i < j) in nums whose bitwise XOR is even,\n            using the parity-count optimization.\n            \"\"\"\n            even_count = 0\n            odd_count = 0\n\n            for num_val in nums:\n                if num_val % 2 == 0:\n                    even_count += 1\n                else:\n                    odd_count += 1\n\n            return _combinations_2(even_count) + _combinations_2(odd_count)\n\n        def find_even_pair(self, nums: list[int]) -> int:\n            \"\"\"\n            Validates input length and delegates to count_same_parity_pairs.\n            Returns 0 if list has fewer than two elements.\n            \"\"\"\n            if len(nums) < 2:\n                return 0\n            return self.count_same_parity_pairs(nums)\n\n    # The module-level function delegates to an instance of PairCounter.\n    return PairCounter().find_even_pair(nums)"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\ndef compute_gcd(a: int, b: int) -> int:\n    \"\"\"Return non-negative gcd(|a|, |b|).\"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a\ndef _extended_gcd_positive(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"Helper for extended_gcd, assuming a, b >= 0. Returns (g, u, v) such that a*u + b*v == g.\"\"\"\n    if b == 0:\n        return (a, 1, 0)\n\n    # s0, t0 are coefficients for r0 (current gcd candidate)\n    # s1, t1 are coefficients for r1 (next gcd candidate)\n    s0, t0 = 1, 0\n    s1, t1 = 0, 1\n    r0, r1 = a, b\n\n    while r1 != 0:\n        q = r0 // r1\n        \n        # Calculate new remainder (r_next) and new coefficients (s_next, t_next)\n        r_next = r0 - q * r1\n        s_next = s0 - q * s1\n        t_next = t0 - q * t1\n        \n        # Update current and previous values for next iteration\n        r0, r1 = r1, r_next\n        s0, s1 = s1, s_next\n        t0, t1 = t1, t_next\n        \n    return (r0, s0, t0)\ndef extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"Return (g, u, v) with a*u + b*v == g where g == gcd(a,b).\"\"\"\n    # Handle cases where a or b is zero, but not both.\n    if a == 0:\n        if b == 0:\n            return (0, 0, 0) # gcd(0,0)=0. 0*u+0*v=0.\n        return (abs(b), 0, b // abs(b))\n    if b == 0:\n        return (abs(a), a // abs(a), 0)\n\n    # For non-zero a and b, compute for absolute values first.\n    g_abs, u_val, v_val = _extended_gcd_positive(abs(a), abs(b))\n\n    # Adjust signs of u_val, v_val based on original a, b.\n    # We want a*u + b*v = g_abs.\n    # If original 'a' was negative, then 'abs(a)' was used. To balance this, 'u_val' must be negated.\n    if a < 0:\n        u_val = -u_val\n    # Similarly for 'b'.\n    if b < 0:\n        v_val = -v_val\n    \n    return (g_abs, u_val, v_val)\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"Public API as required by SRS.\n    Returns (x, y) with a*x + b*y == n if possible, otherwise None.\n    \"\"\"\n    g = compute_gcd(a, b)\n\n    # Handle the degenerate case a=0, b=0 explicitly.\n    if g == 0: # This means a=0 and b=0.\n        if n == 0:\n            return (0, 0) # 0*x + 0*y = 0; (0,0) is a valid solution.\n        else:\n            return None # 0*x + 0*y = n (for n!=0) has no solution.\n\n    # If g != 0 (meaning at least one of a, b is non-zero).\n    # A solution exists if and only if n is divisible by g.\n    if n % g != 0:\n        return None\n\n    # A solution exists. Use Extended Euclidean Algorithm to find a particular solution.\n    # We find u_bezout, v_bezout such that a*u_bezout + b*v_bezout = g.\n    # Then scale by n/g to get x_particular, y_particular for a*x + b*y = n.\n    \n    # extended_gcd returns g as the absolute GCD, u and v are adjusted for original a, b signs.\n    _, u_bezout, v_bezout = extended_gcd(a, b)\n\n    # Scale the Bezout coefficients by n/g to get a particular solution (x_p, y_p)\n    k_scale = n // g\n    x_particular = u_bezout * k_scale\n    y_particular = v_bezout * k_scale\n\n    # Normalize the solution (x, y) to a specific deterministic form.\n    # The general solution is x = x_p + t * (b/g), y = y_p - t * (a/g) for integer t.\n    # The design context requires a deterministic solution, specifically (2,1) for (2,3,7).\n    # This implies normalizing x (e.g., to be in a certain range).\n    \n    # If b is 0, the equation is ax = n. y can be any integer.\n    # Our extended_gcd for b=0 returns v=0, so y_particular will be 0.\n    # This provides a deterministic solution (n/a, 0), and no further normalization is needed for y.\n    if b == 0:\n        return (x_particular, y_particular)\n\n    # For b != 0, normalize x by adjusting 't'.\n    # b_reduced = b // g and a_reduced = a // g define the steps for x and y.\n    b_reduced = b // g\n    a_reduced = a // g\n\n    # 't_adjustment' is chosen using floor division to shift x_particular\n    # towards a canonical representative (e.g., \"smallest\" non-negative x if b_reduced > 0).\n    t_adjustment = x_particular // b_reduced\n    \n    x_final = x_particular - t_adjustment * b_reduced\n    y_final = y_particular + t_adjustment * a_reduced\n    \n    return (x_final, y_final)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    class Character:\n        \"\"\"Represents a single input character at a 1-based position.\"\"\"\n        def __init__(self, value: str, position: int) -> None:\n            self.value = value\n            self.position = position\n\n        def isAlphabetic(self) -> bool:\n            \"\"\"Checks if the character value is alphabetic.\"\"\"\n            return self.value.isalpha()\n\n        def toLower(self) -> str:\n            \"\"\"Returns the character value in lowercase.\"\"\"\n            return self.value.lower()\n\n    class InputString:\n        \"\"\"Represents the raw input string and provides 1-based access to characters.\"\"\"\n        def __init__(self, raw: str) -> None:\n            self._raw = raw\n            self._length = len(raw)\n\n        def getCharAt(self, pos: int) -> 'Character':\n            \"\"\"Returns a Character object for the given 1-based position.\"\"\"\n            return Character(self._raw[pos - 1], pos)\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the input string.\"\"\"\n            return self._length\n\n    class Alphabet:\n        \"\"\"Provides canonical English alphabet mapping (a..z) and letter lookup by 1-based index.\"\"\"\n        def __init__(self) -> None:\n            self._letters = [chr(ord('a') + i) for i in range(26)]\n\n        def letterAt(self, pos: int) -> str:\n            \"\"\"Returns the alphabet letter at the given 1-based position (1-26).\"\"\"\n            return self._letters[pos - 1]\n\n    class MatchResult:\n        \"\"\"Collects total count and matched 1-based positions.\"\"\"\n        def __init__(self) -> None:\n            self.count = 0\n            self.matchedPositions = []\n\n        def addMatch(self, pos: int) -> None:\n            \"\"\"Adds a match by incrementing the count and recording the position.\"\"\"\n            self.count += 1\n            self.matchedPositions.append(pos)\n\n    class PositionComparator:\n        \"\"\"Encapsulates per-position comparison logic and produces MatchResult.\"\"\"\n        def __init__(self, alphabet: Alphabet = None) -> None:\n            self._alphabet = alphabet if alphabet is not None else Alphabet()\n\n        def compare(self, char: Character, pos: int) -> bool:\n            \"\"\"Compares a character with the alphabet letter at the given position (case-insensitive).\"\"\"\n            return char.toLower() == self._alphabet.letterAt(pos)\n\n        def countMatches(self, input_obj: InputString) -> MatchResult:\n            \"\"\"Iterates through the input string, comparing characters to alphabet positions.\"\"\"\n            result = MatchResult()\n            # Iterate 1-based positions, up to the minimum of input length and 26\n            for i in range(1, min(input_obj.length(), 26) + 1):\n                char_obj = input_obj.getCharAt(i)\n                if char_obj.isAlphabetic():\n                    if self.compare(char_obj, i):\n                        result.addMatch(i)\n            return result\n\n    # Public API function logic\n    alphabet_instance = Alphabet()\n    comparator = PositionComparator(alphabet=alphabet_instance)\n    input_str_obj = InputString(input_string)\n    match_result = comparator.countMatches(input_str_obj)\n    return match_result.count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Return the smallest power of two greater than or equal to n. For n == 0 returns 1.\"\"\"\n    if n <= 0:\n        return 1\n    # For positive n, calculate the position of the most significant bit of (n-1).\n    # Shifting 1 by this amount yields the smallest power of 2 greater than or equal to n.\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/168", "solution": "class EqualityComparator:\n    \"\"\"Performs equality comparisons using Python's default semantics.\"\"\"\n    def equals(self, a, b) -> bool:\n        return a == b\nclass ListElement:\n    \"\"\"Represents a single numeric element from the input list.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    @property\n    def value(self):\n        return self._value\nclass InputList:\n    \"\"\"Encapsulates the provided sequence and provides iteration.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    def isEmpty(self) -> bool:\n        return not self._elements\n\n    def __iter__(self):\n        for element_value in self._elements:\n            yield ListElement(element_value)\nclass Result:\n    \"\"\"Encapsulates the integer count result.\"\"\"\n    def __init__(self, count: int):\n        self._count = count\n\n    @property\n    def count(self):\n        return self._count\nclass FrequencyFunction:\n    \"\"\"Orchestrates counting occurrences of a value in a list.\"\"\"\n    def __init__(self, input_list_data, value_to_count, comparator: EqualityComparator = None):\n        self._input_list_data = input_list_data\n        self._value_to_count = value_to_count\n        self._comparator = comparator if comparator is not None else EqualityComparator()\n\n    def frequency(self) -> int:\n        input_list = InputList(self._input_list_data)\n        if input_list.isEmpty():\n            return 0\n\n        count = 0\n        for element in input_list:\n            if self._comparator.equals(element.value, self._value_to_count):\n                count += 1\n        return Result(count).count\ndef frequency(list, value):\n    \"\"\"Return int count of occurrences of value in list.\"\"\"\n    fn = FrequencyFunction(list, value)\n    return fn.frequency()"}
