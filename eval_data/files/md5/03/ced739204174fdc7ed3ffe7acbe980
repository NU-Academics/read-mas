{"task_id": "Mbpp/585", "solution": "from typing import List, Dict, Any\nclass InputValidator:\n    \"\"\"Validates the structure and types of input items and the count 'n'.\"\"\"\n    def validate_items(self, items: List[Dict]) -> None:\n        if not isinstance(items, list):\n            raise ValueError(\"Input 'items' must be a list.\")\n        for i, item in enumerate(items):\n            if not isinstance(item, dict):\n                raise ValueError(f\"Item at index {i} must be a dictionary.\")\n            if 'name' not in item or 'price' not in item:\n                raise ValueError(f\"Item at index {i} is missing 'name' or 'price' key.\")\n            if not isinstance(item['price'], (int, float)):\n                raise ValueError(f\"Item at index {i} has non-numeric 'price'.\")\n\n    def validate_n(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\nclass ItemCollection:\n    \"\"\"Manages the collection of items for sorting and selection.\"\"\"\n    def __init__(self, items: List[Dict]) -> None:\n        self.items = items\n\n    def get_top_n(self, n: int) -> List[Dict]:\n        if n == 0:\n            return []\n        sorted_items = sorted(self.items, key=lambda item: item['price'], reverse=True)\n        return sorted_items[:n]\nclass ExpensiveItemsService:\n    \"\"\"Orchestrates validation and selection of expensive items.\"\"\"\n    def __init__(self, validator: InputValidator = None) -> None:\n        self.validator = validator if validator is not None else InputValidator()\n\n    def expensive_items(self, items: List[Dict], n: int) -> List[Dict]:\n        self.validator.validate_items(items)\n        self.validator.validate_n(n)\n        collection = ItemCollection(items)\n        return collection.get_top_n(n)\ndef expensive_items(items: List[Dict], n: int) -> List[Dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Validates inputs and returns a sorted list of items.\n    \"\"\"\n    service = ExpensiveItemsService(validator=InputValidator())\n    return service.expensive_items(items, n)"}
