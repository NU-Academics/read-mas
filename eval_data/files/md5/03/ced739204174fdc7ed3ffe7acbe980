{"task_id": "Mbpp/232", "solution": "def larg_nnum(input_list, n):\n    \"\"\"Returns a list containing the n largest items from the input list.\n    Assumes valid numeric input_list and non-negative integer n.\n    \"\"\"\n    if n == 0:\n        return []\n\n    # Sort the list in descending order to get largest items first.\n    # Slicing handles cases where n is larger than the list length by returning all elements.\n    sorted_list = sorted(input_list, reverse=True)\n\n    return sorted_list[:n]"}
{"task_id": "Mbpp/234", "solution": "class NumericInput:\n    \"\"\"Represents and validates numeric input.\"\"\"\n    def __init__(self, value: \"float | int\") -> None:\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Raises TypeError if value is not an int or float.\"\"\"\n        if not isinstance(self.value, (int, float)):\n            raise TypeError(\"side_length must be an int or float\")\n        return True\nclass Cube:\n    \"\"\"Holds a side length and computes the cube's volume.\"\"\"\n    def __init__(self, side_length: \"float | int\") -> None:\n        self.side_length = side_length\n\n    def compute_volume(self) -> \"float | int\":\n        \"\"\"Calculates the volume of the cube.\"\"\"\n        return self.side_length ** 3\nclass VolumeResult:\n    \"\"\"Container for the computed volume.\"\"\"\n    def __init__(self, value: \"float | int\") -> None:\n        self.value = value\ndef volume_cube(side_length) -> \"float | int\":\n    \"\"\"\n    Computes the volume of a cube given its side length.\n    Validates input and calculates the cube of the side length.\n    \"\"\"\n    numeric_input = NumericInput(side_length)\n    numeric_input.validate()\n\n    cube = Cube(numeric_input.value)\n    volume_value = cube.compute_volume()\n\n    volume_result = VolumeResult(volume_value)\n    return volume_result.value"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s):\n    \"\"\"Counts the number of non-empty substrings in the given string.\"\"\"\n    if s == \"\":\n        return 0\n\n    input_obj = InputString(s)\n    counter = SubstringCounter()\n    return counter.number_of_substrings(input_obj)\nclass InputString:\n    def __init__(self, value: str):\n        self.value = value\n\n    def __len__(self) -> int:\n        return len(self.value)\nclass SubstringCounter:\n    def number_of_substrings(self, s: InputString) -> int:\n        \"\"\"Counts the number of non-empty substrings for a given InputString.\"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n        \n        count = 0\n        for start in range(n):\n            for end in range(start + 1, n + 1):\n                count += 1\n        return count"}
{"task_id": "Mbpp/237", "solution": "from collections import defaultdict\nfrom typing import List, Tuple, Dict\ndef _normalize_tuple(t: tuple) -> tuple:\n    \"\"\"Normalize a 2-element tuple to (min, max) order.\"\"\"\n    return (min(t[0], t[1]), max(t[0], t[1]))\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"\n    Takes a list of tuples, normalizes them, and returns a dictionary mapping\n    each unique normalized tuple to its occurrence count.\n    \"\"\"\n    counts = defaultdict(int)\n\n    for item_tuple in input_list:\n        normalized_tuple = _normalize_tuple(item_tuple)\n        _update_counts(counts, normalized_tuple)\n\n    return dict(counts)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-numbered bit positions (1-based indexing, LSB = position 1) of an integer to 1.\n    This operation preserves all other bits from the input number.\n    \"\"\"\n    max_bits = n.bit_length()\n    \n    # Generate a mask with 1s at even-numbered bit positions up to max_bits.\n    mask = 0\n    for i in range(1, max_bits + 1):\n        if i % 2 == 0:\n            mask |= (1 << (i - 1))\n            \n    return n | mask"}
{"task_id": "Mbpp/242", "solution": "def count_charac(input: str) -> int:\n    \"\"\"Module-level API required by SRS; delegates to CharacterCounter.\"\"\"\n    class CharacterCounter:\n        def count_charac(self, input_string: str) -> int:\n            \"\"\"Count all characters in input including whitespace; return 0 for empty string.\"\"\"\n            return len(input_string)\n\n    counter = CharacterCounter()\n    return counter.count_charac(input)"}
{"task_id": "Mbpp/239", "solution": "class ValidationError(Exception):\n    \"\"\"Exception type representing validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass ParameterSet:\n    \"\"\"Encapsulates input parameters m and n and performs validation.\"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates m and n are integers > 0. Raises ValidationError on failure.\"\"\"\n        if not isinstance(self.m, int) or not isinstance(self.n, int):\n            raise ValidationError(\"m and n must be integers.\")\n        if self.m <= 0 or self.n <= 0:\n            raise ValidationError(\"m and n must be positive integers.\")\nclass SequenceCounter:\n    \"\"\"Provides counting/enumeration of valid sequences per a ParameterSet.\"\"\"\n    def count(self, params: ParameterSet) -> int:\n        \"\"\"\n        Computes the number of valid sequences using dynamic programming.\n        Returns 0 if no sequences, and params.m when params.n == 1.\n        \"\"\"\n        m = params.m\n        n = params.n\n\n        if n == 1:\n            return m\n\n        # prev_dp stores counts for sequences of length k-1, where prev_dp[j] is the count\n        # of sequences ending with value j.\n        # Initialize for length 1 sequences: any value from 1 to m is a valid sequence of length 1.\n        prev_dp = [0] * (m + 1)\n        for j in range(1, m + 1):\n            prev_dp[j] = 1\n\n        # Iterate for lengths from 2 up to n\n        for _ in range(2, n + 1):\n            curr_dp = [0] * (m + 1)\n            \n            # Calculate prefix sums for prev_dp to efficiently sum counts of previous elements\n            # prefix_sums[x] = sum(prev_dp[1]...prev_dp[x])\n            prefix_sums = [0] * (m + 1)\n            for j in range(1, m + 1):\n                prefix_sums[j] = prefix_sums[j-1] + prev_dp[j]\n\n            # For each possible current_val, calculate the number of sequences ending with it\n            for current_val in range(1, m + 1):\n                # A previous element prev_val must satisfy current_val >= 2 * prev_val\n                # This implies prev_val <= current_val // 2\n                max_prev_val = current_val // 2\n                if max_prev_val >= 1:\n                    # The number of ways to form a sequence ending with current_val\n                    # is the sum of ways to form sequences of length k-1 ending with\n                    # any value from 1 up to max_prev_val.\n                    curr_dp[current_val] = prefix_sums[max_prev_val]\n                # If max_prev_val < 1, no valid previous element exists, so count remains 0.\n            \n            # Update prev_dp for the next iteration\n            prev_dp = curr_dp\n\n        # The total count for sequences of length n is the sum of all counts in the final prev_dp\n        return sum(prev_dp)\n\n    def enumerateSequences(self, params: ParameterSet):\n        \"\"\"Generator yielding each valid sequence (tuple/list of ints). (Not required by count).\"\"\"\n        # This method is part of the design but not directly used by the 'count' logic.\n        pass\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n with elements within [1, m]\n    where each element is at least twice the previous one.\n    \"\"\"\n    params = ParameterSet(m, n)\n    params.validate() # Validates inputs and raises ValidationError on failure.\n\n    counter = SequenceCounter()\n    return counter.count(params)"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1: list, list2: list) -> list:\n    \"\"\"Replaces the last element of the first list with the elements of the second list.\n    Returns a new list without modifying the input lists.\"\"\"\n    if len(list1) > 0:\n        result_prefix = list1[:-1]\n    else:\n        result_prefix = []\n    result = result_prefix + list2\n    return result"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"Validate n is int and return smallest perfect square strictly greater than n.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"next_Perfect_Square: n must be int\")\n\n    # Find the integer floor of the square root of n\n    # For negative n, math.isqrt will raise ValueError, but the design allows it if n is int.\n    # The requirement implicitly means for all integers `n`.\n    # Let's consider n = -5. sqrt(-5) is complex. The smallest perfect square > -5 is 0.\n    # Let's consider n = 0. sqrt(0) = 0. The smallest perfect square > 0 is 1.\n    # If n is negative, math.isqrt(n) will raise ValueError if n < 0.\n    # The design states \"The SRS/BizRules indicate negative integers should be handled by same rule (return smallest perfect square > n).\"\n    # And \"math.isqrt(n)       # integer floor(sqrt(n))\".\n    # For n < 0, the next perfect square is 0 if n < 0 and 0 is not n. If n is a negative square, say -4, then the next perfect square is 0.\n    # If n = -1, math.isqrt(-1) fails.\n    # This implies a slight divergence from a literal math.isqrt(n) for n < 0.\n    # The problem asks for \"next perfect square greater than a given number\".\n    # Perfect squares are non-negative: 0, 1, 4, 9, ...\n    # If n < 0, the smallest perfect square greater than n is 0.\n    # If n = 0, the smallest perfect square greater than 0 is 1.\n    # If n = 35, sqrt(35) approx 5.9. isqrt(35) = 5. (5*5 <= 35) -> m = 6. 6*6 = 36. Correct.\n    # If n = 36, sqrt(36) = 6. isqrt(36) = 6. (6*6 <= 36) -> m = 7. 7*7 = 49. Correct.\n\n    if n < 0:\n        return 0 # The smallest perfect square is 0. If n is negative, 0 is the smallest perfect square greater than n.\n    \n    m = math.isqrt(n)\n    \n    # If m*m is less than or equal to n, we need to go to the next integer m to find the next perfect square.\n    # For example, if n=35, m=5, m*m=25. 25 <= 35, so m becomes 6. Result 36.\n    # If n=36, m=6, m*m=36. 36 <= 36, so m becomes 7. Result 49.\n    if m * m <= n:\n        m += 1\n    \n    return m * m"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"Computes the length of the longest palindromic subsequence in the given string.\n    This function delegates to an internal dynamic programming algorithm.\n    \"\"\"\n\n    class InputString:\n        \"\"\"Encapsulates the literal input string for processing.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value = value\n\n    class Result:\n        \"\"\"Encapsulates the integer length result of the LPS computation.\"\"\"\n        def __init__(self, length: int) -> None:\n            self.length = length\n\n    class LPSFunction:\n        \"\"\"Computes the longest palindromic subsequence length using dynamic programming.\"\"\"\n        def compute(self, input_str: InputString) -> Result:\n            s_val = input_str.value\n            n = len(s_val)\n\n            if n == 0:\n                return Result(0)\n\n            # dp[i][j] stores the length of the LPS of substring s[i...j]\n            dp = [[0 for _ in range(n)] for _ in range(n)]\n\n            # All single characters are palindromes of length 1\n            for i in range(n):\n                dp[i][i] = 1\n\n            # Fill the DP table for lengths from 2 to n\n            for length in range(2, n + 1):\n                for i in range(n - length + 1):\n                    j = i + length - 1\n                    if s_val[i] == s_val[j]:\n                        if length == 2:\n                            dp[i][j] = 2\n                        else:\n                            dp[i][j] = 2 + dp[i + 1][j - 1]\n                    else:\n                        dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n            return Result(dp[0][n - 1])\n\n    input_obj = InputString(s)\n    compute = LPSFunction()\n    result = compute.compute(input_obj)\n    return result.length"}
{"task_id": "Mbpp/245", "solution": "from typing import List\ndef computeLISums(arr: List[int]) -> List[int]:\n    \"\"\"Computes maximum sum of an increasing subsequence ending at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lis = [0] * n\n    for i in range(n):\n        lis[i] = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                lis[i] = max(lis[i], lis[j] + arr[i])\n    return lis\ndef computeLDSums(arr: List[int]) -> List[int]:\n    \"\"\"Computes maximum sum of a decreasing subsequence starting at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lds = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                lds[i] = max(lds[i], lds[j] + arr[i])\n    return lds\ndef combineToMaxBitonic(lis: List[int], lds: List[int], arr: List[int]) -> int:\n    \"\"\"Combines LIS and LDS sums to find the maximum bitonic subsequence sum.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    \n    max_bitonic_sum = float('-inf') # Initialize with negative infinity to handle arrays with negative numbers.\n    for i in range(n):\n        # A bitonic subsequence with arr[i] as the peak is formed by an increasing subsequence ending at arr[i]\n        # and a decreasing subsequence starting at arr[i].\n        # Since arr[i] is counted in both LIS and LDS sums, it must be subtracted once.\n        current_bitonic_sum = lis[i] + lds[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n    \n    # If the array contains elements, max_bitonic_sum will be at least max(arr) as a single element is bitonic.\n    # The default 0 for empty array covers that case.\n    return int(max_bitonic_sum) # Ensure integer return type.\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    lis_sums = computeLISums(arr)\n    lds_sums = computeLDSums(arr)\n    \n    return combineToMaxBitonic(lis_sums, lds_sums, arr)"}
{"task_id": "Mbpp/250", "solution": "def count_X(tuple_param, element_param) -> int:\n    \"\"\"Count occurrences of element_param in tuple_param using '==' comparisons.\n\n    Args:\n        tuple_param: tuple -- input immutable sequence\n        element_param: any -- element to count in tuple_param\n\n    Returns:\n        int -- number of occurrences (0 if none)\n    \"\"\"\n    count = 0\n    for item in tuple_param:\n        if item == element_param:\n            count += 1\n    return count"}
