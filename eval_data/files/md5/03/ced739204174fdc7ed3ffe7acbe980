{"task_id": "Mbpp/793", "solution": "def last(sorted_list, target):\n    \"\"\"Return 0-based index of the last occurrence of target in sorted_list.\n\n    Returns:\n        int: index of last occurrence (0-based) or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(sorted_list) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] == target:\n            result = mid\n            low = mid + 1  # Try to find a later occurrence in the right half\n        elif sorted_list[mid] < target:\n            low = mid + 1\n        else: # sorted_list[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict):\n    \"\"\"\n    Calculates the sum of all numeric items (int or float) in the given dictionary's values.\n    Raises TypeError if input is not a dictionary or if any value is non-numeric (including bool).\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input must be a dict\")\n\n    if not input_dict:\n        return 0\n\n    for value in input_dict.values():\n        # Validate that values are numeric (int or float) and explicitly not boolean.\n        if isinstance(value, bool) or not isinstance(value, (int, float)):\n            raise TypeError(\"all values must be numeric (int or float)\")\n\n    # The built-in sum() handles type promotion correctly:\n    # if all values are int, the sum is int; if any value is float, the sum is float.\n    return sum(input_dict.values())"}
{"task_id": "Mbpp/794", "solution": "class InputString:\n    \"\"\"Wraps the raw input string and provides length accessor.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass MatchResult:\n    \"\"\"Data holder for boolean matched result.\"\"\"\n    def __init__(self, matched: bool):\n        self.matched = matched\nclass TextMatcherFunction:\n    \"\"\"Encapsulates the string matching algorithm.\"\"\"\n    name: str = \"text_starta_endb\"\n    parameterType: str = \"string\"\n\n    def match(self, inputString: InputString) -> MatchResult:\n        \"\"\"Determines if the InputString begins with 'a' and ends with 'b'.\"\"\"\n        if inputString.length() >= 2:\n            is_matched = (inputString.value[0] == 'a' and inputString.value[-1] == 'b')\n        else:\n            is_matched = False\n        return MatchResult(matched=is_matched)\ndef text_starta_endb(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a' and ends with 'b'.\n    Delegates the matching logic to a TextMatcherFunction instance.\n    \"\"\"\n    input_obj = InputString(input_string)\n    matcher = TextMatcherFunction()\n    result = matcher.match(input_obj)\n    return result.matched"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Finds the sum of all odd natural numbers within the range l and r (inclusive).\n    Natural numbers are defined as integers greater than or equal to 1.\n    \"\"\"\n\n    def is_natural(n):\n        \"\"\"Checks if a number is a natural number (>= 1).\"\"\"\n        return n >= 1\n\n    def is_odd(n):\n        \"\"\"Checks if a number is odd.\"\"\"\n        return n % 2 == 1\n\n    def _filter_odds_in_range(start, end):\n        \"\"\"Generates odd natural numbers within the given inclusive range.\"\"\"\n        for n in range(start, end + 1):\n            if is_natural(n) and is_odd(n):\n                yield n\n\n    return sum(_filter_odds_in_range(l, r))"}
{"task_id": "Mbpp/798", "solution": "def _sum(numbers: list) -> float:\n    \"\"\"\n    Calculates the sum of numeric elements in a list.\n    Validates input type and element types, raising TypeError for invalid inputs.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total = 0\n    for element in numbers:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"List elements must be numeric (int or float).\")\n        total += element\n    return total"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(value: str) -> str:\n    \"\"\"Remove spaces, tabs and newlines from value and return the resulting string.\"\"\"\n    filtered_chars = []\n    for char in value:\n        if char not in {' ', '\\t', '\\n'}:\n            filtered_chars.append(char)\n    return ''.join(filtered_chars)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(n: int, d: int) -> int:\n    \"\"\"Rotate 32-bit value n left by d positions and return masked uint32 result.\n    Satisfies: left_rotate(16, 2) == 64.\n    \"\"\"\n    MASK = 0xFFFFFFFF\n    \n    # Normalize n to a 32-bit unsigned integer\n    value = n & MASK\n    \n    # Compute effective rotation amount\n    s = d % 32\n    \n    # If shift amount is 0, return the original normalized value\n    if s == 0:\n        return value\n        \n    # Perform the circular left rotation\n    # Shift left part: (value << s) & MASK handles bits shifted into view\n    # Shift right part: (value >> (32 - s)) & MASK handles bits that wrap around\n    result = ((value << s) & MASK) | ((value >> (32 - s)) & MASK)\n    \n    return result"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Return the number of equal integers among the three inputs:\n       3 (all equal), 2 (exactly two equal), or 0 (all different).\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: float) -> bool:\n    \"\"\"Checks if the given number is a perfect square.\n    Handles non-negative floats and integers, returning False for negative inputs.\"\"\"\n    if number < 0:\n        return False\n    # Use math.isqrt for integers or numbers that can be exactly represented as integers,\n    # and math.sqrt for floats, then check if the square of the result is equal to the original number.\n    # The design context implies accepting floats.\n    if number == int(number):\n        root = int(number**0.5)\n        return root * root == number\n    else:\n        # For floating point numbers, direct comparison can be tricky due to precision.\n        # However, the design implies conventional behavior.\n        # Check if the square root is an integer (within a small epsilon).\n        root = number**0.5\n        return root == int(root)"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(list_of_integers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    def validate_integer_list(seq) -> None:\n        \"\"\"Validates that the input is a list or tuple of integers.\"\"\"\n        if not isinstance(seq, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple of integers.\")\n        for element in seq:\n            if not isinstance(element, int):\n                raise TypeError(f\"All elements in the sequence must be integers, but found {type(element).__name__}.\")\n\n    validate_integer_list(list_of_integers)\n\n    for number in list_of_integers:\n        if number % 2 == 0:\n            return True\n    return False"}
