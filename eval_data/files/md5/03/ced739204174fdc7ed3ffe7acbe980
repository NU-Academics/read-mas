{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    \"\"\"\n    Finds all possible combinations (subsets) of the elements of a given list,\n    returning them in a specific deterministic order.\n    \"\"\"\n    all_combinations = [[]]  # Initialize with the empty combination.\n\n    # Iterate through each element of the input list to build new combinations.\n    for element in input_list:\n        # Store new combinations temporarily to avoid modifying the list being iterated over.\n        new_combinations_batch = []\n        \n        # For each existing combination, create a new one by prepending the current element.\n        for existing_combination in all_combinations:\n            new_combinations_batch.append([element] + existing_combination)\n        \n        # Add all newly formed combinations to the main list.\n        all_combinations.extend(new_combinations_batch)\n\n    return all_combinations"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    # This function finds the maximum product of a contiguous subarray within the given array.\n    # It handles positive, negative, and zero values by tracking current max and min products.\n    \n    if not arr:  # Assuming non-empty array per design, but handling for robustness.\n        return 0 # Or raise an error if an empty array is strictly disallowed\n\n    current_max = arr[0]\n    current_min = arr[0]\n    best_product = arr[0]\n\n    for i in range(1, len(arr)):\n        x = arr[i]\n        \n        # If current number is negative, swap current_max and current_min\n        # because multiplying by a negative number flips the signs.\n        if x < 0:\n            current_max, current_min = current_min, current_max\n        \n        # Update current_max and current_min for the current element x\n        # The new current_max can be x itself or product of x with current_max\n        current_max = max(x, current_max * x)\n        # The new current_min can be x itself or product of x with current_min\n        current_min = min(x, current_min * x)\n        \n        # Update the overall best product found so far\n        best_product = max(best_product, current_max)\n            \n    return best_product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Computes the pairwise sum of neighboring elements in a tuple. Returns an empty tuple if input has fewer than two elements.\"\"\"\n    if len(input_tuple) < 2:\n        return ()\n    sums = [input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1)]\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    \"\"\"\n\n    # Domain models\n    class ArrayInput:\n        def __init__(self, elements: list):\n            self.elements = elements\n\n    class Subsequence:\n        def __init__(self, elements: list):\n            self.elements = elements\n\n    # Subsequence generator utility\n    def generate_strictly_increasing_subsequences(arr_input: ArrayInput) -> list:\n        \"\"\"\n        Enumerates all strictly increasing subsequences (including length 1),\n        preserving original order as per the design context.\n        \"\"\"\n        elements = arr_input.elements\n        n = len(elements)\n        if n == 0:\n            return []\n\n        # dp[i] will store a list of lists, where each inner list is a strictly\n        # increasing subsequence ending with elements[i].\n        dp = [[] for _ in range(n)]\n\n        all_subsequences_list = []\n\n        for i in range(n):\n            # Current element always forms a subsequence of length 1 (FR4)\n            dp[i].append([elements[i]])\n\n            for j in range(i):\n                # Extend subsequences ending at elements[j] if elements[i]\n                # is strictly greater (FR2, BR-Strictness)\n                if elements[i] > elements[j]:\n                    for sub in dp[j]:\n                        dp[i].append(sub + [elements[i]])\n\n            # Add all subsequences ending at elements[i] to the global list,\n            # wrapped in Subsequence objects.\n            all_subsequences_list.extend([Subsequence(s) for s in dp[i]])\n\n        return all_subsequences_list\n\n    # Product Calculator application logic\n    class ProductCalculator:\n        def computeProduct(self, subseq: Subsequence):\n            \"\"\"Computes the product of elements in a subsequence.\"\"\"\n            product = 1\n            for x in subseq.elements:\n                product *= x\n            return product\n\n        def max_product_internal(self, arr_input: ArrayInput):\n            \"\"\"\n            Calculates the maximum product across all strictly increasing subsequences (FR3).\n            Handles initial max_prod value robustly for positive/negative numbers.\n            \"\"\"\n            subsequences = generate_strictly_increasing_subsequences(arr_input)\n\n            if not subsequences:\n                # If no subsequences (e.g., empty input array), return 0.\n                return 0\n\n            # Initialize max_prod with negative infinity to correctly handle cases\n            # where all possible products might be negative.\n            max_prod = float('-inf')\n\n            for sub in subsequences:\n                current_product = self.computeProduct(sub)\n                if current_product > max_prod:\n                    max_prod = current_product\n            return max_prod\n\n    # Public API wrapper: constructs ArrayInput, instantiates ProductCalculator,\n    # and invokes the internal max_product logic.\n    array_input = ArrayInput(arr)\n    calculator = ProductCalculator()\n    return calculator.max_product_internal(array_input)"}
{"task_id": "Mbpp/471", "solution": "class InvalidModulusException(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef find_remainder(arr, n):\n    \"\"\"\n    Compute (product of arr) mod n using iterative modular reduction.\n    Raises InvalidModulusException if n is not positive, and TypeError if arr contains non-integers.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidModulusException(\"n must be a positive integer\")\n\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple\")\n\n    current_product = 1\n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements in arr must be integers\")\n        current_product = (current_product * (x % n)) % n\n\n    return current_product"}
{"task_id": "Mbpp/472", "solution": "from typing import List\ndef check_Consecutive(items: List[int]) -> bool:\n    \"\"\"Return True if items are consecutive ascending integers (each next == prev + 1).\n\n    Preconditions: items must be a list of ints. Enforced by raising TypeError when violated.\n    Empty or single-element lists return True.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list of integers\")\n    for i in range(1, len(items)):\n        if not isinstance(items[i-1], int) or not isinstance(items[i], int):\n            raise TypeError(\"all elements of items must be ints\")\n        if items[i] != items[i-1] + 1:\n            return False\n    return True"}
