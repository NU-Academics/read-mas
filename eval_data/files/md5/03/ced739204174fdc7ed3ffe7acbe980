{"task_id": "Mbpp/274", "solution": "import math\nclass Validator:\n    \"\"\"Validates if an input is a positive integer.\"\"\"\n    def is_positive_integer(self, x) -> bool:\n        \"\"\"Checks if x is an integer strictly greater than 0.\"\"\"\n        return isinstance(x, int) and x > 0\n\n    def raise_on_invalid(self, x) -> None:\n        \"\"\"Raises ValueError if x is not a positive integer.\"\"\"\n        if not self.is_positive_integer(x):\n            raise ValueError(\"Input 'n' must be a positive integer (n > 0).\")\nclass BinomialCalculator:\n    \"\"\"Calculates binomial coefficients for a given n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.__n = n\n\n    def C(self, n_val: int, k: int) -> int:\n        \"\"\"Computes the binomial coefficient C(n, k).\"\"\"\n        return math.comb(n_val, k)\n\n    def coefficients(self) -> list[int]:\n        \"\"\"Returns a list of binomial coefficients C(n, k) for k from 0 to n.\"\"\"\n        return [self.C(self.__n, k) for k in range(0, self.__n + 1)]\nclass Result:\n    \"\"\"A simple wrapper for the integer sum result.\"\"\"\n    def __init__(self, sum_value: int) -> None:\n        self.__sum_value = sum_value\n\n    def as_int(self) -> int:\n        \"\"\"Returns the wrapped integer sum.\"\"\"\n        return self.__sum_value\nclass EvenBinomialFunction:\n    \"\"\"Orchestrates the calculation of the sum of even-indexed binomial coefficients.\"\"\"\n    def __init__(self, n: int, validator: Validator = None, calculator: BinomialCalculator = None) -> None:\n        self.__n = n\n        self.__validator = validator if validator is not None else Validator()\n        self.__calculator = calculator if calculator is not None else BinomialCalculator(n)\n\n    def validate_input(self) -> None:\n        \"\"\"Validates the input n using the injected validator.\"\"\"\n        self.__validator.raise_on_invalid(self.__n)\n\n    def compute(self) -> Result:\n        \"\"\"Computes the sum of binomial coefficients for even indices.\"\"\"\n        self.validate_input()\n        \n        all_coefficients = self.__calculator.coefficients()\n        even_index_sum = 0\n        for k, coeff in enumerate(all_coefficients):\n            if k % 2 == 0:\n                even_index_sum += coeff\n        \n        return Result(even_index_sum)\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a positive integer n.\n    This function acts as a public API wrapper.\n    \"\"\"\n    even_binomial_calculator = EvenBinomialFunction(n)\n    result = even_binomial_calculator.compute()\n    return result.as_int()"}
{"task_id": "Mbpp/276", "solution": "class MathConstant:\n    PI: float = 3.141592653589793\nclass Cylinder:\n    def __init__(self, radius: float, height: float):\n        self.radius: float = radius\n        self.height: float = height\n        self.volume: float = 0.0\n    def computeVolume(self) -> float:\n        self.volume = MathConstant.PI * (self.radius ** 2) * self.height\n        return self.volume\nclass InputValidator:\n    def validateNumeric(self, value) -> bool:\n        return isinstance(value, (int, float))\nclass VolumeCalculator:\n    def volume_cylinder(self, radius: float, height: float) -> float:\n        c = Cylinder(radius, height)\n        return float(c.computeVolume())\ndef volume_cylinder(radius, height) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    Validates inputs and delegates computation to internal components.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validateNumeric(radius):\n        raise ValueError(\"radius must be numeric\")\n    if not validator.validateNumeric(height):\n        raise ValueError(\"height must be numeric\")\n    calc = VolumeCalculator()\n    return calc.volume_cylinder(float(radius), float(height))"}
{"task_id": "Mbpp/273", "solution": "class Validator:\n    \"\"\"\n    A stateless utility class for validating inputs to the substract_elements function.\n    All methods are static and raise exceptions on validation failures.\n    \"\"\"\n\n    @staticmethod\n    def validate_types(a, b):\n        \"\"\"\n        Validates that both inputs are tuples.\n        Raises TypeError if either 'a' or 'b' is not a tuple.\n        \"\"\"\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise TypeError(\"Inputs 'a' and 'b' must both be tuples.\")\n\n    @staticmethod\n    def validate_lengths(a, b):\n        \"\"\"\n        Validates that both input tuples have the same length.\n        Raises ValueError if len(a) != len(b).\n        \"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples 'a' and 'b' must have the same length.\")\n\n    @staticmethod\n    def validate_elements_numeric(a, b):\n        \"\"\"\n        Validates that all elements in both tuples are numeric (int or float).\n        Raises TypeError if any element is not int or float.\n        \"\"\"\n        for element in a + b:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in input tuples must be numeric (int or float).\")\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple element-wise.\n    Validates inputs and returns a new tuple where result[i] == a[i] - b[i].\n    \"\"\"\n    Validator.validate_types(a, b)\n    Validator.validate_lengths(a, b)\n    Validator.validate_elements_numeric(a, b)\n\n    result_list = [a[i] - b[i] for i in range(len(a))]\n    return tuple(result_list)"}
