{"task_id": "Mbpp/141", "solution": "def pancake_sort(lst: list) -> list:\n    \"\"\"Return a new list sorted in ascending order using pancake sort (prefix flips).\"\"\"\n    # Create a mutable copy of the list to perform in-place sorting\n    # and return a new list as per the signature.\n    n = len(lst)\n    temp_lst = list(lst)\n\n    # Iterate from the largest unsorted sublist down to the second smallest\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted prefix\n        max_val = temp_lst[0]\n        max_idx = 0\n        for i in range(1, current_size):\n            if temp_lst[i] > max_val:\n                max_val = temp_lst[i]\n                max_idx = i\n\n        # If the maximum element is not already at its correct sorted position\n        # (i.e., at the end of the current_size prefix)\n        if max_idx != current_size - 1:\n            # First flip: Bring the maximum element to the beginning of the list\n            # by flipping the prefix up to and including the max_idx.\n            _flip_prefix(temp_lst, max_idx + 1)\n\n            # Second flip: Bring the maximum element to its correct position\n            # at the end of the current_size prefix.\n            _flip_prefix(temp_lst, current_size)\n            \n    return temp_lst"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3) -> int:\n    \"\"\"Return the count of indices i in range 0..min(len(list1), len(list2), len(list3))-1\n    for which list1[i] == list2[i] == list3[i].\"\"\"\n    min_len = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence):\n  \"\"\"Compute the maximum absolute difference between any two numeric elements.\n\n  Parameters:\n    sequence (list or tuple): sequence of ints or floats\n\n  Returns:\n    number: the maximum absolute difference (int or float)\n\n  Raises:\n    ValueError: if sequence has fewer than two elements\n  \"\"\"\n  if len(sequence) < 2:\n    raise ValueError(\"Sequence must contain at least two elements.\")\n\n  min_val = min(sequence)\n  max_val = max(sequence)\n\n  return abs(max_val - min_val)"}
