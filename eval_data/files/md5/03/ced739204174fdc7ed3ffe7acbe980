{"task_id": "Mbpp/632", "solution": "from typing import List\ndef move_zero(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Return a list where all non-zero elements from input_list appear in their original relative order\n    followed by all zeros from input_list.\n    \"\"\"\n    nonzeros = []\n    zero_count = 0\n    for element in input_list:\n        if element != 0:\n            nonzeros.append(element)\n        else:\n            zero_count += 1\n    return nonzeros + [0] * zero_count"}
{"task_id": "Mbpp/633", "solution": "from typing import List\nclass NumberList:\n    \"\"\"Wraps a list of integers and provides methods for length and slicing.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def length(self) -> int:\n        return len(self.values)\n\n    def slice_first_n(self, n: int) -> List[int]:\n        \"\"\"Returns a slice of the list containing the first n elements.\"\"\"\n        return self.values[:n]\nclass Pair:\n    \"\"\"Represents an unordered pair of integers and computes their XOR.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def xor(self) -> int:\n        \"\"\"Computes the bitwise XOR of the two numbers in the pair.\"\"\"\n        return self.a ^ self.b\nclass Result:\n    \"\"\"Accumulates the integer sum of pairwise XORs.\"\"\"\n    def __init__(self, initial: int = 0):\n        self._sum = initial\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the accumulated sum.\"\"\"\n        self._sum += value\n\n    def value(self) -> int:\n        \"\"\"Returns the current accumulated sum.\"\"\"\n        return self._sum\nclass PairXorCalculator:\n    \"\"\"Validates inputs, enumerates pairs, computes XORs, and accumulates the sum.\"\"\"\n    def validate_inputs(self, nums: List[int], n: int) -> None:\n        # Per design constraints, no explicit isinstance checks or exceptions are added here.\n        pass\n\n    def compute_pair_xor(self, a: int, b: int) -> int:\n        \"\"\"Computes the bitwise XOR of two given integers.\"\"\"\n        return a ^ b\n\n    def pair_xor_Sum(self, nums: List[int], n: int) -> int:\n        \"\"\"Calculates the sum of XORs of all unordered pairs in the first n elements.\"\"\"\n        number_list = NumberList(nums)\n        sliced_nums = number_list.slice_first_n(n)\n        \n        result_accumulator = Result()\n        num_elements = len(sliced_nums)\n\n        for i in range(num_elements):\n            for j in range(i + 1, num_elements):\n                pair_instance = Pair(sliced_nums[i], sliced_nums[j])\n                xor_value = pair_instance.xor()\n                result_accumulator.add(xor_value)\n        \n        return result_accumulator.value()\ndef pair_xor_Sum(nums, n) -> int:\n    \"\"\"\n    Finds the sum of XOR of all pairs of numbers in the given list.\n    Only considers the first n elements for pair formation.\n    \"\"\"\n    calculator = PairXorCalculator()\n    calculator.validate_inputs(nums, n) # Validation is a no-op per design constraints\n    return calculator.pair_xor_Sum(nums, n)"}
{"task_id": "Mbpp/637", "solution": "class InputValidator:\n    \"\"\"Responsibility: Validate that values are numeric (int or float).\"\"\"\n    def isNumeric(self, value) -> bool:\n        return isinstance(value, (int, float))\nclass PriceComparison:\n    \"\"\"Encapsulate comparison logic and use InputValidator for precondition checks.\"\"\"\n    def __init__(self, validator: InputValidator):\n        self._validator = validator\n\n    def checkNoProfitNoLoss(self, selling_price: float, cost_price: float) -> bool:\n        \"\"\"Validate inputs numeric, perform selling_price == cost_price check, return bool.\"\"\"\n        if not self._validator.isNumeric(selling_price):\n            raise TypeError(\"Selling price must be numeric (int or float).\")\n        if not self._validator.isNumeric(cost_price):\n            raise TypeError(\"Cost price must be numeric (int or float).\")\n        return selling_price == cost_price\ndef noprofit_noloss(selling_price, cost_price) -> bool:\n    \"\"\"Public API: returns True when selling_price == cost_price else False.\n    Validates inputs are numeric via InputValidator; raises TypeError for non-numeric inputs.\"\"\"\n    validator = InputValidator()\n    comparer = PriceComparison(validator)\n    return comparer.checkNoProfitNoLoss(selling_price, cost_price)"}
{"task_id": "Mbpp/639", "solution": "class Name:\n    def __init__(self, value: str):\n        self._value = value\n\n    def length(self) -> int:\n        return len(self._value)\n\n    def firstChar(self) -> str:\n        return self._value[0]\nclass FilterRule:\n    def isLowercaseStart(self, name: 'Name') -> bool:\n        char = name.firstChar()\n        return 'a' <= char <= 'z'\nclass NameList:\n    def __init__(self, names: list['Name']):\n        self._names = names\n\n    def filterByRule(self, rule: 'FilterRule') -> list['Name']:\n        retained_names = []\n        for name in self._names:\n            if not rule.isLowercaseStart(name):\n                retained_names.append(name)\n        return retained_names\n\n    def totalLength(self) -> int:\n        total = 0\n        for name in self._names:\n            total += name.length()\n        return total\n\n    @classmethod\n    def from_raw_list(cls, rawNames: list[str]) -> 'NameList':\n        names = [Name(raw_name) for raw_name in rawNames]\n        return cls(names)\nclass Result:\n    def __init__(self, sum_value: int):\n        self._sum = sum_value\n\n    def getSum(self) -> int:\n        return self._sum\ndef sample_nam(rawNames: list[str]) -> int:\n    name_list = NameList.from_raw_list(rawNames)\n    rule = FilterRule()\n    retained = name_list.filterByRule(rule)\n    retained_list = NameList(retained)\n    total = retained_list.totalLength()\n    result = Result(total)\n    return result.getSum()"}
{"task_id": "Mbpp/638", "solution": "import math\ndef _round_nearest_int(value: float) -> int:\n    \"\"\"Rounds to the nearest integer, with ties away from zero.\"\"\"\n    return int(value + math.copysign(0.5, value))\ndef wind_chill(velocity_kmh, temperature_celsius):\n    \"\"\"Calculates the wind chill index using the Canadian/US NWS formula.\"\"\"\n    T = temperature_celsius\n    V = velocity_kmh\n\n    # Canonical wind chill formula\n    raw_index = 13.12 + (0.6215 * T) - (11.37 * (V**0.16)) + (0.3965 * T * (V**0.16))\n\n    return _round_nearest_int(raw_index)"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n):\n    \"\"\"Computes the nth nonagonal number using the closed-form formula.\"\"\"\n    return (7 * n * n - 5 * n) // 2"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses an array upto a given position k, returning a new list.\n\n    Raises:\n        TypeError: if arr is not a list or k is not an int.\n        ValueError: if k < 0.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if k < 0:\n        raise ValueError(\"Input 'k' cannot be negative.\")\n\n    if k == 0:\n        return arr.copy()\n    elif k <= len(arr):\n        # Reverse the first k elements and concatenate with the rest\n        return list(reversed(arr[:k])) + arr[k:]\n    else: # k > len(arr)\n        # If k is greater than array length, reverse the entire array\n        return list(reversed(arr))"}
{"task_id": "Mbpp/720", "solution": "class Validator:\n    \"\"\"Centralized validation logic for argument type checks.\"\"\"\n    @staticmethod\n    def validate_tuple(obj) -> None:\n        \"\"\"Raise TypeError if obj is not a tuple.\"\"\"\n        if not isinstance(obj, tuple):\n            raise TypeError('First argument must be a tuple')\n\n    @staticmethod\n    def validate_dict(obj) -> None:\n        \"\"\"Raise TypeError if obj is not a dict.\"\"\"\n        if not isinstance(obj, dict):\n            raise TypeError('Second argument must be a dict')\ndef add_dict_to_tuple(input_tuple, input_dict) -> tuple:\n    \"\"\"Validate inputs and return a new tuple containing items of input_tuple followed by input_dict as a single element.\n    Raises TypeError if input types are invalid.\n    \"\"\"\n    Validator.validate_tuple(input_tuple)\n    Validator.validate_dict(input_dict)\n    return input_tuple + (input_dict,)"}
{"task_id": "Mbpp/722", "solution": "from typing import Dict, Tuple, Any\ndef filter_data(students: Dict[str, Tuple[float, float]], minHeight: float, minWeight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"Return a new dict with entries where height >= minHeight and weight >= minWeight.\n    Malformed entries are ignored, and the input dict is not mutated.\n    \"\"\"\n\n    def _is_valid_entry(value: Any) -> bool:\n        \"\"\"Return True if value is a 2-tuple/list and both elements are numeric (int or float).\"\"\"\n        if not (isinstance(value, (tuple, list)) and len(value) == 2):\n            return False\n        if not (isinstance(value[0], (int, float)) and isinstance(value[1], (int, float))):\n            return False\n        return True\n\n    filtered_students = {}\n    for name, data in students.items():\n        if _is_valid_entry(data):\n            height, weight = data\n            if height >= minHeight and weight >= minWeight:\n                filtered_students[name] = data\n    return filtered_students"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of a word.\n    \"\"\"\n    from typing import List, Optional\n\n    # Model Layer components (defined inline)\n\n    def is_ascii_word_char(ch: str) -> bool:\n        \"\"\"Returns True if the character is an ASCII letter, digit, or underscore.\"\"\"\n        return ('a' <= ch <= 'z') or ('A' <= ch <= 'Z') or ('0' <= ch <= '9') or (ch == '_')\n\n    class Character:\n        \"\"\"Wraps a single character with its original index.\"\"\"\n        def __init__(self, ch: str, index: int):\n            self.ch = ch\n            self.index = index\n\n        def is_word_char(self) -> bool:\n            \"\"\"Checks if this character is an ASCII word character.\"\"\"\n            return is_ascii_word_char(self.ch)\n\n    class Word:\n        \"\"\"Represents a contiguous sequence of ASCII word characters.\"\"\"\n        def __init__(self, value: str, start_index: int):\n            self.value = value\n            self.start_index = start_index\n            self.end_index = start_index + len(value)\n            self.characters = [Character(ch, start_index + i) for i, ch in enumerate(value)]\n\n        def __len__(self) -> int:\n            return len(self.value)\n\n    class Text:\n        \"\"\"Represents the input string and provides tokenization.\"\"\"\n        def __init__(self, content: str):\n            self.content = content\n\n        def tokenize(self) -> List[\"Word\"]:\n            \"\"\"Tokenizes the content into Word objects based on ASCII word character rules.\"\"\"\n            words: List[Word] = []\n            current_word_value = []\n            current_word_start_index = -1\n\n            for i, ch in enumerate(self.content):\n                if is_ascii_word_char(ch):\n                    if not current_word_value:\n                        current_word_start_index = i\n                    current_word_value.append(ch)\n                else:\n                    if current_word_value:\n                        words.append(Word(\"\".join(current_word_value), current_word_start_index))\n                        current_word_value = []\n                        current_word_start_index = -1\n            \n            if current_word_value:\n                words.append(Word(\"\".join(current_word_value), current_word_start_index))\n\n            return words\n\n    class MatchResult:\n        \"\"\"Represents the result of searching for a qualifying 'z'.\"\"\"\n        def __init__(self, matched: bool, index: Optional[int] = None, before: Optional[str] = None, after: Optional[str] = None):\n            self.matched = matched\n            self.index = index\n            self.before = before\n            self.after = after\n\n    # Matcher Layer components (defined inline)\n\n    class Matcher:\n        \"\"\"Implements the search logic for a qualifying lowercase 'z'.\"\"\"\n        def find_first_match(self, text_content: str) -> MatchResult:\n            \"\"\"\n            Searches for the first lowercase 'z' that is not at the start or end of its word,\n            and has word characters immediately before and after.\n            \"\"\"\n            text_obj = Text(text_content)\n            for word in text_obj.tokenize():\n                # A word must be at least 3 characters long for a 'z' to be in the middle\n                if len(word) < 3:\n                    continue\n\n                for i, char_obj in enumerate(word.characters):\n                    if char_obj.ch == 'z':\n                        # Check if 'z' is not the first or last character of the word\n                        if i > 0 and i < len(word) - 1:\n                            before_char_obj = word.characters[i-1]\n                            after_char_obj = word.characters[i+1]\n\n                            # Check if the characters immediately before and after are word characters\n                            if before_char_obj.is_word_char() and after_char_obj.is_word_char():\n                                absolute_index = char_obj.index\n                                return MatchResult(\n                                    matched=True,\n                                    index=absolute_index,\n                                    before=before_char_obj.ch,\n                                    after=after_char_obj.ch\n                                )\n            return MatchResult(matched=False)\n\n        def _text_match_wordz_middle_internal(self, text_content: str) -> bool:\n            \"\"\"Returns true if a qualifying 'z' is found, false otherwise.\"\"\"\n            return self.find_first_match(text_content).matched\n\n    # Public API entry point\n    return Matcher()._text_match_wordz_middle_internal(text)"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Union\ndef maxAverageOfPath(matrix: List[List[Union[int, float]]]) -> float:\n    \"\"\"\n    Given a square matrix, find a path from top-left to bottom-right\n    moving only right or down with the maximum average cost.\n    \"\"\"\n\n    class Cell:\n        def __init__(self, row: int, col: int, value: Union[int, float]):\n            self.row = row\n            self.col = col\n            self.value = float(value)\n\n    class Matrix:\n        def __init__(self, matrix_input: List[List[Union[int, float]]]):\n            self.N = len(matrix_input)\n            self.cells: List[List[Cell]] = []\n            for r_idx in range(self.N):\n                row_cells = []\n                for c_idx in range(self.N):\n                    row_cells.append(Cell(r_idx, c_idx, matrix_input[r_idx][c_idx]))\n                self.cells.append(row_cells)\n\n        def getSize(self) -> int:\n            return self.N\n\n        def getCell(self, row: int, col: int) -> Cell:\n            return self.cells[row][col]\n\n    class Path:\n        def __init__(self, cells: List[Cell]):\n            self.cells = cells\n\n        def totalCost(self) -> float:\n            return sum(c.value for c in self.cells)\n\n        def length(self) -> int:\n            return len(self.cells)\n\n        def average(self) -> float:\n            if not self.cells:\n                return 0.0 # Should not occur for valid paths\n            return self.totalCost() / self.length()\n\n    class ValidationResult:\n        def __init__(self, isValid: bool, message: str):\n            self.isValid = isValid\n            self.message = message\n\n    def _is_numeric(value) -> bool:\n        return isinstance(value, (int, float))\n\n    class Validator:\n        def validate(self, matrix_input: List[List[Union[int, float]]]) -> ValidationResult:\n            if not matrix_input or len(matrix_input) == 0:\n                return ValidationResult(False, \"Input matrix cannot be empty.\")\n            \n            n_rows = len(matrix_input)\n            n_cols = len(matrix_input[0])\n\n            if n_rows != n_cols:\n                return ValidationResult(False, \"Input matrix must be square (rows must equal columns).\")\n\n            for r_idx, row in enumerate(matrix_input):\n                if len(row) != n_rows:\n                    return ValidationResult(False, f\"Row {r_idx} has inconsistent length. Matrix must be square.\")\n                for c_idx, cell_value in enumerate(row):\n                    if not _is_numeric(cell_value):\n                        return ValidationResult(False, f\"Cell at ({r_idx}, {c_idx}) contains non-numeric value.\")\n            \n            return ValidationResult(True, \"\")\n\n    class PathEvaluator:\n        def computeMaxAverage(self, matrix: Matrix) -> float:\n            N = matrix.getSize()\n\n            if N == 1:\n                return float(matrix.getCell(0, 0).value)\n\n            # Use Dynamic Programming to find the maximum sum path.\n            # dp_sum[r][c] stores the maximum sum to reach cell (r, c).\n            dp_sum: List[List[float]] = [[0.0 for _ in range(N)] for _ in range(N)]\n\n            dp_sum[0][0] = matrix.getCell(0, 0).value\n\n            for c in range(1, N):\n                dp_sum[0][c] = dp_sum[0][c - 1] + matrix.getCell(0, c).value\n\n            for r in range(1, N):\n                dp_sum[r][0] = dp_sum[r - 1][0] + matrix.getCell(r, 0).value\n\n            for r in range(1, N):\n                for c in range(1, N):\n                    current_cell_value = matrix.getCell(r, c).value\n                    dp_sum[r][c] = max(dp_sum[r - 1][c], dp_sum[r][c - 1]) + current_cell_value\n            \n            max_total_sum = dp_sum[N - 1][N - 1]\n            path_length = 2 * N - 1 # All valid paths have a fixed length.\n\n            return max_total_sum / path_length\n\n    validator = Validator()\n    validation_result = validator.validate(matrix)\n\n    if not validation_result.isValid:\n        raise ValueError(validation_result.message)\n\n    matrix_obj = Matrix(matrix)\n    path_evaluator = PathEvaluator()\n    \n    return path_evaluator.computeMaxAverage(matrix_obj)"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(listA, listB) -> int:\n    \"\"\"\n    Counts indices where the lists have the same values, assuming inputs are lists of the same length.\n    \"\"\"\n    class Comparator:\n        def equals(self, a, b) -> bool:\n            return a == b\n\n    class Counter:\n        def __init__(self, comparator: 'Comparator' = None):\n            self._comparator = comparator or Comparator()\n        def count_matches(self, listA, listB) -> int:\n            matching_count = 0\n            for i in range(len(listA)):\n                if self._comparator.equals(listA[i], listB[i]):\n                    matching_count += 1\n            return matching_count\n\n    counter = Counter()\n    return counter.count_matches(listA, listB)"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function computes base**power using Python's arbitrary-precision integers\n    and then sums the decimal digits of the resulting number.\n    \"\"\"\n    # Compute base raised to the power using arbitrary-precision integer arithmetic\n    result_number = base ** power\n\n    # Convert the resulting number to a decimal string\n    decimal_string = str(result_number)\n\n    # Sum all decimal digits of the computed value\n    digit_sum = 0\n    for digit_char in decimal_string:\n        digit_sum += int(digit_char)\n\n    return digit_sum"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple, returning a new tuple of these products.\n    \"\"\"\n    if len(input_tuple) < 2:\n        raise ValueError(\"Input tuple must have at least 2 elements.\")\n\n    for element in input_tuple:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the input tuple must be numeric (int or float).\")\n\n    result_elements = []\n    for i in range(len(input_tuple) - 1):\n        result_elements.append(input_tuple[i] * input_tuple[i+1])\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/725", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional\nclass ExtractQuotationFunction:\n    \"\"\"Core extraction engine that scans for double-quotes and extracts substrings.\"\"\"\n    def __init__(self, input: InputString) -> None:\n        self.input = input\n        self.result = ResultList(items=[])\n\n    def validatePairs(self) -> List[QuotePair]:\n        \"\"\"Scans the input string for complete double-quote pairs.\"\"\"\n        quote_pairs: List[QuotePair] = []\n        current_open_quote_index: Optional[int] = None\n\n        for i, char in enumerate(self.input.value):\n            if char == '\"':\n                if current_open_quote_index is None:\n                    current_open_quote_index = i\n                else:\n                    quote_pairs.append(QuotePair(startIndex=current_open_quote_index, endIndex=i, isComplete=True))\n                    current_open_quote_index = None\n        \n        return quote_pairs\n\n    def extract(self) -> List[str]:\n        \"\"\"Performs full extraction pipeline and returns ordered list of substring values.\"\"\"\n        complete_pairs = self.validatePairs()\n        \n        for qp in complete_pairs:\n            substring_value = self.input.value[qp.startIndex + 1 : qp.endIndex]\n            self.result.add(QuotedSubstring(value=substring_value, startIndex=qp.startIndex, endIndex=qp.endIndex))\n            \n        return self.result.to_list()\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"Extracts values between quotation marks \" \" of the given string.\"\"\"\n    caller_input = InputString(input_string)\n    engine = ExtractQuotationFunction(caller_input)\n    return engine.extract()"}
{"task_id": "Mbpp/728", "solution": "class LengthMismatchError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message: str = message\n    def __str__(self) -> str:\n        return self.message\ndef sum_list(a: list, b: list) -> list:\n    \"\"\"Return a new list where result[i] = a[i] + b[i].\n\n    Raises:\n      LengthMismatchError: if len(a) != len(b)\n      TypeError: if any element in a or b is not numeric (int or float)\n    \"\"\"\n    len_a = len(a)\n    len_b = len(b)\n\n    if len_a != len_b:\n        raise LengthMismatchError(f\"lengths differ: len(a)={len_a}, len(b)={len_b}\")\n\n    result = []\n    for i in range(len_a):\n        val_a = a[i]\n        val_b = b[i]\n\n        if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n            raise TypeError(f\"Non-numeric element at index {i}: a={val_a!r}, b={val_b!r}\")\n        \n        result.append(val_a + val_b)\n        \n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r, h):\n    # Computes the slant height l = sqrt(r^2 + h^2)\n    slant_height = math.sqrt(r**2 + h**2)\n    # Computes the lateral surface area = pi * r * l\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input: str) -> str:\n    \"\"\"\n    Return a string where each occurrence of space (' '), comma (','), or dot ('.')\n    is replaced with a colon (':'). Raises TypeError if input is not a str.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if input == \"\":\n        return \"\"\n\n    SEPARATORS = (' ', ',', '.')\n    REPLACEMENT_CHAR = ':'\n\n    result_chars = []\n    for char in input:\n        if char in SEPARATORS:\n            result_chars.append(REPLACEMENT_CHAR)\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order and returning a new list.\"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"Return 0-based index of first occurrence of target in sorted array or -1 if not found.\n    This function uses a modified binary search to find the leftmost occurrence.\"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Found potential first occurrence\n            high = mid - 1  # Try to find an earlier one in the left half\n        elif array[mid] < target:\n            low = mid + 1  # Target is in the right half\n        else:  # array[mid] > target\n            high = mid - 1  # Target is in the left half\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Finds the sum of products of all possible sublists (contiguous subarrays) of a given list.\n    Raises TypeError if input is not a sequence of integers.\n    \"\"\"\n    \n    def _validate_input(input_list):\n        \"\"\"Raises TypeError if input_list is not a sequence of integers.\"\"\"\n        if not isinstance(input_list, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple.\")\n        for item in input_list:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the input list must be integers.\")\n\n    def _generate_contiguous_slices(items):\n        \"\"\"Yields tuples (start, end, slice_items) for all contiguous subarrays.\"\"\"\n        n = len(items)\n        for i in range(n):\n            for j in range(i, n):\n                yield (i, j, items[i : j + 1])\n\n    def _product_of_slice(slice_items):\n        \"\"\"Returns the product (int) of the given slice_items list.\"\"\"\n        if not slice_items:\n            return 1  # Product of an empty list is 1\n        product = 1\n        for item in slice_items:\n            product *= item\n        return product\n\n    _validate_input(input_list)\n    items = list(input_list)\n    if not items:\n        return 0\n    \n    total = 0\n    for start, end, slice_items in _generate_contiguous_slices(items):\n        total += _product_of_slice(slice_items)\n    return total"}
{"task_id": "Mbpp/735", "solution": "class IntegerInput:\n    \"\"\"Encapsulates an input integer and provides its minimal binary representation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_binary(self) -> str:\n        \"\"\"Returns the minimal binary string representation without '0b' prefix.\"\"\"\n        if self.value == 0:\n            return \"0\"\n        return bin(self.value)[2:]\nclass BinaryRepresentation:\n    \"\"\"Represents binary digits and provides bit metadata.\"\"\"\n    def __init__(self, bits: str):\n        self.bits = bits\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.bits)\n\n    def msb(self) -> str:\n        \"\"\"Returns the most significant bit as a string.\"\"\"\n        return self.bits[0]\n\n    def lsb(self) -> str:\n        \"\"\"Returns the least significant bit as a string.\"\"\"\n        return self.bits[-1]\nclass ToggleMask:\n    \"\"\"Generates an integer mask with 1s in middle bit positions.\"\"\"\n    def generate(self, length: int) -> int:\n        \"\"\"Produces an integer mask with 1s for middle bits, 0s for MSB and LSB.\"\"\"\n        if length < 3:\n            return 0\n        mask = 0\n        # Set bits from position 1 to length-2 (0-indexed from right)\n        for i in range(1, length - 1):\n            mask |= (1 << i)\n        return mask\nclass BitManipulator:\n    \"\"\"Provides bit inversion and mask application utilities.\"\"\"\n    def apply_mask(self, value: int, mask: int) -> int:\n        \"\"\"Applies a mask to a value using the XOR operation.\"\"\"\n        return value ^ mask\nclass Result:\n    \"\"\"A container for the integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n    Returns the original number if its binary representation has fewer than three bits.\n    \"\"\"\n    inp = IntegerInput(n)\n    bits = inp.get_binary()\n    br = BinaryRepresentation(bits)\n\n    if br.length() < 3:\n        return n\n\n    mask_gen = ToggleMask()\n    mask = mask_gen.generate(br.length())\n\n    bm = BitManipulator()\n    result_value = bm.apply_mask(n, mask)\n\n    res = Result(result_value)\n    return res.value"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value) -> int:\n    \"\"\"Return leftmost index i (0..len(sorted_list)) so that inserting value at i preserves non-decreasing order.\n\n    Preconditions: sorted_list is a sequence whose elements are comparable.\n    Postconditions: returns integer in 0..len(sorted_list); does not modify sorted_list.\n    \"\"\"\n    def _binary_search_leftmost(elements, value) -> int:\n        \"\"\"Return smallest index i with elements[i] >= value, else len(elements).\"\"\"\n        low = 0\n        high = len(elements)\n\n        while low < high:\n            mid = (low + high) // 2\n            if elements[mid] < value:\n                low = mid + 1\n            else:  # elements[mid] >= value\n                high = mid\n        return low\n\n    return _binary_search_leftmost(sorted_list, value)"}
{"task_id": "Mbpp/737", "solution": "def check_str(input: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel using a regular expression.\n    Assumes PATTERN is a pre-compiled regex at module level.\n    \"\"\"\n    if input is None:\n        return False\n    # PATTERN is assumed to be defined at the module level: re.compile(r'^[aeiou]')\n    return PATTERN.match(input) is not None"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"Public function delegating to TriangularNumberCalculator.find_Index.\"\"\"\n    from dataclasses import dataclass\n\n    @dataclass\n    class TriangularNumber:\n        index: int\n        value: int\n        digits: int\n\n    @dataclass\n    class Result:\n        index: int\n\n    class InputValidator:\n        def validate(self, n_val: int) -> None:\n            \"\"\"Raise ValueError if n is not a positive integer (n > 0).\"\"\"\n            if not isinstance(n_val, int) or n_val <= 0:\n                raise ValueError(\"Input n must be a positive integer.\")\n\n    class TriangularNumberCalculator:\n        def __init__(self, validator: InputValidator = None) -> None:\n            \"\"\"Initialize with an InputValidator instance or default one.\"\"\"\n            self._validator = validator if validator is not None else InputValidator()\n\n        def find_Index(self, num_digits: int) -> int:\n            \"\"\"Return smallest k such that T_k has exactly num_digits digits.\"\"\"\n            self._validator.validate(num_digits)\n\n            k = 1\n            while True:\n                triangular_value = self._triangular(k)\n                digits = self._count_digits(triangular_value)\n\n                if digits == num_digits:\n                    return k\n                k += 1\n\n        def _triangular(self, k: int) -> int:\n            \"\"\"Compute T_k = k*(k+1)//2 using integer arithmetic.\"\"\"\n            return k * (k + 1) // 2\n\n        def _count_digits(self, value: int) -> int:\n            \"\"\"Count decimal digits of value (base 10) using integer/string conversion.\"\"\"\n            if value == 0:\n                return 1\n            return len(str(value))\n\n    calculator = TriangularNumberCalculator()\n    return calculator.find_Index(n)"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple) -> dict:\n    \"\"\"\n    Convert a tuple into a dict by pairing adjacent elements.\n    Raises ValueError if len(input_tuple) is odd.\n    \"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"invalid input length: expected even number of elements\")\n\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(a):\n    \"\"\"Compute surface area of a regular tetrahedron.\n\n    Parameters:\n    - a (numeric): edge length of tetrahedron\n\n    Returns:\n    - float: surface area computed as sqrt(3) * a**2\n    \"\"\"\n    surface_area = math.sqrt(3) * (a ** 2)\n    return surface_area"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_str: str) -> bool:\n    \"\"\"\n    Checks if all characters in a string are the same.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a str\")\n    if len(input_str) <= 1:\n        return True\n    return len(set(input_str)) == 1"}
