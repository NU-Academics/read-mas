{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    J(0)=0, J(1)=1, and J(n) = J(n-1) + 2 * J(n-2) for n > 1.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n\n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return b"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> float:\n    \"\"\"\n    Finds and returns the second smallest number in a list.\n    Raises ValueError if the list has fewer than two distinct elements.\n    \"\"\"\n    unique_numbers = sorted(list(set(numbers)))\n\n    if len(unique_numbers) < 2:\n        raise ValueError(\"List must contain at least two distinct elements to find the second smallest.\")\n\n    return float(unique_numbers[1])"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if the given string is a decimal number with a precision of 2.\n    It applies regex rules to ensure the correct format.\"\"\"\n    import re\n    # Regular expression to match an optional sign, one or more digits,\n    # a decimal point, and exactly two digits after the decimal point.\n    # It also handles cases without a decimal point but implies the need for two digits if present.\n    pattern = re.compile(r\"^[+-]?\\d+\\.\\d{2}$\")\n    return bool(pattern.match(input_string))"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique pairs of reverse strings in the given list.\"\"\"\n    seen_strings = set(string_list)\n    unique_pairs = set()\n\n    for s1 in string_list:\n        s1_reversed = s1[::-1]\n        # Check if the reversed string exists and is different from the original string itself.\n        if s1_reversed in seen_strings and s1 != s1_reversed:\n            # Add a frozenset to ensure canonical representation and uniqueness of pairs.\n            unique_pairs.add(frozenset({s1, s1_reversed}))\n            \n    return len(unique_pairs)"}
