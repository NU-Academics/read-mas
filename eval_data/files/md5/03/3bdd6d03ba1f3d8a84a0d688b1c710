{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str | None:\n    \"\"\"Finds the first repeated character in a string.\n    Returns the character or None if no character is repeated.\"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/605", "solution": "import math\ndef prime_num(number: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True"}
