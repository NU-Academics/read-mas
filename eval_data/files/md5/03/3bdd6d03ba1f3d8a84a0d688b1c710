{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of name-score tuples.\n    Returns the name with the highest total score and their aggregate score, or ('', 0) if the input list is empty.\n    \"\"\"\n    if not data:\n        return ('', 0)\n\n    aggregated_scores = {}\n    for name, score in data:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = ''\n    max_score = 0\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list[str]) -> tuple[str, str]:\n    \"\"\"Processes a list of strings to find the first two words starting with 'p' or 'P'.\n\n    Returns a tuple containing the first two identified words that start with 'p' or 'P', padded with empty strings if fewer than two are found.\n    \"\"\"\n    \n    found_words = []\n    for item in word_list:\n        for word in item.split():\n            if word.lower().startswith('p'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return tuple(found_words)\n    \n    # Pad with empty strings if fewer than two words were found\n    while len(found_words) < 2:\n        found_words.append('')\n        \n    return tuple(found_words)"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Union\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n\n    all_products.sort(reverse=True)\n    return all_products[:k]"}
