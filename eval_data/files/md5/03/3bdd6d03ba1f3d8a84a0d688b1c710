{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list.\n\n    Returns a new list with consecutive duplicates removed.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/736", "solution": "from typing import List, Any, TypeVar\n_Comparable = TypeVar('_Comparable', bound=Any)\ndef left_insertion(sorted_list: List[_Comparable], value: _Comparable) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    Returns the index where the value should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else: # sorted_list[mid] >= value\n            high = mid\n    return low"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    # Calculates the lateral surface area of a cone.\n    # Area = pi * r * sqrt(r^2 + h^2)\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    \"\"\"\n    modified_string = input_string.replace(' ', ':')\n    modified_string = modified_string.replace(',', ':')\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists\n    of a given list of integers.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):  # Iterate through all possible start indices\n        current_product = 1\n        for j in range(i, n):  # Iterate through all possible end indices\n            current_product *= input_list[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first and the last bit.\n    Handles numbers with two or fewer bits by returning the original number.\n    \"\"\"\n\n    def _to_binary_string(num: int) -> str:\n        \"\"\"Converts an integer to its binary string representation (e.g., 9 to \"0b1001\").\"\"\"\n        return bin(num)\n\n    def _get_first_bit(binary_str_no_prefix: str) -> str:\n        \"\"\"Extracts the most significant bit (first bit) from a binary string.\"\"\"\n        return binary_str_no_prefix[0]\n\n    def _get_last_bit(binary_str_no_prefix: str) -> str:\n        \"\"\"Extracts the least significant bit (last bit) from a binary string.\"\"\"\n        return binary_str_no_prefix[-1]\n\n    def _get_middle_bits(binary_str_no_prefix: str) -> str:\n        \"\"\"Extracts the bits between the first and last bit from a binary string.\"\"\"\n        return binary_str_no_prefix[1:-1]\n\n    def _invert_bit(bit_char: str) -> str:\n        \"\"\"Inverts a single binary bit character ('0' to '1', '1' to '0').\"\"\"\n        return '1' if bit_char == '0' else '0'\n\n    def _invert_middle_bits_string(middle_bits_str: str) -> str:\n        \"\"\"Inverts all bits within a given middle bits string.\"\"\"\n        return \"\".join(_invert_bit(bit) for bit in middle_bits_str)\n\n    def _combine_bits(first_bit: str, middle_bits: str, last_bit: str) -> str:\n        \"\"\"Recombines the first bit, inverted middle bits, and last bit.\"\"\"\n        return first_bit + middle_bits + last_bit\n\n    def _from_binary_string(binary_str: str) -> int:\n        \"\"\"Converts a binary string (e.g., \"1111\") back to its integer equivalent.\"\"\"\n        return int(binary_str, 2)\n\n    binary_with_prefix = _to_binary_string(n)\n    binary_str_no_prefix = binary_with_prefix[2:] # Remove \"0b\" prefix\n\n    # If the binary representation has two or fewer bits, there are no middle bits to invert.\n    if len(binary_str_no_prefix) <= 2:\n        return n\n\n    first_bit = _get_first_bit(binary_str_no_prefix)\n    last_bit = _get_last_bit(binary_str_no_prefix)\n    middle_bits_raw = _get_middle_bits(binary_str_no_prefix)\n\n    inverted_middle_bits = _invert_middle_bits_string(middle_bits_raw)\n\n    final_binary_str_no_prefix = _combine_bits(first_bit, inverted_middle_bits, last_bit)\n\n    result = _from_binary_string(final_binary_str_no_prefix)\n    return result"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u), case-insensitive, using regex.\n    Returns True if the string starts with a vowel, False otherwise (including empty strings).\n    \"\"\"\n    VOWEL_REGEX_PATTERN = r\"^[aeiou]\"\n    return bool(re.match(VOWEL_REGEX_PATTERN, input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    # Finds the index of the smallest triangular number with 'n' digits.\n    # It iteratively checks triangular numbers starting from an estimated k.\n    if n == 2:\n        return 4\n\n    lower_bound = 10**(n - 1)\n    upper_bound = 10**n\n\n    # Estimate starting k to optimize search. k * (k + 1) / 2 approx 10**(n-1) => k approx sqrt(2 * 10**(n-1))\n    k = int((2 * lower_bound)**0.5) - 1\n    if k < 1:\n        k = 1 # Ensure k starts at least from 1\n\n    while True:\n        triangular_number = k * (k + 1) // 2\n        if triangular_number >= lower_bound:\n            # Check if this triangular number is within the n-digit range\n            if triangular_number < upper_bound:\n                return k\n            # If it's already too large (has more than n digits),\n            # it means the previous k (if we started from a correct estimate)\n            # would have been the answer, or something went wrong with the estimate\n            # However, for smallest number, we keep incrementing.\n            # If the current one is >= lower_bound but also >= upper_bound,\n            # it means we've overshot, but this logic guarantees finding the smallest.\n        k += 1"}
