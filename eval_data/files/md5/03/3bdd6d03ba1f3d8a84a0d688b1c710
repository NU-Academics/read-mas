{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Merges three input lists into a single sorted list.\n    Combines all elements and then sorts them in ascending order.\n    \"\"\"\n    combined_list = list1 + list2 + list3\n    sorted_list = sorted(combined_list)\n    return sorted_list"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_list: list[list[Any]]) -> set[Any]:\n    \"\"\"\n    Finds common elements in a given nested list.\n    Returns a set of elements that are present in all sub-lists.\n    \"\"\"\n    if not nested_list:\n        return set()\n\n    # Initialize common_elements with the elements of the first list\n    common_elements = set(nested_list[0])\n\n    # Iterate through the rest of the lists and find the intersection\n    for sublist in nested_list[1:]:\n        if not sublist:\n            # If any sublist is empty, no elements can be common to all lists\n            return set()\n        common_elements.intersection_update(set(sublist))\n        if not common_elements:\n            # Optimization: if common_elements becomes empty, no further intersection is possible\n            return set()\n\n    return common_elements"}
