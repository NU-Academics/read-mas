{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer according to defined business rules.\n    Handles optional signs and ensures all other characters are digits.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] in ('+', '-'):\n        start_index = 1\n\n    if start_index == len(input_string):  # String was just '+' or '-'\n        return False\n\n    for i in range(start_index, len(input_string)):\n        if not '0' <= input_string[i] <= '9':\n            return False\n\n    return True"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations_count: int) -> int:\n    \"\"\"\n    Calculates the number of odd decimal equivalents when rotating a binary string.\n    Rotates the string 'rotations_count' times, converts each to decimal, and counts odd values.\n    \"\"\"\n\n    def _validate_binary_string(s: str) -> None:\n        # As per design constraints, validation is assumed to pass without raising exceptions.\n        pass\n\n    def _validate_rotation_count(count: int) -> None:\n        # As per design constraints, validation is assumed to pass without raising exceptions.\n        pass\n\n    def _perform_single_rotation(current_string: str) -> str:\n        \"\"\"Performs a single cyclic left rotation on a binary string.\"\"\"\n        if not current_string:\n            return \"\"\n        return current_string[1:] + current_string[0]\n\n    def _binary_to_decimal(binary_s: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(binary_s, 2)\n\n    def _is_odd(n: int) -> bool:\n        \"\"\"Determines if a given integer is an odd number.\"\"\"\n        return n % 2 != 0\n\n    _validate_binary_string(binary_string)\n    _validate_rotation_count(rotations_count)\n\n    odd_count = 0\n    current_binary_string = binary_string\n    n = len(binary_string)\n\n    if n == 0:\n        return 0\n\n    # The problem implies rotating 'rotations_count' times.\n    # If rotations_count is larger than the string length, rotations will repeat.\n    # We only need to check unique rotations up to 'n' if rotations_count > n,\n    # but the problem states to loop 'rotations_count' times.\n    for _ in range(rotations_count):\n        decimal_value = _binary_to_decimal(current_binary_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n        current_binary_string = _perform_single_rotation(current_binary_string)\n\n    return odd_count"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(input_list):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Returns 0.0 for an empty input list.\n    \"\"\"\n    max_abs_product = 0.0\n\n    if not input_list:\n        return max_abs_product\n\n    for num1, num2 in input_list:\n        current_product = num1 * num2\n        current_abs_product = abs(current_product)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n\n    return max_abs_product"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list) -> int:\n    \"\"\"\n    Identifies the element that appears only once in a sorted array, assuming exactly one such element exists.\n    All other elements appear exactly twice.\n    \"\"\"\n    n = len(arr)\n    if n == 1:\n        return arr[0]\n\n    # Check if the unique element is the first one\n    if arr[0] != arr[1]:\n        return arr[0]\n\n    # Check for the unique element in the middle of the array\n    for i in range(1, n - 1):\n        if arr[i] != arr[i-1] and arr[i] != arr[i+1]:\n            return arr[i]\n\n    # Check if the unique element is the last one\n    if arr[n-1] != arr[n-2]:\n        return arr[n-1]"}
