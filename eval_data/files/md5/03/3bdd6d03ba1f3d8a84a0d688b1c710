{"task_id": "Mbpp/440", "solution": "def find_adverb_position(sentence_text: str) -> tuple[int, int, str] | None:\n    \"\"\"Finds the first adverb and its 0-indexed start and end character positions in a given sentence.\n    The returned adverb string is cleaned of any trailing punctuation.\n    \"\"\"\n    import re\n\n    def _clean_trailing_punctuation(word: str) -> str:\n        \"\"\"Removes any trailing punctuation from a word.\"\"\"\n        return re.sub(r'[\\W_]+$', '', word)\n\n    def _tokenize_sentence(sentence_text: str) -> list[tuple[str, int, int]]:\n        \"\"\"Splits a sentence into words and returns a list of (word_string, start_index, end_index) tuples.\"\"\"\n        tokens = []\n        for match in re.finditer(r\"\\b[\\w'-]+\\b\", sentence_text):\n            word = match.group(0)\n            start_pos = match.start()\n            end_pos = match.end()\n            tokens.append((word, start_pos, end_pos))\n        return tokens\n\n    def _is_adverb(word: str) -> bool:\n        \"\"\"Determines if a given word is an adverb based on common linguistic rules.\"\"\"\n        cleaned_word = _clean_trailing_punctuation(word)\n        return cleaned_word.lower().endswith('ly') and len(cleaned_word) > 2\n\n    tokenized_words = _tokenize_sentence(sentence_text)\n\n    for word_str_with_punct, start_pos, end_pos_original in tokenized_words:\n        if _is_adverb(word_str_with_punct):\n            cleaned_adverb = _clean_trailing_punctuation(word_str_with_punct)\n            end_pos_cleaned = start_pos + len(cleaned_adverb)\n            return (start_pos, end_pos_cleaned, cleaned_adverb)\n\n    return None"}
