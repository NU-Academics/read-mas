{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements in a tuple.\n    Returns an empty tuple if the input_tuple has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(input_tuple) - 1):\n        result_list.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(result_list)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list:\n    \"\"\"Generates all possible combinations of elements from a given list, including the empty list.\n    Each element from the input list is prepended to existing combinations to form new ones.\n    \"\"\"\n    results = [[]]\n\n    for element in input_list:\n        newly_formed_combinations = []\n        for existing_combo in results:\n            new_combo = [element] + existing_combo\n            newly_formed_combinations.append(new_combo)\n        results.extend(newly_formed_combinations)\n            \n    return results"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product of a contiguous subarray within the input array.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        The maximum product of any contiguous subarray.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    overall_max_product = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # Store the max_so_far from the previous iteration.\n        # This is crucial because a negative number can flip the max and min products.\n        temp_max = max_so_far\n        \n        # Calculate the new max_so_far and min_so_far using the current number\n        # and products with previous max_so_far and min_so_far.\n        max_so_far = max(num, num * temp_max, num * min_so_far)\n        min_so_far = min(num, num * temp_max, num * min_so_far)\n\n        overall_max_product = max(overall_max_product, max_so_far)\n\n    return overall_max_product"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array: list[int], n: int) -> int:\n    \"\"\"Calculates the product of array elements modulo n, applying the modulo at each step to prevent overflow.\"\"\"\n    product = 1\n    for x in array:\n        product = (product * x) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list: list) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers.\n    An empty list or a list with a single element is considered consecutive.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    sorted_list = sorted(input_list)\n\n    for i in range(len(sorted_list) - 1):\n        if sorted_list[i+1] - sorted_list[i] != 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product formed by multiplying numbers of an increasing subsequence\n    of the given array.\n    This uses dynamic programming to track the maximum and minimum products ending at each position,\n    necessary for handling negative numbers correctly.\n    \"\"\"\n    if not arr:\n        return 0\n\n    n = len(arr)\n    # max_prod_ending_at[i] stores the maximum product of an increasing subsequence ending at index i.\n    max_prod_ending_at = list(arr)\n    # min_prod_ending_at[i] stores the minimum product of an increasing subsequence ending at index i.\n    # This is crucial for handling negative numbers, as multiplying by a negative can turn a minimum into a maximum.\n    min_prod_ending_at = list(arr)\n\n    # Initialize max_overall_product with the largest single element,\n    # to handle cases where no increasing subsequence of length > 1 exists\n    # or all valid products are negative.\n    max_overall_product = max(arr)\n\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j]:  # Check for strictly increasing subsequence\n                if arr[i] >= 0:\n                    # If arr[i] is positive, it maintains the order of products (max * positive is max, min * positive is min)\n                    max_prod_ending_at[i] = max(max_prod_ending_at[i], max_prod_ending_at[j] * arr[i])\n                    min_prod_ending_at[i] = min(min_prod_ending_at[i], min_prod_ending_at[j] * arr[i])\n                else:\n                    # If arr[i] is negative, multiplying by it flips the order (max * negative is min, min * negative is max)\n                    max_prod_ending_at[i] = max(max_prod_ending_at[i], min_prod_ending_at[j] * arr[i])\n                    min_prod_ending_at[i] = min(min_prod_ending_at[i], max_prod_ending_at[j] * arr[i])\n\n        max_overall_product = max(max_overall_product, max_prod_ending_at[i])\n\n    return max_overall_product"}
