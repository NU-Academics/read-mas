{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict: dict) -> (int | float):\n    \"\"\"Calculates the sum of all numeric values in the given dictionary.\n\n    Returns 0 if the dictionary is empty or contains no numeric values.\n    \"\"\"\n    total_sum = 0\n    for value in input_dict.values():\n        if isinstance(value, (int, float)):\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list: list[int]) -> bool:\n    \"\"\"Checks if every element at an even index in the input list is an even number.\n    Returns True if all elements at even indices are even numbers, False otherwise.\"\"\"\n    for i in range(len(input_list)):\n        if i % 2 == 0:  # Check if the current index is even\n            if input_list[i] % 2 != 0:  # If an odd number is found at an even index\n                return False\n    return True"}
{"task_id": "Mbpp/793", "solution": "def last(sorted_array, element):\n    \"\"\"Finds the last position (highest index) of a specified element in a sorted array using binary search.\n    Returns -1 if the element is not found.\"\"\"\n    low = 0\n    high = len(sorted_array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == element:\n            result = mid\n            low = mid + 1\n        elif sorted_array[mid] < element:\n            low = mid + 1\n        else: # sorted_array[mid] > element\n            high = mid - 1\n    return result"}
