{"task_id": "Mbpp/123", "solution": "import math\ndef _sum_proper_divisors(num: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer.\"\"\"\n    if num <= 1:\n        return 0\n\n    s = 1\n    for i in range(2, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            s += i\n            if i * i != num:\n                s += num // i\n    return s\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 up to the specified limit.\n    An amicable pair (a, b) are two different numbers where d(a) = b and d(b) = a.\n    \"\"\"\n    found_amicable_numbers = set()\n\n    for i in range(1, limit + 1):\n        sum_div_i = _sum_proper_divisors(i)\n\n        if sum_div_i > i and sum_div_i <= limit:\n            sum_div_sum_div_i = _sum_proper_divisors(sum_div_i)\n\n            if sum_div_sum_div_i == i:\n                found_amicable_numbers.add(i)\n                found_amicable_numbers.add(sum_div_i)\n    \n    return sum(found_amicable_numbers)"}
