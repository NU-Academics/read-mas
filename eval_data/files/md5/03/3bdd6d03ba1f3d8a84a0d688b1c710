{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles the special case where n is 0, returning 1 as the smallest power of 2 >= 0.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    power = 1\n    # Repeatedly doubles 'power' until it is greater than or equal to 'n'.\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts the number of pairs of integers in a list that XOR to an even number.\n    A pair of integers (A, B) XORs to an even number if and only if A and B have the same parity.\n    \"\"\"\n    def _calculate_pairs_from_count(count: int) -> int:\n        \"\"\"Calculates the number of unique pairs from a given count of items.\"\"\"\n        if count < 2:\n            return 0\n        return count * (count - 1) // 2\n\n    even_count = 0\n    odd_count = 0\n\n    for number in numbers:\n        if number % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    even_pairs = _calculate_pairs_from_count(even_count)\n    odd_pairs = _calculate_pairs_from_count(odd_count)\n\n    return even_pairs + odd_pairs"}
