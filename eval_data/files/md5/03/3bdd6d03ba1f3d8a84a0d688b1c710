{"task_id": "Mbpp/763", "solution": "def find_min_diff(array,size):\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in the input array.\n    Returns -1 if the array contains fewer than two elements.\n    \"\"\"\n    if size < 2:\n        return -1\n\n    sorted_array = sorted(list(array))\n\n    min_diff = float('inf')\n\n    for i in range(size - 1):\n        diff = abs(sorted_array[i] - sorted_array[i+1])\n        if diff < min_diff:\n            min_diff = diff\n\n    return int(min_diff)"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of numerical digits (0-9) in the given string.\n\n    Returns the total count of digits in the string.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/769", "solution": "def Diff(primary_list: list, secondary_list: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements present in primary_list\n    but not in secondary_list, maintaining their original relative order.\n    \"\"\"\n    secondary_set = set(secondary_list)\n    result_list = []\n    for item in primary_list:\n        if item not in secondary_set:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts pairs in a list whose sum equals target_sum, considering distinct indices.\n\n    Args:\n        numbers: A list of integers.\n        target_sum: The integer target sum for pairs.\n\n    Returns:\n        The total count of pairs whose elements sum to target_sum.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):  # Ensures distinct indices and avoids duplicate pairs (e.g., (1,5) and (5,1))\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"Generates a list of consecutive item pairs from the input list.\n    Returns an empty list if input_list has fewer than two items.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "def findNthPoliteNumber(n: int) -> int:\n    \"\"\"Finds the nth polite number.\n    Polite numbers are positive integers that are not powers of 2.\"\"\"\n    count = 0\n    num = 1\n    while True:\n        # A number is a power of 2 if (num > 0) and (num & (num - 1) == 0)\n        if not (num > 0 and (num & (num - 1) == 0)):\n            count += 1\n\n        if count == n:\n            return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n\n    Args:\n        n: An integer representing the count of the first odd natural numbers.\n\n    Returns:\n        An integer representing the calculated sum.\n    \"\"\"\n    current_sum = 0\n    for i in range(1, n + 1):\n        odd_number = (2 * i - 1)\n        fourth_power = odd_number ** 4\n        current_sum += fourth_power\n    return current_sum"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length 'k' from the input_string.\n    \"\"\"\n    import re\n    words = [word for word in re.split(r'\\s+', input_string) if word]\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced and correctly nested brackets.\n    Utilizes a stack-based approach for verification.\n    \"\"\"\n    _OPENING_BRACKETS = {'(', '{', '['}\n    _BRACKET_MAP = {')': '(', '}': '{', ']': '['}\n\n    stack = []\n\n    for char in expression_string:\n        if char in _OPENING_BRACKETS:\n            stack.append(char)\n        elif char in _BRACKET_MAP:\n            if not stack:\n                return False\n            top_element = stack.pop()\n            if _BRACKET_MAP[char] != top_element:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string, sub_string):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns (matchedSubstring, startIndex, endIndex) or None if not found.\n    \"\"\"\n    start_index = main_string.find(sub_string)\n\n    if start_index != -1:\n        end_index = start_index + len(sub_string)\n        return (sub_string, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every odd-indexed element in the given list is an odd number.\n    Returns True if all conditions are met, False otherwise.\n    \"\"\"\n    for index, element in enumerate(input_list):\n        if index % 2 != 0:  # Check if the current index is odd\n            if element % 2 == 0:  # If index is odd, check if the element is even\n                return False\n    return True"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list):\n    \"\"\"\n    Computes element-wise sums of every unique pair of distinct 2-element tuples\n    from the input list.\n    \"\"\"\n    from itertools import combinations\n\n    def _sum_tuples(tuple1, tuple2):\n        \"\"\"Performs element-wise sum of two 2-element tuples.\"\"\"\n        return (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n\n    results = []\n    # Iterate through unique pairs using itertools.combinations.\n    for tuple_a, tuple_b in combinations(tuple_list, 2):\n        # For each pair, call _sum_tuples and add to results.\n        results.append(_sum_tuples(tuple_a, tuple_b))\n    return results"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"Calculates the number of positive divisors for an integer and checks if that count is even.\n\n    Returns True if the count of divisors is even, False otherwise.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
{"task_id": "Mbpp/777", "solution": "import collections\ndef find_sum(numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of non-repeated elements in a given list of integers.\"\"\"\n    \n    # Use Counter to get the frequency of each element in the list.\n    counts = collections.Counter(numbers)\n    \n    total_sum = 0\n    # Iterate through the elements and their counts.\n    for num, count in counts.items():\n        # If an element appears exactly once, add it to the total sum.\n        if count == 1:\n            total_sum += num\n            \n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list's elements into sublists.\n    Groups identical, consecutive elements into sublists, preserving order.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist)\n\n    return packed_list"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int]:\n    \"\"\"Converts a string representation of a tuple of integers into an actual tuple of integers.\"\"\"\n    s = tuple_string.strip()\n    if not s.startswith('(') or not s.endswith(')'):\n        raise ValueError(\"Invalid tuple format\")\n\n    content = s[1:-1].strip()\n\n    if not content:\n        return ()\n\n    elements = content.split(',')\n    result = []\n    for element_str in elements:\n        stripped_element = element_str.strip()\n        if not stripped_element:\n            raise ValueError(\"Invalid tuple format: empty element\")\n        try:\n            result.append(int(stripped_element))\n        except ValueError:\n            raise ValueError(f\"Invalid integer element: '{stripped_element}'\")\n    return tuple(result)"}
{"task_id": "Mbpp/787", "solution": "def text_match_three(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input_string contains the pattern 'abbb'.\n    Returns True if the pattern is found, False otherwise.\n    \"\"\"\n    return 'abbb' in input_string"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays from the input array.\n    Adds the sum of each odd-length subarray to a running total.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):  # Start index\n        for j in range(i, n):  # End index\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:  # Check if subarray length is odd\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value_to_insert):\n    \"\"\"\n    Determines the rightmost index where 'value_to_insert' can be inserted into 'sorted_list'\n    while maintaining the sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value_to_to_insert:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\ndef _find_first_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the first odd number in a list.\n    Returns the first odd number or None if no odd number is found.\n    \"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    return None\ndef _find_first_even(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the first even number in a list.\n    Returns the first even number or None if no even number is found.\n    \"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    return None\ndef mul_even_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns the product or None if either number is not found.\n    \"\"\"\n    first_odd = _find_first_odd(numbers)\n    first_even = _find_first_even(numbers)\n\n    if first_odd is not None and first_even is not None:\n        return first_odd * first_even\n    else:\n        return None"}
