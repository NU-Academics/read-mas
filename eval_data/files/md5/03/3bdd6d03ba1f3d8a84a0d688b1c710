{"task_id": "Mbpp/430", "solution": "def parabola_directrix(a: float, b: float, c: float) -> float:\n    \"\"\"Calculates the y-coordinate of the directrix for a parabola y = ax^2 + bx + c.\"\"\"\n\n    class Parabola:\n        \"\"\"Internal helper class representing a parabola for directrix calculation.\"\"\"\n        def __init__(self, a_val: float, b_val: float, c_val: float):\n            self._a = a_val\n            self._b = b_val\n            self._c = c_val\n\n        def calculate_directrix_y(self) -> float:\n            \"\"\"Calculates the y-coordinate of the directrix using the formula y = c - (b^2 + 1)/(4a).\"\"\"\n            return self._c - (self._b**2 + 1) / (4 * self._a)\n\n    if a == 0:\n        raise ValueError(\"Coefficient 'a' cannot be zero, as this does not represent a parabola.\")\n\n    parabola_instance = Parabola(a, b, c)\n    return parabola_instance.calculate_directrix_y()"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Sorts an array of numbers in ascending order using the Shell Sort algorithm.\n    It modifies the input list in-place.\n    \"\"\"\n    n = len(arr)\n    gaps = []\n    h = 1\n    while h < n:\n        gaps.append(h)\n        h = 3 * h + 1\n    gaps.reverse()\n\n    for gap in gaps:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n    return arr"}
