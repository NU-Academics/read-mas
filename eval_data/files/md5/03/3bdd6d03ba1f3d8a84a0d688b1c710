{"task_id": "Mbpp/125", "solution": "def find_length(binary_string_value: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring of the given binary string.\n    \"\"\"\n\n    class Substring:\n        \"\"\"Represents a substring, stores counts of '0's and '1's, and their difference.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._zero_count = value.count('0')\n            self._one_count = value.count('1')\n            self._difference = self._zero_count - self._one_count\n\n        def get_difference(self) -> int:\n            return self._difference\n\n    class BinaryString:\n        \"\"\"Encapsulates a binary string and provides a method to generate all its substrings.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n\n        def get_substrings(self) -> list[Substring]:\n            substrings = []\n            n = len(self._value)\n            for i in range(n):\n                for j in range(i, n):\n                    sub_value = self._value[i : j+1]\n                    substrings.append(Substring(sub_value))\n            return substrings\n\n    class DifferenceCalculator:\n        \"\"\"Calculates the maximum difference among all substrings of a BinaryString object.\"\"\"\n        def find_max_difference(self, binary_string_obj: BinaryString) -> int:\n            max_diff = -float('inf')\n            substrings = binary_string_obj.get_substrings()\n\n            if not substrings:\n                return 0 # If no substrings (e.g., empty input string), the difference is 0.\n\n            for substring_obj in substrings:\n                diff = substring_obj.get_difference()\n                if diff > max_diff:\n                    max_diff = diff\n            return max_diff\n\n    binary_string_obj = BinaryString(binary_string_value)\n    calculator = DifferenceCalculator()\n    max_difference = calculator.find_max_difference(binary_string_obj)\n\n    return max_difference"}
