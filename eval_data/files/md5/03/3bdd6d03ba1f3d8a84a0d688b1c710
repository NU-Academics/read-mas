{"task_id": "Mbpp/721", "solution": "import math\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average path cost for the given square matrix.\n    A path moves only right or down from top-left to bottom-right.\n    \"\"\"\n    class Cell:\n        def __init__(self, row: int, col: int, cost: int):\n            self._row = row\n            self._col = col\n            self._cost = cost\n\n        def get_cost(self) -> int:\n            return self._cost\n\n        def get_row(self) -> int:\n            return self._row\n\n        def get_col(self) -> int:\n            return self._col\n\n    class Matrix:\n        def __init__(self, matrix_data: list[list[int]]):\n            self._N = len(matrix_data)\n            self._cells = []\n            for r in range(self._N):\n                row_cells = []\n                for c in range(self._N):\n                    row_cells.append(Cell(r, c, matrix_data[r][c]))\n                self._cells.append(row_cells)\n\n        def get_N(self) -> int:\n            return self._N\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self._cells[row][col]\n\n    class Path:\n        def __init__(self, cells: list[Cell]):\n            self._cells_in_path = cells\n            self._total_cost = sum(cell.get_cost() for cell in cells)\n            self._number_of_cells = len(cells)\n            self._average_cost = self.calculate_average()\n\n        def calculate_average(self) -> float:\n            if self._number_of_cells == 0:\n                return 0.0\n            return self._total_cost / self._number_of_cells\n\n        def get_total_cost(self) -> int:\n            return self._total_cost\n\n        def get_number_of_cells(self) -> int:\n            return self._number_of_cells\n\n        def get_average_cost(self) -> float:\n            return self._average_cost\n\n    class Result:\n        def __init__(self, max_avg_cost: float):\n            self._max_average_cost = max_avg_cost\n\n        def get_max_average_cost(self) -> float:\n            return self._max_average_cost\n\n    class PathFinder:\n        def __init__(self, matrix: Matrix):\n            self._matrix = matrix\n            self._paths: list[Path] = []\n            self._N = matrix.get_N()\n\n        def find_all_paths(self) -> list[Path]:\n            start_cell = self._matrix.get_cell(0, 0)\n            self._dfs(0, 0, [start_cell])\n            return self._paths\n\n        def _dfs(self, current_row: int, current_col: int, current_path_cells: list[Cell]):\n            # Base case: Reached the bottom-right cell\n            if current_row == self._N - 1 and current_col == self._N - 1:\n                self._paths.append(Path(list(current_path_cells)))\n                return\n\n            # Move right\n            if current_col + 1 < self._N:\n                next_cell = self._matrix.get_cell(current_row, current_col + 1)\n                current_path_cells.append(next_cell)\n                self._dfs(current_row, current_col + 1, current_path_cells)\n                current_path_cells.pop() # Backtrack\n\n            # Move down\n            if current_row + 1 < self._N:\n                next_cell = self._matrix.get_cell(current_row + 1, current_col)\n                current_path_cells.append(next_cell)\n                self._dfs(current_row + 1, current_col, current_path_cells)\n                current_path_cells.pop() # Backtrack\n\n    matrix_instance = Matrix(matrix_data)\n    path_finder_instance = PathFinder(matrix_instance)\n    all_paths = path_finder_instance.find_all_paths()\n\n    max_average = -math.inf\n\n    for path_object in all_paths:\n        path_average = path_object.get_average_cost()\n        if path_average > max_average:\n            max_average = path_average\n\n    result_object = Result(max_average)\n    return result_object.get_max_average_cost()"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of student data based on provided minimum height and weight.\n    Returns a new dictionary with students meeting both criteria.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        if height >= minimal_height and weight >= minimal_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in an input tuple.\n    Returns a tuple of length N where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(result)"}
