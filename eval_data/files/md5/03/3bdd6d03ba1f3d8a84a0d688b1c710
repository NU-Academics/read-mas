{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bit rotation on 'number' by 'd' positions,\n    treating 'number' as a 32-bit unsigned integer.\n    \"\"\"\n    d = d % 32\n\n    unsigned_number = number & 0xFFFFFFFF\n\n    rotated_value = ((unsigned_number << d) | (unsigned_number >> (32 - d))) & 0xFFFFFFFF\n\n    return rotated_value"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum length of consecutive uppercase characters in the given string.\n    \"\"\"\n    max_run_length = 0\n    current_run_length = 0\n    for char in input_string:\n        if char.isupper():\n            current_run_length += 1\n        else:\n            current_run_length = 0\n        max_run_length = max(max_run_length, current_run_length)\n    return max_run_length"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(num1: int, num2: int, num3: int) -> int:\n    \"\"\"Counts the number of equal integers among three given inputs.\"\"\"\n    if num1 == num2 and num2 == num3:\n        return 3\n    elif num1 == num2 or num1 == num3 or num2 == num3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list[int]) -> bool:\n    \"\"\"Checks if the product of numbers in the input list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    if not numbers:\n        return False  # An empty list product is 1 (odd).\n    \n    for num in numbers:\n        if num % 2 == 0:\n            return True  # If any number is even, the product is even.\n            \n    return False  # If all numbers are odd, the product is odd."}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a list of integers.\n    Returns None if no odd number is found.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains numerical elements.\n\n    Returns:\n        The inner list with the highest sum. If multiple lists have the same highest sum,\n        the first such list encountered is returned. Returns an empty list if the input\n        list_of_lists is empty.\n    \"\"\"\n    def _calculate_list_sum(sublist: list[int]) -> int:\n        \"\"\"Calculates the sum of elements for a single list.\"\"\"\n        return sum(sublist)\n\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_sum_list_result = []\n\n    for sublist in list_of_lists:\n        current_sum = _calculate_list_sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_sum_list_result = sublist\n            \n    return max_sum_list_result"}
