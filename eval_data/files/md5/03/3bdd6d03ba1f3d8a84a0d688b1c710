{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of common divisors for two integer inputs.\"\"\"\n\n    def _get_divisors_internal(n: int) -> set[int]:\n        \"\"\"Finds all positive divisors for a given integer n.\"\"\"\n        import math\n\n        divs = set()\n        for i in range(1, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        return divs\n\n    def _get_common_divisors_internal(n1: int, n2: int) -> set[int]:\n        \"\"\"Finds all common positive divisors between two given integers.\"\"\"\n        divisors1 = _get_divisors_internal(n1)\n        divisors2 = _get_divisors_internal(n2)\n        return divisors1.intersection(divisors2)\n\n    common_divs = _get_common_divisors_internal(num1, num2)\n    total_sum = sum(common_divs)\n    return total_sum"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words in the given text that are strictly longer than n characters.\n\n    Args:\n        n (int): The length threshold. Words must be longer than this value.\n        text (str): The input string containing words to be processed.\n\n    Returns:\n        list[str]: A list of words from the text that are longer than n characters.\n    \"\"\"\n    words = text.split()\n    long_words_list = [word for word in words if len(word) > n]\n    return long_words_list"}
{"task_id": "Mbpp/130", "solution": "import collections\ndef max_occurrences(input_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Utilizes collections.Counter for efficient frequency counting.\n    \"\"\"\n    if not input_list:\n        return None # Or raise an error, or return a default value based on desired behavior for empty lists.\n\n    counts = collections.Counter(input_list)\n    # most_common(1) returns a list of one (item, count) tuple.\n    # We want the item from this tuple.\n    max_item = counts.most_common(1)[0][0]\n    return max_item"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix_data: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given matrix is a magic square.\n    This function orchestrates checks for square dimensions and equal sums across rows, columns, and diagonals.\n    \"\"\"\n\n    class Row:\n        def __init__(self, elements: list[int]):\n            self._elements = elements\n\n        def calculate_sum(self) -> int:\n            return sum(self._elements)\n\n    class Column:\n        def __init__(self, elements: list[int]):\n            self._elements = elements\n\n        def calculate_sum(self) -> int:\n            return sum(self._elements)\n\n    class Diagonal:\n        def __init__(self, elements: list[int]):\n            self._elements = elements\n\n        def calculate_sum(self) -> int:\n            return sum(self._elements)\n\n    class Matrix:\n        def __init__(self, elements: list[list[int]]):\n            self._elements = elements\n            self._size = len(elements) if elements else 0\n\n        def is_square(self) -> bool:\n            if not self._elements:\n                return True # An empty matrix (0x0) is considered square.\n            return all(len(row) == self._size for row in self._elements)\n\n        def get_rows(self) -> list['Row']:\n            return [Row(row_elements) for row_elements in self._elements]\n\n        def get_columns(self) -> list['Column']:\n            columns = []\n            for j in range(self._size):\n                column_elements = [self._elements[i][j] for i in range(self._size)]\n                columns.append(Column(column_elements))\n            return columns\n\n        def get_main_diagonal(self) -> 'Diagonal':\n            diagonal_elements = [self._elements[i][i] for i in range(self._size)]\n            return Diagonal(diagonal_elements)\n\n        def get_anti_diagonal(self) -> 'Diagonal':\n            anti_diagonal_elements = [self._elements[i][self._size - 1 - i] for i in range(self._size)]\n            return Diagonal(anti_diagonal_elements)\n\n    class MagicSquareChecker:\n        def check(self, matrix: 'Matrix') -> bool:\n            if not matrix.is_square():\n                return False\n            \n            # A 0x0 matrix is considered a magic square.\n            if matrix._size == 0:\n                return True\n\n            rows = matrix.get_rows()\n            cols = matrix.get_columns()\n            main_diag = matrix.get_main_diagonal()\n            anti_diag = matrix.get_anti_diagonal()\n\n            row_sums = [r.calculate_sum() for r in rows]\n            col_sums = [c.calculate_sum() for c in cols]\n            main_diag_sum = main_diag.calculate_sum()\n            anti_diag_sum = anti_diag.calculate_sum()\n\n            magic_sum = row_sums[0]\n\n            if not all(s == magic_sum for s in row_sums):\n                return False\n            if not all(s == magic_sum for s in col_sums):\n                return False\n            if main_diag_sum != magic_sum:\n                return False\n            if anti_diag_sum != magic_sum:\n                return False\n\n            return True\n\n    matrix_obj = Matrix(matrix_data)\n    checker = MagicSquareChecker()\n    return checker.check(matrix_obj)"}
