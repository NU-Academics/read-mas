{"task_id": "Mbpp/597", "solution": "def find_kth(arr1, arr2, k):\n    \"\"\"\n    Finds the kth smallest element from two given sorted arrays.\n    \"\"\"\n    merged_array = []\n    ptr1, ptr2 = 0, 0\n\n    while ptr1 < len(arr1) and ptr2 < len(arr2):\n        if arr1[ptr1] <= arr2[ptr2]:\n            merged_array.append(arr1[ptr1])\n            ptr1 += 1\n        else:\n            merged_array.append(arr2[ptr2])\n            ptr2 += 1\n\n    while ptr1 < len(arr1):\n        merged_array.append(arr1[ptr1])\n        ptr1 += 1\n\n    while ptr2 < len(arr2):\n        merged_array.append(arr2[ptr2])\n        ptr2 += 1\n\n    return merged_array[k - 1]"}
{"task_id": "Mbpp/594", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\ndef _is_odd(number: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return number % 2 != 0\ndef diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the absolute difference between the first even and first odd number in a list.\n\n    Raises:\n        ValueError: If no even number or no odd number is found in the list.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and _is_even(num):\n            first_even = num\n        if first_odd is None and _is_odd(num):\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return abs(first_even - first_odd)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if the given integer is an Armstrong number.\"\"\"\n    str_number = str(number)\n    num_digits = len(str_number)\n    sum_of_powers = 0\n    for digit_char in str_number:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    return sum_of_powers == number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first 'n' natural numbers.\n    Assumes 'n' is a positive integer.\n    \"\"\"\n    calculated_sum = n * (n + 1) // 2\n    calculated_average = calculated_sum / n\n    return (calculated_sum, calculated_average)"}
