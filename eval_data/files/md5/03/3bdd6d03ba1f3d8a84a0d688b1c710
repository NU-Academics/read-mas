{"task_id": "Mbpp/104", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a list of lists lexicographically.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains strings.\n\n    Returns:\n        A new list of lists with each sublist sorted alphabetically.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in list_of_lists:\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    Follows the recursive definition and base cases provided in the design.\n    \"\"\"\n    if m < 0 or m >= n:\n        return 0\n    if m == 0:\n        return 1\n    if n == 0:\n        if m == 0: return 1\n        return 0\n\n    term1 = (m + 1) * eulerian_num(n - 1, m)\n    term2 = (n - m) * eulerian_num(n - 1, m - 1)\n    return term1 + term2"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a CamelCase string.\n    Capitalizes the first letter of each word and removes underscores.\n    \"\"\"\n    words = snake_case_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return \"\".join(camel_case_words)"}
