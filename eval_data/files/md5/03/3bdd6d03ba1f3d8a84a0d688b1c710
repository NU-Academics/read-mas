{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts the number of indices where values in two lists are identical.\n    Raises ValueError if lists are not of the same length.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have the same length\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function orchestrates the use of internal Number and Calculator classes.\n    \"\"\"\n    class Number:\n        \"\"\"\n        Encapsulates an integer value and provides methods for exponentiation\n        and extracting its individual digits.\n        \"\"\"\n        def __init__(self, initial_value: int):\n            self._value = initial_value\n\n        def power(self, exponent: int) -> 'Number':\n            \"\"\"Calculates self._value raised to exponent and returns a new Number object.\"\"\"\n            result = self._value ** exponent\n            return Number(result)\n\n        def get_digits(self) -> list[int]:\n            \"\"\"Converts the internal value to a list of its individual digits.\"\"\"\n            return [int(d) for d in str(self._value)]\n\n    class Calculator:\n        \"\"\"\n        Implements the core business logic for calculating the sum of digits\n        of a number raised to a power, utilizing the Number class.\n        \"\"\"\n        def calculate_power_digit_sum(self, base: int, power: int) -> int:\n            base_num = Number(base)\n            result_num = base_num.power(power)\n            digits = result_num.get_digits()\n            return sum(digits)\n\n    calculator = Calculator()\n    return calculator.calculate_power_digit_sum(base, power)"}
