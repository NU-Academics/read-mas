{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number.\n    The sequence starts with L(0)=2, L(1)=1, and L(n) = L(n-1) + L(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        next_lucas = a + b\n        a = b\n        b = next_lucas\n    return b"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Converts three input lists into a list of nested dictionaries.\n    Each dictionary in the output list will be of the form `{outer_key: {inner_key: inner_value}}`.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(list1)):\n        outer_key = list1[i]\n        inner_key = list2[i]\n        inner_value = list3[i]\n        result.append({outer_key: {inner_key: inner_value}})\n    return result"}
