{"task_id": "Mbpp/589", "solution": "def perfect_squares(lower_bound: int, upper_bound: int) -> list[int]:\n    # This list will store all perfect squares found in the given range.\n    squares_found = []\n    # Iterates through each number from the lower bound up to and including the upper bound.\n    for num in range(lower_bound, upper_bound + 1):\n        # Check for non-negative numbers; if its square root is an integer, it's a perfect square.\n        if num >= 0:\n            sqrt_val = num**0.5\n            if sqrt_val == int(sqrt_val):\n                squares_found.append(num)\n    return squares_found"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(magnitude: float, angle: float) -> tuple[float, float]:\n    \"\"\"\n    Converts polar coordinates (magnitude, angle) to rectangular coordinates (x, y).\n    The angle is assumed to be in radians.\n    \"\"\"\n    x = magnitude * math.cos(angle)\n    y = magnitude * math.sin(angle)\n    return x, y"}
{"task_id": "Mbpp/592", "solution": "import math\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n\n    Returns C(n, k), or 0 if k is out of bounds [0, n].\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    # C(n, k) = n! / (k! * (n-k)!)\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the products of consecutive binomial coefficients.\n\n    Sums C(n, k) * C(n, k+1) for k from 0 to n-1.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    # Iterate k from 0 to n-1 as per the problem description\n    for k in range(n):\n        C_nk = _calculate_binomial_coefficient(n, k)\n        C_nk_plus_1 = _calculate_binomial_coefficient(n, k + 1)\n        total_sum += C_nk * C_nk_plus_1\n    return total_sum"}
