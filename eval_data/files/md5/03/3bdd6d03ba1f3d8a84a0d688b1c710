{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts an input tuple into a dictionary using adjacent elements.\n    If the input tuple has an odd number of elements, the last element is ignored.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple) - 1, 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Transforms an input string by inserting a space before each character that is an uppercase letter,\n    provided that the character is not the first character of the string and either:\n    (1) the preceding character is a lowercase letter, or\n    (2) the preceding character is an uppercase letter and the subsequent character is a lowercase letter.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    for i, char in enumerate(input_string):\n        if i > 0 and char.isupper():\n            prev_char = input_string[i-1]\n            # Rule 1: preceding character is a lowercase letter\n            condition1 = prev_char.islower()\n\n            # Rule 2: preceding character is an uppercase letter AND the subsequent character is a lowercase letter\n            condition2 = False\n            if prev_char.isupper() and i + 1 < len(input_string):\n                next_char = input_string[i+1]\n                condition2 = next_char.islower()\n\n            if condition1 or condition2:\n                result_chars.append(' ')\n        result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"Finds numbers within a given range where every number is divisible by every non-zero digit it contains.\n    Returns a list of integers satisfying the criteria, sorted in ascending order.\n    \"\"\"\n    def _get_digits(number: int) -> list[int]:\n        \"\"\"Helper function to extract constituent digits from an integer.\"\"\"\n        if number == 0:\n            return [0]\n        digits = []\n        temp_num = abs(number)\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        return digits[::-1]\n\n    def _is_divisible_by_all_non_zero_digits(number: int, digits: list[int]) -> bool:\n        \"\"\"Helper function to check if a number is divisible by all its non-zero digits.\"\"\"\n        for digit in digits:\n            if digit == 0:\n                continue\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for n in range(startnum, endnum + 1):\n        digits = _get_digits(n)\n        if _is_divisible_by_all_non_zero_digits(n, digits):\n            result.append(n)\n    return result"}
