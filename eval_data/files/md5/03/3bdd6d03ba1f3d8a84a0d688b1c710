{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k_value: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the k records with the smallest integer values from a list of tuples.\n    Returns the records sorted by their integer value.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda item: item[1])\n    return sorted_list[:k_value]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Identifies and returns elements that appear at the same index\n    in all three input lists and have identical values.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n\n    common_elements = []\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes\n    # The last parent node is at index (n // 2) - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
