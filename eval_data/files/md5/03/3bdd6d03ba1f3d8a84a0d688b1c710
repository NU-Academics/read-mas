{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either increasing or decreasing).\n    An array is monotonic if all elements are non-decreasing or non-increasing.\n    \"\"\"\n\n    def _is_increasing(arr: list) -> bool:\n        \"\"\"Checks if an array is monotonically increasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(arr: list) -> bool:\n        \"\"\"Checks if an array is monotonically decreasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n\n    # An array with zero or one element is always monotonic.\n    if len(array) <= 1:\n        return True\n\n    return _is_increasing(array) or _is_decreasing(array)"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number B_n for a given non-negative integer `n`.\"\"\"\n\n    def stirling_second_kind(n_val: int, k_val: int, memo: dict) -> int:\n        \"\"\"Calculates S(n, k) using dynamic programming with memoization.\"\"\"\n        if k_val == 0:\n            return 1 if n_val == 0 else 0\n        if k_val == n_val:\n            return 1\n        if k_val > n_val:\n            return 0\n        if (n_val, k_val) in memo:\n            return memo[(n_val, k_val)]\n\n        result = stirling_second_kind(n_val - 1, k_val - 1, memo) + k_val * stirling_second_kind(n_val - 1, k_val, memo)\n        memo[(n_val, k_val)] = result\n        return result\n\n    if n == 0:\n        return 1\n\n    total_bell = 0\n    memo = {}\n    for k in range(n + 1):\n        total_bell += stirling_second_kind(n, k, memo)\n    return total_bell"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(elements: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order using the Comb Sort algorithm.\n\n    Args:\n        elements: The list of elements to be sorted.\n\n    Returns:\n        A new list containing the elements sorted in ascending order.\n    \"\"\"\n    n = len(elements)\n    if n == 0:\n        return []\n\n    # Create a copy to avoid modifying the original list in place\n    arr = elements[:]\n\n    gap = n\n    shrink_factor = 1.3\n    sorted_flag = False\n\n    while not sorted_flag:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n        \n        sorted_flag = True\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                sorted_flag = False\n        \n        # If gap is 1 and no swaps were made, the list is sorted\n        if gap == 1 and sorted_flag:\n            break\n\n    return arr"}
