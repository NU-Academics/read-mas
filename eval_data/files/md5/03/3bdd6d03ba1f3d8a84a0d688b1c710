{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces all whitespace characters with underscores and all underscores with whitespaces\n    in the given input string using a temporary character for bidirectional replacement.\n    \"\"\"\n    temp_char = '\\0'  # Use null character as a safe intermediate\n    modified_string = input_string.replace(' ', temp_char)\n    modified_string = modified_string.replace('_', ' ')\n    modified_string = modified_string.replace(temp_char, '_')\n    return modified_string"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates for the given coordinate tuple (x, y).\n    Adjacent coordinates include all points (x', y') such that x' is in {x-1, x, x+1}\n    and y' is in {y-1, y, y+1}, including the given coordinate itself.\n    \"\"\"\n    x, y = coordinate_tuple\n    adjacent = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent.append([x + dx, y + dy])\n    return adjacent"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"Moves all zeroes to the end of the given list while preserving the relative order of non-zero elements.\"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for num in input_list:\n        if num == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(num)\n\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements"}
{"task_id": "Mbpp/639", "solution": "class Name:\n    \"\"\"Encapsulates a single name string and provides methods to check its initial character case and retrieve its length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        return self._value\n\n    def get_length(self) -> int:\n        return len(self._value)\n\n    def starts_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase letter.\"\"\"\n        return self._value and 'a' <= self._value[0] <= 'z'\nclass NameList:\n    \"\"\"Manages a collection of Name objects, filters them, and calculates the total sum of lengths.\"\"\"\n    def __init__(self, name_strings: list[str]):\n        self._names = [Name(name_string) for name_string in name_strings]\n\n    def get_valid_names(self) -> list[Name]:\n        \"\"\"Filters and returns a list of Name objects that do not start with a lowercase letter.\"\"\"\n        return [name for name in self._names if not name.starts_with_lowercase()]\n\n    def calculate_total_length(self) -> int:\n        \"\"\"Calculates the sum of lengths of all valid names within the list.\"\"\"\n        valid_names = self.get_valid_names()\n        return sum(name.get_length() for name in valid_names)\ndef sample_nam(name_strings: list[str]) -> int:\n    \"\"\"\n    Accepts a list of strings, filters out names starting with lowercase letters,\n    and returns the sum of lengths of the remaining names.\n    \"\"\"\n    name_list_obj = NameList(name_strings)\n    return name_list_obj.calculate_total_length()"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], count: int) -> int:\n    # Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    # Iterates through all possible unique pairs, performs XOR, and accumulates the sum.\n    total_xor_sum = 0\n    for i in range(count):\n        for j in range(i + 1, count):\n            total_xor_sum += numbers[i] ^ numbers[j]\n    return total_xor_sum"}
