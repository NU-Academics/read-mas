{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if an integer is a non-prime number.\n    Returns True if the number is non-prime, False if it is prime or less than or equal to 1.\n    \"\"\"\n    if number <= 1:\n        return False  # Numbers less than or equal to 1 are not prime by definition (and thus not non-prime).\n    if number == 2:\n        return False  # 2 is a prime number.\n    if number % 2 == 0:\n        return True  # Any even number greater than 2 is non-prime.\n\n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True  # Found a divisor, so it's a non-prime number.\n        i += 2\n    return False  # No divisors found, so it's a prime number."}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from the string.\n    If only one occurrence exists, it removes that single occurrence.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n\n    if first_idx == -1:\n        # Character is not found in the string\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        # Only one occurrence of the character\n        modified_string = input_string[:first_idx] + input_string[first_idx+1:]\n    else:\n        # Multiple occurrences: remove the first occurrence\n        temp_string = input_string[:first_idx] + input_string[first_idx+1:]\n        # Find the last occurrence in the temporary string and remove it\n        adjusted_last_idx = temp_string.rfind(char_to_remove)\n        modified_string = temp_string[:adjusted_last_idx] + temp_string[adjusted_last_idx+1:]\n\n    return modified_string"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Leverages heapq.nlargest for efficient retrieval, then sorts the result.\n    \"\"\"\n    largest_n = heapq.nlargest(n, numbers)\n    largest_n.sort(reverse=True)\n    return largest_n"}
