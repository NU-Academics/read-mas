{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Uses helper functions for modularity.\n    \"\"\"\n    def _calculate_reverse(num: int) -> int:\n        \"\"\"Calculates the reverse of an integer.\"\"\"\n        s = str(num)\n        return int(s[::-1])\n\n    def _calculate_target_value(reversed_num: int) -> int:\n        \"\"\"Calculates the target value: (2 * reversed_num) - 1.\"\"\"\n        return (2 * reversed_num) - 1\n\n    reversed_num = _calculate_reverse(number)\n    target_value = _calculate_target_value(reversed_num)\n    return number == target_value"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number using the formula n * 2^n - 1.\"\"\"\n\n    def _calculate_woodall(n: int) -> int:\n        \"\"\"Calculates a Woodall number for a given non-negative integer n.\"\"\"\n        return n * (2**n) - 1\n\n    n = 0\n    while True:\n        woodall_candidate = _calculate_woodall(n)\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number and n > 0: # Optimization: for n=0, woodall_candidate is -1, might be smaller than number\n            # If the calculated Woodall number exceeds the target,\n            # the target cannot be a Woodall number since they are monotonically increasing for n >= 1.\n            # Handle the specific case of W0 = -1 separately if number is positive but smaller than W1.\n            return False\n        n += 1"}
