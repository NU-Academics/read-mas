{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list):\n    \"\"\"Sorts a list of numerical elements in ascending order using the pancake sort algorithm.\"\"\"\n    working_list = list(input_list)\n    n = len(working_list)\n\n    def _flip(arr, i):\n        \"\"\"Reverses the order of elements within a specified prefix of a list (in-place).\"\"\"\n        start = 0\n        while start < i:\n            arr[start], arr[i] = arr[i], arr[start]\n            start += 1\n            i -= 1\n\n    def _find_max_index(arr, n_prefix):\n        \"\"\"Finds the index of the maximum element within a specified prefix of a list.\"\"\"\n        max_val = arr[0]\n        max_idx = 0\n        for i in range(1, n_prefix):\n            if arr[i] > max_val:\n                max_val = arr[i]\n                max_idx = i\n        return max_idx\n\n    for current_size in range(n, 1, -1):\n        # Find index of the maximum element in the current prefix\n        max_idx = _find_max_index(working_list, current_size)\n\n        # If the maximum element is not already at the end of the current prefix\n        if max_idx != current_size - 1:\n            # Move the maximum element to the beginning\n            _flip(working_list, max_idx)\n            # Move the maximum element to its correct sorted position\n            _flip(working_list, current_size - 1)\n            \n    return working_list"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where elements are identical across all three input lists.\n    The comparison is limited by the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    identical_count = 0\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            identical_count += 1\n            \n    return identical_count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    For example, sum_series(6) computes 6 + 4 + 2 + 0 = 12.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list: list, elements_to_remove_list: list) -> list:\n    \"\"\"\n    Removes all elements from source_list that are present in elements_to_remove_list.\n    The order of the remaining elements is preserved, and a new list is returned.\n    \"\"\"\n    elements_to_remove_set = set(elements_to_remove_list)\n    result_list = []\n    for element in source_list:\n        if element not in elements_to_remove_set:\n            result_list.append(element)\n    return result_list"}
{"task_id": "Mbpp/160", "solution": "def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Implements the Extended Euclidean Algorithm.\n    Returns (gcd, x, y) such that ax + by = gcd(a, b).\n    \"\"\"\n    if a == 0:\n        return b, 0, 1\n    gcd, x1, y1 = extended_gcd(b % a, a)\n    x = y1 - (b // a) * x1\n    y = x1\n    return gcd, x, y\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    \"\"\"\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        else:\n            return None\n\n    if a == 0:  # by = n\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n\n    if b == 0:  # ax = n\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    g, x_prime, y_prime = extended_gcd(a, b)\n\n    if n % g != 0:\n        return None\n\n    factor = n // g\n    x0 = x_prime * factor\n    y0 = y_prime * factor\n\n    return (x0, y0)"}
{"task_id": "Mbpp/165", "solution": "def _get_alphabet_position(char_val: str) -> int:\n    \"\"\"\n    Determines the 0-indexed alphabet position of a given English letter (case-insensitively).\n    Returns -1 if the character is not an English letter.\n    \"\"\"\n    if 'a' <= char_val.lower() <= 'z':\n        return ord(char_val.lower()) - ord('a')\n    return -1\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in the input string where the string position matches the alphabet position.\n    \"\"\"\n    count = 0\n    for i, char_val in enumerate(input_string):\n        alphabet_pos = _get_alphabet_position(char_val)\n        if alphabet_pos != -1 and i == alphabet_pos:\n            count += 1\n    return count"}
