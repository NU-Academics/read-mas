{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(input_list: list[int], list_length: int) -> int:\n    \"\"\"\n    Calculates the number of pairs from an input list of integers\n    whose bitwise XOR value is odd.\n    \"\"\"\n    if list_length < 2:\n        return 0\n\n    odd_count = 0\n    even_count = 0\n\n    for number in input_list:\n        if number % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    result_count = odd_count * even_count\n\n    return result_count"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers and returns a new list containing only the odd ones, preserving their original relative order.\"\"\"\n    odd_integers = []\n    for number in input_list:\n        # An integer 'n' is considered odd if 'n % 2 != 0'.\n        if number % 2 != 0:\n            # Only include odd integers in the output list, preserving their original order.\n            odd_integers.append(number)\n    return odd_integers"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"Calculates the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.\"\"\"\n    sum_of_natural_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_natural_numbers * sum_of_natural_numbers\n    return sum_of_cubes - sum_of_natural_numbers"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n    Uppercase letters become lowercase, and lowercase letters become uppercase, leaving other characters unchanged.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit differences between two integers.\n    It aligns the numbers by padding the shorter one with leading zeros.\n    \"\"\"\n\n    def _get_digits_list(number: int, length: int) -> list[int]:\n        \"\"\"Converts an integer to a list of its digits, padded with leading zeros.\n        Pads the number with leading zeros to the desired length.\n        \"\"\"\n        s_number = str(abs(number)).zfill(length)\n        return [int(digit) for digit in s_number]\n\n    # Determine the maximum length for digit alignment, considering absolute values\n    max_length = max(len(str(abs(num1))), len(str(abs(num2))))\n\n    # Get digit lists, padded with leading zeros using the nested helper\n    digits1 = _get_digits_list(num1, max_length)\n    digits2 = _get_digits_list(num2, max_length)\n\n    total_sum = 0\n    # Iterate through the aligned digit lists and sum the absolute differences\n    for d1, d2 in zip(digits1, digits2):\n        total_sum += abs(d1 - d2)\n\n    return total_sum"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two tuples, ensures uniqueness,\n    sorts them in ascending order, and returns the result as a tuple.\n    \"\"\"\n    combined_elements = list(tuple1) + list(tuple2)\n    unique_elements = sorted(list(set(combined_elements)))\n    return tuple(unique_elements)"}
