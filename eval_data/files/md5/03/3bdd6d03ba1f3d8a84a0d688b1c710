{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in a given string, where words are separated by spaces.\n    Handles multiple spaces and leading/trailing spaces correctly.\n    \"\"\"\n    words = input_string.split()\n    reversed_words = words[::-1]\n    return \" \".join(reversed_words)"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(N: int) -> list[int]:\n    \"\"\"\n    Calculates and returns a sorted list of lucid numbers up to N.\n    Lucid numbers are defined as 1 and all prime numbers up to N.\n    \"\"\"\n    def _sieve_of_eratosthenes(limit: int) -> list[int]:\n        \"\"\"\n        Generates all prime numbers up to 'limit' using the Sieve of Eratosthenes.\n        \"\"\"\n        if limit < 2:\n            return []\n\n        is_prime = [True] * (limit + 1)\n        is_prime[0] = is_prime[1] = False\n\n        p = 2\n        while p * p <= limit:\n            if is_prime[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime[multiple] = False\n            p += 1\n\n        primes = [i for i, prime_status in enumerate(is_prime) if prime_status]\n        return primes\n\n    lucid_numbers_list = []\n\n    if N >= 1:\n        lucid_numbers_list.append(1)\n\n    if N >= 2:\n        primes = _sieve_of_eratosthenes(N)\n        lucid_numbers_list.extend(primes)\n    \n    # The list is already sorted by the order of operations: 1, then primes from sieve.\n    # explicit sort ensures FR8 even if sieve order changes for some reason.\n    lucid_numbers_list.sort() \n\n    return lucid_numbers_list"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\nclass MatchResult:\n    \"\"\"Stores the matched substring and its 0-based start and end indices.\"\"\"\n    def __init__(self, substring: str, start_index: int, end_index: int) -> None:\n        self.substring = substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def to_tuple(self) -> Tuple[str, int, int]:\n        \"\"\"Converts the MatchResult object into a tuple (substring, start_index, end_index).\"\"\"\n        return (self.substring, self.start_index, self.end_index)\n\n    def __eq__(self, other):\n        if isinstance(other, MatchResult):\n            return (self.substring == other.substring and\n                    self.start_index == other.start_index and\n                    self.end_index == other.end_index)\n        elif isinstance(other, tuple) and len(other) == 3:\n            return (self.substring, self.start_index, self.end_index) == other\n        return NotImplemented\ndef find_literals(text: str, pattern: str) -> Optional[MatchResult]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring, start index, and end index.\n    Returns a MatchResult object if a match is found, otherwise None.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return MatchResult(match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the Nth Bell number using dynamic programming.\n    The Bell number B_n is the number of partitions of a set of n elements.\n    \"\"\"\n    # Base cases\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    # Dynamic programming approach using Stirling numbers of the second kind.\n    # S[i][j] will store Stirling numbers of second kind S(i, j).\n    S = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base cases for Stirling numbers of the second kind\n    S[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            S[i][j] = S[i - 1][j - 1] + j * S[i - 1][j]\n\n    # Bell number B_n is the sum of S(n, k) for k from 0 to n\n    bell_num = 0\n    for k in range(n + 1):\n        bell_num += S[n][k]\n\n    return bell_num"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"Removes the k-th (1-indexed) element from a list and returns a new list.\"\"\"\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(\"k is out of bounds for the input list.\")\n    \n    # k-1 because k is 1-indexed while list slicing is 0-indexed\n    return input_list[:k-1] + input_list[k:]"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: list) -> list:\n    \"\"\"\n    Transforms a list of paired elements into two separate lists.\n    The first output list contains the first element of each sublist, and the second contains the second.\n    \"\"\"\n    first_elements_list = []\n    second_elements_list = []\n    for sublist in input_list:\n        first_elements_list.append(sublist[0])\n        second_elements_list.append(sublist[1])\n    return [first_elements_list, second_elements_list]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list: list[tuple]) -> int | float:\n    \"\"\"Calculates the cumulative sum of all numerical values in a list of tuples.\n    It iterates through each tuple and sums its elements to a running total.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for value in tpl:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns these averages as a list of floats.\n    \"\"\"\n    results = []\n    for inner_tuple in tuple_of_tuples:\n        current_average = sum(inner_tuple) / len(inner_tuple)\n        results.append(current_average)\n    return results"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: List[List[int]], n: int) -> int:\n    \"\"\"\n    Finds the maximum value in the specified n-th column of a matrix.\n    Assumes a non-empty matrix with consistent rows and a valid column index n.\n    \"\"\"\n    nth_column_elements = []\n    for row in matrix:\n        nth_column_elements.append(row[n])\n    return max(nth_column_elements)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string.\n    Preserves the relative order of non-numeric characters and numeric characters.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return ''.join(non_numeric_chars) + ''.join(numeric_chars)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n\n    Raises ValueError if the input tuples are not of the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must be of the same length.\")\n\n    result = tuple(a % b for a, b in zip(tuple1, tuple2))\n    return result"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list[float | int], list2: list[float | int]) -> list[float]:\n    \"\"\"\n    Performs element-wise division of two lists element-wise.\n\n    Args:\n        list1: The first list of numerical values (integers or floats).\n        list2: The second list of numerical values (integers or floats).\n\n    Returns:\n        A new list containing the floating-point results of the element-wise division.\n\n    Raises:\n        TypeError: If list1 or list2 are not lists, or contain non-numerical elements.\n        ValueError: If list1 and list2 have different lengths.\n        ZeroDivisionError: If an element in list2 is zero during division.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Inputs must be lists.\")\n\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result_list = []\n    for i in range(len(list1)):\n        num1 = list1[i]\n        num2 = list2[i]\n\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise TypeError(\"Input lists must contain only numerical elements.\")\n\n        if num2 == 0:\n            raise ZeroDivisionError(f\"Division by zero encountered at index {i}.\")\n\n        result_list.append(float(num1) / num2)\n\n    return result_list"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list) -> int:\n    \"\"\"\n    Calculates the size of the largest subset from the input list where every pair is mutually divisible.\n    \"\"\"\n\n    def _validate_input(nums: list):\n        \"\"\"\n        Validates the type and elements of the input list, raising TypeError for invalid inputs.\n        \"\"\"\n        if not isinstance(nums, list):\n            raise TypeError(\"Input must be a list.\")\n        for x in nums:\n            if not isinstance(x, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n            if x <= 0:\n                raise TypeError(\"All elements in the list must be positive integers.\")\n\n    def _is_divisible_pair(a: int, b: int) -> bool:\n        \"\"\"\n        Checks if two positive integers are mutually divisible.\n        \"\"\"\n        return (a % b == 0) or (b % a == 0)\n\n    def _is_divisible_subset(subset: list) -> bool:\n        \"\"\"\n        Checks if every pair of distinct numbers in the subset is mutually divisible.\n        \"\"\"\n        n = len(subset)\n        if n <= 1:\n            return True\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                if not _is_divisible_pair(subset[i], subset[j]):\n                    return False\n        return True\n\n    def _generate_subsets(nums: list) -> list[list]:\n        \"\"\"\n        Generates all possible subsets of a given list of numbers using an iterative approach.\n        \"\"\"\n        all_subsets = [[]]\n        for num in nums:\n            newly_added_subsets = []\n            for current_subset in all_subsets:\n                new_subset = list(current_subset)\n                new_subset.append(num)\n                newly_added_subsets.append(new_subset)\n            all_subsets.extend(newly_added_subsets)\n        return all_subsets\n\n    _validate_input(numbers)\n\n    if not numbers:\n        return 0\n\n    all_subsets = _generate_subsets(numbers)\n    max_size = 0\n\n    for subset in all_subsets:\n        if _is_divisible_subset(subset):\n            max_size = max(max_size, len(subset))\n\n    return max_size"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers: list, exponent: int) -> list:\n    \"\"\"\n    Computes the n-th power for each number in the input list.\n    Returns a new list containing these results.\n    \"\"\"\n    result = []\n    for number in numbers:\n        result.append(number ** exponent)\n    return result"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius: float) -> float | None:\n    \"\"\"\n    Calculates the area of the largest triangle that can be inscribed in a semicircle.\n    Returns the calculated area if radius is non-negative, otherwise None.\n    \"\"\"\n    if radius < 0:\n        return None\n\n    # The largest triangle has a base of 2*radius and a height of radius.\n    area = radius * radius\n    return float(area)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[float], list2: list[float], size: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of equal size.\n    Assumes list1 and list2 are sorted and of equal size.\n    \"\"\"\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    m1 = -1.0 # To store the (size-1)-th element\n    m2 = -1.0 # To store the (size)-th element\n\n    # Iterate to find the elements at positions 'size-1' and 'size' (0-indexed)\n    for count in range(size + 1):\n        if i == size: # All elements of list1 processed\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n        elif j == size: # All elements of list2 processed\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        elif list1[i] < list2[j]:\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        else:\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n\n    return (m1 + m2) / 2.0"}
