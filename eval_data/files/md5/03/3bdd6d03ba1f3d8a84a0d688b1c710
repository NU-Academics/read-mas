{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    It iterates from 1 up to n to find all numbers that divide n without a remainder.\n    \"\"\"\n    count = 0\n    # Loop from 1 up to n to check for divisors.\n    for d in range(1, n + 1):\n        # If d divides n without a remainder, it's a divisor.\n        if n % d == 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating, meaning its digits strictly alternate between two distinct values.\n    \"\"\"\n    num_str = str(abs(number))\n\n    if len(num_str) < 2:\n        return False\n\n    first_digit = int(num_str[0])\n    second_digit = int(num_str[1])\n\n    if first_digit == second_digit:\n        return False\n\n    for i in range(len(num_str)):\n        current_digit = int(num_str[i])\n        if i % 2 == 0:\n            if current_digit != first_digit:\n                return False\n        else:\n            if current_digit != second_digit:\n                return False\n\n    return True"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Raises ValueError if the input list_of_lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        raise ValueError(\"Input list_of_lists cannot be empty.\")\n\n    min_length = float('inf')\n    for inner_list in list_of_lists:\n        min_length = min(min_length, len(inner_list))\n    return int(min_length)"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data: list[tuple]) -> any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple\n    with the smallest second value.\n    \"\"\"\n    if not data:\n        return None\n\n    min_second_value = float('inf')\n    result = None\n\n    for current_tuple in data:\n        first_value = current_tuple[0]\n        second_value = current_tuple[1]\n\n        if second_value < min_second_value:\n            min_second_value = second_value\n            result = first_value\n\n    return result"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a decimal integer to its binary string representation without leading zeros.\n    Handles the special case of 0 correctly.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n    return bin(decimal_number)[2:]"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    \"\"\"\n\n    def _flatten_list(nested_list):\n        \"\"\"Flattens a list of lists into a single list.\"\"\"\n        flat_list = []\n        for sublist in nested_list:\n            for item in sublist:\n                flat_list.append(item)\n        return flat_list\n\n    def _count_frequencies(flat_list):\n        \"\"\"Counts the frequency of each element in a flat list.\"\"\"\n        frequency_dict = {}\n        for item in flat_list:\n            frequency_dict[item] = frequency_dict.get(item, 0) + 1\n        return frequency_dict\n\n    flattened_list = _flatten_list(list_of_lists)\n    result_frequency = _count_frequencies(flattened_list)\n    return result_frequency"}
{"task_id": "Mbpp/98", "solution": "import math\ndef multiply_num(numbers: tuple) -> float:\n    \"\"\"\n    Calculates the product of all numbers in a tuple and divides by its length.\n    Returns math.nan if the input tuple is empty to handle division by zero.\n    \"\"\"\n    if not numbers:\n        return math.nan\n\n    product = 1.0\n    for num in numbers:\n        product *= float(num)\n\n    length = float(len(numbers))\n\n    result = product / length\n\n    return result"}
