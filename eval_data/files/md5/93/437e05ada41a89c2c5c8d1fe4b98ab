t of the operation.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n\n        def get_value(self) -> str:\n            \"\"\"Returns the encapsulated string value.\"\"\"\n            return self._value\n\n    class CircularShiftService:\n        \"\"\"Orchestrates the circular shift or reversal logic based on inputs.\"\"\"\n\n        def perform_shift(self, input_int: InputInteger, shift_amount: ShiftAmount) -> ShiftedResult:\n            \"\"\"Performs the circular shift or reversal operation and returns the result.\"\"\"\n            x_str = str(input_int.get_value())\n            num_digits = input_int.get_number_of_digits()\n            shift_val = shift_amount.get_value()\n\n            if shift_val > num_digits:\n                result_str = x_str[::-1]\n            else:\n                effective_shift = shift_val % num_digits\n                if effective_shift == 0:\n                    result_str = x_str\n                else:\n                    result_str = x_str[-effective_shift:] + x_str[:-effective_shift]\n\n            return ShiftedResult(result_str)\n\n    input_int = InputInteger(x)\n    shift_amount = ShiftAmount(shift)\n    service = CircularShiftService()\n    result = service.perform_shift(input_int, shift_amount)\n    return result.get_value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to easily extract min and max.\n    mutable_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    # Alternately pick minimum and maximum from the remaining elements.\n    while mutable_lis