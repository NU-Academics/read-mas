 FileName:\n        \"\"\"Encapsulates a file name string and performs validation checks.\"\"\"\n\n        def __init__(self, name_string: str):\n            self._name_string = name_string\n            self._digit_count = 0\n            self._dot_count = 0\n            self._prefix = \"\"\n            self._extension = \"\"\n            self._allowed_extensions = {'txt', 'exe', 'dll'}\n\n            self._count_digits()\n            self._count_dots()\n            self._extract_parts()\n\n        def _count_digits(self):\n            \"\"\"Counts the number of digits in the file name string.\"\"\"\n            self._digit_count = sum(1 for char in self._name_string if '0' <= char <= '9')\n\n        def _count_dots(self):\n            \"\"\"Counts the number of dots in the file name string.\"\"\"\n            self._dot_count = self._name_string.count('.')\n\n        def _extract_parts(self):\n            \"\"\"Extracts the prefix and extension if a single dot is present.\"\"\"\n            if self._dot_count == 1:\n                parts = self._name_string.split('.', 1)\n                self._prefix = parts[0]\n                self._extension = parts[1]\n\n        def _is_digit_count_valid(self):\n            \"\"\"Checks if the digit count is not more than three.\"\"\"\n            return self._digit_count <= 3\n\n        def _is_dot_count_valid(self):\n            \"\"\"Checks if there is exactly one dot.\"\"\"\n            return self._dot_count == 1\n\n        def _is_prefix_not_empty(self):\n            \"\"\"Checks if the prefix is not empty.\"\"\"\n            return bool(self._prefix)\n\n        def _is_prefix_starts_with_letter(self):\n            \"\"\"Checks if the prefix starts with a Latin alphabet letter.\"\"\"\n            if not self._prefix:\n                return False\n            first_char = self._prefix[0]\n            return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n        def _is_extension_valid(self):\n            \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n            return self._extension in self._allowed_extensions\n\n        def is_valid(self) -> bool:\n            \"\"\"Orchestrates all validation checks and returns a boolean result.\"\"\"\n            if not self._is_digit_count_valid():\n                return False\n            if not self._is_dot_count_valid():\n                return False\n\n            # If dot count is valid, proceed with prefix/extension checks\n            if not self._is_prefix_not_empty():\n                return False\n            if not self._is_prefix_starts_with_letter():\n                return False\n            if not self._is_extension_valid():\n                return False\n\n            return True\n\n    file_obj = FileName(file_name)\n    if file_obj.is_valid():\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value * value\n        elif index % 4 == 0:  # Implies index % 3 != 0 due to the `elif`\n            total_sum += value * value * value\n        else:\n            total_sum += value\n    return total_sum", "base_st