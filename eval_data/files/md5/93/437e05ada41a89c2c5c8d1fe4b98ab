ubstring: str) -> int:\n    \"\"\"Counts the occurrences of a substring within a string, including overlapping cases.\"\"\"\n    if not substring:\n        return 0\n\n    count = 0\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i + len(substring)] == substring:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/16": [{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    normalized_string = string.lower()\n    distinct_chars = set()\n    for char in normalized_string:\n        distinct_chars.add(char)\n    return len(distinct_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    class InvalidBinaryStringError(Exception):\n        \"\"\"Custom exception for when a string contains characters other than '0' or '1'.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class MismatchedLengthError(Exception):\n        \"\"\"Custom exception for when two strings have different lengths.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class String:\n        \"\"\"Encapsulates a binary string, provides validation and XOR operations.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._length = len(value)\n            self.validate_content()\n\n        @property\n        def value(self) -> str:\n            return self._value\n\n        @property\n        def length(self) -> int:\n            return self._length\n\n        def validate_content(self) -> None:\n            \"\"\"Validates that the string contains only '0' or '1' characters.\"\"\"\n            for char in self._value:\n                if char not in ('0', '1'):\n                    raise InvalidBinaryStringError(f\"Invalid character in string: {char}\")\n\n        def validate_length(self, other: 'String') -> None:\n            \"\"\"Validates that this string has the same length as another String object.\"\"\"\n            if self._length != other._length:\n                raise MismatchedLengthError(\"Input strings must have the same length.\")\n\n        def perform_xor(self, other: 'String') -> 'String':\n            \"\"\"Performs character-by-character binary XOR with another String object.\"\"\"\n            result_chars = []\n            for i in range(self._length):\n                xor_result = '1' if self._value[i] != other._value[i] else '0'\n                result_chars.append(xor_result)\n            return String(\"\".join(result_chars))\n\n    string_a = String(a)\n    string_b = String(b)\n\n    string_a.validate_content()\n    string_b.validate_content()\n\n    string_a.validate_length(string_b)\n\n    result_string_obj = string_a.perform_xor(string_b)\n    return result_string_obj.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/14": [{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string. \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/19": [{"task_id": "HumanEval/19", "solution": "from typing import List\n_WORD_TO_VALUE_MAP = {\n    'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n    'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n}\n_VALUE_TO_WORD_MAP = {\n    0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n    5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n}\nclass NumberWord:\n    \"\"\"Encapsulates a number word and its corresponding integer value.\"\"\"\n    def __init__(self, word: str, value: int):\n        self._word = word\n        self._value = value\n\n    def get_word(self) -> str:\n        \"\"\"Returns the number word.\"\"\"\n        return self._word\n\n    def get_value(self) -> int:\n        \"\"\"Returns the numerical value.\"\"\"\n        return self._value\nclass NumberWordString:\n    \"\"\"Manages parsing, sorting, and converting number words within a string.\"\"\"\n    def __init__(self, input_string: str):\n        self._raw_input = input_string\n        self._parsed_words: List[NumberWord] = []\n\n    def parse(self) -> None:\n        \"\"\"Splits the raw input by space, converts words to NumberWord objects, and populates _parsed_words.\"\"\"\n        words_str = self._raw_input.split(' ')\n        for word in words_str:\n            if word in _WORD_TO_VALUE_MAP:\n                value = _WORD_TO_VALUE_MAP[word]\n                self._parsed_words.append(NumberWord(word, value))\n\n    def sort(self) -> None:\n        \"\"\"Sorts the internal list of NumberWord objects in ascending order by their numerical value.\"\"\"\n        self._parsed_words.sort(key=lambda nw: nw.get_value())\n\n    def to_sorted_string(self) -> str:\n        \"\"\"Converts the internally sorted NumberWord objects back into a space-delimited string using _VALUE_TO_WORD_MAP.\"\"\"\n        output_words = []\n        for nw in self._parsed_words:\n            value = nw.get_value()\n            output_words.append(_VALUE_TO_WORD_MAP[value])\n        return ' '.join(output_words)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    nws = NumberWordString(numbers)\n    nws.parse()\n    nws.sort()\n    return nws.to_sorted_string()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/23": [{"task_id": "HumanEval/23", "solution": "def strlen(string: str) -> int:\n    \"\"\" Return length of given string\n    >>> strlen('')\n    0\n    >>> strlen('abc')\n    3\n    \"\"\"\n    return len(string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/22": [{"task_id": "HumanEval/22", "solution": "from typing import List, Any\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers \"\"\"\n    result = []\n    for item in values:\n        if isinstance(item, int):\n            result.append(item)\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[true, false, null, 0, -10, "test", [], {}, 3.14]]]}], "HumanEval/21": [{"task_id": "HumanEval/21", "solution": "from typing import List\nclass Number:\n    def __init__(self, value: float):\n        self.value = value\nclass ListOfNumbers:\n    def __init__(self, numbers: List[float]):\n        if len(numbers) < 2:\n            raise ValueError(\"Input list must contain at least two elements.\")\n        self.elements = [Number(n) for n in numbers]\n\n    def getMin(self) -> float:\n        return min(n.value for n in self.elements)\n\n    def getMax