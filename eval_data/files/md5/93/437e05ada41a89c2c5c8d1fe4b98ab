if len(game) != len(guess):\n        raise ValueError(\"Input lists 'game' and 'guess' must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def _count_letters(s: str) -> tuple[int, int]:\n    \"\"\"Counts the number of uppercase and lowercase letters in a given string.\"\"\"\n    uppercase_count = sum(1 for char in s if char.isupper())\n    lowercase_count = sum(1 for char in s if char.islower())\n    return uppercase_count, lowercase_count\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension: uppercase count minus lowercase count.\"\"\"\n    cap, sm = _count_letters(extension_name)\n    return cap - sm\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Finds the strongest extension based on the formula CAP - SM (uppercase minus lowercase letters).\n    Returns 'ClassName.StrongestExtensionName', choosing the first if strengths are equal.\n    \"\"\"\n    if not extensions:\n        return class_name + '.NoExtension'\n\n    strongest_name = ''\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_name = ext_name\n\n    return f'{class_name}.{strongest_name}'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 with both first and last digits being odd.\"\"\"\n\n    def _is_greater_than_10(num):\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _get_first_digit(num):\n        \"\"\"Extracts the first digit of a number, ignoring its sign.\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num):\n        \"\"\"Extracts the last digit of a number, ignoring its sign.\"\"\"\n        return abs(num) % 10\n\n    def _is_odd(digit):\n        \"\"\"Checks if a given digit is odd (1, 3, 5, 7, 9).\"\"\"\n        return digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num):\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    abs_num = abs(num)\n\n    if abs_num == 0:\n        return (1, 0)\n\n    num_str = str(abs_num)\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    # Roman numeral mapping for conversion, ordered from largest to smallest.\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return \"\".join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def _get_rotations(s):\n    \"\"\"Generates all unique cyclic rotations of a given string.\"\"\"\n    if not s:\n        return [\"\"]\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return list(rotations)\ndef _is_substring(main_str, sub_str):\n    \"\"\"Checks if sub_str is a substring of main_str.\"\"\"\n    return sub_str in main_str\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if _is_substring(a, b):\n        return True\n\n    rotations_of_b = _get_rotations(b)\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    import math\n\n    # Note: Using a small epsilon for floating-point comparisons to account for precision issues.\n    EPSILON = 1e-9\n\n    # Ensure sides are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Sort sides to easily identify the longest side (hypotenuse).\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Apply Pythagorean theorem: s1^2 + s2^2 = s3^2.\n    # Use math.isclose for floating-point comparison.\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=EPSILON)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "import collections\nclass Word:\n    \"\"\"Represents a word with its value and unique character count, supporting comparison logic.\"\"\"\n\n    def __init__(self, value: str):\n        self._value = value\n        self._unique_char_count = self._calculate_unique_characters()\n\n    def _calculate_unique_characters(self) -> int:\n        \"\"\"Calculates the number of unique characters in the word.\"\"\"\n        return len(collections.Counter(self._value))\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the word.\"\"\"\n        return self._value\n\n    def get_unique_character_count(self) -> int:\n        \"\"\"Returns the cached number of unique characters.\"\"\"\n        return self._unique_char_count\n\n    def __lt__(self, other: 'Word') -> bool:\n        \"\"\"Defines 'less than' comparison, prioritizing unique character count (descending) then lexicographical order (ascending).\"\"\"\n        # Primary sort: higher unique character count comes first (descending)\n        if self._unique_char_count != other._unique_char_count:\n            return self._unique_char_count > other._unique_char_count\n\n        # Secondary sort: lexicographical order (ascending) for ties\n        return self._value < other._value\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Defines equality comparison based on the word's value.\"\"\"\n        return self._value == other._value\n\n    def __repr__(self) -> str:\n        return f\"Word(value='{self._value}', unique_chars={self._unique_char_count})\"\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_word_obj = None\n\n    for word_str in words:\n        current_word_obj = Word(word_str)\n\n        # The __lt__ method of Word defines \"better\" as having more unique characters\n        # or being lexicographically smaller in case of a tie.\n        if max_word_obj is None or current_word_obj < max_word_obj:\n            max_word_obj = current_word_obj\n\n    return max_word_obj.get_value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n\n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n\n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n\n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n\n    class CarrotStock:\n        \"\"\"Manages the quantity of carrots available in stock.\"\"\"\n        def __init__(self, remaining_carrots: int):\n            self._remaining_carrots = remaining_carrots\n\n        def get_remaining_carrots(self) -> int:\n            return self._remaining_carrots\n\n        def deduct_carrots(self, amount: int) -> None:\n            self._remaining_carrots -= amount\n\n    class RabbitMeal:\n        \"\"\"Holds the context of the rabbit's current meal.\"\"\"\n        def __init__(self, eaten_carrots_before_meal: int, needed_carrots_for_meal: int):\n            self._eaten_carrots_before_meal = eaten_carrots_before_meal\n            self._needed_carrots_for_meal = needed_carrots_for_meal\n\n        def get_eaten_carrots_before_meal(self) -> int:\n            return self._eaten_carrots_before_meal\n\n        def get_needed_carrots_for_meal(self) -> int:\n            return self._needed_carrots_for_meal\n\n    class ConsumptionResult:\n        \"\"\"Stores the final outcome of the carrot consumption calculation.\"\"\"\n        def __init__(self, total_eaten_carrots: int, carrots_left_in_stock: int):\n            self._total_eaten_carrots = total_eaten_carrots\n            self._carrots_left_in_stock = carrots_left_in_stock\n\n        def get_total_eaten_carrots(self) -> int:\n            return self._total_eaten_carrots\n\n        def get_carrots_left_in_stock(self) -> int:\n            return self._carrots_left_in_stock\n\n        def to_array(self) -> list[int]:\n            return [self._total_eaten_carrots, self._carrots_left_in_stock]\n\n    class CarrotConsumptionService:\n        \"\"\"Orchestrates the calculation of carrot consumption based on meal and stock.\"\"\"\n        def calculate_consumption(self, meal: RabbitMeal, stock: CarrotStock) -> ConsumptionResult:\n            needed_carrots = meal.get_needed_carrots_for_for_meal()\n            remaining_carrots_in_stock = stock.get_remaining_carrots()\n\n            carrots_eaten_from_stock = min(needed_carrots, remaining_carrots_in_stock)\n            stock.deduct_carrots(carrots_eaten_from_stock)\n\n            total_eaten_carrots = meal.get_eaten_carrots_before_meal() + carrots_eaten_from_stock\n            carrots_left_after_meal = stock.get_remaining_carrots()\n\n            return ConsumptionResult(total_eaten_carrots, carrots_left_after_meal)\n\n    rabbit_meal = RabbitMeal(number, need)\n    carrot_stock = CarrotStock(remaining)\n\n    service = CarrotConsumptionService()\n    consumption_result = service.calculate_consumption(rabbit_meal, carrot_stock)\n\n    return consumption_result.to_array()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[5, 6, 10]], "plus_fail_tests": [[0, 0, 0]]}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    class ExpressionProcessor:\n        \"\"\"\n        Handles the validation, construction, and evaluation of algebraic expressions.\n        \"\"\"\n        _SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n        def _validate_inputs(self, operators, operands):\n            \"\"\"\n            Enforces all business rules and raises ValueError on invalid input.\n            \"\"\"\n            if not operators:\n                raise ValueError(\"Operator list must have at least one operator.\")\n            if len(operands) < 2:\n                raise ValueError(\"Operand list must have at least two operands.\")\n            if len(operators) != len(operands) - 1:\n                raise ValueError(\"Length of operator list must be equal to length of operand list minus one.\")\n            for op in operators:\n                if op not in self._SUPPORTED_OPERATORS:\n                    raise ValueError(f\"Unsupported operator: {op}\")\n            for num in operands:\n                if not isinstance(num, int) or num < 0:\n                    raise ValueError(\"Operand list must contain only non-negative integers.\")\n\n        def _build_expression_string(self, operators, operands):\n            \"\"\"\n            Constructs the algebraic expression string by interleaving operands and operators.\n            \"\"\"\n            expression_parts = []\n            expression_parts.append(str(operands[0]))\n            for i in range(len(operators)):\n                expression_parts.append(operators[i])\n                expression_parts.append(str(operands[i+1]))\n            return \" \".join(expression_parts)\n\n        def _evaluate_expression_string(self, expression_string):\n            \"\"\"\n            Evaluates the given expression string using standard Python evaluation.\n            \"\"\"\n            return eval(expression_string)\n\n        def process(self, operators, operands):\n            \"\"\"\n            Main method to validate inputs, build the expression string, and evaluate it.\n            \"\"\"\n            self._validate_inputs(operators, operands)\n            expression_string = self._build_expression_string(operators, operands)\n            result = self._evaluate_expression_string(expression_string)\n            return result\n\n    processor = ExpressionProcessor()\n    return processor.process(operator, operand)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Transforms a string by reversing letter case or reversing the entire string if no letters are present.\n    \"\"\"\n\n    def _is_alphabetic(char: str) -> bool:\n        \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _is_uppercase(char: str) -> bool:\n        \"\"\"Checks if a character is an uppercase letter.\"\"\"\n        return char.isupper()\n\n    def _is_lowercase(char: str) -> bool:\n        \"\"\"Checks if a character is a lowercase letter.\"\"\"\n        return char.islower()\n\n    def _to_opposite_case(char: str) -> str:\n        \"\"\"Converts an alphabetic character to its opposite case.\"\"\"\n        if _is_uppercase(char):\n            return char.lower()\n        elif _is_lowercase(char):\n            return char.upper()\n        return char # Should only be called on alphabetic characters\n\n    def _has_alphabetic_characters(s: str) -> bool:\n        \"\"\"Determines if the input string contains any alphabetic characters.\"\"\"\n        for char in s:\n            if _is_alphabetic(char):\n                return True\n        return False\n\n    def _reverse_entire_string(s: str) -> str:\n        \"\"\"Reverses the order of all characters in the string.\"\"\"\n        return s[::-1]\n\n    def _reverse_case_of_letters(s: str) -> str:\n        \"\"\"Reverses the case of alphabetic characters, retaining others.\"\"\"\n        transformed_chars = []\n        for char in s:\n            if _is_alphabetic(char):\n                transformed_chars.append(_to_opposite_case(char))\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n\n    if _has_alphabetic_characters(s):\n        return _reverse_case_of_letters(s)\n    else:\n        return _reverse_entire_string(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result_list = []\n\n    for i in range(min_val, max_val + 1):\n        is_single_digit = 0 <= i <= 9\n        is_even = i % 2 == 0\n\n        if is_single_digit and is_even:\n            result_list.append(i)\n\n    result_list.sort()\n\n    return result_list", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[987654321, 123456789]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    # Generate the array 'a' using 0-based indexing for Python lists.\n    # The problem's a[i] (1-based index) corresponds to a_list[i-1].\n    a_list = [0] * n\n    for i_conceptual in range(1, n + 1):\n        a_list[i_conceptual - 1] = i_conceptual * i_conceptual - i_conceptual + 1\n\n    count = 0\n    # Iterate through all unique combinations of three distinct indices i, j, k.\n    # These indices are 0-based for list access, corresponding to 1-based i_conceptual < j_conceptual < k_conceptual.\n    for i_idx in range(n):\n        for j_idx in range(i_idx + 1, n):\n            for k_idx in range(j_idx + 1, n):\n                current_sum = a_list[i_idx] + a_list[j_idx] + a_list[k_idx]\n\n                if current_sum % 3 == 0:\n                    count += 1\n\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    numbers = list(range(n + 1))\n    result_string = ' '.join(map(str, numbers))\n    return result_string", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of a Tribonacci-like sequence.\n    The sequence is defined with special rules for even and odd indices.\n    \"\"\"\n    trib_sequence = []\n\n    if n == 0:\n        return [1]\n\n    # Initialize with tri(0) and tri(1)\n    trib_sequence.append(1)  # tri(0)\n    trib_sequence.append(3)  # tri(1)\n\n    # Iterate to compute remaining terms up to n\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # i is even\n            current_tri = 1 + i // 2\n        else:  # i is odd\n            # tri(i) = tri(i - 1) + tri(i - 2) + tri(i + 1)\n            # where tri(i + 1) for odd i means 1 + (i + 1) / 2\n            current_tri = trib_sequence[i - 1] + trib_sequence[i - 2] + (1 + (i + 1) // 2)\n        trib_sequence.append(current_tri)\n\n    return trib_sequence", "base_status": "