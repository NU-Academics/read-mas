ce]:\n        if not self._text:\n            return []\n\n        delimiter_pattern = '|'.join(re.escape(d) for d in delimiters)\n        raw_segments = re.split(f'[{delimiter_pattern}]', self._text)\n\n        sentences: list[Sentence] = []\n        for segment in raw_segments:\n            trimmed_segment = segment.strip()\n            if trimmed_segment:\n                sentences.append(Sentence(trimmed_segment))\n        return sentences\nclass BoredomCounter:\n    \"\"\"Aggregates and provides the total count of 'boredom' sentences.\n    Increments the count and returns the current total.\n    \"\"\"\n    def __init__(self):\n        self._count: int = 0\n\n    def increment(self) -> None:\n        self._count += 1\n\n    def get_count(self) -> int:\n        return self._count\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    delimiters = ['.', '?', '!']\n\n    input_string_obj = InputString(S)\n    sentences = input_string_obj.get_sentences(delimiters)\n    boredom_counter = BoredomCounter()\n\n    for sentence in sentences:\n        if sentence.starts_with_i():\n            boredom_counter.increment()\n\n    return boredom_counter.get_count()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n\n    def _is_empty(arr):\n        \"\"\"Determines if the given array is empty.\"\"\"\n        return len(arr) == 0\n\n    def _has_single_element(arr):\n        \"\"\"Determines if the given array contains exactly one element.\"\"\"\n        return len(arr) == 1\n\n    def _calculate_sum_of_first_and_last(arr):\n        \"\"\"Computes the sum of the first and last elements of an array.\"\"\"\n        return arr[0] + arr[-1]\n\n    def _sort_ascending(arr_to_sort):\n        \"\"\"Returns a new array sorted in ascending order.\"\"\"\n        return sorted(arr_to_sort)\n\n    def _sort_descending(arr_to_sort):\n        \"\"\"Returns a new array sorted in descending order.\"\"\"\n        return sorted(arr_to_sort, reverse=True)\n\n    if _is_empty(array):\n        return []\n    elif _has_single_element(array):\n        return array.copy()\n    else:\n        sum_first_last = _calculate_sum_of_first_and_last(array)\n\n        if sum_first_last % 2 != 0:  # Odd sum\n            return _sort_ascending(array.copy())\n        else:  # Even sum\n            return _sort_descending(array.copy())", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    first_key_case = None\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if first_key_case is None:\n            if key.islower():\n                first_key_case = 'lower'\n            elif key.isupper():\n                first_key_case = 'upper'\n            else:\n                return False # First key is