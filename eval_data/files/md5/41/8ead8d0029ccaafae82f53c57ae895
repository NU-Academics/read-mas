{"task_id": "Mbpp/56", "solution": "def check(number):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Uses a helper function _reverse_number to get the reverse.\n    \"\"\"\n    def _reverse_number(n):\n        \"\"\"Reverses an integer number.\"\"\"\n        reversed_num = 0\n        while n > 0:\n            digit = n % 10\n            reversed_num = reversed_num * 10 + digit\n            n //= 10\n        return reversed_num\n\n    reversed_number = _reverse_number(number)\n    return number == (2 * reversed_number) - 1"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list[int]) -> str:\n    \"\"\"\n    Finds the largest number that can be formed from a given list of digits.\n    The digits are arranged in descending order and joined to form a string.\n    \"\"\"\n    str_digits = [str(d) for d in digits]\n    str_digits.sort(reverse=True)\n    return \"\".join(str_digits)"}
{"task_id": "Mbpp/61", "solution": "def _calculate_sum_of_digits(s: str) -> int:\n    \"\"\"\n    Calculates the sum of the numerical values of digits in a given string.\n    Assumes the input string contains only digit characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        total_sum += int(char)\n    return total_sum\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in the input string where the sum of their digits\n    is equal to their length.\n    \"\"\"\n    count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            sub_str = input_string[i:j]\n            sub_len = len(sub_str)\n            sub_sum_digits = _calculate_sum_of_digits(sub_str)\n\n            if sub_len == sub_sum_digits:\n                count += 1\n    return count"}
