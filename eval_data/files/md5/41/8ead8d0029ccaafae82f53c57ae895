{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True for non-prime numbers, False for prime numbers or numbers less than or equal to 1.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n    \n    # Check for odd divisors from 3 up to the square root of the number\n    limit = int(number**0.5) + 1\n    for i in range(3, limit, 2):\n        if number % i == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/7", "solution": "import string\n\ndef find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all unique words at least 4 characters long in a string.\n    Punctuation is stripped from words before checking length.\n    \"\"\"\n    long_words = set()\n    words = input_string.split()\n    for word in words:\n        cleaned_word = word.strip(string.punctuation)\n        if len(cleaned_word) >= 4:\n            long_words.add(cleaned_word)\n    return long_words"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if the binary representations of two integers differ at exactly one bit position.\n    \"\"\"\n    xor_result = num1 ^ num2\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n    return count == 1"}
{"task_id": "Mbpp/2", "solution": "from typing import Collection, Set, Any\n\ndef similar_elements(collection1: Collection[Any], collection2: Collection[Any]) -> Set[Any]:\n    \"\"\"\n    Identifies and returns elements common to both input collections.\n\n    Args:\n        collection1: The first input collection (list or tuple).\n        collection2: The second input collection (list or tuple).\n\n    Returns:\n        A set containing elements present in both collection1 and collection2.\n    \"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    It iterates through possible rotation counts and checks if the rotated string matches the original.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    # Start k from 1 as per the requirement \"greater than 0\"\n    for k in range(1, n + 1):\n        rotated_string = input_string[k:] + input_string[:k]\n        if rotated_string == input_string:\n            return k\n    return n # Fallback, should not be reached for non-empty strings as rotating n times always returns the original"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list) -> list:\n    \"\"\"\n    Calculates the square of each element in an input list and returns a new list with the results.\n    \"\"\"\n    squared_numbers = []\n    for number in numbers:\n        squared_numbers.append(number * number)\n    return squared_numbers"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"Finds the 'n' largest integers from a list using a min-heap and returns them in descending order.\n    Handles edge cases for n <= 0 or an empty input list by returning an empty list.\"\"\"\n    if n <= 0 or not numbers:\n        return []\n\n    # Use nlargest from heapq to efficiently find the n largest elements\n    # It returns elements in descending order by default\n    largest_elements = heapq.nlargest(n, numbers)\n    return largest_elements"}
{"task_id": "Mbpp/11", "solution": "```python\ndef remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the input string.\n    Handles cases where the character appears once, multiple times, or not at all.\n    \"\"\"\n    first_index = input_string.find(char_to_remove)\n    if first_index == -1:\n        return input_string\n\n    last_index = input_string.rfind(char_to_remove)\n\n    if first_index == last_index:\n        # Character found exactly once\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Character found at least twice\n        # Remove last occurrence first to avoid index shifting issues for the first_index\n        temp_string = input_string[:last_index] + input_string[last_index + 1:]\n        # Then remove the first occurrence from the temp_string\n        return temp_string[:first_index] + temp_string[first_index + 1:]\n\n```"}
