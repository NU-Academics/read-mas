{"task_id": "Mbpp/71", "solution": "def comb_sort(elements: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    Returns a new sorted list.\n    \"\"\"\n    n = len(elements)\n    if n <= 1:\n        return list(elements)\n\n    arr = list(elements)  # Create a mutable copy of the input list\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as the difference of two perfect squares (a^2 - b^2).\n    A number N can be expressed as the difference of two perfect squares if and only if N is odd or N is a multiple of 4.\n    \"\"\"\n    if number % 2 != 0:\n        return True\n    elif number % 4 == 0:\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(words: list, patterns: list) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same pattern based on a one-to-one mapping.\n    Ensures a consistent bi-directional mapping between elements.\n    \"\"\"\n    if len(words) != len(patterns):\n        return False\n\n    word_to_pattern_map = {}\n    pattern_to_word_map = {}\n\n    for word, pattern in zip(words, patterns):\n        # Check word-to-pattern consistency\n        if word in word_to_pattern_map:\n            if word_to_pattern_map[word] != pattern:\n                return False\n        else:\n            # Check pattern-to-word consistency for new word\n            if pattern in pattern_to_word_map:\n                if pattern_to_word_map[pattern] != word:\n                    return False\n            \n            # Establish new mapping\n            word_to_pattern_map[word] = pattern\n            pattern_to_word_map[pattern] = word\n\n    return True"}
