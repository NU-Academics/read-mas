 int) -> bool:\n        \"\"\"Determines primality using an optimized trial division algorithm.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3: # 2 and 3 are prime\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass PrimeService:\n    def __init__(self, cache_repo: PrimeCacheRepository, validator: PrimeUtils, algorithm: PrimeUtils, max_limit: int = 10**18):\n        self.cache_repo = cache_repo\n        self.validator = validator\n        self.algorithm = algorithm\n        self.max_limit = max_limit\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Validates input, checks cache, computes primality if needed, and stores result.\"\"\"\n        n_validated = self.validator.validate_input(n, self.max_limit)\n\n        cached = self.cache_repo.get(n_validated)\n        if cached is not None:\n            return cached\n\n        result = self.algorithm.is_prime_algorithm(n_validated)\n\n        try:\n            self.cache_repo.set(n_validated, result)\n        except Exception:\n            # As per design context, cache failures are non-fatal and can be logged.\n            pass\n\n        return result\nclass PrimeController:\n    def __init__(self, service: PrimeService):\n        self.service = service\n\n    def check(self, n: int) -> bool:\n        \"\"\"Orchestrates a primality check through the service and returns a boolean result.\"\"\"\n        return self.service.is_prime(n)\n_default_cache_repo = PrimeCacheRepository()\n_default_utils_instance = PrimeUtils\n_default_service = PrimeService(_default_cache_repo, _default_utils_instance, _default_utils_instance)\n_default_controller = PrimeController(_default_service)\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number using an optimized algorithm with caching.\n    The check is delegated to a pre-configured service layer.\n    \"\"\"\n    return _default_controller.check(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/607": [{"task_id": "Mbpp/607", "solution": "import re\nfrom functools import lru_cache\nfrom dataclasses import dataclass\nfrom typing import Optional, Any\nclass InvalidPatternError(Exception):\n    \"\"\"Raised when a regex pattern is invalid.\"\"\"\n    def __init__(self, pattern: str, underlying: Exception) -> None:\n        super().__init__(f\"Invalid regex pattern '{pattern}': {underlying}\")\n        self.pattern = pattern\n        self.underlying = underlying\nclass RegexUtils:\n    \"\"\"Utility class for compiling and caching regex patterns, and input validation.\"\"\"\n    _CACHE_MAXSIZE = 256\n\n    @staticmethod\n    @lru_cache(maxsize=_CACHE_MAXSIZE)\n    def _compile_lru_cache(key: tuple[str, int]) -> re.Pattern:\n        \"\"\"Internal static method to compile and cache patterns.\"\"\"\n        pattern, flags = key\n        try:\n            return re.compile(pattern, flags)\n        except re.error as e:\n            raise InvalidPatternError(pattern, e)\n\n    def compile_cached(self, pattern: str, flags: int = 0) -> re.Pattern:\n        \"\"\"Returns a compiled regex pattern, using an LRU cache.\"\"\"\n        return self._compile_lru_cache((pattern, int(flags)))\n\n    @staticmethod\n    def validate_text(text: Any) -> str:\n        \"\"\"Validates if the input text is a string.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"text must be a str\")\n        return text\n\n    @staticmethod\n    def validate_start(start: Any) -> int:\n        \"\"\"Validates if the start index is a non-negative integer.\"\"\"\n        if not isinstance(start, int):\n            raise TypeError(\"start must be an int\")\n        if start < 0:\n            raise ValueError(\"start must be >= 0\")\n        return start\nclass RegexFinder:\n    \"\"\"Core logic for finding a regex pattern in text.\"\"\"\n    def __init__(self, regex_utils: RegexUtils) -> None:\n        self._regex_utils = regex_utils\n\n    def find(self, pattern: str, text: str, flags: int = 0, start: int = 0) -> Optional[PatternResult]:\n        \"\"\"Searches for a regex pattern in text and returns the first match.\"\"\"\n        text = self._regex_utils.validate_text(text)\n        start = self._regex_utils.validate_start(start)\n\n        if start >= len(text):\n            return None\n\n        compiled = self._regex_utils.compile_cached(pattern, flags)\n        m = compiled.search(text, pos=start)\n\n        if m is None:\n            return None\n        return PatternResult(m.group(0), m.start(), m.end())\ndef find_literals(text: str, pattern: str) -> Optional[tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the first match as a tuple.\n    Returns (match_text, start_index, end_index) or None if no match.\n    \"\"\"\n    regex_utils = RegexUtils()\n    finder = RegexFinder(regex_utils)\n\n    # Use default flags=0 and start=0 as they are not part of this specific function signature\n    result = finder.find(pattern, text, flags=0, start=0)\n\n    if result is not None:\n        return result.as_tuple()\n    else:\n        return None", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/611": [{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Finds the maximum value in the n-th column of a given matrix.\n\n    Args:\n        matrix (list of list): 2D list representing the matrix (rows x cols).\n        n (int): zero-based column index.\n\n    Returns:\n        The maximum value found in column n.\n\n    Raises:\n        IndexError: if matrix is empty or n is out of range for the rows.\n        TypeError: if matrix rows are not indexable or elements not comparable.\n  