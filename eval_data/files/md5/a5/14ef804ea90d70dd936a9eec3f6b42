end(x)\n            else:\n                odds.append(x)\n        return evens, odds\n\n    list_a = _ensure_list(a)\n    list_b = _ensure_list(b)\n\n    try:\n        set_b = set(list_b)\n        remaining = [x for x in list_a if x not in set_b]\n    except TypeError:\n        # Fallback for unhashable items in b: use list containment\n        remaining = [x for x in list_a if x not in list_b]\n\n    if ordering == 'stable':\n        return remaining\n    elif ordering == 'even_first':\n        evens, odds = _partition_even_odd(remaining)\n        return evens + odds\n    else:\n        # Fallback to 'stable' if ordering is not recognized.\n        return remaining", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3, 4, 5], [6, 7, 1]]], "plus_fail_tests": [[[], [1, 2, 3]]]}], "Mbpp/766": [{"task_id": "Mbpp/766", "solution": "def pair_wise(lst):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles empty or single-item lists by returning an empty list.\n    \"\"\"\n    it = iter(lst)\n    try:\n        prev = next(it)\n    except StopIteration:\n        return []\n\n    pairs = []\n    for cur in it:\n        pairs.append((prev, cur))\n        prev = cur\n    return pairs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/767": [{"task_id": "Mbpp/767", "solution": "from collections import defaultdict\ndef get_pairs_count(numbers: list, target: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs in a list whose elements sum to a given target.\n    Elements at distinct indices are treated as distinct, even if their values are equal.\n    \"\"\"\n    freq_map = defaultdict(int)\n    count = 0\n    for num in numbers:\n        complement = target - num\n        if complement in freq_map:\n            count += freq_map[complement]\n        freq_map[num] += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_te