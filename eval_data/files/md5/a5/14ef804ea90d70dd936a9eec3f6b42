797": [{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are defined as integers >= 1.\n    \"\"\"\n\n    # Coerce inputs to integers if they are floats with integer value or strings representing integers\n    def _coerce_to_int(value):\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float) and value.is_integer():\n            return int(value)\n        if isinstance(value, str) and value.strip().lstrip(\"+-\").isdigit():\n            return int(value)\n        raise ValueError(f\"Cannot coerce value {value!r} to int\")\n\n    li = _coerce_to_int(l)\n    ri = _coerce_to_int(r)\n\n    # Normalize the lower bound to be at least 1, as natural numbers start from 1.\n    start_effective = max(li, 1)\n    end_effective = ri\n\n    # If the interval is empty\n    if start_effective > end_effective:\n        return 0\n\n    # Helper function to check if a number is odd.\n    def _is_odd(n: int) -> bool:\n        return n % 2 != 0\n\n    # Helper function to find the first odd number at or after n.\n    def _first_odd_at_or_after(n: int) -> int:\n        return n if _is_odd(n) else n + 1\n\n    # Helper function to find the last odd number at or before n.\n    def _last_odd_at_or_before(n: int) -> int:\n        return n if _is_odd(n) else n - 1\n\n    first_odd = _first_odd_at_or_after(start_effective)\n    last_odd = _last_odd_at_or_before(end_effective)\n\n    # If the range of odd numbers is empty, return 0.\n    if first_odd > last_odd:\n        return 0\n\n    # Calculate the number of odd terms in the arithmetic progression.\n    num_terms = ((last_odd - first_odd) // 2) + 1\n\n    # Calculate the sum using the arithmetic progression formula: n * (first + last) / 2.\n    total_sum = num_terms * (first_odd + last_odd) // 2\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/799": [{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    The number is treated as an unsigned 32-bit integer.\n    \"\"\"\n    BITS = 32\n    MASK = (1 << BITS) - 1\n\n    # Normalize value to be within 32 bits\n    v = value & MASK\n\n    # Normalize shift amount d to be within 0 to BITS-1\n    shift = d % BITS\n\n    if shift == 0:\n        return v\n\n    # Perform left rotation\n    # Left part: bits shifted left\n    # Right part: bits that wrapped around from the left\n    result = ((v << shift) | (v >> (BITS - shift))) & MASK\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/778": [{"task_id": "Mbpp/778", "solution": "from typing import Any, List\ndef pack_consecutive_duplicates(data: List[Any]) -> List[List[Any]]:\n    \"\"\"Packs consecutive duplicates of list elements into sublists.\n    Groups identical adjacent items from the input list into sublists.\n    \"\"\"\n    if not data:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_group: List[Any] = []\n\n    for item in data:\n        if not current_group or item == current_group[-1]:\n            current_group.append(item)\n        else:\n            packed_list.append(current_group)\n            current_group = [item]\n\n    # Append the last accumulated group after the loop finishes\n    if current_group:\n        packed_list.append(current_group)\n\n    return packed_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/800": [{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(s: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from a string.\n    Whitespace is defined by `str.isspace()`.\n    \"\"\"\n    return \"\".join(ch for ch in s if not ch.isspace())", "base_statu