 # msis[i] stores the maximum sum of an increasing subsequence ending at arr[i]\n    msis = [0] * n\n    for i in range(n):\n        msis[i] = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                msis[i] = max(msis[i], msis[j] + arr[i])\n\n    # msds[i] stores the maximum sum of a decreasing subsequence starting at arr[i]\n    msds = [0] * n\n    for i in range(n - 1, -1, -1):\n        msds[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                msds[i] = max(msds[i], msds[j] + arr[i])\n\n    max_bitonic_sum = 0\n    # A bitonic subsequence is formed by an increasing subsequence ending at arr[i]\n    # and a decreasing subsequence starting at arr[i].\n    # Since arr[i] is counted in both MSIS and MSDS, subtract it once.\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, msis[i] + msds[i] - arr[i])\n\n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "from typing import Any, Tuple\nclass CountRequest:\n    \"\"\"Data transfer object for a count request.\"\"\"\n    t: Tuple[Any, ...]\n    element: Any\n\n    def __init__(self, t: Tuple[Any, ...], element: Any):\n        self.t = t\n        self.element = element\nclass CountResponse:\n    \"\"\"Data transfer object for a count response.\"\"\"\n    count: int\n\n    def __init__(self, count: int):\n        self.count = count\nclass TupleCounter:\n    \"\"\"Service class for counting elements within a tuple.\"\"\"\n    def count_element(self, t: Tuple[Any, ...], element: Any) -> int:\n        \"\"\"Counts the occurrences of an element in a tuple.\"\"\"\n        count = 0\n        for item in t:\n            if item == element:\n                count += 1\n        return count\nclass CountController:\n    \"\"\"Controller class to handle counting requests and coordinate services.\"\"\"\n    def __init__(self, counter: TupleCounter):\n        self._counter = counter\n\n    def handle_count(self, req: CountRequest) -> CountResponse:\n        \"\"\"Processes a count request, validates input, and returns the count.\"\"\"\n        validate_tuple_input(req.t)\n        count = self._counter.count_element(req.t, req.element)\n        return CountResponse(count)\n_counter = TupleCounter()\n_controller = CountController(_counter)\ndef count_X(t: tuple, element: Any) -> int:\n    \"\"\"\n    Counts the occurrences of an element in a tuple.\n    Raises ValidationError if the input `t` is not a tuple.\n    \"\"\"\n    req = CountRequest(t, element)\n    resp = _controller.handle_count(req)\n    return resp.count", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[10, 8, 5, 2, 10, 15, 10, 8, 5, 8, 8, 2], 4]], "plus_fail_tests": [[[5, 10, 15, 20, 25, 30], 15]]}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(lst: list) -> int:\n    \"\"\"\n    Counts the number of integer elements in the given list, excluding booleans.\n    Only elements whose type is exactly `int` are counted.\n    \"\"\"\n    count = 0\n    for item in lst:\n        if type(item) is int:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "import collections\nimport re\nimport os\nimport json\nimport threading\nfrom typing import Optional, Dict, Any\nclass Config:\n    \"\"\"Holds configuration settings for the LPS application.\"\"\"\n    DEFAULT_CACHE_PATH: str = \"~/.cache/lps_app/cache.json\"\n    NORMALIZE_REMOVE_NON_ALNUM: bool = True\n    NORMALIZE_UPPERCASE: bool = True\n    CACHE_ENABLED: bool = True\n\n    def from_env(self) -> 'Config':\n        \"\"\"Placeholder for environment variable configuration, returns current instance.\"\"\"\n        return self\nclass StringNormalizer:\n    \"\"\"Normalizes input strings according to configuration.\"\"\"\n    def normalize(self, s: str, remove_non_alnum: bool = True, uppercase: bool = True) -> str:\n        \"\"\"Returns a normalized string, optionally removing non-alphanumeric characters and uppercasing.\"\"\"\n        if remove_non_alnum:\n            filtered = ''.join(ch for ch in s if ch.isalnum())\n        else:\n            filtered = s\n        return filtered.upper() if uppercase else filtered\nclass CacheRepository:\n    \"\"\"Manages an in-memory cache for LPS results, simulating persistence.\"\"\"\n    # In-memory dictionary to store cached results for this execution context.\n    _cache: Dict[str, int] = {}\n    _lock = threading.Lock() # Guards access to the in-memory cache.\n\n    def __init__(self, path: str) -> None:\n        \"\"\"Initializes the repository; path is accepted but not used for file operations in this simplified version.\"\"\"\n        self._path = path\n\n    def read(self, key: str) -> Optional[int]:\n        \"\"\"Retrieves a cached value for the given key from the in-memory cache.\"\"\"\n        with self._lock:\n            return self._cache.get(key)\n\n    def write(self, key: str, value: int) -> None:\n        \"\"\"Writes a key-value pair to the in-memory cache.\"\"\"\n        with self._lock:\n            self._cache[key] = value\nclass LPSService:\n    \"\"\"Provides the core logic for computing the Longest Palindromic Subsequence length.\"\"\"\n    def __init__(self, normalizer: StringNormalizer, cache_repo: CacheRepository, config: Config) -> None:\n        \"\"\"Initializes the LPS Service with its dependencies.\"\"\"\n        self._normalizer = normalizer\n        self._cache_repo = cache_repo\n        self._config = config\n\n    def compute_lps(self, s: str) -> int:\n        \"\"\"Computes the length of the longest palindromic subsequence, utilizing caching if enabled.\"\"\"\n        if not s.strip():\n            return 0\n\n        normalized_s = self._normalizer.normalize(\n            s,\n            remove_non_alnum=self._config.NORMALIZE_REMOVE_NON_ALNUM,\n            uppercase=self._config.NORMALIZE_UPPERCASE\n        )\n\n        if not normalized_s:\n            return 0\n\n        if self._config.CACHE_ENABLED:\n            cached_length = self._cache_repo.read(normalized_s)\n            if cached_length is not None:\n                return cached_length\n\n        lps_length = self._compute_lps_dp(normalized_s)\n\n        if self._config.CACHE_ENABLED:\n            self._cache_repo.write(normalized_s, lps_length)\n\n        return lps_length\n\n    def _compute_lps_dp(self, s: str) -> int:\n        \"\"\"Computes the LPS length using dynamic programming.\"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n\n        dp = [[0] * n for _ in range(n)]\n\n        for i in range(n):\n            dp[i][i] = 1\n\n        for L in range(2, n + 1):\n            for i in range(n - L + 1):\n                j = i + L - 1\n                if s[i] == s[j]:\n                    dp[i][j] = 2 + (dp[i + 1][j - 1] if L > 2 else 0)\n                else:\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n        return dp[0][n - 1]\ndef lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    assert lps(\"TENS FOR TENS\") == 5\n    \"\"\"\n    config = Config()\n    normalizer = StringNormalizer()\n    # Cache path is a placeholder; CacheRepository is simplified to use in-memory dict.\n    cache_repo = CacheRepository(config.DEFAULT_CACHE_PATH)\n    service = LPSService(normalizer, cache_repo, config)\n    return service.compute_lps(s)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["TENS FOR TENS"]], "plus_fail_tests": [["xZQOogNh"]]}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "def insert_element(lst, el):\n    \"\"\"\n    Inserts an element before each element in a list and returns the new list.\n    The original list remains unmodified.\n    \"\"\"\n    result = []\n    for item in lst:\n        result.append(el)\n        result.append(item)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/69": [{"task_id": "Mbpp/69", "solution": "def is_sublist(haystack: list, needle: list) -> bool:\n    \"\"\"Checks if a list contains a contiguous sublist.\"\"\"\n\n    from dataclasses import dataclass\n\n    @dataclass\n    class SublistCheckRequest:\n        haystack: list\n        needle: list\n\n    @dataclass\n    class SublistCheckResult:\n        found: bool\n        start_index: int | None\n        end_index: int | None\n\n    class ListUtils:\n        \"\"\"Provides algorithmic utilities for working with lists.\"\"\"\n        @staticmethod\n        def is_contiguous_sublist(haystack: list, needle: list) -> bool:\n            if len(needle) == 0:\n                return True\n            hn = len(haystack)\n            nn = len(needle)\n            if nn > hn:\n                return False\n            for i in range(hn - nn + 1):\n                if haystack[i:i+nn] == needle:\n                    return True\n            return False\n\n        @staticmethod\n        def find_contiguous_sublist_range(haystack: list, needle: list) -> tuple[int, int] | None:\n            \"\"\"Returns (start_index, end_exclusive_index) if needle is found, otherwise None.\"\"\"\n            if len(needle) == 0:\n                return (0, 0)\n            hn = len(haystack)\n            nn = len(needle)\n            if nn > hn:\n                return None\n            for i in range(hn - nn + 1):\n                if haystack[i:i+nn] == needle:\n                    return (i, i+nn)\n            return None\n\n    class InMemoryListRepository:\n        \"\"\"A lightweight in-memory list store.\"\"\"\n        def __init__(self) -> None:\n            self._store: dict[str, list] = {}\n\n        def store(self, name: str, lst: list) -> None:\n            self._store[name] = lst\n\n        def retrieve(self, name: str) -> list | None:\n            return self._store.get(name)\n\n    class SublistService:\n        \"\"\"Orchestrates validation and the sublist algorithm.\"\"\"\n        def __init__(self, repo: InMemoryListRepository | None = None) -> None:\n            self._repo = repo\n\n        def is_sublist(self, request: SublistCheckRequest) -> SublistCheckResult:\n            haystack = request.haystack\n            needle = request.needle\n\n            if not needle: # Business rule: empty needle is found at index 0.\n                return SublistCheckResult(found=True, start_index=0, end_index=0)\n\n            range_found = ListUtils.find_contiguous_sublist_range(haystack, needle)\n\n            if range_found:\n                start, end = range_found\n                return SublistCheckResult(found=True, start_index=start, end_index=end)\n            else:\n                return SublistCheckResult(found=False, start_index=None, end_index=None)\n\n    class SublistFacade:\n        \"\"\"Provides a simple programmatic entrypoint for library consumers.\"\"\"\n        def __init__(self, service: SublistService) -> None:\n            self.service = service\n\n        def is_sublist(self, haystack: list, needle: list) -> bool:\n            req = SublistCheckRequest(haystack=haystack, needle=needle)\n            res = self.service.is_sublist(req)\n            return res.found\n\n    # Instantiate the components\n    repo = InMemoryListRepository()\n    service = SublistService(repo=repo)\n    facade = SublistFacade(service=service)\n\n    # Delegate to the facade\n    return facade.is_sublist(haystack, needle)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers up to a specified limit.\n    An amicable pair (a, b) satisfies sum_proper_divisors(a) = b and sum_proper_divisors(b) = a, where a != b.\n    \"\"\"\n    def _proper_divisor_sum(n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number n.\"\"\"\n        if n == 1:\n            return 0\n        s = 1\n        r = int(n**0.5)\n        for d in range(2, r + 1):\n            if n % d == 0:\n                s += d\n                other = n // d\n                if other != d:\n                    s += other\n        return s\n\n    # Store calculated proper divisor sums to avoid redundant computations.\n    divisor_sums = {}\n    for n in range(1, limit + 1):\n        divisor_sums[n] = _proper_divisor_sum(n)\n\n    amicable_numbers = set()\n\n    # Iterate through numbers to find amicable pairs.\n    for a in range(1, limit + 1):\n        s_a = divisor_sums[a]\n\n        # Check if s_a forms a potential amicable pair with 'a'\n        # 'b' must be greater than 'a' to avoid duplicate pairs and prevent (a,a) as a pair.\n        # 'b' must also be within the limit for its proper divisors sum to be considered.\n        if s_a > a and s_a <= limit:\n            b = s_a\n            s_b = divisor_sums.get(b)\n\n            # If s_b exists and its proper divisor sum equals 'a', then (a,b) is an amicable pair.\n            if s_b is not None and s_b == a:\n                amicable_numbers.add(a)\n                amicable_numbers.add(b)\n\n    return sum(amicable_numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/111": [{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Set, Optional\ndef common_in_nested_lists(lists: List[List[Any]]) -> List[Any]:\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input to the functions.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    class Validator:\n        \"\"\"Utility for validating input structures.\"\"\"\n        MAX_NESTING_DEPTH = 2\n\n        @staticmethod\n        def is_iterable(obj: Any) -> bool:\n            \"\"\"Checks if an object is iterable, excluding strings and bytes.\"\"\"\n            try:\n                iter(obj)\n                return not isinstance(obj, (str, bytes))\n            except TypeError:\n                return False\n\n        @staticmethod\n        def validate_nested_lists(lists_input: Any) -> None:\n            \"\"\"Validates that the input is a non-empty iterable of iterables.\"\"\"\n            if lists_input is None:\n                raise InvalidInputError(\"Input is None\")\n            if not Validator.is_iterable(lists_input):\n                raise InvalidInputError(\"Top-level input must be an iterable of iterables\")\n\n            lists_seq = list(lists_input)\n            if len(lists_seq) == 0:\n                raise InvalidInputError(\"Input must contain at least one sublist\")\n\n            for i, sub in enumerate(lists_seq):\n                if not Validator.is_iterable(sub):\n                    raise InvalidInputError(f\"Sublists must be iterable (index {i})\")\n\n    class ListCollection:\n        \"\"\"Encapsulates and normalizes nested list input.\"\"\"\n        def __init__(self, raw: Any):\n            self._raw = raw\n            self.lists: List[List[Any]] = []\n\n        def normalize(self) -> List[List[Any]]:\n            \"\"\"Validates and converts all sub-iterables to lists.\"\"\"\n            Validator.validate_nested_lists(self._raw)\n            self.lists = [list(sub) for sub in self._raw]\n            return self.lists\n\n    class CommonFinder:\n        \"\"\"Core service to find common elements in nested lists.\"\"\"\n        DEFAULT_SORT = True\n\n        def find_common(self, lists_input: List[List[Any]]) -> List[Any]:\n            \"\"\"\n            Finds common elements across all sublists.\n            It uses a set-based approach for hashable elements and falls back to an equality-based approach otherwise.\n            \"\"\"\n            Validator.validate_nested_lists(lists_input)\n            lc = ListCollection(lists_input)\n            normalized = lc.normalize()\n\n            if not normalized:\n                return []\n\n            result: List[Any] = []\n            try:\n                result_set = self._set_based_intersection(normalized)\n                result = list(result_set)\n            except TypeError:\n                result = self._fallback_intersection(normalized)\n\n            if self.DEFAULT_SORT:\n                try:\n                    result.sort()\n                except Exception:\n                    # Ignore if elements are not comparable for sorting\n                    pass\n            return result\n\n        def _set_based_intersection(self, lists_input: List[List[Any]]) -> Set[Any]:\n            \"\"\"Computes intersection efficiently using sets.\"\"\"\n            # Convert all sublists to sets; this will raise TypeError if elements are unhashable.\n            iter_lists = (set(sub) for sub in lists_input)\n\n            # The input is guaranteed to have at least one sublist by Validator.\n            common = next(iter_lists)\n            for s in iter_lists:\n                common &= s\n            return common\n\n        def _fallback_intersection(self, lists_input: List[List[Any]]) -> List[Any]:\n            \"\"\"Computes intersection for lists possibly containing unhashable elements.\"\"\"\n            first_sublist = lists_input[0]\n            common_elements_ordered: List[Any] = []\n\n            for item in first_sublist:\n                if item in common_elements_ordered:\n                    continue\n\n                in_all_sublists = True\n                for other_sublist in lists_input[1:]:\n                    found_in_current_sublist = False\n                    for element_in_other_sublist in other_sublist:\n                        if element_in_other_sublist == item:\n                            found_in_current_sublist = True\n                            break\n                    if not found_in_current_sublist:\n                        in_all_sublists = False\n                        break\n\n                if in_all_sublists:\n                    common_elements_ordered.append(item)\n            return common_elements_ordered\n\n    # The top-level function delegates to CommonFinder.\n    return CommonFinder().find_common(lists)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\nANGLE_UNIT_RADIANS = \"radians\"\nANGLE_UNIT_DEGREES = \"degrees\"\nDEFAULT_ANGLE_UNIT = \"radians\"\nclass ConversionError(Exception):\n    \"\"\"Domain-specific exception for conversion and validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass PolarCoordinate:\n    \"\"\"Represents polar coordinates (radius and angle).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = float(r)\n        self.theta = float(theta)\n\n    def to_tuple(self) -> tuple[float, float]:\n        \"\"\"Returns the polar coordinates as a tuple (r, theta).\"\"\"\n        return (self.r, self.theta)\n\n    def __repr__(self) -> str:\n        return f\"PolarCoordinate(r={self.r}, theta={self.theta})\"\nclass InputValidator:\n    \"\"\"Validates and normalizes input values into a complex number and validates angle unit.\"\"\"\n    def normalize(self, value: object) -> complex:\n        \"\"\"Converts various input types to a complex number.\"\"\"\n        if isinstance(value, complex):\n            return value\n        if isinstance(value, (int, float)):\n            return complex(value, 0.0)\n        if isinstance(value, tuple) and len(value) == 2:\n            real, imag = value\n            try:\n                return complex(float(real), float(imag))\n            except (TypeError, ValueError) as e:\n                raise ConversionError(f\"Invalid tuple input for complex number: {value}. Details: {e}\")\n        if isinstance(value, str):\n            return self._parse_numeric_string(value)\n        raise ConversionError(f\"Unsupported input type: {type(value).__name__}\")\n\n    def validate_angle_unit(self, angle_unit: str) -> str:\n        \"\"\"Validates and normalized the angle unit string.\"\"\"\n        normalized_unit = angle_unit.lower()\n        if normalized_unit == ANGLE_UNIT_RADIANS:\n            return ANGLE_UNIT_RADIANS\n        if normalized_unit == ANGLE_UNIT_DEGREES:\n            return ANGLE_UNIT_DEGREES\n        raise ConversionError(f\"Invalid angle_unit: '{angle_unit}'. Must be '{ANGLE_UNIT_RADIANS}' or '{ANGLE_UNIT_DEGREES}'.\")\n\n    def _parse_numeric_string(self, s: str) -> complex:\n        \"\"\"Parses a string into a complex number, supporting complex literals and (real, imag) tuple format.\"\"\"\n        s = s.strip()\n        try:\n            return complex(s)\n        except ValueError:\n            pass # Not a standard complex literal, try parsing as a tuple string\n\n        if s.startswith('(') and s.endswith(')'):\n            parts = s[1:-1].split(',')\n            if len(parts) == 2:\n                try:\n                    real = float(parts[0].strip())\n                    imag = float(parts[1].strip())\n                    return complex(real, imag)\n                except ValueError as e:\n                    raise ConversionError(f\"Invalid complex number string format for tuple '{s}'. Details: {e}\")\n\n        raise ConversionError(f\"Could not parse string '{s}' as a complex number.\")\nclass ComplexConverter:\n    \"\"\"Computes polar coordinates from a complex number and performs unit conversion.\"\"\"\n    def to_polar(self, c: complex, angle_unit: str = DEFAULT_ANGLE_UNIT) -> PolarCoordinate:\n        \"\"\"Converts a complex number to polar coordinates (r, theta).\"\"\"\n        r = math.hypot(c.real, c.imag)\n        theta_rad = math.atan2(c.imag, c.real)\n\n        theta = math.degrees(theta_rad) if angle_unit == ANGLE_UNIT_DEGREES else theta_rad\n\n        return PolarCoordinate(r, theta)\nclass ConvertController:\n    \"\"\"Public API glue \u2014 validates input, delegates conversion, and returns a simple tuple.\"\"\"\n    def __init__(self, validator: InputValidator = None, converter: ComplexConverter = None) -> None:\n        self.validator = validator if validator is not None else InputValidator()\n        self.converter = converter if converter is not None else ComplexConverter()\n\n    def convert(self, value: object, angle_unit: str = DEFAULT_ANGLE_UNIT) -> tuple[float, float]:\n        \"\"\"Converts an input value representing a complex number to polar coordinates.\"\"\"\n        normalized_complex = self.validator.normalize(value)\n        normalized_unit = self.validator.validate_angle_unit(angle_unit)\n        polar = self.converter.to_polar(normalized_complex, normalized_unit)\n        return polar.to_tuple()\n_default_controller = ConvertController()\ndef convert(value: object, angle_unit: str = 'radians') -> tuple[float, float]:\n    \"\"\"Converts a complex number (or equivalent) to polar coordinates (radius, angle).\"\"\"\n    return _default_controller.convert(value, angle_unit)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/84": [{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Computes the nth number in the Newman-Conway sequence using dynamic programming.\n    The sequence is defined by a(1)=1, a(2)=1, and for n > 2, a(n) = a(a(n-1)) + a(n-a(n-1)).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    # Use a list for efficient integer-indexed access; index 0 unused to match 1-based sequence.\n    memo = [0] * (n + 1)\n    memo[1] = 1\n    memo[2] = 1\n\n    for i in range(3, n + 1):\n        prev_idx = memo[i - 1]\n        # prev_idx is guaranteed to be <= i-1, so indices exist\n        memo[i] = memo[prev_idx] + memo[i - prev_idx]\n\n    return memo[n]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n, where each element is a positive integer,\n    is greater than or equal to twice the previous element, and is less than or equal to m.\n    \"\"\"\n    memo = {}\n\n    def _count_sequences_recursive(length_remaining: int, min_allowed_current_element: int) -> int:\n        # Base case: if length_remaining is 0, a valid sequence of desired length has been formed.\n        if length_remaining == 0:\n            return 1\n        # Base case: if the minimum allowed value for the current element exceeds m, no valid sequence can be formed.\n        if min_allowed_current_element > m:\n            return 0\n\n        # Check memoization cache\n        key = (length_remaining, min_allowed_current_element)\n        if key in memo:\n            return memo[key]\n\n        total_count = 0\n        # Iterate through possible values for the current element (x)\n        # x must be at least min_allowed_current_element and at most m.\n        for x in range(min_allowed_current_element, m + 1):\n            # The next element in the sequence must be at least twice the current element (2*x).\n            next_min_allowed = 2 * x\n            total_count += _count_sequences_recursive(length_remaining - 1, next_min_allowed)\n\n        # Store the computed result in the memoization cache before returning.\n        memo[key] = total_count\n        return total_count\n\n    # Start the recursive calculation for a sequence of length 'n', where the first element must be at least 1.\n    return _count_sequences_recursive(n, 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/264": [{"task_id": "Mbpp/264", "solution": "def dog_age(human_years):\n    \"\"\"\n    Calculates a dog's age in dog years based on a specific approximation.\n    The first two human years count as 10.5 dog years each, and subsequent years count as 4 dog years each.\n    \"\"\"\n    first_two_years_dog_years = 10.5\n    other_year_dog_years = 4.0\n\n    if human_years <= 0:\n        return 0\n    elif human_years <= 2:\n        dog_years_float = human_years * first_two_years_dog_years\n    else:\n        dog_years_float = (2 * first_two_years_dog_years) + ((human_years - 2) * other_year_dog_years)\n\n    return int(round(dog_years_float))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/261": [{"task_id": "Mbpp/261", "solution": "def division_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two tuples.\n\n    - If both elements are ints, uses integer floor-division (//).\n    - Otherwise computes true division and casts the result to int (truncates toward zero).\n    - Assumes inputs are same-length tuples of numeric types and does not perform explicit validation.\n    \"\"\"\n    def _divide_single_pair(x, y) -> int:\n        if isinstance(x, int) and isinstance(y, int):\n            return x // y\n        return int(x / y)\n\n    return tuple(_divide_single_pair(x, y) for x, y in zip(a, b))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 2, 3, 3], [5, 2, 3, 4]]]}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"\n    Swaps two numbers and returns them as a tuple in reversed order.\n    Input values are converted to float for consistent output.\n    \"\"