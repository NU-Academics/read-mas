            return o\n        return None\n\n    @classmethod\n    def matching_close_for(cls, open: str) -> str | None:\n        return cls.BRACKET_PAIRS.get(open)\nclass StackAdapter:\n    \"\"\"A simple stack implementation using a Python list.\"\"\"\n    def __init__(self):\n        self._stack: list[str] = []\n\n    def push(self, item: str) -> None:\n        self._stack.append(item)\n\n    def pop(self) -> str | None:\n        return self._stack.pop() if self._stack else None\n\n    def peek(self) -> str | None:\n        return self._stack[-1] if self._stack else None\n\n    def is_empty(self) -> bool:\n        return len(self._stack) == 0\n\n    def size(self) -> int:\n        return len(self._stack)\nclass BalancerService:\n    \"\"\"Implements the core logic for checking bracket balance in expressions.\"\"\"\n    def __init__(self, stack_adapter: StackAdapter, utils: BracketUtils):\n        self._stack_adapter = stack_adapter\n        self._utils = utils\n\n    def check(self, expression: str) -> ExpressionResult:\n        for idx, ch in enumerate(expression):\n            if self._utils.is_open(ch):\n                self._stack_adapter.push(ch)\n            elif self._utils.is_close(ch):\n                top = self._stack_adapter.pop()\n                expected_open = self._utils.matching_open_for(ch)\n                if top != expected_open:\n                    message = f\"mismatch at index {idx}: expected {self._utils.matching_close_for(top) if top else 'None'} but got {ch}\"\n                    return ExpressionResult(False, message=message, error_index=idx)\n            # Non-bracket characters are ignored as per design.\n\n        if not self._stack_adapter.is_empty():\n            return ExpressionResult(False, message=\"unmatched opening brackets remain\", error_index=None)\n\n        return ExpressionResult(True, message=\"balanced\")\n\n    def is_balanced(self, expression: str) -> bool:\n        \"\"\"Checks if the bracket sequence in an expre