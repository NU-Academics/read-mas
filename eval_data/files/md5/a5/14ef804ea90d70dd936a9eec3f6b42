_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to PascalCase (CamelCase with the first letter of each word capitalized).\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    segments = s.split('_')\n\n    camel_segments = []\n    for seg in segments:\n        stripped_seg = seg.strip()\n        if stripped_seg:\n            # Capitalize the first character of the segment and preserve the rest of its case.\n            # E.g., 'python' -> 'Python', '2' -> '2'.\n            capitalized_seg = stripped_seg[0].upper() + stripped_seg[1:]\n            camel_segments.append(capitalized_seg)\n\n    return \"\".join(camel_segments)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["___python_program"]]}], "Mbpp/100": [{"task_id": "Mbpp/100", "solution": "class PalindromeError(Exception):\n    \"\"\"Base exception for palindrome-related errors.\"\"\"\n    pass\nclass InvalidInputError(PalindromeError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\nclass NumericUtils:\n    \"\"\"Utility class for numeric and string conversions.\"\"\"\n    @staticmethod\n    def int_to_digit_list(n: int) -> list[str]:\n        \"\"\"Converts an integer to a list of its digit characters.\"\"\"\n        return list(str(n))\n\n    @staticmethod\n    def digit_list_to_int(digits: list[str]) -> int:\n        \"\"\"Converts a list of digit characters back to an integer.\"\"\"\n        return int(''.join(digits))\nclass InputValidator:\n    \"\"\"Validator for input values.\"\"\"\n    def validate_non_negative_int(self, value) -> int:\n        \"\"\"Validates if the value is a non-negative integer.\"\"\"\n        if not isinstance(value, int):\n            raise TypeError(\"value must be int\")\n        if value < 0:\n            raise InvalidInputError(\"value must be non-negative\")\n        return value\nclass PalindromeService:\n    \"\"\"Service class to find the next smallest palindrome.\"\"\"\n    DEFAULT_BASE: int = 10\n\n    def next_palindrome(self, n: int) -> int:\n        \"\"\"\n        Computes the smallest palindrome integer strictly greater than n.\n        Handles special cases for single-digit numbers and numbers consisting only of 9s.\n        \"\"\"\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\") # Redundant if InputValidator runs first, but kept as per design.\n        s = str(n)\n\n        # Handle numbers 0-8 directly\n        if n < 9:\n            return n + 1\n\n        # Handle cases like 9, 99, 999 where the length increases (e.g., 99 -> 101)\n        if all(ch == '9' for ch in s):\n            return int('1' + ('0' * (len(s) - 1)) + '1')\n\n        digits = NumericUtils.int_to_digit_list(n)\n\n        # Try mirroring the left half to the right\n        mirrored = self._mirror_left_to_right(digits[:])\n        mirrored_int = NumericUtils.digit_list_to_int(mirrored)\n\n        # If the mirrored number is already greater, it's the answer\n        if mirrored_int > n:\n            return mirrored_int\n\n        # Otherwise, increment the middle part and then mirror again\n        incremented = self._increment_mid(digits[:])\n        result = self._mirror_left_to_right(incremented)\n        return NumericUtils.digit_list_to_int(result)\n\n    def _is_palindrome(self, s: str) -> bool:\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return s == s[::-1]\n\n    def _increment_mid(self, digits: list[str]) -> list[str]:\n        \"\"\"\n        Increments the middle digit(s) of a number represented as a list of digits, handling carries.\n        This modifies the list in place and can potentially increase its length if there's an overall carry.\n        \"\"\"\n        n_len = len(digits)\n        mid_start_idx = (n_len - 1) // 2\n        i = mid_start_idx\n        carry = 1\n\n        # Propagate carry from the middle towards the left\n        while i >= 0 and carry > 0:\n            digit = int(digits[i]) + carry\n            digits[i] = str(digit % 10)\n            carry = digit // 10\n            i -= 1\n\n        # If there's still a carry after processing the left half, prepend it (e.g., 9 -> 10)\n        # This branch is primarily active for numbers that are all 9s (e.g., 9, 99),\n        # but these are often handled by an earlier check in next_palindrome.\n        if carry > 0:\n            digits.insert(0, str(carry))\n        return digits\n\n    def _mirror_left_to_right(self, digits: list[str]) -> list[str]:\n        \"\"\"\n        Mirrors the left half of a digit list to its right half to form a palindrome.\n        This modifies the list in place.\n        \"\"\"\n        n_len = len(digits)\n        for i in range(n_len // 2):\n            digits[n_len - 1 - i] = digits[i]\n        return digits\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    The palindrome returned is strictly greater than the input `n`.\n    \"\"\"\n    validator = InputValidator()\n    valid_n = validator.validate_non_negative_int(n)\n    svc = PalindromeService()\n    return svc.next_palindrome(valid_n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/103": [{"task_id": "Mbpp/103", "solution": "import os\nimport json\nfrom typing import Dict, Tuple, Optional, Any, Iterable\nclass EulerianError(Exception):\n    \"\"\"Base exception for Eulerian number operations.\"\"\"\n    pass\nclass InvalidInputError(EulerianError):\n    \"\"\"Raised when function inputs are invalid.\"\"\"\n    pass\nclass CalculationError(EulerianError):\n    \"\"\"Raised when an error occurs during Eulerian number computation.\"\"\"\n    pass\nclass PersistenceError(EulerianError):\n    \"\"\"Raised when there's an issue with cache persistence.\"\"\"\n    pass\ndef validate_inputs(n_raw: Any, m_raw: Any) -> Tuple[int, int]:\n    \"\"\"Validates and converts inputs n and m to integers.\"\"\"\n    try:\n        n = int(n_raw)\n        m = int(m_raw)\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(f\"Inputs n and m must be integers: {e}\")\n\n    if n < 0:\n        raise InvalidInputError(f\"n must be a non-negative integer, got {n}\")\n\n    if n == 0:\n        if m == 0:\n            return 0, 0\n        else:\n            raise InvalidInputError(f\"For n=0, m must be 0, got {m}\")\n\n    if not (0 <= m < n):\n        raise InvalidInputError(f\"For n={n}, m must be between 0 and {n-1} inclusive, got {m}\")\n\n    return n, m\ndef default_cache_path() -> str:\n    \"\"\"Returns the default path for the JSON cache file.\"\"\"\n    cache_dir = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"eulerian\")\n    os.makedirs(cache_dir, exist_ok=True)\n    return os.path.join(cache_dir, \"cache.json\")\ndef read_json_file(path: str) -> Dict[str, int]:\n    \"\"\"Reads a JSON file, handling metadata and potential errors.\"\"\"\n    if not os.path.exists(path):\n        return {}\n    try:\n        with open(path, 'r', encoding='utf-8') as f:\n            data = json.load(f)\n            if not isinstance(data, dict):\n                raise ValueError(\"Cache file content is not a dictionary.\")\n            # Remove metadata if present, as per design\n            if \"_meta\" in data:\n                del data[\"_meta\"]\n            return {k: v for k, v in data.items() if isinstance(k, str) and isinstance(v, int)}\n    except (IOError, json.JSONDecodeError, ValueError) as e:\n        raise PersistenceError(f\"Failed to read cache file {path}: {e}\")\nclass MemoRepository:\n    \"\"\"Manages in-memory cache and optional JSON persistence for Eulerian numbers.\"\"\"\n    def __init__(self, initial: Optional[Dict[Tuple[int,int], int]] = None, persist: bool = False, path: Optional[str] = None):\n        self.cache: Dict[Tuple[int,int], int] = initial if initial is not None else {}\n        self.persist = persist\n        self.path = path\n\n        if self.persist and self.path:\n            self.load_from_disk()\n\n    def get(self, n: int, m: int) -> Optional[int]:\n        \"\"\"Retrieves an Eulerian number from the cache.\"\"\"\n        return self.cache.get((n, m))\n\n    def set(self, n: int, m: int, value: int) -> None:\n        \"\"\"Stores an Eulerian number in the cache and optionally persists it.\"\"\"\n        self.cache[(n, m)] = value\n        if self.persist:\n            try:\n                self.persist_to_disk()\n            except PersistenceError:\n                # Log a warning and continue as per design\n                pass\n\n    def persist_to_disk(self) -> None:\n        \"\"\"Writes the current cache to the configured JSON file.\"\"\"\n        if not self.path:\n            return\n        serializable_cache = {f\"{k[0]},{k[1]}\": v for k, v in self.cache.items()}\n        write_json_file(self.path, serializable_cache)\n\n    def load_from_disk(self) -> None:\n        \"\"\"Loads cached Eulerian numbers from the configured JSON file.\"\"\"\n        if not self.path:\n            return\n        try:\n            raw_data = read_json_file(self.path)\n            loaded_cache = {}\n            for key_str, value in raw_data.items():\n                try:\n                    n_str, m_str = key_str.split(',')\n                    n_val, m_val = int(n_str), int(m_str)\n                    loaded_cache[(n_val, m_val)] = value\n                except ValueError:\n                    # Log a warning for malformed entry, but continue loading valid ones\n                    pass\n            self.cache.update(loaded_cache)\n        except PersistenceError:\n            # Log a warning but don't prevent function from running\n            pass\nclass EulerianCalculator:\n    \"\"\"Computes Eulerian numbers using dynamic programming and memoization.\"\"\"\n    def __init__(self, repository: \"MemoRepository\"):\n        self.repository = repository\n        # Preload a(0,0)=1 into the repository if not present\n        if self.repository.get(0, 0) is None:\n            self.repository.set(0, 0, 1)\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"Calculates the Eulerian number a(n, m) using bottom-up DP.\"\"\"\n        # Check if the result is already in the cache\n        if (v := self.repository.get(n, m)) is not None:\n            return v\n\n        # Initialize a local DP table to build up values\n        dp: Dict[Tuple[int, int], int] = {}\n        # Base case a(0,0) = 1\n        dp[(0, 0)] = 1\n\n        # Fill the DP table up to n\n        for i in range(1, n + 1):\n            for j in range(0, i): # m ranges from 0 to n-1 (inclusive)\n                # Recurrence relation: a(i,j) = (i - j) * a(i - 1, j - 1) + (j + 1) * a(i - 1, j)\n                # Values for m < 0 or m >= n are 0 by convention, handled by dp.get(..., 0)\n                val_prev_m_minus_1 = dp.get((i - 1, j - 1), 0)\n                val_prev_m = dp.get((i - 1, j), 0)\n\n                computed_val = (i - j) * val_prev_m_minus_1 + (j + 1) * val_prev_m\n                dp[(i, j)] = computed_val\n                self.repository.set(i, j, computed_val) # Store in persistent cache\n\n        # After computation, the value should be in the local dp table and repository\n        result = dp.get((n, m))\n        if result is None:\n            # This case should ideally not be reached if n >= 0 and 0 <= m < n (or n=m=0)\n            raise CalculationError(f\"Eulerian number for a({n},{m}) could not be computed.\")\n\n        return result\ndef eulerian_num(n: int, m: int, persist_cache: bool = False, cache_path: str | None = None) -> int:\n    \"\"\"\n    Computes the Eulerian number A(n, m).\n    It uses a memoized dynamic programming approach with optional disk persistence.\n    \"\"\"\n    n_validated, m_validated = validate_inputs(n, m)\n\n    if n_validated == 0 and m_validated == 0:\n        return 1\n\n    actual_cache_path = cache_path or default_cache_path()\n\n    repo = MemoRepository(persist=persist_cache, path=actual_cache_path)\n    calc = EulerianCalculator(repo)\n\n    return calc.compute(n_validated, m_validated)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/105": [{"task_id": "Mbpp/105", "solution": "def count(items):\n    \"\"\"\n    Counts the number of True booleans in the given list.\n    Only strictly boolean True values are counted.\n    \"\"\"\n    true_count = 0\n    for item in items:\n        if item is True:\n            true_count += 1\n    return true_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/104": [{"task_id": "Mbpp/104", "solution": "def sort_sublists(data, case_insensitive: bool = False):\n    \"\"\"Sorts each sublist of strings within a given iterable of iterables.\n    Elements within sublists are converted to strings before sorting.\"\"\"\n    sorted_result = []\n    key_func = str.lower if case_insensitive else None\n\n    for sublist_raw in data:\n        # Convert all elements to strings and create a mutable list\n        current_list = [str(item) for item in sublist_raw]\n        current_list.sort(key=key_func)\n        sorted_result.append(current_list)\n\n    return sorted_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/106": [{"task_id": "Mbpp/106", "solution": "def add_lists(list_obj, tuple_obj):\n    \"\"\"Appends elements from a list to the end of a tuple, returning a new tuple.\"\"\"\n    return tuple_obj + tuple(list_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/109": [{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of times a binary string, when rotated, results in an odd integer.\n    An integer is odd if its least significant bit (the last character in the binary string) is '1'.\n    \"\"\"\n    m = len(binary)\n\n    # Return 0 if the binary string is empty or no rotations are requested.\n    if m == 0 or rotations == 0:\n        return 0\n\n    # The number of '1's in the string is equal to the number of odd rotations in one full cycle\n    # because each character of the original string appears exactly once as the least significant bit\n    # across a full cycle of m unique rotations.\n    ones_in_full_cycle = binary.count('1')\n\n    # Calculate how many full cycles of rotations occur and the remainder rotations.\n    full_cycles = rotations // m\n    remainder_rotations = rotations % m\n\n    # Construct a sequence of the least significant bits (last characters) for each rotation in one full cycle.\n    # For 'i' right rotations, the original character at index (m - 1 - i) % m becomes the last character.\n    lsb_sequence_for_cycle = [binary[(m - 1 - i) % m] for i in range(m)]\n\n    # Count the number of '1's in the least significant bits for the remainder rotations.\n    remainder_odd_count = sum(1 for bit in lsb_sequence_for_cycle[:remainder_rotations] if bit == '1')\n\n    # The total number of odd rotations is the sum of odd rotations in full cycles and the remainder.\n    total_odd_rotations = full_cycles * ones_in_full_cycle + remainder_odd_count\n\n    return total_odd_rotations", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["10000100110011", 5]]}], "Mbpp/113": [{"task_id": "Mbpp/113", "solution": "import re\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, ignoring leading/trailing whitespace.\n    Handles optional leading signs and leading zeros, but rejects decimals or scientific notation.\n    \"\"\"\n    PATTERN_INT: str = r'^[+-]?\\d+$'\n    MAX_INPUT_LENGTH: int = 10_000\n\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    if len(s) > MAX_INPUT_LENGTH:\n        return False\n\n    normalized_s = s.strip()\n\n    if len(normalized_s) == 0:\n        return False\n\n    return re.fullmatch(PATTERN_INT, normalized_s) is not None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "Mbpp/118": [{"task_id": "Mbpp/118", "solution": "def string_to_list(input_string: str) -> list[str]:\n    \"\"\"\n    Converts a string into a list of strings by splitting on the space character.\n    Consecutive spaces will result in empty strings in the list.\n    \"\"\"\n    return input_string.split(' ')", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/108": [{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(a: list, b: list, c: list) -> list:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    Handles unsorted inputs by concatenating and sorting, or uses a three-way merge for pre-sorted inputs.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid function inputs.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class InputLists:\n        \"\"\"DTO to hold shallow copies of the input lists after validation.\"\"\"\n        def __init__(self, a_list: list, b_list: list, c_list: list) -> None:\n            self.a = list(a_list)\n            self.b = list(b_list)\n            self.c = list(c_list)\n\n    MAX_SAMPLE_FOR_COMPARABILITY = 5\n\n    def _are_elements_comparable(sample_elements: list) -> bool:\n        \"\"\"Checks if elements in a sample list are mutually comparable using '<' operator.\"\"\"\n        try:\n            for i in range(1, len(sample_elements)):\n                _ = sample_elements[i] < sample_elements[i - 1]\n        except TypeError:\n            return False\n        return True\n\n    # Validate inputs: check if they are lists\n    if not isinstance(a, list) or not isinstance(b, list) or not isinstance(c, list):\n        raise InvalidInputError(\"All inputs must be lists.\")\n\n    dto = InputLists(a, b, c)\n\n    # Perform a sample comparability check across all inputs.\n    sample_for_comparability = []\n    for lst in (dto.a, dto.b, dto.c):\n        sample_for_comparability.extend(lst[:MAX_SAMPLE_FOR_COMPARABILITY])\n    if sample_for_comparability and not _are_elements_comparable(sample_for_comparability):\n        raise InvalidInputError(\"Elements are not mutually comparable.\")\n\n    def _is_sorted(lst: list) -> bool:\n        \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n        try:\n            return all(lst[i] <= lst[i+1] for i in range(len(lst)-1))\n        except TypeError:\n            # If comparison fails, the list is not consistently sortable, so treat as unsorted.\n            return False\n\n    def _three_way_merge(a_list: list, b_list: list, c_list: list) -> list:\n        \"\"\"Merges three pre-sorted lists into a single sorted list efficiently in O(N) time.\"\"\"\n        i = j = k = 0\n        out: list = []\n        while i < len(a_list) or j < len(b_list) or k < len(c_list):\n            candidates = []\n            if i < len(a_list): candidates.append((0, a_list[i])) # 0 for list 'a' to aid tie-breaking\n            if j < len(b_list): candidates.append((1, b_list[j])) # 1 for list 'b'\n            if k < len(c_list): candidates.append((2, c_list[k])) # 2 for list 'c'\n\n            try:\n                # `min` selects the item with the smallest value.\n                # If values are equal, it picks the first item encountered in `candidates`,\n                # implicitly ensuring 'a' then 'b' then 'c' tie-breaking order.\n                smallest = min(candidates, key=lambda x: x[1])\n            except TypeError as exc:\n                raise InvalidInputError(\"Incomparable elements encountered during merge.\") from exc\n\n            which_list_id, val = smallest\n            out.append(val)\n\n            if which_list_id == 0: i += 1\n            elif which_list_id == 1: j += 1\n            else: k += 1\n        return out\n\n    def _concat_and_sort(a_list: list, b_list: list, c_list: list) -> list:\n        \"\"\"Concatenates three lists and sorts the combined result using Python's Timsort.\"\"\"\n        return sorted(a_list + b_list + c_list)\n\n    # Determine if inputs are sorted to choose the most efficient merge strategy.\n    a_is_sorted = _is_sorted(dto.a)\n    b_is_sorted = _is_sorted(dto.b)\n    c_is_sorted = _is_sorted(dto.c)\n\n    if a_is_sorted and b_is_sorted and c_is_sorted:\n        # If all lists are already sorted, use the efficient three-way merge.\n        return _three_way_merge(dto.a, dto.b, dto.c)\n    else:\n        # Otherwise, concatenate and use Python's built-in sorted function (Timsort).\n        return _concat_and_sort(dto.a, dto.b, dto.c)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/116": [{"task_id": "Mbpp/116", "solution": "def num_digits(n: int) -> int:\n    \"\"\"Calculates the number of decimal digits in a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n    d = 0\n    while n > 0:\n        n //= 10\n        d += 1\n    return d\ndef join_digits_arithmetic(digits: tuple[int, ...]) -> int:\n    \"\"\"Concatenates a tuple of integers into a single integer arithmetically.\"\"\"\n    result = 0\n    for d in digits:\n        nd = num_digits(d)\n        result = result * (10 ** nd) + d\n    return result\ndef tuple_to_int(digits: tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenation.\"\"\"\n    return join_digits_arithmetic(digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/120": [{"task_id": "M