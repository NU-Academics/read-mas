ap, (-a_sorted[i + 1] * b_sorted[j], i + 1, j))\n            visited.add((i + 1, j))\n\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-14, 95, -14, true, -100, true, -93, -93, 28, -100, -58, -93], [-14, 95, -14, true, -100, true, -93, -93, 28, -100, -58, -93], 1]]}], "Mbpp/312": [{"task_id": "Mbpp/312", "solution": "def volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a right circular cone.\n    The formula used is V = (\u03c0 * r^2 * h) / 3.\n    \"\"\"\n    import math\n\n    # Validate inputs\n    try:\n        r = float(radius)\n    except (TypeError, ValueError):\n        raise ValueError(f\"radius must be a number; got {radius!r}\")\n    try:\n        h = float(height)\n    except (TypeError, ValueError):\n        raise ValueError(f\"height must be a number; got {height!r}\")\n\n    if r <= 0:\n        raise ValueError(f\"radius must be > 0; got {r}\")\n    if h <= 0:\n        raise ValueError(f\"height must be > 0; got {h}\")\n\n    return (math.pi * r**2 * h) / 3.0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/278": [{"task_id": "Mbpp/278", "solution": "def count_first_elements(tuple_input: tuple) -> int:\n    \"\"\"Counts elements before the first tuple element in the top-level tuple.\"\"\"\n    for idx, element in enumerate(tuple_input):\n        if isinstance(element, tuple):\n            return idx\n    return len(tuple_input)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 4, 5, 6]]]}], "Mbpp/388": [{"task_id": "Mbpp/388", "solution": "from .services import PowerOfTwoService\nfrom .validators import InputValidator\nfrom .exceptions import ValidationError\n_service = PowerOfTwoService(InputValidator())\ndef highest_Power_of_2(n: int) -> int:\n    \"\"\"Public API: returns highest power of two <= n.\n    Delegates computation to the PowerO