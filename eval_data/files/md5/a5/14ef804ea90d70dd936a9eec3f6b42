n    return result\ndef catalan_from_binomial(n: int) -> int:\n    \"\"\"Computes the nth Catalan number using the binomial coefficient formula: C(n) = C(2n, n) / (n+1).\"\"\"\n    c = multiplicative_binomial(2 * n, n)\n    return c // (n + 1)\nDEFAULT_ALGORITHM = \"multiplicative\"\nclass CatalanCalculator:\n    \"\"\"Service for computing Catalan numbers using different algorithms and caching.\"\"\"\n    def __init__(self, cache: Optional[CacheInterface] = None, validator: Optional[Validator] = None, algorithm: str = DEFAULT_ALGORITHM) -> None:\n        self._cache = cache\n        self._validator = validator or Validator()\n        self._algorithm = algorithm\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number, using cache and selected algorithm.\"\"\"\n        self._validator.validate_non_negative_int(n)\n        key = f\"catalan:{n}\"\n        if self._cache:\n            cached = self._cache.get(key)\n            if cached is not None:\n                return cached\n\n        if self._algorithm == \"multiplicative\":\n            result = self._compute_multiplicative(n)\n        elif self._algorithm == \"dp\":\n            result = self._compute_dp(n)\n        else:\n            raise CatalanError(f\"Unknown algorithm: {self._algorithm}\")\n\n        if self._cache:\n            self._cache.set(key, result)\n        return result\n\n    def _compute_multiplicative(self, n: int) -> int:\n        \"\"\"Computes Catalan number using the multiplicative binomial formula.\"\"\"\n        return catalan_from_binomial(n)\n\n    def _compute_dp(self, n: int) -> int:\n        \"\"\"Computes Catalan number using dynamic programming.\"\"\"\n        if n == 0:\n            return 1\n        catalan = [0] * (n + 1)\n        catalan[0] = 1\n        for i in range(1, n + 1):\n            for j in range(i):\n                catalan[i] += catalan[j] * catalan[i - 1 - j]\n        return catalan[n]\n_default_calc = CatalanCalculator(cache=InMemoryCache())\ndef catalan_number(n: int) -> int:\n    \"\"\"Returns the nth Catalan number.\"\"\"\n    return _default_calc.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/585": [{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Return the n most expensive items from a list of item dicts.\n    Items are expected to be dict-like with a numeric 'price' key.\n    Result preserves original dicts and preserves input order for ties.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Attach original index to preserve stable tie-breaking\n    indexed = []\n    for idx, item in enumerate(items):\n        # Let exceptions propagate for missing/non-numeric prices to keep behavior simple\n        price = float(item['price'])\n        indexed.append((idx, price, item))\n\n    # Sort by price descending, then by original index ascending (to preserve input order on ties)\n    indexed.sort(key=lambda t: (-t[1], t[0]))\n\n    # Slice top-n and return original dicts\n    top = indexed[:n] if n < len(indexed) else indexed\n    return [entry[2] for entry in top]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/589": [{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within the inclusive range [start, end].\n    Only non-negative perfect squares (0, 1, 4, ...) are considered and returned.\n    \"\"\"\n    # Determine the smallest integer k such that k*k is within [start, end].\n    # If start is negative or zero, the first possible perfect square is 0 (0*0), so k starts from 0.\n    if start <= 0:\n        k_start = 0\n    else:\n        # For positive start, find ceil(sqrt(start)) to get the smallest k whose square is >= start.\n        k_start = math.ceil(math.sqrt(start))\n\n    # Determine the largest integer k such that k*k is within [start, end].\n    # If end is negative, no non-negative perfect squares exist in the range.\n    if end < 0:\n        k_end = -1  # Ensures the iteration range is empty, resulting in an empty list.\n    else:\n        # For non-negative end, math.isqrt(end) returns floor(sqrt(end)),\n        # giving the largest integer k whose square is <= end.\n        k_end = math.isqrt(end)\n\n    squares = []\n    # Iterate k from k_start to k_end (inclusive) and add k*k to the list.\n    # If k_start > k_end, the range will be empty, correctly returning an empty list.\n    for k in range(k_start, k_end + 1):\n        squares.append(k * k)\n\n    return squares", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1, 0]]}], "Mbpp/593": [{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeroes from each octet of an IPv4 address string.\"\"\"\n    segments = ip.split('.')\n    normalized_segments = [str(int(segment)) for segment in segments]\n    return '.'.join(normalized_segments)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["0.0.0.0"]]}], "Mbpp/591": [{"task_id": "Mbpp/591", "solution": "def swap_List(lst):\n    \"\"\"Interchanges the first and last elements in a list, returning a new list.\"\"\"\n    n = len(lst)\n    if n < 2:\n        return list(lst)\n\n    copy = list(lst)\n    copy[0], copy[-1] = copy[-1], copy[0]\n    return copy", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/588": [{"task_id": "Mbpp/588", "solution": "def big_diff(numbers):\n    \"\"\"Calculates the difference between the largest and smallest value in a list.\"\"\"\n    largest = max(numbers)\n    smallest = min(numbers)\n    return largest - smallest", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/590": [{"task_id": "Mbpp/590", "solution": "import math\nimport cmath\nfrom typing import Any, Tuple\nclass ValidationError(Exception):\n    \"\"\"Domain-specific exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef is_finite_number(value: Any) -> bool:\n    \"\"\"Return True if value is int/float and not NaN or infinite.\"\"\"\n    return isinstance(value, (int, float)) and not (math.isinf(value) or math.isnan(value))\ndef coerce_number(value: Any, name: str = \"value\") -> float:\n    \"\"\"\n    Convert to float if possible else raise ValidationError.\n    Raises ValidationError if conversion fails or value not finite.\n    \"\"\"\n    try:\n        v = float(value)\n    except (TypeError, ValueError):\n        raise ValidationError(f\"{name} must be numeric\")\n    if not is_finite_number(v):\n        raise ValidationError(f\"{name} must be finite and not NaN\")\n    return v\nclass Polar:\n    \"\"\"Domain DTO for a polar coordinate pair (r, theta).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self._r = r\n        self._theta = theta\n\n    def as_tuple(self) -> Tuple[float, float]:\n        \"\"\"Return (r, theta) immutable tuple.\"\"\"\n        return (self._r, self._theta)\nclass Rectangular:\n    \"\"\"Domain DTO for a rectangular coordinate pair (x, y).\"\"\"\n    def __init__(self, x: float, y: float) -> None:\n        self._x = x\n        self._y = y\n\n    def as_complex(self) -> complex:\n        \"\"\"Return complex(x, y).\"\"\"\n        return complex(self._x, self._y)\nclass ConverterService:\n    \"\"\"Encapsulates conversion algorithms (cartesian <-> polar).\"\"\"\n    def cartesian_to_polar(self, x: float, y: float) -> Tuple[Polar, complex]:\n        \"\"\"\n        Converts Cartesian coordinates (x, y) to polar coordinates (r, theta) and complex.\n        Returns a Polar object and a complex number (x + yj).\n        \"\"\"\n        x_f = coerce_number(x, \"x\")\n        y_f = coerce_number(y, \"y\")\n        r = math.hypot(x_f, y_f)\n        theta = math.atan2(y_f, x_f)\n        polar = Polar(r, theta)\n        rect = Rectangular(x_f, y_f)\n        return polar, rect.as_complex()\n\n    def polar_to_rect(self, r: float, theta: float) -> Tuple[Polar, complex]:\n        \"\"\"\n        Converts polar coordinates (r, theta) to rectangular complex form.\n        Also returns the canonical polar tuple.\n        \"\"\"\n        r_f = coerce_number(r, \"r\")\n        theta_f = coerce_number(theta, \"theta\")\n        if r_f < 0:\n            raise ValidationError(\"r (radius) must be non-negative\")\n        z = cmath.rect(r_f, theta_f)\n        return Polar(r_f, theta_f), z\n_service = ConverterService()\ndef polar_rect(a, b):\n    \"\"\"\n    Converts Cartesian coordinates (x, y) to polar coordinates (r, theta) and complex.\n    Returns a tuple ((r, theta), complex_number) by treating inputs as Cartesian (x, y).\n    \"\"\"\n    # The design context explicitly indicates that polar_rect(a, b) defaults to\n    # Cartesian to Polar conversion when `input_type` is omitted or 'auto'.\n    # `a` is interpreted as x, `b` as y.\n    polar, z = _service.cartesian_to_polar(a, b)\n    return polar.as_tuple(), z", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[3, 4]], "plus_fail_tests": [[0, 0]]}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Utils:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def is_int(value) -> bool:\n        \"\"\"Checks if a value is an integer and not a boolean.\"\"\"\n        return isinstance(value, int) and not isinstance(value, bool)\n\n    @staticmethod\n    def validate_non_negative_int(n: int) -> None:\n        \"\"\"Validates if n is a non-negative integer.\"\"\"\n        if not Utils.is_int(n):\n            raise InvalidInputError(\"n must be an integer\")\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\nclass FactorialCache:\n    \"\"\"Caches factorial computations to improve performance.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {0: 1, 1: 1}\n\n    def get_factorial(self, n: int) -> int:\n        \"\"\"Returns the factorial of n, computing and caching if necessary.\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be >= 0\")\n        if n in self._cache:\n            return self._cache[n]\n\n        max_cached = max(self._cache.keys())\n        result = self._cache[max_cached]\n        for i in range(max_cached + 1, n + 1):\n            result *= i\n            self._cache[i] = result\n        return self._cache[n]\n\n    def clear(self) -> None:\n        \"\"\"Resets the factorial cache to its initial state.\"\"\"\n        self._cache = {0: 1, 1: 1}\nclass BinomialService:\n    \"\"\"Provides methods to compute binomial coefficients.\"\"\"\n    def __init__(self, factorial_cache: FactorialCache) -> None:\n        self._factorial_cache = factorial_cache\n\n    def nCr(self, n: int, k: int) -> int:\n        \"\"\"Computes C(n,k) = n! / (k! * (n-k)!).\"\"\"\n        if k < 0 or k > n:\n            raise ValueError(\"k must be in range [0, n]\")\n        num = self._factorial_cache.get_factorial(n)\n        den = self._factorial_cache.get_factorial(k) * self._factorial_cache.get_factorial(n - k)\n        return num // den\n\n    def row(self, n: int) -> list[int]:\n        \"\"\"Generates the nth row of Pascal's triangle (C(n,0) to C(n,n)).\"\"\"\n        return [self.nCr(n, k) for k in range(0, n + 1)]\nclass SumProductService:\n    \"\"\"Computes the sum of products of consecutive binomial coefficients.\"\"\"\n    def __init__(self, binomial_service: BinomialService) -> None:\n        self._binomial_service = binomial_service\n\n    def sum_of_product(self, n: int) -> int:\n        \"\"\"Calculates sum_{k=0}^{n-1} C(n,k)*C(n,k+1).\"\"\"\n        if n == 0:\n            return 0\n\n        row = self._binomial_service.row(n)\n        total = 0\n        for k in range(0, n):\n            total += row[k] * row[k + 1]\n        return total\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Computes the sum of products of consecutive binomial coefficients.\n    S(n) = sum_{k=0}^{n-1} C(n,k)*C(n,k+1).\n    \"\"\"\n    Utils.validate_non_negative_int(n)\n\n    factorial_cache_instance = FactorialCache()\n    binomial_service_instance = BinomialService(factorial_cache_instance)\n    sum_product_service_instance = SumProductService(binomial_service_instance)\n\n    return sum_product_service_instance.sum_of_product(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/594": [{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"Finds the difference between the first even and first odd number in a list.\n    Returns first_even - first_odd.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/599": [{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"Return a tuple (sum, average) for the first n natural numbers.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return (0, 0.0)\n    total = n * (n + 1) // 2\n    average = total / n\n    return (total, average)", "base_status": "pass", "plus_status": "pass", "base_fail_tests