 OR operation.\n    return n | mask", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/230": [{"task_id": "Mbpp/230", "solution": "import uuid\nimport threading\nfrom datetime import datetime, timezone\nfrom dataclasses import dataclass\nfrom typing import List, Protocol, Optional\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for errors during repository operations.\"\"\"\n    def __init__(self, message: str, *, original: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.original = original\ndef current_timestamp() -> str:\n    \"\"\"Generates an ISO 8601 formatted UTC timestamp.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\nclass HistoryRepository(Protocol):\n    \"\"\"Interface for history persistence operations.\"\"\"\n    def save(self, record: ReplaceRecord) -> None: ...\n    def list(self, page: int, size: int) -> List[ReplaceRecord]: ...\nclass InMemoryHistoryRepository:\n    \"\"\"An in-memory implementation of the HistoryRepository.\"\"\"\n    def __init__(self) -> None:\n        self._storage: List[ReplaceRecord] = []\n        self._lock = threading.Lock()\n\n    def save(self, record: ReplaceRecord) -> None:\n        \"\"\"Saves a replace record to in-memory storage.\"\"\"\n        with self._lock:\n            self._storage.append(record)\n\n    def list(self, page: int, size: int) -> List[ReplaceRecord]:\n        \"\"\"Lists history records, newest first, with pagination.\"\"\"\n        if page < 1: page = 1\n        if size < 1: size = 1\n\n        with self._lock:\n            reversed_storage = self._storage[::-1]\n            start_index = (page - 1) * size\n            end_index = start_index + size\n            return reversed_storage[start_index:end_index]\nclass ReplaceService:\n    \"\"\"Core business logic for replacing blanks and managing history.\"\"\"\n    def __init__(self, repo: HistoryRepository) -> None:\n        self._repo = repo\n\n    def replace(self, request: ReplaceRequest, persist: bool = True) -> str:\n        \"\"\"Replaces spaces in text with char, optionally persisting the operation.\"\"\"\n        validate_text(request.text)\n        validate_char(request.char)\n        result = request.text.replace(\" \", request.char)\n        if persist:\n            record = ReplaceRecord(\n                id=uuid.uuid4().hex,\n                input_text=request.text,\n                char=request.char,\n                output_text=result,\n                timestamp=current_timestamp()\n            )\n            try:\n                self._repo.save(record)\n            except Exception as e:\n                raise RepositoryError(\"Failed to persist record\", original=e)\n        return result\n\n    def get_history(self, page: int = 1, size: int = 50) -> List[ReplaceRecord]:\n        \"\"\"Retrieves historical replace operations with pagination.\"\"\"\n        return self._repo.list(page=page, size=size)\ndef replace_blank(text: str, char: str) -> str:\n    \"\"\"\n    Takes in a string and character, replaces blank spaces in the string with the character,\n    and returns the string.\n    \"\"\"\n    svc = ReplaceService(InMemoryHistoryRepository())\n    req = ReplaceRequest(text=text, char=char)\n    return svc.replace(req, persist=False)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/232": [{"task_id": "Mbpp/232", "solution": "import heapq\nfrom typing import List, Any\ndef larg_nnum(list_items: List[Any], n: int) -> List[float]:\n    \"\"\"\n    Returns a list containing the n largest unique numeric items from the input list, sorted in descending order.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Convert all items to float and extract unique values.\n    unique_numeric_values = list(set(float(item) for item in list_items))\n\n    # Use heapq.nlargest to efficiently find the n larg