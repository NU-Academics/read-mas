ell number calculator.\"\"\"\n    def __init__(self, cache_size: int = 100, cache_file: Optional[str] = None):\n        self.cache_size = cache_size\n        self.cache_file = cache_file\nclass MathUtils:\n    \"\"\"Provides mathematical utility functions.\"\"\"\n    @staticmethod\n    def bell_triangle_row(n: int):\n        \"\"\"Builds Bell triangle up to row n and returns row n.\"\"\"\n        if n == 0:\n            return [1]\n        triangle = [[1]]\n        for i in range(1, n + 1):\n            prev_row = triangle[-1]\n            current_row = [prev_row[-1]]\n            for j in range(1, i + 1):\n                current_row.append(current_row[-1] + prev_row[j - 1])\n            triangle.append(current_row)\n        return triangle[-1]\nclass BellNumberCalculator:\n    \"\"\"Computes Bell numbers using the Bell triangle algorithm.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth Bell number.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise BellError(\"n must be a non-negative integer\")\n        if n == 0:\n            return 1\n        row = MathUtils.bell_triangle_row(n)\n        return row[0]\nclass BellCacheRepository:\n    \"\"\"Manages an in-memory LRU cache and optional disk persistence.\"\"\"\n    DEFAULT_CACHE_SIZE = 100\n\n    def __init__(self, max_size: int = DEFAULT_CACHE_SIZE, cache_file: Optional[str] = None):\n        self._cache = collections.OrderedDict()\n        self._max_size = max_size\n        self._cache_file = cache_file\n        self._lock = threading.Lock()\n        if cache_file:\n            try:\n                self.load()\n            except Exception:\n                pass # Silently fail to load, continue with empty cache.\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Bell number from the cache.\"\"\"\n        with self._lock:\n            value = self._cache.get(n)\n            if value is not None:\n                self._cache.move_to_end(n)\n            return value\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Bell number in the cache.\"\"\"\n        with self._lock:\n            self._cache[n] = value\n            self._cache.move_to_end(n)\n            if len(self._cache) > self._max_size:\n                self._cache.popitem(last=False)\n            if self._cache_file:\n                try:\n                    self.persist()\n                except Exception:\n                    pass # Silently fail to persist, computation result is still returned.\n\n    def persist(self) -> None:\n        \"\"\"Persists the cache to a JSON file.\"\"\"\n        if not self._cache_file:\n            return\n        tmp_file = self._cache_file + \".tmp\"\n        data = {str(k): v for k, v in self._cache.items()}\n        with open(tmp_file, \"w\") as f:\n            json.dump(data, f)\n        os.replace(tmp_file, self._cache_file)\n\n    def load(self) -> None:\n        \"\"\"Loads the cache from a JSON file.\"\"\"\n        if not self._cache_file or not os.path.exists(self._cache_file):\n            return\n        with open(self._cache_file, \"r\") as f:\n            data = json.load(f)\n        with self._lock:\n            self._cache.clear()\n            for k_str, v in data.items():\n                self._cache[int(k_str)] = int(v)\nclass BellController:\n    \"\"\"Validates input and orchestrates Bell number computation and caching.\"\"\"\n    def __init__(self, calculator: BellNumberCalculator, repository: BellCacheRepository, config: Config) -> None:\n        self.calculator = calculator\n        self.repository = repository\n        self.config = config\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Bell number, utilizing caching.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise BellError(\"n must be a non-negative integer\")\n        cached = self.repository.get(n)\n        if cached is not None:\n            return cached\n        value = self.calculator.compute(n)\n        self.repository.set(n, value)\n        return value\ndef bell_Number(n: int) -> int:\n    \"\"\"Finds the nth Bell number.\"\"\"\n    default_config = Config()\n    repository = BellCacheRepository(max_size=default_config.cache_size, cache_file=default_config.cache_file)\n    calculator = BellNumberCalculator()\n    controller = BellController(calculator, repository, default_config)\n    return controller.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/462": [{"task_id": "Mbpp/462", "solution": "def combinations_list(elements):\n    \"\"\"\n    Finds all possible combinations (subsets) of the elements in the input list.\n    The combinations are generated in a deterministic order following an iterative prepend algorithm.\n    \"\"\"\n    result = [[]]\n    for element in elements:\n        # Create new combinations by prepending the current element to each existing combination\n        new_combos = [[element] + combo for combo in result]\n        # Extend the result list with these new combinations\n        result.extend(new_combos)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/618": [{"task_id": "Mbpp/618", "solution": "def div_list(a: list, b: list) -> list:\n    \"\"\"\n    Divides two lists element-wise, converting elements to float before division.\n    This function performs the core division logic and expects compatible input formats.\n    \"\"\"\n    return [float(x) / float(y) for x, y in zip(a, b)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/619": [{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving relative order.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if char.isdigit():\n        