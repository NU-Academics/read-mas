atus": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[false]]}], "Mbpp/141": [{"task_id": "Mbpp/141", "solution": "def pancake_sort(items):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list, without modifying the original.\n    \"\"\"\n    def _flip(arr, k):\n        \"\"\"Reverses the elements in arr from index 0 to k (inclusive).\"\"\"\n        left = 0\n        right = k\n        while left < right:\n            arr[left], arr[right] = arr[right], arr[left]\n            left += 1\n            right -= 1\n\n    # Create a defensive copy to avoid modifying the original list\n    arr = list(items)\n    n = len(arr)\n\n    # Iterate from the end of the list down to the second element\n    # current_size represents the length of the unsorted prefix\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted prefix\n        max_idx = 0\n        for i in range(1, current_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at its correct position (end of current_size)\n        if max_idx != current_size - 1:\n            # First flip: bring the maximum element to the front\n            _flip(arr, max_idx)\n            # Second flip: move the maximum element to its correct position\n            _flip(arr, current_size - 1)\n\n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/160": [{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int):\n    # Helper for the extended Euclidean algorithm to find d = gcd(a,b) and integers x_g, y_g such that a*x_g + b*y_g = d.\n    def _extended_gcd(a, b):\n        if a == 0:\n            return b, 0, 1\n        gcd, x1, y1 = _extended_gcd(b % a, a)\n        x = y1 - (b // a) * x1\n        y = x1\n        return gcd, x, y\n\n    # Handle the special case where both a and b are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Handle cases where one of a or b is zero (and the other is non-zero).\n    if a == 0:  # Equation is b*y = n. Since b != 0, y = n/b.\n        if n % b == 0:\n            return (0, n // b)  # x can be any integer, canonical choice for x=0.\n        else:\n            return None\n    if b == 0:  # Equation is a*x = n. Since a != 0, x = n/a.\n        if n % a == 0:\n            return (n // a, 0)  # y can be any integer, canonical choice for y=0.\n        else:\n            return None\n\n    # For a != 0 and b != 0:\n    # Use the extended Euclidean algorithm to find d = gcd(a,b) and x_g, y_g such that a*x_g + b*y_g = d_raw.\n    d_raw, x_g_raw, y_g_raw = _extended_gcd(a, b)\n\n    # Ensure d (the GCD) is positive and adjust x_g, y_g accordingly.\n    # If d_raw is negative, then a*x_g_raw + b*y_g_raw = -d. So we use -x_g_raw, -y_g_raw for a*x + b*y = d.\n    if d_raw < 0:\n        d = -d_raw\n        x_g = -x_g_raw\n        y_g = -y_g_raw\n    else:\n        d = d_raw\n        x_g = x_g_raw\n        y_g = y_g_raw\n\n    # Check if a solution exists. It exists if and only if d divides n.\n    if n % d != 0:\n        return None\n\n    # Calculate a particular solution (x0, y0) for a*x + b*y = n.\n    # We know a*x_g + b*y_g = d. Multiply by (n/d).\n    scale_factor = n // d\n    x0 = x_g * scale_factor\n    y0 = y_g * scale_factor\n\n    # Canonicalize the solution such that x is in the range [0, |b/d|).\n    # The general solution is x = x0 + k * (b // d), y = y0 - k * (a // d).\n\n    b_over_d = b // d\n    mod_val = abs(b_over_d)\n\n    # Calculate the canonical x value in the range [0, mod_val).\n    # Python's % operator already works well for this when mod_val is positive.\n    x_canonical = x0 % mod_val\n\n    # Determine the integer k that leads to x_canonical.\n    # x_canonical = x0 + k * b_over_d => k * b_over_d = x_canonical - x0\n    # k = (x_canonical - x0) // b_over_d\n    k_adjustment = (x_canonical - x0) // b_over_d\n\n    # Calculate the corresponding y value.\n    y_canonical = y0 - k_adjustment * (a // d)\n\n    return (x_canonical, y_canonical)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[25, 123, 7]]}], "Mbpp/142": [{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts items identical in the same position across three lists.\n\n    Args:\n        list1, list2, list3: sequences of equal length supporting indexing and equality.\n\n    Returns:\n        int: number of positions i where list1[i] == list2[i] == list3[i].\n\n    Raises:\n        TypeError: if any input is None or does not support len()/indexing.\n        ValueError: if the input sequences have differing lengths.\n    \"\"\"\n    # Basic validation\n    if list1 is None or list2 is None or list3 is None:\n        raise TypeError(\"Input lists must not be None\")\n\n    try:\n        len1 = len(list1)\n        len2 = len(list2)\n        len3 = len(list3)\n    except TypeError:\n        raise TypeError(\"Inputs must be sequence types supporting len()\")\n\n    if not (len1 == len2 == len3):\n        raise ValueError(\"All input lists must have the same length\")\n\n    count = 0\n    for i in range(len1):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n\n    return count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 4, 5], [5, 4, 3, 2, 1], [1, 2, 3, 4, 5, 6]]]}], "Mbpp/140": [{"task_id": "Mbpp/140", "solution": "def extract_singly(items):\n    \"\"\"\n    Flattens an iterable of iterables into a single list of unique numbers,\n    preserving first-seen order.\n\n    Example:\n        assert set(extract_singly([(3, 4, 5), (4, 5, 7), (1, 4)])) == set([3, 4, 5, 7, 1])\n    \"\"\"\n    from typing import Iterable, Iterator, List, Any, Optional\n    from abc import ABC, abstractmethod\n\n    # --- Exceptions ---\n    class ExtractionError(Exception):\n        \"\"\"Domain-specific exception for extraction failures.\"\"\"\n\n        def __init__(self, message: str, cause: Exception = None):\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    # --- Utils ---\n    class InputValidator:\n        \"\"\"Validates input structure and element types.\"\"\"\n\n        def __init__(self, allow_non_numeric: bool = False):\n            self._allow_non_numeric = allow_non_numeric\n\n        def validate_iterable_of_iterables(self, items_to_validate: Any) -> None:\n            \"\"\"Ensures the input is an iterable of iterables containing only numbers.\"\"\"\n            try:\n                iter(items_to_validate)\n            except TypeError:\n                raise ExtractionError(\"Top-level items must be iterable\")\n\n            for idx, inner in enumerate(items_to_validate):\n                try:\n                    iter(inner)\n                except TypeError:\n                    raise ExtractionError(f\"Element at index {idx} is not iterable\")\n                for jdx, v in enumerate(inner):\n                    if not self._allow_non_numeric and not self._is_number(v):\n                        raise ExtractionError(f\"Non-numeric element at {idx}.{jdx}: {v}\")\n\n        def _is_number(self, value: Any) -> bool:\n            \"\"\"Checks if a value is a number (int or float, excluding bool).\"\"\"\n            return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    # --- Core Service ---\n    DEFAULT_MODE = \"list\"\n\n    class FlattenerService:\n        \"\"\"Performs the flattening and deduplication algorithm.\"\"\"\n\n        def __init__(self, remove_duplicates: bool = True):\n            self._remove_duplicates = remove_duplicates\n\n        def extract(self, items_to_extract: Iterable[Iterable[float]]) -> List[float]:\n            \"\"\"Eagerly flattens items, preserves first-seen order, and returns unique elements.\"\"\"\n            try:\n                seen = set()\n                result: List[float] = []\n                for inner in items_to_extract:\n                    for v in inner:\n                        if self._remove_duplicates:\n                            if v not in seen:\n                                seen.add(v)\n                                result.append(v)\n                        else:\n                            result.append(v)\n                return result\n            except Exception as e:\n                raise ExtractionError(\"Failed to extract items\") from e\n\n        def iter_extract(self, items_to_extract: Iterable[Iterable[float]]) -> Iterator[float]:\n            \"\"\"Lazily yields unique elements in first-seen order.\"\"\"\n            try:\n                seen = set()\n                for inner in items_to_extract:\n                    for v in inner:\n                        if self._remove_duplicates:\n                            if v not in seen:\n                                seen.add(v)\n                                yield v\n                        else:\n                            yield v\n            except Exception as e:\n                raise ExtractionError(\"Failed during lazy extraction\") from e\n\n    # --- Models ---\n    class ExtractionResult:\n        \"\"\"Data transfer object for flattened results.\"\"\"\n\n        def __init__(self, items: List[float]) -> None:\n            self.items = items\n\n    # --- Repository ---\n    class Repository(ABC):\n        \"\"\"Abstract interface for persisting ExtractionResult.\"\"\"\n\n        @abstractmethod\n        def persist(self, result: ExtractionResult) -> None:\n            pass\n\n    class NoOpRepository(Repository):\n        \"\"\"A no-operation repository implementation.\"\"\"\n\n        def __init__(self) -> None:\n            pass\n\n        def persist(self, result: ExtractionResult) -> None:\n            pass  # No operation\n\n    # --- Controllers ---\n    class ExtractionController:\n        \"\"\"Orchestrates validation, service calls, and optional persistence.\"\"\"\n\n        def __init__(self, service: FlattenerService, validator: InputValidator, repo: Optional[Repository] = None):\n            self.service = service\n            self.validator = validator\n            self.repo = repo\n\n        def handle(self, items_to_handle: Iterable[Iterable[float]], mode: str = DEFAULT_MODE) -> Iterable[float]:\n            \"\"\"\n            Validates inputs, calls service to extract, optionally persists, and returns the result.\n            Materialize the input to a list to allow validation and multiple passes.\n            \"\"\"\n            materialized = list(items_to_handle)\n            self.validator.validate_iterable_of_iterables(materialized)\n            if mode == \"list\":\n                result_list = self.service.extract(materialized)\n                if self.repo:\n                    self.repo.persist(ExtractionResult(result_list))\n                return result_list\n            elif mode == \"set\":\n                result_set = set(self.service.extract(materialized))\n                if self.repo:\n                    self.repo.persist(ExtractionResult(list(result_set)))\n                return result_set\n            elif mode == \"iterator\":\n                iterator = self.service.iter_extract(materialized)\n                if self.repo:\n                    snapshot = list(iterator)\n                    self.repo.persist(ExtractionResult(snapshot))\n                    return iter(snapshot)\n                return iterator\n            else:\n                raise ExtractionError(f\"Unsupported mode: {mode}\")\n\n    # Instantiate defaults and execute\n    validator = InputValidator()\n    service = FlattenerService()\n    controller = ExtractionController(service=service, validator=validator, repo=NoOpRepository())\n    return controller.handle(items, mode=DEFAULT_MODE)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[2, 3], [2, 3], [], [4, 5], [], [false, false, true, false]]]]}], "Mbpp/145": [{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(values):\n    \"\"\"Calculates the maximum difference between any two elements in a sequence.\n    It computes the difference between the maximum and minimum values in the input.\n    \"\"\"\n    max_val = max(values)\n    min_val = min(values)\n    return max_val - min_val", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "from typing import Any, List, Set\ndef remove_elements(source: List[Any], to_remove: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    Preserves the original order of elements from the source list.\n    \"\"\"\n    def _is_hashable(obj: Any) -> bool:\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    lookup_set: Set[Any] = set()\n    can_use_set = True\n\n    for item in to_remove:\n        if not _is_hashable(item):\n            can_use_set = False\n            break\n        lookup_set.add(item)\n\n    result: List[Any] = []\n\n    if can_use_set:\n        # Optimized path: use the set for O(1) average time complexity membership checks.\n        for item in source:\n            if item not in lookup_set:\n                result.append(item)\n    else:\n        # Fallback path: perform O(N) list scan for each item if unhashable elements exist.\n        lookup_list = list(to_remove)\n        for item in source:\n            is_present = False\n            for r_item in lookup_list:\n                if item == r_item:\n                    is_present = True\n  