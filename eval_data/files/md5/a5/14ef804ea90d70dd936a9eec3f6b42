om exception for errors during angle computation.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # Configuration constant\n    ZERO_ANGLE_ON_ZERO: bool = True\n\n    class ComplexNumber:\n        \"\"\"Immutable value object representing a complex number with float parts.\"\"\"\n        def __init__(self, real_val, imag_val) -> None:\n            try:\n                _real = float(real_val)\n                _imag = float(imag_val)\n            except (TypeError, ValueError) as e:\n                raise InvalidComplexError(f\"Complex parts must be convertible to float: {e}\") from e\n\n            if not (math.isfinite(_real) and math.isfinite(_imag)):\n                raise InvalidComplexError(\"Complex parts must be finite numbers.\")\n\n            self._real = _real\n            self._imag = _imag\n\n        def real(self) -> float:\n            return self._real\n\n        def imag(self) -> float:\n            return self._imag\n\n        def as_tuple(self) -> tuple[float, float]:\n            return (self._real, self._imag)\n\n    class ComplexFactory:\n        \"\"\"Factory to create ComplexNumber instances from flexible inputs.\"\"\"\n        @classmethod\n        def from_parts(cls, re_part, im_part) -> ComplexNumber:\n            # Special handling for (0, 1j) where 'im_part' is a complex literal\n            if isinstance(re_part, (int, float)) and isinstance(im_part, complex) and re_part == 0:\n                # Interpret the pair as the complex number represented by 'im_part'\n                return ComplexNumber(im_part.real, im_part.imag)\n\n            # For all other cases, treat as standard (real_part, imag_part) pair\n            return ComplexNumber(re_part, im_part)\n\n    class AngleService:\n        \"\"\"Service to perform mathematical computation of the angle.\"\"\"\n        def compute_angle(self, cn: ComplexNumber) -> float:\n            try:\n                real_part, imag_part = cn.real(), cn.imag()\n                if ZERO_ANGLE_ON_ZERO and real_part == 0.0 and imag_part == 0.0:\n                    return 0.0\n                return math.atan2(imag_part, real_part)\n            except Exception as e:\n                raise ComplexAngleError(f\"Angle computation failed: {e}\") from e\n\n    # Main logic for the angle_complex function\n    cn = ComplexFactory.from_parts(re, im)\n    return AngleService().compute_angle(cn)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["2.0", "1j"]], "plus_fail_tests": [["1e-100", "1e-100j"]]}], "Mbpp/125": [{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s\n    in any substring of the given binary string using Kadane's algorithm.\n    \"\"\"\n    max_so_far = 0\n    current_max = 0\n\n    if not s:\n        return 0\n\n    for char in s:\n        # Map '0' to +1 and '1' to -1 for sum calculation.\n        val = 1 if char == \"0\" else -1\n\n        # Kadane's algorithm logic:\n        if current_max + val < val:\n            current_max = val\n        else:\n            current_max += val\n\n        # Update the overall maximum difference found so far.\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    # The result is implicitly clamped to 0 because max_so_far is initialized to 0\n    # and only updated with positive current_max values.\n    return max_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/130": [{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list,\n    breaking ties by choosing the smallest item.\n    \"\"\"\n    if not items:\n        raise ValueError(\"items must be non-empty\")\n\n    # Count frequencies of each item\n    counts = {}\n    for item in items:\n       