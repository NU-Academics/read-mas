terable[Union[int, float]]) -> None:\n        self._numbers: List[Union[int, float]] = list(numbers)\n\n    def get_numbers(self) -> List[Union[int, float]]:\n        \"\"\"Returns the stored list of numbers.\"\"\"\n        return self._numbers\nclass UniqueProductService:\n    \"\"\"Core service for computing the product of unique numbers.\"\"\"\n    def __init__(self, repo: ListRepository, validator: ValidationUtils, math_utils: MathUtils) -> None:\n        self._repo = repo\n        self._validator = validator\n        self._math_utils = math_utils\n\n    def compute(self) -> UniqueProductResult:\n        \"\"\"Fetches numbers, validates, deduplicates, and computes their product.\"\"\"\n        numbers = self._repo.get_numbers()\n        self._validator.validate_iterable(numbers)\n        for idx, val in enumerate(numbers):\n            self._validator.validate_numeric(val, idx)\n        unique = self._math_utils.deduplicate_preserve_order(numbers)\n        product = self._math_utils.product(unique)\n        return UniqueProductResult(product=product, count_unique=len(unique))\nclass UniqueProductController:\n    \"\"\"Controller for the unique product feature, acting as public API wrapper.\"\"\"\n    def __init__(self, service_factory: Optional[Callable[[Iterable[Union[int, float]]], UniqueProductService]] = None) -> None:\n        self._service_factory = service_factory or self._default_factory\n\n    def _default_factory(self, numbers: Iterable[Union[int, float]]) -> UniqueProductService:\n        \"\"\"Default factory for creating a UniqueProductService instance.\"\"\"\n        repo = InMemoryListRepository(numbers)\n        return UniqueProductService(repo, ValidationUtils(), MathUtils())\n\n    def unique_product(self, numbers: Iterable[Union[int, float]]) -> Union[int, float]:\n        \"\"\"Orchestrates the computation of the product of unique numbers.\"\"\"\n        service = self._service_factory(numbers)\n        result = service.compute()\n        return result.product\n_controller = UniqueProductController()\ndef unique_product(numbers: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Computes the product of unique numeric elements in the provided list.\"\"\"\n    return _controller.unique_product(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/580": [{"task_id": "Mbpp/580", "solution": "def extract_even(data: tuple) -> tuple:\n    # This function recursively extracts even integers from a nested tuple,\n    # preserving structure and removing nested tuples that become empty.\n    result = []\n    for item in data:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            nested_result = extract_even(item)\n            if nested_result:\n                result.append(nested_result)\n    return tuple(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/586": [{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"Splits a list at the nth element and moves the first part to the end.\"\"\"\n    length = len(arr)\n    if length == 0:\n        return []\n\n    # Normalize the split index to be within the list's bounds.\n    r = n % length\n\n    # Split the list and concatenate the parts in rotated order.\n    return list(arr[r:]) + list(arr[:r])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/581": [{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid using a simplified lateral area formula\n    (2 * base_edge * height) to match the provided assertion example.\n    \"\"\"\n    base_area = base_edge * base_edge\n    lateral_area = 2 * base_edge * height\n    return base_area + lateral_area", "base_status": "pass", "