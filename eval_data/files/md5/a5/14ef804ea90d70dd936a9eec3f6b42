ask_id": "Mbpp/448", "solution": "from typing import Optional, Dict\nDEFAULT_CACHE_PREPOPULATE = {0: 3, 1: 0, 2: 2}\nclass CacheRepository:\n    \"\"\"\n    Manages an in-memory cache for Perrin numbers.\n    It stores and retrieves previously computed terms.\n    \"\"\"\n    def __init__(self) -> None:\n        self._cache: Dict[int, int] = dict(DEFAULT_CACHE_PREPOPULATE)\n\n    def get(self, index: int) -> Optional[int]:\n        \"\"\"Retrieves a Perrin term from the cache.\"\"\"\n        return self._cache.get(index)\n\n    def set(self, index: int, value: int) -> None:\n        \"\"\"Stores a Perrin term in the cache.\"\"\"\n        self._cache[index] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears the cache, re-populating with default base cases.\"\"\"\n        self._cache = dict(DEFAULT_CACHE_PREPOPULATE)\n\n    def to_dict(self) -> Dict[int, int]:\n        \"\"\"Returns a shallow copy of the internal cache dictionary.\"\"\"\n        return dict(self._cache)\n\n    def load_from_dict(self, d: Dict[int, int]) -> None:\n        \"\"\"Loads values into the cache from a dictionary.\"\"\"\n        self._cache.update(d)\nclass PerrinService:\n    \"\"\"\n    Computes Perrin numbers and their sums, leveraging a cache.\n    The sequence is P(0)=3, P(1)=0, P(2)=2, and P(n)=P(n-2)+P(n-3) for n>=3.\n    \"\"\"\n    def __init__(self, cache_repo: CacheRepository) -> None:\n        self._cache_repo = cache_repo\n\n    def compute_term(self, k: int) -> int:\n        \"\"\"\n        Calculates the k-th Perrin number, using the cache if available.\n        If not in cache, it computes iteratively and stores the result.\n        \"\"\"\n        cached = self._cache_repo.get(k)\n        if cached is not None:\n            return cached\n\n        value = self._compute_term_iterative(k)\n        self._cache_repo.set(k, value)\n        return value\n\n    def _compute_term_iterative(self, k: int) -> int:\n        \"\"\"\n        Internal method to iteratively calculate the k-th Perrin number.\n        This uses a rolling window approach for efficiency.\n        \"\"\"\n        if k == 0: return 3\n        if k == 1: return 0\n        if k == 2: return 2\n\n        # Initialize with P(0), P(1), P(2)\n        # a = P(i-3), b = P(i-2), c = P(i-1)\n        a, b, c = 3, 0, 2\n\n        for i in range(3, k + 1):\n            next_val = a + b # P(i) = P(i-3) + P(i-2)\n            a, b, c = b, c, next_val # Shift values for next iteration\n\n        return c # c will hold P(k) upon loop completion\n\n    def compute_sum(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of Perrin numbers from P(0) up to P(n) inclusive.\n        It iteratively calls compute_term for each number and sums them up.\n        \"\"\"\n        total = 0\n        for k in range(0, n + 1):\n            total += self.compute_term(k)\n        return total\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    It uses an in-memory cache to optimize computations.\n    \"\"\"\n    repo = CacheRepository()\n    service = PerrinService(repo)\n    return service.compute_sum(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/447": [{"task_id": "Mbpp/447", "solution": "def cube_nums(numbers):\n    \"\"\"\n    Computes the cube of each numeric element in the input list.\n    Assumes valid numeric inputs and returns results as floats/ints depending on inputs.\n    \"\"\"\n    return [x * x * x for x in numbers]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2.5, 3, -4.7, 5, 6, 7, -8.9]]]}], "Mbpp/453": [{"task_id": "Mbpp/453", "solution": "from math import isqrt\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\nclass InternalComputationError(RuntimeError):\n    \"\"\"Exception raised for unexpected errors during internal computation.\"\"\"\n    pass\nclass FactorizationResult:\n    \"\"\"Represents the prime factorization of a number.\"\"\"\n    def __init__(self, primes: dict[int, int]) -> None:\n        self.primes = dict(primes)\n\n    def total_factors(self) -> int:\n        prod = 1\n        for e in self.primes.values():\n            prod *= (e + 1)\n        return prod\n\n    def __repr__(self) -> str:\n        return f\"FactorizationResult({self.primes})\"\ndef validate_positive_int(value) -> int:\n    \"\"\"Validates if a value is a positive integer and returns it.\"\"\"\n    try:\n        n = int(value)\n    except Exception:\n        raise InvalidInputError(\"must be an integer\")\n    if n < 1:\n        raise InvalidInputError(\"must be >= 1\")\n    return n\nclass PrimeFactorizer:\n    \"\"\"Service to compute prime factorization of an integer.\"\"\"\n    MAX_TRIAL = 10**6\n\n    def factorize(self, n: int) -> FactorizationResult:\n        if n < 1:\n            raise InternalComputationError(\"n must be >= 1\")\n\n        factors = {}\n        # handle 2\n        while n % 2 == 0:\n            factors[2] = factors.get(2, 0) + 1\n            n //= 2\n\n        # handle odd factors\n        i = 3\n        limit = isqrt(n)\n        while i <= limit and n > 1:\n            while n % i == 0:\n                factors[i] = factors.get(i, 0) + 1\n                n //= i\n                limit = isqrt(n) # Recalculate limit as n has changed\n            i += 2 # Move to next odd number\n\n        if n > 1: # Remaining n is a prime factor itself\n            factors[n] = factors.get(n, 0) + 1\n        return FactorizationResult(factors)\nclass DivisorSumService:\n    \"\"\"Service to compute sum of divisors from prime factors.\"\"\"\n    def _prime_power_sum(self, p: int, e: int) -> int:\n        \"\"\"Calculates the sum of powers of a prime p up to exponent e.\"\"\"\n        return (p**(e + 1) - 1) // (p - 1)\n\n    def sum_of_divisors(self, factors: dict[int, int]) -> int:\n        \"\"\"Computes the sum of all divisors from a prime factorization.\"\"\"\n        total = 1\n        for p, e in factors.items():\n            total *= self._prime_power_sum(p, e)\n        return total\n\n    def sum_of_odd_divisors(self, factors: dict[int, int]) -> int:\n        \"\"\"Computes the sum of odd divisors from a prime factorization.\"\"\"\n        total = 1\n        for p, e in factors.items():\n            if p == 2:\n                continue # Exclude the prime factor 2 for odd divisors\n            total *= self._prime_power_sum(p, e)\n        return total\nclass EvenFactorSumService:\n    \"\"\"Service to compute the sum of even factors using factorization and divisor sum services.\"\"\"\n    def __init__(self, factorizer: PrimeFactorizer, divisor_service: DivisorSumService) -> None:\n        self.factorizer = factorizer\n        self.divisor_service = divisor_service\n\n    def sum_even_factors(self, n: int) -> int:\n        \"\"\"Calculates the sum of even factors for a given number.\"\"\"\n        if n % 2 == 1:\n            return 0 # Odd numbers have no even factors\n\n        fact = self.factorizer.factorize(n)\n        total = self.divisor_service.sum_of_divisors(fact.primes)\n        odd_sum = self.divisor_service.sum_of_odd_divisors(fact.primes)\n\n        # Sum of even factors = (Sum of all factors) - (Sum of odd factors)\n        return total - odd_sum\n_default_service = EvenFactorSumService(PrimeFactorizer(), DivisorSumService())\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors for a given positive integer.\n    The input `n` must be a positive integer.\n    \"\"\"\n    n = validate_positive_int(n)\n    return _default_service.sum_even_factors(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[false]]}], "Mbpp/454": [{"task_id": "Mbpp/454", "solution": "import re\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the given text contains any word w