ctmethod\nfrom typing import Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\ndef validate_index(n) -> int:\n    \"\"\"Validates if n is a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(f\"Index must be int, got {type(n).__name__}\")\n    if n < 0:\n        raise InvalidInputError(\"Index must be non-negative\")\n    return n\nclass CacheAdapter:\n    \"\"\"Abstract base class for a cache adapter.\"\"\"\n    def get(self, key: int) -> Optional[int]:\n        raise NotImplementedError\n    def set(self, key: int, value: int) -> None:\n        raise NotImplementedError\n    def clear(self) -> None:\n        raise NotImplementedError\nclass InMemoryCache(CacheAdapter):\n    \"\"\"In-memory dictionary-based cache.\"\"\"\n    def __init__(self):\n        self._store = {}\n    def get(self, key: int) -> Optional[int]:\n        return self._store.get(key)\n    def set(self, key: int, value: int) -> None:\n        self._store[key] = value\n    def clear(self) -> None:\n        self._store.clear()\nclass LucasCalculator(ABC):\n    \"\"\"Abstract base class for Lucas number calculators.\"\"\"\n    @abstractmethod\n    def compute(self, n: int) -> int:\n        ...\nclass IterativeCalculator(LucasCalculator):\n    \"\"\"Calculates Lucas numbers iteratively.\"\"\"\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\nclass RecursiveMemoCalculator(LucasCalculator):\n    \"\"\"Calculates Lucas numbers recursively with memoization.\"\"\"\n    def __init__(self, cache: CacheAdapter):\n        self._cache = cache\n\n    def compute(self, n: int) -> int:\n        cached = self._cache.get(n)\n        if cached is not None:\n            return cached\n        result = self._compute_recursive(n)\n       