vice = TetrahedralService(algorithm=selected_alg, cache=cache_instance)\n    controller = TetrahedralController(service=service)\n\n    return controller.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/86": [{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Calculate the nth centered hexagonal number using the formula: H(n) = 3*n*(n-1) + 1.\n    \"\"\"\n    return 3 * n * (n - 1) + 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/87": [{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(d1: dict, d2: dict, d3: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary using a \"first-wins\" strategy for conflicting keys.\n    Values from d1 take precedence over d2, and d2 values take precedence over d3.\n    \"\"\"\n    return {**d3, **d2, **d1}", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/88": [{"task_id": "Mbpp/88", "solution": "def freq_count(items: \"Iterable[Any]\") -> \"Dict[Any, int]\":\n    \"\"\"\n    Computes the frequency of all elements in an iterable, returning a dictionary.\n    Unhashable elements like lists, dictionaries, or sets are converted to hashable representations.\n    \"\"\"\n    def normalize_key(item: \"Any\") -> \"Any\":\n        \"\"\"Converts unhashable items to a stable, hashable representation for counting.\"\"\"\n        if isinstance(item, list):\n            return tuple(normalize_key(x) for x in item)\n        elif isinstance(item, dict):\n            # Sort items by their normalized key-value pairs to ensure a consistent, hashable representation.\n            return tuple(sorted(((normalize_key(k), normalize_key(v)) for k, v in item.items())))\n        elif isinstance(item, set):\n            return frozenset(normalize_key(x) for x in item)\n        try:\n            hash