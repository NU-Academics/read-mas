es whether the given square matrix is a magic square.\n    A classic magic square contains numbers 1 to n^2 exactly once,\n    and all row, column, and main diagonal sums equal the magic constant.\n    \"\"\"\n    n = len(matrix)\n\n    # A magic square must be non-empty and square.\n    if n == 0 or any(len(row) != n for row in matrix):\n        return False\n\n    # Calculate the magic constant for an n x n square.\n    magic_constant = n * (n * n + 1) // 2\n\n    # Flatten the matrix to check for unique numbers from 1 to n*n.\n    flat_list = [num for row in matrix for num in row]\n\n    # Ensure all numbers from 1 to n*n are present exactly once.\n    expected_numbers = set(range(1, n * n + 1))\n    actual_numbers = set(flat_list)\n    if actual_numbers != expected_numbers or len(flat_list) != n * n:\n        return False\n\n    # Check sums of all rows.\n    for i in range(n):\n        if sum(matrix[i]) != magic_constant:\n            return False\n\n    # Check sums of all columns.\n    for j in range(n):\n        column_sum = 0\n        for i in range(n):\n            column_sum += matrix[i][j]\n        if column_sum != magic_constant:\n            return False\n\n    # Check sum of the primary diagonal (top-left to bottom-right).\n    primary_diagonal_sum = 0\n    for i in range(n):\n        primary_diagonal_sum += matrix[i][i]\n    if primary_diagonal_sum != magic_constant:\n        return False\n\n    # Check sum of the secondary diagonal (top-right to bottom-left).\n    secondary_diagonal_sum = 0\n    for i in range(n):\n        secondary_diagonal_sum += matrix[i][n - 1 - i]\n    if secondary_diagonal_sum != magic_constant:\n        return False\n\n    # If all checks pass, it is a magic square.\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[7, 7], [7, 7]]]]}], "Mbpp/137": [{"task_id": "Mbpp/137", "solution": "def zero_count(arr):\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes 