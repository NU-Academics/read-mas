    return arr_segment, 0\n\n        mid = n // 2\n        left_half, left_inv = _merge_sort_and_count(arr_segment[:mid])\n        right_half, right_inv = _merge_sort_and_count(arr_segment[mid:])\n\n        merged_array, cross_inv = _merge_and_count(left_half, right_half)\n\n        return merged_array, left_inv + right_inv + cross_inv\n\n    def _merge_and_count(left, right):\n        \"\"\"Merges two sorted arrays and counts inversions between them.\"\"\"\n        merged = []\n        i, j = 0, 0\n        inversions = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n                inversions += (len(left) - i)\n\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n\n        return merged, inversions\n\n    _, total_inversions = _merge_sort_and_count(list(arr))\n    return total_inversions", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary.\n    A flat dictionary has a depth of 1.\n    \"\"\"\n    def _calculate_depth_recursive(current_dict: dict, current_depth: int) -> int:\n        max_depth_found = current_depth\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                nested_depth = _calculate_depth_recursive(value, current_depth + 1)\n                if nested_depth > max_depth_found:\n                    max_depth_found = nested_depth\n        return max_depth_found\n\n    return _calculate_depth_recursive(d, 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/311": [{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the left-most (most-significant) unset bit in a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    def _highest_set_bit(num: int) -> int:\n        \"\"\"Returns the index of the highest set bit, or -1 if num is 0.\"\"\"\n        return num.bit_length() - 1\n\n    def _is_bit_set(num: int, idx: int) -> bool:\n        \"\"\"Checks if the bit at the given index is set in num.\"\"\"\n        return (num >> idx) & 1 == 1\n\n    def _set_bit(num: int, idx: int) -> int:\n        \"\"\"Returns num with the bit at the given index set.\"\"\"\n        return num | (1 << idx)\n\n    def _find_left_most_unset_bit_index(num: int) -> int:\n        \"\"\"Finds the index of the left-most unset bit according to problem definition.\"\"\"\n        if num == 0:\n            return 0\n\n        h = _highest_set_bit(num)\n\n        for idx in range(h, -1, -1):\n            if not _is_bit_set(num, idx):\n                return idx\n\n        # If all bits from h down to 0 are set, the next higher bit is the left-most unset.\n        return h + 1\n\n    unset_bit_index = _find_left_most_unset_bit_index(n)\n    return _set_bit(n, unset_bit_index)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[15]], "plus_fail_tests": [[255]]}], "Mbpp/309": [{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"Return the greater of two numbers as a float.\"\"\"\n    return float(a) if a >= b else float(b)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-9876543210987654321098765, -1234567890123456789012345]]}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that must include arr[k] where k > i. Returns the maximum sum (int).\n\n    Preconditions:\n      - arr is a list of integers\n      - n == len(arr)\n      - 0 <= i < n\n      - 0 <= k < n\n      - k > i\n\n    The subsequence is formed by an increasing subsequence entirely taken\n    from the prefix arr[0..i] (possibly empty) that ends with a value < arr[k],\n    followed by arr[k]. If no prefix element is < arr[k], the result is arr[k].\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if n != len(arr):\n        raise ValueError(\"n must be equal to len(arr)\")\n    if not (0 <= i < n):\n        raise IndexError(\"i out of valid range\")\n    if not (0 <= k < n):\n        raise IndexError(\"k out of valid range\")\n    if not (k > i):\n        raise ValueError(\"k must be greater than i\")\n\n    # Edge case: prefix length\n    prefix_len = i + 1\n    # dp_sums[j] = maximum sum of increasing subsequence ending at index j (considering arr[0..j])\n    dp_sums = [0] * prefix_len\n\n    # Compute MSIS (maximum sum increasing subsequence) for prefix arr[0..i]\n    for j in range(prefix_len):\n        dp_sums[j] = arr[j]\n        for p in range(j):\n            if arr[j] > arr[p] and dp_sums[j] < dp_sums[p] + arr[j]:\n                dp_sums[j] = dp_sums[p] + arr[j]\n\n    target = arr[k]\n    best_prefix_sum = None\n\n    # Find best prefix sum among indices j in [0..i] with arr[j] < arr[k]\n    for j in range(prefix_len):\n        if arr[j] < target:\n            if best_prefix_sum is None or dp_sums[j] > best_prefix_sum:\n                best_prefix_sum = dp_sums[j]\n\n    if best_prefix_sum is None:\n        return target\n    return best_prefix_sum + target", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/310": [{"task_id": "Mbpp/310", "solution": "def string_to_tuple(value: str, ignore_whitespace: bool = True) -> tuple[str, ...]:\n    \"\"\"Converts a string into a tuple of its characters.\n\n    Whitespace characters are ignored by default but can be