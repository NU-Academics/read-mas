{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input: str) -> str:\n    \"\"\"Removes all whitespace characters from a string.\"\"\"\n    class WhitespaceRemover:\n        def removeAllSpaces(self, input: str) -> str:\n            # Iterates through the input string and joins all non-whitespace characters.\n            return ''.join(ch for ch in input if not ch.isspace())\n\n    remover = WhitespaceRemover()\n    return remover.removeAllSpaces(input)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number, d):\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by `d` positions, wrapping around.\n    The number is assumed to be an unsigned 32-bit integer.\n    \"\"\"\n    INT_BITS = 32\n    MAX_32BIT = (1 << INT_BITS) - 1\n\n    # Normalize the rotation amount to be within 0 to INT_BITS-1.\n    d_effective = d % INT_BITS\n\n    # Perform the left rotation: (bits shifted left) | (bits wrapped around from MSB to LSB).\n    # The final result is masked to ensure it remains a 32-bit number.\n    return ((number << d_effective) | (number >> (INT_BITS - d_effective))) & MAX_32BIT"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Counts the number of equal integers among three given numbers.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or b == c or a == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square using only integer arithmetic.\n    It employs a binary search approach to find the integer square root.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    low = 1\n    high = number  # The square root of 'number' cannot exceed 'number' itself.\n\n    while low <= high:\n        mid = (low + high) // 2\n        mid_squared = mid * mid\n\n        if mid_squared == number:\n            return True\n        elif mid_squared < number:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return False"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if any number in the list is even, False otherwise.\n    \"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Returns the sub-list from a list of lists whose sum of elements is the highest.\n    If multiple lists have the same highest sum, the first one encountered is returned.\n    \"\"\"\n    if not lists:\n        return []\n\n    max_sum = float('-inf')\n    max_list = []\n\n    for current_list in lists:\n        current_sum = sum(current_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = current_list\n            \n    return max_list"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_str: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_str:\n        if 'A' <= char <= 'Z':  # Check if the character is an uppercase ASCII letter\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    max_run = max(max_run, current_run)  # Check for a run ending at the string's end\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a list of integers.\n    Returns the odd number or None if no odd numbers are found.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
