{"task_id": "Mbpp/67", "solution": "class BellCalculator:\n    \"\"\"\n    Computes Bell numbers using the Bell triangle recurrence.\n    \"\"\"\n\n    def bellNumber(self, n: int) -> int:\n        if n == 0:\n            return 1\n        triangle = [1]\n        for i in range(1, n + 1):\n            row = [triangle[-1]]\n            for j in range(i):\n                row.append(row[-1] + triangle[j])\n            triangle = row\n        return triangle[0]\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Return the nth Bell number.\n    \"\"\"\n    return BellCalculator().bellNumber(n)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if the given array is monotonic (non-decreasing or non-increasing).\n    An array with less than two elements is considered monotonic.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return True\n\n    # Determine the initial trend of the array.\n    direction = 0  # 0: unknown, 1: increasing, -1: decreasing\n    i = 0\n    while i < n - 1:\n        if array[i] < array[i+1]:\n            direction = 1  # Found an increasing trend\n            break\n        elif array[i] > array[i+1]:\n            direction = -1 # Found a decreasing trend\n            break\n        i += 1\n    \n    # If the loop finished, all elements were equal (e.g., [1, 1, 1]), which is monotonic.\n    if i == n - 1:\n        return True\n\n    # Check if the rest of the array follows the established trend.\n    while i < n - 1:\n        if direction == 1: # Expecting a non-decreasing sequence\n            if array[i] > array[i+1]:\n                return False\n        elif direction == -1: # Expecting a non-increasing sequence\n            if array[i] < array[i+1]:\n                return False\n        i += 1\n    \n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(mainList, subList):\n    \"\"\"\n    Checks if a list contains the given sublist as a contiguous subsequence.\n    Returns True if subList is empty as per business rules.\n    \"\"\"\n    len_main = len(mainList)\n    len_sub = len(subList)\n\n    if len_sub == 0:\n        return True\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if mainList[i:i + len_sub] == subList:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/71", "solution": "from __future__ import annotations\nfrom typing import List, TypeVar, Iterable\n\nT = TypeVar('T')\n\nclass CombSortAlgorithm:\n    \"\"\"\n    Comb Sort algorithm implementation.\n    \"\"\"\n    @staticmethod\n    def comb_sort(items: List[T]) -> List[T]:\n        \"\"\"\n        Return a new list sorted in ascending order using Comb Sort.\n        The original list is not modified.\n        \"\"\"\n        # Work on a copy to preserve the original list\n        arr = list(items)\n        n = len(arr)\n        gap = n\n        shrink = 1.3\n        swapped = True\n\n        while gap > 1 or swapped:\n            # Update the gap value for next comb\n            gap = int(gap / shrink)\n            if gap < 1:\n                gap = 1\n\n            swapped = False\n            for i in range(n - gap):\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n\n        return arr\n\ndef comb_sort(items: Iterable[T]) -> List[T]:\n    \"\"\"\n    Public function that delegates to CombSortAlgorithm.comb_sort.\n    Accepts any iterable of comparable elements.\n    \"\"\"\n    return CombSortAlgorithm.comb_sort(list(items))"}
