{"task_id": "Mbpp/793", "solution": "def last(arr: list, element: int) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == element:\n            result = mid\n            low = mid + 1  # Look for further occurrences in the right half\n        elif arr[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/792", "solution": "from typing import List, Any\n\ndef count_list(lists: List[List[Any]]) -> int:\n    \"\"\"\n    Counts the number of sublists in the provided list of lists.\n\n    Parameters\n    ----------\n    lists : List[List[Any]]\n        The outer list containing sublists.\n\n    Returns\n    -------\n    int\n        The number of sublists.\n\n    Raises\n    ------\n    TypeError\n        If any element of `lists` is not a list.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    for idx, sub in enumerate(lists):\n        if not isinstance(sub, list):\n            raise TypeError(f\"Element at index {idx} is not a list.\")\n\n    return len(lists)"}
