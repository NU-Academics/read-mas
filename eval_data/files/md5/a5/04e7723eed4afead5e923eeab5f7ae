{"task_id": "Mbpp/773", "solution": "import collections\nimport functools\nimport itertools\nimport math\nimport re\nimport sys\nfrom typing import Optional, Tuple\n\ndef occurance_substring(text: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (substring, start_index, length) or None if not found.\n    \"\"\"\n    if not isinstance(text, str) or not isinstance(substring, str):\n        # Assuming valid string inputs as per problem statement and context\n        # For robustness, error handling or specific type checks might be added.\n        # However, the prompt specifies \"No isinstance() checks\".\n        pass\n\n    index = text.find(substring)\n    if index != -1:\n        return (substring, index, len(substring))\n    else:\n        return None"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\nfrom typing import List\n\ndef find_sum(lst: List[int]) -> int:\n    \"\"\"\n    Finds the sum of non-repeated elements in a given list.\n    Returns 0 if the list is empty or contains no unique elements.\n    \"\"\"\n    if not lst:\n        return 0\n    freq = Counter(lst)\n    return sum(num for num, count in freq.items() if count == 1)"}
{"task_id": "Mbpp/778", "solution": "from typing import List, Any\n\ndef pack_consecutive_duplicates(lst: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Each sublist contains one or more identical elements that appeared consecutively.\n    \"\"\"\n    if not lst:\n        return []\n\n    result = []\n    current_sublist = [lst[0]]\n\n    for i in range(1, len(lst)):\n        if lst[i] == current_sublist[-1]:\n            current_sublist.append(lst[i])\n        else:\n            result.append(current_sublist)\n            current_sublist = [lst[i]]\n    \n    result.append(current_sublist)\n    \n    return result"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list):\n    \"\"\"\n    Computes element-wise sums for all unique pairs of tuples in the given list.\n    It returns a list of new tuples, where each is the sum of two original tuples.\n    \"\"\"\n    n = len(tuple_list)\n    result = []\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Extract the two tuples to be summed\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n\n            # Perform element-wise addition and create a new tuple\n            sum_tuple = tuple(x + y for x, y in zip(tuple1, tuple2))\n            result.append(sum_tuple)\n\n    return result"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a given positive integer is even.\n    This function assumes `number` is a positive integer.\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to the integer square root of the number\n    for i in range(1, math.isqrt(number) + 1):\n        if number % i == 0:\n            if i * i == number:\n                # If i is the square root, it is counted once\n                count += 1\n            else:\n                # Otherwise, i and number // i are two distinct divisors\n                count += 2\n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(list: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length contiguous subarrays of the given list.\"\"\"\n    total_sum = 0\n    n = len(list)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate the length of the current subarray\n            length = j - i + 1\n            \n            # If the length is odd, sum its elements\n            if length % 2 == 1:\n                for k in range(i, j + 1):\n                    total_sum += list[k]\n                    \n    return total_sum"}
{"task_id": "Mbpp/785", "solution": "import re\n\ndef tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual integer tuple.\n    Raises ValueError if the input string does not match the expected format.\"\"\"\n    # Regular expression to validate the tuple string format.\n    # It requires at least one integer inside the parentheses,\n    # and allows optional whitespace and comma-separated integers.\n    match = re.fullmatch(r\"^\\(\\s*\\d+\\s*(,\\s*\\d+\\s*)*\\)$\", tuple_str)\n\n    if not match:\n        raise ValueError(f\"Input string '{tuple_str}' does not match the expected tuple format.\")\n\n    # Remove the outer parentheses and strip any leading/trailing whitespace.\n    # The regex guarantees that this string will contain valid integer parts.\n    content_str = tuple_str.strip()[1:-1]\n\n    # Split the content by commas, strip whitespace from each resulting part,\n    # and convert each part to an integer. Finally, collect them into a tuple.\n    integer_strings = content_str.split(',')\n    result_tuple = tuple(int(s.strip()) for s in integer_strings)\n\n    return result_tuple"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\nclass NumberList:\n    \"\"\"Manages a list of numbers to find the first even and odd.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.list = numbers\n\n    def getFirstEven(self) -> int:\n        \"\"\"Finds the first even number in the list.\"\"\"\n        for num in self.list:\n            if num % 2 == 0:\n                return num\n        raise ValueError(\"No even number found\")\n\n    def getFirstOdd(self) -> int:\n        \"\"\"Finds the first odd number in the list.\"\"\"\n        for num in self.list:\n            if num % 2 != 0:\n                return num\n        raise ValueError(\"No odd number found\")\n\nclass ProductCalculator:\n    \"\"\"Calculates the product of the first even and odd numbers from a NumberList.\"\"\"\n    def calculate(self, numbers: NumberList) -> int:\n        even = numbers.getFirstEven()\n        odd = numbers.getFirstOdd()\n        return even * odd\n\ndef mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Compute the product of the first even and first odd integers in the list.\n    Raises ValueError if either an even or odd integer is missing.\n    \"\"\"\n    num_list = NumberList(numbers)\n    calculator = ProductCalculator()\n    return calculator.calculate(num_list)"}
