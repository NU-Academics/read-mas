{"task_id": "Mbpp/749", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass NumericString:\n    \"\"\"Represents a string that should contain an integer value.\"\"\"\n    value: str\n\n@dataclass\nclass IntegerNumber:\n    \"\"\"Represents an integer value extracted from a NumericString.\"\"\"\n    value: int\n\nclass NumericStringSorter:\n    \"\"\"Encapsulates the sorting logic for a list of NumericString objects.\"\"\"\n    @staticmethod\n    def sort(strings: List[NumericString]) -> List[IntegerNumber]:\n        # Convert each string to an IntegerNumber\n        ints = [IntegerNumber(int(s.value)) for s in strings]\n        # Sort by the integer value\n        ints.sort(key=lambda x: x.value)\n        return ints\n\ndef sort_numeric_strings(strings: List[str]) -> List[int]:\n    \"\"\"\n    Accepts a list of numeric strings, converts them to integers, sorts them,\n    and returns the sorted list of integers.\n    \"\"\"\n    numeric_strings = [NumericString(s) for s in strings]\n    sorted_numbers = NumericStringSorter.sort(numeric_strings)\n    return [n.value for n in sorted_numbers]"}
{"task_id": "Mbpp/753", "solution": "import heapq\n\ndef min_k(tuple_list, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples based on their value.\n    Uses heapq.nsmallest for efficient retrieval.\n    \"\"\"\n    return heapq.nsmallest(k, tuple_list, key=lambda x: x[1])"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    Uses J(n) = J(n-1) + 2*J(n-2) with base cases J(0)=0, J(1)=1.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n    \n    a, b = 0, 1 # a is J(i-2), b is J(i-1)\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Optional\n\ndef second_smallest(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Return the second distinct smallest integer from *numbers*.\n    Raises ValueError if the list contains fewer than two distinct values.\n    \"\"\"\n    min1 = min2 = None\n\n    for n in numbers:\n        if min1 is None or n < min1:\n            if n != min1: # Only shift min1 to min2 if n is a new distinct smallest\n                min2 = min1\n            min1 = n\n        elif n != min1 and (min2 is None or n < min2):\n            # n is greater than min1 but potentially smaller than min2, and is distinct from min1\n            min2 = n\n\n    if min2 is None:\n        raise ValueError(\"Not enough distinct values\")\n\n    return min2"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    The function returns a list of these common elements.\n    \"\"\"\n    common_elements = []\n    min_len = min(len(l1), len(l2), len(l3))\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap satisfies the property where the value of each parent node is\n    less than or equal to the values of its children nodes.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return True\n\n    # Iterate only up to the last parent node\n    # The last parent node is at index (n // 2) - 1 for a 0-indexed array\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child, if it exists\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings):\n    \"\"\"\n    Counts the number of distinct reverse string pairs in the given list of strings.\n    A pair (s1, s2) is counted if s1 is the reverse of s2, and s1 != s2.\n    \"\"\"\n    seen_unique_strings = set(strings)\n    pair_count = 0\n\n    for s in seen_unique_strings:\n        reverse_s = s[::-1]\n        # To avoid double-counting and handling palindromes:\n        # Only count a pair if the current string `s` is lexicographically smaller than its reverse.\n        # This ensures each unique pair is counted exactly once (e.g., \"best\", \"tseb\" will be counted\n        # when processing \"best\", but not again when processing \"tseb\").\n        # It also implicitly handles palindromes (s == reverse_s), as s < s is always false.\n        if s < reverse_s and reverse_s in seen_unique_strings:\n            pair_count += 1\n            \n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "import collections\n\ndef unique_sublists(input_list):\n    \"\"\"Counts the occurrences of unique sublists in a list, converting them to tuples.\"\"\"\n    counts = collections.Counter()\n    for sublist in input_list:\n        counts[tuple(sublist)] += 1\n    return dict(counts)"}
