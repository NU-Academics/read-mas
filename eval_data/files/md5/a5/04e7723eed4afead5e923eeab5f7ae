{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all unique words in a string that are at least 4 characters long.\n    Splits by whitespace, filters by length, and returns a set.\n    \"\"\"\n    words = input_string.split()\n    long_words = {word for word in words if len(word) >= 4}\n    return long_words"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers):\n    \"\"\"\n    Returns a new list containing the square of each element in the input list.\n    The input list remains unchanged.\n    \"\"\"\n    return [x * x for x in numbers]"}
{"task_id": "Mbpp/12", "solution": "from typing import List\n\ndef _compute_row_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"Computes the sum of each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef _stable_sort_rows(rows: List[List[int]], sums: List[int]) -> List[List[int]]:\n    \"\"\"Performs a stable sort on rows based on their corresponding sums.\"\"\"\n    # Pair rows with their sums and sort them based on the sum\n    paired_rows_with_sums = list(zip(rows, sums))\n    sorted_pairs = sorted(paired_rows_with_sums, key=lambda item: item[1])\n    # Extract the sorted rows from the pairs\n    return [row for row, _sum in sorted_pairs]\n\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Returns a new matrix, preserving the original.\n    \"\"\"\n    row_sums = _compute_row_sums(matrix)\n    sorted_rows = _stable_sort_rows(matrix, row_sums)\n    # Create a new matrix by shallow copying each row to ensure the returned structure is new.\n    return [row[:] for row in sorted_rows]"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(values: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n    return heapq.nlargest(n, values)"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    def __init__(self, base: float, height: float, length: float):\n        if base <= 0 or height <= 0 or length <= 0:\n            raise ValueError(\"Base, height, and length must be positive.\")\n        self.base = base\n        self.height = height\n        self.length = length\n\n    def computeVolume(self) -> float:\n        return 0.5 * self.base * self.height * self.length\n\ndef find_Volume(base: float, height: float, length: float) -> float:\n    prism = TriangularPrism(base, height, length)\n    return prism.computeVolume()"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive number of rotations to restore the original string.\n    Returns 1 for strings with all identical characters.\n    \"\"\"\n    n = len(s)\n\n    # Handles strings like \"aaaa\" and also the single character string \"a\".\n    if s.count(s[0]) == n:\n        return 1\n\n    double_s = s + s\n    for k in range(1, n + 1):\n        if double_s[k:k + n] == s:\n            return k"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is determined by XORing the numbers and counting the set bits.\n    \"\"\"\n    xor_result = a ^ b\n    return xor_result.bit_count() == 1"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n):\n    \"\"\"Checks if a number is not prime based on primality rules.\"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    limit = int(math.sqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/16", "solution": "import re\n\ndef text_lowercase_underscore(string):\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined with an underscore.\n    Returns True if the pattern matches, False otherwise.\n    \"\"\"\n    pattern = r\"^[a-z]+(_[a-z]+)*$\"\n    return bool(re.fullmatch(pattern, string))"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(firstString: str, secondString: str) -> str:\n    \"\"\"\n    Removes all characters from firstString that are present in secondString, preserving order.\n    \"\"\"\n    chars_to_remove = set(secondString)\n    result_chars = [ch for ch in firstString if ch not in chars_to_remove]\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/17", "solution": "class Square:\n    \"\"\"Represents a square with a given side length.\"\"\"\n\n    def __init__(self, side_length: float):\n        self.side_length = side_length\n\n    def perimeter(self) -> float:\n        \"\"\"Calculate the perimeter of the square.\"\"\"\n        return 4 * self.side_length\n\n\ndef square_perimeter(side_length: float) -> float:\n    \"\"\"\n    Compute the perimeter of a square. Raises ValueError if side_length is negative.\n    \"\"\"\n    if side_length < 0:\n        raise ValueError(\"Side length must be non\u2011negative.\")\n\n    square = Square(side_length)\n    return square.perimeter()"}
