          changes_count += 1\n    return changes_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII codes of only the uppercase characters in a string.\n    This implementation follows a structured design using nested helper classes.\n    \"\"\"\n\n    class Character:\n        \"\"\"Encapsulates a single character and provides character-specific operations.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n\n        def isUppercase(self) -> bool:\n            \"\"\"Checks if the character is an uppercase letter.\"\"\"\n            return self._value.isupper()\n\n        def getAsciiCode(self) -> int:\n            \"\"\"Returns the ASCII integer value of the character.\"\"\"\n            return ord(self._value)\n\n    class InputString:\n        \"\"\"Encapsulates the input string and provides methods for character access and emptiness checks.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n\n        def getCharacters(self) -> list['Character']:\n            \"\"\"Returns a list of Character objects for each character in the string.\"\"\"\n            return [Character(char) for char in self._value]\n\n        def isEmpty(self) -> bool:\n            \"\"\"Checks if the encapsulated string is empty.\"\"\"\n            return not bool(self._value)\n\n    class AsciiSumCalculator:\n        \"\"\"Contains the core business logic for summing ASCII codes of uppercase characters.\"\"\"\n        def calculateSum(self, input_string_obj: 'InputString') -> int:\n            \"\"\"Calculates the sum of ASCII codes of uppercase characters within the provided InputString object.\"\"\"\n            total_sum = 0\n            for char_obj in input_string_obj.getCharacters():\n                if char_obj.isUppercase():\n                    total_sum += char_obj.getAsciiCode()\n            return total_sum\n\n    input_string_obj = InputString(s)\n\n    if input_string_obj.isEmpty():\n        return 0\n\n    calculator_obj = AsciiSumCalculator()\n    return calculator_obj.calculateSum(input_string_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    class Triangle:\n        \"\"\"Encapsulates triangle properties and provides methods for validity and area calculation.\"\"\"\n        def __init__(self, a: float, b: float, c: float):\n            self._sideA = a\n            self._sideB = b\n            self._sideC = c\n\n        def isValid(self) -> bool:\n            \"\"\"Determines if the three sides form a valid triangle.\"\"\"\n            return (self._sideA + self._sideB > self._sideC and\n                    self._sideB + self._sideC > self._sideA and\n                    self._sideA + self._sideC > self._sideB)\n\n        def calculateArea(self) -> float:\n            \"\"\"Calculates the area using Heron's formula, rounded to 2 decimal places.\"\"\"\n            if not self.isValid():\n                return 0.0 # The orchestrating function handles the -1 return.\n\n            s = (self._sideA + self._sideB + self._sideC) / 2\n            area_squared = s * (s - self._sideA) * (s - self._sideB) * (s - self._sideC)\n            if area_squared < 0: # Handle potential floating point inaccuracies for nearly invalid triangles\n                return 0.0\n            \n            area = area_squared**0.5\n            return round(area, 2)\n\n    triangle = Triangle(a, b, c)\n    if triangle.isValid():\n        return triangle.calculateArea()\n    else:\n        return -1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "def _calculate_total_characters(string_list: list[str]) -> int:\n    \"\"\"\n    Calculates the total number of characters across all strings in a list.\n    \"\"\"\n    total_chars = 0\n    for s in string_list:\n        total_chars += len(s)\n    return total_chars\ndef total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character counts.\n    Returns the list with the total number of characters less than or equal to the other list,\n    prioritizing the first list on equality.\n    \"\"\"\n    lst1_char_count = _calculate_total_characters(lst1)\n    lst2_char_count = _calculate_total_characters(lst2)\n\n    if lst1_char_count <= lst2_char_count:\n        return lst1\n    else: # lst2_char_count < lst1_char_count\n        return lst2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube of some integer number.\n    This function handles both positive and negative integers, as well as zero.\n    '''\n    if a == 0:\n        return True\n    \n    # Calculate the approximate integer cube root of the absolute value of 'a'.\n    # Using round() helps mitigate potential floating point inaccuracies for numbers close to a perfect cube.\n    root = round(abs(a)**(1/3))\n    \n    # Cube the root and reapply the original sign to compare with 'a'.\n    cubed_val = root * root * root\n    if a < 0:\n        cubed_val = -cubed_val\n        \n    return cubed_val == a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k = x for integer k).\"\"\"\n\n    # Handle negative base n.\n    if n < 0:\n        return False\n\n    # Handle non-positive x.\n    # If x is 0, it is a power of 0 (0**k=0 for k>0). Otherwise, not a power of non-negative n.\n    if x <= 0:\n        return x == 0 and n == 0\n\n    # At this point, we know x > 0 and n >= 0.\n\n    # Handle base n = 0.\n    # Since x > 0, the only way 0**k = x is if x = 1 and k = 0 (0**0 = 1).\n    if n == 0:\n        return x == 1\n\n    # At this point, we know x > 0 and n > 0.\n\n    # Handle base n = 1.\n    # Since x > 0, the only way 1**k = x is if x = 1.\n    if n == 1:\n        return x == 1\n\n    # At this point, we know x > 0 and n > 1.\n\n    # Handle x = 1.\n    # Since n > 1, any n raised to the power 0 is 1 (n**0 = 1).\n    if x == 1:\n        return True\n\n    # At this point, we know x > 1 and n > 1.\n    # This is the general case where logarithms can be safely applied.\n\n    # Calculate k using logarithms: k = log_n(x) = log(x) / log(n).\n    # n > 1 implies math.log(n) > 0, so no division by zero.\n    k = math.log(x) / math.log(n)\n\n    # Check if k is an integer within a small floating-point tolerance.\n    TOLERANCE = 1e-9\n    return abs(k - round(k)) < TOLERANCE", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[4722366482869645213695, 4722366482869645213696]]}], "HumanEval/80": [{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if the string s is happy. A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n    return True", "base_status": "pass",