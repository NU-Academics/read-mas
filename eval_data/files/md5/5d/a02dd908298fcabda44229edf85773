e decimal digits of num.\"\"\"\n        sum_val = 0\n        temp_num = num\n        while temp_num > 0:\n            sum_val += temp_num % 10\n            temp_num //= 10\n        return sum_val\n\n    def _convert_to_binary(sum_val: int) -> str:\n        \"\"\"Converts an integer sum into its binary string representation.\"\"\"\n        if sum_val == 0:\n            return \"0\"\n        return bin(sum_val)[2:]\n\n    decimal_digit_sum = _calculate_decimal_digit_sum(N)\n    binary_representation = _convert_to_binary(decimal_digit_sum)\n    return binary_representation", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (decimal 11), and D (decimal 13).\n    \"\"\"\n    _PRIME_HEX_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\n\n    def _hex_char_to_decimal(char: str) -> int:\n        \"\"\"Converts a single uppercase hexadecimal character to its decimal equivalent.\"\"\"\n        if '0' <= char <= '9':\n            return int(char)\n        else:\n            return 10 + (ord(char) - ord('A'))\n\n    def _is_prime_hex_digit(decimal_value: int) -> bool:\n        \"\"\"Determines if a given decimal value corresponds to a prime hexadecimal digit.\"\"\"\n        return decimal_value in _PRIME_HEX_DECIMAL_VALUES\n\n    if not num:\n        return 0\n\n    prime_count = 0\n    for char_hex in num:\n        decimal_val = _hex_char_to_decimal(char_hex)\n        if _is_prime_hex_digit(decimal_val):\n            prime_count += 1\n\n    return prime_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in lst and returns their (row, col) coordinates,\n    sorted by row ascending, then column descending.\n    \"\"\"\n    class Coordinate:\n        \"\"\"Stores a 0-indexed (row, column) pair and provides comparison logic.\"\"\"\n        def __init__(self, row: int, column: int):\n            self.row = row\n            self.column = column\n\n        def __lt__(self, other: 'Coordinate') -> bool:\n            # Sort by row ascending, then column descending\n            if self.row != other.row:\n                return self.row < other.row\n            return self.column > other.column  # Descending for columns\n\n        def to_tuple(self) -> tuple[int, int]:\n            \"\"\"Converts the Coordinate object to a (row, column) tuple.\"\"\"\n            return (self.row, self.column)\n\n    found_coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append(Coordinate(row_idx, col_idx))\n\n    # The list of Coordinate objects is sorted using the custom __lt__ method\n    found_coordinates.sort()\n\n    # Convert sorted Coordinate objects to tuples\n    return [coord.to_tuple() for coord in found_coordinates]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        elif gpa == 0.0:\n            letter_grades.append('E')\n    return letter_grades", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/85": [{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    current_sum = 0\n\n    for index, value in enumerate(lst):\n        if index % 2 != 0:  # Check if index is odd\n            if value % 2 == 0:  # Check if value is even\n                current_sum += value\n\n    return current_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/86": [{"task_id": "HumanEval/86", "solution": "import re\nfrom typing import List, Union\nclass Character:\n    \"\"\"Represents a single character with its ASCII value for comparison.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.asciiValue = ord(value)\n\n    def __lt__(self, other: 'Character') -> bool:\n        \"\"\"Enables comparison of Character objects based on their ASCII values for sorting.\"\"\"\n        return self.asciiValue < other.asciiValue\nclass Word:\n    \"\"\"Encapsulates a word, providing functionality to sort its characters by ASCII value.\"\"\"\n    def __init__(self, value: str):\n        self._original_value = value\n        self._sorted_value = None\n\n    def sortCharactersByAscii(self) -> None:\n        \"\"\"Sorts the characters of the word in ascending ASCII order and updates its internal sorted representation.\"\"\"\n        char_objects = [Character(char) for char in self._original_value]\n        char_objects.sort()\n        self._sorted_value = \"\".join(char.value for char in char_objects)\n\n    def to_string(self) -> str:\n        \"\"\"Returns the sorted string representation of the word.\"\"\"\n        if self._sorted_value is None:\n            self.sortCharactersByAscii()\n        return self._sorted_value\nclass String:\n    \"\"\"Manages splitting a sentence into words and spaces, and joining them back.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def splitIntoWords(self) -> List[Union['Word', str]]:\n        \"\"\"Splits the string into a list of Word objects (for words) and str (for spaces), preserving order.\"\"\"\n        parts = re.split(r'(\\s+)', self.value)\n        \n        result_parts = []\n        for part in parts:\n            if part: # Filter out potential empty strings from re.split\n                if re.fullmatch(r'\\s+', part): # If the part is entirely spaces\n                    result_parts.append(part)\n                else: # It's a word\n                    result_parts.append(Word(part))\n        return result_parts\n\n    def joinWords(self, parts: List[Union['Word', str]]) -> str:\n        \"\"\"Joins a list of Word objects (converted to strings) and str (spaces) back into a single string.\"\"\"\n        output_strings = []\n        for part in parts:\n            if isinstance(part, Word):\n                output_strings.append(part.to_string())\n            else: # It's a space string\n                output_strings.append(part)\n        return \"\".join(output_strings)\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    string_instance = String(s)\n    parts = string_instance.splitIntoWords()\n\n    processed_parts_for_joining = []\n    for part in parts:\n        if isinstance(part, Word):\n            part.sortCharactersByAscii()\n            processed_parts_for_joining.append(part)\n        else:\n            processed_parts_for_joining.append(part)\n\n    result_string = string_instance.joinWords(processed_parts_for_joining)\n    return result_string", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\n123 456\n789\n"]]}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    result = []\n    shift_amount = 4  # Two multiplied by two places\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the new position, wrapping around 'z'\n            start_ascii = ord('a')\n            char_offset = ord(char) - start_ascii\n            shifted_offset = (char_offset + shift_amount) % 26\n            shifted_char = chr(start_ascii + shifted_offset)\n            result.append(shifted_char)\n        else:\n            # Non-lowercase English letters remain unchanged\n            result.append(char)\n    return \"\".join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element (fewer than two distinct elements).\n    \"\"\"\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n\n    return unique_elements[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    import re\n\n    class Text:\n        def __init__(self, content: str):\n            self._content = content\n\n        @property\n        def content(self) -> str:\n            return self._content\n\n    class Sentence:\n        def __init__(self, text: str):\n            self._text = text.strip()\n\n        @property\n        def text(self) -> str:\n            return self._text\n\n        def starts_with_i(self) -> bool:\n            return self._text.lower().startswith('i ') or self._text.lower() == 'i'\n\n    class BoredomCounter:\n        def count_boredoms(self, input_text: Text) -> int:\n            boredom_count = 0\n            raw_sentences = re.split(r'[.?!]', input_text.content)\n\n            for raw_sentence in raw_sentences:\n                if not raw_sentence.strip():\n                    continue\n\n                sentence = Sentence(raw_sentence)\n                if sentence.starts_with_i():\n                    boredom_count += 1\n            return boredom_count\n\n    text_obj = Text(S)\n    counter = BoredomCounter()\n    return counter.count_boredoms(text_obj)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "class Array:\n    \"\"\"Encapsulates array data and provides utility methods.\"\"\"\n    def __init__(self, elements):\n        self._elements = list(elements) # Create a shallow copy for immutability.\n\n    def get_first_element(self):\n        if self.is_empty():\n            raise IndexError(\"Array is empty, no first element.\")\n        return self._elements[0]\n\n    def get_last_element(self):\n        if self.is_empty():\n            raise IndexError(\"Array is empty, no last element.\")\n        return self._elements[-1]\n\n    def is_empty(self):\n        return len(self._elements) == 0\n\n    def has_single_element(self):\n        return len(self._elements) == 1\n\n    def calculate_first_last_sum(self):\n        if len(self._elements) < 2:\n            raise ValueError(\"Cannot calculate sum for arrays with less than two elements.\")\n        return self.get_first_element() + self.get_last_element()\n\n    def get_copy(self):\n        \"\"\"Returns a new Array object with a copy of the current elements.\"\"\"\n        return Array(self._elements)\n\n    def to_list(self):\n        \"\"\"Converts the Array object back to a standard Python list.\"\"\"\n        return list(self._elements)\nclass Sorter:\n    \"\"\"Provides methods for sorting arrays in ascending or descending order.\"\"\"\n\n    @staticmethod\n    def sort_ascending(array_obj):\n        \"\"\"Sorts the elements of a copied Array object in ascending order.\"\"\"\n        copied_elements = array_obj.to_list() # Ensure a new array is returned, input not modified.\n        copied_elements.sort()\n        return Array(copied_elements)\n\n    @staticmethod\n    def sort_descending(array_obj):\n        \"\"\"Sorts the elements of a copied Array object in descending order.\"\"\"\n        copied_elements = array_obj.to_list() # Ensure a new array is returned, input not modified.\n        copied_elements.sort(reverse=True)\n        return Array(copied_elements)\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    array_obj = Array(array)\n\n    if array_obj.is_empty():\n        return []\n    elif array_obj.has_single_element():\n        return array_obj.get_copy().to_list() # Return a new array with the single element.\n    else:\n        first_last_sum = array_obj.calculate_first_last_sum()\n\n        if first_last_sum % 2 != 0:  # Odd sum\n            sorted_array_obj = Sorter.sort_ascending(array_obj)\n        else:  # Even sum\n            sorted_array_obj = Sorter.sort_descending(array_obj)\n\n        return sorted_array_obj.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/92": [{"task_id": "HumanEval/92", "solution": "class Number:\n    \"\"\"Encapsulates a numerical value and checks if it's an integer.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def is_integer(self):\n        \"\"\"Returns True if the value is an integer, False otherwise.\"\"\"\n        return isinstance(self._value, int)\nclass InputSet:\n    \"\"\"Manages three Number objects and provides methods for evaluation.\"\"\"\n    def __init__(self, x_num, y_num, z_num):\n        self._x = x_num\n        self._y = y_num\n        self._z = z_num\n\n    def all_are_integers(self):\n        \"\"\"Returns True if all three contained Number objects are integers.\"\"\"\n        return self._x.is_integer() and self._y.is_integer() and self._z.is_integer()\n\n    def any_sum_condition_met(self):\n        \"\"\"Returns True if any one number is equal to the sum of the other two.\"\"\"\n        x_val = self._x._value\n        y_val = self._y._value\n        z_val = self._z._value\n        \n        return (x_val == y_val + z_val or\n                y_val == x_val + z_val or\n                z_val == x_val + y_val)\ndef any_int(x, y, z):\n    \"\"\"\n    Checks if one of the three numbers is the sum of the other two,\n    given that all numbers are integers.\n    \"\"\"\n    num_x = Number(x)\n    num_y = Number(y)\n    num_z = Number(z)\n\n    input_set = InputSet(num_x, num_y, num_z)\n\n    if input_set.all_are_integers():\n        return input_set.any_sum_condition_met()\n    else:\n        return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if not key.is