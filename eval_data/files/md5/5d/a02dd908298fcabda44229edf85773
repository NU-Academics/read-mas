e 'mm-dd-yyyy' format and returns a Date object if valid, otherwise None.\"\"\"\n        if len(date_string) != 10:\n            return None\n        if date_string[2] != '-' or date_string[5] != '-':\n            return None\n\n        try:\n            parts = date_string.split('-')\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return Date(month, day, year)\n        except (ValueError, IndexError):\n            return None\n\n    def _is_month_valid(self, month: int) -> bool:\n        \"\"\"Checks if the month is between 1 and 12.\"\"\"\n        return 1 <= month <= 12\n\n    def _is_day_valid_for_month(self, day: int, month: int) -> bool:\n        \"\"\"Checks if the day is valid for the given month, considering month-specific day limits.\"\"\"\n        if month in [1, 3, 5, 7, 8, 10, 12]:\n            return 1 <= day <= 31\n        elif month in [4, 6, 9, 11]:\n            return 1 <= day <= 30\n        elif month == 2:\n            return 1 <= day <= 29 # Rule 2 specifies 29 days for Feb, without regard to leap years.\n        return False # Should not be reached if _is_month_valid already passed, but ensures a boolean return.\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string according to specified rules.\n    Returns True if the date is valid, otherwise False.\n    \"\"\"\n    validator = DateValidator()\n    return validator.validate(date)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["04-02-2-20"]]}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a given character is a vowel (case-sensitive).\"\"\"\n        return char in 'aeiouAEIOU'\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Determines if a given character is a consonant (case-sensitive).\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second to last character down to the second character.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and \\\n           _is_consonant(left_char) and \\\n           _is_consonant(right_char):\n            return current_char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    def _has_whitespace(text: str) -> bool:\n        return any(c.isspace() for c in text)\n\n    def _has_comma(text: str) -> bool:\n        return ',' in text\n\n    def _split_by_whitespace(text: str) -> list[str]:\n        return text.split()\n\n    def _split_by_comma(text: str) -> list[str]:\n        return text.split(',')\n\n    def _is_lowercase(char: str) -> bool:\n        return 'a' <= char <= 'z'\n\n    def _get_alphabetical_order(char: str) -> int:\n        return ord(char) - ord('a')\n\n    def _is_odd_order(order: int) -> bool:\n        return order % 2 != 0\n\n    def _count_odd_order_lowercase(text: str) -> int:\n        count = 0\n        for char in text:\n            if _is_lowercase(char):\n                order = _get_alphabetical_order(char)\n                if _is_odd_order(order):\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_order_lowercase(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def _get_magnitude(num: int) -> int:\n    \"\"\"Returns the absolute value (magnitude) of an integer.\"\"\"\n    return abs(num)\ndef _get_sign(num: int) -> int:\n    \"\"\"Determines the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n    if num > 0:\n        return 1\n    elif num < 0:\n        return -1\n    else:\n        return 0\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_of_magnitudes = 0\n    product_of_signs = 1\n    for x in arr:\n        sum_of_magnitudes += _get_magnitude(x)\n        product_of_signs *= _get_sign(x)\n\n    final_result = sum_of_magnitudes * product_of_signs\n    return final_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    def _calculate_intersection(interval1_tuple, interval2_tuple):\n        \"\"\"Calculates the intersection of two closed intervals, returning None if empty.\"\"\"\n        start1, end1 = interval1_tuple\n        start2, end2 = interval2_tuple\n\n        intersect_start = max(start1, start2)\n        intersect_end = min(end1, end2)\n\n        if intersect_start > intersect_end:\n            return None\n        return (intersect_start, intersect_end)\n\n    def _calculate_length(interval_tuple):\n        \"\"\"Calculates the length of a closed interval (end - start + 1).\"\"\"\n        start, end = interval_tuple\n        return end - start + 1\n\n    def _is_prime(number):\n        \"\"\"Determines if a number is prime (natural number > 1 with no positive divisors other than 1 and itself).\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    intersect_interval = _calculate_intersection(interval1, interval2)\n\n    if intersect_interval is None:\n        return \"NO\"\n    else:\n        length = _calculate_length(intersect_interval)\n        if _is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef _check_sorted_order(lst):\n    \"\"\"Checks if the list is sorted in ascending order.\"\"\"\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n    return True\ndef _check_duplicates(lst):\n    \"\"\"Checks if any number appears more than twice in the list.\"\"\"\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n    return True\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    if not _check_sorted_order(lst):\n        return False\n\n    if not _check_duplicates(lst):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a single cell with its value and coordinates.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_col(self) -> int:\n        return self._col\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self._row == other._row and self._col == other._col\n\n    def __hash__(self) -> int:\n        return hash((self._row, self._col))\nclass Grid:\n    \"\"\"Manages the grid structure, provides cell access and neighbor lookup.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._N = len(grid_data)\n        self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n        for r in range(self._N):\n            for c in range(self._N):\n                self._cells[r][c] = Cell(r, c, grid_data[r][c])\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self._cells[row][col]\n\n    def get_neighbors(self, cell: Cell) -> list[Cell]:\n        neighbors = []\n        row, col = cell.get_row(), cell.get_col()\n        dr = [-1, 1, 0, 0] # Row offsets for up, down, left, right\n        dc = [0, 0, -1, 1] # Column offsets for up, down, left, right\n\n        for i in range(4):\n            new_row, new_col = row + dr[i], col + dc[i]\n            if self.is_valid_coord(new_row, new_col):\n                neighbors.append(self.get_cell(new_row, new_col))\n        return neighbors\n\n    def get_N(self) -> int:\n        return self._N\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        return 0 <= row < self._N and 0 <= col < self._N\nclass Path:\n    \"\"\"Represents a sequence of visited cells and their values, supports lexicographical comparison.\"\"\"\n    def __init__(self, initial_cell: Cell = None):\n        self._visited_cells: list[Cell] = []\n        self._values: list[int] = []\n        if initial_cell:\n            self.add_cell(initial_cell)\n\n    def add_cell(self, cell: Cell):\n        self._visited_cells.append(cell)\n        self._values.append(cell.get_value())\n\n    def get_length(self) -> int:\n        return len(self._values)\n\n    def get_values(self) -> list[int]:\n        return self._values\n\n    def __lt__(self, other) -> bool:\n        if not isinstance(other, Path):\n            return NotImplemented\n        return self._values < other._values\n\n    def get_last_cell(self) -> Cell:\n        if not self._visited_cells:\n            return None\n        return self._visited_cells[-1]\n\n    def copy(self) -> 'Path':\n        new_path = Path()\n        new_path._visited_cells = list(self._visited_cells)\n        new_path._values = list(self._values)\n        return new_path\ndef _find_paths_dfs(current_path: Path, current_cell: Cell, k: int, grid_obj: Grid, min_path_values: list[int]):\n    \"\"\"Recursively explores paths using DFS, updating min_path_values if a smaller path is found.\"\"\"\n    if current_path.get_length() == k:\n        path_values = current_path.get_values()\n        if path_values < min_path_values:\n            min_path_values[:] = path_values # Update content of the mutable list\n        return\n\n    if current_path.get_length() < k:\n        neighbors = grid_obj.get_neighbors(current_cell)\n        for neighbor in neighbors:\n            next_path = current_path.copy()\n            next_path.add_cell(neighbor)\n            _find_paths_dfs(next_path, neighbor, k, grid_obj, min_path_values)\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid and a positive integer k, find the minimum path of length k in the grid.\n    \"\"\"\n    _validate_input(grid, k)\n\n    N = len(grid)\n    grid_obj = Grid(grid)\n\n    min_path_values = [float('inf')] * k # Initialize with a lexicographically very large path\n\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            initial_path = Path(start_cell)\n            _find_paths_dfs(initial_path, start_cell, k, grid_obj, min_path_values)\n            \n    return min_path_values", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1]]}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    import math\n    \n    total_sum = 0\n    for number in lst:\n        rounded_num = math.ceil(number)\n        squared_num = rounded_num ** 2\n        total_sum += squared_num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Convert the number to a string to iterate through its digits.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or equal to its predecessor.\n    If no such element exists, returns -1.\n    \"\"\"\n    result = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            result = i\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def _is_alphabetical(char):\n    \"\"\"Checks if a character is an alphabetical character.\"\"\"\n    return char.isalpha()\ndef _is_space(char):\n    \"\"\"Checks if a character is a space character.\"\"\"\n    return char == ' '\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n\n    Examples:\n    check_if_last_char_is_a_letter(\"apple pie\") \u279e False\n    check_if_last_char_is_a_letter(\"apple pi e\") \u279e True\n    check_if_last_char_is_a_letter(\"apple pi e \") \u279e False\n    check_if_last_char_is_a_letter(\"\") \u279e False \n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not _is_alphabetical(last_char):\n        return False\n\n    # If the string has only one character and it's alphabetical, it's considered standalone.\n    if len(txt) == 1:\n        return True\n    \n    # Check the character immediately preceding the last one.\n    char_before_last = txt[-2]\n    \n    # If the character before the last is a space, the last character is standalone.\n    return _is_space(char_before_last)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "import abc\nclass ComparableInput(abc.ABC):\n    \"\"\"Abstract base class for inputs that can be numerically compared.\"\"\"\n    def __init__(self, value):\n        self._original_value = value\n        self._numeric_value = self._parse_to_numeric()\n\n    def get_original_value(self):\n        \"\"\"Returns the original input value.\"\"\"\n        return self._original_value\n\n    def get_numeric_value(self):\n        \"\"\"Returns the parsed numerical value.\"\"\"\n        return self._numeric_value\n\n    @abc.abstractmethod\n    def _parse_to_numeric(self):\n        \"\"\"Abstract method to be implemented by subclasses for specific parsing logic.\"\"\"\n        pass\nclass IntegerInput(ComparableInput):\n    \"\"\"Wraps an integer input, providing its numeric value directly.\"\"\"\n    def __init__(self, value: int):\n        super().__init__(value)\n\n    def _parse_to_numeric(self) -> float:\n        \"\"\"Converts the integer to a float.\"\"\"\n        return float(self._original_value)\nclass FloatInput(ComparableInput):\n    \"\"\"Wraps a float input, providing its numeric value directly.\"\"\"\n    def __init__(self, value: float):\n        super().__init__(value)\n\n    def _parse_to_numeric(self) -> float:\n        \"\"\"Returns the float value directly.\"\"\"\n        return self._original_value\nclass StringInput(ComparableInput):\n    \"\"\"Wraps a string input, parsing it into a numeric value.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value)\n\n    def _parse_to_numeric(self) -> float:\n        \"\"\"Parses the string, handling ',' and '.' as decimal separators, and converts to float.\"\"\"\n        cleaned_string = self._original_value.replace(',', '.')\n        return float(cleaned_string)\ndef compare_one(a, b):\n    \"\"\"\n    Compares two inputs (integers, floats, or string representations of real numbers)\n    and returns the numerically larger value in its original type, or None if equal.\n    \"\"\"\n    input_a = None\n    if isinstance(a, int):\n        input_a = IntegerInput(a)\n    elif isinstance(a, float):\n        input_a = FloatInput(a)\n    elif isinstance(a, str):\n        input_a = StringInput(a)\n\n    input_b = None\n    if isinstance(b, int):\n        input_b = IntegerInput(b)\n    elif isinstance(b, float):\n        input_b = FloatInput(b)\n    elif isinstance(b, str):\n        input_b = StringInput(b)\n\n    numeric_a = input_a.get_numeric_value()\n    numeric_b = input_b.get_numeric_value()\n\n    if numeric_a > numeric_b:\n        return input_a.get_original_value()\n    elif numeric_b > numeric_a:\n        return input_b.get_original_value()\n    else:\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    This is true if n is even and n is greater than or equal to 8.\n    \"\"\"\n    if n % 2 != 0:\n        return False\n    if n < 8:\n        return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    import re\n\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    text = re.sub(r' {3,}', '-', text)\n    # Next, replace sequences of exactly two spaces with two underscores.\n    text = re.sub(r' {2}', '__', text)\n    # Finally, replace all remaining single spaces with single underscores.\n    text = re.sub(r' ', '_', text)\n\n    return text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n\n    for word in words:\n        if not word: # Handle empty strings from multiple spaces\n            continue\n        word_length = len(word)\n        if _is_prime(word_length):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n\n    def _gcd(a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction and provides arithmetic operations.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        @classmethod\n        def from_string(cls, fraction_string: str) -> 'Fraction':\n            \"\"\"Parses a string in \"<numerator>/<denominator>\" format into a Fraction object.\"\"\"\n            parts = fraction_string.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return cls(numerator, denominator)\n\n        def multiply(self, other_fraction: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another fraction.\"\"\"\n            new_numerator = self._numerator * other_fraction._numerator\n            new_denominator = self._denominator * other_fraction._denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Checks if the fraction evaluates to a whole number after simplification.\"\"\"\n            common_divisor = _gcd(self._numerator, self._denominator)\n            simplified_denominator = self._denominator // common_divisor\n            return simplified_denominator == 1\n\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def _is_divisible(number: int, divisors: list[int]) -> bool:\n    \"\"\"Checks if a number is divisible by any of the given divisors.\"\"\"\n    for divisor in divisors:\n        if number % divisor == 0:\n            return True\n    return False\ndef _count_digit_occurrences(number: int, digit: int) -> int:\n    \"\"\"Counts how many times a specific digit appears in a number.\"\"\"\n    count = 0\n    num_str = str(number)\n    target_digit_str = str(digit)\n    return num_str.count(target_digit_str)\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    TARGET_DIVISORS = [11, 13]\n    TARGET_DIGIT = 7\n\n    for i in range(1, n):\n        if _is_divisible(i, TARGET_DIVISORS):\n            total_sevens_count += _count_digit_occurrences(i, TARGET_DIGIT)\n\n    return total_sevens_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    class FileName:\n        def __init__(self, full_name: str):\n            self._full_name = full_name\n            self._name_part = \"\"\n            self._extension_part = \"\"\n            self._split_by_dot()\n\n        def _split_by_dot(self):\n            # This method parses the file name into name and extension parts using the last dot.\n            # The actual validation for exactly one dot is handled elsewhere.\n            parts = self._full_name.rsplit('.', 1)\n            if len(parts) == 2:\n                self._name_part = parts[0]\n                self._extension_part = parts[1]\n            elif len(parts) == 1:\n                self._name_part = parts[0]\n                self._extension_part = \"\"\n\n        def get_full_name(self) -> str:\n            return self._full_name\n\n        def get_name_part(self) -> str:\n            return self._name_part\n\n        def get_extension_part(self) -> str:\n            return self._extension_part\n\n        def count_digits(self) -> int:\n            return sum(c.isdigit() for c in self._name_part)\n\n        def starts_with_latin_letter(self) -> bool:\n            if not self._name_part:\n                return False\n            return self._name_part[0].isalpha()\n\n        def has_exactly_one_dot(self) -> bool:\n            return self._full_name.count('.') == 1\n\n        def is_name_part_not_empty(self) -> bool:\n            return bool(self._name_part)\n\n\n    class ValidationService:\n        VALID_EXTENSIONS = {'txt', 'exe', 'dll'}\n\n        def validate(self, file_name_obj: FileName) -> str:\n            # BR2: The file's name contains exactly one dot '.'\n            if not file_name_obj.has_exactly_one_dot():\n                return 'No'\n\n            # BR3: The substring before the dot should not be empty\n            if not file_name_obj.is_name_part_not_empty():\n                return 'No'\n\n            # BR4: The substring before the dot should start with a letter from the latin alphabet\n            if not file_name_obj.starts_with_latin_letter():\n                return 'No'\n\n            # BR1: There should not be more than three digits ('0'-'9') in the file's name.\n            if file_name_obj.count_digits() > 3:\n                return 'No'\n\n            # BR5: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n            if file_name_obj.get_extension_part() not in self.VALID_EXTENSIONS:\n                return 'No'\n\n            # BR6: All conditions met\n            return 'Yes'\n\n    file_obj = FileName(file_name)\n    validator = ValidationService()\n    return validator.validate(file_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If digit sums are similar, items are ordered based on their original index.\n    \"\"\"\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"\n        Computes the sum of the absolute values of the digits of a given integer.\n        \"\"\"\n        abs_number_str = str(abs(number))\n        return sum(int(digit) for digit in abs_number_str)\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (digit_sum, original_index, value)\n    annotated_nums = []\n    for index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        annotated_nums.append((digit_sum, index, num))\n\n    # Sort the list of tuples primarily by digit_sum, then by original_index.\n    annotated_nums.sort()\n\n    # Extract the original numbers from the sorted tuples.\n    sorted_nums = [item[2] for item in annotated_nums]\n\n    return sorted_nums", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n\n    def _is_greater_than_10(number: int) -> bool:\n        \"\"\"Checks if a given number is greater than 10.\"\"\"\n        return number > 10\n\n    def _get_first_digit(number: int) -> int:\n        \"\"\"Extracts the first digit of a number, ignoring its sign.\"\"\"\n        return int(str(abs(number))[0])\n\n    def _get_last_digit(number: int) -> int:\n        \"\"\"Extracts the last digit of a number, ignoring its sign.\"\"\"\n        return abs(number) % 10\n\n    def _is_odd_digit(digit: int) -> bool:\n        \"\"\"Checks if a digit is odd (1, 3, 5, 7, 9).\"\"\"\n        return digit % 2 != 0\n\n    special_count = 0\n    for number in nums:\n        if _is_greater_than_10(number):\n            first_digit = _get_first_digit(number)\n            if _is_odd_digit(first_digit):\n                last_digit = _get_last_digit(number)\n                if _is_odd_digit(last_digit):\n                    special_count += 1\n    return special_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a celestial body with a name and its orbital order from the Sun.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self._name = name\n        self._order_from_sun = order_from_sun\n\n    def get_name(self) -> str:\n        \"\"\"Returns the name of the planet.\"\"\"\n        return self._name\n\n    def get_order_from_sun(self) -> int:\n        \"\"\"Returns the orbital order of the planet from the Sun.\"\"\"\n        return self._order_from_sun\nclass SolarSystem:\n    \"\"\"Manages the collection of planets and implements core business logic.\"\"\"\n    def __init__(self):\n        planet_data = [\n            (\"Mercury\", 0), (\"Venus\", 1), (\"Earth\", 2), (\"Mars\", 3),\n            (\"Jupiter\", 4), (\"Saturn\", 5), (\"Uranus\", 6), (\"Neptune\", 7)\n        ]\n        self._ordered_planets: list[Planet] = [\n            Planet(name, order) for name, order in planet_data\n        ]\n        self._planet_map: dict[str, Planet] = {\n            planet.get_name(): planet for planet in self._ordered_planets\n        }\n\n    def is_valid_planet(self, planet_name: str) -> bool:\n        \"\"\"Checks if the given planet name is valid.\"\"\"\n        return planet_name in self._planet_map\n\n    def get_planet_order(self, planet_name: str) -> int:\n        \"\"\"Returns the order from the Sun for a given planet name.\"\"\"\n        return self._planet_map[planet_name].get_order_from_sun()\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> list[str]:\n        \"\"\"Identifies and returns names of planets strictly between the two input planets.\"\"\"\n        order1 = self.get_planet_order(planet1_name)\n        order2 = self.get_planet_order(planet2_name)\n\n        min_order = min(order1, order2)\n        max_order = max(order1, order2)\n\n        result_planets = []\n        for planet in self._ordered_planets:\n            p_order = planet.get_order_from_sun()\n            if min_order < p_order < max_order:\n                result_planets.append(planet.get_name())\n        return result_planets\n_solar_system_instance = SolarSystem()\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    if not _solar_system_instance.is_valid_planet(planet1) or \\\n       not _solar_system_instance.is_valid_planet(planet2):\n        return ()\n\n    intermediate_planets = _solar_system_instance.get_planets_between(planet1, planet2)\n    return tuple(intermediate_planets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    import math\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime by handling small numbers, even numbers, and checking odd divisors up to its square root.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings, retaining only those with even lengths.\n    Then sorts the retained strings by length (ascending) and alphabetically (ascending) for ties.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    even_length_strings.sort(key=lambda s: (len(s), s))\n    return even_length_strings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    sum_of_squares = 0\n\n    for element in lst:\n        # Check if element is an integer (and not a boolean, which is a subclass of int).\n        if isinstance(element, int) and not isinstance(element, bool):\n            # Check if element is positive and odd.\n            if element > 0 and element % 2 != 0:\n                sum_of_squares += element * element\n    \n    return sum_of_squares", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[true, true, false, false, true, false, false, false, false, false]]]}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "class Match:\n    \"\"\"Encapsulates a single match's score, guess, and calculated difference.\"\"\"\n    def __init__(self, actual_score: int, player_guess: int):\n        self._actual_score = actual_score\n        self._player_guess = player_guess\n        self._calculated_difference = abs(actual_score - player_guess)\n\n    def get_difference(self) -> int:\n        \"\"\"Returns the pre-calculated absolute difference for the match.\"\"\"\n        return self._calculated_difference\ndef compare(game,guess):\n    \"\"\"Compares actual game scores to player guesses, returning an array of absolute differences.\"\"\"\n    differences = []\n    for i in range(len(game)):\n        match = Match(game[i], guess[i])\n        differences.append(match.get_difference())\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = 0\n    for num in lst:\n        if _is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return _sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"Represents an extension with its name and calculated strength attributes.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n        self.uppercase_count, self.lowercase_count, self.strength = self._calculate_strength_components(name)\n\n    def _calculate_strength_components(self, extension_name: str) -> tuple[int, int, int]:\n        \"\"\"Helper to calculate uppercase, lowercase counts, and strength for an extension name.\"\"\"\n        uppercase_count = sum(1 for char in extension_name if char.isupper())\n        lowercase_count = sum(1 for char in extension_name if char.islower())\n        strength = uppercase_count - lowercase_count\n        return uppercase_count, lowercase_count, strength\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    \"\"\"\n    if not extensions:\n        return f\"{class_name}.NoExtensionFound\"\n\n    extension_objects = []\n    for ext_name in extensions:\n        extension_objects.append(Extension(ext_name))\n\n    strongest_ext = None\n    max_strength = -float('inf')\n\n    for ext_obj in extension_objects:\n        if ext_obj.strength > max_strength:\n            max_strength = ext_obj.strength\n            strongest_ext = ext_obj\n\n    if strongest_ext is None:\n        return f\"{class_name}.ErrorInFindingStrongest\"\n\n    return f\"{class_name}.{strongest_ext.name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n\n    def _generate_rotations(input_string: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a given string.\n        Returns a sorted list of unique rotations.\"\"\"\n        if not input_string:\n            return [\"\"]\n\n        rotations = set()\n        n = len(input_string)\n        for i in range(n):\n            rotated_string = input_string[i:] + input_string[:i]\n            rotations.add(rotated_string)\n        return sorted(list(rotations))\n\n\n    def _is_substring(main_string: str, sub_string: str) -> bool:\n        \"\"\"Checks if sub_string is a substring of main_string.\n        Returns True if found, False otherwise.\"\"\"\n        return sub_string in main_string\n\n    # Handle edge case where b is longer than a and cannot be a substring (unless b is empty)\n    if len(b) > len(a) and len(a) > 0:\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    class Digit:\n        \"\"\"Represents a single digit and determines its parity.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n        def is_even(self) -> bool:\n            return self.value % 2 == 0\n\n        def is_odd(self) -> bool:\n            return self.value % 2 != 0\n\n    class DigitCounter:\n        \"\"\"Accumulates and provides the total counts of even and odd digits.\"\"\"\n        def __init__(self) -> None:\n            self._even_count = 0\n            self._odd_count = 0\n\n        def process_digit(self, digit: Digit) -> None:\n            if digit.is_even():\n                self._even_count += 1\n            else:\n                self._odd_count += 1\n\n        def get_result(self) -> tuple[int, int]:\n            return (self._even_count, self._odd_count)\n\n    abs_num_str = str(abs(num))\n    counter = DigitCounter()\n\n    for char_digit in abs_num_str:\n        digit_value = int(char_digit)\n        digit = Digit(digit_value)\n        counter.process_digit(digit)\n\n    return counter.get_result()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input out of range: number must be between 1 and 1000.\")\n\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n        (1, 'i')\n    ]\n\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    \n    return \"\".join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for floating-point comparison to account for precision issues.\n    epsilon = 1e-9\n    return abs(s1**2 + s2**2 - s3**2) < epsilon", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression constructed from operator and operand lists.\n    \"\"\"\n\n    def _validate_inputs(operator, operand):\n        \"\"\"Validates input lists against specified constraints.\"\"\"\n        if not (len(operator) == len(operand) - 1):\n            raise ValueError(\"Length of operator list must be equal to length of operand list minus one.\")\n        if not (len(operator) >= 1):\n            raise ValueError(\"Operator list must have at least one operator.\")\n        if not (len(operand) >= 2):\n            raise ValueError(\"Operand list must have at least two operands.\")\n        if not all(isinstance(o, int) and o >= 0 for o in operand):\n            raise ValueError(\"Operand must be a list of non-negative integers.\")\n\n    def _construct_expression_string(operator, operand):\n        \"\"\"Builds the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(operator)):\n            expression_parts.append(str(operand[i]))\n            expression_parts.append(operator[i])\n        expression_parts.append(str(operand[-1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression_string(expression_string):\n        \"\"\"Evaluates the constructed algebraic expression string.\"\"\"\n        return eval(expression_string)\n\n    _validate_inputs(operator, operand)\n    expression_string = _construct_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_string)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n\n    class Word:\n        \"\"\"Helper class to encapsulate a string and its unique character count.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._unique_character_count = len(set(value))\n\n        def get_value(self) -> str:\n            \"\"\"Returns the string value of the word.\"\"\"\n            return self._value\n\n        def get_unique_character_count(self) -> int:\n            \"\"\"Returns the unique character count of the word.\"\"\"\n            return self._unique_character_count\n\n        def __lt__(self, other: 'Word') -> bool:\n            \"\"\"Implements less than comparison, prioritizing unique character count then lexicographical order.\"\"\"\n            if self._unique_character_count < other._unique_character_count:\n                return True\n            elif self._unique_character_count == other._unique_character_count:\n                return self._value > other._value  # For ties, lexicographically smaller is \"better\" (not less than)\n            return False\n\n        def __eq__(self, other: 'Word') -> bool:\n            \"\"\"Implements equality comparison based on the string value.\"\"\"\n            return self._value == other._value\n\n    if not words:\n        return \"\"\n\n    best_word_so_far = None\n\n    for word_str in words:\n        current_word = Word(word_str)\n\n        if best_word_so_far is None:\n            best_word_so_far = current_word\n        else:\n            # Prioritize words with more unique characters\n            if current_word.get_unique_character_count() > best_word_so_far.get_unique_character_count():\n                best_word_so_far = current_word\n            elif current_word.get_unique_character_count() == best_word_so_far.get_unique_character_count():\n                # For ties in unique character count, choose the lexicographically smaller word\n                if current_word.get_value() < best_word_so_far.get_value():\n                    best_word_so_far = current_word\n\n    return best_word_so_far.get_value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    \n    # Calculate how many carrots the rabbit actually eats from the remaining stock\n    # This is the minimum of what is needed and what is available.\n    carrots_eaten_now = min(need, remaining)\n    \n    # Calculate the total number of carrots eaten by adding the newly eaten carrots to the previously eaten ones.\n    total_eaten_carrots = number + carrots_eaten_now\n    \n    # Calculate the number of carrots left by subtracting the newly eaten carrots from the remaining stock.\n    carrots_left_after_meal = remaining - carrots_eaten_now\n    \n    return [total_eaten_carrots, carrots_left_after_meal]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def _is_letter(char):\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return char.isalpha()\ndef _reverse_case(char):\n    \"\"\"Reverses the case of a letter character.\"\"\"\n    return char.swapcase()\ndef _contains_letters(s):\n    \"\"\"Checks if the input string contains any alphabetic letters.\"\"\"\n    for char in s:\n        if _is_letter(char):\n            return True\n    return False\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    if not _contains_letters(s):\n        return s[::-1]\n    \n    transformed_chars = []\n    for char in s:\n        if _is_letter(char):\n            transformed_chars.append(_reverse_case(char))\n        else:\n            transformed_chars.append(char)\n            \n    return \"\".join(transformed_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    class Integer:\n        \"\"\"Represents an integer value and provides methods for checking its properties.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def is_positive(self) -> bool:\n            \"\"\"Checks if the integer is positive.\"\"\"\n            return self._value > 0\n\n        def is_even(self) -> bool:\n            \"\"\"Checks if the integer is even.\"\"\"\n            return self._value % 2 == 0\n\n        def is_single_digit(self) -> bool:\n            \"\"\"Checks if the integer is a single digit (0-9).\"\"\"\n            return 0 <= self._value <= 9\n\n        def get_value(self) -> int:\n            \"\"\"Returns the integer's value.\"\"\"\n            return self._value\n\n    class Range:\n        \"\"\"Defines an inclusive numerical range and provides methods to determine the range and check for containment.\"\"\"\n        def __init__(self, start: Integer, end: Integer):\n            self._start = start\n            self._end = end\n\n        @classmethod\n        def from_integers(cls, a: Integer, b: Integer) -> 'Range':\n            \"\"\"Creates a Range object from two Integer inputs, determining min/max.\"\"\"\n            val_a = a.get_value()\n            val_b = b.get_value()\n            if val_a <= val_b:\n                return cls(a, b)\n            else:\n                return cls(b, a)\n\n        def contains(self, num: Integer) -> bool:\n            \"\"\"Checks if a given Integer falls within this range (inclusive).\"\"\"\n            return self._start.get_value() <= num.get_value() <= self._end.get_value()\n\n    CANDIDATE_EVEN_DIGITS = [0, 2, 4, 6, 8]\n\n    integer_a = Integer(a)\n    integer_b = Integer(b)\n\n    range_obj = Range.from_integers(integer_a, integer_b)\n\n    result_list = []\n    for candidate_digit in CANDIDATE_EVEN_DIGITS:\n        candidate_int = Integer(candidate_digit)\n        if range_obj.contains(candidate_int):\n            result_list.append(candidate_digit)\n    \n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n\n    def _get_transformed_value(value: int, index: int) -> int:\n        \"\"\"Applies specific transformation (square, cube, or no change) based on index.\"\"\"\n        if index % 3 == 0:\n            return value * value\n        elif index % 4 == 0: # This condition is only checked if index is not a multiple of 3.\n            return value * value * value\n        else:\n            return value\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        transformed_value = _get_transformed_value(value, index)\n        total_sum += transformed_value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    n = len(string)\n    # Iterate through all possible contiguous substrings\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            sub = string[i:j]\n\n            # Check validity and calculate max nesting depth for 'sub'\n            stack = []\n            max_current_depth = 0\n            current_depth = 0\n            is_valid_subsequence = True\n\n            for char in sub:\n                if char == '[':\n                    stack.append(char)\n                    current_depth += 1\n                    max_current_depth = max(max_current_depth, current_depth)\n                elif char == ']':\n                    if not stack:\n                        # Unmatched closing bracket, not a valid sequence\n                        is_valid_subsequence = False\n                        break\n                    stack.pop()\n                    current_depth -= 1\n            \n            # If the subsequence is valid (stack is empty and no unmatched closing brackets)\n            # and its maximum nesting depth is greater than 1, return True.\n            if is_valid_subsequence and not stack and max_current_depth > 1:\n                return True\n                \n    # If no such nested valid subsequence is found after checking all substrings\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    numbers = range(n + 1)\n    return ' '.join(map(str, numbers))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) of an array 'a'\n    where i < j < k, and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    a = [(idx + 1) * (idx + 1) - (idx + 1) + 1 for idx in range(n)]\n\n    count = 0\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                current_sum = a[i] + a[j] + a[k]\n                if current_sum % 3 == 0:\n                    count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n\n    def _validate_n(n_val):\n        # Validates if n_val is a positive integer.\n        if not isinstance(n_val, int) or n_val <= 0:\n            raise ValueError(\"n must be a positive integer.\")\n\n    def _count_starts_with_one(n_val):\n        # Calculates the count of n-digit positive integers that start with 1.\n        # The first digit is fixed as 1; the remaining n-1 digits can be any of 0-9.\n        return 10**(n_val - 1)\n\n    def _count_ends_with_one(n_val):\n        # Calculates the count of n-digit positive integers that end with 1.\n        if n_val == 1:\n            return 1\n        # The last digit is fixed as 1. The first digit has 9 options (1-9),\n        # and the middle n-2 digits have 10 options each (0-9).\n        return 9 * (10**(n_val - 2))\n\n    def _count_starts_and_ends_with_one(n_val):\n        # Calculates the count of n-digit positive integers that start AND end with 1.\n        if n_val == 1:\n            return 1\n        # The first and last digits are fixed as 1. The intermediate n-2 digits\n        # can be any of 0-9.\n        return 10**(n_val - 2)\n\n    _validate_n(n)\n\n    starts_count = _count_starts_with_one(n)\n    ends_count = _count_ends_with_one(n)\n    both_count = _count_starts_and_ends_with_one(n)\n\n    # Apply the inclusion-exclusion principle: Count(A or B) = Count(A) + Count(B) - Count(A and B).\n    total_count = starts_count + ends_count - both_count\n\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    memo = {}\n\n    def get_term(k):\n        \"\"\"Recursively calculates a single Tribonacci term tri(k) using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0 and k > 0: # Even n > 0\n            result = 1 + k // 2\n        elif k % 2 != 0 and k > 1: # Odd n > 1\n            # Handle forward dependency: tri(k+1) must be computed first\n            tri_k_plus_1 = get_term(k + 1)\n            tri_k_minus_1 = get_term(k - 1)\n            tri_k_minus_2 = get_term(k - 2)\n            result = tri_k_minus_1 + tri_k_minus_2 + tri_k_plus_1\n        # No else branch needed as all non-negative k are covered by the rules.\n\n        memo[k] = result\n        return result\n\n    # Determine the maximum k value that needs to be computed to resolve dependencies.\n    # If n is odd and greater than 1, tri(n) depends on tri(n+1).\n    max_k_to_compute = n\n    if n % 2 != 0 and n > 1:\n        max_k_to_compute = n + 1\n\n    # Populate the memoization cache for all necessary terms up to max_k_to_compute.\n    for k_val in range(max_k_to_compute + 1):\n        get_term(k_val)\n\n    # Extract the required sequence from tri(0) to tri(n).\n    result_list = [memo[i] for i in range(n + 1)]\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the special factorial of n, defined as n! * (n-1)! * ... * 1!.\"\"\"\n\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _factorial(i)\n    return special_fact_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}