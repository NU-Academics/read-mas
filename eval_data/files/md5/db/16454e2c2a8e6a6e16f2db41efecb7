{"task_id": "HumanEval/35", "solution": "def max_element(l: list) -> int:\n    \"\"\"\n    Return the maximum element in the list.\n\n    Parameters\n    ----------\n    l : list\n        List of comparable elements. The list must not be empty.\n\n    Returns\n    -------\n    int\n        The largest element in ``l``.\n\n    Raises\n    ------\n    ValueError\n        If ``l`` is empty.\n\n    Examples\n    --------\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty sequence\")\n    return max(l)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"\n    Return the number of times the digit 7 appears in integers less than ``n`` that\n    are divisible by 11 or 13.\n\n    Parameters\n    ----------\n    n : int\n        The upper bound (exclusive). ``n`` must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        The total count of digit ``7`` among all numbers x such that:\n        * 0 <= x < n\n        * x % 11 == 0  or  x % 13 == 0\n\n    Examples\n    --------\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    count = 0\n    for number in range(n):\n        if number % 11 == 0 or number % 13 == 0:\n            count += str(number).count(\"7\")\n    return count\n\n# Unit tests\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n    # Extra sanity checks\n    assert fizz_buzz(0) == 0\n    assert fizz_buzz(1) == 0\n    assert fizz_buzz(11) == 0\n    assert fizz_buzz(13) == 0\n    assert fizz_buzz(14) == 0\n    assert fizz_buzz(77) == 1  # 77 has one '7'\n    assert fizz_buzz(100) == 4  # 77 (1), 99 (0), 110 (1), 121 (0), 143 (1), 154 (0), 165 (0), 182 (0), 198 (0) but 77 only\n    print(\"All tests passed.\")"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"\n    Return a new list identical to ``l`` except that the values at even\n    indices are sorted while the values at odd indices remain the same.\n\n    Even indices are those with 0\u2011based index 0, 2, 4, \u2026.\n\n    Parameters\n    ----------\n    l : list\n        Input list containing comparable elements.\n\n    Returns\n    -------\n    list\n        A new list with sorted even\u2011indexed elements.\n\n    Examples\n    --------\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    >>> sort_even([])\n    []\n\n    Notes\n    -----\n    The function creates a shallow copy of the input list; the elements\n    themselves are not duplicated.\n    \"\"\"\n    # Identify even indices (0\u2011based)\n    even_indices = list(range(0, len(l), 2))\n    # Extract the even\u2011indexed values and sort them\n    sorted_even_values = sorted(l[i] for i in even_indices)\n    # Create a copy of the original list to avoid mutation\n    result = l.copy()\n    # Place the sorted values back into the result list at the even positions\n    for idx, val in zip(even_indices, sorted_even_values):\n        result[idx] = val\n    return result\n\n# Enable doctest execution when the module is run directly\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n"}
{"task_id": "HumanEval/38", "solution": "import string\nfrom typing import List\n\n\ndef encode_cyclic(s: str) -> str:\n    \"\"\"\n    Encode the string by cycling each group of three characters to the left.\n    Groups of fewer than three characters are left unchanged.\n    \"\"\"\n    groups: List[str] = [\n        s[3 * i : min(3 * i + 3, len(s))] for i in range((len(s) + 2) // 3)\n    ]\n    cycled = [(g[1:] + g[0]) if len(g) == 3 else g for g in groups]\n    return \"\".join(cycled)\n\n\ndef decode_cyclic(s: str) -> str:\n    \"\"\"\n    Reverse the encoding performed by `encode_cyclic`.\n    For each group of three characters, move the last character to the front.\n    Groups of fewer than three characters are left unchanged.\n    \"\"\"\n    groups: List[str] = [\n        s[3 * i : min(3 * i + 3, len(s))] for i in range((len(s) + 2) // 3)\n    ]\n    original = [(g[-1] + g[:-1]) if len(g) == 3 else g for g in groups]\n    return \"\".join(original)\n\n\n# Example usage and simple self\u2011test\nif __name__ == \"__main__\":\n    texts = [\n        \"abc\",\n        \"abcd\",\n        \"abcdef\",\n        \"\",\n        \"a\",\n        \"foobar\",\n        \"The quick brown fox jumps over the lazy dog\".replace(\" \", \"\"),\n    ]\n    for txt in texts:\n        encoded = encode_cyclic(txt)\n        decoded = decode_cyclic(encoded)\n        assert decoded == txt, f\"Failed: {txt} -> {encoded} -> {decoded}\"\n    print(\"All tests passed.\")\n"}
{"task_id": "HumanEval/39", "solution": "# numberanalyzer/__init__.py\n\"\"\"\nNumberAnalyzer public interface.\n\nProvides a convenience function `analyze(n: int) -> bool` which checks whether\nthe given number is simultaneously prime and Fibonacci.  The implementation\ndelegates to the stateless classes in `core.py`.\n\"\"\"\n\nfrom .core import NumberAnalyzer\n\n__all__ = [\"analyze\"]\n\ndef analyze(n: int) -> bool:\n    \"\"\"\n    Return True iff n is a prime number that is also a Fibonacci number.\n    Raises a ValueError if n is not a non\u2011negative integer.\n\n    Parameters\n    ----------\n    n : int\n        Integer to analyze.\n\n    Returns\n    -------\n    bool\n        True if n is prime and Fibonacci, False otherwise.\n    \"\"\"\n    return NumberAnalyzer().analyze(n)\n\n\n# numberanalyzer/core.py\n\"\"\"\nCore logic for the NumberAnalyzer package.\n\nThis module defines four small, stateless classes:\n\n* InputValidator \u2013 validates that the input is a non\u2011negative integer.  \n* PrimeTester   \u2013 implements deterministic primality testing using trial\n  division up to sqrt(n).  \n* FibonacciTester\n  \u2013 determines whether a number is a Fibonacci number using the 5*n^2\u00b14\n  perfect\u2011square trick.  \n* NumberAnalyzer \u2013 orchestrates the analysis pipeline.\n\nAll classes are pure\u2011functions with no side\u2011effects other than optional logging.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport logging\nfrom dataclasses import dataclass\nfrom typing import Any\n\nlog = logging.getLogger(__name__)\n\n\nclass InputValidator:\n    \"\"\"\n    Validates that an input is a non\u2011negative integer.\n\n    Parameters\n    ----------\n    n : int\n        The number to validate.\n\n    Raises\n    ------\n    ValueError\n        If `n` is not an instance of `int` or is negative.\n\n    Notes\n    -----\n    The method returns `None`; it merely raises if the input is invalid.\n    \"\"\"\n\n    @staticmethod\n    def validate(n: int) -> None:\n        if not isinstance(n, int):\n            raise ValueError(f\"Expected int, got {type(n).__name__}\")\n        if n < 0:\n            raise ValueError(\"Number must be non\u2011negative\")\n\n\nclass PrimeTester:\n    \"\"\"\n    Deterministic prime tester using trial division.\n\n    For `n <= 3` the result is returned early. For larger numbers the\n    algorithm tests divisibility up to `isqrt(n)`, skipping even numbers.\n\n    Complexity\n    ----------\n    O(sqrt(n)) time, O(1) space.\n    \"\"\"\n\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        if n < 2:\n            return False\n        if n in (2, 3):\n            return True\n        if n % 2 == 0:\n            return False\n        if n % 3 == 0:\n            return False\n\n        limit = math.isqrt(n)\n        i = 5\n        while i <= limit:\n            if n % i == 0:\n                return False\n            if n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n\nclass FibonacciTester:\n    \"\"\"\n    Tests whether a number is a Fibonacci number using the perfect\u2011square trick.\n\n    A positive integer n is Fibonacci iff\n      5*n^2 + 4   or   5*n^2 \u2013 4\n    is a perfect square.\n\n    Complexity\n    ----------\n    O(1) time and space.\n    \"\"\"\n\n    @staticmethod\n    def is_fibonacci(n: int) -> bool:\n        if n < 0:\n            return False\n        def is_perfect_square(x: int) -> bool:\n            root = math.isqrt(x)\n            return root * root == x\n\n        test1 = 5 * n * n + 4\n        test2 = 5 * n * n - 4\n        return is_perfect_square(test1) or is_perfect_square(test2)\n\n\n@dataclass\nclass NumberAnalyzer:\n    \"\"\"\n    Orchestrates validation and tests.\n\n    Provides the public method :py:meth:`analyze` which returns\n    `True` if `n` is both prime and a Fibonacci number.\n    \"\"\"\n\n    _validator: Any = InputValidator\n    _prime_tester: Any = PrimeTester\n    _fib_tester: Any = FibonacciTester\n\n    def analyze(self, n: int) -> bool:\n        \"\"\"\n        Validate `n` and return whether it is prime and a Fibonacci number.\n\n        Parameters\n        ----------\n        n : int\n            Number to analyze.\n\n        Returns\n        -------\n        bool\n            True if `n` is prime and Fibonacci, otherwise False.\n        \"\"\"\n        self._validator.validate(n)\n        if not self._prime_tester.is_prime(n):\n            return False\n        return self._fib_tester.is_fibonacci(n)\n\n\n# Optional CLI interface (numberanalyzer/cli.py)\n# \"\"\"\n# Provides `python -m numberanalyzer` command line entry point.\n#\n# Example:\n#   python -m numberanalyzer 34\n# \"\"\"\n\n# import argparse\n# import sys\n#\n# def main() -> None:\n#     parser = argparse.ArgumentParser(description=\"Check if a number is prime and Fibonacci.\")\n#     parser.add_argument(\"number\", type=int, help=\"Integer to analyze\")\n#     args = parser.parse_args()\n#\n#     result = analyze(args.number)\n#     print(f\"{args.number} is {'prime and Fibonacci' if result else 'not prime and Fibonacci'}\")\n#\n# if __name__ == \"__main__\":\n#     main()\n#\n\n# numberanalyzer/__main__.py\n# \"\"\"\n# Console script entry point.\n# \"\"\"\n\n# from . import analyze\n#\n# def main():\n#     import sys\n#     if len(sys.argv) != 2:\n#         print(\"Usage: python -m numberanalyzer <int>\")\n#         sys.exit(1)\n#     n = int(sys.argv[1])\n#     print(analyze(n))\n#\n# if __name__ == \"__main__\":\n#     main()\n"}
{"task_id": "HumanEval/40", "solution": "```python\nfrom __future__ import annotations\n\ndef triples_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    Return ``True`` if there exist three distinct indices ``i < j < k`` in\n    ``l`` such that ``l[i] + l[j] + l[k] == 0``, otherwise ``False``.\n    \n    The implementation runs in ``O(n * m)`` time and ``O(m)`` extra space,\n    where ``n`` is the length of the list and ``m`` is the number of\n    unique elements up to the current outer loop iteration.  This is\n    efficient for typical input sizes while keeping the code simple and\n    readable.\n\n    Parameters\n    ----------\n    l : list[int]\n        The list of integers to examine.\n\n    Returns\n    -------\n    bool\n        ``True`` if any three distinct elements sum to zero, ``False``\n        otherwise.\n\n    Examples\n    --------\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Pre-sort the list to allow the two-pointer technique while ensuring\n    # element indices are distinct. Sorting also improves early exits\n    # for large values.\n    l_sorted = sorted(l)\n    for i in range(n - 2):\n        # Skip duplicates for the first element to reduce work.\n        if i > 0 and l_sorted[i] == l_sorted[i - 1]:\n            continue\n        target = -l_sorted[i]\n        left, right = i + 1, n - 1\n\n        while left < right:\n            current = l_sorted[left] + l_sorted[right]\n            if current == target:\n                return True\n            if current < target:\n                left += 1\n            else:\n                right -= 1\n    return False\n\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n```\n"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Count collisions between two groups of cars moving in opposite directions.\n    \n    The scenario is a straight, infinitely long line.  Two sets of ``n`` cars\n    start far apart: the first set starts on the far left and moves rightward,\n    while the second set starts on the far right and moves leftward.  All\n    cars travel at the same constant speed, so the relative order of cars\n    within each set never changes.  Because each left\u2011to\u2011right car will meet\n    every right\u2011to\u2011left car exactly once, the total number of collisions is\n    simply the product of the number of cars in each group.\n    \n    Parameters\n    ----------\n    n : int\n        The number of cars in each group.  ``n`` may be zero.\n    \n    Returns\n    -------\n    int\n        Total number of collisions: ``n * n``.\n    \n    Examples\n    --------\n    >>> car_race_collision(3)\n    9\n    >>> car_race_collision(0)\n    0\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list[int]) -> list[int]:\n    \"\"\"Return a new list with each integer element incremented by 1.\n\n    Parameters\n    ----------\n    l : list[int]\n        A list of integers.\n\n    Returns\n    -------\n    list[int]\n        A new list containing each element of *l* incremented by one.\n\n    Raises\n    ------\n    TypeError\n        If *l* is not a list or contains a non\u2011integer element.\n\n    Examples\n    --------\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(f\"Expected a list, got {type(l).__name__}\")\n\n    for idx, val in enumerate(l):\n        if not isinstance(val, int):\n            raise TypeError(f\"Element at index {idx} is not an integer: {val!r}\")\n\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/43", "solution": "from typing import List\nimport unittest\n\n\ndef pairs_sum_to_zero(numbers: List[int]) -> bool:\n    \"\"\"\n    Return ``True`` if the list contains two distinct elements that sum to zero,\n    otherwise return ``False``.\n\n    The function iterates over the list once while maintaining a set of numbers\n    that have already been seen. For each element, its opposite (the complement)\n    is checked against this set; if the complement exists, the function can\n    immediately return ``True``.  This approach gives a linear time complexity\n    ``O(n)`` and linear additional space ``O(n)``.\n\n    :param numbers: List of integers.\n    :return: ``True`` if any two distinct elements sum to zero, otherwise ``False``.\n    \"\"\"\n    seen: set[int] = set()\n    for value in numbers:\n        complement = -value\n        if complement in seen:\n            return True\n        seen.add(value)\n    return False\n\n\nclass TestPairsSumToZero(unittest.TestCase):\n    def test_examples(self):\n        self.assertFalse(pairs_sum_to_zero([1, 3, 5, 0]))\n        self.assertFalse(pairs_sum_to_zero([1, 3, -2, 1]))\n        self.assertFalse(pairs_sum_to_zero([1, 2, 3, 7]))\n        self.assertTrue(pairs_sum_to_zero([2, 4, -5, 3, 5, 7]))\n        self.assertFalse(pairs_sum_to_zero([1]))\n\n    def test_zero_pairs(self):\n        self.assertTrue(pairs_sum_to_zero([0, 0]))\n        self.assertFalse(pairs_sum_to_zero([0]))\n        self.assertFalse(pairs_sum_to_zero([]))\n        self.assertTrue(pairs_sum_to_zero([5, -5]))\n        self.assertTrue(pairs_sum_to_zero([-10, 20, -10]))\n        self.assertFalse(pairs_sum_to_zero([3, 4, 5]))\n\n    def test_large_numbers(self):\n        self.assertTrue(pairs_sum_to_zero([10**12, -10**12]))\n        self.assertFalse(pairs_sum_to_zero([10**12, 10**12, -10**12 + 1]))\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Convert an integer ``x`` to a string representation in the specified ``base``.\n\n    Parameters\n    ----------\n    x : int\n        The integer to be converted.\n    base : int\n        The target base. Must be in the range ``2 <= base < 10``. Bases less than 2 or\n        greater than or equal to 10 are not supported because the function only\n        produces single\u2011digit characters (0\u20119) in the result.\n\n    Returns\n    -------\n    str\n        The representation of ``x`` in the given base. Negative numbers are\n        prefixed with a ``-`` sign.\n\n    Examples\n    --------\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    >>> change_base(-10, 2)\n    '-1010'\n    >>> change_base(0, 5)\n    '0'\n    \"\"\"\n    if base < 2 or base >= 10:\n        raise ValueError(\"base must be an integer in the range 2 <= base < 10\")\n\n    # Handle zero explicitly.\n    if x == 0:\n        return \"0\"\n\n    sign = \"-\" if x < 0 else \"\"\n    x = abs(x)\n\n    digits = []\n    while x:\n        digits.append(str(x % base))\n        x //= base\n\n    return sign + \"\".join(reversed(digits))"}
{"task_id": "HumanEval/45", "solution": "```python\n\"\"\"Utility functions for basic geometry calculations.\"\"\"\n\n__all__ = [\"triangle_area\"]\n\n\ndef triangle_area(base: float, height: float) -> float:\n    \"\"\"\n    Calculate the area of a triangle given the length of one side (the base)\n    and its height.\n\n    Parameters\n    ----------\n    base : float\n        Length of the triangle's base. Must be a positive number.\n    height : float\n        Height (altitude) of the triangle. Must be a positive number.\n\n    Returns\n    -------\n    float\n        The area of the triangle.\n\n    Raises\n    ------\n    ValueError\n        If either ``base`` or ``height`` is not positive.\n\n    Examples\n    --------\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if base <= 0:\n        raise ValueError(\"base must be a positive number\")\n    if height <= 0:\n        raise ValueError(\"height must be a positive number\")\n    return 0.5 * base * height\n\n\nif __name__ == \"__main__\":\n    import doctest\n\n    doctest.testmod()\n```"}
{"task_id": "HumanEval/46", "solution": "from collections import deque\nfrom typing import List\n\n\ndef fib4(n: int) -> int:\n    \"\"\"\n    Compute the n-th element of the Fib4 sequence.\n\n    The Fib4 sequence is defined as:\n        fib4(0) = 0\n        fib4(1) = 0\n        fib4(2) = 2\n        fib4(3) = 0\n        fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4)   for n >= 4\n\n    Parameters\n    ----------\n    n : int\n        The index of the desired element in the Fib4 sequence.\n\n    Returns\n    -------\n    int\n        The n-th Fib4 number.\n\n    Raises\n    ------\n    ValueError\n        If `n` is negative.\n\n    Examples\n    --------\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # Base cases for n = 0..3\n    base: List[int] = [0, 0, 2, 0]\n    if n < 4:\n        return base[n]\n\n    # Use a sliding window of the last four values\n    window = deque(base, maxlen=4)\n\n    for _ in range(4, n + 1):\n        next_value = sum(window)\n        window.append(next_value)\n\n    return window[-1]\n\n\nif __name__ == \"__main__\":\n    import doctest\n\n    doctest.testmod()\n    # Quick manual tests\n    assert fib4(0) == 0\n    assert fib4(1) == 0\n    assert fib4(2) == 2\n    assert fib4(3) == 0\n    assert fib4(4) == 2\n    assert fib4(5) == 4\n    assert fib4(6) == 8\n    assert fib4(10) == 32\n    print(\"All tests passed.\")"}
{"task_id": "HumanEval/47", "solution": "import math\nimport pytest\n\nfrom median import median  # adjust import path as necessary\n\n\nclass TestMedianFunction:\n    def test_odd_length_integers(self):\n        \"\"\"Median with an odd number of integer elements.\"\"\"\n        assert median([3, 1, 2, 4, 5]) == 3\n\n    def test_even_length_integers(self):\n        \"\"\"Median with an even number of integer elements results in a float.\"\"\"\n        result = median([-10, 4, 6, 1000, 10, 20])\n        assert isinstance(result, float)\n        assert math.isclose(result, 15.0, rel_tol=1e-9)\n\n    def test_even_length_floats(self):\n        \"\"\"Median with floats should return a float.\"\"\"\n        result = median([1.5, 3.2, 2.7, 5.0])\n        expected = (2.7 + 3.2) / 2\n        assert isinstance(result, float)\n        assert math.isclose(result, expected, rel_tol=1e-9)\n\n    def test_single_element(self):\n        \"\"\"Median of a single-element list is that element.\"\"\"\n        assert median([42]) == 42\n\n    def test_empty_list_raises_value_error(self):\n        \"\"\"Median of an empty list should raise ValueError.\"\"\"\n        with pytest.raises(ValueError):\n            median([])\n\n    def test_mixed_int_float(self):\n        \"\"\"Median with a mix of ints and floats should return a float.\"\"\"\n        result = median([1, 2.5, 3, 4.5])\n        expected = (2.5 + 3) / 2\n        assert isinstance(result, float)\n        assert math.isclose(result, expected, rel_tol=1e-9)\n\n    def test_negative_and_positive_values(self):\n        \"\"\"Median with negative and positive values.\"\"\"\n        result = median([-5, -1, 0, 1, 5])\n        assert result == 0\n\n    def test_all_negative_values_even(self):\n        \"\"\"Median with all negative values, even count.\"\"\"\n        median_val = median([-100, -50, -20, -10])\n        expected = (-50 + -20) / 2\n        assert isinstance(median_val, float)\n        assert math.isclose(median_val, expected, rel_tol=1e-9)\n\n    def test_non_numeric_raises_type_error(self):\n        \"\"\"Passing non-numeric items should raise TypeError.\"\"\"\n        with pytest.raises(TypeError):\n            median([1, 'a', 3])\n\n    def test_large_numbers(self):\n        \"\"\"Check median calculation with very large numbers.\"\"\"\n        large = 10**12\n        result = median([0, large, large * 2])\n        assert result == large\n\n    def test_precision_for_even_count(self):\n        \"\"\"Verify precision when median is not an integer.\"\"\"\n        result = median([0, 1, 1e-10, 2])\n        expected = (1 + 1e-10) / 2\n        assert isinstance(result, float)\n        assert math.isclose(result, expected, rel_tol=1e-9)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if a given string is a palindrome, ignoring case and\n    non\u2011alphanumeric characters.\n\n    Parameters\n    ----------\n    text : str\n        The input string to check.\n\n    Returns\n    -------\n    bool\n        True if ``text`` is a palindrome, False otherwise.\n\n    Examples\n    --------\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    >>> is_palindrome('A man, a plan, a canal: Panama')\n    True\n    \"\"\"\n    import re\n\n    cleaned = re.sub(r'[^A-Za-z0-9]', '', text).lower()\n    return cleaned == cleaned[::-1]\n"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"\n    Calculates 2^n modulo p.\n\n    This function efficiently computes (2 raised to the power of n) % p\n    using Python's built-in `pow()` function with three arguments.\n    It performs input validation to ensure `p` is a positive integer and `n`\n    is a non-negative integer.\n\n    Args:\n        n (int): The non-negative integer exponent.\n        p (int): The positive integer modulus.\n\n    Returns:\n        int: The result of 2^n modulo p.\n\n    Raises:\n        ValueError: If 'p' is not a positive integer or if 'n' is negative.\n\n    Examples:\n        >>> modp(3, 5)\n        3  # (2^3) % 5 = 8 % 5 = 3\n        >>> modp(0, 7)\n        1  # (2^0) % 7 = 1 % 7 = 1\n        >>> modp(10, 100)\n        24 # (2^10) % 100 = 1024 % 100 = 24\n        >>> modp(1, 2)\n        0  # (2^1) % 2 = 2 % 2 = 0\n    \"\"\"\n    if p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    if n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n\n    return pow(2, n, p)"}
{"task_id": "HumanEval/50", "solution": "def encode_shift(s: str) -> str:\n    \"\"\"\n    Returns encoded string by shifting every character by 5 in the alphabet.\n\n    This function treats the string as a sequence of characters and applies a\n    Caesar cipher shift of +5 to each one, wrapping around the alphabet.\n    Characters are processed without verifying that they are alphabetic;\n    the algorithm simply performs the modular arithmetic on the Unicode code\n    point relative to 'a'.\n\n    >>> encode_shift('abc')  # doctest: +NORMALIZE_WHITESPACE\n    'fgh'\n    \"\"\"\n    return \"\".join(\n        chr(((ord(ch) + 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s\n    )\n\n\ndef decode_shift(s: str) -> str:\n    \"\"\"\n    Takes a string encoded with `encode_shift` and returns the original string.\n\n    The function reverses the transformation performed by `encode_shift`,\n    shifting every character by -5 in the alphabet, again wrapping around.\n    Non-alphabetic characters are processed in the same way as in\n    `encode_shift`, ensuring that if the string was produced by that\n    function the inverse yields the original input.\n\n    >>> decode_shift('fgh')  # doctest: +NORMALIZE_WHITESPACE\n    'abc'\n    \"\"\"\n    return \"\".join(\n        chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s\n    )"}
