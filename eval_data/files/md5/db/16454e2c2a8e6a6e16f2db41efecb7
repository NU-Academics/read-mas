{"task_id": "HumanEval/64", "solution": "import sys\nfrom abc import ABC, abstractmethod\nfrom collections import defaultdict\n\n# --- Domain Layer ---\n\nclass VowelSet:\n    \"\"\"Value object representing a set of characters considered vowels.\"\"\"\n    def __init__(self, vowels: set[str]):\n        if not all(isinstance(v, str) and len(v) == 1 for v in vowels):\n            raise ValueError(\"All vowels in VowelSet must be single character strings.\")\n        self._vowels = frozenset(vowel.lower() for vowel in vowels)\n\n    def is_vowel(self, char: str) -> bool:\n        if not isinstance(char, str) or len(char) != 1:\n            return False\n        return char.lower() in self._vowels\n\n    def get_vowels(self) -> frozenset[str]:\n        return self._vowels\n\n\nclass VowelCounterService:\n    \"\"\"Core domain service for counting vowels in a given text.\"\"\"\n    def __init__(self, vowel_set: VowelSet):\n        if not isinstance(vowel_set, VowelSet):\n            raise TypeError(\"vowel_set must be an instance of VowelSet.\")\n        self._vowel_set = vowel_set\n\n    def count_vowels(self, text: str) -> dict[str, int]:\n        if not isinstance(text, str):\n            raise TypeError(\"Input text must be a string.\")\n\n        counts = defaultdict(int)\n        for char in text:\n            if self._vowel_set.is_vowel(char):\n                counts[char.lower()] += 1\n\n        result_dict = {vowel: counts[vowel] for vowel in sorted(self._vowel_set.get_vowels())}\n        return result_dict\n\n\n# --- Application Layer ---\n\nclass CountVowelsUseCase:\n    def __init__(self, vowel_counter_service: VowelCounterService):\n        if not isinstance(vowel_counter_service, VowelCounterService):\n            raise TypeError(\"vowel_counter_service must be an instance of VowelCounterService.\")\n        self._vowel_counter_service = vowel_counter_service\n\n    def execute(self, text: str) -> dict[str, int]:\n        return self._vowel_counter_service.count_vowels(text)\n\n\n# --- Interface Adapters Layer ---\n\nclass OutputPort(ABC):\n    @abstractmethod\n    def present_result(self, result: dict[str, int]):\n        pass\n\n\nclass ConsoleOutputPresenter(OutputPort):\n    def present_result(self, result: dict[str, int]):\n        print(\"Vowel Counts:\")\n        if not result:\n            print(\"  No vowels found or defined.\")\n            return\n\n        for vowel, count in result.items():\n            print(f\"  {vowel.upper()}: {count}\")\n\n\n# --- Frameworks & Drivers Layer (Main Application Setup) ---\n\ndef _get_input_text_from_args_or_stdin() -> str:\n    if len(sys.argv) > 1:\n        return sys.argv[1]\n    elif not sys.stdin.isatty():\n        return sys.stdin.read()\n    else:\n        return \"\"\n\n\ndef main():\n    input_text = _get_input_text_from_args_or_stdin()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    vowel_set = VowelSet(standard_vowels)\n    vowel_counter_service = VowelCounterService(vowel_set)\n    count_vowels_use_case = CountVowelsUseCase(vowel_counter_service)\n    console_output_presenter = ConsoleOutputPresenter()\n\n    try:\n        vowel_counts = count_vowels_use_case.execute(input_text)\n        console_output_presenter.present_result(vowel_counts)\n    except (TypeError, ValueError) as e:\n        print(f\"Application Error: {e}\", file=sys.stderr)\n        sys.exit(1)\n    except Exception as e:\n        print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circular shift the digits of the integer *x*, shifting the digits right by *shift*\n    and return the result as a string.\n\n    If *shift* is greater than the number of digits, return the digits in reversed\n    order.\n\n    Parameters\n    ----------\n    x : int\n        The integer whose digits will be circularly shifted.\n    shift : int\n        The number of positions to shift the digits to the right.\n\n    Returns\n    -------\n    str\n        The circularly shifted digits as a string. Negative numbers are treated\n        by preserving the leading minus sign.\n\n    Examples\n    --------\n    >>> circular_shift(12, 1)\n    '21'\n    >>> circular_shift(12, 2)\n    '12'\n    >>> circular_shift(12345, 3)\n    '51234'\n    >>> circular_shift(-123, 1)\n    '-312'\n    \"\"\"\n    if shift == 0:\n        return str(x)\n\n    # Handle sign separately so that negative numbers keep the minus sign.\n    sign = \"-\" if x < 0 else \"\"\n    digits = str(abs(x))\n\n    n = len(digits)\n\n    if shift > n:\n        # Return digits reversed\n        return f\"{sign}{digits[::-1]}\"\n\n    # Normal circular shift\n    shift %= n  # Normalizing shift if it's a multiple of n or larger\n    if shift == 0:\n        return f\"{sign}{digits}\"\n\n    shifted = digits[-shift:] + digits[:-shift]\n    return f\"{sign}{shifted}\""}
