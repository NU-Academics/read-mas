{"task_id": "Mbpp/103", "solution": "class InputParameters:\n    \"\"\"Data carrier for (n, m) inputs.\"\"\"\n    def __init__(self, n: int, m: int):\n        self.n = n\n        self.m = m\nclass EulerianNumber:\n    \"\"\"Data carrier for the computed Eulerian number result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass ValidationResult:\n    \"\"\"Conveys validation success/failure and an optional error message.\"\"\"\n    def __init__(self, is_valid: bool, error_message: str = \"\"):\n        self.is_valid = is_valid\n        self.error_message = error_message\nclass EulerianCalculator:\n    \"\"\"Encapsulates validation and computation algorithms for Eulerian numbers.\"\"\"\n\n    _dp_cache = {} # Class-level cache for dynamic programming results\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Validates inputs and computes the Eulerian number a(n, m).\"\"\"\n        params = InputParameters(n, m)\n        validation = self._validate_inputs(params)\n\n        if not validation.is_valid:\n            raise ValueError(validation.error_message)\n\n        # Compute using the dynamic programming approach\n        result_value = self.compute_dp(params.n, params.m)\n        return EulerianNumber(result_value).value\n\n    def _validate_inputs(self, params: InputParameters) -> ValidationResult:\n        \"\"\"Validates the type and domain constraints of n and m.\"\"\"\n        n, m = params.n, params.m\n\n        if not isinstance(n, int) or not isinstance(m, int):\n            return ValidationResult(False, \"Inputs n and m must be integers.\")\n        if n < 0:\n            return ValidationResult(False, \"Input n must be non-negative.\")\n\n        # Special base case for n=0: only A(0,0)=1 is defined.\n        if n == 0:\n            if m != 0:\n                return ValidationResult(False, \"For n=0, input m must be 0 (Eulerian number A(0,0)=1).\")\n        # For n >= 1, m must be within [0, n-1].\n        elif not (0 <= m <= n - 1):\n            return ValidationResult(False, f\"For n={n} (n >= 1), m must be between 0 and {n-1} inclusive.\")\n        \n        return ValidationResult(True)\n\n    def compute_dp(self, n: int, m: int) -> int:\n        \"\"\"Computes a(n, m) using dynamic programming with memoization.\"\"\"\n        if (n, m) in self._dp_cache:\n            return self._dp_cache[(n, m)]\n\n        # Base cases for the Eulerian number formula\n        if n == 0 and m == 0:\n            self._dp_cache[(n, m)] = 1\n            return 1\n        # Terms where m is out of valid range (A(n, m) = 0 if m < 0 or m >= n)\n        if m < 0 or m >= n:\n            return 0 \n\n        # Recursive step with memoization\n        res = (m + 1) * self.compute_dp(n - 1, m) + (n - m) * self.compute_dp(n - 1, m - 1)\n        self._dp_cache[(n, m)] = res\n        return res\n\n    def compute_recursive(self, n: int, m: int) -> int:\n        \"\"\"Computes a(n, m) using direct recursion without memoization.\"\"\"\n        # Base cases where A(n, m) = 0 for invalid m values.\n        if m < 0 or m >= n:\n            return 0\n        \n        # Base case A(0,0) = 1.\n        if n == 0 and m == 0:\n            return 1\n        \n        # Standard Eulerian number recursive formula.\n        return (m + 1) * self.compute_recursive(n - 1, m) + (n - m) * self.compute_recursive(n - 1, m - 1)\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Public API function to compute the Eulerian number a(n, m).\n    It validates inputs and raises ValueError for invalid inputs.\n    \"\"\"\n    calculator = EulerianCalculator()\n    return calculator.eulerian_num(n, m)"}
{"task_id": "Mbpp/104", "solution": "\ndef test_empty_sublist():\n    \"\"\"\n    Tests behavior with empty inner lists and an empty outer list.\n    Empty lists should remain empty, and their original order preserved.\n    \"\"\"\n    assert sort_sublists([[], [\"a\"]]) == [[], [\"a\"]]\n    assert sort_sublists([]) == []\n    assert sort_sublists(((), (\"b\",))) == [[], [\"b\"]]\n    assert sort_sublists([[\"\"], [\"b\", \"a\"]]) == [[\"\"], [\"a\", \"b\"]]\n\n\ndef test_preserve_outer_order():\n    \"\"\"\n    Verifies that the order of sublists in the output matches the input order.\n    The outer structure's sequence is always maintained.\n    \"\"\"\n    input_sequence = [[\"z\", \"a\"], [\"b\", \"c\"], [\"x\", \"y\"]]\n    expected_output = [[\"a\", \"z\"], [\"b\", \"c\"], [\"x\", \"y\"]]\n    assert sort_sublists(input_sequence) == expected_output\n\n    input_sequence_tuple = ((\"z\", \"a\"), (\"b\", \"c\"))\n    expected_output_tuple = [[\"a\", \"z\"], [\"b\", \"c\"]]\n    assert sort_sublists(input_sequence_tuple) == expected_output_tuple\n\ndef test_single_element_sublist():\n    \"\"\"\n    Tests handling of sublists containing only a single string.\n    Such sublists should remain unchanged.\n    \"\"\"\n    assert sort_sublists([[\"apple\"], [\"banana\", \"orange\"]]) == [[\"apple\"], [\"banana\", \"orange\"]]\n    assert sort_sublists(((\"single\",), (\"another\", \"item\"))) == [[\"single\"], [\"another\", \"item\"]]\n\ndef test_invalid_outer_type():\n    \"\"\"\n    Ensures a TypeError is raised when the outer container is not a list or tuple.\n    Tests various invalid types like string, integer, dictionary, and set.\n    \"\"\"\n    with pytest.raises(TypeError, match=\"Outer container must be a list or tuple.\"):\n        sort_sublists(\"not a list\")\n    with pytest.raises(TypeError, match=\"Outer container must be a list or tuple.\"):\n        sort_sublists(123)\n    with pytest.raises(TypeError, match=\"Outer container must be a list or tuple.\"):\n        sort_sublists({1: [\"a\"]}) # dictionary\n    with pytest.raises(TypeError, match=\"Outer container must be a list or tuple.\"):\n        sort_sublists(set([\"a\"])) # set\n\ndef test_invalid_inner_type_sublist_not_sequence():\n    \"\"\"\n    Ensures a TypeError is raised when a sublist itself is not a sequence.\n    Tests with an integer, a dictionary, and a set as sublist entries.\n    \"\"\"\n    with pytest.raises(TypeError, match=\"Sublist at index 0 must be a sequence\"):\n        sort_sublists([123, [\"a\"]])\n    with pytest.raises(TypeError, match=\"Sublist at index 1 must be a sequence\"):\n        sort_sublists([[\"a\"], \"not a list\"]) # string as sublist is invalid\n    with pytest.raises(TypeError, match=\"Sublist at index 0 must be a sequence\"):\n        sort_sublists([{}, [\"a\"]]) # dictionary as sublist\n    with pytest.raises(TypeError, match=\"Sublist at index 0 must be a sequence\"):\n        sort_sublists([set([\"a\"]), [\"b\"]]) # set as sublist\n\n\ndef test_invalid_inner_type_elements_not_strings():\n    \"\"\"\n    Ensures a TypeError is raised when sublist elements are not strings.\n    Tests with integers, None, booleans, and mixed types within sublists.\n    \"\"\"\n    with pytest.raises(TypeError, match=\"Element at sublist\\\\[0\\\\]\\\\[0\\\\] must be a string.\"):\n        sort_sublists([[1, \"a\"]])\n    with pytest.raises(TypeError, match=\"Element at sublist\\\\[0\\\\]\\\\[1\\\\] must be a string.\"):\n        sort_sublists([[\"a\", None]])\n    with pytest.raises(TypeError, match=\"Element at sublist\\\\[1\\\\]\\\\[0\\\\] must be a string.\"):\n        sort_sublists([[\"a\"], [True]])\n    with pytest.raises(TypeError, match=\"Element at sublist\\\\[0\\\\]\\\\[0\\\\] must be a string.\"):\n        sort_sublists([[1.0, \"a\"], [\"b\", \"c\"]])\n    with pytest.raises(TypeError, match=\"Element at sublist\\\\[0\\\\]\\\\[0\\\\] must be a string.\"):\n        sort_sublists([[\"hello\", \"world\"], [1]]) # integer element\n\n\ndef test_different_sequence_types_inner():\n    \"\"\"\n    Verifies that the function correctly handles various inner sequence types (e.g., tuples).\n    The output should always be a list of lists, converting inner sequences if necessary.\n    \"\"\"\n    input_sequence = [(\"z\", \"a\"), (\"b\", \"c\")]\n    expected_output = [[\"a\", \"z\"], [\"b\", \"c\"]]\n    assert sort_sublists(input_sequence) == expected_output\n\n    input_sequence_mixed_outer = ([\"d\", \"e\"], (\"a\", \"b\"))\n    expected_output_mixed_outer = [[\"d\", \"e\"], [\"a\", \"b\"]]\n    assert sort_sublists(input_sequence_mixed_outer) == expected_output_mixed_outer\n\n    input_sequence_mixed_inner = [(\"c\", \"a\", \"b\"), [\"z\", \"y\", \"x\"]]\n    expected_output_mixed_inner = [[\"a\", \"b\", \"c\"], [\"x\", \"y\", \"z\"]]\n    assert sort_sublists(input_sequence_mixed_inner) == expected_output_mixed_inner"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\ndef sort_sublists(input_sequence: Sequence[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in ascending lexicographic order.\n    Returns a new list of lists, ensuring the input sequence remains unchanged.\"\"\"\n\n    # Create a new list to hold the sorted sublists.\n    sorted_outer_list: List[List[str]] = []\n\n    # Iterate through each sublist in the provided input sequence.\n    for sublist in input_sequence:\n        # Sort a copy of the current sublist and append it to the result.\n        sorted_outer_list.append(sorted(sublist))\n            \n    return sorted_outer_list"}
