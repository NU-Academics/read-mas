{"task_id": "Mbpp/102", "solution": "class InputString:\n    \"\"\"Holds the input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass Segment:\n    \"\"\"Encapsulates a string segment and provides capitalization.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def capitalize_first_letter(self) -> str:\n        \"\"\"Returns the segment with its first character uppercased and the remainder unchanged.\"\"\"\n        if not self.value:\n            return \"\"\n        return self.value[0].upper() + self.value[1:]\nclass OutputString:\n    \"\"\"Holds the resulting output string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\ndef snake_to_camel(input: str) -> str:\n    \"\"\"\n    Converts a snake_case string to CamelCase.\n    Splits on '_', capitalizes the first letter of each segment, and concatenates them.\n    \"\"\"\n    input_obj = InputString(input)\n    segments_raw = input_obj.value.split('_')\n    \n    capitalized_segments = []\n    for segment_str in segments_raw:\n        segment_obj = Segment(segment_str)\n        capitalized_segments.append(segment_obj.capitalize_first_letter())\n    \n    result_str = \"\".join(capitalized_segments)\n    output_obj = OutputString(result_str)\n    \n    return output_obj.value"}
{"task_id": "Mbpp/102", "solution": "def capitalize(segment: str) -> str:\n    \"\"\"Capitalizes the first letter of a segment, leaving others unchanged.\n    Returns an empty string if the segment is empty.\n    \"\"\"\n    if not segment:\n        return ''\n    return segment[0].upper() + segment[1:]\ndef split(input: str) -> list[str]:\n    \"\"\"Splits the input string by underscores, returning a list of segments.\"\"\"\n    return input.split('_')\ndef concatenate(segments: list[str]) -> str:\n    \"\"\"Concatenates a list of segments into a single string without separators.\"\"\"\n    return ''.join(segments)\ndef snake_to_camel(input: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase.\n    Splits by '_', capitalizes non-empty segments, and concatenates them.\n    \"\"\"\n    segments = split(input)\n    \n    camel_segments = []\n    for segment in segments:\n        if segment:\n            camel_segments.append(capitalize(segment))\n            \n    return concatenate(camel_segments)"}
