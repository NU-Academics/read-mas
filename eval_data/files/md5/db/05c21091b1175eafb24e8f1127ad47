{"task_id": "Mbpp/247", "solution": "from typing import List, Optional\nclass InputString:\n    \"\"\"Immutable holder for the input string.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    @property\n    def value(self) -> str:\n        return self._value\nclass Result:\n    \"\"\"Immutable holder for the returned integer length.\"\"\"\n    def __init__(self, length: int):\n        self._length = length\n\n    @property\n    def length(self) -> int:\n        return self._length\nclass LPSFunction:\n    \"\"\"Orchestrates validation and DP computation for LPS length.\"\"\"\n\n    _input: Optional[InputString]\n    _dp_buffer: Optional[List[List[int]]]\n\n    def __init__(self):\n        self._input = None\n        self._dp_buffer = None\n\n    def validateInput(self, input_str: str) -> bool:\n        \"\"\"Validates that the input is a string. Raises TypeError if not.\"\"\"\n        if not isinstance(input_str, str):\n            raise TypeError(\"Input must be a string.\")\n        return True\n\n    def lps(self, input_str: str) -> int:\n        \"\"\"Computes the length of the longest palindromic subsequence.\"\"\"\n        self.validateInput(input_str)\n\n        self._input = InputString(input_str)\n        s = self._input.value\n        n = len(s)\n\n        if n == 0:\n            return Result(0).length\n\n        # dp[i][j] stores the length of the LPS for substring s[i...j].\n        self._dp_buffer = [[0 for _ in range(n)] for _ in range(n)]\n\n        # All substrings of length 1 are palindromes of length 1.\n        for i in range(n):\n            self._dp_buffer[i][i] = 1\n\n        # Fill the table for lengths from 2 to n.\n        for current_len in range(2, n + 1):\n            for i in range(n - current_len + 1):\n                j = i + current_len - 1\n                if s[i] == s[j]:\n                    # If characters match, add 2 to LPS of inner substring.\n                    if current_len == 2:\n                        self._dp_buffer[i][j] = 2\n                    else:\n                        self._dp_buffer[i][j] = 2 + self._dp_buffer[i + 1][j - 1]\n                else:\n                    # If characters don't match, take max of excluding s[i] or s[j].\n                    self._dp_buffer[i][j] = max(self._dp_buffer[i + 1][j], self._dp_buffer[i][j - 1])\n        \n        # The result is the value for the entire string s[0...n-1].\n        result_length = self._dp_buffer[0][n - 1]\n\n        # Clean up ephemeral buffers.\n        self._input = None\n        self._dp_buffer = None\n\n        return Result(result_length).length\ndef lps(input: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence.\n    Delegates to LPSFunction for validation and computation.\n    \"\"\"\n    worker = LPSFunction()\n    return worker.lps(input)"}
