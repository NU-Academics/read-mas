{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq1, seq2) -> bool:\n    \"\"\"\n    Checks if seq1 follows the structural pattern defined by seq2 by enforcing a bijective mapping.\n    Returns True if a consistent one-to-one mapping exists for all elements, False otherwise or if lengths differ.\n    \"\"\"\n    if len(seq1) != len(seq2):\n        return False\n\n    map_seq_to_pat = {}\n    map_pat_to_seq = {}\n\n    for i in range(len(seq1)):\n        seq_elem = seq1[i]\n        pat_token = seq2[i]\n\n        # Check consistency for seq_elem to pat_token mapping\n        if seq_elem in map_seq_to_pat:\n            if map_seq_to_pat[seq_elem] != pat_token:\n                return False  # Existing mapping for seq_elem conflicts with current pat_token\n        else:\n            map_seq_to_pat[seq_elem] = pat_token\n\n        # Check consistency for pat_token to seq_elem mapping (bijection)\n        if pat_token in map_pat_to_seq:\n            if map_pat_to_seq[pat_token] != seq_elem:\n                return False  # Existing mapping for pat_token conflicts with current seq_elem\n        else:\n            map_pat_to_seq[pat_token] = seq_elem\n\n    return True"}
