lacement_obj.value())\n        else:\n            result_chars.append(char)\n\n    final_result_str = \"\".join(result_chars)\n    result_obj = ResultString(final_result_str)\n\n    return result_obj.value()"}
{"task_id": "Mbpp/230", "solution": "class InputString:\n    def __init__(self, value: str) -> None:\n        \"\"\"Initializes InputString with a string value.\"\"\"\n        self.value = value\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the input string is empty.\"\"\"\n        return not self.value\nclass ReplacementCharacter:\n    def __init__(self, value: str) -> None:\n        \"\"\"Initializes ReplacementCharacter with a string value.\"\"\"\n        self.value = value\n\n    def isSingleChar(self) -> bool:\n        \"\"\"Checks if the replacement character is a single character.\"\"\"\n        return len(self.value) == 1\nclass ReplaceBlankFunction:\n    def __init__(self, input_string: str, replacement_char: str) -> None:\n        \"\"\"Initializes the operation with input and replacement values.\"\"\"\n        self.input_string_raw = input_string\n        self.replacement_char_raw = replacement_char\n        self.output_string = \"\"\n\n    def execute(self) -> str:\n        \"\"\"Performs the blank space replacement operation.\"\"\"\n        inp = InputString(self.input_string_raw)\n        rep = ReplacementCharacter(self.replacement_char_raw)\n\n        if inp.isEmpty():\n            self.output_string = \"\"\n            return self.output_string\n\n        result_chars = []\n        for ch in inp.value:\n            if ch == ' ':\n                result_chars.append(rep.value)\n            else:\n                result_chars.append(ch)\n\n        self.output_string = ''.join(result_chars)\n        return self.output_string\ndef replace_blank(input_string: str, replacement_char: str) -> str:\n    \"\"\"Public API: replaces ASCII space (' ') with replacement_char in input_string.\"\"\"\n    rbf = ReplaceBlankFunction(input_string, replacement_char)\n    return rbf.execute()"}
