{"task_id": "Mbpp/790", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass EvenPositionFunction:\n    \"\"\"Encapsulates the algorithm and validation for checking parity at even indices.\"\"\"\n\n    def even_position(self, lst: List[int]) -> bool:\n        \"\"\"Validates input and evaluates even indices, returning a boolean result.\"\"\"\n        self.validate_input(lst)\n        result = self.evaluate_even_indices(lst)\n        return result.value\n\n    def validate_input(self, lst: List[int]) -> None:\n        \"\"\"Raises TypeError if lst is not a list or contains non-integer elements.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"lst must be a list.\")\n        for v in lst:\n            if not isinstance(v, int):\n                raise TypeError(\"All elements of lst must be integers.\")\n\n    def evaluate_even_indices(self, lst: List[int]) -> Result:\n        \"\"\"Iterates even indices (0, 2, 4, ...) and checks element parity.\"\"\"\n        for i in range(0, len(lst), 2):\n            elem = Element(value=lst[i], index=i)\n            if not elem.is_even():\n                return Result(value=False)\n        return Result(value=True)\ndef even_position(lst: List[int]) -> bool:\n    \"\"\"\n    Public API. Checks if every element at an even index in lst is an even integer.\n    Delegates the core logic and validation to EvenPositionFunction.\n    \"\"\"\n    return EvenPositionFunction().even_position(lst)"}
{"task_id": "Mbpp/790", "solution": "class EvenIndexChecker:\n    \"\"\"Performs parity checks on elements at even indices.\"\"\"\n\n    def allEvenAtEvenIndices(self, list_of_ints: list) -> bool:\n        \"\"\"\n        Checks if all elements at even indices in the list are even integers.\n        Returns True if all are even or the list is empty; False otherwise.\n        \"\"\"\n        for i in range(0, len(list_of_ints), 2):\n            if list_of_ints[i] % 2 != 0:\n                return False\n        return True\ndef even_position(input_list: list) -> bool:\n    \"\"\"\n    Determines if every element at an even (zero-based) index in the list is an even integer.\n    Delegates the core logic to an EvenIndexChecker instance.\n    \"\"\"\n    checker = EvenIndexChecker()\n    return checker.allEvenAtEvenIndices(input_list)"}
