{"task_id": "Mbpp/67", "solution": "class InputParameter:\n    \"\"\"Value object representing the input n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n: int = n\nclass BellNumberResult:\n    \"\"\"Value object wrapping the computed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\nclass BellNumberCalculator:\n    \"\"\"Computes nth Bell number using the Bell triangle algorithm.\"\"\"\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 1\n\n        # Initialize the first row of the Bell triangle.\n        row = [1]\n        \n        # Iterate to construct subsequent rows up to n.\n        for i in range(1, n + 1):\n            # Start the new row with the last element of the previous row.\n            new_row = [row[-1]]\n            # Populate the rest of the new row using sums from the previous row.\n            for j in range(len(row)):\n                new_row.append(new_row[-1] + row[j])\n            row = new_row\n        \n        # The first element of the last computed row is the nth Bell number.\n        return row[0]\nclass BellNumberFunction:\n    \"\"\"\n    Facade/coordinator for Bell number computation.\n    Coordinates input processing, calculation, and result wrapping.\n    \"\"\"\n    def bell_number(self, n: int) -> int:\n        # Input validation is omitted as per critical requirements.\n        input_param = InputParameter(n)\n        \n        calculator = BellNumberCalculator()\n        computed_value = calculator.compute(input_param.n)\n        \n        result = BellNumberResult(computed_value)\n        return result.value\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Public API function to compute the nth Bell number.\n    Delegates the actual computation to BellNumberFunction.\n    \"\"\"\n    facade = BellNumberFunction()\n    return facade.bell_number(n)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"Checks if an array is monotonic (non-increasing or non-decreasing).\n    Empty or single-element lists are considered monotonic.\"\"\"\n\n    if len(array) <= 1:\n        return True\n\n    def _is_non_decreasing(arr):\n        \"\"\"Internal helper to check if the array is non-decreasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr):\n        \"\"\"Internal helper to check if the array is non-increasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n\n    return _is_non_decreasing(array) or _is_non_increasing(array)"}
