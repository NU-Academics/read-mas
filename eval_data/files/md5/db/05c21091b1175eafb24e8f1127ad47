{"task_id": "Mbpp/394", "solution": "def _is_hashable(value: any) -> bool:\n    \"\"\"Return True if value is hashable, False otherwise.\"\"\"\n    try:\n        hash(value)\n        return True\n    except TypeError:\n        return False\ndef check_distinct(input: tuple) -> bool:\n    \"\"\"Checks if a tuple contains duplicate elements.\n    Returns True if no duplicates, False otherwise.\n    \"\"\"\n    seen_hashable = set()\n    seen_unhashable = []\n\n    for element in input:\n        if _is_hashable(element):\n            if element in seen_hashable:\n                return False\n            seen_hashable.add(element)\n        else:\n            if element in seen_unhashable:\n                return False\n            seen_unhashable.append(element)\n            \n    return True"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Any, Dict\nclass NestedDictionary:\n    \"\"\"Data holder for outer_key, inner_key, value. Provides dictionary conversion.\"\"\"\n    def __init__(self, outer_key: Any, inner_key: Any, value: Any):\n        self.outer_key = outer_key\n        self.inner_key = inner_key\n        self.value = value\n\n    def to_dict(self) -> Dict:\n        \"\"\"Returns the nested dictionary representation.\"\"\"\n        return {self.outer_key: {self.inner_key: self.value}}\nclass Validator:\n    \"\"\"Stateless validation for list lengths and key hashability.\"\"\"\n    def validate_lengths(self, a: List, b: List, c: List) -> None:\n        \"\"\"Raises ValueError if input list lengths are not equal.\"\"\"\n        if not (len(a) == len(b) == len(c)):\n            raise ValueError(\"Input lists must have the same length.\")\n\n    def validate_hashable(self, key: Any) -> None:\n        \"\"\"Raises TypeError if the provided key is not hashable.\"\"\"\n        try:\n            hash(key)\n        except TypeError:\n            raise TypeError(f\"Key '{key}' (type: {type(key).__name__}) is not hashable.\")\nclass ConvertListDictionary:\n    \"\"\"Encapsulates the core conversion algorithm.\"\"\"\n    def __init__(self, validator: Validator):\n        self._validator = validator\n\n    def convert(self, keys: List, names: List, values: List) -> List:\n        \"\"\"Iterates and produces an ordered list of nested dictionaries.\"\"\"\n        result_list = []\n        for i in range(len(keys)):\n            nested_dict_item = NestedDictionary(keys[i], names[i], values[i])\n            result_list.append(nested_dict_item.to_dict())\n        return result_list\ndef convert_list_dictionary(keys: List, names: List, values: List) -> List:\n    \"\"\"Public API: validate inputs then return a list where each element is { keys[i]: { names[i]: values[i] } }.\n    Raises ValueError for unequal list lengths and TypeError for unhashable keys.\n    \"\"\"\n    validator = Validator()\n    converter = ConvertListDictionary(validator)\n\n    validator.validate_lengths(keys, names, values)\n\n    for k in keys:\n        validator.validate_hashable(k)\n    for n in names:\n        validator.validate_hashable(n)\n\n    return converter.convert(keys, names, values)"}
