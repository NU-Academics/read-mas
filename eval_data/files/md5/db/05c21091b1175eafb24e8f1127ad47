{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Union, Iterator, Optional\nfrom dataclasses import dataclass\nNumber = Union[int, float]\nclass TupleList:\n    \"\"\"A container for ordered list of Tuple objects.\"\"\"\n    def __init__(self, tuples_input: Optional[List[tuple]] = None) -> None:\n        self._tuples: List[Tuple] = [Tuple(item[0], item[1]) for item in tuples_input] if tuples_input else []\n\n    def __iter__(self) -> Iterator[Tuple]:\n        \"\"\"Allows iteration over contained Tuple objects.\"\"\"\n        return iter(self._tuples)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of Tuple objects.\"\"\"\n        return len(self._tuples)\nclass Comparator:\n    \"\"\"Stateless utility for numeric comparison.\"\"\"\n    def compare(self, a: Number, b: Number) -> int:\n        \"\"\"Compares two numbers, returning -1 if a < b, 0 if a == b, +1 if a > b.\"\"\"\n        if a < b:\n            return -1\n        elif a > b:\n            return 1\n        else:\n            return 0\ndef index_minimum(tuples: list) -> Any:\n    \"\"\"\n    Finds the first element of the tuple with the smallest second element.\n    Processes input list, compares second elements, and returns the first element.\n    \"\"\"\n    tuple_list_model = TupleList(tuples)\n    comparator = Comparator()\n\n    if not tuple_list_model:\n        return None\n\n    current_min_tuple: Tuple = next(iter(tuple_list_model)) # Initialize with the first item, guaranteed to exist\n\n    for current_tuple in tuple_list_model:\n        if comparator.compare(current_tuple.second, current_min_tuple.second) < 0:\n            current_min_tuple = current_tuple\n    \n    return current_min_tuple.first"}
