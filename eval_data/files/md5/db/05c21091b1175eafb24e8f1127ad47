{"task_id": "Mbpp/748", "solution": "class InputString:\n    \"\"\"Encapsulates the input string and provides indexed access.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n    def charAt(self, index: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.value[index]\nclass Character:\n    \"\"\"Represents a character and classifies its case.\"\"\"\n    def __init__(self, index: int, value: str):\n        self.index = index\n        self.value = value\n\n    def isUpper(self) -> bool:\n        \"\"\"Checks if the character is uppercase.\"\"\"\n        return self.value.isupper()\n\n    def isLower(self) -> bool:\n        \"\"\"Checks if the character is lowercase.\"\"\"\n        return self.value.islower()\nclass WordBoundary:\n    \"\"\"Encapsulates the rule for detecting a word boundary.\"\"\"\n    def __init__(self, index: int):\n        self.index = index\n\n    def isBoundary(self, prev_char: 'Character', current_char: 'Character') -> bool:\n        \"\"\"Determines if a boundary exists between two characters.\"\"\"\n        return current_char.isUpper() and prev_char.isLower()\nclass OutputString:\n    \"\"\"Efficiently constructs the result string incrementally.\"\"\"\n    def __init__(self):\n        self._parts: list[str] = []\n\n    def append_char(self, c: str):\n        \"\"\"Appends a single character to the output.\"\"\"\n        self._parts.append(c)\n\n    def append_str(self, s: str):\n        \"\"\"Appends a string segment to the output.\"\"\"\n        self._parts.append(s)\n\n    def build(self) -> str:\n        \"\"\"Constructs and returns the final string.\"\"\"\n        return \"\".join(self._parts)\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"\n    Inserts a single space before uppercase letters marking word boundaries.\n    Boundary detection is local (current uppercase, previous lowercase); no leading spaces.\n    \"\"\"\n    input_model = InputString(input)\n    output_model = OutputString()\n\n    if input_model.length() == 0:\n        return \"\"\n\n    # Always append the first character without a preceding space.\n    first_char_value = input_model.charAt(0)\n    output_model.append_char(first_char_value)\n\n    # Iterate from the second character to detect boundaries.\n    for i in range(1, input_model.length()):\n        prev_char_obj = Character(i - 1, input_model.charAt(i - 1))\n        current_char_obj = Character(i, input_model.charAt(i))\n\n        # Check for a boundary using the WordBoundary logic.\n        boundary_detector = WordBoundary(i)\n        if boundary_detector.isBoundary(prev_char_obj, current_char_obj):\n            output_model.append_str(\" \")\n        \n        output_model.append_char(current_char_obj.value)\n\n    return output_model.build()"}
{"task_id": "Mbpp/749", "solution": "from typing import List\ndef sort_numeric_strings(input: List[str]) -> List[int]:\n    \"\"\"\n    Public API function to sort numeric strings.\n    Delegates the conversion and sorting process to the SortNumericStrings class.\n    \"\"\"\n    return SortNumericStrings().execute(input)\nclass SortNumericStrings:\n    \"\"\"\n    Orchestrates the conversion of string inputs to integers and sorts them.\n    This class encapsulates the core logic for the sorting operation.\n    \"\"\"\n    def execute(self, input: List[str]) -> List[int]:\n        \"\"\"\n        Converts each string in the input list to an integer and returns the sorted list.\n        It uses NumericString to parse individual strings and then sorts the resulting integers.\n        \"\"\"\n        parsed = [NumericString(s).to_integer() for s in input]\n        parsed.sort()\n        return parsed\nclass NumericString:\n    \"\"\"\n    A value object representing a numeric string.\n    Provides a method to convert the wrapped string to an integer.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def to_integer(self) -> int:\n        \"\"\"\n        Converts the stored string value to an integer.\n        Assumes the string is a valid integer representation.\n        \"\"\"\n        return int(self.value)"}
