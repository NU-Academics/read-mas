{"task_id": "Mbpp/100", "solution": "# src/generator.py\nclass PalindromeGenerator:\n    \"\"\"Encapsulates logic for palindrome detection and generation.\"\"\"\n    @staticmethod\n    def is_palindrome(x: int) -> bool:\n        \"\"\"Checks if the decimal representation of an integer is a palindrome.\"\"\"\n        s = str(x)\n        return s == s[::-1]\n\n    @staticmethod\n    def compute_next(n: int) -> int:\n        \"\"\"Finds the smallest integer palindrome strictly greater than n.\"\"\"\n        current = n + 1\n        while True:\n            if PalindromeGenerator.is_palindrome(current):\n                return current\n            current += 1"}
{"task_id": "Mbpp/99", "solution": "from src.validator import InputValidator\nfrom src.errors import ErrorHandler, InvalidInputError\nclass BinaryString:\n    \"\"\"Represents a binary string result.\n    It encapsulates the string value produced by the conversion.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def hasNoLeadingZeros(self) -> bool:\n        \"\"\"Checks if the binary string has no leading zeros.\n        This property verifies the canonical format for positive numbers.\n        \"\"\"\n        return self.value == '0' or (self.value.startswith('1') and len(self.value) > 0)\nclass DecimalToBinary:\n    \"\"\"Performs the conversion from a validated decimal to binary string.\n    It handles the core conversion logic and specific zero-case rule.\n    \"\"\"\n    def decimal_to_binary(self, n: int) -> str:\n        \"\"\"Converts a non-negative integer to its binary string representation.\n        It first validates the input, then applies conversion rules BR2 and BR3.\n        \"\"\"\n        InputValidator().validate(n)  # Validate input first as per design.\n\n        if n == 0:\n            return '0'  # Business Rule BR2\n\n        binary_digits = []\n        temp_n = n\n        while temp_n > 0:\n            remainder = temp_n % 2\n            binary_digits.append(str(remainder))\n            temp_n //= 2\n\n        # The digits are in reverse order, so reverse and join them.\n        result_str = \"\".join(binary_digits[::-1])\n        # The BinaryString class is used as per design, even if just to wrap the string.\n        return BinaryString(result_str).value\ndef decimal_to_binary(n) -> str:\n    \"\"\"\n    Converts a non-negative integer to its binary string representation.\n    Returns '0' for input 0; raises InvalidInputError for invalid inputs.\n    \"\"\"\n    converter = DecimalToBinary()\n    return converter.decimal_to_binary(n)"}
{"task_id": "Mbpp/100", "solution": "from domain import IntegerValue, Palindrome\nfrom palindrome_function import next_smallest_palindrome\nclass IntegerValue:\n    \"\"\"Represents an integer value and provides string conversion.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def toString(self) -> str:\n        \"\"\"Converts the integer value to its string representation.\"\"\"\n        return str(self.value)\ndef handle_all_9s_case(s: str) -> str:\n    \"\"\"Returns the next palindrome for strings consisting of all 9s, e.g., '99' -> '101'.\"\"\"\n    length = len(s)\n    return '1' + '0' * (length - 1) + '1'\ndef increment_center_and_mirror(s: str) -> str:\n    \"\"\"Increments the left half (including center for odd length) and mirrors it to form a palindrome.\n    This generates the next palindrome candidate when simple mirroring yields <= n.\"\"\"\n    n_digits = len(s)\n    half_len = (n_digits + 1) // 2\n    left_half_to_increment = s[:half_len]\n\n    incremented_half_num = int(left_half_to_increment) + 1\n    incremented_half_str = str(incremented_half_num)\n\n    # Construct the palindrome from the incremented half string\n    if n_digits % 2 == 1: # Original string had odd length\n        return incremented_half_str + incremented_half_str[:-1][::-1]\n    else: # Original string had even length\n        return incremented_half_str + incremented_half_str[::-1]\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Finds the smallest integer p such that p > n and p is a palindrome.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    s = IntegerValue(n).toString()\n    length = len(s)\n\n    # Handle the case where n consists of all 9s (e.g., 9, 99, 999)\n    if all(c == '9' for c in s):\n        return int(handle_all_9s_case(s))\n\n    # Form an initial palindrome candidate by mirroring the first half of s.\n    # This candidate will initially have the same number of digits as s.\n    half_len_for_mirror = (length + 1) // 2\n    left_half_for_mirror = s[:half_len_for_mirror]\n    mirrored_right_half = s[:length // 2][::-1]\n    \n    p1_str_candidate = left_half_for_mirror + mirrored_right_half\n    \n    # If the mirrored palindrome (p1) is already greater than n, it's the answer.\n    # We implicitly trust Palindrome.is_palindrome() from the design, but\n    # p1_str_candidate is constructed to be a palindrome.\n    if int(p1_str_candidate) > n:\n        return int(p1_str_candidate)\n    else:\n        # If p1 is not greater than n, we need to increment the left half\n        # to find the next smallest palindrome.\n        next_p_str = increment_center_and_mirror(s)\n        return int(next_p_str)"}
