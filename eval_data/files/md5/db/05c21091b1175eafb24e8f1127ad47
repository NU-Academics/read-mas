{"task_id": "Mbpp/635", "solution": "class Heap:\n    \"\"\"Represents a max-heap data structure used by heap sort.\n    Provides heap construction and extract operations.\"\"\"\n    def __init__(self, data: list) -> None:\n        self.data = list(data)\n        self.size = len(self.data)\n\n    def _parent(self, i: int) -> int:\n        return (i - 1) // 2\n\n    def _left_child(self, i: int) -> int:\n        return 2 * i + 1\n\n    def _right_child(self, i: int) -> int:\n        return 2 * i + 2\n\n    def sift_down(self, index: int) -> None:\n        \"\"\"Restores max-heap property from index downward.\"\"\"\n        largest = index\n        left = self._left_child(index)\n        right = self._right_child(index)\n\n        if left < self.size and self.data[left] > self.data[largest]:\n            largest = left\n        if right < self.size and self.data[right] > self.data[largest]:\n            largest = right\n\n        if largest != index:\n            self.data[index], self.data[largest] = self.data[largest], self.data[index]\n            self.sift_down(largest)\n\n    def build_max_heap(self) -> None:\n        \"\"\"Converts data into a max-heap in O(n) time.\"\"\"\n        for i in range(self.size // 2 - 1, -1, -1):\n            self.sift_down(i)\n\n    def extract_max(self) -> int:\n        \"\"\"Swaps root with last element, reduces size, sifts down, and returns extracted max.\"\"\"\n        max_val = self.data[0]\n        self.data[0] = self.data[self.size - 1]\n        self.size -= 1\n        if self.size > 0:\n            self.sift_down(0)\n        return max_val\ndef heap_sort(input_list: list) -> list:\n    \"\"\"Sorts a Python list of integers in ascending order using heap sort.\n    Returns a new sorted list, preserving the input list.\"\"\"\n    if not input_list:\n        return []\n\n    heap = Heap(list(input_list)) # Heap operates on a copy of the input_list's contents\n    heap.build_max_heap()\n\n    # Extract elements one by one; they will be in descending order.\n    sorted_descending = []\n    while heap.size > 0:\n        sorted_descending.append(heap.extract_max())\n\n    # Reverse the collected elements to get ascending order.\n    return sorted_descending[::-1]"}
{"task_id": "Mbpp/633", "solution": "from typing import List\nclass InputList:\n    \"\"\"Manages input list and desired count `n` to provide first effective_n elements.\"\"\"\n    def __init__(self, values: List[int], n: int):\n        self.values = values\n        self.n = n\n\n    def get_first_n(self) -> List[int]:\n        \"\"\"Returns the first effective_n elements from the input values.\n        Calculates effective_n respecting constraints on 'n' and list length.\"\"\"\n        effective_n = max(0, min(self.n, len(self.values)))\n        return self.values[:effective_n]\nclass Pair:\n    \"\"\"Represents an unordered distinct pair of elements and their XOR value.\"\"\"\n    def __init__(self, i: int, j: int, xor_value: int):\n        self.i = i\n        self.j = j\n        self.xor_value = xor_value\nclass XORCalculator:\n    \"\"\"Handles XOR computations, pair generation, and summing XOR values.\"\"\"\n\n    def compute_xor(self, a: int, b: int) -> int:\n        \"\"\"Computes the bitwise XOR of two integers.\"\"\"\n        return a ^ b\n\n    def compute_pairs(self, values: List[int]) -> List[Pair]:\n        \"\"\"Generates all distinct unordered pairs from a list and computes their XOR values.\"\"\"\n        pairs = []\n        for i_idx in range(len(values) - 1):\n            for j_idx in range(i_idx + 1, len(values)):\n                val_i = values[i_idx]\n                val_j = values[j_idx]\n                xor_val = self.compute_xor(val_i, val_j)\n                pairs.append(Pair(val_i, val_j, xor_val))\n        return pairs\n\n    def sum_xors(self, pairs: List[Pair]) -> int:\n        \"\"\"Sums the XOR values of all generated pairs.\"\"\"\n        return sum(pair.xor_value for pair in pairs)\n\n    def orchestrate_pair_xor_sum(self, arr: List[int], n: int) -> int:\n        \"\"\"Orchestrates the calculation of sum of XORs for pairs, using internal components.\n        Handles initial input processing and edge cases related to list length.\"\"\"\n        input_list_obj = InputList(values=arr, n=n)\n        values_first_n = input_list_obj.get_first_n()\n\n        if len(values_first_n) <= 1:\n            return 0\n\n        pairs = self.compute_pairs(values_first_n)\n        total_sum = self.sum_xors(pairs)\n        # As per design, a Result object is created transiently but not returned by this method.\n        # result_obj = Result(sum_val=total_sum)\n        return total_sum\ndef pair_xor_Sum(arr: List[int], n: int) -> int:\n    \"\"\"\n    Computes the sum of XORs of all distinct unordered pairs from the first n elements of arr.\n    This public API delegates the core logic to an XORCalculator instance.\n    \"\"\"\n    calculator = XORCalculator()\n    return calculator.orchestrate_pair_xor_sum(arr, n)"}
{"task_id": "Mbpp/635", "solution": "from typing import List, Any\nclass HeapSorter:\n    \"\"\"Encapsulates the heap-based sorting algorithm.\"\"\"\n    def heap_sort(self, input_list: List[Any]) -> List[Any]:\n        \"\"\"Sorts the input list using heap sort and returns a new sorted list.\"\"\"\n        a = list(input_list) # Work on a copy to return a new list\n        n = len(a)\n\n        self.build_heap(a) # Build a max-heap\n\n        for i in range(n - 1, 0, -1):\n            self.swap(a, i, 0) # Move current root to end\n            self.sift_down(a, 0, i - 1) # Sift down the new root\n\n        return a\n\n    def build_heap(self, a: List[Any]) -> None:\n        \"\"\"Builds a max-heap in list 'a' in-place.\"\"\"\n        n = len(a)\n        for i in range(n // 2 - 1, -1, -1):\n            self.sift_down(a, i, n - 1)\n\n    def sift_down(self, a: List[Any], start: int, end: int) -> None:\n        \"\"\"Sifts down element at 'start' in sub-array 'a[start:end+1]' iteratively.\"\"\"\n        root = start\n        while True:\n            child = 2 * root + 1 # Left child\n            if child > end: # No children in current heap range\n                break\n            if child + 1 <= end and a[child + 1] > a[child]: # Right child exists and is larger\n                child += 1\n            if a[root] < a[child]: # Parent is smaller than largest child\n                self.swap(a, root, child)\n                root = child\n            else: # Heap property satisfied at root\n                break\n\n    def swap(self, a: List[Any], i: int, j: int) -> None:\n        \"\"\"Swaps elements at indices i and j in list 'a'.\"\"\"\n        a[i], a[j] = a[j], a[i]\ndef heap_sort(input_list: List[Any]) -> List[Any]:\n    \"\"\"Public API: sorts input_list and returns a new list sorted in ascending order.\"\"\"\n    sorter = HeapSorter()\n    return sorter.heap_sort(input_list)"}
{"task_id": "Mbpp/637", "solution": "from typing import Union, Optional\nfrom datetime import datetime\nclass ComparisonResult:\n    \"\"\"Encapsulates the outcome of a comparison and optional metadata.\"\"\"\n    def __init__(self, no_profit_no_loss: bool, difference: float, evaluated_at: Optional[datetime] = None) -> None:\n        self.no_profit_no_loss: bool = no_profit_no_loss\n        self.difference: float = difference\n        self.evaluated_at: Optional[datetime] = evaluated_at\nclass NoprofitNoLossFunction:\n    \"\"\"Implements the core equality comparison logic.\"\"\"\n    def evaluate(self, amount1: float, amount2: float) -> bool:\n        \"\"\"Returns True if amount1 and amount2 are strictly equal.\"\"\"\n        return amount1 == amount2\n\n    def compare(self, amount1: float, amount2: float) -> ComparisonResult:\n        \"\"\"Computes and returns a ComparisonResult based on the two amounts.\"\"\"\n        is_equal = self.evaluate(amount1, amount2)\n        difference = abs(amount1 - amount2)\n        return ComparisonResult(no_profit_no_loss=is_equal, difference=difference, evaluated_at=datetime.now())\ndef noprofit_noloss(amount1: Union[int, float], amount2: Union[int, float]) -> bool:\n    \"\"\"\n    Checks if two monetary amounts are equal, indicating no profit and no loss.\n    Returns True if the amounts are strictly equal, False otherwise.\n    \"\"\"\n    comparator = NoprofitNoLossFunction()\n    return comparator.evaluate(float(amount1), float(amount2))"}
