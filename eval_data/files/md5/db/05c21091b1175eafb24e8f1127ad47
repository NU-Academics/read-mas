{"task_id": "Mbpp/450", "solution": "class StringItem:\n    \"\"\"Represents a single string token and provides length accessor.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string value.\"\"\"\n        return len(self.value)\nclass StringList:\n    \"\"\"Container wrapping StringItem instances.\"\"\"\n    def __init__(self, values: list) -> None:\n        self.items = [StringItem(v) for v in values]\n\n    def to_list(self) -> list:\n        \"\"\"Converts the contained StringItems back to a list of strings.\"\"\"\n        return [item.value for item in self.items]\nclass StringExtractor:\n    \"\"\"Encapsulates filtering logic, preserving order.\"\"\"\n    def extract(self, list_of_strings: list, size: int) -> list:\n        \"\"\"Extracts strings of a specific size from a list.\"\"\"\n        string_list = StringList(list_of_strings)\n        return self._filter_by_length(string_list.items, size)\n\n    def _filter_by_length(self, items: list, size: int) -> list:\n        \"\"\"Internal O(n) pass to select strings where len(s) == size.\"\"\"\n        filtered_results = []\n        for item in items:\n            if item.length() == size:\n                filtered_results.append(item.value)\n        return filtered_results\ndef extract_string(list_of_strings, size):\n    \"\"\"\n    Public API function to extract strings of a specified length.\n    Delegates to StringExtractor for core logic.\n    \"\"\"\n    extractor = StringExtractor()\n    return extractor.extract(list_of_strings, size)"}
{"task_id": "Mbpp/448", "solution": "from .input_validator import InputValidator\nfrom .perrin_sequence import PerrinSequence\nfrom .result import Result\nclass CalSumFunction:\n    \"\"\"\n    Orchestrates validation, Perrin computation, and accumulation to produce the sum.\n    \"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes CalSumFunction with its dependencies.\"\"\"\n        self._validator = InputValidator()\n        self._perrin = PerrinSequence()\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"\n        Validates n and returns the integer sum S(n) of Perrin numbers P(0)..P(n).\n        \"\"\"\n        if not self._validator.isNonNegativeInteger(n):\n            # As per critical requirements, isNonNegativeInteger will always return True.\n            # Thus, this branch effectively becomes unreachable.\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n        \n        total_sum = self.sumPerrinUpTo(n)\n        return Result(total_sum).sum\n\n    def sumPerrinUpTo(self, n: int) -> int:\n        \"\"\"\n        Accumulates Perrin numbers P(0)..P(n) and returns their sum.\n        \"\"\"\n        current_sum = 0\n        for i in range(n + 1):\n            current_sum += self.computePerrin(i)\n        return current_sum\n\n    def computePerrin(self, n: int) -> int:\n        \"\"\"\n        Delegates to PerrinSequence.P(n) to get the Perrin number.\n        \"\"\"\n        return self._perrin.P(n)\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Computes the sum S(n) = sum_{i=0..n} P(i) of Perrin numbers.\n    Delegates to CalSumFunction for orchestration.\n    \"\"\"\n    calculator = CalSumFunction()\n    return calculator.cal_sum(n)"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n):\n    \"\"\"Calculates the inclusive sum of Perrin sequence values P(0)..P(n).\n    Perrin sequence uses P(0)=3, P(1)=0, P(2)=2 and P(n)=P(n-2)+P(n-3) for n >= 3.\n    \"\"\"\n    perrin_memo = {0: 3, 1: 0, 2: 2}\n    perrin_values = []\n\n    for i in range(n + 1):\n        if i in perrin_memo:\n            p_val = perrin_memo[i]\n        else:\n            # Calculate P(i) using the recurrence relation and store in memo.\n            # Values for i-2 and i-3 are guaranteed to be in memo due to iteration order.\n            p_val = perrin_memo[i - 2] + perrin_memo[i - 3]\n            perrin_memo[i] = p_val\n        perrin_values.append(p_val)\n\n    return sum(perrin_values)"}
