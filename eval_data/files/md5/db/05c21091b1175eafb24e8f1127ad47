{"task_id": "Mbpp/473", "solution": "from dataclasses import dataclass\ndef _canonical_key(t: tuple) -> tuple:\n    \"\"\"Returns the canonical (sorted) form of a 2-element tuple.\"\"\"\n    return tuple(sorted(t))\ndef _build_normalized_map(list_of_tuples: list) -> (dict, set):\n    \"\"\"Creates a map from canonical key to the first-seen original tuple and a set of all canonical keys.\"\"\"\n    canonical_to_original_map = {}\n    canonical_keys_set = set()\n    for original_tuple in list_of_tuples:\n        key = _canonical_key(original_tuple)\n        if key not in canonical_to_original_map:\n            canonical_to_original_map[key] = original_tuple\n        canonical_keys_set.add(key)\n    return canonical_to_original_map, canonical_keys_set\ndef tuple_intersection(list1, list2) -> set:\n    \"\"\"Computes the intersection of two lists of 2-element tuples (order-insensitive).\n    It returns a set of tuples from list1 that have canonical matches in list2.\n    \"\"\"\n    map1, keys1_set = _build_normalized_map(list1)\n    _, keys2_set = _build_normalized_map(list2)\n\n    intersection_keys = keys1_set.intersection(keys2_set)\n\n    result_set = set()\n    for key in intersection_keys:\n        result_set.add(map1[key])\n    return result_set"}
{"task_id": "Mbpp/473", "solution": "from .tuple_intersection import tuple_intersection\nfrom typing import Sequence, Tuple, Set, Any\nimport collections.abc\nclass TuplePair:\n    \"\"\"\n    Represents a 2-element tuple, validating its structure and element hashability.\n    Provides methods for normalization and access to the original tuple.\n    \"\"\"\n    element1: Any\n    element2: Any\n\n    def __init__(self, raw: Tuple[Any, Any]) -> None:\n        \"\"\"Constructs and validates a raw 2-element tuple.\"\"\"\n        if not isinstance(raw, tuple):\n            raise TypeError(f\"Element {raw!r} is not a tuple.\")\n        if len(raw) != 2:\n            raise ValueError(f\"Element {raw!r} is not a 2-element tuple.\")\n\n        self.element1 = raw[0]\n        self.element2 = raw[1]\n\n        if not self.is_hashable_elements():\n            raise TypeError(f\"Tuple elements must be hashable. Found {raw!r} with non-hashable elements.\")\n\n    def to_unordered_key(self) -> Tuple[Any, Any]:\n        \"\"\"\n        Returns a canonical unordered key for unordered equality.\n        Uses sorted based on string representation to handle mixed types stably.\n        \"\"\"\n        return tuple(sorted((self.element1, self.element2), key=repr))\n\n    def is_hashable_elements(self) -> bool:\n        \"\"\"Checks if both elements of the tuple are hashable.\"\"\"\n        try:\n            hash(self.element1)\n            hash(self.element2)\n            return True\n        except TypeError:\n            return False\n\n    def as_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Returns the original-order tuple as provided.\"\"\"\n        return (self.element1, self.element2)\nclass IntersectionResult:\n    \"\"\"\n    Collects matching tuples and enforces set semantics for the result.\n    It stores tuples, ensuring no duplicates are added based on exact tuple value.\n    \"\"\"\n    pairs: Set[Tuple[Any, Any]]\n\n    def __init__(self) -> None:\n        \"\"\"Initializes an empty set to store intersection results.\"\"\"\n        self.pairs = set()\n\n    def add(self, pair_tuple: Tuple[Any, Any]) -> None:\n        \"\"\"Adds a tuple to the result set, ensuring uniqueness.\"\"\"\n        self.pairs.add(pair_tuple)\n\n    def to_set(self) -> Set[Tuple[Any, Any]]:\n        \"\"\"Returns the collected set of unique tuples.\"\"\"\n        return self.pairs\ndef tuple_intersection(seq_a: Sequence[Tuple[Any, Any]], seq_b: Sequence[Tuple[Any, Any]]) -> Set[Tuple[Any, Any]]:\n    \"\"\"\n    Computes the unordered intersection of two sequences of 2-element tuples.\n    Returns a set of 2-element tuples, preserving the order from the first input for matches.\n    \"\"\"\n    if not isinstance(seq_a, collections.abc.Sequence):\n        raise TypeError(\"Input 'seq_a' must be a sequence.\")\n    if not isinstance(seq_b, collections.abc.Sequence):\n        raise TypeError(\"Input 'seq_b' must be a sequence.\")\n\n    a_canonical_map: dict[Tuple[Any, Any], Tuple[Any, Any]] = {}\n    for i, raw_tuple_a in enumerate(seq_a):\n        try:\n            tp_a = TuplePair(raw_tuple_a)\n            canonical_key_a = tp_a.to_unordered_key()\n            if canonical_key_a not in a_canonical_map:\n                a_canonical_map[canonical_key_a] = tp_a.as_tuple()\n        except (TypeError, ValueError) as e:\n            raise type(e)(f\"Invalid element in seq_a at index {i}: {e}\") from e\n\n    b_canonical_keys: Set[Tuple[Any, Any]] = set()\n    for i, raw_tuple_b in enumerate(seq_b):\n        try:\n            tp_b = TuplePair(raw_tuple_b)\n            canonical_key_b = tp_b.to_unordered_key()\n            b_canonical_keys.add(canonical_key_b)\n        except (TypeError, ValueError) as e:\n            raise type(e)(f\"Invalid element in seq_b at index {i}: {e}\") from e\n\n    result_collector = IntersectionResult()\n    intersection_keys = a_canonical_map.keys() & b_canonical_keys\n\n    for key in intersection_keys:\n        result_collector.add(a_canonical_map[key])\n\n    return result_collector.to_set()"}
