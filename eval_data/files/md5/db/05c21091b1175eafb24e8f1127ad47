{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple, input_list):\n    \"\"\"Count occurrences of any element from input_list found in input_tuple.\n\n    Each occurrence in the tuple is counted separately if it matches any list element.\n    \"\"\"\n    total_count = 0\n    for tuple_element in input_tuple:\n        for list_element in input_list:\n            if tuple_element == list_element:\n                total_count += 1\n                break  # Count this tuple_element once if it matches any list_element\n    return total_count"}
{"task_id": "Mbpp/445", "solution": "def compute_products(left, right) -> tuple:\n    \"\"\"Computes element-wise products assuming all validations passed.\"\"\"\n    result_tuples = []\n    for i in range(len(left)):\n        inner_result = tuple(left[i][j] * right[i][j] for j in range(len(left[i])))\n        result_tuples.append(inner_result)\n    return tuple(result_tuples)\ndef index_multiplication(left, right) -> tuple:\n    \"\"\"Performs index-wise multiplication with comprehensive validation.\"\"\"\n    validate_top_level_lengths(left, right)\n    validate_inner_lengths(left, right)\n    validate_numeric_elements(left, right)\n    return compute_products(left, right)"}
{"task_id": "Mbpp/445", "solution": "from dataclasses import dataclass\nfrom typing import Any, Tuple\nclass ShapeMismatchError(Exception):\n    \"\"\"Domain exception for outer/inner length mismatches.\"\"\"\n    pass\nclass InvalidTypeError(Exception):\n    \"\"\"Domain exception for element multiplication incompatibility.\"\"\"\n    pass\nclass IndexMultiplication:\n    \"\"\"Orchestrates validation and computation; exposes index_multiplication() method.\"\"\"\n\n    _input_a: TupleOfTuples\n    _input_b: TupleOfTuples\n    _raw_a: tuple\n    _raw_b: tuple\n\n    def __init__(self, a: tuple, b: tuple) -> None:\n        \"\"\"Initializes with raw input tuples a and b.\"\"\"\n        self._raw_a = a\n        self._raw_b = b\n\n    def validate_types(self) -> None:\n        \"\"\"Validates that inputs are tuples of tuples, then wraps them.\"\"\"\n        if not isinstance(self._raw_a, tuple) or not isinstance(self._raw_b, tuple):\n            raise InvalidTypeError(\"Inputs 'a' and 'b' must be tuples.\")\n\n        for i, inner_a in enumerate(self._raw_a):\n            if not isinstance(inner_a, tuple):\n                raise InvalidTypeError(f\"Element a[{i}] must be a tuple, got {type(inner_a)}.\")\n        \n        for i, inner_b in enumerate(self._raw_b):\n            if not isinstance(inner_b, tuple):\n                raise InvalidTypeError(f\"Element b[{i}] must be a tuple, got {type(inner_b)}.\")\n        \n        self._input_a = TupleOfTuples.from_raw_tuple_of_tuples(self._raw_a)\n        self._input_b = TupleOfTuples.from_raw_tuple_of_tuples(self._raw_b)\n\n    def validate_shapes(self) -> None:\n        \"\"\"Validates outer and inner tuple lengths for equality.\"\"\"\n        if len(self._input_a.tuples) != len(self._input_b.tuples):\n            raise ShapeMismatchError(\n                f\"Outer tuples must have equal length. Got len(a)={len(self._input_a.tuples)}, len(b)={len(self._input_b.tuples)}.\"\n            )\n\n        for i in range(len(self._input_a.tuples)):\n            if len(self._input_a.tuples[i].elements) != len(self._input_b.tuples[i].elements):\n                raise ShapeMismatchError(\n                    f\"Inner tuple at index {i} must have equal length. \"\n                    f\"Got len(a[{i}])={len(self._input_a.tuples[i].elements)}, len(b[{i}])={len(self._input_b.tuples[i].elements)}.\"\n                )\n\n    def compute_products(self) -> ResultTuple:\n        \"\"\"Computes element-wise index-wise multiplication.\"\"\"\n        result_outer_list = []\n        for i in range(len(self._input_a.tuples)):\n            result_inner_list = []\n            inner_tuple_a = self._input_a.tuples[i]\n            inner_tuple_b = self._input_b.tuples[i]\n            for j in range(len(inner_tuple_a.elements)):\n                element_a = inner_tuple_a.elements[j]\n                element_b = inner_tuple_b.elements[j]\n                try:\n                    product = element_a.value * element_b.value\n                    result_inner_list.append(product)\n                except TypeError as e:\n                    raise InvalidTypeError(\n                        f\"Cannot multiply elements at a[{i}][{j}] ({type(element_a.value)}) \"\n                        f\"and b[{i}][{j}] ({type(element_b.value)}): {e}\"\n                    )\n            result_outer_list.append(tuple(result_inner_list))\n        return ResultTuple(tuple(result_outer_list))\n\n    def index_multiplication(self) -> tuple:\n        \"\"\"Orchestrates validation, computation, and returns the final result tuple.\"\"\"\n        self.validate_types()\n        self.validate_shapes()\n        result_tuple_obj = self.compute_products()\n        return result_tuple_obj.to_tuple()\ndef index_multiplication(a: tuple, b: tuple) -> tuple:\n    \"\"\"Public API: accepts two positional arguments (outer tuples) and returns tuple-of-tuples result.\n    Raises ShapeMismatchError or InvalidTypeError on validation failures.\n    \"\"\"\n    coordinator = IndexMultiplication(a, b)\n    return coordinator.index_multiplication()"}
