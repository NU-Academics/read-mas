{"task_id": "Mbpp/294", "solution": "from typing import Any, List, Optional, Union\nNumber = Union[int, float]\nclass Element:\n    \"\"\"Base class for list elements, providing a common interface for type checking.\"\"\"\n    def __init__(self, raw_value: Any) -> None:\n        self.raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Determines if the element represents a numeric value.\"\"\"\n        raise NotImplementedError\n\n    def as_numeric(self) -> Optional[Number]:\n        \"\"\"Returns the numeric value if applicable, otherwise None.\"\"\"\n        raise NotImplementedError\nclass NumericElement(Element):\n    \"\"\"Represents an element that is an integer or a float.\"\"\"\n    def __init__(self, raw_value: Number) -> None:\n        super().__init__(raw_value)\n        self.numeric_value: Number = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Confirms this element is numeric.\"\"\"\n        return True\n\n    def as_numeric(self) -> Number:\n        \"\"\"Returns the stored numeric value.\"\"\"\n        return self.numeric_value\nclass NonNumericElement(Element):\n    \"\"\"Represents an element that is not an integer or a float.\"\"\"\n    def __init__(self, raw_value: Any) -> None:\n        super().__init__(raw_value)\n\n    def is_numeric(self) -> bool:\n        \"\"\"Confirms this element is non-numeric.\"\"\"\n        return False\n\n    def as_numeric(self) -> None:\n        \"\"\"Non-numeric elements have no numeric value.\"\"\"\n        return None\nclass InputList:\n    \"\"\"Wraps the raw input list, converting items to domain-aligned Element objects.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._raw_elements = elements\n\n    def to_elements(self) -> List[Element]:\n        \"\"\"Converts raw list items into a list of Element (sub)types.\"\"\"\n        domain_elements: List[Element] = []\n        for item in self._raw_elements:\n            if isinstance(item, (int, float)):\n                domain_elements.append(NumericElement(item))\n            else:\n                domain_elements.append(NonNumericElement(item))\n        return domain_elements\nclass Result:\n    \"\"\"Encapsulates the maximum numeric value found.\"\"\"\n    def __init__(self, max_value: Number) -> None:\n        self._max_value = max_value\n\n    def value(self) -> Number:\n        \"\"\"Returns the stored maximum numeric value.\"\"\"\n        return self._max_value\ndef max_val(lst: list) -> Number:\n    \"\"\"\n    Public API to find the maximum numeric value in a heterogeneous list.\n    Ignores non-numeric elements; raises ValueError if no numeric elements are present.\n    \"\"\"\n    input_list_wrapper = InputList(lst)\n    domain_elements = input_list_wrapper.to_elements()\n\n    numeric_values: List[Number] = []\n    for element in domain_elements:\n        if element.is_numeric():\n            # Based on design, as_numeric() will return Number for NumericElement.\n            numeric_values.append(element.as_numeric()) # type: ignore\n\n    if not numeric_values:\n        raise ValueError(\"No numeric elements found in the list.\")\n\n    calculated_max = max(numeric_values)\n    result = Result(calculated_max)\n    return result.value()"}
{"task_id": "Mbpp/294", "solution": "def _is_numeric(value):\n    \"\"\"Checks if a value is an integer or a float.\n    This helper encapsulates the numeric type detection logic.\n    \"\"\"\n    return isinstance(value, (int, float))\ndef _filter_numeric(input_list):\n    \"\"\"Filters a list to include only numeric elements.\n    Uses _is_numeric to identify valid numbers.\n    \"\"\"\n    return [item for item in input_list if _is_numeric(item)]\ndef _compute_max(numeric_list):\n    \"\"\"Computes the maximum value from a list of numbers.\n    Assumes the input list is non-empty and contains only numeric types.\n    \"\"\"\n    return max(numeric_list)\ndef max_val(input_list):\n    \"\"\"Finds the maximum numeric value in a heterogeneous list.\n    Returns None if no numeric elements are found.\n    \"\"\"\n    numeric_elements = _filter_numeric(input_list)\n\n    if not numeric_elements:\n        return None\n    else:\n        return _compute_max(numeric_elements)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(array):\n    \"\"\"Counts inversions in an array using a merge-sort-based approach.\n    It operates on a copy to preserve the original input array.\n    \"\"\"\n\n    def _merge_count(left, right):\n        \"\"\"Merges two sorted lists and counts cross-inversions.\n        Returns the merged sorted list and the count of cross-inversions.\n        \"\"\"\n        merged = []\n        inversions = 0\n        i, j = 0, 0\n        \n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                inversions += len(left) - i\n                j += 1\n        \n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inversions\n\n    def _merge_sort_count(arr):\n        \"\"\"Recursively sorts the array and counts inversions.\n        Returns a sorted copy of the array and the total inversion count.\n        \"\"\"\n        n = len(arr)\n        if n <= 1:\n            return arr, 0\n        \n        mid = n // 2\n        left_half, left_inversions = _merge_sort_count(arr[:mid])\n        right_half, right_inversions = _merge_sort_count(arr[mid:])\n        \n        merged_array, cross_inversions = _merge_count(left_half, right_half)\n        \n        total_inversions = left_inversions + right_inversions + cross_inversions\n        return merged_array, total_inversions\n\n    array_copy = list(array)\n    \n    _, total_inversions = _merge_sort_count(array_copy)\n    return total_inversions"}
{"task_id": "Mbpp/296", "solution": "def _merge_count(left: list, right: list) -> (list, int):\n    \"\"\"Merge two sorted lists and return (merged_list, cross_inversions).\"\"\"\n    merged = []\n    inversions = 0\n    i, j = 0, 0\n    len_left = len(left)\n\n    while i < len_left and j < len(right):\n        if left[i] <= right[j]:\n            merged.append(left[i])\n            i += 1\n        else:\n            merged.append(right[j])\n            j += 1\n            inversions += (len_left - i)\n\n    merged.extend(left[i:])\n    merged.extend(right[j:])\n\n    return merged, inversions\ndef _merge_sort_count(arr: list) -> (list, int):\n    \"\"\"Return (sorted_list, inversion_count).\"\"\"\n    if len(arr) <= 1:\n        return arr, 0\n\n    mid = len(arr) // 2\n    left_half = arr[:mid]\n    right_half = arr[mid:]\n\n    sorted_left, left_inversions = _merge_sort_count(left_half)\n    sorted_right, right_inversions = _merge_sort_count(right_half)\n\n    merged_arr, cross_inversions = _merge_count(sorted_left, sorted_right)\n\n    total_inversions = left_inversions + right_inversions + cross_inversions\n    return merged_arr, total_inversions\ndef get_Inv_Count(arr: list) -> int:\n    \"\"\"Validate arr and return inversion count as built-in int.\"\"\"\n    validate_input(arr)\n    # Pass a copy to _merge_sort_count to ensure the original input list is not affected.\n    _, count = _merge_sort_count(list(arr)) \n    return count"}
