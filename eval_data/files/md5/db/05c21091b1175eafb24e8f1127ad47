{"task_id": "Mbpp/138", "solution": "import math\nfrom typing import List, Optional, Any\nclass NumberInput:\n    \"\"\"Encapsulates an input value and provides basic type validation.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def isInteger(self) -> bool:\n        \"\"\"Returns True if the encapsulated value is of Python int type.\"\"\"\n        return isinstance(self.value, int)\nclass PowerOfTwo:\n    \"\"\"Represents a single power-of-two term with its exponent and value.\"\"\"\n    def __init__(self, exponent: int):\n        self.exponent = exponent\n        self.value = 0\n        self.computeValue()\n\n    def computeValue(self) -> int:\n        \"\"\"Computes 2 raised to the exponent and stores/returns the result.\"\"\"\n        self.value = int(math.pow(2, self.exponent))\n        return self.value\nclass RepresentationEvaluator:\n    \"\"\"Evaluates if a number can be represented as a sum of non-zero powers of two.\"\"\"\n    def is_Sum_Of_Powers_Of_Two(self, n: int) -> bool:\n        \"\"\"Primary method to determine if n can be represented as sum of 2^k (k >= 1).\"\"\"\n        if not self._validateInput(n):\n            return False\n\n        terms = self._decomposeToPowers(n)\n        \n        # Check if the sum of valid terms equals n and at least one term was found.\n        sum_of_terms = sum(p.value for p in terms)\n        return sum_of_terms == n and len(terms) > 0\n\n    def _validateInput(self, n: Any) -> bool:\n        \"\"\"Checks if the input n is a valid positive integer.\"\"\"\n        number_input = NumberInput(n)\n        return number_input.isInteger() and n > 0\n\n    def _decomposeToPowers(self, n: int) -> List[PowerOfTwo]:\n        \"\"\"Decomposes n into PowerOfTwo terms where exponent k >= 1.\"\"\"\n        terms: List[PowerOfTwo] = []\n        temp_n = n\n        exponent = 0\n        while temp_n > 0:\n            if (temp_n & 1) == 1: # If the current bit is set\n                if exponent >= 1: # Only include terms where k >= 1\n                    terms.append(PowerOfTwo(exponent))\n            temp_n >>= 1 # Move to the next bit\n            exponent += 1\n        return terms\ndef is_Sum_Of_Powers_Of_Two(n) -> bool:\n    \"\"\"Public API function: checks if n can be represented as sum of non-zero powers of two.\"\"\"\n    evaluator = RepresentationEvaluator()\n    return evaluator.is_Sum_Of_Powers_Of_Two(n)"}
{"task_id": "Mbpp/138", "solution": "def _validate_input(n):\n    \"\"\"Validates if n is an integer and meets the minimum value requirement.\n    Returns True for valid inputs (int, n >= 2), False otherwise.\"\"\"\n    return isinstance(n, int) and n >= 2\ndef _is_representable(n):\n    \"\"\"Checks if n can be represented as a sum of distinct non-zero powers of two.\n    This is true if and only if the least significant bit (2^0) is not set.\"\"\"\n    # Assumes n is a validated integer (int and >= 2).\n    return (n & 1) == 0\ndef is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"Determines if an integer n can be represented as a sum of distinct non-zero powers of two.\n    Validates input before performing computation, returning False for invalid inputs.\"\"\"\n    if not _validate_input(n):\n        return False\n    return _is_representable(n)"}
