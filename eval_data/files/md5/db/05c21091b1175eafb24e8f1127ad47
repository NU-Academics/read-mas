{"task_id": "Mbpp/419", "solution": "from dataclasses import dataclass\nfrom typing import List, Union\nfrom typing import Union\nfrom typing import Any, Union\nfrom typing import List\nfrom .validator import validate_list\nfrom .rounding import round_half_to_even\nfrom .model import NumberList, SumResult\nfrom .round_and_sum import round_and_sum\ndef round_half_to_even(value: Union[float, int]) -> int:\n    \"\"\"Applies round-half-to-even semantics to a numeric value.\"\"\"\n    # Python's built-in round() function implements round-half-to-even.\n    return int(round(value))\ndef round_and_sum(numbers: List[Union[int, float]]) -> int:\n    \"\"\"\n    Rounds numbers using round-half-to-even, sums them,\n    multiplies by list length, prints, and returns the product.\n    \"\"\"\n    validate_list(numbers)\n\n    if not numbers:\n        _print_result(0)\n        return 0\n\n    num_list = NumberList(numbers)\n    \n    total_sum_rounded = 0\n    for item in num_list.get_items():\n        total_sum_rounded += round_half_to_even(item)\n\n    sum_res = SumResult(sum=total_sum_rounded)\n    product = sum_res.compute_product(num_list.length())\n\n    _print_result(product)\n    return product"}
{"task_id": "Mbpp/420", "solution": "class EvenNumber:\n    \"\"\"Represents an even number and computes its cube.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def cube(self) -> int:\n        \"\"\"Computes the cube of the even number.\"\"\"\n        return self.value ** 3\nclass EvenNumberSequence:\n    \"\"\"Generates a sequence of the first n even natural numbers.\"\"\"\n    def generate(self, n: int) -> list[EvenNumber]:\n        \"\"\"Generates the sequence [2, 4, ..., 2*n] as EvenNumber instances.\"\"\"\n        return [EvenNumber(2 * i) for i in range(1, n + 1)]\nclass CubeSumFunction:\n    \"\"\"Computes the sum of cubes of the first n even natural numbers.\"\"\"\n    def cube_Sum(self, n: int) -> int:\n        \"\"\"Calculates the sum of cubes, validating input n.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be an integer greater than or equal to 1.\")\n\n        sequence_generator = EvenNumberSequence()\n        even_numbers = sequence_generator.generate(n)\n        \n        total_sum = 0\n        for even_num in even_numbers:\n            total_sum += even_num.cube()\n            \n        return total_sum\ndef cube_Sum(n: int) -> int:\n    \"\"\"Public API: returns the sum of cubes of the first n even natural numbers.\"\"\"\n    return CubeSumFunction().cube_Sum(n)"}
{"task_id": "Mbpp/419", "solution": "from typing import Sequence\nimport math\ndef _round_half_up(value: float) -> int:\n    \"\"\"Rounds a float to the nearest integer, with .5 values rounding towards positive infinity.\"\"\"\n    return math.floor(value + 0.5)\ndef _sum_rounded(numbers: Sequence[float]) -> int:\n    \"\"\"Sums integers obtained by rounding each number in the sequence using round-half-up.\"\"\"\n    return sum(_round_half_up(num) for num in numbers)\ndef round_and_sum(numbers: Sequence[float]) -> int:\n    \"\"\"\n    Rounds numbers, sums them, multiplies by list length, prints, and returns the product.\n    Uses round-half-up tie-breaking for rounding.\n    \"\"\"\n    rounded_sum = _sum_rounded(numbers)\n    list_length = len(numbers)\n    product = rounded_sum * list_length\n    _print_result(product)\n    return product"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"Return sum of cubes of first n even natural numbers: sum_{k=1..n} (2k)^3.\"\"\"\n    return 2 * n * n * (n + 1) * (n + 1)"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(input_tuple: tuple, delimiter: str = '-') -> str:\n    \"\"\"\n    Accepts a tuple and an optional delimiter (default '-'), returning a single string.\n    It converts each element to its string representation and joins them in the original tuple order; an empty tuple returns an empty string.\n    \"\"\"\n    if not input_tuple:\n        return \"\"\n    \n    # Convert each element to its string representation\n    string_elements = [str(element) for element in input_tuple]\n    \n    # Join the string elements with the specified delimiter\n    return delimiter.join(string_elements)"}
