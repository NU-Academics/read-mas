{"task_id": "Mbpp/68", "solution": "def check_non_increasing(array) -> bool:\n    \"\"\"Checks if each element is less than or equal to the previous one.\n    Handles empty or single-element arrays as True by default.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n    for i in range(1, len(array)):\n        if array[i] > array[i - 1]:\n            return False\n    return True\ndef check_non_decreasing(array) -> bool:\n    \"\"\"Checks if each element is greater than or equal to the previous one.\n    Handles empty or single-element arrays as True by default.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n    for i in range(1, len(array)):\n        if array[i] < array[i - 1]:\n            return False\n    return True\ndef is_Monotonic(array) -> bool:\n    \"\"\"Determines if the array is entirely non-increasing or non-decreasing.\n    It calls helper functions to perform the directional checks.\n    \"\"\"\n    return check_non_increasing(array) or check_non_decreasing(array)"}
{"task_id": "Mbpp/69", "solution": "from typing import Any\nfrom .domain import List, Sublist\nclass SublistChecker:\n    \"\"\"Implements the core algorithm to check for a consecutive subsequence match.\n    It provides a stateless method for checking sublist presence.\"\"\"\n    def is_sublist(self, main_list: Any, sublist: Any) -> bool:\n        \"\"\"Checks if sublist appears as a consecutive subsequence in main_list.\n        Accepts raw Python lists or domain.List/Sublist objects.\"\"\"\n        # Normalize inputs to raw lists for consistent processing\n        ml = main_list.elements if isinstance(main_list, List) else main_list\n        sl = sublist.elements if isinstance(sublist, List) else sublist\n\n        # Short-circuit if the sublist is longer than the main list\n        if len(sl) > len(ml):\n            return False\n\n        # Iterate through possible starting positions in the main list\n        for i in range(len(ml) - len(sl) + 1):\n            # Compare the slice of main_list with the entire sublist\n            if ml[i:i+len(sl)] == sl:\n                return True # Match found\n        return False # No match found after checking all positions\ndef is_sublist(main_list: Any, sublist: Any) -> bool:\n    \"\"\"Public API function to determine if a sublist is present consecutively in a main list.\n    Delegates the checking logic to an instance of SublistChecker.\"\"\"\n    checker = SublistChecker()\n    return checker.is_sublist(main_list, sublist)"}
{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples: list) -> bool:\n    \"\"\"\n    Checks if all tuples in the provided list have the same length.\n    Returns True for empty or single-tuple lists, otherwise False if lengths differ.\n    \"\"\"\n    if not list_of_tuples:\n        return True\n\n    # As per critical requirements, assume list_of_tuples contains only tuples.\n    first_length = len(list_of_tuples[0])\n\n    for tpl in list_of_tuples[1:]:\n        if len(tpl) != first_length:\n            return False\n    return True"}
{"task_id": "Mbpp/69", "solution": "class ListSequence:\n    \"\"\"\n    Provides read-only sequence operations for a list without modifying the underlying elements.\n    get_slice returns a new list to ensure immutability.\n    \"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sequence.\"\"\"\n        return len(self._elements)\n\n    def get_slice(self, start: int, length: int) -> list:\n        \"\"\"Returns a new list representing a slice of the sequence.\"\"\"\n        return list(self._elements[start : start + length])\nclass ComparisonStrategy:\n    \"\"\"Encapsulates standard equality (==) for element comparisons.\"\"\"\n    def equals(self, a, b) -> bool:\n        \"\"\"Compares two elements for equality.\"\"\"\n        return a == b\nclass InputValidator:\n    \"\"\"\n    Validates inputs are lists and enforces length preconditions.\n    Raises TypeError for non-list inputs.\n    \"\"\"\n    def validate_list(self, obj) -> bool:\n        \"\"\"Checks if an object is a list, raising TypeError if not.\"\"\"\n        if not isinstance(obj, list):\n            raise TypeError(\"Input must be a list.\")\n        return True\n\n    def validate_lengths(self, main: ListSequence, sub: ListSequence) -> bool:\n        \"\"\"Returns True if sublist length is not greater than main list length.\"\"\"\n        return sub.length() <= main.length()\nclass SublistChecker:\n    \"\"\"\n    Orchestrates validation and contiguous subsequence search.\n    It uses injected validator and comparer components.\n    \"\"\"\n    def __init__(self, validator: InputValidator = None, comparer: ComparisonStrategy = None):\n        self._validator = validator if validator is not None else InputValidator()\n        self._comparer = comparer if comparer is not None else ComparisonStrategy()\n\n    def is_sublist(self, main: ListSequence, sub: ListSequence) -> bool:\n        \"\"\"\n        Checks if 'sub' appears as a contiguous subsequence in 'main'.\n        Performs the core search logic.\n        \"\"\"\n        n = main.length()\n        m = sub.length()\n\n        if not self._validator.validate_lengths(main, sub):\n            return False\n\n        if m == 0:\n            return True\n\n        # Get the full sublist's elements once to avoid repeated slicing for 'sub'.\n        sub_elements = sub.get_slice(0, m)\n\n        for i in range(n - m + 1):\n            # Get the candidate slice from main_list for comparison.\n            main_candidate_slice_elements = main.get_slice(i, m)\n\n            match = True\n            for j in range(m):\n                if not self._comparer.equals(main_candidate_slice_elements[j], sub_elements[j]):\n                    match = False\n                    break\n            if match:\n                return True\n        return False\ndef is_sublist(main_list, sublist) -> bool:\n    \"\"\"\n    Top-level API function to check if sublist appears as a contiguous subsequence in main_list.\n    It performs input validation and delegates to SublistChecker for the search.\n    \"\"\"\n    validator = InputValidator()\n    comparer = ComparisonStrategy()\n\n    # Validate inputs are lists as per design (raises TypeError if invalid).\n    validator.validate_list(main_list)\n    validator.validate_list(sublist)\n\n    # Wrap lists in ListSequence for read-only access, ensuring inputs are not modified.\n    main_sequence = ListSequence(main_list)\n    sub_sequence = ListSequence(sublist)\n\n    # Perform early length check; returns False if sublist is longer than main list.\n    if not validator.validate_lengths(main_sequence, sub_sequence):\n        return False\n\n    # Delegate to SublistChecker for the core subsequence checking logic.\n    checker = SublistChecker(validator=validator, comparer=comparer)\n    return checker.is_sublist(main_sequence, sub_sequence)"}
