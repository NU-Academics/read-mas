{"task_id": "Mbpp/583", "solution": "from validator import InputValidator\nfrom error_handler import ErrorHandler\nclass CatalanNumberService:\n    \"\"\"\n    Service for computing Catalan numbers.\n    It uses exact integer arithmetic for calculations.\n    \"\"\"\n    def _binomial_coefficient(self, N: int, K: int) -> int:\n        \"\"\"Computes the binomial coefficient C(N, K) using exact integer arithmetic.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K \n        \n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    def compute_via_binomial(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Catalan number using the formula C_n = C(2n, n) / (n + 1).\n        This method uses exact integer binomial arithmetic.\n        \"\"\"\n        if n == 0:\n            return 1\n        \n        binom_val = self._binomial_coefficient(2 * n, n)\n        return binom_val // (n + 1)\n\n    def catalan_number(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Catalan number.\n        This method delegates to the private compute_via_binomial.\n        \"\"\"\n        return self.compute_via_binomial(n)\n_input_validator = InputValidator()\n_error_handler = ErrorHandler()\n_catalan_service_instance = CatalanNumberService()\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    The public function to get the nth Catalan number.\n    It validates input, computes the number, or raises an error.\n    \"\"\"\n    if not _input_validator.is_non_negative_integer(n):\n        _error_handler.raise_invalid_input_error(\n            \"Input must be a non-negative integer.\"\n        )\n    return _catalan_service_instance.catalan_number(n)"}
{"task_id": "Mbpp/583", "solution": "import math\nfrom typing import Dict, Optional\nfrom datetime import datetime\nclass MemoizationStore:\n    \"\"\"Manages an in-memory cache for Catalan numbers.\"\"\"\n    cache: Dict[int, int]\n\n    def __init__(self):\n        self.cache = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache if present.\"\"\"\n        return self.cache.get(n)\n\n    def put(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache.\"\"\"\n        self.cache[n] = value\n_global_memoization_store = MemoizationStore()\nclass CatalanCalculator:\n    \"\"\"Computes Catalan numbers, optionally using memoization.\"\"\"\n    def __init__(self, memo: Optional[MemoizationStore] = None):\n        self._memo = memo\n        # Initialize C0 = 1 in memoization store, as C0 is the base case.\n        if self._memo:\n            self._memo.put(0, 1)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Primary entry point to compute the nth Catalan number.\"\"\"\n        # Check cache via memo.get(n) if a memoization store is provided.\n        if self._memo:\n            cached_value = self._memo.get(n)\n            if cached_value is not None:\n                return cached_value\n\n        # On cache miss, compute using the preferred algorithm (closed-form binomial).\n        computed_value = self._compute_binomial(n)\n\n        # Store the computed value in the cache for future use.\n        if self._memo:\n            self._memo.put(n, computed_value)\n        \n        return computed_value\n\n    def _compute_binomial(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using the closed-form binomial coefficient (C_n = C(2n, n) / (n+1)).\"\"\"\n        # This method assumes 'n' is a valid non-negative integer.\n        binomial_coeff = math.comb(2 * n, n)\n        return binomial_coeff // (n + 1)\n\n    # The design specifies 'compute_memo' as an optional implementation;\n    # 'compute_binomial' is chosen as the underlying algorithm for direct calculation.\n    # def compute_memo(self, n: int) -> int:\n    #     pass\ndef catalan_number(n: int) -> int:\n    \"\"\"Computes the nth Catalan number (C0 = 1).\"\"\"\n    # The design includes a Validator, but critical requirements forbid\n    # isinstance() checks and raising exceptions. Thus, validation is omitted.\n    \n    # Instantiate CatalanCalculator with the global memoization store.\n    calculator = CatalanCalculator(memo=_global_memoization_store)\n    \n    # Delegate computation to the calculator and return the integer result.\n    return calculator.compute(n)"}
{"task_id": "Mbpp/581", "solution": "from .square_pyramid import SquarePyramid\ndef _validate_numeric(value, name: str) -> float:\n    \"\"\"Validates that a value is numeric (int or float) and casts it to float.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(f\"{name} must be int or float\")\n    return float(value)\nclass SurfaceAreaCalculator:\n    \"\"\"\n    Stateless fa\u00e7ade performing validation and orchestration for surface area calculation.\n    It uses _validate_numeric and SquarePyramid to compute the result.\n    \"\"\"\n    @staticmethod\n    def surface_Area(edge, height):\n        \"\"\"\n        Validates inputs, instantiates SquarePyramid, and computes the surface area.\n        Returns an int if the result is mathematically integral, otherwise a float.\n        \"\"\"\n        e = _validate_numeric(edge, \"edge\")\n        h = _validate_numeric(height, \"height\")\n        pyramid = SquarePyramid(e, h)\n        result = pyramid.surface_area()\n        # Return int if mathematically integral, otherwise float.\n        if isinstance(result, float) and result.is_integer():\n            return int(result)\n        return result\ndef surface_Area(edge, height):\n    \"\"\"\n    Public API for calculating the surface area of a square pyramid.\n    This function delegates to SurfaceAreaCalculator for validation and computation.\n    \"\"\"\n    return SurfaceAreaCalculator.surface_Area(edge, height)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"Rotates a list so elements starting at index n (normalized) appear first.\n    Returns a new list without modifying the input array.\"\"\"\n    if not arr:\n        return []\n    \n    n_mod = n % len(arr)\n    return arr[n_mod:] + arr[:n_mod]"}
{"task_id": "Mbpp/585", "solution": "def _sort_by_price_desc(items):\n    \"\"\"Sorts a list of item dictionaries by their 'price' in descending order.\n    Assumes each item has a numeric 'price' field.\"\"\"\n    return sorted(items, key=lambda it: it['price'], reverse=True)\ndef expensive_items(dataset, n):\n    \"\"\"Returns the n most expensive items from a dataset, sorted by price descending.\n    If n is greater than the dataset size, all items are returned.\"\"\"\n    sorted_items = _sort_by_price_desc(dataset)\n    if n >= len(sorted_items):\n        return sorted_items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/585", "solution": "from dataclasses import dataclass\nfrom typing import List, Dict, Any, Union\ndef _ensure_item_dict(item: Any) -> Dict[str, Union[str, float]]:\n    \"\"\"Normalizes an input item to a dict with 'name' (str) and 'price' (float).\"\"\"\n    return {'name': str(item['name']), 'price': float(item['price'])}\nclass Dataset:\n    \"\"\"Encapsulates a list of Item objects and provides operations to sort and select top-n items.\"\"\"\n    def __init__(self, items: List[Item]):\n        self.items = items\n\n    def sortByPriceDesc(self) -> List[Item]:\n        \"\"\"Returns items sorted by price in descending order (stable sort).\"\"\"\n        return sorted(self.items, key=lambda item: item.price, reverse=True)\n\n    def getTopN(self, n: int) -> List[Item]:\n        \"\"\"Returns the top n items from the dataset, or all items if n is too large.\"\"\"\n        return self.items[:min(n, len(self.items))]\ndef expensive_items(dataset: Union[List[Dict[str, Any]], Dataset], n: int) -> List[Dict[str, Union[str, float]]]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Accepts a list of dicts or a Dataset instance.\n    \"\"\"\n    if isinstance(dataset, Dataset):\n        processed_dataset = dataset\n    else:\n        item_objects = [Item(name=item_dict['name'], price=item_dict['price']) for item_dict in (_ensure_item_dict(d) for d in dataset)]\n        processed_dataset = Dataset(item_objects)\n\n    sorted_items = processed_dataset.sortByPriceDesc()\n    top_n_items = Dataset(sorted_items).getTopN(n)\n\n    return [item.to_dict() for item in top_n_items]"}
