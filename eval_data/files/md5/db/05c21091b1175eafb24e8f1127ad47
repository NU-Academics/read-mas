{"task_id": "Mbpp/92", "solution": "class Number:\n    \"\"\"Represents an integer value and provides its base-10 digit sequence.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def get_digits(self) -> list:\n        \"\"\"Returns the base-10 digit list (most significant digit first).\"\"\"\n        if self.value == 0:\n            return [0]\n        # Convert to absolute value string to handle potential negatives, then to list of ints.\n        return [int(d) for d in str(abs(self.value))]\nclass DigitSequence:\n    \"\"\"Holds a sequence of digits and provides simple queries.\"\"\"\n    def __init__(self, digits: list[int]) -> None:\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def distinct_digits(self) -> set:\n        \"\"\"Returns a set of all distinct digits in the sequence.\"\"\"\n        return set(self.digits)\nclass Result:\n    \"\"\"Simple container for the boolean classification outcome.\"\"\"\n    def __init__(self, is_undulating: bool) -> None:\n        self.is_undulating = is_undulating\nclass UndulatingChecker:\n    \"\"\"Analyzes a Number to determine if it is undulating.\"\"\"\n    def is_undulating(self, number: Number) -> bool:\n        \"\"\"Checks if the number's digit sequence alternates between exactly two distinct digits.\"\"\"\n        digit_sequence = DigitSequence(number.get_digits())\n        digits = digit_sequence.digits\n        length = digit_sequence.length()\n        distinct_set = digit_sequence.distinct_digits()\n\n        # An undulating number must have at least two digits and exactly two distinct digits.\n        if length < 2 or len(distinct_set) != 2:\n            return False\n\n        # Extract the two distinct digits.\n        distinct_list = sorted(list(distinct_set)) # Sort for consistent d1, d2 assignment.\n        d1, d2 = distinct_list[0], distinct_list[1]\n\n        # Determine the expected pattern based on the first two digits.\n        # It must be alternating, so digits[0] must not equal digits[1].\n        if digits[0] == digits[1]:\n            return False\n\n        # If the first digit is d1, the pattern is d1, d2, d1, d2...\n        # Otherwise, the pattern is d2, d1, d2, d1...\n        is_pattern_d1_starts = (digits[0] == d1)\n\n        # Verify the entire sequence follows the alternating pattern.\n        for i in range(length):\n            expected_digit = d1 if (i % 2 == 0) == is_pattern_d1_starts else d2\n            if digits[i] != expected_digit:\n                return False\n\n        return True\ndef is_undulating(n) -> bool:\n    \"\"\"Checks if an integer n is an undulating number.\n    An undulating number alternates between exactly two distinct digits (e.g., 12121).\"\"\"\n    number = Number(n)\n    checker = UndulatingChecker()\n    undulating_status = checker.is_undulating(number)\n    result = Result(undulating_status)\n    return result.is_undulating"}
