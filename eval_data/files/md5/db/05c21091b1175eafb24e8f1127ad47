{"task_id": "Mbpp/638", "solution": "import math\nfrom src.validator import Validator\nfrom src.calculator import WindChillCalculator\nclass Validator:\n    \"\"\"Validates inputs for numeric types.\"\"\"\n    @staticmethod\n    def validate_numeric(velocity, temperature) -> None:\n        \"\"\"Raises TypeError if inputs are not numeric.\"\"\"\n        if not (isinstance(velocity, (int, float)) and isinstance(temperature, (int, float))):\n            raise TypeError(\"velocity_kmh and temperature_c must be numeric (int or float)\")\nclass WindChillCalculator:\n    \"\"\"Computes the raw wind chill index and applies rounding.\"\"\"\n    def wind_chill(self, velocityKmh: float, tempC: float) -> int:\n        \"\"\"Calculates the wind chill, rounding up to the nearest integer.\"\"\"\n        raw = self._computeRawIndex(velocityKmh, tempC)\n        value = math.ceil(raw)\n        return int(value)\n\n    def _computeRawIndex(self, v: float, t: float) -> float:\n        \"\"\"Computes the raw wind chill index using the specified formula.\"\"\"\n        # Chosen formula: raw = t + 0.041 * v\n        return t + 0.041 * v\ndef wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"Validate inputs and return integer wind chill index.\"\"\"\n    Validator.validate_numeric(velocity_kmh, temperature_c)\n    calc = WindChillCalculator()\n    return calc.wind_chill(velocity_kmh, temperature_c)"}
{"task_id": "Mbpp/641", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Domain-specific exception carrying type and message.\n    Raised on validation failures.\n    \"\"\"\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\n        super().__init__(f\"[{self.type}] {self.message}\")\nclass NonagonalService:\n    \"\"\"\n    Encapsulates validation and computation logic for nonagonal numbers.\n    Provides methods to validate input and compute the number using a closed-form formula.\n    \"\"\"\n\n    def validate_input(self, n: any) -> None:\n        \"\"\"\n        Validates that n is a positive integer (n > 0).\n        Raises ValidationError for non-integer or non-positive inputs.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(type='TypeError', message='Input n must be an integer.')\n        if n <= 0:\n            raise ValidationError(type='ValueError', message='Input n must be a positive integer (n > 0).')\n\n    def compute_formula(self, n: int) -> int:\n        \"\"\"\n        Computes the nth nonagonal number using the formula (7*n*n - 5*n)/2.\n        Uses integer arithmetic to ensure exact results.\n        \"\"\"\n        return (7 * n * n - 5 * n) // 2\n\n    def is_nonagonal(self, n: int) -> int:\n        \"\"\"\n        Validates the input 'n' and computes the nth nonagonal number.\n        Delegates to internal validation and computation methods.\n        \"\"\"\n        self.validate_input(n)\n        value = self.compute_formula(n)\n        # As per design, a NonagonalNumber DTO is conceptually computed but this method returns just the int value.\n        return value\n_nonagonal_service = NonagonalService()\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Returns the nth nonagonal number, validating input and using the closed-form formula.\n    Delegates to a NonagonalService instance for its core logic.\n    \"\"\"\n    return _nonagonal_service.is_nonagonal(n)"}
{"task_id": "Mbpp/639", "solution": "from typing import List\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"Sums lengths of names after filtering.\n    Filters out names starting with an ASCII lowercase letter [a-z].\"\"\"\n    total_length = 0\n    for name in names:\n        # Include names if they are empty or their first character is not an ASCII lowercase letter.\n        # Assumes 'names' contains only strings as per type hint and critical requirement to trust input.\n        if not name or not ('a' <= name[0] <= 'z'):\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/639", "solution": "from typing import List\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Computes the sum of lengths of names after filtering.\n    Removes names starting with a lowercase ASCII letter.\n    \"\"\"\n    total_length = 0\n    for name_str in names:\n        if not name_str:\n            continue\n        \n        first_char = name_str[0]\n        # Check if the first character is an ASCII lowercase letter 'a' through 'z'\n        is_lowercase_start = 'a' <= first_char <= 'z'\n        \n        # If the name does not start with a lowercase letter, retain it and sum its length\n        if not is_lowercase_start:\n            total_length += len(name_str)\n            \n    return total_length"}
{"task_id": "Mbpp/638", "solution": "import math\nclass WindChillRequest:\n    \"\"\"Holds input parameters for wind chill calculation.\"\"\"\n    def __init__(self, velocity_kmh: float, temperature_c: float) -> None:\n        self.velocity_kmh = float(velocity_kmh)\n        self.temperature_c = float(temperature_c)\nclass WindChillResult:\n    \"\"\"Holds computed wind chill values and units.\"\"\"\n    def __init__(self, raw_value: float, rounded_value: int, units: str) -> None:\n        self.raw_value = raw_value\n        self.rounded_value = rounded_value\n        self.units = units\nclass WindChillCalculator:\n    \"\"\"Performs the raw wind chill computation and rounding.\"\"\"\n    def wind_chill(self, velocity_kmh: float, temperature_c: float) -> tuple[float, int]:\n        \"\"\"Orchestrates raw computation and rounding, returning both raw and rounded values.\"\"\"\n        raw_value = self.compute_raw(velocity_kmh, temperature_c)\n        rounded_value = self.round_to_integer(raw_value)\n        return raw_value, rounded_value\n\n    def compute_raw(self, velocity_kmh: float, temperature_c: float) -> float:\n        \"\"\"Computes the raw wind chill index using the empirical formula.\"\"\"\n        T = temperature_c\n        V = velocity_kmh\n        v_pow_0_16 = math.pow(V, 0.16)\n        \n        raw_value = (\n            13.12 \n            + 0.6215 * T \n            - 11.37 * v_pow_0_16 \n            + 0.3965 * T * v_pow_0_16\n        )\n        return raw_value\n\n    def round_to_integer(self, value: float) -> int:\n        \"\"\"Rounds a float value to the nearest integer.\"\"\"\n        return int(round(value))\ndef wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"Calculates the wind chill index for given velocity and temperature.\"\"\"\n    request = WindChillRequest(velocity_kmh, temperature_c)\n    \n    calculator = WindChillCalculator()\n    raw_value, rounded_value = calculator.wind_chill(request.velocity_kmh, request.temperature_c)\n    \n    # Create WindChillResult instance as per design, but the public API returns an int.\n    _ = WindChillResult(raw_value=raw_value, rounded_value=rounded_value, units=\"\u00b0C\")\n\n    return rounded_value"}
