{"task_id": "Mbpp/451", "solution": "from typing import List\nclass WhitespaceCharacter:\n    \"\"\"Provides predicate to determine if a character is whitespace.\"\"\"\n    def __init__(self, char: str):\n        # Trusting caller provides a single character string as per design.\n        self.char = char\n\n    def isWhitespace(self) -> bool:\n        \"\"\"Returns True if char is classified as whitespace per Unicode categories.\"\"\"\n        return self.char.isspace()\nclass ErrorHandler:\n    \"\"\"Handles invalid-type or unexpected inputs gracefully.\"\"\"\n    def handleInvalidInput(self, input_value: object) -> str:\n        \"\"\"Raises a ValueError for invalid input types, per design choice.\"\"\"\n        raise ValueError(f\"Invalid input type: expected string, got {type(input_value).__name__}\")\nclass RemoveWhitespacesFunction:\n    \"\"\"Encapsulates logic to remove whitespace from strings, preserving order.\"\"\"\n    def __init__(self, error_handler: ErrorHandler = None):\n        self.error_handler = error_handler if error_handler is not None else ErrorHandler()\n\n    def isValidInput(self, input_value: object) -> bool:\n        \"\"\"Validates if the input is a string, as required by design.\"\"\"\n        return isinstance(input_value, str)\n\n    def remove_whitespaces(self, input_value: str) -> str:\n        \"\"\"Removes all whitespace characters from the input string.\"\"\"\n        if not self.isValidInput(input_value):\n            self.error_handler.handleInvalidInput(input_value)\n\n        cleaned_chars: List[str] = []\n        for char in input_value:\n            whitespace_char = WhitespaceCharacter(char)\n            if not whitespace_char.isWhitespace():\n                cleaned_chars.append(char)\n        return \"\".join(cleaned_chars)\n_remove_whitespaces_instance = RemoveWhitespacesFunction()\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"Standalone function to remove all whitespace characters from the given string.\"\"\"\n    return _remove_whitespaces_instance.remove_whitespaces(input)"}
{"task_id": "Mbpp/453", "solution": "from .sumofactors import sumofFactors\nimport math\nfrom typing import List\nfrom typing import List\nfrom .validator import Validator\nfrom .number import Number\nfrom .factor import Factor\nclass Validator:\n    \"\"\"Validates input preconditions for the algorithm (integer type and n >= 1).\"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"\n        Checks if n is an integer and n is greater than or equal to 1.\n        Returns True if valid, False otherwise.\n        \"\"\"\n        return isinstance(n, int) and n >= 1\nclass Number:\n    \"\"\"Encapsulates an integer value and computes its positive divisors.\"\"\"\n    def __init__(self, value: int):\n        \"\"\"Initializes the Number object with an integer value.\"\"\"\n        self.value = value\n\n    def getFactors(self) -> List[int]:\n        \"\"\"\n        Computes and returns a list of all distinct positive divisors of the stored value.\n        Uses an optimized approach by checking divisors up to the square root of the number.\n        \"\"\"\n        factors = set()\n        # The validator ensures self.value >= 1\n        if self.value == 1:\n            return [1]\n\n        for i in range(1, int(math.sqrt(self.value)) + 1):\n            if self.value % i == 0:\n                factors.add(i)\n                factors.add(self.value // i)\n        return sorted(list(factors))\nclass SumOfFactors:\n    \"\"\"\n    Coordinates validation, factor computation, filtering and aggregation.\n    Orchestrates the process of finding the sum of distinct even positive divisors.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes SumOfFactors with a Validator instance.\"\"\"\n        self.validator = Validator()\n\n    def sum(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of all distinct even positive divisors of n.\n        Raises ValueError if n is not a valid input (not int or n < 1).\n        \"\"\"\n        if not self.validator.validate(n):\n            raise ValueError(\"Input 'n' must be an integer greater than or equal to 1.\")\n\n        number_obj = Number(n)\n        all_factors: List[int] = number_obj.getFactors()\n\n        # Filter for even factors and sum them\n        # Per design: \"Optionally creates Factor objects or directly filters divisors where d % 2 == 0.\"\n        even_factors_sum = 0\n        for factor_value in all_factors:\n            if factor_value % 2 == 0:\n                even_factors_sum += factor_value\n        \n        return even_factors_sum\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all distinct even positive divisors of n.\n    This is the public entry point for the library.\n    \"\"\"\n    calculator = SumOfFactors()\n    return calculator.sum(n)"}
{"task_id": "Mbpp/451", "solution": "from src.domain import WhitespaceCharacters\nfrom src.domain import InputString, OutputString, WhitespaceCharacters\nfrom src.validator import Validator\nfrom .remove_whitespaces import remove_whitespaces\nclass WhitespaceCharacters:\n    \"\"\"Enumerates whitespace characters to remove.\"\"\"\n    SPACE = ' '\n    TAB = '\\t'\n    NEWLINE = '\\n'\n    CARRIAGE_RETURN = '\\r'\n    CHARS = {SPACE, TAB, NEWLINE, CARRIAGE_RETURN}\nclass InputString:\n    \"\"\"Immutable wrapper around raw input string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the input string is empty.\"\"\"\n        return len(self.raw) == 0\n\n    def is_whitespace_only(self) -> bool:\n        \"\"\"Checks if the input string contains only specified whitespace characters.\"\"\"\n        if not self.raw:\n            return True\n        return all(c in WhitespaceCharacters.CHARS for c in self.raw)\nclass OutputString:\n    \"\"\"Immutable wrapper for the produced string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the wrapped string value.\"\"\"\n        return self.value\nclass Validator:\n    \"\"\"Stateless checks for emptiness and whitespace-only content.\"\"\"\n    def contains_only_whitespace_chars(self, s: str) -> bool:\n        \"\"\"Returns True if s is empty or every character in s is one of the WhitespaceCharacters set.\"\"\"\n        if not s:\n            return True\n        return all(char in WhitespaceCharacters.CHARS for char in s)\nclass RemoveWhitespacesService:\n    \"\"\"Orchestrates the removal of whitespace characters from a string.\"\"\"\n    def __init__(self) -> None:\n        self._validator = Validator()\n        self._whitespace_set = WhitespaceCharacters.CHARS\n\n    def remove_whitespaces(self, input_str: str) -> str:\n        \"\"\"Removes specified whitespace characters from the input string.\"\"\"\n        input_obj = InputString(input_str)\n\n        if self._validator.contains_only_whitespace_chars(input_obj.raw):\n            return OutputString(\"\").get_value()\n\n        filtered_chars = []\n        for char in input_obj.raw:\n            if char not in self._whitespace_set:\n                filtered_chars.append(char)\n\n        return OutputString(\"\".join(filtered_chars)).get_value()\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"\n    Public API function to remove all specified whitespace characters from a string.\n    Returns a new string with spaces, tabs, newlines, and carriage returns removed.\n    \"\"\"\n    service = RemoveWhitespacesService()\n    return service.remove_whitespaces(input)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Computes the sum of all even positive divisors of n.\n    Returns 0 if n is non-positive or has no even divisors.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    # Iterate from 1 up to the square root of n to find divisors efficiently.\n    # The upper limit int(n**0.5) ensures factors are found in pairs.\n    for d in range(1, int(n**0.5) + 1):\n        if n % d == 0:\n            # d is a divisor\n            if d % 2 == 0:\n                total_sum += d\n\n            # Compute the other divisor in the pair\n            other_d = n // d\n            # Avoid adding d again if n is a perfect square (d * d == n)\n            if other_d != d:\n                if other_d % 2 == 0:\n                    total_sum += other_d\n    return total_sum"}
