{"task_id": "Mbpp/564", "solution": "from typing import List\ndef iteratePairs(arr: List[int], n: int) -> int:\n    \"\"\"\n    Counts unordered pairs (i, j) with 0 <= i < j < n where arr[i] != arr[j).\n    It uses a nested loop for a straightforward O(n^2) iteration.\n    \"\"\"\n    unequal_pairs_count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] != arr[j]:\n                unequal_pairs_count += 1\n    return unequal_pairs_count\ndef count_Pairs(arr: List[int], n: int) -> int:\n    \"\"\"\n    Validates inputs and returns the count of unordered unequal index pairs.\n    Indices are considered for 0 <= i < j < n.\n    \"\"\"\n    validateInputs(arr, n)\n    return iteratePairs(arr, n)"}
