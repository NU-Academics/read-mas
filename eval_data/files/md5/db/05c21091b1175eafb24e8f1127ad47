{"task_id": "Mbpp/259", "solution": "from typing import Tuple, Any\ndef maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the element-wise maximum of two tuple-of-tuples inputs.\n    Returns a new tuple-of-tuples where each element is max(a_val, b_val).\n    \"\"\"\n    validate_shape(a, b)\n    validate_element_types(a, b)\n\n    result_outer = []\n    for i in range(len(a)):\n        ai = a[i]\n        bi = b[i]\n        result_inner = [max(ai[j], bi[j]) for j in range(len(ai))]\n        result_outer.append(tuple(result_inner))\n    \n    return tuple(result_outer)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple, Any\ndef _compute_inner_max(inner1: Tuple[Any, ...], inner2: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    return tuple(max(e1, e2) for e1, e2 in zip(inner1, inner2))\ndef maximize_elements(input1: Tuple[Tuple[Any, ...], ...], input2: Tuple[Tuple[Any, ...], ...]) -> Tuple[Tuple[Any, ...], ...]:\n    _validate_outer_lengths(input1, input2)\n    _validate_inner_lengths(input1, input2)\n\n    # Compute element-wise maxima for each corresponding pair of inner tuples.\n    # The result is a new tuple of tuples, preserving input ordering.\n    result_inner_tuples = []\n    for i in range(len(input1)):\n        result_inner_tuples.append(_compute_inner_max(input1[i], input2[i]))\n\n    return tuple(result_inner_tuples)"}
{"task_id": "Mbpp/260", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass ErrorHandler:\n    \"\"\"Handles the creation and raising of specific exceptions.\"\"\"\n    @staticmethod\n    def raise_invalid_input(message: str) -> Exception:\n        \"\"\"Raises an InvalidInputError with the given message, centralizing error construction.\"\"\"\n        raise InvalidInputError(message)\nclass InputValidator:\n    \"\"\"Validates input parameters according to specified rules.\"\"\"\n    def validate_n(self, n: any) -> None:\n        \"\"\"Validates that n is an integer and greater than or equal to 1, otherwise raises an error.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            ErrorHandler.raise_invalid_input(\"Input 'n' must be an integer >= 1.\")\nclass PrimeTester:\n    \"\"\"Provides functionality to test the primality of numbers.\"\"\"\n\n    @staticmethod\n    def is_prime(value: int) -> bool:\n        \"\"\"\n        Determines if a number is prime using trial division.\n        This algorithm is deterministic and correct for all integers,\n        with a time complexity of O(sqrt(value)).\n        \"\"\"\n        if value < 2:\n            return False\n        if value == 2:\n            return True\n        if value % 2 == 0:\n            return False\n        # Check for odd divisors from 3 up to the square root of the value.\n        i = 3\n        while i * i <= value:\n            if value % i == 0:\n                return False\n            i += 2\n        return True\nclass NSWNumber:\n    \"\"\"Data container for a single Newman-Shanks-Williams term.\"\"\"\n    def __init__(self, index: int, value: int, isPrime: bool = False):\n        self.index = index\n        self.value = value\n        self.isPrime = isPrime\nclass NewmanShanksWilliamsGenerator:\n    \"\"\"Generates terms of the Newman-Shanks-Williams sequence.\"\"\"\n\n    def __init__(self):\n        self._cache = {0: 1, 1: 1} # Cache for efficiency, initialized with base cases N_0 and N_1.\n\n    def generate_term(self, index: int) -> int:\n        \"\"\"\n        Computes the Newman-Shanks-Williams (NSW) number for a given index.\n        The sequence is 0-indexed: N_0 = 1, N_1 = 1, and N_k = 2 * N_{k-1} + N_{k-2} for k >= 2.\n        \"\"\"\n        if index < 0:\n            raise ValueError(\"NSW index must be non-negative.\")\n        \n        if index in self._cache:\n            return self._cache[index]\n\n        # Iteratively compute and cache terms up to the requested index to avoid deep recursion.\n        for k in range(max(self._cache.keys()) + 1, index + 1):\n            n_k_minus_1 = self._cache[k-1]\n            n_k_minus_2 = self._cache[k-2]\n            self._cache[k] = 2 * n_k_minus_1 + n_k_minus_2\n\n        return self._cache[index]\n\n    def generate_until_prime_count(self, count: int) -> list:\n        \"\"\"\n        Generates NSW terms, tests their primality, and collects 'count' NSW primes.\n        Generation stops immediately once 'count' primes have been identified.\n        \"\"\"\n        collected_primes = []\n        current_nsw_index = 0\n        while len(collected_primes) < count:\n            nsw_value = self.generate_term(current_nsw_index)\n            is_prime = PrimeTester.is_prime(nsw_value)\n            \n            nsw_number = NSWNumber(index=current_nsw_index, value=nsw_value, isPrime=is_prime)\n            \n            if is_prime:\n                collected_primes.append(nsw_number)\n            \n            current_nsw_index += 1\n        \n        return collected_primes\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number by orchestrating validation,\n    term generation, and primality testing. Returns the value of the nth prime.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_n(n)\n\n    generator = NewmanShanksWilliamsGenerator()\n    nsw_primes = generator.generate_until_prime_count(n)\n    \n    # The last element in the collected list is the nth NSW prime found.\n    return nsw_primes[-1].value"}
{"task_id": "Mbpp/261", "solution": "class DivisionService:\n    \"\"\"\n    DivisionService handles the core logic for element-wise tuple division, including validations.\n    It orchestrates validation and computation steps for tuple division.\n    \"\"\"\n\n    def validateLengths(self, numeratorTuple: tuple, denominatorTuple: tuple) -> None:\n        \"\"\"Raises ValueError if the input tuples have different lengths.\"\"\"\n        if len(numeratorTuple) != len(denominatorTuple):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    def validateNumericElements(self, t: tuple) -> None:\n        \"\"\"Raises TypeError if any element in the tuple is not an int or float.\"\"\"\n        for element in t:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All tuple elements must be numeric (int or float).\")\n\n    def checkZeroDenominators(self, denominatorTuple: tuple) -> None:\n        \"\"\"Raises ZeroDivisionError if any denominator element is zero.\"\"\"\n        for element in denominatorTuple:\n            if element == 0:\n                raise ZeroDivisionError(\"Denominator cannot contain zero.\")\n\n    def division_elements(self, numeratorTuple: tuple, denominatorTuple: tuple) -> tuple:\n        \"\"\"\n        Performs element-wise division after comprehensive validation of inputs.\n        This method orchestrates all validation and then computes the result tuple.\n        \"\"\"\n        self.validateLengths(numeratorTuple, denominatorTuple)\n        self.validateNumericElements(numeratorTuple)\n        self.validateNumericElements(denominatorTuple)\n        self.checkZeroDenominators(denominatorTuple)\n\n        results = []\n        for i in range(len(numeratorTuple)):\n            # Computes division using real-division semantics.\n            results.append(numeratorTuple[i] / denominatorTuple[i])\n\n        return tuple(results)\ndef division_elements(numerator_tuple: tuple, denominator_tuple: tuple) -> tuple:\n    \"\"\"\n    Public entry point for element-wise tuple division.\n    It delegates the operation to an internal DivisionService instance for execution.\n    \"\"\"\n    service = DivisionService()\n    return service.division_elements(numerator_tuple, denominator_tuple)"}
