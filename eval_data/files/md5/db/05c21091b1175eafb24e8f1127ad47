{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Returns a list of elements that are equal across three input lists at the same index.\n    Compares elements only up to the minimum length of the three lists.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/754", "solution": "from .validator import Validator\nfrom .index_iterator import IndexIterator\nfrom .result_list import ResultList\nclass ExtractIndexListFunction:\n    \"\"\"\n    Orchestrates validation, iteration, comparison, and collection of elements\n    that appear at the same index in three input sequences.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the function's internal components.\"\"\"\n        self._validator: Validator = Validator()\n        self._result: ResultList = ResultList()\n        self._min_length: int = 0\n        self._index_iterator: IndexIterator = None\n        self._l1 = None\n        self._l2 = None\n        self._l3 = None\n\n    def extract(self, l1, l2, l3) -> list:\n        \"\"\"\n        Main orchestration method to extract common elements.\n        Validates inputs, sets up iteration, performs comparisons, and collects results.\n        \"\"\"\n        self.validateInputs(l1, l2, l3)\n        self.iterateToShortest(l1, l2, l3)\n\n        while self._index_iterator.has_next():\n            i = self._index_iterator.next()\n            if self.compareAtIndex(i):\n                self._appendResult(self._l1[i])\n\n        return self._result.to_list()\n\n    def validateInputs(self, l1, l2, l3) -> None:\n        \"\"\"\n        Validates that all three inputs are 'list-like' (support len() and __getitem__).\n        Raises TypeError if any input is invalid.\n        \"\"\"\n        if not (self._validator.is_list_like(l1) and\n                self._validator.is_list_like(l2) and\n                self._validator.is_list_like(l3)):\n            raise TypeError(\"All inputs must be list-like (support len() and __getitem__).\")\n\n    def iterateToShortest(self, l1, l2, l3) -> None:\n        \"\"\"\n        Computes and caches the minimum length of the input sequences,\n        and initializes the index iterator. Caches input lists for access.\n        \"\"\"\n        self._l1 = l1\n        self._l2 = l2\n        self._l3 = l3\n        self._min_length = min(len(l1), len(l2), len(l3))\n        self._index_iterator = IndexIterator(self._min_length)\n\n    def compareAtIndex(self, i: int) -> bool:\n        \"\"\"\n        Compares elements at a given index 'i' across all three input sequences.\n        Returns True if elements at index 'i' are equal in all three.\n        \"\"\"\n        return self._l1[i] == self._l2[i] == self._l3[i]\n\n    def _appendResult(self, value) -> None:\n        \"\"\"Appends a matched value to the internal ResultList.\"\"\"\n        self._result.append(value)\ndef extract_index_list(l1, l2, l3) -> list:\n    \"\"\"\n    Public API function to find common elements at the same index in three list-like sequences.\n    Delegates the core logic to an ExtractIndexListFunction instance.\n    \"\"\"\n    extractor = ExtractIndexListFunction()\n    return extractor.extract(l1, l2, l3)"}
