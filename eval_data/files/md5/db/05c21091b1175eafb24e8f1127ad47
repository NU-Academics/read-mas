{"task_id": "Mbpp/119", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef validate_preconditions(nums: List[int]) -> bool:\n    \"\"\"Validates if the input list is sorted and has the required multiplicity pattern.\"\"\"\n    if not SortedIntegerArray(nums).is_sorted():\n        return False\n    \n    if len(nums) % 2 == 0:\n        return False # Array length must be odd for one unique element with others in pairs.\n\n    # Manually count frequencies to ensure the multiplicity pattern.\n    counts = {}\n    for x in nums:\n        counts[x] = counts.get(x, 0) + 1\n\n    count_of_ones = 0\n    for count in counts.values():\n        if count == 1:\n            count_of_ones += 1\n        elif count != 2:\n            return False # An element has a count other than 1 or 2.\n    \n    return count_of_ones == 1 # Exactly one element must appear once.\ndef search(nums: List[int]) -> int:\n    \"\"\"Finds the element that appears only once in a sorted array where others appear twice.\"\"\"\n    if not validate_preconditions(nums):\n        raise ValueError(\"Input does not satisfy preconditions (not sorted or wrong multiplicity).\")\n\n    # Use binary search to find the single element efficiently.\n    # The unique element breaks the pattern of pairs (num, num) at even/odd indices.\n    low, high = 0, len(nums) - 1\n    while low < high:\n        mid = (low + high) // 2\n        # `mid ^ 1` gives `mid + 1` if `mid` is even, and `mid - 1` if `mid` is odd.\n        # This checks if `nums[mid]` forms a pair with its standard partner.\n        if nums[mid] == nums[mid ^ 1]:\n            low = mid + 1 # `nums[mid]` is part of a pair; the unique element is to the right.\n        else:\n            high = mid # The unique element is `nums[mid]` or to its left.\n\n    return nums[low]"}
{"task_id": "Mbpp/119", "solution": "from typing import List\ndef search(nums: List[int]) -> int:\n    \"\"\"Return the element that appears only once in a sorted list where every other element appears exactly twice.\n\n    Preconditions: nums is sorted; exactly one value appears once, others twice.\n    \"\"\"\n    lo, hi = 0, len(nums) - 1\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        \n        if mid % 2 == 0:\n            if nums[mid] == nums[mid+1]:\n                lo = mid + 2\n            else:\n                hi = mid\n        else:\n            if nums[mid] == nums[mid-1]:\n                lo = mid + 1\n            else:\n                hi = mid\n    return nums[lo]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Iterable\nfrom numbers import Number\ndef _abs_product(pair: Tuple[Number, Number]) -> Number:\n    \"\"\"Return abs(pair[0] * pair[1]).\"\"\"\n    return abs(pair[0] * pair[1])\ndef _max_of_iterable(values: Iterable[Number]) -> Number:\n    \"\"\"Return max of values. Caller ensures non-empty iterable.\"\"\"\n    return max(values)\ndef max_product_tuple(pairs: List[Tuple[Number, Number]]) -> Number:\n    \"\"\"Public API: returns maximum absolute product among pairs.\"\"\"\n    absolute_products = (_abs_product(pair) for pair in pairs)\n    return _max_of_iterable(absolute_products)"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(list_of_tuples):\n    \"\"\"\n    Finds the maximum absolute product from a list of 2-element numeric tuples.\n    Assumes valid input conforming to the problem statement.\n    \"\"\"\n    max_abs_product = 0.0\n\n    # Initialize max_abs_product with the absolute product of the first tuple\n    # This handles cases where all subsequent products are smaller or negative.\n    # Given the 'trust the caller's inputs' constraint, the list is assumed non-empty\n    # and its first item is a valid 2-element numeric tuple.\n    a, b = list_of_tuples[0]\n    max_abs_product = abs(a * b)\n\n    # Iterate through the rest of the list, updating the maximum absolute product\n    for item in list_of_tuples[1:]:\n        a, b = item\n        current_product = a * b\n        current_abs_product = abs(current_product)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n\n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "from .divisor_calculator import DivisorCalculator\nfrom .amicable_pair import AmicablePair\nfrom .result import Result\nfrom .number import Number\nfrom typing import Set\nclass AmicableService:\n    \"\"\"Coordinates the amicable-number computation; discovers and sums amicable numbers.\"\"\"\n    def __init__(self):\n        self.calculator: DivisorCalculator = DivisorCalculator()\n        self.discoveredAmicables: Set[int] = set()\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"\n        Scans 1..n to find amicable numbers and returns their sum.\n        Input validation for n is omitted per critical requirements.\n        \"\"\"\n        # Per critical requirement, input validation (n must be int and >= 1) is omitted.\n        # Assume n is a positive integer.\n\n        for a in range(1, n + 1):\n            # No optimization to skip 'a' if already in discoveredAmicables, as per design text.\n            b_candidate = self.calculator.sumProperDivisors(a)\n\n            # Check if b_candidate is within the specified range (1..n) and positive.\n            if 1 <= b_candidate <= n:\n                # Use AmicablePair to validate the relationship between a and b_candidate.\n                pair = AmicablePair(a, b_candidate)\n                if pair.isValid():\n                    self.discoveredAmicables.add(a)\n                    self.discoveredAmicables.add(b_candidate)\n\n        return sum(self.discoveredAmicables)\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Top-level library function for amicable numbers sum, instantiating AmicableService.\"\"\"\n    service = AmicableService()\n    return service.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/123", "solution": "class DivisorCalculator:\n    \"\"\"\n    Computes the sum of proper divisors for integers.\n    Proper divisors exclude the number itself.\n    \"\"\"\n    def sum_proper_divisors(self, x: int) -> int:\n        \"\"\"\n        Calculates the sum of proper divisors for x.\n        Returns 0 for x <= 1 as per divisor semantics.\n        \"\"\"\n        if x <= 1:\n            return 0\n        s = 1  # 1 is always a proper divisor for x > 1\n        # Iterate up to sqrt(x) to find divisors efficiently.\n        for i in range(2, int(x**0.5) + 1):\n            if x % i == 0:\n                s += i\n                if i * i != x:  # Add the pair divisor if it's not the square root\n                    s += x // i\n        return s\nclass Number:\n    \"\"\"\n    Domain record representing an integer and its computed divisor sum and perfect flag.\n    Encapsulates a number's value and its related properties.\n    \"\"\"\n    def __init__(self, value: int, divisor_sum: int):\n        self.value = value\n        self.divisor_sum = divisor_sum\n        # Determine if the number is perfect upon initialization.\n        self._is_perfect = (self.divisor_sum == self.value)\n\n    def is_perfect(self) -> bool:\n        \"\"\"\n        Checks if the number is a perfect number.\n        A perfect number's proper divisors sum to itself.\n        \"\"\"\n        return self._is_perfect\nclass AmicablePair:\n    \"\"\"\n    Encapsulates the logic to decide if two Number instances form an amicable pair.\n    Applies business rules BR1, BR3, BR6 for amicable classification.\n    \"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = a\n        self.b = b\n\n    def is_amicable(self) -> bool:\n        \"\"\"\n        Returns True if `a` and `b` form an amicable pair according to BR1, BR3, BR6.\n        Checks for distinctness, mutual divisor sums, and non-perfect status.\n        \"\"\"\n        # BR1: a != b AND sum_proper_divisors(a) == b AND sum_proper_divisors(b) == a\n        # BR3, BR6: Exclude perfect numbers (sum_proper_divisors(x) == x)\n        return (self.a.value != self.b.value and\n                self.a.divisor_sum == self.b.value and\n                self.b.divisor_sum == self.a.value and\n                not self.a.is_perfect() and\n                not self.b.is_perfect())\nclass ResultAccumulator:\n    \"\"\"\n    Accumulates a total sum of integers, ensuring each integer is added exactly once.\n    Uses a set to track seen numbers, enforcing uniqueness (BR8).\n    \"\"\"\n    def __init__(self):\n        self.total = 0\n        self.seen = set() # Stores numbers already added to prevent duplicates\n\n    def add(self, x: int) -> None:\n        \"\"\"\n        Adds `x` to the total if it has not been seen before.\n        Marks `x` as seen after addition.\n        \"\"\"\n        if x not in self.seen:\n            self.total += x\n            self.seen.add(x)\n\n    def total_value(self) -> int:\n        \"\"\"\n        Returns the current accumulated total sum of unique numbers.\n        \"\"\"\n        return self.total\nclass AmicableNumbersService:\n    \"\"\"\n    Orchestrates the identification and summation of amicable numbers within a given range.\n    Manages the overall computation flow and enforces all business rules (BR1\u2013BR9).\n    \"\"\"\n    def __init__(self):\n        self.divisor_calculator = DivisorCalculator()\n        self.accumulator = ResultAccumulator()\n        # Cache for Number objects to avoid recomputing divisor sums.\n        self.computed_numbers: dict[int, Number] = {}\n\n    def _get_number_model(self, val: int) -> Number:\n        \"\"\"\n        Retrieves a Number object for `val` from cache or computes it if not found.\n        This method ensures divisor sums are computed only once per number.\n        \"\"\"\n        if val not in self.computed_numbers:\n            divisor_sum = self.divisor_calculator.sum_proper_divisors(val)\n            self.computed_numbers[val] = Number(value=val, divisor_sum=divisor_sum)\n        return self.computed_numbers[val]\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of all amicable numbers from 1 to `n` (inclusive).\n        This method iterates, identifies pairs, and accumulates unique members satisfying BR1-BR9.\n        \"\"\"\n        # Acknowledge the unspecified behavior for n < 1 by returning 0,\n        # though SRS doesn't require validation.\n        if n < 1:\n            return 0\n\n        # Pre-compute and cache Number objects for all numbers up to n.\n        # This optimizes lookups within the primary range [1, n].\n        for x_val in range(1, n + 1):\n            self._get_number_model(x_val)\n\n        for x_val in range(1, n + 1):\n            num_x = self.computed_numbers[x_val]\n            y_val = num_x.divisor_sum\n\n            # Skip if x is perfect or y_val is too small/same, to avoid trivial pairs.\n            if num_x.is_perfect() or y_val <= 1 or y_val == x_val:\n                continue\n\n            num_y = self._get_number_model(y_val) # Get Number for y, potentially computing if y > n\n\n            pair = AmicablePair(num_x, num_y)\n\n            if pair.is_amicable():\n                # BR2: Include both members only if each member is in 1..n.\n                if num_x.value <= n and num_y.value <= n:\n                    self.accumulator.add(num_x.value)\n                    self.accumulator.add(num_y.value)\n\n        return self.accumulator.total_value()\n_amicable_service_instance = AmicableNumbersService()\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers in the inclusive range 1 to `n`.\n    This function serves as the public API entry point and delegates to the service.\n    \"\"\"\n    return _amicable_service_instance.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/124", "solution": "import math\nclass MathUtils:\n    \"\"\"Provides mathematical utility functions and constants.\n    Wraps standard library math functions for consistency.\n    \"\"\"\n    PI: float = math.pi\n\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        \"\"\"Wrapper for math.atan2, computing the arc tangent of y/x.\n        Returns the angle in radians in the range (-pi, pi].\n        \"\"\"\n        return math.atan2(y, x)\nclass InputValidator:\n    \"\"\"Validates and converts supported input types to Python complex.\n    Supports complex, float, and int types as input.\n    \"\"\"\n    @staticmethod\n    def is_valid_complex_or_numeric(x) -> bool:\n        \"\"\"Checks if the input is a valid complex, float, or int type.\"\"\"\n        return isinstance(x, (complex, float, int))\n\n    @staticmethod\n    def to_complex(x) -> complex:\n        \"\"\"Converts a valid numeric input to a Python complex number.\n        If the type is not complex, float, or int, it raises a TypeError.\n        \"\"\"\n        if isinstance(x, complex):\n            return x\n        if isinstance(x, (int, float)):\n            return complex(x, 0.0)\n        # This error is a fallback if is_valid_complex_or_numeric was not called or its check was bypassed.\n        raise TypeError(\"InputValidator.to_complex: unsupported type encountered during conversion.\")\nclass AngleCalculator:\n    \"\"\"Computes the argument (angle) of a complex number.\n    Uses MathUtils.atan2 for numerically robust computation.\n    \"\"\"\n    @staticmethod\n    def angle_complex(c: complex) -> float:\n        \"\"\"Calculates the angle of a Python complex number.\n        Returns the angle in radians using atan2(imag, real).\n        \"\"\"\n        return MathUtils.atan2(c.imag, c.real)\ndef angle_complex(z) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number `z` in radians.\n\n    Validates input type, converts to a Python complex number, and\n    calculates the angle using a numerically robust method (atan2).\n    The angle is returned as a float in the range (-pi, pi].\n\n    Supported input types: Python `complex`, `float`, and `int`.\n    Raises `TypeError` for unsupported input types.\n\n    Edge case 0+0j: For z = 0+0j (or equivalent float/int 0),\n    `math.atan2(0.0, 0.0)` returns `0.0` per IEEE 754 standard,\n    which is the value returned by this function. This behavior\n    addresses the SRS's unresolved item.\n    \"\"\"\n    if not InputValidator.is_valid_complex_or_numeric(z):\n        raise TypeError(\"angle_complex: unsupported input type; expected complex, float, or int\")\n\n    complex_z = InputValidator.to_complex(z)\n    angle = AngleCalculator.angle_complex(complex_z)\n    return float(angle)"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Tuple\nclass InputValidator:\n    \"\"\"Validates input forms and returns normalized (real, imag) floats or raises TypeError.\"\"\"\n    @staticmethod\n    def validate(args: tuple) -> Tuple[float, float]:\n        \"\"\"Validate args and return (real, imag) as floats or raise TypeError.\"\"\"\n        if len(args) == 1 and isinstance(args[0], complex):\n            return (float(args[0].real), float(args[0].imag))\n        elif len(args) == 2 and isinstance(args[0], (int, float)) and isinstance(args[1], (int, float)):\n            return (float(args[0]), float(args[1]))\n        else:\n            raise TypeError(\"angle_complex accepts either (complex) or (real, imag) numeric arguments\")\ndef angle_complex(*args) -> float:\n    \"\"\"Public API: returns the principal-value angle of a complex number in radians.\"\"\"\n    real, imag = InputValidator.validate(args)\n    angle = math.atan2(imag, real)\n    return float(angle)"}
{"task_id": "Mbpp/125", "solution": "from .binary_string import BinaryString\nfrom .result import Result\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between '0's and '1's in any substring.\n    Raises ValueError for invalid or empty input strings.\n    \"\"\"\n    bs = BinaryString(binary_string)\n\n    if not bs.validate():\n        raise ValueError(\"Input must contain only '0' and '1' characters and be non-empty.\")\n\n    result = Result()\n    for sub in bs.substrings():\n        result.update(sub.difference())\n\n    return result.value()"}
{"task_id": "Mbpp/126", "solution": "import math\nimport builtins\ndef find_common_divisors(a: int, b: int) -> list[int]:\n    \"\"\"Computes and returns a list of positive integers that divide both input integers.\"\"\"\n    g = math.gcd(a, b)\n    g = abs(g)\n\n    if g == 0:\n        # If both a and b are 0, math.gcd returns 0.\n        # In this context, there are no finite positive common divisors to sum.\n        return []\n\n    divisors = set()\n    for i in range(1, int(math.sqrt(g)) + 1):\n        if g % i == 0:\n            divisors.add(i)\n            divisors.add(g // i)\n    return sorted(list(divisors))\ndef sum(a: int, b: int) -> int:\n    \"\"\"Computes the sum of all positive integers that divide both input integers.\"\"\"\n    divisors = find_common_divisors(a, b)\n    return builtins.sum(divisors)"}
{"task_id": "Mbpp/125", "solution": "# src/models.py\nclass Error(Exception):\n    \"\"\"\n    Domain-specific exception for application errors.\n    Carries a message string describing the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass BinaryString:\n    \"\"\"\n    Represents an input string validated to contain only '0's and '1's.\n    Stores the string value and its computed length.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass Substring:\n    \"\"\"\n    Represents a contiguous non-empty substring of a BinaryString.\n    Computes and stores its start/end indices, value, and counts of '0's and '1's.\n    \"\"\"\n    def __init__(self, startIndex: int, endIndex: int, value: str):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.value = value\n        self.zeros = value.count('0')\n        self.ones = value.count('1')\n\nclass Result:\n    \"\"\"\n    Encapsulates the final computation result.\n    Holds the maximum difference (zeros - ones) found.\n    \"\"\"\n    def __init__(self, maxDifference: int):\n        self.maxDifference = maxDifference"}
{"task_id": "Mbpp/126", "solution": "def compute_divisors(n: int) -> set:\n    \"\"\"Computes all positive divisors for a given integer n.\"\"\"\n    divs = set()\n    for i in range(1, n + 1):\n        if n % i == 0:\n            divs.add(i)\n    return divs\ndef compute_common_divisors(a: int, b: int) -> set:\n    \"\"\"Computes the set of common positive divisors for two integers.\"\"\"\n    divisors_a = compute_divisors(a)\n    divisors_b = compute_divisors(b)\n    return divisors_a.intersection(divisors_b)\ndef _sum_elements_of_set(s: set) -> int:\n    \"\"\"Helper to sum the integer elements of a set.\"\"\"\n    total = 0\n    for x in s:\n        total += x\n    return total\ndef sum(a: int, b: int) -> int:\n    \"\"\"Computes the sum of common positive divisors for two integers.\"\"\"\n    common_divs = compute_common_divisors(a, b)\n    return _sum_elements_of_set(common_divs)"}
