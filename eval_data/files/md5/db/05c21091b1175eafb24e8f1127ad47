{"task_id": "Mbpp/109", "solution": "from dataclasses import dataclass\ndef _rotate_string_once(s: str) -> str:\n    \"\"\"Rotates a string once by moving the last character to the front.\"\"\"\n    if not s:\n        return ''\n    return s[-1] + s[:-1]\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Counts rotations of a binary string whose rotated representation is odd.\n    This implementation omits validation checks as per critical requirements.\n    \"\"\"\n    # Initialize the result accumulator.\n    result = OddCountResult(count=0)\n\n    # If no rotations are specified, return 0 immediately.\n    if rotations == 0:\n        return result.count\n\n    current_value = binary_string\n\n    # Iterate through the specified number of rotations.\n    for i in range(rotations):\n        # Determine if the current string representation is odd.\n        # An empty string is not considered odd.\n        is_current_odd = (current_value[-1] == '1') if current_value else False\n\n        # If odd, increment the count.\n        if is_current_odd:\n            result.count += 1\n\n        # Prepare the string for the next rotation.\n        current_value = _rotate_string_once(current_value)\n\n    return result.count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Computes the intersection of elements across an outer list of inner lists.\n    Returns a set containing elements common to all inner lists, each exactly once.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize with the elements of the first inner list, ensuring uniqueness.\n    common_elements = set(nested_lists[0])\n\n    # Intersect with subsequent inner lists to find common elements.\n    for inner_list in nested_lists[1:]:\n        common_elements.intersection_update(set(inner_list))\n        # If common_elements becomes empty, no further elements can be common.\n        if not common_elements:\n            break\n\n    return common_elements"}
{"task_id": "Mbpp/111", "solution": "from typing import List\ndef _intersection_of_lists(nested_lists: List[List]) -> List:\n    \"\"\"\n    Computes the intersection of elements present in every inner list.\n    Elements are expected to be hashable for set operations.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize with the set of elements from the first inner list.\n    common_elements = set(nested_lists[0])\n\n    # Intersect with subsequent lists, stopping if the common set becomes empty.\n    for inner_list in nested_lists[1:]:\n        common_elements.intersection_update(inner_list)\n        if not common_elements:\n            break\n            \n    return list(common_elements)\ndef common_in_nested_lists(nested_lists: List[List]) -> List:\n    \"\"\"\n    Finds unique common elements across all inner lists in a nested list.\n    Elements must be hashable for efficient set-based intersection.\n    \"\"\"\n    # Input validation (e.g., isinstance checks, raising TypeError) is omitted\n    # as per critical requirements, trusting the caller's input.\n    return _intersection_of_lists(nested_lists)"}
