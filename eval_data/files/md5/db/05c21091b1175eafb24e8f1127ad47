{"task_id": "Mbpp/301", "solution": "from typing import Any, Dict\ndef _max_child_depth(d: Dict[Any, Any]) -> int:\n    \"\"\"Recursively computes the maximum additional depth from child dictionaries.\n    Returns 0 if no child dictionaries, otherwise 1 + the maximum depth found among them.\n    \"\"\"\n    max_current_child_depth = 0\n    for value in d.values():\n        if isinstance(value, dict):\n            max_current_child_depth = max(max_current_child_depth, 1 + _max_child_depth(value))\n    return max_current_child_depth\ndef dict_depth(d: Dict[Any, Any]) -> int:\n    \"\"\"Computes the maximum nesting depth of dictionaries.\n    The outermost dictionary counts as depth 1; non-dictionary values are ignored.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    # The top-level dictionary itself contributes 1 to the depth.\n    # _max_child_depth calculates the additional depth from its dictionary-valued children.\n    return 1 + _max_child_depth(d)"}
{"task_id": "Mbpp/301", "solution": "from typing import Any, Dict\ndef _compute_depth(value: Any, current_depth: int) -> int:\n    \"\"\"Recursively computes the maximum depth for a given value, counting only exact dict types.\"\"\"\n    max_sub_depth = current_depth\n\n    if type(value) is dict:\n        for val in value.values():\n            sub_depth = _compute_depth(val, current_depth + 1)\n            max_sub_depth = max(max_sub_depth, sub_depth)\n\n    return max_sub_depth\ndef dict_depth(input_dict: dict) -> int:\n    \"\"\"Computes the maximum nesting depth of dictionaries in input_dict. Top-level dict is depth 1; only exact type `dict` values increase depth.\"\"\"\n    return _compute_depth(input_dict, 1)"}
{"task_id": "Mbpp/299", "solution": "class TupleRecord:\n    \"\"\"Represents an input record with a name (string) and a numeric value.\"\"\"\n    def __init__(self, name: str, value: float):\n        self.name = name\n        self.value = value\n\n    def __repr__(self):\n        return f\"TupleRecord(name='{self.name}', value={self.value})\"\nclass AggregatorResult:\n    \"\"\"Data container for the final output: selected name and its aggregate sum.\"\"\"\n    def __init__(self, name: str, aggregate_sum: float):\n        self.name = name\n        self.aggregate_sum = aggregate_sum\n\n    def __repr__(self):\n        return f\"AggregatorResult(name='{self.name}', aggregate_sum={self.aggregate_sum})\"\nclass AggregatorService:\n    \"\"\"Encapsulates validation, aggregation, and max-selection logic.\"\"\"\n\n    def max_aggregate(self, records: list) -> AggregatorResult:\n        \"\"\"Validates, aggregates per unique name, and returns the AggregatorResult.\n        Returns None for empty input as per policy.\"\"\"\n        # Per critical requirement: \"Do NOT add isinstance() checks... Trust the caller's inputs\".\n        processed_records, encounter_order = self.validate_input(records)\n        \n        if not processed_records:\n            return None # Empty input policy.\n\n        aggregates = self.aggregate(processed_records)\n        result = self.find_max(aggregates, encounter_order)\n        return result\n\n    def validate_input(self, items: list) -> tuple[list, list]:\n        \"\"\"Canonicalizes input items into TupleRecord instances and captures encounter order.\n        Assumes items are 2-element sequences like (name, value) based on critical constraints.\"\"\"\n        canonical_records = []\n        encountered_names_order = []\n        seen_names = set()\n\n        for item in items:\n            # Per critical requirement: \"Trust the caller's inputs\".\n            # Assume item is a 2-element sequence; no isinstance checks or ValueError raised.\n            name = item[0]\n            value = item[1]\n            canonical_records.append(TupleRecord(name, float(value)))\n\n            if name not in seen_names:\n                seen_names.add(name)\n                encountered_names_order.append(name)\n        \n        return canonical_records, encountered_names_order\n\n    def aggregate(self, records: list) -> dict:\n        \"\"\"Aggregates numeric values by exact string name.\"\"\"\n        name_sums = {}\n        for record in records:\n            name_sums[record.name] = name_sums.get(record.name, 0.0) + record.value\n        return name_sums\n\n    def find_max(self, aggregates: dict, encounter_order: list) -> AggregatorResult:\n        \"\"\"Finds the name with the highest aggregate sum, using first-encountered for tie-breaking.\n        Returns None if no aggregates are provided.\"\"\"\n        if not aggregates:\n            return None\n\n        max_sum = float('-inf')\n        max_name = None\n\n        # Iterate through encounter_order to ensure tie-breaking by first appearance.\n        for name in encounter_order:\n            current_sum = aggregates.get(name)\n            if current_sum is not None: # Name must be in aggregates as it came from there.\n                if current_sum > max_sum:\n                    max_sum = current_sum\n                    max_name = name\n                # If current_sum == max_sum, the existing max_name (first encountered) is kept.\n\n        return AggregatorResult(max_name, max_sum)\ndef max_aggregate(list_of_tuples) -> tuple or None:\n    \"\"\"\n    Public API to find the name with the highest aggregated sum from a list of tuples.\n    Returns (name, aggregate_sum) or None for empty input per default policy.\n    \"\"\"\n    service = AggregatorService()\n    \n    # Delegates to AggregatorService's max_aggregate, which handles empty input and returns results.\n    result = service.max_aggregate(list_of_tuples)\n    \n    if result is None:\n        return None\n    return (result.name, result.aggregate_sum)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\nclass Word:\n    \"\"\"Represents a parsed token with its original trimmed text and stream position.\"\"\"\n    def __init__(self, raw_token: str, position_in_stream: int) -> None:\n        \"\"\"Initializes a Word, trimming outer whitespace from the raw token.\"\"\"\n        self.text: str = raw_token.strip()\n        self.trimmed: str = self.text\n        self.position_in_stream: int = position_in_stream\n\n    def startsWithP(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' or 'P' (case-insensitive).\"\"\"\n        return bool(self.trimmed and self.trimmed[0].lower() == 'p')\nclass ResultTuple:\n    \"\"\"Encapsulates the two result words before returning as a tuple.\"\"\"\n    def __init__(self, first: str, second: str) -> None:\n        \"\"\"Initializes with the first and second matched words.\"\"\"\n        self.first: str = first\n        self.second: str = second\n\n    def as_tuple(self) -> Tuple[str, str]:\n        \"\"\"Returns the stored words as a tuple.\"\"\"\n        return (self.first, self.second)\nclass StartWithPFunction:\n    \"\"\"Encapsulates the algorithm to find words starting with 'p' or 'P'.\"\"\"\n    _max_matches: int = 2\n    _matches: List[Word]\n\n    def _parse_words(self, input_list: List[str]) -> List[Word]:\n        \"\"\"Parses the input list into a flat list of Word objects, assigning stream positions.\"\"\"\n        all_words: List[Word] = []\n        stream_position: int = 0\n        for element_string in input_list:\n            for raw_token in element_string.split():\n                word = Word(raw_token, stream_position)\n                all_words.append(word)\n                stream_position += 1\n        return all_words\n\n    def _is_p_word(self, token: str) -> bool:\n        \"\"\"Determines if a given token starts with 'p' or 'P', case-insensitive.\"\"\"\n        return bool(token and token[0].lower() == 'p')\n\n    def start_withp(self, input_list: List[str]) -> Tuple[str, str]:\n        \"\"\"Processes the input list to find the first two words starting with 'p' or 'P'.\"\"\"\n        self._matches = []\n        all_parsed_words = self._parse_words(input_list)\n\n        for word in all_parsed_words:\n            if self._is_p_word(word.trimmed):\n                self._matches.append(word)\n                if len(self._matches) == self._max_matches:\n                    break\n        \n        # CRITICAL REQUIREMENT: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n        # This overrides the design's explicit instruction to raise ValueError for fewer than two matches.\n        # It's assumed valid input, so accessing _matches[0] and _matches[1] will succeed.\n        result = ResultTuple(self._matches[0].text, self._matches[1].text)\n        return result.as_tuple()\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Finds the first two words starting with 'p' or 'P' from a list of strings.\n    Each string in the input list is treated as whitespace-separated words.\n    \"\"\"\n    processor = StartWithPFunction()\n    return processor.start_withp(input_list)"}
{"task_id": "Mbpp/300", "solution": "import math\nclass ErrorHandling:\n    \"\"\"Centralizes raising domain exceptions for consistency.\"\"\"\n    def raise_type_error(self, msg: str) -> None:\n        \"\"\"Raises a TypeError with the given message.\"\"\"\n        raise TypeError(msg)\n\n    def raise_value_error(self, msg: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(msg)\nclass Parameter:\n    \"\"\"Holds the raw input value 'n'.\"\"\"\n    def __init__(self, value) -> None:\n        self.value = value\nclass BinomialCalculator:\n    \"\"\"Provides integer-safe combinatorial computations.\"\"\"\n    def binomial(self, n: int, k: int) -> int:\n        \"\"\"Computes n choose k using math.comb.\"\"\"\n        return math.comb(n, k)\n\n    def central_binomial(self, n: int) -> int:\n        \"\"\"Computes C(2n, n) using math.comb(2*n, n).\"\"\"\n        return math.comb(2 * n, n)\nclass Result:\n    \"\"\"Wraps the numeric result of the computation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass CountBinarySeq:\n    \"\"\"Encapsulates one computation workflow for binary sequences.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n        self._parameter = Parameter(n)\n        self._calc = BinomialCalculator()\n        self._error_handling = ErrorHandling()\n\n    def validate_input(self) -> None:\n        \"\"\"Validates input 'n', raising TypeError or ValueError.\"\"\"\n        if not isinstance(self.n, int):\n            self._error_handling.raise_type_error(\"Input 'n' must be an integer.\")\n        if self.n < 0:\n            self._error_handling.raise_value_error(\"Input 'n' must be a non-negative integer.\")\n\n    def compute(self) -> int:\n        \"\"\"Computes C(2n, n) as an exact integer.\"\"\"\n        result_value = self._calc.central_binomial(self.n)\n        _ = Result(result_value)\n        return result_value\ndef count_binary_seq(n):\n    \"\"\"Public API: validates input and computes the count.\"\"\"\n    cb = CountBinarySeq(n)\n    cb.validate_input()\n    value = cb.compute()\n    return value"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\ndef split_into_words(s: str) -> List[str]:\n    \"\"\"Tokenizes a string by whitespace into a list of words.\"\"\"\n    return s.split()\ndef starts_with_p(word: str) -> bool:\n    \"\"\"Checks if a word starts with 'p' or 'P' (case-insensitive).\"\"\"\n    return bool(word and word[0].lower() == 'p')\ndef select_first_two(matches: List[str]) -> Tuple[str, str]:\n    \"\"\"Returns the first two elements from a list of matches.\n    Raises ValueError if fewer than two matches are present.\n    \"\"\"\n    if len(matches) < 2:\n        raise ValueError(\"Fewer than two matches found.\")\n    return (matches[0], matches[1])\ndef start_withp(strings: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Scans strings for words starting with 'p' (case-insensitive), returning the first two.\n    Raises ValueError if fewer than two matching words are found.\n    \"\"\"\n    found_matches = []\n    for s in strings:\n        words = split_into_words(s)\n        for word in words:\n            if starts_with_p(word):\n                found_matches.append(word)\n                if len(found_matches) == 2:\n                    return select_first_two(found_matches)\n    \n    # If the loop completes without finding two matches, select_first_two will raise ValueError.\n    return select_first_two(found_matches)"}
{"task_id": "Mbpp/306", "solution": "from typing import List\nfrom typing import List\nfrom .validator import Validator\nfrom .models import Error\nclass Error(Exception):\n    \"\"\"Structured error/exception type for validation or runtime errors.\"\"\"\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\n        super().__init__(f\"{self.type}: {self.message}\")\nclass Validator:\n    \"\"\"Enforces index rule 0 <= i < k < n.\"\"\"\n    @staticmethod\n    def validate_indices(i: int, k: int, n: int) -> bool:\n        \"\"\"Returns True iff 0 <= i < k < n, else False.\"\"\"\n        return 0 <= i < k < n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence.\n    Forms a subsequence from zero or more elements in arr[0..i] followed by arr[k].\n    \"\"\"\n    if not Validator.validate_indices(i, k, n):\n        raise Error(type='IndexValidationError', message='invalid indices: require 0 <= i < k < n')\n\n    # dp_prefix_sum[j] stores the maximum sum of an increasing subsequence\n    # ending at arr[j] within arr[0...i].\n    dp_prefix_sum = [0] * (i + 1)\n\n    for current_idx in range(i + 1):\n        # Initialize with the element itself (subsequence of just arr[current_idx])\n        dp_prefix_sum[current_idx] = arr[current_idx]\n\n        # Find the max sum from previous elements that are smaller and at earlier indices\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp_prefix_sum[current_idx] = max(\n                    dp_prefix_sum[current_idx],\n                    dp_prefix_sum[prev_idx] + arr[current_idx]\n                )\n\n    best_prefix_sum = 0\n    # Iterate through the computed prefix sums to find the maximum sum\n    # for a prefix subsequence whose last element is less than arr[k].\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            best_prefix_sum = max(best_prefix_sum, dp_prefix_sum[j])\n\n    # The result is the best found prefix sum (or 0 if no eligible prefix) plus arr[k].\n    return best_prefix_sum + arr[k]"}
