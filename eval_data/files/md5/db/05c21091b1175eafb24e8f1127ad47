{"task_id": "Mbpp/282", "solution": "from typing import List, Union\nfrom src.errors import LengthMismatchError\nclass SubListFunction:\n    \"\"\"Implements the element-wise subtraction logic for two lists.\"\"\"\n\n    def sub_list(self, list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"\n        Performs element-wise subtraction of two lists.\n        Validates inputs and returns a new list of results.\n        \"\"\"\n        if not isinstance(list1, list) or not isinstance(list2, list):\n            raise TypeError(\"Both inputs must be lists.\")\n\n        self.validate_lengths(list1, list2)\n        return self.compute_elementwise(list1, list2)\n\n    def validate_lengths(self, list1: List[Union[int, float]], list2: List[Union[int, float]]) -> None:\n        \"\"\"\n        Validates that both input lists have the same length.\n        Raises LengthMismatchError if lengths differ.\n        \"\"\"\n        if len(list1) != len(list2):\n            raise LengthMismatchError(f\"Length mismatch: len(list1)={len(list1)} != len(list2)={len(list2)}\")\n\n    def compute_elementwise(self, list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"\n        Computes the element-wise subtraction and validates element types.\n        Returns a newly allocated list with results.\n        \"\"\"\n        result = []\n        for i in range(len(list1)):\n            val1 = list1[i]\n            val2 = list2[i]\n\n            if not isinstance(val1, (int, float)):\n                raise TypeError(f\"List1 element at index {i} is not numeric: {val1} (type: {type(val1).__name__})\")\n            if not isinstance(val2, (int, float)):\n                raise TypeError(f\"List2 element at index {i} is not numeric: {val2} (type: {type(val2).__name__})\")\n\n            result.append(val1 - val2)\n        return result\ndef sub_list(list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Module-level entry point for element-wise list subtraction.\n    Delegates to SubListFunction for core logic.\n    \"\"\"\n    return SubListFunction().sub_list(list1, list2)"}
