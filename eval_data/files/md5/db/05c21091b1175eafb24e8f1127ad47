{"task_id": "Mbpp/283", "solution": "from typing import List, Dict\nclass IntegerInput:\n    \"\"\"Stores an integer and provides its base-10 digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def get_digits(self) -> List[int]:\n        \"\"\"Parses and returns the base-10 digits of the stored integer.\"\"\"\n        # Extracts digits from the absolute value, as recommended by design notes.\n        s_value = str(abs(self._value))\n        return [int(d) for d in s_value]\nclass DigitFrequency:\n    \"\"\"Represents a decimal digit and its frequency count.\"\"\"\n    def __init__(self, digit: int) -> None:\n        self._digit = digit\n        self._frequency = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the frequency count for the digit.\"\"\"\n        self._frequency += 1\n\n    @property\n    def frequency(self) -> int:\n        \"\"\"Returns the current frequency count.\"\"\"\n        return self._frequency\nclass ValidationResult:\n    \"\"\"Wraps the boolean outcome of the validation process.\"\"\"\n    def __init__(self, is_valid: bool) -> None:\n        self.is_valid = is_valid\nclass Validator:\n    \"\"\"Orchestrates the digit frequency validation process.\"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"Validates if for every present digit d, frequency(d) <= d.\"\"\"\n        integer_input = IntegerInput(n)\n        digits = integer_input.get_digits()\n\n        digit_frequencies: Dict[int, DigitFrequency] = {}\n        for digit_value in digits:\n            if digit_value not in digit_frequencies:\n                digit_frequencies[digit_value] = DigitFrequency(digit_value)\n            digit_frequencies[digit_value].increment()\n\n        is_all_valid = True\n        for digit_value, df_obj in digit_frequencies.items():\n            if not (df_obj.frequency <= digit_value):\n                is_all_valid = False\n                break\n        \n        validation_result = ValidationResult(is_all_valid)\n        return validation_result.is_valid\ndef validate(n: int) -> bool:\n    \"\"\"Public API: Checks if each digit's frequency in n is less than or equal to the digit itself.\"\"\"\n    return Validator().validate(n)"}
{"task_id": "Mbpp/285", "solution": "class TextInput:\n    def __init__(self, value: str) -> None:\n        \"\"\"Initializes TextInput with a string value and its length.\"\"\"\n        self.value = value\n        self.length = len(value)\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation of the TextInput object.\"\"\"\n        return f\"TextInput(value='{self.value}', length={self.length})\"\nclass MatchOccurrence:\n    def __init__(self, matched: bool, substring: str, start_index: int) -> None:\n        \"\"\"Initializes MatchOccurrence with match details.\"\"\"\n        self.matched = matched\n        self.substring = substring\n        self.start_index = start_index\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation of the MatchOccurrence object.\"\"\"\n        return (\n            f\"MatchOccurrence(matched={self.matched}, \"\n            f\"substring='{self.substring}', start_index={self.start_index})\"\n        )\nclass PatternMatcher:\n    def text_match_two_three(self, text: str) -> bool:\n        \"\"\"Delegates to internal search and returns True if a match is found.\"\"\"\n        occurrence = self._search_for_patterns(text)\n        return occurrence is not None and occurrence.matched\n\n    def _search_for_patterns(self, text: str) -> MatchOccurrence | None:\n        \"\"\"Searches for 'abb' or 'abbb' in the given text using string methods.\"\"\"\n        # Check for 'abbb' first to correctly identify the longest pattern.\n        if \"abbb\" in text:\n            idx = text.find(\"abbb\")\n            return MatchOccurrence(matched=True, substring=\"abbb\", start_index=idx)\n        # If 'abbb' is not found, check for 'abb'.\n        elif \"abb\" in text:\n            idx = text.find(\"abb\")\n            return MatchOccurrence(matched=True, substring=\"abb\", start_index=idx)\n        \n        return None\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"Public API entrypoint; delegates to PatternMatcher and returns boolean.\"\"\"\n    # As per design, TextInput is constructed, then PatternMatcher is used.\n    text_input = TextInput(text)\n    matcher = PatternMatcher()\n    return matcher.text_match_two_three(text_input.value)"}
{"task_id": "Mbpp/290", "solution": "def max_length(lists):\n    \"\"\"Return a tuple (length, lst) where lst is the first sublist of 'lists' with maximal length.\n    It performs a single pass to find the maximal sublist length and the first maximal sublist.\n    \"\"\"\n    if not lists:\n        return (0, [])\n\n    max_len = 0\n    max_list = []\n\n    for sublist in lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = sublist\n\n    return (max_len, max_list)"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Computes the largest sum of any contiguous subarray in the array formed by repeating arr k times.\n    This implementation avoids materializing the k-times repeated array for efficiency.\n    \"\"\"\n\n    def _kadane_linear(elements):\n        \"\"\"\n        Calculates the maximum contiguous subarray sum for a given list of integers.\n        Handles cases where all elements are negative by returning the largest single element.\n        \"\"\"\n        if not elements:\n            return 0  # Sum of an empty subarray is 0.\n        \n        max_so_far = elements[0]\n        current_max = elements[0]\n\n        for x in elements[1:]:\n            current_max = max(x, current_max + x)\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # If k is 1, the problem is a standard Kadane's algorithm on the original array.\n    if k == 1:\n        return _kadane_linear(arr)\n\n    total_sum = sum(arr)\n    \n    # Calculate prefix sums to find the maximum prefix sum, allowing for an empty prefix (sum 0).\n    max_prefix_sum = 0\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n    # Calculate suffix sums to find the maximum suffix sum, allowing for an empty suffix (sum 0).\n    max_suffix_sum = 0\n    current_suffix_sum = 0\n    for x in reversed(arr):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    # Calculate the maximum sum for an array concatenated twice (arr + arr).\n    # This covers subarrays fully within one block or crossing one boundary.\n    max_two_concat_sum = _kadane_linear(arr + arr)\n\n    # The overall maximum sum starts with the best sum found in up to two blocks.\n    max_ans = max_two_concat_sum\n\n    # If the total sum of the original array is positive, we can potentially gain\n    # by adding (k-2) full copies of the array in the middle to a spanning subarray.\n    if total_sum > 0:\n        # This candidate sum comes from a maximum suffix of the first array,\n        # plus (k-2) full array sums, plus a maximum prefix of the last array.\n        max_ans = max(max_ans, max_suffix_sum + (k - 2) * total_sum + max_prefix_sum)\n\n    return max_ans"}
