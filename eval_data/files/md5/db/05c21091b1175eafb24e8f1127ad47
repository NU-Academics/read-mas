{"task_id": "Mbpp/145", "solution": "from typing import Sequence as TypingSequence, Iterator\nclass Sequence:\n    \"\"\"Lightweight wrapper for a Python sequence of numeric values. Stores elements as floats in a tuple.\"\"\"\n    def __init__(self, elements: TypingSequence[float]) -> None:\n        self.elements: tuple[float] = tuple(float(e) for e in elements)\n\n    def __iter__(self) -> Iterator[float]:\n        \"\"\"Allows iteration over the stored numeric elements.\"\"\"\n        return iter(self.elements)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self.elements)\n\n    def to_list(self) -> list[float]:\n        \"\"\"Returns a list representation of the sequence elements.\"\"\"\n        return list(self.elements)\nclass MaxAbsDiffFunction:\n    \"\"\"Encapsulates the algorithm to compute maximum absolute difference.\"\"\"\n    def compute(self, seq: Sequence) -> float:\n        \"\"\"Computes max(|a - b|) for all element pairs in the sequence and returns the numeric result.\"\"\"\n        max_difference = 0.0\n        elements = seq.to_list()\n        n = len(elements)\n\n        if n < 2:\n            return max_difference\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                current_diff = abs(elements[i] - elements[j])\n                max_difference = max(max_difference, current_diff)\n        \n        result_obj = Result(max_difference)\n        return result_obj.max_difference\nclass Result:\n    \"\"\"Container for computed maximum difference.\"\"\"\n    def __init__(self, max_difference: float) -> None:\n        self.max_difference: float = max_difference\ndef max_Abs_Diff(seq: 'TypingSequence[float]') -> float:\n    \"\"\"\n    Entry function required by FR1.\n    Delegates to MaxAbsDiffFunction and returns the numeric result.\n    \"\"\"\n    wrapped_seq = Sequence(seq)\n    calculator = MaxAbsDiffFunction()\n    return calculator.compute(wrapped_seq)"}
{"task_id": "Mbpp/160", "solution": "class ExtendedEuclideanResult:\n    \"\"\"Holds results from the extended Euclidean algorithm: gcd (g) and Bezout coefficients (x0, y0).\"\"\"\n    def __init__(self, g: int, x0: int, y0: int):\n        self.g = g\n        self.x0 = x0\n        self.y0 = y0\ndef extended_euclidean(a: int, b: int) -> ExtendedEuclideanResult:\n    \"\"\"Computes g = gcd(a, b) and Bezout coefficients x0, y0 such that a*x0 + b*y0 == g.\"\"\"\n    x_old, x_curr = 1, 0\n    y_old, y_curr = 0, 1\n    r_old, r_curr = a, b\n\n    while r_curr != 0:\n        q = r_old // r_curr\n        r_old, r_curr = r_curr, r_old - q * r_curr\n        x_old, x_curr = x_curr, x_old - q * x_curr\n        y_old, y_curr = y_curr, y_old - q * y_curr\n    \n    # Ensure g is always positive, adjusting x0 and y0 if necessary.\n    g = r_old\n    x0 = x_old\n    y0 = y_old\n    if g < 0:\n        g = -g\n        x0 = -x0\n        y0 = -y0\n        \n    return ExtendedEuclideanResult(g, x0, y0)\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Return tuple (x, y) of integers such that a*x + b*y == n, or None if no solution exists.\"\"\"\n    # Handle degenerate case: a == 0 and b == 0\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Compute gcd and Bezout coefficients using the extended Euclidean algorithm\n    ee_result = extended_euclidean(a, b)\n    g, x_g, y_g = ee_result.g, ee_result.x0, ee_result.y0\n\n    # If n is not divisible by g, no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Scale Bezout coefficients to find a particular solution (x_p, y_p)\n    scale = n // g\n    x_p = x_g * scale\n    y_p = y_g * scale\n\n    # Normalize the solution to match expected example (2,1) by finding canonical x in [0, abs(b/g)-1]\n    # This also handles cases where a or b is zero correctly by not applying a shift.\n    if a == 0: # Equation is b*y = n. x can be any integer, commonly 0.\n        return (0, y_p)\n    if b == 0: # Equation is a*x = n. y can be any integer, commonly 0.\n        return (x_p, 0)\n\n    # For a != 0 and b != 0, normalize x to be in [0, abs(b/g)-1]\n    # The general solution is (x_p + k * (b/g), y_p - k * (a/g)).\n    div_b_g = b // g\n    div_a_g = a // g\n    \n    x_shifted = x_p % div_b_g\n    # Python's % operator behaves differently for negative numbers.\n    # Ensure x_final is in [0, abs(div_b_g)-1] range when div_b_g is non-zero.\n    x_final = (x_shifted + abs(div_b_g)) % abs(div_b_g)\n\n    # Calculate k based on the normalized x_final\n    k = (x_final - x_p) // div_b_g\n    \n    # Compute y_final using the same k\n    y_final = y_p - k * div_a_g\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Finds integer solutions (x, y) for the Diophantine equation a*x + b*y = n.\n    Returns (x, y) or None if no integer solution exists, ensuring deterministic results.\n    \"\"\"\n\n    # Nested helper for extended Euclidean algorithm for abs_a*x0 + abs_b*y0 = gcd(|a|, |b|).\n    def _extended_gcd(num1, num2):\n        s_prev, s_curr = 1, 0\n        t_prev, t_curr = 0, 1\n        r_prev, r_curr = num1, num2\n\n        while r_curr != 0:\n            quotient = r_prev // r_curr\n            r_prev, r_curr = r_curr, r_prev - quotient * r_curr\n            s_prev, s_curr = s_curr, s_prev - quotient * s_curr\n            t_prev, t_curr = t_curr, t_prev - quotient * t_curr\n        return r_prev, s_prev, t_prev # Returns (gcd, x0, y0)\n\n    # Handle edge cases where coefficients are zero (BR-06).\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0: # b is non-zero\n        return (0, n // b) if n % b == 0 else None\n    elif b == 0: # a is non-zero\n        return (n // a, 0) if n % a == 0 else None\n\n    # Both a and b are non-zero; use extended Euclidean algorithm.\n    # Find g = gcd(|a|, |b|) and x_abs, y_abs such that |a|*x_abs + |b|*y_abs = g.\n    g, x_abs, y_abs = _extended_gcd(abs(a), abs(b))\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Adjust signs of x_abs, y_abs based on original a, b for the equation a*x + b*y = g.\n    x_base = x_abs * (1 if a > 0 else -1)\n    y_base = y_abs * (1 if b > 0 else -1)\n\n    # Scale the base solution by k = n // g to get a particular solution for a*x + b*y = n.\n    k = n // g\n    x_particular = x_base * k\n    y_particular = y_base * k\n\n    # Canonicalize the solution to ensure determinism (BR-07, FR-5).\n    # We find the smallest non-negative x by taking x_particular modulo (abs(b) // g).\n    mod_val = abs(b // g)\n    x_final = x_particular % mod_val\n    \n    # Recalculate y based on the chosen x to satisfy a*x_final + b*y_final = n (BR-05, FR-4).\n    y_final = (n - a * x_final) // b\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/161", "solution": "def _element_in_to_remove(element: object, to_remove: list) -> bool:\n    \"\"\"Return True if element matches any item in to_remove using Python's '==' operator.\"\"\"\n    for item in to_remove:\n        if element == item:\n            return True\n    return False\ndef remove_elements(source: list, to_remove: list) -> list:\n    \"\"\"\n    Returns a new list with elements from source not present in to_remove.\n    Preserves order and does not modify input lists.\n    \"\"\"\n    result = []\n    for element in source:\n        if not _element_in_to_remove(element, to_remove):\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"Compute the sum of terms t_i = (n - 2*i) for i = 0..floor(n/2) and return as int.\n\n    Precondition: n is an integer (per FR2). The SRS leaves handling of non-integer or negative n unspecified; the implementation treats the precondition as required by the caller.\n    Returns: int\n    \"\"\"\n    total_sum = 0\n    # The summation index 'i' ranges from 0 up to and including floor(n/2).\n    # In Python's range function, the end is exclusive, so we add 1.\n    for i in range(0, (n // 2) + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, to_remove):\n    \"\"\"Removes all occurrences of elements from 'source' that are present in 'to_remove', preserving order.\n    Handles empty inputs and uses standard equality for comparisons as per design specifications.\n    \"\"\"\n    if not source:\n        return []\n\n    if not to_remove:\n        return list(source)\n\n    result = []\n    for item in source:\n        if item not in to_remove:\n            result.append(item)\n\n    return result"}
{"task_id": "Mbpp/165", "solution": "from typing import Optional\nclass StringInput:\n    \"\"\"Represents the input string and provides normalization and length accessors.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def toLower(self) -> 'StringInput':\n        \"\"\"Returns a new StringInput with the value converted to lowercase.\"\"\"\n        return StringInput(self.value.lower())\nclass Character:\n    \"\"\"Wraps a single character and its 1-based position, providing alphabeticity and alphabet position mapping.\"\"\"\n    def __init__(self, value: str, positionInString: int):\n        self.value = value\n        self.positionInString = positionInString\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Checks if the character is an ASCII letter 'a' through 'z'.\"\"\"\n        return 'a' <= self.value <= 'z'\n\n    def alphabetPosition(self) -> Optional[int]:\n        \"\"\"Maps an alphabetic character to its 1-based alphabet position.\"\"\"\n        if self.isAlphabetic():\n            return ord(self.value) - ord('a') + 1\n        return None\nclass PositionMatcher:\n    \"\"\"Iterates through characters of a StringInput, applies matching rule, and produces the count.\"\"\"\n    def countMatches(self, s: StringInput) -> int:\n        \"\"\"Counts characters where string position equals alphabet position.\"\"\"\n        match_count = 0\n        for i in range(s.length()):\n            char_value = s.value[i]\n            string_1_based_pos = i + 1\n            char_obj = Character(value=char_value, positionInString=string_1_based_pos)\n            if self.matches(char_obj, string_1_based_pos):\n                match_count += 1\n        return match_count\n\n    def matches(self, c: Character, pos: int) -> bool:\n        \"\"\"Determines if a character's alphabet position matches a given string position.\"\"\"\n        if c.isAlphabetic():\n            return c.alphabetPosition() == pos\n        return False\ndef count_char_position(s: str) -> int:\n    \"\"\"Counts characters whose 1-based string position equals their 1-based alphabet position.\"\"\"\n    normalized_input = StringInput(s).toLower()\n    matcher = PositionMatcher()\n    match_count = matcher.countMatches(normalized_input)\n    return match_count"}
{"task_id": "Mbpp/162", "solution": "import math\nclass ValidationError(Exception):\n    \"\"\"Exception indicating input validation failure.\"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\nclass InputParameter:\n    \"\"\"Encapsulates input n and validation helpers.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated 'n' is non-negative.\"\"\"\n        return self.n >= 0\nclass Result:\n    \"\"\"Container for the aggregated sum.\"\"\"\n    def __init__(self, sum: int) -> None:\n        self.sum = sum\nclass SumSeries:\n    \"\"\"Stateless computation class for the series sum.\"\"\"\n    def compute(self, n: int) -> Result:\n        \"\"\"Computes the sum of terms (n - 2*i) for i = 0..floor(n/2) inclusive.\"\"\"\n        current_sum = 0\n        max_i = math.floor(n / 2)\n        for i in range(max_i + 1):\n            term_value = n - 2 * i\n            current_sum += term_value\n        return Result(current_sum)\ndef sum_series(n) -> int:\n    \"\"\"\n    Public API function to compute the sum of the series (n - 2*i).\n    Validates input and delegates computation.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    input_param = InputParameter(n)\n    if not input_param.is_non_negative():\n        raise ValidationError(\n            code=\"INVALID_N_NEGATIVE\",\n            message=\"Input 'n' must be non-negative.\"\n        )\n\n    calculator = SumSeries()\n    result = calculator.compute(n)\n    return result.sum"}
{"task_id": "Mbpp/165", "solution": "class InputString:\n    \"\"\"Represents the input string and provides 1-based indexing.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def char_at(self, index1based: int) -> str:\n        \"\"\"Returns the character at the specified 1-based index.\"\"\"\n        return self.value[index1based - 1]\nclass Character:\n    \"\"\"Value object capturing a character, its 1-based position, and alphabet position.\"\"\"\n    def __init__(self, value: str, positionInString: int, alphabetPosition: int | None) -> None:\n        self.value = value\n        self.positionInString = positionInString\n        self.alphabetPosition = alphabetPosition\nclass Result:\n    \"\"\"Accumulates the count of matching characters.\"\"\"\n    def __init__(self) -> None:\n        self.matchingCount = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the matching count.\"\"\"\n        self.matchingCount += 1\n\n    def value(self) -> int:\n        \"\"\"Returns the accumulated matching count.\"\"\"\n        return self.matchingCount\nclass AlphabetMapping:\n    \"\"\"Maps letters a..z/A..Z to numeric positions 1..26; returns None for non-letters.\"\"\"\n    _mapping_table = {chr(i): i - ord('a') + 1 for i in range(ord('a'), ord('z') + 1)}\n\n    def getPosition(self, c: str) -> int | None:\n        \"\"\"Returns the alphabet position (1-26) for a letter, or None for non-letters.\"\"\"\n        normalized_char = c.lower()\n        return self._mapping_table.get(normalized_char, None)\nclass CountCharPositionFunction:\n    \"\"\"Orchestrates the counting logic for characters where alphabet position matches string position.\"\"\"\n    def __init__(self) -> None:\n        self.alphabet_mapping = AlphabetMapping()\n\n    def count_char_position(self, input_str: str) -> int:\n        \"\"\"Calculates the count of characters where alphabet position equals string position.\"\"\"\n        result = Result()\n        input_string_obj = InputString(input_str)\n\n        for i in range(input_string_obj.length):\n            position_in_string_1_based = i + 1\n            char_value = input_string_obj.char_at(position_in_string_1_based)\n\n            alphabet_pos = self.alphabet_mapping.getPosition(char_value)\n\n            # Create Character object as per the design specification.\n            _ = Character(char_value, position_in_string_1_based, alphabet_pos)\n\n            if alphabet_pos is not None and alphabet_pos == position_in_string_1_based:\n                result.increment()\n\n        return result.value()\ndef count_char_position(input: str) -> int:\n    \"\"\"Public API function to count characters where alphabet position matches string position.\"\"\"\n    calculator = CountCharPositionFunction()\n    return calculator.count_char_position(input)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\nclass IntegerList:\n    def __init__(self, elements: List[int]) -> None:\n        \"\"\"Lightweight wrapper for a list of integers.\"\"\"\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\nclass FindEvenPairFunction:\n    def find(self, integer_list: IntegerList) -> int:\n        \"\"\"\n        Entry point for finding even XOR pairs.\n        Returns 0 if the list has fewer than two elements, otherwise delegates to countSameParityPairs.\n        \"\"\"\n        if integer_list.length() < 2:\n            return 0\n        return self.countSameParityPairs(integer_list)\n\n    def countSameParityPairs(self, integer_list: IntegerList) -> int:\n        \"\"\"\n        Counts pairs with same parity using an O(n) algorithm.\n        This leverages that XOR is even iff both numbers have the same parity.\n        \"\"\"\n        evencount = 0\n        oddcount = 0\n        for value in integer_list.elements:\n            if value % 2 == 0:\n                evencount += 1\n            else:\n                oddcount += 1\n\n        evencount_pairs = evencount * (evencount - 1) // 2\n        oddcount_pairs = oddcount * (oddcount - 1) // 2\n\n        return evencount_pairs + oddcount_pairs\ndef find_even_pair(list_of_ints: List[int]) -> int:\n    \"\"\"\n    Public API as per FR1.\n    Assumes list_of_ints is a list of integers; behavior for invalid inputs is unspecified (BR9).\n    \"\"\"\n    integer_list = IntegerList(list_of_ints)\n    impl = FindEvenPairFunction()\n    return impl.find(integer_list)"}
{"task_id": "Mbpp/166", "solution": "def _is_even(n: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return n % 2 == 0\ndef _choose2(n: int) -> int:\n    \"\"\"Calculates n choose 2 combinations (n*(n-1)//2), returning 0 if n < 2.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\ndef count_pairs(values: list[int]) -> int:\n    \"\"\"Counts even and odd numbers, then sums combinations of same-parity groups.\"\"\"\n    even_count = 0\n    odd_count = 0\n    for n in values:\n        if _is_even(n):\n            even_count += 1\n        else:\n            odd_count += 1\n    return _choose2(even_count) + _choose2(odd_count)\ndef find_even_pair(values: list[int]) -> int:\n    \"\"\"\n    Counts unordered pairs (i, j) with i < j whose bitwise XOR is even.\n    Returns 0 for lists with fewer than two elements.\n    \"\"\"\n    if len(values) < 2:\n        return 0\n    return count_pairs(values)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Computes the smallest power of two greater than or equal to a non-negative integer n.\"\"\"\n    if n == 0:\n        return 1\n    # If n is already a power of two, return n.\n    # A positive integer n is a power of two if and only if (n & (n - 1)) == 0.\n    if (n & (n - 1)) == 0:\n        return n\n    # Otherwise, compute the smallest power of two strictly greater than n.\n    # This is achieved by shifting 1 left by the number of bits in n.\n    return 1 << n.bit_length()"}
