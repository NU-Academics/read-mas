{"task_id": "Mbpp/567", "solution": "from dataclasses import dataclass\nfrom typing import Any, List as TypingList\nclass List:\n    \"\"\"A lightweight wrapper around a Python list.\"\"\"\n    def __init__(self, elements: TypingList):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def get(self, index: int) -> Any:\n        \"\"\"Retrieves an element by its index.\"\"\"\n        return self.elements[index]\nclass SortChecker:\n    \"\"\"Encapsulates the algorithm for checking list sortedness.\"\"\"\n    def is_sorted(self, lst: 'List') -> Result:\n        \"\"\"Checks if the given List is sorted in non-decreasing order.\"\"\"\n        n = lst.length()\n\n        if n <= 1:\n            return Result(is_sorted=True)\n\n        for i in range(1, n):\n            a = lst.get(i - 1)\n            b = lst.get(i)\n            if not self._compare(a, b):\n                return Result(is_sorted=False)\n        return Result(is_sorted=True)\n\n    def _compare(self, a: Any, b: Any) -> bool:\n        \"\"\"Compares two elements for non-decreasing order (b >= a).\"\"\"\n        return b >= a\ndef issort_list(lst: TypingList) -> bool:\n    \"\"\"\n    Checks if a list is sorted in non-decreasing order.\n    Delegates the sorting logic to a SortChecker.\n    \"\"\"\n    list_wrapper = List(lst)\n    checker = SortChecker()\n    result = checker.is_sorted(list_wrapper)\n    return result.is_sorted"}
