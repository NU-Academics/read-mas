{"task_id": "Mbpp/455", "solution": "# src/month.py\n\nclass Month:\n    \"\"\"Domain data holder for a month number and its 31-day status.\"\"\"\n    def __init__(self, number: int, has31days: bool):\n        self.number: int = number\n        self.has31days: bool = has31days\n\nclass MonthChecker:\n    \"\"\"Domain service for checking if a month number has 31 days.\"\"\"\n    _MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n\n    def check_monthnumb_number(self, month: int) -> bool:\n        \"\"\"Return True for months 1,3,5,7,8,10,12; return False for 2,4,6,9,11.\n        Expected input is an integer month number in the range 1..12.\n        \"\"\"\n        return month in self._MONTHS_WITH_31_DAYS"}
{"task_id": "Mbpp/454", "solution": "import string\nclass Text:\n    \"\"\"Holds input content and provides helper to obtain raw tokens.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n        self.length = len(content)\n\n    def get_raw_tokens(self) -> list[str]:\n        \"\"\"Splits content by whitespace to get raw tokens.\"\"\"\n        return self.content.split()\nclass Word:\n    \"\"\"Wraps raw token and trimmed token value.\"\"\"\n    def __init__(self, raw_value: str, value: str) -> None:\n        self.raw_value = raw_value\n        self.value = value\ndef tokenize(text: str) -> list[Word]:\n    \"\"\"Tokenizes text into Word instances, trimming punctuation.\"\"\"\n    text_obj = Text(text)\n    raw_tokens = text_obj.get_raw_tokens()\n    \n    word_objects = []\n    for raw_token in raw_tokens:\n        trimmed_value = raw_token.strip(string.punctuation)\n        if trimmed_value:\n            word_objects.append(Word(raw_value=raw_token, value=trimmed_value))\n    return word_objects\ndef word_contains_z(word: Word) -> bool:\n    \"\"\"Checks if a Word's value contains lowercase 'z'.\"\"\"\n    return 'z' in word.value\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Detects if input string contains at least one word with 'z'.\n    Returns True if a match is found, otherwise False.\"\"\"\n    \n    words = tokenize(text)\n    \n    for word in words:\n        if word_contains_z(word):\n            return True\n            \n    return False"}
