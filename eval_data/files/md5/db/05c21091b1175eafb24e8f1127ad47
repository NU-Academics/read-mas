{"task_id": "Mbpp/226", "solution": "from dataclasses import dataclass, field\ndef odd_values_string(input_string: str) -> str:\n    \"\"\"Return a new string containing only characters at even indices (0-based) from input_string.\n    Handles empty and single-character strings as edge cases.\"\"\"\n    \n    input_obj = InputString(value=input_string)\n\n    if input_obj.length == 0:\n        return \"\"\n    if input_obj.length == 1:\n        return input_obj.value\n\n    result_chars = []\n    for i in range(input_obj.length):\n        if i % 2 == 0:  # Retain characters at even indices (0, 2, 4, ...)\n            result_chars.append(input_obj.value[i])\n\n    final_string = \"\".join(result_chars)\n    output_obj = OutputString(value=final_string)\n\n    return output_obj.value"}
