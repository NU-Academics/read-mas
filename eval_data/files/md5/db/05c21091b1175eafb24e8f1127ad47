{"task_id": "Mbpp/459", "solution": "class InputString:\n    \"\"\"Container for the incoming string value.\n    Reflects the SRS domain model for input.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass OutputString:\n    \"\"\"Container for the result string.\n    Reflects the SRS domain model for output.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass CharacterFilter:\n    \"\"\"Provides stateless character test and filter functions for ASCII uppercase removal.\"\"\"\n    @staticmethod\n    def isUppercase(c: str) -> bool:\n        \"\"\"True iff c is an ASCII uppercase letter in 'A'..'Z'.\"\"\"\n        return 'A' <= c <= 'Z'\n\n    @staticmethod\n    def filter(s: str) -> str:\n        \"\"\"Return s with all ASCII uppercase letters removed, preserving relative order.\"\"\"\n        filtered_chars = [char for char in s if not CharacterFilter.isUppercase(char)]\n        return \"\".join(filtered_chars)\nclass RemoveUppercaseFunction:\n    \"\"\"Implements the algorithm; composes InputString, CharacterFilter, and OutputString to satisfy the use case.\"\"\"\n    def remove_uppercase(self, s: str) -> str:\n        \"\"\"Returns a string with ASCII uppercase letters removed.\"\"\"\n        input_obj = InputString(s)\n        filtered_s = CharacterFilter.filter(input_obj.value)\n        output_obj = OutputString(filtered_s)\n        return output_obj.value\ndef remove_uppercase(s: str) -> str:\n    \"\"\"Public API that delegates to RemoveUppercaseFunction to remove uppercase ASCII characters from the input string.\"\"\"\n    return RemoveUppercaseFunction().remove_uppercase(s)"}
{"task_id": "Mbpp/460", "solution": "from typing import List, Any\ndef Extract(input_list: List[List[Any]]) -> List[Any]:\n    \"\"\"Return the first element of each sublist in input_list, preserving order.\n    Assumptions per design: sublists are non-empty and input_list is a list of sublists.\n    \"\"\"\n    return [sublist[0] for sublist in input_list]"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list: list) -> list:\n    \"\"\"Extracts the first element from each non-empty sublist in the input list.\n    Empty sublists are skipped, and the order of elements is preserved.\"\"\"\n    result = []\n    for sublist in input_list:\n        if sublist:  # Check if sublist is not empty\n            result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/462", "solution": "from .combinations import combinations_list\ndef _generate_all_subsets(elements: list) -> list[list[int]]:\n    \"\"\"\n    Generates all subsets of indices using binary counting for determinism.\n    Returns a list of lists of 0-based integer indices.\n    \"\"\"\n    n = len(elements)\n    all_subset_indices = []\n    for i in range(1 << n):\n        current_subset_indices = []\n        for j in range(n):\n            if (i >> j) & 1:\n                current_subset_indices.append(j)\n        all_subset_indices.append(current_subset_indices)\n    return all_subset_indices\ndef _max_original_index(subset_indices: list[int]) -> int | None:\n    \"\"\"\n    Returns the maximum original index in a subset, or None if the subset is empty.\n    \"\"\"\n    if not subset_indices:\n        return None\n    return max(subset_indices)\ndef _subset_indices_to_elements(subset_indices: list[int], elements: list) -> list:\n    \"\"\"\n    Converts a list of original indices to a list of element values.\n    Elements are ordered by descending original index within the subset.\n    \"\"\"\n    sorted_indices_desc = sorted(subset_indices, reverse=True)\n    return [elements[i] for i in sorted_indices_desc]\ndef _order_subsets_by_max_index(subsets_with_indices: list[tuple[list[int], int | None]], elements: list) -> list[list]:\n    \"\"\"\n    Orders subsets: empty subset first, then groups by ascending maximum original index.\n    Converts subset indices to element values with elements ordered by descending index.\n    \"\"\"\n    def sort_key(item):\n        _, max_idx = item\n        return -1 if max_idx is None else max_idx\n\n    subsets_with_indices.sort(key=sort_key)\n\n    ordered_combinations = []\n    for subset_indices, _ in subsets_with_indices:\n        ordered_combinations.append(_subset_indices_to_elements(subset_indices, elements))\n\n    return ordered_combinations\ndef combinations_list(elements: list) -> list:\n    \"\"\"\n    Returns the power set (all subsets) of an input list as a list-of-lists.\n    Ordering follows SRS rules for the full power set.\n    \"\"\"\n    all_subset_indices = _generate_all_subsets(elements)\n\n    subsets_with_indices_and_max_idx = []\n    for subset_indices in all_subset_indices:\n        max_idx = _max_original_index(subset_indices)\n        subsets_with_indices_and_max_idx.append((subset_indices, max_idx))\n\n    final_ordered_list = _order_subsets_by_max_index(subsets_with_indices_and_max_idx, elements)\n\n    return final_ordered_list"}
{"task_id": "Mbpp/462", "solution": "def _generate_recursive(items: list, index: int) -> list:\n    \"\"\"Recursively generates combinations, ensuring specific internal and overall ordering.\"\"\"\n    if index < 0:\n        return [[]]\n\n    # Combinations generated from elements before the current index.\n    sub_combinations = _generate_recursive(items, index - 1)\n\n    current_item = items[index]\n    # Create new combinations by prepending the current item to each sub-combination.\n    new_combinations = [[current_item] + combo for combo in sub_combinations]\n\n    # Concatenate to maintain deterministic overall ordering.\n    return sub_combinations + new_combinations\ndef combinations_list(inputList: list) -> list:\n    \"\"\"Finds all possible combinations of the elements of a given list, with specific ordering.\"\"\"\n    return _generate_recursive(inputList, len(inputList) - 1)"}
{"task_id": "Mbpp/463", "solution": "from typing import List, Tuple\nclass InputArray:\n    \"\"\"Encapsulates input array and validates its length.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n        self.length = len(values)\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if array length is at least 1.\"\"\"\n        return self.length >= 1\nclass Result:\n    \"\"\"Encapsulates the computed integer product.\"\"\"\n    def __init__(self, product: int) -> None:\n        self.product = product\nclass ProductCalculator:\n    \"\"\"Implements algorithm to compute maximum contiguous subarray product.\"\"\"\n    def __init__(self) -> None:\n        # Fields for internal tracking, as per design specification.\n        self._current_max = 0\n        self._current_min = 0\n        self._global_max = 0\n\n    def computeMaxEndingHere(self, val: int, prevMax: int, prevMin: int) -> Tuple[int, int]:\n        \"\"\"Calculates the max and min product ending at the current value.\"\"\"\n        # Determines the maximum product by considering the current value itself,\n        # or extending previous max/min products with the current value.\n        max_ending_here = max(val, val * prevMax, val * prevMin)\n        \n        # Determines the minimum product similarly, as a negative number can flip signs.\n        min_ending_here = min(val, val * prevMax, val * prevMin)\n        \n        return max_ending_here, min_ending_here\n\n    def maxSubarrayProduct(self, arr: List[int]) -> int:\n        \"\"\"Computes the maximum product of any contiguous subarray.\"\"\"\n        # Initialize max_so_far, min_so_far, and overall_max with the first element.\n        # This initialization also handles the single-element array case (FR7).\n        max_so_far = arr[0]\n        min_so_far = arr[0]\n        overall_max = arr[0]\n\n        # Iterate through the array starting from the second element.\n        for i in range(1, len(arr)):\n            val = arr[i]\n            \n            # Update max and min products ending at the current position using the helper.\n            max_so_far, min_so_far = self.computeMaxEndingHere(val, max_so_far, min_so_far)\n            \n            # Update the overall maximum product found so far.\n            overall_max = max(overall_max, max_so_far)\n\n        # Encapsulate the final product in a Result object as specified.\n        return Result(overall_max).product\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"Public API to find the maximum product of a contiguous subarray.\"\"\"\n    input_array = InputArray(arr)\n    # The design specifies delegation for validation.\n    # Per critical requirements, assume valid input (length >= 1), so no explicit error handling for False.\n    input_array.validate()\n\n    calculator = ProductCalculator()\n    return calculator.maxSubarrayProduct(arr)"}
