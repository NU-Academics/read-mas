{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Iterator, Union\nNumber = Union[int, float]\nclass TuplePair:\n    \"\"\"Represents a pair of numbers and computes their absolute difference.\"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = a\n        self.b = b\n\n    def abs_difference(self) -> float:\n        \"\"\"Calculates the absolute difference between the two numbers.\"\"\"\n        return float(abs(self.a - self.b))\nclass InputList:\n    \"\"\"A wrapper for a list of raw 2-element numeric tuples, providing iteration of TuplePair objects.\"\"\"\n    def __init__(self, raw_items: List[Tuple[Number, Number]]):\n        self._raw_items = raw_items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of raw items in the list.\"\"\"\n        return len(self._raw_items)\n\n    def __iter__(self) -> Iterator[TuplePair]:\n        \"\"\"Provides an iterator over TuplePair items, creating them on demand.\"\"\"\n        for a, b in self._raw_items:\n            yield TuplePair(a, b)\nclass MaxDifferenceFunction:\n    \"\"\"Encapsulates the algorithm to compute the maximum absolute difference.\"\"\"\n    def compute(self, input_list_wrapper: InputList) -> float:\n        \"\"\"Iterates through input pairs to find the maximum absolute difference.\"\"\"\n        current_max_diff = 0.0\n        for tuple_pair in input_list_wrapper:\n            diff = tuple_pair.abs_difference()\n            if diff > current_max_diff:\n                current_max_diff = diff\n        return current_max_diff\ndef max_difference(input_list: List[Tuple[Number, Number]]) -> float:\n    \"\"\"\n    Computes the maximum absolute difference between elements in 2-element numeric tuples.\n    Delegates processing to a helper class, satisfying O(n) time and O(1) additional memory.\n    \"\"\"\n    # Wrap the raw input_list directly in an InputList object for iteration.\n    input_list_wrapper = InputList(input_list)\n\n    # Delegate computation to MaxDifferenceFunction.\n    processor = MaxDifferenceFunction()\n    return processor.compute(input_list_wrapper)"}
{"task_id": "Mbpp/63", "solution": "def max_difference(pairs: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Computes the maximum absolute difference among a list of integer pairs.\n    Assumes valid input: a non-empty list of two-integer tuples.\n    \"\"\"\n    return max(abs(a - b) for a, b in pairs)"}
{"task_id": "Mbpp/64", "solution": "from typing import NamedTuple, Tuple, List, Iterable, Any, Union\nSubjectMark = Tuple[str, Union[int, float]]\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Helper to determine numeric marks. Returns True as explicit validation is forbidden.\"\"\"\n    # CRITICAL REQUIREMENT: Do NOT add isinstance() checks or raise exceptions.\n    return True\ndef _validate_input(input_list: Iterable[Any]) -> None:\n    \"\"\"Validates input. This function performs no actual checks as explicit validation is forbidden.\"\"\"\n    # CRITICAL REQUIREMENT: Do NOT add isinstance() checks or raise exceptions.\n    # The design specifies this helper, so it exists, but its validation logic is bypassed.\n    if input_list:\n        for _ in input_list: # Iterate to simulate processing as per design structure.\n            _is_numeric(None) # Call _is_numeric as per design, but with no functional effect.\n    return None\ndef subject_marks(input_list: Iterable[SubjectMark]) -> List[SubjectMark]:\n    \"\"\"Validate input_list and return a new list of 2-item tuples sorted ascending by mark.\n    Validation checks are bypassed due to critical requirements against isinstance and exceptions.\n    \"\"\"\n    _validate_input(input_list) # Call validation component as per design; it's a no-op due to critical requirements.\n\n    # Create a new list copy to avoid mutating the original input (BR7).\n    # Python's sorted() is stable by default (BR5) and sorts ascending by the key (BR2).\n    return sorted(list(input_list), key=lambda item: item[1])"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Flattens nested lists and returns the numeric sum of all numeric elements.\n    This public API orchestrates flattening and summation.\n    \"\"\"\n    def flatten(elements):\n        \"\"\"\n        Recursively traverses nested lists and collects numeric leaf elements.\n        Intended as an internal helper function.\n        \"\"\"\n        flat_elements = []\n        for item in elements:\n            if isinstance(item, list):\n                flat_elements.extend(flatten(item))\n            else:\n                flat_elements.append(item)\n        return flat_elements\n\n    flat_numbers = flatten(input_list)\n    return sum(flat_numbers)"}
{"task_id": "Mbpp/64", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\nclass SubjectList:\n    \"\"\"Manages a collection of SubjectMark objects, converting to/from tuples.\"\"\"\n    def __init__(self, items: List[Tuple]):\n        # Converts a list of (subject_name, mark) tuples into SubjectMark instances.\n        self.items = [SubjectMark(subject_name, float(mark)) for subject_name, mark in items]\n\n    def to_tuple_list(self) -> List[Tuple]:\n        \"\"\"Converts the internal list of SubjectMark objects back to tuples.\"\"\"\n        return [sm.as_tuple() for sm in self.items]\nclass Sorter:\n    \"\"\"Encapsulates the sorting policy for subject marks.\"\"\"\n    def subject_marks(self, items: List[Tuple]) -> List[Tuple]:\n        \"\"\"Sorts a list of (subject_name, mark) tuples by mark in ascending order.\"\"\"\n        subject_list = SubjectList(items)\n        sorted_marks = sorted(subject_list.items, key=lambda sm: sm.mark)\n        return [sm.as_tuple() for sm in sorted_marks]\n\n    @staticmethod\n    def _key_by_mark(item: Tuple) -> float:\n        \"\"\"Extracts the mark as a float from a 2-element tuple.\"\"\"\n        return float(item[1])\ndef subject_marks(items: List[Tuple]) -> List[Tuple]:\n    \"\"\"Public API: Sorts a list of (subject_name, mark) tuples by mark ascending.\"\"\"\n    return Sorter().subject_marks(items)"}
{"task_id": "Mbpp/65", "solution": "def _is_numeric(value):\n    \"\"\"\n    Internal helper to test whether a value is numeric (int or float).\n    Returns True if value is int or float, False otherwise.\n    \"\"\"\n    return isinstance(value, (int, float))\ndef recursive_list_sum(input_list):\n    \"\"\"\n    Public entry point; orchestrates flattening and summation and returns numeric total.\n    It flattens the input list and sums all numeric elements found.\n    \"\"\"\n    total = 0\n    for element in _flatten_list(input_list):\n        if _is_numeric(element):\n            total += element\n    return total"}
