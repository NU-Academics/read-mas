{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start, end):\n    \"\"\"\n    Returns all perfect square integers within the inclusive range [start, end].\n    Assumes valid integer inputs where start is non-negative and start <= end.\n    \"\"\"\n    # Calculate the smallest integer root whose square is at least 'start'.\n    n_min = math.ceil(math.sqrt(start))\n    \n    # Calculate the largest integer root whose square is at most 'end'.\n    n_max = math.floor(math.sqrt(end))\n    \n    # Generate squares for all integer roots from n_min to n_max.\n    # The list comprehension naturally handles cases where n_min > n_max by returning an empty list.\n    squares = [n * n for n in range(int(n_min), int(n_max) + 1)]\n    \n    return squares"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(x, y):\n    \"\"\"\n    Converts Cartesian coordinates (x, y) to polar coordinates (r, theta)\n    and returns the original Cartesian coordinates as a complex number.\n    \"\"\"\n    r = math.sqrt(x**2 + y**2)\n    theta = math.atan2(y, x)\n    return ((float(r), float(theta)), complex(x, y))"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"Swaps the first and last elements of a list, returning a new list.\n    If the list has fewer than two elements, it is returned unchanged by content.\"\"\"\n    length = len(input_list)\n    if length < 2:\n        return input_list\n    else:\n        # Construct a new list with the last element first, middle elements, and then the first element.\n        return [input_list[-1]] + input_list[1:-1] + [input_list[0]]"}
{"task_id": "Mbpp/591", "solution": "from typing import List, Any\ndef swap_List(list_input: List[Any]) -> List[Any]:\n    \"\"\"Interchanges the first and last elements of a list, returning a new list.\n    Lists with fewer than two elements are returned unchanged.\"\"\"\n    \n    if len(list_input) < 2:\n        return list_input[:]\n    \n    result = list_input[:]\n    result[0], result[-1] = result[-1], result[0]\n    return result"}
{"task_id": "Mbpp/590", "solution": "import math\nimport dataclasses\nclass Validator:\n    \"\"\"Validates inputs for polar to rectangular conversion. (Validation logic bypassed per critical requirements).\"\"\"\n\n    @staticmethod\n    def is_valid_radius(r) -> bool:\n        \"\"\"Checks if radius is a valid finite number. (Bypassed).\"\"\"\n        return True\n\n    @staticmethod\n    def is_valid_angle(theta, unit='radians') -> bool:\n        \"\"\"Checks if angle is a valid finite number. (Bypassed).\"\"\"\n        return True\n\n    @staticmethod\n    def validate_input(r, theta, unit='radians') -> None:\n        \"\"\"Validates r, theta, and unit string. (No-op due to critical requirements).\"\"\"\n        pass\nclass Converter:\n    \"\"\"Converts polar coordinates to rectangular coordinates and handles edge cases.\"\"\"\n\n    def __init__(self, allow_negative_radius: bool = False):\n        self.allow_negative_radius = allow_negative_radius\n        \"\"\"Initializes Converter with negative radius handling preference.\"\"\"\n\n    def polar_to_rect(self, p: PolarCoordinate) -> RectangularCoordinate:\n        \"\"\"Converts polar coordinates to rectangular coordinates.\"\"\"\n        r = p.r\n        theta = p.theta\n\n        if p.angle_unit == 'degrees':\n            theta = math.radians(p.theta)\n\n        if r == 0:\n            return RectangularCoordinate(0.0, 0.0)\n\n        if r < 0 and self.allow_negative_radius:\n            r = abs(r)\n            theta += math.pi\n\n        x = r * math.cos(theta)\n        y = r * math.sin(theta)\n        return RectangularCoordinate(x, y)\n\n    def polar_to_complex(self, p: PolarCoordinate) -> complex:\n        \"\"\"Converts polar coordinates to a complex number.\"\"\"\n        rc = self.polar_to_rect(p)\n        return rc.to_complex()\n\n    def rect_to_polar(self, rc: RectangularCoordinate) -> PolarCoordinate:\n        \"\"\"Converts rectangular coordinates to polar coordinates.\"\"\"\n        r = math.hypot(rc.x, rc.y)\n        theta = math.atan2(rc.y, rc.x)\n        return PolarCoordinate(r, theta, angle_unit='radians')\ndef polar_rect(r, theta, unit: str = 'radians') -> tuple:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x, y)\n    and their complex representation.\n    \"\"\"\n    # Validation is bypassed as per critical requirements.\n    Validator.validate_input(r, theta, unit)\n\n    p = PolarCoordinate(r, theta, angle_unit=unit)\n    converter = Converter() # allow_negative_radius defaults to False\n    rc = converter.polar_to_rect(p)\n    return ((rc.x, rc.y), rc.to_complex())"}
{"task_id": "Mbpp/592", "solution": "# src/binomial_calculator.py\n\nclass BinomialCoefficientCalculator:\n    \"\"\"Computes binomial coefficient C(n, k) using integer-only arithmetic.\"\"\"\n\n    def C(self, n: int, k: int) -> int:\n        \"\"\"Returns the exact integer value of C(n, k) for 0 <= k <= n.\n        Uses the multiplicative formula and symmetry for efficient, integer-safe computation.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        # Optimize using symmetry C(n, k) = C(n, n-k)\n        if k > n // 2:\n            k = n - k\n        \n        # Multiplicative formula: C(n, k) = (n * (n-1) * ... * (n-k+1)) / (k * (k-1) * ... * 1)\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1) # Python's // ensures integer division\n        return res"}
{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Computes the sum of products of consecutive binomial coefficients S(n).\n    Calculates S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1) using exact integer arithmetic.\n    \"\"\"\n    total = 0\n    for k in range(n):\n        total += math.comb(n, k) * math.comb(n, k + 1)\n    return total"}
{"task_id": "Mbpp/593", "solution": "# src/octet.py\n\"\"\"\nOctet domain class for IPv4 octet parsing and normalization.\nEncapsulates logic for a single octet's value and string representation.\n\"\"\"\n\nclass Octet:\n    \"\"\"\n    Represents a single IPv4 octet, handling its raw string, decimal value,\n    and normalized string form without leading zeros.\n    \"\"\"\n    def __init__(self, raw: str) -> None:\n        \"\"\"\n        Initializes an Octet instance from its raw string.\n        Parses the raw string to an integer value and normalizes it.\n        \"\"\"\n        self.raw = raw\n        self.value = self.toInt()\n        self.normalized = self.removeLeadingZeros()\n\n    def toInt(self) -> int:\n        \"\"\"\n        Parses the raw octet string as a base-10 integer.\n        Assumes valid numeric input as per critical requirements.\n        \"\"\"\n        return int(self.raw)\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"\n        Returns the normalized string representation of the octet.\n        Removes leading zeros, but preserves '0' for a zero-valued octet.\n        \"\"\"\n        if self.value == 0:\n            return \"0\"\n        return str(self.value)"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Encapsulates octet-level normalization.\n    Removes leading zeros and handles all-zero octets.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.numeric_value = int(raw)\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"Returns the canonical string for the octet.\n        For example, \"08\" becomes \"8\", \"000\" becomes \"0\".\"\"\"\n        if self.numeric_value == 0:\n            return \"0\"\n        else:\n            return str(self.numeric_value)\nclass IPAddress:\n    \"\"\"Represents an IPv4 address and orchestrates its normalization.\n    It manages the raw and normalized string forms.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.normalized = \"\"\n\n    def normalize(self) -> str:\n        \"\"\"Splits the raw IP string into octets, normalizes each, and rejoins them.\n        Sets and returns the normalized string.\"\"\"\n        octet_strings = self.raw.split('.')\n        normalized_octets = []\n        for octet_string in octet_strings:\n            octet = Octet(raw=octet_string)\n            normalized_octets.append(octet.removeLeadingZeros())\n        \n        self.normalized = \".\".join(normalized_octets)\n        return self.normalized\nclass RemoveZeroService:\n    \"\"\"Stateless service to encapsulate the IPv4 normalization use-case logic.\n    It orchestrates the domain objects to perform the normalization.\"\"\"\n    def removezero_ip(self, ip: str) -> str:\n        \"\"\"Normalizes an IPv4 string by removing leading zeros from its octets.\n        Delegates to the IPAddress domain object for the actual normalization.\"\"\"\n        ip_address = IPAddress(raw=ip)\n        return ip_address.normalize()\ndef removezero_ip(ip: str) -> str:\n    \"\"\"Public API function to normalize an IPv4 address string.\n    Removes leading zeros from each dot-separated octet.\"\"\"\n    return RemoveZeroService().removezero_ip(ip)"}
{"task_id": "Mbpp/594", "solution": "class Element:\n    \"\"\"Represents a single integer element and provides parity predicates.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the element's value is even.\"\"\"\n        return self.value % 2 == 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return self.value % 2 != 0\nclass Scanner:\n    \"\"\"Scans an input list from index 0 to identify the first even and the first odd values.\"\"\"\n    def findFirstEven(self, lst: list[int]) -> int:\n        \"\"\"Returns the first even integer encountered when scanning lst from index 0.\"\"\"\n        for num in lst:\n            element = Element(num)\n            if element.isEven():\n                return num\n        # Per design preconditions, an even number is guaranteed to exist.\n\n    def findFirstOdd(self, lst: list[int]) -> int:\n        \"\"\"Returns the first odd integer encountered when scanning lst from index 0.\"\"\"\n        for num in lst:\n            element = Element(num)\n            if element.isOdd():\n                return num\n        # Per design preconditions, an odd number is guaranteed to exist.\nclass DiffCalculator:\n    \"\"\"Orchestrates Scanner to find first even/odd, then computes their difference.\"\"\"\n    def diff_even_odd(self, lst: list[int]) -> int:\n        \"\"\"Orchestrates scanning for first even and odd, then computes firstEven - firstOdd.\"\"\"\n        scanner = Scanner()\n        first_even = scanner.findFirstEven(lst)\n        first_odd = scanner.findFirstOdd(lst)\n        return first_even - first_odd\ndef diff_even_odd(list_of_ints: list[int]) -> int:\n    \"\"\"\n    Finds the difference between the first even and first odd numbers in a list.\n    Delegates the core orchestration and calculation to a DiffCalculator instance.\n    \"\"\"\n    calculator = DiffCalculator()\n    return calculator.diff_even_odd(list_of_ints)"}
{"task_id": "Mbpp/594", "solution": "from typing import Iterator\nclass IntegerElement:\n    \"\"\"Represents an integer value with methods to check its parity.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the integer element's value is even.\"\"\"\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the integer element's value is odd.\"\"\"\n        return self.value % 2 != 0\nclass IntegerList:\n    \"\"\"A collection of IntegerElement objects, providing iteration and construction from a Python list.\"\"\"\n    def __init__(self, elements: list[IntegerElement]) -> None:\n        self.elements = elements\n\n    @staticmethod\n    def from_pylist(values: list[int]) -> 'IntegerList':\n        \"\"\"Constructs an IntegerList from a standard Python list of integers.\"\"\"\n        return IntegerList([IntegerElement(value) for value in values])\n\n    def __iter__(self) -> Iterator[IntegerElement]:\n        \"\"\"Allows iteration over the IntegerElement objects in the list.\"\"\"\n        return iter(self.elements)\ndef diff_even_odd(nums: list[int]) -> int:\n    \"\"\"\n    Computes (first even) - (first odd) by traversing the input list left-to-right.\n    It identifies the first odd and first even values encountered.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    integer_list = IntegerList.from_pylist(nums)\n\n    for element in integer_list:\n        if first_odd is None and element.is_odd():\n            first_odd = element.value\n        \n        if first_even is None and element.is_even():\n            first_even = element.value\n            \n        # Stop traversal once both values are found.\n        if first_odd is not None and first_even is not None:\n            break\n            \n    return first_even - first_odd"}
