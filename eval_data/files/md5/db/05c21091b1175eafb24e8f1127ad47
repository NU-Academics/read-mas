{"task_id": "Mbpp/239", "solution": "from typing import Optional, List, Dict, Tuple\nclass ValidationResult:\n    \"\"\"\n    Represents the outcome of an input validation operation.\n    It indicates whether inputs are valid and provides a message if not.\n    \"\"\"\n    def __init__(self, is_valid: bool, message: Optional[str] = None):\n        self.is_valid = is_valid\n        self.message = message\nclass InputParameters:\n    \"\"\"\n    Stores and validates input parameters m and n for the sequence problem.\n    It ensures inputs meet type and range constraints.\n    \"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\n    def validate(self) -> ValidationResult:\n        \"\"\"\n        Validates m and n, checking if they are integers and positive (>= 1).\n        Returns a ValidationResult object detailing the outcome.\n        \"\"\"\n        if not isinstance(self.m, int) or not isinstance(self.n, int):\n            return ValidationResult(False, \"Inputs m and n must be integers.\")\n        if self.m < 1 or self.n < 1:\n            return ValidationResult(False, \"Inputs m and n must be positive integers (>= 1).\")\n        return ValidationResult(True)\nclass Constraint:\n    \"\"\"\n    Encapsulates the rules for sequence elements: a maximum value and a growth factor.\n    It provides a method to check if a transition between two elements satisfies these rules.\n    \"\"\"\n    def __init__(self, maxValue: int, growthFactor: int = 2):\n        self.maxValue = maxValue\n        self.growthFactor = growthFactor\n\n    def isSatisfied(self, prev: int, curr: int) -> bool:\n        \"\"\"\n        Checks if the transition from 'prev' to 'curr' satisfies all constraints.\n        This includes the growth factor and element values staying within bounds.\n        \"\"\"\n        return (curr >= self.growthFactor * prev and\n                1 <= prev <= self.maxValue and\n                1 <= curr <= self.maxValue)\nclass SequenceCounter:\n    \"\"\"\n    Computes the exact number of valid sequences based on given constraints.\n    It employs a memoized recursive (dynamic programming) approach for efficiency.\n    \"\"\"\n    def __init__(self):\n        self._memo: Dict[Tuple[int, int], int] = {} # Caches results for (length_left, prev_val) tuples.\n\n    def countSequences(self, m: int, n: int) -> int:\n        \"\"\"\n        Calculates the total number of sequences of length 'n'.\n        Each element must be in [1..m] and satisfy a_{i+1} >= 2 * a_i.\n        \"\"\"\n        constraint = Constraint(maxValue=m)\n        self._memo = {} # Reset memoization cache for each new calculation.\n\n        def _count_recursive(length_left: int, prev_val: int) -> int:\n            \"\"\"\n            Internal recursive function to count sequences from a specific state.\n            It calculates how many ways a sequence can be completed.\n            \"\"\"\n            if length_left == 0:\n                return 1 # A valid sequence of the desired length has been formed.\n            if (length_left, prev_val) in self._memo:\n                return self._memo[(length_left, prev_val)]\n\n            current_total = 0\n            # The next element must be at least 'prev_val * growthFactor' and at most 'm'.\n            start_next_val = prev_val * constraint.growthFactor\n            for next_val in range(start_next_val, constraint.maxValue + 1):\n                current_total += _count_recursive(length_left - 1, next_val)\n\n            self._memo[(length_left, prev_val)] = current_total\n            return current_total\n\n        total_sequences = 0\n        # Iterate through all possible values for the first element of the sequence.\n        for first_val in range(1, m + 1):\n            total_sequences += _count_recursive(n - 1, first_val) # Recurse for the remaining n-1 elements.\n\n        return total_sequences\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    The public API entry point to calculate the total number of sequences.\n    It performs input validation and then delegates the counting logic to SequenceCounter.\n    \"\"\"\n    input_params = InputParameters(m, n)\n    validation_result = input_params.validate()\n\n    if not validation_result.is_valid:\n        raise ValueError(validation_result.message)\n    \n    return SequenceCounter().countSequences(m, n)"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Counts ordered integer sequences of length n where 1 <= a_i <= m\n    and for i > 1, a_i >= 2 * a_{i-1}.\n    \"\"\"\n    # Memoization dictionary to store results of subproblems.\n    # Key: (current_prev_val, remaining_length), Value: count of sequences.\n    memo = {}\n\n    def count_continuations(current_prev_val: int, remaining_length: int) -> int:\n        \"\"\"\n        Recursively counts valid sequences given a previous element value and length.\n        It uses memoization to store and retrieve results for subproblems.\n        \"\"\"\n        # Base case: If no more elements are needed, a valid sequence of the\n        # required length has been successfully formed.\n        if remaining_length == 0:\n            return 1\n\n        # Check if this subproblem has already been solved and return the stored result.\n        if (current_prev_val, remaining_length) in memo:\n            return memo[(current_prev_val, remaining_length)]\n\n        current_count = 0\n        min_next_val = 2 * current_prev_val\n\n        # Iterate through all possible values for the next element (a_i).\n        # The next element must be within the range [min_next_val, m].\n        for next_val in range(min_next_val, m + 1):\n            # Recursively count sequences for the remaining length, using 'next_val' as the new 'prev_val'.\n            current_count += count_continuations(next_val, remaining_length - 1)\n\n        # Store the computed result in the memoization table before returning it.\n        memo[(current_prev_val, remaining_length)] = current_count\n        return current_count\n\n    total_sequences = 0\n    # The first element (a_1) of any sequence can be any integer from 1 to m.\n    # For each possible first element, count how many valid sequences of length (n-1)\n    # can follow it, and sum these counts to get the total number of sequences.\n    for first_element in range(1, m + 1):\n        total_sequences += count_continuations(first_element, n - 1)\n\n    return total_sequences"}
