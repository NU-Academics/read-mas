{"task_id": "Mbpp/797", "solution": "from src.domain import SumCalculator\nclass Number:\n    \"\"\"\n    Value object for an integer, providing predicates like isNatural and isOdd.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isNatural(self) -> bool:\n        \"\"\"\n        Checks if the number is a natural number (>= 1).\n        \"\"\"\n        return self.value >= 1\n\n    def isOdd(self) -> bool:\n        \"\"\"\n        Checks if the number is an odd number.\n        \"\"\"\n        return self.value % 2 != 0\nclass SumCalculator:\n    \"\"\"\n    Calculates the sum of odd natural numbers within a specified range.\n    It uses Range and Number objects for its computations.\n    \"\"\"\n    def sum_in_range(self, l: int, r: int) -> int:\n        \"\"\"\n        Computes the sum of all odd natural numbers in the inclusive range [l, r].\n        Returns 0 if no such numbers exist.\n        \"\"\"\n        total_sum = 0\n        # Iterate through the range from l to r\n        for n in range(l, r + 1):\n            number = Number(n)\n            # Check if the number is both natural and odd\n            if number.isNatural() and number.isOdd():\n                total_sum += n\n        return total_sum\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Delegates the core logic to SumCalculator.\n    \"\"\"\n    calculator = SumCalculator()\n    return calculator.sum_in_range(l, r)"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r) -> int:\n    \"\"\"\n    Computes the sum of all odd natural numbers x such that l <= x <= r and x >= 1.\n    Returns 0 if no such numbers exist in the range.\n    \"\"\"\n    total_sum = 0\n    for x in range(l, r + 1):\n        if x >= 1 and x % 2 == 1:\n            total_sum += x\n    return total_sum"}
