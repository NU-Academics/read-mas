{"task_id": "Mbpp/427", "solution": "def change_date_format(input: str) -> str:\n    \"\"\"Converts a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy' format.\n    This function assumes the input string is always in the correct 'yyyy-mm-dd' format.\"\"\"\n    \n    # Extract year, month, and day components using string slicing.\n    year_str = input[0:4]\n    month_str = input[5:7]\n    day_str = input[8:10]\n\n    # Convert components to integers.\n    year = int(year_str)\n    month = int(month_str)\n    day = int(day_str)\n\n    # Format the day and month with two digits (zero-padded) and the year with four digits.\n    formatted_day = f\"{day:02d}\"\n    formatted_month = f\"{month:02d}\"\n    formatted_year = f\"{year:04d}\"\n\n    # Return the date in 'dd-mm-yyyy' format.\n    return f\"{formatted_day}-{formatted_month}-{formatted_year}\""}
{"task_id": "Mbpp/428", "solution": "import math\ndef shell_sort(lst: list) -> list:\n    \"\"\"\n    Sorts a list in ascending order using the Shell sort algorithm.\n    Validates input, applies Shell sort, and returns the sorted list.\n    \"\"\"\n    validate_input(lst)\n    return _apply_shell_sort(lst)\ndef _apply_shell_sort(lst: list) -> list:\n    \"\"\"\n    Applies the Shell sort algorithm to the list in-place.\n    Instantiates ShellSortAlgorithm, generates gaps, and performs gap-based insertion sorts.\n    \"\"\"\n    # Create a copy to sort, as the design implies returning a sorted list and the\n    # algorithm mutates in-place. If the original design intended to modify the\n    # input list directly and return it, this copy could be omitted.\n    # Given 'return a list sorted', copying ensures a new sorted list is always returned.\n    list_to_sort = lst[:] # Create a shallow copy for sorting\n\n    algo = ShellSortAlgorithm()\n    gaps = algo.generate_gaps(len(list_to_sort))\n\n    for gap in gaps:\n        algo.sort_with_gap(list_to_sort, gap)\n    return list_to_sort\nclass ShellSortAlgorithm:\n    \"\"\"\n    Encapsulates the Shell sort algorithm logic, including gap generation\n    and gap-based insertion sort passes.\n    \"\"\"\n    def generate_gaps(self, n: int) -> list[int]:\n        \"\"\"\n        Computes and returns a descending list of gap values for a list of length n.\n        Uses Knuth's sequence (h = 3h + 1) for gap generation.\n        \"\"\"\n        gaps = []\n        h = 1\n        while h < n:\n            gaps.append(h)\n            h = 3 * h + 1\n        return gaps[::-1] # Return gaps in descending order\n\n    def sort_with_gap(self, lst: list, gap: int) -> None:\n        \"\"\"\n        Performs an in-place gap-based insertion sort pass on the list using the given gap.\n        This function mutates the list directly.\n        \"\"\"\n        n = len(lst)\n        for i in range(gap, n):\n            current_value = lst[i]\n            j = i\n            # Perform insertion sort for elements at 'gap' intervals\n            while j >= gap and lst[j - gap] > current_value:\n                lst[j] = lst[j - gap]\n                j -= gap\n            lst[j] = current_value"}
{"task_id": "Mbpp/427", "solution": "import re\nfrom .date_validator import DateValidator\nfrom .date_string import DateString\nfrom .date_converter import DateConverter\nclass DateString:\n    \"\"\"Value object holding parsed date components.\"\"\"\n    def __init__(self, raw: str, year: str, month: str, day: str):\n        self.raw = raw\n        self.year = year\n        self.month = month\n        self.day = day\nclass DateValidator:\n    \"\"\"Validates textual format and optionally semantic date correctness.\"\"\"\n    _FORMAT_REGEX = re.compile(r'^\\d{4}-\\d{2}-\\d{2}$')\n\n    def matches_format(self, input: str) -> bool:\n        \"\"\"Checks if the input string matches the yyyy-mm-dd textual format.\"\"\"\n        return bool(self._FORMAT_REGEX.match(input))\n\n    def is_valid_date(self, d: 'DateString') -> bool:\n        \"\"\"Performs optional semantic checks for date validity.\"\"\"\n        # Semantic checks (month/day ranges, leap-year) are not required by the SRS.\n        return True\nclass DateConverter:\n    \"\"\"Orchestrates validation, parsing into DateString, and formatting.\"\"\"\n    def __init__(self, validator: DateValidator = None):\n        self._validator = validator or DateValidator()\n\n    def change_date_format(self, input: str) -> str:\n        \"\"\"Converts a yyyy-mm-dd date string to dd-mm-yyyy format.\"\"\"\n        if not self._validator.matches_format(input):\n            raise ValueError(\"Input does not match required format yyyy-mm-dd\")\n        \n        d = self._parse(input)\n        # Semantic validation is optional and not required by the SRS.\n        # if not self._validator.is_valid_date(d):\n        #     raise ValueError(\"Semantic date invalid\")\n        return self._format(d)\n\n    def _parse(self, input: str) -> 'DateString':\n        \"\"\"Parses a yyyy-mm-dd string into DateString components.\"\"\"\n        year = input[0:4]\n        month = input[5:7]\n        day = input[8:10]\n        return DateString(raw=input, year=year, month=month, day=day)\n\n    def _format(self, d: 'DateString') -> str:\n        \"\"\"Formats DateString into dd-mm-yyyy preserving leading zeros.\"\"\"\n        return f\"{d.day}-{d.month}-{d.year}\"\ndef change_date_format(input: str) -> str:\n    \"\"\"Converts a date string from yyyy-mm-dd to dd-mm-yyyy format.\"\"\"\n    converter = DateConverter()\n    return converter.change_date_format(input)"}
