{"task_id": "Mbpp/619", "solution": "from typing import List, Iterator\nclass Character:\n    \"\"\"Value object for a single character and its position.\n    Provides an is_digit() test based on Python's str.isdigit().\"\"\"\n    def __init__(self, char: str, position: int):\n        self.char = char\n        self.position = position\n\n    def is_digit(self) -> bool:\n        \"\"\"Determines if the character is a digit.\"\"\"\n        return self.char.isdigit()\nclass StringInput:\n    \"\"\"Input holder; exposes length and iteration over Character instances.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def __iter__(self) -> Iterator[Character]:\n        \"\"\"Yields Character instances for each position, left-to-right.\"\"\"\n        for i, char_value in enumerate(self.value):\n            yield Character(char_value, i)\nclass OutputString:\n    \"\"\"Result holder for the produced string and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass MoveNumService:\n    \"\"\"Core transformation logic: scans input, collects non-digits and digits, then produces OutputString.\"\"\"\n    def __init__(self):\n        self._non_digits: List[str] = []\n        self._digits: List[str] = []\n\n    def move_num(self, input_obj: StringInput) -> OutputString:\n        \"\"\"Iterates StringInput, separating characters into non-digits and digits, then concatenates them.\"\"\"\n        for char_obj in input_obj:\n            if char_obj.is_digit():\n                self._digits.append(char_obj.char)\n            else:\n                self._non_digits.append(char_obj.char)\n\n        result_str = \"\".join(self._non_digits) + \"\".join(self._digits)\n        return OutputString(result_str)\ndef move_num(input: str) -> str:\n    \"\"\"Public API facade: constructs StringInput, calls MoveNumService.move_num, returns OutputString.value.\"\"\"\n    string_input_obj = StringInput(input)\n    move_num_service = MoveNumService()\n    output_string_obj = move_num_service.move_num(string_input_obj)\n    return output_string_obj.value"}
{"task_id": "Mbpp/619", "solution": "DIGITS_CHARS: str = '0123456789'\nclass Validator:\n    \"\"\"Handles input validation for the move_num function.\"\"\"\n    @staticmethod\n    def validate_type(input_val) -> None:\n        \"\"\"Raises TypeError if the input is not a string.\"\"\"\n        if not isinstance(input_val, str):\n            raise TypeError(\"Input must be a string.\")\ndef _is_digit(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII digit ('0'-'9').\"\"\"\n    return ch in DIGITS_CHARS\ndef _concatenate_buffers(non_digits: list, digits: list) -> str:\n    \"\"\"Efficiently concatenates non-digit and digit character lists.\"\"\"\n    return ''.join(non_digits) + ''.join(digits)\nclass MoveNumFunction:\n    \"\"\"Encapsulates the core logic for moving numbers to the end of a string.\"\"\"\n    @staticmethod\n    def move_num(input: str) -> str:\n        \"\"\"Moves all digit characters to the end of the input string, preserving order.\"\"\"\n        Validator.validate_type(input)\n\n        non_digits = []\n        digits = []\n\n        for char in input:\n            if _is_digit(char):\n                digits.append(char)\n            else:\n                non_digits.append(char)\n\n        return _concatenate_buffers(non_digits, digits)\ndef move_num(input: str) -> str:\n    \"\"\"Module-level entry point that delegates to MoveNumFunction.move_num.\"\"\"\n    return MoveNumFunction.move_num(input)"}
{"task_id": "Mbpp/620", "solution": "from typing import List\nclass Element:\n    \"\"\"Lightweight data holder for an integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def __repr__(self):\n        return f\"Element({self.value})\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self):\n        return hash(self.value)\nclass DivisibilityRelation:\n    \"\"\"Evaluates pairwise divisibility relation between two Elements.\"\"\"\n    @staticmethod\n    def divides(a: Element, b: Element) -> bool:\n        \"\"\"Returns True if a.value is divisible by b.value or vice versa.\"\"\"\n        if b.value == 0:\n            return a.value == 0\n        if a.value == 0:\n            return True # 0 is divisible by any non-zero number\n        return a.value % b.value == 0 or b.value % a.value == 0\ndef _build_pairwise_divisibility(elements: List[Element]) -> List[List[bool]]:\n    \"\"\"Builds an NxN boolean matrix for pairwise divisibility.\"\"\"\n    n = len(elements)\n    divisible_matrix = [[False] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            if i == j:\n                divisible_matrix[i][j] = True  # An element is 'divisible' by itself\n            else:\n                divisible_matrix[i][j] = DivisibilityRelation.divides(elements[i], elements[j])\n    return divisible_matrix\ndef largest_subset(input_list: List[int]) -> int:\n    \"\"\"\n    Computes the size of the largest subset of integers from the provided list\n    such that every pair of distinct elements a and b satisfies a % b == 0 or b % a == 0.\n    \"\"\"\n    elements = [Element(val) for val in input_list]\n\n    # The design spec implies _build_pairwise_divisibility is used.\n    # However, the chosen DP algorithm in _compute_largest_subset_size (longest divisible chain on sorted elements)\n    # does not directly use the full NxN matrix from _build_pairwise_divisibility,\n    # but rather relies on the sorted order and the single-direction divisibility check (val % prev_val == 0).\n    # To strictly adhere to the design's component usage:\n    # 1. We still need to create `divisible_matrix` if `_compute_largest_subset_size` were to use it.\n    # 2. But the DP algorithm chosen (which is standard for this problem variant) is more efficient\n    #    and doesn't directly query the full pairwise matrix.\n\n    # If `_compute_largest_subset_size` were to use the matrix explicitly for clique finding (harder problem),\n    # the matrix would be essential. For the \"longest chain\" variant (as implicitly defined by DP solution),\n    # the matrix is not directly needed by the DP step itself, only the sorted elements.\n\n    # Reconciling: The design states `_compute_largest_subset_size` takes the `divisible` matrix.\n    # The DP logic implemented above (longest chain) only needs the elements.\n    # To satisfy the signature and design, the matrix is passed, but the current DP won't use it in its full form.\n    # A simple way to satisfy the design, while keeping the efficient DP for chains,\n    # is to pass the elements to the DP function, and the DP function's logic implicitly handles the \"divisible\" aspect.\n    # Let's adjust _compute_largest_subset_size to *not* take the matrix if it's not used,\n    # or make it use the matrix if the intent was truly a max clique on the divisibility graph.\n\n    # The design notes for _compute_largest_subset_size:\n    # \"algorithm implied by SRS \u2014 dynamic programming that sorts by value and computes a longest-compatible chain\"\n    # This specifically points to the chain approach.\n    # Thus, _build_pairwise_divisibility is not strictly needed for the _compute_largest_subset_size's internal logic,\n    # as the DP method directly performs the divisibility checks for `elements[i].value % elements[j].value == 0`.\n    # To fulfill the design's explicit component architecture, we can keep the call to _build_pairwise_divisibility\n    # and pass its result, even if the DP internally recalculates/doesn't use it directly.\n    # This shows adherence to the specified component communication, even if the DP could be slightly leaner.\n\n    # Option 1: Strictly follow parameter passing, even if DP doesn't use the full matrix.\n    # The current _compute_largest_subset_size doesn't need the matrix.\n    # Let's simplify _compute_largest_subset_size to *only* take elements if it doesn't need the matrix.\n    # Rereading: \"def _compute_largest_subset_size(elements: list[Element], divisible: list[list[bool]]) -> int\"\n    # The design *insists* on passing the matrix. This means my DP, as implemented, is slightly out of sync\n    # with the explicit signature.\n    # If the DP has to use the matrix, then it would iterate through `divisible[original_idx_i][original_idx_j]`.\n\n    # Let's revise _compute_largest_subset_size to directly use the 'divisible' matrix as per its signature.\n    # This means the DP state should align with the original indices, not the sorted ones for the `dp` array.\n    # Or, the sorting happens internally, and then original indices are mapped.\n\n    # Re-implementing _compute_largest_subset_size to use the matrix directly.\n    # This implies a graph-based DP rather than a strict chain on sorted values.\n    # If it's a \"longest chain\", sorting elements first is key.\n    # If it's \"any subset where all pairs are divisible\", it's a maximum clique problem, which is NP-hard.\n    # The design's phrase \"sorts by value and computes a longest-compatible chain\" for the DP\n    # indicates the chain-based approach. The `divisible` matrix might be considered a redundant step\n    # if the sorting + direct check is done.\n\n    # Let's assume the design meant:\n    # 1. Build a graph (represented by `divisible_matrix`) where edges mean divisibility.\n    # 2. Find the longest path/chain in this graph where all nodes are pairwise connected? No, that's not what the problem asks.\n    #    \"for every pair of distinct elements a and b in the subset either a is divisible by b or b is divisible by a.\"\n    #    This *is* a max clique problem if elements can be in any order.\n    #    However, the example `[1, 3, 6, 18]` implies a chain. `1|3`, `1|6`, `1|18`, `3|6`, `3|18`, `6|18`.\n    #    Every pair *in the subset* must be divisible. This is exactly a clique.\n    #    The hint \"sorts by value and computes a longest-compatible chain\" implies a simplification from max clique to longest path on a DAG if edges only go from smaller to larger divisible elements.\n    #    For `_compute_largest_subset_size` to use the `divisible_matrix` directly and be NP-hard (max clique) or simpler (longest chain DP).\n    #    Given the `dp` suggestion, it's very likely the \"longest chain\" interpretation.\n\n    # Option 2: Stick to the robust DP that handles the \"chain\" interpretation efficiently (as implemented initially),\n    # and acknowledge that the `divisible_matrix` might not be fully utilized by this specific DP variant.\n    # The DP solution for \"longest divisible subset (chain)\" usually sorts and does `val % prev_val == 0`.\n    # The design asks for `_build_pairwise_divisibility` and passing it to `_compute_largest_subset_size`.\n    # So, `_compute_largest_subset_size` *must* accept it.\n\n    # Let's revert to the DP logic using the sorted elements, and ensure the `_compute_largest_subset_size` signature is respected.\n    # The matrix `divisible_matrix` from `_build_pairwise_divisibility` would map original indices.\n    # If `_compute_largest_subset_size` is to use the matrix, it means it must use `divisible_matrix[original_idx_i][original_idx_j]`\n    # and elements should be unsorted in its own DP loop. This makes the DP more complex if it's still chain-like.\n\n    # Simplest interpretation to meet all specs:\n    # 1. `_build_pairwise_divisibility` does what it says.\n    # 2. `_compute_largest_subset_size` accepts the matrix.\n    # 3. `_compute_largest_subset_size` internally sorts the elements (or copies them), and uses the original indices + matrix for its DP.\n    # This means the `dp` array should refer to the *sorted* elements, but `divisible_matrix` refers to *original* elements.\n    # This requires a mapping.\n\n    # Let's adjust _compute_largest_subset_size to use the matrix:\n    # It will sort `elements` internally, but store their original indices.\n    # When `dp[i]` is computed for `sorted_element[i]`, it checks `sorted_element[j]` using `divisible_matrix[original_idx_i][original_idx_j]`.\n\n    # This makes the DP:\n    # dp[i] = max length of subset where `sorted_elements[i]` is the largest element.\n    # For `sorted_elements[i]` (orig index `oi`), for each `sorted_elements[j]` (orig index `oj`) where `j < i`:\n    #   if `divisible_matrix[oi][oj]` (or `divisible_matrix[oj][oi]` since symmetric) and `sorted_elements[i].value % sorted_elements[j].value == 0`:\n    #     dp[i] = max(dp[i], 1 + dp[j])\n    # The `divisible_matrix` check is symmetric, but for chains it's `a | b`. The `sorted_elements[i].value % sorted_elements[j].value == 0` is stronger.\n    # The original \"a is divisible by b or b is divisible by a\" is a symmetric relation.\n    # If a subset is `{x, y, z}`, then `(x,y)`, `(x,z)`, `(y,z)` must all be divisible pairs. This is a clique.\n    # The \"longest-compatible chain\" is a subset of clique finding, much simpler.\n    # Let's stick to the longest chain DP as it's the most common and implied by \"DP\" and \"chain\".\n    # The `divisible_matrix` becomes technically unused by this specific DP in its full form.\n    # But for strict adherence to signature and flow, it *must* be created and passed.\n\n    divisible_matrix = _build_pairwise_divisibility(elements)\n    \n    # The `_compute_largest_subset_size` implementation must use the pairwise matrix now.\n    # So the DP logic should be re-aligned.\n    # The previous chain-based DP is correct for \"longest chain\".\n    # If it must use the matrix `divisible_matrix`, it implies a check like `divisible_matrix[i][j]` when determining extendability.\n\n    # Final decision for _compute_largest_subset_size to adhere to signature & design notes:\n    # 1. Takes `elements` (original order) and `divisible_matrix` (original indices).\n    # 2. Internally, it creates a list of (value, original_index) tuples from `elements` and sorts them.\n    # 3. The DP array `dp` will correspond to the *sorted* elements.\n    # 4. When checking `sorted_elements[i]` against `sorted_elements[j]`, use `divisible_matrix`\n    #    with their *original* indices to determine if they are compatible.\n    #    AND ensure `sorted_elements[i].value % sorted_elements[j].value == 0` for chain property.\n\n    # This is the most faithful interpretation considering all design points.\n\n    return _compute_largest_subset_size_with_matrix(elements, divisible_matrix)\ndef _compute_largest_subset_size_with_matrix(elements: List[Element], divisible_matrix: List[List[bool]]) -> int:\n    \"\"\"\n    Internal helper that computes the maximum size of a subset where every pair is divisible,\n    using the pairwise boolean matrix and a dynamic programming approach for chains.\n    \"\"\"\n    if not elements:\n        return 0\n\n    n = len(elements)\n    \n    # Create tuples (Element, original_index) and sort by value.\n    # The DP array will be based on this sorted list.\n    indexed_elements = sorted([(e.value, i, e) for i, e in enumerate(elements)])\n    \n    dp = [1] * n  # dp[k] stores the length of the longest divisible subset ending with indexed_elements[k]\n    max_size = 0 if n == 0 else 1\n\n    for i in range(n):\n        current_value, original_current_idx, current_element = indexed_elements[i]\n        \n        for j in range(i):\n            previous_value, original_previous_idx, previous_element = indexed_elements[j]\n\n            # Check for direct divisibility: previous_element divides current_element\n            # and verify this relationship from the precomputed matrix using original indices.\n            # The matrix check `divisible_matrix[original_current_idx][original_previous_idx]`\n            # ensures that Element(current_value) and Element(previous_value) are a divisible pair.\n            # `current_value % previous_value == 0` ensures the \"chain\" property from smaller to larger.\n            if current_value % previous_value == 0 and \\\n               divisible_matrix[original_current_idx][original_previous_idx]:\n                dp[i] = max(dp[i], 1 + dp[j])\n        \n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/620", "solution": "class Number:\n    def __init__(self, value: int, id: int) -> None:\n        \"\"\"Initializes a Number with its value and a unique identifier.\"\"\"\n        self.value = value\n        self.id = id\n\n    def isDivisibleBy(self, other: 'Number') -> bool:\n        \"\"\"\n        Checks if self and other are pairwise divisible.\n        Handles zero divisors per BR7: (0,0) is divisible; (X,0) where X!=0 is not.\n        \"\"\"\n        if self.value == 0 and other.value == 0:\n            return True  # Conservative: (0,0) treated as divisible.\n        if other.value == 0:\n            return False # Cannot divide by zero if self.value is non-zero.\n        if self.value == 0:\n            return True  # Zero is divisible by any non-zero number.\n        \n        # Both are non-zero. Check standard pairwise divisibility.\n        return (abs(self.value) % abs(other.value) == 0) or \\\n               (abs(other.value) % abs(self.value) == 0)\n\n    def __repr__(self) -> str:\n        return f\"Number(value={self.value}, id={self.id})\"\nclass InputList:\n    def __init__(self, numbers: list[int]) -> None:\n        \"\"\"Stores the original list of numbers.\"\"\"\n        self.raw_numbers = numbers\n\n    def to_number_nodes(self) -> list[Number]:\n        \"\"\"Converts raw numbers to Number instances with unique IDs.\"\"\"\n        return [Number(value, i) for i, value in enumerate(self.raw_numbers)]\nclass DivisibilityGraph:\n    def __init__(self) -> None:\n        \"\"\"Initializes an empty graph with an adjacency list.\"\"\"\n        self.adj = {} # {node_id: set of neighbor node_ids}\n\n    def build(self, numbers: list[Number]) -> None:\n        \"\"\"Builds the graph based on pairwise divisibility of Number instances.\"\"\"\n        num_nodes = len(numbers)\n        for i in range(num_nodes):\n            self.adj[numbers[i].id] = set()\n        \n        for i in range(num_nodes):\n            for j in range(i + 1, num_nodes):\n                if numbers[i].isDivisibleBy(numbers[j]):\n                    self.adj[numbers[i].id].add(numbers[j].id)\n                    self.adj[numbers[j].id].add(numbers[i].id)\n\n    def neighbors(self, node_id: int) -> list[int]:\n        \"\"\"Returns the list of neighbors for a given node ID.\"\"\"\n        return list(self.adj.get(node_id, set()))\ndef compute_largest_subset(number_list: list[Number]) -> int:\n    \"\"\"\n    Computes the size of the largest pairwise-divisible subset using backtracking.\n    This exact algorithm finds the maximum clique in the divisibility graph.\n    \"\"\"\n    graph = DivisibilityGraph()\n    graph.build(number_list)\n    num_nodes = len(number_list)\n\n    if num_nodes == 0:\n        return 0\n\n    max_size = 0\n\n    # Recursive function to find the largest clique (maximum size)\n    # current_clique_nodes: List of Number.id currently in the clique\n    # potential_candidates_ids: Set of Number.id that can potentially be added\n    def find_largest_clique_recursive(current_clique_nodes: list[int], potential_candidates_ids: set[int]):\n        nonlocal max_size\n        # Update max_size with the current clique's size\n        max_size = max(max_size, len(current_clique_nodes))\n\n        # Pruning step: If adding all remaining candidates cannot beat current max_size,\n        # then this branch cannot yield a larger clique.\n        if len(current_clique_nodes) + len(potential_candidates_ids) <= max_size:\n            return\n\n        # Iterate over candidates. Convert to list and sort (e.g., reverse) for consistent iteration.\n        candidates_list = sorted(list(potential_candidates_ids), reverse=True)\n        \n        for node_id in candidates_list:\n            # Recursively call with `node_id` added to the current clique.\n            # New potential candidates are neighbors of `node_id` AND also in `potential_candidates_ids`.\n            new_potential_candidates_ids = potential_candidates_ids.intersection(graph.adj.get(node_id, set()))\n            \n            find_largest_clique_recursive(current_clique_nodes + [node_id], new_potential_candidates_ids)\n            \n            # Backtrack: remove `node_id` from potential_candidates_ids for future branches.\n            # This ensures that `node_id` is only considered once in any given path (either included or excluded).\n            potential_candidates_ids.remove(node_id)\n\n    # Initial call: Start with an empty clique and all node IDs as potential candidates.\n    initial_candidates = set(range(num_nodes))\n    find_largest_clique_recursive([], initial_candidates)\n\n    return max_size\ndef largest_subset(numbers):\n    \"\"\"\n    Public API: Computes the size of the largest pairwise-divisible subset from a list of integers.\n    Validates input and handles empty lists.\n    \"\"\"\n    validate_input(numbers)\n    if len(numbers) == 0:\n        return 0\n    input_list = InputList(numbers)\n    number_nodes = input_list.to_number_nodes()\n    size = compute_largest_subset(number_nodes)\n    return size"}
{"task_id": "Mbpp/623", "solution": "from typing import Iterable, List, Iterator, Union\nNumeric = Union[int, float]\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for parameter validation failures.\"\"\"\n    pass\nclass Validation:\n    \"\"\"Enforces parameter type rules and raises validation errors.\"\"\"\n\n    @staticmethod\n    def validate_numbers(numbers: Iterable[Numeric]) -> None:\n        \"\"\"Validates that 'numbers' is an iterable of numeric values.\"\"\"\n        if not isinstance(numbers, Iterable):\n            raise TypeError(\"Input 'numbers' must be an iterable.\")\n        \n        # Explicitly disallow string/bytes iterables if they contain non-numeric data,\n        # as they are commonly misused as number lists.\n        if isinstance(numbers, (str, bytes)):\n            raise TypeError(\"Input 'numbers' cannot be a string or bytes object for numeric processing.\")\n\n        for i, num in enumerate(numbers):\n            if not isinstance(num, Numeric):\n                raise ValidationError(f\"Element at index {i} ('{num}') must be an int or float, got {type(num).__name__}.\")\n\n    @staticmethod\n    def validate_exponent(n: int) -> None:\n        \"\"\"Validates that 'n' is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(f\"Input 'n' must be an integer, got {type(n).__name__}.\")\nclass NumberList:\n    \"\"\"Lightweight iterable wrapper around input numbers.\"\"\"\n    _numbers: List[Numeric]\n\n    def __init__(self, numbers: Iterable[Numeric]):\n        \"\"\"Initializes the NumberList with an iterable of numbers.\"\"\"\n        self._numbers = list(numbers)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list of numbers is empty.\"\"\"\n        return len(self._numbers) == 0\n\n    def get(self, index: int) -> Numeric:\n        \"\"\"Retrieves a numeric value by index.\"\"\"\n        return self._numbers[index]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._numbers)\n\n    def __iter__(self) -> Iterator[Numeric]:\n        \"\"\"Returns an iterator over the numeric values.\"\"\"\n        return iter(self._numbers)\nclass Number:\n    \"\"\"Encapsulates a numeric value and provides pow(n) behavior.\"\"\"\n    value: Numeric\n\n    def __init__(self, value: Numeric):\n        \"\"\"Initializes the Number with a numeric value.\"\"\"\n        self.value = value\n\n    def pow(self, n: int) -> Numeric:\n        \"\"\"Computes the n-th power of the encapsulated value.\"\"\"\n        return self.value ** n\nclass OutputList:\n    \"\"\"Accumulates computed results and materializes them as a native list.\"\"\"\n    _results: List[Numeric]\n\n    def __init__(self):\n        \"\"\"Initializes an empty list to store results.\"\"\"\n        self._results = []\n\n    def append(self, value: Numeric) -> None:\n        \"\"\"Appends a computed numeric value to the results list.\"\"\"\n        self._results.append(value)\n\n    def as_list(self) -> List[Numeric]:\n        \"\"\"Returns the accumulated results as a native Python list.\"\"\"\n        return self._results\nclass NthNumsFunction:\n    \"\"\"Orchestrates validation, computation, and result construction.\"\"\"\n\n    @staticmethod\n    def nth_nums(numbers: Iterable[Numeric], n: int) -> List[Numeric]:\n        \"\"\"\n        Validates inputs, computes element-wise exponentiation, and returns results.\n        Delegates tasks to Validation, NumberList, Number, and OutputList.\n        \"\"\"\n        Validation.validate_numbers(numbers)\n        Validation.validate_exponent(n)\n\n        number_list = NumberList(numbers)\n        if number_list.is_empty():\n            return []\n\n        output_list = OutputList()\n        for num_value in number_list:\n            number_obj = Number(num_value)\n            computed_value = number_obj.pow(n)\n            output_list.append(computed_value)\n\n        return output_list.as_list()\ndef nth_nums(numbers: Iterable[Numeric], n: int) -> List[Numeric]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Delegates to NthNumsFunction for detailed processing.\n    \"\"\"\n    return NthNumsFunction.nth_nums(numbers, n)"}
{"task_id": "Mbpp/623", "solution": "def _compute_power(x, n):\n    \"\"\"Computes x raised to the power of n.\"\"\"\n    return x ** n\ndef nth_nums(numbers, n):\n    \"\"\"\n    Computes the n-th power of each number in a list after validating inputs.\n    Returns a new list with results, preserving the input order.\n    \"\"\"\n    _validate_inputs(numbers, n)\n\n    if not numbers:\n        return []\n\n    result_list = []\n    for x in numbers:\n        result_list.append(_compute_power(x, n))\n    \n    return result_list"}
