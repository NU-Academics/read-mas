{"task_id": "Mbpp/261", "solution": "from typing import Tuple\nclass DivisionService:\n    \"\"\"Orchestrates validation and computation for element-wise division (stateless).\"\"\"\n\n    def division_elements(self, first: tuple, second: tuple) -> tuple:\n        \"\"\"Orchestrates validations and computation; returns result tuple.\"\"\"\n        self.validate_types(first, second)\n        self.validate_lengths(first, second)\n        self.check_zero_divisors(second)\n        computed_results = self.compute_element_wise_division(first, second)\n        # The design implies returning the raw tuple, not a wrapped DivisionResult object\n        # for the final public API return type.\n        return computed_results\n\n    def validate_types(self, first, second) -> None:\n        \"\"\"Raises TypeError if either input is not a tuple.\"\"\"\n        if not isinstance(first, tuple):\n            raise TypeError(\"First operand must be a tuple.\")\n        if not isinstance(second, tuple):\n            raise TypeError(\"Second operand must be a tuple.\")\n\n    def validate_lengths(self, first, second) -> None:\n        \"\"\"Raises ValueError if input tuples have different lengths.\"\"\"\n        if len(first) != len(second):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    def check_zero_divisors(self, second) -> None:\n        \"\"\"Raises ZeroDivisionError if any element in the second tuple equals zero.\"\"\"\n        if 0 in second:\n            raise ZeroDivisionError(\"Cannot divide by zero. Second tuple contains zero.\")\n\n    def compute_element_wise_division(self, first, second) -> tuple:\n        \"\"\"Computes element-wise division and returns the results as a tuple.\"\"\"\n        return tuple(first[i] / second[i] for i in range(len(first)))\ndef division_elements(first: tuple, second: tuple) -> tuple:\n    \"\"\"Public function. Delegates to DivisionService.division_elements and returns a tuple.\"\"\"\n    return DivisionService().division_elements(first, second)"}
