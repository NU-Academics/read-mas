{"task_id": "Mbpp/57", "solution": "from typing import List\nclass DigitList:\n    \"\"\"Encapsulates input list, with methods for validation and sorting.\"\"\"\n    def __init__(self, digits: list) -> None:\n        self.digits = digits\n\n    def validate(self) -> bool:\n        # Per CRITICAL REQUIREMENTS, validation checks and exceptions are omitted.\n        # The method exists to match the design's call structure.\n        return True\n\n    def to_sorted_desc(self) -> List[int]:\n        \"\"\"Returns the digits sorted in descending order, preserving multiplicity.\"\"\"\n        return sorted(self.digits, reverse=True)\nclass LargestNumber:\n    \"\"\"Constructs the integer result from sorted digits.\"\"\"\n    def __init__(self, digits_sorted_desc: list) -> None:\n        # Concatenate digits to a string, then convert to an integer.\n        self.value = int(\"\".join(str(d) for d in digits_sorted_desc))\n\n    def to_string(self) -> str:\n        \"\"\"Returns the string representation of the constructed number.\"\"\"\n        return str(self.value)\ndef find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Public API: Accepts a list of integers (digits) and returns the largest\n    integer formed by arranging those digits in descending order.\n    \"\"\"\n    dl = DigitList(digits)\n    dl.validate()\n    sorted_digits = dl.to_sorted_desc()\n    ln = LargestNumber(sorted_digits)\n    return ln.value"}
{"task_id": "Mbpp/59", "solution": "class Error(Exception):\n    \"\"\"\n    Represents validation or computation errors; propagates to caller.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass InputValidator:\n    \"\"\"\n    Validates that n is a 1-based positive integer.\n    \"\"\"\n    def validate(self, n) -> None:\n        \"\"\"\n        Validates input 'n' to be a 1-based positive integer.\n        Raises Error for invalid inputs.\n        \"\"\"\n        if not isinstance(n, int):\n            raise Error(\"n must be an integer\")\n        if n < 1:\n            raise Error(\"n must be >= 1\")\nclass OctagonalCalculator:\n    \"\"\"\n    Computes the nth octagonal number using the specified formula.\n    \"\"\"\n    def formula(self, n: int) -> int:\n        \"\"\"\n        Calculates the nth octagonal number using the formula 3*n*n - 2*n.\n        \"\"\"\n        return 3 * n * n - 2 * n\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Delegates to formula(n) to compute the octagonal number.\n        \"\"\"\n        return self.formula(n)\ndef is_octagonal(n) -> int:\n    \"\"\"\n    Public API: Validates input 'n' and returns the nth octagonal number.\n    Raises Error if 'n' is not a 1-based positive integer.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    \n    calc = OctagonalCalculator()\n    return calc.compute(n)"}
{"task_id": "Mbpp/61", "solution": "class InputString:\n    \"\"\"Represents the input string and its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def __repr__(self) -> str:\n        return f\"InputString(value='{self.value}', length={self.length})\"\nclass Substring:\n    \"\"\"Represents a contiguous substring with its metadata.\"\"\"\n    def __init__(self, value: str, start_index: int) -> None:\n        self.value = value\n        self.start_index = start_index\n        self.length = len(value)\n        self.digit_sum = 0 # Default value\n\n    def set_digit_sum(self, s: int) -> None:\n        \"\"\"Sets the computed digit sum for the substring.\"\"\"\n        self.digit_sum = s\n\n    def __repr__(self) -> str:\n        return (f\"Substring(value='{self.value}', start_index={self.start_index}, \"\n                f\"length={self.length}, digit_sum={self.digit_sum})\")\nclass SubstringGenerator:\n    \"\"\"Generates all contiguous substrings from an input string.\"\"\"\n    def generate(self, input_string: InputString) -> list[Substring]:\n        \"\"\"Generates a list of all contiguous substrings.\"\"\"\n        substrings: list[Substring] = []\n        n = input_string.length\n        for i in range(n):\n            for j in range(i, n):\n                substring_value = input_string.value[i : j + 1]\n                substrings.append(Substring(substring_value, i))\n        return substrings\nclass DigitSumCalculator:\n    \"\"\"Computes the sum of digits for a given substring.\"\"\"\n    def calculate(self, substring: Substring) -> int:\n        \"\"\"Calculates the digit sum and sets it on the substring.\"\"\"\n        current_sum = 0\n        for char_digit in substring.value:\n            current_sum += int(char_digit)\n        substring.set_digit_sum(current_sum)\n        return current_sum\nclass Comparator:\n    \"\"\"Determines if a substring's digit sum matches its length.\"\"\"\n    def matches(self, substring: Substring) -> bool:\n        \"\"\"Compares digit sum with substring length.\"\"\"\n        return substring.digit_sum == substring.length\nclass Counter:\n    \"\"\"Accumulates the total number of matches.\"\"\"\n    def __init__(self) -> None:\n        self.total = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the total count by one.\"\"\"\n        self.total += 1\n\n    def getTotal(self) -> int:\n        \"\"\"Returns the current total count.\"\"\"\n        return self.total\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts contiguous substrings where digit sum equals substring length.\n    Orchestrates substring generation, digit-sum calculation, comparison, and counting.\n    \"\"\"\n    input_string = InputString(s)\n    \n    substring_generator = SubstringGenerator()\n    digit_sum_calculator = DigitSumCalculator()\n    comparator = Comparator()\n    counter = Counter()\n\n    substrings = substring_generator.generate(input_string)\n\n    for sub in substrings:\n        digit_sum_calculator.calculate(sub) # This also sets sub.digit_sum\n        if comparator.matches(sub):\n            counter.increment()\n\n    return counter.getTotal()"}
{"task_id": "Mbpp/61", "solution": "from typing import List\ndef _to_digits(s: str) -> List[int]:\n    \"\"\"Converts a string of characters to a list of integer digits.\"\"\"\n    return [int(char) for char in s]\ndef _prefix_sums(digits: List[int]) -> List[int]:\n    \"\"\"Computes a prefix-sum array for a list of digits.\"\"\"\n    n = len(digits)\n    prefix_sum_array = [0] * (n + 1)\n    for i in range(n):\n        prefix_sum_array[i + 1] = prefix_sum_array[i] + digits[i]\n    return prefix_sum_array\ndef _count_by_prefix(digits: List[int]) -> int:\n    \"\"\"Counts substrings where digit-sum equals length using prefix sums.\"\"\"\n    n = len(digits)\n    prefix_sum_array = _prefix_sums(digits)\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            substring_sum = prefix_sum_array[j] - prefix_sum_array[i]\n            substring_length = j - i\n            if substring_sum == substring_length:\n                count += 1\n    return count\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts contiguous substrings in 's' where the sum of digits equals substring length.\n    Orchestrates digit conversion, prefix sum computation, and counting.\n    \"\"\"\n    digits = _to_digits(s)\n    return _count_by_prefix(digits)"}
