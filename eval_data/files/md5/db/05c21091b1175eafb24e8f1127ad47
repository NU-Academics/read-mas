{"task_id": "Mbpp/426", "solution": "from typing import List\nclass IntegerList:\n    \"\"\"A domain class representing a list of integers.\n    It provides basic list operations adhering to the domain model.\"\"\"\n    def __init__(self, items: List[int]) -> None:\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.items)\n\n    def get(self, index: int) -> int:\n        \"\"\"Retrieves an integer by its index.\"\"\"\n        return self.items[index]\n\n    def to_list(self) -> List[int]:\n        \"\"\"Converts the IntegerList back to a standard Python list.\"\"\"\n        return list(self.items)\nclass IntegerValue:\n    \"\"\"A domain class representing a single integer value.\n    It encapsulates the logic for determining if the value is odd.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the integer value is odd.\"\"\"\n        return self.value % 2 != 0\nclass FilterOddNumbersFunction:\n    \"\"\"Implements the core logic for filtering odd numbers.\n    It processes an IntegerList and returns a new IntegerList.\"\"\"\n    def filter(self, input_list: IntegerList) -> IntegerList:\n        \"\"\"Filters an IntegerList, returning a new IntegerList containing only odd numbers.\"\"\"\n        result_items: List[int] = []\n        for value in input_list.items:\n            integer_value = IntegerValue(value)\n            if integer_value.is_odd():\n                result_items.append(value)\n        return IntegerList(result_items)\ndef filter_oddnumbers(input_list: List[int]) -> List[int]:\n    \"\"\"Top-level function to filter odd numbers from a list of integers.\n    It uses domain objects to perform the filtering and returns a plain list.\"\"\"\n    domain_input = IntegerList(input_list)\n    filter_func = FilterOddNumbersFunction()\n    domain_result = filter_func.filter(domain_input)\n    return domain_result.to_list()"}
