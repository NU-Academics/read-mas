{"task_id": "Mbpp/172", "solution": "def _count_substring_std(s: str) -> int:\n    \"\"\"Internal helper. Counts occurrences of 'std' by starting index.\n    Iterates through the string to find non-overlapping matches.\n    \"\"\"\n    count = 0\n    sub = \"std\"\n    sub_len = len(sub)\n    str_len = len(s)\n\n    for i in range(str_len - sub_len + 1):\n        if s[i : i + sub_len] == sub:\n            count += 1\n    return count\ndef count_occurance(s: str) -> int:\n    \"\"\"Public API. Validates input and returns number of 'std' occurrences.\n    Orchestrates validation and counting logic.\n    \"\"\"\n    _validate_input(s)\n    return _count_substring_std(s)"}
{"task_id": "Mbpp/172", "solution": "class InputString:\n    \"\"\"Lightweight wrapper for input string with a length convenience.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\nclass CountResult:\n    \"\"\"Lightweight result holder for an integer count.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\nclass OccurrenceCounter:\n    \"\"\"Encapsulates the algorithm for counting exact, case-sensitive occurrences of 'std'.\"\"\"\n    def __init__(self):\n        self.pattern: str = \"std\"\n\n    def count_occurance(self, input: str) -> int:\n        \"\"\"Scans the input string left-to-right, counting non-overlapping occurrences of the pattern.\"\"\"\n        input_obj = InputString(input)\n        count = 0\n        i = 0\n        while i <= input_obj.length() - len(self.pattern):\n            if input[i : i + len(self.pattern)] == self.pattern:\n                count += 1\n                i += len(self.pattern)\n            else:\n                i += 1\n        return CountResult(count).count\ndef count_occurance(input: str) -> int:\n    \"\"\"Public API: counts exact, case-sensitive occurrences of 'std' in the input string.\"\"\"\n    counter = OccurrenceCounter()\n    return counter.count_occurance(input)"}
