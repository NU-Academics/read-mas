{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"Computes the product of array elements modulo n using iterative reduction.\n    Returns the remainder in the range 0..n-1.\n    \"\"\"\n    product = 1\n    for element in arr:\n        product = (product * element) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "class IntegerList:\n    \"\"\"A value object representing a list of integers.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        # Assumes input elements are already validated as a list of integers.\n        self._elements = list(elements)  # Creates a copy for internal use.\n        self._length = len(elements)\n\n    def sorted(self) -> 'IntegerList':\n        \"\"\"Returns a new IntegerList instance with elements sorted ascending.\"\"\"\n        return IntegerList(sorted(self._elements))\n\n    def has_duplicates(self) -> bool:\n        \"\"\"Checks if the list contains any duplicate elements.\"\"\"\n        return len(self._elements) != len(set(self._elements))\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return self._length\nclass Result:\n    \"\"\"A lightweight wrapper for a boolean outcome.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self._value = value\n\n    def as_bool(self) -> bool:\n        \"\"\"Returns the stored boolean value.\"\"\"\n        return self._value\ndef _compute_consecutive(sorted_elements: list[int]) -> bool:\n    \"\"\"\n    Determines if a sorted list of integers contains consecutive numbers.\n    Handles special cases for empty, single-element, and duplicate lists.\n    \"\"\"\n    n = len(sorted_elements)\n\n    if n == 0:\n        return False\n    if n == 1:\n        return True\n\n    # Check for duplicates, which would break consecutiveness.\n    for i in range(n - 1):\n        if sorted_elements[i] == sorted_elements[i+1]:\n            return False\n\n    # Check if each adjacent pair differs by exactly 1.\n    for i in range(n - 1):\n        if sorted_elements[i+1] - sorted_elements[i] != 1:\n            return False\n    \n    return True\ndef check_Consecutive(list_of_ints) -> bool:\n    \"\"\"\n    Checks if a list of integers contains consecutive numbers, handling duplicates and special cases.\n    Raises ValueError for invalid input types.\n    \"\"\"\n    _validate_list(list_of_ints)\n\n    integer_list = IntegerList(list_of_ints)\n    \n    # Obtain a new IntegerList instance with elements sorted ascending.\n    sorted_integer_list = integer_list.sorted()\n    \n    # Compute the consecutiveness based on the sorted elements.\n    result_bool = _compute_consecutive(sorted_integer_list._elements)\n    \n    # Wrap and unwrap the boolean result as specified by the design.\n    return Result(result_bool).as_bool()"}
