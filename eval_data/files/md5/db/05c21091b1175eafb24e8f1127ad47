{"task_id": "Mbpp/578", "solution": "from dataclasses import dataclass\nfrom typing import Any, List\nfrom typing import List, Any\nfrom typing import List, Any\nfrom src.validator import Validator\nfrom src.models import ListInput, ResultList, Element\nclass Validator:\n    \"\"\"Provides utility methods for validating input lists.\"\"\"\n    @staticmethod\n    def validate_equal_length(listA: List[Any], listB: List[Any], listC: List[Any]) -> bool:\n        \"\"\"Checks if three input lists have equal length.\"\"\"\n        return len(listA) == len(listB) == len(listC)\nclass InterleaveService:\n    \"\"\"Coordinates validation and interleaving of three equal-length lists.\"\"\"\n\n    def interleave_lists(self, listA: List[Any], listB: List[Any], listC: List[Any]) -> List[Any]:\n        \"\"\"Interleaves elements from three lists into a single flat list.\"\"\"\n        # The validation call is retained as per design.\n        # Raising ValueError is omitted due to \"CRITICAL REQUIREMENTS\" forbidding exceptions.\n        Validator.validate_equal_length(listA, listB, listC)\n\n        n = len(listA)\n        result = []\n        for i in range(n):\n            result.append(listA[i])\n            result.append(listB[i])\n            result.append(listC[i])\n        return result\ndef interleave_lists(listA: List[Any], listB: List[Any], listC: List[Any]) -> List[Any]:\n    \"\"\"Public entry point to interleave three lists.\"\"\"\n    service = InterleaveService()\n    return service.interleave_lists(listA, listB, listC)"}
{"task_id": "Mbpp/577", "solution": "from typing import Optional\nfrom .validator import InputValidator\nfrom .calculator import FactorialCalculator\nfrom .logger import Logger\nfrom last_digit_factorial import last_Digit_Factorial\nclass Logger:\n    \"\"\"\n    Optional logging component that records requests and results.\n    Default implementation writes to console and keeps an in-memory list.\n    \"\"\"\n    def __init__(self):\n        self.logs = []\n\n    def log_request(self, n: int) -> None:\n        \"\"\"Logs an incoming request with the input number n.\"\"\"\n        log_message = f\"Request: last_Digit_Factorial({n})\"\n        print(f\"[LOG] {log_message}\")\n        self.logs.append(log_message)\n\n    def log_result(self, last_digit: int) -> None:\n        \"\"\"Logs the computed result, the last digit.\"\"\"\n        log_message = f\"Result: {last_digit}\"\n        print(f\"[LOG] {log_message}\")\n        self.logs.append(log_message)\nclass InputValidator:\n    \"\"\"\n    Ensures input n is a non-negative integer.\n    Raises ValueError on invalid input.\n    \"\"\"\n    def validate_non_negative_integer(self, n: int) -> None:\n        \"\"\"\n        Validates if n is an integer and non-negative.\n        Raises ValueError if validation fails.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\nclass Result:\n    \"\"\"\n    Lightweight data holder for the computed last digit.\n    Maps to FACTORIAL_RESULT in SRS.\n    \"\"\"\n    def __init__(self, last_digit: int):\n        self.last_digit = last_digit\nclass FactorialCalculator:\n    \"\"\"\n    Computes the last digit of n! using domain rules (return 0 for n >= 5).\n    Produces a Result and optionally uses a Logger.\n    \"\"\"\n    def __init__(self, logger: Optional['Logger'] = None):\n        self._logger = logger\n        # Precomputed last digits of factorials for n = 0, 1, 2, 3, 4\n        # 0! = 1, 1! = 1, 2! = 2, 3! = 6, 4! = 24\n        self._small_factorials_last_digit = {\n            0: 1,\n            1: 1,\n            2: 2,\n            3: 6,\n            4: 4\n        }\n\n    def _compute_small_factorial_last_digit(self, n: int) -> int:\n        \"\"\"\n        Retrieves the last digit for n in {0, 1, 2, 3, 4} from precomputed values.\n        Validation ensures n is within this range when this is called.\n        \"\"\"\n        return self._small_factorials_last_digit[n]\n\n    def last_Digit_Factorial(self, n: int) -> Result:\n        \"\"\"\n        Computes the last digit of n! and wraps it in a Result object.\n        Returns 0 for n >= 5 as an optimization.\n        \"\"\"\n        if n >= 5:\n            computed_last_digit = 0\n        else:\n            computed_last_digit = self._compute_small_factorial_last_digit(n)\n        \n        return Result(computed_last_digit)\n_input_validator = InputValidator()\n_logger = Logger()\n_factorial_calculator = FactorialCalculator(logger=_logger)\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Computes the last digit of n!.\n    Validates input, applies optimization for n >= 5, and logs operations.\n    \"\"\"\n    # 1. Validate input\n    _input_validator.validate_non_negative_integer(n)\n    \n    # 2. Log request\n    _logger.log_request(n)\n    \n    # 3. Compute last digit via FactorialCalculator, which returns a Result object\n    result_obj = _factorial_calculator.last_Digit_Factorial(n)\n    last_digit = result_obj.last_digit # Extract the int from the Result object\n    \n    # 4. Log result\n    _logger.log_result(last_digit)\n    \n    # 5. Return the computed last digit (0..9)\n    return last_digit"}
{"task_id": "Mbpp/578", "solution": "from .interleaver import interleave_lists\nfrom typing import List, Any\nimport unittest\nfrom src.interleaver import interleave_lists\nfrom typing import List, Any\nclass InputList:\n    \"\"\"Lightweight read-only wrapper over a Python list.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self._elements = elements\n        self._length = len(elements)\n\n    def get(self, index: int) -> Any:\n        \"\"\"Retrieves an element by index.\"\"\"\n        return self._elements[index]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return self._length\nclass OutputList:\n    \"\"\"Holds appended element values in order.\"\"\"\n    def __init__(self) -> None:\n        self._elements: List[Any] = []\n\n    def append(self, elem: Any) -> None:\n        \"\"\"Appends an element to the list.\"\"\"\n        self._elements.append(elem)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns the accumulated elements as a standard Python list.\"\"\"\n        return self._elements\nclass Interleaver:\n    \"\"\"Encapsulates the interleaving algorithm.\"\"\"\n    @staticmethod\n    def interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n        \"\"\"\n        Interleaves three lists into a new flat list.\n        Assumes inputs are lists of equal length, validated by the public API.\n        \"\"\"\n        input_list1 = InputList(list1)\n        input_list2 = InputList(list2)\n        input_list3 = InputList(list3)\n\n        n = input_list1.length()\n\n        output_list = OutputList()\n\n        for i in range(n):\n            output_list.append(input_list1.get(i))\n            output_list.append(input_list2.get(i))\n            output_list.append(input_list3.get(i))\n\n        return output_list.to_list()\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"\n    Public API to interleave three lists of equal length.\n    Raises ValueError if lists have unequal length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"input lists must have equal length\")\n\n    return Interleaver.interleave_lists(list1, list2, list3)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"Computes the membership-based symmetric difference of two tuples.\n    Preserves ordering: unique elements from t1 followed by unique elements from t2.\n    \"\"\"\n    \n    common_elements = set(t1).intersection(set(t2))\n    \n    result = []\n    seen = set()\n\n    for item in t1:\n        if item not in common_elements and item not in seen:\n            result.append(item)\n            seen.add(item)\n    \n    for item in t2:\n        if item not in common_elements and item not in seen:\n            result.append(item)\n            seen.add(item)\n            \n    return tuple(result)"}
{"task_id": "Mbpp/580", "solution": "import abc\nfrom typing import List, Tuple as TypingTuple\nclass TupleElement(abc.ABC):\n    pass\nclass IntegerElement(TupleElement):\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the integer element's value is even.\"\"\"\n        return self.value % 2 == 0\n\n    def as_tuple(self) -> TypingTuple[int,]:\n        \"\"\"Returns the integer value wrapped in a single-element tuple.\"\"\"\n        return (self.value,)\nclass TupleContainer(TupleElement):\n    def __init__(self, elements: tuple) -> None:\n        self.elements: List[TupleElement] = []\n        for item in elements:\n            if isinstance(item, int):\n                self.elements.append(IntegerElement(item))\n            elif isinstance(item, tuple):\n                self.elements.append(TupleContainer(item))\n\n    def process(self) -> \"TupleContainer\":\n        \"\"\"Recursively processes elements, filtering odd integers and nested tuples.\"\"\"\n        processed_elements: List[TupleElement] = []\n        for element in self.elements:\n            if isinstance(element, IntegerElement):\n                if element.is_even():\n                    processed_elements.append(element)\n            elif isinstance(element, TupleContainer):\n                processed_nested_container = element.process()\n                processed_elements.append(processed_nested_container)\n        self.elements = processed_elements\n        return self\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Converts the container and its processed elements back into a tuple.\"\"\"\n        result_list = []\n        for element in self.elements:\n            if isinstance(element, IntegerElement):\n                result_list.append(element.value)\n            elif isinstance(element, TupleContainer):\n                result_list.append(element.as_tuple())\n        return tuple(result_list)\nclass ExtractEvenFunction:\n    def __init__(self, input_tuple: tuple) -> None:\n        self.input_tuple = input_tuple\n        self.output: tuple = () # Stores the result after processing.\n\n    def process(self) -> tuple:\n        \"\"\"Initiates the recursive processing and returns the final filtered tuple.\"\"\"\n        root_container = TupleContainer(self.input_tuple)\n        processed_root_container = root_container.process()\n        self.output = processed_root_container.as_tuple()\n        return self.output\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Removes odd integers from a tuple, including nested tuples, preserving structure.\"\"\"\n    return ExtractEvenFunction(input_tuple).process()"}
{"task_id": "Mbpp/580", "solution": "def _extract_even_recursive(t: tuple) -> tuple:\n    \"\"\"\n    Recursively processes a tuple to filter out odd integers.\n    It preserves the original order and tuple nesting for remaining elements.\n    \"\"\"\n    result_elements = []\n    for item in t:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result_elements.append(item)\n        elif isinstance(item, tuple):\n            sub_tuple_result = _extract_even_recursive(item)\n            result_elements.append(sub_tuple_result)\n    return tuple(result_elements)\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes odd integers from the input tuple and any nested tuples at arbitrary depth.\n    This function delegates the recursive processing to an internal helper.\n    \"\"\"\n    return _extract_even_recursive(input_tuple)"}
