{"task_id": "Mbpp/439", "solution": "class IntegerElement:\n    \"\"\"Domain object holding a single integer value and producing its standard decimal string.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_decimal_string(self) -> str:\n        \"\"\"Returns the canonical decimal string representation of the integer value.\"\"\"\n        return str(self.value)\nclass InputList:\n    \"\"\"Container for IntegerElement instances, preserving order.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        # Constructs IntegerElement instances in the same order as provided.\n        self.elements: list[IntegerElement] = [IntegerElement(e) for e in elements]\nclass ResultInteger:\n    \"\"\"Value object holding the final integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass MultipleToSingleFunction:\n    \"\"\"Orchestrates conversion from list[int] to concatenated int.\"\"\"\n\n    def multiple_to_single(self, parts: list[int]) -> int:\n        \"\"\"Accepts a list of integers and returns the concatenated integer.\"\"\"\n        input_list = InputList(parts)\n        string_parts = [element.to_decimal_string() for element in input_list.elements]\n        concatenated_string = self.concatenateParts(string_parts)\n        result_int = int(concatenated_string)\n        return ResultInteger(result_int).value\n\n    def concatenateParts(self, string_parts: list[str]) -> str:\n        \"\"\"Concatenates standard decimal string representations of parts in order.\"\"\"\n        return \"\".join(string_parts)\ndef multiple_to_single(parts: list[int]) -> int:\n    \"\"\"Converts a list of integers into a single concatenated integer.\"\"\"\n    service = MultipleToSingleFunction()\n    return service.multiple_to_single(parts)"}
{"task_id": "Mbpp/441", "solution": "from surfacearea.validator import NumericValidator\nfrom surfacearea.cube import Cube, Result\nclass SurfaceAreaFunction:\n    \"\"\"\n    Orchestrates the computation of a cube's surface area.\n    Handles input validation and delegates to the Cube domain model.\n    \"\"\"\n    def surfacearea_cube(self, size) -> float:\n        \"\"\"\n        Computes the surface area of a cube after validating its side length.\n        Raises TypeError if the input 'size' is not numeric.\n        \"\"\"\n        if not NumericValidator.is_numeric(size):\n            raise TypeError(\"Side length 'size' must be a numeric value (int or float).\")\n\n        cube = Cube(size)\n        surface_area_value = cube.compute_surface_area()\n        _ = Result(surface_area_value) # Result is produced per design.\n        return surface_area_value\ndef surfacearea_cube(size) -> float:\n    \"\"\"\n    Public API entry point to calculate a cube's surface area.\n    Delegates the core logic to the SurfaceAreaFunction class.\n    \"\"\"\n    orchestrator = SurfaceAreaFunction()\n    return orchestrator.surfacearea_cube(size)"}
{"task_id": "Mbpp/439", "solution": "from .multiple_to_single import multiple_to_single\nfrom typing import List\nfrom .domain import IntegerList, IntegerElement\nfrom .input_validator import InputValidator\nfrom .concatenation_process import ConcatenationProcess\nfrom .converter import Converter\nfrom typing import List\nfrom typing import Any, List\nfrom typing import List\ndef multiple_to_single(input: List[int]) -> int:\n    \"\"\"\n    Validates a list of integers, concatenates their decimal representations,\n    and converts the resulting string to an integer.\n    \"\"\"\n    # Initialize components for orchestration.\n    validator = InputValidator()\n    concatenator = ConcatenationProcess()\n    converter = Converter()\n\n    # 1. Validate input (actual checks are omitted per CRITICAL REQUIREMENTS).\n    validator.validateList(input)\n    validator.validateElementsAreIntegers(input)\n\n    # 2. Build IntegerList and prepare decimal strings from elements.\n    integer_list_obj = IntegerList(input)\n    decimal_strings = []\n    for i, val in enumerate(integer_list_obj.elements):\n        element = IntegerElement(val, i)\n        decimal_strings.append(element.toDecimalString())\n\n    # 3. Concatenate decimal strings into a single string.\n    concatenated_string = concatenator.concatenate(decimal_strings)\n\n    # 4. Convert the concatenated string to an integer and return it.\n    return converter.stringToInteger(concatenated_string)\nclass IntegerElement:\n    \"\"\"Wraps an integer value and provides its decimal string representation.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def toDecimalString(self) -> str:\n        \"\"\"Converts the integer value to its decimal string form.\"\"\"\n        return str(self.value)\nclass IntegerList:\n    \"\"\"Holds a list of integer elements and provides basic list operations.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\nclass InputValidator:\n    \"\"\"Provides methods to validate input structure and element types.\"\"\"\n    def validateList(self, input_data: Any) -> bool:\n        \"\"\"Checks if the input is a list, returning True without actual validation per CRITICAL REQUIREMENTS.\"\"\"\n        # Per CRITICAL REQUIREMENTS: \"Do NOT add isinstance() checks... Trust the caller's inputs\".\n        # This method assumes valid input and always returns True.\n        return True\n\n    def validateElementsAreIntegers(self, input_list: List[Any]) -> bool:\n        \"\"\"Checks if all elements are integers, returning True without actual validation per CRITICAL REQUIREMENTS.\"\"\"\n        # Per CRITICAL REQUIREMENTS: \"Do NOT add isinstance() checks... Trust the caller's inputs\".\n        # This method assumes valid input and always returns True.\n        return True\nclass ConcatenationProcess:\n    \"\"\"Concatenates a list of strings into a single string without separators.\"\"\"\n    def concatenate(self, strings: List[str]) -> str:\n        \"\"\"Joins the list of strings into one contiguous string.\"\"\"\n        return \"\".join(strings)\nclass Converter:\n    \"\"\"Converts a decimal string representation to an integer.\"\"\"\n    def stringToInteger(self, s: str) -> int:\n        \"\"\"Transforms a given string into an integer.\"\"\"\n        return int(s)"}
{"task_id": "Mbpp/440", "solution": "import string\nfrom typing import List, Tuple, Optional, Set\nclass Sentence:\n    \"\"\"Represents the input sentence and provides character access.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sentence.\"\"\"\n        return len(self.text)\n\n    def charAt(self, i: int) -> str:\n        \"\"\"Returns the character at the given index.\"\"\"\n        return self.text[i]\n\n    def substring(self, start: int, end: int) -> str:\n        \"\"\"Returns a substring from start (inclusive) to end (exclusive).\"\"\"\n        return self.text[start:end]\nclass Word:\n    \"\"\"Represents a token with original and stripped text, and indices.\"\"\"\n    def __init__(self, raw_text: str, start_index: int, end_index: int):\n        self.raw_text = raw_text\n        self.text = raw_text # Initially, stripped text is same as raw\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def stripAdjacentPunctuation(self, punctuation_chars: Optional[Set[str]] = None) -> None:\n        \"\"\"Strips punctuation from ends and adjusts indices accordingly.\"\"\"\n        # Implementation choice: Uses Python's string.punctuation set by default.\n        # Implementation choice: `str` methods are Unicode-aware for stripping.\n        if punctuation_chars is None:\n            punctuation_chars = set(string.punctuation)\n\n        current_text = self.raw_text\n        current_start = self.start_index\n        current_end = self.end_index\n\n        # Strip from the beginning\n        while current_text and current_text[0] in punctuation_chars:\n            current_text = current_text[1:]\n            current_start += 1\n\n        # Strip from the end\n        while current_text and current_text[-1] in punctuation_chars:\n            current_text = current_text[:-1]\n            current_end -= 1\n\n        self.text = current_text\n        self.start_index = current_start\n        self.end_index = current_end\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the stripped text.\"\"\"\n        return len(self.text)\nclass Tokenizer:\n    \"\"\"Splits a Sentence into Word tokens while preserving original indices.\"\"\"\n    def __init__(self, preserve_indices: bool = True):\n        self.preserve_indices = preserve_indices\n\n    def tokenize(self, sentence: Sentence) -> List[Word]:\n        \"\"\"Tokenizes the sentence into a list of Word objects.\"\"\"\n        words: List[Word] = []\n        current_search_index = 0\n        text = sentence.text\n        \n        # Splits by whitespace, handling contiguous punctuation as part of raw_text.\n        for token_str in text.split():\n            start = text.find(token_str, current_search_index)\n            # The .find() method handles cases where tokens might appear multiple times correctly\n            # by searching from the last found position.\n            end = start + len(token_str)\n            words.append(Word(raw_text=token_str, start_index=start, end_index=end))\n            current_search_index = end\n        \n        return words\nclass AdverbDetector:\n    \"\"\"Detects if a given Word is an adverb based on suffix and alphabetic check.\"\"\"\n    ADVERB_SUFFIX: str = \"ly\"\n\n    def __init__(self):\n        pass\n\n    def isAdverb(self, word: Word) -> bool:\n        \"\"\"Checks if the word's stripped text qualifies as an adverb.\"\"\"\n        # Implementation choice: `str.isalpha()` for alphabetic check, which is Unicode-aware.\n        stripped_text = word.text\n        if not stripped_text:\n            return False\n        \n        if not stripped_text.lower().endswith(self.ADVERB_SUFFIX):\n            return False\n            \n        # The entire stripped_text must be alphabetic to qualify.\n        return stripped_text.isalpha()\ndef find_adverb_position(sentence_str: str) -> Tuple[int, int, str]:\n    \"\"\"\n    Coordinates tokenization and adverb detection to find the first adverb.\n    If no adverb is found, it returns (-1, -1, \"\") as an implementation choice for unspecified behavior.\n    \"\"\"\n    sentence = Sentence(sentence_str)\n    tokenizer = Tokenizer()\n    adverb_detector = AdverbDetector()\n\n    words = tokenizer.tokenize(sentence)\n\n    for word in words:\n        word.stripAdjacentPunctuation()\n        if adverb_detector.isAdverb(word):\n            # Found the first adverb, create and return the result tuple.\n            return (word.start_index, word.end_index, word.text)\n\n    # If no adverb is found after checking all words.\n    return (-1, -1, \"\")"}
{"task_id": "Mbpp/440", "solution": "import string\nfrom typing import Optional, Tuple, List\nclass Sentence:\n    \"\"\"Represents a sentence with its original text.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sentence text.\"\"\"\n        return len(self.text)\nclass Token:\n    \"\"\"Holds raw and stripped token data with original indices.\"\"\"\n    def __init__(self, raw: str, raw_start_index: int, raw_end_index: int):\n        self.raw = raw\n        self.raw_start_index = raw_start_index\n        self.raw_end_index = raw_end_index\n        self.stripped: str = \"\" # Populated after stripping punctuation\nclass AdverbFinder:\n    \"\"\"Service for finding adverbs in sentences based on defined rules.\"\"\"\n\n    def find_adverb_position(self, sentence_obj: Sentence) -> Optional[Tuple[int, int, str]]:\n        \"\"\"Finds the first adverb in a Sentence object and its position.\"\"\"\n        tokens = self.tokenize(sentence_obj.text)\n        for token in tokens:\n            stripped_token = self.strip_punctuation(token.raw)\n            token.stripped = stripped_token\n            if self.is_adverb(stripped_token):\n                start_index, end_index = self.compute_indices(\n                    token.raw_start_index, token.raw, stripped_token\n                )\n                return (start_index, end_index, stripped_token)\n        return None\n\n    def tokenize(self, text: str) -> List[Token]:\n        \"\"\"Tokenizes text by whitespace, preserving raw token spans.\"\"\"\n        tokens: List[Token] = []\n        current_index = 0\n        while current_index < len(text):\n            while current_index < len(text) and text[current_index].isspace():\n                current_index += 1\n            if current_index >= len(text):\n                break\n\n            token_start = current_index\n            while current_index < len(text) and not text[current_index].isspace():\n                current_index += 1\n            token_end = current_index\n\n            raw_token = text[token_start:token_end]\n            tokens.append(Token(raw=raw_token, raw_start_index=token_start, raw_end_index=token_end))\n        return tokens\n\n    def strip_punctuation(self, token_str: str) -> str:\n        \"\"\"Removes leading and trailing punctuation from a token string.\"\"\"\n        start = 0\n        end = len(token_str)\n        while start < end and token_str[start] in string.punctuation:\n            start += 1\n        while end > start and token_str[end - 1] in string.punctuation:\n            end -= 1\n        return token_str[start:end]\n\n    def is_adverb(self, stripped_token: str) -> bool:\n        \"\"\"Checks if a stripped token ends with 'ly' case-insensitively.\"\"\"\n        return stripped_token.lower().endswith(\"ly\")\n\n    def compute_indices(self, raw_token_start_index: int, token_raw: str, stripped: str) -> Tuple[int, int]:\n        \"\"\"Computes start and end indices for the stripped adverb relative to its raw token's position.\"\"\"\n        leading_punctuation_count = 0\n        for char in token_raw:\n            if char in string.punctuation:\n                leading_punctuation_count += 1\n            else:\n                break\n\n        start_index = raw_token_start_index + leading_punctuation_count\n        end_index = start_index + len(stripped)\n        return (start_index, end_index)\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"Locates the first adverb in a sentence and returns its start index, end index, and stripped text.\"\"\"\n    sentence_obj = Sentence(sentence)\n    finder = AdverbFinder()\n    return finder.find_adverb_position(sentence_obj)"}
