{"task_id": "Mbpp/84", "solution": "from src.cache import Cache\nimport pytest\nfrom src.sequence import sequence, Error\nclass Cache:\n    \"\"\"In-memory cache for memoization, storing integer results by index.\"\"\"\n    def __init__(self) -> None:\n        self.entries: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a cached value for index n.\"\"\"\n        return self.entries.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a computed value for index n in the cache.\"\"\"\n        self.entries[n] = value\nclass Error(Exception):\n    \"\"\"Domain-specific exception for validation failures in sequence computation.\"\"\"\n    def __init__(self, message: str, type: str = 'ValidationError') -> None:\n        super().__init__(message)\n        self.message = message\n        self.type = type\nclass Result:\n    \"\"\"Container for the computed integer value of a sequence term.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\nclass SequenceFunction:\n    \"\"\"Encapsulates validation and computation logic for the Newman\u2013Conway sequence.\"\"\"\n    _cache: Cache | None\n\n    def __init__(self, cache: Cache | None = None) -> None:\n        # Ensures a cache instance is always available for memoization.\n        self._cache = cache if cache is not None else Cache() \n\n    def validateInput(self, n: int) -> None:\n        \"\"\"Validates that n is a positive 1-based integer, raising an Error if invalid.\"\"\"\n        if not isinstance(n, int):\n            raise Error(f\"Input must be an integer, but received type {type(n).__name__}\", \"TypeError\")\n        if n < 1:\n            raise Error(\"Input must be a positive 1-based integer (n >= 1).\", \"ValueError\")\n\n    def computeRecursive(self, n: int) -> int:\n        \"\"\"Recursively computes the nth Newman\u2013Conway sequence value, utilizing memoization.\"\"\"\n        if self._cache and (cached_value := self._cache.get(n)) is not None:\n            return cached_value\n\n        if n == 1 or n == 2:\n            value = 1\n        else:\n            # Recurrence: a(n) = a(a(n-1)) + a(n - a(n-1)) for n > 2.\n            a_n_minus_1 = self.computeRecursive(n - 1)\n            term1 = self.computeRecursive(a_n_minus_1)\n            term2 = self.computeRecursive(n - a_n_minus_1)\n            value = term1 + term2\n        \n        if self._cache:\n            self._cache.set(n, value)\n        \n        return value\n\n    def sequence(self, n: int) -> int:\n        \"\"\"Public API method to compute the nth Newman\u2013Conway sequence value after validation.\"\"\"\n        self.validateInput(n)\n        computed_value = self.computeRecursive(n)\n        return Result(computed_value).value\n_sequence_calculator = SequenceFunction(cache=Cache())\ndef sequence(n: int) -> int:\n    \"\"\"\n    Returns the nth Newman\u2013Conway sequence value (1-based index).\n    This function acts as a facade, delegating to an internal SequenceFunction instance.\n    \"\"\"\n    return _sequence_calculator.sequence(n)"}
