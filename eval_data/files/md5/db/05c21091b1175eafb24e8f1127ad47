{"task_id": "Mbpp/468", "solution": "from typing import List\nclass Subsequence:\n    \"\"\"Encapsulates contiguous subsequence metadata.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, elements: List[float]):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the subsequence.\"\"\"\n        return len(self.elements)\nclass MaxProductService:\n    \"\"\"Orchestrates finding strictly increasing contiguous subsequences and computing products.\"\"\"\n\n    def max_product(self, numbers: List[float]) -> float:\n        \"\"\"Delegates to find and compute products, then returns the maximum.\"\"\"\n        subsequences = self._find_increasing_subarrays(numbers)\n        \n        products: List[float] = []\n        for sub in subsequences:\n            products.append(self._compute_product(sub))\n\n        # Return 0.0 if no valid subsequences or input array is empty.\n        if not products:\n            return 0.0\n        \n        return max(products)\n\n    def _find_increasing_subarrays(self, numbers: List[float]) -> List[Subsequence]:\n        \"\"\"Scans numbers and detects contiguous strictly increasing runs.\"\"\"\n        subsequences: List[Subsequence] = []\n        n = len(numbers)\n        if n == 0:\n            return []\n\n        start_index = 0\n        for i in range(1, n):\n            if numbers[i] <= numbers[i - 1]:\n                # Current increasing run ends at i-1; add it if it's a valid run.\n                if i - 1 >= start_index:\n                    elements = numbers[start_index:i]\n                    subsequences.append(Subsequence(start_index, i - 1, elements))\n                start_index = i # Start a new potential run from current index.\n        \n        # Add the last increasing run if it exists.\n        if start_index < n:\n            elements = numbers[start_index:n]\n            subsequences.append(Subsequence(start_index, n - 1, elements))\n            \n        return subsequences\n\n    def _compute_product(self, sub: Subsequence) -> float:\n        \"\"\"Returns the product of elements within a subsequence.\"\"\"\n        if not sub.elements:\n            return 0.0\n        \n        product = 1.0\n        for element in sub.elements:\n            product *= element\n        return product\ndef max_product(numbers: List[float]) -> float:\n    \"\"\"Public entrypoint; delegates to MaxProductService to compute the maximum product.\"\"\"\n    service = MaxProductService()\n    return service.max_product(numbers)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Compute pairwise sums of neighboring numeric elements in input_tuple.\n    Returns empty tuple if input length < 2.\n    \"\"\"\n    n = len(input_tuple)\n    if n < 2:\n        return ()\n    \n    sums = []\n    for i in range(n - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n        \n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "from typing import List\nclass InputArray:\n    \"\"\"Encapsulates the input list of numbers.\n    Provides length and access to elements.\n    \"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self.elements: List[float] = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\nclass MaxProductCalculator:\n    \"\"\"Computes the maximum product among strictly increasing subsequences using dynamic programming.\"\"\"\n    def max_product(self, input_array: InputArray) -> float:\n        \"\"\"Calculates the maximum product of a strictly increasing subsequence.\"\"\"\n        elements = input_array.elements\n        n = input_array.length()\n\n        if n == 0:\n            return 0.0 # No strictly increasing subsequence, so no product.\n\n        # dp[i] stores the maximum product of an increasing subsequence ending at index i.\n        dp = [0.0] * n\n\n        for i in range(n):\n            dp[i] = elements[i]  # Initialize with single-element subsequence product.\n            for j in range(i):\n                if elements[j] < elements[i]:\n                    dp[i] = max(dp[i], dp[j] * elements[i])\n        \n        return max(dp) # Returns the maximum value found in the dp array.\ndef max_product(input_array) -> float:\n    \"\"\"\n    Computes the maximum product of a strictly increasing subsequence.\n    Normalizes input and delegates computation to MaxProductCalculator.\n    \"\"\"\n    normalized_elements = [float(x) for x in input_array]\n    \n    input_arr_obj = InputArray(normalized_elements)\n    calculator = MaxProductCalculator()\n    return calculator.max_product(input_arr_obj)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the pairwise sum of neighboring elements in a tuple.\n    Returns a new tuple where output[i] = input[i] + input[i+1].\"\"\"\n    \n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] + input_tuple[i+1])\n        \n    return tuple(result)"}
{"task_id": "Mbpp/471", "solution": "from typing import List\ndef _mod_reduce(value: int, n: int) -> int:\n    \"\"\"Computes value % n ensuring the result is in the canonical range [0, n-1].\"\"\"\n    return value % n\ndef _multiply_mod(a: int, b: int, n: int) -> int:\n    \"\"\"Computes (a * b) % n, applying modulo at each step to prevent overflow.\"\"\"\n    return (a * b) % n\ndef find_remainder(arr: List[int], n: int) -> int:\n    \"\"\"\n    Computes the product of all integers in arr modulo n.\n    Handles empty arrays, negative, and large integers as per design.\n    \"\"\"\n    # The design specifies raising ValueError for n <= 0 (BR-5).\n    # However, a critical generation requirement forbids raising exceptions for edge cases.\n    # Therefore, this implementation assumes n > 0, trusting the caller's inputs.\n\n    current_product_mod_n = 1\n\n    for x in arr:\n        # Reduce each element modulo n to handle negative/large values (BR-7)\n        x_mod_n = _mod_reduce(x, n)\n        # Apply modulo iteratively at each multiplication step (BR-3)\n        current_product_mod_n = _multiply_mod(current_product_mod_n, x_mod_n, n)\n\n    # For an empty array, current_product_mod_n remains 1 (BR-4).\n    # The result is already in the canonical range [0, n-1] (BR-6).\n    return current_product_mod_n"}
