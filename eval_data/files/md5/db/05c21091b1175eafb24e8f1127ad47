{"task_id": "Mbpp/128", "solution": "import typing\ndef _split_whitespace(text: str) -> typing.List[str]:\n    \"\"\"Splits a string by whitespace into a list of words.\n    Handles multiple spaces, tabs, and newlines.\n    \"\"\"\n    return text.split()\ndef long_words(n: int, words: typing.Union[str, typing.List[str]]) -> typing.List[str]:\n    \"\"\"Return list[str] of tokens whose len(token) > n.\n    Accepts words as list[str] or a single whitespace-delimited str.\n    \"\"\"\n    # InputWords: Normalize raw words input to list[str]\n    tokens: typing.List[str]\n    if isinstance(words, str):\n        tokens = _split_whitespace(words)\n    else: # If not a string, assume it's list[str] as per design.\n        tokens = words\n\n    # LengthFilter: Apply strictly-greater-than-n filter, preserving order.\n    filtered_tokens: typing.List[str] = []\n    for word in tokens:\n        if len(word) > n:\n            filtered_tokens.append(word)\n\n    # ResultList: The filtered_tokens list itself serves as the collector.\n    return filtered_tokens"}
{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Dict\ndef max_occurrences(items: List[Any]) -> Any:\n    \"\"\"\n    Returns the item with the maximum frequency in a list.\n    Ties are broken by returning the earliest-occurring item.\n    \"\"\"\n    counts: Dict[Any, int] = {}\n    first_seen_index: Dict[Any, int] = {}\n\n    for i, item in enumerate(items):\n        if item not in counts:\n            first_seen_index[item] = i\n        counts[item] = counts.get(item, 0) + 1\n\n    # If items is empty, counts will be empty. max() will then raise ValueError.\n    # This implicitly handles the empty list case as per design, without explicit raising.\n    max_count = max(counts.values())\n\n    max_items_candidates: List[Any] = []\n    for item, count in counts.items():\n        if count == max_count:\n            max_items_candidates.append(item)\n\n    selected_item: Any = None\n    min_first_seen_idx: int = float('inf')\n\n    for item in max_items_candidates:\n        if first_seen_index[item] < min_first_seen_idx:\n            min_first_seen_idx = first_seen_index[item]\n            selected_item = item\n            \n    return selected_item"}
{"task_id": "Mbpp/130", "solution": "from src.frequency_map import FrequencyMap\ndef max_occurrences(items: list) -> any:\n    \"\"\"Finds the item that occurs most frequently in the provided list.\n    Raises ValueError for empty input and applies first-encountered tie-breaking.\n    \"\"\"\n    if not items:\n        raise ValueError(\"items must be a non-empty list\")\n\n    freq_counter = FrequencyMap()\n    for item in items:\n        freq_counter.increment(item)\n\n    return freq_counter.get_max()"}
{"task_id": "Mbpp/129", "solution": "from .matrix import Matrix\nfrom .validator import Validator\nclass MagicSquareChecker:\n    \"\"\"\n    Determines if a given matrix is a magic square.\n    Coordinates validation and performs sum-equality checks.\n    \"\"\"\n    def __init__(self, validator: Validator | None = None) -> None:\n        self.validator = validator if validator is not None else Validator()\n\n    def is_magic(self, matrix: list[list[int]]) -> bool:\n        \"\"\"\n        Checks if the input matrix is a valid magic square.\n        Performs validation, computes target sum, and verifies all sums.\n        \"\"\"\n        m = Matrix(matrix)\n        \n        validation_result = self.validator.validate_all(m)\n        if not validation_result.valid:\n            return False\n        \n        target_sum = self._compute_target_sum(m)\n        \n        if not self._verify_rows(m, target_sum):\n            return False\n        \n        if not self._verify_columns(m, target_sum):\n            return False\n            \n        if not self._verify_diagonals(m, target_sum):\n            return False\n            \n        return True\n\n    def _compute_target_sum(self, m: Matrix) -> int:\n        \"\"\"Computes the target sum for rows, columns, and diagonals from the first row.\"\"\"\n        return sum(m.data[0])\n\n    def _verify_rows(self, m: Matrix, target: int) -> bool:\n        \"\"\"Verifies that all row sums equal the target sum.\"\"\"\n        for row in m.data:\n            if sum(row) != target:\n                return False\n        return True\n\n    def _verify_columns(self, m: Matrix, target: int) -> bool:\n        \"\"\"Verifies that all column sums equal the target sum.\"\"\"\n        n = m.size()\n        col_sums = [0] * n\n        for row_idx in range(n):\n            for col_idx in range(n):\n                col_sums[col_idx] += m.data[row_idx][col_idx]\n        \n        for col_sum in col_sums:\n            if col_sum != target:\n                return False\n        return True\n\n    def _verify_diagonals(self, m: Matrix, target: int) -> bool:\n        \"\"\"Verifies that both main diagonal sums equal the target sum.\"\"\"\n        n = m.size()\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        \n        for i in range(n):\n            main_diag_sum += m.data[i][i]\n            anti_diag_sum += m.data[i][n - 1 - i]\n            \n        return main_diag_sum == target and anti_diag_sum == target\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Public API function to determine if a matrix is a magic square.\n    This is a thin facade over the MagicSquareChecker logic.\n    \"\"\"\n    checker = MagicSquareChecker()\n    return checker.is_magic(matrix)"}
{"task_id": "Mbpp/129", "solution": "from src.matrix import Matrix\nfrom src.matrix import Matrix\nfrom src.validator import Validator\nfrom src.sum_calculator import SumCalculator\nfrom src.matrix import Matrix\nfrom src.validation_result import ValidationResult\nclass Matrix:\n    \"\"\"Domain holder for Matrix representation used by other modules.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n        self.rows = len(elements)\n        # Calculate columns, handling cases where the matrix might be empty.\n        self.cols = len(elements[0]) if self.rows > 0 else 0\nclass Validator:\n    \"\"\"Provide validation routines for input shape and element types (FR2-FR4).\"\"\"\n    def is_non_empty(self, matrix: Matrix) -> bool:\n        \"\"\"Ensures matrix.elements is non-empty and shaped as a list of lists.\"\"\"\n        return matrix.rows > 0 and matrix.cols > 0\n\n    def is_square(self, matrix: Matrix) -> bool:\n        \"\"\"Ensures matrix.rows == matrix.cols.\"\"\"\n        return matrix.rows == matrix.cols\n\n    def elements_numeric(self, matrix: Matrix) -> bool:\n        \"\"\"Ensures every element is numeric. (Due to constraints, type checks are not performed.)\"\"\"\n        # CRITICAL REQUIREMENT: \"Do NOT add isinstance() checks\".\n        # This function therefore assumes elements are numeric as per \"Trust the caller's inputs\".\n        return True\nclass SumCalculator:\n    \"\"\"Compute sums required by magic-square checks (FR5-FR9).\"\"\"\n    def sum_first_row(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the sum of the first row of the matrix.\"\"\"\n        return sum(matrix.elements[0])\n\n    def row_sum(self, matrix: Matrix, rowIndex: int) -> int:\n        \"\"\"Calculates the sum of a specific row in the matrix.\"\"\"\n        return sum(matrix.elements[rowIndex])\n\n    def col_sum(self, matrix: Matrix, colIndex: int) -> int:\n        \"\"\"Calculates the sum of a specific column in the matrix.\"\"\"\n        return sum(matrix.elements[i][colIndex] for i in range(matrix.rows))\n\n    def main_diagonal_sum(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the sum of the main diagonal of the matrix.\"\"\"\n        return sum(matrix.elements[i][i] for i in range(matrix.rows))\n\n    def anti_diagonal_sum(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal of the matrix.\"\"\"\n        return sum(matrix.elements[i][matrix.cols - 1 - i] for i in range(matrix.rows))\nclass MagicSquareService:\n    \"\"\"Provides public API magic_square_test(matrix) and orchestrates Validator and SumCalculator (FR1, FR10).\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.sum_calculator = SumCalculator()\n\n    def magic_square_test(self, matrix_data) -> bool:\n        \"\"\"Orchestrates validation and sum checks for a magic square.\"\"\"\n        m = Matrix(matrix_data)\n\n        # 2. Run validations (FR2-FR4). Fail -> return False.\n        if not self.validator.is_non_empty(m):\n            return False\n        if not self.validator.is_square(m):\n            return False\n        if not self.validator.elements_numeric(m): # This check acts as a placeholder due to the \"no isinstance\" constraint.\n            return False\n\n        # 3. Compute target sum (FR5).\n        target_sum = self.sum_calculator.sum_first_row(m)\n\n        # 4. Verify each row sum (FR6).\n        for i in range(m.rows):\n            if self.sum_calculator.row_sum(m, i) != target_sum:\n                return False\n\n        # 5. Verify each column sum (FR7).\n        for j in range(m.cols):\n            if self.sum_calculator.col_sum(m, j) != target_sum:\n                return False\n\n        # 6. Verify main diagonal sum (FR8).\n        if self.sum_calculator.main_diagonal_sum(m) != target_sum:\n            return False\n\n        # 7. Verify anti-diagonal sum (FR9).\n        if self.sum_calculator.anti_diagonal_sum(m) != target_sum:\n            return False\n\n        # 8. All checks passed (FR10).\n        return True\ndef magic_square_test(matrix) -> bool:\n    \"\"\"Top-level API for determining if a matrix is a magic square.\"\"\"\n    service = MagicSquareService()\n    return service.magic_square_test(matrix)"}
