{"task_id": "Mbpp/555", "solution": "from typing import List\nclass NaturalNumberSequence:\n    \"\"\"Represents the first n natural numbers.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def generate(self) -> List[int]:\n        \"\"\"Generates the sequence of natural numbers from 1 to n.\"\"\"\n        return list(range(1, self.n + 1))\nclass SumCalculator:\n    \"\"\"Provides stateless computations for sums.\"\"\"\n    def sum_numbers(self, seq: NaturalNumberSequence) -> int:\n        \"\"\"Computes the sum of numbers in a sequence.\"\"\"\n        return sum(seq.generate())\n\n    def sum_cubes(self, seq: NaturalNumberSequence) -> int:\n        \"\"\"Computes the sum of cubes of numbers in a sequence.\"\"\"\n        return sum(i**3 for i in seq.generate())\nclass Result:\n    \"\"\"Container for an integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\ndef difference(n: int) -> int:\n    \"\"\"\n    Computes (sum_{i=1..n} i^3) - (sum_{i=1..n} i).\n    Validates n is a positive integer, raising ValueError if invalid.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    seq = NaturalNumberSequence(n)\n    calc = SumCalculator()\n\n    sum_cubes_val = calc.sum_cubes(seq)\n    sum_numbers_val = calc.sum_numbers(seq)\n\n    result = Result(sum_cubes_val - sum_numbers_val)\n    return result.value"}
{"task_id": "Mbpp/555", "solution": "# src/models.py\nclass NaturalNumber:\n    \"\"\"Represents a natural number and provides validation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the stored value is a positive integer (n >= 1).\"\"\"\n        return isinstance(self.value, int) and self.value >= 1\n\nclass SumComputation:\n    \"\"\"Computes sums of natural numbers and their cubes.\"\"\"\n    def sum_cubes(self, n: int) -> int:\n        \"\"\"Calculates the sum of cubes from 1 to n using Faulhaber's formula.\"\"\"\n        # Formula for sum of cubes: (n * (n + 1) / 2)^2\n        sum_of_n = n * (n + 1) // 2\n        return sum_of_n ** 2\n\n    def sum_n(self, n: int) -> int:\n        \"\"\"Calculates the sum of natural numbers from 1 to n.\"\"\"\n        # Formula for sum of n natural numbers: n * (n + 1) / 2\n        return n * (n + 1) // 2\n\nclass DifferenceFunction:\n    \"\"\"Orchestrates validation and computation to find the difference.\"\"\"\n    def __init__(self) -> None:\n        self._sum_comp = SumComputation()\n\n    def difference(self, n: int) -> int:\n        \"\"\"Computes the difference between sum of cubes and sum of numbers up to n.\"\"\"\n        natural_num = NaturalNumber(n)\n        if not natural_num.is_valid():\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n        sum_cubes_value = self._sum_comp.sum_cubes(n)\n        sum_n_value = self._sum_comp.sum_n(n)\n        return sum_cubes_value - sum_n_value"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"Counts pairs (i, j) with i<j<n whose XOR is odd among first n elements of arr.\n    Assumes valid input types and integer elements.\"\"\"\n\n    # Return 0 when n < 2, as no pairs can be formed.\n    if n < 2:\n        return 0\n\n    # Consider only the first min(n, len(arr)) elements.\n    effective_n = min(n, len(arr))\n\n    evens = 0\n    odds = 0\n\n    # Iterate up to the effective number of elements to count parities.\n    for i in range(effective_n):\n        if arr[i] % 2 == 0:\n            evens += 1\n        else:\n            odds += 1\n\n    # An XOR operation is odd if and only if its operands have different parities.\n    # The number of such pairs is the product of even and odd counts.\n    return evens * odds"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Inverts the case of alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged, preserving order and length.\n    \"\"\"\n    toggled_chars = []\n    for char in input:\n        if char.isalpha():\n            if char.isupper():\n                toggled_chars.append(char.lower())\n            else:\n                toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "from typing import List, Tuple\nclass ArrayInput:\n    \"\"\"Encapsulates input arr and n, validates, and slices elements.\"\"\"\n    def __init__(self, arr: List[int], n: int) -> None:\n        self._arr = arr\n        self._n = n\n\n    def validate(self) -> bool:\n        \"\"\"Validates n; returns False if n is negative.\"\"\"\n        return self._n >= 0\n\n    def slice_first_n(self) -> List[int]:\n        \"\"\"Returns the first n elements of the array.\"\"\"\n        return self._arr[:self._n]\nclass Element:\n    \"\"\"Wraps an integer and provides parity queries.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the element's value is even.\"\"\"\n        return self._value % 2 == 0\nclass OddPairCounter:\n    \"\"\"Computes odd/even counts and the number of odd XOR pairs.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self._elements = elements\n\n    def count_parities(self) -> Tuple[int, int]:\n        \"\"\"Counts odd and even elements.\"\"\"\n        odd_count = 0\n        even_count = 0\n        for element in self._elements:\n            if element.isOdd():\n                odd_count += 1\n            else:\n                even_count += 1\n        return odd_count, even_count\n\n    def count_odd_xor_pairs(self) -> int:\n        \"\"\"Calculates the number of pairs with an odd XOR sum.\"\"\"\n        odd_count, even_count = self.count_parities()\n        return odd_count * even_count\nclass Result:\n    \"\"\"Wrapper for the integer result with an accessor.\"\"\"\n    def __init__(self, count: int) -> None:\n        self._count = count\n\n    def as_int(self) -> int:\n        \"\"\"Returns the wrapped integer count.\"\"\"\n        return self._count\ndef find_Odd_Pair(arr: list, n: int) -> int:\n    \"\"\"Public API: computes the number of unordered pairs among arr[0:n] whose XOR is odd.\"\"\"\n    array_input = ArrayInput(arr, n)\n    array_input.validate() # Validation called as per design.\n\n    sliced_list = array_input.slice_first_n()\n    elements = [Element(value) for value in sliced_list]\n\n    counter = OddPairCounter(elements)\n    pair_count = counter.count_odd_xor_pairs()\n\n    result = Result(pair_count)\n    return result.as_int()"}
{"task_id": "Mbpp/557", "solution": "def to_upper_ascii(c: str) -> str:\n    \"\"\"Converts an ASCII lowercase letter to uppercase, otherwise returns unchanged.\"\"\"\n    if 'a' <= c <= 'z':\n        return chr(ord(c) - 32)\n    return c\ndef to_lower_ascii(c: str) -> str:\n    \"\"\"Converts an ASCII uppercase letter to lowercase, otherwise returns unchanged.\"\"\"\n    if 'A' <= c <= 'Z':\n        return chr(ord(c) + 32)\n    return c\ndef toggle_string(input: str) -> str:\n    \"\"\"Toggles the case of ASCII letters in a string, preserving other characters.\"\"\"\n    result_chars = []\n    for char in input:\n        if 'a' <= char <= 'z':\n            result_chars.append(to_upper_ascii(char))\n        elif 'A' <= char <= 'Z':\n            result_chars.append(to_lower_ascii(char))\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/558", "solution": "def _extract_digits(n: int) -> list[int]:\n    \"\"\"Return digits of n as a list of ints from least-significant to most-significant (LSB first).\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    while n > 0:\n        digits.append(n % 10)\n        n //= 10\n    return digits\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Compute sum of absolute differences between corresponding base-10 digits of a and b.\n    Right-aligned by least significant digit; missing higher-order digits are treated as zeros.\n    \"\"\"\n    digits_a = _extract_digits(a)\n    digits_b = _extract_digits(b)\n\n    total_distance = 0\n    max_len = max(len(digits_a), len(digits_b))\n\n    for i in range(max_len):\n        digit_a = digits_a[i] if i < len(digits_a) else 0\n        digit_b = digits_b[i] if i < len(digits_b) else 0\n        total_distance += abs(digit_a - digit_b)\n\n    return total_distance"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b):\n    \"\"\"Computes the sum of per-digit absolute differences between two integers.\n\n    Digits are aligned by place value, with the shorter number padded by leading zeros.\n    \"\"\"\n    # Normalize inputs by taking absolute values for digit extraction.\n    num_a = abs(a)\n    num_b = abs(b)\n\n    # Convert numbers to lists of digits, ordered from most significant to least significant.\n    # An input of 0 is correctly handled to yield [0].\n    digits_a = [int(d) for d in str(num_a)]\n    digits_b = [int(d) for d in str(num_b)]\n\n    # Determine the maximum length to ensure proper alignment.\n    max_len = max(len(digits_a), len(digits_b))\n\n    # Pad the shorter digit list(s) with leading zeros to match the maximum length.\n    digits_a = [0] * (max_len - len(digits_a)) + digits_a\n    digits_b = [0] * (max_len - len(digits_b)) + digits_b\n\n    # Calculate the sum of per-digit absolute differences.\n    total_distance = 0\n    for i in range(max_len):\n        total_distance += abs(digits_a[i] - digits_b[i])\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "class InvalidInputError(Exception):\n    \"\"\"\n    Explicit exception type for input validation errors.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InputArray:\n    \"\"\"\n    Represents the provided input array and performs input validation.\n    \"\"\"\n    def __init__(self, values: list, length: int) -> None:\n        self.values = values\n        self.length = length\n\n    def validate(self) -> None:\n        \"\"\"\n        Validates types and constraints of the input array and its length.\n        Raises InvalidInputError on validation failure.\n        \"\"\"\n        if not isinstance(self.values, list):\n            raise InvalidInputError(\"Input 'arr' must be a list.\")\n        if not isinstance(self.length, int):\n            raise InvalidInputError(\"Input 'n' must be an integer.\")\n        if self.length != len(self.values):\n            raise InvalidInputError(\"Input 'n' does not match the actual length of 'arr'.\")\n        if not self.values:  # Check for non-empty array\n            raise InvalidInputError(\"Input 'arr' must not be empty.\")\n        for i, val in enumerate(self.values):\n            if not isinstance(val, int):\n                raise InvalidInputError(f\"Element at index {i} ('{val}') must be an integer.\")\nclass MaxSubarrayService:\n    \"\"\"\n    Orchestrates validation and computes the maximum contiguous subarray sum using Kadane's algorithm.\n    \"\"\"\n    def computeKadane(self, arr: list) -> int:\n        \"\"\"\n        Deterministically computes the maximum contiguous subarray sum using Kadane's algorithm.\n        This variant correctly handles arrays where all elements are negative.\n        \"\"\"\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def max_sub_array_sum(self, arr: list, n: int) -> int:\n        \"\"\"\n        Orchestrates input validation via InputArray and computes the maximum contiguous subarray sum.\n        Returns the integer result, raising InvalidInputError on validation failure.\n        \"\"\"\n        input_array = InputArray(arr, n)\n        input_array.validate()\n\n        max_sum_value = self.computeKadane(arr)\n        # MaxSubarrayResult is used as a conceptual container, but only maxSum is returned.\n        # result_obj = MaxSubarrayResult(maxSum=max_sum_value)\n        return max_sum_value\ndef max_sub_array_sum(arr, n) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous subarray in the given list.\n    Delegates to MaxSubarrayService for robust validation and computation.\n    \"\"\"\n    service = MaxSubarrayService()\n    return service.max_sub_array_sum(arr, n)"}
{"task_id": "Mbpp/559", "solution": "from dataclasses import dataclass\nfrom typing import List\ndef max_sub_array_sum(arr: List[int], n: int) -> int:\n    \"\"\"\n    Computes the maximum sum of any contiguous sublist within the first n elements of arr.\n    For all-negative prefixes, it returns the single largest (least negative) element.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        element = arr[i]\n        current_max = max(element, current_max + element)\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "from typing import Tuple, List, Set\ndef _combine_elements(t1: Tuple, t2: Tuple) -> List:\n    \"\"\"\n    Combines elements from two tuples into a single list.\n    This helper function supports the main union operation.\n    \"\"\"\n    return list(t1) + list(t2)\ndef _unique_sorted(elements: List) -> Tuple:\n    \"\"\"\n    Removes duplicates and sorts elements in ascending order.\n    The final result is returned as a tuple.\n    \"\"\"\n    return tuple(sorted(set(elements)))\ndef union_elements(t1: Tuple, t2: Tuple) -> Tuple:\n    \"\"\"\n    Computes the set-union of two input tuples, removes duplicates, and sorts them.\n    The elements are returned in ascending order as a tuple.\n    \"\"\"\n    combined_elements = _combine_elements(t1, t2)\n    result_tuple = _unique_sorted(combined_elements)\n    return result_tuple"}
