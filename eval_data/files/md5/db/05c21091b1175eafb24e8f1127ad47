{"task_id": "Mbpp/252", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Tuple\ndef magnitude(real: float, imag: float) -> float:\n    \"\"\"Compute the magnitude (r) of a complex number.\"\"\"\n    return math.hypot(real, imag)\ndef angle(real: float, imag: float) -> float:\n    \"\"\"Compute the angle (theta) of a complex number in radians.\"\"\"\n    return math.atan2(imag, real)\ndef convert(input) -> Tuple[float, float]:\n    \"\"\"\n    Convert input (complex|int|float) to (r, theta) tuple of floats.\n    Normalizes input, computes magnitude and angle, then returns the polar coordinates.\n    \"\"\"\n    real_part: float\n    imag_part: float\n    input_type_str: str\n\n    if isinstance(input, complex):\n        real_part = float(input.real)\n        imag_part = float(input.imag)\n        input_type_str = 'complex'\n    elif isinstance(input, int):\n        real_part = float(input)\n        imag_part = 0.0\n        input_type_str = 'int'\n    elif isinstance(input, float):\n        real_part = float(input)\n        imag_part = 0.0\n        input_type_str = 'float'\n    else:\n        # As per design, let Python's default TypeError/AttributeError surface for unsupported types.\n        # This branch will raise an error if an unhandled type is passed.\n        raise TypeError(\"Input must be a complex, int, or float type.\")\n\n    # Construct ComplexInput value object internally as per design.\n    complex_input = ComplexInput(real=real_part, imag=imag_part, type=input_type_str)\n\n    # Compute r and theta using math utility functions.\n    r = magnitude(complex_input.real, complex_input.imag)\n    theta = angle(complex_input.real, complex_input.imag)\n\n    # Optionally construct PolarCoordinate internally, but return tuple as required.\n    # polar_coord = PolarCoordinate(r=r, theta=theta)\n\n    return (r, theta)"}
{"task_id": "Mbpp/255", "solution": "from typing import List, Tuple, Iterator, Optional, Set\nimport itertools\nclass InputParameters:\n    \"\"\"Container for input elements and length n.\"\"\"\n    def __init__(self, elements: List, n: int) -> None:\n        self.elements = elements\n        self.n = n\nclass ResultList:\n    \"\"\"Container for unique tuple combinations. Enforces uniqueness when adding.\"\"\"\n    def __init__(self, combinations: Optional[List[Tuple]] = None) -> None:\n        # Use a set for efficient uniqueness enforcement.\n        self._unique_combinations: Set[Tuple] = set(combinations if combinations is not None else [])\n\n    def add(self, combo: Tuple) -> None:\n        \"\"\"Adds a unique combination to the list.\"\"\"\n        self._unique_combinations.add(combo)\n\n    @property\n    def combinations(self) -> List[Tuple]:\n        \"\"\"Returns the list of unique combinations, sorted for deterministic output.\"\"\"\n        return sorted(list(self._unique_combinations))\nclass CombinationsGenerator:\n    \"\"\"Generates n-fold Cartesian product (combinations with repetition).\"\"\"\n    def __init__(self, elements: List, n: int) -> None:\n        self._elements = elements\n        self._n = n\n\n    def generate(self) -> Iterator[Tuple]:\n        \"\"\"Yields tuples representing combinations from the Cartesian product.\"\"\"\n        # itertools.product generates the Cartesian product, which implies combinations with repetition.\n        yield from itertools.product(self._elements, repeat=self._n)\ndef _assemble_tuples(product_iterable: Iterator[Tuple], n: int) -> List[Tuple]:\n    \"\"\"Converts product iterator entries to unique tuples of length n.\"\"\"\n    result_list = ResultList()\n    for item_tuple in product_iterable:\n        result_list.add(item_tuple)\n    return result_list.combinations\ndef combinations_colors(elements: List, n: int) -> List[Tuple]:\n    \"\"\"Generates all n-length combinations with repetition from the input elements.\n    Returns a list where each combination is a unique tuple of length n.\n    \"\"\"\n    params = InputParameters(elements, n)\n    _validate_inputs(params.elements, params.n)\n\n    gen = CombinationsGenerator(params.elements, params.n)\n    product_iterator = gen.generate()\n\n    final_combinations = _assemble_tuples(product_iterator, n)\n    return final_combinations"}
{"task_id": "Mbpp/255", "solution": "import itertools\ndef combinations_colors(items, n):\n    \"\"\"Generates all ordered combinations with repetition of length n from items.\n    Returns a list of tuples, each representing one combination.\n    \"\"\"\n    if n < 0:\n        return []\n    return [combo for combo in itertools.product(items, repeat=n)]"}
{"task_id": "Mbpp/252", "solution": "import math\nclass ComplexNumber:\n    def __init__(self, real: float, imag: float):\n        \"\"\"Initializes a ComplexNumber with real and imaginary parts.\"\"\"\n        self.real = float(real)\n        self.imag = float(imag)\nclass PolarCoordinates:\n    def __init__(self, r: float, theta: float):\n        \"\"\"Initializes PolarCoordinates with magnitude r and angle theta.\"\"\"\n        self.r = float(r)\n        self.theta = float(theta)\nclass MathUtils:\n    @staticmethod\n    def magnitude(c: ComplexNumber) -> float:\n        \"\"\"Calculates the magnitude (r) of a complex number.\"\"\"\n        return math.hypot(c.real, c.imag)\n\n    @staticmethod\n    def angle(c: ComplexNumber) -> float:\n        \"\"\"Calculates the angle (theta) of a complex number.\"\"\"\n        return math.atan2(c.imag, c.real)\nclass Converter:\n    @staticmethod\n    def _coerce_to_complex(value) -> ComplexNumber:\n        \"\"\"Coerces the input value to a ComplexNumber instance.\n        Relies on built-in complex() to handle type coercion and potential errors.\"\"\"\n        c_val = complex(value)\n        return ComplexNumber(c_val.real, c_val.imag)\n\n    @staticmethod\n    def _to_polar(cn: ComplexNumber) -> PolarCoordinates:\n        \"\"\"Computes polar coordinates from a ComplexNumber.\"\"\"\n        r = MathUtils.magnitude(cn)\n        theta = MathUtils.angle(cn)\n\n        # Enforce theta = 0.0 when r == 0 for deterministic output.\n        if r == 0:\n            theta = 0.0\n\n        return PolarCoordinates(r, theta)\n\n    @staticmethod\n    def convert(value) -> tuple[float, float]:\n        \"\"\"Converts an input value to polar coordinates (r, theta).\"\"\"\n        complex_num = Converter._coerce_to_complex(value)\n        polar_coords = Converter._to_polar(complex_num)\n        return (polar_coords.r, polar_coords.theta)\ndef convert(input) -> tuple[float, float]:\n    \"\"\"Converts a complex or numeric input to polar coordinates.\n    Raises TypeError if the input cannot be coerced to a complex number.\"\"\"\n    return Converter.convert(input)"}
{"task_id": "Mbpp/256", "solution": "from .models import InputNumber, Result\nfrom .prime_checker import PrimeChecker\ndef count_Primes_nums(n) -> int:\n    \"\"\"\n    Counts prime numbers strictly less than n.\n    Handles input validation and uses PrimeChecker for primality tests.\n    \"\"\"\n    input_num = InputNumber(n)\n\n    if not input_num.is_valid_number():\n        if not isinstance(n, (int, float)):\n            raise TypeError(f\"Input must be a number, got {type(n).__name__}\")\n        else: # This covers numeric but non-finite (NaN, inf)\n            raise ValueError(f\"Input number must be finite and not NaN, got {n}\")\n\n    if not input_num.is_non_negative():\n        raise ValueError(\"Input number must be non-negative.\")\n\n    limit = int(n)\n    prime_count = 0\n    checker = PrimeChecker()\n\n    # Iterate from 2 up to limit-1 to find primes\n    for k in range(2, limit):\n        if checker.is_prime(k):\n            prime_count += 1\n\n    result = Result(prime_count)\n    return result.count"}
