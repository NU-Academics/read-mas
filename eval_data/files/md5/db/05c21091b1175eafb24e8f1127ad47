{"task_id": "Mbpp/290", "solution": "from .max_length import max_length\nfrom typing import List, Tuple, Any\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the inner list with the maximum length and returns its length and the list itself.\n    If multiple lists share the maximum length, the first one encountered is returned.\n    \"\"\"\n    max_len: int = 0\n    result_list: List[Any] = []\n\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)\n        if current_len > max_len:\n            max_len = current_len\n            result_list = inner_list\n            \n    return (max_len, result_list)"}
{"task_id": "Mbpp/286", "solution": "def _kadane(seq: list[int]) -> int:\n    \"\"\"\n    Computes the maximum contiguous subarray sum for a given sequence.\n    Assumes `seq` is non-empty.\n    \"\"\"\n    current_max = seq[0]\n    global_max = seq[0]\n\n    for x in seq[1:]:\n        current_max = max(x, current_max + x)\n        global_max = max(global_max, current_max)\n\n    return global_max\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Computes the largest sum of a contiguous subarray in an array formed by \n    repeating `arr` exactly `k` times.\n    \"\"\"\n    if k == 0 or n == 0:\n        return 0\n\n    total_sum_arr = sum(arr)\n    max_single_sum = _kadane(arr)\n\n    if k == 1:\n        return max_single_sum\n\n    # For k >= 2, we consider wrap-around using a doubled array.\n    arr_double = arr + arr\n    max_double_sum = _kadane(arr_double)\n\n    wrap_candidate = max_double_sum\n    # If the original array's sum is positive and k > 2, we can add (k-2)\n    # full repetitions to potentially increase the sum.\n    if total_sum_arr > 0 and k > 2:\n        wrap_candidate += (k - 2) * total_sum_arr\n\n    # The result is the maximum of sum from a single repetition (for cases\n    # where all elements are negative) and the wrap-around candidate.\n    return max(max_single_sum, wrap_candidate)"}
