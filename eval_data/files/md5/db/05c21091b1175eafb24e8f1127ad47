{"task_id": "Mbpp/273", "solution": "from typing import Tuple, Sequence, Union\nclass Validator:\n    \"\"\"Validates input tuples for length equality and numeric elements.\"\"\"\n\n    def validateLengths(self, t1: Tuple[Union[int, float], ...], t2: Tuple[Union[int, float], ...]) -> bool:\n        \"\"\"Returns True if tuples have the same length, False otherwise.\"\"\"\n        return len(t1) == len(t2)\n\n    def validateNumericElements(self, t: Tuple[Union[int, float], ...]) -> bool:\n        \"\"\"Returns True if all elements are numeric (int or float), False otherwise.\"\"\"\n        for element in t:\n            if not isinstance(element, (int, float)):\n                return False\n        return True\ndef substract_elements(first: Tuple[Union[int, float], ...], second: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Performs element-wise subtraction of two input tuples after validating them.\n    Raises ValueError for length mismatch or non-numeric elements.\n    \"\"\"\n    validator = Validator()\n    \n    # Validate lengths\n    if not validator.validateLengths(first, second):\n        raise ValueError(\"Input tuples must have the same length.\")\n    \n    # Validate numeric elements\n    if not validator.validateNumericElements(first) or not validator.validateNumericElements(second):\n        raise ValueError(\"All elements must be numeric (int or float).\")\n    \n    # Compute element-wise differences\n    result_elements = [f - s for f, s in zip(first, second)]\n    \n    return tuple(result_elements)"}
{"task_id": "Mbpp/274", "solution": "import math\nclass Input:\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> bool:\n        # Checks n is an integer and n is positive (n >= 1).\n        return isinstance(self.n, int) and self.n >= 1\nclass BinomialCoefficient:\n    @staticmethod\n    def C(n: int, k: int) -> int:\n        # Returns the binomial coefficient C(n, k).\n        return math.comb(n, k)\nclass EvenIndexSum:\n    def __init__(self):\n        self._sum = 0\n\n    def compute(self, n: int) -> int:\n        # Computes the sum of C(n, k) for even k from 0 to n.\n        for k in range(n + 1):\n            if k % 2 == 0:\n                self._sum += BinomialCoefficient.C(n, k)\n        return self._sum\nclass Result:\n    def __init__(self, value: int):\n        # Holds the final computed integer result.\n        self.value = value\ndef even_binomial_Coeff_Sum(n):\n    \"\"\"Public API: validate n, compute sum of C(n,k) for even k and return int; raise ValueError on invalid input.\"\"\"\n    input_obj = Input(n)\n    if not input_obj.validate():\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    even_sum_calculator = EvenIndexSum()\n    computed_sum = even_sum_calculator.compute(n)\n    \n    result_obj = Result(computed_sum)\n    return result_obj.value"}
