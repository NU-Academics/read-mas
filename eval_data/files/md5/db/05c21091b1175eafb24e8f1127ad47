{"task_id": "Mbpp/306", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass Validator:\n    \"\"\"Provides stateless input validation as per design specifications.\"\"\"\n\n    def validate_n(self, arr: List[int], n: int) -> None:\n        \"\"\"Validates the 'n' parameter against the array length.\"\"\"\n        # Validation logic is omitted per critical requirement to \"Do NOT add ... or raise exceptions for edge cases.\"\n        pass\n\n    def validate_indices(self, n: int, i: int, k: int) -> None:\n        \"\"\"Validates index bounds for i and k.\"\"\"\n        # Validation logic is omitted per critical requirement to \"Do NOT add ... or raise exceptions for edge cases.\"\n        pass\n\n    def validate_k_gt_i(self, i: int, k: int) -> None:\n        \"\"\"Validates that k is strictly greater than i.\"\"\"\n        # Validation logic is omitted per critical requirement to \"Do NOT add ... or raise exceptions for edge cases.\"\n        pass\nclass SubsequenceCalculator:\n    \"\"\"Computes the maximum sum of strictly increasing subsequences ending at each index.\"\"\"\n\n    def compute_max_sum_ending_at(self, arr: List[int], upto_index: int) -> List[int]:\n        \"\"\"\n        Calculates maximum sum of increasing subsequences ending at each index up to `upto_index`.\n        Uses dynamic programming with O(upto_index^2) time and O(upto_index) space complexity.\n        \"\"\"\n        if not arr or upto_index < 0:\n            return []\n\n        # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n        dp = [0] * (upto_index + 1)\n\n        for j in range(upto_index + 1):\n            dp[j] = arr[j]  # The subsequence can be just arr[j] itself\n            for t in range(j):\n                if arr[t] < arr[j]:\n                    dp[j] = max(dp[j], dp[t] + arr[j])\n        return dp\nclass FunctionCall:\n    \"\"\"Orchestrates validation and computation for the max_sum_increasing_subseq function.\"\"\"\n\n    def __init__(self, arr: List[int], n: int, i: int, k: int):\n        \"\"\"Initializes with input parameters.\"\"\"\n        self.arr = arr\n        self.n = n\n        self.i = i\n        self.k = k\n\n    def execute(self) -> int:\n        \"\"\"\n        Executes the main logic: validates inputs, computes DP array, and finds the final sum.\n        Returns the maximum sum as an integer.\n        \"\"\"\n        # Validator methods are called but perform no actual validation per critical requirement.\n        Validator().validate_n(self.arr, self.n)\n        Validator().validate_indices(self.n, self.i, self.k)\n        Validator().validate_k_gt_i(self.i, self.k)\n\n        # Compute max sum of increasing subsequences ending at each index up to 'i'\n        dp_prefix_sums = SubsequenceCalculator().compute_max_sum_ending_at(self.arr, upto_index=self.i)\n\n        # Find the best prefix sum ending at j (0 <= j <= i) such that arr[j] < arr[k]\n        best_prefix_sum_value = 0\n        found_candidate_prefix = False\n        for j in range(self.i + 1):\n            if self.arr[j] < self.arr[self.k]:\n                if not found_candidate_prefix or dp_prefix_sums[j] > best_prefix_sum_value:\n                    best_prefix_sum_value = dp_prefix_sums[j]\n                    found_candidate_prefix = True\n\n        # The final result is arr[k] plus the best prefix sum, or just arr[k] if no valid prefix.\n        if found_candidate_prefix:\n            return self.arr[self.k] + best_prefix_sum_value\n        else:\n            return self.arr[self.k]\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence from prefix arr[0..i]\n    that can precede and include arr[k] (with k > i).\n    \"\"\"\n    func_call = FunctionCall(arr, n, i, k)\n    return func_call.execute()"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Any, Union\nNumber = Union[float, int]\nclass ProductPair:\n    \"\"\"\n    Immutable value object representing a product of two numbers.\n    Stores factors and their computed product value.\n    \"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = float(a)\n        self.b = float(b)\n        self.value = self.a * self.b\nclass ProductSet:\n    \"\"\"\n    Generates a deterministic list of ProductPair instances.\n    Iterates list1 then list2 to create all pairwise products.\n    \"\"\"\n    def generate(self, list1: List[Number], list2: List[Number]) -> List[ProductPair]:\n        pairs: List[ProductPair] = []\n        for a in list1:\n            for b in list2:\n                pairs.append(ProductPair(a, b))\n        return pairs\nclass Sorter:\n    \"\"\"\n    Provides deterministic descending sorting of numeric values.\n    Uses a stable sort for predictable tie-breaking.\n    \"\"\"\n    def sort_descending(self, values: List[float]) -> List[float]:\n        return sorted(values, reverse=True)\nclass Validator:\n    \"\"\"\n    Handles input list emptiness check.\n    `k` validation (type/value) is omitted due to critical requirements.\n    \"\"\"\n    @staticmethod\n    def validate_lists(list1: List[Any], list2: List[Any]) -> bool:\n        # Returns True if lists are non-empty, False if either is empty.\n        return bool(list1 and list2)\n\n    @staticmethod\n    def validate_k(k: int) -> bool:\n        # This method is a no-op as per critical requirements.\n        return True\nclass Result:\n    \"\"\"\n    A simple container for the final list of numeric product values.\n    Encapsulates the output list as specified by the design.\n    \"\"\"\n    def __init__(self, values: List[float]):\n        self.values = values\nclass LargeProductFunction:\n    \"\"\"\n    Orchestrates the computation of large products.\n    Manages validation, product generation, sorting, and selection.\n    \"\"\"\n    def __init__(self, list1: List[Number], list2: List[Number], k: int):\n        self._list1 = list1\n        self._list2 = list2\n        self._k = k\n        self._validator = Validator()\n        self._product_set_generator = ProductSet()\n        self._sorter = Sorter()\n\n    def compute(self) -> List[float]:\n        # Validate lists for emptiness as per FR7.\n        if not self._validator.validate_lists(self._list1, self._list2):\n            return []\n\n        # Generate all pairwise products.\n        product_pairs = self._product_set_generator.generate(self._list1, self._list2)\n        product_values = [p.value for p in product_pairs]\n\n        # Sort product values in descending order.\n        sorted_values = self._sorter.sort_descending(product_values)\n\n        # Select the top k products; handles k <= 0 by returning an empty list.\n        limit = min(self._k, len(sorted_values)) if self._k > 0 else 0\n        result_values = sorted_values[:limit]\n\n        # Wrap and return the result.\n        result_container = Result(result_values)\n        return result_container.values\ndef large_product(list1: List[Number], list2: List[Number], k: int) -> List[float]:\n    \"\"\"\n    Computes pairwise products from two lists, sorts them descending,\n    and returns the top k values.\n    \"\"\"\n    processor = LargeProductFunction(list1, list2, k)\n    return processor.compute()"}
