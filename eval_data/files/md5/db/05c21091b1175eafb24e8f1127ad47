{"task_id": "Mbpp/392", "solution": "_memo: dict[int, int] = {}\ndef _compute_recursive(n: int, memo: dict[int, int]) -> int:\n    \"\"\"Calculates f(n) = max(n, f(n/2) + f(n/3) + f(n/4) + f(n/5)) using floor division and memoization.\n    It handles the base case f(0)=0 and stores results in the provided memo.\n    \"\"\"\n    if n in memo:\n        return memo[n]\n\n    if n == 0:\n        return 0\n\n    # Calculate recursive terms using integer (floor) division\n    term1 = _compute_recursive(n // 2, memo)\n    term2 = _compute_recursive(n // 3, memo)\n    term3 = _compute_recursive(n // 4, memo)\n    term4 = _compute_recursive(n // 5, memo)\n\n    current_sum = term1 + term2 + term3 + term4\n    result = max(n, current_sum)\n    memo[n] = result\n    return result\ndef get_max_sum(n: int) -> int:\n    \"\"\"Computes the maximum sum f(n) for a non-negative integer n using a recurrence relation.\n    It serves as the public API, leveraging an internal helper with module-level memoization.\n    \"\"\"\n    return _compute_recursive(n, _memo)"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(input_tuple: tuple) -> bool:\n    \"\"\"Checks if all elements in the input tuple are distinct using equality comparisons.\n    The input tuple is not modified.\n    \"\"\"\n    n = len(input_tuple)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if input_tuple[i] == input_tuple[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/392", "solution": "from .error_handler import ErrorHandler\nfrom .input_validator import InputValidator\nfrom .memoization_cache import MemoizationCache\nfrom .result import Result\nfrom .max_sum_calculator import get_max_sum\nclass ErrorHandler:\n    \"\"\"Handles raising descriptive exceptions for invalid inputs.\"\"\"\n\n    def raiseInvalidInput(self, message: str) -> None:\n        \"\"\"Raises a ValueError for invalid input type.\"\"\"\n        raise ValueError(message)\n\n    def raiseNegativeInput(self, n: int) -> None:\n        \"\"\"Raises a ValueError for negative input.\"\"\"\n        raise ValueError(f\"Input n must be non-negative, but received {n}\")\nclass InputValidator:\n    \"\"\"Validates input n for type and non-negativity.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the InputValidator with an ErrorHandler.\"\"\"\n        self._error_handler = ErrorHandler()\n\n    def validate(self, n) -> None:\n        \"\"\"Validates if n is an integer and non-negative, raising errors if not.\"\"\"\n        if not self.isInteger(n):\n            self._error_handler.raiseInvalidInput(\"Input must be an integer.\")\n        if not self.isNonNegative(n):\n            self._error_handler.raiseNegativeInput(n)\n\n    def isInteger(self, n) -> bool:\n        \"\"\"Checks if the input is an integer.\"\"\"\n        return isinstance(n, int)\n\n    def isNonNegative(self, n: int) -> bool:\n        \"\"\"Checks if the integer input is non-negative.\"\"\"\n        return n >= 0\nclass MemoizationCache:\n    \"\"\"In-memory cache for storing computed f(n) values.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the cache map.\"\"\"\n        self._map: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a value from the cache by key n.\"\"\"\n        return self._map.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache with key n.\"\"\"\n        self._map[n] = value\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if the cache contains a value for key n.\"\"\"\n        return n in self._map\nclass Result:\n    \"\"\"Encapsulates a computed integer value.\"\"\"\n\n    def __init__(self, value: int):\n        \"\"\"Initializes the Result with an integer value.\"\"\"\n        self._value = value\n\n    def getValue(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\nclass MaxSumCalculator:\n    \"\"\"Validates input and computes f(n) using memoization.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the calculator with a cache and validator.\"\"\"\n        self._cache = MemoizationCache()\n        self._validator = InputValidator()\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"Public entry to compute max sum for n after validation.\"\"\"\n        self._validator.validate(n)\n        computed_value = self.compute(n)\n        return Result(computed_value).getValue()\n\n    def compute(self, n: int) -> int:\n        \"\"\"Recursively computes f(n) using memoization and floor division.\"\"\"\n        if self._cache.contains(n):\n            return self._cache.get(n)\n\n        if n == 0:\n            self._cache.set(0, 0)\n            return 0\n\n        s2 = self.compute(n // 2)\n        s3 = self.compute(n // 3)\n        s4 = self.compute(n // 4)\n        s5 = self.compute(n // 5)\n\n        computed_sum = s2 + s3 + s4 + s5\n        result = max(computed_sum, n)\n\n        self._cache.set(n, result)\n        return result\n_max_sum_calculator_instance = MaxSumCalculator()\ndef get_max_sum(n: int) -> int:\n    \"\"\"Calculates the maximum sum f(n) for a non-negative integer n.\"\"\"\n    return _max_sum_calculator_instance.get_max_sum(n)"}
