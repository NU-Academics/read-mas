{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list) -> list:\n    \"\"\"Sorts a list using the pancake sort algorithm in ascending order.\n    Returns a new list with elements sorted in non-decreasing order while preserving multiset properties.\"\"\"\n\n    # Create a mutable copy of the input list to perform sorting operations.\n    arr = list(input_list)\n    n = len(arr)\n\n    # Define a helper function to reverse a prefix of the array.\n    def _flip(sub_array, k):\n        \"\"\"Reverses the order of elements from index 0 to k (inclusive) in the given sub_array.\"\"\"\n        left = 0\n        while left < k:\n            sub_array[left], sub_array[k] = sub_array[k], sub_array[left]\n            left += 1\n            k -= 1\n\n    # Iterate from the end of the array, effectively sorting one element into place per iteration.\n    for curr_size in range(n, 1, -1):\n        # Find the index of the largest element in the unsorted part (arr[0...curr_size-1]).\n        max_idx = 0\n        for i in range(1, curr_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the largest element is not already at its correct position.\n        if max_idx != curr_size - 1:\n            # Move the largest element to the beginning of the unsorted segment.\n            _flip(arr, max_idx)\n\n            # Move the largest element from the beginning to its final sorted position.\n            _flip(arr, curr_size - 1)\n\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3) -> int:\n    \"\"\"Counts indices where elements are identical across three lists.\"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    counter = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            counter += 1\n    return counter"}
{"task_id": "Mbpp/142", "solution": "class Comparator:\n    \"\"\"Centralizes equality checks using Python's == operator.\"\"\"\n    def equal(self, a, b) -> bool:\n        \"\"\"Compares two elements for equality.\"\"\"\n        return a == b\nclass Counter:\n    \"\"\"Maintains an integer count with increment/get operations.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the counter to zero.\"\"\"\n        self._count = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the internal count by one.\"\"\"\n        self._count += 1\n\n    def get_count(self) -> int:\n        \"\"\"Returns the current count.\"\"\"\n        return self._count\ndef compute_min_length(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Computes the minimum length among three lists.\"\"\"\n    return min(len(list1), len(list2), len(list3))\ndef compare_and_count(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Compares elements position-wise and counts identical triplets.\"\"\"\n    min_length = compute_min_length(list1, list2, list3)\n    comparator = Comparator()\n    counter = Counter()\n\n    for i in range(min_length):\n        if (comparator.equal(list1[i], list2[i]) and\n            comparator.equal(list1[i], list3[i])):\n            counter.increment()\n    return counter.get_count()\ndef count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Counts positions where all three lists contain identical elements.\n    Validation is omitted due to critical requirements overriding the design specification.\"\"\"\n    # Collaborators (Comparator, Counter) and helper functions are defined inline.\n    return compare_and_count(list1, list2, list3)"}
