{"task_id": "Mbpp/267", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass OddNumberSequence:\n    \"\"\"Stateless generator for a sequence of odd natural numbers.\"\"\"\n    @staticmethod\n    def generate(n: int) -> List[int]:\n        \"\"\"Returns a list of the first n odd natural numbers.\"\"\"\n        return [2 * i - 1 for i in range(1, n + 1)]\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of the squares of the first n odd natural numbers.\n    Utilizes OddNumberSequence for generation and ComputationResult for the final value.\n    \"\"\"\n    odds = OddNumberSequence.generate(n)\n    squares = [x * x for x in odds]\n    total = sum(squares)\n    return ComputationResult(total).value"}
{"task_id": "Mbpp/268", "solution": "from dataclasses import dataclass\nclass StarNumberService:\n    \"\"\"\n    Service for calculating star numbers, including input validation.\n    It encapsulates the core logic for finding the nth star number.\n    \"\"\"\n    def find_star_num(self, n: int) -> int:\n        \"\"\"\n        Validates n and computes S(n) = 6*n*(n-1) + 1.\n        Raises TypeError for non-integer and ValueError for n < 1.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be int\")\n        if n < 1:\n            raise ValueError(\"n must be >= 1\")\n\n        # Compute S(n) using the formula\n        star_value = 6 * n * (n - 1) + 1\n        return star_value\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Module-level function to find the nth star number.\n    It acts as a fa\u00e7ade, delegating the call to StarNumberService.\n    \"\"\"\n    return StarNumberService().find_star_num(n)"}
{"task_id": "Mbpp/268", "solution": "class InputParameter:\n    \"\"\"Data holder and validator for input parameter n.\n    Ensures n is an integer and meets the 1-based index requirement.\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Raise TypeError if n is not an int; raise ValueError if n < 1.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if self.n < 1:\n            raise ValueError(\"Input 'n' must be a 1-based index (n >= 1).\")\nclass StarNumberCalculator:\n    \"\"\"Encapsulates computation logic for star numbers.\n    It computes the star number using the specified mathematical formula.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Compute and return the star number for given n.\n        Uses the formula: 6*n*(n-1)+1.\n        \"\"\"\n        value = 6 * n * (n - 1) + 1\n        return value\ndef find_star_num(n: int) -> int:\n    \"\"\"Public API: compute and return the nth star number as int per SRS.\n    This function orchestrates input validation and delegates computation.\n    \"\"\"\n    input_param = InputParameter(n)\n    input_param.validate()\n\n    calculator = StarNumberCalculator()\n    computed_value = calculator.compute(input_param.n)\n    \n    # Per design, StarNumberCalculator produces a StarNumber, but the API returns an int.\n    # An instance of StarNumber could be created here if needed for internal processing:\n    # star_number_obj = StarNumber(input_param.n, computed_value)\n    \n    return computed_value"}
