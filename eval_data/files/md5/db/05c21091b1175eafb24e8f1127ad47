{"task_id": "Mbpp/310", "solution": "from typing import List, Tuple\ndef _split_to_chars(input: str) -> List[str]:\n    \"\"\"Converts a string into an ordered list of single-character strings.\"\"\"\n    return [c for c in input]\ndef _filter_spaces(chars: List[str]) -> List[str]:\n    \"\"\"Removes ASCII space characters (U+0020) from a list of characters.\"\"\"\n    return [c for c in chars if c != ' ']\ndef _assemble_tuple(chars: List[str]) -> Tuple[str, ...]:\n    \"\"\"Assembles a tuple from a list of characters.\"\"\"\n    return tuple(chars)\ndef string_to_tuple(input: str) -> Tuple[str, ...]:\n    \"\"\"Converts an input string to a tuple of single-character strings, excluding ASCII spaces.\"\"\"\n    chars = _split_to_chars(input)\n    filtered = _filter_spaces(chars)\n    return _assemble_tuple(filtered)"}
{"task_id": "Mbpp/311", "solution": "class IntegerInput:\n    \"\"\"Represents and stores an input integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the stored value is non-negative.\"\"\"\n        return self.value >= 0\nclass BitPosition:\n    \"\"\"Container for an identified bit index.\"\"\"\n    def __init__(self, index: int) -> None:\n        self.index = index\nclass Result:\n    \"\"\"Container for the final integer returned by the API.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass BitManipulator:\n    \"\"\"Computes MSB, scans for left-most unset bit, and sets bits.\"\"\"\n    def find_most_significant_set_bit(self, value: int) -> int:\n        \"\"\"Returns the 0-based index of the most significant set bit.\"\"\"\n        if value == 0:\n            return 0\n        return value.bit_length() - 1\n\n    def find_left_most_unset_bit(self, value: int, msb_index: int) -> int:\n        \"\"\"Scans for the left-most unset bit or returns msb_index + 1.\"\"\"\n        for i in range(msb_index, -1, -1):\n            if not (value & (1 << i)):\n                return i\n        return msb_index + 1\n\n    def set_bit(self, value: int, index: int) -> int:\n        \"\"\"Returns the value with the bit at the specified index set.\"\"\"\n        return value | (1 << index)\ndef set_left_most_unset_bit(value: int) -> int:\n    \"\"\"Sets the left-most unset bit in the input integer.\"\"\"\n    # Per CRITICAL REQUIREMENTS, type checks and exception raising are omitted.\n\n    _ = IntegerInput(value) # Constructing per design for traceability.\n\n    bit_manipulator = BitManipulator()\n\n    msb_index = bit_manipulator.find_most_significant_set_bit(value)\n    _ = BitPosition(msb_index) # Identifying bit position per design.\n\n    bit_index = bit_manipulator.find_left_most_unset_bit(value, msb_index)\n    _ = BitPosition(bit_index) # Identifying bit position per design.\n\n    result_value = bit_manipulator.set_bit(value, bit_index)\n    _ = Result(result_value) # Wrapping result per design.\n\n    return result_value"}
{"task_id": "Mbpp/312", "solution": "import math\nclass Cone:\n    \"\"\"\n    Value object for a cone's dimensions.\n    Holds radius and height as floats.\n    \"\"\"\n    def __init__(self, radius: float, height: float):\n        self.radius = radius\n        self.height = height\nclass VolumeCalculator:\n    \"\"\"\n    Performs the volume calculation for a cone.\n    Uses math.pi for precision.\n    \"\"\"\n    def __init__(self):\n        self.pi = math.pi\n\n    def calculateVolume(self, cone: Cone) -> float:\n        \"\"\"\n        Calculates the volume of a cone given its radius and height.\n        Applies V = (1/3) * pi * r^2 * h.\n        \"\"\"\n        volume = (1/3) * self.pi * (cone.radius ** 2) * cone.height\n        return volume\nclass CalculationResult:\n    \"\"\"\n    Holds the computed volume as a floating-point number.\n    A simple container for the calculation outcome.\n    \"\"\"\n    def __init__(self, volume: float):\n        self.volume = volume\ndef volume_cone(radius, height):\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    Converts inputs to float for computation.\n    \"\"\"\n    # CRITICAL REQUIREMENT: \"DO NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n    # Therefore, explicit input validation and error raising for non-numeric/invalid inputs are omitted.\n    # We trust the caller's inputs are numeric or convertible to float.\n\n    # Convert inputs to float as per design, preparing for Cone object creation.\n    cone_obj = Cone(radius=float(radius), height=float(height))\n\n    calculator = VolumeCalculator()\n    computed_volume = calculator.calculateVolume(cone_obj)\n\n    # Wrap the computed volume in CalculationResult as per design, then return the volume.\n    result_obj = CalculationResult(volume=computed_volume)\n    return result_obj.volume"}
{"task_id": "Mbpp/311", "solution": "def _find_most_significant_zero(n: int, bit_len: int) -> int | None:\n    for i in range(bit_len - 1, -1, -1):\n        if not (n & (1 << i)):\n            return i\n    return None\ndef _set_bit_at_position(n: int, pos: int) -> int:\n    return n | (1 << pos)\ndef _prepend_msb(n: int, bit_len: int) -> int:\n    return (1 << bit_len) | n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in the binary representation of n.\n    If all bits are ones, a new most-significant bit is prepended.\n    \"\"\"\n    # Compute bit length, treating n=0 as having a bit_length of 1 for correct behavior.\n    bit_len = max(1, n.bit_length())\n\n    # Scan for the most-significant zero bit.\n    pos = _find_most_significant_zero(n, bit_len)\n\n    if pos is not None:\n        # If a zero bit is found, set that bit.\n        return _set_bit_at_position(n, pos)\n    else:\n        # If all bits are ones, prepend a new MSB.\n        return _prepend_msb(n, bit_len)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the largest power of two less than or equal to n.\n    Assumes n is an integer >= 1.\n    \"\"\"\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/312", "solution": "import math\ndef _coerce_numeric(value, name) -> float:\n    \"\"\"Attempt to coerce value to float; raise TypeError with descriptive message if not coercible.\n    Returns the float value; raises TypeError or ValueError on failure as appropriate.\"\"\"\n    try:\n        f_value = float(value)\n        return f_value\n    except (TypeError, ValueError) as e:\n        raise TypeError(f\"Input '{name}' must be numeric or coercible to numeric, but got {type(value).__name__}. Original error: {e}\")\ndef volume_cone(radius, height) -> float:\n    \"\"\"Compute cone volume. Parameters radius and height are numeric or coercible to numeric.\n    Raises TypeError/ValueError for invalid inputs; raises ValueError for negative values.\"\"\"\n    r = _coerce_numeric(radius, 'radius')\n    h = _coerce_numeric(height, 'height')\n\n    if r < 0 or h < 0:\n        raise ValueError(\"radius and height must be non-negative\")\n\n    V = (1.0/3.0) * math.pi * r * r * h\n    return float(V)"}
{"task_id": "Mbpp/388", "solution": "def _is_integer(n) -> bool:\n    \"\"\"Checks if the input n is an integer.\"\"\"\n    return isinstance(n, int)\ndef _largest_power_of_two_leq(n: int) -> int:\n    \"\"\"Computes the largest power of two less than or equal to n.\n    Returns 0 if n is non-positive, as no positive power of two meets the condition.\"\"\"\n    if n <= 0:\n        return 0\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power\ndef highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 that is less than or equal to n.\n    Validates input type and computes the result using private helpers.\"\"\"\n    if not _is_integer(n):\n        raise TypeError(\"n must be an integer\")\n    return _largest_power_of_two_leq(n)"}
{"task_id": "Mbpp/389", "solution": "# src/lucas_calculator.py\n\"\"\"Calculates Lucas numbers.\"\"\"\n\nclass LucasCalculator:\n    \"\"\"Computes Lucas numbers using an iterative approach.\"\"\"\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Returns the nth Lucas number.\"\"\"\n        if n == 0:\n            return 2\n        elif n == 1:\n            return 1\n        else:\n            return self._compute_iterative(n)\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Iteratively computes the nth Lucas number for n >= 2.\"\"\"\n        a, b = 2, 1  # L0, L1\n        for _ in range(2, n + 1):\n            next_lucas = a + b\n            a, b = b, next_lucas\n        return b"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Computes the nth Lucas number iteratively.\n    The sequence is defined by L0 = 2, L1 = 1, and L_n = L_{n-1} + L_{n-2} for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    # Initialize with L0 and L1\n    a, b = 2, 1\n    # Iterate from L2 up to Ln\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/390", "solution": "from .add_string import add_string\nfrom typing import Any, List\ndef _apply_format_to_element(element: Any, format_string: str) -> str:\n    \"\"\"Applies the format_string to a single element.\n    Propagates any exceptions raised by str.format.\n    \"\"\"\n    return format_string.format(element)\ndef add_string(input_list: List[Any], format_string: str) -> List[str]:\n    \"\"\"Applies a str.format-style pattern to every element of an input list.\n    Raises ValueError for invalid format_string or propagates formatting exceptions.\n    \"\"\"\n    _validate_format_string(format_string)\n\n    formatted_results: List[str] = []\n    for element in input_list:\n        formatted_str = _apply_format_to_element(element, format_string)\n        formatted_results.append(formatted_str)\n\n    return formatted_results"}
