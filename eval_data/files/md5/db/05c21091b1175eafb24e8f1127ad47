{"task_id": "Mbpp/773", "solution": "class MatchResult:\n    \"\"\"Internal representation of a substring match.\n    Stores the matched substring and its start/end indices.\"\"\"\n    def __init__(self, matched_substring: str, start_index: int, end_index: int):\n        self.matched_substring = matched_substring\n        self.start_index = start_index\n        self.end_index = end_index\nclass OccurrenceFunction:\n    \"\"\"Encapsulates the logic for finding the first occurrence of a substring.\n    Delegates the search and returns a MatchResult or None.\"\"\"\n    def __init__(self, main_string: str, substring: str):\n        self._main_string = main_string\n        self._substring = substring\n\n    def find(self) -> MatchResult | None:\n        \"\"\"Performs a straightforward search for the first occurrence.\n        Returns a MatchResult if found, otherwise None.\"\"\"\n        start_index = self._main_string.find(self._substring)\n\n        if start_index == -1:\n            return None\n        else:\n            matched_substring = self._substring\n            end_index = start_index + len(matched_substring)\n            return MatchResult(matched_substring, start_index, end_index)\ndef occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a main string.\n    Returns a tuple (matched_substring, start_index, end_index) or None.\n    \"\"\"\n    occ = OccurrenceFunction(main_string, substring)\n    match = occ.find()\n    if match is None:\n        return None\n    return (match.matched_substring, match.start_index, match.end_index)"}
{"task_id": "Mbpp/773", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Tuple\nclass SourceString:\n    \"\"\"Holds the source string value for search operations.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass Substring:\n    \"\"\"Holds the substring value and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the substring.\"\"\"\n        return len(self.value)\nclass SubstringSearchService:\n    \"\"\"Encapsulates the search algorithm to locate the first occurrence.\"\"\"\n    def find_first(self, source: SourceString, sub: Substring) -> Optional[Occurrence]:\n        \"\"\"Locates the first occurrence of a substring in a source string.\"\"\"\n        start_index = source.value.find(sub.value)\n        if start_index >= 0:\n            end_index = start_index + sub.length()\n            return Occurrence(sub.value, start_index, end_index)\n        return None\ndef occurance_substring(source: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Public API to find the first occurrence of a substring in a source string.\n    Delegates to a SubstringSearchService and returns a tuple or None.\n    \"\"\"\n    source_obj = SourceString(source)\n    substring_obj = Substring(substring)\n    service = SubstringSearchService()\n    \n    occurrence = service.find_first(source_obj, substring_obj)\n    \n    if occurrence:\n        return occurrence.to_tuple()\n    return None"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst):\n    \"\"\"\n    Checks if every element at an odd index in the list is an odd integer.\n    Returns True if all such elements are odd integers, or if there are no odd indices.\n    \"\"\"\n    for i in range(1, len(lst), 2):\n        # Per design, assume elements at odd indices are numbers.\n        # Check if the absolute value of the number is odd.\n        if abs(lst[i]) % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/775", "solution": "from typing import List\ndef _is_odd(value: int) -> bool:\n    \"\"\"Checks if an integer value is odd. Returns True if the value is odd, False otherwise.\"\"\"\n    return value % 2 != 0\ndef odd_position(list_of_integers: List[int]) -> bool:\n    \"\"\"Checks if all elements at odd zero-based indices in a list of integers are odd.\n    Returns True if all such elements are odd, or if there are no odd indices.\"\"\"\n    for i in range(1, len(list_of_integers), 2):\n        if not _is_odd(list_of_integers[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def build_frequency_map(input_list) -> dict:\n    \"\"\"Returns dict mapping element -> occurrence count.\"\"\"\n    freq_map = {}\n    for element in input_list:\n        freq_map[element] = freq_map.get(element, 0) + 1\n    return freq_map\ndef sum_unique_elements(freq_map: dict) -> (int | float):\n    \"\"\"Returns the sum of keys where freq_map[key] == 1. Returns 0 if none.\"\"\"\n    total_sum = 0\n    for element, count in freq_map.items():\n        if count == 1:\n            total_sum += element\n    return total_sum\ndef find_sum(input_list) -> (int | float):\n    \"\"\"Public API. Validates input, computes and returns the sum of elements that occur exactly once.\"\"\"\n    validate_input(input_list)\n    freq_map = build_frequency_map(input_list)\n    return sum_unique_elements(freq_map)"}
{"task_id": "Mbpp/777", "solution": "def find_sum(lst: list[int]) -> int:\n    \"\"\"Calculates the sum of distinct integers in a list.\n    Returns 0 for an empty list, counting duplicates only once.\"\"\"\n    if not lst:\n        return 0\n    distinct = set(lst)\n    return sum(distinct)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"Packs consecutive equal elements into sublists.\n    Returns a new list of new sublists, without mutating the input.\n    \"\"\"\n    result = []\n    iterator = iter(input_list)\n    try:\n        current_group = [next(iterator)]\n    except StopIteration:\n        return result\n\n    for element in iterator:\n        if element == current_group[-1]:\n            current_group.append(element)\n        else:\n            result.append(list(current_group))\n            current_group = [element]\n\n    result.append(list(current_group))\n    return result"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\nclass Element:\n    \"\"\"Represents an item from the input list with its value and original index.\"\"\"\n    def __init__(self, value: Any, index: int):\n        self.value = value\n        self.index = index\nclass InputList:\n    \"\"\"Wraps raw input sequence into Element instances, preserving order.\"\"\"\n    def __init__(self, raw_values: List[Any]):\n        self.elements: List[Element] = [Element(val, i) for i, val in enumerate(raw_values)]\n        self.length = len(self.elements)\n\n    def as_values(self) -> List[Any]:\n        \"\"\"Returns the raw values of the contained elements.\"\"\"\n        return [e.value for e in self.elements]\nclass Sublist:\n    \"\"\"Container for one run of consecutive Element instances.\"\"\"\n    def __init__(self, first_element: Element):\n        self.elements: List[Element] = [first_element]\n\n    def append(self, element: Element):\n        \"\"\"Adds an Element to this sublist.\"\"\"\n        self.elements.append(element)\n\n    def values(self) -> List[Any]:\n        \"\"\"Returns the raw values of the elements in this sublist.\"\"\"\n        return [e.value for e in self.elements]\nclass ResultList:\n    \"\"\"Container for ordered sequence of Sublist groups.\"\"\"\n    def __init__(self):\n        self.groups: List[Sublist] = []\n\n    def append(self, sublist: Sublist):\n        \"\"\"Adds a Sublist to the list of groups.\"\"\"\n        self.groups.append(sublist)\n\n    def as_nested_values(self) -> List[List[Any]]:\n        \"\"\"Returns a list of lists, where each inner list contains raw values from a Sublist.\"\"\"\n        return [group.values() for group in self.groups]\nclass EqualityComparer:\n    \"\"\"Encapsulates the language runtime's standard equality comparison.\"\"\"\n    def equals(self, a: Any, b: Any) -> bool:\n        \"\"\"Compares two values using the standard equality operator.\"\"\"\n        return a == b\nclass PackConsecutiveDuplicatesFunction:\n    \"\"\"Encapsulates the algorithm for grouping consecutive equal elements.\"\"\"\n    def pack(self, input_list_obj: InputList) -> ResultList:\n        \"\"\"Groups consecutive equal elements from an InputList into a ResultList.\"\"\"\n        result_list = ResultList()\n        if input_list_obj.length == 0:\n            return result_list\n\n        equality_comparer = EqualityComparer()\n        current_sublist = Sublist(input_list_obj.elements[0])\n\n        for i in range(1, input_list_obj.length):\n            current_element = input_list_obj.elements[i]\n            previous_element = input_list_obj.elements[i - 1]\n\n            if equality_comparer.equals(previous_element.value, current_element.value):\n                current_sublist.append(current_element)\n            else:\n                result_list.append(current_sublist)\n                current_sublist = Sublist(current_element)\n\n        result_list.append(current_sublist) # Append the last sublist\n        return result_list\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"Packs consecutive duplicates of a given list elements into sublists.\"\"\"\n    input_list_obj = InputList(input_list)\n    packer = PackConsecutiveDuplicatesFunction()\n    result_list_obj = packer.pack(input_list_obj)\n    return result_list_obj.as_nested_values()"}
{"task_id": "Mbpp/780", "solution": "def sum_pair(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:\n    \"\"\"Return a 2-element tuple summing corresponding elements of a and b.\"\"\"\n    return (a[0] + b[0], a[1] + b[1])\ndef find_combinations(list_of_tuples) -> list[tuple[int, int]]:\n    \"\"\"Public API per SRS FR1. Generates pairs and computes element-wise sums.\"\"\"\n    n = len(list_of_tuples)\n    if n < 2:\n        return []\n\n    results = []\n    for a, b in generate_pairs(list_of_tuples):\n        results.append(sum_pair(a, b))\n    return results"}
{"task_id": "Mbpp/780", "solution": "from typing import Sequence, List, Tuple, Union, Iterator\nfrom dataclasses import dataclass\nNumber = Union[int, float]\nTuple2 = Tuple[Number, Number]\nclass FindCombinationsService:\n    \"\"\"Service to handle combination generation and summation logic.\"\"\"\n\n    def find_combinations(self, input_list: List[Tuple2]) -> List[ResultTuple]:\n        \"\"\"\n        Orchestrates pair generation and sum computation.\n        Input validation raising exceptions is omitted due to critical requirements.\n        \"\"\"\n        if len(input_list) < 2:\n            return []\n\n        results: List[ResultTuple] = []\n        order_counter = 0\n\n        for i, j in self.generate_pairs(input_list):\n            a = input_list[i]\n            b = input_list[j]\n            result_tuple = self.compute_sum(a, b, i, j, order_counter)\n            results.append(result_tuple)\n            order_counter += 1\n        return results\n\n    def generate_pairs(self, input_list: List[Tuple2]) -> Iterator[Tuple[int, int]]:\n        \"\"\"Yields (i, j) index pairs in (outer i then inner j) order.\"\"\"\n        n = len(input_list)\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                yield (i, j)\n\n    def compute_sum(self, a: Tuple2, b: Tuple2, i: int, j: int, order: int) -> ResultTuple:\n        \"\"\"Computes component-wise sums and returns a ResultTuple.\"\"\"\n        sum_a = a[0] + b[0]\n        sum_b = a[1] + b[1]\n        return ResultTuple(sum_a=sum_a, sum_b=sum_b, i_index=i, j_index=j, order=order)\ndef find_combinations(input_list: Sequence[Tuple2]) -> List[Tuple2]:\n    \"\"\"\n    Calculates component-wise sums for all unique unordered pairs of distinct input tuples.\n    Input validation raising exceptions is omitted due to critical requirements.\n    \"\"\"\n    svc = FindCombinationsService()\n    result_objs = svc.find_combinations(list(input_list))\n    return [(r.sum_a, r.sum_b) for r in result_objs]"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Counts the positive divisors of n and returns True if the count is even, else False.\n    Divisors are found by iterating up to the square root of n for efficiency.\n    \"\"\"\n    divisor_count = 0\n    # Iterate from 1 up to sqrt(n) to find divisors efficiently.\n    # The loop should include int(math.sqrt(n)) itself if it's a divisor.\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            if i * i == n:  # If i is a perfect square root, count it once\n                divisor_count += 1\n            else:  # Otherwise, i and n // i are a distinct pair of divisors\n                divisor_count += 2\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n):\n    \"\"\"Counts the positive divisors of n and returns True if the count is even, False otherwise.\"\"\"\n    count = 0\n    i = 1\n    # Iterate up to the square root of n to find divisor pairs.\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length contiguous subarrays.\n    Internal classes handle validation, subarray generation, and aggregation.\"\"\"\n\n    class Validator:\n        \"\"\"Validates input array and its elements.\n        Trusts caller inputs due to critical requirements.\"\"\"\n        def is_list(self, obj) -> bool:\n            return True  # Simplified as per critical requirements\n\n        def elements_are_integers(self, arr: list[int]) -> bool:\n            return True  # Simplified as per critical requirements\n\n    class Subarray:\n        \"\"\"Represents a contiguous slice of the input array.\n        Calculates the sum of its elements.\"\"\"\n        def __init__(self, elements: list[int], start_index: int, length: int):\n            self.elements = elements\n            self.start_index = start_index\n            self.length = length\n\n        def sum(self) -> int:\n            return sum(self.elements[self.start_index : self.start_index + self.length])\n\n    class Aggregator:\n        \"\"\"Accumulates integer totals.\n        Provides a running total.\"\"\"\n        def __init__(self):\n            self.total: int = 0\n\n        def add(self, value: int) -> None:\n            self.total += value\n\n    class Result:\n        \"\"\"Holds the final integer value of a computation.\n        A simple wrapper for an integer.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n    class OddLengthSum:\n        \"\"\"Core computation for summing odd-length subarrays.\n        Generates, filters, and aggregates subarray sums.\"\"\"\n        def __init__(self, arr: list[int]):\n            self.arr = arr\n\n        def compute(self) -> Result:\n            aggregator = Aggregator()\n            n = len(self.arr)\n\n            for i in range(n):  # start index\n                for j in range(i, n):  # end index (inclusive)\n                    length = j - i + 1\n                    if length % 2 == 1:\n                        # Create a Subarray object for the current slice\n                        subarray = Subarray(self.arr, i, length)\n                        aggregator.add(subarray.sum())\n            return Result(aggregator.total)\n\n    # Main logic of odd_length_sum function\n    validator = Validator()\n    # As per CRITICAL REQUIREMENTS, validation checks are simplified to always pass.\n    # No actual validation logic or exceptions are performed here.\n    if not validator.is_list(arr) or not validator.elements_are_integers(arr):\n        # This branch is intentionally unreachable due to simplified Validator\n        pass\n\n    core_calculator = OddLengthSum(arr)\n    result = core_calculator.compute()\n    return result.value"}
{"task_id": "Mbpp/782", "solution": "from typing import Iterator, Tuple\ndef _sum_range(input_list: list, start: int, end: int) -> int:\n    \"\"\"Internal helper: returns sum(input_list[start:end]).\"\"\"\n    return sum(input_list[start:end])\ndef odd_length_sum(input_list: list) -> int:\n    \"\"\"Public API: compute sum of all odd-length contiguous subarrays of input_list.\"\"\"\n    _validate_input(input_list)\n\n    if not input_list:\n        return 0\n\n    total_aggregate_sum = 0\n    n = len(input_list)\n\n    for start, end in _generate_odd_subarray_ranges(n):\n        total_aggregate_sum += _sum_range(input_list, start, end)\n\n    return total_aggregate_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(list_of_ints):\n    \"\"\"Return int product of first odd and first even values found when scanning list_of_ints.\n    The function scans from start to end, stopping once both parities are found.\"\"\"\n    first_odd = None\n    first_even = None\n\n    for value in list_of_ints:\n        if first_odd is None and value % 2 != 0:\n            first_odd = value\n        \n        if first_even is None and value % 2 == 0:\n            first_even = value\n            \n        if first_odd is not None and first_even is not None:\n            break\n            \n    return first_odd * first_even"}
{"task_id": "Mbpp/784", "solution": "from typing import Optional, List\nfrom src.domain import IntegerItem, OddNumber, EvenNumber, Result\nclass MulEvenOddFunction:\n    \"\"\"Scan list to find first odd and first even items and return their product.\"\"\"\n\n    def mul_even_odd(self, items: list[int]) -> int:\n        \"\"\"Return product of first odd and first even found scanning from first element.\"\"\"\n        first_odd_val: Optional[int] = None\n        first_even_val: Optional[int] = None\n\n        # Implements UC4: Stop scanning once both first odd and first even integers are found.\n        for item_val in items:\n            if first_odd_val is None and item_val % 2 != 0:\n                first_odd_val = item_val\n            elif first_even_val is None and item_val % 2 == 0:\n                first_even_val = item_val\n\n            if first_odd_val is not None and first_even_val is not None:\n                break # Both found, stop scanning.\n\n        # Trusting caller's inputs; no explicit error handling for missing parity values.\n        # The design states to trust inputs and not add checks for edge cases.\n        product = first_odd_val * first_even_val # type: ignore\n        return Result(product).product\n\n    def scanForFirstOdd(self, items: list[int]) -> int | None:\n        \"\"\"Return first odd integer or None if none found.\"\"\"\n        for item_val in items:\n            integer_item = IntegerItem(item_val)\n            if integer_item.isOdd():\n                return OddNumber(item_val).value\n        return None\n\n    def scanForFirstEven(self, items: list[int]) -> int | None:\n        \"\"\"Return first even integer or None if none found.\"\"\"\n        for item_val in items:\n            integer_item = IntegerItem(item_val)\n            if integer_item.isEven():\n                return EvenNumber(item_val).value\n        return None\ndef mul_even_odd(items: list[int]) -> int:\n    \"\"\"Module-level public API that delegates to MulEvenOddFunction.\"\"\"\n    return MulEvenOddFunction().mul_even_odd(items)"}
{"task_id": "Mbpp/785", "solution": "class TupleString:\n    \"\"\"Encapsulates input string and validates its basic format.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def is_valid_format(self) -> bool:\n        \"\"\"Checks if the string starts with '(' and ends with ')' and has at least two characters.\"\"\"\n        return len(self.value) >= 2 and self.value.startswith('(') and self.value.endswith(')')\nclass IntegerTuple:\n    \"\"\"Holds parsed integer values and converts them to a built-in Python tuple.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the list of integers to a Python tuple.\"\"\"\n        return tuple(self.values)\nclass TupleParser:\n    \"\"\"Parses a tuple-formatted string, tokenizes, and converts tokens to integers.\"\"\"\n    def tokenize(self, s: str) -> list[str]:\n        \"\"\"Extracts the interior of the string, splits by comma, and strips whitespace from tokens.\"\"\"\n        interior = s[1:-1]\n        if not interior.strip():\n            return []\n        return [token.strip() for token in interior.split(',')]\n\n    def parse(self, s: str) -> IntegerTuple:\n        \"\"\"Validates the string format, tokenizes it, and converts tokens to integers.\"\"\"\n        tuple_string_validator = TupleString(s)\n        if not tuple_string_validator.is_valid_format():\n            raise ValueError(\"Input string must start with '(' and end with ')'.\")\n\n        tokens = self.tokenize(s)\n        integer_values = [int(token) for token in tokens]\n        return IntegerTuple(integer_values)\ndef tuple_str_int(s: str) -> tuple:\n    \"\"\"Converts a string in the form \"(n1, n2, ...)\" into a Python tuple of ints.\"\"\"\n    parser = TupleParser()\n    integer_tuple_obj = parser.parse(s)\n    return integer_tuple_obj.to_tuple()"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence as TypingSequence, Any\ndef right_insertion(sequence: TypingSequence[Any], value: Any) -> int:\n    \"\"\"\n    Compute the right insertion index for value in an ascending (non-decreasing) sequence.\n    This finds the smallest index i such that sequence[i] > value, ensuring right-insertion semantics for equal elements.\n    \"\"\"\n    low = 0\n    high = len(sequence)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sequence[mid] <= value:\n            low = mid + 1\n        else:  # sequence[mid] > value\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\nclass TupleParser:\n    \"\"\"Orchestrates validation and parsing of tuple-formatted strings.\"\"\"\n\n    def tuple_str_int(self, s: str) -> tuple:\n        \"\"\"Orchestrates validation and parsing; returns tuple of ints or raises ValueError.\"\"\"\n        self._validate_format(s)\n        parsed_elements = self._parse_elements(s)\n        return tuple(parsed_elements.elements)\n\n    def _validate_format(self, s: str):\n        \"\"\"Ensures s starts with '(' and ends with ')', and basic token boundaries are valid.\"\"\"\n        if not s or len(s) < 2:\n            raise ValueError(\"Input string is too short or empty for a tuple format.\")\n        if s[0] != '(' or s[-1] != ')':\n            raise ValueError(\"Input string must start with '(' and end with ')'.\")\n\n        inner_content = s[1:-1]\n        stripped_inner_content = inner_content.strip()\n\n        # Handle valid empty tuple case '()' or '( )'\n        if not stripped_inner_content:\n            if ',' in inner_content: # e.g., \"( , )\"\n                raise ValueError(\"Empty tuple content cannot contain commas.\")\n            return\n\n        # Check for leading/trailing commas resulting in empty tokens\n        if stripped_inner_content.startswith(',') or stripped_inner_content.endswith(','):\n            raise ValueError(\"Tuple content cannot start or end with a comma, resulting in empty tokens.\")\n\n        # Check for multiple consecutive commas (e.g., \"1,,2\")\n        if ',,' in stripped_inner_content:\n            raise ValueError(\"Tuple content cannot contain consecutive commas, resulting in empty tokens.\")\n\n    def _parse_elements(self, s: str) -> IntegerTuple:\n        \"\"\"Extracts inner content, splits on commas, converts tokens to int, and returns IntegerTuple.\"\"\"\n        inner_content = s[1:-1]\n        stripped_inner_content = inner_content.strip()\n\n        if not stripped_inner_content:\n            return IntegerTuple(elements=[])\n\n        raw_tokens = inner_content.split(',')\n        parsed_ints: List[int] = []\n\n        for i, token in enumerate(raw_tokens):\n            stripped_token = token.strip()\n            if not stripped_token:\n                # This case should largely be covered by _validate_format's comma checks.\n                raise ValueError(f\"Empty token found at position {i} after stripping whitespace.\")\n            try:\n                integer_value = int(stripped_token)\n                parsed_ints.append(integer_value)\n                # IntegerElement not explicitly instantiated for the final list, but dataclass is defined per design.\n            except ValueError as e:\n                raise ValueError(f\"Invalid non-integer token '{token}' at position {i}. Details: {e}\") from e\n        \n        return IntegerTuple(elements=parsed_ints)\ndef tuple_str_int(s: str) -> tuple:\n    \"\"\"Public API: parse a tuple-formatted string and return a tuple of ints or raise ValueError.\"\"\"\n    return TupleParser().tuple_str_int(s)"}
{"task_id": "Mbpp/786", "solution": "class ComparisonException(Exception):\n    \"\"\"\n    Exception raised when elements and value are not mutually comparable.\n    This custom exception translates runtime comparator errors.\n    \"\"\"\n    pass\nclass Sequence:\n    \"\"\"\n    A read-only adapter for sequence-like objects, providing length and element access.\n    It encapsulates the sequence for consistent, non-mutating access.\n    \"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the wrapped sequence.\"\"\"\n        return len(self._elements)\n\n    def get(self, i: int):\n        \"\"\"Returns the element at the specified 0-based index.\"\"\"\n        return self._elements[i]\n\n    def is_sorted_non_decreasing(self) -> bool:\n        \"\"\"\n        (Optional helper) Checks if the wrapped sequence is sorted non-decreasingly.\n        This method is primarily for validation/testing, not core right_insertion logic.\n        \"\"\"\n        for i in range(self.length() - 1):\n            try:\n                if self.get(i) > self.get(i + 1):\n                    return False\n            except TypeError:\n                raise ComparisonException(f\"Elements at index {i} and {i+1} are not mutually comparable for sorting check.\")\n        return True\ndef right_insertion(seq, value) -> int:\n    \"\"\"\n    Computes the 0-based insertion index for 'value' into 'seq' using right-insertion semantics.\n    'seq' is expected to be sorted non-decreasingly; comparison errors raise ComparisonException.\n    \"\"\"\n    seq_adapter = Sequence(seq)\n    n = seq_adapter.length()\n\n    if n == 0:\n        return 0\n\n    low = 0\n    high = n\n\n    while low < high:\n        mid = low + (high - low) // 2\n        try:\n            # Find the smallest index 'i' such that seq[i] > value.\n            # If seq[mid] <= value, the insertion point is at or after mid + 1.\n            if seq_adapter.get(mid) <= value:\n                low = mid + 1\n            # If seq[mid] > value, mid is a potential insertion point;\n            # search in the left half for an even smaller index.\n            else:\n                high = mid\n        except TypeError:\n            raise ComparisonException(\"Elements in the sequence and the value are not mutually comparable.\")\n        except Exception as e:\n            raise ComparisonException(f\"A comparison error occurred: {e}\")\n\n    return low"}
