{"task_id": "Mbpp/413", "solution": "from typing import List, Any, Tuple\ndef extract_nth_element(tuple_list: List[Tuple[Any, ...]], n: int) -> List[Any]:\n    \"\"\"\n    Extracts the n-th element from each tuple in a list, preserving order.\n    Returns an empty list if `tuple_list` is empty; IndexError propagates for out-of-range n.\n    \"\"\"\n    if not tuple_list:\n        return []\n\n    result_list = []\n    for item_tuple in tuple_list:\n        result_list.append(item_tuple[n])\n    return result_list"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"\n    Checks if any element is common between two sequences.\n    Returns True if an overlap exists, False otherwise.\n    \"\"\"\n    if not seq1 or not seq2:\n        return False\n\n    set1 = set(seq1)\n    set2 = set(seq2)\n\n    return bool(set1.intersection(set2))"}
{"task_id": "Mbpp/414", "solution": "def compare(e1, e2) -> bool:\n    \"\"\"Return True if e1 == e2 using Python equality operator.\n    This helper function has no side effects.\"\"\"\n    return e1 == e2\ndef overlapping(seq1, seq2) -> bool:\n    \"\"\"Return True if any element of seq1 equals (==) any element of seq2.\n    The function does not modify seq1 or seq2 and is deterministic.\"\"\"\n    for item1 in seq1:\n        for item2 in seq2:\n            if compare(item1, item2):\n                return True\n    return False"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(elements: list) -> object:\n    \"\"\"Returns the element from 'elements' with maximum len(), preferring the first occurrence in case of ties.\n    Raises ValueError for an empty input list.\n    \"\"\"\n    if not elements:\n        raise ValueError('Find_Max() requires a non-empty list')\n    return max(elements, key=len)"}
{"task_id": "Mbpp/415", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\ndef _build_integer_elements(values: List[int]) -> List[IntegerElement]:\n    \"\"\"Converts a list of integers into a list of IntegerElement objects.\"\"\"\n    return [IntegerElement(value, index) for index, value in enumerate(values)]\ndef _select_max_pair(elements: List[IntegerElement]) -> PairResult:\n    \"\"\"Enumerates distinct-index pairs to select the one with the maximal product.\"\"\"\n    max_prod: int = -float('inf') # Initialize with negative infinity to handle all possible products, including negative ones.\n    max_prod_pair: PairResult | None = None\n\n    for i in range(len(elements)):\n        for j in range(i + 1, len(elements)): # Ensures distinct indices and i < j for ordering.\n            current_pair = PairResult(elements[i], elements[j])\n            current_prod = current_pair.product()\n\n            if current_prod > max_prod:\n                max_prod = current_prod\n                max_prod_pair = current_pair\n            elif current_prod == max_prod and max_prod_pair is not None:\n                # Apply deterministic tie-breaker: smallest first index, then smallest second index.\n                if current_pair.a.index < max_prod_pair.a.index:\n                    max_prod_pair = current_pair\n                elif current_pair.a.index == max_prod_pair.a.index and \\\n                     current_pair.b.index < max_prod_pair.b.index:\n                    max_prod_pair = current_pair\n    \n    # max_prod_pair will not be None because _validate_input_list ensures at least two elements.\n    return max_prod_pair # type: ignore\ndef max_Product(values: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Returns a 2-tuple (a, b) where a and b are integers from distinct indices,\n    ordered by their original input indices (smaller index first).\n    \"\"\"\n    _validate_input_list(values)\n    elements = _build_integer_elements(values)\n    pair_result = _select_max_pair(elements)\n    \n    return (pair_result.a.value, pair_result.b.value)"}
{"task_id": "Mbpp/415", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Optional\ndef _update_top_two(val: int, idx: int, top1: Optional[Tuple[int, int]], top2: Optional[Tuple[int, int]]) -> Tuple[Optional[Tuple[int, int]], Optional[Tuple[int, int]]]:\n    \"\"\"Maintains the two largest distinct (value, index) pairs seen so far.\"\"\"\n    if top1 is None:\n        top1 = (val, idx)\n    elif val > top1[0]:\n        top2 = top1\n        top1 = (val, idx)\n    elif idx != top1[1]:\n        if top2 is None or val > top2[0]:\n            top2 = (val, idx)\n    return top1, top2\ndef _update_bottom_two(val: int, idx: int, bot1: Optional[Tuple[int, int]], bot2: Optional[Tuple[int, int]]) -> Tuple[Optional[Tuple[int, int]], Optional[Tuple[int, int]]]:\n    \"\"\"Maintains the two smallest distinct (value, index) pairs seen so far.\"\"\"\n    if bot1 is None:\n        bot1 = (val, idx)\n    elif val < bot1[0]:\n        bot2 = bot1\n        bot1 = (val, idx)\n    elif idx != bot1[1]:\n        if bot2 is None or val < bot2[0]:\n            bot2 = (val, idx)\n    return bot1, bot2\ndef max_Product(items: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds the pair of integers from the input list whose product is maximal.\n    Tie-breaking prefers the pair with the smallest first index, then the smallest second index.\n    \"\"\"\n    if len(items) < 2:\n        raise ValueError(\"Input list must contain at least two elements.\")\n\n    top1, top2 = None, None # Stores (value, index) for the two largest numbers\n    bot1, bot2 = None, None # Stores (value, index) for the two smallest numbers\n\n    for idx, val in enumerate(items):\n        top1, top2 = _update_top_two(val, idx, top1, top2)\n        bot1, bot2 = _update_bottom_two(val, idx, bot1, bot2)\n\n    max_product_val = float('-inf')\n    best_pair_val_idx: Optional[Tuple[Tuple[int, int], Tuple[int, int]]] = None # Stores ((val1, idx1), (val2, idx2)) ordered by index\n\n    # Candidate 1: Product of the two largest numbers\n    if top1 is not None and top2 is not None:\n        pair1_val_idx, pair2_val_idx = top1, top2\n        if pair1_val_idx[1] > pair2_val_idx[1]: # Ensure elements are ordered by their original indices\n            pair1_val_idx, pair2_val_idx = pair2_val_idx, pair1_val_idx\n        \n        current_product = pair1_val_idx[0] * pair2_val_idx[0]\n        \n        if current_product > max_product_val:\n            max_product_val = current_product\n            best_pair_val_idx = (pair1_val_idx, pair2_val_idx)\n        elif current_product == max_product_val:\n            # Apply tie-breaking rules: smallest first index, then smallest second index\n            if best_pair_val_idx is None:\n                best_pair_val_idx = (pair1_val_idx, pair2_val_idx)\n            else:\n                best_p1, best_p2 = best_pair_val_idx\n                cand_p1, cand_p2 = pair1_val_idx, pair2_val_idx\n\n                if cand_p1[1] < best_p1[1]:\n                    best_pair_val_idx = (cand_p1, cand_p2)\n                elif cand_p1[1] == best_p1[1] and cand_p2[1] < best_p2[1]:\n                    best_pair_val_idx = (cand_p1, cand_p2)\n\n    # Candidate 2: Product of the two smallest (most negative) numbers\n    if bot1 is not None and bot2 is not None:\n        pair1_val_idx, pair2_val_idx = bot1, bot2\n        if pair1_val_idx[1] > pair2_val_idx[1]: # Ensure elements are ordered by their original indices\n            pair1_val_idx, pair2_val_idx = pair2_val_idx, pair1_val_idx\n        \n        current_product = pair1_val_idx[0] * pair2_val_idx[0]\n        \n        if current_product > max_product_val:\n            max_product_val = current_product\n            best_pair_val_idx = (pair1_val_idx, pair2_val_idx)\n        elif current_product == max_product_val:\n            # Apply tie-breaking rules\n            if best_pair_val_idx is None:\n                 best_pair_val_idx = (pair1_val_idx, pair2_val_idx)\n            else:\n                best_p1, best_p2 = best_pair_val_idx\n                cand_p1, cand_p2 = pair1_val_idx, pair2_val_idx\n\n                if cand_p1[1] < best_p1[1]:\n                    best_pair_val_idx = (cand_p1, cand_p2)\n                elif cand_p1[1] == best_p1[1] and cand_p2[1] < best_p2[1]:\n                    best_pair_val_idx = (cand_p1, cand_p2)\n\n    # At this point, best_pair_val_idx must be populated due to len(items) >= 2 and distinct-index logic.\n    return (best_pair_val_idx[0][0], best_pair_val_idx[1][0])"}
