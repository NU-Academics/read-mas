{"task_id": "Mbpp/2", "solution": "def similar_elements(iterable_a, iterable_b):\n    \"\"\"Return a list containing each element that appears in both iterable_a and iterable_b exactly once.\n    The inputs are not mutated, and the returned list contains only unique elements.\n    \"\"\"\n    result = []\n    # Convert iterable_b to a list to allow repeated membership checks and handle non-hashable elements.\n    # This also handles cases where iterable_b might be a single-pass iterator.\n    b_as_list = list(iterable_b) \n\n    for element in iterable_a:\n        # Check if the element is present in iterable_b and not yet in our result list.\n        # This handles uniqueness in the output and uses native equality.\n        if element in b_as_list and element not in result:\n            result.append(element)\n            \n    return result"}
{"task_id": "Mbpp/3", "solution": "import math\nclass PrimeChecker:\n    \"\"\"Encapsulates primality checking logic.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Return True if n is prime, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Check for odd divisors from 3 up to sqrt(n)\n        for i in range(3, math.isqrt(n) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Public API per SRS: return True when n is non-prime, False when n is prime.\n\n    Preconditions: SRS specifies n is an integer; behavior for non-integer types or n < 2 is unspecified.\n    \"\"\"\n    checker = PrimeChecker()\n    return not checker.is_prime(n)"}
{"task_id": "Mbpp/3", "solution": "import math\ndef _is_prime(n) -> bool:\n    \"\"\"Checks if a validated integer n is prime using an O(sqrt(n)) algorithm.\"\"\"\n    if n < 2:\n        return False  # Numbers less than 2 are not prime by definition.\n    if n == 2 or n == 3:\n        return True   # 2 and 3 are prime numbers.\n    if n % 2 == 0 or n % 3 == 0:\n        return False  # Multiples of 2 or 3 (excluding 2,3 themselves) are not prime.\n\n    i = 5\n    limit = math.isqrt(n) # Loop up to the integer square root of n.\n    while i <= limit:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True # If no divisors found, the number is prime.\ndef is_not_prime(n) -> bool:\n    \"\"\"\n    Checks if a number n is not prime, including validation and primality testing.\n    Returns True if n is not prime (or n < 2), False if n is prime.\n    \"\"\"\n    _validate_integer(n)\n    return not _is_prime(n)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(x, y) -> bool:\n    \"\"\"Checks if two numbers differ at exactly one bit position.\n    Returns True if their XOR result is a non-zero power of two.\"\"\"\n    xor = x ^ y\n    if xor == 0:\n        return False\n    return (xor & (xor - 1)) == 0"}
{"task_id": "Mbpp/6", "solution": "def _count_set_bits(x: int) -> int:\n    \"\"\"Return the number of set bits in integer x. This is a module-local helper function.\"\"\"\n    return bin(x).count('1')\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Return True iff integers a and b differ at exactly one bit position.\n    This is determined by computing a ^ b, counting its set bits, and checking if the count is 1.\n    \"\"\"\n    xor_result = a ^ b\n    return _count_set_bits(xor_result) == 1"}
{"task_id": "Mbpp/2", "solution": "def _is_iterable(obj):\n    \"\"\"\n    Checks if an object is iterable by attempting to call iter() on it.\n    Returns True if iterable, False otherwise.\n    \"\"\"\n    try:\n        iter(obj)\n        return True\n    except TypeError:\n        return False\ndef similar_elements(seq1, seq2):\n    \"\"\"\n    Finds the deduplicated collection of elements present in both input sequences.\n    Validates inputs and raises TypeError if either argument is not iterable.\n    \"\"\"\n    if not _is_iterable(seq1) or not _is_iterable(seq2):\n        raise TypeError(\"similar_elements: both arguments must be iterable\")\n\n    found_elements = []\n    # Materialize seq2 into a list to allow for multiple equality checks if seq2 is a single-pass iterable.\n    seq2_list = list(seq2)\n\n    for element_from_seq1 in seq1:\n        # Check if the current element from seq1 exists in seq2 using equality (==).\n        is_in_seq2 = any(element_from_seq1 == e_from_seq2 for e_from_seq2 in seq2_list)\n\n        if is_in_seq2:\n            # If present in seq2, check if it's already in our results list to ensure deduplication.\n            already_in_result = any(element_from_seq1 == existing_e for existing_e in found_elements)\n            \n            if not already_in_result:\n                found_elements.append(element_from_seq1)\n\n    return found_elements"}
{"task_id": "Mbpp/4", "solution": "from typing import List\nfrom .models import InputList, ResultList\nfrom .validator import Validator\nfrom .heap_adapter import HeapAdapter\nclass HeapQueueLargestFunction:\n    \"\"\"Orchestrates validation, selection of top-n, sorting, and result construction.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def execute(self, input_list_raw: List[int], n: int) -> List[int]:\n        \"\"\"Executes the process to find n largest integers, handling edge cases as specified.\"\"\"\n        # Validate inputs. Unspecified behavior for invalid inputs is handled:\n        # - n <= 0 or non-integer n, or empty input list: return empty list.\n        # - non-integer elements in input_list: raise ValueError.\n        if not self.validateInput(input_list_raw, n):\n            if not self._validator.isNonNegative(n) or n <= 0:\n                return []\n            raise ValueError(\"Invalid input: input list must contain only integers.\")\n\n        input_list_model = InputList(input_list_raw)\n\n        if n > input_list_model.length:\n            # Implementer decision: return all items sorted if n > len(input).\n            sorted_all = self.sortDescending(input_list_model.items)\n            return sorted_all\n\n        selected_items = self.selectTopN(input_list_model.items, n)\n        result_items = self.sortDescending(selected_items)\n        return ResultList(result_items).items\n\n    def validateInput(self, input_list: List[int], n: int) -> bool:\n        \"\"\"Delegates to Validator for input and n validation.\"\"\"\n        return self._validator.isIntegerList(input_list) and self._validator.isNonNegative(n)\n\n    def selectTopN(self, items: List[int], n: int) -> List[int]:\n        \"\"\"Selects the top N items using a min-heap via HeapAdapter.\"\"\"\n        heap_adapter = HeapAdapter()\n        for item in items:\n            # Check length of the internal heap for direct control over size.\n            if len(heap_adapter._heap) < n:\n                heap_adapter.push(item)\n            elif item > heap_adapter.peek():\n                heap_adapter.pop()\n                heap_adapter.push(item)\n        \n        # Pop all items from the heap to get them, they will be in ascending order.\n        return [heap_adapter.pop() for _ in range(len(heap_adapter._heap))]\n\n    def sortDescending(self, items: List[int]) -> List[int]:\n        \"\"\"Sorts items in non-increasing order and returns the sorted list.\"\"\"\n        return sorted(items, reverse=True)\n_heap_queue_largest_service = HeapQueueLargestFunction()\ndef heap_queue_largest(input: List[int], n: int) -> List[int]:\n    \"\"\"Returns the n largest integers from an input list in descending order.\"\"\"\n    return _heap_queue_largest_service.execute(input, n)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Any, Union\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\nclass IntegerItem:\n    \"\"\"Conceptual holder for a numeric value and its original index.\"\"\"\n    def __init__(self, value: Union[int, float], index: int = -1):\n        self.value = value\n        self.index = index\n\n    def __lt__(self, other: 'IntegerItem') -> bool:\n        \"\"\"Compares IntegerItem objects based on their value.\"\"\"\n        return self.value < other.value\nclass ParameterN:\n    \"\"\"Wrapper for the 'n' parameter with validity check.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the parameter n is valid (n >= 1).\"\"\"\n        return self.value >= 1\nclass InputList:\n    \"\"\"Container for the input list of numbers, conceptually as IntegerItems.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements: List[IntegerItem] = [IntegerItem(val, i) for i, val in enumerate(elements)]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input list.\"\"\"\n        return len(self.elements)\nclass ResultList:\n    \"\"\"Container for the result elements.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n\n    def count(self) -> int:\n        \"\"\"Returns the number of elements in the result list.\"\"\"\n        return len(self.elements)\nclass Validator:\n    \"\"\"Validates input types and preconditions for heap_queue_largest.\"\"\"\n    def validate_types(self, numbers: Any, n: Any) -> None:\n        \"\"\"Ensures numbers is a list of numerics and n is an integer.\"\"\"\n        if not isinstance(numbers, list):\n            raise ValidationError(\"Input 'numbers' must be a list.\")\n        if not all(isinstance(x, (int, float)) for x in numbers):\n            raise ValidationError(\"All elements in 'numbers' must be numeric.\")\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n\n    def validate_preconditions(self, numbers: List[Union[int, float]], n: int) -> None:\n        \"\"\"Ensures preconditions: 1 <= n <= len(numbers).\"\"\"\n        if not (1 <= n <= len(numbers)):\n            raise ValidationError(f\"Precondition failed: 1 <= n <= len(numbers) must be true. Got n={n}, len(numbers)={len(numbers)}.\")\nclass Sorter:\n    \"\"\"Selects n largest items and returns them ordered descending.\"\"\"\n    def top_n(self, items: List[IntegerItem], n: int) -> List[IntegerItem]:\n        \"\"\"Uses heapq to find the n largest IntegerItem objects in descending order.\"\"\"\n        return heapq.nlargest(n, items)\nclass HeapQueueLargestFunction:\n    \"\"\"Application service coordinator for finding n largest numbers.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.sorter = Sorter()\n\n    def compute(self, numbers: Any, n: Any) -> List[Union[int, float]]:\n        \"\"\"Orchestrates validation, sorting, and result preparation.\"\"\"\n        self.validator.validate_types(numbers, n)\n        # After type validation, we can safely cast for further processing\n        numbers_list: List[Union[int, float]] = numbers\n        n_value: int = n\n\n        # Validate preconditions using the raw numbers list and n\n        self.validator.validate_preconditions(numbers_list, n_value)\n\n        # Create domain objects for conceptual consistency\n        input_list = InputList(numbers_list)\n        param_n = ParameterN(n_value)\n\n        # Sorter operates on IntegerItem instances from InputList\n        top_n_items: List[IntegerItem] = self.sorter.top_n(input_list.elements, param_n.value)\n\n        # Extract raw values from the sorted IntegerItem objects for the ResultList\n        result_values: List[Union[int, float]] = [item.value for item in top_n_items]\n        result_list = ResultList(result_values)\n        return result_list.elements\ndef heap_queue_largest(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the n largest integers from a list, returned in descending order.\n    Orchestrates validation and selection using domain classes.\n    \"\"\"\n    service = HeapQueueLargestFunction()\n    return service.compute(numbers, n)"}
