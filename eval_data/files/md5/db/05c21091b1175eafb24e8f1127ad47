{"task_id": "Mbpp/8", "solution": "from typing import List, Union\nclass Number:\n    \"\"\"A lightweight wrapper for a numeric value.\n    It stores the value as a float for consistency.\n    \"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = float(value)\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for the Number object.\"\"\"\n        return f\"Number({self.value})\"\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares Number instances by value, also allowing comparison with native numbers.\"\"\"\n        if isinstance(other, Number):\n            return self.value == other.value\n        if isinstance(other, (int, float)):\n            return self.value == float(other)\n        return NotImplemented\nclass InputList:\n    \"\"\"A wrapper for an ordered collection of numeric primitives or Number objects.\"\"\"\n    def __init__(self, elements: Union[List[Number], List[Union[int, float]]]) -> None:\n        self.elements = [Number(e) for e in elements]\n\n    def to_native(self) -> List[float]:\n        \"\"\"Converts the internal list of Number objects to a native list of floats.\"\"\"\n        return [e.value for e in self.elements]\nclass OutputList:\n    \"\"\"A wrapper for an ordered collection of Number objects representing squared values.\"\"\"\n    def __init__(self, elements: Union[List[Number], List[Union[int, float]]]) -> None:\n        self.elements = [Number(e) for e in elements]\n\n    def to_native(self) -> List[float]:\n        \"\"\"Converts the internal list of Number objects to a native list of floats.\"\"\"\n        return [e.value for e in self.elements]\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares OutputList instances, supporting direct comparison with native Python lists.\"\"\"\n        if isinstance(other, OutputList):\n            return self.elements == other.elements\n        if isinstance(other, list):\n            return self.to_native() == other\n        return NotImplemented\ndef square_nums(inputList: Union[InputList, List[Union[int, float]]]) -> List[float]:\n    \"\"\"Calculates the square of each element in the input list, returning a new list.\n    The input list is not modified, and the order of elements is preserved.\n    \"\"\"\n    numbers_to_square: List[float]\n    if isinstance(inputList, InputList):\n        numbers_to_square = inputList.to_native()\n    else:\n        # Convert all elements to float to handle various numeric types consistently.\n        numbers_to_square = [float(x) for x in inputList]\n\n    squared_values = [x * x for x in numbers_to_square]\n    \n    # As per design, an OutputList is constructed internally.\n    # The function returns its native list representation for direct comparison in tests.\n    _ = OutputList(squared_values) \n\n    return squared_values"}
{"task_id": "Mbpp/7", "solution": "import re\nfrom typing import List\nclass Word:\n    \"\"\"Represents a word/token with its text and provides its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's text.\"\"\"\n        return len(self.text)\nclass ResultList:\n    \"\"\"A wrapper for a list of string results, providing a count.\"\"\"\n    def __init__(self, words: List[str]):\n        self.words = words\n\n    def count(self) -> int:\n        \"\"\"Returns the number of words in the list.\"\"\"\n        return len(self.words)\ndef tokenize(s: str) -> List[Word]:\n    \"\"\"Tokenizes an input string into Word objects by splitting on one-or-more whitespace.\"\"\"\n    tokens = re.split(r\"\\s+\", s)\n    # Filter out any empty strings that might result from the split\n    word_objects = [Word(token) for token in tokens if token]\n    return word_objects\ndef filter_by_length(words: List[Word], min_len: int) -> List[Word]:\n    \"\"\"Filters a list of Word objects to include only those meeting a minimum length.\"\"\"\n    filtered_words = [word for word in words if word.length() >= min_len]\n    return filtered_words\ndef find_char_long(input_string: str) -> List[str]:\n    \"\"\"\n    Finds words in an input string that are at least 4 characters long.\n    It tokenizes on whitespace, filters by length, and preserves original casing.\n    \"\"\"\n    word_objects = tokenize(input_string)\n    long_word_objects = filter_by_length(word_objects, min_len=4)\n\n    # Extract the original text from the filtered Word objects\n    result_texts = [word.text for word in long_word_objects]\n\n    # Wrap in ResultList and return its raw words attribute\n    final_result_list = ResultList(result_texts)\n    return final_result_list.words"}
