{"task_id": "Mbpp/131", "solution": "VOWELS = frozenset('aeiouAEIOU')\ndef reverse_vowels(input: str) -> str:\n    \"\"\"Reverses only the vowels in an input string, preserving case and non-vowel characters.\n    Handles empty strings and strings with zero or one vowel by returning the input unchanged.\"\"\"\n    if not input:\n        return \"\"\n\n    vowel_positions = []\n    for i, char in enumerate(input):\n        if char in VOWELS:\n            vowel_positions.append(i)\n\n    if len(vowel_positions) <= 1:\n        return input\n\n    reversed_vowels_list = []\n    for idx in reversed(vowel_positions):\n        reversed_vowels_list.append(input[idx])\n\n    result_chars = list(input)\n    for i, original_vowel_idx in enumerate(vowel_positions):\n        result_chars[original_vowel_idx] = reversed_vowels_list[i]\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/131", "solution": "from src.vowel_set import VowelSet\ndef _collect_vowel_indices_and_chars(s: str, vowel_set: VowelSet) -> (list[int], list[str]):\n    \"\"\"Scans string s to collect indices and characters of all vowels.\"\"\"\n    vowel_indices = []\n    vowel_chars = []\n    for i, char in enumerate(s):\n        if vowel_set.is_vowel(char):\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n    return vowel_indices, vowel_chars\ndef _reconstruct_with_reversed_vowels(chars: list[str], vowel_indices: list[int], reversed_vowels: list[str]) -> list[str]:\n    \"\"\"Places reversed vowels into a copy of characters at their original vowel positions.\"\"\"\n    result_chars = list(chars) # Create a mutable copy of the original characters.\n    for i, original_vowel_idx in enumerate(vowel_indices):\n        result_chars[original_vowel_idx] = reversed_vowels[i]\n    return result_chars\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Return a string where only vowels are reversed in order; pure function, no side effects.\"\"\"\n    vowel_set = VowelSet()\n    original_chars_list = list(s)\n    vowel_indices, collected_vowels = _collect_vowel_indices_and_chars(s, vowel_set)\n\n    if not collected_vowels:\n        return s # No vowels to reverse.\n\n    reversed_vowels = collected_vowels[::-1]\n    result_chars = _reconstruct_with_reversed_vowels(original_chars_list, vowel_indices, reversed_vowels)\n    return \"\".join(result_chars)"}
