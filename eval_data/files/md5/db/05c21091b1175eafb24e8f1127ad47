{"task_id": "Mbpp/572", "solution": "from typing import List, Dict\ndef _build_frequency_map(input_list: List[int]) -> Dict[int, int]:\n    \"\"\"Builds a frequency map for integers in the input list.\n    Returns a dictionary mapping each integer to its count.\"\"\"\n    freq_map: Dict[int, int] = {}\n    for num in input_list:\n        freq_map[num] = freq_map.get(num, 0) + 1\n    return freq_map\ndef _filter_unique(input_list: List[int], freq_map: Dict[int, int]) -> List[int]:\n    \"\"\"Filters the input list, keeping only numbers that appear exactly once.\n    The original relative order of elements is preserved.\"\"\"\n    result_list: List[int] = []\n    for num in input_list:\n        if freq_map.get(num, 0) == 1:\n            result_list.append(num)\n    return result_list\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"Returns a list of integers that appear exactly once in the input list.\n    The original relative order of unique integers is preserved.\"\"\"\n    if not input_list:\n        return []\n\n    freq_map = _build_frequency_map(input_list)\n    result = _filter_unique(input_list, freq_map)\n    return result"}
