{"task_id": "Mbpp/749", "solution": "from typing import List\nfrom sort_numeric_strings_project.src.domain import NumericString, IntegerValue, SortResult\nclass SortService:\n    \"\"\"Service for converting and sorting numeric strings.\"\"\"\n\n    @staticmethod\n    def sort_numeric_strings(input: List[str]) -> List[int]:\n        \"\"\"Converts string inputs to integers and returns them sorted in ascending order.\"\"\"\n        parsed_ints = []\n        for s_val in input:\n            numeric_str_obj = NumericString(s_val)\n            integer_val_obj = IntegerValue(int(numeric_str_obj.value))\n            parsed_ints.append(integer_val_obj.value)\n\n        parsed_ints.sort() # Sort in ascending numeric order\n\n        result_obj = SortResult(values=parsed_ints)\n        return result_obj.values\ndef sort_numeric_strings(input: List[str]) -> List[int]:\n    \"\"\"Parses string-encoded integers to ints and returns them sorted numerically.\"\"\"\n    # Delegates to the SortService for core logic, as per design.\n    return SortService.sort_numeric_strings(input)"}
{"task_id": "Mbpp/745", "solution": "from typing import List\nMIN_INT_32 = -2_147_483_648\nMAX_INT_32 = 2_147_483_647\nclass Number:\n    \"\"\"Encapsulates an integer value and provides absolute value and digit decomposition.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def abs_value(self) -> int:\n        \"\"\"Returns the absolute value of the number.\"\"\"\n        return abs(self._value)\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns digits of abs(value) in deterministic left-to-right order.\"\"\"\n        abs_val = self.abs_value()\n        \n        if abs_val == 0:\n            return [0]\n\n        digit_list = []\n        temp_val = abs_val\n        while temp_val > 0:\n            digit_list.append(temp_val % 10)\n            temp_val //= 10\n        return digit_list[::-1] # Reverse to get left-to-right order\nclass ResultList:\n    \"\"\"Accumulate matching integers and produce a deterministic sorted list.\"\"\"\n    def __init__(self) -> None:\n        self._numbers: List[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds a number to the list.\"\"\"\n        self._numbers.append(n)\n\n    def to_sorted_list(self) -> List[int]:\n        \"\"\"Returns the accumulated numbers as a sorted list.\"\"\"\n        return sorted(self._numbers)\nclass DivisibleByDigitsService:\n    \"\"\"Orchestrate validation, range iteration, per-number digit checks, and result production.\"\"\"\n    def validate_input(self, startnum: int, endnum: int) -> None:\n        \"\"\"Validates inputs are ints within 32-bit signed range; raises ValueError on invalid input.\"\"\"\n        for num, name in [(startnum, \"startnum\"), (endnum, \"endnum\")]:\n            if not isinstance(num, int):\n                raise ValueError(f\"{name} must be an integer.\")\n            if not (MIN_INT_32 <= num <= MAX_INT_32):\n                raise ValueError(\n                    f\"{name} must be within the 32-bit signed integer range \"\n                    f\"({MIN_INT_32} to {MAX_INT_32}).\"\n                )\n\n    def is_divisible_by_its_digits(self, n: int) -> bool:\n        \"\"\"Returns True if for every decimal digit d in abs(n), d != 0 and n % d == 0.\"\"\"\n        number = Number(n)\n        digits = number.digits()\n\n        for digit_val in digits:\n            if digit_val == 0:\n                return False  # Exclude numbers containing digit 0.\n            if n % digit_val != 0:\n                return False  # Not divisible by this digit.\n        return True  # All digits passed the checks.\n\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"\n        Validates inputs, iterates inclusive range, collects numbers satisfying per-digit divisibility,\n        and returns a sorted result list.\n        \"\"\"\n        self.validate_input(startnum, endnum)\n\n        if startnum > endnum:\n            return []  # Return empty list if range is invalid.\n\n        result_list = ResultList()\n        for n in range(startnum, endnum + 1):\n            if self.is_divisible_by_its_digits(n):\n                result_list.add(n)\n        \n        return result_list.to_sorted_list()\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Public API: delegates to DivisibleByDigitsService to find numbers\n    divisible by all their non-zero digits within a range.\n    \"\"\"\n    service = DivisibleByDigitsService()\n    return service.divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input: str) -> str:\n    \"\"\"Inserts a space before uppercase letters preceded by a lowercase letter or digit.\n    Processes the string in a single pass to achieve O(n) time and space complexity.\"\"\"\n    if not input:\n        return \"\"\n\n    result_chars = []\n    # FR3: Do not insert a space before the first character of the string.\n    result_chars.append(input[0])\n\n    for i in range(1, len(input)):\n        prev_char = input[i-1]\n        curr_char = input[i]\n\n        # FR2: Insert exactly one space before each uppercase letter immediately preceded by a lowercase letter or digit.\n        # FR5: Preserve existing whitespace (do not add an extra space where one already exists).\n        # This implies that a space should only be inserted if the previous character isn't already a space.\n        if (prev_char.islower() or prev_char.isdigit()) and curr_char.isupper() and not prev_char.isspace():\n            result_chars.append(' ')\n        \n        # FR4: Preserve all other characters and casing.\n        result_chars.append(curr_char)\n\n    # FR6: Return original input unchanged if no insertion required.\n    # The construction process naturally handles this by only adding spaces when necessary.\n    # FR7: Return empty string for empty input (handled at the beginning).\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/752", "solution": "class InputValidator:\n    \"\"\"Validates input to ensure it is a non-negative integer.\"\"\"\n\n    def isNonNegativeInteger(self, value) -> bool:\n        \"\"\"Checks if the given value is a non-negative integer.\"\"\"\n        return isinstance(value, int) and value >= 0\n\n    def raiseInvalidInputError(self) -> None:\n        \"\"\"Raises a ValueError for invalid inputs.\"\"\"\n        raise ValueError(\"Input must be a non-negative integer.\")\nclass JacobsthalResult:\n    \"\"\"Holds the computed Jacobsthal number and its index.\"\"\"\n\n    def __init__(self, n: int, value: int):\n        \"\"\"Initializes with the index n and the computed value.\"\"\"\n        self.n = n\n        self.value = value\nclass JacobsthalCalculator:\n    \"\"\"Calculates Jacobsthal numbers using recurrence relation.\"\"\"\n\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"\n        Public method to compute the nth Jacobsthal number.\n        Handles base cases and delegates for n >= 2.\n        \"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        # Delegates to the iterative method for n >= 2 as recommended.\n        return self.computeIterative(n)\n\n    def computeIterative(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Jacobsthal number iteratively for n >= 2.\n        Assumes n is validated and n >= 2; base cases are handled externally.\n        \"\"\"\n        j_n_minus_2 = 0  # Represents J(i-2)\n        j_n_minus_1 = 1  # Represents J(i-1)\n\n        for _ in range(2, n + 1):\n            j_current = j_n_minus_1 + 2 * j_n_minus_2\n            j_n_minus_2 = j_n_minus_1\n            j_n_minus_1 = j_current\n        return j_n_minus_1\n\n    def computeRecursive(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Jacobsthal number recursively.\n        Assumes n is validated and handles base cases internally for standalone use.\n        \"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        return self.computeRecursive(n - 1) + 2 * self.computeRecursive(n - 2)\ndef jacobsthal_num(n) -> int:\n    \"\"\"\n    Public API function to get the nth Jacobsthal number.\n    Validates input and delegates computation to JacobsthalCalculator.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isNonNegativeInteger(n):\n        validator.raiseInvalidInputError()\n\n    calculator = JacobsthalCalculator()\n    value = calculator.jacobsthal_num(n)\n\n    result = JacobsthalResult(n, value)\n    return result.value"}
{"task_id": "Mbpp/745", "solution": "class Digit:\n    \"\"\"Simple value-holder for a decimal digit (0..9).\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Number:\n    \"\"\"Encapsulates an integer, providing digit extraction and divisibility checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> list[Digit]:\n        \"\"\"Extracts all digits of the number as Digit objects.\"\"\"\n        if self.value == 0:\n            return [Digit(0)]\n        num_str = str(abs(self.value))\n        return [Digit(int(d)) for d in num_str]\n\n    def has_zero(self) -> bool:\n        \"\"\"Checks if the number contains the digit 0.\"\"\"\n        for digit_obj in self.digits():\n            if digit_obj.value == 0:\n                return True\n        return False\n\n    def divisible_by_all_digits(self) -> bool:\n        \"\"\"Checks if the number is divisible by all its non-zero digits.\"\"\"\n        for digit_obj in self.digits():\n            digit_val = digit_obj.value\n            if digit_val != 0:\n                if self.value % digit_val != 0:\n                    return False\n        return True\nclass Validator:\n    \"\"\"Validates input parameter types, raising TypeError for non-integers.\"\"\"\n    @staticmethod\n    def validate_integer(param):\n        \"\"\"Raises TypeError if param is not an integer.\"\"\"\n        if not isinstance(param, int):\n            raise TypeError(\"Parameter must be an integer.\")\nclass InputRange:\n    \"\"\"Represents an inclusive integer range and provides range predicates.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the range is empty (startnum > endnum).\"\"\"\n        return self.startnum > self.endnum\nclass ResultList:\n    \"\"\"Collects qualifying integers, providing sorting and retrieval operations.\"\"\"\n    def __init__(self):\n        self.items: list[int] = []\n\n    def add(self, item: int):\n        \"\"\"Adds an item to the collection.\"\"\"\n        self.items.append(item)\n\n    def sort(self):\n        \"\"\"Sorts the collected items in ascending order.\"\"\"\n        self.items.sort()\n\n    def get(self) -> list[int]:\n        \"\"\"Returns the collected and sorted items.\"\"\"\n        return self.items\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers in a range divisible by every non-zero digit they contain.\n    Excludes numbers containing the digit 0 and returns results sorted ascending.\n    \"\"\"\n    Validator.validate_integer(startnum)\n    Validator.validate_integer(endnum)\n\n    rng = InputRange(startnum, endnum)\n    if rng.is_empty():\n        return []\n\n    results = ResultList()\n    for i in range(rng.startnum, rng.endnum + 1):\n        num_obj = Number(i)\n        if num_obj.has_zero():\n            continue\n        if num_obj.divisible_by_all_digits():\n            results.add(i)\n\n    results.sort()\n    return results.get()"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Computes the nth Jacobsthal number using an iterative recurrence.\n    J(0)=0, J(1)=1, and for n>=2: J(n)=J(n-1)+2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    j0, j1 = 0, 1  # Initialize J(0) and J(1)\n    # Iteratively compute J(n) for n >= 2\n    for _ in range(2, n + 1):\n        j_n = j1 + 2 * j0\n        j0 = j1\n        j1 = j_n\n    return j1"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple, Union\ndef _select_k_min(records: List[Tuple[str, Union[int, float]]], k: int) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"Sorts records by their second element and returns the first k.\n    This uses stable sort to ensure deterministic behavior for ties.\n    \"\"\"\n    sorted_records = sorted(records, key=lambda x: x[1])\n    return sorted_records[:k]\ndef min_k(records: List[Tuple[str, Union[int, float]]], k: int) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"Returns k smallest records, ordered ascending by numeric value, handling edge cases.\n    It trusts caller inputs for type correctness and focuses on selection logic.\n    \"\"\"\n    if k <= 0:\n        return []\n    if k >= len(records):\n        return sorted(records, key=lambda x: x[1])\n    \n    return _select_k_min(records, k)"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(list):\n    \"\"\"Sorts the input list in ascending order.\n    Returns the element at index 1, which is the second smallest number.\n    \"\"\"\n    sorted_list = sorted(list)\n    return sorted_list[1]"}
{"task_id": "Mbpp/757", "solution": "class StringItem:\n    \"\"\"Represents a string element with its original index and provides reversal.\"\"\"\n    def __init__(self, index: int, value: str):\n        self.index = index\n        self.value = value\n\n    def reverse(self) -> str:\n        \"\"\"Returns the character-for-character reverse of the string value.\"\"\"\n        return self.value[::-1]\nclass StringList:\n    \"\"\"Represents the input list as indexed StringItem elements and provides accessors.\"\"\"\n    def __init__(self, raw_strings: list):\n        self.items: list[StringItem] = []\n        for i, s in enumerate(raw_strings):\n            self.add(StringItem(i, s))\n\n    def add(self, item: StringItem):\n        \"\"\"Adds a StringItem to the list.\"\"\"\n        self.items.append(item)\n\n    def get(self, index: int) -> StringItem:\n        \"\"\"Retrieves a StringItem by its internal list index.\"\"\"\n        return self.items[index]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of StringItems in the list.\"\"\"\n        return len(self.items)\nclass CountResult:\n    \"\"\"Holds the integer count result of reverse pairs found.\"\"\"\n    def __init__(self, initial_count: int = 0):\n        self.count: int = initial_count\ndef count_reverse_pairs(list_of_strings: list) -> int:\n    \"\"\"Counts unordered distinct index pairs where one string is the reverse of another.\"\"\"\n    string_list = StringList(list_of_strings)\n    count_result = CountResult()\n\n    num_items = string_list.size()\n    for i in range(num_items):\n        item_i = string_list.get(i)\n        reversed_value_i = item_i.reverse()\n        for j in range(i + 1, num_items):\n            item_j = string_list.get(j)\n            if item_j.value == reversed_value_i:\n                count_result.count += 1\n    \n    return count_result.count"}
{"task_id": "Mbpp/759", "solution": "import re\nDECIMAL_REGEX: str = r'^\\d+\\.\\d{2}$'\n_compiled_decimal_pattern: re.Pattern = re.compile(DECIMAL_REGEX)\ndef is_decimal(string: str) -> bool:\n    \"\"\"Return True if 'string' matches r'^\\\\d+\\\\.\\\\d{2}$', False otherwise.\n    Uses a precompiled regex and re.fullmatch semantics for exact matching.\n    \"\"\"\n    return bool(_compiled_decimal_pattern.fullmatch(string))"}
{"task_id": "Mbpp/757", "solution": "from typing import List, Dict, Any\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to the API.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass StringListInput:\n    \"\"\"Validates and holds a list of strings for processing.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self._items = items\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a list of strings.\"\"\"\n        if not isinstance(self._items, list):\n            raise ValidationError(\"Input must be a list/array of strings.\")\n        if not all(isinstance(item, str) for item in self._items):\n            raise ValidationError(\"All elements in the list must be strings.\")\n\n    @property\n    def items(self) -> List[str]:\n        \"\"\"Returns the validated list of strings, preserving the original.\"\"\"\n        return list(self._items)\nclass ReversePairCounter:\n    \"\"\"Calculates the number of unordered reverse string pairs.\"\"\"\n    def count_reverse_pairs(self, items: List[str]) -> int:\n        \"\"\"Counts reverse pairs within a validated list of strings.\"\"\"\n        if len(items) < 2:\n            return 0\n\n        freq_map: Dict[str, int] = {}\n        for s in items:\n            freq_map[s] = freq_map.get(s, 0) + 1\n\n        return self._computePairs(freq_map)\n\n    def _computePairs(self, freq_map: Dict[str, int]) -> int:\n        \"\"\"Computes reverse pairs from a frequency map, avoiding double-counting.\"\"\"\n        total_pairs = 0\n        processed_keys: set[str] = set()\n\n        for s, s_count in freq_map.items():\n            if s in processed_keys:\n                continue\n\n            r = s[::-1] # Python's slice [::-1] handles Unicode string reversal.\n\n            if r in freq_map:\n                r_count = freq_map[r]\n\n                if s == r: # Palindrome case: count pairs among themselves.\n                    total_pairs += (s_count * (s_count - 1)) // 2\n                else: # Non-palindrome case: count pairs between s and r.\n                    total_pairs += s_count * r_count\n                \n                processed_keys.add(r) # Mark reverse as processed to avoid double counting.\n            \n            processed_keys.add(s) # Mark current string as processed.\n\n        return total_pairs\ndef count_reverse_pairs(list_of_strings: List[Any]) -> int:\n    \"\"\"\n    Counts unordered index pairs (i < j) where one string equals the reverse of the other.\n    Validates input, preserves the input list, and handles Unicode correctly.\n    \"\"\"\n    validator = StringListInput(list_of_strings)\n    validator.validate() # Raises ValidationError if input is invalid.\n\n    counter = ReversePairCounter()\n    return counter.count_reverse_pairs(validator.items)"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"Calculates the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    polite_count = 0\n    current_num = 1\n\n    while True:\n        # Check if current_num is a power of two: x > 0 and (x & (x - 1)) == 0.\n        is_power_of_two = current_num > 0 and (current_num & (current_num - 1)) == 0\n\n        if not is_power_of_two:\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
