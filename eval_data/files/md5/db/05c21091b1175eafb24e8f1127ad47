{"task_id": "Mbpp/589", "solution": "from math import sqrt, ceil\nclass RangeInput:\n    \"\"\"\n    Data holder for the start and end of a range.\n    \"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\nclass PerfectSquareList:\n    \"\"\"\n    Result container for an ordered list of integer perfect squares.\n    \"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def count(self) -> int:\n        \"\"\"Returns the number of perfect squares in the list.\"\"\"\n        return len(self.values)\nclass PerfectSquareCalculator:\n    \"\"\"\n    Domain service for computing perfect squares within a given range.\n    \"\"\"\n    def compute(self, range_input: RangeInput) -> PerfectSquareList:\n        \"\"\"\n        Calculates all perfect squares within the range_input.start and range_input.end (inclusive).\n        \"\"\"\n        perfect_squares_found = []\n        \n        # Determine the initial integer 'n' to start squaring.\n        # If start <= 0, the first potential perfect square (0*0=0) is >= start.\n        # If start > 0, we calculate ceil(sqrt(start)) to find the smallest n such that n*n >= start.\n        current_n = 0\n        if range_input.start > 0:\n            current_n = ceil(sqrt(range_input.start))\n\n        # Iterate while the square of 'n' is within the upper bound 'end'.\n        while current_n * current_n <= range_input.end:\n            perfect_squares_found.append(int(current_n * current_n))\n            current_n += 1\n            \n        return PerfectSquareList(perfect_squares_found)\ndef perfect_squares(start, end) -> list[int]:\n    \"\"\"\n    Finds all integer perfect squares within the inclusive range [start, end].\n    \"\"\"\n    # Validate inputs are integers as per FR2 of the design specification.\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"Inputs 'start' and 'end' must be integers.\")\n\n    # If start > end, return an empty list as per design decision.\n    if start > end:\n        return []\n\n    range_input = RangeInput(start, end)\n    calculator = PerfectSquareCalculator()\n    perfect_square_list = calculator.compute(range_input)\n    \n    # The collection algorithm naturally ensures values are sorted in ascending order (FR4).\n    return perfect_square_list.values"}
