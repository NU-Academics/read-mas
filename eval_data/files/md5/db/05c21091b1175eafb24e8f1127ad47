{"task_id": "Mbpp/137", "solution": "from typing import List, Sequence\nfrom src.domain import IntegerElement, IntegerArray, Result\nclass ZeroCountService:\n    \"\"\"Service to count zeros and non-zeros and compute their ratio.\"\"\"\n\n    def zero_count(self, arr: Sequence) -> float:\n        \"\"\"\n        Validates input, counts zeros/non-zeros, and computes the ratio.\n        Raises TypeError or ValueError for invalid inputs or conditions.\n        \"\"\"\n        if not isinstance(arr, Sequence):\n            raise TypeError(\"Input must be a sequence.\")\n\n        raw_integers: List[int] = []\n        for item in arr:\n            if not isinstance(item, int):\n                raise TypeError(f\"All elements in the array must be integers, found {type(item).__name__}.\")\n            raw_integers.append(item)\n\n        if not raw_integers:\n            raise ValueError(\"Input array cannot be empty.\")\n\n        integer_array = IntegerArray(raw_integers)\n\n        zero_count = 0\n        nonzero_count = 0\n\n        for element in integer_array.elements:\n            if element.is_zero():\n                zero_count += 1\n            else:\n                nonzero_count += 1\n\n        if nonzero_count == 0:\n            raise ValueError(\"Array must contain at least one non-zero element to compute ratio.\")\n\n        result = Result(zero_count, nonzero_count)\n        return result.ratio\n_zero_count_service = ZeroCountService()\ndef zero_count(arr: Sequence) -> float:\n    \"\"\"\n    Module-level function to calculate the ratio of zeros to non-zeros in an array.\n    Delegates the core logic to ZeroCountService.\n    \"\"\"\n    return _zero_count_service.zero_count(arr)"}
