{"task_id": "Mbpp/626", "solution": "import typing\nclass RadiusInput:\n    \"\"\"Encapsulates input value. is_valid() method is simplified per critical requirements.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the input is valid. Always returns True as per critical requirements.\"\"\"\n        # Per critical requirements, isinstance checks are forbidden.\n        return True\nclass Semicircle:\n    \"\"\"Domain holder for the radius of a semicircle.\"\"\"\n    def __init__(self, radius: float):\n        self.radius = radius\nclass Triangle:\n    \"\"\"Computes the maximum inscribed triangle area.\"\"\"\n    def compute_max_area(self, semi: Semicircle) -> float:\n        \"\"\"Calculates the area of the largest inscribed triangle.\"\"\"\n        r = semi.radius\n        if r > 0:\n            return r * r\n        return 0.0\nclass Result:\n    \"\"\"Represents the computed area result for traceability.\"\"\"\n    def __init__(self, area: typing.Optional[float]):\n        self.area = area\nclass TriangleAreaService:\n    \"\"\"Stateless service that orchestrates validation and area computation.\"\"\"\n    def triangle_area(self, radius: typing.Union[int, float]) -> typing.Optional[float]:\n        \"\"\"Orchestrates area calculation based on radius input.\"\"\"\n        ri = RadiusInput(radius)\n        # RadiusInput.is_valid() is called as per design sequence.\n        _ = ri.is_valid() \n\n        if radius < 0:\n            # Handles negative radius as per FR4.\n            result_obj = Result(None)\n            return result_obj.area\n        \n        # Radius is >= 0 and assumed numeric per critical requirements.\n        semi = Semicircle(float(radius))\n        tri = Triangle()\n        area = tri.compute_max_area(semi)\n        \n        result_obj = Result(area)\n        return result_obj.area\ndef triangle_area(radius: typing.Union[int, float]) -> typing.Optional[float]:\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Delegates to TriangleAreaService for core logic.\n    \"\"\"\n    service = TriangleAreaService()\n    return service.triangle_area(radius)"}
{"task_id": "Mbpp/629", "solution": "def isEven(n) -> bool:\n    \"\"\"Return True if n % 2 == 0, otherwise False.\"\"\"\n    return (n % 2 == 0)\ndef Split(numbers: list) -> list:\n    \"\"\"Accepts a list of numbers and returns a list of even numbers, preserving original order.\"\"\"\n    even_numbers = []\n    for n in numbers:\n        if isEven(n):\n            even_numbers.append(n)\n    return even_numbers"}
{"task_id": "Mbpp/629", "solution": "def _filter_even(input_list):\n    \"\"\"\n    Filters a list to return only even numbers, preserving relative order.\n    This is an internal helper function.\n    \"\"\"\n    even_elements = []\n    for element in input_list:\n        if element % 2 == 0:\n            even_elements.append(element)\n    return even_elements\ndef Split(input_list):\n    \"\"\"\n    Returns a new list containing only the even elements from the input list.\n    The original relative order of elements is preserved.\n    \"\"\"\n    return _filter_even(input_list)"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate):\n    \"\"\"\n    Extracts the 3x3 grid of coordinates centered on the provided (x, y) tuple.\n    Coordinates are ordered row-major from top-left to bottom-right.\n    \"\"\"\n    x, y = coordinate\n    result = []\n    for dx in range(-1, 2):  # Iterates dx from -1 to 1 for rows\n        for dy in range(-1, 2):  # Iterates dy from -1 to 1 for columns\n            result.append([x + dx, y + dy])\n    return result"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord):\n    \"\"\"Computes a 3x3 grid of coordinates centered on the input (x, y).\n    Returns a row-major ordered list of nine coordinate pairs.\n    \"\"\"\n    x, y = coord\n    \n    result = [\n        [x - 1, y - 1], [x - 1, y], [x - 1, y + 1],\n        [x, y - 1],     [x, y],     [x, y + 1],\n        [x + 1, y - 1], [x + 1, y], [x + 1, y + 1]\n    ]\n    \n    return result"}
{"task_id": "Mbpp/631", "solution": "from .replace_spaces import replace_spaces\nimport pytest\nfrom src.replace_spaces import replace_spaces\nclass ValidationResult:\n    \"\"\"Holds the result of an input validation, indicating validity and an error message if invalid.\"\"\"\n    def __init__(self, is_valid: bool, error_message: str):\n        self.is_valid = is_valid\n        self.error_message = error_message\nclass ReplaceSpacesFunction:\n    \"\"\"Encapsulates the logic for validating input and performing atomic character swaps.\"\"\"\n\n    def replace(self, input_string: str) -> str:\n        \"\"\"\n        Orchestrates input validation and character transformation.\n        Raises TypeError if the input is not a string.\n        \"\"\"\n        validation = self._validate(input_string)\n        if not validation.is_valid:\n            raise TypeError(validation.error_message)\n        return self._transform(input_string)\n\n    def _validate(self, input_string: str) -> ValidationResult:\n        \"\"\"\n        Validates if the input is a string.\n        Returns a ValidationResult indicating validity.\n        \"\"\"\n        if isinstance(input_string, str):\n            return ValidationResult(True, '')\n        return ValidationResult(False, 'input must be a string')\n\n    def _transform(self, input_string: str) -> str:\n        \"\"\"\n        Performs a single-pass character mapping to atomically swap spaces and underscores.\n        This approach prevents double-replacement collisions.\n        \"\"\"\n        transformed_chars = []\n        for char in input_string:\n            if char == ' ':\n                transformed_chars.append('_')\n            elif char == '_':\n                transformed_chars.append(' ')\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces spaces with underscores and vice versa in the input string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    return ReplaceSpacesFunction().replace(input_string)"}
{"task_id": "Mbpp/631", "solution": "def isWhitespace(ch: str) -> bool:\n    \"\"\"Checks if a character is considered whitespace (space, tab, newline, etc.).\"\"\"\n    return ch in (' ', '\\t', '\\n', '\\r', '\\v', '\\f')\ndef isUnderscore(ch: str) -> bool:\n    \"\"\"Checks if a character is an underscore.\"\"\"\n    return ch == '_'\ndef replace_spaces(input: str) -> str:\n    \"\"\"\n    Applies character substitutions based on content, prioritizing whitespace to underscore.\n    If no whitespace, replaces underscores with spaces; otherwise, returns input unchanged.\n    \"\"\"\n    has_whitespace = False\n    has_underscore = False\n\n    # First pass: determine presence of whitespace or underscores according to precedence.\n    for char in input:\n        if isWhitespace(char):\n            has_whitespace = True\n            break  # Whitespace takes precedence (BR9), so no need to check further for this rule.\n        if isUnderscore(char):\n            has_underscore = True\n\n    # Apply transformation based on detected conditions and precedence.\n    if has_whitespace:\n        # FR2: If input contains any whitespace, replace all with underscores.\n        output_chars = []\n        for char in input:\n            if isWhitespace(char):\n                output_chars.append('_')\n            else:\n                output_chars.append(char)\n        return \"\".join(output_chars)\n    elif has_underscore:\n        # FR3: If no whitespace but has underscores, replace all underscores with spaces.\n        output_chars = []\n        for char in input:\n            if isUnderscore(char):\n                output_chars.append(' ')\n            else:\n                output_chars.append(char)\n        return \"\".join(output_chars)\n    else:\n        # FR4: Otherwise (neither whitespace nor underscore), return input unchanged.\n        return input"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"\n    Moves all elements equal to 0 to the end of the list while preserving\n    the relative order of non-zero elements. Returns a new list.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(element)\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
{"task_id": "Mbpp/633", "solution": "def _normalize_n(values, n):\n    \"\"\"\n    Normalizes n to be within the valid range [0, len(values)].\n    Handles various n values by truncating or setting to zero.\n    \"\"\"\n    normalized_n = max(0, min(n, len(values)))\n    return normalized_n\ndef _sum_pairwise_xor_by_bit(values, n):\n    \"\"\"\n    Computes the sum of bitwise XOR of every unique unordered pair\n    among the first n elements using a bit-counting approach.\n    \"\"\"\n    total_xor_sum = 0\n    if n <= 1:\n        return 0\n\n    max_val = 0\n    if values[:n]:\n        max_val = max(values[:n])\n    \n    # Process bits up to the maximum required, using a practical upper bound.\n    max_effective_bits = min(max_val.bit_length(), 60) \n\n    for b in range(max_effective_bits):\n        count_set_bit = 0\n        for i in range(n):\n            if (values[i] >> b) & 1:\n                count_set_bit += 1\n        \n        count_unset_bit = n - count_set_bit\n        total_xor_sum += count_set_bit * count_unset_bit * (1 << b)\n            \n    return total_xor_sum\ndef pair_xor_Sum(list, n):\n    \"\"\"\n    Calculates the sum of XOR of all unique unordered pairs among the first n elements.\n    It normalizes 'n' and then uses an efficient bit-counting algorithm.\n    \"\"\"\n    values = list\n\n    normalized_n = _normalize_n(values, n)\n\n    if normalized_n <= 1:\n        return 0\n    \n    return _sum_pairwise_xor_by_bit(values, normalized_n)"}
