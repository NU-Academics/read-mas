{"task_id": "Mbpp/800", "solution": "from dataclasses import dataclass\nfrom typing import Iterator\nclass WhitespaceCharacter:\n    \"\"\"Provides a utility to check if a character is whitespace.\"\"\"\n    codepoint: str = ''\n    description: str = ''\n\n    @staticmethod\n    def is_whitespace(char: str) -> bool:\n        \"\"\"Determines if a character is a Unicode whitespace character.\"\"\"\n        return char.isspace()\ndef _build_output(chars: Iterator[str]) -> str:\n    \"\"\"Concatenates an iterator of characters into a single string.\"\"\"\n    return \"\".join(chars)\ndef remove_all_spaces(input_string: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from the input string, preserving order.\n    Whitespace includes standard ASCII and Unicode whitespace.\n    \"\"\"\n    non_whitespace_chars = []\n    for char in _iter_characters(input_string):\n        if not WhitespaceCharacter.is_whitespace(char):\n            non_whitespace_chars.append(char)\n    return _build_output(iter(non_whitespace_chars))"}
{"task_id": "Mbpp/799", "solution": "class BitRotator:\n    def maskTo32(self, n: int) -> int:\n        \"\"\"Masks an integer to its 32-bit unsigned representation.\"\"\"\n        return n & 0xFFFFFFFF\n\n    def normalizeCount(self, d: int) -> int:\n        \"\"\"Normalizes the rotation count to be within 0-31.\"\"\"\n        return d % 32\n\n    def left_rotate(self, n: int, d: int) -> int:\n        \"\"\"Performs a 32-bit circular left rotation using domain objects.\"\"\"\n        # Mask input using UInt32 (FR2).\n        initial_uint32 = UInt32(n)\n        n_masked = initial_uint32.mask()\n\n        # Normalize rotation count using RotationCount (FR3).\n        rotation_count_obj = RotationCount(d)\n        effective_d = rotation_count_obj.normalize()\n\n        # Handle d == 0 (or effective_d == 0) by returning masked input (FR6).\n        if effective_d == 0:\n            result_val = ResultValue(n_masked)\n            return result_val.mask() # Ensure 32-bit output (FR5)\n\n        # Perform circular left shift (FR4).\n        rotated_value = (n_masked << effective_d) | (n_masked >> (32 - effective_d))\n\n        # Mask the output to ensure it remains a 32-bit integer (FR5).\n        final_result_obj = ResultValue(rotated_value)\n        return final_result_obj.mask()\nclass UInt32:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes a 32-bit unsigned value object.\"\"\"\n        self.value = value\n\n    def mask(self) -> int:\n        \"\"\"Masks the internal value to 32 bits.\"\"\"\n        return self.value & 0xFFFFFFFF\nclass RotationCount:\n    def __init__(self, d: int) -> None:\n        \"\"\"Initializes a rotation count value object.\"\"\"\n        self.d = d\n\n    def normalize(self) -> int:\n        \"\"\"Normalizes the rotation count modulo 32.\"\"\"\n        return self.d % 32\nclass ResultValue:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes a result value object.\"\"\"\n        self.value = value\n\n    def mask(self) -> int:\n        \"\"\"Masks the internal result value to 32 bits.\"\"\"\n        return self.value & 0xFFFFFFFF\ndef left_rotate(n: int, d: int) -> int:\n    \"\"\"Public API: Rotates a 32-bit value n left by d bits (FR1).\"\"\"\n    rotator = BitRotator()\n    return rotator.left_rotate(n, d)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    \"\"\"Rotates the low 32 bits of value left by d positions.\n    Inputs and outputs are treated as unsigned 32-bit integers.\n    \"\"\"\n    # MASK constant for 32-bit operations, ensuring values stay within 32 bits.\n    _MASK_32_BIT = 0xFFFFFFFF\n\n    # Mask the input value to strictly operate on its low 32 bits.\n    low32_value = value & _MASK_32_BIT\n    # Normalize the rotation count to be between 0 and 31.\n    normalized_d = d % 32\n\n    if normalized_d == 0:\n        # If the effective rotation count is zero, the value remains unchanged.\n        result = low32_value\n    else:\n        # Shift bits left, and mask to capture only the bits that stay within the 32-bit boundary.\n        left_part = (low32_value << normalized_d) & _MASK_32_BIT\n        # Shift bits right to capture the bits that \"wrapped around\" from the left shift.\n        right_part = (low32_value >> (32 - normalized_d))\n        # Combine the left-shifted and wrap-around parts to form the rotated value.\n        result = (left_part | right_part)\n\n    # Mask the final result to guarantee it is within the 32-bit unsigned range.\n    return result & _MASK_32_BIT"}
{"task_id": "Mbpp/801", "solution": "def compare_values(a, b, c) -> int:\n    \"\"\"Returns 3 if a==b==c, 2 if exactly two values are equal, else 0.\n    Performs a fixed number of comparisons.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Validates three integer inputs and returns the count of equal values among them.\n    Returns 3 when all three equal, 2 when exactly two equal, and 0 when all different.\"\"\"\n    validate_args(a, b, c)\n    return compare_values(a, b, c)"}
{"task_id": "Mbpp/803", "solution": "import math\nfrom typing import Optional\nclass Number:\n    \"\"\"Represents an integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    @staticmethod\n    def validate_integer(n) -> None:\n        \"\"\"Raises TypeError if n is not an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\nclass PerfectSquareChecker:\n    \"\"\"Determines if a number is a perfect square using integer arithmetic.\"\"\"\n    def is_perfect_square(self, n: int) -> bool:\n        \"\"\"Checks if n is a perfect square.\"\"\"\n        if n < 0:\n            return False\n\n        k = self._compute_integer_sqrt(n)\n        return (k * k == n)\n\n    def _compute_integer_sqrt(self, n: int) -> int:\n        \"\"\"Computes floor(sqrt(n)) using integer arithmetic.\"\"\"\n        if n < 0:\n            raise ValueError(\"Cannot compute sqrt of negative number.\")\n        if n == 0 or n == 1:\n            return n\n\n        low, high = 0, n // 2 + 1\n        ans = 0\n        while low <= high:\n            mid = (low + high) // 2\n            if mid * mid == n:\n                return mid\n            elif mid * mid < n:\n                ans = mid\n                low = mid + 1\n            else:\n                high = mid - 1\n        return ans\ndef is_perfect_square(n) -> bool:\n    \"\"\"Public API to check if a number is a perfect square.\"\"\"\n    InputValidator.validate_integer(n)\n    number = Number(value=n)\n    checker = PerfectSquareChecker()\n    return checker.is_perfect_square(number.value)"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number) -> bool:\n    \"\"\"Checks if a given number is a perfect square.\n    Assumes positive, real numeric input, as per critical requirements.\n    \"\"\"\n    sqrt_val = number ** 0.5\n    rounded_sqrt = round(sqrt_val)\n    return (rounded_sqrt * rounded_sqrt) == number"}
{"task_id": "Mbpp/804", "solution": "from typing import List\nfrom .domain import IntegerList, ProductResult\nclass IsProductEvenService:\n    \"\"\"Service to determine if a product of integers is even, applying BR3.\"\"\"\n    def is_product_even(self, values: List[int]) -> bool:\n        \"\"\"Determines if the product of integers in the list is even using a parity check.\"\"\"\n        return any((v % 2) == 0 for v in values)\n\n    def compute_product(self, values: List[int]) -> int:\n        \"\"\"Computes the product of integers in the list.\"\"\"\n        if not values:\n            return 1\n        product = 1\n        for v in values:\n            product *= v\n        return product\ndef is_product_even(values: List[int]) -> bool:\n    \"\"\"Public API function to check if the product of numbers in a list is even.\"\"\"\n    service = IsProductEvenService()\n    return service.is_product_even(values)"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[float | int]]) -> list[float | int]:\n    \"\"\"\n    Returns the inner list from a list of lists whose arithmetic sum of elements is highest.\n    If multiple lists have the same maximal sum, the first such list encountered is returned.\n    \"\"\"\n    max_sum = sum(list_of_lists[0])\n    result = list_of_lists[0]\n\n    for inner_list in list_of_lists[1:]:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            result = inner_list\n            \n    return result"}
{"task_id": "Mbpp/806", "solution": "def _is_upper(ch: str) -> bool:\n    \"\"\"Checks if a character is an uppercase letter.\n    Uses Python's built-in str.isupper() method.\"\"\"\n    return ch.isupper()\ndef _compute_max_run(s: str) -> int:\n    \"\"\"Computes the length of the longest consecutive uppercase run.\n    Performs a single pass, tracking current and maximum run lengths.\"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if _is_upper(char):\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"Computes the length of the longest consecutive uppercase run in a string.\n    Delegates to _compute_max_run for the core logic.\"\"\"\n    # Input validation (e.g., for non-str types) is omitted as per critical requirements.\n    return _compute_max_run(s)"}
{"task_id": "Mbpp/805", "solution": "def _sum_sublist(sublist: list[float | int]) -> float:\n    \"\"\"Internal helper to compute the sum of elements in a sublist.\n    Relies on Python's built-in sum() for computation and type handling.\"\"\"\n    return float(sum(sublist))\ndef max_sum_list(input_list: list[list[float | int]]) -> list[float | int]:\n    \"\"\"Returns the sub-list from input_list whose numeric element-sum is maximal.\n    Relies on _sum_sublist to compute individual sublist sums.\"\"\"\n    return max(input_list, key=_sum_sublist)"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Any\ndef _is_even_number(n: Any) -> bool:\n    return n % 2 == 0\ndef is_product_even(numbers: List[Any]) -> bool:\n    # Handle empty list: product is 1 (odd).\n    if not numbers:\n        return False\n\n    # Short-circuit: if any element is even (including 0), the product is even.\n    for n in numbers:\n        if _is_even_number(n):\n            return True\n\n    # If no even numbers are found, all elements are odd, so their product is odd.\n    return False"}
