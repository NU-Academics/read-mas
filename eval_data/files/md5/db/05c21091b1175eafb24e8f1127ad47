{"task_id": "Mbpp/599", "solution": "from typing import Tuple\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\n    Subclasses ValueError as per design.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass InputParameter:\n    \"\"\"Represents and validates the input parameter 'n'.\n    Ensures 'n' is an integer >= 1.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if n is an integer and positive.\n        Returns True if valid, False otherwise.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\n    def validate_or_raise(self) -> None:\n        \"\"\"Raises ValidationError if n is invalid.\n        Provides specific messages for type or value errors.\"\"\"\n        if not self.is_valid():\n            if not isinstance(self.n, int):\n                raise ValidationError(\"Input 'n' must be an integer.\")\n            else: # n is int but less than 1\n                raise ValidationError(\"Input 'n' must be greater than or equal to 1.\")\nclass CalculationResult:\n    \"\"\"Data carrier for computed sum and average.\n    Holds sum (int) and average (float).\"\"\"\n    def __init__(self, sum_val: int, average_val: float):\n        self.sum = sum_val\n        self.average = average_val\nclass SumAverageFunction:\n    \"\"\"Encapsulates the calculation logic for sum and average.\n    Computes sum via formula and average as sum/n.\"\"\"\n    def calculate(self, n: int) -> CalculationResult:\n        \"\"\"Computes sum and average for first 'n' natural numbers.\n        Returns a CalculationResult object.\"\"\"\n        total_sum = n * (n + 1) // 2  # Integer sum calculation\n        average = total_sum / n      # Float average calculation\n        return CalculationResult(total_sum, average)\ndef sum_average(n) -> Tuple[int, float]:\n    \"\"\"Public API to calculate sum and average of first n natural numbers.\n    Validates input 'n', performs calculation, and returns (sum, average).\"\"\"\n    input_param = InputParameter(n)\n    input_param.validate_or_raise()\n\n    calculator = SumAverageFunction()\n    result = calculator.calculate(n)\n\n    return (result.sum, result.average)"}
