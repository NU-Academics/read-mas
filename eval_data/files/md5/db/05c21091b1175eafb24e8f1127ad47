{"task_id": "Mbpp/731", "solution": "import math\nclass Cone:\n    \"\"\"Data container for cone dimensions r (radius) and h (height).\"\"\"\n    def __init__(self, r: float, h: float) -> None:\n        self.r = r\n        self.h = h\nclass LateralSurfaceCalculation:\n    \"\"\"Computes the lateral surface area of a cone.\"\"\"\n    formula: str = \"pi * r * sqrt(r^2 + h^2)\"\n\n    def compute(self, cone: Cone) -> float:\n        \"\"\"Calculates the lateral surface area for a given Cone object.\"\"\"\n        return math.pi * cone.r * math.sqrt(cone.r**2 + cone.h**2)\nclass Result:\n    \"\"\"Container for a computed floating-point value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a right circular cone.\n    Uses the formula pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    cone = Cone(r, h)\n    calc = LateralSurfaceCalculation()\n    computed_value = calc.compute(cone)\n    result_obj = Result(value=computed_value)\n    return result_obj.value"}
{"task_id": "Mbpp/732", "solution": "from dataclasses import dataclass\nfrom typing import FrozenSet\nclass ReplaceSpecialcharFunction:\n    \"\"\"Encapsulates character replacement rules and performs the string transformation.\"\"\"\n\n    def __init__(self) -> None:\n        self._replacement_chars: FrozenSet[str] = frozenset({' ', ',', '.'})\n        self._replacement_char: str = ':'\n\n    def replace(self, input_str: str) -> str:\n        \"\"\"\n        Replaces specified characters in the input string with the replacement character.\n        All other characters are preserved.\n        \"\"\"\n        transformed = input_str\n        for char_to_replace in self._replacement_chars:\n            transformed = transformed.replace(char_to_replace, self._replacement_char)\n        return transformed\ndef replace_specialchar(input: str) -> str:\n    \"\"\"\n    Public API: Accepts a string and returns the transformed string.\n    Spaces, commas, and dots are replaced by colons.\n    \"\"\"\n    replacer = ReplaceSpecialcharFunction()\n    return replacer.replace(input)"}
{"task_id": "Mbpp/732", "solution": "_REPLACEMENT: dict[str, str] = {' ': ':', ',': ':', '.': ':'}\ndef replace_specialchar(input: str) -> str:\n    \"\"\"Return a new string where every ' ', ',', and '.' in input is replaced by ':'.\n    If input is empty, return empty string.\n    \"\"\"\n    if not input:\n        return \"\"\n    \n    out_chars = []\n    for char_val in input:\n        out_chars.append(_REPLACEMENT.get(char_val, char_val))\n        \n    return ''.join(out_chars)"}
{"task_id": "Mbpp/733", "solution": "from typing import Sequence\nfrom dataclasses import dataclass\ndef find_first_occurrence(arr: Sequence[float], target: float) -> int:\n    \"\"\"\n    Finds the zero-based index of the first occurrence of the target in a sorted array.\n    Returns -1 if the target is not present or the array is empty.\n    \"\"\"\n    if not arr:\n        return -1\n\n    low, high = 0, len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n    \n    return result"}
{"task_id": "Mbpp/733", "solution": "def _binary_search_leftmost(array_of_numbers: list[int], target_number: int) -> int:\n    \"\"\"\n    Finds the leftmost index of the target in a sorted array using a binary search variant.\n    Returns the 0-based index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array_of_numbers) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        \n        if array_of_numbers[mid] == target_number:\n            result_index = mid  # Found a potential leftmost occurrence\n            high = mid - 1      # Try to find an even earlier occurrence in the left half\n        elif array_of_numbers[mid] < target_number:\n            low = mid + 1       # Target is in the right half\n        else:  # array_of_numbers[mid] > target_number\n            high = mid - 1      # Target is in the left half\n            \n    return result_index\ndef find_first_occurrence(array_of_numbers: list[int], target_number: int) -> int:\n    \"\"\"\n    Returns the 0-based index of the leftmost occurrence of target_number in array_of_numbers.\n    Returns -1 if the target_number is not found.\n    \"\"\"\n    return _binary_search_leftmost(array_of_numbers, target_number)"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Union\nclass ListInput:\n    \"\"\"Encapsulates and provides access to the input list of numbers.\"\"\"\n    def __init__(self, numbers: list) -> None:\n        self.numbers = numbers\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated list.\"\"\"\n        return len(self.numbers)\n\n    def validate(self) -> bool:\n        \"\"\"Validates the input list, but performs no checks due to critical requirements.\"\"\"\n        return True\nclass Subarray:\n    \"\"\"Represents a contiguous slice of numbers and computes its product.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, values: list) -> None:\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.values = values\n\n    def product(self) -> Union[float, int]:\n        \"\"\"Computes the product of all values in the subarray.\"\"\"\n        if not self.values:\n            return 0\n        res: Union[float, int] = 1\n        for val in self.values:\n            res *= val\n        return res\nclass Product:\n    \"\"\"A value object for a computed product.\"\"\"\n    def __init__(self, value: Union[float, int]) -> None:\n        self.value = value\nclass SumResult:\n    \"\"\"An accumulator for product values.\"\"\"\n    def __init__(self) -> None:\n        self.total: Union[float, int] = 0\n\n    def add(self, value: Union[float, int]) -> None:\n        \"\"\"Adds a value to the accumulated total.\"\"\"\n        self.total += value\nclass SumOfSubarrayProdFunction:\n    \"\"\"Orchestrates the enumeration, computation, and aggregation of subarray products.\"\"\"\n    name: str = \"sum_Of_Subarray_Prod\"\n\n    def execute(self, input_data: ListInput) -> SumResult:\n        \"\"\"Executes the core logic to find the sum of all subarray products.\"\"\"\n        sum_result = SumResult()\n        n = input_data.length()\n\n        for start in range(n):\n            for end in range(start, n):\n                values = input_data.numbers[start:end+1]\n                sub = Subarray(start, end, values)\n                p_val = sub.product()\n                prod = Product(p_val)\n                sum_result.add(prod.value)\n        return sum_result\ndef sum_Of_Subarray_Prod(numbers: list) -> Union[float, int]:\n    \"\"\"\n    Computes the sum of products of all contiguous sublists of a given list.\n    Validates input, then orchestrates the calculation.\n    \"\"\"\n    input_data = ListInput(numbers)\n    # The validate method exists as per design, but performs no checks due to critical requirements.\n    input_data.validate()\n    \n    orchestrator = SumOfSubarrayProdFunction()\n    result = orchestrator.execute(input_data)\n    \n    return result.total"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Iterator, Tuple, Union\ndef _product_of_slice(input_list: List[Union[int, float]], start: int, end: int) -> Union[int, float]:\n    \"\"\"Computes the product of elements in input_list from start to end (inclusive).\n    Returns 1 for the product of an empty slice (multiplicative identity).\"\"\"\n    current_product: Union[int, float] = 1\n    for i in range(start, end + 1):\n        current_product *= input_list[i]\n    return current_product\ndef sum_Of_Subarray_Prod(input_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Computes the sum of products of all contiguous subarrays.\n    Validates input, generates subarray index ranges, computes products, and accumulates the total sum.\"\"\"\n    _validate_input(input_list)\n\n    total_sum: Union[int, float] = 0\n    list_length = len(input_list)\n\n    if list_length == 0:\n        return 0\n\n    for start, end in _generate_subarrays(list_length):\n        product = _product_of_slice(input_list, start, end)\n        total_sum += product\n    \n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def _generate_middle_mask(bit_length: int) -> int:\n    \"\"\"Returns integer mask with 1s in middle-bit positions for a value of `bit_length`; 0 in MSB and LSB positions.\"\"\"\n    # A mask of `bit_length` ones (e.g., 11111 for bit_length=5) would be (1 << bit_length) - 1.\n    # To get `011...10`, we start with `100...0` (1 << (bit_length - 1)), subtract 1 to get `011...1`,\n    # then subtract 1 again to get `011...10`.\n    return ((1 << (bit_length - 1)) - 1) - 1\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles all bits of a non-negative integer n except its most significant and least significant bits.\n    Returns n unchanged if its binary length is less than 3.\"\"\"\n    bit_length = n.bit_length()\n\n    if bit_length < 3:\n        return n\n    else:\n        mask = _generate_middle_mask(bit_length)\n        return n ^ mask"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits strictly between the MSB and LSB of a non-negative integer.\n    Returns the original input if its binary representation has fewer than 3 bits.\n    \"\"\"\n    bit_length = n.bit_length()\n\n    if bit_length < 3:\n        return n\n\n    # Create a mask with ones in all positions except MSB (leftmost) and LSB (rightmost).\n    # (1 << (bit_length - 1)) - 1 creates a sequence of ones from position 0 up to (bit_length - 2).\n    # XORing with 1 clears the LSB (position 0), leaving ones only for the middle bits.\n    middle_mask = ((1 << (bit_length - 1)) - 1) ^ 1\n    \n    # XOR 'n' with the middle_mask to toggle only the bits covered by the mask.\n    return n ^ middle_mask"}
