{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"Return the first character that appears more than once in the input string.\n    Returns an empty string '' if no character repeats.\n    \"\"\"\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return ''"}
{"task_id": "Mbpp/602", "solution": "def _scan_and_find(s: str) -> tuple[int, str]:\n    \"\"\"Scans string to find the character with the minimal second occurrence index.\"\"\"\n    seen_index: dict[str, int] = {}\n    # Initialize min_second_occurrence_index to a value greater than any possible index.\n    min_second_occurrence_index = len(s) \n    first_repeated_char_candidate = \"\"\n\n    for idx, char in enumerate(s):\n        if char in seen_index:\n            # This is a second (or later) occurrence.\n            if idx < min_second_occurrence_index:\n                min_second_occurrence_index = idx\n                first_repeated_char_candidate = char\n        else:\n            # This is the first occurrence. Record its index using the helper.\n            _update_seen(seen_index, char, idx)\n\n    return min_second_occurrence_index, first_repeated_char_candidate\ndef first_repeated_char(s: str) -> str:\n    \"\"\"\n    Finds the first repeated character in a string, defined by the minimal\n    second occurrence index. Behavior for no repeats is unspecified.\n    \"\"\"\n    # The _scan_and_find helper returns a tuple of (minimal_second_index, character).\n    _, char_candidate = _scan_and_find(s)\n    return char_candidate"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Computes ludic numbers less than or equal to n using a generation + elimination algorithm.\n    All internal components are nested within this function as per strict requirements.\n    \"\"\"\n\n    class InputValidator:\n        # Input validation simplified as per critical requirements to trust caller's input.\n        def is_integer(self, x) -> bool:\n            return True\n\n        def is_nonnegative(self, x: int) -> bool:\n            return True\n\n    class LudicNumber:\n        # Domain value object for a single ludic number.\n        def __init__(self, value: int):\n            self.value = value\n\n    class ResultList:\n        # Encapsulates a list of ludic numbers.\n        def __init__(self, numbers: list[int]):\n            self.numbers = numbers\n\n        def to_list(self) -> list[int]:\n            return self.numbers\n\n    class LudicService:\n        # Orchestrates validation and the ludic number computation algorithm.\n        def __init__(self) -> None:\n            self._validator = InputValidator()\n\n        def get_ludic(self, n_param: int) -> list[int]:\n            # Validation is conceptually performed but no runtime checks due to constraints.\n            if n_param <= 0:\n                return []\n\n            initial_sequence = self._generate_sequence(n_param)\n            ludic_numbers_computed = self._apply_elimination(initial_sequence)\n            return ResultList(ludic_numbers_computed).to_list()\n\n        def _generate_sequence(self, limit: int) -> list[int]:\n            # Produces the initial candidate sequence for sieving.\n            return list(range(1, limit + 1))\n\n        def _apply_elimination(self, initial_sequence: list[int]) -> list[int]:\n            # Applies the ludic elimination algorithm to find ludic numbers.\n            numbers_to_sieve = list(initial_sequence)\n            ludics = []\n\n            while numbers_to_sieve:\n                current_ludic = numbers_to_sieve.pop(0)\n                ludics.append(current_ludic)\n\n                if current_ludic == 1:\n                    continue  # The number 1 is ludic but does not eliminate others itself.\n\n                next_numbers_to_sieve = []\n                count_in_current_list = 0\n                for num in numbers_to_sieve:\n                    count_in_current_list += 1\n                    if count_in_current_list % current_ludic != 0:\n                        next_numbers_to_sieve.append(num)\n                numbers_to_sieve = next_numbers_to_sieve\n            return ludics\n\n    # Public API entry point logic, delegating to the LudicService.\n    service_instance = LudicService()\n    return service_instance.get_ludic(n)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, using a single ASCII space as a delimiter.\n    Preserves characters within each word and handles empty tokens from spaces.\n    \"\"\"\n    words = input.split(' ')\n    reversed_words = reversed(words)\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"Return a string where the order of words (delimited by U+0020) in the input is reversed.\n    Tokenization uses the single space character. Characters within tokens are preserved.\n    \"\"\"\n    words = input.split(' ')\n    reversed_words = words[::-1]\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/603", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Computes and returns all ludic numbers less than or equal to n.\n    The numbers are returned in ascending order.\n    \"\"\"\n    if n < 1:\n        return []\n\n    ludic_numbers = []\n    \n    # The first ludic number is always 1.\n    if n >= 1:\n        ludic_numbers.append(1)\n        \n    # If n is 1, we've found all ludic numbers up to n.\n    if n == 1:\n        return ludic_numbers\n        \n    # Initialize candidates for sieving, starting from 2 up to n.\n    # The sieve process removes elements based on their position in this list.\n    candidates = list(range(2, n + 1))\n\n    # Perform the ludic sieve.\n    while candidates:\n        # The first number in the candidates list is the next ludic number.\n        next_ludic_factor = candidates[0]\n        ludic_numbers.append(next_ludic_factor)\n        \n        # Remove the current ludic number from the candidates.\n        candidates.pop(0)\n\n        # Remove every 'next_ludic_factor'-th element from the remaining candidates.\n        indices_to_remove = []\n        removal_position = next_ludic_factor - 1 # 0-indexed position\n        \n        while removal_position < len(candidates):\n            indices_to_remove.append(removal_position)\n            removal_position += next_ludic_factor\n\n        # Remove elements in reverse order to avoid issues with shifting indices.\n        for idx in reversed(indices_to_remove):\n            del candidates[idx]\n\n    return ludic_numbers"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\n    Uses trial division up to the square root of n.\"\"\"\n    if n < 2:\n        return False\n    # Iterates from 2 up to the integer part of sqrt(n).\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/605", "solution": "class IntegerInput:\n    \"\"\"Data holder for numeric input.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass PrimeChecker:\n    \"\"\"Concrete class encapsulating primality operations.\"\"\"\n    \n    def _integer_sqrt(self, n: int) -> int:\n        \"\"\"Calculates integer square root for non-negative integers.\"\"\"\n        if n < 0:\n            return 0 # Should not be reached from is_prime with valid inputs\n        if n <= 1:\n            return n\n\n        low, high = 1, n\n        ans = 1\n        while low <= high:\n            mid = (low + high) // 2\n            if mid * mid <= n:\n                ans = mid\n                low = mid + 1\n            else:\n                high = mid - 1\n        return ans\n\n    def prime_num(self, n: int) -> bool:\n        \"\"\"Public entry method; delegates to is_prime and returns bool.\"\"\"\n        input_obj = IntegerInput(n)\n        is_p = self.is_prime(input_obj.value)\n        # Result(input_obj.value, is_p) # Not directly used for the public function return\n        return is_p\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Performs primality algorithm. Tests divisibility up to sqrt(n).\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        \n        # Test odd divisors from 3 up to the integer square root of n\n        limit = self._integer_sqrt(n) + 1\n        for i in range(3, limit, 2):\n            if n % i == 0:\n                return False\n        return True\n_prime_checker_instance = PrimeChecker()\ndef prime_num(n: int) -> bool:\n    \"\"\"Delegate to PrimeChecker.prime_num and return result.\"\"\"\n    return _prime_checker_instance.prime_num(n)"}
{"task_id": "Mbpp/606", "solution": "PI = 3.141592653589793\ndef radian_degree(degrees):\n    \"\"\"\n    Convert degrees to radians using the formula: radians = degrees * PI / 180.\n    Expects a numeric input for degrees.\n    \"\"\"\n    return degrees * PI / 180"}
{"task_id": "Mbpp/606", "solution": "import math\ndef radian_degree(degrees: int | float) -> float:\n    \"\"\"Convert degrees to radians using radians = degrees * pi / 180.\n    Accepts integer or floating-point input and returns a float (double-precision where host language provides it).\n    \"\"\"\n    return float(degrees) * math.pi / 180.0"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Return the nth Bell number (zero-based): bell_Number(0) == 1.\n    Raises ValueError for invalid n (non-int or negative).\n    \"\"\"\n    # Input validation as per design specification\n    if not isinstance(n, int) or n < 0:\n        raise ValueError('n must be a non-negative integer')\n\n    # Base case for Bell triangle (B_0 = 1)\n    if n == 0:\n        return 1\n\n    # Initialize the Bell triangle using a 2D list for dynamic programming.\n    # bell[i][j] stores the j-th element in row i.\n    bell = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # The first element of the Bell triangle (B_0 = 1).\n    bell[0][0] = 1\n\n    # Fill the Bell triangle row by row.\n    for i in range(1, n + 1):\n        # The first number in the current row is the last number of the previous row.\n        bell[i][0] = bell[i-1][i-1]\n        for j in range(1, i + 1):\n            # Subsequent numbers are the sum of the number to its left\n            # and the number above and to its left.\n            bell[i][j] = bell[i][j-1] + bell[i-1][j-1]\n\n    # The nth Bell number is the first element of row n in the Bell triangle.\n    return bell[n][0]"}
{"task_id": "Mbpp/608", "solution": "class Input_Parameter:\n    \"\"\"Encapsulates the input 'n' and provides validation logic.\n    It verifies if 'n' is a non-negative integer.\"\"\"\n    def __init__(self, n: object) -> None:\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Checks if stored n is an integer and n >= 0.\n        Returns True for valid input, False otherwise.\"\"\"\n        return isinstance(self.n, int) and self.n >= 0\ndef bell_Number(n: object) -> int:\n    \"\"\"Computes the nth Bell number, which counts partitions of a set of n elements.\n    Raises ValueError if n is not a non-negative integer.\"\"\"\n    input_param = Input_Parameter(n)\n    if not input_param.validate():\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    # Use a dynamic programming approach to build the Bell triangle.\n    # The triangle stores values up to n, hence its size is n+1.\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Initialize the first element of the triangle.\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle to compute subsequent Bell numbers.\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    # The nth Bell number is the first element of the nth row.\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\nclass Text:\n    \"\"\"Represents the input text to be searched.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\nclass Pattern:\n    \"\"\"Represents the regex pattern to evaluate.\"\"\"\n    def __init__(self, regex: str) -> None:\n        self.regex = regex\nclass MatchResult:\n    \"\"\"Holds a found match with substring and indices.\"\"\"\n    def __init__(self, substring: str, startIndex: int, endIndex: int) -> None:\n        self.substring = substring\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\n    def to_tuple(self) -> Tuple[str, int, int]:\n        \"\"\"Converts the match result to a tuple.\"\"\"\n        return (self.substring, self.startIndex, self.endIndex)\nclass RegexSearcher:\n    \"\"\"Evaluates regex patterns against text content.\"\"\"\n    def find_literals(self, text: Text, pattern: Pattern) -> Optional[MatchResult]:\n        \"\"\"Searches for the first match using the host regex engine. Returns None if no match.\"\"\"\n        match = re.search(pattern.regex, text.content)\n        if match:\n            substring = match.group(0)\n            startIndex = match.start()\n            endIndex = match.end()\n            return MatchResult(substring, startIndex, endIndex)\n        return None\n_searcher = RegexSearcher()\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the first match.\n    Returns (matching_substring, start_index, end_index) or None if no match.\n    \"\"\"\n    text_obj = Text(text)\n    pattern_obj = Pattern(pattern)\n    match_result = _searcher.find_literals(text_obj, pattern_obj)\n    if match_result:\n        return match_result.to_tuple()\n    return None"}
{"task_id": "Mbpp/607", "solution": "import dataclasses\nimport re\nclass RegexEngine:\n    \"\"\"Provides an operation to evaluate a regular expression pattern against text.\"\"\"\n    def match(self, text: str, pattern: str) -> MatchResult:\n        \"\"\"Evaluate pattern against text and produce a MatchResult if a match is found.\"\"\"\n        match_obj = re.search(pattern, text)\n        # The design notes that behavior for no match is unspecified.\n        # This implementation assumes a match is always found for successful execution.\n        return MatchResult(\n            substring=match_obj.group(0),\n            start_index=match_obj.start(),\n            end_index=match_obj.end()\n        )\nclass Finder:\n    \"\"\"Coordinates searching using RegexEngine and produces results.\"\"\"\n    def __init__(self, regex_engine: RegexEngine):\n        \"\"\"Initializes Finder with a RegexEngine instance.\"\"\"\n        self.regex_engine = regex_engine\n\n    def find_literals(self, text: str, pattern: str) -> tuple[str, int, int]:\n        \"\"\"Performs the search and returns (matching_substring, start_index, end_index).\"\"\"\n        match_result = self.regex_engine.match(text, pattern)\n        return (match_result.substring, match_result.start_index, match_result.end_index)\ndef find_literals(input_text: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"SRS-required function: accepts two arguments and returns (substring, start_index, end_index).\"\"\"\n    engine = RegexEngine()\n    finder = Finder(engine)\n    return finder.find_literals(input_text, pattern)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"Remove the k'th element from lst and return a new list.\n\n    Parameters:\n      lst (list): input list (must be Python list)\n      k (int): 1-based index of element to remove\n\n    Returns:\n      list: new list with element at position k removed\n    \"\"\"\n    if not isinstance(lst, list) or not isinstance(k, int):\n        raise TypeError(\"lst must be a list and k must be an int\")\n\n    if k < 1 or k > len(lst):\n        raise IndexError(\"k out of range\")\n\n    zero_index = k - 1\n    return lst[:zero_index] + lst[zero_index+1:]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"Returns a new list with the k'th element (1-based) removed.\n    The original list is not modified, and relative order is preserved.\n    \"\"\"\n    index_to_remove = k - 1\n    return input_list[:index_to_remove] + input_list[index_to_remove + 1:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Computes the maximum value in the n'th column of the given matrix.\n    Assumes all inputs are valid and well-formed, without any error checking.\n    \"\"\"\n    column_values = [row[n] for row in matrix]\n    return max(column_values)"}
{"task_id": "Mbpp/611", "solution": "from .exceptions import EmptyMatrixException, InvalidColumnIndexException, NonNumericValueException\ndef max_of_nth(matrix, n):\n    \"\"\"Validate inputs and return maximum numeric value in column n.\n\n    Raises: EmptyMatrixException, InvalidColumnIndexException, NonNumericValueException.\n    \"\"\"\n    # 1. If matrix is not a list or is empty, raise EmptyMatrixException.\n    if not isinstance(matrix, list) or not matrix:\n        raise EmptyMatrixException(\"Input matrix cannot be empty or a non-list type.\")\n\n    # 2. Validate n is an integer and n >= 0; if not, raise InvalidColumnIndexException.\n    if not isinstance(n, int) or n < 0:\n        raise InvalidColumnIndexException(\"Column index 'n' must be a non-negative integer.\")\n\n    column_values = []\n    # Iterate through rows for validation and value extraction.\n    for i, row in enumerate(matrix):\n        # Ensure each 'row' is a list before checking its length or accessing elements.\n        if not isinstance(row, list):\n            raise InvalidColumnIndexException(f\"Row {i} is not a list.\")\n        \n        # 3. For each row in matrix: if len(row) <= n, raise InvalidColumnIndexException.\n        if len(row) <= n:\n            raise InvalidColumnIndexException(f\"Row {i} does not have a column at index {n}.\")\n\n        value = row[n]\n        # 4. For each extracted value v = row[n]: if not isinstance(v, (int, float)), raise NonNumericValueException.\n        if not isinstance(value, (int, float)):\n            raise NonNumericValueException(f\"Non-numeric value '{value}' found at row {i}, column {n}.\")\n        column_values.append(value)\n\n    # 5. Compute maximum using standard numeric comparisons and return it.\n    # At this point, column_values is guaranteed to be non-empty and contain only numbers.\n    return max(column_values)"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List\ndef merge(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Extracts first and second elements from a list of two-element sublists.\n    Returns a new list containing two lists: [firsts, seconds], preserving input order.\n    \"\"\"\n    firsts = [sublist[0] for sublist in input_list]\n    seconds = [sublist[1] for sublist in input_list]\n    return [firsts, seconds]"}
{"task_id": "Mbpp/612", "solution": "from typing import Any\ndef merge(pairs: list[list[Any]]) -> list[list[Any]]:\n    \"\"\"Splits a list of two-element sublists into two separate lists.\n    The first output list contains all first elements, and the second output list contains all second elements.\n    \"\"\"\n    firstList = []\n    secondList = []\n\n    for pair in pairs:\n        firstList.append(pair[0])\n        secondList.append(pair[1])\n\n    return [firstList, secondList]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(input_list):\n    \"\"\"\n    Computes the cumulative sum of numeric elements across all tuples in the input list.\n    Assumes input is a list of tuples, where each tuple contains only numbers.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    return sum(num for tpl in input_list for num in tpl)"}
{"task_id": "Mbpp/614", "solution": "class InputValidator:\n    \"\"\"\n    Stateless utility for validating input for cummulative_sum.\n    Ensures the input is a list of tuples containing only integers.\n    \"\"\"\n    def is_valid_list_of_tuples(self, obj) -> bool:\n        \"\"\"\n        Checks if the given object is a list of tuples of integers.\n        Returns True if valid, False otherwise.\n        \"\"\"\n        if not isinstance(obj, list):\n            return False\n        for element in obj:\n            if not isinstance(element, tuple):\n                return False\n            for item in element:\n                if not isinstance(item, int):\n                    return False\n        return True\nclass SumProcessor:\n    \"\"\"\n    Stateless utility for processing the sum of integers.\n    Iterates through a list of tuples and sums all integer elements.\n    \"\"\"\n    def process_sum(self, list_of_tuples) -> int:\n        \"\"\"\n        Computes the cumulative sum of all integers in the provided list of tuples.\n        Returns 0 for an empty list.\n        \"\"\"\n        total = 0\n        for tup in list_of_tuples:\n            for item in tup:\n                total += item\n        return total\ndef cummulative_sum(list_of_tuples) -> int:\n    \"\"\"\n    Computes the cumulative sum of all integer values across a list of tuples.\n    Validates input and raises TypeError on invalid types.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_valid_list_of_tuples(list_of_tuples):\n        raise TypeError(\"Input must be a list of tuples of integers\")\n\n    processor = SumProcessor()\n    return processor.process_sum(list_of_tuples)"}
{"task_id": "Mbpp/615", "solution": "from typing import List, Tuple, Union\nNumeric = Union[int, float]\nInnerTupleElements = Tuple[Numeric, ...]\nInputTupleType = Tuple[InnerTupleElements, ...]\nclass InnerTuple:\n    \"\"\"\n    Represents an inner tuple of numeric elements and computes its mean.\n    \"\"\"\n    def __init__(self, elements: InnerTupleElements) -> None:\n        self._elements = elements\n\n    def mean(self) -> float:\n        \"\"\"\n        Calculates the arithmetic mean of the inner tuple's elements.\n        \"\"\"\n        return sum(self._elements) / len(self._elements)\nclass AverageCalculator:\n    \"\"\"\n    Orchestrates the computation of means for an input tuple of tuples.\n    \"\"\"\n    @staticmethod\n    def average_tuple(input: InputTupleType) -> List[float]:\n        \"\"\"\n        Computes the arithmetic mean for each inner tuple in the provided input.\n        \"\"\"\n        results: List[float] = []\n        for inner in input:\n            it = InnerTuple(inner)\n            results.append(it.mean())\n        return results\ndef average_tuple(input: InputTupleType) -> List[float]:\n    \"\"\"\n    Calculates the arithmetic mean for each inner tuple in the provided input.\n    Delegates the core computation to AverageCalculator.\n    \"\"\"\n    return AverageCalculator.average_tuple(input)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples):\n    \"\"\"\n    Computes the arithmetic mean for each inner tuple in a tuple of tuples.\n    Returns a list of these means, preserving the input order.\n    \"\"\"\n    means = []\n    for inner_tuple in tuple_of_tuples:\n        # Sum elements and divide by count to get the mean.\n        # Python's / operator performs float division, as required.\n        mean = sum(inner_tuple) / len(inner_tuple)\n        means.append(mean)\n    return means"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples of the same length.\n    Raises ValueError for length mismatch or ZeroDivisionError for zero divisors.\"\"\"\n    n = len(a)\n\n    if n != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    # Pre-scan divisor tuple 'b' for any zero values.\n    for divisor in b:\n        if divisor == 0:\n            raise ZeroDivisionError(\"Divisor tuple 'b' contains a zero.\")\n\n    # Compute element-wise modulo and return a new tuple of results.\n    results = [a[i] % b[i] for i in range(n)]\n    return tuple(results)"}
{"task_id": "Mbpp/616", "solution": "# src/validator.py\nclass Validator:\n    \"\"\"Encapsulates input validation logic for tuple_modulo function.\"\"\"\n\n    def validate_length(self, a: tuple[int], b: tuple[int]) -> bool:\n        \"\"\"Checks if two tuples have the same length, raising ValueError if not.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(f\"input tuples must have the same length: len(a)={len(a)} != len(b)={len(b)}\")\n        return True\n\n    def validate_elements_are_integers(self, t: tuple, param_name: str) -> bool:\n        \"\"\"Checks if the input is a tuple and all its elements are integers, raising TypeError if not.\"\"\"\n        if not isinstance(t, tuple):\n            raise TypeError(f\"{param_name} must be a tuple of integers\")\n        for element in t:\n            if not isinstance(element, int):\n                raise TypeError(f\"{param_name} must be a tuple of integers\")\n        return True\n\n    def validate_no_zero_divisors(self, b: tuple[int]) -> bool:\n        \"\"\"Checks if any element in the divisor tuple is zero, raising ZeroDivisionError if found.\"\"\"\n        for i, element in enumerate(b):\n            if element == 0:\n                raise ZeroDivisionError(f\"divisor tuple contains zero at index {i}\")\n        return True"}
{"task_id": "Mbpp/618", "solution": "def div_list(input1: list, input2: list) -> list:\n    \"\"\"Performs element-wise division of two lists, returning float results.\"\"\"\n    output_list = []\n    for i in range(len(input1)):\n        # Coerce elements to float before division to ensure float results.\n        result = float(input1[i]) / float(input2[i])\n        output_list.append(result)\n    return output_list"}
