{"task_id": "Mbpp/644", "solution": "class Validator:\n    \"\"\"Centralizes type validation for array and k.\"\"\"\n    def validate_array(self, array) -> None:\n        \"\"\"Raises TypeError if array is not a list.\"\"\"\n        if not isinstance(array, list):\n            raise TypeError(\"Input 'array' must be a list.\")\n\n    def validate_k(self, k) -> None:\n        \"\"\"Raises TypeError if k is not an integer.\"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"Input 'k' must be an integer.\")\nclass ReverseFunction:\n    \"\"\"Performs the array reversal transformation.\"\"\"\n    def reverse_Array_Upto_K(self, array: list, k: int) -> list:\n        \"\"\"\n        Returns a new list with the first k elements reversed,\n        handling edge cases k <= 0 and k >= len(array).\n        \"\"\"\n        original_array_len = len(array)\n        \n        # BR-07: Must not mutate input list; return a new list instance.\n        # BR-04: If k <= 0, return a new list identical in contents (no change).\n        if k <= 0:\n            return list(array) # Return a shallow copy of the input.\n\n        # BR-06: If k >= len(array), reverse the entire array.\n        if k >= original_array_len:\n            new_list = list(array) # Create a mutable copy for reversal.\n            new_list.reverse()\n            return new_list\n\n        # BR-05: If 0 < k < len(array), reverse first k elements and preserve remainder.\n        # Get the first k elements and reverse them.\n        part_to_reverse = array[0:k]\n        part_to_reverse.reverse()\n\n        # Get the remaining elements without modification.\n        remaining_part = array[k:]\n\n        # Concatenate the reversed part and the remaining part, returning a new list.\n        return part_to_reverse + remaining_part\ndef reverse_Array_Upto_K(array, k) -> list:\n    \"\"\"\n    Reverses the first k elements of an array according to business rules,\n    ensuring input validation and non-mutation.\n    \"\"\"\n    validator = Validator()\n    validator.validate_array(array)\n    validator.validate_k(k)\n\n    reverse_func = ReverseFunction()\n    return reverse_func.reverse_Array_Upto_K(array, k)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the first k elements of a list, returning a new list.\n    Handles edge cases for k and empty lists without mutating the input.\n    \"\"\"\n    if len(arr) == 0:\n        return []\n    elif k <= 0:\n        return arr.copy()\n    elif k >= len(arr):\n        return arr[::-1]\n    else:\n        return arr[0:k][::-1] + arr[k:]"}
{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents a single cell with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Matrix:\n    \"\"\"Wraps a square list-of-lists and provides size and cell access.\"\"\"\n    def __init__(self, cells_data: list[list[float]]):\n        self.size = len(cells_data)\n        self.cells = cells_data\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns a Cell object for the given coordinates.\"\"\"\n        return Cell(row, col, self.cells[row][col])\nclass Validator:\n    \"\"\"Validates input matrices according to specified rules.\"\"\"\n    def validateMatrix(self, matrix: any) -> None:\n        \"\"\"Performs validation checks on the matrix.\n        Per critical requirements, this method performs no runtime checks or raises exceptions.\"\"\"\n        pass\nclass PathEvaluator:\n    \"\"\"Computes the maximum average across valid top-left-to-bottom-right paths.\"\"\"\n    def maxAverageOfPath(self, matrix: Matrix) -> float:\n        \"\"\"Calculates the maximum average path using dynamic programming.\"\"\"\n        N = matrix.size\n        \n        # dp[r][c] stores the maximum total cost to reach cell (r, c).\n        # This leverages that all valid paths have the same length (2*N - 1).\n        dp = [[0.0 for _ in range(N)] for _ in range(N)]\n\n        # Initialize the top-left cell.\n        dp[0][0] = matrix.getCell(0, 0).cost\n\n        # Initialize first row (only right moves possible).\n        for c in range(1, N):\n            dp[0][c] = dp[0][c-1] + matrix.getCell(0, c).cost\n\n        # Initialize first column (only down moves possible).\n        for r in range(1, N):\n            dp[r][0] = dp[r-1][0] + matrix.getCell(r, 0).cost\n\n        # Fill the rest of the DP table.\n        for r in range(1, N):\n            for c in range(1, N):\n                current_cost = matrix.getCell(r, c).cost\n                dp[r][c] = max(dp[r-1][c], dp[r][c-1]) + current_cost\n\n        # The total number of cells visited in any valid path for an N x N matrix is 2*N - 1.\n        path_length = (2 * N) - 1\n        return dp[N-1][N-1] / path_length\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Public API: Finds the path with the maximum average cost from top-left to bottom-right.\n    Moves are restricted to only right or down.\n    \"\"\"\n    validator = Validator()\n    validator.validateMatrix(matrix) # Validation is a no-op as per critical requirements.\n    \n    matrix_obj = Matrix(matrix)\n    evaluator = PathEvaluator()\n    result = evaluator.maxAverageOfPath(matrix_obj)\n    \n    return float(result)"}
{"task_id": "Mbpp/721", "solution": "import math\nfrom typing import List, Any, Iterator, Iterable, Union\nclass Cell:\n    \"\"\"Represents a single cell in the matrix with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: float):\n        self.row = row\n        self.col = col\n        self.value = value\nclass Path:\n    \"\"\"Represents an ordered sequence of Cell objects forming a path.\"\"\"\n    def __init__(self, cells: List[Cell]):\n        self.cells = cells\n\n    def total_cost(self) -> float:\n        \"\"\"Calculates the sum of values of all cells in the path.\"\"\"\n        return sum(cell.value for cell in self.cells)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def average(self) -> float:\n        \"\"\"Computes the average value of cells in the path.\"\"\"\n        path_length = self.length()\n        if path_length == 0: # Should not happen for valid paths\n            return 0.0 \n        return self.total_cost() / path_length\nclass Matrix:\n    \"\"\"Represents the input matrix and provides accessors.\"\"\"\n    def __init__(self, rows: List[List[float]]):\n        self.rows = rows\n        self.N = len(rows)\n\n    def get(self, row: int, col: int) -> float:\n        \"\"\"Retrieves the value of a cell at given coordinates.\"\"\"\n        return self.rows[row][col]\n\n    def size(self) -> int:\n        \"\"\"Returns the size N of the N*N square matrix.\"\"\"\n        return self.N\nclass Result:\n    \"\"\"Container for the maximum average and the corresponding best path.\"\"\"\n    def __init__(self, max_average: float, best_path: Path):\n        self.max_average = max_average\n        self.best_path = best_path\nclass PathEnumerator:\n    \"\"\"Deterministically enumerates all right/down paths in a matrix.\"\"\"\n    def enumerate(self, matrix: Matrix) -> Iterator[Path]:\n        \"\"\"Uses DFS to find all paths from (0,0) to (N-1,N-1), yielding Path objects.\"\"\"\n        n = matrix.size()\n        current_path_cells: List[Cell] = []\n\n        def _dfs(r: int, c: int):\n            if not (0 <= r < n and 0 <= c < n):\n                return\n\n            current_path_cells.append(Cell(r, c, matrix.get(r, c)))\n\n            if r == n - 1 and c == n - 1:\n                yield Path(list(current_path_cells))\n            else:\n                # Prioritize moving right, then down for deterministic order\n                yield from _dfs(r, c + 1)  # Try move right\n                yield from _dfs(r + 1, c)  # Try move down\n\n            current_path_cells.pop() # Backtrack\n\n        yield from _dfs(0, 0)\nclass AverageCalculator:\n    \"\"\"Computes the average for a given Path object.\"\"\"\n    def compute(self, path: Path) -> float:\n        \"\"\"Delegates average calculation to the Path object.\"\"\"\n        return path.average()\nclass MaxSelector:\n    \"\"\"Iterates a stream of paths, computes averages, and finds the maximum.\"\"\"\n    def select_max(self, paths: Iterable[Path]) -> Result:\n        \"\"\"Returns the Result containing the max average and its corresponding path.\"\"\"\n        max_average: float = -float('inf')\n        best_path: Union[Path, None] = None\n        average_calculator = AverageCalculator()\n\n        for path in paths:\n            current_average = average_calculator.compute(path)\n            if current_average > max_average: # First-encountered max for tie-breaking\n                max_average = current_average\n                best_path = path\n        \n        # For valid N>=1 matrices, at least one path (single cell) always exists.\n        # This handles the theoretical case where no paths were processed.\n        if best_path is None:\n            return Result(0.0, Path([])) \n\n        return Result(max_average, best_path)\ndef maxAverageOfPath(matrix: List[List[Union[int, float]]]) -> float:\n    \"\"\"\n    Computes the maximum average among all right/down paths from top-left to bottom-right cell.\n    It orchestrates validation, path enumeration, average computation, and selection.\n    \"\"\"\n    # 1. Validate the input matrix\n    validate(matrix)\n\n    n = len(matrix)\n\n    # 2. Handle N==1 short-circuit case\n    if n == 1:\n        return float(matrix[0][0])\n\n    # 3. Construct models.Matrix for internal use, ensuring float values\n    m = Matrix([[float(cell) for cell in row] for row in matrix])\n\n    # 4. Enumerate all right/down paths\n    paths_iter = PathEnumerator().enumerate(m)\n\n    # 5. Select the path with the maximum average\n    result = MaxSelector().select_max(paths_iter)\n\n    # 6. Return the maximum average\n    return float(result.max_average)"}
