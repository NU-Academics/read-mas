{"task_id": "Mbpp/18", "solution": "from dataclasses import dataclass, field\ndef remove_dirty_chars(source: str, dirty_chars: str) -> str:\n    \"\"\"\n    Removes characters from the source string that are present in dirty_chars.\n    Preserves order, performs case-sensitive matching, and returns an empty string\n    if the source is empty or all characters are removed.\n    \"\"\"\n    if not source:\n        return \"\"\n\n    input_string = InputString(value=source)\n    dirty_set = DirtyCharsSet(value=dirty_chars)\n    result_builder = ResultString()\n\n    for char in input_string.value:\n        if not dirty_set.contains(char):\n            result_builder.append(char)\n\n    return result_builder.to_str()"}
{"task_id": "Mbpp/19", "solution": "class DuplicateChecker:\n    \"\"\"\n    Implements the algorithm for detecting duplicate integers in a list.\n    This class is stateless.\n    \"\"\"\n    def test_duplicate(self, arr: list[int]) -> bool:\n        \"\"\"\n        Return True if any integer in arr appears more than once; otherwise False.\n        Uses a set to track seen elements efficiently.\n        \"\"\"\n        seen = set()\n        for x in arr:\n            if x in seen:\n                return True\n            seen.add(x)\n        return False\ndef test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Public API: Return True if duplicates exist in arr, otherwise False.\n    Delegates the duplicate detection to an instance of DuplicateChecker.\n    \"\"\"\n    return DuplicateChecker().test_duplicate(arr)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(array_of_integers: list[int]) -> bool:\n    \"\"\"\n    Checks if an array of integers contains any duplicate element.\n    Uses a set to track seen elements for efficient lookup.\n    \"\"\"\n    seen_elements = set()\n    for element in array_of_integers:\n        if element in seen_elements:\n            return True\n        seen_elements.add(element)\n    return False"}
{"task_id": "Mbpp/20", "solution": "class ParameterK:\n    \"\"\"\n    Value object representing a candidate integer k for Woodall number calculation.\n    It computes the corresponding Woodall number.\n    \"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n\n    def compute(self) -> int:\n        \"\"\"\n        Computes the Woodall number for the stored k.\n        The formula is k * 2^k - 1.\n        \"\"\"\n        return self.k * (2 ** self.k) - 1\nclass TestResult:\n    \"\"\"\n    Container for the boolean result of the Woodall number test.\n    It indicates whether the tested value is a Woodall number.\n    \"\"\"\n    def __init__(self, is_woodall: bool) -> None:\n        self.is_woodall = is_woodall\nclass WoodallTest:\n    \"\"\"\n    Encapsulates the core logic for testing if a number is a Woodall number.\n    It delegates computation to ParameterK and stores results in TestResult.\n    \"\"\"\n    def is_woodall(self, value: int) -> bool:\n        \"\"\"\n        Determines if the given value is a Woodall number.\n        It uses the internal find_k method to locate a matching k.\n        \"\"\"\n        found_k = self._find_k(value)\n        result = TestResult(found_k is not None)\n        return result.is_woodall\n\n    def _find_k(self, value: int) -> int | None:\n        \"\"\"\n        Iterates through possible integer values for k, starting from 1.\n        It checks if value matches k * 2^k - 1 or if k exceeds the necessary range.\n        \"\"\"\n        if value < 1:\n            return None\n\n        k = 1\n        while True:\n            parameter_k = ParameterK(k)\n            computed_woodall = parameter_k.compute()\n\n            if computed_woodall == value:\n                return k\n            elif computed_woodall > value:\n                # If computed value exceeds the target, further k's will also exceed.\n                return None\n            k += 1\ndef is_woodall(value: int) -> bool:\n    \"\"\"\n    Checks if the given value is a Woodall number.\n    This is the public API function, delegating to the WoodallTest class.\n    \"\"\"\n    woodall_tester = WoodallTest()\n    return woodall_tester.is_woodall(value)"}
{"task_id": "Mbpp/20", "solution": "class Computation:\n    def compute_candidate(self, k: int) -> int:\n        return k * (2**k) - 1\nclass WoodallChecker:\n    def __init__(self) -> None:\n        self._computation = Computation()\n\n    def is_woodall(self, n: int) -> bool:\n        \"\"\"Public algorithm entry point; returns True if n is a Woodall number.\"\"\"\n        found_k = self.find_k(n)\n        return found_k is not None\n\n    def find_k(self, n: int) -> int | None:\n        \"\"\"Iterates k to find a match for n, or None if no match is found.\"\"\"\n        k = 1\n        while True:\n            candidate = self._computation.compute_candidate(k)\n            if candidate == n:\n                return k\n            elif candidate > n:\n                return None\n            k += 1\ndef is_woodall(n: int) -> bool:\n    \"\"\"Public API: returns True if n is a Woodall number.\"\"\"\n    checker = WoodallChecker()\n    return checker.is_woodall(n)"}
{"task_id": "Mbpp/56", "solution": "def reverse(n: int) -> int:\n    \"\"\"Computes the decimal-digit reverse of abs(n), dropping any leading zeros produced by reversal.\n    For input 0, returns 0.\"\"\"\n    abs_n_str = str(abs(n))\n    reversed_str = abs_n_str[::-1]\n    return int(reversed_str)\ndef check(n: int) -> bool:\n    \"\"\"Returns True iff n == 2 * reverse(n) - 1; otherwise returns False.\"\"\"\n    rev_n = reverse(n)\n    return n == 2 * rev_n - 1"}
{"task_id": "Mbpp/56", "solution": "class NumberInput:\n    \"\"\"Represents an integer input and provides helpers for digit-level operations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def getDigits(self) -> list[int]:\n        \"\"\"Returns a list of decimal digits of the integer.\"\"\"\n        return [int(d) for d in str(self.value)]\n\n    def asString(self) -> str:\n        \"\"\"Returns the string representation of the integer.\"\"\"\n        return str(self.value)\nclass ReverseOperation:\n    \"\"\"Computes the integer obtained by reversing the decimal digits of an integer.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Performs reversal on the absolute value, dropping leading zeros in the result.\"\"\"\n        abs_n = abs(n)\n        num_input = NumberInput(abs_n)\n        s = num_input.asString()\n        reversed_s = s[::-1]\n        return int(reversed_s)\nclass NumberChecker:\n    \"\"\"Implements the core predicate logic based on the number reverse relationship.\"\"\"\n    def check(self, n: int) -> bool:\n        \"\"\"Checks if n equals (2 * reverse(n) - 1).\"\"\"\n        reversed_n = ReverseOperation().compute(n)\n        return n == 2 * reversed_n - 1\ndef check(n: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\"\"\"\n    return NumberChecker().check(n)"}
{"task_id": "Mbpp/57", "solution": "from typing import List\nclass InputList:\n    \"\"\"Lightweight wrapper for input digits.\"\"\"\n    def __init__(self, digits: list):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the list.\"\"\"\n        return len(self.digits)\nclass Digit:\n    \"\"\"Encapsulates a single digit value and validation helper.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the digit's value is between 0 and 9.\"\"\"\n        return 0 <= self.value <= 9\nclass Validator:\n    \"\"\"Validates InputList and Digit per business rules.\"\"\"\n    def validate_list(self, input: 'InputList') -> bool:\n        \"\"\"\n        Validates that input.digits is a list of integers between 0 and 9.\n        Raises TypeError for any invalid element.\n        \"\"\"\n        for item in input.digits:\n            if not isinstance(item, int):\n                raise TypeError(f\"Invalid element type: '{item}'. Expected integer.\")\n            digit = Digit(item)\n            if not self.validate_digit(digit):\n                raise TypeError(f\"Invalid digit value: '{item}'. Expected 0-9.\")\n        return True\n\n    def validate_digit(self, d: 'Digit') -> bool:\n        \"\"\"Validates a single Digit object using its isValid method.\"\"\"\n        return d.isValid()\nclass NumberBuilder:\n    \"\"\"Sorts digits in descending order and assembles them into a Python int.\"\"\"\n    def sort_desc(self, digits: List[int]) -> List[int]:\n        \"\"\"Returns a new list of digits sorted in descending order, preserving duplicates.\"\"\"\n        return sorted(digits, reverse=True)\n\n    def assemble(self, digits: List[int]) -> int:\n        \"\"\"\n        Concatenates digits into an int, ensuring numeric semantics remove\n        unnecessary leading zeros.\n        \"\"\"\n        s_digits = [str(d) for d in digits]\n        # Python's int() naturally handles leading zeros (e.g., int(\"001\") == 1, int(\"0\") == 0)\n        return int(\"\".join(s_digits))\ndef find_Max_Num(input_list: list) -> int:\n    \"\"\"\n    Public API function to find the largest number that can be formed with the given list of digits.\n    Coordinates validation and number building, returning the assembled integer or raising TypeError.\n    \"\"\"\n    input_obj = InputList(input_list)\n    validator = Validator()\n    # validate_list raises TypeError on invalid input per FR6/BR-02/BR-03\n    validator.validate_list(input_obj)\n\n    builder = NumberBuilder()\n    sorted_digits = builder.sort_desc(input_obj.digits)\n    value = builder.assemble(sorted_digits)\n    return value"}
