{"task_id": "Mbpp/765", "solution": "class InputValidator:\n    \"\"\"Validates inputs for the Polite Number Service.\"\"\"\n    def validate_positive_integer(self, n: int) -> None:\n        \"\"\"Ensures n is a positive integer. (Validation logic omitted per critical requirements)\"\"\"\n        pass\nclass NumberUtils:\n    \"\"\"Number-theory helpers for polite number detection.\"\"\"\n    def is_power_of_two(self, x: int) -> bool:\n        \"\"\"Checks if a number is a power of two.\"\"\"\n        return x > 0 and (x & (x - 1) == 0)\n\n    def is_polite_number(self, x: int) -> bool:\n        \"\"\"Determines if a number is polite (not a power of two).\"\"\"\n        return not self.is_power_of_two(x)\nclass SequenceEnumerator:\n    \"\"\"Enumerates polite numbers to find the nth one.\"\"\"\n    def find_nth_polite(self, n: int) -> int:\n        \"\"\"Finds the nth polite number by iteration.\"\"\"\n        polite_count = 0\n        candidate = 1\n        number_utils = NumberUtils() # Stateless, can instantiate once or per call\n\n        while True:\n            if number_utils.is_polite_number(candidate):\n                polite_count += 1\n            if polite_count == n:\n                return candidate\n            candidate += 1\nclass PoliteNumberService:\n    \"\"\"Coordinates validation and enumeration for polite numbers.\"\"\"\n    def __init__(self):\n        self._input_validator = InputValidator()\n        self._sequence_enumerator = SequenceEnumerator()\n\n    def get_nth_polite(self, n: int) -> int:\n        \"\"\"Returns the nth polite number after validation.\"\"\"\n        self._input_validator.validate_positive_integer(n)\n        return self._sequence_enumerator.find_nth_polite(n)\ndef is_polite(n: int) -> int:\n    \"\"\"External API: Returns the nth polite number.\"\"\"\n    service = PoliteNumberService()\n    return service.get_nth_polite(n)"}
{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Sequence, Tuple\nclass Pair:\n    \"\"\"Represents an immutable pair of items.\n    It can convert itself into a standard Python tuple.\"\"\"\n    def __init__(self, first: Any, second: Any) -> None:\n        self._first = first\n        self._second = second\n\n    def to_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Converts the Pair instance into a 2-element tuple.\"\"\"\n        return (self._first, self._second)\nclass ResultList:\n    \"\"\"Collects Pair instances and materializes them as a list of tuples.\n    This class manages the ordered collection of pairs before final output.\"\"\"\n    def __init__(self) -> None:\n        self._pairs: List[Pair] = []\n\n    def append(self, p: Pair) -> None:\n        \"\"\"Adds a Pair to the internal list.\"\"\"\n        self._pairs.append(p)\n\n    def to_list(self) -> List[Tuple[Any, Any]]:\n        \"\"\"Converts all collected Pairs to tuples and returns them as a list.\"\"\"\n        return [p.to_tuple() for p in self._pairs]\nclass InputList:\n    \"\"\"Provides a read-only wrapper for the input sequence.\n    This ensures the original input list is not modified.\"\"\"\n    def __init__(self, items: Sequence[Any]) -> None:\n        self._items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the wrapped sequence.\"\"\"\n        return len(self._items)\n\n    def get(self, i: int) -> Any:\n        \"\"\"Retrieves an element by index from the wrapped sequence.\"\"\"\n        return self._items[i]\ndef pair_wise(input_list: Sequence[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"Generates consecutive pairs from an input list.\n    It returns a list of 2-element tuples, or an empty list if there are fewer than two items.\"\"\"\n    wrapped_input = InputList(input_list)\n    num_items = wrapped_input.length()\n\n    if num_items < 2:\n        return []\n\n    result_list = ResultList()\n    for i in range(num_items - 1):\n        first = wrapped_input.get(i)\n        second = wrapped_input.get(i + 1)\n        result_list.append(Pair(first, second))\n\n    return result_list.to_list()"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list:\n    \"\"\"\n    Returns a list of 2-element tuples where each tuple contains consecutive items from input_list.\n    Preconditions: input_list is a list (treated read-only). If len(input_list) < 2 returns [].\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
