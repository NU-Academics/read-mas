{"task_id": "Mbpp/245", "solution": "from dataclasses import dataclass\nfrom typing import List, Any\ndef compute_lis_sums(array: List[int]) -> List[int]:\n    \"\"\"Computes the maximum sum of any strictly increasing subsequence ending at each index.\"\"\"\n    n = len(array)\n    lis_sums = list(array)  # Each element itself is an increasing subsequence\n    for i in range(n):\n        for j in range(i):\n            if array[i] > array[j]:\n                lis_sums[i] = max(lis_sums[i], array[i] + lis_sums[j])\n    return lis_sums\ndef compute_lds_sums(array: List[int]) -> List[int]:\n    \"\"\"Computes the maximum sum of any strictly decreasing subsequence starting at each index.\"\"\"\n    n = len(array)\n    lds_sums = list(array)  # Each element itself is a decreasing subsequence\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if array[i] > array[j]:\n                lds_sums[i] = max(lds_sums[i], array[i] + lds_sums[j])\n    return lds_sums\ndef max_sum(array: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first increasing then decreasing.\n    \"\"\"\n    validate_input(array)\n\n    n = len(array)\n    if n == 1:\n        return array[0]\n\n    lis_sums = compute_lis_sums(array)\n    lds_sums = compute_lds_sums(array)\n\n    max_bitonic_sum = float('-inf')\n\n    # Combine LIS and LDS sums for each element acting as a peak.\n    # The element array[i] is counted once for LIS and once for LDS,\n    # so we subtract it once to get the total sum of the bitonic subsequence.\n    for i in range(n):\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - array[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n    \n    # Return the maximum sum, casting to int.\n    # max_bitonic_sum should not remain -inf for a valid non-empty input array.\n    return int(max_bitonic_sum)"}
{"task_id": "Mbpp/247", "solution": "def lps(input: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence of the input string.\n    This implementation uses a dynamic programming approach.\n    \"\"\"\n    n = len(input)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of input[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # Substrings of length 1 have an LPS of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of increasing length.\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if input[i] == input[j]:\n                # If characters match, extend the palindrome from the inner substring.\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                # If characters don't match, take the maximum from excluding either end.\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
