{"task_id": "Mbpp/235", "solution": "from validator import InputValidator\nclass EvenBitSetter:\n    def _build_even_mask(self, bit_length: int) -> int:\n        \"\"\"\n        Builds a mask with even-positioned bits (2, 4, 6...) set to 1.\n        The mask extends up to the given bit_length.\n        \"\"\"\n        mask = 0\n        for i in range(2, bit_length + 1, 2):\n            mask |= (1 << (i - 1))\n        return mask\n\n    def even_bit_set_number(self, n: int) -> int:\n        \"\"\"\n        Applies an even-positioned bit mask to n using bitwise OR.\n        Determines mask length based on n's bit length.\n        \"\"\"\n        bit_length = n.bit_length()\n        mask = self._build_even_mask(bit_length)\n        return n | mask\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets every even-positioned bit (1-based indexing) of a non-negative integer to 1.\n    Delegates validation and bit-setting to respective classes.\n    \"\"\"\n    InputValidator().validate_non_negative(n)\n    return EvenBitSetter().even_bit_set_number(n)"}
{"task_id": "Mbpp/237", "solution": "class OccurrenceMapping:\n    \"\"\"A lightweight container for the resulting dictionary.\n    Holds the mapping from normalized tuples to their integer counts.\n    \"\"\"\n    def __init__(self, initial_mapping: dict = None):\n        self.mapping = initial_mapping if initial_mapping is not None else {}\nclass OccurrenceCounter:\n    \"\"\"Orchestrates the counting process including normalization.\n    Processes the input list, normalizes tuples, and aggregates counts.\n    \"\"\"\n    @classmethod\n    def check_occurences(cls, tuples: list) -> dict:\n        \"\"\"Processes a list of tuples to count occurrences after normalization.\n        Assumes input items are 2-element tuples and elements are orderable.\n        \"\"\"\n        counts = OccurrenceMapping().mapping\n        for item in tuples:\n            normalized_tuple = cls._normalize(item)\n            counts[normalized_tuple] = counts.get(normalized_tuple, 0) + 1\n        return counts\n\n    @staticmethod\n    def _normalize(t: tuple) -> tuple:\n        \"\"\"Normalizes a 2-element tuple by ordering its elements non-decreasingly.\n        Relies on `sorted` for ordering, so elements must be comparable.\n        \"\"\"\n        return tuple(sorted(t))\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"Counts occurrences of normalized 2-element tuples in a list.\n    Example: check_occurences([(3,1),(1,3),(2,5),(5,2),(6,3)]) == {(1,3):2,(2,5):2,(3,6):1}\n    \"\"\"\n    return OccurrenceCounter.check_occurences(input_list)"}
{"task_id": "Mbpp/238", "solution": "def _validate_input(s: str) -> str:\n    \"\"\"\n    Validates that the input s is a string.\n    Raises TypeError if s is not of type str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n    return s\ndef _count_by_formula(n: int) -> int:\n    \"\"\"\n    Computes the sum of integers from 1 to n using the formula n*(n+1)//2.\n    This efficiently counts all non-empty contiguous substrings for a string of length n.\n    \"\"\"\n    return n * (n + 1) // 2\ndef number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts all non-empty contiguous substrings of the input string s.\n    Input validation ensures s is a string, and an empty string returns 0.\n    \"\"\"\n    _validate_input(s)\n\n    if not s:\n        return 0\n\n    n = len(s)\n    return _count_by_formula(n)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"Sets every even-positioned bit (2, 4, 6, ...) to 1 while preserving odd-positioned bits.\n    Bit positions are counted from 1 at the least-significant bit.\n    \"\"\"\n    # Determine the effective bit length for mask generation, considering 0.\n    bit_length = max(1, n.bit_length())\n\n    # Construct a mask with 1s at internal 0-based indices 1, 3, 5, ...\n    # These indices correspond to 1-based even positions 2, 4, 6, ...\n    even_position_mask = 0\n    for i in range(bit_length):\n        if i % 2 == 1:\n            even_position_mask |= (1 << i)\n\n    # Apply the generated mask using a bitwise OR to set even-positioned bits to 1,\n    # while preserving the original state of odd-positioned bits.\n    result = n | even_position_mask\n    return result"}
{"task_id": "Mbpp/237", "solution": "def normalize_tuple(t):\n    \"\"\"Normalizes a tuple by sorting its elements in ascending order.\n    This ensures permutations of tuples map to the same key.\"\"\"\n    return tuple(sorted(t))\ndef check_occurences(input_list):\n    \"\"\"Counts occurrences of normalized tuples in the input list.\n    Returns a dictionary mapping each unique normalized tuple to its count.\"\"\"\n    occurrence_counts = {}\n    for item in input_list:\n        normalized_item = normalize_tuple(item)\n        occurrence_counts[normalized_item] = occurrence_counts.get(normalized_item, 0) + 1\n    return occurrence_counts"}
