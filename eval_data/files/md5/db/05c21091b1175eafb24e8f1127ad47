{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict\ndef _count_characters(input: str) -> Dict[str, int]:\n    \"\"\"Counts character occurrences in a string.\n    Returns a dictionary mapping each character to its frequency.\"\"\"\n    counts: Dict[str, int] = {}\n    for char in input:\n        counts[char] = counts.get(char, 0) + 1\n    return counts\ndef first_non_repeating_character(input: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeated character in a string.\n    Returns the character or None if no unique character exists.\"\"\"\n    char_counts = _count_characters(input)\n    for char in input:\n        if char_counts[char] == 1:\n            return char\n    return None"}
{"task_id": "Mbpp/397", "solution": "from src.domain import MedianResult, Triplet\nfrom src.validator import InputValidator\nfrom src.calculator import MedianCalculator\nclass Triplet:\n    \"\"\"Stores three floating-point numbers.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\nclass MedianResult:\n    \"\"\"Stores the computed median value as a float.\"\"\"\n    def __init__(self, value: float):\n        self._value = float(value)\n\n    @property\n    def value(self) -> float:\n        \"\"\"The median value.\"\"\"\n        return self._value\nclass InputValidator:\n    \"\"\"Validates if a given value is numeric.\"\"\"\n    def is_numeric(self, value) -> bool:\n        \"\"\"Returns True for int or float, False otherwise.\"\"\"\n        return isinstance(value, (int, float))\nclass MedianCalculator:\n    \"\"\"Computes the median of three numbers.\"\"\"\n    def median_numbers(self, a: float, b: float, c: float) -> MedianResult:\n        \"\"\"Calculates the median of three input floats.\"\"\"\n        triplet = Triplet(a, b, c) # Values are stored as floats in Triplet.\n        values = sorted([triplet.a, triplet.b, triplet.c])\n        median_value = values[1]\n        return MedianResult(value=median_value)\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    pass\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Calculates the median of three numbers.\n    Validates inputs and delegates computation.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_numeric(a):\n        raise ValidationError(f\"Input 'a' ({a}) must be numeric.\")\n    if not validator.is_numeric(b):\n        raise ValidationError(f\"Input 'b' ({b}) must be numeric.\")\n    if not validator.is_numeric(c):\n        raise ValidationError(f\"Input 'c' ({c}) must be numeric.\")\n\n    calculator = MedianCalculator()\n    median_result = calculator.median_numbers(float(a), float(b), float(c))\n    return median_result.value"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the sum of all decimal digits for each integer in the input list.\n    Returns the grand total as an integer.\n    \"\"\"\n    total_sum = 0\n    for number in numbers:\n        current_num = abs(number)  # Consider absolute value for digit summing\n\n        if current_num == 0:\n            # If the number is 0, its sum of digits is 0.\n            total_sum += 0\n        else:\n            while current_num > 0:\n                digit = current_num % 10\n                total_sum += digit\n                current_num //= 10\n    return total_sum"}
{"task_id": "Mbpp/398", "solution": "from typing import List\nclass NumberList:\n    \"\"\"Container for a list of integers.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self._numbers = numbers\n\n    def numbers(self) -> List[int]:\n        \"\"\"Returns the list of integers.\"\"\"\n        return self._numbers\nclass IntegerNumber:\n    \"\"\"Encapsulates an integer and provides digit decomposition.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Decomposes the integer into a list of decimal digits.\"\"\"\n        return [int(d) for d in str(self._value)]\nclass SumResult:\n    \"\"\"Encapsulates and exposes the aggregate total.\"\"\"\n    def __init__(self, total: int) -> None:\n        self._total = total\n\n    def total(self) -> int:\n        \"\"\"Returns the aggregate total as an integer.\"\"\"\n        return self._total\nclass SumOfDigitsService:\n    \"\"\"Orchestrates digit extraction and aggregation across an input list.\"\"\"\n    def sum_of_digits(self, numbers: List[int]) -> int:\n        \"\"\"Computes the sum of decimal digits for all numbers in the list.\"\"\"\n        current_sum = 0\n        number_list_obj = NumberList(numbers)\n\n        for number_value in number_list_obj.numbers():\n            integer_number_obj = IntegerNumber(number_value)\n            for digit_int in integer_number_obj.digits():\n                current_sum += digit_int\n        \n        sum_result_obj = SumResult(current_sum)\n        return sum_result_obj.total()\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Public API wrapper to compute the total sum of digits.\"\"\"\n    return SumOfDigitsService().sum_of_digits(numbers)"}
{"task_id": "Mbpp/404", "solution": "from typing import Union, Any\nfrom src.domain import NumericArgument\nNumeric = Union[int, float]\nclass MinimumFunction:\n    \"\"\"Encapsulates validation and comparison logic for finding the minimum.\"\"\"\n    def minimum(self, a: Numeric, b: Numeric) -> Numeric:\n        \"\"\"Return smaller of a and b; return input when equal.\"\"\"\n        if a <= b:\n            return a\n        else:\n            return b\n\n    def validate_arguments(self, a: Any, b: Any) -> bool:\n        \"\"\"Return True if both a and b are numeric (int or float), else False.\"\"\"\n        # Checks if both arguments are instances of int or float.\n        return isinstance(a, (int, float)) and isinstance(b, (int, float))\ndef minimum(a: Any, b: Any) -> Numeric:\n    \"\"\"External API function. Delegates to MinimumFunction for validation and comparison.\"\"\"\n    mf = MinimumFunction()\n    if not mf.validate_arguments(a, b):\n        raise TypeError(\"minimum() expects two numeric arguments (int or float)\")\n    return mf.minimum(a, b)"}
