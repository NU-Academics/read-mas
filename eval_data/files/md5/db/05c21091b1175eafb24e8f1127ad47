{"task_id": "Mbpp/276", "solution": "import math\nfrom typing import Any\nclass NumericInput:\n    \"\"\"Encapsulate a single input value and provide numeric validation.\n    Checks if the stored value is an integer or a float.\n    \"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\n    def validateNumeric(self) -> bool:\n        \"\"\"Check if the stored value is numeric (int or float).\"\"\"\n        return isinstance(self.value, (int, float))\nclass VolumeResult:\n    \"\"\"Hold computed volume and optional unit.\n    Initializes with a float value and an optional unit string.\n    \"\"\"\n    def __init__(self, value: float, unit: str = '') -> None:\n        self.value = value\n        self.unit = unit\nclass VolumeCalculator:\n    \"\"\"Perform computation pi * radius^2 * height.\n    Calculates the volume of a cylinder given its radius and height.\n    \"\"\"\n    def volume_cylinder(self, radius: float, height: float) -> float:\n        \"\"\"Compute volume = math.pi * radius ** 2 * height and return as float.\"\"\"\n        return math.pi * (radius ** 2) * height\ndef volume_cylinder(radius: Any, height: Any) -> float:\n    \"\"\"API required by SRS: validate inputs via NumericInput.validateNumeric(),\n    compute via VolumeCalculator.volume_cylinder(), return float.\n\n    Raises:\n        TypeError: if radius or height are not numeric (int or float).\n    \"\"\"\n    r_input = NumericInput(radius)\n    h_input = NumericInput(height)\n\n    if not r_input.validateNumeric() or not h_input.validateNumeric():\n        raise TypeError('radius and height must be numeric (int or float)')\n\n    calc = VolumeCalculator()\n    volume_value = calc.volume_cylinder(float(radius), float(height))\n    \n    # Per design: \"Return the computed volume as a Python float (VolumeResult.value).\"\n    final_result_obj = VolumeResult(volume_value)\n    return final_result_obj.value"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n):\n    \"\"\"\n    Computes the sum of binomial coefficients C(n, k) for all even k in 0..n.\n    Assumes n is a non-negative integer as per critical requirements.\n    \"\"\"\n    total_sum = 0\n\n    for k in range(0, n + 1):\n        if k % 2 == 0:\n            # Calculate C(n, k) using integer multiplicative formula and symmetry.\n            # No validation or helper functions are used as per critical requirements.\n            coeff_k = min(k, n - k)\n            \n            binomial_coeff = 1\n            if coeff_k > 0:\n                for i in range(coeff_k):\n                    binomial_coeff = binomial_coeff * (n - i) // (i + 1)\n            \n            total_sum += binomial_coeff\n\n    return total_sum"}
