{"task_id": "Mbpp/743", "solution": "from typing import Any, Sequence, List\nfrom .domain import InputList, ResultList\nfrom .validator import Validator\nclass RotateFunction:\n    \"\"\"Implements the core right rotation logic.\"\"\"\n    def __init__(self, input_list: InputList, count: int, validator: Validator = None) -> None:\n        self._input_list = input_list\n        self._count = count\n        self._validator = validator if validator is not None else Validator()\n\n    def execute(self) -> List[Any]:\n        \"\"\"Validates inputs and performs the right rotation, returning a new list.\"\"\"\n        # Validate inputs\n        if not self._validator.is_valid_list(self._input_list.to_list()):\n            raise TypeError(\"Input 'list' must be a sequence (list or tuple).\")\n        if not self._validator.is_valid_count(self._count):\n            raise TypeError(\"Input 'count' must be an integer.\")\n\n        n = self._input_list.length()\n        if n == 0:\n            return []\n\n        # Compute effective rotation count (k = count mod n)\n        # Python's % operator handles negative 'count' correctly for positive 'n'.\n        k = self._count % n\n\n        # Perform right rotation\n        original_elements = self._input_list.to_list()\n        # Slicing creates a new list without modifying the original.\n        rotated_elements = original_elements[-k:] + original_elements[:-k]\n        \n        result_list = ResultList(rotated_elements)\n        return result_list._elements # Directly access elements as ResultList has no public getter.\ndef rotate_right(list: Sequence[Any], count: int) -> List[Any]:\n    \"\"\"Public API to rotate a given list by a specified number of items to the right.\"\"\"\n    input_list_obj = InputList(list)\n    validator_obj = Validator()\n    rotate_func = RotateFunction(input_list_obj, count, validator_obj)\n    return rotate_func.execute()"}
