{"task_id": "Mbpp/12", "solution": "def _row_sum(row: list[float | int]) -> float:\n    \"\"\"Computes the numeric sum of a row's elements.\"\"\"\n    return sum(row)\ndef sort_matrix(matrix: list[list[float | int]]) -> list[list[float | int]]:\n    \"\"\"Sorts a matrix by the ascending sum of its rows, preserving stability and internal row order.\"\"\"\n    _validate_matrix(matrix)\n\n    # Pair each row with its computed sum.\n    # Python's sorted() is inherently stable for equal keys.\n    rows_with_sums = []\n    for row in matrix:\n        rows_with_sums.append((_row_sum(row), row))\n\n    # Sort based on the row sum.\n    sorted_rows_with_sums = sorted(rows_with_sums, key=lambda x: x[0])\n\n    # Extract the original rows in their new sorted order.\n    sorted_matrix = [row for _, row in sorted_rows_with_sums]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/14", "solution": "from .calculator import find_Volume\nfrom .validator import InputValidator\nfrom .domain import TriangularPrism, VolumeResult\nclass InputValidator:\n    \"\"\"\n    Validates input parameters for numeric type and count.\n    Ensures parameters are suitable for geometric calculations.\n    \"\"\"\n    def validate_numeric(self, value) -> bool:\n        \"\"\"Checks if a value is an integer or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validate_parameter_count(self, count) -> bool:\n        \"\"\"Checks if the parameter count is exactly 3.\"\"\"\n        return count == 3\nclass TriangularPrism:\n    \"\"\"\n    Represents a triangular prism and computes its geometric properties.\n    Calculates the area of the base and the total volume.\n    \"\"\"\n    def __init__(self, base, height, length):\n        self._base = float(base)\n        self._height = float(height)\n        self._length = float(length)\n\n    def area_of_base(self) -> float:\n        \"\"\"Computes the area of the triangular base.\"\"\"\n        return 0.5 * self._base * self._height\n\n    def volume(self) -> float:\n        \"\"\"Computes the total volume of the triangular prism.\"\"\"\n        return self.area_of_base() * self._length\nclass VolumeResult:\n    \"\"\"\n    Wraps a numeric volume result and provides conversion to int if whole.\n    Ensures the return type is appropriate.\n    \"\"\"\n    def __init__(self, value):\n        self._value = float(value)\n\n    def as_int_if_whole(self):\n        \"\"\"Returns the value as an integer if it's a whole number, otherwise as a float.\"\"\"\n        if self._value.is_integer():\n            return int(self._value)\n        return self._value\nclass GeometryCalculator:\n    \"\"\"\n    Orchestrates validation, domain object creation, and volume computation.\n    Serves as the application boundary for the find_Volume function.\n    \"\"\"\n    def __init__(self, validator: InputValidator = None):\n        self._validator = validator or InputValidator()\n\n    def find_Volume(self, base, height, length):\n        \"\"\"\n        Validates inputs, computes the volume of a triangular prism, and returns the result.\n        Raises ValueError for invalid parameter count or non-numeric inputs.\n        \"\"\"\n        # Validate parameter count.\n        if not self._validator.validate_parameter_count(3):\n            raise ValueError(\"Expected 3 parameters\")\n        # Validate numeric types for all parameters.\n        for v in (base, height, length):\n            if not self._validator.validate_numeric(v):\n                raise ValueError(\"Parameters must be numeric\")\n        \n        # Construct the domain entity and compute volume.\n        prism = TriangularPrism(base, height, length)\n        value = prism.volume()\n        \n        # Wrap and format the result.\n        result = VolumeResult(value)\n        return result.as_int_if_whole()\ndef find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism with given base, height, and length.\n    Delegates to GeometryCalculator for validation and computation.\n    \"\"\"\n    calculator = GeometryCalculator()\n    return calculator.find_Volume(base, height, length)"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, triangle_height, length):\n    \"\"\"Computes the volume of a triangular prism given its dimensions.\n    Assumes all inputs are numeric for direct calculation.\n    \"\"\"\n    volume = 0.5 * base * triangle_height * length\n    return volume"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Optional\nclass InputString:\n    \"\"\"Encapsulates an input string value.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated string value.\"\"\"\n        return self._value\nclass MatchResult:\n    \"\"\"Represents the result of a pattern match.\"\"\"\n    def __init__(self, matched: bool, substring: Optional[str]):\n        self._matched = matched\n        self._substring = substring\n\n    def is_matched(self) -> bool:\n        \"\"\"Indicates if a match was found.\"\"\"\n        return self._matched\n\n    def get_substring(self) -> Optional[str]:\n        \"\"\"Returns the matched substring, or None if no match.\"\"\"\n        return self._substring\nclass PatternMatcher:\n    \"\"\"Encapsulates the regex and determines if it matches in a string.\"\"\"\n    regex: str = r\"[a-z]+_[a-z]+\"\n    \n    def __init__(self):\n        self._compiled_regex = re.compile(self.regex)\n\n    def matchesLowercaseUnderscore(self, s: str) -> MatchResult:\n        \"\"\"\n        Checks if any substring of s matches the regex and returns a MatchResult.\n        \"\"\"\n        match = self._compiled_regex.search(s)\n        if match:\n            return MatchResult(True, match.group(0))\n        else:\n            return MatchResult(False, None)\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"\n    Detects if the input string contains at least one contiguous substring\n    matching \"[a-z]+_[a-z]+\".\n    \"\"\"\n    # InputString object is created per design's domain classes.\n    input_obj = InputString(input)\n    \n    # Delegation to PatternMatcher happens, returning a MatchResult.\n    matcher = PatternMatcher()\n    match_result = matcher.matchesLowercaseUnderscore(input_obj.get_value())\n    \n    # The public API returns a boolean based on the match result.\n    return match_result.is_matched()"}
{"task_id": "Mbpp/16", "solution": "import re\nPATTERN: str = r\"[a-z]+_[a-z]+\"\n_COMPILED_PATTERN: re.Pattern = re.compile(PATTERN)\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"\n    Detects if the input string contains a substring matching the pattern [a-z]+_[a-z]+.\n    Matching is case-sensitive and can appear at any position.\n    \"\"\"\n    return _COMPILED_PATTERN.search(input) is not None"}
