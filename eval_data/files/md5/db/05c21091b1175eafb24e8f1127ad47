{"task_id": "Mbpp/478", "solution": "class InputString:\n    \"\"\"Encapsulates input string and provides helpers.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the input string is empty.\"\"\"\n        return len(self.value) == 0\n\n    def char_at(self, i: int) -> str:\n        \"\"\"Returns the character at the given index.\"\"\"\n        return self.value[i]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\nclass OutputString:\n    \"\"\"Mutable builder for output characters.\"\"\"\n    def __init__(self):\n        self._chars: list[str] = []\n\n    def append(self, ch: str) -> None:\n        \"\"\"Appends a character to the output.\"\"\"\n        self._chars.append(ch)\n\n    def to_string(self) -> str:\n        \"\"\"Converts the accumulated characters to a single string.\"\"\"\n        return \"\".join(self._chars)\nclass StringProcessor:\n    \"\"\"Scans input to identify and remove lowercase segments, building the output.\"\"\"\n    def __init__(self, input_str_obj: InputString):\n        self._input = input_str_obj\n\n    def process(self) -> OutputString:\n        \"\"\"Processes the input string and returns an OutputString.\"\"\"\n        output = OutputString()\n        length = self._input.length()\n        i = 0\n        while i < length:\n            char = self._input.char_at(i)\n            if 'a' <= char <= 'z':\n                # Current character is lowercase, find end of segment to skip\n                segment_end = i\n                while segment_end < length and 'a' <= self._input.char_at(segment_end) <= 'z':\n                    segment_end += 1\n                i = segment_end # Move index past the entire lowercase segment\n            else:\n                # Not a lowercase character, append it to the output\n                output.append(char)\n                i += 1\n        return output\ndef remove_lowercase(input: str) -> str:\n    \"\"\"\n    Removes contiguous ASCII-lowercase-only substrings from an input string.\n    Preserves order and content of all other characters.\n    \"\"\"\n    input_obj = InputString(input)\n    processor = StringProcessor(input_obj)\n    output_obj = processor.process()\n    return output_obj.to_string()"}
