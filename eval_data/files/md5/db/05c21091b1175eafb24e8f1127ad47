{"task_id": "Mbpp/739", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Optional\nclass TriangularNumber:\n    \"\"\"Encapsulates triangular number computations and digit-count logic.\"\"\"\n    def __init__(self, k: int):\n        self._k = k\n\n    def value(self) -> int:\n        \"\"\"Computes and returns T_k = k * (k + 1) // 2.\"\"\"\n        return self._k * (self._k + 1) // 2\n\n    def digitCount(self) -> int:\n        \"\"\"Computes digit count using len(str(value)).\"\"\"\n        return len(str(self.value()))\ndef _seed_k_for_digits(n: int) -> int:\n    \"\"\"Computes a conservative initial k estimate for n digits using an approximation.\"\"\"\n    # T_k approx k^2/2. For T_k to have n digits, T_k >= 10^(n-1).\n    # So k approx sqrt(2 * 10^(n-1)).\n    candidate = int(math.floor(math.sqrt(2 * (10**(n-1)))))\n    return max(1, candidate) # Ensures k is at least 1.\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Returns the smallest integer k such that T_k = k*(k+1)/2 has exactly n decimal digits.\n    Input validation (n must be a positive integer) is omitted due to critical requirements.\n    \"\"\"\n    k = _seed_k_for_digits(n)\n\n    while True:\n        triangular = TriangularNumber(k)\n        if triangular.digitCount() == n:\n            return k\n        k += 1"}
