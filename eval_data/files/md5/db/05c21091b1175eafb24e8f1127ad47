{"task_id": "Mbpp/762", "solution": "from typing import Dict\nclass Month:\n    \"\"\"Represents a month with its number, name, and number of days.\"\"\"\n    def __init__(self, monthNumber: int, name: str, days: int) -> None:\n        self.monthNumber = monthNumber\n        self.name = name\n        self.days = days\n\n    def has30Days(self) -> bool:\n        \"\"\"Checks if the month has exactly 30 days.\"\"\"\n        return self.days == 30\nclass InputValidator:\n    \"\"\"Validates month numbers to be integers within the range 1-12.\"\"\"\n    def isValidMonth(self, month: int) -> bool:\n        \"\"\"Returns True if the month is an integer from 1 to 12, False otherwise.\"\"\"\n        return isinstance(month, int) and 1 <= month <= 12\n\n    def assertValid(self, month: int) -> None:\n        \"\"\"Raises ValueError if the month is not an integer from 1 to 12.\"\"\"\n        if not self.isValidMonth(month):\n            raise ValueError(\"month must be integer in 1..12\")\nclass CheckMonthService:\n    \"\"\"Service to determine if a given month number has 30 days, with validation.\"\"\"\n    def __init__(self, validator: InputValidator = None) -> None:\n        self.validator = validator if validator is not None else InputValidator()\n        self.month_table: Dict[int, Month] = {}\n        self._initialize_month_table()\n\n    def _initialize_month_table(self) -> None:\n        \"\"\"Initializes the internal mapping of month numbers to Month objects.\"\"\"\n        month_data = {\n            1: (\"January\", 31),\n            2: (\"February\", 28), # simplified, not considering leap years\n            3: (\"March\", 31),\n            4: (\"April\", 30),\n            5: (\"May\", 31),\n            6: (\"June\", 30),\n            7: (\"July\", 31),\n            8: (\"August\", 31),\n            9: (\"September\", 30),\n            10: (\"October\", 31),\n            11: (\"November\", 30),\n            12: (\"December\", 31),\n        }\n        for number, (name, days) in month_data.items():\n            self.month_table[number] = Month(number, name, days)\n\n    def check_monthnumber_number(self, month: int) -> bool:\n        \"\"\"Validates the input and returns True if the month has 30 days.\"\"\"\n        self.validator.assertValid(month)\n        month_obj = self.month_table[month]\n        return month_obj.has30Days()\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number has 30 days.\n    Raises ValueError for invalid month inputs (not 1-12).\n    \"\"\"\n    validator = InputValidator()\n    service = CheckMonthService(validator=validator)\n    return service.check_monthnumber_number(month)"}
{"task_id": "Mbpp/763", "solution": "from typing import Sequence, Union\nclass ValidationRule:\n    \"\"\"Enforces input validation rules for arr and n.\"\"\"\n    min_length: int = 2\n\n    def validate(self, arr: Sequence[Union[int, float]], n: int) -> None:\n        \"\"\"Validates that n is an integer >= min_length and len(arr) == n, raising ValueError on failure.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Parameter 'n' must be an integer.\")\n        if n < self.min_length:\n            raise ValueError(f\"Array length 'n' must be at least {self.min_length}.\")\n        if len(arr) != n:\n            raise ValueError(f\"Length of 'arr' ({len(arr)}) does not match parameter 'n' ({n}).\")\nclass Result:\n    \"\"\"A lightweight container for the computed minimum difference.\"\"\"\n    def __init__(self, min_diff: Union[int, float]):\n        self.min_diff = min_diff\ndef find_min_diff(arr: Sequence[Union[int, float]], n: int) -> Union[int, float]:\n    \"\"\"\n    Computes the minimum absolute difference between any two distinct numeric elements in arr.\n    Raises ValueError if input validation fails per specified rules.\n    \"\"\"\n    # Validate inputs using ValidationRule\n    validator = ValidationRule()\n    validator.validate(arr, n)\n\n    # Convert to a list and sort for efficient difference calculation\n    sorted_arr = sorted(list(arr))\n\n    min_diff = float('inf')\n    # Iterate through adjacent elements to find the minimum difference\n    for i in range(1, n):\n        diff = abs(sorted_arr[i] - sorted_arr[i-1])\n        min_diff = min(min_diff, diff)\n\n    # The design specifies creating a Result object, though the function returns the numeric value directly.\n    _ = Result(min_diff) \n    \n    # Return 0 if min_diff is extremely small (e.g., from floating point precision or duplicates resulting in 0)\n    # This also handles cases where duplicates lead to min_diff being exactly 0.\n    if min_diff == 0.0:\n        return 0\n    # Attempt to return an int if possible, otherwise float\n    return int(min_diff) if min_diff == int(min_diff) else min_diff"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two distinct elements\n    among the first n elements of the array.\n    \"\"\"\n    selected_elements = list(array[:n])\n    selected_elements.sort()\n\n    min_diff = float('inf')\n\n    for i in range(len(selected_elements) - 1):\n        if selected_elements[i] == selected_elements[i+1]:\n            return 0  # Duplicates found, return 0\n        \n        diff = abs(selected_elements[i+1] - selected_elements[i])\n        if diff < min_diff:\n            min_diff = diff\n            \n    return min_diff"}
