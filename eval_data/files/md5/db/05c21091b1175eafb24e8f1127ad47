{"task_id": "Mbpp/89", "solution": "from src.validator import Validator\nfrom src.compute import Compute\nclass NumberInput:\n    \"\"\"Wraps a raw input value for validation.\"\"\"\n    def __init__(self, value):\n        \"\"\"Initializes with the input value.\"\"\"\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Validates if the wrapped value is numeric using Validator.\"\"\"\n        return Validator.is_numeric(self.value)\nclass ClosestNumFunction:\n    \"\"\"Orchestrates computation of the closest number.\"\"\"\n    def __init__(self, n):\n        \"\"\"Initializes with the numeric input n.\"\"\"\n        self.n = n\n\n    def execute(self) -> int:\n        \"\"\"Executes the computation using Compute.\"\"\"\n        return Compute.largest_int_less_than(self.n)\ndef closest_num(n) -> int:\n    \"\"\"\n    Returns the largest integer strictly less than n.\n    Raises TypeError for non-numeric inputs.\n    \"\"\"\n    number_input = NumberInput(n)\n    if not number_input.validate():\n        raise TypeError(\"Input must be numeric (int or float).\")\n\n    closest_num_executor = ClosestNumFunction(n)\n    return closest_num_executor.execute()"}
{"task_id": "Mbpp/87", "solution": "from typing import Dict, Any, Optional\nclass Dictionary:\n    \"\"\"Runtime representation of a dictionary mapping string keys to string values.\"\"\"\n    def __init__(self, entries: Optional[Dict[str, str]] = None) -> None:\n        self.entries = entries if entries is not None else {}\n\n    def as_dict(self) -> Dict[str, str]:\n        \"\"\"Returns the internal entries as a native dict.\"\"\"\n        return self.entries\nclass InputValidator:\n    \"\"\"Validates raw inputs and produces internal Dictionary instances.\"\"\"\n    def validate_raw(self, dict_like: Any) -> Dictionary:\n        \"\"\"Validates input type and content, raising TypeError on failure.\"\"\"\n        if not isinstance(dict_like, dict):\n            raise TypeError(f\"Input must be a dictionary, but got {type(dict_like).__name__}.\")\n\n        for key, value in dict_like.items():\n            if not isinstance(key, str):\n                raise TypeError(f\"Dictionary keys must be strings, but found key '{key}' of type {type(key).__name__}.\")\n            if not isinstance(value, str):\n                raise TypeError(f\"Dictionary values must be strings, but found value '{value}' for key '{key}' of type {type(value).__name__}.\")\n        \n        return Dictionary(dict_like)\nclass MergeFunction:\n    \"\"\"Merges three Dictionary instances into one Dictionary.\"\"\"\n    def merge(self, dict1: Dictionary, dict2: Dictionary, dict3: Dictionary) -> Dictionary:\n        \"\"\"Merges three dictionaries; later inputs override earlier ones for duplicate keys.\"\"\"\n        merged_entries = {}\n        merged_entries.update(dict1.entries)\n        merged_entries.update(dict2.entries)\n        merged_entries.update(dict3.entries)\n        return Dictionary(merged_entries)\ndef merge_dictionaries_three(dict1: Dict[str, str], dict2: Dict[str, str], dict3: Dict[str, str]) -> Dict[str, str]:\n    \"\"\"Public API to merge three dictionaries with validation and conflict resolution.\"\"\"\n    validator = InputValidator()\n    d1 = validator.validate_raw(dict1)\n    d2 = validator.validate_raw(dict2)\n    d3 = validator.validate_raw(dict3)\n\n    merger = MergeFunction()\n    result_dict_obj = merger.merge(d1, d2, d3)\n\n    return result_dict_obj.as_dict()"}
