{"task_id": "Mbpp/463", "solution": "from typing import List\nclass Array:\n    \"\"\"Represents an input array of integers, providing indexed access and metadata.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements: List[int] = elements\n        self.length: int = len(elements)\n\n    def getElement(self, index: int) -> int:\n        \"\"\"Retrieves an element by its index from the array.\"\"\"\n        return self.elements[index]\nclass MaxProductResult:\n    \"\"\"Holds the final maximum product result value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\nclass Algorithm:\n    \"\"\"Encapsulates the algorithm for computing the maximum contiguous-subarray product.\"\"\"\n    @classmethod\n    def max_subarray_product(cls, arr: List[int]) -> int:\n        \"\"\"Entrypoint for the algorithm, adapting the input array and delegating computation.\"\"\"\n        # Preconditions (non-empty list of ints) are assumed per BR7/CRITICAL requirements.\n        # Python integers handle arbitrary size, so explicit overflow addressing is not required (BR8).\n        array_obj = Array(arr)\n        result = cls._compute_from_array(array_obj)\n        return result.value\n\n    @staticmethod\n    def _compute_from_array(array: Array) -> MaxProductResult:\n        \"\"\"Implements the iterative algorithm to find the maximum product subarray.\"\"\"\n        current_max = array.getElement(0)\n        current_min = array.getElement(0)\n        global_max = array.getElement(0)\n\n        for i in range(1, array.length):\n            x = array.getElement(i)\n            \n            # If current number is negative, swap current_max and current_min's roles.\n            if x < 0:\n                current_max, current_min = current_min, current_max\n            \n            # Update current_max and current_min considering the current element x.\n            current_max = max(x, current_max * x)\n            current_min = min(x, current_min * x)\n            \n            # Update global maximum product found so far.\n            global_max = max(global_max, current_max)\n            \n        return MaxProductResult(global_max)\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Computes the maximum product of any contiguous subarray of the input integer array arr.\n    Assumes `arr` is a non-empty list of integers, per BR7 and critical requirements.\n    \"\"\"\n    return Algorithm.max_subarray_product(arr)"}
