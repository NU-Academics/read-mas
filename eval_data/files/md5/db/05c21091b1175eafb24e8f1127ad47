{"task_id": "Mbpp/598", "solution": "from typing import List\ndef _compute_digit_count(n: int) -> int:\n    \"\"\"Returns the number of decimal digits in n.\"\"\"\n    if n == 0:\n        return 1\n    return len(str(n))\ndef _extract_digits(n: int) -> List[int]:\n    \"\"\"Extracts decimal digits from n into a list.\"\"\"\n    return [int(digit) for digit in str(n)]\ndef _sum_powered_digits(digits: List[int], power: int) -> int:\n    \"\"\"Computes the sum of each digit raised to the given power.\"\"\"\n    return sum(digit ** power for digit in digits)\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if an integer n is an Armstrong number.\n    An Armstrong number is one that is the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    digit_count = _compute_digit_count(n)\n    digits = _extract_digits(n)\n    powered_sum = _sum_powered_digits(digits, digit_count)\n    return powered_sum == n"}
{"task_id": "Mbpp/597", "solution": "from src.validation import ValidationService\nfrom src.domain import SortedArray\ndef _kth_by_partition(sa: SortedArray, sb: SortedArray, k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element using a binary search partitioning method.\n    Assumes arrays are sorted and k is 1-based and validated.\n    \"\"\"\n    A, B = sa, sb\n    len_A, len_B = A.length, B.length\n\n    # Ensure A is the shorter array for binary search optimization\n    if len_A > len_B:\n        A, B = B, A\n        len_A, len_B = len_B, len_A\n\n    # Binary search range for elements to take from A (partition_A_size)\n    # This ensures partition_B_size (k - partition_A_size) is also valid\n    low = max(0, k - len_B)\n    high = min(len_A, k)\n\n    while low <= high:\n        partition_A_size = (low + high) // 2\n        partition_B_size = k - partition_A_size\n\n        # Get elements around the partitions, handling boundary conditions\n        A_left = A.get(partition_A_size - 1) if partition_A_size > 0 else -float('inf')\n        A_right = A.get(partition_A_size) if partition_A_size < len_A else float('inf')\n        B_left = B.get(partition_B_size - 1) if partition_B_size > 0 else -float('inf')\n        B_right = B.get(partition_B_size) if partition_B_size < len_B else float('inf')\n\n        if A_left <= B_right and B_left <= A_right:\n            # Found the correct partition\n            return max(A_left, B_left)\n        elif A_left > B_right:\n            # partition_A_size is too large, need fewer elements from A\n            high = partition_A_size - 1\n        else: # B_left > A_right\n            # partition_A_size is too small, need more elements from A\n            low = partition_A_size + 1\n    \n    # Should not reach here if inputs are valid as per design\n    raise RuntimeError(\"Algorithm failed to find kth element - this should not happen with valid inputs.\")\ndef find_kth(arr1, arr2, k):\n    \"\"\"\n    Finds the k-th smallest element from two ascending-sorted arrays.\n    Validates inputs and uses a partitioning algorithm for efficiency.\n    \"\"\"\n    validation_service = ValidationService()\n    validation_service.validate_arrays(arr1, arr2)\n\n    sa = SortedArray(arr1)\n    sb = SortedArray(arr2)\n    total_length = sa.length + sb.length\n\n    validation_service.validate_k(k, total_length)\n\n    # Use the more efficient partitioning algorithm\n    return _kth_by_partition(sa, sb, k)"}
{"task_id": "Mbpp/598", "solution": "def compute_sum_of_powers(n: int) -> int:\n    \"\"\"\n    Computes the sum of each digit of n raised to the power of the total number of digits in n.\n    This helper function ensures O(d) runtime where d is the number of digits.\n    \"\"\"\n    s = str(n)\n    d = len(s)\n    total_sum = 0\n    for digit_char in s:\n        digit = int(digit_char)\n        total_sum += digit ** d\n    return total_sum\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is an Armstrong number.\n    Returns True if n is an Armstrong number, False otherwise, operating in O(d) time.\n    \"\"\"\n    return compute_sum_of_powers(n) == n"}
