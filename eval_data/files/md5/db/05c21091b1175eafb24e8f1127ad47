{"task_id": "Mbpp/456", "solution": "from typing import List\nfrom src.domains import StringItem, StringList\nclass ReverseStringListService:\n    \"\"\"\n    Service class responsible for reversing strings within a list.\n    It orchestrates string reversal using domain objects.\n    \"\"\"\n    def reverseStringList(self, input_list: List[str]) -> List[str]:\n        \"\"\"\n        Reverses each string in the input list, preserving order.\n        Returns an empty list if the input list is empty.\n        \"\"\"\n        string_list_domain = StringList(input_list)\n        if string_list_domain.isEmpty():\n            return []\n\n        reversed_strings = []\n        for s in string_list_domain.items:\n            string_item = StringItem(s)\n            reversed_strings.append(string_item.reverse())\n        \n        return reversed_strings\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Public API function to reverse each string in a given list.\n    Delegates the core logic to ReverseStringListService.\n    \"\"\"\n    service = ReverseStringListService()\n    return service.reverseStringList(input_list)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_sublists):\n    \"\"\"Finds the sublist with the minimum length from a list of sublists.\n    Returns the first such sublist encountered in input order.\"\"\"\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist in list_of_sublists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/459", "solution": "from typing import List\nclass Character:\n    \"\"\"Represents a single character and provides an uppercase check.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_uppercase(self) -> bool:\n        \"\"\"Checks if the character is an ASCII uppercase letter 'A' through 'Z'.\"\"\"\n        return len(self.value) == 1 and 'A' <= self.value <= 'Z'\nclass InputString:\n    \"\"\"Lightweight holder for an input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass OutputString:\n    \"\"\"Lightweight holder for an output string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass RemoveUppercaseFunction:\n    \"\"\"Encapsulates the logic to remove uppercase characters from a string.\"\"\"\n    def execute(self, input: str) -> str:\n        in_obj = InputString(input)\n        out_chars: List[str] = []\n        for ch in in_obj.value:\n            c = Character(ch)\n            if not c.is_uppercase():\n                out_chars.append(ch)\n        return OutputString(''.join(out_chars)).value\ndef remove_uppercase(input: str) -> str:\n    \"\"\"Public API: Accepts a string and returns it with ASCII 'A'..'Z' characters removed.\"\"\"\n    impl = RemoveUppercaseFunction()\n    return impl.execute(input)"}
