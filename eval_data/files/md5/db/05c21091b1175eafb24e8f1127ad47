{"task_id": "Mbpp/266", "solution": "from .validator import InputValidator\nfrom .models import Cube, LateralSurfaceResult\nclass LateralSurfaceCalculator:\n    \"\"\"Encapsulates the calculation of a cube's lateral surface area.\"\"\"\n\n    def lateralsurface_cube(self, side) -> float:\n        \"\"\"\n        Validates side and computes the lateral surface area using the class's calculate method.\n        Raises TypeError if side is not numeric.\n        \"\"\"\n        validator = InputValidator()\n        if not validator.isNumeric(side):\n            raise TypeError(\"side must be numeric (int or float)\")\n        return self.calculate(side)\n\n    def calculate(self, side) -> float:\n        \"\"\"Calculates the lateral surface area using the formula 4 * side^2.\"\"\"\n        return 4 * (side ** 2)\ndef lateralsurface_cube(side) -> float:\n    \"\"\"\n    Computes the lateral surface area of a cube.\n    Validates input and delegates to LateralSurfaceCalculator for calculation.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isNumeric(side):\n        raise TypeError(\"side must be numeric (int or float)\")\n    \n    calc = LateralSurfaceCalculator()\n    return calc.calculate(side)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"Splits an input list into n sublists by distributing elements cyclically based on their index.\n    Elements at index i are placed into returned_sublists[i mod n], preserving relative order within each sublist.\n    \"\"\"\n    sublists = [[] for _ in range(n)]\n\n    for i, element in enumerate(input_list):\n        target_sublist_index = i % n\n        sublists[target_sublist_index].append(element)\n\n    return sublists"}
