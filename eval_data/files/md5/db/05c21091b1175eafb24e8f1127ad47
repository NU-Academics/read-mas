{"task_id": "Mbpp/223", "solution": "from src.models import SortedArray, Result\nfrom typing import Any, List\nclass MajorityFunction:\n    \"\"\"Stateless component for determining majority status.\"\"\"\n    def is_majority(self, arr: List[Any], n: int, x: Any) -> bool:\n        \"\"\"Determines if x is the majority element in arr[0:n].\"\"\"\n        sorted_array_wrapper = SortedArray(arr, n)\n        slice_of_first_n = sorted_array_wrapper.get_slice()\n        \n        count = self._count_in_first_n(slice_of_first_n, n, x)\n        \n        is_majority_bool = count > n / 2\n        \n        # Result object is created internally as per design sequence but unwrapped to return bool.\n        _result_obj = Result(is_majority_bool)\n        return _result_obj.value\n\n    def _count_in_first_n(self, arr_slice: List[Any], n: int, x: Any) -> int:\n        \"\"\"Counts occurrences of x in the provided slice.\"\"\"\n        count = 0\n        for element in arr_slice:\n            if element == x:\n                count += 1\n        return count\ndef is_majority(arr: List[Any], n: int, x: Any) -> bool:\n    \"\"\"Public API function to check if x is the majority element in arr[0:n].\"\"\"\n    return MajorityFunction().is_majority(arr, n, x)"}
