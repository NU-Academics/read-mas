{"task_id": "Mbpp/643", "solution": "class Word:\n    \"\"\"Domain model representing a single word token from the input.\"\"\"\n    def __init__(self, value: str, startIndex: int, endIndex: int):\n        self.value = value\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\n    def __len__(self) -> int:\n        return len(self.value)\n\n    def __getitem__(self, index: int) -> str:\n        return self.value[index]\nclass Tokenizer:\n    \"\"\"Tokenizer component that splits input strings into Word tokens.\"\"\"\n    def tokenize(self, text: str) -> list[Word]:\n        \"\"\"Returns a list of Word objects, tokenized by non-alphanumeric characters.\"\"\"\n        words = []\n        current_word_start = -1\n\n        for i, char in enumerate(text):\n            if char.isalnum():\n                if current_word_start == -1:\n                    current_word_start = i\n            else:\n                if current_word_start != -1:\n                    word_value = text[current_word_start:i]\n                    words.append(Word(word_value, current_word_start, i))\n                    current_word_start = -1\n\n        if current_word_start != -1:\n            word_value = text[current_word_start:len(text)]\n            words.append(Word(word_value, current_word_start, len(text)))\n\n        return words\nclass Matcher:\n    \"\"\"Matcher component which inspects Word objects to detect qualifying internal 'z' occurrences.\"\"\"\n    def hasMiddleZ(self, word: Word) -> bool:\n        \"\"\"Returns True if the word contains a lowercase 'z' not at its start or end.\"\"\"\n        if len(word) < 3:\n            return False\n\n        for i in range(1, len(word) - 1):\n            if word[i] == 'z':\n                return True\n        return False\n\n    def findInText(self, text: str) -> bool:\n        \"\"\"Tokenizes text and returns True if any word satisfies hasMiddleZ, otherwise False.\"\"\"\n        tokenizer = Tokenizer()\n        words = tokenizer.tokenize(text)\n\n        for word in words:\n            if self.hasMiddleZ(word):\n                return True\n        return False\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Public API: returns True if any lowercase 'z' occurs with at least one alphanumeric character before and after it within the same word.\"\"\"\n    matcher = Matcher()\n    return matcher.findInText(text)"}
{"task_id": "Mbpp/643", "solution": "import re\nimport string\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains the literal lowercase character 'z'\n    at a non-first and non-last position within any parsed word.\n    \"\"\"\n    PUNCTUATION_CHARS = string.punctuation\n\n    # Find sequences of non-whitespace characters to identify potential word tokens.\n    # This initial step treats whitespace as word boundaries.\n    for match in re.finditer(r'\\S+', text):\n        raw_token = match.group(0)\n\n        # Trim leading and trailing punctuation from the raw token.\n        # This handles FR4's requirement to trim punctuation and ensures only\n        # the core word is considered for 'z' detection.\n        lstripped_token = raw_token.lstrip(PUNCTUATION_CHARS)\n        trimmed_word_value = lstripped_token.rstrip(PUNCTUATION_CHARS)\n\n        # Check if the trimmed word is valid and contains 'z' at an interior position.\n        # A 'z' can only be in the middle if the word has at least 3 characters (FR2).\n        if len(trimmed_word_value) >= 3:\n            # Iterate through characters from the second (index 1) to the\n            # second-to-last (index len-2) to check for 'z' (FR2).\n            for i in range(1, len(trimmed_word_value) - 1):\n                if trimmed_word_value[i] == 'z': # Match only literal lowercase 'z' (FR5).\n                    return True  # Found 'z' in the middle of a word, satisfy FR2 and return True.\n\n    return False # No 'z' found in the middle of any word, satisfy FR3."}
