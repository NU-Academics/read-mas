{"task_id": "Mbpp/283", "solution": "from typing import List, Dict, Iterable, Tuple\nclass IntegerInput:\n    \"\"\"Holds an integer value and provides its decimal digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n        self._abs_value: int = abs(value)\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns a list of decimal digits from the absolute value.\"\"\"\n        if self._abs_value == 0:\n            return [0]\n        return [int(d) for d in str(self._abs_value)]\nclass DigitFrequencyMap:\n    \"\"\"Counts and provides frequencies for digits.\"\"\"\n    def __init__(self) -> None:\n        self.map: Dict[int, int] = {}\n\n    def increment(self, d: int) -> None:\n        \"\"\"Increments the frequency count for a given digit.\"\"\"\n        self.map[d] = self.map.get(d, 0) + 1\n\n    def items(self) -> Iterable[Tuple[int, int]]:\n        \"\"\"Returns an iterable of (digit, frequency) pairs.\"\"\"\n        return self.map.items()\nclass ValidationResult:\n    \"\"\"Represents the outcome of a validation.\"\"\"\n    def __init__(self, is_valid: bool) -> None:\n        self.is_valid: bool = is_valid\ndef validate(n: int) -> bool:\n    \"\"\"Checks if each digit's frequency is less than or equal to the digit itself.\"\"\"\n    integer_input = IntegerInput(n)\n    digits = integer_input.digits()\n\n    freq_map = DigitFrequencyMap()\n    for d_val in digits:\n        freq_map.increment(d_val)\n    \n    for digit, frequency in freq_map.items():\n        if frequency > digit:\n            return ValidationResult(False).is_valid\n            \n    return ValidationResult(True).is_valid"}
