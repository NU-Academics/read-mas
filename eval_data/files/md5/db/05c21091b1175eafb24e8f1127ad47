{"task_id": "Mbpp/572", "solution": "from typing import List, Dict, Optional\nclass FrequencyMap:\n    \"\"\"Manages counts and first-seen indices for integers.\"\"\"\n    def __init__(self):\n        self._counts: Dict[int, int] = {}\n        self._first_index: Dict[int, int] = {}\n\n    def increment(self, value: int, index: int) -> None:\n        \"\"\"Increments the count for a value and records its first index if not seen before.\"\"\"\n        self._counts[value] = self._counts.get(value, 0) + 1\n        if value not in self._first_index:\n            self._first_index[value] = index\n\n    def get_count(self, value: int) -> int:\n        \"\"\"Returns the count for a given value.\"\"\"\n        return self._counts.get(value, 0)\n\n    def get_first_index(self, value: int) -> Optional[int]:\n        \"\"\"Returns the first index where a value was seen.\"\"\"\n        return self._first_index.get(value)\nclass Number:\n    \"\"\"Simple container for a value, its count, and its first seen index.\"\"\"\n    def __init__(self, value: int, count: int, first_index: int):\n        self.value = value\n        self.count = count\n        self.first_index = first_index\n\n    def __repr__(self):\n        \"\"\"Provides a string representation for debugging.\"\"\"\n        return f\"Number(value={self.value}, count={self.count}, first_index={self.first_index})\"\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"Return integers that occur exactly once in input_list, preserving first-seen order.\"\"\"\n    if not input_list:\n        return []\n\n    freq_map = FrequencyMap()\n    for index, value in enumerate(input_list):\n        freq_map.increment(value, index)\n\n    candidates: List[Number] = []\n    # Collect all distinct numbers that were seen.\n    # Iterate through keys of _first_index to get all unique elements that were ever encountered.\n    all_distinct_numbers_seen = freq_map._first_index.keys()\n    \n    for value in all_distinct_numbers_seen:\n        count = freq_map.get_count(value)\n        if count == 1:\n            first_index = freq_map.get_first_index(value)\n            # first_index will not be None here as count is 1.\n            candidates.append(Number(value, count, first_index))\n    \n    # Sort the Number objects by their first_index to preserve order.\n    candidates.sort(key=lambda n: n.first_index)\n\n    return [n.value for n in candidates]"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list) -> int:\n    \"\"\"Calculates the product of unique numbers in a list.\n    Returns 1 for an empty input list.\n    \"\"\"\n    unique_values = set(numbers)\n    product = 1\n    for value in unique_values:\n        product *= value\n    return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a, list_b):\n    \"\"\"Checks if list_b is a contiguous sublist of list_a.\n    Performs search and handles edge cases without modifying inputs.\n    \"\"\"\n    n = len(list_a)\n    m = len(list_b)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        match = True\n        for k in range(m):\n            if list_a[i + k] != list_b[k]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(first_list: list, second_list: list) -> bool:\n    \"\"\"Return True if second_list is a contiguous sublist of first_list, otherwise False.\n    This function uses Python's == semantics for element equality.\n    \"\"\"\n    if len(second_list) > len(first_list):\n        return False\n\n    if not second_list:  # An empty list is considered a sublist of any list\n        return True\n\n    for i in range(len(first_list) - len(second_list) + 1):\n        if first_list[i : i + len(second_list)] == second_list:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"Calculates the last decimal digit of n! for a non-negative integer n.\n    Returns 0 for n >= 5, otherwise computes and returns the last digit based on n.\"\"\"\n    \n    if n >= 5:\n        return 0\n    \n    # For n < 5, we directly map n to the last digit of n!.\n    # 0! = 1, 1! = 1, 2! = 2, 3! = 6, 4! = 24.\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
