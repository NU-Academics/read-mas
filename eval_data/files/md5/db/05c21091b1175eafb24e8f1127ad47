{"task_id": "Mbpp/759", "solution": "import re\nclass DecimalPattern:\n    \"\"\"Encapsulates the authoritative decimal regex pattern.\n    It provides a textual description of the pattern.\n    \"\"\"\n    def __init__(self, regex: str = r\"^\\d+\\.\\d{2}$\"):\n        self.regex = regex\n\n    def describe(self) -> str:\n        \"\"\"Returns a short textual description of the regex.\"\"\"\n        return f\"Matches one or more digits, a decimal point, and exactly two digits after the decimal: '{self.regex}'\"\nclass DecimalValidator:\n    \"\"\"Performs validation of decimal strings using a DecimalPattern.\"\"\"\n    def __init__(self, name: str, pattern: DecimalPattern):\n        self.name = name\n        self.pattern = pattern\n        self._compiled = re.compile(self.pattern.regex)\n\n    def is_decimal(self, input_value) -> bool:\n        \"\"\"Validates if the input matches the decimal pattern.\n        Returns False for non-string inputs.\n        \"\"\"\n        if not isinstance(input_value, str):\n            return False\n        return bool(self._compiled.fullmatch(input_value))\n_default_decimal_pattern = DecimalPattern()\n_default_decimal_validator = DecimalValidator(\n    name=\"StandardDecimalValidator\",\n    pattern=_default_decimal_pattern\n)\ndef is_decimal(input) -> bool:\n    \"\"\"Checks if the input is a valid decimal number with a precision of 2.\"\"\"\n    return _default_decimal_validator.is_decimal(input)"}
