{"task_id": "Mbpp/809", "solution": "def check_smaller(first: tuple, second: tuple) -> bool:\n    \"\"\"Checks if every element in the second tuple is strictly smaller than its corresponding element in the first.\n    Assumes tuples have the same length and elements support comparison.\"\"\"\n    for f_val, s_val in zip(first, second):\n        if s_val >= f_val:\n            return False\n    return True"}
{"task_id": "Mbpp/809", "solution": "from .comparison_engine import ComparisonEngine\nfrom .models import TupleInput, ComparisonResult\nfrom .check_smaller import check_smaller\nclass ComparisonEngine:\n    \"\"\"Provides numeric comparison semantics for two numbers.\"\"\"\n    def compare(self, a: int | float, b: int | float) -> bool:\n        \"\"\"Returns True if b is strictly less than a, False otherwise.\"\"\"\n        return b < a\nclass CheckSmaller:\n    \"\"\"Orchestrates validation and elementwise comparison using ComparisonEngine.\"\"\"\n    def __init__(self, engine: ComparisonEngine | None = None) -> None:\n        \"\"\"Initializes the coordinator with an optional ComparisonEngine.\"\"\"\n        self.engine = engine or ComparisonEngine()\n\n    def validate_lengths(self, tuple1: tuple, tuple2: tuple) -> None:\n        \"\"\"Raises ValueError if the lengths of the two tuples differ.\"\"\"\n        if len(tuple1) != len(tuple2):\n            raise ValueError(\n                f\"tuple length mismatch: len(tuple1)={len(tuple1)}, len(tuple2)={len(tuple2)}\"\n            )\n\n    def check_smaller(self, tuple1: tuple, tuple2: tuple) -> bool:\n        \"\"\"Compares elements pairwise after validating lengths. Returns True if all elements in tuple2 are smaller than their corresponding elements in tuple1.\"\"\"\n        self.validate_lengths(tuple1, tuple2)\n        \n        for i in range(len(tuple1)):\n            if not self.engine.compare(tuple1[i], tuple2[i]):\n                return False\n        return True\ndef check_smaller(tuple1, tuple2) -> bool:\n    \"\"\"Checks if each element of tuple2 is smaller than its corresponding element in tuple1.\"\"\"\n    coordinator = CheckSmaller(engine=ComparisonEngine())\n    return coordinator.check_smaller(tuple1, tuple2)"}
