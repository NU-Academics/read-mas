{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple, Union\nclass TuplePair:\n    \"\"\"Represents a 2-element numeric pair and computes its product.\"\"\"\n    a: Union[int, float]\n    b: Union[int, float]\n\n    def __init__(self, a: Union[int, float], b: Union[int, float]) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> Union[int, float]:\n        \"\"\"Computes the product of the pair's elements.\"\"\"\n        return self.a * self.b\nclass InputList:\n    \"\"\"Wrapper/validator for the input sequence of 2-element tuples.\"\"\"\n    pairs: List[Tuple[Union[int, float], Union[int, float]]]\n\n    def __init__(self, pairs: List[Tuple[Union[int, float], Union[int, float]]]) -> None:\n        self.pairs = pairs\n\n    def validate(self) -> None:\n        \"\"\"Validates each element in the input list for type and structure.\"\"\"\n        for i, item in enumerate(self.pairs):\n            if not isinstance(item, tuple):\n                raise TypeError(f\"Element at index {i} is not a tuple: {item}\")\n            if len(item) != 2:\n                raise TypeError(f\"Tuple at index {i} must have 2 elements, found {len(item)}: {item}\")\n            for j, val in enumerate(item):\n                if not isinstance(val, (int, float)):\n                    raise TypeError(f\"Element {j} of tuple at index {i} is not numeric: {val}\")\n\n    def as_tuplepairs(self) -> List[TuplePair]:\n        \"\"\"Converts raw validated tuples into TuplePair instances.\"\"\"\n        return [TuplePair(a, b) for a, b in self.pairs]\nclass MinProductResult:\n    \"\"\"Value object representing the computed minimum product.\"\"\"\n    value: Union[int, float]\n\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\ndef min_product_tuple(pairs: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Computes the minimum product from a list of 2-element numeric tuples.\n    Validates input according to the design specification.\n    \"\"\"\n    if not isinstance(pairs, list):\n        raise TypeError(\"Input 'pairs' must be a list.\")\n\n    input_list_obj = InputList(pairs)\n    input_list_obj.validate()\n\n    # After validation, check if the list (now confirmed as list) is empty.\n    if not pairs:\n        raise ValueError('Input list must contain at least one tuple.')\n\n    tuple_pair_instances = input_list_obj.as_tuplepairs()\n    products = [tp.product() for tp in tuple_pair_instances]\n\n    min_val = min(products)\n\n    # Instantiate MinProductResult as per design, though its value is returned directly.\n    _ = MinProductResult(min_val)\n    return min_val"}
{"task_id": "Mbpp/410", "solution": "from typing import Union\ndef min_val(items: list) -> Union[int, float]:\n    \"\"\"\n    Determines the minimum numeric value from a heterogeneous list.\n    Ignores non-numeric elements and raises errors for invalid input or empty numeric sets.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError('items must be a list')\n    numbers = filter_numeric(items)\n    return compute_min(numbers)\ndef filter_numeric(items: list) -> list:\n    \"\"\"\n    Filters a list to include only numeric elements (integers and floats).\n    Returns a new list with these numeric values.\n    \"\"\"\n    return [x for x in items if isinstance(x, (int, float))]\ndef compute_min(numbers: list) -> Union[int, float]:\n    \"\"\"\n    Computes the minimum value from a list of numbers.\n    Raises a ValueError if the list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError('no numeric elements')\n    return min(numbers)"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(input_list: list[int]) -> list[int]:\n    \"\"\"Return a new list containing only the even integers from input_list.\n    The function classifies odd integers using `n % 2 != 0` per the SRS.\n    \"\"\"\n    return [n for n in input_list if n % 2 == 0]"}
{"task_id": "Mbpp/410", "solution": "class ValidationException(Exception):\n    \"\"\"Raised when the input provided is not a list.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass NoNumericValuesException(Exception):\n    \"\"\"Raised when no numeric (int or float) values are found in the list.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef _find_min_numeric(elements):\n    \"\"\"Scans a list to find the minimum int or float, raising an error if none are found.\"\"\"\n    found = False\n    running_min = None\n    for e in elements:\n        if type(e) in (int, float):\n            if not found:\n                running_min = e\n                found = True\n            else:\n                if e < running_min:\n                    running_min = e\n    if not found:\n        raise NoNumericValuesException('no numeric values found')\n    return running_min\ndef min_val(input_list):\n    \"\"\"Returns the minimum numeric value from a list, validating input and handling no numerics.\"\"\"\n    if type(input_list) is not list:\n        raise ValidationException('input must be a list')\n    return _find_min_numeric(input_list)"}
