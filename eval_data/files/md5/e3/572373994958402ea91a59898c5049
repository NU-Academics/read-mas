{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            count += str(i).count('7')\n    return count"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Use the bisection method to find a real root within a wide initial interval.\n    # An odd-degree polynomial (guaranteed by even number of coefficients) always has at least one real root.\n    low, high = -10000.0, 10000.0\n    epsilon = 1e-6\n    \n    val_low = poly(xs, low)\n    val_high = poly(xs, high)\n\n    if abs(val_low) < epsilon:\n        return low\n    if abs(val_high) < epsilon:\n        return high\n\n    # The problem guarantees a solution exists and the given constraints ensure\n    # that a root can be bracketed within a sufficiently large initial interval.\n    for _ in range(100): # Iterate a fixed number of times for convergence\n        mid = (low + high) / 2\n        val_mid = poly(xs, mid)\n\n        if abs(val_mid) < epsilon:\n            return mid\n\n        if val_low * val_mid < 0:  # Root is in the left half [low, mid]\n            high = mid\n            val_high = val_mid\n        else:  # Root is in the right half [mid, high]\n            low = mid\n            val_low = val_mid\n            \n    return (low + high) / 2"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Use a set to filter duplicates, then sort the resulting elements.\n    return sorted(set(l))"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n    result = []\n    even_idx_counter = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result.append(even_elements[even_idx_counter])\n            even_idx_counter += 1\n        else:\n            result.append(l[i])\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group back to original. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to enable the two-pointer approach\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant calculations\n        if i > 0 and l[i] == l[i - 1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    class PrimeValidator:\n        \"\"\"Determines primality of integers using trial division.\"\"\"\n        def isPrime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            if number == 2:\n                return True\n            if number % 2 == 0:\n                return False\n            # Checks odd divisors up to the square root of the number.\n            i = 3\n            while i * i <= number:\n                if number % i == 0:\n                    return False\n                i += 2\n            return True\n\n    class FibonacciGenerator:\n        \"\"\"Generates successive Fibonacci numbers (0, 1, 1, 2, 3, 5, ...).\"\"\"\n        def __init__(self):\n            self._a = 0\n            self._b = 1\n\n        def next(self) -> int:\n            current_fib = self._b\n            self._a, self._b = self._b, self._a + self._b\n            return current_fib\n\n    class PrimeFibCalculator:\n        \"\"\"Orchestrates Fibonacci generation and prime validation to find the N-th prime Fibonacci number.\"\"\"\n        def __init__(self):\n            self._fib_gen = FibonacciGenerator()\n            self._prime_validator = PrimeValidator()\n\n        def getPrimeFib(self, n: int) -> int:\n            count = 0\n            while True:\n                fib_number = self._fib_gen.next()\n                \n                # Skip numbers <= 1 as they are not prime.\n                # The generator yields 1, 1, 2, 3, 5... so the first 1s are filtered.\n                if fib_number <= 1: \n                    continue\n                \n                if self._prime_validator.isPrime(fib_number):\n                    count += 1\n                    if count == n:\n                        return fib_number\n    \n    calculator = PrimeFibCalculator()\n    return calculator.getPrimeFib(n)"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 2:\n        return False\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if l[i] + l[j] == 0:\n                return True\n    return False"}
{"task_id": "HumanEval/44", "solution": "class NumberConverter:\n    \"\"\"Helper class to perform the base conversion algorithm.\"\"\"\n    def __init__(self, x: int, base: int):\n        self.x = x\n        self.base = base\n\n    def convert(self) -> str:\n        if self.x == 0:\n            return '0'\n\n        digits = []\n        current_x = self.x\n        while current_x > 0:\n            remainder = current_x % self.base\n            digits.append(str(remainder))\n            current_x //= self.base\n        return \"\".join(digits[::-1])\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x < 0:\n        raise ValueError(\"Input number x must be non-negative.\")\n    if not (2 <= base <= 9):\n        raise ValueError(\"Base must be between 2 and 9 (inclusive).\")\n\n    converter = NumberConverter(x, base)\n    return converter.convert()"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Return the area of a triangle.\n\n    Parameters\n    ----------\n    a : float\n        Side length of the triangle \u2013 must be positive.\n    h : float\n        Height of the triangle \u2013 must be positive.\n\n    Returns\n    -------\n    float\n        The computed area (0.5 * a * h).\n\n    Raises\n    ------\n    ValueError\n        If *a* or *h* is not positive.\n    \"\"\"\n    from dataclasses import dataclass\n\n    @dataclass\n    class Triangle:\n        sideLength: float\n        height: float\n        area: float = 0.0\n\n        def calculateArea(self) -> float:\n            self.area = 0.5 * self.sideLength * self.height\n            return self.area\n\n    class AreaCalculator:\n        \"\"\"Stateless service that calculates area for a Triangle instance.\"\"\"\n        def calculateArea(self, t: Triangle) -> float:\n            return t.calculateArea()\n\n    if a <= 0:\n        raise ValueError(\"Side length 'a' must be positive\")\n    if h <= 0:\n        raise ValueError(\"Height 'h' must be positive\")\n    triangle = Triangle(sideLength=a, height=h)\n    calculator = AreaCalculator()\n    return calculator.calculateArea(triangle)"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    mid = n // 2\n\n    if n % 2 == 1:\n        return sorted_l[mid]\n    else:\n        return (sorted_l[mid - 1] + sorted_l[mid]) / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function efficiently computes the n-th element of the fib4 sequence using an iterative approach.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize cache with base cases\n    fib_sequence = [0, 0, 2, 0]\n\n    # Compute iteratively from n=4 up to the requested n\n    for i in range(4, n + 1):\n        next_fib = fib_sequence[i-1] + fib_sequence[i-2] + fib_sequence[i-3] + fib_sequence[i-4]\n        fib_sequence.append(next_fib)\n\n    return fib_sequence[n]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p using exponentiation by squaring with modular reduction.\n    \"\"\"\n    result = 1\n    base = 2 % p\n    exp = n\n\n    while exp > 0:\n        if exp & 1:  # If exp is odd\n            result = (result * base) % p\n        base = (base * base) % p\n        exp >>= 1  # exp = exp // 2\n\n    return result"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
