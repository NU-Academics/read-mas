{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Check if mid is part of a pair\n        # If mid is even, check with mid+1\n        # If mid is odd, check with mid-1\n        if mid % 2 == 0:  # mid is an even index\n            if array[mid] == array[mid + 1]:\n                # Pair found, unique element is to the right\n                low = mid + 2\n            else:\n                # Unique element is at mid or to its left\n                high = mid\n        else:  # mid is an odd index\n            if array[mid] == array[mid - 1]:\n                # Pair found, unique element is to the right\n                low = mid + 1\n            else:\n                # Unique element is at mid or to its left\n                high = mid\n\n    # When low == high, we have found the single element\n    return array[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple\n\ndef max_product_tuple(pairs: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    \"\"\"\n    max_abs_product = 0.0\n    for num1, num2 in pairs:\n        current_abs_product = abs(num1 * num2)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of proper divisors for a given number.\n    \"\"\"\n    def _sum_of_proper_divisors(n: int) -> int:\n        if n <= 1:\n            return 0\n        s = 1\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if n // i != i:\n                    s += n // i\n        return s\n\n    \"\"\"\n    Checks if two numbers form an amicable pair.\n    \"\"\"\n    def _is_amicable_pair(a: int, b: int) -> bool:\n        return a != b and _sum_of_proper_divisors(a) == b and _sum_of_proper_divisors(b) == a\n\n    if limit < 1:\n        return 0\n\n    total_sum = 0\n    counted_numbers = set()\n\n    for a in range(2, limit + 1):\n        if a in counted_numbers:\n            continue\n\n        b = _sum_of_proper_divisors(a)\n\n        # Check if b forms an amicable pair with a and is within the limit\n        # b > a ensures each pair is counted once (e.g., (220,284) when a is 220, not 284)\n        if b > a and b <= limit and _is_amicable_pair(a, b):\n            total_sum += a + b\n            counted_numbers.add(a)\n            counted_numbers.add(b)\n\n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_str: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Applies a modified Kadane's algorithm by treating '0' as +1 and '1' as -1.\n    \"\"\"\n    max_diff = 0\n    current_diff = 0\n\n    for char in binary_str:\n        if char == '0':\n            current_diff += 1\n        elif char == '1':\n            current_diff -= 1\n        \n        # If current_diff becomes negative, reset it to 0.\n        # This means the current substring's prefix led to more '1's than '0's,\n        # so it's better to start a new substring from the next character,\n        # or consider an empty substring if all subsequent elements are also negative.\n        if current_diff < 0:\n            current_diff = 0\n        \n        max_diff = max(max_diff, current_diff)\n            \n    return max_diff"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    real: float\n    imag: float\n\nclass AngleCalculator:\n    \"\"\"Calculates the angle of a complex number.\"\"\"\n    def angle_complex(self, c: ComplexNumber) -> float:\n        \"\"\"Calculates the angle (argument) of a ComplexNumber instance.\"\"\"\n        return math.atan2(c.imag, c.real)\n\ndef angle_complex(real: float, imag: complex) -> float:\n    \"\"\"\n    Calculates the angle of a complex number given its real part and\n    an imaginary part coefficient (possibly as a complex number like 1j).\n    \"\"\"\n    # Extract the imaginary component value from the 'imag' argument.\n    # Assuming 'imag' is a complex number itself (e.g., 1j) as per the assert example.\n    imag_component_value = imag.imag\n\n    # Create a ComplexNumber instance as per the design's component structure.\n    complex_num = ComplexNumber(real=real, imag=imag_component_value)\n    \n    # Delegate the calculation to an instance of AngleCalculator.\n    calculator = AngleCalculator()\n    return calculator.angle_complex(complex_num)"}
