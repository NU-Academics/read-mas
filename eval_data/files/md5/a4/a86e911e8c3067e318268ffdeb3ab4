ctive shell\n    \n    exit_code = cli_app.run([\"intfilter\", \"filter\"])\n    \n    assert exit_code == CLIApp.EXIT_INVALID_INPUT\n    mock_stdout.write.assert_not_called()\n    # Expect help message and error on stderr\n    assert \"Error: No input provided\" in mock_stderr.write.call_args[0][0]\n\ndef test_cli_filter_with_save_to(cli_app, mock_controller, mock_stdin, mock_stdout, tmp_path):\n    mock_stdin.isatty.return_value = False\n    mock_stdin.read.return_value = '[1, \"a\", 2]'\n    save_path = tmp_path / \"output.json\"\n\n    with patch('intfilter.cli.FileRepository') as MockFileRepository:\n        mock_repo_instance = MockFileRepository.return_value\n        exit_code = cli_app.run([\"intfilter\", \"filter\", f\"--save-to={save_path}\"])\n        \n        assert exit_code == CLIApp.EXIT_SUCCESS\n        mock_controller.handle.assert_called_once_with([1, 'a', 2])\n        mock_repo_instance.save.assert_called_once_with([1, 2])\n        mock_stdout.write.assert_called_once_with('[1, 2]\\n')\n\ndef test_cli_filter_with_load_from(cli_app, mock_controller, mock_stdout, tmp_path):\n    load_path = tmp_path / \"input.json\"\n    with open(load_path, 'w') as f:\n        json.dump([10, \"x\", 20], f)\n\n    with patch('intfilter.cli.FileRepository') as MockFileRepository:\n        mock_repo_instance = MockFileRepository.return_value\n        mock_repo_instance.load.return_value = [10, 20]\n        \n        exit_code = cli_app.run([\"intfilter\", \"filter\", f\"--load-from={load_path}\"])\n        \n        assert exit_code == CLIApp.EXIT_SUCCESS\n        mock_repo_instance.load.assert_called_once()\n        mock_controller.handle.assert_called_once_with([10, 20])\n        mock_stdout.write.assert_called_once_with('[1, 2]\\n') # Controller returns [1,2]\n\ndef test_cli_filter_with_load_from_and_input(cli_app, mock_controller, mock_stdout, tmp_path):\n    load_path = tmp_path / \"input.json\"\n    with open(load_path, 'w') as f:\n        json.dump([10, \"x\"]