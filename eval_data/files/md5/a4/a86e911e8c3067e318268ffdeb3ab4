{"task_id": "HumanEval/17", "solution": "from typing import List\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n    \"\"\"\n    durations = []\n    i = 0\n    n = len(music_string)\n\n    while i < n:\n        ch = music_string[i]\n\n        if ch.isspace():\n            i += 1\n            continue\n\n        # Attempt to parse two-character tokens first: 'o|' or '.|'\n        if i + 1 < n:\n            two_char_token = music_string[i:i+2]\n            if two_char_token == 'o|':\n                durations.append(2)  # 'o|' is a half note, 2 beats\n                i += 2\n                continue\n            elif two_char_token == '.|':\n                durations.append(1)  # '.|' is a quarter note, 1 beat\n                i += 2\n                continue\n        \n        # If no two-character token matched, attempt to parse one-character token: 'o'\n        if ch == 'o':\n            durations.append(4)  # 'o' is a whole note, 4 beats\n            i += 1\n            continue\n        \n        # If the character is not part of a recognized token ('o', 'o|', '.|') or whitespace,\n        # it is skipped based on the \"trust caller's inputs\" constraint.\n        i += 1\n\n    return durations"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n\n    # Defines the canonical word-to-value mapping as per the NumberWord domain model.\n    _WORD_TO_VALUE = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n    }\n\n    # Handles empty or whitespace-only input as per FR1 and FR2 postconditions.\n    if not numbers or not numbers.strip():\n        return \"\"\n\n    # Tokenizes the input string by splitting on whitespace and normalizes each token to lowercase.\n    tokens: List[str] = [token.strip().lower() for token in numbers.split()]\n\n    # Sorts the list of tokens based on their numeric values using the defined mapping.\n    sorted_tokens: List[str] = sorted(tokens, key=lambda word: _WORD_TO_VALUE[word])\n\n    # Joins the sorted tokens back into a single space-delimited string.\n    return \" \".join(sorted_tokens)\n```"}
{"task_id": "HumanEval/18", "solution": "```python\n# pyproject.toml\n[project]\nname = \"substring-counter-lib\"\nversion = \"0.1.0\"\ndescription = \"A library and CLI to count overlapping substring occurrences.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.8\"\ndependencies = [] # Add any external dependencies here if needed (e.g., typing-extensions for older Python)\n\n[project.readme]\nfile = \"README.md\"\ncontent-type = \"text/markdown\"\n\n[project.scripts]\nsubstring-counter = \"substring_counter.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n\n```python\n# README.md\n# substring-counter-lib\n\nA Python library and command-line interface (CLI) to count overlapping occurrences of a substring within a given string.\n\n## Features\n\n-   **Accurate Counting**: Correctly handles overlapping occurrences (e.g., \"aaaa\" with \"aa\" yields 3).\n-   **Programmatic API**: Use directly in your Python applications.\n-   **CLI Tool**: Run from your terminal.\n-   **Input Validation**: Provides clear error messages for invalid inputs.\n-   **Optional Persistence**: Log query requests and results to a local JSONL file for audit or debugging.\n\n## Installation\n\n```bash\npip install substring-counter-lib # (replace with actual package name later)\n```\n\n## Usage\n\n### Command Line Interface (CLI)\n\n```bash\nsubstring-counter --string \"abababa\" --substring \"aba\"\n```\n\nOutput will be a JSON object:\n\n```json\n{\"timestamp\": \"...\", \"request_string\": \"abababa\", \"substring\": \"aba\", \"count\": 3}\n```\n\nTo persist the results:\n\n```bash\nsubstring-counter --string \"banana\" --substring \"ana\" --persist ./history.jsonl\n```\n\n### Programmatic API\n\n```python\nfrom substring_counter import count, CounterService, CountRequest\n\n# Simple function call\nresult_count = count(\"aaaa\", \"aa\")\nprint(f\"Count: {result_count}\") # Output: Count: 3\n\n# With persistence\nresult_count_persisted = count(\"banana\", \"ana\", persist=\"./my_counts.jsonl\")\nprint(f\"Persisted Count: {result_count_persisted}\") # Output: Persisted Count: 2\n\n# Using the service directly for more control\nservice = CounterService()\nrequest = CountRequest(request_string=\"applepie\", substring=\"pp\")\nresult = service.perform_count(request)\nprint(f\"Service result: {result.count}\") # Output: Service result: 1\n\n# Handle errors\nfrom substring_counter import ValidationError\ntry:\n    count(\"test\", \"\")\nexcept ValidationError as e:\n    print(f\"Error: {e.message}\")\n```\n```python\n# src/substring_counter/__init__.py\n\"\"\"\nPublic API for the substring_counter library.\n\nThis module provides a convenient `count` function and exports key classes\nfor more advanced programmatic use.\n\"\"\"\n\nfrom typing import Optional\n\nfrom .core import SubstringCounter\nfrom .dto import CountRequest, CountResult\nfrom .exceptions import PersistenceError, ValidationError\nfrom .repository import FileRepository\nfrom .service import CounterService\nfrom .validator import InputValidator\n\n# Initialize default components for the convenience function\n_default_substring_counter = SubstringCounter()\n_default_input_validator = InputValidator()\n_default_counter_service = CounterService(\n    counter=_default_substring_counter,\n    validator=_default_input_validator,\n    repo=None,  # No persistence by default\n)\n\n\ndef count(string: str, substring: str, persist: Optional[str] = None) -> int:\n    \"\"\"\n    Count overlapping occurrences of a substring in a string.\n\n    This is a convenience function for the most common use case.\n    For more control, use CounterService and its DTOs directly.\n    \"\"\"\n    # Create a new service instance with a repo if persistence is requested\n    service = _default_counter_service\n    if persist:\n        repo = FileRepository(path=persist)\n        service = CounterService(\n            counter=_default_substring_counter,\n            validator=_default_input_validator,\n            repo=repo,\n        )\n\n    request = CountRequest(request_string=string, substring=substring, persist_path=persist)\n    result = service.perform_count(request)\n    return result.count\n\n\n__all__ = [\n    \"count\",\n    \"CounterService\",\n    \"CountRequest\",\n    \"CountResult\",\n    \"ValidationError\",\n    \"PersistenceError\",\n    \"SubstringCounter\", # Expose core for advanced usage/testing if needed\n    \"InputValidator\",\n    \"FileRepository\",\n]\n```\n\n```python\n# src/substring_counter/core.py\nclass SubstringCounter:\n    \"\"\"\n    Core algorithm for counting overlapping occurrences of a substring.\n    \"\"\"\n    def count(self, string: str, substring: str) -> int:\n        \"\"\"\n        Return the number of (possibly overlapping) occurrences of a substring in a string.\n        Validation (e.g., non-empty substring) is expected to be handled upstream.\n        \"\"\"\n        if not substring:\n            return 0  # This case should be prevented by validation, but a safeguard for core.\n        \n        count = 0\n        i = 0\n        n, m = len(string), len(substring)\n        \n        while i + m <= n:\n            if string[i : i + m] == substring:\n                count += 1\n            i += 1\n            \n        return count\n\n```\n\n```python\n# src/substring_counter/service.py\nimport logging\nfrom typing import Optional\n\nfrom .core import SubstringCounter\nfrom .dto import CountRequest, CountResult\nfrom .exceptions import PersistenceError, ValidationError\nfrom .repository import FileRepository\nfrom .utils import now_iso_timestamp\nfrom .validator import InputValidator\n\nlogger = logging.getLogger(__name__)\n\n\nclass CounterService:\n    \"\"\"\n    Orchestrates input validation, core counting, and optional persistence.\n    \"\"\"\n    def __init__(\n        self,\n        counter: SubstringCounter,\n        validator: InputValidator,\n        repo: Optional[FileRepository] = None,\n    ) -> None:\n        \"\"\"\n        Initializes the CounterService with injected dependencies.\n        \"\"\"\n        self._counter = counter\n        self._validator = validator\n        self._repo = repo\n\n    def perform_count(self, request: CountRequest) -> CountResult:\n        \"\"\"\n        Validates the request, performs the count, and optionally persists the result.\n        \"\"\"\n        self.perform_validation(request)\n\n        cnt = self._counter.count(request.request_string, request.substring)\n        ts = now_iso_timestamp()\n        result = CountResult(request=request, count=cnt, timestamp=ts)\n\n        if self._repo is not None:\n            try:\n                self._repo.append_record(result)\n            except PersistenceError as e:\n                # Best-effort persistence: log and continue\n                logger.warning(f\"Failed to persist result: {e.message}\")\n        return result\n    \n    def perform_validation(self, request: CountRequest) -> None:\n        \"\"\"\n        Performs validation of the CountRequest using the injected validator.\n        \"\"\"\n        self._validator.validate_request(request)\n\n```\n\n```python\n# src/substring_counter/controller.py\nimport argparse\nimport json\nimport sys\nfrom typing import List, Optional\n\nfrom .dto import CountRequest\nfrom .exceptions import PersistenceError, ValidationError\nfrom .repository import FileRepository\nfrom .service import CounterService\nfrom .core import SubstringCounter\nfrom .validator import InputValidator\n\n\nclass CounterController:\n    \"\"\"\n    CLI/controller logic that uses CounterService and prints results.\n    Handles argument parsing, service invocation, and output formatting.\n    \"\"\"\n    def __init__(self, service: CounterService) -> None:\n        \"\"\"\n        Initializes the controller with a CounterService instance.\n        \"\"\"\n        self._service = service\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"\n        Parses CLI arguments, performs the count, and prints results to stdout as JSON.\n        Returns an exit code (0 for success, non-zero for errors).\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"substring-counter\",\n            description=\"Counts overlapping occurrences of a substring in a string.\",\n        )\n        parser.add_argument(\n            \"--string\", required=True, help=\"The main string to search within.\"\n        )\n        parser.add_argument(\n            \"--substring\", required=True, help=\"The substring to count occurrences of.\"\n        )\n        parser.add_argument(\n            \"--persist\",\n            type=str,\n            default=None,\n            help=\"Optional path to a JSONL file to append query results.\",\n        )\n\n        args = parser.parse_args(argv)\n\n        request = CountRequest(\n            request_string=args.string,\n            substring=args.substring,\n            persist_path=args.persist,\n        )\n\n        try:\n            # Re-configure service with repository if persist path is provided\n            # This allows the CLI to dynamically enable persistence without\n            # altering the _default_counter_service for programmatic use.\n            if args.persist and self._service._repo is None:\n                repo = FileRepository(path=args.persist)\n                self._service = CounterService(\n                    counter=self._service._counter,\n                    validator=self._service._validator,\n                    repo=repo,\n                )\n            elif not args.persist and self._service._repo is not None:\n                # If persist was enabled by default but not requested for this run,\n                # disable it by creating a new service instance without a repo.\n                self._service = CounterService(\n                    counter=self._service._counter,\n                    validator=self._service._validator,\n                    repo=None,\n                )\n\n            result = self._service.perform_count(request)\n            print(json.dumps(result.to_dict()))\n            return 0\n        except ValidationError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2  # Exit code for validation errors\n        except PersistenceError as e:\n            # Persistence errors are non-fatal for the count operation, but warn user\n            print(\n                f\"Warning: Persistence failed. {e.message}. Count returned successfully.\",\n                file=sys.stderr,\n            )\n            # Still return 0 as the count itself was successful\n            # (Could be 3 for strict persistence)\n            print(json.dumps(result.to_dict())) # Print result even on persistence failure\n            return 0\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1  # Generic error exit code\n\n```\n\n```python\n# src/substring_counter/dto.py\nfrom dataclasses import dataclass, asdict\nfrom typing import Any, Dict, Optional\n\n\n@dataclass(frozen=True)\nclass CountRequest:\n    \"\"\"\n    Data Transfer Object for a substring count request.\n    \"\"\"\n    request_string: str\n    substring: str\n    persist_path: Optional[str] = None\n\n\n@dataclass(frozen=True)\nclass CountResult:\n    \"\"\"\n    Data Transfer Object for the result of a substring count.\n    \"\"\"\n    request: CountRequest\n    count: int\n    timestamp: str\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"\n        Converts the CountResult object to a dictionary suitable for JSON serialization.\n        This flattens the nested CountRequest for simpler persistence.\n        \"\"\"\n        return {\n            \"timestamp\": self.timestamp,\n            \"request_string\": self.request.request_string,\n            \"substring\": self.request.substring,\n            \"count\": self.count,\n        }\n\n```\n\n```python\n# src/substring_counter/validator.py\nfrom .dto import CountRequest\nfrom .exceptions import ValidationError\n\n\nclass InputValidator:\n    \"\"\"\n    Handles validation logic for CountRequest objects.\n    \"\"\"\n    def validate_request(self, request: CountRequest) -> None:\n        \"\"\"\n        Validates the fields of a CountRequest.\n\n        Raises:\n            ValidationError: If any input is invalid (e.g., not a string, empty substring).\n        \"\"\"\n        if not isinstance(request.request_string, str):\n            raise ValidationError(\"Input 'string' must be a string.\")\n        \n        if not isinstance(request.substring, str):\n            raise ValidationError(\"Input 'substring' must be a string.\")\n            \n        if not request.substring:\n            raise ValidationError(\"Input 'substring' cannot be empty.\")\n\n```\n\n```python\n# src/substring_counter/repository.py\nimport logging\nimport os\n\nfrom .dto import CountResult\nfrom .exceptions import PersistenceError\nfrom .utils import to_json_line\n\nlogger = logging.getLogger(__name__)\n\n\nclass FileRepository:\n    \"\"\"\n    Append-only JSONL persistence for query records.\n    \"\"\"\n    DEFAULT_PATH = \"./substring_counter_history.jsonl\"\n\n    def __init__(self, path: str = DEFAULT_PATH) -> None:\n        \"\"\"\n        Initializes the FileRepository with the specified file path.\n        \"\"\"\n        self._path = path\n\n    def append_record(self, result: CountResult) -> None:\n        \"\"\"\n        Appends a CountResult record as a JSON line to the configured file.\n\n        Raises:\n            PersistenceError: If an I/O error occurs during writing.\n        \"\"\"\n        record = result.to_dict()\n        json_line = to_json_line(record) + os.linesep # Ensure newline for JSONL format\n\n        try:\n            with open(self._path, \"a\", encoding=\"utf-8\") as f:\n                f.write(json_line)\n        except OSError as e:\n            # Wrap OS errors in a custom PersistenceError for clearer handling upstream\n            raise PersistenceError(\n                f\"Failed to write record to persistence file '{self._path}': {e}\"\n            ) from e\n        except Exception as e:\n            # Catch any other unexpected errors during serialization/writing\n            raise PersistenceError(\n                f\"An unexpected error occurred during persistence: {e}\"\n            ) from e\n\n```\n\n```python\n# src/substring_counter/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input data.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n\nclass PersistenceError(Exception):\n    \"\"\"\n    Exception raised for errors during data persistence.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n```\n\n```python\n# src/substring_counter/utils.py\nimport datetime\nimport json\nfrom typing import Any\n\n\ndef now_iso_timestamp() -> str:\n    \"\"\"\n    Returns the current UTC time as an ISO-8601 formatted string.\n    \"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds') + 'Z'\n\n\ndef to_json_line(obj: Any) -> str:\n    \"\"\"\n    Converts an object to a compact JSON string suitable for JSONL files.\n    \"\"\"\n    return json.dumps(obj, ensure_ascii=False, separators=(\",\", \":\"))\n\n```\n\n```python\n# src/substring_counter/cli.py\nimport sys\nfrom typing import List, Optional\n\nfrom .controller import CounterController\nfrom .core import SubstringCounter\nfrom .repository import FileRepository\nfrom .service import CounterService\nfrom .validator import InputValidator\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the substring-counter CLI.\n    Initializes the necessary components and runs the controller.\n    \"\"\"\n    # Dependencies are instantiated here for the CLI entry point\n    # and passed to the controller.\n    substring_counter_impl = SubstringCounter()\n    input_validator_impl = InputValidator()\n    \n    # The FileRepository is initially None, and the controller will re-configure\n    # the service if a --persist path is provided by the CLI user.\n    file_repository_impl = None \n    \n    service = CounterService(\n        counter=substring_counter_impl,\n        validator=input_validator_impl,\n        repo=file_repository_impl,\n    )\n    \n    controller = CounterController(service=service)\n    \n    return controller.run(argv)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"From a supplied list of numbers, select and return two that are the closest to each other.\n    The numbers are returned in order (smaller number, larger number).\n    \"\"\"\n    sorted_nums = sorted(numbers)\n\n    # Initialize with the first pair\n    best_a, best_b = sorted_nums[0], sorted_nums[1]\n    min_diff = abs(best_b - best_a)\n\n    # Iterate through adjacent pairs to find the minimum difference\n    for i in range(1, len(sorted_nums)):\n        prev = sorted_nums[i - 1]\n        curr = sorted_nums[i]\n        current_diff = abs(curr - prev)\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            best_a, best_b = prev, curr\n\n    return (best_a, best_b)"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n\n# Mappings for number words to integers and vice-versa.\nWORD_TO_INT = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\n\nINT_TO_WORD = {\n    0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n    5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n}\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"\n    Sorts space-delimited English number words into ascending numeric order.\n    Assumes all input words are valid (zero through nine).\n    \"\"\"\n    normalized_input = numbers.strip().lower()\n\n    if not normalized_input:\n        return \"\"\n\n    words = normalized_input.split()\n    \n    # Convert words to their integer values, assuming valid words.\n    int_values = [WORD_TO_INT[word] for word in words]\n    \n    # Sort the integer values to achieve ascending numeric order.\n    int_values.sort()\n    \n    # Convert sorted integer values back to their word representations.\n    sorted_words = [INT_TO_WORD[val] for val in int_values]\n    \n    return \" \".join(sorted_words)"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers, select two closest and return them in order.\n    Assumes valid input: list of floats, length >= 2, no NaN/Inf.\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n    \n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0)\n\n    for i in range(len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i+1]\n        \n        current_diff = num2 - num1\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (num1, num2)\n            \n            if min_diff == 0.0:\n                break\n                \n    return closest_pair"}
{"task_id": "HumanEval/21", "solution": "```python\nfrom typing import List\n\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Applies a linear transformation to a list of numbers.\n    The smallest number in the input list becomes 0 and the largest becomes 1.\"\"\"\n\n    min_v = min(numbers)\n    max_v = max(numbers)\n    denom = max_v - min_v\n\n    if denom == 0.0:\n        # If all numbers are equal, map them all to 0.5 to prevent division by zero.\n        return [0.5] * len(numbers)\n    else:\n        return [(x - min_v) / denom for x in numbers]\n```"}
{"task_id": "HumanEval/21", "solution": "```python\nfrom typing import List\n\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given a list of numbers, linearly rescale them to the unit interval [0,1].\n    The minimum value maps to 0.0 and the maximum value maps to 1.0.\"\"\"\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    # Per critical requirements, assume valid inputs where max_val - min_val is not zero.\n    denom = max_val - min_val\n\n    rescaled_numbers = [(x - min_val) / denom for x in numbers]\n    return rescaled_numbers\n```"}
