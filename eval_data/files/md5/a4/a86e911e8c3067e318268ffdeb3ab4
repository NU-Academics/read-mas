monkeypatch):\n    mock_run = MagicMock(return_value=0)\n    with patch('intfilter.cli.CLIApp.run', mock_run):\n        cli_main([\"intfilter\", \"filter\", \"--input\", \"[1]\"])\n        mock_run.assert_called_once()\n        assert mock_run.call_args[0][0] == [\"intfilter\", \"filter\", \"--input\", \"[1]\"]\n\n# tests/test_api.py (Optional)\nimport pytest\nfrom unittest.mock import Mock, AsyncMock, patch\nfrom intfilter.api import ApiServer, FASTAPI_AVAILABLE\nfrom intfilter.controllers import IntegerFilterController\nfrom intfilter.services import FilterService\nfrom intfilter.exceptions import InvalidInputError, FilterError\n\n# Only run API tests if FastAPI is available\npytestmark = pytest.mark.skipif(not FASTAPI_AVAILABLE, reason=\"FastAPI not installed\")\n\n@pytest.fixture\ndef mock_controller():\n    mock_service = Mock(spec=FilterService)\n    mock_service.filter.return_value = [1, 2, 3]\n    mock_controller_obj = Mock(spec=IntegerFilterController)\n    mock_controller_obj.handle.return_value = [1, 2, 3]\n    return mock_controller_obj\n\n@pytest.fixture\ndef api_server(mock_controller):\n    return ApiServer(mock_controller)\n\n@pytest.fixture\ndef fastapi_app(api_server):\n    return api_server.create_app()\n\n@pytest.fixture\nasync def client(fastapi_app):\n    from httpx import AsyncClient\n    async with AsyncClient(app=fastapi_app, base_url=\"http://test\") as ac:\n        yield ac\n\n@pytest.mark.asyncio\nasync def test_post_filter_success(client, mock_controller):\n    response = await client.post(\"/filter\", json=[1, \"a\", 2, True, 3.0])\n    \n    assert response.status_code == 200\n    assert response.json() == [1, 2, 3]\n    mock_controller.handle.assert_called_once_with([1, \"a\", 2, True, 3.0])\n\n@pytest.mark.asyncio\nasync def test_post_filter_invalid_json(client):\n    response = await client.post(\"/filter\", content=\"this is not json\", headers={\"Content-Type\": \"application/json\"})\n    \n    assert response.status_code == 400\n    assert response.json() == {\"detail\": {\"error\": \"invalid_json\", \"message\": \"Request body must be valid JSON.\"}}\n\n@pytest.mark.asyncio\nasync def test_post_filter_non_array_json(client, mock_controller):\n    mock_controller.handle.side_effect = InvalidInputError(\"Request body must be a JSON array.\")\n    response = await client.post(\"/filter\", json={\"key\": \"value\"})\n    \n    assert response.status_code == 400\n    assert response.json() == {\"detail\": {\"error\": \"invalid_input\", \"message\": \"Request body must be a JSON array.\"}}\n\n@pytest.mark.asyncio\nasync def test_post_filter_controller_invalid_input_error(client, mock_controller):\n    mock_controller.handle.side_effect = InvalidInputError(\"Validation failed\")\n    response = await client.post(\"/filter\", json=[1, \"a\"])\n    \n    assert response.status_code == 400\n    assert response.json() == {\"detail\": {\"error\": \"invalid_input\", \"message\": \"Validation failed\"}}\n    mock_controller.handle.assert_called_once_with([1, \"a\"])\n\n@pytest.mark.asyncio\nasync def test_post_filter_controller_filter_error(client, mock_controller):\n    mock_controller.handle.side_effect = FilterError(\"Service issue\")\n    response = await client.post(\"/filter\", json=[1, 2])\n    \n    assert response.status_code == 500\n    assert response.json() == {\"detail\": {\"error\": \"filter_error\", \"message\": \"Service issue\"}}\n    mock_controller.handle.assert_called_once_with([1, 2])\n\n@pytest.mark.asyncio\nasync def test_post_filter_controller_generic_exception(client, mock_controller):\n    mock_controller.handle.side_effect = Exception(\"Unexpected error\")\n    response = await client.post(\"/filter\", json=[1, 2])\n    \n    assert response.status_code == 500\n    assert response.json() == {\"detail\": {\"error\": \"internal_server_error\", \"message\": \"Unexpected error\"}}\n    mock_controller.handle.assert_called_once_with([1, 2])\n\n# pyproject.toml\n\"\"\"\n[project]\nname = \"intfilter\"\nversion = \"0.1.0\"\ndescription = \"A Python library to filter lists for integer values.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\nlicense = \"MIT\"\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"filter\", \"integer\", \"list\", \"cli\", \"api\"]\nclassifiers = [\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.8\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"Operating System :: OS Independent\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n]\n\n[project.dependencies]\n# Core library dependencies (none beyond standard library for core functionality)\n\n[project.optional-dependencies]\nserver = [\n    \"fastapi>=0.100.0\",\n    \"uvicorn[standard]>=0.22.0\",\n]\ntest = [\n    \"pytest>=7.0\",\n    \"pytest-cov\",\n    \"httpx>=0.20.0\" # For API client testing\n]\n\n[project.scripts]\nintfilter = \"intfilter.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\"\"\"\n\n# requirements.txt\n\"\"\"\nfastapi>=0.100.0\nuvicorn[standard]>=0.22.0\n\"\"\"\n\n# README.md\n\"\"\"\n# IntFilter\n\nA Python library and command-line tool to filter lists of arbitrary Python values, returning only integer values.\n\n## Features\n\n- **Programmatic API**: A Python function `filter_integers` for direct use in your code.\n- **CLI Tool**: `intfilter` command to filter JSON arrays from stdin or file.\n- **Optional HTTP Adapter**: A simple FastAPI-based server to expose the filtering via a REST API endpoint.\n- **Persistence**: Optional support for loading/saving filtered lists to JSON files.\n\n## Installation\n\n```bash\npip install intfilter\n```\n\nTo enable the optional HTTP API server, install with the `server` extra:\n\n```bash\npip install \"intfilter[server]\"\n```\n\nFor development and running tests:\n\n```bash\npip install \"intfilter[test]\"\n```\n\n## Usage\n\n### Programmatic API\n\n```python\nfrom intfilter import filter_integers\n\nvalues = [1, \"hello\", 2.5, True, 3, None, 0, False]\nfiltered_ints = filter_integers(values)\nprint(filtered_ints)  # Output: [1, 3, 0]\n```\n\n### CLI Tool\n\nThe `intfilter` command provides a `filter` subcommand.\n\n**From standard input:**\n\n```bash\necho '[1, \"a\", 2, 3.14, True]' | intfilter filter\n# Output: [1, 2]\n```\n\n**Using the `--input` argument:**\n\n```bash\nintfilter filter --input='[10, \"b\", 20, False]'\n# Output: [10, 20]\n```\n\n**Saving filtered output to a file:**\n\n```bash\nintfilter filter --input='[1, \"x\", 2]' --save-to=output.json\n# Creates output.json with content [1, 2]\n```\n\n**Loading values from a file for filtering:**\n\n```bash\n# Assume input.json contains [100, \"y\", 200]\nintfilter filter --load-from=input.json\n# Output: [100, 200]\n```\n\n**Combining `--load-from` and `--input`:**\nValues from `--input` are appended to values loaded from `--load-from` before filtering.\n\n```bash\n# Assume data.json contains [1, \"a\"]\necho '[2, \"b\"]' | intfilter filter --load-from=data.json\n# Output: [1, 2]\n```\n\n### HTTP API Server (Optional)\n\nStart the server:\n\n```bash\nintfilter serve\n# Or specify host/port:\n# intfilter serve --host 0.0.0.0 --port 8080\n```\n\nThen, you can send POST requests to `/filter`:\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" \\\n     -d '[1, \"abc\", 2.0, True, 3]' \\\n     http://127.0.0.1:8000/filter\n# Response: [1, 3]\n```\n\n## Development and Testing\n\nTo run tests:\n\n```bash\npytest tests/\n```\n\n\"\"\"\n\n# tox.ini\n\"\"\"\n[tox]\nmin_version = 4.0\nenv_list = py38, py39, py310, py311, py312\nisolated_build = true\n\n[testenv]\npackage = skip\ndeps =\n    pytest\n    pytest-cov\n    httpx # For API client testing\n    fastapi # For API server tests\n    uvicorn[standard] # For API server tests\ncommands =\n    pytest --cov=intfilter --cov-report=term-missing {posargs:tests/}\n\n[gh-actions]\npython =\n    3.8: py38\n    3.9: py39\n    3.10: py310\n    3.11: py311\n    3.12: py312\n\"\"\"\n```"}
{"task_id": "HumanEval/24", "solution": "```python\nimport math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\"For a given number n, find the largest number that divides n evenly, smaller than n.\n    Returns 1 if n is prime.\n    \"\"\"\n    if n % 2 == 0:\n        return n // 2\n\n    max_div = 1\n    root = int(math.isqrt(n))\n    for i in range(3, root + 1, 2):\n        if n % i == 0:\n            pair = n // i\n            if pair < n and pair > max_div:\n                max_div = pair\n            if i < n and i > max_div:\n                max_div = i\n    return max_div\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors: List[int] = []\n\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    f = 3\n    while f * f <= n:\n        while n % f == 0:\n            factors.append(f)\n            n //= f\n        f += 2\n\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    return [num for num in numbers if counts[num] == 1]\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return list of prime factors of given integer from smallest to largest.\n    Each factor is listed according to its multiplicity, and their product equals n.\n    \"\"\"\n\n    # Helper function for integer square root, defined inline per requirements.\n    # This implementation uses Newton's method and assumes positive integer input.\n    def _isqrt(num: int) -> int:\n        x = num\n        y = (x + 1) // 2\n        while y < x:\n            x = y\n            y = (x + num // x) // 2\n        return x\n\n    # Per critical requirements, no input validation (n <= 0, n > max_n, non-int) is performed.\n    # The caller is trusted to provide a positive integer, as per the original problem statement.\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n\n    # Divide out factors of 2.\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Divide out odd factors starting from 3, using a trial division approach.\n    f = 3\n    limit = _isqrt(n) + 1 # Determine the upper bound for trial division.\n    while f <= limit and n > 1:\n        while n % f == 0:\n            factors.append(f)\n            n //= f\n            # Recalculate limit as n has decreased for efficiency.\n            limit = _isqrt(n) + 1\n        f += 2 # Move to the next odd number (3, 5, 7, ...).\n\n    # If n is still greater than 1, it means the remaining n is a prime factor itself.\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n            \n    return result"}
