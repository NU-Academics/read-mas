{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x using Horner's method.\n    Coefficients are ordered from c0 to cn for c0 + c1*x + ... + cn*x^n.\n    \"\"\"\n    result = 0.0\n    for coeff in reversed(xs):\n        result = result * x + coeff\n    return result\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero finds x such that poly(x) = 0 using bracketing and bisection.\n    It returns only one zero point, even if there are many.\n    \"\"\"\n    # Tolerances and constants for the root finding algorithm.\n    X_TOLERANCE = 1e-8\n    F_TOLERANCE = 1e-12\n    MAX_ITER = 1000\n    MAX_EXPAND = 50\n    EXPAND_FACTOR = 2.0\n    START_POINT = 0.0\n\n    def _get_sign(val: float) -> int:\n        \"\"\"Determines the sign of a float, treating values close to zero as zero.\"\"\"\n        if abs(val) < F_TOLERANCE:\n            return 0\n        return 1 if val > 0 else -1\n\n    # Check for an immediate root at the starting point.\n    f_start = poly(xs, START_POINT)\n    if _get_sign(f_start) == 0:\n        return START_POINT\n\n    # Bracketing phase: Expand symmetrically around START_POINT to find an interval [a, b]\n    # where the polynomial's sign changes, guaranteeing a root within.\n    a_bracket = START_POINT\n    b_bracket = START_POINT\n    found_bracket = False\n\n    for k in range(MAX_EXPAND + 1):\n        r = EXPAND_FACTOR ** k\n        x_neg = START_POINT - r\n        x_pos = START_POINT + r\n\n        f_neg = poly(xs, x_neg)\n        f_pos = poly(xs, x_pos)\n\n        # Check if either bracket edge is itself a root.\n        if _get_sign(f_neg) == 0:\n            return x_neg\n        if _get_sign(f_pos) == 0:\n            return x_pos\n\n        # If a sign change is detected between the expanded points, or between one and START_POINT, a bracket is found.\n        if _get_sign(f_neg) != _get_sign(f_pos):\n            a_bracket, b_bracket = x_neg, x_pos\n            found_bracket = True\n            break\n        elif _get_sign(f_neg) != _get_sign(f_start):\n            a_bracket, b_bracket = x_neg, START_POINT\n            found_bracket = True\n            break\n        elif _get_sign(f_pos) != _get_sign(f_start):\n            a_bracket, b_bracket = START_POINT, x_pos\n            found_bracket = True\n            break\n    \n    # If no bracket was found after max_expand, use the widest bounds explored.\n    # The problem statement guarantees a solution for the given inputs.\n    if not found_bracket:\n        a_bracket = START_POINT - (EXPAND_FACTOR ** MAX_EXPAND)\n        b_bracket = START_POINT + (EXPAND_FACTOR ** MAX_EXPAND)\n\n    # Ensure a < b for bisection algorithm.\n    a, b = min(a_bracket, b_bracket), max(a_bracket, b_bracket)\n\n    # Bisection phase: Repeatedly halve the interval until a root is found within tolerance.\n    for _ in range(MAX_ITER):\n        mid = (a + b) / 2.0\n        f_mid = poly(xs, mid)\n\n        # Check for convergence based on x-tolerance or f-tolerance.\n        if (b - a) / 2.0 < X_TOLERANCE or _get_sign(f_mid) == 0:\n            return mid\n\n        # Determine which half of the interval contains the root.\n        f_a = poly(xs, a) # Re-evaluate f(a) for robustness.\n        if _get_sign(f_mid) == _get_sign(f_a):\n            a = mid\n        else:\n            b = mid\n            \n    # If max_iter is reached without converging, return the midpoint of the final interval.\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/32", "solution": "import math\n\n_DEFAULT_TOLERANCE: float = 1e-10\n_DEFAULT_MAX_ITER: int = 100\n_BRACKET_SEARCH_MIN: float = -1e6\n_BRACKET_SEARCH_MAX: float = 1e6\n_BRACKET_SEARCH_STEPS: int = 1000\n\ndef _horner(coeffs: list[float], x: float) -> float:\n    \"\"\"Evaluates polynomial via Horner's method.\"\"\"\n    result = 0.0\n    for a in reversed(coeffs):\n        result = result * x + a\n    return result\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x using Horner's method.\n    Coefficients are ordered from degree 0 to n.\n    \"\"\"\n    return _horner(xs, x)\n\ndef _sign(x: float) -> int:\n    \"\"\"Returns -1, 0, or 1 indicating the sign of x.\"\"\"\n    if x > 0: return 1\n    if x < 0: return -1\n    return 0\n\ndef _find_bracket(coeffs: list[float], xmin: float, xmax: float, steps: int) -> tuple[float, float] | None:\n    \"\"\"\n    Searches for an interval [a, b] where the polynomial changes sign.\n    Returns the first such interval found, or None.\n    \"\"\"\n    if steps <= 0: return None\n    \n    step_size = (xmax - xmin) / steps\n    \n    prev_x = float(xmin)\n    prev_y = _horner(coeffs, prev_x)\n\n    for i in range(1, steps + 1):\n        curr_x = xmin + i * step_size\n        curr_y = _horner(coeffs, curr_x)\n\n        if _sign(prev_y) != _sign(curr_y):\n            return (prev_x, curr_x)\n        \n        prev_x = curr_x\n        prev_y = curr_y\n            \n    return None\n\ndef find_zero(xs: list):\n    \"\"\"\n    Finds one real root for a polynomial whose degree is odd (even number of coefficients).\n    Uses Brent's method after finding an initial bracketing interval.\n    \"\"\"\n    # Per critical requirements, explicit error handling is forbidden.\n    # We assume a valid bracket (a,b) will be found for the given odd-degree polynomial.\n    # If _find_bracket returns None, a TypeError will occur in tuple unpacking, implicitly handling the case.\n    a, b = _find_bracket(xs, _BRACKET_SEARCH_MIN, _BRACKET_SEARCH_MAX, _BRACKET_SEARCH_STEPS)\n\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    if abs(fa) < _DEFAULT_TOLERANCE: return a\n    if abs(fb) < _DEFAULT_TOLERANCE: return b\n\n    c = float(a)\n    fc = float(fa)\n    d = float(c)\n    e = float(c)\n\n    iter_count = 0\n    while iter_count < _DEFAULT_MAX_ITER:\n        if fb * fc > 0:\n            c = a\n            fc = fa\n            d = b\n            e = b\n        \n        if abs(fc) < abs(fb):\n            a, b, c = b, c, a\n            fa, fb, fc = fb, fc, fa\n\n        tol = _DEFAULT_TOLERANCE * abs(b) + _DEFAULT_TOLERANCE / 2\n        xm = (c - b) / 2.0\n\n        if abs(xm) <= tol or abs(fb) < _DEFAULT_TOLERANCE:\n            return b\n\n        if abs(e) >= tol and abs(fa) > abs(fb):\n            s = fb / fa\n            if a == c:\n                p = 2.0 * xm * s\n                q = 1.0 - s\n            else:\n                q = fa / fc\n                r = fb / fc\n                p = s * (2.0 * xm * q * (q - r) - (b - a) * (r - 1.0))\n                q = (q - 1.0) * (r - 1.0) * (s - 1.0)\n            \n            if p > 0:\n                q = -q\n            p = abs(p)\n\n            min1 = 3.0 * xm * q - abs(tol * q)\n            min2 = abs(e * q)\n            \n            if 2.0 * p < min(min1, min2):\n                e = d\n                d = p / q\n            else:\n                e = xm\n                d = xm\n        else:\n            e = xm\n            d = xm\n\n        a = b\n        fa = fb\n        \n        if abs(d) > tol:\n            b += d\n        else:\n            b -= _sign(xm) * tol\n        fb = poly(xs, b)\n\n        iter_count += 1\n    \n    # If max iterations reached, return the current best estimate.\n    # Per critical requirements, convergence is assumed for valid inputs.\n    return b"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function sorts elements at indices divisible by three, leaving others unchanged.\n    It returns a new list without modifying the input list.\n    \"\"\"\n    if not l:\n        return []\n\n    result_list = list(l)\n\n    third_elements = []\n    third_indices = []\n    for i in range(len(result_list)):\n        if i % 3 == 0:\n            third_elements.append(result_list[i])\n            third_indices.append(i)\n\n    third_elements.sort()\n\n    for i in range(len(third_indices)):\n        result_list[third_indices[i]] = third_elements[i]\n\n    return result_list"}
{"task_id": "HumanEval/33", "solution": "```python\ndef sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a new list where elements at indices divisible by three are sorted.\n    Other elements remain in their original positions, and the input list is not mutated.\n    \"\"\"\n    result = list(l) # Create a mutable copy of the input list.\n\n    # Collect values and their original indices for elements at positions divisible by three.\n    divisible_by_three_values = []\n    divisible_by_three_indices = []\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            divisible_by_three_values.append(item)\n            divisible_by_three_indices.append(i)\n\n    sorted_values = sorted(divisible_by_three_values) # Sort the collected values.\n\n    # Place the sorted values back into the result list at their original indices.\n    for i, index in enumerate(divisible_by_three_indices):\n        result[index] = sorted_values[i]\n\n    return result\n```"}
