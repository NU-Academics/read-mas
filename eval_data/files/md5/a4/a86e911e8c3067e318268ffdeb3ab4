{"task_id": "HumanEval/54", "solution": "```python\n# src/samechars/exceptions.py\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when an input string is invalid.\"\"\"\n    pass\n\nclass AuditWriteError(IOError):\n    \"\"\"Raised when there is an error writing to the audit log.\"\"\"\n    pass\n```\n\n```python\n# src/samechars/utils.py\nfrom typing import Any\nfrom .exceptions import InvalidInputError\n\ndef validate_string(s: Any) -> None:\n    \"\"\"Validates that the input is a string.\"\"\"\n    if not isinstance(s, str):\n        raise InvalidInputError(\"Input must be a string.\")\n\ndef normalize(s: str, lowercase: bool = False, strip: bool = False) -> str:\n    \"\"\"Applies optional normalization to a string.\"\"\"\n    if strip:\n        s = s.strip()\n    if lowercase:\n        s = s.lower()\n    return s\n```\n\n```python\n# src/samechars/comparator.py\nclass CharSetComparator:\n    \"\"\"Provides pure domain logic for character set comparison.\"\"\"\n    def compare(self, left: str, right: str) -> bool:\n        \"\"\"Returns True if the unique characters of both strings are identical.\"\"\"\n        return set(left) == set(right)\n\n    def diff(self, left: str, right: str) -> tuple[set[str], set[str]]:\n        \"\"\"Returns sets of characters unique to left and unique to right.\"\"\"\n        ls, rs = set(left), set(right)\n        return (ls - rs, rs - ls)\n```\n\n```python\n# src/samechars/models.py\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass(frozen=True)\nclass CharSetComparisonResult:\n    \"\"\"Data transfer object for character set comparison results.\"\"\"\n    left: str\n    right: str\n    equal: bool\n    left_only: List[str]\n    right_only: List[str]\n    timestamp: str\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result object to a dictionary for serialization.\"\"\"\n        return {\n            \"left\": self.left,\n            \"right\": self.right,\n            \"equal\": self.equal,\n            \"left_only\": self.left_only,\n            \"right_only\": self.right_only,\n            \"timestamp\": self.timestamp,\n        }\n```\n\n```python\n# src/samechars/repository.py\nimport os\nimport json\nfrom typing import Iterator\nfrom .exceptions import AuditWriteError\n\nDEFAULT_AUDIT_PATH = \"./data/audit.log\"\n\nclass AuditRepository:\n    \"\"\"Manages appending and reading audit entries in a JSON-lines file.\"\"\"\n    def __init__(self, path: str = DEFAULT_AUDIT_PATH):\n        self._path = path\n        os.makedirs(os.path.dirname(self._path), mode=0o750, exist_ok=True)\n\n    def append(self, entry: dict) -> None:\n        \"\"\"Appends a dictionary entry as a JSON line to the audit file.\"\"\"\n        try:\n            with open(self._path, 'a', encoding='utf-8') as f:\n                f.write(json.dumps(entry) + '\\n')\n        except OSError as e:\n            raise AuditWriteError(f\"Failed to write to audit log: {e}\") from e\n\n    def read_all(self) -> Iterator[dict]:\n        \"\"\"Yields parsed JSON objects from each line of the audit file.\"\"\"\n        if not os.path.exists(self._path):\n            return\n        with open(self._path, 'r', encoding='utf-8') as f:\n            for line in f:\n                stripped_line = line.strip()\n                if stripped_line:\n                    yield json.loads(stripped_line)\n```\n\n```python\n# src/samechars/service.py\nfrom datetime import datetime\nfrom typing import Optional\n\nfrom .comparator import CharSetComparator\nfrom .repository import AuditRepository\nfrom .models import CharSetComparisonResult\nfrom .utils import validate_string\n\nclass CharSetService:\n    \"\"\"Orchestrates character set comparison, validation, and audit logging.\"\"\"\n    def __init__(self, comparator: CharSetComparator, repo: AuditRepository):\n        self._comparator = comparator\n        self._repo = repo\n\n    def same_chars(self, left: str, right: str, meta: Optional[dict] = None) -> CharSetComparisonResult:\n        \"\"\"Compares character sets of two strings, logs the operation, and returns a detailed result.\"\"\"\n        validate_string(left)\n        validate_string(right)\n\n        equal = self._comparator.compare(left, right)\n        left_only, right_only = self._comparator.diff(left, right)\n        timestamp = datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n\n        result = CharSetComparisonResult(\n            left=left,\n            right=right,\n            equal=equal,\n            left_only=sorted(list(left_only)),\n            right_only=sorted(list(right_only)),\n            timestamp=timestamp\n        )\n        \n        audit_entry = result.to_dict()\n        if meta:\n            audit_entry[\"meta\"] = meta\n        \n        self._repo.append(audit_entry)\n        return result\n\n    def same_chars_bool(self, left: str, right: str, meta: Optional[dict] = None) -> bool:\n        \"\"\"A convenience method returning only the boolean comparison result.\"\"\"\n        return self.same_chars(left, right, meta).equal\n```\n\n```python\n# src/samechars/controller.py\nimport sys\nimport json\nimport argparse\nfrom typing import List, Optional\n\nfrom .service import CharSetService\nfrom .models import CharSetComparisonResult\nfrom .exceptions import InvalidInputError, AuditWriteError\n\n# CLI exit codes as per FR3.\nCLI_SUCCESS_CODE = 0\nCLI_DIFFER_CODE = 1\nCLI_ERROR_CODE = 2\n\nclass CLIController:\n    \"\"\"Handles command-line interface parsing, execution, and output.\"\"\"\n    def __init__(self, service: CharSetService):\n        self._service = service\n\n    def _format_result(self, result: CharSetComparisonResult) -> str:\n        \"\"\"Formats the comparison result into a JSON string for CLI output.\"\"\"\n        return json.dumps(result.to_dict(), indent=2)\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Parses arguments and performs the character set comparison via the service.\"\"\"\n        args_list = argv[1:] if argv else sys.argv[1:]\n        \n        s0, s1 = None, None\n        \n        parser = argparse.ArgumentParser(\n            prog=\"samechars\",\n            description=\"Compares character sets of two strings. Usage: samechars [compare] <string0> <string1>\",\n            add_help=True\n        )\n\n        if not args_list:\n            parser.print_help(sys.stderr)\n            return CLI_ERROR_CODE\n\n        if args_list[0] == \"compare\":\n            if len(args_list) != 3:\n                print(\"Error: 'compare' command requires two strings.\", file=sys.stderr)\n                parser.print_help(sys.stderr)\n                return CLI_ERROR_CODE\n            s0 = args_list[1]\n            s1 = args_list[2]\n        elif len(args_list) == 2:\n            s0 = args_list[0]\n            s1 = args_list[1]\n        else:\n            print(\"Error: Invalid number of arguments.\", file=sys.stderr)\n            parser.print_help(sys.stderr)\n            return CLI_ERROR_CODE\n\n        try:\n            result = self._service.same_chars(s0, s1, meta={\"source\": \"cli\"}) # type: ignore (s0, s1 ensured to be str by parsing logic)\n            print(self._format_result(result))\n            return CLI_SUCCESS_CODE if result.equal else CLI_DIFFER_CODE\n        except InvalidInputError as e:\n            print(json.dumps({\"error\": str(e), \"status_code\": 400}), file=sys.stderr)\n            return CLI_ERROR_CODE\n        except AuditWriteError as e:\n            print(json.dumps({\"error\": f\"Audit log error: {e}\", \"status_code\": 500}), file=sys.stderr)\n            return CLI_ERROR_CODE\n        except Exception as e:\n            print(json.dumps({\"error\": f\"An unexpected error occurred: {type(e).__name__}: {e}\", \"status_code\": 500}), file=sys.stderr)\n            return CLI_ERROR_CODE\n```\n\n```python\n# src/samechars/api.py\nfrom fastapi import FastAPI, HTTPException, status\nfrom pydantic import BaseModel\nfrom typing import Dict, Any\n\nfrom .service import CharSetService\nfrom .exceptions import InvalidInputError, AuditWriteError\n\nclass CompareRequest(BaseModel):\n    \"\"\"Pydantic model for the /compare request body.\"\"\"\n    s0: str\n    s1: str\n\ndef create_app(service: CharSetService) -> FastAPI:\n    \"\"\"Factory function to create and configure the FastAPI application.\"\"\"\n    app = FastAPI(\n        title=\"CharSet Comparator API\",\n        description=\"API to compare character sets of two strings.\",\n        version=\"0.1.0\",\n    )\n    \n    @app.post(\"/compare\", response_model=Dict[str, Any], status_code=status.HTTP_200_OK)\n    async def _post_compare(request: CompareRequest):\n        \"\"\"Endpoint to compare two strings' character sets.\"\"\"\n        try:\n            result = service.same_chars(request.s0, request.s1, meta={\"source\": \"api\"})\n            return {\n                \"equal\": result.equal,\n                \"left_only\": result.left_only,\n                \"right_only\": result.right_only,\n                \"timestamp\": result.timestamp\n            }\n        except InvalidInputError as e:\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                detail=str(e)\n            ) from e\n        except AuditWriteError as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail=f\"Audit log error: {e}\"\n            ) from e\n        except Exception as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail=f\"An unexpected error occurred: {type(e).__name__}: {e}\"\n            ) from e\n    \n    return app\n```\n\n```python\n# src/samechars/__main__.py\nimport sys\nimport os\n\nfrom .comparator import CharSetComparator\nfrom .repository import AuditRepository\nfrom .service import CharSetService\nfrom .controller import CLIController\n\ndef main(argv=None):\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    audit_path = os.environ.get(\"SAMECHARS_AUDIT_PATH\", AuditRepository.DEFAULT_AUDIT_PATH)\n\n    comparator = CharSetComparator()\n    repo = AuditRepository(path=audit_path)\n    service = CharSetService(comparator=comparator, repo=repo)\n    controller = CLIController(service=service)\n\n    return controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# src/samechars/__init__.py\nfrom .comparator import CharSetComparator\nfrom .repository import AuditRepository\nfrom .service import CharSetService\nfrom .exceptions import InvalidInputError, AuditWriteError\nfrom .models import CharSetComparisonResult\nfrom typing import Optional\n\n# Initialize default components for the library function\n_default_comparator = CharSetComparator()\n_default_audit_repo = AuditRepository()\n_default_service = CharSetService(comparator=_default_comparator, repo=_default_audit_repo)\n\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return _default_service.same_chars_bool(s0, s1, meta={\"source\": \"library\"})\n\n# Convenience exports for direct access to core components\n__all__ = [\n    \"same_chars\",\n    \"CharSetComparator\",\n    \"CharSetService\",\n    \"AuditRepository\",\n    \"InvalidInputError\",\n    \"AuditWriteError\",\n    \"CharSetComparisonResult\",\n]\n```\n\n```toml\n# pyproject.toml\n[project]\nname = \"samechars\"\nversion = \"0.1.0\"\ndescription = \"A reliable, reusable library to determine whether two strings/words contain the same set of characters.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\ndependencies = [] # Core library uses standard library only\n\n[project.optional-dependencies]\napi = [\"fastapi~=0.111.0\", \"uvicorn[standard]~=0.30.1\", \"pydantic~=2.7.1\"]\n\n[project.scripts]\nsamechars = \"samechars.__main__:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n\n```markdown\n# README.md\n# samechars\n\nA Python library and service to determine if two strings contain the same set of characters.\n\n## 1. Library Usage\n\nThe core functionality is available as a Python function:\n\n```python\nfrom samechars import same_chars\n\n# Examples from doctests\nprint(same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')) # Expected: True\nprint(same_chars('abcd', 'dddddddabc'))             # Expected: True\nprint(same_chars('dddddddabc', 'abcd'))             # Expected: True\nprint(same_chars('eabcd', 'dddddddabc'))             # Expected: False\nprint(same_chars('abcd', 'dddddddabce'))             # Expected: False\nprint(same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')) # Expected: False\n```\n\n## 2. CLI Usage\n\nA command-line interface is provided for quick checks.\n\nInstall the package (with optional API dependencies):\n```bash\npip install \".[api]\"\n```\n\nThen run:\n```bash\nsamechars \"eabcdzzzz\" \"dddzzzzzzzddeddabc\"\n# Or using the explicit 'compare' command:\nsamechars compare \"eabcdzzzz\" \"dddzzzzzzzddeddabc\"\n```\n\nExpected JSON output (formatted for readability):\n```json\n{\n  \"left\": \"eabcdzzzz\",\n  \"right\": \"dddzzzzzzzddeddabc\",\n  \"equal\": true,\n  \"left_only\": [],\n  \"right_only\": [],\n  \"timestamp\": \"2026-04-13T14:23:55Z\"\n}\n```\n\nExit codes:\n- `0`: Strings have the same character set.\n- `1`: Strings do not have the same character set.\n- `2`: An error occurred (e.g., invalid input, audit log write failure).\n\n## 3. HTTP API Usage\n\nAn optional HTTP API endpoint is available using FastAPI.\n\nFirst, install the package with API dependencies:\n```bash\npip install \".[api]\"\n```\n\nThen run the API server (from the project root, or where `src` is located):\n```bash\nuvicorn samechars.api:create_app --factory --host 0.0.0.0 --port 8000\n```\n\nOnce the server is running, you can send POST requests:\n\n```bash\ncurl -X POST \"http://localhost:8000/compare\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{ \"s0\": \"eabcdzzzz\", \"s1\": \"dddzzzzzzzddeddabc\" }'\n```\n\nExpected JSON response:\n```json\n{\n  \"equal\": true,\n  \"left_only\": [],\n  \"right_only\": [],\n  \"timestamp\": \"2026-04-13T14:23:55Z\"\n}\n```\n\nError responses (e.g., for invalid input):\n```json\n{\n  \"detail\": \"Input must be a string.\"\n}\n```\n\n## 4. Audit Log\n\nAll comparisons performed via the library, CLI, or API are logged to `data/audit.log` by default (configurable via `SAMECHARS_AUDIT_PATH` environment variable).\nThe log is an append-only JSON-lines file.\n\nExample log entry:\n```json\n{\"left\": \"eabcdzzzz\", \"right\": \"dddzzzzzzzddeddabc\", \"equal\": true, \"left_only\": [], \"right_only\": [], \"timestamp\": \"2026-04-13T14:23:55Z\", \"meta\": {\"source\": \"cli\"}}\n```\n```"}
{"task_id": "HumanEval/55", "solution": "```python\n# pyproject.toml\n[project]\nname = \"fib-app\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI for computing Fibonacci numbers.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\ndependencies = []\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\n\n[project.optional-dependencies]\nflask = [\"Flask>=2.0.0\"]\n\n[project.scripts]\nfib-cli = \"cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n```python\n# README.md\n# Fibonacci Application\n\nThis project provides a Python library, CLI, and optional HTTP API to compute the n-th Fibonacci number using various strategies and supporting caching.\n\n## Features\n- Multiple computation strategies: iterative, memoized recursive, matrix exponentiation.\n- In-memory and optional SQLite persistent caching.\n- Command-line interface (CLI) for easy use.\n- Optional HTTP GET endpoint for integration.\n\n## Installation\n```bash\n# Install the base package\npip install .\n\n# For HTTP API support, install with Flask extra\npip install \".[flask]\"\n```\n\n## Usage\n\n### Library\n```python\nfrom fib_app import fib\n\nprint(fib(10))  # Output: 55\n```\n\n### CLI\n```bash\nfib-cli --n 10 --strategy iterative\nfib-cli --n 1000 --strategy matrix --persist-cache fibonacci_cache.db\n```\n\n### HTTP API (requires Flask extra)\n```bash\n# Start the Flask app\npython -m fib_app.controllers --run-api\n```\nThen access: `http://127.0.0.1:5000/fib?n=10`\n\n## Project Structure\nDetailed in `docs/design_specification.md` (conceptually, not a real file).\n\n## Development\nSee `pyproject.toml` for dependencies. Run `pytest` for tests.\n```\n```python\n# src/fib_app/__init__.py\n\"\"\"Public package API for Fibonacci computation.\"\"\"\n\nimport os\nfrom .services import FibonacciService\nfrom .repository import CacheRepository\nfrom .strategies import IterativeStrategy, RecursiveMemoStrategy, MatrixStrategy\nfrom .config import Config\n\n# Initialize default components for the top-level fib() function.\n# These instances are used when the library is imported directly.\n_default_repo_path = os.getenv(\"FIB_APP_CACHE_DB_PATH\")\n_default_repo = CacheRepository(db_path=_default_repo_path)\n_default_strategies = {\n    \"iterative\": IterativeStrategy(),\n    \"recursive_memo\": RecursiveMemoStrategy(),\n    \"matrix\": MatrixStrategy(),\n}\n# 'auto' is a strategy selection hint, not a concrete strategy instance.\n_default_service = FibonacciService(_default_repo, _default_strategies, default_strategy=Config.default_strategy)\n\ndef fib(n: int) -> int:\n    \"\"\"\n    Computes the n-th Fibonacci number using the default service configuration.\n    Delegates to FibonacciService.fib with default 'auto' strategy selection.\n    \"\"\"\n    return _default_service.fib(n).value\n\n# Optional: Add cleanup for the default repository on exit\nimport atexit\natexit.register(_default_repo.close)\n```\n```python\n# src/fib_app/models.py\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass FibonacciResult:\n    \"\"\"\n    Data transfer object for Fibonacci computation results.\n    Contains the input n, computed value, strategy used, and cache status.\n    \"\"\"\n    n: int\n    value: int\n    strategy: str\n    cached: bool\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a serializable dictionary representation of the result.\"\"\"\n        return {\n            \"n\": self.n,\n            \"value\": str(self.value), # Convert large integers to string for JSON\n            \"strategy\": self.strategy,\n            \"cached\": self.cached,\n        }\n```\n```python\n# src/fib_app/exceptions.py\nclass FibonacciError(Exception):\n    \"\"\"Base exception for Fibonacci application errors.\"\"\"\n    pass\n\nclass ValidationError(FibonacciError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n```\n```python\n# src/fib_app/utils.py\nfrom .exceptions import ValidationError\n\ndef validate_non_negative_int(n: int) -> None:\n    \"\"\"\n    Validates if n is a non-negative integer.\n    Raises ValidationError if n is not an integer or is less than 0.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValidationError(f\"Input 'n' must be a non-negative integer, got {n}.\")\n\ndef choose_strategy(n: int, preferred: str | None = None) -> str:\n    \"\"\"\n    Selects a computation strategy based on input n and preferred strategy.\n    Implements a heuristic for 'auto' strategy selection.\n    \"\"\"\n    allowed_strategies = {'iterative', 'recursive_memo', 'matrix', 'auto'}\n    if preferred and preferred in allowed_strategies and preferred != 'auto':\n        return preferred\n\n    # Heuristic for 'auto' strategy\n    if n <= 100:\n        return 'iterative'\n    elif n <= 10000:\n        return 'recursive_memo' # Memoized recursion is fine for medium range\n    else:\n        return 'matrix' # Matrix exponentiation for large numbers\n```\n```python\n# src/fib_app/repository.py\nimport sqlite3\nfrom typing import Optional\nfrom .exceptions import FibonacciError\n\nclass CacheRepository:\n    \"\"\"\n    Provides caching for Fibonacci numbers, using in-memory dict and optional SQLite persistence.\n    Values are stored as strings in SQLite to handle arbitrarily large integers.\n    \"\"\"\n    def __init__(self, db_path: Optional[str] = None) -> None:\n        self._mem: dict[int, int] = {}\n        self._db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n        if self._db_path:\n            self._init_db()\n\n    def _init_db(self) -> None:\n        \"\"\"Initializes the SQLite database connection and creates the cache table if it doesn't exist.\"\"\"\n        try:\n            self._conn = sqlite3.connect(self._db_path)\n            self._conn.execute(\"CREATE TABLE IF NOT EXISTS cache (n INTEGER PRIMARY KEY, value TEXT NOT NULL)\")\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise FibonacciError(f\"Failed to initialize SQLite cache database at {self._db_path}: {e}\") from e\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Fibonacci number from cache. Checks in-memory first, then SQLite if persistent.\"\"\"\n        if n in self._mem:\n            return self._mem[n]\n\n        if self._conn:\n            try:\n                cur = self._conn.execute(\"SELECT value FROM cache WHERE n=?\", (n,))\n                row = cur.fetchone()\n                if row:\n                    val = self._deserialize(row[0])\n                    self._mem[n] = val  # Populate in-memory cache from DB\n                    return val\n            except sqlite3.Error as e:\n                # Log error but don't prevent in-memory cache from being used\n                print(f\"Warning: Failed to retrieve from SQLite cache: {e}\")\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Fibonacci number in the cache. Updates in-memory and optionally SQLite.\"\"\"\n        self._mem[n] = value\n        if self._conn:\n            try:\n                self._conn.execute(\n                    \"INSERT OR REPLACE INTO cache (n, value) VALUES (?, ?)\",\n                    (n, self._serialize(value)),\n                )\n                self._conn.commit()\n            except sqlite3.Error as e:\n                # Log error but don't prevent in-memory cache from being used\n                print(f\"Warning: Failed to store to SQLite cache: {e}\")\n\n    def close(self) -> None:\n        \"\"\"Closes the SQLite database connection if it is open.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n\n    def _serialize(self, value: int) -> str:\n        \"\"\"Converts an integer to its string representation for storage.\"\"\"\n        return str(value)\n\n    def _deserialize(self, s: str) -> int:\n        \"\"\"Converts a string representation back to an integer.\"\"\"\n        return int(s)\n```\n```python\n# src/fib_app/strategies.py\nimport abc\nfrom functools import lru_cache\n\nclass ComputeStrategy(abc.ABC):\n    \"\"\"Abstract base class for Fibonacci computation strategies.\"\"\"\n    @abc.abstractmethod\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number.\"\"\"\n        pass\n\nclass IterativeStrategy(ComputeStrategy):\n    \"\"\"\n    Computes the n-th Fibonacci number using an iterative approach.\n    This method has O(n) time complexity and O(1) space complexity.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 0\n        a, b = 0, 1\n        for _ in range(1, n):\n            a, b = b, a + b\n        return b\n\nclass RecursiveMemoStrategy(ComputeStrategy):\n    \"\"\"\n    Computes the n-th Fibonacci number using a recursive approach with memoization.\n    This strategy is O(n) time complexity due to memoization and O(n) space complexity.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        # Using a local cache for each compute call to avoid shared state.\n        # functools.lru_cache is perfect for this.\n        @lru_cache(maxsize=None)\n        def _fib_recursive(k: int) -> int:\n            if k == 0:\n                return 0\n            if k == 1:\n                return 1\n            return _fib_recursive(k - 1) + _fib_recursive(k - 2)\n        \n        return _fib_recursive(n)\n\nclass MatrixStrategy(ComputeStrategy):\n    \"\"\"\n    Computes the n-th Fibonacci number using matrix exponentiation.\n    This method has O(log n) time complexity and O(1) space complexity.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        # Base matrix [[1, 1], [1, 0]]\n        # F(n) = [ [1,1]^n ]_0,1\n        result_matrix = self._matrix_pow(((1, 1), (1, 0)), n - 1)\n        return result_matrix[0][0] # F(n) is the top-left element after n-1 powers\n\n    def _matrix_multiply(self, A: tuple[tuple[int, int], tuple[int, int]], B: tuple[tuple[int, int], tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:\n        \"\"\"Multiplies two 2x2 matrices.\"\"\"\n        a, b = A[0][0], A[0][1]\n        c, d = A[1][0], A[1][1]\n\n        e, f = B[0][0], B[0][1]\n        g, h = B[1][0], B[1][1]\n\n        return (\n            (a * e + b * g, a * f + b * h),\n            (c * e + d * g, c * f + d * h)\n        )\n\n    def _matrix_pow(self, mat: tuple[tuple[int, int], tuple[int, int]], p: int) -> tuple[tuple[int, int], tuple[int, int]]:\n        \"\"\"Computes mat raised to the power p using binary exponentiation.\"\"\"\n        result = ((1, 0), (0, 1)) # Identity matrix\n        base = mat\n\n        while p > 0:\n            if p % 2 == 1:\n                result = self._matrix_multiply(result, base)\n            base = self._matrix_multiply(base, base)\n            p //= 2\n        return result\n```\n```python\n# src/fib_app/services.py\nfrom typing import Dict, Optional\nfrom .repository import CacheRepository\nfrom .strategies import ComputeStrategy\nfrom .models import FibonacciResult\nfrom .utils import validate_non_negative_int, choose_strategy\nfrom .exceptions import FibonacciError\n\nclass FibonacciService:\n    \"\"\"\n    Orchestrates Fibonacci number computation: validates input, consults cache,\n    selects a strategy, computes the value, and stores it in the cache.\n    \"\"\"\n    def __init__(self, repo: CacheRepository, strategies: Dict[str, ComputeStrategy], default_strategy: str = 'auto') -> None:\n        self._repo = repo\n        self._strategies = strategies\n        self._default_strategy = default_strategy\n        \n        # Ensure 'auto' is not present as a concrete strategy instance\n        if 'auto' in self._strategies:\n            raise ValueError(\"Strategy 'auto' cannot be a concrete strategy instance.\")\n\n    def fib(self, n: int, strategy: Optional[str] = None) -> FibonacciResult:\n        \"\"\"\n        Computes the n-th Fibonacci number.\n        Validates input, checks cache, computes if not found, and updates cache.\n        \"\"\"\n        validate_non_negative_int(n)\n\n        selected_strategy_name = self._select_strategy(n, strategy)\n        if selected_strategy_name not in self._strategies:\n            raise FibonacciError(f\"Unknown strategy '{selected_strategy_name}' selected for n={n}.\")\n\n        cached_value = self._repo.get(n)\n        if cached_value is not None:\n            return FibonacciResult(n=n, value=cached_value, strategy=selected_strategy_name, cached=True)\n        \n        # Compute if not in cache\n        computed_value = self._strategies[selected_strategy_name].compute(n)\n        self._repo.set(n, computed_value)\n        \n        return FibonacciResult(n=n, value=computed_value, strategy=selected_strategy_name, cached=False)\n\n    def _select_strategy(self, n: int, strategy_hint: Optional[str]) -> str:\n        \"\"\"Determines the actual computation strategy to use based on hint and internal heuristics.\"\"\"\n        # Use utils.choose_strategy for the actual logic.\n        return choose_strategy(n, strategy_hint if strategy_hint is not None else self._default_strategy)\n```\n```python\n# src/fib_app/controllers.py\nimport argparse\nimport json\nimport sys\nimport os\nfrom typing import Optional, List, Type\nfrom .services import FibonacciService\nfrom .repository import CacheRepository\nfrom .strategies import IterativeStrategy, RecursiveMemoStrategy, MatrixStrategy\nfrom .exceptions import ValidationError, FibonacciError\nfrom .config import Config\n\ntry:\n    from flask import Flask, request, jsonify\nexcept ImportError:\n    Flask = None  # type: ignore\n    request = None # type: ignore\n    jsonify = None # type: ignore\n    print(\"Warning: Flask not installed. HTTP API will not be available.\", file=sys.stderr)\n\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface interactions for computing Fibonacci numbers.\n    Parses arguments, invokes the FibonacciService, and prints results as JSON.\n    \"\"\"\n    def __init__(self, service: FibonacciService) -> None:\n        self._service = service\n        self._parser = self._create_parser()\n\n    def _create_parser(self) -> argparse.ArgumentParser:\n        \"\"\"Creates and configures the argument parser for the CLI.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute the n-th Fibonacci number using various strategies and caching.\"\n        )\n        parser.add_argument(\n            \"--n\", type=int, required=True, help=\"The non-negative integer index for the Fibonacci number.\"\n        )\n        parser.add_argument(\n            \"--strategy\",\n            choices=[\"auto\", \"iterative\", \"recursive_memo\", \"matrix\"],\n            default=Config.default_strategy,\n            help=\"Computation strategy to use (default: auto).\",\n        )\n        parser.add_argument(\n            \"--persist-cache\",\n            type=str,\n            default=os.getenv(\"FIB_APP_CACHE_DB_PATH\", Config.cache_db_path),\n            help=f\"Path to SQLite database file for persistent cache (default: {Config.cache_db_path or 'in-memory only'}).\",\n        )\n        return parser\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI logic based on provided arguments.\n        Returns an exit code (0 for success, non-zero for error).\n        \"\"\"\n        try:\n            args = self._parser.parse_args(argv)\n\n            # Note: The CacheRepository and FibonacciService are typically instantiated\n            # in the cli.py entrypoint, but the CLIController needs to know if cache\n            # persistence was requested to pass it on if re-instantiation happens (e.g., tests).\n            # For simp