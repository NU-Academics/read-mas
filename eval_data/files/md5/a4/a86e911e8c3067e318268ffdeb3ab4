{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    current_max = l[0]\n    for element in l[1:]:\n        if element > current_max:\n            current_max = element\n    return current_max"}
{"task_id": "HumanEval/35", "solution": "To implement the software design specification, I will generate the code for each file as described in the \"3. File Structure\" and \"6. Detailed Class and Interface Designs\" sections.\n\n```python\n# src/maxpkg/__init__.py\n\"\"\"\nPackage init: exposes convenient facades for programmatic use.\n\"\"\"\nfrom .MaxController import MaxController\nfrom .APIApp import APIApp\nfrom .CLI import CLI\nfrom .Models import MaxResult, ListInput\nfrom .Exceptions import ValidationError, EmptyListError\nfrom .MaxElementService import MaxElementService\nfrom .ListValidator import ListValidator\nfrom .HistoryRepository import HistoryRepository\nfrom .utils import parse_cli_values, safe_write_jsonl\n\n# Create a default controller instance for easy library access\ndefault_controller = MaxController()\n\ndef get_max_element(values: list):\n    \"\"\"\n    Convenience function to compute the maximum element using the default MaxController.\n    This serves as the primary library entrypoint for simple use cases.\n    \"\"\"\n    return default_controller.get_max(values)\n\ndef create_app():\n    \"\"\"\n    Convenience function to create the FastAPI application.\n    \"\"\"\n    return APIApp().create_app()\n```\n\n```python\n# src/maxpkg/Models.py\nfrom typing import List, Union\nfrom datetime import datetime\n\nNumber = Union[int, float]\n\nclass ListInput:\n    \"\"\"DTO for list input, primarily for type hinting and potential future expansion.\"\"\"\n    def __init__(self, values: List[Number]):\n        self.values = values\n\n    @classmethod\n    def from_list(cls, values: list) -> \"ListInput\":\n        \"\"\"Factory method to create ListInput from a raw list.\"\"\"\n        # This design assumes validation happens elsewhere.\n        # Here we just ensure types for the DTO if needed later.\n        processed_values: List[Number] = []\n        for v in values:\n            if isinstance(v, (int, float)):\n                processed_values.append(v)\n            else:\n                # This should ideally be caught by ListValidator\n                raise TypeError(f\"Non-numeric value found: {v}\")\n        return cls(processed_values)\n\nclass MaxResult:\n    \"\"\"DTO for the maximum computation result, including metadata.\"\"\"\n    def __init__(self, max_value: Number, timestamp: str):\n        self.max_value = max_value\n        self.timestamp = timestamp\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the MaxResult object to a serializable dictionary.\"\"\"\n        return {\n            \"max_value\": self.max_value,\n            \"timestamp\": self.timestamp\n        }\n```\n\n```python\n# src/maxpkg/Exceptions.py\n\"\"\"Domain-specific exceptions for validation and empty list scenarios.\"\"\"\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input types or list structures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass EmptyListError(Exception):\n    \"\"\"Exception raised when an empty list is provided where non-empty is required.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n```\n\n```python\n# src/maxpkg/ListValidator.py\n\"\"\"\nValidates input lists for numeric types and non-emptiness.\n\"\"\"\nfrom .Exceptions import ValidationError, EmptyListError\nfrom typing import List, Union\n\nNumber = Union[int, float]\n\nclass ListValidator:\n    \"\"\"Handles validation of list inputs for the MaxElementService.\"\"\"\n    ALLOWED_TYPES = (int, float)\n    MAX_LENGTH = 10000\n\n    def validate(self, values: list) -> None:\n        \"\"\"\n        Validates the input list.\n        Raises ValidationError or EmptyListError if validation fails.\n        \"\"\"\n        if not isinstance(values, list):\n            raise ValidationError(\"Input must be a list.\")\n        if len(values) == 0:\n            raise EmptyListError(\"List must not be empty.\")\n        if len(values) > self.MAX_LENGTH:\n            raise ValidationError(f\"List too long (max {self.MAX_LENGTH} elements).\")\n        for i, v in enumerate(values):\n            if not isinstance(v, self.ALLOWED_TYPES):\n                raise ValidationError(f\"Element at index {i} is not a numeric type (int or float).\")\n\n```\n\n```python\n# src/maxpkg/MaxElementService.py\n\"\"\"Core algorithm to compute the maximum element in a list.\"\"\"\nfrom typing import List, Union\n\nNumber = Union[int, float]\n\nclass MaxElementService:\n    \"\"\"Provides the core business logic for finding the maximum element.\"\"\"\n    def compute_max(self, values: List[Number]) -> Number:\n        \"\"\"\n        Computes the maximum element in a list of numbers using a linear scan.\n        Assumes the input list is non-empty and contains only numeric values.\n        \"\"\"\n        it = iter(values)\n        maximum = next(it)  # Start with the first element\n        for v in it:\n            if v > maximum:\n                maximum = v\n        return maximum\n\n```\n\n```python\n# src/maxpkg/HistoryRepository.py\n\"\"\"Manages persistence of computation history to a JSONL file.\"\"\"\nimport json\nimport os\nimport logging\nfrom typing import Dict, List\n\n# Configure a basic logger for the repository\nlogger = logging.getLogger(__name__)\nif not logger.handlers:\n    logger.setLevel(logging.INFO)\n    handler = logging.StreamHandler()\n    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    handler.setFormatter(formatter)\n    logger.addHandler(handler)\n\nclass HistoryRepository:\n    \"\"\"Handles append-only storage and retrieval of computation history.\"\"\"\n    DEFAULT_HISTORY_PATH = os.path.join(\"data\", \"history.jsonl\")\n\n    def __init__(self, path: str = None):\n        \"\"\"Initializes the repository with a specified path or default.\"\"\"\n        self.path = path or self.DEFAULT_HISTORY_PATH\n        os.makedirs(os.path.dirname(self.path), exist_ok=True)\n\n    def append(self, entry: Dict) -> None:\n        \"\"\"\n        Appends a new history entry to the JSONL file.\n        Logs an error if persistence fails but does not raise an exception.\n        \"\"\"\n        try:\n            with open(self.path, \"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(entry) + \"\\n\")\n        except IOError as e:\n            logger.error(f\"Failed to append history entry to {self.path}: {e}\")\n        except Exception as e:\n            logger.error(f\"An unexpected error occurred while appending history: {e}\")\n\n    def read_all(self) -> List[Dict]:\n        \"\"\"\n        Reads all history entries from the JSONL file.\n        Returns an empty list if the file does not exist or an error occurs.\n        \"\"\"\n        if not os.path.exists(self.path):\n            return []\n        entries = []\n        try:\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                for line in f:\n                    entries.append(json.loads(line))\n        except IOError as e:\n            logger.error(f\"Failed to read history from {self.path}: {e}\")\n            return []\n        except json.JSONDecodeError as e:\n            logger.error(f\"Failed to decode JSON from history file {self.path}: {e}\")\n            return []\n        return entries\n```\n\n```python\n# src/maxpkg/MaxController.py\n\"\"\"\nOrchestrates the process of computing the maximum element, including validation,\ncomputation, and history persistence.\n\"\"\"\nfrom datetime import datetime\nfrom typing import List, Union\n\nfrom .ListValidator import ListValidator\nfrom .MaxElementService import MaxElementService\nfrom .HistoryRepository import HistoryRepository\nfrom .Models import MaxResult\n\nNumber = Union[int, float]\n\nclass MaxController:\n    \"\"\"\n    Manages the end-to-end flow for max element computation.\n    Injects dependencies for validation, service logic, and history persistence.\n    \"\"\"\n    def __init__(\n        self,\n        validator: ListValidator = None,\n        service: MaxElementService = None,\n        repo: HistoryRepository = None\n    ):\n        \"\"\"\n        Initializes the MaxController with optional dependencies.\n        Defaults to concrete implementations if none are provided.\n        \"\"\"\n        self.validator = validator or ListValidator()\n        self.service = service or MaxElementService()\n        self.repo = repo or HistoryRepository()\n\n    def get_max(self, values: list) -> Number:\n        \"\"\"\n        Validates input, computes the maximum, persists the computation history,\n        and returns the numeric result.\n        Raises ValidationError or EmptyListError on invalid input.\n        \"\"\"\n        self.validator.validate(values)\n        result = self.service.compute_max(values)\n\n        timestamp_iso = datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n        entry = {\"timestamp\": timestamp_iso, \"input\": values, \"result\": result}\n        self.repo.append(entry) # Persistence errors are logged by repo, not re-raised.\n\n        return result\n\n    def get_max_dto(self, values: list) -> MaxResult:\n        \"\"\"\n        Computes the maximum and returns it wrapped in a MaxResult DTO,\n        including a timestamp.\n        \"\"\"\n        max_val = self.get_max(values)\n        timestamp_iso = datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n        return MaxResult(max_value=max_val, timestamp=timestamp_iso)\n\n```\n\n```python\n# src/maxpkg/utils.py\n\"\"\"Utility functions for CLI parsing and safe file writing.\"\"\"\nimport os\nimport json\nimport logging\nfrom typing import List, Union\n\nfrom .Exceptions import ValidationError\n\nNumber = Union[int, float]\n\nlogger = logging.getLogger(__name__)\nif not logger.handlers:\n    logger.setLevel(logging.INFO)\n    handler = logging.StreamHandler()\n    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    handler.setFormatter(formatter)\n    logger.addHandler(handler)\n\ndef parse_cli_values(args: List[str]) -> List[Number]:\n    \"\"\"\n    Parses a list of string arguments from the CLI into a list of numbers.\n    Raises ValidationError if any argument cannot be converted.\n    \"\"\"\n    parsed_values: List[Number] = []\n    for arg in args:\n        try:\n            if '.' in arg:\n                parsed_values.append(float(arg))\n            else:\n                parsed_values.append(int(arg))\n        except ValueError:\n            raise ValidationError(f\"Invalid numeric input: '{arg}'. All inputs must be numbers.\")\n    return parsed_values\n\ndef safe_write_jsonl(path: str, entry: dict) -> None:\n    \"\"\"\n    Appends a JSON object to a JSONL file.\n    This function is primarily a helper for HistoryRepository, which uses its own append logic.\n    Provided here for completeness as per design.\n    \"\"\"\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    try:\n        with open(path, \"a\", encoding=\"utf-8\") as f:\n            f.write(json.dumps(entry) + \"\\n\")\n    except IOError as e:\n        logger.error(f\"Failed to safely write JSONL entry to {path}: {e}\")\n    except Exception as e:\n        logger.error(f\"An unexpected error occurred during safe JSONL write: {e}\")\n\n```\n\n```python\n# src/maxpkg/CLI.py\n\"\"\"Command-line interface for the max-element utility.\"\"\"\nimport argparse\nimport sys\nfrom typing import List\n\nfrom .MaxController import MaxController\nfrom .Exceptions import ValidationError, EmptyListError\nfrom .utils import parse_cli_values # Import the utility function\n\nclass CLI:\n    \"\"\"Handles the command-line interface operations for max-element.\"\"\"\n\n    @staticmethod\n    def _parse_args(argv: List[str]) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments using argparse.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute the maximum element of a list of numeric values.\"\n        )\n        parser.add_argument(\n            \"values\",\n            nargs=\"*\",\n            type=str,\n            help=\"Numeric values to process (e.g., 1 2 3.5).\",\n        )\n        parser.add_argument(\n            \"--stdin\",\n            action=\"store_true\",\n            help=\"Read newline-separated numeric values from stdin.\",\n        )\n        args = parser.parse_args(argv)\n\n        if not args.values and not args.stdin:\n            parser.error(\"No input values provided. Use positional arguments or --stdin.\")\n        if args.values and args.stdin:\n            parser.error(\"Cannot use positional arguments and --stdin simultaneously.\")\n        \n        return args\n\n    @classmethod\n    def run(cls, argv: List[str] = None) -> int:\n        \"\"\"\n        Main entry point for the CLI.\n        Parses arguments, computes the max, prints the result, and returns an exit code.\n        \"\"\"\n        if argv is None:\n            argv = sys.argv[1:]\n\n        controller = MaxController()\n\n        try:\n            args = cls._parse_args(argv)\n\n            if args.stdin:\n                raw_values = []\n                for line in sys.stdin:\n                    line = line.strip()\n                    if line: # Only process non-empty lines\n                        raw_values.append(line)\n            else:\n                raw_values = args.values\n            \n            numeric_values = parse_cli_values(raw_values)\n            \n            result = controller.get_max(numeric_values)\n            print(result)\n            return 0  # Success exit code\n\n        except (ValidationError, EmptyListError) as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2  # Validation error exit code\n        except argparse.ArgumentError as e:\n            print(f\"CLI Argument Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # General error exit code\n\nif __name__ == \"__main__\":\n    sys.exit(CLI.run())\n\n```\n\n```python\n# src/maxpkg/APIApp.py\n\"\"\"FastAPI application factory for the HTTP API.\"\"\"\nimport logging\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel, Field\nfrom typing import List, Union\n\nfrom .MaxController import MaxController\nfrom .Exceptions import ValidationError, EmptyListError\n\nlogger = logging.getLogger(__name__)\nif not logger.handlers:\n    logger.setLevel(logging.INFO)\n    handler = logging.StreamHandler()\n    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    handler.setFormatter(formatter)\n    logger.addHandler(handler)\n\nclass ValuesPayload(BaseModel):\n    \"\"\"Pydantic model for the incoming JSON payload.\"\"\"\n    values: List[Union[int, float]] = Field(..., description=\"List of numeric values to find the maximum of.\")\n\nclass MaxResponse(BaseModel):\n    \"\"\"Pydantic model for the outgoing JSON response.\"\"\"\n    max: Union[int, float] = Field(..., description=\"The maximum value found in the list.\")\n\nclass APIApp:\n    \"\"\"Factory class to create and configure the FastAPI application.\"\"\"\n\n    def create_app(self) -> FastAPI:\n        \"\"\"\n        Creates and returns a configured FastAPI application instance.\n        \"\"\"\n        app = FastAPI(\n            title=\"Max Element API\",\n            description=\"A simple API to compute the maximum element of a list of numbers.\",\n            version=\"1.0.0\",\n        )\n\n        controller = MaxController()\n\n        @app.post(\n            \"/max\",\n            response_model=MaxResponse,\n            summary=\"Compute the maximum element of a list.\",\n            description=\"Accepts a JSON payload with a 'values' list and returns the maximum number.\",\n            status_code=200\n        )\n        async def post_max(payload: ValuesPayload):\n            \"\"\"\n            HTTP POST endpoint to compute the maximum element.\n            \"\"\"\n            values = payload.values\n            try:\n                result = controller.get_max(values)\n                return {\"max\": result}\n            except (ValidationError, EmptyListError) as e:\n                logger.warning(f\"Bad request: {e.message}\")\n                raise HTTPException(status_code=400, detail={\"error\": e.message})\n            except Exception as e:\n                logger.exception(\"An unexpected internal server error occurred.\")\n                raise HTTPException(status_code=500, detail={\"error\": \"Internal server error\"})\n        \n        return app\n\n```\n\n```toml\n# pyproject.toml\n[project]\nname = \"maxpkg\"\nversion = \"0.1.0\"\ndescription = \"A utility to compute the maximum element of a list of numeric values.\"\nauthors = [\n    { name = \"Your Name\", email = \"you@example.com\" },\n]\nlicense = \"MIT\"\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nkeywords = [\"max\", \"utility\", \"cli\", \"http-api\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n]\n\n[project.dependencies]\nfastapi = \"^0.111.0\"\nuvicorn = { extras = [\"standard\"], version = \"^0.30.1\" }\npydantic = \"^2.7.4\"\n\n[project.scripts]\nmax-element = \"maxpkg.CLI:CLI.run\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit '7' appears in integers less than n which are divisible by 11 or 13.\n    This includes 0 and numbers divisible by both 11 and 13.\n    \"\"\"\n\n    digit_to_count: str = '7'\n    multiples_of: tuple[int, ...] = (11, 13)\n\n    def _count_digit_occurrences(value: int, digit: str) -> int:\n        \"\"\"Counts how many times a specific digit appears in the string representation of a number.\"\"\"\n        return str(abs(value)).count(digit)\n\n    total_sevens = 0\n    seen_numbers = set()\n\n    for multiplier in multiples_of:\n        k = 0\n        while True:\n            current_number = k * multiplier\n            if current_number >= n:\n                break\n            \n            if current_number not in seen_numbers:\n                seen_numbers.add(current_number)\n                total_sevens += _count_digit_occurrences(current_number, digit_to_count)\n            k += 1\n    \n    return total_sevens"}
