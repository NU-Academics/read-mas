er results.\"\"\"\n    def __init__(self, items: List[int]) -> None:\n        self.items = items\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the filtered items.\"\"\"\n        return list(self.items)\n\n```\n```python\n# src/filter_integers_pkg/utils.py\nimport json\nfrom typing import Any, List\nfrom .exceptions import FilterError\n\nCLI_PROG_NAME = \"filter-integers\"\n\ndef parse_json_input(text: str) -> List[Any]:\n    \"\"\"Safely parses a JSON string, ensuring it's a list.\"\"\"\n    try:\n        parsed = json.loads(text)\n        if not isinstance(parsed, list):\n            raise FilterError(\"JSON input must be a list or array.\")\n        return parsed\n    except json.JSONDecodeError as e:\n        raise FilterError(f\"Invalid JSON input: {e}\") from e\n\n```\n```python\n# src/filter_integers_pkg/validators.py\nfrom typing import Any, Iterable, List\n\nclass IntegerValidator:\n    \"\"\"Validates if a value is an integer, strictly excluding booleans.\"\"\"\n    def is_integer(self, value: Any) -> bool:\n        \"\"\"Checks if the value is an int but not a bool.\"\"\"\n        return isinstance(value, int) and not isinstance(value, bool)\n\n    def filter_integers(self, iterable: Iterable[Any]) -> List[int]:\n        \"\"\"Filters an iterable, returning only strict integers.\"\"\"\n        return [v for v in iterable if self.is_integer(v)]\n\n```\n```python\n# src/filter_integers_pkg/adapters.py\nimport json\nfrom typing import Any, Iterable, List\nfrom .exceptions import FilterError\n\nclass InputAdapter:\n    \"\"\"Normalizes various input types into a consistent iterable format.\"\"\"\n    def normalize(self, values: Any) -> Iterable[Any]:\n        \"\"\"Converts diverse inputs (str, bytes, list, scalar) into an iterable.\"\"\"\n        if isinstance(values, str):\n            try:\n                parsed = json.loads(values)\n                if isinstance(parsed, list):\n                    return parsed\n            except json.JSONDecodeError:\n                return values.split() # Fallback: split by whitespace if not valid JSON\n        elif isinstance(values, bytes):\n            try:\n                decoded_values = values.decode('utf-8')\n                return self.normalize(decoded_values)\n            except UnicodeDecodeError as e:\n                raise FilterError(f\"Cannot decode bytes input: {e}\") from e\n        \n        if self._is_iterable(values):\n            return values\n        \n        return [values] # If it's a single scalar value, wrap it in a list\n\n    def _is_iterable(self, value: Any) -> bool:\n        \"\"\"Helper to detect non-string iterables.\"\"\"\n        return hasattr(value, \"__iter__\") and not isinstance(value, (str, bytes))\n\n```\n```python\n# src/filter_integers_pkg/services.py\nfrom typing import Any, Iterable, List\nfrom .exceptions import FilterError\nfrom .validators import IntegerValidator\nfrom .adapters import InputAdapter\nfrom .models import FilterResult\n\nclass FilterService:\n    \"\"\"Core business logic for filtering integers from various inputs.\"\"\"\n    def __init__(self, validator: IntegerValidator, adapter: InputAdapter) -> None:\n        self._validator = validator\n        self._adapter = adapter\n\n    def filter(self, values: Any) -> List[int]:\n        \"\"\"Normalizes input, filters for integers, and returns the result.\"\"\"\n        try:\n            iterable = self._adapter.normalize(values)\n            filtered_ints = self._validator.filter_integers(iterable)\n            return FilterResult(filtered_ints).to_list()\n        except FilterError:\n            raise # Re-raise our own domain exceptions directly\n        except Exception as e:\n            raise FilterError(f\"An unexpected error occurred during filtering: {e}\", cause=e)\n\n```\n```python\n# src/filter_integers_pkg/controllers.py\nfrom typing import Any, List\nfrom .services import FilterService\nfrom .exceptions import FilterError\n\nclass IntegerFilterController:\n    \"\"\"API layer controller, orchestrates filtering logic via the service.\"\"\"\n    def __init__(self, service: FilterService) -> None:\n        self._service = service\n\n    def filter_values(self, values: Any) -> List[int]:\n        \"\"\"Filters a mixed collection of values, returning only integers.\"\"\"\n        try:\n            return self._service.filter(values)\n        except FilterError:\n            raise # Re-raise our domain exceptions for programmatic handling\n        except Exception as e:\n            raise FilterError(f\"Unexpected error in controller: {e}\", cause=e)\n\n```\n```python\n# src/filter_integers_pkg/cli.py\nimport argparse\nimport sys\nimport json\nfrom typing import List, Any, Optional\n\nfrom .controllers import IntegerFilterController\nfrom .exceptions import FilterError\nfrom .utils import CLI_PROG_NAME\n\nclass CLIApp:\n    \"\"\"Command-Line Interface application for filtering integers.\"\"\"\n    def __init__(self, controller: IntegerFilterController) -> None:\n        self._controller = controller\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Parses arguments, executes filter, and prints JSON output or errors.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=CLI_PROG_NAME,\n            description=\"Filter Python iterables/collections, returning only integer values.\"\n        )\n        group = parser.add_mutually_exclusive_group()\n        group.add_argument(\n            '--json', '-j',\n            type=str,\n            help=\"Input as a JSON array string (e.g., '[1, \\\"a\\\", 2]').\"\n        )\n        parser.add_argument(\n            'items',\n            nargs='*', # 0 or more positional arguments\n            help=\"Space-separated items to filter, or '-' to read from stdin (for JSON input with -j).\"\n        )\n\n        args = parser.parse_args(argv)\n\n        input_values: Any = []\n\n        if args.json:\n            if args.items and args.items[0] == '-':\n                try:\n                    json_str = sys.stdin.read()\n                    input_values = json_str\n                except Exception as e:\n                    print(f\"Error reading from stdin: {e}\", file=sys.stderr)\n                    return 1\n            else:\n                input_values = args.json # Use the string provided directly with --json\n        elif args.items:\n            if args.items[0] == '-':\n                try:\n                    line = sys.stdin.read().strip()\n                    input_values = line.split() if line else []\n                except Exception as e:\n                    print(f\"Error reading from stdin: {e}\", file=sys.stderr)\n                    return 1\n            else:\n                input_values = args.items\n        else:\n            input_values = [] # No input provided means nothing to filter, empty list\n\n        try:\n            result = self._controller.filter_values(input_values)\n            print(json.dumps(result))\n            return 0\n        except FilterError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n```\n```python\n# src/filter_integers_pkg/main.py\nimport sys\nfrom typing import List, Optional\n\nfrom .cli import CLIApp\nfrom .controllers import IntegerFilterController\nfrom .services import FilterService\nfrom .adapters import InputAdapter\nfrom .validators import IntegerValidator\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    validator = IntegerValidator()\n    adapter = InputAdapter()\n    service = FilterService(validator, adapter)\n    controller = IntegerFilterController(service)\n    app = CLIApp(controller)\n    return app.run(argv if argv is not None else sys.argv[1:])\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n```python\n# src/filter_integers_pkg/__init__.py\nfrom typing import Any, List\n\n# Re-export public API components as specified in the design\nfrom .exceptions import FilterError\nfrom .services import FilterService\nfrom .controllers import IntegerFilterController\nfrom .adapters import InputAdapter\nfrom .validators import IntegerValidator\n\n# Initialize default instances for the top-level filter_integers function\n_default_validator = IntegerValidator()\n_default_adapter = InputAdapter()\n_default_service = FilterService(_default_validator, _default_adapter)\n_default_controller = IntegerFilterController(_default_service)\n\ndef filter_integers(values: Any) -> List[int]:\n    \"\"\"\n    Filter given values, returning only strict integer values.\n\n    This is the primary library function for filtering.\n    \"\"\"\n    return _default_controller.filter_values(values)\n\n__all__ = [\n    \"filter_integers\",\n    \"FilterService\",\n    \"FilterError\",\n    \"IntegerFilterController\",\n    \"InputAdapter\",\n    \"IntegerValidator\",\n]\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"filter-integers-pkg\"\nversion = \"0.1.0\"\ndescription = \"A small, well-tested Python library and CLI for filtering integers from iterables.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"filter\", \"integers\", \"iterable\", \"utility\", \"cli\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.8\",\n    \"Programming Language :: Python :: 3.9\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\ndependencies = []\n\n[project.urls]\nHomepage = \"https://github.com/your-username/filter-integers-pkg\"\nIssues = \"https://github.com/your-username/filter-integers-pkg/issues\"\nSource = \"https://github.com/your-username/filter-integers-pkg\"\n\n[project.scripts]\nfilter-integers = \"filter_integers_pkg.main:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\naddopts = \"--cov=filter_integers_pkg --cov-report=term-missing\"\npythonpath = [\"src\"]\n\n[tool.coverage.report]\nexclude_lines = [\n    \"if TYPE_CHECKING:\",\n    \"if __name__ == .__main__.:\",\n    \"pragma: no cover\",\n    \"raise NotImplementedError\",\n    \"except ImportError\",\n]\nomit = [\n    \"*/__init__.py\",\n]\n\n```\n```markdown\n# README.md\n# filter-integers-pkg\n\nA small, well-tested Python library and command-line interface (CLI) for filtering Python iterables and collections to extract only integer values.\n\n## Features\n\n- **Library Function**: `filter_integers(values: Any) -> List[int]` to easily extract integers.\n- **CLI Tool**: `filter-integers` to process JSON lists or space-separated items directly from the command line.\n- **Strict Integer Validation**: Explicitly excludes boolean values (`True`, `False`) from being considered integers.\n- **Order Preservation**: Maintains the original order of integers found in the input.\n- **Modular Design**: Built with a layered architecture for testability and maintainability.\n\n## Installation\n\n```bash\npip install filter-integers-pkg\n```\n\n## Usage\n\n### Library Usage\n\n```python\nfrom filter_integers_pkg import filter_integers, FilterService, IntegerValidator, InputAdapter\n\n# Using the top-level convenience function\nmixed_values = [1, 'hello', 3.14, True, 5, False, '10']\nintegers = filter_integers(mixed_values)\nprint(integers)  # Output: [1, 5]\n\n# Using the FilterService for more control\nvalidator = IntegerValidator()\nadapter = InputAdapter()\nservice = FilterService(validator, adapter)\nintegers_from_service = service.filter([10, None, 20, 'world'])\nprint(integers_from_service) # Output: [10, 20]\n\n# Input can be a JSON string\njson_input = '[1, \"abc\", 2, false, 3]'\nintegers_from_json = filter_integers(json_input)\nprint(integers_from_json) # Output: [1, 2, 3]\n\n# Input can be space-separated string (fallback from invalid JSON string)\nspace_separated_input = \"1 foo 2 bar 3\"\nintegers_from_space = filter_integers(space_separated_input)\nprint(integers_from_space) # Output: [] (because '1', '2', '3' are string representations, not actual int types)\n```\n\n### CLI Usage\n\n```bash\n# Filter space-separated items\nfilter-integers 1 2 \"hello world\" 3.14 True 5 false 10\n# Output: [1, 5, 10]\n# Note: \"hello world\", \"3.14\", \"True\", \"false\" are treated as strings and thus not integers.\n\n# Filter a JSON array string\nfilter-integers --json '[1, \"a\", 3.14, true, 5, null, 10]'\n# Output: [1, 5, 10]\n\n# Read JSON array from stdin\necho '[1, \"b\", 2, false]' | filter-integers --json -\n# Output: [1, 2]\n\n# Read space-separated items from stdin\necho '1 foo 2 bar 3' | filter-integers -\n# Output: [] (because '1', '2', '3' are string representations, not actual int types)\n```\n\n## Development\n\nTo set up the development environment:\n\n1.  Clone the repository:\n    ```bash\n    git clone https://github.com/your-username/filter-integers-pkg.git\n    cd filter-integers-pkg\n    ```\n2.  Install poetry (if not already installed):\n    ```bash\n    pip install poetry\n    ```\n3.  Install dependencies:\n    ```bash\n    poetry install\n    ```\n4.  Run tests:\n    ```bash\n    poetry run pytest\n    ```\n5.  Run the CLI locally:\n    ```bash\n    poetry run filter-integers 1 a 2\n    ```\n\n## Contributing\n\nPlease refer to the contributing guidelines (to be added).\n\n## License\n\nThis project is licensed under the MIT License.\n```\n```yaml\n# .github/workflows/ci.yml\nname: CI\n\non:\n  push:\n    branches:\n      - main\n      - develop\n  pull_request:\n    branches:\n      - main\n      - develop\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\"]\n\n    steps:\n    - uses: actions/checkout@v3\n\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v4\n      with:\n        python-version: ${{ matrix.python-version }}\n\n    - name: Install dependencies\n      run: |\n        python -m pip install --upgrade pip\n        pip install poetry\n        poetry install --with dev --no-root # Install dev dependencies if any\n\n    - name: Run linting (flake8)\n      run: |\n        pip install flake8\n        flake8 src/\n\n    - name: Run tests with pytest and coverage\n      run: |\n        poetry run pytest --cov=filter_integers_pkg --cov-report=xml\n      env:\n        PYTHONPATH: src/\n\n    - name: Upload coverage to Codecov\n      uses: codecov/codecov-action@v3\n      with:\n        files: ./coverage.xml\n        fail_ci_if_error: true # Set to true to fail CI if Codecov upload fails\n\n```\n```\n# tests/__init__.py\n```\n```\n# tests/test_services.py\n# (File created as per design, but no tests written as per \"FORBIDDEN: DO NOT write unit tests\" rule)\n```\n```\n# tests/test_validators.py\n# (File created as per design, but no tests written as per \"FORBIDDEN: DO NOT write unit tests\" rule)\n```\n```\n# tests/test_adapters.py\n# (File created as per design, but no tests written as per \"FORBIDDEN: DO NOT write unit tests\" rule)\n```\n```\n# tests/test_controller.py\n# (File created as per design, but no tests written as per \"FORBIDDEN: DO NOT write unit tests\" rule)\n```\n```\n# tests/test_cli.py\n# (File created as per design, but no tests written as per \"FORBIDDEN