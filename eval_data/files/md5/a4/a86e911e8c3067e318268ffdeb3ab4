      try:\n            return int(token)\n        except ValueError:\n            try:\n                return float(token)\n            except ValueError:\n                pass # Fall through to return original string if float conversion also fails.\n    return token\n\ndef tokens_from_args(args: Sequence[str]) -> List[Union[int, float, str]]:\n    \"\"\"Processes command-line arguments or stdin into a list of parsed tokens.\"\"\"\n    if not args:\n        line = sys.stdin.readline().strip()\n        tokens = line.split()\n    else:\n        tokens = list(args)\n    return [try_parse_token(token) for token in tokens]\n```\n\n```python\nsrc/monotonic_checker/checker.py\n```python\n\"\"\"Core algorithm for determining sequence monotonicity.\"\"\"\n\nfrom typing import Iterable, TypeVar, Optional, Iterator\n\nT = TypeVar(\"T\")\n\nclass SequenceChecker:\n    \"\"\"Provides the core algorithm to check if a sequence is monotonic.\"\"\"\n\n    def is_monotonic(self, seq: Iterable[T]) -> bool:\n        \"\"\"Determines if the given sequence is monotonically non-decreasing or non-increasing.\"\"\"\n        it: Iterator[T] = iter(seq)\n        try:\n            prev = next(it)\n        except StopIteration:\n            return True # Empty sequence is considered monotonic.\n\n        direction: Optional[int] = None # None: unknown, 1: increasing, -1: decreasing.\n\n        for cur in it:\n            try:\n                if prev < cur:\n                    cmp_result = 1\n                elif prev > cur:\n                    cmp_result = -1\n                else:\n                    cmp_result = 0 # Elements are equal, does not change direction.\n            except TypeError:\n                # Propagate TypeError, which MonotonicService will catch and re-raise.\n                raise\n\n            if cmp_result != 0:\n                if direction is None:\n                    direction = cmp_result # First non-equal pair sets the direction.\n                elif direction != cmp_result:\n                    return False # Direction changed, so not monotonic.\n            prev = cur\n        return True\n```\n\n```python\nsrc/monotonic_checker/service.py\n```python\n\"\"\"Service layer for validation and public API exposure.\"\"\"\n\nfrom typing import Iterable, Optional, TypeVar\n\nfrom .checker import SequenceChecker\nfrom .exceptions import InvalidInputError, IncomparableElementsError\nfrom .utils import is_iterable\nfrom .types import T\n\nclass MonotonicService:\n    \"\"\"Provides a validated API for checking sequence monotonicity.\"\"\"\n\n    def __init__(self, checker: Optional[SequenceChecker] = None) -> None:\n        \"\"\"Initializes the service, optionally injecting a SequenceChecker.\"\"\"\n        self._checker = checker or SequenceChecker()\n\n    def check(self, seq: Iterable[T]) -> bool:\n        \"\"\"Checks if a sequence is monotonic, performing input validation and error mapping.\"\"\"\n        if not is_iterable(seq):\n            raise InvalidInputError(\"Input must be an iterable sequence.\")\n        try:\n            return self._checker.is_monotonic(seq)\n        except TypeError as e:\n            raise IncomparableElementsError(\"Elements within the sequence are not comparable.\") from e\n```\n\n```python\nsrc/monotonic_checker/cli.py\n```python\n\"\"\"Command-line interface for the monotonic checker.\"\"\"\n\nimport sys\nfrom typing import Sequence, Optional\n\nfrom .service import MonotonicService\nfrom .utils import tokens_from_args\nfrom .exceptions import MonotonicError, InvalidInputError, IncomparableElementsError\n\nclass CLIController:\n    \"\"\"Handles command-line argument parsing, service interaction, and output.\"\"\"\n\n    def run(self, argv: Optional[Sequence[str]] = None) -> int:\n        \"\"\"Executes the CLI logic, returning an exit code.\"\"\"\n        try:\n            tokens = tokens_from_args(argv or [])\n            svc = MonotonicService()\n            result = svc.check(tokens)\n            self._print_result(result)\n            return 0 if result else 1\n        except (InvalidInputError, IncomparableElementsError) as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except MonotonicError as e:\n            # Catch any other MonotonicError that might not be specific.\n            print(f\"An unexpected monotonic error occurred: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            # Catch any other unexpected errors.\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 2\n\n    def _print_result(self, result: bool) -> None:\n        \"\"\"Prints the boolean result to standard output.\"\"\"\n        print(\"True\" if result else \"False\")\n\ndef main() -> int:\n    \"\"\"The main entry point for the console script.\"\"\"\n    controller = CLIController()\n    return controller.run(sys.argv[1:])\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\npyproject.toml\n```toml\n[project]\nname = \"monotonic-checker\"\nversion = \"0.1.0\"\ndescription = \"A small Python library to determine if a sequence of comparable elements is monotonic.\"\nauthors = [\"Your Name <your.email@example.com>\"]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"monotonic\", \"sequence\", \"checker\", \"library\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/monotonic-checker\"\n\"Bug Tracker\" = \"https://github.com/yourusername/monotonic-checker/issues\"\n\n[project.scripts]\nmonotonic-check = \"monotonic_checker.cli:main\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n\n```python\nREADME.md\n```markdown\n# Monotonic Checker Library\n\nA small Python library and command-line tool to determine if a sequence of comparable elements is monotonic (either non-decreasing or non-increasing).\n\n## Installation\n\n```bash\npip install monotonic-checker\n```\n\n## Usage\n\n### Command Line Interface (CLI)\n\nCheck if a sequence is monotonic directly from your terminal:\n\n```bash\n# Example: Non-decreasing sequence\nmonotonic-check 1 2 3 4\n# Output: True\n\n# Example: Non-increasing sequence\nmonotonic-check 4 3 2 1\n# Output: True\n\n# Example: Non-monotonic sequence\nmonotonic-check 1 5 2 8\n# Output: False\n\n# Example: Sequence with equal elements (still monotonic)\nmonotonic-check 1 2 2 3\n# Output: True\nmonotonic-check 3 2 2 1\n# Output: True\n\n# Example: Reading from stdin\necho \"10 5 0 -5\" | monotonic-check\n# Output: True\n```\n\n**Exit Codes:**\n- `0`: Sequence is monotonic (True)\n- `1`: Sequence is not monotonic (False)\n- `2`: An error occurred (e.g., invalid input, incomparable elements)\n\n### Programmatic API\n\nIntegrate the `monotonic-checker` into your Python applications.\n\n```python\nfrom monotonic_checker.service import MonotonicService\nfrom monotonic_checker.exceptions import InvalidInputError, IncomparableElementsError\n\nsvc = MonotonicService()\n\n# Monotonically non-decreasing\nprint(svc.check([1, 2, 4, 20]))  # Output: True\nprint(svc.check((1, 1, 2, 3)))   # Output: True\n\n# Monotonically non-increasing\nprint(svc.check([4, 1, 0, -10])) # Output: True\nprint(svc.check(\"zyxw\"))        # Output: True (string characters are comparable)\n\n# Not monotonic\nprint(svc.check([1, 20, 4, 10])) # Output: False\n\n# Edge cases\nprint(svc.check([]))             # Output: True (empty sequence)\nprint(svc.check([5]))            # Output: True (single element)\nprint(svc.check([5, 5, 5]))      # Output: True (constant sequence)\n\n# Error handling\ntry:\n    svc.check(123) # Not an iterable\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\") # Output: Error: Input must be an iterable sequence.\n\ntry:\n    svc.check([1, 'a', 3]) # Incomparable types\nexcept IncomparableElementsError as e:\n    print(f\"Error: {e}\") # Output: Error: Elements within the sequence are not comparable.\n\ntry:\n    svc.check([1, None, 3]) # None is not comparable with int\nexcept IncomparableElementsError as e:\n    print(f\"Error: {e}\")\n```\n\n## Development\n\nTo set up the development environment and run tests:\n\n1. Clone the repository:\n   ```bash\n   git clone https://github.com/yourusername/monotonic-checker.git\n   cd monotonic-checker\n   ```\n2. Install in editable mode along with development dependencies:\n   ```bash\n   pip install -e \".[dev]\"\n   ```\n3. Run tests:\n   ```bash\n   pytest\n   ```\n4. Run linting and formatting checks:\n   ```bash\n   black --check src/\n   flake8 src/\n   ```\n\n## License\n\nThis project is licensed under the MIT License - see the LICENSE file for details.\n```\n\n```python\n.github/workflows/python-package.yml\n```yaml\nname: Python Package CI\n\non:\n  push:\n    branches: [ \"main\" ]\n  pull_request:\n    branches: [ \"main\" ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n    - uses: actions/checkout@v3\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v4\n      with:\n        python-version: ${{ matrix.python-version }}\n    - name: Install dependencies\n      run: |\n        python -m pip install --upgrade pip\n        pip install -e \".[dev]\" # Install in editable mode with dev dependencies\n    - name: Run tests with pytest\n      run: |\n        pytest\n    - name: Lint with flake8\n      run: |\n        flake8 src/\n    - name: Format check with Black\n      run: |\n        black --check src/\n```"}
