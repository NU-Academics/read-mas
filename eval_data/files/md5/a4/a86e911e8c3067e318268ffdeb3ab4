ge\n        super().__init__(self.message)\n\nclass InvalidInputError(RollingMaxError):\n    \"\"\"Raised when input data is invalid.\"\"\"\n    pass\n```\n\n### File: `src/rollingmax/utils.py`\n```python\nimport json\nfrom typing import List, Any\nfrom .exceptions import InvalidInputError\n\nclass RollingMaxUtils:\n    \"\"\"Utility class for parsing, validating, and formatting.\"\"\"\n    DEFAULT_SEPARATOR = ','\n\n    @staticmethod\n    def parse_input(s: str) -> List[int]:\n        \"\"\"Parses a string of numbers into a list of integers.\"\"\"\n        if not isinstance(s, str):\n            raise InvalidInputError(\"Input for parsing must be a string.\")\n        \n        if RollingMaxUtils.DEFAULT_SEPARATOR in s:\n            parts = [p.strip() for p in s.split(RollingMaxUtils.DEFAULT_SEPARATOR) if p.strip() != '']\n        else:\n            parts = s.split()\n\n        if not parts:\n            return []\n\n        numbers = []\n        try:\n            for p in parts:\n                if '.' in p: \n                    raise InvalidInputError(f\"Float detected, numbers must be integers: '{p}'\")\n                numbers.append(int(p))\n            return numbers\n        except ValueError as e:\n            raise InvalidInputError(f\"Could not parse integer from input: {e}\")\n\n    @staticmethod\n    def validate_numbers(numbers: List[int]) -> None:\n        \"\"\"Validates that the input is a list of integers.\"\"\"\n        if numbers is None:\n            raise InvalidInputError(\"Input cannot be None.\")\n        if not isinstance(numbers, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                if isinstance(v, float):\n                    raise InvalidInputError(f\"Element at index {i} is a float: {v}. Input elements must be integers.\")\n                raise InvalidInputError(f\"Element at index {i} is not an integer: {v} (type: {type(v).__name__}).\")\n\n    @staticmethod\n    def format_output(result: List[int], json_output: bool = False) -> str:\n        \"\"\"Formats the list of integers as a string or JSON array.\"\"\"\n        if json_output:\n            return json.dumps(result)\n        return RollingMaxUtils.DEFAULT_SEPARATOR.join(str(x) for x in result)\n\n```\n\n### File: `src/rollingmax/service.py`\n```python\nfrom typing import List, Optional, Any\nfrom .utils import RollingMaxUtils\nfrom .exceptions import InvalidInputError\n\nclass RollingMaxService:\n    \"\"\"Core service for computing rolling maximum.\"\"\"\n\n    def compute(self, numbers: List[int]) -> List[int]:\n        \"\"\"Computes the rolling maximum for a list of integers.\"\"\"\n        RollingMaxUtils.validate_numbers(numbers)\n\n        result: List[int] = []\n        current_max: Optional[int] = None\n\n        for x in numbers:\n            if current_max is None or x > current_max:\n                current_max = x\n            result.append(current_max)\n        return result\n\n    def compute_inplace(self, numbers: List[int]) -> List[int]:\n        \"\"\"Computes rolling maximum, returning a new list and reusing input values.\"\"\"\n        RollingMaxUtils.validate_numbers(numbers)\n\n        if not numbers:\n            return []\n\n        output: List[int] = [0] * len(numbers)\n        current_max = numbers[0]\n        output[0] = current_max\n\n        for i in range(1, len(numbers)):\n            x = numbers[i]\n            if x > current_max:\n                current_max = x\n            output[i] = current_max\n        return output\n\n```\n\n### File: `src/rollingmax/schemas.py`\n```python\nimport json\nfrom dataclasses import dataclass\nfrom typing import List\nfrom .utils import RollingMaxUtils\nfrom .exceptions import InvalidInputError\n\n@dataclass\nclass InputSchema:\n    \"\"\"DTO for CLI input data.\"\"\"\n    numbers: List[int]\n\n    @classmethod\n    def from_string(cls, s: str) -> 'InputSchema':\n        \"\"\"Parses a string into an InputSchema instance.\"\"\"\n        parsed_numbers = RollingMaxUtils.parse_input(s)\n        return cls(numbers=parsed_numbers)\n\n@dataclass\nclass ResultDTO:\n    \"\"\"DTO for computation results.\"\"\"\n    rolling_max: List[int]\n\n    def to_json(self) -> str:\n        \"\"\"Converts the result to a JSON string.\"\"\"\n        return RollingMaxUtils.format_output(self.rolling_max, json_output=True)\n\n    def to_str(self) -> str:\n        \"\"\"Converts the result to a plain string.\"\"\"\n        return RollingMaxUtils.format_output(self.rolling_max, json_output=False)\n\n```\n\n### File: `src/rollingmax/cli.py`\n```python\nimport sys\nimport argparse\nimport io\nfrom typing import List, Tuple, Optional\nfrom .service import RollingMaxService\nfrom .utils import RollingMaxUtils\nfrom .schemas import InputSchema, ResultDTO\nfrom .exceptions import InvalidInputError\n\nclass RollingMaxCLI:\n    \"\"\"CLI adapter for the rolling maximum computation.\"\"\"\n    def __init__(self, service: RollingMaxService, utils: RollingMaxUtils):\n        self.service = service\n        self.utils = utils\n\n    def _parse_args(self, argv: List[str]) -> Tuple[List[int], bool]:\n        \"\"\"Parses command line arguments and determines input source.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"rolling-max\",\n            description=\"Compute the rolling maximum of an integer sequence.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        parser.add_argument(\n            'numbers',\n            nargs='*',\n            help=\"Space or comma-separated integers (e.g., '1 2 3' or '1,2,3').\\n\"\n                 \"If not provided, input is read from stdin.\"\n        )\n        parser.add_argument(\n            '--json',\n            action='store_true',\n            help=\"Output the result as a JSON array.\"\n        )\n\n        args = parser.parse_args(argv[1:])\n\n        input_string: str = \"\"\n        if args.numbers:\n            input_string = \" \".join(args.numbers)\n        elif not sys.stdin.isatty():\n            input_string = sys.stdin.read().strip()\n            if not input_string:\n                raise InvalidInputError(\"No input provided via arguments or stdin.\")\n        else:\n            raise InvalidInputError(\"No input provided. Use 'rolling-max --help' for usage.\")\n\n        input_schema = InputSchema.from_string(input_string)\n        \n        return input_schema.numbers, args.json\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Main entry point for the CLI.\"\"\"\n        try:\n            numbers, json_output = self._parse_args(argv)\n            \n            result_list = self.service.compute(numbers)\n            \n            result_dto = ResultDTO(rolling_max=result_list)\n\n            if json_output:\n                print(result_dto.to_json())\n            else:\n                print(result_dto.to_str())\n            \n            return 0\n        except InvalidInputError as e:\n            print(f\"Invalid input: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\ndef main_cli_entry_point():\n    \"\"\"Entry point for the 'rolling-max' console script.\"\"\"\n    service = RollingMaxService()\n    utils = RollingMaxUtils()\n    cli = RollingMaxCLI(service, utils)\n    sys.exit(cli.run(sys.argv))\n\n```\n\n### File: `src/rollingmax/__init__.py`\n```python\nfrom typing import List\nfrom .service import RollingMaxService\nfrom ._version import __version__\n\n# Expose the public API function\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Public API: computes the rolling maximum of an integer sequence.\n    Example: rolling_max([1, 2, 3, 2, 3, 4, 2]) == [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    svc = RollingMaxService()\n    return svc.compute(numbers)\n\n# Define __all__ for explicit package exports\n__all__ = [\"rolling_max\", \"__version__\"]\n```"}
