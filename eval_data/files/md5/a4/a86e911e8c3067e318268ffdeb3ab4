d then caches on a cache miss.\"\"\"\n        n = 100\n        computed_value = 6739798950523098317300302796443491417036496\n        mock_cache_repo.get.return_value = None # Simulate cache miss\n\n        result = fib4_service.compute(n)\n        assert result == computed_value\n        mock_cache_repo.get.assert_called_with(n)\n        mock_matrix_adapter.compute_via_matrix.assert_called_with(n)\n        mock_cache_repo.set.assert_called_with(n, computed_value)\n\n    def test_cache_disabled_no_cache_interaction(self, mock_cache_repo, mock_matrix_adapter, mock_iterative_adapter):\n        \"\"\"Verify no cache interaction when caching is disabled.\"\"\"\n        service = Fib4Service(\n            cache=mock_cache_repo,\n            matrix_adapter=mock_matrix_adapter,\n            iterative_adapter=mock_iterative_adapter,\n            threshold=Config.ALGORITHM_THRESHOLD,\n            cache_enabled=False # Cache is disabled\n        )\n        n = 100\n        computed_value = 6739798950523098317300302796443491417036496\n        mock_matrix_adapter.compute_via_matrix.return_value = computed_value\n\n        result = service.compute(n)\n        assert result == computed_value\n        mock_cache_repo.get.assert_not_called()\n        mock_cache_repo.set.assert_not_called()\n        mock_matrix_adapter.compute_via_matrix.assert_called_with(n)\n\n    def test_cache_error_on_get_still_computes(self, fib4_service, mock_cache_repo, mock_matrix_adapter):\n        \"\"\"Service computes even if cache.get() fails.\"\"\"\n        n = 100\n        computed_value = 6739798950523098317300302796443491417036496\n        mock_cache_repo.get.side_effect = Exception(\"DB read error\")\n        mock_matrix_adapter.compute_via_matrix.return_value = computed_value\n\n        result = fib4_service.compute(n)\n        assert result == computed_value\n        mock_cache_repo.get.assert_called_with(n)\n        mock_matrix_adapter.compute_via_matrix.assert_called_with(n)\n        # Should still try to set, and might fail there too, but computation happened.\n        mock_cache_repo.set.assert_called_with(n, computed_value)\n\n    def test_cache_error_on_set_does_not_fail_computation(self, fib4_service, mock_cache_repo, mock_matrix_adapter):\n        \"\"\"Service computation succeeds even if cache.set() fails.\"\"\"\n        n = 100\n        computed_value = 6739798950523098317300302796443491417036496\n        mock_cache_repo.get.return_value = None\n        mock_matrix_adapter.compute_via_matrix.return_value = computed_value\n        mock_cache_repo.set.side_effect = Exception(\"DB write error\")\n\n        result = fib4_service.compute(n)\n        assert result == computed_value\n        mock_cache_repo.get.assert_called_with(n)\n        mock_matrix_adapter.compute_via_matrix.assert_called_with(n)\n        mock_cache_repo.set.assert_called_with(n, computed_value) # Still called, just failed internally\n\n# tests/test_cli.py\nimport pytest\nimport subprocess\nimport sys\nimport os\n\n# Define the path to the CLI script\nCLI_PATH = os.path.abspath(os.path.join(os.path.dirname(__file__), '../src/fib4_calc/cli.py'))\n\n@pytest.fixture(scope=\"module\")\ndef setup_cli_env():\n    \"\"\"Sets up environment for CLI tests.\"\"\"\n    # Ensure any cache.db from previous runs is cleared for predictable tests\n    if os.path.exists(\"./cache.db\"):\n        os.remove(\"./cache.db\")\n    yield\n    # Clean up after tests\n    if os.path.exists(\"./cache.db\"):\n        os.remove(\"./cache.db\")\n\nclass TestFib4CLI:\n    \"\"\"Integration tests for the Fib4 command-line interface.\"\"\"\n\n    def run_cli(self, command_args: list[str]) -> subprocess.CompletedProcess:\n        \"\"\"Helper to run the CLI as a subprocess.\"\"\"\n        # Use sys.executable to ensure the correct Python interpreter from the virtualenv\n        return subprocess.run(\n            [sys.executable, CLI_PATH] + command_args,\n            capture_output=True,\n            text=True,\n