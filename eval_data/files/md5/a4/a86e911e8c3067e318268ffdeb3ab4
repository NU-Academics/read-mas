rt Config\n\ndef main(argv: list[str] | None = None) -> int:\n    \"\"\"\n    Main entry point for the command-line interface.\n    Parses args, sets up components (repository, strategies, service), and runs the CLI controller.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Compute the n-th Fibonacci number or run the HTTP API.\"\n    )\n    # Global arguments\n    parser.add_argument(\n        \"--persist-cache\",\n        type=str,\n        default=os.getenv(\"FIB_APP_CACHE_DB_PATH\", Config.cache_db_path),\n        help=f\"Path to SQLite database file for persistent cache (default: {Config.cache_db_path or 'in-memory only'}).\",\n    )\n    parser.add_argument(\n        \"--default-strategy\",\n        choices=[\"auto\", \"iterative\", \"recursive_memo\", \"matrix\"],\n        default=Config.default_strategy,\n        help=\"Default computation strategy if not specified (default: auto).\",\n    )\n\n    # Subparsers for different commands\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # 'compute' command\n    compute_parser = subparsers.add_parser(\"compute\", help=\"Compute a Fibonacci number.\")\n    compute_parser.add_argument(\n        \"--n\", type=int, required=True, help=\"The non-negative integer index for the Fibonacci number.\"\n    )\n    compute_parser.add_argument(\n        \"--strategy\",\n        choices=[\"auto\", \"iterative\", \"recursive_memo\", \"matrix\"],\n        default=\"auto\",\n        help=\"Computation strategy to use for this specific call.\",\n    )\n\n    # 'api' command\n    api_parser = subparsers.add_parser(\"api\", help=\"Run the HTTP API server.\")\n    api_parser.add_argument(\n        \"--host\", type=str, default=Config.FLASK_HOST, help=f\"Host for the Flask API (default: {Config.FLASK_HOST}).\"\n    )\n    api_parser.add_argument(\n        \"--port\", type=int, default=Config.FLASK_PORT, help=f\"Port for the Flask API (default: {Config.FLASK_PORT}).\