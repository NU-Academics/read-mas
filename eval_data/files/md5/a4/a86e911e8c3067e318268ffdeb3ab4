``\n\n## Usage\n\n### Programmatic\n\n```python\nfrom common_utils import common\n\nlist1 = [1, 4, 3, 34, 653, 2, 5]\nlist2 = [5, 7, 1, 5, 9, 653, 121]\nresult = common(list1, list2)\nprint(result) # Output: [1, 5, 653]\n```\n\n### Command Line Interface (CLI)\n\n```bash\npython -m common_utils.cli --a \"1,4,3,34,653,2,5\" --b \"5,7,1,5,9,653,121\"\n# Output: [1, 5, 653]\n```\n\n```bash\ncommon-utils --a \"apple,banana,orange\" --b \"grape,banana,kiwi,apple\"\n# Output: [\"apple\", \"banana\"]\n```\n```python\n# .github/workflows/ci.yml\nname: Python CI\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.9\", \"3.10\", \"3.11\"]\n\n    steps:\n    - uses: actions/checkout@v3\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v4\n      with:\n        python-version: ${{ matrix.python-version }}\n    - name: Install dependencies\n      run: |\n        python -m pip install --upgrade pip\n        pip install -e .[dev]\n    - name: Run tests\n      run: |\n        pytest\n```\n```python\n# src/common_utils/__init__.py\nfrom typing import List, Any\n\n# This common function directly implements the logic due to critical requirements,\n# ignoring the layered architecture for this specific entry point.\n# It trusts inputs and performs no explicit validation or error handling.\ndef common(l1: List[Any], l2: List[Any]) -> List[Any]:\n    \"\"\"Return sorted unique common elements for two lists.\n    Trusts inputs; performs no type checks or error handling.\"\"\"\n    s1 = set(l1)\n    s2 = set(l2)\n    common_elements = s1.intersection(s2)\n    return sorted(list(common_elements))\n\n__all__ = [\"common\"]\n```\n```python\n# src/common_utils/common_api.py\nfrom typing import List, Any\nfrom .validator import Validator\nfrom .list_repository import ListRepository\nfrom .common_finder import CommonFinder\nfrom .exceptions import InvalidInputError\n\nclass CommonAPI:\n    \"\"\"Public application facade for computing common elements.\"\"\"\n\n    def __init__(self, validator: Validator, repo: ListRepository, finder: CommonFinder) -> None:\n        \"\"\"Constructs CommonAPI with injected dependencies.\"\"\"\n        self._validator = validator\n        self._repo = repo\n        self._finder = finder\n\n    def common(self, l1: List[Any], l2: List[Any]) -> List[Any]:\n        \"\"\"Orchestrates validation, normalization, computation, and returns sorted unique common elements.\"\"\"\n        self._validator.validate_lists(l1, l2)\n        # In this flow, CommonAPI normalizes lists before passing them to CommonFinder.\n        # CommonFinder then directly uses set() on these normalized lists.\n        n1 = self._repo.normalize(l1)\n        n2 = self._repo.normalize(l2)\n        \n        result = self._finder.find_common(n1, n2)\n        return self._to_list_repr(result)\n\n    def _to_list_repr(self, lst: Any) -> List[Any]:\n        \"\"\"Ensures the result is a plain list for consistent output.\"\"\"\n        return list(lst)\n\n```\n```python\n# src/common_utils/common_finder.py\nfrom typing import List, Any\n# ListRepository is not directly used here as CommonAPI normalizes inputs.\n# However, if CommonFinder needed to convert to set from raw list, it would use ListRepository.to_set.\n\nclass CommonFinder:\n    \"\"\"Computes unique, sorted intersection of two lists.\"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the CommonFinder.\"\"\"\n        pass\n\n    def find_common(self, l1: List[Any], l2: List[Any]) -> List[Any]:\n        \"\"\"Finds unique common elements between two lists and returns them sorted.\"\"\"\n        s1 = set(l1)\n        s2 = set(l2)\n        common_elements = s1.intersection(s2)\n        return sorted(list(common_elements))\n\n```\n```python\n# src/common_utils/list_repository.py\nfrom typing import List, Any, Set\n\nclass ListRepository:\n    \"\"\"Handles list normalization and set conversion.\"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the ListRepository.\"\"\"\n        pass\n\n    def normalize(self, lst: List[Any]) -> List[Any]:\n        \"\"\"Returns a new list from the input, ensuring it's a mutable list representation.\"\"\"\n        return list(lst)\n\n    def to_set(self, lst: List[Any]) -> Set[Any]:\n        \"\"\"Converts a list to a set, for efficient uniqueness and intersection operations.\"\"\"\n        return set(lst)\n\n```\n```python\n# src/common_utils/validator.py\nfrom typing import Any, Sequence\nfrom .exceptions import InvalidInputError\n\nclass Validator:\n    \"\"\"Validates input lists for iterability and element comparability.\"\"\"\n\n    MAX_SAMPLE_COMPARE: int = 100\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the Validator.\"\"\"\n        pass\n\n    def validate_lists(self, l1: Any, l2: Any) -> None:\n        \"\"\"Ensures both inputs are iterable and their elements are comparable.\"\"\"\n        self._check_iterable(l1, \"l1\")\n        self._check_iterable(l2, \"l2\")\n\n        sample_elements: List[Any] = []\n        # Sample elements from both lists to check comparability\n        for lst_name, lst_value in [(\"l1\", l1), (\"l2\", l2)]:\n            try:\n                it = iter(lst_value)\n                for _ in range(self.MAX_SAMPLE_COMPARE):\n                    try:\n                        sample_elements.append(next(it))\n                    except StopIteration:\n                        break\n            except TypeError as e:\n                raise InvalidInputError(f\"Input '{lst_name}' is not iterable: {e}\")\n\n        self._check_comparability(sample_elements)\n\n    def _check_iterable(self, value: Any, name: str) -> None:\n        \"\"\"Checks if a given value is iterable and not None.\"\"\"\n        if value is None:\n            raise InvalidInputError(f\"Input '{name}' cannot be None.\")\n        try:\n            iter(value)\n        except TypeError as e:\n            raise InvalidInputError(f\"Input '{name}' is not iterable: {e}\")\n\n    def _check_comparability(self, sample_elems: Sequence[Any]) -> None:\n        \"\"\"Attempts to sort a sample of elements to detect comparability issues.\"\"\"\n        if not sample_elems:\n            return # No elements to compare\n\n        try:\n            # Attempt to sort to trigger TypeError if elements are incomparable\n            _ = sorted(list(sample_elems)) # Convert to list just in case sequence is not sortable directly\n        except TypeError as e:\n            raise InvalidInputError(f\"Elements in inputs are not comparable: {e}\")\n\n```\n```python\n# src/common_utils/exceptions.py\nclass CommonUtilsError(Exception):\n    \"\"\"Base exception for all errors in the common_utils library.\"\"\"\n    pass\n\nclass InvalidInputError(CommonUtilsError):\n    \"\"\"Raised when provided inputs are invalid, e.g., not iterable or non-comparable elements.\"\"\"\n    pass\n\n```\n```python\n# src/common_utils/cli.py\nimport argparse\nimport json\nimport sys\nfrom typing import Sequence, Any\n\nfrom .common_api import CommonAPI\nfrom .validator import Validator\nfrom .list_repository import ListRepository\nfrom .common_finder import CommonFinder\nfrom .exceptions import InvalidInputError, CommonUtilsError\n\nclass CLI:\n    \"\"\"Command-Line Interface for the common_utils library.\"\"\"\n\n    def __init__(self, api: CommonAPI) -> None:\n        \"\"\"Initializes the CLI with a CommonAPI instance.\"\"\"\n        self._api = api\n\n    def run(self, argv: Sequence[str]) -> int:\n        \"\"\"Parses arguments, calls CommonAPI, and prints results or errors.\"\"\"\n        try:\n            args = self._parse_args(argv)\n            \n            # CLI input is always strings; conversion logic depends on expected element types.\n            # For this simple CLI, we pass strings as they are, letting `set()` handle them.\n            list_a = [x.strip() for x in args.a.split(\",\") if x.strip()]\n            list_b = [x.strip() for x in args.b.split(\",\") if x.strip()]\n\n            result = self._api.common(list_a, list_b)\n            print(json.dumps(result))\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: Invalid input: {e}\", file=sys.stderr)\n            return 1\n        except CommonUtilsError as e:\n            print(f\"An application error occurred: {e}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n    def _parse_args(self, argv: Sequence[str]) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments using argparse.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute sorted, unique common elements between two comma-separated lists.\"\n        )\n        parser.add_argument(\n            \"--a\",\n            type=str,\n            required=True,\n            help=\"Comma-separated string representing the first list (e.g., '1,2,3')\"\n        )\n        parser.add_argument(\n            \"--b\",\n            type=str,\n            required=True,\n            help=\"Comma-separated string representing the second list (e.g., '3,4,5')\"\n        )\n        return parser.parse_args(argv)\n\ndef main(argv: Sequence[str] = sys.argv[1:]) -> int:\n    \"\"\"Entry point for the common_utils CLI.\"\"\"\n    validator = Validator()\n    repo = ListRepository()\n    finder = CommonFinder()\n    api = CommonAPI(validator, repo, finder)\n    cli = CLI(api)\n    return cli.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n```python\n# src/common_utils/user.py\nfrom typing import List, Any\nfrom .common_api import CommonAPI\n\nclass User:\n    \"\"\"Auxiliary class representing a user interacting with the CommonAPI.\"\"\"\n\n    def __init__(self, name: str) -> None:\n        \"\"\"Initializes the User with a name.\"\"\"\n        self.name = name\n\n    def request_common(self, api: CommonAPI, l1: List[Any], l2: List[Any]) -> List[Any]:\n        \"\"\"Requests common elements from the CommonAPI and returns the result.\"\"\"\n        print(f\"{self.name} is requesting common elements for {l1} and {l2}.\")\n        result = api.common(l1, l2)\n        print(f\"{self.name} received result: {result}\")\n        return result\n\n```\n```python\n# requirements.txt\npytest>=7.0\n```"}
