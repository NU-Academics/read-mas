{"task_id": "HumanEval/49", "solution": "```python\n# pyproject.toml\n# Build metadata, dependencies, and entry points for the project.\n[project]\nname = \"modp-app\"\nversion = \"0.1.0\"\ndescription = \"Modular exponentiation service\"\nauthors = [\n    {name = \"Your Name\", email = \"you@example.com\"},\n]\ndependencies = [\n    \"Flask>=2.0.0\", # Required for the HTTP API component\n]\nrequires-python = \">=3.9\"\n\n[project.scripts]\nmodp-cli = \"modp_app.cli:main\" # Defines the command-line entry point\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"] # Tells setuptools to look for packages in the 'src' directory\n\n[tool.setuptools.package-dir]\nmodp_app = \"src/modp_app\" # Maps the 'modp_app' package to 'src/modp_app'\n\n[tool.setuptools]\npackage-dir = {\"\" = \"src\"}\n```\n\n```python\n# src/modp_app/__init__.py\n# Package exports for convenient top-level import.\nfrom .api import modp\n```\n\n```python\n# src/modp_app/errors.py\n# Defines custom exception classes for application-specific error handling.\nclass ModpError(Exception):\n    \"\"\"Base exception for all application-specific errors.\"\"\"\n    pass\n\nclass ValidationError(ModpError):\n    \"\"\"Raised for invalid input parameters to indicate data issues.\"\"\"\n    def __init__(self, message: str, field: str | None = None):\n        super().__init__(message)\n        self.field = field\n        self.message = message\n\nclass CacheError(ModpError):\n    \"\"\"Raised for issues encountered during cache operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass ServiceError(ModpError):\n    \"\"\"Raised for internal service logic failures or unexpected conditions.\"\"\"\n    def __init__(self, message: str, original_exception: Exception | None = None):\n        super().__init__(message)\n        self.message = message\n        self.original_exception = original_exception\n```\n\n```python\n# src/modp_app/services/config.py\nimport os\n# Manages runtime configuration settings, supporting environment variable overrides.\nclass Config:\n    \"\"\"Application configuration, loading defaults or environment variables.\"\"\"\n    MAX_N_BITS_DEFAULT: int = 1_000_000\n    CACHE_ENABLED_DEFAULT: bool = False\n    CACHE_BACKEND_DEFAULT: str = \"memory\"\n    CACHE_PATH_DEFAULT: str = os.path.expanduser(\"~/.cache/modp_cache.json\")\n\n    def __init__(self, max_n_bits: int, cache_enabled: bool, cache_backend: str, cache_path: str):\n        self.max_n_bits = max_n_bits\n        self.cache_enabled = cache_enabled\n        self.cache_backend = cache_backend\n        self.cache_path = cache_path\n\n    @classmethod\n    def from_env(cls) -> \"Config\":\n        \"\"\"Constructs a Config instance by reading from environment variables.\"\"\"\n        max_n_bits = int(os.environ.get(\"MODP_MAX_N_BITS\", cls.MAX_N_BITS_DEFAULT))\n        cache_enabled = os.environ.get(\"MODP_CACHE_ENABLED\", str(cls.CACHE_ENABLED_DEFAULT)).lower() == \"true\"\n        cache_backend = os.environ.get(\"MODP_CACHE_BACKEND\", cls.CACHE_BACKEND_DEFAULT)\n        cache_path = os.environ.get(\"MODP_CACHE_PATH\", cls.CACHE_PATH_DEFAULT)\n        return cls(max_n_bits, cache_enabled, cache_backend, cache_path)\n```\n\n```python\n# src/modp_app/validators/input_validator.py\nfrom ..errors import ValidationError\n\n# Validates and coerces input parameters `n` and `p`.\nclass InputValidator:\n    \"\"\"Validates inputs for modular exponentiation against defined rules.\"\"\"\n    def __init__(self, max_n_bits: int = 1_000_000):\n        self.max_n_bits = max_n_bits\n\n    def validate_n_p(self, n: object, p: object) -> tuple[int, int]:\n        \"\"\"Converts n and p to integers and checks their validity and range.\"\"\"\n        try:\n            n_i = int(n)\n            p_i = int(p)\n        except (TypeError, ValueError) as e:\n            raise ValidationError(message=f\"Inputs n and p must be valid integers: {e}\")\n\n        if n_i < 0:\n            raise ValidationError(field=\"n\", message=\"n must be a non-negative integer.\")\n        if p_i <= 1:\n            raise ValidationError(field=\"p\", message=\"p must be an integer greater than 1.\")\n        \n        if n_i.bit_length() > self.max_n_bits:\n            raise ValidationError(field=\"n\", message=f\"n is too large; max bit length is {self.max_n_bits}.\")\n        \n        return n_i, p_i\n```\n\n```python\n# src/modp_app/core/calculator.py\n# Performs the core modular exponentiation computation.\nclass ModExpCalculator:\n    \"\"\"Calculates 2^n modulo p efficiently and safely.\"\"\"\n    def compute(self, n: int, p: int) -> int:\n        \"\"\"Uses Python's built-in 3-argument pow for efficient modular exponentiation.\"\"\"\n        return pow(2, n, p)\n```\n\n```python\n# src/modp_app/utils/io_utils.py\nimport json\nimport os\nimport shutil\nimport tempfile\nfrom ..errors import CacheError\n\n# Provides utility functions for safe, atomic JSON file operations.\ndef atomic_write_json(path: str, data: dict) -> None:\n    \"\"\"Writes dictionary data to a JSON file atomically, preventing corruption.\"\"\"\n    try:\n        dirname = os.path.dirname(path) or '.'\n        os.makedirs(dirname, exist_ok=True)\n        \n        # Write to a temporary file in the same directory.\n        with tempfile.NamedTemporaryFile(mode='w', delete=False, dir=dirname, encoding='utf-8') as tmp_file:\n            json.dump(data, tmp_file)\n        \n        # Atomically replace the original file with the temporary one.\n        shutil.move(tmp_file.name, path)\n    except Exception as e:\n        if 'tmp_file' in locals() and os.path.exists(tmp_file.name):\n            os.remove(tmp_file.name)\n        raise CacheError(f\"Failed to write cache file {path}: {e}\")\n\ndef atomic_read_json(path: str) -> dict:\n    \"\"\"Reads JSON data from a file, returning an empty dict if the file is not found.\"\"\"\n    if not os.path.exists(path):\n        return {}\n    try:\n        with open(path, 'r', encoding='utf-8') as f:\n            return json.load(f)\n    except json.JSONDecodeError as e:\n        raise CacheError(f\"Failed to decode cache file {path}: {e}\")\n    except Exception as e:\n        raise CacheError(f\"Failed to read cache file {path}: {e}\")\n```\n\n```python\n# src/modp_app/adapters/cache_repository.py\nfrom abc import ABC, abstractmethod\nfrom typing import Optional\nimport threading # Used for basic thread-safety in cache implementations.\n\nfrom ..errors import CacheError\nfrom ..utils.io_utils import atomic_read_json, atomic_write_json\n\n# Defines the interface for cache repositories and provides concrete implementations.\nclass CacheRepository(ABC):\n    \"\"\"Abstract base class defining the cache repository interface.\"\"\"\n    @abstractmethod\n    def get(self, key: str) -> Optional[int]:\n        \"\"\"Retrieves a cached value using its string key.\"\"\"\n        pass\n\n    @abstractmethod\n    def set(self, key: str, value: int) -> None:\n        \"\"\"Stores a value in the cache associated with a string key.\"\"\"\n        pass\n\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"An in-memory cache implementation, storing data in a dictionary.\"\"\"\n    def __init__(self):\n        self._store: dict[str, int] = {}\n        self._lock = threading.Lock() # Ensures thread-safe access to the cache.\n\n    def get(self, key: str) -> Optional[int]:\n        \"\"\"Returns the value associated with the key from memory, or None if not found.\"\"\"\n        with self._lock:\n            return self._store.get(key)\n\n    def set(self, key: str, value: int) -> None:\n        \"\"\"Stores the given value in the in-memory cache.\"\"\"\n        with self._lock:\n            self._store[key] = value\n\nclass FileCacheRepository(CacheRepository):\n    \"\"\"A file-backed cache implementation that persists data to a JSON file.\"\"\"\n    DEFAULT_CACHE_FILENAME = \"modp_cache.json\"\n\n    def __init__(self, path: str):\n        self._path = path\n        self._store: dict[str, int] = {}\n        self._lock = threading.Lock() # Manages access to the cache file.\n        self._load() # Attempts to load initial cache data from disk.\n\n    def _load(self) -> None:\n        \"\"\"Loads cache data from the specified JSON file.\"\"\"\n        try:\n            with self._lock:\n                raw_data = atomic_read_json(self._path)\n                # Ensure all loaded values are integers\n                self._store = {k: int(v) for k, v in raw_data.items()}\n        except CacheError as e:\n            print(f\"Warning: Could not load cache from {self._path}. Starting with empty cache. Error: {e}\")\n            self._store = {}\n        except Exception as e:\n            print(f\"Warning: Unexpected error loading cache from {self._path}. Starting with empty cache. Error: {e}\")\n            self._store = {}\n\n    def _save(self) -> None:\n        \"\"\"Saves the current cache data to the JSON file atomically.\"\"\"\n        try:\n            with self._lock:\n                atomic_write_json(self._path, self._store)\n        except CacheError as e:\n            print(f\"Warning: Failed to save cache to {self._path}. Cache changes may be lost. Error: {e}\")\n\n    def get(self, key: str) -> Optional[int]:\n        \"\"\"Retrieves a value from the file cache by its key.\"\"\"\n        with self._lock:\n            return self._store.get(key)\n\n    def set(self, key: str, value: int) -> None:\n        \"\"\"Stores a value in the file cache and triggers a persistence save.\"\"\"\n        with self._lock:\n            self._store[key] = value\n            self._save()\n```\n\n```python\n# src/modp_app/services/modp_service.py\nfrom typing import Optional\nimport logging\n\nfrom ..errors import ValidationError, CacheError, ServiceError\nfrom ..validators.input_validator import InputValidator\nfrom ..core.calculator import ModExpCalculator\nfrom ..adapters.cache_repository import CacheRepository\nfrom .config import Config\n\nlogger = logging.getLogger(__name__)\n\n# Orchestrates the modular exponentiation process, including validation and caching.\nclass ModpService:\n    \"\"\"Service for computing 2^n modulo p, integrating validation, calculation, and caching.\"\"\"\n    def __init__(self, validator: InputValidator, calculator: ModExpCalculator,\n                 cache: Optional[CacheRepository], config: Config):\n        self._validator = validator\n        self._calculator = calculator\n        self._cache = cache\n        self._config = config\n\n    def compute(self, n: object, p: object) -> int:\n        \"\"\"Validates inputs, attempts cache lookup, performs computation, and stores results.\"\"\"\n        try:\n            n_validated, p_validated = self._validator.validate_n_p(n, p)\n            cache_key = f\"{n_validated}:{p_validated}\"\n\n            if self._cache and self._config.cache_enabled:\n                cached_result = self._cache.get(cache_key)\n                if cached_result is not None:\n                    logger.debug(f\"Cache hit for {cache_key}\")\n                    return cached_result\n                logger.debug(f\"Cache miss for {cache_key}\")\n\n            result = self._calculator.compute(n_validated, p_validated)\n\n            if self._cache and self._config.cache_enabled:\n                try:\n                    self._cache.set(cache_key, result)\n                    logger.debug(f\"Stored {cache_key}:{result} in cache.\")\n                except CacheError as e:\n                    logger.error(f\"Failed to store result in cache for {cache_key}: {e}\")\n            \n            return result\n        except (ValidationError, CacheError) as e:\n            logger.warning(f\"Operation failed due to specific error for n={n}, p={p}: {e}\")\n            raise e # Re-raise known application-specific errors directly.\n        except Exception as e:\n            logger.exception(f\"An unexpected internal error occurred during computation for n={n}, p={p}.\")\n            raise ServiceError(f\"Internal server error: {e}\", original_exception=e) # Wrap unknown exceptions.\n```\n\n```python\n# src/modp_app/api.py\nfrom typing import Optional\nimport logging\n\nfrom .services.config import Config\nfrom .validators.input_validator import InputValidator\nfrom .core.calculator import ModExpCalculator\nfrom .adapters.cache_repository import CacheRepository, InMemoryCacheRepository, FileCacheRepository\nfrom .services.modp_service import ModpService\n\nlogger = logging.getLogger(__name__)\n\n# Public API functions for direct programmatic use of the modular exponentiation.\ndef _get_cache_repository(config: Config) -> Optional[CacheRepository]:\n    \"\"\"Helper function to instantiate the correct cache repository based on configuration.\"\"\"\n    if not config.cache_enabled:\n        return None\n    \n    if config.cache_backend == \"memory\":\n        return InMemoryCacheRepository()\n    elif config.cache_backend == \"file\":\n        try:\n            return FileCacheRepository(config.cache_path)\n        except CacheError as e:\n            logger.error(f\"Could not initialize FileCacheRepository at {config.cache_path}: {e}. Falling back to in-memory cache.\")\n            return InMemoryCacheRepository()\n    else:\n        logger.warning(f\"Unknown cache backend '{config.cache_backend}'. Falling back to in-memory cache.\")\n        return InMemoryCacheRepository()\n\ndef modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function acts as the public entry point for the library, setting up the service stack.\n    It automatically configures validation, calculation, and caching based on environment.\n    \"\"\"\n    config = Config.from_env()\n    validator = InputValidator(max_n_bits=config.max_n_bits)\n    calculator = ModExpCalculator()\n    cache = _get_cache_repository(config)\n    service = ModpService(validator, calculator, cache, config)\n    return service.compute(n, p)\n```\n\n```python\n# src/modp_app/cli.py\nimport argparse\nimport sys\nimport logging\n\nfrom .services.config import Config\nfrom .validators.input_validator import InputValidator\nfrom .core.calculator import ModExpCalculator\nfrom .services.modp_service import ModpService\nfrom .errors import ModpError, ValidationError\nfrom .api import _get_cache_repository # Re-use internal helper for cache setup\n\nlogger = logging.getLogger(__name__)\n\n# CLI entry point parsing arguments, calling the service, and printing results.\nclass CLIController:\n    \"\"\"Handles parsing CLI arguments and executing the modular exponentiation service.\"\"\"\n    def __init__(self, service: ModpService):\n        self._service = service\n\n    def _parse_args(self, argv: list[str]) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments using argparse.\"\"\"\n        parser = argparse.ArgumentParser(description=\"Compute 2^n modulo p.\")\n        parser.add_argument(\"--n\", type=str, required=True, help=\"The exponent n (non-negative integer).\")\n        parser.add_argument(\"--p\", type=str, required=True, help=\"The modulus p (integer > 1).\")\n        parser.add_argument(\"--cache-backend\", choices=[\"memory\", \"file\"], \n                            help=f\"Cache backend type (default: {Config.CACHE_BACKEND_DEFAULT}). Overrides MODP_CACHE_BACKEND.\")\n        parser.add_argument(\"--cache-path\", type=str, \n                            help=f\"Path for file cache (default: {Config.CACHE_PATH_DEFAULT}). Overrides MODP_CACHE_PATH.\")\n        parser.add_argument(\"--max-n-bits\", type=int, \n                            help=f\"Maximum allowed bit length for n (default: {Config.MAX_N_BITS_DEFAULT}). Overrides MODP_MAX_N_BITS.\")\n        parser.add_argument(\"--enable-cache\", action=\"store_true\", \n                            help=f\"Enable caching (default: {Config.CACHE_ENABLED_DEFAULT}). Overrides MODP_CACHE_ENABLED.\")\n        parser.add_argument(\"--disable-cache\", action=\"store_true\", \n                            help=\"Explicitly disable caching. Overrides MODP_CACHE_ENABLED and --enable-cache.\")\n        return parser.parse_args(argv)\n\n    def run(self, argv: list[str]) -> int:\n        \"\"\"Executes the CLI command, handling argument parsing and error reporting.\"\"\"\n        args = self._parse_args(argv)\n\n        # Create a new Config instance for this run, applying CLI overrides.\n        current_config = Config.from_env()\n        if args.max_n_bits is not None:\n            current_config.max_n_bits = args.max_n_bits\n        if args.enable_cache:\n            current_config.cache_enabled = True\n        if args.disable_cache:\n            current_config.cache_enabled = False\n        if args.cache_backend is not None:\n            current_config.cache_backend = args.cache_backend\n        if args.cache_path is not None:\n            current_config.cache_path = args.cache_path\n        \n        # Instantiate a new service with the potentially updated config.\n        validator = InputValidator(max_n_bits=current_config.max_n_bits)\n        calculator = ModExpCalculator()\n        cache = _get_cache_repository(current_config)\n        service_for_this_run = ModpService(validator, calculator, cache, current_config)\n\n        try:\n            result = service_for_this_run.compute(args.n, args.p)\n            print(result)\n            return 0 # Success exit code\n        except ValidationError as e:\n            print(f\"Error: Invalid input: {e.message}\", file=sys.stderr)\n            return 1 # General error exit code for bad input\n        except ModpError as e: # Catch other custom application errors\n            print(f\"Error: An application error occurred: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"Error: An unexpected internal error occurred: {e}\", file=sys.stderr)\n            return 2 # General failure exit code\n\ndef main(argv: list[str] | None = None) -> int:\n    \"\"\"Main entry point for the CLI tool script.\"\"\"\n    logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')\n\n    # A default service instance can be created here, but the CLIController\n    # will re-create one if CLI-specific config overrides are provided.\n    initial_config = Config.from_env()\n    initial_validator = InputValidator(max_n_bits=initial_config.max_n_bits)\n    initial_calculator = ModExpCalculator()\n    initial_cache = _get_cache_repository(initial_config)\n    initial_service = ModpService(initial_validator, initial_calculator, initial_cache, initial_config)\n    \n    controller = CLIController(initial_service)\n    return controller.run(argv or sys.argv[1:])\n```\n\n```python\n# src/modp_app/http.py\nfrom flask import Flask, request, jsonify, Response\nimport logging\n\nfrom .services.config import Config\nfrom .validators.input_validator import InputValidator\nfrom .core.calculator import ModExpCalculator\nfrom .services.modp_service import ModpService\nfrom .errors import ValidationError, ModpError, ServiceError\nfrom .api import _get_cache_repository # Re-use internal helper for cache setup\n\nlogger = logging.getLogger(__name__)\n\n# Provides a Flask application factory to expose the modular exponentiation via HTTP.\nclass HTTPController:\n    \"\"\"Manages HTTP requests and responses for the modular exponentiation endpoint.\"\"\"\n    def __init__(self, service: ModpService):\n        self._service = service\n\n    def create_app(self) -> Flask:\n        \"\"\"Creates and configures a Flask application instance.\"\"\"\n        app = Flask(__name__)\n        app.add_url_rule(\"/compute\", methods=[\"POST\"], view_func=self._handle_compute)\n        \n        logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n        \n        return app\n\n    def _handle_compute(self) -> Response:\n        \"\"\"Processes POST /compute requests, validates input, and returns results.\"\"\"\n        if not request.is_json:\n            return jsonify({\"error\": \"Request must be JSON\"}), 400\n        \n        data = request.get_json()\n        n = data.get(\"n\")\n        p = data.get(\"p\")\n\n        try:\n            result = self._service.compute(n, p)\n            logger.info(f\"Successfully computed 2^{n} mod {p} = {result}\")\n            return jsonify({\"result\": result}), 200\n        except ValidationError as e:\n            logger.warning(f\"HTTP 400: Validation error for n={n}, p={p}: {e.message}\")\n            return jsonify({\"error\": e.message}), 400\n        except ModpError as e:\n            logger.error(f\"HTTP 500: Service error for n={n}, p={p}: {e.message}\", exc_info=True)\n            return jsonify({\"error\": e.message}), 500\n        except Exception as e:\n            logger.exception(f\"HTTP 500: Unhandled exception for n={n}, p={p}.\")\n            return jsonify({\"error\": \"An unexpected internal server error occurred.\"}), 500\n\ndef create_app_factory() -> Flask:\n    \"\"\"Factory function to instantiate and return the Flask application.\"\"\"\n    config = Config.from_env()\n    validator = InputValidator(max_n_bits=config.max_n_bits)\n    calculator = ModExpCalculator()\n    cache = _get_cache_repository(config)\n    service = ModpService(validator, calculator, cache, config)\n    controller = HTTPController(service)\n    return controller.create_app()\n```"}
{"task_id": "HumanEval/50", "solution": "```python\n# pyproject.toml\n[project]\nname = \"shiftcipher\"\nversion = \"0.1.0\"\ndescription = \"A small Python library and CLI to encode/decode strings using a shift cipher.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\n\n[project.scripts]\nshiftcipher = \"shiftcipher.cli:main\"\n\n[build-system]\nrequires = [\"poetry-core>=1.0.0\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.pytest.ini_options]\nmin_version = \"6.0\"\naddopts = \"--cov=shiftcipher --cov-report=term-missing --cov-fail-under=90\"\n\n[tool.coverage.run]\nsource = [\"shiftcipher\"]\nbranch = true\nomit = [\"shiftcipher/cli.py\"]\n\n[tool.poetry]\nname = \"shiftcipher\"\nversion = \"0.1.0\"\ndescription = \"A small Python library and CLI to encode/decode strings using a shift cipher.\"\nauthors = [\"Your Name <your.email@example.com>\"]\n\n[tool.poetry.dependencies]\npython = \">=3.8\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^7.0\"\npytest-cov = \"^4.0\"\n```\n\n```python\n# README.md\n# Shift Cipher Library and CLI\n\nA simple Python library and command-line interface (CLI) to encode and decode strings using a Caesar cipher with a fixed shift of 5. It also provides a persistent history of operations.\n\n## Features\n\n- **Library**: Easily integrate encoding and decoding into other Python projects.\n- **CLI**: Transform text directly from your terminal.\n- **History**: Audit past encode/decode operations with a local persistent log.\n- **Validation**: Ensures only lowercase alphabetic characters are processed.\n\n## Installation\n\n```bash\n# Recommended: Use poetry\npoetry install\n\n# Or install with pip\npip install shiftcipher # (if published to PyPI)\n```\n\n## Usage\n\n### Command Line Interface (CLI)\n\nEncode text:\n```bash\nshiftcipher encode \"hello\"\n# Output: mjqqt\n```\n\nDecode text:\n```bash\nshiftcipher decode \"mjqqt\"\n# Output: hello\n```\n\nView history (last 100 operations by default):\n```bash\nshiftcipher history\n```\n\n### Python Library\n\n```python\nfrom shiftcipher.services import CipherService\nfrom shiftcipher.encoders import EncoderAdapter\nfrom shiftcipher.repository import Repository\nfrom shiftcipher.utils import Validator\nfrom shiftcipher.exceptions import ValidationError, RepositoryError\n\n# Initialize components\nvalidator = Validator()\nencoder = EncoderAdapter()\nrepository = Repository() # Uses default history file path\n\nservice = CipherService(encoder=encoder, repo=repository, validator=validator)\n\ntry:\n    encoded_text = service.encode(\"hello\")\n    print(f\"Encoded: {encoded_text}\") # Output: mjqqt\n\n    decoded_text = service.decode(\"mjqqt\")\n    print(f\"Decoded: {decoded_text}\") # Output: hello\n\n    history = service.get_history(limit=5)\n    for record in history:\n        print(f\"[{record.timestamp}] {record.operation}: {record.input_text} -> {record.output_text}\")\n\nexcept ValidationError as e:\n    print(f\"Error: {e}\")\nexcept RepositoryError as e:\n    print(f\"History persistence error: {e}\")\n```\n\n```python\n# src/shiftcipher/__init__.py\nfrom .encoders import EncoderAdapter\nfrom .exceptions import EncodingError, RepositoryError, ValidationError\nfrom .models import HistoryRecord, TextModel\nfrom .repository import Repository\nfrom .services import CipherService\nfrom .utils import Validator\n\n__all__ = [\n    \"EncoderAdapter\",\n    \"EncodingError\",\n    \"RepositoryError\",\n    \"ValidationError\",\n    \"HistoryRecord\",\n    \"TextModel\",\n    \"Repository\",\n    \"CipherService\",\n    \"Validator\",\n]\n```\n\n```python\n# src/shiftcipher/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for repository-related issues.\"\"\"\n    pass\n\nclass EncodingError(Exception):\n    \"\"\"Exception raised for issues during encoding/decoding.\"\"\"\n    pass\n```\n\n```python\n# src/shiftcipher/models.py\nimport datetime\nimport uuid\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass HistoryRecord:\n    \"\"\"Represents a persisted transformation record.\"\"\"\n    id: str\n    operation: str\n    input_text: str\n    output_text: str\n    timestamp: str\n\n    @classmethod\n    def create(cls, operation: str, input_text: str, output_text: str) -> \"HistoryRecord\":\n        \"\"\"Factory method to create a new HistoryRecord.\"\"\"\n        return cls(\n            id=str(uuid.uuid4()),\n            operation=operation,\n            input_text=input_text,\n            output_text=output_text,\n            timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),\n        )\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the HistoryRecord to a dictionary.\"\"\"\n        return self.__dict__\n\n    @classmethod\n    def from_dict(cls, d: dict) -> \"HistoryRecord\":\n        \"\"\"Creates a HistoryRecord from a dictionary.\"\"\"\n        return cls(**d)\n\n@dataclass\nclass TextModel:\n    \"\"\"Represents a text input.\"\"\"\n    text: str\n```\n\n```python\n# src/shiftcipher/utils.py\nfrom .exceptions import ValidationError\n\nclass Validator:\n    \"\"\"Provides utility methods for input validation and normalization.\"\"\"\n    \n    def validate_lowercase(self, s: str) -> bool:\n        \"\"\"Returns True if the string consists only of lowercase a-z characters and is non-empty.\"\"\"\n        if not s:\n            return False\n        return s.islower() and s.isalpha()\n\n    def normalize(self, s: str) -> str:\n        \"\"\"Converts the string to lowercase and strips leading/trailing whitespace.\"\"\"\n        return s.strip().lower()\n```\n\n```python\n# src/shiftcipher/encoders.py\nDEFAULT_SHIFT: int = 5\nALPHABET_START: int = ord(\"a\")\nALPHABET_SIZE: int = 26\n\nclass EncoderAdapter:\n    \"\"\"Implements the core shift cipher logic for encoding and decoding.\"\"\"\n\n    def encode_shift(self, s: str) -> str:\n        \"\"\"Returns the encoded string by shifting every character by 5 in the alphabet.\"\"\"\n        return \"\".join([\n            chr(((ord(ch) + DEFAULT_SHIFT - ALPHABET_START) % ALPHABET_SIZE) + ALPHABET_START)\n            for ch in s\n        ])\n\n    def decode_shift(self, s: str) -> str:\n        \"\"\"Returns the decoded string, reversing the shift operation.\"\"\"\n        return \"\".join([\n            chr(((ord(ch) - DEFAULT_SHIFT - ALPHABET_START) % ALPHABET_SIZE) + ALPHABET_START)\n            for ch in s\n        ])\n```\n\n```python\n# src/shiftcipher/repository.py\nimport json\nimport os\nfrom typing import List\n\nfrom .exceptions import RepositoryError\nfrom .models import HistoryRecord\n\nDEFAULT_HISTORY_PATH: str = \"~/.shiftcipher/history.json\"\n\nclass Repository:\n    \"\"\"Manages persistence of history records to a JSON file.\"\"\"\n\n    def __init__(self, path: str = DEFAULT_HISTORY_PATH):\n        \"\"\"Initializes the repository with a history file path.\"\"\"\n        self.path = os.path.expanduser(path)\n\n    def save(self, record: HistoryRecord) -> None:\n        \"\"\"Appends a history record to the JSON file.\"\"\"\n        os.makedirs(os.path.dirname(self.path), exist_ok=True)\n        line = json.dumps(record.to_dict(), ensure_ascii=False)\n        try:\n            with open(self.path, \"a\", encoding=\"utf-8\") as f:\n                f.write(line + \"\\n\")\n        except OSError as e:\n            raise RepositoryError(\"Could not write history to file.\") from e\n        except TypeError as e:\n            raise RepositoryError(\"Invalid record format for serialization.\") from e\n\n    def list(self, limit: int = 100) -> List[HistoryRecord]:\n        \"\"\"Reads and returns the most recent history entries.\"\"\"\n        records: List[HistoryRecord] = []\n        try:\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                for line in f:\n                    try:\n                        data = json.loads(line)\n                        records.append(HistoryRecord.from_dict(data))\n                    except json.JSONDecodeError:\n                        # Skip corrupted lines\n                        continue\n        except FileNotFoundError:\n            return []\n        except OSError as e:\n            raise RepositoryError(\"Could not read history file.\") from e\n        \n        return records[-limit:]\n```\n\n```python\n# src/shiftcipher/services.py\nfrom typing import List\n\nfrom .encoders import EncoderAdapter\nfrom .exceptions import RepositoryError, ValidationError\nfrom .models import HistoryRecord\nfrom .repository import Repository\nfrom .utils import Validator\n\nclass CipherService:\n    \"\"\"Orchestrates validation, encoding/decoding, and history persistence.\"\"\"\n\n    def __init__(self, encoder: EncoderAdapter, repo: Repository, validator: Validator):\n        \"\"\"Initializes the service with required adapters and validators.\"\"\"\n        self.encoder = encoder\n        self.repo = repo\n        self.validator = validator\n\n    def encode(self, text: str) -> str:\n        \"\"\"Validates input, encodes the text, and persists the operation history.\"\"\"\n        if not self.validator.validate_lowercase(text):\n            raise ValidationError(\"Input must consist only of lowercase a-z characters.\")\n        \n        output_text = self.encoder.encode_shift(text)\n        record = HistoryRecord.create(\"encode\", text, output_text)\n        try:\n            self.repo.save(record)\n        except RepositoryError:\n            # Re-raise to indicate persistence failure, but the output is still returned.\n            raise \n        return output_text\n\n    def decode(self, text: str) -> str:\n        \"\"\"Validates input, decodes the text, and persists the operation history.\"\"\"\n        if not self.validator.validate_lowercase(text):\n            raise ValidationError(\"Input must consist only of lowercase a-z characters.\")\n        \n        output_text = self.encoder.decode_shift(text)\n        record = HistoryRecord.create(\"decode\", text, output_text)\n        try:\n            self.repo.save(record)\n        except RepositoryError:\n            # Re-raise to indicate persistence failure, but the output is still returned.\n            raise\n        return output_text\n\n    def get_history(self, limit: int = 100) -> List[HistoryRecord]:\n        \"\"\"Retrieves a list of recent history records.\"\"\"\n        try:\n            return self.repo.list(limit)\n        except RepositoryError:\n            # Log this error in a real app\n            return []\n```\n\n```python\n# src/shiftcipher/cli.py\nimport argparse\nimport sys\nfrom typing import List\n\nfrom .encoders import EncoderAdapter\nfrom .exceptions import RepositoryError, ValidationError\nfrom .repository import Repository\nfrom .services import CipherService\nfrom .utils import Validator\n\nclass CLIController:\n    \"\"\"Manages command-line interface operations for the shift cipher.\"\"\"\n\n    def __init__(self, service: CipherService, validator: Validator):\n        \"\"\"Initializes the CLI controller with the cipher service and validator.\"\"\"\n        self.service = service\n        self.validator = validator\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments and executes the corresponding command.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"shiftcipher\",\n            description=\"Encode or decode text using a shift cipher and view history.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        # Encode command\n        encode_parser = subparsers.add_parser(\"encode\", help=\"Encode text\")\n        encode_parser.add_argument(\"text\", type=str, help=\"The text to encode (must be lowercase a-z).\")\n\n        # Decode command\n        decode_parser = subparsers.add_parser(\"decode\", help=\"Decode text\")\n        decode_parser.add_argument(\"text\", type=str, help=\"The text to decode (must be lowercase a-z).\")\n        \n        # History command\n        history_parser = subparsers.add_parser(\"history\", help=\"Show transformation history.\")\n        history_parser.add_argument(\n            \"-l\", \"--limit\", type=int, default=10, \n            help=\"Limit the number of history entries displayed (default: 10).\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.command == \"encode\":\n            return self._encode_cmd(args.text)\n        elif args.command == \"decode\":\n            return self._decode_cmd(args.text)\n        elif args.command == \"history\":\n            return self._history_cmd(args.limit)\n        else:\n            parser.print_help()\n            return 2 # Indicate missing command or invalid usage\n\n    def _encode_cmd(self, text: str) -> int:\n        \"\"\"Handles the 'encode' command.\"\"\"\n        try:\n            encoded_text = self.service.encode(text)\n            print(encoded_text)\n            return 0\n        except ValidationError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 1\n        except RepositoryError as e:\n            print(f\"Warning: History not saved. {e}\", file=sys.stderr)\n            return 0 # Still return 0 as transformation succeeded\n\n    def _decode_cmd(self, text: str) -> int:\n        \"\"\"Handles the 'decode' command.\"\"\"\n        try:\n            decoded_text = self.service.decode(text)\n            print(decoded_text)\n            return 0\n        except ValidationError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 1\n        except RepositoryError as e:\n            print(f\"Warning: History not saved. {e}\", file=sys.stderr)\n            return 0 # Still return 0 as transformation succeeded\n\n    def _history_cmd(self, limit: int) -> int:\n        \"\"\"Handles the 'history' command.\"\"\"\n        try:\n            history_records = self.service.get_history(limit)\n            if not history_records:\n                print(\"No history available.\")\n            else:\n                for record in history_records:\n                    print(\n                        f\"[{record.timestamp[:19]}] {record.operation.upper()}: \"\n                        f\"'{record.input_text}' -> '{record.output_text}'\"\n                    )\n            return 0\n        except RepositoryError as e:\n            print(f\"Error reading history: {e}\", file=sys.stderr)\n            return 1\n\ndef main():\n    \"\"\"Entry point for the shiftcipher console script.\"\"\"\n    validator = Validator()\n    encoder = EncoderAdapter()\n    repository = Repository()\n    service = CipherService(encoder=encoder, repo=repository, validator=validator)\n    cli_controller = CLIController(service=service, validator=validator)\n    sys.exit(cli_controller.run(sys.argv[1:]))\n\n```"}
{"task_id": "HumanEval/50", "solution": "To implement the software design specification, I will generate the required files with their respective content.\n\n```markdown\n# pyproject.toml\n[tool.poetry]\nname = \"shift-cipher\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI for Caesar-style fixed shift cipher with optional HTTP API.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"shift_cipher\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \"^3.9\"\nfastapi = { version = \"^0.111.0\", optional = true }\nuvicorn = { version = \"^0.30.1\", optional = true }\npydantic = \"^2.0\" # Required by FastAPI\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\nblack = \"^24.4.2\"\nisort = \"^5.13.2\"\nflake8 = \"^7.1.0\"\n\n[tool.poetry.extras]\napi = [\"fastapi\", \"uvicorn\"]\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry.scripts]\nshift-cipher = \"shift_cipher.cli:main\"\n\n[tool.black]\nline-length = 100\n\n[tool.isort]\nprofile = \"black\"\nline_length = 100\n```\n\n```markdown\n# README.md\n# Shift Cipher Project\n\nThis project provides a reliable, testable Python library and CLI for encoding and decoding strings using a Caesar-style fixed shift cipher. It also includes an optional HTTP API for integration with other systems and persists operations for auditing.\n\n## Features\n\n- **Library**: Python functions for encoding and decoding.\n- **CLI**: Command-line interface for quick transformations.\n- **HTTP API**: RESTful API using FastAPI for programmatic access.\n- **Persistence**: Records all encode/decode operations to an in-memory store or a file.\n- **Configurable**: Default shift value and persistence options.\n\n## Installation\n\n### Using Poetry (recommended)\n\n```bash\npoetry install\npoetry shell\n```\n\nTo install with API dependencies:\n```bash\npoetry install --extras \"api\"\npoetry shell\n```\n\n### Using pip\n\n```bash\npip install .\n# Or for API:\npip install \".[api]\"\n```\n\n## Usage\n\n### Library\n\n```python\nfrom shift_cipher.services import CipherService\nfrom shift_cipher.repository import InMemoryRepository\n\nrepo = InMemoryRepository()\ncipher_service = CipherService(repo=repo, shift=3) # Default shift can be overridden\n\nencoded_text = cipher_service.encode(\"hello\")\nprint(f\"Encoded: {encoded_text}\") # Output: Encoded: khoor\n\ndecoded_text = cipher_service.decode(\"khoor\")\nprint(f\"Decoded: {decoded_text}\") # Output: Decoded: hello\n\n# With custom shift\nencoded_custom = cipher_service.encode(\"abc\", shift=1)\nprint(f\"Encoded with shift 1: {encoded_custom}\") # Output: Encoded with shift 1: bcd\n```\n\n### CLI\n\nThe CLI is available via `shift-cipher` command or `python -m shift_cipher`.\n\n**Encode:**\n```bash\nshift-cipher encode hello\n# Output: mjqqt\n\nshift-cipher encode hello --shift 3\n# Output: khoor\n\nshift-cipher encode hello --no-persist\n# Output: mjqqt (operation will not be saved)\n```\n\n**Decode:**\n```bash\nshift-cipher decode mjqqt\n# Output: hello\n\nshift-cipher decode khoor --shift 3\n# Output: hello\n```\n\n**History (future feature - persistence works, but CLI retrieval not yet implemented)**\nFor now, you can inspect the file used by `FileRepository` directly.\n\n### HTTP API\n\nFirst, ensure you have the API dependencies installed:\n`poetry install --extras \"api\"`\n\nRun the API server:\n```bash\nuvicorn shift_cipher.api:create_app --factory --reload --port 8000\n```\nBy default, the API uses an `InMemoryRepository`. To use `FileRepository`, you might modify `api.py` or set up an environment variable (not yet implemented in default `api.py` wiring, but the `FileRepository` is available).\n\n**Endpoints:**\n\n**1. POST /encode**\n```bash\ncurl -X POST http://127.0.0.1:8000/encode \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"text\": \"hello\"}'\n# Response: {\"result\":\"mjqqt\"}\n\ncurl -X POST http://127.0.0.1:8000/encode \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"text\": \"hello\", \"shift\": 3}'\n# Response: {\"result\":\"khoor\"}\n```\n\n**2. POST /decode**\n```bash\ncurl -X POST http://127.0.0.1:8000/decode \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"text\": \"mjqqt\"}'\n# Response: {\"result\":\"hello\"}\n\ncurl -X POST http://127.0.0.1:8000/decode \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"text\": \"khoor\", \"shift\": 3}'\n# Response: {\"result\":\"hello\"}\n```\n\n## Design and Architecture\n\nRefer to the design document for a full overview of the architecture, components, and data flows.\n\n## Development\n\n### Running Tests\n\n```bash\npytest tests/\n```\n\n### Linting & Formatting\n\n```bash\nblack src/ tests/\nisort src/ tests/\nflake8 src/ tests/\n```\n```markdown\n# LICENSE\nMIT License\n\nCopyright (c) [Year] [Your Name]\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n\n```python\n# src/shift_cipher/__init__.py\n\"\"\"Shift Cipher library and CLI.\"\"\"\n\n__version__ = \"0.1.0\"\n```\n\n```python\n# src/shift_cipher/config.py\n\"\"\"Configuration constants and runtime overrides.\"\"\"\n\nclass Config:\n    \"\"\"Manages global configuration settings for the cipher.\"\"\"\n\n    DEFAULT_SHIFT: int = 5\n    ALPHABET_SIZE: int = 26\n    API_KEY_HEADER: str = \"X-API-Key\"\n\n    _current_default_shift: int = DEFAULT_SHIFT\n\n    @classmethod\n    def get_default_shift(cls) -> int:\n        \"\"\"Returns the current default shift value.\"\"\"\n        return cls._current_default_shift\n\n    @classmethod\n    def set_default_shift(cls, shift: int) -> None:\n        \"\"\"Sets a new default shift value, validating it as an integer.\"\"\"\n        if not isinstance(shift, int):\n            raise ValueError(\"Shift must be an integer.\")\n        cls._current_default_shift = shift % cls.ALPHABET_SIZE\n```\n\n```python\n# src/shift_cipher/exceptions.py\n\"\"\"Custom exceptions for the shift cipher application.\"\"\"\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n\n    def __init__(self, message: str = \"Invalid input provided.\"):\n        \"\"\"Initializes with a specific error message.\"\"\"\n        self.message = message\n        super().__init__(self.message)\n\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for errors during repository operations.\"\"\"\n\n    def __init__(self, message: str = \"Repository operation failed.\"):\n        \"\"\"Initializes with a specific error message.\"\"\"\n        self.message = message\n        super().__init__(self.message)\n```\n\n```python\n# src/shift_cipher/models.py\n\"\"\"Domain data models for the shift cipher application.\"\"\"\n\nfrom dataclasses import dataclass\nfrom uuid import uuid4\n\nfrom shift_cipher.exceptions import InvalidInputError\nfrom shift_cipher.utils import ValidationUtils\n\n\n@dataclass(frozen=True)\nclass PlainText:\n    \"\"\"Represents a plain text string before ciphering.\"\"\"\n\n    text: str\n\n    def validate(self) -> None:\n        \"\"\"Validates that the text consists only of lowercase a-z characters.\"\"\"\n        if not ValidationUtils.is_lowercase_alpha(self.text):\n            raise InvalidInputError(\"Plain text must contain only lowercase a-z characters and be non-empty.\")\n\n\n@dataclass(frozen=True)\nclass CipherText:\n    \"\"\"Represents a cipher text string after ciphering.\"\"\"\n\n    text: str\n\n\n@dataclass(frozen=True)\nclass OperationRecord:\n    \"\"\"Represents a record of an encode/decode operation.\"\"\"\n\n    id: str\n    operation: str  # \"encode\" or \"decode\"\n    input_text: str\n    output_text: str\n    shift: int\n    timestamp: str  # ISO 8601 format\n```\n\n```python\n# src/shift_cipher/utils.py\n\"\"\"Utility functions for validation and common helpers.\"\"\"\n\nfrom datetime import datetime, timezone\n\nclass ValidationUtils:\n    \"\"\"Provides static methods for input validation and common utilities.\"\"\"\n\n    @staticmethod\n    def is_lowercase_alpha(s: str) -> bool:\n        \"\"\"Checks if a string contains only lowercase a-z characters and is not empty.\"\"\"\n        return bool(s) and all(\"a\" <= ch <= \"z\" for ch in s)\n\n    @staticmethod\n    def normalize_text(s: str) -> str:\n        \"\"\"Normalizes input text by stripping whitespace and converting to lowercase.\"\"\"\n        return s.strip().lower()\n\n    @staticmethod\n    def current_iso_timestamp() -> str:\n        \"\"\"Returns the current UTC time in ISO 8601 format.\"\"\"\n        return datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n```\n\n```python\n# src/shift_cipher/repository.py\n\"\"\"Repository interface and implementations for persisting operation records.\"\"\"\n\nimport abc\nimport json\nimport dataclasses\nimport os\nfrom typing import List, Optional\n\nfrom shift_cipher.models import OperationRecord\nfrom shift_cipher.exceptions import RepositoryError\n\n\nclass CipherRepository(abc.ABC):\n    \"\"\"Abstract Base Class defining the interface for cipher operation repositories.\"\"\"\n\n    @abc.abstractmethod\n    def save(self, record: OperationRecord) -> None:\n        \"\"\"Saves an operation record to the repository.\"\"\"\n        pass\n\n    @abc.abstractmethod\n    def list(self, limit: Optional[int] = None) -> List[OperationRecord]:\n        \"\"\"Retrieves a list of operation records, optionally limited by count.\"\"\"\n        pass\n\n\nclass InMemoryRepository(CipherRepository):\n    \"\"\"An in-memory implementation of CipherRepository, not persistent.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes an empty list to store records.\"\"\"\n        self._store: List[OperationRecord] = []\n\n    def save(self, record: OperationRecord) -> None:\n        \"\"\"Appends an operation record to the in-memory store.\"\"\"\n        self._store.append(record)\n\n    def list(self, limit: Optional[int] = None) -> List[OperationRecord]:\n        \"\"\"Returns recent records from memory, optionally limited.\"\"\"\n        return self._store[-limit:] if limit else list(self._store)\n\n\nclass FileRepository(CipherRepository):\n    \"\"\"A file-backed implementation of CipherRepository using JSON Lines.\"\"\"\n\n    def __init__(self, path: str):\n        \"\"\"Initializes with the file path for storing records.\"\"\"\n        self._path = path\n        os.makedirs(os.path.dirname(self._path), exist_ok=True)\n        if not os.path.exists(self._path):\n            try:\n                with open(self._path, \"w\", encoding=\"utf-8\") as f:\n                    pass  # Create an empty file if it doesn't exist\n            except OSError as e:\n                raise RepositoryError(f\"Failed to create file at {path}: {e}\") from e\n\n    def save(self, record: OperationRecord) -> None:\n        \"\"\"Appends a JSON-serialized operation record to the file.\"\"\"\n        line = json.dumps(dataclasses.asdict(record), ensure_ascii=False)\n        try:\n            with open(self._path, \"a\", encoding=\"utf-8\") as f:\n                f.write(line + \"\\n\")\n        except OSError as e:\n            raise RepositoryError(f\"Failed to write record to {self._path}: {e}\") from e\n\n    def list(self, limit: Optional[int] = None) -> List[OperationRecord]:\n        \"\"\"Reads all records from the file and returns the latest ones, optionally limited.\"\"\"\n        records: List[OperationRecord] = []\n        try:\n            with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                for line in f:\n                    if line.strip():\n                        try:\n                            data = json.loads(line)\n                            records.append(OperationRecord(**data))\n                        except json.JSONDecodeError as e:\n                            # Log error and skip malformed line\n                            print(f\"Warning: Skipping malformed record in {self._path}: {e}\")\n        except FileNotFoundError:\n            return []\n        except OSError as e:\n            raise RepositoryError(f\"Failed to read records from {self._path}: {e}\") from e\n\n        return records[-limit:] if limit else records\n```\n\n```python\n# src/shift_cipher/services.py\n\"\"\"Core business logic for encoding and decoding strings.\"\"\"\n\nfrom typing import Optional\nfrom uuid import uuid4\n\nfrom shift_cipher.config import Config\nfrom shift_cipher.exceptions import InvalidInputError, RepositoryError\nfrom shift_cipher.models import OperationRecord\nfrom shift_cipher.repository import CipherRepository\nfrom shift_cipher.utils import ValidationUtils\n\n\nclass CipherService:\n    \"\"\"Provides encode/decode operations for Caesar cipher and orchestrates persistence.\"\"\"\n\n    def __init__(self, repo: CipherRepository, shift: Optional[int] = None):\n        \"\"\"Initializes with a repository for persistence and an optional default shift.\"\"\"\n        self._repo = repo\n        self._shift = (shift if shift is not None else Config.get_default_shift()) % Config.ALPHABET_SIZE\n\n    def _shift_char(self, ch: str, shift: int) -> str:\n        \"\"\"Shifts a single lowercase character by the given amount.\"\"\"\n        if not \"a\" <= ch <= \"z\":\n            return ch  # Non-alphabetical characters are returned as is\n        shifted_ord = ((ord(ch) - ord(\"a\") + shift) % Config.ALPHABET_SIZE) + ord(\"a\")\n        return chr(shifted_ord)\n\n    def encode(self, text: str, shift: Optional[int] = None, persist: bool = True) -> str:\n        \"\"\"Encodes a string using a Caesar cipher with a specified or default shift.\"\"\"\n        s = ValidationUtils.normalize_text(text)\n        if not ValidationUtils.is_lowercase_alpha(s):\n            raise InvalidInputError(\"Input must contain only lowercase a-z characters and be non-empty.\")\n\n        effective_shift = (shift if shift is not None else self._shift) % Config.ALPHABET_SIZE\n        result_chars = [self._shift_char(ch, effective_shift) for ch in s]\n        out = \"\".join(result_chars)\n\n        if persist:\n            record = OperationRecord(\n                id=str(uuid4()),\n                operation=\"encode\",\n                input_text=s,\n                output_text=out,\n                shift=effective_shift,\n                timestamp=ValidationUtils.current_iso_timestamp(),\n            )\n            self._repo.save(record)\n        return out\n\n    def decode(self, text: str, shift: Optional[int] = None, persist: bool = True) -> str:\n        \"\"\"Decodes a string previously encoded with a Caesar cipher.\"\"\"\n        s = ValidationUtils.normalize_text(text)\n        if not ValidationUtils.is_lowercase_alpha(s):\n            raise InvalidInputError(\"Input must contain only lowercase a-z characters and be non-empty.\")\n\n        effective_shift = (shift if shift is not None else self._shift) % Config.ALPHABET_SIZE\n        # To decode, shift by the negative of the effective shift\n        decode_shift = -effective_shift\n        result_chars = [self._shift_char(ch, decode_shift) for ch in s]\n        out = \"\".join(result_chars)\n\n        if persist:\n            record = OperationRecord(\n                id=str(uuid4()),\n                operation=\"decode\",\n                input_text=s,\n                output_text=out,\n                shift=effective_shift,\n                timestamp=ValidationUtils.current_iso_timestamp(),\n            )\n            self._repo.save(record)\n        return out\n```\n\n```python\n# src/shift_cipher/controllers.py\n\"\"\"Adapters for CLI and API to interact with the CipherService.\"\"\"\n\nfrom typing import Optional\n\nfrom shift_cipher.services import CipherService\nfrom shift_cipher.exceptions import InvalidInputError, RepositoryError\n\n\nclass CLIController:\n    \"\"\"Handles command-line interface requests by delegating to CipherService.\"\"\"\n\n    def __init__(self, service: CipherService):\n        \"\"\"Initializes with an instance of CipherService.\"\"\"\n        self._service = service\n\n    def run_encode(self, text: str, shift: Optional[int] = None, persist: bool = True) -> int:\n        \"\"\"Executes an encode operation, prints result, and handles errors.\"\"\"\n        try:\n            result = self._service.encode(text, shift=shift, persist=persist)\n            print(result)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\")\n            return 1\n        except RepositoryError as e:\n            print(f\"Persistence Error: {e.message}\")\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\")\n            return 1\n\n    def run_decode(self, text: str, shift: Optional[int] = None, persist: bool = True) -> int:\n        \"\"\"Executes a decode operation, prints result, and handles errors.\"\"\"\n        try:\n            result = self._service.decode(text, shift=shift, persist=persist)\n            print(result)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\")\n            return 1\n        except RepositoryError as e:\n            print(f\"Persistence Error: {e.message}\")\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\")\n            return 1\n\n\nclass APIController:\n    \"\"\"Handles HTTP API requests by delegating to CipherService.\"\"\"\n\n    def __init__(self, service: CipherService):\n        \"\"\"Initializes with an instance of CipherService.\"\"\"\n        self._service = service\n\n    def encode_endpoint(self, payload: dict) -> dict:\n        \"\"\"Processes an HTTP POST /encode request.\"\"\"\n        text = payload.get(\"text\")\n        shift = payload.get(\"shift\")\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Missing or invalid 'text' field in payload.\")\n        if shift is not None and not isinstance(shift, int):\n            raise InvalidInputError(\"Invalid 'shift' field in payload; must be an integer.\")\n\n        result = self._service.encode(text, shift=shift, persist=True)\n        return {\"result\": result}\n\n    def decode_endpoint(self, payload: dict) -> dict:\n        \"\"\"Processes an HTTP POST /decode request.\"\"\"\n        text = payload.get(\"text\")\n        shift = payload.get(\"shift\")\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Missing or invalid 'text' field in payload.\")\n        if shift is not None and not isinstance(shift, int):\n            raise InvalidInputError(\"Invalid 'shift' field in payload; must be an integer.\")\n\n        result = self._service.decode(text, shift=shift, persist=True)\n        return {\"result\": result}\n```\n\n```python\n# src/shift_cipher/cli.py\n\"\"\"Command Line Interface (CLI) entrypoint for the Shift Cipher application.\"\"\"\n\nimport argparse\nimport os\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom shift_cipher.config import Config\nfrom shift_cipher.controllers import CLIController\nfrom shift_cipher.repository import FileRepository, InMemoryRepository\nfrom shift_cipher.services import CipherService\n\n\ndef create_cli_parser() -> argparse.ArgumentParser:\n    \"\"\"Creates and configures the argparse parser for the CLI.\"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"shift-cipher\",\n        description=\"Encode or decode strings using a Caesar-style fixed shift cipher.\",\n        formatter_class=argparse.ArgumentDefaultsHelpFormatter,\n    )\n    parser.add_argument(\n        \"--shift\",\n        type=int,\n        default=Config.get_default_shift(),\n        help=\"The integer shift value to apply.\",\n    )\n    parser.add_argument(\n        \"--no-persist\",\n        action=\"store_true\",\n        help=\"Do not persist the operation record.\",\n    )\n    parser.add_argument(\n        \"--repository\",\n        choices=[\"memory\", \"file\"],\n        default=\"memory\",\n        help=\"Choose the repository type for persistence.\",\n    )\n    parser.add_argument(\n        \"--file-path\",\n        type=str,\n        default=os.path.join(Path.home(), \".shift_cipher_history.jsonl\"),\n        help=\"Path to the history file for 'file' repository type.\",\n    )\n\n    subparsers = parser.add_subparsers(dest=\"command\", required=True, help=\"Available commands\")\n\n    encode_parser = subparsers.add_parser(\"encode\", help=\"Encode a string.\")\n    encode_parser.add_argument(\"text\", type=str, help=\"The string to encode.\")\n\n    decode_parser = subparsers.add_parser(\"decode\", help=\"Decode a string.\")\n    decode_parser.add_argument(\"text\", type=str, help=\"The string to decode.\")\n\n    return parser\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entrypoint for the CLI application.\"\"\"\n    parser = create_cli_parser()\n    args = parser.parse_args(argv)\n\n    if args.repository == \"memory\":\n        repo = InMemoryRepository()\n    elif args.repository == \"file\":\n        repo = FileRepository(path=args.file_path)\n    else:\n        print(f\"Error: Unknown repository type '{args.repository}'.\")\n        return 1\n\n    service = CipherService(repo=repo, shift=args.shift)\n    controller = CLIController(service)\n\n    persist_operation = not args.no_persist\n\n    if args.command == \"encode\":\n        return controller.run_encode(args.text, shift=args.shift, persist=persist_operation)\n    elif args.command == \"decode\":\n        return controller.run_decode(args.text, shift=args.shift, persist=persist_operation)\n    else:\n        parser.print_help()\n        return 1\n\n\nif __name__ == \"__main__\":\n    exit(main())\n```\n\n```python\n# src/shift_cipher/api.py\n\"\"\"FastAPI application factory for the Shift Cipher API.\"\"\"\n\nimport os\nfrom typing import Optional\n\nfrom fastapi import FastAPI, Header, HTTPException\nfrom pydantic import BaseModel\n\nfrom shift_cipher.config import Config\nfrom shift_cipher.controllers import APIController\nfrom shift_cipher.exceptions import InvalidInputError, RepositoryError\nfrom shift_cipher.repository import InMemoryRepository, FileRepository\nfrom shift_cipher.services import CipherService\n\n\nclass CipherRequest(BaseModel):\n    \"\"\"Schema for encode/decode request payload.\"\"\"\n    text: str\n    shift: Optional[int] = None\n\n\ndef create_app(service: CipherService | None = None, require_api_key: bool = False) -> FastAPI:\n    \"\"\"Creates and configures the FastAPI application.\"\"\"\n    if service is None:\n        # Default to InMemoryRepository for API if not provided, or FileRepository via ENV\n        repo_type = os.getenv(\"SHIFT_CIPHER_API_REPO_TYPE\", \"memory\").lower()\n        if repo_type == \"file\":\n            file_path = os.getenv(\"SHIFT_CIPHER_API_REPO_FILE\", \"/var/lib/shift_cipher_history.jsonl\")\n            repo = FileRepository(path=file_path)\n        else:\n            repo = InMemoryRepository()\n        service = CipherService(repo=repo)\n\n    app = FastAPI(\n        title=\"Shift Cipher API\",\n        description=\"API for encoding and decoding strings with a Caesar cipher.\",\n        version=\"0.1.0\",\n    )\n    controller = APIController(service)\n\n    async def get_api_key_or_raise(x_api_key: Optional[str] = Header(None)):\n        \"\"\"Dependency for API key authentication.\"\"\"\n        if not require_api_key:\n            return\n        configured_api_key = os.getenv(\"SHIFT_CIPHER_API_KEY\")\n        if not configured_api_key:\n            # If requirement is true but key isn't configured, that's a server config error or design flaw.\n            print(\"Warning: API key requirement enabled but SHIFT_CIPHER_API_KEY not set.\")\n            raise HTTPException(status_code=500, detail=\"API key requirement enabled but not configured.\")\n\n        if x_api_key != configured_api_key:\n            raise HTTPException(status_code=401, detail=\"Unauthorized\")\n\n    @app.post(\"/encode\")\n    async def encode_endpoint(request: CipherRequest, api_key_check: None = Depends(get_api_key_or_raise)):\n        \"\"\"Encodes the provided text using the Caesar cipher.\"\"\"\n        try:\n            payload = {\"text\": request.text, \"shift\": request.shift}\n            result = controller.encode_endpoint(payload)\n            return result\n        except InvalidInputError as e:\n            raise HTTPException(status_code=400, detail={\"error\": \"invalid_input\", \"message\": e.message})\n        except RepositoryError as e:\n            raise HTTPException(status_code=500, detail={\"error\": \"server_error\", \"message\": \"Persistence failure\"})\n        except Exception as e:\n            raise HTTPException(status_code=500, detail={\"error\": \"server_error\", \"message\": str(e)})\n\n    @app.post(\"/decode\")\n    async def decode_endpoint(request: CipherRequest, api_key_check: None = Depends(get_api_key_or_raise)):\n        \"\"\"Decodes the provided text using the Caesar cipher.\"\"\"\n        try:\n            payload = {\"text\": request.text, \"shift\": request.shift}\n            result = controller.decode_endpoint(payload)\n            return result\n        except InvalidInputError as e:\n            raise HTTPException(status_code=400, detail={\"error\": \"invalid_input\", \"message\": e.message})\n        except RepositoryError as e:\n            raise HTTPException(status_code=500, detail={\"error\": \"server_error\", \"message\": \"Persistence failure\"})\n        except Exception as e:\n            raise HTTPException(status_code=500, detail={\"error\": \"server_error\", \"message\": str(e)})\n\n    return app\n\n\n# This import is usually done at the top, but moved here to prevent circular dependency\n# if create_app is used without `uvicorn --factory` in some setups, or if we define app\n# directly. For `uvicorn --factory shift_cipher.api:create_app`, it's not strictly necessary.\nfrom fastapi import Depends\n```\n\n```python\n# src/shift_cipher/__main__.py\n\"\"\"Allows running the CLI directly using `python -m shift_cipher`.\"\"\"\n\nfrom shift_cipher.cli import main\n\nif __name__ == \"__main__\":\n    exit(main())\n```"}
{"task_id": "HumanEval/51", "solution": "```python\n# src/remove_vowels/errors.py\nclass RemoveVowelsError(Exception):\n    \"\"\"Base exception for the remove_vowels library.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidInputError(RemoveVowelsError):\n    \"\"\"Exception raised for invalid input types or values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n# src/remove_vowels/config.py\nVOWELS: frozenset[str] = frozenset(\"AEIOUaeiou\")\n\"\"\"The default set of vowels to be removed.\"\"\"\n\nDEFAULT_ENCODING: str = \"utf-8\"\n\"\"\"The default character encoding for file operations.\"\"\"\n\n# src/remove_vowels/vowel_remover.py\nfrom remove_vowels.errors import InvalidInputError\n\nclass VowelRemover:\n    \"\"\"Core algorithm to remove specified vowels from text.\"\"\"\n    def __init__(self, vowels: set[str]):\n        self._vowels = set(vowels)\n\n    def remove(self, text: str) -> str:\n        \"\"\"Removes characters found in the configured vowel set from the text.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Input 'text' must be a string.\")\n        return ''.join(ch for ch in text if ch not in self._vowels)\n\n# src/remove_vowels/text_sanitizer_service.py\nfrom remove_vowels.vowel_remover import VowelRemover\nfrom remove_vowels.errors import InvalidInputError\n\nclass TextSanitizerService:\n    \"\"\"Validates input and orchestrates vowel removal.\"\"\"\n    def __init__(self, remover: VowelRemover):\n        self._remover = remover\n\n    def sanitize_remove_vowels(self, text: str) -> str:\n        \"\"\"Validates input and calls the vowel remover, handling potential type errors.\"\"\"\n        try:\n            return self._remover.remove(text)\n        except TypeError as e:\n            raise InvalidInputError(f\"Invalid input type passed to remover: {e}\") from e\n\n# src/remove_vowels/api.py\nfrom remove_vowels.vowel_remover import VowelRemover\nfrom remove_vowels.text_sanitizer_service import TextSanitizerService\nfrom remove_vowels.config import VOWELS\n\nclass PackageAPI:\n    \"\"\"Public API for programmatic access to vowel removal functionality.\"\"\"\n    def __init__(self, remover: VowelRemover, service: TextSanitizerService):\n        self._remover = remover\n        self._service = service\n\n    def remove_vowels(self, text: str) -> str:\n        \"\"\"Removes vowels from the given text using the configured service.\"\"\"\n        return self._service.sanitize_remove_vowels(text)\n\n    @staticmethod\n    def create_default_api() -> \"PackageAPI\":\n        \"\"\"Factory method to create a PackageAPI instance with default dependencies.\"\"\"\n        remover = VowelRemover(set(VOWELS))\n        service = TextSanitizerService(remover)\n        return PackageAPI(remover, service)\n\n# src/remove_vowels/cli_controller.py\nimport sys\nimport argparse\nfrom typing import List, Optional\n\nfrom remove_vowels.api import PackageAPI\nfrom remove_vowels.errors import RemoveVowelsError\nfrom remove_vowels.config import DEFAULT_ENCODING\n\nclass CLIController:\n    \"\"\"Handles command-line argument parsing and I/O for the vowel removal tool.\"\"\"\n    def __init__(self, service: TextSanitizerService):\n        self._service = service\n\n    def _read_input(self, path: Optional[str], encoding: str) -> str:\n        \"\"\"Reads content from a file path or stdin.\"\"\"\n        if path:\n            try:\n                with open(path, 'r', encoding=encoding) as f:\n                    return f.read()\n            except IOError as e:\n                raise RemoveVowelsError(f\"Error reading input file '{path}': {e}\") from e\n        else:\n            return sys.stdin.read()\n\n    def _write_output(self, text: str, path: Optional[str], encoding: str) -> None:\n        \"\"\"Writes content to a file path or stdout.\"\"\"\n        if path:\n            try:\n                with open(path, 'w', encoding=encoding) as f:\n                    f.write(text)\n            except IOError as e:\n                raise RemoveVowelsError(f\"Error writing output file '{path}': {e}\") from e\n        else:\n            sys.stdout.write(text)\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Parses CLI arguments, processes input, and writes output.\"\"\"\n        parser = argparse.ArgumentParser(description=\"Remove vowels from text.\")\n        parser.add_argument(\n            \"-i\", \"--input\", help=\"Path to input file (default: stdin).\"\n        )\n        parser.add_argument(\n            \"-o\", \"--output\", help=\"Path to output file (default: stdout).\"\n        )\n        parser.add_argument(\n            \"-e\", \"--encoding\", default=DEFAULT_ENCODING,\n            help=f\"Character encoding for files (default: {DEFAULT_ENCODING}).\"\n        )\n        args = parser.parse_args(argv)\n\n        try:\n            input_text = self._read_input(args.input, args.encoding)\n            processed_text = self._service.sanitize_remove_vowels(input_text)\n            self._write_output(processed_text, args.output, args.encoding)\n            return 0  # Success\n        except RemoveVowelsError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 1  # Failure\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 2  # Unexpected failure\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    api = PackageAPI.create_default_api()\n    controller = CLIController(api._service)\n    return controller.run(argv)\n\n# src/remove_vowels/__init__.py\n\"\"\"A small, well-tested Python library that removes vowels from strings.\"\"\"\n\nfrom remove_vowels.api import PackageAPI\nfrom remove_vowels.errors import RemoveVowelsError, InvalidInputError\n\n__version__ = \"0.1.0\"\n\n_default_api_instance = PackageAPI.create_default_api()\n\ndef remove_vowels(text: str) -> str:\n    \"\"\"\n    Remove vowels from the given text string.\n    \n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\\\nghijklm\")\n    'bcdf\\\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    return _default_api_instance.remove_vowels(text)\n\n\n# pyproject.toml\n# This file is part of the project's build system and usually not generated as a code block.\n# However, for completeness as per the design spec, here's its content:\n# ```toml\n# [build-system]\n# requires = [\"setuptools>=61.0\"]\n# build-backend = \"setuptools.build_meta\"\n#\n# [project]\n# name = \"remove-vowels\"\n# version = \"0.1.0\"\n# authors = [\n#   { name=\"Your Name\", email=\"you@example.com\" },\n# ]\n# description = \"A small library to remove vowels from strings.\"\n# readme = \"README.md\"\n# requires-python = \">=3.8\"\n# classifiers = [\n#     \"Programming Language :: Python :: 3\",\n#     \"License :: OSI Approved :: MIT License\",\n#     \"Operating System :: OS Independent\",\n# ]\n#\n# [project.urls]\n# \"Homepage\" = \"https://github.com/yourusername/remove-vowels\"\n# \"Bug Tracker\" = \"https://github.com/yourusername/remove-vowels/issues\"\n#\n# [project.scripts]\n# remove-vowels = \"remove_vowels.cli_controller:main\"\n#\n# [tool.setuptools.packages.find]\n# where = [\"src\"]\n#\n# [tool.pytest.ini_options]\n# pythonpath = \"src\"\n# ```\n\n# README.md\n# This file is for project documentation. Its content is typically not part of a code generation task.\n# ```markdown\n# # Remove Vowels\n#\n# A small, well-tested Python library and CLI tool to remove vowels from strings.\n#\n# ## Installation\n#\n# ```bash\n# pip install remove-vowels\n# ```\n#\n# ## Library Usage\n#\n# ```python\n# from remove_vowels import remove_vowe