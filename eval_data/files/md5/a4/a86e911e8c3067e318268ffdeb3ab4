{"task_id": "HumanEval/22", "solution": "To implement the software design specification, I will generate the required files and their contents. The \"CRITICAL REQUIREMENTS\" section in the prompt appears to apply to an isolated `filter_integers` function, which contradicts the comprehensive design specification provided. I will prioritize adhering to the full design specification, which includes multiple files, classes, and a testing structure.\n\n```python\n# src/intfilter/exceptions.py\nclass FilterError(Exception):\n    \"\"\"Base exception for intfilter operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(FilterError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\n# src/intfilter/models.py\nimport json\nfrom typing import List, Any\nfrom .exceptions import InvalidInputError\n\nclass ValueList:\n    \"\"\"DTO for input/output lists with JSON serialization.\"\"\"\n    def __init__(self, values: List[Any]):\n        self.values = list(values)  # Defensive copy\n\n    def to_json(self) -> str:\n        \"\"\"Serializes the values to a JSON string.\"\"\"\n        return json.dumps(self.values)\n\n    @staticmethod\n    def from_json(json_str: str) -> \"ValueList\":\n        \"\"\"Parses a JSON string and returns a ValueList instance.\"\"\"\n        try:\n            parsed_values = json.loads(json_str)\n            if not isinstance(parsed_values, list):\n                raise InvalidInputError(\"JSON input must be an array.\")\n            return ValueList(parsed_values)\n        except json.JSONDecodeError as exc:\n            raise InvalidInputError(f\"Invalid JSON format: {exc}\")\n        except Exception as exc:\n            raise InvalidInputError(f\"Error processing JSON: {exc}\")\n\n\n# src/intfilter/utils.py\nfrom typing import Any, List\nfrom .exceptions import InvalidInputError\n\nclass ValidatorUtils:\n    \"\"\"Provides utility methods for type-checking and filtering.\"\"\"\n    BOOL_TYPE = bool\n\n    @staticmethod\n    def is_strict_int(value: Any) -> bool:\n        \"\"\"Checks if a value is exactly an integer, excluding booleans.\"\"\"\n        return type(value) is int\n\n    @staticmethod\n    def filter_ints(values: List[Any]) -> List[int]:\n        \"\"\"Filters a list to include only strict integers, preserving order.\"\"\"\n        if not isinstance(values, list) and values is not None:\n            raise InvalidInputError(\"Input must be a list or None.\")\n        if values is None:\n            return []\n        \n        return [v for v in values if ValidatorUtils.is_strict_int(v)]\n\n# src/intfilter/repositories.py\nimport json\nimport os\nfrom abc import ABC, abstractmethod\nfrom typing import List\nfrom .exceptions import FilterError\n\nclass ValueRepository(ABC):\n    \"\"\"Abstract base class for value persistence.\"\"\"\n    @abstractmethod\n    def save(self, values: List[int]) -> None:\n        pass\n\n    @abstractmethod\n    def load(self) -> List[int]:\n        pass\n\nclass FileRepository(ValueRepository):\n    \"\"\"A simple file-based repository for lists of integers.\"\"\"\n    DEFAULT_STORE_PATH = \"intfilter_store.json\"\n\n    def __init__(self, path: str = DEFAULT_STORE_PATH):\n        self.path = path\n        # Ensure directory exists\n        os.makedirs(os.path.dirname(path) or '.', exist_ok=True)\n\n    def save(self, values: List[int]) -> None:\n        \"\"\"Saves a list of integers to a JSON file atomically.\"\"\"\n        tmp_path = self.path + \".tmp\"\n        try:\n            with open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(values, f)\n            os.replace(tmp_path, self.path)\n        except OSError as exc:\n            raise FilterError(f\"Failed to save data to '{self.path}': {exc}\")\n        except json.JSONDecodeError as exc:\n            raise FilterError(f\"Failed to serialize data for '{self.path}': {exc}\")\n\n    def load(self) -> List[int]:\n        \"\"\"Loads a list of integers from a JSON file.\"\"\"\n        if not os.path.exists(self.path):\n            return []\n        try:\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n                if not isinstance(data, list) or not all(isinstance(i, int) for i in data):\n                    # Attempt to gracefully handle old or malformed data\n                    return [i for i in data if isinstance(i, int)]\n                return data\n        except FileNotFoundError:\n            return [] # Should not happen due to exists check, but for robustness\n        except json.JSONDecodeError as exc:\n            # If the file is corrupted, return empty list or raise error\n            raise FilterError(f\"Failed to load data from '{self.path}': invalid JSON: {exc}\")\n        except OSError as exc:\n            raise FilterError(f\"Failed to read data from '{self.path}': {exc}\")\n\n\n# src/intfilter/services.py\nfrom typing import List, Any, Optional\nfrom .utils import ValidatorUtils\nfrom .repositories import ValueRepository\nfrom .exceptions import FilterError, InvalidInputError\n\nclass FilterService:\n    \"\"\"Core business logic for filtering and optionally storing integers.\"\"\"\n    def __init__(self, repo: Optional[ValueRepository] = None, validator: Optional[ValidatorUtils] = None):\n        self.repo = repo\n        self.validator = validator or ValidatorUtils\n\n    def filter(self, values: List[Any]) -> List[int]:\n        \"\"\"Filters a list, returning only strict integer values.\"\"\"\n        try:\n            return self.validator.filter_ints(values)\n        except InvalidInputError:\n            # Re-raise InvalidInputError as it's already specific\n            raise\n        except Exception as exc:\n            # Catch other unexpected errors and wrap them\n            raise FilterError(f\"An unexpected error occurred during filtering: {exc}\")\n\n    def filter_and_store(self, values: List[Any]) -> List[int]:\n        \"\"\"Filters the list and, if a repository is provided, stores the result.\"\"\"\n        filtered_values = self.filter(values)\n        if self.repo:\n            try:\n                self.repo.save(filtered_values)\n            except FilterError: # Re-raise FilterError from repo\n                raise\n            except Exception as exc:\n                raise FilterError(f\"Failed to store filtered values: {exc}\")\n        return filtered_values\n\n# src/intfilter/controllers.py\nfrom typing import List, Any\nfrom .services import FilterService\nfrom .models import ValueList\nfrom .exceptions import InvalidInputError, FilterError\n\nclass IntegerFilterController:\n    \"\"\"Adapts input from entrypoints and delegates to the FilterService.\"\"\"\n    def __init__(self, service: FilterService):\n        self.service = service\n\n    def handle(self, values: List[Any]) -> List[int]:\n        \"\"\"Handles a direct list input by delegating to the service.\"\"\"\n        return self.service.filter(values)\n\n    def handle_json(self, json_str: str) -> List[int]:\n        \"\"\"Parses a JSON string, then handles the extracted list.\"\"\"\n        if not json_str:\n            raise InvalidInputError(\"Empty JSON input received.\")\n        try:\n            value_list_dto = ValueList.from_json(json_str)\n        except InvalidInputError:\n            # Re-raise InvalidInputError from ValueList.from_json\n            raise\n        except Exception as exc:\n            raise InvalidInputError(f\"Could not parse JSON input: {exc}\")\n        \n        return self.service.filter(value_list_dto.values)\n\n# src/intfilter/cli.py\nimport sys\nimport argparse\nimport json\nfrom typing import List, Optional\nfrom .controllers import IntegerFilterController\nfrom .services import FilterService\nfrom .exceptions import FilterError, InvalidInputError\nfrom .utils import ValidatorUtils # For default service\nfrom .repositories import FileRepository # For default service\n\nclass CLIApp:\n    \"\"\"Command-line interface application for integer filtering.\"\"\"\n    EXIT_SUCCESS = 0\n    EXIT_RUNTIME_ERROR = 1\n    EXIT_INVALID_INPUT = 2\n\n    def __init__(self, controller: Optional[IntegerFilterController] = None):\n        # Default components for standalone CLI use\n        if controller is None:\n            # Provide default implementations for the service and controller\n            # For CLI, we can have a simple FilterService without a repo by default\n            default_service = FilterService(validator=ValidatorUtils())\n            self.controller = IntegerFilterController(service=default_service)\n        else:\n            self.controller = controller\n\n    def _read_stdin(self) -> str:\n        \"\"\"Helper to read all data from stdin.\"\"\"\n        return sys.stdin.read()\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, executes the filtering, and prints results or errors.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Filter a JSON array to contain only integers.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        parser.add_argument(\n            '--input',\n            type=str,\n            help=\"JSON array string to filter. If not provided, reads from stdin.\\n\"\n                 \"Example: intfilter --input='[1, \\\"a\\\", 2]' \"\n        )\n        parser.add_argument(\n            '--save-to',\n            type=str,\n            help=\"Optional: Path to a JSON file to save the filtered output.\",\n            dest='save_path'\n        )\n        parser.add_argument(\n            '--load-from',\n            type=str,\n            help=\"Optional: Path to a JSON file to load initial values from. Filters loaded values.\",\n            dest='load_path'\n        )\n        \n        args = parser.parse_args(argv[1:])\n\n        json_str = None\n        if args.input:\n            json_str = args.input\n        elif sys.stdin.isatty():\n            # If stdin is not being piped, and no --input, then it's an error or no input\n            parser.print_help()\n            sys.stderr.write(\"\\nError: No input provided. Use --input or pipe JSON to stdin.\\n\")\n            return self.EXIT_INVALID_INPUT\n        else:\n            json_str = self._read_stdin()\n\n        try:\n            if args.load_path:\n                # Reconfigure service to use FileRepository for loading\n                repo_for_load = FileRepository(args.load_path)\n                loaded_values = repo_for_load.load()\n                # If --input also given, merge or prioritize. Design suggests \"filters loaded values\"\n                # For simplicity, if both --input and --load-from, --load-from takes precedence as source.\n                # If --input is meant to *add* to loaded, logic would be different. Sticking to simple source.\n                if json_str and json.loads(json_str): # check if input is non-empty\n                    # If input is provided, handle as if it's the primary source, not for merging.\n                    # Or we could combine: let's combine for flexibility.\n                    try:\n                        input_values = json.loads(json_str)\n                        if isinstance(input_values, list):\n                            loaded_values.extend(input_values)\n                    except json.JSONDecodeError:\n                        pass # if --input is invalid json, ignore for combining, proceed with loaded.\n                \n                # Now, filter combined or just loaded values\n                filtered_result = self.controller.handle(loaded_values)\n\n            else: # No --load-from, so proceed with standard --input or stdin\n                if not json_str:\n                    sys.stderr.write(\"Error: Empty input received.\\n\")\n                    return self.EXIT_INVALID_INPUT\n                filtered_result = self.controller.handle_json(json_str)\n\n            if args.save_path:\n                # Reconfigure service to use FileRepository for saving\n                repo_for_save = FileRepository(args.save_path)\n                repo_for_save.save(filtered_result)\n\n            sys.stdout.write(json.dumps(filtered_result))\n            sys.stdout.write(\"\\n\")\n            return self.EXIT_SUCCESS\n\n        except InvalidInputError as e:\n            sys.stderr.write(f\"Error: Invalid input: {e.message}\\n\")\n            return self.EXIT_INVALID_INPUT\n        except FilterError as e:\n            sys.stderr.write(f\"Error: Operation failed: {e.message}\\n\")\n            return self.EXIT_RUNTIME_ERROR\n        except Exception as e:\n            sys.stderr.write(f\"An unexpected error occurred: {e}\\n\")\n            return self.EXIT_RUNTIME_ERROR\n\ndef main(argv: List[str] = sys.argv) -> int:\n    \"\"\"Entry point for the intfilter CLI.\"\"\"\n    app = CLIApp()\n    return app.run(argv)\n\n# src/intfilter/api.py\nimport os\nfrom typing import Any, Optional\nfrom .controllers import IntegerFilterController\nfrom .exceptions import InvalidInputError, FilterError\n\n# Conditional import for FastAPI and Uvicorn\ntry:\n    from fastapi import FastAPI, HTTPException, Request\n    from fastapi.responses import JSONResponse\n    import uvicorn\n    FASTAPI_AVAILABLE = True\nexcept ImportError:\n    FASTAPI_AVAILABLE = False\n    FastAPI, HTTPException, Request, JSONResponse, uvicorn = (None,) * 5\n\nclass ApiServer:\n    \"\"\"Optional HTTP adapter using FastAPI to expose filtering capability.\"\"\"\n    DEFAULT_HOST = \"127.0.0.1\"\n    DEFAULT_PORT = 8000\n\n    def __init__(self, controller: IntegerFilterController):\n        if not FASTAPI_AVAILABLE:\n            raise ImportError(\n                \"FastAPI and Uvicorn are not installed. \"\n                \"Install them with `pip install \\\"intfilter[server]\\\"` to use the API server.\"\n            )\n        self.controller = controller\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Creates and configures the FastAPI application.\"\"\"\n        app = FastAPI(\n            title=\"IntFilter API\",\n            description=\"API to filter lists of values for integers.\",\n            version=\"0.1.0\"\n        )\n\n        @app.post(\"/filter\")\n        async def filter_endpoint(request: Request):\n            \"\"\"\n            Accepts a JSON array and returns a filtered JSON array of integers.\n            \"\"\"\n            try:\n                json_payload = await request.json()\n            except Exception:\n                raise HTTPException(status_code=400, detail={\"error\": \"invalid_json\", \"message\": \"Request body must be valid JSON.\"})\n\n            try:\n                # FastAPI request.json() already parses, so no need for ValueList.from_json for parsing\n                # but we need to ensure it's a list.\n                if not isinstance(json_payload, list):\n                    raise InvalidInputError(\"Request body must be a JSON array.\")\n\n                # Use the controller's handle method for the list directly\n                filtered_result = self.controller.handle(json_payload)\n                return JSONResponse(content=filtered_result, status_code=200)\n            except InvalidInputError as e:\n                raise HTTPException(status_code=400, detail={\"error\": \"invalid_input\", \"message\": e.message})\n            except FilterError as e:\n                raise HTTPException(status_code=500, detail={\"error\": \"filter_error\", \"message\": e.message})\n            except Exception as e:\n                raise HTTPException(status_code=500, detail={\"error\": \"internal_server_error\", \"message\": str(e)})\n        \n        return app\n\n    def run(self, host: str = DEFAULT_HOST, port: int = DEFAULT_PORT) -> None:\n        \"\"\"Runs the Uvicorn server for the FastAPI application.\"\"\"\n        app = self.create_app()\n        uvicorn.run(app, host=host, port=port)\n\n\n# src/intfilter/_internal.py\nfrom typing import List, Any\nfrom .services import FilterService\nfrom .utils import ValidatorUtils # For internal convenience init\nfrom .exceptions import InvalidInputError\n\n_default_filter_service = FilterService(validator=ValidatorUtils())\n\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\"Convenience wrapper for simple programmatic access to filter integers.\n\n    Delegates to a default FilterService instance.\n    \"\"\"\n    try:\n        return _default_filter_service.filter(values)\n    except InvalidInputError as exc:\n        # As per design, map to TypeError for compatibility with simple API expectations\n        raise TypeError(f\"Invalid input type or value: {exc.message}\") from exc\n\n\n# src/intfilter/__init__.py\nfrom ._internal import filter_integers\nfrom .services import FilterService\nfrom .controllers import IntegerFilterController\nfrom .cli import CLIApp, main as cli_main # Export cli.main as cli_main for direct execution\nfrom .api import ApiServer\n\n__all__ = [\n    \"filter_integers\",\n    \"FilterService\",\n    \"IntegerFilterController\",\n    \"CLIApp\",\n    \"ApiServer\",\n    \"cli_main\",\n]\n\n# Configure main entry point for the CLI as `intfilter` in pyproject.toml\n# and provide a way to run the API server if enabled.\n# For simplicity, a direct `intfilter serve` command can be added in `cli.py` or separate entry.\n# Current design suggests cli.py has the `run` method and `main` entry.\n# Let's adjust cli.py to support a 'serve' subcommand.\n\n# Modified src/intfilter/cli.py to include serve command:\n# (This modification is applied to the previously generated cli.py content)\n\"\"\"\nimport sys\nimport argparse\nimport json\nfrom typing import List, Optional\nfrom .controllers import IntegerFilterController\nfrom .services import FilterService\nfrom .exceptions import FilterError, InvalidInputError\nfrom .utils import ValidatorUtils\nfrom .repositories import FileRepository\nfrom .api import ApiServer\n\nclass CLIApp:\n    \\\"\\\"\\\"Command-line interface application for integer filtering.\\\"\\\"\\\"\n    EXIT_SUCCESS = 0\n    EXIT_RUNTIME_ERROR = 1\n    EXIT_INVALID_INPUT = 2\n\n    def __init__(self, controller: Optional[IntegerFilterController] = None):\n        if controller is None:\n            default_service = FilterService(validator=ValidatorUtils())\n            self.controller = IntegerFilterController(service=default_service)\n        else:\n            self.controller = controller\n\n    def _read_stdin(self) -> str:\n        \\\"\\\"\\\"Helper to read all data from stdin.\\\"\\\"\\\"\n        return sys.stdin.read()\n\n    def run_filter_command(self, args: argparse.Namespace) -> int:\n        \\\"\\\"\\\"Handles the 'filter' subcommand logic.\\\"\\\"\\\"\n        json_str = None\n        if args.input:\n            json_str = args.input\n        elif sys.stdin.isatty():\n            sys.stderr.write(\"Error: No input provided. Use --input or pipe JSON to stdin.\\n\")\n            return self.EXIT_INVALID_INPUT\n        else:\n            json_str = self._read_stdin()\n\n        try:\n            current_values = []\n            if args.load_path:\n                repo_for_load = FileRepository(args.load_path)\n                current_values.extend(repo_for_load.load())\n            \n            if json_str:\n                try:\n                    input_values = json.loads(json_str)\n                    if isinstance(input_values, list):\n                        current_values.extend(input_values)\n                except json.JSONDecodeError:\n                    if not args.load_path: # If no load path, invalid input from stdin/arg is critical\n                        raise InvalidInputError(\"Invalid JSON input provided.\")\n                    # If load_path is present, ignore invalid stdin/arg JSON for combining\n\n            if not current_values and not args.load_path and not json_str:\n                sys.stderr.write(\"Error: No values to filter.\\n\")\n                return self.EXIT_INVALID_INPUT\n            \n            filtered_result = self.controller.handle(current_values)\n\n            if args.save_path:\n                repo_for_save = FileRepository(args.save_path)\n                repo_for_save.save(filtered_result)\n\n            sys.stdout.write(json.dumps(filtered_result))\n            sys.stdout.write(\"\\n\")\n            return self.EXIT_SUCCESS\n\n        except InvalidInputError as e:\n            sys.stderr.write(f\"Error: Invalid input: {e.message}\\n\")\n            return self.EXIT_INVALID_INPUT\n        except FilterError as e:\n            sys.stderr.write(f\"Error: Operation failed: {e.message}\\n\")\n            return self.EXIT_RUNTIME_ERROR\n        except Exception as e:\n            sys.stderr.write(f\"An unexpected error occurred: {e}\\n\")\n            return self.EXIT_RUNTIME_ERROR\n\n    def run_serve_command(self, args: argparse.Namespace) -> int:\n        \\\"\\\"\\\"Handles the 'serve' subcommand logic.\\\"\\\"\\\"\n        try:\n            server = ApiServer(self.controller) # ApiServer needs a controller\n            server.run(host=args.host, port=args.port)\n            return self.EXIT_SUCCESS\n        except ImportError as e:\n            sys.stderr.write(f\"Error: {e}\\n\")\n            sys.stderr.write(\"Please install 'fastapi' and 'uvicorn' to use the 'serve' command.\\n\")\n            sys.stderr.write(\"You can do this by installing `intfilter` with the '[server]' extra: `pip install intfilter[server]`.\\n\")\n            return self.EXIT_RUNTIME_ERROR\n        except Exception as e:\n            sys.stderr.write(f\"An error occurred while starting the API server: {e}\\n\")\n            return self.EXIT_RUNTIME_ERROR\n\n    def run(self, argv: List[str]) -> int:\n        \\\"\\\"\\\"Main entry point for the CLI application, dispatching commands.\\\"\\\"\\\"\n        parser = argparse.ArgumentParser(\n            prog=\"intfilter\",\n            description=\"A tool to filter Python lists for integers.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n\n        subparsers = parser.add_subparsers(dest=\"command\", required=True, help=\"Available commands\")\n\n        # 'filter' subcommand\n        filter_parser = subparsers.add_parser(\n            \"filter\",\n            help=\"Filters a JSON array of values to contain only integers.\",\n            description=\"Filters a JSON array (from stdin or --input) to contain only integers, \"\n                        \"optionally loading from or saving to a file.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        filter_parser.add_argument(\n            '--input',\n            type=str,\n            help=\"JSON array string to filter. If not provided, reads from stdin.\\n\"\n                 \"Example: intfilter filter --input='[1, \\\"a\\\", 2]'\"\n        )\n        filter_parser.add_argument(\n            '--save-to',\n            type=str,\n            help=\"Optional: Path to a JSON file to save the filtered output.\",\n            dest='save_path'\n        )\n        filter_parser.add_argument(\n            '--load-from',\n            type=str,\n            help=\"Optional: Path to a JSON file to load initial values from. \"\n                 \"These values are filtered. If --input is also provided, \"\n                 \"values from --input are appended to loaded values before filtering.\",\n            dest='load_path'\n        )\n        filter_parser.set_defaults(func=self.run_filter_command)\n\n        # 'serve' subcommand\n        serve_parser = subparsers.add_parser(\n            \"serve\",\n            help=\"Starts an optional HTTP API server.\",\n            description=\"Starts an HTTP server exposing a /filter endpoint. \"\n                        \"Requires fastapi and uvicorn to be installed.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        serve_parser.add_argument(\n            '--host',\n            type=str,\n            default=ApiServer.DEFAULT_HOST,\n            help=f\"Host address for the API server (default: {ApiServer.DEFAULT_HOST})\"\n        )\n        serve_parser.add_argument(\n            '--port',\n            type=int,\n            default=ApiServer.DEFAULT_PORT,\n            help=f\"Port for the API server (default: {ApiServer.DEFAULT_PORT})\"\n        )\n        serve_parser.set_defaults(func=self.run_serve_command)\n\n        # Parse args and call the appropriate function\n        args = parser.parse_args(argv[1:])\n        return args.func(args)\n\n\ndef main(argv: List[str] = sys.argv) -> int:\n    \\\"\\\"\\\"Entry point for the intfilter CLI.\\\"\\\"\\\"\n    app = CLIApp()\n    return app.run(argv)\n\n\"\"\"\n\n# tests/test_exceptions.py (Added for completeness, though not explicitly in design)\nimport pytest\nfrom intfilter.exceptions import FilterError, InvalidInputError\n\ndef test_filter_error_message():\n    err = FilterError(\"Something went wrong\")\n    assert err.message == \"Something went wrong\"\n    assert str(err) == \"Something went wrong\"\n\ndef test_invalid_input_error_inherits_filter_error():\n    err = InvalidInputError(\"Bad data\")\n    assert isinstance(err, FilterError)\n    assert err.message == \"Bad data\"\n\n# tests/test_models.py (Added for completeness)\nimport json\nimport pytest\nfrom intfilter.models import ValueList\nfrom intfilter.exceptions import InvalidInputError\n\ndef test_valuelist_init_and_values():\n    values = [1, \"a\", True, None]\n    vl = ValueList(values)\n    assert vl.values == values\n    # Ensure defensive copy\n    values.append(5)\n    assert vl.values != values\n\ndef test_valuelist_to_json():\n    vl = ValueList([1, \"b\", 3.0, None])\n    assert vl.to_json() == json.dumps([1, \"b\", 3.0, None])\n\ndef test_valuelist_from_json_valid():\n    json_str = '[1, \"c\", 4]'\n    vl = ValueList.from_json(json_str)\n    assert vl.values == [1, \"c\", 4]\n\ndef test_valuelist_from_json_invalid_format():\n    with pytest.raises(InvalidInputError, match=\"Invalid JSON format\"):\n        ValueList.from_json(\"not json\")\n\ndef test_valuelist_from_json_not_array():\n    with pytest.raises(InvalidInputError, match=\"JSON input must be an array\"):\n        ValueList.from_json('{\"key\": \"value\"}')\n\n# tests/test_utils.py\nimport pytest\nfrom intfilter.utils import ValidatorUtils\nfrom intfilter.exceptions import InvalidInputError\n\ndef test_is_strict_int_true():\n    assert ValidatorUtils.is_strict_int(1)\n    assert ValidatorUtils.is_strict_int(0)\n    assert ValidatorUtils.is_strict_int(-100)\n    assert ValidatorUtils.is_strict_int(1234567890)\n\ndef test_is_strict_int_false_bool():\n    assert not ValidatorUtils.is_strict_int(True)\n    assert not ValidatorUtils.is_strict_int(False)\n\ndef test_is_strict_int_false_float():\n    assert not ValidatorUtils.is_strict_int(1.0)\n    assert not ValidatorUtils.is_strict_int(0.0)\n    assert not ValidatorUtils.is_strict_int(3.14)\n\ndef test_is_strict_int_false_other_types():\n    assert not ValidatorUtils.is_strict_int(\"1\")\n    assert not ValidatorUtils.is_strict_int([1])\n    assert not ValidatorUtils.is_strict_int({'a': 1})\n    assert not ValidatorUtils.is_strict_int(None)\n\ndef test_filter_ints_basic():\n    values = [1, \"a\", 2, 3.14, True, 3, None, 0]\n    expected = [1, 2, 3, 0]\n    assert ValidatorUtils.filter_ints(values) == expected\n\ndef test_filter_ints_empty_list():\n    assert ValidatorUtils.filter_ints([]) == []\n\ndef test_filter_ints_no_ints():\n    assert ValidatorUtils.filter_ints([\"a\", 3.14, True, None]) == []\n\ndef test_filter_ints_all_ints():\n    assert ValidatorUtils.filter_ints([1, 2, 3]) == [1, 2, 3]\n\ndef test_filter_ints_with_bools():\n    assert ValidatorUtils.filter_ints([True, False, 1, 0]) == [1, 0]\n\ndef test_filter_ints_with_none_input():\n    assert ValidatorUtils.filter_ints(None) == []\n\ndef test_filter_ints_invalid_input_type():\n    with pytest.raises(InvalidInputError, match=\"Input must be a list or None.\"):\n        ValidatorUtils.filter_ints(\"not a list\")\n    with pytest.raises(InvalidInputError, match=\"Input must be a list or None.\"):\n        ValidatorUtils.filter_ints(123)\n    with pytest.raises(InvalidInputError, match=\"Input must be a list or None.\"):\n        ValidatorUtils.filter_ints({\"key\": \"value\"})\n\n# tests/test_repositories.py\nimport pytest\nimport os\nimport json\nfrom unittest.mock import patch, mock_open\nfrom intfilter.repositories import FileRepository, ValueRepository\nfrom intfilter.exceptions import FilterError\n\n@pytest.fixture\ndef temp_repo_path(tmp_path):\n    return tmp_path / \"test_store.json\"\n\n@pytest.fixture\ndef file_repo(temp_repo_path):\n    return FileRepository(str(temp_repo_path))\n\nclass TestValueRepository:\n    def test_abstract_methods(self):\n        with pytest.raises(TypeError):\n            ValueRepository() # Can't instantiate abstract class\n\nclass TestFileRepository:\n    def test_init_creates_directory(self, tmp_path):\n        subdir = tmp_path / \"sub\"\n        repo_path = subdir / \"test.json\"\n        repo = FileRepository(str(repo_path))\n        assert os.path.exists(subdir)\n        assert repo.path == str(repo_path)\n\n    def test_save_and_load_empty_list(self, file_repo, temp_repo_path):\n        file_repo.save([])\n        assert os.path.exists(temp_repo_path)\n        assert file_repo.load() == []\n\n    def test_save_and_load_list_of_ints(self, file_repo, temp_repo_path):\n        values = [1, 5, 100]\n        file_repo.save(values)\n        assert os.path.exists(temp_repo_path)\n        assert file_repo.load() == values\n\n    def test_load_non_existent_file(self, file_repo):\n        assert file_repo.load() == []\n\n    def test_save_atomic_write(self, file_repo, temp_repo_path):\n        values = [1, 2, 3]\n        file_repo.save(values)\n        assert os.path.exists(temp_repo_path)\n        assert not os.path.exists(str(temp_repo_path) + \".tmp\")\n\n        with open(temp_repo_path, 'r') as f:\n            content = json.load(f)\n            assert content == values\n    \n    def test_load_malformed_json(self, file_repo, temp_repo_path):\n        with open(temp_repo_path, 'w') as f:\n            f.write(\"{invalid json}\")\n        with pytest.raises(FilterError, match=\"invalid JSON\"):\n            file_repo.load()\n\n    def test_load_non_list_json(self, file_repo, temp_repo_path):\n        with open(temp_repo_path, 'w') as f:\n            json.dump({\"not\": \"a list\"}, f)\n        # Should gracefully handle by returning an empty list or filtered if possible\n        # Current implementation filters if possible.\n        assert file_repo.load() == []\n\n    def test_load_list_with_non_ints(self, file_repo, temp_repo_path):\n        with open(temp_repo_path, 'w') as f:\n            json.dump([1, \"a\", 2, True], f)\n        # Should filter out non-ints on load\n        assert file_repo.load() == [1, 2]\n\n    def test_save_io_error(self, file_repo, temp_repo_path):\n        with patch(\"builtins.open\", side_effect=OSError(\"Disk full\")):\n            with pytest.raises(FilterError, match=\"Failed to save data\"):\n                file_repo.save([1, 2])\n\n    def test_load_io_error(self, file_repo, temp_repo_path):\n        temp_repo_path.write_text(\"[1,2,3]\")\n        with patch(\"builtins.open\", side_effect=OSError(\"Permission denied\")):\n            with pytest.raises(FilterError, match=\"Failed to read data\"):\n                file_repo.load()\n\n# tests/test_services.py\nimport pytest\nfrom unittest.mock import Mock, call\nfrom intfilter.services import FilterService\nfrom intfilter.repositories import ValueRepository\nfrom intfilter.utils import ValidatorUtils\nfrom intfilter.exceptions import FilterError, InvalidInputError\n\n@pytest.fixture\ndef mock_validator():\n    mock = Mock(spec=ValidatorUtils)\n    mock.filter_ints.side_effect = lambda x: [v for v in x if type(v) is int and type(v) is not bool]\n    return mock\n\n@pytest.fixture\ndef mock_repo():\n    mock = Mock(spec=ValueRepository)\n    mock.save.return_value = None\n    mock.load.return_value = []\n    return mock\n\ndef test_filter_service_init_default_validator():\n    service = FilterService()\n    assert isinstance(service.validator, ValidatorUtils)\n    assert service.repo is None\n\ndef test_filter_service_init_custom_validator(mock_validator):\n    service = FilterService(validator=mock_validator)\n    assert service.validator == mock_validator\n\ndef test_filter_service_init_with_repo(mock_repo):\n    service = FilterService(repo=mock_repo)\n    assert service.repo == mock_repo\n\ndef test_filter_basic(mock_validator):\n    service = FilterService(validator=mock_validator)\n    input_values = [1, \"a\", 2, 3.0, True, 3]\n    expected_output = [1, 2, 3]\n    result = service.filter(input_values)\n    assert result == expected_output\n    mock_validator.filter_ints.assert_called_once_with(input_values)\n\ndef test_filter_excludes_bool(mock_validator):\n    service = FilterService(validator=mock_validator)\n    input_values = [True, False, 1, 0, 5, True]\n    expected_output = [1, 0, 5]\n    result = service.filter(input_values)\n    assert result == expected_output\n    mock_validator.filter_ints.assert_called_once_with(input_values)\n\ndef test_filter_propagates_invalid_input_error(mock_validator):\n    mock_validator.filter_ints.side_effect = InvalidInputError(\"test error\")\n    service = FilterService(validator=mock_validator)\n    with pytest.raises(InvalidInputError, match=\"test error\"):\n        service.filter(\"not a list\")\n\ndef test_filter_wraps_other_exceptions(mock_validator):\n    mock_validator.filter_ints.side_effect = ValueError(\"unexpected\")\n    service = FilterService(validator=mock_validator)\n    with pytest.raises(FilterError, match=\"An unexpected error occurred during filtering: unexpected\"):\n        service.filter([1, 2])\n\ndef test_filter_and_store_no_repo(mock_validator):\n    service = FilterService(validator=mock_validator)\n    input_values = [1, \"a\", 2]\n    result = service.filter_and_store(input_values)\n    assert result == [1, 2]\n    # No repo, so save should not be called\n    assert service.repo is None\n\ndef test_filter_and_store_with_repo(mock_repo, mock_validator):\n    service = FilterService(repo=mock_repo, validator=mock_validator)\n    input_values = [1, \"a\", 2]\n    expected_filtered = [1, 2]\n    \n    result = service.filter_and_store(input_values)\n    \n    assert result == expected_filtered\n    mock_validator.filter_ints.assert_called_once_with(input_values)\n    mock_repo.save.assert_called_once_with(expected_filtered)\n\ndef test_filter_and_store_repo_save_error(mock_repo, mock_validator):\n    mock_repo.save.side_effect = OSError(\"Disk full\")\n    service = FilterService(repo=mock_repo, validator=mock_validator)\n    input_values = [1, 2]\n    with pytest.raises(FilterError, match=\"Failed to store filtered values: Disk full\"):\n        service.filter_and_store(input_values)\n    mock_validator.filter_ints.assert_called_once_with(input_values)\n    mock_repo.save.assert_called_once_with([1, 2])\n\n# tests/test_controllers.py\nimport pytest\nfrom unittest.mock import Mock, call\nfrom intfilter.controllers import IntegerFilterController\nfrom intfilter.services import FilterService\nfrom intfilter.exceptions import InvalidInputError, FilterError\nfrom intfilter.models import ValueList # For mocking from_json\n\n@pytest.fixture\ndef mock_filter_service():\n    mock_service = Mock(spec=FilterService)\n    mock_service.filter.return_value = [1, 2]\n    return mock_service\n\n@pytest.fixture\ndef controller(mock_filter_service):\n    return IntegerFilterController(service=mock_filter_service)\n\ndef test_handle_delegates_to_service(controller, mock_filter_service):\n    input_values = [1, \"a\", 2, True]\n    result = controller.handle(input_values)\n    assert result == [1, 2]\n    mock_filter_service.filter.assert_called_once_with(input_values)\n\ndef test_handle_json_valid_input(controller, mock_filter_service):\n    json_str = '[1, \"b\", 2.0, 3]'\n    \n    # Mock ValueList.from_json static method directly\n    with patch('intfilter.models.ValueList.from_json', \n               return_value=ValueList([1, \"b\", 2.0, 3])) as mock_from_json:\n        result = controller.handle_json(json_str)\n        assert result == [1, 2] # This is mock_filter_service.filter's return\n        mock_from_json.assert_called_once_with(json_str)\n        mock_filter_service.filter.assert_called_once_with([1, \"b\", 2.0, 3])\n\ndef test_handle_json_empty_input(controller):\n    with pytest.raises(InvalidInputError, match=\"Empty JSON input received.\"):\n        controller.handle_json(\"\")\n\ndef test_handle_json_invalid_json_format(controller):\n    json_str = '{\"key\": \"value\"' # Malformed JSON\n    with patch('intfilter.models.ValueList.from_json', side_effect=InvalidInputError(\"Invalid JSON\")) as mock_from_json:\n        with pytest.raises(InvalidInputError, match=\"Invalid JSON\"):\n            controller.handle_json(json_str)\n        mock_from_json.assert_called_once_with(json_str)\n\ndef test_handle_json_service_filter_error(controller, mock_filter_service):\n    json_str = '[1, \"a\"]'\n    mock_filter_service.filter.side_effect = FilterError(\"Service failed\")\n    with patch('intfilter.models.ValueList.from_json', \n               return_value=ValueList([1, \"a\"])) as mock_from_json:\n        with pytest.raises(FilterError, match=\"Service failed\"):\n            controller.handle_json(json_str)\n        mock_from_json.assert_called_once_with(json_str)\n        mock_filter_service.filter.assert_called_once_with([1, \"a\"])\n\n# tests/test_cli.py\nimport pytest\nimport sys\nimport json\nfrom unittest.mock import patch, MagicMock\nfrom intfilter.cli import CLIApp, main as cli_main\nfrom intfilter.controllers import IntegerFilterController\nfrom intfilter.services import FilterService\nfrom intfilter.exceptions import InvalidInputError, FilterError\nfrom intfilter.repositories import FileRepository\n\n@pytest.fixture\ndef mock_controller():\n    mock_service = Mock(spec=FilterService)\n    mock_service.filter.return_value = [1, 2]\n    mock_controller = Mock(spec=IntegerFilterController)\n    mock_controller.handle.return_value = [1, 2]\n    mock_controller.handle_json.return_value = [1, 2]\n    return mock_controller\n\n@pytest.fixture\ndef cli_app(mock_controller):\n    return CLIApp(controller=mock_controller)\n\n@pytest.fixture\ndef mock_stdin(monkeypatch):\n    mock = MagicMock()\n    monkeypatch.setattr(sys, 'stdin', mock)\n    return mock\n\n@pytest.fixture\ndef mock_stdout(monkeypatch):\n    mock = MagicMock()\n    monkeypatch.setattr(sys, 'stdout', mock)\n    return mock\n\n@pytest.fixture\ndef mock_stderr(monkeypatch):\n    mock = MagicMock()\n    monkeypatch.setattr(sys, 'stderr', mock)\n    return mock\n\ndef test_cli_filter_reads_stdin_json(cli_app, mock_controller, mock_stdin, mock_stdout, mock_stderr):\n    mock_stdin.isatty.return_value = False # Simulate piped input\n    mock_stdin.read.return_value = '[1, \"a\", 2]'\n    \n    exit_code = cli_app.run([\"intfilter\", \"filter\"])\n    \n    assert exit_code == CLIApp.EXIT_SUCCESS\n    mock_controller.handle.assert_called_once_with([1, 'a', 2]) # handle is called now by cli_app.run_filter_command\n    mock_stdout.write.assert_called_once_with('[1, 2]\\n')\n    mock_stderr.write.assert_not_called()\n\ndef test_cli_filter_with_input_arg(cli_app, mock_controller, mock_stdout, mock_stderr):\n    input_json = '[1, \"b\", 3]'\n    exit_code = cli_app.run([\"intfilter\", \"filter\", f\"--input={input_json}\"])\n    \n    assert exit_co