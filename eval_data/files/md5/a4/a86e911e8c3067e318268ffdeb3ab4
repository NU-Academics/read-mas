{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string of nested parentheses into a list of balanced groups.\n    Ignores spaces and other non-parenthesis characters, returning canonicalized groups.\n    \"\"\"\n\n    # Helper function: _is_whitespace (defined inline as per critical requirements)\n    def _is_whitespace(ch: str) -> bool:\n        return ch in ' \\t\\n\\r\\f\\v'\n\n    # Helper function: _canonicalize_group (defined inline as per critical requirements)\n    # This filters out all non-parenthesis characters, ensuring only '(' and ')' remain.\n    def _canonicalize_group(s: str) -> str:\n        return ''.join(c for c in s if c in '()')\n\n    results: List[str] = []\n    buffer: List[str] = []\n    depth: int = 0\n\n    for ch in paren_string:\n        if _is_whitespace(ch):\n            continue\n\n        if ch == '(':\n            buffer.append(ch)\n            depth += 1\n        elif ch == ')':\n            buffer.append(ch)\n            depth -= 1\n            if depth == 0:\n                results.append(_canonicalize_group(''.join(buffer)))\n                buffer = []\n        # For any other character, it is ignored as per the simplest logic and\n        # the canonicalization step will ensure only parentheses are in the output.\n        # Critical requirements forbid raising exceptions for invalid characters.\n\n    return results"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if in given list of numbers, any two are closer than the threshold.\n    It sorts the list and checks adjacent elements for efficiency.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n    \n    arr = sorted(numbers)\n    for i in range(len(arr) - 1):\n        if abs(arr[i+1] - arr[i]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates a string containing multiple groups of nested parentheses into a list of canonicalized strings.\n    It ignores whitespace characters and assumes the input contains properly balanced top-level groups.\n    \"\"\"\n    cleaned_chars = []\n    for char in paren_string:\n        if char == '(' or char == ')':\n            cleaned_chars.append(char)\n    \n    cleaned_input = \"\".join(cleaned_chars)\n    \n    if not cleaned_input:\n        return []\n\n    groups = []\n    current_group_start_index = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_input):\n        if char == '(':\n            balance += 1\n        else: # char == ')'\n            balance -= 1\n\n        if balance == 0:\n            groups.append(cleaned_input[current_group_start_index : i + 1])\n            current_group_start_index = i + 1\n            \n    return groups"}
{"task_id": "HumanEval/0", "solution": "```python\nimport math\nfrom typing import List\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold. This implementation uses a sort-based approach for efficiency.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to enable efficient checking of adjacent differences.\n    # This addresses the O(n log n) performance requirement.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through the sorted numbers, checking the difference between adjacent elements.\n    # The comparison is strict: difference must be strictly less than the threshold.\n    for i in range(1, len(sorted_numbers)):\n        if (sorted_numbers[i] - sorted_numbers[i-1]) < threshold:\n            return True\n            \n    return False\n```"}
{"task_id": "HumanEval/2", "solution": "```python\nimport math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Returns the decimal part of a positive floating-point number.\n    The result is always in the range [0.0, 1.0).\n    \"\"\"\n    decimal_part = number - math.floor(number)\n    # Adjust for potential floating-point inaccuracies near 1.0.\n    if decimal_part >= 1.0 - 1e-12:\n        return 0.0\n    return decimal_part\n```"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, return its decimal part.\n    This implementation handles floating point inaccuracies.\n    \"\"\"\n    EPSILON: float = 2.220446049250313e-16\n\n    integer_part = math.floor(number)\n    fractional_part = number - integer_part\n\n    if abs(fractional_part) < EPSILON:\n        return 0.0\n    if abs(fractional_part - 1.0) < EPSILON:\n        return 0.0\n    return fractional_part"}
