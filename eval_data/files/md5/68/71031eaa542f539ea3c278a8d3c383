xt: Any) -> None:\n        if not isinstance(text, str):\n            raise ValueError(\"text must be a string\")\n\n    def is_safe_regex(self, pattern: str) -> bool:\n        if len(pattern) > self.MAX_PATTERN_LENGTH:\n            return False\n        if re.search(r\"(\\.\\*|\\.\\+|\\+\\?|\\*\\?)\\s*[\\)\\]]*\\s*[\\+\\*]\", pattern):\n            return False\n        return True\n\n    def validate_pattern(self, pattern: str) -> None:\n        if not isinstance(pattern, str):\n            raise ValueError(\"pattern must be a string\")\n        if not self.is_safe_regex(pattern):\n            raise ValueError(\"unsafe or too-complex regex pattern\")\nclass MatcherService:\n    DEFAULT_KEY = \"start_a_end_b\"\n\n    def __init__(self, pattern_repo: PatternRepository, regex_factory: RegexFactory, validator: Validator):\n        self.pattern_repo = pattern_repo\n        self.regex_factory = regex_factory\n        self.validator = validator\n\n    def matches(self, text: str, pattern_key: Optional[str] = None) -> MatchResult:\n        self.validator.validate_input(text)\n\n        key = pattern_key or self.DEFAULT_KEY\n        try:\n            pattern = self.pattern_repo.get_pattern(key)\n        except KeyError as e:\n            raise ValueError(f\"Unknown pattern key: {key}\") from e\n\n        self.validator.validate_pattern(pattern)\n\n        try:\n            compiled = self.regex_factory.compile(pattern)\n        except re.error as e:\n            raise RuntimeError(f\"Failed to compile pattern '{pattern}': {e}\") from e\n\n        m = compiled.fullmatch(text) if pattern.startswith(\"^\") and pattern.endswith(\"$\") else compiled.search(text)\n        if m:\n            return MatchResult(True, pattern, m.span(), m.group(0))\n        return MatchResult(False, pattern, None, None)\n\n    def matches_bool(self, text: str, pattern_key: Optional[str] = None) -> bool:\n        return self.matches(text, pattern_key).matched\nclass TextController:\n    def __init__