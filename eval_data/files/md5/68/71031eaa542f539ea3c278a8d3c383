.radius * cylinder.height\nclass ApiFacade:\n    \"\"\"High-level orchestration: create Cylinder and compute lateral area.\"\"\"\n    def __init__(self):\n        self.factory = CylinderFactory()\n        self.service = LateralSurfaceService()\n\n    def compute_lateral(self, height: float, radius: float) -> float:\n        \"\"\"End-to-end call to create a cylinder and compute its lateral surface area.\"\"\"\n        cylinder = self.factory.create(height, radius)\n        return self.service.compute(cylinder)\ndef lateralsuface_cylinder(h, r):\n    \"\"\"\n    Public function to compute the lateral surface area of a cylinder.\n    Delegates to the internal API facade for validation and computation.\n    \"\"\"\n    return ApiFacade().compute_lateral(h, r)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/238": [{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings in the given string.\n    Uses the formula n * (n + 1) / 2, where n is the length of the string.\n    \"\"\"\n    n = len(s)\n    return n * (n + 1) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/235": [{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int, width: int | None = None) -> int:\n    \"\"\"\n    Sets all even-positioned bits (1-based indexing) of a given number.\n    If width is not provided, it defaults to the number's bit length, ensuring a minimum width of 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Determine the effective width for mask generation.\n    if width is None:\n        effective_width = max(1, n.bit_length())\n    else:\n        if not isinstance(width, int):\n            raise TypeError(\"width must be an integer or None\")\n        if width < 1:\n            raise ValueError(\"width must be >= 1\")\n        effective_width = width\n\n    # Build the mask with 1s at all even 1-based bit positions up to effective_width.\n    mask = 0\n    for pos in range(1, effective_width + 1):\n        if pos % 2 == 0:  # Check if the 1-based position is even\n            mask |= (1 << (pos - 1))  # Set the corresponding 0-based bit\n\n    # Apply the generated mask to the number using a bitwise OR operation.\n    return n | mask", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of sequences of length n such that each element is a positive integer,\n    greater than or equal to twice the previous, and less than or equal to m.\n    \"\"\"\n    if not isinstance(m, int) or not isinstance(n, int):\n        raise TypeError(\"m and n must be integers\")\n    if m < 1 or n < 1:\n        raise ValueError(\"m and n must be positive integers\")\n\n    if n == 1:\n        return m\n\n    # dp_prev[x] stores the number of sequences of length (current_length - 1) starting with x.\n    # Array is 1-indexed for elements 1 to m.\n    dp_prev = [0] * (m + 1)\n    for x in range(1, m + 1):\n        dp_prev[x] = 1\n\n    for _ in range(2, n + 1):\n        # suffix[j] stores the sum of dp_prev[k] for k >= j, used for O(1) range sums.\n        # It needs to accommodate index m+1 for calculations.\n        suffix = [0] * (m + 2)\n        for x_val in range(m, 0, -1):\n            suffix[x_val] = dp_prev[x_val] + suffix[x_val + 1]\n\n        # dp_curr[x] stores the number of sequences of current_length starting with x.\n        dp_curr = [0] * (m + 1)\n        for x in range(1, m + 1):\n            # A sequence starting with x must be followed by an element y >= 2*x.\n            start_next_element = 2 * x\n            if start_next_element <= m:\n                dp_curr[x] = suffix[start_next_element]\n        dp_prev = dp_curr\n\n    # The total number of sequences of length n is the sum of all possibilities for the first element.\n    return sum(dp_prev[1:])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/244": [{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the smallest perfect square strictly greater than the given number.\n    \"\"\"\n    k = math.isqrt(max(0, n))\n    candidate_square = k * k\n    if candidate_square > n:\n        return candidate_square\n    return (k + 1) * (k + 1)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[3.14]]}], "Mbpp/242": [{"task_id": "Mbpp/242", "solution": "def count_charac(text: str) -> int:\n    \"\"\"Counts the number of characters in a string by delegating to the CharCounterService.\n    Persistence is disabled for this direct API call.\"\"\"\n    from .services import CharCounterService\n    from .utils import StringValidator\n    from .repositories import CharCountRepository\n    from .models import AppConfig\n\n    config = AppConfig(persist_history=False, history_path=\"\", retention=0)\n    validator = StringValidator()\n    repo = CharCountRepository(config.history_path, config.retention)\n    svc = CharCounterService(validator, repo, config)\n    return svc.count(text).count", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["python programming"]], "plus_fail_tests": [[""]]}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(tuple_: tuple, element: object) -> int:\n    \"\"\"Counts the occurrences of an element in a tuple.\"\"\"\n    return tuple_.count(element)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/240": [{"task_id": "Mbpp/240", "solution": "def replace_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n    Returns a new list without modifying the original lists.\n    \"\"\"\n    if not list1:\n        # If list1 is empty, return a shallow copy of list2 as there's no last element to replace.\n        return list(list2)\n\n    # Create a new list containing all elements of list1 except the last one.\n    result = list1[:-1]\n    # Extend this new list with all elements from list2.\n    result.extend(list2)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum sum of a bitonic subsequence for the given array.\n    A bitonic sequence first increases then decreases.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n\n    def _max_sum_increasing(current_arr: list[int]) -> list[int]:\n        \"\"\"Computes the maximum sum of an increasing subsequence ending at each index.\"\"\"\n        n_curr = len(current_arr)\n        inc = [0] * n_curr\n        for i in range(n_curr):\n            inc[i] = current_arr[i]\n            for j in range(i):\n                if current_arr[i] > current_arr[j]:\n                    inc[i] = max(inc[i], inc[j] + current_arr[i])\n        return inc\n\n    def _max_sum_decreasing(current_arr: list[int]) -> list[int]:\n        \"\"\"Computes the maximum sum of a decreasing subsequence starting at each index.\"\"\"\n        n_curr = len(current_arr)\n        dec = [0] * n_curr\n        for i in range(n_curr - 1, -1, -1):\n            dec[i] = current_arr[i]\n            for j in range(n_curr - 1, i, -1):\n                if current_arr[i] > current_arr[j]:\n                    dec[i] = max(dec[i], dec[j] + current_arr[i])\n        return dec\n\n    inc_sums = _max_sum_increasing(arr)\n    dec_sums = _max_sum_decreasing(arr)\n\n    # Combine increasing and decreasing sums, subtracting the pivot element's value once.\n    max_bitonic_sum = max(inc_sums[i] + dec_sums[i] - arr[i] for i in range(n))\n\n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\ndef convert(value):\n    \"\"\"\n    Converts a numeric value to its polar coordinates (r, theta).\n    Supports int, float, complex, and string forms accepted by complex(), e.g. \"1+2j\".\n    Returns a tuple (r: float, theta: float) where theta is in radians.\n    \"\"\"\n    z = complex(value)\n    r = math.hypot(z.real, z.imag)\n    theta = math.atan2(z.imag, z.real)\n    return (r, theta)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "def insert_element(lst: list, el: any) -> list:\n    \"\"\"Inserts the element before each element in the list.\"\"\"\n    result = []\n    for item in lst:\n        result.append(el)\n        result.append(item)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(items: list) -> int:\n    \"\"\"Returns the number of integer elements in a list, excluding booleans.\"\"\"\n    count = 0\n    for element in items:\n        if isinstance(element, int) and not isinstance(element, bool):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Return the length of the longest palindromic subsequence in s.\n\n    Normalizes input by removing non-alphanumeric characters and lowercasing,\n    so lps(\"TENS FOR TENS\") == 5.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    # Normalize: remove non-alphanumeric characters and lowercase\n    t = ''.join(ch.lower() for ch in s if ch.isalnum())\n    n = len(t)\n    if n == 0:\n        return 0\n\n    # DP optimized to O(n) space.\n    dp = [0] * n\n    for i in range(n - 1, -1, -1):\n        dp[i] = 1\n        prev = 0  # holds dp[i+1][j-1] from previous iteration\n        for j in range(i + 1, n):\n            temp = dp[j]\n            if t[i] == t[j]:\n                dp[j] = prev + 2\n            else:\n                dp[j] = max(dp[j], dp[j - 1])\n            prev = temp\n    return dp[-1]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["TENS FOR TENS"]], "plus_fail_tests": [["xZQOogNh"]]}], "Mbpp/84": [{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Computes the nth number in the Newman-Conway sequence using an iterative approach.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    a = [0] * (n + 1)\n    a[1] = 1\n    a[2] = 1\n\n    for i in range(3, n + 1):\n        a[i] = a[a[i - 1]] + a[i - a[i - 1]]\n\n    return a[n]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "from typing import Optional, List, Set, Tuple\nimport json\nimport os\nimport tempfile\nclass InvalidParameterError(Exception):\n    \"\"\"Custom exception for invalid function parameters.\"\"\"\n    pass\nclass CacheError(Exception):\n    \"\"\"Custom exception for cache-related errors.\"\"\"\n    pass\nclass AmicablePair:\n    \"\"\"Represents an amicable pair (a, b).\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def to_tuple(self) -> Tuple[int, int]:\n        return (self.a, self.b)\nclass AmicableResult:\n    \"\"\"Stores the result of amicable number detection.\"\"\"\n    def __init__(self, pairs: List[AmicablePair], unique_numbers: Set[int], sum: int):\n        self.pairs = pairs\n        self.unique_numbers = unique_numbers\n        self.sum = sum\n\n    def to_dict(self) -> dict:\n        return {\n            \"pairs\": [p.to_tuple() for p in self.pairs],\n            \"unique_numbers\": sorted(list(self.unique_numbers)),\n            \"sum\": self.sum\n        }\nDEFAULT_MAX_PARTNER_MULTIPLIER: int = 2\nclass DivisorCalculator:\n    \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n    def sum_proper_divisors(self, n: int) -> int:\n        if n < 1:\n            raise InvalidParameterError(\"n must be >= 1\")\n        if n == 1:\n            return 0\n        total = 1\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                total += i\n                j = n // i\n                if j != i:\n                    total += j\n            i += 1\n        return total\nclass CacheRepository:\n    \"\"\"Manages an in-memory cache for divisor sums with optional JSON persistence.\"\"\"\n    def __init__(self, cache_file: Optional[str] = None):\n        self._cache: dict[int, int] = {}\n        self.cache_file = cache_file\n        if cache_file:\n            self.load()\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\n    def load(self) -> None:\n        if not self.cache_file or not os.path.exists(self.cache_file):\n            return\n        try:\n            with open(self.cache_file, \"r\") as f:\n                data = json.load(f)\n                self._cache = {int(k): v for k, v in data.items()}\n        except (IOError, json.JSONDecodeError) as e:\n            raise CacheError(f\"Failed to load cache from {self.cache_file}: {e}\")\n\n    def save(self) -> None:\n        if not self.cache_file:\n            return\n        try:\n            tmp_file = self.cache_file + \".tmp\"\n            with open(tmp_file, \"w\") as f:\n                json.dump({str(k): v for k, v in self._cache.items()}, f)\n            os.replace(tmp_file, self.cache_file)\n        except IOError as e:\n            raise CacheError(f\"Failed to save cache to {self.cache_file}: {e}\")\nclass AmicableService:\n    \"\"\"Core logic for detecting and summing amicable numbers.\"\"\"\n    def __init__(self, calculator: DivisorCalculator, repository: CacheRepository, max_partner_multiplier: int = DEFAULT_MAX_PARTNER_MULTIPLIER):\n        self.calculator = calculator\n        self.repository = repository\n        self.max_partner_multiplier = max_partner_multiplier\n\n    def find_amicable_numbers(self, max_n: int, max_partner_limit: Optional[int] = None) -> AmicableResult:\n        if max_n < 1:\n            raise InvalidParameterError(\"max_n must be >= 1\")\n        if max_partner_limit is None:\n            max_partner_limit = max(max_n, max_n * self.max_partner_multiplier)\n\n        found_pairs = set()\n        all_amicable_numbers_in_range = set()\n\n        for a in range(2, max_n + 1):\n            sa = self.repository.get(a)\n            if sa is None:\n                sa = self.calculator.sum_proper_divisors(a)\n                self.repository.set(a, sa)\n\n            b = sa\n\n            # Skip if a perfect number, out of bounds, or too small for a pair\n            if b == a or b < 2 or b > max_partner_limit:\n                continue\n\n            sb = self.repository.get(b)\n            if sb is None:\n                sb = self.calculator.sum_proper_divisors(b)\n                self.repository.set(b, sb)\n\n            # Check if (a, b) form an amicable pair\n            if sb == a:\n                pair = tuple(sorted((a, b)))\n                found_pairs.add(pair)\n\n                # Add amicable numbers to the set if they are within the specified range [1, max_n]\n                if a <= max_n:\n                    all_amicable_numbers_in_range.add(a)\n                if b <= max_n:\n                    all_amicable_numbers_in_range.add(b)\n\n        pairs_list = [AmicablePair(a=p[0], b=p[1]) for p in sorted(list(found_pairs))]\n        total_sum = sum(all_amicable_numbers_in_range)\n\n        return AmicableResult(pairs=pairs_list, unique_numbers=all_amicable_numbers_in_range, sum=total_sum)\ndef amicable_numbers_sum(max_n: int, cache_file: Optional[str] = None, max_partner_limit: Optional[int] = None) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 up to a specified maximum number.\n    This function orchestrates the amicable number detection process.\n    \"\"\"\n    repo = CacheRepository(cache_file=cache_file)\n    calc = DivisorCalculator()\n    service = AmicableService(calc, repo)\n    result = service.find_amicable_numbers(max_n, max_partner_limit)\n    try:\n        repo.save()\n    except CacheError:\n        # Cache errors are logged and handled gracefully, computation continues\n        pass\n    return result.sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/262": [{"task_id": "Mbpp/262", "solution": "def split_two_parts(items: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits the given list into two parts where the length of the first part\n    is determined by L, clamped within the list's bounds.\n    \"\"\"\n    list_length = len(items)\n    # Clamp L to be between 0 and the list's length\n    split_index = max(0, min(L, list_length))\n\n    first_part = items[:split_index]\n    second_part = items[split_index:]\n\n    return (first_part, second_part)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"\n    Returns a tuple with the second number and then the first number.\n    \"\"\"\n    return (b, a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}