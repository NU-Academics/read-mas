, arr: Sequence[int]) -> int:\n        \"\"\"Returns the exact number of inversions in the given sequence.\"\"\"\n        a = list(arr)\n        _, count = self._sort_count(a)\n        return count\n\n    def _sort_count(self, arr: List[int]) -> Tuple[List[int], int]:\n        n = len(arr)\n        if n <= 1:\n            return arr, 0\n        mid = n // 2\n        left, left_count = self._sort_count(arr[:mid])\n        right, right_count = self._sort_count(arr[mid:])\n        merged, split_count = self._merge_count(left, right)\n        return merged, left_count + right_count + split_count\n\n    def _merge_count(self, left: List[int], right: List[int]) -> Tuple[List[int], int]:\n        i = j = 0\n        merged = []\n        count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i]); i += 1\n            else:\n                merged.append(right[j]); j += 1\n                count += len(left) - i\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, count\nclass InversionService:\n    \"\"\"Coordinates validation, algorithm execution, and optional persistence.\"\"\"\n    def __init__(self, repository: Optional[Any] = None) -> None:\n        self._validator = InputValidator()\n        self._algorithm = InversionAlgorithm()\n        self._repository = repository\n\n    def compute_and_maybe_persist(self, arr: Sequence[int], persist: bool = False) -> int:\n        \"\"\"Computes inversion count and optionally persists the result.\"\"\"\n        self._validator.validate_array(arr)\n        count = self._algorithm.count_inversions(arr)\n        return count\n_default_service = InversionService()\ndef get_Inv_Count(arr):\n    \"\"\"Calculates the number of inversions in an array.\n\n    An inversion is a pair of indices i, j such that i < j and arr[i] > arr[j].\n    \"\"\"\n    return _default_service.compute_and_maybe_persist(arr, persist=False)", "base_s