r = validator\n\n    def find_second_smallest(self, numbers: Sequence[float]) -> float:\n        self._validator.validate(numbers)\n        # One-pass approach to find the two smallest numbers\n        first = second = None\n        for x in numbers:\n            if first is None or x < first:\n                second = first\n                first = x\n            elif second is None or x < second:\n                second = x\n        assert second is not None\n        return float(second)\ndef second_smallest(numbers: list[float]) -> float:\n    \"\"\"Finds the second smallest number in a list of numbers.\"\"\"\n    service = SecondSmallestService(ListValidator())\n    return service.find_second_smallest(numbers)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 1, -0.5, 0, 2, -2, -2]]], "plus_fail_tests": [[[3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9]]]}], "Mbpp/753": [{"task_id": "Mbpp/753", "solution": "import heapq\nfrom dataclasses import dataclass\nfrom typing import Iterable, List, Tuple, Any, Callable\nclass ValidationError(Exception):\n    \"\"\"Exception for input validation problems.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef validate_and_normalize(records: Iterable[Any]) -> List[Record]:\n    \"\"\"Validates and normalizes an iterable of records into a list of Record objects.\"\"\"\n    normalized = []\n    for i, item in enumerate(records):\n        if isinstance(item, Record):\n            normalized.append(item)\n            continue\n        if not (isinstance(item, (list, tuple)) and len(item) == 2):\n            raise ValidationError(f\"Record at index {i} is not a 2-tuple/list: {item!r}\")\n        name, value = item\n        if not isinstance(name, str):\n            raise ValidationError(f\"Record name must be str at index {i}: {name!r}\")\n        try:\n            fval = float(value)\n        except Exception:\n            raise ValidationError(f\"Record value must be numeric at index {i}: {value!r}\")\n        normalized.append(Record(name=name, value=fval))\n    return normalized\ndef record_sort_key(record: Record) -> Tuple[float, str]:\n    \"\"\"Key function for sorting records by value then name.\"\"\"\n    return (record.value, record.name)\ndef to_tuple_list(records: Iterable[Record]) -> List[Tuple[str, int]]:\n    \"\"\"Converts a list of Record objects back to a list of (name, int_value) tuples, truncating float values.\"\"\"\n    return [(r.name, int(r.value)) for r in records]\nclass MinKService:\n    \"\"\"Provides the core algorithm for selecting k smallest records.\"\"\"\n    def __init__(self, repository=None, compare_key: Callable[[Record], Tuple[float,str]]=None):\n        self.repository = repository\n        self.compare_key = compare_key or record_sort_key\n\n    def min_k(self, records: Iterable, k: int) -> List[Tuple[str, int]]:\n        \"\"\"Computes the k smallest records from an iterable.\"\"\"\n        if not isinstance(k, int):\n            raise ValidationError(\"k must be an integer\")\n        if k <= 0:\n            raise ValidationError(\"k must be greater than 0\")\n\n        normalized = validate_and_normalize(records)\n        result_records = self._compute_min_k(normalized, k)\n        return to_tuple_list(result_records)\n\n    def _compute_min_k(self, records: List[Record], k: int) -> List[Record]:\n        \"\"\"Uses heapq.nsmallest to efficiently find the k smallest records.\"\"\"\n        if len(records) == 0:\n            return []\n\n        effective_k = min(k, len(records))\n        if effective_k == 0:\n            return []\n\n        return heapq.nsmallest(effective_k, records, key=self.compare_key)\nclass APIController:\n    \"\"\"A thin adapter exposing min_k functionality for library callers.\"\"\"\n    @staticmethod\n    def min_k_api(records: Iterable[Any], k: int) -> List[Tuple[str, int]]:\n        \"\"\"Instantiates MinKService and delegates the request to it.\"\"\"\n        service = MinKService()\n        return service.min_k(records, k)\ndef min_k(records: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"Finds the minimum k records from a list of (name, value) tuples.\"\"\"\n    return APIController.min_k_api(records, k)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/759": [{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with exactly two digits of fractional precision.\n    Handles optional leading sign and ignores leading/trailing whitespace.\n    \"\"\"\n    # Pattern: optional sign, at least one digit before the dot (or allow zero?), a dot, exactly two digits after dot.\n    # Use at least one digit before the dot to disallow inputs like '.12' unless you want to allow them.\n    pattern = r'^[+-]?\\d+\\.\\d{2}$'\n\n    # Ensure input is a string\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n\n    stripped_s = s.strip()\n    return re.fullmatch(pattern, stripped_s) is not None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-123.11"]]}], "Mbpp/760": [{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    This function returns True if all elements are identical, otherwise False.\n    \"\"\"\n    if not numbers:\n        return False\n    return len(set(numbers)) == 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/762": [{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a month with 30 days.\n    Months are numbered 1 to 12.\n    \"\"\"\n    months_with_30_days = {4, 6, 9, 11}\n    return month_