):\n    \"\"\"Custom exception for duplicate removal errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\nclass UniqueNumsRequest:\n    \"\"\"DTO for input iterables.\"\"\"\n    def __init__(self, lists: List[Iterable[int]]):\n        self.lists = lists\n\n    def validate(self) -> None:\n        \"\"\"Validates that inputs are iterables.\"\"\"\n        if not self.lists:\n            return\n        for it in self.lists:\n            if not hasattr(it, \"__iter__\"):\n                raise DuplicateRemovalError(\"Each argument must be an iterable of integers.\")\nclass UniqueNumsResponse:\n    \"\"\"DTO for output unique numbers.\"\"\"\n    def __init__(self, uniques: List[int]):\n        self.uniques = uniques\nclass InMemoryRepository:\n    \"\"\"Optional in-memory storage for requests.\"\"\"\n    def __init__(self) -> None:\n        self._storage: List[UniqueNumsRequest] = []\n\n    def store_request(self, request: UniqueNumsRequest) -> None:\n        self._storage.append(request)\n\n    def get_all(self) -> List[UniqueNumsRequest]:\n        return self._storage\nclass NumUtils:\n    \"\"\"Utility functions for counting and filtering numbers.\"\"\"\n    @staticmethod\n    def count_occurrences(iterables: Iterable[Iterable[int]]) -> Tuple[Dict[int,int], Dict[int,int]]:\n        \"\"\"Counts occurrences and records first-seen index for each number.\"\"\"\n        counts: Dict[int,int] = defaultdict(int)\n        first_seen: Dict[int,int] = {}\n        index = 0\n        for iterable in iterables:\n            for item in iterable:\n                if not isinstance(item, int):\n                    raise DuplicateRemovalError(f\"Non-integer item encountered: {item!r}\")\n                counts[item] += 1\n                if item not in first_seen:\n                    first_seen[item] = index\n                index += 1\n        return counts, first_seen\n\n    @staticmethod\n    def filter_uniques(counts: Dict[int,int], first_seen: Dict[int,int]) -> List[int]:\n        \"\"\"Filters numbers that appear exactly once, preserving first-seen order.\"\"\"\n        uniques = [num for num, cnt in counts.items() if cnt == 1]\n        return sorted(uniques, key=lambda x: first_seen[x])\nclass UniqueNumService:\n    \"\"\"Core logic for processing and finding unique numbers.\"\"\"\n    def __init__(self, repo: InMemoryRepository | None = None):\n        self.repo = repo\n\n    def process(self, request: UniqueNumsRequest) -> List[int]:\n        \"\"\"Processes the request to find unique numbers.\"\"\"\n        counts, first_seen = NumUtils.count_occurrences(request.lists)\n        uniques = NumUtils.filter_uniques(counts, first_seen)\n        if self.repo:\n            self.repo.store_request(request)\n        return uniques\nclass UniqueNumsController:\n    \"\"\"Validates requests and orchestrates service calls.\"\"\"\n    def __init__(self, repo: InMemoryRepository | None = None):\n        self.service = UniqueNumService(repo=repo)\n\n    def handle(self, request: UniqueNumsRequest) -> UniqueNumsResponse:\n        \"\"\"Handles the request to find unique numbers.\"\"\"\n        request.validate()\n        uniques = self.service.process(request)\n        return UniqueNumsResponse(uniques=uniques)\nclass UniqueNumsAPI:\n    \"\"\"Public API facade for removing duplicate numbers.\"\"\"\n    def __init__(self, repo: InMemoryRepository | None = None):\n        self._repo = repo\n\n    def two_unique_nums(self, *lists: Iterable[int]) -> List[int]:\n        \"\"\"\n        Returns numbers that appear exactly once across all provided iterables.\n        Preserves the first-occurrence order of unique items.\n        \"\"\"\n        # Ensure *lists is handled correctly, even if a single iterable is passed directly\n        if len(lists) == 1 and isinstance(lists[0], (list, tuple, set)): # Heuristic for single list argument vs multiple args\n            request_lists = [lists[0]]\n        else:\n            request_lists = list(lists)\n\n        request = UniqueNumsRequest(request_lists)\n        controller = UniqueNumsController(repo=self._repo)\n        response = controller.handle(request)\n        return response.uniques\ndef two_unique_nums(*lists: Iterable[int]) -> List[int]:\n    \"\"\"\n    Returns numbers that appear exactly once across all provided iterables.\n    Preserves the first-occurrence order of unique items.\n    \"\"\"\n    api = UniqueNumsAPI()\n    return api.two_unique_nums(*lists)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-0.9997483195812293, 8.805625175692413]]]}], "Mbpp/577": [{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit in factorial of a given non-negative number n.\n    For n >= 5, the last digit of n! is 0.\n\n    Args:\n        n: non-negative integer\n\n    Returns:\n        int: last digit of n!\n\n    Raises:\n        ValueError: if n is negative or not an integer\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(f\"n must be an integer, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n >= 5:\n        return 0\n    elif n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[2.5]]}], "Mbpp/576": [{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack, needle):\n    \"\"\"\n    Checks if a list (needle) is a contiguous sublist of another list (haystack).\n    An empty needle is considered a sublist of any haystack.\n    \"\"\"\n    len_needle = len(needle)\n    len_haystack = len(haystack)\n\n    if len_needle == 0:\n        return True\n\n    if len_needle > len_haystack:\n        return False\n\n   