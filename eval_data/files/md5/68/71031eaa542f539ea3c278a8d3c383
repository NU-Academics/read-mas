 # Found a complete match\n        elif i < n and main_list[i] != sublist[j]:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/65": [{"task_id": "Mbpp/65", "solution": "import collections.abc\ndef recursive_list_sum(data):\n    \"\"\"\n    Flattens a nested list (or iterable) of arbitrary depth and sums all numeric elements.\n    Only int and float are considered numeric. Strings/bytes are not treated as iterables here.\n    \"\"\"\n    ALLOWED_NUMERIC_TYPES = (int, float)\n\n    def _flatten_iter(obj):\n        if isinstance(obj, ALLOWED_NUMERIC_TYPES):\n            yield obj\n        elif isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes)):\n            for item in obj:\n                yield from _flatten_iter(item)\n        else:\n            # Non-iterable or unsupported types are ignored.\n            return\n\n    return float(sum(_flatten_iter(data)))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/63": [{"task_id": "Mbpp/63", "solution": "import collections.abc\nfrom typing import Iterable, Tuple, Any, Union, List, Sequence\nclass InvalidTupleError(ValueError):\n    \"\"\"Raised when an input item is not a 2-element tuple.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\nclass TupleValidator:\n    \"\"\"Validates input items to ensure they are 2-element sequences.\"\"\"\n    def validate_list(self, tuples: Iterable[Any]) -> List[Tuple[Any, Any]]:\n        lst = list(tuples)\n        for item in lst:\n            self.validate_tuple(item)\n        return lst\n\n    def validate_tuple(self, item: Any) -> Tuple[Any, Any]:\n        try:\n            size = len(item)\n        except TypeError:\n            raise InvalidTupleError(f\"Each item must be a 2-element tuple, got {item!r}\")\n        if size != 2:\n            raise InvalidTupleError(f\"Each item must be a 2-element tuple, got {item!r}\")\n        return item\nclass MaxDifferenceService:\n    \"\"\"Computes the maximum absolute difference between elements.\"\"\"\n    def compute_max_difference(self, tuples: Sequence[Tuple[Any, Any]], default: Union[int, float] = 0) -> Union[int, float]:\n        return max((abs(a - b) for a, b in tuples), default=default)\ndef max_difference(tuple_list: Iterable[Tuple[Any, Any]]) -> Union[int, float]:\n    \"\"\"\n    Compute the maximum absolute difference between elements of each 2-element tuple.\n    Returns 0 for an empty list; raises InvalidTupleError if any item is not length 2.\n    \"\"\"\n    validator = TupleValidator()\n    validated = validator.validate_list(tuple_list)\n    service = MaxDifferenceService()\n    return service.compute_max_difference(validated, default=0)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/72": [{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"\n    Determines if an integer can be represented as the difference of two integer squares.\n    This is true if n is 0, or if its absolute value is odd, or if its absolute value is a multiple of 4.\n    \"\"\"\n    if n == 0:\n        return True\n\n    abs_n = abs(n)\n    return abs_n % 2 != 0 or abs_n % 4 == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/71": [{"task_id": "Mbpp/71", "solution": "def comb_sort(data):\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    n = len(data)\n    if n <= 1:\n        return list(data)\n\n    arr = list(data)  # Work on a copy to not modify the original list\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Update the gap 