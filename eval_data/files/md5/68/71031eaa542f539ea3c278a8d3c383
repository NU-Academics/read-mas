form sort in-place.\n    n = len(arr)\n\n    # If the array has 0 or 1 element, it is already sorted.\n    if n <= 1:\n        return arr\n\n    # Apply gapped insertion sort for each gap in the sequence.\n    for gap in _gap_sequence(n):\n        _insertion_gap_sort(arr, gap)\n\n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/429": [{"task_id": "Mbpp/429", "solution": "def and_tuples(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the elementwise bitwise AND of two tuples.\n    Assumes inputs are tuples of equal length containing integers.\n    \"\"\"\n    return tuple(x & y for x, y in zip(a, b))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/433": [{"task_id": "Mbpp/433", "solution": "def check_greater(array, value):\n    \"\"\"\n    Checks if the given value is strictly greater than every element in the array.\n    Returns False if the array is empty or if any element is not strictly less than the value.\n    \"\"\"\n    if not array:\n        return False\n\n    for element in array:\n        if value <= element:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[], 10]]}], "Mbpp/435": [{"task_id": "Mbpp/435", "solution": "def last_Digit(num):\n    \"\"\"\n    Finds the last digit of a given number, treating negative numbers as their absolute value.\n    \"\"\"\n    return abs(int(num)) % 10", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/432": [{"task_id": "Mbpp/432", "solution": "def median_trapezium(base_a: float, base_b: float, other: float | None = None) -> float:\n    \"\"\"Computes the median (midline) length of a trapezium.\"\"\"\n    return (base_a + base_b) / 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/436": [{"task_id": "Mb