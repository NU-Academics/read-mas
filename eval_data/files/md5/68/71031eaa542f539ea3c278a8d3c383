dated\nclass MultiplyService:\n    \"\"\"Performs core arithmetic: compute product then divide by count.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def multiply_and_divide(self, values: Any) -> float:\n        \"\"\"Validates input, computes product, and divides by count.\"\"\"\n        vals = self._validator.validate(values)\n        product = multiply_iter(vals)\n        count = len(vals)\n        return product / float(count)\n\n    def _compute_product(self, values: List[float]) -> float:\n        \"\"\"Internal helper to compute the product of a list of floats.\"\"\"\n        return multiply_iter(values)\nclass MultiplyController:\n    \"\"\"High-level orchestration: validate input and call service to produce ProductResult.\"\"\"\n    def __init__(self, service: MultiplyService, validator: InputValidator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def compute(self, values: Any) -> ProductResult:\n        \"\"\"Validate values, compute product/count/result, and return ProductResult.\"\"\"\n        validated_vals = self._validator.validate(values)\n\n        product = multiply_iter(validated_vals)\n        count = len(validated_vals)\n        result = product / float(count)\n\n        return ProductResult(product=product, count=count, result=result)\n_default_validator = InputValidator()\n_default_service = MultiplyService(_default_validator)\n_default_controller = MultiplyController(_default_service, _default_validator)\ndef multiply_num(values: Iterable) -> float:\n    \"\"\"Public API: compute product of values divided by count.\"\"\"\n    return _default_controller.compute(values).result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/100": [{"task_id": "Mbpp/100", "solution": "class NumberUtils:\n    @staticmethod\n    def is_palindrome(s: str) -> bool:\n        \"\"\"Checks if a string (representing an absolute number) is a palindrome.\"\"\"\n        s = s.lstrip('-')\n        return s == s[::-1]\n\n    @staticmethod\n    def mirror_left_to_right(s: str) -> str:\n        \"\"\"Mirrors the left half of a string to its right half, preserving length and sign.\"\"\"\n        neg = s.startswith('-')\n        if neg:\n            s = s[1:]\n        n = len(s)\n        left = s[:n//2]\n        mid = s[n//2] if n % 2 else ''\n        right = left[::-1]\n        res = left + (mid if mid else '') + right\n        return ('-' + res) if neg else res\n\n    @staticmethod\n    def compare_str_nums(a: str, b: str) -> int:\n        \"\"\"Compares two numeric strings as integers, returning -1, 0, or 1.\"\"\"\n        int_a = int(a)\n        int_b = int(b)\n        if int_a < int_b:\n            return -1\n        elif int_a == int_b:\n            return 0\n        else:\n            return 1\n\n    @staticmethod\n    def increment_middle(s: str) -> str:\n        \"\"\"Increments the middle portion of a numeric string, handling carry-over.\"\"\"\n        n_len = len(s)\n        left_half_len = n_len // 2\n        mid_len = n_len % 2\n\n        prefix_to_inc_str = s[:left_half_len + mid_len]\n\n        incremented_prefix_int = int(prefix_to_inc_str) + 1\n        incremented_prefix_str = str(incremented_prefix_int)\n\n        if len(incremented_prefix_str) > len(prefix_to_inc_str):\n            # If the prefix increment caused a length expansion (e.g., '9' -> '10'),\n            # the resulting palindrome will have n_len + 1 digits, like 101 for 99.\n            return '1' + '0' * (n_len - 1) + '1'\n        else:\n            # Length did not expand, simply re-construct the string.\n            return incremented_prefix_str + s[left_half_len + mid_len:]\n\n    @staticmethod\n    def next_palindrome_from_str(s: str) -> str:\n        \"\"\"Computes the next smallest palindrome string strictly greater than the input string `s`.\"\"\"\n        num = int(s)\n        if num < 0:\n            return \"0\"\n        if s == \"0\":\n            return \"1\"\n\n        # Attempt 1: Mirror the left half to the right.\n        # Example: s=\"12345\" -> candidate1=\"12321\"\n        candidate1_str = NumberUtils.mirror_left_to_right(s)\n\n        if NumberUtils.compare_str_nums(candidate1_str, s) == 1:  # If candidate1_str > s\n            return candidate1_str\n\n        # Attempt 2: Increment the middle part of s, then mirror the new string.\n        s_incremented_middle = NumberUtils.increment_middle(s)\n\n        # Mirroring after incrementing the middle will produce the correct next palindrome.\n        candidate2_str = NumberUtils.mirror_left_to_right(s_incremented_middle)\n        return candidate2_str\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Computes the next smallest palindrome integer strictly greater than the given integer n.\n    \"\"\"\n    s = str(n)\n    pal_str = NumberUtils.next_palindrome_from_str(s)\n    return int(pal_str)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/102": [{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_str: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase).\"\"\"\n\n    if not snake_str:\n        return \"\"\n\n    # Split the string by underscore after stripping whitespace,\n    # then filter out any empty tokens (handles multiple, leading, trailing underscores).\n    tokens = [token for token in snake_str.strip().split(\"_\") if token]\n\n    # Capitalize the first letter of each token and convert the rest to lowercase,\n    # then join them to form the CamelCase string.\n    camel_parts = [token[0].upper() + token[1:].lower() for token in tokens]\n\n    return \"\".join(camel_parts)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["___python_program"]]}], "Mbpp/103": [{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number A(n, m) using dynamic programming with rolling rows.\"\"\"\n    if n == 0:\n        return 1 if m == 0 else 0\n    if m < 0 or m >= n:\n        return 0\n\n    # `prev_row` stores the Eulerian numbers for row `i-1`.\n    prev_row = [1]  # A(0,0)=1 is the base for i=0.\n\n    # Iterate from i=1 up to n to compute each row.\n    for i in range(1, n + 1):\n        # `curr_row` will store A(i, 0), ..., A(i, i-1). It has `i` elements.\n        curr_row = [0] * i\n\n        # Compute A(i, k) for k from 0 to i-1 using the recurrence relation.\n        for k in range(i):\n            # Recurrence: A(i, k) = (i-k)*A(i-1, k-1) + (k+1)*A(i-1, k)\n\n            # Calculate (i-k)*A(i-1, k-1) term\n            left_term = 0\n            if k >= 1:  # A(i-1, k-1) is valid if k-1 is non-negative.\n                left_term = (i - k) * prev_row[k - 1]\n\n            # Calculate (k+1)*A(i-1, k) term\n            right_term = 0\n            if k < len(prev_row):  # A(i-1, k) is valid if k is within the bounds of prev_row.\n                right_term = (k + 1) * prev_row[k]\n\n            curr_row[k] = left_term + right_term\n\n        prev_row = curr_row  # Set `curr_row` as `prev_row` for the next iteration.\n\n    # After the loop, `prev_row` contains A(n, 0), ..., A(n, n-1).\n    return prev_row[m]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/106": [{"task_id": "Mbpp/106", "solution": "def add_lists(items: list, base: tuple) -> tuple:\n    \"\"\"\n    Appends elements from a list to the end of a tuple, returning a new tuple.\n    This function delegates the operation to an internal application controller.\n    \"\"\"\n    from .controller import AppController\n    controller = AppController()\n    return controller.add_lists(items=items, base=base)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[5, 6, 7], [9, 10]]], "plus_fail_tests": [[[], [1, 2, 3]]]}], "Mbpp