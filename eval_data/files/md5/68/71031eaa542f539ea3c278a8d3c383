e_with_eq(request.source, request.to_remove)\n\n        result = FilterResult(filtered)\n\n        if self._repository:\n            self._repository.save_result(result)\n\n        return result\n\n    def _validate_request(self, request: FilterRequest) -> None:\n        \"\"\"Validates that the request and its constituent lists are not None.\"\"\"\n        if request is None:\n            raise InvalidInputError(\"Request cannot be None.\")\n        if not isinstance(request.source, list) or not isinstance(request.to_remove, list):\n             raise InvalidInputError(\"source and to_remove must be lists.\")\ndef remove_elements(source: List[Any], to_remove: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    Preserves the order of elements from the source list.\n    \"\"\"\n    svc = ListFilterService()\n    req = FilterRequest(source=source, to_remove=to_remove)\n    return svc.remove_elements(req).as_list()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[94.69906992408676, 5, 5, false, [4.5, [31, -44, 5, 56, 0, 12, 75], true, null], true, 12, 7], []]]}], "Mbpp/166": [{"task_id": "Mbpp/166", "solution": "from typing import List, Optional, Iterable, Any, Dict\nfrom abc import ABC, abstractmethod\nclass InputValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates that input is an iterable of integers.\"\"\"\n    def validate(self, nums: Iterable[Any]) -> None:\n        if nums is None:\n            raise InputValidationError(\"Input is None; expected iterable of ints.\")\n        if not hasattr(nums, \"__iter__\"):\n            raise InputValidationError(\"Input is not iterable.\")\n        for i, v in enumerate(nums):\n            if not isinstance(v, int):\n                raise InputValidationError(f\"Element at index {i} is not int: {v!r}\")\nclass PairStats:\n    \"\"\"Holds simple repository metrics like last result and call count.\"\"\"\n    def __init__(self, last_result: int = 0, call_count: int = 0) -> None:\n        self.last_result = last_result\n        self.call_count = call_count\n\n    def to_dict(self) -> Dict[str, int]:\n        return {\"last_result\": self.last_result, \"call_count\": self.call_count}\n\n    @staticmethod\n    def from_dict(d: Dict[str, int]) -> 'PairStats':\n        return PairStats(d.get(\"last_result\", 0), d.get(\"call_count\", 0))\nclass PairCounterRepository(ABC):\n    \"\"\"Abstract base class for a repository to record pair counts.\"\"\"\n    @abstractmethod\n    def record(self, result: int) -> None:\n        pass\n\n    @abstractmethod\n    def get_stats(self) -> PairStats:\n        pass\nclass InMemoryPairCounterRepository(PairCounterRepository):\n    \"\"\"An in-memory implementation of PairCounterRepository for tracking metrics.\"\"\"\n    def __init__(self) -> None:\n        self._stats = PairStats()\n\n    def record(self, result: int) -> None:\n        self._stats.last_result = result\n        self._stats.call_count += 1\n\n    def get_stats(self) -> PairStats:\n        return self._stats\n\n    def reset(self) -> None:\n        self._stats = PairStats()\nclass EvenPairService:\n    \"\"\"Computes the number of unordered pairs of integers with an even XOR sum.\"\"\"\n    def __init__(self, repo: Optional[PairCounterRepository] = None) -> None:\n        self._repo = repo\n\n    def _count_by_parity(self, nums: List[int]) -> tuple[int, int]:\n        evens = odds = 0\n        for v in nums:\n            if v & 1:  # Check if odd using bitwise AND\n                odds += 1\n            else:\n                evens += 1\n        return evens, odds\n\n    def count_pairs(self, nums: List[int]) -> int:\n        evens, odds = self._count_by_parity(nums)\n        # Pairs of numbers with the same parity XOR to an even number.\n        # Calculate combinations C(n, 2) = n * (n - 1) // 2 for evens and odds.\n        result = evens * (evens - 1) // 2 + odds * (odds - 1) // 2\n        if self._repo:\n            self._repo.record(result)\n        return result\nclass EvenPairController:\n    \"\"\"Orchestrates input validation and pair counting logic.\"\"\"\n    def __init__(self, service: EvenPairService, validator: InputValidator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def find_even_pair(self, nums: List[int]) -> int:\n        self._validator.validate(nums)\n        return self._service.count_pairs(nums)\n_default_even_pair_controller = EvenPairController(\n    service=EvenPairService(repo=InMemoryPairCounterRepository()),\n    validator=InputValidator(),\n)\ndef find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of integers in a list that XOR to an even number.\n    This function uses an internal service and validator for computation and input checks.\n    \"\"\"\n    return _default_even_pair_controller.find_even_pair(nums)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ... including only positive terms.\n    Examples:\n      sum_series(6) == 12  # terms: 6,4,2 -> sum = 12\n      sum_series(5) == 9   # terms: 5,3,1 -> sum = 9\n      sum_series(0) == 0\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n    # Use arithmetic series formula: sum = count * (first + last) / 2\n    if n % 2 == 0:\n        # even n: terms = n, n-2, ..., 2 -> count = n//2, last = 2\n        count = n // 2\n        first = n\n        last = 2\n    else:\n        # odd n: terms = n, n-2, ..., 1 -> count = (n+1