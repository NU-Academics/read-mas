"Custom exception to signal invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Utils:\n    \"\"\"Provides utility methods for type checking, conversion, and serialization.\"\"\"\n    @staticmethod\n    def is_hashable(obj: Any) -> bool:\n        \"\"\"Determines if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    @staticmethod\n    def to_iterable(items: Any) -> List[Any]:\n        \"\"\"Converts input into a list, raising errors for invalid types.\"\"\"\n        if items is None:\n            raise ValueError(\"items cannot be None\")\n        if isinstance(items, str):\n            raise ValueError(\"strings not allowed as sequence of items\")\n        try:\n            if isinstance(items, (list, tuple)):\n                # If already a list or tuple, return it directly for efficiency.\n                return items\n            # For other iterables (e.g., generators), consume them into a list.\n            return list(items)\n        except TypeError:\n            raise ValueError(\"Provided object is not iterable\")\n\n    @staticmethod\n    def safe_serialize(obj: Any) -> str:\n        \"\"\"Serializes an object to a JSON-like string, using repr as fallback.\"\"\"\n        try:\n            return json.dumps(obj, default=lambda o: repr(o), ensure_ascii=False)\n        except Exception:\n            return repr(obj)\nclass ListRepository:\n    \"\"\"Handles saving and loading of list snapshots to/from the filesystem.\"\"\"\n    def __init__(self, snapshot_dir: str) -> None:\n        self.snapshot_dir = os.path.expanduser(snapshot_dir)\n        os.makedirs(self.snapshot_dir, exist_ok=True)\n\n    def save_snapshot(self, items: Iterable[Any]) -> str:\n        \"\"\"Saves an iterable of items as a JSON snapshot file.\"\"\"\n        arr = list(items)\n        raw = json.dumps(arr, default=lambda o: repr(o), ensure_ascii=False)\n        h = hashlib.sha1(raw.encode('utf-8')).hexdigest()[:8]\n        name = f\"snapshot-{time.strftime('%Y%m%dT%H%M%S')}-{h}.json\"\n        path = os.path.join(self.snapshot_dir, name)\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            f.write(raw)\n        return path\n\n    def load_snapshot(self, filename: str) -> List[Any]:\n        \"\"\"Loads a list from a JSON snapshot file.\"\"\"\n        path = os.path.join(self.snapshot_dir, filename)\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n\n    def list_snapshots(self) -> List[str]:\n        \"\"\"Lists available snapshot filenames in the repository directory.\"\"\"\n        return [f for f in os.listdir(self.snapshot_dir) if f.startswith(\"snapshot-\") and f.endswith(\".json\")]\nclass UniqueChecker:\n    \"\"\"Core logic to determine uniqueness with performance strategies.\"\"\"\n    def __init__(self, max_items_for_hashing: int) -> None:\n        self._max_items_for_hashing = max_items_for_hashing\n\n    def all_unique(self, items: Iterable[Any]) -> bool:\n        \"\"\"Checks if all elements in the iterable are unique, using hashable or equality paths.\"\"\"\n        try:\n            # Ensure items is a list or tuple for consistent length checking and re-iterability.\n            items_list = Utils.to_iterable(items)\n\n            if len(items_list) > self._max_items_for_hashing:\n                raise ValueError(\n                    f\"Input size ({len(items_list)}) exceeds \"\n                    f\"configured safety threshold ({self._max_items_for_hashing}).\"\n                )\n\n            # Try hashable fast path\n            return self._hashable_path(items_list)\n        except TypeError: # This TypeError occurs if _hashable_path tries to add an unhashable item to a set.\n            return self._equality_path(items_list)\n        except ValueError as e: # Catch ValueErrors from Utils.to_iterable or the length check\n            raise InvalidInputError(str(e)) # Re-raise as InvalidInputError for input validation failures.\n\n    def _hashable_path(self, items: Iterable[Any]) -> bool:\n        \"\"\"Checks for uniqueness using a set for hashable items.\"\"\"\n        seen = set()\n        # The `max_items_for_hashing` check is assumed to be handled by the caller (all_unique method's len check).\n        # This iteration now directly consumes the prepared iterable.\n        for x in items:\n            seen.add(x)\n        return len(seen) == len(list(items)) # len(list(items)) re-evaluates the length, safer.\n                                             # For a list, len(items) is efficient.\n\n    def _equality_path(self, items: Iterable[Any]) -> bool:\n        \"\"\"Checks for uniqueness using serialized keys for unhashable items.\"\"\"\n        seen_serialized = set()\n        for x in items:\n            serialized_x = Utils.safe_serialize(x)\n            if serialized_x in seen_serialized:\n                return False\n            seen_serialized.add(serialized_x)\n        return True\nDEFAULT_MAX_ITEMS_FOR_HASHING = 100000\nclass AllUniqueAPI:\n    \"\"\"Facade for uniqueness checks, orchestrating UniqueChecker and optional persistence.\"\"\"\n    def __init__(self, max_items_for_hashing: int = DEFAULT_MAX_ITEMS_FOR_HASHING,\n                 snapshot_dir: Optional[str] = None) -> None:\n        self._max_items_for_hashing = max_items_for_hashing\n        self._checker = UniqueChecker(max_items_for_hashing)\n        self._repository = ListRepository(snapshot_dir) if snapshot_dir else None\n\n    def all_unique(self, items: Iterable[Any]) -> bool:\n        \"\"\"Checks if all elements in the given iterable are unique.\"\"\"\n        if items is None:\n            raise InvalidInputError(\"items must not be None\")\n        result = self._checker.all_unique(items)\n        return result\n\n    def save_snapshot(self, items: Iterable[Any]) -> str:\n        \"\"\"Saves a snapshot of the given items to the configured repository.\"\"\"\n        if not self._repository:\n            raise RuntimeError(\"No repository configured for snapshots.\")\n        return self._repository.save_snapshot(items)\ndef all_unique(items):\n    \"\"\"Checks if all elements in the given list or iterable are unique.\"\"\"\n    api = AllUniqueAPI()\n    return api.all_unique(items)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/290": [{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Optional, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, Optional[List[Any]]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list encountered with that length.\n    \"\"\"\n    max_len = 0\n    example = None\n\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)\n        if current_len > max_len:\n            max_len = current_len\n            example = inner_list\n\n    return max_len, example", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[]]]]}], "Mbpp/292": [{"task_id": "Mbpp/292", "solution": "def find(a: float | int, b: float | int) -> int:\n    \"\"\"\n    Calculates the quotient of two numbers, rounded down to the nearest integer (floor division).\n    \"\"\"\n    return int(a // b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/293": [{"task_id": "Mbpp/293", "solution": "def otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"Calculates the hypotenuse of a right-angled triangle given two legs.\"\"\"\n    import math\n    return math.hypot(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/286": [{"task_id": "Mbpp/286", "solution": "from typing import List\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n\n    # Helper function for standard Kadane's algorithm.\n    def _kadane(nums: List[int]) -> int:\n        max_ending_here = nums[0]\n        max_so_far = nums[0]\n        for x in nums[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    # Helper function for Kadane's algorithm applied to a logically doubled array.\n    def _kadane_double(nums: List[int]) -> int:\n        max_ending_here = nums[0]\n        max_so_far = nums[0]\n        N = len(nums)\n        for i in range(1, 2 * N):\n            x = nums[i % N]\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    # If k is 1, simply apply standard Kadane's algorithm.\n    max_sum_one_copy = _kadane(arr)\n    if k == 1:\n        return max_sum_one_copy\n\n    # For k > 1, consider the total sum and sums across array boundaries.\n    total_sum = sum(arr)\n    max_sum_double_copy = _kadane_double(arr)\n\n    if total_sum > 0:\n        # If the total sum is positive, repeating the array k-2 additional times\n        # will increase the sum. We combine the best sum over two arrays with\n        # the sum of the middle full (k-2) arrays.\n        return max_sum_double_copy + (k - 2) * total_sum\n    else:\n        # If the total sum is non-positive, additional repetitions beyond two\n        # copies will not yield a larger sum than already found in two copies.\n        return max_sum_double_copy", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/294": [{"task_id": "Mbpp/294", "solution": "def max_val(values: list) -> int | float:\n    \"\"\"Finds the maximum numeric value in a heterogeneous list.\n    Non-numeric items are ignored. Raises NoNumericValueError if no numeric values are found.\n    \"\"\"\n\n    class NoNumericValueError(Exception):\n        \"\"\"Raised when no numeric values are found in the input list.\"\"\"\n        def __init__(self, message: str = \"No numeric values found in the list.\"):\n            super().__init__(message)\n\n    # Filter out non-numeric values, keeping only int and float types.\n    numeric_values = [v for v in values if isinstance(v, (int, float))]\n\n    if not numeric_values:\n        raise NoNumericValueError()\n\n    return max(numeric_values)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["3.14", false, 7.5]]]}], "Mbpp/300": [{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the\n    first n bits is equal to the sum of the last n bits, using the identity C(2n, n).\n    \"\"\"\n    return math.comb(2 * n, n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[50]]}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i]\n    that strictly includes arr[k] (k > i).\n    \"\"\"\n\n    def _compute_msis_for_prefix(full_arr: list[int], upto_index: int) -> list[int]:\n        \"\"\"\n        Computes the maximum sum increasing subsequence ending at each index\n        up to `upto_index` within `full_arr`.\n        \"\"\"\n        # dp[j] stores the maximum sum of an increasing subsequence ending at full_arr[j]\n        m = upto_index + 1\n        dp = [0] * m\n\n        for current_idx in range(m):\n            dp[current_idx] = full_arr[current_idx]  # Minimum sum is the element itself\n            for prev_idx in range(current_idx):\n                # If full_arr[prev_idx] can precede full_arr[current_idx] in an increasing subsequence\n                # and adding full_arr[current_idx] to dp[prev_idx] gives a larger sum\n                if full_arr[prev_idx] < full_arr[current_idx] and dp[prev_idx] + full_arr[current_idx] > dp[current_idx]:\n                    dp[current_idx] = dp[prev_idx] + full_arr[current_idx]\n        return dp\n\n    # The 'n' parameter is not used directly in the computation logic as per constraints\n    # (no validation checks, `len(arr)` is implied by slicing).\n\n    # Compute MSIS for the prefix arr[0...i]\n    dp_prefix_sums = _compute_msis_for_prefix(arr, i)\n\n    # The element at index k which must be included in the final subsequence\n    target_k_element = arr[k]\n\n    # Find the maximum sum from dp_prefix_sums such that the corresponding\n    # element in arr[0...i] is strictly less than target_k_element.\n    best_prefix_sum_before_k = 0\n    for j in range(i + 1):\n        if arr[j] < target_k_element:\n            best_prefix_sum_before_k = max(best_prefix_sum_before_k, dp_prefix_sums[j])\n\n    # The total maximum sum is the best prefix sum found plus the target_k_element.\n    # If no suitable prefix element was found, best_prefix_sum_before_k remains 0,\n    # and the result is just target_k_element, which matches the requirement.\n    return best_prefix_sum_before_k + target_k_element", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "from typing import Any, Dict, Iterable, Optional, Tuple, Union\nfrom decimal import Decimal\nNumber = Union[int, float, Decimal]\nclass InvalidRecordError(Exception):\n    \"\"\"Exception raised for errors in the input record format or value types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass NoDataError(Exception):\n    \"\"\"Exception raised when there is no valid data to process.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ValidationUtils:\n    \"\"\"Utility class for validating and normalizing input records.\"\"\"\n\n    @staticmethod\n    def to_number(value: Any) -> Number:\n        \"\"\"Converts a value to a numeric type (int, float, or Decimal).\"\"\"\n        if isinstance(value, (int, float, Decimal)):\n            return value\n        raise ValueError(f\"Value '{value}' is not a supported numeric type (int, float, Decimal).\")\n\n    def normalize_record(self, record: Tuple[Any, Any]) -> Tuple[str, Number]:\n        \"\"\"Normalizes a 2-tuple record to (str, Number).\"\"\"\n        if not isinstance(record, tuple) or len(record) != 2:\n            raise InvalidRecordError(f\"Record '{record}' is not a 2-tuple.\")\n\n        name, value = record\n        if not isinstance(name, str):\n            raise InvalidRecordError(f\"Record name '{name}' must be a string.\")\n\n        try:\n            numeric_value = self.to_number(value)\n        except ValueError as e:\n            raise InvalidRecordError(f\"Record value '{value}' for name '{name}' is not a valid number: {e}\")\n\n        return (name, numeric_value)\nclass AggregationService:\n    \"\"\"Core business logic for aggregation and selecting the maximum.\"\"\"\n\n    DEFAULT_TIE_BREAKER = \"lexicographic\" # As per design documentation\n\n    def __init__(self, validator: ValidationUtils) -> None:\n        \"\"\"Initializes the AggregationService with a ValidationUtils instance.\"\"\"\n        self.validator = validator\n\n    def accumulate(self, records: Iterable[Tuple[str, Number]]) -> Dict[str, Number]:\n        \"\"\"Accumulates numeric sums by name from a stream of records.\"\"\"\n        aggregates: Dict[str, Number] = {}\n        for record_input in records:\n            normalized_name, normalized_value = self.validator.normalize_record(record_input)\n            # Use Decimal(0) for initial sum to maintain precision if Decimal is mixed\n            aggregates[normalized_name] = aggregates.get(normalized_name, Decimal(0)) + normalized_value\n        return aggregates\n\n    def _select_max(self, aggregates: Dict[str, Number]) -> Tuple[str, Number]:\n        \"\"\"Selects the name-total pair with the maximum total, handling ties lexicographically.\"\"\"\n        if not aggregates:\n            raise NoDataError(\"No valid data available to compute maximum aggregate.\")\n\n        max_name: Optional[str] = None\n        max_total: Optional[Number] = None\n\n        # Iterate through items to find the maximum aggregate with tie-breaking\n        for name, total in aggregates.items():\n            if max_total is None or total > max_total:\n                max_total = total\n                max_name = name\n            elif total == max_total:\n                # Tie-breaking: choose the lexicographically smallest name\n                if max_name is None or name < max_name:\n                    max_name = name\n\n        # max_name and max_total are guaranteed to be set if aggregates is not empty\n        return (max_name, max_total) # type: ignore # mypy will complain about Optional, but it's guaranteed to be not None here.\n\n    def max_aggregate(self, records: Iterable[Tuple[str, Number]]) -> Tuple[str, Number]:\n        \"\"\"Computes the maximum aggregate from an iterable of records.\"\"\"\n        aggregates = self.accumulate(records)\n        return self._select_max(aggregates)\ndef max_aggregate(records: Iterable[Tuple[str, Number]]) -> Tuple[str, Number]:\n    \"\"\"Calculates the maximum aggregate from a list of tuples.\n\n    This function serves as a public facade, orchestrating validation and aggregation logic.\n    \"\"\"\n    validator = ValidationUtils()\n    service = AggregationService(validator)\n    return service.max_aggregate(records)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["Alice