e[i]:  # If i is prime\n            # Mark multiples of i as not prime, starting from i*i\n            # Optimization: Mark multiples starting from i*i because smaller multiples\n            # would have already been marked by smaller prime factors.\n            # E.g., for i=3, multiples like 2*3=6 are already marked by i=2.\n            start = i * i\n            step = i\n            # Calculate the number of elements to mark and create a bytearray of zeros\n            sieve[start:n:step] = b\"\\x00\" * ((n - 1 - start) // step + 1)\n\n    # Sum the boolean array (True counts as 1, False as 0) to get the count of primes\n    return sum(sieve)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/264": [{"task_id": "Mbpp/264", "solution": "class InvalidAgeError(ValueError):\n    \"\"\"Exception raised for invalid age inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass AgeInput:\n    \"\"\"Domain input DTO for dog age calculation.\"\"\"\n    def __init__(self, age: float) -> None:\n        self.age: float = age\nclass AgeResult:\n    \"\"\"Domain result DTO for dog age calculation.\"\"\"\n    def __init__(self, dog_years: float) -> None:\n        self.dog_years: float = dog_years\nclass AgeValidator:\n    \"\"\"Validates and normalizes age inputs.\"\"\"\n    def validate(self, age) -> float:\n        try:\n            f = float(age)\n        except Exception:\n            raise InvalidAgeError(f\"Age must be numeric, got {type(age).__name__}\")\n        if f < 0:\n            raise InvalidAgeError(\"Age must be non-negative\")\n        return f\nclass DogAgeCalculator:\n    \"\"\"Encapsulates calculation logic and orchestrates validation.\"\"\"\n    FIRST_TWO_YEARS_EQUIVALENT = 10.5\n    AFTER_TWO_PER_YEAR = 4.0\n\n    def __init__(self, validator: AgeValidator | None = None) -> None:\n        self._validator = validator or AgeValidator()\n\n    def calculate(self, input: AgeInput) -> AgeResult:\n        \"\"\"Validates input and computes dog years.\"\"\"\n        validated = self._validator.validate(input.age)\n        dog_years = self._compute(validated)\n        return AgeResult(dog_years)\n\n    def _compute(self, validated_age: float) -> float:\n        \"\"\"Applies the dog age formula.\"\"\"\n        if validated_age <= 2.0:\n            return validated_age * self.FIRST_TWO_YEARS_EQUIVALENT\n        return 21.0 + (validated_age - 2.0) * self.AFTER_TWO_PER_YEAR\ndef dog_age(age: float) -> float:\n    \"\"\"\n    Compute dog years for the given human age.\n    Raises InvalidAgeError for invalid inputs.\n    \"\"\"\n    calc = DogAgeCalculator()\n    result = calc.calculate(AgeInput(age))\n    return result.dog_years", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/259": [{"task_id": "Mbpp/259", "solution": "class TupleValidationError(ValueError):\n    \"\"\"Custom exception for tuple validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass TupleValidator:\n    \"\"\"Validates the structure and types of input tuples.\"\"\"\n    @staticmethod\n    def validate(a: tuple, b: tuple) -> None:\n        TupleValidator._validate_types(a, b)\n        TupleValidator._validate_outer_lengths(a, b)\n        TupleValidator._validate_inner_lengths(a, b)\n\n    @staticmethod\n    def _validate_types(a: tuple, b: tuple) -> None:\n        if not isinstance(a, tuple):\n            raise TypeError(f\"Expected tuple for input 'a'; got {type(a).__name__}\")\n        if not isinstance(b, tuple):\n            raise TypeError(f\"Expected tuple for input 'b'; got {type(b).__name__}\")\n\n        # Validate inner elements are tuples if they exist\n        min_len = min(len(a), len(b))\n        for i in range(min_len):\n            if not isinstance(a[i], tuple):\n                raise TypeError(f\"Expected tuple for inner element a[{i}]; got {type(a[i]).__name__}\")\n            if not isinstance(b[i], tuple):\n                raise TypeError(f\"Expected tuple for inner element b[{i}]; got {type(b[i]).__name__}\")\n\n        # If one tuple is longer, its remaining elements must also be tuples.\n        # This check applies to the longer tuple's additional inner elements.\n        if len(a) > min_len:\n            for i in range(min_len, len(a)):\n                if not isinstance(a[i], tuple):\n                    raise TypeError(f\"Expected tuple for inner element a[{i}]; got {type(a[i]).__name__}\")\n        if len(b) > min_len:\n            for i in range(min_len, len(b)):\n                if not isinstance(b[i], tuple):\n                    raise TypeError(f\"Expected tuple for inner element b[{i}]; got {type(b[i]).__name__}\")\n\n    @staticmethod\n    def _validate_outer_lengths(a: tuple, b: tuple) -> None:\n        if len(a) != len(b):\n            raise TupleValidationError(f\"Outer length mismatch: len(a)={len(a)}, len(b)={len(b)}\")\n\n    @staticmethod\n    def _validate_inner_lengths(a: tuple, b: tuple) -> None:\n        for i in range(len(a)): # len(a) == len(b) ensured by _validate_outer_lengths\n            if len(a[i]) != len(b[i]):\n                raise TupleValidationError(f\"Inner length mismatch at index {i}: len(a[{i}])={len(a[i])}, len(b[{i}])={len(b[i])}\")\ndef element_wise_max(inner_a: tuple, inner_b: tuple) -> tuple:\n    \"\"\"Computes the element-wise maximum of two inner tuples.\"\"\"\n    return tuple(max(x, y) for x, y in zip(inner_a, inner_b))\nclass MaximizerService:\n    \"\"\"Provides the core logic for maximizing tuple elements.\"\"\"\n    def maximize(self, a: tuple, b: tuple) -> tuple:\n        \"\"\"Computes element-wise maximum of two tuple-of-tuples.\"\"\"\n        return tuple(self._max_pair(ai, bi) for ai, bi in zip(a, b))\n\n    def _max_pair(self, inner_a: tuple, inner_b: tuple) -> tuple:\n        \"\"\"Computes element-wise maximum for a pair of inner tuples.\"\"\