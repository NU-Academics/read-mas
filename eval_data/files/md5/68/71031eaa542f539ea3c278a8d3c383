and self._data[right_child_idx] < self._data[smallest]:\n                smallest = right_child_idx\n\n            if smallest != idx:\n                self._data[idx], self._data[smallest] = self._data[smallest], self._data[idx]\n                idx = smallest\n            else:\n                break\n\n    def heapify(self) -> None:\n        \"\"\"Builds a min-heap from the current list in O(n) time.\"\"\"\n        n = len(self._data)\n        for i in range(n // 2 - 1, -1, -1):\n            self._sift_down(i)\n\n    def push(self, value: T) -> None:\n        \"\"\"Adds an element to the heap.\"\"\"\n        self._data.append(value)\n        self._sift_up(len(self._data) - 1)\n\n    def pop(self) -> T:\n        \"\"\"Removes and returns the smallest element from the heap.\"\"\"\n        if not self._data:\n            raise IndexError(\"pop from empty heap\")\n        root = self._data[0]\n        last = self._data.pop()\n        if self._data:\n            self._data[0] = last\n            self._sift_down(0)\n        return root\n\n    def __len__(self) -> int:\n        return len(self._data)\ndef heap_sort(data: List[T]) -> List[T]:\n    \"\"\"\n    Sorts a list of comparable elements using the heap sort algorithm.\n    Returns a new sorted list in ascending order.\n    \"\"\"\n    seq = validate_sequence(data)\n    heap = Heap(seq)\n    result = []\n    while len(heap) > 0:\n        result.append(heap.pop())\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/585": [{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Items are sorted by price in descending order, preserving original order for ties.\n    \"\"\"\n    from dataclasses import dataclass\n    from typing import Any, Dict, List\n\n    @dataclass\n    class Item:\n        \"\"\"Domain model for an item, including its name, price, and other meta