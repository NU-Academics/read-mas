 in descending order and returns the top n items.\"\"\"\n            # Python's sorted() is a stable sort, preserving original order for items with equal prices.\n            sorted_items = sorted(items_list, key=lambda i: i.price, reverse=True)\n            return sorted_items[:n]\n\n    class ItemController:\n        \"\"\"Provides the top-level interface to the item pricing functionality.\"\"\"\n        def __init__(self, service: PriceService = None):\n            self._service = service or PriceService()\n\n        def get_top_n(self, raw_items: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n            \"\"\"Retrieves the N most expensive items from a list of raw item dictionaries.\"\"\"\n            return self._service.find_most_expensive(raw_items, n)\n\n    controller = ItemController()\n    return controller.get_top_n(items, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/638": [{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity_kmh: float, temp_c: float) -> int:\n    \"\"\"Calculates the wind chill index using the Canadian formula, rounded half-up.\n    The wind velocity is in km/h and temperature in Celsius.\n    \"\"\"\n    # Define constants for the Canadian wind chill formula\n    CANADIAN_WC_COEFFS = {\"a\": 13.12, \"b\": 0.6215, \"c\": 11.37, \"d\": 0.3965}\n\n    def _pow16(v: float) -> float:\n        \"\"\"Computes v to the power of 0.16.\"\"\"\n        return v ** 0.16\n\n    def _round_half_up(value: float) -> int:\n        \"\"\"Rounds a float to the nearest integer with half-up behavior.\"\"\"\n        if value >= 0:\n            return int(math.floor(value + 0.5))\n        else:\n            return int(math.ceil(value - 0.5))\n\n    # Calculate V^0.16 term\n    v16 = _pow16(velocity_kmh)\n\n    # Extract coefficients for readability\n    a = CANADIAN_WC_COEFFS[\"a\"]\n    b = CANADIAN_WC_COEFFS[\"b\"]\n    c = CANADIAN_WC_COEFFS[\"c\"]\n    d = CANADIAN_WC_COEFFS[\"d\"]\n\n    # Apply the wind chill formula\n    raw_wind_chill = a + b * temp_c - c * v16 + d * temp_c * v16\n\n    # Round the result to the nearest integer using half-up rounding\n    rounded_wind_chill = _round_half_up(raw_wind_chill)\n\n    return rounded_wind_chill", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/633": [{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of XOR of all unordered pairs of numbers in the given list using a bit-optimized approach.\n    Example: pair_xor_Sum([5,9,7,6],4) == 47\n    \"\"\"\n    total_sum = 0\n    num_elements = len(nums)\n\n    if not isinstance(nums, list):\n        raise TypeError(\"nums must be a list of integers\")\n    if not isinstance(n, int) or n != num_elements:\n        raise ValueError(\"n must be an integer equal to len(nums)\")\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements of nums must be integers\")\n\n    if num_elements < 2:\n        return 0\n\n    # Use 64-bit width to cover typical integers; Python ints are unbounded but 64 bits is sufficient for common inputs.\n    bit_width = 64\n\n    # Count set bits at each position\n    counts = [0] * bit_width\n    for num in nums:\n        v = num\n        b = 0\n        while v and b < bit_width:\n            if v & 1:\n                counts[b] += 1\n            v >>= 1\n            b += 1\n\n    # Sum contributions of each bit: c * (n - c) * (1 << b)\n    for b, c in enumerate(counts):\n        if c:\n            total_sum += c * (num_elements - c) * (1 << b)\n\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 2, 1, 2, 3, 4, 5, 4, 5, 3], 11]]}], "Mbpp/643": [{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text):\n    \"\"\"\n    Checks if the input string contains a lowercase 'z' th