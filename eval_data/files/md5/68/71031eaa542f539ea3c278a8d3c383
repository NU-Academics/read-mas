en(seq_list) < 2:\n        raise ValueError(\"at least two elements are required to compute a difference\")\n\n    # Ensure elements are numeric\n    for i, v in enumerate(seq_list):\n        if not isinstance(v, (int, float)) or isinstance(v, bool):\n            raise ValueError(f\"element at index {i} is not a valid number: {v!r}\")\n\n    sorted_sequence = sorted(seq_list)\n    min_diff = float('inf')\n\n    for i in range(len(sorted_sequence) - 1):\n        diff = abs(sorted_sequence[i + 1] - sorted_sequence[i])\n        if diff < min_diff:\n            min_diff = diff\n            if min_diff == 0:\n                break  # Optimization: 0 is the smallest possible difference\n\n    return min_diff", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/771": [{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression contains balanced brackets.\"\"\"\n\n    # Define bracket mappings and sets (equivalent to BracketRepository)\n    _pairs = {')': '(', ']': '[', '}': '{'}\n    _openings = set(_pairs.values())\n    _closings = set(_pairs.keys())\n\n    stack: list[str] = []  # Equivalent to using StackUtils with a list\n\n    for char in expression:\n        if char in _openings:\n            stack.append(char)  # StackUtils.push\n        elif char in _closings:\n            if not stack:  # StackUtils.is_empty check\n                return False  # Closing bracket without a matching opening\n\n            last_open = stack.pop()  # StackUtils.pop\n            expected_open = _pairs.get(char)  # BracketRepository.matching_opening\n\n            if last_open != expected_open:\n                return False  # Mismatch found\n        # Else: character is not a bracket, ignore it (as per ignore_non_brackets default)\n\n    return not stack  # True if stack is empty (all brackets matched), False otherwise", "base_status": "pass", "plus_status": "fail", "base_