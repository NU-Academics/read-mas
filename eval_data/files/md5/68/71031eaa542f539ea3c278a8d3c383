st_b)\n\n    try:\n        # Attempt to use a set for O(1) average time complexity membership tests if elements are hashable.\n        set_b = set(lb)\n        evens = [x for i, x in enumerate(la) if i % 2 == 0 and x not in set_b]\n        odds = [x for i, x in enumerate(la) if i % 2 == 1 and x not in set_b]\n        return evens + odds\n    except TypeError:\n        # Fallback to O(N*M) linear search for membership if elements are unhashable.\n        evens = [x for i, x in enumerate(la) if i % 2 == 0 and x not in lb]\n        odds = [x for i, x in enumerate(la) if i % 2 == 1 and x not in lb]\n        return evens + odds", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3, 4, 5], [6, 7, 1]]], "plus_fail_tests": [[[], [1, 2, 3]]]}], "Mbpp/745": [{"task_id": "Mbpp/745", "solution": "import time\nfrom typing import List, Optional, Any, Dict\nfrom abc import ABC, abstractmethod\nMAX_RANGE_SIZE: int = 1_000_000\nclass InvalidParameterError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass InvalidRangeError(InvalidParameterError):\n    \"\"\"Exception raised for invalid range parameters.\"\"\"\n    pass\nclass RangeTooLargeError(InvalidParameterError):\n    \"\"\"Exception raised when the requested range exceeds the maximum allowed size.\"\"\"\n    pass\nclass RangeQuery:\n    \"\"\"Represents and validates a numeric range input.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def validate(self) -> None:\n        \"\"\"Ensures start and end are valid integers and form a valid range.\"\"\"\n        if not isinstance(self.start, int) or not isinstance(self.end, int):\n            raise InvalidParameterError(\"Start and end must be integers.\")\n        if self.start < 0:\n            raise InvalidRangeError(\"Start number must be non-negative.\")\n        if self.start > self.end:\n            raise InvalidRangeError(\"Start number cannot be greater than end number.\")\nclass ComputationResult:\n    \"\"\"Encapsulates computation results and metadata.\"\"\"\n    def __init__(self, start: int, end: int, results: List[int], duration_seconds: float) -> None:\n        self.start = start\n        self.end = end\n        self.results = results\n        self.duration_seconds = duration_seconds\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the result to a dictionary for serialization.\"\"\"\n        return {\n            \"start\": self.start,\n            \"end\": self.end,\n            \"results\": self.results,\n            \"duration_seconds\": self.duration_seconds\n        }\ndef parse_digits(n: int) -> List[int]:\n    \"\"\"Returns digits of n as integers in left-to-right order.\"\"\"\n    return [int(ch) for ch in str(abs(n))]\ndef contains_zero(n: int) -> bool:\n    \"\"\"Checks if any digit in n is zero.\"\"\"\n    return '0' in str(abs(n))\ndef safe_divisible(n: int, d: int) -> bool:\n    \"\"\"Returns True if n is divisible by d, handles d=0.\"\"\"\n    if d == 0:\n        return False\n    return n % d == 0\nclass DivisibilityChecker:\n    \"\"\"Checks if a single number satisfies the divisibility criteria.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def is_divisible_by_digits(self, n: int) -> bool:\n        \"\"\"Determines if n is divisible by each non-zero digit it contains.\"\"\"\n        if n < 0:\n            return False\n        if n == 0: # 0 contains 0 digit, but by rule we exclude numbers containing 0\n            return False\n        if contains_zero(n):\n            return False\n        for d in parse_digits(n):\n            if not safe_divisible(n, d):\n                return False\n        return True\nclass NumberRepository(ABC):\n    \"\"\"Abstract base class for storing computation results.\"\"\"\n    @abstractmethod\n    def save(self, result: ComputationResult) -> None:\n        \"\"\"Saves a computation result.\"\"\"\n        pass\nclass MemoryRepository(NumberRepository):\n    \"\"\"An in-memory repository for storing the last computation result.\"\"\"\n    def __init__(self) -> None:\n        self.last_result: Optional[ComputationResult] = None\n\n    def save(self, result: ComputationResult) -> None:\n        \"\"\"Stores the result in memory.\"\"\"\n        self.last_result = result\n\n    def get_last(self) -> Optional[ComputationResult]:\n        \"\"\"Retrieves the last stored result.\"\"\"\n        return self.last_result\nclass DivisibleService:\n    \"\"\"Orchestrates validation, computation, and optional persistence across a range.\"\"\"\n    def __init__(self, checker: DivisibilityChecker, repo: Optional[NumberRepository] = None, max_range_size: int = MAX_RANGE_SIZE) -> None:\n        self.checker = checker\n        self.repo = repo\n        self.max_range_size = max_range_size\n\n    def find_in_range(self, query: RangeQuery) -> ComputationResult:\n        \"\"\"Finds numbers within the specified range that meet divisibility criteria.\"\"\"\n        query.validate()\n\n        # Adjust range size check to handle empty ranges or single-number ranges gracefully\n        # A range of (1,1) has size 1. (1,0) is invalid.\n        size = query.end - query.start + 1\n        if size > self.max_range_size:\n            raise RangeTooLargeError(f\"Range size {size} exceeds maximum allowed size of {self.max_range_size}.\")\n\n        start_time = time.perf_counter()\n        results: List[int] = []\n        for n in range(query.start, query.end + 1):\n            if self.checker.is_divisible_by_digits(n):\n                results.append(n)\n        duration = time.perf_counter() - start_time\n        result = ComputationResult(query.start, query.end, results, duration)\n        if self.repo:\n            self.repo.save(result)\n        return result\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range [startnum, endnum] where every number is divisible by every non-zero digit it contains.\n    Numbers containing the digit '0' are excluded.\n    \"\"\"\n    checker = DivisibilityChecker()\n    repo = MemoryRepository()\n    service = DivisibleService(checker=checker, repo=repo)\n    result = service.find_in_range(RangeQuery(startnum, endnum))\n    return result.results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/770": [{"task_id": "Mbpp/770", "solution": "from .utils import InputValidator\nfrom .services import OddSumService\nfrom .repository import OddNumberRepository\nfrom .config import CACHE_ENABLED, CACHE_FILE\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of the fourth powers of the first n odd natural numbers.\n    Delegates validation to InputValidator and computation to OddSumService.\n    \"\"\"\n    validated_n = InputValidator.validate_n(n)\n    repo = OddNumberRepository(CACHE_FILE) if CACHE_ENABLED else None\n    service = OddSumService(repo=repo)\n    return service.compute(validated_n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/772": [{"task_id": "Mbpp/772", "solution": "import re\ndef remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the given string.\"\"\"\n\n    def _normalize_whitespace(s: str) -> str:\n        \"\"\"Normalizes multiple spaces to single spaces and strips leading/trailing whitespace.\"\"\"\n        return re.sub(r'\\s+', ' ', s).strip()\n\n    def _tokenize(s: str) -> list[str]:\n        \"\"\"Splits a string into words based on whitespace, after normalizing whitespace.\"\"\"\n        s = _normalize_whitespace(s)\n        return [] if s == \"\" else re.split(r'\\s+', s)\n\n    def _detokenize(tokens_list: list[str]) -> str:\n        \"\"\"Joins a list of tokens into a sing