f __init__(self, message: str, code: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n    def __str__(self) -> str:\n        return self.message\nclass ListValidator:\n    \"\"\"Provides utility methods for validating list inputs.\"\"\"\n    @classmethod\n    def validate_sequence(cls, obj: Any, name: str) -> None:\n        if not (hasattr(obj, \"__len__\") and hasattr(obj, \"__getitem__\")) or isinstance(obj, (str, bytes)):\n            raise InterleaveError(f\"{name} must be a sequence (like a list or tuple) and not a string or bytes.\")\n\n    @classmethod\n    def validate_equal_length(cls, a: Sequence[Any], b: Sequence[Any], c: Sequence[Any]) -> None:\n        cls.validate_sequence(a, \"List a\")\n        cls.validate_sequence(b, \"List b\")\n        cls.validate_sequence(c, \"List c\")\n        if not (len(a) == len(b) == len(c)):\n            raise InterleaveError(\"All three lists must have the same length.\")\nclass ListUtils:\n    \"\"\"Helper class for efficient list operations.\"\"\"\n    @staticmethod\n    def zip_three(a: Sequence[T], b: Sequence[T], c: Sequence[T]) -> Iterator[Tuple[T, T, T]]:\n        n = len(a)\n        for i in range(n):\n            yield (a[i], b[i], c[i])\n\n    @staticmethod\n    def flatten_triplets(iterable_of_triplets: Iterator[Tuple[T, T, T]]) -> List[T]:\n        out = []\n        for x, y, z in iterable_of_triplets:\n            out.append(x)\n            out.append(y)\n            out.append(z)\n        return out\nclass InterleaverService:\n    \"\"\"Core business logic for interleaving lists.\"\"\"\n    def interleave(self, a: Sequence[T], b: Sequence[T], c: Sequence[T]) -> List[T]:\n        ListValidator.validate_equal_length(a, b, c)\n        triplets = ListUtils.zip_three(a, b, c)\n        return ListUtils.flatten_triplets(triplets)\nclass InterleaveResult:\n    \"\"\"Data Transfer Object for interleaved list results.\"\"\"\n    def __init__(self, result: List[Any]) -> None:\n        self.result = result\n    def to_list(self) -> List[Any]:\n        return list(self.result)\n    def to_json(self) -> str:\n        return json.dumps(self.result)\nclass InterleaverController:\n    \"\"\"Public API layer, orchestrating service calls and DTOs.\"\"\"\n    def __init__(self, service: Optional[InterleaverService] = None) -> None:\n        self._service = service or InterleaverService()\n\n    def interleave_lists(self, a: Sequence[T], b: Sequence[T], c: Sequence[T]) -> InterleaveResult:\n        result_list = self._service.interleave(a, b, c)\n        return InterleaveResult(result=result_list)\ndef interleave_lists(a: Sequence[T], b: Sequence[T], c: Sequence[T]) -> List[T]:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    controller = InterleaverController()\n    return controller.interleave_lists(a, b, c).to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/593": [{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\n\n    For example, \"216.08.094.196\" becomes \"216.8.94.196\".\n    \"\"\"\n    octets = ip.split('.')\n    normalized_octets = [str(int(octet)) for octet in octets]\n    return '.'.join(normalized_octets)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["0.0.0.0"]]}], "Mbpp/590": [{"task_id": "Mbpp/590", "solution": "import math\nimport cmath\nfrom typing import Union, Tuple, Any, Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values in coordinate conversions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef is_number(val: Any) -> bool:\n    \"\"\"Checks if a value is an int or float, excluding booleans.\"\"\"\n    return isinstance(val, (int, float)) and not isinstance(val, bool)\ndef ensure_finite_number(val: Any, name: str) -> float:\n    \"\"\"Validates if a value is a finite number and converts it to float.\"\"\"\n    if not is_number(val):\n        raise InvalidInputError(f\"{name} must be a number.\")\n    f = float(val)\n    if math.isinf(f) or math.isnan(f):\n        raise InvalidInputError(f\"{name} must be finite.\")\n    return f\nclass Polar:\n    \"\"\"Represents polar coordinates (r, theta).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = float(r)\n        self.theta = float(theta)\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts the polar coordinates to a complex number using cmath.rect.\"\"\"\n        return cmath.rect(self.r, self.theta)\nclass PolarConverter:\n    \"\"\"Handles the core conversion logic between Cartesian and polar coordinates.\"\"\"\n    def cartesian_to_polar(self, x: float, y: float) -> Polar:\n        \"\"\"Converts Cartesian (x, y) to Polar (r, theta).\"\"\"\n        x = ensure_finite_number(x, \"x\")\n        y = ensure_finite_number(y, \"y\")\n        r = math.hypot(x, y)\n        theta = math.atan2(y, x)\n        return Polar(r, theta)\n\n    def polar_to_rect(self, r: float, theta: float) -> complex:\n        \"\"\"Converts Polar (r, theta) to a rectangular complex number.\"\"\"\n        r = ensure_finite_number(r, \"r\")\n        theta = ensure_finite_number(theta, \"theta\")\n        if r < 0:\n            raise InvalidInputError(\"Radius r must be non-negative.\")\n        return cmath.rect(r, theta)\nclass PolarController:\n    \"\"\"Manages coordinate conversion requests and orchestrates service calls.\"\"\"\n    def __init__(self, converter: Optional[PolarConverter] = None) -> None:\n        self._converter = converter or PolarConverter()\n\n    def polar_rect(self, a: Union[int, float], b: Union[int, float], mode: str = \"auto\") -> Tuple[Tuple[float, float], complex]:\n        \"\"\"Converts between polar and rectangular coordinates based on the mode.\"\"\"\n        if mode not in {\"auto\", \"cartesian-to-polar\", \"polar-to-rect\"}:\n            raise InvalidInputError(f\"Unknown mode: '{mode}'. Expected 'auto', 'cartesian-to-polar', or 'polar-to-rect'.\")\n\n        if mode == \"polar-to-rect\":\n            r = ensure_finite_number(a, \"r\")\n            theta = ensure_finite_number(b, \"theta\")\n            z = self._converter.polar_to_rect(r, theta)\n            return ((r, theta), z)\n        else: # \"auto\" or \"cartesian-to-polar\"\n            x = ensure_finite_number(a, \"x\")\n            y = ensure_finite_number(b, \"y\")\n            p = self._converter.cartesian_to_polar(x, y)\n            return ((p.r, p.theta), complex(x, y))\n_controller_instance = PolarController()\ndef polar_rect(a: float, b: float, *, mode: str = \"auto\") -> Tuple[Tuple[float, float], complex]:\n    \"\"\"Converts coordinates between polar and rectangular forms.\n    Delegates to an internal controller for validation and conversion logic.\"\"\"\n    return _controller_instance.polar_rect(a, b, mode=mode)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[3, 4]], "plus_fail_tests": [[0, 0]]}], "Mbpp/594": [{"task_id": "Mbpp/594", "solution": "from typing import Sequence, List, Any, Optional\nclass DiffError(Exception):\n    \"\"\"Base exception for difference calculation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass MissingNumberError(DiffError):\n    \"\"\"Raised when either an even or odd number is missing from the input.\"\"\"\n    def __init__(self, missing_type: str, message: Optional[str] = None) -> None:\n        default_message = f\"No {missing_type} number found in input.\"\n        super().__init__(message if message is not None else default_message)\n        self.missing_type = missing_type\nclass InvalidInputError(DiffError):\n    \"\"\"Raised when an input value cannot be converted to an integer or the input is not a sequence.\"\"\"\n    def __init__(self, invalid_value: Any, message: Optional[str] = None) -> None:\n        default_message = f\"Cannot convert {invalid_value!r} to int.\"\n        super().__init__(message if message is not None else default_message)\n        self.invalid_value = invalid_value\ndef to_int(value: Any) -> int:\n    \"\"\"Converts a value to an integer, raising InvalidInputError on failure.\"\"\"\n    if isinstance(value, int):\n        return value\n    try:\n        s = str(value).strip()\n        return int(s)\n    except (ValueError, TypeError):\n        raise InvalidInputError(value, f\"Cannot convert {value!r} to int\")\ndef validate_sequence(values: Sequence[Any]) -> List[int]:\n    \"\"\"Validates the input is a sequence and converts its elements to integers.\"\"\"\n    if values is None:\n        raise InvalidInputError(values, \"Input sequence is None\")\n    if not hasattr(values, '__iter__') or isinstance(values, str):\n        raise InvalidInputError(values, \"Input must be a sequence of numbers (e.g., list or tuple).\")\n    try:\n        return [to_int(v) for v in values]\n    except InvalidInputError:\n        raise\nclass NumberList:\n    \"\"\"Represents a validated list of integers.\"\"\"\n    def __init__(self, values: Sequence[Any]) -> None:\n        self.values: List[int] = validate_sequence(values)\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns a copy of the underlying list of integers to prevent external modification.\"\"\"\n        return list(self.values)\nclass DiffCalculator:\n    \"\"\"Calculates the difference between the first even and first odd number.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def find_first_even(self, values: List[int]) -> Optional[int]:\n        \"\"\"Finds the first even number in a list, returning None if not found.\"\"\"\n        for v in values:\n            if v % 2 == 0:\n                return v\n        return None\n\n    def find_first_odd(self, values: List[int]) -> Optional[int]:\n        \"\"\"Finds the first odd number in a list, returning None if not found.\"\"\"\n        for v in values:\n            if v % 2 != 0:\n                return v\n        return None\n\n    def compute(self, number_list: NumberList) -> int:\n        \"\"\"Computes (first even - first odd) from the NumberList.\"\"\"\n        values: List[int] = number_list.as_list()\n        first_odd = self.find_first_odd(values)\n        first_even = self.find_first_even(values)\n\n        if first_odd is None:\n            raise MissingNumberError('odd', 'No odd number found in input.')\n        if first_even is None:\n            raise MissingNumberError('even', 'No even number found in input.')\n        return first_even - first_odd\nclass DiffAPI:\n    \"\"\"Public API facade for difference calculation.\"\"\"\n    def diff_even_odd(self, values: Sequence[Any]) -> int:\n        \"\"\"Calculates the difference of the first even and first odd value in a sequence.\"\"\"\n        numbers = NumberList(values)\n        calculator = DiffCalculator()\n        return calculator.compute(numbers)\n_api = DiffAPI()\ndef diff_even_odd(values: Sequence[Any]) -> int:\n    \"\"\"\n    Computes the difference between the first even and the first odd number in a list of integers.\n    The difference is calculated as (first_even - first_odd).\n    \"\"\"\n    return _api.diff_even_odd(values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/587": [{"task_id": "Mbpp/587", "solution": "def list_tuple(input_list):\n    \"\"\"Converts a given list into a tuple.\"\"\"\n    return tuple(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/598": [{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"Checks if a number is an Armstrong number.\n    An Armstrong number is one whose sum of digits raised to the power of the number of digits equals the number itself.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        return False\n\n    s_n = str(n)\n    power = len(s_n)\n\n    sum_of_powers = 0\n    for ch in s_n:\n        digit = ord(ch) - 48  # faster than int(ch)\n        sum_of_powers += pow(digit, power)\n\n    return sum_of_powers == n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the identity C(2n, n-1).\n    For n=0, the sum is 0.\n    \"\"\"\n    def _nCk_helper(n_val: int, k_val: int) -> int:\n        \"\"\"\n        Computes the binomial coefficient C(n_val, k_val).\n        Handles k_val outside the valid range [0, n_val] by returning 0.\n        \"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n\n        # Take advantage of symmetry C(n, k) = C(n, n-k) for efficiency\n        k_val = min(k_val, n_val - k_val)\n\n        res = 1\n        # Multiplicative formula for C(n, k)\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    if n == 0:\n        return 0\n\n    # Use the closed-form identity: sum_{k=0}^{n-1} C(n,k) * C(n,k+1) = C(2n, n-1)\n    return _nCk_helper(2 * n, n - 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/597": [{"task_id": "Mbpp/597", "solution": "def find_kth(a: list[int], b: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a binary search approach.\n    Assumes arrays are sorted ascending, and k is 1-based and within valid bounds.\n    \"\"\"\n    if not isinstance(a, list) or not isinstance(b, list):\n        raise TypeError(\"a and b must be lists\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n\n    m, n = len(a), len(b)\n    total = m + n\n    if k < 1 or k > total:\n        raise IndexError(f\"k must be between 1 and {total}, got {k}\")\n\n    # Ensure array 'a' is the shorter one to optimize the binary search range.\n    if m > n:\n        return find_kth(b, a, k)\n\n    # If 'a' is empty, the k-th element must be in 'b'.\n    if m == 0:\n        return b[k - 1]\n\n    # Binary search for the partition point 'i' in 'a'.\n    # 'i' is the number of elements taken from 'a' for the k smallest elements.\n    left = max(0, k - n)  # Smallest possible 'i' for a valid partition.\n    right = min(k, m)     # Largest possible 'i' for a valid partition.\n\n    while left <= right:\n        i = (left + right) // 2\n        j = k - i  # Number of elements taken from 'b'.\n\n        # Determine the elements around the partitions.\n        a_left = a[i - 1] if i > 0 else float(\"-inf\")\n        a_right = a[i] if i < m else float(\"inf\")\n        b_left = b[j - 1] if j > 0 else float(\"-inf\")\n        b_right = b[j] if j < n else float(\"inf\")\n\n        # Check if the partitions are correctly balanced.\n        if a_left <= b_right and b_left <= a_right:\n            return max(a_left, b_left)\n        elif a_left > b_right:\n            # Partition 'i' is too far right; move left in 'a'.\n            right = i - 1\n        else:  # b_left > a_right\n            # Partition 'i' is too far left; move right in 'a'.\n            left = i + 1\n\n    # If we exit the loop without returning, something went wrong.\n    raise ValueError(\"Unable to determine k-th element\")", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3], [true, true, false], 3]]}], "Mbpp/599": [{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first n natural numbers.\"\"