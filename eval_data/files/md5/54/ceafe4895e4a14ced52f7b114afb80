{"task_id": "Mbpp/94", "solution": "def index_minimum(tuple_list):\n    \"\"\"Return the first element of the tuple with the smallest second value.\"\"\"\n    min_first = None\n    min_second = None\n\n    for item in tuple_list:\n        first, second = item[0], item[1]\n\n        if min_second is None or second < min_second:\n            min_second = second\n            min_first = first\n\n    return min_first"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, Dict, List\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"Flatten list_of_lists and return mapping element -> count.\"\"\"\n    frequency: Dict[Any, int] = {}\n    for sublist in list_of_lists:\n        for element in sublist:\n            frequency[element] = frequency.get(element, 0) + 1\n    return frequency"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef _validate_input(n):\n    \"\"\"Internal: ensure n is int, map negative to absolute, error on zero.\n    Returns absolute int > 0 or raises TypeError/ValueError.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"divisor: input must be int\")\n    if n == 0:\n        raise ValueError(\"divisor: input zero has undefined positive divisors\")\n    return abs(n)\n\ndef _count_divisors(m):\n    \"\"\"Internal: count positive divisors of positive integer m using trial division.\n    Counts factor pairs up to sqrt(m), adjusting for perfect squares.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= m:\n        if m % i == 0:\n            if i * i == m:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\n\ndef divisor(n):\n    \"\"\"Compute and return the number of positive divisors of integer n.\n    Raises TypeError for non-int inputs. Raises ValueError for zero input.\n    \"\"\"\n    m = _validate_input(n)\n    return _count_divisors(m)"}
{"task_id": "Mbpp/98", "solution": "def validate_sequence(sequence):\n    \"\"\"Validate container type (list/tuple), non-empty, and numeric elements; raises on invalid.\"\"\"\n    if not isinstance(sequence, (list, tuple)):\n        raise ValueError(\"Input must be a list or tuple.\")\n    if not sequence:\n        raise ValueError(\"Input sequence cannot be empty.\")\n    for item in sequence:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n\ndef compute_product(sequence):\n    \"\"\"Compute and return product of elements as float (starts at 1).\"\"\"\n    product = 1.0\n    for num in sequence:\n        product *= float(num) # Coerce to float during multiplication\n    return product\n\ndef multiply_num(sequence):\n    \"\"\"Public API: compute (product of elements) / len(sequence) and return float.\n    Raises ValueError if sequence is empty or not a list/tuple. Raises TypeError if elements are not numeric.\"\"\"\n    validate_sequence(sequence)\n    \n    product = compute_product(sequence)\n    \n    result = product / len(sequence)\n    return float(result)"}
{"task_id": "Mbpp/101", "solution": "from typing import Any, List\n\nclass Element:\n    \"\"\"Minimal wrapper for an element value to mirror SRS domain concept.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value: Any = value\n\nclass Array:\n    \"\"\"Holds elements and provides getElementAt1Based(k) for 1-based retrieval.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self._elements: List[Any] = elements\n\n    @property\n    def length(self) -> int:\n        return len(self._elements)\n\n    def getElementAt1Based(self, k: int) -> Any:\n        return self._elements[k - 1]\n\nclass Index:\n    \"\"\"Encapsulates integer index semantics and provides isValid(arr) for validation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\n    def isValid(self, arr: 'Array') -> bool:\n        return 1 <= self.value <= arr.length\n\ndef kth_element(array, k) -> Any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    The function accepts a native Python list or an Array instance.\n    \"\"\"\n    arr_obj: Array\n    if not isinstance(array, Array):\n        arr_obj = Array(array)\n    else:\n        arr_obj = array\n\n    # The Index object is constructed as per design, but isValid is optional and skipped.\n    # The design assumes valid inputs per SRS, so no explicit validation call here.\n    _idx = Index(k)\n\n    return arr_obj.getElementAt1Based(k)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(number):\n    \"\"\"Convert the given integer number to its binary string representation with no leading zeros.\n    Returns '0' if the input number is 0.\n    \"\"\"\n    if number == 0:\n        return '0'\n\n    binary_digits = []\n    current_number = number\n    while current_number > 0:\n        remainder = current_number % 2\n        binary_digits.append(str(remainder))\n        current_number //= 2\n    \n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/100", "solution": "class IntegerValue:\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_palindrome(self) -> bool:\n        \"\"\"Checks if the integer value is a palindrome.\"\"\"\n        s = str(self.value)\n        return s == s[::-1]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the integer value.\"\"\"\n        return len(str(self.value))\n\n    def mirror_and_increment(self) -> 'IntegerValue':\n        \"\"\"Calculates the next smallest palindrome strictly greater than self.value.\"\"\"\n        s = str(self.value)\n        n_len = len(s)\n        \n        # 1. Split the number string into left half and optional middle character\n        left_half = s[:n_len // 2]\n        mid_char = s[n_len // 2] if n_len % 2 == 1 else ''\n        \n        # 2. Construct a candidate palindrome by mirroring the left half\n        # This candidate keeps the same leading digits and typically the same length as the original number.\n        candidate_p_str = left_half + mid_char + left_half[::-1]\n        candidate_p_val = int(candidate_p_str)\n        \n        # 3. If this candidate is already strictly greater than the original value,\n        # it is the next smallest palindrome.\n        if candidate_p_val > self.value:\n            return IntegerValue(candidate_p_val)\n        \n        # 4. If the candidate is not strictly greater (i.e., less than or equal to self.value),\n        # we need to increment the \"center\" part of the number and rebuild the palindrome.\n        # This ensures we find a larger palindrome.\n        \n        # The part to increment is the left half including the middle digit for odd length numbers.\n        # e.g., for 12345, this is \"123\". For 1234, this is \"12\".\n        increment_target_str = s[: (n_len + 1) // 2]\n        \n        # Numerically increment this target string.\n        incremented_target_num = int(increment_target_str) + 1\n        incremented_target_str_new = str(incremented_target_num)\n        \n        # 5. Check if incrementing the target string resulted in an increase in its length.\n        # This typically happens when the target string was all '9's (e.g., \"9\" -> \"10\", \"99\" -> \"100\").\n        if len(incremented_target_str_new) > len(increment_target_str):\n            # If the target string's length increased, it implies the new palindrome\n            # will have `n_len + 1` digits. This handles cases like 9 -> 11, 99 -> 101.\n            # The structure is '1' followed by (n_len - 1) zeros, then '1'.\n            next_pal_val = int('1' + '0' * (n_len - 1) + '1')\n        else:\n            # If the target string's length did not change,\n            # construct the new palindrome based on the original number's length parity.\n            if n_len % 2 == 1: # Original was odd length\n                # e.g., 808 -> prefix \"80\" (mid='0') -> incremented \"81\".\n                # New palindrome: \"81\" + \"81\"[:-1][::-1] = \"81\" + \"8\" = 818\n                next_pal_val = int(incremented_target_str_new + incremented_target_str_new[:-1][::-1])\n            else: # Original was even length\n                # e.g., 1234 -> prefix \"12\" -> incremented \"13\".\n                # New palindrome: \"13\" + \"13\"[::-1] = \"13\" + \"31\" = 1331\n                next_pal_val = int(incremented_target_str_new + incremented_target_str_new[::-1])\n        \n        return IntegerValue(next_pal_val)\n\n\nclass PalindromeResult:\n    def __init__(self, value: int):\n        self.value = value\n\n\nclass PalindromeService:\n    def next_smallest_palindrome(self, n: int) -> int:\n        \"\"\"Finds the next smallest palindrome strictly greater than n.\"\"\"\n        current_value_obj = IntegerValue(n)\n        next_palindrome_obj = current_value_obj.mirror_and_increment()\n        result_dto = PalindromeResult(next_palindrome_obj.value)\n        return result_dto.value\n\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the input integer n,\n    returned as an integer.\n    \"\"\"\n    service = PalindromeService()\n    return service.next_smallest_palindrome(n)"}
