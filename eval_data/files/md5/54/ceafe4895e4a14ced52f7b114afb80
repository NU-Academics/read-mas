{"task_id": "Mbpp/234", "solution": "from typing import Union\n\nNumber = Union[int, float]\n\nclass Cube:\n    def __init__(self, side_length: Number) -> None:\n        self.side_length: Number = side_length\n\n    def volume(self) -> Number:\n        \"\"\"Return the cube volume: side_length ** 3\"\"\"\n        return self.side_length ** 3\n\nclass VolumeCalculator:\n    @staticmethod\n    def volume_cube(side_length: Number) -> Number:\n        \"\"\"Compute volume of a cube given side_length. Matches SRS behaviour: side_length ** 3\"\"\"\n        cube = Cube(side_length)\n        return cube.volume()\n\ndef volume_cube(side_length: Number) -> Number:\n    \"\"\"Public API function mandated by SRS (FR1). Delegates to VolumeCalculator.\"\"\"\n    return VolumeCalculator.volume_cube(side_length)"}
{"task_id": "Mbpp/233", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass Cylinder:\n    height: float\n    radius: float\n    lateral_surface_area: float = None\n\n    def computeLateralSurfaceArea(self) -> float:\n        \"\"\"Computes and stores the lateral surface area of the cylinder.\"\"\"\n        self.lateral_surface_area = 2 * math.pi * self.radius * self.height\n        return self.lateral_surface_area\n\ndef lateralsuface_cylinder(height, radius) -> float:\n    \"\"\"Calculates the lateral surface area of a cylinder given its height and radius.\"\"\"\n    h = float(height)\n    r = float(radius)\n    cylinder_instance = Cylinder(height=h, radius=r)\n    return cylinder_instance.computeLateralSurfaceArea()"}
{"task_id": "Mbpp/238", "solution": "from typing import List\n\nclass StringInput:\n    \"\"\"Represents the input string and provides simple helpers.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the string input is empty.\"\"\"\n        return len(self.value) == 0\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string input.\"\"\"\n        return len(self.value)\n\nclass Substring:\n    \"\"\"Represents a contiguous substring with start/end indices and value.\"\"\"\n    def __init__(self, start: int, end: int, value: str):\n        self.start = start\n        self.end = end\n        self.value = value\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for the substring.\"\"\"\n        return f\"Substring(start={self.start}, end={self.end}, value='{self.value}')\"\n\nclass SubstringCounter:\n    \"\"\"Provides counting and generation of non-empty contiguous substrings.\"\"\"\n    def number_of_substrings(self, s: StringInput) -> int:\n        \"\"\"Computes and returns the integer count of non-empty substrings.\"\"\"\n        if s.is_empty():\n            return 0\n        n = s.length()\n        # The number of non-empty contiguous substrings of a string of length n is n * (n + 1) / 2.\n        return n * (n + 1) // 2\n\n    def generate_substrings(self, s: StringInput) -> List[Substring]:\n        \"\"\"Enumerates all non-empty contiguous substrings.\"\"\"\n        substrings: List[Substring] = []\n        n = s.length()\n        for start in range(n):\n            for end in range(start + 1, n + 1):\n                substring_value = s.value[start:end]\n                substrings.append(Substring(start, end, substring_value))\n        return substrings\n\n    def count(self, substrings: List[Substring]) -> int:\n        \"\"\"Aggregates and returns the count of provided substrings.\"\"\"\n        return len(substrings)\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"Public API: returns the number of non-empty contiguous substrings of s.\"\"\"\n    string_input = StringInput(s)\n    counter = SubstringCounter()\n    return counter.number_of_substrings(string_input)"}
{"task_id": "Mbpp/237", "solution": "def canonicalize(a, b):\n    \"\"\"Returns the canonical tuple (min(a,b), max(a,b)).\"\"\"\n    return (min(a, b), max(a, b))\n\ndef check_occurences(input_list):\n    \"\"\"\n    Counts occurrences of canonicalized tuples in a list, returning a dictionary.\n    Tuples are canonicalized to (min_val, max_val) order.\n    \"\"\"\n    if not input_list:\n        return {}\n\n    counts = {}\n    for item in input_list:\n        a, b = item\n        canonical_key = canonicalize(a, b)\n        counts[canonical_key] = counts.get(canonical_key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/235", "solution": "class BitPosition:\n    def __init__(self, position: int):\n        self.position: int = position\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the bit position is even (LSB is position 1).\"\"\"\n        return (self.position % 2) == 0\n\nclass BitMask:\n    def __init__(self, mask: int = 0):\n        self.mask: int = mask\n\n    @staticmethod\n    def generate_mask_for_bits(bit_count: int) -> int:\n        \"\"\"Generates an integer mask with bits set at even positions up to bit_count (LSB is position 1).\"\"\"\n        mask = 0\n        for position in range(1, bit_count + 1):\n            if BitPosition(position).isEven():\n                mask |= (1 << (position - 1))\n        return mask\n\ndef even_bit_set_number(n: int) -> int:\n    if n < 0:\n        raise ValueError(\"negative input not supported\")\n\n    # Determine the number of bits needed to represent 'n',\n    # ensuring at least 1 bit is considered for mask generation\n    bit_count = max(1, n.bit_length())\n\n    # Generate a mask with '1's at all even bit positions\n    mask = BitMask.generate_mask_for_bits(bit_count)\n\n    # Perform a bitwise OR operation to set the even bits in 'n'\n    # while preserving the existing odd bits of 'n'.\n    return n | mask"}
{"task_id": "Mbpp/240", "solution": "def replace_list(a: list, b: list) -> list:\n    \"\"\"Replace the last element of list a with elements of list b and return the result list.\n    Handles edge cases where list 'a' is empty or has a single element by returning list 'b'.\n    \"\"\"\n    if len(a) <= 1:\n        return b\n    else:\n        return a[:-1] + b"}
{"task_id": "Mbpp/239", "solution": "class SequenceElement:\n    \"\"\"Data holder for position and value.\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position\n        self.value = value\n\nclass Sequence:\n    \"\"\"Represents candidate sequences and provides validation for them.\"\"\"\n    def __init__(self, length: int, m: int, elements=None):\n        self.length = length\n        self.m = m\n        self.elements = elements if elements is not None else []\n\n    def add_element(self, element: SequenceElement):\n        \"\"\"Adds an element to the sequence.\"\"\"\n        self.elements.append(element)\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the sequence built so far adheres to length, value, and doubling constraints.\"\"\"\n        if not (1 <= len(self.elements) <= self.length):\n            return False\n        \n        for i in range(len(self.elements)):\n            current_val = self.elements[i].value\n            if not (1 <= current_val <= self.m):\n                return False\n            if i > 0:\n                prev_val = self.elements[i-1].value\n                if not (current_val >= 2 * prev_val):\n                    return False\n        return True\n\nclass Parameters:\n    \"\"\"Holds input parameters m and n and provides a validation method.\"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"This method would validate m and n, but is a no-op to adhere to strict problem constraints.\"\"\"\n        pass\n\nclass Result:\n    \"\"\"A simple container for the computed count.\"\"\"\n    def __init__(self, count: int = 0):\n        self.count = count\n\nclass FunctionCall:\n    \"\"\"Manages the computation of total sequences using a recursive, memoized approach.\"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n        self.memo = {}\n\n    def computeCount(self) -> int:\n        \"\"\"\n        Computes the total number of valid sequences.\n        It initializes the recursion by iterating over possible first elements.\n        \"\"\"\n        if self.n == 0:\n            return 0\n        if self.n == 1:\n            return self.m\n\n        total_sequences = 0\n        # Determine the maximum possible value for the first element (v1).\n        # v1 * (2**(n-1)) must be <= m for the sequence to potentially complete.\n        max_v1_for_completion = self.m // (2**(self.n - 1))\n        \n        for v1 in range(1, max_v1_for_completion + 1):\n            # For each valid v1, start the recursive counting for the remaining n-1 elements.\n            # The next element (v2) must be at least 2 * v1.\n            total_sequences += self._count_sequences_recursive(2, v1 * 2)\n        \n        return total_sequences\n\n    def _count_sequences_recursive(self, current_length: int, prev_element_lower_bound: int) -> int:\n        \"\"\"\n        Recursively counts valid sequence extensions.\n        `current_length` is the 1-indexed position of the element being placed.\n        `prev_element_lower_bound` is `2 * (value of element at current_length - 1)`.\n        \"\"\"\n        # If the minimum required value for the current element exceeds 'm', no valid sequence can proceed.\n        if prev_element_lower_bound > self.m:\n            return 0\n\n        # Base case: If we are placing the last element (current_length == self.n),\n        # count how many valid values exist for it within [prev_element_lower_bound, self.m].\n        if current_length == self.n:\n            return self.m - prev_element_lower_bound + 1\n\n        # Memoization check for previously computed states.\n        if (current_length, prev_element_lower_bound) in self.memo:\n            return self.memo[(current_length, prev_element_lower_bound)]\n\n        count = 0\n        \n        # Calculate the highest possible value for the current element (`v_current`).\n        # `v_current` must satisfy `v_current * (2**(self.n - current_length)) <= self.m`.\n        factor_for_remaining_steps = 2**(self.n - current_length)\n        upper_limit_for_current_element = self.m // factor_for_remaining_steps\n        \n        # Iterate for `v_current` from its minimum requirement up to its calculated upper limit.\n        # This range is [prev_element_lower_bound, min(self.m, upper_limit_for_current_element)].\n        actual_upper_limit = min(self.m, upper_limit_for_current_element)\n        \n        for v_current in range(prev_element_lower_bound, actual_upper_limit + 1):\n            # Recursively count sequences for the next position, with `v_current * 2` as the new lower bound.\n            count += self._count_sequences_recursive(current_length + 1, v_current * 2)\n\n        self.memo[(current_length, prev_element_lower_bound)] = count\n        return count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of length n,\n    where each element is a positive integer, <= m, and >= twice the previous element.\n    \"\"\"\n    params = Parameters(m, n)\n    params.validate()\n    \n    fc = FunctionCall(m, n)\n    return fc.computeCount()"}
