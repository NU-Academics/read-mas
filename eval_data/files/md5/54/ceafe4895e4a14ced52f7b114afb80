{"task_id": "Mbpp/86", "solution": "from typing import Any\n\nclass InputValidator:\n    \"\"\"Provides methods for validating input types and ranges.\"\"\"\n    def isInteger(self, value: Any) -> bool:\n        \"\"\"Checks if the given value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def isPositiveInteger(self, n: int) -> bool:\n        \"\"\"Checks if the given integer is positive (n >= 1).\"\"\"\n        return n >= 1\n\nclass CenteredHexagonalNumberFunction:\n    \"\"\"Orchestrates validation and computes the centered hexagonal number.\"\"\"\n    def __init__(self, validator: InputValidator):\n        self.validator = validator\n\n    def compute(self, n: Any) -> int:\n        \"\"\"Validates input and computes the nth centered hexagonal number.\"\"\"\n        if not self.validator.isInteger(n):\n            raise TypeError(\"n must be an integer\")\n        if not self.validator.isPositiveInteger(n):\n            raise ValueError(\"n must be >= 1\")\n        return self.applyFormula(n)\n\n    def applyFormula(self, n: int) -> int:\n        \"\"\"Applies the formula for the nth centered hexagonal number.\"\"\"\n        return 3 * n * (n - 1) + 1\n\ndef centered_hexagonal_number(n: Any) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number, validating input.\n    \"\"\"\n    validator = InputValidator()\n    chf = CenteredHexagonalNumberFunction(validator)\n    return chf.compute(n)"}
