{"task_id": "Mbpp/7", "solution": "from typing import List\n\ndef find_char_long(text: str) -> List[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are tokenized by splitting the input string by whitespace.\n    \"\"\"\n    words = text.split()\n    long_words = [word for word in words if len(word) >= 4]\n    return long_words"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Return True if n is not prime (composite or n < 2); return False if n is prime.\n\n    Precondition: n is an int.\n    \"\"\"\n    if n < 2:\n        return True\n    if n == 2 or n == 3:\n        return False\n    if n % 2 == 0:\n        return True\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "Mbpp/6", "solution": "def xor(a: int, b: int) -> int:\n    \"\"\"Calculates the bitwise exclusive OR of two integers.\"\"\"\n    return a ^ b\n\ndef popcount(x: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in the binary representation of an integer.\"\"\"\n    return bin(x).count(\"1\")\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is determined by computing the XOR of the numbers and then counting the set bits.\n    \"\"\"\n    x = xor(a, b)\n    count = popcount(x)\n    return count == 1"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, target_character):\n    char_indices = []\n    for i, char in enumerate(input_string):\n        if char == target_character:\n            char_indices.append(i)\n\n    indices_to_remove = set()\n    if len(char_indices) == 1:\n        indices_to_remove.add(char_indices[0])\n    elif len(char_indices) >= 2:\n        indices_to_remove.add(char_indices[0])\n        indices_to_remove.add(char_indices[-1])\n\n    result_chars = []\n    for i, char in enumerate(input_string):\n        if i not in indices_to_remove:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/8", "solution": "def validate_input(input_list: list) -> None:\n    \"\"\"\n    Validates that the input is a list and all its elements are numeric (int or float).\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('input must be a list')\n    for element in input_list:\n        if not isinstance(element, (int, float)):\n            raise TypeError('all elements must be numeric (int or float)')\n\ndef compute_squares(input_list: list) -> list:\n    \"\"\"\n    Computes the square of each element in the input list in a single pass.\n    Returns a new list with the squared values.\n    \"\"\"\n    return [x * x for x in input_list]\n\ndef square_nums(input_list: list) -> list:\n    \"\"\"\n    Finds the squares of individual elements in a list after validating the input.\n    Returns a new list containing the squared values.\n    \"\"\"\n    validate_input(input_list)\n    return compute_squares(input_list)"}
{"task_id": "Mbpp/9", "solution": "class InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass RotationResult:\n    def __init__(self, k: int) -> None:\n        self.k = k\n\nclass RotationFunction:\n    @staticmethod\n    def find_Rotations(s: str) -> int:\n        # Validation checks for type and empty string are omitted as per explicit instruction\n        # \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n\n        n = len(s)\n        temp = s + s\n        for k in range(1, n + 1):\n            if temp[k : k + n] == s:\n                return k\n        # This return should ideally not be reached for a non-empty string,\n        # as a string always matches itself after n rotations.\n        return n\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Delegates computation to RotationFunction.\n    \"\"\"\n    return RotationFunction.find_Rotations(s)\n\n__all__ = [\"find_Rotations\"]"}
{"task_id": "Mbpp/4", "solution": "from typing import List\nimport heapq\n\nclass HeapSelector:\n    \"\"\"Encapsulates selection algorithm used to obtain top-n elements.\"\"\"\n    def __init__(self) -> None:\n        self._data: List[int] = []\n\n    def build_heap(self, data: List[int]) -> None:\n        \"\"\"Stores the input data for top-n extraction.\"\"\"\n        self._data = data\n\n    def extract_top(self, n: int) -> List[int]:\n        \"\"\"Returns up to n largest elements from the stored data.\"\"\"\n        return heapq.nlargest(n, self._data)\n\ndef heap_queue_largest(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Return the n largest integers from input_list in descending order.\n    Preconditions: input_list is a list of integers and n is an integer.\n    \"\"\"\n    if n == 0:\n        return []\n    if n >= len(input_list):\n        return sorted(input_list, reverse=True)\n    \n    selector = HeapSelector()\n    selector.build_heap(input_list)\n    top = selector.extract_top(n)\n    return sorted(top, reverse=True)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(a, b):\n    \"\"\"\n    Finds unique shared elements from two iterables, preserving order from 'a'.\n    Raises TypeError if either argument is not iterable.\n    \"\"\"\n    # Validate both arguments are iterable.\n    try:\n        _ = iter(a)\n    except TypeError:\n        raise TypeError(\"similar_elements: both arguments must be iterable\")\n    \n    try:\n        _ = iter(b)\n    except TypeError:\n        raise TypeError(\"similar_elements: both arguments must be iterable\")\n\n    result = []\n\n    # Attempt fast path using sets for hashable elements.\n    try:\n        set_b = set(b)\n        seen_in_result = set() # Tracks elements already added to 'result' to maintain uniqueness and order from 'a'.\n        \n        for x in a:\n            if x in set_b and x not in seen_in_result:\n                result.append(x)\n                seen_in_result.add(x)\n        return result\n\n    except TypeError: # This TypeError indicates elements within 'b' are not hashable.\n        # Fallback path for non-hashable elements, using equality comparison.\n        list_b = list(b) # Convert 'b' to a list for multiple membership checks.\n        \n        for x in a:\n            # Check if 'x' has already been added to 'result' to maintain uniqueness and order.\n            if x in result:\n                continue\n            \n            # Compare 'x' against elements in 'list_b' using equality.\n            for y in list_b:\n                if x == y:\n                    result.append(x)\n                    break # Match found, move to the next element from 'a'.\n        \n        return result"}
{"task_id": "Mbpp/12", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid matrix inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef compute_row_sum(row: list) -> float:\n    \"\"\"Computes the sum of elements in a row.\"\"\"\n    return sum(row)\n\ndef validate_matrix(matrix: list) -> None:\n    \"\"\"Validates the matrix structure and element types.\"\"\"\n    if not isinstance(matrix, list):\n        raise ValidationError(\"Matrix must be a list of rows.\")\n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise ValidationError(f\"Row {i} must be a list of numbers.\")\n        for j, item in enumerate(row):\n            if not isinstance(item, (int, float)):\n                raise ValidationError(f\"Element at [{i}][{j}] must be a number (int or float).\")\n\ndef sort_matrix(matrix):\n    \"\"\"Sort rows of matrix by ascending sum and return reordered matrix.\"\"\"\n    validate_matrix(matrix)\n    if not matrix:\n        return []\n\n    summaries = []\n    for idx, row in enumerate(matrix):\n        summaries.append((idx, compute_row_sum(row), row))\n\n    summaries.sort(key=lambda t: t[1])\n\n    return [t[2] for t in summaries]"}
{"task_id": "Mbpp/17", "solution": "class Square:\n    \"\"\"Domain entity representing a square.\"\"\"\n    def __init__(self, side_length: float):\n        self.side_length = float(side_length)\n    def perimeter(self) -> float:\n        \"\"\"Calculates and returns the perimeter of the square.\"\"\"\n        return 4.0 * self.side_length\n\nclass SquarePerimeterService:\n    \"\"\"Service to compute the perimeter of a square.\"\"\"\n    def square_perimeter(self, side_length: float) -> float:\n        \"\"\"Creates a Square object and returns its perimeter.\"\"\"\n        square_obj = Square(side_length)\n        return square_obj.perimeter()\n\ndef square_perimeter(side_length):\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    Delegates the computation to SquarePerimeterService.\n    \"\"\"\n    service = SquarePerimeterService()\n    return service.square_perimeter(side_length)"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Encapsulates triangular prism dimensions and provides volume calculation.\"\"\"\n    def __init__(self, base, height, length):\n        self.base = base\n        self.height = height\n        self.length = length\n\n    def calculateVolume(self):\n        \"\"\"Computes and returns the volume of the triangular prism.\"\"\"\n        return (self.base * self.height / 2) * self.length\n\ndef find_Volume(base, height, length):\n    \"\"\"Calculates the volume of a triangular prism using the formula (base * height / 2) * length.\"\"\"\n    prism = TriangularPrism(base, height, length)\n    return prism.calculateVolume()"}
{"task_id": "Mbpp/16", "solution": "import re\n\nclass TextInput:\n    \"\"\"Holds the string value for processing.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass MatchResult:\n    \"\"\"Container for the boolean result of a match operation.\"\"\"\n    def __init__(self, is_match: bool):\n        self.is_match: bool = is_match\n\nclass Validator:\n    \"\"\"Provides utility for character validation, specifically for ASCII lowercase.\"\"\"\n    @staticmethod\n    def is_ascii_lowercase(ch: str) -> bool:\n        \"\"\"Returns True if the character is a single ASCII lowercase letter ('a' through 'z').\"\"\"\n        return len(ch) == 1 and 'a' <= ch <= 'z'\n\nclass PatternMatcher:\n    \"\"\"Encapsulates a regular expression pattern and provides a matching method.\"\"\"\n    def __init__(self, pattern: str = \"[a-z]+_[a-z]+\"):\n        self.pattern: str = pattern\n        self._compiled = re.compile(self.pattern)\n\n    def match(self, text: TextInput) -> bool:\n        \"\"\"Applies the compiled regex to the input text and returns True if a match is found.\"\"\"\n        # The regex pattern \"[a-z]\" inherently restricts matches to ASCII lowercase characters.\n        return bool(self._compiled.search(text.value))\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore, returning true if found and false otherwise.\n    \"\"\"\n    ti = TextInput(text)\n    matcher = PatternMatcher()\n    return bool(matcher.match(ti))"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, filter: str) -> str:\n    \"\"\"Removes characters from the source string that are present in the filter string.\"\"\"\n    if source == \"\":\n        return \"\"\n    if filter == \"\":\n        return source\n\n    removal_set = set(filter)\n    result_chars = []\n    for ch in source:\n        if ch not in removal_set:\n            result_chars.append(ch)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    Returns True if a duplicate is found, False otherwise.\n    \"\"\"\n    seen = set()\n    for num in arr:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False"}
{"task_id": "Mbpp/56", "solution": "class ReversedNumber:\n    \"\"\"A data holder for a reversed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Number:\n    \"\"\"Represents an integer and provides methods for digit reversal.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def reverse(self) -> int:\n        \"\"\"Reverses the base-10 digits of the number and returns the integer result.\"\"\"\n        s = str(self.value)\n        reversed_s = s[::-1]\n        return int(reversed_s)\n\ndef check(n: int) -> bool:\n    \"\"\"Return True iff n == 2 * reverse(n) - 1, else False.\"\"\"\n    number_obj = Number(n)\n    reversed_int_value = number_obj.reverse()\n    reversed_obj = ReversedNumber(reversed_int_value)\n    actual_reversed_value = reversed_obj.value\n    return n == (2 * actual_reversed_value) - 1"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form k * 2**k - 1 for some integer k >= 1.\n    \"\"\"\n    def _find_k_helper(target_n: int) -> int:\n        \"\"\"\n        Finds the witness k for a Woodall number n, or 0 if not found.\n        It iterates k >= 1 and checks if n equals k * 2**k - 1.\n        \"\"\"\n        k = 1\n        while True:\n            # Compute expressionValue = k * 2**k - 1\n            expression_value = k * (2**k) - 1\n            if expression_value == target_n:\n                return k\n            elif expression_value > target_n:\n                return 0  # target_n is not a Woodall number, stop search\n            k += 1\n\n    return _find_k_helper(n) != 0"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n):\n    \"\"\"Calculates the nth octagonal number using the formula n * (3 * n - 2).\"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/58", "solution": "from typing import Any\n\ndef _validate_args(a: Any, b: Any) -> bool:\n    \"\"\"Private helper: raise TypeError if a or b is not int; return True otherwise.\"\"\"\n    if not isinstance(a, int):\n        raise TypeError(f\"Argument 'a' must be an integer, but received type {type(a).__name__}\")\n    if not isinstance(b, int):\n        raise TypeError(f\"Argument 'b' must be an integer, but received type {type(b).__name__}\")\n    return True\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"Return True iff one of a,b > 0 and the other < 0. Raises TypeError when inputs are not integers.\"\"\"\n    _validate_args(a, b)\n    return (a * b) < 0"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"Return the number of contiguous substrings of s where sum-of-digits == substring length.\n\n    Precondition: s contains only decimal digits (0-9).\n    \"\"\"\n    n = len(s)\n    count = 0\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            current_sum += (ord(s[j]) - ord('0'))\n            if current_sum == (j - i + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(marks):\n    \"\"\"\n    Sorts a list of tuples by the second element (score) in ascending order.\n    Validates input elements for correctness before sorting.\n    \"\"\"\n    if not isinstance(marks, (list, tuple)):\n        raise TypeError(\"marks must be a list (or tuple) of 2-tuples\")\n    if len(marks) == 0:\n        return []\n\n    validated = []\n    for idx, item in enumerate(marks):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(f\"element at index {idx} must be a 2-tuple\")\n        subject, score = item\n        if not isinstance(subject, str):\n            raise TypeError(f\"subject at index {idx} must be a string\")\n        if not isinstance(score, (int, float)):\n            raise TypeError(f\"score at index {idx} must be numeric\")\n        validated.append((subject, score))\n\n    result = sorted(validated, key=lambda x: x[1])\n    return result"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\n\nclass TuplePair:\n    \"\"\"\n    Data class holding a and b and computing abs_difference().\n    \"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a = float(a)\n        self.b = float(b)\n\n    def abs_difference(self) -> float:\n        \"\"\"\n        Calculates the absolute difference between a and b.\n        \"\"\"\n        return abs(self.a - self.b)\n\nclass Difference:\n    \"\"\"\n    Container for a computed difference value.\n    \"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass Result:\n    \"\"\"\n    Container for the final maximum value.\n    \"\"\"\n    def __init__(self, max_value: float) -> None:\n        self.max_value = max_value\n\ndef max_difference(input_list: list) -> float:\n    \"\"\"\n    Accepts a list of 2-element tuples, computes their absolute differences,\n    and returns the maximum absolute difference.\n    \"\"\"\n    if not input_list:\n        return 0.0\n\n    max_diff = 0.0\n    for a, b in input_list:\n        pair = TuplePair(a, b)\n        current_diff = pair.abs_difference()\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(number_list: list):\n    \"\"\"\n    Finds the numerically smallest value in a list of numbers.\n    Raises ValueError for an empty list or TypeError for non-numeric elements.\n    \"\"\"\n    return min(number_list)"}
{"task_id": "Mbpp/65", "solution": "_accumulator = 0\n\ndef _is_numeric(value):\n    \"\"\"\n    Checks if a value is an integer or a float, excluding booleans.\n    \"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef _traverse(element):\n    \"\"\"\n    Recursively traverses a list or element, summing numeric values into _accumulator.\n    \"\"\"\n    global _accumulator\n    if isinstance(element, list):\n        for item in element:\n            _traverse(item)\n    elif _is_numeric(element):\n        _accumulator += element\n\ndef recursive_list_sum(inputList):\n    \"\"\"\n    Flattens a list of nested lists and sums all its numeric elements.\n    \"\"\"\n    global _accumulator\n    _accumulator = 0  # Initialize accumulator for each call\n    _traverse(inputList)\n    return _accumulator"}
{"task_id": "Mbpp/57", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Represents a single digit (0-9) and validates its range.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_single_digit(self) -> bool:\n        \"\"\"Checks if the stored value is an integer between 0 and 9.\"\"\"\n        return isinstance(self.value, int) and 0 <= self.value <= 9\n\nclass DigitList:\n    \"\"\"A container for a list of raw integers, validating them as single digits.\"\"\"\n    def __init__(self, raw_digits: List[int]) -> None:\n        self._raw_digits = raw_digits\n        self.digits: List[Digit] = [] # Stores validated Digit objects\n        self._is_valid: bool = False\n\n    def validate(self) -> bool:\n        \"\"\"Performs validation on raw_digits and populates self.digits if valid.\"\"\"\n        if not isinstance(self._raw_digits, list):\n            self._is_valid = False\n            return False\n\n        temp_digits: List[Digit] = []\n        for item in self._raw_digits:\n            if not isinstance(item, int):\n                self._is_valid = False\n                return False\n            \n            digit_obj = Digit(item)\n            if not digit_obj.is_single_digit():\n                self._is_valid = False\n                return False\n            temp_digits.append(digit_obj)\n        \n        self.digits = temp_digits\n        self._is_valid = True\n        return True\n\n    def validate_or_raise(self) -> None:\n        \"\"\"Raises ValueError if any digit in the list is invalid.\"\"\"\n        if not self.validate():\n            raise ValueError(\"Input list contains non-integer or out-of-range elements (0-9).\")\n\nclass ResultNumber:\n    \"\"\"Converts a list of integer digits into a single integer.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self._digits = digits\n\n    def to_int(self) -> int:\n        \"\"\"Concatenates the digits and returns the resulting integer.\"\"\"\n        if not self._digits:\n            return 0\n        return int(\"\".join(map(str, self._digits)))\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Digits must be integers between 0 and 9; an empty list returns 0.\n    \"\"\"\n    if not digits:\n        return 0\n\n    digit_list_obj = DigitList(digits)\n    digit_list_obj.validate_or_raise()\n\n    valid_int_digits = [d.value for d in digit_list_obj.digits]\n    valid_int_digits.sort(reverse=True)\n\n    result_num_obj = ResultNumber(valid_int_digits)\n    return result_num_obj.to_int()"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers: list) -> int:\n    \"\"\"Return the count of elements in `numbers` strictly greater than 0.\n\n    Preconditions: `numbers` is a list.\n    \"\"\"\n    count = 0\n    for n in numbers:\n        if n > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "from typing import Any\n\nclass Error(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    def validate_non_negative_integer(self, n: Any) -> None:\n        if not isinstance(n, int) or n < 0:\n            raise Error('n must be a non-negative integer')\n\nclass BellNumberCalculator:\n    def bell_number(self, n: int) -> int:\n        validator = InputValidator()\n        validator.validate_non_negative_integer(n)\n\n        if n == 0:\n            return 1\n\n        return self.compute_bell_triangle(n)\n\n    def compute_bell_triangle(self, n: int) -> int:\n        # Builds Bell triangle (Aitken's array) using dynamic programming.\n        # The Bell number B_n is the first element of row n.\n        bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n        bell_triangle[0][0] = 1 # Base for triangle construction.\n\n        for i in range(1, n + 1):\n            bell_triangle[i][0] = bell_triangle[i-1][i-1] # First element of row i.\n            for j in range(1, i + 1):\n                bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1] # Fill current row.\n\n        return bell_triangle[n][0] # Bell number B_n.\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Finds the number of ways to partition a set of n elements.\n    This uses the Bell triangle dynamic programming method.\n    \"\"\"\n    calc = BellNumberCalculator()\n    return calc.bell_number(n)"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Any\n\ndef is_Monotonic(array: List[Any]) -> bool:\n    \"\"\"Return True if array is non-decreasing OR non-increasing; otherwise False.\n    The function must not mutate the input 'array'.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples: list[tuple]) -> bool:\n    \"\"\"Return True if every tuple in the input list 'tuples' has the same length; otherwise False.\n\n    Preconditions: callers pass a list of tuple objects as documented in the SRS.\n    \"\"\"\n    first_tuple_length = len(tuples[0])\n    for tpl in tuples:\n        if len(tpl) != first_tuple_length:\n            return False\n    return True"}
{"task_id": "Mbpp/69", "solution": "def _is_sequence(obj) -> bool:\n    \"\"\"Internal: True if obj supports sequence protocol (has __len__ and __getitem__).\"\"\"\n    return hasattr(obj, '__len__') and hasattr(obj, '__getitem__')\n\ndef _elements_equal(a, b) -> bool:\n    \"\"\"Internal: True if a and b are equal per language-standard equality.\n    If comparison raises an exception, return False.\n    \"\"\"\n    try:\n        return a == b\n    except Exception:\n        return False\n\ndef is_sublist(source_list, sublist) -> bool:\n    \"\"\"Return True iff sublist appears as a contiguous subsequence of source_list.\n    Raises TypeError when inputs are not list-like sequences. Empty sublist returns True (recommended).\n    \"\"\"\n    if not _is_sequence(source_list) or not _is_sequence(sublist):\n        raise TypeError(\"Both inputs must be list-like sequences.\")\n\n    if len(sublist) == 0:\n        return True\n\n    if len(sublist) > len(source_list):\n        return False\n\n    n = len(source_list)\n    m = len(sublist)\n\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if not _elements_equal(source_list[i + j], sublist[j]):\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(number):\n    \"\"\"Check whether integer 'number' can be represented as a^2 - b^2.\n    If number is not an int, raise TypeError(\"number must be int\").\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"number must be int\")\n    return (number % 4) != 2"}
{"task_id": "Mbpp/71", "solution": "from typing import List, Any\n\n# Module header (intent / docstring)\n\"\"\"\ncomb_sort module (implements comb_sort per SRS). Default shrink_factor = 1.3.\nPublic API: comb_sort(list) -> list\nRaises: NonComparableElementError when elements are not mutually comparable.\n\"\"\"\n\nclass NonComparableElementError(Exception):\n    \"\"\"Raised when two elements cannot be compared using the language's standard comparison operators.\"\"\"\n    pass\n\nclass Element:\n    \"\"\"Wrap raw value and provide compareTo using Python comparisons; used by CombSortFunction.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\n    def compareTo(self, other: 'Element') -> int:\n        \"\"\"Compares this element to another, returning -1 if less, 1 if greater, 0 if equal.\"\"\"\n        try:\n            if self.value < other.value:\n                return -1\n            if self.value > other.value:\n                return 1\n            return 0\n        except TypeError as e:\n            raise NonComparableElementError(f\"Elements {self.value!r} and {other.value!r} cannot be compared.\") from e\n\nclass InputList:\n    \"\"\"Thin wrapper for the input list.\"\"\"\n    def __init__(self, elements: list[Any]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass SortedList:\n    \"\"\"Wrapper for sorted result; SortedList.elements holds the native list.\"\"\"\n    def __init__(self, elements: list[Any]) -> None:\n        self.elements = elements\n\nclass CombSortFunction:\n    \"\"\"Implements Comb Sort algorithm; exposes comb_sort(InputList) -> SortedList.\"\"\"\n    def __init__(self, shrink_factor: float = 1.3) -> None:\n        self._shrink_factor = shrink_factor\n\n    def comb_sort(self, input_list: 'InputList') -> 'SortedList':\n        \"\"\"Applies the Comb Sort algorithm to the input list and returns a sorted list.\"\"\"\n        n = input_list.length()\n        if n == 0:\n            return SortedList([])\n\n        elements_to_sort = [Element(item) for item in input_list.elements]\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = max(1, int(gap / self._shrink_factor))\n            swapped = False\n\n            for i in range(n - gap):\n                if elements_to_sort[i].compareTo(elements_to_sort[i + gap]) == 1:\n                    elements_to_sort[i], elements_to_sort[i + gap] = elements_to_sort[i + gap], elements_to_sort[i]\n                    swapped = True\n        \n        sorted_native_list = [e.value for e in elements_to_sort]\n        return SortedList(sorted_native_list)\n\ndef comb_sort(list: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n\n    This public API constructs InputList, uses CombSortFunction, and returns a new native sorted list.\n    \"\"\"\n    input_wrapper = InputList(list)\n    sorter = CombSortFunction(shrink_factor=1.3)\n    sorted_wrapper = sorter.comb_sort(input_wrapper)\n    return sorted_wrapper.elements"}
{"task_id": "Mbpp/74", "solution": "class Sequence:\n    \"\"\"Lightweight, indexable wrapper for a list-like input; provides length access.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, index: int):\n        return self.elements[index]\n\nclass PatternSequence(Sequence):\n    \"\"\"Concrete Sequence representing patterns input.\"\"\"\n    def __init__(self, patterns):\n        super().__init__(patterns)\n        self.patterns = self.elements # Alias for clarity\n\nclass ItemSequence(Sequence):\n    \"\"\"Concrete Sequence representing items input.\"\"\"\n    def __init__(self, items):\n        super().__init__(items)\n        self.items = self.elements # Alias for clarity\n\nclass Mapping:\n    \"\"\"Maintains bidirectional mapping between pattern values and item values; validates consistency incrementally.\"\"\"\n    def __init__(self):\n        self.patternToItem = {}\n        self.itemToPattern = {}\n\n    def consistent(self, pattern, item) -> bool:\n        \"\"\"Test whether mapping would be consistent with existing stores without modifying them.\"\"\"\n        if pattern in self.patternToItem:\n            if self.patternToItem[pattern] != item:\n                return False\n        if item in self.itemToPattern:\n            if self.itemToPattern[item] != pattern:\n                return False\n        return True\n\n    def addMapping(self, pattern, item) -> bool:\n        \"\"\"Add mapping pattern->item and item->pattern if consistent; return True on success, False if conflict.\"\"\"\n        if not self.consistent(pattern, item):\n            return False\n\n        self.patternToItem[pattern] = item\n        self.itemToPattern[item] = pattern\n        return True\n\nclass Validator:\n    \"\"\"Orchestrates validation: length check, build and validate mapping index-wise, return boolean result.\"\"\"\n    def is_samepatterns(self, items, patterns) -> bool:\n        \"\"\"Top-level method; public use-case entry for internal Validator.\"\"\"\n        item_sequence = ItemSequence(items)\n        pattern_sequence = PatternSequence(patterns)\n\n        if not self.checkLength(item_sequence, pattern_sequence):\n            return False\n\n        return self.buildAndValidateMapping(item_sequence, pattern_sequence)\n\n    def checkLength(self, item_sequence: ItemSequence, pattern_sequence: PatternSequence) -> bool:\n        \"\"\"Return False if lengths differ, True otherwise.\"\"\"\n        return item_sequence.length() == pattern_sequence.length()\n\n    def buildAndValidateMapping(self, item_sequence: ItemSequence, pattern_sequence: PatternSequence) -> bool:\n        \"\"\"Iterate index-wise and use Mapping.addMapping/consistent to validate bijection; return False on first inconsistency.\"\"\"\n        mapping = Mapping()\n        for i in range(item_sequence.length()):\n            current_item = item_sequence[i]\n            current_pattern = pattern_sequence[i]\n\n            if not mapping.addMapping(current_pattern, current_item):\n                return False\n        return True\n\ndef is_samepatterns(items, patterns) -> bool:\n    \"\"\"\n    Checks whether the sequence of items follows the sequence given in the patterns array\n    according to a bijective mapping.\n    \"\"\"\n    validator = Validator()\n    return validator.is_samepatterns(items, patterns)"}
{"task_id": "Mbpp/75", "solution": "def _validate_input_list(input_list):\n    \"\"\"Validate that input_list is a list of tuples containing only integers.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list.\")\n    for item in input_list:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All items in input_list must be tuples.\")\n        for element in item:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements within tuples must be integers.\")\n\ndef _validate_k(k):\n    \"\"\"Validate that k is a non-zero integer.\"\"\"\n    if not isinstance(k, int):\n        raise ValueError(\"k must be an integer.\")\n    if k == 0:\n        raise ValueError(\"k cannot be zero.\")\n\ndef _tuple_all_divisible(t, k):\n    \"\"\"Check if all elements in tuple t are divisible by k.\"\"\"\n    return all((element % k) == 0 for element in t)\n\ndef find_tuples(input_list, k):\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n    Validates input_list and k, then filters tuples based on divisibility.\n    \"\"\"\n    _validate_input_list(input_list)\n    _validate_k(k)\n\n    result = []\n    for t in input_list:\n        if _tuple_all_divisible(t, k):\n            result.append(t)\n    return result"}
