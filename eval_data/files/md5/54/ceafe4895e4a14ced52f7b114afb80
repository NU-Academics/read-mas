{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass Matrix:\n    \"\"\"\n    Represents an n x n matrix and provides accessors for rows, columns and diagonals.\n    \"\"\"\n    def __init__(self, data: List[List[int]]) -> None:\n        self.data = data\n        self.n = len(data) if data else 0\n\n    def get_row(self, i: int) -> List[int]:\n        return self.data[i]\n\n    def get_col(self, j: int) -> List[int]:\n        return [self.data[i][j] for i in range(self.n)]\n\n    def get_main_diagonal(self) -> List[int]:\n        return [self.data[i][i] for i in range(self.n)]\n\n    def get_secondary_diagonal(self) -> List[int]:\n        return [self.data[i][self.n - 1 - i] for i in range(self.n)]\n\nclass TestResult:\n    \"\"\"\n    Simple data carrier for result details.\n    \"\"\"\n    def __init__(self, is_magic: bool, target_sum: int) -> None:\n        self.is_magic = is_magic\n        self.target_sum = target_sum\n\nclass MagicSquareTest:\n    \"\"\"\n    Encapsulates all checks for magic-square validation: validate, compute target, check rows, columns, diagonals.\n    \"\"\"\n    def magic_square_test(self, matrix: Matrix) -> bool:\n        if not self._validate_square(matrix):\n            return False\n\n        target_sum = self._compute_target_sum(matrix)\n\n        if not self._check_rows(matrix, target_sum):\n            return False\n        if not self._check_columns(matrix, target_sum):\n            return False\n        if not self._check_diagonals(matrix, target_sum):\n            return False\n\n        return True\n\n    def _compute_target_sum(self, matrix: Matrix) -> int:\n        return sum(matrix.get_row(0))\n\n    def _validate_square(self, matrix: Matrix) -> bool:\n        if matrix.n == 0:\n            return False\n        for row in matrix.data:\n            if len(row) != matrix.n:\n                return False\n        return True\n\n    def _check_rows(self, matrix: Matrix, target: int) -> bool:\n        for i in range(matrix.n):\n            if sum(matrix.get_row(i)) != target:\n                return False\n        return True\n\n    def _check_columns(self, matrix: Matrix, target: int) -> bool:\n        for j in range(matrix.n):\n            if sum(matrix.get_col(j)) != target:\n                return False\n        return True\n\n    def _check_diagonals(self, matrix: Matrix, target: int) -> bool:\n        if sum(matrix.get_main_diagonal()) != target:\n            return False\n        if sum(matrix.get_secondary_diagonal()) != target:\n            return False\n        return True\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines whether a given two-dimensional list represents a magic square.\n    Returns True if it's a magic square, False otherwise.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    tester = MagicSquareTest()\n    return tester.magic_square_test(matrix_obj)"}
{"task_id": "Mbpp/133", "solution": "from typing import List\n\ndef sum_negativenum(numbers: List[float]) -> float:\n    \"\"\"\n    Calculates the sum of all negative numbers in a list.\n    Returns 0.0 if no negative numbers are found.\n    \"\"\"\n    negative_numbers = [num for num in numbers if num < 0]\n    return float(sum(negative_numbers))"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string, preserving non-vowel positions and character cases.\n    Vowels are defined as 'a', 'e', 'i', 'o', 'u' and their uppercase equivalents; 'y' is not a vowel.\n    \"\"\"\n    vowels = set('aeiouAEIOU')\n    \n    s_list = list(s)\n    vowel_indices = []\n    vowel_chars = []\n    \n    for i, char in enumerate(s_list):\n        if char in vowels:\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n            \n    if len(vowel_chars) <= 1:\n        return s\n            \n    vowel_chars.reverse()\n    \n    for i, idx in enumerate(vowel_indices):\n        s_list[idx] = vowel_chars[i]\n        \n    return \"\".join(s_list)"}
{"task_id": "Mbpp/135", "solution": "class HexagonalNumberException(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidInputException(HexagonalNumberException):\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass OverflowException(HexagonalNumberException):\n    def __init__(self, message: str):\n        super().__init__(message)\n\nMIN_INT = -9223372036854775808\nMAX_INT = 9223372036854775807\n\nclass InputValidator:\n    def isPositiveInteger(self, n: int) -> bool:\n        \"\"\"Checks if n is a positive integer.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass IntegerRangeChecker:\n    def willOverflowMultiplication(self, n: int) -> bool:\n        \"\"\"Checks if the hexagonal number for n would exceed 64-bit signed integer bounds.\"\"\"\n        h = n * (2 * n - 1)\n        return not (MIN_INT <= h <= MAX_INT)\n\nclass HexagonalCalculator:\n    def computeHexagonal(self, n: int) -> int:\n        \"\"\"Computes the nth hexagonal number.\"\"\"\n        return n * (2 * n - 1)\n\nclass HexagonalNumberResult:\n    def __init__(self, value: int):\n        \"\"\"Initializes the result with the computed hexagonal number.\"\"\"\n        self.value = value\n\ndef hexagonal_num(n):\n    \"\"\"\n    Finds the nth hexagonal number, validating input and checking for overflow.\n    H(n) = n * (2 * n - 1)\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isPositiveInteger(n):\n        raise InvalidInputException('n must be a positive integer >= 1')\n    \n    checker = IntegerRangeChecker()\n    if checker.willOverflowMultiplication(n):\n        raise OverflowException('H(n) would overflow 64-bit signed integer range')\n    \n    calculator = HexagonalCalculator()\n    value = calculator.computeHexagonal(n)\n    \n    result = HexagonalNumberResult(value)\n    return result.value"}
{"task_id": "Mbpp/137", "solution": "from typing import Iterable, List\nimport math\n\nclass IntegerArray:\n    \"\"\"Represents and validates a sequence of integers; provides counts of zeros and non-zeros.\"\"\"\n    def __init__(self, elements: Iterable[int]) -> None:\n        if not isinstance(elements, Iterable):\n            raise TypeError(\"Input must be an iterable.\")\n        \n        self.elements: List[int] = []\n        for element in elements:\n            if not isinstance(element, int):\n                raise TypeError(f\"All elements in the array must be integers, found: {type(element).__name__}\")\n            self.elements.append(element)\n\n    def count_zero(self) -> int:\n        \"\"\"Counts the number of zero elements.\"\"\"\n        return self.elements.count(0)\n\n    def count_non_zero(self) -> int:\n        \"\"\"Counts the number of non-zero elements.\"\"\"\n        return len(self.elements) - self.count_zero()\n\nclass ZeroCountCalculator:\n    \"\"\"Stateless calculator that implements the ratio business rule.\"\"\"\n    def compute_ratio(self, arr: IntegerArray) -> float:\n        \"\"\"Computes the ratio of zero to non-zero elements.\"\"\"\n        zero_count = arr.count_zero()\n        non_zero_count = arr.count_non_zero()\n\n        if non_zero_count == 0:\n            raise ValueError(\"Cannot compute ratio: count of non-zero elements is zero.\")\n        \n        return float(zero_count) / non_zero_count\n\nclass ZeroCountResult:\n    \"\"\"Value object to carry computed ratio and status.\"\"\"\n    def __init__(self, ratio: float, status: str) -> None:\n        self.ratio = ratio\n        self.status = status\n\nclass TestCase:\n    \"\"\"Domain test class encapsulating input, expected, tolerance; run() performs math.isclose verification.\"\"\"\n    def __init__(self, input: Iterable[int], expected: float, tolerance: float) -> None:\n        self.input = input\n        self.expected = expected\n        self.tolerance = tolerance\n\n    def run(self) -> bool:\n        \"\"\"Runs the test case and returns True if the result is within tolerance.\"\"\"\n        calculated_ratio = zero_count(self.input)\n        return math.isclose(calculated_ratio, self.expected, rel_tol=self.tolerance)\n\ndef zero_count(arr: Iterable[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Raises TypeError for invalid input or ValueError if non-zero count is zero.\n    \"\"\"\n    integer_array = IntegerArray(arr)\n    calculator = ZeroCountCalculator()\n    \n    ratio = calculator.compute_ratio(integer_array)\n    return ratio"}
