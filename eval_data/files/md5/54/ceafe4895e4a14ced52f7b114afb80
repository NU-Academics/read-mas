{"task_id": "Mbpp/119", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\ndef is_sorted(input_list) -> bool:\n    \"\"\"Checks if the input list is sorted in non-decreasing order.\"\"\"\n    return all(input_list[i] <= input_list[i + 1] for i in range(len(input_list) - 1))\n\ndef _find_unique_binary_search(input_list) -> int:\n    \"\"\"Finds the unique element using a binary search approach.\"\"\"\n    low = 0\n    high = len(input_list) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # If mid is the unique element\n        if (mid == 0 or input_list[mid] != input_list[mid - 1]) and \\\n           (mid == len(input_list) - 1 or input_list[mid] != input_list[mid + 1]):\n            return input_list[mid]\n\n        # Check if the unique element is in the left half\n        # If mid is odd and input_list[mid] == input_list[mid-1], then pairs are (0,1), (2,3) ... (mid-1, mid)\n        # Unique element is on the right\n        # If mid is even and input_list[mid] == input_list[mid+1], then pairs are (0,1), (2,3) ... (mid, mid+1)\n        # Unique element is on the right\n        if (mid % 2 == 1 and input_list[mid] == input_list[mid - 1]) or \\\n           (mid % 2 == 0 and input_list[mid] == input_list[mid + 1]):\n            low = mid + 1\n        else: # Unique element is on the left\n            high = mid - 1\n    \n    # This should not be reached if the input guarantees a unique element exists\n    return -1 \n\ndef search(input_list):\n    \"\"\"\n    Finds the element that appears only once in a sorted array where\n    all other elements appear exactly twice.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise ValidationError(\"input_list must be a list-like container.\")\n\n    if not all(isinstance(x, int) for x in input_list):\n        raise ValidationError(\"input_list must contain only integers.\")\n\n    if not is_sorted(input_list):\n        raise ValidationError(\"input_list must be sorted.\")\n    \n    if not input_list:\n        raise ValidationError(\"input_list cannot be empty.\")\n\n    # Validate multiplicity precondition: exactly one element appears once\n    # and others appear twice. This implies odd length.\n    if len(input_list) % 2 == 0:\n        raise ValidationError(\"input_list must contain an odd number of elements for exactly one unique element.\")\n    \n    # A more robust multiplicity check for the exact constraint\n    counts = {}\n    for x in input_list:\n        counts[x] = counts.get(x, 0) + 1\n    \n    unique_count = 0\n    for count in counts.values():\n        if count == 1:\n            unique_count += 1\n        elif count != 2:\n            raise ValidationError(\"All elements except one must appear exactly twice.\")\n            \n    if unique_count != 1:\n        raise ValidationError(\"input_list must contain exactly one element that appears once.\")\n\n\n    return _find_unique_binary_search(input_list)"}
{"task_id": "Mbpp/116", "solution": "def _is_tuple(obj):\n    \"\"\"Checks if the given object is a tuple.\"\"\"\n    return isinstance(obj, tuple)\n\ndef _is_positive_int(n):\n    \"\"\"Checks if the given number is a positive integer.\"\"\"\n    return isinstance(n, int) and n > 0\n\ndef tuple_to_int(tuple):\n    \"\"\"Converts a tuple of positive integers into a single integer.\"\"\"\n    if not _is_tuple(tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    string_parts = []\n    for element in tuple:\n        if not _is_positive_int(element):\n            raise ValueError(\"All tuple elements must be positive integers.\")\n        string_parts.append(str(element))\n\n    return int(\"\".join(string_parts))"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Raises TypeError if any input element is not a 2-element numeric tuple.\n    \"\"\"\n    max_abs_product = 0.0\n\n    for pair in pairs:\n        if not isinstance(pair, tuple):\n            raise TypeError(\"Each element in 'pairs' must be a tuple.\")\n        if len(pair) != 2:\n            raise TypeError(\"Each tuple must contain exactly two numeric values.\")\n        if not all(isinstance(x, (int, float)) for x in pair):\n            raise TypeError(\"Both elements in each tuple must be numeric (int or float).\")\n\n        a, b = pair\n        current_product = a * b\n        max_abs_product = max(max_abs_product, abs(current_product))\n\n    return max_abs_product"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Union\n\n@dataclass\nclass ComplexNumber:\n    real: float\n    imag: float\n\n@dataclass\nclass AngleResult:\n    angle: float\n\ndef _coerce_to_complexnumber(value) -> ComplexNumber:\n    \"\"\"Coerces a numeric value (int, float, complex) to a ComplexNumber dataclass.\"\"\"\n    if isinstance(value, complex):\n        return ComplexNumber(real=float(value.real), imag=float(value.imag))\n    if isinstance(value, (int, float)):\n        return ComplexNumber(real=float(value), imag=0.0)\n    raise TypeError(\"angle_complex: input must be numeric (int, float, or complex)\")\n\ndef angle_complex(*args) -> float:\n    \"\"\"\n    Calculates the angle (argument) of a complex number in radians.\n    Accepts either a single complex number or two numeric arguments (real, imag).\n    \"\"\"\n    if len(args) == 1:\n        cn = _coerce_to_complexnumber(args[0])\n    elif len(args) == 2:\n        real_arg, imag_arg = args[0], args[1]\n        if not isinstance(real_arg, (int, float, complex)) or not isinstance(imag_arg, (int, float, complex)):\n            raise TypeError(\"angle_complex: both real and imag arguments must be numeric.\")\n        \n        # Coerce to float, handling complex numbers in separate arguments\n        real_val = float(real_arg.real) if isinstance(real_arg, complex) else float(real_arg)\n        imag_val = float(imag_arg.imag) if isinstance(imag_arg, complex) else float(imag_arg)\n        cn = ComplexNumber(real=real_val, imag=imag_val)\n    else:\n        raise TypeError(\"angle_complex: expected 1 or 2 arguments\")\n\n    angle = math.atan2(cn.imag, cn.real)\n    return float(angle)"}
