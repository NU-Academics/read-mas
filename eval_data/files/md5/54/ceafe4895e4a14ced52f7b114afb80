{"task_id": "Mbpp/283", "solution": "from typing import Dict, List\nfrom collections import Counter\nfrom dataclasses import dataclass\n\n@dataclass\nclass Digit:\n    \"\"\"Represents a single decimal digit with its character form and numeric integer value.\"\"\"\n    char: str\n    numeric_value: int\n\n@dataclass\nclass DigitFrequency:\n    \"\"\"Stores the occurrence count for a Digit within the input number.\"\"\"\n    digit: Digit\n    count: int\n\n@dataclass\nclass ValidationResult:\n    \"\"\"Encapsulates the boolean outcome of validation.\"\"\"\n    is_valid: bool\n\n@dataclass\nclass IntegerInput:\n    \"\"\"Represents the integer input and provides normalization to a decimal digit string without sign.\"\"\"\n    value: int\n    digits: str = \"\"\n\n    def normalize(self) -> str:\n        \"\"\"Normalizes the integer input to an absolute decimal digit string.\"\"\"\n        self.digits = str(abs(self.value))\n        return self.digits\n\nclass ValidateFunction:\n    \"\"\"Performs the end-to-end validation algorithm for digit frequencies.\"\"\"\n\n    def validate(self, input_int: int) -> bool:\n        \"\"\"Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\"\"\"\n        integer_input = IntegerInput(value=input_int)\n        digit_string = integer_input.normalize()\n\n        digit_counts = Counter(digit_string)\n\n        for char_digit, count in digit_counts.items():\n            digit = Digit(char=char_digit, numeric_value=int(char_digit))\n            digit_frequency = DigitFrequency(digit=digit, count=count)\n\n            if not (digit_frequency.count <= digit.numeric_value):\n                return ValidationResult(is_valid=False).is_valid\n        \n        return ValidationResult(is_valid=True).is_valid\n\ndef validate(input: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    This function delegates the validation logic to an internal ValidateFunction instance.\n    \"\"\"\n    return ValidateFunction().validate(input)"}
{"task_id": "Mbpp/285", "solution": "_PATTERNS = (\"abb\", \"abbb\")\n\ndef text_match_two_three(text):\n    \"\"\"\n    Checks if the input string contains 'a' followed by two or three 'b' characters.\n    Returns True if \"abb\" or \"abbb\" is found, False otherwise.\n    \"\"\"\n    if len(text) < 3:\n        return False\n\n    for pattern in _PATTERNS:\n        if pattern in text:\n            return True\n    return False"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first sublist found with that length.\n    \"\"\"\n    max_length_val = 0\n    max_length_list = []\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length_val:\n            max_length_val = current_length\n            max_length_list = sublist\n            \n    return (max_length_val, max_length_list)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Raises ValueError if n is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError('n must be an integer')\n    if n < 0:\n        raise ValueError('n must be >= 0')\n\n    # Formula: sum_{k=1..n} (2k)^2 = 4 * sum_{k=1..n} k^2\n    # And sum_{k=1..n} k^2 = n*(n+1)*(2n+1)/6\n    # So, result = 4 * (n * (n + 1) * (2 * n + 1) // 6)\n    result = 4 * (n * (n + 1) * (2 * n + 1) // 6)\n    return result"}
{"task_id": "Mbpp/292", "solution": "import math\n\ndef find(dividend, divisor):\n    \"\"\"\n    Calculates the floor of the quotient of two numbers.\n    Raises ZeroDivisionError if the divisor is zero.\n    \"\"\"\n    if divisor == 0:\n        raise ZeroDivisionError(\"divisor cannot be zero\")\n    \n    return int(math.floor(dividend / divisor))"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\ndef _kadane(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum contiguous subarray sum in a single array using Kadane's algorithm.\n    Handles arrays with all negative numbers by returning the largest (least negative) element.\n    \"\"\"\n    if not arr:\n        return 0 \n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef _max_subarray_twice(arr: List[int]) -> int:\n    \"\"\"\n    Computes the maximum contiguous subarray sum for arr concatenated with itself (arr + arr).\n    This accounts for subarrays entirely within one arr or those spanning the boundary.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_single_arr = _kadane(arr)\n\n    # Calculate max prefix sum (largest sum of a subarray starting from arr[0])\n    max_prefix = float('-inf')\n    current_sum = 0\n    for x in arr:\n        current_sum += x\n        max_prefix = max(max_prefix, current_sum)\n\n    # Calculate max suffix sum (largest sum of a subarray ending at arr[len(arr)-1])\n    max_suffix = float('-inf')\n    current_sum = 0\n    for i in range(len(arr) - 1, -1, -1):\n        current_sum += arr[i]\n        max_suffix = max(max_suffix, current_sum)\n    \n    # The maximum sum for two repetitions is the maximum of:\n    # 1. A subarray entirely within one instance of `arr`.\n    # 2. A subarray that spans the boundary between the two `arr` instances.\n    return max(max_single_arr, max_prefix + max_suffix)\n\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array,\n    which is formed by repeating the given array k times.\n    \"\"\"\n    if n != len(arr) or k < 1:\n        raise ValueError(\"n must equal len(arr) and k must be >= 1\")\n\n    if n == 0:\n        return 0\n\n    total_sum_arr = sum(arr)\n\n    if k == 1:\n        return _kadane(arr)\n    else: # k >= 2\n        max_sum_two_repetitions = _max_subarray_twice(arr)\n        \n        # If the total sum of the array is positive, and k is greater than 2,\n        # we can add (k-2) * total_sum_arr to the result.\n        # This accounts for the full `arr` blocks in the middle that contribute positively.\n        # If total_sum_arr is not positive, adding more full blocks would not increase the sum.\n        if total_sum_arr > 0 and k > 2:\n            return max_sum_two_repetitions + (k - 2) * total_sum_arr\n        else:\n            return max_sum_two_repetitions"}
{"task_id": "Mbpp/296", "solution": "class Array:\n    \"\"\"\n    Lightweight wrapper around Python list to represent the SRS Array domain class.\n    \"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the number of elements in the array.\n        \"\"\"\n        return len(self.elements)\n\nclass InversionResult:\n    \"\"\"\n    Simple container for inversion count result.\n    \"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\nclass InversionCounter:\n    \"\"\"\n    Encapsulates validation and inversion counting algorithm.\n    \"\"\"\n    def validate_input(self, array_wrapper: Array) -> bool:\n        \"\"\"\n        Validates that input is a list and elements are integers.\n        Raises TypeError or ValueError on invalid input.\n        \"\"\"\n        elements = array_wrapper.elements\n        if not isinstance(elements, list):\n            raise TypeError(\"Input must be a list.\")\n        for element in elements:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n        return True\n\n    def _merge_and_count_split_inversions(self, left_arr: list[int], right_arr: list[int]) -> tuple[list[int], int]:\n        \"\"\"\n        Merges two sorted arrays and counts inversions between them.\n        \"\"\"\n        merged_arr = []\n        inversions = 0\n        i, j = 0, 0\n        while i < len(left_arr) and j < len(right_arr):\n            if left_arr[i] <= right_arr[j]:\n                merged_arr.append(left_arr[i])\n                i += 1\n            else:\n                merged_arr.append(right_arr[j])\n                j += 1\n                inversions += (len(left_arr) - i)\n        merged_arr.extend(left_arr[i:])\n        merged_arr.extend(right_arr[j:])\n        return merged_arr, inversions\n\n    def _merge_sort_and_count(self, arr: list[int]) -> tuple[list[int], int]:\n        \"\"\"\n        Recursively sorts an array and counts inversions within it.\n        \"\"\"\n        if len(arr) <= 1:\n            return arr, 0\n        \n        mid = len(arr) // 2\n        left_half, left_inversions = self._merge_sort_and_count(arr[:mid])\n        right_half, right_inversions = self._merge_sort_and_count(arr[mid:])\n        \n        merged_arr, split_inversions = self._merge_and_count_split_inversions(left_half, right_half)\n        \n        total_inversions = left_inversions + right_inversions + split_inversions\n        return merged_arr, total_inversions\n\n    def count_using_merge_sort(self, array_wrapper: Array) -> int:\n        \"\"\"\n        Implements merge-sort\u2013based inversion counting.\n        \"\"\"\n        _, total_inversions = self._merge_sort_and_count(list(array_wrapper.elements))\n        return total_inversions\n\n    def get_Inv_Count(self, array_wrapper: Array) -> int:\n        \"\"\"\n        Validates input and computes the inversion count.\n        \"\"\"\n        self.validate_input(array_wrapper)\n        count = self.count_using_merge_sort(array_wrapper)\n        return count\n\ndef get_Inv_Count(array):\n    \"\"\"\n    Public API: compute inversion count for given Python list of integers.\n    Raises:\n        TypeError: if input is not a list.\n        ValueError: if any element of the list is not an int.\n    Returns:\n        int: total number of inversions.\n    \"\"\"\n    arr_obj = Array(list(array))\n    counter = InversionCounter()\n    return counter.get_Inv_Count(arr_obj)"}
{"task_id": "Mbpp/294", "solution": "def _is_numeric(item):\n    \"\"\"Checks if an item is a numeric type (int or float, excluding bool).\"\"\"\n    return isinstance(item, (int, float)) and not isinstance(item, bool)\n\ndef ParseElements(input_list):\n    \"\"\"Parses the input list, returning its elements.\"\"\"\n    return input_list\n\ndef FilterNonNumeric(elements):\n    \"\"\"Filters a list to return only numeric elements.\"\"\"\n    return [item for item in elements if _is_numeric(item)]\n\ndef ComputeMax(numeric_elements):\n    \"\"\"Computes the maximum value from a list of numeric elements.\"\"\"\n    if not numeric_elements:\n        raise ValueError(\"No numeric elements found in the list.\")\n    return max(numeric_elements)\n\ndef max_val(input_list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Raises ValueError if no numeric elements are present.\n    \"\"\"\n    parsed_elements = ParseElements(input_list)\n    numeric_elements = FilterNonNumeric(parsed_elements)\n    maximum_value = ComputeMax(numeric_elements)\n    return maximum_value"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef validate_numeric(value) -> bool:\n    \"\"\"Returns True if value is numeric (int or float, not bool), otherwise False.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef validate_finite(value) -> bool:\n    \"\"\"Returns True if value is finite, otherwise False.\"\"\"\n    return math.isfinite(float(value))\n\ndef compute_hypotenuse(a: float, b: float) -> float:\n    \"\"\"Computes the hypotenuse using math.hypot for numeric stability.\"\"\"\n    return float(math.hypot(a, b))\n\ndef otherside_rightangle(a, b) -> float:\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle, validating inputs.\n    Raises TypeError for non-numeric inputs and ValueError for non-finite inputs.\n    \"\"\"\n    if not validate_numeric(a):\n        raise TypeError(f\"Side 'a' must be a numeric value (int or float), but got {type(a).__name__}.\")\n    if not validate_finite(a):\n        raise ValueError(f\"Side 'a' must be a finite numeric value, but got {a}.\")\n\n    if not validate_numeric(b):\n        raise TypeError(f\"Side 'b' must be a numeric value (int or float), but got {type(b).__name__}.\")\n    if not validate_finite(b):\n        raise ValueError(f\"Side 'b' must be a finite numeric value, but got {b}.\")\n\n    return compute_hypotenuse(a, b)"}
{"task_id": "Mbpp/297", "solution": "import typing\n\nclass FlattenFunction:\n    \"\"\"\n    Helper class to manage the flattening process, including input validation\n    and recursive traversal.\n    \"\"\"\n    def validateInput(self, input_list: typing.Any) -> None:\n        \"\"\"\n        Validates that the input is a list. Raises TypeError if not.\n        \"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n\n    def _flatten_recursive(self, item: typing.Any, output_list: list) -> None:\n        \"\"\"\n        Recursively flattens an item. If the item is a list, it iterates through\n        its elements; otherwise, it appends the item to the output list.\n        \"\"\"\n        if isinstance(item, list):\n            for sub_item in item:\n                self._flatten_recursive(sub_item, output_list)\n        else:\n            output_list.append(item)\n\n    def flatten(self, input_list: list) -> list:\n        \"\"\"\n        Flattens a given nested list structure into a single-level list.\n        \"\"\"\n        self.validateInput(input_list)\n        flattened_list = []\n        self._flatten_recursive(input_list, flattened_list)\n        return flattened_list\n\n\ndef flatten_list(input_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    \"\"\"\n    flattener = FlattenFunction()\n    return flattener.flatten(input_list)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef C(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient \"a choose b\".\n    If b is outside the range [0, a], it returns 0 as per standard definition.\n    \"\"\"\n    if b < 0 or b > a:\n        return 0\n    \n    # Optimization: C(n, k) = C(n, n-k)\n    if b > a // 2:\n        b = a - b\n    \n    res = 1\n    for i in range(b):\n        res = res * (a - i) // (i + 1)\n    return res\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Counts binary sequences of length 2n such that sum of first n bits is same as sum of last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    return C(2 * n, n)"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict, Union, Optional\n\nclass Aggregator:\n    def aggregate(self, entries: List[Tuple[str, Union[int, float]]]) -> Dict[str, float]:\n        \"\"\"Aggregates numeric values by name into a dictionary.\"\"\"\n        aggregate_map: Dict[str, float] = {}\n        for name, value in entries:\n            aggregate_map[name] = aggregate_map.get(name, 0.0) + float(value)\n        return aggregate_map\n\n    def maxAggregate(self, entries: List[Tuple[str, Union[int, float]]]) -> Optional[Tuple[str, Union[int, float]]]:\n        \"\"\"\n        Calculates the maximum aggregate sum and returns the corresponding name and sum.\n        Handles empty input and deterministic tie-breaking (lexicographically smallest name).\n        \"\"\"\n        if not entries:\n            return None\n\n        aggregate_map = self.aggregate(entries)\n\n        max_name: Optional[str] = None\n        max_sum: Union[int, float] = -float('inf')\n\n        for name, current_sum in aggregate_map.items():\n            if current_sum > max_sum:\n                max_sum = current_sum\n                max_name = name\n            elif current_sum == max_sum:\n                if max_name is None or name < max_name:\n                    max_name = name\n        \n        if max_name is not None:\n            if max_sum == int(max_sum):\n                return (max_name, int(max_sum))\n            else:\n                return (max_name, max_sum)\n        else:\n            return None\n\ndef max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Optional[Tuple[str, Union[int, float]]]:\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of (name, value) tuples.\n    Returns (name, aggregate_sum) for the name with the highest sum, or None if input is empty.\n    \"\"\"\n    aggregator = Aggregator()\n    return aggregator.maxAggregate(entries)"}
{"task_id": "Mbpp/301", "solution": "class DepthCalculator:\n    @staticmethod\n    def _compute_depth(d):\n        \"\"\"Internal algorithm: return int depth (top-level=1).\"\"\"\n        max_nested_depth = 0\n        for value in d.values():\n            if isinstance(value, dict):\n                max_nested_depth = max(max_nested_depth, DepthCalculator._compute_depth(value))\n        return 1 + max_nested_depth\n\n    @staticmethod\n    def dict_depth(d):\n        \"\"\"Compute and return maximum dictionary nesting depth (int).\"\"\"\n        return DepthCalculator._compute_depth(d)\n\ndef dict_depth(d):\n    \"\"\"Public API: accepts a single argument d (dict) and returns int depth.\"\"\"\n    return DepthCalculator.dict_depth(d)"}
{"task_id": "Mbpp/305", "solution": "class Word:\n    def __init__(self, text: str):\n        self.text = text\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' or 'P'.\"\"\"\n        return bool(self.text) and self.text[0].lower() == 'p'\n\nclass StringElement:\n    def __init__(self, text: str):\n        self.text = text\n\n    def split_into_words(self) -> list['Word']:\n        \"\"\"Splits the string into Word objects.\"\"\"\n        return [Word(token) for token in self.text.split()]\n\nclass InputList:\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def __iter__(self):\n        \"\"\"Yields StringElement for each list element.\"\"\"\n        for element in self.elements:\n            yield StringElement(element)\n\nclass MatchResult:\n    def __init__(self, match1: str, match2: str):\n        self.match1 = match1\n        self.match2 = match2\n\n    def to_tuple(self) -> tuple[str, str]:\n        \"\"\"Returns the matched words as a tuple.\"\"\"\n        return (self.match1, self.match2)\n\nclass StartWithP:\n    def start_withp(self, input_list_elements: list) -> tuple[str, str]:\n        \"\"\"Scans for and returns the first two words starting with 'p' or 'P'.\"\"\"\n        matched_words = []\n        for string_element in InputList(input_list_elements):\n            for word in string_element.split_into_words():\n                if word.starts_with_p():\n                    matched_words.append(word.text)\n                    if len(matched_words) == 2:\n                        return MatchResult(matched_words[0], matched_words[1]).to_tuple()\n\n        raise ValueError(\"input_list must be a list of strings containing at least two words starting with 'p' or 'P'.\")\n\n\ndef start_withp(input_list: list) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings starting with 'p' or 'P'.\n\n    Raises ValueError if input_list is not a list of strings or contains\n    fewer than two matching words.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise ValueError(\"input_list must be a list of strings containing at least two words starting with 'p' or 'P'.\")\n\n    for item in input_list:\n        if not isinstance(item, str):\n            raise ValueError(\"input_list must be a list of strings containing at least two words starting with 'p' or 'P'.\")\n\n    return StartWithP().start_withp(input_list)"}
{"task_id": "Mbpp/308", "solution": "class ValidationError(ValueError):\n    \"\"\"Custom exception for validation errors, subclass of ValueError.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_inputs(list1, list2, k) -> None:\n    \"\"\"Validates the input lists and k value, raising ValidationError on failure.\"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise ValidationError(\"list1 and list2 must be lists\")\n    if not isinstance(k, int) or k < 0:\n        raise ValidationError(\"k must be a non-negative integer\")\n\nclass Product:\n    \"\"\"Represents a product of two factors with its computed value.\"\"\"\n    def __init__(self, factor1, factor2):\n        self.factor1 = factor1\n        self.factor2 = factor2\n        self.value = factor1 * factor2\n\nclass InputList:\n    \"\"\"Represents an input list, intended for factor storage.\"\"\"\n    def __init__(self, id: str, elements: list):\n        self.id = id\n        self.elements = elements\n\nclass ResultSet:\n    \"\"\"Manages a collection of product values for sorting and selection.\"\"\"\n    def __init__(self, products: list):\n        self.products = products\n\n    def sort_descending(self) -> None:\n        \"\"\"Sorts the stored product values in descending order in-place.\"\"\"\n        self.products.sort(reverse=True)\n\n    def top(self, k: int) -> list:\n        \"\"\"Returns the top k products, or fewer if not enough exist.\"\"\"\n        if k <= 0:\n            return []\n        return self.products[:k] if k < len(self.products) else list(self.products)\n\nclass LargeProductFunction:\n    \"\"\"Orchestrates the process of finding the largest products.\"\"\"\n    def large_product(self, list1, list2, k) -> list:\n        \"\"\"Performs validation, product generation, sorting, and top-k selection.\"\"\"\n        self.validate_inputs(list1, list2, k)\n        \n        all_products_values = self.generate_products(list1, list2)\n        \n        result_set = ResultSet(all_products_values)\n        result_set.sort_descending()\n        \n        return result_set.top(k)\n\n    def generate_products(self, list1, list2) -> list:\n        \"\"\"Generates all pairwise products from two lists.\"\"\"\n        products = []\n        for factor1 in list1:\n            for factor2 in list2:\n                products.append(Product(factor1, factor2).value)\n        return products\n\n    def validate_inputs(self, list1, list2, k) -> None:\n        \"\"\"Delegates to the global validation function.\"\"\"\n        validate_inputs(list1, list2, k)\n\n\ndef large_product(list1, list2, k):\n    \"\"\"Public API that returns a list of numbers sorted descending (top k).\"\"\"\n    return LargeProductFunction().large_product(list1, list2, k)"}
