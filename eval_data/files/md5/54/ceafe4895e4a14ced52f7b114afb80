{"task_id": "Mbpp/84", "solution": "import collections\nfrom typing import Dict, Optional, Callable\n\n# MemoizationCache class as described in the design context.\nclass MemoizationCache:\n    \"\"\"\n    Stores and retrieves computed sequence values to avoid exponential recomputation.\n    Initialized with the base cases a(1)=1 and a(2)=1.\n    \"\"\"\n    def __init__(self) -> None:\n        self.cache: Dict[int, int] = {1: 1, 2: 1}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache if present.\"\"\"\n        return self.cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a computed value in the cache.\"\"\"\n        self.cache[n] = value\n\n# InputValidator class as described in the design context.\nclass InputValidator:\n    \"\"\"Validates if an input `n` is a positive integer (n >= 1).\"\"\"\n    def isPositiveInteger(self, n) -> bool:\n        \"\"\"Checks if `n` is an integer and greater than or equal to 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n# RecurrenceCalculator class as described in the design context.\nclass RecurrenceCalculator:\n    \"\"\"\n    Computes a(n) for n > 2 using the Newman\u2013Conway recurrence.\n    It relies on a resolver function (typically SequenceFunction.compute) for sub-problems.\n    \"\"\"\n    def __init__(self, cache: MemoizationCache) -> None:\n        self._cache = cache\n        self._resolver: Optional[Callable[[int], int]] = None\n\n    def set_resolver(self, resolver: Callable[[int], int]) -> None:\n        \"\"\"Sets the resolver function used for recursive calls.\"\"\"\n        self._resolver = resolver\n\n    def computeRecurrence(self, n: int) -> int:\n        \"\"\"\n        Calculates a(n) for n > 2 using the Newman\u2013Conway recurrence:\n        a(n) = a(a(n-1)) + a(n - a(n-1)).\n        \"\"\"\n        if self._resolver is None:\n            raise RuntimeError(\"Resolver function must be set before computing recurrence.\")\n\n        # Compute sub-values using the resolver (which handles caching and base cases)\n        val_n_minus_1 = self._resolver(n - 1)\n        val_a_n_minus_1 = self._resolver(val_n_minus_1)\n        val_n_minus_a_n_minus_1 = self._resolver(n - val_n_minus_1)\n\n        result = val_a_n_minus_1 + val_n_minus_a_n_minus_1\n        return result\n\n# SequenceFunction class as described in the design context.\nclass SequenceFunction:\n    \"\"\"\n    Orchestrates the computation of the nth Newman\u2013Conway number.\n    It handles input validation, cache lookup, and delegates recurrence calculation.\n    \"\"\"\n    def __init__(self, n: int, cache: MemoizationCache, validator: InputValidator, calculator: RecurrenceCalculator) -> None:\n        self.n = n\n        self._cache = cache\n        self._validator = validator\n        self._calculator = calculator\n        # Set the SequenceFunction's own compute method as the resolver for the calculator\n        self._calculator.set_resolver(self.compute)\n\n    def compute(self) -> int:\n        \"\"\"\n        Computes and returns the nth Newman\u2013Conway number.\n        This method is recursive and uses memoization.\n        \"\"\"\n        # Check cache first for memoization\n        cached_value = self._cache.get(self.n)\n        if cached_value is not None:\n            return cached_value\n        \n        # Base cases (n=1, n=2) are pre-seeded in the cache, so they'll be caught by the above `get`.\n        # For n > 2, delegate to the recurrence calculator.\n        result = self._calculator.computeRecurrence(self.n)\n\n        # Store the newly computed result in the cache\n        self._cache.set(self.n, result)\n        return result\n\n# The public API function to find the nth number in the Newman-Conway sequence.\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman\u2013Conway sequence.\n    a(1) = 1, a(2) = 1, a(n) = a(a(n-1)) + a(n - a(n-1)) for n > 2.\n\n    Args:\n        n: The positive integer index of the desired sequence number (n >= 1).\n\n    Returns:\n        The nth Newman\u2013Conway number.\n\n    Raises:\n        ValueError: If n is not a positive integer (n < 1 or not an integer).\n    \"\"\"\n    # Instantiate all necessary dependencies\n    validator = InputValidator()\n    # MemoizationCache is designed to be instantiated once per top-level `sequence(n)` call,\n    # ensuring memoization across all sub-problems for that specific computation.\n    cache = MemoizationCache()\n    # The calculator is instantiated with the cache; its resolver will be set by SequenceFunction.\n    calculator = RecurrenceCalculator(cache)\n\n    # Validate the initial input `n`\n    if not validator.isPositiveInteger(n):\n        raise ValueError(\"n must be an integer >= 1\")\n\n    # Instantiate and run the SequenceFunction to compute the result\n    sf = SequenceFunction(n, cache, validator, calculator)\n    return sf.compute()"}
{"task_id": "Mbpp/92", "solution": "from typing import List, Set, Optional\nimport datetime\n\nclass Number:\n    \"\"\"\n    Represents an input integer, converting its absolute value to a digit sequence.\n    \"\"\"\n    def __init__(self, value: int, raw_input: Optional[str] = None) -> None:\n        self.value = value\n        self.raw_input = raw_input\n\n    def to_digit_sequence(self) -> 'DigitSequence':\n        \"\"\"Converts the absolute value of the number into a sequence of digits.\"\"\"\n        str_value = str(abs(self.value))\n        digits = [int(d) for d in str_value]\n        return DigitSequence(digits)\n\nclass DigitSequence:\n    \"\"\"\n    Holds an ordered sequence of decimal digits and provides helper methods.\n    \"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self.digits = digits\n        self._length = len(digits)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return self._length\n\n    def distinct_digits(self) -> Set[int]:\n        \"\"\"Returns a set of unique digits in the sequence.\"\"\"\n        return set(self.digits)\n\n    def get(self, i: int) -> int:\n        \"\"\"Returns the digit at the specified index.\"\"\"\n        return self.digits[i]\n\nclass CheckResult:\n    \"\"\"\n    Container for the result of an undulating number check.\n    \"\"\"\n    def __init__(self, number_value: int, is_undulating: bool, checked_at: Optional[datetime.datetime] = None) -> None:\n        self.number_value = number_value\n        self.is_undulating = is_undulating\n        self.checked_at = checked_at if checked_at is not None else datetime.datetime.now()\n\nclass UndulatingChecker:\n    \"\"\"\n    Encapsulates the algorithm to determine if a number's digit sequence is undulating.\n    \"\"\"\n    def is_undulating_from_number(self, number: 'Number') -> bool:\n        \"\"\"Checks if a Number object's digit sequence is undulating.\"\"\"\n        digit_sequence = number.to_digit_sequence()\n        return self.is_undulating_from_digits(digit_sequence.digits)\n\n    def is_undulating_from_digits(self, digits_list: List[int]) -> bool:\n        \"\"\"Checks if a list of digits forms an undulating sequence.\"\"\"\n        ds = DigitSequence(digits_list)\n\n        if ds.length() < 2:\n            return False\n\n        distinct = ds.distinct_digits()\n        if len(distinct) != 2:\n            return False\n\n        digit_A = ds.get(0)\n        digit_B = ds.get(1)\n        \n        # For an undulating number (ABAB...), the first two digits must be different.\n        if digit_A == digit_B:\n            return False\n\n        # Verify the alternating pattern for the entire sequence.\n        for i in range(ds.length()):\n            if i % 2 == 0: # Even indices (0, 2, 4...) should match digit_A.\n                if ds.get(i) != digit_A:\n                    return False\n            else: # Odd indices (1, 3, 5...) should match digit_B.\n                if ds.get(i) != digit_B:\n                    return False\n        return True\n\ndef is_undulating(n) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number's decimal digits alternate between exactly two distinct digits for the entire length (e.g., 1212121).\n    \"\"\"\n    abs_n = abs(n)\n    number_obj = Number(value=abs_n)\n    checker = UndulatingChecker()\n    return checker.is_undulating_from_number(number_obj)"}
{"task_id": "Mbpp/93", "solution": "def _validate_numeric(a: object, b: object) -> None:\n    \"\"\"Raise TypeError if a or b is not an int or float.\"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Both 'a' and 'b' must be numeric types (int or float).\")\n\ndef power(a: int | float, b: int | float) -> float:\n    \"\"\"Compute a raised to the power b. Raises TypeError for non-numeric inputs.\"\"\"\n    _validate_numeric(a, b)\n    return a ** b"}
