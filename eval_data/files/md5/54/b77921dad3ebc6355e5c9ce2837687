{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Set, Tuple, Dict, List, Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    pass\n\ndef is_hashable(item: Any) -> bool:\n    \"\"\"Checks if an item is hashable.\"\"\"\n    try:\n        hash(item)\n        return True\n    except TypeError:\n        return False\n\nclass TuplePair:\n    \"\"\"\n    Represents an unordered 2-element tuple with stable canonical key\n    for equality and hashing, preserving the original tuple.\n    \"\"\"\n    def __init__(self, a: Any, b: Any) -> None:\n        if not (is_hashable(a) and is_hashable(b)):\n            raise ValidationError(f\"Elements must be hashable: {a}, {b}\")\n        self._a = a\n        self._b = b\n        # Determine a canonical key for order-agnostic comparison.\n        try:\n            self._canonical = (a, b) if a <= b else (b, a)\n        except TypeError:\n            # If elements are not directly comparable, use hash values for deterministic ordering.\n            self._canonical = (a, b) if hash(a) <= hash(b) else (b, a)\n\n    def key(self) -> Tuple[Any, Any]:\n        \"\"\"Returns the canonical key for the tuple pair.\"\"\"\n        return self._canonical\n\n    def as_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Returns the original tuple (representative).\"\"\"\n        return (self._a, self._b)\n\n    def __eq__(self, other: Any) -> bool:\n        \"\"\"Compares two TuplePair instances based on their canonical keys.\"\"\"\n        if not isinstance(other, TuplePair):\n            return NotImplemented\n        return self.key() == other.key()\n\n    def __hash__(self) -> int:\n        \"\"\"Hashes the TuplePair based on its canonical key.\"\"\"\n        return hash(self.key())\n\ndef tuple_intersection(list_a: Iterable[Tuple[Any, Any]], list_b: Iterable[Tuple[Any, Any]]) -> Set[Tuple[Any, Any]]:\n    \"\"\"\n    Finds the intersection of elements in two lists of 2-element tuples,\n    irrespective of their order within the tuples.\n    Returns a set of representative tuples (from the first list if available).\n    \"\"\"\n\n    def _normalize_item(raw: Any) -> TuplePair:\n        \"\"\"Validates a raw item and converts it into a TuplePair.\"\"\"\n        try:\n            a, b = raw\n        except (TypeError, ValueError):\n            raise ValidationError(f\"Item is not a 2-element sequence: {raw}\")\n        return TuplePair(a, b)\n\n    def _normalize_iterable(items: Iterable[Any], list_name: str) -> List[TuplePair]:\n        \"\"\"Normalizes an iterable of raw items into a list of TuplePair objects.\"\"\"\n        pairs = []\n        for idx, item in enumerate(items):\n            try:\n                tp = _normalize_item(item)\n            except ValidationError as e:\n                raise ValidationError(f\"Invalid item in {list_name} at index {idx}: {e}\")\n            pairs.append(tp)\n        return pairs\n\n    def _build_map(pairs: List[TuplePair]) -> Dict[Tuple[Any, Any], TuplePair]:\n        \"\"\"\n        Builds a map from canonical key to the first encountered TuplePair\n        for that key in the given list.\n        \"\"\"\n        m: Dict[Tuple[Any, Any], TuplePair] = {}\n        for p in pairs:\n            k = p.key()\n            if k not in m: # Store only the first occurrence for a given canonical key\n                m[k] = p\n        return m\n\n    normalized_a = _normalize_iterable(list_a, \"list_a\")\n    normalized_b = _normalize_iterable(list_b, \"list_b\")\n\n    map_a = _build_map(normalized_a)\n    map_b = _build_map(normalized_b)\n\n    keys_a = set(map_a.keys())\n    keys_b = set(map_b.keys())\n\n    common_keys = keys_a.intersection(keys_b)\n\n    result_set: Set[Tuple[Any, Any]] = set()\n    for k in common_keys:\n        # Prioritize representative from list_a if available, otherwise from list_b.\n        representative_pair = map_a.get(k) or map_b.get(k)\n        if representative_pair:\n            result_set.add(representative_pair.as_tuple())\n\n    return result_set"}
