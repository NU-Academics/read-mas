{"task_id": "Mbpp/12", "solution": "from typing import Iterable, List, Union, Any, Tuple\nimport collections\n\n# Define Number type alias as per design context\nNumber = Union[int, float]\n\n# --- Exceptions (src/matrix_sort/exceptions.py) ---\nclass MatrixError(Exception):\n    \"\"\"Base exception for matrix operations.\"\"\"\n    pass\n\nclass InputValidationError(MatrixError):\n    \"\"\"Exception raised for invalid matrix input.\"\"\"\n    pass\n\n# --- Utilities (src/matrix_sort/utils.py) ---\ndef safe_sum(cells: Iterable[Number]) -> float:\n    \"\"\"Safely sums numeric cells, converting to float.\"\"\"\n    total = 0.0\n    for x in cells:\n        total += float(x)\n    return total\n\ndef to_list_of_lists(matrix: Iterable[Iterable[Number]]) -> List[List[Number]]:\n    \"\"\"Converts a nested iterable into a list of lists.\"\"\"\n    return [list(row) for row in matrix]\n\n# --- Models (src/matrix_sort/models.py) ---\nclass Row:\n    \"\"\"Represents a single row in a matrix.\"\"\"\n    def __init__(self, cells: List[Number], index: int):\n        self.cells = cells\n        self.index = index\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of the cells in the row.\"\"\"\n        return safe_sum(self.cells)\n\nclass Matrix:\n    \"\"\"Represents a 2D matrix as a list of Row objects.\"\"\"\n    def __init__(self, rows: List[Row]):\n        self.rows = rows\n\n    @classmethod\n    def from_nested(cls, iterable: Iterable[Iterable[Number]]) -> 'Matrix':\n        \"\"\"Constructs a Matrix from a nested iterable.\"\"\"\n        lists = to_list_of_lists(iterable)\n        rows = [Row(cells=r, index=i) for i, r in enumerate(lists)]\n        return cls(rows)\n\n    def to_list(self) -> List[List[Number]]:\n        \"\"\"Converts the Matrix back to a list of lists.\"\"\"\n        return [list(r.cells) for r in self.rows]\n\n# --- Validators (src/matrix_sort/validators.py) ---\nclass InputValidator:\n    \"\"\"Validates the structure and content of a matrix input.\"\"\"\n    def validate_matrix(self, matrix: Any) -> None:\n        \"\"\"Ensures the matrix is an iterable of iterables with numeric cells.\"\"\"\n        if matrix is None:\n            raise InputValidationError(\"Matrix cannot be None.\")\n        if not isinstance(matrix, (list, tuple)):\n            raise InputValidationError(\"Matrix must be a list or tuple of rows.\")\n\n        for i, row in enumerate(matrix):\n            if not isinstance(row, (list, tuple, collections.abc.Iterable)): # collections.abc.Iterable for general iterables\n                raise InputValidationError(f\"Row {i} is not iterable.\")\n            \n            for j, cell in enumerate(row):\n                if not isinstance(cell, (int, float)):\n                    raise InputValidationError(f\"Cell at [{i}][{j}] is not numeric: {cell!r}.\")\n\n# --- Factories (src/matrix_sort/factories.py) ---\nclass SortKeyFactory:\n    \"\"\"Generates key functions for sorting operations.\"\"\"\n    def stable_row_sort_key(self, row: Row) -> Tuple[float, int]:\n        \"\"\"Returns a tuple (row_sum, original_index) for stable sorting.\"\"\"\n        return (row.sum(), row.index)\n\n# --- Services (src/matrix_sort/services.py) ---\nclass MatrixService:\n    \"\"\"Provides the core business logic for matrix operations.\"\"\"\n    def __init__(self, validator: InputValidator, sort_key_factory: SortKeyFactory, repository: Optional[Any] = None):\n        self.validator = validator\n        self.sort_key_factory = sort_key_factory\n        self.repository = repository\n\n    def sort_matrix(self, matrix_data: Iterable[Iterable[Number]]) -> List[List[Number]]:\n        \"\"\"Sorts a matrix by the sum of its rows in ascending order.\"\"\"\n        self.validator.validate_matrix(matrix_data)\n        m = Matrix.from_nested(matrix_data)\n        sorted_rows = sorted(m.rows, key=self.sort_key_factory.stable_row_sort_key)\n        sorted_matrix_obj = Matrix(sorted_rows)\n        return sorted_matrix_obj.to_list()\n\n# --- Controllers (src/matrix_sort/controllers.py) ---\nclass MatrixController:\n    \"\"\"Acts as an interface for the MatrixService, handling API calls.\"\"\"\n    def __init__(self, service: MatrixService):\n        self.service = service\n\n    def sort_matrix(self, matrix_data: Iterable[Iterable[Number]]) -> List[List[Number]]:\n        \"\"\"Delegates matrix sorting to the MatrixService.\"\"\"\n        return self.service.sort_matrix(matrix_data)\n\n# --- Public API function (src/matrix_sort/__init__.py) ---\n_default_controller = MatrixController(\n    MatrixService(InputValidator(), SortKeyFactory())\n)\n\ndef sort_matrix(matrix: List[List[Number]]) -> List[List[Number]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Rows with equal sums maintain their original relative order (stable sort).\n    \"\"\"\n    return _default_controller.sort_matrix(matrix)"}
