{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number using trial division up to sqrt(n).\n    Handles negative numbers, 0, 1, 2, and other evens as special cases.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    limit = int(math.isqrt(n))\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/608", "solution": "import datetime\nimport json\nimport os\n\nclass BellError(Exception):\n    pass\n\nclass InvalidInputError(BellError):\n    pass\n\nclass CacheError(BellError):\n    pass\n\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations related to Bell numbers.\"\"\"\n    @staticmethod\n    def validate_non_negative_int(n: int) -> None:\n        \"\"\"Validates if n is a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(f\"n must be non-negative integer, got {n}\")\n\n    @staticmethod\n    def bell_triangle_row(n: int) -> list[int]:\n        \"\"\"Computes Bell numbers up to n using the Bell triangle algorithm.\"\"\"\n        MathUtils.validate_non_negative_int(n)\n        if n == 0:\n            return [1]\n        \n        triangle = [[1]]\n        bells = [1]\n        \n        for i in range(1, n + 1):\n            row = [triangle[i-1][-1]]\n            for j in range(1, i + 1):\n                row.append(row[j-1] + (triangle[i-1][j-1]))\n            triangle.append(row)\n            bells.append(row[0])\n        return bells\n\nclass BellCalculator:\n    \"\"\"Calculates Bell numbers, with in-memory memoization.\"\"\"\n    def __init__(self):\n        self._memo = {}\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Bell number.\"\"\"\n        MathUtils.validate_non_negative_int(n)\n        if n in self._memo:\n            return self._memo[n]\n        \n        seq = MathUtils.bell_triangle_row(n)\n        for i, val in enumerate(seq):\n            self._memo[i] = val\n        return self._memo[n]\n\nclass BellResult:\n    \"\"\"A data model for a computed Bell number result.\"\"\"\n    def __init__(self, n: int, value: int, computed_at: str):\n        self.n = n\n        self.value = value\n        self.computed_at = computed_at\n    \n    def to_dict(self) -> dict:\n        return {\"n\": self.n, \"value\": self.value, \"computed_at\": self.computed_at}\n    \n    @classmethod\n    def from_dict(cls, d: dict):\n        if not all(k in d for k in [\"n\", \"value\", \"computed_at\"]):\n            raise ValueError(\"Dictionary is missing required keys for BellResult.\")\n        return cls(n=d[\"n\"], value=d[\"value\"], computed_at=d[\"computed_at\"])\n\nclass BellRepository:\n    \"\"\"Manages caching of Bell numbers in-memory and optionally to a JSON file.\"\"\"\n    def __init__(self, cache_path: str = \"bell_cache.json\", enabled: bool = True):\n        self.cache_path = cache_path\n        self.enabled = enabled\n        self.cache = {}\n        self.dirty = False # Not strictly used for atomic save, but good to have\n        if self.enabled:\n            self.load()\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a Bell number from the cache.\"\"\"\n        return self.cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Bell number in the cache and persists if enabled.\"\"\"\n        self.cache[n] = value\n        self.dirty = True\n        if self.enabled:\n            self.save()\n\n    def load(self) -> None:\n        \"\"\"Loads the cache from the JSON file.\"\"\"\n        if not os.path.exists(self.cache_path):\n            return\n        try:\n            with open(self.cache_path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n            for k, v in data.items():\n                self.cache[int(k)] = int(v)\n            self.dirty = False\n        except (IOError, json.JSONDecodeError, ValueError) as e:\n            raise CacheError(f\"Error loading cache from {self.cache_path}: {e}\")\n\n    def save(self) -> None:\n        \"\"\"Saves the cache to the JSON file atomically.\"\"\"\n        if not self.dirty:\n            return\n        tmp_path = self.cache_path + \".tmp\"\n        try:\n            with open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump({str(k): v for k, v in self.cache.items()}, f)\n            os.replace(tmp_path, self.cache_path)\n            self.dirty = False\n        except IOError as e:\n            raise CacheError(f\"Error saving cache to {self.cache_path}: {e}\")\n\nclass BellController:\n    \"\"\"Orchestrates Bell number computation, validation, and caching.\"\"\"\n    def __init__(self, calculator: BellCalculator, repository: BellRepository):\n        self.calculator = calculator\n        self.repository = repository\n\n    def get_bell(self, n: int) -> BellResult:\n        \"\"\"Retrieves the nth Bell number, using cache or computing if necessary.\"\"\"\n        MathUtils.validate_non_negative_int(n)\n        \n        cached_value = self.repository.get(n)\n        if cached_value is not None:\n            return BellResult(n=n, value=cached_value, computed_at=\"cached\")\n        \n        computed_value = self.calculator.compute(n)\n        \n        try:\n            self.repository.set(n, computed_value)\n        except CacheError:\n            # Log the error but still return the computed value\n            pass \n            \n        return BellResult(n=n, value=computed_value, computed_at=datetime.datetime.utcnow().isoformat() + \"Z\")\n\nDEFAULT_CACHE_FILE = \"bell_cache.json\"\nDEFAULT_CACHE_ENABLED = True\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Finds the nth Bell number.\n    Uses a controller to manage computation and optional caching.\n    \"\"\"\n    repo = BellRepository(cache_path=DEFAULT_CACHE_FILE, enabled=DEFAULT_CACHE_ENABLED)\n    calc = BellCalculator()\n    controller = BellController(calculator=calc, repository=repo)\n    result = controller.get_bell(n)\n    return result.value"}
{"task_id": "Mbpp/607", "solution": "import re\n\nclass NotFoundError(Exception):\n    \"\"\"Exception raised when no match is found.\"\"\"\n    def __init__(self, message: str = \"No match found\") -> None:\n        super().__init__(message)\n\nclass InvalidPatternError(Exception):\n    \"\"\"Exception raised when a regex pattern is invalid.\"\"\"\n    def __init__(self, message: str = \"Invalid regex pattern\") -> None:\n        super().__init__(message)\n\nclass SearchResult:\n    \"\"\"Data transfer object for search results.\"\"\"\n    def __init__(self, matched: str, start: int, end: int) -> None:\n        if not (0 <= start <= end):\n            raise ValueError(\"Start and end indices must be non-negative, and start <= end.\")\n        self.matched = matched\n        self.start = start\n        self.end = end\n\n    def to_tuple(self) -> tuple[str, int, int]:\n        \"\"\"Converts the search result to a tuple (matched, start, end).\"\"\"\n        return (self.matched, self.start, self.end)\n\ndef validate_inputs(text: str, pattern: str) -> None:\n    \"\"\"Validates input text and pattern for type and non-emptiness.\"\"\"\n    if not isinstance(text, str) or not isinstance(pattern, str):\n        raise TypeError(\"Text and pattern must be strings.\")\n    if not text:\n        raise ValueError(\"Text cannot be empty.\")\n    if not pattern:\n        raise ValueError(\"Pattern cannot be empty.\")\n\ndef safe_compile(pattern: str, flags: int) -> re.Pattern:\n    \"\"\"Compiles a regex pattern, raising InvalidPatternError on failure.\"\"\"\n    try:\n        return re.compile(pattern, flags)\n    except re.error as e:\n        raise InvalidPatternError(f\"Invalid regex pattern: {e}\")\n\nclass RegexEngine:\n    \"\"\"Encapsulates low-level regex compilation and search.\"\"\"\n    DEFAULT_FLAGS: int = 0\n\n    def compile_pattern(self, pattern: str, flags: int) -> re.Pattern:\n        \"\"\"Compiles a regex pattern, raising InvalidPatternError on failure.\"\"\"\n        return safe_compile(pattern, flags)\n\n    def find_first(self, text: str, pattern: str, flags: int = DEFAULT_FLAGS) -> SearchResult:\n        \"\"\"Searches for the first regex match and returns a SearchResult.\"\"\"\n        compiled_pattern = self.compile_pattern(pattern, flags)\n        match = compiled_pattern.search(text)\n        if match:\n            return SearchResult(match.group(0), match.start(), match.end())\n        else:\n            raise NotFoundError()\n\nclass SearchService:\n    \"\"\"Orchestrates search operations and handles input validation.\"\"\"\n    def __init__(self, engine: RegexEngine) -> None:\n        self.engine = engine\n\n    def find_first_regex(self, text: str, pattern: str, flags: int = 0) -> SearchResult:\n        \"\"\"Validates inputs, then uses the engine to find the first regex match.\"\"\"\n        validate_inputs(text, pattern)\n        return self.engine.find_first(text, pattern, flags)\n\nclass APIController:\n    \"\"\"Provides the public API interface and translates results.\"\"\"\n    def __init__(self, service: SearchService) -> None:\n        self.service = service\n\n    def find_literals(self, text: str, pattern: str, flags: int = 0) -> tuple[str, int, int]:\n        \"\"\"Calls the service layer and converts the SearchResult to a tuple.\"\"\"\n        search_result = self.service.find_first_regex(text, pattern, flags)\n        return search_result.to_tuple()\n\ndef find_literals(text: str, pattern: str, flags: int = 0) -> tuple[str, int, int]:\n    \"\"\"Searches a string for a regex pattern and returns the match, start, and end indices.\"\"\"\n    engine = RegexEngine()\n    service = SearchService(engine)\n    controller = APIController(service)\n    return controller.find_literals(text, pattern, flags)"}
{"task_id": "Mbpp/610", "solution": "import collections\nfrom typing import List, TypeVar, Any\n\nT = TypeVar(\"T\")\n\ndef remove_kth_element(data: List[T], k: int) -> List[T]:\n    \"\"\"\n    Returns a new list with the k'th (1-based) element removed.\n    Assumes valid inputs (data is a list, k is a valid 1-based index).\n    \"\"\"\n    idx = k - 1\n    return data[:idx] + data[idx+1:]"}
