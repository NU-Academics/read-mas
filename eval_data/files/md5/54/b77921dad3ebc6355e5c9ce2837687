{"task_id": "Mbpp/391", "solution": "from typing import Any, Dict, List, Iterable, Tuple, Optional\n\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ConversionError(RuntimeError):\n    \"\"\"Custom exception for errors during the conversion process.\"\"\"\n    def __init__(self, message: str, original_exc: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.original_exc = original_exc\n\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n    return hasattr(obj, '__iter__') and not isinstance(obj, (str, bytes))\n\ndef to_list(obj: Iterable[Any]) -> List[Any]:\n    \"\"\"Converts an iterable to a list, returning the original reference if already a list.\"\"\"\n    if isinstance(obj, list):\n        return obj\n    return list(obj)\n\ndef to_hashable(obj: Any) -> Any:\n    \"\"\"Returns the object if hashable, otherwise its string representation for use as a dict key.\"\"\"\n    try:\n        hash(obj)\n        return obj\n    except TypeError:\n        return str(obj)\n\nclass ConversionResult:\n    \"\"\"Represents a single converted record with outer key, inner key, and value.\"\"\"\n    def __init__(self, outer_key: Any, inner_key: Any, value: Any) -> None:\n        self.outer_key = outer_key\n        self.inner_key = inner_key\n        self.value = value\n\n    def to_dict(self) -> Dict[Any, Any]:\n        \"\"\"Returns the nested dictionary representation for this record.\"\"\"\n        return {to_hashable(self.outer_key): {to_hashable(self.inner_key): self.value}}\n\nclass InputLists:\n    \"\"\"Container for validated input lists, providing length and indexed access.\"\"\"\n    def __init__(self, lists: List[List[Any]]) -> None:\n        self._lists = lists\n        self.length = len(lists[0]) if lists else 0\n\n    def get(self, idx: int) -> List[Any]:\n        \"\"\"Returns the list at the specified index.\"\"\"\n        return self._lists[idx]\n\n    def __len__(self) -> int:\n        return self.length\n\nclass InputValidator:\n    \"\"\"Validates input lists against business rules.\"\"\"\n    MIN_LISTS: int = 2\n\n    def validate(self, lists: Tuple[Iterable[Any], ...]) -> List[List[Any]]:\n        \"\"\"Ensures input is valid: sufficient count, iterability, non-empty, and equal length.\"\"\"\n        if not lists or len(lists) < self.MIN_LISTS:\n            raise ValidationError(\n                f\"At least {self.MIN_LISTS} lists are required for conversion.\"\n            )\n\n        validated_lists: List[List[Any]] = []\n        first_list_len: Optional[int] = None\n\n        for i, lst in enumerate(lists):\n            if not is_iterable(lst):\n                raise ValidationError(f\"Input argument at position {i+1} is not an iterable.\")\n\n            current_list = to_list(lst)\n            if not current_list:\n                raise ValidationError(f\"Input list at position {i+1} is empty.\")\n\n            current_len = len(current_list)\n            if first_list_len is None:\n                first_list_len = current_len\n            elif current_len != first_list_len:\n                raise ValidationError(\"All input lists must have the same length.\")\n            \n            validated_lists.append(current_list)\n\n        return validated_lists\n\nclass ConverterService:\n    \"\"\"Core logic for converting validated lists into nested dictionaries.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def convert(self, *lists: Iterable[Any]) -> List[Dict[Any, Any]]:\n        \"\"\"Performs the conversion after validating inputs.\"\"\"\n        try:\n            validated_lists_of_lists = self._validator.validate(lists)\n            \n            results: List[Dict[Any, Any]] = []\n            num_records = len(validated_lists_of_lists[0])\n\n            for i in range(num_records):\n                record_dict = self._build_record(i, validated_lists_of_lists)\n                results.append(record_dict)\n            return results\n        except ValidationError:\n            raise\n        except Exception as e:\n            raise ConversionError(f\"An unexpected error occurred during conversion: {e}\", original_exc=e)\n\n    def _build_record(self, index: int, lists: List[List[Any]]) -> Dict[Any, Any]:\n        \"\"\"Constructs a single nested dictionary entry for a given index.\"\"\"\n        outer_key_raw = lists[0][index]\n        inner_key_raw = lists[1][index]\n\n        value_lists = lists[2:]\n        value: Any = None\n        if not value_lists:\n            value = None\n        elif len(value_lists) == 1:\n            value = value_lists[0][index]\n        else:\n            value = tuple(vl[index] for vl in value_lists)\n        \n        conversion_result = ConversionResult(outer_key_raw, inner_key_raw, value)\n        return conversion_result.to_dict()\n\nclass ConverterController:\n    \"\"\"A thin API layer that adapts user calls to the service.\"\"\"\n    def __init__(self, service: ConverterService) -> None:\n        self._service = service\n\n    def convert_list_dictionary(self, *lists: Iterable[Any]) -> List[Dict[Any, Any]]:\n        \"\"\"Delegates the conversion request to the underlying service.\"\"\"\n        return self._service.convert(*lists)\n\ndef convert_list_dictionary(*lists: Iterable[Any]) -> List[Dict[Any, Any]]:\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries.\n    The first list provides outer keys, the second provides inner keys, and subsequent lists provide values.\n    \"\"\"\n    validator = InputValidator()\n    service = ConverterService(validator)\n    controller = ConverterController(service)\n    \n    return controller.convert_list_dictionary(*lists)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first character in the string that appears exactly once.\n    It performs two passes: one to count character frequencies, and one to find the first unique character.\n    \"\"\"\n    char_counts = {}\n    for char in s:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n):\n    \"\"\"\n    Computes the maximum sum for n using the recurrence f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n),\n    with memoization to optimize performance. Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    if n in _memo:\n        return _memo[n]\n\n    sum_of_parts = get_max_sum(n // 2) + \\\n                   get_max_sum(n // 3) + \\\n                   get_max_sum(n // 4) + \\\n                   get_max_sum(n // 5)\n\n    result = max(n, sum_of_parts)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/394", "solution": "from typing import Any, Tuple\n\ndef check_distinct(input_tuple: Tuple[Any, ...]) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    It uses a hashset for hashable elements (O(n) average) or a pairwise comparison (O(n^2)) for unhashable elements.\n    \"\"\"\n    def _is_hashable(obj: Any) -> bool:\n        \"\"\"Determines if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    def _hashset_check(items: Tuple[Any, ...]) -> bool:\n        \"\"\"Efficiently checks for duplicates using a hash set.\"\"\"\n        seen = set()\n        for item in items:\n            if item in seen:\n                return False\n            seen.add(item)\n        return True\n\n    def _fallback_comparison_check(items: Tuple[Any, ...]) -> bool:\n        \"\"\"Checks for duplicates using pairwise comparison, suitable for unhashable items.\"\"\"\n        n = len(items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    return False\n        return True\n\n    if all(_is_hashable(x) for x in input_tuple):\n        return _hashset_check(input_tuple)\n    else:\n        return _fallback_comparison_check(input_tuple)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list) -> int:\n    \"\"\"\n    Computes the sum of digits of each number in a given list, using the absolute value of each number.\n    \"\"\"\n    total_digit_sum = 0\n    for num_item in numbers:\n        # Convert each item to an integer, handling potential string representations.\n        current_num = abs(int(num_item))\n        \n        # Sum the digits of the current number.\n        while current_num > 0:\n            total_digit_sum += current_num % 10\n            current_num //= 10\n            \n    return total_digit_sum"}
{"task_id": "Mbpp/404", "solution": "import math\n\nclass NumberPair:\n    def __init__(self, a: float | int, b: float | int) -> None:\n        self.a = a\n        self.b = b\n\n    def as_tuple(self) -> tuple[float|int, float|int]:\n        return (self.a, self.b)\n\nclass MinimumError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass NumberValidator:\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, a: any, b: any) -> NumberPair:\n        a_num = self._to_number(a)\n        b_num = self._to_number(b)\n        if any(map(lambda x: isinstance(x, float) and math.isnan(x), (a_num, b_num))):\n            raise MinimumError(\"NaN is not allowed\")\n        return NumberPair(a_num, b_num)\n\n    def _to_number(self, x: any) -> float|int:\n        if isinstance(x, (int, float)):\n            return x\n        if isinstance(x, str):\n            try:\n                if '.' in x:\n                    return float(x)\n                return int(x)\n            except ValueError:\n                raise MinimumError(f\"Invalid numeric string value: {x}\")\n        raise MinimumError(f\"Invalid numeric value: {x}\")\n\nclass MinService:\n    def __init__(self, validator: NumberValidator) -> None:\n        self.validator = validator\n\n    def min(self, a: any, b: any) -> float|int:\n        pair = self.validator.validate(a, b)\n        return self._compute_min(pair.a, pair.b)\n\n    def _compute_min(self, a: float|int, b: float|int) -> float|int:\n        # Returns the smaller of the two numbers. If equal, returns the first argument to preserve its type.\n        return a if a <= b else b\n\n_validator = NumberValidator()\n_service = MinService(_validator)\n\ndef minimum(a: float | int, b: float | int) -> float | int:\n    \"\"\"\n    Finds the minimum of two numbers, converting inputs to numbers if necessary.\n    Raises MinimumError for invalid or NaN inputs.\n    \"\"\"\n    return _service.min(a, b)"}
