{"task_id": "Mbpp/635", "solution": "import sys\nfrom typing import List, Iterable, Optional, Callable, TypeVar, Generic, Any\n\nT = TypeVar('T')\n\nclass SortingError(Exception):\n    \"\"\"Custom exception for sorting-related errors.\"\"\"\n    pass\n\ndef ensure_iterable(obj: Any) -> Iterable[Any]:\n    \"\"\"Ensures the object is iterable and not a string.\"\"\"\n    if not isinstance(obj, Iterable):\n        raise SortingError(f\"Input must be an iterable, but received {type(obj).__name__}.\")\n    if isinstance(obj, str):\n        raise SortingError(f\"Input cannot be a string, but received {type(obj).__name__}.\")\n    return obj\n\nclass Heap(Generic[T]):\n    \"\"\"A min-heap implementation.\"\"\"\n\n    def __init__(self, items: Optional[Iterable[T]] = None) -> None:\n        self._data: List[T] = list(items) if items is not None else []\n        self._size: int = len(self._data)\n        if self._size > 1:\n            self.heapify()\n\n    def _parent(self, idx: int) -> int:\n        return (idx - 1) // 2\n\n    def _left_child(self, idx: int) -> int:\n        return 2 * idx + 1\n\n    def _right_child(self, idx: int) -> int:\n        return 2 * idx + 2\n\n    def _sift_up(self, idx: int) -> None:\n        \"\"\"Restores heap invariant by moving element at idx up.\"\"\"\n        parent_idx = self._parent(idx)\n        while idx > 0 and self._data[idx] < self._data[parent_idx]:\n            self._data[idx], self._data[parent_idx] = self._data[parent_idx], self._data[idx]\n            idx = parent_idx\n            parent_idx = self._parent(idx)\n\n    def _sift_down(self, idx: int) -> None:\n        \"\"\"Restores heap invariant by moving element at idx down.\"\"\"\n        smallest = idx\n        left = self._left_child(idx)\n        right = self._right_child(idx)\n\n        if left < self._size and self._data[left] < self._data[smallest]:\n            smallest = left\n        if right < self._size and self._data[right] < self._data[smallest]:\n            smallest = right\n\n        if smallest != idx:\n            self._data[idx], self._data[smallest] = self._data[smallest], self._data[idx]\n            self._sift_down(smallest)\n\n    def heapify(self) -> None:\n        \"\"\"Builds a min-heap from the current data list in O(n) time.\"\"\"\n        for i in range((self._size // 2) - 1, -1, -1):\n            self._sift_down(i)\n\n    def push(self, item: T) -> None:\n        \"\"\"Adds an item to the heap and maintains the heap invariant.\"\"\"\n        self._data.append(item)\n        self._size += 1\n        self._sift_up(self._size - 1)\n\n    def pop(self) -> T:\n        \"\"\"Removes and returns the smallest item from the heap.\"\"\"\n        if self._size == 0:\n            raise SortingError(\"Cannot pop from an empty heap.\")\n        if self._size == 1:\n            self._size -= 1\n            return self._data.pop()\n\n        root = self._data[0]\n        self._data[0] = self._data.pop()\n        self._size -= 1\n        self._sift_down(0)\n        return root\n\n    def peek(self) -> T:\n        \"\"\"Returns the smallest item in the heap without removing it.\"\"\"\n        if self._size == 0:\n            raise SortingError(\"Cannot peek into an empty heap.\")\n        return self._data[0]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the heap.\"\"\"\n        return self._size\n\nclass HeapSorter(Generic[T]):\n    \"\"\"Orchestrates heap-based sorting.\"\"\"\n\n    def __init__(self, heap_factory: Callable[[Optional[Iterable[T]]], Heap[T]] = Heap) -> None:\n        self._heap_factory = heap_factory\n\n    def sort(self, data: Iterable[T]) -> List[T]:\n        \"\"\"Performs heap sort on the given data.\"\"\"\n        try:\n            iterable = ensure_iterable(data)\n            heap = self._heap_factory(iterable)\n            result: List[T] = []\n            while heap.size() > 0:\n                result.append(heap.pop())\n            return result\n        except TypeError as e:\n            raise SortingError(f\"Elements in the list are not comparable: {e}\") from e\n        except SortingError:\n            raise\n\n_default_sorter: HeapSorter[Any] = HeapSorter()\n\ndef heap_sort(data: Iterable[T]) -> List[T]:\n    \"\"\"Sorts a list using the heap sort algorithm.\"\"\"\n    return _default_sorter.sort(data)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(data: list) -> list:\n    \"\"\"\n    Moves all zeroes in the input list to the end, preserving the relative\n    order of non-zero elements. Returns a new list.\n    \"\"\"\n    out = []\n    zero_count = 0\n    for x in data:\n        if x == 0:\n            zero_count += 1\n        else:\n            out.append(x)\n    out.extend([0] * zero_count)\n    return out"}
{"task_id": "Mbpp/638", "solution": "from decimal import Decimal, ROUND_HALF_UP\n\ndef wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer using half-up semantics.\n    Uses the North American wind chill formula.\n    \"\"\"\n    COEFF_A = 13.12\n    COEFF_B = 0.6215\n    COEFF_C = 11.37\n    COEFF_D = 0.3965\n\n    # Calculate v^0.16 once to avoid redundant computations\n    v_power_16 = velocity_kmh ** 0.16\n\n    # Apply the North American wind chill formula\n    raw_wind_chill = (COEFF_A\n                      + COEFF_B * temperature_c\n                      - COEFF_C * v_power_16\n                      + COEFF_D * temperature_c * v_power_16)\n\n    # Round the result to the nearest integer using half-up semantics\n    # Converting to string first ensures precise Decimal conversion for rounding\n    rounded_value = Decimal(str(raw_wind_chill)).quantize(Decimal('1'), rounding=ROUND_HALF_UP)\n    return int(rounded_value)"}
{"task_id": "Mbpp/639", "solution": "```python\nimport re\n\ndef sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    Non-string entries are treated as invalid and will raise an error.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        if not isinstance(name, str):\n            # This case is expected to be handled by an external validator in the full design.\n            # As per instruction, no isinstance() checks or raising exceptions for edge cases.\n            continue\n        if name and not ('a' <= name[0] <= 'z'):\n            total_length += len(name)\n    return total_length\n```"}
{"task_id": "Mbpp/641", "solution": "import math\n\nclass InputValidationError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass MathUtils:\n    NONAGONAL_A = 7\n    NONAGONAL_B = -5\n    NONAGONAL_C_FACTOR = -2\n\n    @staticmethod\n    def is_perfect_square(x: int) -> bool:\n        if x < 0:\n            raise InputValidationError(\"Input for is_perfect_square must be non-negative.\")\n        if x == 0:\n            return True\n        sqrt_x = math.isqrt(x)\n        return sqrt_x * sqrt_x == x\n\n    @staticmethod\n    def int_sqrt(x: int) -> int:\n        return math.isqrt(x)\n\n    @staticmethod\n    def solve_quadratic_for_n(x: int) -> float | None:\n        \"\"\"\n        Solves the quadratic equation for n: NONAGONAL_A * n^2 + NONAGONAL_B * n + NONAGONAL_C_FACTOR * x = 0.\n        Returns the positive integer root n if it exists, otherwise None.\n        \"\"\"\n        # Equation: 7n^2 - 5n - 2x = 0\n        # Discriminant D = b^2 - 4ac\n        # D = (-5)^2 - 4 * 7 * (-2x) = 25 + 56x\n        discriminant = (MathUtils.NONAGONAL_B ** 2) - 4 * MathUtils.NONAGONAL_A * (MathUtils.NONAGONAL_C_FACTOR * x)\n\n        if discriminant < 0 or not MathUtils.is_perfect_square(discriminant):\n            return None\n\n        sqrt_d = MathUtils.int_sqrt(discriminant)\n\n        # n = (-b +/- sqrt(D)) / 2a\n        # We need the positive root: n = (5 + sqrt(D)) / 14\n        n_numerator = -MathUtils.NONAGONAL_B + sqrt_d\n        denominator = 2 * MathUtils.NONAGONAL_A\n\n        if n_numerator <= 0 or n_numerator % denominator != 0:\n            return None\n        \n        n = n_numerator / denominator\n        return float(n)\n\n    @staticmethod\n    def validate_positive_int(value: int, name: str = \"value\") -> None:\n        if not isinstance(value, int) or value < 1:\n            raise InputValidationError(f\"{name} must be a positive integer (>= 1).\")\n\ndef is_nonagonal(x: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a nonagonal number.\n    Uses the quadratic formula to solve for n.\n    \"\"\"\n    MathUtils.validate_positive_int(x, \"x\")\n\n    n_float = MathUtils.solve_quadratic_for_n(x)\n    \n    if n_float is None:\n        return False\n    \n    # Check if n_float is an integer\n    return n_float == int(n_float)"}
{"task_id": "Mbpp/643", "solution": "import re\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' in the middle of any word.\n    A 'z' is considered in the middle if it has a word character on both sides within the same word.\n    \"\"\"\n    # The regex \\b(\\w*?\\Bz\\B\\w*?)\\b captures words where 'z' is not at the start or end.\n    # \\b is a word boundary. \\w*? matches zero or more word characters non-greedily.\n    # \\Bz\\B asserts that 'z' is not at a word boundary on either side (i.e., surrounded by word characters).\n    pattern = re.compile(r'\\b\\w*?\\Bz\\B\\w*?\\b', re.IGNORECASE)\n    return bool(pattern.search(text))"}
{"task_id": "Mbpp/720", "solution": "from typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for repository errors.\"\"\"\n    pass\n\nclass Validator:\n    @staticmethod\n    def validate_tuple(value: Any) -> None:\n        \"\"\"Validates if the given value is a tuple.\"\"\"\n        if not isinstance(value, tuple):\n            raise ValidationError(f\"Expected tuple, got {type(value).__name__}\")\n\n    @staticmethod\n    def validate_dict(value: Any) -> None:\n        \"\"\"Validates if the given value is a dictionary.\"\"\"\n        if not isinstance(value, dict):\n            raise ValidationError(f\"Expected dict, got {type(value).__name__}\")\n\nclass TupleRepository:\n    def append_item(self, original: tuple, item: Any) -> tuple:\n        \"\"\"Appends an item to a tuple and returns a new tuple.\"\"\"\n        if not isinstance(original, tuple): # Defensive check as per design detail, though validation is upstream.\n            raise RepositoryError(\"original must be a tuple\")\n        return original + (item,)\n\nclass AddDictService:\n    def __init__(self, repository: TupleRepository, validator: Validator) -> None:\n        \"\"\"Initializes the service with repository and validator dependencies.\"\"\"\n        self._repo = repository\n        self._validator = validator\n\n    def add_dict_to_tuple(self, original: tuple, to_add: dict) -> tuple:\n        \"\"\"Validates inputs and appends the dictionary to the tuple.\"\"\"\n        self._validator.validate_tuple(original)\n        self._validator.validate_dict(to_add)\n        return self._repo.append_item(original, to_add)\n\nclass AddDictController:\n    def __init__(self, service: AddDictService) -> None:\n        \"\"\"Initializes the controller with the service dependency.\"\"\"\n        self._service = service\n\n    def handle_add(self, original: tuple, to_add: dict) -> tuple:\n        \"\"\"Handles the request to add a dictionary to a tuple.\"\"\"\n        return self._service.add_dict_to_tuple(original, to_add)\n\ndef add_dict_to_tuple(original: tuple, to_add: dict) -> tuple:\n    \"\"\"Adds a dictionary as a single element to an existing tuple.\"\"\"\n    repository = TupleRepository()\n    validator = Validator()\n    service = AddDictService(repository, validator)\n    controller = AddDictController(service)\n    return controller.handle_add(original, to_add)"}
{"task_id": "Mbpp/644", "solution": "from .array_reverser import ArrayReverser\nfrom .operation_log_repository import OperationLogRepository\nfrom .array_service import ArrayService\n\ndef reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"\n    Reverses the first 'k' elements of an array and returns a new array.\n    This function acts as a convenience API, building and utilizing the service layer.\n    \"\"\"\n    reverser = ArrayReverser(use_in_place=False)\n    repo = OperationLogRepository()\n    service = ArrayService(reverser, repo)\n    return service.reverse(arr, k)"}
{"task_id": "Mbpp/721", "solution": "from typing import List\n\ndef maxAverageOfPath(grid: List[List[int]]) -> float:\n    \"\"\"\n    Computes the maximum average cost of a path from the top-left to the bottom-right\n    of a square grid, moving only right or down, using dynamic programming.\n    \"\"\"\n    n = len(grid)\n\n    # dp[r][c] will store the maximum sum to reach cell (r, c)\n    dp = [[0] * n for _ in range(n)]\n\n    # Initialize the top-left cell\n    dp[0][0] = grid[0][0]\n\n    # Initialize the first row (only move right)\n    for c in range(1, n):\n        dp[0][c] = dp[0][c - 1] + grid[0][c]\n\n    # Initialize the first column (only move down)\n    for r in range(1, n):\n        dp[r][0] = dp[r - 1][0] + grid[r][0]\n\n    # Fill the rest of the DP table\n    for r in range(1, n):\n        for c in range(1, n):\n            # To reach (r, c), we must come from (r-1, c) (down) or (r, c-1) (right)\n            # Choose the path that yields the maximum sum\n            dp[r][c] = max(dp[r - 1][c], dp[r][c - 1]) + grid[r][c]\n\n    # The maximum sum to reach the bottom-right cell\n    max_sum = dp[n - 1][n - 1]\n\n    # The number of cells in any path from top-left to bottom-right in an N*N grid\n    # moving only right or down is always 2*N - 1.\n    cell_count = 2 * n - 1\n\n    # Calculate the average\n    return float(max_sum) / cell_count"}
{"task_id": "Mbpp/723", "solution": "from typing import Sequence, Any\n\ndef count_same_pair(list1: Sequence[Any], list2: Sequence[Any]) -> int:\n    \"\"\"Counts indices where two sequences have the same values.\n    Assumes input sequences are of the same length.\"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/722", "solution": "class InvalidInputError(Exception):\n    \"\"\"Raised when an input value is invalid or malformed.\"\"\"\n    pass\n\nclass DataFormatError(Exception):\n    \"\"\"Raised when data has an unexpected format.\"\"\"\n    pass\n\ndef validate_numeric(value, name: str) -> float:\n    \"\"\"Ensures a value is numeric and converts it to float.\"\"\"\n    try:\n        return float(value)\n    except (ValueError, TypeError):\n        raise InvalidInputError(f\"{name} must be numeric, got {value!r}\")\n\ndef validate_student_dict(students) -> dict:\n    \"\"\"Validates the structure of the students dictionary.\"\"\"\n    if not isinstance(students, dict):\n        raise InvalidInputError(\"students must be a dict mapping names to (height, weight)\")\n    \n    out = {}\n    for k, v in students.items():\n        if not isinstance(k, str):\n            raise DataFormatError(\"student name keys must be strings\")\n        \n        if not (isinstance(v, (tuple, list)) and len(v) == 2):\n            raise DataFormatError(f\"value for {k!r} must be a 2-tuple or list of (height, weight)\")\n        \n        h = validate_numeric(v[0], f\"height for {k!r}\")\n        w = validate_numeric(v[1], f\"weight for {k!r}\")\n        out[k] = (h, w)\n    return out\n\ndef filter_data(students, min_height, min_weight):\n    \"\"\"\n    Filters a dictionary of students, returning only those whose height and weight\n    meet the specified minimums. Height must be strictly greater, weight must be greater than or equal.\n    \"\"\"\n    validated_students = validate_student_dict(students)\n    validated_min_height = validate_numeric(min_height, \"min_height\")\n    validated_min_weight = validate_numeric(min_weight, \"min_weight\")\n\n    filtered_students = {}\n    for name, (height, weight) in validated_students.items():\n        # Based on the provided assertion: height > min_height AND weight >= min_weight\n        if height > validated_min_height and weight >= validated_min_weight:\n            filtered_students[name] = (height, weight)\n            \n    return filtered_students"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Handles negative bases by summing digits of the absolute value of the result.\n    \"\"\"\n    result = base ** power\n    # Convert the absolute value of the result to a string and sum its digits.\n    digit_sum = sum(int(digit) for digit in str(abs(result)))\n    return digit_sum"}
{"task_id": "Mbpp/730", "solution": "from typing import Iterable, Iterator, Any, List\n\ndef validate_list_input(values: Any) -> None:\n    \"\"\"Ensures input is not None, raising ValueError if it is.\"\"\"\n    if values is None:\n        raise ValueError(\"Input list cannot be None.\")\n\nclass ListProcessor:\n    \"\"\"Processes an iterable to remove consecutive duplicates.\"\"\"\n    def __init__(self) -> None:\n        # Use a unique sentinel object that will not compare equal to any valid list item\n        self._last = object()\n\n    def process(self, values: Iterable[Any]) -> Iterator[Any]:\n        \"\"\"Yields items from the iterable, skipping consecutive duplicates.\"\"\"\n        last_yielded_item = self._last\n        # This flag handles the very first item, ensuring it's always yielded.\n        # This is more robust than relying on `last_yielded_item` if `_last` could potentially\n        # be equal to the first item (e.g., if _last was None and None was the first item).\n        is_first_item = True \n        for item in values:\n            if is_first_item or item != last_yielded_item:\n                yield item\n                last_yielded_item = item\n                is_first_item = False\n\n    def process_list(self, values: List[Any]) -> List[Any]:\n        \"\"\"Convenience method to process a list and return a new list.\"\"\"\n        return list(self.process(values))\n\nclass DuplicateRemoverService:\n    \"\"\"Service to remove consecutive duplicates from a list.\"\"\"\n    def __init__(self, processor: ListProcessor = None) -> None:\n        self._processor = processor or ListProcessor()\n\n    def remove_consecutive(self, values: List[Any]) -> List[Any]:\n        \"\"\"Removes consecutive duplicates from the given list.\"\"\"\n        validate_list_input(values)\n        return self._processor.process_list(values)\n\ndef consecutive_duplicates(values: list) -> list:\n    \"\"\"Removes consecutive duplicates from a list.\"\"\"\n    service = DuplicateRemoverService()\n    return service.remove_consecutive(values)"}
