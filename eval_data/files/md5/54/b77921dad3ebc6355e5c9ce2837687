{"task_id": "Mbpp/445", "solution": "from typing import Tuple\n\nclass IndexMultiplicationError(Exception):\n    \"\"\"Custom exception for index multiplication errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nTupleOfTuples = Tuple[Tuple[int, ...], ...]\n\nclass TupleValidator:\n    \"\"\"Validates inputs for the index-wise multiplication operation.\"\"\"\n    def validate(self, a: TupleOfTuples, b: TupleOfTuples) -> bool:\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise IndexMultiplicationError(\"Both inputs must be tuples.\")\n        if len(a) != len(b):\n            raise IndexMultiplicationError(\"Outer tuple lengths differ.\")\n        for i, (ia, ib) in enumerate(zip(a, b)):\n            if not isinstance(ia, tuple) or not isinstance(ib, tuple):\n                raise IndexMultiplicationError(f\"Inner element at index {i} must be a tuple.\")\n            if len(ia) != len(ib):\n                raise IndexMultiplicationError(f\"Inner tuple lengths differ at index {i}.\")\n            for j, (x, y) in enumerate(zip(ia, ib)):\n                if not isinstance(x, int) or not isinstance(y, int):\n                    raise IndexMultiplicationError(f\"Non-int element at outer {i} inner {j}.\")\n        return True\n\nclass IndexMultiplier:\n    \"\"\"Performs index-wise multiplication of tuple elements.\"\"\"\n    def __init__(self, validator: TupleValidator | None = None) -> None:\n        self._validator = validator or TupleValidator()\n\n    def index_multiplication(self, a: TupleOfTuples, b: TupleOfTuples) -> TupleOfTuples:\n        \"\"\"\n        Validates inputs and computes the index-wise multiplication of two nested tuples.\n        Returns a new tuple of tuples with the multiplied elements.\n        \"\"\"\n        self._validator.validate(a, b)\n        result = tuple(self._multiply_inner(ia, ib) for ia, ib in zip(a, b))\n        return result\n\n    def _multiply_inner(self, ia: Tuple[int, ...], ib: Tuple[int, ...]) -> Tuple[int, ...]:\n        \"\"\"Multiplies corresponding elements of two inner tuples.\"\"\"\n        if len(ia) != len(ib):\n            raise IndexMultiplicationError(\"Inner tuple lengths differ defensively.\")\n        return tuple(x * y for x, y in zip(ia, ib))\n\ndef index_multiplication(a: TupleOfTuples, b: TupleOfTuples) -> TupleOfTuples:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    It multiplies corresponding elements of inner tuples at each index.\n    \"\"\"\n    return IndexMultiplier().index_multiplication(a, b)"}
{"task_id": "Mbpp/439", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass IntegerList:\n    \"\"\"DTO for a list of integers with an 'allow_negative' flag.\"\"\"\n    def __init__(self, items: list[int], allow_negative: bool = False) -> None:\n        self.items: list[int] = items\n        self.allow_negative: bool = allow_negative\n\n    def __repr__(self) -> str:\n        return f\"IntegerList(items={self.items}, allow_negative={self.allow_negative})\"\n\ndef safe_int_to_str(value: int) -> str:\n    \"\"\"Converts an integer to its string representation.\"\"\"\n    return str(value)\n\ndef concat_integers_to_str(items: list[int]) -> str:\n    \"\"\"Concatenates string representations of integers in a list.\"\"\"\n    return ''.join(safe_int_to_str(v) for v in items)\n\nDEFAULT_ALLOW_NEGATIVE = False\n\nclass InputValidator:\n    \"\"\"(Simplified) Validator for input integer lists.\"\"\"\n    @staticmethod\n    def validate(items: list[any], allow_negative: bool = DEFAULT_ALLOW_NEGATIVE) -> IntegerList:\n        # Validation checks (isinstance, empty list, negative numbers) are omitted here\n        # to comply with the instruction \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n        return IntegerList(items, allow_negative)\n\nclass MultipleToSingleService:\n    \"\"\"Service to join a list of integers into a single integer.\"\"\"\n    def multiple_to_single(self, items: list[int]) -> int:\n        s = concat_integers_to_str(items)\n        return int(s)\n\n    def multiple_to_single_from_dto(self, dto: IntegerList) -> int:\n        return self.multiple_to_single(dto.items)\n\ndef multiple_to_single(nums):\n    \"\"\"Joins a list of integers into a single integer by concatenation.\"\"\"\n    # The 'nums' parameter corresponds to 'items' in the design context.\n    # The 'allow_negative' parameter is not present in the stub, so the default is used.\n    dto = InputValidator.validate(nums, allow_negative=DEFAULT_ALLOW_NEGATIVE)\n    return MultipleToSingleService().multiple_to_single_from_dto(dto)"}
{"task_id": "Mbpp/446", "solution": "from collections import Counter\n\ndef count_Occurrence(tuple_obj, items):\n    \"\"\"\n    Counts the total occurrences of elements from a list within a tuple.\n    Assumes case-sensitive matching for string elements.\n    \"\"\"\n    tuple_freq = Counter(tuple_obj)\n    total_occurrence_count = 0\n    \n    unique_items_to_count = set(items)\n\n    for item in unique_items_to_count:\n        total_occurrence_count += tuple_freq.get(item, 0)\n\n    return total_occurrence_count"}
