{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import Any, List\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    @staticmethod\n    def validate_values(values: Any) -> List[int]:\n        if values is None:\n            raise InvalidInputError(\"values must be an iterable of integers\")\n        try:\n            lst = list(values)\n        except TypeError:\n            raise InvalidInputError(\"values must be iterable\")\n        for i, v in enumerate(lst):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"element at index {i} is not int: {v!r}\")\n        return lst\n\n    @staticmethod\n    def validate_n(n: Any) -> int:\n        if isinstance(n, bool):\n            raise InvalidInputError(\"n must be an integer, not bool\")\n        try:\n            ni = int(n)\n        except (ValueError, TypeError):\n            raise InvalidInputError(\"n must be an integer\")\n        if ni < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        return ni\n\nclass HeapQueueService:\n    def get_n_largest(self, values: List[int], n: int) -> List[int]:\n        \"\"\"\n        Finds the n largest integers from a list after validating inputs.\n        \"\"\"\n        valid_values = InputValidator.validate_values(values)\n        valid_n = InputValidator.validate_n(n)\n        if valid_n == 0:\n            return []\n        return self._compute_with_heap(valid_values, valid_n)\n\n    def _compute_with_heap(self, values: List[int], n: int) -> List[int]:\n        \"\"\"\n        Computes the n largest integers using a heap, then sorts them descending.\n        \"\"\"\n        result = heapq.nlargest(n, values)\n        result.sort(reverse=True)\n        return result\n\ndef heap_queue_largest(values: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n    service = HeapQueueService()\n    return service.get_n_largest(values, n)"}
{"task_id": "Mbpp/7", "solution": "import re\nimport string\nfrom typing import List\n\ndef find_char_long(text: str) -> List[str]:\n    min_length = 4\n\n    # Regular expression to find tokens (alphanumeric, apostrophes, hyphens)\n    TOKEN_PATTERN = r\"\\b[\\w'-]+\\b\"\n    \n    # Extract raw tokens using the pattern\n    matches = re.finditer(TOKEN_PATTERN, text, flags=re.UNICODE)\n    raw_tokens = [m.group(0) for m in matches]\n    \n    # Process tokens, splitting on hyphens if present\n    tokens = []\n    for t in raw_tokens:\n        if \"-\" in t:\n            tokens.extend([p for p in t.split(\"-\") if p])\n        else:\n            tokens.append(t)\n\n    # Helper function to strip surrounding punctuation for length evaluation\n    def _strip_outer_punctuation(token: str) -> str:\n        return token.strip(string.punctuation)\n\n    filtered_words = []\n    for token in tokens:\n        # Get the token form used for length evaluation (trimmed of surrounding punctuation)\n        token_for_length_check = _strip_outer_punctuation(token)\n\n        if len(token_for_length_check) >= min_length:\n            # Add the original token to the results list\n            filtered_words.append(token)\n            \n    return filtered_words"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Any, Pattern\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input during validation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\ndef normalize_input(text: Any) -> str:\n    \"\"\"Converts input to string, raising ValidationError if conversion fails.\"\"\"\n    if isinstance(text, str):\n        return text\n    try:\n        return str(text)\n    except Exception as e:\n        raise ValidationError(\"unable to convert input to string\") from e\n\nLOWERCASE_UNDERSCORE_PATTERN_STR: str = r'^[a-z]+(_[a-z]+)+$'\n\nclass PatternRepository:\n    \"\"\"Manages and provides compiled regex patterns.\"\"\"\n    def __init__(self) -> None:\n        self._compiled_lowercase_underscore: Pattern[str] | None = None\n\n    def get_lowercase_underscore_pattern(self) -> Pattern[str]:\n        \"\"\"Returns the compiled regex for lowercase-underscore pattern.\"\"\"\n        if self._compiled_lowercase_underscore is None:\n            self._compiled_lowercase_underscore = re.compile(LOWERCASE_UNDERSCORE_PATTERN_STR)\n        return self._compiled_lowercase_underscore\n\nclass TextValidatorService:\n    \"\"\"Service for validating text against defined patterns.\"\"\"\n    def __init__(self, pattern_repo: PatternRepository) -> None:\n        self._pattern_repo = pattern_repo\n\n    def is_lowercase_underscore(self, text: str) -> bool:\n        \"\"\"Checks if the string contains sequences of lowercase letters joined with an underscore.\"\"\"\n        if text is None:\n            raise ValidationError(\"text is required\")\n        s = normalize_input(text)\n        pattern = self._pattern_repo.get_lowercase_underscore_pattern()\n        return bool(pattern.match(s))\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore. Returns true if it matches, false otherwise.\n    \"\"\"\n    repo = PatternRepository()\n    service = TextValidatorService(repo)\n    return service.is_lowercase_underscore(text)"}
{"task_id": "Mbpp/20", "solution": "```python\nfrom woodall.services import WoodallService\nfrom woodall.repository import CacheRepository\nfrom woodall.config import CACHE_ENABLED, MAX_K\n\ndef is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is a Woodall number (k * 2^k - 1).\n    Uses WoodallService with an in-memory cache.\n    \"\"\"\n    # Initialize CacheRepository only if caching is enabled\n    cache_repo = CacheRepository() if CACHE_ENABLED else None\n    service = WoodallService(cache=cache_repo, max_k=MAX_K)\n    return service.is_woodall(n).is_woodall\n```"}
