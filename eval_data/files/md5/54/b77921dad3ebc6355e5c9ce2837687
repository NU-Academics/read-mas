{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int, allow_pow0: bool = False) -> bool:\n    \"\"\"\n    Checks if a number can be represented as a sum of distinct powers of two.\n    By default (allow_pow0=False), 2^0 (which is 1) is not allowed as a power.\n    \"\"\"\n    if n <= 0:\n        return False\n\n    if allow_pow0:\n        # Any positive integer can be represented as a sum of distinct powers of two (including 2^0).\n        return True\n    else:\n        # If 2^0 (1) is not allowed, then only even numbers can be represented\n        # as a sum of powers of two (where exponents are >= 1).\n        return (n % 2 == 0)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr):\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n\n    Returns float('inf') if there are non-zeroes but no non-zero elements,\n    and 0.0 if the array is empty.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    for x in arr:\n        if x == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        if zeroes == 0:\n            return 0.0  # Empty array, or array with only non-integer items if type checking was allowed.\n        else:\n            return float('inf')  # All elements are zero, division by zero results in infinity.\n    else:\n        return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Uses the formula C = 2 * pi * r.\n    \"\"\"\n    return 2 * math.pi * radius"}
{"task_id": "Mbpp/140", "solution": "from typing import Set, Iterable\n\ndef extract_singly(list_of_lists: Iterable[Iterable[int]]) -> Set[int]:\n    \"\"\"\n    Flattens an iterable of iterables into a single set of unique integers.\n    This function expects validated input, adhering to Iterable[Iterable[int]].\n    \"\"\"\n    result_set: Set[int] = set()\n    for inner_iterable in list_of_lists:\n        for number in inner_iterable:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Computes the maximum difference between any two elements in an array\n    using a single pass to find the minimum and maximum values.\n    \"\"\"\n    it = iter(arr)\n    \n    # Assume arr has at least one element due to external validation per design.\n    first = next(it) \n\n    min_val = max_val = float(first)\n    for v in it:\n        fv = float(v)\n        if fv < min_val:\n            min_val = fv\n        elif fv > max_val:\n            max_val = fv\n            \n    return max_val - min_val"}
{"task_id": "Mbpp/142", "solution": "from typing import List, Any\n\ndef count_samepair(list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Comparison is performed up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "from typing import List, TypeVar\n\nT = TypeVar(\"T\")\n\ndef pancake_sort(items: List[T], ascending: bool = True) -> List[T]:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    It returns a new sorted list, preserving the original.\n    \"\"\"\n    arr = list(items)  # Create a mutable copy to perform in-place operations.\n    n = len(arr)\n\n    # Helper function to reverse the first k elements of the list in-place.\n    def _flip(current_list: List[T], k: int) -> None:\n        current_list[:k] = current_list[:k][::-1]\n\n    # Helper function to find the index of the maximum element in the first `current_n` elements.\n    def _find_max_index(current_list: List[T], current_n: int) -> int:\n        max_i = 0\n        for i in range(1, current_n):\n            if current_list[i] > current_list[max_i]:\n                max_i = i\n        return max_i\n\n    # Main pancake sort algorithm logic.\n    # Iterate from the end of the list down to the second element.\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current sub-list (from index 0 to curr_size-1).\n        max_idx = _find_max_index(arr, curr_size)\n\n        # If the maximum element is not already at its correct position (curr_size - 1).\n        if max_idx != curr_size - 1:\n            # If the maximum element is not at the beginning, flip it to the front.\n            if max_idx != 0:\n                _flip(arr, max_idx + 1)\n            # Flip the entire sub-list to move the maximum element to its sorted position.\n            _flip(arr, curr_size)\n\n    # If descending order is requested, reverse the already ascending sorted list.\n    if not ascending:\n        arr.reverse()\n\n    return arr"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef _extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"\n    Computes (g, x, y) such that ax + by = g = gcd(a, b).\n    Handles signs and zero inputs correctly.\n    \"\"\"\n    old_r, r = abs(a), abs(b)\n    old_s, s = (1 if a >= 0 else -1), 0\n    old_t, t = 0, (1 if b >= 0 else -1)\n\n    while r != 0:\n        q = old_r // r\n        old_r, r = r, old_r - q * r\n        old_s, s = s, old_s - q * s\n        old_t, t = t, old_t - q * t\n    return (old_r, old_s, old_t)\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or return None if no solution exists.\n    \"\"\"\n    g, x0, y0 = _extended_gcd(a, b)\n\n    if g == 0:\n        # If a=0 and b=0, the equation is 0*x + 0*y = n.\n        return (0, 0) if n == 0 else None\n    \n    if n % g != 0:\n        # If n is not divisible by gcd(a, b), no integer solution exists.\n        return None\n\n    # Scale the particular solution (x0, y0) by n/g.\n    mult = n // g\n    x = x0 * mult\n    y = y0 * mult\n    return (x, y)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    The series is an arithmetic progression: n + (n-2) + (n-4) + ... (until the term is >= 0).\n    \"\"\"\n    if n < 0:\n        # Per design context, validation is handled by a Validator class,\n        # but for a standalone function, we ensure non-negativity if this were the primary entry.\n        # However, the prompt specifically says \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # So, we assume n is valid (non-negative) based on the requirement of a Validator.\n        # Given n must be >= 0 as per FR1 precondition.\n        pass\n\n    # The number of terms is floor(n/2) + 1\n    num_terms = n // 2 + 1\n\n    # The first term is n\n    first_term = n\n\n    # The last term is 0 if n is even, 1 if n is odd\n    last_term = n % 2\n\n    # The sum of an arithmetic series is (number_of_terms / 2) * (first_term + last_term)\n    # Using integer division for the final result as all intermediate values are integers\n    total_sum = (num_terms * (first_term + last_term)) // 2\n\n    return total_sum"}
{"task_id": "Mbpp/161", "solution": "from typing import List, Iterable, Any, Set, TypeVar\n\nT = TypeVar(\"T\")\n\ndef is_hashable(obj: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n    except TypeError:\n        return False\n    return True\n\ndef all_hashable(iterable: Iterable[Any]) -> bool:\n    \"\"\"Checks if all items in an iterable are hashable.\"\"\"\n    return all(is_hashable(x) for x in iterable)\n\ndef remove_elements(source: List[T], to_remove: Iterable[T]) -> List[T]:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    The order of elements in the source list is preserved.\n    \"\"\"\n    to_remove_list = list(to_remove)\n\n    if not to_remove_list:\n        return list(source)\n\n    if all_hashable(to_remove_list):\n        remove_set: Set[T] = set(to_remove_list) # type: ignore\n        return [item for item in source if item not in remove_set]\n    else:\n        result: List[T] = []\n        for item in source:\n            if not any(item == r_item for r_item in to_remove_list):\n                result.append(item)\n        return result"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(nums: List[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    Pairs XOR to an even number if both integers are even or both are odd.\n    \"\"\"\n    evens = 0\n    odds = 0\n    for x in nums:\n        if x & 1 == 0:\n            evens += 1\n        else:\n            odds += 1\n\n    def _comb2(n: int) -> int:\n        \"\"\"Helper to compute n choose 2, i.e., n * (n - 1) // 2.\"\"\"\n        return n * (n - 1) // 2 if n >= 2 else 0\n\n    return _comb2(evens) + _comb2(odds)"}
{"task_id": "Mbpp/165", "solution": "from typing import Any\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nALPHABET: str = \"abcdefghijklmnopqrstuvwxyz\"\nDEFAULT_MAX_LENGTH: int = 10000\n\nclass Validator:\n    \"\"\"Validates input strings based on length and type.\"\"\"\n    def __init__(self, max_length: int):\n        self._max_length = max_length\n\n    def validate_input(self, s: Any) -> None:\n        if not isinstance(s, str):\n            raise InvalidInputError(\"Input must be a string\")\n        if len(s) > self._max_length:\n            raise InvalidInputError(f\"Input too long (>{self._max_length})\")\n\nclass CharPositionCounter:\n    \"\"\"Counts characters matching their alphabet position.\"\"\"\n    def __init__(self, alphabet: str, validator: Validator):\n        self._alphabet = alphabet\n        self._validator = validator\n\n    def count(self, s: str) -> int:\n        self._validator.validate_input(s)\n        s_lower = s.lower()\n        count = 0\n        for i, ch in enumerate(s_lower):\n            if i < len(self._alphabet) and ch == self._alphabet[i]:\n                count += 1\n        return count\n\n_default_validator = Validator(DEFAULT_MAX_LENGTH)\n_default_counter = CharPositionCounter(ALPHABET, _default_validator)\n\ndef count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the English alphabet (case insensitive).\n    \"\"\"\n    return _default_counter.count(s)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 to return 1 as a base case.\n    \"\"\"\n    if n <= 1:\n        return 1\n    # For n > 1, the smallest power of 2 >= n is 2 raised to the power of\n    # the bit length of (n-1). This effectively finds the position of the\n    # most significant bit of n if n is not a power of 2, or n itself if it is.\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/170", "solution": "from typing import List, Union\n\ndef sum_range_list(lst: List[Union[int, float]], start: int, end: int) -> float:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified range (inclusive).\n    Handles negative indices and swaps start/end if start > end.\n    \"\"\"\n    list_length = len(lst)\n\n    # Normalize start and end indices, handling negative values\n    normalized_start = start\n    normalized_end = end\n\n    if normalized_start < 0:\n        normalized_start = list_length + normalized_start\n    if normalized_end < 0:\n        normalized_end = list_length + normalized_end\n    \n    # Swap indices if start is greater than end, as per design\n    if normalized_start > normalized_end:\n        normalized_start, normalized_end = normalized_end, normalized_start\n\n    # Python slicing automatically handles indices that might still be out of bounds\n    # after normalization (e.g., clamped to 0 or list_length), and an empty slice sums to 0.0.\n    return float(sum(lst[normalized_start : normalized_end + 1]))"}
{"task_id": "Mbpp/168", "solution": "from typing import Any, List, Optional, Protocol\n\nclass FrequencyError(Exception):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(FrequencyError):\n    pass\n\nclass FrequencyRequest:\n    def __init__(self, data: List[Any], target: Any) -> None:\n        self.data = data\n        self.target = target\n\n    def validate(self) -> None:\n        if self.data is None:\n            raise ValidationError(\"data must not be None\")\n        try:\n            iter(self.data)\n        except TypeError:\n            raise ValidationError(\"data must be an iterable\")\n\nclass FrequencyResult:\n    def __init__(self, count: int) -> None:\n        if count < 0:\n            raise ValueError(\"count must be non-negative\")\n        self.count = count\n\nclass FrequencyCalculator:\n    @staticmethod\n    def count(data: List[Any], target: Any) -> int:\n        c = 0\n        for item in data:\n            if item == target:\n                c += 1\n        return c\n\nclass FrequencyRepositoryInterface(Protocol):\n    def record(self, request: FrequencyRequest) -> None: ...\n    def get_history(self) -> List[FrequencyRequest]: ...\n\nclass InMemoryFrequencyRepository(FrequencyRepositoryInterface):\n    def __init__(self) -> None:\n        self._history: List[FrequencyRequest] = []\n\n    def record(self, request: FrequencyRequest) -> None:\n        self._history.append(request)\n\n    def get_history(self) -> List[FrequencyRequest]:\n        return list(self._history)\n\n    def clear(self) -> None:\n        self._history.clear()\n\nclass FrequencyService:\n    def __init__(self, repo: Optional[FrequencyRepositoryInterface] = None) -> None:\n        self._repo = repo\n\n    def count_occurrences(self, data: List[Any], target: Any) -> int:\n        if data is None:\n            raise ValidationError(\"data must not be None\")\n        \n        count = FrequencyCalculator.count(data, target)\n        \n        if self._repo is not None:\n            try:\n                self._repo.record(FrequencyRequest(data, target))\n            except Exception:\n                pass\n        return count\n\nclass FrequencyController:\n    def __init__(self, service: FrequencyService) -> None:\n        self._service = service\n\n    def handle_count(self, request: FrequencyRequest) -> FrequencyResult:\n        request.validate()\n        count = self._service.count_occurrences(request.data, request.target)\n        return FrequencyResult(count)\n\n_default_controller = FrequencyController(FrequencyService(InMemoryFrequencyRepository()))\n\ndef frequency(data: list, value) -> int:\n    \"\"\"\n    Counts the number of occurrences of a value in a given list.\n    This function utilizes an internal architectural stack for modularity.\n    \"\"\"\n    req = FrequencyRequest(data, value)\n    result = _default_controller.handle_count(req)\n    return result.count"}
{"task_id": "Mbpp/223", "solution": "import math\n\ndef is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array arr of length n.\n    The majority element occurs more than n/2 times.\n    \"\"\"\n    if n == 0:\n        return False\n\n    # Perform binary search to find the first occurrence of x\n    low, high = 0, n - 1\n    first_occurrence = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            first_occurrence = mid\n            high = mid - 1  # Try to find an even earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    if first_occurrence == -1:\n        return False  # x is not present in the array\n\n    # Check if the element at first_occurrence + n/2 is also x\n    # This implies that there are more than n/2 occurrences of x starting from first_occurrence\n    check_index = first_occurrence + n // 2\n    if check_index < n and arr[check_index] == x:\n        return True\n    \n    return False"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(text: str) -> int:\n    \"\"\"Counts non-overlapping occurrences of 'std' in the given text.\"\"\"\n    substring = \"std\"\n    count = 0\n    idx = 0\n    step = len(substring)\n    while True:\n        idx = text.find(substring, idx)\n        if idx == -1:\n            break\n        count += 1\n        idx += step\n    return count"}
