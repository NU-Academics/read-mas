{"task_id": "Mbpp/237", "solution": "def check_occurences(list_of_tuples: list[tuple]) -> dict[tuple, int]:\n    \"\"\"\n    Counts the occurrences of unique tuples in a list, treating permutations as the same tuple.\n    Each tuple is canonicalized by sorting its elements.\n    \"\"\"\n    counts = {}\n    for item_tuple in list_of_tuples:\n        # Canonicalize the tuple by sorting its elements\n        canonical_tuple = tuple(sorted(item_tuple))\n        counts[canonical_tuple] = counts.get(canonical_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/239", "solution": "class DPRepository:\n    \"\"\"Manages in-memory memoization cache for DP states.\"\"\"\n    def __init__(self):\n        self._cache: dict[tuple[int, int], int] = {}\n\n    def get(self, min_value: int, remaining_length: int) -> int | None:\n        \"\"\"Retrieves a cached value if present.\"\"\"\n        return self._cache.get((min_value, remaining_length))\n\n    def set(self, min_value: int, remaining_length: int, value: int) -> None:\n        \"\"\"Stores a computed value in the cache.\"\"\"\n        self._cache[(min_value, remaining_length)] = value\n\n\nclass SequenceService:\n    \"\"\"Computes sequence counts using memoized dynamic programming.\"\"\"\n    def __init__(self, repo: DPRepository):\n        self.repo = repo\n\n    def _count_from(self, min_value: int, remaining_length: int, m: int) -> int:\n        \"\"\"\n        Recursive helper to count sequences.\n        min_value: The smallest allowed value for the current element.\n        remaining_length: How many elements are still needed (including the current one).\n        m: The overall maximum allowed value for any element.\n        \"\"\"\n        # Base case: If only one element needs to be chosen.\n        # It can be any integer from min_value to m (inclusive).\n        # max(0, ...) ensures the count is not negative if min_value > m.\n        if remaining_length == 1:\n            return max(0, m - min_value + 1)\n\n        # Memoization: Check if the result for this state is already cached.\n        cached = self.repo.get(min_value, remaining_length)\n        if cached is not None:\n            return cached\n\n        total = 0\n        v = min_value  # 'v' is the current element we are trying to choose.\n\n        # Calculate the multiplier for the last element in the remaining sequence.\n        # Since remaining_length is >= 2 here, (remaining_length - 1) is always >= 1.\n        power_of_2_suffix = 2**(remaining_length - 1)\n\n        # Iterate over possible values for 'v'.\n        while v <= m:\n            # Pruning optimization:\n            # If the smallest possible value for the last element in the remaining sequence\n            # (which would be `v * power_of_2_suffix`) already exceeds `m`,\n            # then 'v' (and any larger value) cannot lead to a valid sequence.\n            # We use division to avoid potential overflow with very large numbers.\n            # If power_of_2_suffix is larger than m, m // power_of_2_suffix will be 0.\n            if v > m // power_of_2_suffix:\n                break\n\n            next_min_for_subsequence = 2 * v\n            \n            # Recursively count sequences for the remaining length,\n            # starting with the new minimum value.\n            total += self._count_from(next_min_for_subsequence, remaining_length - 1, m)\n\n            v += 1 # Try the next possible value for the current element.\n\n        # Store the computed result in the cache before returning.\n        self.repo.set(min_value, remaining_length, total)\n        return total\n\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n such that each element is\n    a positive integer, is greater than or equal to twice the previous element,\n    and is less than or equal to m.\n    \"\"\"\n    repo = DPRepository()\n    service = SequenceService(repo)\n    # The first element in any valid sequence must be at least 1.\n    return service._count_from(1, n, m)"}
{"task_id": "Mbpp/240", "solution": "from typing import Any, List\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    \"\"\"Validates list inputs and their preconditions.\"\"\"\n    def validate_list(self, obj: Any, name: str) -> None:\n        if not isinstance(obj, list):\n            raise InvalidInputError(f\"{name} must be a list\")\n        if name == \"list_a\" and len(obj) == 0:\n            raise InvalidInputError(\"list_a must contain at least one element\")\n\nclass ListModel:\n    \"\"\"Domain model for a list, encapsulating the core transformation logic.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self._items = list(items)\n\n    @classmethod\n    def from_list(cls, items: List[Any]) -> \"ListModel\":\n        return cls(items)\n\n    def to_list(self) -> List[Any]:\n        return list(self._items)\n\n    def replace_last_with(self, other: List[Any]) -> List[Any]:\n        \"\"\"Returns a new list with the last element replaced by elements of 'other'.\"\"\"\n        if not self._items:\n            raise InvalidInputError(\"list_a must contain at least one element\")\n        return self._items[:-1] + list(other)\n\nclass ListReplacerService:\n    \"\"\"Orchestrates validation and the list replacement transformation.\"\"\"\n    def __init__(self, validator: Validator = None) -> None:\n        self._validator = validator or Validator()\n\n    def replace(self, list_a: List[Any], list_b: List[Any]) -> List[Any]:\n        \"\"\"Validates inputs and performs the list replacement.\"\"\"\n        self._validator.validate_list(list_a, \"list_a\")\n        self._validator.validate_list(list_b, \"list_b\")\n        model = ListModel.from_list(list_a)\n        return model.replace_last_with(list_b)\n\ndef replace_list(list_a: List[Any], list_b: List[Any]) -> List[Any]:\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n    Returns a new list without modifying the input lists.\n    \"\"\"\n    service = ListReplacerService()\n    return service.replace(list_a, list_b)"}
{"task_id": "Mbpp/242", "solution": "from typing import Any\n\ndef _safe_str(obj: Any) -> str:\n    \"\"\"Converts an object to a string, treating None as an empty string.\"\"\"\n    if obj is None:\n        return \"\"\n    return str(obj)\n\ndef _remove_whitespace(text: str) -> str:\n    \"\"\"Returns a new string with all whitespace characters removed.\"\"\"\n    return \"\".join(ch for ch in text if not ch.isspace())\n\ndef count_charac(text: Any, ignore_whitespace: bool = False) -> int:\n    \"\"\"\n    Counts the total number of characters in a string, optionally ignoring whitespace.\n    Non-string inputs are converted to string; None is treated as an empty string.\n    \"\"\"\n    normalized_text = _safe_str(text)\n    if ignore_whitespace:\n        normalized_text = _remove_whitespace(normalized_text)\n    return len(normalized_text)"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for lengths 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if s[i] == s[j]:\n                # If characters match, add 2 to the LPS of the inner substring\n                dp[i][j] = dp[i + 1][j - 1] + 2\n            else:\n                # If characters don't match, take the maximum of excluding s[i] or s[j]\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result is the LPS of the entire string s[0...n-1]\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n):\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than the given number n.\n    Assumes n is an integer.\n    \"\"\"\n    # Find the integer square root of n.\n    # If n is negative, math.isqrt will raise ValueError, but the design context assumes positive/zero.\n    # If n is non-negative, k = floor(sqrt(n)).\n    if n < 0:\n        k = 0 # For negative n, the smallest perfect square > n is 0 or 1.\n    else:\n        k = math.isqrt(n)\n\n    # If k*k is already strictly greater than n, then k*k is the next perfect square.\n    # This happens for inputs like n=2 or n=3, where k=1 and k*k=1 is not > n.\n    # It also happens if n is itself a perfect square, e.g., n=36, k=6. We need strictly greater.\n    if k * k > n:\n        return k * k\n    else:\n        # Otherwise, the next perfect square must be (k+1)*(k+1).\n        return (k + 1) * (k + 1)"}
{"task_id": "Mbpp/250", "solution": "import ast\nfrom typing import Any, Optional\n\nclass TupleCounterError(Exception):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(TupleCounterError):\n    pass\n\nclass Validator:\n    def __init__(self, allow_list_conversion: bool = False) -> None:\n        self.allow_list_conversion = allow_list_conversion\n\n    def validate_tuple(self, data: Any) -> tuple:\n        if isinstance(data, tuple):\n            return data\n        if self.allow_list_conversion and isinstance(data, list):\n            return tuple(data)\n        raise ValidationError(\"Input must be a tuple\")\n\n    def parse_tuple_string(self, s: str) -> tuple:\n        try:\n            parsed = ast.literal_eval(f\"({s},)\") if ',' in s and not s.strip().startswith('(') else ast.literal_eval(s)\n            return tuple(parsed) if isinstance(parsed, (list, tuple)) else (parsed,)\n        except Exception as exc:\n            raise ValidationError(f\"Cannot parse tuple string: {exc}\")\n\nclass CounterService:\n    def __init__(self, repository: Optional[Any] = None, validator: Optional['Validator'] = None) -> None:\n        self._repository = repository\n        self._validator = validator or Validator()\n\n    def count_occurrences(self, data: tuple, element: Any) -> int:\n        validated = self._validator.validate_tuple(data)\n        return validated.count(element)\n\n_default_validator = Validator(allow_list_conversion=False)\n_default_service = CounterService(validator=_default_validator)\n\ndef count_X(data: tuple, element: object) -> int:\n    \"\"\"Counts the occurrences of an element in a tuple.\"\"\"\n    return _default_service.count_occurrences(data, element)"}
{"task_id": "Mbpp/245", "solution": "from typing import List\n\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n\n    # msis_sums[i] stores the maximum sum of an increasing subsequence ending with arr[i].\n    msis_sums = list(arr)\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i] and msis_sums[i] < msis_sums[j] + arr[i]:\n                msis_sums[i] = msis_sums[j] + arr[i]\n\n    # msds_sums[i] stores the maximum sum of a decreasing subsequence starting with arr[i].\n    msds_sums = list(arr)\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i] and msds_sums[i] < msds_sums[j] + arr[i]:\n                msds_sums[i] = msds_sums[j] + arr[i]\n\n    # The maximum sum of a bitonic subsequence is the maximum of (msis_sums[i] + msds_sums[i] - arr[i])\n    # for all i, because arr[i] is the peak element and is counted twice.\n    max_total_sum = float('-inf')\n    for i in range(n):\n        current_bitonic_sum = msis_sums[i] + msds_sums[i] - arr[i]\n        if current_bitonic_sum > max_total_sum:\n            max_total_sum = current_bitonic_sum\n\n    return int(max_total_sum)"}
