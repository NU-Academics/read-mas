{"task_id": "Mbpp/751", "solution": "from typing import Sequence, Any\n\ndef check_min_heap(arr: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n\n    A min-heap property states that for any given node i, the value of i is\n    less than or equal to the values of its children (if they exist).\n    \"\"\"\n    n = len(arr)\n\n    # An empty array or a single-element array is considered a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate through potential parent nodes.\n    # Parent nodes are at indices from 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child property\n        if left_child_idx < n:  # Ensure left child exists within array bounds\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n        # Check right child property\n        if right_child_idx < n:  # Ensure right child exists within array bounds\n            if arr[i] > arr[right_child_idx]:\n                return False\n\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Values are converted to float for consistent sorting and output.\n    \"\"\"\n    normalized_records = [(name, float(value)) for name, value in records]\n    sorted_records = sorted(normalized_records, key=lambda r: r[1])\n    return sorted_records[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number iteratively.\n    The sequence starts with J(0)=0, J(1)=1, and follows J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Initialize a and b to J(0) and J(1) respectively\n    a, b = 0, 1\n    # Iterate from k=2 up to n to compute the current Jacobsthal number\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list.\n    A pair (strings[i], strings[j]) counts if i < j and strings[i] is the reverse of strings[j].\n    \"\"\"\n    def _normalize(s: str) -> str:\n        \"\"\"Strips whitespace and keeps string case-sensitive.\"\"\"\n        return s.strip()\n\n    def _reverse(s: str) -> str:\n        \"\"\"Returns the reverse of a string.\"\"\"\n        return s[::-1]\n\n    seen_strings: dict[str, int] = {}\n    pair_count = 0\n\n    for s in strings:\n        # Normalize the current string before processing\n        normalized_s = _normalize(s)\n        \n        # Get its reverse\n        reversed_s = _reverse(normalized_s)\n        \n        # If the reversed string has been seen before, add its count to total pairs\n        pair_count += seen_strings.get(reversed_s, 0)\n        \n        # Add the normalized string to our seen map, or increment its count\n        seen_strings[normalized_s] = seen_strings.get(normalized_s, 0) + 1\n        \n    return pair_count"}
{"task_id": "Mbpp/754", "solution": "from typing import List, Any, Sequence, Optional, Dict\n\nclass ValidationError(Exception):\n    \"\"\"Exception indicating invalid input or precondition failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass ExtractionError(Exception):\n    \"\"\"Exception indicating unexpected extraction failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass ExtractRequest:\n    \"\"\"DTO for incoming parameters.\"\"\"\n    def __init__(self, l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> None:\n        self.l1 = l1\n        self.l2 = l2\n        self.l3 = l3\n\nclass ExtractResult:\n    \"\"\"DTO wrapping the resulting list for standardized returns.\"\"\"\n    def __init__(self, result: List[Any]) -> None:\n        self.result = result\n\nclass ListRepository:\n    \"\"\"Ephemeral in-memory store for debugging or caching last-run inputs/results.\"\"\"\n    DEFAULT_ID = \"last_run\"\n\n    def __init__(self) -> None:\n        self._store: Dict[str, Dict[str, Any]] = {}\n\n    def save(self, id: str, l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any], result: List[Any]) -> None:\n        \"\"\"Saves references of inputs and result to the in-memory store.\"\"\"\n        self._store[id] = {\"l1\": l1, \"l2\": l2, \"l3\": l3, \"result\": result}\n\n    def get(self, id: str) -> Optional[Dict[str, Any]]:\n        \"\"\"Retrieves a saved entry by ID.\"\"\"\n        return self._store.get(id)\n\n    def clear(self, id: Optional[str] = None) -> None:\n        \"\"\"Clears one or all saved entries.\"\"\"\n        if id is None:\n            self._store.clear()\n        else:\n            self._store.pop(id, None)\n\nclass ListValidator:\n    \"\"\"Validates input types and preconditions, raising ValidationError for invalid inputs.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_sequence(self, name: str, seq: Any) -> None:\n        \"\"\"Ensures a given input is not None and is sequence-like (indexable).\"\"\"\n        if seq is None:\n            raise ValidationError(f\"{name} must not be None\")\n        if not hasattr(seq, \"__len__\") or not hasattr(seq, \"__getitem__\"):\n            raise ValidationError(f\"{name} must be indexable (sequence-like)\")\n\n    def validate_compatible_for_indexing(self, l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> None:\n        \"\"\"Validates that all three inputs are sequences compatible for indexing.\"\"\"\n        self.validate_sequence(\"l1\", l1)\n        self.validate_sequence(\"l2\", l2)\n        self.validate_sequence(\"l3\", l3)\n\nclass ListExtractorService:\n    \"\"\"Core service for extracting common elements by index from three lists.\"\"\"\n    def __init__(self, validator: ListValidator, repository: Optional[ListRepository] = None) -> None:\n        self._validator = validator\n        self._repository = repository\n\n    def extract_common_by_index(self, l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> List[Any]:\n        \"\"\"Performs the core algorithm to find elements common at the same index in all three lists.\"\"\"\n        try:\n            self._validator.validate_compatible_for_indexing(l1, l2, l3)\n        except ValidationError:\n            raise # Propagate validation errors\n\n        min_len = min(len(l1), len(l2), len(l3))\n        result: List[Any] = []\n        for i in range(min_len):\n            try:\n                if self._equals_at(i, l1, l2, l3):\n                    result.append(l1[i])\n            except IndexError as e:\n                raise ExtractionError(f\"Index error during extraction at index {i}: {e}\") from e\n            except Exception as e:\n                raise ExtractionError(f\"An unexpected error occurred during extraction at index {i}: {e}\") from e\n\n        if self._repository:\n            self._repository.save(ListRepository.DEFAULT_ID, l1, l2, l3, result)\n        return result\n\n    def _equals_at(self, i: int, l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> bool:\n        \"\"\"Helper to compare elements at a specific index across all three lists.\"\"\"\n        return l1[i] == l2[i] == l3[i]\n\nclass ListController:\n    \"\"\"API boundary that accepts ExtractRequest and returns ExtractResult.\"\"\"\n    def __init__(self, service: ListExtractorService) -> None:\n        self._service = service\n\n    def api_extract(self, request: ExtractRequest) -> ExtractResult:\n        \"\"\"Converts an ExtractRequest to service parameters, calls the service, and wraps the result.\"\"\"\n        result_list = self._service.extract_common_by_index(request.l1, request.l2, request.l3)\n        return ExtractResult(result_list)\n\ndef extract_index_list(l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> List[Any]:\n    validator = ListValidator()\n    repo = ListRepository()\n    service = ListExtractorService(validator, repo)\n    controller = ListController(service)\n    request = ExtractRequest(l1, l2, l3)\n    return controller.api_extract(request).result"}
{"task_id": "Mbpp/755", "solution": "from typing import Any, Iterable, List, Dict\n\nclass SecondSmallestError(ValueError):\n    \"\"\"Custom exception for errors related to finding the second smallest number.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass NumberList:\n    \"\"\"Encapsulates a list of numbers, providing operations like unique and sorted access.\"\"\"\n    def __init__(self, values: List[float]) -> None:\n        self._values: List[float] = list(values)\n\n    def values(self) -> List[float]:\n        \"\"\"Returns a copy of the original numeric list.\"\"\"\n        return list(self._values)\n\n    def unique_sorted(self) -> List[float]:\n        \"\"\"Returns a sorted list of unique values from the encapsulated numbers.\"\"\"\n        return sorted(set(self._values))\n\n    def __len__(self) -> int:\n        \"\"\"Returns the count of numbers in the original list.\"\"\"\n        return len(self._values)\n\nclass SecondSmallestResult:\n    \"\"\"DTO for the result, including the second smallest value and metadata.\"\"\"\n    def __init__(self, value: float, original_count: int, unique_count: int) -> None:\n        self.value = value\n        self.original_count = original_count\n        self.unique_count = unique_count\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation of the result.\"\"\"\n        return {\n            \"value\": self.value,\n            \"original_count\": self.original_count,\n            \"unique_count\": self.unique_count,\n        }\n\nclass InputValidator:\n    \"\"\"Validates raw input and converts it into a NumberList object.\"\"\"\n    def validate_list(self, values: Any) -> NumberList:\n        if isinstance(values, str):\n            raise SecondSmallestError(\"String provided; CLI should parse quoted input or pass a list.\")\n        try:\n            seq = list(values)\n        except TypeError:\n            raise SecondSmallestError(\"Provided input is not iterable.\")\n        nums = self._ensure_numeric_sequence(seq)\n        return NumberList(nums)\n\n    def _ensure_numeric_sequence(self, values: Iterable[Any]) -> List[float]:\n        \"\"\"Ensures all elements in an iterable are numeric and converts them to floats.\"\"\"\n        out: List[float] = []\n        for i, v in enumerate(values):\n            try:\n                out.append(float(v))\n            except (TypeError, ValueError):\n                raise SecondSmallestError(f\"Element at index {i} is not numeric: {v!r}\")\n        return out\n\nclass SecondSmallestService:\n    \"\"\"Business logic for computing the second smallest distinct number.\"\"\"\n    MIN_UNIQUE_REQUIRED = 2\n\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def second_smallest(self, values: Any) -> SecondSmallestResult:\n        \"\"\"Finds the second smallest distinct number from the input values.\"\"\"\n        nlist = self._validator.validate_list(values)\n        return self._compute_from_number_list(nlist)\n\n    def _compute_from_number_list(self, nlist: NumberList) -> SecondSmallestResult:\n        \"\"\"Computes the second smallest from a validated NumberList.\"\"\"\n        unique = nlist.unique_sorted()\n        if len(unique) < self.MIN_UNIQUE_REQUIRED:\n            raise SecondSmallestError(\"Need at least two distinct numeric values.\")\n        value = unique[1]\n        return SecondSmallestResult(value=value, original_count=len(nlist), unique_count=len(unique))\n\ndef second_smallest(nums: List[float]) -> float:\n    \"\"\"\n    Finds the second smallest distinct number in a list of numeric values.\n    Raises SecondSmallestError if input is invalid or has fewer than two unique numbers.\n    \"\"\"\n    validator = InputValidator()\n    service = SecondSmallestService(validator)\n    result_dto = service.second_smallest(nums)\n    return result_dto.value"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\nfrom typing import List, Any, Dict, Tuple\n\ndef unique_sublists(sublists: List[Any]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of sublists, converting them to tuples, and returns a dictionary of counts.\n    Nested lists within sublists are recursively converted to nested tuples.\n    \"\"\"\n\n    def _to_tuple_recursive(value: Any) -> Any:\n        # This helper recursively converts list-like structures to tuples for immutability.\n        if isinstance(value, list):\n            return tuple(_to_tuple_recursive(v) for v in value)\n        return value\n\n    converted_items = []\n    for item in sublists:\n        # Convert each sublist to its canonical tuple representation for use as a dictionary key.\n        converted_items.append(_to_tuple_recursive(item))\n\n    # Use Counter to efficiently tally the occurrences of the unique tuple representations.\n    return dict(Counter(converted_items))"}
{"task_id": "Mbpp/759", "solution": "import re\nfrom typing import Any, Dict\n\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass InvalidTypeError(ValidationError):\n    pass\n\nclass Config:\n    DEFAULT_PRECISION: int = 2\n    ALLOW_SIGN: bool = True\n\nclass Utils:\n    @staticmethod\n    def is_string(value: Any) -> bool:\n        return isinstance(value, str)\n\n    @staticmethod\n    def normalize_input(value: Any) -> str:\n        if not Utils.is_string(value):\n            raise InvalidTypeError(\"Input must be a string\")\n        return value.strip()\n\nclass PatternRepository:\n    def __init__(self):\n        self._cache: Dict[int, re.Pattern] = {}\n\n    def get_decimal_pattern(self, precision: int):\n        if precision < 0:\n            raise ValueError(\"precision must be >= 0\")\n        if precision in self._cache:\n            return self._cache[precision]\n        sign = r'[+-]?' if Config.ALLOW_SIGN else ''\n        pattern_str = rf\"^{sign}\\d+\\.\\d{{{precision}}}$\"\n        compiled = re.compile(pattern_str)\n        self._cache[precision] = compiled\n        return compiled\n\nclass DecimalValidator:\n    def __init__(self, pattern_repo: PatternRepository, config: Config):\n        self._pattern_repo = pattern_repo\n        self._config = config\n\n    def validate(self, value: str) -> bool:\n        normalized = Utils.normalize_input(value)\n        pattern = self._pattern_repo.get_decimal_pattern(self._config.DEFAULT_PRECISION)\n        return bool(pattern.fullmatch(normalized))\n\ndef is_decimal(value: str) -> bool:\n    repo = PatternRepository()\n    validator = DecimalValidator(repo, Config)\n    return validator.validate(value)"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) has exactly 30 days.\n    Months with 30 days are April (4), June (6), September (9), and November (11).\n    \"\"\"\n    months_with_30_days = {4, 6, 9, 11}\n    return month in months_with_30_days"}
{"task_id": "Mbpp/760", "solution": "import numbers\nfrom typing import Iterable, Any, List, Optional\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass UniqueCheckResult:\n    def __init__(self, input_snapshot: List[numbers.Number], is_unique: bool, distinct_value: Optional[numbers.Number]) -> None:\n        self.input_snapshot = input_snapshot\n        self.is_unique = is_unique\n        self.distinct_value = distinct_value\n\n    def to_dict(self) -> dict:\n        return {\n            \"input_snapshot\": self.input_snapshot,\n            \"is_unique\": self.is_unique,\n            \"distinct_value\": self.distinct_value,\n        }\n\nclass ListValidator:\n    allowed_numeric_types: tuple = (numbers.Number,)\n\n    def validate(self, seq: Iterable[Any]) -> List[numbers.Number]:\n        try:\n            lst = list(seq)\n        except TypeError:\n            raise InvalidInputError(\"Provided object is not iterable\")\n        for idx, item in enumerate(lst):\n            if not isinstance(item, self.allowed_numeric_types):\n                raise InvalidInputError(f\"Non-numeric element at index {idx}: {item!r}\")\n        return lst\n\nCACHE_MAX_ITEMS = 10_000\n\nclass InMemoryCacheRepository:\n    def __init__(self, max_items: int = CACHE_MAX_ITEMS) -> None:\n        self._store: dict[str, UniqueCheckResult] = {}\n        self._keys_fifo: List[str] = []\n        self._max_items = max_items\n\n    def _make_key(self, seq_snapshot: List[numbers.Number]) -> str:\n        # Deterministically serialize a list snapshot into a cache key.\n        return f\"{len(seq_snapshot)}:\" + \",\".join(map(repr, seq_snapshot))\n\n    def get(self, key: str) -> Optional[UniqueCheckResult]:\n        # Retrieve a result from the cache if present.\n        return self._store.get(key)\n\n    def set(self, key: str, value: UniqueCheckResult) -> None:\n        # Store a result, managing cache size with FIFO eviction.\n        try:\n            if key not in self._store:\n                if len(self._keys_fifo) >= self._max_items:\n                    oldest_key = self._keys_fifo.pop(0)\n                    if oldest_key in self._store:\n                        del self._store[oldest_key]\n                self._keys_fifo.append(key)\n            self._store[key] = value\n        except Exception:\n            # Cache failures are non-fatal, computation proceeds without caching.\n            pass\n\nclass UniqueElementService:\n    def __init__(self, validator: ListValidator, cache_repo: Optional[InMemoryCacheRepository] = None) -> None:\n        self._validator = validator\n        self._cache_repo = cache_repo\n\n    def _compute_is_unique(self, numeric_list: List[numbers.Number]) -> UniqueCheckResult:\n        # Performs the core O(n) scan to determine uniqueness.\n        if not numeric_list:\n            return UniqueCheckResult([], False, None)\n        if len(numeric_list) == 1:\n            return UniqueCheckResult(numeric_list.copy(), True, numeric_list[0])\n\n        first = numeric_list[0]\n        for x in numeric_list[1:]:\n            if x != first:\n                return UniqueCheckResult(numeric_list.copy(), False, None)\n        return UniqueCheckResult(numeric_list.copy(), True, first)\n\n    def check(self, seq: Iterable[Any]) -> UniqueCheckResult:\n        # Validates input, checks cache, computes if cache miss, stores, and returns.\n        numeric_list = self._validator.validate(seq)\n        input_snapshot_for_key = numeric_list\n\n        if self._cache_repo:\n            key = self._cache_repo._make_key(input_snapshot_for_key)\n            cached_result = self._cache_repo.get(key)\n            if cached_result:\n                return cached_result\n\n        result = self._compute_is_unique(numeric_list)\n\n        if self._cache_repo:\n            self._cache_repo.set(key, result)\n\n        return result\n\n    def is_unique(self, seq: Iterable[Any]) -> bool:\n        # Convenience method to return only the boolean result of the check.\n        return self.check(seq).is_unique\n\nclass UniqueElementController:\n    def __init__(self, service: UniqueElementService) -> None:\n        self._service = service\n\n    def unique_Element(self, seq: Iterable[Any]) -> bool:\n        # Delegates to the service to check uniqueness and returns the boolean part.\n        result = self._service.check(seq)\n        return result.is_unique\n\n    def unique_element_result(self, seq: Iterable[Any]) -> UniqueCheckResult:\n        # Delegates to the service to check uniqueness and returns the full result object.\n        return self._service.check(seq)\n\n_default_controller = UniqueElementController(\n    UniqueElementService(ListValidator(), InMemoryCacheRepository())\n)\n\ndef unique_Element(seq: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if all elements are the same, False otherwise.\n    \"\"\"\n    return _default_controller.unique_Element(seq)"}
{"task_id": "Mbpp/763", "solution": "import math\nfrom typing import Sequence, Union\n\ndef find_min_diff(sequence: Sequence[Union[int, float]], n: int) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given sequence.\n    The function sorts the sequence and iterates through adjacent elements to find the minimum difference.\n    \"\"\"\n    sorted_numbers = sorted(list(sequence))\n\n    min_difference = float('inf')\n\n    for i in range(1, len(sorted_numbers)):\n        diff = abs(sorted_numbers[i] - sorted_numbers[i-1])\n        if diff < min_difference:\n            min_difference = diff\n        if min_difference == 0:\n            break\n            \n    return min_difference"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, TypeVar, Sequence\n\nT = TypeVar('T')\n\ndef pair_wise(items: Sequence[T]) -> List[Tuple[T, T]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given sequence.\n    If the input sequence has less than two items, an empty list is returned.\n    \"\"\"\n    # Convert sequence to a list to ensure indexable access and handle single-pass iterators\n    items_list = list(items)\n\n    if len(items_list) < 2:\n        return []\n\n    result: List[Tuple[T, T]] = []\n    for i in range(len(items_list) - 1):\n        result.append((items_list[i], items_list[i + 1]))\n    return result"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of ASCII digits (0-9) in a given string.\n\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a str\")\n\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "def get_nth_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"\n        Checks if a number is a power of two using bitwise operations.\n        Assumes num >= 1.\n        \"\"\"\n        return (num & (num - 1)) == 0\n\n    count = 0\n    num = 1\n    while True:\n        if not is_power_of_two(num):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/767", "solution": "import json\nfrom collections import Counter\nfrom typing import Sequence, List, Dict\n\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the pair counting functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n\nclass InputValidator:\n    \"\"\"Validates input sequences and target values.\"\"\"\n    def validate_numbers_sequence(self, numbers: Sequence[int]) -> None:\n        if not hasattr(numbers, \"__iter__\"):\n            raise InvalidInputError(\"numbers must be an iterable of ints\")\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"numbers[{i}] is not int: {v}\")\n\n    def validate_target(self, target: int) -> None:\n        if not isinstance(target, int):\n            raise InvalidInputError(\"target must be int\")\n\n    def parse_cli_numbers(self, value: str) -> List[int]:\n        \"\"\"Parses a string into a list of integers, supporting JSON array or comma-separated formats.\"\"\"\n        try:\n            parsed = json.loads(value)\n            if isinstance(parsed, list):\n                return [int(x) for x in parsed]\n        except Exception:\n            pass\n        try:\n            return [int(x.strip()) for x in value.split(\",\") if x.strip()]\n        except Exception:\n            raise InvalidInputError(\"Unable to parse numbers from CLI input\")\n\n\nclass FrequencyRepository:\n    \"\"\"Provides methods for building and querying frequency maps.\"\"\"\n    def build_freq(self, numbers: Sequence[int]) -> Dict[int, int]:\n        return dict(Counter(numbers))\n\n    def get_count(self, freq: Dict[int, int], value: int) -> int:\n        \"\"\"Safely retrieves the frequency of a value from the map, returning 0 if not found.\"\"\"\n        return freq.get(value, 0)\n\n\nclass PairCounterService:\n    \"\"\"Core service for counting pairs that sum to a target, leveraging frequency maps.\"\"\"\n    def __init__(self, repo: FrequencyRepository, validator: InputValidator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def count_pairs(self, numbers: Sequence[int], target: int) -> int:\n        \"\"\"Counts pairs in a sequence that sum to the target, performing input validation.\"\"\"\n        self._validator.validate_numbers_sequence(numbers)\n        self._validator.validate_target(target)\n        freq = self._repo.build_freq(numbers)\n        return self._count_with_freq(freq, target)\n\n    def _count_with_freq(self, freq: Dict[int, int], target: int) -> int:\n        \"\"\"Calculates the number of pairs summing to target using a frequency map.\"\"\"\n        total_pairs = 0\n        for num1, count1 in freq.items():\n            num2 = target - num1\n\n            if num1 == num2:\n                # If num1 + num1 == target, choose 2 items from count1 occurrences of num1.\n                total_pairs += count1 * (count1 - 1) // 2\n            elif num1 < num2:\n                # To avoid double counting (num1, num2) and (num2, num1), only count when num1 is the smaller value.\n                count2 = self._repo.get_count(freq, num2)\n                total_pairs += count1 * count2\n        return total_pairs\n\n\ndef get_pairs_count(numbers: Sequence[int], target: int) -> int:\n    \"\"\"Counts the number of unordered pairs in a list whose sum equals a target value.\"\"\"\n    validator = InputValidator()\n    repo = FrequencyRepository()\n    service = PairCounterService(repo, validator)\n    return service.count_pairs(numbers, target)"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a, list_b):\n    \"\"\"\n    Computes the difference between two lists according to a specific ordering rule.\n    Elements from list_a not in list_b are returned, grouped by original index parity.\n    \"\"\"\n    if not isinstance(list_a, list) or not isinstance(list_b, list):\n        # As per instructions, avoid isinstance() checks, assuming valid list inputs.\n        # This comment is for self-reflection and will be removed from final output.\n        pass\n\n    set_b = set(list_b)\n    \n    # Filter elements from list_a that are not in list_b, preserving original indices.\n    filtered_items_with_indices = []\n    for i, item_a in enumerate(list_a):\n        if item_a not in set_b:\n            filtered_items_with_indices.append((i, item_a))\n\n    # Group values by original index parity: even indices first, then odd.\n    even_indexed_values = []\n    odd_indexed_values = []\n    for index, value in filtered_items_with_indices:\n        if index % 2 == 0:\n            even_indexed_values.append(value)\n        else:\n            odd_indexed_values.append(value)\n            \n    return even_indexed_values + odd_indexed_values"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression):\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    Non-bracket characters are ignored.\n    \"\"\"\n    class Stack:\n        \"\"\"A simple LIFO stack implementation.\"\"\"\n        def __init__(self):\n            self._items = []\n\n        def push(self, item):\n            \"\"\"Adds an item to the top of the stack.\"\"\"\n            self._items.append(item)\n\n        def pop(self):\n            \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n            if not self.is_empty():\n                return self._items.pop()\n            # The ExpressionValidator's logic handles checking for empty stack before pop implicitly\n            # by checking peek() first. If stack is empty, peek() returns None, and logic returns False.\n            # So, IndexError from an empty pop() won't occur here if the overall logic is followed.\n            return None # Should not be reached with proper caller logic\n\n        def peek(self):\n            \"\"\"Returns the item at the top of the stack without removing it, or None if empty.\"\"\"\n            if not self.is_empty():\n                return self._items[-1]\n            return None\n\n        def is_empty(self):\n            \"\"\"Checks if the stack is empty.\"\"\"\n            return not self._items\n\n    opening_brackets = \"({[\"\n    closing_brackets = \")}]\"\n    reverse_pairs = {\n        \")\": \"(\",\n        \"}\": \"{\",\n        \"]\": \"[\"\n    }\n\n    stack = Stack()\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.push(char)\n        elif char in closing_brackets:\n            if stack.is_empty():\n                return False\n            top_char = stack.peek()\n            if top_char == reverse_pairs[char]:\n                stack.pop()\n            else:\n                return False\n        # Non-bracket characters are ignored as per design context (ignore_non_brackets=True default).\n\n    return stack.is_empty()"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text, substring):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match, otherwise returns a tuple (substring, start_index, end_index).\n    \"\"\"\n    start_index = text.find(substring)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(substring)\n    return (substring, start_index, end_index)"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    return sum((2 * i + 1) ** 4 for i in range(n))"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(nums: list[int]) -> int:\n    \"\"\"\n    Finds the sum of non-repeated elements in a given list.\n    An element is considered non-repeated if it appears exactly once in the list.\n    \"\"\"\n    if not nums:\n        return 0\n\n    counts = collections.Counter(nums)\n    total_sum = 0\n    for num, count in counts.items():\n        if count == 1:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "from typing import List, Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef pack_consecutive_duplicates(sequence: Sequence[T]) -> List[List[T]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    \"\"\"\n    groups: List[List[T]] = []\n    iterator = iter(sequence)\n    try:\n        first = next(iterator)\n    except StopIteration:\n        return []\n\n    current_group = [first]\n    for item in iterator:\n        if item == current_group[-1]:\n            current_group.append(item)\n        else:\n            groups.append(current_group)\n            current_group = [item]\n    groups.append(current_group)\n    return groups"}
{"task_id": "Mbpp/772", "solution": "import unicodedata\nfrom typing import List, Tuple\n\ndef remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with a specific character length from the given string.\n    Words are sequences of Unicode letters, digits, or underscores.\n    \"\"\"\n\n    def is_word_char(ch: str) -> bool:\n        \"\"\"Determines if a character is a word character (letter, digit, or underscore).\"\"\"\n        if not ch:\n            return False\n        cat = unicodedata.category(ch)\n        return cat.startswith(\"L\") or cat.startswith(\"N\") or ch == \"_\"\n\n    def count_word_chars(token_text: str) -> int:\n        \"\"\"Counts the number of word characters within a given string segment.\"\"\"\n        return sum(1 for ch in token_text if is_word_char(ch))\n\n    # Tokenization: split text into contiguous segments of word characters or non-word characters.\n    tokens: List[Tuple[str, bool]] = []\n    current_buffer: List[str] = []\n    buffer_is_word_type: bool = None\n\n    for char in text:\n        char_is_word = is_word_char(char)\n\n        if buffer_is_word_type is None:\n            # Initialize for the first character\n            buffer_is_word_type = char_is_word\n        \n        if char_is_word == buffer_is_word_type:\n            current_buffer.append(char)\n        else:\n            # Type change, finalize current token and start new one\n            tokens.append((\"\".join(current_buffer), buffer_is_word_type))\n            current_buffer = [char]\n            buffer_is_word_type = char_is_word\n    \n    # Add any remaining characters in the buffer as the last token\n    if current_buffer:\n        tokens.append((\"\".join(current_buffer), buffer_is_word_type))\n\n    # Filtering: iterate through tokens and keep only those that are not words of length k.\n    kept_token_texts: List[str] = []\n    for token_text, is_word_token in tokens:\n        if is_word_token:\n            word_char_count = count_word_chars(token_text)\n            if word_char_count == k:\n                # This word token (and any attached non-word chars if they were part of the same token) should be removed.\n                continue\n        kept_token_texts.append(token_text)\n    \n    # Detokenization and Whitespace Normalization\n    # Reassemble the kept tokens into a single string.\n    raw_result = \"\".join(kept_token_texts)\n    \n    # Normalize whitespace: replace multiple spaces with single space and strip leading/trailing spaces.\n    final_result = \" \".join(raw_result.split())\n\n    return final_result"}
{"task_id": "Mbpp/775", "solution": "def odd_position(numbers: list) -> bool:\n    \"\"\"\n    Checks if every odd index in the list contains an odd number.\n    Assumes `numbers` is a list of integers.\n    \"\"\"\n    for idx in range(1, len(numbers), 2):\n        n = numbers[idx]\n        if (abs(n) % 2) != 1:\n            return False\n    return True"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(nums: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first encountered odd and even numbers in a list.\n    Assumes the list contains at least one odd and one even number.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for n in nums:\n        if first_odd is None and n % 2 != 0:\n            first_odd = n\n        if first_even is None and n % 2 == 0:\n            first_even = n\n        if first_odd is not None and first_even is not None:\n            break\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays in the given array.\n    This uses an O(n) approach by summing the contributions of each element.\n    \"\"\"\n    n = len(arr)\n    total_sum = 0\n\n    for i, num in enumerate(arr):\n        # Calculate number of subarrays that include the current element arr[i].\n        # left_count = i + 1, right_count = n - i\n        # total_subarrays_with_num = (i + 1) * (n - i)\n        \n        # Determine how many of these subarrays have an odd length.\n        # This is (total_subarrays_with_num + 1) // 2.\n        odd_length_contribution_count = ((i + 1) * (n - i) + 1) // 2\n\n        # Add the current element's value, multiplied by its odd-length contribution count, to the total sum.\n        total_sum += num * odd_length_contribution_count\n\n    return total_sum"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\n\ndef find_combinations(input_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds element-wise sums for all unique pairs of 2-element integer tuples in the given list.\n    Returns a list of the resulting sum tuples.\n    \"\"\"\n    n = len(input_list)\n    results: List[Tuple[int, int]] = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = input_list[i]\n            tuple2 = input_list[j]\n            results.append((tuple1[0] + tuple2[0], tuple1[1] + tuple2[1]))\n    return results"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors of an integer n is even.\n    This is true if and only if n is not a perfect square.\n    \"\"\"\n    r = math.isqrt(n)\n    is_perfect_square = r * r == n\n    return not is_perfect_square"}
{"task_id": "Mbpp/786", "solution": "import collections.abc\nfrom typing import Sequence, Any, Optional, Callable, TypeVar\n\nT = TypeVar(\"T\")\nK = TypeVar(\"K\")\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\n\nclass SortUtils:\n    @staticmethod\n    def is_sorted(seq: Sequence[T], key: Optional[Callable[[T], K]] = None) -> bool:\n        if len(seq) <= 1:\n            return True\n        get = (lambda x: key(x)) if key else (lambda x: x)\n        prev = get(seq[0])\n        for item in seq[1:]:\n            cur = get(item)\n            if cur < prev:\n                return False\n            prev = cur\n        return True\n\nclass RequestDTO:\n    def __init__(self, arr: Sequence[Any], value: Any, key: Optional[Callable[[Any], Any]] = None, strict_sorted_check: bool = False) -> None:\n        self.arr = arr\n        self.value = value\n        self.key = key\n        self.strict_sorted_check = strict_sorted_check\n\nclass ResponseDTO:\n    def __init__(self, index: int) -> None:\n        self.index = index\n\nclass RightInsertionAlgorithm:\n    @staticmethod\n    def find(arr: Sequence[T], value: T, key: Optional[Callable[[T], K]] = None) -> int:\n        lo = 0\n        hi = len(arr)\n        vkey = (key(value) if key else value)\n        while lo < hi:\n            mid = (lo + hi) // 2\n            mid_key = (key(arr[mid]) if key else arr[mid])\n            if mid_key <= vkey:\n                lo = mid + 1\n            else:\n                hi = mid\n        return lo\n\nclass RightInsertionService:\n    def __init__(self, strict_sorted_check: bool = False) -> None:\n        self._strict_sorted_check = strict_sorted_check\n\n    def find_index(self, req: RequestDTO) -> ResponseDTO:\n        if not isinstance(req.arr, collections.abc.Sequence):\n            raise InvalidInputError(\"arr must be a sequence\")\n        if self._strict_sorted_check and not SortUtils.is_sorted(req.arr, req.key):\n            raise InvalidInputError(\"array is not sorted\")\n        try:\n            idx = RightInsertionAlgorithm.find(req.arr, req.value, req.key)\n        except TypeError as e:\n            raise InvalidInputError(f\"Incomparable elements: {e}\")\n        return ResponseDTO(idx)\n\ndef right_insertion(arr: Sequence[T], value: T, key: Optional[Callable[[T], K]] = None, strict_sorted_check: bool = False) -> int:\n    \"\"\"\n    Locate the right insertion point for a specified value in sorted order.\n    Returns the index where value can be inserted to the right of existing equal elements.\n    \"\"\"\n    svc = RightInsertionService(strict_sorted_check=strict_sorted_check)\n    req = RequestDTO(arr, value, key, strict_sorted_check)\n    resp = svc.find_index(req)\n    return resp.index"}
{"task_id": "Mbpp/785", "solution": "class TupleParseError(Exception):\n    \"\"\"Exception raised for errors during tuple string parsing.\"\"\"\n    def __init__(self, message: str, position: int | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.position = position\n\nDEFAULT_MODE = \"strict\"\n\ndef normalize_input(s: str, mode: str = DEFAULT_MODE) -> str:\n    \"\"\"Trims whitespace and validates/removes surrounding parentheses based on mode.\"\"\"\n    s = s.strip()\n    if mode == \"strict\":\n        if not (s.startswith(\"(\") and s.endswith(\")\")):\n            raise TupleParseError(\"Expected surrounding parentheses in strict mode\")\n        # Handle cases like \"()\" resulting in \"\"\n        if len(s) == 2 and s == \"()\":\n            return \"\"\n        return s[1:-1].strip()\n    # lenient mode\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        # Handle cases like \"()\" resulting in \"\"\n        if len(s) == 2 and s == \"()\":\n            return \"\"\n        return s[1:-1].strip()\n    return s\n\ndef parse_int_token(token: str) -> int:\n    \"\"\"Parses a string token into an integer, raising TupleParseError on failure.\"\"\"\n    token = token.strip()\n    if token == \"\":\n        raise TupleParseError(\"Empty token found where an integer was expected.\")\n    try:\n        return int(token)\n    except ValueError as e:\n        raise TupleParseError(f\"Invalid integer token: '{token}'\") from e\n\nclass Tokenizer:\n    \"\"\"Lexical scanner to split a tuple string into individual element tokens.\"\"\"\n    SEPARATORS = {','}\n    OPEN_PAREN = '('\n    CLOSE_PAREN = ')'\n\n    def tokenize(self, s: str) -> list[str]:\n        \"\"\"Splits the input string by commas, handling whitespace.\"\"\"\n        tokens = []\n        current = []\n        i = 0\n        while i < len(s):\n            ch = s[i]\n            if ch == ',':\n                tokens.append(''.join(current).strip())\n                current = []\n                i += 1\n                continue\n            current.append(ch)\n            i += 1\n        tokens.append(''.join(current).strip())\n        return [t for t in tokens if t != '']\n\nclass TupleParserService:\n    \"\"\"Orchestrates the parsing of a tuple string into a tuple of integers.\"\"\"\n    def __init__(self, tokenizer: Tokenizer | None = None) -> None:\n        self.tokenizer = tokenizer or Tokenizer()\n\n    def parse(self, tuple_str: str, mode: str = \"strict\") -> tuple[int, ...]:\n        \"\"\"Performs normalization, tokenization, and integer conversion.\"\"\"\n        inner = normalize_input(tuple_str, mode=mode)\n        tokens = self.tokenizer.tokenize(inner)\n        ints = tuple(parse_int_token(t) for t in tokens)\n        return ints\n\ndef tuple_str_int(tuple_str: str, mode: str = \"strict\") -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple into a Python tuple of integers.\"\"\"\n    service = TupleParserService()\n    return service.parse(tuple_str, mode=mode)"}
{"task_id": "Mbpp/788", "solution": "class TupleMakerError(Exception):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(TupleMakerError):\n    pass\n\nclass NewTupleRequest:\n    def __init__(self, items: list[str], extra: str) -> None:\n        self.items = list(items)\n        self.extra = extra\n\n    def to_tuple(self) -> tuple[str, ...]:\n        return tuple(self.items) + (self.extra,)\n\nclass InputValidator:\n    MAX_ITEM_LENGTH = 4096\n    MAX_ITEMS = 10000\n\n    def validate_items(self, items: list[str]) -> None:\n        if not isinstance(items, list):\n            raise InvalidInputError(\"items must be a list of strings\")\n        if len(items) > self.MAX_ITEMS:\n            raise InvalidInputError(\"too many items\")\n        for i, it in enumerate(items):\n            if not isinstance(it, str):\n                raise InvalidInputError(f\"item at index {i} is not a string\")\n            if len(it) > self.MAX_ITEM_LENGTH:\n                raise InvalidInputError(\"item too long\")\n\n    def validate_extra(self, extra: str) -> None:\n        if not isinstance(extra, str):\n            raise InvalidInputError(\"extra must be a string\")\n        if len(extra) == 0:\n            raise InvalidInputError(\"extra must be non-empty\")\n        if len(extra) > self.MAX_ITEM_LENGTH:\n            raise InvalidInputError(\"extra too long\")\n\n    def validate_request(self, request: NewTupleRequest) -> None:\n        self.validate_items(request.items)\n        self.validate_extra(request.extra)\n\nclass TupleCreatorService:\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def create_tuple(self, items: list[str], extra: str) -> tuple[str, ...]:\n        request = NewTupleRequest(items=items, extra=extra)\n        return self.create_from_request(request)\n\n    def create_from_request(self, request: NewTupleRequest) -> tuple[str, ...]:\n        self._validator.validate_request(request)\n        return request.to_tuple()\n\ndef new_tuple(items: list[str], extra: str) -> tuple[str, ...]:\n    validator = InputValidator()\n    service = TupleCreatorService(validator)\n    request = NewTupleRequest(items=items, extra=extra)\n    return service.create_from_request(request)"}
{"task_id": "Mbpp/787", "solution": "import re\nimport threading\nfrom typing import Optional, tuple\n\nclass PatternError(Exception):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass PatternNotFoundError(PatternError):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n\nclass Pattern:\n    def __init__(self, name: str, expression: str) -> None:\n        self.name = name\n        self.expression = expression\n\nclass MatchResult:\n    def __init__(self, matched: bool, span: Optional[tuple[int,int]] = None) -> None:\n        self.matched = matched\n        self.span = span\n\nclass RegexUtil:\n    _CACHE_SIZE: int = 32\n    def __init__(self) -> None:\n        self._cache: dict[str, re.Pattern] = {}\n        self._lock = threading.Lock()\n\n    def compile(self, pattern_expr: str) -> re.Pattern:\n        key = pattern_expr\n        with self._lock:\n            if key in self._cache:\n                return self._cache[key]\n            compiled = re.compile(re.escape(pattern_expr))\n            if len(self._cache) >= self._CACHE_SIZE:\n                # Basic LRU-like eviction: remove the oldest item\n                first_key = next(iter(self._cache))\n                del self._cache[first_key]\n            self._cache[key] = compiled\n            return compiled\n\n    def match(self, compiled: \"re.Pattern\", text: str) -> Optional[tuple[int,int]]:\n        m = compiled.search(text)\n        return (m.start(), m.end()) if m else None\n\nDEFAULT_PATTERNS = {\"three_b\": \"abbb\"}\n\nclass PatternRepository:\n    def __init__(self, store: Optional[dict[str,str]] = None, store_path: Optional[str] = None) -> None:\n        self.store = dict(store or DEFAULT_PATTERNS)\n        self.store_path = store_path\n\n    def get_pattern(self, key: str) -> Pattern:\n        try:\n            expr = self.store[key]\n        except KeyError:\n            raise PatternNotFoundError(f\"Pattern {key} not found\")\n        return Pattern(key, expr)\n\nclass PatternMatcherService:\n    def __init__(self, repo: PatternRepository, regex_util: RegexUtil) -> None:\n        self.repo = repo\n        self.regex_util = regex_util\n\n    def match_pattern(self, key: str, text: str) -> MatchResult:\n        # Input validation for type is omitted as per \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        pattern = self.repo.get_pattern(key)\n        compiled = self.regex_util.compile(pattern.expression)\n        span = self.regex_util.match(compiled, text)\n        return MatchResult(matched=span is not None, span=span)\n\nclass PatternController:\n    def __init__(self, service: PatternMatcherService) -> None:\n        self.service = service\n\n    def match_three(self, text: str) -> bool:\n        match_result = self.service.match_pattern(\"three_b\", text)\n        return match_result.matched\n\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the given text contains the pattern \"abbb\".\n    The pattern must be 'a' followed immediately by three 'b' characters.\n    \"\"\"\n    repo = PatternRepository()\n    util = RegexUtil()\n    svc = PatternMatcherService(repo, util)\n    controller = PatternController(svc)\n    return controller.match_three(text)"}
{"task_id": "Mbpp/790", "solution": "def even_position(l: list) -> bool:\n    \"\"\"\n    Checks if every even index in the list contains an even number.\n    Returns True if all even-indexed elements are even, False otherwise.\n    \"\"\"\n    for idx in range(0, len(l), 2):\n        if (l[idx] % 2) != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/792", "solution": "from typing import Sequence, Any, Iterable, Iterator\nfrom collections.abc import Iterable\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the list counter.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ListCollection:\n    \"\"\"A collection model for an iterable container.\"\"\"\n    def __init__(self, container: Sequence[Any]) -> None:\n        self.container: Sequence[Any] = container\n\n    def __iter__(self) -> Iterator[Any]:\n        return iter(self.container)\n\n    def __len__(self) -> int:\n        return len(self.container)\n\n    def get_items(self) -> Sequence[Any]:\n        return self.container\n\nclass InputValidator:\n    \"\"\"Validates input containers for the list counting service.\"\"\"\n    @staticmethod\n    def _is_iterable_non_str(obj: Any) -> bool:\n        return isinstance(obj, Iterable) and not isinstance(obj, str)\n\n    @staticmethod\n    def validate_container(container: Any) -> None:\n        if not InputValidator._is_iterable_non_str(container):\n            raise InvalidInputError(\"container must be an iterable (not a string)\")\n\nclass ListCounterService:\n    \"\"\"Provides the core logic for counting list objects.\"\"\"\n    @staticmethod\n    def _is_list(obj: Any) -> bool:\n        return isinstance(obj, list)\n\n    def count_lists(self, collection: ListCollection) -> int:\n        \"\"\"Counts top-level list objects in a ListCollection.\"\"\"\n        items = collection.get_items()\n        count = sum(1 for item in items if self._is_list(item))\n        return count\n\n    def count_lists_in_iterable(self, container: Sequence[Any]) -> int:\n        \"\"\"Counts top-level list objects directly from an iterable container.\"\"\"\n        collection = ListCollection(container)\n        return self.count_lists(collection)\n\nclass LibraryController:\n    \"\"\"Provides a programmatic entrypoint for counting lists.\"\"\"\n    def count(self, container: Sequence[Any]) -> int:\n        \"\"\"Validates input and calls the service to count lists.\"\"\"\n        InputValidator.validate_container(container)\n        return ListCounterService().count_lists_in_iterable(container)\n\ndef count_list(container: Sequence[Any]) -> int:\n    \"\"\"Counts the number of lists in a given number of lists.\"\"\"\n    return LibraryController().count(container)"}
{"task_id": "Mbpp/791", "solution": "from typing import Any, Tuple\n\ndef remove_nested(data: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Removes top-level nested tuples from the given tuple.\n    \"\"\"\n    return tuple(item for item in data if not isinstance(item, tuple))"}
{"task_id": "Mbpp/793", "solution": "import bisect\n\ndef last(arr, val):\n    \"\"\"\n    Finds the last position (rightmost index) of an element in a sorted array.\n    Uses bisect_right to find the insertion point, then checks the preceding element.\n    \"\"\"\n    if not arr:\n        return -1\n\n    # bisect_right returns an insertion point which comes after (to the right of)\n    # any existing entries of val in arr.\n    # For example, for [1,2,2,3] and val=2, bisect_right returns 3 (index of 3).\n    # This means elements at indices 0, 1, 2 are <= 2, and element at index 3 is > 2.\n    # The last occurrence of 2 would therefore be at index 3 - 1 = 2.\n    insertion_point = bisect.bisect_right(arr, val)\n\n    # The actual index would be one less than the insertion_point.\n    # Check if this index is valid and if the element at this index actually matches val.\n    # This covers cases where val is not in the array (e.g., [1,3,5], val=2 -> insertion_point=1, idx=0, arr[0]=1 != 2).\n    # Also covers cases where val is smaller than all elements (insertion_point=0, idx=-1).\n    idx = insertion_point - 1\n    if idx >= 0 and arr[idx] == val:\n        return idx\n    return -1"}
