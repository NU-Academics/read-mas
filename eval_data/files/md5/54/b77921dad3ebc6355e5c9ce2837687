{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Tuple, Set, Iterable, Any\n\nclass ProductError(Exception):\n    \"\"\"Base exception for product-related errors.\"\"\"\n    pass\n\nclass InvalidInputError(ProductError):\n    \"\"\"Raised when input parameters are invalid.\"\"\"\n    pass\n\nclass ProductComputationError(ProductError):\n    \"\"\"Raised when an error occurs during product computation.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Utility class for validating and parsing inputs.\"\"\"\n\n    @staticmethod\n    def validate_numeric_list(seq: Iterable[Any]) -> List[float]:\n        \"\"\"Ensures each element in the sequence is numeric and returns a list of floats.\"\"\"\n        if seq is None:\n            return []\n        result = []\n        for x in seq:\n            if isinstance(x, (int, float)):\n                result.append(float(x))\n            else:\n                try:\n                    s = str(x).strip()\n                    result.append(float(s))\n                except ValueError:\n                    raise InvalidInputError(f\"Non-numeric value encountered: {x}\")\n        return result\n\n    @staticmethod\n    def validate_k(k: int) -> int:\n        \"\"\"Ensures k is a positive integer.\"\"\"\n        if not isinstance(k, int) or k < 1:\n            raise InvalidInputError(\"k must be an integer >= 1\")\n        return k\n\nclass ProductRepository:\n    \"\"\"Normalizes arbitrary iterables into lists of numbers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def normalize(self, seq: Iterable[Any]) -> List[float]:\n        \"\"\"Converts an iterable to a list of floats, validating each element.\"\"\"\n        return InputValidator.validate_numeric_list(seq)\n\nclass ProductCalculator:\n    \"\"\"Efficiently computes the top-k largest products from two lists.\"\"\"\n\n    def __init__(self, allow_duplicates: bool = True) -> None:\n        self.allow_duplicates = allow_duplicates\n\n    def compute_top_k(self, a: List[float], b: List[float], k: int) -> List[float]:\n        \"\"\"Public entry to compute top-k products, handling edge cases for empty lists.\"\"\"\n        if not a or not b:\n            return []\n        InputValidator.validate_k(k)\n        try:\n            return self._compute_top_k_heap(a, b, k)\n        except Exception as exc:\n            raise ProductComputationError(str(exc))\n\n    def _compute_top_k_heap(self, a: List[float], b: List[float], k: int) -> List[float]:\n        \"\"\"Implements the efficient heap-based algorithm to find top-k products.\"\"\"\n        a_sorted = sorted(a, reverse=True)\n        b_sorted = sorted(b, reverse=True)\n\n        n, m = len(a_sorted), len(b_sorted)\n\n        visited: Set[Tuple[int, int]] = set()\n        heap: List[Tuple[float, int, int]] = []\n        results: List[float] = []\n        seen_values: Set[float] = set()\n\n        if n > 0 and m > 0:\n            heapq.heappush(heap, (-(a_sorted[0] * b_sorted[0]), 0, 0))\n            visited.add((0, 0))\n\n        while heap and len(results) < k:\n            prod_neg, i, j = heapq.heappop(heap)\n            val = -prod_neg\n\n            if self.allow_duplicates or val not in seen_values:\n                results.append(val)\n                seen_values.add(val)\n\n            if i + 1 < n and (i + 1, j) not in visited:\n                heapq.heappush(heap, (-(a_sorted[i+1] * b_sorted[j]), i + 1, j))\n                visited.add((i + 1, j))\n\n            if j + 1 < m and (i, j + 1) not in visited:\n                heapq.heappush(heap, (-(a_sorted[i] * b_sorted[j+1]), i, j + 1))\n                visited.add((i, j + 1))\n        \n        return results\n\ndef large_product(list1: Iterable[float], list2: Iterable[float], k: int, unique: bool = False) -> List[float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    repo = ProductRepository()\n    a = repo.normalize(list1)\n    b = repo.normalize(list2)\n    calc = ProductCalculator(allow_duplicates=not unique)\n    return calc.compute_top_k(a, b, k)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the most significant unset bit in a non-negative integer.\"\"\"\n\n    def _msb_index(num: int) -> int:\n        \"\"\"Returns the index of the most significant set bit, or 0 if num is 0.\"\"\"\n        return num.bit_length() - 1 if num != 0 else 0\n\n    msb = _msb_index(n)\n    leftmost_unset_idx = -1\n\n    # Iterate from the most significant bit down to 0 to find the first unset bit.\n    for i in range(msb, -1, -1):\n        if not (n >> i) & 1:  # Check if the i-th bit is 0\n            leftmost_unset_idx = i\n            break\n    \n    # If all bits up to the current MSB are set, the next higher bit is the leftmost unset bit.\n    if leftmost_unset_idx == -1:\n        leftmost_unset_idx = msb + 1\n\n    # Set the identified bit using a bitwise OR operation.\n    return n | (1 << leftmost_unset_idx)"}
{"task_id": "Mbpp/310", "solution": "from typing import Any, Tuple, Optional, Protocol\n\nclass ConversionError(Exception):\n    \"\"\"Base exception for conversion-related errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidInputError(ConversionError, TypeError):\n    \"\"\"Raised when the input type is invalid.\"\"\"\n    pass\n\ndef validate_input(s: Any) -> None:\n    \"\"\"Validates that the input is a string.\"\"\"\n    if not isinstance(s, str):\n        raise InvalidInputError(\"Input must be a str\")\n\nclass CharRepository(Protocol):\n    \"\"\"Protocol for character repositories.\"\"\"\n    def save(self, chars: Tuple[str, ...]) -> None: ...\n    def last(self) -> Optional[Tuple[str, ...]]: ...\n\nclass InMemoryCharRepository:\n    \"\"\"In-memory implementation of CharRepository.\"\"\"\n    def __init__(self):\n        self._storage = None\n    def save(self, chars: Tuple[str, ...]):\n        self._storage = chars\n    def last(self) -> Optional[Tuple[str, ...]]:\n        return self._storage\n\nclass StringConverter:\n    \"\"\"Converts a string to a tuple of characters and can store the result.\"\"\"\n    def __init__(self, repo: CharRepository):\n        self._repo = repo\n    def convert(self, s: str) -> Tuple[str, ...]:\n        validate_input(s)\n        return tuple(s)\n    def convert_and_store(self, s: str) -> Tuple[str, ...]:\n        chars = self.convert(s)\n        self._repo.save(chars)\n        return chars\n\ndef string_to_tuple(s: str) -> Tuple[str, ...]:\n    \"\"\"\n    Converts a given string to a tuple of its characters.\n    \"\"\"\n    repo = InMemoryCharRepository()\n    converter = StringConverter(repo)\n    return converter.convert(s)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a right circular cone given its radius and height.\n    \"\"\"\n    if radius < 0 or height < 0:\n        # Per design, assume validation happens upstream or handle defensively\n        # here if not specifically excluded. The prompt says \"DO NOT add ... raise exceptions for edge cases\",\n        # so for this function, we'll proceed assuming valid non-negative inputs or\n        # default to returning 0 for invalid negative inputs to avoid raising an error.\n        # However, the design context explicitly states to raise errors for negative values.\n        # Given the \"DO NOT raise exceptions\" constraint, the most compliant path\n        # without external validation or custom error classes is to ensure the formula\n        # works for non-negative and handle zero cases as specified.\n        # For a direct calculation, we assume valid inputs as per assert example.\n        pass # The design context implies validation and error raising via ValidationUtils/VolumeError,\n             # but the prompt specifically forbids adding such logic or external helpers.\n\n    # Business rule: Zero radius or zero height yields volume 0.0.\n    if radius == 0 or height == 0:\n        return 0.0\n\n    # Volume formula for a cone: (1/3) * pi * radius^2 * height\n    volume = (1.0 / 3.0) * math.pi * (radius ** 2) * height\n    return volume"}
