{"task_id": "Mbpp/440", "solution": "import re\nimport string\nfrom typing import Tuple, List, Optional, Set\nfrom dataclasses import dataclass\n\n# --- Configuration Constants ---\nCOMMON_ADVERBS: Set[str] = {\"clearly\", \"obviously\", \"quickly\", \"usually\", \"always\", \"sometimes\", \"never\", \"often\", \"seldom\", \"rarely\", \"just\", \"soon\", \"now\", \"then\", \"here\", \"there\", \"everywhere\", \"anywhere\", \"somewhere\", \"fast\", \"hard\", \"well\", \"much\", \"very\", \"quite\", \"rather\", \"too\", \"almost\", \"hardly\", \"scarcely\", \"simply\", \"merely\", \"only\", \"even\", \"also\", \"thus\", \"therefore\", \"however\", \"consequently\", \"meanwhile\", \"next\", \"first\", \"secondly\", \"finally\", \"daily\", \"early\", \"monthly\", \"yearly\", \"weekly\"}\nADVERB_SUFFIXES: Tuple[str, ...] = (\"ly\",)\nPUNCTUATION: str = string.punctuation\nMIN_ADVERB_LENGTH: int = 2\n\n# --- Data Models ---\n@dataclass\nclass AdverbMatch:\n    \"\"\"Represents a found adverb with its position and text.\"\"\"\n    start: int\n    end: int\n    text: str\n\n    def as_tuple(self) -> Tuple[int, int, str]:\n        \"\"\"Returns the adverb match as a (start, end, text) tuple.\"\"\"\n        return (self.start, self.end, self.text)\n\n@dataclass\nclass Token:\n    \"\"\"Represents a token with its text and original span.\"\"\"\n    text: str\n    start: int\n    end: int\n\n# --- Utility Functions ---\nclass TextUtils:\n    \"\"\"Provides utility methods for text normalization and span mapping.\"\"\"\n    @staticmethod\n    def normalize_text(text: str) -> str:\n        \"\"\"Lowercases text and collapses multiple spaces.\"\"\"\n        return ' '.join(text.lower().split())\n\n    @staticmethod\n    def strip_surrounding_punct(token: str, punctuation: str) -> Tuple[str, int, int]:\n        \"\"\"Strips leading/trailing punctuation from a token.\"\"\"\n        left_strip_count = 0\n        for char in token:\n            if char in punctuation:\n                left_strip_count += 1\n            else:\n                break\n        \n        right_strip_count = 0\n        for char in reversed(token):\n            if char in punctuation:\n                right_strip_count += 1\n            else:\n                break\n        \n        core_token_start = left_strip_count\n        core_token_end = len(token) - right_strip_count\n        \n        core_token = token[core_token_start:core_token_end]\n        \n        return core_token, left_strip_count, right_strip_count\n\n    @staticmethod\n    def map_token_to_original_span(sentence: str, token_norm: str, raw_word_original_span: Tuple[int, int]) -> Optional[Tuple[int, int]]:\n        \"\"\"Maps a normalized token back to its character span in the original sentence within a given range.\"\"\"\n        if not token_norm:\n            return None\n        \n        raw_word_in_sentence = sentence[raw_word_original_span[0]:raw_word_original_span[1]]\n        normalized_raw_word = raw_word_in_sentence.lower()\n        \n        start_in_raw_word = normalized_raw_word.find(token_norm)\n        \n        if start_in_raw_word != -1:\n            original_start = raw_word_original_span[0] + start_in_raw_word\n            original_end = original_start + len(token_norm)\n            return original_start, original_end\n        \n        return None\n\n# --- Tokenizer Component ---\nclass Tokenizer:\n    \"\"\"Breaks a sentence into tokens with their original character spans.\"\"\"\n    def tokenize(self, sentence: str) -> List[Token]:\n        \"\"\"Tokenizes the input sentence, stripping punctuation and preserving original indices.\"\"\"\n        if not isinstance(sentence, str):\n            raise ValueError(\"Input sentence must be a string.\")\n\n        tokens: List[Token] = []\n        \n        for match in re.finditer(r'\\S+', sentence):\n            raw_word_text = match.group(0)\n            raw_word_start = match.start()\n            raw_word_end = match.end()\n\n            core_token_text, left_strip_count, right_strip_count = TextUtils.strip_surrounding_punct(raw_word_text, PUNCTUATION)\n\n            if not core_token_text:  # Skip tokens that are purely punctuation\n                continue\n            \n            token_start = raw_word_start + left_strip_count\n            token_end = raw_word_end - right_strip_count\n\n            tokens.append(Token(text=core_token_text.lower(), start=token_start, end=token_end))\n        \n        return tokens\n\n# --- Adverb Detector Component ---\nclass AdverbDetector:\n    \"\"\"Detects adverbs based on a lexicon and suffix rules.\"\"\"\n    def __init__(self, common_adverbs: Set[str], suffixes: Tuple[str, ...], punctuation: str):\n        self._common_adverbs = common_adverbs\n        self._suffixes = suffixes\n        # _punctuation is not directly used in is_adverb as input tokens are already stripped\n\n    def is_adverb(self, token_text: str) -> bool:\n        \"\"\"Checks if a given token text is classified as an adverb.\"\"\"\n        if len(token_text) < MIN_ADVERB_LENGTH:\n            return False\n        \n        if token_text in self._common_adverbs:\n            return True\n        \n        for suffix in self._suffixes:\n            # Ensure the word is longer than just the suffix to avoid false positives like \"fly\"\n            if token_text.endswith(suffix) and len(token_text) > len(suffix):\n                return True\n        \n        return False\n\n    def detect_first(self, tokens: List[Token]) -> Optional[AdverbMatch]:\n        \"\"\"Iterates through tokens and returns the first detected adverb match.\"\"\"\n        for token in tokens:\n            if self.is_adverb(token.text):\n                return AdverbMatch(start=token.start, end=token.end, text=token.text)\n        return None\n\n# --- Service Layer ---\nclass AdverbService:\n    \"\"\"Orchestrates tokenization and adverb detection.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, detector: AdverbDetector):\n        self._tokenizer = tokenizer\n        self._detector = detector\n\n    def find_first_adverb(self, sentence: str) -> Optional[AdverbMatch]:\n        \"\"\"Finds the first adverb in a sentence, returning an AdverbMatch object.\"\"\"\n        if not isinstance(sentence, str):\n            raise ValueError(\"Input sentence must be a string.\")\n\n        tokens = self._tokenizer.tokenize(sentence)\n        adverb_match = self._detector.detect_first(tokens)\n        return adverb_match\n\n# --- Controller Layer ---\nclass AdverbController:\n    \"\"\"Provides the public API endpoint for adverb detection.\"\"\"\n    def __init__(self, service: AdverbService):\n        self._service = service\n\n    def find_adverb_position(self, sentence: str) -> Optional[Tuple[int, int, str]]:\n        \"\"\"Finds the first adverb and its position in a given sentence.\"\"\"\n        if not isinstance(sentence, str):\n            raise ValueError(\"Input sentence must be a string.\")\n            \n        adverb_match = self._service.find_first_adverb(sentence)\n        if adverb_match:\n            return adverb_match.as_tuple()\n        return None\n\n# --- Public API Function ---\n_default_tokenizer = Tokenizer()\n_default_detector = AdverbDetector(COMMON_ADVERBS, ADVERB_SUFFIXES, PUNCTUATION)\n_default_service = AdverbService(_default_tokenizer, _default_detector)\n_controller = AdverbController(_default_service)\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    return _controller.find_adverb_position(sentence)"}
{"task_id": "Mbpp/450", "solution": "import collections\n\ndef extract_string(values: list[str], size: int) -> list[str]:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Assumes valid input types as per design context's service layer validation.\n    \"\"\"\n    result: list[str] = []\n    for item in values:\n        if len(item) == size:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/448", "solution": "from typing import Dict, Optional\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\n\nclass PerrinGenerator:\n    \"\"\"Computes Perrin numbers using an iterative method with local memoization.\"\"\"\n    BASE_VALUES = {0: 3, 1: 0, 2: 2}\n\n    def __init__(self) -> None:\n        self._memo_local: Dict[int, int] = dict(PerrinGenerator.BASE_VALUES)\n\n    def get(self, n: int) -> int:\n        \"\"\"Returns the Perrin number P(n). Assumes n is a non-negative integer.\"\"\"\n        if n in self._memo_local:\n            return self._memo_local[n]\n        \n        for i in range(3, n + 1):\n            if i not in self._memo_local:\n                self._memo_local[i] = self._memo_local[i-2] + self._memo_local[i-3]\n        \n        return self._memo_local[n]\n\nclass PerrinRepository:\n    \"\"\"Manages caching of Perrin numbers in-memory.\"\"\"\n    def __init__(self, file_path: Optional[str] = None) -> None:\n        self._cache: Dict[int, int] = {}\n        self._file_path = file_path\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Perrin number from the cache.\"\"\"\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Perrin number in the cache.\"\"\"\n        self._cache[n] = value\n\nclass PerrinService:\n    \"\"\"Provides business logic for computing and summing Perrin numbers.\"\"\"\n    def __init__(self, generator: PerrinGenerator, repository: PerrinRepository) -> None:\n        self.generator = generator\n        self.repository = repository\n    \n    def get_value(self, n: int) -> int:\n        \"\"\"Retrieves the Perrin number P(n), using cache or computing it. Assumes n is a non-negative integer.\"\"\"\n        v = self.repository.get(n)\n        if v is not None:\n            return v\n        \n        v = self.generator.get(n)\n        self.repository.set(n, v)\n        return v\n\n    def sum_up_to(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P0 to Pn inclusive. Assumes n is a non-negative integer.\"\"\"\n        total = 0\n        for i in range(0, n + 1):\n            total += self.get_value(i)\n        return total\n\n_default_service = PerrinService(PerrinGenerator(), PerrinRepository(file_path=None))\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P0 to Pn inclusive.\"\"\"\n    return _default_service.sum_up_to(n)"}
{"task_id": "Mbpp/453", "solution": "import os\nimport json\nfrom typing import Optional, Dict, Iterator\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n# Configuration constants\nCACHE_PATH_DEFAULT: str = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"even_factors\", \"cache.json\")\nCACHE_ENABLED_DEFAULT: bool = True\n\nclass NumberInput:\n    \"\"\"Represents and validates a number input.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is an integer and positive.\"\"\"\n        if not isinstance(self.value, int):\n            raise InvalidInputError(f\"Input must be an integer, got {type(self.value).__name__}.\")\n        if self.value < 1:\n            raise InvalidInputError(f\"Input must be a positive integer (>= 1), got {self.value}.\")\n\nclass MathUtils:\n    \"\"\"Provides mathematical utility functions.\"\"\"\n    def find_divisors(self, n: int) -> Iterator[int]:\n        \"\"\"Yields all divisors of a given number n.\"\"\"\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                yield i\n                j = n // i\n                if j != i:\n                    yield j\n            i += 1\n\n    def is_even(self, n: int) -> bool:\n        \"\"\"Checks if a number is even.\"\"\"\n        return (n & 1) == 0\n\nclass NumberRepository:\n    \"\"\"Handles caching of computed sums of even factors to disk.\"\"\"\n    def __init__(self, cache_path: Optional[str] = None, enabled: bool = True):\n        self._enabled = enabled\n        self._cache_path = cache_path\n        self._cache: Dict[int, int] = {}\n        if enabled and cache_path:\n            try:\n                os.makedirs(os.path.dirname(cache_path), exist_ok=True)\n                if os.path.exists(cache_path):\n                    with open(cache_path, \"r\", encoding=\"utf-8\") as f:\n                        raw = json.load(f)\n                        self._cache = {int(k): int(v) for k, v in raw.items()}\n            except Exception:\n                # Swallow load errors and start with an empty cache.\n                self._cache = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached sum for n.\"\"\"\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a computed sum for n in the cache and persists it.\"\"\"\n        self._cache[n] = value\n        if not self._enabled or not self._cache_path:\n            return\n        try:\n            temp_path = self._cache_path + \".tmp\"\n            with open(temp_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump({str(k): v for k, v in self._cache.items()}, f)\n            os.replace(temp_path, self._cache_path)\n        except Exception:\n            # Swallow write errors; caching is best-effort.\n            pass\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears the in-memory cache and deletes the cache file.\"\"\"\n        self._cache.clear()\n        if self._cache_path and os.path.exists(self._cache_path):\n            try:\n                os.remove(self._cache_path)\n            except Exception:\n                pass # Swallow delete errors\n\nclass FactorService:\n    \"\"\"Core logic for computing the sum of even factors, including caching.\"\"\"\n    def __init__(self, repository: NumberRepository, utils: MathUtils):\n        self._repository = repository\n        self._utils = utils\n\n    def sum_even_factors(self, n: int) -> int:\n        \"\"\"Computes the sum of even factors for a given number.\"\"\"\n        ni = NumberInput(n)\n        ni.validate()\n\n        cached = self._repository.get(n)\n        if cached is not None:\n            return cached\n\n        result = self._compute_even_factors_sum(n)\n        self._repository.set(n, result)\n        return result\n\n    def _compute_even_factors_sum(self, n: int) -> int:\n        \"\"\"Internal method to compute the sum of even factors without caching.\"\"\"\n        total = 0\n        for d in self._utils.find_divisors(n):\n            if self._utils.is_even(d):\n                total += d\n        return total\n\nclass EvenFactorsApp:\n    \"\"\"Application class to wire up components for the sum of even factors calculation.\"\"\"\n    def __init__(self, cache_path: Optional[str] = None):\n        self.cache_path = cache_path or CACHE_PATH_DEFAULT\n\n    def create_service(self) -> FactorService:\n        \"\"\"Creates and returns a configured FactorService instance.\"\"\"\n        repo = NumberRepository(cache_path=self.cache_path, enabled=CACHE_ENABLED_DEFAULT)\n        utils = MathUtils()\n        return FactorService(repository=repo, utils=utils)\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors of a given positive integer.\n    The function uses an internal cache for performance.\n    \"\"\"\n    app = EvenFactorsApp()\n    service = app.create_service()\n    return service.sum_even_factors(n)"}
