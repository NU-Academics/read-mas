{"task_id": "Mbpp/572", "solution": "import collections\n\ndef two_unique_nums(numbers_list):\n    \"\"\"\n    Removes duplicate numbers from a single list, returning numbers that appear exactly once.\n    The order of the unique numbers in the output list is preserved based on their first appearance.\n    \"\"\"\n    counts = collections.Counter(numbers_list)\n    unique_numbers = [num for num in numbers_list if counts[num] == 1]\n    return unique_numbers"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(data: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists, ensuring the input is not mutated.\"\"\"\n    \n    # Helper function to create a new list for each inner list, preserving string references.\n    def deep_copy_list_of_lists(data_to_copy: List[List[str]]) -> List[List[str]]:\n        return [list(inner) for inner in data_to_copy]\n\n    # Helper function to return a new sorted list from a sublist.\n    def sort_single_sublist(sublist_to_sort: List[str]) -> List[str]:\n        return sorted(sublist_to_sort)\n\n    # Create a copy of the input structure to ensure the original data is not modified.\n    copied_data = deep_copy_list_of_lists(data)\n    \n    # Sort each sublist in the copied structure and return the new list of sorted sublists.\n    return [sort_single_sublist(sub) for sub in copied_data]"}
{"task_id": "Mbpp/573", "solution": "from typing import Iterable, Union\n\ndef unique_product(numbers: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Returns 1 for an empty list.\n    \"\"\"\n    unique_numbers_set = set(numbers)\n\n    if not unique_numbers_set:\n        return 1\n\n    product: Union[int, float] = 1\n    result_is_float = False\n\n    for num in unique_numbers_set:\n        if isinstance(num, float):\n            result_is_float = True\n        product *= num\n\n    return float(product) if result_is_float else product"}
