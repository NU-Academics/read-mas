{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Searches for an element in an array using a sequential search.\n    Returns a tuple (found: bool, index: int) indicating if the element\n    was found and its index, or -1 if not found.\n    \"\"\"\n    for idx, val in enumerate(array):\n        if val == element:\n            return (True, idx)\n    return (False, -1)"}
{"task_id": "Mbpp/281", "solution": "import collections\n\ndef all_unique(items):\n    \"\"\"\n    Checks if all elements in a list are unique.\n    Uses a set for hashable items for O(n) performance, falls back to O(n^2) for unhashable items.\n    \"\"\"\n    seen = set()\n    unhashable_items = []\n    \n    for item in items:\n        if isinstance(item, collections.abc.Hashable):\n            if item in seen:\n                return False\n            seen.add(item)\n        else:\n            # If the item is not hashable, add it to a separate list for O(n^2) comparison.\n            # We also need to check it against previously seen unhashable items.\n            for uh_item in unhashable_items:\n                if item == uh_item:\n                    return False\n            unhashable_items.append(item)\n            \n    # No duplicates found during iteration\n    return True"}
{"task_id": "Mbpp/284", "solution": "import collections.abc\nfrom typing import Any, Iterable\n\ndef check_element(items: Iterable[Any], target: Any) -> bool:\n    \"\"\"\n    Checks if all items in the list are equal to the given element.\n\n    An empty list is considered to have all items equal to the target (vacuously true).\n    \"\"\"\n    if not isinstance(items, collections.abc.Iterable) or isinstance(items, (str, bytes)):\n        raise TypeError(\"items must be an iterable (not a string or bytes) and not None\")\n\n    # The design context explicitly calls for converting to list for single-pass evaluation\n    # and to propagate InvalidInputError, but since we are not defining the ListValidator\n    # and InvalidInputError here, we simulate the validation and direct use of iterable.\n    # The requirement is to NOT add isinstance() checks or raise exceptions for edge cases\n    # that are typically handled by helper functions (like validate_iterable).\n    # However, the type hint for `items` is Iterable[Any], so we should iterate directly.\n    # The design context implies the check_element API will use the service layer,\n    # which performs the validation and conversion.\n    # For a standalone function, we iterate directly on `items`.\n\n    for item in items:\n        if item != target:\n            return False\n    return True"}
{"task_id": "Mbpp/285", "solution": "import re\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if the string contains the character 'a' followed by exactly two or three 'b' characters.\n    Uses regex to find patterns like 'abb' or 'abbb' anywhere in the input text.\n    \"\"\"\n    pattern = r'a(?:bb|bbb)'\n    return bool(re.search(pattern, text))"}
{"task_id": "Mbpp/282", "solution": "import json\nfrom typing import Any, List, Union\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when input is not a valid iterable of numbers or cannot be parsed.\"\"\"\n    pass\n\nclass LengthMismatchError(ValueError):\n    \"\"\"Raised when input lists have different lengths.\"\"\"\n    pass\n\nNumeric = Union[int, float]\n\ndef sub_list(a: Any, b: Any) -> List[float]:\n    \"\"\"\n    Subtracts two lists element-wise.\n    Inputs are validated for type and length, with elements converted to floats.\n    \"\"\"\n\n    def _parse_and_validate_list(data: Any) -> List[float]:\n        \"\"\"Parses and validates a single input argument, returning a list of floats.\"\"\"\n        if isinstance(data, str):\n            try:\n                parsed = json.loads(data)\n            except json.JSONDecodeError:\n                tokens = data.strip().split()\n                try:\n                    nums = [float(t) for t in tokens]\n                    return nums\n                except ValueError:\n                    raise InvalidInputError(\"String input is not a valid JSON array or space-separated numeric tokens\")\n            data = parsed\n        \n        if not hasattr(data, '__iter__') or isinstance(data, (str, bytes)):\n            raise InvalidInputError(\"Input must be an iterable of numbers\")\n\n        nums: List[float] = []\n        for item in data:\n            try:\n                nums.append(float(item))\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"Item {item!r} in input is not numeric\")\n        return nums\n\n    list_a = _parse_and_validate_list(a)\n    list_b = _parse_and_validate_list(b)\n\n    if len(list_a) != len(list_b):\n        raise LengthMismatchError(f\"Input lists must have equal length, but got {len(list_a)} and {len(list_b)}\")\n\n    result: List[float] = [x - y for x, y in zip(list_a, list_b)]\n    return result"}
{"task_id": "Mbpp/283", "solution": "import collections\n\ndef validate(number: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Digits are validated based on their absolute value; any occurrence of '0' makes the number invalid.\n    \"\"\"\n    s_number = str(abs(number))\n    digit_counts = collections.Counter(int(d) for d in s_number)\n\n    for digit, count in digit_counts.items():\n        if count > digit:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers.\n    This uses the closed-form formula: 4 * n * (n + 1) * (2 * n + 1) / 6.\n    \"\"\"\n    # The sum of squares of the first n even natural numbers is 4 * sum(k^2 for k=1 to n).\n    # The sum of squares of the first n natural numbers is n * (n + 1) * (2 * n + 1) / 6.\n    return (4 * n * (n + 1) * (2 * n + 1)) // 6"}
{"task_id": "Mbpp/290", "solution": "import collections.abc\nfrom typing import List, Any, Tuple\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\n\nclass ResultDTO:\n    def __init__(self, max_length: int, longest_list: List[Any]):\n        self.max_length = max_length\n        self.longest_list = longest_list\n\n    def to_tuple(self) -> Tuple[int, List[Any]]:\n        return (self.max_length, self.longest_list)\n\nclass Validator:\n    @staticmethod\n    def is_iterable(obj: Any) -> bool:\n        return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes))\n\n    @staticmethod\n    def normalize_outer(input_obj: Any) -> List[List[Any]]:\n        if input_obj is None:\n            raise InvalidInputError(\"Input is None\")\n        if not Validator.is_iterable(input_obj):\n            raise InvalidInputError(\"Outer input must be iterable (list of lists)\")\n        result = []\n        for idx, inner in enumerate(input_obj):\n            if not Validator.is_iterable(inner):\n                raise InvalidInputError(f\"Inner element at index {idx} is not iterable\")\n            result.append(list(inner))\n        return result\n\nclass MaxLengthService:\n    def find_max(self, list_of_lists: List[List[Any]]) -> ResultDTO:\n        if list_of_lists is None:\n            raise InvalidInputError(\"Input cannot be None\")\n        max_len, lst = self._compute(list_of_lists)\n        return ResultDTO(max_len, lst)\n\n    def _compute(self, list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n        max_len = 0\n        chosen = []\n        for inner in list_of_lists:\n            l = len(inner)\n            if l > max_len:\n                max_len = l\n                chosen = inner\n        return max_len, chosen\n\ndef max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the longest list.\n    \"\"\"\n    normalized = Validator.normalize_outer(list_of_lists)\n    svc = MaxLengthService()\n    result = svc.find_max(normalized)\n    return result.to_tuple()"}
{"task_id": "Mbpp/286", "solution": "import collections\nfrom typing import List\n\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by repeating the given array k times.\n    Applies Kadane's algorithm and prefix/suffix sums for efficient computation.\n    \"\"\"\n    \n    # Kadane's algorithm for a single array\n    def kadane(current_arr: List[int]) -> int:\n        max_ending_here = 0\n        max_so_far = float('-inf')\n        for x in current_arr:\n            max_ending_here += x\n            max_so_far = max(max_so_far, max_ending_here)\n            if max_ending_here < 0:\n                max_ending_here = 0\n        \n        # If all numbers are negative, Kadane's above would return 0.\n        # We need to return the largest single element in that case.\n        if max_so_far == 0 and any(x < 0 for x in current_arr):\n             return max(current_arr)\n        return max_so_far\n    \n    # Calculate sum of the original array\n    total_array_sum = sum(arr)\n    \n    # Calculate maximum prefix sum\n    max_prefix_sum = 0\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n    \n    # Calculate maximum suffix sum\n    max_suffix_sum = 0\n    current_suffix_sum = 0\n    for x in reversed(arr):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n        \n    # Case 1: k = 1. Just apply Kadane's algorithm to the original array.\n    if k == 1:\n        return kadane(arr)\n    \n    # Case 2: k > 1.\n    # The maximum subarray can be entirely within one of the original arrays,\n    # or span across multiple repetitions.\n    # Consider an array of two repetitions (arr + arr)\n    max_sum_two_arrays = kadane(arr + arr)\n    \n    # If the total sum of the array is positive, repeating it further might increase the sum.\n    # The max sum could be prefix_max + suffix_max + (k-2)*total_sum\n    if total_array_sum > 0:\n        return max(max_sum_two_arrays, max_prefix_sum + max_suffix_sum + (k - 2) * total_array_sum)\n    else:\n        # If total_array_sum is non-positive, repeating the array multiple times\n        # will not help. The maximum sum will be found within the first two repetitions.\n        return max_sum_two_arrays"}
