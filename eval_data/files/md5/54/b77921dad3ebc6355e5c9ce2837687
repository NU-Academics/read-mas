{"task_id": "Mbpp/725", "solution": "from typing import List, Any, Optional\nimport re\nfrom datetime import datetime, timezone\nimport uuid\n\nclass QuoteExtractionError(Exception):\n    \"\"\"Custom exception for quotation extraction errors.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\ndef safe_type_check(value: Any, expected: type) -> None:\n    \"\"\"Checks if a value is of the expected type, raising QuoteExtractionError if not.\"\"\"\n    if not isinstance(value, expected):\n        raise QuoteExtractionError(f\"Expected type {expected.__name__}, got {type(value).__name__}\")\n\ndef now_iso8601() -> str:\n    \"\"\"Returns the current UTC time in ISO8601 format.\"\"\"\n    return datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')\n\nclass ExtractionRecord:\n    \"\"\"Represents a record of an extraction event.\"\"\"\n    def __init__(self, id: str, timestamp: str, input_text: str, results: List[str]) -> None:\n        self.id = id\n        self.timestamp = timestamp\n        self.input_text = input_text\n        self.results = results\n\nclass ExtractionRepository:\n    \"\"\"In-memory repository for extraction records.\"\"\"\n    def __init__(self, persist_path: Optional[str] = None) -> None:\n        self._store: List[ExtractionRecord] = []\n        self.persist_path = persist_path\n    def save(self, record: ExtractionRecord) -> None:\n        \"\"\"Saves an extraction record to the store.\"\"\"\n        self._store.append(record)\n    def list_all(self) -> List[ExtractionRecord]:\n        \"\"\"Lists all stored extraction records.\"\"\"\n        return list(self._store)\n\nclass RegexPatterns:\n    \"\"\"Centralizes regex patterns for parsing.\"\"\"\n    DEFAULT_DOUBLE_QUOTE_PATTERN = r'(?s)(?<!\\\\)\"((?:\\\\.|[^\"\\\\])*)\"'\n    @classmethod\n    def escaped_double_quote_pattern(cls) -> re.Pattern:\n        \"\"\"Compiles and returns the default double quote pattern.\"\"\"\n        return re.compile(cls.DEFAULT_DOUBLE_QUOTE_PATTERN, flags=re.DOTALL)\n\nclass IParserAdapter:\n    \"\"\"Interface for parsing strategies.\"\"\"\n    def parse(self, text: str) -> List[str]:\n        \"\"\"Parses the given text and returns a list of extracted strings.\"\"\"\n        raise NotImplementedError\n\nclass RegexAdapter(IParserAdapter):\n    \"\"\"Implements IParserAdapter using regex to extract quoted strings.\"\"\"\n    def __init__(self, pattern: Optional[re.Pattern] = None):\n        self.pattern = pattern or RegexPatterns.escaped_double_quote_pattern()\n    def parse(self, text: str) -> List[str]:\n        \"\"\"Extracts and unescapes content between double quotes.\"\"\"\n        try:\n            matches = []\n            for m in self.pattern.finditer(text):\n                inner = m.group(1)\n                inner = inner.replace(r'\\\"', '\"').replace(r'\\\\', '\\\\')\n                matches.append(inner)\n            return matches\n        except Exception as e:\n            raise QuoteExtractionError(\"RegexAdapter parse failed\", cause=e)\n\nclass QuoteExtractorService:\n    \"\"\"Orchestrates parsing across adapters and handles persistence.\"\"\"\n    def __init__(self, adapters: List[IParserAdapter], repository: Optional[ExtractionRepository] = None):\n        if not adapters:\n            raise QuoteExtractionError(\"At least one adapter required for QuoteExtractorService.\")\n        self.adapters = adapters\n        self.repository = repository\n\n    def extract(self, text: str) -> List[str]:\n        \"\"\"Extracts quoted strings using configured adapters and optionally saves records.\"\"\"\n        safe_type_check(text, str)\n\n        for adapter in self.adapters:\n            try:\n                result = adapter.parse(text)\n                if result is not None:\n                    if self.repository:\n                        try:\n                            rec = ExtractionRecord(\n                                id=str(uuid.uuid4()),\n                                timestamp=now_iso8601(),\n                                input_text=text,\n                                results=result\n                            )\n                            self.repository.save(rec)\n                        except Exception:\n                            # Repository persistence failures are logged and non-fatal as per design.\n                            pass\n                    return result\n            except QuoteExtractionError as e:\n                # Re-raise adapter's domain-specific exception.\n                raise e\n            except Exception as e:\n                # Wrap other adapter exceptions in a domain-specific exception.\n                raise QuoteExtractionError(f\"Adapter '{type(adapter).__name__}' failed during parse.\", cause=e)\n        return []\n\nclass QuoteController:\n    \"\"\"A thin wrapper around QuoteExtractorService for public API access.\"\"\"\n    def __init__(self, service: QuoteExtractorService):\n        self.service = service\n    def extract_quotation(self, text: str) -> List[str]:\n        \"\"\"Delegates to the service to extract quoted strings.\"\"\"\n        return self.service.extract(text)\n\ndef extract_quotation(text: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks \" \" of the given string.\n    \"\"\"\n    adapter = RegexAdapter()\n    repo = ExtractionRepository()\n    service = QuoteExtractorService(adapters=[adapter], repository=repo)\n    controller = QuoteController(service=service)\n    return controller.extract_quotation(text)"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Union\nfrom decimal import Decimal\n\nNumber = Union[int, float, Decimal]\n\ndef multiply_elements(input_tuple: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"\n    Computes the product of adjacent elements in a tuple of numbers.\n    The input tuple (t_1,...,t_{N+1}) results in (t_1*t_2, ..., t_N*t_{N+1}).\n    \"\"\"\n    result = tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r,h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    \"\"\"\n    slant_height = math.hypot(r, h)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    This function uses a translation table for efficient character replacement.\n    \"\"\"\n    pattern_chars = ' ,.'\n    replacement_char = ':'\n    translation_table = str.maketrans({char: replacement_char for char in pattern_chars})\n    return text.translate(translation_table)"}
{"task_id": "Mbpp/733", "solution": "from typing import List\n\ndef find_first_occurrence(arr: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = left + (right - left) // 2\n        if arr[mid] == target:\n            result = mid\n            right = mid - 1  # Move left to find an earlier occurrence\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the most significant and least significant bit.\n    For numbers with 2 or fewer bits, no middle bits exist, so the number remains unchanged.\n    \"\"\"\n    bit_length = n.bit_length() or 1\n\n    if bit_length <= 2:\n        return n\n\n    # Create a mask with 1s for all middle bits, and 0s for MSB and LSB.\n    # (1 << (bit_length - 2)) - 1 creates (bit_length - 2) ones.\n    # Shifting it left by 1 places these ones to skip the LSB.\n    mask = ((1 << (bit_length - 2)) - 1) << 1\n\n    return n ^ mask"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(text: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (case-insensitive) using regex.\n    Leading/trailing whitespace is trimmed before evaluation.\n    \"\"\"\n    pattern = r'^[aeiouAEIOU]'\n    compiled_pattern = re.compile(pattern)\n    normalized_text = text.strip()\n    return bool(compiled_pattern.match(normalized_text))"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums: list) -> float or int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists (subarrays) of a given list.\n    Uses a dynamic programming approach for O(n) time complexity.\n    \"\"\"\n    if not nums:\n        return 0\n\n    dp_prev = 0\n    total_sum_of_products = 0\n\n    for x in nums:\n        # dp_curr represents the sum of products of all sublists ending at x\n        # It is x itself, plus x multiplied by the sum of products of sublists ending at the previous element (dp_prev)\n        dp_curr = x * (1 + dp_prev)\n        total_sum_of_products += dp_curr\n        dp_prev = dp_curr\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/736", "solution": "from typing import Sequence, TypeVar, Optional, Callable\n\nT = TypeVar('T')\nK = TypeVar('K')\n\ndef left_insertion(arr: Sequence[T], value: T, key: Optional[Callable[[T], K]] = None) -> int:\n    \"\"\"\n    Locate the left insertion point for a specified value in sorted order using binary search.\n    This returns the index where the value would be inserted to maintain sorted order, preferring the leftmost position for equal keys.\n    \"\"\"\n    lo, hi = 0, len(arr)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        a_val = key(arr[mid]) if key else arr[mid]\n        v_val = key(value) if key else value\n        if a_val < v_val:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(side: float) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its side length.\n    Assumes input 'side' is a positive number.\n    \"\"\"\n    return math.sqrt(3.0) * (side ** 2)"}
{"task_id": "Mbpp/740", "solution": "from typing import Any, Dict, Tuple\n\ndef tuple_to_dict(input_tuple: Tuple[Any, ...]) -> Dict[Any, Any]:\n    \"\"\"\n    Converts a tuple of adjacent elements into a key-value dictionary.\n    Assumes an even-length tuple where elements at even indices are keys and elements at odd indices are their corresponding values.\n    \"\"\"\n    result: Dict[Any, Any] = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/739", "solution": "import math\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    \"\"\"\n\n    def _triangular_number(k: int) -> int:\n        # Calculates the k-th triangular number.\n        return k * (k + 1) // 2\n\n    def _digits_of(value: int) -> int:\n        # Counts the number of decimal digits in a positive integer.\n        if value == 0:\n            return 1\n        return int(math.floor(math.log10(value))) + 1\n\n    def _lower_bound_index_for_digits(n_val: int) -> int:\n        # Provides a conservative lower bound for the index k\n        # where T_k is expected to have at least n_val digits.\n        # Derived from T_k ~ k^2/2 >= 10^(n_val-1).\n        return max(1, int(math.floor((2 * (10 ** (n_val - 1))) ** 0.5)) - 2)\n\n    # Initialize a lower bound for the search range.\n    # `low` will represent an index whose triangular number has fewer than `n` digits.\n    low = _lower_bound_index_for_digits(n)\n\n    # Initialize an upper bound for the search range.\n    # `high` will represent an index whose triangular number is tested.\n    # We start it slightly above `low`.\n    high = low + 1\n\n    # Expand `high` exponentially until we find an index whose triangular number\n    # has at least `n` digits. `low` tracks the previous `high` value.\n    while _digits_of(_triangular_number(high)) < n:\n        low = high\n        high *= 2\n\n    # Now we have a range [low, high] where T_low has < n digits, and T_high has >= n digits.\n    # Perform binary search to find the smallest `k` in this range\n    # such that T_k has exactly `n` digits.\n    l_bs, r_bs = low, high\n    while l_bs < r_bs:\n        mid = (l_bs + r_bs) // 2\n        # If the triangular number at `mid` has `n` or more digits,\n        # `mid` could be our answer, or we might find a smaller one.\n        if _digits_of(_triangular_number(mid)) >= n:\n            r_bs = mid\n        # If it has fewer than `n` digits, `mid` is too small, so we search higher.\n        else:\n            l_bs = mid + 1\n\n    return r_bs"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"Checks if all characters in a string are the same.\"\"\"\n    if not s:\n        return False\n    first_char = s[0]\n    for char in s[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(items, k):\n    \"\"\"\n    Rotates a list to the right by k positions.\n    Returns a new list without modifying the original.\n    \"\"\"\n    n = len(items)\n    if n == 0:\n        return []\n    \n    # Normalize k to be within the bounds of the list length\n    effective_k = k % n\n    \n    if effective_k == 0:\n        return list(items)\n    else:\n        # Perform rotation using slicing:\n        # Take the last 'effective_k' elements and append them to the elements before them.\n        return items[-effective_k:] + items[:-effective_k]"}
{"task_id": "Mbpp/745", "solution": "import math\n\ndef divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit '0' are excluded, as division by zero is undefined.\n    \"\"\"\n    result = []\n    for num in range(startnum, endnum + 1):\n        if num == 0:  # Handle zero explicitly, although not expected in positive ranges usually\n            result.append(num)\n            continue\n        \n        current_num = abs(num)\n        temp_num = current_num\n        \n        is_divisible = True\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit == 0:\n                is_divisible = False\n                break\n            if num % digit != 0:\n                is_divisible = False\n                break\n            temp_num //= 10\n        \n        if is_divisible:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/748", "solution": "import re\n\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string,\n    preserving acronyms by default.\n    \"\"\"\n    if not text:\n        return \"\"\n\n    # This regex looks for:\n    # 1. A lowercase letter followed by an uppercase letter.\n    # 2. A digit followed by an uppercase letter.\n    # 3. An uppercase letter followed by an uppercase letter and then a lowercase letter (to split acronyms from subsequent words).\n    #    This ensures \"HTTPServer\" becomes \"HTTP Server\" and not \"H T T P Server\".\n    #    It captures the last uppercase letter of an acronym if it's followed by a lowercase,\n    #    so it inserts a space *before* the subsequent lowercase word.\n    #    Example: \"HTTPService\" -> finds (P, S) pattern -> \"HTTP Service\"\n    #    This specific regex pattern aims to balance simple camelCase with acronyms.\n\n    # This implementation is based on the logic described in the design context (preserving acronyms by default).\n    # The default regex for splitting is r\"((?<=.)(?=[A-Z]))\" but the design implies more complex acronym handling.\n    # A single regex might not cover all the detailed acronym rules, so a more robust approach is typically iterative or state-based.\n    # For a direct regex based on the provided single assert and preserving acronyms:\n\n    # The design context indicates \"DEFAULT_REGEX = r\"((?<=.)(?=[A-Z]))\"\" in SplitterUtils,\n    # which implies a basic split. However, the example \"HTTPServer\" -> \"HTTP Server\"\n    # implies a more sophisticated acronym handling.\n\n    # Let's use a regex that handles common cases for camel/pascal casing,\n    # and explicitly tries to keep initial acronyms together.\n    # Pattern:\n    # 1. Look for a lowercase letter followed by an uppercase letter. (e.g., \"wordA\" -> \"word A\")\n    # 2. Look for an uppercase letter followed by an uppercase letter, which is then followed by a lowercase letter.\n    #    This identifies the start of a new word after an acronym. (e.g., \"HTMLService\" -> \"HTML Service\")\n    # 3. Look for a digit followed by an uppercase letter. (e.g., \"word3A\" -> \"word3 A\")\n    # 4. Look for an uppercase letter followed by a digit. (e.g., \"Word3\" -> \"Word 3\")\n\n    # Combine these into a single regex.\n    # The requirement is \"put spaces between words starting with capital letters\".\n    # The design context elaborates on acronyms.\n\n    # A common regex for splitting CamelCase into words, handling acronyms:\n    # Insert a space before any uppercase letter that is:\n    # 1. Not preceded by another uppercase letter (simple case, e.g., \"camelCase\" -> \"camel Case\")\n    # 2. Preceded by multiple uppercase letters, but followed by a lowercase letter (acronym boundary, e.g., \"HTTPServer\" -> \"HTTP Server\")\n\n    # This regex is an adaptation to fulfill the \"preserve acronyms\" requirement implicitly:\n    # Look for a position where a space should be inserted.\n    # It inserts a space if the current character is uppercase AND:\n    #   - it's preceded by a lowercase character (e.g., \"helloWorld\" -> \"hello World\")\n    #   - OR it's preceded by an uppercase character, but it's NOT followed by another uppercase character.\n    #     (e.g., \"HTTPService\" -> \"HTTP Service\" - inserts space before 'S', not before 'T' or 'P')\n    #     This part handles acronyms.\n    #   - OR it's preceded by a digit (e.g. \"word1Two\" -> \"word1 Two\")\n    #   - OR it's an uppercase letter followed by a digit (e.g. \"Word1\" -> \"Word 1\")\n\n    # Let's simplify based on the design's `DEFAULT_REGEX = r\"((?<=.)(?=[A-Z]))\"`\n    # combined with the \"preserve acronyms\" logic that suggests a more complex pattern than a simple split.\n    # The provided test `capital_words_spaces(\"Python\") == 'Python'` implies that no split should occur for a single PascalCase word.\n    # The default regex `r\"((?<=.)(?=[A-Z]))\"` would *not* split \"Python\", as there is no char before 'y' that is an uppercase.\n    # This regex splits `PythonRocks` to `Python Rocks`.\n    # `HelloWorld` to `Hello World`.\n    # `HTTPServer` to `HTTP Server`.\n\n    # Regex: Look for a transition:\n    # 1. Lowercase to Uppercase: `(?<=[a-z])(?=[A-Z])` (e.g., \"helloWorld\" -> \"hello World\")\n    # 2. Digit to Uppercase: `(?<=[0-9])(?=[A-Z])` (e.g., \"word1Two\" -> \"word1 Two\")\n    # 3. Uppercase (preceded by another uppercase) followed by a lowercase: `(?<=[A-Z])(?=[A-Z][a-z])`\n    #    This is trickier. A simpler way to handle acronyms (like \"HTTP\" in \"HTTPServer\")\n    #    is to split if an uppercase is followed by a lowercase and is preceded by a non-first-letter uppercase.\n    #    This can be done with a more complex lookbehind.\n\n    # A simpler and widely used pattern for \"CamelCase\" to \"Camel Case\" with acronyms:\n    # (?<=[a-z])(?=[A-Z])     # Insert space before capital that follows a lowercase\n    # |                       # OR\n    # (?<=[A-Z])(?=[A-Z][a-z]) # Insert space before capital that follows an uppercase, but is itself followed by a lowercase (end of acronym)\n    #                          # e.g., HTTPServer -> HTTP Server (split before S)\n    # The design states DEFAULT_REGEX = r\"((?<=.)(?=[A-Z]))\" in utils.py but then \"preserve acronyms\"\n    # The `assert capital_words_spaces(\"Python\") == 'Python'` is key.\n    # The simplest regex that satisfies the Python/Python and PythonRocks/Python Rocks is:\n    # `re.sub(r'(?<!^)(?=[A-Z])', ' ', text)`\n    # This regex means: insert a space before an uppercase letter, only if it's NOT the start of the string.\n    # This correctly handles \"Python\" -> \"Python\"\n    # \"PythonRocks\" -> \"Python Rocks\"\n    # \"HelloWorld\" -> \"Hello World\"\n    # \"HTTPServer\" -> \"H T T P Server\" -- This violates \"preserve acronyms\".\n\n    # To preserve acronyms (e.g., \"HTTPServer\" -> \"HTTP Server\"), the regex needs refinement.\n    # The core idea for preserving acronyms is to split an uppercase sequence only if the *next* character\n    # is also uppercase but *followed by a lowercase*.\n\n    # Pattern breakdown for preserving acronyms:\n    # 1. Insert space between a lowercase letter and an uppercase letter (e.g., \"fooBar\" -> \"foo Bar\")\n    #    `(?<=[a-z])(?=[A-Z])`\n    # 2. Insert space between an uppercase letter (that is part of an acronym) and another uppercase letter\n    #    which starts a new word (i.e., it is followed by a lowercase letter).\n    #    (e.g., \"HTTPService\" -> \"HTTP Service\", space before 'S' which is followed by 'e')\n    #    `(?<=[A-Z])(?=[A-Z][a-z])`\n    # 3. Insert space between a digit and an uppercase letter (e.g., \"word1Two\" -> \"word1 Two\")\n    #    `(?<=\\d)(?=[A-Z])`\n    # 4. Insert space between an uppercase letter and a digit (e.g., \"Word1\" -> \"Word 1\")\n    #    `(?<=[A-Z])(?=\\d)`\n\n    # Combining these:\n    pattern = r'(?<=[a-z])(?=[A-Z])' \\\n              r'|(?<=[A-Z])(?=[A-Z][a-z])' \\\n              r'|(?<=\\d)(?=[A-Z])' \\\n              r'|(?<=[A-Z])(?=\\d)'\n\n    return re.sub(pattern, ' ', text)"}
