{"task_id": "Mbpp/478", "solution": "def remove_lowercase(text: str) -> str:\n    \"\"\"Removes contiguous lowercase substrings from a given string.\"\"\"\n\n    # Helper function to check if a character is an ASCII lowercase letter.\n    def is_ascii_lower(ch: str) -> bool:\n        return len(ch) == 1 and 'a' <= ch <= 'z'\n\n    output_chars = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        current_char = text[i]\n        if is_ascii_lower(current_char):\n            # Found a lowercase character, now skip the entire contiguous lowercase run\n            j = i\n            while j < n and is_ascii_lower(text[j]):\n                j += 1\n            # Advance the main pointer 'i' to the end of the skipped run\n            i = j\n            continue  # Continue to the next character after the skipped run\n        else:\n            # If the character is not lowercase, append it to the output\n            output_chars.append(current_char)\n            i += 1\n\n    return \"\".join(output_chars)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(text: str) -> str:\n    \"\"\"Toggles the case of all characters in the input string.\"\"\"\n    return text.swapcase()"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of pairs in the first n elements of an array whose XOR sum is odd.\n    An XOR sum is odd if and only if one number is even and the other is odd.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Determine the actual number of elements to consider, respecting array bounds.\n    effective_n = min(n, len(arr))\n    \n    # Iterate through the first 'effective_n' elements to count evens and odds.\n    for i in range(effective_n):\n        if arr[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    # The number of pairs with an odd XOR sum is the product of even_count and odd_count.\n    return even_count * odd_count"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using O(1) formulas.\n    \"\"\"\n    sum_n = n * (n + 1) // 2\n    sum_cubes = sum_n * sum_n\n    return sum_cubes - sum_n"}
{"task_id": "Mbpp/558", "solution": "import math\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of the per-digit absolute differences between two integers.\n    Digits are aligned by the least significant place, and the shorter number is\n    left-padded with zeros. The sign of the numbers is ignored.\n    \"\"\"\n    s_a = str(abs(a))\n    s_b = str(abs(b))\n\n    max_len = max(len(s_a), len(s_b))\n\n    padded_a = s_a.zfill(max_len)\n    padded_b = s_b.zfill(max_len)\n\n    total_distance = 0\n    for digit_a, digit_b in zip(padded_a, padded_b):\n        total_distance += abs(int(digit_a) - int(digit_b))\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\ndef max_sub_array_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist using Kadane's algorithm.\n    This handles cases where all numbers are negative by returning the largest single element.\n    \"\"\"\n    max_ending_here = arr[0]\n    max_so_far = arr[0]\n\n    for x in arr[1:]:\n        max_ending_here = max(x, max_ending_here + x)\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "from typing import List, Any\n\ndef Find_Max_Length(lists: List[List[Any]]) -> int:\n    \"\"\"\n    Finds the length of the longest sublist in a list of lists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in lists:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\n\ndef extract_values(text: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in single or double quotation marks from a string,\n    handling escaped quotes within the values.\n    \"\"\"\n    QUOTE_REGEX = r'(?<!\\\\)(?:\"((?:\\\\.|[^\"\\\\])*)\"|\\'((?:\\\\.|[^\\'\\\\])*)\\')'\n    _pattern = re.compile(QUOTE_REGEX)\n\n    def normalize_value(value: str) -> str:\n        # Unescape common sequences\n        return value.replace(r'\\\"', '\"').replace(r\"\\'\", \"'\").replace(r\"\\\\\", \"\\\\\").strip()\n\n    matches = _pattern.findall(text)\n    results = []\n    for dbl, sng in matches:\n        raw = dbl if dbl != \"\" else sng\n        results.append(normalize_value(raw))\n    return results"}
{"task_id": "Mbpp/560", "solution": "from typing import Tuple, Iterable, Any\n\nclass ConversionError(Exception):\n    \"\"\"Raised when a token cannot be converted to int.\"\"\"\n\nclass InvalidTupleError(ConversionError):\n    \"\"\"Raised when provided input isn't an iterable of convertible values.\"\"\"\n\nclass TupleConverter:\n    \"\"\"Converts an iterable of tokens to a tuple of integers.\"\"\"\n    def from_tokens(self, tokens: Iterable[Any]) -> Tuple[int, ...]:\n        out = []\n        for t in tokens:\n            try:\n                # int() handles string conversion, including stripping whitespace and +/- prefixes.\n                out.append(int(t))\n            except (ValueError, TypeError) as e:\n                raise ConversionError(f\"Cannot convert token {t!r}\") from e\n        return tuple(out)\n\nclass TupleValidator:\n    \"\"\"Validates an iterable and converts its elements to integers if necessary.\"\"\"\n    def __init__(self) -> None:\n        self._converter = TupleConverter()\n\n    def validate(self, iterable: Iterable[Any]) -> Tuple[int, ...]:\n        try:\n            # Attempt to convert all elements, handling non-iterable inputs as well.\n            return self._converter.from_tokens(iterable)\n        except TypeError:\n            raise InvalidTupleError(\"Input is not iterable\")\n        except ConversionError:\n            # Re-raise the more specific ConversionError from the converter.\n            raise\n\nclass UnionService:\n    \"\"\"Provides the core business logic for computing tuple unions.\"\"\"\n    def __init__(self, validator: TupleValidator, converter: TupleConverter) -> None:\n        self._validator = validator\n        self._converter = converter\n\n    def union_elements(self, a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n        \"\"\"\n        Computes the union of two integer tuples and returns it as a sorted tuple.\n        Assumes inputs 'a' and 'b' are already tuples of integers.\n        \"\"\"\n        return tuple(sorted(set(a) | set(b)))\n\n    def union_from_tokens(self, a_tokens: Iterable[Any], b_tokens: Iterable[Any]) -> Tuple[int, ...]:\n        \"\"\"\n        Validates and converts token streams to integer tuples, then computes their union.\n        This method uses the injected validator and converter.\n        \"\"\"\n        a_vals = self._validator.validate(a_tokens)\n        b_vals = self._validator.validate(b_tokens)\n        return self.union_elements(a_vals, b_vals)\n\nclass ServiceFactory:\n    \"\"\"Factory for creating UnionService instances with necessary dependencies.\"\"\"\n    @staticmethod\n    def get_union_service() -> UnionService:\n        validator = TupleValidator()\n        converter = TupleConverter()\n        return UnionService(validator, converter)\n\ndef union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples and outputs them in sorted order.\n    Input tuples can contain integers or string representations of integers.\n    \"\"\"\n    svc = ServiceFactory.get_union_service()\n    validated_a = svc._validator.validate(a)\n    validated_b = svc._validator.validate(b)\n    return svc.union_elements(validated_a, validated_b)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    Uses a frequency map to achieve O(n) time complexity.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    # Calculate total possible unordered pairs (n choose 2)\n    total_pairs = n * (n - 1) // 2\n\n    # Calculate pairs with equal elements\n    frequency = {}\n    for num in numbers:\n        frequency[num] = frequency.get(num, 0) + 1\n\n    equal_pairs = 0\n    for count in frequency.values():\n        if count >= 2:\n            equal_pairs += count * (count - 1) // 2\n\n    return total_pairs - equal_pairs"}
