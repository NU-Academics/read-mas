{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass RemoveZeroError(Exception):\n    \"\"\"Base exception for removezero_ip package errors.\"\"\"\n    pass\n\nclass InvalidIPAddressError(RemoveZeroError):\n    \"\"\"Raised when the input IP address is invalid.\"\"\"\n    pass\n\nclass IPAddress:\n    \"\"\"Represents a validated IPv4 address as a list of integer octets.\"\"\"\n    def __init__(self, octets: List[int]) -> None:\n        if len(octets) != 4:\n            raise InvalidIPAddressError(\"IPAddress requires exactly 4 octets.\")\n        self.octets: List[int] = octets\n\n    @classmethod\n    def from_strings(cls, octet_strs: List[str]) -> \"IPAddress\":\n        \"\"\"Constructs an IPAddress from a list of octet strings, performing validation.\"\"\"\n        ints = []\n        for s in octet_strs:\n            if not s.isdigit():\n                raise InvalidIPAddressError(f\"IP octet contains non-digit characters: {s!r}.\")\n            n = int(s)\n            if n < 0 or n > 255:\n                raise InvalidIPAddressError(f\"IP octet out of range (0-255): {n}.\")\n            ints.append(n)\n        return cls(ints)\n\n    def to_normalized_str(self) -> str:\n        \"\"\"Returns the dot-joined string representation of the IP address with no leading zeros.\"\"\"\n        return \".\".join(str(o) for o in self.octets)\n\nclass IPValidator:\n    \"\"\"Validates an IPv4 string and converts it to an IPAddress object.\"\"\"\n    def validate(self, ip: str) -> IPAddress:\n        \"\"\"Validates the IP string format and octet ranges, returning an IPAddress object.\"\"\"\n        if not isinstance(ip, str) or not ip:\n            raise InvalidIPAddressError(\"IP must be a non-empty string.\")\n        parts: List[str] = [p.strip() for p in ip.split(\".\")]\n        if len(parts) != 4:\n            raise InvalidIPAddressError(f\"IP must have exactly 4 octets, found {len(parts)}.\")\n        return IPAddress.from_strings(parts)\n\nclass IPProcessor:\n    \"\"\"Processes IP addresses to remove leading zeros using an injected validator.\"\"\"\n    def __init__(self, validator: IPValidator) -> None:\n        self._validator = validator\n\n    def remove_leading_zeros(self, ip: str) -> str:\n        \"\"\"Validates the input IP and returns its normalized string representation.\"\"\"\n        ip_addr: IPAddress = self._validator.validate(ip)\n        return ip_addr.to_normalized_str()\n\ndef removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address.\n    Raises InvalidIPAddressError for malformed or invalid IP addresses.\"\"\"\n    validator = IPValidator()\n    processor = IPProcessor(validator)\n    return processor.remove_leading_zeros(ip)"}
