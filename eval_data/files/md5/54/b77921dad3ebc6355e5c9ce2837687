{"task_id": "Mbpp/410", "solution": "import collections.abc\nfrom typing import Sequence, Any, Optional, Union, List\nfrom decimal import Decimal\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input or when no numeric values are found.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef min_val(items: Sequence[Any], allow_numeric_strings: Optional[bool] = None) -> Union[float, int]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    Ignores non-numeric elements by default; can optionally parse numeric strings.\n    \"\"\"\n    DEFAULT_ALLOW_NUMERIC_STRINGS: bool = False\n\n    if items is None:\n        raise InvalidInputError(\"Input is None; expected an iterable.\")\n    if not isinstance(items, collections.abc.Iterable):\n        raise InvalidInputError(f\"Input of type {type(items)!r} is not iterable.\")\n\n    _allow_numeric_strings_actual = allow_numeric_strings if allow_numeric_strings is not None else DEFAULT_ALLOW_NUMERIC_STRINGS\n\n    nums: List[Union[float, int]] = []\n\n    def _is_numeric(value: Any) -> bool:\n        \"\"\"Returns True if the value is an int, float, or Decimal (and not a boolean).\"\"\"\n        return (isinstance(value, (int, float)) and not isinstance(value, bool)) or isinstance(value, Decimal)\n\n    def _to_number_safe(s: str) -> Optional[float]:\n        \"\"\"Attempts to convert a string to a float; returns None on failure.\"\"\"\n        try:\n            return float(s)\n        except (ValueError, TypeError):\n            return None\n\n    for item in items:\n        if _is_numeric(item):\n            nums.append(item)\n        elif _allow_numeric_strings_actual and isinstance(item, str):\n            parsed = _to_number_safe(item)\n            if parsed is not None:\n                nums.append(parsed)\n\n    if not nums:\n        raise InvalidInputError(\"No numeric values found in input.\")\n\n    return min(nums)"}
{"task_id": "Mbpp/415", "solution": "import sys\n\ndef max_Product(arr: list[int]) -> tuple[int, int]:\n    # Initialize variables to track the two largest and two smallest numbers.\n    # Use extremely small/large integers to ensure any number in the array\n    # will correctly update these initial values during the first few iterations.\n    largest1 = -10**100  # Stores the largest number\n    largest2 = -10**100  # Stores the second largest number\n    smallest1 = 10**100   # Stores the smallest number\n    smallest2 = 10**100   # Stores the second smallest number\n\n    # Iterate through the array to find the two largest and two smallest numbers.\n    for val in arr:\n        # Update the two largest numbers\n        if val >= largest1:\n            largest2 = largest1\n            largest1 = val\n        elif val > largest2:\n            largest2 = val\n\n        # Update the two smallest numbers\n        if val <= smallest1:\n            smallest2 = smallest1\n            smallest1 = val\n        elif val < smallest2:\n            smallest2 = val\n\n    # Calculate the candidate products: product of the two largest, and product of the two smallest.\n    prod_high = largest1 * largest2\n    prod_low = smallest1 * smallest2\n\n    # Form the candidate pairs, ensuring the smaller number comes first for consistent output.\n    pair_high = (min(largest1, largest2), max(largest1, largest2))\n    pair_low = (min(smallest1, smallest2), max(smallest1, smallest2))\n\n    # Determine the pair with the highest product, applying tie-breaking rules.\n    if prod_high > prod_low:\n        return pair_high\n    elif prod_low > prod_high:\n        return pair_low\n    else:  # Products are equal, apply tie-breaking rules.\n        # Prefer the pair with the larger maximum element.\n        if pair_high[1] > pair_low[1]:\n            return pair_high\n        elif pair_low[1] > pair_high[1]:\n            return pair_low\n        else:\n            # If maximum elements are also equal, prefer the pair with the larger minimum element.\n            if pair_high[0] > pair_low[0]:\n                return pair_high\n            else:\n                # If both max and min elements are equal, either pair is acceptable.\n                # We consistently return pair_low in this case.\n                return pair_low"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    return 2 * (n ** 2) * ((n + 1) ** 2)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of cubes of the first n natural numbers.\n    Uses the formula for the sum of cubes and divides by n.\n    \"\"\"\n    # The sum of the first n cubes is given by (n * (n + 1) / 2)^2\n    sum_of_cubes = (n * (n + 1) // 2) ** 2\n    # The average is the sum divided by n\n    average = sum_of_cubes / n\n    return average"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds every number in a list, sums the rounded numbers,\n    and returns the total sum multiplied by the list's length.\n    \"\"\"\n    def _round_number(n: float) -> int:\n        # Uses Python's built-in rounding (round half to even).\n        return int(round(n))\n\n    total_rounded_sum = 0\n    for num in numbers:\n        total_rounded_sum += _round_number(num)\n\n    list_length = len(numbers)\n    result = total_rounded_sum * list_length\n    return result"}
