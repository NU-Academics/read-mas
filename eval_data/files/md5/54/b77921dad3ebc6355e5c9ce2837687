{"task_id": "Mbpp/68", "solution": "import collections\nimport datetime\nimport uuid\nfrom typing import Any, List, Optional, Sequence\n\n\nclass InvalidArrayError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n\nclass RepositoryError(RuntimeError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n\nclass CheckRecord:\n    def __init__(self, id: str, timestamp: str, input_preview: str, result: bool) -> None:\n        self.id = id\n        self.timestamp = timestamp\n        self.input_preview = input_preview\n        self.result = result\n\n\nclass HistoryRepository:\n    def __init__(self, max_size: int = 100) -> None:\n        if max_size <= 0:\n            raise RepositoryError(\"max_size must be > 0\")\n        self._max_size = max_size\n        self._buffer = collections.deque(maxlen=max_size)\n\n    def add(self, record: CheckRecord) -> None:\n        try:\n            self._buffer.append(record)\n        except Exception as e:\n            raise RepositoryError(f\"Failed to add record: {e}\")\n\n    def list_recent(self, limit: Optional[int] = None) -> List[CheckRecord]:\n        items = list(self._buffer)\n        if limit is None:\n            return items[::-1]\n        return items[::-1][:limit]\n\n\nclass ArrayValidator:\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, values: Sequence[Any]) -> None:\n        if values is None:\n            raise InvalidArrayError(\"Input array cannot be None\")\n        if not isinstance(values, Sequence):\n            raise InvalidArrayError(\"Input must be a sequence (e.g., list, tuple)\")\n\n        if len(values) <= 1:\n            return\n\n        # Check comparability of at least the first two elements if they exist\n        try:\n            # Attempt to compare a pair of elements to catch TypeError early\n            # This doesn't guarantee full comparability but catches common issues.\n            if len(values) >= 2:\n                _ = values[0] < values[1]\n        except TypeError as e:\n            raise InvalidArrayError(f\"Elements in array are not comparable: {e}\")\n\n\nclass MonotonicService:\n    def __init__(self, repository: Optional[HistoryRepository] = None,\n                 validator: Optional[ArrayValidator] = None) -> None:\n        self._repository = repository\n        self._validator = validator or ArrayValidator()\n\n    def is_monotonic(self, values: Sequence[Any]) -> bool:\n        self._validator.validate(values)\n        n = len(values)\n        if n <= 1:\n            result = True\n            self._record_result(values, result)\n            return result\n\n        increasing = False\n        decreasing = False\n\n        for i in range(1, n):\n            try:\n                if values[i] > values[i-1]:\n                    increasing = True\n                elif values[i] < values[i-1]:\n                    decreasing = True\n            except TypeError as e:\n                raise InvalidArrayError(f\"Incomparable elements at index {i-1} and {i}: {e}\")\n            if increasing and decreasing:\n                result = False\n                self._record_result(values, result)\n                return False\n\n        result = True\n        self._record_result(values, result)\n        return True\n\n    def _record_result(self, values: Sequence[Any], result: bool) -> None:\n        if not self._repository:\n            return\n        try:\n            rec = CheckRecord(\n                id=str(uuid.uuid4()),\n                timestamp=datetime.datetime.utcnow().isoformat() + \"Z\",\n                input_preview=repr(values)[:200],\n                result=result\n            )\n            self._repository.add(rec)\n        except Exception:\n            # Do not let repository failures break core behavior, log in a real app.\n            pass\n\n\n_monotonic_service_instance = MonotonicService(repository=HistoryRepository())\n\n\ndef is_Monotonic(array: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (non-increasing or non-decreasing).\n    An array is monotonic if it is either entirely non-increasing or entirely non-decreasing.\n    \"\"\"\n    return _monotonic_service_instance.is_monotonic(array)"}
{"task_id": "Mbpp/67", "solution": "import pathlib\nimport json\nimport os\n\nclass BellError(Exception):\n    \"\"\"Domain-specific exception for Bell number computations.\"\"\"\n    pass\n\nCACHE_FILENAME = \"bell_cache.json\"\nCACHE_DIR_ENV = \"BELL_CACHE_DIR\"\n\ndef default_cache_path() -> pathlib.Path:\n    \"\"\"Returns the default OS-appropriate cache path for Bell numbers.\"\"\"\n    if os.getenv(CACHE_DIR_ENV):\n        return pathlib.Path(os.getenv(CACHE_DIR_ENV)) / CACHE_FILENAME\n\n    if os.name == \"posix\":\n        xdg_cache_home = os.getenv(\"XDG_CACHE_HOME\")\n        if xdg_cache_home:\n            return pathlib.Path(xdg_cache_home) / \"bell_numbers\" / CACHE_FILENAME\n        return pathlib.Path.home() / \".cache\" / \"bell_numbers\" / CACHE_FILENAME\n    elif os.name == \"nt\":\n        app_data = os.getenv(\"LOCALAPPDATA\")\n        if app_data:\n            return pathlib.Path(app_data) / \"bell_numbers\" / CACHE_FILENAME\n        return pathlib.Path.home() / \"AppData\" / \"Local\" / \"bell_numbers\" / CACHE_FILENAME\n    else:\n        return pathlib.Path.home() / \".cache\" / \"bell_numbers\" / CACHE_FILENAME\n\ndef validate_n(n: any) -> int:\n    \"\"\"Validates and converts input n to a non-negative integer.\"\"\"\n    try:\n        i = int(n)\n    except (TypeError, ValueError):\n        raise BellError(f\"n must be integer-like, got {n!r}\")\n    if i < 0:\n        raise BellError(\"n must be >= 0\")\n    return i\n\ndef resolve_cache_path() -> pathlib.Path:\n    \"\"\"Resolves the cache file path using default configuration.\"\"\"\n    return default_cache_path()\n\ndef ensure_dir(path: pathlib.Path) -> None:\n    \"\"\"Ensures that a directory exists, creating it if necessary.\"\"\"\n    path.mkdir(parents=True, exist_ok=True)\n\nclass MemoRepository:\n    \"\"\"Manages an in-memory cache and persistent JSON cache for Bell numbers.\"\"\"\n    def __init__(self, cache_path: pathlib.Path = None):\n        self.cache_path = cache_path or resolve_cache_path()\n        self.cache: dict[int, int] = {}\n        self.dirty = False\n        self.load()\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a Bell number from the cache.\"\"\"\n        return self.cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Bell number in the cache.\"\"\"\n        self.cache[n] = value\n        self.dirty = True\n\n    def persist(self) -> None:\n        \"\"\"Writes the in-memory cache to the persistent JSON file.\"\"\"\n        if not self.dirty:\n            return\n\n        try:\n            ensure_dir(self.cache_path.parent)\n            tmp_path = self.cache_path.with_suffix(\".tmp\")\n            with tmp_path.open(\"w\", encoding=\"utf-8\") as fh:\n                json.dump({str(k): str(v) for k, v in self.cache.items()}, fh)\n            tmp_path.replace(self.cache_path)\n            self.dirty = False\n        except OSError:\n            pass # Best-effort persistence, ignore IO errors\n\n    def load(self) -> None:\n        \"\"\"Loads the cache from the persistent JSON file.\"\"\"\n        if self.cache_path.exists():\n            try:\n                with self.cache_path.open(\"r\", encoding=\"utf-8\") as fh:\n                    data = json.load(fh)\n                self.cache = {int(k): int(v) for k, v in data.items()}\n            except Exception: # Catch JSON errors or conversion errors\n                bak_path = self.cache_path.with_suffix(\".bak\")\n                try:\n                    self.cache_path.replace(bak_path)\n                except Exception:\n                    pass # Ignore errors during backup\n                self.cache = {} # Clear the in-memory cache if file is corrupt\n\nclass BellCalculator:\n    \"\"\"Computes Bell numbers using dynamic programming and handles caching.\"\"\"\n    def __init__(self, repo: MemoRepository):\n        self.repo = repo\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the Bell number for n, using cache if available.\"\"\"\n        n_validated = validate_n(n)\n        cached_value = self.repo.get(n_validated)\n        if cached_value is not None:\n            return cached_value\n\n        value = self._compute_bell_triangle(n_validated)\n        self.repo.set(n_validated, value)\n        self.repo.persist() # Persist the new value to disk\n        return value\n\n    def _compute_bell_triangle(self, n: int) -> int:\n        \"\"\"Calculates Bell number B(n) using the Bell triangle method.\"\"\"\n        if n == 0:\n            return 1\n\n        bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n        bell_triangle[0][0] = 1\n\n        for i in range(1, n + 1):\n            bell_triangle[i][0] = bell_triangle[i - 1][i - 1] # First element of row i\n            for j in range(1, i + 1):\n                bell_triangle[i][j] = bell_triangle[i][j - 1] + bell_triangle[i - 1][j - 1] # Other elements\n\n        return bell_triangle[n][0]\n\n_repo = MemoRepository()\n_calc = BellCalculator(repo=_repo)\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the Bell number B(n), representing the number of ways to\n    partition a set of n labeled elements.\n    \"\"\"\n    return _calc.compute(n)"}
{"task_id": "Mbpp/71", "solution": "from typing import Sequence, Optional, Callable, Any, List, TypeVar\n\n# Define a generic type variable for use in type hints\nT = TypeVar('T')\n\n# Import necessary components from the package structure as per design\n# These are external dependencies from the perspective of this __init__.py function.\n# For the purpose of this single file output, we will assume they are available\n# from sibling modules within the same package, even if not explicitly defined here.\n# In a real package, these would be relative imports.\n# Since the prompt asks for a complete function definition *without* markdown fences,\n# and implicitly for a single file, we will re-declare the necessary types and classes\n# to make this standalone. However, the design implies they come from external files.\n# To resolve the conflict of \"DO NOT call any helper that is not defined inline in your response\"\n# versus \"Design context uses separate files for SortService\", I will define minimal\n# placeholder classes for SortService and SortResult that allow the comb_sort function\n# to execute conceptually, without implementing the full sorting logic here.\n# This way, SortService *is* defined inline in this response.\n\n# --- Start of minimal inline definitions based on design context ---\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass SortError(Exception):\n    \"\"\"Exception raised for errors during the sorting process.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass SortResult:\n    \"\"\"A data transfer object to encapsulate sorting results.\"\"\"\n    def __init__(self, original: List[Any], sorted: List[Any], duration_seconds: float):\n        self.original = original\n        self.sorted = sorted\n        self.duration_seconds = duration_seconds\n\nclass InputValidator:\n    \"\"\"Utility class for validating common input patterns.\"\"\"\n    def validate_iterable(self, items: Any) -> None:\n        try:\n            iter(items)\n        except TypeError:\n            raise InvalidInputError(\"Items must be an iterable.\")\n\n    def validate_key(self, key: Optional[Callable[[T], Any]]) -> None:\n        if key is not None and not callable(key):\n            raise InvalidInputError(\"Key must be a callable or None.\")\n\nclass CombSortAlgorithm:\n    \"\"\"Implements the Comb Sort algorithm.\"\"\"\n    SHRINK_FACTOR = 1.3\n\n    def sort(self, items: Sequence[T], key: Optional[Callable[[T], Any]]=None, reverse: bool=False) -> List[T]:\n        validator = InputValidator()\n        validator.validate_iterable(items)\n        validator.validate_key(key)\n\n        arr = list(items)  # Create a mutable copy to avoid mutating the original\n        n = len(arr)\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = self._next_gap(gap)\n            swapped = False\n            for i in range(0, n - gap):\n                # Apply key function for comparison if provided\n                val_i = key(arr[i]) if key else arr[i]\n                val_j = key(arr[i + gap]) if key else arr[i + gap]\n\n                if (val_i > val_j and not reverse) or \\\n                   (val_i < val_j and reverse):\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n        return arr\n\n    def _next_gap(self, gap: int) -> int:\n        \"\"\"Calculates the next gap size for Comb Sort.\"\"\"\n        new_gap = int(gap / self.SHRINK_FACTOR)\n        # Ensure gap is at least 1\n        return max(1, new_gap)\n\nimport time # Required for time.perf_counter()\n\nclass SortService:\n    \"\"\"Orchestrates sorting operations and provides a high-level API.\"\"\"\n    def __init__(self):\n        # Maps algorithm names to their implementations\n        self.algorithm_map = {\"comb\": CombSortAlgorithm()}\n\n    def sort(self, items: Sequence[T], algorithm: str = \"comb\", key: Optional[Callable[[T], Any]] = None, reverse: bool = False) -> SortResult:\n        \"\"\"\n        Sorts a list of items using the specified algorithm and returns a SortResult.\n        Validates inputs and measures execution duration.\n        \"\"\"\n        algo_instance = self.algorithm_map.get(algorithm)\n        if not algo_instance:\n            raise SortError(f\"Unknown sorting algorithm: '{algorithm}'\")\n\n        start_time = time.perf_counter()\n        sorted_list = algo_instance.sort(items, key=key, reverse=reverse)\n        duration = time.perf_counter() - start_time\n\n        return SortResult(original=list(items), sorted=sorted_list, duration_seconds=duration)\n\n# --- End of minimal inline definitions ---\n\n\ndef comb_sort(items: Sequence[T], key: Optional[Callable[[T], Any]]=None, reverse: bool=False) -> List[T]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n\n    This function delegates the actual sorting to an internal SortService\n    to provide consistent validation and performance measurement.\n    \"\"\"\n    service = SortService()\n    result = service.sort(items, algorithm=\"comb\", key=key, reverse=reverse)\n    return result.sorted"}
{"task_id": "Mbpp/74", "solution": "from typing import Sequence, Any, Optional\n\ndef is_samepatterns(sequence: Sequence[Any], pattern: Sequence[Any], case_sensitive: bool = True, persist: bool = False, save_path: Optional[str] = None) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same bijective pattern.\n    It ensures a one-to-one and onto mapping between their elements.\n    \"\"\"\n\n    def _normalize_token(token: Any) -> Any:\n        \"\"\"Normalizes a token, converting strings to lowercase if case_sensitive is False.\"\"\"\n        return token.lower() if isinstance(token, str) and not case_sensitive else token\n\n    if len(sequence) != len(pattern):\n        return False\n\n    mapping = {}  # Stores pattern_token -> sequence_token mapping\n    reverse_mapping = {}  # Stores sequence_token -> pattern_token mapping\n\n    for s_item, p_item in zip(sequence, pattern):\n        normalized_s = _normalize_token(s_item)\n        normalized_p = _normalize_token(p_item)\n\n        # Check consistency for pattern_token -> sequence_token\n        if normalized_p in mapping:\n            if mapping[normalized_p] != normalized_s:\n                return False  # Mismatch: pattern token already maps to a different sequence token\n        else:\n            mapping[normalized_p] = normalized_s\n\n        # Check consistency for sequence_token -> pattern_token (bijective check)\n        if normalized_s in reverse_mapping:\n            if reverse_mapping[normalized_s] != normalized_p:\n                return False  # Mismatch: sequence token already maps to a different pattern token\n        else:\n            reverse_mapping[normalized_s] = normalized_p\n\n    return True"}
