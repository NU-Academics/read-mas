{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of odd values obtained by rotating a binary string.\n    An odd value is indicated by a '1' in the least significant bit (rightmost position).\n    \"\"\"\n    n = len(binary)\n    if n == 0:\n        return 0\n\n    total_ones_in_string = binary.count('1')\n    \n    # Calculate full cycles of rotations and remainder rotations\n    full_cycles = rotations // n\n    remainder = rotations % n\n    \n    # Each full cycle makes every '1' in the string appear in the last position once\n    count = full_cycles * total_ones_in_string\n    \n    # Account for the remainder rotations\n    for k in range(remainder):\n        # The character at index (k - 1) % n in the original string will be the last bit\n        # after k left rotations.\n        if binary[(k - 1) % n] == '1':\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/108", "solution": "import json\nfrom abc import ABC, abstractmethod\nfrom typing import Sequence, List, Any\n\nclass MergeError(Exception):\n    \"\"\"Custom exception for merge operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass SortStrategy(ABC):\n    \"\"\"Abstract base class for sorting strategies.\"\"\"\n    @abstractmethod\n    def sort(self, items: Sequence[Any]) -> List[Any]:\n        pass\n\nclass BuiltinSortStrategy(SortStrategy):\n    \"\"\"Sort strategy using Python's built-in sorted() function.\"\"\"\n    def sort(self, items: Sequence[Any]) -> List[Any]:\n        return sorted(list(items))\n\nclass InputValidator:\n    \"\"\"Validates input sequences for basic integrity.\"\"\"\n    def validate_sequences(self, *seqs: Sequence[Any]) -> None:\n        \"\"\"Ensures that no top-level input sequence is None.\"\"\"\n        for i, seq in enumerate(seqs):\n            if seq is None:\n                raise MergeError(f\"Input sequence at index {i} cannot be None.\")\n\nclass ListAdapter:\n    \"\"\"Normalizes various input types into a standard list of comparable items.\"\"\"\n    def normalize(self, raw: Any) -> List[Any]:\n        \"\"\"Converts raw input (list, tuple, string, scalar) into a list.\"\"\"\n        if raw is None:\n            return []\n        if isinstance(raw, (list, tuple)):\n            return list(raw)\n        if isinstance(raw, str):\n            try:\n                parsed = json.loads(raw)\n                if isinstance(parsed, list):\n                    return list(parsed)\n            except json.JSONDecodeError:\n                try:\n                    # Fallback to whitespace parsing for numbers\n                    return [int(x) for x in raw.strip().split() if x.strip()]\n                except ValueError as e:\n                    raise MergeError(f\"Cannot parse string input '{raw}' as a list of numbers or JSON: {e}\") from e\n            except Exception as e:\n                raise MergeError(f\"Error processing string input '{raw}': {e}\") from e\n        if isinstance(raw, (int, float)):\n            return [raw]\n        raise MergeError(f\"Unsupported input type for normalization: {type(raw)}\")\n\nclass MergeService:\n    \"\"\"Orchestrates validation, normalization, and sorting of lists.\"\"\"\n    def __init__(self, sorter: SortStrategy, validator: InputValidator, adapter: ListAdapter) -> None:\n        self._sorter = sorter\n        self._validator = validator\n        self._adapter = adapter\n\n    def merge(self, a: Any, b: Any, c: Any) -> List[Any]:\n        \"\"\"Merges and sorts three inputs, normalizing them first.\"\"\"\n        self._validator.validate_sequences(a, b, c)\n        la = self._adapter.normalize(a)\n        lb = self._adapter.normalize(b)\n        lc = self._adapter.normalize(c)\n        try:\n            combined = la + lb + lc\n            return self._sorter.sort(combined)\n        except Exception as e:\n            # Catches potential TypeErrors during comparison in sort if items are incomparable.\n            raise MergeError(f\"Failed to merge lists due to sorting error: {e}\") from e\n\n_default_service = MergeService(BuiltinSortStrategy(), InputValidator(), ListAdapter())\n\ndef merge_sorted_list(a: Sequence[Any], b: Sequence[Any], c: Sequence[Any]) -> List[Any]:\n    \"\"\"\n    Merges three list-like inputs into a single sorted list, handling various input formats.\n    \"\"\"\n    return _default_service.merge(a, b, c)"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Set, Iterable, TypeVar\n\nT = TypeVar(\"T\")\n\ndef common_in_nested_lists(lists: List[Iterable[T]]) -> Set[T]:\n    \"\"\"\n    Finds common elements in given nested lists by computing their set intersection.\n    Elements must be hashable.\n    \"\"\"\n    set_list: List[Set[T]] = []\n    for inner_list in lists:\n        set_list.append(set(inner_list))\n\n    if not set_list:\n        return set()\n\n    # Optimize by sorting lists by length to start intersection with the smallest set\n    set_list.sort(key=len)\n\n    result_set = set_list[0].copy()\n    for i in range(1, len(set_list)):\n        result_set.intersection_update(set_list[i])\n        if not result_set: # Early exit if intersection becomes empty\n            break\n            \n    return result_set"}
{"task_id": "Mbpp/113", "solution": "def check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents a base-10 integer.\n    Handles optional leading sign and trims whitespace.\n    \"\"\"\n    if s is None:\n        return False\n    s_trim = s.strip()\n    if s_trim == \"\":\n        return False\n    \n    if s_trim[0] in ('+', '-'):\n        digits = s_trim[1:]\n    else:\n        digits = s_trim\n        \n    return digits.isdigit() and len(digits) > 0"}
