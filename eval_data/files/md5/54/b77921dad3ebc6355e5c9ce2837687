{"task_id": "Mbpp/91", "solution": "from typing import List\n\ndef find_substring(values: List[str], pattern: str, case_sensitive: bool = False) -> bool:\n    \"\"\"\n    Checks if a pattern string is present as a substring in any of the values.\n    \"\"\"\n    if not case_sensitive:\n        normalized_pattern = pattern.lower()\n        for value in values:\n            if normalized_pattern in value.lower():\n                return True\n    else:\n        for value in values:\n            if pattern in value:\n                return True\n    return False"}
{"task_id": "Mbpp/90", "solution": "from typing import Any, Iterable, List, Iterator, Optional\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\ndef ensure_iterable(words: Any) -> Iterable[Any]:\n    \"\"\"Ensures input is iterable; wraps string in a list, raises error otherwise.\"\"\"\n    if isinstance(words, str):\n        return [words]\n    if not hasattr(words, \"__iter__\"):\n        raise InvalidInputError(\"Input must be an iterable.\")\n    return words\n\ndef coerce_to_str(x: Any) -> str:\n    \"\"\"Coerces any object to its string representation.\"\"\"\n    return str(x)\n\nclass WordList:\n    def __init__(self, words: List[str]) -> None:\n        self.words = words\n\n    @classmethod\n    def from_iterable(cls, iterable: Iterable[Any]) -> \"WordList\":\n        \"\"\"Factory method to create a WordList from an iterable, coercing elements to strings.\"\"\"\n        return cls([coerce_to_str(item) for item in iterable])\n\n    def __len__(self) -> int:\n        return len(self.words)\n\n    def __iter__(self) -> Iterator[str]:\n        return iter(self.words)\n\nclass LongestWordService:\n    def __init__(self) -> None:\n        pass\n\n    def get_length(self, word_list: WordList) -> int:\n        \"\"\"Computes the length of the longest word in the WordList.\"\"\"\n        max_len = 0\n        for w in word_list:\n            l = len(w)\n            if l > max_len:\n                max_len = l\n        return max_len\n\nclass WordRepository:\n    def __init__(self) -> None:\n        pass\n\n    def load_from_iterable(self, iterable: Iterable[Any]) -> WordList:\n        \"\"\"Loads words from an iterable into a WordList, ensuring it's iterable first.\"\"\"\n        validated_iterable = ensure_iterable(iterable)\n        return WordList.from_iterable(validated_iterable)\n\nclass LongestWordController:\n    def __init__(self, repo: WordRepository, service: LongestWordService) -> None:\n        self._repo = repo\n        self._service = service\n\n    def compute(self, words: Iterable[Any]) -> int:\n        \"\"\"Computes the longest word length by loading words and using the service.\"\"\"\n        word_list = self._repo.load_from_iterable(words)\n        return self._service.get_length(word_list)\n\n_repo = WordRepository()\n_service = LongestWordService()\n_controller = LongestWordController(_repo, _service)\n\ndef len_log(words: Iterable[Any]) -> int:\n    \"\"\"Return length of longest word in words iterable.\"\"\"\n    return _controller.compute(words)"}
{"task_id": "Mbpp/89", "solution": "import math\nfrom typing import Union\n\ndef closest_num(n: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Finds the closest smaller number to n.\n    For integers, this is n - 1; for floats, it's the IEEE-754 predecessor.\n    \"\"\"\n    if isinstance(n, int):\n        return n - 1\n    # For float inputs, return the next representable float value towards negative infinity.\n    return math.nextafter(n, float('-inf'))"}
{"task_id": "Mbpp/87", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional, Tuple, Dict, Any\n\nclass MergeException(Exception):\n    \"\"\"Base exception for merge operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass InvalidInputError(MergeException):\n    \"\"\"Raised when an input dictionary is not valid.\"\"\"\n    pass\n\n@dataclass\nclass MergeConfig:\n    \"\"\"Configuration for dictionary merging behavior.\"\"\"\n    precedence: Tuple[str, str, str]\n    allow_non_dict: bool\n    output_format: str\n\n@dataclass\nclass MergeResult:\n    \"\"\"Result of a merge operation, including metadata.\"\"\"\n    merged: Dict[str, Any]\n    source_keys: Dict[str, List[str]]\n    conflicts: Dict[str, List[str]]\n\nclass ValidationService:\n    \"\"\"Service for validating dictionary inputs.\"\"\"\n    def __init__(self, allow_non_dict: bool = False) -> None:\n        self.allow_non_dict = allow_non_dict\n\n    def validate_dict_like(self, obj: object, name: str) -> None:\n        \"\"\"Validates if an object is a dictionary.\"\"\"\n        if not isinstance(obj, dict):\n            raise InvalidInputError(f\"{name} must be a dict, got {type(obj).__name__}\")\n\nclass DictMerger:\n    \"\"\"Implements the core dictionary merging algorithm.\"\"\"\n    def __init__(self, precedence_order: Optional[List[str]] = None) -> None:\n        self.precedence_order = precedence_order or [\"a\", \"b\", \"c\"]\n\n    def merge_three(self, a: Dict[str, Any], b: Dict[str, Any], c: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Merges three dictionaries according to the specified precedence.\"\"\"\n        result = {}\n        # Apply inputs in precedence order, so later inputs override earlier ones.\n        for src_label in self.precedence_order:\n            src_map = {\"a\": a, \"b\": b, \"c\": c}[src_label]\n            if src_map: # Check if dictionary is not empty\n                for k, v in src_map.items():\n                    result[k] = v\n        return result\n\nclass MergeService:\n    \"\"\"Orchestrates validation and dictionary merging.\"\"\"\n    def __init__(self, config: MergeConfig, validator: ValidationService, merger: DictMerger) -> None:\n        self.config = config\n        self.validator = validator\n        self.merger = merger\n\n    def merge(self, a: Dict[str, Any], b: Dict[str, Any], c: Dict[str, Any]) -> MergeResult:\n        \"\"\"Validates inputs and performs the merge operation.\"\"\"\n        self.validator.validate_dict_like(a, \"dict_a\")\n        self.validator.validate_dict_like(b, \"dict_b\")\n        self.validator.validate_dict_like(c, \"dict_c\")\n\n        merged_dict = self.merger.merge_three(a, b, c)\n\n        source_keys: Dict[str, List[str]] = {}\n        conflicts: Dict[str, List[str]] = {}\n        \n        all_keys = set(a.keys()) | set(b.keys()) | set(c.keys())\n\n        for key in all_keys:\n            sources_for_key = []\n            values_seen = set()\n            \n            if key in a:\n                sources_for_key.append(\"a\")\n                values_seen.add(a[key])\n            if key in b:\n                sources_for_key.append(\"b\")\n                values_seen.add(b[key])\n            if key in c:\n                sources_for_key.append(\"c\")\n                values_seen.add(c[key])\n            \n            source_keys[key] = sources_for_key\n            if len(values_seen) > 1:\n                conflicts[key] = sources_for_key\n\n        return MergeResult(merged=merged_dict, source_keys=source_keys, conflicts=conflicts)\n\nclass DictMergeAPI:\n    \"\"\"Provides a programmatic API for merging dictionaries.\"\"\"\n    def __init__(self, config: Optional[MergeConfig] = None) -> None:\n        self.config = config or MergeConfig(precedence=(\"a\",\"b\",\"c\"), allow_non_dict=False, output_format=\"json\")\n        self.validator = ValidationService(self.config.allow_non_dict)\n        self.merger = DictMerger(list(self.config.precedence))\n        self.service = MergeService(self.config, self.validator, self.merger)\n\n    def merge_dictionaries_three(self, a: Dict[str, Any], b: Dict[str, Any], c: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Merges three dictionaries, returning the combined result.\"\"\"\n        result = self.service.merge(a, b, c)\n        return result.merged\n\n_default_api = DictMergeAPI(MergeConfig(precedence=(\"a\",\"b\",\"c\"), allow_non_dict=False, output_format=\"json\"))\n\ndef merge_dictionaries_three(a: Dict[str, Any], b: Dict[str, Any], c: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"\n    Merges three dictionaries into a single dictionary.\n    Keys from later dictionaries override values from earlier ones (c > b > a).\n    \"\"\"\n    return _default_api.merge_dictionaries_three(a, b, c)"}
{"task_id": "Mbpp/86", "solution": "import threading\nimport json\nimport pathlib\nfrom typing import Optional, Any\nimport abc\n\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\ndef validate_n(n: object) -> int:\n    \"\"\"\n    Validates the input `n` to ensure it is an integer and greater than or equal to 1.\n\n    Args:\n        n: The input value to validate.\n\n    Returns:\n        The validated integer `n`.\n\n    Raises:\n        ValidationError: If `n` is not an integer or is less than 1.\n    \"\"\"\n    try:\n        val = int(n)\n    except (TypeError, ValueError):\n        raise ValidationError(f\"n must be an integer, got {n!r}\")\n    if val < 1:\n        raise ValidationError(\"n must be >= 1\")\n    return val\n\nclass CenteredHexagonalNumber:\n    \"\"\"\n    Domain model representing a centered hexagonal number with metadata.\n    \"\"\"\n    def __init__(self, n: int, value: int, algorithm: str) -> None:\n        self.n = n\n        self.value = value\n        self.algorithm = algorithm\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the model to a dictionary suitable for serialization.\"\"\"\n        return {\"n\": self.n, \"value\": self.value, \"algorithm\": self.algorithm}\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation of the CenteredHexagonalNumber object.\"\"\"\n        return f\"CenteredHexagonalNumber(n={self.n}, value={self.value}, algorithm='{self.algorithm}')\"\n\nclass AlgorithmStrategy(abc.ABC):\n    \"\"\"Abstract base class for centered hexagonal number algorithms.\"\"\"\n\n    @abc.abstractmethod\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth centered hexagonal number.\"\"\"\n        pass\n\n    @abc.abstractmethod\n    def name(self) -> str:\n        \"\"\"Returns the name of the algorithm.\"\"\"\n        pass\n\nclass FormulaAlgorithm(AlgorithmStrategy):\n    \"\"\"Computes centered hexagonal numbers using the closed-form formula.\"\"\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth centered hexagonal number using the formula 3n(n-1)+1.\n        Assumes n >= 1.\n        \"\"\"\n        return 3 * n * (n - 1) + 1\n\n    def name(self) -> str:\n        \"\"\"Returns the algorithm name.\"\"\"\n        return \"formula\"\n\nclass IterativeAlgorithm(AlgorithmStrategy):\n    \"\"\"Computes centered hexagonal numbers iteratively.\"\"\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth centered hexagonal number iteratively.\n        Assumes n >= 1.\n        \"\"\"\n        if n == 1:\n            return 1\n        # The recurrence relation for centered hexagonal numbers is H_n = H_{n-1} + 6(n-1)\n        # where H_1 = 1.\n        value = 1\n        for i in range(2, n + 1):\n            value += 6 * (i - 1)\n        return value\n\n    def name(self) -> str:\n        \"\"\"Returns the algorithm name.\"\"\"\n        return \"iterative\"\n\nclass CacheRepository:\n    \"\"\"\n    Manages in-memory cache for centered hexagonal numbers with optional JSON persistence.\n    \"\"\"\n    def __init__(self, persist_file: Optional[pathlib.Path] = None) -> None:\n        self._cache: dict[int, int] = {}\n        self._lock = threading.Lock()\n        self.persist_file = persist_file\n        if self.persist_file:\n            self.load_from_file()\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache by n.\"\"\"\n        with self._lock:\n            return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache by n.\"\"\"\n        with self._lock:\n            self._cache[n] = value\n        if self.persist_file:\n            self.save_to_file()\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        with self._lock:\n            self._cache.clear()\n        if self.persist_file and self.persist_file.exists():\n            try:\n                self.persist_file.unlink()\n            except OSError as e:\n                # Log error, but don't fail operation\n                print(f\"Warning: Could not delete cache file {self.persist_file}: {e}\")\n\n    def load_from_file(self) -> None:\n        \"\"\"Loads cache data from the persistence file.\"\"\"\n        if not self.persist_file or not self.persist_file.exists():\n            return\n        try:\n            with self.persist_file.open('r') as f:\n                data = json.load(f)\n                with self._lock:\n                    # Ensure all keys are integers as expected\n                    self._cache = {int(k): v for k, v in data.items() if isinstance(v, int)}\n        except (IOError, json.JSONDecodeError) as e:\n            # Log error, but proceed with empty cache\n            print(f\"Warning: Could not load cache from {self.persist_file}: {e}\")\n            self.clear() # Clear any partial or corrupt data\n\n    def save_to_file(self) -> None:\n        \"\"\"Saves cache data to the persistence file atomically.\"\"\"\n        if not self.persist_file:\n            return\n        temp_file = self.persist_file.with_suffix('.tmp')\n        try:\n            with self._lock:\n                data_to_save = {str(k): v for k, v in self._cache.items()}\n            with temp_file.open('w') as f:\n                json.dump(data_to_save, f)\n            temp_file.replace(self.persist_file) # Atomic rename\n        except IOError as e:\n            # Log error, but don't fail operation\n            print(f\"Warning: Could not save cache to {self.persist_file}: {e}\")\n            if temp_file.exists():\n                try:\n                    temp_file.unlink()\n                except OSError as e_unlink:\n                    print(f\"Warning: Could not clean up temp cache file {temp_file}: {e_unlink}\")\n\nclass CenteredHexService:\n    \"\"\"\n    Orchestrates the computation of centered hexagonal numbers,\n    handling caching and algorithm selection.\n    \"\"\"\n    def __init__(self, repo: CacheRepository, default_algorithm: AlgorithmStrategy) -> None:\n        self._repo = repo\n        self._default_algorithm = default_algorithm\n\n    def compute(self, n: int, strategy: Optional[AlgorithmStrategy] = None) -> CenteredHexagonalNumber:\n        \"\"\"\n        Computes the nth centered hexagonal number using the specified strategy or default.\n        Looks up in cache first, stores result if computed.\n        \"\"\"\n        n = validate_n(n) # Ensure n is valid before processing\n\n        cached_value = self._repo.get(n)\n        if cached_value is not None:\n            return CenteredHexagonalNumber(n, cached_value, \"cache\")\n\n        algo_to_use = strategy if strategy is not None else self._default_algorithm\n        value = algo_to_use.compute(n)\n        self._repo.set(n, value)\n        return CenteredHexagonalNumber(n, value, algo_to_use.name())\n\n    def centered_hexagonal_number(self, n: int) -> int:\n        \"\"\"\n        Convenience method to compute the nth centered hexagonal number\n        using the default algorithm and return just the integer value.\n        \"\"\"\n        return self.compute(n).value\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number using the default formula-based algorithm\n    and an in-memory cache.\n    \"\"\"\n    cache_repo = CacheRepository()\n    formula_algo = FormulaAlgorithm()\n    service = CenteredHexService(cache_repo, formula_algo)\n    return service.centered_hexagonal_number(n)"}
{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass UndulatingError(Exception):\n    \"\"\"Base exception for undulating number operations.\"\"\"\n    def __init__(self, message: str | None = None) -> None:\n        super().__init__(message or \"Undulating error\")\n\nclass InvalidNumberError(UndulatingError):\n    \"\"\"Exception raised for invalid number inputs.\"\"\"\n    def __init__(self, message: str | None = None) -> None:\n        super().__init__(message or \"Invalid number\")\n\nclass NumberDTO:\n    \"\"\"Data transfer object for a parsed number, containing its value, digits, and original string.\"\"\"\n    def __init__(self, value: int, digits: List[int], original: str) -> None:\n        self.value: int = value\n        self.digits: List[int] = digits\n        self.original: str = original\n\nclass NumberParser:\n    \"\"\"Parses raw input (int or str) into a NumberDTO.\"\"\"\n    ALLOW_NEGATIVE: bool = True\n\n    def parse(self, raw: int | str) -> NumberDTO:\n        if isinstance(raw, int):\n            value = abs(raw)\n            digits = self._to_digits(value)\n            return NumberDTO(value=value, digits=digits, original=str(raw))\n        if isinstance(raw, str):\n            s = raw.strip()\n            if s == \"\":\n                raise InvalidNumberError(\"Empty input\")\n            if self.ALLOW_NEGATIVE and s and (s[0] == '-' or s[0] == '+'):\n                s = s[1:]\n            if not s.isdigit():\n                raise InvalidNumberError(f\"Invalid numeric string: {raw}\")\n            value = int(s)\n            digits = self._to_digits(value)\n            return NumberDTO(value=value, digits=digits, original=raw)\n        raise InvalidNumberError(\"Unsupported input type\")\n\n    def _to_digits(self, n: int) -> List[int]:\n        if n == 0:\n            return [0]\n        digits = []\n        current_n = n\n        while current_n > 0:\n            digits.append(current_n % 10)\n            current_n //= 10\n        digits.reverse()\n        return digits\n\nclass UndulatingChecker:\n    \"\"\"Checks if a NumberDTO represents an undulating number.\"\"\"\n    MIN_DIGITS: int = 2\n\n    def is_undulating(self, dto: NumberDTO) -> bool:\n        digits = dto.digits\n        if len(digits) < self.MIN_DIGITS:\n            return False\n        a, b = digits[0], digits[1]\n        if a == b:\n            return False\n        for i, d in enumerate(digits):\n            expected = a if i % 2 == 0 else b\n            if d != expected:\n                return False\n        return True\n\ndef is_undulating(n: int | str) -> bool:\n    \"\"\"\n    Checks if a given number (integer or numeric string) is undulating.\n    An undulating number alternates between exactly two distinct digits (e.g., 1212121).\n    \"\"\"\n    parser = NumberParser()\n    dto = parser.parse(n)\n    checker = UndulatingChecker()\n    return checker.is_undulating(dto)"}
{"task_id": "Mbpp/93", "solution": "import math\nfrom .services import PowerService\nfrom .repository import PowerRepository\nfrom .config import HISTORY_ENABLED, HISTORY_PATH\n\ndef power(a: float, b: int) -> float:\n    \"\"\"\n    Calculates 'a' to the power 'b' using the PowerService.\n    Optionally persists the calculation if history is enabled.\n    \"\"\"\n    repo = PowerRepository(HISTORY_PATH) if HISTORY_ENABLED else None\n    svc = PowerService(repo=repo)\n    return svc.calculate(a, b)"}
