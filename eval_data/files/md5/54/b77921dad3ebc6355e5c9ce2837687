{"task_id": "Mbpp/603", "solution": "def get_ludic(limit):\n    \"\"\"\n    Computes all lucid (ludic) numbers up to and including the given limit\n    using a sieve-like algorithm.\n    \"\"\"\n    if limit < 1:\n        return []\n\n    numbers_to_sieve = list(range(2, limit + 1))\n    ludic_numbers = [1]\n\n    while numbers_to_sieve:\n        p = numbers_to_sieve.pop(0)\n        if p > limit:\n            break\n        ludic_numbers.append(p)\n\n        # Remove every p-th element from the remaining sequence (1-based indexing)\n        numbers_to_sieve = [x for idx, x in enumerate(numbers_to_sieve, start=1) if idx % p != 0]\n\n    return [x for x in ludic_numbers if x <= limit]"}
{"task_id": "Mbpp/604", "solution": "import collections\ndef reverse_words(text: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, where words are separated by spaces.\n    Multiple spaces are treated as single separators, and leading/trailing spaces are trimmed.\n    \"\"\"\n    words = collections.deque()\n    current_word = []\n    \n    # Process the string to extract words, handling multiple spaces\n    for char in text:\n        if char == ' ':\n            if current_word:\n                words.append(\"\".join(current_word))\n                current_word = []\n        else:\n            current_word.append(char)\n    \n    if current_word:\n        words.append(\"\".join(current_word))\n        \n    return \" \".join(reversed(words))"}
{"task_id": "Mbpp/602", "solution": "import collections\n\ndef first_repeated_char(text: str) -> str:\n    \"\"\"\n    Finds the first character that appears more than once in the string.\n    The order of characters is preserved for both the first appearance and subsequent repeats.\n    \"\"\"\n    seen = collections.OrderedDict()\n    for char in text:\n        if char in seen:\n            return char\n        seen[char] = True\n    return None"}
