{"task_id": "Mbpp/612", "solution": "from typing import List, Any\n\ndef merge(pairs: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Transforms a list of 2-element sublists into two lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in pairs:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/615", "solution": "import math\n\ndef average_tuple(data):\n    \"\"\"\n    Computes the average for each column in a tuple of tuples.\n\n    Assumes input 'data' is a non-empty tuple of non-empty tuples of numbers,\n    where all inner tuples have the same length.\n    \"\"\"\n    if not data:\n        # This case should be handled by validators in a real system,\n        # but for this specific function, we derive behavior from sum()/len().\n        # However, for column-wise average, if data is empty, num_cols is undefined.\n        # Following the assertion, let's assume valid input.\n        pass # The design context implies validation happens before this service method.\n\n    num_rows = len(data)\n    num_cols = len(data[0])\n    \n    # Initialize sums for each column\n    column_sums = [0.0] * num_cols\n\n    # Sum values column-wise\n    for row in data:\n        for i in range(num_cols):\n            column_sums[i] += row[i]\n\n    # Calculate averages\n    averages = [s / num_rows for s in column_sums]\n    \n    # Rounding is not part of this specific function's requirement based on the example,\n    # it's handled by 'compute_with_precision' in AverageService.\n    # The assert output implies some rounding in the example, but the question is\n    # to return the average, which naturally can be float.\n    # The example given `[30.5, 34.25, 27.0, 23.25]` implies the float division is exact enough.\n\n    return averages"}
{"task_id": "Mbpp/616", "solution": "from typing import Tuple\n\ndef tuple_modulo(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    It assumes inputs are valid and of equal length.\n    \"\"\"\n    result = [ai % bi for ai, bi in zip(a, b)]\n    return tuple(result)"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple, Any, Iterable, Iterator\n\ndef to_int(value: Any) -> int:\n    \"\"\"Converts a value to an integer, assuming it's an int, integral float, or parseable string.\"\"\"\n    return int(value)\n\ndef flatten_tuple_list(items: Iterable[Tuple[Any, ...]]) -> Iterator[int]:\n    \"\"\"Flattens an iterable of tuples into an iterator of integers.\"\"\"\n    for seq in items:\n        for v in seq:\n            yield to_int(v)\n\ndef cummulative_sum(tuple_list: List[Tuple[Any, ...]]) -> int:\n    \"\"\"Calculates the cumulative sum of all numeric values in a list of tuples.\"\"\"\n    total = 0\n    for v in flatten_tuple_list(tuple_list):\n        total += v\n    return total"}
{"task_id": "Mbpp/619", "solution": "def is_ascii_digit(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII digit.\"\"\"\n    return len(ch) == 1 and '0' <= ch <= '9'\n\ndef move_num(input_str: str) -> str:\n    \"\"\"\n    Moves all ASCII digits in the input string to the end, preserving\n    the relative order of non-digit characters and digits.\n    \"\"\"\n    non_digits: list[str] = []\n    digits: list[str] = []\n\n    for char in input_str:\n        if is_ascii_digit(char):\n            digits.append(char)\n        else:\n            non_digits.append(char)\n\n    return ''.join(non_digits) + ''.join(digits)"}
{"task_id": "Mbpp/620", "solution": "import collections\nfrom typing import List\n\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where for every pair (a, b)\n    in the subset, either a divides b or b divides a.\n    Divisibility is based on absolute values. Duplicates are ignored.\n    \"\"\"\n    if not nums:\n        return 0\n\n    # Separate zeros and process non-zero numbers\n    has_zero = False\n    processed_nums_set = set()\n    for x in nums:\n        if x == 0:\n            has_zero = True\n        else:\n            processed_nums_set.add(abs(x))\n\n    # If only zeros were in the input (e.g., [0, 0, 0]), the largest subset is {0}, size 1.\n    # If no non-zero numbers remain after processing, return 1 if zero was present, else 0.\n    if not processed_nums_set:\n        return 1 if has_zero else 0\n\n    # Sort the unique positive numbers in ascending order for dynamic programming.\n    sorted_unique_positive_nums = sorted(list(processed_nums_set))\n    n = len(sorted_unique_positive_nums)\n\n    # dp[i] stores the length of the largest divisible subset ending with sorted_unique_positive_nums[i].\n    dp = [1] * n\n    max_len = 1\n\n    for i in range(n):\n        current_num = sorted_unique_positive_nums[i]\n        for j in range(i):\n            prev_num = sorted_unique_positive_nums[j]\n            # Since numbers are sorted and all positive, current_num >= prev_num.\n            # We check if current_num is divisible by prev_num.\n            if current_num % prev_num == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_len = max(max_len, dp[i])\n\n    # If a zero was present, it can extend the longest chain of non-zero numbers by one.\n    # This is because zero is divisible by any non-zero number.\n    if has_zero:\n        return max_len + 1\n    else:\n        return max_len"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers: list, n: int) -> list:\n    \"\"\"Computes the n-th power of each number in a list.\n\n    It preserves integer types for non-negative integer exponents, otherwise it uses float results.\n    \"\"\"\n    results = []\n    for x in numbers:\n        # Replicating the logic from utils.safe_pow to ensure predictable typing.\n        # If both base and exponent are integers and exponent is non-negative, preserve integer type.\n        if isinstance(x, int) and isinstance(n, int) and n >= 0:\n            results.append(pow(x, n))\n        # Otherwise, use float exponentiation for fractional or negative exponents.\n        else:\n            results.append(float(x) ** n)\n    return results"}
{"task_id": "Mbpp/626", "solution": "import math\nfrom typing import Any, Optional\n\nEPSILON = 1e-12\n\ndef is_number(value: Any) -> bool:\n    \"\"\"Checks if a value is a finite int or float.\"\"\"\n    if not isinstance(value, (int, float)):\n        return False\n    if isinstance(value, float) and not math.isfinite(value):\n        return False\n    return True\n\nclass InputValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input radius.\"\"\"\n    def validate_radius(self, radius: Any) -> float:\n        if not is_number(radius):\n            raise InputValidationError(\"radius must be numeric\")\n        r = float(radius)\n        if r <= EPSILON:\n            raise InputValidationError(\"radius must be > 0\")\n        return r\n\nclass TriangleCalculator:\n    \"\"\"Computes the maximum triangle area inscribed in a semicircle.\"\"\"\n    def max_inscribed_triangle_area(self, radius: float) -> float:\n        # Mathematical result for semicircle: max area = R^2\n        return float(radius * radius)\n\n    def compute_triangle_area(self, base: float, height: float) -> float:\n        return 0.5 * base * height\n\nclass TriangleController:\n    \"\"\"Public API controller for calculating triangle area.\"\"\"\n    def __init__(self, validator: InputValidator = None, calculator: TriangleCalculator = None) -> None:\n        self._validator = validator or InputValidator()\n        self._calculator = calculator or TriangleCalculator()\n\n    def triangle_area(self, radius: float) -> Optional[float]:\n        try:\n            r = self._validator.validate_radius(radius)\n            return self._calculator.max_inscribed_triangle_area(r)\n        except InputValidationError:\n            return None\n        except Exception:\n            # Defensive: translate unexpected errors to None for API.\n            return None\n\ndef triangle_area(radius: float) -> Optional[float]:\n    \"\"\"\n    Calculates the area of the largest triangle that can be inscribed\n    in a semicircle with a given radius. Returns None for invalid input.\n    \"\"\"\n    return TriangleController().triangle_area(radius)"}
{"task_id": "Mbpp/624", "solution": "import sys\nfrom typing import List, Optional, Any\n\nclass InvalidStringError(Exception):\n    \"\"\"Raised when the input string is invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass StringValidator:\n    \"\"\"Validates input to ensure it is a string.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, text: Any) -> None:\n        \"\"\"Validates that the input is a string.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidStringError(f\"Expected str, got {type(text).__name__}\")\n\nclass StringRepositoryInterface:\n    \"\"\"Interface for string conversion history repositories.\"\"\"\n    def save(self, original: str, result: str) -> None:\n        raise NotImplementedError\n\n    def list(self, limit: int = 100) -> List[dict]:\n        raise NotImplementedError\n\nclass InMemoryStringRepository(StringRepositoryInterface):\n    \"\"\"An in-memory repository for storing string conversion history.\"\"\"\n    def __init__(self, limit: int = 100) -> None:\n        self._limit = limit\n        self._store = []\n\n    def save(self, original: str, result: str) -> None:\n        \"\"\"Saves a conversion record to the in-memory store.\"\"\"\n        self._store.insert(0, {\"original\": original, \"result\": result})\n        if len(self._store) > self._limit:\n            self._store = self._store[:self._limit]\n\n    def list(self, limit: int = 100) -> List[dict]:\n        \"\"\"Lists the most recent conversion records.\"\"\"\n        return self._store[:limit]\n\nclass StringService:\n    \"\"\"Provides string conversion functionality and optional history recording.\"\"\"\n    def __init__(self, repository: Optional[StringRepositoryInterface] = None) -> None:\n        self._validator = StringValidator()\n        self._repository = repository or InMemoryStringRepository()\n\n    def to_upper(self, text: str) -> str:\n        \"\"\"Converts the given string to uppercase and saves the operation.\"\"\"\n        self._validator.validate(text)\n        result = self._convert_upper(text)\n        self._repository.save(text, result)\n        return result\n\n    def _convert_upper(self, text: str) -> str:\n        \"\"\"Performs the actual uppercase conversion.\"\"\"\n        return text.upper()\n\ndef is_upper(s: str) -> str:\n    \"\"\"Converts a given string to uppercase.\n\n    This is a convenience function that uses a default StringService instance.\n    \"\"\"\n    svc = StringService()\n    return svc.to_upper(s)"}
{"task_id": "Mbpp/618", "solution": "from typing import Sequence, Union\n\nclass DivisionError(Exception):\n    \"\"\"Custom exception for division by zero errors.\"\"\"\n    pass\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\n\ndef div_list(a: Sequence[Union[int, float]], b: Sequence[Union[int, float]]) -> list[float]:\n    \"\"\"\n    Divides two lists element-wise, raising exceptions for invalid inputs.\n    Handles length mismatches, non-numeric elements, and division by zero.\n    \"\"\"\n\n    def _is_number(value: object) -> bool:\n        \"\"\"Checks if a value is an int or float, but not a boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    if len(a) != len(b):\n        raise ValidationError(f\"Input lists must have the same length, but got {len(a)} and {len(b)}\")\n\n    processed_a: list[float] = []\n    processed_b: list[float] = []\n\n    for i in range(len(a)):\n        val_a = a[i]\n        val_b = b[i]\n\n        if not _is_number(val_a):\n            raise ValidationError(f\"Element at index {i} in list 'a' is not a number: {val_a}\")\n        if not _is_number(val_b):\n            raise ValidationError(f\"Element at index {i} in list 'b' is not a number: {val_b}\")\n        \n        processed_a.append(float(val_a))\n        processed_b.append(float(val_b))\n\n    result: list[float] = []\n    for i, (x, y) in enumerate(zip(processed_a, processed_b)):\n        if y == 0.0:\n            raise DivisionError(f\"Division by zero at index {i}\")\n        result.append(x / y)\n\n    return result"}
{"task_id": "Mbpp/622", "solution": "def get_median(a: list, b: list, n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    This uses a recursive O(log n) approach to find the k-th element.\n    \"\"\"\n    def find_kth(arr1, l1, h1, arr2, l2, h2, k):\n        \"\"\"\n        Recursively finds the k-th smallest element in the merged sub-arrays.\n        Uses 0-based indexing for array segments [l, h]. k is 1-based.\n        \"\"\"\n        len1 = h1 - l1 + 1\n        len2 = h2 - l2 + 1\n\n        # Ensure arr1 is the shorter array for optimization\n        if len1 > len2:\n            return find_kth(arr2, l2, h2, arr1, l1, h1, k)\n\n        # Base cases\n        if len1 == 0:  # If arr1 is exhausted, k-th element is in arr2\n            return arr2[l2 + k - 1]\n        if k == 1:  # If k is 1, return the smaller of the current heads\n            return min(arr1[l1], arr2[l2])\n\n        # Determine how many elements to \"partition\" from each array\n        # pa is the count of elements to consider from arr1's current segment\n        # pb is the count of elements to consider from arr2's current segment\n        pa = min(k // 2, len1)\n        pb = k - pa\n\n        # Compare elements at the partition points\n        if arr1[l1 + pa - 1] <= arr2[l2 + pb - 1]:\n            # If arr1's partition element is smaller or equal,\n            # it means the first `pa` elements of arr1 can be discarded.\n            # Recurse for k - pa in the remaining segments.\n            return find_kth(arr1, l1 + pa, h1, arr2, l2, h2, k - pa)\n        else:\n            # If arr2's partition element is smaller,\n            # discard the first `pb` elements of arr2.\n            # Recurse for k - pb in the remaining segments.\n            return find_kth(arr1, l1, h1, arr2, l2 + pb, h2, k - pb)\n\n    # For two sorted lists of length n, the combined length is 2n.\n    # The median is the average of the n-th and (n+1)-th smallest elements (1-based).\n    # We call find_kth twice to get these two elements.\n    median1_val = find_kth(a, 0, n - 1, b, 0, n - 1, n)\n    median2_val = find_kth(a, 0, n - 1, b, 0, n - 1, n + 1)\n\n    return (median1_val + median2_val) / 2.0"}
{"task_id": "Mbpp/629", "solution": "from typing import List, Any, Optional\nfrom dataclasses import dataclass\nfrom datetime import datetime\nimport json\nimport os\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str, invalid_value=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.invalid_value = invalid_value\n\nclass RepositoryError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n@dataclass\nclass NumberList:\n    numbers: List[int]\n\n@dataclass\nclass EvenNumbersResult:\n    input_numbers: List[int]\n    evens: List[int]\n    computed_at: datetime\n\ndef is_integer(value: Any) -> bool:\n    return isinstance(value, int)\n\nclass Validator:\n    def validate_number_list(self, numbers: Any) -> List[int]:\n        if numbers is None:\n            raise InvalidInputError(\"Input cannot be None\", invalid_value=None)\n        try:\n            iterable = list(numbers)\n        except TypeError:\n            raise InvalidInputError(\"Input must be iterable\", invalid_value=numbers)\n        for idx, v in enumerate(iterable):\n            if not is_integer(v):\n                raise InvalidInputError(f\"Element at index {idx} is not an integer\", invalid_value=v)\n        return iterable\n\nDEFAULT_PERSISTENCE_PATH = \"even_results.json\"\n\nclass EvenRepository:\n    def __init__(self, path: str = DEFAULT_PERSISTENCE_PATH) -> None:\n        self.path = path\n\n    def save(self, result: EvenNumbersResult) -> None:\n        tmp = f\"{self.path}.tmp\"\n        payload = {\n            \"input\": result.input_numbers,\n            \"evens\": result.evens,\n            \"timestamp\": result.computed_at.isoformat() + \"Z\"\n        }\n        try:\n            with open(tmp, \"w\", encoding=\"utf-8\") as f:\n                json.dump(payload, f)\n            os.replace(tmp, self.path)\n        except Exception as e:\n            raise RepositoryError(str(e)) from e\n\n    def load_last(self) -> Optional[EvenNumbersResult]:\n        try:\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n            input_numbers = data.get(\"input\", [])\n            evens = data.get(\"evens\", [])\n            computed_at_str = data.get(\"timestamp\")\n            computed_at = datetime.fromisoformat(computed_at_str.replace('Z', '+00:00')) if computed_at_str else datetime.utcnow()\n            return EvenNumbersResult(input_numbers=input_numbers, evens=evens, computed_at=computed_at)\n        except FileNotFoundError:\n            return None\n        except Exception as e:\n            raise RepositoryError(str(e)) from e\n\nclass EvenFinderService:\n    def __init__(self, repository: Optional[EvenRepository] = None) -> None:\n        self._repository = repository\n\n    def find_even(self, numbers: List[int]) -> EvenNumbersResult:\n        evens = [n for n in numbers if n % 2 == 0]\n        result = EvenNumbersResult(input_numbers=list(numbers), evens=evens, computed_at=datetime.utcnow())\n        if self._repository:\n            try:\n                self._repository.save(result)\n            except Exception as exc:\n                raise RepositoryError(f\"Failed to save result: {exc}\") from exc\n        return result\n\nclass SplitController:\n    def __init__(self, service: EvenFinderService, validator: Validator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def split(self, numbers: List[int]) -> List[int]:\n        \"\"\"Validates input numbers, finds even numbers, and returns them.\"\"\"\n        nums = self.validator.validate_number_list(numbers)\n        result = self.service.find_even(nums)\n        return result.evens\n\n_default_controller = SplitController(EvenFinderService(), Validator())\n\ndef Split(numbers: List[int]) -> List[int]:\n    \"\"\"Finds even numbers from a list of integers.\"\"\"\n    return _default_controller.split(numbers)"}
{"task_id": "Mbpp/628", "solution": "def replace_spaces(s: str) -> str:\n    \"\"\"\n    Replaces all space characters in the given string with '%20'.\n    \"\"\"\n    out_chars: list[str] = []\n    for ch in s:\n        if ch == \" \":\n            out_chars.append(\"%20\")\n        else:\n            out_chars.append(ch)\n    return \"\".join(out_chars)"}
{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, including the center.\n    The coordinates are returned in row-major order.\n    \"\"\"\n    row, col = coord\n    result = []\n    for r in range(row - 1, row + 2):\n        for c in range(col - 1, col + 2):\n            result.append([r, c])\n    return result"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(text: str, direction: str = \"underscore\") -> str:\n    \"\"\"Replaces whitespaces with an underscore or vice versa in a given string.\"\"\"\n    if direction == \"underscore\":\n        # Replace any whitespace character (including tabs, newlines) with an underscore.\n        return \"\".join('_' if char.isspace() else char for char in text)\n    else:\n        # Replace literal underscore characters with a space.\n        return text.replace(\"_\", \" \")"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    This uses an O(N * B) bitwise approach, where B is the number of bits.\n    \"\"\"\n    MAX_BITS = 64  # Default bit width to consider for the numbers.\n    total_xor_sum = 0\n\n    # The parameter 'n' is the length of the 'nums' list; we use len(nums) for consistency.\n    list_len = len(nums) \n\n    for b in range(MAX_BITS):\n        # Count how many numbers in the list have the b-th bit set.\n        count_set_bits = 0\n        for num in nums:\n            if (num >> b) & 1:\n                count_set_bits += 1\n        \n        # Count how many numbers in the list have the b-th bit unset.\n        count_unset_bits = list_len - count_set_bits\n        \n        # Each pair of (set_bit_num, unset_bit_num) contributes (1 << b) to the total XOR sum\n        # because their XOR will have the b-th bit set.\n        total_xor_sum += (count_set_bits * count_unset_bits) * (1 << b)\n            \n    return total_xor_sum"}
