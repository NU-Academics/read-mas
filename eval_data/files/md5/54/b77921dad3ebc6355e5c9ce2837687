{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(arr: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where\n    every other element appears exactly twice.\n    \"\"\"\n    if len(arr) == 1:\n        return arr[0]\n\n    low, high = 0, len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        \n        # If mid is an even index\n        if mid % 2 == 0:\n            # If element at mid is same as element at mid+1,\n            # the unique element is to the right of this pair.\n            if arr[mid] == arr[mid+1]:\n                low = mid + 2\n            # Otherwise, the unique element is at or before mid.\n            else:\n                high = mid\n        # If mid is an odd index\n        else:\n            # If element at mid is same as element at mid-1,\n            # the unique element is to the right of this pair.\n            if arr[mid] == arr[mid-1]:\n                low = mid + 1\n            # Otherwise, the unique element is at or before mid-1.\n            else:\n                high = mid - 1\n                \n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import List, Tuple, Optional\n\ndef max_product_tuple(tuples_list: List[Tuple[int, int]]) -> Optional[int]:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not tuples_list:\n        return None\n\n    max_abs_product = -1.0 # Initialize with a value guaranteed to be smaller than any valid product\n\n    for tuple_pair in tuples_list:\n        product = tuple_pair[0] * tuple_pair[1]\n        abs_product = abs(product)\n\n        if abs_product > max_abs_product:\n            max_abs_product = abs_product\n            \n    # The requirement assertion implies integer output if the inputs are integers.\n    # Check if the result is effectively an integer and convert if so.\n    if max_abs_product == math.floor(max_abs_product):\n        return int(max_abs_product)\n    return max_abs_product"}
{"task_id": "Mbpp/124", "solution": "import math\n\nclass InvalidComplexError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n    def __str__(self) -> str:\n        return f\"InvalidComplexError: {self.message}\"\n\nclass ComplexNumber:\n    def __init__(self, real: float, imag: float):\n        self._real = real\n        self._imag = imag\n\n    @property\n    def real(self) -> float:\n        return self._real\n\n    @property\n    def imag(self) -> float:\n        return self._imag\n\n    @classmethod\n    def from_parts(cls, real: float, imag: float) -> \"ComplexNumber\":\n        return cls(float(real), float(imag))\n\n    @classmethod\n    def from_complex(cls, z: complex) -> \"ComplexNumber\":\n        return cls(float(z.real), float(z.imag))\n\n    def is_zero(self) -> bool:\n        return self._real == 0.0 and self._imag == 0.0\n\nclass Validator:\n    def validate_and_convert(self, z, imag=None) -> ComplexNumber:\n        if imag is None and isinstance(z, complex):\n            cn = ComplexNumber.from_complex(z)\n        elif imag is not None:\n            try:\n                real_f = float(z)\n                imag_f = float(imag)\n            except (TypeError, ValueError):\n                raise TypeError(\"real and imag must be numbers\")\n            if not (self.is_finite_and_not_nan(real_f) and self.is_finite_and_not_nan(imag_f)):\n                raise InvalidComplexError(\"NaN values are not allowed\")\n            cn = ComplexNumber.from_parts(real_f, imag_f)\n        else:\n            raise TypeError(\"Unsupported call signature for angle_complex\")\n        if not (self.is_finite_and_not_nan(cn.real) and self.is_finite_and_not_nan(cn.imag)):\n            raise InvalidComplexError(\"NaN values are not allowed\")\n        return cn\n\n    def is_finite_and_not_nan(self, value: float) -> bool:\n        return not math.isnan(value)\n\nclass AngleCalculator:\n    def compute_angle(self, c: ComplexNumber) -> float:\n        if c.is_zero():\n            return 0.0\n        return math.atan2(c.imag, c.real)\n\n    def compute_from_parts(self, real: float, imag: float) -> float:\n        return self.compute_angle(ComplexNumber.from_parts(real, imag))\n\nclass AngleAPI:\n    def __init__(self, validator: Validator = None, calculator: AngleCalculator = None):\n        self.validator = validator or Validator()\n        self.calculator = calculator or AngleCalculator()\n\n    def angle_complex(self, z, imag=None) -> float:\n        c = self.validator.validate_and_convert(z, imag)\n        return self.calculator.compute_angle(c)\n\n_api = AngleAPI()\ndef angle_complex(z, imag=None) -> float:\n    return _api.angle_complex(z, imag)"}
{"task_id": "Mbpp/123", "solution": "import collections\nimport math\nfrom typing import Optional, Protocol, Dict\n\nclass InvalidParameterError(Exception):\n    pass\n\nAmicablePair = collections.namedtuple(\"AmicablePair\", [\"a\", \"b\"])\n\ndef proper_divisors_sum(n: int) -> int:\n    \"\"\"Return sum of proper divisors of n.\"\"\"\n    if n < 1:\n        return 0\n    if n == 1:\n        return 0\n\n    s = 1\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            s += i\n            if i * i != n:\n                s += n // i\n    return s\n\nclass IDivisorCacheRepository(Protocol):\n    def get(self, n: int) -> Optional[int]:\n        ...\n    def set(self, n: int, value: int) -> None:\n        ...\n    def contains(self, n: int) -> bool:\n        ...\n\nclass DivisorCacheRepository:\n    def __init__(self, initial: Optional[Dict[int, int]] = None) -> None:\n        self._cache: Dict[int, int] = dict(initial or {})\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\n    def contains(self, n: int) -> bool:\n        return n in self._cache\n\nclass AmicableService:\n    def __init__(self, repo: IDivisorCacheRepository) -> None:\n        self._repo = repo\n\n    def _divisor_sum(self, n: int) -> int:\n        \"\"\"Retrieve divisor sum from cache or compute and store it.\"\"\"\n        v = self._repo.get(n)\n        if v is None:\n            v = proper_divisors_sum(n)\n            self._repo.set(n, v)\n        return v\n\n    def find_amicable_pairs(self, limit: int) -> list[AmicablePair]:\n        \"\"\"Find all amicable pairs (a,b) where a < b and both are <= limit.\"\"\"\n        pairs = []\n        for i in range(2, limit + 1):\n            s = self._divisor_sum(i)\n            # Check for amicable condition: s != i, s > 1, partner_sum == i, i < s, partner <= limit.\n            if s != i and s > 1 and s <= limit:\n                if self._divisor_sum(s) == i and i < s:\n                    pairs.append(AmicablePair(a=i, b=s))\n        return pairs\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        \"\"\"Calculate the sum of all unique amicable numbers up to the limit.\"\"\"\n        pairs = self.find_amicable_pairs(limit)\n        total = sum(p.a + p.b for p in pairs)\n        return total\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Sum all amicable numbers from 1 to a specified number.\"\"\"\n    repo = DivisorCacheRepository()\n    service = AmicableService(repo)\n    return service.amicable_numbers_sum(limit)"}
{"task_id": "Mbpp/127", "solution": "from typing import Any, Optional\n\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str, value=None):\n        super().__init__(message)\n        self.message = message\n        self.value = value\n\n    def __str__(self) -> str:\n        return f\"{self.message}: {self.value!r}\"\n\nclass ValidationService:\n    def __init__(self, logger: Optional[object] = None):\n        self._logger = logger\n\n    def validate_int(self, value: Any, name: str) -> int:\n        if not isinstance(value, int):\n            raise InvalidInputError(f\"Expected integer for {name}\", value)\n        return value\n\n    def parse_int_str(self, s: str, name: str) -> int:\n        try:\n            v = int(s)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Unable to parse integer for {name}\", s)\n        return self.validate_int(v, name)\n\nclass IntegerMultiplier:\n    def __init__(self, validator: ValidationService):\n        self.validator = validator\n\n    def multiply_int(self, a: int, b: int) -> int:\n        a_val = self.validator.validate_int(a, \"a\")\n        b_val = self.validator.validate_int(b, \"b\")\n        return a_val * b_val\n\n_default_validator = ValidationService()\n_default_service = IntegerMultiplier(_default_validator)\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Multiplies two integers after validating their types.\n    Raises InvalidInputError if inputs are not integers.\"\"\"\n    return _default_service.multiply_int(a, b)"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the count of 0s and 1s in any substring\n    of the given binary string using Kadane's algorithm.\n    \"\"\"\n    if not s:\n        return 0\n\n    # Initialize max_so_far to negative infinity to handle cases where all differences are negative (e.g., \"111\").\n    max_so_far = float('-inf')\n    current_max = 0\n\n    for char in s:\n        # Map '0' to +1 and '1' to -1\n        val = 1 if char == '0' else -1\n\n        # Kadane's algorithm:\n        # The current maximum sum ending at the current position is either the current value itself,\n        # or the current value added to the previous current_max sum.\n        current_max = max(val, current_max + val)\n        \n        # The overall maximum sum found so far.\n        max_so_far = max(max_so_far, current_max)\n\n    return int(max_so_far)"}
{"task_id": "Mbpp/126", "solution": "import math\nfrom typing import List\n\ndef sum_common_divisors(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of common positive divisors of two integers.\n    Handles absolute values and the special case of (0, 0).\n    \"\"\"\n\n    def _divisors(n: int) -> List[int]:\n        \"\"\"Finds all positive divisors of a non-negative integer.\"\"\"\n        n = abs(n)\n        if n == 0:\n            return []\n        result = set()\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                result.add(i)\n                result.add(n // i)\n            i += 1\n        return sorted(list(result))\n\n    # Normalize inputs to their absolute integer values, as per design for divisor computation.\n    a_norm, b_norm = abs(a), abs(b)\n\n    # Business decision: For (0, 0), the sum of common positive divisors is 0.\n    if a_norm == 0 and b_norm == 0:\n        return 0\n\n    # The common divisors of two numbers are the divisors of their greatest common divisor (GCD).\n    # math.gcd efficiently computes the GCD, returning a non-negative integer.\n    common_divisor_gcd = math.gcd(a_norm, b_norm)\n\n    # Find all positive divisors of the GCD.\n    divs = _divisors(common_divisor_gcd)\n\n    # Sum the found divisors.\n    return sum(divs)"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"Calculates whether the given matrix is a normal magic square.\n    Checks for square shape, non-empty, unique numbers 1..n*n, and equal sums across rows, columns, and diagonals.\"\"\"\n\n    def _validate_structure(m: List[List[int]]) -> bool:\n        \"\"\"Checks if the input is a non-empty square matrix.\"\"\"\n        if not m or not m[0]:\n            return False\n        n = len(m)\n        for row in m:\n            if len(row) != n:\n                return False\n        return True\n\n    def _as_flat_list(m: List[List[int]]) -> List[int]:\n        \"\"\"Flattens the matrix into a single list of elements.\"\"\"\n        return [item for sublist in m for item in sublist]\n\n    def _get_row(m: List[List[int]], i: int) -> List[int]:\n        \"\"\"Returns the elements of the specified row.\"\"\"\n        return m[i]\n\n    def _get_col(m: List[List[int]], j: int, n_val: int) -> List[int]:\n        \"\"\"Returns the elements of the specified column.\"\"\"\n        return [m[i][j] for i in range(n_val)]\n\n    def _get_main_diagonal(m: List[List[int]], n_val: int) -> List[int]:\n        \"\"\"Returns the elements of the main diagonal (top-left to bottom-right).\"\"\"\n        return [m[i][i] for i in range(n_val)]\n\n    def _get_secondary_diagonal(m: List[List[int]], n_val: int) -> List[int]:\n        \"\"\"Returns the elements of the secondary diagonal (top-right to bottom-left).\"\"\"\n        return [m[i][n_val - 1 - i] for i in range(n_val)]\n\n    def _sum_list(values: List[int]) -> int:\n        \"\"\"Calculates the sum of elements in a list.\"\"\"\n        return sum(values)\n\n    if not _validate_structure(matrix):\n        return False\n\n    n = len(matrix)\n\n    # A 1x1 normal magic square must contain the number 1.\n    if n == 1:\n        return matrix[0][0] == 1\n\n    # Calculate the target sum from the first row.\n    target_sum = _sum_list(_get_row(matrix, 0))\n\n    # Check sums of all rows.\n    for i in range(n):\n        if _sum_list(_get_row(matrix, i)) != target_sum:\n            return False\n\n    # Check sums of all columns.\n    for j in range(n):\n        if _sum_list(_get_col(matrix, j, n)) != target_sum:\n            return False\n\n    # Check sum of the main diagonal.\n    if _sum_list(_get_main_diagonal(matrix, n)) != target_sum:\n        return False\n\n    # Check sum of the secondary diagonal.\n    if _sum_list(_get_secondary_diagonal(matrix, n)) != target_sum:\n        return False\n\n    # Check if elements are unique and form the sequence 1 to n*n.\n    flat_list = _as_flat_list(matrix)\n    expected_elements = set(range(1, n * n + 1))\n    if set(flat_list) != expected_elements:\n        return False\n\n    return True"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string, where 'y' is not considered a vowel.\n    Consonants and other characters remain in their original positions.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\n    found_vowels = []\n    for char in s:\n        if char in VOWELS:\n            found_vowels.append(char)\n\n    if not found_vowels:\n        return s\n\n    # Use a list for reversed vowels and pop from the end for O(1) retrieval\n    # or iterate using a separate index. The current approach with list(reversed(...))\n    # and then an index is clear and efficient enough for O(N).\n    reversed_vowels_iter = iter(reversed(found_vowels))\n    \n    result_chars = []\n    for char in s:\n        if char in VOWELS:\n            result_chars.append(next(reversed_vowels_iter))\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/130", "solution": "import collections\n\ndef max_occurrences(items):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    In case of a tie in frequency, the item that appears earliest in the list is returned.\n    \"\"\"\n    counts = collections.Counter(items)\n\n    # Assuming 'items' is not an empty list based on the assertion example provided.\n    # If 'items' were empty, max(counts.values()) would raise a ValueError.\n    max_count = max(counts.values())\n\n    # Collect all items that share the maximum frequency.\n    candidates = {item for item, count in counts.items() if count == max_count}\n\n    # Iterate through the original list to find the first occurring candidate,\n    # ensuring deterministic tie-breaking by earliest appearance.\n    for item in items:\n        if item in candidates:\n            return item"}
{"task_id": "Mbpp/132", "solution": "from typing import Any, Tuple, Optional\n\nclass ConversionError(Exception):\n    \"\"\"Base exception for conversion-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(ConversionError):\n    \"\"\"Exception raised for invalid input data during validation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TupleValidator:\n    \"\"\"Validates if input is an iterable of single-character strings within length limits.\"\"\"\n    DEFAULT_MAX_LENGTH: int = 10000\n\n    def __init__(self, max_length: Optional[int] = None) -> None:\n        self._max_length = max_length or self.DEFAULT_MAX_LENGTH\n\n    def validate(self, tup: Any) -> Tuple[str, ...]:\n        if not hasattr(tup, \"__iter__\"):\n            raise ValidationError(\"Input is not iterable\")\n        items = tuple(tup)\n        if len(items) > self._max_length:\n            raise ValidationError(\"Input exceeds maximum allowed length\")\n        for i, el in enumerate(items):\n            if not isinstance(el, str):\n                raise ValidationError(f\"Element at index {i} is not a string\")\n            if len(el) != 1:\n                raise ValidationError(f\"Element at index {i} is not a single character\")\n        return items\n\nclass TupleConverter:\n    \"\"\"Converts a tuple of strings into a single concatenated string.\"\"\"\n    def __init__(self, separator: str = \"\") -> None:\n        self._separator = separator\n\n    def convert(self, tup: Tuple[str, ...]) -> str:\n        try:\n            return self._separator.join(tup)\n        except Exception as exc:\n            raise ConversionError(f\"Conversion failed: {exc}\") from exc\n\nclass ConverterController:\n    \"\"\"Orchestrates validation and conversion of tuples to strings.\"\"\"\n    def __init__(self, validator: TupleValidator, converter: TupleConverter) -> None:\n        self.validator = validator\n        self.converter = converter\n\n    def to_string(self, tup: Any) -> str:\n        validated = self.validator.validate(tup)\n        return self.converter.convert(validated)\n\ndef tup_string(tup: tuple) -> str:\n    \"\"\"Converts a tuple of single-character strings to a concatenated string.\"\"\"\n    controller = ConverterController(TupleValidator(), TupleConverter())\n    return controller.to_string(tup)"}
{"task_id": "Mbpp/128", "solution": "import string\nimport json\nimport os\nimport tempfile\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import List, Sequence, Optional, Any\n\n# --- Exceptions ---\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for errors during persistence operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n# --- Config ---\nDEFAULT_PERSISTENCE_PATH = \"./.longwords_history.json\"\n\n@dataclass\nclass Config:\n    \"\"\"Configuration settings for the long words extraction.\"\"\"\n    strip_punctuation: bool = True\n    persistence_enabled: bool = False\n    persistence_path: str = DEFAULT_PERSISTENCE_PATH\n    max_history: int = 100\n    preserve_case: bool = True\n\n    def to_dict(self) -> dict:\n        return self.__dict__\n\n    @classmethod\n    def from_dict(cls, d: dict) -> \"Config\":\n        return cls(**d)\n\n# --- Models ---\nclass LongWordsRequest:\n    \"\"\"Data transfer object for a long words request.\"\"\"\n    def __init__(self, n: int, input_data: str | Sequence[str]) -> None:\n        self.n = n\n        self.input_data = input_data\n\nclass LongWordsResponse:\n    \"\"\"Data transfer object for a long words response.\"\"\"\n    def __init__(self, results: List[str]) -> None:\n        self.results = results\n        self.count = len(results)\n\nclass PersistRecord:\n    \"\"\"Structure for a persisted query record.\"\"\"\n    def __init__(self, timestamp: str, n: int, input_summary: str, results: List[str]) -> None:\n        self.timestamp = timestamp\n        self.n = n\n        self.input_summary = input_summary\n        self.results = results\n\n# --- Utils (WordFilter) ---\nPUNCTUATION_CHARS = string.punctuation\n\nclass WordFilter:\n    \"\"\"Handles tokenization, cleaning, and filtering of words.\"\"\"\n    def __init__(self, config: Config):\n        self.config = config\n\n    def tokenize(self, text: str) -> list[str]:\n        return text.split()\n\n    def clean_token(self, token: str) -> str:\n        if self.config.strip_punctuation:\n            token = token.strip(PUNCTUATION_CHARS)\n        return token if self.config.preserve_case else token.lower()\n\n    def filter_long(self, tokens: Sequence[str], n: int) -> list[str]:\n        \"\"\"Filters tokens, returning only those strictly longer than n after cleaning.\"\"\"\n        cleaned = [self.clean_token(t) for t in tokens]\n        return [t for t in cleaned if len(t) > n]\n\n# --- Repositories ---\nclass InMemoryRepository:\n    \"\"\"In-memory storage for query history, with a maximum capacity.\"\"\"\n    def __init__(self, max_items: int = 100):\n        self.max_items = max_items\n        self.records: List[PersistRecord] = []\n\n    def add(self, record: PersistRecord) -> None:\n        \"\"\"Adds a record to the repository, trimming if capacity is exceeded.\"\"\"\n        self.records.insert(0, record)\n        self.records = self.records[: self.max_items]\n\n    def list_all(self) -> List[PersistRecord]:\n        return list(self.records)\n\nclass FileRepositoryAdapter:\n    \"\"\"Adapter to save and load records from a JSON file using atomic writes.\"\"\"\n    def __init__(self, path: str):\n        self.path = path\n\n    def save(self, records: List[PersistRecord]) -> None:\n        \"\"\"Serializes records to JSON and atomically writes them to a file.\"\"\"\n        data = [r.__dict__ for r in records]\n        s = json.dumps(data, ensure_ascii=False, indent=2)\n        self._atomic_write(self.path, s)\n\n    def load(self) -> List[PersistRecord]:\n        \"\"\"Loads and deserializes records from a JSON file, handling file absence.\"\"\"\n        if not os.path.exists(self.path):\n            return []\n        try:\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                raw_data = json.load(f)\n                return [PersistRecord(**d) for d in raw_data]\n        except (OSError, json.JSONDecodeError) as e:\n            raise PersistenceError(str(e))\n\n    def _atomic_write(self, path: str, data: str) -> None:\n        \"\"\"Writes data to a temporary file then renames it to ensure atomicity.\"\"\"\n        dirpath = os.path.dirname(path) or \".\"\n        fd, tmp_path = tempfile.mkstemp(dir=dirpath)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                f.write(data)\n            os.replace(tmp_path, path)\n        except OSError as e:\n            raise PersistenceError(str(e))\n\n# --- Services ---\nclass LongWordsService:\n    \"\"\"Orchestrates operations for long-words extraction and optional persistence.\"\"\"\n    def __init__(self, config: Config, repository: Optional[InMemoryRepository] = None):\n        self.config = config\n        self.filter = WordFilter(config)\n        self.repo = repository if repository is not None else (InMemoryRepository(config.max_history) if config.persistence_enabled else None)\n        self.file_adapter = FileRepositoryAdapter(config.persistence_path) if config.persistence_enabled else None\n\n        if self.config.persistence_enabled and self.repo and self.file_adapter:\n            try:\n                loaded_records = self.file_adapter.load()\n                # Ensure the loaded records don't exceed max_history when added sequentially.\n                # Adding to repo (which trims) in reverse order ensures newest are kept.\n                for record in reversed(loaded_records): # Add oldest first to respect max_history if any\n                    self.repo.add(record)\n            except PersistenceError:\n                pass # Fail-safe: ignore loading errors\n\n    def _validate_inputs(self, n: int, text: Any) -> None:\n        \"\"\"Validates input parameters for n and text, raising InvalidInputError on failure.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(\"n must be a non-negative integer\")\n        if not (isinstance(text, str) or (hasattr(text, \"__iter__\") and all(isinstance(t, str) for t in text))):\n            raise InvalidInputError(\"text must be a string or a sequence of strings\")\n\n    def find_long_words(self, n: int, text: str | Sequence[str]) -> LongWordsResponse:\n        \"\"\"Finds words longer than n characters from the given text.\"\"\"\n        self._validate_inputs(n, text)\n        original_input_for_summary = text\n\n        if not isinstance(text, str):\n            text = \" \".join(text)\n\n        tokens = self.filter.tokenize(text)\n        results = self.filter.filter_long(tokens, n)\n\n        if self.config.persistence_enabled and self.repo is not None:\n            if isinstance(original_input_for_summary, str):\n                input_summary = original_input_for_summary[:200]\n            else: # Sequence[str]\n                input_summary = \" \".join(original_input_for_summary)[:200]\n            \n            record = PersistRecord(datetime.utcnow().isoformat(timespec='seconds') + \"Z\", n, input_summary, results)\n            try:\n                self.repo.add(record)\n                if self.file_adapter:\n                    self.file_adapter.save(self.repo.list_all())\n            except PersistenceError:\n                pass # fail-safe: ignore persistence errors\n\n        return LongWordsResponse(results)\n\n# --- Controllers ---\nclass LibraryController:\n    \"\"\"Controller for direct library usage of the long words service.\"\"\"\n    def __init__(self, service: LongWordsService):\n        self.service = service\n\n    def execute(self, n: int, text: str | Sequence[str]) -> List[str]:\n        \"\"\"Executes the long words search and returns a list of results.\"\"\"\n        response = self.service.find_long_words(n, text)\n        return response.results\n\n# --- Main Function ---\ndef long_words(n, text) -> list[str]:\n    \"\"\"Finds words that are longer than n characters from a given list of words.\"\"\"\n    cfg = Config()\n    svc = LongWordsService(cfg)\n    controller = LibraryController(svc)\n    return controller.execute(n, text)"}
