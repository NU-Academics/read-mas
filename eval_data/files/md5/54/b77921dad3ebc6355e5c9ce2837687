{"task_id": "Mbpp/94", "solution": "import typing\n\ndef index_minimum(items: typing.Iterable[typing.Sequence]) -> typing.Any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value from an iterable of tuples.\n    Assumes items is non-empty and contains sequences with at least two elements for comparison.\n    \"\"\"\n    iterator = iter(items)\n    \n    # Get the first item to initialize min_item and min_value.\n    # If `items` is empty, this will raise StopIteration.\n    first_item = next(iterator) \n    \n    min_item = first_item\n    key_index_for_comparison = 1 # Problem specifies \"smallest second value\"\n    min_value = first_item[key_index_for_comparison]\n    \n    # Iterate through the rest of the items to find the minimum.\n    for item in iterator:\n        # If an item has insufficient length or types are incomparable, a standard Python exception will be raised.\n        if item[key_index_for_comparison] < min_value:\n            min_item = item\n            min_value = item[key_index_for_comparison]\n            \n    # Return the first element (index 0) of the tuple with the smallest comparison value.\n    return min_item[0]"}
{"task_id": "Mbpp/97", "solution": "import collections\nfrom typing import List, Any, Dict\n\ndef frequency_lists(lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    The input is flattened one level deep, and counts are returned in a dictionary.\n    \"\"\"\n    flat_list = []\n    for inner_list in lists:\n        for item in inner_list:\n            flat_list.append(item)\n    return collections.Counter(flat_list)"}
{"task_id": "Mbpp/95", "solution": "from typing import Sequence, Any, List\n\ndef Find_Min_Length(input_lists: Sequence[Sequence[Any]]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Validates input and raises errors for invalid or empty collections.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Raised when the input structure is invalid.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class EmptyCollectionError(Exception):\n        \"\"\"Raised when the outer collection is empty.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # Validate that the outer input is a sequence (list or tuple).\n    if not isinstance(input_lists, (list, tuple)):\n        raise InvalidInputError(\"Outer input must be a sequence (list or tuple).\")\n\n    # Validate that the outer input is not empty.\n    if len(input_lists) == 0:\n        raise EmptyCollectionError(\"Input list is empty.\")\n\n    lengths: List[int] = []\n    # Iterate through the outer list to validate inner elements and collect their lengths.\n    for idx, item in enumerate(input_lists):\n        # Validate that each inner element is also a sequence (list or tuple), excluding strings.\n        if not isinstance(item, (list, tuple)):\n            raise InvalidInputError(f\"Element at index {idx} is not a sequence.\")\n        lengths.append(len(item))\n\n    # All validations passed and lengths are collected, find the minimum length.\n    return min(lengths)"}
{"task_id": "Mbpp/98", "solution": "import math\n\ndef multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Assumes the input sequence is non-empty and contains only numeric values.\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    length = len(numbers)\n    # The design context implies that length > 0 is guaranteed by prior validation,\n    # and the prompt disallows adding explicit checks or raising exceptions for edge cases.\n    return product / length"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n):\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Returns '0' for input 0, and a string with no leading zeros for positive integers.\n    \"\"\"\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n > 0:\n        bits.append(\"1\" if (n & 1) else \"0\")\n        n >>= 1\n    bits.reverse()\n    return \"\".join(bits)"}
