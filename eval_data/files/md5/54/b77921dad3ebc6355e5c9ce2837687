10 # Ensure result is single digit\n\n    _cache[n] = result\n    return result"}
{"task_id": "Mbpp/576", "solution": "from typing import Any, Callable, Optional, Sequence\n\nclass SubarrayError(Exception):\n    \"\"\"Base exception for subarray checker.\"\"\"\n    pass\n\nclass ComparatorError(SubarrayError):\n    \"\"\"Raised when a custom comparator function encounters an error.\"\"\"\n    pass\n\ndef default_comparator(a: Any, b: Any) -> bool:\n    \"\"\"Default comparator uses Python's equality operator.\"\"\"\n    return a == b\n\nclass ComparatorAdapter:\n    \"\"\"Adapts a custom comparator or uses the default for safe comparison.\"\"\"\n    def __init__(self, comparator: Optional[Callable[[Any, Any], bool]] = None):\n        self.comparator = comparator\n\n    def compare(self, a: Any, b: Any) -> bool:\n        \"\"\"Compares two elements using the configured comparator.\"\"\"\n        try:\n            if self.comparator is None:\n                return default_comparator(a, b)\n            return self.comparator(a, b)\n        except Exception as e:\n            raise ComparatorError(f\"Comparator raised an exception: {e}\") from e\n\nclass ListComparisonRequest:\n    \"\"\"DTO for a list comparison request.\"\"\"\n    def __init__(self, haystack: Sequence[Any], needle: Sequence[Any], mode: str = \"contiguous\", comparator: Optional[Callable[[Any, Any], bool]] = None):\n        self.haystack = haystack\n        self.needle = needle\n        self.mode = mode\n        self.comparator = comparator\n\n    def validate(self) -> None:\n        \"\"\"Placeholder for input validation, skipped as per instructions.\"\"\"\n        pass\n\nclass SubarrayService:\n    \"\"\"Core logic for checking sublists and subsequences.\"\"\"\n    def __init__(self):\n        pass\n\n    def _sliding_window_match(self, haystack: Sequence[Any], needle: Sequence[Any], comparator: Callable[[Any, Any], bool]) -> bool:\n        \"\"\"Checks for a contiguous sublist using a sliding window.\"\"\"\n        n = len(haystack)\n        m = len(needle)\n\n        if m == 0:\n            return True\n        if m > n:\n            return False\n\n        for i in range(n - m + 1):\n            match = True\n            for j in range(m):\n                if not comparator(haystack[i + j], needle[j]):\n                    match = False\n                    break\n            if match:\n                return True\n        return False\n\n    def is_sub_array(self, haystack: Sequence[Any], needle: Sequence[Any], comparator: Optional[Callable[[Any, Any], bool]] = None) -> bool:\n        \"\"\"Determines if needle is a contiguous sublist of haystack.\"\"\"\n        comp_adapter = ComparatorAdapter(comparator)\n        return self._sliding_window_match(haystack, needle, comp_adapter.compare)\n\n    def is_subsequence(self, haystack: Sequence[Any], needle: Sequence[Any], comparator: Optional[Callable[[Any, Any], bool]] = None) -> bool:\n        \"\"\"Determines if needle is a non-contiguous subsequence of haystack.\"\"\"\n        n = len(haystack)\n        m = len(needle)\n\n        if m == 0:\n            return True\n        if m > n:\n            return False\n\n        comp_adapter = ComparatorAdapter(comparator)\n        needle_idx = 0\n        for hay_idx in range(n):\n            if needle_idx < m and comp_adapter.compare(haystack[hay_idx], needle[needle_idx]):\n                needle_idx += 1\n        return needle_idx == m\n\n    def check(self, request: ListComparisonRequest) -> bool:\n        \"\"\"Dispatches to the correct comparison method based on the request mode.\"\"\"\n        if request.mode == \"contiguous\":\n            return self.is_sub_array(request.haystack, request.needle, request.comparator)\n        elif request.mode == \"subsequence\":\n            return self.is_subsequence(request.haystack, request.needle, request.comparator)\n        return False # Should not be reached with valid modes\n\nclass ComparisonController:\n    \"\"\"Translates arguments to a request and invokes the service.\"\"\"\n    def __init__(self, service: SubarrayService):\n        self._service = service\n\n    def is_sub_array(self, haystack: Sequence[Any], needle: Sequence[Any], mode: str = \"contiguous\", comparator: Optional[Callable[[Any, Any], bool]] = None) -> bool:\n        \"\"\"Checks if needle is a sub-array/subsequence of haystack.\"\"\"\n        request = ListComparisonRequest(haystack, needle, mode, comparator)\n        return self._service.check(request)\n\n_default_service = SubarrayService()\n_default_controller = ComparisonController(_default_service)\n\ndef is_Sub_Array(haystack, needle):\n    \"\"\"\n    Checks if 'needle' is a contiguous sublist of 'haystack'.\n\n    An empty 'needle' is considered a sublist of any 'haystack'.\n    \"\"\"\n    return _default_controller.is_sub_array(haystack, needle, mode=\"contiguous\", comparator=None)"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Any\n\ndef interleave_lists(a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Assumes input lists are of equal length.\n    \"\"\"\n    result: List[Any] = []\n    for item_a, item_b, item_c in zip(a, b, c):\n        result.extend([item_a, item_b, item_c])\n    return result"}
{"task_id": "Mbpp/580", "solution": "import collections\n\ndef extract_even(data: tuple) -> tuple:\n    \"\"\"\n    Recursively removes odd integers from a nested tuple structure.\n    Non-integer and non-tuple elements are considered invalid by design context.\n    \"\"\"\n    result = []\n    for item in data:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            processed_tuple = extract_even(item)\n            result.append(processed_tuple)\n    return tuple(result)"}
{"task_id": "Mbpp/579", "solution": "from typing import Any, Tuple\n\ndef find_dissimilar(a: Tuple[Any, ...], b: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Finds elements present in exactly one of the input tuples, preserving relative order.\n    Elements are considered dissimilar if they are in one tuple but not the other.\n    \"\"\"\n    set_b = set(b)\n    set_a = set(a)\n\n    unique_from_a = tuple(x for x in a if x not in set_b)\n    unique_from_b = tuple(x for x in b if x not in set_a)\n\n    return unique_from_a + unique_from_b"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the formula C(n) = C(2n, n) / (n + 1).\n    This implementation uses a multiplicative approach for binomial coefficients to prevent overflow.\n    \"\"\"\n    if n < 0:\n        # Based on the design context, the controller handles validation.\n        # This function assumes valid non-negative input as per the service layer's responsibility.\n        pass # The higher level controller/service will raise an error here.\n\n    if n == 0:\n        return 1\n\n    # C(n) = C(2n, n) / (n + 1)\n    # Calculate binomial coefficient C(2n, n)\n    # using multiplicative_binomial(N, K) = product((N - K + i) / i for i=1 to K)\n\n    # N = 2*n, K = n\n    # To optimize, C(N, K) = C(N, N-K). Here K = n, N-K = 2n-n = n. So min(K, N-K) is n.\n    result_binomial = 1\n    for i in range(1, n + 1):\n        result_binomial = result_binomial * (2 * n - n + i) // i # Which simplifies to result_binomial * (n + i) // i\n\n    return result_binomial // (n + 1)"}
{"task_id": "Mbpp/581", "solution": "from typing import Any\n\nclass InvalidParameterError(ValueError):\n    \"\"\"Exception raised for invalid parameters in the pyramid area calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef validate_positive_number(name: str, value: Any) -> float:\n    \"\"\"Validates if a value is a positive number and converts it to float.\"\"\"\n    try:\n        numeric_value = float(value)\n    except (TypeError, ValueError) as e:\n        raise InvalidParameterError(f\"{name} must be a number.\") from e\n    if numeric_value <= 0:\n        raise InvalidParameterError(f\"{name} must be a positive number.\")\n    return numeric_value\n\nclass Pyramid:\n    \"\"\"Represents a square pyramid with its base edge and height.\"\"\"\n    def __init__(self, base_edge: float, height: float) -> None:\n        self.base_edge: float = base_edge\n        self.height: float = height\n\nclass SurfaceAreaService:\n    \"\"\"Provides methods to compute the surface area of a square pyramid.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def _base_area(self, a: float) -> float:\n        return a * a\n\n    def _lateral_area_using_height(self, a: float, h: float) -> float:\n        return 2.0 * a * h\n\n    def compute_default(self, pyramid: Pyramid) -> float:\n        \"\"\"\n        Computes surface area using base area + lateral area with height,\n        matching the example assert surface_Area(3,4) == 33.\n        \"\"\"\n        a = pyramid.base_edge\n        h = pyramid.height\n        base = self._base_area(a)\n        lateral = self._lateral_area_using_height(a, h)\n        return base + lateral\n\n_service = SurfaceAreaService()\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Finds the surface area of a square pyramid with a given base edge and height.\n    This uses a specific formula to match the example assert surface_Area(3,4) == 33.\n    \"\"\"\n    a = validate_positive_number(\"base_edge\", base_edge)\n    h = validate_positive_number(\"height\", height)\n    p = Pyramid(a, h)\n    return _service.compute_default(p)"}
