{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    Assumes the input array is a non-empty list of integers.\n    \"\"\"\n    max_ending_here = arr[0]\n    min_ending_here = arr[0]\n    max_so_far = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n        # Store max_ending_here before it's updated, as it's needed for min_ending_here calculation\n        temp_max = max_ending_here\n\n        # Current maximum product can be the number itself, or number multiplied by\n        # the current max_ending_here (if positive), or by min_ending_here (if negative,\n        # two negatives make a positive).\n        max_ending_here = max(num, num * temp_max, num * min_ending_here)\n\n        # Current minimum product can be the number itself, or number multiplied by\n        # the current min_ending_here (if negative), or by max_ending_here (if positive,\n        # to make it more negative).\n        min_ending_here = min(num, num * temp_max, num * min_ending_here)\n\n        # Update the overall maximum product found so far\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Dict, Mapping\n\ndef drop_empty(mapping: Mapping[str, Any]) -> Dict[str, Any]:\n    \"\"\"\n    Drops empty items from a given dictionary based on default rules.\n    Empty values include None, empty strings, whitespace-only strings, and empty containers (list, tuple, set, dict).\n    Values 0 and False are preserved by default.\n    \"\"\"\n    def _is_whitespace_only(s: str) -> bool:\n        return s.strip() == \"\"\n\n    def _is_value_empty(value: Any) -> bool:\n        # Preserve 0 and False by default, as per design context.\n        if value in (0, False):\n            return False\n        if value is None:\n            return True\n        if isinstance(value, str):\n            # Consider empty string or whitespace-only strings as empty by default.\n            return value == \"\" or _is_whitespace_only(value)\n        if isinstance(value, (list, tuple, set, dict)):\n            # Consider empty containers as empty.\n            return len(value) == 0\n        return False\n\n    cleaned_mapping = {}\n    for key, value in mapping.items():\n        if not _is_value_empty(value):\n            cleaned_mapping[key] = value\n    return cleaned_mapping"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items):\n    \"\"\"\n    Finds all possible combinations (power set) of the elements of a given list.\n    Combinations are ordered by ascending bitmask, and elements within each combination are ordered by descending input index.\n    \"\"\"\n    n = len(items)\n    combinations = []\n    total_combinations = 1 << n\n\n    for mask in range(total_combinations):\n        current_combination = []\n        # Iterate indices from n-1 down to 0 to match the required order within each combination\n        for idx in range(n - 1, -1, -1):\n            if (mask >> idx) & 1:  # Check if the bit at position 'idx' is set in the mask\n                current_combination.append(items[idx])\n        combinations.append(current_combination)\n\n    return combinations"}
{"task_id": "Mbpp/471", "solution": "from typing import List\n\ndef find_remainder(items: List[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of elements in an array modulo n.\n    The product of an empty list is 1.\n    \"\"\"\n    product = 1\n    for x in items:\n        product = (product * (x % n)) % n\n        if product == 0:\n            return 0\n    return product % n"}
{"task_id": "Mbpp/472", "solution": "from typing import List\n\ndef check_Consecutive(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers after removing duplicates and sorting.\n    \"\"\"\n    unique_sorted_numbers = sorted(list(set(numbers)))\n\n    if not unique_sorted_numbers:\n        return False\n\n    if len(unique_sorted_numbers) == 1:\n        return True\n\n    return all((b - a) == 1 for a, b in zip(unique_sorted_numbers, unique_sorted_numbers[1:]))"}
{"task_id": "Mbpp/468", "solution": "from typing import List\n\ndef max_product(nums: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    The algorithm handles positive, negative, and zero integers.\n    \"\"\"\n    if not nums:\n        return 0\n\n    n = len(nums)\n    max_prod = [0] * n  # Stores max product of an increasing subsequence ending at index i\n    min_prod = [0] * n  # Stores min product (most negative) of an increasing subsequence ending at index i\n\n    # Initialize each element as a subsequence of length 1\n    for i in range(n):\n        max_prod[i] = nums[i]\n        min_prod[i] = nums[i]\n\n    # Initialize overall_max_product with the maximum single element to handle\n    # cases where all products are negative or zero, but a single element is the max.\n    overall_max_product = max(nums)\n\n    for i in range(n):\n        for j in range(i):\n            if nums[j] < nums[i]:\n                # Calculate potential new products by extending subsequence ending at j\n                cand1 = max_prod[j] * nums[i]\n                cand2 = min_prod[j] * nums[i]\n\n                # Update max_prod[i] and min_prod[i]\n                # max_prod[i] can be nums[i] (starting a new subsequence), or cand1, or cand2\n                max_prod[i] = max(max_prod[i], cand1, cand2)\n                # min_prod[i] can be nums[i] (starting a new subsequence), or cand1, or cand2\n                min_prod[i] = min(min_prod[i], cand1, cand2)\n        \n        # Update the overall maximum product found so far\n        overall_max_product = max(overall_max_product, max_prod[i])\n\n    return overall_max_product"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\n\nNumber = Union[int, float]\n\ndef add_pairwise(input_seq: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in the given tuple.\n    Returns an empty tuple if the input has less than two elements.\n    \"\"\"\n    if len(input_seq) < 2:\n        return tuple()\n    sums = tuple(input_seq[i] + input_seq[i+1] for i in range(len(input_seq)-1))\n    return sums"}
