{"task_id": "Mbpp/230", "solution": "from typing import Any\n\nclass ReplaceError(Exception):\n    \"\"\"Custom exception for replacement errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ReplaceRequest:\n    \"\"\"DTO representing the input text and replacement character.\"\"\"\n    def __init__(self, text: str, char: str) -> None:\n        self.text = text\n        self.char = char\n\nclass ReplaceResponse:\n    \"\"\"DTO representing the result of the replacement operation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates and normalizes inputs for the replace operation.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_request(self, text: Any, char: Any) -> ReplaceRequest:\n        \"\"\"Validates input and returns a ReplaceRequest DTO.\"\"\"\n        if not isinstance(char, str):\n            raise ReplaceError(\"Replacement character must be a string.\")\n        if not char:\n            raise ReplaceError(\"Replacement character cannot be an empty string.\")\n\n        validated_text = str(text)\n        return ReplaceRequest(validated_text, char)\n\nclass StringService:\n    \"\"\"Core business logic for replacing spaces.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def replace_blank(self, request: ReplaceRequest) -> ReplaceResponse:\n        \"\"\"Performs space replacement based on the request.\"\"\"\n        result = self._replace_spaces(request.text, request.char)\n        return ReplaceResponse(result)\n\n    def _replace_spaces(self, text: str, char: str) -> str:\n        \"\"\"Internal helper to replace all ASCII spaces with the given character.\"\"\"\n        return text.replace(' ', char)\n\ndef replace_blank(s: str, ch: str) -> str:\n    \"\"\"Replaces blank spaces in the string with the specified character.\"\"\"\n    validator = Validator()\n    req = validator.validate_request(s, ch)\n    service = StringService(validator)\n    return service.replace_blank(req).value"}
{"task_id": "Mbpp/227", "solution": "from typing import Any, Tuple, Union\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\ndef _is_number(value: Any) -> bool:\n    \"\"\"Helper to detect numeric types, excluding booleans.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef _validate_and_convert_numbers(values: Tuple[Any, Any, Any]) -> Tuple[Union[int, float], Union[int, float], Union[int, float]]:\n    \"\"\"Validates inputs, converts numeric strings, and returns a tuple of numbers.\"\"\"\n    converted_values = []\n    for i, v in enumerate(values, start=1):\n        if isinstance(v, str):\n            try:\n                v_parsed = float(v) if ('.' in v or 'e' in v.lower()) else int(v)\n            except ValueError:\n                raise InvalidInputError(f\"Argument {i} is not a valid number: {v!r}\")\n            \n            if isinstance(v_parsed, float) and v_parsed.is_integer():\n                v_parsed = int(v_parsed)\n            \n            converted_values.append(v_parsed)\n        elif _is_number(v):\n            converted_values.append(v)\n        else:\n            raise InvalidInputError(f\"Argument {i} is not a number: {v!r}\")\n            \n    return tuple(converted_values)\n\ndef min_of_three(a: Union[int, float, str], b: Union[int, float, str], c: Union[int, float, str]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum of three numbers, handling validation and type conversion.\n    Raises InvalidInputError if inputs are not numeric.\n    \"\"\"\n    validated_a, validated_b, validated_c = _validate_and_convert_numbers((a, b, c))\n    return min(validated_a, validated_b, validated_c)"}
{"task_id": "Mbpp/232", "solution": "import heapq\n\ndef larg_nnum(lst, n):\n    \"\"\"\n    Returns a list containing the n largest distinct items from the input list, sorted in descending order.\n    \"\"\"\n    unique_elements = list(set(lst))\n    if not unique_elements:\n        return []\n    \n    # heapq.nlargest returns elements in descending order\n    return heapq.nlargest(n, unique_elements)"}
