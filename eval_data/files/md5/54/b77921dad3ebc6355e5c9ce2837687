{"task_id": "Mbpp/427", "solution": "import re\nfrom datetime import date\n\nclass InvalidDateFormatError(ValueError):\n    \"\"\"Custom exception for invalid date format or value errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass DateDTO:\n    \"\"\"Lightweight data class for parsed date parts.\"\"\"\n    def __init__(self, year: int, month: int, day: int) -> None:\n        self.year = int(year)\n        self.month = int(month)\n        self.day = int(day)\n\n    def to_tuple(self) -> tuple[int, int, int]:\n        return (self.year, self.month, self.day)\n\nclass DateValidator:\n    \"\"\"Validates input string and parses into DateDTO.\"\"\"\n    ISO_PATTERN = r'^\\d{4}-\\d{2}-\\d{2}$'\n\n    def __init__(self) -> None:\n        self._pattern = re.compile(self.ISO_PATTERN)\n\n    def validate(self, date_str: str) -> bool:\n        if not self._pattern.match(date_str):\n            return False\n        y, m, d = map(int, date_str.split(\"-\"))\n        try:\n            date(y, m, d)\n        except Exception:\n            return False\n        return True\n\n    def parse(self, date_str: str) -> DateDTO:\n        if not self._pattern.match(date_str):\n            raise InvalidDateFormatError(\"Expected format yyyy-mm-dd\")\n        y, m, d = map(int, date_str.split(\"-\"))\n        try:\n            date(y, m, d)\n        except Exception:\n            raise InvalidDateFormatError(f\"Invalid calendar date: {date_str}\")\n        return DateDTO(year=y, month=m, day=d)\n\nclass DateFormatter:\n    \"\"\"Formats DateDTO into target string.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def format(self, dto: DateDTO, sep: str = '-') -> str:\n        return f\"{dto.day:02d}{sep}{dto.month:02d}{sep}{dto.year:04d}\"\n\nclass DateConversionService:\n    \"\"\"Orchestrates validation and formatting.\"\"\"\n    def __init__(self, validator: DateValidator, formatter: DateFormatter) -> None:\n        self.validator = validator\n        self.formatter = formatter\n\n    def convert(self, date_str: str) -> DateDTO:\n        return self.validator.parse(date_str)\n\n    def convert_to_string(self, date_str: str) -> str:\n        dto = self.convert(date_str)\n        return self.formatter.format(dto)\n\nclass DateController:\n    \"\"\"API layer that exposes the public conversion function.\"\"\"\n    def __init__(self, service: DateConversionService) -> None:\n        self.service = service\n\n    def change_date_format(self, date_str: str) -> str:\n        return self.service.convert_to_string(date_str)\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date from yyyy-mm-dd format to dd-mm-yyyy format.\n    Raises InvalidDateFormatError for invalid input.\n    \"\"\"\n    validator = DateValidator()\n    formatter = DateFormatter()\n    service = DateConversionService(validator, formatter)\n    controller = DateController(service)\n\n    return controller.change_date_format(date_str)"}
{"task_id": "Mbpp/425", "solution": "from collections.abc import Iterable\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass CountRequest:\n    def __init__(self, lists: list, element) -> None:\n        self.lists = lists\n        self.element = element\n\nclass InputValidator:\n    def validate_lists(self, lists) -> None:\n        if lists is None:\n            raise ValidationError(\"lists must not be None\")\n        if isinstance(lists, (str, bytes)):\n            raise ValidationError(\"lists must be an iterable of iterables, not a string\")\n        if not isinstance(lists, Iterable):\n            raise ValidationError(\"lists must be an iterable\")\n        for i, sub in enumerate(lists):\n            if isinstance(sub, (str, bytes)) or not isinstance(sub, Iterable):\n                raise ValidationError(f\"item at index {i} is not an iterable (found {type(sub).__name__})\")\n\n    def validate_element(self, element) -> None:\n        # element may be any value; no specific validation rules applied here as per design.\n        return\n\nclass ListUtils:\n    def contains_element(self, sublist, element) -> bool:\n        for item in sublist:\n            if item == element:\n                return True\n        return False\n\nclass ListCounterService:\n    def count_occurrences(self, lists, element) -> int:\n        utils = ListUtils()\n        count = 0\n        for sub in lists:\n            if utils.contains_element(sub, element):\n                count += 1\n        return count\n\nclass CountElementAPI:\n    def count_element_in_list(self, lists, element) -> int:\n        InputValidator().validate_lists(lists)\n        InputValidator().validate_element(element)\n        req = CountRequest(lists, element)\n        return ListCounterService().count_occurrences(req.lists, req.element)\n\ndef count_element_in_list(lists, element) -> int:\n    \"\"\"Validate inputs and count sublists containing the specified element.\"\"\"\n    return CountElementAPI().count_element_in_list(lists, element)"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(numbers: list[float | int]) -> list[float | int]:\n    \"\"\"Sorts a list of numbers in non-decreasing order using Shell Sort.\"\"\"\n    arr = list(numbers)  # Create a mutable copy of the input list.\n    n = len(arr)\n\n    # Generate Knuth's gap sequence\n    h = 1\n    gaps = []\n    while h < n:\n        gaps.append(h)\n        h = 3 * h + 1\n    gaps.reverse() # Reverse to get gaps in descending order for the main sort loop\n\n    # Apply Shell Sort with generated gaps\n    for gap in gaps:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n    return arr"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the elementwise bitwise AND of two tuples of integers.\n    The result tuple's length is determined by the shorter of the two input tuples.\n    \"\"\"\n    n = min(len(a), len(b))\n    result = []\n    for i in range(n):\n        result.append(a[i] & b[i])\n    return tuple(result)"}
{"task_id": "Mbpp/433", "solution": "import math\nfrom typing import List, Any\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception to represent invalid inputs.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates and coerces inputs into numeric types.\"\"\"\n    def validate_numeric_list(self, array: Any) -> List[float]:\n        \"\"\"Ensures array is iterable and converts each element to float.\"\"\"\n        if array is None:\n            raise InvalidInputError(\"array must not be None\")\n        try:\n            iterable = list(array)\n        except TypeError:\n            raise InvalidInputError(\"array must be iterable\")\n        return [self._coerce_to_float(x) for x in iterable]\n\n    def validate_numeric(self, value: Any) -> float:\n        \"\"\"Ensures value is numeric or coercible to float.\"\"\"\n        return self._coerce_to_float(value)\n\n    def _coerce_to_float(self, value: Any) -> float:\n        \"\"\"Tries to convert int/float/str to float; raises InvalidInputError on failure.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, str):\n            try:\n                return float(value.strip())\n            except ValueError:\n                raise InvalidInputError(f\"cannot convert '{value}' to float\")\n        raise InvalidInputError(f\"unsupported value type: {type(value).__name__}\")\n\nclass NumberCheckRequest:\n    \"\"\"DTO that holds validated numeric array and value.\"\"\"\n    def __init__(self, array: List[float], value: float) -> None:\n        self.array = array\n        self.value = value\n\nclass NumberCheckerService:\n    \"\"\"Encapsulates business logic to determine if a value is strictly greater than every element of an array.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def is_greater_than_all(self, array: list[Any], value: Any) -> bool:\n        \"\"\"Validates inputs, creates NumberCheckRequest, computes and returns result.\"\"\"\n        arr = self._validator.validate_numeric_list(array)\n        val = self._validator.validate_numeric(value)\n        req = NumberCheckRequest(arr, val)\n        if not req.array:\n            return True # Empty array means value is trivially greater than all zero elements\n        return req.value > max(req.array)\n\ndef check_greater(array: list, value: object) -> bool:\n    \"\"\"\n    Checks whether the entered number is strictly greater than all elements of the given array.\n    Raises InvalidInputError if inputs are not numeric or not coercible.\n    \"\"\"\n    validator = InputValidator()\n    service = NumberCheckerService(validator)\n    return service.is_greater_than_all(array, value)"}
