{"task_id": "Mbpp/14", "solution": "from typing import Any\n\nclass InvalidDimensionError(ValueError):\n    def __init__(self, name: str, value: Any, message: str = None) -> None:\n        msg = message or \"invalid\"\n        super().__init__(f\"Invalid dimension '{name}': {value} - {msg}\")\n        self.name = name\n        self.value = value\n\nclass InputValidator:\n    def validate_positive_number(self, name: str, value: Any) -> float:\n        try:\n            v = float(value)\n        except (TypeError, ValueError):\n            raise InvalidDimensionError(name, value, \"must be numeric\")\n        if v <= 0:\n            raise InvalidDimensionError(name, value, \"must be > 0\")\n        return v\n\nclass Triangle:\n    def __init__(self, base: float, height: float) -> None:\n        self._base = base\n        self._height = height\n\n    def area(self) -> float:\n        return 0.5 * self._base * self._height\n\nclass TriangularPrism:\n    def __init__(self, triangle: Triangle, length: float) -> None:\n        self._triangle = triangle\n        self._length = length\n\n    def volume(self) -> float:\n        return self._triangle.area() * self._length\n\nclass VolumeCalculatorService:\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def compute_volume(self, base: float, triangle_height: float, length: float) -> float:\n        b = self._validator.validate_positive_number(\"base\", base)\n        h = self._validator.validate_positive_number(\"triangle_height\", triangle_height)\n        l = self._validator.validate_positive_number(\"length\", length)\n        triangle = Triangle(b, h)\n        prism = TriangularPrism(triangle, l)\n        return prism.volume()\n\nclass FindVolumeFacade:\n    def __init__(self, service: VolumeCalculatorService) -> None:\n        self._service = service\n\n    def find_Volume(self, base: float, triangle_height: float, length: float) -> float:\n        return self._service.compute_volume(base, triangle_height, length)\n\n_validator = InputValidator()\n_service = VolumeCalculatorService(_validator)\n_facade = FindVolumeFacade(_service)\n\ndef find_Volume(base: float, triangle_height: float, length: float) -> float:\n    \"\"\"Calculates the volume of a triangular prism given its base, triangle height, and length.\"\"\"\n    return _facade.find_Volume(base, triangle_height, length)"}
