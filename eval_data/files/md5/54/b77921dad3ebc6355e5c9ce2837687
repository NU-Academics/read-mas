{"task_id": "Mbpp/389", "solution": "import os\nimport sqlite3\nfrom datetime import datetime\nfrom typing import Optional\n\n# --- Configuration Constants ---\n# Default path for the SQLite cache database.\n_DEFAULT_CACHE_DIR = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"lucas_pkg\")\n_CACHE_DB_PATH = os.path.join(_DEFAULT_CACHE_DIR, \"cache.db\")\n_USE_SQLITE = True  # Whether to use SQLite cache by default.\n_CACHE_DB_TIMEOUT = 0.1 # SQLite timeout seconds.\n\n# --- Exceptions ---\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input validation fails.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass CacheError(Exception):\n    \"\"\"Raised when cache persistence fails.\"\"\"\n    def __init__(self, message: str, original_exception: Optional[Exception] = None):\n        super().__init__(message)\n        self.message = message\n        self.original_exception = original_exception\n\n# --- Models ---\nclass LucasNumber:\n    \"\"\"Data transfer object for a Lucas number cache entry.\"\"\"\n    def __init__(self, n: int, value: int, computed_at: datetime):\n        self.n = n\n        self.value = value\n        self.computed_at = computed_at\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a serializable dictionary representation.\"\"\"\n        return {\n            \"n\": self.n,\n            \"value\": self.value,\n            \"computed_at\": self.computed_at.isoformat()\n        }\n\n# --- Utility Functions and Classes ---\nclass LucasCalculator:\n    \"\"\"Calculates Lucas numbers using an iterative approach.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Lucas number iteratively.\"\"\"\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n# --- Repository Layer ---\nclass InMemoryCache:\n    \"\"\"A simple in-memory cache for Lucas numbers.\"\"\"\n    def __init__(self):\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Lucas number from the in-memory cache.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Lucas number in the in-memory cache.\"\"\"\n        self._store[n] = value\n\nclass CacheRepository:\n    \"\"\"Manages persistent caching of Lucas numbers using SQLite, with an in-memory fallback.\"\"\"\n    def __init__(self, db_path: str, use_sqlite: bool = True, timeout: float = 0.1):\n        self._db_path = db_path\n        self._use_sqlite = use_sqlite\n        self._conn: Optional[sqlite3.Connection] = None\n        self._mem_cache = InMemoryCache()\n\n        if self._use_sqlite:\n            os.makedirs(os.path.dirname(self._db_path), exist_ok=True)\n            try:\n                self._conn = sqlite3.connect(self._db_path, timeout=timeout)\n                self._conn.execute(\n                    \"\"\"\n                    CREATE TABLE IF NOT EXISTS lucas_cache (\n                        n INTEGER PRIMARY KEY,\n                        value TEXT NOT NULL,\n                        computed_at TEXT NOT NULL\n                    );\n                    \"\"\"\n                )\n                self._conn.commit()\n            except sqlite3.Error:\n                # Fallback to in-memory cache if DB is unavailable.\n                self._use_sqlite = False\n                if self._conn:\n                    self._conn.close()\n                    self._conn = None\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Lucas number from cache; checks in-memory then SQLite.\"\"\"\n        cached_value = self._mem_cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        if self._use_sqlite and self._conn:\n            try:\n                cursor = self._conn.execute(\"SELECT value FROM lucas_cache WHERE n = ?\", (n,))\n                row = cursor.fetchone()\n                if row:\n                    value = int(row[0])\n                    self._mem_cache.set(n, value)\n                    return value\n            except sqlite3.Error:\n                pass # Silently fail cache read as per constraint, but continue with in-memory.\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Lucas number to cache (in-memory and SQLite).\"\"\"\n        self._mem_cache.set(n, value)\n\n        if self._use_sqlite and self._conn:\n            try:\n                computed_at = datetime.now().isoformat()\n                self._conn.execute(\n                    \"INSERT OR REPLACE INTO lucas_cache (n, value, computed_at) VALUES (?, ?, ?)\",\n                    (n, str(value), computed_at)\n                )\n                self._conn.commit()\n            except sqlite3.Error:\n                pass # Silently fail cache write as per constraint.\n\n    def close(self) -> None:\n        \"\"\"Closes the SQLite database connection.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n\n# --- Service Layer ---\nclass LucasService:\n    \"\"\"Provides business logic for retrieving Lucas numbers, orchestrating validation, cache, and computation.\"\"\"\n    def __init__(self, repo: CacheRepository, calculator: LucasCalculator):\n        self._repo = repo\n        self._calculator = calculator\n\n    def find(self, n: int) -> int:\n        \"\"\"Finds the n-th Lucas number, using cache or computing it if necessary.\"\"\"\n        # Input validation is omitted as per constraint \"Do NOT add isinstance() checks or raise exceptions\".\n\n        cached_value = self._repo.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        value = self._calculator.compute(n)\n        self._repo.set(n, value)\n        return value\n\n# --- Public API ---\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number, utilizing a caching mechanism.\n    The Lucas sequence starts L0=2, L1=1, Ln = L_{n-1} + L_{n-2}.\n    \"\"\"\n    repo = CacheRepository(db_path=_CACHE_DB_PATH, use_sqlite=_USE_SQLITE)\n    calc = LucasCalculator()\n    svc = LucasService(repo=repo, calculator=calc)\n    try:\n        return svc.find(n)\n    finally:\n        repo.close()"}
