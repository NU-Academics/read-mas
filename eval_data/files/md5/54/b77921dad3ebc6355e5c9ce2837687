{"task_id": "Mbpp/11", "solution": "```python\ndef remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        return s\n    last_idx = s.rfind(ch)\n    if first_idx == last_idx:\n        return s[:first_idx] + s[first_idx+1:]\n    else:\n        return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]\n```"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n):\n    # Numbers less than or equal to 1 are not prime.\n    if n <= 1:\n        return True\n    \n    # 2 is the only even prime number.\n    if n == 2:\n        return False\n    \n    # All other even numbers are not prime.\n    if n % 2 == 0:\n        return True\n    \n    # Check for odd divisors from 3 up to the square root of n.\n    limit = int(math.isqrt(n))\n    for d in range(3, limit + 1, 2):\n        if n % d == 0:\n            return True # Found a divisor, so n is not prime\n            \n    # No divisors found, so n is prime.\n    return False"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of positive rotations required to get the same string.\n    This uses the KMP prefix function to determine the string's minimal period.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 1\n\n    def _compute_prefix_function(text: str) -> list[int]:\n        \"\"\"\n        Computes the KMP prefix function (LPS array) for a given string.\n        \"\"\"\n        length = len(text)\n        pi = [0] * length\n        for i in range(1, length):\n            j = pi[i-1]\n            while j > 0 and text[i] != text[j]:\n                j = pi[j-1]\n            if text[i] == text[j]:\n                j += 1\n            pi[i] = j\n        return pi\n\n    pi = _compute_prefix_function(s)\n    \n    # The minimal period 'p' of a string 's' of length 'n' is 'n - pi[n-1]'.\n    # If 'n' is divisible by 'p', then 'p' is the smallest number of rotations.\n    # Otherwise, the string has no smaller repeating unit, and 'n' rotations are required.\n    p = n - pi[n-1]\n    \n    return p if n % p == 0 else n"}
{"task_id": "Mbpp/6", "solution": "import math\n\ndef differ_At_One_Bit_Pos(a,b):\n    \"\"\"\n    Checks if two non-negative integers differ at exactly one bit position.\n    This is determined by checking if their XOR value is a power of two.\n    \"\"\"\n    # The XOR operation (^) will result in a number where bits are set\n    # only where 'a' and 'b' differ.\n    xor_val = a ^ b\n\n    # For two numbers to differ at exactly one bit position, their XOR value\n    # must be a power of two (e.g., 1, 2, 4, 8, ...).\n    # A number 'x' is a power of two if x is not zero and (x & (x - 1)) is zero.\n    # The requirement summary indicates a ValueError for negative numbers,\n    # but the completion instructions say \"Do NOT add isinstance() checks or raise exceptions\".\n    # Relying on context from design \"Only non-negative integers supported.\"\n    return xor_val != 0 and (xor_val & (xor_val - 1)) == 0"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, List\n\ndef similar_elements(a: Iterable[Any], b: Iterable[Any]) -> List[Any]:\n    \"\"\"\n    Finds the shared elements from two iterables, preserving the order of the\n    first iterable and returning only unique elements.\n    \"\"\"\n    set_b = set(b)\n    seen_elements = set()\n    result = []\n    for item in a:\n        if item in set_b and item not in seen_elements:\n            seen_elements.add(item)\n            result.append(item)\n    return result"}
