{"task_id": "Mbpp/293", "solution": "import math\nfrom typing import Any\n\nclass InvalidSideError(Exception):\n    \"\"\"\n    Custom exception for invalid side lengths or geometric constraints.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef _to_float(value: Any) -> float:\n    \"\"\"\n    Attempts to convert a value to a float, raising TypeError if unsuccessful.\n    \"\"\"\n    try:\n        return float(value)\n    except (TypeError, ValueError):\n        raise TypeError(f\"Value {value!r} is not numeric\")\n\ndef _validate_positive(value: float, name: str) -> None:\n    \"\"\"\n    Ensures a numeric value is positive, raising InvalidSideError if not.\n    \"\"\"\n    if value <= 0:\n        raise InvalidSideError(f\"{name} must be > 0, got {value!r}\")\n\ndef otherside_rightangle(a, b):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given its two legs.\n    Inputs are validated to be positive numbers.\n    \"\"\"\n    a_f = _to_float(a)\n    b_f = _to_float(b)\n    _validate_positive(a_f, \"a\")\n    _validate_positive(b_f, \"b\")\n\n    return math.sqrt(a_f * a_f + b_f * b_f)"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Any, Optional\n\ndef max_aggregate(data: List[Tuple[str, Any]]) -> Optional[Tuple[str, float]]:\n    \"\"\"Calculates the maximum aggregate sum for names from a list of (name, value) tuples.\n    If multiple names share the maximum aggregate, the lexicographically smallest name is chosen.\n    \"\"\"\n    totals: dict[str, float] = {}\n\n    for name, value in data:\n        # Values are cast to float for aggregation, assuming they are numeric (int or float).\n        totals[name] = totals.get(name, 0.0) + float(value)\n\n    if not totals:\n        return None\n\n    # Find the maximum aggregated total across all names.\n    max_total = max(totals.values())\n\n    # Collect all names that achieve this maximum aggregate total.\n    candidates: List[str] = [name for name, total in totals.items() if total == max_total]\n\n    # Apply the tie-breaker: choose the lexicographically smallest name among candidates.\n    chosen_name = sorted(candidates)[0]\n\n    return (chosen_name, max_total)"}
{"task_id": "Mbpp/296", "solution": "from abc import ABC, abstractmethod\nfrom typing import List, Tuple\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the inversion counter.\"\"\"\n    pass\n\ndef validate_list(values) -> list:\n    \"\"\"\n    Ensures input is a list-like sequence of comparable elements.\n    Raises InvalidInputError if validation fails.\n    \"\"\"\n    if not isinstance(values, (list, tuple)):\n        raise InvalidInputError(\"Input must be a list or tuple of comparable elements.\")\n    lst = list(values)\n    if not lst:\n        return lst\n    try:\n        # Attempt a comparison to check for element comparability.\n        if len(lst) > 1:\n            _ = lst[0] <= lst[1]\n        else:\n            _ = lst[0] <= lst[0]\n    except TypeError:\n        raise InvalidInputError(\"Elements in the list are not comparable.\")\n    except Exception as e:\n        raise InvalidInputError(f\"Elements are not comparable: {e}\")\n    return lst\n\nclass InversionCounter(ABC):\n    \"\"\"Abstract base class for inversion counting algorithms.\"\"\"\n    @abstractmethod\n    def count(self, values: List[int]) -> int:\n        pass\n\nclass MergeSortInversionCounter(InversionCounter):\n    \"\"\"\n    Counts inversions using a modified merge sort algorithm.\n    It returns the total inversion count and a sorted version of the input list.\n    \"\"\"\n    def count(self, values: List[int]) -> int:\n        arr = list(values) # Create a defensive copy\n        _, inv = self._count_recursive(arr)\n        return inv\n\n    def _count_recursive(self, arr: List[int]) -> Tuple[List[int], int]:\n        n = len(arr)\n        if n <= 1:\n            return arr, 0\n        \n        mid = n // 2\n        left_sorted, left_inversions = self._count_recursive(arr[:mid])\n        right_sorted, right_inversions = self._count_recursive(arr[mid:])\n        \n        merged_array, merge_inversions = self._merge_count(left_sorted, right_sorted)\n        \n        return merged_array, left_inversions + right_inversions + merge_inversions\n\n    def _merge_count(self, left: List[int], right: List[int]) -> Tuple[List[int], int]:\n        i = j = 0\n        merged = []\n        inv_count = 0\n        \n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n                inv_count += len(left) - i\n        \n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        \n        return merged, inv_count\n\nclass InversionService:\n    \"\"\"\n    Orchestrates the inversion counting process, including validation\n    and delegating to a chosen InversionCounter strategy.\n    \"\"\"\n    def __init__(self, counter: InversionCounter = None):\n        self._counter = counter or MergeSortInversionCounter()\n\n    def count_inversions(self, values: List[int]) -> int:\n        \"\"\"\n        Validates the input and counts inversions using the configured strategy.\n        \"\"\"\n        validated_values = validate_list(values)\n        count = self._counter.count(validated_values)\n        return count\n\n# Initialize a default service for the public API.\n_default_service = InversionService(counter=MergeSortInversionCounter())\n\ndef get_Inv_Count(values: list[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge sort-based algorithm.\n    An inversion is a pair (i, j) such that i < j and values[i] > values[j].\n    \"\"\"\n    return _default_service.count_inversions(values)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n such that the sum of the first n bits\n    is the same as the sum of the last n bits. This is equivalent to C(2n, n).\n    \"\"\"\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/294", "solution": "import math\nimport datetime\nfrom typing import Any, List, Union\n\nclass MaxFinderError(Exception):\n    \"\"\"Base exception for MaxFinder operations.\"\"\"\n    def __init__(self, message: str = \"An error occurred in MaxFinder.\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass EmptyListError(MaxFinderError):\n    \"\"\"Exception raised when the input list is empty.\"\"\"\n    def __init__(self, message: str = \"Input list is empty.\") -> None:\n        super().__init__(message)\n\nclass NoNumericValuesError(MaxFinderError):\n    \"\"\"Exception raised when no numeric values are found in the list.\"\"\"\n    def __init__(self, message: str = \"No numeric values found in the list.\") -> None:\n        super().__init__(message)\n\nclass Result:\n    \"\"\"Data transfer object for the maximum value result.\"\"\"\n    def __init__(self, max_value: Union[int, float], index: int, input_snapshot: List[Any] = None, timestamp: str = None) -> None:\n        self.max_value = max_value\n        self.index = index\n        self.input_snapshot = input_snapshot\n        self.timestamp = timestamp or datetime.datetime.utcnow().isoformat() + \"Z\"\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the Result object to a dictionary.\"\"\"\n        return {\"input\": self.input_snapshot, \"max_value\": self.max_value, \"index\": self.index, \"timestamp\": self.timestamp}\n\nclass Comparator:\n    \"\"\"Utility class for comparing and detecting numeric values.\"\"\"\n    @staticmethod\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is numeric (int or float, not bool, not NaN).\"\"\"\n        if isinstance(value, bool):\n            return False\n        if isinstance(value, (int, float)):\n            if isinstance(value, float) and math.isnan(value):\n                return False\n            return True\n        return False\n\n    @staticmethod\n    def normalize_number(value: Any) -> Union[int, float]:\n        \"\"\"Normalizes a numeric value or raises TypeError if not numeric.\"\"\"\n        if not Comparator.is_numeric(value):\n            raise TypeError(\"Value is not a valid numeric type for comparison.\")\n        return value\n\n    @staticmethod\n    def compare(a: Any, b: Any) -> int:\n        \"\"\"Compares two numeric values, returning -1, 0, or 1.\"\"\"\n        na, nb = Comparator.normalize_number(a), Comparator.normalize_number(b)\n        if na < nb:\n            return -1\n        if na > nb:\n            return 1\n        return 0\n\nclass MaxService:\n    \"\"\"Service to find the maximum numeric value in a heterogeneous list.\"\"\"\n    def __init__(self, comparator: Comparator = Comparator):\n        self.comparator = comparator\n\n    def find_max(self, values: List[Any]) -> Result:\n        \"\"\"Finds the maximum numeric value and its original index in the list.\"\"\"\n        if not isinstance(values, list):\n            raise TypeError(\"Input must be a list.\")\n        if len(values) == 0:\n            raise EmptyListError()\n\n        max_val_candidate: Union[int, float, None] = None\n        max_index = -1\n\n        for i, v in enumerate(values):\n            if self.comparator.is_numeric(v):\n                normalized_v = self.comparator.normalize_number(v)\n\n                if max_val_candidate is None:\n                    max_val_candidate = normalized_v\n                    max_index = i\n                else:\n                    if self.comparator.compare(normalized_v, max_val_candidate) == 1:\n                        max_val_candidate = normalized_v\n                        max_index = i\n        \n        if max_val_candidate is None:\n            raise NoNumericValuesError()\n        \n        return Result(max_value=max_val_candidate, index=max_index, input_snapshot=list(values))\n\n    def find_max_value(self, values: List[Any]) -> Union[int, float]:\n        \"\"\"Convenience method to return only the maximum numeric value.\"\"\"\n        return self.find_max(values).max_value\n\nclass APIController:\n    \"\"\"Controller for the programmatic API to find the maximum value.\"\"\"\n    def __init__(self, service: MaxService):\n        self.service = service\n\n    def max_value(self, values: List[Any]) -> Union[int, float]:\n        \"\"\"Delegates to the MaxService to find and return the maximum numeric value.\"\"\"\n        return self.service.find_max_value(values)\n\n_default_service = MaxService()\n_default_api = APIController(_default_service)\n\ndef max_val(values: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Raises EmptyListError if the list is empty or NoNumericValuesError if no numerics are found.\n    \"\"\"\n    return _default_api.max_value(values)"}
{"task_id": "Mbpp/297", "solution": "from typing import List, Any\n\ndef flatten_list(items: List[Any]) -> List[Any]:\n    \"\"\"\n    Flattens a given nested list structure into a single list.\n    \"\"\"\n    stack = [(items, 0)]  # Stores (current_list, index_to_resume_from)\n    result: List[Any] = []\n\n    while stack:\n        current_list, idx = stack.pop()\n\n        # Iterate through the current list from the specified index\n        for i in range(idx, len(current_list)):\n            item = current_list[i]\n            if isinstance(item, list):\n                # If it's a list, push the remaining part of the current list back\n                # and then push the nested list to be processed next (depth-first).\n                stack.append((current_list, i + 1))\n                stack.append((item, 0))\n                break  # Stop processing current_list and move to the nested list\n            else:\n                # If it's a scalar, add it to the result list.\n                result.append(item)\n    return result"}
{"task_id": "Mbpp/305", "solution": "import string\n\ndef start_withp(words: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns the first two words from a list of strings that start with the letter 'p' (case-insensitive),\n    after normalizing tokens by stripping leading/trailing punctuation.\n    \"\"\"\n    matches = []\n\n    # Helper function to normalize a token by stripping leading/trailing punctuation and whitespace.\n    def _normalize_token(token: str) -> str:\n        return token.strip().strip(string.punctuation)\n\n    # Helper function to check if a token starts with a specific letter, case-insensitively.\n    def _starts_with_letter(token: str, letter: str) -> bool:\n        if not token:\n            return False\n        return token[0].lower() == letter.lower()\n\n    for line in words:\n        # Split the line into raw tokens based on whitespace.\n        raw_tokens = line.split()\n\n        for raw_token in raw_tokens:\n            # Normalize the token for checking and potentially for inclusion in results.\n            normalized_token = _normalize_token(raw_token)\n\n            # If the normalized token is not empty and starts with 'p' (case-insensitive), add it.\n            if normalized_token and _starts_with_letter(normalized_token, 'p'):\n                matches.append(normalized_token)\n                if len(matches) == 2:\n                    return (matches[0], matches[1])\n\n    # According to the prompt's constraints, we assume valid input will always yield two matches.\n    # If fewer than two matches are found, this will result in an IndexError, adhering to\n    # the \"DO NOT add isinstance() checks or raise exceptions for edge cases\" constraint."}
{"task_id": "Mbpp/301", "solution": "import collections\n\ndef dict_depth(data):\n    \"\"\"\n    Computes the maximum nesting depth of dictionaries.\n    The top-level dictionary counts as depth 1.\n    \"\"\"\n    if not isinstance(data, dict):\n        # This case is handled by broader validation in the design,\n        # but for a standalone function, we assume a dict is given.\n        return 0 \n\n    max_depth = 1 # Top-level dict is depth 1\n    \n    # Use a deque for BFS to avoid recursion depth limits and detect cycles\n    # Store (current_dict, current_depth, visited_ids)\n    # visited_ids is a set of object IDs to detect cycles\n    queue = collections.deque([(data, 1, {id(data)})])\n\n    while queue:\n        current_dict, current_depth, visited_ids = queue.popleft()\n        max_depth = max(max_depth, current_depth)\n\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                obj_id = id(value)\n                if obj_id in visited_ids:\n                    # Cycle detected. As per design, cycles do not increase depth.\n                    # This path is considered as if it had no further dicts.\n                    continue\n                \n                # Create a new visited set for the branch to avoid modifying shared set directly\n                # For cycle detection, we need to pass the *current* path's visited IDs to children\n                # A new set ensures that `visited_ids` for other branches in the queue\n                # are not polluted by this branch's progress.\n                next_visited_ids = visited_ids.union({obj_id})\n                queue.append((value, current_depth + 1, next_visited_ids))\n                \n    return max_depth"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that also includes arr[k] (where k > i).\n    \"\"\"\n    dp = [0] * (i + 1)\n\n    # Compute MSIS for prefix arr[0...i]\n    for j in range(i + 1):\n        dp[j] = arr[j] # Initialize dp[j] with arr[j] itself\n        for t in range(j):\n            if arr[t] < arr[j]:\n                dp[j] = max(dp[j], dp[t] + arr[j])\n\n    # Initialize max_sum with arr[k] alone (if no prefix element is smaller)\n    max_sum = arr[k]\n\n    # Combine prefix MSIS with arr[k]\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_sum = max(max_sum, dp[j] + arr[k])\n\n    return max_sum"}
