{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import Dict, Optional, Pattern\n\nclass TextMatchError(Exception):\n    \"\"\"Base exception for text matching operations.\"\"\"\n    pass\n\nclass InvalidInputError(TextMatchError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\nclass PatternError(TextMatchError):\n    \"\"\"Exception raised for issues with regex patterns.\"\"\"\n    pass\n\nclass PatternRepository:\n    \"\"\"Manages and provides regex patterns.\"\"\"\n    DEFAULT_PATTERNS: Dict[str, str] = {\"word_contains_z\": r\"\\b\\w*z\\w*\\b\"}\n\n    def __init__(self, config_path: Optional[str] = None) -> None:\n        \"\"\"Initializes the pattern repository with default patterns.\"\"\"\n        self.patterns = dict(self.DEFAULT_PATTERNS)\n        # The logic to load from config_path is omitted as it's not used by this function's call path.\n\n    def get_pattern(self, key: str) -> str:\n        \"\"\"Retrieves a pattern string by its key.\"\"\"\n        try:\n            return self.patterns[key]\n        except KeyError as exc:\n            raise PatternError(f\"Pattern {key} not found\") from exc\n\nclass RegexAdapter:\n    \"\"\"Adapts Python's re module for consistent regex operations.\"\"\"\n    def __init__(self, flags: int = re.IGNORECASE) -> None:\n        \"\"\"Initializes the RegexAdapter with specified regex flags.\"\"\"\n        self._flags = flags\n\n    def compile(self, pattern: str) -> Pattern:\n        \"\"\"Compiles a regex pattern.\"\"\"\n        try:\n            return re.compile(pattern, self._flags)\n        except re.error as exc:\n            raise PatternError(f\"Invalid regex: {exc}\") from exc\n\n    def search(self, compiled: Pattern, text: str) -> Optional[re.Match]:\n        \"\"\"Searches for the first occurrence of the compiled pattern in the text.\"\"\"\n        return compiled.search(text)\n\nclass MatcherService:\n    \"\"\"Provides high-level text matching business logic.\"\"\"\n    def __init__(self, repo: PatternRepository, adapter: RegexAdapter) -> None:\n        \"\"\"Initializes the MatcherService with a pattern repository and regex adapter.\"\"\"\n        self._repo = repo\n        self._adapter = adapter\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Checks if the given text contains any word with 'z'.\"\"\"\n        pattern = self._repo.get_pattern(\"word_contains_z\")\n        compiled = self._adapter.compile(pattern)\n        match = self._adapter.search(compiled, text)\n        return match is not None\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the text contains a word containing 'z' (case-insensitive).\n    \"\"\"\n    repo = PatternRepository()\n    adapter = RegexAdapter()\n    service = MatcherService(repo, adapter)\n    return service.text_match_wordz(text)"}
