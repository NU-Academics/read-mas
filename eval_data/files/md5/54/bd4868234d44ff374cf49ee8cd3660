{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This function checks for primality by testing divisibility up to the square root of n.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n```\n"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + ... + xs[n] * x^n.\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    Finds an x such that poly(x) = 0 using the bisection method.\n    \"\"\"\n    epsilon = 1e-6\n    max_bisection_iterations = 1000\n\n    # 1. Find an initial interval [a, b] where poly(a) and poly(b) have opposite signs.\n    # Or, if an endpoint is already a root, return it immediately.\n    a_interval = -1.0\n    b_interval = 1.0\n    search_limit = 200  # Limits the interval expansion up to roughly [-200, 200]\n\n    for _ in range(search_limit):\n        pa = poly(xs, a_interval)\n        pb = poly(xs, b_interval)\n\n        if abs(pa) < epsilon:\n            return a_interval\n        if abs(pb) < epsilon:\n            return b_interval\n\n        if pa * pb < 0:\n            break  # Found a suitable interval\n\n        a_interval -= 1.0\n        b_interval += 1.0\n\n    a = a_interval\n    b = b_interval\n\n    # 2. Bisection Iteration\n    for _ in range(max_bisection_iterations):\n        c = (a + b) / 2.0\n        pc = poly(xs, c)\n\n        if abs(pc) < epsilon:\n            return c\n\n        pa = poly(xs, a)  # Re-evaluate poly(a) for current 'a'\n\n        if pa * pc < 0:\n            b = c\n        else:\n            a = c\n\n    # After max iterations, return the midpoint of the final interval\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list) -> float:\n    \"\"\" xs are coefficients of a polynomial. find_zero finds a single zero point using the bisection method.\n    It guarantees a solution exists within a search range.\n    \"\"\"\n    tolerance = 1e-7\n    max_iterations = 1000\n\n    # Initial interval search\n    low, high = -1.0, 1.0\n    p_low = poly(xs, low)\n    p_high = poly(xs, high)\n\n    # Expand interval until a sign change is found\n    while p_low * p_high > 0:\n        low *= 2\n        high *= 2\n        p_low = poly(xs, low)\n        p_high = poly(xs, high)\n        if abs(low) > 1e10:  # Prevent extremely large search space\n            break\n\n    # Bisection method\n    for _ in range(max_iterations):\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        if p_low * p_mid < 0:\n            high = mid\n            p_high = p_mid\n        else:\n            low = mid\n            p_low = p_mid\n\n        if (high - low) < tolerance:\n            break\n\n    return (low + high) / 2\n```"}
{"task_id": "HumanEval/33", "solution": "```python\ndef sort_third(l: list):\n    \"\"\"This function sorts elements at indices divisible by three,\n    keeping other elements in their original positions.\n    \"\"\"\n    l_prime = list(l)\n    elements_at_third_indices = []\n\n    for i, x in enumerate(l):\n        if i % 3 == 0:\n            elements_at_third_indices.append(x)\n\n    elements_at_third_indices.sort()\n\n    sorted_index = 0\n    for i in range(len(l_prime)):\n        if i % 3 == 0:\n            l_prime[i] = elements_at_third_indices[sorted_index]\n            sorted_index += 1\n\n    return l_prime\n```"}
