{"task_id": "HumanEval/86", "solution": "```python\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where each word's characters are reordered\n    in ascending ASCII value, preserving original word and space order.\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n    current_space_chars = []\n\n    for char in s:\n        if char.isspace():\n            # If we just finished a word, process it by sorting its characters.\n            if current_word_chars:\n                sorted_word = ''.join(sorted(current_word_chars))\n                result_parts.append(sorted_word)\n                current_word_chars = []\n            # Accumulate space characters.\n            current_space_chars.append(char)\n        else: # Non-space character\n            # If we just finished a sequence of spaces, process them.\n            if current_space_chars:\n                spaces_str = ''.join(current_space_chars)\n                result_parts.append(spaces_str)\n                current_space_chars = []\n            # Accumulate word characters.\n            current_word_chars.append(char)\n\n    # After the loop, process any remaining word or space characters.\n    if current_word_chars:\n        sorted_word = ''.join(sorted(current_word_chars))\n        result_parts.append(sorted_word)\n    if current_space_chars:\n        spaces_str = ''.join(current_space_chars)\n        result_parts.append(spaces_str)\n\n    return ''.join(result_parts)\n```"}
{"task_id": "HumanEval/86", "solution": "```python\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII values,\n    preserving word order and original spacing.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    result_parts = []\n    current_chunk = []\n    in_word = False\n\n    # Determine initial state for the first character\n    if s[0] != ' ':\n        in_word = True\n\n    for char in s:\n        if char == ' ':\n            if in_word:  # Just finished a word\n                sorted_word = \"\".join(sorted(current_chunk))\n                result_parts.append(sorted_word)\n                current_chunk = [char]\n                in_word = False\n            else:  # Already accumulating spaces\n                current_chunk.append(char)\n        else:  # char is a non-space character\n            if not in_word:  # Just finished spaces\n                space_sequence = \"\".join(current_chunk)\n                result_parts.append(space_sequence)\n                current_chunk = [char]\n                in_word = True\n            else:  # Already accumulating a word\n                current_chunk.append(char)\n\n    # Process any remaining characters in current_chunk after the loop\n    if current_chunk:\n        if in_word:\n            sorted_word = \"\".join(sorted(current_chunk))\n            result_parts.append(sorted_word)\n        else:\n            space_sequence = \"\".join(current_chunk)\n            result_parts.append(space_sequence)\n\n    return \"\".join(result_parts)\n```"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a nested list and returns their (row, column) coordinates.\n    The coordinates are sorted primarily by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r, row_list in enumerate(lst):\n        for c, element in enumerate(row_list):\n            if element == x:\n                coordinates.append((r, c))\n\n    coordinates.sort(key=lambda item: (item[0], -item[1]))\n    return coordinates\n```"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds integer x in the nested list and returns its coordinates (row, column).\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                coordinates.append((row_idx, col_idx))\n\n    # Sort by row in ascending order, then by column in descending order\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates\n```"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n\n    copied_array = list(array)\n\n    if len(copied_array) == 1:\n        return copied_array\n\n    first_element = array[0]\n    last_element = array[-1]\n    total_sum = first_element + last_element\n\n    if total_sum % 2 != 0:  # Odd sum, sort in ascending order\n        copied_array.sort()\n    else:  # Even sum, sort in descending order\n        copied_array.sort(reverse=True)\n\n    return copied_array\n```"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"\n    Returns a string that is the result of rotating each character in the input string by four positions in the alphabet.\n    Non-alphabetic characters are not modified.\n    \"\"\"\n    result_chars = []\n    shift_amount = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_ord = ord('a') + (ord(char) - ord('a') + shift_amount) % 26\n            result_chars.append(chr(shifted_ord))\n        elif 'A' <= char <= 'Z':\n            shifted_ord = ord('A') + (ord(char) - ord('A') + shift_amount) % 26\n            result_chars.append(chr(shifted_ord))\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    result_chars = []\n    shift = 4  # Shift is two multiplied by two places, as per the problem description.\n    for char_code in map(ord, s):\n        char = chr(char_code)\n        if 'a' <= char <= 'z':\n            start_ord = ord('a')\n            shifted_ord = start_ord + (char_code - start_ord + shift) % 26\n            result_chars.append(chr(shifted_ord))\n        elif 'A' <= char <= 'Z':\n            start_ord = ord('A')\n            shifted_ord = start_ord + (char_code - start_ord + shift) % 26\n            result_chars.append(chr(shifted_ord))\n        else:\n            result_chars.append(char)\n    return ''.join(result_chars)\n```\n"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    The check for \"I\" is case-insensitive and ignores leading/trailing whitespace in a sentence.\n    \"\"\"\n    boredom_count = 0\n    current_sentence_chars = []\n    delimiters = ['.', '?', '!']\n\n    for char in S:\n        if char in delimiters:\n            # Process the accumulated sentence when a delimiter is found\n            sentence = \"\".join(current_sentence_chars)\n            trimmed_sentence = sentence.strip()\n            if trimmed_sentence.lower().startswith(\"i\"):\n                boredom_count += 1\n            # Reset for the next sentence\n            current_sentence_chars = []\n        else:\n            current_sentence_chars.append(char)\n\n    # After the loop, process any remaining characters as a potential final sentence\n    if current_sentence_chars:\n        sentence = \"\".join(current_sentence_chars)\n        trimmed_sentence = sentence.strip()\n        if trimmed_sentence.lower().startswith(\"i\"):\n            boredom_count += 1\n\n    return boredom_count\n```\n"}
