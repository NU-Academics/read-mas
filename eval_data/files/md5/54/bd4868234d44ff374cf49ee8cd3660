{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Checks if a number is a product of three prime numbers.\n    The input `a` is an integer less than 100.\n    \"\"\"\n    if a < 8:  # Smallest product of three primes is 2*2*2 = 8.\n        return False\n\n    # Primes up to 23 are sufficient, as 2*2*29 > 100 and 3*3*13 > 100.\n    primes = [2, 3, 5, 7, 11, 13, 17, 19, 23]\n\n    num_primes = len(primes)\n    for i in range(num_primes):\n        p1 = primes[i]\n        # Optimization: if p1 multiplied by the two smallest primes (2*2=4) is already too large.\n        if p1 * 4 > a:\n            break\n\n        for j in range(i, num_primes):  # p2 can be equal to p1\n            p2 = primes[j]\n            # Optimization: if p1*p2 multiplied by the smallest prime (2) is already too large.\n            if p1 * p2 * 2 > a:\n                break\n\n            for k in range(j, num_primes):  # p3 can be equal to p2\n                p3 = primes[k]\n                product = p1 * p2 * p3\n\n                if product == a:\n                    return True\n                if product > a:  # Optimization: further p3 values will only increase the product.\n                    break\n    return False\n```\n"}
{"task_id": "HumanEval/75", "solution": "def is_prime(n):\n    \"\"\"Checks if a number is prime.\n    Handles small numbers and efficiently checks for divisors up to its square root.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef is_multiply_prime(a):\n    \"\"\"Returns True if the number is the product of 3 prime numbers, False otherwise.\n    The input 'a' is less than 100.\n    \"\"\"\n    # Iterate through possible first prime factors p1\n    for p1 in range(2, int(a**(1/3)) + 2): # p1 <= a^(1/3)\n        if not is_prime(p1):\n            continue\n\n        # Iterate through possible second prime factors p2\n        for p2 in range(p1, int((a / p1)**0.5) + 2): # p2 <= (a/p1)^(1/2)\n            if not is_prime(p2):\n                continue\n\n            # Calculate the third factor p3\n            if a % (p1 * p2) == 0:\n                p3 = a // (p1 * p2)\n                # Check if p3 is prime and satisfies the order condition\n                if is_prime(p3) and p3 >= p2:\n                    return True\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    if n == 1:\n        return x == 1\n    if n == 0:\n        return x == 0 or x == 1\n    if x == 0:\n        # For n > 1, no power of n can be 0.\n        # Cases where n is 0 are handled above.\n        return False\n    if x == 1:\n        # Handled n=0, n=1. For n > 1, n**0 = 1, so x=1 is a simple power.\n        return True\n\n    # Now x > 1 and n > 1\n    # Repeatedly divide x by n. If at any point x is not divisible by n,\n    # or if after division x does not become 1, then it's not a simple power.\n    while x % n == 0:\n        x //= n\n    return x == 1"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Determines if x is a simple power of n, meaning n^k = x for some integer k.\"\"\"\n    if x == 1:\n        return True\n\n    if n == 1:\n        return x == 1\n\n    if n == 0:\n        return x == 0\n\n    temp_x = x\n    while temp_x > 1:\n        if temp_x % n != 0:\n            return False\n        temp_x //= n\n    return temp_x == 1\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is the cube of another integer.\n    Calculates the cube root, rounds it, and checks if its cube equals 'a'.\n    \"\"\"\n    # Determine the sign for the cube root.\n    sign = 1 if a >= 0 else -1\n\n    # Calculate the cube root of the absolute value of 'a'.\n    abs_a_cbrt = (abs(a))**(1/3)\n\n    # Round to the nearest integer and apply the original sign.\n    candidate_root = sign * round(abs_a_cbrt)\n\n    # Verify if the cubed candidate root matches the original number 'a'.\n    return candidate_root**3 == a\n```"}
