 -> int:\n        \"\"\"Recursively calculates the k-th Tribonacci term with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        result: int\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k > 0\n            result = 1 + k // 2  # Use integer division as per example results\n        else:  # k is odd and k > 1\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            result = _calculate_term_single(k - 1) + _calculate_term_single(k - 2) + _calculate_term_single(k + 1)\n\n        memo[k] = result\n        return result\n\n    sequence: list[int] = []  # List to store the generated sequence, storing integers\n    for i in range(n + 1):\n        sequence.append(_calculate_term_single(i))\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    The sequence starts with tri(0) = 1.0 and tri(1) = 3.0.\n    \"\"\"\n    trib_sequence = []\n\n    if n >= 0:\n        trib_sequence.append(1.0) # tri(0)\n    if n >= 1:\n        trib_sequence.append(3.0) # tri(1)\n\n    for i in range(2, n + 1):\n        if i % 2 == 0: # i is even\n            trib_sequence.append(1.0 + i / 2.0)\n        else: # i is odd\n            val_i_minus_1 = trib_sequence[i - 1]\n            val_i_minus_2 = trib_sequence[i - 2]\n            val_i_plus_1 = 1.0 + (i + 1) / 2.0\n            trib_sequence.append(val_i_minus_1 + val_i_minus_2 + val_i_plus_1)\n\n    return trib_sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n    For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n    Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # Generate the array 'arr' where arr[x] corresponds to a[x+1] from the problem statement.\n    # This means for Python's 0-indexed 'idx', the value is (idx+1)*(idx+1) - (idx+1) + 1.\n    arr = []\n    for i in range(1, n + 1):\n        arr.append(i * i - i + 1)\n\n    count = 0\n    # Iterate through all unique combinations of three distinct indices i, j, k\n    # such that 0 <= i < j < k < n for the 0-indexed array 'arr'.\n    # This directly implements the O(N^3) approach as specified in the design.\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                # Check if the sum of elements is a multiple of 3.\n                if (arr[i] + arr[j] + arr[k]) % 3 == 0:\n                    count += 1\n\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "import math\ndef combinations(n: int, k: int) -> int:\n    \"\"\"Calculates nCk (n choose k). Returns 0 if k > n or k < 0.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.comb(n, k)\nclass TriplesCalculator:\n    \"\"\"Orchestrates calculation of valid triples by counting remainders and applying combinatorial logic.\"\"\"\n\n    def _count_remainders(self, n: int) -> dict[int, int]:\n        \"\"\"Counts elements a[x] (1 <= x <= n) with remainder 0 or 1 when divided by 3.\"\"\"\n        num_rem_0 = 0\n        num_rem_1 = 0\n        for x in range(1, n + 1):\n            if x % 3 == 2:\n                num_rem_0 += 1\n            else: # x % 3 == 0 or x % 3 == 1\n                num_rem_1 += 1\n        return {0: num_rem_0, 1: num_rem_1}\n\n    def calculate_triples(self, n: int) -> int:\n        \"\"\"Computes the total number of valid triples for a given n.\"\"\"\n        # The design document specified error handling for n here,\n        # but the problem statement implies n is a positive integer.\n        # Keeping it minimal as per the original problem function signature and description.\n        # If n is not a positive integer, _count_remainders will handle the range correctly,\n        # leading to 0 counts and thus 0 combinations, which is a reasonable default.\n        if not isinstance(n, int) or n <= 0:\n            return 0 # Or raise ValueError based on stricter interpretation of \"positive integer n\"\n\n        remainder_counts = self._count_remainders(n)\n\n        count_000 = combinations(remainder_counts[0], 3)\n        count_111 = combinations(remainder_counts[1], 3)\n\n        return count_000 + count_111\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    calculator = TriplesCalculator()\n    return calculator.calculate_triples(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "from typing import Tuple\nSOLAR_SYSTEM_PLANETS: Tuple[str, ...] = (\n    \"Mercury\",\n    \"Venus\",\n    \"Earth\",\n    \"Mars\",\n    \"Jupiter\",\n    \"Saturn\",\n    \"Uranus\",\n    \"Neptune\"\n)\nclass PlanetRepository:\n    \"\"\"Manages the authoritative list of solar system planets and provides lookup capabilities.\"\"\"\n    def get_solar_system_planets(self) -> Tuple[str, ...]:\n        \"\"\"Returns the complete ordered tuple of solar system planet names.\"\"\"\n    