ls\n\n    class MaxFillCalculator:\n        def calculate_max_fill(self, grid_data: list[list[int]], capacity: int) -> int:\n            # Create Grid object encapsulating wells.\n            grid_obj = Grid(grid_data)\n            total_lowers = 0\n            # FR3: Iterate through wells and accumulate bucket lowers.\n            for well in grid_obj.get_wells():\n                total_lowers += well.calculate_lowers(capacity)\n            return total_lowers\n\n    # Instantiate the calculator and perform the main calculation.\n    calculator = MaxFillCalculator()\n    return calculator.calculate_max_fill(grid, capacity)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"Calculates the total number of bucket lowering operations needed to empty all wells.\n    Each '1' in the grid represents one unit of water, and buckets have a fixed capacity.\n    \"\"\"\n    total_bucket_operations = 0\n    for well in grid:\n        water_units = 0\n        for unit in well:\n            water_units += unit\n\n        if water_units == 0:\n            bucket_operations_for_well = 0\n        else:\n            bucket_operations_for_well = math.ceil(water_units / capacity)\n\n        total_bucket_operations += bucket_operations_for_well\n\n    return total_bucket_operations", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, in order.\"\"\"\n\n    if not s:\n        return []\n\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel, case-insensitive.\"\"\"\n        return char.lower() in _VOWELS\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a given word, ignoring non-alphabetic characters.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    words = s.split()\n    selected_words = []\n\n    for word in words:\n        if _count_consonants(word) == n:\n            selected_words.append(word)\n\n    return selected_words", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Given a string s and a natural number n, returns a list of all words\n    from string s that contain exactly n consonants, in order.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n    words = s.split()\n    result_words = []\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            # Count character as consonant if it's an alphabet and not a vowel (case-insensitive).\n            if char.isalpha() and char.lower() not in VOWELS_SET:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers primarily by the count of set bits in their binary representation\n    (absolute value) and secondarily by their decimal value. Both primary and secondary sorting are in ascending order.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of set bits in the binary representation of an integer's absolute value.\"\"\"\n        return bin(abs(n)).count('1')\n\n    def _get_sort_key(n: int) -> tuple[int, int]:\n        \"\"\"Generates a sorting key (bit count, original decimal value) for an integer.\"\"\"\n        bit_count = _count_set_bits(n)\n        return (bit_count, n)\n\n    return sorted(arr, key=_get_sort_key)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the count of set bits in their absolute binary\n    representation, then by decimal value.\n    \"\"\"\n    def get_sort_key(n):\n        if n == 0:\n            bit_count = 0\n        else:\n            num = abs(n)\n            count = 0\n            while num > 0:\n                num &= (num - 1)\n                count += 1\n            bit_count = count\n        return (bit_count, n)\n\n    return sorted(arr, key=get_sort_key)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"\n    Finds the closest vowel from the right side of a word that is positioned\n    between two consonants. Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    n = len(word)\n\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character (index n-2) down to the second character (index 1).\n    # This range excludes the first and last characters of the word.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n\n        # Check if current_char is a vowel.\n        if current_char in VOWELS:\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n\n            # Check if left_char is a consonant (English letter and not a vowel).\n            is_left_consonant = left_char.isalpha() and left_char not in VOWELS\n\n            # Check if right_char is a consonant (English letter and not a vowel).\n            is_right_consonant = right_char.isalpha() and right_char not in VOWELS\n\n            if is_left_consonant and is_right_consonant:\n                return current_char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/118", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel, case-insensitively.\"\"\"\n    return char.lower() in VOWELS\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant, case-insensitively.\"\"\"\n    return char.isalpha() and not _is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between\n    two consonants from the right side of the word (case sensitive).\n\n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition.\n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        if _is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    Positions are 0-indexed.\n    \"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n 