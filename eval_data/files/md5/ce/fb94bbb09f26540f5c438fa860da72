_fraction = fraction_x * fraction_n\n        return product_fraction.is_whole_number()\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Checks if the product of two fractions, x and n, is a whole number.\n    Both x and n are string representations of fractions.\n    \"\"\"\n    service = FractionService()\n    return service.simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute value of digits for a given integer.\n    For example: _sum_digits(123) == 6, _sum_digits(-12) == 3.\n    \"\"\"\n    s = 0\n    n_abs = abs(n)\n    while n_abs > 0:\n        s += n_abs % 10\n        n_abs //= 10\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If several items have similar sum, order them based on their original index.\n    \"\"\"\n    # Pair each number with its original index for tie-breaking.\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort using sum of digits as primary key and original index as secondary.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (_sum_digits(item[0]), item[1]))\n\n    # Extract only the numbers from the sorted pairs.\n    return [item[0] for item in sorted_indexed_nums]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}, {"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits.\n    If digit sums are equal, their original relative order is maintained by index.\n    \"\"\"\n\n    def calculate_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute value of digits of a given integer.\"\"\"\n        s = 0