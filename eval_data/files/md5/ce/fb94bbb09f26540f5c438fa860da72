ime = True\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    # Return x if prime, or y otherwise, fulfilling FR2 and FR3.\n    if is_n_prime:\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of odd, non-negative integers.\n    Non-integers and negative numbers are ignored.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        # Check if the number is an integer, non-negative, and odd\n        if isinstance(num, int) and num >= 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd, positive, and integers.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Identifies the strongest extension and returns it in a specific format.\n    Strength is calculated as (uppercase count - lowercase count), ignoring non-alphabetic characters.\n    \"\"\"\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"\n        Calculates the strength of an extension name.\n        \"\"\"\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    if not extensions:\n        return class_name\n\n    strongest_ext_name = extensions[0]\n    max_strength = _calculate_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        ext_name = extensions[i]\n        current_strength = _calculate_strength(ext_name)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension from a list and formats it with the class name.\n    Strength is calculated as (uppercase letters) - (lowercase letters), with ties going to the first in list.\n    \"\"\"\n    strongest_extension_name = None\n    max_strength = float('-inf')\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        if strongest_extension_name is None or current_strength > max_strength:\n            strongest_extension_name = ext_name\n            max_strength = current_strength\n        # If current_strength == max_strength, the existing strongest_extension_name (which appeared first) is retained.\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"You are given 2 words. You need to return T