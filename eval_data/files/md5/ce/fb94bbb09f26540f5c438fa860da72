 component must be between 1 and 12.\n        if not (1 <= parsed_date.month <= 12):\n            return False\n\n        # FR3, FR4, FR5: Day component range validation based on the month.\n        max_days = DAYS_IN_MONTH.get(parsed_date.month)\n        if max_days is None: # This should not occur if month is already validated 1-12.\n            return False\n\n        if not (1 <= parsed_date.day <= max_days):\n            return False\n\n        return True # FR7: All validation rules passed.\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string based on specified rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    validator = DateValidator()\n    return validator.is_valid(date)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False.\n    '''\n    # Check for ascending order (non-decreasing).\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate count (no number appears more than twice).\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if a list is sorted in ascending order with at most one duplicate per number.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    # Check for duplicate count\n    counts = Counter(lst)\n    for count in counts.values():\n        if co