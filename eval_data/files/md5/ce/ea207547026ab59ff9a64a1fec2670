{"task_id": "HumanEval/117", "solution": "def select_words(s: str, n: int) -> list[str]:\n    \"\"\"Filters words from a string based on their consonant count.\n    Returns words with exactly 'n' consonants, maintaining original order.\"\"\"\n\n    VOWELS = \"aeiou\"\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word, case-insensitively.\"\"\"\n        count = 0\n        for char in word:\n            char_lower = char.lower()\n            if char_lower.isalpha() and char_lower not in VOWELS:\n                count += 1\n        return count\n\n    result_words = []\n    # s.split() handles empty string by returning [] and multiple spaces correctly.\n    words = s.split()\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers based on specific criteria:\n    non-negative by set bit count then decimal value, negatives purely by decimal value.\n    \"\"\"\n\n    def count_set_bits(n: int) -> int:\n        \"\"\"Calculates the number of '1' bits in a non-negative integer.\"\"\"\n        count = 0\n        while n > 0:\n            n &= (n - 1)  # Brian Kernighan's algorithm\n            count += 1\n        return count\n\n    def get_sort_key(n: int) -> tuple[int, int]:\n        \"\"\"Generates a tuple (primary_key, secondary_key) for sorting.\"\"\"\n        if n < 0:\n            return (0, n)  # Negatives are sorted purely by decimal value, grouped first.\n        else:\n            bit_count = count_set_bits(n)\n            return (bit_count, n)  # Non-negatives sorted by bit count then decimal value.\n\n    return sorted(arr, key=get_sort_key)"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by two consonants from the right.\n    Returns an empty string if no such vowel is found.\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel_char(char: str) -> bool:\n        return char.lower() in VOWELS\n\n    def is_consonant_char(char: str) -> bool:\n        # Assumes char is an English letter; if not a vowel, it's a consonant.\n        return not is_vowel_char(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        # Check if the current character is a vowel surrounded by consonants.\n        if (is_vowel_char(current_char) and\n            is_consonant_char(prev_char) and\n            is_consonant_char(next_char)):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef is_vowel(char):\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS\ndef count_consonants(word):\n    \"\"\"Counts consonants in a word using the global VOWELS and is_vowel helper.\"\"\"\n    count = 0\n    for char in word:\n        if 'a' <= char.lower() <= 'z' and not is_vowel(char):\n            count += 1\n    return count\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of all words\n    from string s that contain exactly n consonants, in order.\n    Handles empty input by returning an empty list.\n    \"\"\"\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    # Sorts an array of integers by set bit count, then decimal value.\n    # Negative numbers' bit counts are based on their absolute value.\n\n    def count_set_bits_inline(n):\n        # Counts set bits in the binary representation of n's magnitude.\n        # This considers the absolute value for negative inputs.\n        return bin(abs(n)).count('1')\n\n    def get_sort_key_inline(num):\n        # Generates a tuple (number of set bits, original decimal value).\n        # This key defines the primary sort by bit count and secondary by decimal value.\n        bit_count = count_set_bits_inline(num)\n        return (bit_count, num)\n\n    return sorted(arr, key=get_sort_key_inline)"}
{"task_id": "HumanEval/119", "solution": "def _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string of parentheses is balanced.\n    It verifies if the total count of open and close parentheses are equal and if no prefix has more close than open.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"Checks if two strings can be concatenated in any order to form a balanced string.\n    It tries both s1+s2 and s2+s1 concatenations and returns 'Yes' if either is balanced, 'No' otherwise.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all odd elements at even positions.\n    Positions are 0-indexed.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 2 == 0 and value % 2 != 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order, take the top k, then sort them in ascending order.\n    sorted_arr = sorted(arr, reverse=True)\n    top_k = sorted_arr[:k]\n    return sorted(top_k)"}
