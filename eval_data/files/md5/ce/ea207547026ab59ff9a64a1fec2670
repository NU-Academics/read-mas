{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels with the letter\n    two places ahead in the alphabet.\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    # Constants for vowel checking and alphabet lookup, defined inline as per constraints.\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        current_char = char\n\n        # Apply vowel replacement rule first.\n        # If the character is a vowel, replace it with the letter two places ahead.\n        if current_char in VOWELS_LOWER:\n            idx = ALPHABET_LOWER.index(current_char)\n            current_char = ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n        elif current_char in VOWELS_UPPER:\n            idx = ALPHABET_UPPER.index(current_char)\n            current_char = ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n        # If not a vowel, current_char remains unchanged at this step.\n\n        # Apply case swapping rule to the (potentially transformed) character.\n        # Swap the case of all letters. Non-alphabetic characters are unaffected.\n        if current_char.islower():\n            current_char = current_char.upper()\n        elif current_char.isupper():\n            current_char = current_char.lower()\n        # Non-alphabetic characters (like spaces) pass through unchanged here.\n\n        encoded_chars.append(current_char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    encoded_chars = []\n\n    for char in message:\n        # Swap the case of the character.\n        swapped_char = char.swapcase()\n\n        # If the swapped character is a vowel (case-insensitive), replace it.\n        if swapped_char.lower() in VOWELS:\n            # Move the vowel two places ahead in the alphabet, preserving its case.\n            offset = 2\n            final_char = chr(ord(swapped_char) + offset)\n        else:\n            # Consonants and non-alphabetic characters only get case-swapped (or remain unchanged for non-alpha).\n            final_char = swapped_char\n\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts \"boredoms\" in a string. A boredom is a sentence that starts with \"I\".\n    \"\"\"\n    boredom_count = 0\n\n    # Sentence splitting logic based on specification's utils.split_sentences.\n    delimiters = ['.', '?', '!']\n    temp_delimiter = \"###SENTENCE_END###\"\n    processed_text = S\n    for d in delimiters:\n        processed_text = processed_text.replace(d, d + temp_delimiter)\n\n    raw_sentences = processed_text.split(temp_delimiter)\n\n    cleaned_sentences = []\n    for s in raw_sentences:\n        cleaned_s = s.strip()\n        if cleaned_s:\n            if cleaned_s[-1] in delimiters:\n                cleaned_s = cleaned_s[:-1]\n            if cleaned_s:\n                cleaned_sentences.append(cleaned_s)\n\n    # Boredom checking logic based on specification's utils.is_boredom_sentence.\n    for sentence in cleaned_sentences:\n        sentence_for_check = sentence.strip()\n        if not sentence_for_check:\n            continue\n\n        # Check if the sentence starts with the exact word \"I\" (case-sensitive).\n        # \\s* matches optional leading whitespace, 'I' matches the word, \\b ensures it's a whole word.\n        if re.match(r\"^\\s*I\\b\", sentence_for_check):\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a given integer n is a prime number.\n        A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute value of the digits of a given integer n.\n        \"\"\"\n        s = 0\n        n = abs(n)\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    if not lst:\n        return None\n\n    largest_prime = None\n\n    for number in lst:\n        # Trusting caller's input: assuming 'number' is an integer.\n        if is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n\n    if largest_prime is None:\n        return None\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"\n    Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer is a prime number. Returns True if prime, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of the digits of an integer.\"\"\"\n        n = abs(n)\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"Checks if all string keys in a dictionary are consistently lowercase or uppercase.\n    Returns False for an empty dictionary or inconsistent casing.\"\"\"\n    if not dict:\n        return False\n\n    # As per CRITICAL REQUIREMENTS, no isinstance() checks are added.\n    # This implies trusting that all keys provided are are strings.\n    # If a non-string key is present, a `str` method call (e.g., .islower()) will raise an AttributeError.\n\n    keys = dict.keys()\n\n    # Check if all keys are lowercase\n    if all(key.islower() for key in keys):\n        return True\n\n    # Check if all keys are uppercase\n    if all(key.isupper() for key in keys):\n        return True\n\n    return False"}
