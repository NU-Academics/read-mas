{"task_id": "HumanEval/6", "solution": "from typing import List\nclass ParenthesesAnalyzer:\n    \"\"\"\n    Analyzes a single string representing a group of parentheses to determine\n    its deepest nesting level.\n    \"\"\"\n    def analyze_group(self, group_string: str) -> int:\n        \"\"\"\n        Calculates the deepest nesting level within a single parentheses group.\n        Returns 0 for empty or invalid groups.\n        \"\"\"\n        current_depth = 0\n        max_depth = 0\n\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                if current_depth > 0:\n                    current_depth -= 1\n            else:\n                # As per FR2 error handling, non-parentheses characters\n                # cause the group's nesting level to be reported as 0.\n                return 0\n\n        return max_depth\nclass ParenthesesParserService:\n    \"\"\"\n    Service responsible for parsing a string of space-separated parentheses groups\n    and delegating the analysis of each group.\n    \"\"\"\n    def __init__(self):\n        self._analyzer = ParenthesesAnalyzer()\n\n    def parse_groups(self, paren_string: str) -> List[int]:\n        \"\"\"\n        Splits the input string into individual parentheses groups and\n        calculates the deepest nesting level for each.\n        \"\"\"\n        # FR1 Error Handling: If paren_string is empty, return an empty list.\n        if not paren_string.strip():\n            return []\n\n        # Business rule 5.1: Groups of parentheses are separated by one or more spaces.\n        # str.split() handles multiple spaces and leading/trailing spaces correctly.\n        groups = paren_string.split()\n        results = []\n        for group_string in groups:\n            nesting_level = self._analyzer.analyze_group(group_string)\n            results.append(nesting_level)\n        return results\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser_service = ParenthesesParserService()\n    return parser_service.parse_groups(paren_string)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    For a given list of integers, return a tuple consisting of a sum and a product of all integers.\n    An empty list's sum is 0 and its product is 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    # Initialize with negative infinity to correctly handle lists with negative numbers.\n    current_max: int = float('-inf')\n\n    for num in numbers:\n        if num > current_max:\n            current_max = num\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf') # type: ignore\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return 0, 1\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return current_sum, current_product"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not a or not b:\n        raise ValueError(\"Input strings cannot be empty.\")\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must have the same length.\")\n\n    result = []\n    for char_a, char_b in zip(a, b):\n        if char_a not in ('0', '1') or char_b not in ('0', '1'):\n            raise ValueError(\"Input strings must consist only of '0's and '1's.\")\n\n        if char_a == char_b:\n            result.append('0')\n        else:\n            result.append('1')\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    This is achieved by finding the longest palindromic suffix and appending the reverse of the remaining prefix.\n    \"\"\"\n    n = len(string)\n    if n == 0:\n        return \"\"\n\n    for i in range(n):\n        # Check if the current suffix (string[i:]) is a palindrome.\n        if is_palindrome(string[i:]):\n            # If it is, this is the longest palindromic suffix from the start.\n            # Extract the prefix that comes before this suffix.\n            prefix_to_reverse = string[:i]\n            # Reverse this prefix.\n            reversed_prefix = prefix_to_reverse[::-1]\n            # Append the reversed prefix to the original string to form the shortest palindrome.\n            return string + reversed_prefix"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of a list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length, or None if the list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two integers a and b.\n    It uses the Euclidean algorithm and handles negative numbers and zeros.\"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    if a == 0:\n        return b\n    if b == 0:\n        return a\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    max_len_so_far = len(strings[0])\n\n    for current_str in strings[1:]:\n        current_len = len(current_str)\n        if current_len > max_len_so_far:\n            max_len_so_far = current_len\n            longest_so_far = current_str\n\n    return longest_so_far"}
