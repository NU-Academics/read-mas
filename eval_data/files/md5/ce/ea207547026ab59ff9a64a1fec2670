{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    '''\n\n    # FR3: Check for non-positive side lengths first.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # FR2: Validate if the three side lengths form a valid triangle using the triangle inequality theorem.\n    # Degenerate triangles (sum of two sides equals the third) are considered invalid here.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1\n\n    # FR4: Calculate semi-perimeter.\n    s = (a + b + c) / 2\n\n    # FR4: Calculate the area using Heron's formula.\n    # Use max(0, ...) to handle potential floating-point inaccuracies\n    # that might result in a very small negative number under the square root.\n    area_squared_term = s * (s - a) * (s - b) * (s - c)\n    area = math.sqrt(max(0, area_squared_term))\n\n    # FR5: Round the calculated area to two decimal places.\n    rounded_area = round(area, 2)\n\n    # FR6: Return the rounded area.\n    return rounded_area"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n.\n    This means x can be expressed as n raised to some non-negative integer power.\"\"\"\n    if n == 1:\n        return x == 1\n\n    power_val = 1\n    while power_val < x:\n        power_val *= n\n\n    return power_val == x"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Checks if the input integer 'a' is a perfect cube of another integer.\n    This function handles positive, negative, and zero inputs correctly.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root and round to the nearest integer.\n    cbrt_a = math.cbrt(a)\n    rounded_cbrt = round(cbrt_a)\n\n    # Check if the cubed rounded value equals the original number.\n    return rounded_cbrt ** 3 == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"Checks if an integer 'a' is a perfect cube.\n    It calculates the integer cube root of |a| and checks its cube.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n    root_candidate = round(abs_a**(1/3))\n\n    return root_candidate * root_candidate * root_candidate == abs_a"}
{"task_id": "HumanEval/75", "solution": "def _get_prime_factors(n: int) -> list[int]:\n    \"\"\"\n    Computes all prime factors of an integer n, including their multiplicity.\n    Returns an empty list for numbers less than or equal to 1.\n    \"\"\"\n    factors = []\n    if n <= 1:\n        return factors\n\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"\n    Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the input integer 'a' is the product of exactly three prime numbers.\n    This function assumes 'a' is an integer such that 1 < a < 100.\n    \"\"\"\n\n    # Handle edge cases for 'a' outside the specified range (1 < a < 100).\n    # Numbers <= 1 are not products of primes.\n    # Numbers >= 100 are outside the problem's scope.\n    if not isinstance(a, int) or a <= 1 or a >= 100:\n        return False\n\n    prime_factors = []\n    temp_a = a\n    d = 2\n    # Find prime factors by trial division, counting multiplicity.\n    # The loop condition d * d <= temp_a optimizes the search for factors.\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            prime_factors.append(d)\n            temp_a //= d\n        d += 1\n    # If after division, temp_a is still greater than 1, it means temp_a itself is a prime factor.\n    if temp_a > 1:\n        prime_factors.append(temp_a)\n\n    # Return True if exactly three prime factors were found, False otherwise.\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Checks if a number x is a simple power of n, meaning x = n^k for some non-negative integer k.\n    Assumes x and n are positive integers (>= 1).\n    \"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n\n    temp_x = x\n    while temp_x > 1:\n        if temp_x % n != 0:\n            return False\n        temp_x //= n\n    return temp_x == 1"}
