d(\"E\")\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1.\n    \"\"\"\n    # We trust that n is a positive integer (n >= 1).\n\n    if n == 1:\n        return 1\n\n    # Principle of Inclusion-Exclusion: |A U B| = |A| + |B| - |A intersect B|\n    # A = numbers starting with 1 (e.g., 100... for n=3)\n    # B = numbers ending with 1 (e.g., ...01 for n=3)\n\n    # Calculate count of n-digit numbers starting with 1.\n    # The first digit is 1, and the remaining (n-1) digits can be any from 0-9.\n    count_starts_with_one = 10**(n - 1)\n\n    # Calculate count of n-digit numbers ending with 1.\n    # The last digit is 1. The first digit can be 1-9 (9 choices), and the\n    # middle (n-2) digits can be any from 0-9.\n    count_ends_with_one = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers starting AND ending with 1.\n    # The first and last digits are 1. The middle (n-2) digits can be any from 0-9.\n    count_starts_and_ends_with_one = 10**(n - 2)\n\n    return count_starts_with_one + count_ends_with_one - count_starts_and_ends_with_one"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n\n    def _calculate_digit_sum_internal(n: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of an integer.\"\"\"\n        total_sum = 0\n        for digit_char in str(n):\n            total_sum += int(digit_char)\n        return total_sum\n\n    def _to_binary_string_internal(decimal_sum: int) -> str:\n        \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n        if decimal_sum == 0:\n            return \"0\"\n        return bin(decimal_sum)[2:]\n\n    digit_sum = _calculate_digit_sum_internal(N)\n    binary_result = _to_binary_string_internal(digit_sum)\n    return binary_result"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # The total count is (numbers starting with 1) + (numbers ending with 1) - (numbers starting AND ending with 1).\n        # Numbers starting with 1: 1 * 10^(n-1) (first digit is 1, remaining n-1 digits can be any of 0-9)\n        # Numbers ending with 1: 9 * 10^(n-2) (first digit can be 2-9 (8 options), remaining n-2 digits can be any of 0-9, last digit is 1)\n        # Numbers starting AND ending with 1: 1 * 10^(n-2) (first digit is 1, remaining n-2 digits can be any of 0-9, last digit is 1)\n        # Using the Principle of Inclusion-Exclusion:\n        # P(A or B) = P(A) + P(B) - P(A and B)\n        # Count = (10**(n-1)) + (9 * 10**(n-2)) - (10**(n-2))\n        # Count = 10**(n-1) + (9 - 1) * 10**(n-2)\n        # Count = 10**(n-1) + 8 * 10**(n-2)\n        return (10**(n - 1)) + (8 * (10**(n - 2)))"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the sum of its digits in binary.\n    N is within 0 <= N <= 10000.\n    \"\"\"\n    sum_of_digits = 0\n    # Calculate the sum of decimal digits of N.\n    for digit_char in str(N):\n        sum_of_digits += int(digit_char)\n\n    # Convert the sum to its binary string representation.\n    if sum_of_digits == 0:\n        return \"0\"\n    return bin(sum_of_digits)[2:]"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs to a list of letter grades.\n    The conversion follows a predefined grading scale including specific GPA thresholds.\n    \"\"\"\n    result_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grade = 'A+'\n        elif gpa > 3.7:\n            letter_grade = 'A'\n        elif gpa > 3.3:\n            letter_grade = 'A-'\n        elif gpa > 3.0:\n            letter_grade = 'B+'\n        elif gpa > 2.7:\n            letter_grade = 'B'\n        elif gpa > 2.3:\n            letter_grade = 'B-'\n        elif gpa > 2.0:\n            letter_grade = 'C+'\n        elif gpa > 1.7:\n            letter_grade = 'C'\n        elif gpa > 1.3:\n            letter_grade = 'C-'\n        elif gpa > 1.0:\n            letter_grade = 'D+'\n        elif gpa > 0.7:\n            letter_grade = 'D'\n        elif gpa > 0.0:\n            letter_grade = 'D-'\n        elif gpa == 0.0:\n            letter_grade = 'E'\n        else: # Handles negative GPAs as per error handling guidance.\n            letter_grade = 'E'\n        result_grades.append(letter_grade)\n    return result_grades"}
{"task_id": "HumanEval/82", "solution": "import math\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef prime_length(string):\n    \"\"\"\n    Checks if the length of the input string is a prime number.\n    Returns True if the string's length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
