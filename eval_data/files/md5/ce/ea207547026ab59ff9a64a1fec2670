{"task_id": "HumanEval/48", "solution": "import re\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    # Normalize the string by converting to lowercase and removing non-alphanumeric characters.\n    normalized_text = re.sub(r'[^a-zA-Z0-9]', '', text).lower()\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p using binary exponentiation.\n    Assumes n is a non-negative integer and p is a positive integer.\n    \"\"\"\n    if n == 0:\n        return 1 % p\n\n    res = 1\n    base = 2 % p\n\n    while n > 0:\n        if n % 2 == 1:\n            res = (res * base) % p\n        base = (base * base) % p\n        n //= 2\n    return res"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return the median of elements in the list l.\n    Handles lists with both odd and even numbers of elements.\n    \"\"\"\n    sorted_data = sorted(l)\n    n = len(sorted_data)\n\n    if n % 2 == 1:\n        # Odd number of elements\n        return sorted_data[n // 2]\n    else:\n        # Even number of elements\n        mid1 = sorted_data[n // 2 - 1]\n        mid2 = sorted_data[n // 2]\n        median_val = (mid1 + mid2) / 2.0\n        # Return as int if it's a whole number, otherwise float\n        return int(median_val) if median_val == int(median_val) else median_val"}
{"task_id": "HumanEval/46", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the fib4 function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef fib4(n: int, _memo={0: 0, 1: 0, 2: 2, 3: 0}) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _memo:\n        return _memo[n]\n\n    # Calculate iteratively up to n\n    # Find the maximum key already present in _memo to start the iteration from the next number\n    start_index = max(_memo.keys()) + 1 if _memo else 0\n    for i in range(start_index, n + 1):\n        _memo[i] = _memo[i-1] + _memo[i-2] + _memo[i-3] + _memo[i-4]\n\n    return _memo[n]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"\n    Calculates 2^n modulo p using binary exponentiation.\n    Assumes n is a non-negative integer and p is a positive integer.\n    \"\"\"\n    res = 1\n    base = 2 % p\n\n    while n > 0:\n        if n % 2 == 1:\n            res = (res * base) % p\n        base = (base * base) % p\n        n //= 2\n    return res"}
