{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        return s_x[::-1]  # Reverse the string if shift strictly exceeds number of digits.\n\n    # Perform circular right shift. A shift of 0 or a multiple of num_digits\n    # results in the original string, handled correctly by modulo and slicing.\n    effective_shift = shift % num_digits\n    return s_x[num_digits - effective_shift:] + s_x[:num_digits - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of all uppercase characters in the input string.\n    Only characters A-Z contribute to the sum.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        # Check if the character is an uppercase letter (A-Z)\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a word, where 'a', 'e', 'i', 'o', 'u' are always vowels.\n    'y' counts as a vowel only if it is the last character of the word, case-insensitively.\n    \"\"\"\n    vowels = \"aeiou\"\n    count = 0\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    digits_list = list(str(x))\n    num_digits = len(digits_list)\n\n    if num_digits == 0:\n        return \"\"\n\n    if shift > num_digits:\n        # If shift is greater than the number of digits, reverse the digits.\n        manipulated_digits = digits_list[::-1]\n    else:\n        # Otherwise, perform a circular right shift.\n        # Normalize the shift amount to handle cases where shift might be 0 or equal to num_digits.\n        actual_shift = shift % num_digits\n        manipulated_digits = digits_list[-actual_shift:] + digits_list[:-actual_shift]\n\n    return \"\".join(manipulated_digits)"}
{"task_id": "HumanEval/63", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to FibFib calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s: str) -> int:\n    \"\"\"Counts the number of vowels in a word, where 'y' is a vowel only at the end.\n    Vowels include 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    if not s:\n        return 0\n\n    count = 0\n    s_lower = s.lower()\n    last_char_index = len(s_lower) - 1\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == last_char_index:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/68", "solution": "import math\ndef pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in a list of non-negative integers.\n    Returns `[value, index]` or `[]` if no even numbers are found or the list is empty.\n    \"\"\"\n    smallest_even_value = math.inf\n    smallest_even_index = -1\n\n    for index, node_value in enumerate(arr):\n        if node_value % 2 == 0:\n            if node_value < smallest_even_value:\n                smallest_even_value = node_value\n                smallest_even_index = index\n            elif node_value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/67", "solution": "import re\nclass ParsingError(Exception):\n    \"\"\"Custom exception for errors during fruit string parsing.\"\"\"\n    pass\nclass FruitCounts:\n    \"\"\"Data transfer object for parsed apple and orange counts.\"\"\"\n    def __init__(self, apples: int, oranges: int):\n        self.apples = apples\n        self.oranges = oranges\nclass FruitParser:\n    \"\"\"Parses a string to extract apple and orange counts.\"\"\"\n\n    @staticmethod\n    def parse_fruit_string(s: str) -> FruitCounts:\n        \"\"\"Parses a string like \"X apples and Y oranges\" to extract counts.\"\"\"\n        match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n        if not match:\n            raise ParsingError(f\"Invalid fruit string format: '{s}'.\")\n\n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        return FruitCounts(apples, oranges)\nclass FruitCalculator:\n    \"\"\"Calculates the number of mango fruits.\"\"\"\n\n    @staticmethod\n    def calculate_mangoes(fruit_string: str, total_fruits: int) -> int:\n        \"\"\"Calculates mangoes based on apple, orange, and total counts.\"\"\"\n        fruit_counts = FruitParser.parse_fruit_string(fruit_string)\n        total_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n        return total_fruits - total_apples_oranges\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    return FruitCalculator.calculate_mangoes(s, n)"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest positive integer whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists in the given non-empty list of positive integers.\n    \"\"\"\n    # Calculate the frequency of each unique integer.\n    frequency_map = {}\n    for num in lst:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    # Identify all integers x such that x > 0 and frequency(x) >= x.\n    candidates = []\n    for num, freq in frequency_map.items():\n        # The 'num > 0' check is technically redundant due to input constraints.\n        if num > 0 and freq >= num:\n            candidates.append(num)\n\n    # Return the greatest candidate or -1.\n    if not candidates:\n        return -1\n    else:\n        return max(candidates)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even-valued node and its original index in an array.\n    If multiple nodes have the same smallest even value, the one with the smallest index is chosen.\n    \"\"\"\n    smallest_even_value = -1\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_value == -1 or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # Prioritize smaller index for same smallest even value.\n                smallest_even_index = i\n\n    if smallest_even_value == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given apple, orange counts and total fruits.\n    It parses the fruit counts from the input string `s` and subtracts them from `n`.\n    \"\"\"\n    match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    return n - (apples + oranges)"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    if not lst:\n        return -1\n\n    # Calculate frequencies of each integer in the list.\n    frequencies = {}\n    for number in lst:\n        frequencies[number] = frequencies.get(number, 0) + 1\n\n    # Identify integers that meet the frequency condition.\n    qualifying_integers = []\n    for value, frequency in frequencies.items():\n        if value > 0 and frequency >= value: # Filter for positive values, as per design logic.\n            qualifying_integers.append(value)\n\n    # Return the greatest qualifying integer or -1.\n    if not qualifying_integers:\n        return -1\n\n    return max(qualifying_integers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value, then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy to easily extract min/max using two pointers\n    sorted_list = sorted(lst)\n    result = []\n\n    left = 0\n    right = len(sorted_list) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_list[left])\n            left += 1\n        else:\n            result.append(sorted_list[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting starts with the minimum, then maximum of remaining, and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_elements = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while sorted_elements:\n        if is_min_turn:\n            result.append(sorted_elements.pop(0))\n        else:\n            result.append(sorted_elements.pop())\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    is_balanced = q == q[::-1]\n    total_weight = sum(q)\n\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/72", "solution": "def is_palindrome(q):\n    \"\"\"Checks if a list is a palindrome.\"\"\"\n    return q == q[::-1]\ndef calculate_sum(q):\n    \"\"\"Calculates the sum of elements in a list.\"\"\"\n    return sum(q)\ndef will_it_fly(q,w):\n    '''\n    Returns True if the object q will fly, and False otherwise.\n    An object flies if it's a palindrome and its sum is less than or equal to the maximum possible weight w.\n    '''\n    is_balanced = is_palindrome(q)\n    total_weight = calculate_sum(q)\n    return is_balanced and total_weight <= w"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to two decimal places, or -1.0 if invalid.\n    \"\"\"\n    # Validate side lengths as positive and satisfying triangle inequality.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate semi-perimeter and area using Heron's formula.\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements that need to be changed to make the array palindromic.\n    One change allows altering an element to any other element.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    left, right = 0, n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
