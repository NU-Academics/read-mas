{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of the three numbers is equal to the sum of the other two,\n    and all numbers are integers. Returns True for this condition, False otherwise.\n    \"\"\"\n    if not (x == int(x) and y == int(y) and z == int(z)):\n        return False\n\n    # Convert to int for precise sum comparison, as numbers are confirmed to be integers.\n    x_val, y_val, z_val = int(x), int(y), int(z)\n\n    return (x_val == y_val + z_val) or \\\n           (y_val == x_val + z_val) or \\\n           (z_val == x_val + y_val)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    if not S:\n        return 0\n\n    sentences_with_delimiters = re.split(r'([.?!])', S)\n\n    parsed_sentences = []\n    current_sentence_parts = []\n\n    for part in sentences_with_delimiters:\n        if part in ['.', '?', '!']:\n            if current_sentence_parts:\n                sentence = \"\".join(current_sentence_parts).strip()\n                if sentence:\n                    parsed_sentences.append(sentence)\n                current_sentence_parts = []\n        else:\n            current_sentence_parts.append(part)\n\n    if current_sentence_parts:\n        sentence = \"\".join(current_sentence_parts).strip()\n        if sentence:\n            parsed_sentences.append(sentence)\n\n    boredom_count = 0\n    for sentence in parsed_sentences:\n        if sentence.startswith(\"I \") or sentence == \"I\":\n            boredom_count += 1\n\n    return boredom_count"}
