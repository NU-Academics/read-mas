{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the list to efficiently check only adjacent elements for proximity.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"\n    Decomposes a positive float into its integer and decimal parts.\n    Returns the decimal part, which is always between 0 (inclusive) and 1 (exclusive).\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detects if an account balance, starting at zero, falls below zero at any point.\n    Returns True if balance falls below zero, False otherwise.\n    \"\"\"\n    current_balance = 0\n    for op_amount in operations:\n        current_balance += op_amount\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates distinct, balanced groups of parentheses from a string, ignoring spaces.\n    Each returned group is balanced and not nested at the top level.\n    \"\"\"\n    result = []\n    current_group = \"\"\n    balance = 0\n\n    # Clean the input string by removing all space characters.\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    for char in cleaned_string:\n        current_group += char\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # A balanced, non-nested group is identified when balance returns to zero.\n        if balance == 0:\n            if current_group:  # Add the group if it's not empty.\n                result.append(current_group)\n            current_group = \"\"  # Reset for the next potential group.\n        # If balance drops below zero, the current sequence is malformed; discard and reset.\n        elif balance < 0:\n            balance = 0\n            current_group = \"\"\n\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates distinct, balanced, top-level groups of parentheses from an input string.\n    Spaces are ignored during parsing and removed from the output groups.\"\"\"\n    result = []\n    current_group_chars = []\n    balance = 0\n\n    for char in paren_string:\n        if char == '(':\n            balance += 1\n            current_group_chars.append(char)\n        elif char == ')':\n            balance -= 1\n            current_group_chars.append(char)\n        # Spaces and other characters are ignored by not appending them to current_group_chars\n\n        if balance == 0 and current_group_chars:\n            # Found a balanced group. Clean it and add to results.\n            cleaned_group = \"\".join(current_group_chars).replace(\" \", \"\")\n            result.append(cleaned_group)\n            current_group_chars = [] # Reset for the next group\n\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return numbers[:]\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) for a list of numbers.\n    MAD is the average absolute difference between each element and the mean of the dataset.\n    \"\"\"\n    n = len(numbers)\n    # The critical requirements forbid explicit exception raising for edge cases.\n    # If numbers is empty, sum(numbers)/n will raise ZeroDivisionError naturally.\n    mean = sum(numbers) / n\n\n    absolute_differences = [abs(x - mean) for x in numbers]\n\n    return sum(absolute_differences) / n"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a given integer 'delimeter' between every two consecutive elements of a list of 'numbers'.\n    Returns a new list with the delimeter interspersed, leaving the original list unchanged.\"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    Calculates the Mean Absolute Deviation (MAD) for a list of numbers,\n    defined as the average of the absolute differences between each data point and the dataset's mean.\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_depth(group: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single parentheses group.\n    This helper function tracks current depth and updates the maximum observed.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string of space-separated parentheses groups.\n    Outputs the deepest nesting level for each group as a list of integers.\n    \"\"\"\n    if not paren_string:\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group_str in groups:\n        if group_str:\n            results.append(_calculate_max_depth(group_str))\n    return results"}
