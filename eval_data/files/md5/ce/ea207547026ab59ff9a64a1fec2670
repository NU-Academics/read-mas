{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    count = 0\n    for char in brackets:\n        if char == '<':\n            count += 1\n        elif char == '>':\n            count -= 1\n        if count < 0:  # Closing bracket without a corresponding open bracket.\n            return False\n    return count == 0  # True if all open brackets are closed, False otherwise."}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"\n    Return sorted unique common elements for two lists.\n    The function efficiently finds shared elements using sets and sorts them.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    result_list = list(common_elements_set)\n    result_list.sort()\n    return result_list"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    return sorted(list(common_set))"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"\n    Return the largest prime factor of n.\n    Assumes n > 1 and is not a prime.\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors\n    i = 3\n    while i * i <= n: # Iterate from 3 up to sqrt(n)\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, it must be a prime factor itself\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    def _is_non_decreasing(lst: list) -> bool:\n        \"\"\"Checks if the list is monotonically non-decreasing.\"\"\"\n        for i in range(len(lst) - 1):\n            if lst[i] > lst[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(lst: list) -> bool:\n        \"\"\"Checks if the list is monotonically non-increasing.\"\"\"\n        for i in range(len(lst) - 1):\n            if lst[i] < lst[i+1]:\n                return False\n        return True\n\n    return _is_non_decreasing(l) or _is_non_increasing(l)"}
{"task_id": "HumanEval/55", "solution": "_fib_memo = {0: 0, 1: 1}\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _fib_memo:\n        return _fib_memo[n]\n\n    result = fib(n - 1) + fib(n - 2)\n    _fib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    # The encode_shift function applies a fixed shift to every character in the input string,\n    # effectively mapping any character to a lowercase English letter within the 'a'-'z' range.\n    # To decode, we apply the inverse operation.\n    # The original formula is: ((ord(ch) + SHIFT - ord(\"a\")) % ALPHABET_SIZE) + ord(\"a\")\n    # To reverse, we subtract the shift: ((ord(ch) - SHIFT - ord(\"a\")) % ALPHABET_SIZE) + ord(\"a\")\n\n    SHIFT_AMOUNT = 5\n    ALPHABET_SIZE = 26\n    ORD_A = ord('a')\n\n    decoded_chars = []\n    for ch in s:\n        # Calculate the 0-indexed position relative to 'a'\n        # Then subtract the shift amount, and apply modulo 26 for wrap-around.\n        # Python's % operator handles negative numbers correctly for this (e.g., -1 % 26 = 25).\n        # Finally, add ord('a') back to get the ASCII value of the decoded character.\n        shifted_ord = ((ord(ch) - ORD_A - SHIFT_AMOUNT) % ALPHABET_SIZE) + ORD_A\n        decoded_chars.append(chr(shifted_ord))\n    return \"\".join(decoded_chars)"}
{"task_id": "HumanEval/59", "solution": "import math\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n.\n    Assumes n > 1 and is not a prime.\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n).\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n\n    # If n is still greater than 2, it must be a prime factor itself.\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
