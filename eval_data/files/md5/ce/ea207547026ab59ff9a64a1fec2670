{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of a string where characters within each word are sorted.\n    Word order and blank spaces are preserved.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string by one or more spaces, preserving the space delimiters in the result.\n    parts = re.split(r'(\\s+)', s)\n\n    result_parts = []\n    for part in parts:\n        # If the part is not empty and not just whitespace, sort its characters.\n        # Otherwise, it's a space block or an empty string, which should be preserved.\n        if part.strip():\n            result_parts.append(\"\".join(sorted(part)))\n        else:\n            result_parts.append(part)\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of 'x' in a nested list 'lst' and returns their\n    (row, column) coordinates. Coordinates are sorted primarily by row ascending,\n    then by column descending.\n    \"\"\"\n    result_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                result_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row (ascending), secondarily by column (descending)\n    result_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return result_coordinates"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of 'x' in the 2D 'lst' and returns their sorted coordinates.\n    Coordinates are sorted primarily by row ascending, and secondarily by column descending.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        # Iterates through each element in the current row.\n        for c_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sorts the collected coordinates based on the specified criteria.\n    # Primary sort is by row ascending, secondary by column descending.\n    sorted_coordinates = sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))\n    return sorted_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new sorted array, leaving the original unmodified.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    first_last_sum = array[0] + array[-1]\n\n    # Create a copy to ensure the original array remains unchanged.\n    array_copy = list(array)\n\n    if first_last_sum % 2 != 0:  # Sum is odd, sort ascending\n        array_copy.sort(reverse=False)\n    else:  # Sum is even, sort descending\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 places.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    shift_amount = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            encrypted_char_code = (ord(char) - start + shift_amount) % 26 + start\n            encrypted_chars.append(chr(encrypted_char_code))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            encrypted_char_code = (ord(char) - start + shift_amount) % 26 + start\n            encrypted_chars.append(chr(encrypted_char_code))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new array, sorted ascending if the sum is odd, or descending if the sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Characters within each word are sorted alphabetically by ASCII value,\n    while maintaining the original word order and spacing.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Splits the string into words and space delimiters, preserving their order.\n    parts = re.split(r'(\\s+)', s)\n    filtered_parts = [part for part in parts if part]\n\n    result_parts = []\n    for part in filtered_parts:\n        if part.strip():  # Sort characters if the part is a non-space word.\n            result_parts.append(\"\".join(sorted(part)))\n        else:  # Preserve sequences of spaces as they are.\n            result_parts.append(part)\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters 4 places forward, preserving case.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    shift = 4\n\n    for char in s:\n        is_lower = 'a' <= char <= 'z'\n        is_upper = 'A' <= char <= 'Z'\n\n        if is_lower or is_upper:\n            # Determine the starting ASCII value for the alphabet (a or A)\n            start_ord = ord('a') if is_lower else ord('A')\n\n            # Calculate the new shifted ordinal value, handling wrap-around\n            shifted_ord = start_ord + (ord(char) - start_ord + shift) % 26\n\n            encrypted_chars.append(chr(shifted_ord))\n        else:\n            # Non-alphabetic characters are appended unchanged\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
