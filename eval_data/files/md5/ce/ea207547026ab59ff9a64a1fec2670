{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    This function finds the Nth number that is both a Fibonacci number and a prime number.\n    \"\"\"\n\n    def is_prime_inline(num: int) -> bool:\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def generate_fibonacci_sequence_inline() -> 'Generator[int]':\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_generator = generate_fibonacci_sequence_inline()\n\n    for fib_num in fib_generator:\n        # Skip 0 and 1, as they are not prime numbers.\n        if fib_num < 2:\n            continue\n\n        if is_prime_inline(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    import math\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers sequentially, starting from 0, 1.\"\"\"\n        def __init__(self):\n            self.a = 0\n            self.b = 1\n\n        def get_next(self) -> int:\n            \"\"\"Calculates and returns the next Fibonacci number.\"\"\"\n            result = self.a\n            self.a, self.b = self.b, self.a + self.b\n            return result\n\n        def reset(self) -> None:\n            \"\"\"Resets the generator to its initial state.\"\"\"\n            self.a = 0\n            self.b = 1\n\n    class PrimeChecker:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            \"\"\"Checks if num is prime using trial division up to its square root.\"\"\"\n            if num < 2:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            for i in range(3, int(math.sqrt(num)) + 1, 2):\n                if num % i == 0:\n                    return False\n            return True\n\n    class PrimeFibonacciService:\n        \"\"\"Orchestrates finding the n-th number that is both Fibonacci and prime.\"\"\"\n        def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n            self.fib_generator = fib_generator\n            self.prime_checker = prime_checker\n\n        def find_nth_prime_fib(self, n: int) -> int:\n            \"\"\"Iterates to find the n-th prime Fibonacci number.\"\"\"\n            self.fib_generator.reset()\n            prime_fib_count = 0\n            current_fib = 0\n\n            # The loop continues until the n-th prime Fibonacci number is found.\n            while prime_fib_count < n:\n                current_fib = self.fib_generator.get_next()\n                # 0 and 1 are not prime; primality checks start from 2.\n                if current_fib > 1 and self.prime_checker.is_prime(current_fib):\n                    prime_fib_count += 1\n            return current_fib\n\n    class PrimeFibonacciController:\n        \"\"\"Provides the public interface for the prime_fib function.\"\"\"\n        def __init__(self):\n            fib_generator = FibonacciGenerator()\n            prime_checker = PrimeChecker()\n            self.prime_fib_service = PrimeFibonacciService(fib_generator, prime_checker)\n\n        def get_prime_fib(self, n: int) -> int:\n            \"\"\"Delegates the task of finding the n-th prime Fibonacci number.\"\"\"\n            return self.prime_fib_service.find_nth_prime_fib(n)\n\n    # Initialize the controller and call its method.\n    controller = PrimeFibonacciController()\n    return controller.get_prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to enable the two-pointer approach.\n\n    for i in range(n - 2):\n        # Skip duplicate elements for 'i' to avoid redundant checks.\n        # This check is crucial to ensure distinct elements by index if values are duplicated,\n        # but also to optimize by not re-evaluating triplets with the same first element.\n        if i > 0 and l[i] == l[i - 1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n    return False"}
