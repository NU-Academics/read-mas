{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/44", "solution": "class BaseConverterError(ValueError):\n    \"\"\"Custom exception for base conversion errors.\"\"\"\n    pass\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    MIN_BASE = 2\n    MAX_BASE = 9\n\n    # Input validation as per design document\n    if not isinstance(x, int) or x < 0:\n        raise BaseConverterError(\"Input number 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (MIN_BASE <= base <= MAX_BASE):\n        raise BaseConverterError(\n            f\"Base must be an integer between {MIN_BASE} and {MAX_BASE} (inclusive).\"\n        )\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(result[::-1])"}
