{"task_id": "HumanEval/36", "solution": "def _count_sevens_in_number(num: int) -> int:\n    \"\"\"Counts occurrences of the digit '7' within a given integer.\n    It converts the number to a string and counts '7's.\n    \"\"\"\n    return str(num).count('7')\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    \"\"\"\n    total_sevens = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens += _count_sevens_in_number(i)\n    return total_sevens"}
{"task_id": "HumanEval/31", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for divisibility by odd numbers from 3 up to the square root of n.\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/32", "solution": "import math\nTOLERANCE = 1e-6\nMAX_ITERATIONS = 1000\nINITIAL_SEARCH_RANGE = 1.0\nMAX_SEARCH_MULTIPLIER = 1000.0\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list) -> float:\n    \"\"\"\n    Finds a single real root x for the polynomial represented by xs using bisection method.\n    Raises ValueError if no bracket is found or if convergence fails.\n    \"\"\"\n    a = -INITIAL_SEARCH_RANGE\n    b = INITIAL_SEARCH_RANGE\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    if abs(fa) < TOLERANCE:\n        return a\n    if abs(fb) < TOLERANCE:\n        return b\n\n    search_factor = 1.0\n    while fa * fb >= 0 and search_factor < MAX_SEARCH_MULTIPLIER:\n        search_factor *= 2\n        a = -INITIAL_SEARCH_RANGE * search_factor\n        b = INITIAL_SEARCH_RANGE * search_factor\n        fa = poly(xs, a)\n        fb = poly(xs, b)\n\n        if abs(fa) < TOLERANCE:\n            return a\n        if abs(fb) < TOLERANCE:\n            return b\n\n        if math.isinf(fa) or math.isinf(fb):\n            # If infinities are hit, the root is likely within a smaller range or coefficients are extreme.\n            break\n\n    if fa * fb >= 0:\n        raise ValueError(\"Could not find an initial bracket for the root within the search range.\")\n\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        fmid = poly(xs, mid)\n\n        if abs(fmid) < TOLERANCE or (b - a) / 2 < TOLERANCE:\n            return mid\n\n        if fa * fmid < 0:\n            b = mid\n            fb = fmid\n        else:\n            a = mid\n            fa = fmid\n\n    raise ValueError(\"Bisection method did not converge within maximum iterations.\")"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"\n    Counts occurrences of digit '7' in numbers less than n that are divisible by 11 or 13.\n    It iterates from 1 up to n-1 and sums the counts for matching numbers.\n    \"\"\"\n    total_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_count += str(i).count('7')\n    return total_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result = list(l) # Create a new list copy to preserve original odd elements\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string previously encoded by encode_cyclic.\n    It returns the original string before encoding.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"Sorts elements at even indices in a list while preserving odd-indexed elements.\n    A new list is returned with even-indexed elements sorted in ascending order.\"\"\"\n\n    even_indexed_elements = []\n    for i in range(0, len(l), 2):\n        even_indexed_elements.append(l[i])\n\n    even_indexed_elements.sort()\n\n    result_list = l[:]\n\n    sorted_even_idx = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_indexed_elements[sorted_even_idx]\n        sorted_even_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # For a group 'bca', to reverse to 'abc', move the last char 'a' to the front.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
