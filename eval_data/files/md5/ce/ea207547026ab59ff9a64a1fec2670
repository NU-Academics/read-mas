{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    n = len(b)\n    rotations = []\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.append(rotated_b)\n\n    for rotation in rotations:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Finds the strongest extension for a class based on CAP - SM strength.\n    Returns 'ClassName.StrongestExtensionName' or 'ClassName' if no extensions.\n    \"\"\"\n    if not extensions:\n        return class_name\n\n    def _count_uppercase(text: str) -> int:\n        return sum(1 for char in text if 'A' <= char <= 'Z')\n\n    def _count_lowercase(text: str) -> int:\n        return sum(1 for char in text if 'a' <= char <= 'z')\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates strength as CAP - SM.\"\"\"\n        cap = _count_uppercase(extension_name)\n        sm = _count_lowercase(extension_name)\n        return cap - sm\n\n    strongest_ext_name = \"\"\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\"\"\"\n\n    # Handling for empty pattern 'b'. An empty string is a substring of any string.\n    if not b:\n        return True\n\n    # If 'a' (text) is empty and 'b' (pattern) is not empty, no match is possible.\n    if not a:\n        return False\n\n    # Generate all unique cyclic rotations of 'b'.\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_word = b[i:] + b[:i]\n        rotations.add(rotated_word)\n\n    # Check if any rotation is a substring of 'a'.\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP-SM strength, choosing the first in case of a tie.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n\n    strongest_extension_name = extensions[0]\n\n    cap_count_first = 0\n    sm_count_first = 0\n    for char in strongest_extension_name:\n        if 'A' <= char <= 'Z':\n            cap_count_first += 1\n        elif 'a' <= char <= 'z':\n            sm_count_first += 1\n    max_strength = cap_count_first - sm_count_first\n\n    for ext_name in extensions[1:]:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Counts even and odd digits within an integer, ignoring its sign. Returns a tuple (even_count, odd_count).\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n        even_odd_count(0)   ==> (1, 0)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert number to its absolute string representation.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple indicating the count of even and odd digits. Negative numbers are processed by their absolute value.\"\"\"\n    s_num = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    roman_numeral = \"\"\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral += symbol\n            temp_num -= value\n    return roman_numeral.lower()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Returns the string with the maximum number of unique characters.\n    If there's a tie, the lexicographically smallest string is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        # Calculate unique characters for the current word\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Apply lexicographical tie-breaker\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer to its lowercase Roman numeral equivalent.\n    Assumes input is within the range [1, 1000] as per requirements.\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Simulates a rabbit's carrot consumption based on its current eaten amount, required amount, and available stock.\n    Returns a list: [total carrots eaten after meal, remaining stock].\n    \"\"\"\n    carrots_eaten_from_stock = min(need, remaining)\n    total_eaten = number + carrots_eaten_from_stock\n    carrots_left = remaining - carrots_eaten_from_stock\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Input validation: All side lengths must be numeric\n    if not all(isinstance(s, (int, float)) for s in [a, b, c]):\n        raise ValueError(\"All side lengths must be numeric.\")\n\n    # Sort the sides to easily identify s1, s2, and s3 (hypotenuse)\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Input validation: All side lengths must be positive\n    if not all(s > 0 for s in sides):\n        raise ValueError(\"All side lengths must be positive.\")\n\n    # Check Pythagorean theorem: s1^2 + s2^2 = s3^2\n    # Use math.isclose for robust floating point comparison to account for potential precision errors.\n    # The design document suggests EPSILON = 1e-9 for relative tolerance.\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=1e-9)"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # FR2: Validate that all side lengths are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # FR3: Validate the triangle inequality theorem.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return False\n\n    # FR4: Identify the longest side and FR5: Apply Pythagorean theorem.\n    # Sort sides to easily identify the hypotenuse (longest side).\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Use a tolerance for floating-point comparisons.\n    FLOAT_TOLERANCE = 1e-9\n\n    # Check if s1^2 + s2^2 == s3^2\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=FLOAT_TOLERANCE)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the most unique characters, breaking ties lexicographically.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order (ascending)\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    # Compute the MD5 hash using the hashlib module.\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    If s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    \"\"\"\n\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(char.swapcase())\n            else:\n                result_chars.append(char)\n\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"Processes a string to reverse letter case or reverse the whole string if no letters are present.\n    Returns the modified string.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and carrots left after a rabbit's meal.\n    The rabbit eats either its 'need' or all 'remaining' carrots, whichever is less.\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten = number + carrots_to_eat\n    carrots_left = remaining - carrots_to_eat\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "from typing import List, Union, Callable\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression constructed from a list of operators and operands.\n    The function uses a shunting-yard-like algorithm to respect operator precedence.\n    \"\"\"\n\n    OPERATOR_PRECEDENCE = {\n        '**': 3,\n        '*': 2,\n        '//': 2,\n        '+': 1,\n        '-': 1,\n    }\n    OPERATOR_FUNCTIONS: dict[str, Callable[[int, int], int]] = {\n        '+': lambda a, b: a + b,\n        '-': lambda a, b: a - b,\n        '*': lambda a, b: a * b,\n        '//': lambda a, b: a // b,\n        '**': lambda a, b: a ** b,\n    }\n\n    def apply_operation(op_symbol: str, left: int, right: int) -> int:\n        \"\"\"Applies the operation associated with the given symbol to two operands.\"\"\"\n        return OPERATOR_FUNCTIONS[op_symbol](left, right)\n\n    # Combine operands and operators into a single token list\n    tokens: List[Union[int, str]] = []\n    for i in range(len(operand)):\n        tokens.append(operand[i])\n        if i < len(operator):\n            tokens.append(operator[i])\n\n    operand_stack: List[int] = []\n    operator_stack: List[str] = []\n\n    for token in tokens:\n        if isinstance(token, int):\n            operand_stack.append(token)\n        elif isinstance(token, str):  # It's an operator symbol\n            current_operator_symbol = token\n            current_precedence = OPERATOR_PRECEDENCE[current_operator_symbol]\n\n            while (operator_stack and\n                   OPERATOR_PRECEDENCE[operator_stack[-1]] >= current_precedence):\n                op_symbol = operator_stack.pop()\n                right = operand_stack.pop()\n                left = operand_stack.pop()\n                operand_stack.append(apply_operation(op_symbol, left, right))\n            operator_stack.append(current_operator_symbol)\n\n    # Evaluate any remaining operators in the stack\n    while operator_stack:\n        op_symbol = operator_stack.pop()\n        right = operand_stack.pop()\n        left = operand_stack.pop()\n        operand_stack.append(apply_operation(op_symbol, left, right))\n\n    return operand_stack[0]"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, this method returns a list of all even integers\n    between a and b (inclusive), in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits = []\n    for digit in [2, 4, 6, 8]:\n        if min_val <= digit <= max_val:\n            even_digits.append(digit)\n\n    return even_digits"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the single-digit even numbers\n    between them (inclusive), in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits = []\n    for num in range(min_val, max_val + 1):\n        if num < 10 and num % 2 == 0:\n            even_digits.append(num)\n\n    return even_digits"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    # Input Validation\n    if not (len(operator) == len(operand) - 1 and len(operand) >= 2):\n        raise ValueError(\"Operator list length must be one less than operand list length, and operand list must have at least two elements.\")\n\n    if not all(isinstance(op, str) and op in SUPPORTED_OPERATORS for op in operator):\n        raise ValueError(f\"Invalid operator found. Supported operators are: {', '.join(SUPPORTED_OPERATORS)}\")\n\n    if not all(isinstance(opd, int) and opd >= 0 for opd in operand):\n        raise ValueError(\"All operands must be non-negative integers.\")\n\n    # Build the expression string\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_str = \" \".join(expression_parts)\n\n    # Evaluate the expression\n    return eval(expression_str)"}
