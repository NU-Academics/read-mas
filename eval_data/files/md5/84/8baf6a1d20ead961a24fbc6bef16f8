{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n    \n    return \"\".join(digits[::-1])"}
{"task_id": "HumanEval/44", "solution": "def _validate_inputs(x: int, base: int) -> None:\n    \"\"\"Validates input parameters, raises ValueError if invalid.\n    Checks if base is between 2 and 9 and x is non-negative.\n    \"\"\"\n    if not (2 <= base <= 9):\n        raise ValueError(\"Base must be an integer between 2 and 9, inclusive.\")\n    if x < 0:\n        raise ValueError(\"Input number x must be a non-negative integer.\")\n\ndef _convert_to_base(x: int, base: int) -> str:\n    \"\"\"Core conversion algorithm implementation.\n    Converts a non-negative decimal number to a specified base string.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result = \"\"\n    while x > 0:\n        remainder = x % base\n        result = str(remainder) + result\n        x //= base\n    return result\n\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    _validate_inputs(x, base)\n    return _convert_to_base(x, base)"}
