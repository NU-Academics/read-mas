{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Detects if there is a valid subsequence of nested brackets in the input string.\n    Returns True if such a subsequence exists, False otherwise.\n    \"\"\"\n    # State machine to find the pattern '[', then '[', then ']', then ']'.\n    # 0: Looking for the first opening bracket '['.\n    # 1: Found first '[', looking for the second opening bracket '['.\n    # 2: Found second '[', looking for the first closing bracket ']'.\n    # 3: Found first ']', looking for the second closing bracket ']'.\n    state = 0\n    \n    for char in string:\n        if char == '[':\n            if state == 0:\n                state = 1\n            elif state == 1:\n                state = 2\n            # If state is 2 or 3, finding another '[' doesn't change the current search for ']]'.\n        elif char == ']':\n            if state == 1:\n                # The first '[' was closed before a second '[' was found; reset.\n                state = 0\n            elif state == 2:\n                state = 3\n            elif state == 3:\n                return True  # Found the complete nested subsequence '[[ ]]'.\n        \n    return False\n```"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers after applying ceiling rounding to each element in the list.\n    The final sum is returned as an integer.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        squared_number = rounded_number * rounded_number\n        total_sum += squared_number\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "```python\ndef _validate_structure(subsequence: str) -> bool:\n    \"\"\"\n    Validate that a bracket subsequence has a proper structure (balanced brackets).\n    Uses a stack to check for correct pairing of opening and closing brackets.\n    \"\"\"\n    stack = []\n    for char in subsequence:\n        if char == '[':\n            stack.append(char)\n        elif char == ']':\n            if not stack:\n                return False\n            stack.pop()\n    return not stack\n\ndef _parse_brackets(string: str) -> list:\n    \"\"\"\n    Parses the input string to identify and return all valid bracket subsequences.\n    It checks every possible substring for structural validity.\n    \"\"\"\n    valid_subsequences = []\n    n = len(string)\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            sub = string[i:j]\n            if sub and _validate_structure(sub):\n                valid_subsequences.append(sub)\n    return valid_subsequences\n\ndef _check_nesting(subsequence: str) -> bool:\n    \"\"\"\n    Checks if a given valid bracket subsequence contains nested patterns.\n    Nesting is detected if the maximum stack depth during validation reaches 2 or more.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in subsequence:\n        if char == '[':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ']':\n            current_depth -= 1\n    return max_depth >= 2\n\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Checks if a string containing only square brackets has a valid subsequence\n    with at least one nested bracket pattern.\n    \"\"\"\n    if not string:\n        return False\n\n    subsequences = _parse_brackets(string)\n    for sub in subsequences:\n        if _check_nesting(sub):\n            return True\n    return False\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is standalone.\n    Returns True if standalone, False otherwise or if string is empty/ends with space.\n    \"\"\"\n    if not txt:\n        return False\n    \n    if txt[-1] == ' ':\n        return False\n\n    last_char = txt[-1]\n    if not last_char.isalpha():\n        return False\n\n    # Check if standalone: either it's the only char, or the char before it is a space.\n    if len(txt) == 1:\n        return True\n    \n    return txt[-2] == ' '\n\n```"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers after applying ceiling rounding to each element.\n    This function processes numerical lists sequentially according to design specifications.\n    \"\"\"\n\n    def _apply_ceiling(value):\n        \"\"\"Applies the ceiling operation to a given numerical value.\n        It rounds the input float up to the nearest integer.\n        \"\"\"\n        return math.ceil(value)\n\n    def _calculate_square(value):\n        \"\"\"Calculates the square of an integer value.\n        It multiplies the number by itself to get its square.\n        \"\"\"\n        return value * value\n\n    def _sum_values(values):\n        \"\"\"Sums a list of integer values.\n        It returns the total sum of all elements in the input list.\n        \"\"\"\n        return sum(values)\n\n    squared_ceiling_values = []\n    for num in lst:\n        # Apply ceiling rounding to the current number.\n        ceiling_num = _apply_ceiling(num)\n        # Calculate the square of the ceiling-rounded number.\n        squared_num = _calculate_square(ceiling_num)\n        squared_ceiling_values.append(squared_num)\n\n    # Return the total sum of all squared ceiling values.\n    return _sum_values(squared_ceiling_values)"}
{"task_id": "HumanEval/134", "solution": "def _is_empty(txt: str) -> bool:\n    \"\"\"Checks if the given string is empty.\"\"\"\n    return len(txt) == 0\n\ndef _ends_with_space(txt: str) -> bool:\n    \"\"\"Checks if the given string ends with a space character.\"\"\"\n    return len(txt) > 0 and txt[-1] == ' '\n\ndef _is_alphabetical(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetical letter.\"\"\"\n    return char.isalpha()\n\ndef _is_preceded_by_space(txt: str, position: int) -> bool:\n    \"\"\"Checks if the character at 'position' is preceded by a space.\"\"\"\n    return position > 0 and txt[position - 1] == ' '\n\ndef check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Determines if the last character of a string is an alphabetical letter\n    and is not part of a word (i.e., preceded by a space).\n    \"\"\"\n    if _is_empty(txt):\n        return False\n    \n    if _ends_with_space(txt):\n        return False\n\n    last_char = txt[-1]\n    last_char_position = len(txt) - 1\n\n    if not _is_alphabetical(last_char):\n        return False\n\n    # Check if the last character is NOT part of a word (i.e., preceded by a space)\n    if _is_preceded_by_space(txt, last_char_position):\n        return True\n    else:\n        # It's an alphabetical char, but part of a word (not preceded by space)\n        return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element not\n    greater than or equal to its predecessor. Returns -1 if no such element exists.\"\"\"\n    \n    largest_violating_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_violating_index = i\n            \n    return largest_violating_index"}
