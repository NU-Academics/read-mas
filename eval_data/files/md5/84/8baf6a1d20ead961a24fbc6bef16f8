{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef _remove_spaces(input_str: str) -> str:\n    \"\"\"Remove all space characters from input string.\"\"\"\n    return input_str.replace(\" \", \"\")\n\n\ndef _is_balanced(group: str) -> bool:\n    \"\"\"Validate that a group has balanced parentheses.\"\"\"\n    balance = 0\n    for char in group:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\n\ndef _parse_groups(clean_str: str) -> List[str]:\n    \"\"\"Parse cleaned string to extract balanced parentheses groups.\"\"\"\n    groups = []\n    current_group = \"\"\n    balance_counter = 0\n    for char in clean_str:\n        current_group += char\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        if balance_counter == 0:\n            if _is_balanced(current_group):\n                groups.append(current_group)\n            current_group = \"\"\n    return groups\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Main entry point that coordinates the separation of parentheses groups.\"\"\"\n    cleaned_string = _remove_spaces(paren_string)\n    return _parse_groups(cleaned_string)"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates balanced parentheses groups from an input string into individual strings.\n    It ignores spaces and handles nested parentheses within each group.\n    \"\"\"\n    cleaned_input = \"\".join(char for char in paren_string if char != ' ')\n    result_groups: List[str] = []\n    current_group: str = \"\"\n    open_count: int = 0\n\n    for char in cleaned_input:\n        current_group += char\n        if char == '(':\n            open_count += 1\n        elif char == ')':\n            open_count -= 1\n\n        if open_count == 0 and current_group:\n            result_groups.append(current_group)\n            current_group = \"\"\n\n    return result_groups"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    mad_result = sum(absolute_differences) / len(absolute_differences)\n    return mad_result\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:  # Only add delimiter if not the last element\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the arithmetic mean of the input dataset.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Compute absolute differences between each element and the mean.\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    # Calculate the average of all absolute differences to get the MAD.\n    mad_value = sum(absolute_differences) / len(absolute_differences)\n\n    return mad_value\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:  # Add delimiter only if not the last element\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits an input string by spaces into individual parentheses groups.\n    Empty strings resulting from multiple spaces are filtered out.\n    \"\"\"\n    return [group for group in input_string.split(' ') if group]\n\n\ndef _calculate_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group.\n    It counts current depth and tracks the highest level reached.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string representing multiple groups of nested parentheses separated by spaces.\n    For each group, it calculates the deepest level of nesting.\n    \"\"\"\n    groups = _split_groups(paren_string)\n    result = []\n    for group in groups:\n        result.append(_calculate_depth(group))\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits an input string into individual parentheses groups by spaces.\n    Empty strings resulting from splitting are filtered out.\n    \"\"\"\n    return [group for group in input_string.split(' ') if group]\n\n\ndef _calculate_max_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group.\n    It iterates through the group, tracking current and maximum depths.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = _split_groups(paren_string)\n    depths = []\n    for group in groups:\n        depths.append(_calculate_max_depth(group))\n    return depths\n```"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = [] # Initialize an empty list to store results.\n    for s in strings:     # Iterate through each string, preserving order.\n        if substring in s: # Perform case-sensitive substring matching.\n            filtered_strings.append(s) # Add the string if the substring is found.\n    return filtered_strings"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum: int = 0\n    current_product: int = 1\n\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        # Handle empty lists by returning the default sum (0) and product (1).\n        return (0, 1)\n    else:\n        # Calculate the sum of all numbers using the built-in sum function.\n        calculated_sum = sum(numbers)\n\n        # Calculate the product of all numbers through iterative multiplication.\n        calculated_product = 1\n        for num in numbers:\n            calculated_product *= num\n\n        return (calculated_sum, calculated_product)\n\n```"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums = []\n    current_max = numbers[0]\n    rolling_maximums.append(current_max)\n\n    for i in range(1, len(numbers)):\n        current_max = max(current_max, numbers[i])\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for i in range(1, len(numbers)):\n        if numbers[i] > current_max:\n            current_max = numbers[i]\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Identifies the longest palindromic postfix and prepends the reverse of the remaining prefix.\n    \"\"\"\n    n = len(string)\n    for i in range(n):\n        if is_palindrome(string[i:]):\n            prefix_to_reverse = string[:i]\n            reversed_prefix = prefix_to_reverse[::-1]\n            return string + reversed_prefix\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    # Perform character-by-character XOR operation on corresponding digits.\n    # The iteration stops at the length of the shorter string, trusting input format.\n    for char_a, char_b in zip(a, b):\n        # Apply XOR truth table: '0' if chars are the same, '1' if different.\n        result_chars.append('1' if char_a != char_b else '0')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string using postfix analysis.\n    Identify the longest palindromic postfix and append the reversed prefix that precedes it.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    s_reversed = string[::-1]\n    # Construct a temporary string for KMP: original_string + unique_char + reversed_string.\n    # The KMP's LPS array will help find the length of the longest palindromic suffix.\n    temp_string = string + '#' + s_reversed\n\n    n = len(temp_string)\n    lps = [0] * n\n    length = 0  # length of the previous longest prefix suffix\n    i = 1\n\n    # Compute the LPS (Longest Proper Prefix which is also a Suffix) array for temp_string.\n    while i < n:\n        if temp_string[i] == temp_string[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # The last value in the LPS array (lps[n-1]) is the length (k) of the longest\n    # suffix of 'string' that is also a prefix of 's_reversed'.\n    # This 'k' effectively represents the length of the longest palindromic suffix of the original string.\n    k = lps[n - 1]\n\n    # The characters to append are from the reversed string, excluding the palindromic suffix.\n    # This means taking s_reversed from index k to the end.\n    return string + s_reversed[k:]"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_bits: List[str] = []\n    # Assume inputs 'a' and 'b' are of equal length and contain only '0' or '1'\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result_bits.append('1')\n        else:\n            result_bits.append('0')\n    return \"\".join(result_bits)\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    max_length = 0\n    result: Optional[str] = None\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            result = s\n    \n    return result\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    # Initialize with the first string to ensure the first occurrence is kept\n    # when multiple strings have the same maximum length.\n    longest_string_found = strings[0]\n\n    for s in strings[1:]:\n        if len(s) > len(longest_string_found):\n            longest_string_found = s\n\n    return longest_string_found\n```"}
