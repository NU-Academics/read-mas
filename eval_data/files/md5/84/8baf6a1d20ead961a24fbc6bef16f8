{"task_id": "HumanEval/58", "solution": "```python\ndef common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    # Use set intersection to efficiently find common and unique elements.\n    # Convert the resulting set to a list and sort it in ascending order.\n    return sorted(list(set(l1) & set(l2)))\n```"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(list(common_elements))"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    d = 2\n\n    # Handle factor 2\n    while n % d == 0:\n        largest_factor = d\n        n //= d\n\n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it must be a prime factor itself, and the largest one.\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. It iterates through potential divisors up to its square.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    d = 3\n    while d * d <= num:\n        if num % d == 0:\n            return False\n        d += 2\n    return True\n\ndef _find_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all unique prime factors of an integer n. It repeatedly divides n by prime candidates, verifying each with _is_prime.\"\"\"\n    factors = []\n    temp_n = n\n    \n    # Check for factor 2\n    if temp_n % 2 == 0:\n        if _is_prime(2):\n            factors.append(2)\n            while temp_n % 2 == 0:\n                temp_n //= 2\n    \n    # Check for odd factors starting from 3\n    d = 3\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            if _is_prime(d):\n                factors.append(d)\n                while temp_n % d == 0:\n                    temp_n //= d\n        d += 2\n        \n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        if _is_prime(temp_n):\n            factors.append(temp_n)\n            \n    return sorted(list(set(factors)))\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    prime_factors = _find_prime_factors(n)\n    return max(prime_factors)"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if every opening bracket has a corresponding closing bracket and they are properly nested.\n    Returns True for balanced and nested bracket sequences, False otherwise.\n    \"\"\"\n    count = 0\n    for char in brackets:\n        if char == '(':\n            count += 1\n        elif char == ')':\n            count -= 1\n        if count < 0:\n            return False\n    return count == 0"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # This formula efficiently calculates the sum of integers from 1 to n.\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    Return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    \n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        if balance < 0:\n            return False\n            \n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"\n    Calculates the derivative of a polynomial represented by coefficients.\n    Applies the power rule for differentiation to each term.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    result = []\n    # Iterate from the second coefficient (x^1 term) onwards.\n    # The index 'i' also represents the power of x for the current coefficient xs[i].\n    for i in range(1, len(xs)):\n        new_coefficient = xs[i] * i\n        result.append(new_coefficient)\n    return result"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"\n    Calculate polynomial derivative using power rule.\n    Returns a list of derivative coefficients.\n    \"\"\"\n    # For each term c*x^n, its derivative is n*c*x^(n-1).\n    # The constant term (n=0) differentiates to zero and is omitted.\n    return [i * xs[i] for i in range(1, len(xs))]"}
{"task_id": "HumanEval/63", "solution": "_memoization_cache: dict[int, int] = {}\n\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number using memoization.\n    It returns 0 for n=0, 0 for n=1, 1 for n=2, and uses a recursive sum for n>=3.\n    \"\"\"\n    if n in _memoization_cache:\n        return _memoization_cache[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memoization_cache[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib sequence iteratively.\n    Base cases are fibfib(0)=0, fibfib(1)=0, fibfib(2)=1.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    a, b, c = 0, 0, 1 # Corresponds to fibfib(0), fibfib(1), fibfib(2)\n\n    for _ in range(3, n + 1):\n        next_fib = a + b + c\n        a, b, c = b, c, next_fib\n    \n    return c"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n\n    def _extract_digits(num: int) -> list[int]:\n        \"\"\"Extracts individual digits from an integer, handling negative numbers by absolute value.\"\"\"\n        s = str(abs(num))\n        return [int(d) for d in s]\n\n    def _shift_right(digits: list[int], s: int) -> list[int]:\n        \"\"\"Performs a circular right shift on a list of digits.\"\"\"\n        if not digits:\n            return []\n        effective_shift = s % len(digits)\n        return digits[-effective_shift:] + digits[:-effective_shift]\n\n    def _reverse_digits(digits: list[int]) -> list[int]:\n        \"\"\"Reverses the order of digits in a list.\"\"\"\n        return digits[::-1]\n\n    digits = _extract_digits(x)\n    digit_count = len(digits)\n\n    if shift <= digit_count:\n        result_digits = _shift_right(digits, shift)\n    else:\n        result_digits = _reverse_digits(digits)\n\n    return \"\".join(map(str, result_digits))"}
{"task_id": "HumanEval/65", "solution": "```python\ndef _validate_integer(x) -> bool:\n    \"\"\"Validates that input is an integer.\n    Per requirements, this function always returns True.\"\"\"\n    return True\n\ndef _validate_shift(shift) -> bool:\n    \"\"\"Validates the shift parameter.\n    Per requirements, this function always returns True.\"\"\"\n    return True\n\ndef _extract_digits(x: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer.\n    Handles the absolute value of the integer.\"\"\"\n    if x == 0:\n        return [0]\n    digits_str = str(abs(x))\n    return [int(d) for d in digits_str]\n\ndef _count_digits(x: int) -> int:\n    \"\"\"Counts the number of digits in an integer.\n    Counts digits of the absolute value.\"\"\"\n    if x == 0:\n        return 1\n    return len(str(abs(x)))\n\ndef _shift_right(digits: list[int], shift: int) -> list[int]:\n    \"\"\"Performs a circular right shift on a list of digits.\n    The shift amount is applied modulo the list's length.\"\"\"\n    if not digits:\n        return []\n    n = len(digits)\n    effective_shift = shift % n\n    return digits[-effective_shift:] + digits[:-effective_shift]\n\ndef _reverse_digits(digits: list[int]) -> list[int]:\n    \"\"\"Reverses the order of a list of digits.\n    Returns a new list with digits in reverse order.\"\"\"\n    return digits[::-1]\n\ndef _digits_to_string(digits: list[int]) -> str:\n    \"\"\"Converts a list of digits into a single string.\n    Each digit is converted to its string representation and then joined.\"\"\"\n    return \"\".join(str(d) for d in digits)\n\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\"\"\"\n    \n    _validate_integer(x)\n    _validate_shift(shift)\n\n    digits = _extract_digits(x)\n    digit_count = _count_digits(x)\n\n    processed_digits: list[int]\n    if shift <= digit_count:\n        processed_digits = _shift_right(digits, shift)\n    else:\n        processed_digits = _reverse_digits(digits)\n\n    return _digits_to_string(processed_digits)\n```"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels ('a', 'e', 'i', 'o', 'u') in a string.\n    'y' is counted as a vowel only if it is the last character of the word.\n    \"\"\"\n    count = 0\n    standard_vowels = \"aeiou\"\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        if lower_char in standard_vowels:\n            count += 1\n        # 'y' is a vowel only when it is at the end of the given word.\n        # It should not be counted if it's not the last character.\n        # If it's the last character and a 'y', it will be handled after the loop to avoid double-counting.\n        # This implies that 'y' should *not* be in standard_vowels for the general loop.\n        \n    # Check for 'y' at the very end of the word, if the string is not empty.\n    if s and s[-1].lower() == 'y':\n        count += 1\n            \n    return count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels ('a', 'e', 'i', 'o', 'u') in a string. 'y' is also counted as a vowel if it is at the end of the word.\"\"\"\n    count = 0\n    vowels = \"aeiou\"\n    \n    for char in s:\n        if char.lower() in vowels:\n            count += 1\n            \n    if len(s) > 0 and s[-1].lower() == 'y':\n        count += 1\n        \n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"\n    Calculates the sum of ASCII values for uppercase characters in the input string.\n    It iterates through the string, identifies uppercase letters, and accumulates their ASCII values.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
