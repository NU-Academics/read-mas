{"task_id": "HumanEval/36", "solution": "```python\nfrom typing import Tuple\n\ndef _is_divisible_by(number: int, divisors: Tuple[int, ...]) -> bool:\n    \"\"\"Checks if a number is divisible by any of the provided divisors.\n    It returns True if divisible by at least one, False otherwise.\n    \"\"\"\n    for divisor in divisors:\n        if number % divisor == 0:\n            return True\n    return False\n\ndef _count_digit_seven(number: int) -> int:\n    \"\"\"Counts the occurrences of the digit 7 in a given integer.\n    The number is converted to a string to easily count the character '7'.\n    \"\"\"\n    return str(number).count('7')\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This function iterates through numbers and uses helper functions for divisibility and digit counting.\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(n):\n        if _is_divisible_by(i, (11, 13)):\n            total_sevens_count += _count_digit_seven(i)\n    return total_sevens_count\n```"}
{"task_id": "HumanEval/36", "solution": "from typing import List\n\ndef is_divisible_by_11(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11.\"\"\"\n    return number % 11 == 0\n\ndef is_divisible_by_13(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 13.\"\"\"\n    return number % 13 == 0\n\ndef count_digit_in_number(number: int, digit: int) -> int:\n    \"\"\"Counts occurrences of a specific digit in a number.\"\"\"\n    return str(number).count(str(digit))\n\ndef find_divisible_numbers(n: int) -> List[int]:\n    \"\"\"Identifies numbers less than n divisible by 11 or 13.\"\"\"\n    qualifying_numbers = []\n    for i in range(1, n):\n        if is_divisible_by_11(i) or is_divisible_by_13(i):\n            qualifying_numbers.append(i)\n    return qualifying_numbers\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n    qualifying_numbers = find_divisible_numbers(n)\n\n    for number in qualifying_numbers:\n        total_count += count_digit_in_number(number, 7)\n\n    return total_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n\n    def extract_even_elements(lst: list) -> list:\n        \"\"\"Extracts elements at even indices from the input list.\"\"\"\n        even_elements = []\n        for i in range(len(lst)):\n            if i % 2 == 0:\n                even_elements.append(lst[i])\n        return even_elements\n\n    def sort_elements(elements: list) -> list:\n        \"\"\"Sorts a list of elements in ascending order.\"\"\"\n        return sorted(elements)\n\n    def reconstruct_list(original: list, sorted_evens: list) -> list:\n        \"\"\"Reconstructs the output list with sorted even elements and preserved odd elements.\"\"\"\n        result = [0] * len(original) \n        even_idx_counter = 0\n        for i in range(len(original)):\n            if i % 2 == 0:\n                result[i] = sorted_evens[even_idx_counter]\n                even_idx_counter += 1\n            else:\n                result[i] = original[i]\n        return result\n\n    if not l:\n        return []\n    if len(l) == 1:\n        return l\n\n    even_elements = extract_even_elements(l)\n    sorted_even_elements = sort_elements(even_elements)\n    \n    return reconstruct_list(l, sorted_even_elements)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n\n    def extract_even_elements(input_list: list) -> list:\n        \"\"\"Extracts elements located at even indices from the input list.\"\"\"\n        even_elements = []\n        for i in range(len(input_list)):\n            if i % 2 == 0:\n                even_elements.append(input_list[i])\n        return even_elements\n\n    def sort_elements(elements_to_sort: list) -> list:\n        \"\"\"Sorts a given list of elements in ascending order.\"\"\"\n        return sorted(elements_to_sort)\n\n    def reconstruct_list(original_list: list, sorted_evens: list) -> list:\n        \"\"\"Rebuilds the list, placing sorted even elements back into their original even positions.\"\"\"\n        result_list = list(original_list)\n        sorted_even_idx = 0\n        for i in range(len(result_list)):\n            if i % 2 == 0:\n                result_list[i] = sorted_evens[sorted_even_idx]\n                sorted_even_idx += 1\n        return result_list\n\n    even_elements = extract_even_elements(l)\n    sorted_even_elements = sort_elements(even_elements)\n    final_list = reconstruct_list(l, sorted_even_elements)\n    return final_list"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string into groups, each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse cycle elements in each group if it has 3 elements.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def _generate_fibonacci() -> Iterator[int]:\n        \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    count = 0\n    fib_gen = _generate_fibonacci()\n\n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. For groups of three, move the last character to the beginning.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "from typing import Iterator\n\ndef _validate_input(n: int) -> bool:\n    \"\"\"Validates the input parameter n, ensuring it is a positive integer.\n    Returns True if n is valid, False otherwise.\"\"\"\n    return n >= 1\n\ndef _generate_fibonacci() -> Iterator[int]:\n    \"\"\"Generates Fibonacci numbers, starting from 2, skipping 0 and 1.\n    Yields successive Fibonacci numbers greater than 1.\"\"\"\n    a, b = 0, 1\n    while True:\n        a, b = b, a + b\n        if a > 1: # Skip 0 and 1 as they are not prime.\n            yield a\n\ndef _is_prime(number: int) -> bool:\n    \"\"\"Checks if a given number is prime using trial division.\n    Returns True if the number is prime, False otherwise.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # Input validation is conceptually performed by _validate_input according to the design.\n    # Per strict requirements, no explicit error handling or exception raising is included.\n    \n    found_count = 0\n    fib_gen = _generate_fibonacci()\n    \n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            found_count += 1\n            if found_count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    n = len(l)\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    return n * n"}
