{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy: at least 3 characters long and every 3 consecutive characters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the three consecutive characters are distinct\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy: at least 3 characters long and every 3 consecutive characters are distinct.\n    Maintains O(n) time complexity by iterating through the string once.\n    \"\"\"\n    n = len(s)\n\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        window = s[i : i + 3]\n        if len(set(window)) != 3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of the input string is a prime number.\n    Returns True if prime, False otherwise.\"\"\"\n\n    def _calculate_length(s: str) -> int:\n        \"\"\"Calculates the length of a string.\"\"\"\n        return len(s)\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given number is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    length = _calculate_length(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Determine if a number is prime using an O(\u221an) algorithm.\n    Numbers less than or equal to 1 are not considered prime.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    \n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_length(string):\n    \"\"\"Checks if the length of a given string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: list) -> list:\n    \"\"\"\n    Convert numerical GPA values to letter grades.\n    Takes a list of GPAs and returns a list of corresponding letter grades.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        elif gpa == 0.0:\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"\n    Convert numerical GPA values to letter grades using a predefined scale.\n    Processes a list of GPAs and returns a list of corresponding letter grades.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        elif gpa == 0.0:\n            letter_grades.append(\"E\")\n    return letter_grades\n```"}
{"task_id": "HumanEval/83", "solution": "def power_of_10(exponent):\n    \"\"\"Calculates 10 raised to the given exponent.\n    Used for base-10 number system calculations.\"\"\"\n    return 10**exponent\n\ndef validate_positive_integer(n):\n    \"\"\"Validates if the input 'n' is a positive integer.\n    Returns True if valid, False otherwise.\"\"\"\n    return n > 0\n\ndef calculate_starting_with_1(n):\n    \"\"\"Calculates the count of n-digit positive integers that start with the digit 1.\n    This count is 10^(n-1).\"\"\"\n    return power_of_10(n - 1)\n\ndef calculate_ending_with_1(n):\n    \"\"\"Calculates the count of n-digit positive integers that end with the digit 1.\n    Handles the n=1 edge case separately.\"\"\"\n    if n == 1:\n        return 1\n    return 9 * power_of_10(n - 2)\n\ndef calculate_both_start_end_1(n):\n    \"\"\"Calculates the count of n-digit positive integers that both start and end with 1.\n    Handles the n=1 edge case separately.\"\"\"\n    if n == 1:\n        return 1\n    # For n > 1, the first digit is 1, the last digit is 1, and the middle (n-2) digits can be anything.\n    return power_of_10(n - 2)\n\ndef apply_inclusion_exclusion(start_count, end_count, both_count):\n    \"\"\"Applies the inclusion-exclusion principle to sum counts.\n    Formula: A + B - A_and_B.\"\"\"\n    return start_count + end_count - both_count\n\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    This function orchestrates validation and calculations using helper functions.\n    \"\"\"\n    # As per \"Trust the caller's inputs\" and \"Do NOT raise exceptions\",\n    # we assume 'n' is a positive integer. The validation call is included as per design.\n    _ = validate_positive_integer(n)\n\n    start_count = calculate_starting_with_1(n)\n    end_count = calculate_ending_with_1(n)\n    both_count = calculate_both_start_end_1(n)\n\n    total_count = apply_inclusion_exclusion(start_count, end_count, both_count)\n    return total_count"}
{"task_id": "HumanEval/83", "solution": "```python\nclass InputValidator:\n    \"\"\"InputValidator handles input parameter validation.\"\"\"\n    def validate_positive_integer(self, n: int) -> bool:\n        \"\"\"Validates that n is a positive integer.\"\"\"\n        # Checks if n is positive.\n        return n > 0\n\n    def check_range(self, n: int) -> bool:\n        \"\"\"Checks if n is within acceptable mathematical limits.\"\"\"\n        # Assumes any positive integer is in range for this problem.\n        return True\n\n\nclass MathematicalCalculator:\n    \"\"\"MathematicalCalculator performs mathematical calculations for digit counting.\"\"\"\n    def calculate_power_of_10(self, exponent: int) -> int:\n        \"\"\"Calculates 10^exponent efficiently.\"\"\"\n        return 10**exponent\n\n    def apply_inclusion_exclusion_principle(self, start: int, end: int, both: int) -> int:\n        \"\"\"Applies |A U B| = |A| + |B| - |A intersection B|.\"\"\"\n        return start + end - both\n\n\nclass DigitCounter:\n    \"\"\"DigitCounter orchestrates counting logic and applies inclusion-exclusion principle.\"\"\"\n    def __init__(self):\n        self._calculator = MathematicalCalculator()\n\n    def count_starting_with_1(self, n: int) -> int:\n        \"\"\"Counts n-digit numbers starting with 1.\"\"\"\n        return self._calculator.calculate_power_of_10(n - 1)\n\n    def count_ending_with_1(self, n: int) -> int:\n        \"\"\"Counts n-digit numbers ending with 1.\"\"\"\n        if n == 1:\n            return 1\n        # For n >= 2, numbers are X...X1. First digit (not last '1') can be 1-9.\n        return 9 * self._calculator.calculate_power_of_10(n - 2)\n\n    def count_both_start_and_end(self, n: int) -> int:\n        \"\"\"Counts numbers both starting and ending with 1.\"\"\"\n        if n == 1:\n            return 1\n        # For n >= 2, numbers are 1X...X1. The middle n-2 digits can be any 0-9.\n        return self._calculator.calculate_power_of_10(n - 2)\n\n    def calculate_total(self, n: int) -> int:\n        \"\"\"Calculates the total count using inclusion-exclusion.\"\"\"\n        starts = self.count_starting_with_1(n)\n        ends = self.count_ending_with_1(n)\n        both = self.count_both_start_and_end(n)\n        return self._calculator.apply_inclusion_exclusion_principle(starts, ends, both)\n\n\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate_positive_integer(n):\n        return 0\n\n    counter = DigitCounter()\n    return counter.calculate_total(n)\n```"}
{"task_id": "HumanEval/84", "solution": "def validate_range(N: int) -> bool:\n    \"\"\"Validates input is within range 0 <= N <= 10000.\n    Returns True if valid, False otherwise.\"\"\"\n    return 0 <= N <= 10000\n\ndef extract_digits(N: int) -> list[int]:\n    \"\"\"Extracts individual digits from integer.\n    Converts number to string, then to list of integers.\"\"\"\n    return [int(d) for d in str(N)]\n\ndef calculate_digit_sum(N: int) -> int:\n    \"\"\"Calculates sum of all digits in integer.\n    Uses extract_digits and sums the resulting list.\"\"\"\n    return sum(extract_digits(N))\n\ndef to_binary_string(value: int) -> str:\n    \"\"\"Converts decimal to binary string representation.\n    Uses Python's bin() function and strips the '0b' prefix.\"\"\"\n    return bin(value)[2:]\n\ndef solve(N: int) -> str:\n    \"\"\"Main entry point for digit sum to binary conversion.\n    Orchestrates input validation, digit sum calculation, and binary conversion.\"\"\"\n    _ = validate_range(N) # Validate range; per constraints, this will always pass.\n\n    digit_sum = calculate_digit_sum(N)\n    binary_result = to_binary_string(digit_sum)\n    return binary_result"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    This function orchestrates validation, digit processing, and binary conversion.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Validates input constraints.\"\"\"\n        def validate_range(self, n: int) -> bool:\n            \"\"\"Checks if n is within the allowed range [0, 10000].\"\"\"\n            return 0 <= n <= 10000\n\n        def is_positive_integer(self, n: int) -> bool:\n            \"\"\"Checks if n is a non-negative integer.\"\"\"\n            return n >= 0\n\n    class DigitProcessor:\n        \"\"\"Extracts individual digits and calculates their sum.\"\"\"\n        def extract_digits(self, n: int) -> list[int]:\n            \"\"\"Converts an integer to a list of its digits.\"\"\"\n            return [int(d) for d in str(n)]\n\n        def sum_digits(self, digits: list[int]) -> int:\n            \"\"\"Calculates the sum of a list of integers.\"\"\"\n            return sum(digits)\n\n    class BinaryConverter:\n        \"\"\"Converts integer values to binary string representation.\"\"\"\n        def to_binary_string(self, n: int) -> str:\n            \"\"\"Converts an integer to its binary string representation.\"\"\"\n            return bin(n)[2:]\n\n    class DigitSumCalculator:\n        \"\"\"Orchestrates the digit sum to binary conversion workflow.\"\"\"\n        def __init__(self):\n            self.validator = InputValidator()\n            self.processor = DigitProcessor()\n            self.converter = BinaryConverter()\n\n        def solve(self, n: int) -> str:\n            \"\"\"Coordinates validation, digit sum calculation, and binary conversion.\"\"\"\n            # Validation checks are performed as per design. Input is trusted per instruction.\n            self.validator.validate_range(n)\n            self.validator.is_positive_integer(n)\n\n            digits = self.processor.extract_digits(n)\n            digit_sum = self.processor.sum_digits(digits)\n            binary_string = self.converter.to_binary_string(digit_sum)\n            return binary_string\n\n    # Instantiate the main orchestrator and execute the conversion.\n    calculator = DigitSumCalculator()\n    return calculator.solve(N)\n```"}
{"task_id": "HumanEval/85", "solution": "from typing import List\n\ndef validate_non_empty(lst: List[int]) -> None:\n    \"\"\"Validates that the input list is not empty.\n    Raises ValueError if the list is empty.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\ndef get_odd_indices(lst: List[int]) -> List[int]:\n    \"\"\"Extracts elements from the list that are located at odd indices.\n    Uses zero-based indexing to identify odd positions.\n    \"\"\"\n    return [lst[i] for i in range(len(lst)) if i % 2 != 0]\n\ndef filter_even_numbers(numbers: List[int]) -> List[int]:\n    \"\"\"Filters a list of numbers, keeping only the even numbers.\n    Returns a new list containing only even elements.\n    \"\"\"\n    return [num for num in numbers if num % 2 == 0]\n\ndef calculate_sum(numbers: List[int]) -> int:\n    \"\"\"Calculates the sum of all numbers in the provided list.\n    Returns the total sum as an integer.\n    \"\"\"\n    return sum(numbers)\n\n\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n    This function orchestrates helper functions to process the list as per the design.\n    \"\"\"\n    validate_non_empty(lst)\n    odd_indexed_elements = get_odd_indices(lst)\n    even_filtered_elements = filter_even_numbers(odd_indexed_elements)\n    total_sum = calculate_sum(even_filtered_elements)\n    return total_sum"}
{"task_id": "HumanEval/85", "solution": "```python\nfrom typing import List\n\ndef validate_input(lst: List[int]) -> bool:\n    \"\"\"Validates input list is non-empty.\n    Raises ValueError if the list is empty.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n    return True\n\ndef get_odd_indices(lst: List[int]) -> List[int]:\n    \"\"\"Identifies and returns values from the input list located at odd indices (1, 3, 5, ...).\"\"\"\n    return [lst[i] for i in range(len(lst)) if i % 2 != 0]\n\ndef filter_even_numbers(elements: List[int]) -> List[int]:\n    \"\"\"Filters a list of integers to include only even numbers.\"\"\"\n    return [num for num in elements if num % 2 == 0]\n\ndef calculate_sum(elements: List[int]) -> int:\n    \"\"\"Calculates the arithmetic sum of a list of integers.\"\"\"\n    return sum(elements)\n\ndef add(lst: List[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\"\"\"\n    validate_input(lst)\n    elements_at_odd_indices = get_odd_indices(lst)\n    even_numbers_at_odd_indices = filter_even_numbers(elements_at_odd_indices)\n    final_sum = calculate_sum(even_numbers_at_odd_indices)\n    return final_sum\n```"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Orchestrates the string processing pipeline to sort characters within words.\n    Accepts an input string and returns a processed string.\n    \"\"\"\n\n    def _split_words(s_internal):\n        \"\"\"\n        Splits the input string into a list of words and individual space characters,\n        preserving their original sequence.\n        \"\"\"\n        parts = []\n        current_word_chars = []\n        for char in s_internal:\n            if char == ' ':\n                if current_word_chars:\n                    parts.append(\"\".join(current_word_chars))\n                    current_word_chars = []\n                parts.append(' ')\n            else:\n                current_word_chars.append(char)\n        if current_word_chars:\n            parts.append(\"\".join(current_word_chars))\n        return parts\n\n    def _sort_word_chars(word_internal):\n        \"\"\"\n        Sorts the characters within a single word in ascending ASCII order.\n        Returns the word with its characters sorted.\n        \"\"\"\n        return \"\".join(sorted(word_internal))\n\n    def _reconstruct_string(word_list_internal):\n        \"\"\"\n        Reconstructs the final string from a list of processed words and spaces.\n        Joins all elements of the list into a single string.\n        \"\"\"\n        return \"\".join(word_list_internal)\n\n    word_and_space_list = _split_words(s)\n    processed_parts = []\n    for part in word_and_space_list:\n        if part == ' ':\n            processed_parts.append(part)\n        else:\n            processed_parts.append(_sort_word_chars(part))\n\n    return _reconstruct_string(processed_parts)"}
{"task_id": "HumanEval/86", "solution": "def _split_into_words_and_spaces(s: str) -> tuple[list[str], list[str], bool]:\n    \"\"\"\n    Splits a string into lists of words and space segments, also indicating if the string starts with a space.\n    This function handles all leading, trailing, and interstitial spaces.\n    \"\"\"\n    words = []\n    spaces = []\n    if not s:\n        return words, spaces, False\n\n    is_starting_with_space = s[0].isspace()\n    current_segment_chars = []\n    \n    is_space_segment = is_starting_with_space\n\n    for char in s:\n        if char.isspace() == is_space_segment:\n            current_segment_chars.append(char)\n        else:\n            segment_str = \"\".join(current_segment_chars)\n            if is_space_segment:\n                spaces.append(segment_str)\n            else:\n                words.append(segment_str)\n            \n            current_segment_chars = [char]\n            is_space_segment = not is_space_segment\n    \n    segment_str = \"\".join(current_segment_chars)\n    if is_space_segment:\n        spaces.append(segment_str)\n    else:\n        words.append(segment_str)\n    \n    return words, spaces, is_starting_with_space\n\ndef _sort_word_characters(word: str) -> str:\n    \"\"\"\n    Sorts characters within a word by their ASCII values and returns the new sorted word string.\n    This operation maintains O(k log k) complexity where k is the word's length.\n    \"\"\"\n    return \"\".join(sorted(word))\n\ndef _reconstruct_string(words: list[str], spaces: list[str], is_starting_with_space: bool) -> str:\n    \"\"\"\n    Reconstructs the final string by interleaving the processed words and original space segments.\n    It correctly preserves the original spacing pattern based on whether the string started with a space.\n    \"\"\"\n    result_parts = []\n    \n    word_idx = 0\n    space_idx = 0\n    \n    if is_starting_with_space:\n        while space_idx < len(spaces) or word_idx < len(words):\n            if space_idx < len(spaces):\n                result_parts.append(spaces[space_idx])\n                space_idx += 1\n            if word_idx < len(words):\n                result_parts.append(words[word_idx])\n                word_idx += 1\n    else:\n        while word_idx < len(words) or space_idx < len(spaces):\n            if word_idx < len(words):\n                result_parts.append(words[word_idx])\n                word_idx += 1\n            if space_idx < len(spaces):\n                result_parts.append(spaces[space_idx])\n                space_idx += 1\n    \n    return \"\".join(result_parts)\n\ndef anti_shuffle(s):\n    \"\"\"\n    Processes a string by sorting characters within each word while preserving word order and spacing.\n    Words are separated by spaces, and characters are sorted in ascending ASCII order.\n    \"\"\"\n    words, spaces, is_starting_with_space = _split_into_words_and_spaces(s)\n    \n    sorted_words = [_sort_word_characters(word) for word in words]\n    \n    return _reconstruct_string(sorted_words, spaces, is_starting_with_space)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in 2D nested lists and returns coordinates (row, col).\n    Coordinates are sorted by row ascending, then column descending.\n    \"\"\"\n\n    def _find_coordinates(data_list, target_value):\n        \"\"\"\n        Core search logic to find all occurrences of the target value.\n        It iterates through the 2D list and collects (row, column) tuples.\n        \"\"\"\n        found_coords = []\n        for r_idx, row in enumerate(data_list):\n            for c_idx, val in enumerate(row):\n                if val == target_value:\n                    found_coords.append((r_idx, c_idx))\n        return found_coords\n\n    def _sort_coordinates(coords_list):\n        \"\"\"\n        Sorts coordinates by row (ascending) and then by column (descending).\n        This uses a custom key for sorting built-in tuples.\n        \"\"\"\n        return sorted(coords_list, key=lambda coord: (coord[0], -coord[1]))\n\n    coordinates = _find_coordinates(lst, x)\n    sorted_coordinates = _sort_coordinates(coordinates)\n\n    return sorted_coordinates"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds occurrences of integer x in a 2D nested list, returning their zero-based coordinates.\n    Results are sorted by row ascending, then by column descending within each row.\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort coordinates first by row in ascending order, then by column in descending order.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    Each lowercase letter is shifted by exactly 4 positions, wrapping from 'z' to 'a'.\n    \"\"\"\n    encrypted_chars = []\n    shift_amount = 4  # The alphabet should be rotated by two multiplied to two places (2 * 2 = 4).\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the 0-indexed position of the character ('a' is 0, 'b' is 1, ..., 'z' is 25)\n            original_pos = ord(char) - ord('a')\n            # Apply the shift and use modulo 26 to handle wrapping around the alphabet\n            new_pos = (original_pos + shift_amount) % 26\n            # Convert the new 0-indexed position back to a character\n            encrypted_chars.append(chr(new_pos + ord('a')))\n        else:\n            # Non-lowercase characters are appended to the result unchanged\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    Returns an ascending sorted copy if the sum is odd, descending if the sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return array[:]  # Return a copy for immutability\n\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 != 0:  # Sum is odd, sort ascending\n        return sorted(array)\n    else:  # Sum is even, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the sum of its first and last elements.\n    Returns a new sorted array, preserving the original. Sorts ascending for odd sums, descending for even sums.\n    \"\"\"\n\n    def _copy_array(arr_to_copy: list) -> list:\n        \"\"\"Creates an immutable copy of the input list.\"\"\"\n        return list(arr_to_copy)\n\n    def _calculate_sum(arr_for_sum: list) -> int:\n        \"\"\"Calculates the sum of the first and last elements.\"\"\"\n        return arr_for_sum[0] + arr_for_sum[-1]\n\n    def _sort_ascending(arr_to_sort: list) -> list:\n        \"\"\"Sorts the provided list in ascending order.\"\"\"\n        return sorted(arr_to_sort)\n\n    def _sort_descending(arr_to_sort: list) -> list:\n        \"\"\"Sorts the provided list in descending order.\"\"\"\n        return sorted(arr_to_sort, reverse=True)\n\n    if not array:\n        return _copy_array([])\n\n    if len(array) == 1:\n        return _copy_array(array)\n\n    first_last_sum = _calculate_sum(array)\n    array_to_be_sorted = _copy_array(array)\n\n    if first_last_sum % 2 != 0:\n        return _sort_ascending(array_to_be_sorted)\n    else:\n        return _sort_descending(array_to_be_sorted)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        # Calculate the 4-position shift with wraparound for lowercase letters.\n        shifted_char_code = (ord(char) - ord('a') + 4) % 26 + ord('a')\n        encrypted_chars.append(chr(shifted_char_code))\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "```python\ndef _extract_distinct_values(lst: list[int]) -> set[int]:\n    \"\"\"\n    Extracts unique integer values from the input list.\n    Converts the list to a set to efficiently get distinct elements.\n    \"\"\"\n    return set(lst)\n\ndef _find_second_smallest(distinct_values: set[int]) -> int | None:\n    \"\"\"\n    Sorts the distinct values and returns the second element.\n    This assumes the input set contains at least two values.\n    \"\"\"\n    sorted_values = sorted(list(distinct_values))\n    return sorted_values[1]\n\ndef next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Returns the second smallest distinct element from a list of integers.\n    Returns None if the list is empty or has fewer than two distinct elements.\n    \"\"\"\n    # Data Layer: Input validation for empty list.\n    if not lst:\n        return None\n\n    # Processing Layer: Extract distinct values.\n    distinct_values = _extract_distinct_values(lst)\n\n    # Data Layer: Intermediate validation for sufficient distinct values.\n    if len(distinct_values) < 2:\n        return None\n\n    # Processing Layer: Calculate the second smallest element.\n    second_smallest_val = _find_second_smallest(distinct_values)\n\n    # Data Layer: Result formatting and return.\n    return second_smallest_val\n```"}
{"task_id": "HumanEval/90", "solution": "def _validate_input(lst):\n    \"\"\"\n    Validates if the input list is not empty.\n    Returns True if valid, False if empty.\n    \"\"\"\n    return len(lst) > 0\n\ndef _get_unique_elements(lst):\n    \"\"\"\n    Extracts unique elements from the input list.\n    Converts to a set then back to a list for uniqueness.\n    \"\"\"\n    return list(set(lst))\n\ndef _find_second_smallest(unique_sorted):\n    \"\"\"\n    Finds the second smallest element from a sorted unique list.\n    Returns the element or None if there are fewer than two elements.\n    \"\"\"\n    if len(unique_sorted) >= 2:\n        return unique_sorted[1]\n    return None\n\ndef next_smallest(lst):\n    \"\"\"\n    Returns the second smallest unique element from a list of integers.\n    Returns None if the list is empty or has fewer than two unique elements.\n    \"\"\"\n    if not _validate_input(lst):\n        return None\n\n    unique_elements = _get_unique_elements(lst)\n    sorted_unique_elements = sorted(unique_elements)\n\n    return _find_second_smallest(sorted_unique_elements)"}
{"task_id": "HumanEval/91", "solution": "```python\nimport re\nfrom typing import List\n\ndef _split_sentences(text: str) -> List[str]:\n    \"\"\"Split text into sentences using '.', '?', '!' delimiters.\n    Empty strings resulting from splitting are filtered out.\n    \"\"\"\n    sentences = re.split(r'[.?!]', text)\n    return [s for s in sentences if s.strip()]\n\ndef _starts_with_i(sentence: str) -> bool:\n    \"\"\"Check if sentence starts with 'I' after trimming whitespace.\n    This check is case-sensitive.\n    \"\"\"\n    return sentence.lstrip().startswith('I')\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of \"boredoms\" in the input string S.\n    A boredom is defined as a sentence that starts with the word \"I\" (case-sensitive).\n    \"\"\"\n    boredom_count = 0\n    sentences = _split_sentences(S)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n            \n    return boredom_count\n```"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\" (case-sensitive).\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    bored_count = 0\n    delimiters = ['.', '?', '!']\n\n    # Check if any delimiters exist in the string; if not, return 0 as per design.\n    has_delimiters = False\n    for delim in delimiters:\n        if delim in S:\n            has_delimiters = True\n            break\n    \n    if not has_delimiters:\n        return 0\n\n    # Replace all delimiters with a common separator to facilitate splitting.\n    temp_S = S\n    for delim in delimiters:\n        temp_S = temp_S.replace(delim, '|')\n\n    # Split the string into potential sentence segments.\n    potential_sentences = temp_S.split('|')\n\n    for sentence_raw in potential_sentences:\n        sentence = sentence_raw.strip() # Remove leading/trailing whitespace.\n\n        if sentence: # Process only non-empty strings.\n            first_word = sentence.split(' ', 1)[0] # Get the first word.\n            if first_word == 'I': # Check if the first word is 'I' (case-sensitive).\n                bored_count += 1\n\n    return bored_count"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # Validate that all three inputs are integers; return False immediately if any are not.\n    if not isinstance(x, int) or not isinstance(y, int) or not isinstance(z, int):\n        return False\n\n    # Check if any one number equals the sum of the other two.\n    return (x == y + z) or (y == x + z) or (z == x + y)\n```"}
{"task_id": "HumanEval/93", "solution": "VOWEL_MAP = {\n    'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'\n}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Determine if character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWEL_MAP\n\ndef _get_vowel_replacement(vowel: str) -> str:\n    \"\"\"Get replacement character for a vowel.\"\"\"\n    return VOWEL_MAP.get(vowel.lower(), vowel.lower())\n\ndef _swap_case(char: str) -> str:\n    \"\"\"Swap the case of an alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced by the letter 2 places ahead in the alphabet, then case-swapped.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if char == ' ':\n            encoded_chars.append(char)\n        elif _is_vowel(char):\n            # Get lowercase replacement, then swap its case\n            replacement = _get_vowel_replacement(char)\n            encoded_chars.append(_swap_case(replacement))\n        else:\n            # Not a vowel, just swap case\n            encoded_chars.append(_swap_case(char))\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/92", "solution": "def _validate_integers(x, y, z):\n    # Checks if all three inputs are integers.\n    # Returns True if all are integers, False otherwise.\n    return isinstance(x, int) and isinstance(y, int) and isinstance(z, int)\n\ndef _check_sum_conditions(x, y, z):\n    # Checks if one number equals the sum of the other two.\n    # Returns True if any condition is met, False otherwise.\n    return (x == y + z) or (y == x + z) or (z == x + y)\n\ndef any_int(x, y, z):\n    '''\n    Validates if three numbers are integers and if one equals the sum of the other two.\n    Returns True if both conditions are met, False otherwise.\n    '''\n    if not _validate_integers(x, y, z):\n        return False\n    \n    return _check_sum_conditions(x, y, z)"}
{"task_id": "HumanEval/93", "solution": "VOWEL_MAPPING = {\n    'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n    'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n}\n\ndef _swap_case(char: str) -> str:\n    \"\"\"Swaps the case of an alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef get_vowel_replacement(char: str) -> str:\n    \"\"\"Returns the replacement character for a vowel, or the original character if not found.\"\"\"\n    return VOWEL_MAPPING.get(char, char)\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping the case of letters and replacing vowels\n    with letters two positions ahead in the alphabet.\n    Non-letter characters are preserved.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            swapped_char = _swap_case(char)\n            if is_vowel(swapped_char):\n                encoded_chars.append(get_vowel_replacement(swapped_char))\n            else:\n                encoded_chars.append(swapped_char)\n        else:\n            encoded_chars.append(char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "```python\nfrom typing import List\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is prime.\n    Handles numbers less than or equal to 1, 2, and other positive integers efficiently.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef find_primes(lst: List[int]) -> List[int]:\n    \"\"\"Identifies all prime numbers in the input list.\n    It iterates through the list and uses `is_prime` to check each number.\"\"\"\n    primes = []\n    for num in lst:\n        if is_prime(num):\n            primes.append(num)\n    return primes\n\ndef find_largest_prime(primes: List[int]) -> int:\n    \"\"\"Finds the largest prime number from a list of primes.\n    If the list is empty, it returns 0.\"\"\"\n    if not primes:\n        return 0\n    return max(primes)\n\ndef sum_digits(number: int) -> int:\n    \"\"\"Calculates the sum of all digits in a number.\n    It converts the number to a string to easily access each digit.\"\"\"\n    s = 0\n    for digit_char in str(number):\n        s += int(digit_char)\n    return s\n\ndef skjkasdkd(lst: List[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\"\"\"\n    \n    primes_found = find_primes(lst)\n    largest_p = find_largest_prime(primes_found)\n    digit_sum = sum_digits(largest_p)\n    \n    return digit_sum\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Validates dictionary key case consistency.\n    Returns True if all keys are consistently lowercase or uppercase strings, False otherwise.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n    \n    is_all_lower = True\n    is_all_upper = True\n\n    for key in keys:\n        if not isinstance(key, str):\n            return False  # Non-string key found\n\n        if key != key.lower():\n            is_all_lower = False\n        if key != key.upper():\n            is_all_upper = False\n\n    return is_all_lower or is_all_upper\n```"}
{"task_id": "HumanEval/94", "solution": "import math\nfrom typing import List\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Check if number is prime.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef find_primes(lst: List[int]) -> List[int]:\n    \"\"\"Find all prime numbers in list.\"\"\"\n    primes = [n for n in lst if is_prime(n)]\n    return primes\n\ndef find_largest_prime(primes: List[int]) -> int:\n    \"\"\"Find largest prime from list of primes.\"\"\"\n    if not primes:\n        return None  # Indicate no prime found\n    return max(primes)\n\ndef extract_digits(n: int) -> List[int]:\n    \"\"\"Extract individual digits from number.\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    while n > 0:\n        digits.append(n % 10)\n        n //= 10\n    return digits[::-1] # Reverse to get correct order\n\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculate sum of digits in number.\"\"\"\n    return sum(extract_digits(n))\n\ndef validate_input_list(lst: List[int]) -> bool:\n    \"\"\"Validate that input is a list of integers.\"\"\"\n    # As per critical requirements, we trust caller's input.\n    return True\n\ndef skjkasdkd(lst: List[int]) -> int:\n    \"\"\"\n    Find largest prime in list and return sum of its digits.\n\n    Args:\n        lst: List of integers\n\n    Returns:\n        Sum of digits of largest prime number\n\n    Raises:\n        ValueError: If no prime numbers found in list\n    \"\"\"\n    validate_input_list(lst) # Validate input (effectively a no-op per critical requirements)\n    \n    prime_numbers = find_primes(lst)\n    largest_prime = find_largest_prime(prime_numbers)\n    \n    if largest_prime is None:\n        raise ValueError(\"No prime numbers found in list\")\n        \n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/96", "solution": "def is_prime(number):\n    \"\"\"Checks if a given number is prime using trial division.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Only check odd divisors up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_up_to(n):\n    \"\"\"Finds all prime numbers less than n and returns them in a sorted list.\"\"\"\n    primes = []\n    if n <= 1:\n        return primes\n\n    for candidate in range(2, n):\n        if is_prime(candidate):\n            primes.append(candidate)\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are consistently lowercase or uppercase strings.\n    Returns False for empty dictionaries, non-string keys, or mixed key types/cases.\n    \"\"\"\n    # Returns False for empty dictionaries.\n    if not dict:\n        return False\n\n    # Returns False for non-string keys or mixed key types.\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are consistently lowercase.\n    all_lowercase = True\n    for key in dict.keys():\n        if not key.islower():\n            all_lowercase = False\n            break\n    if all_lowercase:\n        return True\n\n    # If not all lowercase, check if all keys are consistently uppercase.\n    all_uppercase = True\n    for key in dict.keys():\n        if not key.isupper():\n            all_uppercase = False\n            break\n    if all_uppercase:\n        return True\n\n    # Returns False for mixed case keys.\n    return False"}
{"task_id": "HumanEval/96", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"Determines if a given number is prime.\"\"\"\n    if number < 2:\n        return False\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return False\n    return True\n\ndef validate_input(n) -> bool:\n    \"\"\"Validates that the input is a non-negative integer.\"\"\"\n    # Critical requirements forbid explicit type/value checks or exceptions.\n    # We trust the caller's input based on the constraints.\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Generates a list of prime numbers less than n.\"\"\"\n    # Input validation is called, but is a no-op due to critical constraints.\n    if not validate_input(n):\n        return []\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes"}
