{"task_id": "HumanEval/136", "solution": "def _find_largest_negative(lst):\n    \"\"\"Finds the largest negative integer in a list.\n    Returns None if no negative integers are found.\n    \"\"\"\n    negatives = [x for x in lst if x < 0]\n    return max(negatives) if negatives else None\n\ndef _find_smallest_positive(lst):\n    \"\"\"Finds the smallest positive integer in a list.\n    Returns None if no positive integers are found.\n    \"\"\"\n    positives = [x for x in lst if x > 0]\n    return min(positives) if positives else None\n\ndef largest_smallest_integers(lst):\n    \"\"\"Returns a tuple (a, b), where 'a' is the largest negative integer,\n    and 'b' is the smallest positive integer in a list.\n    \"\"\"\n    largest_neg = _find_largest_negative(lst)\n    smallest_pos = _find_smallest_positive(lst)\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/136", "solution": "def _find_largest_negative(lst):\n    \"\"\"Identify the largest negative integer in the list.\"\"\"\n    largest_neg = None\n    for x in lst:\n        if x < 0:\n            if largest_neg is None or x > largest_neg:\n                largest_neg = x\n    return largest_neg\n\ndef _find_smallest_positive(lst):\n    \"\"\"Identify the smallest positive integer in the list.\"\"\"\n    smallest_pos = None\n    for x in lst:\n        if x > 0:\n            if smallest_pos is None or x < smallest_pos:\n                smallest_pos = x\n    return smallest_pos\n\ndef largest_smallest_integers(lst):\n    \"\"\"\n    Returns a tuple (largest_negative, smallest_positive) from a list of integers.\n    If no negative or positive integers are found, returns None for that position.\n    \"\"\"\n    largest_neg = _find_largest_negative(lst)\n    smallest_pos = _find_smallest_positive(lst)\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "def _normalize_decimal_separator(value):\n    \"\"\"\n    Converts comma decimal separators in a string to dot format.\n    Assumes the input is a string that might contain a comma.\n    \"\"\"\n    return value.replace(',', '.')\n\ndef _to_numeric(value):\n    \"\"\"\n    Converts an input value (int, float, or string) to a float for comparison.\n    Strings with comma decimals are normalized before conversion.\n    \"\"\"\n    if isinstance(value, str):\n        normalized_value = _normalize_decimal_separator(value)\n        return float(normalized_value)\n    return float(value)\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numeric values (int, float, or string representations)\n    and returns the larger value in its original type, or None if equal.\n    \"\"\"\n    num_a = _to_numeric(a)\n    num_b = _to_numeric(b)\n\n    if num_a == num_b:\n        return None\n    elif num_a > num_b:\n        return a\n    else:\n        return b"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    The minimum sum for four positive even numbers is 8 (2+2+2+2).\n    \"\"\"\n    if n < 8:\n        return False\n    return (n - 8) % 2 == 0"}
{"task_id": "HumanEval/138", "solution": "```python\ndef is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n\n    Args:\n        n (int): The number to evaluate\n\n    Returns:\n        bool: True if n can be written as sum of exactly 4 positive even numbers, False otherwise\n\n    Examples:\n        is_equal_to_sum_even(4) == False\n        is_equal_to_sum_even(6) == False\n        is_equal_to_sum_even(8) == True\n    \"\"\"\n    # The minimum sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    # Any sum of four positive even numbers must also result in an even number.\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True\n```"}
{"task_id": "HumanEval/139", "solution": "import math\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as: n! * (n-1)! * (n-2)! * ... * 1!\n    This function computes the special factorial for a positive integer n.\n    \"\"\"\n\n    def _calculate_factorial(k):\n        \"\"\"Calculates the factorial of a single number k.\n        It uses the math.factorial function from the standard library.\n        \"\"\"\n        return math.factorial(k)\n\n    def _compute_special_factorial(num):\n        \"\"\"Computes the product of all factorials from num! down to 1!.\n        This is the core logic for the special factorial calculation.\n        \"\"\"\n        product = 1\n        for i in range(1, num + 1):\n            product *= _calculate_factorial(i)\n        return product\n\n    return _compute_special_factorial(n)"}
{"task_id": "HumanEval/139", "solution": "def calculate_factorial(n):\n    \"\"\"Calculates the factorial of a non-negative integer n.\n    For example, calculate_factorial(4) returns 24.\n    \"\"\"\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\n\ndef multiply_factorials(n):\n    \"\"\"Computes the product of factorials from 1! to n!.\n    This function leverages calculate_factorial for individual factorials.\n    \"\"\"\n    overall_product = 1\n    for i in range(1, n + 1):\n        overall_product *= calculate_factorial(i)\n    return overall_product\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    # Adhering to critical requirements, input validation (e.g., for n > 0)\n    # is skipped, trusting the caller's input. The calculation proceeds directly.\n    return multiply_factorials(n)"}
{"task_id": "HumanEval/137", "solution": "from typing import Union\n\ndef _is_equal(a: float, b: float, epsilon: float = 1e-9) -> bool:\n    \"\"\"Check equality with floating point precision tolerance.\"\"\"\n    return abs(a - b) < epsilon\n\ndef _normalize_value(value: Union[int, float, str]) -> float:\n    \"\"\"Convert value to float for comparison, handling comma decimal separator.\"\"\"\n    return float(str(value).replace(',', '.'))\n\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two real numbers and returns the larger, preserving its original type.\n    Returns None if the values are equal, supporting international decimal separators.\n    \"\"\"\n    normalized_a = _normalize_value(a)\n    normalized_b = _normalize_value(b)\n\n    if _is_equal(normalized_a, normalized_b):\n        return None\n    elif normalized_a > normalized_b:\n        return a\n    else:\n        return b"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores.\n    If a string has more than 2 consecutive spaces, replace that sequence with a single dash.\n    \"\"\"\n    processed_text = []\n    space_count = 0\n\n    for char in text:\n        if char == ' ':\n            space_count += 1\n        else:\n            if space_count > 0: # Process accumulated spaces\n                if space_count == 1:\n                    processed_text.append('_')\n                elif space_count == 2:\n                    processed_text.append('__')\n                else: # space_count >= 3\n                    processed_text.append('-')\n                space_count = 0 # Reset counter\n            processed_text.append(char)\n\n    # Handle any remaining spaces at the end of the string\n    if space_count > 0:\n        if space_count == 1:\n            processed_text.append('_')\n        elif space_count == 2:\n            processed_text.append('__')\n        else: # space_count >= 3\n            processed_text.append('-')\n\n    return \"\".join(processed_text)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' for valid names, 'No' otherwise.\"\"\"\n\n    # Validate exactly one dot character presence.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension.\n    prefix, extension = file_name.split('.')\n\n    # Verify non-empty prefix starting with a latin alphabet letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Ensure no more than three digits in the file name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Confirm extension is one of the allowed types.\n    if extension not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/140", "solution": "def _validate_input(text: str) -> bool:\n    \"\"\"Validates that input is a string.\n    This function is a no-op due to critical requirements.\n    \"\"\"\n    return True\n\ndef count_consecutive_spaces(text: str, position: int) -> int:\n    \"\"\"Counts consecutive spaces starting at position.\n    It iterates forward from the given position to find all contiguous spaces.\n    \"\"\"\n    count = 0\n    while position + count < len(text) and text[position + count] == ' ':\n        count += 1\n    return count\n\ndef apply_transformations(text: str) -> str:\n    \"\"\"Applies all space transformations according to the rules.\n    It processes the text in a single pass to handle different space patterns.\n    \"\"\"\n    result_chars = []\n    i = 0\n    while i < len(text):\n        if text[i] == ' ':\n            space_count = count_consecutive_spaces(text, i)\n            if space_count > 2:\n                result_chars.append('-')\n            else:  # space_count is 1 or 2, apply underscore for each space\n                result_chars.extend(['_'] * space_count)\n            i += space_count  # Skip all processed spaces\n        else:\n            result_chars.append(text[i])\n            i += 1\n    return \"\".join(result_chars)\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"Main function for processing text spaces according to SRS rules.\n    It orchestrates input validation and the core space transformation logic.\n    \"\"\"\n    _validate_input(text)\n    return apply_transformations(text)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' for valid file names, 'No' otherwise.\"\"\"\n\n    def _count_digits(text):\n        \"\"\"Counts the number of digits (0-9) in a string.\"\"\"\n        digit_count = 0\n        for char in text:\n            if '0' <= char <= '9':\n                digit_count += 1\n        return digit_count\n\n    def _validate_dot_presence(name):\n        \"\"\"Verifies if the file name contains exactly one dot.\"\"\"\n        return name.count('.') == 1\n\n    def _validate_prefix(prefix_str):\n        \"\"\"Validates the prefix: non-empty and starts with an alphabet letter.\"\"\"\n        if not prefix_str:\n            return False\n        first_char = prefix_str[0]\n        return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n    def _validate_extension(ext_str):\n        \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n        allowed_extensions = ['txt', 'exe', 'dll']\n        return ext_str in allowed_extensions\n\n    # Rule 1: No more than three digits\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    # Rule 2: Exactly one dot\n    if not _validate_dot_presence(file_name):\n        return 'No'\n\n    # Split into prefix and extension after dot validation\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule 3: Prefix is not empty and starts with a latin alphabet letter\n    if not _validate_prefix(prefix):\n        return 'No'\n\n    # Rule 4: Extension is one of 'txt', 'exe', 'dll'\n    if not _validate_extension(extension):\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Processes a list of integers, applying conditional transformations based on index.\n    Squares values at indices that are multiples of 3, cubes values at indices that are multiples of 4 (but not 3),\n    leaves other values unchanged, and returns the sum of all processed values.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value ** 2\n        elif index % 4 == 0:  # This implicitly means 'and not a multiple of 3' due to the `elif`\n            total_sum += value ** 3\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def is_multiple_of_3(index: int) -> bool:\n    \"\"\"Checks if an index is a multiple of 3.\"\"\"\n    return index % 3 == 0\n\ndef is_multiple_of_4(index: int) -> bool:\n    \"\"\"Checks if an index is a multiple of 4.\"\"\"\n    return index % 4 == 0\n\ndef square_value(value: int) -> int:\n    \"\"\"Calculates the square of an integer value.\"\"\"\n    return value * value\n\ndef cube_value(value: int) -> int:\n    \"\"\"Calculates the cube of an integer value.\"\"\"\n    return value * value * value\n\ndef identity_value(value: int) -> int:\n    \"\"\"Returns the original integer value unchanged.\"\"\"\n    return value\n\ndef process_entry(value: int, index: int) -> int:\n    \"\"\"Applies the correct mathematical operation based on the index rules.\n    It uses index analysis functions to determine whether to square, cube, or leave the value unchanged.\"\"\"\n    if is_multiple_of_3(index):\n        return square_value(value)\n    elif is_multiple_of_4(index):\n        return cube_value(value)\n    else:\n        return identity_value(value)\n\ndef accumulate_sum(processed_values: list[int]) -> int:\n    \"\"\"Calculates the total sum of a list of processed integer values.\"\"\"\n    return sum(processed_values)\n\ndef sum_squares(lst):\n    \"\"\"\"\n    This function processes a list of integers based on index rules and returns their sum.\n    It squares entries at multiples of 3, cubes entries at multiples of 4 (not 3), and leaves others unchanged.\n    \"\"\"\n    if not lst:\n        return 0\n\n    processed_values = []\n    for index, value in enumerate(lst):\n        processed_value = process_entry(value, index)\n        processed_values.append(processed_value)\n\n    return accumulate_sum(processed_values)"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a given number is a prime number.\n    Returns True if prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef split_words(sentence: str) -> list[str]:\n    \"\"\"Splits an input sentence string into a list of words.\n    Words are separated by single spaces.\"\"\"\n    return sentence.split(' ')\n\ndef filter_prime_words(words: list[str]) -> list[str]:\n    \"\"\"Filters a list of words, keeping only those with prime lengths.\n    The original order of words is maintained.\"\"\"\n    filtered = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered.append(word)\n    return filtered\n\ndef format_output(words: list[str]) -> str:\n    \"\"\"Joins a list of words into a single space-separated string.\n    Returns an empty string if the input list is empty.\"\"\"\n    return ' '.join(words)\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence based on whether their character length is a prime number.\n    Returns a string of space-separated filtered words.\n    \"\"\"\n    words = split_words(sentence)\n    prime_length_words = filter_prime_words(words)\n    result = format_output(prime_length_words)\n    return result"}
{"task_id": "HumanEval/143", "solution": "def is_prime(number):\n    \"\"\"Determines if a number is prime.\n    Handles edge cases for numbers less than 2 and checks divisibility.\n    \"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef split_words(sentence):\n    \"\"\"Splits a sentence into a list of words using space as delimiter.\n    Filters out any empty strings resulting from multiple spaces.\n    \"\"\"\n    return [word for word in sentence.split(' ') if word]\n\ndef format_output(words):\n    \"\"\"Formats a list of words into a single space-separated string.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    return \" \".join(words)\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    \n    words = split_words(sentence)\n    \n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n            \n    return format_output(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Entry point to determine if the multiplication of two string-represented fractions results in a whole number.\n    It orchestrates parsing, multiplication, and validation.\"\"\"\n\n    def parse_fraction(fraction_str: str) -> tuple[int, int]:\n        \"\"\"Parses a string fraction into its numerator and denominator integers.\"\"\"\n        numerator_str, denominator_str = fraction_str.split('/')\n        return int(numerator_str), int(denominator_str)\n\n    def multiply_fractions(frac1: tuple[int, int], frac2: tuple[int, int]) -> tuple[int, int]:\n        \"\"\"Multiplies two fractions represented as (numerator, denominator) tuples.\"\"\"\n        num1, den1 = frac1\n        num2, den2 = frac2\n        return num1 * num2, den1 * den2\n\n    def is_whole_number(fraction: tuple[int, int]) -> bool:\n        \"\"\"Determines if a fraction represents a whole number by checking divisibility.\"\"\"\n        numerator, denominator = fraction\n        return numerator % denominator == 0\n\n    frac_x = parse_fraction(x)\n    frac_n = parse_fraction(n)\n    product_fraction = multiply_fractions(frac_x, frac_n)\n    return is_whole_number(product_fraction)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Determines if the multiplication of two fractions results in a whole number.\n    Accepts two fraction strings and returns True for a whole number product, False otherwise.\n    \"\"\"\n\n    def parse_fraction(fraction_str: str) -> tuple[int, int]:\n        \"\"\"Parses a fraction string into its numerator and denominator integers.\"\"\"\n        parts = fraction_str.split('/')\n        return int(parts[0]), int(parts[1])\n\n    def multiply_fractions(num1: int, den1: int, num2: int, den2: int) -> tuple[int, int]:\n        \"\"\"Multiplies two fractions and returns the result as a numerator/denominator pair.\"\"\"\n        result_numerator = num1 * num2\n        result_denominator = den1 * den2\n        return result_numerator, result_denominator\n\n    def is_whole_number(numerator: int, denominator: int) -> bool:\n        \"\"\"Determines if a fraction represents a whole number.\"\"\"\n        return numerator % denominator == 0\n\n    num_x, den_x = parse_fraction(x)\n    num_n, den_n = parse_fraction(n)\n\n    result_num, result_den = multiply_fractions(num_x, den_x, num_n, den_n)\n\n    return is_whole_number(result_num, result_den)"}
{"task_id": "HumanEval/145", "solution": "def calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of digits for an integer, handling negative numbers by ignoring the sign.\n    Converts the absolute number to a string and sums its individual digits.\"\"\"\n    abs_num = abs(num)\n    return sum(int(digit) for digit in str(abs_num))\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers based on the sum of their digits in ascending order.\n    Maintains original order for numbers with identical digit sums (stable sorting).\"\"\"\n    \n    # Use enumerate to get the original index alongside each number.\n    # This index serves as a tie-breaker for stable sorting when digit sums are equal.\n    # The key for sorting is a tuple: (digit_sum, original_index).\n    sorted_nums_with_indices = sorted(enumerate(nums), key=lambda item: (calculate_digit_sum(item[1]), item[0]))\n    \n    # Extract the original numbers from the sorted (original_index, num) pairs.\n    return [num for index, num in sorted_nums_with_indices]"}
{"task_id": "HumanEval/145", "solution": "```python\nfrom typing import List\n\ndef digit_sum(num: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for an integer.\n    If the number is negative, the negative sign is applied to the total sum of its absolute digits.\n    \"\"\"\n    if num == 0:\n        return 0\n\n    is_negative = num < 0\n    abs_num = abs(num)\n    current_sum = 0\n\n    while abs_num > 0:\n        current_sum += abs_num % 10\n        abs_num //= 10\n    \n    return -current_sum if is_negative else current_sum\n\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sort integers by digit sum in ascending order.\n    Maintain original order for equal digit sums.\n    \"\"\"\n    # Enumerate the input list to associate each number with its original index,\n    # which is crucial for stable sorting when digit sums are equal.\n    indexed_nums = list(enumerate(nums))\n\n    # Sort the list of (original_index, number) tuples.\n    # The key function calculates the digit sum of the number and uses the original index\n    # as a secondary sort criterion to ensure stability.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (digit_sum(item[1]), item[0]))\n\n    # Extract only the numbers from the sorted tuples to form the final result list.\n    return [item[1] for item in sorted_indexed_nums]\n```"}
{"task_id": "HumanEval/146", "solution": "def is_odd_digit(digit: int) -> bool:\n    \"\"\"Checks if a single digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit in {1, 3, 5, 7, 9}\n\ndef extract_first_digit(number: int) -> int:\n    \"\"\"Extracts the first digit from the absolute value of a number.\"\"\"\n    return int(str(abs(number))[0])\n\ndef extract_last_digit(number: int) -> int:\n    \"\"\"Extracts the last digit from the absolute value of a number.\"\"\"\n    return abs(number) % 10\n\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Counts numbers in an array greater than 10 with odd first and last digits.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = extract_first_digit(num)\n            last_digit = extract_last_digit(num)\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a formula-generated array where i < j < k and their sum is divisible by 3.\n    The array elements are generated by a[i] = i * i - i + 1 for 1-based index i.\n    \"\"\"\n\n    def _calculate_element_value(idx):\n        \"\"\"Calculates an array element using the formula i*i - i + 1.\"\"\"\n        return idx * idx - idx + 1\n\n    def _generate_array_elements(length):\n        \"\"\"Generates an array of length `length` with elements calculated using the formula.\"\"\"\n        arr = []\n        for i_val in range(1, length + 1):\n            arr.append(_calculate_element_value(i_val))\n        return arr\n\n    def _is_sum_divisible_by_three(val1, val2, val3):\n        \"\"\"Checks if the sum of three values is divisible by 3.\"\"\"\n        current_sum = val1 + val2 + val3\n        return current_sum % 3 == 0\n\n    if n < 3:\n        return 0\n\n    a = _generate_array_elements(n)\n    count = 0\n\n    for idx_i in range(n - 2):\n        for idx_j in range(idx_i + 1, n - 1):\n            for idx_k in range(idx_j + 1, n):\n                val_i = a[idx_i]\n                val_j = a[idx_j]\n                val_k = a[idx_k]\n\n                if _is_sum_divisible_by_three(val_i, val_j, val_k):\n                    count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculate maximum number of valid triples from generated array.\n    The sum of triple elements must be divisible by 3.\n    \"\"\"\n    \n    # Generate the integer array a of length n\n    # For each i (1 <= i <= n), a[i-1] = i * i - i + 1\n    a = [(i * i - i + 1) for i in range(1, n + 1)]\n\n    count = 0\n    # Iterate through all possible triples (a[i], a[j], a[k]) such that i < j < k\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                # Check if the sum of triple elements is divisible by 3\n                if (a[i] + a[j] + a[k]) % 3 == 0:\n                    count += 1\n    \n    return count"}
{"task_id": "HumanEval/146", "solution": "def _get_absolute_value(number: float) -> float:\n    \"\"\"Converts a number to its absolute value.\"\"\"\n    return abs(number)\n\ndef _is_greater_than_10(number: float) -> bool:\n    \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n    return number > 10\n\ndef _extract_first_digit(number: float) -> int:\n    \"\"\"Extracts the leftmost digit from a number's absolute value.\"\"\"\n    # Converts the number to a string and takes the first character.\n    return int(str(number)[0])\n\ndef _extract_last_digit(number: float) -> int:\n    \"\"\"Extracts the rightmost digit from the integer part of a number's absolute value.\"\"\"\n    # Converts to an integer to discard fractional part, then uses modulo for the last digit.\n    return int(number) % 10\n\ndef _is_odd_digit(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit in {1, 3, 5, 7, 9}\n\ndef specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where both first and last digits are odd.\"\"\"\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num):\n            abs_num = _get_absolute_value(num)\n            \n            first_digit = _extract_first_digit(abs_num)\n            last_digit = _extract_last_digit(abs_num)\n            \n            if _is_odd_digit(first_digit) and _is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\ndef validate_planet_names(planet1: str, planet2: str) -> bool:\n    \"\"\"Validate that both input planet names are valid and exist in the solar system.\"\"\"\n    return planet1 in PLANETS and planet2 in PLANETS\n\ndef get_planet_position(planet_name: str) -> int:\n    \"\"\"Get the 0-based index of a planet in the solar system. Returns -1 if not found.\"\"\"\n    try:\n        return PLANETS.index(planet_name)\n    except ValueError:\n        return -1\n\ndef sort_by_proximity(planets: list) -> tuple:\n    \"\"\"Sorts planets by their proximity to the Sun. Returns a tuple.\"\"\"\n    # Planets extracted from the constant list are already in proximity order.\n    return tuple(planets)\n\ndef get_planets_between(pos1: int, pos2: int) -> tuple:\n    \"\"\"Extract planets between two position indices, handling order and returning a sorted tuple.\"\"\"\n    if pos1 > pos2:\n        pos1, pos2 = pos2, pos1\n\n    intermediate_planets_list = list(PLANETS[pos1 + 1 : pos2])\n    return sort_by_proximity(intermediate_planets_list)\n\ndef bf(planet1, planet2):\n    \"\"\"Determines which planets have orbits located between two specified planets, sorted by proximity to the Sun.\"\"\"\n    if not validate_planet_names(planet1, planet2):\n        return ()\n\n    pos1 = get_planet_position(planet1)\n    pos2 = get_planet_position(planet2)\n\n    return get_planets_between(pos1, pos2)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters strings with odd lengths and sorts remaining strings.\n    Returns strings with even lengths, sorted by length then alphabetically.\n    \"\"\"\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(filtered_list, key=lambda s: (len(s), s))\n    return sorted_result"}
{"task_id": "HumanEval/148", "solution": "\n```python\n# Constants for planet names and their 1-based orbital positions.\nclass PlanetConstants:\n    PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n    PLANET_POSITIONS = {name: i + 1 for i, name in enumerate(PLANETS)}\n\n# Validates planet names and retrieves their orbital positions.\nclass PlanetValidator:\n    @staticmethod\n    def is_valid_planet(name: str) -> bool:\n        \"\"\"Checks if a given planet name is valid.\"\"\"\n        return name in PlanetConstants.PLANET_POSITIONS\n\n    @staticmethod\n    def get_planet_position(name: str) -> int:\n        \"\"\"Retrieves the 1-based orbital position of a planet.\"\"\"\n        return PlanetConstants.PLANET_POSITIONS.get(name, 0)\n\n# Calculates the list of planets between two given positions.\nclass RangeCalculator:\n    @staticmethod\n    def get_planets_between(pos1: int, pos2: int) -> list:\n        \"\"\"Determines planets between two 1-based orbital positions.\"\"\"\n        idx1 = pos1 - 1\n        idx2 = pos2 - 1\n\n        if idx1 < idx2:\n            return list(PlanetConstants.PLANETS[idx1 + 1 : idx2])\n        elif idx1 > idx2:\n            return list(PlanetConstants.PLANETS[idx2 + 1 : idx1])\n        return []\n\n    @staticmethod\n    def sort_by_proximity(planets: list) -> list:\n        \"\"\"Sorts a list of planets by their proximity to the Sun.\"\"\"\n        # The PLANETS tuple is already sorted, so direct slicing preserves order.\n        return planets\n\ndef bf(planet1: str, planet2: str) -> tuple:\n    \"\"\"\n    Returns a tuple of planets located between the specified planets' orbits,\n    sorted by proximity to the Sun, or an empty tuple for invalid inputs.\n    \"\"\"\n    if not PlanetValidator.is_valid_planet(planet1) or \\\n       not PlanetValidator.is_valid_planet(planet2):\n        return ()\n\n    pos1 = PlanetValidator.get_planet_position(planet1)\n    pos2 = PlanetValidator.get_planet_position(planet2)\n\n    planets_in_range = RangeCalculator.get_planets_between(pos1, pos2)\n    sorted_planets = RangeCalculator.sort_by_proximity(planets_in_range)\n    \n    return tuple(sorted_planets)\n\n```"}
{"task_id": "HumanEval/149", "solution": "def _filter_odd_length_strings(lst: list[str]) -> list[str]:\n    \"\"\"Removes strings with odd character lengths from the input list.\n    Returns a new list containing only strings with even lengths.\"\"\"\n    return [s for s in lst if len(s) % 2 == 0]\n\ndef _sort_by_length_and_alphabetically(lst: list[str]) -> list[str]:\n    \"\"\"Sorts strings by length in ascending order, then alphabetically for equal lengths.\n    Returns a new list with the sorted strings.\"\"\"\n    return sorted(lst, key=lambda s: (len(s), s))\n\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Accepts a list of strings, filters out odd-length strings, and returns the\n    result sorted by length then alphabetically.\"\"\"\n    filtered_list = _filter_odd_length_strings(lst)\n    sorted_list = _sort_by_length_and_alphabetically(filtered_list)\n    return sorted_list"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Determines if a given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef select_value(is_prime_result, x, y):\n    \"\"\"Returns x if is_prime_result is True, otherwise returns y.\n    This function handles the conditional value selection.\n    \"\"\"\n    if is_prime_result:\n        return x\n    else:\n        return y\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \"\"\"\n    prime_status = is_prime(n)\n    result = select_value(prime_status, x, y)\n    return result"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    def is_prime_inline(num):\n        # Checks if a number is prime using an efficient trial division algorithm.\n        # It handles small numbers and optimizes checks by skipping even divisors.\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime_inline(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd positive integers from the input list.\n    Non-integers and negative numbers are ignored during computation.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        # Check if the number is positive.\n        if num > 0:\n            # Check if the number has an integer value (e.g., 2.0 is integer, 2.5 is not).\n            # This fulfills the requirement to ignore non-integers without using isinstance().\n            if num % 1 == 0:\n                # Check if the number is odd.\n                if num % 2 != 0:\n                    total_sum += num * num\n    # Ensure the final result is an integer as specified by the return type.\n    return int(total_sum)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    if not lst:\n        return 0\n\n    total = 0\n    for num in lst:\n        # Filter for positive odd numbers.\n        # Non-integer numeric types will be ignored if their modulo 2 is not 1.\n        if num > 0 and num % 2 == 1:\n            total += num * num\n\n    return total"}
