{"task_id": "HumanEval/76", "solution": "import math\n\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple power of n, meaning n^k = x for some integer k.\n    Handles various edge cases and floating-point inputs using logarithmic calculations.\n    \"\"\"\n    tolerance = 1e-9  # Tolerance for floating point comparisons\n\n    # Edge case: x is 1. Any non-zero n raised to the power of 0 is 1.\n    # 0^0 is also commonly defined as 1.\n    if abs(x - 1) < tolerance:\n        return True\n\n    # Edge case: n is 1. 1 raised to any integer power is 1.\n    # Since x=1 is handled, if n=1 and x!=1, it's always false.\n    if abs(n - 1) < tolerance:\n        return False\n\n    # Edge case: n is 0.\n    # If x is 0, then 0^k = 0 for k > 0.\n    # If x is 1, then 0^0 = 1 (handled by x=1 case). Otherwise, it cannot be a power of 0.\n    if abs(n) < tolerance:\n        return abs(x) < tolerance # Only x=0 can be a power of 0 (e.g. 0^1=0).\n\n    # Edge case: x is 0.\n    # If n is 0, handled above. If n is not 0, then n^k can never be 0 for any integer k.\n    if abs(x) < tolerance:\n        return False\n\n    # If x < 0 and n > 0, it's impossible for n^k = x for integer k.\n    # An integer power of a positive base is always positive.\n    if x < -tolerance and n > tolerance:\n        return False\n\n    # Calculate k = log_n(x). This requires positive arguments for math.log().\n    # We use abs() for the log calculation and then handle sign consistency for negative bases.\n    k_candidate = math.log(abs(x)) / math.log(abs(n))\n\n    # Check if k_candidate is an integer within tolerance.\n    k_int = round(k_candidate)\n    if abs(k_candidate - k_int) < tolerance:\n        # We have an integer exponent candidate. Now verify n^k_int against x,\n        # paying attention to signs for negative bases.\n        if n < -tolerance: # n is negative\n            if x > tolerance and k_int % 2 != 0: # If x is positive, k_int must be even\n                return False\n            if x < -tolerance and k_int % 2 == 0: # If x is negative, k_int must be odd\n                return False\n        \n        # Calculate n^k_int and compare with x using tolerance.\n        calculated_x = n ** k_int\n        return abs(calculated_x - x) < tolerance\n    else:\n        # k_candidate is not an integer.\n        return False"}
{"task_id": "HumanEval/77", "solution": "import math\n\ndef calculate_cube_root(a: int) -> float:\n    \"\"\"\n    Calculate cube root of input integer with appropriate precision.\n    Handles positive, negative, and zero cases using math.pow.\n    \"\"\"\n    if a == 0:\n        return 0.0\n    return math.pow(a, 1/3)\n\ndef is_perfect_integer(value: float, original: int) -> bool:\n    \"\"\"\n    Validate if the calculated cube root represents a perfect integer for the original number.\n    Compares the cube of the rounded root with the original integer.\n    \"\"\"\n    candidate_root = round(value)\n    return candidate_root * candidate_root * candidate_root == original\n\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Determine if an integer is a perfect cube of some integer number.\n    Utilizes helper functions for cube root calculation and validation.\n    \"\"\"\n    cube_root_val = calculate_cube_root(a)\n    return is_perfect_integer(cube_root_val, a)"}
