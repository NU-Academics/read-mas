{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n\n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Initialize F(1) and F(2) for iteration.\n    a, b = 1, 1\n    # Iterate from the 3rd number up to the n-th number.\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/54", "solution": "def _extract_character_set(s: str) -> set[str]:\n    \"\"\"\n    Extract unique characters from a string.\n    It converts the input string into a set of its individual characters.\n    \"\"\"\n    return set(s)\n\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    It compares the unique character sets of the two input strings.\n    \"\"\"\n    set0 = _extract_character_set(s0)\n    set1 = _extract_character_set(s1)\n    return set0 == set1"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is monotonically increasing (non-decreasing).\n    is_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    # Check if the list is monotonically decreasing (non-increasing).\n    is_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_decreasing = False\n            break\n\n    return is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    Return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            if balance == 0:\n                return False  # Closing bracket without an opening one\n            balance -= 1\n    return balance == 0  # True if all opening brackets are closed"}
