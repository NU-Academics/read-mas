{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"\n    Compute the n-th element of the Fib4 sequence using an iterative approach.\n    This function handles base cases and computes larger values efficiently with O(1) space.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the four preceding values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n = 4 up to the requested n, updating the sliding window\n    for i in range(4, n + 1):\n        next_val = a + b + c + d\n        a, b, c, d = b, c, d, next_val\n\n    return d"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    This sequence is defined by fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3.\"\"\"\n    \n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n    \n    # Initialize the last four elements: fib4(0), fib4(1), fib4(2), fib4(3)\n    # These correspond to fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) when i = 4\n    prev_four = [0, 0, 2, 0] \n    \n    for i in range(4, n + 1):\n        current_fib4 = sum(prev_four)\n        # Shift the values: remove the oldest and add the new current value\n        prev_four.pop(0)\n        prev_four.append(current_fib4)\n        \n    return prev_four[3] # The last element in prev_four is fib4(n)"}
{"task_id": "HumanEval/47", "solution": "from typing import Union, List\n\ndef _sort_list(l: list) -> list:\n    \"\"\"Sort input list and return sorted copy.\"\"\"\n    return sorted(l)\n\ndef _calculate_average(num1: Union[int, float], num2: Union[int, float]) -> float:\n    \"\"\"Calculate and return average of two numbers.\"\"\"\n    return (num1 + num2) / 2.0\n\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    8.0\n    \"\"\"\n    sorted_list = _sort_list(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # Odd length list, return the middle element.\n        return sorted_list[n // 2]\n    else:\n        # Even length list, return the average of the two middle elements.\n        mid1_val = sorted_list[n // 2 - 1]\n        mid2_val = sorted_list[n // 2]\n        return _calculate_average(mid1_val, mid2_val)"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    n = len(l)\n    sorted_l = sorted(l)\n\n    if n % 2 == 1:\n        # For an odd length list, the median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For an even length list, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/48", "solution": "```python\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome.\n    Handles empty strings and compares characters from both ends.\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    if not text:\n        return True\n\n    left = 0\n    right = len(text) - 1\n\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n\n    return True\n```"}
