{"task_id": "HumanEval/67", "solution": "import re\n\ndef _extract_fruit_counts(s: str) -> tuple[int, int]:\n    \"\"\"\n    Parses the input string to extract the count of apples and oranges.\n    Assumes the string format is 'X apples and Y oranges' and values are valid.\n    \"\"\"\n    match = re.search(r'(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges', s)\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    return apples, oranges\n\ndef _calculate_mangoes(total: int, apples: int, oranges: int) -> int:\n    \"\"\"\n    Calculates the number of mangoes using the total fruits, apples, and oranges.\n    It applies the formula: mangoes = total_fruits - apples - oranges.\n    \"\"\"\n    return total - apples - oranges\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket given string input for apple\n    and orange counts, and an integer for total fruit count.\n    \"\"\"\n    apples, oranges = _extract_fruit_counts(s)\n    mangoes = _calculate_mangoes(n, apples, oranges)\n    return mangoes"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"Calculates the number of mango fruits given apple/orange counts and total fruits.\n    It parses the string for apple and orange counts and subtracts them from the total.\n    \"\"\"\n    # Extract apple and orange counts from the string input.\n    # The string format is assumed to be \"X apples and Y oranges\".\n    parts = s.split()\n    apples = int(parts[0])\n    oranges = int(parts[3])\n\n    # Calculate the number of mango fruits by subtracting apples and oranges from the total.\n    mangoes = n - apples - oranges\n\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its leftmost index in an array of non-negative integers.\n    Returns [value, index] or an empty list if no even values are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # If value == smallest_even_value, we keep the existing smallest_even_index for tie-breaking.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def is_empty_array(arr: list) -> bool:\n    \"\"\"Checks if the input array is empty.\"\"\"\n    return len(arr) == 0\n\ndef is_even(value: int) -> bool:\n    \"\"\"Determines if a given non-negative integer is even.\"\"\"\n    return value % 2 == 0\n\ndef find_smallest_even_with_index(arr: list) -> list:\n    \"\"\"\n    Finds the smallest even value and its index in the array.\n    Handles tie-breaking by selecting the smallest index.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, value in enumerate(arr):\n        if is_even(value):\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # The condition `value == smallest_even_value and i < smallest_even_index`\n            # is implicitly handled. If `value == smallest_even_value`, the first 'if'\n            # condition `value < smallest_even_value` is false, and thus the existing\n            # smallest_even_index (which must be smaller or equal) is preserved.\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []\n\ndef pluck(arr):\n    \"\"\"\n    Given an array of non-negative integers, returns the smallest even value and its index.\n    Returns an empty list if no even values are found or the array is empty.\n    \"\"\"\n    if is_empty_array(arr):\n        return []\n    \n    return find_smallest_even_with_index(arr)"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    If no such a value exist, return -1.\n    '''\n\n    def _calculate_frequencies(lst_inner):\n        '''\n        Calculates the frequency distribution of integers in the input list.\n        Returns a dictionary mapping each integer to its count.\n        '''\n        frequencies = {}\n        for num in lst_inner:\n            frequencies[num] = frequencies.get(num, 0) + 1\n        return frequencies\n\n    def _find_qualifying_integers(frequencies_inner):\n        '''\n        Identifies integers where their frequency is greater than or equal to their value.\n        Returns a list of all such qualifying integers.\n        '''\n        qualifying_candidates = []\n        for val, freq in frequencies_inner.items():\n            if freq >= val: # Integers are positive as per problem statement, so val > 0 is implicit.\n                qualifying_candidates.append(val)\n        return qualifying_candidates\n\n    def _get_maximum(candidates_inner):\n        '''\n        Finds the maximum value from a list of candidates.\n        Returns the maximum value or -1 if the list is empty.\n        '''\n        if not candidates_inner:\n            return -1\n        return max(candidates_inner)\n\n    # Orchestrates the search process through helper functions.\n    frequencies = _calculate_frequencies(lst)\n    qualifying_integers = _find_qualifying_integers(frequencies)\n    result = _get_maximum(qualifying_integers)\n    return result"}
{"task_id": "HumanEval/69", "solution": "def validate_input(lst: list) -> bool:\n    \"\"\"\n    Validates the input list.\n    Always returns True based on critical requirements to trust caller's input.\n    \"\"\"\n    return True\n\ndef calculate_frequencies(lst: list) -> dict:\n    \"\"\"\n    Calculates the frequency of each integer in the list.\n    Iterates through the list to manually count frequencies.\n    \"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\n\ndef find_qualifying_integers(frequencies: dict) -> list:\n    \"\"\"\n    Identifies integers where frequency is greater than or equal to their value.\n    Filters the dictionary items based on the condition.\n    \"\"\"\n    qualifying = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying.append(num)\n    return qualifying\n\ndef get_maximum_qualifying(qualifying: list) -> int:\n    \"\"\"\n    Returns the greatest qualifying integer.\n    Returns -1 if no qualifying integers are found.\n    \"\"\"\n    if not qualifying:\n        return -1\n    return max(qualifying)\n\ndef search(lst: list) -> int:\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    validate_input(lst) # Input validation, always returning True as per design constraints.\n\n    frequencies = calculate_frequencies(lst)\n\n    qualifying_integers = find_qualifying_integers(frequencies)\n\n    return get_maximum_qualifying(qualifying_integers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    result = []\n    # Create a mutable copy to modify during the sorting process.\n    remaining = list(lst)\n    min_turn = True\n\n    while remaining:\n        if min_turn:\n            # Find and append the minimum value, then remove it from remaining.\n            current_val = min(remaining)\n        else:\n            # Find and append the maximum value, then remove it from remaining.\n            current_val = max(remaining)\n        \n        result.append(current_val)\n        remaining.remove(current_val)\n        min_turn = not min_turn\n        \n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting starts with the minimum value, then maximum of the remaining, and so on.\n    '''\n    if not lst:\n        return []\n\n    result = []\n    remaining = list(lst) # Create a copy to avoid modifying original list\n    is_min_turn = True\n\n    while remaining:\n        if is_min_turn:\n            current_val = min(remaining)\n        else:\n            current_val = max(remaining)\n        \n        result.append(current_val)\n        remaining.remove(current_val) # Remove only one occurrence\n        is_min_turn = not is_min_turn\n            \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\nclass ValidationService:\n    \"\"\"Provides input validation and triangle inequality checking services.\"\"\"\n\n    def are_valid_inputs(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if all side lengths are positive numbers.\"\"\"\n        return a > 0 and b > 0 and c > 0\n\n    def _check_triangle_inequality(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if the sum of any two sides is greater than the third side.\"\"\"\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\n    def is_valid_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Determines if given sides can form a valid triangle.\"\"\"\n        if not self.are_valid_inputs(a, b, c):\n            return False\n        return self._check_triangle_inequality(a, b, c)\n\nclass AreaCalculator:\n    \"\"\"Provides mathematical calculation services for triangle area computation.\"\"\"\n\n    def _calculate_semi_perimeter(self, a: float, b: float, c: float) -> float:\n        \"\"\"Calculates the semi-perimeter of a triangle.\"\"\"\n        return (a + b + c) / 2\n\n    def calculate_using_herons(self, a: float, b: float, c: float) -> float:\n        \"\"\"Calculates the area of a triangle using Heron's formula.\"\"\"\n        s = self._calculate_semi_perimeter(a, b, c)\n        # Handle potential floating point inaccuracies for degenerate triangles.\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        return math.sqrt(max(0, area_squared))\n\n    def round_to_two_decimals(self, value: float) -> float:\n        \"\"\"Rounds a float value to two decimal places.\"\"\"\n        return round(value, 2)\n\nclass Triangle:\n    \"\"\"Represents a triangle with three sides and encapsulates triangle-specific business logic.\"\"\"\n\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes a Triangle with given side lengths.\"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n        self._validation_service = ValidationService()\n        self._area_calculator = AreaCalculator()\n\n    def get_sides(self) -> tuple[float, float, float]:\n        \"\"\"Returns the side lengths of the triangle.\"\"\"\n        return self._side_a, self._side_b, self._side_c\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the triangle's sides form a valid triangle.\"\"\"\n        return self._validation_service.is_valid_triangle(self._side_a, self._side_b, self._side_c)\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates the area of the triangle using Heron's formula.\"\"\"\n        return self._area_calculator.calculate_using_herons(self._side_a, self._side_b, self._side_c)\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1.\n    '''\n    triangle_obj = Triangle(a, b, c)\n    \n    if not triangle_obj.is_valid():\n        return -1\n    \n    calculated_area = triangle_obj.calculate_area()\n    area_calculator = AreaCalculator()\n    return area_calculator.round_to_two_decimals(calculated_area)"}
{"task_id": "HumanEval/71", "solution": "import math\n\nclass ValidationService:\n    \"\"\"\n    Validates triangle inequality rules and input constraints.\n    Ensures all sides are positive and meet geometric requirements.\n    \"\"\"\n    def is_valid_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if the given sides can form a valid triangle.\n        Requires all sides to be positive and satisfy triangle inequality.\n        \"\"\"\n        if a <= 0 or b <= 0 or c <= 0:\n            return False\n        return (self.check_triangle_inequality(a, b, c) and\n                self.check_triangle_inequality(b, c, a) and\n                self.check_triangle_inequality(c, a, b))\n\n    def check_triangle_inequality(self, side1: float, side2: float, side3: float) -> bool:\n        \"\"\"\n        Checks if the sum of two sides is greater than the third side.\n        This is a fundamental rule for triangle validity.\n        \"\"\"\n        return side1 + side2 > side3\n\nclass Triangle:\n    \"\"\"\n    Represents a triangle entity with three side lengths.\n    Stores the dimensions of the triangle.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes a Triangle instance with given side lengths.\"\"\"\n        self.side_a = a\n        self.side_b = b\n        self.side_c = c\n\n    def get_sides(self) -> tuple:\n        \"\"\"Returns a tuple containing the three side lengths of the triangle.\"\"\"\n        return (self.side_a, self.side_b, self.side_c)\n\nclass AreaCalculator:\n    \"\"\"\n    Handles area calculations using Heron's formula and result formatting.\n    Provides methods for computing and rounding the triangle's area.\n    \"\"\"\n    def compute_area(self, triangle: Triangle) -> float:\n        \"\"\"\n        Calculates the area of a given triangle using Heron's formula.\n        The result is then rounded to two decimal places.\n        \"\"\"\n        a, b, c = triangle.get_sides()\n        area = self._calculate_heron_formula(a, b, c)\n        return self.round_to_two_decimals(area)\n\n    def round_to_two_decimals(self, value: float) -> float:\n        \"\"\"Rounds a given floating-point value to two decimal places.\"\"\"\n        return round(value, 2)\n\n    def _calculate_heron_formula(self, a: float, b: float, c: float) -> float:\n        \"\"\"\n        Applies Heron's formula to calculate the area of a triangle.\n        It uses the semi-perimeter to compute the area.\n        \"\"\"\n        s = (a + b + c) / 2\n        # Use max(0, term) to handle potential tiny negative floats due to precision issues when s*(s-a)*(s-b)*(s-c)\n        # should be 0 or slightly positive but might be slightly negative.\n        term = s * (s - a) * (s - b) * (s - c)\n        return math.sqrt(max(0, term))\n\nclass TriangleAreaService:\n    \"\"\"\n    Coordinates business logic and orchestrates domain operations.\n    It acts as a facade for triangle validation and area calculation.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the service with necessary validation and calculation components.\"\"\"\n        self.validation_service = ValidationService()\n        self.area_calculator = AreaCalculator()\n\n    def process_triangle_calculation(self, a: float, b: float, c: float) -> float:\n        \"\"\"\n        Processes the request to calculate the area of a triangle.\n        Validates the triangle first, then calculates its area or returns -1.\n        \"\"\"\n        if not self.validation_service.is_valid_triangle(a, b, c):\n            return -1\n\n        triangle = Triangle(a, b, c)\n        area = self.area_calculator.compute_area(triangle)\n        return area\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    '''\n    service = TriangleAreaService()\n    return service.process_triangle_calculation(a, b, c)"}
{"task_id": "HumanEval/72", "solution": "def is_palindromic(lst):\n    \"\"\"\n    Checks if a list is palindromic using a two-pointer approach for O(n) complexity.\n    Returns True if the list is balanced (palindromic), False otherwise.\n    \"\"\"\n    left, right = 0, len(lst) - 1\n    while left < right:\n        if lst[left] != lst[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n\ndef calculate_sum(lst):\n    \"\"\"\n    Calculates the sum of all numeric elements in a list.\n    This uses the built-in sum() function for efficiency.\n    \"\"\"\n    return sum(lst)\n\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q can fly based on balance (palindromic list)\n    and weight constraints (sum of elements <= maximum weight w).\n    \"\"\"\n    balanced = is_palindromic(q)\n    total_weight = calculate_sum(q)\n    return balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of element changes to make an array palindromic.\n    It uses a two-pointer approach to compare elements from both ends.\n    \"\"\"\n    left = 0\n    right = len(arr) - 1\n    changes = 0\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    if len(arr) <= 1:\n        return 0\n\n    changes = 0\n    n = len(arr)\n\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n\n    return changes"}
{"task_id": "HumanEval/74", "solution": "from typing import List\n\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Compares two lists of strings based on their total character count.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/72", "solution": "```python\ndef is_palindrome(lst):\n    \"\"\"Checks if a list reads the same forwards and backwards.\n    Achieves O(n) time complexity by comparing elements from both ends.\"\"\"\n    left, right = 0, len(lst) - 1\n    while left < right:\n        if lst[left] != lst[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n\ndef calculate_sum(lst):\n    \"\"\"Calculates the sum of all numeric elements in a list.\n    This function uses the built-in sum() for efficiency.\"\"\"\n    return sum(lst)\n\ndef is_within_limit(total, limit):\n    \"\"\"Checks if the total weight is less than or equal to the maximum limit.\"\"\"\n    return total <= limit\n\ndef validate_flight_conditions(q, w):\n    \"\"\"Coordinates palindrome and weight validation to determine if an object can fly.\n    Returns True only if the list is balanced AND its sum is within the weight limit.\"\"\"\n    balanced = is_palindrome(q)\n    if not balanced:\n        return False\n    \n    total_weight = calculate_sum(q)\n    within_weight = is_within_limit(total_weight, w)\n    \n    return within_weight\n\ndef will_it_fly(q,w):\n    \"\"\"Determines if an object q will fly based on balance and weight constraints.\n    Returns True if q is a palindrome and its sum is less than or equal to w.\"\"\"\n    return validate_flight_conditions(q, w)\n```"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings based on their total character count.\n    Returns the list with fewer total characters, or the first list in case of a tie.\n    '''\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is prime.\n    Numbers less than 2 are not prime; checks for divisors up to its square root.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef validate_input(a: int) -> bool:\n    \"\"\"Validates input constraints: 'a' must be an integer between 1 and 99 inclusive.\"\"\"\n    return 1 < a < 100\n\ndef get_prime_factors(n: int) -> list:\n    \"\"\"Performs prime factorization and returns a list of prime factors, with repetitions.\n    It divides by factors and confirms their primality as specified by the design.\"\"\"\n    factors = []\n    current_n = n\n    factor = 2\n\n    while factor * factor <= current_n:\n        if current_n % factor == 0:\n            if is_prime(factor): # Confirms primality as per the architectural sequence diagram.\n                factors.append(factor)\n                current_n //= factor\n            # If 'factor' is not prime, it's not added, and 'current_n' isn't divided by it.\n            # The outer loop will then increment 'factor'.\n        else:\n            factor += 1\n\n    if current_n > 1:\n        factors.append(current_n) # The remaining number is itself a prime factor.\n\n    return factors\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Returns true if the given number is the multiplication of exactly 3 prime numbers,\n    and false otherwise. The input 'a' is known to be less than 100.\"\"\"\n    if not validate_input(a):\n        return False\n\n    prime_factors = get_prime_factors(a)\n\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/75", "solution": "# src/input_validator.py\nclass InputValidator:\n    \"\"\"Validates input constraints and ranges for the main function.\"\"\"\n    @staticmethod\n    def validate_input(a: int) -> bool:\n        \"\"\"Checks if the input 'a' is less than 100.\"\"\"\n        return a < 100\n\n# src/math_utils.py\nclass MathUtils:\n    \"\"\"Provides mathematical utility functions for prime factorization.\"\"\"\n    @staticmethod\n    def get_prime_factors(n: int) -> list[int]:\n        \"\"\"Returns a list of prime factors for n, including repetitions, with O(\u221an) complexity.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        if temp_n <= 1: # Numbers less than or equal to 1 have no prime factors.\n            return factors\n        \n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1: # If temp_n is still greater than 1, it is a prime factor itself.\n            factors.append(temp_n)\n        return factors\n\n# src/prime_checker.py\nclass PrimeChecker:\n    \"\"\"Determines if numbers are prime and counts prime factors.\"\"\"\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number 'n' is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    @staticmethod\n    def count_prime_factors(n: int) -> int:\n        \"\"\"Counts the total number of prime factors for 'n', including repetitions.\"\"\"\n        return len(MathUtils.get_prime_factors(n))\n\n# src/is_multiply_prime.py\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if not InputValidator.validate_input(a):\n        return False\n    \n    count = PrimeChecker.count_prime_factors(a)\n    return count == 3"}
