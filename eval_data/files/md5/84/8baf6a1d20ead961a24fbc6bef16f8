{"task_id": "HumanEval/76", "solution": "import math\n\ndef is_simple_power(x, n) -> bool:\n    \"\"\"Determine if x is a simple power of n.\n    Returns True if n^k = x for some integer k, False otherwise.\n    \"\"\"\n\n    # Handle specific edge cases first for clarity and directness.\n    # Any number (except 0 in some contexts) raised to the power of 0 is 1.\n    if x == 1:\n        return True\n\n    # 1 raised to any power is 1. If x is not 1 (handled above), it cannot be a power of 1.\n    if n == 1:\n        return False\n\n    # 0 raised to any positive power is 0. If x is 0, it's a simple power of 0.\n    # Since x != 1, if x is not 0, it cannot be a power of 0.\n    if n == 0:\n        return x == 0\n\n    # General case for finding an integer exponent k such that n^k = x.\n    # This involves logarithms, which require positive bases and arguments.\n    # Gracefully handle cases that fall outside math.log's domain by returning False.\n    try:\n        if n < 0:\n            # If base n is negative, handle by checking absolute values and then parity of exponent.\n            abs_n = abs(n)\n            abs_x = abs(x)\n\n            # abs_x must be positive for log, and abs_n (which is -n) must be positive and not 1.\n            # n=-1 case already handled by `n==1` logic for abs_n=1, which would cause ZeroDivisionError here.\n            if abs_x <= 0 or abs_n <= 0 or abs_n == 1: # Should only trigger if n=-1 or x=0 which are handled or impossible\n                return False\n\n            exponent_abs = math.log(abs_x) / math.log(abs_n)\n            candidate_exponent_abs = round(exponent_abs)\n\n            if abs(exponent_abs - candidate_exponent_abs) < 1e-9: # Check for floating point precision\n                if math.isclose(abs_n ** candidate_exponent_abs, abs_x):\n                    # For a negative base n, if x is positive, the exponent must be even.\n                    # If x is negative, the exponent must be odd.\n                    if x > 0:\n                        return candidate_exponent_abs % 2 == 0\n                    else: # x < 0\n                        return candidate_exponent_abs % 2 != 0\n            return False # Exponent is not an integer or abs check failed\n\n        # For positive base n > 1 (n != 0, n != 1, x != 1).\n        # If x is non-positive, it cannot be a power of a positive base (unless x=1, already handled).\n        if x <= 0:\n            return False\n\n        exponent = math.log(x) / math.log(n)\n        candidate_exponent = round(exponent)\n\n        # Check if the calculated exponent is sufficiently close to an integer.\n        if abs(exponent - candidate_exponent) < 1e-9: # Tolerance for float comparison\n            # Verify the power relationship using the integer exponent, accounting for float precision.\n            return math.isclose(n ** candidate_exponent, x)\n        else:\n            return False\n\n    except (ValueError, ZeroDivisionError):\n        # math.log raises ValueError for non-positive numbers (e.g., log(0), log(-5)).\n        # It also raises ZeroDivisionError if math.log(n) is 0 (i.e., n=1), but n=1 is handled.\n        # Per design, return False for invalid inputs without raising exceptions.\n        return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Determines if an integer is a perfect cube.\n    This function handles positive, negative, and zero integers across Python's full integer range.\n    \"\"\"\n    if a == 0:\n        return True\n\n    def _calculate_cube_root_helper(num: int) -> int:\n        \"\"\"\n        Calculates the integer cube root (floor) of a non-negative number using binary search.\n        This handles arbitrary-precision integers by avoiding float precision limits.\n        \"\"\"\n        if num < 0:\n            # Defensive check; should not be called with negative numbers due to abs(a)\n            return 0 # Or raise error, but specification implies valid inputs\n        if num == 0 or num == 1:\n            return num\n\n        low = 0\n        high = num # The cube root of `num` is always less than or equal to `num` (for num >= 1).\n\n        ans = 0  # Stores the floor of the cube root\n        while low <= high:\n            mid = (low + high) // 2\n            # Python's integers handle arbitrary size, so mid*mid*mid will not overflow.\n            mid_cubed = mid * mid * mid\n\n            if mid_cubed == num:\n                return mid\n            elif mid_cubed < num:\n                ans = mid  # Store mid as a potential integer cube root (floor)\n                low = mid + 1\n            else:  # mid_cubed > num\n                high = mid - 1\n        return ans  # Returns floor(cbrt(num))\n\n    # Step 1: Calculate the integer cube root of the absolute value of 'a'.\n    abs_a = abs(a)\n    cbrt_abs_a = _calculate_cube_root_helper(abs_a)\n\n    # Step 2: Determine the potential perfect cube root based on the sign of 'a'.\n    # If 'a' is negative, its cube root must also be negative.\n    if a < 0:\n        potential_root = -cbrt_abs_a\n    else:  # a > 0 (since a==0 is handled already)\n        potential_root = cbrt_abs_a\n\n    # Step 3: Validate if the potential_root, when cubed, equals the original 'a'.\n    return potential_root * potential_root * potential_root == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num: str) -> int:\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    Identifies '2', '3', '5', '7', 'B', 'D' as prime hex digits.\n    \"\"\"\n    # Internal constant defining prime hexadecimal digits.\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\n    # Handles empty string input as per requirements.\n    if not num:\n        return 0\n\n    prime_count = 0\n    # Iterates through each character in the input string.\n    for char_digit in num:\n        # Checks if the character is one of the defined prime hexadecimal digits.\n        if char_digit in PRIME_HEX_DIGITS:\n            prime_count += 1\n\n    return prime_count"}
