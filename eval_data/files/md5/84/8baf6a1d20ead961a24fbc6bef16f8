{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Compares actual game scores against predicted guesses element-wise.\n    Returns an array of absolute differences, with 0 for exact matches.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/153", "solution": "def _count_uppercase(text: str) -> int:\n    \"\"\"Count uppercase letters (A-Z) in text.\"\"\"\n    count = 0\n    for char in text:\n        if 'A' <= char <= 'Z':\n            count += 1\n    return count\n\ndef _count_lowercase(text: str) -> int:\n    \"\"\"Count lowercase letters (a-z) in text.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            count += 1\n    return count\n\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculate strength as CAP - SM for given extension.\"\"\"\n    cap_count = _count_uppercase(extension_name)\n    sm_count = _count_lowercase(extension_name)\n    return cap_count - sm_count\n\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Main function implementing the strongest extension algorithm.\"\"\"\n    strongest_ext_name = extensions[0]\n    max_strength = _calculate_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_ext_name = extensions[i]\n        current_strength = _calculate_strength(current_ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = current_ext_name\n    \n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def is_substring(main: str, pattern: str) -> bool:\n    \"\"\"\n    Check if pattern is substring of main string.\n    Returns True if pattern found, False otherwise.\n    \"\"\"\n    return pattern in main\n\ndef generate_rotations(s: str) -> list[str]:\n    \"\"\"\n    Generate all possible rotations of input string.\n    Returns a list of all rotations.\n    \"\"\"\n    if not s:\n        return [\"\"]\n    \n    rotations = []\n    n = len(s)\n    for i in range(n):\n        rotations.append(s[i:] + s[:i])\n    return rotations\n\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\n    Orchestrates rotation generation and substring checking.\n    \"\"\"\n    if not b:\n        return True\n\n    rotations_b = generate_rotations(b)\n    \n    for rotation in rotations_b:\n        if is_substring(a, rotation):\n            return True\n            \n    return False"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # If the second string 'b' is empty, it's considered a substring of any string 'a'.\n    # This handles the empty string requirement and UC-005.\n    if not b:\n        return True\n\n    # Iterate through all possible rotations of string 'b'.\n    for i in range(len(b)):\n        # Construct a rotated version of 'b'.\n        rotated_b = b[i:] + b[:i]\n        # Check if the current rotation is a substring of 'a'.\n        if rotated_b in a:\n            return True\n\n    # If no rotation of 'b' was found as a substring in 'a' after checking all possibilities.\n    return False\n```"}
{"task_id": "HumanEval/153", "solution": "def count_uppercase(text):\n    \"\"\"Counts uppercase letters in a string.\n    Iterates through characters and increments a counter for each uppercase letter.\n    \"\"\"\n    count = 0\n    for char in text:\n        if 'A' <= char <= 'Z': # Using range check for simplicity and avoiding method calls\n            count += 1\n    return count\n\ndef count_lowercase(text):\n    \"\"\"Counts lowercase letters in a string.\n    Iterates through characters and increments a counter for each lowercase letter.\n    \"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z': # Using range check for simplicity and avoiding method calls\n            count += 1\n    return count\n\ndef calculate_extension_strength(extension):\n    \"\"\"Calculates the strength of an extension.\n    Strength is defined as CAP - SM, where CAP is uppercase count and SM is lowercase count.\n    \"\"\"\n    cap = count_uppercase(extension)\n    sm = count_lowercase(extension)\n    return cap - sm\n\ndef find_strongest_extension(extensions):\n    \"\"\"Finds the strongest extension from a list based on calculated strength.\n    In case of a tie in strength, the first extension encountered in the list is chosen.\n    \"\"\"\n    if not extensions:\n        return \"\" # Returns an empty string if the list of extensions is empty\n\n    max_strength = -float('inf')\n    strongest_ext_name = \"\"\n\n    for ext_name in extensions:\n        current_strength = calculate_extension_strength(ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n        # Tie-breaking logic: if current_strength == max_strength,\n        # the currently stored strongest_ext_name (which came earlier) is retained.\n\n    return strongest_ext_name\n\ndef format_result(class_name, extension):\n    \"\"\"Formats the final result string.\n    Combines the class name and the strongest extension name into \"ClassName.ExtensionName\" format.\n    \"\"\"\n    return f\"{class_name}.{extension}\"\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Analyzes class extensions to determine the strongest one based on character composition.\n    Calculates strength (CAP - SM), applies tie-breaking, and returns a formatted result string.\n    \"\"\"\n    strongest_ext_name = find_strongest_extension(extensions)\n    result_string = format_result(class_name, strongest_ext_name)\n    return result_string"}
{"task_id": "HumanEval/155", "solution": "def _is_even_digit(digit: str) -> bool:\n    \"\"\"Determines if a single digit character is even (0,2,4,6,8).\"\"\"\n    return int(digit) % 2 == 0\n\ndef _count_digits(digits: str) -> tuple:\n    \"\"\"Counts even and odd digits in digit string.\"\"\"\n    even_count = 0\n    odd_count = 0\n    for digit_char in digits:\n        if _is_even_digit(digit_char):\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)\n\ndef _extract_digits(num: int) -> str:\n    \"\"\"Extracts digit characters from integer, handling negative sign removal.\"\"\"\n    return str(abs(num))\n\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    digit_string = _extract_digits(num)\n    return _count_digits(digit_string)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    Handles negative integers by processing their absolute values.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Process the absolute value of the number to handle negatives\n    abs_num_str = str(abs(num))\n    \n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "```python\n_ROMAN_NUMERAL_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n    (1, 'I')\n]\n\ndef _validate_input_range(number: int) -> bool:\n    \"\"\"Validate input is within range 1-1000.\"\"\"\n    return 1 <= number <= 1000\n\ndef _convert_to_roman(number: int) -> str:\n    \"\"\"Convert integer to uppercase Roman numeral string.\"\"\"\n    roman_numerals = []\n    temp_num = number\n    for value, numeral in _ROMAN_NUMERAL_MAP:\n        while temp_num >= value:\n            roman_numerals.append(numeral)\n            temp_num -= value\n    return \"\".join(roman_numerals)\n\ndef _format_to_lowercase(roman_string: str) -> str:\n    \"\"\"Convert Roman numeral string to lowercase.\"\"\"\n    return roman_string.lower()\n\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"Convert integer to lowercase Roman numeral string.\"\"\"\n    if not _validate_input_range(number):\n        raise ValueError(\"Input out of range\")\n    \n    roman_upper = _convert_to_roman(number)\n    return _format_to_lowercase(roman_upper)\n```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef validate_input(number: int) -> bool:\n    \"\"\"Checks if the input number is within the valid range [1, 1000].\"\"\"\n    return 1 <= number <= 1000\n\ndef convert_to_roman(number: int) -> str:\n    \"\"\"Converts an integer to its uppercase Roman numeral string equivalent.\"\"\"\n    ROMAN_NUMERALS_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'), (100, 'C'),\n        (90, 'XC'), (50, 'L'), (40, 'XL'), (10, 'X'), (9, 'IX'),\n        (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n    \n    roman_string_parts = []\n    for value, numeral in ROMAN_NUMERALS_MAP:\n        while number >= value:\n            roman_string_parts.append(numeral)\n            number -= value\n    return \"\".join(roman_string_parts)\n\ndef format_to_lowercase(roman_string: str) -> str:\n    \"\"\"Converts a Roman numeral string to its lowercase equivalent.\"\"\"\n    return roman_string.lower()\n\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtains its Roman numeral equivalent as a string\n    and returns it in lowercase, within the range 1-1000.\n    \"\"\"\n    if not validate_input(number):\n        raise ValueError(\"Input must be between 1 and 1000\")\n\n    roman_upper_case = convert_to_roman(number)\n    return format_to_lowercase(roman_upper_case)\n```"}
{"task_id": "HumanEval/157", "solution": "def _compare_with_precision(val1, val2, tolerance=1e-10):\n    \"\"\"Compares two floating-point values for equality within a given tolerance.\n    Returns True if the absolute difference is less than the tolerance.\n    \"\"\"\n    return abs(val1 - val2) < tolerance\n\ndef _find_longest_side(a, b, c):\n    \"\"\"Identifies the longest side among three given sides.\n    Returns a tuple: (longest_side, other_side1, other_side2).\n    \"\"\"\n    sides = sorted([a, b, c])\n    return (sides[2], sides[0], sides[1])\n\ndef _calculate_pythagorean(side1, side2, hypotenuse):\n    \"\"\"Checks if the Pythagorean theorem (a\u00b2 + b\u00b2 = c\u00b2) holds for the given sides.\n    Returns True if the sum of squares of side1 and side2 equals hypotenuse squared within precision.\n    \"\"\"\n    sum_of_squares = side1**2 + side2**2\n    hypotenuse_squared = hypotenuse**2\n    return _compare_with_precision(sum_of_squares, hypotenuse_squared)\n\ndef right_angle_triangle(a, b, c):\n    \"\"\"Given three side lengths, determines if they form a right-angled triangle.\n    It applies the Pythagorean theorem with floating-point precision handling.\n    \"\"\"\n    # Identify the longest side, which will be the candidate for the hypotenuse.\n    longest_side, other_side1, other_side2 = _find_longest_side(a, b, c)\n\n    # Use the helper to validate the Pythagorean theorem.\n    return _calculate_pythagorean(other_side1, other_side2, longest_side)"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef _validate_sides(a, b, c):\n    \"\"\"\n    Validates that side lengths are positive and satisfy the triangle inequality theorem.\n    This ensures that the given sides can form a geometrically valid triangle.\n    \"\"\"\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n    # Triangle inequality theorem\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n    return True\n\ndef _check_pythagorean(side1, side2, side3):\n    \"\"\"\n    Checks if any permutation of the three sides satisfies the Pythagorean theorem.\n    It uses math.isclose for robust floating-point comparison to handle precision.\n    \"\"\"\n    # Square the sides and sort them to identify potential hypotenuse (largest side)\n    sides_squared = sorted([side1**2, side2**2, side3**2])\n    # Check if the sum of the two smaller squares equals the largest square\n    return math.isclose(sides_squared[0] + sides_squared[1], sides_squared[2])\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    if not _validate_sides(a, b, c):\n        return False\n    \n    return _check_pythagorean(a, b, c)"}
{"task_id": "HumanEval/158", "solution": "```python\nfrom typing import List\n\ndef count_unique_characters(word: str) -> int:\n    \"\"\"Counts the number of unique characters in a string using a set.\n    This provides an efficient way to get distinct characters.\n    \"\"\"\n    return len(set(word))\n\ndef compare_lexicographically(word1: str, word2: str) -> str:\n    \"\"\"Compares two strings lexicographically and returns the one that comes first.\n    Python's built-in string comparison operator handles this directly.\n    \"\"\"\n    if word1 < word2:\n        return word1\n    return word2\n\ndef find_max(words: List[str]) -> str:\n    \"\"\"Main entry point function that identifies the string with the maximum unique characters.\n    It applies lexicographical ordering for tie-breaking.\n    \"\"\"\n    best_word = \"\"\n    max_unique_count = -1\n\n    for word in words:\n        current_unique_count = count_unique_characters(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: choose lexicographically smaller word\n            best_word = compare_lexicographically(best_word, word)\n    \n    return best_word\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    The rabbit eats as many carrots as needed or available, whichever is less.\n    \"\"\"\n    carrots_consumed_this_meal = min(need, remaining)\n    total_eaten = number + carrots_consumed_this_meal\n    carrots_left = remaining - carrots_consumed_this_meal\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining carrots after a meal.\n    The rabbit eats the minimum of needed carrots or available remaining stock.\n    \"\"\"\n    \n    # Determine the actual number of carrots consumed in this meal.\n    consumed_in_this_meal = min(need, remaining)\n    \n    # Calculate the total number of carrots eaten.\n    total_eaten = number + consumed_in_this_meal\n    \n    # Calculate the number of carrots left in stock.\n    carrots_left = remaining - consumed_in_this_meal\n    \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "def validate_string_list(words: list) -> bool:\n    \"\"\"Validates the input is a list of strings.\"\"\"\n    # Per critical requirements, no actual validation is performed; trust caller inputs.\n    return True\n\ndef count_unique_chars(word: str) -> int:\n    \"\"\"Counts unique characters in a string.\"\"\"\n    return len(set(word))\n\ndef apply_lexicographical_ordering(candidate1: str, candidate2: str) -> str:\n    \"\"\"Returns the string that comes first lexicographically.\"\"\"\n    return candidate1 if candidate1 < candidate2 else candidate2\n\ndef select_max_unique_string(words: list[str]) -> str:\n    \"\"\"Selects the string with maximum unique characters, applying lexicographical tie-breaking.\"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    current_best_string = \"\"\n\n    for word in words:\n        unique_count = count_unique_chars(word)\n\n        if unique_count > max_unique_count:\n            max_unique_count = unique_count\n            current_best_string = word\n        elif unique_count == max_unique_count:\n            current_best_string = apply_lexicographical_ordering(word, current_best_string)\n\n    return current_best_string\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"Finds the string with the maximum unique characters, with lexicographical tie-breaking.\"\"\"\n    validate_string_list(words)\n\n    if not words:\n        return \"\"\n\n    return select_max_unique_string(words)"}
{"task_id": "HumanEval/161", "solution": "def _has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any letter characters.\"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\n\ndef _reverse_case(char: str) -> str:\n    \"\"\"Reverses the case of a single letter character.\"\"\"\n    return char.swapcase()\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the order of characters in a string.\"\"\"\n    return s[::-1]\n\ndef solve(s):\n    \"\"\"Transforms input string based on content analysis: reverses letter case or reverses string order.\"\"\"\n    if _has_letters(s):\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(_reverse_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return _reverse_string(s)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from operator and operand lists.\n    Constructs the expression string and uses Python's eval() for calculation.\n    \"\"\"\n\n    def _build_expression(operator_list, operand_list):\n        \"\"\"\n        Builds the algebraic expression string by interleaving operands and operators.\n        Assumes valid input lists as per the problem constraints.\n        \"\"\"\n        expression_parts = []\n        expression_parts.append(str(operand_list[0]))\n\n        for i in range(len(operator_list)):\n            expression_parts.append(operator_list[i])\n            expression_parts.append(str(operand_list[i + 1]))\n            \n        return \" \".join(expression_parts)\n\n    expression_string = _build_expression(operator, operand)\n    result = eval(expression_string)\n    \n    return int(result)"}
{"task_id": "HumanEval/161", "solution": "def is_letter(char):\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\ndef has_letters(s):\n    \"\"\"Determines if the string contains any letter characters.\"\"\"\n    for char in s:\n        if is_letter(char):\n            return True\n    return False\n\ndef reverse_case(char):\n    \"\"\"Reverses the case of a letter character.\"\"\"\n    if 'a' <= char <= 'z':\n        return char.upper()\n    elif 'A' <= char <= 'Z':\n        return char.lower()\n    return char\n\ndef reverse_string(s):\n    \"\"\"Reverses the order of characters in a string.\"\"\"\n    return s[::-1]\n\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    if not has_letters(s):\n        return reverse_string(s)\n\n    processed_chars = []\n    for char in s:\n        if is_letter(char):\n            processed_chars.append(reverse_case(char))\n        else:\n            processed_chars.append(char)\n    return \"\".join(processed_chars)"}
{"task_id": "HumanEval/160", "solution": "```python\ndef _combine_operators_operands(operator, operand):\n    \"\"\"\n    Combines lists of operators and operands into a single algebraic expression string.\n    This function assumes valid input lengths and types as per problem constraints.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n    return \" \".join(expression_parts)\n\ndef _evaluate_expression_string(expression_string):\n    \"\"\"\n    Evaluates an algebraic expression string using Python's built-in eval().\n    It returns the integer result, relying on eval() for standard mathematical precedence.\n    \"\"\"\n    result = eval(expression_string)\n    return int(result)\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists, operator and operand, builds an algebraic expression and returns its evaluation.\n    This function orchestrates expression construction and evaluation without explicit input validation.\n    \"\"\"\n    expression_string = _combine_operators_operands(operator, operand)\n    result = _evaluate_expression_string(expression_string)\n    return result\n```"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef _validate_input(text: str) -> bool:\n    \"\"\"Validate that input is a string. This function returns True as per \"trust caller\" constraint.\"\"\"\n    return True\n\ndef _is_empty(text: str) -> bool:\n    \"\"\"Check if input string is empty.\"\"\"\n    return not text\n\ndef _generate_hash(text: str) -> str:\n    \"\"\"Generate MD5 hash from non-empty string. It uses UTF-8 encoding for consistency.\"\"\"\n    return hashlib.md5(text.encode('utf-8')).hexdigest()\n\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    _validate_input(text) # Call validation as per design, even if trivial under constraints.\n\n    if _is_empty(text):\n        return None\n    else:\n        return _generate_hash(text)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef _validate_input(text):\n    \"\"\"Checks if the input string is non-empty.\n    Returns True if valid and non-empty, False otherwise.\n    \"\"\"\n    return bool(text)\n\ndef _compute_md5_hash(text):\n    \"\"\"Computes the raw MD5 hash for the given text.\n    The text is encoded to UTF-8 before hashing.\n    \"\"\"\n    md5_hash_object = hashlib.md5(text.encode('utf-8'))\n    return md5_hash_object.hexdigest()\n\ndef _format_hex_output(hash_value):\n    \"\"\"Formats the hash value to a lowercase hexadecimal string.\n    Ensures consistent output formatting.\n    \"\"\"\n    return hash_value.lower()\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not _validate_input(text):\n        return None\n\n    raw_hash = _compute_md5_hash(text)\n    formatted_hash = _format_hex_output(raw_hash)\n    return formatted_hash"}
{"task_id": "HumanEval/163", "solution": "EVEN_DIGITS = [0, 2, 4, 6, 8]\n\ndef validate_positive_integers(a, b):\n    \"\"\"\n    Validates if both input parameters are positive integers.\n    Returns True if both are greater than zero, False otherwise.\n    \"\"\"\n    return a > 0 and b > 0\n\ndef get_even_digits_in_range(min_val, max_val):\n    \"\"\"\n    Extracts even digits that fall within the specified range.\n    Uses the global EVEN_DIGITS constant for processing.\n    \"\"\"\n    result = []\n    for digit in EVEN_DIGITS:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n    return result\n\ndef format_result(digits):\n    \"\"\"\n    Formats the list of digits, ensuring they are sorted in ascending order.\n    The EVEN_DIGITS constant ensures inherent sorting here.\n    \"\"\"\n    return digits\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    if not validate_positive_integers(a, b):\n        return []\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    raw_digits = get_even_digits_in_range(min_val, max_val)\n    final_result = format_result(raw_digits)\n\n    return final_result"}
{"task_id": "HumanEval/163", "solution": "def _validate_inputs(a: int, b: int) -> bool:\n    \"\"\"\n    Validates that input parameters are positive integers.\n    Per critical requirements, this function assumes inputs are valid.\n    \"\"\"\n    return True\n\ndef _get_even_digits_in_range(min_val: int, max_val: int) -> list:\n    \"\"\"\n    Identifies even digits (0, 2, 4, 6, 8) within the specified range.\n    It iterates through fixed even digits and checks if they fall within min_val and max_val.\n    \"\"\"\n    even_digits_set = {0, 2, 4, 6, 8}\n    result = []\n    for digit in sorted(list(even_digits_set)): # Iterate in order to help with eventual sorting\n        if min_val <= digit <= max_val:\n            result.append(digit)\n    return result\n\ndef _sort_ascending(digits: list) -> list:\n    \"\"\"\n    Sorts a list of digits in ascending order.\n    Given how _get_even_digits_in_range processes digits, the list is often already sorted.\n    \"\"\"\n    # For a small, fixed domain of digits, sorting is effectively O(1).\n    return sorted(digits)\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    _validate_inputs(a, b) # This call exists per design, but performs no actual validation per critical requirements.\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits_found = _get_even_digits_in_range(min_val, max_val)\n    sorted_digits = _sort_ascending(even_digits_found)\n    \n    return sorted_digits"}
