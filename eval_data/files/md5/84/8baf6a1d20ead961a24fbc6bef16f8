{"task_id": "HumanEval/120", "solution": "```python\ndef _validate_input(arr: list[int], k: int) -> bool:\n    \"\"\"Validates input constraints, always returning True as per \"trust caller's inputs\" principle.\n    Problem statement guarantees all required input constraints are met.\n    \"\"\"\n    return True\n\ndef _find_k_largest(arr: list[int], k: int) -> list[int]:\n    \"\"\"Identifies the k largest elements from the array, returning them in descending order.\n    It sorts the array in reverse and selects the top k elements.\n    \"\"\"\n    return sorted(arr, reverse=True)[:k]\n\ndef _sort_result(elements: list[int]) -> list[int]:\n    \"\"\"Sorts the given elements list in ascending order.\n    It uses Python's built-in sorted function for a pure and efficient operation.\n    \"\"\"\n    return sorted(elements)\n\ndef maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Main function to find the k largest elements from an array, sorted ascending.\n    It processes the input by validating, selecting, and then sorting the results.\n    \"\"\"\n    _validate_input(arr, k)\n\n    if k == 0:\n        return []\n\n    k_largest_elements = _find_k_largest(arr, k)\n    sorted_result = _sort_result(k_largest_elements)\n\n    return sorted_result\n```"}
{"task_id": "HumanEval/122", "solution": "def _is_two_digit(num: int) -> bool:\n    \"\"\"Checks if a number has at most two digits (value between -99 and 99).\"\"\"\n    return abs(num) <= 99\n\ndef add_elements(arr: list[int], k: int) -> int:\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    # Process only the first k elements from the input array.\n    processed_elements = arr[:k]\n\n    total_sum = 0\n    # Identify elements with at most two digits and calculate their sum.\n    for element in processed_elements:\n        if _is_two_digit(element):\n            total_sum += element\n\n    return total_sum"}
{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List\n\n# Data Layer\n\nclass ArrayUtils:\n    \"\"\"Utility functions for array processing.\"\"\"\n    @staticmethod\n    def is_empty(arr: List[int]) -> bool:\n        \"\"\"Checks if an array is empty.\"\"\"\n        return len(arr) == 0\n\n    @staticmethod\n    def get_length(arr: List[int]) -> int:\n        \"\"\"Returns the length of an array.\"\"\"\n        return len(arr)\n\n    @staticmethod\n    def copy_array(arr: List[int]) -> List[int]:\n        \"\"\"Creates a shallow copy of an array.\"\"\"\n        return list(arr)\n\n# Business Logic Layer\n\nclass InputValidator:\n    \"\"\"Validates input parameters against business rules.\"\"\"\n    # Constants for constraints on array length and element values.\n    MIN_ARRAY_LENGTH = 1\n    MAX_ARRAY_LENGTH = 1000\n    MIN_ELEMENT_VALUE = -1000\n    MAX_ELEMENT_VALUE = 1000\n\n    def validate_array(self, arr: List[int]) -> None:\n        \"\"\"Performs array-level validation (no-op as per critical requirements).\"\"\"\n        pass\n\n    def validate_k(self, k: int, array_length: int) -> None:\n        \"\"\"Performs k-parameter validation (no-op as per critical requirements).\"\"\"\n        pass\n\n    def validate_element_range(self, arr: List[int]) -> None:\n        \"\"\"Validates individual element values (no-op as per critical requirements).\"\"\"\n        pass\n\nclass ElementSelector:\n    \"\"\"Implements efficient k-largest element selection algorithm using a min-heap.\"\"\"\n    def _maintain_heap_size(self, min_heap: List[int], element: int, k: int) -> None:\n        \"\"\"Helper to maintain the min-heap size and elements.\"\"\"\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, element)\n        elif element > min_heap[0]:\n            heapq.heapreplace(min_heap, element)\n\n    def select_k_largest(self, arr: List[int], k: int) -> List[int]:\n        \"\"\"Selects the k largest elements from an array using a min-heap.\"\"\"\n        # k=0 is handled by the processor, but a defensive check here is harmless.\n        if k == 0:\n            return []\n\n        min_heap: List[int] = [] # Min-heap to store the k largest elements.\n\n        for element in arr:\n            self._maintain_heap_size(min_heap, element, k)\n        \n        return min_heap\n\nclass ResultSorter:\n    \"\"\"Sorts selected elements in ascending order.\"\"\"\n    def sort_result(self, elements: List[int]) -> List[int]:\n        \"\"\"Sorts a list of elements in ascending order.\"\"\"\n        return sorted(elements)\n\nclass MaximumProcessor:\n    \"\"\"Coordinates validation, selection, and sorting operations.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the processor with its dependent components.\"\"\"\n        self._validator = InputValidator()\n        self._selector = ElementSelector()\n        self._sorter = ResultSorter()\n\n    def process(self, arr: List[int], k: int) -> List[int]:\n        \"\"\"Orchestrates the process of finding and sorting the k largest elements.\"\"\"\n        self._validator.validate_array(arr)\n        self._validator.validate_k(k, ArrayUtils.get_length(arr))\n        self._validator.validate_element_range(arr)\n\n        # Edge case: k=0, return empty list immediately as per sequence diagram.\n        if k == 0:\n            return []\n\n        selected_elements = self._selector.select_k_largest(arr, k)\n        sorted_result = self._sorter.sort_result(selected_elements)\n        return sorted_result\n\n# Interface Layer\n\n# Instantiate the processor once for the module.\n_maximum_processor = MaximumProcessor()\n\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    return _maximum_processor.process(arr, k)"}
{"task_id": "HumanEval/122", "solution": "def is_two_digit_or_less(value: int) -> bool:\n    \"\"\"\n    Determines if an integer has at most two digits.\n    Returns True if value is between -99 and 99 inclusive.\n    \"\"\"\n    return -99 <= value <= 99\n\ndef process_first_k_elements(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Extracts the first k elements from the input array.\n    This function returns a slice of the original array.\n    \"\"\"\n    return arr[:k]\n\ndef filter_two_digit_elements(elements: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of elements, keeping only those with at most two digits.\n    It uses the `is_two_digit_or_less` helper function for individual checks.\n    \"\"\"\n    return [e for e in elements if is_two_digit_or_less(e)]\n\ndef calculate_sum(elements: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all provided elements.\n    This function uses Python's built-in sum for efficient calculation.\n    \"\"\"\n    return sum(elements)\n\ndef add_elements(arr: list[int], k: int) -> int:\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    first_k_elements = process_first_k_elements(arr, k)\n    two_digit_elements = filter_two_digit_elements(first_k_elements)\n    total_sum = calculate_sum(two_digit_elements)\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in the Collatz sequence.\n    The sequence is generated until 1 is reached, extracting and sorting all odd numbers found.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    current_num = n\n    sequence = []\n    # Generate the Collatz sequence by applying rules until 1 is reached.\n    while current_num != 1:\n        sequence.append(current_num)\n        if current_num % 2 == 0:\n            current_num //= 2\n        else:\n            current_num = 3 * current_num + 1\n    sequence.append(1) # Ensure the termination value 1 is always included in the sequence.\n\n    odd_numbers = []\n    # Extract all odd numbers from the complete sequence.\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.append(num)\n\n    odd_numbers.sort() # Sort the extracted odd numbers in ascending order.\n    return odd_numbers"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list containing the odd numbers from its Collatz sequence.\n    The sequence starts with n and continues until it reaches 1, following Collatz conjecture rules.\n    \"\"\"\n    # Handle special case where input is 1, as per design\n    if n == 1:\n        return [1]\n\n    # Generate the complete Collatz sequence until 1\n    sequence = []\n    current = n\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = current * 3 + 1\n    sequence.append(1)  # Ensure 1 is always included in the sequence\n\n    # Extract only the odd numbers from the generated sequence\n    odd_numbers = [num for num in sequence if num % 2 == 1]\n\n    # Sort the extracted odd numbers in ascending order and return\n    return sorted(odd_numbers)"}
{"task_id": "HumanEval/124", "solution": "MONTHS_31_DAYS = (1, 3, 5, 7, 8, 10, 12)\nMONTHS_30_DAYS = (4, 6, 9, 11)\nFEBRUARY = 2\n\ndef _parse_date_components(date_string: str) -> tuple | None:\n    \"\"\"Parses mm-dd-yyyy format into integer components.\n    Returns (month, day, year) tuple or None if conversion fails.\n    \"\"\"\n    try:\n        parts = date_string.split('-')\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return (month, day, year)\n    except (ValueError, IndexError):\n        return None\n\ndef _validate_format(date_string: str) -> bool:\n    \"\"\"Checks if string matches mm-dd-yyyy pattern with hyphens.\n    Rejects alternative formats and ensures correct part lengths.\n    \"\"\"\n    if len(date_string) != 10:\n        return False\n    \n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return False\n    \n    if not (parts[0].isdigit() and len(parts[0]) == 2 and\n            parts[1].isdigit() and len(parts[1]) == 2 and\n            parts[2].isdigit() and len(parts[2]) == 4):\n        return False\n        \n    return True\n\ndef _validate_month(month: int) -> bool:\n    \"\"\"Validates month is in range 1-12.\n    \"\"\"\n    return 1 <= month <= 12\n\ndef _get_max_days_for_month(month: int) -> int:\n    \"\"\"Returns maximum days for the given month.\n    February is fixed at 29 days as per problem statement rules.\n    \"\"\"\n    if month in MONTHS_31_DAYS:\n        return 31\n    elif month in MONTHS_30_DAYS:\n        return 30\n    elif month == FEBRUARY:\n        return 29\n    return 0 # Should not be reached with prior month validation\n\ndef _validate_day(day: int, month: int) -> bool:\n    \"\"\"Validates day is appropriate for the given month.\n    \"\"\"\n    max_days = _get_max_days_for_month(month)\n    return 1 <= day <= max_days\n\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string in mm-dd-yyyy format.\n    Returns True if the date is valid, otherwise False.\n    \"\"\"\n    if not date:\n        return False\n\n    if not _validate_format(date):\n        return False\n\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n    \n    month, day, _ = components # Year is parsed but not used for validation\n\n    if not _validate_month(month):\n        return False\n\n    if not _validate_day(day, month):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Validates if a list of non-negative integers is sorted in ascending order.\n    Returns False if any number appears more than twice, or if the order is violated.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Orchestrates text processing with hierarchical splitting or counting logic.\n    Returns a list of words or an integer count based on delimiters.\n    '''\n    def _has_whitespace(s: str) -> bool:\n        '''Detects if the string contains any whitespace characters.'''\n        return any(char.isspace() for char in s)\n\n    def _has_commas(s: str) -> bool:\n        '''Detects if the string contains any comma characters.'''\n        return ',' in s\n\n    def _is_odd_order_letter(char: str) -> bool:\n        '''Determines if a character is a lowercase letter with an odd alphabetical position.'''\n        if 'a' <= char <= 'z':\n            return (ord(char) - ord('a')) % 2 != 0\n        return False\n\n    def _count_odd_letters(s: str) -> int:\n        '''Counts lowercase letters in the string that have an odd alphabetical order.'''\n        count = 0\n        for char in s:\n            if _is_odd_order_letter(char):\n                count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_commas(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_letters(txt)"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Validates if a list of non-negative integers is sorted in ascending order\n    with at most one duplicate of any number allowed.\n    '''\n    n = len(lst)\n\n    # Single-element lists are always considered sorted and valid.\n    if n <= 1:\n        return True\n\n    # Use a dictionary to count occurrences of each number.\n    counts = {}\n\n    # Iterate through the list to check both sorting order and duplicate constraints.\n    for i in range(n):\n        current_num = lst[i]\n\n        # Check for ascending order (only for multi-element lists, after the first element).\n        if i > 0:\n            if current_num < lst[i-1]:\n                return False\n\n        # Count occurrences of the current number.\n        counts[current_num] = counts.get(current_num, 0) + 1\n\n        # Check duplicate constraint: at most two occurrences (one value and one duplicate) are allowed.\n        if counts[current_num] > 2:\n            return False\n\n    # If all checks pass, the list is sorted according to the rules.\n    return True"}
{"task_id": "HumanEval/125", "solution": "from typing import Union, List\n\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Splits text by whitespace, then by commas, or counts odd-positioned lowercase letters.\n    The processing order is whitespace, then commas, then letter counting.\n    \"\"\"\n\n    # Check for whitespace (FR-002)\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace: # Whitespace Processing (Priority 1)\n        return txt.split() # FR-003: Return list from whitespace splitting\n\n    # Check for commas (FR-004)\n    if ',' in txt: # Comma Processing (Priority 2)\n        return txt.split(',') # FR-005: Return list from comma splitting\n\n    # Count odd-positioned lowercase letters (FR-006)\n    count = 0\n    # Iterate through characters to find lowercase letters (FR-009).\n    for char in txt:\n        if 'a' <= char <= 'z': # Check if lowercase\n            # Calculate zero-based alphabetical position (FR-007).\n            pos = ord(char) - ord('a')\n            if pos % 2 == 1: # Check if position is odd\n                count += 1\n    return count # FR-008: Return integer count"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string according to specific format and business rules.\n    Returns True for valid dates, False for invalid dates.\n    \"\"\"\n\n    def _get_max_days_for_month(month: int) -> int:\n        \"\"\"Returns the maximum number of days for a given month, ignoring leap years.\n        Returns 0 for an invalid month.\n        \"\"\"\n        if month in {1, 3, 5, 7, 8, 10, 12}:\n            return 31\n        elif month in {4, 6, 9, 11}:\n            return 30\n        elif month == 2:\n            return 29\n        return 0\n\n    def _validate_day(day: int, month: int) -> bool:\n        \"\"\"Validates the day value against month-specific rules.\n        Ensures the day is within the acceptable range for the given month.\n        \"\"\"\n        max_days = _get_max_days_for_month(month)\n        return 1 <= day <= max_days\n\n    def _validate_month(month: int) -> bool:\n        \"\"\"Validates that the month value is within the 1-12 range.\n        \"\"\"\n        return 1 <= month <= 12\n\n    def _parse_date_string(date: str) -> tuple[int, int, int] | None:\n        \"\"\"Parses a date string in mm-dd-yyyy format.\n        Returns a tuple (month, day, year) or None if parsing fails or format is incorrect.\n        \"\"\"\n        parts = date.split('-')\n        if len(parts) != 3:\n            return None\n\n        m_str, d_str, y_str = parts\n\n        # Enforce strict mm-dd-yyyy length for each part\n        if not (len(m_str) == 2 and len(d_str) == 2 and len(y_str) == 4):\n            return None\n\n        try:\n            month = int(m_str)\n            day = int(d_str)\n            year = int(y_str)\n        except ValueError:\n            return None\n\n        return month, day, year\n\n    # Main validation logic\n    if not date:\n        return False\n\n    parsed_date_components = _parse_date_string(date)\n    if parsed_date_components is None:\n        return False\n\n    month, day, year = parsed_date_components\n\n    if not _validate_month(month):\n        return False\n\n    if not _validate_day(day, month):\n        return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" for prime lengths, \"NO\" otherwise or if no intersection.\"\"\"\n\n    def calculate_intersection(int1, int2):\n        \"\"\"Calculates the intersection of two closed intervals.\n        Returns a tuple (start, end) or None if no intersection.\"\"\"\n        start1, end1 = int1\n        start2, end2 = int2\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        if intersection_start > intersection_end:\n            return None\n        return (intersection_start, intersection_end)\n\n    def is_prime(number):\n        \"\"\"Checks if a given number is a prime number.\n        Handles numbers less than or equal to 1 as not prime.\"\"\"\n        if number <= 1:\n            return False\n        if number <= 3:\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    intersected_interval = calculate_intersection(interval1, interval2)\n\n    if intersected_interval is None:\n        return \"NO\"\n    else:\n        int_start, int_end = intersected_interval\n        # Length of a closed interval (a, b) is b - a + 1\n        intersection_length = int_end - int_start + 1\n        \n        if is_prime(intersection_length):\n            return \"YES\"\n        else:\n            return \"NO\""}
{"task_id": "HumanEval/127", "solution": "def is_prime(n):\n    \"\"\"Validate if a number is prime according to mathematical definition.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to the square root of n.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef calculate_intersection(interval1, interval2):\n    \"\"\"Calculate intersection of two closed intervals.\n    Returns (start, end) tuple if intersection exists, None otherwise.\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start > intersection_end:\n        return None\n    else:\n        return (intersection_start, intersection_end)\n\ndef intersection(interval1, interval2):\n    \"\"\"Main orchestration function that processes two intervals and returns prime validation result.\n    Returns \"YES\" if intersection length is prime, \"NO\" otherwise.\n    \"\"\"\n    intersection_result = calculate_intersection(interval1, interval2)\n\n    if intersection_result is None:\n        return \"NO\"\n\n    int_start, int_end = intersection_result\n    intersection_length = int_end - int_start + 1\n\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "from typing import List, Union\n\ndef is_empty(arr: List[int]) -> bool:\n    \"\"\"Checks if the input array is empty.\"\"\"\n    return len(arr) == 0\n\ndef contains_zero(arr: List[int]) -> bool:\n    \"\"\"Checks if the input array contains any zero value.\"\"\"\n    for x in arr:\n        if x == 0:\n            return True\n    return False\n\ndef calculate_magnitude(value: int) -> int:\n    \"\"\"Calculates the absolute value of an integer.\"\"\"\n    return abs(value)\n\ndef calculate_sum_of_magnitudes(arr: List[int]) -> int:\n    \"\"\"Calculates the sum of absolute values for all array elements.\"\"\"\n    total_magnitude = 0\n    for x in arr:\n        total_magnitude += calculate_magnitude(x)\n    return total_magnitude\n\ndef calculate_sign(value: int) -> int:\n    \"\"\"Determines the mathematical sign of an integer (1, -1, or 0).\"\"\"\n    if value > 0:\n        return 1\n    elif value < 0:\n        return -1\n    else:\n        return 0\n\ndef calculate_product_of_signs(arr: List[int]) -> int:\n    \"\"\"Calculates the product of signs for all integers in the array.\"\"\"\n    product = 1\n    for x in arr:\n        product *= calculate_sign(x)\n    return product\n\ndef prod_signs(arr: List[int]) -> Union[int, None]:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if is_empty(arr):\n        return None\n\n    if contains_zero(arr):\n        return 0\n\n    sum_magnitudes = calculate_sum_of_magnitudes(arr)\n    product_signs = calculate_product_of_signs(arr)\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes multiplied by product of signs for an array of integers.\n    Returns None for an empty array, and 0 if any element is zero.\n    \"\"\"\n    if not arr:\n        return None\n\n    magnitude_sum = 0\n    sign_product = 1\n\n    for num in arr:\n        magnitude_sum += abs(num)\n\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else: # num == 0\n            # If any number is zero, the overall product of signs becomes zero,\n            # causing the final result to be zero. We can return immediately.\n            return 0\n\n        sign_product *= current_sign\n\n    return magnitude_sum * sign_product\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Position:\n    \"\"\"Represents coordinates within the grid.\"\"\"\n    def __init__(self, row, col):\n        self.row = row\n        self.col = col\n\n    def getRow(self):\n        \"\"\"Returns the row coordinate.\"\"\"\n        return self.row\n\n    def getCol(self):\n        \"\"\"Returns the column coordinate.\"\"\"\n        return self.col\n\n    def __eq__(self, other):\n        \"\"\"Checks if two Position objects are equal.\"\"\"\n        if not isinstance(other, Position):\n            return False\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        \"\"\"Generates a hash for the Position object.\"\"\"\n        return hash((self.row, self.col))\n\n    def __str__(self):\n        \"\"\"Returns a string representation of the position.\"\"\"\n        return f\"({self.row}, {self.col})\"\n\n\nclass Grid:\n    \"\"\"Represents the N x N grid structure and provides cell access.\"\"\"\n    def __init__(self, cells):\n        self.cells = cells\n        self.N = len(cells)\n\n    def getCell(self, row, col):\n        \"\"\"Returns the value at the specified grid cell.\"\"\"\n        return self.cells[row][col]\n\n    def isValidPosition(self, row, col):\n        \"\"\"Checks if a given row and column are within grid boundaries.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\n\n    def getNeighbors(self, row, col):\n        \"\"\"Returns a list of valid neighbor positions for a given cell.\"\"\"\n        neighbors = []\n        # Define possible movements (up, down, left, right)\n        dr = [-1, 1, 0, 0]\n        dc = [0, 0, -1, 1]\n\n        for i in range(4):\n            new_row, new_col = row + dr[i], col + dc[i]\n            if self.isValidPosition(new_row, new_col):\n                neighbors.append(Position(new_row, new_col))\n        return neighbors\n\n    def getSize(self):\n        \"\"\"Returns the size N of the N x N grid.\"\"\"\n        return self.N\n\n\nclass Path:\n    \"\"\"Represents a sequence of positions and their corresponding values.\"\"\"\n    def __init__(self):\n        self.positions = []\n        self.values = []\n        self.length = 0\n\n    def addPosition(self, position, value):\n        \"\"\"Adds a new position and its value to the path.\"\"\"\n        self.positions.append(position)\n        self.values.append(value)\n        self.length += 1\n\n    def getValues(self):\n        \"\"\"Returns the ordered list of cell values in the path.\"\"\"\n        return self.values\n\n    def getLength(self):\n        \"\"\"Returns the current number of cells in the path.\"\"\"\n        return self.length\n\n    def copy(self):\n        \"\"\"Creates a deep copy of the current path.\"\"\"\n        new_path = Path()\n        new_path.positions = list(self.positions)\n        new_path.values = list(self.values)\n        new_path.length = self.length\n        return new_path\n\n    def __str__(self):\n        \"\"\"Returns a string representation of the path's values.\"\"\"\n        return f\"Path values: {self.values}\"\n\n\nclass PathComparator:\n    \"\"\"Utility class for lexicographical path comparison.\"\"\"\n    @staticmethod\n    def isLexicographicallySmaller(path1, path2):\n        \"\"\"Compares two paths lexicographically and returns True if path1 is smaller.\"\"\"\n        values1 = path1.getValues()\n        values2 = path2.getValues()\n        for i in range(len(values1)):\n            if values1[i] < values2[i]:\n                return True\n            if values1[i] > values2[i]:\n                return False\n        return False\n\n    @staticmethod\n    def findMinimumPath(paths):\n        \"\"\"Finds the lexicographically smallest path from a list of paths.\"\"\"\n        if not paths:\n            return None\n        \n        minimum_path = paths[0]\n        for i in range(1, len(paths)):\n            if PathComparator.isLexicographicallySmaller(paths[i], minimum_path):\n                minimum_path = paths[i]\n        return minimum_path\n\n\nclass PathFinder:\n    \"\"\"Core algorithm implementation for finding the minimum path.\"\"\"\n    def __init__(self, grid, k):\n        self.grid = grid\n        self.k = k\n        self.all_found_paths = []\n\n    def findMinimumPath(self):\n        \"\"\"Initiates the pathfinding process from all possible starting positions.\"\"\"\n        N = self.grid.getSize()\n        for r in range(N):\n            for c in range(N):\n                start_position = Position(r, c)\n                current_path = Path()\n                self.exploreFromPosition(start_position, current_path)\n        \n        return PathComparator.findMinimumPath(self.all_found_paths).getValues()\n\n    def exploreFromPosition(self, current_pos, current_path):\n        \"\"\"Recursively explores paths using Depth-First Search.\"\"\"\n        path_at_current_step = current_path.copy()\n        path_at_current_step.addPosition(current_pos, self.grid.getCell(current_pos.getRow(), current_pos.getCol()))\n\n        if path_at_current_step.getLength() == self.k:\n            self.all_found_paths.append(path_at_current_step)\n            return\n\n        neighbors = self.grid.getNeighbors(current_pos.getRow(), current_pos.getCol())\n        for neighbor in neighbors:\n            self.exploreFromPosition(neighbor, path_at_current_step)\n\n\ndef minPath(grid_data, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in an N x N grid.\n    This function initializes and orchestrates the pathfinding algorithm.\n    \"\"\"\n    grid_obj = Grid(grid_data)\n    path_finder = PathFinder(grid_obj, k)\n    return path_finder.findMinimumPath()\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef compute_even_value(n: int) -> float:\n    \"\"\"Computes Tribonacci value for even indices using the formula 1 + n/2.\"\"\"\n    return 1 + n / 2\n\ndef get_base_value() -> float:\n    \"\"\"Returns the base case value for tri(1), which is 3.0.\"\"\"\n    return 3.0\n\ndef compute_odd_value(n: int, sequence: list[float]) -> float:\n    \"\"\"Computes Tribonacci value for odd indices using tri(n-1) + tri(n-2) + tri(n+1).\"\"\"\n    # For an odd n, n+1 is always even, allowing direct computation of tri(n+1).\n    tri_n_minus_1 = sequence[n - 1]\n    tri_n_minus_2 = sequence[n - 2]\n    tri_n_plus_1 = compute_even_value(n + 1)\n    return tri_n_minus_1 + tri_n_minus_2 + tri_n_plus_1\n\ndef generate_sequence(n: int) -> list[float]:\n    \"\"\"Generates the complete Tribonacci sequence up to tri(n) iteratively.\"\"\"\n    sequence = []\n\n    if n == 0:\n        return []\n\n    # Handle tri(0) and tri(1) as initial values for the sequence.\n    sequence.append(compute_even_value(0)) # tri(0) = 1 + 0/2 = 1.0\n    sequence.append(get_base_value())      # tri(1) = 3.0\n\n    # Iteratively compute remaining values from tri(2) to tri(n).\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # If i is even, apply the even number formula.\n            sequence.append(compute_even_value(i))\n        else:  # If i is odd, apply the odd number recurrence.\n            sequence.append(compute_odd_value(i, sequence))\n            \n    return sequence\n\ndef tri(n: int) -> list[float]:\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    This function orchestrates the iterative generation of the sequence.\n    \"\"\"\n    # Input validation (e.g., isinstance checks) is omitted per critical requirements.\n    # It is assumed `n` is a non-negative integer.\n    return generate_sequence(n)\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to the n-th term.\n    Returns a list of the first n+1 numbers as floats.\n    \"\"\"\n\n    def apply_even_rule_inline(idx):\n        \"\"\"Applies the recurrence rule for an even index.\"\"\"\n        return 1.0 + idx / 2\n\n    def compute_value_inline(idx, memo):\n        \"\"\"Computes the Tribonacci value for a given index, utilizing memoization for efficiency.\"\"\"\n        # Handle base cases: tri(0) = 1, tri(1) = 3\n        if idx == 0:\n            return 1.0\n        if idx == 1:\n            return 3.0\n        \n        # Return memoized value if already computed\n        if idx in memo:\n            return memo[idx]\n\n        # Compute value based on recurrence rules\n        if idx % 2 == 0:  # Even rule: tri(n) = 1 + n / 2\n            value = apply_even_rule_inline(idx)\n        else:  # Odd rule: tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n            val_n_minus_1 = compute_value_inline(idx - 1, memo)\n            val_n_minus_2 = compute_value_inline(idx - 2, memo)\n            val_n_plus_1 = compute_value_inline(idx + 1, memo) # Recursively compute tri(n+1)\n            value = val_n_minus_1 + val_n_minus_2 + val_n_plus_1\n        \n        # Store computed value in memo and return it\n        memo[idx] = value\n        return value\n\n    # Initialize memoization dictionary to store computed sequence values\n    memo = {}\n\n    # Calculate all necessary values for indices from 0 up to n.\n    # The recursive calls within compute_value_inline will handle dependencies like tri(n+1).\n    for i in range(n + 1):\n        compute_value_inline(i, memo)\n    \n    # Construct the final result list containing values for indices 0 to n\n    result_sequence = [memo[i] for i in range(n + 1)]\n            \n    return result_sequence\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nfrom typing import List, Tuple, Optional\n\nclass Cell:\n    \"\"\"Represents an individual grid cell with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_neighbors(self, grid_size: int) -> List[Tuple[int, int]]:\n        \"\"\"Calculates valid adjacent cell coordinates within grid boundaries.\"\"\"\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in moves:\n            n_row, n_col = self._row + dr, self._col + dc\n            if 0 <= n_row < grid_size and 0 <= n_col < grid_size:\n                neighbors.append((n_row, n_col))\n        return neighbors\n\n    def is_valid(self, grid_size: int) -> bool:\n        \"\"\"Checks if the cell's coordinates are within the grid boundaries.\"\"\"\n        return 0 <= self._row < grid_size and 0 <= self._col < grid_size\n\nclass Grid:\n    \"\"\"Manages the grid structure and validates input constraints.\"\"\"\n    def __init__(self, cells: List[List[int]]):\n        self._cells = cells\n        self._N = len(cells)\n\n    def validate_dimensions(self) -> bool:\n        \"\"\"Validates that the grid is N x N and N >= 2.\"\"\"\n        if self._N < 2:\n            return False\n        for row in self._cells:\n            if len(row) != self._N:\n                return False\n        return True\n\n    def validate_cell_values(self) -> bool:\n        \"\"\"Validates cell values are unique and in range [1, N*N].\"\"\"\n        seen_values = set()\n        expected_total_values = self._N * self._N\n        for r in range(self._N):\n            for c in range(self._N):\n                value = self._cells[r][c]\n                if not (1 <= value <= expected_total_values):\n                    return False\n                if value in seen_values:\n                    return False\n                seen_values.add(value)\n        return len(seen_values) == expected_total_values\n\n    def get_neighbors(self, row: int, col: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns coordinates of valid adjacent cells for a given (row, col).\"\"\"\n        current_cell = Cell(row, col, self._cells[row][col])\n        return current_cell.get_neighbors(self._N)\n\n    def get_cell_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the integer value of the cell at (row, col).\"\"\"\n        return self._cells[row][col]\n\n    def get_size(self) -> int:\n        \"\"\"Returns the dimension N of the N x N grid.\"\"\"\n        return self._N\n\nclass Path:\n    \"\"\"Represents a sequence of cell values forming a path.\"\"\"\n    def __init__(self):\n        self._values: List[int] = []\n        self._length = 0\n\n    def add_cell(self, value: int) -> None:\n        \"\"\"Appends a cell's value to the path sequence.\"\"\"\n        self._values.append(value)\n        self._length += 1\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return self._length\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the ordered list of cell values in the path.\"\"\"\n        return self._values\n\n    def compare_to(self, other: 'Path') -> int:\n        \"\"\"Compares this path lexicographically to another path.\"\"\"\n        for i in range(self._length):\n            if self._values[i] < other._values[i]:\n                return -1\n            elif self._values[i] > other._values[i]:\n                return 1\n        return 0\n\n    def copy(self) -> 'Path':\n        \"\"\"Creates a shallow copy of the path.\"\"\"\n        new_path = Path()\n        new_path._values = list(self._values)\n        new_path._length = self._length\n        return new_path\n\nclass PathFinder:\n    \"\"\"Implements the core pathfinding algorithm to find the minimum path.\"\"\"\n    def __init__(self, grid: 'Grid', k: int):\n        self._grid = grid\n        self._k = k\n        self._N = grid.get_size()\n        self._min_path: Optional[Path] = None\n\n    def find_minimum_path(self) -> List[int]:\n        \"\"\"Explores all possible paths to find the lexicographically smallest path.\"\"\"\n        for r in range(self._N):\n            for c in range(self._N):\n                self._explore_from_cell(r, c)\n        return self._min_path.get_values() if self._min_path else []\n\n    def _explore_from_cell(self, start_row: int, start_col: int) -> None:\n        \"\"\"Initiates path building from a specific starting cell.\"\"\"\n        initial_path = Path()\n        initial_value = self._grid.get_cell_value(start_row, start_col)\n        initial_path.add_cell(initial_value)\n\n        if self._k == 1:\n            if self._min_path is None or initial_path.compare_to(self._min_path) < 0:\n                self._min_path = initial_path.copy()\n            return\n\n        self._build_paths_recursive(initial_path, start_row, start_col, 1)\n\n    def _is_valid_move(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a given cell coordinate is within grid bounds.\"\"\"\n        return 0 <= row < self._N and 0 <= col < self._N\n\n    def _build_paths_recursive(self, current_path: 'Path', current_row: int, current_col: int, current_length: int) -> None:\n        \"\"\"Recursively builds paths of length k from the current position.\"\"\"\n        if current_length == self._k:\n            if self._min_path is None or current_path.compare_to(self._min_path) < 0:\n                self._min_path = current_path.copy()\n            return\n\n        neighbors = self._grid.get_neighbors(current_row, current_col)\n        for n_row, n_col in neighbors:\n            next_path = current_path.copy()\n            next_value = self._grid.get_cell_value(n_row, n_col)\n            next_path.add_cell(next_value)\n            self._build_paths_recursive(next_path, n_row, n_col, current_length + 1)\n\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically minimum path of length k in a grid.\n    Orchestrates grid validation and pathfinding using supporting classes.\n    \"\"\"\n    grid_obj = Grid(grid)\n\n    grid_obj.validate_dimensions()\n    grid_obj.validate_cell_values()\n\n    path_finder = PathFinder(grid_obj, k)\n    return path_finder.find_minimum_path()\n```"}
{"task_id": "HumanEval/131", "solution": "from typing import List\n\nclass InputValidator:\n    def validate_positive_integer(self, n: int) -> bool:\n        \"\"\"Validates if the input is a positive integer.\n        Returns True, trusting the caller's input based on critical requirements.\n        \"\"\"\n        # CRITICAL REQUIREMENT: Do NOT add isinstance() checks, type guards, or raise exceptions.\n        # Trust the caller's inputs as positive integers.\n        return True\n\nclass DigitAnalyzer:\n    def is_odd(self, digit: int) -> bool:\n        \"\"\"Checks if a digit is odd.\"\"\"\n        return digit % 2 == 1\n\n    def is_even(self, digit: int) -> bool:\n        \"\"\"Checks if a digit is even.\"\"\"\n        return digit % 2 == 0\n\nclass ProductCalculator:\n    def multiply(self, numbers: List[int]) -> int:\n        \"\"\"Calculates the product of a list of numbers.\"\"\"\n        result = 1\n        for num in numbers:\n            result *= num\n        return result\n\nclass DigitsProcessor:\n    \"\"\"Orchestrates the digit processing workflow.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.analyzer = DigitAnalyzer()\n        self.calculator = ProductCalculator()\n\n    def process_number(self, n: int) -> int:\n        \"\"\"Main processing workflow to find product of odd digits.\"\"\"\n        # The validation call is included as per design, but the logic handles trusted input.\n        # CRITICAL REQUIREMENT: Do NOT add isinstance() checks, type guards, or raise exceptions.\n        self.validator.validate_positive_integer(n)\n\n        digits = self.extract_digits(n)\n        odd_digits = [d for d in digits if self.analyzer.is_odd(d)]\n\n        if not odd_digits:\n            return 0\n\n        return self.calculator.multiply(odd_digits)\n\n    def extract_digits(self, n: int) -> List[int]:\n        \"\"\"Extracts individual digits from an integer.\"\"\"\n        return [int(digit) for digit in str(n)]\n\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    processor = DigitsProcessor()\n    return processor.process_number(n)"}
{"task_id": "HumanEval/131", "solution": "class Digit:\n    \"\"\"Represents a single digit with methods for classification.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the digit is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the digit is even.\"\"\"\n        return self._value % 2 == 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the digit.\"\"\"\n        return self._value\n\nclass DigitsProcessor:\n    \"\"\"Handles digit extraction and identification of odd digits.\"\"\"\n    def extract_digits(self, n: int) -> list[int]:\n        \"\"\"Extracts individual digits from a positive integer.\"\"\"\n        return [int(d) for d in str(n)]\n\n    def identify_odd_digits(self, digits_list: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers to return only the odd ones.\"\"\"\n        odd_digits = []\n        for d_value in digits_list:\n            digit_obj = Digit(d_value)\n            if digit_obj.is_odd():\n                odd_digits.append(digit_obj.get_value())\n        return odd_digits\n\nclass ProductCalculator:\n    \"\"\"Calculates the product of a list of integers.\"\"\"\n    def multiply(self, digits_list: list[int]) -> int:\n        \"\"\"Computes the product of all digits in the list.\"\"\"\n        if not digits_list:\n            return self.handle_empty_list()\n        \n        product = 1\n        for digit_val in digits_list:\n            product *= digit_val\n        return product\n\n    def handle_empty_list(self) -> int:\n        \"\"\"Returns 0 if the list of odd digits is empty.\"\"\"\n        return 0\n\ndef digits(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    processor = DigitsProcessor()\n    calculator = ProductCalculator()\n\n    extract