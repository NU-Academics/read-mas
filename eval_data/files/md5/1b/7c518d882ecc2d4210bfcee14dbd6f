{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    The function iteratively calculates triangular numbers until one with n digits is found.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_num = k * (k + 1) // 2\n        \n        # Determine the number of digits of triangular_num\n        num_digits = 0\n        if triangular_num == 0: # special case for 0\n            num_digits = 1\n        else:\n            num_digits = len(str(triangular_num))\n\n        if num_digits == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the first and the last bit.\n    Returns the original number if it has two or fewer bits.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    binary_str = bin(number)[2:]\n\n    if len(binary_str) <= 2:\n        return number\n\n    first_bit = binary_str[0]\n    last_bit = binary_str[-1]\n    middle_bits = binary_str[1:-1]\n\n    toggled_middle_bits = \"\".join(['1' if bit == '0' else '0' for bit in middle_bits])\n\n    result_binary_str = first_bit + toggled_middle_bits + last_bit\n    return int(result_binary_str, 2)"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(a: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron.\n    The formula used is sqrt(3) * a^2, where 'a' is the side length.\n    \"\"\"\n    return math.sqrt(3) * (a ** 2)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, n: int) -> list:\n    \"\"\"\n    Rotates a list by specified number of items to the right direction.\n    A new list is returned without modifying the original.\n    \"\"\"\n    if not input_list:\n        return []\n\n    list_length = len(input_list)\n    effective_n = n % list_length\n\n    if effective_n == 0:\n        return list(input_list)\n\n    rotated_list = input_list[-effective_n:] + input_list[:-effective_n]\n    return rotated_list"}
