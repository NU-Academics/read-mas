{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string, sub_string):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns a tuple (sub_string, start_index, end_index) if found, otherwise None.\n    \"\"\"\n    if not main_string or not sub_string:\n        return None\n    \n    start_index = main_string.find(sub_string)\n    \n    if start_index != -1:\n        end_index = start_index + len(sub_string)\n        return (sub_string, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple\n\ndef find_combinations(tuple_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds the element-wise sums of all unique pairs of tuples in the given list.\n    \"\"\"\n    if len(tuple_list) < 2:\n        return []\n\n    result_sums: List[Tuple[int, int]] = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result_sums.append(sum_tuple)\n    return result_sums"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\n\ndef find_sum(numbers):\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the given list.\n    \"\"\"\n    counts = Counter(numbers)\n    total_sum = 0\n    for item, count in counts.items():\n        if count == 1:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\n\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"Packs consecutive duplicates of list elements into sublists.\"\"\"\n    if not input_list:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_group: List[Any] = []\n\n    for item in input_list:\n        if not current_group or item == current_group[0]:\n            current_group.append(item)\n        else:\n            packed_list.append(current_group)\n            current_group = [item]\n    \n    if current_group:\n        packed_list.append(current_group)\n\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer n is even.\n    A number has an odd number of divisors if and only if it is a perfect square.\n    \"\"\"\n    sqrt_n = int(math.isqrt(n))\n    return sqrt_n * sqrt_n != n"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all elements across all odd-length contiguous subarrays.\"\"\"\n    total_sum = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate the length of the current subarray\n            subarray_length = j - i + 1\n            # Check if the length is odd\n            if subarray_length % 2 == 1:\n                # Sum elements of the odd-length subarray\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "from typing import Any, List\n\ndef right_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Locates the \"right\" insertion point for `value` in `sorted_list` using binary search.\n    Returns an index `i` such that all `e` in `sorted_list[:i]` satisfy `e <= value`, and all `e` in `sorted_list[i:]` satisfy `e > value`.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else:\n            low = mid + 1\n    return low"}
{"task_id": "Mbpp/787", "solution": "import re\n\ndef text_match_three(text):\n    \"\"\"\n    Checks if the input string contains 'a' followed by exactly three 'b's.\n    \"\"\"\n    return bool(re.search(r'a(bbb)', text))"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(data: tuple) -> tuple:\n    \"\"\"Removes all top-level nested tuples from the given tuple.\"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    \n    result = []\n    for item in data:\n        if not isinstance(item, tuple):\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"\n    Creates a new tuple from a list of items and a single string.\n    All list elements are converted to strings before forming the tuple.\n    \"\"\"\n    return tuple(str(item) for item in input_list) + (input_string,)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns 0 if either an even or an odd number is not found in the list.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None or first_even is None:\n        return 0\n    else:\n        return first_odd * first_even"}
{"task_id": "Mbpp/790", "solution": "def even_position(lst):\n    \"\"\"\n    Checks if every even index in the given list contains an even number.\n    Returns True if all elements at even indices are even, False otherwise.\n    \"\"\"\n    for i in range(len(lst)):\n        if i % 2 == 0:  # Check if the index is even\n            if lst[i] % 2 != 0:  # Check if the number at the even index is odd\n                return False\n    return True"}
{"task_id": "Mbpp/792", "solution": "from typing import Any\n\ndef count_list(input_list: list[Any]) -> int:\n    \"\"\"\n    Counts the number of direct sub-lists within the given input_list.\n    \"\"\"\n    count = 0\n    for item in input_list:\n        if isinstance(item, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/793", "solution": "```python\ndef last(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the last position (highest index) of an element in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    last_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            last_index = mid\n            low = mid + 1  # Try to find a further occurrence in the right half\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return last_index\n```"}
