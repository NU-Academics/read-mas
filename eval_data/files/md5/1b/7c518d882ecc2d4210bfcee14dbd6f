{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data_list):\n    \"\"\"\n    Flattens a list and sums all its numeric elements recursively.\n    Non-numeric and non-list elements are ignored.\n    \"\"\"\n    total_sum = 0\n    for element in data_list:\n        if isinstance(element, (int, float)):\n            total_sum += element\n        elif isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n    return total_sum"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic.\n    An array is monotonic if it is either entirely non-increasing or entirely non-decreasing.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    def _is_non_decreasing(arr: list) -> bool:\n        \"\"\"Checks if the array is monotonically non-decreasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr: list) -> bool:\n        \"\"\"Checks if the array is monotonically non-increasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n        \n    return _is_non_decreasing(array) or _is_non_increasing(array)"}
