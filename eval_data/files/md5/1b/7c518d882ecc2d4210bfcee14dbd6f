{"task_id": "Mbpp/103", "solution": "import functools\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to Eulerian number calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n@functools.lru_cache(maxsize=None)\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    Uses a recursive definition with memoization.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(m, int) or n < 0 or m < 0:\n        raise InvalidInputError(\"Invalid input: n and m must be non-negative integers.\")\n\n    # Base case BR4: a(0, 0) = 1\n    if n == 0 and m == 0:\n        return 1\n\n    # Base case BR3: a(n, 0) = 1 for n >= 0. (Handles m=0 for n > 0 as (0,0) is handled)\n    if m == 0:\n        return 1\n\n    # Base case BR2: a(n, m) = 0 if m >= n (for n > 0)\n    # This also implicitly handles a(0, m) for m > 0 (e.g., a(0, 1) where m>=n is true).\n    if m >= n:\n        return 0\n\n    # Recursive formula BR5: a(n, m) = (m + 1) * a(n-1, m) + (n - m) * a(n-1, m-1)\n    # for n > 0, 0 < m < n.\n    return (m + 1) * eulerian_num(n - 1, m) + \\\n           (n - m) * eulerian_num(n - 1, m - 1)"}
{"task_id": "Mbpp/109", "solution": "import collections\n\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n    \"\"\"\n    # No isinstance checks or exception raising as per instructions.\n    # We trust that binary_string is valid and rotations is a non-negative integer.\n\n    odd_count = 0\n    if not binary_string: # An empty string always represents 0, which is even.\n        return 0\n\n    # Using deque for efficient rotations (O(1) for rotate, O(N) for init)\n    # This is more efficient than string slicing (O(N) for each rotation)\n    current_deque = collections.deque(binary_string)\n\n    for _ in range(rotations):\n        # A binary number is odd if its least significant bit (rightmost digit) is '1'.\n        if current_deque[-1] == '1':\n            odd_count += 1\n        \n        # Rotate the string: move the leftmost character to the rightmost position.\n        current_deque.rotate(-1) # Rotates left by 1 (moves first element to last)\n        \n    return odd_count"}
