{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(main_string, dirty_chars):\n    \"\"\"\n    Removes characters from the main_string that are present in dirty_chars.\n    \"\"\"\n    if not dirty_chars:\n        return main_string\n    if not main_string:\n        return \"\"\n\n    dirty_set = set(dirty_chars)\n    cleaned_chars = [char for char in main_string if char not in dirty_set]\n    return \"\".join(cleaned_chars)"}
{"task_id": "Mbpp/56", "solution": "def _reverse_number(n: int) -> int:\n    \"\"\"Reverses an integer, handling its sign.\"\"\"\n    if n == 0:\n        return 0\n    \n    sign = -1 if n < 0 else 1\n    abs_n = abs(n)\n    reversed_abs_n = 0\n    \n    while abs_n > 0:\n        digit = abs_n % 10\n        reversed_abs_n = reversed_abs_n * 10 + digit\n        abs_n //= 10\n            \n    return sign * reversed_abs_n\n\ndef check(n: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\"\"\"\n    reversed_n = _reverse_number(n)\n    return n == (2 * reversed_n) - 1"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the provided number is a Woodall number.\n    A Woodall number W_n is defined as n * 2^n - 1 for n >= 1.\n    \"\"\"\n    if number == 1:\n        return True\n\n    n = 1\n    while True:\n        candidate_woodall = n * (2**n) - 1\n        \n        if candidate_woodall == number:\n            return True\n        \n        if candidate_woodall > number:\n            return False\n        \n        n += 1"}
