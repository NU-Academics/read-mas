{"task_id": "Mbpp/427", "solution": "from datetime import datetime\n\nclass InvalidDateFormatError(ValueError):\n    \"\"\"\n    Custom exception raised when a date string does not match the expected format.\n    \"\"\"\n    pass\n\ndef change_date_format(date_string: str) -> str:\n    \"\"\"\n    Converts a date string from \"yyyy-mm-dd\" to \"dd-mm-yyyy\" format.\n    Raises InvalidDateFormatError if the input date_string is invalid.\n    \"\"\"\n    INPUT_DATE_FORMAT = \"%Y-%m-%d\"\n    OUTPUT_DATE_FORMAT = \"%d-%m-%Y\"\n    try:\n        date_object = datetime.strptime(date_string, INPUT_DATE_FORMAT)\n        return date_object.strftime(OUTPUT_DATE_FORMAT)\n    except ValueError as e:\n        raise InvalidDateFormatError(\n            f\"Invalid date format: {date_string}. Expected yyyy-mm-dd. Details: {e}\"\n        ) from e"}
{"task_id": "Mbpp/428", "solution": "from typing import List\n\ndef shell_sort(arr: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers in-place using the Shell Sort algorithm.\n    It uses a decreasing gap sequence to perform insertion sort on sub-lists.\n    \"\"\"\n    n = len(arr)\n    gap = n // 2\n\n    while gap > 0:\n        for i in range(gap, n):\n            # Perform gapped insertion sort for current gap size\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n    return arr"}
{"task_id": "Mbpp/429", "solution": "from typing import Tuple\n\nclass TupleValidator:\n    @staticmethod\n    def validate_tuple_inputs(tuple1: Tuple, tuple2: Tuple) -> None:\n        \"\"\"Validates that both inputs are tuples and have the same length.\"\"\"\n        if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n            raise TypeError(\"Both inputs must be tuples.\")\n        if len(tuple1) != len(tuple2):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    @staticmethod\n    def validate_tuple_elements(input_tuple: Tuple) -> None:\n        \"\"\"Validates that all elements within a given tuple are integers.\"\"\"\n        for element in input_tuple:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the tuple must be integers.\")\n\ndef and_tuples(tuple1: Tuple[int, ...], tuple2: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Computes the element-wise bitwise AND of two input tuples.\n    This function validates inputs for type and length before performing the operation.\n    \"\"\"\n    TupleValidator.validate_tuple_inputs(tuple1, tuple2)\n    TupleValidator.validate_tuple_elements(tuple1)\n    TupleValidator.validate_tuple_elements(tuple2)\n\n    result = tuple(a & b for a, b in zip(tuple1, tuple2))\n    return result"}
