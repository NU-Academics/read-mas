{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(number):\n    \"\"\"\n    Checks if the given integer is a prime number.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n\n    # Check for divisibility by odd numbers from 3 up to the square root of 'number'\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/603", "solution": "class PrimeGenerator:\n    def generate_primes_up_to(self, limit: int) -> list[int]:\n        if limit < 2:\n            return []\n        \n        is_prime = [True] * (limit + 1)\n        is_prime[0] = is_prime[1] = False\n        \n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime[multiple] = False\n                    \n        primes = [p for p, prime_status in enumerate(is_prime) if prime_status]\n        return primes\n\nclass LudicService:\n    def __init__(self, prime_generator: PrimeGenerator):\n        self._prime_generator = prime_generator\n\n    def get_ludic_numbers(self, n: int) -> list[int]:\n        if n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n        \n        if n == 1:\n            return [1]\n        \n        lucid_numbers = [1]\n        primes = self._prime_generator.generate_primes_up_to(n)\n        lucid_numbers.extend(primes)\n        \n        return sorted(list(set(lucid_numbers)))\n\ndef get_ludic(n: int) -> list[int]:\n    prime_generator_instance = PrimeGenerator()\n    ludic_service_instance = LudicService(prime_generator_instance)\n    return ludic_service_instance.get_ludic_numbers(n)"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches the text for the first occurrence of the pattern (regular expression).\n    Returns the matching substring, its start index, and its end index, or None if no match.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return match.group(0), match.start(), match.end()\n    return None"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k-th (1-indexed) element removed.\n    Raises IndexError if k is out of the valid range (1 to len(input_list)).\n    \"\"\"\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(f\"k ({k}) is out of bounds for list of length {len(input_list)}\")\n\n    index_to_remove = k - 1\n    return input_list[:index_to_remove] + input_list[index_to_remove + 1:]"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming based on Stirling numbers of the second kind.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # dp[i][j] stores the Stirling number of the second kind S(i, j)\n    # S(i, j) is the number of ways to partition a set of i elements into j non-empty subsets.\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base cases for Stirling numbers\n    dp[0][0] = 1 # S(0,0) is 1 for Bell number calculation (B_0 = S(0,0)=1)\n    for i in range(1, n + 1):\n        dp[i][0] = 0 # S(i, 0) = 0 for i > 0\n        dp[i][1] = 1 # S(i, 1) = 1\n        dp[i][i] = 1 # S(i, i) = 1\n\n    # Fill the DP table using the recurrence relation\n    # S(i, j) = S(i - 1, j - 1) + j * S(i - 1, j)\n    for i in range(2, n + 1):\n        for j in range(2, i + 1):\n            dp[i][j] = dp[i - 1][j - 1] + j * dp[i - 1][j]\n\n    # The nth Bell number is the sum of S(n, k) for k from 0 to n\n    bell_n = sum(dp[n][k] for k in range(n + 1))\n    return bell_n"}
{"task_id": "Mbpp/612", "solution": "from typing import List, Any\n\ndef merge(data: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Takes a list of two-element sublists and returns a list of two lists,\n    where the first list contains all first elements and the second list\n    contains all second elements from the input sublists.\n    \"\"\"\n    first_elements: List[Any] = []\n    second_elements: List[Any] = []\n\n    for sublist in data:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
