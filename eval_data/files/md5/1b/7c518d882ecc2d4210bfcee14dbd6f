{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_list = []\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        \n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = sublist\n            \n    return max_list"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Union\n\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if any number is zero or an even integer (including integer-like floats).\n    \"\"\"\n    if not numbers:\n        return False\n\n    for num in numbers:\n        # If any number is 0, the product is 0, which is even.\n        if num == 0:\n            return True\n        \n        # Check if the number is an integer or an integer-like float (e.g., 2.0)\n        # and if that integer value is even.\n        if num == int(num) and int(num) % 2 == 0:\n            return True\n            \n    # If the loop completes, no even number or zero was found, so the product is not even.\n    return False"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than\n    its corresponding element in the first tuple.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
