{"task_id": "Mbpp/129", "solution": "from typing import List, Union\n\nclass InvalidMatrixError(Exception):\n    \"\"\"Custom exception for invalid matrix input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef _is_square_matrix(matrix: List[List[Union[int, float]]]) -> int:\n    \"\"\"Checks if the input matrix is a valid square matrix.\"\"\"\n    if not isinstance(matrix, list):\n        raise InvalidMatrixError(\"Input must be a list of lists.\")\n    \n    if not matrix:\n        raise InvalidMatrixError(\"Matrix cannot be empty.\")\n\n    size = len(matrix)\n\n    for row in matrix:\n        if not isinstance(row, list) or len(row) != size:\n            raise InvalidMatrixError(\"Matrix must be square and have uniform row lengths.\")\n        for element in row:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"Matrix elements must be numeric.\")\n    return size\n\ndef _get_row_sums(matrix: List[List[Union[int, float]]], size: int) -> List[Union[int, float]]:\n    \"\"\"Calculates the sum of elements for each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef _get_col_sums(matrix: List[List[Union[int, float]]], size: int) -> List[Union[int, float]]:\n    \"\"\"Calculates the sum of elements for each column in the matrix.\"\"\"\n    col_sums = [0] * size\n    for r in range(size):\n        for c in range(size):\n            col_sums[c] += matrix[r][c]\n    return col_sums\n\ndef _get_main_diagonal_sum(matrix: List[List[Union[int, float]]], size: int) -> Union[int, float]:\n    \"\"\"Calculates the sum of elements along the main diagonal.\"\"\"\n    return sum(matrix[i][i] for i in range(size))\n\ndef _get_anti_diagonal_sum(matrix: List[List[Union[int, float]]], size: int) -> Union[int, float]:\n    \"\"\"Calculates the sum of elements along the anti-diagonal.\"\"\"\n    return sum(matrix[i][size - 1 - i] for i in range(size))\n\ndef magic_square_test(matrix: List[List[Union[int, float]]]) -> bool:\n    \"\"\"\n    Determines if the given matrix is a magic square.\n    A magic square is a square matrix where the sum of numbers in each row,\n    each column, and both main diagonals are equal.\n    \"\"\"\n    try:\n        size = _is_square_matrix(matrix)\n    except (InvalidMatrixError, TypeError):\n        return False\n\n    if size == 0:\n        return False\n    if size == 1:\n        return True\n\n    expected_sum = sum(matrix[0])\n\n    row_sums = _get_row_sums(matrix, size)\n    if any(s != expected_sum for s in row_sums):\n        return False\n\n    col_sums = _get_col_sums(matrix, size)\n    if any(s != expected_sum for s in col_sums):\n        return False\n\n    main_diag_sum = _get_main_diagonal_sum(matrix, size)\n    if main_diag_sum != expected_sum:\n        return False\n\n    anti_diag_sum = _get_anti_diagonal_sum(matrix, size)\n    if anti_diag_sum != expected_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/140", "solution": "from typing import List, Iterable, Set\n\ndef extract_singly(nested_list: List[Iterable[int]]) -> Set[int]:\n    \"\"\"\n    Flattens a list of iterables into a single set of unique numbers.\n\n    Args:\n        nested_list: A list where each element is an iterable (e.g., tuple, list)\n                     containing integers.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in nested_list:\n        for number in inner_iterable:\n            result_set.add(number)\n    return result_set"}
