{"task_id": "Mbpp/440", "solution": "import nltk\nfrom nltk.tokenize import word_tokenize\nfrom nltk.tag import pos_tag\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass AdverbMatch:\n    \"\"\"\n    Represents a found adverb with its position in the sentence.\n    \"\"\"\n    start: int  # Starting character index (inclusive)\n    end: int    # Ending character index (exclusive)\n    word: str   # The adverb word found\n\nclass TextProcessor:\n    \"\"\"\n    Utility class for text tokenization and Part-of-Speech tagging.\n    \"\"\"\n    NLTK_ADVERB_TAGS = {'RB', 'RBR', 'RBS'} # RB: Adverb, RBR: Adverb, comparative, RBS: Adverb, superlative\n\n    def __init__(self):\n        try:\n            nltk.data.find('tokenizers/punkt')\n        except nltk.downloader.DownloadError:\n            nltk.download('punkt')\n        try:\n            nltk.data.find('taggers/averaged_perceptron_tagger')\n        except nltk.downloader.DownloadError:\n            nltk.download('averaged_perceptron_tagger')\n\n    def tokenize_and_tag(self, text: str) -> list[tuple[str, str, int, int]]:\n        \"\"\"\n        Tokenizes the text and performs POS tagging, including original positions.\n        Returns a list of (word, tag, start_index, end_index) tuples.\n        \"\"\"\n        tokens = word_tokenize(text)\n        tagged_tokens = pos_tag(tokens)\n\n        results = []\n        current_pos = 0\n        for word, tag in tagged_tokens:\n            start_index = text.find(word, current_pos)\n            if start_index == -1:\n                # Basic fallback for words not found directly (e.g., due to NLTK tokenization nuances)\n                clean_word = \"\".join(filter(str.isalnum, word)) # Remove non-alphanumeric to find base word\n                if clean_word:\n                    start_index = text.find(clean_word, current_pos)\n                    if start_index != -1:\n                        # Adjust start_index back to original word's start, including leading punctuation\n                        # This is a heuristic and might not be perfect for all cases\n                        actual_word_start = start_index - (word.find(clean_word))\n                        if actual_word_start < current_pos or actual_word_start > start_index: # Prevent going backwards or too far\n                             actual_word_start = start_index\n                        start_index = actual_word_start\n                        \n                    else: # If even cleaned word isn't found, advance and skip\n                        current_pos += len(word) + 1 # +1 for potential space\n                        continue\n                else: # If word is purely punctuation, find it\n                    start_index = text.find(word, current_pos)\n                    if start_index == -1:\n                        current_pos += len(word) + 1\n                        continue\n\n\n            end_index = start_index + len(word)\n            results.append((word, tag, start_index, end_index))\n            current_pos = end_index\n        return results\n\nclass AdverbFinder:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    \"\"\"\n    def __init__(self, text_processor: TextProcessor):\n        self.text_processor = text_processor\n\n    def find_adverb_position(self, sentence: str) -> AdverbMatch | None:\n        if not sentence:\n            return None\n\n        tagged_tokens = self.text_processor.tokenize_and_tag(sentence)\n\n        for word, tag, start, end in tagged_tokens:\n            if tag in self.text_processor.NLTK_ADVERB_TAGS:\n                return AdverbMatch(start=start, end=end, word=word)\n        return None\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    \"\"\"\n    # Instantiate TextProcessor and AdverbFinder as per design\n    # These should ideally be singleton or passed around, but for a simple function,\n    # instantiating here is acceptable given the context.\n    text_processor = TextProcessor()\n    adverb_finder = AdverbFinder(text_processor)\n\n    adverb_match = adverb_finder.find_adverb_position(sentence)\n\n    if adverb_match:\n        return (adverb_match.start, adverb_match.end, adverb_match.word)\n    return None"}
