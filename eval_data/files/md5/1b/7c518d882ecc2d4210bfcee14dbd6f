{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given integer is an undulating number.\n    An undulating number has digits that strictly alternate (A B A B...).\n    \"\"\"\n    if number < 0:\n        return False\n\n    if number == 0:\n        digits = [0]\n    else:\n        digits = []\n        temp_num = number\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        digits.reverse()\n\n    n = len(digits)\n\n    if n < 2:\n        return False\n\n    # Check for A B A B pattern: digits[i] != digits[i+1] and digits[i] == digits[i+2]\n    for i in range(n - 1):\n        if digits[i] == digits[i+1]:\n            return False # Adjacent digits must be different.\n        \n        # Only check the alternating digit if it exists.\n        # This condition is implicitly handled if the loop range is n-2 and the check is at n-3.\n        # But if the loop goes up to n-1 (like here), the i+2 check needs protection.\n        if i + 2 < n:\n            if digits[i] != digits[i+2]:\n                return False # Alternating digits must be the same.\n    \n    return True"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n):\n    \"\"\"\n    Calculates the number of positive divisors for a given positive integer.\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to sqrt(n)\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            if i * i == n:\n                # If i is the square root, count it once\n                count += 1\n            else:\n                # Otherwise, count i and n/i as distinct divisors\n                count += 2\n    return count"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data: list[tuple]) -> any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes the input list is not empty and contains valid tuples with at least two elements.\n    \"\"\"\n    min_value = data[0][1]\n    result_item = data[0][0]\n\n    for item_tuple in data[1:]:\n        current_item = item_tuple[0]\n        current_val = item_tuple[1]\n\n        if current_val < min_value:\n            min_value = current_val\n            result_item = current_item\n            \n    return result_item"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list of lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_len = float('inf')\n    for sublist in list_of_lists:\n        min_len = min(min_len, len(sublist))\n    \n    return int(min_len)"}
