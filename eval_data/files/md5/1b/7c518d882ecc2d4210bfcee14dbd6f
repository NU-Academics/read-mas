{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    def _is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by all its non-zero digits.\"\"\"\n        if number == 0:\n            return False  \n        \n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit == 0:\n                return False  \n            if number % digit != 0:\n                return False\n            temp_num //= 10\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_all_digits(num):\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate only up to the last parent node\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the Nth Jacobsthal number using an iterative approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # J(0), J(1)\n        for _ in range(2, n + 1):\n            a, b = b, a + 2 * b\n        return b"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists at the same index.\n    The comparison proceeds up to the length of the shortest list.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
