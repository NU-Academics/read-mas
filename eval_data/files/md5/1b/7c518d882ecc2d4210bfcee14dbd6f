{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers, n):\n    # Validate inputs according to the design context.\n    if not numbers:\n        raise ValueError(\"Input list 'numbers' cannot be empty.\")\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Parameter 'n' must be a positive integer.\")\n    if n > len(numbers):\n        raise ValueError(\"Parameter 'n' cannot be greater than the length of the 'numbers' list.\")\n\n    # Use a min-heap to keep track of the n largest elements.\n    min_heap = []\n    for number in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, number)\n        elif number > min_heap[0]:\n            heapq.heapreplace(min_heap, number)\n    \n    # The heap now contains the n largest elements; sort them in descending order.\n    result = sorted(min_heap, reverse=True)\n    return result"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(number):\n    # Numbers less than or equal to 1 are neither prime nor composite.\n    if number <= 1:\n        return False\n    # 2 and 3 are prime numbers.\n    if number <= 3:\n        return False\n    # Check for divisibility by 2 or 3.\n    if number % 2 == 0 or number % 3 == 0:\n        return True\n\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return True\n        i += 6\n    return False"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(text: str) -> set[str]:\n    \"\"\"\n    Finds all unique words in a string that are at least 4 characters long.\n    Words are split by whitespace, and punctuation is considered part of the word.\n    \"\"\"\n    MIN_WORD_LENGTH = 4\n    \n    if not text:\n        return set()\n    \n    words = text.split()\n    long_words = set()\n    for word in words:\n        if len(word) >= MIN_WORD_LENGTH:\n            long_words.add(word)\n    return long_words"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(text, char_to_remove):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character appears only once, that single occurrence is removed.\n    \"\"\"\n    first_idx = text.find(char_to_remove)\n    if first_idx == -1:\n        return text\n\n    last_idx = text.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        # Only one occurrence\n        return text[:first_idx] + text[first_idx + 1:]\n    else:\n        # Remove first occurrence\n        temp_text = text[:first_idx] + text[first_idx + 1:]\n        # Find the last occurrence in the modified string and remove it\n        adjusted_last_idx = temp_text.rfind(char_to_remove)\n        return temp_text[:adjusted_last_idx] + temp_text[adjusted_last_idx + 1:]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is true if their XOR result is a power of two.\n    \"\"\"\n    xor_result = num1 ^ num2\n    # Check if xor_result has exactly one bit set (is a power of 2 and not zero).\n    return xor_result > 0 and (xor_result & (xor_result - 1) == 0)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive number of rotations required to get the same string.\n    \"\"\"\n    def _rotate_string(s_val: str, num_rotations: int) -> str:\n        \"\"\"Rotates a string to the left by num_rotations.\"\"\"\n        n_val = len(s_val)\n        if n_val == 0:\n            return \"\"\n        actual_rotations = num_rotations % n_val\n        return s_val[actual_rotations:] + s_val[:actual_rotations]\n\n    n = len(s)\n    # The problem implies non-empty strings by \"rotations (greater than 0)\".\n    # For an empty string, the loop range(1, 1) would be empty, and this code path\n    # would not return a value. Based on the problem's context and examples,\n    # we assume 's' is always a non-empty string.\n    if n == 1:\n        return 1\n\n    for i in range(1, n + 1):\n        rotated_s = _rotate_string(s, i)\n        if rotated_s == s:\n            return i"}
