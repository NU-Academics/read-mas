{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"Removes consecutive duplicates from a list, returning a new list.\"\"\"\n    if not input_list:\n        return []\n\n    result_list = [input_list[0]]\n    for item in input_list[1:]:\n        if item != result_list[-1]:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Tuple, Optional\n\nclass Path:\n    \"\"\"Represents a path in the matrix, tracking its cells, total cost, and count.\"\"\"\n    def __init__(self, cells: Optional[List[Tuple[int, int]]] = None, total_cost: int = 0) -> None:\n        self._cells: List[Tuple[int, int]] = list(cells) if cells is not None else []\n        self._total_cost: int = total_cost\n        self._num_cells: int = len(self._cells)\n\n    def add_cell(self, row: int, col: int, cost: int) -> None:\n        \"\"\"Adds a new cell to the path and updates its total cost and cell count.\"\"\"\n        self._cells.append((row, col))\n        self._total_cost += cost\n        self._num_cells += 1\n\n    def get_average(self) -> float:\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        if self._num_cells == 0:\n            return 0.0\n        return self._total_cost / self._num_cells\n\n    def get_total_cost(self) -> int:\n        \"\"\"Returns the total cost of the path.\"\"\"\n        return self._total_cost\n\n    def get_num_cells(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return self._num_cells\n\nclass PathFinderService:\n    \"\"\"Encapsulates the core algorithm for finding paths and their maximum average.\"\"\"\n    def __init__(self) -> None:\n        self._matrix: List[List[int]] = []\n        self._N: int = 0\n\n    def find_max_average_path(self, matrix: List[List[int]]) -> float:\n        \"\"\"Initializes the path-finding process and orchestrates the recursive traversal.\"\"\"\n        self._matrix = matrix\n        self._N = len(matrix)\n        max_avg: List[float] = [0.0] # Use a list to pass by reference for mutable update\n\n        # Start path from (0,0) with the cost of the first cell\n        initial_path = Path()\n        initial_path.add_cell(0, 0, self._matrix[0][0])\n\n        self._traverse_paths(0, 0, initial_path, max_avg)\n        return max_avg[0]\n\n    def _traverse_paths(self, row: int, col: int, current_path: Path, max_avg: List[float]) -> None:\n        \"\"\"Recursively explores all valid paths from a given cell to the bottom-right.\"\"\"\n        # If we reached the bottom-right cell, update max_avg if the current path's average is greater.\n        if row == self._N - 1 and col == self._N - 1:\n            current_average = current_path.get_average()\n            if current_average > max_avg[0]:\n                max_avg[0] = current_average\n            return\n\n        # Move right: if not out of bounds, create a new path copy and recurse.\n        if col + 1 < self._N:\n            next_path_right = Path(current_path._cells, current_path._total_cost)\n            next_path_right.add_cell(row, col + 1, self._matrix[row][col + 1])\n            self._traverse_paths(row, col + 1, next_path_right, max_avg)\n\n        # Move down: if not out of bounds, create a new path copy and recurse.\n        if row + 1 < self._N:\n            next_path_down = Path(current_path._cells, current_path._total_cost)\n            next_path_down.add_cell(row + 1, col, self._matrix[row + 1][col])\n            self._traverse_paths(row + 1, col, next_path_down, max_avg)\n\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down, that has the maximum average cost.\n    \"\"\"\n    service = PathFinderService()\n    return service.find_max_average_path(matrix)"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The formula used is A = pi * r * l, where l is the slant height (sqrt(r^2 + h^2)).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(data_list: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible sublists of a given list.\n    \"\"\"\n    total_sum = 0\n    n = len(data_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= data_list[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[int | float], target: int | float) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in sorted order.\n\n    This function returns an index i such that all e in sorted_list[0:i] have e < target,\n    and all e in sorted_list[i:] have e >= target.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
