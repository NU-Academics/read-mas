{"task_id": "Mbpp/794", "solution": "import re\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', followed by any characters, and ends in 'b'.\n    Uses re.fullmatch to ensure the entire string matches the pattern.\n    \"\"\"\n    pattern = r\"^a.*b$\"\n    return re.fullmatch(pattern, text) is not None"}
{"task_id": "Mbpp/799", "solution": "BITS_IN_INT = 32\n\ndef left_rotate(number: int, d_bits: int) -> int:\n    \"\"\"Rotates the bits of a 32-bit unsigned integer to the left by d_bits positions.\n    The result is masked to ensure it remains a 32-bit unsigned integer.\n    \"\"\"\n    d_bits = d_bits % BITS_IN_INT\n    return ((number << d_bits) | (number >> (BITS_IN_INT - d_bits))) & 0xFFFFFFFF"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(num1, num2, num3):\n    \"\"\"Counts the number of equal values among three given integers.\"\"\"\n    if num1 == num2 == num3:\n        return 3\n    elif num1 == num2 or num1 == num3 or num2 == num3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/797", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Provides utility methods for validating input parameters.\"\"\"\n    @staticmethod\n    def validate_range_inputs(l: int, r: int) -> None:\n        \"\"\"\n        Validates that l and r are integers, l <= r, and both are natural numbers (>= 1).\n\n        Raises:\n            InvalidInputError: If any validation rule is violated.\n        \"\"\"\n        if not isinstance(l, int) or not isinstance(r, int):\n            raise InvalidInputError(\"Inputs 'l' and 'r' must be integers.\")\n        if l > r:\n            raise InvalidInputError(\"Lower bound 'l' cannot be greater than upper bound 'r'.\")\n        if l < 1 or r < 1:\n            raise InvalidInputError(\"Both 'l' and 'r' must be natural numbers (>= 1).\")\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n\n    Raises:\n        InvalidInputError: If l or r are invalid according to InputValidator.\n    \"\"\"\n    InputValidator.validate_range_inputs(l, r)\n\n    total_sum = 0\n    # Start from l, go up to r (inclusive)\n    for num in range(l, r + 1):\n        if num % 2 != 0:  # Check if the number is odd\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if the given integer is a perfect square.\"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    sqrt_int = math.isqrt(number)\n    return sqrt_int * sqrt_int == number"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual integer tuple.\n\n    Args:\n        tuple_string: The input string, e.g., \"(1, 2, 3)\", \"()\", \"(5,)\".\n\n    Returns:\n        A tuple of integers.\n\n    Raises:\n        ValueError: If the input string is not a valid integer tuple string.\n    \"\"\"\n    if not tuple_string.startswith('(') or not tuple_string.endswith(')'):\n        raise ValueError(\"Input string must be enclosed in parentheses.\")\n    \n    content = tuple_string[1:-1].strip()\n    \n    if not content:\n        return ()\n    \n    parts = content.split(',')\n    final_elements = []\n    \n    for i, part in enumerate(parts):\n        stripped_part = part.strip()\n        \n        # This condition specifically handles the case of a single-element tuple with a trailing comma,\n        # e.g., \"(5,)\" where content.split(',') results in ['5', '']. The second empty part is ignored.\n        # All other empty parts (e.g., from \"(1, , 3)\" or \"(1, 2, )\") will fall through to the try-except block\n        # and raise a ValueError as required by the design.\n        if stripped_part == '' and len(parts) == 2 and i == 1:\n            continue\n        \n        try:\n            final_elements.append(int(stripped_part))\n        except ValueError:\n            raise ValueError(f\"Invalid tuple string: '{stripped_part}' is not a valid integer.\")\n            \n    return tuple(final_elements)"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Returns None if no odd numbers are found.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase English alphabet characters in a string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
