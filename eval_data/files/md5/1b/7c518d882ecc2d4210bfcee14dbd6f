{"task_id": "Mbpp/414", "solution": "from typing import Sequence\n\ndef overlapping(sequence1: Sequence, sequence2: Sequence) -> bool:\n    \"\"\"\n    Checks if any element from sequence1 exists in sequence2.\n    Optimizes performance by converting the smaller sequence to a set for efficient lookups.\n    \"\"\"\n    if not sequence1 or not sequence2:\n        return False\n\n    # Convert the smaller sequence to a set for O(1) average time complexity lookups.\n    if len(sequence1) <= len(sequence2):\n        set1 = set(sequence1)\n        for item in sequence2:\n            if item in set1:\n                return True\n    else:\n        set2 = set(sequence2)\n        for item in sequence1:\n            if item in set2:\n                return True\n    return False"}
{"task_id": "Mbpp/410", "solution": "from typing import List, Union\n\ndef min_val(data_list: List[any]) -> Union[int, float, None]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Returns the minimum integer or float found, or None if no numeric values are present.\n    \"\"\"\n    numeric_values = [item for item in data_list if isinstance(item, (int, float))]\n\n    if not numeric_values:\n        return None\n    \n    return min(numeric_values)"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(data: list[tuple[int | float, int | float]]) -> int | float | None:\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n    Assumes valid input: a list of tuples, each containing two numeric values.\n    \"\"\"\n    if not data:\n        return None\n\n    products = []\n    for item in data:\n        # Assumes item is a tuple of two numbers based on prompt's instruction\n        product = item[0] * item[1]\n        products.append(product)\n\n    return min(products)"}
