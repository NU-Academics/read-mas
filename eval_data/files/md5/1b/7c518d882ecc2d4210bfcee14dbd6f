{"task_id": "Mbpp/392", "solution": "from functools import lru_cache\n\n@lru_cache(maxsize=None)\ndef get_max_sum(n):\n    \"\"\"\n    Calculates the maximum sum for n using the recursive formula\n    f(n) = max((f(n//2) + f(n//3) + f(n//4) + f(n//5)), n).\n    Memoization is used to optimize performance.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    sum_of_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    return max(sum_of_parts, n)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits of each number in a list and returns their total sum.\n    Handles negative numbers by summing the digits of their absolute value.\n    \"\"\"\n    total_aggregate_sum = 0\n    for num in numbers:\n        current_num_digit_sum = 0\n        # Convert number to string to iterate over digits, using absolute value to handle negatives.\n        num_str = str(abs(num))\n        for digit_char in num_str:\n            current_num_digit_sum += int(digit_char)\n        \n        total_aggregate_sum += current_num_digit_sum\n    return total_aggregate_sum"}
