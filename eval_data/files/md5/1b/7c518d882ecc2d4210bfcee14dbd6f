{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded up to the next integer.\n    Uses the standard wind chill formula or returns temperature if conditions are not met.\n    \"\"\"\n    MIN_WIND_VELOCITY_KMH = 4.8\n    MAX_TEMP_CELSIUS = 10.0\n\n    if temperature > MAX_TEMP_CELSIUS or velocity < MIN_WIND_VELOCITY_KMH:\n        return math.ceil(temperature)\n\n    # Standard wind chill formula for Celsius and km/h.\n    # WCI = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    wind_chill_raw = (\n        13.12\n        + (0.6215 * temperature)\n        - (11.37 * (velocity**0.16))\n        + (0.3965 * temperature * (velocity**0.16))\n    )\n    return math.ceil(wind_chill_raw)"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    Uses a bitwise approach to efficiently sum contributions from each bit position.\n    \"\"\"\n    total_xor_sum = 0\n    MAX_BITS = 31 # Represents the maximum number of bits to consider for integers.\n\n    if n < 2:\n        return 0\n\n    for i in range(MAX_BITS):\n        count_set_bit = 0\n        count_unset_bit = 0\n        for num in numbers:\n            if (num >> i) & 1:  # Check if the i-th bit is set\n                count_set_bit += 1\n            else:\n                count_unset_bit += 1\n            \n        # Each pair of numbers with one bit set and one unset at position 'i' contributes (1 << i) to the XOR sum.\n        # The total contribution for this bit position is the product of set and unset counts times (1 << i).\n        total_xor_sum += (count_set_bit * count_unset_bit) * (1 << i)\n        \n    return total_xor_sum"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of the word.\n\n    Args:\n        text: The input string to check.\n\n    Returns:\n        True if 'z' is found in the middle of the string, False otherwise.\n\n    Raises:\n        TypeError: If the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if len(text) < 3:\n        return False\n\n    return 'z' in text[1:-1]"}
