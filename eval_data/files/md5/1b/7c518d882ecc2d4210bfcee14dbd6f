{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    Non-positive numbers are ignored.\n    \"\"\"\n    # Filter out non-positive numbers as per FR4, assuming all elements are integers.\n    filtered_numbers = [num for num in numbers if num > 0]\n\n    if not filtered_numbers:\n        return 0\n\n    # Sort the numbers to simplify divisibility checks, as per design context.\n    filtered_numbers.sort()\n    n = len(filtered_numbers)\n\n    # dp[i] stores the size of the largest divisible subset ending with filtered_numbers[i].\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            # If filtered_numbers[i] is divisible by filtered_numbers[j],\n            # it can extend the subset ending at filtered_numbers[j].\n            if filtered_numbers[i] % filtered_numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate: tuple[int, int]) -> list[list[int, int]]:\n    \"\"\"\n    Extracts all 8 adjacent coordinates (including diagonals) and the given coordinate itself.\n    Returns a list of lists, where each inner list is an [x, y] coordinate.\n    \"\"\"\n    x, y = coordinate\n    adjacent_coordinates = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent_coordinates.append([x + dx, y + dy])\n    return adjacent_coordinates"}
{"task_id": "Mbpp/632", "solution": "def move_zero(data_list):\n    \"\"\"Moves all zeroes in the list to the end, preserving relative order of non-zero elements.\n    Modifies the list in-place and returns it.\"\"\"\n    non_zero_ptr = 0\n    for i in range(len(data_list)):\n        if data_list[i] != 0:\n            data_list[non_zero_ptr] = data_list[i]\n            non_zero_ptr += 1\n\n    for i in range(non_zero_ptr, len(data_list)):\n        data_list[i] = 0\n    return data_list"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(data):\n    \"\"\"\n    Sorts a list using the heap sort algorithm.\n    Returns a new sorted list, leaving the original list unchanged.\n    \"\"\"\n    arr = list(data)\n    n = len(arr)\n\n    def _heapify(arr_ref, n_ref, i_ref):\n        \"\"\"\n        Maintains the max-heap property for a subtree rooted at i_ref.\n        \"\"\"\n        largest = i_ref\n        l = 2 * i_ref + 1\n        r = 2 * i_ref + 2\n\n        if l < n_ref and arr_ref[largest] < arr_ref[l]:\n            largest = l\n\n        if r < n_ref and arr_ref[largest] < arr_ref[r]:\n            largest = r\n\n        if largest != i_ref:\n            arr_ref[i_ref], arr_ref[largest] = arr_ref[largest], arr_ref[i_ref]\n            _heapify(arr_ref, n_ref, largest)\n\n    # Build a maxheap\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Swap root with current last element\n        _heapify(arr, i, 0)  # Call heapify on the reduced heap\n\n    return arr"}
