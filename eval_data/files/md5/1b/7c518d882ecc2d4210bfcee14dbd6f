{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    Example: sum_series(6) = 6 + 4 + 2 + 0 = 12\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"Sorts the given list arr in ascending order using the pancake sort algorithm.\"\"\"\n\n    def _flip(sub_arr: list, k: int) -> None:\n        \"\"\"Reverses the order of elements from index 0 up to index k (inclusive) in-place.\"\"\"\n        start = 0\n        # k represents the index of the last element to be flipped.\n        while start < k:\n            sub_arr[start], sub_arr[k] = sub_arr[k], sub_arr[start]\n            start += 1\n            k -= 1\n\n    def _find_max_index(sub_arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element within the first n elements of the list sub_arr.\"\"\"\n        max_val = sub_arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            if sub_arr[i] > max_val:\n                max_val = sub_arr[i]\n                max_idx = i\n        return max_idx\n\n    n = len(arr)\n    if n <= 1:\n        return list(arr)\n\n    # Create a copy to avoid modifying the original list in-place\n    working_arr = list(arr)\n\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in the current unsorted sublist (0 to curr_size - 1)\n        max_idx = _find_max_index(working_arr, curr_size)\n\n        # If the maximum element is not already at its correct position (curr_size - 1)\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the beginning of the sublist (index 0)\n            _flip(working_arr, max_idx)\n\n            # Move the maximum element from the beginning to its correct sorted position\n            # at the end of the current sublist (index curr_size - 1)\n            _flip(working_arr, curr_size - 1)\n    \n    return working_arr"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    For n=0, it returns 1 as the smallest power of 2.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    power = 1\n    while power < n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    A pair (a, b) XORs to an even number if a and b have the same parity.\n    \"\"\"\n    def _count_pairs(n: int) -> int:\n        \"\"\"Calculates the number of unique pairs that can be formed from n items.\"\"\"\n        if n < 2:\n            return 0\n        return n * (n - 1) // 2\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return number % 2 == 0\n\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if _is_even(num):\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    pairs_from_even = _count_pairs(even_count)\n    pairs_from_odd = _count_pairs(odd_count)\n    \n    return pairs_from_even + pairs_from_odd"}
{"task_id": "Mbpp/165", "solution": "_ALPHABET_MAP = {chr(i + ord('a')): i + 1 for i in range(26)}\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string where the 0-indexed string position\n    matches the 1-indexed English alphabet position (case-insensitive).\n    Non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        lower_char = char.lower()\n        \n        alphabet_pos = _ALPHABET_MAP.get(lower_char)\n\n        if alphabet_pos is not None and alphabet_pos == i + 1:\n            count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    def extended_gcd(num1: int, num2: int) -> Tuple[int, int, int]:\n        \"\"\"Calculates g, x, and y such that num1*x + num2*y = g, where g = gcd(num1, num2).\"\"\"\n        if num1 == 0:\n            return num2, 0, 1\n        \n        g, x, y = extended_gcd(num2 % num1, num1)\n        return g, y - (num2 // num1) * x, x\n\n    # Handle the special case where both coefficients are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Use the Extended Euclidean Algorithm to find g = gcd(a, b) and a particular solution (x0, y0).\n    g, x0, y0 = extended_gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution to find a solution for ax + by = n.\n    factor = n // g\n    x = x0 * factor\n    y = y0 * factor\n    \n    return (x, y)"}
