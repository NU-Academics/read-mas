{"task_id": "Mbpp/308", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass ValidationUtil:\n    \"\"\"Utility class for input validation.\"\"\"\n\n    @staticmethod\n    def validate_list_of_numbers(data_list: list, name: str) -> None:\n        \"\"\"Validates if the given data_list is a list of numbers.\"\"\"\n        if not isinstance(data_list, list):\n            raise InvalidInputError(f\"'{name}' must be a list.\")\n        for item in data_list:\n            if not isinstance(item, (int, float)):\n                raise InvalidInputError(f\"All elements in '{name}' must be numbers (int or float). Found: {type(item).__name__}\")\n\n    @staticmethod\n    def validate_positive_integer(value: int, name: str) -> None:\n        \"\"\"Validates if the given value is a non-negative integer.\"\"\"\n        if not isinstance(value, int):\n            raise InvalidInputError(f\"'{name}' must be an integer.\")\n        if value < 0:\n            raise InvalidInputError(f\"'{name}' must be a non-negative integer.\")\n\nclass ProductService:\n    \"\"\"\n    Service responsible for calculating and retrieving the largest products.\n    \"\"\"\n    def __init__(self, validation_util: ValidationUtil = None):\n        self._validation_util = validation_util if validation_util else ValidationUtil()\n\n    def find_largest_products(self, list1: list[float|int], list2: list[float|int], k: int) -> list[float]:\n        \"\"\"\n        Finds the specified number of largest products from two given lists.\n        It validates k, handles empty lists, generates products, sorts, and returns the top k.\n        \"\"\"\n        self._validation_util.validate_positive_integer(k, \"k\")\n\n        if not list1 or not list2:\n            return []\n\n        all_products = self._generate_all_products(list1, list2)\n        all_products.sort(reverse=True) # Sort in descending order\n        return all_products[:k]\n\n    def _generate_all_products(self, list1: list[float|int], list2: list[float|int]) -> list[float]:\n        \"\"\"\n        Generates all possible products by taking one element from each list.\n        \"\"\"\n        products = []\n        for num1 in list1:\n            for num2 in list2:\n                products.append(float(num1 * num2))\n        return products\n\nclass ProductController:\n    \"\"\"\n    Controller for handling requests related to product calculations.\n    Exposes the 'large_product' function as the main entry point.\n    \"\"\"\n    def __init__(self, product_service: ProductService = None, validation_util: ValidationUtil = None):\n        self._product_service = product_service if product_service else ProductService()\n        self._validation_util = validation_util if validation_util else ValidationUtil()\n\n    def large_product(self, list1: list[float|int], list2: list[float|int], k: int) -> list[float]:\n        \"\"\"\n        Finds the specified number of largest products from two given lists.\n        It validates inputs and delegates core logic to ProductService.\n        \"\"\"\n        self._validation_util.validate_list_of_numbers(list1, \"list1\")\n        self._validation_util.validate_list_of_numbers(list2, \"list2\")\n        self._validation_util.validate_positive_integer(k, \"k\")\n\n        return self._product_service.find_largest_products(list1, list2, k)\n\ndef large_product(list1: list[float|int], list2: list[float|int], k: int) -> list[float]:\n    \"\"\"\n    Public function to find the specified number of largest products.\n    It orchestrates the process by using a ProductController instance.\n    \"\"\"\n    controller = ProductController()\n    return controller.large_product(list1, list2, k)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i] that includes arr[k],\n    where all subsequence elements from the prefix are strictly less than arr[k].\n    \"\"\"\n    target_k_value = arr[k]\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j\n    # and where arr[j] < target_k_value\n    dp = [0] * (i + 1)\n    \n    overall_max_sum_prefix = 0\n\n    for current_idx in range(i + 1):\n        current_val = arr[current_idx]\n        if current_val < target_k_value:\n            dp[current_idx] = current_val # Initialize with current element itself\n            for prev_idx in range(current_idx):\n                if arr[prev_idx] < current_val: # Only consider elements that are part of an increasing subsequence\n                    dp[current_idx] = max(dp[current_idx], dp[prev_idx] + current_val)\n            overall_max_sum_prefix = max(overall_max_sum_prefix, dp[current_idx])\n    \n    return overall_max_sum_prefix + target_k_value"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the Nth Lucas number using an iterative approach.\n    The input 'n' must be a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        # Initialize L(0) and L(1)\n        lucas_prev2, lucas_prev1 = 2, 1\n        for _ in range(2, n + 1):\n            lucas_current = lucas_prev1 + lucas_prev2\n            lucas_prev2 = lucas_prev1\n            lucas_prev1 = lucas_current\n        return lucas_prev1"}
