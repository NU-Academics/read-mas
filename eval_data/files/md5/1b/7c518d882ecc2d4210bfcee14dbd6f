{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n  \"\"\"\n  Checks if a string represents a valid integer, considering optional leading signs.\n  An integer string must contain at least one digit, optionally preceded by '+' or '-'.\n  \"\"\"\n  if not input_string:\n    return False\n\n  start_index = 0\n  if input_string[0] in ('+', '-'):\n    start_index = 1\n\n  # A string consisting only of a sign (e.g., \"+\", \"-\") is not an integer.\n  if len(input_string) == start_index:\n    return False\n\n  return input_string[start_index:].isdigit()"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear exactly twice.\n    Assumes the array is sorted and contains exactly one unique element.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # If mid is an even index and its pair is at mid+1, or\n        # if mid is an odd index and its pair is at mid-1,\n        # then the unique element must be to the right.\n        if (mid % 2 == 0 and arr[mid] == arr[mid + 1]) or \\\n           (mid % 2 == 1 and arr[mid] == arr[mid - 1]):\n            # Advance low past the current pair.\n            # If mid was even, the pair is (mid, mid+1), so new low is mid+2.\n            # If mid was odd, the pair is (mid-1, mid), so new low is mid+1.\n            low = mid + 2 if mid % 2 == 0 else mid + 1\n        else:\n            # The unique element is at mid or to its left, so narrow high.\n            high = mid\n\n    return arr[low]"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of '0's and '1's in any substring.\n    This uses a variant of Kadane's algorithm by treating '0's as 1 and '1's as -1.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    # Transform the binary string: '0' becomes 1, '1' becomes -1\n    transformed_values = [1 if char == '0' else -1 for char in binary_string]\n\n    max_so_far = transformed_values[0]\n    current_max = transformed_values[0]\n\n    for i in range(1, len(transformed_values)):\n        current_max = max(transformed_values[i], current_max + transformed_values[i])\n        max_so_far = max(max_so_far, current_max)\n    \n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "def sum(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of all positive common divisors of two given numbers.\n    This includes 1 as a common divisor.\n    \"\"\"\n    common_divisors_sum = 0\n    min_num = min(num1, num2)\n\n    for i in range(1, min_num + 1):\n        if num1 % i == 0 and num2 % i == 0:\n            common_divisors_sum += i\n    return common_divisors_sum"}
{"task_id": "Mbpp/123", "solution": "class DivisorCalculator:\n    def sum_proper_divisors(self, n: int) -> int:\n        total_sum = 1 if n > 1 else 0\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                total_sum += i\n                if i * i != n:\n                    total_sum += n // i\n        return total_sum\n\nclass AmicableFinder:\n    def __init__(self, divisor_calculator: DivisorCalculator):\n        self._divisor_calculator = divisor_calculator\n\n    def is_amicable_pair(self, a: int, b: int) -> bool:\n        sum_a = self._divisor_calculator.sum_proper_divisors(a)\n        sum_b = self._divisor_calculator.sum_proper_divisors(b)\n        \n        return sum_a == b and sum_b == a\n\n    def find_amicable_numbers(self, limit: int) -> set[int]:\n        amicable_set = set()\n        for n in range(1, limit + 1):\n            sum_n = self._divisor_calculator.sum_proper_divisors(n)\n            # Optimization: check only one direction and ensure sum_n is within the limit.\n            if sum_n > n and sum_n <= limit: \n                sum_sum_n = self._divisor_calculator.sum_proper_divisors(sum_n)\n                if sum_sum_n == n:\n                    amicable_set.add(n)\n                    amicable_set.add(sum_n)\n        return amicable_set\n\nclass AmicableNumbersService:\n    def __init__(self, amicable_finder: AmicableFinder):\n        self._amicable_finder = amicable_finder\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        amicable_numbers = self._amicable_finder.find_amicable_numbers(limit)\n        return sum(amicable_numbers)\n\n_divisor_calculator = DivisorCalculator()\n_amicable_finder = AmicableFinder(divisor_calculator=_divisor_calculator)\n_amicable_numbers_service = AmicableNumbersService(amicable_finder=_amicable_finder)\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to a specified limit.\"\"\"\n    return _amicable_numbers_service.amicable_numbers_sum(limit)"}
