{"task_id": "Mbpp/12", "solution": "from typing import List, TypeAlias, Any\n\nclass MatrixValidationException(Exception):\n    \"\"\"Custom exception for invalid matrix input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nMatrix: TypeAlias = List[List[int]]\n\nclass MatrixValidator:\n    \"\"\"Validates the structure and content of a matrix.\"\"\"\n\n    def validate_matrix(self, matrix: Any) -> None:\n        \"\"\"\n        Validates if the given input is a valid matrix.\n        Raises MatrixValidationException if validation fails.\n        \"\"\"\n        if not self._is_list_of_lists(matrix):\n            raise MatrixValidationException(\"Input must be a list of lists.\")\n\n        if not matrix:\n            raise MatrixValidationException(\"Matrix cannot be empty.\")\n\n        first_row_length = len(matrix[0])\n        if first_row_length == 0:\n            raise MatrixValidationException(\"Matrix rows cannot be empty.\")\n\n        for i, row in enumerate(matrix):\n            if not self._is_list_of_integers(row):\n                raise MatrixValidationException(f\"Row {i} contains non-integer elements or is not a list.\")\n            if len(row) != first_row_length:\n                raise MatrixValidationException(f\"Row {i} has inconsistent length. Expected {first_row_length}, got {len(row)}.\")\n\n    def _is_list_of_lists(self, data: Any) -> bool:\n        \"\"\"Checks if the input is a list containing only lists.\"\"\"\n        return isinstance(data, list) and all(isinstance(item, list) for item in data)\n\n    def _is_list_of_integers(self, row: Any) -> bool:\n        \"\"\"Checks if the input is a list containing only integers.\"\"\"\n        return isinstance(row, list) and all(isinstance(item, int) for item in row)\n\nclass MatrixSorter:\n    \"\"\"Provides functionality to sort matrices.\"\"\"\n\n    def __init__(self):\n        self._validator = MatrixValidator()\n\n    def sort_by_row_sum(self, matrix: Matrix) -> Matrix:\n        \"\"\"\n        Sorts a given matrix in ascending order according to the sum of its rows.\n        Raises MatrixValidationException if the input matrix is invalid.\n        \"\"\"\n        self._validator.validate_matrix(matrix)\n\n        rows_with_sums = []\n        for row in matrix:\n            row_sum = self._calculate_row_sum(row)\n            rows_with_sums.append((row_sum, row))\n\n        rows_with_sums.sort(key=lambda x: x[0])\n\n        sorted_matrix = [row for _, row in rows_with_sums]\n\n        return sorted_matrix\n\n    def _calculate_row_sum(self, row: List[int]) -> int:\n        \"\"\"Helper method to calculate the sum of elements in a single row.\"\"\"\n        return sum(row)\n\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Raises MatrixValidationException if the input matrix is invalid.\n    \"\"\"\n    sorter = MatrixSorter()\n    return sorter.sort_by_row_sum(matrix)"}
