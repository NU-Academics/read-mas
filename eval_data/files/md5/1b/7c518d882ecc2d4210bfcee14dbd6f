{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr: tuple[int | float, ...], n: int) -> int | float:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in a given array.\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"Array must contain at least two elements to find a difference.\")\n    if n != len(arr):\n        raise ValueError(f\"Length parameter ({n}) does not match actual array length ({len(arr)}).\")\n    \n    for x in arr:\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"All elements in the array must be numeric. Found non-numeric: {x}\")\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        diff = abs(sorted_arr[i+1] - sorted_arr[i])\n        if diff < min_diff:\n            min_diff = diff\n    return min_diff"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Computes the difference between two lists, returning elements in list1 not in list2.\n    The relative order of elements from list1 is preserved.\n    \"\"\"\n    set_list2 = set(list2)\n    \n    result = []\n    for item in list1:\n        if item not in set_list2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text, k):\n    \"\"\"\n    Removes all words of a specific length k from the given string.\n    Words are split by whitespace and joined by a single space.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the delimiters in the given expression are balanced using a stack.\n    Supports parentheses `()`, square brackets `[]`, and curly braces `{}`.\n    \"\"\"\n    OPENING_DELIMITERS = \"({[\"\n    CLOSING_DELIMITERS = \")}]\"\n    DELIMITER_MAP = {\n        ')': '(',\n        '}': '{',\n        ']': '['\n    }\n\n    stack = []\n    for char in expression:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            if not stack or stack.pop() != DELIMITER_MAP[char]:\n                return False\n        # Ignore other characters\n\n    return not stack"}
