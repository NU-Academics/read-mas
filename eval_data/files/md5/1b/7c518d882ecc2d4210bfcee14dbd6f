{"task_id": "Mbpp/611", "solution": "import math\n\ndef max_of_nth(matrix: list[list[int | float]], n: int) -> int | float:\n    \"\"\"\n    Finds the maximum value in the n-th (0-indexed) column of a matrix.\n    The matrix is represented as a list of lists.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"Input 'matrix' must be a list.\")\n    if not all(isinstance(row, list) for row in matrix):\n        raise TypeError(\"All rows in 'matrix' must be lists.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Column index 'n' cannot be negative.\")\n    if not matrix:\n        raise ValueError(\"Input 'matrix' cannot be empty.\")\n\n    max_value = -math.inf\n    found_valid_element = False\n\n    for row in matrix:\n        if n < len(row):\n            element = row[n]\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"Matrix element at column {n} is not numeric: {element}\")\n            if element > max_value:\n                max_value = element\n            found_valid_element = True\n    \n    if not found_valid_element:\n        raise ValueError(f\"Column {n} is out of bounds or contains no valid numeric elements in the matrix.\")\n\n    return max_value"}
{"task_id": "Mbpp/615", "solution": "import math\nfrom typing import Tuple, List, Union\n\ndef average_tuple(data: Tuple[Tuple[Union[float, int], ...], ...]) -> List[float]:\n    \"\"\"\n    Calculates the average of each inner tuple within a tuple of tuples.\n    Returns a list of floats, where each float is the average of the corresponding inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
