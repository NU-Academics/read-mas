{"task_id": "Mbpp/462", "solution": "import collections\nfrom typing import List, Any\n\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Finds all possible combinations of the elements of a given list, including the empty list.\n    The order of combinations in the output is deterministic based on the input order.\n    \"\"\"\n    combinations: List[List[Any]] = [[]]\n    for item in input_list:\n        new_combinations = []\n        for combo in combinations:\n            new_combinations.append(combo + [item])\n        combinations.extend(new_combinations)\n    return combinations"}
{"task_id": "Mbpp/463", "solution": "class MaxProductSubarrayError(Exception):\n    \"\"\"Custom exception for errors in Max Product Subarray calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    \"\"\"\n    if not arr:\n        raise MaxProductSubarrayError(\"Input array cannot be empty.\")\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    result = arr[0]\n\n    for i in range(1, len(arr)):\n        curr = arr[i]\n        \n        # Store max_so_far before it's updated, as min_so_far calculation needs the old max_so_far.\n        temp_max = max(curr, max_so_far * curr, min_so_far * curr)\n        min_so_far = min(curr, max_so_far * curr, min_so_far * curr)\n\n        max_so_far = temp_max\n        result = max(result, max_so_far)\n\n    return result"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(data_tuple):\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements in a tuple.\n    Returns a new tuple with the sums.\n    \"\"\"\n    result = []\n    for i in range(len(data_tuple) - 1):\n        result.append(data_tuple[i] + data_tuple[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers):\n    \"\"\"\n    Checks if the given list contains consecutive numbers after sorting.\n    An empty list or a list with a single element is considered consecutive.\n    \"\"\"\n    if len(numbers) <= 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if sorted_numbers[i] + 1 != sorted_numbers[i+1]:\n            return False\n    return True"}
