nt: int, mod: int) -> int:\n        \"\"\"Computes (base^exponent) % mod efficiently using Python's built-in pow.\"\"\"\n        if mod <= 0:\n            raise ComputeError(\"mod must be greater than 0\")\n        try:\n            return pow(base, exponent, mod)\n        except (OverflowError, MemoryError) as e:\n            raise ComputeError(str(e)) from e\n\n    @staticmethod\n    def safe_parse_int(value: typing.Any) -> int:\n        \"\"\"Safely parses a value to an integer, raising ValidationError if parsing fails.\"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            try:\n                if value.strip().startswith(\"+\"):\n                    value = value.strip()[1:]\n                return int(value.strip())\n            except ValueError:\n                raise ValidationError(f\"cannot parse int from {value!r}\")\n        raise ValidationError(f\"unsupported type for integer parsing: {type(value).__name__}\")\nclass InputValidator:\n    \"\"\"Validates input parameters n and p against defined business rules.\"\"\"\n    MIN_P: int = 2\n    MIN_N: int = 0\n\n    def validate(self, n: int, p: int) -> None:\n        \"\"\"Checks if n and p meet the required conditions (n >= 0, p >= 2).\"\"\"\n        if not isinstance(n, int) or not isinstance(p, int):\n            raise ValidationError(\"n and p must be integers\")\n        if n < self.MIN_N:\n            raise ValidationError(f\"n must be non-negative (>= {self.MIN_N}), got {n}\")\n        if p < self.MIN_P:\n            raise ValidationError(f\"p must be greater than or equal to {self.MIN_P}, got {p}\")\nclass ResultCache:\n    \"\"\"An in-memory, fixed-size LRU cache for storing (n,p) to result mappings.\"\"\"\n    def __init__(self, maxsize: int = 1024) -> None:\n        self._maxsize = maxsize\n        self._store: collections.OrderedDict[typing.Tuple[int, int], int] = collections.OrderedDict()\n\n    def get(self, n: int, p: int) -> typing.Optional[int]:\n        \"\"\"Retrieves a cached result for (n,p), updating its position as most recently used.\"\"\"\n        key = (n, p)\n        if key in self._store:\n            result = self._store.pop(key)\n            self._store[key] = result\n            return result\n        return None\n\n    def set(self, n: int, p: int, result: int) -> None:\n        \"\"\"Stores a result for (n,p), evicting the least recently used item if cache is full.\"\"\"\n        key = (n, p)\n        if key in self._store:\n            self._store.pop(key)\n        self._store[key] = result\n        if len(self._store) > self._maxsize:\n            self._store.popitem(last=False)\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\nclass ModularExponentiator:\n    \"\"\"Coordinates validation, caching, and the core 2^n mod p computation.\"\"\"\n    DEFAULT_CACHE_SIZE = 1024\n\n    def __init__(self, cache: typing.Optional[ResultCache] = None, validator: typing.Optional[InputValidator] = None) -> None:\n        \"\"\"Initializes with an optional cache and validator, providing defaults if none are given.\"\"\"\n        self._cache = cache or ResultCache(self.DEFAULT_CACHE_SIZE)\n        self._validator = validator or InputValidator()\n\n    def compute(self, n: int, p: int) -> int:\n        \"\"\"Validates inputs, checks cache, performs computation if not cached, and stores the result.\"\"\"\n        self._validator.validate(n, p)\n        cached = self._cache.get(n, p)\n        if cached is not None:\n            return cached\n        try:\n            result = self._compute_raw(n, p)\n        except Exception as exc:\n            raise ComputeError(f\"computation failed: {exc}\") from exc\n        self._cache.set(n, p, result)\n        return result\n\n    def _compute_raw(self, n: int, p: int) -> int:\n        \"\"\"Delegates to Utils.pow_mod for the actual modular exponentiation.\"\"\"\n        return Utils.pow_mod(2, n, p)\nclass APIController:\n    \"\"\"Public-facing API controller that orchestrates the modp computation.\"\"\"\n    def __init__(self, exponentiator: typing.Optional[ModularExponentiator] = None) -> None:\n        \"\"\"Initializes the controller with an optional ModularExponentiator instance.\"\"\"\n        self._exponentiator = exponentiator or ModularExponentiator()\n\n    def compute(self, n: int, p: int, use_persistence_db: typing.Optional[str] = None) -> int:\n        \"\"\"Calculates 2^n mod p, potentially using a persistent cache (not enabled by default).\"\"\"\n        if use_persistence_db:\n            # The 'modp' function does not expose 'use_persistence_db', so this path\n            # is not executed by the standard 'modp' call, thus SqliteCacheAdapter\n            # definition is not required inline for this specific function completion.\n            _logger.warning(\"Persistent caching functionality is not active for this direct 'modp' call.\")\n\n        # Delegate to the ModularExponentiator for the core logic\n        result = self._exponentiator.compute(n, p)\n        return result\n_default_api = APIController()\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    return _default_api.compute(n, p)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 1]]}], "HumanEval/51": [{"task_id": "HumanEval/51", "solution": "import collections.abc\nfrom typing import Set, Optional, Any, Iterable, List\ndef remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\\\nghijklm\")\n    'bcdf\\\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''