r\n\n    return result_path", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/129", "solution": "class Position:\n    \"\"\"A simple class to represent (row, column) coordinates.\"\"\"\n    def __init__(self, r: int, c: int) -> None:\n        self.r = r\n        self.c = c\n\n    def __hash__(self) -> int:\n        return hash((self.r, self.c))\n\n    def __eq__(self, other: object) -> bool:\n        return isinstance(other, Position) and self.r == other.r and self.c == other.c\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in the grid.\n    Starts from any cell and moves to 4-neighbor cells, visiting exactly k cells.\n    \"\"\"\n    n = len(grid)\n\n    def get_neighbors_for_pos(pos_r: int, pos_c: int, current_n: int) -> list[Position]:\n        \"\"\"Returns valid 4-neighbor positions for a given coordinate.\"\"\"\n        neighbors_list = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in directions:\n            nr, nc = pos_r + dr, pos_c + dc\n            if 0 <= nr < current_n and 0 <= nc < current_n:\n                neighbors_list.append(Position(nr, nc))\n        return neighbors_list\n\n    # Find the initial minimum value in the entire grid.\n    min_overall_value = float('inf')\n    for r in range(n):\n        for c in range(n):\n            if grid[r][c] < min_overall_value:\n                min_overall_value = grid[r][c]\n    \n    # Initialize the frontier with the single position containing the minimum value.\n    current_frontier = set()\n    for r in range(n):\n        for c in range(n):\n            if grid[r][c] == min_overall_value:\n                current_frontier.add(Position(r, c))\n                break # Value is unique, so we can stop searching.\n\n    result_path = [min_overall_value]\n\n    # Build the path for k steps.\n    for _ in range(1, k): # We already have 1 element, need k-1 more.\n        all_reachable_neighbors = set()\n        for pos in current_frontier:\n            all_reachable_neighbors.update(get_neighbors_for_pos(pos.r, pos.c, n))\n        \n        # Find the minimum value among all these collected neighbors.\n        next_step_min_value = float('inf')\n        for pos in all_reachable_neighbors:\n            val = grid[pos.r][pos.c]\n            if val < next_step_min_value:\n                next_step_min_value = val\n        \n        # Update the frontier to include only the position(s) that yield this next_step_min_value.\n        next_frontier = set()\n        for pos in all_reachable_neighbors:\n            if grid[pos.r][pos.c] == next_step_min_value:\n                next_frontier.add(pos)\n                break # Value is unique, so we can stop searching.\n        \n        current_frontier = next_frontier\n        result_path.append(next_step_min_value)\n    \n    return result_path", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there's a valid subsequence of brackets where at least one bracket is nested.\n    This is true if there exist indices i < j < k < l such that string[i]='[', string[j]='[', string[k]=']', string[l]=']'.\n    \"\"\"\n    first_open = string.find('[')\n    if first_open == -1:\n        return False\n\n    second_open = string.find('[', first_open + 1)\n    if second_open == -1:\n        return False\n\n    first_close = string.find(']', second_open + 1)\n    if first_close == -1:\n        return False\n\n    second_close = string.find(']', first_close + 1)\n    return second_close != -1", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}, {"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the input string contains a valid subsequence of brackets\n    where at least one bracket is nested.\n    This is determined by finding if the maximum nesting depth of any valid\n    bracket prefix in the string is 2 or more.\n    \"\"\"\n    balance = 0\n    max_balance = 0\n\n    for char in string:\n        if char == '[':\n            balance += 1\n        elif char == ']':\n            balance -= 1\n        \n        # We only care about positive balance for max_balance calculation\n        # If balance goes negative, it means we have unmatched closing brackets,\n        # which effectively \"resets\" the potential for deeper nesting from that point\n        # with respect to a contiguous valid prefix, but max_balance still holds the peak.\n        max_balance = max(max_balance, balance)\n\n    return max_balance >= 2", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["[[]"]], "plus_fail_tests": [["[[][]["]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    s = str(n)\n    product = 1\n    found_odd_digit = False\n\n    for char_digit in s:\n        digit = int(char_digit)\n        if digit % 2 == 1:\n            product *= digit\n            found_odd_digit = True\n\n    if not found_odd_digit:\n        return 0\n    return product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n    \n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n            \n    if not found_odd_digit:\n        return 0\n    return product", "base_status": "pass", "plus_statu