nal, Dict, Set, Any\nclass AlgebraError(Exception):\n    \"\"\"Base exception for algebraic expression evaluation.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass ValidationError(AlgebraError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nclass ParsingError(AlgebraError):\n    \"\"\"Exception raised during expression parsing.\"\"\"\n    pass\nclass EvaluationError(AlgebraError):\n    \"\"\"Exception raised during expression evaluation.\"\"\"\n    pass\nToken = Tuple[str, Any]\nclass ExpressionModel:\n    \"\"\"Represents a validated algebraic expression.\"\"\"\n    def __init__(self, operators: List[str], operands: List[int]):\n        self.operators = operators\n        self.operands = operands\n\n    def as_tokens(self) -> List[Token]:\n        \"\"\"Converts the expression into an alternating list of number and operator tokens.\"\"\"\n        tokens: List[Token] = []\n        for i in range(len(self.operands)):\n            tokens.append((\"NUMBER\", self.operands[i]))\n            if i < len(self.operators):\n                tokens.append((\"OP\", self.operators[i]))\n        return tokens\nALLOWED_OPERATORS: Set[str] = {'+', '-', '*', '//', '**'}\nPRECEDENCE: Dict[str, int] = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\nRIGHT_ASSOCIATIVE: Set[str] = {'**'}\nclass InputValidator:\n    \"\"\"Validates raw operator and operand lists.\"\"\"\n    def validate(self, operators: List[str], operands: List[int]) -> ExpressionModel:\n        \"\"\"Ensures inputs meet type, length, and content constraints.\"\"\"\n        if not isinstance(operators, list) or not isinstance(operands, list):\n            raise ValidationError(\"operators and operands must be lists\")\n        if not operators and not operands: # Handle empty lists as per context requiring at least one op, two operands\n            raise ValidationError(\"Input lists cannot be empty.\")\n        if len(operators) != len(operands) - 1:\n            raise ValidationError(\"operators length must be operands length minus one\")\n        if not operands or len(operands) < 2:\n            raise ValidationError(\"operand list must have at least two operands\")\n\n        for op in operators:\n            if not isinstance(op, str):\n                raise ValidationError(f\"operator must be a string, got {type(op)}\")\n            if op not in ALLOWED_OPERATORS:\n                raise ValidationError(f\"invalid operator: {op}\")\n        for v in operands:\n            if not isinstance(v, int):\n                raise ValidationError(f\"operand must be an integer, got {type(v)}\")\n            if v < 0:\n                raise ValidationError(\"operands must be non-negative integers\")\n        return ExpressionModel(operators=operators, operands=operands)\nclass ShuntingYardParser:\n    \"\"\"Converts a token stream into Reverse Polish Notation (RPN) using the Shunting-Yard algorithm.\"\"\"\n    def parse(self, expr: ExpressionModel) -> List[Token]:\n        \"\"\"Transforms the infix expression tokens into an RPN sequence.\"\"\"\n        tokens = expr.as_tokens()\n        output: List[Token] = []\n        op_stack: List[str] = []\n\n        for tok_type, tok_val in tokens:\n            if tok_type == \"NUMBER\":\n                output.append((tok_type, tok_val))\n            elif tok_type == \"OP\":\n                op = tok_val\n                while op_stack:\n                    top = op_stack[-1]\n                    if ((top in PRECEDENCE and PRECEDENCE[top] > PRECEDENCE[op]) or\n                        (top in PRECEDENCE and PRECEDENCE[top] == PRECEDENCE[op] and top not in RIGHT_ASSOCIATIVE)):\n                        output.append((\"OP\", op_stack.pop()))\n                    else:\n                        break\n                op_stack.append(op)\n            else:\n                raise ParsingError(f\"Unexpected token type: {tok_type}\")\n        \n        while op_stack:\n            output.append((\"OP\", op_stack.pop()))\n        return output\nclass RPNEvaluator:\n    \"\"\"Evaluates a list of RPN tokens to produce an integer result.\"\"\"\n    def evaluate(self, rpn_tokens: List[Token]) -> int:\n        \"\"\"Performs stack-based evaluation of the RPN expression.\"\"\"\n        stack: List[int] = []\n        for ttype, val in rpn_tokens:\n            if ttype == \"NUMBER\":\n                stack.append(val)\n            elif ttype == \"OP\":\n                if len(stack) < 2:\n                    raise EvaluationError(\"Stack underflow: not enough operands for operator.\")\n                b = stack.pop()\n                a = stack.pop()\n                \n                if val == '+':\n                    stack.append(a + b)\n                elif val == '-':\n                    stack.append(a - b)\n                elif val == '*':\n                    stack.append(a * b)\n                elif val == '//':\n                    if b == 0:\n                        raise EvaluationError(\"Division by zero.\")\n                    stack.append(a // b)\n                elif val == '**':\n                    stack.append(pow(a, b))\n                else:\n                    raise EvaluationError(f\"Unsupported operator encountered: {val}\")\n            else:\n                raise EvaluationError(f\"Unexpected token type during evaluation: {ttype}\")\n        \n        if len(stack) != 1:\n            raise EvaluationError(\"Invalid RPN expression or final stack state.\")\n        return stack[0]\nclass AlgebraService:\n    \"\"\"Orchestrates validation, parsing, and evaluation of algebraic expressions.\"\"\"\n    def __init__(self, parser: ShuntingYardParser, evaluator: RPNEvaluator, validator: InputValidator):\n        self._parser = parser\n        self._evaluator = evaluator\n        self._validator = validator\n\n    def compute(self, operators: List[str], operands: List[int]) -> int:\n        \"\"\"Validates inputs, parses them to RPN, and evaluates the RPN expression.\"\"\"\n        expr = self._validator.validate(operators, operands)\n        rpn = self._parser.parse(expr)\n        result = self._evaluator.evaluate(rpn)\n        return result\nclass AlgebraController:\n    \"\"\"Provides the public API for algebraic expression evaluation.\"\"\"\n    def __init__(self, service: AlgebraService):\n        self._service = service\n\n    def do_algebra(self, operators: List[str], operands: List[int]) -> int:\n        \"\"\"Evaluates an algebraic expression from lists of operators and operands.\"\"\"\n        return self._service.compute(operators, operands)\n_default_service = AlgebraService(\n    parser=ShuntingYardParser(),\n    evaluator=RPNEvaluator(),\n    validator=InputValidator(),\n)\n_default_controller = AlgebraController(service=_default_service)\ndef do_algebra(operator: list, operand: list) -> int:\n    \"\"\"\n    Given two lists `operator` and `operand`, builds and evaluates an algebraic expression.\n    Adheres to standard operator precedence and associativity.\n    \"\"\"\n    return _default_controller.do_algebra(operator, operand)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from operators and operands, respecting operator precedence.\n    \"\"\"\n\n    # Constants defining operator precedence and right-associativity for the Shunting-yard algorithm.\n    PRECEDENCE = {\"+\": 1, \"-\": 1, \"*\": 2, \"//\": 2, \"**\": 3}\n    RIGHT_ASSOCIATIVE = {\"**\"}\n\n    # A simple internal class to represent tokens (numbers or operators).\n    class Token:\n        __slots__ = ('token_type', 'value')\n\n        def __init__(self, token_type: str, value):\n            self.token_type = token_type\n            self.value = value\n\n    # Build an interleaved sequence of Token objects from the i