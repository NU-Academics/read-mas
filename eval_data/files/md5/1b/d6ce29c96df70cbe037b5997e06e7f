_bits(n: int) -> int:\n        \"\"\"Counts the number of set bits (ones) in the binary representation of a non-negative integer.\"\"\"\n        # Python 3.10+ has int.bit_count()\n        return n.bit_count() if hasattr(n, \"bit_count\") else bin(n).count(\"1\")\n\n    def key_fn(n: int):\n        \"\"\"Generates a tuple key for sorting based on the defined rules.\"\"\"\n        if n >= 0:\n            # For non-negative numbers: (priority_group_0, bit_count, decimal_value)\n            return (0, _count_set_bits(n), n)\n        else:\n            # For negative numbers: (priority_group_1, decimal_value)\n            # Group 1 ensures negatives sort after all non-negatives.\n            return (1, n)\n\n    return sorted(arr, key=key_fn)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Returns a list of words from string s that contain exactly n consonants.\"\"\"\n    if not s:\n        return []\n\n    vowels = {\"a\", \"e\", \"i\", \"o\", \"u\"}\n    result_words = []\n\n    words = s.split()\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and char.lower() not in vowels:\n                consonant_count += 1\n        \n        if consonant_count == n:\n            result_words.append(word)\n            \n    return result_words", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    \"\"\"\n    VOWELS = frozenset({\"a\",\"e\",\"i\",\"o\",\"u\",\"A\",\"E\",\"I\",\"O\",\"U\"})\n\n    def _is_letter(ch: 