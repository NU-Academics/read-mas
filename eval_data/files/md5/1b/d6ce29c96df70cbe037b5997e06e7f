n True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Split the sentence into words, handling leading/trailing/multiple spaces\n    words = sentence.strip().split()\n\n    # Filter words based on their length being a prime number\n    filtered_words = [word for word in words if _is_prime(len(word))]\n\n    # Join the filtered words back into a single string\n    return \" \".join(filtered_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Squares integers at indices that are multiples of 3, cubes integers at indices that are multiples of 4 but not 3,\n    and sums all transformed and untransformed entries.\n    \"\"\"\n    total_sum = 0\n    for i, val in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += val ** 2\n        elif i % 4 == 0:\n            total_sum += val ** 3\n        else:\n            total_sum += val\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transforms list entries based on index and returns the sum of the transformed entries.\n    Indexes that are multiples of 3 are squared; indexes that are multiples of 4 (but not 3) are cubed.\n    \"\"\"\n    total_sum = 0\n    for i, val in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += val * val\n        elif i % 4 == 0:\n            total_sum += val * val * val\n        else:\n            total_sum += val\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    \"\"\"Represents a rational number with arithmetic and analysis methods.\"\"\"\n    def __init__(self, numerator: int, denominator: int) -> None:\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def reduce(self) -> \"Fraction\":\n        \"\"\"Returns a new Fraction reduced to its lowest terms.\"\"\"\n        g = math.gcd(self.numerator, self.denominator)\n        return Fraction(self.numerator // g, self.denominator // g)\n\n    def multiply(self, other: \"Fraction\") -> \"Fraction\":\n        \"\"\"Returns a new Fraction representing the product of self and other.\"\"\"\n        return Fraction(self.numerator * other.numerator, self.denominator * other.denominator)\n\n    def is_whole(self) -> bool:\n        \"\"\"Determines if the fraction evaluates to a whole number.\"\"\"\n        reduced = self.reduce()\n        return reduced.denominator == 1\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Determines if the product of two fractions x and n evaluates to a whole number.\n    Assumes x and n are valid fraction strings (e.g., \"1/2\").\n    \"\"\"\n    def _parse_fraction_string(s: str) -> Fraction:\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        num_s, den_s = s.split(\"/\")\n        return Fraction(int(num_s), int(den_s))\n\n    fx = _parse_fraction_string(x)\n    fn = _parse_fraction_string(n)\n\n    product = fx.multiply(fn)\n    return product.is_whole()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/144", "solution": "import math\nclass InvalidFractionError(Exception):\n    \"\"\"Raised when a fraction string is malformed or invalid.\"\"\"\n    pass\nclass FractionArithmeticError(Exception):\n    \"\"\"Raised for arithmetic issues within Fraction operations.\"\"\"\n    pass\nclass FractionValidator:\n    \"\"\"Validates if a string is a well-formed fraction.\"\"\"\n    def validate(self, frac_str: str) -> None:\n        if not frac_str:\n            raise InvalidFractionError(\"Fraction string cannot be empty.\")\n        parts = frac_str.split(\"/\")\n        if len(parts) != 2:\n            raise InvalidFractionError(f\"Invalid fraction format: '{frac_str}'. Expected 'numerator/denominator'.\")\n        \n        num_s, den_s = parts[0], parts[1]\n        \n        # Check if numerator and denominator are valid integers\n        if not num_s.isdigit() or not den_s.isdigit():\n            raise InvalidFractionError(f\"Numerator and denominator must be non-negative whole numbers: '{frac_str}'.\")\n            \n        numerator = int(num_s)\n        denominator = int(den_s)\n        \n        if denominator == 0:\n            raise InvalidFractionError(\"Denominator cannot be zero.\")\n        # According to the problem statement, numerator and denominator are positive whole numbers.\n        # This implies non-negative for numerator and strictly positive for denominator.\n        # So numerator >= 0, denominator > 0.\n        if numerator < 0: # Already caught by isdigit if it was negative string\n            raise InvalidFractionError(f\"Numerator must be non-negative: '{frac_str}'.\")\nclass Fraction:\n    \"\"\"Represents a rational number, ensuring normalization and basic arithmetic.\"\"\"\n    def __init__(self, numerator: int, denominator: int) -> None:\n        if denominator == 0:\n            raise FractionArithmeticError(\"Denominator cannot be zero.\")\n        \n        # Ensure sign is with numerator, and denominator is positive for canonical form\n        if denominator < 0:\n            numerator *= -1\n            denominator *= -1\n            \n        g = math.gcd(numerator, denominator)\n        self._numerator = numerator // g\n        self._denominator = denominator // g\n\n    @property\n    def numerator(self) -> int:\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        return self._denominator\n\n    def normalized(self) -> \"Fraction\":\n        \"\"\"Returns a new Fraction reduced to its lowest terms (already done in __init__).\"\"\"\n        return self\n\n    def multiply(self, other: \"Fraction\") -> \"Fraction\":\n        \"\"\"Multiplies this fraction by another fraction, returning a new normalized Fraction.\"\"\"\n        return Fraction(self.numerator * other.numerator, self.denominator * other.denominator).normalized()\n\n    def is_whole(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.denominator == 1\nclass FractionParser:\n    \"\"\"Parses a string into a Fraction object.\"\"\"\n    def __init__(self, validator: FractionValidator = None) -> None:\n        self._validator = validator if validator is not None else FractionValidator()\n\n    def parse(self, frac_str: str) -> Fraction:\n        \"\"\"Validates and converts a fraction string to a Fraction object.\"\"\"\n        self._validator.validate(frac_str)\n        num_s, den_s = frac_str.split(\"/\")\n        num, den = int(num_s), int(den_s)\n        return Fraction(num, den)\nclass SimplifierService:\n    \"\"\"Orchestrates parsing and arithmetic to check if a product is a whole number.\"\"\"\n    def __init__(self, parser: FractionParser = None) -> None:\n        self._parser = parser if parser is not None else FractionParser()\n\n    def is_product_whole(self, x_str: str, n_str: str) -> bool:\n        \"\"\"Determines if the product of two fractions (given as strings) is a whole number using cross-cancellation.\"\"\"\n        frac_x = self._parser.parse(x_str)\n        frac_n = self._parser.parse(n_str)\n\n        # Cross-cancellation before multiplication to prevent large intermediate numbers\n        # (a/b) * (c/d) = (a'*c') / (b'*d') where a', b', c', d' are reduced by gcds\n        \n        # Reduce frac_x.denominator with frac_n.numerator\n        g1 = math.gcd(frac_x.denominator, frac_n.numerator)\n        a_den_reduced = frac_x.denominator // g1\n        b_num_reduced = frac_n.numerator // g1\n\n        # Reduce frac_x.numerator with frac_n.denominator\n        g2 = math.gcd(frac_x.numerator, frac_n.denominator)\n        a_num_reduced = frac_x.numerator // g2\n        b_den_reduced = frac_n.denominator // g2\n\n        # The denominator of the product after all possible cancellations\n        product_denominator = a_den_reduced * b_den_reduced\n        \n        # If the fully reduced product has a denominator of 1, it's a whole number.\n        return product_denominator == 1\nclass SimplifyController:\n    \"\"\"Provides a high-level interface for simplifying fraction expressions.\"\"\"\n    def __init__(self, service: SimplifierService = None) -> None:\n        self._service = service if service is not None else SimplifierService()\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Returns True if x * n evaluates to a whole number, False otherwise.\"\"\"\n        return self._service.is_product_whole(x, n)\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    controller = SimplifyController()\n    return controller.simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits (ascending),\n    using original index for tie-breaking.\n    \"\"\"\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        s = 0\n        n = abs(n)\n        while n > 0:\n            s += n % 10\n            n