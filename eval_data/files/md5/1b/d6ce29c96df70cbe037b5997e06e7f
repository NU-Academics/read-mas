ed. The array is guaranteed to have unique elements.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    drops = 0\n    for i in range(n - 1):\n        if arr[i] > arr[i + 1]:\n            drops += 1\n            # If there's more than one descent within the array, it cannot be sorted\n            if drops > 1:\n                return False\n\n    # After checking internal descents, check the wrap-around case (last element vs first)\n    if arr[-1] > arr[0]:\n        # If there's a descent from the last element to the first,\n        # it must be the ONLY descent for the array to be rotatable.\n        # This means there should have been 0 internal descents (drops == 0).\n        return drops == 0\n    else:\n        # If there is no descent from the last element to the first,\n        # then the array is rotatable if it has at most one internal descent.\n        # (0 descents means it's already sorted, 1 descent means it's a rotated sorted array like [3,4,5,1,2])\n        return drops <= 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing\n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n\n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index.\n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n\n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    drops = 0\n    for i in range(n):\n        # Count \"drops\" where an element is greater than the next, considering the array cyclically.\n        # A rotated sorted array with unique elements will have exactly one such drop.\n        if arr[i] > arr[(i + 1) % n]:\n            drops += 1\n            if drops > 1:\n                return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if it's possible to exchange elements between lst1 and lst2\n    to make lst1 a list of only even numbers.\n    \"\"\"\n    \n    # Count all even numbers available in lst1\n    evens_in_lst1 = 0\n    for x in lst1:\n        if x % 2 == 0:\n            evens_in_lst1 += 1\n\n    # Count all even numbers available in lst2\n    evens_in_lst2 = 0\n    for x in lst2:\n        if x % 2 == 0:\n            evens_in_lst2 += 1\n\n    # The total number of even elements available for lst1 is the sum from both lists.\n    total_available_evens = evens_in_lst1 + evens_in_lst2\n\n    # It's possible if the total available even numbers are at least the length of lst1.\n    if total_available_evens >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"