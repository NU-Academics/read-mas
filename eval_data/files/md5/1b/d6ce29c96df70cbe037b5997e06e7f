 Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    \"\"\"\n    try:\n        # Attempt to convert inputs to float. If conversion fails, catch and return -1.0.\n        a = float(a)\n        b = float(b)\n        c = float(c)\n    except (TypeError, ValueError):\n        return -1.0\n\n    # Check if inputs are finite numbers.\n    if not (math.isfinite(a) and math.isfinite(b) and math.isfinite(c)):\n        return -1.0\n\n    # Sides of a triangle must be positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n\n    # Validate triangle inequality: sum of any two sides must be strictly greater than the third.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    # Calculate semi-perimeter.\n    s = (a + b + c) / 2.0\n\n    # Calculate area using Heron's formula.\n    # The term inside sqrt can be slightly negative due to floating point inaccuracies\n    # when the triangle is degenerate (e.g., a+b=c). Handle this by treating as invalid.\n    radicand = s * (s - a) * (s - b) * (s - c)\n    if radicand < 0:\n        return -1.0\n\n    area = math.sqrt(radicand)\n\n    # Round the area to 2 decimal places.\n    return round(area, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly based on balance and total weight.\n    An object flies if it's a palindromic list and its sum is <= w.\n    \"\"\"\n    is_balanced = q == list(reversed(q))\n    total_weight = sum(q)\n    return is_balanced and total_weight <= w", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly. It flies if balanced (palindromic list)\n    and its total weight