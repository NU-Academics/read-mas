HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) with i < j < k where a[i] + a[j] + a[k] is a multiple of 3.\n    The sequence a is defined as a[i] = i*i - i + 1 for 1 <= i <= n.\n    \"\"\"\n\n    if n < 3:\n        return 0\n\n    def comb(n_val, k_val):\n        \"\"\"Calculates n_val choose k_val.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        if k_val == 1:\n            return n_val\n        if k_val == 2:\n            return n_val * (n_val - 1) // 2\n        if k_val == 3:\n            return n_val * (n_val - 1) * (n_val - 2) // 6\n        return 0 # Should not be reached given the problem constraints (k_val <= 3)\n\n    def get_mod_counts(num):\n        \"\"\"\n        Calculates counts of a[i] modulo 3 for i from 1 to num.\n        a[i] = i*i - i + 1.\n        Observation:\n        - if i % 3 == 0, then a[i] % 3 == 1\n        - if i % 3 == 1, then a[i] % 3 == 1\n        - if i % 3 == 2, then a[i] % 3 == 0\n        a[i] % 3 is never 2.\n        \"\"\"\n        \n        # counts of i where i % 3 == 0, 1, 2\n        count_i_mod = [0, 0, 0] \n        \n        # Distribute based on base (num // 3) and remainder (num % 3)\n        base = num // 3\n        remainder = num % 3\n\n        # All residues get 'base' occurrences\n        count_i_mod[0] = base\n        count_i_mod[1] = base\n        count_i_mod[2] = base\n\n        # Add 1 for the remaining elements\n        # i=1 (remainder 1) adds to count_i_mod[1]\n        # i=2 (remainder 2) adds to count_i_mod[2]\n        # i=3 (remainder 0) adds to count_i_mod[0]\n        if remainder >= 1: # for i=1, 4, 7...\n            count_i_mod[1] += 1\n        if remainder >= 2: # for i=2, 5, 8...\n            count_i_mod[2] += 1\n        # The first element with i%3=0 is i=3, so if remainder is 0, nothing extra to count_i_mod[0].\n        # If remainder is 1 (e.g. n=1), it means one more for i%3=1.\n        # If remainder is 2 (e.g. n=2), it means one more for i%3=1 AND one more for i%3=2.\n        # This implementation is for `i` from 1 to `n`.\n        # So `i % 3 == 1` occurs first, then `i % 3 == 2`, then `i % 3 == 0`.\n        # Let's adjust count_i_mod indexing for i=1..n distribution:\n        \n        # Correct distribution for i=1..n:\n        # i%3 == 1 (e.g. 1, 4, ...)\n        # i%3 == 2 (e.g. 2, 5, ...)\n        # i%3 == 0 (e.g. 3, 6, ...)\n        \n        c_i_mod_1 = base\n        c_i_mod_2 = base\n        c_i_mod_0 = base\n\n        if remainder >= 1:\n            c_i_mod_1 += 1\n        if remainder >= 2:\n            c_i_mod_2 += 1\n        # If remainder is 0 after distributing base:\n        # e.g., n=3. base=1. c1=1, c2=1, c0=1. Correct.\n        # If remainder is 1, n=4. base=1. c1=1+1=2, c2=1, c0=1. Correct.\n        # If remainder is 2, n=5. base=1. c1=1+1=2, c2=1+1=2, c0=1. Correct.\n\n\n        # Now map counts of i%3 to counts of a[i]%3\n        # c0 = count of a[i] % 3 == 0\n        # c1 = count of a[i] % 3 == 1\n        # c2 = count of a[i] % 3 == 2\n\n        # a[i] % 3 == 0 comes from i % 3 == 2\n        c0 = c_i_mod_2 \n        # a[i] % 3 == 1 comes from i % 3 == 0 OR i % 3 == 1\n        c1 = c_i_mod_0 + c_i_mod_1\n        # a[i] % 3 == 2 never occurs\n        c2 = 0\n\n        return (c0, c1, c2)\n\n    c0, c1, c2 = get_mod_counts(n)\n\n    total_triples = 0\n    \n    # Case 1: All three numbers are 0 (mod 3) -> sum is 0 (mod 3)\n    total_triples += comb(c0, 3)\n    \n    # Case 2: All three numbers are 1 (mod 3) -> sum is 3 = 0 (mod 3)\n    total_triples += comb(c1, 3)\n    \n    # Case 3: All three numbers are 2 (mod 3) -> sum is 6 = 0 (mod 3)\n    # Since c2 is always 0, this term will always be 0.\n    total_triples += comb(c2, 3) \n    \n    # Case 4: One number is 0 (mod 3), one is 1 (mod 3), one is 2 (mod 3) -> sum is 3 = 0 (mod 3)\n    # Since c2 is always 0, this term will always be 0.\n    total_triples += c0 * c1 * c2\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) with i < j < k where a[i] + a[j] + a[k] is a multiple of 3.\n    The sequence a[i] = i*i - i + 1.\n    \"\"\"\n    def nCk(n_val, k_val):\n        \"\"\"Calculates n choose k for small k values (up to k=3).\"\"\"\n        if n_val < k_val or k_val < 0:\n            return 0\n        if k_val == 0:\n            return 1\n        if k_val == 1:\n            return n_val\n        if k_val == 2:\n            return (n_val * (n_val - 1)) // 2\n        if k_val == 3:\n            return (n_val * (n_val - 1) * (n_val - 2)) // 6\n        return 0  # Should not be reached for k=3 in this problem\n\n    # Analyze the residue of a[i] = i*i - i + 1 modulo 3.\n    # a[i] % 3 == 0 if i % 3 == 2\n    # a[i] % 3 == 1 otherwise (if i % 3 == 0 or i % 3 == 1)\n\n    # Count how many numbers i (1 <= i <= n) satisfy i % 3 == 2.\n    # These correspond to a[i] values that are 0 mod 3.\n    cnt_res0 = (n // 3) + (1 if (n % 3) == 2 else 0)\n\n    # The remaining numbers i correspond to a[i] values that are 1 mod 3.\n    cnt_res1 = n - cnt_res0\n\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if:\n    # (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0\n    # Since a[x]%3 can only be 0 or 1, valid combinations are (0,0,0) and (1,1,1).\n    # Calculate combinations for each residue type.\n    total_triples = nCk(cnt_res0, 3) + nCk(cnt_res1, 3)\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns a tuple containing all planets whose orbits are located between\n    the orbit of planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    '''\n    PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    def _normalize_name(name):\n        return name.strip().title()\n\n    p1_norm = _normalize_name(planet1)\n    p2_norm = _normalize_name(planet2)\n\n    if p1_norm not in PLANETS or p2_norm not in PLANETS:\n        return ()\n\n    idx1 = PLANETS.index(p1_norm)\n    idx2 = PLANETS.index(p2_norm)\n\n    if idx1 == idx2:\n        return ()\n\n    start_index = min(idx1, idx2)\n    end_index = max(idx1, idx2)\n\n    # Planets are strictly between, so we take slice from start_index + 1 up to end_index\n    return tuple(PLANETS[start_index + 1:end_index])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/148", "solution": "\n    # Define the canonical list of planets", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Accepts a list of strings, deletes strings with odd lengths,\n    and returns the remaining strings sorted by length and then alphabetically.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    return sorted(even_length_strings, key=lambda x: (len(x), x))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters out strings with odd lengths and sorts the remaining strings\n    by length (ascending) then alphabetically (ascending).\n    \"\"\"\n    \n    # Filter out strings that have odd lengths\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    \n    # Sort the filtered list by length, then alphabetically for ties\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n    \n    return sorted_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    It implements a primality test using trial division and Miller-Rabin.\n    \"\"\"\n\n    def _miller_rabin(num, witnesses):\n        \"\"\"Performs the Miller-Rabin primality test for a given number.\"\"\"\n        if num == 1:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0:\n            return False\n\n        s = 0\n        d = num - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in witnesses:\n            if a >= num: # Witness must be less than num\n                continue\n\n            x_val = pow(a, d, num)\n            if x_val == 1 or x_val == num - 1:\n                continue\n\n            for _ in range(s - 1):\n                x_val = pow(x_val, 2, num)\n                if x_val == num - 1:\n                    break\n            else:\n                return False\n        return True\n\n    def is_prime(num):\n        \"\"\"Checks if a number is prime using small prime checks and Miller-Rabin.\"\"\"\n        if num < 2:\n            return False\n        if num <= 11:  # Covers 2, 3, 5, 7, 11 and also 4, 6, 8, 9, 10 for early exit\n            return num in (2, 3, 5, 7, 11)\n        if num % 2 == 0 or num % 3 == 0 or num % 5 == 0 or num % 7 == 0 or num % 11 == 0:\n            return False\n\n        # Deterministic witnesses for n < 3,317,044,064,679,887,385,961,981\n        # For typical 32-bit integers, a smaller set is sufficient.\n        # This set is suitable for up to 2^64 (long long in C++)\n        # But per design context, we target 32-bit for default Miller-Rabin.\n        # For n < 3,415,500,717, a = {2, 3, 5, 7, 11, 13, 17} is enough.\n        # Design context specified [2, 3, 5, 7, 11] for 32-bit.\n        # Since we already checked these small divisors, we can omit them from witnesses if n is larger.\n        # Let's use a robust set of witnesses as per the design context implied range (up to 2^64 in MR, but 32-bit for default)\n        # Using a fixed set covering a wide range to be safe.\n        # The design context specifically mentions `DEFAULT_WITNESSES = [2, 3, 5, 7, 11]` for up to 32-bit ints.\n        # Since we already filtered up to 11, we could just pass 2, 3, 5, 7, 11 as is,\n        # but the check `if a >= num: continue` handles cases where num is smaller than a witness.\n        return _miller_rabin(num, [2, 3, 5, 7, 11, 13, 17]) # A slightly larger set for better coverage if needed.\n                                                         # The design snippet used [2,3,5,7,11] - let's stick to that for 32-bit\n                                                         # Actually, the snippet had a note: \"For n < 2^64 you could extend witnesses.\"\n                                                         # So using a slightly more robust set makes sense for generic usage without strict bit limits.\n                                                         # Let's revert to the minimal set from the design snippet example:\n                                                         # `return self._miller_rabin(n, self.DEFAULT_WITNESSES)` where `DEFAULT_WITNESSES = [2, 3, 5, 7, 11]`\n                                                         # Since we already do trial division up to 11, we pass the same witnesses.\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns the value of x if n is a prime number, otherwise returns y.\"\"\"\n\n    def is_pr