rs: List[float]) -> ListStats:\n    \"\"\"Computes min, max, and length of a list in a single pass.\"\"\"\n    it = iter(numbers)\n    # ListValidator ensures numbers has at least two elements.\n    first = float(next(it))\n    mn = mx = first\n    length = 1\n    for v in it:\n        fv = float(v)\n        if fv < mn:\n            mn = fv\n        if fv > mx:\n            mx = fv\n        length += 1\n    return ListStats(mn, mx, length)\ndef linear_transform(numbers: List[float], min_value: float, max_value: float) -> List[float]:\n    \"\"\"Applies the linear transformation (x - min) / (max - min) to each number.\"\"\"\n    denom = max_value - min_value\n    # Denom will not be zero due to `zero_range` check in RescalerService.\n    return [(x - min_value) / denom for x in numbers]\nclass ListValidator:\n    MIN_LENGTH = 2\n\n    def validate(self, numbers: Any) -> None:\n        \"\"\"Validates the input list for type, length, and finiteness of elements.\"\"\"\n        nums = self._validate_iterable(numbers)\n        if len(nums) < self.MIN_LENGTH:\n            raise ValidationError(f\"list must have at least {self.MIN_LENGTH} values\", \"too_short\")\n\n    def _validate_iterable(self, numbers: Any) -> List[float]:\n        if not isinstance(numbers, (list, tuple)):\n            raise ValidationError(\"expected a list or tuple of numbers\", \"not_list\")\n        out: List[float] = []\n        for i, v in enumerate(numbers):\n            if not is_finite_number(v):\n                raise ValidationError(f\"element at index {i} is not a finite number\", \"not_finite\")\n            out.append(float(v))\n        return out\nclass RescalerService:\n    def __init__(self, validator: ListValidator = None) -> None:\n        self._validator = validator or ListValidator()\n\n    def rescale(self, numbers: List[float]) -> List[float]:\n        \"\"\"Rescales a list of numbers to the unit interval [0, 1].\"\"\"\n        self._validator.validate(numbers)\n\n        stats