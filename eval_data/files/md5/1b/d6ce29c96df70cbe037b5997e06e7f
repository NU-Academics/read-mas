e components required for the sorting logic.\n    mapper = NumberMapper()\n    parser = NumberParser(mapper.WORD_TO_INT)\n    service = SortService(mapper)\n\n    # Orchestrate the steps: parse, validate, sort, and format output.\n    tokens = parser.parse_and_validate(numbers)\n    sorted_words = service.sort_words(tokens)\n    return \" \".join(sorted_words)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[""]], "plus_fail_tests": [[""]]}], "HumanEval/20": [{"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair: Tuple[float, float] = (0.0, 0.0) # Initialize with placeholder\n\n    for i in range(len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i+1]\n        current_diff = abs(num2 - num1)\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (num1, num2)\n\n    return closest_pair", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    # Convert all numbers to floats and sort them to easily find adjacent closest pairs.\n    floats = sorted([float(x) for x in numbers])\n\n    # Initialize with the difference between the first two elements.\n    closest_pair = (floats[0], floats[1])\n    min_diff = floats[1] - floats[0]\n\n    # Itera