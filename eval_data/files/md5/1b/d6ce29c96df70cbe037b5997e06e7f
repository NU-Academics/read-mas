atus": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/2", "solution": "import math\nEPSILON = 1e-12\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    frac = number - math.floor(number)\n\n    # Clamp results very close to 0 or 1 to 0 due to float inaccuracies.\n    if abs(frac) < EPSILON or abs(frac - 1.0) < EPSILON:\n        return 0.0\n    return frac", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[4.999999999999999]]}], "HumanEval/1": [{"task_id": "HumanEval/1", "solution": "class ParseError(Exception):\n    \"\"\"Exception raised for general parsing errors.\"\"\"\n    def __init__(self, message: str, position: int | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.position = position\n\n    def __str__(self) -> str:\n        if self.position is not None:\n            return f\"{self.message} at position {self.position}\"\n        return self.message\nclass UnbalancedParenthesesError(ParseError):\n    \"\"\"Exception raised when parentheses are unbalanced.\"\"\"\n    pass\ndef _clean_whitespace(s: str) -> str:\n    \"\"\"Removes all whitespace characters from a string.\"\"\"\n    return ''.join(ch for ch in s if not ch.isspace())\ndef _validate_chars(s: str, allowed: set) -> bool:\n    \"\"\"Checks if all characters in a string are within the allowed set.\"\"\"\n    return all(ch in allowed for ch in s)\nclass Tokenizer:\n    \"\"\"Tokenizes an input string into a sequence of parenthesis characters.\"\"\"\n    def tokenize(self, input_string: str) -> list[str]:\n        \"\"\"Returns a list of '(' and ')' characters, ignoring others.\"\"\"\n        return [ch for ch in input_string if ch in ('(', ')')]\nclass ParenGroupParser:\n    \"\"\"Core parser for separating balanced parenthesis groups.\"\"\"\n    def __init__(self, tokenizer: Tokenizer | None = None):\n        self._tokenizer = tokenizer or Tokenizer()\n\n    def parse(self, input_string: str) -> list[str]:\n        \"\"\"Parses the input string and returns a list of balanced groups.\"\"\"\n        tokens = self._tokenizer.tokenize(input_string)\n        groups = []\n        i = 0\n        n = len(tokens)\n        while i < n:\n            if tokens[i] != '(':\n                # This case should ideally be caught by _validate_chars earlier if it's not a paren\n                # But as a fallback for pure paren tokens, it ensures we start on an opening paren.\n                raise ParseError(f\"Expected '(' at token index {i}\", position=i)\n            group, next_i = self._collect_group(tokens, i)\n            groups.append(group)\n            i = next_i\n        return groups\n\n    def _collect_group(self, chars: list[str], start_idx: int) -> tuple[str, int]:\n        \"\"\"Collects characters forming a single balanced group starting at start_idx.\"\"\"\n        depth = 0\n        res_chars = []\n        i = start_idx\n        n = len(chars)\n\n        while i < n:\n            ch = chars[i]\n            res_chars.append(ch)\n            if ch == '(':\n                depth += 1\n            else: # ch == ')'\n                depth -= 1\n            i += 1\n            if depth == 0:\n                return (''.join(res_chars), i)\n            if depth < 0:\n                raise UnbalancedParenthesesError(\"Too many closing parentheses\", position=i - 1)\n\n        raise UnbalancedParenthesesError(\"Unclosed parentheses at end of input\", position=n - 1)\nclass ParenSplitService:\n    \"\"\"Provides the public API for separating parenthesis groups.\"\"\"\n    def __init__(self, parser: ParenGroupParser | None = None):\n        self._parser = parser or ParenGroupParser()\n\n    def separate(self, input_string: str) -> list[str]:\n        \"\"\"Cleans, validates, and parses the input string to separate groups.\"\"\"\n        cleaned = _clean_whitespace(input_string)\n        allowed_chars_after_cleaning = {'(', ')'}\n        if not _validate_chars(cleaned, allowed_chars_after_cleaning):\n            # The design context implies that other characters are invalid by default.\n            raise ParseError(\"Input contains invalid characters other than parentheses or whitespace.\")\n        return self._parser.parse(cleaned)\n_default_service = ParenSplitService()\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    return _default_service.separate(paren_string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/1", "solution": "class ParseError(Exception):\n    \"\"\"Base exception for parsing errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass BalanceError(ParseError):\n    \"\"\"Exception for unbalanced parentheses.\"\"\"\n    pass\ndef _normalize_input(s: str) -> str:\n    \"\"\"Removes whitespace characters from the input string.\"\"\"\n    return ''.join(ch for ch in s if ch not in \" \\t\\n\\r\")\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = _normalize_input(paren_string)\n    _validate_allowed_chars(cleaned_string)\n\n    groups: List[str] = []\n    depth = 0\n    current_group_chars: List[str] = []\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            depth += 1\n            current_group_chars.append(char)\n        elif char == ')':\n            depth -= 1\n            if depth < 0:\n                raise BalanceError(f\"Extra closing parenthesis at index {i}\")\n            current_group_chars.append(char)\n\n        if depth == 0 and current_group_chars:\n            groups.append(\"\".join(current_group_chars))\n            current_group_chars = []\n\n    if depth != 0:\n        raise BalanceError(f\"Unbalanced: missing {depth} closing parenthesis(es)\")\n\n    return groups", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/3": [{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Checks if the account balance ever falls below zero given a list of operations.\n\n    The account starts with a zero balance.\n    \"\"\"\n    running_balance = 0\n    for operation in operations:\n        running_balance += operation\n        if running_balance < 0:\n            return True\n    return False", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of a