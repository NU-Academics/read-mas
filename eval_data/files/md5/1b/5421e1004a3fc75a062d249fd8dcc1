ck_columns(matrix, magic_constant):\n            return False\n        if not self.check_diagonals(matrix, magic_constant):\n            return False\n\n        return True\n\n    def validate_shape(self, matrix: Matrix) -> bool:\n        \"\"\"Checks if the matrix is non-empty and square.\"\"\"\n        if matrix.size == 0:\n            return False\n        \n        expected_row_length = len(matrix.get_row(0))\n        if expected_row_length == 0 or expected_row_length != matrix.size:\n            return False\n            \n        for i in range(matrix.size):\n            if len(matrix.get_row(i)) != expected_row_length:\n                return False\n        \n        return True\n\n    def validate_numeric_entries(self, matrix: Matrix) -> bool:\n        \"\"\"Verifies that all matrix entries are numeric (int or float).\"\"\"\n        for i in range(matrix.size):\n            for element in matrix.get_row(i):\n                if not isinstance(element, (int, float)):\n                    return False\n        return True\n\n    def compute_magic_constant(self, matrix: Matrix) -> float:\n        \"\"\"Calculates the magic constant by summing the elements of the first row.\"\"\"\n        return sum(matrix.get_row(0))\n\n    def check_rows(self, matrix: Matrix, magic_constant: float) -> bool:\n        \"\"\"Verifies that the sum of each row equals the magic constant.\"\"\"\n        for i in range(matrix.size):\n            if sum(matrix.get_row(i)) != magic_constant:\n                return False\n        return True\n\n    def check_columns(self, matrix: Matrix, magic_constant: float) -> bool:\n        \"\"\"Verifies that the sum of each column equals the magic constant.\"\"\"\n        for j in range(matrix.size):\n            if sum(matrix.get_column(j)) != magic_constant:\n                return False\n        return True\n\n    def check_diagonals(self, matrix: Matrix, magic_constant: float) -> bool:\n        \"\"\"Verifies that the sum of both main diagonals