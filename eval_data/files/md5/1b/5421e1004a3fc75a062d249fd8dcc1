xtract quoted substrings.\"\"\"\n    def parse(self, input_str_obj: InputString) -> List[QuotedSubstring]:\n        extracted_substrings = []\n        current_pos = 0\n\n        while current_pos < input_str_obj.length:\n            open_quote_idx = input_str_obj.value.find('\"', current_pos)\n\n            if open_quote_idx == -1:\n                break # No more opening quotes\n\n            # Search for a closing quote AFTER the current opening quote\n            close_quote_idx = input_str_obj.value.find('\"', open_quote_idx + 1)\n\n            if close_quote_idx != -1:\n                # Found a pair of quotes, extract the content\n                substring_value = input_str_obj.value[open_quote_idx + 1 : close_quote_idx]\n                \n                # start_index is the char right after the opening quote\n                # end_index is the char right before the closing quote\n                extracted_substrings.append(QuotedSubstring(\n                    value=substring_value,\n                    start_index=open_quote_idx + 1,\n                    end_index=close_quote_idx - 1\n                ))\n                current_pos = close_quote_idx + 1 # Continue search after the closing quote\n            else:\n                # Unmatched opening quote, ignore it and continue search from the next character\n                current_pos = open_quote_idx + 1\n        \n        return extracted_substrings\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks \" \" from the given string.\n    Returns a list of extracted substrings in order of appearance.\n    \"\"\"\n    input_str_obj = InputString(value=input_string)\n    parser = QuoteParser()\n    quoted_substring_records = parser.parse(input_str_obj)\n    \n    # Map QuotedSubstring records to a list of their values\n    result_list_items = [record.value for record in quoted_substring_records]\n    \n    return result_list_items", "base_status": "