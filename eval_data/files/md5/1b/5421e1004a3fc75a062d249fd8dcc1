lf, items: list[int]) -> None:\n        self.items = items\n\n    def getFirstOdd(self) -> int:\n        \"\"\"Iterates through the list to find and return the first odd integer.\"\"\"\n        for item in self.items:\n            integer_value = IntegerValue(item)\n            if integer_value.isOdd():\n                return item\n        raise ValueError(\"no odd integer in list\")\nclass FirstOddFunction:\n    \"\"\"A wrapper class to execute the logic for finding the first odd number.\"\"\"\n    def __init__(self, input: list[int]) -> None:\n        self.input = input\n\n    def execute(self) -> int:\n        \"\"\"Executes the core logic to find the first odd number in the input list.\"\"\"\n        integer_list = IntegerList(self.input)\n        return integer_list.getFirstOdd()\ndef first_odd(items):\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Raises ValueError if no odd number is found.\n    \"\"\"\n    first_odd_func = FirstOddFunction(items)\n    return first_odd_func.execute()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/808": [{"task_id": "Mbpp/808", "solution": "def check_K(seq: tuple, k: any) -> bool:\n    \"\"\"Return True if k is present in seq, False otherwise.\n\n    Args:\n        seq (tuple): input immutable sequence (must not be modified).\n        k (any): value to test for membership.\n\n    Returns:\n        bool: True if k in seq, False otherwise.\n    \"\"\"\n    return k in seq", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/809": [{"task_id": "Mbpp/809", "solution": "def check_smaller(first_tuple: tuple, second_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding\n    element in the first tuple. Raises TypeError for invalid input types or ValueError for unequal lengths.\n    \"\"\"\n    def _validate_is_tuple(value: any, name: str) -> None:\n        \"\"\"Raises TypeError if value is not a tuple.\"\"\"\n        if not isinstance(value, tuple):\n            raise TypeError(f\"{name} must be a tuple\")\n\n    def _validate_equal_length(first_tup: tuple, second_tup: tuple) -> None:\n        \"\"\"Raises ValueError if tuple lengths differ.\"\"\"\n        if len(first_tup) != len(second_tup):\n            raise ValueError(\"tuples must have equal length\")\n\n    def _pairwise_compare(first_tup: tuple, second_tup: tuple) -> bool:\n        \"\"\"Performs element-wise comparison (second_tup[i] < first_tup[i]).\"\"\"\n        for i in range(len(first_tup)):\n            if not (second_tup[i] < first_tup[i]):\n                return False\n        return True\n\n    _validate_is_tuple(first_tuple, 'first_tuple')\n    _validate_is_tuple(second_tuple, 'second_tuple')\n    _validate_equal_length(first_tuple, second_tuple)\n    return _pairwise_compare(first_tuple, second_tuple)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/745": [{"task_id": "Mbpp/745", "solution": "class Validator:\n    \"\"\"Validates input types for the function.\"\"\"\n    def validateIntegers(self, startnum, endnum) -> None:\n        if not isinstance(startnum, int) or not isinstance(endnum, int):\n            raise TypeError(\"startnum and endnum must be integers.\")\nclass CandidateNumber:\n    \"\"\"Represents a candidate number for divisibility checking.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.digits: list[int] = []\n        self._div_checker = None # Will be set by the orchestrator\n\n    def extractDigits(self) -> None:\n        \"\"\"Extracts decimal digits of abs(value) into self.digits.\"\"\"\n        num_str = str(abs(self.value))\n        self.digits = [int(d) for d in num_str]\n\n    def hasZeroDigit(self) -> bool:\n        \"\"\"Checks if any digit in self.digits is zero.\"\"\"\n        return 0 in self.digits\n\n    def allDigitsDivide(self) -> bool:\n        \"\"\"Checks if all non-zero digits divide the value.\"\"\"\n        if not self._div_checker:\n            raise RuntimeError(\"DivisibilityChecker not set.\") # Should be set by orchestrator\n        for d in self.digits:\n            # According to the design, hasZeroDigit() is checked before this method is called.\n            # So, 'd' will not be 0 here.\n            if not self._div_checker.isDivisible(self.value, d):\n                return False\n        return True\nclass DivisibilityChecker:\n    \"\"\"Checks if a number is divisible by a given digit.\"\"\"\n    def isDivisible(self, n: int, d: int) -> bool:\n        \"\"\"Returns True if n is divisible by d.\"\"\"\n        return n % d == 0\nclass NumberRange:\n    \"\"\"Generates CandidateNumber objects within an inclusive range.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def generate(self) -> list[CandidateNumber]:\n        \"\"\"Creates CandidateNumber objects for each integer in the range.\"\"\"\n        candidates = []\n        for i in range(self.startnum, self.endnum + 1):\n            candidates.append(CandidateNumber(i))\n        return candidates\nclass ResultSet:\n    \"\"\"Collects and sorts matching integers.\"\"\"\n    def __init__(self):\n        self.results: list[int] = []\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the result set.\"\"\"\n        self.results.append(value)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected results in ascending order.\"\"\"\n        self.results.sort()\n\n    def asList(self) -> list[int]:\n        \"\"\"Returns the collected results as a list.\"\"\"\n        return self.results\ndef divisible_by_digits(startnum, endnum) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded from the results.\n    \"\"\"\n    validator = Validator()\n    validator.validateIntegers(startnum, endnum)\n\n    nr = NumberRange(startnum, endnum)\n    candidates = nr.generate()\n\n    div_checker = DivisibilityChecker()\n    results = ResultSet()\n\n    for candidate in candidates:\n        candidate._div_checker = div_checker # Inject the divisibility checker\n        candidate.extractDigits()\n\n        if candidate.hasZeroDigit():\n            continue # Exclude numbers that contain the digit 0\n\n        if candidate.allDigitsDivide():\n            results.add(candidate.value)\n\n    results.sortAscending()\n    return results.asList()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/797": [{"task_id": "Mbpp/797", "solution": "def is_natural(n) -> bool:\n    \"\"\"Return True if n is a natural number (n >= 1).\"\"\"\n    return n >= 1\ndef is_odd(n) -> bool:\n    \"\"\"Return True if n is odd (n % 2 == 1).\"\"\"\n    return n % 2 == 1\ndef sum_in_range(l, r) -> int:\n    \"\"\"Return the sum of odd natural numbers in inclusive range [l, r]. If l > r, return 0.\"\"\"\n    total_sum = 0\n    for num in range(l, r + 1):\n        if is_natural(num) and is_odd(num):\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/739": [{"task_id": "Mbpp/739", "solution": "class TriangularNumberCalculator:\n    \"\"\"Validates input and computes the minimal index k for a triangular number.\"\"\"\n    def find_Index(self, n: int) -> int:\n        \"\"\"\n        Validates n and iteratively finds the smallest k such that T_k has exactly n digits.\n        Raises ValueError if n is not an integer or less than 1.\n        \"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n\n        k = 1\n        while True:\n            t = self._compute_triangular(k)\n            d = self._digits(t)\n            if d == n:\n                return k\n            k += 1\n\n    def _compute_triangular(self, k: int) -> int:\n        \"\"\"Computes the k-th triangular number T_k = k*(k+1)//2.\"\"\"\n        return k * (k + 1) // 2\n\n    def _digits(self, x: int) -> int:\n        \"\"\"Computes the decimal digit count of a number x.\"\"\"\n        return len(str(x))\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Delegates to TriangularNumberCalculator for validation and computation.\n    \"\"\"\n    calculator = TriangularNumberCalculator()\n    return calculator.find_Index(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[100]]}], "Mbpp/271": [{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    This function computes sum_{k=1..n} (2k)^5.\n    \"\"\"\n    total = 0\n    for k in range(1, n + 1):\n        term = (2 * k) ** 5\n        total += term\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/765": [{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Top-level API function that returns the n-th polite number using 1-based indexing.\n    All helper classes are defined inline as per completion instructions.\n    \"\"\"\n\n    class PoliteNumberRequest:\n        def __init__(self, n_val: int):\n            self.n = n_val\n\n    class PoliteNumberResult:\n        def __init__(self, value_val: int):\n            self.value = value_val\n\n    class Number:\n        def __init__(self, value_val: int):\n            self.value = value_val\n\n        def isPowerOfTwo(self) -> bool:\n            \"\"\"Checks if the number is a power of two.\"\"\"\n            return self.value > 0 and (self.value & (self.value - 1)) == 0\n\n    class ConsecutiveSequence:\n        def __init__(self, start_val: int, end_val: int):\n            self.start = start_val\n            self.end = end_val\n\n        def sum(self) -> int:\n            \"\"\"Calculates the sum of the consecutive sequence.\"\"\"\n            # Uses the arithmetic series sum formula.\n            if self.start > self.end:\n                return 0\n            num_terms = self.end - self.start + 1\n            return num_terms * (self.start + self.end) // 2\n\n    class PoliteNumberService:\n        def getNthPolite(self, n_val: int) -> int:\n            \"\"\"\n            Computes and returns the n-th polite number (1-based).\n            Input n_val is assumed to be an integer >= 1 as per constraints.\n            \"\"\"\n            polite_count = 0\n            candidate = 0\n            while polite_count < n_val:\n                candidate += 1\n                if self.isPolite(candidate):\n                    polite_count += 1\n            return PoliteNumberResult(candidate).value\n\n        def isPolite(self, x_val: int) -> bool:\n            \"\"\"\n            Returns True if x is polite (expressible as sum of two or more\n            consecutive positive integers) and not a power of two; False otherwise.\n            \"\"\"\n            # A positive integer is polite if and only if it is not a power of 2.\n            if x_val < 1:\n                return False\n            return not Number(x_val).isPowerOfTwo()\n\n    service = PoliteNumberService()\n    return service.getNthPolite(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[10000000]]}]}}