/803": [{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n: int) -> bool:\n    \"\"\"Return True if n is a perfect square, else False. For n < 0 returns False.\"\"\"\n    import math\n\n    if n < 0:\n        return False\n    k = math.isqrt(n)\n    return (k * k == n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/804": [{"task_id": "Mbpp/804", "solution": "from typing import List, Iterator\nclass IntegerElement:\n    \"\"\"Represents an integer element and provides an isEven predicate.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the integer element is even.\"\"\"\n        return self.value % 2 == 0\nclass InputList:\n    \"\"\"Represents a sequence of integer elements.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def __iter__(self) -> Iterator[IntegerElement]:\n        \"\"\"Iterates over IntegerElement wrappers.\"\"\"\n        for element_value in self.elements:\n            yield IntegerElement(element_value)\nclass ProductEvaluation:\n    \"\"\"Contains parity inference logic for a product of numbers.\"\"\"\n    def computeParity(self, list_obj: InputList) -> bool:\n        \"\"\"Computes if the product of numbers in the InputList is even.\"\"\"\n        for element_wrapper in list_obj:\n            if element_wrapper.isEven():\n                return True\n        return False\ndef is_product_even(input_list: List[int]) -> bool:\n    \"\"\"Checks whether the product of numbers in a list is even.\n    Returns True if at least one number in the list is even, False otherwise.\n    \"\"\"\n    domain_list = InputList(elements=input_list)\n    pe = ProductEvaluation()\n    return pe.computeParity(domain_list)", "base_status": "pass", "plus_sta