t:\n        \"\"\"Finds the index of the last occurrence of x using binary search.\"\"\"\n        low = 0\n        high = sorted_array.get_length() - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            mid_element = sorted_array.get_element(mid)\n            if mid_element == x:\n                result = mid\n                low = mid + 1  # Try to find a later occurrence\n            elif mid_element < x:\n                low = mid + 1\n            else: # mid_element > x\n                high = mid - 1\n        return result\n\n    def count_occurrences(self, sorted_array: SortedArray, x) -> int:\n        \"\"\"Counts how many times x appears in the sorted array.\"\"\"\n        first = self.find_first_occurrence(sorted_array, x)\n        if first == -1:\n            return 0\n        last = self.find_last_occurrence(sorted_array, x)\n        return last - first + 1\ndef is_majority(array, n, x) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a given sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    sorted_array = SortedArray(array)\n    validator = InputValidator()\n    if not validator.validate_params(sorted_array, n, x):\n        return False\n\n    counter = OccurrenceCounter()\n    count = counter.count_occurrences(sorted_array, x)\n\n    return count > (n / 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/226": [{"task_id": "Mbpp/226", "solution": "def odd_values_string(input: str) -> str:\n    \"\"\"Return a new string composed of characters at even indices of input.\n\n    Preconditions: input is a str (SRS precondition).\n    \"\"\"\n    return input[0::2]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/227": [{"task_id": "Mbpp/227", "solution": "def min_of_three(a, b, c):\n    \"\"\"min_of_three(a: Number, b: Number, c: Number) -> Nu