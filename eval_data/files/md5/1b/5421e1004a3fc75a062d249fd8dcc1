ing import List\nclass Pattern:\n    \"\"\"Represents a literal string pattern to be matched.\"\"\"\n    def __init__(self, value: str, description: str = \"\"):\n        self.value = value\n        self.description = description\nclass InputString:\n    \"\"\"Represents the input string for matching operations.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\nclass MatchResult:\n    \"\"\"DTO containing the result of a match operation.\"\"\"\n    def __init__(self, matched: bool = False, positions: List[int] = None):\n        self.matched = matched\n        self.positions = positions if positions is not None else []\nclass TextMatchFunction:\n    \"\"\"Encapsulates pattern-matching logic for 'abb' and 'abbb'.\"\"\"\n    def __init__(self, name: str = \"text_match_two_three\"):\n        self.name = name\n        self._patterns: List[Pattern] = [\n            Pattern(\"abb\", \"character 'a' followed by two 'b's\"),\n            Pattern(\"abbb\", \"character 'a' followed by three 'b's\")\n        ]\n\n    def find_matches(self, text: InputString) -> MatchResult:\n        \"\"\"Scans the InputString for all occurrences of predefined patterns.\"\"\"\n        all_positions = []\n        matched = False\n        for pattern_obj in self._patterns:\n            pattern = pattern_obj.value\n            start = 0\n            while True:\n                idx = text.value.find(pattern, start)\n                if idx == -1:\n                    break\n                all_positions.append(idx)\n                matched = True\n                start = idx + 1 # Move past the found match to find next\n\n        return MatchResult(matched=matched, positions=sorted(list(set(all_positions))))\n\n    def text_match_two_three(self, text: str) -> bool:\n        \"\"\"Convenience method to check for 'abb' or 'abbb' in a string.\"\"\"\n        input_string = InputString(text)\n        result = self.find_matches(input_string)\n        return result.matched\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"Checks whether a string contains the 'a' character followed by two or three 'b' characters.\"\"\"\n    matcher = TextMatchFunction()\n    return matcher.text_match_two_three(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/287": [{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Includes input validation for type and value of n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n    \n    # Using the closed-form expression for sum_{k=1..n} (2k)^2 = 4 * sum_{k=1..n} k^2\n    # sum_{k=1..n} k^2 = n * (n+1) * (2n+1) / 6\n    # So, 4 * n * (n+1) * (2n+1) / 6 = 2 * n * (n+1) * (2n+1) / 3\n    # Use integer division to ensure an integer result.\n    result = (2 * n * (n + 1) * (2 * n + 1)) // 3\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000]]}], "Mbpp/292": [{"task_id": "Mbpp/292", "solution": "from math import floor\ndef find(dividend, divisor) -> int:\n    \"\"\"Return math.floor(dividend / divisor) as int. Raises TypeError for non-numeric inputs and ZeroDivisionError for divisor == 0.\"\"\"\n    _validate_numeric(dividend, 'dividend')\n    _validate_numeric(divisor, 'divisor')\n    if divisor == 0:\n        raise ZeroDivisionError('divisor must not be zero')\n    return _compute_floor_quotient(dividend, divisor)\ndef _compute_floor_quotient(dividend, divisor) -> int:\n    return int(floor(dividend / divisor))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[10, 3]], "plus_fail_tests": [[0, 5]]}], "Mbpp/293": [{"task_id": "Mbpp/293", "solution": "import math\ndef