or(\"fewer than two words starting with 'p' found\")\n    return matches[0], matches[1]\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"Iterate input_list, tokenizes each string, filters words starting with 'p' or 'P',\n    and returns a tuple of the first two matches.\n    \"\"\"\n    matches: List[str] = []\n    for text in input_list:\n        tokens = _tokenize(text)\n        for token in tokens:\n            if _starts_with_p(token):\n                matches.append(token)\n                if len(matches) == 2:\n                    return _collect_first_two(matches)\n    return _collect_first_two(matches)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/309": [{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"Return the greater of two numeric arguments (int or float).\"\"\"\n    return a if a >= b else b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/310": [{"task_id": "Mbpp/310", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, List\nclass StringToTupleFunction:\n    \"\"\"Orchestrates the conversion of an InputString to a TupleOutput.\"\"\"\n\n    def _process(self, input_string: InputString) -> TupleOutput:\n        \"\"\"Processes the InputString, filters spaces, and returns TupleOutput.\"\"\"\n        collected_chars: List[str] = []\n        for i, char_str in enumerate(input_string.value):\n            # As per design, Character objects are conceptually created but not stored in the final tuple elements.\n            # character_obj = Character(char=char_str, position=i) \n            \n            if char_str != ' ':  # Exclude U+0020 (ASCII space) characters.\n                collected_chars.append(char_str)\n        \n        return TupleOutput(elements=tuple(collected_chars))\ndef string_to_tuple(input: str) -> tuple:\n    \"\"\"Converts a string to a tuple of characters, excluding spaces.\"\"\"\n    input_obj = InputString(value=input)\n    processor = StringToTupleFunction()\n    output_obj = processor._process(input_obj)\n    \n    return output_obj.elements", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/308": [{"task_id": "Mbpp/308", "solution": "class ProductPair:\n    \"\"\"Represents a product of two numbers along with their original indices.\"\"\"\n    def __init__(self, value: int, indexA: int, indexB: int):\n        self.value = value\n        self.indexA = indexA\n        self.indexB = indexB\nclass ProductRepository:\n    \"\"\"Stores and provides access to a collection of ProductPair objects.\"\"\"\n    def __init__(self):\n        self._products: list[ProductPair] = []\n\n    def add(self, pair: ProductPair) -> None:\n        self._products.append(pair)\n\n    def all(self) -> list[ProductPair]:\n        return self._products\nclass LargeProductService:\n    \"\"\"Orchestrates the logic for finding the largest products from two lists.\"\"\"\n    def large_product(self, list_a: list, list_b: list, k: int) -> list:\n        self._validate_inputs(list_a, list_b, k)\n\n        if not list_a or not list_b or k == 0:\n            return []\n\n        repo = self._generate_products(list_a, list_b)\n        return self._select_top_k(repo.all(), k)\n\n    def _validate_inputs(self, list_a: list, list_b: list, k: int) -> None:\n        if not isinstance(list_a, list) or not isinstance(list_b, list):\n            raise TypeError(\"list_a and list_b must be lists.\")\n        if not all(isinstance(x, int) for x in list_a):\n            raise TypeError(\"Elements in list_a must be integers.\")\n        if not all(isinstance(x, int) for x in list_b):\n            raise TypeError(\"Elements in list_b must be integers.\")\n        if not isinstance(k, int) or k < 0:\n            raise TypeError(\"k must be a non-negative integer.\")\n\n    def _generate_products(self, list_a: list, list_