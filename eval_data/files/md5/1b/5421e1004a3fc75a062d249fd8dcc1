maximum prefix sum and maximum suffix sum of an array.\"\"\"\n        # Assumes data is not empty as per design context (validation handles this).\n        \n        max_prefix_sum = -float('inf')\n        current_prefix_sum = 0\n        for x in data:\n            current_prefix_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n        max_suffix_sum = -float('inf')\n        current_suffix_sum = 0\n        for x in reversed(data):\n            current_suffix_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n        return max_prefix_sum, max_suffix_sum\n\n    # Input validation (arr, n, k) is assumed to have happened externally\n    # as per design context. arr is non-empty, k > 0.\n    \n    if k == 1:\n        return _kadane(arr)\n\n    kadane_single = _kadane(arr)\n    total_sum = sum(arr)\n    pref_max, suff_max = _prefix_suffix_sums(arr)\n\n    # Max sum spanning exactly two copies (max suffix of first + max prefix of second)\n    candidate_cross_two_arrays = suff_max + pref_max\n\n    result = kadane_single # Initialize result with the max from a single array.\n\n    if total_sum > 0:\n        # If total_sum > 0, including (k-2) full copies can increase the sum.\n        # This covers subarrays spanning multiple full arrays with max prefix and suffix.\n        max_sum_with_middle_arrays = suff_max + (k - 2) * total_sum + pref_max\n        result = max(result, candidate_cross_two_arrays, max_sum_with_middle_arrays)\n    else:\n        # If total_sum <= 0, adding full copies won't help.\n        # The max sum can only be within one copy or span at most two copies.\n        result = max(result, candidate_cross_two_arrays)\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/294": [{"task_id": "Mbpp/294", "solution": "def max_val(lst: list) -> int | float | None:\n    \"\"\"\n    Finds the maximum numeric value in a given heter