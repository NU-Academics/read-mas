lates the boolean outcome and a human-readable reason for undulating checks.\"\"\"\n    def __init__(self, result: bool, reason: str):\n        self.result = result\n        self.reason = reason\nclass UndulatingChecker:\n    \"\"\"Implements the logic to determine if a number is undulating.\"\"\"\n    def is_undulating(self, number_value: 'NumberValue') -> bool:\n        \"\"\"Determines if the given NumberValue represents an undulating number.\"\"\"\n        evaluation_result = self.evaluate(number_value)\n        return evaluation_result.result\n\n    def evaluate(self, number_value: 'NumberValue') -> 'UndulatingResult':\n        \"\"\"Evaluates a NumberValue and returns an UndulatingResult with reason.\"\"\"\n        digits = number_value.digits\n        if digits is None:\n            return UndulatingResult(False, \"NumberValue not normalized; digits not available.\")\n\n        if len(digits) < 2:\n            return UndulatingResult(False, \"Numbers with less than two digits are not undulating.\")\n\n        a_val = digits[0]\n        b_val = digits[1]\n\n        if a_val == b_val:\n            return UndulatingResult(False, \"The first two digits are identical, so it's not undulating.\")\n\n        for i, digit in enumerate(digits):\n            if i % 2 == 0: # 1-based odd position (1st, 3rd, etc.)\n                if digit != a_val:\n                    return UndulatingResult(False, f\"Digit at 1-based position {i+1} ({digit}) does not match A ({a_val}).\")\n            else: # 1-based even position (2nd, 4th, etc.)\n                if digit != b_val:\n                    return UndulatingResult(False, f\"Digit at 1-based position {i+1} ({digit}) does not match B ({b_val}).\")\n\n        return UndulatingResult(True, f\"The number is undulating with alternating digits A={a_val}, B={b_val}.\")\ndef is_undulating(number: int) -> bool:\n    \"\"\"Checks whether the given integer is an undulating number.\n    An undulating number has an alternating pattern of two distinct digits (A, B) where A != B, and single-digit numbers are not undulating.\n    \"\"\"\n    nv = NumberValue(number)\n    nv.normalize()\n    checker = UndulatingChecker()\n    return checker.is_undulating(nv)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/97": [{"task_id": "Mbpp/97", "solution": "from typing import Any, Dict, Hashable, Iterable, List\ndef frequency_lists(listOfLists) -> dict:\n    \"\"\"Compute frequency mapping for flattened listOfLists.\n\n    Parameters:\n    - listOfLists: expected to be an outer list whose elements are sublists.\n      Each element in sublists must be hashable to be used as a dict key.\n\n    Returns:\n    - dict mapping element -> int (counts)\n    \"\"\"\n    counts: Dict[Hashable, int] = {}\n    for sublist in listOfLists:\n        for item in sublist:\n            counts[item] = counts.get(item, 0) + 1\n    return counts", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/98": [{"task_id": "Mbpp/98", "solution": "def multiply_num(sequence):\n    \"\"\"Multiplies all numbers in a sequence and divides the product by the sequence's length.\"\"\"\n    product = 1\n    for num in sequence:\n        product *= num\n    \n    length = len(sequence)\n    # The design context implies validation and error handling for empty sequences,\n    # but the explicit requirements for this task state:\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    # Therefore, we proceed assuming a non-empty sequence as per the example.\n    \n    return float(product) / length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/99": [{"task_id": "Mbpp/99", "solution": "class DecimalNumber:\n    \"\"\"Represents a decimal integer and checks its non-negativity.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the decimal number is non-negative.\"\"\"\n        return self.value >= 0\nclass BinaryString:\n    \"\"\"Represents a binary string and checks for leading zeros.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def has_no_leading_zeros(self) -> bool:\n        \"\"\"Checks if the binary string has no leading zeros, unless it is '0'.\"\"\"\n        if self.value == \"0\":\n            return True\n        return not (self.value.startswith('0') and len(self.value) > 1)\nclass Converter:\n    \"\"\"Converts a decimal number to its binary string representation.\"\"\"\n    def decimal_to_binary(self, n: int) -> str:\n        \"\"\"Converts a non-negative decimal integer to its binary equivalent.\"\"\"\n        self._validate_input(n)\n\n        if n == 0:\n            return \"0\"\n\n        binary_str = self._convert_positive(n)\n        \n        # The design implies the Converter 'produces' a BinaryString object,\n        # which can then be used to ensure 'has_no_leading_zeros()'.\n        # Though the method returns a string, this line acknowledges the design.\n        _ = BinaryString(binary_str) \n\n        return binary_str\n\n    def _validate_input(self, n: int) -> bool:\n        \"\"\"Validates if the input is a non-negative integer, raising ValueError if invalid.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input must be an integer.\")\n        if not DecimalNumber(n).is_non_negative():\n            raise ValueError(\"Input must be a non-negative integer.\")\n        return True\n\n    def _convert_positive(self, n: int) -> str:\n        \"\"\"Converts a positive integer to its binary string representation without leading zeros.\"\"\"\n        digits = []\n        while n > 0:\n            remainder = n % 2\n            digits.append(str(remainder))\n            n //= 2\n        \n        # The digits are collected in reverse order, so reverse them to get the correct binary string.\n        binary_result = \"\".join(digits[::-1])\n        return binary_result\ndef decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal number to its binary equivalent,\n    represented as a string with no leading zeros.\n    \"\"\"\n    converter = Converter()\n    return converter.decimal_to_binary(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/101": [{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises KthElementError for invalid inputs according to design specifications.\n    \"\"\"\n\n    class Error:\n        def __init__(self, type: str, message: str):\n            self.type = type\n            self.message = message\n\n    class KthElementError(Exception):\n        def __init__(self, message: str, error: Error = None):\n            super().__init__(message)\n            self.error = error\n\n    # Helper function for validation, as specified in design's validator.py\n    def validate_k(arr, val_k):\n        if not arr:\n            raise KthElementError(\"Array cannot be empty.\", Error(\"ValueError\", \"Array is empty\"))\n        \n        if not isinstance(val_k, int):\n            raise KthElementError(f\"k must be an integer, but received {type(val_k).__name__}.\", Error(\"TypeError\", \"k is not an integer\"))\n        \n        if not (1 <= val_k <= len(arr)):\n            raise KthElementError(f\"k ({val_k}) is out of bounds for array of length {len(arr)}.\", Error(\"IndexError\", \"k out of bounds\"))\n        \n        return val_k - 1\n\n    # Helper function for selection, as specified in design's selector.py\n    def select_element(arr, index):\n        # This function assumes 'index' is already validated to be within bounds.\n        return arr[index]\n\n    zero_based_index = validate_k(array, k)\n    element_value = select_element