ally after trimming\n        self.startIndex: int = startIndex\n        self.endIndex: int = endIndex\nclass AdverbResult:\n    \"\"\"Represents the detected adverb with its start index, end index, and cleaned text.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, adverb: str):\n        self.startIndex: int = startIndex\n        self.endIndex: int = endIndex\n        self.adverb: str = adverb\nclass PunctuationHelper:\n    \"\"\"Helper to trim leading and trailing punctuation from a string.\"\"\"\n    @staticmethod\n    def trimPunctuation(tokenText: str) -> str:\n        \"\"\"Removes leading and trailing non-alphabetic ASCII characters.\"\"\"\n        start = 0\n        end = len(tokenText) - 1\n\n        while start <= end and tokenText[start] not in string.ascii_letters:\n            start += 1\n        while end >= start and tokenText[end] not in string.ascii_letters:\n            end -= 1\n\n        if start > end:\n            return \"\"\n        return tokenText[start : end + 1]\nclass AdverbFinder:\n    \"\"\"Finds the first adverb in a sentence, orchestrating tokenization and detection.\"\"\"\n\n    def find_adverb_position(self, sentence: Sentence) -> AdverbResult | None:\n        \"\"\"Finds the first adverb and its positions in the given sentence.\"\"\"\n        tokens = self.tokenizeKeepingIndices(sentence.text)\n\n        for token in tokens:\n            clean_text_for_detection = PunctuationHelper.trimPunctuation(token.rawText)\n\n            if self.isAdverb(clean_text_for_detection):\n                # Calculate the indices of the cleaned adverb within the original sentence.\n                if clean_text_for_detection:\n                    relative_start = token.rawText.find(clean_text_for_detection)\n                    if relative_start != -1:\n                        adverb_start_index = token.startIndex + relative_start\n                        adverb_end_index = adverb_start_index + len(clean_text_for_detection)\n                        return AdverbResult(adverb_start_index, adverb_end_index, clean_text_for_detection.lower())\n        return None\n\n    def tokenizeKeepingIndices(self, text: str) -> list[Token]:\n        \"\"\"Tokenizes the text into a list of Token objects, preserving original indices.\"\"\"\n        tokens = []\n        for match in re.finditer(r'\\S+', text):\n            raw_text = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            tokens.append(Token(raw_text, start_index, end_index))\n        return tokens\n\n    def isAdverb(self, cleanText: str) -> bool:\n        \"\"\"Checks if the given cleaned text qualifies as an adverb.\"\"\"\n        # Adverb must be non-empty, all alphabetic, and end with \"ly\" (case-insensitive).\n        if not cleanText:\n            return False\n        if not cleanText.isalpha():\n            return False\n        return cleanText.lower().endswith(\"ly\")\ndef find_adverb_position(sentence_str: str) -> tuple[int, int, str] | None:\n    \"\"\"Finds the first adverb and its positions in a given sentence string.\"\"\"\n    sentence_obj = Sentence(sentence_str)\n    adverb_finder = AdverbFinder()\n    adverb_result = adverb_finder.find_adverb_position(sentence_obj)\n\n    if adverb_result:\n        return (adverb_result.startIndex, adverb_result.endIndex, adverb_result.adverb)\n    else:\n        return None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["awaquicklyy"]]}], "Mbpp/450": [{"task_id": "Mbpp/450", "solution": "def extract_string(list_of_strings, size):\n    \"\"\"Return ordered list of strings from list_of_strings where len(string) == size.\"\"\"\n    result = []\n    for s in list_of_strings:\n        if len(s) == size:\n            result.append(s)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/446": [{"task_id": "Mbpp/446", "solution": "class TupleInp