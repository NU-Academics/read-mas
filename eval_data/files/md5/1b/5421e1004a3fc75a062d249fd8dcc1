inomial_calculator.binomial_coefficient(2 * n, n)\n\n    def _apply_formula(self, n, binom_value):\n        \"\"\"Applies the Catalan number formula C_n = (1/(n+1)) * C(2n, n).\"\"\"\n        return binom_value // (n + 1)\n\n    def catalan_number(self, n):\n        \"\"\"Calculates the nth Catalan number after validating the input.\"\"\"\n        self._validator.validate_non_negative_integer(n)\n        binom_value = self._use_binomial_calculator(n)\n        return self._apply_formula(n, binom_value)\ndef catalan_number(n):\n    \"\"\"\n    Returns the nth Catalan number.\n    Raises TypeError if n is not an integer or ValueError if n is negative.\n    \"\"\"\n    error_handler = ErrorHandler()\n    input_validator = InputValidator(error_handler)\n    binomial_calculator = BinomialCalculator()\n    catalan_calc = CatalanCalculator(binomial_calculator, input_validator, error_handler)\n    return catalan_calc.catalan_number(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/581": [{"task_id": "Mbpp/581", "solution": "class NumericValidator:\n    \"\"\"Helper for numeric validation. Validation checks are omitted per strict requirements.\"\"\"\n    def isNumeric(self, value):\n        # Per requirement: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        return True\n\n    def isNonNegative(self, value):\n        # Per requirement: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        return True\nclass SquarePyramid:\n    \"\"\"Domain entity representing a square pyramid for surface area calculation.\"\"\"\n    def __init__(self, base_edge, slant_height):\n        self.base_edge = base_edge\n        self.slant_height = slant_height\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Calculates the surface area of the square pyramid.\"\"\"\n        return (self.base_edge ** 2) + 2 * self.base_edge * self.slant_height\nclass SurfaceAreaCalculator:\n    \"\"