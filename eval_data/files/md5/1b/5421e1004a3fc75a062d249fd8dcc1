coordinates.\n    Returns (r, theta) as a tuple of floats.\n    \"\"\"\n    import math\n    from typing import Tuple, Union\n\n    def _normalize_input(val: Union[complex, int, float]) -> Tuple[float, float]:\n        \"\"\"Normalizes input to (real: float, imag: float).\"\"\"\n        if isinstance(val, complex):\n            return (float(val.real), float(val.imag))\n        else:\n            return (float(val), 0.0)\n\n    def _compute_magnitude(real_val: float, imag_val: float) -> float:\n        \"\"\"Computes r = sqrt(real^2 + imag^2).\"\"\"\n        return float(math.sqrt(real_val * real_val + imag_val * imag_val))\n\n    def _compute_angle(real_val: float, imag_val: float) -> float:\n        \"\"\"Computes theta = atan2(imag, real) in radians.\"\"\"\n        return float(math.atan2(imag_val, real_val))\n\n    real, imag = _normalize_input(value)\n    r = _compute_magnitude(real, imag)\n    theta = _compute_angle(real, imag)\n    return (r, theta)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/257": [{"task_id": "Mbpp/257", "solution": "def swap_numbers(a, b):\n    \"\"\"\n    Swaps two numbers and returns them as a tuple (second number, first number).\n    \"\"\"\n    return (b, a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(input_list):\n    \"\"\"Counts the number of integer elements in a list.\n    Checks runtime type using type(elem) is int.\"\"\"\n    count = 0\n    for elem in input_list:\n        if type(elem) is int:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    The algorithm uses dynamic programming, filling a table where dp[i][j] stores\n    the length of the LPS for the substring s[i..j].\n    \"\"\"\n    class LPSFunction:\n        def lps(self, s: str) -> int:\n            n = len(s)\n            if n == 0:\n                return 0\n\n            # dp[i][j] will store the length of the longest palindromic subsequence\n            # for the substring s[i...j].\n            dp = [[0] * n for _ in range(n)]\n\n            # Base case: Every single character is a palindromic subsequence of length 1.\n            for i in range(n):\n                dp[i][i] = 1\n\n            # Fill the DP table for substrings of length 2 up to n.\n            # `length` is the current length of the substring (j - i + 1).\n            for length in range(2, n + 1):\n                # `i` is the starting index of the current substring.\n                for i in range(n - length + 1):\n                    j = i + length - 1 # `j` is the ending index of the current substring.\n\n                    # If the characters at the ends of the substring match.\n                    if s[i] == s[j]:\n                        # If the substring length is 2, it's just those two characters.\n                        # Otherwise, it's 2 plus the LPS of the inner substring s[i+1...j-1].\n                        dp[i][j] = 2 + (dp[i + 1][j - 1] if length > 2 else 0)\n                    else:\n                        # If the characters don't match, the LPS length is the maximum of:\n                        # 1. LPS of substring s[i+1...j] (excluding s[i])\n                        # 2. LPS of substring s[i...j-1] (excluding s[j])\n                        dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n            \n            # The result is the length of the LPS for the entire string s[0...n-1].\n            return dp[0][n - 1]\n\n    # The public `lps` function instantiates `LPSFunction` and calls its `lps` method.\n    return LPSFunction().lps(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "class InputParameter:\n    \"\"\"A data class to hold the input integer n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\nclass SumSeriesFunction:\n    \"\"\"Handles validation and computation of the series sum.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.terms = []\n        self.result = 0\n\n    def validateInput(self) -> bool:\n        \"\"\"Validates if the input 'n' is an integer.\"\"\"\n        return isinstance(self.n, int)\n\n    def compute(self) -> int:\n        \"\"\"Generates series terms, aggregates their sum, and stores the result.\"\"\"\n        self.terms = []\n        for i in range(0, self.n // 2 + 1):\n            term_value = self.n - 2 * i\n            self.terms.append(term_value)\n        \n        self.result = sum(self.terms)\n        return self.result\ndef sum_series(n):\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2.\n    Raises ValueError if n is not an integer.\n    \"\"\"\n    input_param = InputParameter(n=n)\n    inst = SumSeriesFunction(n=input_param.n)\n    if not inst.validateInput():\n        raise ValueError(\"n must be an integer\")\n    result_value = inst.compute()\n    return result_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "import math\nclass Result:\n    \"\"\"Final result holder: members and their sum.\"\"\"\n    def __init__(self, members: list[int]):\n        self.members = members\n        self.sum = sum(members)\nclass AmicableCalculator:\n    \"\"\"Central algorithmic coordinator; computes amicable numbers and produces result.\"\"\"\n    def __init__(self):\n        self._divisors_cache: dict[int, int] = {}\n        self._found_amicables: set[int] = set()\n\n    def sum_proper_divisors(self, n: int) -> int:\n        \"\"\"Compute and return sum of proper divisors of n, using memoization.\"\"\"\n        if n in self._divisors_cache:\n            return self._divisors_cache[n]\n        \n        if n <= 1:\n            self._divisors_cache[n] = 0\n            return 0\n\n        sum_divs = 1\n        sqrt_n = int(math.sqrt(n))\n        for i in range(2, sqrt_n + 1):\n            if n % i == 0:\n                sum_divs += i\n                if i * i != n:\n                    sum_divs += n // i\n        \n        self._divisors_cache[n] = sum_divs\n        return sum_divs\n\n    def _record_if_amicable(self, n: int, limit: int) -> None:\n        \"\"\"Checks if n is part of an amicable pair and records valid members within limit.\"\"\"\n        sum_n = self.sum_proper_divisors(n)\n        \n        if sum_n > 0 and sum_n != n:\n            sum_m = self.sum_proper_divisors(sum_n)\n            \n            if sum_m == n:\n                if 1 <= n <= limit:\n                    self._found_amicables.add(n)\n                if 1 <= sum_n <= limit:\n                    self._found_amicables.add(sum_n)\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        \"\"\"Computes and returns the sum of all amicable numbers up to the limit.\"\"\"\n        for n in range(1, limit + 1):\n            if n not in self._found_amicables: # Optimize by not re-checking already found amicables\n                self._record_if_amicable(n, limit)\n        \n        final_result = Result(list(self._found_amicables))\n        return final_result.sum\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number.\n    Raises ValueError if limit is not an integer or is less than 1.\n    \"\"\"\n    if not isinstance(limit, int) or limit < 1:\n        raise ValueError(\"Limit must be an integer greater than or equal to 1.\")\n    \n    calculator = AmicableCalculator()\n    return calculator.amicable_numbers_sum(limit)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/125": [{"task_id": "Mbpp/125", "solution": "def find_length(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s in any substring.\n    \"\"\"\n    class InvalidBinaryStringError(ValueError):\n        \"\"\"Exception raised for invalid characters in a binary string.\"\"\"\n        def __init__(self, message: str = \"Input contains invalid characters; only '0' and '1' allowed.\") -> None:\n            super().__init__(message)\n\n    class Validator:\n        \"\"\"Validates that a string contains only '0' and '1' characters.\"\"\"\n        def validateCharacters(self, value: str) -> None:\n            for char in value:\n                if char not in ('0', '1'):\n                    raise InvalidBinaryStringError()\n\n    class BinaryString:\n        \"\"\"Represents the input binary string, holding its value and length.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value: str = value\n            self.length: int = len(value)\n\n        def validate(self) -> None:\n            \"\"\"Validates the binary string, raising InvalidBinaryStringError if invalid.\"\"\"\n            validator = Validator()\n            validator.validateCharacters(self.value)\n\n    class Substring:\n        \"\"\"Data holder describing a contiguous substring and its computed difference.\"\"\"\n        def __init__(self, start_index: int, end_index: int, zeros_count: int, ones_count: int) -> None:\n            self.start_index: int = start_index\n            self.end_index: int = end_index\n            self.zeros_count: int = zeros_count\n            self.ones_count: int = ones_count\n            self.difference: int = zeros_count - ones_count\n\n    class Result:\n        \"\"\"Holds the maximum difference computed by the Finder.\"\"\"\n        def __init__(self, max_difference: int) -> None:\n            self.max_difference: int = max_difference\n\n    class Finder:\n        \"\"\"Finds the maximum difference between zeros and ones in any substring.\"\"\"\n        def __init__(self, input_string: BinaryString) -> None:\n            self._input_string = input_string\n\n        def find_length(self) -> int:\n            \"\"\"Computes and returns the maximum difference (zeros - ones).\"\"\"\n            if self._input_string.length == 0:\n                return 0\n            return self._max_diff_kadane()\n\n        def _max_diff_kadane(self) -> int:\n            \"\"\"Efficiently computes the maximum difference using Kadane's algorithm.\"\"\"\n            mapped_values = []\n            for char in self._input_string.value:\n                mapped_values.append(1 if char == '0' else -1)\n\n            max_so_far = mapped_values[0]\n            current_max = mapped_values[0]\n\n            for i in range(1, len(mapped_values)):\n                current_max = max(mapped_values[i], current_max + mapped_values[i])\n                max_so_far = max(max_so_far, current_max)\n            \n            return max_so_far\n\n    binary_string = BinaryString(input_string)\n    binary_string.validate()\n\n    finder = Finder(binary_string)\n    return finder.find_length()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Computes the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n\n    class ArrayInput:\n        \"\"\"Represents ordered input array preserving indices.\"\"\"\n        def __init__(self, elements: list[int]):\n            self.elements = elements\n\n        def __len__(self) -> int:\n            return len(self.elements)\n\n        def __getitem__(self, index: int) -> int:\n            return self.elements[index]\n\n    class Element:\n        \"\"\"Represents a value/index pair.\"\"\"\n        def __init__(self, value: int, index: int):\n            self.value = value\n            self.index = index\n\n    class Subsequence:\n        \"\"\"Represents a subsequence and can compute its sum.\"\"\"\n        def __init__(self, elements: list[Element]):\n            self.elements = elements\n\n        def sum(self) -> int:\n            return sum(e.value for e in self.elements)\n\n    class BitonicSubsequence(Subsequence):\n        \"\"\"Represents a bitonic subsequence and can validate its property.\"\"\"\n        def isBitonic(self) -> bool:\n            if not self.elements:\n                return True\n            \n            n = len(self.elements)\n            # Find the peak element\n            peak_index = 0\n            while peak_index < n - 1 and self.elements[peak_index].value < self.elements[peak_index+1].value:\n                peak_index += 1\n            \n            # Check strictly increasing part\n            for i in range(1, peak_index + 1):\n                if self.elements[i].value <= self.elements[i-1].value:\n                    return False\n            \n            # Check strictly decreasing part\n            for i in range(peak_index + 1, n):\n                if self.elements[i].value >= self.elements[i-1].value:\n                    return False\n            \n            return True\n\n    class Result:\n        \"\"\"Container for the algorithm's maximum sum result.\"\"\"\n        def __init__(self, maxSum: int):\n            self.maxSum = maxSum\n\n    class MaxSumCalculator:\n        \"\"\"Encapsulates the algorithm to compute maximum-sum bitonic subsequence.\"\"\"\n        def max_sum(self, arr_input: ArrayInput) -> int:\n            n = len(arr_input)\n            if n == 0:\n                return 0\n            if n == 1: # A single element is considered bitonic (both inc and dec)\n                return arr_input[0]\n\n            # Compute inc_sum[i]: maximum-sum strictly increasing subsequence ending at index i\n            inc_sum = [0] * n\n            for i in range(n):\n                inc_sum[i] = arr_input[i]\n                for j in range(i):\n                    if arr_input[i] > arr_input[j] and inc_sum[i] < inc_sum[j] + arr_input[i]:\n                        inc_sum[i] = inc_sum[j] + arr_input[i]\n\n            # Compute dec_sum[i]: maximum-sum strictly decreasing subsequence starting at index i\n            dec_sum = [0] * n\n            for i in range(n - 1, -1, -1):\n                dec_sum[i] = arr_input[i]\n                for j in range(n - 1, i, -1):\n                    if arr_input[i] > arr_input[j] and dec_sum[i] < dec_sum[j] + arr_input[i]:\n                        dec_sum[i] = dec_sum[j] + arr_input[i]\n\n            # For each index i, compute candidate = inc_sum[i] + dec_sum[i] - value[i]\n            # (value[i] is subtracted because it's counted in both inc_sum[i] and dec_sum[i])\n            max_overall_sum = -float('inf')\n            for i in range(n):\n                # A valid bitonic subsequence must have at least one increasing and one decreasing part\n                # or just an increasing or just a decreasing part (single element acts as both peak).\n                # To be a valid peak 'i', it must be possible to form both an increasing and decreasing part\n                # (even if one part is just 'i' itself). The check `inc_sum[i] > arr_input[i]` implies there\n                # was a preceding element in the increasing part, and `dec_sum[i] > arr_input[i]` implies\n                # there was a succeeding element in the decreasing part.\n                # If only arr_input[i] is considered for one part, then its sum will be just arr_input[i].\n                # If inc_sum[i] == arr_input[i] and dec_sum[i] == arr_input[i], it means 'i' cannot extend\n                # any increasing or decreasing sequence from prior/after, which means it cannot form a bitonic\n                # sequence of length > 1, unless it's just itself. But the problem implies >1 for a \"sequence\".\n                # The assertion example suggests that inc_sum and dec_sum can be just the element itself.\n                # So we simply check if a bitonic sequence of length >= 1 is possible at index i.\n                # If n is 1, max_overall_sum initialized to -inf would return arr[0] correctly.\n                # If n > 1 and all elements are increasing or decreasing, some intermediate calculations might\n                # lead to a valid bitonic sequence of length 2 or more.\n                \n                # A bitonic subsequence must have at least two elements to be meaningful as \"increasing then decreasing\".\n                # If inc_sum[i] == arr_input[i] AND dec_sum[i] == arr_input[i], it means element i itself\n                # is the entire \"increasing\" part and the entire \"decreasing\" part. Such a sequence has length 1.\n                # If the problem strictly means \"first increasing AND THEN decreasing\" with >1 length,\n                # we would need to filter cases where `inc_sum[i] == arr_input[i]` and `dec_sum[i] == arr_input[i]`.\n                # However, the standard interpretation allows subsequences that are purely increasing or purely decreasing\n                # to be considered bitonic (with peak at end/start respectively), as long as length >= 1.\n                # So, (inc_sum[i] - arr_input[i] + dec_sum[i]) > 0 for a valid sum means length > 1 if sum includes arr_input[i].\n                # Or, if inc_sum[i] == arr_input[i] and dec_sum[i] == arr_input[i], then the sum is arr_input[i].\n                \n                current_sum = inc_sum[i] + dec_sum[i] - arr_input[i]\n                \n                # If the current sum is just the element itself (meaning no valid increasing or decreasing extension),\n                # we only consider it if it's the only element or if it can still form a valid bitonic sequence (length > 1).\n                # A bitonic sequence must have at least two elements, or one element if it is trivially both increasing and decreasing.\n                # The minimum sum is from a single element, which should be included if it's the only option or part of a larger sum.\n                # The problem statement example has a positive sum, so negative intermediate values could be ignored if we want only positive sums.\n                # But typically, it's about max sum, which can be negative if all numbers are negative.\n                \n                # The standard definition of bitonic implies it must be increasing *and* decreasing.\n                # This usually means it must have a length of at least 2.\n                # If inc_sum[i] == arr_input[i] and dec_sum[i] == arr_input[i], it means this element 'i' is not a \"peak\"\n                # in a sequence that has both an increasing part *before* it AND a decreasing part *after* it.\n                # However, a sequence that is purely increasing (with peak at end) or purely decreasing (with peak at start)\n                # is also often considered bitonic.\n                # To ensure we only pick sequences of length >= 1 for each part that contributes:\n                # A sequence of length 1 (arr_input[i]) is formed if inc_sum[i] == arr_input[i] AND dec_sum[i] == arr_input[i].\n                # A bitonic sequence of length 1 is arr_input[i]. Its sum is arr_input[i].\n                # This logic is correct for bitonic sequences of length >= 1.\n                if current_sum > max_overall_sum:\n                    max_overall_sum = current_sum\n            \n            # If all numbers are negative, and max_overall_sum remains -inf or is 0,\n            # we should return the largest single element, or 0 if it must be non-negative.\n            # Assuming it can be negative.\n            # However, `inc_sum` and `dec_sum` calculations naturally handle negative numbers\n            # by potentially only including single numbers or not extending sequences if it reduces sum.\n            \n            # If max_overall_sum is still -inf, it implies an empty array, which is handled at the start.\n            # Or if `n == 0` case. If `n > 0` but `max_overall_sum` is not updated because all `current_sum`\n            # are less than -inf (which is impossible), then we might have an issue.\n            # But `inc_sum[i]` and `dec_sum[i]` are initialized with `arr_input[i]`, so they're at least `arr_input[i]`.\n            # Thus, `current_sum` will be at least `arr_input[i]`. `max_overall_sum` will be at least the maximum single element.\n            return Result(max_overall_sum).maxSum\n\n    array_input_obj = ArrayInput(arr)\n    return MaxSumCalculator().max_sum(array_input_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/259": [{"task_id": "Mbpp/259", "solution": "def maximize_elements(input1: tuple, input2: tuple) -> tuple:\n    \"\"\"\n    Combines two tuples of 2-element numeric tuples by taking the maximum\n    of corresponding elements at each position.\n    \"\"\"\n    _validate_inputs(input1, input2)\n\n    result_list = []\n    for i in range(len(input1)):\n        first_max = max(input1[i][0], input2[i][0])\n        second_max = max(input1[i][1], input2[i][1])\n        result_list.append((first_max, second_max))\n    \n    return tuple(result_list)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 3], [4, 5], [2, 9], [1, 10]], [[6, 7], [3, 9], [1, 1], [7, 3]]]], "plus_fail_tests": [[[[1, 2], [3, 4], [5, 6], [7, 8]], [[8, 7], [6, 5], [4, 3], [2, 1]]]]}], "Mbpp/264": [{"task_id": "Mbpp/264", "solution": "from dataclasses import dataclass\nclass DogAgeCalculator:\n    \"\"\"Encapsulates the logic for converting human years to dog years.\"\"\"\n    def calculate(self, humanYears: int) -> int:\n        \"\"\"Calculates dog years based on human years, satisfying dog_age(12) == 61.\"\"\"\n        if humanYears <= 0:\n            return 0\n        elif humanYears <= 2:\n            return int(humanYears * 10.5)\n        else:\n            return int(2 * 10.5 + (humanYears - 2) * 4)\ndef dog_age(age: int) -> int:\n    \"\"\"Top-level API. Accepts integer 'age' (human years) and returns integer dog years.\"\"\"\n    calc = DogAgeCalculator()\n    return calc.calculate(age)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/266": [{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side):\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    Raises TypeError if side is not a numeric type.\n    \"\"\"\n    def _validate_numeric(s_val):\n        \"\"\"Internal helper to validate that the input 's_val' is a numeric type (int or float).\"\"\"\n        if not isinstance(s_val, (int, float)):\n            raise TypeError(\"Side length must be a numeric value.\")\n\n    def _compute_lateral_surface(s_len):\n        \"\"\"Internal helper to compute the lateral surface area (4 * s_len * s_len).\"\"\"\n        return 4 * s_len * s_len\n\n    _validate_numeric(side)\n    return _compute_lateral_surface(side)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/261": [{"task_id": "Mbpp/261", "solution": "from typing import List\nclass ValidationError(Exception):\n    \"\"\"Exception raised for validation errors in tuple division.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{self.code}] {self.message}\")\nclass ResultTuple:\n    \"\"\"Holds computed results and provides conversion to an immutable tuple.\"\"\"\n    def __init__(self, values: List[float]):\n        self.values = values\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the list of results to an immutable tuple.\"\"\"\n        return tuple(self.values)\nclass Validator:\n    \"\"\"Performs various validation checks on input tuples.\"\"\"\n    def check_types(self, input1, input2) -> None:\n        \"\"\"Ensures both inputs are tuples.\"\"\"\n        if not isinstance(input1, tuple) or not isinstance(input2, tuple):\n            raise ValidationError(\n                code='TYPE_MISMATCH',\n                message='Both inputs must be tuples.'\n            )\n\n    def check_length(self, input1: tuple, input2: tuple) -> None:\n        \"\"\"Ensures both input tuples have the same length.\"\"\"\n        if len(input1) != len(input2):\n            raise ValidationError(\n                code='LENGTH_MISMATCH',\n                message='Input tuples must have the same length.'\n            )\n\n    def check_no_zero_denominator(self, denominator: tuple) -> None:\n        \"\"\"Ensures the denominator tuple contains no zero values.\"\"\"\n        if 0 in denominator:\n            raise ValidationError(\n                code='ZERO_DENOMINATOR',\n                message='Denominator tuple cannot contain zero.'\n            )\nclass DivisionService:\n    \"\"\"Orchestrates validation and performs element-wise division.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def division_elements(self, numerator: tuple, denominator: tuple) -> tuple:\n        \"\"\"\n        Validates inputs and computes element-wise division.\n        \"\"\"\n        self._validator.check_types(numerator, denominator)\n        self._validator.check_length(numerator, denominator)\n        self._validator.check_no_zero_denominator(denominator)\n\n        results = []\n        for n, d in zip(numerator, denominator):\n            # Perform float division, then cast to int to match canonical example's expected output type.\n            results.append(int(n / d))\n\n        result_obj = ResultTuple(results)\n        return result_obj.to_tuple()\ndef division_elements(numerator: tuple, denominator: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division operation across two given tuples.\n\n    Raises ValidationError for invalid input types, lengths, or zero denominators.\n    \"\"\"\n    service = DivisionService()\n    return service.division_elements(numerator, denominator)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 2, 3, 3], [5, 2, 3, 4]]]}], "Mbpp/262": [{"task_id": "Mbpp/262", "solution": "from typing import List, Tuple\nclass InputList:\n    \"\"\"\n    Lightweight wrapper around a language-level list to express domain operations.\n    Provides methods for length and slicing as per design.\n    \"\"\"\n    def __init__(self, elements: List) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get_slice(self, start: int, end: int) -> List:\n        return self._elements[start:end]\nclass SplitResult:\n    \"\"\"\n    Encapsulates two resulting lists and provides conversion to the tuple returned by API.\n    Used to structure the output as per design.\n    \"\"\"\n    def __init__(self, first_part: List, second_part: List) -> None:\n        self._first_part = first_part\n        self._second_part = second_part\n\n    def as_tuple(self) -> Tuple[List, List]:\n        return (self._first_part, self._second_part)\ndef split_two_parts(input_list: List, L: int) -> Tuple[List, List]:\n    \"\"\"\n    Splits a list into two parts where the first part has length L, returning them as a tuple.\n    Utilizes helper classes InputList and SplitResult as per design.\n    \"\"\"\n    # Instantiate InputList to wrap the input and access its properties.\n    input_wrapper = InputList(input_list)\n    list_length = input_wrapper.length()\n\n    # Use InputList's get_slice method to create the two parts.\n    # Python's list slicing naturally handles L=0 and L=len(input_list) boundary conditions.\n    first_part = input_wrapper.get_slice(0, L)\n    second_part = input_wrapper.get_slice(L, list_length)\n\n    # Encapsulate the resulting parts in a SplitResult object and return as a tuple.\n    result = SplitResult(first_part, second_part)\n    return result.as_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/256": [{"task_id": "Mbpp/256", "solution": "import math\nclass NumberInput:\n    def __init__(self, value):\n        self.value = value\n\n    def is_non_negative(self):\n        return self.value >= 0\nclass PrimeChecker:\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\n        Uses trial division up to the square root of the number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check odd divisors from 3 up to the integer square root.\n        for divisor in range(3, int(math.isqrt(num)) + 1, 2):\n            if num % divisor == 0:\n                return False\n        return True\nclass PrimeCounter:\n    def count_Primes_nums(self, n) -> int:\n        \"\"\"Counts prime numbers strictly less than n.\n        Returns 0 if n is less than or equal to 2, otherwise iterates and checks primality.\"\"\"\n        if n <= 2:\n            return 0\n\n        prime_count = 0\n        # Iterate up to floor(n) - 1 to count primes p where p < n.\n        upper_bound_exclusive = int(math.floor(n))\n        checker = PrimeChecker()\n\n        for p in range(2, upper_bound_exclusive):\n            if checker.is_prime(p):\n                prime_count += 1\n        return prime_count\ndef count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number.\n    Handles type and value validation before delegating to a PrimeCounter.\n    \"\"\"\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"n must be a number\")\n\n    number_input = NumberInput(n)\n    if not number_input.is_non_negative():\n        raise ValueError(\"n must be a non-negative number\")\n\n    # Handle the base case where no primes exist below or at n=2.\n    if n <= 2:\n        return 0\n\n    counter = PrimeCounter()\n    return counter.count_Primes_nums(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/260": [{"task_id": "Mbpp/260", "solution": "class InputValidator:\n    \"\"\"Validates input parameter n.\"\"\"\n    def validate_n(self, n) -> None:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\nclass NewmanShanksWilliamsSequence:\n    \"\"\"Computes Newman-Shanks-Williams sequence values using memoization.\"\"\"\n    def __init__(self):\n        self._memo = {0: 1, 1: 1}\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes S(n) using memoization and iterative calculation.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        # Calculate values iteratively up to n and store in memo.\n        # Ensure memo has values up to n, starting from last known or 2.\n        for i in range(max(self._memo.keys()) + 1, n + 1):\n            self._memo[i] = 2 * self._memo[i-1] + self._memo[i-2]\n        \n        return self._memo[n]\n\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"Alternative iterative implementation for S(n).\"\"\"\n        if n == 0:\n            return 1\n        if n == 1:\n            return 1\n\n        a, b = 1, 1 # S(0), S(1)\n        for _ in range(2, n + 1):\n            next_val = 2 * b + a\n            a = b\n            b = next_val\n        return b\nclass PrimeChecker:\n    \"\"\"Provides primality checking utilities for future use.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Determines if a number is prime using a deterministic test.\"\"\"\n        if x <= 1:\n            return False\n        if x <= 3:\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        while i * i <= x:\n            if x % i == 0 or x % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def is_probable_prime(self, x: int) -> bool:\n        \"\"\"Checks if a number is a probable prime (delegates to deterministic check).\"\"\"\n        return self.is_prime(x)\nclass NewmanPrimeService:\n    \"\"\"Orchestrates validation and Newman-Shanks-Williams sequence computation.\"\"\"\n    def __init__(self, sequence=None, validator=None, checker=None):\n        self._sequence = sequence or NewmanShanksWilliamsSequence()\n        self._validator = validator or InputValidator()\n        self._checker = checker or PrimeChecker() # Included per design, not used for S(n) directly.\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"Validates input and computes the nth Newman-Shanks-Williams number.\"\"\"\n        self._validator.validate_n(n)\n        return self._sequence.compute(n)\ndef newman_prime(n: int) -> int:\n    \"\"\"Finds the nth Newman-Shanks-Williams number (S(n)).\"\"\"\n    service = NewmanPrimeService()\n    return service.newman_prime(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/267": [{"task_id": "Mbpp/267", "solution": "class OddNumberSequence:\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Return list of first n odd natural numbers (1, 3, 5, ...).\"\"\"\n        odd_numbers = []\n        current_odd = 1\n        for _ in range(n):\n            odd_numbers.append(current_odd)\n            current_odd += 2\n        return odd_numbers\nclass Result:\n    def __init__(self, value: int) -> None:\n        \"\"\"Lightweight container holding the integer result.\"\"\"\n        self.value: int = value\ndef square_Sum(n: int) -> int:\n    \"\"\"Compute and return sum of squares of first n odd natural numbers.\"\"\"\n    odd_seq_gen = OddNumberSequence()\n    odd_numbers = odd_seq_gen.generate(n)\n\n    sum_of_squares = 0\n    for num in odd_numbers:\n        sum_of_squares += num * num\n\n    result_obj = Result(sum_of_squares)\n    return result_obj.value", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000.0]]}], "Mbpp/269": [{"task_id": "Mbpp/269", "solution": "def ascii_value(character: str) -> int:\n    \"\"\"Return ASCII integer code for a single-character string.\n    Raises ValueError if character is not a string of length 1.\n    \"\"\"\n    if len(character) != 1:\n        raise ValueError(\"Input must be a single character string.\")\n    return ord(character)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/272": [{"task_id": "Mbpp/272", "solution": "def validate_input(tuples_list) -> bool:\n    \"\"\"Checks if the input is a list of tuples for rear_extract.\"\"\"\n    if not isinstance(tuples_list, list):\n        return False\n    for item in tuples_list:\n        if not isinstance(item, tuple):\n            return False\n    return True\ndef rear_extract(tuples_list) -> list:\n    \"\"\"Extracts the rear element from each tuple in a list.\"\"\"\n    if not validate_input(tuples_list):\n        raise TypeError(\"Input must be a list of tuples.\")\n\n    extracted_elements = []\n    for tpl in tuples_list:\n        extracted_elements.append(tpl[-1])\n    return extracted_elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/268": [{"task_id": "Mbpp/268", "solution": "def find_star_num(n: int) -> int:\n    \"\"\"\n    Finds the n'th star number using the formula 6 * n * (n - 1) + 1.\n    Validates input n to be an integer >= 1.\n    \"\"\"\n\n    class StarNumberCalculator:\n        \"\"\"\n        Calculates and validates star num