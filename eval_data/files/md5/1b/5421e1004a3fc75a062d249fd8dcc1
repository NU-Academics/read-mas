\n            return True\n\n    class PathCalculator:\n        \"\"\"Calculates the maximum path sum and then the maximum average using dynamic programming.\"\"\"\n        def computeMaxAverage(self, matrix_obj: Matrix) -> float:\n            if matrix_obj.N == 1:\n                return float(matrix_obj.cells[0][0])\n            \n            max_sum = self._computeMaxSumDP(matrix_obj)\n            path_length = 2 * matrix_obj.N - 1\n            return float(max_sum) / path_length\n\n        def _computeMaxSumDP(self, matrix_obj: Matrix) -> Union[float, int]:\n            N = matrix_obj.N\n            cells = matrix_obj.cells\n\n            dp = [[0.0] * N for _ in range(N)]\n\n            dp[0][0] = cells[0][0]\n\n            for j in range(1, N):\n                dp[0][j] = dp[0][j-1] + cells[0][j]\n\n            for i in range(1, N):\n                dp[i][0] = dp[i-1][0] + cells[i][0]\n\n            for i in range(1, N):\n                for j in range(1, N):\n                    dp[i][j] = cells[i][j] + max(dp[i-1][j], dp[i][j-1])\n            \n            return dp[N-1][N-1]\n\n    matrix_obj = Matrix(matrix)\n    \n    validator_obj = Validator()\n    validator_obj.validateShape(matrix_obj)\n    validator_obj.validateNumeric(matrix_obj)\n    \n    calculator_obj = PathCalculator()\n    return calculator_obj.computeMaxAverage(matrix_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/724": [{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Validates inputs and performs exact exponentiation.\n    \"\"\"\n\n    def _validate_inputs(base, power):\n        \"\"\"Validates that base and power are integers and power is non-negative.\"\"\"\n        if not isinstance(base, int) or not isinstance(power, int):\n            raise TypeError(\"Both 'base' and 'power' must be integers.\")\n        if power <