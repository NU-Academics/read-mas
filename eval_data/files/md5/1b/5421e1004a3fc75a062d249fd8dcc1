)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/300": [{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n):\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits. This value is the central binomial coefficient C(2n, n).\n    \"\"\"\n    def _factorial(val):\n        \"\"\"Helper function to compute factorial of a non-negative integer.\"\"\"\n        if val == 0:\n            return 1\n        res = 1\n        for i in range(1, val + 1):\n            res *= i\n        return res\n\n    # The number of such sequences is given by the central binomial coefficient C(2n, n).\n    # This is calculated as (2n)! / (n! * n!).\n    numerator = _factorial(2 * n)\n    denominator = _factorial(n) * _factorial(n)\n    return numerator / denominator", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000]]}], "Mbpp/296": [{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-sort based algorithm.\n    Validates input and ensures array immutability.\n    \"\"\"\n\n    def validate_input(arr_to_validate: list) -> bool:\n        \"\"\"\n        Validates that the input is an iterable (list-like).\n        Raises ValueError if the input is not iterable.\n        \"\"\"\n        if not hasattr(arr_to_validate, '__iter__'):\n            raise ValueError(\"Input must be an iterable (e.g., list, tuple).\")\n        return True\n\n    def _merge_and_count(left: list, right: list) -> tuple[list, int]:\n        \"\"\"\n        Merges two sorted lists and counts cross inversions.\n        Returns the merged sorted list and the count of cross inversions.\n        \"\"\"\n        merged_list = []\n        inversions = 0\n        i, j = 0, 0\n        n1, n2 = len(left), len(right)\n\n        while i < n1 and j < n2:\n            if left[i] <= right[j]:\n                merged_list.append(left[i])\n                i += 1\n            else:\n                # If left[i] > right[j], all remaining elements in left are also greater than right[j].\n                inversions += (n1 - i)\n                merged_list.append(right[j])\n                j += 1\n\n        merged_list.extend(left[i:])\n        merged_list.extend(right[j:])\n\n        return merged_list, inversions\n\n    def count_merge_sort(arr_to_sort: list) -> int:\n        \"\"\"\n        Counts inversions using a recursive merge sort approach on a shallow copy.\n        This function orchestrates the recursive counting process.\n        \"\"\"\n        # Create a shallow copy for the recursive process to ensure input immutability.\n        temp_arr_for_sort = list(arr_to_sort)\n\n        def _merge_sort_recursive(sub_arr: list) -> tuple[list, int]:\n            \"\"\"\n            Recursive helper that returns a sorted sub-array and its inversion count.\n            \"\"\"\n            n = len(sub_arr)\n            if n <= 1:\n                return sub_arr, 0\n\n            mid = n // 2\n            \n            # Recursively count inversions in left and right halves.\n            left_sorted, left_inversions = _merge_sort_recursive(sub_arr[:mid])\n            right_sorted, right_inversions = _merge_sort_recursive(sub_arr[mid:])\n\n            # Merge sorted halves and count cross-inversions.\n            merged_sorted, cross_inversions = _merge_and_count(left_sorted, right_sorted)\n\n            total_inversions = left_inversions + right_inversions + cross_inversions\n            return merged_sorted, total_inversions\n\n        _, inversions = _merge_sort_recursive(temp_arr_for_sort)\n        return inversions\n\n    # Main logic for get_Inv_Count\n    validate_input(arr)\n    return count_merge_sort(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/301": [{"