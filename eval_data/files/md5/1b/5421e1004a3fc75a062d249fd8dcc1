capsulates raw text content and provides a method to tokenize it into Word objects.\n    \"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def getWords(self) -> list:\n        \"\"\"\n        Tokenizes the text content into Word objects using the extract_words function.\n        \"\"\"\n        return extract_words(self.content)\ndef extract_words(text: str) -> list:\n    \"\"\"\n    Extracts consecutive ASCII alphabetic runs from the input text as Word objects.\n    Punctuation and whitespace are ignored.\n    \"\"\"\n    words = []\n    current_word_letters = []\n    current_word_start_index = -1\n\n    for i, char in enumerate(text):\n        if 'a' <= char.lower() <= 'z':  # Check for ASCII alphabetic character\n            if current_word_start_index == -1:\n                current_word_start_index = i\n            current_word_letters.append(char)\n        else:  # Not alphabetic, potentially a word boundary\n            if current_word_letters:  # If we were accumulating a word\n                letters_str = \"\".join(current_word_letters)\n                # endIndex is inclusive\n                end_index = current_word_start_index + len(letters_str) - 1\n                words.append(Word(letters_str, current_word_start_index, end_index))\n                current_word_letters = []\n                current_word_start_index = -1\n    \n    # Handle the case where the text ends with an alphabetic word\n    if current_word_letters:\n        letters_str = \"\".join(current_word_letters)\n        end_index = current_word_start_index + len(letters_str) - 1\n        words.append(Word(letters_str, current_word_start_index, end_index))\n            \n    return words\nclass Matcher:\n    \"\"\"\n    Orchestrates the process of tokenizing text and checking words for the middle 'z' condition.\n    \"\"\"\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"\n        Checks if any alphabetic word in the text contain