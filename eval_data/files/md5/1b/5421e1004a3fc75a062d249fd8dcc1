r equal to 1, raising InvalidNException if not.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise InvalidNException(\"n must be an integer >= 1\")\n\n    def distribute(self, input_list: InputList, n: int) -> list:\n        \"\"\"Distributes elements from InputList into n sublists based on index modulo n.\"\"\"\n        sublists = [Sublist() for _ in range(n)]\n        \n        for i in range(input_list.length()):\n            element = input_list.get(i)\n            target_sublist_idx = i % n\n            sublists[target_sublist_idx].append(element)\n            \n        return [sublist.as_list() for sublist in sublists]\ndef list_split(lst: list, n: int) -> list:\n    \"\"\"\n    Splits a list into n sublists, placing each element at original index i into sublist (i mod n).\n    Raises InvalidNException if n is not an integer greater than 0.\n    \"\"\"\n    splitter = ListSplitter()\n    splitter.validate_n(n)\n    \n    input_list = InputList(lst)\n    \n    return splitter.distribute(input_list, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/270": [{"task_id": "Mbpp/270", "solution": "class InputValidator:\n    def validate(self, lst) -> None:\n        \"\"\"Raises TypeError if the input is not a Python list.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a Python list.\")\nclass Element:\n    def __init__(self, index: int, value) -> None:\n        \"\"\"Initializes an Element with its index and value.\"\"\"\n        self.index = index\n        self.value = value\n\n    def is_even_index(self) -> bool:\n        \"\"\"Checks if the element's index is even.\"\"\"\n        return self.index % 2 == 0\n\n    def is_even_number(self) -> bool:\n        \"\"\"Checks if the element's value is an even integer.\"\"\"\n        return isinstance(self.value, int) and self.value % 2 == 0\ndef sum_even_and_even_index(lst) -> int:\n    \"\"\"\n    Finds the