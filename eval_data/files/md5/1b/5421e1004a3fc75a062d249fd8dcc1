           self.index = index\n            self.rotated_value = rotated_value\n\n        def is_odd(self) -> bool:\n            \"\"\"Determines if the rotated value represents an odd number.\"\"\"\n            return self.rotated_value and self.rotated_value[-1] == '1'\n\n    class Result:\n        \"\"\"Simple Data Transfer Object for the final odd_count.\"\"\"\n        def __init__(self, odd_count: int):\n            self.odd_count = odd_count\n\n    class OddEquivalentFunction:\n        \"\"\"Coordinates validation and computation for odd_Equivalent.\"\"\"\n        def __init__(self, binary_string: str, rotations: int):\n            self.binary_string = binary_string\n            self.rotations = rotations\n            self.odd_count = 0\n\n        def validate(self):\n            \"\"\"Validates inputs and raises ValueError if invalid.\"\"\"\n            binary_obj = BinaryString(self.binary_string)\n            if not binary_obj.is_valid():\n                raise ValueError(\"binary_string must contain only '0' and '1'\")\n\n            if not isinstance(self.rotations, int) or self.rotations < 0:\n                raise ValueError(\"rotations must be a non-negative integer\")\n\n        def compute(self) -> Result:\n            \"\"\"Performs rotations and counts odd values based on the design.\"\"\"\n            if self.rotations == 0:\n                return Result(0)\n\n            binary_obj = BinaryString(self.binary_string)\n            \n            for i in range(1, self.rotations + 1):\n                rotated_val_for_this_iteration = \"\"\n                if i == 1:\n                    rotated_val_for_this_iteration = binary_obj.value\n                else:\n                    rotated_val_for_this_iteration = binary_obj.rotateLeft(i - 1)\n                \n                rotation_instance = RotationInstance(i, rotated_val_for_this_iteration)\n                if rotation_instance.is_odd():\n                    self.odd_count += 1\n\n            return Result(self.odd_count)\n\n    coordinator = OddEquivalentFunction(binary_string, rotations)\n    coordinator.validate()\n    result = coordinator.compute()\n    return result.odd_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["10000100110011", 5]]}], "Mbpp/111": [{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds common elements in a list of nested lists.\n    Returns a set containing elements present in every inner list.\n    \"\"\"\n    # If the input list of lists is empty, there are no common elements.\n    if not nested_lists:\n        return set()\n\n    # Start with the elements of the first list as the initial set of common elements.\n    # Converting to a set efficiently handles duplicates within the first list.\n    common_elements = set(nested_lists[0])\n\n    # If the first list itself was empty, then the common_elements set is empty,\n    # and no further processing is needed as the intersection will always be empty.\n    if not common_elements:\n        return set()\n\n    # Iterate through the rest of the lists to find their intersection with the current common_elements.\n    for inner_list in nested_lists[1:]:\n        # Update common_elements by intersecting it with the current inner_list, converted to a set.\n        common_elements.intersection_update(inner_list)\n\n        # If at any point the common_elements set becomes empty,\n        # further intersections will also result in an empty set, so we can return early.\n        if not common_elements:\n            return set()\n\n    return common_elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/119": [{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"Public API: finds the element that appears only once in a sorted array.\"\"\"\n\n    class SearchFunction:\n        \"\"\"Encapsulates the algorithm 