nts the current 'm' value; valid j for A(i, j) are from 0 to i-1\n        for j in range(i):\n            # Term 1: (i - j) * A(i-1, j-1)\n            # A(i-1, j-1) is 0 if j-1 is out of range (< 0)\n            term1 = 0\n            if j - 1 >= 0:\n                term1 = (i - j) * dp[i-1][j-1]\n\n            # Term 2: (j + 1) * A(i-1, j)\n            # A(i-1, j) is 0 if j is out of range (>= i-1, as valid m for n-1 is 0 to n-2)\n            term2 = 0\n            if j < i - 1:\n                term2 = (j + 1) * dp[i-1][j]\n            \n            dp[i][j] = term1 + term2\n\n    return dp[n][m]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/105": [{"task_id": "Mbpp/105", "solution": "def count(values: list) -> int:\n    \"\"\"Count only elements that are of type bool and value True.\n\n    Ignores non-boolean elements.\n    \"\"\"\n    true_count = 0\n    for element in values:\n        if isinstance(element, bool) and element is True:\n            true_count += 1\n    return true_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/106": [{"task_id": "Mbpp/106", "solution": "def add_lists(inputList, inputTuple):\n    \"\"\"\n    Return a tuple that contains the elements of inputTuple followed by the elements of inputList.\n    \"\"\"\n    return inputTuple + tuple(inputList)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/108": [{"task_id": "Mbpp/108", "solution": "from typing import List, Optional\nclass MergeRequest:\n    def __init__(self, list1: List[int], list2: List[int], list3: List[int]) -> None:\n        self.list1: List[int] = list1\n        self.list2: List[int] = list2\n        self.list3: List[int] = list3\nclass MergeResult:\n    def __init__(self, merged_list: List[int]) -> None:\n        self.merged_list: List[int] = merged_list\nclass MergeService:\n    def __init__(self) -> None:\n        self._request: Optional[MergeRequest] = None\n\n    def merge_sorted_list(self, list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n        self._request = MergeRequest(list1, list2, list3)\n        # Concatenate inputs into a new list, preserving original lists.\n        merged = self._request.list1 + self._request.list2 + self._request.list3\n        # Sort the new list in ascending order.\n        sorted_merged = sorted(merged)\n        result = MergeResult(sorted_merged)\n        return result.merged_list\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"Public API (FR1): delegates to MergeService.\"\"\"\n    service = MergeService()\n    return service.merge_sorted_list(list1, list2, list3)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/118": [{"task_id": "Mbpp/118", "solution": "def string_to_list(s: str) -> list[str]:\n    \"\"\"Converts a string to a list of strings by splitting on the ASCII space character.\"\"\"\n    return s.split(' ')", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/84": [{"task_id": "Mbpp/84", "solution": "class InputValidator:\n    \"\"\"Validates input n, returning true for valid inputs.\"\"\"\n    def isValid(self, n: int) -> bool:\n        \"\"\"\n        Always returns True to adhere to constraints on not checking types or raising errors.\n        \"\"\"\n        return True\nclass NewmanConwayGenerator:\n    \"\"\"Computes Newman-Conway sequence values and caches them.\"\"\"\n    def __init__(self):\n        # cache[0] holds a(1), cache[1] holds a(2), etc.\n        # Base cases: a(1)=1, a(2)=1\n        self.cache = [1, 1]\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Newman-Conway sequence term, using a cache for efficiency.\n        \"\"\"\n        if n <= 0: # This case would typically be handled by InputValidator and raise an error.\n                   # Given constraints, we assume n is valid and >= 1.\n                   # If n=0, IndexError will occur, which aligns with 'no raise exceptions for edge cases'.\n            pass # The negative constraint means we don't explicitly handle this with a raise or isinstance.\n\n        # If the term is already in the cache, return it\n        if n <= len(self.cache):\n            return self.cache[n - 1]\n\n        # Compute iteratively from the current cache length up to n\n        for i in range(len(self.cache), n):\n            # For 1-based index k (current term to compute), k = i + 1\n            # Recurrence: a(k) = a(a(k-1)) + a(k - a(k-1))\n            # a(k-1) is self.cache[k-1 - 1] = self.cache[i-1]\n            val_a_k_minus_1 = self.cache[i - 1]\n\n            # First part: a(a(k-1))\n            first_term_index = val_a_k_minus_1 - 1\n            first_term = self.cache[first_term_index]\n\n            # Second part: a(k - a(k-1))\n            second_term_index = (i + 1) - val_a_k_minus_1 - 1\n            second_term = self.cache[second_term_index]\n\n            next_val = first_term + second_term\n            self.cache.append(next_val)\n\n        return self.cache[n - 1]\nclass SequenceService:\n    \"\"\"Orchestrates Newman-Conway sequence term generation.\"\"\"\n    _generator: NewmanConwayGenerator\n\n    def __init__(self):\n        self._validator = InputValidator()\n        self._generator = NewmanConwayGenerator()\n\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Returns the nth Newman-Conway sequence term.\n        Input validation is performed, but errors are not explicitly raised due to constraints.\n        \"\"\"\n        # Call validator as per design, but do not use its result to raise errors due to constraints.\n        _ = self._validator.isValid(n)\n        return self._generator.compute(n)\n_default_service = SequenceService()\ndef sequence(n: int) -> int:\n    \"\"\"\n   