        self.validate_inputs(a, b, c)\n        min_len = self._compute_min_length(a, b, c)\n\n        for i in range(min_len):\n            va = a[i]\n            vb = b[i]\n            vc = c[i]\n            if va == vb == vc:\n                self._counter += 1\n        return self._counter\ndef count_samepair(a: list, b: list, c: list) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Compares elements at each index across the three input lists and counts positions where all three elements are equal.\n    Comparisons are limited to indices present in all three lists (stops at min length).\n    \"\"\"\n    cf = CountSamepairFunction()\n    return cf.count_samepair(a, b, c)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "def remove_elements(list_a, list_b):\n    \"\"\"\n    Removes all elements from list_a that are present in list_b,\n    preserving the original relative order.\n    \"\"\"\n    elements_to_remove = set(list_b)\n    result = []\n    for item in list_a:\n        if item not in elements_to_remove:\n            result.append(item)\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, "apple", [1, 2], [3, 4], {"name": "John"}, 5.5], [2, "apple", [3, 4], {"name": "John"}, 5.5]]]}], "Mbpp/160": [{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    The solution is canonical, with x in the range [0, abs(b/g) - 1] where g = gcd(a,b).\n    \"\"\"\n\n    def extended_gcd(num1, num2):\n        # Computes g, x, y such that num1*x + num2*y = g = gcd(num1, num2).\n        # g is guaranteed to be non-negative.\n        \n        if num1 == 0:\n            return (abs(num2), 0, 1 if num2 >= 0 else -1)\n        if num2 == 0:\n            return (abs(num1), 1 if num1 >= 0 else -1, 0)\n\n        original_num1, original_num2 = num1, num2\n        \n        # Ensure positive for core Euclidean algorithm and then adjust signs.\n        a_abs, b_abs = abs(num1), abs(num2)\n\n        x0, y0 = 1, 0\n        x1, y1 = 0, 1\n\n        while b_abs != 0:\n            q = a_abs // b_abs\n            a_abs, b_abs = b_abs, a_abs % b_abs\n            x0, x1 = x1, x0 - q * x1\n            y0, y1 = y1, y0 - q * y1\n        \n        # a_abs is the GCD. Adjust Bezout coefficients for original numbers' signs.\n        x_final = x0 * (1 if original_num1 >= 0 else -1)\n        y_final = y0 * (1 if original_num2 >= 0 else -1)\n\n        return (a_abs, x_final, y_final)\n\n    g, x0, y0 = extended_gcd(a, b)\n\n    if g == 0:  # This implies a == 0 and b == 0\n        return (0, 0) if n == 0 else None\n\n    if n % g != 0:\n        return None\n\n    # Handle cases where one coefficient is zero but not both (since g != 0).\n    if a == 0: \n        return (0, n // b)\n    if b == 0:\n        return (n // a, 0)\n\n    # Both a and b are non-zero.\n    # Calculate a particular solution (x_p, y_p)\n    factor = n // g\n    x_p = x0 * factor\n    y_p = y0 * factor\n\n    # Apply canonical translation such that 0 <= x < abs(b // g).\n    # The general solution is x = x_p + k * (b/g), y = y_p - k * (a/g).\n    # We find k to shift x_p to the smallest non-negative x.\n    \n    b_prime = b // g # b_prime is non-zero here\n    a_prime = a // g # a_prime is non-zero here\n\n    # Calculate k to bring x_p into the range [0, abs(b_prime)-1].\n    # Python's `%` operator's result has the same sign as the divisor.\n    # To get a non-negative x, we use `x_p % abs(b_prime)`.\n    k_final = ( (x_p % abs(b_prime)) - x_p ) // b_prime\n\n    x_final = x_p + k_final * b_prime\n    y_final = y_p - k_final * a_prime\n\n    return (x_final, y_final)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_f