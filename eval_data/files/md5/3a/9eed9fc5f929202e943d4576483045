{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of '1' bits in the binary representation of a non-negative integer.\"\"\"\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    def custom_key(num):\n        if num < 0:\n            # Negative numbers are sorted purely by their decimal value.\n            # -1 is used as a placeholder for bit count to ensure they precede non-negative numbers.\n            return (-1, num)\n        else:\n            # Non-negative numbers are sorted by their set bit count, then by their decimal value.\n            return (_count_set_bits(num), num)\n\n    return sorted(arr, key=custom_key)"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if concatenating two parenthesis strings in any order results in a balanced string.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    '''\n    def is_balanced(s: str) -> bool:\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else: # char must be ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS_LOWERCASE = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS_LOWERCASE\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant (case-insensitive).\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first (index 0) and last (index n-1) characters.\n    # So, the loop checks indices from n-2 down to 1.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if (_is_vowel(current_char) and\n                _is_consonant(left_char) and\n                _is_consonant(right_char)):\n            return current_char\n        \n    return \"\""}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of all words from string s that contain exactly n consonants.\"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and char.lower() not in VOWELS:\n                consonant_count += 1\n        \n        if consonant_count == n:\n            result_words.append(word)\n            \n    return result_words"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the entire array in ascending order.\n    # This takes O(N log N) time, where N is the length of arr.\n    sorted_arr = sorted(arr)\n\n    # The k largest numbers are the last k elements in the sorted array.\n    # They are already in ascending order due to the initial sort.\n    return sorted_arr[-k:]"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The sequence is generated until it reaches 1, and only unique odd numbers are collected.\n    \"\"\"\n    odd_numbers = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:\n            odd_numbers.add(current_term)\n        \n        if current_term % 2 == 0:\n            current_term //= 2\n        else:\n            current_term = 3 * current_term + 1\n    \n    odd_numbers.add(1) # 1 is always part of the sequence and is odd.\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits (absolute value between -99 and 99 inclusive).\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    if len(date) != 10 or date[2] != '-' or date[5] != '-':\n        return False\n\n    try:\n        month = int(date[0:2])\n        day = int(date[3:5])\n        # year = int(date[6:10]) # Year is not used for validation rules, but parsed for completeness\n        # The design context parses year but does not use it for validation;\n        # parsing it here to catch non-numeric year parts.\n        int(date[6:10]) \n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    DAYS_IN_MONTH_31 = {1, 3, 5, 7, 8, 10, 12}\n    DAYS_IN_MONTH_30 = {4, 6, 9, 11}\n\n    if month in DAYS_IN_MONTH_31:\n        if not (1 <= day <= 31):\n            return False\n    elif month in DAYS_IN_MONTH_30:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2:\n        if not (1 <= day <= 29): # Max 29 days for February as per requirement\n            return False\n    # No 'else' needed here, as month is already validated to be 1-12,\n    # and all valid month categories are covered.\n\n    return True"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Calculate sign for the current number\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n        \n        product_of_signs *= current_sign\n        sum_of_magnitudes += abs(num)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative numbers is sorted in ascending order\n    and if no number appears more than twice.\n    \"\"\"\n    if not lst or len(lst) == 1:\n        return True\n\n    counts = {}\n    for i in range(len(lst)):\n        current_num = lst[i]\n\n        if i > 0:\n            if current_num < lst[i-1]:\n                return False # Not sorted in ascending order\n\n        counts[current_num] = counts.get(current_num, 0) + 1\n        if counts[current_num] > 2:\n            return False # More than two occurrences of the same number\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if any(char.isspace() for char in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n    \n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            found_odd_digit = True\n    \n    if not found_odd_digit:\n        return 0\n    \n    return product"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if number <= 1:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If no intersection, return \"NO\"\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    intersection_length = intersection_end - intersection_start + 1\n\n    # Check if the length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    This sequence is defined by specific rules for tri(0), tri(1), even n, and odd n.\n    \"\"\"\n    \n    # Memoization cache to store previously computed Tribonacci terms.\n    cache = {}\n\n    def _calculate_term(k):\n        # If the term is already in the cache, return it to avoid re-computation.\n        if k in cache:\n            return cache[k]\n\n        # Base cases for the Tribonacci sequence as defined.\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        # If k is an even number, apply the specific formula.\n        elif k % 2 == 0:\n            result = 1 + k // 2\n        # If k is an odd number, apply the recursive recurrence relation.\n        else:\n            # For odd k, k+1 is even, so tri(k+1) can be directly calculated.\n            tri_k_plus_1 = 1 + (k + 1) // 2\n            result = _calculate_term(k - 1) + _calculate_term(k - 2) + tri_k_plus_1\n        \n        # Store the computed result in the cache before returning.\n        cache[k] = result\n        return result\n\n    # Generate the sequence of the first n + 1 Tribonacci numbers from tri(0) to tri(n).\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_calculate_term(i))\n    \n    return sequence"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if it's not part of a word:\n    # Either it's the only character, or the character before it is a space.\n    if len(txt) == 1:\n        return True\n    elif txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or equal\n    to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    largest_disarrangement_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_disarrangement_index = i\n    return largest_disarrangement_index"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    # The smallest sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    if n < 8:\n        return False\n    # The sum of any four even numbers must always be an even number.\n    if n % 2 != 0:\n        return False\n    # Any even number n >= 8 can be represented as (n-6) + 2 + 2 + 2,\n    # where (n-6) is a positive even number if n is even and >= 8.\n    return True"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    def _calculate_factorial(k):\n        # Helper function to calculate the standard factorial k!\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    special_factorial_result = 1\n    # Iterate from 1 up to n, calculating each factorial and multiplying it into the result.\n    for i in range(1, n + 1):\n        special_factorial_result *= _calculate_factorial(i)\n\n    return special_factorial_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of two or more spaces with a single hyphen.\n    # This must be done before replacing single spaces.\n    fixed_text = re.sub(r' {2,}', '-', text)\n    \n    # Then, replace any remaining single spaces with an underscore.\n    fixed_text = re.sub(r' ', '_', fixed_text)\n    \n    return fixed_text"}
{"task_id": "HumanEval/129", "solution": "from dataclasses import dataclass, field\nimport heapq\nfrom typing import List, Tuple, Set\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Grid:\n    \"\"\"Encapsulates grid data and provides methods for cell access and neighbor retrieval.\"\"\"\n    def __init__(self, data: List[List[int]]):\n        self._data = data\n        self.N = len(data)\n\n    def get_value(self, r: int, c: int) -> int:\n        return self._data[r][c]\n\n    def is_valid_coord(self, r: int, c: int) -> bool:\n        return 0 <= r < self.N and 0 <= c < self.N\n\n    def get_neighbors(self, r: int, c: int) -> List[Tuple[int, int]]:\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in moves:\n            nr, nc = r + dr, c + dc\n            if self.is_valid_coord(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\nclass PathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path of length k.\"\"\"\n    def find_min_path(self, grid_data: List[List[int]], k: int) -> List[int]:\n        self._validate_inputs(grid_data, k)\n        grid = Grid(grid_data)\n        N = grid.N\n\n        priority_queue: List[Path] = []\n\n        # Initialize the priority queue with all possible starting cells\n        for r in range(N):\n            for c in range(N):\n                initial_value = grid.get_value(r, c)\n                heapq.heappush(priority_queue, Path(values=[initial_value], row=r, col=c, length=1))\n\n        # BFS-like search using a priority queue\n        while priority_queue:\n            current_path = heapq.heappop(priority_queue)\n\n            # If the current path has reached the desired length k, it's the lexicographically smallest\n            if current_path.length == k:\n                return current_path.values\n\n            # If not, and path is still shorter than k, extend the path to neighbors\n            if current_path.length < k:\n                for next_r, next_c in grid.get_neighbors(current_path.row, current_path.col):\n                    next_value = grid.get_value(next_r, next_c)\n                    new_values = current_path.values + [next_value]\n                    new_path = Path(values=new_values, row=next_r, col=next_c, length=current_path.length + 1)\n                    heapq.heappush(priority_queue, new_path)\n        \n        # This part should ideally not be reached given the problem guarantees a unique answer\n        raise RuntimeError(\"No path of length k found, which contradicts problem statement.\")\n\n    def _validate_inputs(self, grid_data: List[List[int]], k: int):\n        \"\"\"Validates the input grid_data and k parameters.\"\"\"\n        if not isinstance(grid_data, list) or not all(isinstance(row, list) for row in grid_data):\n            raise InvalidInputError(\"Grid must be a list of lists.\")\n        \n        N = len(grid_data)\n        if N < 2:\n            raise InvalidInputError(\"Grid must have at least 2 rows (N >= 2).\")\n        \n        for row in grid_data:\n            if len(row) != N:\n                raise InvalidInputError(\"Grid must be square (N x N).\")\n            if not all(isinstance(x, int) for x in row):\n                raise InvalidInputError(\"All grid values must be integers.\")\n\n        seen_values: Set[int] = set()\n        expected_total_values = N * N\n        for r in range(N):\n            for c in range(N):\n                val = grid_data[r][c]\n                if not (1 <= val <= expected_total_values):\n                    raise InvalidInputError(f\"Grid values must be in range [1, {expected_total_values}].\")\n                if val in seen_values:\n                    raise InvalidInputError(\"All grid values must be unique.\")\n                seen_values.add(val)\n        \n        if len(seen_values) != expected_total_values:\n            raise InvalidInputError(\"Grid values do not cover the full range [1, N*N] uniquely.\")\n\n        if not isinstance(k, int) or k <= 0:\n            raise InvalidInputError(\"k must be a positive integer.\")\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    service = PathFinderService()\n    return service.find_min_path(grid, k)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    modified_values = []\n    for i, val in enumerate(lst):\n        if i % 3 == 0:\n            modified_values.append(val * val)\n        elif i % 4 == 0:\n            modified_values.append(val * val * val)\n        else:\n            modified_values.append(val)\n    return sum(modified_values)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    def _to_float_internal(value):\n        \"\"\"Converts the input value to a float, handling string formats with ',' or '.' as decimal separators.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, str):\n            processed_value = value\n            if ',' in processed_value:\n                processed_value = processed_value.replace(',', '.')\n            try:\n                return float(processed_value)\n            except ValueError:\n                raise ValueError(f\"Cannot convert string '{value}' to float.\")\n        raise TypeError(f\"Unsupported type for conversion: {type(value)}\")\n\n    # Convert inputs to float for numerical comparison\n    float_a = _to_float_internal(a)\n    float_b = _to_float_internal(b)\n\n    # Compare the float values and return the original variable or None\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/141", "solution": "import string\nALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\nMAX_DIGITS_ALLOWED = 3\nclass FileNameValidator:\n    def __init__(self, allowed_extensions: list[str], max_digits_allowed: int):\n        self._allowed_extensions = allowed_extensions\n        self._max_digits_allowed = max_digits_allowed\n\n    def is_valid(self, file_name: str) -> bool:\n        if not self._has_valid_digit_count(file_name):\n            return False\n\n        if not self._has_single_dot(file_name):\n            return False\n\n        # If _has_single_dot is True, parts will always have two elements.\n        parts = file_name.split('.', 1)\n        prefix = parts[0]\n        extension = parts[1]\n\n        if not self._has_valid_prefix(prefix):\n            return False\n\n        if not self._has_valid_extension(extension):\n            return False\n\n        return True\n\n    def _has_valid_digit_count(self, file_name: str) -> bool:\n        digit_count = sum(1 for char in file_name if char.isdigit())\n        return digit_count <= self._max_digits_allowed\n\n    def _has_single_dot(self, file_name: str) -> bool:\n        return file_name.count('.') == 1\n\n    def _has_valid_prefix(self, prefix: str) -> bool:\n        if not prefix:\n            return False\n        return prefix[0] in string.ascii_letters\n\n    def _has_valid_extension(self, extension: str) -> bool:\n        return extension in self._allowed_extensions\nclass FileValidationService:\n    def __init__(self, validator: FileNameValidator):\n        self._validator = validator\n\n    def check_file_name(self, file_name: str) -> str:\n        if self._validator.is_valid(file_name):\n            return 'Yes'\n        return 'No'\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    validator = FileNameValidator(ALLOWED_EXTENSIONS, MAX_DIGITS_ALLOWED)\n    service = FileValidationService(validator)\n    return service.check_file_name(file_name)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits,\n    order them based on their index in original list (stable sort).\n    \"\"\"\n    def _sum_digits(n):\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _sum_digits(num)\n        decorated_list.append((digit_sum, i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, retaining only those with even lengths,\n    then sorts them by length (ascending) and alphabetically (ascending) for ties.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    even_length_strings.sort(key=lambda s: (len(s), s))\n    return even_length_strings"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    PLANET_ORDER = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\",\n        \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    # Validate planet names and get their indices\n    try:\n        idx1 = PLANET_ORDER.index(planet1)\n        idx2 = PLANET_ORDER.index(planet2)\n    except ValueError:\n        return ()\n\n    # Determine the start and end indices for slicing\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the list to get planets strictly between the two\n    # The slice is exclusive of start_idx and end_idx\n    intermediate_planets = PLANET_ORDER[start_idx + 1:end_idx]\n\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10, where both the first and last digits\n    (considering absolute value) are odd.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Get the first digit. For num > 10, num is already positive.\n            temp_num = num\n            while temp_num >= 10:\n                temp_num //= 10\n            first_digit = temp_num\n\n            # Get the last digit. For num > 10, num is already positive.\n            last_digit = num % 10\n\n            # Check if both first and last digits are odd\n            if (first_digit % 2 != 0) and (last_digit % 2 != 0):\n                count += 1\n    return count"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n\n    def get_numerator(self) -> int:\n        return self._numerator\n\n    def get_denominator(self) -> int:\n        return self._denominator\n\n    def to_string(self) -> str:\n        return f\"{self._numerator}/{self._denominator}\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        return self._numerator == other._numerator and self._denominator == other._denominator\n\n    def __repr__(self):\n        return f\"Fraction({self._numerator}, {self._denominator})\"\nclass GCDCalculator:\n    \"\"\"Utility to calculate the Greatest Common Divisor of two integers.\"\"\"\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        while b:\n            a, b = b, a % b\n        return a\nclass FractionParser:\n    \"\"\"Parses a string representation of a fraction into a Fraction object.\"\"\"\n    @staticmethod\n    def parse(fraction_str: str) -> Fraction:\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\nclass FractionCalculator:\n    \"\"\"Performs arithmetic operations on Fraction objects, specifically multiplication and simplification.\"\"\"\n    @staticmethod\n    def multiply(f1: Fraction, f2: Fraction) -> Fraction:\n        new_numerator = f1.get_numerator() * f2.get_numerator()\n        new_denominator = f1.get_denominator() * f2.get_denominator()\n        result_fraction = Fraction(new_numerator, new_denominator)\n        return FractionCalculator._simplify_fraction(result_fraction)\n\n    @staticmethod\n    def _simplify_fraction(f: Fraction) -> Fraction:\n        common_divisor = GCDCalculator.gcd(f.get_numerator(), f.get_denominator())\n        simplified_numerator = f.get_numerator() // common_divisor\n        simplified_denominator = f.get_denominator() // common_divisor\n        return Fraction(simplified_numerator, simplified_denominator)\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n    \"\"\"\n    fraction_x = FractionParser.parse(x)\n    fraction_n = FractionParser.parse(n)\n    product_fraction = FractionCalculator.multiply(fraction_x, fraction_n)\n    return product_fraction.get_denominator() == 1"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    import math\n\n    # Determine if n is a prime number\n    is_n_prime = True\n    if n < 2:\n        is_n_prime = False\n    else:\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    if is_n_prime:\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    \n    total_sum_of_squares = 0\n\n    if not lst:\n        return 0\n\n    for item in lst:\n        # Check if the item is a positive, odd integer.\n        if isinstance(item, int) and item > 0 and item % 2 != 0:\n            total_sum_of_squares += item * item\n            \n    return total_sum_of_squares"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    open_brackets_count = 0\n    max_depth_achieved = 0\n\n    for char in string:\n        if char == '[':\n            open_brackets_count += 1\n            # Update max_depth_achieved with the current count of open brackets.\n            max_depth_achieved = max(max_depth_achieved, open_brackets_count)\n        elif char == ']':\n            # Only decrement if there is an open bracket to match.\n            # This ensures current_depth does not go negative.\n            open_brackets_count = max(0, open_brackets_count - 1)\n    \n    # According to the design context, \"at least one bracket in the subsequence is nested\"\n    # implies a \"maximum stack depth greater than 1\".\n    # This means if at any point we have 2 or more currently unmatched open brackets,\n    # then nesting (like `[[]]`) is possible.\n    return max_depth_achieved >= 2"}
{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from array a where i < j < k\n    and their sum is a multiple of 3.\n    \"\"\"\n    count_rem_0 = 0  # Count of a[x] where a[x] % 3 == 0\n    count_rem_1 = 0  # Count of a[x] where a[x] % 3 == 1\n\n    # Based on a[i] = i*i - i + 1:\n    # a[i] % 3 == 0 if i % 3 == 2\n    # a[i] % 3 == 1 if i % 3 == 0 or i % 3 == 1\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem_0 += 1\n        else:\n            count_rem_1 += 1\n\n    # A sum of three numbers is a multiple of 3 if all three are 0 (mod 3)\n    # or all three are 1 (mod 3). Other combinations are not possible since a[i]%3 is never 2.\n    triples_from_rem_0 = math.comb(count_rem_0, 3)\n    triples_from_rem_1 = math.comb(count_rem_1, 3)\n\n    return triples_from_rem_0 + triples_from_rem_1"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute difference between corresponding elements of two score arrays.\n    Returns a new array where each element is the difference, or 0 if the guess was correct.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        diff = abs(game[i] - guess[i])\n        differences.append(diff)\n    return differences"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n    \n    for rotation in rotations:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters \n    in the extension's name, the strength is given by the fraction CAP - SM. \n    You should find the strongest extension and return a string in this \n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension \n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    \n    # Assume extensions list is not empty based on problem statement and examples.\n\n    # Calculate strength for the first extension to initialize max_strength and strongest_extension_name\n    first_ext_name = extensions[0]\n    cap_count_first = 0\n    sm_count_first = 0\n    for char in first_ext_name:\n        if char.isupper():\n            cap_count_first += 1\n        elif char.islower():\n            sm_count_first += 1\n    \n    max_strength = cap_count_first - sm_count_first\n    strongest_extension_name = first_ext_name\n\n    # Iterate through the rest of the extensions to find the strongest\n    for i in range(1, len(extensions)):\n        current_ext_name = extensions[i]\n        cap_count_current = 0\n        sm_count_current = 0\n        for char in current_ext_name:\n            if char.isupper():\n                cap_count_current += 1\n            elif char.islower():\n                sm_count_current += 1\n        \n        current_strength = cap_count_current - sm_count_current\n        \n        # If current_strength is strictly greater, update the strongest extension.\n        # If strengths are equal, the first one encountered (which is already stored) is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_ext_name\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if num == 0:\n        return (1, 0)\n\n    even_count = 0\n    odd_count = 0\n    \n    # Process the absolute value of the number to handle negative inputs\n    abs_num_str = str(abs(num)) \n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    \n    # Sort the sides to easily identify the two shorter sides and the potential hypotenuse.\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for floating-point comparison as specified in the design.\n    EPSILON = 1e-9 \n    \n    # Check if s1^2 + s2^2 is approximately equal to s3^2 (Pythagorean theorem).\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=EPSILON)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    carrots_eaten_in_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_in_meal\n    carrots_left_in_stock = remaining - carrots_eaten_in_meal\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_parts = []\n    for value, symbol in roman_map:\n        while number >= value:\n            roman_parts.append(symbol)\n            number -= value\n    return \"\".join(roman_parts).lower()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple words tie, returns the lexicographically smallest one.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        # Calculate the number of unique characters for the current word\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: if counts are equal, choose the lexicographically smaller word\n            if word < result_word:\n                result_word = word\n                \n    return result_word"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    has_letters = any(char.isalpha() for char in s)\n\n    if not has_letters:\n        return s[::-1]\n\n    transformed_chars = []\n    for char in s:\n        if char.isalpha():\n            transformed_chars.append(char.swapcase())\n        else:\n            transformed_chars.append(char)\n            \n    return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    EVEN_DIGITS = [0, 2, 4, 6, 8]\n    min_val = min(a, b)\n    max_val = max(a, b)\n    \n    result = []\n    for digit in EVEN_DIGITS:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n            \n    return result"}
