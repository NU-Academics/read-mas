{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    return is_prime(len(string))"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # This calculation uses the principle of inclusion-exclusion for counting numbers starting or ending with 1.\n        # The formula derived is 10^(n-1) + 8 * 10^(n-2).\n        return (10 ** (n - 1)) + (8 * (10 ** (n - 2)))"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Calculates the sum of N's digits, then converts that sum to a binary string.\"\"\"\n    \n    digit_sum = 0\n    s_N = str(N)\n    for digit_char in s_N:\n        digit_sum += int(digit_char)\n\n    if digit_sum == 0:\n        return \"0\"\n    \n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where characters within each word are sorted alphabetically.\n    Word order and blank spaces are preserved.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string into words and delimiters, preserving spaces.\n    # re.split with a capturing group keeps the delimiters in the result list.\n    segments = re.split(r'(\\s+)', s)\n    \n    processed_segments = []\n    for segment in segments:\n        if segment and not segment.isspace():  # If it's a non-empty, non-whitespace segment (i.e., a word)\n            processed_segments.append(\"\".join(sorted(segment)))\n        else:  # If it's a whitespace segment or an empty string, keep as is\n            processed_segments.append(segment)\n    \n    return \"\".join(processed_segments)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the input array in ascending or descending order based on the sum of its first and last elements.\n    Returns a new list containing the sorted elements without modifying the original array.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    if sum_first_last % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    # Use a set to get distinct elements, then convert to a list and sort\n    distinct_elements = sorted(list(set(lst)))\n\n    if len(distinct_elements) < 2:\n        return None\n    else:\n        return distinct_elements[1]"}
