{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n        if l[i] > l[i-1]:\n            is_decreasing = False\n        \n        # Optimization: if both flags are false, the list is not monotonic\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        # If balance ever drops below zero, it means a closing bracket appeared\n        # without a corresponding opening bracket.\n        if balance < 0:\n            return False\n    # After iterating through all characters, the balance must be zero\n    # for all brackets to be correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    open_brackets_count = 0\n    for char in brackets:\n        if char == '(':\n            open_brackets_count += 1\n        elif char == ')':\n            open_brackets_count -= 1\n        if open_brackets_count < 0:\n            return False\n    return open_brackets_count == 0"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    import math\n\n    max_prime = -1\n\n    # Handle the case of 2 as a factor\n    while n % 2 == 0:\n        max_prime = 2\n        n //= 2\n\n    # n must be odd at this point, so we can skip even numbers\n    # We only need to check up to the square root of n\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            max_prime = i\n            n //= i\n\n    # If n is still greater than 2, it must be a prime factor itself\n    if n > 2:\n        max_prime = n\n\n    return max_prime"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Calculate the sum using the arithmetic series formula.\n    # The result of division is cast to an integer using // operator.\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    return sorted(list(common_set))"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"\n    Calculates the derivative of a polynomial represented by coefficients.\n    xs[i] is the coefficient of x^i.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coefficients = []\n    # The derivative of a term c * x^n is (c * n) * x^(n-1).\n    # For a polynomial `xs[0] + xs[1]*x + xs[2]*x^2 + ...`,\n    # the constant term xs[0] differentiates to 0.\n    # The term xs[i]*x^i differentiates to (xs[i]*i)*x^(i-1).\n    # So, the coefficient of x^k in the derivative comes from xs[k+1]*x^(k+1),\n    # which is (xs[k+1]*(k+1)).\n    # We iterate from the second original coefficient (index 1) which becomes the new constant term.\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n    return derived_coefficients"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int, _memo: dict = None):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if _memo is None:\n        _memo = {0: 0, 1: 0, 2: 1}\n\n    if n in _memo:\n        return _memo[n]\n\n    result = fibfib(n - 1, _memo) + fibfib(n - 2, _memo) + fibfib(n - 3, _memo)\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in a string.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in the string s, including 'y' if it's the last character.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for char in s_lower:\n        if char in standard_vowels:\n            count += 1\n\n    if s and s_lower[-1] == 'y':\n        count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    is_negative = x < 0\n    s = str(abs(x))\n    n = len(s)\n\n    if n == 0:\n        return \"0\"\n\n    if shift > n:\n        result_digits = s[::-1]  # Reverse digits\n    else:\n        effective_shift = shift % n\n        result_digits = s[-effective_shift:] + s[:-effective_shift]\n\n    if is_negative:\n        return \"-\" + result_digits\n    return result_digits"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its smallest index in the array.\n    Returns [value, index] or an empty list if no even values are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n            elif num == smallest_even_value and i < smallest_even_index:\n                # If values are equal, prioritize the one with the smallest index\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    \n    frequency_map = {}\n    for x in lst:\n        frequency_map[x] = frequency_map.get(x, 0) + 1\n    \n    candidates = []\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            candidates.append(num)\n    \n    if not candidates:\n        return -1\n    \n    return max(candidates)"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"Calculates the number of mango fruits in a basket.\n    It extracts apple and orange counts from the string and subtracts them from the total.\n    \"\"\"\n    _APPLE_PATTERN = re.compile(r\"(\\d+)\\s+apples\")\n    _ORANGE_PATTERN = re.compile(r\"(\\d+)\\s+oranges\")\n\n    def _extract_count(text_s: str, pattern: re.Pattern) -> int:\n        match = pattern.search(text_s)\n        return int(match.group(1))\n\n    apples = _extract_count(s, _APPLE_PATTERN)\n    oranges = _extract_count(s, _ORANGE_PATTERN)\n    \n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes_count = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly based on balance and weight.\n    \"\"\"\n    # Check if q is a palindrome\n    is_balanced = (q == q[::-1])\n    if not is_balanced:\n        return False\n\n    # Calculate the sum of elements in q\n    total_weight = sum(q)\n    \n    # Check if the total weight is within the maximum allowed weight w\n    return total_weight <= w"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some integer k.\n    \"\"\"\n    if x < 0 or n < 0:\n        return False\n    \n    if n == 0:\n        return x == 0 # 0^k = 0 for k > 0\n    \n    if x == 1:\n        return True  # n^0 = 1 for any n > 0\n    \n    if n == 1:\n        return x == 1 # Only 1^k = 1\n    \n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n        \n    return current_x == 1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    working_list = sorted(lst)\n    result = []\n\n    while working_list:\n        # Append minimum value (from the front of the sorted list)\n        result.append(working_list.pop(0))\n        \n        # If elements remain, append maximum value (from the end of the sorted list)\n        if working_list:\n            result.append(working_list.pop())\n            \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check for valid side lengths (must be positive)\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Check triangle inequality theorem\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate area using Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating point inaccuracies where area_squared might be slightly negative\n    if area_squared < 0:\n        area_squared = 0\n\n    area = math.sqrt(area_squared)\n\n    # Round the area to 2 decimal places\n    return round(area, 2)"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    count1 = sum(len(s) for s in lst1)\n    count2 = sum(len(s) for s in lst2)\n\n    if count1 < count2:\n        return lst1\n    elif count2 < count1:\n        return lst2\n    else:\n        return lst1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    '''\n    if a == 0:\n        return True\n    \n    if a > 0:\n        # Calculate the cube root and round to the nearest integer.\n        root = round(a**(1/3))\n        # Check if cubing the integer root yields the original number.\n        return int(root * root * root) == a\n    else: # a < 0\n        # For negative numbers, calculate the cube root of the absolute value.\n        # Then check if cubing the negative of this root yields the original negative number.\n        root = round(abs(a)**(1/3))\n        return int(-root * -root * -root) == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (=decimal 11), D (=decimal 13).\n    \"\"\"\n    PRIME_HEX_DIGITS = {\"2\", \"3\", \"5\", \"7\", \"B\", \"D\"}\n    count = 0\n    for char in num:\n        if char in PRIME_HEX_DIGITS:\n            count += 1\n    return count"}
