{"task_id": "Mbpp/102", "solution": "from typing import List\n\ndef _split_on_underscore(s: str) -> List[str]:\n    \"\"\"Returns a list of substrings split by underscores.\"\"\"\n    return s.split('_')\n\ndef _capitalize_first_char(s: str) -> str:\n    \"\"\"Capitalizes the first character of a string, if non-empty.\"\"\"\n    if s:\n        return s[0].upper() + s[1:]\n    return s\n\ndef snake_to_camel(input_string: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase by splitting, capitalizing, and concatenating.\"\"\"\n    segments = _split_on_underscore(input_string)\n    camel_segments = [_capitalize_first_char(segment) for segment in segments]\n    return \"\".join(camel_segments)"}
{"task_id": "Mbpp/103", "solution": "```python\nimport math\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\n    Contains a message and an integer code.\n    \"\"\"\n    def __init__(self, message: str, code: int = 1) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass InputParameters:\n    \"\"\"Encapsulates and validates the input pair (n, m).\n    Validates according to specified business rules.\n    \"\"\"\n    def __init__(self, n: int, m: int) -> None:\n        self.n = n\n        self.m = m\n\n    def validate(self) -> None:\n        \"\"\"Enforces input rules for n and m, raising ValidationError on violation.\"\"\"\n        if not isinstance(self.n, int) or self.n < 0:\n            raise ValidationError(\"n must be integer >= 0\", code=101)\n        \n        if self.n == 0:\n            if not (isinstance(self.m, int) and self.m == 0):\n                raise ValidationError(\"if n==0 then m must be 0\", code=102)\n        else: # n > 0\n            if not isinstance(self.m, int) or not (0 <= self.m <= self.n - 1):\n                raise ValidationError(f\"m out of range 0..n-1 for n={self.n}\", code=103)\n\nclass Result:\n    \"\"\"Simple container for an integer value.\n    Provides a wrapper for computational results.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass EulerianFunction:\n    \"\"\"Encapsulates Eulerian number computation algorithms.\n    Provides static methods for recursive and formula-based calculations.\n    \"\"\"\n\n    @staticmethod\n    def eulerian_num(n: int, m: int) -> int:\n        \"\"\"Delegates computation to the preferred formula-based algorithm.\"\"\"\n        return EulerianFunction.computeUsingFormula(n, m)\n\n    @staticmethod\n    def computeRecursive(n: int, m: int) -> int:\n        \"\"\"Computes the Eulerian number A(n,m) using the recurrence relation.\n        A(n,m) = (m+1)A(n-1,m) + (n-m)A(n-1,m-1) with base cases.\n        \"\"\"\n        if m < 0 or m >= n:\n            return 0\n        if n == 0 and m == 0:\n            return 1\n        \n        return (m + 1) * EulerianFunction.computeRecursive(n - 1, m) + \\\n               (n - m) * EulerianFunction.computeRecursive(n - 1, m - 1)\n\n    @staticmethod\n    def computeUsingFormula(n: int, m: int) -> int:\n        \"\"\"Computes the Eulerian number A(n,m) using a combinatorial formula.\n        A(n,m) = sum_{k=0 to m} (-1)^k * C(n+1, k) * (m+1-k)^n.\n        \"\"\"\n        if m < 0 or m >= n:\n            return 0\n        if n == 0 and m == 0:\n            return 1\n\n        result = 0\n        for k in range(m + 1):\n            term = ((-1)**k) * math.comb(n + 1, k) * ((m + 1 - k)**n)\n            result += term\n        return result\n\nclass TestCase:\n    \"\"\"Helper to run a specific Eulerian number test case.\n    Compares the actual result of eulerian_num(n, m) with an expected value.\n    \"\"\"\n    def __init__(self, name: str, n: int, m: int, expected: int) -> None:\n        self.name = name\n        self.n = n\n        self.m = m\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Invokes eulerian_num with its stored parameters and returns True if the result matches expected.\"\"\"\n        try:\n            actual = eulerian_num(self.n, self.m)\n            return actual == self.expected\n        except Exception:\n            return False # Any exception indicates a test failure for this helper.\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"Public API function to compute the Eulerian number a(n, m).\n    Orchestrates input validation and delegates computation to EulerianFunction.\n    \"\"\"\n    input_params = InputParameters(n, m)\n    input_params.validate()\n    \n    return EulerianFunction.eulerian_num(n, m)\n```"}
{"task_id": "Mbpp/103", "solution": "```python\n# eulerian_project/eulerian/exceptions.py\nclass EulerianException(Exception):\n    \"\"\"Domain-specific exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n```\n```python\n# eulerian_project/eulerian/validator.py\nfrom .exceptions import EulerianException\n\nclass InputValidator:\n    \"\"\"Validates inputs for Eulerian number computation.\"\"\"\n    @staticmethod\n    def validate(n: int, m: int) -> None:\n        \"\"\"Ensures n and m are non-negative integers.\"\"\"\n        if not isinstance(n, int) or not isinstance(m, int):\n            raise EulerianException(\"Inputs n and m must be integers.\")\n        if n < 0 or m < 0:\n            raise EulerianException(\"Inputs n and m must be non-negative.\")\n\n```\n```python\n# eulerian_project/eulerian/calculator.py\nclass EulerianCalculator:\n    \"\"\"Computes Eulerian numbers using recurrence with memoization.\"\"\"\n    _memo: dict[tuple[int, int], int] = {}\n\n    @classmethod\n    def compute(cls, n: int, m: int) -> int:\n        \"\"\"Computes A(n, m) using recurrence and memoization.\"\"\"\n        if (n, m) in cls._memo:\n            return cls._memo[(n, m)]\n\n        if n == 0 and m == 0:\n            result = 1\n        elif n > 0 and (m < 0 or m >= n):\n            result = 0\n        else: # n > 0 and 0 <= m < n\n            term1 = (n - m) * cls.compute(n - 1, m - 1)\n            term2 = (m + 1) * cls.compute(n - 1, m)\n            result = term1 + term2\n        \n        cls._memo[(n, m)] = result\n        return result\n\n```\n```python\n# eulerian_project/eulerian/eulerian.py\nfrom .validator import InputValidator\nfrom .calculator import EulerianCalculator\nfrom .exceptions import EulerianException\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"Validates inputs and computes the Eulerian number A(n,m).\"\"\"\n    InputValidator.validate(n, m)\n    return EulerianCalculator.compute(n, m)\n\n```\n```python\n# eulerian_project/eulerian/__init__.py\nfrom .eulerian import eulerian_num\n\n```\n```python\n# eulerian_project/tests/test_eulerian.py\nfrom eulerian.eulerian import eulerian_num\n\ndef test_eulerian_num_3_1() -> None:\n    \"\"\"Asserts that eulerian_num(3, 1) correctly returns 4.\"\"\"\n    assert eulerian_num(3, 1) == 4\n\n```"}
