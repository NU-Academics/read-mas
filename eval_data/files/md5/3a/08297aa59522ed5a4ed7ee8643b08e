{"task_id": "Mbpp/397", "solution": "```python\n# src/median.py\n\"\"\"\nA module to calculate the median of three numbers.\n\nThis module provides the public API function `median_numbers` which\ncomputes and returns the median value from three numeric inputs.\n\nExample usage:\n    from src.median import median_numbers\n    assert median_numbers(25, 55, 65) == 55.0\n\"\"\"\n\nfrom dataclasses import dataclass\nfrom typing import Union\n\nNumeric = Union[int, float]\n\n@dataclass\nclass NumberInput:\n    \"\"\"Typed container for three numeric inputs a, b, c.\"\"\"\n    a: float\n    b: float\n    c: float\n\n@dataclass\nclass MedianResult:\n    \"\"\"Container for the median result value.\"\"\"\n    value: float\n\nclass MedianCalculator:\n    \"\"\"Encapsulates the median computation algorithm for three numbers.\"\"\"\n    @staticmethod\n    def median_numbers(a: float, b: float, c: float) -> float:\n        \"\"\"\n        Computes the median of three float numbers.\n        It sorts the numbers and returns the middle element.\n        \"\"\"\n        numbers = sorted([a, b, c])\n        return numbers[1]\n\ndef median_numbers(a: Numeric, b: Numeric, c: Numeric) -> float:\n    \"\"\"\n    Public API function to calculate the median of three numbers.\n    It accepts three numeric arguments and delegates the computation\n    to MedianCalculator, returning the result as a float.\n    \"\"\"\n    return MedianCalculator.median_numbers(float(a), float(b), float(c))\n\n```\n```python\n# tests/test_median.py\nimport pytest\nfrom src.median import median_numbers\n\ndef test_example_median():\n    \"\"\"Verifies the example provided in the SRS.\"\"\"\n    assert median_numbers(25, 55, 65) == 55.0\n\ndef test_permutations_and_duplicates():\n    \"\"\"Tests various permutations and cases with duplicate input values.\"\"\"\n    assert median_numbers(1, 2, 3) == 2.0\n    assert median_numbers(3, 1, 2) == 2.0\n    assert median_numbers(2, 3, 1) == 2.0\n    assert median_numbers(5, 5, 7) == 5.0\n    assert median_numbers(7, 5, 5) == 5.0\n    assert median_numbers(5, 7, 5) == 5.0\n    assert median_numbers(5, 5, 5) == 5.0\n    assert median_numbers(10.5, 20.0, 15.2) == 15.2\n    assert median_numbers(-1, -5, -3) == -3.0\n\n```"}
{"task_id": "Mbpp/397", "solution": "```python\n# src/median/__init__.py\nfrom .api import median_numbers\n```\n```python\n# src/median/api.py\nfrom .calculator import MedianCalculator\n\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Public entry function to compute the median of three numbers.\n    It delegates computation to MedianCalculator.\n    \"\"\"\n    # Input validation, as specified in the design, is omitted due to critical requirements\n    # forbidding isinstance() checks, type guards, and raising exceptions.\n    calculator = MedianCalculator()\n    return calculator.median_numbers(a, b, c)\n```\n```python\n# src/median/calculator.py\nclass MedianResult:\n    \"\"\"Value object representing the median result as a float.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass MedianCalculator:\n    \"\"\"\n    Computes the median of three numeric inputs.\n    Assumes valid numeric inputs as per critical requirements.\n    \"\"\"\n    def median_numbers(self, a, b, c) -> float:\n        \"\"\"\n        Calculates the median of a, b, and c.\n        It sorts the inputs (coerced to float) and returns the middle value.\n        \"\"\"\n        numbers = [float(a), float(b), float(c)]\n        numbers.sort()\n        result_value = numbers[1]\n        median_result = MedianResult(result_value)\n        return median_result.value\n```"}
{"task_id": "Mbpp/398", "solution": "```python\n# src/sum_of_digits.py\n\"\"\"Implements sum_of_digits(list[int]) -> int. Uses base-10 decomposition as required by SRS.\nImport via: from src.sum_of_digits import sum_of_digits\"\"\"\n\ndef integer_digits(n: int) -> list[int]:\n    \"\"\"Return list of decimal digits of integer n (base-10).\"\"\"\n    return [int(digit) for digit in str(n)]\n\ndef sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"Compute sum of all decimal digits for each integer in numbers and return total as int.\"\"\"\n    total_sum = 0\n    for num in numbers:\n        total_sum += sum(integer_digits(num))\n    return total_sum\n```\n\n```python\n# tests/test_sum_of_digits.py\nfrom src.sum_of_digits import sum_of_digits\n\n# Mandatory assertion as per SRS acceptance criteria\nassert sum_of_digits([10,2,56]) == 14\n\n# Optional additional assertion\nassert sum_of_digits([56]) == 11\n\n# To indicate that tests passed when run as a script\nprint(\"All assertions passed!\")\n```"}
{"task_id": "Mbpp/398", "solution": "```python\nfrom typing import List, Iterator\n\nclass Digit:\n    \"\"\"Minimal representation of a single decimal digit.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def value(self) -> int:\n        \"\"\"Returns the integer value of the digit.\"\"\"\n        return self._value\n\nclass Integer:\n    \"\"\"Represents an integer and provides base-10 digit operations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def get_digits_base10(self) -> List[int]:\n        \"\"\"Extracts and returns the base-10 decimal digits of the integer.\"\"\"\n        s_value = str(abs(self._value))\n        return [int(d) for d in s_value]\n\n    def sum_digits(self) -> int:\n        \"\"\"Computes and returns the sum of its decimal digits.\"\"\"\n        return sum(self.get_digits_base10())\n\nclass IntegerList:\n    \"\"\"Wrapper holding a list of integer values and yielding Integer instances.\"\"\"\n    def __init__(self, items: List[int]) -> None:\n        self.items = items\n\n    def __iter__(self) -> Iterator['Integer']:\n        \"\"\"Yields Integer instances for each item in the list.\"\"\"\n        for item_value in self.items:\n            yield Integer(item_value)\n\nclass Result:\n    \"\"\"Accumulator for aggregated digit sums.\"\"\"\n    def __init__(self) -> None:\n        self._total = 0\n\n    def accumulate(self, addend: int) -> None:\n        \"\"\"Adds an addend to the running total.\"\"\"\n        self._total += addend\n\n    def value(self) -> int:\n        \"\"\"Returns the final accumulated total.\"\"\"\n        return self._total\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Compute and return the total sum of decimal digits of each integer in `numbers`.\"\"\"\n    integer_list = IntegerList(numbers)\n    final_result = Result()\n\n    for integer_obj in integer_list:\n        per_integer_digit_sum = integer_obj.sum_digits()\n        final_result.accumulate(per_integer_digit_sum)\n\n    return final_result.value()\n```"}
