{"task_id": "Mbpp/479", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputNumber:\n    \"\"\"Container for input integer value.\"\"\"\n    value: int\n\n@dataclass\nclass Digit:\n    \"\"\"Container for computed digit (0..9).\"\"\"\n    value: int\n\nclass FirstDigitFunction:\n    \"\"\"Stateless implementor encapsulating algorithm to compute most significant digit.\"\"\"\n    def first_Digit(self, n: int) -> int:\n        \"\"\"Compute most significant digit of n.\"\"\"\n        num = abs(n)\n        if num == 0:\n            return 0\n        while num >= 10:\n            num //= 10\n        return num\n\n_first_digit_calculator = FirstDigitFunction()\n\ndef first_Digit(n: int) -> int:\n    \"\"\"Return most significant digit of integer n as int (0..9).\"\"\"\n    return _first_digit_calculator.first_Digit(n)\n```"}
{"task_id": "Mbpp/554", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker for the src package, re-exporting the Split function.\"\"\"\nfrom .split import Split\n```\n\n```python\n# src/split.py\n\"\"\"Implements Split(input_list: list[int]) -> list[int] as specified in SRS.\"\"\"\n\ndef Split(input_list: list[int]) -> list[int]:\n    \"\"\"Return a list containing only the odd integers from input_list in the same relative order.\n    Precondition: input_list is a list of integers (BR2).\n    \"\"\"\n    return [item for item in input_list if item % 2 != 0]\n```\n\n```python\n# tests/test_split.py\n\"\"\"Unit tests verifying Split function behavior as per SRS functional requirements.\"\"\"\nfrom src.split import Split\n\ndef test_split_examples():\n    \"\"\"Verify Split function with examples from the SRS and additional acceptance tests.\"\"\"\n    assert Split([1,2,3,4,5,6]) == [1,3,5]\n    assert Split([]) == []\n    assert Split([2,4,6]) == []\n    assert Split([2,5,3,8,7]) == [5,3,7]\n    assert Split([7,1,9]) == [7,1,9]\n```"}
{"task_id": "Mbpp/478", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the input string with utility methods.\"\"\"\n    content: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the content string.\"\"\"\n        return len(self.content)\n\n    def chars(self) -> list[str]:\n        \"\"\"Returns a list of characters in the content string.\"\"\"\n        return list(self.content)\n\n@dataclass\nclass LowercaseSubstring:\n    \"\"\"Represents a contiguous substring of ASCII lowercase letters.\"\"\"\n    startIndex: int\n    endIndex: int\n    text: str\n\n    def isLowercaseSequence(self) -> bool:\n        \"\"\"Checks if the substring text is purely ASCII lowercase.\"\"\"\n        return all(ord('a') <= ord(c) <= ord('z') for c in self.text)\n\n@dataclass\nclass OutputString:\n    \"\"\"Represents the final output string.\"\"\"\n    content: str\n\ndef findLowercaseSubstrings(input_str: str) -> list[LowercaseSubstring]:\n    \"\"\"\n    Scans the input string to find all contiguous ASCII lowercase substrings.\n    Detection uses ord-based ASCII range checks.\n    \"\"\"\n    results: list[LowercaseSubstring] = []\n    n = len(input_str)\n    i = 0\n    while i < n:\n        # Check if the current character is an ASCII lowercase letter\n        if ord('a') <= ord(input_str[i]) <= ord('z'):\n            start_index = i\n            # Extend the lowercase run until a non-lowercase character or end of string\n            while i < n and ord('a') <= ord(input_str[i]) <= ord('z'):\n                i += 1\n            end_index = i  # 'i' is now the exclusive end index of the substring\n            substring_text = input_str[start_index:end_index]\n            results.append(LowercaseSubstring(startIndex=start_index, endIndex=end_index, text=substring_text))\n        else:\n            i += 1\n    return results\n\ndef buildOutput(input_str: str, substrings: list[LowercaseSubstring]) -> str:\n    \"\"\"\n    Constructs the output string by removing the identified lowercase substrings.\n    Segments before, between, and after substrings are preserved.\n    \"\"\"\n    if not substrings:\n        return input_str\n\n    parts: list[str] = []\n    current_pos = 0\n\n    for sub in substrings:\n        # Append the segment of the input string that comes before the current lowercase substring\n        if sub.startIndex > current_pos:\n            parts.append(input_str[current_pos : sub.startIndex])\n        # Advance current_pos past the removed lowercase substring\n        current_pos = sub.endIndex\n\n    # Append any remaining segment of the input string after the last lowercase substring\n    if current_pos < len(input_str):\n        parts.append(input_str[current_pos:])\n\n    return \"\".join(parts)\n\ndef remove_lowercase(input: str) -> str:\n    \"\"\"\n    Removes every contiguous substring composed solely of ASCII lowercase letters\n    from the input string, preserving non-lowercase characters.\n    \"\"\"\n    # As per design, create InputString wrapper; content is used by helpers.\n    input_wrapper = InputString(input)\n\n    # Find all lowercase substrings using the raw input string.\n    found_substrings = findLowercaseSubstrings(input_wrapper.content)\n\n    # Build the final output string by removing identified substrings.\n    output_content = buildOutput(input_wrapper.content, found_substrings)\n\n    # As per design, return the content of an OutputString wrapper.\n    output_wrapper = OutputString(output_content)\n    return output_wrapper.content\n```"}
