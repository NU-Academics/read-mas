{"task_id": "Mbpp/84", "solution": "```python\n\"\"\"This module provides the sequence(n) function for Newman\u2013Conway sequence values.\"\"\"\n\ndef computeNth(n: int) -> int:\n    \"\"\"Computes the nth Newman\u2013Conway sequence value iteratively.\"\"\"\n    if n <= 2:\n        return 1\n\n    p_values = [0] * (n + 1)\n    p_values[1] = 1\n    p_values[2] = 1\n\n    for i in range(3, n + 1):\n        p_values[i] = p_values[p_values[i - 1]] + p_values[i - p_values[i - 1]]\n\n    return p_values[n]\n\ndef sequence(n: int) -> int:\n    \"\"\"Public API to get the nth Newman\u2013Conway sequence value.\"\"\"\n    return computeNth(n)\n```"}
{"task_id": "Mbpp/85", "solution": "```python\nimport math\nfrom dataclasses import dataclass\n\n@dataclass\nclass Sphere:\n    \"\"\"\n    Data holder for Sphere properties.\n    Stores radius and computed surface area for traceability.\n    \"\"\"\n    radius: float\n    surface_area: float\n\ndef validate_radius(radius) -> bool:\n    \"\"\"\n    Validates if the given radius is a numeric type and non-negative.\n    Raises TypeError if not numeric, ValueError if negative.\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a numeric type\")\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n    return True\n\ndef surfacearea_sphere(radius) -> float:\n    \"\"\"\n    Public API required by SRS: validate and compute 4 * pi * radius**2 and return float.\n    This function calculates the surface area of a sphere given its radius.\n    \"\"\"\n    validate_radius(radius)\n    surface_area = 4 * math.pi * (radius ** 2)\n    # Sphere dataclass may be used for traceability if desired:\n    # s = Sphere(float(radius), float(surface_area))\n    return float(surface_area)\n```"}
{"task_id": "Mbpp/86", "solution": "```python\n# File: src/centered_hexagonal.py\n\nFORMULA_EXPRESSION: str = \"C_n = 3 * n * (n - 1) + 1\"\n\nclass Formula:\n    \"\"\"Encapsulates the formula expression and its evaluation logic.\"\"\"\n    def __init__(self, expression: str = FORMULA_EXPRESSION) -> None:\n        self.expression = expression\n\n    def evaluate(self, n: int) -> int:\n        \"\"\"Computes the centered hexagonal number using the defined formula.\"\"\"\n        return 3 * n * (n - 1) + 1\n\nclass CenteredHexagonalNumber:\n    \"\"\"Encapsulates the input 'n' and delegates computation to the Formula class.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def compute(self) -> int:\n        \"\"\"Calculates the centered hexagonal number for the stored 'n'.\"\"\"\n        formula = Formula()\n        return formula.evaluate(self.n)\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"Public API per requirements: compute C_n = 3*n*(n-1) + 1 and return int.\"\"\"\n    centered_num_obj = CenteredHexagonalNumber(n)\n    return centered_num_obj.compute()\n\n```\n```python\n# File: tests/test_centered_hexagonal.py\n\nfrom src.centered_hexagonal import centered_hexagonal_number\n\nclass TestCase:\n    \"\"\"Encapsulates test input and expected output for a single test case.\"\"\"\n    def __init__(self, input: int, expected: int) -> None:\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes the function under test and compares the result to expected.\"\"\"\n        actual = centered_hexagonal_number(self.input)\n        return actual == self.expected\n\ndef test_centered_hexagonal_number_10_equals_271() -> None:\n    \"\"\"Verifies that centered_hexagonal_number(10) correctly returns 271.\"\"\"\n    tc = TestCase(10, 271)\n    assert tc.run() is True\n\n```"}
{"task_id": "Mbpp/86", "solution": "```python\n# src/centered_hexagonal.py\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to the centered hexagonal number calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef _validate_n(n: int) -> None:\n    \"\"\"Validates n is a positive integer, raising ValidationError if not.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer.\")\n    if n < 1:\n        raise ValidationError(\"n must be a positive integer (n >= 1).\")\n\ndef _compute_centered_hexagonal(n: int) -> int:\n    \"\"\"Computes the nth centered hexagonal number using the formula.\"\"\"\n    return 3 * n * (n - 1) + 1\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number for a 1-based positive integer n.\n    Raises ValidationError for invalid input.\n    \"\"\"\n    _validate_n(n)\n    return _compute_centered_hexagonal(n)\n```\n```python\n# tests/test_centered_hexagonal.py\n\nimport pytest\nfrom src.centered_hexagonal import centered_hexagonal_number, ValidationError\n\ndef test_centered_hexagonal_example():\n    \"\"\"Verify the example assertion: centered_hexagonal_number(10) == 271.\"\"\"\n    assert centered_hexagonal_number(10) == 271\n\ndef test_centered_hexagonal_invalid_types():\n    \"\"\"Test that non-integer inputs raise ValidationError.\"\"\"\n    with pytest.raises(ValidationError, match=\"n must be an integer.\"):\n        centered_hexagonal_number(10.5)\n    with pytest.raises(ValidationError, match=\"n must be an integer.\"):\n        centered_hexagonal_number(\"a\")\n    with pytest.raises(ValidationError, match=\"n must be an integer.\"):\n        centered_hexagonal_number(None)\n    with pytest.raises(ValidationError, match=\"n must be an integer.\"):\n        centered_hexagonal_number([1])\n\ndef test_centered_hexagonal_invalid_values():\n    \"\"\"Test that n < 1 inputs raise ValidationError.\"\"\"\n    with pytest.raises(ValidationError, match=\"n must be a positive integer\"):\n        centered_hexagonal_number(0)\n    with pytest.raises(ValidationError, match=\"n must be a positive integer\"):\n        centered_hexagonal_number(-1)\n    with pytest.raises(ValidationError, match=\"n must be a positive integer\"):\n        centered_hexagonal_number(-100)\n\ndef test_centered_hexagonal_base_cases():\n    \"\"\"Test small positive integer inputs.\"\"\"\n    assert centered_hexagonal_number(1) == 1\n    assert centered_hexagonal_number(2) == 7\n    assert centered_hexagonal_number(3) == 19\n    assert centered_hexagonal_number(4) == 37\n\ndef test_centered_hexagonal_large_n():\n    \"\"\"Test correctness with a large integer n, relying on Python's arbitrary-precision integers.\"\"\"\n    large_n = 100000\n    expected_value = 3 * large_n * (large_n - 1) + 1\n    assert centered_hexagonal_number(large_n) == expected_value\n    assert isinstance(centered_hexagonal_number(large_n), int)\n\ndef test_centered_hexagonal_very_large_n():\n    \"\"\"Test with an even larger n to ensure arbitrary precision works.\"\"\"\n    very_large_n = 1_000_000_000_000_000 # 10^15\n    expected_value = 3 * very_large_n * (very_large_n - 1) + 1\n    assert centered_hexagonal_number(very_large_n) == expected_value\n    assert isinstance(centered_hexagonal_number(very_large_n), int)\n```"}
{"task_id": "Mbpp/87", "solution": "```python\n# src/merge_dictionaries_three.py\ndef merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"Merges three dictionaries into a new dict, applying first-seen precedence (a, then b, then c).\n    Raises TypeError if any input is not a dict.\"\"\"\n    if not isinstance(a, dict) or not isinstance(b, dict) or not isinstance(c, dict):\n        raise TypeError('merge_dictionaries_three expects three dict arguments')\n\n    result = {}\n    for src in (a, b, c):\n        for k, v in src.items():\n            if k not in result:\n                result[k] = v\n    return result\n\n```\n\n```python\n# tests/test_merge_dictionaries_three.py\nfrom src.merge_dictionaries_three import merge_dictionaries_three\n\ndef test_example_assertion() -> None:\n    \"\"\"Verifies the merge_dictionaries_three function against the provided example assertion.\n    Ensures correct merging and conflict resolution.\"\"\"\n    assert merge_dictionaries_three(\n        { 'R': 'Red', 'B': 'Black', 'P': 'Pink' },\n        { 'G': 'Green', 'W': 'White' },\n        { 'O': 'Orange', 'W': 'White', 'B': 'Black' }\n    ) == {'B': 'Black', 'R': 'Red', 'P': 'Pink', 'G': 'Green', 'W': 'White', 'O': 'Orange'}\n\n```"}
{"task_id": "Mbpp/87", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import Dict, Set, Optional, List\n\n@dataclass\nclass KeyValuePair:\n    \"\"\"Value object representing a key/value pair.\"\"\"\n    key: str\n    value: str\n\nclass Dictionary:\n    \"\"\"Thin wrapper around input dict for clarity and traceability.\"\"\"\n    def __init__(self, entries: Dict[str, str]):\n        self.entries = entries\n\n    def get(self, key: str) -> Optional[str]:\n        \"\"\"Gets value for a key, or None if not present.\"\"\"\n        return self.entries.get(key)\n\n    def keys(self) -> Set[str]:\n        \"\"\"Returns the set of keys in the dictionary.\"\"\"\n        return set(self.entries.keys())\n\nclass MergeResult:\n    \"\"\"Aggregate root for merged entries.\"\"\"\n    def __init__(self):\n        self.entries: Dict[str, str] = {}\n\n    def put(self, key: str, value: str):\n        \"\"\"Adds a key-value pair to the result.\"\"\"\n        self.entries[key] = value\n\n    def get(self, key: str) -> Optional[str]:\n        \"\"\"Retrieves a value from the result.\"\"\"\n        return self.entries.get(key)\n\n    def as_dict(self) -> Dict[str, str]:\n        \"\"\"Returns the accumulated entries as a standard dictionary.\"\"\"\n        return self.entries\n\nclass MergeService:\n    \"\"\"Stateless service class performing merge logic.\"\"\"\n\n    @staticmethod\n    def merge_dictionaries_three(a: Dict[str, str], b: Dict[str, str], c: Dict[str, str]) -> Dict[str, str]:\n        \"\"\"\n        Merges three dictionaries according to specified rules.\n        Handles unique keys and identical values across inputs.\n        \"\"\"\n        dict_a = Dictionary(a)\n        dict_b = Dictionary(b)\n        dict_c = Dictionary(c)\n\n        all_keys = dict_a.keys() | dict_b.keys() | dict_c.keys()\n        result = MergeResult()\n\n        for key in all_keys:\n            present_values: List[str] = []\n            val_a = dict_a.get(key)\n            if val_a is not None:\n                present_values.append(val_a)\n            val_b = dict_b.get(key)\n            if val_b is not None:\n                present_values.append(val_b)\n            val_c = dict_c.get(key)\n            if val_c is not None:\n                present_values.append(val_c)\n\n            if len(set(present_values)) == 1:\n                result.put(key, present_values[0])\n            # For keys with differing values across inputs, behavior is unspecified (BR6), so we do nothing.\n\n        return result.as_dict()\n\ndef merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"\n    Public API function to merge three dictionaries.\n    Delegates the merging logic to MergeService.\n    \"\"\"\n    return MergeService.merge_dictionaries_three(a, b, c)\n```"}
