{"task_id": "Mbpp/626", "solution": "def _validate_radius(radius):\n    \"\"\"Classifies the radius as 'negative', 'zero', or 'positive'.\"\"\"\n    if radius < 0:\n        return 'negative'\n    elif radius == 0:\n        return 'zero'\n    else:\n        return 'positive'\n\ndef _compute_area(radius):\n    \"\"\"Computes the area as radius squared, ensuring a float result.\"\"\"\n    return float(radius) * float(radius)\n\ndef triangle_area(radius):\n    \"\"\"\n    Computes the area of the largest triangle in a semicircle of given radius.\n    Returns None for negative radius, 0.0 for zero, and radius*radius for positive radius.\n    \"\"\"\n    validation_status = _validate_radius(radius)\n\n    if validation_status == 'negative':\n        return None\n    elif validation_status == 'zero':\n        return 0.0\n    else: # validation_status == 'positive'\n        return _compute_area(radius)"}
{"task_id": "Mbpp/629", "solution": "```python\n# split_even/src/split.py\ndef Split(input_list: list[int]) -> list[int]:\n    \"\"\"Return a new list containing only the even integers from input_list, preserving order.\n    The function does not modify the input list.\n    \"\"\"\n    result = []\n    for number in input_list:\n        if number % 2 == 0:\n            result.append(number)\n    return result\n\n__all__ = ['Split']\n\n\n# split_even/tests/acceptance_test.py\nimport sys\nimport os\n\n# Add the 'src' directory to sys.path to allow importing from it.\n# This handles running the test script from the project root or directly from the 'tests' directory.\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.join(current_dir, '..')\nsys.path.insert(0, os.path.abspath(project_root))\n\nfrom src.split import Split\n\ndef run() -> None:\n    \"\"\"Execute the acceptance assertion from the SRS.\n    Verifies that the Split function correctly filters even numbers.\n    \"\"\"\n    # Execute acceptance assertion from SRS\n    assert Split([1,2,3,4,5]) == [2,4]\n    print('Acceptance test passed: Split([1,2,3,4,5]) == [2,4]')\n\nif __name__ == '__main__':\n    run()\n```"}
{"task_id": "Mbpp/629", "solution": "```python\n# Internal helper class for handling a list of numbers.\nclass NumberList:\n    def __init__(self, numbers: list):\n        self._numbers = numbers\n\n    # Returns the list of numbers.\n    def get_numbers(self) -> list:\n        return self._numbers\n\n# Internal helper class for encapsulating a single number.\nclass Number:\n    def __init__(self, value):\n        self.value = value\n\n    # Determines if the number is even.\n    # Adheres to the 'no isinstance()' critical requirement, simplifying the evenness check.\n    def is_even(self) -> bool:\n        return self.value % 2 == 0\n\n# Internal helper class for accumulating even numbers.\nclass ResultList:\n    def __init__(self):\n        self._numbers = []\n\n    # Appends an even number's value to the list.\n    def append(self, n) -> None:\n        self._numbers.append(n)\n\n    # Returns the accumulated numbers as a Python list.\n    def to_list(self) -> list:\n        return self._numbers\n\n# Public API function to find even numbers from a list.\ndef Split(input_list: list) -> list:\n    # Coordinates the process of identifying and collecting even numbers.\n    num_list = NumberList(input_list)\n    result_list = ResultList()\n\n    for value in num_list.get_numbers():\n        # Creates a Number instance to check evenness for each value.\n        num_obj = Number(value)\n        if num_obj.is_even():\n            result_list.append(value)\n\n    return result_list.to_list()\n```"}
{"task_id": "Mbpp/628", "solution": "```python\nfrom typing import List\n\ndef replace_spaces(input: str) -> str:\n    \"\"\"\n    Replaces all ASCII space characters in the input string with '%20'.\n    Guarantees O(n) time and O(n) extra memory using a single-pass algorithm.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    fragments: List[str] = []\n    for char in input:\n        if char == ' ':\n            fragments.append(\"%20\")\n        else:\n            fragments.append(char)\n    return \"\".join(fragments)\n\n\nclass InputString:\n    \"\"\"\n    A simple value object to encapsulate an input string.\n    Provides a method to retrieve its length.\n    \"\"\"\n    value: str\n\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n\nclass OutputString:\n    \"\"\"\n    A simple value object to encapsulate an output string.\n    Provides a method to retrieve its length.\n    \"\"\"\n    value: str\n\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n\nclass PerformanceConstraint:\n    \"\"\"\n    Metadata holder for documenting performance characteristics.\n    Stores time and space complexity as strings.\n    \"\"\"\n    timeComplexity: str\n    spaceComplexity: str\n\n    def __init__(self, time_complexity: str, space_complexity: str):\n        self.timeComplexity = time_complexity\n        self.spaceComplexity = space_complexity\n\n\nclass ReplaceSpacesFunction:\n    \"\"\"\n    Companion class providing the same behavior as replace_spaces\n    along with introspection for purity and complexity.\n    \"\"\"\n    name: str = \"replace_spaces\"\n    _time_complexity: str = \"O(n)\"\n    _space_complexity: str = \"O(n)\"\n\n    def execute(self, input_str: str) -> str:\n        \"\"\"\n        Executes the space replacement logic, delegating to the module-level function.\n        Ensures identical behavior and guarantees O(n) time and O(n) extra memory.\n        \"\"\"\n        return replace_spaces(input_str)\n\n    def isPure(self) -> bool:\n        \"\"\"Indicates that the function has no side effects and is deterministic.\"\"\"\n        return True\n\n    def timeComplexity(self) -> str:\n        \"\"\"Returns the documented time complexity of the operation.\"\"\"\n        return self._time_complexity\n\n    def spaceComplexity(self) -> str:\n        \"\"\"Returns the documented space complexity of the operation.\"\"\"\n        return self._space_complexity\n\n\nclass TestCase:\n    \"\"\"\n    Helper class for defining and running unit tests for replace_spaces.\n    Compares the function's output against an expected result.\n    \"\"\"\n    input: str\n    expected: str\n\n    def __init__(self, input: str, expected: str):\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the test case by calling replace_spaces and comparing its output.\n        Returns True if the actual output matches the expected output.\n        \"\"\"\n        return replace_spaces(self.input) == self.expected\n\n```"}
{"task_id": "Mbpp/630", "solution": "```python\nfrom typing import List, Tuple\n\n# --- src/coordinate.py ---\nclass Coordinate:\n    def __init__(self, x: int, y: int):\n        \"\"\"Initializes a Coordinate object with x and y values.\"\"\"\n        self.x = x\n        self.y = y\n\n    def toList(self) -> List[int]:\n        \"\"\"Converts the coordinate to a two-element list [x, y].\"\"\"\n        return [self.x, self.y]\n\n# --- src/coordinate_list.py ---\nclass CoordinateList:\n    def __init__(self, coordinates: List[List[int]]):\n        \"\"\"Initializes a CoordinateList with a collection of coordinate pairs.\"\"\"\n        self.coordinates = coordinates\n\n    def count(self) -> int:\n        \"\"\"Returns the total number of coordinate pairs in the list.\"\"\"\n        return len(self.coordinates)\n\n# --- src/coordinate_generator.py ---\nclass CoordinateGenerator:\n    def get_coordinates(self, coord: Coordinate) -> CoordinateList:\n        \"\"\"Generates a 3x3 neighborhood around the given Coordinate object.\"\"\"\n        neighborhood = []\n        for xi in [coord.x - 1, coord.x, coord.x + 1]:\n            for yi in [coord.y - 1, coord.y, coord.y + 1]:\n                neighborhood.append([xi, yi])\n        return CoordinateList(neighborhood)\n\n# --- src/get_coordinates.py ---\ndef get_coordinates(coordinate: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Returns the 3x3 neighborhood around a center coordinate as a list of nine two-element lists.\n    Input validation is omitted as per critical requirements, assuming valid input.\n    \"\"\"\n    # The Validator service is omitted as per critical requirement:\n    # \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\n    # Trust the caller's inputs and implement the simplest, most direct logic possible.\"\n\n    coord_obj = Coordinate(coordinate[0], coordinate[1])\n    coord_list_obj = CoordinateGenerator().get_coordinates(coord_obj)\n    return coord_list_obj