{"task_id": "Mbpp/222", "solution": "```\n```python\n# src/__init__.py\n# Intentionally empty for package marker\n\n```\n```python\n# src/tuple_input.py\nfrom typing import Any, List\n\nclass Element:\n    \"\"\"Wraps a single value and exposes its runtime type.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> Any:\n        return self._value\n\n    def type(self) -> type:\n        \"\"\"Returns the runtime type of the element's value.\"\"\"\n        return type(self._value)\n\nclass TupleInput:\n    \"\"\"Constructed from a raw tuple; exposes elements as Element instances.\"\"\"\n    def __init__(self, raw_tuple: tuple) -> None:\n        self._elements: List[Element] = [Element(val) for val in raw_tuple]\n\n    @property\n    def elements(self) -> List[Element]:\n        return self._elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self._elements)\n\n```\n```python\n# src/result.py\nclass Result:\n    \"\"\"Immutable lightweight DTO holding analysis outcome.\"\"\"\n    def __init__(self, is_uniform: bool) -> None:\n        self._is_uniform = is_uniform\n\n    @property\n    def isUniform(self) -> bool:\n        \"\"\"Indicates if the elements' types were uniform.\"\"\"\n        return self._is_uniform\n\n```\n```python\n# src/type_checker.py\nfrom typing import List, Any\nfrom src.tuple_input import TupleInput, Element\nfrom src.result import Result\n\nclass TypeChecker:\n    \"\"\"Implements the analysis algorithm for tuple element types.\"\"\"\n    def __init__(self) -> None:\n        pass # This analyzer is stateless.\n\n    def check_type(self, input_tuple: tuple) -> bool:\n        \"\"\"\n        Determines if all elements in the input_tuple share the same data type.\n        It uses TupleInput for element wrapping and Result for outcome.\n        \"\"\"\n        tuple_input = TupleInput(input_tuple)\n        \n        # Behavior for empty/single-element tuples is unspecified by design.\n        # The logic below inherently handles these cases; empty/single-element tuples\n        # will result in 'is_uniform' remaining True.\n        \n        first_type: type = None\n        is_uniform = True\n\n        # If the tuple is empty or has one element, the loop will either not run\n        # or run once, leaving is_uniform as True, which implicitly covers\n        # \"all elements share the same type\" vacuously.\n        for i, element in enumerate(tuple_input.elements):\n            current_type = element.type()\n            if i == 0:\n                first_type = current_type\n            elif current_type != first_type:\n                is_uniform = False\n                break\n        \n        result = Result(is_uniform)\n        return result.isUniform\n\ndef check_type(input_tuple: tuple) -> bool:\n    \"\"\"\n    Public API entry point to check if all elements in a tuple share the same data type.\n    It delegates the analysis to an instance of TypeChecker.\n    \"\"\"\n    checker = TypeChecker()\n    return checker.check_type(input_tuple)\n\n```"}
{"task_id": "Mbpp/222", "solution": "```python\n# src/__init__.py\nfrom .check_type import check_type\n\n__all__ = [\"check_type\"]\n\n```\n```python\n# src/check_type.py\nfrom typing import Any, Tuple, List\n\ndef _type_of(value: Any) -> str:\n    \"\"\"Returns the stable string name for a runtime type.\"\"\"\n    return value.__class__.__name__\n\nclass TupleInput:\n    \"\"\"Wraps a tuple and provides access to its length and elements.\"\"\"\n    def __init__(self, elements: Tuple[Any, ...]) -> None:\n        self._elements: List[Any] = list(elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self._elements)\n\n    def elements(self) -> List[Any]:\n        \"\"\"Returns the list of elements from the tuple.\"\"\"\n        return self._elements\n\nclass Element:\n    \"\"\"Represents an element with its value and determined data type.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self._value: Any = value\n        self._data_type: str = _type_of(value)\n\n    def get_type(self) -> str:\n        \"\"\"Returns the string name of the element's data type.\"\"\"\n        return self._data_type\n\nclass Result:\n    \"\"\"A value object holding the uniformity check result.\"\"\"\n    def __init__(self, is_uniform: bool) -> None:\n        self._is_uniform: bool = is_uniform\n\n    @property\n    def is_uniform(self) -> bool:\n        \"\"\"Indicates whether all elements were uniform in type.\"\"\"\n        return self._is_uniform\n\ndef check_type(input: tuple) -> bool:\n    \"\"\"Determines if all elements in the tuple share the same runtime data type.\"\"\"\n    # Input validation for non-tuple types is omitted as per critical requirements.\n\n    tuple_input_obj = TupleInput(input)\n    elements_list = tuple_input_obj.elements()\n\n    if not elements_list:\n        # An empty tuple is considered to have elements of a uniform type.\n        return Result(True).is_uniform\n\n    first_element_type = Element(elements_list[0]).get_type()\n\n    for element_value in elements_list[1:]:\n        current_element_type = Element(element_value).get_type()\n        if current_element_type != first_element_type:\n            return Result(False).is_uniform\n\n    return Result(True).is_uniform\n```"}
{"task_id": "Mbpp/223", "solution": "```python\n# src/models.py\nfrom typing import Any\n\nclass Element:\n    \"\"\"Represents an element value.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\nclass Result:\n    \"\"\"Represents the boolean result of a majority check.\"\"\"\n    def __init__(self, isMajority: bool):\n        self.isMajority = isMajority\n```\n```python\n# src/sorted_array.py\nfrom typing import List, Any\n\nclass SortedArray:\n    \"\"\"Models a sorted array and provides a sortedness check.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the array.\"\"\"\n        return len(self.elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if the internal array is sorted in non-decreasing order.\"\"\"\n        if len(self.elements) <= 1:\n            return True\n        for i in range(len(self.elements) - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\n```\n```python\n# src/majority_checker.py\nfrom typing import List, Any\nfrom src.sorted_array import SortedArray\nfrom src.models import Result, Element # These are imported per design, but Element/Result are not directly instantiated/returned by is_majority.\n\nclass MajorityChecker:\n    \"\"\"Encapsulates validation, counting, and comparison logic for majority element.\"\"\"\n\n    @staticmethod\n    def is_majority(array: List[Any], n: int, element: Any) -> bool:\n        \"\"\"Determines if the element is a majority element after validation.\"\"\"\n        MajorityChecker.validateInput(array, n)\n        count = MajorityChecker.countOccurrences(array, element)\n        return count > (n / 2)\n\n    @staticmethod\n    def countOccurrences(array: List[Any], element: Any) -> int:\n        \"\"\"Counts occurrences of the given element in the array.\"\"\"\n        count = 0\n        for item in array:\n            if item == element:\n                count += 1\n        return count\n\n    @staticmethod\n    def validateInput(array: List[Any], n: int) -> None:\n        \"\"\"Validates array length and sortedness, raising ValueError if preconditions fail.\"\"\"\n        if len(array) != n:\n            raise ValueError(f\"Validation failed: provided length n={n} does not match actual array length={len(array)}.\")\n\n        sorted_array_obj = SortedArray(array)\n        if not sorted_array_obj.is_sorted():\n            raise ValueError(\"Validation failed: array is not sorted.\")\n```\n```python\n# src/majority.py\nfrom typing import List, Any\nfrom src.majority_checker import MajorityChecker\n\ndef is_majority(array: List[Any], n: int, element: Any) -> bool:\n    \"\"\"Public API: determines if an element is a majority element in a sorted array.\"\"\"\n    return MajorityChecker.is_majority(array, n, element)\n```"}
{"task_id": "Mbpp/224", "solution": "```python\n# src/count_set_bits.py\n\ndef validate_input(n):\n    \"\"\"Placeholder for input validation. Does nothing due to critical requirements.\"\"\"\n    # The design specifies validation for 'int' and raising 'TypeError'.\n    # However, critical constraints forbid isinstance checks and raising exceptions.\n    pass\n\ndef count_Set_Bits(n):\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of an integer.\n    Handles non-negative integers as specified; calls validate_input.\n    \"\"\"\n    validate_input(n)\n\n    if n == 0:\n        return 0\n    \n    # Python's bin() returns '0b...' for non-negative numbers and '-0b...' for negative.\n    # Counting '1's in this string directly provides the set bits for the magnitude.\n    return bin(n).count('1')\n\n```\n```python\n# tests/test_count_set_bits.py\n\nimport os\nimport sys\n\n# Add the 'src' directory to the Python path to allow importing count_Set_Bits.\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'src')))\n\nfrom count_set_bits import count_Set_Bits\n\nclass TestAssertion:\n    \"\"\"\n    Encapsulates a test assertion expression and provides a method to run it.\n    The run() method executes the assertion in a context with count_Set_Bits.\n    \"\"\"\n    def __init__(self, expression: str):\n        self.expression = expression\n\n    def run(self):\n        \"\"\"Executes the stored assertion expression.\"\"\"\n        # Execute the expression in a namespace where count_Set_Bits is available.\n        exec(self.expression, {'count_Set_Bits': count_Set_Bits})\n\ndef run_test_assertion():\n    \"\"\"\n    Constructs and runs the mandated unit assertion.\n    This function acts as the entry point for executing the specific test.\n    \"\"\"\n    print(\"Running mandated assertion: assert count_Set_Bits(2) == 1\")\n    assertion_obj = TestAssertion(\"assert count_Set_Bits(2) == 1\")\n    assertion_obj.run()\n    print(\"Mandated assertion passed.\")\n\nif __name__ == \"__main__\":\n    run_test_assertion()\n\n```"}
