{"task_id": "Mbpp/59", "solution": "```python\n# src/octagonal_service.py\n\nclass IntegerInput:\n    \"\"\"\n    Encapsulates an integer input value and provides validation logic.\n    Ensures the value is an integer and greater than or equal to 1.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if the value is an integer and >= 1, otherwise False.\"\"\"\n        return isinstance(self.value, int) and self.value >= 1\n\nclass CalculationResult:\n    \"\"\"\n    A simple data holder for an input 'n' and its computed octagonal value.\n    Used to model the result of a calculation.\n    \"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\n\nclass OctagonalNumberService:\n    \"\"\"\n    Provides stateless computation of the nth octagonal number.\n    It validates input and computes the value using the defined formula.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth octagonal number.\n        Raises ValueError if 'n' is not an integer or is less than 1.\n        \"\"\"\n        input_validator = IntegerInput(n)\n        if not input_validator.isValid():\n            raise ValueError(\"n must be an integer and >= 1\")\n        \n        # Formula: value = 3*n^2 - 2*n\n        value = 3 * n * n - 2 * n\n        return value\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    A convenience function to compute the nth octagonal number.\n    It acts as a facade to the OctagonalNumberService.\n    \"\"\"\n    return OctagonalNumberService().compute(n)\n\n```\n```python\n# tests/test_octagonal.py\n\nimport sys\nimport os\n\n# Adjust sys.path to allow importing from the 'src' directory when run as a script.\n# This ensures tests can find the implementation module.\nscript_dir = os.path.dirname(__file__)\nproject_root = os.path.abspath(os.path.join(script_dir, os.pardir))\nsys.path.insert(0, project_root)\n\n# Import the public API from the implementation module.\nfrom src.octagonal_service import is_octagonal, OctagonalNumberService\n\nclass TestCase:\n    \"\"\"\n    Encapsulates a single test scenario with an input 'n' and its expected octagonal value.\n    Provides a run method to execute the test and assert the outcome.\n    \"\"\"\n    def __init__(self, n: int, expected: int):\n        self.n = n\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the test scenario, asserts the result, and returns True on success.\n        Prints status messages and captures assertion errors.\n        \"\"\"\n        try:\n            actual = is_octagonal(self.n)\n            assert actual == self.expected, \\\n                f\"FAIL: TestCase for n={self.n}: Expected {self.expected}, Got {actual}\"\n            print(f\"PASS: TestCase for n={self.n}: Result {actual}\")\n            return True\n        except ValueError as e:\n            print(f\"FAIL: TestCase for n={self.n}: Caught unexpected ValueError: {e}\")\n            return False\n        except AssertionError as e:\n            print(e)\n            return False\n        except Exception as e:\n            print(f\"FAIL: TestCase for n={self.n}: Caught unexpected exception: {e}\")\n            return False\n\ndef test_is_octagonal_5():\n    \"\"\"\n    A pytest-compatible test function verifying is_octagonal(5) returns 65.\n    This test ensures the core formula works for a known value.\n    \"\"\"\n    assert is_octagonal(5) == 65\n\ndef run_all_tests():\n    \"\"\"\n    Executes all defined tests and provides a summary.\n    This function serves as a manual test runner for the module.\n    \"\"\"\n    print(\"--- Running all tests ---\")\n    overall_tests_passed = True\n\n    # Run pytest-compatible test\n    try:\n        test_is_octagonal_5()\n        print(\"test_is_octagonal_5: PASSED\")\n    except AssertionError as e:\n        print(f\"test_is_octagonal_5: FAILED - {e}\")\n        overall_tests_passed = False\n\n    # Run tests using TestCase objects\n    test_cases = [\n        TestCase(1, 1),   # 3*1^2 - 2*1 = 1\n        TestCase(2, 8),   # 3*2^2 - 2*2 = 8\n        TestCase(3, 21),  # 3*3^2 - 2*3 = 21\n        TestCase(5, 65)   # 3*5^2 - 2*5 = 65 (redundant with test_is_octagonal_5 but for TestCase demo)\n    ]\n\n    for tc in test_cases:\n        if not tc.run():\n            overall_tests_passed = False\n\n    # Test cases for invalid input, expecting ValueError\n    print(\"\\n--- Running invalid input tests (expecting ValueError) ---\")\n    invalid_inputs = [0, -5, 3.5, \"abc\", None]\n    for invalid_n in invalid_inputs:\n        try:\n            is_octagonal(invalid_n)\n            print(f\"FAIL: Invalid input {repr(invalid_n)} did not raise ValueError.\")\n            overall_tests_passed = False\n        except ValueError as e:\n            print(f\"PASS: Invalid input {repr(invalid_n)} correctly raised ValueError: {e}\")\n        except Exception as e:\n            print(f\"FAIL: Invalid input {repr(invalid_n)} raised unexpected exception: {e}\")\n            overall_tests_passed = False\n\n    print(\"\\n--- Test Summary ---\")\n    if overall_tests_passed:\n        print(\"All tests PASSED!\")\n        sys.exit(0)\n    else:\n        print(\"Some tests FAILED!\")\n        sys.exit(1)\n\nif __name__ == \"__main__\":\n    run_all_tests()\n\n```"}
{"task_id": "Mbpp/59", "solution": "```python\n# src/octagonal.py\n\nclass InputValidator:\n    \"\"\"Validates input for octagonal number computation.\n    Ensures n is a positive integer.\n    \"\"\"\n    def is_valid(self, n) -> bool:\n        \"\"\"Checks if n is an integer and n >= 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def raise_error(self, msg: str) -> None:\n        \"\"\"Raises a ValueError with the specified message.\"\"\"\n        raise ValueError(msg)\n\nclass OctagonalCalculator:\n    \"\"\"Computes octagonal numbers using a single formula.\n    Applies O_n = n * (3 * n - 2) with integer arithmetic.\n    \"\"\"\n    formula: str = \"O_n = n * (3 * n - 2)\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth octagonal number using the formula.\"\"\"\n        return n * (3 * n - 2)\n\nclass OctagonalNumber:\n    \"\"\"A data container for an octagonal number and its index.\n    Stores the input 'n' and the computed 'value'.\n    \"\"\"\n    def __init__(self, n: int, value: int) -> None:\n        \"\"\"Initializes the container with n and its calculated value.\"\"\"\n        self.n = n\n        self.value = value\n\ndef is_octagonal(n) -> int:\n    \"\"\"\n    Computes the nth octagonal number.\n    Validates input and calculates O_n using integer arithmetic.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_valid(n):\n        validator.raise_error(f\"Invalid input: n must be a positive integer (n >= 1), but got {n}.\")\n\n    calculator = OctagonalCalculator()\n    octagonal_value = calculator.compute(n)\n    \n    # OctagonalNumber can be used internally as a DTO, but the public API returns an int.\n    # oct_num = OctagonalNumber(n, octagonal_value) \n\n    return octagonal_value\n\n```\n```python\n# tests/test_octagonal.py\n\nimport sys\nimport os\n\n# Adjust the path to allow importing from the src directory\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'src')))\n\nfrom octagonal import is_octagonal\n\nclass TestCase:\n    \"\"\"Encapsulates test data and execution logic for is_octagonal.\n    Runs a test and reports success or failure.\n    \"\"\"\n    def __init__(self, n, expected=None, expect_exception=False, message=\"\"):\n        \"\"\"Sets up a test case with input, expected result, and exception flag.\"\"\"\n        self.n = n\n        self.expected = expected\n        self.expect_exception = expect_exception\n        self.message = message if message else f\"Test for n={n}\"\n        self.passed = False\n\n    def run(self) -> bool:\n        \"\"\"Executes the test case, asserting equality or expected ValueError.\"\"\"\n        try:\n            result = is_octagonal(self.n)\n            if self.expect_exception:\n                print(f\"FAIL: {self.message} - Expected ValueError, but got {result}.\")\n                self.passed = False\n            elif result == self.expected:\n                print(f\"PASS: {self.message} - is_octagonal({self.n}) == {result}.\")\n                self.passed = True\n            else:\n                print(f\"FAIL: {self.message} - is_octagonal({self.n}) == {result}, expected {self.expected}.\")\n                self.passed = False\n        except ValueError as e:\n            if self.expect_exception:\n                print(f\"PASS: {self.message} - Caught expected ValueError: {e}.\")\n                self.passed = True\n            else:\n                print(f\"FAIL: {self.message} - Caught unexpected ValueError: {e}.\")\n                self.passed = False\n        except Exception as e:\n            print(f\"FAIL: {self.message} - Caught unexpected exception: {type(e).__name__}: {e}.\")\n            self.passed = False\n        return self.passed\n\ndef run_all_tests() -> None:\n    \"\"\"Executes all defined test cases for the is_octagonal function.\n    Provides a summary of test results.\n    \"\"\"\n    print(\"Running tests for is_octagonal...\\n\")\n    tests = [\n        # Positive test cases\n        TestCase(n=1, expected=1, message=\"O_1 should be 1\"),\n        TestCase(n=2, expected=8, message=\"O_2 should be 8\"),\n        TestCase(n=3, expected=21, message=\"O_3 should be 21\"),\n        TestCase(n=4, expected=40, message=\"O_4 should be 40\"),\n        TestCase(n=5, expected=65, message=\"Acceptance test: O_5 should be 65\"),\n        TestCase(n=10, expected=280, message=\"O_10 should be 280\"),\n\n        # Negative test cases (invalid input)\n        TestCase(n=0, expect_exception=True, message=\"n=0 should raise ValueError\"),\n        TestCase(n=-1, expect_exception=True, message=\"n=-1 should raise ValueError\"),\n        TestCase(n=1.5, expect_exception=True, message=\"n=1.5 (float) should raise ValueError\"),\n        TestCase(n=\"abc\", expect_exception=True, message=\"n='abc' (string) should raise ValueError\"),\n        TestCase(n=None, expect_exception=True, message=\"n=None should raise ValueError\"),\n        TestCase(n=[1], expect_exception=True, message=\"n=[1] (list) should raise ValueError\"),\n    ]\n\n    total_tests = len(tests)\n    passed_tests = 0\n    for test in tests:\n        if test.run():\n            passed_tests += 1\n    \n    print(f\"\\n--- Test Summary ---\")\n    print(f\"Total tests run: {total_tests}\")\n    print(f\"Tests passed: {passed_tests}\")\n    print(f\"Tests failed: {total_tests - passed_tests}\")\n    print(\"--------------------\")\n\nif __name__ == \"__main__\":\n    run_all_tests()\n\n```"}
{"task_id": "Mbpp/61", "solution": "```python\n# src/count_substrings.py\ndef count_Substrings(s: str) -> int:\n    \"\"\"Return the count of contiguous substrings of s for which the sum of digits equals substring length.\n    It iterates through all substrings, computes their digit sum, and increments a counter for matches.\n    \"\"\"\n    n = len(s)\n    count = 0\n    for start in range(n):\n        for end in range(start, n):\n            substring = s[start : end + 1]\n            digit_sum = sum(int(ch) for ch in substring)\n            substring_length = len(substring)\n            if digit_sum == substring_length:\n                count += 1\n    return count\n\n# tests/test_count_substrings.py\nfrom src.count_substrings import count_Substrings\n\ndef test_example_count_substrings():\n    \"\"\"Verify count_Substrings against the example test case.\n    Asserts that the function correctly identifies 6 matching substrings for '112112'.\n    \"\"\"\n    assert count_Substrings('112112') == 6\n```"}
{"task_id": "Mbpp/61", "solution": "from dataclasses import dataclass, field\nfrom typing import Iterator, List\n\n@dataclass(frozen=True)\nclass Digit:\n    \"\"\"Represents a single digit with its position and value.\"\"\"\n    position: int\n    value: int\n\n@dataclass(frozen=True)\nclass Substring:\n    \"\"\"Represents a contiguous substring with its bounds and content.\"\"\"\n    start: int\n    end: int # inclusive end index\n    content: str\n    _digits: List[Digit] = field(init=False, repr=False)\n\n    def __post_init__(self):\n        # Initialize _digits for composition, for domain parity.\n        object.__setattr__(self, '_digits',\n                            [Digit(pos, int(char)) for pos, char in enumerate(self.content)])\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the substring.\"\"\"\n        return len(self.content)\n\n    def sum_digits(self) -> int:\n        \"\"\"Computes the sum of digits within the substring.\"\"\"\n        return sum(d.value for d in self._digits)\n\n@dataclass(frozen=True)\nclass InputString:\n    \"\"\"Represents the raw input string.\"\"\"\n    raw: str\n\n    def is_valid(self) -> bool:\n        \"\"\"Always returns True as per critical requirement to skip validation.\"\"\"\n        return True\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw input string.\"\"\"\n        return len(self.raw)\n\n@dataclass\nclass CountResult:\n    \"\"\"Aggregates the total count of matching substrings.\"\"\"\n    total: int = 0\n\ndef _substring_from_bounds(raw: str, i: int, j: int) -> Substring:\n    \"\"\"Constructs a Substring instance from raw string and bounds.\"\"\"\n    return Substring(start=i, end=j, content=raw[i : j + 1])\n\ndef _enumerate_substrings(raw: str) -> Iterator[Substring]:\n    \"\"\"Yields all contiguous Substring instances from the raw string.\"\"\"\n    n = len(raw)\n    for i in range(n):\n        for j in range(i, n):\n            yield _substring_from_bounds(raw, i, j)\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Input validation (type/content) is omitted as per critical requirements.\n    \"\"\"\n    if not s:\n        return 0\n\n    input_str_obj = InputString(raw=s)\n    result = CountResult(total=0)\n\n    for sub in _enumerate_substrings(input_str_obj.raw):\n        if sub.sum_digits() == sub.length():\n            result.total += 1\n            \n    return result.total"}
