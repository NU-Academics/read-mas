{"task_id": "Mbpp/16", "solution": "```python\nimport re\nfrom typing import Optional\n\nclass CharacterClass:\n    \"\"\"Documents the ASCII lowercase character class 'a-z'.\"\"\"\n    ascii_lowercase: str = \"a-z\"\n\n    def getAsciiClass(self) -> str:\n        \"\"\"Returns the ASCII lowercase character class string.\"\"\"\n        return self.ascii_lowercase\n\nclass InputString:\n    \"\"\"Wraps input text, validating it's a string and providing access.\"\"\"\n    def __init__(self, raw_input):\n        if not isinstance(raw_input, str):\n            raise TypeError(\"Input must be a string.\")\n        self._text: str = raw_input\n        self._length: int = len(raw_input)\n\n    def getText(self) -> str:\n        \"\"\"Returns the wrapped string.\"\"\"\n        return self._text\n\n    def __len__(self) -> int:\n        \"\"\"Returns the length of the wrapped string.\"\"\"\n        return self._length\n\nclass Pattern:\n    \"\"\"Encapsulates the regex pattern '[a-z]+_[a-z]+'.\"\"\"\n    def __init__(self):\n        self._regex: str = \"[a-z]+_[a-z]+\"\n        # description field is optional per spec, not strictly required for logic\n\n    def getRegex(self) -> str:\n        \"\"\"Returns the regex string.\"\"\"\n        return self._regex\n\nclass MatchResult:\n    \"\"\"Immutable result object indicating if a match occurred and its indices.\"\"\"\n    def __init__(self, matched: bool, start_index: Optional[int], end_index: Optional[int]):\n        self._matched: bool = matched\n        self._start_index: Optional[int] = start_index\n        self._end_index: Optional[int] = end_index\n\n    def is_matched(self) -> bool:\n        \"\"\"Returns True if a match was found, False otherwise.\"\"\"\n        return self._matched\n\nclass PatternMatcher:\n    \"\"\"Performs substring search using a given Pattern and returns a MatchResult.\"\"\"\n    def __init__(self, pattern: Pattern):\n        self._pattern: Pattern = pattern\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Checks if the pattern matches anywhere in the text.\"\"\"\n        return re.search(self._pattern.getRegex(), text, re.ASCII) is not None\n\n    def findSubstring(self, text: str) -> MatchResult:\n        \"\"\"Finds the first substring match and returns a MatchResult.\"\"\"\n        match_obj = re.search(self._pattern.getRegex(), text, re.ASCII)\n        if match_obj:\n            return MatchResult(True, match_obj.start(), match_obj.end())\n        return MatchResult(False, None, None)\n\ndef text_lowercase_underscore(input_text):\n    \"\"\"\n    Checks if the input text contains a substring of two or more ASCII lowercase letters\n    separated by exactly one underscore.\n    \"\"\"\n    input_obj = InputString(input_text)\n    pattern = Pattern()\n    matcher = PatternMatcher(pattern)\n    match_result = matcher.findSubstring(input_obj.getText())\n    return match_result.is_matched()\n```"}
{"task_id": "Mbpp/17", "solution": "```python\n# square_perimeter_project/src/square_perimeter.py\nfrom typing import Union\n\nclass Square:\n    \"\"\"Represents a square with a given side length.\n    It holds the side_length value as specified by the domain model.\n    \"\"\"\n    def __init__(self, side_length: Union[int, float]) -> None:\n        self.side_length = side_length\n\n    def get_side(self) -> Union[int, float]:\n        \"\"\"Returns the side length of the square.\n        This provides read access to the stored side length.\n        \"\"\"\n        return self.side_length\n\nclass Perimeter:\n    \"\"\"Represents the perimeter value of a geometric shape.\n    It stores the computed perimeter as a numeric value.\n    \"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n\n    def get_value(self) -> Union[int, float]:\n        \"\"\"Returns the stored perimeter value.\n        This provides read access to the computed perimeter.\n        \"\"\"\n        return self.value\n\ndef square_perimeter(side_length: Union[int, float]) -> Union[int, float]:\n    \"\"\"Compute and return the perimeter of a square as 4 * side_length.\n    This function acts as the public API as per the design.\n    \"\"\"\n    square = Square(side_length)\n    perimeter_value = 4 * square.get_side()\n    perimeter = Perimeter(perimeter_value)\n    return perimeter.get_value()\n\n```\n```python\n# square_perimeter_project/tests/test_square_perimeter.py\nimport sys\nimport os\n\n# Adjust the Python path to allow importing from the 'src' directory.\n# This makes the 'square_perimeter' module discoverable for testing.\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))\n\nfrom square_perimeter import square_perimeter\n\ndef test_square_perimeter_example():\n    \"\"\"Verify the square_perimeter function with the provided example.\n    This test ensures FR3 is satisfied as per the design specification.\n    \"\"\"\n    assert square_perimeter(10) == 40\n\nif __name__ == \"__main__\":\n    # This block allows running the test directly as a script.\n    # It executes the defined test function and prints a success message.\n    test_square_perimeter_example()\n    print(\"Verification test passed: square_perimeter(10) == 40\")\n\n```"}
{"task_id": "Mbpp/18", "solution": "```python\ndef remove_dirty_chars(source: str, filter_chars: str) -> str:\n    \"\"\"\n    Removes characters from the source string that are present in the filter_chars string.\n    Preserves original order and handles empty inputs as specified.\n    \"\"\"\n    if not filter_chars:\n        return source\n    if not source:\n        return \"\"\n\n    # Build a set for efficient character lookup from filter_chars.\n    filter_set = set(filter_chars)\n    result_chars = []\n\n    for char in source:\n        if char not in filter_set:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)\n```"}
{"task_id": "Mbpp/18", "solution": "```python\nclass Character:\n    def __init__(self, value: str):\n        \"\"\"Initializes a Character with a single string value.\"\"\"\n        self.value = value\n\n\nclass CharacterSet:\n    def __init__(self, characters: str):\n        \"\"\"Initializes a CharacterSet from a string, storing unique characters.\"\"\"\n        self.chars = set(characters)\n\n    def contains(self, c: str) -> bool:\n        \"\"\"Checks if the CharacterSet contains the given character string.\"\"\"\n        return c in self.chars\n\n\nclass StringEntity:\n    def __init__(self, content: str):\n        \"\"\"Initializes a StringEntity with its content string.\"\"\"\n        self.content = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string content.\"\"\"\n        return len(self.content)\n\n    def charAt(self, idx: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.content[idx]\n\n\nclass RemoveDirtyCharsFunction:\n    def remove(self, first_string: str, second_string: str) -> str:\n        \"\"\"Implements the core logic for removing characters.\"\"\"\n        # Edge case: If second_string is empty, return first_string unchanged.\n        if not second_string:\n            return first_string\n        # Edge case: If first_string is empty, return an empty string.\n        if not first_string:\n            return \"\"\n\n        dirty_set = CharacterSet(second_string)\n        first_entity = StringEntity(first_string)\n        result_chars = []\n\n        for i in range(first_entity.length()):\n            char_to_check = first_entity.charAt(i)\n            if not dirty_set.contains(char_to_check):\n                result_chars.append(char_to_check)\n\n        return \"\".join(result_chars)\n\n\ndef remove_dirty_chars(first_string: str, second_string: str) -> str:\n    \"\"\"Removes characters from the first string that are present in the second string.\"\"\"\n    remover = RemoveDirtyCharsFunction()\n    return remover.remove(first_string, second_string)\n```"}
