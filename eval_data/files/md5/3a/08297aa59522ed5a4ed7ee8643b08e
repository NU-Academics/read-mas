{"task_id": "Mbpp/310", "solution": "```python\nclass InputString:\n    \"\"\"Represents the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\nclass Character:\n    \"\"\"Represents a single character.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def isSpace(self) -> bool:\n        \"\"\"Checks if the character is a space.\"\"\"\n        return self.char == ' '\n\nclass OutputTuple:\n    \"\"\"Collects non-space characters into a tuple.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the output tuple.\"\"\"\n        return len(self.elements)\n\ndef string_to_tuple(s: str) -> tuple:\n    \"\"\"Converts a string to a tuple of its non-space characters.\n    Preserves order and includes digits/punctuation.\n    \"\"\"\n    is_obj = InputString(value=s)\n    collected_chars = []\n    for ch in is_obj.value:\n        c = Character(ch)\n        if not c.isSpace():\n            collected_chars.append(c.char)\n\n    out = OutputTuple(elements=tuple(collected_chars))\n    return out.elements\n```"}
{"task_id": "Mbpp/311", "solution": "```python\ndef set_bit_at_position(n: int, pos: int) -> int:\n    \"\"\"Sets the bit at a specific 0-based position in an integer to 1.\"\"\"\n    return n | (1 << pos)\n\ndef scan_bits_from_msb_to_lsb(n: int) -> list:\n    \"\"\"\n    Scans bits of n from MSB to LSB, returning (pos, bit_value) tuples.\n    Returns an empty list for n=0, assuming only its minimal non-zero bits are relevant.\n    \"\"\"\n    if n == 0:\n        return []\n\n    max_pos = n.bit_length() - 1\n    bits = []\n    for pos in range(max_pos, -1, -1):\n        bit_value = (n >> pos) & 1\n        bits.append((pos, bit_value))\n    return bits\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Scans the binary representation of n from MSB to LSB to locate\n    the first unset (0) bit and sets that bit to 1 without altering other bits.\n    \"\"\"\n    if n == 0:\n        return set_bit_at_position(0, 0)\n\n    bit_representation = scan_bits_from_msb_to_lsb(n)\n    \n    for pos, bit_value in bit_representation:\n        if bit_value == 0:\n            return set_bit_at_position(n, pos)\n            \n    # If no unset bit is found within the existing bit length (e.g., n = 7 which is 0b111),\n    # the left-most unset bit is at the next highest position.\n    return set_bit_at_position(n, n.bit_length())\n\nif __name__ == \"__main__\":\n    assert set_left_most_unset_bit(10) == 14\n    print(\"Assertion passed for set_left_most_unset_bit(10) == 14\")\n\n```"}
