{"task_id": "Mbpp/737", "solution": "```\n# src/models.py\nimport typing\n\nclass InputString:\n    \"\"\"Holds a string value for processing.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass RegexPattern:\n    \"\"\"Encapsulates a regular expression pattern string.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        self.pattern = pattern\n\nclass TestCase:\n    \"\"\"Defines a test case with input and expected output.\"\"\"\n    def __init__(self, name: str, input: str, expected: bool) -> None:\n        self.name = name\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Invokes the check_str function and compares its result to the expected value.\"\"\"\n        # Local import to avoid potential circular dependencies at module level.\n        from src.vowel_checker import check_str as module_check_str\n        actual = module_check_str(self.input)\n        return actual == self.expected\n\n```\n```\n# src/vowel_checker.py\nimport re\nfrom src.models import InputString, RegexPattern\n\nclass VowelChecker:\n    \"\"\"Determines if a string begins with a vowel using a regular expression.\"\"\"\n    def __init__(self, regex_pattern: RegexPattern = None) -> None:\n        # Stores the regex pattern string for checking.\n        default_pattern = r\"^[aeiou]\"\n        self._regex_pattern = regex_pattern.pattern if regex_pattern else default_pattern\n\n    def check_str(self, s: str) -> bool:\n        \"\"\"Applies the stored regex to the input string to find a match.\"\"\"\n        # Uses re.match to check for a match at the beginning of the string.\n        return re.match(self._regex_pattern, s) is not None\n\ndef check_str(s: str) -> bool:\n    \"\"\"Module-level function to check if a string starts with a vowel.\"\"\"\n    # Instantiates VowelChecker and delegates the check.\n    checker = VowelChecker()\n    return checker.check_str(s)\n\n```\n```\n# tests/test_vowel_checker.py\nfrom src.vowel_checker import check_str\n\ndef test_check_str_annie():\n    \"\"\"Verifies that 'annie' is correctly identified as starting with a vowel.\"\"\"\n    # Asserts the public API function returns True for \"annie\".\n    assert check_str(\"annie\") is True\n\n```"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n):\n    \"\"\"\n    Finds the smallest integer k such that the triangular number T_k has exactly n decimal digits.\n    Assumes n is an integer >= 1.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_number = k * (k + 1) // 2\n        digits = len(str(triangular_number))\n        if digits == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(tuple_input):\n    \"\"\"\n    Convert adjacent elements of tuple_input to a dict mapping.\n    Interprets even-indexed elements as keys and odd-indexed elements as values.\n    \"\"\"\n    mapping = {}\n    limit = len(tuple_input) - (len(tuple_input) % 2)\n    for i in range(0, limit, 2):\n        mapping[tuple_input[i]] = tuple_input[i + 1]\n    return mapping"}
{"task_id": "Mbpp/739", "solution": "def _triangular_value(k: int) -> int:\n    \"\"\"Computes the k-th triangular number T_k = k*(k+1)//2.\"\"\"\n    return k * (k + 1) // 2\n\ndef _compute_threshold(n: int) -> int:\n    \"\"\"Calculates the minimum value a number must have to possess exactly n digits.\"\"\"\n    return 10 ** (n - 1)\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the smallest index k such that T_k has exactly n digits.\n    Assumes n is an integer >= 1 as per critical requirements.\n    \"\"\"\n    threshold = _compute_threshold(n)\n\n    # Establish an initial upper bound for binary search.\n    low = 1\n    high = 1\n    while _triangular_value(high) < threshold:\n        high *= 2\n\n    # Perform binary search to find the minimal k.\n    result_k = high\n    while low <= high:\n        mid = (low + high) // 2\n        t_mid = _triangular_value(mid)\n        if t_mid >= threshold:\n            result_k = mid\n            high = mid - 1\n        else:\n            low = mid + 1\n    return result_k\n\nassert find_Index(2) == 4"}
{"task_id": "Mbpp/740", "solution": "def validate_type(t):\n    \"\"\"Raise TypeError if t is not a tuple.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\ndef validate_length(t):\n    \"\"\"Raise ValueError if len(t) is odd.\"\"\"\n    if len(t) % 2 != 0:\n        raise ValueError(\"Tuple length must be even.\")\n\ndef validate_key_hashable(k):\n    \"\"\"Raise TypeError if k is unhashable.\"\"\"\n    try:\n        hash(k)\n    except TypeError:\n        raise TypeError(f\"Key '{k}' is unhashable.\")\n\ndef convert(t):\n    \"\"\"Iterate t in steps of 2, validate key hashability, and build the dict (last-occurrence-wins). Returns dict.\"\"\"\n    result_dict = {}\n    for i in range(0, len(t), 2):\n        key = t[i]\n        value = t[i+1]\n        validate_key_hashable(key)\n        result_dict[key] = value\n    return result_dict\n\ndef tuple_to_dict(t):\n    \"\"\"Convert adjacent elements of tuple t into a dict.\n\n    Args:\n        t (tuple): Input tuple with even length. Adjacent pairs (t[0],t[1]), (t[2],t[3]), ... become key:value entries.\n\n    Returns:\n        dict: Mapping of keys to values where later occurrences override earlier ones.\n\n    Raises:\n        TypeError: If t is not a tuple or any derived key is unhashable.\n        ValueError: If len(t) is odd.\n    \"\"\"\n    validate_type(t)\n    validate_length(t)\n    return convert(t)"}
{"task_id": "Mbpp/742", "solution": "```python\n# src/geometry/math_utils.py\nimport math\n\nclass MathUtils:\n    \"\"\"Provides mathematical utility methods.\n    It wraps standard library math functions.\"\"\"\n\n    @staticmethod\n    def sqrt(x: float) -> float:\n        \"\"\"Calculates the square root of a number.\n        This method delegates to math.sqrt.\"\"\"\n        return math.sqrt(x)\n\n```python\n# src/geometry/tetrahedron.py\nfrom .math_utils import MathUtils\n\nclass Tetrahedron:\n    \"\"\"Represents a regular tetrahedron domain object.\n    It computes its surface area based on edge length.\"\"\"\n\n    def __init__(self, edgeLength: float):\n        \"\"\"Initializes the tetrahedron with a given edge length.\"\"\"\n        self.edgeLength = edgeLength\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Computes the surface area using area = sqrt(3) * a^2.\n        It delegates the square root calculation to MathUtils.\"\"\"\n        return MathUtils.sqrt(3) * self.edgeLength * self.edgeLength\n\n```python\n# src/geometry/function_interface.py\nfrom .tetrahedron import Tetrahedron\n\nclass FunctionInterface:\n    \"\"\"Provides the API-level behavior for tetrahedron area computation.\n    It acts as an adapter to the domain objects.\"\"\"\n\n    @staticmethod\n    def area_tetrahedron(a: float) -> float:\n        \"\"\"Computes the surface area of a regular tetrahedron.\n        This method creates a Tetrahedron object and calls its compute method.\"\"\"\n        tetra = Tetrahedron(edgeLength=a)\n        return tetra.computeSurfaceArea()\n\ndef area_tetrahedron(a: float) -> float:\n    \"\"\"Computes the surface area of a regular tetrahedron.\n    This is the public API entry point, delegating to FunctionInterface.\"\"\"\n    return FunctionInterface.area_tetrahedron(a)\n\n```python\n# src/geometry/__init__.py\nfrom .function_interface import area_tetrahedron\n\"\"\"geometry package initializer.\nIt re-exports the public API function area_tetrahedron.\"\"\"\n```"}
