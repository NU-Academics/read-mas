{"task_id": "Mbpp/751", "solution": "class Comparator:\n    \"\"\"Provides comparison logic for elements.\"\"\"\n    def compare(self, a, b) -> int:\n        if a < b: return -1\n        if a == b: return 0\n        return 1\n\nclass HeapArray:\n    \"\"\"Wraps a list to provide length and indexed access for heap operations.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int):\n        return self._elements[index]\n\nclass MinHeapChecker:\n    \"\"\"Encapsulates the algorithm for verifying the min-heap property.\"\"\"\n    def check_min_heap(self, array) -> bool:\n        heap = HeapArray(array)\n        n = heap.length()\n        comp = Comparator()\n\n        # Iterate only over parent nodes, which are at indices 0 to floor(n/2) - 1.\n        for i in range(0, n // 2):\n            parent = heap.get(i)\n\n            left_index = 2 * i + 1\n            if left_index < n:\n                left = heap.get(left_index)\n                if comp.compare(parent, left) > 0: # If parent is greater than left child\n                    return False\n\n            right_index = 2 * i + 2\n            if right_index < n:\n                right = heap.get(right_index)\n                if comp.compare(parent, right) > 0: # If parent is greater than right child\n                    return False\n        return True\n\ndef check_min_heap(array) -> bool:\n    \"\"\"Public API required by FR-1. Creates MinHeapChecker and returns boolean result.\"\"\"\n    checker = MinHeapChecker()\n    return checker.check_min_heap(array)"}
{"task_id": "Mbpp/753", "solution": "```python\n# src/min_k.py\nfrom typing import List, Tuple\n\ndef _is_numeric(value) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\n    This helper function supports input validation for record values.\n    \"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_records(records) -> None:\n    \"\"\"Validates that records is a list of (string, numeric) 2-tuples.\n    Raises ValueError for any invalid record format or data types.\n    \"\"\"\n    if not isinstance(records, list):\n        raise ValueError(\"Input 'records' must be a list.\")\n    for i, record in enumerate(records):\n        if not isinstance(record, tuple) or len(record) != 2:\n            raise ValueError(f\"Record at index {i} must be a 2-tuple.\")\n        if not isinstance(record[0], str):\n            raise ValueError(f\"First element of record at index {i} must be a string.\")\n        if not _is_numeric(record[1]):\n            raise ValueError(f\"Second element of record at index {i} must be numeric.\")\n\ndef _validate_k(k) -> None:\n    \"\"\"Validates that k is a non-negative integer.\n    Raises ValueError if k is not an integer or is negative.\n    \"\"\"\n    if not isinstance(k, int):\n        raise ValueError(\"Input 'k' must be an integer.\")\n    if k < 0:\n        raise ValueError(\"Input 'k' must be non-negative.\")\n\ndef min_k(records: List[Tuple[str, object]], k: int) -> List[Tuple[str, object]]:\n    \"\"\"Finds the k records with the smallest numeric values from a list of (string, numeric) tuples.\n    Returns a new list containing up to min(k, n) sorted records, where n is the number of input records.\n    \"\"\"\n    _validate_records(records)\n    _validate_k(k)\n\n    # Sort the records by their numeric value (second element) in ascending order.\n    # Python's built-in sorted() is a stable sort, as required by BR5/FR4.\n    sorted_records = sorted(records, key=lambda record: record[1])\n\n    # Select min(k, n) items from the sorted list, satisfying BR3/BR6/FR3.\n    num_to_select = min(k, len(sorted_records))\n    return sorted_records[:num_to_select]\n\n```\n\n```python\n# tests/test_min_k.py\nfrom src.min_k import min_k\n\ndef test_min_k_example():\n    \"\"\"Verifies the min_k function with the exact provided test case.\n    This test ensures conformance with FR5 of the requirements.\n    \"\"\"\n    test_records = [('Manjeet', 10), ('Akshat', 4), ('Akash', 2), ('Nikhil', 8)]\n    k_value = 2\n    expected_result = [('Akash', 2), ('Akshat', 4)]\n    actual_result = min_k(test_records, k_value)\n    assert actual_result == expected_result\n\n```"}
{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(arr):\n    \"\"\"\n    Evaluates whether a given zero-indexed array represents a min-heap.\n    Returns True if it's a min-heap, False immediately on first violation.\n    \"\"\"\n    n = len(arr)\n\n    # Empty or single-element arrays are considered valid min-heaps.\n    if n <= 1:\n        return True\n\n    # Iterate through potential parent nodes. The last possible parent is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the parent is greater than its left child (if it exists).\n        if left_child_idx < n:\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n        # Check if the parent is greater than its right child (if it exists).\n        if right_child_idx < n:\n            if arr[i] > arr[right_child_idx]:\n                return False\n\n    # If no violations were found after checking all parents, it's a min-heap.\n    return True\n```"}
{"task_id": "Mbpp/752", "solution": "```python\n# src/jacobsthal.py\nfrom typing import Any\n\n# Purpose: Implements the Jacobsthal number computation, validation logic, domain helper classes, and exposes the required public API function jacobsthal_num(n).\n\nclass Input:\n    \"\"\"Lightweight wrapper representing input index n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass Output:\n    \"\"\"Lightweight wrapper representing the computed Jacobsthal value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass RecurrenceRule:\n    \"\"\"Holds recurrence formula string.\"\"\"\n    formula: str = \"J(n) = J(n-1) + 2 * J(n-2)\"\n\nclass JacobsthalCalculator:\n    \"\"\"Validate input and compute the nth Jacobsthal number using an iterative algorithm.\"\"\"\n\n    def _validate_input(self, n) -> None:\n        \"\"\"Validates if n is a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n\n    def computeIterative(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number iteratively for n >= 2.\"\"\"\n        # Precondition: n must be >= 2 as base cases are handled externally.\n        a, b = 0, 1  # J(0) and J(1)\n        for _ in range(2, n + 1):\n            next_jacobsthal = b + 2 * a\n            a, b = b, next_jacobsthal\n        return b\n\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number after validating input.\"\"\"\n        self._validate_input(n)\n\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        \n        return self.computeIterative(n)\n\ndef jacobsthal_num(n) -> int:\n    \"\"\"Public API: validate and return the nth Jacobsthal number (zero-based).\"\"\"\n    calculator = JacobsthalCalculator()\n    return calculator.jacobsthal_num(n)\n\n```\n```python\n# tests/test_jacobsthal.py\nimport pytest\nfrom src.jacobsthal import jacobsthal_num\n\n# Purpose: Unit tests verifying correctness and validation behavior defined in the SRS.\n\ndef test_base_cases():\n    \"\"\"Tests the base cases J(0) and J(1).\"\"\"\n    assert jacobsthal_num(0) == 0\n    assert jacobsthal_num(1) == 1\n\ndef test_acceptance_case():\n    \"\"\"Tests the acceptance case J(5) == 11.\"\"\"\n    assert jacobsthal_num(5) == 11\n\ndef test_invalid_inputs():\n    \"\"\"Tests that invalid inputs raise a ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"n must be a non-negative integer\"):\n        jacobsthal_num(-1)\n    with pytest.raises(ValueError, match=\"n must be a non-negative integer\"):\n        jacobsthal_num(2.5)\n    with pytest.raises(ValueError, match=\"n must be a non-negative integer\"):\n        jacobsthal_num('3')\n    with pytest.raises(ValueError, match=\"n must be a non-negative integer\"):\n        jacobsthal_num(None)\n\n```"}
{"task_id": "Mbpp/752", "solution": "class InputValidator:\n    \"\"\"Validates inputs for Jacobsthal number computation.\n    Checks if n is a non-negative integer.\n    \"\"\"\n    def validateIntegerNonNegative(self, n: any) -> None:\n        \"\"\"Checks if n is a non-negative integer, raising errors if not.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"n must be a non-negative integer (n >= 0).\")\n\n\nclass JacobsthalDefinition:\n    \"\"\"Holds the definition of Jacobsthal numbers.\n    Includes base cases J(0), J(1) and the recurrence formula.\n    \"\"\"\n    base0: int = 0\n    base1: int = 1\n    recurrence: str = \"J(n) = J(n-1) + 2 * J(n-2)\"\n\n# Module-level constants as specified in the design.\nJ0: int = 0\nJ1: int = 1\nRECURRENCE: str = \"J(n) = J(n-1) + 2 * J(n-2)\"\n\n\nclass JacobsthalResult:\n    \"\"\"A simple container for the computed Jacobsthal number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def to_int(self) -> int:\n        \"\"\"Returns the integer value contained in this result.\"\"\"\n        return self.value\n\n\nclass JacobsthalFunction:\n    \"\"\"Computes Jacobsthal numbers using base cases and recurrence.\n    Implements the computation iteratively to avoid recursion limits.\n    \"\"\"\n    def __init__(self):\n        self._def = JacobsthalDefinition()\n\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"Returns the nth Jacobsthal number.\"\"\"\n        if n == self._def.base0:\n            return 0\n        if n == self._def.base1:\n            return 1\n        return self.computeRecurrence(n)\n\n    def computeRecurrence(self, n: int) -> int:\n        \"\"\"Computes J(n) for n >= 2 using an iterative approach.\"\"\"\n        prev2 = self._def.base0  # Represents J(i-2)\n        prev1 = self._def.base1  # Represents J(i-1)\n        \n        for _ in range(2, n + 1):\n            current = prev1 + 2 * prev2\n            prev2 = prev1\n            prev1 = current\n        return current\n\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number J(n).\n    This is the public API function, handling validation and delegating computation.\n    \"\"\"\n    InputValidator().validateIntegerNonNegative(n)\n    return JacobsthalFunction().jacobsthal_num(n)"}
{"task_id": "Mbpp/753", "solution": "```python\ndef min_k(records, k):\n    \"\"\"Finds the k tuples with the smallest numeric second elements from a list of records.\n    Assumes valid input structure and types as per critical requirements.\n    \"\"\"\n\n    def sort_by_value_ascending(recs):\n        \"\"\"Sorts records stably by their second element in ascending order.\"\"\"\n        return sorted(recs, key=lambda r: r[1])\n\n    sorted_records = sort_by_value_ascending(records)\n\n    # Handle boundary conditions for k as per design\n    if k <= 0:\n        return []\n    \n    n = len(sorted_records)\n    if k >= n:\n        return sorted_records\n    \n    return sorted_records[:k]\n```"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3) -> list:\n    \"\"\"\n    Return a list of elements that appear in l1, l2, l3 at the same index.\n    Matches are appended in increasing index order.\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/754", "solution": "def _min_length(l1, l2, l3):\n    \"\"\"\n    Computes the minimum length among the three input lists.\n    \"\"\"\n    return min(len(l1), len(l2), len(l3))\n\ndef _elements_equal_at(l1, l2, l3, i):\n    \"\"\"\n    Checks if elements at a given index 'i' are equal across all three lists.\n    \"\"\"\n    return l1[i] == l2[i] == l3[i]\n\ndef extract_index_list(l1, l2, l3):\n    \"\"\"\n    Return a Python list of elements present and equal at the same indices in l1, l2, and l3.\n    \"\"\"\n    n = _min_length(l1, l2, l3)\n    result = []\n    for i in range(n):\n        if _elements_equal_at(l1, l2, l3, i):\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/755", "solution": "```python\nfrom typing import List, Union, Any\n\nclass ValidationException(Exception):\n    \"\"\"\n    Custom exception for validation errors, carrying type and message.\n    Raised for invalid inputs or insufficient elements.\n    \"\"\"\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"ValidationException({self.type}): {self.message}\"\n\ndef _validate_list(list_arg: Any) -> None:\n    \"\"\"\n    Validates that the input is a list of numeric elements with at least two items.\n    Raises ValidationException for invalid types, insufficient elements, or non-numeric elements.\n    \"\"\"\n    if not isinstance(list_arg, list):\n        raise ValidationException(\"InvalidType\", \"Input must be a list of numeric elements.\")\n\n    if len(list_arg) < 2:\n        raise ValidationException(\"InsufficientElements\", \"List must contain at least 2 numeric elements.\")\n\n    for element in list_arg:\n        if not isinstance(element, (int, float)):\n            raise ValidationException(\"NonNumericElement\", \"All elements in the list must be numeric (int or float).\")\n\ndef _compute_second_smallest(list_arg: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Sorts the given list and returns the element at index 1.\n    This helper assumes the input list has already been validated.\n    \"\"\"\n    sorted_list = sorted(list_arg)\n    return sorted_list[1]\n\ndef second_smallest(list_arg: Any) -> Union[int, float]:\n    \"\"\"\n    Finds the second smallest numeric element in a list after validation.\n    The function validates the input, then computes and returns the result.\n    \"\"\"\n    _validate_list(list_arg)\n    return _compute_second_smallest(list_arg)\n```"}
