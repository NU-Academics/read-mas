{"task_id": "Mbpp/562", "solution": "```python\n# src/find_max_length.py\n#!/usr/bin/env python3\nfrom typing import Any, List\n\ndef Find_Max_Length(input_list: List[List[Any]]) -> int:\n    \"\"\"\n    Computes the length of the longest sublist in a list of sublists.\n    Returns 0 if the input list is empty, as per design specification.\n    \"\"\"\n    if not input_list:\n        return 0\n    \n    # Calculate lengths of all sublists and find the maximum among them.\n    return max(len(sublist) for sublist in input_list)\n\n```\n```python\n# tests/test_find_max_length.py\n#!/usr/bin/env python3\nfrom src.find_max_length import Find_Max_Length\n\n# This assertion verifies the core functionality as specified in the SRS.\nassert Find_Max_Length([[1],[1,4],[5,6,7,8]]) == 4\n\n```"}
{"task_id": "Mbpp/562", "solution": "```python\n# src/find_max_length.py\n\"\"\"Module to find the length of the longest sublist.\n\nImplements Find_Max_Length as specified in the design document.\n\"\"\"\n\ndef Find_Max_Length(list_of_sublists):\n    \"\"\"Compute and return the length of the longest sublist.\n\n    Returns 0 for an empty input list as per design decision.\n    \"\"\"\n    max_length = 0\n    for sublist in list_of_sublists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length\n```\n```python\n# tests/test_find_max_length.py\n\"\"\"Assertion-based test script for Find_Max_Length.\n\nTests the example case required by the design specification.\n\"\"\"\n\nfrom src.find_max_length import Find_Max_Length\n\ndef run_assertion_test():\n    \"\"\"Executes the assertion test for Find_Max_Length.\"\"\"\n    assert Find_Max_Length([[1],[1,4],[5,6,7,8]]) == 4\n\nif __name__ == '__main__':\n    run_assertion_test()\n```"}
{"task_id": "Mbpp/563", "solution": "```python\n# src/extractor.py\nimport re\nfrom typing import List\n\nclass InputString:\n    \"\"\"Wrapper for input text.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass QuotedSubstring:\n    \"\"\"Representation of each identified quoted match.\"\"\"\n    def __init__(self, value: str, start_index: int, end_index: int) -> None:\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass ResultList:\n    \"\"\"Container for returned items.\"\"\"\n    def __init__(self, items: List[str]) -> None:\n        self.items = items\n\n    def count(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\nclass Extractor:\n    \"\"\"Encapsulates parsing logic to extract quoted substrings.\"\"\"\n    def extract_values(self, input_str: str) -> List[str]:\n        \"\"\"Parses an input string to find and return unquoted substrings.\"\"\"\n        input_object = InputString(input_str)\n        quoted_substrings = self._parse_input(input_object)\n        \n        # Convert QuotedSubstring objects to a list of unquoted string values\n        result_items = [qs.value for qs in quoted_substrings]\n        \n        return ResultList(result_items).items\n\n    def _parse_input(self, input_string: InputString) -> List[QuotedSubstring]:\n        \"\"\"Identifies and collects all double-quoted substrings.\"\"\"\n        found_substrings: List[QuotedSubstring] = []\n        # Regex to find double quotes and capture content between them\n        for match in re.finditer(r'\"([^\"]*)\"', input_string.value):\n            found_substrings.append(\n                QuotedSubstring(match.group(1), match.start(), match.end())\n            )\n        return found_substrings\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Parses an input string to return all substrings enclosed in double quotation marks\n    as an ordered list of unquoted strings.\n    \"\"\"\n    extractor = Extractor()\n    return extractor.extract_values(input)\n\n__all__ = ['extract_values']\n\n```\n```python\n# tests/test_extract_values.py\nfrom src.extractor import extract_values\nfrom typing import List\n\nclass TestCase:\n    \"\"\"Encapsulates a single acceptance test assertion.\"\"\"\n    def __init__(self, name: str, input_str: str, expected_output: List[str]) -> None:\n        self.name = name\n        self.input_str = input_str\n        self.expected_output = expected_output\n\n    def assertion(self) -> bool:\n        \"\"\"Performs the test assertion using the extract_values function.\"\"\"\n        actual_output = extract_values(self.input_str)\n        return actual_output == self.expected_output\n\n    def run(self) -> None:\n        \"\"\"Executes the assertion and reports success or raises AssertionError on failure.\"\"\"\n        print(f\"Running test: {self.name}...\")\n        if not self.assertion():\n            actual = extract_values(self.input_str)\n            raise AssertionError(\n                f\"{self.name} failed.\\n\"\n                f\"Input: '{self.input_str}'\\n\"\n                f\"Expected: {self.expected_output}\\n\"\n                f\"Got: {actual}\"\n            )\n        print(f\"Test '{self.name}' PASSED.\")\n\ndef run_acceptance_test() -> None:\n    \"\"\"\n    Runs the canonical acceptance test for extract_values.\n    This function acts as the entry point for the acceptance test suite.\n    \"\"\"\n    print(\"\\n--- Running Acceptance Tests ---\")\n    \n    # FR6: extract_values('\"Python\", \"PHP\", \"Java\"') == ['Python', 'PHP', 'Java']\n    fr6_test = TestCase(\n        \"FR6 Acceptance Assertion\",\n        '\"Python\", \"PHP\", \"Java\"',\n        ['Python', 'PHP', 'Java']\n    )\n    \n    fr6_test.run()\n    \n    print(\"--- All Acceptance Tests Passed ---\")\n\n```"}
{"task_id": "Mbpp/560", "solution": "```python\n# src/__init__.py\nfrom .union_elements import union_elements\n\n__all__ = [\"union_elements\"]\n\n# src/models.py\nfrom typing import Tuple, Any\n\nclass TupleInput:\n    \"\"\"Represents a tuple input for processing.\"\"\"\n    def __init__(self, elements: Tuple[Any, ...]):\n        self.elements = elements\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the input tuple is empty.\"\"\"\n        return not self.elements\n\nclass OutputTuple:\n    \"\"\"Represents the immutable tuple output.\"\"\"\n    def __init__(self, elements: Tuple[Any, ...]):\n        self.elements = elements\n\n# src/validator.py\nfrom typing import Any, List\n\nclass Validator:\n    \"\"\"Validates input types and element comparability.\"\"\"\n\n    def validate_tuple(self, t: Any) -> bool:\n        \"\"\"Validates that the input 't' is a tuple.\"\"\"\n        if not isinstance(t, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        return True\n\n    def validate_comparable(self, elements: List[Any]) -> bool:\n        \"\"\"Validates that all elements in the list are mutually comparable.\"\"\"\n        try:\n            # Attempting to sort is the most straightforward way to check comparability.\n            sorted(elements)\n        except TypeError as e:\n            raise TypeError(f\"Elements are not mutually comparable: {e}\") from e\n        return True\n\n# src/deduplicator.py\nfrom typing import List, Any\n\nclass Deduplicator:\n    \"\"\"Removes duplicate elements from a collection.\"\"\"\n\n    def deduplicate(self, elements: List[Any]) -> List[Any]:\n        \"\"\"Returns a list of unique elements from the input list.\"\"\"\n        return list(set(elements))\n\n# src/sorter.py\nfrom typing import List, Any\n\nclass Sorter:\n    \"\"\"Sorts a sequence of comparable elements.\"\"\"\n\n    def sort_ascending(self, elements: List[Any]) -> List[Any]:\n        \"\"\"Returns a new list sorted in ascending order.\"\"\"\n        return sorted(elements)\n\n# src/union_elements.py\nfrom typing import Tuple, Any, List\nfrom .validator import Validator\nfrom .deduplicator import Deduplicator\nfrom .sorter import Sorter\n# The models are imported for adherence to the design's module dependency,\n# though TupleInput and OutputTuple classes are not directly instantiated in this function.\nfrom .models import TupleInput, OutputTuple \n\ndef union_elements(t1: Tuple[Any, ...], t2: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Computes the union of elements from two tuples, removes duplicates, and sorts them.\n    Raises TypeError if inputs are not tuples or elements are not mutually comparable.\n    \"\"\"\n    validator = Validator()\n    deduplicator = Deduplicator()\n    sorter = Sorter()\n\n    validator.validate_tuple(t1)\n    validator.validate_tuple(t2)\n\n    combined: List[Any] = list(t1) + list(t2)\n    validator.validate_comparable(combined)\n\n    unique_list: List[Any] = deduplicator.deduplicate(combined)\n    sorted_list: List[Any] = sorter.sort_ascending(unique_list)\n    \n    return tuple(sorted_list)\n```"}
{"task_id": "Mbpp/563", "solution": "```python\nclass InputString:\n    def __init__(self, raw: str):\n        \"\"\"Initializes the InputString with the raw input.\"\"\"\n        self.raw: str = raw\n\nclass QuotedValue:\n    def __init__(self, value: str, position: int):\n        \"\"\"Initializes a QuotedValue with its string value and occurrence position.\"\"\"\n        self.value: str = value\n        self.position: int = position\n\nclass ResultList:\n    def __init__(self):\n        \"\"\"Initializes an empty list to store QuotedValue instances.\"\"\"\n        self._values: list[QuotedValue] = []\n    def append(self, q: QuotedValue) -> None:\n        \"\"\"Appends a QuotedValue to the internal list.\"\"\"\n        self._values.append(q)\n    def toList(self) -> list:\n        \"\"\"Converts the collected QuotedValue objects to a list of their string values.\"\"\"\n        return [q.value for q in self._values]\n\nclass Parser:\n    def findQuotedSubstrings(self, s: str) -> list:\n        \"\"\"Scans for double-quoted substrings and returns QuotedValue objects.\"\"\"\n        found_values: list[QuotedValue] = []\n        current_pos = 0\n        while True:\n            start_quote_idx = s.find('\"', current_pos)\n            if start_quote_idx == -1:\n                break\n\n            end_quote_idx = s.find('\"', start_quote_idx + 1)\n            if end_quote_idx == -1:\n                break\n\n            value = s[start_quote_idx + 1 : end_quote_idx]\n            found_values.append(QuotedValue(value=value, position=len(found_values)))\n            current_pos = end_quote_idx + 1\n        return found_values\n\ndef extract_values(input: str) -> list:\n    \"\"\"Parses an input string to extract values enclosed in double quotes.\"\"\"\n    input_string_obj = InputString(input)\n    parser = Parser()\n    quoted_values = parser.findQuotedSubstrings(input_string_obj.raw)\n\n    result_list = ResultList()\n    for qv in quoted_values:\n        result_list.append(qv)\n\n    return result_list.toList()\n```"}
{"task_id": "Mbpp/565", "solution": "```python\n# split_function_project/src/split.py\n\nfrom dataclasses import dataclass\nfrom typing import List\n\nclass StringInput:\n    \"\"\"Container for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\n@dataclass\nclass Character:\n    \"\"\"Represents a single-character string and its zero-based position.\"\"\"\n    value: str  # Must be length 1\n    position: int\n\nclass CharacterList:\n    \"\"\"Ordered container of Character items with computed length and an adapter to native Python list[str].\"\"\"\n    def __init__(self, items: List[Character]):\n        self.items: List[Character] = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of characters in the list.\"\"\"\n        return len(self.items)\n\n    def to_native_list(self) -> List[str]:\n        \"\"\"Adapts the internal Character list to a native Python list of strings.\"\"\"\n        return [char.value for char in self.items]\n\nclass SplitFunction:\n    \"\"\"Implements the algorithm that splits a Python string into its sequence of characters.\"\"\"\n    name: str = \"split\"\n\n    def split(self, input_string: str) -> List[str]:\n        \"\"\"Accepts a Python string and returns a list of single-character strings.\"\"\"\n        character_list = self._to_character_list(input_string)\n        return character_list.to_native_list()\n\n    def _to_character_list(self, input_string: str) -> 'CharacterList':\n        \"\"\"Internal helper constructing CharacterList from the input string.\"\"\"\n        string_input = StringInput(input_string)\n        characters = [\n            Character(value=char_value, position=i)\n            for i, char_value in enumerate(string_input.value)\n        ]\n        return CharacterList(items=characters)\n\ndef split(input_string: str) -> List[str]:\n    \"\"\"Public API: accepts exactly one Python string and returns a list of single-character strings.\"\"\"\n    # Delegates to an instance of SplitFunction as per design.\n    return SplitFunction().split(input_string)\n\n```\n```python\n# split_function_project/tests/test_split.py\n\n# Ensure 'src' directory is on PYTHONPATH when running tests from project root\n# For example, by running `python -m pytest` or `export PYTHONPATH=$PYTHONPATH:./src && python tests/test_split.py`\nfrom split import split\n\ndef run_acceptance_test() -> None:\n    \"\"\"Executes the acceptance assertion for the split function.\"\"\"\n    input_string = 'python'\n    expected_output = ['p', 'y', 't', 'h', 'o', 'n']\n    result = split(input_string)\n\n    assert result == expected_output, \\\n        f\"Acceptance test failed: split('{input_string}') returned {result}, expected {expected_output}\"\n\n    print(f\"Acceptance test passed for input '{input_string}'. Result: {result}\")\n\nif __name__ == '__main__':\n    run_acceptance_test()\n\n```"}
