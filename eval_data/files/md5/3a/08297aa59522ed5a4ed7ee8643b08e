{"task_id": "Mbpp/457", "solution": "```python\ndef compute_lengths(input_list):\n    \"\"\"\n    Computes the lengths of each sublist in the input list.\n    Returns a list of integer lengths.\n    \"\"\"\n    return [len(sublist) for sublist in input_list]\n\ndef Find_Min(input):\n    \"\"\"\n    Returns the first sublist with the minimum length from the input.\n    Assumes input is a list of sublists.\n    \"\"\"\n    lengths = compute_lengths(input)\n    min_length = min(lengths)\n    min_index = lengths.index(min_length)\n    return input[min_index]\n```"}
{"task_id": "Mbpp/458", "solution": "```python\n# src/domain.py\nclass Rectangle:\n    \"\"\"Represents a rectangle with length and width.\"\"\"\n    def __init__(self, length: float, width: float):\n        self.length = length\n        self.width = width\n\n    def area(self) -> float:\n        \"\"\"Calculates the area of the rectangle.\"\"\"\n        return self.length * self.width\n\nclass CalculationResult:\n    \"\"\"Wraps a numeric calculation result.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n```\n```python\n# src/validator.py\nfrom src.domain import ValidationError\n\nclass Validator:\n    \"\"\"Performs input validation checks.\"\"\"\n    def validate_inputs(self, length, width) -> bool:\n        \"\"\"Checks if length and width are numeric types.\"\"\"\n        if not isinstance(length, (int, float)) or not isinstance(width, (int, float)):\n            return False\n        return True\n\n```\n```python\n# src/area_calculator.py\nfrom src.domain import Rectangle, CalculationResult, ValidationError\nfrom src.validator import Validator\n\nclass AreaCalculator:\n    \"\"\"Orchestrates calculation of rectangle area.\"\"\"\n    def __init__(self, validator: Validator = None):\n        \"\"\"Initializes the calculator, optionally with a validator.\"\"\"\n        self._validator = validator if validator is not None else Validator()\n\n    def rectangle_area(self, length: float, width: float) -> float:\n        \"\"\"Computes the area of a rectangle.\n        Assumes inputs are already validated as numeric by the caller.\n        \"\"\"\n        rectangle = Rectangle(length, width)\n        area_value = rectangle.area()\n        # CalculationResult is an internal wrapper, API returns raw numeric.\n        _ = CalculationResult(area_value)\n        return area_value\n\n    def validate_inputs(self, length: float, width: float) -> bool:\n        \"\"\"Delegates input validation to the internal validator.\"\"\"\n        return self._validator.validate_inputs(length, width)\n\n```\n```python\n# src/rectangle_area.py\nfrom src.area_calculator import AreaCalculator\nfrom src.validator import Validator\nfrom src.domain import ValidationError\n\ndef rectangle_area(length, width):\n    \"\"\"Public API: compute area of rectangle.\n    Parameters: length (int|float), width (int|float)\n    Returns: numeric (int|float)\n    Raises: ValidationError if inputs are not numeric\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_inputs(length, width):\n        raise ValidationError(\"Length and width must be numeric.\")\n\n    calculator = AreaCalculator(validator)\n    return calculator.rectangle_area(length, width)\n\n# Module-private factory for AreaCalculator (optional, but specified in design)\ndef _get_area_calculator() -> AreaCalculator:\n    \"\"\"Factory function for AreaCalculator.\"\"\"\n    return AreaCalculator(Validator())\n\n```\n```python\n# src/__init__.py\nfrom src.rectangle_area import rectangle_area\n\n__all__ = [\"rectangle_area\"]\n\n```\n```python\n# tests/test_rectangle_area.py\nfrom src.rectangle_area import rectangle_area\nfrom src.domain import ValidationError\nimport pytest\n\ndef test_rectangle_area_acceptance():\n    \"\"\"Acceptance test: verifies area calculation for specific inputs.\"\"\"\n    assert rectangle_area(10, 20) == 200\n\ndef test_rectangle_area_valid_floats():\n    \"\"\"Tests with valid floating-point numbers.\"\"\"\n    assert rectangle_area(10.5, 2.0) == 21.0\n    assert rectangle_area(7.0, 3.5) == 24.5\n\ndef test_rectangle_area_invalid_non_numeric_length():\n    \"\"\"Tests error handling for non-numeric length.\"\"\"\n    with pytest.raises(ValidationError, match=\"Length and width must be numeric.\"):\n        rectangle_area(\"ten\", 20)\n\ndef test_rectangle_area_invalid_non_numeric_width():\n    \"\"\"Tests error handling for non-numeric width.\"\"\"\n    with pytest.raises(ValidationError, match=\"Length and width must be numeric.\"):\n        rectangle_area(10, \"twenty\")\n\ndef test_rectangle_area_invalid_none_inputs():\n    \"\"\"Tests error handling for None inputs.\"\"\"\n    with pytest.raises(ValidationError, match=\"Length and width must be numeric.\"):\n        rectangle_area(None, 20)\n    with pytest.raises(ValidationError, match=\"Length and width must be numeric.\"):\n        rectangle_area(10, None)\n    with pytest.raises(ValidationError, match=\"Length and width must be numeric.\"):\n        rectangle_area(None, None)\n\n```"}
