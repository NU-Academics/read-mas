{"task_id": "Mbpp/119", "solution": "```python\n# src/__init__.py\n# Package marker for src package. Makes src importable.\n\n\n# src/search.py\nfrom typing import List\n\ndef validate_input(nums: List[int]) -> bool:\n    \"\"\"Validate SRS preconditions: nums is a list of ints, sorted non-decreasingly,\n    and exactly one element occurs once while all others occur twice.\n    Returns True if valid, False otherwise.\"\"\"\n    if not isinstance(nums, list):\n        return False\n    if not nums:  # An empty list cannot satisfy the conditions\n        return False\n\n    counts = {}\n    for i, x in enumerate(nums):\n        if not isinstance(x, int):\n            return False\n        if i > 0 and nums[i] < nums[i-1]:  # Check non-decreasing order\n            return False\n        counts[x] = counts.get(x, 0) + 1\n\n    unique_count = 0\n    for count in counts.values():\n        if count == 1:\n            unique_count += 1\n        elif count != 2:\n            return False\n\n    return unique_count == 1\n\ndef search(nums: List[int]) -> int:\n    \"\"\"Return the integer that appears only once in the sorted list nums.\n    Raises ValueError if nums does not meet SRS preconditions.\n    Signature matches SRS: search(nums: List[int]) -> int.\"\"\"\n    if not validate_input(nums):\n        raise ValueError(\"Input list does not meet preconditions (type, sortedness, or element counts).\")\n\n    # Linear scan approach: iterate with a step of 2.\n    # The unique element breaks the pair pattern.\n    i = 0\n    while i < len(nums) - 1:\n        if nums[i] != nums[i+1]:\n            return nums[i]\n        i += 2\n    \n    # If the loop completes, the unique element is the last one in the list.\n    return nums[len(nums)-1]\n```"}
{"task_id": "Mbpp/120", "solution": "from typing import Union, Iterable\n\nNumber = Union[int, float]\n\nclass TuplePair:\n    \"\"\"\n    Encapsulates a pair of numeric values for product calculation.\n    Provides methods to compute the product and its absolute value.\n    \"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = a\n        self.b = b\n\n    def product(self) -> Number:\n        \"\"\"Calculates the product of the two elements.\"\"\"\n        return self.a * self.b\n\n    def abs_product(self) -> Number:\n        \"\"\"Calculates the absolute product of the two elements.\"\"\"\n        return abs(self.a * self.b)\n\ndef max_product_tuple(input_list: Iterable[tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Computes the maximum absolute product from an iterable of 2-element numeric tuples.\n    This function directly processes input, assuming its validity per critical requirements.\n    \"\"\"\n    abs_products = [TuplePair(a, b).abs_product() for a, b in input_list]\n    return max(abs_products)"}
{"task_id": "Mbpp/120", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import Iterable, Tuple, List\nimport numbers # For numbers.Real type checking\n\n@dataclass\nclass TuplePair:\n    \"\"\"\n    Represents a validated 2-element numeric pair.\n    Fields a and b store the numeric elements.\n    \"\"\"\n    a: numbers.Real\n    b: numbers.Real\n\nclass ProductComputation:\n    \"\"\"\n    Encapsulates the computation of the absolute product for a pair.\n    This class is stateless and provides a method to compute abs(a*b).\n    \"\"\"\n    def computeAbsProduct(self, pair: TuplePair) -> float:\n        \"\"\"\n        Computes the absolute value of the product of the elements in a TuplePair.\n        Returns a float representing abs(pair.a * pair.b).\n        \"\"\"\n        # Ensure calculations are float to handle potential mixed types (int and float)\n        # and to ensure the return type is consistently float as specified.\n        return abs(float(pair.a) * float(pair.b))\n\n@dataclass\nclass OutputResult:\n    \"\"\"\n    A data transfer object (DTO) to contain the maximum absolute product.\n    Holds the single numeric result 'max_abs_product'.\n    \"\"\"\n    max_abs_product: float\n\ndef _validate_input(input_iterable: Iterable[Tuple]) -> List[TuplePair]:\n    \"\"\"\n    Validates the input iterable's structure and element types.\n    Converts valid elements into TuplePair instances, raising ValueError for invalid or empty input.\n    \"\"\"\n    # Check if the input is actually an iterable. Using typing.Iterable for runtime check.\n    if not isinstance(input_iterable, Iterable):\n        raise ValueError('Input must be an iterable.')\n\n    validated_pairs: List[TuplePair] = []\n    has_elements = False\n    \n    for i, element in enumerate(input_iterable):\n        has_elements = True\n        # Check if element is a 2-length tuple or list\n        if not isinstance(element, (tuple, list)):\n            raise ValueError(f'Element at index {i} must be a tuple or list, got {type(element).__name__}.')\n        if len(element) != 2:\n            raise ValueError(f'Tuple/list at index {i} must have exactly 2 elements, got {len(element)}.')\n\n        # Check if elements within the tuple are numeric (numbers.Real covers int and float)\n        num1, num2 = element[0], element[1]\n        if not isinstance(num1, numbers.Real):\n            raise ValueError(f'First element of tuple/list at index {i} must be numeric, got {type(num1).__name__}.')\n        if not isinstance(num2, numbers.Real):\n            raise ValueError(f'Second element of tuple/list at index {i} must be numeric, got {type(num2).__name__}.')\n        \n        validated_pairs.append(TuplePair(a=num1, b=num2))\n    \n    if not has_elements:\n        raise ValueError('Input list must be non-empty.')\n            \n    return validated_pairs\n\n\ndef max_product_tuple(input_iterable: Iterable[Tuple]) -> float:\n    \"\"\"\n    Computes the maximum absolute product from a list of 2-element numeric tuples.\n    It validates input, computes per-tuple absolute products, and returns the maximum.\n    \"\"\"\n    # Orchestrates validation, computation, and aggregation as per design.\n    validated_pairs = _validate_input(input_iterable)\n\n    product_computation = ProductComputation()\n    \n    # Initialize with negative infinity to ensure any valid absolute product will be greater.\n    max_abs_product_value: float = -float('inf') \n\n    for pair in validated_pairs:\n        current_abs_product = product_computation.computeAbsProduct(pair)\n        if current_abs_product > max_abs_product_value:\n            max_abs_product_value = current_abs_product\n            \n    # The OutputResult DTO is part of the design but the function's public API directly returns a float.\n    return max_abs_product_value\n```"}
{"task_id": "Mbpp/123", "solution": "```python\ndef amicable_numbers_sum(limit):\n    \"\"\"Calculates the sum of amicable numbers up to a given limit.\"\"\"\n\n    _cache_divisor_sums = {}\n    _counted = set()\n    running_sum = 0\n\n    def _calculate_proper_divisors_sum(n):\n        \"\"\"Computes the sum of proper divisors for n, using memoization.\"\"\"\n        if n == 1:\n            return 0\n\n        if n in _cache_divisor_sums:\n            return _cache_divisor_sums[n]\n\n        total_sum = 1\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                total_sum += i\n                if i * i != n:\n                    total_sum += n // i\n\n        _cache_divisor_sums[n] = total_sum\n        return total_sum\n\n    def _is_amicable_pair(a, b):\n        \"\"\"Checks if two numbers form an amicable pair.\"\"\"\n        if a == b:\n            return False\n        \n        # This will use the outer _cache_divisor_sums via closure.\n        return _calculate_proper_divisors_sum(a) == b and _calculate_proper_divisors_sum(b) == a\n\n    for x in range(1, limit + 1):\n        if x in _counted:\n            continue\n\n        b = _calculate_proper_divisors_sum(x)\n\n        # Skip perfect numbers (a == b is not amicable).\n        # Also skip cases where b is non-positive, which isn't an amicable partner.\n        if b <= 1 or b == x:\n            continue\n\n        if _is_amicable_pair(x, b):\n            # If x and b form an amicable pair, add them to sum if within limit and not counted.\n            if x <= limit and x not in _counted:\n                running_sum += x\n                _counted.add(x)\n            \n            if b <= limit and b not in _counted:\n                running_sum += b\n                _counted.add(b)\n\n    return running_sum\n```"}
{"task_id": "Mbpp/123", "solution": "```python\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Computes the sum of all unique amicable numbers up to a given limit.\n    This function adheres to the design specification's algorithms and BR7 resolution\n    while conforming to critical output constraints.\n    \"\"\"\n    _d_map: dict[int, int] = {}\n\n    def sumProperDivisors(n: int) -> int:\n        \"\"\"\n        Computes the sum of proper divisors for a given integer n.\n        Returns 0 for n <= 1; iterates up to sqrt(n) to find divisors.\n        \"\"\"\n        if n <= 1:\n            return 0\n        \n        divisor_sum = 1  # 1 is always a proper divisor for n > 1\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                divisor_sum += i\n                if i * i != n:\n                    divisor_sum += n // i\n        return divisor_sum\n\n    def _compute_d(num: int) -> int:\n        \"\"\"\n        Caches and retrieves the sum of proper divisors for a number.\n        If not in cache, it calculates using sumProperDivisors and stores it.\n        \"\"\"\n        if num in _d_map:\n            return _d_map[num]\n        \n        result = sumProperDivisors(num)\n        _d_map[num] = result\n        return result\n\n    # First pass: Compute and cache sum of proper divisors for all numbers up to the limit.\n    # This populates the cache for numbers directly within the sum range.\n    for n in range(1, limit + 1):\n        _compute_d(n)\n\n    amicable_members = set()\n\n    # Second pass: Identify amicable pairs within the range 1..limit.\n    # BR7: Partners 'm' are checked even if m > limit.\n    for n in range(1, limit + 1):\n        d_n = _compute_d(n)\n        \n        # If d(n) == n, it's a perfect number, not amicable with itself.\n        if d_n == n:\n            continue\n        \n        m = d_n\n        # Compute d(m); this will use the cache or compute if 'm' is > limit.\n        d_m = _compute_d(m)\n        \n        # Check for amicable pair condition: d(n) == m and d(m) == n.\n        if d_m == n:\n            amicable_members.add(n)\n            amicable_members.add(m)\n\n    total_sum = 0\n    # Sum only the unique amicable numbers that fall within the 1..limit range.\n    for num in amicable_members:\n        if 1 <= num <= limit:\n            total_sum += num\n\n    return total_sum\n```"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Computes the maximum difference between the number of '0' characters and '1' characters\n    across all contiguous non-empty substrings of a binary input string using Kadane's algorithm.\n    Returns 0 for an empty input string.\n    \"\"\"\n    if not s:\n        return 0\n\n    # Map '0' to +1 and '1' to -1\n    mapped_numbers = []\n    for char in s:\n        if char == '0':\n            mapped_numbers.append(1)\n        else:  # char == '1'\n            mapped_numbers.append(-1)\n\n    max_so_far = 0\n    current_max = 0\n\n    # Kadane's algorithm to find the maximum subarray sum\n    for num in mapped_numbers:\n        current_max += num\n        if current_max < 0:\n            current_max = 0\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    return max_so_far"}
