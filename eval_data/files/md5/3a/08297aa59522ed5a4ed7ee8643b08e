{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\n\ndef max_difference(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"Compute the maximum absolute difference abs(a - b) among pairs.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not pairs:\n        raise ValueError(\"Input list 'pairs' cannot be empty.\")\n\n    return max(abs(a - b) for a, b in pairs)"}
{"task_id": "Mbpp/62", "solution": "```python\n# smallest_num.py\n\"\"\"Implements smallest_num(input_list) per SRS; raises ValueError('input list is empty') and TypeError('non-numeric element in input').\"\"\"\n\ndef is_numeric(value):\n    \"\"\"Return True if value is instance of (int, float).\"\"\"\n    return isinstance(value, (int, float))\n\ndef validate(input_list):\n    \"\"\"Validate: ensure input is list-like, non-empty, and all elements are int or float; raise exceptions per SRS.\"\"\"\n    if not isinstance(input_list, (list, tuple)):\n        raise TypeError(\"non-numeric element in input\")\n    if len(input_list) == 0:\n        raise ValueError(\"input list is empty\")\n    for v in input_list:\n        if not is_numeric(v):\n            raise TypeError(\"non-numeric element in input\")\n\ndef compute_min(input_list):\n    \"\"\"Compute and return numeric minimum. Assumes validate() passed.\"\"\"\n    return min(input_list)\n\ndef smallest_num(input_list):\n    \"\"\"Public API: Accept exactly one argument (list-like) and return smallest numeric value.\"\"\"\n    validate(input_list)\n    return compute_min(input_list)\n```\n```python\n# test_smallest_num.py\n\"\"\"Unit tests for smallest_num.py, verifying functionality and exception handling.\"\"\"\n\nimport pytest\nfrom smallest_num import smallest_num\n\ndef test_example_assertion():\n    \"\"\"Verify the example assertion from the SRS.\"\"\"\n    assert smallest_num([10, 20, 1, 45, 99]) == 1\n\ndef test_empty_list_raises():\n    \"\"\"Verify ValueError is raised for empty input lists.\"\"\"\n    with pytest.raises(ValueError) as excinfo:\n        smallest_num([])\n    assert str(excinfo.value) == \"input list is empty\"\n\ndef test_non_numeric_element_raises():\n    \"\"\"Verify TypeError is raised for non-numeric elements.\"\"\"\n    with pytest.raises(TypeError) as excinfo:\n        smallest_num([1, \"a\", 3])\n    assert str(excinfo.value) == \"non-numeric element in input\"\n\ndef test_non_list_input_raises_type_error():\n    \"\"\"Verify TypeError is raised for non-list-like input, as per design mapping.\"\"\"\n    with pytest.raises(TypeError) as excinfo:\n        smallest_num(\"not a list\")\n    assert str(excinfo.value) == \"non-numeric element in input\"\n\n    with pytest.raises(TypeError) as excinfo:\n        smallest_num(123)\n    assert str(excinfo.value) == \"non-numeric element in input\"\n\ndef test_float_values():\n    \"\"\"Test with float values in the list.\"\"\"\n    assert smallest_num([10.5, 20.1, 1.0, 45.9, 99.2]) == 1.0\n    assert smallest_num([0.1, -5.5, 2.3]) == -5.5\n\ndef test_mixed_int_float_values():\n    \"\"\"Test with mixed integer and float values.\"\"\"\n    assert smallest_num([10, 20.1, 1, 45.9, 99]) == 1\n    assert smallest_num([-10, -5.5, 0]) == -10\n    assert smallest_num([0.0, -0.1, 0.1]) == -0.1\n\ndef test_single_element_list():\n    \"\"\"Test with a single element in the list.\"\"\"\n    assert smallest_num([5]) == 5\n    assert smallest_num([-5.5]) == -5.5\n\ndef test_list_with_zero():\n    \"\"\"Test lists containing zero.\"\"\"\n    assert smallest_num([1, 0, 5]) == 0\n    assert smallest_num([-1, 0, 1]) == -1\n\ndef test_list_with_negative_numbers():\n    \"\"\"Test lists with negative numbers.\"\"\"\n    assert smallest_num([-10, -20, -1, -45, -99]) == -99\n```"}
{"task_id": "Mbpp/63", "solution": "```python\ndef max_difference(pairs):\n    \"\"\"\n    Computes the maximum absolute difference between values in 2-value numeric tuples.\n    It expects a list of tuples and computes abs(a - b) for each.\n    \"\"\"\n    # Compute the absolute difference for each pair.\n    differences = [abs(a - b) for a, b in pairs]\n    # Return the largest of these absolute differences.\n    return max(differences)\n```"}
