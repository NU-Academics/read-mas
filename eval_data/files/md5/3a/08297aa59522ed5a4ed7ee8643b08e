{"task_id": "Mbpp/259", "solution": "```python\nfrom typing import Any, Tuple\n\nclass ElementPair:\n    \"\"\"Value object representing a 2-element tuple.\"\"\"\n    def __init__(self, first: Any, second: Any):\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Returns the elements as a 2-element tuple.\"\"\"\n        return (self.first, self.second)\n\nclass MaximizeOperation:\n    \"\"\"Computes component-wise maxima of two ElementPair instances.\"\"\"\n    def compute(self, a: ElementPair, b: ElementPair) -> ElementPair:\n        \"\"\"Returns ElementPair with component-wise maximums.\"\"\"\n        return ElementPair(max(a.first, b.first), max(a.second, b.second))\n\nclass InputValidator:\n    \"\"\"Validates shape and comparability of inputs.\"\"\"\n    def validate_lengths(self, a: tuple, b: tuple):\n        \"\"\"Raises ValueError if input tuple lengths differ.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(f\"length mismatch: len(a)={len(a)}, len(b)={len(b)}\")\n\n    def validate_element_shape(self, elem: Any, index: int = None):\n        \"\"\"Raises TypeError if an element is not a 2-element tuple.\"\"\"\n        if not (isinstance(elem, tuple) and len(elem) == 2):\n            idx_msg = f\" at index {index}\" if index is not None else \"\"\n            raise TypeError(f\"element{idx_msg} is not a 2-element tuple: {elem!r}\")\n\n    def validate_comparability(self, x: Any, y: Any, index: int = None, component_name: str = None):\n        \"\"\"Raises TypeError if components are not comparable.\"\"\"\n        try:\n            max(x, y) # Attempt comparison\n        except TypeError:\n            idx_msg = f\" at index {index}\" if index is not None else \"\"\n            comp_msg = f\" for '{component_name}'\" if component_name else \"\"\n            raise TypeError(f\"non-comparable components{idx_msg}{comp_msg}: {x!r} vs {y!r}\")\n\nclass TuplePair:\n    \"\"\"Holds the two input tuples and provides an orchestration helper.\"\"\"\n    def __init__(self, elementsA: tuple, elementsB: tuple):\n        self.elementsA = elementsA\n        self.elementsB = elementsB\n\n    def maximize(self) -> 'ResultTuple':\n        \"\"\"Placeholder for orchestration; returns a ResultTuple.\"\"\"\n        # The main maximize_elements function directly orchestrates, so this is not called there.\n        pass\n\nclass ResultTuple:\n    \"\"\"Holds and emits the final result tuple.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Returns the stored result tuple.\"\"\"\n        return self.elements\n\n\ndef maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Public API; orchestrates validation and per-index maxima computation.\n    Returns a tuple of component-wise maxima, raising errors for invalid inputs.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_lengths(a, b)\n    results = []\n    op = MaximizeOperation()\n    for i in range(len(a)):\n        validator.validate_element_shape(a[i], i)\n        validator.validate_element_shape(b[i], i)\n        validator.validate_comparability(a[i][0], b[i][0], i, 'first')\n        validator.validate_comparability(a[i][1], b[i][1], i, 'second')\n        ea = ElementPair(a[i][0], a[i][1])\n        eb = ElementPair(b[i][0], b[i][1])\n        er = op.compute(ea, eb)\n        results.append(er.as_tuple())\n    return tuple(results)\n```"}
{"task_id": "Mbpp/259", "solution": "def validate_outer_length(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that the outer tuples have the same length.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"outer tuple length mismatch\")\n\ndef validate_inner_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that corresponding inner tuples have the same length.\"\"\"\n    for i in range(len(a)):\n        if len(a[i]) != len(b[i]):\n            raise ValueError(f\"inner tuple length mismatch at index {i}\")\n\ndef validate_numeric_types(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that all compared inner elements are numeric (int or float).\"\"\"\n    for i in range(len(a)):\n        for j in range(len(a[i])):\n            val_a = a[i][j]\n            val_b = b[i][j]\n            if not isinstance(val_a, (int, float)):\n                raise TypeError(f\"non-numeric element at index {i},{j}: {val_a}\")\n            if not isinstance(val_b, (int, float)):\n                raise TypeError(f\"non-numeric element at index {i},{j}: {val_b}\")\n\ndef compute_elementwise_max(a: tuple, b: tuple) -> tuple:\n    \"\"\"Computes the element-wise maximum of two validated tuples of tuples.\"\"\"\n    return tuple(\n        tuple(max(a[i][j], b[i][j]) for j in range(len(a[i])))\n        for i in range(len(a))\n    )\n\ndef maximize_elements(input_a: tuple, input_b: tuple) -> tuple:\n    \"\"\"\n    Computes the element-wise maximum of corresponding inner tuples from two input tuples.\n    Raises ValueError for length mismatches or TypeError for non-numeric elements.\n    \"\"\"\n    validate_outer_length(input_a, input_b)\n    validate_inner_lengths(input_a, input_b)\n    validate_numeric_types(input_a, input_b)\n    return compute_elementwise_max(input_a, input_b)"}
{"task_id": "Mbpp/261", "solution": "class LengthMismatchException(Exception):\n    \"\"\"Exception raised for unequal input tuple lengths.\"\"\"\n    def __init__(self, message: str = \"Input tuples have different lengths\"):\n        super().__init__(message)\n\nclass DivisionByZeroException(Exception):\n    \"\"\"Exception raised when a divisor element is zero.\"\"\"\n    def __init__(self, message: str = \"Division by zero detected in divisor tuple\"):\n        super().__init__(message)\n\ndef _validate_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Raises LengthMismatchException if tuple lengths differ.\"\"\"\n    if len(a) != len(b):\n        raise LengthMismatchException()\n\ndef _check_divisors(b: tuple) -> None:\n    \"\"\"Raises DivisionByZeroException if any element in b is zero.\"\"\"\n    for element in b:\n        if element == 0:\n            raise DivisionByZeroException()\n\ndef _compute(a: tuple, b: tuple) -> tuple:\n    \"\"\"Performs element-wise division, converting exact results to int.\"\"\"\n    results = []\n    for i in range(len(a)):\n        raw_result = a[i] / b[i]\n        if raw_result.is_integer():\n            results.append(int(raw_result))\n        else:\n            results.append(raw_result)\n    return tuple(results)\n\ndef division_elements(first_tuple: tuple, second_tuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division on two tuples with validation.\n    Returns a tuple of results, with exact integers typed as int.\n    \"\"\"\n    _validate_lengths(first_tuple, second_tuple)\n    _check_divisors(second_tuple)\n    return _compute(first_tuple, second_tuple)"}
{"task_id": "Mbpp/260", "solution": "```python\n# src/newman_prime.py\nimport math\n\nclass InputParameter:\n    \"\"\"Wraps an integer n and provides validation for positive 1-based index.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if n is an integer and positive.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\nclass OutputValue:\n    \"\"\"Data wrapper for a prime integer result.\"\"\"\n    def __init__(self, prime: int):\n        self._prime = prime\n\n    @property\n    def prime(self) -> int:\n        \"\"\"Returns the stored prime number.\"\"\"\n        return self._prime\n\nclass NewmanPrimeFunction:\n    \"\"\"Computes Newman\u2013Shanks\u2013Williams (NSW) numbers and tests for primality.\"\"\"\n    _nsw_cache = {0: 1, 1: 1} # Stores computed NSW numbers S_k\n    _prime_cache = {} # Stores primality test results for performance\n\n    def _compute_nsw_number(self, k: int) -> int:\n        \"\"\"Computes the k-th Newman\u2013Shanks\u2013Williams number using recursion.\"\"\"\n        if k in self._nsw_cache:\n            return self._nsw_cache[k]\n        \n        # S_k = 2 * S_{k-1} + S_{k-2} for k > 1\n        val = 2 * self._compute_nsw_number(k - 1) + self._compute_nsw_number(k - 2)\n        self._nsw_cache[k] = val\n        return val\n\n    def _is_prime(self, x: int) -> bool:\n        \"\"\"Checks if a given number x is prime using optimized trial division.\"\"\"\n        if x in self._prime_cache:\n            return self._prime_cache[x]\n\n        if x < 2:\n            self._prime_cache[x] = False\n            return False\n        if x == 2:\n            self._prime_cache[x] = True\n            return True\n        if x % 2 == 0:\n            self._prime_cache[x] = False\n            return False\n        \n        # Check odd divisors up to sqrt(x)\n        limit = int(math.isqrt(x)) + 1\n        for i in range(3, limit, 2):\n            if x % i == 0:\n                self._prime_cache[x] = False\n                return False\n        \n        self._prime_cache[x] = True\n        return True\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"\n        Calculates the (n-1)-th Newman\u2013Shanks\u2013Williams number S_k and checks its primality.\n        Returns S_k if prime, otherwise raises ValueError as specified by design.\n        \"\"\"\n        # Interpretation: n (input) maps to k=n-1 for S_k, and S_k must be prime.\n        k = n - 1 \n        if k < 0:\n             raise ValueError(f\"Input n={n} maps to an index k={k} less than 0. Must be >=1.\")\n\n        nsw_num = self._compute_nsw_number(k)\n        if self._is_prime(nsw_num):\n            return nsw_num\n        else:\n            raise ValueError(f\"S_{k} (which is {nsw_num}) is not a prime number. Cannot return the {n}th NSW prime with this mapping.\")\n\n\nclass TestCase:\n    \"\"\"Encapsulates a test case for the newman_prime function.\"\"\"\n    def __init__(self, description: str, n_input: int, expectedValue: int):\n        self.description = description\n        self.n_input = n_input\n        self.expectedValue = expectedValue\n\n    def run(self) -> bool:\n        \"\"\"Executes the test using the public newman_prime API and compares result.\"\"\"\n        from src.newman_prime import newman_prime # Imported here to avoid circular dependencies\n        try:\n            result = newman_prime(self.n_input)\n            return result == self.expectedValue\n        except ValueError:\n            return False # An error means the test failed to produce the expected value\n\n\n_nsw_prime_instance = NewmanPrimeFunction() # Singleton instance for delegation\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Public API to find the nth Newman\u2013Shanks\u2013Williams prime number.\n    Validates input and delegates computation to NewmanPrimeFunction.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.is_positive():\n        raise ValueError(\"Input 'n' must be a positive 1-based integer index.\")\n    \n    # Delegate computation\n    prime_result = _nsw_prime_instance.newman_prime(n)\n    \n    # Wrap result in OutputValue and return its value\n    output_value = OutputValue(prime_result)\n    return output_value.prime\n\n```\n```python\n# src/main.py\nfrom src.newman_prime import newman_prime\n\ndef main():\n    \"\"\"Demonstrates usage of the newman_prime function with example calls.\"\"\"\n    try:\n        # As per SRS: newman_prime(3) == 7\n        result = newman_prime(3)\n        print(f\"The 3rd Newman\u2013Shanks\u2013Williams prime number is: {result}\")\n\n        # Example of a valid input (S_3 = 41)\n        result_4 = newman_prime(4)\n        print(f\"The 4th Newman\u2013Shanks\u2013Williams prime number is: {result_4}\")\n\n        # Example of n where S_{n-1} is not prime\n        print(\"\\nAttempting newman_prime(1) (S_0=1, not prime):\")\n        newman_prime(1)\n    except ValueError as e:\n        print(f\"Caught expected error for invalid n: {e}\")\n\n    try:\n        # Example of an invalid input (non-integer)\n        print(\"\\nAttempting newman_prime('a'):\")\n        newman_prime('a')\n    except ValueError as e:\n        print(f\"Caught expected error for invalid n: {e}\")\n\nif __name__ == \"__main__\":\n    main()\n\n```\n```python\n# tests/test_newman_prime.py\nimport pytest\nfrom src.newman_prime import newman_prime, TestCase\n\ndef test_newman_prime_third():\n    \"\"\"Verifies that the 3rd NSW prime, as per the SRS, is 7.\"\"\"\n    assert newman_prime(3) == 7\n\ndef test_newman_prime_invalid_inputs():\n    \"\"\"Verifies that invalid general inputs to newman_prime raise ValueError.\"\"\"\n    with pytest.raises(ValueError):\n        newman_prime(0) # Not a positive 1-based index\n    with pytest.raises(ValueError):\n        newman_prime(-1) # Not a positive 1-based index\n    with pytest.raises(ValueError):\n        newman_prime(\"a\") # Not an integer\n    with pytest.raises(ValueError):\n        newman_prime(1.5) # Not an integer\n\ndef test_newman_prime_non_prime_n_values():\n    \"\"\"\n    Verifies that n values corresponding to non-prime S_{n-1} values raise ValueError.\n    This follows the interpretation where newman_prime(n) returns S_{n-1} if prime.\n    \"\"\"\n    # S_0 = 1 (not prime)\n    with pytest.raises(ValueError):\n        newman_prime(1)\n    \n    # S_1 = 1 (not prime)\n    with pytest.raises(ValueError):\n        newman_prime(2)\n    \n    # S_5 = 1393 (not prime)\n    with pytest.raises(ValueError):\n        newman_prime(6)\n\n    # S_6 = 8119 (not prime)\n    with pytest.raises(ValueError):\n        newman_prime(7)\n\ndef test_newman_prime_other_valid_primes():\n    \"\"\"Verifies other known NSW primes based on the n -> S_{n-1} mapping.\"\"\"\n    assert newman_prime(4) == 41 # S_3 = 41\n    assert newman_prime(5) == 239 # S_4 = 239\n    assert newman_prime(8) == 47321 # S_7 = 47321\n\ndef test_test_case_run_pass():\n    \"\"\"Tests the TestCase class with a passing scenario.\"\"\"\n    test_case = TestCase(\"Acceptance test for n=3\", 3, 7)\n    assert test_case.run() == True\n\ndef test_test_case_run_fail_value():\n    \"\"\"Tests the TestCase class with a failing scenario due to incorrect expected value.\"\"\"\n    test_case = TestCase(\"Incorrect value test for n=3\", 3, 10) # Expected 7, provided 10\n    assert test_case.run() == False\n\ndef test_test_case_run_fail_invalid_input():\n    \"\"\"Tests the TestCase class with an invalid input scenario for newman_prime.\"\"\"\n    test_case = TestCase(\"Invalid input test for n=0\", 0, 0) # n=0 should raise ValueError\n    assert test_case.run() == False\n\n```"}
