{"task_id": "Mbpp/279", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"\n    Exception raised for invalid input to the decagonal number calculator.\n    This includes non-integer inputs or integers less than 1.\n    \"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"\n    Validates input 'n' to ensure it's an integer and non-negative.\n    Raises InvalidInputError for invalid inputs.\n    \"\"\"\n    def validate(self, n: object) -> bool:\n        \"\"\"\n        Checks if n is an integer and n >= 1.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(\"Input must be an integer greater than or equal to 1.\")\n        return True\n\nclass DecagonalNumber:\n    \"\"\"\n    Represents 'n' and its computed decagonal value.\n    Encapsulates the computation logic for D(n).\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value: int = 0\n\n    def computeValue(self) -> int:\n        \"\"\"\n        Computes the decagonal number D(n) = n * (4 * n - 3).\n        Stores the result and returns it.\n        \"\"\"\n        self.value = self.n * (4 * self.n - 3)\n        return self.value\n\nclass DecagonalCalculator:\n    \"\"\"\n    Orchestrates the creation and computation of a DecagonalNumber.\n    It expects 'n' to be an already validated integer.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Calculates the decagonal number for a given integer n.\n        Assumes n is already validated to be >= 1.\n        \"\"\"\n        dec_num = DecagonalNumber(n)\n        return dec_num.computeValue()\n\ndef is_num_decagonal(n: object) -> int:\n    \"\"\"\n    Calculates the nth decagonal number D(n) = n * (4 * n - 3).\n    Validates input 'n' to be an integer >= 1, raising InvalidInputError if invalid.\n    \"\"\"\n    validator = InputValidator()\n    # The validate method raises InvalidInputError if 'n' is not valid.\n    # If it returns, 'n' is guaranteed to be a valid integer.\n    validator.validate(n) \n\n    calculator = DecagonalCalculator()\n    return calculator.compute(int(n))\n```"}
{"task_id": "Mbpp/278", "solution": "```python\n# src/domain.py\nfrom dataclasses import dataclass\nfrom typing import Any, Tuple\n\n@dataclass\nclass InputTuple:\n    elements: Tuple[Any, ...]\n\n@dataclass\nclass Element:\n    index: int\n    type_name: str\n    value: Any\n\n@dataclass\nclass TupleElement(Element):\n    # As per design, TupleElement has an 'elements' field.\n    # It inherits index, type_name, and value from Element.\n    elements: Tuple[Any, ...]\n\n@dataclass\nclass CountResult:\n    count: int\n\n```\n```python\n# src/count_first_elements.py\nfrom typing import Any, Tuple\n\n# Domain dataclasses are defined for conceptual modeling per design.\n# They are not directly used in this function's runtime logic due to\n# constraints from \"CRITICAL REQUIREMENTS\" (e.g., forbidding explicit validation).\n# from src.domain import InputTuple, Element, TupleElement, CountResult\n\ndef count_first_elements(input_tuple: tuple) -> int:\n    \"\"\"\n    Counts elements before the first nested tuple in the input_tuple.\n    This function trusts the caller's input and assumes a tuple element will always be found.\n    \"\"\"\n    for index, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return index\n    # Per \"CRITICAL REQUIREMENTS\", no exceptions are raised for edge cases.\n    # This implies the input is guaranteed to contain at least one tuple element,\n    # so the loop is expected to always find a tuple and return.\n\n```"}
{"task_id": "Mbpp/279", "solution": "```python\n# src/input_validator.py\n\ndef isPositiveInteger(n):\n    \"\"\"\n    Validates if the input 'n' is a positive integer (n >= 1).\n    Returns True if valid, False otherwise.\n    \"\"\"\n    return isinstance(n, int) and n >= 1\n```\n```python\n# src/decagonal_calculator.py\n\nclass DecagonalNumberCalculator:\n    \"\"\"\n    Calculates decagonal numbers using the specified formula.\n    Encapsulates the computation logic.\n    \"\"\"\n    def formula(self, n: int) -> int:\n        \"\"\"\n        Implements the decagonal number formula: 4*n^2 - 3*n.\n        This is the core calculation.\n        \"\"\"\n        return 4 * n * n - 3 * n\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth decagonal number.\n        Delegates to the formula method for calculation.\n        \"\"\"\n        return self.formula(n)\n```\n```python\n# src/api.py\n\nfrom src.input_validator import isPositiveInteger\nfrom src.decagonal_calculator import DecagonalNumberCalculator\n\ndef is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth decagonal number after validating the input.\n    Raises ValueError for invalid input.\n    \"\"\"\n    if not isPositiveInteger(n):\n        raise ValueError(\"Input 'n' must be an integer and n >= 1.\")\n\n    calculator = DecagonalNumberCalculator()\n    return calculator.compute(n)\n```\n```python\n# src/test_suite.py\n\nfrom src.api import is_num_decagonal\n\nclass TestSuite:\n    \"\"\"\n    A simple test suite to verify the is_num_decagonal API.\n    Executes a predefined unit test and reports the result.\n    \"\"\"\n    def run(self) -> dict:\n        \"\"\"\n        Executes the unit test for is_num_decagonal(3).\n        Returns a dictionary with test results.\n        \"\"\"\n        test_name = \"test_is_num_decagonal_3\"\n        expected_value = 27\n        actual_value = None\n        passed = False\n        error = None\n\n        try:\n            actual_value = is_num_decagonal(3)\n            passed = (actual_value == expected_value)\n        except Exception as e:\n            error = str(e)\n            passed = False\n\n        return {\n            \"test_name\": test_name,\n            \"expected_value\": expected_value,\n            \"actual_value\": actual_value,\n            \"passed\": passed,\n            \"error\": error\n        }\n```\n```python\n# tests/test_decagonal.py\n\nimport sys\nimport os\n\n# Add src to PYTHONPATH to allow imports from src/\ncurrent_dir = os.path.dirname(__file__)\nsrc_path = os.path.abspath(os.path.join(current_dir, '..', 'src'))\nif src_path not in sys.path:\n    sys.path.insert(0, src_path)\n\nfrom api import is_num_decagonal\n\ndef test_is_num_decagonal_3():\n    \"\"\"\n    Unit test to verify the decagonal number for n=3.\n    Asserts that is_num_decagonal(3) correctly returns 27.\n    \"\"\"\n    expected = 27\n    actual = is_num_decagonal(3)\n    assert actual == expected, f\"For n=3, expected {expected} but got {actual}\"\n    print(f\"Test passed: is_num_decagonal(3) == {actual}\")\n\nif __name__ == \"__main__\":\n    test_is_num_decagonal_3()\n```"}
