{"task_id": "Mbpp/100", "solution": "```python\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the smallest integer palindrome strictly greater than n.\n    Operates on base-10 digit representation, handling carry-overs to\n    find the next palindrome even if it requires an increased digit length.\n    \"\"\"\n\n    def _isPalindrome(num_str: str) -> bool:\n        \"\"\"Checks if a string represents a palindrome.\"\"\"\n        return num_str == num_str[::-1]\n\n    def _mirrorLeftToRight(num_str: str) -> str:\n        \"\"\"Mirrors the left half of a number string to form a palindrome.\"\"\"\n        L = len(num_str)\n        half_len = L // 2\n        left_half = num_str[0:half_len]\n        if L % 2 == 1:\n            middle = num_str[half_len]\n            return left_half + middle + left_half[::-1]\n        else:\n            return left_half + left_half[::-1]\n\n    def _incrementMiddleAndMirror(num_str: str) -> str:\n        \"\"\"Increments the 'middle part' of a number string and mirrors it to create the next palindrome.\"\"\"\n        L = len(num_str)\n        half_len = L // 2\n\n        if L % 2 == 1:  # Odd length\n            prefix_to_inc = num_str[0:half_len + 1]\n            incremented_prefix_val = int(prefix_to_inc) + 1\n            incremented_prefix_str = str(incremented_prefix_val)\n\n            if len(incremented_prefix_str) > len(prefix_to_inc):\n                # Handles cases like 9 -> 10 (prefix) resulting in 11 (palindrome), or 999 -> 1000 (prefix) resulting in 1001.\n                return '1' + '0' * (L - 1) + '1'\n            else:\n                new_left_half = incremented_prefix_str[0:half_len]\n                new_middle = incremented_prefix_str[half_len]\n                return new_left_half + new_middle + new_left_half[::-1]\n        else:  # Even length\n            prefix_to_inc = num_str[0:half_len]\n            incremented_prefix_val = int(prefix_to_inc) + 1\n            incremented_prefix_str = str(incremented_prefix_val)\n\n            if len(incremented_prefix_str) > len(prefix_to_inc):\n                # Handles cases like 99 -> 100 (prefix) resulting in 101.\n                return '1' + '0' * (L - 1) + '1'\n            else:\n                return incremented_prefix_str + incremented_prefix_str[::-1]\n\n    n_str = str(n)\n    \n    # First, try to form a palindrome by mirroring the left half of n.\n    # This usually generates the smallest palindrome of the same length or an adjacent length.\n    candidate_str = _mirrorLeftToRight(n_str)\n    candidate_val = int(candidate_str)\n    \n    # If this candidate is strictly greater than n, it's the answer.\n    # This also covers cases where n is not a palindrome and mirroring works.\n    if candidate_val > n:\n        return candidate_val\n    \n    # If the mirrored candidate is not strictly greater (i.e., <= n),\n    # we need to increment the middle part and then re-mirror to get the next one.\n    # This handles inputs like n=9, n=99, n=121 (already palindrome), or when mirroring makes it smaller.\n    next_candidate_str = _incrementMiddleAndMirror(n_str)\n    return int(next_candidate_str)\n\n```"}
{"task_id": "Mbpp/100", "solution": "```python\nclass IntegerInput:\n    \"\"\"Value object for integer input.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass PalindromeResult:\n    \"\"\"Value object for palindrome integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass PalindromeService:\n    \"\"\"Stateless domain service for palindrome calculations.\"\"\"\n\n    def _is_palindrome(self, s: str) -> bool:\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return s == s[::-1]\n\n    def _increment_left_block(self, left_block: str) -> str:\n        \"\"\"Increments a numerical string block.\"\"\"\n        return str(int(left_block) + 1)\n\n    def _mirror_left_to_right(self, left_block_for_mirror: str, is_final_odd_length: bool) -> str:\n        \"\"\"Mirrors a left block to form a palindrome of specified final parity.\"\"\"\n        if is_final_odd_length:\n            # The last digit of left_block_for_mirror is the middle digit.\n            mirror_part = left_block_for_mirror[:-1]\n        else:\n            # left_block_for_mirror is exactly the left half.\n            mirror_part = left_block_for_mirror\n        \n        return left_block_for_mirror + mirror_part[::-1]\n\n    def next_smallest_palindrome(self, value: int) -> int:\n        \"\"\"Computes the smallest integer palindrome strictly greater than value.\"\"\"\n        s = str(value)\n        n = len(s)\n\n        # Initial left block (including middle digit for odd length numbers).\n        left_block_original = s[:(n + 1) // 2]\n        \n        # Determine if the initial candidate palindrome should be odd-length.\n        is_original_len_odd = (n % 2 != 0)\n        \n        # 1. Form a candidate by mirroring the original left block.\n        candidate_str = self._mirror_left_to_right(left_block_original, is_original_len_odd)\n        candidate_int = int(candidate_str)\n        \n        # 2. If this candidate is strictly greater than the input, it's the answer.\n        if candidate_int > value:\n            return candidate_int\n        \n        # 3. Otherwise, increment the left block and re-mirror.\n        incremented_left_block = self._increment_left_block(left_block_original)\n        \n        # Determine the final palindrome's parity (odd/even length).\n        len_lbo = len(left_block_original)\n        len_ilb = len(incremented_left_block)\n        \n        if len_ilb > len_lbo:\n            # Carry propagated and left block length increased (e.g., '9'->'10', '99'->'100').\n            # This results in an odd-length palindrome (e.g., 9->101, 99->101, 999->10001).\n            is_final_odd_length = True\n        else:\n            # No length increase in the left block, so the total palindrome length remains `n`.\n            # Its parity is the same as the original number's length.\n            is_final_odd_length = is_original_len_odd\n            \n        final_palindrome_str = self._mirror_left_to_right(incremented_left_block, is_final_odd_length)\n        return int(final_palindrome_str)\n\n\n# Public API function, delegates to PalindromeService as per design.\n_palindrome_service_instance = PalindromeService()\n\ndef next_smallest_palindrome(value: int) -> int:\n    \"\"\"Finds the next smallest integer palindrome strictly greater than the input.\"\"\"\n    return _palindrome_service_instance.next_smallest_palindrome(value)\n```"}
{"task_id": "Mbpp/102", "solution": "```python\n# src/snake_to_camel.py\n\"\"\"This module provides a function to convert snake_case strings to CamelCase,\nusing minimal domain classes and a stateless converter.\"\"\"\n\nfrom typing import List\n\nclass SnakeString:\n    \"\"\"Holds a single input string value representing the snake_case input.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass CamelString:\n    \"\"\"Holds a single output string value representing the CamelCase result.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass SnakeToCamelConverter:\n    \"\"\"Encapsulates the conversion algorithm that removes underscores and capitalizes\n    each segment's first letter.\"\"\"\n    def snake_to_camel(self, input: str) -> str:\n        # Split input on '_', capitalize first character of each segment, then join.\n        segments: List[str] = input.split('_')\n        camel_segments: List[str] = [segment.capitalize() for segment in segments]\n        return \"\".join(camel_segments)\n\ndef snake_to_camel(input: str) -> str:\n    \"\"\"Converts an input snake_case string into CamelCase.\n    This public API delegates the conversion to a SnakeToCamelConverter instance.\"\"\"\n    converter = SnakeToCamelConverter()\n    return converter.snake_to_camel(input)\n\n```\n```python\n# tests/test_snake_to_camel.py\n\"\"\"Unit test for the snake_to_camel conversion function.\"\"\"\n\nfrom src.snake_to_camel import snake_to_camel\n\ndef test_example_assertion():\n    \"\"\"Verifies the example assertion for snake_to_camel conversion.\"\"\"\n    assert snake_to_camel('python_program') == 'PythonProgram'\n\n```"}
