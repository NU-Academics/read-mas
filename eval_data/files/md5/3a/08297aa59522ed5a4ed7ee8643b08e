\nfrom typing import Optional\n\n# Import gcd from the sibling module as per design.\n# This assumes src/gcd.py is available in the Python path.\nfrom gcd import gcd\n\ndef _egcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Computes (x0, y0, g) such that a*x0 + b*y0 == g == gcd(a, b).\n    This iterative Extended Euclidean Algorithm ensures g is non-negative.\"\"\"\n    x_prev, y_prev = 1, 0\n    x_curr, y_curr = 0, 1\n    a_val, b_val = a, b\n\n    while b_val != 0:\n        quotient = a_val // b_val\n        a_val, b_val = b_val, a_val % b_val\n        x_prev, x_curr = x_curr, x_prev - quotient * x_curr\n        y_prev, y_curr = y_curr, y_prev - quotient * y_curr\n\n    # Adjust coefficients if the computed gcd (a_val) is negative.\n    # The gcd function should always return a non-negative value.\n    if a_val < 0:\n        return -x_prev, -y_prev, -a_val\n    return x_prev, y_prev, a_val\n\ndef find_solution(a: int, b: int, n: int) -> Optional[tuple[int, int]]:\n    \"\"\"Returns a tuple (x, y) satisfying a*x + b*y == n, or None if no integer solution exists.\n    The solution is normalized to match the example for consistency.\"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    g = gcd(a, b)\n\n    if n % g != 0:\n        return None\n\n    # Compute a particular solution (x0, y0) for a*x0 + b*y0 = g\n    x0, y0, _ = _egcd(a, b)\n\n    # Scale to get a solution (x_p, y_p) for a*x_p + b*y_p = n\n    factor = n // g\n    x_p = x0 * factor\n    y_p = y0 * factor\n\n    # Normalize the solution (x, y) to match the example, e.g., smallest non-negative x\n    # This adjustment is applied only when both a and b are non-zero.\n    if a != 0 and b != 0:\n        # Calculate the modulus for x adjustment, ensuring it's positive.\n        m_abs = abs(b // g)\n        x_final = (x_p % m_abs + m_abs) % m_abs\n        y_final = (n - a * x_final) // b\n        return x_final, y_final\n    else:\n        # If a or b is zero (but not both), (x_p, y_p) is already in a canonical form.\n        return x_p, y_p\n\n```\n```python\n# tests/test_find_solution.py\nimport sys\nimport os\n\n# Add src directory to the Python path for imports, relative to this test file.\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'src')))\n\nfrom find_solution import find_solution\n\nclass ValidationTest:\n    \"\"\"A simple test class to validate the find_solution function.\n    It implements the required example test case.\"\"\"\n\n    def test_example(self):\n        \"\"\"Verifies the specific example from the problem statement: find_solution(2, 3, 7) == (2, 1).\"\"\"\n        expected_result = (2, 1)\n        actual_result = find_solution(2, 3, 7)\n        assert actual_result == expected_result, f\"Test failed for (2, 3, 7): Expected {expected_result}, got {actual_result}\"\n\n    def run(self):\n        \"\"\"Executes all validation tests within this class.\"\"\"\n        print(\"Running ValidationTest...\")\n        self.test_example()\n        print(\"ValidationTest passed.\")\n\n# This allows for running the tests directly or via a test runner.\n# For example, to run directly:\n# if __name__ == \"__main__\":\n#    ValidationTest().run()\n\n```"}
{"task_id": "Mbpp/160", "solution": "def _gcd(a, b):\n    \"\"\"Computes the greatest common divisor of two integers.\"\"\"\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef _extended_gcd(a, b):\n    \"\"\"\n    Computes (s, t, d) such that a*s + b*t = d, where d is gcd(a, b).\n    d is always non-negative.\n    \"\"\"\n    if a == 0 and b == 0:\n        return 0, 0, 0 # gcd(0,0)=0, and 0*0 + 0*0 = 0\n    \n    s_curr, t_curr = 1, 0\n    s_prev, t_prev = 0, 1\n    \n    orig_a, orig_b = a, b # Store original values for sign adjustment\n    a, b = abs(a), abs(b) # Work with absolute values to get positive gcd\n    \n    while b != 0:\n        q = a // b\n        a, b = b, a % b\n        s_curr, s_prev = s_prev, s_curr - q * s_prev\n        t_curr, t_prev = t_prev, t_curr - q * t_prev\n            \n    d = a # d is the GCD, which is always positive\n    \n    # Adjust s_curr, t_curr for the original signs of a and b\n    # We have abs(orig_a)*s + abs(orig_b)*t = d.\n    # To get orig_a*S + orig_b*T = d, S = s*sign(orig_a), T = t*sign(orig_b).\n    s_final = s_curr\n    t_final = t_curr\n    if orig_a < 0:\n        s_final = -s_final\n    if orig_b < 0:\n        t_final = -t_final\n            \n    return s_final, t_final, d\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation a*x + b*y = n.\n    Returns (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n    # Handle the special case where both a and b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    s, t, d = _extended_gcd(a, b)\n\n    # Check if a solution exists (n must be divisible by d)\n    if n % d != 0:\n        return None\n\n    # Scale Bezout coefficients to find a particular solution (x0, y0)\n    k_factor = n // d\n    x_particular = s * k_factor\n    y_particular = t * k_factor\n\n    # Adjust the particular solution to a canonical form, typically where x is in [0, abs(b/d)-1).\n    # This helps in providing a consistent output for multiple solutions, matching specific test cases.\n    if b == 0:\n        # If b is 0, then a*x = n. x = n/a, y can be anything.\n        # Our extended_gcd already gives a specific x, and y_particular=0.\n        # No further adjustment needed, x_particular is (n // a) and y_particular is 0.\n        pass\n    else:\n        # x_step represents abs(b/d), which is the period of x values in general solution\n        x_step_size = b // d\n        \n        # Calculate a new x (x_shifted) that is congruent to x_particular modulo x_step_size.\n        # Python's % handles negative numbers such that result has same sign as divisor.\n        # We want smallest non-negative x if x_step_size > 0, or largest x in negative range if x_step_size < 0.\n        x_shifted = x_particular % x_step_size\n\n        # Determine the 'k' that transformed x_particular to x_shifted\n        k_transform = (x_shifted - x_particular) // x_step_size\n\n        # Apply the same 'k' to y_particular to get y_shifted\n        y_step_size = a // d\n        y_shifted = y_particular - k_transform * y_step_size\n        \n        x_particular, y_particular = x_shifted, y_shifted\n\n    # Verify the solution before returning (as per design)\n    if a * x_particular + b * y_particular == n:\n        return (x_particular, y_particular)\n    else:\n        # This case should ideally not be reached with correct arithmetic\n        return None"}
