{"task_id": "Mbpp/618", "solution": "```python\n# src/__init__.py\n# This file is intentionally left empty to mark the directory as a Python package.\n\n```\n```python\n# src/div_list.py\nfrom typing import Sequence, Union, List, Any\n\nclass InvalidInput(Exception):\n    \"\"\"Exception for invalid input types or non-numeric elements.\n    Indicates violations of BR1 or BR2.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass MismatchedLength(Exception):\n    \"\"\"Exception for input lists with different lengths.\n    Indicates a violation of BR5.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass DivisionByZero(Exception):\n    \"\"\"Exception for attempts to divide by zero.\n    Indicates a violation of BR6.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_inputs(listA: Sequence[Any], listB: Sequence[Any]) -> None:\n    \"\"\"Raise InvalidInput or MismatchedLength if rules BR1, BR2, BR5 are violated.\n    This helper enforces presence of two sequences, numeric elements, and equal lengths.\n    \"\"\"\n    if not isinstance(listA, Sequence) or not isinstance(listB, Sequence) or isinstance(listA, str) or isinstance(listB, str):\n        raise InvalidInput(\"Inputs must be sequences (e.g., lists or tuples) and not strings.\")\n    \n    if len(listA) != len(listB):\n        raise MismatchedLength(f\"Input lists must have the same length, got {len(listA)} and {len(listB)}.\")\n    \n    for i in range(len(listA)):\n        if not isinstance(listA[i], (int, float)):\n            raise InvalidInput(f\"Element at index {i} in listA is not a number: {listA[i]}.\")\n        if not isinstance(listB[i], (int, float)):\n            raise InvalidInput(f\"Element at index {i} in listB is not a number: {listB[i]}.\")\n\ndef compute_elementwise_division(listA: Sequence[Union[int, float]], listB: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"Perform per-index float division and raise DivisionByZero if any denominator is zero (BR3, BR4, BR6).\n    Returns a list of float results from the divisions.\n    \"\"\"\n    result: List[float] = []\n    for i in range(len(listA)):\n        denominator = float(listB[i])\n        if denominator == 0:\n            raise DivisionByZero(f\"Division by zero encountered at index {i}.\")\n        result.append(float(listA[i]) / denominator)\n    return result\n\ndef div_list(listA: Sequence[Union[int, float]], listB: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"\n    Validate inputs and return element-wise division results as floats.\n    Raises domain-specific exceptions for invalid inputs, mismatched lengths, or division by zero.\n    \"\"\"\n    validate_inputs(listA, listB)\n    return compute_elementwise_division(listA, listB)\n\n```\n```python\n# tests/test_div_list.py\nimport pytest\nfrom src.div_list import div_list, InvalidInput, MismatchedLength, DivisionByZero\n\ndef test_example_case():\n    \"\"\"Verify the example case specified in the SRS.\n    Checks for correct element-wise division and float conversion.\n    \"\"\"\n    assert div_list([4, 5, 6], [1, 2, 3]) == [4.0, 2.5, 2.0]\n\ndef test_zero_division_raises():\n    \"\"\"Verify DivisionByZero is raised when an element in listB is zero.\n    This test checks for adherence to BR6.\n    \"\"\"\n    with pytest.raises(DivisionByZero, match=\"Division by zero encountered at index 1\"):\n        div_list([10, 5, 2], [2, 0, 1])\n\ndef test_mismatched_length_raises():\n    \"\"\"Verify MismatchedLength is raised when input lists have different lengths.\n    This test checks for adherence to BR5.\n    \"\"\"\n    with pytest.raises(MismatchedLength, match=\"Input lists must have the same length, got 3 and 2\"):\n        div_list([1, 2, 3], [1, 2])\n\ndef test_non_numeric_raises():\n    \"\"\"Verify InvalidInput is raised when elements are non-numeric or inputs are not sequences.\n    This test checks for adherence to BR1 and BR2.\n    \"\"\"\n    with pytest.raises(InvalidInput, match=\"Element at index 0 in listA is not a number: 'a'\"):\n        div_list([\"a\", 2, 3], [1, 2, 3])\n    with pytest.raises(InvalidInput, match=\"Element at index 1 in listB is not a number: None\"):\n        div_list([1, 2, 3], [1, None, 3])\n    with pytest.raises(InvalidInput, match=\"Inputs must be sequences\"):\n        div_list(123, [1, 2, 3])\n    with pytest.raises(InvalidInput, match=\"Inputs must be sequences\"):\n        div_list([1, 2, 3], \"abc\")\n\ndef test_empty_lists():\n    \"\"\"Verify div_list handles empty lists correctly.\n    Expects an empty list as a valid result.\n    \"\"\"\n    assert div_list([], []) == []\n\ndef test_single_element_lists():\n    \"\"\"Verify div_list works with single-element lists.\"\"\"\n    assert div_list([10], [2]) == [5.0]\n\ndef test_float_inputs():\n    \"\"\"Verify div_list handles float inputs correctly.\"\"\"\n    assert div_list([4.0, 5.0, 6.0], [1.0, 2.0, 3.0]) == [4.0, 2.5, 2.0]\n\ndef test_mixed_int_float_inputs():\n    \"\"\"Verify div_list handles mixed integer and float inputs.\"\"\"\n    assert div_list([5, 10.0], [2.0, 5]) == [2.5, 2.0]\n\n```"}
