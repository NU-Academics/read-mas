{"task_id": "Mbpp/172", "solution": "```python\n# src/models.py\nclass InputString:\n    \"\"\"Value object holding the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass CountResult:\n    \"\"\"Value object holding the integer count result.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\n# src/count_occurance.py\nfrom src.models import InputString, CountResult\n\nclass CountOccuranceService:\n    \"\"\"Encapsulates the counting algorithm for 'std' occurrences.\"\"\"\n    def __init__(self, pattern: str = \"std\") -> None:\n        self._pattern = pattern\n\n    def count_occurance(self, input: str) -> int:\n        \"\"\"Counts non-overlapping, case-sensitive occurrences of the pattern.\"\"\"\n        pattern_len = len(self._pattern)\n        i = 0\n        count = 0\n        \n        # Use InputString domain model as specified by design.\n        input_string_obj = InputString(input) \n        \n        # Algorithm as specified: non-overlapping, case-sensitive.\n        current_input_value = input_string_obj.value \n        while i <= len(current_input_value) - pattern_len:\n            if current_input_value[i:i+pattern_len] == self._pattern:\n                count += 1\n                i += pattern_len\n            else:\n                i += 1\n\n        # Use CountResult domain model as specified by design.\n        count_result_obj = CountResult(count) \n        return count_result_obj.count\n\n\ndef count_occurance(input: str) -> int:\n    \"\"\"Public API to count non-overlapping, case-sensitive 'std' occurrences.\"\"\"\n    service = CountOccuranceService()\n    return service.count_occurance(input)\n```"}
