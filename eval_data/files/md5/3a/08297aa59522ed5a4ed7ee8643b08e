{"task_id": "Mbpp/468", "solution": "```python\n#### src/increasing_subsequence.py\nfrom typing import List\n\nclass IncreasingSubsequence:\n    \"\"\"Encapsulates an increasing subsequence with validation and product computation.\"\"\"\n    def __init__(self, elements: List[float]):\n        self.elements = elements\n\n    def is_strictly_increasing(self) -> bool:\n        \"\"\"Checks if the elements in the subsequence are strictly increasing.\"\"\"\n        for i in range(1, len(self.elements)):\n            if self.elements[i] <= self.elements[i-1]:\n                return False\n        return True\n\n    def product(self) -> float:\n        \"\"\"Computes the multiplicative product of the subsequence elements.\"\"\"\n        res = 1.0\n        for x in self.elements:\n            res *= x\n        return res\n\n#### src/result.py\nclass Result:\n    \"\"\"A simple result holder representing a numeric outcome.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n#### src/product_calculator.py\nfrom typing import List, Optional\nfrom src.increasing_subsequence import IncreasingSubsequence\nfrom src.result import Result\n\nclass ProductCalculator:\n    \"\"\"Implements enumeration and selection algorithms for increasing subsequences.\"\"\"\n\n    def enumerate_subsequences(self, arr: List[float]) -> List[IncreasingSubsequence]:\n        \"\"\"Generates all non-empty subsequences preserving original order.\"\"\"\n        subsequences: List[IncreasingSubsequence] = []\n        n = len(arr)\n\n        # Iterate through all possible bitmasks from 1 to 2^n - 1 to represent non-empty subsequences.\n        for i in range(1, 1 << n):\n            current_sub = []\n            for j in range(n):\n                if (i >> j) & 1:  # If the j-th bit is set, include arr[j].\n                    current_sub.append(arr[j])\n            subsequences.append(IncreasingSubsequence(current_sub))\n        return subsequences\n\n    def max_product(self, arr: List[float]) -> float:\n        \"\"\"Calculates the maximum product from any strictly increasing subsequence.\"\"\"\n        if not arr:\n            return 0.0 # Returns 0.0 for an empty input array as no product can be formed.\n\n        # Handle single-element input as per the design's UC5.\n        if len(arr) == 1:\n            return float(arr[0])\n\n        all_subsequences = self.enumerate_subsequences(arr)\n        \n        max_prod_value: Optional[float] = None\n\n        for sub_obj in all_subsequences:\n            if sub_obj.is_strictly_increasing():\n                current_prod = sub_obj.product()\n                if max_prod_value is None or current_prod > max_prod_value:\n                    max_prod_value = current_prod\n        \n        # max_prod_value will always be set for non-empty `arr` because single-element subsequences are always increasing.\n        return Result(max_prod_value).value # Use Result class as an explicit output holder as per design.\n\n#### src/max_product.py\nfrom typing import List\nfrom src.product_calculator import ProductCalculator\n\ndef max_product(arr: List[float]) -> float:\n    \"\"\"Top-level API function to compute the maximum product of an increasing subsequence.\"\"\"\n    return ProductCalculator().max_product(arr)\n```"}
{"task_id": "Mbpp/470", "solution": "```python\n# src/__init__.py\n```\n\n```python\n# src/types.py\nfrom typing import List, Tuple\n\nclass TupleInput:\n    \"\"\"Container for input elements and length helper.\"\"\"\n    def __init__(self, elements: Tuple[int, ...]) -> None:\n        self.elements: List[int] = list(elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input.\"\"\"\n        return len(self.elements)\n\nclass ResultTuple:\n    \"\"\"Container for result elements and length helper; conversion to native tuple.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements: List[int] = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the result.\"\"\"\n        return len(self.elements)\n\n    def as_tuple(self) -> Tuple[int, ...] :\n        \"\"\"Converts the internal list of elements to a native tuple.\"\"\"\n        return tuple(self.elements)\n```\n\n```python\n# src/pairwise_adder.py\nfrom src.types import TupleInput, ResultTuple\nfrom typing import Tuple\n\nclass PairwiseAdder:\n    \"\"\"Stateless service to compute pairwise sums.\"\"\"\n    def add_pairwise(self, t: TupleInput) -> ResultTuple:\n        \"\"\"Computes the sum of adjacent elements from a TupleInput.\"\"\"\n        result_elements: List[int] = []\n        # Iterate up to the second-to-last element to form pairs.\n        for i in range(t.length() - 1):\n            result_elements.append(t.elements[i] + t.elements[i+1])\n        return ResultTuple(elements=result_elements)\n\ndef add_pairwise(input_tuple: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Public API to compute pairwise sums of neighboring elements in a tuple.\n    It converts native tuple to TupleInput, delegates to PairwiseAdder, and returns a native tuple.\n    \"\"\"\n    tuple_input = TupleInput(elements=input_tuple)\n    adder = PairwiseAdder()\n    result_tuple_obj = adder.add_pairwise(tuple_input)\n    return result_tuple_obj.as_tuple()\n```\n\n```python\n# tests/__init__.py\n```\n\n```python\n# tests/test_add_pairwise.py\nfrom src.pairwise_adder import add_pairwise\nfrom src.types import TupleInput, ResultTuple\nfrom typing import Tuple\n\nclass TestCase:\n    \"\"\"Represents and runs a single unit test case for add_pairwise.\"\"\"\n    def __init__(self, input_tuple: Tuple[int, ...], expected_tuple: Tuple[int, ...]) -> None:\n        self.input: TupleInput = TupleInput(input_tuple)\n        self.expected: ResultTuple = ResultTuple(list(expected_tuple))\n\n    def run(self) -> bool:\n        \"\"\"Calls add_pairwise on the input and compares the result to the expected tuple.\"\"\"\n        actual_result = add_pairwise(self.input.as_tuple())\n        expected_result = self.expected.as_tuple()\n        assert actual_result == expected_result, \\\n            f\"Test failed: input={self.input.as_tuple()}, expected={expected_result}, got={actual_result}\"\n        return True\n\n# Module-level execution of the explicit acceptance test.\nassert add_pairwise((1, 5, 7, 8, 10)) == (6, 12, 15, 18), \"Acceptance test failed.\"\n\n# Example of using the TestCase class (optional, but part of the design specification)\n# test_case = TestCase((1, 5, 7, 8, 10), (6, 12, 15, 18))\n# test_case.run()\n```"}
{"task_id": "Mbpp/468", "solution": "```python\nfrom typing import List, Union\n\nclass InputArray:\n    \"\"\"A lightweight wrapper for input normalization/validation.\n    It stores normalized numeric values as a list of floats.\n    \"\"\"\n    values: List[float]\n\n    def __init__(self, values: List[Union[int, float]]):\n        \"\"\"Initializes an InputArray with its values, normalizing them to floats.\"\"\"\n        self.values = [float(v) for v in values]\n\nclass Element:\n    \"\"\"Represents a single array element and its original index.\n    It stores the numeric value as a float and its integer index.\n    \"\"\"\n    value: float\n    index: int\n\n    def __init__(self, value: Union[int, float], index: int):\n        \"\"\"Initializes an Element with its numeric value and original index.\"\"\"\n        self.value = float(value)\n        self.index = index\n\nclass Subsequence:\n    \"\"\"Represents a contiguous subsequence of elements.\n    It can compute the product of its contained elements.\n    \"\"\"\n    startIndex: int\n    endIndex: int\n    elements: List[Element]\n\n    def __init__(self, startIndex: int, endIndex: int, elements: List[Element]):\n        \"\"\"Initializes a Subsequence with its start/end indices and list of Element objects.\"\"\"\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.elements = elements\n\n    def product(self) -> float:\n        \"\"\"Computes and returns the product of its elements' values.\"\"\"\n        current_product = 1.0\n        for element in self.elements:\n            current_product *= element.value\n        return current_product\n\nclass MaxProductCalculator:\n    \"\"\"Core algorithmic logic to find strictly increasing contiguous subsequences.\n    It computes their products and identifies the maximum product among them.\n    \"\"\"\n\n    def max_product(self, arr: List[Union[int, float]]) -> float:\n        \"\"\"\n        Finds the maximum product from strictly increasing contiguous subsequences in the input array.\n        It normalizes the input, identifies subsequences, and computes the maximum product.\n        \"\"\"\n        input_array = InputArray(arr)\n        normalized_values = input_array.values\n\n        subsequences = self.findIncreasingContiguousSubsequences(normalized_values)\n\n        if not subsequences:\n            # If no subsequences are found (e.g., empty input array), return 0.0.\n            return 0.0\n\n        max_prod = float('-inf')\n        for s in subsequences:\n            current_prod = self.computeProduct(s)\n            if current_prod > max_prod:\n                max_prod = current_prod\n        return max_prod\n\n    def findIncreasingContiguousSubsequences(self, values: List[float]) -> List[Subsequence]:\n        \"\"\"\n        Scans a list of normalized float values to identify all strictly increasing contiguous subsequences.\n        Single-element runs are included by default as valid subsequences.\n        \"\"\"\n        if not values:\n            return []\n\n        result_subsequences: List[Subsequence] = []\n        current_run_elements: List[Element] = []\n        current_run_start_index: int = 0\n\n        for i, value in enumerate(values):\n            if not current_run_elements:\n                # Initialize a new run if current_run_elements is empty.\n                current_run_start_index = i\n                current_run_elements.append(Element(value, i))\n            elif value > current_run_elements[-1].value:\n                # Continue the current strictly increasing run.\n                current_run_elements.append(Element(value, i))\n            else:\n                # The increasing run is broken, so save the completed subsequence.\n                result_subsequences.append(\n                    Subsequence(\n                        current_run_start_index,\n                        current_run_elements[-1].index,\n                        list(current_run_elements)\n                    )\n                )\n                # Start a new run with the current element.\n                current_run_start_index = i\n                current_run_elements = [Element(value, i)]\n        \n        # After the loop, add the last accumulated run as a subsequence.\n        if current_run_elements:\n            result_subsequences.append(\n                Subsequence(\n                    current_run_start_index,\n                    current_run_elements[-1].index,\n                    current_run_elements\n                )\n            )\n        \n        return result_subsequences\n\n    def computeProduct(self, s: Subsequence) -> float:\n        \"\"\"Multiplies the element values within a given Subsequence and returns the numeric product.\"\"\"\n        return s.product()\n\ndef max_product(arr: List[Union[int, float]]) -> float:\n    \"\"\"\n    Provides a public entry point to find the maximum product of a strictly increasing contiguous subsequence.\n    This function delegates the core logic to an instance of MaxProductCalculator.\n    \"\"\"\n    return MaxProductCalculator().max_product(arr)\n```"}
