{"task_id": "Mbpp/283", "solution": "```python\nfrom typing import Dict, Iterable, Tuple\nfrom collections import Counter\n\n# Module docstring as per specification, adjusted for critical constraints.\n\"\"\"Public API: validate(integer: int) -> bool. Negative integers' sign is ignored.\"\"\"\n\nclass IntegerInput:\n    \"\"\"Represents the input integer value as a domain object.\n    Its value is used to extract digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_abs_str(self) -> str:\n        \"\"\"Returns the decimal string of the absolute value of the integer.\"\"\"\n        return str(abs(self.value))\n\nclass Digit:\n    \"\"\"Represents a single decimal digit and its observed frequency.\n    This class models digit characteristics.\"\"\"\n    def __init__(self, value: int, frequency: int) -> None:\n        self.value = value\n        self.frequency = frequency\n\nclass DigitFrequency:\n    \"\"\"Holds a mapping from digit value to its frequency count.\n    Provides methods to access and iterate over these frequencies.\"\"\"\n    def __init__(self, frequencies: Dict[int, int]) -> None:\n        self.frequencies = frequencies\n\n    def get(self, digit: int) -> int:\n        \"\"\"Returns the frequency of a given digit, defaulting to 0 if not present.\"\"\"\n        return self.frequencies.get(digit, 0)\n\n    def items(self) -> Iterable[Tuple[int, int]]:\n        \"\"\"Returns an iterable of (digit, frequency) pairs for all counted digits.\"\"\"\n        return self.frequencies.items()\n\nclass ValidationResult:\n    \"\"\"Represents the boolean outcome of the validation process.\n    It indicates whether the input integer is valid according to the rule.\"\"\"\n    def __init__(self, is_valid: bool) -> None:\n        self.is_valid = is_valid\n\ndef compute_frequencies(integer: int) -> DigitFrequency:\n    \"\"\"Converts the integer to its absolute decimal digits and computes their frequencies.\n    It utilizes the IntegerInput class and collections.Counter for efficiency.\"\"\"\n    integer_input = IntegerInput(integer)\n    digits_str = integer_input.to_abs_str()\n    frequencies_map = Counter(int(d) for d in digits_str)\n    return DigitFrequency(dict(frequencies_map))\n\ndef validate(integer: int) -> bool:\n    \"\"\"Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    The validation ignores the sign of the input integer.\"\"\"\n    digit_frequencies = compute_frequencies(integer)\n    \n    for digit_value, frequency_count in digit_frequencies.items():\n        if frequency_count > digit_value:\n            return False\n            \n    return True\n```"}
{"task_id": "Mbpp/283", "solution": "```python\nfrom typing import List, Dict\n\ndef _extract_digits(n: int) -> List[int]:\n    \"\"\"Extracts decimal digits from the absolute value of n.\n    Handles single digit input including zero correctly.\n    \"\"\"\n    s_n = str(abs(n))\n    return [int(d) for d in s_n]\n\ndef _count_frequencies(digits: List[int]) -> Dict[int, int]:\n    \"\"\"Counts the frequency of each distinct digit in a list.\n    Returns a dictionary mapping each digit to its count.\n    \"\"\"\n    freqs = {}\n    for d in digits:\n        freqs[d] = freqs.get(d, 0) + 1\n    return freqs\n\ndef _compare_counts(freqs: Dict[int, int]) -> bool:\n    \"\"\"Compares digit frequencies against the digit value itself.\n    Returns True if count(d) <= d for all distinct digits d, otherwise False.\n    \"\"\"\n    for digit, count in freqs.items():\n        if not (count <= digit):\n            return False\n    return True\n\ndef validate(n: int) -> bool:\n    \"\"\"Checks if for every distinct decimal digit d present in the absolute-value\n    decimal representation of n, its frequency is less than or equal to d.\n    \"\"\"\n    digits = _extract_digits(n)\n    frequencies = _count_frequencies(digits)\n    return _compare_counts(frequencies)\n```"}
{"task_id": "Mbpp/282", "solution": "```python\n# src/sub_list.py\n\nfrom typing import List\n\ndef _validate_lengths(list_a: List, list_b: List) -> None:\n    \"\"\"Raise ValueError if lengths differ.\n    Ensures input lists have identical lengths for element-wise operation.\n    \"\"\"\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have the same length\")\n\ndef _validate_numeric_elements(list_a: List, list_b: List) -> None:\n    \"\"\"Raise TypeError if any element is not int or float.\n    Checks that all elements across both input lists are numeric types.\n    \"\"\"\n    for sublist in (list_a, list_b):\n        for element in sublist:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements must be int or float\")\n\ndef sub_list(list_a: List, list_b: List) -> List:\n    \"\"\"Compute element-wise subtraction result_list where result[i] = list_a[i] - list_b[i].\n\n    Raises:\n        ValueError: if the input lists differ in length.\n        TypeError: if any element in inputs is not int or float.\n    \"\"\"\n    _validate_lengths(list_a, list_b)\n    _validate_numeric_elements(list_a, list_b)\n\n    result_list = []\n    for i in range(len(list_a)):\n        result_list.append(list_a[i] - list_b[i])\n\n    return result_list\n\n```\n```python\n# tests/test_sub_list.py\n\nimport pytest\nfrom src.sub_list import sub_list\n\ndef test_sub_list_acceptance():\n    \"\"\"Verify the core subtraction functionality with the acceptance test case.\n    Asserts correct element-wise subtraction for given integer lists.\n    \"\"\"\n    assert sub_list([1, 2, 3], [4, 5, 6]) == [-3, -3, -3]\n\ndef test_sub_list_length_mismatch_raises():\n    \"\"\"Ensure ValueError is raised when input lists have different lengths.\n    Confirms validation for unequal input list sizes.\n    \"\"\"\n    with pytest.raises(ValueError, match=\"Input lists must have the same length\"):\n        sub_list([1, 2], [1])\n    with pytest.raises(ValueError, match=\"Input lists must have the same length\"):\n        sub_list([1], [1, 2])\n\ndef test_sub_list_non_numeric_raises():\n    \"\"\"Check TypeError is raised if any element is not int or float.\n    Validates input elements are strictly numeric (int or float).\n    \"\"\"\n    with pytest.raises(TypeError, match=\"All elements must be int or float\"):\n        sub_list([1, 'x'], [1, 2])\n    with pytest.raises(TypeError, match=\"All elements must be int or float\"):\n        sub_list([1, 2], [1, None])\n    with pytest.raises(TypeError, match=\"All elements must be int or float\"):\n        sub_list([1, []], [1, 2])\n\ndef test_sub_list_preserves_inputs():\n    \"\"\"Verify that the input lists are not modified by the function.\n    Checks for immutability of input arguments after function execution.\n    \"\"\"\n    list_a_original = [10, 20]\n    list_b_original = [3, 4]\n    \n    list_a_copy = list_a_original[:]\n    list_b_copy = list_b_original[:]\n\n    sub_list(list_a_original, list_b_original)\n\n    assert list_a_original == list_a_copy\n    assert list_b_original == list_b_copy\n\ndef test_sub_list_empty_and_mixed_numeric():\n    \"\"\"Test behavior with empty lists and lists containing mixed int/float types.\n    Confirms an empty list is returned for empty inputs and correct computation with mixed numeric types.\n    \"\"\"\n    assert sub_list([], []) == []\n    assert sub_list([1.0, 2, 3.5], [0.5, 1, 1.0]) == [0.5, 1.0, 2.5]\n    assert sub_list([5, 10.0], [2.0, 3]) == [3.0, 7.0]\n\n```"}
