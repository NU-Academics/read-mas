{"task_id": "Mbpp/462", "solution": "```python\n# src/combinations.py\n\nclass InputList:\n    \"\"\"A wrapper for the input list of elements.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = list(elements)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the wrapped list of elements.\"\"\"\n        return list(self._elements)\n\nclass Element:\n    \"\"\"A wrapper for an individual element value.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def get_value(self):\n        \"\"\"Returns the wrapped element's value.\"\"\"\n        return self._value\n\nclass Combination:\n    \"\"\"A wrapper for a single combination (subset) of elements.\"\"\"\n    def __init__(self, elements: list):\n        # Stores raw element values, consistent with algorithm's direct list manipulation.\n        self._elements = list(elements)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the combination as a list of its raw elements.\"\"\"\n        return list(self._elements)\n\nclass CombinationList:\n    \"\"\"A wrapper for a list of Combination objects.\"\"\"\n    def __init__(self):\n        self._combinations: list[Combination] = []\n\n    def append_combination(self, combination: Combination):\n        \"\"\"Appends a single Combination object to the list.\"\"\"\n        self._combinations.append(combination)\n\n    def extend_combinations(self, combinations: list[Combination]):\n        \"\"\"Extends the list with multiple Combination objects.\"\"\"\n        self._combinations.extend(combinations)\n\n    def get_combinations(self) -> list[Combination]:\n        \"\"\"Returns a copy of the list of contained Combination objects.\"\"\"\n        return list(self._combinations)\n\n    def to_list(self) -> list:\n        \"\"\"Converts the list of Combination objects to a list of raw Python lists.\"\"\"\n        return [c.to_list() for c in self._combinations]\n\nclass CombinationsGenerator:\n    \"\"\"Generates all combinations of a list's elements using the iterative-prepend algorithm.\"\"\"\n\n    @staticmethod\n    def combinations_list(lst: list) -> CombinationList:\n        \"\"\"\n        Computes all possible combinations using the iterative-prepend algorithm.\n        Returns a CombinationList object containing the ordered combinations.\n        \"\"\"\n        result_combination_list = CombinationList()\n        result_combination_list.append_combination(Combination([]))\n\n        for element in lst:\n            new_combinations_for_element = []\n            for prev_combination in result_combination_list.get_combinations():\n                new_combination_elements = [element] + prev_combination.to_list()\n                new_combinations_for_element.append(Combination(new_combination_elements))\n            \n            result_combination_list.extend_combinations(new_combinations_for_element)\n            \n        return result_combination_list\n\ndef combinations_list(lst: list) -> list:\n    \"\"\"\n    Public API to compute all possible combinations (subsets) of the input list.\n    Delegates to CombinationsGenerator and returns a Python list of lists.\n    \"\"\"\n    combination_list_obj = CombinationsGenerator.combinations_list(lst)\n    return combination_list_obj.to_list()\n\n```\n```python\n# src/__init__.py\n\nfrom .combinations import combinations_list\n```"}
{"task_id": "Mbpp/462", "solution": "```python\n# src/combinations_list.py\n\"\"\"Compute and return combinations (power set) per SRS ordering without mutating input_list.\n\nReferences the SRS acceptance test (example assert) and immutability requirement. The function intentionally does not perform input type coercion or validation beyond treating input_list as an iterable list per the SRS.\n\"\"\"\n\ndef combinations_list(input_list):\n    \"\"\"Compute and return combinations (power set) per SRS ordering without mutating input_list.\n\n    Exact behavior required by SRS: start with [[]]; for each element in input_list from first to last, append new combinations formed by prefixing that element to each existing combination in the current result snapshot (preserve relative order).\n    \"\"\"\n    result = [[]]\n    for element in input_list:\n        # snapshot current result to avoid iterating over appended items in this iteration\n        current_snapshot = list(result)\n        for combo in current_snapshot:\n            # create a new list with element prefixed to combo (do not mutate combo)\n            new_combo = [element] + list(combo)\n            result.append(new_combo)\n    return result\n```\n\n```python\n# tests/test_combinations.py\nfrom src.combinations_list import combinations_list\n\ndef test_example_assert():\n    input_list = ['orange', 'red', 'green', 'blue']\n    input_copy = list(input_list)  # shallow copy to verify non-mutation\n\n    expected = [\n        [],\n        ['orange'],\n        ['red'],\n        ['red', 'orange'],\n        ['green'],\n        ['green', 'orange'],\n        ['green', 'red'],\n        ['green', 'red', 'orange'],\n        ['blue'],\n        ['blue', 'orange'],\n        ['blue', 'red'],\n        ['blue', 'red', 'orange'],\n        ['blue', 'green'],\n        ['blue', 'green', 'orange'],\n        ['blue', 'green', 'red'],\n        ['blue', 'green', 'red', 'orange']\n    ]\n\n    result = combinations_list(input_list)\n\n    # Provided SRS exact assert (included verbatim)\n    assert result == expected\n\n    # Verify input list unchanged\n    assert input_list == input_copy\n```"}
{"task_id": "Mbpp/463", "solution": "```python\n# src/models.py\n# Implementation of domain model classes InputArray, Subarray, Result.\n\nclass InputArray:\n    \"\"\"Data holder for the input list of integers.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\nclass Subarray:\n    \"\"\"Data holder for a contiguous subarray candidate.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, product: int) -> None:\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.product = product\n\nclass Result:\n    \"\"\"Data holder representing the computation result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n```\n```python\n# src/max_subarray.py\n# Implementation of max_subarray_product(arr) and MaxSubarrayCalculator.\n# Public function must be named exactly max_subarray_product(arr).\n\nfrom .models import InputArray, Subarray, Result\n\nclass MaxSubarrayCalculator:\n    \"\"\"Encapsulates algorithm to compute maximum product of any contiguous subarray.\"\"\"\n    def __init__(self) -> None:\n        self._last_input: list[int] | None = None\n        self._last_result: int | None = None\n\n    def max_subarray_product(self, arr: list[int]) -> int:\n        \"\"\"Compute and return maximum contiguous-subarray product.\"\"\"\n        if not arr:\n            # As per design notes, behavior for empty arrays is unspecified.\n            # Given CRITICAL REQUIREMENTS: \"Trust the caller's inputs\",\n            # we assume non-empty array or handle a simple default.\n            # A common default for max product in an empty array context might be 0\n            # if the product can be 0, or raise an error. Given the sample, we assume non-empty.\n            return 0 # Or float('-inf') if an empty product is not 0\n\n        max_so_far = arr[0]\n        min_so_far = arr[0]\n        overall_max_product = arr[0]\n\n        for i in range(1, len(arr)):\n            current_num = arr[i]\n\n            # If current_num is negative, swap max_so_far and min_so_far.\n            if current_num < 0:\n                max_so_far, min_so_far = min_so_far, max_so_far\n\n            # Update max_so_far and min_so_far for the current number\n            max_so_far = max(current_num, max_so_far * current_num)\n            min_so_far = min(current_num, min_so_far * current_num)\n\n            # Update the overall maximum product\n            overall_max_product = max(overall_max_product, max_so_far)\n        \n        self._last_input = arr\n        self._last_result = overall_max_product\n        return overall_max_product\n\n    def computeCandidateProducts(self, arr: list[int]) -> list[Subarray]:\n        \"\"\"Enumerate contiguous subarray candidates and compute their products.\"\"\"\n        candidates = []\n        n = len(arr)\n        for i in range(n):\n            current_product = 1\n            for j in range(i, n):\n                current_product *= arr[j]\n                candidates.append(Subarray(i, j, current_product))\n        return candidates\n\ndef max_subarray_product(arr: list[int]) -> int:\n    \"\"\"Public API: Finds the maximum product of any contiguous subarray of the given array.\"\"\"\n    calculator = MaxSubarrayCalculator()\n    return calculator.max_subarray_product(arr)\n\n```\n```python\n# tests/test_max_subarray.py\n# Unit test verifying the sample acceptance criterion described in the SRS.\n\nfrom src.max_subarray import max_subarray_product\n\ndef test_sample_assertion():\n    \"\"\"Verify the sample acceptance criterion from the SRS.\"\"\"\n    assert max_subarray_product([1, -2, -3, 0, 7, -8, -2]) == 112\n\n```"}
{"task_id": "Mbpp/463", "solution": "```python\nfrom typing import List\n\nclass InputArray:\n    \"\"\"\n    Represents the input integer array.\n    Stores values and derived length.\n    \"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n        self.length = len(values)\n\nclass Subarray:\n    \"\"\"\n    Represents a contiguous subarray.\n    Stores its start index, end index, and computed product.\n    \"\"\"\n    def __init__(self, startIndex: int, endIndex: int, product: int):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.product = product\n\nclass Result:\n    \"\"\"\n    Holds the maximum product found and optionally its indices.\n    Used for conceptual tracking of the final result.\n    \"\"\"\n    def __init__(self, maxProduct: int, startIndex: int = -1, endIndex: int = -1):\n        self.maxProduct = maxProduct\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\nclass TestCase:\n    \"\"\"\n    A simple data holder for a test case.\n    Can execute itself and return success status.\n    \"\"\"\n    def __init__(self, input: List[int], expected: int):\n        self.input = input\n        self.expected = expected\n    \n    def run(self, func_to_test) -> bool:\n        \"\"\"\n        Runs the test case against a provided function.\n        Returns True if the actual result matches the expected result.\n        \"\"\"\n        actual = func_to_test(self.input)\n        return actual == self.expected\n\nclass MaxProductCalculator:\n    \"\"\"\n    Calculates the maximum product of a contiguous subarray.\n    Handles validation and the core algorithm logic.\n    \"\"\"\n    def __init__(self):\n        self.algorithm = \"Dynamic programming approach tracking current max and min products.\"\n\n    def validateInput(self, arr: List[int]) -> bool:\n        \"\"\"\n        Validates the input array for computation.\n        Returns False if the array is None or empty.\n        \"\"\"\n        return arr is not None and len(arr) > 0\n\n    def compute(self, arr: List[int]) -> int:\n        \"\"\"\n        Computes the maximum contiguous subarray product.\n        Iterates through the array tracking current max/min and global max.\n        \"\"\"\n        # As per BR-09, single-element arrays return that element.\n        result = arr[0]\n        current_max = arr[0]\n        current_min = arr[0]\n\n        for i in range(1, len(arr)):\n            num = arr[i]\n\n            if num == 0:\n                # Zeros are separators (BR-08). Reset current products for new segment.\n                result = max(result, 0)\n                current_max = 1\n                current_min = 1\n                continue\n\n            # Store previous current_max to correctly calculate current_min.\n            temp_current_max = current_max\n\n            # Update current_max and current_min (BR-07: account for sign flips).\n            current_max = max(num, temp_current_max * num, current_min * num)\n            current_min = min(num, temp_current_max * num, current_min * num)\n\n            # Update global max product.\n            result = max(result, current_max)\n            \n        return result\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Public API to compute the maximum product of a contiguous subarray.\n    Delegates to MaxProductCalculator for validation and core computation.\n    \"\"\"\n    # InputArray(values=arr) is a conceptual construction per design, not requiring assignment here.\n\n    calculator = MaxProductCalculator()\n    \n    # Validate input (FR-001, FR-005, BR-05).\n    # If validateInput returns False, behavior for empty/None array is to return 0.\n    if not calculator.validateInput(arr):\n        return 0 \n    \n    # Compute and return the maximum product (FR-002, BR-07, BR-08, BR-09).\n    # Input array 'arr' is used read-only by the calculator (BR-05).\n    return calculator.compute(arr)\n```"}
