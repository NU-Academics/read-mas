{"task_id": "Mbpp/389", "solution": "```python\n# src/__init__.py\n\"\"\"\nPackage marker for the src module.\nRe-exports the main public API for easy access.\n\"\"\"\nfrom .lucas_service import LucasService, find_lucas\n\n__all__ = [\"LucasService\", \"find_lucas\"]\n\n```\n```python\n# src/error_response.py\nfrom typing import Dict, Any\n\nclass ErrorResponse:\n    \"\"\"\n    Represents structured error information with a code and message.\n    Provides a method to convert the error into a dictionary.\n    \"\"\"\n    def __init__(self, code: int, message: str) -> None:\n        self.code = code\n        self.message = message\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the error response object to a dictionary.\"\"\"\n        return {\"code\": self.code, \"message\": self.message}\n\n```\n```python\n# src/input_validator.py\nfrom typing import Any\n\ndef is_integer(value: Any) -> bool:\n    \"\"\"Checks if the given value is an integer type.\"\"\"\n    return isinstance(value, int)\n\ndef is_non_negative(n: int) -> bool:\n    \"\"\"Checks if the given integer 'n' is non-negative (n >= 0).\"\"\"\n    return n >= 0\n\ndef validate_n_or_raise(n: Any) -> None:\n    \"\"\"\n    Validates that 'n' is an integer and non-negative, raising ValueError if invalid.\n    This ensures input conforms to the Lucas number definition.\n    \"\"\"\n    if not is_integer(n):\n        raise ValueError(f\"Input 'n' must be an integer, but received type {type(n).__name__}.\")\n    if not is_non_negative(n):\n        raise ValueError(f\"Input 'n' must be non-negative, but received {n}.\")\n\n```\n```python\n# src/lucas_calculator.py\n\ndef compute_base_cases(n: int) -> int:\n    \"\"\"Returns the Lucas number for base cases n=0 or n=1.\"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    # This should ideally not be reached if called correctly from compute_lucas.\n    raise ValueError(\"compute_base_cases expects n to be 0 or 1.\")\n\n\ndef compute_recurrence(n: int) -> int:\n    \"\"\"\n    Computes the nth Lucas number for n >= 2 using an iterative recurrence.\n    This method ensures O(n) time complexity and O(1) additional space.\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"compute_recurrence expects n >= 2.\")\n\n    # Initialize with L0 and L1 values\n    l_prev2 = 2  # Corresponds to L(i-2)\n    l_prev1 = 1  # Corresponds to L(i-1)\n\n    for _ in range(2, n + 1):\n        l_current = l_prev1 + l_prev2\n        l_prev2 = l_prev1\n        l_prev1 = l_current\n    return l_prev1\n\n\ndef compute_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the nth Lucas number based on its index 'n'.\n    It delegates to base case computation for n=0,1 or recurrence for n>=2.\n    \"\"\"\n    if n == 0 or n == 1:\n        return compute_base_cases(n)\n    else:  # n >= 2\n        return compute_recurrence(n)\n\n```\n```python\n# src/lucas_service.py\nfrom src.input_validator import validate_n_or_raise\nfrom src.lucas_calculator import compute_lucas\nfrom src.error_response import ErrorResponse # Imported as per design specification.\n\nclass LucasService:\n    \"\"\"\n    Provides the core Lucas Number service, orchestrating input validation and computation.\n    It serves as the main entry point for finding Lucas numbers.\n    \"\"\"\n    def find_lucas(self, n: int) -> int:\n        \"\"\"\n        Finds the nth Lucas number, validating input and delegating computation.\n        Raises ValueError for invalid input 'n' as per design.\n        \"\"\"\n        validate_n_or_raise(n)\n        return compute_lucas(n)\n\n# Module-level convenience wrapper for the LucasService.\n# This allows direct calls like `find_lucas(n)`.\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Public API entry point to find the nth Lucas number.\n    It creates a LucasService instance and calls its find_lucas method.\n    \"\"\"\n    return LucasService().find_lucas(n)\n\n```\n```python\n# tests/test_find_lucas.py\nimport unittest\nfrom typing import Union, Type\nfrom src.lucas_service import find_lucas\nfrom src.error_response import ErrorResponse\n\nclass TestCase:\n    \"\"\"\n    Represents a single test case for the Lucas Number service.\n    It encapsulates test data and provides a method to run the test.\n    \"\"\"\n    def __init__(self, name: str, input_n: int, expected: Union[int, Type[Exception]], is_error_case: bool = False):\n        self.name = name\n        self.input_n = input_n\n        self.expected = expected\n        self.actual: Union[int, Type[Exception], None] = None\n        self.passed: bool = False\n        self.is_error_case = is_error_case\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the test case by calling find_lucas and records the result.\n        It handles both successful computations and expected error conditions.\n        \"\"\"\n        try:\n            self.actual = find_lucas(self.input_n)\n            self.passed = (self.actual == self.expected) if not self.is_error_case else False\n        except Exception as e:\n            if self.is_error_case:\n                self.actual = type(e)\n                self.passed = (self.actual == self.expected)\n            else:\n                self.actual = e  # Capture unexpected error for debugging\n                self.passed = False\n        return self.passed\n\nclass TestFindLucas(unittest.TestCase):\n    \"\"\"\n    Unit tests for the find_lucas function, utilizing the TestCase harness.\n    It verifies both correct Lucas number computation and robust error handling.\n    \"\"\"\n    def test_lucas_numbers(self):\n        \"\"\"Tests various valid inputs to ensure correct Lucas number calculation.\"\"\"\n        test_cases = [\n            TestCase(\"L0\", 0, 2),\n            TestCase(\"L1\", 1, 1),\n            TestCase(\"L2\", 2, 3),\n            TestCase(\"L3\", 3, 4),\n            TestCase(\"L4\", 4, 7),\n            TestCase(\"L5\", 5, 11),\n            TestCase(\"L6\", 6, 18),\n            TestCase(\"L7\", 7, 29),\n            TestCase(\"L8\", 8, 47),\n            TestCase(\"L9\", 9, 76), # Required example test\n            TestCase(\"L10\", 10, 123),\n        ]\n\n        print(\"\\n--- Running Lucas Number Tests ---\")\n        for case in test_cases:\n            case.run()\n            status = \"PASSED\" if case.passed else \"FAILED\"\n            print(f\"Test: {case.name}({case.input_n}) | Expected: {case.expected} | Actual: {case.actual} | Status: {status}\")\n            self.assertTrue(case.passed, f\"Test case '{case.name}' failed: Expected {case.expected}, got {case.actual}\")\n        print(\"--- Lucas Number Tests Complete ---\\n\")\n\n    def test_invalid_inputs(self):\n        \"\"\"Tests invalid inputs to confirm that appropriate ValueErrors are raised.\"\"\"\n        error_cases = [\n            TestCase(\"Negative n\", -1, ValueError, is_error_case=True),\n            TestCase(\"Float n\", 1.5, ValueError, is_error_case=True),\n            TestCase(\"String n\", \"abc\", ValueError, is_error_case=True),\n            TestCase(\"None n\", None, ValueError, is_error_case=True),\n            TestCase(\"Boolean n\", True, ValueError, is_error_case=True),\n        ]\n\n        print(\"\\n--- Running Invalid Input Tests ---\")\n        for case in error_cases:\n            case.run()\n            status = \"PASSED\" if case.passed else \"FAILED\"\n            actual_error_name = getattr(case.actual, '__name__', str(case.actual))\n            print(f\"Test: {case.name}({case.input_n}) | Expected Error: {case.expected.__name__} | Actual Error: {actual_error_name} | Status: {status}\")\n            self.assertTrue(case.passed, f\"Error test case '{case.name}' failed: Expected {case.expected.__name__}, got {actual_error_name}\")\n        print(\"--- Invalid Input Tests Complete ---\\n\")\n\n    def test_error_response_class(self):\n        \"\"\"Verifies the functionality and structure of the ErrorResponse data model.\"\"\"\n        error_resp = ErrorResponse(400, \"Invalid input parameter 'n'\")\n        self.assertEqual(error_resp.code, 400)\n        self.assertEqual(error_resp.message, \"Invalid input parameter 'n'\")\n        self.assertEqual(error_resp.to_dict(), {\"code\": 400, \"message\": \"Invalid input parameter 'n'\"})\n\nif __name__ == \"__main__\":\n    unittest.main()\n\n```"}
{"task_id": "Mbpp/389", "solution": "```python\n# src/lucas/validator.py\nclass InputParameter:\n    \"\"\"Simple holder for input n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass Validator:\n    \"\"\"Validates that n is a non-negative integer.\"\"\"\n    def is_non_negative(self, n: int) -> bool:\n        \"\"\"Returns True if n is an integer >= 0, else False.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n# src/lucas/calculator.py\nclass LucasNumber:\n    \"\"\"Value object representing computed Lucas number and index.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\nclass LucasCalculator:\n    \"\"\"Computes Lucas numbers using the recurrence and base cases.\"\"\"\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Computes the nth Lucas number iteratively.\"\"\"\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n\n        a, b = 2, 1  # L(0) = 2, L(1) = 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n# src/lucas/__init__.py\nfrom .validator import Validator, InputParameter\nfrom .calculator import LucasCalculator\n\ndef find_lucas(n: int) -> int:\n    \"\"\"Public library entry; validate input and return integer nth Lucas number.\"\"\"\n    ip = InputParameter(n)\n    if not Validator().is_non_negative(ip.n):\n        raise ValueError(\"n must be a non-negative integer\")\n    return LucasCalculator().find_lucas(ip.n)\n```"}
{"task_id": "Mbpp/390", "solution": "```python\ndef add_string(input_list, format_string):\n    \"\"\"\n    Public API function to format a list of elements.\n    It delegates to an internal Formatter component.\n    \"\"\"\n    from typing import Any, List\n\n    class Element:\n        \"\"\"Represents a single input element for formatting.\n        Converts its value to a string representation.\"\"\"\n        def __init__(self, value: Any, position: int = None):\n            self.value = value\n            self.position = position\n        def toString(self) -> str:\n            return str(self.value)\n\n    class InputList:\n        \"\"\"Wraps the input collection, copying elements to ensure immutability.\n        Provides a method to get its length.\"\"\"\n        def __init__(self, elements: List[Any]):\n            self.elements: List[Any] = list(elements)\n        def length(self) -> int:\n            return len(self.elements)\n\n    class OutputList:\n        \"\"\"Collects the formatted string results.\n        Holds a list of formatted string values.\"\"\"\n        def __init__(self):\n            self.formattedValues: List[str] = []\n\n    class Formatter:\n        \"\"\"Implements the core formatting logic.\n        Provides a static method to process input and generate output.\"\"\"\n        @staticmethod\n        def add_string(input_list: List[Any], format_string: str) -> List[str]:\n            input_wrapper = InputList(elements=input_list)\n            output_list = OutputList()\n\n            for element_value in input_wrapper.elements:\n                element_string = Element(element_value).toString()\n                # Applies the format string using the {0} placeholder.\n                formatted_string = format_string.format(element_string)\n                output_list.formattedValues.append(formatted_string)\n\n            return output_list.formattedValues\n\n    # Delegate the actual formatting work to the Formatter.\n    return Formatter.add_string(input_list, format_string)\n```"}
{"task_id": "Mbpp/390", "solution": "```python\n# src/add_string.py\n\"\"\"\nSmall Python 3.x library component.\nProvides add_string(lst, fmt) for applying a format string to list elements using str.format.\n\nExample usage:\nadd_string([1,2,3,4], 'temp{0}') -> ['temp1','temp2','temp3','temp4']\n\"\"\"\nfrom typing import Any, List\n\nclass Formatter:\n    \"\"\"\n    Helper class to encapsulate a Python format string.\n    Applies the format string to a value using str.format.\n    \"\"\"\n    def __init__(self, fmt: str):\n        self.fmt = fmt\n\n    def format(self, value: Any) -> str:\n        \"\"\"Applies the stored format string to the given value.\"\"\"\n        return self.fmt.format(value)\n\ndef add_string(lst: List[Any], fmt: str) -> List[str]:\n    \"\"\"\n    Applies a given format string to each element in the input list.\n    Uses Python's str.format mechanism and preserves input order.\n    \"\"\"\n    formatter = Formatter(fmt)\n    return [formatter.format(element) for element in lst]\n```"}
{"task_id": "Mbpp/391", "solution": "def validate_lengths(lists):\n    \"\"\"\n    Validates if there are at least two lists and all input lists have the same length.\n    \"\"\"\n    if len(lists) < 2:\n        return False\n    first_length = len(lists[0])\n    for lst in lists:\n        if len(lst) != first_length:\n            return False\n    return True\n\ndef build_nested_mapping(row_values):\n    \"\"\"\n    Constructs a nested dictionary from a sequence of values for a single row.\n    \"\"\"\n    current_dict = row_values[-1]\n    for i in range(len(row_values) - 2, -1, -1):\n        current_dict = {row_values[i]: current_dict}\n    return current_dict\n\ndef convert_list_dictionary(*lists):\n    \"\"\"\n    Converts two or more parallel lists into a list of nested dictionaries.\n    \"\"\"\n    if not validate_lengths(lists):\n        raise ValueError('Input lists must have the same length and at least two lists must be provided')\n\n    result_list = []\n    num_rows = len(lists[0])\n\n    for i in range(num_rows):\n        top_key = lists[0][i]\n        # Extract values for nested dictionary construction from lists[1:] at current index i\n        row_values_for_nested = tuple(lst[i] for lst in lists[1:])\n        nested_dict = build_nested_mapping(row_values_for_nested)\n        result_list.append({top_key: nested_dict})\n\n    return result_list"}
{"task_id": "Mbpp/392", "solution": "```python\n# Initialize a dictionary for memoization to store computed values.\nmemo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"Computes f(n) using the recurrence f(n) = max(sum of f(n/k), n).\n    The function uses memoization to optimize performance for repeated calls.\"\"\"\n    if n == 0:\n        return 0\n    if n in memo:\n        return memo[n]\n\n    # Calculate the sum of recursive calls using integer floor division.\n    sum_children = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # Determine the result as the maximum of the sum of children or n itself.\n    result = max(sum_children, n)\n    memo[n] = result\n    return result\n```"}
{"task_id": "Mbpp/391", "solution": "```python\nclass ValidationException(Exception):\n    \"\"\"Custom exception for validation errors during list-to-nested-dictionary conversion.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_count(lists: tuple) -> None:\n    \"\"\"Validates that at least two lists are supplied.\"\"\"\n    if len(lists) < 2:\n        raise ValidationException(\"At least two lists are required for conversion.\")\n\ndef validate_lengths(lists: tuple) -> int:\n    \"\"\"Validates that all input lists have equal length and returns that length.\"\"\"\n    if not lists:\n        return 0 # This case should be caught by validate_count for len < 2\n    first_list_length = len(lists[0])\n    for lst in lists:\n        if len(lst) != first_list_length:\n            raise ValidationException(\"All input lists must have equal length.\")\n    return first_list_length\n\ndef build_nested_dict_for_index(lists: tuple, i: int) -> dict:\n    \"\"\"Builds a single nested dictionary for a specific index across all lists.\"\"\"\n    # The last list provides the innermost leaf value.\n    current_value = lists[-1][i]\n\n    # Iterate backwards from the second-to-last list to the first list,\n    # nesting dictionaries progressively.\n    for j in range(len(lists) - 2, -1, -1):\n        key = lists[j][i]\n        try:\n            current_value = {key: current_value}\n        except TypeError as e:\n            raise ValidationException(f\"Unhashable element used as dictionary key: {key!r}\") from e\n    return current_value\n\ndef convert_list_dictionary(*lists) -> list:\n    \"\"\"\n    Converts two or more lists into a list of nested dictionaries.\n    Each nested dictionary is formed from elements at the same index across the input lists.\n    \"\"\"\n    validate_count(lists)\n    num_elements = validate_lengths(lists)\n\n    if num_elements == 0:\n        return []\n\n    result_list = []\n    for i in range(num_elements):\n        nested_dict = build_nested_dict_for_index(lists, i)\n        result_list.append(nested_dict)\n\n    return result_list\n```"}
