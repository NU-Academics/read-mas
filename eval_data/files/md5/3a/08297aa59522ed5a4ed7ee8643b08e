{"task_id": "Mbpp/392", "solution": "```python\n# src/__init__.py\n# Package marker\n\n# src/api.py\nfrom src.input_parameter import InputParameter\nfrom src.memoization_store import MemoizationStore\nfrom src.computation_service import ComputationService\nfrom src.result import Result # Imported as per design, though not directly used for the final return value.\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Public API function to compute f(n) = max(f(n//2)+f(n//3)+f(n//4)+f(n//5), n).\n    Validates input, uses memoization, and delegates to a computation service.\n    \"\"\"\n    ip = InputParameter(n)\n    ip.validate()\n    \n    cache = MemoizationStore()\n    service = ComputationService(cache)\n    result_value = service.get_max_sum(n)\n    return result_value\n\n# src/input_parameter.py\nfrom typing import Optional\n\nclass InputParameter:\n    \"\"\"\n    Validates input parameter n according to FR3/BR3.\n    Ensures n is a non-negative integer.\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"\n        Validates the input parameter n.\n        Raises ValueError if n is not a non-negative integer.\n        \"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if self.n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n# src/memoization_store.py\nfrom typing import Dict\n\nclass MemoizationStore:\n    \"\"\"\n    In-memory memoization store for computed f(n) values.\n    Stores and retrieves results to avoid recomputation.\n    \"\"\"\n    def __init__(self):\n        self._cache: Dict[int, int] = {}\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if n is present in the cache.\"\"\"\n        return n in self._cache\n\n    def get(self, n: int) -> int:\n        \"\"\"Retrieves the cached value for n.\"\"\"\n        return self._cache[n]\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores the computed value for n in the cache.\"\"\"\n        self._cache[n] = value\n\n# src/computation_service.py\nfrom typing import Optional\nfrom src.memoization_store import MemoizationStore\nfrom src.result import Result # Imported as per design, though Result objects are not explicitly returned.\n\nclass ComputationService:\n    \"\"\"\n    Implements algorithm for computing f(n) including recursion and subcomputations.\n    Orchestrates the computation and uses the memoization cache.\n    \"\"\"\n    def __init__(self, cache: MemoizationStore, recursion_limit: Optional[int] = None):\n        self.cache: MemoizationStore = cache\n        self._recursion_limit: Optional[int] = recursion_limit\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"\n        Public entry point to compute the maximum sum for n.\n        Delegates to the internal recursive _compute method.\n        \"\"\"\n        return self._compute(n)\n\n    def _compute(self, n: int) -> int:\n        \"\"\"\n        Internal recursive implementation of f(n) = max(sum(parts), n).\n        Handles base cases, memoization, and recursive calls via SubComputation.\n        \"\"\"\n        if n == 0:\n            return 0\n\n        if self.cache.contains(n):\n            return self.cache.get(n)\n\n        n2 = n // 2\n        n3 = n // 3\n        n4 = n // 4\n        n5 = n // 5\n\n        part_sum = (\n            SubComputation(n2, self).compute_part() +\n            SubComputation(n3, self).compute_part() +\n            SubComputation(n4, self).compute_part() +\n            SubComputation(n5, self).compute_part()\n        )\n\n        result = max(part_sum, n)\n        self.cache.set(n, result)\n        return result\n\nclass SubComputation:\n    \"\"\"\n    Helper class to represent a subproblem computation.\n    Delegates the actual partition computation to the ComputationService.\n    \"\"\"\n    def __init__(self, n_part: int, service: ComputationService):\n        self.n_part: int = n_part\n        self.service: ComputationService = service\n\n    def compute_part(self) -> int:\n        \"\"\"\n        Computes the result for a subproblem part.\n        Delegates to the ComputationService's internal _compute method.\n        \"\"\"\n        return self.service._compute(self.n_part)\n\n# src/result.py\nclass Result:\n    \"\"\"\n    Simple Result wrapper for returned integer value.\n    Encapsulates the final computed integer.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\n# tests/test_maxsum.py\nimport sys\nimport os\n\n# Adjust path to allow importing src.api\ncurrent_dir = os.path.dirname(os.path.abspath(__file__))\nproject_root = os.path.abspath(os.path.join(current_dir, os.pardir))\nsys.path.insert(0, project_root)\n\nfrom src.api import get_max_sum\n\ndef test_get_max_sum_60():\n    \"\"\"\n    Verification test asserting get_max_sum(60) == 106.\n    Ensures the core computation logic is correct for a specific example.\n    \"\"\"\n    assert get_max_sum(60) == 106\n```"}
{"task_id": "Mbpp/394", "solution": "```python\n# src/__init__.py\nfrom .check_distinct_service import check_distinct\n```\n\n```python\n# src/exceptions.py\nclass InvalidInputError(TypeError):\n    \"\"\"Exception raised for invalid input types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n```\n\n```python\n# src/models.py\nfrom dataclasses import dataclass\nfrom typing import Tuple\n\n@dataclass(frozen=True)\nclass TupleInput:\n    \"\"\"A data carrier for an input tuple.\"\"\"\n    elements: Tuple\n\n@dataclass(frozen=True)\nclass ValidationResult:\n    \"\"\"A data carrier for the validation result.\"\"\"\n    isDistinct: bool\n```\n\n```python\n# src/duplicate_detector.py\nfrom typing import Tuple\n\nclass DuplicateDetector:\n    \"\"\"Detects duplicate elements within a tuple.\"\"\"\n\n    def has_duplicates(self, input_tuple: Tuple) -> bool:\n        \"\"\"Return True if duplicates are found in the tuple; False otherwise.\"\"\"\n        # Uses a set for efficient O(N) detection of hashable elements.\n        seen = set()\n        for element in input_tuple:\n            if element in seen:\n                return True\n            seen.add(element)\n        return False\n```\n\n```python\n# src/check_distinct_service.py\nfrom typing import Tuple\nfrom src.duplicate_detector import DuplicateDetector\nfrom src.exceptions import InvalidInputError\n# src.models is imported for design completeness, though ValidationResult is not directly returned by public API.\n\nclass CheckDistinctService:\n    \"\"\"Orchestrates input validation and duplicate detection.\"\"\"\n\n    def __init__(self, detector: DuplicateDetector) -> None:\n        self._detector = detector\n\n    def check_distinct(self, input_tuple: Tuple) -> bool:\n        \"\"\"Validates input type and delegates duplicate checking.\"\"\"\n        if not isinstance(input_tuple, tuple):\n            raise InvalidInputError(\"Input must be a tuple.\")\n        \n        has_dup = self._detector.has_duplicates(input_tuple)\n        return not has_dup\n\ndef check_distinct(input: Tuple) -> bool:\n    \"\"\"Public entrypoint. Checks if the given tuple contains no duplicate elements.\"\"\"\n    service = CheckDistinctService(detector=DuplicateDetector())\n    return service.check_distinct(input)\n```"}
