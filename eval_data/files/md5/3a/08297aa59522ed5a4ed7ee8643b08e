{"task_id": "Mbpp/77", "solution": "```python\n# /src/__init__.py\n\"\"\"\nPackage initializer for the src directory.\nAllows direct imports from src submodules.\n\"\"\"\n\n```python\n# /src/is_diff.py\n\"\"\"\nImplements the public API function is_Diff(number) to check divisibility by 11.\nPrecondition: Input 'number' is an integer.\n\"\"\"\n\ndef is_Diff(number: int) -> bool:\n    \"\"\"\n    Determines whether an integer is divisible by 11.\n    Returns True if divisible by 11, False otherwise.\n    \"\"\"\n    return number % 11 == 0\n\n```python\n# /src/domain.py\n\"\"\"\nProvides dataclass representations for domain concepts like IntegerInput, BooleanResult, and TestCase.\nSupports test orchestration and documentation of analysis-domain artifacts.\n\"\"\"\nfrom dataclasses import dataclass\n\n@dataclass\nclass IntegerInput:\n    \"\"\"Lightweight holder for an integer input.\"\"\"\n    value: int\n\n@dataclass\nclass BooleanResult:\n    \"\"\"Lightweight holder for a boolean result.\"\"\"\n    value: bool\n\n@dataclass\nclass TestCase:\n    \"\"\"Encapsulates a test input and its expected boolean result.\"\"\"\n    input: int\n    expected: bool\n\n    def run(self) -> bool:\n        \"\"\"\n        Invokes is_Diff with the test input and verifies the result.\n        Returns True if the observed result matches the expected result.\n        \"\"\"\n        # Import here to avoid potential circular import concerns at module level\n        from src.is_diff import is_Diff\n        observed = is_Diff(self.input)\n        return observed == self.expected\n\n```python\n# /tests/__init__.py\n\"\"\"\nPackage initializer for the tests directory.\nAllows relative imports within the tests package.\n\"\"\"\n\n```python\n# /tests/test_is_diff.py\n\"\"\"\nUnit tests for the is_Diff function, including the SRS-specified example.\nVerifies correctness for various integer inputs.\n\"\"\"\nfrom src.is_diff import is_Diff\n# TestCase from src.domain is used for conceptual mapping, not directly for assertions in this module.\n\ndef test_example():\n    \"\"\"\n    Verifies the specific example assertion from the SRS: is_Diff(12345) == False.\n    This test ensures the canonical example is correctly handled.\n    \"\"\"\n    assert is_Diff(12345) == False\n\ndef test_multiples_and_non_multiples():\n    \"\"\"\n    Tests is_Diff with a range of multiples and non-multiples of 11.\n    Covers positive, zero, and negative integers.\n    \"\"\"\n    # Multiples of 11\n    assert is_Diff(0) == True\n    assert is_Diff(11) == True\n    assert is_Diff(22) == True\n    assert is_Diff(121) == True # 11 * 11\n    assert is_Diff(-11) == True\n    assert is_Diff(-22) == True\n\n    # Non-multiples of 11\n    assert is_Diff(1) == False\n    assert is_Diff(10) == False\n    assert is_Diff(12) == False\n    assert is_Diff(12344) == False # Close to 12342 (11 * 1122)\n    assert is_Diff(-1) == False\n    assert is_Diff(-10) == False\n    assert is_Diff(-12) == False\n\n```python\n# /tests/run_tests.py\n\"\"\"\nA lightweight test runner script to execute unit tests.\nDemonstrates running specific test functions and the example assertion.\n\"\"\"\nimport sys\nfrom tests.test_is_diff import test_example, test_multiples_and_non_multiples\nfrom src.domain import TestCase\n\ndef run_all() -> int:\n    \"\"\"\n    Executes all defined tests and reports success or failure.\n    Returns 0 on successful completion of all tests, non-zero otherwise.\n    \"\"\"\n    print(\"Running tests...\")\n    total_tests = 0\n    failed_tests = 0\n\n    # Run tests from test_is_diff.py directly\n    try:\n        print(\"\\n--- Running test_example() ---\")\n        test_example()\n        total_tests += 1\n        print(\"PASS: test_example()\")\n    except AssertionError:\n        failed_tests += 1\n        total_tests += 1\n        print(\"FAIL: test_example()\")\n\n    try:\n        print(\"\\n--- Running test_multiples_and_non_multiples() ---\")\n        test_multiples_and_non_multiples()\n        total_tests += 1\n        print(\"PASS: test_multiples_and_non_multiples()\")\n    except AssertionError:\n        failed_tests += 1\n        total_tests += 1\n        print(\"FAIL: test_multiples_and_non_multiples()\")\n\n    # Demonstrate TestCase usage for the example from SRS\n    print(\"\\n--- Running TestCase for SRS example: is_Diff(12345) == False ---\")\n    srs_test_case = TestCase(input=12345, expected=False)\n    if srs_test_case.run():\n        total_tests += 1\n        print(\"PASS: TestCase(12345, False).run() - observed matched expected.\")\n    else:\n        failed_tests += 1\n        total_tests += 1\n        print(\"FAIL: TestCase(12345, False).run() - observed did not match expected.\")\n\n    print(f\"\\n--- Test Summary ---\")\n    print(f\"Total tests run: {total_tests}\")\n    print(f\"Tests passed: {total_tests - failed_tests}\")\n    print(f\"Tests failed: {failed_tests}\")\n\n    return 0 if failed_tests == 0 else 1\n\nif __name__ == '__main__':\n    sys.exit(run_all())\n\n```"}
{"task_id": "Mbpp/80", "solution": "```python\n# src/tetrahedral.py\ndef _validate_n(n: int) -> None:\n    \"\"\"\n    Validates input n to be an integer and n >= 1.\n    Raises ValueError for invalid input.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Computes the nth tetrahedral number.\n    Enforces precondition n >= 1.\n    \"\"\"\n    _validate_n(n)\n    # Computes n*(n+1)*(n+2)//6 using integer division for exact result.\n    return n * (n + 1) * (n + 2) // 6\n\n```\n```python\n# tests/test_tetrahedral.py\nfrom src.tetrahedral import tetrahedral_number\n\ndef test_tetrahedral_number_example() -> None:\n    \"\"\"\n    Verifies the tetrahedral_number function with a specific example.\n    Asserts that tetrahedral_number(5) returns 35.\n    \"\"\"\n    assert tetrahedral_number(5) == 35\n\n```"}
{"task_id": "Mbpp/82", "solution": "```python\n# src/calculator.py\nimport math\n\nclass MathConstants:\n    \"\"\"Provides mathematical constants, ensuring accuracy for PI.\"\"\"\n    PI: float = math.pi\n\nclass Sphere:\n    \"\"\"Represents a sphere with a given radius.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self.radius: float = radius\n\nclass VolumeResult:\n    \"\"\"Encapsulates the computed volume value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value: float = value\n\nclass VolumeCalculator:\n    \"\"\"A stateless service for computing the volume of a sphere.\"\"\"\n    def computeVolume(self, radius: float) -> float:\n        \"\"\"Calculates sphere volume using the formula (4/3) * PI * radius^3.\"\"\"\n        return (4.0 / 3.0) * MathConstants.PI * (radius ** 3)\n\n```\n```python\n# src/volume_sphere.py\nfrom .calculator import VolumeCalculator, MathConstants\n\ndef volume_sphere(radius) -> float:\n    \"\"\"\n    Computes the volume of a sphere given its radius.\n    Validates input and delegates calculation to VolumeCalculator.\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"Radius must be a numeric value (int or float).\")\n\n    # The design specifies instantiation within the function.\n    calculator = VolumeCalculator()\n    result_value = calculator.computeVolume(float(radius))\n    return float(result_value)\n\n```\n```python\n# tests/test_volume_sphere.py\nimport math\nfrom src.volume_sphere import volume_sphere\n\ndef test_acceptance_volume_sphere():\n    \"\"\"Verifies the volume_sphere function against the acceptance criterion.\"\"\"\n    expected_volume = 4188.790204786391\n    assert math.isclose(volume_sphere(10), expected_volume, rel_tol=0.001)\n\n```"}
{"task_id": "Mbpp/82", "solution": "```python\n# src/sphere.py\nimport math\n\ndef validate_radius(radius):\n    \"\"\"Raise TypeError if radius is not int or float.\n    (BR3/FR3)\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError('radius must be numeric (int or float)')\n\ndef volume_sphere(radius) -> float:\n    \"\"\"Return sphere volume as float using V = (4/3) * math.pi * radius**3.\n    (FR1, FR2, FR3, NFR2)\n    \"\"\"\n    validate_radius(radius)\n    r = float(radius)\n    volume = (4.0 / 3.0) * math.pi * (r ** 3)\n    return float(volume)\n\n```\n```python\n# tests/test_volume.py\nimport math\nfrom src.sphere import volume_sphere\n\ndef test_volume_sphere_10():\n    \"\"\"Verify computed volume for radius = 10 meets required tolerance.\"\"\"\n    assert math.isclose(volume_sphere(10), 4188.790204786391, rel_tol=0.001)\n\n```"}
{"task_id": "Mbpp/80", "solution": "```python\nfrom dataclasses import dataclass\n\ndef tetrahedral_number(n):\n    \"\"\"\n    Public API to compute the nth tetrahedral number.\n    Delegates to TetrahedralCalculator for validation and computation.\n    \"\"\"\n    calculator = TetrahedralCalculator()\n    return calculator.tetrahedral_number(n)\n\n@dataclass\nclass Input:\n    \"\"\"Simple helper to represent input and centralize validation predicate.\"\"\"\n    n: int\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if n is an integer >= 1, False otherwise.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\nclass TetrahedralCalculator:\n    \"\"\"Encapsulates validation and computation logic for tetrahedral numbers.\"\"\"\n\n    def tetrahedral_number(self, n) -> int:\n        \"\"\"\n        Validates input and computes the nth tetrahedral number.\n        Raises ValueError for invalid input.\n        \"\"\"\n        self.validate_input(n)\n        return self.compute_formula(n)\n\n    def validate_input(self, n) -> None:\n        \"\"\"\n        Checks that n is an integer and n >= 1.\n        Raises ValueError with a clear message if invalid.\n        \"\"\"\n        input_obj = Input(n)\n        if not input_obj.is_valid():\n            raise ValueError(\"n must be an integer >= 1\")\n\n    def compute_formula(self, n) -> int:\n        \"\"\"\n        Computes and returns n*(n+1)*(n+2)//6 using integer arithmetic.\n        Ensures exactness and O(1) time/memory.\n        \"\"\"\n        return n * (n + 1) * (n + 2) // 6\n\n```"}
{"task_id": "Mbpp/84", "solution": "```python\n# newman_conway/__init__.py\n\"\"\"\nNewman\u2013Conway sequence package.\nExposes the public function `sequence` to compute terms.\n\"\"\"\nfrom .sequence import sequence\n\n# newman_conway/cache_entry.py\nimport datetime\nfrom dataclasses import dataclass\n\n@dataclass\nclass CacheEntry:\n    \"\"\"\n    Represents a cached computed term with a timestamp.\n    Note: This dataclass is provided per design but NewmanConwaySequence\n    uses a simpler dict[int, int] for its primary cache for performance.\n    \"\"\"\n    n: int\n    value: int\n    computed_at: datetime.datetime\n\n# newman_conway/validator.py\n\"\"\"\nProvides a stateless utility for input validation.\n\"\"\"\nclass Validator:\n    \"\"\"\n    Handles input validation, ensuring n is a positive integer.\n    \"\"\"\n    def is_positive_integer(self, n) -> bool:\n        \"\"\"\n        Checks if the input n is an integer and is greater than or equal to 1.\n        \"\"\"\n        return isinstance(n, int) and n >= 1\n\n# newman_conway/newman_conway_sequence.py\nfrom typing import Dict\n\nclass NewmanConwaySequence:\n    \"\"\"\n    Computes the Newman\u2013Conway sequence terms using a recurrence relation\n    and an in-memory cache for efficiency.\n    \"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the cache with base cases a(1)=1 and a(2)=1.\"\"\"\n        self._cache: Dict[int, int] = {1: 1, 2: 1}\n\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Public method to get the nth Newman\u2013Conway term. Delegates to compute.\n        \"\"\"\n        return self.compute(n)\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Newman\u2013Conway term, using and updating the cache.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        # Recurrence: a(n) = a(a(n-1)) + a(n - a(n-1)) for n > 2\n        a_n_minus_1 = self.compute(n - 1)\n        left = self.compute(a_n_minus_1)\n        right = self.compute(n - a_n_minus_1)\n        \n        value = left + right\n        self._cache[n] = value\n        return value\n\n    def compute_recursive(self, n: int) -> int:\n        \"\"\"\n        Auxiliary method mirroring compute behavior for design parity.\n        \"\"\"\n        return self.compute(n)\n\n# newman_conway/sequence.py\n\"\"\"\nPublic API for computing the Newman\u2013Conway sequence.\n\"\"\"\nfrom .newman_conway_sequence import NewmanConwaySequence\nfrom .validator import Validator\nfrom typing import Optional\n\n# Module-level singleton instance of NewmanConwaySequence\n_DEFAULT_GENERATOR: Optional[NewmanConwaySequence] = None\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Computes the nth term of the Newman\u2013Conway sequence.\n    Validates input and raises exceptions for invalid 'n'.\n    \"\"\"\n    validator = Validator()\n\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not validator.is_positive_integer(n):\n        raise ValueError(\"n must be an integer >= 1.\")\n\n    global _DEFAULT_GENERATOR\n    if _DEFAULT_GENERATOR is None:\n        _DEFAULT_GENERATOR = NewmanConwaySequence()\n    \n    return _DEFAULT_GENERATOR.sequence(n)\n\n\n# tests/test_sequence.py\nimport unittest\nfrom newman_conway.sequence import sequence\n\nclass TestNewmanConwaySequence(unittest.TestCase):\n    \"\"\"\n    Tests for the Newman\u2013Conway sequence function.\n    \"\"\"\n\n    def test_base_cases(self):\n        \"\"\"Verify the first two terms of the sequence.\"\"\"\n        self.assertEqual(sequence(1), 1)\n        self.assertEqual(sequence(2), 1)\n\n    def test_sequence_example(self):\n        \"\"\"Verifies the example assertion sequence(10) == 6.\"\"\"\n        self.assertEqual(sequence(10), 6)\n        # Additional checks for other known values\n        self.assertEqual(sequence(3), 2)  # a(a(2)) + a(3-a(2)) = a(1) + a(2) = 1 + 1 = 2\n        self.assertEqual(sequence(4), 2)  # a(a(3)) + a(4-a(3)) = a(2) + a(2) = 1 + 1 = 2\n        self.assertEqual(sequence(5), 3)  # a(a(4)) + a(5-a(4)) = a(2) + a(3) = 1 + 2 = 3\n        self.assertEqual(sequence(6), 4)  # a(a(5)) + a(6-a(5)) = a(3) + a(3) = 2 + 2 = 4\n\n    def test_invalid_inputs_type(self):\n        \"\"\"Verifies TypeError is raised for non-integer inputs.\"\"\"\n        with self.assertRaises(TypeError):\n            sequence('a')\n        with self.assertRaises(TypeError):\n            sequence(1.5)\n        with self.assertRaises(TypeError):\n            sequence(None)\n\n    def test_invalid_inputs_value(self):\n        \"\"\"Verifies ValueError is raised for integers less than 1.\"\"\"\n        with self.assertRaises(ValueError):\n            sequence(0)\n        with self.assertRaises(ValueError):\n            sequence(-1)\n        with self.assertRaises(ValueError):\n            sequence(-100)\n\n```"}
