{"task_id": "Mbpp/730", "solution": "```python\nfrom typing import List, Any\n\nclass InputList:\n    def __init__(self, elements: List[Any]):\n        \"\"\"Initializes InputList with a list of elements.\"\"\"\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass Element:\n    def __init__(self, value: Any):\n        \"\"\"Initializes an Element with a value.\"\"\"\n        self.value = value\n\n    def equals(self, other: 'Element') -> bool:\n        \"\"\"Compares this element's value to another element's value.\"\"\"\n        return self.value == other.value\n\nclass OutputList:\n    def __init__(self, elements: List[Any]):\n        \"\"\"Initializes OutputList with a list of elements.\"\"\"\n        self.elements = elements\n\ndef consecutive_duplicates(input: 'InputList') -> 'OutputList':\n    \"\"\"Removes consecutive duplicate elements from an input list, preserving order.\"\"\"\n    # Internally wraps native Python lists to InputList for convenience as per design.\n    if not isinstance(input, InputList):\n        input_obj = InputList(input)\n    else:\n        input_obj = input\n\n    elements = input_obj.elements\n\n    if not elements:\n        return OutputList([])\n\n    output_list: List[Any] = [elements[0]]\n    previous_value = elements[0]\n\n    for i in range(1, len(elements)):\n        current_value = elements[i]\n        if current_value != previous_value:\n            output_list.append(current_value)\n            previous_value = current_value\n\n    return OutputList(elements=output_list)\n```"}
{"task_id": "Mbpp/731", "solution": "```python\nimport math\n\nclass Result:\n    \"\"\"Simple wrapper for a computed result value and an optional unit.\"\"\"\n    def __init__(self, value: float, unit: str = \"\") -> None:\n        self.value = value\n        self.unit = unit\n\nclass LateralSurfaceCalculator:\n    \"\"\"Stateless calculation utilities for slant height and lateral surface area.\"\"\"\n    def computeSlantHeight(self, r: float, h: float) -> float:\n        \"\"\"Computes the slant height l = sqrt(r^2 + h^2).\"\"\"\n        return math.sqrt(r*r + h*h)\n\n    def computeLateralSurface(self, r: float, l: float) -> float:\n        \"\"\"Computes the lateral surface area = pi * r * l.\"\"\"\n        return math.pi * r * l\n\nclass Cone:\n    \"\"\"Data holder for cone geometry (r, h, l) and convenience lateralArea() method.\"\"\"\n    def __init__(self, r: float, h: float) -> None:\n        self.r = r\n        self.h = h\n        calc = LateralSurfaceCalculator()\n        self.l = calc.computeSlantHeight(r, h)\n\n    def lateralArea(self) -> float:\n        \"\"\"Computes the lateral surface area of the cone.\"\"\"\n        calc = LateralSurfaceCalculator()\n        return calc.computeLateralSurface(self.r, self.l)\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Computes the lateral surface area of a cone given radius and height.\n    Orchestrates calculation using LateralSurfaceCalculator.\n    \"\"\"\n    calc = LateralSurfaceCalculator()\n    l = calc.computeSlantHeight(r, h)\n    area = calc.computeLateralSurface(r, l)\n    result = Result(area, unit=\"square_units\")\n    return result.value\n```"}
{"task_id": "Mbpp/730", "solution": "```python\nfrom typing import List, Any\n\ndef consecutive_duplicates(input_list: List[Any]) -> List[Any]:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order and retaining non-adjacent duplicates.\n    Equality is determined using the standard `==` operator.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result\n```"}
{"task_id": "Mbpp/731", "solution": "```python\nimport math\n\ndef lateralsurface_cone(r, h):\n    # Calculates the lateral surface area of a cone.\n    # It assumes valid numeric and non-negative inputs for r and h.\n    s = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * s\n    return lateral_area\n```"}
{"task_id": "Mbpp/732", "solution": "```python\nfrom typing import Set\n\nclass ReplacementRule:\n    \"\"\"Encapsulates target characters and the replacement character.\n    It maps individual characters based on the defined rule.\"\"\"\n    def __init__(self, targets: Set[str], replacement: str):\n        self.targets = targets\n        self.replacement = replacement\n\n    def apply(self, ch: str) -> str:\n        \"\"\"Applies the replacement rule to a single character.\"\"\"\n        return self.replacement if ch in self.targets else ch\n\nclass InputString:\n    \"\"\"Lightweight wrapper for an input string value.\n    Provides methods to access its properties.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"Lightweight wrapper for an output string value.\n    Primarily holds the processed string data.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass ReplaceSpecialChar:\n    \"\"\"Object facade for special character replacement.\n    Delegates the replacement logic to the module-level function.\"\"\"\n    def replace(self, input: str) -> str:\n        \"\"\"Performs special character replacement on the input string.\"\"\"\n        return replace_specialchar(input)\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"Public API: Replaces spaces, commas, and dots with colons.\n    Processes the input string character by character using a replacement rule.\"\"\"\n    \n    rule = ReplacementRule(targets={' ', ',', '.'}, replacement=':')\n    transformed_chars = []\n    input_obj = InputString(input)\n    \n    for char_index in range(input_obj.length()):\n        char = input_obj.value[char_index]\n        transformed_chars.append(rule.apply(char))\n    \n    output_value = \"\".join(transformed_chars)\n    output_obj = OutputString(output_value)\n    \n    return output_obj.value\n```"}
{"task_id": "Mbpp/733", "solution": "from typing import List\n\n# Internal helper function for iterative binary search.\n# This function finds the left-most occurrence of the target in a sorted array.\ndef _binary_search_first(array: List[int], target: int) -> int:\n    low, high = 0, len(array) - 1\n    ans = -1  # This variable stores the potential first occurrence index.\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target:\n            ans = mid\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence.\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return ans\n\n# Public function to find the 0-based index of the first occurrence of target.\n# It returns -1 if the target is absent or the input array is empty.\ndef find_first_occurrence(array: List[int], target: int) -> int:\n    if not array:\n        return -1\n    return _binary_search_first(array, target)"}
{"task_id": "Mbpp/733", "solution": "```python\n# project_root/src/sorted_array.py\nfrom typing import List, Union\n\nNumber = Union[int, float]\n\nclass SortedArray:\n    \"\"\"Domain container for non-decreasing list of numbers and simple accessors/validation.\"\"\"\n    def __init__(self, elements: List[Number]):\n        self._elements = elements\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if the stored elements are sorted in non-decreasing order.\"\"\"\n        for i in range(len(self._elements) - 1):\n            if self._elements[i] > self._elements[i+1]:\n                return False\n        return True\n\n    def get(self, index: int) -> Number:\n        \"\"\"Retrieves an element at the specified index.\"\"\"\n        return self._elements[index]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n```\n```python\n# project_root/src/target_value.py\nfrom typing import Union\n\nNumber = Union[int, float]\n\nclass TargetValue:\n    \"\"\"Domain container for a numeric target value.\"\"\"\n    def __init__(self, value: Number):\n        self._value = value\n\n    def value(self) -> Number:\n        \"\"\"Returns the stored target value.\"\"\"\n        return self._value\n\n```\n```python\n# project_root/src/search_result.py\nclass SearchResult:\n    \"\"\"Encapsulates the outcome of a search, including the index and whether found.\"\"\"\n    def __init__(self, index: int):\n        self._index = index\n\n    def found(self) -> bool:\n        \"\"\"Returns True if the target was found, False otherwise.\"\"\"\n        return self._index != -1\n\n    def index(self) -> int:\n        \"\"\"Returns the zero-based index of the found target, or -1 if not found.\"\"\"\n        return self._index\n\n```\n```python\n# project_root/src/find_first_occurrence.py\nfrom typing import List, Union\nfrom src.sorted_array import SortedArray, Number\nfrom src.target_value import TargetValue\nfrom src.search_result import SearchResult\n\ndef find_first_occurrence(array: List[Number], target: Number) -> int:\n    \"\"\"\n    Finds the zero-based index of the first occurrence of a target in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result_index = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else: # array[mid] > target\n            high = mid - 1\n            \n    return result_index\n\ndef find_first_occurrence_with_domain(sorted_array: SortedArray, target_value: TargetValue) -> SearchResult:\n    \"\"\"\n    Adapter function that uses domain objects to find the first occurrence.\n    Returns a SearchResult encapsulating the outcome.\n    \"\"\"\n    array_elements = [sorted_array.get(i) for i in range(sorted_array.length())]\n    target = target_value.value()\n    index = find_first_occurrence(array_elements, target)\n    return SearchResult(index)\n\n```\n```python\n# project_root/src/test_case.py\nfrom typing import List\nfrom src.sorted_array import SortedArray, Number\nfrom src.target_value import TargetValue\nfrom src.search_result import SearchResult\nfrom src.find_first_occurrence import find_first_occurrence_with_domain\n\nclass TestCase:\n    \"\"\"\n    Packages test inputs (array, target) and expected index; provides a run() method for verification.\n    \"\"\"\n    def __init__(self, input_array_list: List[Number], target_val: Number, expected_idx: int):\n        self.inputArray = SortedArray(input_array_list)\n        self.target = TargetValue(target_val)\n        self.expectedIndex = expected_idx\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the search using packaged inputs and compares the result to the expected index.\n        Returns True if the actual result matches the expected, False otherwise.\n        \"\"\"\n        search_result = find_first_occurrence_with_domain(self.inputArray, self.target)\n        return search_result.index() == self.expectedIndex\n\n```\n```python\n# project_root/src/main.py\nfrom src.find_first_occurrence import find_first_occurrence\nfrom src.test_case import TestCase\n\ndef main() -> None:\n    \"\"\"\n    Demonstration entry point that calls the public API and runs the FR-5 verification assertion.\n    \"\"\"\n    print(\"Running FR-5 verification via direct API call...\")\n    array = [2, 5, 5, 5, 6, 6, 8, 9, 9, 9]\n    target = 5\n    result = find_first_occurrence(array, target)\n    assert result == 1, f\"FR-5 verification failed: Expected 1, got {result}\"\n    print(f\"FR-5 verification passed: find_first_occurrence({array}, {target}) == {result}\")\n\n    print(\"\\nRunning FR-5 verification via TestCase...\")\n    test_case = TestCase(array, target, 1)\n    test_passed = test_case.run()\n    assert test_passed, \"FR-5 verification via TestCase failed.\"\n    print(\"FR-5 verification via TestCase passed.\")\n\nif __name__ == \"__main__\":\n    main()\n\n```"}
{"task_id": "Mbpp/734", "solution": "```python\n# sum_of_subarray_prod_project/src/__init__.py\n\"\"\"\nPackage marker for the src directory.\nAllows Python to recognize 'src' as a package.\n\"\"\"\n```\n```python\n# sum_of_subarray_prod_project/src/sum_of_subarray_prod.py\n\nfrom typing import List, Iterator, Union\n\nNumber = Union[int, float]\n\nclass ListInput:\n    \"\"\"\n    Holds input values and provides a generator for all contiguous subarrays.\n    It iterates through all possible start and end indices to create subarrays.\n    \"\"\"\n    def __init__(self, values: List[Number]) -> None:\n        self.values = values\n        self.length = len(values)\n\n    def generate_subarrays(self) -> Iterator['Subarray']:\n        \"\"\"\n        Generates Subarray instances for all contiguous subarrays of the input list.\n        Yields each subarray with its start index, end index, and elements.\n        \"\"\"\n        for start_index in range(self.length):\n            for end_index in range(start_index, self.length):\n                elements = self.values[start_index : end_index + 1]\n                yield Subarray(start_index, end_index, elements)\n\n\nclass Subarray:\n    \"\"\"\n    Represents a contiguous slice of the original list.\n    It can compute the product of its own elements.\n    \"\"\"\n    def __init__(self, startIndex: int, endIndex: int, elements: List[Number]) -> None:\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.elements = elements\n\n    def product(self) -> Number:\n        \"\"\"\n        Computes the product of all elements within this subarray.\n        Returns 1 for an empty subarray, consistent with multiplicative identity.\n        \"\"\"\n        if not self.elements:\n            return 1\n        \n        current_product: Number = 1\n        for element in self.elements:\n            current_product *= element\n        return current_product\n\n\nclass ProductComputation:\n    \"\"\"\n    Stateless utility to compute the numeric product of a Subarray.\n    It delegates the actual product calculation to the Subarray itself.\n    \"\"\"\n    def compute_product(self, subarray: Subarray) -> Number:\n        \"\"\"\n        Calculates the product of elements for a given subarray.\n        This method simply calls the subarray's product() method.\n        \"\"\"\n        return subarray.product()\n\n\nclass SumAccumulator:\n    \"\"\"\n    Accumulates numeric totals and provides the final sum.\n    It maintains a running total that can be updated with new values.\n    \"\"\"\n    def __init__(self) -> None:\n        self.total: Number = 0\n\n    def add(self, value: Number) -> None:\n        \"\"\"\n        Adds a numeric value to the current running total.\n        This updates the internal total field.\n        \"\"\"\n        self.total += value\n\n    def result(self) -> Number:\n        \"\"\"\n        Returns the final accumulated numeric total.\n        This represents the sum of all values added.\n        \"\"\"\n        return self.total\n\n\ndef sum_Of_Subarray_Prod(values: List[Number]) -> Number:\n    \"\"\"\n    Computes the sum of products of all contiguous subarrays in the input list.\n    It orchestrates domain classes for subarray generation, product calculation, and sum accumulation.\n    \"\"\"\n    list_input = ListInput(values)\n    accumulator = SumAccumulator()\n    prod_calc = ProductComputation()\n\n    for sub in list_input.generate_subarrays():\n        p = prod_calc.compute_product(sub)\n        accumulator.add(p)\n\n    return accumulator.result()\n```\n```python\n# sum_of_subarray_prod_project/tests/test_sum_of_subarray_prod.py\nimport pytest\nfrom src.sum_of_subarray_prod import sum_Of_Subarray_Prod\n\ndef test_sum_of_subarray_prod_example():\n    \"\"\"\n    Unit test to verify the sum of products for the example list [1,2,3].\n    This asserts the expected total of 20 for the given input.\n    \"\"\"\n    assert sum_Of_Subarray_Prod([1,2,3]) == 20\n\ndef test_sum_of_subarray_prod_single_element():\n    \"\"\"Test with a single element list.\"\"\"\n    assert sum_Of_Subarray_Prod([5]) == 5\n\ndef test_sum_of_subarray_prod_empty_list():\n    \"\"\"Test with an empty list, expecting 0.\"\"\"\n    assert sum_Of_Subarray_Prod([]) == 0\n\ndef test_sum_of_subarray_prod_multiple_elements():\n    \"\"\"Test with a list having multiple elements and more complex products.\"\"\"\n    # Subarrays and products:\n    # [1] -> 1\n    # [2] -> 2\n    # [3] -> 3\n    # [4] -> 4\n    # [1,2] -> 2\n    # [2,3] -> 6\n    # [3,4] -> 12\n    # [1,2,3] -> 6\n    # [2,3,4] -> 24\n    # [1,2,3,4] -> 24\n    # Sum: 1+2+3+4 + 2+6+12 + 6+24 + 24 = 84\n    assert sum_Of_Subarray_Prod([1,2,3,4]) == 84\n\ndef test_sum_of_subarray_prod_with_zeros():\n    \"\"\"Test case including zero elements.\"\"\"\n    # Subarrays and products:\n    # [1] -> 1\n    # [0] -> 0\n    # [2] -> 2\n    # [1,0] -> 0\n    # [0,2] -> 0\n    # [1,0,2] -> 0\n    # Sum: 1 + 0 + 2 + 0 + 0 + 0 = 3\n    assert sum_Of_Subarray_Prod([1,0,2]) == 3\n\ndef test_sum_of_subarray_prod_with_negative_numbers():\n    \"\"\"Test with negative numbers.\"\"\"\n    # Subarrays and products:\n    # [-1] -> -1\n    # [2]  -> 2\n    # [-1,2] -> -2\n    # Sum: -1 + 2 + -2 = -1\n    assert sum_Of_Subarray_Prod([-1,2]) == -1\n```"}
{"task_id": "Mbpp/735", "solution": "```python\n# src/__init__.py\n# Purpose: Package initializer for src; enables import as a package.\n# Contains: (none; module-level package marker)\n\n\n# src/integer_value.py\nclass IntegerValue:\n    \"\"\"Encapsulates integer introspection utilities (bit_length and to_binary) per minimal binary representation.\n    Provides bit-length and binary string conversion for an integer value.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def bit_length(self) -> int:\n        \"\"\"Return bit-length of minimal binary representation.\n        A value of 0 returns a bit-length of 1.\n        \"\"\"\n        if self.value == 0:\n            return 1\n        return self.value.bit_length()\n\n    def to_binary(self) -> str:\n        \"\"\"Return minimal binary string (no leading zeros).\"\"\"\n        return format(self.value, 'b')\n\n\n# src/bit_mask.py\nclass BitMask:\n    \"\"\"Implements mask creation utilities for bit toggling operations.\n    Creates full masks and specific middle-bit masks.\n    \"\"\"\n    mask: int = 0\n\n    def create_mask(self, length: int) -> int:\n        \"\"\"Return mask with 'length' low-order bits set.\n        Returns 0 if length is not positive.\n        \"\"\"\n        return (1 << length) - 1 if length > 0 else 0\n\n    def create_middle_mask(self, length: int) -> int:\n        \"\"\"Return mask with ones in middle positions [1..length-2].\n        Excludes MSB (position length-1) and LSB (position 0).\n        \"\"\"\n        if length <= 2:\n            return 0\n        # middle bits occupy positions [1 .. length-2]\n        middle_length = length - 2\n        return ((1 << middle_length) - 1) << 1\n\n\n# src/bit_manipulator.py\nfrom src.integer_value import IntegerValue\nfrom src.bit_mask import BitMask\n\nclass BitManipulator:\n    \"\"\"Carries out the core bit toggling operation.\n    It uses IntegerValue and BitMask to implement the logic for FR2 and BR-1..BR-6.\n    \"\"\"\n    def toggle_middle_bits(self, n: int) -> int:\n        \"\"\"If bit-length <= 2 return n; otherwise generate middle-bit mask and return n ^ mask.\"\"\"\n        iv = IntegerValue(n)\n        length = iv.bit_length()\n        if length <= 2:\n            return n\n        mask = BitMask().create_middle_mask(length)\n        return n ^ mask\n\n\n# src/toggle_middle_bits.py\nfrom src.bit_manipulator import BitManipulator\n\ndef toggle_middle_bits(n):\n    \"\"\"Public API for FR1. Returns int result after toggling middle bits of n.\n    Signature required by SRS: toggle_middle_bits(n)\n    \"\"\"\n    return BitManipulator().toggle_middle_bits(n)\n\n\n# tests/test_toggle_middle_bits.py\nfrom src.toggle_middle_bits import toggle_middle_bits\n\nclass TestCase:\n    \"\"\"Represents a unit test for the toggle_middle_bits function.\n    Executes the function with a given input and compares it to an expected value.\n    \"\"\"\n    def __init__(self, input: int, expected: int):\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Execute toggle_middle_bits(self.input) and compare to self.expected.\"\"\"\n        return toggle_middle_bits(self.input) == self.expected\n\n# FR3 validation (executable assertion)\nif __name__ == '__main__':\n    assert toggle_middle_bits(9) == 15\n\n```"}
{"task_id": "Mbpp/734", "solution": "```python\n# src/sum_of_subarray_prod.py\n\nfrom typing import List, Union\n\nNumber = Union[int, float]\n\nclass InputList:\n    \"\"\"Represents and validates the raw input list of numeric values.\"\"\"\n    def __init__(self, numbers: List[Number]) -> None:\n        self.numbers = numbers\n\n    def validate(self) -> bool:\n        \"\"\"Verifies input is a list/tuple of numbers, raising TypeError if invalid.\"\"\"\n        if not isinstance(self.numbers, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple.\")\n        for element in self.numbers:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in the input list must be numbers (int or float).\")\n        return True\n\nclass Subarray:\n    \"\"\"Represents a contiguous non-empty slice and computes its product.\"\"\"\n    def __init__(self, elements: List[Number]) -> None:\n        self.elements = elements\n\n    def product(self) -> Number:\n        \"\"\"Returns the multiplicative product of the subarray's elements.\"\"\"\n        prod = 1.0\n        for element in self.elements:\n            prod *= element\n        return prod\n\nclass Result:\n    \"\"\"Simple container for the computed numeric result.\"\"\"\n    def __init__(self, value: Number) -> None:\n        self.value = value\n\nclass ProductCalculator:\n    \"\"\"Enumerates contiguous subarrays, computes each product, and sums them.\"\"\"\n    def compute_sum_of_products(self, input: InputList) -> Number:\n        \"\"\"Computes the sum of products of all contiguous non-empty subarrays.\"\"\"\n        total_sum = 0.0\n        numbers = input.numbers\n        n = len(numbers)\n\n        for i in range(n):\n            for j in range(i, n):\n                current_subarray_elements = numbers[i : j + 1]\n                subarray = Subarray(current_subarray_elements)\n                total_sum += subarray.product()\n        \n        # As per design, ProductCalculator produces a Result and returns its value.\n        return Result(total_sum).value\n\ndef sum_Of_Subarray_Prod(input_list) -> Number:\n    \"\"\"\n    Public API to compute the sum of products of all contiguous non-empty subarrays.\n    It validates input and delegates computation to ProductCalculator.\n    \"\"\"\n    input_obj = InputList(input_list)\n    input_obj.validate()  # Raises TypeError if input is invalid.\n\n    calculator = ProductCalculator()\n    return calculator.compute_sum_of_products(input_obj)\n\n```\n```python\n# tests/test_sum_of_subarray_prod.py\n\nfrom src.sum_of_subarray_prod import sum_Of_Subarray_Prod\n\nassert sum_Of_Subarray_Prod([1,2,3]) == 20\n```"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence, value) -> int:\n    \"\"\"Return smallest index i (0 <= i <= len(sequence)) such that inserting value at i preserves non-decreasing order.\n    This function uses a binary search algorithm to find the insertion point.\"\"\"\n    low = 0\n    high = len(sequence)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sequence[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles every bit of an integer's binary representation except the MSB and LSB.\n    If the number has fewer than three bits, it is returned unchanged.\"\"\"\n    bit_length = n.bit_length()\n\n    if bit_length < 3:\n        return n\n\n    # Compute a mask with 1s in all middle bit positions (positions 1 to bit_length-2),\n    # and 0s for the MSB (position bit_length-1) and LSB (position 0).\n    middle_bits_count = bit_length - 2\n    mask = ((1 << middle_bits_count) - 1) << 1\n\n    # XOR n with the mask to toggle only the middle bits.\n    return n ^ mask\n```"}
