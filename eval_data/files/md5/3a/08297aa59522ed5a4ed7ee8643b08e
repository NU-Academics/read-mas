{"task_id": "Mbpp/92", "solution": "```python\ndef is_undulating(n):\n    # Determines if an integer's digits alternate between exactly two distinct values.\n    # Operates on the absolute value, returning False for numbers with fewer than two digits.\n\n    num = abs(n)\n\n    # Calculate digit count arithmetically as per O(1) memory constraint.\n    temp_num_for_count = num\n    digit_count = 0\n    if temp_num_for_count == 0:\n        digit_count = 1\n    else:\n        while temp_num_for_count > 0:\n            temp_num_for_count //= 10\n            digit_count += 1\n\n    # Return False for numbers with fewer than two digits.\n    if digit_count < 2:\n        return False\n\n    first_digit = -1\n    second_digit = -1\n    prev_digit = -1\n    \n    # Iterate through digits from least significant to most significant for single-pass check.\n    current_index = 0 # 0-indexed position from right\n    temp_num_for_check = num\n\n    while temp_num_for_check > 0:\n        current_digit = temp_num_for_check % 10\n        \n        if current_index == 0:\n            first_digit = current_digit\n            prev_digit = current_digit\n        elif current_index == 1:\n            if current_digit == first_digit:\n                return False # The two alternating digits must be distinct.\n            second_digit = current_digit\n            prev_digit = current_digit\n        else:\n            # For subsequent digits, check if they follow the established alternation pattern.\n            if current_index % 2 == 0: # Digits at odd positions (1st, 3rd, ...) from right should match first_digit.\n                if current_digit != first_digit:\n                    return False\n            else: # Digits at even positions (2nd, 4th, ...) from right should match second_digit.\n                if current_digit != second_digit:\n                    return False\n            \n            if current_digit == prev_digit: # Ensures strict alternation (e.g., prevents 1211).\n                return False\n            \n            prev_digit = current_digit\n            \n        temp_num_for_check //= 10\n        current_index += 1\n\n    return True\n```"}
{"task_id": "Mbpp/94", "solution": "```python\n# src/domain.py\nfrom typing import Any, List, Tuple, Union, Iterable\n\nclass TupleItem:\n    \"\"\"Represents a two-item tuple with named fields.\n    Provides a method to convert back to a standard tuple.\n    \"\"\"\n    def __init__(self, first_value: Any, second_value: Any):\n        self.first_value = first_value\n        self.second_value = second_value\n\n    def as_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"Returns the item as a standard two-item tuple.\"\"\"\n        return (self.first_value, self.second_value)\n\nclass TupleList:\n    \"\"\"A sequence wrapper for TupleItem instances or plain 2-tuples.\n    Provides basic sequence protocol methods.\n    \"\"\"\n    def __init__(self, items: Union[Iterable[Tuple[Any, Any]], Iterable[TupleItem]] = None):\n        self.items: List[Union[Tuple[Any, Any], TupleItem]] = list(items) if items is not None else []\n\n    def __iter__(self):\n        \"\"\"Allows iteration over the contained items.\"\"\"\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\n    def append(self, item: Union[Tuple[Any, Any], TupleItem]):\n        \"\"\"Adds an item to the list.\"\"\"\n        self.items.append(item)\n\n```\n```python\n# src/index_minimum.py\nfrom typing import Any, Sequence, Tuple\n\ndef index_minimum(tuple_list: Sequence[Tuple[Any, Any]]) -> Any:\n    \"\"\"Returns the first value of the tuple with the smallest second value.\n    Assumes the input is a sequence of plain two-item tuples.\n    \"\"\"\n    if not tuple_list:\n        return None\n\n    # Finds the tuple with the smallest second value using natural ordering.\n    min_tuple = min(tuple_list, key=lambda item: item[1])\n\n    # Returns the first value of the identified tuple.\n    return min_tuple[0]\n\n```\n```python\n# src/__init__.py\nfrom .index_minimum import index_minimum\n\n```\n```python\n# tests/test_index_minimum.py\nfrom src.index_minimum import index_minimum\n\ndef test_index_minimum_example():\n    \"\"\"Unit test for the SRS example.\n    Asserts the specified input produces the expected output.\n    \"\"\"\n    assert index_minimum([('Rash', 143), ('Manjeet', 200), ('Varsha', 100)]) == 'Varsha'\n\n```"}
