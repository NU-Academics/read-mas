src.find_sum import find_sum\n    assert find_sum([1,2,3,1,1,4,5,6]) == 21\n\ndef test_empty_list():\n    \"\"\"Verifies the empty list boundary condition from FR4.\"\"\"\n    from src.find_sum import find_sum\n    assert find_sum([]) == 0\n```"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive identical elements from a list into sublists.\n    Returns a new list of lists, preserving order and not modifying the input.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[-1]:\n            current_group.append(input_list[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [input_list[i]]\n\n    packed_list.append(current_group)\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "```python\n# src/domain.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputTuple:\n    \"\"\"Represents a 2-element input tuple (a, b).\"\"\"\n    a: int\n    b: int\n\n@dataclass\nclass OutputTuple:\n    \"\"\"Represents a 2-element output tuple, resulting from a sum.\"\"\"\n    a: int\n    b: int\n\n@dataclass\nclass Pair:\n    \"\"\"Holds two InputTuple references and provides a method to compute their element-wise sum.\"\"\"\n    t1: InputTuple\n    t2: InputTuple\n\n    def compute_sum(self) -> OutputTuple:\n        \"\"\"Returns an OutputTuple with the element-wise sum of the two stored InputTuples.\"\"\"\n        return OutputTuple(a=self.t1.a + self.t2.a, b=self.t1.b + self.t2.b)\n\n```\n```python\n# src/find_combinations_service.py\nfrom typing import List, Tuple\nfrom src.domain import Pair, InputTuple, OutputTuple\n\nclass FindCombinationsService:\n    \"\"\"Orchestrates input validation, deterministic pair generation, and element-wise summation.\"\"\"\n\n    def find_combinations(self, inputs: List[Tuple[int,int]]) -> List[Tuple[int,int]]:\n        \"\"\"Validates inputs, generates pairs in deterministic order, computes sums, and returns results.\"\"\"\n        self.validate_input(inputs)\n\n        if len(inputs) < 2:\n            return []\n\n        pairs = self.generate_pairs(inputs)\n        results = []\n        for pair in pairs:\n            output_tuple = pair.compute_sum()\n            results.append((output_tuple.a, output_tuple.b))\n        return results\n\n    def validate_input(self, inputs: List[Tuple[int,int]]) -> None:\n        \"\"\"Raises ValueError if any input element does not conform to a 2-element integer tuple.\"\"\"\n        if not isinstance(inputs, list):\n            raise ValueError(\"Input must be a list.\")\n\n        for i, item in enumerate(inputs):\n            if not isinstance(item, tuple):\n                raise ValueError(f\"Element at index {i} is not a tuple: {item}\")\n            if len(item) != 2:\n                raise ValueError(f\"Tuple at index {i} does not have exactly 2 elements: {item}\")\n            if not all(isinstance(x, int) for x in item):\n                raise ValueError(f\"Elements in tuple at index {i} are not integers: {item}\")\n\n    def generate_pairs(self, inputs: List[Tuple[int,int]]) -> List[Pair]:\n        \"\"\"Returns a list of Pair objects in deterministic nested-loop order (i=0..n-2, j=i+1..n-1).\"\"\"\n        input_tuples = [InputTuple(a, b) for a, b in inputs]\n        n = len(input_tuples)\n        pairs_list = []\n\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                pairs_list.append(Pair(input_tuples[i], input_tuples[j]))\n        return pairs_list\n\n```\n```python\n# src/find_combinations.py\nfrom typing import List, Tuple\nfrom src.find_combinations_service import FindCombinationsService\n\ndef find_combinations(inputs: List[Tuple[int,int]]) -> List[Tuple[int,int]]:\n    \"\"\"Public API function required by SRS, delegating to FindCombinationsService for core logic.\"\"\"\n    return FindCombinationsService().find_combinations(inputs)\n\n```"}
{"task_id": "Mbpp/780", "solution": "import numbers\nfrom typing import Sequence, Tuple, List, Iterator\n\ndef _enumerate_pairs(n: int) -> Iterator[Tuple[int, int]]:\n    \"\"\"Yields all unique unordered pairs of indices (i, j) where i < j.\n    The pairs are yielded in deterministic order (i ascending, then j ascending).\n    \"\"\"\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            yield i, j\n\ndef find_combinations(input_list: Sequence[Tuple[numbers.Number, numbers.Number]]) -> List[Tuple[numbers.Number, numbers.Number]]:\n    \"\"\"Computes element-wise sums for every unique unordered pair of tuples in the input list.\n    Returns a new list of 2-element numeric tuples, preserving input immutability and numeric types.\n    \"\"\"\n    n = len(input_list)\n    output_list: List[Tuple[numbers.Number, numbers.Number]] = []\n\n    if n < 2:\n        return output_list\n\n    for i, j in _enumerate_pairs(n):\n        tuple_i = input_list[i]\n        tuple_j = input_list[j]\n        \n        first_sum = tuple_i[0] + tuple_j[0]\n        second_sum = tuple_i[1] + tuple_j[1]\n        \n        output_list.append((first_sum, second_sum))\n        \n    return output_list"}
{"task_id": "Mbpp/781", "solution": "```python\n# src/count_divisors.py\n\ndef _compute_positive_divisors(n: int) -> list[int]:\n    \"\"\"Return list of positive divisors d of n where n % d == 0.\"\"\"\n    divisors = []\n    for i in range(1, n + 1):\n        if n % i == 0:\n            divisors.append(i)\n    return divisors\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Return True when the number of positive divisors of n is even, otherwise False.\"\"\"\n    divisors = _compute_positive_divisors(n)\n    return len(divisors) % 2 == 0\n```\n```python\n# tests/test_count_divisors.py\n\nfrom src.count_divisors import count_divisors\n\nassert count_divisors(10)\n```"}
{"task_id": "Mbpp/782", "solution": "```python\nfrom typing import List, Iterator\n\ndef _odd_length_subarrays(values: List[int]) -> Iterator[List[int]]:\n    \"\"\"Yield each odd-length contiguous subarray of values.\n    It iterates through all possible start and end indices to find subarrays.\n    \"\"\"\n    n = len(values)\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate subarray length (j - i + 1)\n            if (j - i + 1) % 2 == 1:\n                yield values[i : j + 1]\n\ndef odd_length_sum(values: List[int]) -> int:\n    \"\"\"Return integer sum of all odd-length contiguous subarrays of values.\n    It aggregates the sums from an internal generator that yields odd-length subarrays.\n    \"\"\"\n    total_sum = 0\n    for subarray in _odd_length_subarrays(values):\n        total_sum += sum(subarray)\n    return total_sum\n```"}
{"task_id": "Mbpp/781", "solution": "```python\n# count_divisors.py\nimport math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Computes the number of positive divisors for n and returns True if the count is even, False otherwise.\n    Raises ValueError for non-positive inputs as per design.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    count = 0\n    # Iterate up to the square root of n to find divisors efficiently.\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            count += 1 # i is a divisor\n            if i * i != n:\n                count += 1 # n/i is another unique divisor\n    \n    return count % 2 == 0\n\n__all__ = [\"count_divisors\"]\n```\n```python\n# test_count_divisors.py\nfrom count_divisors import count_divisors\n\ndef run_acceptance_test():\n    \"\"\"\n    Executes the specified acceptance test for the count_divisors function.\n    Prints status and raises AssertionError if the test fails.\n    \"\"\"\n    print(\"Running acceptance test: assert count_divisors(10)\")\n    assert count_divisors(10), \"Acceptance test failed: count_divisors(10) should return True\"\n    print(\"Acceptance test passed successfully.\")\n\nif __name__ == \"__main__\":\n    run_acceptance_test()\n```"}
{"task_id": "Mbpp/782", "solution": "```python\n# src/odd_length_sum.py\nfrom typing import List\n\nclass InputList:\n    \"\"\"Represents the input list and provides validation logic.\"\"\"\n    def __init__(self, items: List):\n        self.items: List = items\n        self.length: int = len(items)\n\n    def validate(self) -> bool:\n        \"\"\"Return True if items is a list and all elements are ints; False otherwise.\"\"\"\n        if not isinstance(self.items, list):\n            return False\n        for item in self.items:\n            if not isinstance(item, int):\n                return False\n        return True\n\nclass Subarray:\n    \"\"\"Represents a contiguous subsequence and computes its sum.\"\"\"\n    def __init__(self, items: List[int], start_index: int, end_index: int):\n        self.items: List[int] = items\n        self.start_index: int = start_index\n        self.end_index: int = end_index\n        self.length: int = end_index - start_index + 1\n\n    def sum(self) -> int:\n        \"\"\"Return sum(self.items[self.start_index:self.end_index+1]).\"\"\"\n        return sum(self.items[self.start_index : self.end_index + 1])\n\nclass OddLengthSum:\n    \"\"\"Computes aggregated total of odd-length contiguous subarrays for a validated InputList.\"\"\"\n    def compute(self, input_list: InputList) -> int:\n        \"\"\"Compute and return aggregated sum of all odd-length contiguous subarrays of input_list.\"\"\"\n        total_sum = 0\n        n = input_list.length\n        for start_index in range(n):\n            for end_index in range(start_index, n):\n                length = end_index - start_index + 1\n                if length % 2 != 0:\n                    subarray = Subarray(input_list.items, start_index, end_index)\n                    total_sum += subarray.sum()\n        return total_sum\n\ndef odd_length_sum(items: List) -> int:\n    \"\"\"\n    Public API. Accepts items (list of int). Returns int aggregate sum of odd-length contiguous subarrays.\n    Raises TypeError on invalid input.\n    \"\"\"\n    input_list = InputList(items)\n    if not input_list.validate():\n        raise TypeError(\"items must be a list of integers\")\n\n    if input_list.length == 0:\n        return 0\n\n    calculator = OddLengthSum()\n    total_sum_result = calculator.compute(input_list)\n    return total_sum_result\n```\n```python\n# tests/test_odd_length_sum.py\nfrom src.odd_length_sum import odd_length_sum\n\ndef test_example():\n    \"\"\"Verify the acceptance test case.\"\"\"\n    assert odd_length_sum([1,2,4]) == 14\n```"}
{"task_id": "Mbpp/784", "solution": "```python\nfrom typing import List, Optional\n\nclass Number:\n    \"\"\"Represents an integer value and provides parity checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass InputList:\n    \"\"\"Encapsulates a list of integers to find first odd/even numbers.\"\"\"\n    def __init__(self, items: List[int]):\n        self.items = items\n\n    def get_first_odd(self) -> Optional[int]:\n        \"\"\"Scans left-to-right for the first odd number.\"\"\"\n        for item in self.items:\n            number = Number(item)\n            if number.is_odd():\n                return item\n        return None\n\n    def get_first_even(self) -> Optional[int]:\n        \"\"\"Scans left-to-right for the first even number.\"\"\"\n        for item in self.items:\n            number = Number(item)\n            if number.is_even():\n                return item\n        return None\n\nclass Result:\n    \"\"\"Represents the computed product of first odd and even numbers.\"\"\"\n    def __init__(self, product: int):\n        self.product = product\n\nclass MulEvenOdd:\n    \"\"\"Encapsulates the algorithm to find and multiply the first odd and even numbers.\"\"\"\n    def mul_even_odd(self, items: List[int]) -> Optional[int]:\n        \"\"\"Finds the first odd and even numbers and returns their product.\"\"\"\n        input_list = InputList(items)\n        first_odd = input_list.get_first_odd()\n        first_even = input_list.get_first_even()\n\n        if first_odd is not None and first_even is not None:\n            # Result class is used for internal representation as per design.\n            computed_result = Result(first_odd * first_even)\n            return computed_result.product\n        else:\n            return None\n\ndef mul_even_odd(items: List[int]) -> Optional[int]:\n    \"\"\"Public API entry point to find the product of the first odd and even numbers.\n    Returns the product or None if either is missing.\n    \"\"\"\n    processor = MulEvenOdd()\n    return processor.mul_even_odd(items)\n```"}
{"task_id": "Mbpp/784", "solution": "```python\n# ProjectRoot/src/mul_even_odd.py\nfrom dataclasses import dataclass\nfrom typing import List, Iterator\n\n@dataclass\nclass IntegerItem:\n    \"\"\"Encapsulates an integer value with parity checking methods.\"\"\"\n    value: int\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the item's value is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the item's value is even.\"\"\"\n        return self.value % 2 == 0\n\n@dataclass\nclass IntegerList:\n    \"\"\"A collection of integers that supports left-to-right iteration.\"\"\"\n    items: List[int]\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Iterates through the list items left-to-right.\"\"\"\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\n@dataclass\nclass Result:\n    \"\"\"A value object to hold the computed product.\"\"\"\n    product: int\n\ndef mul_even_odd(items: List[int]) -> int:\n    \"\"\"Scan left-to-right; return first_odd * first_even as int; raises ValueError if parity missing.\"\"\"\n    first_odd = None\n    first_even = None\n\n    integer_list = IntegerList(items)\n\n    for value in integer_list:\n        item = IntegerItem(value)\n        if first_odd is None and item.isOdd():\n            first_odd = value\n        if first_even is None and item.isEven():\n            first_even = value\n        \n        # Stop scanning once both required numbers are found.\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None or first_even is None:\n        raise ValueError(\"Input list must contain at least one odd and one even integer.\")\n\n    # Instantiate Result for traceability, then return its product.\n    result_obj = Result(product=first_odd * first_even)\n    return result_obj.product\n\nclass MulEvenOddFunction:\n    \"\"\"Thin wrapper class for domain-class traceability, delegating to the module function.\"\"\"\n    @classmethod\n    def mul_even_odd(cls, items: List[int]) -> int:\n        \"\"\"Delegates the call to the module-level mul_even_odd function.\"\"\"\n        return mul_even_odd(items)\n\n```\n```python\n# ProjectRoot/src/__init__.py\nfrom .mul_even_odd import mul_even_odd, MulEvenOddFunction, IntegerList, IntegerItem, Result\n\n__all__ = [\"mul_even_odd\", \"MulEvenOddFunction\", \"IntegerList\", \"IntegerItem\", \"Result\"]\n\n```\n```python\n# ProjectRoot/tests/test_mul_even_odd.py\nfrom src.mul_even_odd import mul_even_odd\nimport pytest\n\ndef test_acceptance_example():\n    \"\"\"Acceptance test verifying the product of the first odd and even numbers.\"\"\"\n    assert mul_even_odd([1, 3, 5, 7, 4, 1, 6, 8]) == 4\n\ndef test_missing_odd_raises_value_error():\n    \"\"\"Test for lists containing only even numbers, expecting ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"Input list must contain at least one odd and one even integer.\"):\n        mul_even_odd([2, 4, 6, 8])\n\ndef test_missing_even_raises_value_error():\n    \"\"\"Test for lists containing only odd numbers, expecting ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"Input list must contain at least one odd and one even integer.\"):\n        mul_even_odd([1, 3, 5, 7])\n\ndef test_empty_list_raises_value_error():\n    \"\"\"Test for an empty list, expecting ValueError as both parities are missing.\"\"\"\n    with pytest.raises(ValueError, match=\"Input list must contain at least one odd and one even integer.\"):\n        mul_even_odd([])\n\ndef test_list_with_zero():\n    \"\"\"Test including zero, which is considered an even number.\"\"\"\n    assert mul_even_odd([1, 0, 3, 2]) == 0 # First odd: 1, First even: 0 => 1*0=0\n    assert mul_even_odd([0, 1, 3, 2]) == 0 # First even: 0, First odd: 1 => 0*1=0\n\ndef test_list_with_negative_numbers():\n    \"\"\"Test cases involving negative numbers.\"\"\"\n    assert mul_even_odd([-1, -3, 2, -4]) == -2 # First odd: -1, First even: 2 => -1*2=-2\n    assert mul_even_odd([2, 4, -1, -3]) == -2 # First even: 2, First odd: -1 => 2*-1=-2\n```"}
{"task_id": "Mbpp/785", "solution": "```python\n# src/__init__.py\n\"\"\"Package initializer for the tuple parser module.\"\"\"\n\nfrom .tuple_parser import tuple_str_int\n\n__all__ = [\"tuple_str_int\"]\n\n# src/tuple_parser.py\nfrom typing import List, Tuple\n\nclass TupleString:\n    \"\"\"Encapsulates the raw input string for parsing.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\nclass IntegerTuple:\n    \"\"\"Holds the parsed integer tuple result.\"\"\"\n    def __init__(self, values: tuple) -> None:\n        self.values = values\n\n    def __repr__(self) -> str:\n        return f\"IntegerTuple({self.values})\"\n\nclass TupleParser:\n    \"\"\"Parses a tuple string into a tuple of integers.\"\"\"\n    def tuple_str_int(self, input: str) -> tuple:\n        \"\"\"Parses a parenthesized string of integers into a tuple of ints.\"\"\"\n        tuple_string = TupleString(input)\n        tokens = self.tokenize(tuple_string.raw)\n        int_list = self.to_ints(tokens)\n        integer_tuple_obj = IntegerTuple(tuple(int_list))\n        return integer_tuple_obj.values\n\n    def tokenize(self, raw: str) -> List[str]:\n        \"\"\"Extracts and cleans string tokens from the raw input.\"\"\"\n        # Strip overall whitespace and remove outer parentheses.\n        content = raw.strip()\n        content = content[1:-1]\n\n        # If content is empty or only whitespace after removing parentheses (e.g., \"()\" or \"( )\").\n        if not content.strip():\n            return []\n\n        # Split by comma and strip whitespace from each part.\n        parts = content.split(',')\n        stripped_tokens = [part.strip() for part in parts]\n        # Filter out any empty strings that might result from splitting/stripping.\n        return [token for token in stripped_tokens if token]\n\n    def to_ints(self, tokens: List[str]) -> List[int]:\n        \"\"\"Converts a list of string tokens to a list of integers.\"\"\"\n        return [int(token) for token in tokens]\n\ndef tuple_str_int(input: str) -> tuple:\n    \"\"\"\n    Parses a parenthesized, comma-separated string of integers into a tuple of ints.\n    Delegates parsing logic to TupleParser.\n    \"\"\"\n    return TupleParser().tuple_str_int(input)\n```"}
{"task_id": "Mbpp/785", "solution": "```python\nimport re\n\nclass TupleString:\n    \"\"\"Holds the raw input string value representing a tuple literal.\"\"\"\n    value: str\n\n    def __init__(self, value: str):\n        \"\"\"Initializes TupleString with the raw string value.\"\"\"\n        self.value = value\n\nclass IntegerTuple:\n    \"\"\"Holds the parsed integer sequence as an immutable tuple.\"\"\"\n    values: tuple[int, ...]\n\n    def __init__(self, values: tuple[int, ...]):\n        \"\"\"Initializes IntegerTuple with a tuple of integers.\"\"\"\n        self.values = values\n\nclass TupleParser:\n    \"\"\"\n    Validates and parses a tuple-formatted string into IntegerTuple.\n    Raises ValueError on invalid input.\n    \"\"\"\n\n    def tuple_str_int(self, input: str) -> IntegerTuple:\n        \"\"\"\n        Parses a tuple string into an IntegerTuple, handling format validation and tokenization.\n        \"\"\"\n        tuple_string = TupleString(input)\n\n        if not self.validateFormat(tuple_string.value):\n            raise ValueError(f\"Invalid tuple format: '{input}'\")\n\n        # Extract inner content, removing outer parentheses and stripping surrounding whitespace\n        inner_content = tuple_string.value.strip()\n        inner_content = inner_content[1:-1].strip()\n\n        parsed_ints = self.parseTokens(inner_content)\n        return IntegerTuple(tuple(parsed_ints))\n\n    def validateFormat(self, input: str) -> bool:\n        \"\"\"\n        Validates the overall canonical form: '(' ... ')' with comma-separated\n        integer tokens or empty, ignoring arbitrary whitespace.\n        \"\"\"\n        # Regex for canonical tuple string format, allowing for \"()\" and \"(1,2,3)\" and \"( 1 , -2 , 3 )\"\n        # It ensures the string starts with '(', ends with ')', and the content within\n        # is either empty or a sequence of integers separated by commas, with arbitrary whitespace allowed.\n        pattern = re.compile(r'^\\s*\\(\\s*(-?\\d+\\s*(?:,\\s*-?\\d+\\s*)*)?\\s*\\)\\s*$')\n        return bool(pattern.fullmatch(input))\n\n\n    def parseTokens(self, inner_content: str) -> list[int]:\n        \"\"\"\n        Tokenizes inner content, trims whitespace, converts tokens to int.\n        Raises ValueError on invalid tokens.\n        \"\"\"\n        if not inner_content: # Covers the empty tuple case like \"()\"\n            return []\n\n        # Split by comma with optional surrounding whitespace\n        tokens = re.split(r'\\s*,\\s*', inner_content)\n\n        parsed_values: list[int] = []\n        for token in tokens:\n            # Check if the token is a valid integer literal (optional leading '-')\n            if not re.fullmatch(r'-?\\d+', token):\n                raise ValueError(f\"Invalid integer token '{token}' in tuple content.\")\n            try:\n                parsed_values.append(int(token))\n            except ValueError:\n                raise ValueError(f\"Could not convert token '{token}' to integer.\")\n        return parsed_values\n\ndef tuple_str_int(input: str) -> tuple[int, ...]:\n    \"\"\"\n    Public API entrypoint: parses an input string in canonical tuple form\n    \"(n1, n2, ...)\" into a tuple of integers.\n    \"\"\"\n    parser = TupleParser()\n    integer_tuple = parser.tuple_str_int(input)\n    return integer_tuple.values\n```"}
