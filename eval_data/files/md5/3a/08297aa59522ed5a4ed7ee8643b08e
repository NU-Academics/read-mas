{"task_id": "Mbpp/453", "solution": "```python\n# src/sumofFactors.py\nimport math\nfrom typing import List\n\nclass IntegerInput:\n    \"\"\"Represents the input integer for factor computation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Factor:\n    \"\"\"Represents a single factor of an integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the factor's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass FactorSet:\n    \"\"\"Manages a set of factors for an integer.\"\"\"\n    def __init__(self):\n        self.factors: List[Factor] = []\n\n    def computeFactors(self, integer_input: IntegerInput) -> None:\n        \"\"\"Populates the factor set with all positive divisors of the input.\"\"\"\n        n = integer_input.value\n        found_factors = set()\n        for i in range(1, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                found_factors.add(i)\n                found_factors.add(n // i)\n        self.factors = [Factor(f) for f in sorted(list(found_factors))]\n\n    def filterEven(self) -> List[Factor]:\n        \"\"\"Returns a list of Factor instances that are even.\"\"\"\n        return [f for f in self.factors if f.isEven()]\n\nclass SumResult:\n    \"\"\"Holds the computed sum of factors.\"\"\"\n    def __init__(self, sum_value: int):\n        self.sum = sum_value\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Computes the sum of even positive divisors of an integer n.\n    Returns 0 if no even factors exist.\n    \"\"\"\n    integer_input = IntegerInput(n)\n    factor_set = FactorSet()\n    factor_set.computeFactors(integer_input)\n    even_factors = factor_set.filterEven()\n    total = sum(f.value for f in even_factors)\n    sum_result = SumResult(sum_value=total)\n    return sum_result.sum\n```\n```python\n# tests/test_sumofFactors.py\nfrom src.sumofFactors import sumofFactors\n\nassert sumofFactors(18) == 26\n```"}
{"task_id": "Mbpp/454", "solution": "class TextInput:\n    \"\"\"Holds the input string content and provides its length.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.content)\n\n\nclass Word:\n    \"\"\"Represents an alphabetic token parsed from the input.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def hasLowercaseZ(self) -> bool:\n        \"\"\"Checks if the word contains the lowercase character 'z'.\"\"\"\n        return 'z' in self.text\n\n\nclass MatchResult:\n    \"\"\"A data transfer object to hold the result of a match operation.\"\"\"\n    def __init__(self, contains_z_word: bool):\n        self.contains_z_word = contains_z_word\n\n\nclass TextMatcher:\n    \"\"\"Handles tokenization and 'z' detection logic.\"\"\"\n\n    @staticmethod\n    def parseWords(input_content: str) -> list[Word]:\n        \"\"\"Parses an input string into a list of Word objects, treating non-alphabetic chars as separators.\"\"\"\n        words = []\n        current_word_chars = []\n\n        for char in input_content:\n            if char.isalpha():\n                current_word_chars.append(char)\n            else:\n                if current_word_chars:\n                    words.append(Word(\"\".join(current_word_chars)))\n                    current_word_chars = []\n        if current_word_chars:\n            words.append(Word(\"\".join(current_word_chars)))\n        return words\n\n    @staticmethod\n    def wordContainsZ(w: Word) -> bool:\n        \"\"\"Determines if a given Word object contains the lowercase character 'z'.\"\"\"\n        return w.hasLowercaseZ()\n\n\ndef text_match_wordz(input: str) -> bool:\n    \"\"\"\n    Detects if an input string contains at least one alphabetic word\n    including the lowercase character 'z'.\n    \"\"\"\n    text_input_obj = TextInput(input)\n    words = TextMatcher.parseWords(text_input_obj.content)\n    \n    for word_obj in words:\n        if TextMatcher.wordContainsZ(word_obj):\n            return True\n            \n    return False"}
{"task_id": "Mbpp/453", "solution": "```python\nfrom dataclasses import dataclass\nimport math\n\n\n@dataclass\nclass NumberInput:\n    \"\"\"Traceability holder for the input integer.\"\"\"\n    value: int\n\n\n@dataclass\nclass Factor:\n    \"\"\"Represents a positive divisor and provides a parity check.\"\"\"\n    value: int\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the factor's value is even.\"\"\"\n        return self.value % 2 == 0\n\n\n@dataclass\nclass SumResult:\n    \"\"\"Represents the computed sum result.\"\"\"\n    value: int\n\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"Compute and return the sum of even positive divisors of n.\n\n    Precondition (recommended): n is an integer (recommended n >= 1).\n    Returns an int sum of even positive divisors; returns 0 when none exist.\n    \"\"\"\n    input_number_trace = NumberInput(value=n)  # For traceability\n\n    even_factors_sum = 0\n    found_factors = set()\n\n    # Optimized divisor enumeration up to sqrt(n)\n    for i in range(1, int(math.isqrt(input_number_trace.value)) + 1):\n        if input_number_trace.value % i == 0:\n            found_factors.add(i)\n            found_factors.add(input_number_trace.value // i)\n\n    # Filter for even factors and sum them\n    for d in found_factors:\n        factor_obj = Factor(value=d)  # For traceability and isEven check\n        if factor_obj.isEven():\n            even_factors_sum += factor_obj.value\n\n    sum_result_trace = SumResult(value=even_factors_sum)  # For traceability\n    return sum_result_trace.value\n```"}
{"task_id": "Mbpp/454", "solution": "```python\nimport re\nfrom typing import List, Optional\n\nclass Text:\n    \"\"\"Represents the input text content.\"\"\"\n    def __init__(self, content: str):\n        self.content: str = content\n\nclass Word:\n    \"\"\"Represents a single word token with its text and original indices.\"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int):\n        self.text: str = text\n        self.start_index: int = start_index\n        self.end_index: int = end_index\n\n    def containsZ(self) -> bool:\n        \"\"\"Checks if the word's text contains the lowercase character 'z'.\"\"\"\n        return 'z' in self.text\n\nclass MatchResult:\n    \"\"\"Represents the outcome of a text match operation.\"\"\"\n    def __init__(self, matched: bool, matched_word: Optional[Word] = None):\n        self.matched: bool = matched\n        self.matched_word: Optional[Word] = matched_word\n\nclass TextMatcher:\n    \"\"\"\n    Handles tokenization, punctuation stripping, and inspection for 'z'.\n    It orchestrates the matching process.\n    \"\"\"\n    def tokenize(self, text: str) -> List[Word]:\n        \"\"\"\n        Tokenizes the input text into words, stripping surrounding punctuation.\n        It computes start and end indices for each word.\n        \"\"\"\n        words: List[Word] = []\n        # Find sequences of word characters (alphanumeric + underscore),\n        # effectively stripping surrounding punctuation.\n        for match in re.finditer(r'\\w+', text):\n            words.append(Word(match.group(0), match.start(), match.end()))\n        return words\n\n    def wordContainsZ(self, word: Word) -> bool:\n        \"\"\"\n        Checks if a given Word object contains the lowercase character 'z'.\n        This method delegates to the Word's own containsZ method.\n        \"\"\"\n        return word.containsZ()\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"\n        The core logic to check if any word in the text contains 'z'.\n        It tokenizes the text and then inspects each token.\n        \"\"\"\n        words = self.tokenize(text)\n        for word in words:\n            if self.wordContainsZ(word):\n                return True\n        return False\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains at least one word with the lowercase 'z'.\n    This is the public API function, delegating to the TextMatcher.\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz(text)\n```"}
{"task_id": "Mbpp/455", "solution": "```python\n# src/month_checker/core.py\nfrom typing import Set\n\nclass MonthConstants:\n    \"\"\"Holds canonical set of months with 31 days.\"\"\"\n    monthsWith31Days: Set[int] = {1, 3, 5, 7, 8, 10, 12}\n\nclass Month:\n    \"\"\"Encapsulates a 1-based month number.\"\"\"\n    def __init__(self, number: int) -> None:\n        self.number = number\n\n    def isValid(self) -> bool:\n        \"\"\"Always returns True, as validation logic is omitted per critical requirements.\"\"\"\n        return True\n\n    def has31Days(self) -> bool:\n        \"\"\"Returns True iff the month corresponds to a month with 31 days.\"\"\"\n        return self.number in MonthConstants.monthsWith31Days\n\nclass MonthChecker:\n    \"\"\"Coordinates month validation and 31-day determination.\"\"\"\n    @staticmethod\n    def check_monthnumb_number(monthNumber: int) -> bool:\n        \"\"\"Determines if a month has 31 days, delegating to Month object.\"\"\"\n        month = Month(monthNumber)\n        # Validation via month.isValid() is implicitly passed; no error is raised due to critical requirements.\n        return month.has31Days()\n\ndef check_monthnumb_number(monthNumber: int) -> bool:\n    \"\"\"Return True iff monthNumber corresponds to a month with 31 days.\n    Input is trusted to be valid, as per critical requirements.\n    \"\"\"\n    return MonthChecker.check_monthnumb_number(monthNumber)\n```\n```python\n# src/month_checker/__init__.py\n\"\"\"Package entry point for month_checker.\"\"\"\nfrom .core import check_monthnumb_number\n```"}
