{"task_id": "Mbpp/722", "solution": "```python\ndef filter_data(data, min_height, min_weight):\n    \"\"\"\n    Filters students based on height and weight thresholds.\n    Returns a new dictionary with students satisfying height > min_height and weight >= min_weight.\n    \"\"\"\n    filtered_students = {}\n    for student_name, student_data in data.items():\n        height, weight = student_data\n        if height > min_height and weight >= min_weight:\n            filtered_students[student_name] = student_data\n    return filtered_students\n```"}
{"task_id": "Mbpp/721", "solution": "```python\n# src/models.py\nclass Matrix:\n    \"\"\"Represents the square matrix input and provides safe read access.\"\"\"\n    def __init__(self, size: int, cells: list[list[float]]):\n        self.size = size\n        self.cells = cells  # read-only by convention\n\n    def getCell(self, row: int, col: int) -> float:\n        \"\"\"Returns the value of the cell at (row, col).\"\"\"\n        return self.cells[row][col]\n\nclass Cell:\n    \"\"\"Value object to represent coordinate and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Path:\n    \"\"\"Represents a candidate path and computes totalCost, length, average.\"\"\"\n    def __init__(self, cells: list[Cell]):\n        self.cells = cells\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the total cost of the path.\"\"\"\n        return sum(c.cost for c in self.cells)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def average(self) -> float:\n        \"\"\"Computes the average cost of the path.\"\"\"\n        path_length = self.length()\n        if path_length == 0: # Design implies non-empty paths, but handling for safety.\n            return 0.0\n        return self.totalCost() / path_length\n\nclass Result:\n    \"\"\"Simple container for the returned float value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n```\n```python\n# src/validator.py\nclass Validator:\n    \"\"\"Enforces non-empty, square, numeric entries and raises descriptive ValueError messages.\"\"\"\n\n    def validateNonEmpty(self, matrix: list[list]) -> None:\n        \"\"\"Validates that the matrix is not empty.\"\"\"\n        if not matrix or not matrix[0]:\n            raise ValueError(\"Matrix is empty\")\n\n    def validateSquare(self, matrix: list[list]) -> None:\n        \"\"\"Validates that the matrix is square.\"\"\"\n        num_rows = len(matrix)\n        for i, row in enumerate(matrix):\n            if len(row) != num_rows:\n                raise ValueError(f\"Matrix not square: row {i} has {len(row)} columns, expected {num_rows}\")\n\n    def validateNumericEntries(self, matrix: list[list]) -> None:\n        \"\"\"Validates that all entries in the matrix are numeric.\"\"\"\n        for r_idx, row in enumerate(matrix):\n            for c_idx, val in enumerate(row):\n                if not isinstance(val, (int, float)):\n                    raise ValueError(f\"Non-numeric value at ({r_idx},{c_idx}): {val}\")\n\n    def validateAll(self, matrix: list[list]) -> None:\n        \"\"\"Performs all input validations on the matrix.\"\"\"\n        self.validateNonEmpty(matrix)\n        self.validateSquare(matrix)\n        self.validateNumericEntries(matrix)\n\n```\n```python\n# src/calculator.py\nclass MaxAverageCalculator:\n    \"\"\"Computes maximum average among all valid paths using a DP algorithm.\"\"\"\n\n    def maxAverageOfPath(self, matrix: list[list[float]]) -> float:\n        \"\"\"Computes the maximum average path for the given matrix.\"\"\"\n        return self._computeUsingDP(matrix)\n\n    def _computeUsingDP(self, matrix: list[list[float]]) -> float:\n        \"\"\"Implements the polynomial DP algorithm to find the max sum path.\"\"\"\n        n = len(matrix)\n        # dp[r][c] stores the maximum sum to reach cell (r, c)\n        dp = [[0.0] * n for _ in range(n)]\n\n        # Base case: start cell\n        dp[0][0] = matrix[0][0]\n\n        # Fill first row\n        for c in range(1, n):\n            dp[0][c] = dp[0][c-1] + matrix[0][c]\n\n        # Fill first column\n        for r in range(1, n):\n            dp[r][0] = dp[r-1][0] + matrix[r][0]\n\n        # Fill the rest of the DP table\n        for r in range(1, n):\n            for c in range(1, n):\n                dp[r][c] = max(dp[r-1][c], dp[r][c-1]) + matrix[r][c]\n\n        # All paths from (0,0) to (n-1, n-1) have length 2*n - 1.\n        path_length = (2 * n) - 1\n        max_sum = dp[n-1][n-1]\n        \n        return max_sum / path_length if path_length > 0 else 0.0\n\n```\n```python\n# src/max_average.py\nfrom src.validator import Validator\nfrom src.calculator import MaxAverageCalculator\nfrom src.models import Matrix\n\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"Public entry matching SRS FR1. Calls Validator.validateAll then MaxAverageCalculator.maxAverageOfPath and returns float.\"\"\"\n    validator = Validator()\n    validator.validateAll(matrix)\n    # Construct Matrix domain object (read-only semantics). Copies rows to avoid mutation.\n    mat_obj = Matrix(size=len(matrix), cells=[row[:] for row in matrix])\n    calc = MaxAverageCalculator()\n    return calc.maxAverageOfPath(mat_obj.cells)\n\n```\n```python\n# tests/test_max_average.py\nimport unittest\nfrom src.max_average import maxAverageOfPath\nfrom src.models import Matrix\nfrom src.validator import Validator\nfrom src.calculator import MaxAverageCalculator\n\nclass TestSuite(unittest.TestCase):\n    \"\"\"TestSuite.runUnitTests implementing FR9 and NFR checks (including required assertion).\"\"\"\n\n    def test_required_assertion(self):\n        \"\"\"Tests the required assertion for the sample matrix.\"\"\"\n        matrix = [[1, 2, 3], [6, 5, 4], [7, 3, 9]]\n        expected_average = 5.2\n        actual_average = maxAverageOfPath(matrix)\n        self.assertAlmostEqual(actual_average, expected_average, places=6)\n\n    def test_single_cell_matrix(self):\n        \"\"\"Tests a 1x1 matrix.\"\"\"\n        matrix = [[10]]\n        self.assertAlmostEqual(maxAverageOfPath(matrix), 10.0, places=6)\n\n    def test_2x2_matrix(self):\n        \"\"\"Tests a 2x2 matrix with clear path options.\"\"\"\n        matrix = [[1, 2], [3, 4]]\n        # Paths: (1,2,4) sum=7; (1,3,4) sum=8. Length=3. Max avg = 8/3.\n        self.assertAlmostEqual(maxAverageOfPath(matrix), 8/3, places=6)\n\n    def test_matrix_with_negative_values(self):\n        \"\"\"Tests matrix with negative values.\"\"\"\n        matrix = [[-1, -2], [-3, -4]]\n        # Paths: (-1,-2,-4) sum=-7; (-1,-3,-4) sum=-8. Length=3. Max avg = -7/3.\n        self.assertAlmostEqual(maxAverageOfPath(matrix), -7/3, places=6)\n\n    def test_immutability(self):\n        \"\"\"Verifies that the input matrix is not modified.\"\"\"\n        original_matrix = [[1, 2], [3, 4]]\n        matrix_copy = [row[:] for row in original_matrix]\n        maxAverageOfPath(original_matrix)\n        self.assertEqual(original_matrix, matrix_copy)\n\n    def test_determinism(self):\n        \"\"\"Checks for deterministic results with identical inputs.\"\"\"\n        matrix = [[1, 2, 3], [6, 5, 4], [7, 3, 9]]\n        result1 = maxAverageOfPath(matrix)\n        result2 = maxAverageOfPath(matrix)\n        self.assertEqual(result1, result2)\n\n    def test_validation_empty_matrix(self):\n        \"\"\"Tests validation for an empty matrix.\"\"\"\n        with self.assertRaisesRegex(ValueError, \"Matrix is empty\"):\n            maxAverageOfPath([])\n        with self.assertRaisesRegex(ValueError, \"Matrix is empty\"):\n            maxAverageOfPath([[]])\n\n    def test_validation_non_square_matrix(self):\n        \"\"\"Tests validation for a non-square matrix.\"\"\"\n        with self.assertRaisesRegex(ValueError, \"Matrix not square: row 0 has 2 columns, expected 1\"):\n            maxAverageOfPath([[1, 2]])\n        with self.assertRaisesRegex(ValueError, \"Matrix not square: row 1 has 3 columns, expected 2\"):\n            maxAverageOfPath([[1, 2], [3, 4, 5]])\n\n    def test_validation_non_numeric_entries(self):\n        \"\"\"Tests validation for non-numeric entries.\"\"\"\n        with self.assertRaisesRegex(ValueError, r\"Non-numeric value at \\(0,1\\): b\"):\n            maxAverageOfPath([[1, 'b'], [3, 4]])\n        with self.assertRaisesRegex(ValueError, r\"Non-numeric value at \\(1,0\\): None\"):\n            maxAverageOfPath([[1, 2], [None, 4]])\n\n    def test_zero_values_matrix(self):\n        \"\"\"Tests a matrix with all zero values.\"\"\"\n        matrix = [[0, 0], [0, 0]]\n        self.assertAlmostEqual(maxAverageOfPath(matrix), 0.0, places=6)\n\n    def runUnitTests(self) -> None:\n        \"\"\"Runs all unit tests defined in the TestSuite.\"\"\"\n        # Use a TestRunner to collect and run tests.\n        suite = unittest.TestSuite()\n        suite.addTest(unittest.makeSuite(TestSuite))\n        runner = unittest.TextTestRunner(verbosity=2)\n        runner.run(suite)\n\nif __name__ == '__main__':\n    # This ensures tests can be run directly from the test file.\n    TestSuite().runUnitTests()\n\n```"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Computes the maximum average of a path from top-left to bottom-right cell.\n    Moves are restricted to right or down.\n    \"\"\"\n    N = len(matrix)\n\n    if N == 1:\n        return float(matrix[0][0])\n\n    # dp[i][j] will store the maximum sum of a path from (0,0) to (i,j).\n    dp = [[0.0] * N for _ in range(N)]\n\n    # Initialize the top-left cell.\n    dp[0][0] = float(matrix[0][0])\n\n    # Fill the first row (only right moves possible).\n    for j in range(1, N):\n        dp[0][j] = dp[0][j-1] + float(matrix[0][j])\n\n    # Fill the first column (only down moves possible).\n    for i in range(1, N):\n        dp[i][0] = dp[i-1][0] + float(matrix[i][0])\n\n    # Fill the rest of the DP table.\n    for i in range(1, N):\n        for j in range(1, N):\n            dp[i][j] = float(matrix[i][j]) + max(dp[i-1][j], dp[i][j-1])\n\n    # The maximum sum path ends at the bottom-right cell.\n    max_sum = dp[N-1][N-1]\n\n    # All valid paths have the same length (N-1 right moves + N-1 down moves + 1 start cell).\n    path_length = 2 * N - 1\n\n    return max_sum / path_length"}
{"task_id": "Mbpp/723", "solution": "```python\n# src/types.py\nfrom typing import List, Any\n\nclass ListDoc:\n    \"\"\"A documentation-oriented stub for a list of elements.\"\"\"\n    elements: List[Any]\n\n    def length(self) -> int:\n        \"\"\"Returns the conceptual length of the list.\"\"\"\n        # This is a stub for documentation; actual lists are used.\n        return len(self.elements)\n\nclass ElementDoc:\n    \"\"\"A documentation-oriented stub for a single element.\"\"\"\n    value: Any\n\nclass ResultDoc:\n    \"\"\"A documentation-oriented stub for the integer count result.\"\"\"\n    count: int\n```\n\n```python\n# src/validator.py\nfrom typing import List, Any\n\nclass Validator:\n    \"\"\"Validates input types and lengths according to requirements.\"\"\"\n\n    def validate_types(self, a: List[Any], b: List[Any]) -> None:\n        \"\"\"Raises TypeError if either input is not a list.\"\"\"\n        if not isinstance(a, list) or not isinstance(b, list):\n            raise TypeError(\"Inputs 'a' and 'b' must be lists.\")\n\n    def validate_lengths(self, a: List[Any], b: List[Any]) -> None:\n        \"\"\"Raises ValueError if input list lengths differ.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Input lists 'a' and 'b' must have the same length.\")\n```\n\n```python\n# src/comparator.py\nfrom typing import List, Any\n\nclass Comparator:\n    \"\"\"Performs index-wise comparisons and provides an O(n) counting implementation.\"\"\"\n\n    def compare_at_index(self, a: List[Any], b: List[Any], i: int) -> bool:\n        \"\"\"Returns true if elements at index i in both lists are equal.\"\"\"\n        return a[i] == b[i]\n\n    def count_matches(self, a: List[Any], b: List[Any]) -> int:\n        \"\"\"Performs a single-pass O(n) traversal to count matching indices.\"\"\"\n        match_count = 0\n        for i in range(len(a)):\n            if self.compare_at_index(a, b, i):\n                match_count += 1\n        return match_count\n```\n\n```python\n# src/count_same_pair.py\nfrom typing import List, Any\nfrom src.validator import Validator\nfrom src.comparator import Comparator\n\ndef count_same_pair(a: List[Any], b: List[Any]) -> int:\n    \"\"\"\n    Counts index-wise equal elements between two lists.\n    It orchestrates input validation and a linear-pass comparison.\n    \"\"\"\n    validator = Validator()\n    validator.validate_types(a, b)\n    validator.validate_lengths(a, b)\n\n    comparator = Comparator()\n    return comparator.count_matches(a, b)\n```\n\n```python\n# tests/test_count_same_pair.py\nimport pytest\nfrom src.count_same_pair import count_same_pair\n\ndef test_example():\n    \"\"\"Tests the SRS-provided example assertion.\"\"\"\n    assert count_same_pair([1, 2, 3, 4, 5, 6, 7, 8], [2, 2, 3, 1, 2, 6, 7, 9]) == 4\n\ndef test_empty_lists():\n    \"\"\"Tests the function with two empty lists.\"\"\"\n    assert count_same_pair([], []) == 0\n\ndef test_no_matches():\n    \"\"\"Tests lists where no elements match at any index.\"\"\"\n    assert count_same_pair([1, 2, 3], [4, 5, 6]) == 0\n\ndef test_all_matches():\n    \"\"\"Tests lists where all elements match at their respective indices.\"\"\"\n    assert count_same_pair([1, 2, 3], [1, 2, 3]) == 3\n\ndef test_mismatched_lengths():\n    \"\"\"Tests that ValueError is raised for lists of unequal length.\"\"\"\n    with pytest.raises(ValueError, match=\"Input lists 'a' and 'b' must have the same length.\"):\n        count_same_pair([1, 2], [1, 2, 3])\n    with pytest.raises(ValueError):\n        count_same_pair([1, 2, 3], [1])\n\ndef test_non_list_inputs():\n    \"\"\"Tests that TypeError is raised for non-list inputs.\"\"\"\n    with pytest.raises(TypeError, match=\"Inputs 'a' and 'b' must be lists.\"):\n        count_same_pair(\"string\", \"another\")\n    with pytest.raises(TypeError):\n        count_same_pair([1, 2], (3, 4))\n    with pytest.raises(TypeError):\n        count_same_pair(None, [1, 2])\n    with pytest.raises(TypeError):\n        count_same_pair([1, 2], None)\n\ndef test_mixed_types_elements():\n    \"\"\"Tests with lists containing elements of mixed types, including objects.\"\"\"\n    list_a = [1, 'apple', True, None, {'key': 1}, [1, 2]]\n    list_b = [1, 'banana', False, None, {'key': 1}, [1, 3]]\n    assert count_same_pair(list_a, list_b) == 3 # 1, None, {'key': 1}\n\ndef test_does_not_modify_inputs():\n    \"\"\"Tests that the input lists remain unchanged after function execution.\"\"\"\n    original_a = [10, 20, 30]\n    original_b = [10, 25, 30]\n    \n    a_copy = list(original_a)\n    b_copy = list(original_b)\n    \n    count_same_pair(original_a, original_b)\n    \n    assert original_a == a_copy\n    assert original_b == b_copy\n```"}
{"task_id": "Mbpp/723", "solution": "```python\n# src/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Raised when an input is not of the expected type.\"\"\"\n    pass\n\nclass LengthMismatchError(Exception):\n    \"\"\"Raised when input lists have different lengths.\"\"\"\n    pass\n```\n\n```python\n# src/models.py\nclass InputList:\n    \"\"\"Lightweight wrapper for a list.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped list.\"\"\"\n        return len(self.elements)\n\n    def get(self, index: int) -> any:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self.elements[index]\n\nclass ListElement:\n    \"\"\"Domain representation of a list element.\"\"\"\n    def __init__(self, value: any):\n        self.value = value\n\nclass ComparisonResult:\n    \"\"\"Represents comparison per index.\"\"\"\n    def __init__(self, index: int, a: any, b: any, equal: bool):\n        self.index = index\n        self.a = a\n        self.b = b\n        self.equal = equal\n```\n\n```python\n# src/validator.py\nfrom src.exceptions import InvalidInputError, LengthMismatchError\n\nclass Validator:\n    \"\"\"Validates inputs for type and length.\"\"\"\n    def validate_is_list(self, obj: any) -> None:\n        \"\"\"Checks if the object is a list; raises InvalidInputError if not.\"\"\"\n        if not isinstance(obj, list):\n            raise InvalidInputError(\"Input must be a list.\")\n\n    def validate_equal_length(self, listA: list, listB: list) -> None:\n        \"\"\"Checks if two lists have equal length; raises LengthMismatchError if not.\"\"\"\n        if len(listA) != len(listB):\n            raise LengthMismatchError(\"Input lists must have equal length.\")\n```\n\n```python\n# src/comparator.py\nclass Comparator:\n    \"\"\"Compares elements and counts equal indices.\"\"\"\n    def equal(self, a: any, b: any) -> bool:\n        \"\"\"Compares two elements for equality.\"\"\"\n        return a == b\n\n    def count_equal_indices(self, listA: list, listB: list) -> int:\n        \"\"\"Counts indices where corresponding elements are equal.\"\"\"\n        count = 0\n        for i in range(len(listA)):\n            if self.equal(listA[i], listB[i]):\n                count += 1\n        return count\n```\n\n```python\n# src/count_same_pair_service.py\nfrom src.validator import Validator\nfrom src.comparator import Comparator\n\nclass CountSamePairService:\n    \"\"\"Orchestrates validation and comparison of two lists.\"\"\"\n    def __init__(self, validator: Validator, comparator: Comparator):\n        self._validator = validator\n        self._comparator = comparator\n\n    def count_same_pair(self, listA: list, listB: list) -> int:\n        \"\"\"\n        Validates inputs and counts indices where elements are equal.\n        Raises InvalidInputError or LengthMismatchError on invalid input.\n        \"\"\"\n        self._validator.validate_is_list(listA)\n        self._validator.validate_is_list(listB)\n        self._validator.validate_equal_length(listA, listB)\n\n        return self._comparator.count_equal_indices(listA, listB)\n\n# Public API function as per SRS and design\ndef count_same_pair(listA: list, listB: list) -> int:\n    \"\"\"\n    Public entry point to count indices with identical values.\n    Delegates to the CountSamePairService for orchestration.\n    \"\"\"\n    service = CountSamePairService(Validator(), Comparator())\n    return service.count_same_pair(listA, listB)\n```"}
{"task_id": "Mbpp/724", "solution": "```python\n# src/power_base_sum.py\nfrom typing import List\n\nclass ErrorHandler:\n    \"\"\"Centralizes raising exceptions for validation rules.\"\"\"\n    def raise_type_error(self, message: str) -> None:\n        \"\"\"Raises a TypeError with the given message.\"\"\"\n        raise TypeError(message)\n\n    def raise_value_error(self, message: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(message)\n\nclass IntegerOperand:\n    \"\"\"A simple typed holder for integer operands.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass PowerResult:\n    \"\"\"Holder for an integer result and provides string conversion.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\n    def to_string(self) -> str:\n        \"\"\"Returns the decimal string of the absolute value.\"\"\"\n        return str(abs(self.value))\n\nclass Digit:\n    \"\"\"Holder for a single decimal digit 0-9.\"\"\"\n    def __init__(self, value: int):\n        # Ensures that Digit objects represent valid decimal digits.\n        if not (0 <= value <= 9):\n            raise ValueError(\"Digit value must be between 0 and 9.\")\n        self.value: int = value\n\nclass DigitSum:\n    \"\"\"Holder for the sum of digits.\"\"\"\n    def __init__(self, sum_val: int):\n        self.sum: int = sum_val\n\nclass PowerBaseSumFunction:\n    \"\"\"Encapsulates the pipeline for computing base**power and summing its digits.\"\"\"\n    def __init__(self):\n        self.error_handler = ErrorHandler()\n\n    def validate_inputs(self, base: int, power: int) -> None:\n        \"\"\"Validates that base and power are integers and power is non-negative.\"\"\"\n        if not isinstance(base, int) or not isinstance(power, int):\n            self.error_handler.raise_type_error(\"Base and power must be integers.\")\n        if power < 0:\n            self.error_handler.raise_value_error(\"Power must be non-negative.\")\n\n    def compute_power(self, base: int, power: int) -> int:\n        \"\"\"Computes base ** power using arbitrary-precision integer arithmetic.\"\"\"\n        return base ** power\n\n    def extract_digits(self, result: int) -> List[int]:\n        \"\"\"Extracts decimal digits from the absolute integer result.\"\"\"\n        power_result = PowerResult(result)\n        abs_str_result = power_result.to_string()\n        # Converts each character digit to an integer and collects them.\n        digits = [int(char_digit) for char_digit in abs_str_result]\n        return digits\n\n    def sum_digits(self, digits: List[int]) -> int:\n        \"\"\"Sums a list of integer digits using the DigitSum holder.\"\"\"\n        digit_sum_obj = DigitSum(sum(digits))\n        return digit_sum_obj.sum\n\n    def power_base_sum(self, base: int, power: int) -> int:\n        \"\"\"Orchestrates the computation, digit extraction, and summation.\"\"\"\n        self.validate_inputs(base, power)\n        result = self.compute_power(base, power)\n        digits = self.extract_digits(result)\n        return self.sum_digits(digits)\n\ndef power_base_sum(base, power) -> int:\n    \"\"\"Public API function to compute base**power, sum its decimal digits.\"\"\"\n    # Delegates the responsibility to an instance of PowerBaseSumFunction.\n    impl = PowerBaseSumFunction()\n    return impl.power_base_sum(base, power)\n```\n```python\n# tests/test_power_base_sum.py\nfrom src.power_base_sum import power_base_sum\nimport sys\n\nclass TestCase:\n    \"\"\"Encapsulates test data and logic for an acceptance test.\"\"\"\n    def __init__(self, base: int, power: int, expected: int):\n        self.base = base\n        self.power = power\n        self.expected = expected\n\n    def run(self) -> None:\n        \"\"\"Executes the power_base_sum function and asserts the result.\"\"\"\n        print(f\"Running acceptance test: power_base_sum({self.base}, {self.power})\")\n        result = power_base_sum(self.base, self.power)\n        assert result == self.expected, \\\n            f\"Test failed: power_base_sum({self.base}, {self.power}) == {result}, expected {self.expected}\"\n        print(f\"Test passed: power_base_sum({self.base}, {self.power}) == {result} (expected {self.expected})\")\n\nif __name__ == '__main__':\n    # Main entry point for running the acceptance test.\n    try:\n        acceptance_test = TestCase(2, 100, 115)\n        acceptance_test.run()\n        print('\\nAll acceptance tests passed successfully!')\n        sys.exit(0)\n    except AssertionError as e:\n        print(f'\\nAcceptance test failed: {e}', file=sys.stderr)\n        sys.exit(1)\n    except Exception as e:\n        print(f'\\nAn unexpected error occurred during testing: {e}', file=sys.stderr)\n        sys.exit(1)\n```"}
{"task_id": "Mbpp/724", "solution": "class PowerComputation:\n    \"\"\"Encapsulates exact integer exponentiation logic.\n    It computes base ** power and stores the result.\n    \"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\n        self.result: int | None = None\n\n    def compute(self) -> int:\n        \"\"\"Computes and returns base ** power using exact integer arithmetic.\"\"\"\n        self.result = self.base ** self.power\n        return self.result\n\nclass DigitSum:\n    \"\"\"Encapsulates logic to compute the sum of decimal digits of an integer.\n    It processes an integer value and calculates the sum of its digits.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.sum: int | None = None\n\n    def computeSum(self) -> int:\n        \"\"\"Computes and returns the sum of decimal digits of the stored value.\"\"\"\n        self.sum = sum(int(digit) for digit in str(self.value))\n        return self.sum\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Computes base**power using exact integer arithmetic and returns the sum of its decimal digits.\n    This function composes PowerComputation and DigitSum classes internally.\n    \"\"\"\n    # Compute base**power using PowerComputation\n    power_calculator = PowerComputation(base, power)\n    power_result = power_calculator.compute()\n\n    # Calculate the sum of digits using DigitSum\n    digit_sum_calculator = DigitSum(power_result)\n    total_digit_sum = digit_sum_calculator.computeSum()\n\n    return total_digit_sum"}
{"task_id": "Mbpp/725", "solution": "```python\ndef extract_quotation(input: str) -> list[str]:\n    \"\"\"Extracts substrings between double quotes from the input string.\n    Returns them in a list, preserving order and exact text, without the quotes.\n    \"\"\"\n    extracted_quotes = []\n    in_quote = False\n    quote_start_index = -1\n\n    for i, char in enumerate(input):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening double quote.\n                quote_start_index = i + 1\n                in_quote = True\n            else:\n                # Found a closing double quote.\n                extracted_quotes.append(input[quote_start_index:i])\n                in_quote = False\n    return extracted_quotes\n```"}
{"task_id": "Mbpp/725", "solution": "```python\n# src/extract_quotation.py\nfrom typing import List\n\ndef _scan_for_quotes(s: str) -> List[str]:\n    \"\"\"Scans the string for substrings between double quotes, preserving order.\"\"\"\n    extracted_quotes = []\n    start_search_index = 0\n    while True:\n        first_quote_idx = s.find('\"', start_search_index)\n        if first_quote_idx == -1:\n            break  # No more opening quotes\n        \n        second_quote_idx = s.find('\"', first_quote_idx + 1)\n        if second_quote_idx == -1:\n            break  # Unmatched opening quote, no valid pair\n            \n        extracted_quotes.append(s[first_quote_idx + 1:second_quote_idx])\n        start_search_index = second_quote_idx + 1\n    return extracted_quotes\n\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"\n    Extracts substrings enclosed in double-quote characters from the input string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    return _scan_for_quotes(input)\n```\n```python\n# tests/test_extract_quotation.py\nfrom src.extract_quotation import extract_quotation\n\ndef test_assertion_case() -> None:\n    \"\"\"Verifies the SRS-provided assertion example.\"\"\"\n    test_string = 'Cortex \"A53\" Based \"multi\" tasking \"Processor\"'\n    expected_result = ['A53', 'multi', 'Processor']\n    assert extract_quotation(test_string) == expected_result, \\\n        f\"Assertion case failed. Expected {expected_result}, got {extract_quotation(test_string)}\"\n\ndef test_no_quotes() -> None:\n    \"\"\"Verifies behavior when no double-quoted strings are present.\"\"\"\n    test_string = 'no quoted strings here'\n    expected_result = []\n    assert extract_quotation(test_string) == expected_result, \\\n        f\"No quotes case failed. Expected {expected_result}, got {extract_quotation(test_string)}\"\n\ndef test_non_string_raises() -> None:\n    \"\"\"Verifies that non-string inputs raise a TypeError.\"\"\"\n    try:\n        extract_quotation(None)\n    except TypeError:\n        pass  # Expected behavior\n    except Exception as e:\n        raise AssertionError(f\"Expected TypeError for None, but got {type(e).__name__}\")\n    else:\n        raise AssertionError('TypeError not raised for non-string input (None)')\n\n    try:\n        extract_quotation(123)\n    except TypeError:\n        pass  # Expected behavior\n    except Exception as e:\n        raise AssertionError(f\"Expected TypeError for int, but got {type(e).__name__}\")\n    else:\n        raise AssertionError('TypeError not raised for non-string input (int)')\n\nif __name__ == '__main__':\n    print(\"Running unit tests for extract_quotation...\")\n    \n    test_assertion_case()\n    print(\"\u2713 test_assertion_case passed.\")\n    \n    test_no_quotes()\n    print(\"\u2713 test_no_quotes passed.\")\n    \n    test_non_string_raises()\n    print(\"\u2713 test_non_string_raises passed.\")\n    \n    print(\"\\nAll tests passed successfully!\")\n\n```"}
