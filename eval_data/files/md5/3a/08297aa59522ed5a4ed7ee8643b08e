{"task_id": "Mbpp/797", "solution": "```python\n# src/__init__.py\nfrom .sum_in_range import sum_in_range\n```\n```python\n# src/sum_in_range.py\nimport typing\n\nclass Range:\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the lower bound is less than or equal to the upper bound.\n        Assumes l and r are integers as per type hints.\"\"\"\n        return self.l <= self.r\n\n    def iterate(self) -> typing.Iterable[int]:\n        \"\"\"Yields each integer in the inclusive range [l, r] if valid.\"\"\"\n        if self.is_valid():\n            for x in range(self.l, self.r + 1):\n                yield x\n\nclass Number:\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_natural(self) -> bool:\n        \"\"\"Returns True if the number is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the number is odd.\"\"\"\n        return self.value % 2 == 1\n\nclass Result:\n    def __init__(self):\n        self.total = 0\n\n    def add(self, n: Number) -> None:\n        \"\"\"Adds the Number's value to the total.\"\"\"\n        self.total += n.value\n\n    def value(self) -> int:\n        \"\"\"Returns the accumulated total.\"\"\"\n        return self.total\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"Computes the sum of all odd natural numbers within the inclusive range [l, r].\n    Returns 0 if the range is invalid or no such numbers exist.\"\"\"\n    current_range = Range(l, r)\n    if not current_range.is_valid():\n        return 0\n\n    result = Result()\n    for x in current_range.iterate():\n        num = Number(x)\n        if num.is_natural() and num.is_odd():\n            result.add(num)\n    return result.value()\n```"}
{"task_id": "Mbpp/799", "solution": "MASK = 0xFFFFFFFF\n\nclass InputValue:\n    \"\"\"Encapsulates a raw input value and provides its 32-bit representation.\"\"\"\n    def __init__(self, raw_value: int):\n        self.raw_value = raw_value\n\n    def as32(self) -> int:\n        \"\"\"Returns the raw value masked to 32 bits.\"\"\"\n        return self.raw_value & MASK\n\nclass RotationParameter:\n    \"\"\"Encapsulates the rotation parameter and normalizes it.\"\"\"\n    def __init__(self, d: int):\n        self.d = d\n\n    def normalizedD(self) -> int:\n        \"\"\"Returns the rotation parameter normalized to the range 0..31.\"\"\"\n        return self.d % 32\n\nclass BitMask:\n    \"\"\"Provides the 32-bit mask constant and applies it.\"\"\"\n    MASK = MASK # Refers to the module-level MASK\n\n    @staticmethod\n    def apply(v: int) -> int:\n        \"\"\"Applies the 32-bit mask to a given integer.\"\"\"\n        return v & BitMask.MASK\n\nclass Result:\n    \"\"\"Container for a 32-bit rotated value, ensuring it is masked on construction.\"\"\"\n    def __init__(self, initial_value: int):\n        self.value = BitMask.apply(initial_value)\n\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"Performs a 32-bit circular left rotation of 'value' by 'd' bits.\"\"\"\n    value32 = InputValue(value).as32()\n    d_mod = RotationParameter(d).normalizedD()\n\n    # Handle d_mod == 0 explicitly for Python's right shift behavior with 0\n    if d_mod == 0:\n        rotated = value32\n    else:\n        rotated = ((value32 << d_mod) | (value32 >> (32 - d_mod)))\n    \n    masked_result = BitMask.apply(rotated)\n    return Result(masked_result).value"}
{"task_id": "Mbpp/800", "solution": "```python\nclass InputString:\n    \"\"\"Wrapper for an input string, providing convenience methods for length and emptiness.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the encapsulated string is empty.\"\"\"\n        return self.length() == 0\n\nclass OutputString:\n    \"\"\"Wrapper for the resulting string after whitespace removal.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass RemoveAllSpaces:\n    \"\"\"Encapsulates the core logic for removing specified whitespace characters.\"\"\"\n    def __init__(self):\n        # Defines the minimum set of whitespace characters to be removed.\n        self._whitespace_chars = [' ', '\\t', '\\n', '\\r', '\\f']\n\n    def remove(self, input_str: str) -> str:\n        \"\"\"Processes the input string to remove all defined whitespace characters.\"\"\"\n        cleaned_chars = []\n        for char in input_str:\n            if char not in self._whitespace_chars:\n                cleaned_chars.append(char)\n        return \"\".join(cleaned_chars)\n\ndef remove_all_spaces(input: str) -> str:\n    \"\"\"\n    Removes all defined whitespace characters from the input string,\n    preserving the order of non-whitespace characters.\n    \"\"\"\n    input_wrapper = InputString(input)\n    \n    remover = RemoveAllSpaces()\n    # The actual removal logic operates on the raw string value from the wrapper.\n    cleaned_value = remover.remove(input_wrapper.value)\n    \n    output_wrapper = OutputString(cleaned_value)\n    return output_wrapper.value\n```"}
{"task_id": "Mbpp/799", "solution": "MASK = 0xFFFFFFFF\n\ndef _normalize_d(d: int) -> int:\n    \"\"\"Normalizes the rotation distance to be within 0-31.\"\"\"\n    return d % 32\n\ndef _rol(value: int, d: int) -> int:\n    \"\"\"Performs a raw 32-bit circular left shift.\"\"\"\n    return ((value << d) | (value >> (32 - d)))\n\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a 32-bit circular left rotation on 'number' by 'd' bits.\n    The result is always masked to ensure it fits within 32 bits.\n    \"\"\"\n    effective_d = _normalize_d(d)\n    number_masked = number & MASK\n\n    if effective_d == 0:\n        return number_masked\n\n    raw_result = _rol(number_masked, effective_d)\n    result = raw_result & MASK\n    return result"}
{"task_id": "Mbpp/801", "solution": "```python\n# src/test_three_equal.py\n\n\"\"\"\nA minimal Python library providing a deterministic, side-effect-free function\nnamed test_three_equal(a, b, c) that counts how many of the three integer inputs are equal.\n\"\"\"\n\n__all__ = [\"test_three_equal\", \"validate_inputs\"]\n\ndef validate_inputs(a, b, c) -> None:\n    \"\"\"\n    Validates that all inputs are of type int.\n    (Note: Type validation and error raising are omitted due to critical requirements.)\n    \"\"\"\n    # Implementation of type checking (isinstance) and raising TypeError\n    # is suppressed to comply with critical requirement:\n    # \"FORBIDDEN: Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n    pass\n\n\ndef test_three_equal(a, b, c) -> int:\n    \"\"\"\n    Counts how many of the three integer inputs are equal.\n    Returns 3 if all three are equal, 2 if exactly two are equal, and 0 if all are distinct.\n    \"\"\"\n    validate_inputs(a, b, c) # Calls input validation, which is a no-op under current constraints.\n\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0\n\n```"}
{"task_id": "Mbpp/800", "solution": "```python\n# src/domain.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Domain container for the input string.\"\"\"\n    value: str\n\n@dataclass\nclass ResultString:\n    \"\"\"Domain container for the cleaned output string.\"\"\"\n    value: str\n\n```python\n# src/service.py\nfrom src.domain import InputString, ResultString\n\ndef _is_whitespace(char: str) -> bool:\n    \"\"\"Checks if a character is a space, tab, or newline.\"\"\"\n    return char in (' ', '\\t', '\\n')\n\nclass RemoveAllSpacesService:\n    \"\"\"Service to remove all specified whitespace characters from an input string.\"\"\"\n\n    def remove_all_spaces(self, input_string: InputString) -> ResultString:\n        \"\"\"Processes the InputString, removing whitespace, and returns a ResultString.\"\"\"\n        cleaned_chars = []\n        for char in input_string.value:\n            if not _is_whitespace(char):\n                cleaned_chars.append(char)\n        return ResultString(\"\".join(cleaned_chars))\n\n```python\n# src/remove_all_spaces.py\nfrom src.domain import InputString, ResultString\nfrom src.service import RemoveAllSpacesService\n\ndef remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all space, tab, and newline characters from the input string.\"\"\"\n    service = RemoveAllSpacesService()\n    input_obj = InputString(input_string)\n    result_obj = service.remove_all_spaces(input_obj)\n    return result_obj.value\n\n```python\n# tests/test_remove_all_spaces.py\nfrom src.remove_all_spaces import remove_all_spaces\n\n# Custom TestCase class as specified in the design\nclass TestCase:\n    \"\"\"A simple test case container for running an assertion.\"\"\"\n    def __init__(self, name: str, input_value: str, expected: str):\n        self.name = name\n        self.input_value = input_value\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes the test case and returns True if the assertion passes.\"\"\"\n        actual = remove_all_spaces(self.input_value)\n        return actual == self.expected\n\ndef test_remove_all_spaces_example():\n    \"\"\"Verifies the core functionality with the specified example.\"\"\"\n    assert remove_all_spaces('python  program') == 'pythonprogram'\n\n```"}
{"task_id": "Mbpp/803", "solution": "```python\nclass Number:\n    \"\"\"Container for an input numeric value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass Result:\n    \"\"\"Container for evaluation result.\"\"\"\n    def __init__(self, isPerfectSquare: bool):\n        self.isPerfectSquare = isPerfectSquare\n\nclass PerfectSquareChecker:\n    \"\"\"Stateless domain class encapsulating the perfect square check.\n    Implements BR3: a number n is a perfect square iff there exists an integer m such that m * m == n.\n    \"\"\"\n    def is_perfect_square(self, n) -> bool:\n        \"\"\"Return True iff there exists integer m such that m * m == n (BR3).\"\"\"\n        if n < 0:\n            result = Result(False)\n            return result.isPerfectSquare\n\n        # Calculate the square root.\n        sqrt_n = n**0.5\n        \n        # Check if sqrt_n is an integer.\n        is_square = (sqrt_n == int(sqrt_n))\n        \n        result = Result(is_square)\n        return result.isPerfectSquare\n\ndef is_perfect_square(n) -> bool:\n    \"\"\"\n    Public API that returns True when n is a perfect square per BR3 and False otherwise (satisfies FR1).\n    Delegates to PerfectSquareChecker for the core logic as per design.\n    \"\"\"\n    # Construct Number object for domain representation as per sequence diagram.\n    _ = Number(n) \n    \n    # Delegate the actual check to an instance of PerfectSquareChecker.\n    checker = PerfectSquareChecker()\n    return checker.is_perfect_square(n)\n```"}
{"task_id": "Mbpp/803", "solution": "```python\n# src/domain.py\nclass Number:\n    \"\"\"Domain carrier for an integer input value.\"\"\"\n    value: int\n\n    def __init__(self, value: int):\n        self.value = value\n\nclass Result:\n    \"\"\"Domain carrier for a boolean perfect square outcome.\"\"\"\n    is_perfect: bool\n\n    def __init__(self, is_perfect: bool):\n        self.is_perfect = is_perfect\n```\n\n```python\n# src/perfect_square_checker.py\nfrom .domain import Number, Result\n\nclass PerfectSquareChecker:\n    \"\"\"Performs integer-safe validation and computation for perfect squares.\"\"\"\n\n    @staticmethod\n    def _integer_sqrt_floor(n: int) -> int:\n        \"\"\"Computes floor(sqrt(n)) using integer-only binary search.\n        Handles non-negative inputs as expected by its caller.\n        \"\"\"\n        if n < 0:\n            return 0 # Should not be reached if called correctly from is_perfect_square.\n        if n == 0:\n            return 0\n        \n        low = 1\n        high = n\n        ans = 0\n        \n        while low <= high:\n            mid = (low + high) // 2\n            if mid * mid == n:\n                return mid\n            elif mid * mid < n:\n                ans = mid\n                low = mid + 1\n            else:\n                high = mid - 1\n        return ans\n\n    @staticmethod\n    def is_perfect_square(n: int) -> bool:\n        \"\"\"Return True iff there exists integer m >= 0 such that m*m == n.\"\"\"\n        # BR1: Precondition: input n must be an integer.\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        # BR6: Negative values cannot be perfect squares (m >= 0).\n        if n < 0:\n            return False\n\n        # BR5: 0 is a perfect square (0 * 0 = 0).\n        if n == 0:\n            return True\n        \n        # Reflect input as a domain Number object.\n        _ = Number(n)\n\n        # Compute integer square root candidate using integer-only arithmetic.\n        m_candidate = PerfectSquareChecker._integer_sqrt_floor(n)\n\n        # Check if the square of the candidate equals n.\n        is_perfect = (m_candidate * m_candidate == n)\n\n        # Reflect outcome as a domain Result object.\n        _ = Result(is_perfect=is_perfect)\n\n        return is_perfect\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Public API function that delegates to PerfectSquareChecker.is_perfect_square.\"\"\"\n    return PerfectSquareChecker.is_perfect_square(n)\n```\n\n```python\n# src/__init__.py\nfrom .perfect_square_checker import is_perfect_square\n\n__all__ = [\"is_perfect_square\"]\n```\n\n```python\n# tests/test_perfect_square.py\nimport pytest\nfrom src import is_perfect_square\n\ndef test_perfect_squares():\n    \"\"\"Verify known perfect squares return True.\"\"\"\n    assert is_perfect_square(0)\n    assert is_perfect_square(1)\n    assert is_perfect_square(4)\n    assert is_perfect_square(9)\n    assert is_perfect_square(16)\n    assert is_perfect_square(25)\n    assert is_perfect_square(100)\n    assert is_perfect_square(10000)\n\ndef test_non_perfect_squares():\n    \"\"\"Verify known non-perfect squares return False.\"\"\"\n    assert not is_perfect_square(2)\n    assert not is_perfect_square(3)\n    assert not is_perfect_square(5)\n    assert not is_perfect_square(11)\n    assert not is_perfect_square(99)\n\ndef test_example_10():\n    \"\"\"Verify the specific example assert not is_perfect_square(10) holds.\"\"\"\n    assert not is_perfect_square(10)\n\ndef test_negative_numbers():\n    \"\"\"Verify negative numbers return False as per BR6.\"\"\"\n    assert not is_perfect_square(-1)\n    assert not is_perfect_square(-4)\n    assert not is_perfect_square(-100)\n\ndef test_type_validation():\n    \"\"\"Verify non-integer inputs raise TypeError as per BR1.\"\"\"\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_perfect_square(3.14)\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_perfect_square(\"hello\")\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_perfect_square([1])\n    with pytest.raises(TypeError, match=\"Input must be an integer.\"):\n        is_perfect_square(None)\n```"}
