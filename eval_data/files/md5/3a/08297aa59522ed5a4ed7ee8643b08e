{"task_id": "Mbpp/306", "solution": "```python\nfrom typing import List\n\nclass Sequence:\n    \"\"\"Encapsulates the input array and its declared length.\"\"\"\n    def __init__(self, A: List[int], n: int) -> None:\n        self.A = A\n        self.n = n\n\n    def length(self) -> int:\n        \"\"\"Returns the actual length of the array A.\"\"\"\n        return len(self.A)\n\nclass IndexPair:\n    \"\"\"Holds the two relevant indices i and k.\"\"\"\n    def __init__(self, i: int, k: int) -> None:\n        self.i = i\n        self.k = k\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if k is strictly greater than i.\"\"\"\n        return self.k > self.i\n\nclass Validator:\n    \"\"\"Provides methods for input validation.\"\"\"\n    def validateLength(self, seq: 'Sequence') -> None:\n        \"\"\"Validates that n matches the actual length of A.\"\"\"\n        if seq.n != seq.length():\n            raise ValueError(\"n != len(A)\")\n\n    def validateIndices(self, idx: 'IndexPair', seq: 'Sequence') -> None:\n        \"\"\"Validates index ranges and the k > i condition.\"\"\"\n        if not (0 <= idx.i < seq.n and 0 <= idx.k < seq.n):\n            raise ValueError(\"index out of range\")\n        if not idx.isValid():\n            raise ValueError(\"k must be > i\")\n\nclass Subsequence:\n    \"\"\"Represents a strictly increasing subsequence.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the subsequence.\"\"\"\n        return sum(self.elements)\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"Checks if the subsequence is strictly increasing.\"\"\"\n        if not self.elements:\n            return True\n        for i in range(1, len(self.elements)):\n            if self.elements[i] <= self.elements[i-1]:\n                return False\n        return True\n\nclass Algorithm:\n    \"\"\"Implements the core logic to compute the maximum sum.\"\"\"\n    def computeMaxSumPrefixIncludeK(self, seq: 'Sequence', idx: 'IndexPair') -> int:\n        \"\"\"Computes the maximum sum of an increasing subsequence ending with A[k].\"\"\"\n        A = seq.A\n        i = idx.i\n        k = idx.k\n\n        # dp[j] stores the maximum sum of an increasing subsequence ending at index j in A[0..i]\n        dp = [A[j] for j in range(i + 1)]\n\n        for j in range(i + 1):\n            for p in range(j):\n                if A[p] < A[j]:\n                    dp[j] = max(dp[j], dp[p] + A[j])\n\n        # Find the best prefix sum ending before A[k]\n        best_prefix_sum = 0 # Represents the sum of an empty subsequence\n        for j in range(i + 1):\n            if A[j] < A[k]:\n                best_prefix_sum = max(best_prefix_sum, dp[j])\n        \n        return best_prefix_sum + A[k]\n\nclass Result:\n    \"\"\"A data transfer object for conceptual clarity.\"\"\"\n    def __init__(self, value: int, status: str = 'OK') -> None:\n        self.value = value\n        self.status = status\n\ndef max_sum_increasing_subseq(A: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence from A[0..i]\n    followed by the inclusion of A[k]. Validates inputs n, i, and k.\n    \"\"\"\n    seq = Sequence(A, n)\n    idx = IndexPair(i, k)\n    validator = Validator()\n\n    validator.validateLength(seq)\n    validator.validateIndices(idx, seq)\n\n    algorithm = Algorithm()\n    result_value = algorithm.computeMaxSumPrefixIncludeK(seq, idx)\n\n    return result_value\n```"}
{"task_id": "Mbpp/308", "solution": "```python\n# src/large_product.py\n\n# Internal value object to represent a factor with its value and original index.\nclass Factor:\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\n# Internal value object representing two factor values and their computed product.\nclass ProductPair:\n    def __init__(self, factor1_value: int, factor2_value: int) -> None:\n        self.factor1_value = factor1_value\n        self.factor2_value = factor2_value\n        self.product = factor1_value * factor2_value\n\n# Internal DTO encapsulating a list of products.\nclass ResultList:\n    def __init__(self, products: list[int]) -> None:\n        self.products = products\n\n    def size(self) -> int:\n        return len(self.products)\n\n# Encapsulates the algorithm to compute and select the largest products.\nclass LargeProductFunction:\n    def __init__(self, list1: list[int], list2: list[int], k: int) -> None:\n        self.list1 = list1\n        self.list2 = list2\n        self.k = k\n\n    def execute(self) -> list[int]:\n        # Create Factor objects for each element to preserve distinctness.\n        factors1 = [Factor(value, i) for i, value in enumerate(self.list1)]\n        factors2 = [Factor(value, i) for i, value in enumerate(self.list2)]\n\n        all_products = []\n        # Form ProductPair entries for every ordered pair using factor values.\n        for factor1 in factors1:\n            for factor2 in factors2:\n                pair = ProductPair(factor1.value, factor2.value)\n                all_products.append(pair.product)\n\n        # Sort computed products in descending order, preserving duplicates.\n        all_products.sort(reverse=True)\n\n        # Return the top k values, or all if fewer than k exist.\n        return all_products[:self.k]\n\n# Public API function to find the k largest pairwise products.\ndef large_product(list1: list[int], list2: list[int], k: int) -> list[int]:\n    # Validate inputs: return an empty list if k is non-positive or either list is empty.\n    if k <= 0 or not list1 or not list2:\n        return []\n\n    # Delegate the computation to a LargeProductFunction instance and return its result.\n    return LargeProductFunction(list1, list2, k).execute()\n```"}
{"task_id": "Mbpp/306", "solution": "```python\n# src/__init__.py\nfrom .sequence_function import max_sum_increasing_subseq\n\n# src/domain.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass Array:\n    \"\"\"Data holder for an input array and its length.\"\"\"\n    elements: list[int]\n    length: int\n\n@dataclass\nclass Index:\n    \"\"\"Holds index values for validation and computation.\"\"\"\n    i: int\n    k: int\n\n@dataclass\nclass Subsequence:\n    \"\"\"Represents a subsequence selection and its sum.\"\"\"\n    elements: list[int]\n    sum: int\n\nclass ValidationError(Exception):\n    \"\"\"Represents a validation failure with a descriptive message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n# src/sequence_function.py\nfrom src.domain import Array, Index, Subsequence, ValidationError\n\n\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"Validate inputs and compute maximum sum per design specification.\n    Raises ValidationError on invalid inputs.\"\"\"\n\n    # Input validation as per design\n    if not (0 <= i < n):\n        raise ValidationError(f\"Index i ({i}) is out of bounds [0, {n-1}]\")\n    if not (0 <= k < n):\n        raise ValidationError(f\"Index k ({k}) is out of bounds [0, {n-1}]\")\n    if not (k > i):\n        raise ValidationError(f\"Index k ({k}) must be strictly greater than i ({i})\")\n\n    target_val = arr[k]\n    \n    # dp[j] stores the maximum sum of an increasing subsequence ending with arr[j] (0 <= j <= i),\n    # where arr[j] must be strictly less than target_val (arr[k]).\n    dp = [0] * (i + 1)\n    \n    max_sum_from_prefix = 0 # Stores the maximum `dp[j]` found for j in 0..i.\n\n    for j in range(i + 1):\n        if arr[j] < target_val:\n            current_element_sum = arr[j]\n            # Find the best previous subsequence to extend\n            for prev_j in range(j):\n                if arr[prev_j] < arr[j] and arr[prev_j] < target_val:\n                    current_element_sum = max(current_element_sum, dp[prev_j] + arr[j])\n            \n            dp[j] = current_element_sum\n            max_sum_from_prefix = max(max_sum_from_prefix, dp[j])\n\n    # If no qualifying elements were found in arr[0..i] (i.e., all were >= arr[k] or no arr[j] < arr[k]),\n    # max_sum_from_prefix will remain 0.\n    if max_sum_from_prefix == 0:\n        return target_val\n    else:\n        return max_sum_from_prefix + target_val\n```"}
{"task_id": "Mbpp/308", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import List, Union\n\n\n# Domain types\n@dataclass(frozen=True)\nclass Element:\n    \"\"\"Encapsulates a single numeric value from an input list.\"\"\"\n    value: float\n\n@dataclass\nclass NumberList:\n    \"\"\"Lightweight wrapper around a Python list to represent an ordered collection of numeric elements.\"\"\"\n    elements: List[Element]\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass Product:\n    \"\"\"Holds a computed product value and references to factor Elements.\"\"\"\n    value: float\n    factorA: Element\n    factorB: Element\n\n@dataclass\nclass ResultSet:\n    \"\"\"Collects Product instances and provides stable sorting and top-n selection.\"\"\"\n    products: List[Product]\n\n    def sort_desc(self) -> None:\n        \"\"\"Sorts products in-place descending by Product.value using a stable sort.\"\"\"\n        self.products.sort(key=lambda p: p.value, reverse=True)\n\n    def top(self, n: int) -> List[float]:\n        \"\"\"Returns the top-n product values as a list of floats.\"\"\"\n        if n <= 0:\n            return []\n        return [p.value for p in self.products[:n]]\n\n\n# Helper functions\n# The _validate_inputs helper is omitted due to the critical constraint forbidding\n# isinstance() checks, type guards, and raising exceptions for edge cases.\n\ndef _generate_products(listA: Union[list, tuple], listB: Union[list, tuple]) -> List[Product]:\n    \"\"\"Generates Product instances for all ordered pairs (a, b) from listA and listB.\n    Returns an empty list if either input list is empty.\n    \"\"\"\n    products = []\n    if not listA or not listB:\n        return []\n    for a_val in listA:\n        for b_val in listB:\n            factorA = Element(float(a_val))\n            factorB = Element(float(b_val))\n            products.append(Product(factorA.value * factorB.value, factorA, factorB))\n    return products\n\ndef _sort_products_desc(products: List[Product]) -> List[Product]:\n    \"\"\"Returns a new list of Product instances sorted descending by value using stable sort.\n    Python's built-in sorted() (Timsort) is stable.\n    \"\"\"\n    return sorted(products, key=lambda p: p.value, reverse=True)\n\ndef _select_top_n(sorted_products: List[Product], n: int) -> List[float]:\n    \"\"\"Returns a list of top-n product values (floats) from a sorted list.\n    Returns an empty list if n is non-positive or if sorted_products is empty.\n    \"\"\"\n    if n <= 0 or not sorted_products:\n        return []\n    return [p.value for p in sorted_products[:n]]\n\n\ndef large_product(listA: Union[list, tuple], listB: Union[list, tuple], n: int) -> list:\n    \"\"\"Return the n largest pairwise products (descending) selecting one element from listA and one from listB.\n    Input validation and error raising are omitted due to critical code generation constraints.\n    \"\"\"\n    # Handles empty input lists or n == 0 as per requirements, returning an empty list.\n    if n <= 0 or not listA or not listB:\n        return []\n\n    # Generate all pairwise products as Product objects.\n    products = _generate_products(listA, listB)\n    if not products: # This handles cases where _generate_products returned an empty list.\n        return []\n\n    # Sort the products in descending order by their value.\n    sorted_products = _sort_products_desc(products)\n\n    # Select the top n product values.\n    final_result = _select_top_n(sorted_products, n)\n\n    return final_result\n```"}
