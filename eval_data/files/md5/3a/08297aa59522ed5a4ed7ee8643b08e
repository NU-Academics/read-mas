{"task_id": "Mbpp/167", "solution": "```\nsrc/\n\u251c\u2500\u2500 __init__.py\n\u2514\u2500\u2500 next_power_of_2.py\ntests/\n\u2514\u2500\u2500 test_next_power_of_2.py\n```\n\n**src/__init__.py**\n```python\n\"\"\"Package initializer; re-exports public API for easy import.\"\"\"\nfrom .next_power_of_2 import next_power_of_2\n```\n\n**src/next_power_of_2.py**\n```python\nfrom typing import Any\n\nclass NextPowerOf2Function:\n    \"\"\"Domain class providing internal operations for finding the next power of 2.\"\"\"\n\n    def validate_input(self, n: Any) -> None:\n        \"\"\"Raises ValueError if n is not an integer or n < 0.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n\n    def compute_power(self, n: int) -> int:\n        \"\"\"Compute smallest power of two >= n (assumes n validated).\"\"\"\n        if n == 0:\n            return 1\n        power = 1\n        while power < n:\n            power <<= 1\n        return power\n\n    def next_power_of_2(self, n: int) -> int:\n        \"\"\"Validate and compute smallest power of two >= n.\n        Raises ValueError on invalid input.\"\"\"\n        self.validate_input(n)\n        return self.compute_power(n)\n\n# Instantiate the domain class for internal use\n_impl = NextPowerOf2Function()\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"Public API: returns the smallest power of two p such that p >= n.\"\"\"\n    return _impl.next_power_of_2(n)\n```\n\n**tests/test_next_power_of_2.py**\n```python\nimport pytest\nfrom src.next_power_of_2 import next_power_of_2\n\ndef test_next_power_of_2_zero():\n    \"\"\"Test case for n = 0, which should return 1.\"\"\"\n    assert next_power_of_2(0) == 1\n\ndef test_next_power_of_2_boundaries():\n    \"\"\"Test cases for various boundary and typical valid inputs.\"\"\"\n    assert next_power_of_2(1) == 1\n    assert next_power_of_2(2) == 2\n    assert next_power_of_2(3) == 4\n    assert next_power_of_2(4) == 4\n    assert next_power_of_2(5) == 8\n    assert next_power_of_2(15) == 16\n    assert next_power_of_2(16) == 16\n    assert next_power_of_2(17) == 32\n    assert next_power_of_2(1023) == 1024\n    assert next_power_of_2(1024) == 1024\n\ndef test_next_power_of_2_invalid_inputs():\n    \"\"\"Test cases for invalid inputs that should raise ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be a non-negative integer.\"):\n        next_power_of_2(-1)\n    with pytest.raises(ValueError, match=\"Input must be an integer.\"):\n        next_power_of_2(3.5)\n    with pytest.raises(ValueError, match=\"Input must be an integer.\"):\n        next_power_of_2('x')\n    with pytest.raises(ValueError, match=\"Input must be an integer.\"):\n        next_power_of_2(None)\n```"}
