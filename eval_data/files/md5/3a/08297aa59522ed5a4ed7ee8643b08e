{"task_id": "Mbpp/19", "solution": "```python\n# src/test_duplicate.py\n\nclass InputArray:\n    \"\"\"Holds input values and their length.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n        self.length = len(values)\n\nclass Result:\n    \"\"\"Holds the boolean result of duplicate detection.\"\"\"\n    def __init__(self, hasDuplicate: bool) -> None:\n        self.hasDuplicate = hasDuplicate\n\nclass DuplicateDetector:\n    \"\"\"Detects duplicates using a single-pass set approach.\"\"\"\n    def hasDuplicate(self, input_values: list[int]) -> bool:\n        \"\"\"\n        Checks for duplicates in a list using a set.\n        Returns True if a duplicate is found, False otherwise.\n        \"\"\"\n        seen = set()\n        for item in input_values:\n            if item in seen:\n                return True\n            seen.add(item)\n        return False\n\nclass TestDuplicate:\n    \"\"\"Orchestrates the duplicate detection use case.\"\"\"\n    def execute(self, input_list: list[int]) -> Result:\n        \"\"\"\n        Executes the duplicate detection process.\n        Returns a Result object indicating if duplicates exist.\n        \"\"\"\n        input_array = InputArray(input_list)\n        detector = DuplicateDetector()\n        has_duplicate = detector.hasDuplicate(input_array.values)\n        return Result(has_duplicate)\n\ndef test_duplicate(input: list[int]) -> bool:\n    \"\"\"\n    Public API: returns True if the input list contains duplicates, False otherwise.\n    Delegates to the TestDuplicate orchestrator.\n    \"\"\"\n    orchestrator = TestDuplicate()\n    result = orchestrator.execute(input)\n    return result.hasDuplicate\n```\n\n```python\n# tests/unit_test.py\n\nfrom src.test_duplicate import test_duplicate\n\nclass UnitTest:\n    \"\"\"Contains unit tests for the test_duplicate function.\"\"\"\n    def assert_test_duplicate(self) -> None:\n        \"\"\"\n        Asserts that test_duplicate behaves correctly for a distinct array.\n        Prints a success message if the assertion passes.\n        \"\"\"\n        test_case = [1, 2, 3, 4, 5]\n        expected_result = False\n        actual_result = test_duplicate(test_case)\n        assert actual_result == expected_result, \\\n            f\"Test failed: Expected {expected_result} for {test_case}, got {actual_result}\"\n        print(f\"Test passed: test_duplicate({test_case}) == {expected_result}\")\n\nif __name__ == \"__main__\":\n    test_runner = UnitTest()\n    test_runner.assert_test_duplicate()\n```"}
{"task_id": "Mbpp/20", "solution": "```python\n# src/woodall.py\nfrom typing import Optional\n\nclass WoodallChecker:\n    \"\"\"Checks if a number is a Woodall number.\n    It implements the core search algorithm for k per BR3.\"\"\"\n\n    def is_woodall(self, number: 'Number') -> bool:\n        \"\"\"Return True iff exists k >= 1 such that number.value == k * 2**k - 1.\"\"\"\n        return self._find_k(number.value) is not None\n\n    def _find_k(self, n: int) -> Optional[int]:\n        \"\"\"Return k if found, else None.\n        Iterate k = 1.. until expression > n.\"\"\"\n        k = 1\n        while True:\n            expression_value = self._compute_expression(k)\n            if expression_value == n:\n                return k\n            if expression_value > n:\n                return None\n            k += 1\n\n    def _compute_expression(self, k: int) -> int:\n        \"\"\"Return k * 2**k - 1, a helper method for the Woodall expression.\"\"\"\n        return k * (2**k) - 1\n\n```\n```python\n# src/test_case.py\nfrom dataclasses import dataclass\nfrom typing import Optional\nfrom src.api import is_woodall # TestCase calls the API function\n\n@dataclass\nclass Number:\n    \"\"\"A simple dataclass to encapsulate an integer value.\"\"\"\n    value: int\n\nclass TestCase:\n    \"\"\"Encapsulates an acceptance test case.\n    It holds input, expected result, and runs the test.\"\"\"\n    def __init__(self, input: Number, expected: bool):\n        self.input = input\n        self.expected = expected\n        self.passed: Optional[bool] = None\n\n    def run(self) -> bool:\n        \"\"\"Call api.is_woodall(self.input.value), set self.passed, and return pass/fail.\"\"\"\n        actual_result = is_woodall(self.input.value)\n        self.passed = (actual_result == self.expected)\n        return self.passed\n\n```\n```python\n# src/api.py\nfrom src.test_case import Number\nfrom src.woodall import WoodallChecker\n\ndef is_woodall(number: int) -> bool:\n    \"\"\"This is the public API function to check if a number is Woodall.\n    It coerces input to Number, then delegates to WoodallChecker.\"\"\"\n    woodall_number = Number(number)\n    checker = WoodallChecker()\n    return checker.is_woodall(woodall_number)\n\n```\n```python\n# src/main.py\nimport sys\nfrom src.test_case import Number, TestCase\nfrom src.api import is_woodall # Included as per design's suggested imports\n\ndef main() -> int:\n    \"\"\"Entry point for the application, running the acceptance test.\n    It constructs and runs the predefined TestCase, returning an exit code.\"\"\"\n    print(\"Running acceptance test: is_woodall(383) == True\")\n    tc = TestCase(Number(383), True)\n    passed = tc.run()\n\n    if passed:\n        print(\"Acceptance test PASSED.\")\n        return 0\n    else:\n        print(f\"Acceptance test FAILED: Expected {tc.expected}, got different result.\")\n        return 1\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```"}
{"task_id": "Mbpp/20", "solution": "class ComputationResult:\n    \"\"\"DTO representing the outcome of a Woodall check, including the witness k.\"\"\"\n    def __init__(self, isWoodall: bool, k: int | None):\n        self.isWoodall = isWoodall\n        self.k = k\n\nclass WoodallChecker:\n    \"\"\"Implements the Woodall number checking algorithm.\"\"\"\n\n    @staticmethod\n    def find_k(n: int) -> int | None:\n        \"\"\"Searches for an integer k >= 1 such that n = k * 2^k - 1.\"\"\"\n        k = 1\n        while True:\n            value = k * (2 ** k) - 1\n            if value == n:\n                return k\n            if value > n: # Terminate search when value exceeds n.\n                return None\n            k += 1\n\n    @staticmethod\n    def is_woodall(n: int) -> bool:\n        \"\"\"Returns True if n is a Woodall number, otherwise False.\"\"\"\n        return WoodallChecker.find_k(n) is not None\n\nclass InputNumber:\n    \"\"\"Encapsulates and conceptually validates an input integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Always returns True, trusting caller's input as valid per critical requirements.\"\"\"\n        # Critical requirements forbid isinstance checks and raising exceptions.\n        # Thus, we assume inputs are always valid (int > 0) and return True.\n        return True\n\nclass SystemInterface:\n    \"\"\"Orchestrates input validation and Woodall number checking.\"\"\"\n    # The public `is_woodall` function will wrap this logic.\n\n    @staticmethod\n    def is_woodall(n: int) -> bool:\n        \"\"\"\n        Public API to check if an integer n is a Woodall number.\n        Orchestrates input validation and the Woodall checking algorithm.\n        \"\"\"\n        # Per critical requirements, type checking and exception raising are forbidden.\n        # Validation result is implicitly trusted without branching/exceptions.\n        input_num = InputNumber(n)\n        _ = input_num.validate() \n\n        return WoodallChecker.is_woodall(n)\n\n# The package-level public API function.\nis_woodall = SystemInterface.is_woodall"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"Determines if an integer n is one less than twice its decimal-digit reverse.\"\"\"\n    \n    # Compute the decimal-digit reverse of n, dropping any leading zeros produced by reversal.\n    # For example, reverse(120) -> 21. abs() handles potential negative inputs correctly for digit reversal.\n    rev = int(str(abs(n))[::-1])\n    \n    # Evaluate the condition: n == 2 * reverse(n) - 1.\n    return n == (2 * rev - 1)"}
{"task_id": "Mbpp/56", "solution": "```python\nfrom typing import List\n\nclass Number:\n    \"\"\"Represents an integer and provides access to its decimal digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.is_negative = value < 0\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns decimal digits of abs(value) in most-significant-first order.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return [0]\n        return [int(d) for d in str(abs_value)]\n\nclass ReverseOperation:\n    \"\"\"Computes the integer formed by reversing decimal digits.\"\"\"\n    @staticmethod\n    def reverseNumber(n: int) -> int:\n        \"\"\"Reverses decimal digits of n, discarding leading zeros after reversal.\"\"\"\n        number_obj = Number(n)\n        if number_obj.value == 0:\n            return 0\n        \n        digits = number_obj.digits()\n        reversed_digits_str = ''.join(map(str, reversed(digits)))\n        \n        # int() naturally handles leading zeros (e.g., '07' becomes 7).\n        reversed_n = int(reversed_digits_str)\n        return reversed_n\n\n# Module-level alias for ReverseOperation.reverseNumber\nreverse = ReverseOperation.reverseNumber\n\nclass CheckFunction:\n    \"\"\"Evaluates the predicate n == 2 * reverse(n) - 1.\"\"\"\n    @staticmethod\n    def check(n: int) -> bool:\n        \"\"\"Checks if n is one less than twice its reverse.\"\"\"\n        rev_n = reverse(n)\n        return n == (2 * rev_n) - 1\n\n# Module-level API function, delegating to CheckFunction.check\ncheck = CheckFunction.check\n```"}
{"task_id": "Mbpp/57", "solution": "```python\nfrom typing import List\n\nclass Digit:\n    \"\"\"Represents a single decimal digit value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def __int__(self) -> int:\n        \"\"\"Returns the integer value of the digit.\"\"\"\n        return self.value\n\nclass DigitList:\n    \"\"\"Encapsulates a collection of Digit objects; validates and sorts.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self.digits: List[Digit] = [Digit(d) for d in digits]\n\n    def validateDigits(self) -> bool:\n        \"\"\"Checks if all digits are within the valid range [0-9].\"\"\"\n        for digit_obj in self.digits:\n            if not (0 <= int(digit_obj) <= 9):\n                return False\n        return True\n\n    def sortDigitsDescending(self) -> List[int]:\n        \"\"\"Returns a list of integer digits sorted in descending order.\"\"\"\n        int_digits = [int(d) for d in self.digits]\n        int_digits.sort(reverse=True)\n        return int_digits\n\nclass MaxNumber:\n    \"\"\"Combines ordered digits into a final integer value.\"\"\"\n    def __init__(self, digits_descending: List[int]) -> None:\n        if not digits_descending:\n            self.value = 0\n            return\n\n        s_digits = [str(d) for d in digits_descending]\n        self.value = int(\"\".join(s_digits))\n\n    def get_value(self) -> int:\n        \"\"\"Returns the combined integer value.\"\"\"\n        return self.value\n\nclass FindMaxNumService:\n    \"\"\"Orchestrates the process of finding the maximum number from digits.\"\"\"\n    def find_Max_Num(self, digits: List[int]) -> int:\n        \"\"\"Builds, validates, sorts digits, and constructs the max number.\"\"\"\n        digit_list_obj = DigitList(digits)\n\n        if not digit_list_obj.validateDigits():\n            raise ValueError(\"Input list contains non-digit values or values outside 0-9 range.\")\n\n        sorted_digits = digit_list_obj.sortDigitsDescending()\n        max_number_obj = MaxNumber(sorted_digits)\n        return max_number_obj.get_value()\n\n_find_max_num_service = FindMaxNumService()\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number from a list of digits.\n    Delegates to FindMaxNumService for core logic.\n    \"\"\"\n    return _find_max_num_service.find_Max_Num(digits)\n```"}
{"task_id": "Mbpp/57", "solution": "```python\n# src/sorter.py\ndef sort_desc(digits: list) -> list:\n    \"\"\"Sorts a list of integer digits in descending order.\n    Duplicates are preserved in the sorted list.\n    \"\"\"\n    return sorted(digits, reverse=True)\n\n```\n```python\n# src/concatenator.py\ndef concatenate(digits: list) -> int:\n    \"\"\"Converts a list of digits into a single integer by concatenation.\n    For example, [3, 2, 1] becomes 321.\n    \"\"\"\n    return int(\"\".join(map(str, digits)))\n\n```\n```python\n# src/find_max_num.py\nfrom .sorter import sort_desc\nfrom .concatenator import concatenate\n\ndef find_Max_Num(digits: list) -> int:\n    \"\"\"Finds the largest integer constructible from the supplied digits.\n    It validates input, sorts digits descending, and concatenates them.\n    \"\"\"\n    if not isinstance(digits, list):\n        raise ValueError(\"Input must be a list.\")\n    if not digits:\n        raise ValueError(\"digits list must be non-empty and contain integers 0..9.\")\n\n    for digit in digits:\n        if not isinstance(digit, int) or not (0 <= digit <= 9):\n            raise ValueError(\"digits list must be non-empty and contain integers 0..9.\")\n\n    sorted_digits = sort_desc(digits)\n    result_int = concatenate(sorted_digits)\n    return result_int\n\n```\n```python\n# tests/test_find_max_num.py\nfrom src.find_max_num import find_Max_Num\n\ndef test_find_max_num_example():\n    \"\"\"Asserts find_Max_Num([1,2,3]) == 321 as per SRS example.\"\"\"\n    assert find_Max_Num([1, 2, 3]) == 321\n\n```"}
{"task_id": "Mbpp/58", "solution": "```python\n# opposite_Signs.py\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"Checks if two integers have opposite signs.\n    Returns True if one is strictly positive and the other strictly negative.\"\"\"\n    return (a > 0 and b < 0) or (a < 0 and b > 0)\n\n```\n```python\n# test_opposite_Signs.py\nfrom opposite_Signs import opposite_Signs\n\nclass TestCase:\n    \"\"\"A simple test case class to execute a specific assertion.\n    It holds a description string for the assertion it performs.\"\"\"\n    def __init__(self, assertion: str) -> None:\n        self.assertion = assertion\n\n    def run(self) -> None:\n        \"\"\"Executes the SRS-specified assertion and reports the result.\"\"\"\n        if not opposite_Signs(1, -2):\n            raise AssertionError(f\"Test failed: {self.assertion}\")\n        print(f\"Test passed: {self.assertion}\")\n\nif __name__ == '__main__':\n    srs_assertion_string = \"assert opposite_Signs(1, -2) == True\"\n    test_case = TestCase(srs_assertion_string)\n    test_case.run()\n\n```"}
