{"task_id": "Mbpp/65", "solution": "```python\n# src/recursive_list_sum.py\nfrom typing import Any, List\n\ndef _recursive_sum(element: Any) -> int:\n    \"\"\"Return sum for element which is either int (returns its value) or list (sum of members).\n    This helper performs the core recursive traversal and accumulation.\n    \"\"\"\n    if isinstance(element, int):\n        return element\n    elif isinstance(element, list):\n        return sum(_recursive_sum(item) for item in element)\n    # Per critical requirements, we trust caller's input and do not raise TypeError\n    # for unexpected element types explicitly. Python's default behavior will apply.\n    return 0 # Default return for unsupported types, assuming the caller will not provide them.\n\n\ndef recursive_list_sum(input_list: List[Any]) -> int:\n    \"\"\"Computes the total sum of all integers found recursively within input_list.\n    This function delegates the recursive traversal to a helper, assuming valid list input.\n    \"\"\"\n    # Per critical requirements, we trust input_list is a list and do not add\n    # isinstance() checks or raise TypeError for the top-level input.\n    return _recursive_sum(input_list)\n\n```\n```python\n# tests/test_recursive_list_sum.py\nfrom src.recursive_list_sum import recursive_list_sum\n\ndef run_tests() -> None:\n    \"\"\"Execute test assertions to verify the recursive_list_sum function.\n    It includes the example from the design specification.\n    \"\"\"\n    # Example from design document\n    assert recursive_list_sum(([1, 2, [3,4],[5,6]])) == 21\n    print(\"All tests passed!\")\n\nif __name__ == '__main__':\n    run_tests()\n\n```"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple, Union\n\nclass SubjectMark:\n    \"\"\"Represents a subject and its mark.\"\"\"\n    def __init__(self, subject_name: str, mark: int) -> None:\n        self.subject_name = subject_name\n        self.mark = mark\n\n    def to_tuple(self) -> Tuple[str, int]:\n        \"\"\"Converts the SubjectMark instance to a (subject_name, mark) tuple.\"\"\"\n        return (self.subject_name, self.mark)\n\nclass SubjectMarksCollection:\n    \"\"\"Manages a collection of SubjectMark instances.\"\"\"\n    def __init__(self, marks: Union[List[Tuple[str, int]], List['SubjectMark']]) -> None:\n        self._marks: List[SubjectMark] = []\n        for item in marks:\n            # Construct SubjectMark instances from tuples or add existing SubjectMark objects.\n            if isinstance(item, tuple):\n                self._marks.append(SubjectMark(item[0], item[1]))\n            else: # Assume item is a SubjectMark instance.\n                self._marks.append(item)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the collection is empty.\"\"\"\n        return not self._marks\n\n    def to_list(self) -> List[Tuple[str, int]]:\n        \"\"\"Converts the collection to a list of (subject_name, mark) tuples.\"\"\"\n        return [sm.to_tuple() for sm in self._marks]\n\nclass SubjectMarksService:\n    \"\"\"Provides business logic for sorting SubjectMarks.\"\"\"\n    @staticmethod\n    def subject_marks(marks: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n        \"\"\"Sorts a list of subject marks by their mark in ascending order.\n        Handles an empty input list by returning an empty list.\"\"\"\n        if not marks:\n            return []\n        \n        # Convert input tuples into SubjectMark objects for sorting.\n        subject_mark_objects = [SubjectMark(s_name, mark) for s_name, mark in marks]\n        \n        # Sort the SubjectMark objects based on their 'mark' attribute.\n        sorted_objects = sorted(subject_mark_objects, key=lambda sm: sm.mark)\n        \n        # Use SubjectMarksCollection to convert the sorted objects back to a list of tuples.\n        sorted_collection = SubjectMarksCollection(sorted_objects)\n        \n        return sorted_collection.to_list()\n\ndef subject_marks(marks: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"Public API function to sort a list of (subject_name, mark) tuples.\"\"\"\n    return SubjectMarksService.subject_marks(marks)"}
{"task_id": "Mbpp/65", "solution": "```python\ndef flatten(list):\n    \"\"\"Recursively flattens a list of lists into a single list.\n    Preserves order of atomic elements.\"\"\"\n    result = []\n    for item in list:\n        if isinstance(item, list):\n            result.extend(flatten(item))\n        else:\n            result.append(item)\n    return result\n\ndef recursive_list_sum(inputList):\n    \"\"\"Flattens a list of lists and sums its numeric elements.\n    Returns 0 if no numeric elements are present.\"\"\"\n    flattened_elements = flatten(inputList)\n    \n    numeric_elements = [element for element in flattened_elements if isinstance(element, (int, float))]\n    \n    return sum(numeric_elements)\n```"}
