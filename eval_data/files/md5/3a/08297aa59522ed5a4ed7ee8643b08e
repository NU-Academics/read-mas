{"task_id": "Mbpp/294", "solution": "```python\nfrom typing import Any, List, Optional, Union\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _extract_numeric_values(input_list: List[Any]) -> List[Union[int, float]]:\n    \"\"\"Extracts all numeric (int or float) values from a list.\"\"\"\n    return [val for val in input_list if _is_numeric(val)]\n\ndef max_val(inputList: List[Any]) -> Optional[Union[int, float]]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Ignores non-numeric elements and returns None if no numerics are found.\n    \"\"\"\n    numeric_values = _extract_numeric_values(inputList)\n    if not numeric_values:\n        return None\n    return max(numeric_values)\n```"}
{"task_id": "Mbpp/294", "solution": "To implement the software design specification, the following files will be created in the specified structure.\n\n---\n**`src/__init__.py`**\n```python\n# src/__init__.py\n\"\"\"Package marker for the src module.\"\"\"\n```\n\n---\n**`src/max_val.py`**\n```python\n\"\"\"Module providing the max_val function to find the maximum numeric value in a list.\"\"\"\n\ndef is_numeric(value) -> bool:\n    \"\"\"Determines if a value is an integer or a float.\n    This function is a helper for filtering list elements.\n    \"\"\"\n    return isinstance(value, (int, float))\n\ndef _extract_numeric_values(list) -> list:\n    \"\"\"Extracts all numeric values (int or float) from the input list.\n    Non-numeric elements are ignored as specified.\n    \"\"\"\n    numeric_elements = []\n    for item in list:\n        if is_numeric(item):\n            numeric_elements.append(item)\n    return numeric_elements\n\ndef max_val(list):\n    \"\"\"Finds the maximum numeric value in a heterogeneous list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    # Validate input type as specified in the design.\n    if not isinstance(list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Extract numeric values using the module-private helper.\n    nums = _extract_numeric_values(list)\n\n    # UC7: Behavior for zero numeric elements is unspecified in SRS.\n    # The design states to use `max(nums)`. If `nums` is empty, `max()` raises ValueError.\n    return max(nums)\n```\n\n---\n**`tests/test_max_val.py`**\n```python\nimport pytest\nfrom src.max_val import max_val\n\ndef test_example_case():\n    \"\"\"Verifies the example test case from the design specification.\"\"\"\n    assert max_val(['Python', 3, 2, 4, 5, 'version']) == 5\n\ndef test_int_float_mixed():\n    \"\"\"Ensures correct comparison and return for mixed int and float values.\"\"\"\n    assert max_val([1, 2.5, 2]) == 2.5\n\ndef test_non_list_raises_typeerror():\n    \"\"\"Confirms that a TypeError is raised for non-list inputs as per design.\"\"\"\n    with pytest.raises(TypeError):\n        max_val(123)\n    with pytest.raises(TypeError):\n        max_val(\"not a list\")\n    with pytest.raises(TypeError):\n        max_val(None)\n```"}
{"task_id": "Mbpp/296", "solution": "```python\nclass Array:\n    \"\"\"Minimal wrapper for input sequence to keep domain naming consistent.\n    Encapsulates the elements of the array.\n    \"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements: list = elements\n\nclass InversionResult:\n    \"\"\"Encapsulate computed inversion count.\n    Stores the non-negative integer result.\n    \"\"\"\n    def __init__(self, count: int) -> None:\n        self.count: int = count\n\nclass InversionCounter:\n    \"\"\"Stateless implementation of inversion-counting algorithm; produces InversionResult.\n    Uses a merge-sort based approach for efficiency.\n    \"\"\"\n    @staticmethod\n    def get_Inv_Count(array: list) -> int:\n        \"\"\"Compute and return inversion count for the provided list.\n        Delegates to the internal merge-sort helper.\n        \"\"\"\n        _, count = InversionCounter._merge_sort_count(array)\n        return count\n\n    @staticmethod\n    def _merge_sort_count(arr: list) -> tuple[list, int]:\n        \"\"\"Internal helper returning (sorted_list, inversion_count).\n        Recursively sorts and counts inversions during the merge step.\n        \"\"\"\n        n = len(arr)\n        if n <= 1:\n            return arr, 0\n\n        mid = n // 2\n        left_half, left_inversions = InversionCounter._merge_sort_count(arr[:mid])\n        right_half, right_inversions = InversionCounter._merge_sort_count(arr[mid:])\n\n        merged_arr = []\n        split_inversions = 0\n        i, j = 0, 0\n\n        while i < len(left_half) and j < len(right_half):\n            if left_half[i] <= right_half[j]:\n                merged_arr.append(left_half[i])\n                i += 1\n            else:\n                merged_arr.append(right_half[j])\n                j += 1\n                split_inversions += (len(left_half) - i)\n\n        merged_arr.extend(left_half[i:])\n        merged_arr.extend(right_half[j:])\n\n        total_inversions = left_inversions + right_inversions + split_inversions\n        return merged_arr, total_inversions\n\ndef get_Inv_Count(array) -> int:\n    \"\"\"Public API per FR1: accepts single parameter (array/list) and returns integer inversion count.\n    Delegates the counting logic to the InversionCounter class.\n    \"\"\"\n    return InversionCounter.get_Inv_Count(array)\n```"}
{"task_id": "Mbpp/297", "solution": "```python\ndef validate_input(input_value):\n    \"\"\"Placeholder for input validation.\n    Actual type checking or error raising is omitted due to critical requirements.\n    \"\"\"\n    return None\n\ndef _flatten_generator(item):\n    \"\"\"\n    An internal generator that yields non-list atomic elements from a nested structure.\n    It uses an explicit stack for iterative traversal to manage recursion depth.\n    \"\"\"\n    processing_stack = [item]\n\n    while processing_stack:\n        current_element = processing_stack.pop()\n\n        # Differentiate between lists and non-list (atomic) elements for flattening.\n        if isinstance(current_element, list):\n            # If it's a list, push its elements onto the stack in reverse order\n            # to maintain left-to-right processing.\n            for sub_element in reversed(current_element):\n                processing_stack.append(sub_element)\n        else:\n            # If it's not a list, it's an atomic element; yield it.\n            yield current_element\n\ndef flatten_list(input_list):\n    \"\"\"\n    Flattens a nested list into a new one-dimensional list of non-list elements.\n    Elements are processed in left-to-right traversal order without mutating the input.\n    \"\"\"\n    # Validate input as per the design specification.\n    # Note: actual validation logic involving type checks or error raising\n    # is omitted here due to critical requirements from the prompt.\n    validate_input(input_list)\n\n    # Collect and return all elements yielded by the internal generator.\n    # The `_flatten_generator` processes the input_list to extract all atomic items.\n    return list(_flatten_generator(input_list))\n```"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list):\n    \"\"\"\n    Flatten nested lists into a new list, traversing depth-first and left-to-right.\n    Only Python list instances are treated as containers to flatten; other types are considered atomic.\n    \"\"\"\n    result = []\n    stack = [iter(input_list)]\n\n    while stack:\n        current_iterator = stack[-1]\n        try:\n            item = next(current_iterator)\n            if isinstance(item, list):\n                stack.append(iter(item))\n            else:\n                result.append(item)\n        except StopIteration:\n            stack.pop()\n            \n    return result"}
{"task_id": "Mbpp/299", "solution": "```python\n# max_aggregate_project/src/__init__.py\n\"\"\"\nPackage marker for the max_aggregate_project.src module.\n\"\"\"\n\n# max_aggregate_project/src/models.py\nfrom typing import Dict, Tuple\n\nclass NameValueEntry:\n    \"\"\"Represents a name-value pair.\"\"\"\n    def __init__(self, name: str, value: int) -> None:\n        self.name = name\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"NameValueEntry(name='{self.name}', value={self.value})\"\n\nclass AggregationResult:\n    \"\"\"Holds the name and its total aggregate.\"\"\"\n    def __init__(self, name: str, total: int) -> None:\n        self.name = name\n        self.total = total\n\n    def as_tuple(self) -> Tuple[str, int]:\n        \"\"\"Returns the result as a (name, total) tuple.\"\"\"\n        return (self.name, self.total)\n\nclass AggregationMap:\n    \"\"\"Manages the aggregation of values by name.\"\"\"\n    def __init__(self) -> None:\n        self.totals: Dict[str, int] = {}\n\n    def add_entry(self, entry: NameValueEntry) -> None:\n        \"\"\"Adds or updates an entry's value to its name's total.\"\"\"\n        self.totals[entry.name] = self.totals.get(entry.name, 0) + entry.value\n\n    def get_total(self, name: str) -> int:\n        \"\"\"Returns the current total for a given name.\"\"\"\n        return self.totals.get(name, 0)\n\n    def get_max(self) -> AggregationResult:\n        \"\"\"Determines and returns the AggregationResult with the highest total.\"\"\"\n        if not self.totals:\n            return AggregationResult(\"\", 0) # Default for no entries\n        \n        max_name: str = \"\"\n        max_total: int = -float('inf')\n\n        # Iterates to find the maximum total, picking the first encountered in case of ties.\n        for name, total in self.totals.items():\n            if total > max_total:\n                max_total = total\n                max_name = name\n        \n        return AggregationResult(max_name, max_total)\n\n\n# max_aggregate_project/src/validator.py\nfrom typing import List, Tuple\nfrom max_aggregate_project.src.models import NameValueEntry\n\ndef validate_entry(entry: Tuple) -> NameValueEntry:\n    \"\"\"Validates a single tuple entry and converts it to NameValueEntry.\"\"\"\n    if not isinstance(entry, tuple):\n        raise TypeError(f\"Input entry must be a tuple, got {type(entry).__name__}\")\n    if len(entry) != 2:\n        raise ValueError(f\"Input tuple must have length 2, got {len(entry)}\")\n    \n    name, value = entry\n    if not isinstance(name, str):\n        raise TypeError(f\"First element of tuple must be a string, got {type(name).__name__}\")\n    if not isinstance(value, int):\n        raise TypeError(f\"Second element of tuple must be an integer, got {type(value).__name__}\")\n    \n    return NameValueEntry(name, value)\n\ndef validate_entries(entries: List[Tuple]) -> List[NameValueEntry]:\n    \"\"\"Validates a list of tuple entries and converts them to NameValueEntry instances.\"\"\"\n    if not isinstance(entries, list):\n        raise TypeError(f\"Input 'entries' must be a list, got {type(entries).__name__}\")\n    \n    validated_entries: List[NameValueEntry] = []\n    for entry in entries:\n        validated_entries.append(validate_entry(entry))\n    return validated_entries\n\n\n# max_aggregate_project/src/aggregator.py\nfrom typing import List\nfrom max_aggregate_project.src.models import NameValueEntry, AggregationMap, AggregationResult\n\ndef aggregate(entries: List[NameValueEntry]) -> AggregationMap:\n    \"\"\"Aggregates a list of NameValueEntry into an AggregationMap.\"\"\"\n    aggregation_map = AggregationMap()\n    for entry in entries:\n        aggregation_map.add_entry(entry)\n    return aggregation_map\n\ndef get_max_result(aggregation_map: AggregationMap) -> AggregationResult:\n    \"\"\"Retrieves the maximum aggregated result from an AggregationMap.\"\"\"\n    return aggregation_map.get_max()\n\n\n# max_aggregate_project/src/max_aggregate.py\nfrom typing import List, Tuple\nfrom max_aggregate_project.src.validator import validate_entries\nfrom max_aggregate_project.src.aggregator import aggregate, get_max_result\n\ndef max_aggregate(entries: List[Tuple]) -> Tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of name-value tuples.\n    This function orchestrates validation, aggregation, and result extraction.\n    \"\"\"\n    validated = validate_entries(entries)\n    aggregation_map = aggregate(validated)\n    result = get_max_result(aggregation_map)\n    return result.as_tuple()\n```"}
{"task_id": "Mbpp/300", "solution": "```python\nimport math\n\n\"\"\"Provides count_binary_seq(n) to compute specific binary sequence counts. Caller must pass an integer n.\"\"\"\ndef count_binary_seq(n: int) -> float:\n    \"\"\"Compute the number of binary sequences of length 2*n where sum of first n bits equals sum of last n. Returns a float, using the identity C(2n, n).\"\"\"\n    result_int = math.comb(2 * n, n)\n    return float(result_int)\n```"}
{"task_id": "Mbpp/301", "solution": "```python\n# src/__init__.py\n```\n\n```python\n# src/dict_depth.py\nfrom typing import Any, Dict\n\nclass DictDepthFunction:\n    \"\"\"\n    Encapsulates the recursive algorithm to compute the maximum nesting depth of a dictionary.\n    Top-level dictionary counts as depth 1; non-dictionary values do not increase depth.\n    \"\"\"\n    def computeDepth(self, input_dict: Dict[Any, Any]) -> int:\n        \"\"\"\n        Calculates the maximum nesting depth of the given dictionary.\n        Returns an integer representing the depth.\n        \"\"\"\n        max_child_depth = 0\n        for value in input_dict.values():\n            if isinstance(value, dict):\n                current_child_depth = self.computeDepth(value)\n                max_child_depth = max(max_child_depth, current_child_depth)\n        return 1 + max_child_depth\n\ndef dict_depth(input_dict: Dict[Any, Any]) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of a Python dictionary.\n    Delegates the computation to DictDepthFunction for traceability and separation of concerns.\n    \"\"\"\n    impl = DictDepthFunction()\n    return impl.computeDepth(input_dict)\n\n```\n\n```python\n# tests/test_dict_depth.py\nfrom src.dict_depth import dict_depth\n\ndef test_example_assertion():\n    \"\"\"\n    Verifies the example assertion from the SRS.\n    Checks a deeply nested dictionary.\n    \"\"\"\n    assert dict_depth({'a':1, 'b': {'c': {'d': {}}}}) == 4\n\ndef test_empty_dict_depth():\n    \"\"\"\n    Ensures an empty dictionary is correctly identified with depth 1.\n    \"\"\"\n    assert dict_depth({}) == 1\n\ndef test_non_dict_leaves():\n    \"\"\"\n    Tests that non-dictionary values are treated as leaves and do not increment depth.\n    \"\"\"\n    assert dict_depth({'a': {'b': 1}}) == 2\n    assert dict_depth({'a': {'b': {'c': 'text'}}}) == 3\n\ndef test_shallow_dict():\n    \"\"\"\n    Checks a dictionary with only top-level key-value pairs or direct empty dicts.\n    \"\"\"\n    assert dict_depth({'a':1, 'b':2}) == 1\n    assert dict_depth({'x': 'y', 'z': {}}) == 2\n    assert dict_depth({'x': 'y', 'z': {'k': 1}}) == 2\n\n```"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"Compute and return the maximum dictionary nesting depth.\n\n    Precondition: input_dict must be a dictionary (per design). Returns an integer >= 1 when precondition is met.\n    \"\"\"\n    current_level_depth = 1 \n    \n    max_nested_dict_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            # Recursively compute the depth of the nested dictionary.\n            nested_depth = dict_depth(value)\n            if nested_depth > max_nested_dict_depth:\n                max_nested_dict_depth = nested_depth\n                \n    return current_level_depth + max_nested_dict_depth"}
{"task_id": "Mbpp/300", "solution": "```python\nimport math\n\ndef _validate_input(n):\n    \"\"\"\n    This helper function is intended for input validation as per the design.\n    However, critical requirements prohibit adding validation logic here.\n    \"\"\"\n    pass\n\ndef _compute_count_combination(n):\n    \"\"\"\n    Computes the binomial coefficient C(2n, n) using math.comb or math.factorial as a fallback.\n    This value represents the count of binary sequences as per the combinatorial identity.\n    \"\"\"\n    try:\n        # math.comb is available from Python 3.8+\n        return math.comb(2 * n, n)\n    except AttributeError:\n        # Fallback for older Python versions if math.comb is not available.\n        # It is assumed n is a non-negative integer based on caller's trusted input.\n        return math.factorial(2 * n) // (math.factorial(n) * math.factorial(n))\n\ndef count_binary_seq(n):\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits, using the identity C(2n, n).\n    \"\"\"\n    _validate_input(n)\n    return _compute_count_combination(n)\n```"}
{"task_id": "Mbpp/299", "solution": "```python\n# src/__init__.py\n\"\"\"Package initializer for max_aggregate.\"\"\"\n\n__all__ = [\"max_aggregate\"]\n\nfrom .max_aggregate import max_aggregate\n\n```\n```python\n# src/max_aggregate.py\nfrom typing import Iterable, Tuple, Optional, List, Dict, Iterator\nimport numbers\n\nclass AggregatedResult:\n    \"\"\"Immutable-like data carrier for an aggregated name and its total.\"\"\"\n\n    def __init__(self, name: str, total: float):\n        self.name = name\n        self.total = total\n\n    def as_tuple(self) -> Tuple[str, float]:\n        \"\"\"Returns the result as a (name, total) tuple.\"\"\"\n        return (self.name, self.total)\n\n    def __iter__(self) -> Iterator[str | float]:\n        \"\"\"Allows conversion to a tuple, e.g., tuple(result_object).\"\"\"\n        yield self.name\n        yield self.total\n\n    def __repr__(self) -> str:\n        \"\"\"String representation for debugging.\"\"\"\n        return f\"AggregatedResult(name='{self.name}', total={self.total})\"\n\n\nclass Validator:\n    \"\"\"Validates the structure and types of input entries.\"\"\"\n\n    def validate(self, entries: Iterable[Tuple]) -> None:\n        \"\"\"\n        Ensures each entry is a 2-element tuple/list, with a string name and a numeric value.\n        Raises TypeError for any validation failure.\n        \"\"\"\n        try:\n            for i, entry in enumerate(entries):\n                if not isinstance(entry, (tuple, list)):\n                    raise TypeError(f\"Entry at index {i} must be a tuple or list, got {type(entry).__name__}.\")\n                if len(entry) != 2:\n                    raise TypeError(f\"Entry at index {i} must have exactly 2 elements, got {len(entry)}.\")\n                if not isinstance(entry[0], str):\n                    raise TypeError(f\"Entry at index {i}, element 0 (name) must be a string, got {type(entry[0]).__name__}.\")\n                if not isinstance(entry[1], numbers.Number):\n                    raise TypeError(f\"Entry at index {i}, element 1 (value) must be numeric, got {type(entry[1]).__name__}.\")\n        except TypeError as e:\n            # This catches TypeErrors from non-iterable 'entries' (e.g. enumerate(None))\n            # or the specific validation checks within the loop.\n            raise e\n        except Exception as e:\n            # Catch any other unexpected errors during iteration or validation.\n            raise TypeError(f\"An unexpected error occurred during input validation: {e}\")\n\n\nclass Aggregator:\n    \"\"\"Performs grouping, summation, and selects the maximum aggregated result.\"\"\"\n\n    def aggregate(self, entries: Iterable[Tuple[str, numbers.Number]]) -> List[AggregatedResult]:\n        \"\"\"\n        Aggregates all numeric values per identical name.\n        Returns a list of AggregatedResult instances for all distinct names.\n        \"\"\"\n        totals: Dict[str, float] = {}\n        for name, value in entries:\n            totals[name] = totals.get(name, 0.0) + float(value)\n        \n        return [AggregatedResult(name, total) for name, total in totals.items()]\n\n    def max_aggregate(self, entries: Iterable[Tuple[str, numbers.Number]]) -> Optional[AggregatedResult]:\n        \"\"\"\n        Aggregates values by name and finds the name with the highest total.\n        Applies a first-encountered tie-break.\n        \"\"\"\n        current_totals: Dict[str, float] = {}\n        max_total: float = -float('inf')\n        max_name: Optional[str] = None\n        has_entries = False\n\n        for name, value in entries:\n            has_entries = True\n            current_totals[name] = current_totals.get(name, 0.0) + float(value)\n            current_sum = current_totals[name]\n\n            if current_sum > max_total:\n                max_total = current_sum\n                max_name = name\n            # If current_sum == max_total, we do nothing to preserve the existing max_name,\n            # ensuring the \"first encountered\" tie-break.\n\n        if not has_entries:\n            return None\n        \n        # If has_entries is True, max_name must have been set to the first valid name encountered.\n        # This handles cases where all values might be e.g. NaN if numbers.Number allowed them\n        # to ensure the return type contract.\n        if max_name is None: \n            return None \n\n        return AggregatedResult(max_name, max_total)\n\n\ndef max_aggregate(entries: Iterable[Tuple[str, numbers.Number]]) -> Optional[Tuple[str, float]]:\n    \"\"\"\n    Calculates the name with the highest aggregated total from a list of entries.\n    It validates input, aggregates values, and applies a first-encountered tie-break, \n    returning (name, total) or None for empty input.\n    \"\"\"\n    validator = Validator()\n    validator.validate(entries)\n\n    aggregator = Aggregator()\n    result = aggregator.max_aggregate(entries)\n\n    if result is None:\n        return None\n    else:\n        return result.as_tuple()\n\n```"}
{"task_id": "Mbpp/305", "solution": "```python\nfrom typing import List, Tuple\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    \"\"\"Concrete container for the ordered list of input strings.\"\"\"\n    strings: List[str]\n\n@dataclass\nclass Word:\n    \"\"\"Represents a tokenized word with position and predicate state.\"\"\"\n    text: str\n    position: int\n    starts_with_p: bool\n\n@dataclass\nclass MatchResult:\n    \"\"\"Return DTO containing the tuple of matched words.\"\"\"\n    matched_words: Tuple[str, str]\n\ndef _tokenize(s: str) -> List[str]:\n    \"\"\"Splits a string on any whitespace into tokens, preserving order.\"\"\"\n    return s.split()\n\ndef _is_p_start(word: str) -> bool:\n    \"\"\"Checks if a non-empty word's first character casefolded is 'p'.\"\"\"\n    return bool(word and word[0].casefold() == 'p')\n\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Orchestrates tokenization, matching, and selection to return\n    the first two 'p'-starting words in discovery order.\n    \"\"\"\n    matched_words_found = []\n    for input_string in input_list:\n        tokens = _tokenize(input_string)\n        for token in tokens:\n            if _is_p_start(token):\n                matched_words_found.append(token)\n                if len(matched_words_found) == 2:\n                    return tuple(matched_words_found)\n    return tuple(matched_words_found)\n```"}
{"task_id": "Mbpp/305", "solution": "src/__init__.py\nfrom .start_withp import start_withp\n\nsrc/start_withp.py\nfrom typing import List, Tuple\n\n\"\"\"Module: start_withp\nPublic API:\n  def start_withp(lines: List[str]) -> Tuple[str, str]\n\"\"\"\n\ndef _split_on_whitespace(line: str) -> List[str]:\n    \"\"\"Return list of tokens by splitting the input line on whitespace.\n    Uses str.split() without arguments to handle various whitespace and empty tokens.\n    \"\"\"\n    return line.split()\n\ndef _is_p_word(token: str) -> bool:\n    \"\"\"Return True if token begins with 'p' or 'P', False otherwise.\n    Checks the first character in a case-insensitive manner.\n    \"\"\"\n    return len(token) > 0 and token[0].lower() == 'p'\n\ndef start_withp(lines: List[str]) -> Tuple[str, str]:\n    \"\"\"Return the first two words starting with 'p' or 'P' encountered when splitting each input line on whitespace.\n    Preserves original casing and returns as a tuple.\n    \"\"\"\n    found_matches = []\n    for line in lines:\n        tokens = _split_on_whitespace(line)\n        for token in tokens:\n            if _is_p_word(token):\n                found_matches.append(token)\n                if len(found_matches) == 2:\n                    return tuple(found_matches)"}
