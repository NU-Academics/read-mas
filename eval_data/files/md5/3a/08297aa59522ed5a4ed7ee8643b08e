{"task_id": "Mbpp/456", "solution": "```python\n# reverse_string_list_system/src/__init__.py\n# An empty file to mark 'src' as a Python package.\n\n\n# reverse_string_list_system/src/reverse_string_list.py\nfrom typing import List\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"\n    Reverses a single string character-wise.\n    This is a module-private helper function.\n    \"\"\"\n    return s[::-1]\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of strings, preserving order.\n    Returns a new list with the reversed strings.\n    \"\"\"\n    return [_reverse_string(s) for s in input_list]\n\n\n# reverse_string_list_system/src/cli.py\nimport sys\nfrom src.reverse_string_list import reverse_string_list\n\ndef _run_example_assertion() -> bool:\n    \"\"\"\n    Runs the exact example assertion from SRS and returns True on success.\n    Prints the result of the assertion for user feedback.\n    \"\"\"\n    input_strings = ['Red', 'Green', 'Blue', 'White', 'Black']\n    expected_output = ['deR', 'neerG', 'eulB', 'etihW', 'kcalB']\n    actual_output = reverse_string_list(input_strings)\n\n    if actual_output == expected_output:\n        print(f\"Example assertion PASSED.\")\n        print(f\"Input: {input_strings}\")\n        print(f\"Expected: {expected_output}\")\n        print(f\"Actual: {actual_output}\")\n        return True\n    else:\n        print(f\"Example assertion FAILED.\")\n        print(f\"Input: {input_strings}\")\n        print(f\"Expected: {expected_output}\")\n        print(f\"Actual: {actual_output}\")\n        return False\n\ndef main() -> int:\n    \"\"\"\n    Entry point for the CLI/test harness.\n    Calls the example assertion and returns 0 for success, 1 for failure.\n    \"\"\"\n    if _run_example_assertion():\n        return 0\n    else:\n        return 1\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n\n# reverse_string_list_system/tests/test_reverse_string_list.py\nfrom src.reverse_string_list import reverse_string_list\n\ndef test_reverse_string_list_example():\n    \"\"\"\n    Verifies the reverse_string_list function with the example from the SRS.\n    Checks that the output matches the expected reversed list.\n    \"\"\"\n    assert reverse_string_list(['Red', 'Green', 'Blue', 'White', 'Black']) == ['deR', 'neerG', 'eulB', 'etihW', 'kcalB']\n\ndef test_reverse_string_list_empty():\n    \"\"\"\n    Verifies that an empty input list returns an empty list.\n    Tests the handling of an empty list according to requirements.\n    \"\"\"\n    assert reverse_string_list([]) == []\n```"}
{"task_id": "Mbpp/456", "solution": "```python\n# src/reverse_string_list.py\n# -*- coding: utf-8 -*-\n\"\"\"A module for reversing strings within a list by Unicode code point.\nIt provides a single function to transform a list of strings into a new list of reversed strings.\n\"\"\"\n\nfrom typing import List\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"Reverse each string in input_list by Unicode code point and return a new list.\n\n    Raises TypeError if any element in input_list is not a str.\n    \"\"\"\n    reversed_list: List[str] = []\n    for item in input_list:\n        if not isinstance(item, str):\n            raise TypeError(f\"List elements must be strings, but found type {type(item).__name__}.\")\n        reversed_list.append(item[::-1])\n    return reversed_list\n\n```\n```python\n# tests/test_reverse_string_list.py\nimport pytest\nfrom src.reverse_string_list import reverse_string_list\n\ndef test_reverse_string_list():\n    \"\"\"Verify the primary functionality with the example assert.\"\"\"\n    assert reverse_string_list(['Red', 'Green', 'Blue', 'White', 'Black']) == ['deR', 'neerG', 'eulB', 'etihW', 'kcalB']\n\ndef test_empty_input():\n    \"\"\"Ensure an empty list input returns an empty list.\"\"\"\n    assert reverse_string_list([]) == []\n\ndef test_non_string_element():\n    \"\"\"Check that a TypeError is raised for non-string elements.\"\"\"\n    with pytest.raises(TypeError, match=\"List elements must be strings, but found type int\"):\n        reverse_string_list(['hello', 123, 'world'])\n    with pytest.raises(TypeError, match=\"List elements must be strings, but found type float\"):\n        reverse_string_list(['test', 3.14])\n    with pytest.raises(TypeError, match=\"List elements must be strings, but found type NoneType\"):\n        reverse_string_list(['test', None])\n\ndef test_unicode_handling():\n    \"\"\"Confirm correct reversal of Unicode strings by code point.\"\"\"\n    assert reverse_string_