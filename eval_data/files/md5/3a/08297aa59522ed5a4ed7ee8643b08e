{"task_id": "Mbpp/607", "solution": "```python\n# src/find_literals.py\n\nimport re\n\nclass MatchResult:\n    \"\"\"Lightweight container for a successful regex match.\"\"\"\n    def __init__(self, matched_text: str, start_index: int, end_index: int):\n        self.matched_text = matched_text\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def as_tuple(self) -> tuple[str, int, int]:\n        \"\"\"Returns the match data as a tuple.\"\"\"\n        return (self.matched_text, self.start_index, self.end_index)\n\ndef find_literals(input_string, regex_pattern):\n    \"\"\"Search input_string for the first occurrence of regex_pattern.\n    Returns a tuple (matched_text, start_index, end_index); raises ValueError if no match.\n    \"\"\"\n    match = re.search(regex_pattern, input_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        raise ValueError('No match found')\n\n```\n```python\n# tests/test_find_literals.py\n\nimport pytest\nfrom src.find_literals import find_literals\n\ndef test_find_literals_example():\n    \"\"\"Verifies the core example assertion from the SRS.\"\"\"\n    assert find_literals('The quick brown fox jumps over the lazy dog.', 'fox') == ('fox', 16, 19)\n\ndef test_find_literals_no_match():\n    \"\"\"Confirms ValueError is raised when no match is found.\"\"\"\n    with pytest.raises(ValueError, match='No match found'):\n        find_literals('The quick brown dog jumps over the lazy cat.', 'bear')\n\n```"}
{"task_id": "Mbpp/608", "solution": "```python\ndef bell_Number(n):\n    # This function computes the nth Bell number using the Bell triangle algorithm.\n    # It assumes n is a non-negative integer as per critical requirements.\n\n    if n == 0:\n        return 1\n\n    current_row = [1]  # Represents the row for B0\n\n    # Generate Bell triangle rows up to the nth row\n    for _ in range(1, n + 1):\n        next_row = [current_row[-1]]  # First element of new row is last of previous row\n        for j in range(len(current_row)):\n            next_row.append(current_row[j] + next_row[-1])  # Subsequent elements are sums\n        current_row = next_row\n    \n    # The nth Bell number is the first element of the nth row generated\n    return current_row[0]\n```"}
{"task_id": "Mbpp/608", "solution": "```python\ndef _bell_triangle_row(prev_row: list[int]) -> list[int]:\n    \"\"\"Given previous Bell triangle row, compute the next row.\n    The first element of the new row is the last of the previous.\n    \"\"\"\n    next_row = [prev_row[-1]]\n    for i in range(len(prev_row)):\n        next_row.append(next_row[-1] + prev_row[i])\n    return next_row\n\ndef _compute_bell(n: int) -> int:\n    \"\"\"Compute nth Bell number using Bell triangle algorithm (internal use).\"\"\"\n    if n == 0:\n        return 1\n\n    current_row = [1]\n    for _ in range(n):\n        current_row = _bell_triangle_row(current_row)\n    \n    return current_row[0]\n\ndef bell_Number(n: int) -> int:\n    \"\"\"Return the nth Bell number as an int.\n    It computes the Bell number using the Bell triangle algorithm.\n    \"\"\"\n    return _compute_bell(n)\n```"}
{"task_id": "Mbpp/610", "solution": "```python\n# src/remove_kth_element.py\ndef remove_kth_element(list_input, k):\n    \"\"\"Return a new list with k'th (1-based) element removed. Does not modify list_input.\"\"\"\n    # Convert 1-based index k to 0-based index for Python list operations.\n    idx = k - 1\n    # Concatenate list slices before and after the element to be removed.\n    return list_input[:idx] + list_input[idx+1:]\n```\n```python\n# tests/test_remove_kth_element.py\nfrom src.remove_kth_element import remove_kth_element\n\ndef test_example_assertion():\n    \"\"\"Verify remove_kth_element correctly processes the provided example assertion.\n    This acceptance test validates the core requirement.\n    \"\"\"\n    assert remove_kth_element([1,1,2,3,4,4,5,1], 3) == [1, 1, 3, 4, 4, 5, 1]\n```"}
{"task_id": "Mbpp/610", "solution": "def validate_input(lst, k):\n    \"\"\"\n    This helper function would typically validate inputs,\n    but is a no-op per critical requirements to omit checks and exceptions.\n    \"\"\"\n    pass\n\n\ndef create_result(lst, k):\n    \"\"\"\n    Creates a shallow copy of the list with the k'th element removed.\n    k is a 1-based index; converts to 0-based for internal use.\n    \"\"\"\n    new_list = lst[:]  # Create a shallow copy\n    zero_based_index = k - 1\n    # Reconstruct the list without the element at the specified index\n    return new_list[:zero_based_index] + new_list[zero_based_index + 1:]\n\n\ndef remove_kth_element(lst, k):\n    \"\"\"\n    Removes the k'th element (1-based index) from a list, returning a new shallow copy.\n    Coordinates input validation (skipped per critical requirements) and result creation.\n    \"\"\"\n    validate_input(lst, k)  # Calls the no-op validation helper\n    return create_result(lst, k)\n\n\ndef execute(lst, k):\n    \"\"\"\n    Alias for the public remove_kth_element function, as per design.\n    It calls remove_kth_element(lst, k).\n    \"\"\"\n    return remove_kth_element(lst, k)"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Computes the maximum numeric value in the nth column (zero-based) of a matrix.\n    Relies on Python's natural IndexError for empty matrices or rows missing the nth element.\n    \"\"\"\n    current_max = matrix[0][n]\n    for i in range(1, len(matrix)):\n        row = matrix[i]\n        value = row[n]\n        if value > current_max:\n            current_max = value\n    return current_max"}
{"task_id": "Mbpp/611", "solution": "```python\nfrom typing import List, Union, Iterator\n\nclass Row:\n    \"\"\"Represents a single row of numeric values in a matrix.\"\"\"\n    def __init__(self, values: List[Union[int, float]]):\n        self.values = values\n\n    def get_at(self, index: int) -> Union[int, float]:\n        \"\"\"Returns the value at the specified zero-based index. Raises IndexError if missing.\"\"\"\n        return self.values[index]\n\nclass Matrix:\n    \"\"\"Represents a matrix as an ordered collection of Row objects.\"\"\"\n    def __init__(self, rows_data: List[List[Union[int, float]]]):\n        self.rows: List[Row] = [Row(row_data) for row_data in rows_data]\n\n    def __iter__(self) -> Iterator[Row]:\n        \"\"\"Allows iteration over the rows of the matrix.\"\"\"\n        return iter(self.rows)\n\nclass MaxOfNthUtility:\n    \"\"\"Utility to compute the maximum value for the n-th column of a Matrix.\"\"\"\n    def max_of_nth(self, matrix: Matrix, n: int) -> Union[int, float]:\n        \"\"\"Reads the n-th element from each Row and computes the maximum value.\"\"\"\n        column_values: List[Union[int, float]] = []\n        for row in matrix:\n            # Row.get_at raises IndexError if the element is missing, propagating as per design.\n            column_values.append(row.get_at(n))\n        \n        # max() raises ValueError if column_values is empty (e.g., matrix was empty).\n        return max(column_values)\n\ndef max_of_nth(matrix: List[List[Union[int, float]]], n: int) -> Union[int, float]:\n    \"\"\"\n    Computes the maximum value in the n-th column of the given matrix.\n    This function delegates computation to MaxOfNthUtility.\n    \"\"\"\n    # Per critical requirements, explicit input validation (e.g., isinstance checks) is omitted.\n    # Behavior for invalid inputs or empty matrix relies on natural Python exceptions.\n    \n    matrix_obj = Matrix(matrix)\n    return MaxOfNthUtility().max_of_nth(matrix_obj, n)\n```"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List\n\ndef merge(pairs: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Transforms a list of 2-element sublists into a list containing two lists.\n    The first output list has the first element of each input sublist, and the second has the second.\n    \"\"\"\n    first_elements: List[Any] = []\n    second_elements: List[Any] = []\n\n    for pair in pairs:\n        first_elements.append(pair[0])\n        second_elements.append(pair[1])\n\n    return [first_elements, second_elements]"}
