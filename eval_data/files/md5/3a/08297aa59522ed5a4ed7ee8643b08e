{"task_id": "Mbpp/230", "solution": "```python\n# src/replace_blank.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Data holder for the source text string.\"\"\"\n    text: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input text.\"\"\"\n        return len(self.text)\n\n@dataclass\nclass ReplacementCharacter:\n    \"\"\"Data holder for the single replacement character.\"\"\"\n    char: str\n\n    def is_valid(self) -> bool:\n        \"\"\"Performs light validation for the character (non-empty).\"\"\"\n        return len(self.char) >= 1\n\n@dataclass\nclass ResultString:\n    \"\"\"Data holder for the resulting text string after replacement.\"\"\"\n    text: str\n\nclass ReplaceOperation:\n    \"\"\"Encapsulates the algorithm to replace spaces in a string.\"\"\"\n    def replace(self, input: InputString, replacer: ReplacementCharacter) -> ResultString:\n        \"\"\"\n        Scans input text, replaces each literal ' ' with replacer.char,\n        preserving other characters and their order.\n        \"\"\"\n        result_chars = []\n        for char in input.text:\n            if char == ' ':\n                result_chars.append(replacer.char)\n            else:\n                result_chars.append(char)\n        return ResultString(text=\"\".join(result_chars))\n\ndef replace_blank(input_string: str, replacement_char: str) -> str:\n    \"\"\"\n    Replaces every literal blank space character ' ' with the provided replacement_char\n    and returns the resulting string.\n    \"\"\"\n    # Public API function that composes domain objects and delegates to ReplaceOperation.\n    input_obj = InputString(text=input_string)\n    replacement_char_obj = ReplacementCharacter(char=replacement_char)\n\n    operation = ReplaceOperation()\n    result_obj = operation.replace(input_obj, replacement_char_obj)\n\n    return result_obj.text\n\n# src/__init__.py\nfrom .replace_blank import replace_blank\n```"}
{"task_id": "Mbpp/232", "solution": "```python\nimport heapq\n\ndef _validate_inputs(list, n):\n    \"\"\"\n    This function is a structural placeholder; critical requirements forbid type checks.\n    It always indicates valid inputs as per critical requirements.\n    \"\"\"\n    return (True, \"\")\n\ndef _select_n_largest(list, n):\n    \"\"\"\n    Selects up to n largest numeric items from the input list.\n    If n is greater than or equal to the list length, a shallow copy of the list is returned.\n    \"\"\"\n    if not list:\n        return []\n    \n    if n >= len(list):\n        return list(list)\n\n    return heapq.nlargest(n, list)\n\ndef larg_nnum(list, n):\n    \"\"\"\n    Returns a list containing up to n largest numeric items from the input list.\n    Handles edge cases like n <= 0 and n exceeding list length.\n    \"\"\"\n    # Step 1: Call _validate_inputs. It always returns True per critical requirements.\n    is_valid, _ = _validate_inputs(list, n)\n    if not is_valid:\n        return []\n\n    # Step 2: If n <= 0, return [] (derived behavior).\n    if n <= 0:\n        return []\n\n    # Step 3: Call _select_n_largest to compute up to n largest items.\n    result = _select_n_largest(list, n)\n\n    # Step 4: Return selected list (len(result) <= n).\n    return result\n```"}
