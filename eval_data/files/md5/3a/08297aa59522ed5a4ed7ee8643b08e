{"task_id": "Mbpp/284", "solution": "```\n./src/check_element.py\n```python\nclass EqualityComparator:\n    \"\"\"Performs equality comparison between two items using the '==' operator.\"\"\"\n    def compare(self, a, b) -> bool:\n        \"\"\"Returns True if a == b, False otherwise.\"\"\"\n        return a == b\n\nclass BooleanResult:\n    \"\"\"A simple container for a boolean value.\"\"\"\n    def __init__(self, value: bool):\n        \"\"\"Initializes with the given boolean value.\"\"\"\n        self.value = value\n\n# Global instance of EqualityComparator for use by check_element\n_comparator = EqualityComparator()\n\ndef check_element(list, element) -> bool:\n    \"\"\"Checks if every item in the list equals the provided element.\n    Returns True if all items match, False otherwise; an empty list is vacuously true.\"\"\"\n    for item in list:\n        if not _comparator.compare(item, element):\n            return False\n    return True\n\nclass CheckElementFunction:\n    \"\"\"Wrapper to encapsulate list and element for deferred execution.\"\"\"\n    def __init__(self, list, element):\n        \"\"\"Stores the list and element for later comparison.\"\"\"\n        self.list = list\n        self.element = element\n\n    def execute(self) -> bool:\n        \"\"\"Executes the check_element function with the stored inputs.\"\"\"\n        return check_element(self.list, self.element)\n\n```\n\n```\n./tests/test_check_element.py\n```python\nimport pytest\nfrom src.check_element import check_element, EqualityComparator, BooleanResult, CheckElementFunction\n\ndef test_provided_assertion():\n    \"\"\"Tests the negative example provided in the requirements.\"\"\"\n    assert check_element([\"green\", \"orange\", \"black\", \"white\"], 'blue') == False\n\ndef test_all_equal():\n    \"\"\"Asserts that a list where all items are equal returns True.\"\"\"\n    assert check_element(['x','x','x'], 'x') == True\n\ndef test_single_element():\n    \"\"\"Asserts that a list with a single matching element returns True.\"\"\"\n    assert check_element(['only'], 'only') == True\n\ndef test_empty_list_behavior():\n    \"\"\"Documents and asserts that an empty list returns True (vacuously true).\"\"\"\n    assert check_element([], 'any') == True\n\ndef test_some_not_equal():\n    \"\"\"Tests a list with mixed elements, expecting False.\"\"\"\n    assert check_element([1, 2, 1], 1) == False\n\ndef test_different_types_not_equal():\n    \"\"\"Tests comparison of an element against items of different types.\"\"\"\n    assert check_element([1, \"1\", 1], 1) == False\n\ndef test_check_element_function_wrapper():\n    \"\"\"Verifies the functionality of the CheckElementFunction wrapper class.\"\"\"\n    wrapper_all_equal = CheckElementFunction(['a', 'a'], 'a')\n    assert wrapper_all_equal.execute() == True\n\n    wrapper_not_equal = CheckElementFunction(['a', 'b'], 'a')\n    assert wrapper_not_equal.execute() == False\n\ndef test_boolean_result_class():\n    \"\"\"Verifies the simple container functionality of BooleanResult.\"\"\"\n    result_true = BooleanResult(True)\n    assert result_true.value == True\n\n    result_false = BooleanResult(False)\n    assert result_false.value == False\n\ndef test_equality_comparator_class():\n    \"\"\"Verifies the comparison logic of the EqualityComparator class.\"\"\"\n    comparator = EqualityComparator()\n    assert comparator.compare(1, 1) == True\n    assert comparator.compare(1, 2) == False\n    assert comparator.compare(\"hello\", \"hello\") == True\n    assert comparator.compare(\"hello\", \"world\") == False\n    assert comparator.compare(1, 1.0) == True # Python's default float-int comparison\n\n```"}
{"task_id": "Mbpp/285", "solution": "import re\n\nclass InputString:\n    \"\"\"Holds the raw input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\n\nclass Pattern:\n    \"\"\"Encapsulates a regex pattern and provides a matching method.\"\"\"\n    def __init__(self, regex: str) -> None:\n        self.regex: str = regex\n        self._compiled = re.compile(regex)\n\n    def matches(self, input_str: str) -> bool:\n        \"\"\"Checks if the compiled regex finds a match anywhere in the given string.\"\"\"\n        return self._compiled.search(input_str) is not None\n\nclass Result:\n    \"\"\"Holds the boolean outcome of a pattern match.\"\"\"\n    def __init__(self, matches: bool) -> None:\n        self.matches: bool = matches\n\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'abb' (two 'b's) or 'abbb' (three 'b's).\n    This function utilizes helper classes for traceability and pattern matching.\n    \"\"\"\n    input_str_obj = InputString(input)\n    pattern_obj = Pattern(r\"ab{2,3}\")\n    matched = pattern_obj.matches(input_str_obj.value)\n    result_obj = Result(matched)\n    return result_obj.matches"}
