{"task_id": "Mbpp/748", "solution": "```python\nimport string\nfrom dataclasses import dataclass\n\n@dataclass\nclass Character:\n    \"\"\"Data carrier for one character and its classification.\"\"\"\n    char: str\n    category: str\n\n@dataclass\nclass InputString:\n    \"\"\"Wraps input string and provides convenience methods.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the input string is empty.\"\"\"\n        return not self.value\n\n@dataclass\nclass OutputString:\n    \"\"\"Collects output characters and produces the final string.\"\"\"\n    value: str\n\ndef classify_char(ch: str) -> str:\n    \"\"\"Classifies a single character into required categories (BR8).\"\"\"\n    if ch.isupper():\n        return 'upper'\n    elif ch.islower():\n        return 'lower'\n    elif ch.isdigit():\n        return 'digit'\n    elif ch.isspace():\n        return 'space'\n    elif ch in string.punctuation:\n        return 'punctuation'\n    else:\n        return 'other'\n\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"Transforms the input string by inserting spaces before capital letters (BR1-BR7).\"\"\"\n    input_obj = InputString(value=input)\n\n    if input_obj.is_empty():\n        return \"\" # BR7: Return empty string for empty input.\n\n    output_builder = []\n    \n    for i, current_char in enumerate(input_obj.value):\n        current_char_category = classify_char(current_char)\n\n        # BR2, BR3: Insert a space if current is uppercase and previous was lowercase or digit.\n        # BR4: Do not insert a space before the first character.\n        if i > 0:\n            previous_char = input_obj.value[i-1]\n            previous_char_category = classify_char(previous_char)\n\n            if current_char_category == 'upper' and previous_char_category in ('lower', 'digit'):\n                output_builder.append(' ')\n        \n        # BR5: Preserve existing characters and case.\n        # BR6: Avoid adding leading/trailing spaces beyond input.\n        output_builder.append(current_char)\n    \n    # Construct the final OutputString and return its value.\n    final_output_str = \"\".join(output_builder)\n    output_obj = OutputString(value=final_output_str)\n    return output_obj.value\n```"}
{"task_id": "Mbpp/749", "solution": "```python\nfrom typing import List\n\ndef _convert_to_int(s: str) -> int:\n    \"\"\"Converts a string to an integer, stripping whitespace.\n    Relies on Python's built-in int() for conversion.\n    \"\"\"\n    return int(s.strip())\n\ndef sort_numeric_strings(inputs: List[str]) -> List[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers and sorts them numerically.\n    Returns a new list with integers sorted in ascending order.\n    \"\"\"\n    integer_list = [_convert_to_int(s) for s in inputs]\n    integer_list.sort()\n    return integer_list\n```"}
