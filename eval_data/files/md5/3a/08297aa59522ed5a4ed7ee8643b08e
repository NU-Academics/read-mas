{"task_id": "Mbpp/74", "solution": "```python\nfrom typing import List, Dict, Any\n\nclass PatternChecker:\n    \"\"\"\n    PatternChecker enforces mapping consistency and uniqueness between items and patterns.\n    It uses two dictionaries to maintain bijective mapping state during validation.\n    \"\"\"\n    def __init__(self):\n        self._item_to_pattern: Dict[Any, Any] = {}\n        self._pattern_to_item: Dict[Any, Any] = {}\n\n    def is_samepatterns(self, items: List[Any], patterns: List[Any]) -> bool:\n        \"\"\"\n        Delegates to validate_lengths and check_mapping to determine if items follow patterns.\n        Returns True if a bijective mapping exists; otherwise False.\n        \"\"\"\n        if not self.validate_lengths(items, patterns):\n            return False\n        return self.check_mapping(items, patterns)\n\n    def validate_lengths(self, items: List[Any], patterns: List[Any]) -> bool:\n        \"\"\"\n        Checks if the lengths of items and patterns lists are equal.\n        Returns False if lengths differ, True otherwise.\n        \"\"\"\n        return len(items) == len(patterns)\n\n    def check_mapping(self, items: List[Any], patterns: List[Any]) -> bool:\n        \"\"\"\n        Iterates through pairs of items and patterns to enforce consistency and uniqueness.\n        It builds a bijective mapping and returns False on any violation.\n        \"\"\"\n        for i in range(len(items)):\n            item = items[i]\n            pattern = patterns[i]\n\n            # Enforce mapping consistency: if item was seen, it must map to the same pattern.\n            if item in self._item_to_pattern:\n                if self._item_to_pattern[item] != pattern:\n                    return False\n            \n            # Enforce mapping uniqueness: if pattern was seen, it must map to the same item.\n            if pattern in self._pattern_to_item:\n                if self._pattern_to_item[pattern] != item:\n                    return False\n\n            # Establish or confirm the bijective mapping.\n            self._item_to_pattern[item] = pattern\n            self._pattern_to_item[pattern] = item\n            \n        return True\n\ndef is_samepatterns(items: List[Any], patterns: List[Any]) -> bool:\n    \"\"\"\n    Public API to check if a list of items follows a given pattern sequence.\n    It returns a boolean indicating whether a bijective mapping exists across all indices.\n    \"\"\"\n    checker = PatternChecker()\n    return checker.is_samepatterns(items, patterns)\n```"}
{"task_id": "Mbpp/74", "solution": "```python\nfrom typing import Any, Dict, List, Optional\n\nclass Sequence:\n    \"\"\"Represents a sequence of elements for pattern matching.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self.elements)\n\n    def getAt(self, index: int) -> Any:\n        \"\"\"Retrieves the element at the specified index.\"\"\"\n        return self.elements[index]\n\nclass Element:\n    \"\"\"Represents a single element within a sequence.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass PatternMapping:\n    \"\"\"Manages the mapping from values in sequence1 to values in sequence2, ensuring consistency and injectivity.\"\"\"\n    def __init__(self) -> None:\n        self._map: Dict[Any, Any] = {}\n        self._reverse_map: Dict[Any, Any] = {} # Maps to_value -> from_value for injectivity checks\n\n    def addMapping(self, from_value: Any, to_value: Any) -> bool:\n        \"\"\"\n        Adds a mapping from from_value to to_value, enforcing consistency and injectivity.\n        Returns False if the mapping introduces inconsistency or a non-injective collision.\n        \"\"\"\n        # Check for consistency (FR4): If from_value is already mapped, its mapping must be to_value.\n        if from_value in self._map:\n            return self._map[from_value] == to_value\n        \n        # Check for non-injective collision (FR5): If to_value is already mapped to a DIFFERENT from_value.\n        # If to_value is in _reverse_map and maps to an existing, distinct from_value, it's not injective.\n        if to_value in self._reverse_map and self._reverse_map[to_value] != from_value:\n            return False\n        \n        # Add the new mapping as it's consistent and doesn't violate injectivity so far.\n        self._map[from_value] = to_value\n        self._reverse_map[to_value] = from_value\n        return True\n\n    def getMapping(self, from_value: Any) -> Optional[Any]:\n        \"\"\"Retrieves the mapped 'to_value' for a given 'from_value', or None if not mapped.\"\"\"\n        return self._map.get(from_value)\n\n    def isInjective(self) -> bool:\n        \"\"\"Checks if the overall mapping is injective (one-to-one).\"\"\"\n        # An injective mapping will have an equal number of unique from_values and to_values.\n        return len(self._map) == len(self._reverse_map)\n\n    def isConsistent(self) -> bool:\n        \"\"\"Checks if the mapping has maintained consistency. This is guaranteed if addMapping always returned True.\"\"\"\n        # If addMapping did not return False for any input, then consistency was maintained throughout.\n        return True\n\nclass IsSamePatternsFunction:\n    \"\"\"A static delegator class for the is_samepatterns function, aligning with the SRS concept.\"\"\"\n    @staticmethod\n    def is_samepatterns(sequence1: List[Any], sequence2: List[Any]) -> bool:\n        \"\"\"Delegates the call to the module-level is_samepatterns function.\"\"\"\n        return is_samepatterns(sequence1, sequence2)\n\nclass TestCase:\n    \"\"\"Represents a test case for validating the is_samepatterns function.\"\"\"\n    def __init__(self, s1: Sequence, s2: Sequence, expected: bool) -> None:\n        self.s1 = s1\n        self.s2 = s2\n        self.expected = expected\n\ndef is_samepatterns(sequence1: List[Any], sequence2: List[Any]) -> bool:\n    \"\"\"\n    Determines if sequence2 follows the same pattern as sequence1 by constructing and validating a mapping.\n    This function orchestrates input length validation, mapping construction, and injectivity checks.\n    \"\"\"\n    # 1. Validate input lengths (FR2)\n    if len(sequence1) != len(sequence2):\n        return False\n\n    # 2. Instantiate PatternMapping to store and validate the mapping\n    pattern_mapping = PatternMapping()\n\n    # 3. Iterate through sequences to build and validate the mapping element by element (FR3, FR4, FR5)\n    for i in range(len(sequence1)):\n        v1 = sequence1[i]\n        v2 = sequence2[i]\n        # Attempt to add mapping; if it violates consistency or injectivity, return False immediately.\n        if not pattern_mapping.addMapping(v1, v2):\n            return False\n\n    # 4. After processing all elements, perform a final check for overall injectivity (FR5).\n    if not pattern_mapping.isInjective():\n        return False\n\n    # 5. If all checks pass, the sequences follow the same pattern.\n    return True\n```"}
{"task_id": "Mbpp/75", "solution": "```python\ndef is_tuple_all_divisible(tuple, k):\n    \"\"\"Checks if every element in the given tuple is divisible by k.\n    Returns True if all elements satisfy divisibility, otherwise False.\"\"\"\n    for element in tuple:\n        if element % k != 0:\n            return False\n    return True\n\ndef find_tuples(list_of_tuples, k):\n    \"\"\"Filters a list of tuples, returning only those whose every element is divisible by k.\n    Preserves original tuple order in the result list.\"\"\"\n    result_list = []\n    for current_tuple in list_of_tuples:\n        if is_tuple_all_divisible(current_tuple, k):\n            result_list.append(current_tuple)\n    return result_list\n```"}
