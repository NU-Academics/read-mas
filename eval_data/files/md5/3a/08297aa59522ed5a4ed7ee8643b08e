ax_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "```python\n# src/lps.py\n\ndef lps(input: str) -> int:\n    \"\"\"Computes the length of the longest palindromic subsequence for the given string.\n    Uses dynamic programming, treating characters exactly as provided.\"\"\"\n    n = len(input)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the LPS of substring input[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for lengths 2 to n\n    # current_len is the length of the substring being considered\n    for current_len in range(2, n + 1):\n        for i in range(n - current_len + 1):\n            j = i + current_len - 1 # j is the end index of the current substring\n            if input[i] == input[j]:\n                if current_len == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n    return dp[0][n-1]\n```\n```python\n# tests/test_lps.py\nimport sys\nimport os\n\n# Adjust the Python path to allow importing from 'src' directory.\n# This assumes the test script is run from the project root.\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))\n\nfrom src.lps import lps\n\ndef run_acceptance_test() -> None:\n    \"\"\"Executes the concrete acceptance test for the lps function.\n    Asserts the expected length for a specific input string.\"\"\"\n    input_string = \"TENS FOR TENS\"\n    expected_length = 5\n    result = lps(input_string)\n    assert result == expected_length, f\"Acceptance test failed: lps('{input_string}') returned {result}, expected {expected_length}\"\n    print(f\"Acceptance test passed: lps('{input_string}') == {result}\")\n\n# Top-level assertion for direct script execution, as specified by the design.\nif __name__ == \"__main__\":\n    run_acceptance_test()\n```"}
{"task_id": "Mbpp/245", "solution": "import math\n\nclass InputArray:\n    \"\"\"Represents the input array of numeric values.\"\"\"\n    def __init__(self, values: list[float]):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.values)\n\nclass Element:\n    \"\"\"Represents a value from the input array along with its original index.\"\"\"\n    def __init__(self, value: float, index: int):\n        self.value = value\n        self.index = index\n\nclass Subsequence:\n    \"\"\"Represents an ordered list of Elements forming a subsequence.\"\"\"\n    def __init__(self, elements: list[Element]):\n        self.elements = elements\n\n    def sum(self) -> float:\n        \"\"\"Computes the sum of values in the subsequence.\"\"\"\n        return sum(e.value for e in self.elements)\n\n    def is_bitonic(self) -> bool:\n        \"\"\"Checks if the subsequence is strictly increasing then strictly decreasing.\"\"\"\n        n = len(self.elements)\n        if n == 0:\n            return False\n\n        vals = [e.value for e in self.elements]\n        \n        # Find the peak: strictly increasing part\n        i = 0\n        while i < n - 1 and vals[i] < vals[i+1]:\n            i += 1\n        \n        # Check for non-strict increase (plateau)\n        if i < n - 1 and vals[i] == vals[i+1]:\n            return False\n\n        # Strictly decreasing part\n        j = i\n        while j < n - 1 and vals[j] > vals[j+1]:\n            j += 1\n            \n        # Check for non-strict decrease (plateau)\n        if j < n - 1 and vals[j] == vals[j+1]:\n            return False\n            \n        return j == n - 1\n\nclass BitonicSubsequence(Subsequence):\n    \"\"\"A marker class for subsequences that are bitonic.\"\"\"\n    pass\n\nclass MaxSumResult:\n    \"\"\"A wrapper for the computed maximum sum result.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\ndef _compute_lis_sums(values: list[float]) -> list[float]:\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence ending at each index.\n    This uses an O(n^2) dynamic programming approach.\n    \"\"\"\n    n = len(values)\n    if n == 0:\n        return []\n\n    lis_sums = list(values) # Initialize LIS sum ending at i with value[i] itself\n\n    for i in range(n):\n        for j in range(i):\n            if values[j] < values[i]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + values[i])\n    return lis_sums\n\ndef _compute_lds_sums(values: list[float]) -> list[float]:\n    \"\"\"\n    Computes the maximum sum of a strictly decreasing subsequence starting at each index.\n    This uses an O(n^2) dynamic programming approach.\n    \"\"\"\n    n = len(values)\n    if n == 0:\n        return []\n\n    lds_sums = list(values) # Initialize LDS sum starting at i with value[i] itself\n\n    for i in range(n - 1, -1, -1): # Iterate from right to left\n        for j in range(n - 1, i, -1): # Look for elements to the right\n            if values[j] < values[i]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + values[i])\n    return lds_sums\n\ndef max_sum(values: list[float]) -> float:\n    \"\"\"\n    Computes the maximum sum of any bitonic subsequence of the given input array.\n    A bitonic sequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(values)\n\n    if n == 0:\n        return 0\n\n    lis_sums = _compute_lis_sums(values)\n    lds_sums = _compute_lds_sums(values)\n\n    max_overall_sum = float('-inf')\n\n    # For each element, consider it as the peak of a bitonic subsequence.\n    # The element values[i] is counted once in lis_sums[i] and once in lds_sums[i].\n    # Subtract values[i] once to get the sum of the bitonic subsequence.\n    for i in range(n):\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - values[i]\n        max_overall_sum = max(max_overall_sum, current_bitonic_sum)\n\n    # The design specifies returning an integer if all inputs are integers.\n    # However, critical requirements forbid `isinstance` checks for input validation or type determination.\n    # Therefore, the result will be a float, as dictated by the arithmetic operations.\n    return max_overall_sum\n"}
{"task_id": "Mbpp/247", "solution": "```python\n# src/lps.py\nimport typing\n\nclass InputString:\n    \"\"\"Represents the provided input string and exposes its value and length.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n    def length(self) -> int:\n        return len(self.value)\n\nclass PalindromicSubsequence:\n    \"\"\"Represents a candidate palindromic subsequence and provides helper to test palindromicity.\"\"\"\n    def __init__(self, sequence: str):\n        self.sequence: str = sequence\n        self.length: int = len(sequence)\n    def is_palindrome(self) -> bool:\n        return self.sequence == self.sequence[::-1]\n\nclass Result:\n    \"\"\"Encapsulates the computed LPS length.\"\"\"\n    def __init__(self, length: int):\n        self.length: int = length\n\nclass LPSFunction:\n    \"\"\"Stateless domain service implementing compute(s: str) -> int.\"\"\"\n    def compute(self, s: str) -> int:\n        \"\"\"\n        Computes the length of the longest palindromic subsequence using dynamic programming.\n        Handles empty strings and considers all characters, including whitespace.\n        \"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n\n        # dp[i][j] stores the length of the LPS of substring s[i...j]\n        dp = [[0] * n for _ in range(n)]\n\n        # Base case: single characters are palindromes of length 1\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the DP table for substrings of length 2 to n\n        # 'current_len' refers to the length of the substring being considered\n        for current_len in range(2, n + 1):\n            for i in range(n - current_len + 1):\n                j = i + current_len - 1\n                if s[i] == s[j]:\n                    # If end characters match, add 2 to LPS of inner substring\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n                else:\n                    # If end characters don't match, take max of removing one end\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n        \n        return dp[0][n - 1]\n\ndef lps(s: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence in a string.\n    Validates input type and delegates computation to LPSFunction.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"lps: argument must be a string\")\n    input_obj = InputString(s)\n    lps_fn = LPSFunction()\n    return lps_fn.compute(input_obj.value)\n```\n```python\n# tests/test_lps.py\nfrom src.lps import lps\n\ndef test_acceptance_assertion():\n    \"\"\"Verifies the specified acceptance criteria for the lps function.\"\"\"\n    assert lps(\"TENS FOR TENS\") == 5\n\nif __name__ == \"__main__\":\n    test_acceptance_assertion()\n    print(\"Acceptance test passed\")\n```"}
