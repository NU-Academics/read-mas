{"task_id": "Mbpp/14", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass TriangularPrism:\n    \"\"\"Holds input dimensions for triangular prism volume computation.\"\"\"\n    base: float\n    height: float\n    length: float\n\n@dataclass\nclass CalculationResult:\n    \"\"\"Holds the computed volume result.\"\"\"\n    volume: float\n\nclass VolumeCalculator:\n    \"\"\"Encapsulates the logic to compute the volume of a triangular prism.\"\"\"\n    def compute(self, prism: TriangularPrism) -> CalculationResult:\n        \"\"\"Computes the volume given a TriangularPrism object.\"\"\"\n        base_area = 0.5 * prism.base * prism.height\n        volume = base_area * prism.length\n        return CalculationResult(volume=volume)\n\ndef find_Volume(base, height, length):\n    \"\"\"\n    Public API to calculate the volume of a triangular prism.\n    Delegates the computation to VolumeCalculator using structured data holders.\n    \"\"\"\n    prism = TriangularPrism(base=float(base), height=float(height), length=float(length))\n    calculator = VolumeCalculator()\n    calc_result = calculator.compute(prism)\n    return calc_result.volume\n```"}
{"task_id": "Mbpp/16", "solution": "```python\n\"\"\"Module for text_lowercase_underscore function.\nChecks for pattern [a-z]+_[a-z]+ (ASCII lowercase only, exactly one underscore).\n\"\"\"\n\nfrom dataclasses import dataclass\nimport re\n\n# Compiled regex for the pattern [a-z]+_[a-z]+ (ASCII lowercase only, exactly one underscore).\n_PATTERN = re.compile(r\"[a-z]+_[a-z]+\")\n\n\n@dataclass\nclass InputString:\n    \"\"\"A wrapper for the input string.\"\"\"\n    value: str\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the wrapped string value is empty.\"\"\"\n        return self.value == \"\"\n\n\n@dataclass\nclass MatchResult:\n    \"\"\"Internal clarity container for match results.\"\"\"\n    matched: bool\n    matched_substring: str = \"\"\n\n\ndef containsPattern(input_string: str) -> bool:\n    \"\"\"Return True if input_string contains any substring matching [a-z]+_[a-z]+ (ASCII a-z only).\"\"\"\n    return bool(_PATTERN.search(input_string))\n\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"Public API: returns True if any matching substring exists; False for empty input or no matches.\n    Matches pattern [a-z]+_[a-z]+ (ASCII lowercase only, exactly one underscore).\"\"\"\n    input_obj = InputString(value=input_string)\n    if input_obj.isEmpty():\n        return False\n    else:\n        return containsPattern(input_string)\n```"}
{"task_id": "Mbpp/12", "solution": "```python\n# src/domain.py\n\nfrom typing import List, Optional, Union\n\nclass Number:\n    \"\"\"\n    Domain-level abstraction for a numeric element.\n    It wraps a float value.\n    \"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = float(value)\n\nclass Row:\n    \"\"\"\n    Represents a single row of numeric values (Number objects) with its original index.\n    Provides functionality to compute the sum of its elements.\n    \"\"\"\n    def __init__(self, values: List[Union[int, float]], index: int):\n        self.values = [Number(v) for v in values]\n        self.index = index\n\n    def sum(self) -> float:\n        \"\"\"Computes the sum of all numeric values (wrapped in Number objects) in the row.\"\"\"\n        return sum(n.value for n in self.values)\n\nclass Matrix:\n    \"\"\"\n    Represents a matrix composed of Row objects.\n    Provides functionality to convert back to a list of lists of floats.\n    \"\"\"\n    def __init__(self, rows: List[Row], id: Optional[int] = None):\n        self.rows = rows\n        self.id = id\n\n    def to_list_of_lists(self) -> List[List[float]]:\n        \"\"\"Converts the internal Row objects and their Number elements back to a list of lists of floats.\"\"\"\n        return [[n.value for n in row.values] for row in self.rows]\n\n```\n```python\n# src/sort_matrix.py\n\nfrom typing import List, Union\nfrom src.domain import Matrix, Row\n\nclass SortMatrixFunction:\n    \"\"\"\n    Orchestrates validation, row construction, sum computation, stable sorting,\n    and returning the matrix in the same representation as input.\n    \"\"\"\n    def sort_matrix(self, matrix_input: Union[Matrix, List[List[Union[int, float]]]]) -> Union[Matrix, List[List[float]]]:\n        \"\"\"\n        Sorts rows of a matrix by their sums, maintaining stability.\n        Processes either a Matrix object or a list-of-lists.\n        \"\"\"\n        is_list_input = not isinstance(matrix_input, Matrix)\n        \n        if is_list_input:\n            rows = []\n            for i, row_values in enumerate(matrix_input):\n                rows.append(Row(values=row_values, index=i))\n            internal_matrix = Matrix(rows=rows) \n        else:\n            internal_matrix = matrix_input\n\n        # Stable sort the rows by (row_sum, original_index).\n        # Python's sorted() is stable, and tuple key ensures secondary sort by original index.\n        sorted_rows = sorted(internal_matrix.rows, key=lambda row: (row.sum(), row.index))\n\n        if is_list_input:\n            # Convert back to list of lists of floats if original input was list of lists.\n            temp_matrix = Matrix(rows=sorted_rows)\n            return temp_matrix.to_list_of_lists()\n        else:\n            # If original input was a Matrix, return a new Matrix with sorted rows.\n            return Matrix(rows=sorted_rows, id=internal_matrix.id)\n\ndef _is_number(value) -> bool:\n    \"\"\"Helper to check if a value is an int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef sort_matrix(matrix: List[List[Union[int, float]]]) -> List[List[float]]:\n    \"\"\"\n    Public API to sort a matrix (list of lists of numbers) by row sums.\n    Validates input and delegates to SortMatrixFunction for processing.\n    \"\"\"\n    # Input validation ensures matrix is list-of-lists of numbers.\n    if not isinstance(matrix, list):\n        raise TypeError(\"Input matrix must be a list.\")\n    \n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise TypeError(f\"Row {i} must be a list, but got {type(row).__name__}.\")\n        for j, val in enumerate(row):\n            if not _is_number(val):\n                raise TypeError(f\"Element at [{i}][{j}] must be a number (int or float), but got {type(val).__name__}.\")\n    \n    # Delegate to SortMatrixFunction, which processes and returns the sorted list-of-lists.\n    sorter = SortMatrixFunction()\n    return sorter.sort_matrix(matrix)\n\n```\n```python\n# tests/test_sort_matrix.py\n\nimport pytest\nfrom src.sort_matrix import sort_matrix\n\ndef test_example_sort_matrix():\n    \"\"\"Tests the example assertion from the SRS document.\"\"\"\n    matrix = [[1, 2, 3], [2, 4, 5], [1, 1, 1]]\n    expected = [[1, 1, 1], [1, 2, 3], [2, 4, 5]]\n    assert sort_matrix(matrix) == expected\n\ndef test_empty_matrix():\n    \"\"\"Tests sorting an empty matrix, which should return an empty matrix.\"\"\"\n    assert sort_matrix([]) == []\n\ndef test_single_row_matrix():\n    \"\"\"Tests a matrix with a single row, which should remain unchanged.\"\"\"\n    matrix = [[5, 2, 8]]\n    assert sort_matrix(matrix) == [[5, 2, 8]]\n\ndef test_matrix_with_equal_sums():\n    \"\"\"Tests a matrix where rows have equal sums, ensuring original relative order is preserved.\"\"\"\n    matrix = [[1, 2, 3], [0, 6, 0], [1, 1, 4]]  # All sums are 6\n    expected = [[1, 2, 3], [0, 6, 0], [1, 1, 4]] # Original order is preserved\n    assert sort_matrix(matrix) == expected\n\ndef test_matrix_with_negative_values():\n    \"\"\"Tests a matrix containing negative numbers.\"\"\"\n    matrix = [[-1, -2, -3], [1, 1, 1], [-5, -1, 0]] # Sums: -6, 3, -6\n    expected = [[-1, -2, -3], [-5, -1, 0], [1, 1, 1]] # Sorted by sum, stable for -6\n    assert sort_matrix(matrix) == expected\n\ndef test_matrix_with_float_values():\n    \"\"\"Tests a matrix containing floating-point numbers.\"\"\"\n    matrix = [[1.5, 2.0], [0.5, 0.5], [3.0, 1.0]] # Sums: 3.5, 1.0, 4.0\n    expected = [[0.5, 0.5], [1.5, 2.0], [3.0, 1.0]]\n    assert sort_matrix(matrix) == expected\n\ndef test_matrix_with_mixed_int_float_values():\n    \"\"\"Tests a matrix containing a mix of integers and floats.\"\"\"\n    matrix = [[1, 2.5], [0.5, 1], [3, 0.0]] # Sums: 3.5, 1.5, 3.0\n    expected = [[0.5, 1.0], [3.0, 0.0], [1.0, 2.5]] # Note: int inputs are converted to floats in output\n    assert sort_matrix(matrix) == expected\n\ndef test_matrix_with_empty_rows():\n    \"\"\"Tests a matrix containing empty rows.\"\"\"\n    matrix = [[], [1, 2], []] # Sums: 0, 3, 0\n    expected = [[], [], [1, 2]] # Original order for 0 sum is preserved\n    assert sort_matrix(matrix) == expected\n\ndef test_invalid_input_not_list():\n    \"\"\"Tests input validation for non-list input.\"\"\"\n    with pytest.raises(TypeError, match=\"Input matrix must be a list.\"):\n        sort_matrix(\"not a list\")\n\ndef test_invalid_input_row_not_list():\n    \"\"\"Tests input validation for a row that is not a list.\"\"\"\n    with pytest.raises(TypeError, match=\"Row 0 must be a list, but got str.\"):\n        sort_matrix([\"not a row\", [1, 2]])\n\ndef test_invalid_input_non_numeric_element():\n    \"\"\"Tests input validation for a non-numeric element.\"\"\"\n    with pytest.raises(TypeError, match=\"Element at \\\\[0\\\\]\\\\[1\\\\] must be a number .* got str.\"):\n        sort_matrix([[1, \"not a number\"], [3, 4]])\n\ndef test_invalid_input_none_element():\n    \"\"\"Tests input validation for None as an element.\"\"\"\n    with pytest.raises(TypeError, match=\"Element at \\\\[0\\\\]\\\\[0\\\\] must be a number .* got NoneType.\"):\n        sort_matrix([[None]])\n\n```"}
