{"task_id": "Mbpp/171", "solution": "```python\n# src/domain.py\nfrom typing import TYPE_CHECKING\n\n# To avoid circular import issues, specifically when TestCase imports perimeter_pentagon\n# and perimeter_pentagon imports from domain, we use a local import inside TestCase.run().\n# The type hints can be handled by mypy with TYPE_CHECKING.\n\nclass RegularPentagon:\n    \"\"\"Represents a regular pentagon and computes its perimeter.\"\"\"\n    side_length: float\n    perimeter: float\n\n    def __init__(self, side_length: float):\n        \"\"\"Initializes the RegularPentagon with a given side length.\"\"\"\n        self.side_length = side_length\n        self.perimeter = self.computePerimeter()\n\n    def computePerimeter(self) -> float:\n        \"\"\"Computes the perimeter of the pentagon.\"\"\"\n        return 5 * self.side_length\n\nclass NumericInput:\n    \"\"\"A simple wrapper for numeric input values.\"\"\"\n    value: float\n\n    def __init__(self, value: float):\n        \"\"\"Initializes the NumericInput with a float value.\"\"\"\n        self.value = value\n\nclass NumericOutput:\n    \"\"\"A simple wrapper for numeric output values.\"\"\"\n    value: float\n\n    def __init__(self, value: float):\n        \"\"\"Initializes the NumericOutput with a float value.\"\"\"\n        self.value = value\n\nclass TestCase:\n    \"\"\"Encapsulates a test case for validating a function.\"\"\"\n    input_value: float\n    expected_output: float\n\n    def __init__(self, input_value: float, expected_output: float):\n        \"\"\"Initializes the test case with an input and its expected output.\"\"\"\n        self.input_value = input_value\n        self.expected_output = expected_output\n\n    def run(self) -> bool:\n        \"\"\"Executes the test case against the perimeter_pentagon function.\"\"\"\n        # Local import to avoid potential circular dependency issues.\n        from src.perimeter_pentagon import perimeter_pentagon\n        actual_output = perimeter_pentagon(self.input_value)\n        print(f\"Test Case: input={self.input_value}, expected={self.expected_output}, actual={actual_output}\")\n        return actual_output == self.expected_output\n\n```\n```python\n# src/perimeter_pentagon.py\nfrom src.domain import RegularPentagon, NumericOutput\n\nclass PerimeterFunction:\n    \"\"\"Encapsulates the perimeter computation for a regular pentagon.\"\"\"\n    name: str\n\n    def __init__(self, name: str):\n        \"\"\"Initializes the PerimeterFunction with a descriptive name.\"\"\"\n        self.name = name\n\n    def compute(self, side_length: float) -> float:\n        \"\"\"Computes the perimeter by utilizing the RegularPentagon domain entity.\"\"\"\n        pentagon = RegularPentagon(side_length)\n        perimeter_value = pentagon.computePerimeter()\n        # Per design, PerimeterFunction produces NumericOutput, then unwraps for float return.\n        output_wrapper = NumericOutput(perimeter_value)\n        return output_wrapper.value\n\ndef perimeter_pentagon(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a regular pentagon.\"\"\"\n    pf = PerimeterFunction(name='perimeter_pentagon_api')\n    return pf.compute(side_length)\n\n```\n```python\n# src/main.py\nimport sys\nfrom src.domain import TestCase\n\ndef main() -> int:\n    \"\"\"Main entry point to execute the example test case.\"\"\"\n    test_case = TestCase(input_value=5.0, expected_output=25.0)\n    if test_case.run():\n        print(\"Test Result: PASS\")\n        return 0\n    else:\n        print(\"Test Result: FAIL\")\n        return 1\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```\n```python\n# tests/test_perimeter.py\nfrom src.perimeter_pentagon import perimeter_pentagon\n\ndef test_perimeter_example() -> None:\n    \"\"\"Unit test asserting the perimeter of a pentagon with side 5 is 25.\"\"\"\n    assert perimeter_pentagon(5) == 25\n\n```"}
