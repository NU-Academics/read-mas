{"task_id": "Mbpp/162", "solution": "```python\n# src/sum_series.py\n\nclass SumSeriesFunction:\n    \"\"\"Encapsulates input validation and computation for the sum_series API.\"\"\"\n\n    def sum_series(self, n: int) -> int:\n        \"\"\"Validates input and computes the sum for the series.\"\"\"\n        self.validateInput(n)\n        return self._compute_sum(n)\n\n    def validateInput(self, n) -> None:\n        \"\"\"Enforces that n is an integer; raises TypeError if not.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n    def _compute_sum(self, n: int) -> int:\n        \"\"\"Computes the integer sum for i = 0..floor(n/2) of (n - 2*i).\"\"\"\n        total_sum = 0\n        # Iterate i from 0 up to floor(n/2) inclusive.\n        # Python's integer division `//` correctly calculates floor(n/2) for integers.\n        upper_bound_i = n // 2\n\n        for i in range(upper_bound_i + 1):\n            term = n - 2 * i\n            total_sum += term\n        return total_sum\n\ndef sum_series(n: int) -> int:\n    \"\"\"Public API: computes the sum of a series based on n.\"\"\"\n    # Delegates to an instance of SumSeriesFunction for validation and computation.\n    return SumSeriesFunction().sum_series(n)\n\n```\n```python\n# tests/test_sum_series.py\nfrom src.sum_series import sum_series\n\ndef test_sum_series_6():\n    \"\"\"Asserts that sum_series(6) returns 12, as per the acceptance criterion.\"\"\"\n    assert sum_series(6) == 12\n\n```"}
{"task_id": "Mbpp/165", "solution": "```python\ndef _is_alpha(c: str) -> bool:\n    \"\"\"Checks if character is a single English alphabetic letter (A-Z or a-z).\"\"\"\n    return len(c) == 1 and 'a' <= c.lower() <= 'z'\n\ndef _normalize_char(c: str) -> str:\n    \"\"\"Converts an alphabetic character to its lowercase form.\"\"\"\n    return c.lower()\n\ndef _map_alpha_position(c: str) -> int:\n    \"\"\"Maps a lowercase English letter to its 1-based alphabet position (a=1, b=2, ...).\"\"\"\n    # This helper assumes its input is a single lowercase English letter.\n    return ord(c) - ord('a') + 1\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in the input string whose English alphabet position equals their 1-based string position.\n    Non-alphabetic characters occupy positions but are ignored for counting.\n    \"\"\"\n    matching_count = 0\n    for position, char_val in enumerate(input, start=1):\n        if _is_alpha(char_val):\n            normalized_char = _normalize_char(char_val)\n            alpha_position = _map_alpha_position(normalized_char)\n            if alpha_position == position:\n                matching_count += 1\n    return matching_count\n```"}
{"task_id": "Mbpp/162", "solution": "```python\n# src/sum_series.py\n\"\"\"\nProvides the sum_series function and supporting classes to compute the sum of a sequence.\nThe function calculates t_i = n - 2*i for i from 0 to floor(n/2) and returns the sum.\n\"\"\"\nfrom dataclasses import dataclass\nfrom typing import Optional\nfrom math import floor\n\n@dataclass\nclass InputParameter:\n    \"\"\"Represents the input parameter 'n' for the sum series calculation.\"\"\"\n    n: int\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the input parameter 'n' is an integer.\"\"\"\n        return isinstance(self.n, int)\n\n@dataclass\nclass SeriesTerm:\n    \"\"\"Represents a single term in the series t_i = n - 2*i.\"\"\"\n    index: int\n    n: int\n\n    def value(self) -> int:\n        \"\"\"Computes the value of this series term based on its index and n.\"\"\"\n        return self.n - 2 * self.index\n\n@dataclass\nclass Result:\n    \"\"\"Holds the computed sum of the series.\"\"\"\n    sum: int\n\nclass SumSeries:\n    \"\"\"\n    Computes the sum of the series using either an iterative or a closed-form algorithm.\n    It can be initialized with an optional algorithm choice, though currently only compute() is delegated by the public API.\n    \"\"\"\n    def __init__(self, algorithm: Optional[str] = None) -> None:\n        self._algorithm = algorithm # Stores the chosen algorithm name.\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of the series t_i = n - 2*i iteratively.\n        The terms are summed for i from 0 up to and including floor(n/2).\n        \"\"\"\n        total_sum = 0\n        upper_bound_i = floor(n / 2)\n        # The loop iterates for i from 0 to upper_bound_i (inclusive).\n        # If upper_bound_i is negative, range() will be empty, resulting in a sum of 0.\n        for i in range(upper_bound_i + 1):\n            term = SeriesTerm(index=i, n=n)\n            total_sum += term.value()\n        return Result(sum=total_sum).sum\n\n    def computeClosedForm(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of the series using a closed-form formula based on n's parity.\n        This provides an O(1) optimization for the series sum.\n        \"\"\"\n        k = floor(n / 2)\n        if n % 2 == 0:  # n is even (n = 2k)\n            computed_sum = k * (k + 1)\n        else:  # n is odd (n = 2k + 1)\n            computed_sum = (k + 1) ** 2\n        return Result(sum=computed_sum).sum\n\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Computes the sum of the sequence t_i = n - 2*i for integer i = 0..floor(n/2).\n    Raises TypeError if 'n' is not an integer.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.is_valid():\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    calculator = SumSeries()\n    # Delegates the computation to the iterative method as per the design's sequence diagram.\n    series_result = calculator.compute(n) \n    return series_result\n\n\n# tests/test_sum_series.py\n\"\"\"\nUnit tests for the sum_series function.\nValidates the sum_series(6) == 12 example case from the requirements.\n\"\"\"\nfrom src.sum_series import sum_series\n\ndef test_sum_series_example():\n    \"\"\"Verifies the sum_series function returns 12 for an input of 6.\"\"\"\n    assert sum_series(6) == 12\n```"}
{"task_id": "Mbpp/166", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputList:\n    \"\"\"Conceptual container for input values.\"\"\"\n    values: List[int]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.values)\n\n@dataclass\nclass IntegerElement:\n    \"\"\"Conceptual wrapper for a value with its index.\"\"\"\n    value: int\n    index: int\n\n@dataclass\nclass Pair:\n    \"\"\"Conceptual unordered pair; supports XOR and parity checks.\"\"\"\n    a: IntegerElement\n    b: IntegerElement\n\n    def xor(self) -> int:\n        \"\"\"Computes the bitwise XOR of the values in the pair.\"\"\"\n        return self.a.value ^ self.b.value\n\n    def is_even_xor(self) -> bool:\n        \"\"\"Checks if the XOR of the pair's values is even.\"\"\"\n        return (self.xor() % 2 == 0)\n\n@dataclass\nclass Result:\n    \"\"\"Conceptual holder for the count result.\"\"\"\n    count: int\n\ndef _xor(a: int, b: int) -> int:\n    \"\"\"Computes the bitwise XOR of two integers.\"\"\"\n    return a ^ b\n\ndef _is_even(n: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return (n % 2 == 0)\n\ndef _count_even_xor_pairs_bruteforce(values: List[int]) -> int:\n    \"\"\"Counts pairs (i < j) whose XOR is even using a brute-force O(n^2) approach.\n    This function explicitly enumerates all unordered index pairs.\"\"\"\n    count = 0\n    n = len(values)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if _is_even(_xor(values[i], values[j])):\n                count += 1\n    return count\n\ndef _count_even_xor_pairs_parity_optimized(values: List[int]) -> int:\n    \"\"\"Counts pairs (i < j) whose XOR is even using an O(n) parity optimization.\n    It leverages that XOR is even if and only if both numbers have the same parity.\"\"\"\n    even_count = 0\n    odd_count = 0\n    for val in values:\n        if _is_even(val):\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate combinations C(n, 2) = n * (n - 1) / 2\n    # Sum pairs of evens and pairs of odds.\n    count = (even_count * (even_count - 1) // 2) + \\\n            (odd_count * (odd_count - 1) // 2)\n    return count\n\ndef find_even_pair(values: list[int]) -> int:\n    \"\"\"Return the number of unordered index-pairs (i < j) whose bitwise XOR is even.\n    This function handles edge cases and uses an O(n) parity-optimized algorithm by default.\"\"\"\n    if len(values) < 2:\n        return 0\n    return _count_even_xor_pairs_parity_optimized(values)\n```"}
{"task_id": "Mbpp/165", "solution": "```python\nclass InputString:\n    \"\"\"Encapsulates input string and provides 1-based character access.\n    Raises IndexError for invalid 1-based positions.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def char_at(self, pos: int) -> str:\n        \"\"\"Returns the character at the 1-based position.\n        This method will raise an IndexError if 'pos' is out of bounds.\"\"\"\n        return self.value[pos - 1]\n\n\nclass Alphabet:\n    \"\"\"Provides mapping for 1-26 positions to 'a'-'z' letters.\n    Raises ValueError for positions outside this range.\"\"\"\n    def __init__(self):\n        self.letters = [chr(i) for i in range(ord('a'), ord('z') + 1)]\n\n    def letter_at(self, pos: int) -> str:\n        \"\"\"Returns the alphabet letter for a 1-based position.\n        Position must be between 1 and 26 (inclusive).\"\"\"\n        if not (1 <= pos <= 26):\n            raise ValueError(\"Position must be between 1 and 26 for alphabet lookup.\")\n        return self.letters[pos - 1]\n\n\nclass PositionMatch:\n    \"\"\"Represents per-position computed information and match evaluation.\n    Determines if a character matches its alphabet position.\"\"\"\n    def __init__(self, position: int, character: str):\n        self.position = position\n        self.character = character\n        self.is_letter = 'a' <= self.character.lower() <= 'z'\n\n    def is_match(self, alphabet: Alphabet) -> bool:\n        \"\"\"Evaluates if the character matches the alphabet letter at its position.\n        Considers position limits, letter status, and case-insensitivity.\"\"\"\n        if self.position > 26:\n            return False\n        if not self.is_letter:\n            return False\n        return self.character.lower() == alphabet.letter_at(self.position)\n\n\nclass CountResult:\n    \"\"\"Represents the final aggregated result count.\n    Holds the total number of matching characters.\"\"\"\n    def __init__(self, count: int):\n        self._count = count\n\n    @property\n    def count(self) -> int:\n        \"\"\"The total count of matching characters.\"\"\"\n        return self._count\n\n\nclass CountService:\n    \"\"\"Orchestrates counting characters matching their alphabet position.\n    Implements the core algorithm based on business rules.\"\"\"\n    def count_char_position(self, s: str) -> int:\n        \"\"\"Counts characters matching their 1-based alphabet position.\n        Handles empty input, iterates positions, and aggregates matches.\"\"\"\n        input_string = InputString(s)\n        alphabet = Alphabet()\n\n        if input_string.length() == 0:\n            return 0\n\n        match_count = 0\n        for pos in range(1, input_string.length() + 1):\n            char = input_string.char_at(pos)\n            position_match = PositionMatch(position=pos, character=char)\n            \n            if position_match.is_match(alphabet):\n                match_count += 1\n        \n        count_result = CountResult(match_count)\n        return count_result.count\n\n\ndef count_char_position(s: str) -> int:\n    \"\"\"Counts characters in a string that match their 1-based alphabet position.\n    This is the top-level API function, delegating to CountService.\"\"\"\n    return CountService().count_char_position(s)\n```"}
{"task_id": "Mbpp/167", "solution": "```python\ndef is_power_of_two(v: int) -> bool:\n    \"\"\"Checks if a given integer v is a power of two (including 1).\"\"\"\n    return v > 0 and (v & (v - 1) == 0)\n\ndef compute(n: int) -> int:\n    \"\"\"Computes the smallest power of two greater than or equal to n.\"\"\"\n    v = 1\n    while v < n:\n        v <<= 1\n    return v\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Returns the smallest power of two greater than or equal to n.\n    Handles the special case where n is 0, returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    return compute(n)\n```"}
{"task_id": "Mbpp/166", "solution": "```python\n# src/input_list.py\nclass InputList:\n    \"\"\"\n    Represents a caller-provided list, offering read-only access.\n    It provides its length and element access without mutation.\n    \"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n```\n\n```python\n# src/integer_element.py\nclass IntegerElement:\n    \"\"\"\n    Describes an integer value along with its original index.\n    Includes a helper method to check its parity.\n    \"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the integer element's value is even.\"\"\"\n        return self.value % 2 == 0\n\n```\n\n```python\n# src/parity_counter.py\nfrom src.input_list import InputList\n\nclass ParityCounter:\n    \"\"\"\n    Computes and stores the counts of even and odd numbers from an InputList.\n    It populates `evenCount` and `oddCount` fields.\n    \"\"\"\n    def __init__(self) -> None:\n        self.evenCount = 0\n        self.oddCount = 0\n\n    def computeCounts(self, input_list: InputList) -> None:\n        \"\"\"\n        Populates evenCount and oddCount based on the provided InputList elements.\n        Iterates through the list to categorize numbers by parity.\n        \"\"\"\n        for element_value in input_list.elements:\n            if element_value % 2 == 0:\n                self.evenCount += 1\n            else:\n                self.oddCount += 1\n\n```\n\n```python\n# src/pair_counter.py\nfrom src.input_list import InputList\nfrom src.integer_element import IntegerElement\nfrom src.parity_counter import ParityCounter\n\nclass PairCounter:\n    \"\"\"\n    Calculates the number of qualifying unordered index pairs.\n    Provides methods for both combinatorial and brute-force counting.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def _combinations_2(self, n: int) -> int:\n        \"\"\"Calculates n choose 2, representing combinations of 2 items from n.\"\"\"\n        return n * (n - 1) // 2 if n >= 2 else 0\n\n    def countPairs(self, parity_counter: ParityCounter) -> int:\n        \"\"\"\n        Computes the total number of pairs using pre-calculated even and odd counts.\n        This uses the combinatorial formula C(n, 2) for each parity group.\n        \"\"\"\n        even_pairs = self._combinations_2(parity_counter.evenCount)\n        odd_pairs = self._combinations_2(parity_counter.oddCount)\n        return even_pairs + odd_pairs\n\n    def countPairsBruteForce(self, input_list: InputList) -> int:\n        \"\"\"\n        Enumerates all distinct index pairs (i < j) and counts those whose XOR is even.\n        This method serves as an alternative for verification or testing.\n        \"\"\"\n        count = 0\n        n = input_list.length()\n        elements = input_list.elements\n        for i in range(n):\n            for j in range(i + 1, n):\n                if (elements[i] ^ elements[j]) % 2 == 0:\n                    count += 1\n        return count\n\n```\n\n```python\n# src/result.py\nclass Result:\n    \"\"\"\n    A simple data holder for the computed pairCount.\n    It encapsulates the final count value.\n    \"\"\"\n    def __init__(self, pair_count: int) -> None:\n        self.pairCount = pair_count\n\n```\n\n```python\n# src/find_even_pair.py\nfrom src.input_list import InputList\nfrom src.parity_counter import ParityCounter\nfrom src.pair_counter import PairCounter\nfrom src.result import Result\n\ndef find_even_pair(input_list: list[int]) -> int:\n    \"\"\"\n    Counts unordered index pairs (i < j) in a list whose bitwise XOR is even.\n    This function acts as the public API entry point.\n    \"\"\"\n    if len(input_list) < 2:\n        return 0\n\n    input_wrapped = InputList(input_list)\n\n    parity_counter = ParityCounter()\n    parity_counter.computeCounts(input_wrapped)\n\n    pair_counter = PairCounter()\n    pair_count_value = pair_counter.countPairs(parity_counter)\n\n    result = Result(pair_count_value)\n    return result.pairCount\n\n```"}
