{"task_id": "Mbpp/88", "solution": "```python\n# frequency_counter_project/src/__init__.py\n\nfrom .frequency_counter import freq_count\n```\n```python\n# frequency_counter_project/src/domain.py\n\nfrom typing import List, Dict, Any\n\nclass ListInput:\n    \"\"\"Wraps an input list, preserving the original reference.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements: list = elements\n\nclass Element:\n    \"\"\"Conceptual wrapper for an element value.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value: Any = value\n\nclass FrequencyEntry:\n    \"\"\"Represents a (value, count) pair.\"\"\"\n    def __init__(self, value: Any, count: int) -> None:\n        self.value: Any = value\n        self.count: int = count\n\nclass FrequencyDictionary:\n    \"\"\"A dictionary-like object for accumulating frequencies.\"\"\"\n    def __init__(self) -> None:\n        self.entries: Dict[Any, int] = {}\n\n    def increment(self, key: Any, amount: int = 1) -> None:\n        \"\"\"Increments the count for a given key.\"\"\"\n        self.entries[key] = self.entries.get(key, 0) + amount\n\n    def to_dict(self) -> Dict[Any, int]:\n        \"\"\"Returns the internal frequency map as a native dictionary.\"\"\"\n        return self.entries\n\n    def total_distinct(self) -> int:\n        \"\"\"Returns the number of distinct elements.\"\"\"\n        return len(self.entries)\n```\n```python\n# frequency_counter_project/src/frequency_counter.py\n\nfrom src.domain import ListInput, FrequencyDictionary\n\nclass FrequencyCounter:\n    \"\"\"A stateless service to compute frequencies from ListInput.\"\"\"\n    def freq_count(self, input_obj: ListInput) -> dict:\n        \"\"\"Iterates elements, checks hashability, and accumulates counts.\"\"\"\n        frequency_dict = FrequencyDictionary()\n        for element in input_obj.elements:\n            try:\n                hash(element) # BR-07: Verify element is hashable.\n            except TypeError:\n                raise TypeError(f\"Element '{element}' of type {type(element)} is not hashable.\")\n            frequency_dict.increment(element)\n        return frequency_dict.to_dict()\n\ndef freq_count(input_list: list) -> dict:\n    \"\"\"\n    Counts element occurrences in a list, returning them as a dictionary.\n    Handles input validation and delegates counting to FrequencyCounter.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('Input must be a list.') # BR-05\n    if not input_list:\n        return {} # BR-06\n\n    list_input_obj = ListInput(input_list)\n    counter = FrequencyCounter()\n    result = counter.freq_count(list_input_obj)\n    return result\n```\n```python\n# frequency_counter_project/tests/test_freq_count.py\n\nimport pytest\nfrom src.frequency_counter import freq_count\n\ndef test_freq_count_example():\n    \"\"\"Acceptance test case from SRS (FR-4).\"\"\"\n    input_list = [10, 10, 10, 10, 20, 20, 20, 20, 40, 40, 50, 50, 30]\n    expected_output = {10: 4, 20: 4, 40: 2, 50: 2, 30: 1}\n    assert freq_count(input_list) == expected_output\n\ndef test_empty_list():\n    \"\"\"Tests behavior with an empty input list (BR-06).\"\"\"\n    assert freq_count([]) == {}\n\ndef test_non_list_input():\n    \"\"\"Tests error handling for non-list input (BR-05).\"\"\"\n    with pytest.raises(TypeError, match='Input must be a list.'):\n        freq_count('not-a-list')\n\ndef test_non_hashable_element():\n    \"\"\"Tests error handling for non-hashable elements (BR-07).\"\"\"\n    with pytest.raises(TypeError, match='Element .* is not hashable.'):\n        freq_count([[1], [1]])\n\ndef test_input_not_mutated():\n    \"\"\"Verifies the input list is not mutated (BR-08).\"\"\"\n    original_list = [1, 2, 1]\n    input_copy = list(original_list)\n    freq_count(original_list)\n    assert original_list == input_copy\n\ndef test_multiple_types_of_elements():\n    \"\"\"Tests counting with various hashable types.\"\"\"\n    input_list = [1, 'a', 1.0, (1,2), 'a', 1, 1.0]\n    expected_output = {1: 2, 'a': 2, 1.0: 2, (1,2): 1}\n    assert freq_count(input_list) == expected_output\n\ndef test_distinct_objects_with_same_value():\n    \"\"\"Tests distinct objects are counted based on hash/equality (FR-3).\"\"\"\n    class MyHashable:\n        def __init__(self, value):\n            self.value = value\n        def __hash__(self):\n            return hash(self.value)\n        def __eq__(self, other):\n            return isinstance(other, MyHashable) and self.value == other.value\n        def __repr__(self):\n            return f\"MyHashable({self.value})\"\n    \n    obj1_a = MyHashable('a')\n    obj1_b = MyHashable('a')\n    obj2_c = MyHashable('c')\n\n    input_list = [obj1_a, obj1_b, obj2_c, obj1_a]\n    expected_output = {obj1_a: 3, obj2_c: 1}\n    assert freq_count(input_list) == expected_output\n```"}
{"task_id": "Mbpp/89", "solution": "```python\n# src/closest_num.py\nimport math\n\ndef _validate_numeric(n):\n    \"\"\"Raise TypeError or ValueError for invalid inputs; returns None on success.\"\"\"\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"Input 'n' must be a numeric type (int or float).\")\n    if math.isnan(n):\n        raise ValueError(\"Input 'n' cannot be NaN.\")\n\n__all__ = (\"closest_num\",)\n\ndef closest_num(n):\n    \"\"\"Return the largest integer strictly less than n.\n    This function validates input and computes the result using ceil(n) - 1.\n    \"\"\"\n    _validate_numeric(n)\n    return int(math.ceil(n) - 1)\n\n```\n```python\n# tests/test_closest_num.py\nfrom src.closest_num import closest_num\n\ndef test_closest_num_example():\n    \"\"\"Verify the closest_num function with a specific example.\n    This test asserts that closest_num(11) correctly returns 10.\n    \"\"\"\n    assert closest_num(11) == 10\n```"}
