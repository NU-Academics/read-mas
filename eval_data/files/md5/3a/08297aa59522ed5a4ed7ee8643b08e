{"task_id": "Mbpp/555", "solution": "```python\ndef difference(n: int) -> int:\n    \"\"\"Computes the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.\n    The input n is trusted to be a positive integer.\"\"\"\n    # S2 = sum_{i=1..n} i = n*(n+1)//2\n    linear_sum_formula_result = n * (n + 1) // 2\n\n    # S1 = sum_{i=1..n} i^3 = (n*(n+1)//2)**2\n    sum_of_cubes = linear_sum_formula_result * linear_sum_formula_result\n\n    # S2 = n*(n+1)//2\n    linear_sum = linear_sum_formula_result\n\n    return sum_of_cubes - linear_sum\n```"}
{"task_id": "Mbpp/555", "solution": "```python\n# src/__init__.py\nfrom .difference_function import difference\n\n```python\n# src/difference_function.py\nfrom .validator import Validator\nfrom .natural_number_sequence import NaturalNumberSequence\nfrom .sum_components import Sum, SumOfCubes\nfrom .result import Result\n\nclass DifferenceFunction:\n    def difference(self, n: int) -> int:\n        \"\"\"Orchestrates validation, sequence creation, computation, and result.\n        Returns the computed difference as an integer.\"\"\"\n        validator = Validator()\n        validator.validate(n)\n\n        sequence = NaturalNumberSequence(n)\n\n        sum_calculator = Sum()\n        total_sum = sum_calculator.compute(sequence)\n\n        sum_of_cubes_calculator = SumOfCubes()\n        total_sum_of_cubes = sum_of_cubes_calculator.compute(sequence)\n\n        result_value = total_sum_of_cubes - total_sum\n        final_result = Result(result_value)\n\n        return final_result.value\n\n# Public API function as specified, delegates to a stateless DifferenceFunction instance.\n_difference_function_instance = DifferenceFunction()\n\ndef difference(n: int) -> int:\n    \"\"\"Public API: computes the difference between sum of cubes and sum of first n natural numbers.\"\"\"\n    return _difference_function_instance.difference(n)\n\n```python\n# src/validator.py\nclass Validator:\n    def validate(self, n: any) -> None:\n        \"\"\"Raises ValueError if n is not an integer or is less than 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be an integer greater than or equal to 1.\")\n\n```python\n# src/natural_number_sequence.py\nclass NaturalNumberSequence:\n    def __init__(self, n: int) -> None:\n        \"\"\"Initializes the sequence with count n.\"\"\"\n        self.n = n\n\n    def elements(self) -> list[int]:\n        \"\"\"Returns a list of natural numbers from 1 to n.\"\"\"\n        return list(range(1, self.n + 1))\n\n```python\n# src/sum_components.py\nfrom .natural_number_sequence import NaturalNumberSequence\n\nclass Sum:\n    def __init__(self) -> None:\n        \"\"\"Initializes the Sum component.\n        Holds the last computed sum.\"\"\"\n        self.value: int = 0\n\n    def compute(self, seq: NaturalNumberSequence) -> int:\n        \"\"\"Computes the sum of elements in the given sequence.\"\"\"\n        current_sum = 0\n        for i in seq.elements():\n            current_sum += i\n        self.value = current_sum\n        return self.value\n\nclass SumOfCubes:\n    def __init__(self) -> None:\n        \"\"\"Initializes the SumOfCubes component.\n        Holds the last computed sum of cubes.\"\"\"\n        self.value: int = 0\n\n    def compute(self, seq: NaturalNumberSequence) -> int:\n        \"\"\"Computes the sum of cubes of elements in the given sequence.\"\"\"\n        current_sum_of_cubes = 0\n        for i in seq.elements():\n            current_sum_of_cubes += i ** 3\n        self.value = current_sum_of_cubes\n        return self.value\n\n```python\n# src/result.py\nclass Result:\n    def __init__(self, value: int) -> None:\n        \"\"\"Holds the final integer result.\"\"\"\n        self.value = value\n```"}
{"task_id": "Mbpp/556", "solution": "def _validate_inputs(arr: list, n: int) -> int:\n    \"\"\"\n    Validates input types and computes the effective number of elements to consider.\n    Raises TypeError if arr is not a list or n is not an int.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    \n    return min(n, len(arr))\n\ndef _count_parity(arr: list, n_effective: int) -> tuple[int, int]:\n    \"\"\"\n    Counts odd and even integers within the first n_effective elements of arr.\n    Returns a tuple (odds_count, evens_count).\n    \"\"\"\n    odds_count = 0\n    evens_count = 0\n    for i in range(n_effective):\n        element = arr[i]\n        if element % 2 == 0:\n            evens_count += 1\n        else:\n            odds_count += 1\n    return odds_count, evens_count\n\ndef find_Odd_Pair(arr: list, n: int) -> int:\n    \"\"\"\n    Counts unordered index pairs (i, j) where 0 <= i < j < n_effective such that arr[i] XOR arr[j] is odd.\n    The result is computed as (count of odd numbers) * (count of even numbers).\n    \"\"\"\n    n_effective = _validate_inputs(arr, n)\n\n    if n_effective < 2:\n        return 0\n\n    odds, evens = _count_parity(arr, n_effective)\n    return odds * evens"}
{"task_id": "Mbpp/557", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass Character:\n    value: str\n\n    def is_alpha(self) -> bool:\n        \"\"\"Checks if the character is alphabetic.\"\"\"\n        return self.value.isalpha()\n\n    def is_upper(self) -> bool:\n        \"\"\"Checks if the character is uppercase.\"\"\"\n        return self.value.isupper()\n\n    def is_lower(self) -> bool:\n        \"\"\"Checks if the character is lowercase.\"\"\"\n        return self.value.islower()\n\n    def toggle_case(self) -> str:\n        \"\"\"Toggles the case of the character if alphabetic, otherwise returns it unchanged.\"\"\"\n        if self.is_alpha():\n            if self.is_upper():\n                return self.value.lower()\n            elif self.is_lower():\n                return self.value.upper()\n        return self.value\n\ndef _process_character(c: str) -> str:\n    \"\"\"Processes a single character, toggling its case if alphabetic.\"\"\"\n    char_obj = Character(value=c)\n    return char_obj.toggle_case()\n\ndef toggle_string(input: str) -> str:\n    \"\"\"Inverts the case of alphabetic characters in a string, preserving others.\"\"\"\n    # Per critical requirements, no isinstance check or error handling for non-string input.\n    \n    processed_chars = []\n    for char in input:\n        processed_chars.append(_process_character(char))\n    return \"\".join(processed_chars)\n```"}
{"task_id": "Mbpp/557", "solution": "```python\ndef toggle_string(input: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged, preserving order and length.\n    \"\"\"\n    toggled_chars = []\n    for char in input:\n        if char.isalpha():\n            if char.islower():\n                toggled_chars.append(char.upper())\n            else:  # Character is alphabetic and not lowercase, so it's uppercase\n                toggled_chars.append(char.lower())\n        else:  # Character is not alphabetic\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)\n```"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, n):\n    \"\"\"Counts unordered index pairs (i, j) among the first n elements such that array[i] XOR array[j] is odd.\n    Returns 0 if n is less than or equal to 1, as no pairs can be formed.\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    odd_xor_pairs_count = 0\n    \n    # Iterate through all unique unordered pairs (i, j) where 0 <= i < j < n.\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Check if the XOR value of array[i] and array[j] is odd.\n            # An integer is odd if its least significant bit is 1.\n            if (array[i] ^ array[j]) & 1 == 1:\n                odd_xor_pairs_count += 1\n                \n    return odd_xor_pairs_count"}
{"task_id": "Mbpp/558", "solution": "from typing import List\n\nclass IntegerInput:\n    \"\"\"Encapsulates a Python int; validates type; normalizes and extracts digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid_int(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n    def normalize(self) -> 'IntegerInput':\n        \"\"\"Returns a new IntegerInput with the absolute value.\"\"\"\n        return IntegerInput(abs(self.value))\n\n    def get_digits(self) -> List['Digit']:\n        \"\"\"Extracts decimal digits, with units at index 0.\"\"\"\n        n = abs(self.value)\n        if n == 0:\n            return [Digit(position=0, value=0)]\n        \n        digits = []\n        pos = 0\n        while n > 0:\n            digits.append(Digit(position=pos, value=n % 10))\n            n //= 10\n            pos += 1\n        return digits\n\nclass Digit:\n    \"\"\"Data holder for a single digit with its position.\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position\n        self.value = value\n\nclass DigitCollection:\n    \"\"\"Ordered container of Digit objects with padding logic.\"\"\"\n    def __init__(self, digits: List[Digit]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the collection.\"\"\"\n        return len(self.digits)\n\n    def pad_to(self, length: int) -> 'DigitCollection':\n        \"\"\"Pads the collection with zeros on the most-significant side to reach a target length.\"\"\"\n        current_len = self.length()\n        if current_len >= length:\n            return self # No padding needed or already longer\n        \n        new_digits = list(self.digits) # Create a new list for padding\n        for i in range(current_len, length):\n            new_digits.append(Digit(position=i, value=0))\n        return DigitCollection(new_digits)\n\nclass DigitDifference:\n    \"\"\"Data holder representing the absolute difference at a digit position.\"\"\"\n    def __init__(self, position: int, difference: int):\n        self.position = position\n        self.difference = difference\n\nclass DigitDistanceCalculator:\n    \"\"\"Stateless core algorithm computing the sum of per-digit absolute differences.\"\"\"\n    def compute(self, a: IntegerInput, b: IntegerInput) -> int:\n        \"\"\"\n        Computes the sum of per-digit absolute differences between two IntegerInputs.\n        Expects a and b to be normalized (non-negative).\n        \"\"\"\n        digits_a_list = a.get_digits()\n        digits_b_list = b.get_digits()\n\n        coll_a = DigitCollection(digits_a_list)\n        coll_b = DigitCollection(digits_b_list)\n\n        max_len = max(coll_a.length(), coll_b.length())\n\n        padded_coll_a = coll_a.pad_to(max_len)\n        padded_coll_b = coll_b.pad_to(max_len)\n\n        total_difference = 0\n        for i in range(max_len):\n            val_a = padded_coll_a.digits[i].value\n            val_b = padded_coll_b.digits[i].value\n            total_difference += abs(val_a - val_b)\n\n        return total_difference\n\ndef digit_distance_nums(a, b) -> int:\n    \"\"\"\n    Computes the sum of absolute per-digit differences between two integers.\n    The function validates inputs, normalizes them, and pads shorter numbers with zeros.\n    \"\"\"\n    a_input = IntegerInput(a)\n    b_input = IntegerInput(b)\n\n    if not a_input.is_valid_int() or not b_input.is_valid_int():\n        raise TypeError(\"Both arguments must be int\")\n\n    normalized_a = a_input.normalize()\n    normalized_b = b_input.normalize()\n\n    calculator = DigitDistanceCalculator()\n    result = calculator.compute(normalized_a, normalized_b)\n    \n    return result"}
{"task_id": "Mbpp/558", "solution": "```python\nclass IntegerOperand:\n    \"\"\"Represent an integer input operand and provide accessors for its absolute value and digit sequence.\"\"\"\n\n    def __init__(self, value: int) -> None:\n        \"\"\"Construct operand wrapper; store provided value.\"\"\"\n        self._value = value\n\n    def abs_value(self) -> int:\n        \"\"\"Return absolute integer value abs(self._value).\"\"\"\n        return abs(self._value)\n\n    def digits(self) -> list:\n        \"\"\"Return list[int] digits of abs_value() in least-significant-first order.\"\"\"\n        n = self.abs_value()\n        if n == 0:\n            return [0]\n        digit_list = []\n        while n > 0:\n            digit_list.append(n % 10)\n            n //= 10\n        return digit_list\n\n\nclass DigitComparisonResult:\n    \"\"\"Hold list of per-position absolute differences and provide aggregated sum.\"\"\"\n\n    def __init__(self, differences: list) -> None:\n        \"\"\"Construct result holder.\"\"\"\n        self._differences = differences\n\n    def sum(self) -> int:\n        \"\"\"Return integer sum of differences.\"\"\"\n        return sum(self._differences)\n\n\nclass DigitDistanceCalculator:\n    \"\"\"Encapsulate algorithm steps for validation, digit extraction, padding, per-digit comparison and aggregation.\"\"\"\n\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        \"\"\"Orchestrates validation, operand wrapping, digit conversion/padding, comparison and sum; returns total int.\"\"\"\n        self._validate_inputs(a, b)\n\n        operand_a = IntegerOperand(a)\n        operand_b = IntegerOperand(b)\n\n        digits_a = operand_a.digits()\n        digits_b = operand_b.digits()\n\n        # Determine required length for padding\n        max_len = max(len(digits_a), len(digits_b))\n\n        padded_digits_a = self._pad_digits(digits_a, max_len)\n        padded_digits_b = self._pad_digits(digits_b, max_len)\n\n        # Compute per-digit absolute differences\n        differences = []\n        for d_a, d_b in zip(padded_digits_a, padded_digits_b):\n            differences.append(abs(d_a - d_b))\n\n        result = DigitComparisonResult(differences)\n        return result.sum()\n\n    def _validate_inputs(self, a, b) -> None:\n        \"\"\"Raises TypeError if either a or b is not an int.\"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise TypeError(\"Both inputs 'a' and 'b' must be integers.\")\n\n    def _to_digits(self, n: int) -> list:\n        \"\"\"Convert absolute value abs(n) into list[int] of decimal digits ordered least-significant-first (units at index 0).\"\"\"\n        # This method is provided as per class diagram, though IntegerOperand.digits() handles operand digit extraction.\n        abs_n = abs(n)\n        if abs_n == 0:\n            return [0]\n        digit_list = []\n        while abs_n > 0:\n            digit_list.append(abs_n % 10)\n            abs_n //= 10\n        return digit_list\n\n    def _pad_digits(self, digits: list, length: int) -> list:\n        \"\"\"Given least-significant-first digits, extend the list to specified length by appending zeros.\"\"\"\n        return digits + [0] * (length - len(digits))\n\n    def _compare_and_sum(self, digits_a: list, digits_b: list) -> int:\n        \"\"\"Compute absolute differences for each aligned digit and return the integer sum.\"\"\"\n        # This method is not directly used in the current implementation of digit_distance_nums,\n        # but the logic is embedded within it, following the sequence diagram.\n        total_difference = 0\n        for d_a, d_b in zip(digits_a, digits_b):\n            total_difference += abs(d_a - d_b)\n        return total_difference\n\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Public API that computes and returns the integer sum of per-digit absolute differences.\"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator.digit_distance_nums(a, b)\n```"}
{"task_id": "Mbpp/559", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker for the src module.\"\"\"\n\n# Define what symbols are exported when 'from src.max_subarray import *' is used.\nfrom .max_subarray import max_sub_array_sum\n\n__all__ = [\"max_sub_array_sum\"]\n```\n```python\n# src/max_subarray.py\nfrom typing import List\nfrom dataclasses import dataclass\n\n# Domain Holder Classes\nclass ArrayInput:\n    \"\"\"Represents an input array and provides its length.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\nclass ParameterN:\n    \"\"\"Represents the integer n, indicating how many initial elements to consider.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n@dataclass\nclass Subarray:\n    \"\"\"A candidate contiguous segment holder for modeling/traceability.\"\"\"\n    startIndex: int\n    endIndex: int\n    sum: int\n\n@dataclass\nclass Result:\n    \"\"\"A final result holder for the maximum sum.\"\"\"\n    maxSum: int\n\nclass MaxSubarrayService:\n    \"\"\"Core service computing the constrained max contiguous subarray sum and applying the all-negative rule.\"\"\"\n\n    def max_sub_array_sum(self, arr: List[int], n: int) -> int:\n        \"\"\"\n        Computes the maximum contiguous sublist sum limited to arr[0..n-1].\n        It applies the all-negative rule (FR-4) by delegating to computeOnSegment.\n        \"\"\"\n        array_input = ArrayInput(arr)\n        param_n = ParameterN(n)\n\n        # FR-3: Scope constraint - ignore elements beyond the first n elements.\n        # Python slice arr[0:n] handles n > len(arr) and n <= 0 gracefully,\n        # resulting in an appropriate sub-segment (possibly empty).\n        arr_segment = array_input.elements[0:param_n.n]\n\n        # FR-2, FR-4: Compute maximum contiguous sum and apply all-negative rule.\n        computed_max_sum = self.computeOnSegment(arr_segment)\n\n        # Result is used as a holder for traceability.\n        result = Result(maxSum=computed_max_sum)\n        return result.maxSum\n\n    def computeOnSegment(self, arr_segment: List[int]) -> int:\n        \"\"\"\n        Computes the max contiguous sum for a provided segment using Kadane's algorithm.\n        Returns 0 for empty segments; returns the largest single element if all are negative.\n        \"\"\"\n        if not arr_segment:\n            return 0  # Handles empty segment as a base case, consistent with no sum.\n\n        max_so_far = arr_segment[0]\n        current_max = arr_segment[0]\n\n        for i in range(1, len(arr_segment)):\n            current_max = max(arr_segment[i], current_max + arr_segment[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n\n# Public API Function (FR-1)\ndef max_sub_array_sum(arr: List[int], n: int) -> int:\n    \"\"\"\n    Public facade for the module: computes the maximum contiguous sublist sum.\n    It delegates the actual algorithm execution to an instance of MaxSubarrayService.\n    \"\"\"\n    service = MaxSubarrayService()\n    return service.max_sub_array_sum(arr, n)\n```"}
{"task_id": "Mbpp/559", "solution": "```python\n# src/domain.py\nfrom typing import List\n\nclass InputList:\n    \"\"\"Domain holder for elements and length.\"\"\"\n    def __init__(self, elements: List[int], length: int):\n        self.elements = elements\n        self.length = length\n\nclass Subarray:\n    \"\"\"Domain representation of a candidate contiguous subarray.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, sum: int):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.sum = sum\n\nclass Result:\n    \"\"\"Domain holder for the returned maxSum.\"\"\"\n    def __init__(self, maxSum: int):\n        self.maxSum = maxSum\n\n```\n```python\n# src/service.py\nfrom typing import List\n# Domain classes are provided for clarity but are not strictly required for this minimal implementation's logic.\n# from .domain import InputList, Subarray, Result \n\nclass MaxSubArrayService:\n    \"\"\"Encapsulates validation and computation for the maximum contiguous subarray sum.\"\"\"\n\n    def max_sub_array_sum(self, nums: List[int], length: int) -> int:\n        \"\"\"Validates the input length and computes the maximum contiguous subarray sum.\"\"\"\n        self._validate_length(nums, length)\n        max_sum = self._compute_max_subarray_sum(nums)\n        return max_sum\n\n    def _validate_length(self, nums: List[int], length: int) -> None:\n        \"\"\"Checks if the provided length matches the actual list size, raising an error on mismatch.\"\"\"\n        if len(nums) != length:\n            raise ValueError(\"length parameter does not match actual list size\")\n\n    def _compute_max_subarray_sum(self, nums: List[int]) -> int:\n        \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n        if not nums:\n            return 0 \n\n        current_max = nums[0]\n        global_max = nums[0]\n\n        for i in range(1, len(nums)):\n            num = nums[i]\n            current_max = max(num, current_max + num)\n            global_max = max(global_max, current_max)\n        \n        return global_max\n\n```\n```python\n# src/max_subarray.py\nfrom typing import List\nfrom .service import MaxSubArrayService\n\ndef max_sub_array_sum(nums: List[int], length: int) -> int:\n    \"\"\"\n    Computes the sum of the largest contiguous sublist in a given list of integers.\n    Delegates validation and computation to MaxSubArrayService.\n    \"\"\"\n    service = MaxSubArrayService()\n    return service.max_sub_array_sum(nums, length)\n\n```\n```python\n# src/__init__.py\nfrom .max_subarray import max_sub_array_sum\n```"}
