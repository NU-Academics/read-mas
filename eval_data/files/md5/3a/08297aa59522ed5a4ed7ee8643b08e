{"task_id": "Mbpp/643", "solution": "from typing import List, Optional\n\nclass Character:\n    \"\"\"Encapsulates a single character and provides alphabetic check.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_alphabetic(self) -> bool:\n        \"\"\"Checks if the character is an ASCII alphabet (A-Z or a-z).\"\"\"\n        return 'a' <= self.value <= 'z' or 'A' <= self.value <= 'Z'\n\nclass Word:\n    \"\"\"Represents a word, providing length and middle 'z' detection.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.value)\n\n    def has_middle_z(self) -> bool:\n        \"\"\"Checks for a lowercase 'z' not at the start or end of the word.\"\"\"\n        if self.length() < 3:\n            return False\n        for i in range(1, self.length() - 1):\n            if self.value[i] == 'z':\n                return True\n        return False\n\nclass Text:\n    \"\"\"Manages the input text, providing methods to split it into words.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def split_into_words(self) -> List[Word]:\n        \"\"\"Splits the text into Word objects using non-alphabetic characters as boundaries.\"\"\"\n        words: List[Word] = []\n        current_word_chars: List[str] = []\n\n        for char_str in self.content:\n            char_obj = Character(char_str)\n            if char_obj.is_alphabetic():\n                current_word_chars.append(char_str)\n            else:\n                if current_word_chars:\n                    words.append(Word(\"\".join(current_word_chars)))\n                    current_word_chars = []\n        \n        if current_word_chars:\n            words.append(Word(\"\".join(current_word_chars)))\n        \n        return words\n\nclass MatchResult:\n    \"\"\"Encapsulates the outcome of a text matching operation.\"\"\"\n    def __init__(self, matched: bool, matching_word: Optional[str] = None):\n        self.matched = matched\n        self.matching_word = matching_word\n\nclass TextMatcher:\n    \"\"\"Orchestrates tokenization and analysis to find words with a middle 'z'.\"\"\"\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"Determines if any word in the text contains a qualifying middle 'z'.\"\"\"\n        text_obj = Text(content=text)\n        words = text_obj.split_into_words()\n\n        for word in words:\n            if word.has_middle_z():\n                return True\n        return False\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if any word in the input string contains a lowercase 'z' not at its ends.\"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz_middle(text)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, k):\n    \"\"\"Reverses the first k elements of an array, returning a new list.\n    Handles k <= 0 and k >= length as boundary conditions.\n    \"\"\"\n    length = len(array)\n\n    if k <= 0:\n        return list(array)  # Return a shallow copy if k is non-positive.\n    if k >= length:\n        return list(reversed(array))  # Reverse the entire array if k is too large.\n\n    prefix_reversed = list(reversed(array[:k]))\n    remainder = array[k:]\n    return prefix_reversed + list(remainder)"}
{"task_id": "Mbpp/643", "solution": "```python\nimport re\nfrom typing import List\n\n# CLASS: TextInput\n# Responsibility: Encapsulate raw input string and provide basic validation.\nclass TextInput:\n    \"\"\"Encapsulates raw input string and provides basic validation.\"\"\"\n    def __init__(self, raw_text: str) -> None:\n        self.raw_text = raw_text\n\n    def validate(self) -> bool:\n        \"\"\"Validates if the raw_text is a string, raising TypeError if not.\"\"\"\n        if not isinstance(self.raw_text, str):\n            raise TypeError(\"Input must be a string.\")\n        return True\n\n# CLASS: Character\n# Responsibility: Lightweight representation of a character with position metadata.\nclass Character:\n    \"\"\"Represents a single character with its value and position.\"\"\"\n    def __init__(self, value: str, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def is_alpha(self) -> bool:\n        \"\"\"Checks if the character's value is an ASCII alphabetic letter.\"\"\"\n        return 'A' <= self.value <= 'Z' or 'a' <= self.value <= 'z'\n\n# CLASS: Word\n# Responsibility: Represent a contiguous alphabetic token with position metadata and provide contains_middle_z.\nclass Word:\n    \"\"\"Represents an alphabetic word token with its text and original indices.\"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int) -> None:\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\n\n    def contains_middle_z(self) -> bool:\n        \"\"\"Checks if a lowercase 'z' exists strictly between the first and last characters.\"\"\"\n        if self.length() < 3:\n            return False\n        # Iterate from the second character (index 1) up to, but not including, the last character.\n        for i in range(1, self.length() - 1):\n            if self.text[i] == 'z':\n                return True\n        return False\n\n# CLASS: Tokenizer\n# Responsibility: Extract contiguous ASCII alphabetic words and produce Word objects.\nclass Tokenizer:\n    \"\"\"Extracts contiguous ASCII alphabetic words from a text.\"\"\"\n    def tokenize(self, text: str) -> List[Word]:\n        \"\"\"Tokenizes the input text into a list of Word objects.\"\"\"\n        words: List[Word] = []\n        for match in re.finditer(r\"[A-Za-z]+\", text):\n            words.append(Word(match.group(0), match.start(), match.end()))\n        return words\n\n# CLASS: MatchResult\n# Responsibility: Simple container representing whether a qualifying match was found.\nclass MatchResult:\n    \"\"\"A simple container indicating if a match was found.\"\"\"\n    def __init__(self, matched: bool) -> None:\n        self.matched = matched\n\n# CLASS: TextMatcher\n# Responsibility: Orchestrate validation, tokenization, and per-word matching.\nclass TextMatcher:\n    \"\"\"Orchestrates text processing to find words with a middle 'z'.\"\"\"\n    def __init__(self) -> None:\n        self.tokenizer = Tokenizer()\n\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"Validates input, tokenizes, and checks words for a middle 'z', returning True on first match.\"\"\"\n        TextInput(text).validate()  # Validates input type, raises TypeError if non-string.\n        words = self.tokenizer.tokenize(text)\n        for word in words:\n            if word.contains_middle_z():\n                return True\n        return False\n\n# FUNCTION: text_match_wordz_middle\n# Responsibility: Public API function; thin wrapper that calls TextMatcher.text_match_wordz_middle(text).\ndef text_match_wordz_middle(text) -> bool:\n    \"\"\"Public API function to check if any word contains a lowercase 'z' not at its ends.\"\"\"\n    return TextMatcher().text_match_wordz_middle(text)\n```"}
