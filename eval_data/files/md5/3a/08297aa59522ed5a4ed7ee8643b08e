{"task_id": "Mbpp/311", "solution": "class IntegerValue:\n    \"\"\"Holds an integer value and provides conversion to binary string.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def to_binary(self) -> str:\n        \"\"\"Converts the integer to a canonical binary string (no '0b' prefix).\"\"\"\n        return bin(self.value)[2:]\n\n\nclass BitRepresentation:\n    \"\"\"Represents a binary string, with MSB at index 0.\"\"\"\n    def __init__(self, bits: str):\n        self.bits = bits\n\n    def find_left_most_unset_bit(self) -> int:\n        \"\"\"Finds the index of the first '0' bit from the left (MSB side).\"\"\"\n        for i, bit in enumerate(self.bits):\n            if bit == '0':\n                return i\n        return -1\n\n    def set_bit(self, pos: int) -> 'BitRepresentation':\n        \"\"\"Returns a new BitRepresentation with the bit at 'pos' set to '1'.\"\"\"\n        updated_bits = list(self.bits)\n        updated_bits[pos] = '1'\n        return BitRepresentation(\"\".join(updated_bits))\n\n    def to_int(self) -> int:\n        \"\"\"Converts the binary string back to an integer.\"\"\"\n        return int(self.bits, 2)\n\n\nclass ResultValue:\n    \"\"\"A simple wrapper for the resulting integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the most significant unset (left-most '0') bit in n's binary representation.\n    Returns the resulting integer.\n    \"\"\"\n    input_value = IntegerValue(n)\n    bit_representation = BitRepresentation(input_value.to_binary())\n\n    pos = bit_representation.find_left_most_unset_bit()\n\n    if pos >= 0:\n        updated_bit_representation = bit_representation.set_bit(pos)\n    else:\n        # If no '0' is found, prepend a '1' per design.\n        updated_bit_representation = BitRepresentation('1' + bit_representation.bits)\n\n    result_int = updated_bit_representation.to_int()\n    return ResultValue(result_int).value"}
{"task_id": "Mbpp/312", "solution": "```python\n# src/__init__.py\n\"\"\"Package for cone volume calculation.\"\"\"\n```\n```python\n# src/volume.py\nimport math\nfrom typing import Any\n\nclass Validator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n\n    @staticmethod\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Return True if value is int or float (excluding bool).\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    @staticmethod\n    def raise_on_invalid(value: Any) -> None:\n        \"\"\"Raise TypeError if value is not numeric.\"\"\"\n        if not Validator.is_numeric(value):\n            raise TypeError(\"radius and height must be numeric (int or float)\")\n\nclass MathService:\n    \"\"\"Provides static methods and constants for mathematical computations.\"\"\"\n\n    PI: float = math.pi\n\n    @staticmethod\n    def compute_cone_volume(radius: float, height: float) -> float:\n        \"\"\"Return (PI * radius**2 * height) / 3 as float.\"\"\"\n        return (MathService.PI * radius**2 * height) / 3\n\ndef volume_cone(radius: Any, height: Any) -> float:\n    \"\"\"Public API: validate inputs and return cone volume as float.\"\"\"\n    Validator.raise_on_invalid(radius)\n    Validator.raise_on_invalid(height)\n    return MathService.compute_cone_volume(float(radius), float(height))\n```\n```python\n# tests/test_volume.py\nimport math\nfrom src.volume import volume_cone\n\ndef test_volume_cone_assertion() -> None:\n    \"\"\"Verify the required cone volume assertion.\"\"\"\n    assert math.isclose(volume_cone(5, 12), 314.15926535897927, rel_tol=0.001)\n```"}
