{"task_id": "Mbpp/757", "solution": "```python\n# src/reverse_pair_counter.py\nfrom typing import List\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Return the number of unordered index pairs (i, j), i < j, where strings[i] is the reverse of strings[j].\"\"\"\n    count = 0\n    n = len(strings)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if strings[i] == strings[j][::-1]:\n                count += 1\n    return count\n\n```\n```python\n# tests/test_reverse_pair_counter.py\nfrom typing import List\nfrom src.reverse_pair_counter import count_reverse_pairs\n\nclass TestCase:\n    \"\"\"A test case containing input and expected output for verification.\"\"\"\n    def __init__(self, input: List[str], expected: int):\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes the test case and returns True if the result matches the expectation.\"\"\"\n        result = count_reverse_pairs(self.input)\n        return result == self.expected\n\ndef run_fr4_assertion() -> None:\n    \"\"\"Executes the FR4 concrete assertion provided in the requirements.\"\"\"\n    assert count_reverse_pairs([\"julia\", \"best\", \"tseb\", \"for\", \"ailuj\"]) == 2\n    print(\"FR4 assertion passed successfully.\")\n\nif __name__ == \"__main__\":\n    run_fr4_assertion()\n\n```"}
{"task_id": "Mbpp/757", "solution": "```python\ndef count_reverse_pairs(strings):\n    \"\"\"Counts unordered pairs (i < j) where strings[i] is the reverse of strings[j].\"\"\"\n    count = 0\n    n = len(strings)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Check for exact, case-sensitive reverse match.\n            if strings[j] == strings[i][::-1]:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/759", "solution": "import re\n\n# Canonical regex for a decimal number with one or more integer digits, a dot, and exactly two fractional digits.\n_PATTERN: str = r'^\\d+\\.\\d{2}$'\n# Compiled regex for efficient pattern matching against the canonical pattern.\n_PATTERN_RE = re.compile(_PATTERN)\n\ndef is_decimal(input: str) -> bool:\n    \"\"\"Return True iff input exactly matches the canonical pattern r'^\\d+\\.\\d{2}$'.\n    This function assumes the input is a string as per critical requirements.\n    \"\"\"\n    return _PATTERN_RE.fullmatch(input) is not None"}
{"task_id": "Mbpp/759", "solution": "```python\n# File: src/domain.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n  \"\"\"Data holder for the input string to validate.\"\"\"\n  value: str\n\n@dataclass\nclass ValidationResult:\n  \"\"\"Encapsulate validation outcome and optional reason.\"\"\"\n  is_valid: bool\n  reason: str = \"\"\n\n```\n```python\n# File: src/decimal_validator.py\nimport re\nfrom .domain import InputString, ValidationResult\n\nclass DecimalValidator:\n  \"\"\"Component that holds the validation rule and implements validation logic.\"\"\"\n  _rule_description: str = \"one-or-more digits, '.', exactly two digits\"\n  # Compiled regex for the pattern: one or more digits, '.', exactly two digits.\n  _pattern = re.compile(r'^\\d+\\.\\d{2}$')\n\n  def is_decimal(self, input_string: str) -> bool:\n    \"\"\"Public API method to check conformance, returning boolean result (FR1).\"\"\"\n    return self._matches_pattern(input_string)\n\n  def validate(self, input_string: str) -> ValidationResult:\n    \"\"\"Returns ValidationResult with is_valid and a reason for non-conformance.\"\"\"\n    if self._matches_pattern(input_string):\n      return ValidationResult(is_valid=True)\n    else:\n      return ValidationResult(is_valid=False, reason=self._rule_description)\n\n  def _matches_pattern(self, input_string: str) -> bool:\n    \"\"\"Private helper method: performs the regular expression matching.\"\"\"\n    return bool(self._pattern.match(input_string))\n\n# Module-level wrapper function that serves as the public API entry.\ndef is_decimal(input_string: str) -> bool:\n  \"\"\"Delegates to DecimalValidator().is_decimal(input_string) to check conformance.\"\"\"\n  validator = DecimalValidator()\n  return validator.is_decimal(input_string)\n\n```\n```python\n# File: src/__init__.py\nfrom .decimal_validator import is_decimal\n\n```"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Any, Dict\n\ndef _to_tuple(inner_list: List[Any]) -> tuple:\n    \"\"\"\n    Internal helper to convert an inner list to a tuple.\n    This encapsulates the conversion step as required by FR3.\n    \"\"\"\n    return tuple(inner_list)\n\ndef unique_sublists(list_of_lists: List[List[Any]]) -> Dict[tuple, int]:\n    \"\"\"\n    Counts occurrences of unique sublists within a list of lists.\n    Each sublist is converted to a tuple before counting occurrences.\n    \"\"\"\n    if not list_of_lists:\n        return {}\n\n    counts: Dict[tuple, int] = {}\n    for inner_list in list_of_lists:\n        tuple_key = _to_tuple(inner_list)\n        counts[tuple_key] = counts.get(tuple_key, 0) + 1\n\n    return counts"}
{"task_id": "Mbpp/758", "solution": "```python\ndef unique_sublists(input_list: list) -> dict:\n    \"\"\"\n    Counts identical sublists in a list, converting them to tuples, and returns a dictionary of counts.\n    This implementation trusts the caller's input types and structure.\n    \"\"\"\n    \n    # Convert each sublist to an immutable tuple, preserving element order.\n    tuple_keys = [_convert_sublist_to_tuple(s) for s in input_list]\n    \n    # Aggregate counts for each unique tuple key.\n    counts = _aggregate_counts(tuple_keys)\n    \n    return counts\n\ndef _convert_sublist_to_tuple(sublist: list) -> tuple:\n    \"\"\"Converts a list into a tuple, maintaining the order of its elements.\"\"\"\n    return tuple(sublist)\n\ndef _aggregate_counts(tuple_keys: list) -> dict:\n    \"\"\"Populates a dictionary with counts of each unique tuple key from a list.\"\"\"\n    counts = {}\n    for key in tuple_keys:\n        counts[key] = counts.get(key, 0) + 1\n    return counts\n```"}
{"task_id": "Mbpp/760", "solution": "```python\n# unique_element.py\ndef unique_Element(list) -> bool:\n    \"\"\"Return True if all elements in the provided Python list are equal; otherwise False.\n    The parameter 'list' intentionally shadows the builtin list type.\n    \"\"\"\n    return len(set(list)) <= 1\n```\n\n```python\n# test_unique_element.py\nfrom unique_element import unique_Element\n\ndef test_unique_Element_assertions() -> None:\n    \"\"\"Runs unit assertions to verify the unique_Element function's behavior.\n    Includes acceptance tests and verifies return types as specified in the design.\n    \"\"\"\n    assert unique_Element([1,1,1]) == True\n    assert unique_Element([1,2,1]) == False\n    assert unique_Element([]) == True  # Empty list is considered to have one distinct element\n    assert unique_Element([5]) == True # Single element list\n    assert unique_Element([1, 1.0, 1]) == True # Numbers that are equal values\n    assert isinstance(unique_Element([1,1,1]), bool)\n\n# To run the test, you can simply call the test function:\n# test_unique_Element_assertions()\n# print(\"All unique_Element assertions passed!\")\n```"}
{"task_id": "Mbpp/762", "solution": "```python\n# src/month30daychecker/__init__.py\n\"\"\"\nPackage initializer for month30daychecker.\nRe-exports the public API function for convenience.\n\"\"\"\nfrom .api import check_monthnumber_number\n\n__all__ = [\"check_monthnumber_number\"]\n\n# src/month30daychecker/month.py\n\"\"\"\nDomain class representing a Month.\nIt holds month properties and knows if it has 30 days.\n\"\"\"\nclass Month:\n    \"\"\"Represents a month with its number, name, and number of days.\"\"\"\n    def __init__(self, number: int, name: str = \"\", days: int = 0):\n        self.number = number\n        self.name = name\n        self.days = days\n\n    def has30Days(self) -> bool:\n        \"\"\"Determines if the month has exactly 30 days.\"\"\"\n        return self.number in {4, 6, 9, 11}\n\n# src/month30daychecker/checker.py\n\"\"\"\nService class for checking month properties.\nIt contains the core logic for identifying 30-day months.\n\"\"\"\n_THIRTY_DAY_MONTHS: set[int] = {4, 6, 9, 11}\n\nclass MonthChecker:\n    \"\"\"Provides methods to check month-related properties.\"\"\"\n    def check_monthnumber_number(self, month: int) -> bool:\n        \"\"\"\n        Checks if the given month number (1..12) has 30 days.\n        Assumes valid integer input as per constraints.\n        \"\"\"\n        return month in _THIRTY_DAY_MONTHS\n\n# src/month30daychecker/api.py\n\"\"\"\nPublic API module for the month30daychecker library.\nExposes the required function for external use.\n\"\"\"\nfrom .checker import MonthChecker\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1..12) has 30 days.\n    Delegates the check to a MonthChecker instance.\n    \"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumber_number(month)\n```"}
{"task_id": "Mbpp/760", "solution": "```python\n# unique_element/src/unique_element.py\n\nclass NumberList:\n    \"\"\"Encapsulates a list of numeric elements and computes distinct count.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def distinct_count(self) -> int:\n        \"\"\"Returns the number of distinct elements using Python equality semantics.\"\"\"\n        return len(set(self.elements))\n\nclass Result:\n    \"\"\"Simple data holder for a boolean unique flag.\"\"\"\n    def __init__(self, is_unique: bool):\n        self.is_unique = is_unique\n\ndef unique_Element(input_list: list) -> bool:\n    \"\"\"Checks if a list contains exactly one distinct element.\n    It uses the NumberList helper for distinct count calculation.\"\"\"\n    number_list = NumberList(input_list)\n    count = number_list.distinct_count()\n    return count == 1\n```\n\n```python\n# unique_element/tests/test_unique_element.py\n\nfrom src.unique_element import unique_Element\n\ndef run_test():\n    \"\"\"Executes the provided acceptance assertion for unique_Element.\n    Includes additional tests covering various scenarios.\"\"\"\n    assert unique_Element([1,1,1]) == True\n    assert unique_Element([1, 2, 1]) == False\n    assert unique_Element([2, 2.0, 2]) == True\n    assert unique_Element([]) == False\n    assert unique_Element([5]) == True\n\nif __name__ == \"__main__\":\n    run_test()\n    print(\"All tests passed for unique_Element!\")\n```"}
{"task_id": "Mbpp/762", "solution": "```python\n# month30checker/month.py\nclass Month:\n    \"\"\"Represents a calendar month with its number and properties.\"\"\"\n    def __init__(self, number: int, name: str = \"\") -> None:\n        \"\"\"Initializes a Month with a number and optional name.\"\"\"\n        self.number = number\n        self.name = name\n\n    def has30Days(self) -> bool:\n        \"\"\"Checks if the month has exactly 30 days based on its number.\"\"\"\n        return self.number in {4, 6, 9, 11}\n\n# month30checker/validation.py\nclass ValidationResult:\n    \"\"\"Stores the outcome of a validation check.\"\"\"\n    def __init__(self, isValid: bool, message: str = \"\") -> None:\n        \"\"\"Initializes ValidationResult with validity status and an optional message.\"\"\"\n        self.isValid = isValid\n        self.message = message\n\ndef validate_month_number(month_number: int) -> ValidationResult:\n    \"\"\"Validates if a given month number is an integer between 1 and 12.\"\"\"\n    if not isinstance(month_number, int):\n        return ValidationResult(isValid=False, message=\"Month number must be an integer.\")\n    if not (1 <= month_number <= 12):\n        return ValidationResult(isValid=False, message=\"Month number must be between 1 and 12.\")\n    return ValidationResult(isValid=True)\n\n# month30checker/month_checker.py\nfrom .month import Month\nfrom .validation import ValidationResult, validate_month_number\n\nclass MonthChecker:\n    \"\"\"Orchestrates validation and month-day classification logic.\"\"\"\n    def check_monthnumber_number(self, month_number: int) -> bool:\n        \"\"\"Checks if the given month number corresponds to a 30-day month, handling validation.\"\"\"\n        validation_result = validate_month_number(month_number)\n        if not validation_result.isValid:\n            raise ValueError(validation_result.message)\n\n        month = Month(number=month_number)\n        return month.has30Days()\n\n# Public API function, delegating to a MonthChecker instance.\n_month_checker_instance = MonthChecker()\ndef check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"Checks if the given month number has exactly 30 days, serving as the public API.\"\"\"\n    return _month_checker_instance.check_monthnumber_number(month_number)\n\n# month30checker/__init__.py\nfrom .month_checker import check_monthnumber_number\n```"}
{"task_id": "Mbpp/763", "solution": "```python\n__all__ = ['find_min_diff']\n\nclass Validator:\n    \"\"\"Encapsulates input validation logic.\"\"\"\n    @staticmethod\n    def validate(sequence, n) -> None:\n        \"\"\"\n        Validates n and basic sequence constraints.\n        This method performs no validation due to critical constraints.\n        \"\"\"\n        # CRITICAL REQUIREMENT: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n        # This overrides the design's explicit validation responsibilities for this class.\n        pass\n\nclass Element:\n    \"\"\"Typed wrapper representing an element's value.\"\"\"\n    def __init__(self, value):\n        \"\"\"Initializes an Element with a numeric value.\"\"\"\n        self.value = float(value)\n\nclass Sequence:\n    \"\"\"Lightweight adapter for sequence operations.\"\"\"\n    def __init__(self, sequence):\n        \"\"\"Initializes the Sequence adapter by wrapping elements in Element objects.\"\"\"\n        self._container = [Element(item) for item in sequence]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the adapted sequence.\"\"\"\n        return len(self._container)\n\n    def first_n(self, n) -> list:\n        \"\"\"Returns a list containing the first n Element objects of the sequence.\"\"\"\n        return self._container[:n]\n\nclass Result:\n    \"\"\"Container for the resulting minimum difference.\"\"\"\n    def __init__(self, min_difference: float):\n        \"\"\"Initializes a Result with the computed minimum difference.\"\"\"\n        self.min_difference = min_difference\n\ndef find_min_diff(sequence, n) -> float:\n    \"\"\"\n    Computes the minimum absolute difference among the first n elements of sequence.\n    This function orchestrates computation assuming valid inputs due to critical constraints.\n    \"\"\"\n    # CRITICAL REQUIREMENT: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n    # The validation step is omitted in adherence to this critical constraint.\n    # Validator.validate(sequence, n) # This call is skipped.\n\n    sequence_adapter = Sequence(sequence)\n    # selected_elements is a list of Element objects as per Sequence class diagram.\n    selected_elements = sequence_adapter.first_n(n)\n\n    # Extract numeric values from Element objects for sorting and computation.\n    selected_values = [e.value for e in selected_elements]\n\n    # Sort the selected values to efficiently find minimum adjacent difference.\n    sorted_values = sorted(selected_values)\n\n    min_diff = float('inf')\n    # Compute the minimum absolute difference between adjacent elements in the sorted list.\n    # If n < 2, the loop range will be empty, and min_diff will remain float('inf').\n    for i in range(1, n):\n        diff = abs(sorted_values[i] - sorted_values[i-1])\n        if diff < min_diff:\n            min_diff = diff\n            \n    # The function directly returns the numeric result as specified.\n    return min_diff\n```"}
{"task_id": "Mbpp/764", "solution": "```python\n# number_ctr_project/src/__init__.py\n# Package initializer\nfrom .number_ctr import number_ctr\n```\n```python\n# number_ctr_project/src/number_ctr.py\n\"\"\"Implementation of number_ctr(s: str) -> int per SRS.\"\"\"\n\ndef number_ctr(s: str) -> int:\n    \"\"\"Return the count of ASCII digit characters ('0'..'9') in the input string s.\n\n    Parameters:\n    - s: str -- the input string to inspect (SRS assumes caller supplies a string).\n\n    Returns:\n    - int -- number of characters in s that are one of '0','1',...,'9'.\n\n    Behavior:\n    - If s contains no digit characters, returns 0 (FR4).\n    - The function counts only ASCII characters '0'..'9' (FR2). Unicode digits outside this range are not counted.\n    \"\"\"\n    count: int = 0\n    for ch in s:\n        # explicit check for ASCII digits '0'..'9'\n        if '0' <= ch <= '9':\n            count += 1\n    return count\n```\n```python\n# number_ctr_project/tests/test_number_ctr.py\nfrom src.number_ctr import number_ctr\n\ndef run_tests() -> None:\n    \"\"\"Execute verification assertions from SRS (FR5).\n\n    Contains the exact assertion required by the SRS: assert number_ctr('program2bedone') == 1\n    \"\"\"\n    # Required assertion from SRS / FR5\n    assert number_ctr('program2bedone') == 1\n\nif __name__ == '__main__':\n    # This module acts as the verification entry point for the SRS unit test.\n    run_tests()\n    print(\"All SRS assertions passed.\")\n```"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(sequence, n):\n    \"\"\"\n    Computes the minimum absolute difference between any two distinct numeric elements\n    among the first 'n' elements of the provided sequence.\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"n must be at least 2\")\n\n    elements = list(sequence[:n])\n\n    if len(elements) < 2:\n        raise ValueError(\"At least two elements required to compute difference\")\n\n    elements.sort()\n\n    min_diff = float('inf')\n    for i in range(1, len(elements)):\n        diff = abs(elements[i] - elements[i-1])\n        min_diff = min(min_diff, diff)\n\n    return min_diff"}
