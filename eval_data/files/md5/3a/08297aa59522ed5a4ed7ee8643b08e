{"task_id": "Mbpp/96", "solution": "```python\ndef divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for an integer.\n    This implementation trusts the caller's inputs and performs no validation or absolute value conversion.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\n```"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Dict\n\ndef flatten(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"Flattens a list of lists into a single list by one level.\"\"\"\n    return [item for sublist in list_of_lists for item in sublist]\n\ndef count(flattened_sequence: List[Any]) -> Dict[Any, int]:\n    \"\"\"Counts occurrences of each element in a sequence, returning a frequency dictionary.\"\"\"\n    frequency_map = {}\n    for element in flattened_sequence:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n    return frequency_map\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"Calculates element frequencies in a flattened list of lists.\"\"\"\n    flattened_elements = flatten(list_of_lists)\n    element_frequencies = count(flattened_elements)\n    return element_frequencies"}
{"task_id": "Mbpp/96", "solution": "```python\n# src/divisor.py\n\nimport math\n\ndef validateInput(n) -> bool:\n    \"\"\"Validate input per SRS: raise TypeError if not int; raise ValueError if zero; return True if valid.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n == 0:\n        raise ValueError(\"zero has infinitely many divisors\")\n    return True\n\ndef divisor(n: int) -> int:\n    \"\"\"Public API per SRS: accept single integer parameter, return count of positive divisors of |n|, raise exceptions for invalid inputs.\"\"\"\n    validateInput(n)\n\n    n_abs = abs(n)\n    if n_abs == 1:\n        return 1\n\n    count = 0\n    # Iterate up to the square root to find divisors efficiently, accounting for pairs.\n    for i in range(1, math.isqrt(n_abs) + 1):\n        if n_abs % i == 0:\n            if i * i == n_abs:\n                count += 1 # i is a perfect square root, so it's a single divisor\n            else:\n                count += 2 # i and n_abs // i are two distinct divisors\n    return count\n```\n```python\n# tests/test_divisor.py\n\nfrom src.divisor import divisor\n\ndef test_divisor_15_returns_4():\n    \"\"\"Verify that divisor(15) correctly returns 4, as specified in the SRS.\"\"\"\n    assert divisor(15) == 4\n\n# To run this test, navigate to the project root directory and execute:\n# python -m pytest\n# or directly:\n# python tests/test_divisor.py\n```"}
{"task_id": "Mbpp/98", "solution": "```python\n# src/multiply_num.py\n\ndef multiply_num(seq):\n    \"\"\"Computes the product of all numeric elements in a sequence and divides by its length.\"\"\"\n    product = 1\n    for num in seq:\n        product *= num\n    length = len(seq)\n    return float(product / length)\n```\n\n```python\n# tests/test_multiply_num.py\nimport math\nfrom src.multiply_num import multiply_num\n\ndef test_multiply_num_acceptance():\n    \"\"\"Verifies the SRS-provided acceptance assertion for multiply_num.\"\"\"\n    assert math.isclose(multiply_num((8, 2, 3, -1, 7)), -67.2, rel_tol=0.001)\n```"}
{"task_id": "Mbpp/97", "solution": "def _flatten_once(list_of_lists: list):\n    \"\"\"Internal helper to yield elements from immediate sublists, ignoring empty ones.\"\"\"\n    for sublist in list_of_lists:\n        if sublist:\n            for element in sublist:\n                yield element\n\ndef _count_elements(iterable) -> dict:\n    \"\"\"Internal helper to count occurrences of elements in an iterable and return a frequency dictionary.\"\"\"\n    counts = {}\n    for element in iterable:\n        counts[element] = counts.get(element, 0) + 1\n    return counts\n\ndef frequency_lists(list_of_lists: list) -> dict:\n    \"\"\"Flattens a list of lists by one level and counts element frequencies.\"\"\"\n    if not list_of_lists:\n        return {}\n    \n    flattened_elements = _flatten_once(list_of_lists)\n    return _count_elements(flattened_elements)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string representation.\n    Returns \"0\" for input 0, otherwise a binary string with no leading zeros.\n    \"\"\"\n    if n == 0:\n        return \"0\"\n\n    binary_string = \"\"\n    while n > 0:\n        remainder = n % 2\n        binary_string = str(remainder) + binary_string\n        n //= 2\n    return binary_string"}
{"task_id": "Mbpp/99", "solution": "```python\n# src/decimal_to_binary/__init__.py\n\"\"\"Public API for the decimal_to_binary package.\"\"\"\nfrom .converter import decimal_to_binary\n```\n\n```python\n# src/decimal_to_binary/models.py\nfrom dataclasses import dataclass\nfrom datetime import datetime\n\n@dataclass\nclass DecimalInput:\n    \"\"\"Represents an input decimal integer.\"\"\"\n    value: int\n\n@dataclass\nclass BinaryOutput:\n    \"\"\"Represents the binary string result.\"\"\"\n    value: str\n\n@dataclass\nclass ConversionRecord:\n    \"\"\"An in-memory record for logged conversions.\"\"\"\n    id: int\n    input_value: int\n    output_value: str\n    timestamp: datetime\n\nclass ValidationError(Exception):\n    \"\"\"Represents an input validation failure.\"\"\"\n    message: str\n\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n```\n\n```python\n# src/decimal_to_binary/converter.py\nfrom datetime import datetime\nfrom .models import DecimalInput, BinaryOutput, ConversionRecord # ValidationError is defined in models, but not used here due to critical requirement.\n\n_next_record_id: int = 1\n_conversion_records: list[ConversionRecord] = [] # Stores conversion records if logging is enabled.\n\nclass DecimalToBinaryConverter:\n    \"\"\"Handles decimal to binary conversion with optional logging.\"\"\"\n    def __init__(self, logging_enabled: bool = False):\n        self.logging_enabled = logging_enabled\n\n    def decimal_to_binary(self, value: int) -> str:\n        \"\"\"Converts an integer to its binary string representation.\"\"\"\n        global _next_record_id\n\n        # CRITICAL REQUIREMENT: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n        # The design specified input validation and raising ValidationError, but this critical requirement overrides it.\n        # Therefore, assuming `value` is an `int` as per \"Trust the caller's inputs.\"\n\n        decimal_input = DecimalInput(value) # Uses domain model.\n\n        if decimal_input.value == 0:\n            binary_string = '0'\n        else:\n            # Python's bin() handles positive, negative, and zero.\n            # bin(8) -> '0b1000', bin(0) -> '0b0', bin(-8) -> '-0b1000'.\n            # Stripping '0b' handles all cases to meet \"no leading zeros\" (for positive) and \"0\" for zero.\n            binary_string = bin(decimal_input.value).replace('0b', '')\n\n        binary_output = BinaryOutput(binary_string) # Uses domain model.\n\n        if self.logging_enabled:\n            _conversion_records.append(\n                ConversionRecord(\n                    id=_next_record_id,\n                    input_value=decimal_input.value,\n                    output_value=binary_output.value,\n                    timestamp=datetime.now()\n                )\n            )\n            _next_record_id += 1\n\n        return binary_output.value\n\n# Module-level function as the primary entry point, delegating to a converter instance.\n_default_converter = DecimalToBinaryConverter(logging_enabled=False)\n\ndef decimal_to_binary(value: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string using the library's converter.\"\"\"\n    return _default_converter.decimal_to_binary(value)\n```"}
{"task_id": "Mbpp/98", "solution": "```python\n# src/multiply_num.py\nfrom typing import Sequence, Union\n\nclass SequenceInput:\n    \"\"\"Encapsulates the input sequence for validation and processing.\"\"\"\n    def __init__(self, values: Sequence[Union[int, float]]):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated sequence.\"\"\"\n        return len(self.values)\n\n    def validate_non_empty(self) -> None:\n        \"\"\"Raises ValueError if the sequence is empty.\"\"\"\n        if not self.values:\n            raise ValueError(\"Sequence cannot be empty.\")\n\n    def validate_all_numeric(self) -> None:\n        \"\"\"Raises TypeError if any element is not an int or float.\"\"\"\n        for value in self.values:\n            element = NumericElement(value)\n            if not element.is_numeric():\n                raise TypeError(\"All elements must be numeric (int or float).\")\n\nclass NumericElement:\n    \"\"\"Represents a single element and checks if it's numeric.\"\"\"\n    def __init__(self, value: any):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the element's value is an int or float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass CalculationResult:\n    \"\"\"Holds the final numeric result and provides it as a float.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def as_float(self) -> float:\n        \"\"\"Returns the stored result as a float.\"\"\"\n        return self.value\n\ndef _validate_input(seq_input: SequenceInput) -> None:\n    \"\"\"Orchestrates validation for the sequence input.\"\"\"\n    seq_input.validate_non_empty()\n    seq_input.validate_all_numeric()\n\ndef _compute_product(seq_input: SequenceInput) -> float:\n    \"\"\"Computes the product of all numeric elements in the sequence.\"\"\"\n    product = 1.0\n    for value in seq_input.values:\n        product *= float(value)\n    return product\n\ndef _divide_by_length(product: float, length: int) -> float:\n    \"\"\"Divides the product by the sequence length.\"\"\"\n    return product / float(length)\n\ndef multiply_num(seq: Sequence[Union[int, float]]) -> float:\n    \"\"\"\n    Multiplies all numbers in a sequence, then divides by its length.\n    It validates input for emptiness and numeric types, returning a float result.\n    \"\"\"\n    seq_input = SequenceInput(seq)\n    _validate_input(seq_input)\n    \n    product = _compute_product(seq_input)\n    length = seq_input.length()\n    \n    result_value = _divide_by_length(product, length)\n    calculation_result = CalculationResult(result_value)\n    \n    return calculation_result.as_float()\n\n__all__ = [\"multiply_num\", \"SequenceInput\", \"NumericElement\", \"CalculationResult\"]\n\n```\n```python\n# tests/test_multiply_num.py\nimport math\nimport pytest\nfrom src.multiply_num import multiply_num\n\ndef test_sample_case():\n    \"\"\"Verifies the acceptance test case with a specific tolerance.\"\"\"\n    assert math.isclose(multiply_num((8, 2, 3, -1, 7)), -67.2, rel_tol=0.001)\n\ndef test_empty_sequence():\n    \"\"\"Ensures ValueError is raised for empty input sequences.\"\"\"\n    with pytest.raises(ValueError, match=\"Sequence cannot be empty.\"):\n        multiply_num([])\n    with pytest.raises(ValueError, match=\"Sequence cannot be empty.\"):\n        multiply_num(())\n\ndef test_non_numeric_element():\n    \"\"\"Checks that TypeError is raised for non-numeric elements.\"\"\"\n    with pytest.raises(TypeError, match=\"All elements must be numeric\"):\n        multiply_num([1, 2, \"a\", 4])\n    with pytest.raises(TypeError, match=\"All elements must be numeric\"):\n        multiply_num((1, None, 3))\n\n```"}
