{"task_id": "Mbpp/252", "solution": "```python\n# complex_to_polar/__init__.py\nfrom .converter import convert\n\n__all__ = [\"convert\"]\n```\n```python\n# complex_to_polar/converter.py\nimport math\nfrom typing import Tuple, Union\n\nclass ComplexInput:\n    \"\"\"Represents a normalized complex input with real and imaginary parts.\"\"\"\n    def __init__(self, value: Union[int, float, complex]) -> None:\n        # Normalize int/float/complex to floats using the complex() constructor.\n        complex_value = complex(value)\n        self.real: float = complex_value.real\n        self.imag: float = complex_value.imag\n\nclass PolarCoordinate:\n    \"\"\"Holds computed polar coordinates (r, theta) and provides tuple output.\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r: float = r\n        self.theta: float = theta\n\n    def as_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the polar coordinates as a tuple (r, theta).\"\"\"\n        return (self.r, self.theta)\n\nclass Converter:\n    \"\"\"Encapsulates conversion logic from ComplexInput to PolarCoordinate.\"\"\"\n    def convert(self, value: Union[int, float, complex]) -> Tuple[float, float]:\n        \"\"\"Converts an input value to polar coordinates (r, theta).\"\"\"\n        complex_input = ComplexInput(value)\n        r = self._compute_magnitude(complex_input.real, complex_input.imag)\n        theta = self._compute_angle(complex_input.real, complex_input.imag)\n        polar_coord = PolarCoordinate(r, theta)\n        return polar_coord.as_tuple()\n\n    def _compute_magnitude(self, real: float, imag: float) -> float:\n        \"\"\"Computes the magnitude r = sqrt(real^2 + imag^2).\"\"\"\n        return math.sqrt(real**2 + imag**2)\n\n    def _compute_angle(self, real: float, imag: float) -> float:\n        \"\"\"Computes the angle theta = atan2(imag, real).\"\"\"\n        return math.atan2(imag, real)\n\ndef convert(value: Union[int, float, complex]) -> Tuple[float, float]:\n    \"\"\"\n    Converts a Python complex or real numeric value into polar coordinates.\n    The input can be int, float, or complex.\n    \"\"\"\n    converter = Converter()\n    return converter.convert(value)\n\n```\n```python\n# tests/test_convert.py\nfrom complex_to_polar import convert\n\ndef test_convert_one():\n    \"\"\"Verifies convert(1) returns (1.0, 0.0) as per specification.\"\"\"\n    assert convert(1) == (1.0, 0.0)\n```"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(elements, n):\n    \"\"\"Generates all combinations with repetition of elements of length n.\n    Returns combinations as a list of immutable tuples, preserving input order for n=1.\"\"\"\n    if n == 0:\n        return [()]\n\n    result = []\n    current_combination = [None] * n\n\n    def _generate_recursive(index):\n        \"\"\"Recursively builds combinations by filling each position.\"\"\"\n        if index == n:\n            result.append(tuple(current_combination))\n            return\n\n        for element in elements:\n            current_combination[index] = element\n            _generate_recursive(index + 1)\n\n    _generate_recursive(0)\n    return result"}
{"task_id": "Mbpp/256", "solution": "```python\ndef count_Primes_nums(n):\n    # Returns the count of prime numbers strictly less than n.\n    # Implements deterministic trial division for primality testing.\n\n    if n <= 2:\n        return 0\n\n    prime_count = 0\n    for candidate in range(2, n):\n        # Inlined primality test logic.\n        is_prime = True\n        \n        if candidate == 2:\n            is_prime = True\n        elif candidate % 2 == 0:\n            is_prime = False\n        else:\n            # Trial division up to integer square root of the candidate.\n            limit = int(candidate**0.5)\n            for i in range(3, limit + 1, 2):\n                if candidate % i == 0:\n                    is_prime = False\n                    break\n        \n        if is_prime:\n            prime_count += 1\n            \n    return prime_count\n```"}
{"task_id": "Mbpp/256", "solution": "```\nprime_counter_project/src/__init__.py\n```python\n__all__ = ['count_Primes_nums']\n```\n\n```\nprime_counter_project/src/prime_counter.py\n```python\n#!/usr/bin/env python3\nfrom typing import Optional\n\nclass InputNumber:\n    \"\"\"Encapsulate numeric input and non-negativity check.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated value is non-negative.\"\"\"\n        return self.value >= 0\n\nclass PrimeNumber:\n    \"\"\"Represent an integer candidate and determine primality.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_prime(self) -> bool:\n        \"\"\"Determines if the encapsulated integer is a prime number.\"\"\"\n        if self.value <= 1:\n            return False\n        if self.value <= 3:  # 2 and 3 are prime\n            return True\n        if self.value % 2 == 0 or self.value % 3 == 0:\n            return False\n        # Check for factors from 5 onwards with a step of 6 (6k +/- 1 optimization)\n        i = 5\n        # Loop up to the square root of value (using **0.5 operator)\n        while i * i <= self.value:\n            if self.value % i == 0 or self.value % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass PrimeCountResult:\n    \"\"\"Holder for integer count result.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass PrimeCounter:\n    \"\"\"Validate and compute count of primes strictly less than n.\"\"\"\n    def validate_input(self, n) -> bool:\n        \"\"\"Validates if the input number n is non-negative.\"\"\"\n        inp = InputNumber(float(n)) # Cast to float for consistency with InputNumber\n        return inp.is_non_negative()\n\n    def count_primes(self, n) -> int:\n        \"\"\"Computes the count of prime numbers strictly less than n.\"\"\"\n        count = 0\n        # Iterate through integers from 2 up to floor(n - 1)\n        for candidate in range(2, int(n)):\n            prime_candidate = PrimeNumber(candidate)\n            if prime_candidate.is_prime():\n                count += 1\n        return PrimeCountResult(count).count\n\ndef count_Primes_nums(n) -> int:\n    \"\"\"Public API function required by BR1 / FR1.\n    Behavior: validate input is non-negative, return 0 if n <= 2, else compute and return integer count of primes < n.\n    \"\"\"\n    inp = InputNumber(float(n)) # Ensure n is treated as float for InputNumber\n    pc = PrimeCounter()\n\n    if not pc.validate_input(inp.value):\n        raise ValueError('input must be non-negative') # Behavior specified in design\n\n    if inp.value <= 2:\n        return 0\n\n    return pc.count_primes(inp.value)\n```\n\n```\nprime_counter_project/tests/test_prime_counter.py\n```python\nfrom src.prime_counter import count_Primes_nums\n\nclass TestCase:\n    \"\"\"Runs the required unit test.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n\n    def run(self) -> None:\n        \"\"\"Invokes count_Primes_nums(5) and asserts equal to 2.\"\"\"\n        assert count_Primes_nums(5) == 2, f\"Test failed for count_Primes_nums(5)\"\n        print(f\"{self.name}: count_Primes_nums(5) == 2 PASSED\")\n\n# The file contains the required assertion for test verification.\n# This assertion can be run directly if the file is executed.\nif __name__ == \"__main__\":\n    # Example of running the TestCase class\n    test = TestCase(\"PrimaryTest\")\n    test.run()\n\n    # The required assertion directly as specified in the design:\n    assert count_Primes_nums(5) == 2\n```"}
{"task_id": "Mbpp/255", "solution": "class Validator:\n    \"\"\"Validates inputs for the combinations_colors function.\"\"\"\n    @staticmethod\n    def validate(elements: list, n: int) -> None:\n        \"\"\"Raises TypeError or ValueError for invalid inputs.\"\"\"\n        if not isinstance(elements, list):\n            raise TypeError(\"elements must be a list\")\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n\nclass CombinationGenerator:\n    \"\"\"Generates all ordered n-length tuples with repetition.\"\"\"\n    @staticmethod\n    def generate(elements: list, n: int) -> list:\n        \"\"\"Returns combinations in lexicographic-by-input-index order.\"\"\"\n        if n == 0:\n            return [()]\n        if not elements and n > 0:\n            return []\n\n        num_elements = len(elements)\n        result = []\n        \n        # current_indices represents the indices of elements forming a combination.\n        # It's like a base-num_elements counter for n digits.\n        current_indices = [0] * n \n\n        while True:\n            # Construct a tuple from the current indices mapping to elements.\n            combo = tuple(elements[i] for i in current_indices)\n            result.append(combo)\n\n            # Find the rightmost index that can be incremented.\n            i = n - 1\n            while i >= 0:\n                if current_indices[i] < num_elements - 1:\n                    current_indices[i] += 1\n                    # Reset subsequent indices to 0 to maintain lexicographic order.\n                    for j in range(i + 1, n):\n                        current_indices[j] = 0\n                    break\n                else:\n                    # This index has reached its maximum, move to the left.\n                    i -= 1\n            else:\n                # All indices have reached their maximum, all combinations generated.\n                break\n        \n        return result\n\ndef combinations_colors(elements: list, n: int) -> list:\n    \"\"\"Public API function to generate combinations with repetition.\"\"\"\n    Validator.validate(elements, n)\n    return CombinationGenerator.generate(elements, n)"}
