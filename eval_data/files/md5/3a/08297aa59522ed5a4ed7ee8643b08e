{"task_id": "Mbpp/108", "solution": "```python\n# src/models.py\nclass InputList:\n    \"\"\"Wrapper around a Python list representing an input list.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = list(elements)\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass ResultList:\n    \"\"\"Holds merged and sorted elements for return.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = list(elements)\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the result list.\"\"\"\n        return len(self.elements)\n\nclass Element:\n    \"\"\"Thin wrapper for an element value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n# src/sorter.py\nclass Sorter:\n    \"\"\"Sorts a collection of elements and returns a sorted list.\"\"\"\n    def sort(self, elements: list) -> list:\n        \"\"\"Returns a new list sorted in non-decreasing order.\"\"\"\n        return _default_sort(elements)\n\ndef _default_sort(elements: list) -> list:\n    \"\"\"Helper function to perform the default sorting.\"\"\"\n    return sorted(elements)\n\n# src/merge_service.py\nfrom .models import ResultList\nfrom .sorter import Sorter\n\nclass MergeService:\n    \"\"\"Merges three input sequences, delegates sorting to Sorter, and returns ResultList.\"\"\"\n    def __init__(self):\n        self._sorter = Sorter()\n    def merge(self, list1, list2, list3) -> ResultList:\n        \"\"\"Combines input lists, sorts them, and returns a ResultList.\"\"\"\n        combined = []\n        combined.extend(list1)\n        combined.extend(list2)\n        combined.extend(list3)\n        sorted_list = self._sorter.sort(combined)\n        return ResultList(elements=sorted_list)\n\n# src/merge_sorted_list.py\nfrom .merge_service import MergeService\n\ndef merge_sorted_list(list1, list2, list3) -> list:\n    \"\"\"Public API. Calls MergeService.merge and returns a plain Python list.\"\"\"\n    service = MergeService()\n    result = service.merge(list1, list2, list3)\n    return result.elements\n\n# tests/test_merge_sorted_list.py\nfrom src.merge_sorted_list import merge_sorted_list\n\ndef test_example_assertion():\n    \"\"\"Unit test that asserts the example provided in requirements.\"\"\"\n    expected_result = [4, 5, 11, 15, 19, 20, 24, 24, 25, 25, 26, 29, 48, 54, 56, 110, 154, 233]\n    actual_result = merge_sorted_list(\n        [25, 24, 15, 4, 5, 29, 110],\n        [19, 20, 11, 56, 25, 233, 154],\n        [24, 26, 54, 48]\n    )\n    assert actual_result == expected_result\n```"}
{"task_id": "Mbpp/108", "solution": "```python\n# src/input_output.py\n\"\"\"Domain data containers representing input and output lists.\"\"\"\n\nclass InputList:\n    \"\"\"Lightweight container for input list with convenience methods.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return self.length() == 0\n\nclass OutputList:\n    \"\"\"Container for result list with sort and accessor methods.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the contained elements in ascending order, in-place.\"\"\"\n        self.elements.sort()\n\n    def asList(self) -> list[int]:\n        \"\"\"Returns the contained elements as a standard list.\"\"\"\n        return self.elements\n\n```\n```python\n# src/validator.py\n\"\"\"Validate inputs conform to SRS assumptions.\"\"\"\n\nclass Validator:\n    \"\"\"Validates that a provided object is list-like and all elements are integers.\"\"\"\n    def validateIntegerList(self, lst: object) -> bool:\n        \"\"\"Returns True, trusting caller's input types per design constraints.\"\"\"\n        # Per design and critical requirements, explicit validation checks (e.g., isinstance)\n        # and error handling are forbidden; inputs are trusted.\n        return True\n\n```\n```python\n# src/duplicates_handler.py\n\"\"\"Encapsulate duplicate-preservation behavior.\"\"\"\n\nclass DuplicatesHandler:\n    \"\"\"Ensures duplicate multiplicity is preserved (identity operation for this strategy).\"\"\"\n    def preserveDuplicates(self, lst: list[int]) -> list[int]:\n        \"\"\"Returns a new list, preserving all elements and their multiplicity.\"\"\"\n        # For a concatenation-based merge, this operation is an identity function.\n        return list(lst)\n\n```\n```python\n# src/sorter.py\n\"\"\"Encapsulate sorting behavior.\"\"\"\n\nclass Sorter:\n    \"\"\"Provides sortAscending functionality.\"\"\"\n    def sortAscending(self, lst: list[int]) -> list[int]:\n        \"\"\"Returns a new list containing all elements from the input, sorted ascending.\"\"\"\n        return sorted(lst)\n\n```\n```python\n# src/merge_sorted_list.py\n\"\"\"Public API entry module exposing merge_sorted_list(...) and orchestrating the merge flow.\"\"\"\n\nfrom src.input_output import InputList, OutputList\nfrom src.validator import Validator\nfrom src.duplicates_handler import DuplicatesHandler\nfrom src.sorter import Sorter\n\nclass MergeSortedListFunction:\n    \"\"\"Orchestrates validation, merging, duplicate preservation, sorting, and output construction.\"\"\"\n    def merge(self, list1: list[int], list2: list[int], list3: list[int]) -> list[int]:\n        \"\"\"Executes the merge, sort, and duplicate preservation workflow.\"\"\"\n        validator = Validator()\n        duplicates_handler = DuplicatesHandler()\n        sorter = Sorter()\n\n        # Validate inputs (per design, inputs are trusted, validation returns True)\n        validator.validateIntegerList(list1)\n        validator.validateIntegerList(list2)\n        validator.validateIntegerList(list3)\n\n        # Concatenate inputs to form a single raw list (FR-2, FR-5)\n        merged_raw_list = list1 + list2 + list3\n\n        # Preserve duplicates (FR-4) - concatenation inherently does this, handler ensures explicit step\n        duplicates_preserved_list = duplicates_handler.preserveDuplicates(merged_raw_list)\n\n        # Sort the list in ascending order (FR-3)\n        sorted_elements = sorter.sortAscending(duplicates_preserved_list)\n\n        # Construct OutputList and return its elements as a standard list\n        output = OutputList(sorted_elements)\n        return output.asList()\n\ndef merge_sorted_list(list1: list[int], list2: list[int], list3: list[int]) -> list[int]:\n    \"\"\"\n    Public API entry function to merge three lists into a single sorted list.\n    Delegates the full orchestration to the MergeSortedListFunction class.\n    \"\"\"\n    orchestrator = MergeSortedListFunction()\n    return orchestrator.merge(list1, list2, list3)\n```"}
{"task_id": "Mbpp/111", "solution": "```python\n# src/__init__.py\nfrom .common_in_nested_lists import common_in_nested_lists\n```\n```python\n# src/common_in_nested_lists.py\ndef common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds elements common to all inner lists in a nested list.\n    Returns an empty set if the outer list is empty or no common elements exist.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize common_elements with the set of the first inner list\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the remaining inner lists and compute intersection\n    for i in range(1, len(nested_lists)):\n        inner_list_set = set(nested_lists[i])\n        common_elements.intersection_update(inner_list_set)\n        # Optimization: if common_elements becomes empty, no further intersection will change it\n        if not common_elements:\n            break\n\n    return common_elements\n```"}
{"task_id": "Mbpp/109", "solution": "```python\nfrom typing import List\n\nclass ErrorHandler:\n    \"\"\"Centralizes ValueError raising with standardized messages.\"\"\"\n    def raise_value_error(self, msg: str) -> None:\n        \"\"\"Raises a ValueError with the provided message.\"\"\"\n        raise ValueError(msg)\n\nclass BinaryString:\n    \"\"\"Immutable value object representing a binary string and its operations.\"\"\"\n    def __init__(self, value: str):\n        \"\"\"Initializes a BinaryString with the given string value.\"\"\"\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def is_valid_bitstring(self) -> bool:\n        \"\"\"Checks if the string is non-empty and contains only '0' and '1'.\"\"\"\n        return len(self.value) > 0 and all(c in '01' for c in self.value)\n\n    def rotate_right_once(self) -> 'BinaryString':\n        \"\"\"Performs a single cyclic right rotation.\"\"\"\n        if not self.value:\n            return BinaryString(\"\")\n        return BinaryString(self.value[-1] + self.value[:-1])\n\n    def rotate_right(self, k: int) -> 'BinaryString':\n        \"\"\"Performs a cyclic right rotation by k positions.\"\"\"\n        length = self.length()\n        if length == 0:\n            return BinaryString(\"\")\n        effective_k = k % length\n        if effective_k == 0:\n            return BinaryString(self.value)\n        return BinaryString(self.value[-effective_k:] + self.value[:-effective_k])\n\nclass Validator:\n    \"\"\"Validates inputs s and n.\"\"\"\n    def validate_bitstring(self, s: str) -> bool:\n        \"\"\"Returns True if s is a non-empty bitstring of '0'/'1' characters.\"\"\"\n        return isinstance(s, str) and len(s) > 0 and all(c in '01' for c in s)\n\n    def validate_non_negative_int(self, n: int) -> bool:\n        \"\"\"Returns True if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass Rotator:\n    \"\"\"Generates exactly n BinaryString rotation instances.\"\"\"\n    def __init__(self, base: BinaryString):\n        \"\"\"Initializes the Rotator with a base BinaryString.\"\"\"\n        self.base = base\n\n    def generate_rotations(self, n: int) -> List['BinaryString']:\n        \"\"\"Generates rotations for indices 0 to n-1.\"\"\"\n        rotations: List[BinaryString] = []\n        for i in range(n):\n            rotations.append(self.base.rotate_right(i))\n        return rotations\n\nclass OddnessEvaluator:\n    \"\"\"Determines oddness (LSB == '1') of a BinaryString.\"\"\"\n    def is_odd(self, s: 'BinaryString') -> bool:\n        \"\"\"Returns True if the BinaryString's least-significant-bit is '1'.\"\"\"\n        if not s.value:\n            return False\n        return s.value[-1] == '1'\n\nclass Counter:\n    \"\"\"Counts how many rotations are odd.\"\"\"\n    def count_odd(self, rotations: List['BinaryString']) -> int:\n        \"\"\"Counts the number of odd BinaryString instances in the list.\"\"\"\n        odd_count = 0\n        evaluator = OddnessEvaluator()\n        for rotation in rotations:\n            if evaluator.is_odd(rotation):\n                odd_count += 1\n        return odd_count\n\ndef odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"\n    Counts how many of the first n cyclic right rotations of a binary string s\n    have a least-significant-bit '1'.\n    \"\"\"\n    validator = Validator()\n    error_handler = ErrorHandler()\n\n    if not validator.validate_bitstring(s):\n        error_handler.raise_value_error(\"s must be a non-empty bitstring containing only '0' and '1'\")\n    if not validator.validate_non_negative_int(n):\n        error_handler.raise_value_error(\"n must be a non-negative integer\")\n\n    base = BinaryString(s)\n    rotator = Rotator(base)\n    rotations = rotator.generate_rotations(n)\n    \n    counter = Counter()\n    return counter.count_odd(rotations)\n```"}
{"task_id": "Mbpp/113", "solution": "```python\nclass InputString:\n    \"\"\"Immutable holder for the input string.\n    Enforces callers supply a Python str.\n    \"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass CheckResult:\n    \"\"\"Immutable holder for boolean evaluation result.\n    Encapsulates the outcome of an integer check.\n    \"\"\"\n    def __init__(self, is_integer: bool) -> None:\n        self.is_integer = is_integer\n\nclass CheckInteger:\n    \"\"\"Encapsulates the algorithm to determine whether a string\n    consists only of ASCII digits '0'..'9'.\n    \"\"\"\n    def check(self, s: str) -> CheckResult:\n        \"\"\"Determines if the string consists only of ASCII digits '0'..'9'.\n        Returns a CheckResult object encapsulating the boolean outcome.\n        \"\"\"\n        # Combines checks for digit characters and ASCII character set.\n        is_digit_and_ascii = s.isdigit() and s.isascii()\n        return CheckResult(is_digit_and_ascii)\n\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Public API to check if a string represents an integer composed only of ASCII digits.\n    Returns True if every character in the input string is an ASCII digit '0'..'9'; False otherwise.\n    \"\"\"\n    # Create an instance of the stateless behavior class.\n    checker = CheckInteger()\n    # Delegate the check to the behavior class, receiving a CheckResult object.\n    check_result_obj = checker.check(s)\n    # Extract the boolean value from the CheckResult to return.\n    return check_result_obj.is_integer\n```"}
{"task_id": "Mbpp/109", "solution": "```python\nclass Rotation:\n    \"\"\"Holds rotated_value and offset; determines oddness.\"\"\"\n    def __init__(self, offset: int, rotated_value: str):\n        self.offset = offset\n        self.rotated_value = rotated_value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the rotated binary string is odd (rightmost char is '1').\"\"\"\n        return self.rotated_value[-1] == '1'\n\nclass BinaryString:\n    \"\"\"Represents and produces rotations of a validated binary string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self._length = len(value)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return self._length\n\n    def rotate(self, r: int) -> Rotation:\n        \"\"\"Computes a rotation based on offset r and returns a Rotation object.\"\"\"\n        offset = r % self._length\n        rotated_value = self.value[offset:] + self.value[:offset]\n        return Rotation(offset, rotated_value)\n\nclass Validator:\n    \"\"\"Validates input types and values for the odd_Equivalent system.\"\"\"\n    def validate_string(self, s):\n        \"\"\"Validates that 's' is a non-empty binary string, raising exceptions on failure.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input 's' must be a string.\")\n        if len(s) == 0:\n            raise ValueError(\"Input 's' cannot be an empty string.\")\n        if any(ch not in ('0', '1') for ch in s):\n            raise ValueError(\"Input 's' must contain only '0' or '1' characters.\")\n\n    def validate_n(self, n):\n        \"\"\"Validates that 'n' is a non-negative integer, raising exceptions on failure.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\n\nclass OddCounter:\n    \"\"\"Orchestrates validation, rotation generation, odd-checking, and aggregation.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def odd_Equivalent(self, s: str, n: int) -> int:\n        \"\"\"Public API method to count odd rotations.\"\"\"\n        self._validator.validate_string(s)\n        self._validator.validate_n(n)\n\n        if n == 0:\n            return 0\n        \n        return self._count_odd_rotations(s, n)\n\n    def _count_odd_rotations(self, s: str, n: int) -> int:\n        \"\"\"Internal helper to loop through rotations and count odd ones.\"\"\"\n        bs = BinaryString(s)\n        odd_count = 0\n        for r in range(n):\n            rot = bs.rotate(r)\n            if rot.is_odd():\n                odd_count += 1\n        return odd_count\n\ndef odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"Public API function for odd_Equivalent, delegating to OddCounter.\"\"\"\n    return OddCounter().odd_Equivalent(s, n)\n```"}
