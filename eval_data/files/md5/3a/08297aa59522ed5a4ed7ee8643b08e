   It encapsulates the input, expected outcome, and a name.\"\"\"\n    def __init__(self, name: str, input: str, expected: bool):\n        self.name = name\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> Result:\n        \"\"\"Invokes the Matcher's text_starta_endb method and returns a Result.\"\"\"\n        matcher_instance = Matcher()\n        actual_result = matcher_instance.text_starta_endb(self.input)\n        return Result(actual_result == self.expected)\n\n# Mandated automated assertion\nassert text_starta_endb(\"aabbbb\")\n\n```"}
