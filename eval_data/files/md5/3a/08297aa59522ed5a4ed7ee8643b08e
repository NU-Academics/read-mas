{"task_id": "Mbpp/644", "solution": "To implement the design specification, the following files are generated:\n\n**`src/reverse_array.py`**\n```python\n# src/reverse_array.py\n\nclass ValidationError:\n    \"\"\"Represents a domain-level validation error with a message.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates input array and k, raising ValueError for invalid inputs.\"\"\"\n    def validate(self, array: list, k: int) -> None:\n        if not isinstance(array, list):\n            raise ValueError(ValidationError(\"Input 'array' must be a list.\").message)\n        if not isinstance(k, int):\n            raise ValueError(ValidationError(\"Input 'k' must be an integer.\").message)\n        if k < 0:\n            raise ValueError(ValidationError(\"Input 'k' must be non-negative.\").message)\n        if k > len(array):\n            raise ValueError(ValidationError(\"Input 'k' cannot be greater than the length of the array.\").message)\n\nclass ReverseOperation:\n    \"\"\"Performs prefix reversal on a copy of the list, returning a new list.\"\"\"\n    def reverse_prefix(self, array: list, k: int) -> list:\n        # Create a new list with the first 'k' elements reversed and the rest unchanged.\n        # This ensures O(n) complexity and does not mutate the original array.\n        return array[:k][::-1] + array[k:]\n\ndef reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"Reverses the prefix of an array up to position k, returning a new list.\"\"\"\n    validator = InputValidator()\n    validator.validate(array, k)\n    reverser = ReverseOperation()\n    return reverser.reverse_prefix(array, k)\n\n```\n\n**`src/test_suite.py`**\n```python\n# src/test_suite.py\nimport unittest\nimport sys\nimport os\n\n# Ensure the 'src' directory is on the path to allow importing 'reverse_array' as a module.\n# This supports running as 'python -m src.test_suite' or 'python src/test_suite.py' from project root.\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))\n\nfrom src.reverse_array import reverse_Array_Upto_K\n\nclass TestSuite(unittest.TestCase):\n    \"\"\"Contains unit tests for the reverse_Array_Upto_K function.\"\"\"\n\n    def test_example(self) -> None:\n        \"\"\"Tests the mandated example assertion.\"\"\"\n        original = [1, 2, 3, 4, 5, 6]\n        expected = [4, 3, 2, 1, 5, 6]\n        result = reverse_Array_Upto_K(original, 4)\n        self.assertEqual(result, expected)\n        self.assertEqual(original, [1, 2, 3, 4, 5, 6]) # Purity check\n\n    def test_validation_array_type(self) -> None:\n        \"\"\"Ensures ValueError is raised for non-list array input.\"\"\"\n        with self.assertRaisesRegex(ValueError, \"Input 'array' must be a list.\"):\n            reverse_Array_Upto_K(\"not a list\", 2)\n\n    def test_validation_k_type(self) -> None:\n        \"\"\"Ensures ValueError is raised for non-int k input.\"\"\"\n        with self.assertRaisesRegex(ValueError, \"Input 'k' must be an integer.\"):\n            reverse_Array_Upto_K([1, 2, 3], \"not an int\")\n\n    def test_validation_k_negative(self) -> None:\n        \"\"\"Ensures ValueError is raised for negative k.\"\"\"\n        with self.assertRaisesRegex(ValueError, \"Input 'k' must be non-negative.\"):\n            reverse_Array_Upto_K([1, 2, 3], -1)\n\n    def test_validation_k_too_large(self) -> None:\n        \"\"\"Ensures ValueError is raised when k is greater than array length.\"\"\"\n        with self.assertRaisesRegex(ValueError, \"Input 'k' cannot be greater than the length of the array.\"):\n            reverse_Array_Upto_K([1, 2, 3], 4)\n\n    def test_k_zero_returns_copy(self) -> None:\n        \"\"\"Tests behavior when k is 0, expecting a shallow copy and no mutation.\"\"\"\n        original = [1, 2, 3]\n        result = reverse_Array_Upto_K(original, 0)\n        self.assertEqual(result, original)\n        self.assertIsNot(result, original) # Ensure it's a new list (shallow copy)\n        self.assertEqual(original, [1, 2, 3]) # Purity check\n\n    def test_k_len_returns_reversed(self) -> None:\n        \"\"\"Tests behavior when k is equal to the array length, expecting a full reversal.\"\"\"\n        original = [1, 2, 3]\n        expected = [3, 2, 1]\n        result = reverse_Array_Upto_K(original, 3)\n        self.assertEqual(result, expected)\n        self.assertEqual(original, [1, 2, 3]) # Purity check\n\n    def test_purity_general_case(self) -> None:\n        \"\"\"Verifies the original list remains unchanged for a general call.\"\"\"\n        original = [10, 20, 30, 40]\n        reverse_Array_Upto_K(original, 2)\n        self.assertEqual(original, [10, 20, 30, 40])\n\n    def test_empty_array(self) -> None:\n        \"\"\"Tests behavior with an empty array and k=0.\"\"\"\n        original = []\n        result = reverse_Array_Upto_K(original, 0)\n        self.assertEqual(result, [])\n        self.assertIsNot(result, original)\n        self.assertEqual(original, [])\n\n    def test_single_element_array(self) -> None:\n        \"\"\"Tests behavior with a single-element array.\"\"\"\n        original = [5]\n        result = reverse_Array_Upto_K(original, 1)\n        self.assertEqual(result, [5])\n        self.assertEqual(original, [5])\n\n    def run(self) -> None:\n        \"\"\"Executes the unit tests for the module.\"\"\"\n        # Create a test suite from all test methods in this class\n        suite = unittest.TestSuite()\n        suite.addTest(unittest.makeSuite(TestSuite))\n        # Run the tests using TextTestRunner\n        runner = unittest.TextTestRunner(verbosity=2)\n        runner.run(suite)\n\nif __name__ == '__main__':\n    # Entry point for running tests as specified in the design.\n    TestSuite().run()\n\n```"}
