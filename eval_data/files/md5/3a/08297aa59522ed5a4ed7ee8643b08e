{"task_id": "Mbpp/67", "solution": "```python\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the n-th Bell number using the Bell triangle algorithm (dynamic programming).\n    Assumes n is a non-negative integer and returns an exact integer result.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list to store the Bell triangle (Aitken's array).\n    # bell_triangle[r][c] stores the value T(r, c).\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: The first element of the triangle.\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle row by row.\n    for r in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell_triangle[r][0] = bell_triangle[r - 1][r - 1]\n        # Calculate subsequent elements in the current row.\n        for c in range(1, r + 1):\n            # Each element is the sum of the element to its left in the current row\n            # and the element diagonally up-left from the previous row.\n            bell_triangle[r][c] = bell_triangle[r][c - 1] + bell_triangle[r - 1][c - 1]\n\n    # The n-th Bell number is the first element of the n-th row.\n    return bell_triangle[n][0]\n```"}
{"task_id": "Mbpp/67", "solution": "```python\n# File: src/bell_number.py\nfrom typing import Any\n\n__all__ = [\"bell_number\", \"BellNumberCalculator\", \"InputValidator\", \"InvalidInputError\", \"Input\", \"BellNumberResult\"]\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid inputs.\n    Contains an explanatory message about the validation failure.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputValidator:\n    \"\"\"Validates that an input 'n' is a non-negative integer.\"\"\"\n    def validate_non_negative_integer(self, n: Any) -> None:\n        \"\"\"Raises InvalidInputError if n is not an int or is negative.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"Input must be an integer, but got type {type(n).__name__}.\")\n        if n < 0:\n            raise InvalidInputError(f\"Input must be a non-negative integer, but got {n}.\")\n\nclass BellNumberCalculator:\n    \"\"\"Computes Bell numbers using dynamic programming (Stirling numbers of the second kind).\"\"\"\n    def bell_number(self, n: int) -> int:\n        \"\"\"Delegates computation to an internal DP method.\"\"\"\n        return self._compute_via_dp(n)\n\n    def _compute_via_dp(self, n: int) -> int:\n        \"\"\"Internal method to compute the n-th Bell number using DP.\"\"\"\n        if n == 0:\n            return 1\n\n        # Compute Stirling numbers of the second kind S(i, k)\n        # S(i, k) = S(i-1, k-1) + k * S(i-1, k)\n        stirling = [[0] * (n + 1) for _ in range(n + 1)]\n        stirling[0][0] = 1 # Base case S(0, 0) = 1\n\n        for i in range(1, n + 1):\n            for k in range(1, i + 1):\n                stirling[i][k] = stirling[i-1][k-1] + k * stirling[i-1][k]\n\n        # The n-th Bell number B(n) is the sum of S(n, k) for k from 0 to n.\n        return sum(stirling[n][k] for k in range(n + 1))\n\nclass Input:\n    \"\"\"Simple data-holder for the input 'n'.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass BellNumberResult:\n    \"\"\"Simple data-holder for the computed Bell number value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Returns the n-th Bell number.\n    Validates input and delegates computation to BellNumberCalculator.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_non_negative_integer(n)\n\n    calculator = BellNumberCalculator()\n    return calculator.bell_number(n)\n\n```\n```python\n# File: tests/test_bell_number.py\nfrom src.bell_number import bell_number\n\ndef test_bell_number_2():\n    \"\"\"Asserts that the 2nd Bell number is correctly computed as 2.\"\"\"\n    assert bell_number(2) == 2\n```"}
{"task_id": "Mbpp/68", "solution": "```python\nfrom typing import List, Any, Union\n\n# Define a 'number' type for consistency with the design specification's type hints.\nnumber = Union[int, float]\n\n# --- Domain Classes ---\n\nclass Array:\n    \"\"\"Domain wrapper over a Python list; exposes elements and length.\"\"\"\n    def __init__(self, elements: List[number]):\n        self.elements = elements\n        self.length = len(elements)\n\nclass Element:\n    \"\"\"Domain representation of an element and its index.\"\"\"\n    def __init__(self, value: number, index: int):\n        self.value = value\n        self.index = index\n\nclass Result:\n    \"\"\"Internal value object holding the boolean outcome of a check.\"\"\"\n    def __init__(self, is_monotonic: bool):\n        self.is_monotonic = is_monotonic\n\n# --- Utility Classes ---\n\nclass ErrorHandler:\n    \"\"\"Centralizes raising TypeError with consistent messages for validation failures.\"\"\"\n    def raise_type_error(self, message: str) -> None:\n        \"\"\"Raises a TypeError with the provided message.\"\"\"\n        raise TypeError(message)\n\nclass TypeValidator:\n    \"\"\"Validates input preconditions, ensuring the input is a list of comparable elements.\"\"\"\n    def __init__(self):\n        self._error_handler = ErrorHandler()\n\n    def validate_list(self, array: Any) -> None:\n        \"\"\"Raises TypeError if the input 'array' is not a list.\"\"\"\n        if not isinstance(array, list):\n            self._error_handler.raise_type_error(\"Input must be a list.\")\n\n    def validate_comparable(self, elements: List[Any]) -> None:\n        \"\"\"Raises TypeError if any element in the list is not numeric (int or float).\"\"\"\n        for i, element in enumerate(elements):\n            if not isinstance(element, (int, float)):\n                self._error_handler.raise_type_error(\n                    f\"Element at index {i} is not numeric (int or float).\"\n                )\n\n# --- Core Logic Class ---\n\nclass MonotonicChecker:\n    \"\"\"Orchestrates the actual monotonic checks on a numeric list.\"\"\"\n\n    def is_Monotonic(self, array: List[number]) -> Result:\n        \"\"\"Determines if the array is monotonic (non-decreasing or non-increasing) and returns a Result object.\"\"\"\n        if len(array) <= 1:\n            return Result(True)\n\n        if self._check_non_decreasing(array):\n            return Result(True)\n        \n        if self._check_non_increasing(array):\n            return Result(True)\n        \n        return Result(False)\n\n    def _check_non_decreasing(self, array: List[number]) -> bool:\n        \"\"\"Checks if the provided array is non-decreasing.\"\"\"\n        for i in range(1, len(array)):\n            if array[i] < array[i - 1]:\n                return False\n        return True\n\n    def _check_non_increasing(self, array: List[number]) -> bool:\n        \"\"\"Checks if the provided array is non-increasing.\"\"\"\n        for i in range(1, len(array)):\n            if array[i] > array[i - 1]:\n                return False\n        return True\n\n# --- Public API Function ---\n\ndef is_Monotonic(array: Any) -> bool:\n    \"\"\"\n    Checks if a given array (Python list) is monotonic (non-decreasing or non-increasing).\n    Raises TypeError if the input is not a list or contains non-numeric elements.\n    \"\"\"\n    validator = TypeValidator()\n    validator.validate_list(array)\n    validator.validate_comparable(array) \n\n    checker = MonotonicChecker()\n    result_obj = checker.is_Monotonic(array)\n    return result_obj.is_monotonic\n```"}
