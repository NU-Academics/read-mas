{"task_id": "Mbpp/137", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass(frozen=True)\nclass IntegerArray:\n    \"\"\"\n    Represents an ordered list of integers as a value object.\n    Provides convenience methods for construction and length.\n    \"\"\"\n    elements: List[int]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    @classmethod\n    def from_list(cls, data: List[int]) -> 'IntegerArray':\n        \"\"\"Constructs an IntegerArray from a native Python list.\"\"\"\n        return cls(elements=data)\n\ndef zero_count(arr: IntegerArray) -> float:\n    \"\"\"\n    Computes the ratio of zero elements to non-zero elements in an IntegerArray.\n    Returns float('inf') if there are no non-zero elements.\n    \"\"\"\n    zeros = 0\n    nonZeros = 0\n\n    for element in arr.elements:\n        if element == 0:\n            zeros += 1\n        else:\n            nonZeros += 1\n\n    if nonZeros == 0:\n        return float('inf')\n    else:\n        return float(zeros) / nonZeros\n```"}
{"task_id": "Mbpp/138", "solution": "```python\ndef is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Determines if an integer can be represented as a sum of one or more non-zero powers of two (2^k, k >= 1).\n    Inputs less than or equal to zero return False as per specification.\n    \"\"\"\n    if n <= 0:\n        return False\n    # Any sum of non-zero powers of two (2^k, k >= 1) will always be an even number.\n    # Conversely, any positive even number can be represented in this way.\n    return n % 2 == 0\n```"}
{"task_id": "Mbpp/138", "solution": "```python\n#!/usr/bin/env python3\nfrom typing import List\n\ndef _generate_powers_up_to(n: int) -> List[int]:\n    \"\"\"Generates powers of two (2^k, k>0) up to n.\n    These are the allowed denominations for the sum.\n    \"\"\"\n    powers = []\n    current_power = 2  # Start with 2^1\n    while current_power <= n:\n        powers.append(current_power)\n        current_power *= 2\n    return powers\n\ndef _can_make_sum_dp(n: int, coins: List[int]) -> bool:\n    \"\"\"Determines if n can be formed as a sum of coins using dynamic programming.\n    This implements an unbounded coin change approach.\n    \"\"\"\n    dp = [False] * (n + 1)\n    dp[0] = True  # Base case: 0 can be formed (empty sum)\n\n    for coin in coins:\n        for i in range(coin, n + 1):\n            dp[i] = dp[i] or dp[i - coin]\n            \n    return dp[n]\n\ndef is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"Return True if n is representable as sum of one or more 2^k with k>0; otherwise False.\n    This function uses private helpers for generating powers and dynamic programming.\n    \"\"\"\n    if n <= 0:\n        return False  # Documented decision: return False for non-positive n.\n\n    allowed_powers = _generate_powers_up_to(n)\n    \n    # If no allowed powers are generated (e.g., n=1), then it's impossible to form a sum.\n    if not allowed_powers:\n        return False\n        \n    return _can_make_sum_dp(n, allowed_powers)\n```"}
{"task_id": "Mbpp/137", "solution": "```python\nfrom typing import List\nfrom dataclasses import dataclass\n\nclass ValidationError(TypeError):\n    \"\"\"Custom exception for invalid input types. Subclasses TypeError as per FR5 and FR7.\"\"\"\n    def __init__(self, message: str = \"Invalid input type or element type.\"):\n        super().__init__(message)\n\nclass DivisionByZeroError(Exception):\n    \"\"\"Custom exception raised when non-zero element count is zero (FR4).\"\"\"\n    def __init__(self, message: str = \"Cannot compute ratio: no non-zero elements found.\"):\n        super().__init__(message)\n\n@dataclass\nclass IntegerArray:\n    \"\"\"A lightweight wrapper for a list of integers.\"\"\"\n    elements: List[int]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n@dataclass\nclass ZeroCountResult:\n    \"\"\"Holds the counts of zeros, non-zeros, and their ratio.\"\"\"\n    zero_count: int\n    non_zero_count: int\n    ratio: float\n\nclass ZeroCountService:\n    \"\"\"Stateless service for validating input, counting elements, and calculating the ratio.\"\"\"\n\n    def validate_elements_are_integers(self, elements: List[int]) -> None:\n        \"\"\"Validates that the top-level argument is a list and all its elements are integers (FR5, FR7).\"\"\"\n        if not isinstance(elements, list):\n            raise ValidationError(\"Top-level argument must be a list.\")\n        for i, elem in enumerate(elements):\n            if not isinstance(elem, int):\n                raise ValidationError(f\"Element at index {i} is not an integer.\")\n\n    def zero_count(self, elements: List[int]) -> float:\n        \"\"\"Counts zeros and non-zeros, calculates their ratio, and handles validation and errors (FR2, FR3, FR4).\"\"\"\n        self.validate_elements_are_integers(elements)\n\n        zero_count_val = 0\n        non_zero_count_val = 0\n\n        for elem in elements:  # O(n) single-pass counting (NFR2)\n            if elem == 0:\n                zero_count_val += 1\n            else:\n                non_zero_count_val += 1\n\n        if non_zero_count_val == 0:  # Raise error if no non-zero elements (FR4)\n            raise DivisionByZeroError(\"No non-zero elements found to compute ratio.\")\n\n        # Compute ratio as a float (FR2, NFR3)\n        ratio_val = float(zero_count_val) / non_zero_count_val\n        \n        # Design notes: \"Optionally construct ZeroCountResult...; return ratio (float).\"\n        return ratio_val\n\ndef zero_count(elements: List[int]) -> float:\n    \"\"\"Calculates the ratio of zero elements to non-zero elements in a list of integers (FR1).\"\"\"\n    service = ZeroCountService()\n    return service.zero_count(elements)\n```"}
{"task_id": "Mbpp/139", "solution": "```python\n# src/math_constants.py\nimport math\n\nPI: float = math.pi\n\"\"\"Mathematical constant PI, sourced from Python's math module.\"\"\"\n\n\n# src/circle.py\nfrom .math_constants import PI\n\nclass Circle:\n    \"\"\"Represents a circle with a given radius.\"\"\"\n\n    def __init__(self, radius: float):\n        \"\"\"Initializes a Circle object with a radius.\"\"\"\n        self.radius: float = float(radius)\n\n    def circumference(self) -> float:\n        \"\"\"Computes the circumference of the circle.\"\"\"\n        return 2 * PI * self.radius\n\n\n# src/circle_service.py\nfrom .math_constants import PI\n\ndef circle_circumference(radius) -> float:\n    \"\"\"\n    Computes the circumference of a circle given its radius.\n    The input radius is assumed to be numeric.\n    \"\"\"\n    # Ensure a float return type, converting input to float if necessary.\n    r = float(radius)\n    return 2 * PI * r\n```"}
{"task_id": "Mbpp/139", "solution": "```python\n# File: constants.py\n\"\"\"Provides mathematical constants.\"\"\"\n\nPI: float = 3.141592653589793\n\n```python\n# File: circle.py\n\"\"\"Implements Circle domain logic and circumference calculation.\"\"\"\n\nfrom constants import PI\n\nclass Circle:\n    \"\"\"Represents a circle with a given radius.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self.radius: float = radius\n        self.circumference: float | None = None\n\n    def compute_circumference(self) -> float:\n        \"\"\"Computes the circumference of the circle.\"\"\"\n        self.circumference = 2 * PI * self.radius\n        return self.circumference\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    This function acts as the public API as specified.\n    \"\"\"\n    circle = Circle(radius)\n    return circle.compute_circumference()\n\n```python\n# File: test_circle.py\n\"\"\"Verifies the circle_circumference function against acceptance criteria.\"\"\"\n\nimport math\nfrom circle import circle_circumference\n\ndef test_circle_circumference_10() -> None:\n    \"\"\"\n    Tests circle_circumference for radius 10 against a known value.\n    Asserts proximity using math.isclose with a relative tolerance.\n    \"\"\"\n    expected_circumference = 62.830000000000005\n    actual_circumference = circle_circumference(10)\n    assert math.isclose(actual_circumference, expected_circumference, rel_tol=0.001)\n```"}
{"task_id": "Mbpp/140", "solution": "```python\nfrom typing import Iterable, Set, Any\n\ndef _iter_inner_sequences(sequences: Iterable[Iterable[Any]]) -> Iterable[Any]:\n    \"\"\"\n    Generates items from an iterable of sequences.\n    This helper flattens the nested structure into a single stream of elements.\n    \"\"\"\n    for inner_sequence in sequences:\n        for item in inner_sequence:\n            yield item\n\ndef extract_singly(sequences: Iterable[Iterable[Any]]) -> Set[Any]:\n    \"\"\"\n    Flattens an iterable of inner sequences (tuples/lists) into a deduplicated set of numbers.\n    It returns a set containing all unique numbers found across all input sequences.\n    \"\"\"\n    result_set: Set[Any] = set()\n    for item in _iter_inner_sequences(sequences):\n        result_set.add(item)\n    return result_set\n```"}
{"task_id": "Mbpp/140", "solution": "```python\n# src/extract_singly.py\nimport numbers\nfrom typing import Iterable, Union\n\ndef extract_singly(input_iterable: Iterable[Iterable[Union[int, float, complex]]]) -> set[Union[int, float, complex]]:\n    \"\"\"\n    Flattens an iterable of iterables one level deep, collecting all numeric elements into a set.\n    Duplicates are automatically removed by set semantics.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in input_iterable:\n        for element in inner_iterable:\n            # Collects only numeric elements, fulfilling the core requirement to filter by type.\n            if isinstance(element, numbers.Number):\n                result_set.add(element)\n    return result_set\n```\n\n```python\n# tests/test_extract_singly.py\nfrom src.extract_singly import extract_singly\n\ndef test_provided_assertion():\n    \"\"\"\n    Verifies the canonical example assertion provided in the requirements.\n    This confirms the core function handles basic flattening and deduplication correctly.\n    \"\"\"\n    assert set(extract_singly([(3, 4, 5), (4, 5, 7), (1, 4)])) == set([3, 4, 5, 7, 1])\n```"}
