{"task_id": "Mbpp/564", "solution": "```python\nfrom typing import List\n\ndef count_Pairs(integers: List[int], n: int) -> int:\n    \"\"\"Counts unordered unequal pairs among the first n elements of integers.\n    It considers indices 0 <= i < j < n and increments a count if integers[i] != integers[j].\n    \"\"\"\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if integers[i] != integers[j]:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/564", "solution": "```python\ndef count_Pairs(arr: list, n: int) -> int:\n    \"\"\"Counts unordered pairs (i, j) with arr[i] != arr[j] for effective_n elements.\n    Follows the core logic of the design specification while adhering to strict output constraints.\n    \"\"\"\n    effective_n = min(n, len(arr))\n\n    if effective_n < 2:\n        return 0\n\n    count = 0\n    for i in range(effective_n):\n        for j in range(i + 1, effective_n):\n            if arr[i] != arr[j]:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/566", "solution": "```python\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of decimal digits for a non-negative integer.\n    The input 'n' is assumed to be a non-negative integer.\n    \"\"\"\n    total_sum = 0\n    # Handle the special case of 0 directly.\n    if n == 0:\n        return 0\n\n    # Iterate through the digits from right to left.\n    while n > 0:\n        total_sum += n % 10  # Add the last digit to the sum.\n        n //= 10             # Remove the last digit from the number.\n\n    return total_sum\n```"}
{"task_id": "Mbpp/566", "solution": "```python\n# src/domain.py\n\nclass InputNumber:\n    \"\"\"Represents an input integer and provides digit extraction.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the input number is non-negative.\"\"\"\n        return self.value >= 0\n\n    def extract_digits(self) -> list[\"Digit\"]:\n        \"\"\"Extracts decimal digits from the number, handling 0 specially.\"\"\"\n        if self.value == 0:\n            return [Digit(position=0, value=0)]\n\n        digits_list = []\n        str_value = str(self.value)\n        for i, char_digit in enumerate(str_value):\n            digits_list.append(Digit(position=i, value=int(char_digit)))\n        return digits_list\n\n\nclass Digit:\n    \"\"\"Represents a single decimal digit with its position.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        if not (0 <= value <= 9):\n            raise ValueError(f\"Digit value must be between 0 and 9, got {value}\")\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"Digit(position={self.position}, value={self.value})\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Digit):\n            return NotImplemented\n        return self.position == other.position and self.value == other.value\n\n\nclass SumResult:\n    \"\"\"A value object representing the sum result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"SumResult(value={self.value})\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, SumResult):\n            return NotImplemented\n        return self.value == other.value\n\n```\n\n```python\n# src/validator.py\n\nclass Validator:\n    \"\"\"Encapsulates validation logic for non-negative integers.\"\"\"\n    def validate_non_negative_integer(self, n) -> None:\n        \"\"\"Raises ValueError if n is not a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(f\"Input must be an integer, got type {type(n).__name__}.\")\n        if n < 0:\n            raise ValueError(f\"Input must be a non-negative integer, got {n}.\")\n\n```\n\n```python\n# src/sum_digits.py\n\nfrom .validator import Validator\nfrom .domain import InputNumber, SumResult\n\n\nclass SumDigitsFunction:\n    \"\"\"Orchestrates validation, digit extraction, and summation.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def sum_digits(self, n) -> int:\n        \"\"\"Computes the sum of decimal digits for a non-negative integer n.\"\"\"\n        self._validator.validate_non_negative_integer(n)\n        \n        input_num = InputNumber(value=n)\n        digits = input_num.extract_digits()\n        \n        total = sum(digit.value for digit in digits)\n        \n        # Design specifies casting through SumResult, then back to int.\n        return int(SumResult(value=total).value)\n\n\ndef sum_digits(n) -> int:\n    \"\"\"\n    Public API function: computes the sum of decimal digits of a non-negative integer.\n    Raises ValueError for invalid inputs (non-integer or negative).\n    \"\"\"\n    # Instantiate the orchestrator and delegate the call.\n    function_instance = SumDigitsFunction(Validator())\n    return function_instance.sum_digits(n)\n\n```\n\n```python\n# tests/test_sum_digits.py\n\nimport pytest\nfrom src.sum_digits import sum_digits\n\ndef test_sum_digits_example():\n    \"\"\"Verify the sum_digits function with the example from the SRS.\"\"\"\n    assert sum_digits(345) == 12\n\ndef test_sum_digits_zero():\n    \"\"\"Verify sum_digits returns 0 for n == 0 as per FR4.\"\"\"\n    assert sum_digits(0) == 0\n\ndef test_sum_digits_single_digit():\n    \"\"\"Test with a single-digit number.\"\"\"\n    assert sum_digits(7) == 7\n\ndef test_sum_digits_multi_digit():\n    \"\"\"Test with a multi-digit number.\"\"\"\n    assert sum_digits(12345) == 15\n\ndef test_sum_digits_large_number():\n    \"\"\"Test with a larger number to ensure correctness.\"\"\"\n    assert sum_digits(9876543210) == 45\n\ndef test_sum_digits_negative_input_raises_value_error():\n    \"\"\"Verify that negative inputs raise a ValueError as per FR5.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be a non-negative integer\"):\n        sum_digits(-1)\n    with pytest.raises(ValueError, match=\"Input must be a non-negative integer\"):\n        sum_digits(-100)\n\ndef test_sum_digits_float_input_raises_value_error():\n    \"\"\"Verify that float inputs raise a ValueError as per FR5.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be an integer\"):\n        sum_digits(3.14)\n    with pytest.raises(ValueError, match=\"Input must be an integer\"):\n        sum_digits(0.0) # Even 0.0 is not an integer type\n\ndef test_sum_digits_string_input_raises_value_error():\n    \"\"\"Verify that non-integer inputs (string) raise a ValueError as per FR5.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be an integer\"):\n        sum_digits(\"345\")\n\ndef test_sum_digits_none_input_raises_value_error():\n    \"\"\"Verify that None input raises a ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"Input must be an integer\"):\n        sum_digits(None)\n\n```"}
{"task_id": "Mbpp/567", "solution": "```python\nfrom typing import Any, List\n\nclass Element:\n    \"\"\"Data holder for an element's value and index.\n    Matches the Element domain model from the design.\n    \"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass InputList:\n    \"\"\"Minimal wrapper around the input list.\n    Contains Element objects as specified in the design.\n    \"\"\"\n    def __init__(self, elements: list) -> None:\n        # Wrap each element from the input list into an Element object\n        self._elements: List[Element] = [Element(value, i) for i, value in enumerate(elements)]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def __getitem__(self, index: int) -> Element:\n        \"\"\"Allows access to elements by index, returning Element objects.\"\"\"\n        return self._elements[index]\n\n    def to_list(self) -> list:\n        \"\"\"Returns a list of the raw values contained in the Element objects.\"\"\"\n        return [el.value for el in self._elements]\n\nclass Result:\n    \"\"\"Encapsulates the boolean outcome of the sortedness check.\n    Matches the Result domain model from the design.\n    \"\"\"\n    def __init__(self, is_sorted: bool) -> None:\n        self.is_sorted = is_sorted\n\nclass SortChecker:\n    \"\"\"Core logic to determine sortedness and enforce comparability error semantics.\n    Implements the validation and evaluation logic as per design.\n    \"\"\"\n    def issort_list(self, lst: list) -> bool:\n        \"\"\"Determines if a list is sorted in non-decreasing order.\n        Handles empty/single-element lists and delegates to internal evaluation.\n        \"\"\"\n        input_list = InputList(lst)\n\n        if len(input_list) <= 1:\n            return True\n\n        # Pass the raw values to _evaluate_non_decreasing as its signature expects a list of Any.\n        return self._evaluate_non_decreasing(input_list.to_list())\n\n    def _check_comparable(self, a: object, b: object) -> bool:\n        \"\"\"Attempts a comparison to trigger TypeError if elements are incomparable.\n        Raises TypeError if comparison fails, otherwise returns True.\n        \"\"\"\n        try:\n            # Attempt both directions to be robust against custom comparison implementations.\n            _ = a <= b\n            _ = a > b\n            return True\n        except TypeError:\n            raise # Re-raise TypeError as per design specification (BR6 / FR4)\n\n    def _evaluate_non_decreasing(self, elements: list) -> bool:\n        \"\"\"Evaluates if elements are in non-decreasing order.\n        Iterates adjacent pairs, checking comparability and order.\n        \"\"\"\n        for i in range(len(elements) - 1):\n            a = elements[i]\n            b = elements[i+1]\n            self._check_comparable(a, b) # This will raise TypeError if not comparable\n            if a > b:\n                return False\n        return True\n\ndef issort_list(lst) -> bool:\n    \"\"\"Checks if a list is sorted in non-decreasing order.\n    This is the public API function, delegating to SortChecker.\n    \"\"\"\n    checker = SortChecker()\n    return checker.issort_list(lst)\n\ndef _demo_main():\n    \"\"\"Demonstrates the issort_list function with example cases.\n    Includes the concrete assertion from the SRS and handles TypeError examples.\n    \"\"\"\n    # Concrete assertion from SRS (FR5 / BR7)\n    assert issort_list([1, 2, 4, 6, 8, 10, 12, 14, 16, 17]) == True\n    print(\"Assertion for [1,2,4,6,8,10,12,14,16,17] (True case) passed.\")\n\n    # Other examples\n    print(f\"issort_list([]): {issort_list([])} (Expected: True)\")\n    print(f\"issort_list([5]): {issort_list([5])} (Expected: True)\")\n    print(f\"issort_list([1, 2, 3]): {issort_list([1, 2, 3])} (Expected: True)\")\n    print(f\"issort_list([3, 2, 1]): {issort_list([3, 2, 1])} (Expected: False)\")\n    print(f\"issort_list([1, 1, 2]): {issort_list([1, 1, 2])} (Expected: True)\")\n    print(f\"issort_list([1, 5, 3]): {issort_list([1, 5, 3])} (Expected: False)\")\n\n    # Incomparable element examples\n    print(\"\\nTesting TypeError cases:\")\n    try:\n        issort_list([1, 'a'])\n    except TypeError as e:\n        print(f\"Caught expected TypeError for [1, 'a']: {e}\")\n\n    try:\n        issort_list(['a', 1])\n    except TypeError as e:\n        print(f\"Caught expected TypeError for ['a', 1]: {e}\")\n\n    try:\n        issort_list([1, 2, 'b', 4])\n    except TypeError as e:\n        print(f\"Caught expected TypeError for [1, 2, 'b', 4]: {e}\")\n\n    print(\"\\nDemo completed.\")\n\nif __name__ == '__main__':\n    _demo_main()\n```"}
{"task_id": "Mbpp/567", "solution": "```python\n# issort_list.py\n# Requires Python 3.x; exports issort_list(list) -> bool per SRS\n\ndef issort_list(list) -> bool:\n    \"\"\"Return True if 'list' is sorted in non-decreasing order (<=), else False.\n    Does not modify 'list'.\n    \"\"\"\n    if len(list) <= 1:\n        return True\n\n    for i in range(len(list) - 1):\n        if list[i] > list[i+1]:\n            return False\n            \n    return True\n```\n```python\n# test_issort_list.py\n# Test harness for issort_list; executable as: python3 test_issort_list.py\n\nfrom issort_list import issort_list\n\ndef _test_empty_and_single() -> None:\n    \"\"\"Verify empty and single-element lists are treated as sorted.\"\"\"\n    assert issort_list([]) == True\n    assert issort_list([5]) == True\n    assert issort_list(['a']) == True\n    print(\"_test_empty_and_single passed.\")\n\ndef _test_sorted_and_unsorted() -> None:\n    \"\"\"Verify various sorted and unsorted list scenarios, including required assertion.\"\"\"\n    assert issort_list([1, 2, 3, 4, 5]) == True\n    assert issort_list([1, 1, 2, 2, 3]) == True  # Non-decreasing with duplicates\n    assert issort_list([5, 4, 3, 2, 1]) == False # Descending\n    assert issort_list([1, 3, 2, 4, 5]) == False # Unsorted\n    assert issort_list(['a', 'b', 'c']) == True\n    assert issort_list(['c', 'a', 'b']) == False\n    assert issort_list([1.0, 1.5, 2.0]) == True\n    assert issort_list([1.0, 0.5, 2.0]) == False\n    \n    # Required assertion from SRS\n    assert issort_list([1,2,4,6,8,10,12,14,16,17]) == True\n    print(\"_test_sorted_and_unsorted passed.\")\n\ndef _test_non_mutation() -> None:\n    \"\"\"Verify the input list is not modified by issort_list.\"\"\"\n    list1 = [1, 3, 2, 4]\n    list1_copy = list(list1)\n    issort_list(list1)\n    assert list1 == list1_copy\n\n    list2 = [10, 20, 30]\n    list2_copy = list(list2)\n    issort_list(list2)\n    assert list2 == list2_copy\n    print(\"_test_non_mutation passed.\")\n\ndef run_all_tests() -> None:\n    \"\"\"Execute all unit test functions. Raises AssertionError on failure.\"\"\"\n    _test_empty_and_single()\n    _test_sorted_and_unsorted()\n    _test_non_mutation()\n    print(\"\\nAll issort_list tests passed successfully!\")\n\ndef main() -> None:\n    \"\"\"Main entry point for the test harness script.\"\"\"\n    run_all_tests()\n\nif __name__ == \"__main__\":\n    main()\n```"}
