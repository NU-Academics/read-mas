{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"Splits a list into n sublists, taking every nth element with offsets.\n    Each sublist preserves the relative order of its elements.\n    \"\"\"\n    return [input_list[i::n] for i in range(n)]"}
{"task_id": "Mbpp/265", "solution": "def list_split(lst, n):\n    \"\"\"\n    Return a list of n sublists, where the i-th sublist contains elements\n    from original indices i, i+n, i+2n, and so on.\n    \"\"\"\n    result = [ [] for _ in range(n) ]\n    for idx, val in enumerate(lst):\n        result[idx % n].append(val)\n    return result"}
{"task_id": "Mbpp/267", "solution": "```python\n# square_sum_project/src/__init__.py\n# This file marks the 'src' directory as a Python package.\n```\n```python\n# square_sum_project/src/square_sum.py\nfrom typing import List\n\ndef generate_odd_sequence(n: int) -> List[int]:\n    \"\"\"Return list [1, 3, 5, ..., 2*n-1] for n >= 0.\"\"\"\n    return [2 * i + 1 for i in range(n)]\n\ndef compute_squares(numbers: List[int]) -> List[int]:\n    \"\"\"Return [x*x for x in numbers].\"\"\"\n    return [x * x for x in numbers]\n\ndef sum_squares(numbers: List[int]) -> int:\n    \"\"\"Return integer sum of values in numbers.\"\"\"\n    return sum(numbers)\n\ndef square_Sum(n: int) -> int:\n    \"\"\"Public API: returns int sum of squares of first n odd natural numbers.\"\"\"\n    odd_numbers = generate_odd_sequence(n)\n    squared_numbers = compute_squares(odd_numbers)\n    total_sum = sum_squares(squared_numbers)\n    return total_sum\n\nif __name__ == \"__main__\":\n    print(square_Sum(2)) # prints 10\n```\n```python\n# square_sum_project/tests/test_square_sum.py\nfrom src.square_sum import square_Sum\n\ndef test_assert_square_sum_2() -> None:\n    \"\"\"Verify the required acceptance test assert square_Sum(2) == 10.\"\"\"\n    assert square_Sum(2) == 10\n```"}
{"task_id": "Mbpp/267", "solution": "```python\ndef square_Sum(n):\n    \"\"\"\n    Computes the sum of the squares of the first n odd natural numbers.\n    This implementation adheres to constraints forbidding modular components or explicit validation.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number * odd_number\n    return total_sum\n```"}
{"task_id": "Mbpp/268", "solution": "```python\n# src/star_number.py\nfrom dataclasses import dataclass\nfrom typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Represent validation failures for input n.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputParameter:\n    \"\"\"Hold input value n and perform validation.\"\"\"\n    def __init__(self, n: Any) -> None:\n        self.n = n\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if n is integer >= 1.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\n    def validate(self) -> None:\n        \"\"\"Raises ValidationError if n is not valid.\"\"\"\n        if not self.is_valid():\n            raise ValidationError(\"Input 'n' must be an integer >= 1.\")\n\n@dataclass\nclass StarNumber:\n    \"\"\"Data holder for computed star number and source n.\"\"\"\n    value: int\n    n: int\n\nclass StarNumberCalculator:\n    \"\"\"Orchestrate validation and computation; encapsulate the formula.\"\"\"\n    formula: str = \"S(n)=6*n*(n-1)+1\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Compute 6*n*(n-1)+1.\"\"\"\n        return 6 * n * (n - 1) + 1\n\n    def find_star_num(self, n: Any) -> int:\n        \"\"\"Validate input and return computed integer.\"\"\"\n        param = InputParameter(n)\n        param.validate()\n        \n        computed_value = self.compute(n)\n        _ = StarNumber(value=computed_value, n=n) # Data holder created internally.\n        return computed_value\n\n_calculator = StarNumberCalculator()\n\ndef find_star_num(n: int) -> int:\n    \"\"\"Public API for finding the nth star number, delegates to StarNumberCalculator.\"\"\"\n    return _calculator.find_star_num(n)\n\n```\n```python\n# tests/test_star_number.py\nfrom dataclasses import dataclass\nfrom src.star_number import find_star_num, ValidationError\n\n@dataclass\nclass TestCase:\n    \"\"\"Encapsulate an executable test case that checks the function under test.\"\"\"\n    input: int\n    expected: int\n    passed: bool = False\n\n    def run(self) -> bool:\n        \"\"\"Calls find_star_num(self.input), compares to expected, sets passed and returns passed.\"\"\"\n        try:\n            result = find_star_num(self.input)\n            self.passed = (result == self.expected)\n            print(f\"Test Case (input={self.input}, expected={self.expected}): {'PASSED' if self.passed else 'FAILED'} (Got: {result})\")\n        except ValidationError as e:\n            print(f\"Test Case (input={self.input}, expected={self.expected}): FAILED (ValidationError: {e.message})\")\n            self.passed = False\n        except Exception as e:\n            print(f\"Test Case (input={self.input}, expected={self.expected}): FAILED (Unexpected error: {type(e).__name__} - {e})\")\n            self.passed = False\n        return self.passed\n\ndef run_acceptance_tests() -> None:\n    \"\"\"Builds and runs TestCase(s) and contains assert find_star_num(3) == 37.\"\"\"\n    print(\"Running acceptance tests...\")\n    \n    # Run using the TestCase abstraction\n    test_case_3 = TestCase(input=3, expected=37)\n    test_case_3.run()\n\n    # Direct assert as specified in the design\n    try:\n        assert find_star_num(3) == 37\n        print(\"Direct assertion for find_star_num(3) == 37: PASSED\")\n    except AssertionError:\n        print(\"Direct assertion for find_star_num(3) == 37: FAILED\")\n    except Exception as e:\n        print(f\"Direct assertion for find_star_num(3) == 37: FAILED with unexpected error: {e}\")\n\nif __name__ == '__main__':\n    run_acceptance_tests()\n\n```"}
