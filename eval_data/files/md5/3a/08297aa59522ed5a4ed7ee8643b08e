{"task_id": "Mbpp/276", "solution": "```python\n# src/math_library.py\nimport math\n\nPI: float = math.pi\n\"\"\"This module provides a precise PI constant.\nIt wraps math.pi to satisfy numeric precision requirements.\"\"\"\n\n```python\n# src/cylinder.py\nfrom src.math_library import PI\n\nclass Cylinder:\n    \"\"\"Represents a cylinder with a given radius and height.\n    Provides a method to calculate its volume.\"\"\"\n\n    def __init__(self, radius: float, height: float) -> None:\n        \"\"\"Initializes a Cylinder instance with radius and height.\"\"\"\n        self.radius = radius\n        self.height = height\n\n    def calculate_volume(self) -> float:\n        \"\"\"Calculates the volume of the cylinder using PI * radius^2 * height.\"\"\"\n        return PI * (self.radius ** 2) * self.height\n\n```python\n# src/volume_calculator.py\nfrom src.cylinder import Cylinder\n# PI is imported by Cylinder, so it's not strictly necessary here,\n# but the design explicitly states volume_calculator imports PI, so we keep it.\nfrom src.math_library import PI \n\ndef volume_cylinder(radius, height) -> float:\n    \"\"\"Computes the volume of a cylinder given its radius and height.\n    This function uses the Cylinder domain class and a precise PI constant.\"\"\"\n    cylinder = Cylinder(radius, height)\n    return cylinder.calculate_volume()\n\n```python\n# tests/test_volume.py\nimport math\nfrom src.volume_calculator import volume_cylinder\n\ndef test_volume_cylinder_acceptance():\n    \"\"\"Acceptance test for volume_cylinder using math.isclose for precision.\"\"\"\n    assert math.isclose(volume_cylinder(10, 5), 1570.7500000000002, rel_tol=0.001)\n\n```"}
{"task_id": "Mbpp/277", "solution": "```python\n# ./dict_filter.py\ndef dict_filter(input_dict: dict, n: int) -> dict:\n    \"\"\"Return a new dict containing only key/value pairs from input_dict whose values are >= n.\n    Preserves original keys and values for included entries.\n    \"\"\"\n    filtered_dict = {}\n    for key, value in input_dict.items():\n        if value >= n:\n            filtered_dict[key] = value\n    return filtered_dict\n\n```\n```python\n# ./test_dict_filter.py\nfrom dict_filter import dict_filter\n\ndef test_example_assertion() -> None:\n    \"\"\"Assert that dict_filter(example_input, 170) equals expected output per FR-5.\n    Raises AssertionError on failure.\n    \"\"\"\n    example_input = {'Cierra Vega': 175, 'Alden Cantrell': 180, 'Kierra Gentry': 165, 'Pierre Cox': 190}\n    expected = {'Cierra Vega': 175, 'Alden Cantrell': 180, 'Pierre Cox': 190}\n    result = dict_filter(example_input, 170)\n    assert result == expected, f\"Test failed: Expected {expected!r}, got {result!r}\"\n    print(\"Test passed: Example assertion correct.\")\n\nif __name__ == \"__main__\":\n    test_example_assertion()\n\n```"}
{"task_id": "Mbpp/277", "solution": "```python\n# src/dict_filter.py\nfrom typing import Dict, Any\n\nclass InputValidator:\n    \"\"\"Provides static methods for validating input types and comparability.\"\"\"\n\n    @staticmethod\n    def validate_types(input_dict: Dict[Any, Any], n: int) -> None:\n        \"\"\"Validates that input_dict is a dict and n is an int.\"\"\"\n        if not isinstance(input_dict, dict):\n            raise TypeError(\"input_dict must be a dict.\")\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an int.\")\n\n    @staticmethod\n    def assert_values_comparable(input_dict: Dict[Any, Any], n: int) -> None:\n        \"\"\"Ensures all dictionary values are comparable to n, raising ValueError if not.\"\"\"\n        for key, value in input_dict.items():\n            try:\n                # Attempt a comparison to check comparability.\n                _ = value >= n\n            except TypeError:\n                raise ValueError(\n                    f\"Dictionary value for key '{key}' ({value}) is not comparable with integer threshold {n}.\"\n                )\n            except Exception as e:\n                raise ValueError(\n                    f\"An unexpected error occurred when comparing value for key '{key}' ({value}) with {n}: {e}\"\n                )\n\n\nclass FilterOperation:\n    \"\"\"Encapsulates the logic for filtering dictionary entries based on a threshold.\"\"\"\n\n    def __init__(self, n: int) -> None:\n        \"\"\"Initializes the filter with a given integer threshold.\"\"\"\n        self._n = n\n\n    def apply(self, input_dict: Dict[Any, Any]) -> Dict[Any, Any]:\n        \"\"\"Applies the filter, returning a new dictionary with values greater than or equal to the threshold.\"\"\"\n        filtered_dict = {}\n        for key, value in input_dict.items():\n            if value >= self._n:\n                filtered_dict[key] = value\n        return filtered_dict\n\n\ndef dict_filter(input_dict: Dict[Any, Any], n: int) -> Dict[Any, Any]:\n    \"\"\"\n    Filters a dictionary to include only entries where the value is greater than or equal to n.\n    Raises TypeError for invalid input types or ValueError for non-comparable values.\n    \"\"\"\n    InputValidator.validate_types(input_dict, n)\n    InputValidator.assert_values_comparable(input_dict, n)\n\n    filter_op = FilterOperation(n)\n    return filter_op.apply(input_dict)\n\n```\n```python\n# tests/test_dict_filter.py\nfrom src.dict_filter import dict_filter\n\ndef test_srs_assertion():\n    \"\"\"Verifies the core filtering behavior as specified by the SRS acceptance test.\"\"\"\n    input_data = {'Cierra Vega': 175, 'Alden Cantrell': 180, 'Kierra Gentry': 165, 'Pierre Cox': 190}\n    threshold = 170\n    expected_output = {'Cierra Vega': 175, 'Alden Cantrell': 180, 'Pierre Cox': 190}\n    assert dict_filter(input_data, threshold) == expected_output\n\n```"}
