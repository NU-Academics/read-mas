{"task_id": "Mbpp/440", "solution": "```python\nfrom typing import List, Optional, Tuple\nimport string\n\nclass Sentence:\n    \"\"\"Represents the input sentence string.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\nclass Token:\n    \"\"\"Represents a lexical token with indices and provides alphabetic classification.\"\"\"\n    def __init__(self, start_index: int, end_index: int, text: str) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.text = text\n\n    def is_alphabetic(self) -> bool:\n        \"\"\"Checks if Token.text is composed only of ASCII alphabetic characters A-Z/a-z.\"\"\"\n        return all(c in string.ascii_letters for c in self.text)\n\nclass Adverb:\n    \"\"\"Represents a detected adverb result to be returned by the API.\"\"\"\n    def __init__(self, start_index: int, end_index: int, text: str) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.text = text\n\nclass Punctuation:\n    \"\"\"Represents a punctuation character and its position.\"\"\"\n    def __init__(self, symbol: str, position: int) -> None:\n        self.symbol = symbol\n        self.position = position\n\nclass AdverbFinder:\n    \"\"\"Orchestrates tokenization, analysis, detection, and index computation for adverbs.\"\"\"\n    def __init__(self, sentence_text: str) -> None:\n        self.sentence = Sentence(sentence_text)\n        self.raw = self.sentence.text\n\n    def find_adverb_position(self, sentence_text: str) -> Tuple[int, int, str]:\n        \"\"\"Identifies the first adverb's position and string within the given sentence.\"\"\"\n        self.raw = sentence_text \n        self.sentence = Sentence(sentence_text)\n\n        tokens = self._tokenize()\n        first_adverb_candidate = self._detect_first_adverb(tokens)\n\n        if first_adverb_candidate:\n            final_end_index = self._compute_adverb_end_exclusive(first_adverb_candidate)\n            return (first_adverb_candidate.start_index, final_end_index, first_adverb_candidate.text)\n        else:\n            # Behavior for no adverb found is undefined by design, returning placeholder.\n            return (0, 0, \"\")\n\n    def _tokenize(self) -> List[Token]:\n        \"\"\"Scans the raw sentence to produce a list of alphabetic tokens.\"\"\"\n        tokens_list: List[Token] = []\n        i = 0\n        n = len(self.raw)\n\n        while i < n:\n            if self.raw[i].isalpha():\n                token_start = i\n                while i < n and self.raw[i].isalpha():\n                    i += 1\n                tokens_list.append(Token(token_start, i, self.raw[token_start:i]))\n            else:\n                i += 1  # Skip non-alphabetic characters\n        return tokens_list\n\n    def _is_alphabetic_token(self, raw_slice: str) -> bool:\n        \"\"\"Checks if a string slice consists solely of ASCII alphabetic characters.\"\"\"\n        return all(c in string.ascii_letters for c in raw_slice)\n\n    def _detect_first_adverb(self, tokens: List[Token]) -> Optional[Adverb]:\n        \"\"\"Finds the first left-to-right token that ends with 'ly' (case-insensitive) and is alphabetic.\"\"\"\n        for token in tokens:\n            if self._is_alphabetic_token(token.text) and token.text.lower().endswith('ly'):\n                return Adverb(token.start_index, token.end_index, token.text)\n        return None\n\n    def _compute_adverb_end_exclusive(self, adverb_token: Adverb) -> int:\n        \"\"\"Calculates the exclusive end index of the adverb, ignoring trailing punctuation.\"\"\"\n        # The token's end_index already excludes trailing non-alphabetic characters due to tokenization.\n        return adverb_token.end_index\n\ndef find_adverb_position(sentence: str) -> Tuple[int, int, str]:\n    \"\"\"Public API: finds the first adverb and its position in the sentence.\"\"\"\n    finder = AdverbFinder(sentence)\n    return finder.find_adverb_position(sentence)\n```"}
{"task_id": "Mbpp/440", "solution": "```python\nfrom typing import Optional, Tuple, List\n\n\nclass Sentence:\n    \"\"\"Represents the input sentence text.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sentence text.\"\"\"\n        return len(self.text)\n\n\nclass Token:\n    \"\"\"Represents a token with its raw text and original string offsets.\"\"\"\n    def __init__(self, rawText: str, start: int, end: int):\n        self.rawText = rawText\n        self.start = start\n        self.end = end\n\n\nclass Tokenizer:\n    \"\"\"Splits an input sentence into a list of Token objects.\"\"\"\n    def tokenize(self, sentence_obj: Sentence) -> List[Token]:\n        \"\"\"Tokenizes the sentence by splitting on whitespace.\"\"\"\n        tokens = []\n        sentence_text = sentence_obj.text\n        n = len(sentence_text)\n        i = 0\n        while i < n:\n            while i < n and sentence_text[i].isspace(): # Skip leading whitespace\n                i += 1\n            if i == n:\n                break\n\n            start = i\n            while i < n and not sentence_text[i].isspace(): # Find end of non-whitespace sequence\n                i += 1\n            end = i\n            if start < end: # Ensure actual token text was found\n                raw_text = sentence_text[start:end]\n                tokens.append(Token(raw_text, start, end))\n        return tokens\n\n\nclass Normalizer:\n    \"\"\"Strips surrounding punctuation from a token's raw text.\"\"\"\n    def normalize(self, token: Token) -> Tuple[str, int, int]:\n        \"\"\"Returns the alphabetic-only part of the token and its absolute offsets.\"\"\"\n        raw_text = token.rawText\n        alpha_start_relative = 0\n        alpha_end_relative = len(raw_text)\n\n        for i in range(len(raw_text)): # Find first alphabetic character\n            if raw_text[i].isalpha():\n                alpha_start_relative = i\n                break\n        else: # No alphabetic characters found, return empty string and zero offsets\n            return \"\", 0, 0\n\n        for i in range(len(raw_text) - 1, -1, -1): # Find last alphabetic character\n            if raw_text[i].isalpha():\n                alpha_end_relative = i + 1\n                break\n\n        normalized_text = raw_text[alpha_start_relative:alpha_end_relative]\n        alpha_start_abs = token.start + alpha_start_relative\n        alpha_end_abs = token.start + alpha_end_relative\n        return normalized_text, alpha_start_abs, alpha_end_abs\n\n\nclass Adverb:\n    \"\"\"Represents an identified adverb with its text and original string offsets.\"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def isAdverb(self) -> bool:\n        \"\"\"Checks if the text adheres to adverb criteria.\"\"\"\n        return self.text.isalpha() and self.text.lower().endswith('ly')\n\n\nclass AdverbDetector:\n    \"\"\"Detects adverbs based on specific criteria.\"\"\"\n    def is_adverb(self, normalized_text: str) -> bool:\n        \"\"\"Determines if a normalized text is an adverb.\"\"\"\n        return normalized_text.isalpha() and normalized_text.lower().endswith('ly')\n\n    def make_adverb(self, normalized_text: str, alpha_start: int, alpha_end: int) -> Adverb:\n        \"\"\"Creates an Adverb object from detected text and offsets.\"\"\"\n        return Adverb(normalized_text, alpha_start, alpha_end)\n\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Locates the first adverb in an input sentence and returns its position and text.\n    Returns None if no adverb is found.\n    \"\"\"\n    sentence_obj = Sentence(text=sentence)\n    tokenizer = Tokenizer()\n    normalizer = Normalizer()\n    adverb_detector = AdverbDetector()\n\n    tokens = tokenizer.tokenize(sentence_obj)\n\n    for token in tokens:\n        normalized_text, alpha_start, alpha_end = normalizer.normalize(token)\n        if normalized_text and adverb_detector.is_adverb(normalized_text):\n            adverb = adverb_detector.make_adverb(normalized_text, alpha_start, alpha_end)\n            return (adverb.start, adverb.end, adverb.text)\n\n    return None\n\n```"}
