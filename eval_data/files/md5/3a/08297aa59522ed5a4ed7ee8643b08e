{"task_id": "Mbpp/414", "solution": "import collections.abc\nfrom typing import Iterable, List, Tuple, Any\n\ndef _materialize_if_iterator(seq: Iterable) -> Tuple[List, bool]:\n    \"\"\"Materializes one-shot iterables into a list, returning the list and a materialization flag.\n    For re-usable iterables, it ensures a list view or the original sequence is available.\"\"\"\n    # If the sequence is already a list or tuple, it's reusable and sized; return a copy to preserve the original.\n    if isinstance(seq, (list, tuple)):\n        return list(seq), False\n    \n    # For all other iterables (e.g., generators, map objects, sets, strings),\n    # materialize them into a list for consistent behavior and reusability.\n    materialized_list = list(seq)\n    return materialized_list, True\n\n\ndef _is_hashable_iterable(seq: Iterable, probe_limit: int = 10) -> bool:\n    \"\"\"Probes elements to determine if they are hashable, enabling a set-based strategy.\n    Returns True if all probed elements are hashable, False otherwise.\"\"\"\n    probed_count = 0\n    for element in seq: # `seq` is assumed to be a list-like iterable from `_materialize_if_iterator`.\n        if probed_count >= probe_limit:\n            break\n        try:\n            hash(element)\n        except TypeError:\n            return False # An unhashable element was found.\n        probed_count += 1\n    return True # All probed elements (or none if empty) were hashable.\n\n\ndef overlapping(seq1: Iterable, seq2: Iterable) -> bool:\n    \"\"\"Determines if any element in seq1 also appears in seq2 using Python equality semantics.\n    It prefers an O(n + m) set-based strategy for hashable elements.\"\"\"\n\n    # Materialize iterators/generators as necessary to ensure reusability and consistent length checks.\n    list1, _ = _materialize_if_iterator(seq1)\n    list2, _ = _materialize_if_iterator(seq2)\n\n    # Return False immediately if either input sequence is empty (after materialization).\n    if not list1 or not list2:\n        return False\n\n    # Determine the smaller and larger sequence for optimization.\n    if len(list1) <= len(list2):\n        smaller_seq, larger_seq = list1, list2\n    else:\n        smaller_seq, larger_seq = list2, list1\n\n    # Probe hashability of elements in the smaller sequence to choose the optimal strategy.\n    if _is_hashable_iterable(smaller_seq):\n        # Use set-based strategy (average O(n + m)) for hashable elements.\n        smaller_set = set(smaller_seq)\n        for element in larger_seq:\n            if element in smaller_set:\n                return True\n        return False\n    else:\n        # Fallback to nested comparison strategy (O(n*m)) for unhashable elements.\n        for item1 in list1:\n            for item2 in list2:\n                if item1 == item2:\n                    return True\n        return False"}
