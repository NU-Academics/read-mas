{"task_id": "Mbpp/111", "solution": "```python\nfrom typing import Any, List, Set\n\ndef common_in_nested_lists(nested_lists: list) -> list:\n    \"\"\"Finds common elements across nested lists, assuming valid input types and hashable elements.\n    Returns a list of unique elements present in every sublist.\"\"\"\n\n    if not nested_lists:\n        return []\n\n    if len(nested_lists) == 1:\n        return list(set(nested_lists[0]))\n\n    # Convert each sublist into a set to facilitate efficient intersection.\n    # This design trusts caller inputs as per critical requirements.\n    list_of_sets: List[Set[Any]] = [set(sublist) for sublist in nested_lists]\n\n    # Compute the intersection of all sets.\n    # set.intersection() can directly take multiple sets.\n    common_elements_set: Set[Any] = set.intersection(*list_of_sets)\n\n    return list(common_elements_set)\n```"}
{"task_id": "Mbpp/116", "solution": "# src/domain_models.py\nclass InputTuple:\n    \"\"\"Represents the input tuple with its elements.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\nclass TupleElement:\n    \"\"\"Represents a single element within the input tuple.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\nclass OutputInteger:\n    \"\"\"Represents the final concatenated integer output.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n# src/validator.py\nclass Validator:\n    \"\"\"Validates the input tuple and its elements based on business rules.\"\"\"\n    def validate(self, input_tuple_raw) -> list[TupleElement]:\n        \"\"\"\n        Validates the raw input; raises TypeError/ValueError on failure.\n        Returns a list of TupleElement objects on success.\n        \"\"\"\n        if not isinstance(input_tuple_raw, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n        # Using InputTuple model for conceptual clarity as per design\n        input_tuple_model = InputTuple(input_tuple_raw)\n\n        if not input_tuple_model.elements:\n            raise ValueError(\"Input tuple cannot be empty.\")\n\n        validated_elements: list[TupleElement] = []\n        for i, element_value in enumerate(input_tuple_model.elements):\n            if not isinstance(element_value, int):\n                raise ValueError(f\"Element at position {i} is not an integer: {element_value}\")\n            if element_value <= 0:\n                raise ValueError(f\"Element at position {i} is not positive: {element_value}\")\n            validated_elements.append(TupleElement(value=element_value, position=i))\n\n        return validated_elements\n\n# src/concatenator.py\nclass Concatenator:\n    \"\"\"Concatenates decimal representations of integer elements.\"\"\"\n    def concatenate(self, elements: list[TupleElement]) -> int:\n        \"\"\"\n        Transforms a list of TupleElement objects into a single concatenated integer.\n        Converts each element's value to its string representation and joins them.\n        \"\"\"\n        # The Validator ensures 'elements' is not empty for this design.\n        string_parts = [str(element.value) for element in elements]\n        concatenated_string = \"\".join(string_parts)\n        return int(concatenated_string)\n\n# src/tuple_to_int.py\nclass TupleToIntFunction:\n    \"\"\"API adapter and orchestration component for tuple_to_int conversion.\"\"\"\n    def __init__(self, validator: Validator, concatenator: Concatenator):\n        self._validator = validator\n        self._concatenator = concatenator\n\n    def tuple_to_int(self, input_tuple_raw) -> int:\n        \"\"\"\n        Orchestrates the validation and concatenation process.\n        Accepts a raw input tuple and returns a single integer.\n        \"\"\"\n        # 1. Validate the input and get normalized elements.\n        normalized_elements = self._validator.validate(input_tuple_raw)\n\n        # 2. Concatenate the validated elements.\n        concatenated_int_value = self._concatenator.concatenate(normalized_elements)\n\n        # 3. Create OutputInteger model as per design.\n        output_integer_model = OutputInteger(concatenated_int_value)\n\n        return output_integer_model.value\n\n# Public API function (entry point)\ndef tuple_to_int(input_tuple):\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenation.\n    This is the public entry point for the library component.\n    \"\"\"\n    validator_instance = Validator()\n    concatenator_instance = Concatenator()\n    adapter = TupleToIntFunction(validator_instance, concatenator_instance)\n    return adapter.tuple_to_int(input_tuple)"}
{"task_id": "Mbpp/116", "solution": "```python\n# src/tuple_to_int.py\n\ndef _validate_input(t: tuple) -> None:\n    \"\"\"Validates the input tuple and its elements.\n    Raises TypeError or ValueError on invalid input.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    for e in t:\n        if not isinstance(e, int):\n            raise TypeError(\"All tuple elements must be integers.\")\n        if e <= 0:\n            raise ValueError(\"All tuple elements must be positive integers (> 0).\")\n\ndef _element_to_decimal_str(e: int) -> str:\n    \"\"\"Converts a single integer element to its decimal string representation.\"\"\"\n    return str(e)\n\ndef tuple_to_int(t: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n    Concatenates decimal representations of elements and returns the resulting int.\n    \"\"\"\n    _validate_input(t)\n    decimal_strings = [_element_to_decimal_str(e) for e in t]\n    concatenated_string = \"\".join(decimal_strings)\n    return int(concatenated_string)\n\n```\n```python\n# tests/test_tuple_to_int.py\nimport pytest\nfrom src.tuple_to_int import tuple_to_int\n\ndef test_example_assertion() -> None:\n    \"\"\"\n    Tests the tuple_to_int function with the required assertion.\n    Verifies that tuple_to_int((1,2,3)) returns 123 and is an integer.\n    \"\"\"\n    result = tuple_to_int((1, 2, 3))\n    assert result == 123\n    assert isinstance(result, int)\n\ndef test_invalid_input_not_tuple() -> None:\n    \"\"\"Tests that non-tuple input raises TypeError.\"\"\"\n    with pytest.raises(TypeError, match=\"Input must be a tuple.\"):\n        tuple_to_int([1, 2, 3])\n\ndef test_invalid_input_element_not_int() -> None:\n    \"\"\"Tests that a tuple with a non-integer element raises TypeError.\"\"\"\n    with pytest.raises(TypeError, match=\"All tuple elements must be integers.\"):\n        tuple_to_int((1, \"2\", 3))\n\ndef test_invalid_input_element_zero() -> None:\n    \"\"\"Tests that a tuple with a zero element raises ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"All tuple elements must be positive integers (> 0).\"):\n        tuple_to_int((1, 0, 3))\n\ndef test_invalid_input_element_negative() -> None:\n    \"\"\"Tests that a tuple with a negative element raises ValueError.\"\"\"\n    with pytest.raises(ValueError, match=\"All tuple elements must be positive integers (> 0).\"):\n        tuple_to_int((1, -2, 3))\n\ndef test_empty_tuple_raises_value_error() -> None:\n    \"\"\"Tests that an empty tuple raises ValueError due to int('') conversion.\"\"\"\n    with pytest.raises(ValueError, match=\"invalid literal for int() with base 10: ''\"):\n        tuple_to_int(())\n\ndef test_single_element_tuple() -> None:\n    \"\"\"Tests a tuple with a single positive integer element.\"\"\"\n    result = tuple_to_int((42,))\n    assert result == 42\n    assert isinstance(result, int)\n\ndef test_multiple_digit_elements() -> None:\n    \"\"\"Tests a tuple with multiple-digit elements.\"\"\"\n    result = tuple_to_int((10, 200, 3))\n    assert result == 102003\n    assert isinstance(result, int)\n\n```"}
