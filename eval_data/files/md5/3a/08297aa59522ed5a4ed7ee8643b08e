       assert str(e) == \"numbers must be an iterable of numeric values\", f\"Test failed: Incorrect TypeError message: {e}\"\n        print(\"Test: TypeError for non-iterable input PASSED\")\n    except Exception as e:\n        assert False, f\"Test failed: Expected TypeError, got {type(e).__name__} for non-iterable input.\"\n\n    # Test for ValueError (non-numeric element)\n    try:\n        _sum([1, \"two\", 3])\n        assert False, \"Test failed: ValueError not raised for non-numeric element.\"\n    except ValueError as e:\n        assert str(e) == \"element at index 1 is not numeric: 'two'\", f\"Test failed: Incorrect ValueError message: {e}\"\n        print(\"Test: ValueError for non-numeric element PASSED\")\n    except Exception as e:\n        assert False, f\"Test failed: Expected ValueError, got {type(e).__name__} for non-numeric element.\"\n\n    # Test with mixed types\n    assert _sum([1, 2.5, 3]) == 6.5, f\"Test failed: _sum([1, 2.5, 3]) expected 6.5, got {_sum([1, 2.5, 3])}\"\n    print(\"Test: _sum([1, 2.5, 3]) == 6.5 PASSED\")\n\n    # Test with single element\n    assert _sum([7]) == 7, f\"Test failed: _sum([7]) expected 7, got {_sum([7])}\"\n    print(\"Test: _sum([7]) == 7 PASSED\")\n    \n    print(\"All tests PASSED.\")\n\n```"}
