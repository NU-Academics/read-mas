{"task_id": "Mbpp/602", "solution": "```python\n# src/first_repeated_char.py\nfrom typing import Optional, Dict\n\nclass InputString:\n    \"\"\"Domain wrapper for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass CharacterOccurrence:\n    \"\"\"Tracks first and second occurrence indices for a character.\"\"\"\n    def __init__(self, character: str, first_index: int):\n        self.character = character\n        self.first_index = first_index\n        self.second_index: Optional[int] = None\n        self.count: int = 1\n\n    def record_second(self, index: int) -> None:\n        \"\"\"Records the index of the second occurrence of the character.\"\"\"\n        if self.second_index is None:\n            self.second_index = index\n            self.count += 1\n\nclass Result:\n    \"\"\"Represents the selected character and its second-occurrence index.\"\"\"\n    def __init__(self, character: str, second_index: int):\n        self.character = character\n        self.second_index = second_index\n\nclass FirstRepeatedCharService:\n    \"\"\"Implements the algorithm to find the first repeated character.\"\"\"\n    def first_repeated_char(self, input_str_value: str) -> str:\n        \"\"\"\n        Finds the character whose second occurrence appears earliest.\n        Raises ValueError for non-string input or no repeated characters.\n        \"\"\"\n        if not isinstance(input_str_value, str):\n            raise ValueError(\"Input must be a string.\")\n\n        input_string = InputString(input_str_value)\n        \n        # Stores CharacterOccurrence objects, mapping character to its occurrence.\n        occurrence_map: Dict[str, CharacterOccurrence] = {}\n        \n        for index, char in enumerate(input_string.value):\n            if char not in occurrence_map:\n                occurrence_map[char] = CharacterOccurrence(char, index)\n            else:\n                # If character seen before, record its second occurrence if not already done.\n                occurrence = occurrence_map[char]\n                if occurrence.second_index is None:\n                    occurrence.record_second(index)\n\n        # Filter for characters that have a recorded second occurrence.\n        repeated_chars: list[CharacterOccurrence] = [\n            occ for occ in occurrence_map.values() if occ.second_index is not None\n        ]\n\n        if not repeated_chars:\n            raise ValueError(\"No repeated character found in the input string.\")\n\n        # Find the character with the minimum second_index (earliest second occurrence).\n        earliest_repeated_char_occurrence = min(\n            repeated_chars, key=lambda occ: occ.second_index\n        )\n        \n        # Create a Result object as per design, then return its character.\n        result_obj = Result(\n            earliest_repeated_char_occurrence.character,\n            earliest_repeated_char_occurrence.second_index\n        )\n        \n        return result_obj.character\n\n# Instantiate the service to be used by the module-level function.\n_service = FirstRepeatedCharService() \n\ndef first_repeated_char(input: str) -> str:\n    \"\"\"\n    Finds the first repeated character in the input string.\n    Raises ValueError for non-string input or if no character is repeated.\n    \"\"\"\n    return _service.first_repeated_char(input)\n```\n```python\n# src/main.py\nfrom src.first_repeated_char import first_repeated_char\n\ndef main() -> None:\n    \"\"\"\n    Main entry point for the application.\n    Executes the acceptance assertion and prints the result.\n    \"\"\"\n    test_input = \"abcabc\"\n    expected_output = \"a\"\n    result = first_repeated_char(test_input)\n    assert result == expected_output, f\"Acceptance test failed: expected '{expected_output}', got '{result}'\"\n    print(f\"Acceptance test passed for '{test_input}'. Result: '{result}'\")\n\nif __name__ == \"__main__\":\n    main()\n```\n```python\n# tests/test_first_repeated_char.py\nimport pytest\nfrom src.first_repeated_char import first_repeated_char\n\ndef test_first_repeated_char_acceptance() -> None:\n    \"\"\"\n    Verifies the core acceptance criterion for the first repeated character.\n    Asserts 'a' is returned for \"abcabc\" as specified.\n    \"\"\"\n    assert first_repeated_char(\"abcabc\") == \"a\"\n\ndef test_first_repeated_char_no_repeated_chars() -> None:\n    \"\"\"\n    Tests that ValueError is raised for strings with no repeated characters.\n    This fulfills an explicit design decision for error handling.\n    \"\"\"\n    with pytest.raises(ValueError, match=\"No repeated character found\"):\n        first_repeated_char(\"abcdefg\")\n    with pytest.raises(ValueError, match=\"No repeated character found\"):\n        first_repeated_char(\"\")\n    with pytest.raises(ValueError, match=\"No repeated character found\"):\n        first_repeated_char(\"a\")\n\ndef test_first_repeated_char_non_string_input() -> None:\n    \"\"\"\n    Tests that ValueError is raised for non-string input types.\n    This fulfills an explicit design decision for input validation.\n    \"\"\"\n    with pytest.raises(ValueError, match=\"Input must be a string\"):\n        first_repeated_char(123)\n    with pytest.raises(ValueError, match=\"Input must be a string\"):\n        first_repeated_char(None)\n    with pytest.raises(ValueError, match=\"Input must be a string\"):\n        first_repeated_char([\"a\", \"b\"])\n    with pytest.raises(ValueError, match=\"Input must be a string\"):\n        first_repeated_char(b\"byte_string\")\n\ndef test_first_repeated_char_various_inputs() -> None:\n    \"\"\"\n    Tests the function with a variety of inputs to ensure correctness.\n    Scenarios include different character sets and repetition patterns.\n    \"\"\"\n    assert first_repeated_char(\"abccba\") == \"c\"\n    assert first_repeated_char(\"aabbcc\") == \"a\"\n    assert first_repeated_char(\"hello\") == \"l\"\n    assert first_repeated_char(\"programming\") == \"r\"\n    assert first_repeated_char(\"racecar\") == \"a\"\n    assert first_repeated_char(\"banana\") == \"a\"\n    assert first_repeated_char(\"mississippi\") == \"s\" # 's' second at index 3, 'i' second at index 4\n    assert first_repeated_char(\"zzza\") == \"z\"\n    assert first_repeated_char(\"abacaba\") == \"a\" # 'a' second at index 2\n    assert first_repeated_char(\"abcdeffedcba\") == \"f\"\n```"}
{"task_id": "Mbpp/602", "solution": "```python\n# src/first_repeated_char.py\n\ndef first_repeated_char(input_string):\n    \"\"\"\n    Finds the first repeated character in a string.\n    Returns the character whose second occurrence appears earliest, or None if no character repeats.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None\n\n```\n```python\n# tests/test_first_repeated_char.py\n\n# Import the function from the source module as per design.\nfrom src.first_repeated_char import first_repeated_char\n\n# Execute the required unit test assertion from FR4.\nassert first_repeated_char(\"abcabc\") == \"a\", \"Test failed: 'abcabc' should return 'a'\"\n\n# Provide feedback that the specified tests passed.\nprint(\"All specified tests passed!\")\n\n```"}
{"task_id": "Mbpp/603", "solution": "```python\nfrom typing import List, Optional\n\nclass InputParameter:\n    \"\"\"Domain value object for input n.\"\"\"\n    def __init__(self, n: int):\n        self.n: int = n\n\nclass LudicNumber:\n    \"\"\"Domain value object for a single ludic number.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass LudicNumberList:\n    \"\"\"Holds candidate integers and enforces invariants (sort & deduplicate).\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values: List[int] = values\n\n    def sort(self) -> None:\n        \"\"\"Sorts the internal list of values in ascending order.\"\"\"\n        self.values.sort()\n\n    def deduplicate(self) -> None:\n        \"\"\"Removes duplicate values from the internal list while preserving order.\"\"\"\n        if not self.values:\n            return\n        \n        unique_values: List[int] = []\n        # Assumes the list is already sorted by the sort() method.\n        if self.values:\n            unique_values.append(self.values[0])\n            for i in range(1, len(self.values)):\n                if self.values[i] != self.values[i-1]:\n                    unique_values.append(self.values[i])\n        self.values = unique_values\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a copy of the internal list of values.\"\"\"\n        return list(self.values)\n\nclass GetLudicFunction:\n    \"\"\"Encapsulates validation and sequence generation logic.\"\"\"\n    _input: Optional[InputParameter]\n\n    def __init__(self) -> None:\n        self._input = None\n\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Orchestrates validation, generation, and postprocessing of ludic numbers.\"\"\"\n        if not self.validateInput(n):\n            return []\n        \n        # Create InputParameter as specified by the architecture diagram, though not stored as a field.\n        _ = InputParameter(n) \n\n        candidate_integers = self.generateSequence(n)\n        ludic_list = LudicNumberList(candidate_integers)\n        ludic_list.sort()\n        ludic_list.deduplicate()\n        \n        return ludic_list.to_list()\n\n    def validateInput(self, n: int) -> bool:\n        \"\"\"Checks if the input n is valid (n >= 1).\"\"\"\n        return n >= 1\n\n    def generateSequence(self, n: int) -> List[int]:\n        \"\"\"Generates candidate ludic numbers up to n using the ludic number algorithm.\"\"\"\n        if n < 1:\n            return []\n\n        ludic_numbers: List[int] = []\n        # Start with all natural numbers from 1 to n\n        candidates = list(range(1, n + 1))\n\n        while candidates:\n            # The first number in the 'candidates' list is the next ludic number\n            current_ludic = candidates[0]\n            ludic_numbers.append(current_ludic)\n\n            # Remove the current ludic number from the candidates list\n            candidates.pop(0)\n\n            # If current_ludic is 1, no further sieving is performed with it\n            if current_ludic == 1:\n                continue\n            \n            # Sieve out every current_ludic-th element from the remaining candidates.\n            # Create a new list for remaining candidates to avoid index issues during deletion.\n            new_candidates: List[int] = []\n            \n            # Keep track of which numbers to remove\n            removed_indices_counter = 0\n            for i in range(len(candidates)):\n                # If this index 'i' (in the current candidates list) is a multiple of current_ludic\n                # (adjusting for 0-based indexing relative to the \"natural order\" after the previous ludic number),\n                # then skip adding it to new_candidates.\n                # The condition for removal is that its position (1-based) in the *current* candidates list\n                # is a multiple of current_ludic.\n                # E.g., for current_ludic = 2, remove 2nd, 4th, 6th... elements (at 0-based index 1, 3, 5...)\n                if (i + 1) % current_ludic != 0:\n                    new_candidates.append(candidates[i])\n            candidates = new_candidates\n            \n        return ludic_numbers\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"Public API function to get all ludic numbers less than or equal to n.\n    It orchestrates the generation and postprocessing using domain classes.\n    \"\"\"\n    ludic_function_instance = GetLudicFunction()\n    return ludic_function_instance.get_ludic(n)\n```"}
{"task_id": "Mbpp/604", "solution": "```python\ndef _split_by_space(input: str) -> list[str]:\n    # Implementation: return input.split(' ')\n    # Behavior: preserves empty tokens for consecutive spaces\n    return input.split(' ')\n\ndef _join_with_space(words: list[str]) -> str:\n    # Implementation: return ' '.join(words)\n    return ' '.join(words)\n\ndef reverse_words(input: str) -> str:\n    \"\"\"\n    Reverses the order of words in an input string, separated by spaces.\n    Consecutive spaces result in empty tokens which are preserved and re-joined.\n    \"\"\"\n    tokens = _split_by_space(input)\n    reversed_tokens = tokens[::-1]\n    return _join_with_space(reversed_tokens)\n```"}
{"task_id": "Mbpp/604", "solution": "```python\n# src/word.py\nclass Word:\n    \"\"\"Represents a token (word) with its text and original position.\"\"\"\n    def __init__(self, text: str, position: int) -> None:\n        self.text = text\n        self.position = position\n\n    def __repr__(self) -> str:\n        return f\"Word(text='{self.text}', position={self.position})\"\n\n```\n```python\n# src/word_collection.py\nfrom typing import List, Optional\nfrom src.word import Word\n\nclass WordCollection:\n    \"\"\"Splits input into Word objects, manages their order, and joins them back.\"\"\"\n    def __init__(self, words: Optional[List[Word]] = None) -> None:\n        \"\"\"Initializes the WordCollection, optionally with a list of Word objects.\"\"\"\n        self.words = words if words is not None else []\n\n    def split(self, input: str) -> List[str]:\n        \"\"\"Splits input by ' ', populates internal Word objects, and returns original word texts.\"\"\"\n        tokens = input.split(' ')\n        self.words = [Word(text, i) for i, text in enumerate(tokens)]\n        return [word.text for word in self.words]\n\n    def reverse(self) -> List[str]:\n        \"\"\"Reverses the order of internal Word objects and returns their texts in reversed order.\"\"\"\n        self.words.reverse() # Modifies the internal list in place\n        return [word.text for word in self.words]\n\n    def join(self, separator: str) -> str:\n        \"\"\"Joins the texts of internal Word objects using the specified separator.\"\"\"\n        return separator.join([word.text for word in self.words])\n\n```\n```python\n# src/reverse_words.py\nfrom src.word_collection import WordCollection\n\ndef reverse_words(input: str) -> str:\n    \"\"\"Splits input by space, reverses word order, joins with a single space, and returns the result.\"\"\"\n    word_collection = WordCollection()\n    word_collection.split(input)  # Populates word_collection.words\n    word_collection.reverse()     # Reverses word_collection.words in place\n    return word_collection.join(' ')\n\n```\n```python\n# tests/test_assertion.py\nimport sys\nimport os\n\n# Add src to the Python path to allow importing modules from it\nscript_dir = os.path.dirname(__file__)\nproject_root = os.path.abspath(os.path.join(script_dir, os.pardir))\nsys.path.insert(0, os.path.join(project_root, 'src'))\n\nfrom reverse_words import reverse_words\n\nclass TestAssertion:\n    \"\"\"Encapsulates and runs an assertion test for the reverse_words function.\"\"\"\n    def __init__(self, input: str, expected: str) -> None:\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Executes the test and returns True for pass, False for fail.\"\"\"\n        actual = reverse_words(self.input)\n        print(f\"Input:    '{self.input}'\")\n        print(f\"Expected: '{self.expected}'\")\n        print(f\"Actual:   '{actual}'\")\n        if actual == self.expected:\n            print(\"Assertion Passed!\")\n            return True\n        else:\n            print(\"Assertion FAILED!\")\n            return False\n\nif __name__ == \"__main__\":\n    # The example assertion from FR6\n    test = TestAssertion(\"python program\", \"program python\")\n    if not test.run():\n        sys.exit(1) # Exit with a non-zero code if the assertion fails\n\n```"}
{"task_id": "Mbpp/605", "solution": "```python\n# prime-number-checker/src/__init__.py\n\"\"\"Package marker and exports for the prime number checker.\"\"\"\n\nfrom .prime_checker import prime_num, PrimeChecker, IntegerInput, Result\nfrom .test_case import TestCase\n\n__all__ = ['prime_num', 'PrimeChecker', 'IntegerInput', 'Result', 'TestCase']\n\n```\n```python\n# prime-number-checker/src/prime_checker.py\n\"\"\"Core primality logic and public API.\"\"\"\n\nclass IntegerInput:\n    \"\"\"A value object for integer input.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Result:\n    \"\"\"A value object for primality check result.\"\"\"\n    def __init__(self, is_prime: bool):\n        self.is_prime = is_prime\n\nclass PrimeChecker:\n    \"\"\"Implements the core primality testing algorithm.\"\"\"\n    def prime_num(self, n: int) -> bool:\n        \"\"\"\n        Checks if an integer n is a prime number.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Test odd divisors from 3 to floor(sqrt(n))\n        limit = int(n**0.5)\n        for d in range(3, limit + 1, 2):\n            if n % d == 0:\n                return False\n        return True\n\n_checker = PrimeChecker()\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if n is a prime number, returning True or False.\n    Delegates the core logic to PrimeChecker.\n    \"\"\"\n    return _checker.prime_num(n)\n\n```\n```python\n# prime-number-checker/src/test_case.py\n\"\"\"Encapsulates acceptance test logic.\"\"\"\n\nfrom .prime_checker import prime_num\n\nclass TestCase:\n    \"\"\"A class to encapsulate an acceptance test case.\"\"\"\n    def __init__(self, input: int, expected: bool):\n        self.input = input\n        self.expected = expected\n\n    def run(self) -> None:\n        \"\"\"Runs the test case, asserting actual result matches expected.\"\"\"\n        actual = prime_num(self.input)\n        assert actual == self.expected, f\"Test failed for input {self.input}: Expected {self.expected}, got {actual}\"\n\n```\n```python\n# prime-number-checker/src/main.py\n\"\"\"Demonstration entry-point for running the acceptance test.\"\"\"\n\nfrom .test_case import TestCase\n\ndef main() -> int:\n    \"\"\"\n    Constructs and runs the acceptance test case for prime_num(13).\n    Prints result and returns an exit code.\n    \"\"\"\n    tc = TestCase(13, True)\n    try:\n        tc.run()\n        print('Acceptance test passed')\n        return 0\n    except AssertionError:\n        print('Acceptance test FAILED')\n        return 1\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n\n```\n```python\n# prime-number-checker/tests/test_prime.py\n\"\"\"Unit test for the prime_num function.\"\"\"\n\n# Assuming tests run with package root on PYTHONPATH or via a test runner\n# that handles package imports, e.g., 'pytest prime-number-checker/tests/test_prime.py'\nfrom src.prime_checker import prime_num\n\ndef test_acceptance_prime_13():\n    \"\"\"\n    Acceptance test case for prime_num(13) == True.\n    This test satisfies FR4.\n    \"\"\"\n    assert prime_num(13) == True\n\n```"}
{"task_id": "Mbpp/605", "solution": "```python\ndef prime_num(n: int) -> bool:\n    \"\"\"Checks if the given integer n is a prime number.\n    This function implements the core primality logic as specified.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n```"}
{"task_id": "Mbpp/603", "solution": "```python\nfrom typing import List\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Computes all Ludic numbers less than or equal to n.\n    Returns an ascending list of unique integers.\n    \"\"\"\n    if n < 1:\n        return []\n\n    all_numbers = list(range(1, n + 1))\n    ludics = []\n    idx = 0\n\n    while idx < len(all_numbers):\n        ludic_number = all_numbers[idx]\n        ludics.append(ludic_number)\n\n        step = ludic_number\n        if step == 1:\n            idx += 1\n            continue\n\n        new_all_numbers = all_numbers[:idx + 1]\n        current_position_in_sieve = 0\n        for j in range(idx + 1, len(all_numbers)):\n            current_position_in_sieve += 1\n            if current_position_in_sieve % step != 0:\n                new_all_numbers.append(all_numbers[j])\n        all_numbers = new_all_numbers\n        idx += 1\n\n    return ludics\n```"}
