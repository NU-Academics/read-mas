{"task_id": "Mbpp/445", "solution": "```python\n# src/index_multiplication.py\n\n\"\"\"\nProvides the index_multiplication public function and internal helpers.\nIt computes index-wise element products of nested tuples, performing necessary validations.\n\"\"\"\n\ndef _validate_top_level_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Ensures top-level tuples have the same length; raises ValueError on mismatch.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Top-level tuples must have the same number of inner tuples.\")\n\ndef _validate_inner_tuple_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Ensures each corresponding pair of inner tuples has the same length; raises ValueError on mismatch.\"\"\"\n    for i in range(len(a)):\n        if len(a[i]) != len(b[i]):\n            raise ValueError(f\"Inner tuples at index {i} have different lengths.\")\n\ndef _validate_numeric_element(value) -> None:\n    \"\"\"Ensures a value is an int or float; raises TypeError otherwise.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(f\"All elements must be numeric (int or float), found: {type(value).__name__}.\")\n\ndef _multiply_inner_tuples(A: tuple, B: tuple) -> tuple:\n    \"\"\"\n    Multiplies elements of two equal-length inner tuples index-wise.\n    It validates that all elements are numeric before multiplication.\n    \"\"\"\n    result_elements = []\n    for j in range(len(A)):\n        _validate_numeric_element(A[j])\n        _validate_numeric_element(B[j])\n        result_elements.append(A[j] * B[j])\n    return tuple(result_elements)\n\ndef index_multiplication(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of elements within corresponding inner tuples.\n    Inputs must be tuples of tuples containing only numeric (int or float) elements.\n    \"\"\"\n    _validate_top_level_lengths(a, b)\n    _validate_inner_tuple_lengths(a, b)\n\n    result_inner_tuples = []\n    for i in range(len(a)):\n        inner_result = _multiply_inner_tuples(a[i], b[i])\n        result_inner_tuples.append(inner_result)\n\n    return tuple(result_inner_tuples)\n\n```\n```python\n# tests/test_index_multiplication.py\n\n\"\"\"\nUnit tests for the index_multiplication function, verifying acceptance criteria and error behaviors.\nThis module ensures the function adheres to its specified functional requirements and error handling.\n\"\"\"\n\nimport pytest\nfrom src.index_multiplication import index_multiplication\n\ndef test_example_case():\n    \"\"\"Verifies the function's output for a specified valid example case.\"\"\"\n    a = ((1, 3), (4, 5), (2, 9), (1, 10))\n    b = ((6, 7), (3, 9), (1, 1), (7, 3))\n    expected = ((6, 21), (12, 45), (2, 9), (7, 30))\n    assert index_multiplication(a, b) == expected\n\ndef test_top_level_length_mismatch():\n    \"\"\"Asserts that a ValueError is raised for unequal top-level tuple lengths.\"\"\"\n    a = ((1, 2),)\n    b = ((3, 4), (5, 6))\n    with pytest.raises(ValueError, match=\"Top-level tuples must have the same number of inner tuples.\"):\n        index_multiplication(a, b)\n\ndef test_inner_length_mismatch():\n    \"\"\"Asserts that a ValueError is raised when corresponding inner tuples have different lengths.\"\"\"\n    a = ((1, 2), (3,))\n    b = ((4, 5), (6, 7))\n    with pytest.raises(ValueError, match=\"Inner tuples at index 1 have different lengths.\"):\n        index_multiplication(a, b)\n\ndef test_non_numeric_element():\n    \"\"\"Asserts that a TypeError is raised for non-numeric elements within inner tuples.\"\"\"\n    a = ((1, 2), ('a', 3))\n    b = ((4, 5), (6, 7))\n    with pytest.raises(TypeError, match=\"All elements must be numeric \\\\(int or float\\\\), found: str.\"):\n        index_multiplication(a, b)\n    \n    a_float_str = ((1.0, 2), ('b', 3))\n    b_float_str = ((4, 5.0), (6, 7))\n    with pytest.raises(TypeError, match=\"All elements must be numeric \\\\(int or float\\\\), found: str.\"):\n        index_multiplication(a_float_str, b_float_str)\n\ndef test_purity():\n    \"\"\"Verifies that the input tuples remain unchanged after the function call.\"\"\"\n    original_a = ((1, 2), (3, 4))\n    original_b = ((5, 6), (7, 8))\n    \n    # Create deep copies of the inputs to compare against later\n    # Tuples are immutable, so a shallow copy for the top-level is sufficient for comparing identity\n    # and content of the original references.\n    a_copy = tuple(inner_tuple[:] for inner_tuple in original_a)\n    b_copy = tuple(inner_tuple[:] for inner_tuple in original_b)\n\n    index_multiplication(original_a, original_b)\n\n    assert original_a == a_copy, \"Input 'a' should not be modified.\"\n    assert original_b == b_copy, \"Input 'b' should not be modified.\"\n\ndef test_empty_tuples():\n    \"\"\"Verifies behavior with empty top-level or inner tuples.\"\"\"\n    assert index_multiplication((), ()) == ()\n    assert index_multiplication(((),), ((),)) == ((),)\n\ndef test_mixed_numeric_types():\n    \"\"\"Tests with a mix of integer and float types.\"\"\"\n    a = ((1, 2.0), (3.5, 4))\n    b = ((5.0, 6), (7, 8.5))\n    expected = ((5.0, 12.0), (24.5, 34.0))\n    assert index_multiplication(a, b) == expected\n\n```"}
{"task_id": "Mbpp/446", "solution": "```python\n# occurrence_counter_project/src/__init__.py\n__all__ = ['count_Occurrence', 'OccurrenceCounter']\n\n# occurrence_counter_project/src/occurrence_counter.py\nfrom dataclasses import dataclass\n\n\"\"\"Implementation module for the occurrence counter library.\nProvides functions and dataclasses for counting matching elements.\n\"\"\"\n\n@dataclass(frozen=True)\nclass TupleInput:\n    \"\"\"Conceptual read-only wrapper for tuple input.\"\"\"\n    elements: tuple\n\n@dataclass(frozen=True)\nclass ListInput:\n    \"\"\"Conceptual read-only wrapper for list input.\"\"\"\n    elements: list\n\n@dataclass(frozen=True)\nclass CountResult:\n    \"\"\"Encapsulates the integer count result.\"\"\"\n    value: int\n\ndef count_Occurrence(input_tuple: tuple, input_list: list) -> int:\n    \"\"\"Counts occurrences of list elements in a tuple.\n    Returns the total count of matches.\n    \"\"\"\n    count = 0\n    for t_elem in input_tuple:\n        for l_elem in input_list:\n            if t_elem == l_elem:\n                count += 1\n    return count\n\nclass OccurrenceCounter:\n    \"\"\"Thin, stateless facade for counting occurrences.\"\"\"\n    @staticmethod\n    def count_Occurrence(input_tuple: tuple, input_list: list) -> int:\n        \"\"\"Facade for counting occurrences, delegating to the module-level function.\"\"\"\n        return count_Occurrence(input_tuple, input_list)\n\n# occurrence_counter_project/tests/test_occurrence_counter.py\nimport unittest\nfrom src.occurrence_counter import count_Occurrence, OccurrenceCounter\n\n\"\"\"Unit tests for the occurrence_counter module.\nVerifies core functionality and edge cases.\n\"\"\"\n\nclass TestOccurrenceCounter(unittest.TestCase):\n    def test_assert_provided_case(self):\n        \"\"\"Verifies the required assertion case from the design specification.\"\"\"\n        self.assertEqual(count_Occurrence(('a', 'a', 'c', 'b', 'd'), ['a', 'b']), 3)\n        self.assertEqual(OccurrenceCounter.count_Occurrence(('a', 'a', 'c', 'b', 'd'), ['a', 'b']), 3)\n\n    def test_empty_tuple(self):\n        \"\"\"Tests the function with an empty input tuple.\"\"\"\n        self.assertEqual(count_Occurrence((), ['a', 'b']), 0)\n\n    def test_empty_list(self):\n        \"\"\"Tests the function with an empty input list.\"\"\"\n        self.assertEqual(count_Occurrence(('a', 'b'), []), 0)\n\n    def test_no_matches(self):\n        \"\"\"Tests the scenario where no elements match.\"\"\"\n        self.assertEqual(count_Occurrence(('x', 'y', 'z'), ['a', 'b']), 0)\n\n    def test_all_matches(self):\n        \"\"\"Tests the scenario where all tuple elements match.\"\"\"\n        self.assertEqual(count_Occurrence(('a', 'a', 'a'), ['a']), 3)\n\n    def test_mixed_types(self):\n        \"\"\"Tests with mixed types and numbers.\"\"\"\n        self.assertEqual(count_Occurrence((1, 'a', 2, 'b'), [1, 'b']), 2)\n\n    def test_unhashable_objects(self):\n        \"\"\"Verifies correct comparison with unhashable objects.\"\"\"\n        class Unhashable:\n            def __init__(self, value):\n                self.value = value\n            def __eq__(self, other):\n                return isinstance(other, Unhashable) and self.value == other.value\n\n        t_input = (Unhashable('a'), Unhashable('b'), Unhashable('a'))\n        l_input = [Unhashable('a')]\n        self.assertEqual(count_Occurrence(t_input, l_input), 2)\n\n    def test_boolean_comparison(self):\n        \"\"\"Tests boolean and integer equality.\"\"\"\n        self.assertEqual(count_Occurrence((0, 1, False, True), [0, True]), 4)\n\n\nif __name__ == '__main__':\n    unittest.main()\n```"}
