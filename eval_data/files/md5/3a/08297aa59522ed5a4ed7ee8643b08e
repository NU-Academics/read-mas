{"task_id": "Mbpp/806", "solution": "```python\ndef max_run_uppercase(input: str) -> int:\n    \"\"\"Calculates the length of the longest contiguous run of ASCII uppercase letters (A-Z).\n    Returns 0 if the input string is empty or contains no uppercase letters.\n    \"\"\"\n    longest_run = 0\n    current_run = 0\n    for char in input:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            if current_run > longest_run:\n                longest_run = current_run\n        else:\n            current_run = 0\n    return longest_run\n```"}
{"task_id": "Mbpp/806", "solution": "```python\nclass InputString:\n    \"\"\"Represents the input string for analysis.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass RunResult:\n    \"\"\"Holds the computed maximum uppercase-run length.\"\"\"\n    def __init__(self, max_length: int):\n        self.max_length = max_length\n\nclass UppercaseRunAnalyzer:\n    \"\"\"Encapsulates the algorithm to find the longest uppercase run.\"\"\"\n    def _is_upper(self, c: str) -> bool:\n        \"\"\"Returns True if character is an ASCII uppercase letter.\"\"\"\n        return len(c) == 1 and 'A' <= c <= 'Z'\n\n    def max_run_uppercase(self, s: str) -> int:\n        \"\"\"Scans string 's' to find the longest run of ASCII uppercase letters.\"\"\"\n        max_run = 0\n        current_run = 0\n        \n        for char in s:\n            if self._is_upper(char):\n                current_run += 1\n            else:\n                max_run = max(max_run, current_run)\n                current_run = 0\n        \n        # After loop, check if the last run was the longest\n        max_run = max(max_run, current_run)\n        \n        return max_run\n\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Public API to find the length of the longest consecutive run of ASCII uppercase letters.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    analyzer = UppercaseRunAnalyzer()\n    return analyzer.max_run_uppercase(s)\n```"}
{"task_id": "Mbpp/807", "solution": "```python\n# src/first_odd.py\nfrom typing import Optional\n\ndef first_odd(numbers: list) -> Optional[int]:\n    \"\"\"Return the first odd integer from numbers, scanning left-to-right, or None if none found.\n    Raises TypeError if input is not a list.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for element in numbers:\n        # Check if the element is an integer and is odd.\n        if isinstance(element, int) and element % 2 != 0:\n            return element\n            \n    return None\n\n```\n```python\n# tests/test_first_odd.py\nfrom src.first_odd import first_odd\n\ndef test_first_odd_basic():\n    \"\"\"Verify the basic case and the required assertion.\"\"\"\n    assert first_odd([1,3,5]) == 1\n\ndef test_first_odd_later_odd():\n    \"\"\"Verify finding an odd number later in the list.\"\"\"\n    assert first_odd([2,4,6,7,8]) == 7\n\ndef test_first_odd_no_odd():\n    \"\"\"Verify returning None when no odd numbers are found.\"\"\"\n    assert first_odd([2,4,6]) is None\n    assert first_odd([]) is None\n    assert first_odd([2.5, 4.0, 6.7]) is None\n    assert first_odd([2, 4.5, 6, 8.0, 10]) is None\n\ndef test_first_odd_negative_odd():\n    \"\"\"Verify handling negative odd numbers.\"\"\"\n    assert first_odd([-1, 0, 1]) == -1\n    assert first_odd([0, -3, -2]) == -3\n\ndef test_first_odd_type_error():\n    \"\"\"Verify that a TypeError is raised for non-list inputs.\"\"\"\n    try:\n        first_odd(\"not a list\")\n        raise AssertionError(\"TypeError not raised for string input.\")\n    except TypeError:\n        pass\n    \n    try:\n        first_odd(123)\n        raise AssertionError(\"TypeError not raised for integer input.\")\n    except TypeError:\n        pass\n\n    try:\n        first_odd(None)\n        raise AssertionError(\"TypeError not raised for None input.\")\n    except TypeError:\n        pass\n\ndef test_first_odd_no_mutation():\n    \"\"\"Verify the input list is not modified in-place.\"\"\"\n    original_list = [1, 2, 3]\n    list_copy = list(original_list)\n    first_odd(original_list)\n    assert original_list == list_copy, \"Input list was modified in-place.\"\n\nif __name__ == \"__main__\":\n    print(\"Running tests...\")\n    \n    try:\n        test_first_odd_basic()\n        test_first_odd_later_odd()\n        test_first_odd_no_odd()\n        test_first_odd_negative_odd()\n        test_first_odd_type_error()\n        test_first_odd_no_mutation()\n        print(\"All tests passed.\")\n    except AssertionError as e:\n        print(f\"Test failed: {e}\")\n    except Exception as e:\n        print(f\"An unexpected error occurred during testing: {e}\")\n\n```"}
