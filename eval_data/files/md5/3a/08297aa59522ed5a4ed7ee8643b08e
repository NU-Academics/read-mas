{"task_id": "Mbpp/615", "solution": "```python\n# src/__init__.py\nfrom .average_tuple import average_tuple\n\n\n# src/tuple_of_tuples.py\nclass TupleOfTuples:\n    def __init__(self, tuples: tuple) -> None:\n        \"\"\"Initializes the TupleOfTuples wrapper.\"\"\"\n        self._tuples = tuples\n\n    def get_length(self) -> int:\n        \"\"\"Returns the number of inner tuples.\"\"\"\n        return len(self._tuples)\n\n    def get_inner_length(self) -> int:\n        \"\"\"Returns the length of the first inner tuple, assuming uniformity.\"\"\"\n        if not self._tuples:\n            return 0\n        return len(self._tuples[0])\n\n\n# src/validator.py\nclass Validator:\n    def validate_structure(self, input_value) -> None:\n        \"\"\"Validates the overall structure of the input as a tuple of tuples.\"\"\"\n        if not isinstance(input_value, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        if not input_value:\n            raise ValueError(\"Input tuple cannot be empty.\")\n        \n        inner_length = None\n        for i, inner_tuple in enumerate(input_value):\n            if not isinstance(inner_tuple, tuple):\n                raise TypeError(f\"Element at index {i} must be a tuple, got {type(inner_tuple).__name__}.\")\n            if not inner_tuple:\n                raise ValueError(f\"Inner tuple at index {i} cannot be empty.\")\n            \n            if inner_length is None:\n                inner_length = len(inner_tuple)\n            elif len(inner_tuple) != inner_length:\n                raise ValueError(\"All inner tuples must have the same length.\")\n\n    def validate_numeric_values(self, input_value) -> None:\n        \"\"\"Validates that all elements within inner tuples are numeric (int or float).\"\"\"\n        for i, inner_tuple in enumerate(input_value):\n            for j, element in enumerate(inner_tuple):\n                if not isinstance(element, (int, float)):\n                    raise TypeError(\n                        f\"Element at position [{i}][{j}] must be numeric (int or float), \"\n                        f\"got {type(element).__name__}.\"\n                    )\n\n\n# src/position_aggregator.py\nclass PositionAggregator:\n    def __init__(self, inner_length: int) -> None:\n        \"\"\"Initializes the aggregator with a list for sums and a count.\"\"\"\n        self._sums: list[float] = [0.0] * inner_length\n        self._count: int = 0\n\n    def aggregate(self, input_value: tuple) -> None:\n        \"\"\"Aggregates sums for each position and increments the count.\"\"\"\n        self._count += 1\n        for i, element in enumerate(input_value):\n            self._sums[i] += float(element)\n\n    def sums(self) -> list[float]:\n        \"\"\"Returns the accumulated sums for each position.\"\"\"\n        return self._sums\n\n    def count(self) -> int:\n        \"\"\"Returns the count of aggregated inner tuples.\"\"\"\n        return self._count\n\n\n# src/average_calculator.py\nclass AverageCalculator:\n    def compute_averages(self, sums: list[float], count: int) -> list[float]:\n        \"\"\"Computes per-position averages using floating-point division.\"\"\"\n        if count == 0:\n            return [0.0] * len(sums) # Should be prevented by Validator's non-empty check.\n        return [s / count for s in sums]\n\n\n# src/average_result.py\nclass AverageResult:\n    def __init__(self, averages: list[float]) -> None:\n        \"\"\"Initializes the result container with the computed averages.\"\"\"\n        self._averages = averages\n\n    def to_list(self) -> list[float]:\n        \"\"\"Returns the computed averages as a list.\"\"\"\n        return list(self._averages)\n\n\n# src/average_tuple.py\nfrom .tuple_of_tuples import TupleOfTuples\nfrom .validator import Validator\nfrom .position_aggregator import PositionAggregator\nfrom .average_calculator import AverageCalculator\nfrom .average_result import AverageResult\n\ndef average_tuple(input_tuple_of_tuples) -> list:\n    \"\"\"\n    Computes per-position arithmetic means for a tuple of tuples.\n    Orchestrates validation, aggregation, calculation, and result packaging.\n    \"\"\"\n    validator = Validator()\n    validator.validate_structure(input_tuple_of_tuples)\n    validator.validate_numeric_values(input_tuple_of_tuples)\n\n    wrapped_input = TupleOfTuples(input_tuple_of_tuples)\n    inner_length = wrapped_input.get_inner_length()\n\n    aggregator = PositionAggregator(inner_length)\n    for inner_tuple in input_tuple_of_tuples:\n        aggregator.aggregate(inner_tuple)\n\n    calculator = AverageCalculator()\n    averages = calculator.compute_averages(aggregator.sums(), aggregator.count())\n\n    result = AverageResult(averages)\n    return result.to_list()\n```"}
{"task_id": "Mbpp/615", "solution": "```python\n#!/usr/bin/env python3\nfrom typing import Tuple, List, Any\n\ndef average_tuple(input: Tuple[Tuple[Any, ...], ...]) -> List[float]:\n    \"\"\"\n    Computes the arithmetic mean for each inner tuple within a top-level tuple of tuples.\n    Validates input type and shape, raising TypeError or ValueError for violations.\n    \"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"Top-level input must be a tuple.\")\n\n    averages = []\n    for inner_tuple in input:\n        if not isinstance(inner_tuple, tuple):\n            raise TypeError(\"All inner elements must be tuples.\")\n        if not inner_tuple:\n            raise ValueError(\"All inner tuples must be non-empty.\")\n\n        current_sum = 0.0\n        for item in inner_tuple:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All inner tuple elements must be numeric (int or float).\")\n            current_sum += item\n        averages.append(current_sum / len(inner_tuple))\n\n    return averages\n```\n```python\nimport pytest\nfrom src.average_tuple import average_tuple\n\ndef test_example():\n    \"\"\"Verify correctness with the provided example input.\"\"\"\n    input_data = ((10, 10, 10, 12), (30, 45, 56, 45), (81, 80, 39, 32), (1, 2, 3, 4))\n    expected_output = [10.5, 44.0, 58.0, 2.5]\n    # Re-calculate expected output based on the provided input:\n    # (10+10+10+12)/4 = 42/4 = 10.5\n    # (30+45+56+45)/4 = 176/4 = 44.0\n    # (81+80+39+32)/4 = 232/4 = 58.0\n    # (1+2+3+4)/4 = 10/4 = 2.5\n    assert average_tuple(input_data) == expected_output\n\ndef test_non_tuple_top_level():\n    \"\"\"Assert TypeError for non-tuple top-level input.\"\"\"\n    with pytest.raises(TypeError, match=\"Top-level input must be a tuple.\"):\n        average_tuple([(1, 2), (3, 4)])  # list instead of tuple\n\ndef test_non_tuple_inner_element():\n    \"\"\"Assert TypeError when an inner element is not a tuple.\"\"\"\n    with pytest.raises(TypeError, match=\"All inner elements must be tuples.\"):\n        average_tuple(((1, 2), [3, 4]))  # list as inner element\n\ndef test_non_numeric_element():\n    \"\"\"Assert TypeError when an inner value is non-numeric.\"\"\"\n    with pytest.raises(TypeError, match=\"All inner tuple elements must be numeric\"):\n        average_tuple(((1, 2), (3, \"a\")))  # string as inner value\n\ndef test_empty_inner_tuple():\n    \"\"\"Assert ValueError with message containing 'empty inner tuple'.\"\"\"\n    with pytest.raises(ValueError, match=\"empty inner tuple\"):\n        average_tuple(((1, 2), ()))  # empty inner tuple\n\ndef test_input_not_mutated():\n    \"\"\"Verify input remains unchanged after function invocation.\"\"\"\n    original_input = ((10, 20), (30, 40))\n    # Create a copy for comparison, although tuples are immutable.\n    # This primarily checks that the reference or contents are not altered.\n    input_copy = original_input \n    \n    _ = average_tuple(original_input)\n    \n    assert original_input == input_copy\n    assert id(original_input) == id(input_copy) # Verify it's still the exact same object\n```"}
{"task_id": "Mbpp/618", "solution": "```python\nfrom typing import List, Union\n\ndef _parse_inputs(a: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Returns the input list as is, assuming it's an ordered numeric sequence.\"\"\"\n    return a\n\ndef _verify_length(a: List[Union[int, float]], b: List[Union[int, float]]) -> int:\n    \"\"\"Verifies that lists a and b have equal lengths, raising ValueError if not.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input lists must have equal lengths.\")\n    return len(a)\n\ndef _compute_divisions(a: List[Union[int, float]], b: List[Union[int, float]]) -> List[float]:\n    \"\"\"Computes element-wise division of corresponding elements from lists a and b.\"\"\"\n    return [float(a[i] / b[i]) for i in range(len(a))]\n\ndef _assemble_result(values: List[float]) -> List[float]:\n    \"\"\"Assembles the computed values into the final result list, preserving order.\"\"\"\n    return values\n\ndef div_list(a: List[Union[int, float]], b: List[Union[int, float]]) -> List[float]:\n    \"\"\"\n    Performs element-wise division of two numeric lists.\n    Accepts two ordered lists of numbers and returns a list of floats.\n    \"\"\"\n    parsed_a = _parse_inputs(a)\n    parsed_b = _parse_inputs(b)\n    _verify_length(parsed_a, parsed_b)\n    values = _compute_divisions(parsed_a, parsed_b)\n    return _assemble_result(values)\n```"}
{"task_id": "Mbpp/616", "solution": "```python\nclass InvalidTypeError(Exception):\n    \"\"\"Raised when input types are invalid (non-tuple or non-integer elements).\"\"\"\n    pass\n\nclass LengthMismatchError(Exception):\n    \"\"\"Raised when input tuples have different lengths.\"\"\"\n    pass\n\nclass DivisionByZeroError(Exception):\n    \"\"\"Raised when a divisor in the right tuple is zero.\"\"\"\n    pass\n\ndef _validate_inputs_are_tuples(left, right) -> None:\n    \"\"\"Ensures both inputs are tuples. Raises InvalidTypeError if not.\"\"\"\n    if not isinstance(left, tuple) or not isinstance(right, tuple):\n        raise InvalidTypeError(\"Both 'left' and 'right' inputs must be tuples.\")\n\ndef _validate_elements_are_integers(left, right) -> None:\n    \"\"\"Ensures all elements in both tuples are integers. Raises InvalidTypeError if not.\"\"\"\n    for val in left:\n        if not isinstance(val, int):\n            raise InvalidTypeError(\"All elements in 'left' tuple must be integers.\")\n    for val in right:\n        if not isinstance(val, int):\n            raise InvalidTypeError(\"All elements in 'right' tuple must be integers.\")\n\ndef _validate_lengths_equal(left, right) -> None:\n    \"\"\"Ensures input tuples have the same length. Raises LengthMismatchError if not.\"\"\"\n    if len(left) != len(right):\n        raise LengthMismatchError(\"Input tuples 'left' and 'right' must have the same length.\")\n\ndef _validate_no_zero_divisors(right) -> None:\n    \"\"\"Ensures no element in the divisor tuple 'right' is zero. Raises DivisionByZeroError if a zero is found.\"\"\"\n    for val in right:\n        if val == 0:\n            raise DivisionByZeroError(\"Divisor tuple 'right' cannot contain zero.\")\n\ndef _compute_elementwise_modulo(left, right) -> tuple:\n    \"\"\"Computes element-wise modulo, assuming all validations have passed.\"\"\"\n    return tuple(l % r for l, r in zip(left, right))\n\ndef tuple_modulo(left: tuple, right: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples, validating inputs in order.\n    Returns a new tuple with the results.\n    \"\"\"\n    _validate_inputs_are_tuples(left, right)\n    _validate_elements_are_integers(left, right)\n    _validate_lengths_equal(left, right)\n    _validate_no_zero_divisors(right)\n    return _compute_elementwise_modulo(left, right)\n\n__all__ = ['tuple_modulo', 'InvalidTypeError', 'LengthMismatchError', 'DivisionByZeroError']\n```"}
