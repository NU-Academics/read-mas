{"task_id": "Mbpp/286", "solution": "import math\n\nclass ArrayInput:\n    \"\"\"Represents the input triple (arr, n, k).\"\"\"\n    def __init__(self, elements: list[int], n: int, k: int) -> None:\n        self.elements = elements\n        self.n = n\n        self.k = k\n\n    def getLength(self) -> int:\n        \"\"\"Returns the length of the elements list.\"\"\"\n        return len(self.elements)\n\nclass SubarraySumResult:\n    \"\"\"Wraps the integer computation result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates arr, n, and k according to business rules.\"\"\"\n    def validateTypes(self, array_input: ArrayInput) -> bool:\n        # Per CRITICAL REQUIREMENTS, avoid isinstance checks and type guards.\n        # Assume types are correct for elements, n, k based on design specification.\n        return True\n\n    def validateNMatchesArr(self, array_input: ArrayInput) -> bool:\n        \"\"\"Validates if n matches the length of arr.\"\"\"\n        if array_input.n != array_input.getLength():\n            raise ValueError(f\"n ({array_input.n}) must equal len(arr) ({array_input.getLength()}).\")\n        return True\n\n    def validateK(self, array_input: ArrayInput) -> bool:\n        \"\"\"Validates if k is an integer >= 1.\"\"\"\n        if array_input.k < 1:\n            raise ValueError(f\"k ({array_input.k}) must be an integer greater than or equal to 1.\")\n        return True\n\n    def validateArrNotEmpty(self, array_input: ArrayInput) -> bool:\n        \"\"\"Validates if arr is a non-empty list.\"\"\"\n        if not array_input.elements:\n            raise ValueError(\"arr must be a non-empty list of integers.\")\n        return True\n\n    def validateAll(self, array_input: ArrayInput) -> None:\n        \"\"\"Performs all input validations, raising ValueError on failure.\"\"\"\n        self.validateTypes(array_input)\n        self.validateNMatchesArr(array_input)\n        self.validateK(array_input)\n        self.validateArrNotEmpty(array_input)\n\nclass RepeatedArray:\n    \"\"\"Constructs a physically repeated array when k is small.\"\"\"\n    def __init__(self, elements: list[int], k: int) -> None:\n        self.elements = elements\n        self.k = k\n\n    def construct(self) -> list[int]:\n        \"\"\"Returns the elements list repeated k times.\"\"\"\n        return self.elements * self.k\n\nclass Algorithm:\n    \"\"\"Computes max contiguous subarray sums and optimized repeated-array computation.\"\"\"\n    def computeMaxSubarray(self, arr: list[int]) -> int:\n        \"\"\"Implements Kadane's algorithm, handling all-negative arrays.\"\"\"\n        # Validation ensures arr is non-empty.\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n    def computeOptimized(self, arr: list[int], k: int) -> int:\n        \"\"\"Optimized logic for repeated arrays for large k.\"\"\"\n        total_sum = sum(arr)\n        \n        # Calculate max subarray sum for two concatenated arrays to handle wrapping once.\n        max_sum_double_arr = self.computeMaxSubarray(arr + arr)\n\n        if total_sum < 0:\n            # If the total sum of the array is negative, adding more full arrays won't help.\n            # The maximum subarray will be contained within at most two concatenations.\n            return max_sum_double_arr\n        else:\n            # If total sum is non-negative, the max sum can involve full repetitions.\n            # (k-2) accounts for the 'middle' full array copies.\n            return max_sum_double_arr + (k - 2) * total_sum\n\nclass FunctionCall:\n    \"\"\"Orchestrates validation, optional construction, and computation.\"\"\"\n    def __init__(self, name: str) -> None:\n        self.name = name\n\n    def invoke(self, arr: list[int], n: int, k: int) -> SubarraySumResult:\n        \"\"\"Invokes the max subarray sum computation with validation and path selection.\"\"\"\n        array_input = ArrayInput(elements=arr, n=n, k=k)\n        validator = Validator()\n        validator.validateAll(array_input)\n\n        algorithm = Algorithm()\n\n        # Implementation-chosen threshold for 'small k'\n        SMALL_K_THRESHOLD = 2 \n        # k=1 and k=2 are handled by physical concatenation path.\n        # k >= 3 are handled by optimized path.\n\n        if array_input.k <= SMALL_K_THRESHOLD:\n            repeated_array_builder = RepeatedArray(array_input.elements, array_input.k)\n            full_arr = repeated_array_builder.construct()\n            result_value = algorithm.computeMaxSubarray(full_arr)\n        else:\n            result_value = algorithm.computeOptimized(array_input.elements, array_input.k)\n        \n        return SubarraySumResult(result_value)\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array \n    which is formed by repeating the given array k times.\n    \"\"\"\n    function_caller = FunctionCall(\"max_sub_array_sum_repeated\")\n    result = function_caller.invoke(arr, n, k)\n    return result.value"}
{"task_id": "Mbpp/290", "solution": "```python\ndef max_length(list_of_lists):\n    \"\"\"Finds the maximum length sublist in list_of_lists, returning its length and the first encountered longest sublist.\n    Initializes with length 0 and None, handling empty inputs naturally.\n    \"\"\"\n    max_len = 0\n    max_list = None\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = sublist\n    return (max_len, max_list)\n```"}
