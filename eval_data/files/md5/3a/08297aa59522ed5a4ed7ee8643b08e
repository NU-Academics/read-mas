{"task_id": "Mbpp/619", "solution": "```python\n# src/move_num.py\n\nclass Character:\n    \"\"\"Represents a single character with its value and position.\"\"\"\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n\n    def is_digit(self) -> bool:\n        \"\"\"Checks if the character's value is a digit ('0'-'9').\"\"\"\n        return '0' <= self.value <= '9'\n\n\nclass DigitCollector:\n    \"\"\"Collects digit characters in their encountered order.\"\"\"\n    def __init__(self):\n        self.digits: list[str] = []\n\n    def collect(self, c: Character) -> None:\n        \"\"\"Appends the character's value if it is a digit.\"\"\"\n        if c.is_digit():\n            self.digits.append(c.value)\n\n    def joined(self) -> str:\n        \"\"\"Returns all collected digit characters as a single string.\"\"\"\n        return ''.join(self.digits)\n\n\nclass NonDigitCollector:\n    \"\"\"Collects non-digit characters in their encountered order.\"\"\"\n    def __init__(self):\n        self.non_digits: list[str] = []\n\n    def collect(self, c: Character) -> None:\n        \"\"\"Appends the character's value if it is not a digit.\"\"\"\n        if not c.is_digit():\n            self.non_digits.append(c.value)\n\n    def joined(self) -> str:\n        \"\"\"Returns all collected non-digit characters as a single string.\"\"\"\n        return ''.join(self.non_digits)\n\n\ndef move_num(input_str: str) -> str:\n    \"\"\"\n    Moves all non-digit characters to the beginning and digit characters to the end\n    of the input string, preserving their relative order.\n    \"\"\"\n    non_digit_collector = NonDigitCollector()\n    digit_collector = DigitCollector()\n\n    for i, char_value in enumerate(input_str):\n        char_obj = Character(char_value, i)\n        non_digit_collector.collect(char_obj)\n        digit_collector.collect(char_obj)\n\n    return non_digit_collector.joined() + digit_collector.joined()\n\n\nif __name__ == '__main__':\n    # Example usage from the design specification.\n    example_input = 'I1love143you55three3000thousand'\n    result = move_num(example_input)\n    print(result) # Expected: 'Iloveyouthreethousand1143553000'\n\n```\n```python\n# tests/test_move_num.py\n\nfrom src.move_num import move_num\n\ndef test_move_num_example():\n    \"\"\"Verifies the function output matches the provided example (FR-4).\"\"\"\n    input_str = 'I1love143you55three3000thousand'\n    expected_output = 'Iloveyouthreethousand1143553000'\n    assert move_num(input_str) == expected_output\n\ndef test_move_num_preserves_non_digit_order():\n    \"\"\"Ensures non-digit characters maintain their relative order (FR-2).\"\"\"\n    input_str = 'a1B2c3D'\n    expected_output = 'aBcD123'\n    assert move_num(input_str) == expected_output\n\ndef test_move_num_preserves_digit_order():\n    \"\"\"Ensures digit characters maintain their relative order (FR-3).\"\"\"\n    input_str = 'X8Y4Z2'\n    expected_output = 'XYZ842'\n    assert move_num(input_str) == expected_output\n\ndef test_move_num_no_digits():\n    \"\"\"Tests with an input string containing no digits.\"\"\"\n    input_str = 'HelloWorld'\n    expected_output = 'HelloWorld'\n    assert move_num(input_str) == expected_output\n\ndef test_move_num_all_digits():\n    \"\"\"Tests with an input string containing only digits.\"\"\"\n    input_str = '12345'\n    expected_output = '12345'\n    assert move_num(input_str) == expected_output\n\ndef test_move_num_empty_string():\n    \"\"\"Tests with an empty input string.\"\"\"\n    input_str = ''\n    expected_output = ''\n    assert move_num(input_str) == expected_output\n```"}
{"task_id": "Mbpp/619", "solution": "```python\ndef move_num(input: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving relative order.\n    Non-digit characters appear first, followed by digit characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)\n```"}
{"task_id": "Mbpp/622", "solution": "```python\n# src/median/__init__.py\n\"\"\"Package initializer for median library.\"\"\"\n\nfrom .api import get_median\n\n__all__ = [\"get_median\"]\n\n# src/median/models.py\nfrom typing import List, Union\n\nNumber = Union[int, float]\n\nclass InputList:\n    \"\"\"Data model for an input list with elements and size.\"\"\"\n    def __init__(self, elements: List[Number]):\n        self.elements = elements\n        self.size = len(elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if elements are in non-decreasing order.\"\"\"\n        for i in range(self.size - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\n\nclass MedianResult:\n    \"\"\"Data model for the computed median value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n# src/median/validation.py\nfrom typing import Union\nfrom .models import InputList\n\nNumber = Union[int, float]\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str, code: str = None):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass ValidationService:\n    \"\"\"Service for validating input lists and parameters.\"\"\"\n\n    def validate_lengths(self, list1: InputList, list2: InputList, n: int) -> None:\n        \"\"\"Ensures n is int and len(list1) == len(list2) == n.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Parameter 'n' must be an integer.\", \"N_TYPE_ERROR\")\n        if list1.size != n or list2.size != n:\n            raise ValidationError(\n                f\"List lengths ({list1.size}, {list2.size}) must both be equal to n ({n}).\",\n                \"LEN_MISMATCH\"\n            )\n\n    def validate_sorted(self, lst: InputList) -> None:\n        \"\"\"Ensures lst.is_sorted() is True.\"\"\"\n        if not lst.is_sorted():\n            raise ValidationError(\"Input list is not sorted in non-decreasing order.\", \"UNSORTED\")\n\n# src/median/median_calculator.py\nfrom typing import List, Union\n\nNumber = Union[int, float]\n\nclass MedianCalculator:\n    \"\"\"Calculates the median of two sorted lists of equal size.\"\"\"\n\n    def get_median(self, list1: List[Number], list2: List[Number], n: int) -> float:\n        \"\"\"Computes the median as average of the n-th and (n+1)-th smallest elements.\"\"\"\n        # For an even number of elements (2n), the median is the average of the two middle elements.\n        # If elements are 1-indexed, these are the n-th and (n+1)-th smallest elements.\n        k1_element = self._select_kth(list1, list2, n)\n        k2_element = self._select_kth(list1, list2, n + 1)\n        return float((k1_element + k2_element) / 2)\n\n    def _select_kth(self, a: List[Number], b: List[Number], k: int) -> Number:\n        \"\"\"Returns the k-th smallest element (1-based) across two sorted lists.\"\"\"\n        m, n = len(a), len(b)\n\n        # Ensure a is the shorter list for simpler logic in binary search range.\n        if m > n:\n            return self._select_kth(b, a, k)\n\n        # Binary search for 'i', the number of elements taken from 'a'.\n        # 'j' (elements from 'b') will be k - i.\n        low, high = max(0, k - n), min(k, m)\n\n        while low <= high:\n            i = (low + high) // 2  # Number of elements taken from 'a'.\n            j = k - i              # Number of elements taken from 'b'.\n\n            # Define boundary elements for comparison.\n            # Use negative/positive infinity as sentinels for boundary conditions.\n            A_left = a[i - 1] if i > 0 else float('-inf')\n            B_left = b[j - 1] if j > 0 else float('-inf')\n            A_right = a[i] if i < m else float('inf')\n            B_right = b[j] if j < n else float('inf')\n\n            if A_left <= B_right and B_left <= A_right:\n                # Correct partition found. k-th element is max of the two left elements.\n                return max(A_left, B_left)\n            elif A_left > B_right:\n                # 'i' is too large; too many elements from 'a'. Move 'high' pointer left.\n                high = i - 1\n            else: # B_left > A_right\n                # 'i' is too small; too many elements from 'b'. Move 'low' pointer right.\n                low = i + 1\n        \n        # This point should theoretically not be reached if k is always valid (1 <= k <= m + n).\n        return 0 # Default return to satisfy type checker, though unreachable.\n\n# src/median/api.py\nfrom typing import List, Union\nfrom .models import InputList, MedianResult\nfrom .validation import ValidationService, ValidationError\nfrom .median_calculator import MedianCalculator\n\nNumber = Union[int, float]\n\ndef get_median(list1: List[Number], list2: List[Number], n: int) -> float:\n    \"\"\"Public API function to compute the median of two sorted lists.\n    It orchestrates input validation and median computation.\n    \"\"\"\n    \n    # Instantiate services\n    validation_service = ValidationService()\n    median_calculator = MedianCalculator()\n\n    # Wrap inputs in data models for validation\n    input_list1 = InputList(list1)\n    input_list2 = InputList(list2)\n\n    # Perform validation as per design\n    validation_service.validate_lengths(input_list1, input_list2, n)\n    validation_service.validate_sorted(input_list1)\n    validation_service.validate_sorted(input_list2)\n\n    # Compute median using the calculator\n    median_value = median_calculator.get_median(list1, list2, n)\n\n    # Wrap result in MedianResult and return its value\n    median_result = MedianResult(median_value)\n    return median_result.value\n```"}
{"task_id": "Mbpp/620", "solution": "from typing import List, Dict, Optional\n\nclass Number:\n    \"\"\"Represents a numeric element with a value and a unique ID.\"\"\"\n    def __init__(self, value: int, id: int):\n        self.value = value\n        self.id = id\n\nclass InputList:\n    \"\"\"Wraps a list of integers into Number instances with unique IDs.\"\"\"\n    def __init__(self, values: List[int]):\n        self.numbers: List[Number] = [Number(value, i) for i, value in enumerate(values)]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input list.\"\"\"\n        return len(self.numbers)\n\nclass DivisibleSubset:\n    \"\"\"Represents a candidate subset of numbers and provides its size.\"\"\"\n    def __init__(self, members: Optional[List[Number]] = None):\n        self.members: List[Number] = members if members is not None else []\n\n    def size(self) -> int:\n        \"\"\"Returns the number of members in the subset.\"\"\"\n        return len(self.members)\n\nclass DivisibilityGraph:\n    \"\"\"Builds an adjacency graph for pairwise divisibility and finds the largest subset.\"\"\"\n    def __init__(self, input_list: InputList):\n        self.input_list = input_list\n        self.adjacency: Dict[int, List[int]] = {num.id: [] for num in input_list.numbers}\n        self._max_clique_members: List[Number] = []\n\n    def _are_divisible(self, a: int, b: int) -> bool:\n        \"\"\"Checks if two numbers are divisible by each other, handling zero values.\"\"\"\n        if a == 0 and b == 0:\n            return True\n        if a == 0:\n            return True\n        if b == 0:\n            return True\n        return a % b == 0 or b % a == 0\n\n    def build_graph(self) -> None:\n        \"\"\"Constructs the adjacency graph based on pairwise divisibility for all pairs.\"\"\"\n        numbers = self.input_list.numbers\n        n = len(numbers)\n        for i in range(n):\n            for j in range(i + 1, n): # Iterate over unique pairs (i < j).\n                num_i = numbers[i]\n                num_j = numbers[j]\n                if self._are_divisible(num_i.value, num_j.value):\n                    self.adjacency[num_i.id].append(num_j.id)\n                    self.adjacency[num_j.id].append(num_i.id)\n\n    def find_largest_subset(self) -> DivisibleSubset:\n        \"\"\"Finds the largest pairwise-divisible subset (maximum clique) using backtracking.\"\"\"\n        self._max_clique_members = []\n        nodes_by_id = {num.id: num for num in self.input_list.numbers}\n        all_node_ids = sorted(nodes_by_id.keys()) # Ensures deterministic iteration order.\n\n        def _backtrack_max_clique(current_clique_ids: List[int], candidate_start_index: int) -> None:\n            \"\"\"Recursive backtracking function to find the maximum clique.\"\"\"\n            if len(current_clique_ids) > len(self._max_clique_members):\n                self._max_clique_members = [nodes_by_id[node_id] for node_id in current_clique_ids]\n\n            # Pruning: if remaining candidates cannot form a larger clique, stop exploring this path.\n            if len(current_clique_ids) + (len(all_node_ids) - candidate_start_index) <= len(self._max_clique_members):\n                return\n\n            for i in range(candidate_start_index, len(all_node_ids)):\n                candidate_id = all_node_ids[i]\n                \n                # Check if candidate_id is connected to all nodes already in current_clique_ids.\n                is_connectable = True\n                for existing_node_id in current_clique_ids:\n                    if candidate_id not in self.adjacency[existing_node_id]:\n                        is_connectable = False\n                        break\n                \n                if is_connectable:\n                    current_clique_ids.append(candidate_id)\n                    _backtrack_max_clique(current_clique_ids, i + 1) # Recurse with candidate_id added.\n                    current_clique_ids.pop() # Backtrack: remove candidate_id.\n\n        _backtrack_max_clique([], 0) # Start with an empty clique and consider all nodes.\n\n        return DivisibleSubset(self._max_clique_members)\n\ndef largest_subset(input_values: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    Handles empty input and uses a graph-based maximum clique algorithm.\n    \"\"\"\n    if not input_values:\n        return 0\n\n    input_list_obj = InputList(input_values)\n    graph = DivisibilityGraph(input_list_obj)\n    graph.build_graph()\n    subset = graph.find_largest_subset()\n    return subset.size()"}
{"task_id": "Mbpp/623", "solution": "```python\n# src/errors.py\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures in the nth_nums system.\"\"\"\n    def __init__(self, message: str, type: str):\n        \"\"\"Initializes ValidationError with a message and type.\"\"\"\n        self.message = message\n        self.type = type\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        \"\"\"Returns the string representation of the error.\"\"\"\n        return f\"{self.type}: {self.message}\"\n\n```\n```python\n# src/nth_nums.py\n\nfrom typing import List, Union\nfrom errors import ValidationError\n\nNumber = Union[int, float]\n\ndef _validate_inputs(numbers: List[Number], n: int) -> None:\n    \"\"\"Validates that n is an integer and all list elements are numeric.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\n            message=f\"Exponent 'n' must be an integer, but got {type(n).__name__}.\",\n            type=\"InvalidNType\"\n        )\n\n    for i, item in enumerate(numbers):\n        if not isinstance(item, (int, float)):\n            raise ValidationError(\n                message=f\"Element at index {i} must be numeric, but got {type(item).__name__}.\",\n                type=\"InvalidElementType\"\n            )\n\ndef _compute_power(item: Number, n: int) -> Number:\n    \"\"\"Computes the power of an item raised to n.\"\"\"\n    return item ** n\n\ndef nth_nums(numbers: List[Number], n: int) -> List[Number]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Raises ValidationError for invalid inputs.\n    \"\"\"\n    _validate_inputs(numbers, n)\n\n    if not numbers:\n        return []\n\n    return [_compute_power(item, n) for item in numbers]\n\n```\n```python\n# tests/test_nth_nums.py\n\nimport pytest\nfrom src.nth_nums import nth_nums\nfrom src.errors import ValidationError\n\ndef test_example_case():\n    \"\"\"Verifies the example case from the requirements (FR6).\"\"\"\n    input_list = list(range(1, 11))\n    expected_output = [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]\n    assert nth_nums(input_list, 2) == expected_output\n\ndef test_empty_list():\n    \"\"\"Verifies handling of an empty input list (FR4).\"\"\"\n    assert nth_nums([], 5) == []\n    assert nth_nums([], 0) == []\n\ndef test_invalid_element_type():\n    \"\"\"Verifies ValidationError for non-numeric elements (FR5).\"\"\"\n    with pytest.raises(ValidationError) as exc_info:\n        nth_nums([1, \"a\", 3], 2)\n    assert exc_info.value.type == \"InvalidElementType\"\n    assert \"numeric\" in exc_info.value.message\n\n    with pytest.raises(ValidationError) as exc_info:\n        nth_nums([1, 2, None], 3)\n    assert exc_info.value.type == \"InvalidElementType\"\n    assert \"numeric\" in exc_info.value.message\n\ndef test_invalid_n_type():\n    \"\"\"Verifies ValidationError for non-integer n (FR5).\"\"\"\n    with pytest.raises(ValidationError) as exc_info:\n        nth_nums([1, 2, 3], 2.5)\n    assert exc_info.value.type == \"InvalidNType\"\n    assert \"integer\" in exc_info.value.message\n\n    with pytest.raises(ValidationError) as exc_info:\n        nth_nums([1, 2, 3], \"2\")\n    assert exc_info.value.type == \"InvalidNType\"\n    assert \"integer\" in exc_info.value.message\n\ndef test_order_preserved():\n    \"\"\"Verifies that the order of elements is preserved and computation is correct (FR3).\"\"\"\n    input_list = [10, -2, 0, 5.5]\n    n = 3\n    expected_output = [10**3, (-2)**3, 0**3, 5.5**3]\n    assert nth_nums(input_list, n) == expected_output\n\n    input_list = [1, 2, 3]\n    n = 0\n    expected_output = [1, 1, 1] # x**0 is 1 for non-zero x, and 0**0 is 1 in Python\n    assert nth_nums(input_list, n) == expected_output\n\ndef test_various_numeric_types():\n    \"\"\"Tests with mixed int and float types and different n values.\"\"\"\n    input_list = [1, 2.0, -3, 0.5, 0]\n    n = 2\n    expected_output = [1**2, 2.0**2, (-3)**2, 0.5**2, 0**2]\n    assert nth_nums(input_list, n) == expected_output\n\n    n = -1 # Test with negative exponent\n    input_list = [2, 4.0]\n    expected_output = [2**-1, 4.0**-1]\n    assert nth_nums(input_list, n) == expected_output\n\n```"}
{"task_id": "Mbpp/620", "solution": "```python\nfrom typing import List, Set, Dict, Tuple\n\n# src/models.py\nclass Number:\n    \"\"\"\n    Represents an integer value.\n    Provides equality and hash methods for use in collections.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\n    def __repr__(self) -> str:\n        return f\"Number({self.value})\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self) -> int:\n        return hash(self.value)\n\n\nclass IntegerList:\n    \"\"\"\n    A container for a list of integers.\n    Used for domain modeling of the input.\n    \"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers: List[int] = list(numbers)\n\n\nclass Subset:\n    \"\"\"\n    Represents a subset of numbers.\n    Maintains elements and provides its size.\n    \"\"\"\n    def __init__(self, elements: List[Number]) -> None:\n        self.elements: List[Number] = sorted(elements, key=lambda n: n.value)\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the subset.\"\"\"\n        return len(self.elements)\n\n\n# src/divisibility.py\nclass DivisibilityRelation:\n    \"\"\"\n    Encapsulates guarded divisibility logic.\n    Checks if one number is divisible by another, handling zero safely.\n    \"\"\"\n    def isDivisible(self, a: int, b: int) -> bool:\n        \"\"\"\n        Returns True if a is divisible by b or b is divisible by a, with zero guards.\n        Follows the rule: (b != 0 and a % b == 0) or (a != 0 and b % a == 0).\n        \"\"\"\n        cond1 = False\n        if b != 0:\n            cond1 = (a % b == 0)\n        \n        cond2 = False\n        if a != 0:\n            cond2 = (b % a == 0)\n            \n        return cond1 or cond2\n\n\n# src/validator.py\nclass Validator:\n    \"\"\"\n    Handles input validation and normalization.\n    (Critical requirements prohibit actual validation checks and exceptions.)\n    \"\"\"\n    def validate(self, numbers: List[int]) -> List[int]:\n        \"\"\"\n        Validates the input list of numbers.\n        Returns a shallow copy of the list, omitting actual validation due to constraints.\n        \"\"\"\n        return list(numbers)\n\n\n# src/largest_subset_service.py\nclass LargestSubsetService:\n    \"\"\"\n    Orchestrates the process of finding the largest divisible subset.\n    It integrates validation, divisibility checks, and the clique-finding algorithm.\n    \"\"\"\n    def __init__(self) -> None:\n        self.validator = Validator()\n        self.relation = DivisibilityRelation()\n        self.max_clique_size = 0\n\n    def largest_subset(self, numbers: List[int]) -> int:\n        \"\"\"\n        Computes the size of the largest subset where every pair of integers is divisible.\n        Validates input, constructs a divisibility graph, and applies Bron-Kerbosch.\n        \"\"\"\n        validated_numbers = self.validator.validate(numbers)\n\n        if not validated_numbers:\n            return 0\n\n        # Create unique numbers for graph construction. Duplicates are handled by graph size.\n        unique_numbers = sorted(list(set(validated_numbers)))\n        \n        # Numbers equal to zero cannot form pairs with other numbers or themselves\n        # according to the `isDivisible` logic (isDivisible(X,0)=False, isDivisible(0,0)=False).\n        # Thus, if 0 is present, it can only form a subset of size 1 by itself.\n        # Filter out 0s for graph construction; handle the size 1 case separately.\n        numbers_for_graph = [num for num in unique_numbers if num != 0]\n\n        # If only zeros were in the original list, or no numbers remain after filtering zeros.\n        if not numbers_for_graph:\n            if 0 in unique_numbers: # Original list contained only zeros, e.g., [0,0,0] -> unique={0}\n                return 1 # A subset of a single 0 is a valid (vacuously divisible) subset of size 1.\n            return 0 # No numbers at all, or only numbers that were filtered (e.g., empty initial list).\n\n        # Build an adjacency list for the graph where nodes are indices of numbers_for_graph\n        n = len(numbers_for_graph)\n        adj: Dict[int, Set[int]] = {i: set() for i in range(n)}\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                val_i = numbers_for_graph[i]\n                val_j = numbers_for_graph[j]\n                if self.relation.isDivisible(val_i, val_j):\n                    adj[i].add(j)\n                    adj[j].add(i)\n        \n        # Initialize max_clique_size: A single element always forms a valid subset.\n        self.max_clique_size = 1 if n > 0 else 0\n\n        # Bron-Kerbosch algorithm (P = candidates, X = excluded)\n        # R = current clique (initially empty)\n        initial_P = set(range(n))\n        self._bron_kerbosch(set(), initial_P, set(), adj)\n        \n        return self.max_clique_size\n\n    def _bron_kerbosch(self, R: Set[int], P: Set[int], X: Set[int], adj: Dict[int, Set[int]]) -> None:\n        \"\"\"\n        Bron-Kerbosch algorithm with pivot for finding maximal cliques.\n        Updates self.max_clique_size with the largest clique found.\n        \"\"\"\n        # Base case: if P and X are both empty, R is a maximal clique.\n        if not P and not X:\n            if len(R) > self.max_clique_size:\n                self.max_clique_size = len(R)\n            return\n        \n        # Deterministic pivot selection: Choose `u` from `P union X` that maximizes `|P intersect N(u)|`.\n        # If multiple candidates, pick the smallest node index for determinism.\n        pivot_candidates = sorted(list(P.union(X)))\n        u_pivot = -1\n        max_intersection_size = -1\n\n        for candidate_node in pivot_candidates:\n            current_intersection_size = len(P.intersection(adj.get(candidate_node, set())))\n            if current_intersection_size > max_intersection_size:\n                max_intersection_size = current_intersection_size\n                u_pivot = candidate_node\n        \n        # Iterate over P_prime = P \\ N(u_pivot)\n        # Sort to ensure deterministic iteration order.\n        P_prime_nodes = sorted(list(P.difference(adj.get(u_pivot, set()))))\n\n        for v in P_prime_nodes:\n            # Recursive call with updated R, P, X sets\n            self._bron_kerbosch(R.union({v}), P.intersection(adj.get(v, set())), X.intersection(adj.get(v, set())), adj)\n            \n            # Remove v from P and add to X for the next iteration in the current level\n            P.remove(v)\n            X.add(v)\n\n\n# API-level function (facade for LargestSubsetService)\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    This function serves as the public API entry point.\n    \"\"\"\n    service = LargestSubsetService()\n    return service.largest_subset(numbers)\n```"}
{"task_id": "Mbpp/622", "solution": "```python\n# src/median.py\n\nfrom typing import List, Union\n\nclass ListInput:\n    \"\"\"\n    Represents input list metadata used for validation and computation.\n    Contains the list elements and its size.\n    \"\"\"\n    def __init__(self, elements: List[Union[int, float]], size: int) -> None:\n        self.elements = elements\n        self.size = size\n\nclass Validator:\n    \"\"\"\n    Validates preconditions for input lists: length equality and sortedness.\n    Methods are stateless and perform checks on provided lists.\n    \"\"\"\n    def validateLength(self, list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> bool:\n        \"\"\"Checks if both lists have length n, and n is at least 1.\"\"\"\n        return n >= 1 and len(list1) == n and len(list2) == n\n\n    def validateSorted(self, l: List[Union[int, float]]) -> bool:\n        \"\"\"Checks if the list is sorted in non-decreasing order.\"\"\"\n        for i in range(len(l) - 1):\n            if l[i] > l[i+1]:\n                return False\n        return True\n\nclass MedianCalculator:\n    \"\"\"\n    Computes the median of two sorted lists of equal size n.\n    The median is the average of the n-th and (n+1)-th smallest elements.\n    \"\"\"\n    def computeMedian(self, list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> float:\n        \"\"\"\n        Combines and sorts the two lists, then calculates the median.\n        The median is derived from the n-th and (n+1)-th elements of the combined sorted list.\n        \"\"\"\n        combined_list = sorted(list1 + list2)\n        # Median for 2n elements is the average of elements at indices n-1 and n (0-indexed)\n        median = (combined_list[n - 1] + combined_list[n]) / 2.0\n        return median\n\nclass ErrorHandler:\n    \"\"\"\n    Signals invalid input conditions by raising ValueError.\n    This provides a consistent way to report errors.\n    \"\"\"\n    def raiseInvalidInput(self, errorMsg: str) -> None:\n        \"\"\"Raises a ValueError with the specified error message.\"\"\"\n        raise ValueError(errorMsg)\n\ndef get_median(list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of equal size n.\n    It validates inputs, and if valid, delegates median computation.\n    \"\"\"\n    validator = Validator()\n    error_handler = ErrorHandler()\n    median_calculator = MedianCalculator()\n\n    if not validator.validateLength(list1, list2, n):\n        error_handler.raiseInvalidInput(\"Input lists must have length n, and n must be at least 1.\")\n\n    if not validator.validateSorted(list1):\n        error_handler.raiseInvalidInput(\"First list is not sorted in non-decreasing order.\")\n\n    if not validator.validateSorted(list2):\n        error_handler.raiseInvalidInput(\"Second list is not sorted in non-decreasing order.\")\n\n    return median_calculator.computeMedian(list1, list2, n)\n```\n```python\n# tests/test_get_median.py\n\nfrom src.median import get_median\nimport pytest\n\ndef test_example_case():\n    \"\"\"\n    Tests the get_median function with the example from the SRS.\n    Verifies that the correct median value is returned.\n    \"\"\"\n    assert get_median([1, 12, 15, 26, 38], [2, 13, 17, 30, 45], 5) == 16.0\n\ndef test_n_less_than_1():\n    \"\"\"Tests if ValueError is raised when n is less than 1.\"\"\"\n    with pytest.raises(ValueError, match=\"n must be at least 1\"):\n        get_median([], [], 0)\n\ndef test_length_mismatch():\n    \"\"\"Tests if ValueError is raised when list lengths do not match n.\"\"\"\n    with pytest.raises(ValueError, match=\"length mismatch\"):\n        get_median([1], [], 1)\n    with pytest.raises(ValueError, match=\"length mismatch\"):\n        get_median([1, 2], [3], 2)\n\ndef test_first_list_unsorted():\n    \"\"\"Tests if ValueError is raised when the first list is unsorted.\"\"\"\n    with pytest.raises(ValueError, match=\"First list is not sorted\"):\n        get_median([1, 3, 2], [4, 5, 6], 3)\n\ndef test_second_list_unsorted():\n    \"\"\"Tests if ValueError is raised when the second list is unsorted.\"\"\"\n    with pytest.raises(ValueError, match=\"Second list is not sorted\"):\n        get_median([1, 2, 3], [6, 5, 4], 3)\n\ndef test_single_element_lists():\n    \"\"\"Tests with single-element lists.\"\"\"\n    assert get_median([10], [20], 1) == 15.0\n\ndef test_even_number_elements():\n    \"\"\"Tests with lists that result in an even number of combined elements.\"\"\"\n    assert get_median([1, 5], [2, 6], 2) == 3.5 # Combined: [1,2,5,6], n=2 -> (2+5)/2\n\ndef test_float_elements():\n    \"\"\"Tests with lists containing float elements.\"\"\"\n    assert get_median([1.0, 12.5], [2.0, 13.5], 2) == 7.25 # Combined: [1.0, 2.0, 12.5, 13.5], n=2 -> (2.0+12.5)/2\n\ndef test_mixed_int_float_elements():\n    \"\"\"Tests with lists containing mixed integer and float elements.\"\"\"\n    assert get_median([1, 12.0], [2.0, 13], 2) == 7.0 # Combined: [1, 2.0, 12.0, 13], n=2 -> (2.0+12.0)/2\n\ndef test_duplicate_elements():\n    \"\"\"Tests with lists containing duplicate elements.\"\"\"\n    assert get_median([1, 1, 5], [2, 2, 6], 3) == 2.0 # Combined: [1,1,2,2,5,6], n=3 -> (2+2)/2\n```"}
{"task_id": "Mbpp/623", "solution": "```python\nfrom typing import List, Union\n\ndef nth_nums(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Computes the n-th power of each number in the input list.\n    Returns a new list with the results, preserving order and length.\n    \"\"\"\n    output_list = []\n    for number in numbers:\n        output_list.append(number ** n)\n    return output_list\n```"}
