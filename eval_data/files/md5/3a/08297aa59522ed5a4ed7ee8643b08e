{"task_id": "Mbpp/598", "solution": "```python\nfrom typing import List\n\nclass Digit:\n    \"\"\"A simple data holder for a digit's position and value.\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position\n        self.value = value\n\nclass Number:\n    \"\"\"Encapsulates an integer value and provides its digits and digit count.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        if value == 0:\n            self.digit_count = 1\n        else:\n            self.digit_count = len(str(abs(value)))\n        self._digits_cache = None\n\n    def digits(self) -> List[int]:\n        \"\"\"Extracts and returns a list of base-10 digits from the number.\"\"\"\n        if self._digits_cache is not None:\n            return self._digits_cache\n\n        if self.value == 0:\n            self._digits_cache = [0]\n            return self._digits_cache\n\n        temp_value = abs(self.value)\n        extracted_digits = []\n        while temp_value > 0:\n            extracted_digits.append(temp_value % 10)\n            temp_value //= 10\n        extracted_digits.reverse()\n        self._digits_cache = extracted_digits\n        return self._digits_cache\n\nclass ArmstrongChecker:\n    \"\"\"Stateless utility to perform Armstrong number calculations.\"\"\"\n\n    @staticmethod\n    def armstrong_number(n: int) -> bool:\n        \"\"\"Determines if an integer is an Armstrong number.\"\"\"\n        _number_obj = Number(n)\n\n        digit_count = ArmstrongChecker.count_digits(n)\n        digits = ArmstrongChecker.extract_digits(n)\n        power_sum = ArmstrongChecker.compute_power_sum(digits, digit_count)\n        return power_sum == n\n\n    @staticmethod\n    def count_digits(n: int) -> int:\n        \"\"\"Counts the number of base-10 digits in an integer.\"\"\"\n        if n == 0:\n            return 1\n        return len(str(abs(n)))\n\n    @staticmethod\n    def extract_digits(n: int) -> List[int]:\n        \"\"\"Extracts a list of base-10 digits from an integer.\"\"\"\n        if n == 0:\n            return [0]\n        \n        temp_value = abs(n)\n        extracted_digits = []\n        while temp_value > 0:\n            extracted_digits.append(temp_value % 10)\n            temp_value //= 10\n        extracted_digits.reverse()\n        return extracted_digits\n\n    @staticmethod\n    def compute_power_sum(digits: List[int], power: int) -> int:\n        \"\"\"Computes the sum of each digit raised to the given power.\"\"\"\n        return sum(d ** power for d in digits)\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Public API: Determines if an integer is an Armstrong number.\"\"\"\n    return ArmstrongChecker.armstrong_number(n)\n```"}
{"task_id": "Mbpp/597", "solution": "```python\n# src/element.py\nfrom typing import Any\n\nclass Element:\n    \"\"\"A lightweight holder for a comparable value.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def __repr__(self) -> str:\n        \"\"\"Returns the string representation of the element's value.\"\"\"\n        return f\"Element({self.value!r})\"\n\n```\n```python\n# src/sorted_array.py\nfrom typing import List, Any, Optional\n\nclass SortedArray:\n    \"\"\"A read-only wrapper around a Python list, providing sortedness checks.\"\"\"\n    def __init__(self, elements: Optional[List[Any]] = None):\n        self._elements: List[Any] = list(elements) if elements is not None else []\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def get(self, i: int) -> Any:\n        \"\"\"Retrieves the element at the given 0-based index.\"\"\"\n        if not (0 <= i < self.length()):\n            raise IndexError(\"Index out of bounds for SortedArray.\")\n        return self._elements[i]\n\n    def is_sorted_non_decreasing(self) -> bool:\n        \"\"\"Checks if the array elements are sorted in non-decreasing order.\"\"\"\n        for i in range(1, self.length()):\n            if self._elements[i] < self._elements[i-1]:\n                return False\n        return True\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns a shallow copy of the internal list.\"\"\"\n        return list(self._elements)\n\n```\n```python\n# src/input_validator.py\nfrom .sorted_array import SortedArray\n\nclass InputValidator:\n    \"\"\"Stateless validation for sorted arrays and k bounds.\"\"\"\n\n    @staticmethod\n    def validate_sorted(arr: SortedArray) -> bool:\n        \"\"\"Checks if a SortedArray instance is sorted non-decreasingly.\"\"\"\n        return arr.is_sorted_non_decreasing()\n\n    @staticmethod\n    def validate_k(k: int, total: int) -> None:\n        \"\"\"Validates if k is within the valid range [1, total_length].\"\"\"\n        if not (1 <= k <= total):\n            raise IndexError(f\"k must be between 1 and {total} (inclusive), but got {k}.\")\n\n    @staticmethod\n    def validate_all(A: SortedArray, B: SortedArray, k: int) -> None:\n        \"\"\"Performs all input validations for arrays A, B, and index k.\"\"\"\n        if not InputValidator.validate_sorted(A):\n            raise ValueError(\"Input array A is not sorted non-decreasingly.\")\n        if not InputValidator.validate_sorted(B):\n            raise ValueError(\"Input array B is not sorted non-decreasingly.\")\n\n        total_length = A.length() + B.length()\n        InputValidator.validate_k(k, total_length)\n\n```\n```python\n# src/merger_engine.py\nfrom typing import Any, Optional\nfrom .sorted_array import SortedArray\n\nclass MergerEngine:\n    \"\"\"Traverses two SortedArray instances, yielding the next smallest element.\"\"\"\n    def __init__(self, A: SortedArray, B: SortedArray):\n        self._A = A\n        self._B = B\n        self._i = 0  # Pointer for array A\n        self._j = 0  # Pointer for array B\n        self._len_a = A.length()\n        self._len_b = B.length()\n\n    def peek_a(self) -> Optional[Any]:\n        \"\"\"Returns the current element in array A without advancing, or None if A is exhausted.\"\"\"\n        if self._i < self._len_a:\n            return self._A.get(self._i)\n        return None\n\n    def peek_b(self) -> Optional[Any]:\n        \"\"\"Returns the current element in array B without advancing, or None if B is exhausted.\"\"\"\n        if self._j < self._len_b:\n            return self._B.get(self._j)\n        return None\n\n    def advance_a(self) -> None:\n        \"\"\"Advances the pointer for array A.\"\"\"\n        self._i += 1\n\n    def advance_b(self) -> None:\n        \"\"\"Advances the pointer for array B.\"\"\"\n        self._j += 1\n\n    def next(self) -> Any:\n        \"\"\"Returns the next smallest element from the merged sequence.\"\"\"\n        val_a = self.peek_a()\n        val_b = self.peek_b()\n\n        if val_a is None and val_b is None:\n            raise IndexError(\"Both arrays are exhausted, no next element.\")\n        elif val_a is None:\n            self.advance_b()\n            return val_b\n        elif val_b is None:\n            self.advance_a()\n            return val_a\n        else:\n            if val_a <= val_b:\n                self.advance_a()\n                return val_a\n            else:\n                self.advance_b()\n                return val_b\n\n```\n```python\n# src/findkth_function.py\nfrom typing import Any, List, Union\nfrom .sorted_array import SortedArray\nfrom .input_validator import InputValidator\nfrom .merger_engine import MergerEngine\n\ndef find_kth(A: Union[SortedArray, List[Any]], B: Union[SortedArray, List[Any]], k: int) -> Any:\n    \"\"\"\n    Finds the kth smallest element (1-based) from the multiset union of two sorted arrays.\n    Validates inputs, merges elements, and returns the kth element's value.\n    \"\"\"\n    # Wrap raw lists into SortedArray instances\n    a_wrapped = A if isinstance(A, SortedArray) else SortedArray(A)\n    b_wrapped = B if isinstance(B, SortedArray) else SortedArray(B)\n\n    # Validate inputs as per design\n    InputValidator.validate_all(a_wrapped, b_wrapped, k)\n\n    # Initialize the merger engine\n    engine = MergerEngine(a_wrapped, b_wrapped)\n\n    # Traverse k times to find the kth element\n    result_value = None\n    for _ in range(k):\n        result_value = engine.next()\n    \n    return result_value\n\n```"}
{"task_id": "Mbpp/597", "solution": "```python\nfrom typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Domain-specific exception indicating validation failure.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass SortedArray:\n    \"\"\"Read-only wrapper over an input integer sequence.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the array is empty.\"\"\"\n        return self.length() == 0\n\nclass KthRequest:\n    \"\"\"Encapsulates k and performs 1-based range validation.\"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n\n    def validate(self, total_length: int) -> None:\n        \"\"\"Validates k against the total length, raising ValidationError if out of bounds.\"\"\"\n        if not (1 <= self.k <= total_length):\n            raise ValidationError(f\"k must be between 1 and {total_length}, but got {self.k}.\")\n\nclass Result:\n    \"\"\"Simple container for returned value and status.\"\"\"\n    def __init__(self, value: int, status: str = 'ok') -> None:\n        self.value = value\n        self.status = status\n\nclass Finder:\n    \"\"\"Computes the k-th smallest element from two SortedArray instances.\"\"\"\n    def find_kth(self, arr1: SortedArray, arr2: SortedArray, k: int) -> int:\n        \"\"\"Delegates actual computation to an internal method, handling empty arrays as special cases.\"\"\"\n        if arr1.isEmpty():\n            return arr2.elements[k - 1]\n        if arr2.isEmpty():\n            return arr1.elements[k - 1]\n        \n        return self._mergePrefixOrPartition(arr1, arr2, k)\n\n    def _mergePrefixOrPartition(self, arr1: SortedArray, arr2: SortedArray, k: int) -> int:\n        \"\"\"Implements the O(k) prefix-merge approach to find the k-th smallest element.\"\"\"\n        p1 = 0\n        p2 = 0\n        current_kth = 0\n        \n        for _ in range(k):\n            if p1 >= arr1.length():\n                current_kth = arr2.elements[p2]\n                p2 += 1\n            elif p2 >= arr2.length():\n                current_kth = arr1.elements[p1]\n                p1 += 1\n            elif arr1.elements[p1] <= arr2.elements[p2]:\n                current_kth = arr1.elements[p1]\n                p1 += 1\n            else:\n                current_kth = arr2.elements[p2]\n                p2 += 1\n        return current_kth\n\ndef find_kth(arr1: List[int], arr2: List[int], k: int) -> int:\n    \"\"\"Finds the k-th smallest element from the multiset union of two sorted arrays.\"\"\"\n    sa1 = SortedArray(arr1)\n    sa2 = SortedArray(arr2)\n\n    total_length = sa1.length() + sa2.length()\n    \n    k_req = KthRequest(k)\n    k_req.validate(total_length)\n\n    finder = Finder()\n    return finder.find_kth(sa1, sa2, k)\n```"}
{"task_id": "Mbpp/598", "solution": "```python\n# src/models.py\nfrom typing import Optional\n\nclass Number:\n    \"\"\"Represents an integer value to be evaluated.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass TestCase:\n    \"\"\"Encapsulates test execution and result recording.\"\"\"\n    def __init__(self, input: int, expected: bool):\n        self.input: int = input\n        self.expected: bool = expected\n        self.passed: bool = False\n\n    def run(self) -> bool:\n        \"\"\"Invoke armstrong_number and set self.passed accordingly.\"\"\"\n        # Deferred import to avoid circular import\n        from src.armstrong_checker import armstrong_number\n        result: bool = armstrong_number(self.input)\n        self.passed = (result == self.expected)\n        return self.passed\n\n# src/armstrong_checker.py\nfrom typing import List\n\nclass ArmstrongChecker:\n    \"\"\"Implements the algorithmic logic for Armstrong numbers.\"\"\"\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"Return True if n is an Armstrong number per BR1..BR5.\"\"\"\n        sum_val = self.sum_of_powers(n)\n        return sum_val == n\n\n    def digit_count(self, n: int) -> int:\n        \"\"\"Return number of digits in base-10 representation of abs(n) per BR4.\"\"\"\n        return len(str(abs(n)))\n\n    def sum_of_powers(self, n: int) -> int:\n        \"\"\"Return sum of digits each raised to power digit_count(n) per BR5.\"\"\"\n        count = self.digit_count(n)\n        sum_val = 0\n        temp_n = abs(n)\n        while temp_n > 0:\n            digit = temp_n % 10\n            sum_val += digit ** count\n            temp_n //= 10\n        return sum_val\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Public API to determine Armstrong-number status (FR1).\"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)\n\n# src/__init__.py\nfrom .armstrong_checker import armstrong_number\n\n# tests/test_armstrong.py\ndef test_assert_armstrong_153():\n    \"\"\"Verify that armstrong_number(153) returns True (FR3).\"\"\"\n    from src.armstrong_checker import armstrong_number\n    assert armstrong_number(153) == True\n```"}
