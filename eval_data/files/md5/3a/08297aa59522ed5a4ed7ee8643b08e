Error if the values do not match.\n        \"\"\"\n        if actual != expected:\n            raise AssertionError(f\"Test '{self.name}' FAILED: Expected {expected}, Got {actual}\")\n        print(f\"Test '{self.name}' PASSED: {actual} == {expected}\")\n\n    def run(self, func, args: tuple, expected) -> None:\n        \"\"\"\n        Executes a given function with arguments and asserts its return value.\n        \"\"\"\n        print(f\"Running: {func.__name__}{args} -> Expecting {expected}\")\n        result = func(*args)\n        self.assert_equal(result, expected)\n\n```\n```python\n# src/run_test_harness.py\n\"\"\"\nScript entry point to run the acceptance test.\n\"\"\"\nfrom src.rectangle_service import rectangle_area\nfrom src.test_case import TestCase\n\ndef main() -> int:\n    \"\"\"\n    Executes the main acceptance test for rectangle_area function.\n    Prints the result and returns an appropriate exit code.\n    \"\"\"\n    tc = TestCase(name='FR3 acceptance')\n    try:\n        tc.run(rectangle_area, (10, 20), 200)\n        print('Acceptance Test Result: PASS')\n        return 0\n    except AssertionError:\n        print('Acceptance Test Result: FAIL')\n        return 1\n\nif __name__ == '__main__':\n    exit_code = main()\n    exit(exit_code)\n\n```\n```python\n# src/__init__.py\n\"\"\"\nPackage marker and convenience re-exports for modules.\n\"\"\"\nfrom src.rectangle import Rectangle\nfrom src.rectangle_service import RectangleService, rectangle_area\nfrom src.test_case import TestCase\nimport src.run_test_harness as run_test_harness\n\n__all__ = [\n    \"Rectangle\",\n    \"RectangleService\",\n    \"rectangle_area\",\n    \"TestCase\",\n    \"run_test_harness\",\n]\n\n```\n```python\n# tests/test_rectangle_area.py\n\"\"\"\nUnit test that verifies acceptance test assert rectangle_area(10,20) == 200.\n\"\"\"\nfrom src.rectangle_service import rectangle_area\n\ndef test_rectangle_area_acceptance() -> None:\n    \"\"\"\n    Verifies the core rectangle