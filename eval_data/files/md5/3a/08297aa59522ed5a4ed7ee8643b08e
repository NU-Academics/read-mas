{"task_id": "Mbpp/572", "solution": "from typing import List, Dict, Any\n\ndef _build_frequency_map(input_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"\n    Builds a frequency map for elements in the input list.\n    Returns a dictionary mapping each element to its occurrence count.\n    \"\"\"\n    frequency_map: Dict[Any, int] = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n    return frequency_map\n\ndef two_unique_nums(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Returns a new list containing numbers that occur exactly once in the input, preserving original relative order.\n    The input list is not modified.\n    \"\"\"\n    frequency_map = _build_frequency_map(input_list)\n    output_list: List[Any] = []\n    for item in input_list:\n        if frequency_map[item] == 1:\n            output_list.append(item)\n    return output_list"}
{"task_id": "Mbpp/572", "solution": "```python\nclass NumberOccurrence:\n    \"\"\"A simple container for tracking number occurrences.\"\"\"\n    def __init__(self, value: int, count: int, first_index: int):\n        self.value = value\n        self.count = count\n        self.firstIndex = first_index\n\nclass ResultList:\n    \"\"\"A simple container for the result list.\"\"\"\n    def __init__(self):\n        self.items = []\n\n    def append(self, item: int) -> None:\n        self.items.append(item)\n\ndef validate_inputs(lists) -> None:\n    \"\"\"\n    Validates input arguments.\n    Note: Validation logic is omitted due to critical requirements.\n    \"\"\"\n    pass # Critical requirements forbid isinstance checks and raising exceptions.\n\ndef two_unique_nums(*lists) -> list:\n    \"\"\"\n    Finds numbers that appear exactly once across all input lists, preserving first occurrence order.\n    Does not modify input lists.\n    \"\"\"\n    validate_inputs(lists)\n\n    occurrences = {}\n    global_index = 0\n\n    # Traverse all input lists as a single concatenated sequence\n    for sublist in lists:\n        for item in sublist:\n            if item not in occurrences:\n                occurrences[item] = NumberOccurrence(item, 1, global_index)\n            else:\n                occurrences[item].count += 1\n            global_index += 1\n\n    # Filter for unique numbers and sort by their first occurrence index\n    unique_items_info = []\n    for num_occurrence in occurrences.values():\n        if num_occurrence.count == 1:\n            unique_items_info.append(num_occurrence)\n    \n    # Sort these unique items based on their first global index\n    unique_items_info.sort(key=lambda x: x.firstIndex)\n\n    # Assemble the final result list\n    result_list_obj = ResultList()\n    for item_info in unique_items_info:\n        result_list_obj.append(item_info.value)\n    \n    return result_list_obj.items\n```"}
{"task_id": "Mbpp/573", "solution": "```python\n# src/unique_product.py\nfrom typing import List, Set, Union\n\nNumber = Union[int, float]\n\ndef validate_input(values) -> None:\n    \"\"\"Validates that the input is a list of numbers.\n    Raises ValueError if the input is not a list or contains non-numeric items.\"\"\"\n    if not isinstance(values, list):\n        raise ValueError(\"Input must be a list.\")\n    for item in values:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"All elements in the list must be numbers (int or float).\")\n\ndef extract_unique(values) -> Set[Number]:\n    \"\"\"Extracts unique numeric values from the list.\n    Uses Python's set semantics for uniqueness.\"\"\"\n    return set(values)\n\ndef compute_product(values: Set[Number]) -> Number:\n    \"\"\"Computes the product of unique numeric values.\n    Returns 1 if the set of values is empty (multiplicative identity).\"\"\"\n    if not values:\n        return 1\n    product: Number = 1\n    for num in values:\n        product *= num\n    return product\n\ndef unique_product(values: List[Number]) -> Number:\n    \"\"\"Computes the product of unique numeric values in a list.\n    Orchestrates input validation, unique extraction, and product computation.\"\"\"\n    validate_input(values)\n    unique_values = extract_unique(values)\n    result = compute_product(unique_values)\n    return result\n```\n```python\n# tests/test_unique_product.py\nfrom src.unique_product import unique_product\n\ndef run_example_test() -> None:\n    \"\"\"Runs the example acceptance test for unique_product.\n    Asserts the product of unique values from the SRS example.\"\"\"\n    test_values = [10, 20, 30, 40, 20, 50, 60, 40]\n    expected_product = 720000000\n    actual_product = unique_product(test_values)\n    assert actual_product == expected_product, f\"Test failed! Expected {expected_product}, got {actual_product}\"\n    print(f\"Example test passed: unique_product({test_values}) == {actual_product}\")\n\ndef main() -> None:\n    \"\"\"Main entry point for the test script.\n    Executes the example test.\"\"\"\n    run_example_test()\n\nif __name__ == \"__main__\":\n    main()\n```"}
{"task_id": "Mbpp/573", "solution": "class InputList:\n    \"\"\"Encapsulates caller-supplied list, storing a shallow copy.\"\"\"\n    def __init__(self, values: list) -> None:\n        self.values: list = list(values)\n\nclass NumericValue:\n    \"\"\"Represents an input element and provides normalization.\"\"\"\n    def __init__(self, raw_value) -> None:\n        self.raw_value = raw_value\n        self.normalized_value: float = self.normalize()\n\n    def normalize(self) -> float:\n        \"\"\"Converts the raw value to a canonical float key.\"\"\"\n        return float(self.raw_value)\n\nclass UniqueValueSet:\n    \"\"\"Maintains a set of normalized numeric values.\"\"\"\n    def __init__(self) -> None:\n        self.values: set[float] = set()\n\n    def add(self, nv: NumericValue) -> None:\n        \"\"\"Adds a normalized numeric value to the set.\"\"\"\n        self.values.add(nv.normalized_value)\n\n    def contains(self, nv: NumericValue) -> bool:\n        \"\"\"Checks if a normalized numeric value is in the set.\"\"\"\n        return nv.normalized_value in self.values\n\n    def __iter__(self) -> 'Iterator[float]': # Forward reference for Iterator\n        \"\"\"Allows iteration over the unique normalized values.\"\"\"\n        return iter(self.values)\n\nclass ProductResult:\n    \"\"\"Holds the computed product and presents it in an appropriate type.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value: float = value\n\n    def as_int_or_float(self) -> float | int:\n        \"\"\"Returns the product as an int if integral, otherwise as a float.\"\"\"\n        if self.value == int(self.value):\n            return int(self.value)\n        return self.value\n\ndef unique_product(values: list) -> float | int:\n    \"\"\"\n    Computes the product of unique numeric values in a list.\n    Handles duplicates, mixed types, and returns 1 for an empty list.\n    \"\"\"\n    input_list = InputList(values)\n    unique_set = UniqueValueSet()\n\n    for raw_value in input_list.values:\n        num_val = NumericValue(raw_value)\n        unique_set.add(num_val)\n\n    if not unique_set.values:\n        return 1\n\n    product = 1.0\n    for val in unique_set:\n        product *= val\n\n    result = ProductResult(product)\n    return result.as_int_or_float()"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(source: list, candidate: list) -> bool:\n    \"\"\"Return True iff candidate appears as a contiguous subsequence within source.\n    Uses Python equality (==) for comparisons and does not modify inputs.\"\"\"\n    if len(candidate) == 0:\n        return True\n    if len(candidate) > len(source):\n        return False\n\n    max_start_index = len(source) - len(candidate)\n    for i in range(max_start_index + 1):\n        # Check if the slice source[i : i + len(candidate)] matches candidate\n        match = True\n        for j in range(len(candidate)):\n            if not (source[i + j] == candidate[j]):\n                match = False\n                break\n        if match:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "```python\n# src/last_digit_factorial.py\n\ndef computeFactorial(n: int) -> int:\n    \"\"\"Return factorial n! as Python int. Precondition: n is int and n >= 0.\"\"\"\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\n\ndef extractLastDigit(factorial: int) -> int:\n    \"\"\"Return factorial % 10 as int (0..9). Precondition: factorial is int >= 0.\"\"\"\n    return factorial % 10\n\ndef last_Digit_Factorial(n) -> int:\n    \"\"\"Validate n and return last decimal digit (0..9) of n!. Raises TypeError for non-int, ValueError for negative.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Mathematical shortcut: for n >= 5, n! will always end in 0.\n    if n >= 5:\n        return 0\n\n    factorial_value = computeFactorial(n)\n    return extractLastDigit(factorial_value)\n\n```\n```python\n# tests/test_last_digit_factorial.py\nfrom src.last_digit_factorial import last_Digit_Factorial\n\n# Required assertion per SRS/NFR2/FR3\nassert last_Digit_Factorial(4) == 4\n\n```"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"Checks if sub_list is a contiguous subsequence (subarray) of main_list.\n    Elements are compared using Python's == equality semantics.\"\"\"\n\n    # If sub_list is empty, it is considered a subarray of any list.\n    if not sub_list:\n        return True\n\n    # If sub_list is longer than main_list, it cannot be a subarray.\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    # Iterate through main_list with a sliding window of size m (length of sub_list).\n    for i in range(n - m + 1):\n        # Compare the current slice of main_list with sub_list.\n        # This operation creates a new slice and does not modify main_list.\n        if main_list[i : i + m] == sub_list:\n            return True\n\n    # If no match is found after checking all possible windows, sub_list is not a subarray.\n    return False"}
{"task_id": "Mbpp/577", "solution": "```python\n_SMALL_LAST_DIGITS = {0: 1, 1: 1, 2: 2, 3: 6, 4: 4}\n\ndef last_Digit_Factorial(n):\n    \"\"\"Computes the last decimal digit of n! for a non-negative integer n.\n    For n >= 5, the result is 0, otherwise it's looked up from a precomputed table.\n    \"\"\"\n    if n in _SMALL_LAST_DIGITS:\n        return _SMALL_LAST_DIGITS[n]\n    return 0\n```"}
{"task_id": "Mbpp/578", "solution": "```python\n# src/interleaver.py\n\nfrom typing import List, Any\n\nclass Interleaver:\n    \"\"\"Encapsulates validation and interleaving logic for three lists.\n    This class is stateless and provides methods for core operations.\n    \"\"\"\n\n    def validate_lengths(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> bool:\n        \"\"\"Returns True if the three input lists have equal length, otherwise False.\n        This includes cases where all lists are empty.\n        \"\"\"\n        return len(list1) == len(list2) == len(list3)\n\n    def interleave_lists(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n        \"\"\"Interleaves three equal-length lists into a single flat list.\n        If lengths are unequal, a ValueError is raised.\n        \"\"\"\n        if not self.validate_lengths(list1, list2, list3):\n            raise ValueError(\"Input lists must have equal length for interleaving.\")\n\n        num_elements = len(list1)\n        if num_elements == 0:\n            return []\n\n        interleaved_list: List[Any] = []\n        for i in range(num_elements):\n            interleaved_list.append(list1[i])\n            interleaved_list.append(list2[i])\n            interleaved_list.append(list3[i])\n        return interleaved_list\n\ndef validate_lengths(list1: List[Any], list2: List[Any], list3: List[Any]) -> bool:\n    \"\"\"Module-level helper: returns True if input lists have equal length, otherwise False.\n    This function delegates to an Interleaver instance for its logic.\n    \"\"\"\n    return Interleaver().validate_lengths(list1, list2, list3)\n\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"Public API: interleaves three equal-length lists into a single flat list.\n    Delegates to an Interleaver instance and raises ValueError if lengths differ.\n    \"\"\"\n    return Interleaver().interleave_lists(list1, list2, list3)\n\n```\n```python\n# src/__init__.py\n\nfrom .interleaver import interleave_lists, validate_lengths, Interleaver\n\n__all__ = [\"interleave_lists\", \"validate_lengths\", \"Interleaver\"]\n\n```"}
{"task_id": "Mbpp/578", "solution": "```python\nfrom typing import List, Any\n\ndef interleave_lists(a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves elements from three lists into a single flat list.\n    This implementation assumes input lists are of equal length as per critical requirements.\n    \"\"\"\n    n = len(a)\n    result: List[Any] = []\n    for i in range(n):\n        result.append(a[i])\n        result.append(b[i])\n        result.append(c[i])\n    return result\n```"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"Returns a tuple containing elements present in exactly one of the two input tuples, preserving order.\"\"\"\n    \n    # Compute the set of elements common to both tuples.\n    shared_elements = set(a) & set(b)\n    \n    result_list = []\n    \n    # Add qualifying elements from tuple 'a' in their original order.\n    for item in a:\n        if item not in shared_elements:\n            result_list.append(item)\n            \n    # Add qualifying elements from tuple 'b' in their original order.\n    for item in b:\n        if item not in shared_elements:\n            result_list.append(item)\n            \n    return tuple(result_list)"}
{"task_id": "Mbpp/579", "solution": "```python\n# src/find_dissimilar.py\nimport collections.abc\nfrom typing import Any, List, TypeVar, Tuple\n\n_T = TypeVar('_T')\n\nclass TupleInput:\n    \"\"\"Holds a tuple input value as an immutable container.\"\"\"\n    def __init__(self, elements: Tuple[_T, ...]):\n        self.elements = elements\n\nclass ResultTuple:\n    \"\"\"Represents the resulting tuple produced by find_dissimilar.\"\"\"\n    def __init__(self, elements: Tuple[_T, ...]):\n        self.elements = elements\n\nclass Validator:\n    \"\"\"Validates that given objects are tuples.\"\"\"\n    def validate_is_tuple(self, obj: Any) -> None:\n        \"\"\"Raises TypeError if obj is not an tuple.\"\"\"\n        if not isinstance(obj, tuple):\n            raise TypeError(f\"Input must be a tuple, but got {type(obj).__name__}.\")\n\nclass Comparator:\n    \"\"\"Centralizes equality checks.\"\"\"\n    def equals(self, x: Any, y: Any) -> bool:\n        \"\"\"Returns x == y.\"\"\"\n        return x == y\n\nclass Processor:\n    \"\"\"Computes the ordered symmetric difference between two tuples.\"\"\"\n    def compute_symmetric_ordered(self, a: Tuple[_T, ...], b: Tuple[_T, ...]) -> List[_T]:\n        \"\"\"\n        Computes the ordered symmetric difference.\n        Elements unique to 'a' are listed first, then elements unique to 'b'.\n        \"\"\"\n        result: List[_T] = []\n        comparator = Comparator()\n\n        try:\n            # Attempt efficient set-based approach for hashable elements (average-case O(N+M))\n            b_set = set(b)\n            for item_a in a:\n                if item_a not in b_set:\n                    result.append(item_a)\n\n            a_set = set(a)\n            for item_b in b:\n                if item_b not in a_set:\n                    result.append(item_b)\n\n        except TypeError:\n            # Fallback to O(N*M) equality-only checks for unhashable elements.\n            # Reset result as the previous attempt might have partially populated it.\n            result = []\n\n            # Find elements in 'a' that are not in 'b'\n            for item_a in a:\n                found_in_b = False\n                for item_b_inner in b:\n                    if comparator.equals(item_a, item_b_inner):\n                        found_in_b = True\n                        break\n                if not found_in_b:\n                    result.append(item_a)\n\n            # Find elements in 'b' that are not in 'a'\n            for item_b in b:\n                found_in_a = False\n                for item_a_inner in a:\n                    if comparator.equals(item_b, item_a_inner):\n                        found_in_a = True\n                        break\n                if not found_in_a:\n                    result.append(item_b)\n\n        return result\n\ndef find_dissimilar(a: Tuple[_T, ...], b: Tuple[_T, ...]) -> Tuple[_T, ...]:\n    \"\"\"\n    Public API: Orchestrates validation and processing to find dissimilar elements.\n    Returns a new tuple with unique elements from 'a' then 'b', in their original relative order.\n    \"\"\"\n    validator = Validator()\n    validator.validate_is_tuple(a)\n    validator.validate_is_tuple(b)\n\n    processor = Processor()\n    dissimilar_list = processor.compute_symmetric_ordered(a, b)\n\n    return tuple(dissimilar_list)\n```\n\n```python\n# tests/test_find_dissimilar.py\nimport unittest\nfrom src.find_dissimilar import find_dissimilar\n\nclass UnitTest(unittest.TestCase):\n    \"\"\"Unit tests for the find_dissimilar function.\"\"\"\n\n    def test_example(self):\n        \"\"\"Tests the example assertion provided in the specification.\"\"\"\n        self.assertEqual(find_dissimilar((3, 4, 5, 6), (5, 7, 4, 10)), (3, 6, 7, 10))\n\n    def test_edge_cases(self):\n        \"\"\"Tests various edge cases for find_dissimilar.\"\"\"\n        # Empty tuples\n        self.assertEqual(find_dissimilar((), ()), ())\n        self.assertEqual(find_dissimilar((1, 2), ()), (1, 2))\n        self.assertEqual(find_dissimilar((), (1, 2)), (1, 2))\n\n        # No dissimilar elements\n        self.assertEqual(find_dissimilar((1, 2, 3), (1, 2, 3)), ())\n        self.assertEqual(find_dissimilar((1, 2, 3, 1), (1, 2, 3)), ())\n\n        # All dissimilar elements\n        self.assertEqual(find_dissimilar((1, 2), (3, 4)), (1, 2, 3, 4))\n\n        # Mixed types of elements\n        self.assertEqual(find_dissimilar(('a', 1, None), (1, 'b', None)), ('a', 'b'))\n\n        # Duplicates within tuples, preserving order and uniqueness relative to the other tuple\n        self.assertEqual(find_dissimilar((1, 2, 2, 3, 5), (2, 4, 5, 5)), (1, 3, 4))\n        self.assertEqual(find_dissimilar((1, 2, 3, 1), (1, 4, 2)), (3, 4))\n\n        # Unhashable elements (should trigger O(N*M) fallback in Processor)\n        self.assertEqual(find_dissimilar(([], [1]), ([1], [2])), ([], [2]))\n        self.assertEqual(find_dissimilar(([1, 2], 'a'), ('a', [1, 2, 3])), ([1, 2], [1, 2, 3]))\n        self.assertEqual(find_dissimilar(([[1]], [[2]]), ([[2]], [[3]])), ([[1]], [[3]]))\n\n        # Non-tuple inputs (assert TypeError)\n        with self.assertRaises(TypeError):\n            find_dissimilar(1, (2,))\n        with self.assertRaises(TypeError):\n            find_dissimilar((1,), [2])\n        with self.assertRaises(TypeError):\n            find_dissimilar(None, ())\n        with self.assertRaises(TypeError):\n            find_dissimilar((), 'string')\n```"}
{"task_id": "Mbpp/580", "solution": "def _extract_even_recursive(current_tuple: tuple) -> tuple:\n    \"\"\"Recursively processes a tuple to filter out odd integers.\"\"\"\n    result_elements = []\n    for item in current_tuple:\n        if type(item) is int:\n            if item % 2 == 0:\n                result_elements.append(item)\n        else: # Assumed to be a tuple based on design; no 'isinstance' as forbidden.\n            processed_nested_tuple = _extract_even_recursive(item)\n            result_elements.append(processed_nested_tuple)\n    return tuple(result_elements)\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Public API to extract even integers from a nested tuple, preserving structure.\"\"\"\n    return _extract_even_recursive(input_tuple)"}
{"task_id": "Mbpp/580", "solution": "```python\ndef _is_even(n: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return n % 2 == 0\n\ndef _process_element(elem):\n    \"\"\"Recursively processes an element, filtering odd integers and preserving tuple structure.\"\"\"\n    if type(elem) is int:\n        return elem if _is_even(elem) else None\n    elif type(elem) is tuple:\n        processed_children = []\n        for child in elem:\n            processed_child = _process_element(child)\n            if processed_child is not None:\n                processed_children.append(processed_child)\n        return tuple(processed_children)\n    # Per critical requirements, do not raise TypeError for unsupported types.\n    # Simplest direct logic: filter out unsupported types by returning None.\n    return None\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Extracts even integers from a nested tuple, preserving nesting structure and order.\n    Elements other than integers or tuples are filtered out.\n    \"\"\"\n    # The top-level input_tuple is processed like any other tuple element.\n    return _process_element(input_tuple)\n```"}
{"task_id": "Mbpp/581", "solution": "```python\ndef surface_Area(base_edge, height):\n    \"\"\"Compute the surface area of a square pyramid using the mandated formula.\n    It accepts numeric base_edge and height, returning the calculated area.\n    \"\"\"\n    return base_edge**2 + 2 * base_edge * height\n```"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Computes the total surface area of a square pyramid.\n    It calculates the slant height and then the total surface area.\n    \"\"\"\n    # Compute slant height using the formula: sqrt((base_edge / 2)**2 + height**2)\n    slant_height = math.sqrt((base_edge / 2)**2 + height**2)\n\n    # Compute total surface area using the formula: base_edge**2 + 2 * base_edge * slant_height\n    surface_area = base_edge**2 + 2 * base_edge * slant_height\n    \n    return float(surface_area)"}
{"task_id": "Mbpp/583", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker for the src module; exports catalan API.\"\"\"\nfrom .catalan import catalan_number, ValidationError, CatalanResult\n```\n\n```python\n# src/catalan.py\nimport math\n\nclass ValidationError(Exception):\n    \"\"\"Exception type raised when validation fails.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputParameter:\n    \"\"\"Validates that provided input is a non-negative integer.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(self.n, int) and self.n >= 0\n\nclass CatalanResult:\n    \"\"\"Encapsulates integer result of computation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def __int__(self) -> int:\n        \"\"\"Returns the integer value.\"\"\"\n        return self.value\n\ndef _comb(n: int, k: int) -> int:\n    \"\"\"Fallback binomial coefficient computation if math.comb unavailable.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2: # Optimization: C(n, k) = C(n, n-k)\n        k = n - k\n    \n    # Calculate nCk = n! / (k! * (n-k)!)\n    numerator = math.factorial(n)\n    denominator = math.factorial(k) * math.factorial(n - k)\n    return numerator // denominator\n\n# Choose math.comb if available (Python >= 3.8), otherwise use the fallback.\n_chosen_comb = getattr(math, 'comb', _comb)\n\nclass CatalanFunction:\n    \"\"\"Provides computation methods and public catalan_number API.\"\"\"\n    def __init__(self):\n        self._comb_func = _chosen_comb\n\n    def compute_by_formula(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using the binomial formula.\"\"\"\n        # C_n = C(2n, n) / (n + 1)\n        if n == 0:\n            return 1\n        return self._comb_func(2 * n, n) // (n + 1)\n\n    def compute_by_recurrence(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using the recurrence relation.\"\"\"\n        # C_0 = 1, C_n = sum(C_i * C_{n-1-i}) for i from 0 to n-1\n        if n == 0:\n            return 1\n        \n        catalan_numbers = [0] * (n + 1)\n        catalan_numbers[0] = 1\n        \n        for i in range(1, n + 1):\n            current_catalan = 0\n            for j in range(i):\n                current_catalan += catalan_numbers[j] * catalan_numbers[i - 1 - j]\n            catalan_numbers[i] = current_catalan\n        return catalan_numbers[n]\n\n    def catalan_number(self, n: int) -> int:\n        \"\"\"Internal method to compute nth Catalan number using preferred method.\"\"\"\n        # Per design, compute_by_formula is preferred.\n        return self.compute_by_formula(n)\n\ndef catalan_number(n) -> int:\n    \"\"\"Public API that delegates to CatalanFunction.\"\"\"\n    # Validate the input parameter.\n    param = InputParameter(n)\n    if not param.isValid():\n        raise ValidationError(\"Input 'n' must be a non-negative integer.\")\n\n    # Compute the Catalan number.\n    catalan_calculator = CatalanFunction()\n    result_value = catalan_calculator.catalan_number(n)\n    \n    # Encapsulate and return the result.\n    result = CatalanResult(result_value)\n    return int(result)\n```"}
{"task_id": "Mbpp/585", "solution": "def _copy_item_dict(item):\n    \"\"\"\n    Returns a shallow copy of an item dictionary.\n    Ensures returned dicts are new equivalent dicts.\n    \"\"\"\n    return item.copy()\n\ndef expensive_items(items, n):\n    \"\"\"\n    Returns the n most expensive items from a list of item dictionaries.\n    Items are sorted by price in descending order.\n    \"\"\"\n    # Sort items by price in descending order. Trusting schema per requirements.\n    sorted_items = sorted(items, key=lambda item: item['price'], reverse=True)\n\n    # Slice to get the top n items, or all if n is larger.\n    top_n_items = sorted_items[:n]\n\n    # Create shallow copies of the dictionaries for the return list.\n    return [_copy_item_dict(item) for item in top_n_items]"}
{"task_id": "Mbpp/583", "solution": "```python\n# src/errors.py\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        \"\"\"Returns the error message.\"\"\"\n        return self.message\n\n```\n```python\n# src/validator.py\nfrom src.errors import ValidationError\n\ndef validate_n(n) -> None:\n    \"\"\"Validates that n is a non-negative integer.\n    Raises ValidationError if n is invalid.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValidationError(\"Input 'n' must be a non-negative integer.\")\n\n```\n```python\n# src/catalan.py\nimport math\nfrom src.validator import validate_n\nfrom src.errors import ValidationError\n\ndef compute_binomial(n: int) -> int:\n    \"\"\"Computes Cn = comb(2n, n) // (n + 1) using integer arithmetic.\n    Uses math.comb for exact integer results.\"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative for binomial computation.\")\n    \n    return math.comb(2 * n, n) // (n + 1)\n\ndef compute_dp(n: int) -> int:\n    \"\"\"Computes Catalan number using dynamic programming recurrence.\n    C0 = 1; Cn = sum_{i=0..n-1} Ci * Cn-1-i (integer-only).\"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative for dynamic programming.\")\n    if n == 0:\n        return 1\n    \n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n    \n    for i in range(1, n + 1):\n        for j in range(i):\n            catalan[i] += catalan[j] * catalan[i - 1 - j]\n            \n    return catalan[n]\n\ndef catalan_number(n) -> int:\n    \"\"\"Provides the nth Catalan number as an exact integer.\n    Validates input n and returns 1 for n=0.\"\"\"\n    validate_n(n)\n    \n    if n == 0:\n        return 1\n    \n    # Using compute_binomial as preferred method based on design specification.\n    return compute_binomial(n)\n\n```\n```python\n# tests/test_catalan.py\nimport sys\nimport os\nimport unittest\n\n# Add src directory to the Python path to allow importing modules\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))\n\nfrom src.catalan import catalan_number\nfrom src.errors import ValidationError\n\nclass TestCatalan(unittest.TestCase):\n    \"\"\"Test suite for the catalan_number function.\"\"\"\n\n    def test_catalan_basic(self):\n        \"\"\"Asserts catalan_number(10) returns 16796 (FR5).\"\"\"\n        self.assertEqual(catalan_number(10), 16796)\n\n    def test_catalan_base_case(self):\n        \"\"\"Asserts catalan_number(0) returns 1 (FR3).\"\"\"\n        self.assertEqual(catalan_number(0), 1)\n    \n    def test_catalan_small_values(self):\n        \"\"\"Tests several small valid inputs.\"\"\"\n        self.assertEqual(catalan_number(1), 1)\n        self.assertEqual(catalan_number(2), 2)\n        self.assertEqual(catalan_number(3), 5)\n        self.assertEqual(catalan_number(4), 14)\n        self.assertEqual(catalan_number(5), 42)\n\n    def test_catalan_invalid_inputs(self):\n        \"\"\"Asserts invalid inputs raise ValidationError (FR4).\"\"\"\n        with self.assertRaises(ValidationError) as cm:\n            catalan_number(-1)\n        self.assertIn(\"non-negative\", str(cm.exception))\n\n        with self.assertRaises(ValidationError) as cm:\n            catalan_number(3.5)\n        self.assertIn(\"integer\", str(cm.exception))\n\n        with self.assertRaises(ValidationError) as cm:\n            catalan_number(\"abc\")\n        self.assertIn(\"integer\", str(cm.exception))\n\n        with self.assertRaises(ValidationError) as cm:\n            catalan_number(None)\n        self.assertIn(\"integer\", str(cm.exception))\n\ndef run_tests():\n    \"\"\"Runs the full test suite for Catalan number.\"\"\"\n    print(\"Running Catalan number tests...\")\n    suite = unittest.TestSuite()\n    suite.addTest(unittest.makeSuite(TestCatalan))\n    runner = unittest.TextTestRunner(verbosity=2)\n    result = runner.run(suite)\n    print(f\"Tests passed: {result.wasSuccessful()}\")\n    return 0 if result.wasSuccessful() else 1\n\nif __name__ == '__main__':\n    sys.exit(run_tests())\n```"}
