{"task_id": "Mbpp/233", "solution": "```python\nimport math\nfrom dataclasses import dataclass\n\nclass Constant_PI:\n    \"\"\"Holds the specified value for PI.\"\"\"\n    PI: float = 3.141592653589793\n\n@dataclass\nclass CylinderInput:\n    \"\"\"Typed container for cylinder input dimensions.\"\"\"\n    radius: float\n    height: float\n\n@dataclass\nclass CylinderOutput:\n    \"\"\"Typed container for the computed lateral surface area.\"\"\"\n    lateralSurfaceArea: float\n\nclass LateralSurfaceFunction:\n    \"\"\"Encapsulates the computation of the lateral surface area of a cylinder.\"\"\"\n    def compute(self, radius: float, height: float) -> float:\n        \"\"\"Computes 2 * PI * radius * height using the predefined PI constant.\"\"\"\n        return 2 * Constant_PI.PI * radius * height\n\ndef lateralsuface_cylinder(radius, height) -> float:\n    \"\"\"Public API for calculating the lateral surface area of a cylinder.\n    Accepts numeric radius and height, returning the area as a float.\n    \"\"\"\n    lsf = LateralSurfaceFunction()\n    return lsf.compute(float(radius), float(height))\n```"}
{"task_id": "Mbpp/234", "solution": "```python\n# src/volume_cube.py\nclass Cube:\n    \"\"\"Holds side_length and computes its volume.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self.side_length = side_length\n\n    def compute_volume(self) -> float:\n        \"\"\"Returns the volume of the cube.\"\"\"\n        return self.side_length * self.side_length * self.side_length\n\nclass VolumeCubeFunction:\n    \"\"\"Encapsulates volume computation; stateless.\"\"\"\n    def compute(self, side_length: float) -> float:\n        \"\"\"Computes cube volume by delegating to a Cube object.\"\"\"\n        cube = Cube(side_length)\n        return cube.compute_volume()\n\ndef volume_cube(side_length: float) -> float:\n    \"\"\"Public API: computes the volume of a cube.\n    Delegates the computation to VolumeCubeFunction.\"\"\"\n    service = VolumeCubeFunction()\n    return service.compute(side_length)\n\n```\n```python\n# tests/test_volume_cube.py\nimport unittest\nfrom src.volume_cube import volume_cube\n\nclass UnitTest(unittest.TestCase):\n    \"\"\"Unit test for the volume_cube function.\"\"\"\n    def test_volume_cube(self):\n        \"\"\"Asserts volume_cube(3) correctly returns 27.\"\"\"\n        self.assertEqual(volume_cube(3), 27)\n\nif __name__ == '__main__':\n    unittest.main()\n\n```"}
{"task_id": "Mbpp/235", "solution": "```python\ndef _msb_position(n: int) -> int:\n    \"\"\"Return 1-based MSB position of n, or 0 if n == 0.\n    Uses n.bit_length() which gives the 1-based MSB for positive integers.\n    \"\"\"\n    if n == 0:\n        return 0\n    return n.bit_length()\n\n\ndef _generate_even_mask(msb: int) -> int:\n    \"\"\"Return integer mask with bits set at even positions 2,4,6,... up to highest even position <= msb.\n    Returns 0 if msb < 2 as there are no even positions to set up to MSB 1.\n    \"\"\"\n    mask = 0\n    # Iterate through 1-based even positions (2, 4, 6, ...)\n    for pos in range(2, msb + 1, 2):\n        # Set the corresponding 0-indexed bit\n        mask |= (1 << (pos - 1))\n    return mask\n\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Public API that returns an integer with even-positioned bits set up to the MSB of n.\n    For n == 0, the function returns 0.\n    \"\"\"\n    msb = _msb_position(n)\n    if msb == 0:\n        return 0\n    mask = _generate_even_mask(msb)\n    return mask\n```"}
{"task_id": "Mbpp/234", "solution": "```python\n# src/__init__.py\nfrom .volume_module import volume_cube\n```\n\n```python\n# src/cube.py\nfrom typing import Union\n\nclass Cube:\n    \"\"\"\n    Domain entity representing a cube, encapsulating its side length and volume calculation.\n    \"\"\"\n    def __init__(self, side_length: Union[int, float]) -> None:\n        \"\"\"Initializes a Cube with a given side length.\"\"\"\n        self.side_length = side_length\n\n    def volume(self) -> float:\n        \"\"\"\n        Computes and returns the volume of the cube (side_length^3).\n        \"\"\"\n        return float(self.side_length * self.side_length * self.side_length)\n\n```\n\n```python\n# src/input_validator.py\nfrom typing import Any\n\nclass InputValidator:\n    \"\"\"\n    Utility class for validating input values.\n    \"\"\"\n    def is_numeric(self, value: Any) -> bool:\n        \"\"\"\n        Checks if the given value is an integer or a float.\n        \"\"\"\n        return isinstance(value, (int, float))\n\n```\n\n```python\n# src/volume_service.py\nfrom typing import Union\nfrom .input_validator import InputValidator\nfrom .cube import Cube\n\nclass VolumeService:\n    \"\"\"\n    Application/service layer for cube volume calculation, orchestrating\n    validation and domain operations.\n    \"\"\"\n    def volume_cube(self, side_length: Union[int, float]) -> float:\n        \"\"\"\n        Validates the side_length and computes the volume of a cube.\n        Raises ValueError for non-numeric input.\n        \"\"\"\n        validator = InputValidator()\n        if validator.is_numeric(side_length):\n            cube = Cube(side_length)\n            return cube.volume()\n        else:\n            raise ValueError(\"side_length must be numeric\")\n\n```\n\n```python\n# src/volume_module.py\nfrom typing import Union\nfrom .volume_service import VolumeService\n\ndef volume_cube(side_length: Union[int, float]) -> float:\n    \"\"\"\n    Public API function to calculate the volume of a cube.\n    Delegates the operation to VolumeService.\n    \"\"\"\n    service = VolumeService()\n    return service.volume_cube(side_length)\n\n```\n\n```python\n# tests/test_volume.py\nfrom typing import Union\nfrom src.volume_module import volume_cube\n\nclass TestCase:\n    \"\"\"\n    A minimal test case for validating function behavior.\n    It runs a specific test input against an expected output.\n    \"\"\"\n    def __init__(self, input_value: Union[int, float], expected_output: Union[int, float]) -> None:\n        \"\"\"Initializes the test case with input and expected values.\"\"\"\n        self.input = input_value\n        self.expected = expected_output\n        self.passed = False\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the test by calling volume_cube and comparing the result.\n        Returns True if the test passes, False otherwise.\n        \"\"\"\n        try:\n            actual_output = volume_cube(self.input)\n            # Using exact equality as specified for the acceptance test case.\n            self.passed = (actual_output == self.expected)\n        except Exception as e:\n            # If any exception is raised, the test fails.\n            print(f\"Test for input {self.input} failed with exception: {e}\")\n            self.passed = False\n        return self.passed\n\n# Entry point for acceptance test (FR4)\nif __name__ == \"__main__\":\n    print(\"Running acceptance test for volume_cube...\")\n    test_case = TestCase(3, 27)\n    if test_case.run():\n        print(f\"Acceptance test PASSED: volume_cube({test_case.input}) == {test_case.expected}\")\n        # Final assertion to explicitly fulfill the design's requirement \"assert volume_cube(3) == 27\"\n        assert volume_cube(3) == 27, \"Direct assertion for FR4 failed even if TestCase reported pass.\"\n    else:\n        print(f\"Acceptance test FAILED: volume_cube({test_case.input}) did not return {test_case.expected}\")\n        raise AssertionError(\"Acceptance test FR4 failed.\")\n    print(\"All specified tests completed.\")\n\n```"}
{"task_id": "Mbpp/235", "solution": "```python\n# src/even_bit_set.py\n\"\"\"\nThis module provides a function to set even-positioned bits in an integer.\nBit positions are counted from 1 for the Least Significant Bit (LSB).\n\"\"\"\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Returns an integer where every even-positioned bit (positions counted\n    from 1 at LSB) is set to 1. Raises TypeError for non-integer inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be int\")\n\n    mask = 0\n    # Determine the maximum bit position to consider for setting even bits.\n    # This ensures the mask covers bits up to n's highest set bit, plus at\n    # least one additional position to potentially set the next even bit.\n    # For n=0, `bit_length()` is 0, so a minimum of 2 positions is considered\n    # to ensure position 2 can be set.\n    max_bit_for_mask = (n | (n >> 1)).bit_length() + 1 if n != 0 else 2\n\n    for i in range(1, max_bit_for_mask + 1):\n        if i % 2 == 0:  # If the current position 'i' is even (2, 4, 6, ...)\n            mask |= (1 << (i - 1)) # Set the corresponding bit in the mask (0-indexed)\n\n    return n | mask\n\n```\n```python\n# tests/test_even_bit_set.py\n\"\"\"\nUnit tests for the even_bit_set module.\nThis script verifies the core functionality of even_bit_set_number.\n\"\"\"\n\nimport sys\nimport os\n\n# Add the src directory to the Python path to allow importing src.even_bit_set\n# This path manipulation is necessary for the specified file structure and execution.\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))\n\nfrom even_bit_set import even_bit_set_number\n\ndef test_assertion():\n    \"\"\"\n    Runs the required acceptance assertion for even_bit_set_number(10).\n    \"\"\"\n    assert even_bit_set_number(10) == 10, \\\n        f\"Failed: even_bit_set_number(10) expected 10, got {even_bit_set_number(10)}\"\n    print(\"Required assertion 'even_bit_set_number(10) == 10' PASSED.\")\n\ndef test_type_error():\n    \"\"\"\n    Tests that TypeError is raised for non-integer inputs.\n    \"\"\"\n    try:\n        even_bit_set_number(\"not an int\")\n        assert False, \"TypeError was not raised for non-int input.\"\n    except TypeError as e:\n        assert str(e) == \"n must be int\", f\"Unexpected TypeError message: {e}\"\n        print(\"TypeError test for non-int input PASSED.\")\n    except Exception as e:\n        assert False, f\"Unexpected exception type: {type(e).__name__}\"\n\ndef test_additional_cases():\n    \"\"\"\n    Tests additional cases beyond the required assertion to clarify behavior.\n    \"\"\"\n    # n = 0 (0b0) -> even position 2 set -> 0b10 (2)\n    assert even_bit_set_number(0) == 2, \\\n        f\"Failed: even_bit_set_number(0) expected 2, got {even_bit_set_number(0)}\"\n    print(\"Additional test 'even_bit_set_number(0) == 2' PASSED.\")\n\n    # n = 1 (0b1) -> original pos 1=1, even position 2 set -> 0b11 (3)\n    assert even_bit_set_number(1) == 3, \\\n        f\"Failed: even_bit_set_number(1) expected 3, got {even_bit_set_number(1)}\"\n    print(\"Additional test 'even_bit_set_number(1) == 3' PASSED.\")\n\n    # n = 5 (0b0101) -> original bits: pos 1=1, pos 2=0, pos 3=1, pos 4=0\n    # Even bits set to 1: pos 2=1, pos 4=1. Result: 0b1111 (15)\n    assert even_bit_set_number(5) == 15, \\\n        f\"Failed: even_bit_set_number(5) expected 15, got {even_bit_set_number(5)}\"\n    print(\"Additional test 'even_bit_set_number(5) == 15' PASSED.\")\n\n    # n = 4 (0b0100) -> original bits: pos 1=0, pos 2=0, pos 3=1, pos 4=0\n    # Even bits set to 1: pos 2=1, pos 4=1. Result: 0b1110 (14)\n    assert even_bit_set_number(4) == 14, \\\n        f\"Failed: even_bit_set_number(4) expected 14, got {even_bit_set_number(4)}\"\n    print(\"Additional test 'even_bit_set_number(4) == 14' PASSED.\")\n\n    # n = 255 (0b11111111) -> even positions 2,4,6,8 are already 1. Result: 0b11111111 (255)\n    assert even_bit_set_number(255) == 255, \\\n        f\"Failed: even_bit_set_number(255) expected 255, got {even_bit_set_number(255)}\"\n    print(\"Additional test 'even_bit_set_number(255) == 255' PASSED.\")\n\nif __name__ == \"__main__\":\n    print(\"Running tests...\")\n    test_assertion() # Runs the mandatory assertion\n    test_type_error() # Runs error handling test\n    test_additional_cases() # Runs additional logic tests\n    print(\"All tests PASSED.\")\n\n```"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(input_string: str) -> int:\n    \"\"\"\n    Computes the number of non-empty contiguous substrings of the input string.\n    This function implements the formula n*(n+1)//2 where n is the string length.\n    \"\"\"\n    n = len(input_string)\n    count = n * (n + 1) // 2\n    return count"}
{"task_id": "Mbpp/237", "solution": "```python\n# src/__init__.py\n\nfrom .check_occurences import (\n    check_occurences,\n    execute,\n    validate,\n    normalize,\n    count_canonical,\n    ValidationError\n)\n\n__all__ = [\n    'check_occurences',\n    'execute',\n    'validate',\n    'normalize',\n    'count_canonical',\n    'ValidationError'\n]\n```\n```python\n# src/check_occurences.py\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to check_occurences.\n    Stores and returns a descriptive error message.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"ValidationError: {self.message}\"\n\ndef validate(input_data) -> None:\n    \"\"\"Ensures input is a list of 2-element tuples, raising ValidationError if invalid.\n    Checks list type, element type, tuple length, and comparability of tuple elements.\n    \"\"\"\n    if not isinstance(input_data, list):\n        raise ValidationError(\"Input must be a list.\")\n    \n    for i, item in enumerate(input_data):\n        if not isinstance(item, tuple):\n            raise ValidationError(f\"Element at index {i} is not a tuple.\")\n        if not len(item) == 2:\n            raise ValidationError(f\"Tuple at index {i} must have exactly 2 elements.\")\n        \n        # Check if tuple elements are comparable, as normalize uses min/max.\n        try:\n            _ = min(item[0], item[1])\n            _ = max(item[0], item[1])\n        except TypeError:\n            raise ValidationError(f\"Elements within tuple at index {i} are not comparable.\")\n        except Exception as e:\n            raise ValidationError(f\"An unexpected error occurred while checking tuple element comparability at index {i}: {e}\")\n\ndef normalize(tup: tuple) -> tuple:\n    \"\"\"Returns a new 2-element tuple with elements in non-decreasing order (min, max).\n    This function does not modify the original tuple.\n    \"\"\"\n    return (min(tup[0], tup[1]), max(tup[0], tup[1]))\n\ndef count_canonical(canonical_tuple: tuple, mapping: dict) -> None:\n    \"\"\"Increments the count for a given canonical tuple in the provided mapping.\n    If the tuple is not present, it is initialized with a count of 1.\n    \"\"\"\n    mapping[canonical_tuple] = mapping.get(canonical_tuple, 0) + 1\n\ndef check_occurences(list_of_tuples: list) -> dict:\n    \"\"\"Validates an input list of tuples, canonicalizes each tuple, and counts occurrences.\n    Returns a dictionary mapping canonical tuples to their integer counts.\n    \"\"\"\n    validate(list_of_tuples)\n    \n    if not list_of_tuples:\n        return {}\n        \n    result_map = {}\n    for tup in list_of_tuples:\n        canonical = normalize(tup)\n        count_canonical(canonical, result_map)\n        \n    return result_map\n\ndef execute(list_of_tuples: list) -> dict:\n    \"\"\"Provides an alias for the check_occurences function.\n    Its behavior is identical to check_occurences.\n    \"\"\"\n    return check_occurences(list_of_tuples)\n```\n```python\n# tests/test_check_occurences.py\n\nimport pytest\nfrom src.check_occurences import (\n    check_occurences,\n    ValidationError\n)\n\ndef test_example_case():\n    \"\"\"Verifies the example case returns the correct mapping.\n    This test confirms the core functionality of validation, normalization, and counting.\n    \"\"\"\n    input_list = [(3, 1), (1, 3), (2, 5), (5, 2), (6, 3)]\n    expected_output = {(1, 3): 2, (2, 5): 2, (3, 6): 1}\n    assert check_occurences(input_list) == expected_output\n\ndef test_empty_list():\n    \"\"\"Verifies that an empty input list returns an empty dictionary.\n    This covers an expected edge case as per the design.\n    \"\"\"\n    assert check_occurences([]) == {}\n\ndef test_invalid_inputs():\n    \"\"\"Verifies that various invalid inputs correctly trigger a ValidationError.\n    Tests non-list inputs, lists with non-tuple elements, tuples of incorrect length, and non-comparable tuple elements.\n    \"\"\"\n    # Not a list\n    with pytest.raises(ValidationError, match=\"Input must be a list.\"):\n        check_occurences(None)\n    with pytest.raises(ValidationError, match=\"Input must be a list.\"):\n        check_occurences(\"not a list\")\n    with pytest.raises(ValidationError, match=\"Input must be a list.\"):\n        check_occurences((1, 2)) # tuple, not list\n    with pytest.raises(ValidationError, match=\"Input must be a list.\"):\n        check_occurences(123)\n\n    # List contains non-tuple elements\n    with pytest.raises(ValidationError, match=\"Element at index 0 is not a tuple.\"):\n        check_occurences([1, (2,3)])\n    with pytest.raises(ValidationError, match=\"Element at index 1 is not a tuple.\"):\n        check_occurences([(1,2), \"a\"])\n\n    # List contains tuples of incorrect length\n    with pytest.raises(ValidationError, match=\"Tuple at index 0 must have exactly 2 elements.\"):\n        check_occurences([()])\n    with pytest.raises(ValidationError, match=\"Tuple at index 0 must have exactly 2 elements.\"):\n        check_occurences([(1,)])\n    with pytest.raises(ValidationError, match=\"Tuple at index 0 must have exactly 2 elements.\"):\n        check_occurences([(1, 2, 3)])\n    with pytest.raises(ValidationError, match=\"Tuple at index 1 must have exactly 2 elements.\"):\n        check_occurences([(1,2), (3,4,5)])\n\n    # List contains tuples with non-comparable elements\n    with pytest.raises(ValidationError, match=\"Elements within tuple at index 0 are not comparable.\"):\n        check_occurences([(1, \"a\")])\n    with pytest.raises(ValidationError, match=\"Elements within tuple at index 0 are not comparable.\"):\n        check_occurences([([], 1)]) # List is not comparable with int\n    with pytest.raises(ValidationError, match=\"Elements within tuple at index 0 are not comparable.\"):\n        check_occurences([({\"a\":1}, 2)]) # Dict is not comparable with int\n\ndef test_input_immutability():\n    \"\"\"Verifies that the input list and its contained tuples are not modified by the function.\n    Checks both the list's content and the identity of its tuple elements after execution.\n    \"\"\"\n    # Test case 1: Non-empty list\n    input_list = [(3, 1), (10, 5), (7, 2)]\n    \n    # Store the original state of the list and IDs of its tuple elements\n    original_list_state = list(input_list) \n    original_tuple_ids = [id(tup) for tup in input_list]\n\n    check_occurences(input_list)\n    \n    # Assert that the input list's content remains unchanged\n    assert input_list == original_list_state, \"Input list content was modified.\"\n    \n    # Assert that the tuple objects within the list were not replaced\n    current_tuple_ids = [id(tup) for tup in input_list]\n    assert current_tuple_ids == original_tuple_ids, \"Tuple objects within the input list were replaced or their identity changed.\"\n\n    # Test case 2: Empty list\n    empty_list = []\n    original_empty_list_state = list(empty_list) # Ensures the reference to empty_list isn't reassigned to a different list object\n    \n    result_empty = check_occurences(empty_list)\n    \n    assert empty_list == original_empty_list_state, \"Empty input list content was modified.\"\n    assert result_empty == {}, \"Empty list should return an empty dict.\"\n```"}
{"task_id": "Mbpp/237", "solution": "from typing import Any, List, Tuple, Dict\n\nclass InputList:\n    \"\"\"\n    Lightweight wrapper around the caller-provided list of 2-element tuples.\n    Provides safe, read-only access without modifying the original list.\n    \"\"\"\n    def __init__(self, tuples: List[Tuple[Any, Any]]) -> None:\n        self._tuples = tuples\n\n    def getTuples(self) -> List[Tuple[Any, Any]]:\n        \"\"\"\n        Returns a shallow copy of the list of tuples.\n        This prevents direct modification of the internal list by consumers.\n        \"\"\"\n        return list(self._tuples)\n\nclass TuplePair:\n    \"\"\"\n    Represents an input ordered pair (a, b).\n    Provides functionality to normalize itself into a NormalizedTuple.\n    \"\"\"\n    def __init__(self, a: Any, b: Any) -> None:\n        self.a = a\n        self.b = b\n\n    def normalize(self) -> 'NormalizedTuple':\n        \"\"\"\n        Normalizes the tuple by ordering its two elements non-decreasingly.\n        Returns a new NormalizedTuple instance with elements (min, max).\n        \"\"\"\n        return NormalizedTuple(min(self.a, self.b), max(self.a, self.b))\n\nclass NormalizedTuple:\n    \"\"\"\n    Immutable, hashable representation of (first <= second) used as dictionary keys.\n    Provides methods for comparison and hashing.\n    \"\"\"\n    def __init__(self, first: Any, second: Any) -> None:\n        self.first = first\n        self.second = second\n\n    def asTuple(self) -> Tuple[Any, Any]:\n        \"\"\"\n        Returns the normalized elements as a standard Python tuple.\n        This allows for straightforward use as a dictionary key.\n        \"\"\"\n        return (self.first, self.second)\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"\n        Compares this NormalizedTuple with another object for equality.\n        Equality is based on the values of 'first' and 'second' elements.\n        \"\"\"\n        # CRITICAL requirement: Do NOT add isinstance() checks. Trust caller's inputs.\n        return self.first == other.first and self.second == other.second # type: ignore [attr-defined]\n\n    def __hash__(self) -> int:\n        \"\"\"\n        Computes a hash value for the NormalizedTuple.\n        This enables NormalizedTuple instances to be used in hash-based collections.\n        \"\"\"\n        return hash((self.first, self.second))\n\nclass OccurrenceCounter:\n    \"\"\"\n    Aggregates counts of NormalizedTuple values from an InputList.\n    It produces a ResultDictionary containing the final counts.\n    \"\"\"\n    def __init__(self) -> None:\n        # Internal counts are keyed by builtin tuple for interop with ResultDictionary.\n        self._counts: Dict[Tuple[Any, Any], int] = {}\n\n    def count(self, input_list: 'InputList') -> 'ResultDictionary':\n        \"\"\"\n        Processes an InputList, normalizes each tuple, and aggregates their occurrences.\n        Returns a ResultDictionary built from the aggregated counts.\n        \"\"\"\n        for item_tuple in input_list.getTuples():\n            pair = TuplePair(item_tuple[0], item_tuple[1])\n            normalized = pair.normalize()\n            normalized_key = normalized.asTuple()\n            self._counts[normalized_key] = self._counts.get(normalized_key, 0) + 1\n        return ResultDictionary(self._counts)\n\nclass ResultDictionary:\n    \"\"\"\n    Wraps the final mapping of normalized tuples to counts.\n    Exposes methods for accessing specific counts and converting to a plain dictionary.\n    \"\"\"\n    def __init__(self, mapping: Dict[Tuple[Any, Any], int]) -> None:\n        self._map = mapping\n\n    def get(self, key: 'NormalizedTuple') -> int:\n        \"\"\"\n        Returns the count for a given NormalizedTuple key.\n        Returns 0 if the key is not found in the mapping.\n        \"\"\"\n        return self._map.get(key.asTuple(), 0)\n\n    def toDict(self) -> Dict[Tuple[Any, Any], int]:\n        \"\"\"\n        Returns a new plain dictionary mapping normalized builtin tuples to integer counts.\n        This provides a standard dictionary format for the caller.\n        \"\"\"\n        return dict(self._map)\n\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"\n    Normalizes 2-element tuples in an input list and counts their occurrences.\n    Returns a dictionary where keys are normalized tuples and values are their counts.\n    \"\"\"\n    il = InputList(input_list)\n    oc = OccurrenceCounter()\n    rd = oc.count(il)\n    return rd.toDict()"}
{"task_id": "Mbpp/238", "solution": "```python\nfrom typing import Any\n\n\"\"\"\nPublic API: number_of_substrings(s: str) -> int\nValidates input type and raises TypeError for non-string inputs.\n\"\"\"\n\nclass StringInput:\n    \"\"\"Encapsulates the input string and provides its length.\"\"\"\n    def __init__(self, s: str):\n        self.s = s\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.s)\n\nclass CalculationResult:\n    \"\"\"Holds the integer count result of substring calculation.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass SubstringCalculator:\n    \"\"\"\n    Validates input and computes the number of non-empty contiguous substrings.\n    Uses the formula n * (n + 1) // 2.\n    \"\"\"\n    @classmethod\n    def number_of_substrings(cls, s: str) -> int:\n        \"\"\"\n        Computes the count of non-empty contiguous substrings for a given string.\n        Raises TypeError if the input 's' is not a string.\n        \"\"\"\n        if not cls._validate_input(s):\n            raise TypeError(\"s must be a str\")\n\n        string_input = StringInput(s)\n        n = string_input.length()\n        count = cls._compute_by_formula(n)\n        \n        result = CalculationResult(count)\n        return result.count\n\n    @staticmethod\n    def _compute_by_formula(n: int) -> int:\n        \"\"\"Computes the sum of integers from 1 to n using the formula.\"\"\"\n        return n * (n + 1) // 2\n\n    @staticmethod\n    def _validate_input(s: object) -> bool:\n        \"\"\"Checks if the input is an instance of str.\"\"\"\n        return isinstance(s, str)\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"\n    Public API to count non-empty contiguous substrings in a string.\n    Delegates the computation and validation to SubstringCalculator.\n    \"\"\"\n    return SubstringCalculator.number_of_substrings(s)\n\n```"}
{"task_id": "Mbpp/239", "solution": "```python\n# src/__init__.py\n# Package marker for the src directory.\n\n```\n```python\n# src/models.py\nimport typing\n\nclass InputParameters:\n    \"\"\"Represents input parameters m and n for sequence generation.\"\"\"\n    def __init__(self, m: int, n: int) -> None:\n        self.m = m\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates that m and n are positive integers.\n        Raises ValueError if inputs are invalid as per BR1, BR8.\"\"\"\n        if not isinstance(self.m, int) or not isinstance(self.n, int):\n            raise ValueError(\"Inputs m and n must be integers.\")\n        if self.m <= 0 or self.n <= 0:\n            raise ValueError(\"Inputs m and n must be positive integers (m >= 1, n >= 1).\")\n\nclass Sequence:\n    \"\"\"Represents an ordered sequence of positive integers.\"\"\"\n    def __init__(self, elements: typing.List[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self.elements)\n\n    def is_valid_length(self, n: int) -> bool:\n        \"\"\"Checks if the sequence has the required length n.\"\"\"\n        return self.length() == n\n\nclass SequenceElement:\n    \"\"\"Represents a single element within a sequence.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass Result:\n    \"\"\"Encapsulates the count of valid sequences and optional metadata.\"\"\"\n    def __init__(self, count: int, metadata: typing.Optional[dict] = None) -> None:\n        self.count = count\n        self.metadata = metadata if metadata is not None else {}\n\n```\n```python\n# src/constraints.py\nimport abc\nimport typing\n\n# Forward declaration for type hinting to avoid circular imports\nif typing.TYPE_CHECKING:\n    from .models import Sequence\n\nclass Constraint(abc.ABC):\n    \"\"\"Abstract base class for sequence constraints.\"\"\"\n    @abc.abstractmethod\n    def is_satisfied(self, sequence: 'Sequence') -> bool:\n        \"\"\"Checks if the given sequence satisfies the constraint.\"\"\"\n        pass\n\nclass DoublingConstraint(Constraint):\n    \"\"\"Enforces the doubling constraint a_i >= 2 * a_{i-1} for i >= 2.\"\"\"\n    def is_satisfied(self, sequence: 'Sequence') -> bool:\n        \"\"\"Checks if elements in the sequence satisfy the doubling rule.\"\"\"\n        if len(sequence.elements) < 2:\n            return True # Constraint applies for the second element onwards.\n        \n        for i in range(1, len(sequence.elements)):\n            if sequence.elements[i] < 2 * sequence.elements[i-1]:\n                return False\n        return True\n\nclass UpperBoundConstraint(Constraint):\n    \"\"\"Enforces the upper bound constraint a_i <= m for all elements.\"\"\"\n    def __init__(self, m: int) -> None:\n        self.m = m\n\n    def is_satisfied(self, sequence: 'Sequence') -> bool:\n        \"\"\"Checks if all elements in the sequence are within the upper bound m.\"\"\"\n        for element_value in sequence.elements:\n            if element_value > self.m:\n                return False\n        return True\n\n```\n```python\n# src/sequence_counter.py\nimport typing\nfrom .models import Sequence\nfrom .constraints import DoublingConstraint, UpperBoundConstraint\n\nclass SequenceCounter:\n    \"\"\"Implements the core logic for counting valid sequences.\"\"\"\n    def __init__(self) -> None:\n        # Constraints are instantiated and passed dynamically due to dependency on 'm'.\n        pass\n\n    def countSequences(self, m: int, n: int) -> int:\n        \"\"\"Counts the total number of distinct ordered sequences.\n        Uses a backtracking approach to enumerate and count valid sequences.\"\"\"\n        total_count = [0] # Mutable list to allow recursive function to update the count.\n        \n        doubling_constraint = DoublingConstraint()\n        upper_bound_constraint = UpperBoundConstraint(m)\n        \n        self._count_recursive(m, n, [], doubling_constraint, upper_bound_constraint, total_count)\n        return total_count[0]\n\n    def _count_recursive(self,\n                        m: int, n: int,\n                        current_elements: typing.List[int],\n                        doubling_constraint: DoublingConstraint,\n                        upper_bound_constraint: UpperBoundConstraint,\n                        total_count: typing.List[int]) -> None:\n        \"\"\"Internal recursive helper to build sequences and count them.\"\"\"\n        # Base case: A valid sequence of length 'n' has been formed.\n        if len(current_elements) == n:\n            total_count[0] += 1\n            return\n\n        # Determine the minimum possible value for the next element based on the doubling constraint.\n        min_next_val = 1\n        if current_elements:\n            min_next_val = 2 * current_elements[-1]\n\n        # Iterate through possible values for the next element, up to the global upper bound 'm'.\n        for next_element_value in range(min_next_val, m + 1):\n            candidate_elements = current_elements + [next_element_value]\n            candidate_sequence = Sequence(candidate_elements)\n\n            # Check if the candidate sequence (with the new element) satisfies both constraints.\n            if doubling_constraint.is_satisfied(candidate_sequence) and \\\n               upper_bound_constraint.is_satisfied(candidate_sequence):\n                self._count_recursive(m, n, candidate_elements,\n                                      doubling_constraint, upper_bound_constraint, total_count)\n\n```\n```python\n# src/api.py\nfrom .models import InputParameters\nfrom .sequence_counter import SequenceCounter\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"Calculates the total number of valid sequences.\n    Validates inputs and delegates the counting operation to SequenceCounter.\"\"\"\n    params = InputParameters(m, n)\n    params.validate() # This method raises ValueError for non-integer or non-positive inputs.\n\n    counter = SequenceCounter()\n    result_count = counter.countSequences(m, n)\n    \n    return result_count\n\n```"}
