{"task_id": "Mbpp/125", "solution": "```python\n# src/errors.py\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input to the find_length function.\n    It carries a descriptive message about the validation failure.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n```\n```python\n# src/substring.py\nfrom typing import List\n\nclass Substring:\n    \"\"\"\n    Represents a non-empty contiguous substring of a binary string.\n    Provides methods to count '0's and '1's, and compute its score.\n    \"\"\"\n    def __init__(self, content: str, startIndex: int, endIndex: int):\n        self.content = content\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\n    def zeroCount(self) -> int:\n        \"\"\"Counts the number of '0' characters in the substring content.\"\"\"\n        return self.content.count('0')\n\n    def oneCount(self) -> int:\n        \"\"\"Counts the number of '1' characters in the substring content.\"\"\"\n        return self.content.count('1')\n\n    def score(self) -> int:\n        \"\"\"Computes the score as (number of '0's - number of '1's).\"\"\"\n        return self.zeroCount() - self.oneCount()\n\n```\n```python\n# src/binary_string.py\nfrom typing import List\nfrom src.substring import Substring\n\nclass BinaryString:\n    \"\"\"\n    Encapsulates a raw input string, provides validation,\n    and generates all non-empty contiguous Substring objects.\n    \"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.length = len(raw)\n\n    def validate(self) -> bool:\n        \"\"\"\n        Validates that the raw string is not empty and contains only '0' or '1' characters.\n        Returns True if valid, False otherwise.\n        \"\"\"\n        if self.length == 0:\n            return False\n        for char in self.raw:\n            if char not in ('0', '1'):\n                return False\n        return True\n\n    def substrings(self) -> List[Substring]:\n        \"\"\"\n        Generates and returns a list of all non-empty contiguous substrings.\n        Each substring is represented by a Substring object.\n        \"\"\"\n        substring_list: List[Substring] = []\n        for i in range(self.length):\n            for j in range(i, self.length):\n                sub_content = self.raw[i : j + 1]\n                substring_list.append(Substring(sub_content, i, j))\n        return substring_list\n\n```\n```python\n# src/finder.py\nfrom typing import List\nfrom src.errors import ValidationError\nfrom src.binary_string import BinaryString\nfrom src.substring import Substring\n\nclass Finder:\n    \"\"\"\n    Orchestrates input validation, substring generation and scoring,\n    and selection of the maximum score.\n    \"\"\"\n    def find_length(self, s: str) -> int:\n        \"\"\"\n        Computes the maximum (number_of_0s - number_of_1s) across all non-empty\n        contiguous substrings of a provided binary string.\n        \"\"\"\n        binary_string = BinaryString(s)\n\n        if not binary_string.validate():\n            raise ValidationError(\"Input string must not be empty and contain only '0' and '1'.\")\n\n        max_score = -float('inf')\n        all_substrings = binary_string.substrings()\n\n        for sub in all_substrings:\n            current_score = sub.score()\n            if current_score > max_score:\n                max_score = current_score\n        \n        return max_score\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Public API function to find the maximum (number_of_0s - number_of_1s)\n    across all non-empty contiguous substrings of a provided binary string.\n    It delegates the core logic to an instance of the Finder class.\n    \"\"\"\n    return Finder().find_length(s)\n\n```"}
{"task_id": "Mbpp/126", "solution": "```python\n\"\"\"\nThis module implements the sum function to find the sum of common positive divisors of two integers.\nIt also includes supporting domain types and a CommonDivisorsCalculator.\n\"\"\"\n\nclass InputNumbers:\n    \"\"\"Holds the input integers a and b.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\nclass Divisor:\n    \"\"\"Represents a single positive divisor.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Result:\n    \"\"\"Holds the integer sum of divisors.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass CommonDivisorsCalculator:\n    \"\"\"Computes common positive divisors and their sum for two integers.\"\"\"\n\n    def find_common_divisors(self, a: int, b: int) -> set:\n        \"\"\"\n        Returns a set of positive integers that evenly divide both a and b.\n        Divisors are searched from 1 up to min(abs(a), abs(b)).\n        \"\"\"\n        common_divisors = set()\n        min_abs = min(abs(a), abs(b))\n        \n        # As per design, edge-case behavior for zeros/negatives is based on min_abs search.\n        # If min_abs is 0, range(1, 1) is empty, yielding an empty set of divisors and sum of 0.\n        for d in range(1, min_abs + 1):\n            if a % d == 0 and b % d == 0:\n                common_divisors.add(d)\n        return common_divisors\n\n    def sum_common_divisors(self, a: int, b: int) -> int:\n        \"\"\"\n        Calculates the integer sum of all positive common divisors of a and b.\n        It uses find_common_divisors to get the set of divisors.\n        \"\"\"\n        divisors = self.find_common_divisors(a, b)\n        total_sum = sum(divisors)\n        # The design implies CommonDivisorsCalculator computes a Result object.\n        return Result(total_sum).value\n\nclass TestCase:\n    \"\"\"Documents a verification assertion for the sum function.\"\"\"\n    def __init__(self, assertion: str) -> None:\n        self.assertion = assertion\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Returns the integer sum of all positive integers that evenly divide both a and b.\n    This function shadows Python's built-in sum() as required by the design.\n    \"\"\"\n    # As per design, sum_module.py constructs InputNumbers, but it is not directly passed to the calculator.\n    # input_numbers = InputNumbers(a, b) \n    \n    calculator = CommonDivisorsCalculator()\n    return calculator.sum_common_divisors(a, b)\n\n# Verification assertion as specified in the design document.\n# Running this module will execute this assertion.\nassert sum(10, 15) == 6\n```"}
{"task_id": "Mbpp/124", "solution": "```python\nimport math\nfrom dataclasses import dataclass\nfrom typing import Union, Any\n\nclass InputValidator:\n    \"\"\"Validates inputs for numeric or complex types.\n    Raises TypeError or ValueError for invalid inputs as per BR6.\n    \"\"\"\n    @staticmethod\n    def validate(real: Any, imag: Any) -> bool:\n        \"\"\"Checks if inputs are valid numeric types (int, float, complex).\n        Raises TypeError for unsupported types.\n        \"\"\"\n        valid_types = (int, float, complex)\n        if not isinstance(real, valid_types):\n            raise TypeError(f\"Invalid type for real component: {type(real)}. Expected int, float, or complex.\")\n        if not isinstance(imag, valid_types):\n            raise TypeError(f\"Invalid type for imaginary component: {type(imag)}. Expected int, float, or complex.\")\n        return True\n\nclass MathLibrary:\n    \"\"\"Thin wrapper around Python's math.atan2 to centralize the dependency.\"\"\"\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        \"\"\"Computes the arctangent of y/x, handling quadrants correctly.\"\"\"\n        return math.atan2(y, x)\n\n@dataclass(frozen=True)\nclass ComplexNumber:\n    \"\"\"Immutable data holder for complex number components.\"\"\"\n    real: float\n    imag: float\n\ndef _normalize_to_complex(real: Union[int, float, complex], imag: Union[int, float, complex]) -> ComplexNumber:\n    \"\"\"Normalizes real and imag components into a ComplexNumber instance.\n    Handles Python complex types deterministically by composing real/imag parts.\n    \"\"\"\n    # Design's normalization rule:\n    # real_part = (real.real if isinstance(real, complex) else real) + (imag.real if isinstance(imag, complex) else 0)\n    # imag_part = (imag.imag if isinstance(imag, complex) else imag) + (real.imag if isinstance(real, complex) else 0)\n\n    # Initialize parts based on non-complex values or real/imag parts of complex values.\n    normalized_real_component = real.real if isinstance(real, complex) else float(real)\n    normalized_imag_component = imag.imag if isinstance(imag, complex) else float(imag)\n\n    # Add cross-component real/imaginary parts if applicable.\n    real_sum = normalized_real_component + (imag.real if isinstance(imag, complex) else 0.0)\n    imag_sum = normalized_imag_component + (real.imag if isinstance(real, complex) else 0.0)\n\n    return ComplexNumber(real=real_sum, imag=imag_sum)\n\ndef angle_complex(real: Union[int, float, complex], imag: Union[int, float, complex]) -> float:\n    \"\"\"Computes the argument (angle) of a complex number and returns it in radians.\n    It validates inputs, normalizes them, and delegates trigonometric computation.\n    \"\"\"\n    InputValidator.validate(real, imag)\n    complex_num = _normalize_to_complex(real, imag)\n    return MathLibrary.atan2(complex_num.imag, complex_num.real)\n```"}
{"task_id": "Mbpp/126", "solution": "```python\ndef sum(a, b):\n    \"\"\"\n    Computes the sum of unique positive common divisors of a and b.\n    It uses absolute values for divisor enumeration and computation.\n    \"\"\"\n    A = abs(a)\n    B = abs(b)\n    \n    common_divisors = set()\n    \n    # Iterate from 1 up to the minimum of the absolute values.\n    # This loop correctly handles cases where A or B is 0, resulting in an empty set.\n    for d in range(1, min(A, B) + 1):\n        if A % d == 0 and B % d == 0:\n            common_divisors.add(d)\n            \n    return sum(common_divisors)\n```"}
