{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Set\n\ndef _normalize_tuple(t: Tuple) -> Tuple:\n    \"\"\"Returns a deterministic, unordered key for a 2-element tuple.\"\"\"\n    return tuple(sorted(t))\n\ndef tuple_intersection(listA: List[Tuple], listB: List[Tuple]) -> Set[Tuple]:\n    \"\"\"\n    Computes the order-insensitive intersection of two lists of 2-element tuples.\n    Returns a set of tuples from listA that match listB order-insensitively, preserving original tuple order.\n    \"\"\"\n    normalized_keys_B = {_normalize_tuple(b) for b in listB}\n    result_set: Set[Tuple] = set()\n    for t in listA:\n        if _normalize_tuple(t) in normalized_keys_B:\n            result_set.add(t)\n    return result_set"}
{"task_id": "Mbpp/473", "solution": "```python\nfrom typing import List, Set, Tuple as PyTuple, Any\n\ndef _as_unordered_key(t: PyTuple[Any, ...]) -> frozenset:\n    \"\"\"Converts a tuple into a frozenset of its elements for unordered comparison.\"\"\"\n    return frozenset(t)\n\ndef _build_unordered_keys(listB: List[PyTuple[Any, ...]]) -> Set[frozenset]:\n    \"\"\"Builds a set of frozenset keys representing tuples in listB for O(1) membership tests.\"\"\"\n    keysB = set()\n    for tuple_b in listB:\n        keysB.add(_as_unordered_key(tuple_b))\n    return keysB\n\ndef tuple_intersection(listA: List[PyTuple[Any, ...]], listB: List[PyTuple[Any, ...]]) -> Set[PyTuple[Any, ...]]:\n    \"\"\"\n    Returns a set of tuples from listA whose elements match (unordered) elements of any tuple in listB.\n    Preserves tuple representation from listA and removes duplicates via set semantics.\n    \"\"\"\n    result_set = set()\n    keysB = _build_unordered_keys(listB)\n\n    for tuple_a in listA:\n        key_a = _as_unordered_key(tuple_a)\n        if key_a in keysB:\n            result_set.add(tuple_a)\n\n    return result_set\n```"}
{"task_id": "Mbpp/475", "solution": "```python\nfrom typing import Dict, List, Tuple\n\ndef sort_counter(input_dict: Dict[str,int]) -> List[Tuple[str,int]]:\n    \"\"\"\n    Sorts a dictionary by value in descending order, with ties broken by key in ascending order.\n    Assumes valid input dictionary where keys are strings and values are integers.\n    \"\"\"\n    # Convert dictionary items to a list of (key, value) tuples\n    # Sort them by value (descending, hence -value) then by key (ascending)\n    return sorted(input_dict.items(), key=lambda item: (-item[1], item[0]))\n```"}
{"task_id": "Mbpp/475", "solution": "from typing import Dict, List, Tuple, Any\n\ndef sort_counter(input_dict: Dict[Any, float]) -> List[Tuple[Any, float]]:\n    \"\"\"\n    Sorts a dictionary by its values in descending order.\n    Returns a list of (key, value) tuples.\n    \"\"\"\n    items = list(input_dict.items())\n    sorted_items = sorted(items, key=lambda kv: kv[1], reverse=True)\n    return sorted_items"}
{"task_id": "Mbpp/476", "solution": "```python\ndef _validate_input(input_list):\n    \"\"\"\n    Validates the input list for emptiness and non-numeric elements.\n    Raises ValueError for empty input or TypeError for non-numeric elements.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n    for item in input_list:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the input list must be numeric (int or float).\")\n\ndef _compute_min_max(input_list):\n    \"\"\"\n    Computes the smallest and largest numeric values from the list.\n    For single-element lists, the element is treated as both min and max.\n    \"\"\"\n    if len(input_list) == 1:\n        value = input_list[0]\n        return (value, value)\n    return (min(input_list), max(input_list))\n\ndef big_sum(input_list):\n    \"\"\"\n    Calculates the sum of the smallest and largest numeric values in a list.\n    Handles validation for empty or non-numeric inputs as specified.\n    \"\"\"\n    _validate_input(input_list)\n    min_val, max_val = _compute_min_max(input_list)\n    return min_val + max_val\n```"}
{"task_id": "Mbpp/474", "solution": "```python\n# src/__init__.py\n\"\"\"Package marker for src.\"\"\"\n\nfrom .replace_module import replace_char\n\n# src/domain.py\n\"\"\"Domain model classes for character replacement operation.\"\"\"\n\nclass InputString:\n    \"\"\"A lightweight container for the input string value.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass Character:\n    \"\"\"A lightweight container enforcing single-character constraint.\"\"\"\n    def __init__(self, value: str):\n        # Enforce single-character constraint as per design\n        if len(value) != 1:\n            raise ValueError(\"Character value must be a single string character.\")\n        self.value = value\n\nclass ReplacementResult:\n    \"\"\"Represents the resulting string and whether a change occurred.\"\"\"\n    def __init__(self, value: str, was_changed: bool):\n        self.value = value\n        self.was_changed = was_changed\n\n# src/replace_module.py\n\"\"\"ReplaceCharFunction class and top-level replace_char function (entry API).\"\"\"\n\nfrom .domain import InputString, Character, ReplacementResult\n\nclass ReplaceCharFunction:\n    \"\"\"Validates parameters and performs deterministic, single-character replacement.\"\"\"\n\n    def replace(self, input_string: str, old_char: str, new_char: str) -> str:\n        \"\"\"\n        Replaces all occurrences of old_char with new_char in input_string.\n        Raises ValueError for invalid parameters.\n        \"\"\"\n        # Validate parameters (BR6) - type checks\n        if not isinstance(input_string, str):\n            raise ValueError(\"input_string must be a string.\")\n        if not isinstance(old_char, str):\n            raise ValueError(\"old_char must be a string.\")\n        if not isinstance(new_char, str):\n            raise ValueError(\"new_char must be a string.\")\n\n        try:\n            # Domain object construction, Character.__init__ validates length\n            old_char_obj = Character(old_char)\n            new_char_obj = Character(new_char)\n            input_string_obj = InputString(input_string)\n        except ValueError as e:\n            # Re-raise Character's ValueError as a general parameter error (BR6)\n            raise ValueError(f\"Parameter error: {e}\") from e\n\n        # Perform replacement logic (FR2, FR3, BR2, BR3, BR7)\n        result_chars = []\n        was_changed = False\n        for char in input_string_obj.value:\n            if char == old_char_obj.value:\n                result_chars.append(new_char_obj.value)\n                was_changed = True\n            else:\n                result_chars.append(char)\n\n        final_string = \"\".join(result_chars)\n\n        # Construct ReplacementResult (FR4, BR7)\n        # Even if no change, a new string instance is returned per BR7.\n        replacement_result = ReplacementResult(final_string, was_changed)\n        return replacement_result.value\n\ndef replace_char(input_string: str, old_char: str, new_char: str) -> str:\n    \"\"\"\n    Public API: Replaces all occurrences of old_char with new_char in input_string.\n    Delegates to ReplaceCharFunction.replace for implementation.\n    \"\"\"\n    return ReplaceCharFunction().replace(input_string, old_char, new_char)\n\n# tests/test_replace_char.py\n\"\"\"Unit tests and verification assertions for the replace_char API.\"\"\"\n\nimport pytest\nfrom src.replace_module import replace_char\n\ndef test_replace_char_basic():\n    \"\"\"Tests basic replacement functionality.\"\"\"\n    assert replace_char(\"hello\", 'l', 'x') == \"hexxo\"\n\ndef test_replace_char_multiple():\n    \"\"\"Tests replacement of multiple occurrences.\"\"\"\n    assert replace_char(\"banana\", 'a', 'o') == \"bonono\"\n\ndef test_replace_char_noop():\n    \"\"\"Tests when the old_char does not occur, returning the original string.\"\"\"\n    assert replace_char(\"test\", 'z', 'x') == \"test\"\n\ndef test_replace_char_empty_string():\n    \"\"\"Tests replacement in an empty input string.\"\"\"\n    assert replace_char(\"\", 'a', 'b') == \"\"\n\ndef test_replace_char_all_chars_replaced():\n    \"\"\"Tests when all characters in the string are replaced.\"\"\"\n    assert replace_char(\"aaaaa\", 'a', 'b') == \"bbbbb\"\n\ndef test_replace_char_same_char():\n    \"\"\"Tests when old_char and new_char are the same.\"\"\"\n    assert replace_char(\"apple\", 'p', 'p') == \"apple\"\n\ndef test_replace_char_case_sensitivity():\n    \"\"\"Tests case sensitivity of character replacement.\"\"\"\n    assert replace_char(\"Apple\", 'a', 'p') == \"Apple\"\n    assert replace_char(\"Apple\", 'A', 'p') == \"ppple\"\n\ndef test_replace_char_validation_error_input_string_type():\n    \"\"\"Tests parameter validation for input_string type.\"\"\"\n    with pytest.raises(ValueError, match=\"input_string must be a string.\"):\n        replace_char(123, 'a', 'b') # type: ignore\n\ndef test_replace_char_validation_error_old_char_type():\n    \"\"\"Tests parameter validation for old_char type.\"\"\"\n    with pytest.raises(ValueError, match=\"old_char must be a string.\"):\n        replace_char(\"test\", 1, 'b') # type: ignore\n\ndef test_replace_char_validation_error_new_char_type():\n    \"\"\"Tests parameter validation for new_char type.\"\"\"\n    with pytest.raises(ValueError, match=\"new_char must be a string.\"):\n        replace_char(\"test\", 'a', 2) # type: ignore\n\ndef test_replace_char_validation_error_old_char_length():\n    \"\"\"Tests parameter validation for old_char length.\"\"\"\n    with pytest.raises(ValueError, match=\"Parameter error: Character value must be a single string character.\"):\n        replace_char(\"test\", \"ab\", 'c')\n\ndef test_replace_char_validation_error_new_char_length():\n    \"\"\"Tests parameter validation for new_char length.\"\"\"\n    with pytest.raises(ValueError, match=\"Parameter error: Character value must be a single string character.\"):\n        replace_char(\"test\", 'a', \"bc\")\n\ndef test_replace_char_canonical_assertion():\n    \"\"\"Verifies the canonical assertion: replace_char(\"polygon\", 'y', 'l') == \"pollgon\" (FR5).\"\"\"\n    assert replace_char(\"polygon\", 'y', 'l') == \"pollgon\"\n```"}
