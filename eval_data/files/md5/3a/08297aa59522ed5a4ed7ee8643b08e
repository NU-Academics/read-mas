{"task_id": "Mbpp/70", "solution": "```python\n# src/get_equal.py\nfrom typing import List, Tuple as PyTuple\n\nclass Tuple:\n    \"\"\"Minimal value object representing a tuple's metadata (length).\"\"\"\n    def __init__(self, length: int) -> None:\n        self.length = length\n\nclass Result:\n    \"\"\"Wraps the boolean outcome of the equality check.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\nclass TupleCollection:\n    \"\"\"Encapsulate the input collection of tuples and compute integer lengths for each tuple.\"\"\"\n    def __init__(self, tuples: List[tuple]) -> None:\n        self.tuples = tuples\n\n    def get_lengths(self) -> List[int]:\n        \"\"\"Computes and returns a list of lengths for each tuple in the collection.\"\"\"\n        lengths = []\n        for t in self.tuples:\n            tuple_metadata = Tuple(len(t))\n            lengths.append(tuple_metadata.length)\n        return lengths\n\ndef get_equal(collection) -> bool:\n    \"\"\"\n    Accept a single argument 'collection' (expected: sequence of tuples) and return True if\n    all tuples have equal length; otherwise False.\n    \"\"\"\n    tc = TupleCollection(collection)\n    lengths = tc.get_lengths()\n\n    if not lengths:\n        all_equal = True # An empty collection trivially has all tuples of \"equal\" length.\n    else:\n        first_length = lengths[0]\n        all_equal = all(length == first_length for length in lengths)\n\n    result = Result(all_equal)\n    return result.value\n\n```\n```python\n# tests/test_get_equal.py\nfrom src.get_equal import get_equal\n\ndef test_example_assert():\n    \"\"\"Unit test for the positive example from the SRS.\"\"\"\n    assert get_equal([(11, 22, 33), (44, 55, 66)]) == True\n\n```"}
{"task_id": "Mbpp/71", "solution": "```python\ndef comb_sort(lst: list) -> list:\n    \"\"\"Return a new list containing the elements of lst sorted in ascending order using comb sort.\n    It uses a gap shrink factor of 1.3.\"\"\"\n    \n    arr = list(lst)  # Create a shallow copy to not mutate the input list.\n    n = len(arr)\n    \n    gap = n\n    shrink_factor = 1.3\n    \n    swapped = True # Initialize swapped flag for the first pass\n    \n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n        \n        swapped = False\n        \n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n                \n    return arr\n```"}
{"task_id": "Mbpp/71", "solution": "```python\nfrom typing import List as TypingList, Any\n\nclass CombSort:\n    \"\"\"Encapsulates the comb sort algorithm logic.\"\"\"\n\n    def __init__(self, shrinkFactor: float = 1.3):\n        \"\"\"Initializes the CombSort instance with a shrink factor.\"\"\"\n        self.shrinkFactor: float = shrinkFactor\n\n    def comb_sort(self, list: TypingList[Any]) -> TypingList[Any]:\n        \"\"\"Performs comb sort on a copy of the input list and returns the sorted list.\"\"\"\n        n = len(list)\n        if n <= 1:\n            return list[:] # Return a shallow copy for consistency\n\n        arr = list[:] # Work on a copy to avoid modifying original\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            if gap > 1:\n                gap = self.computeNextGap(gap)\n\n            swapped = False\n            for i in range(n - gap):\n                # The compareAndSwap method performs the comparison and swap if needed.\n                # It returns True if a swap occurred, which updates the 'swapped' flag.\n                if self.compareAndSwap(arr, i, i + gap):\n                    swapped = True\n        return arr\n\n    def computeNextGap(self, currentGap: int) -> int:\n        \"\"\"Computes the next gap size using the shrink factor, ensuring it's at least 1.\"\"\"\n        next_gap = int(currentGap / self.shrinkFactor)\n        return max(1, next_gap) # Gap must be at least 1\n\n    def compareAndSwap(self, list: TypingList[Any], i: int, j: int) -> bool:\n        \"\"\"Compares elements at indices i and j and swaps them if out of order.\n        Returns True if a swap occurred, False otherwise.\n        \"\"\"\n        if list[i] > list[j]:\n            list[i], list[j] = list[j], list[i]\n            return True\n        return False\n\n\ndef comb_sort(list: TypingList[Any]) -> TypingList[Any]:\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\n    This public API delegates the sorting operation to an internal CombSort instance.\n    \"\"\"\n    sorter = CombSort()\n    return sorter.comb_sort(list)\n```"}
