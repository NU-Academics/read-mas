{"task_id": "Mbpp/91", "solution": "```python\nfrom typing import List, Iterator, Optional\n\nclass StringItem:\n    \"\"\"Simple container for a single string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass StringList:\n    \"\"\"Minimal wrapper for a list of StringItem; supports adding and iteration.\"\"\"\n    def __init__(self, items: Optional[List['StringItem']] = None) -> None:\n        self.items: List[StringItem] = items if items is not None else []\n\n    def add(self, item: 'StringItem') -> None:\n        self.items.append(item)\n\n    def iterator(self) -> Iterator['StringItem']:\n        return iter(self.items)\n\nclass Result:\n    \"\"\"Container for boolean outcome of a search operation.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\nclass FindSubstring:\n    \"\"\"Encapsulates the search operation and exposes execute() to run the search.\"\"\"\n    def __init__(self, list_of_strings: List[str], query: str) -> None:\n        self.list_of_strings = list_of_strings\n        self.query = query\n\n    def execute(self) -> bool:\n        \"\"\"Executes the search operation to find the substring.\"\"\"\n        for s in self.list_of_strings:\n            if self.query in s:\n                _ = Result(True) # Create Result object as per design's sequence diagram\n                return True\n        _ = Result(False) # Create Result object as per design's sequence diagram\n        return False\n\ndef find_substring(list_of_strings: List[str], query: str) -> bool:\n    \"\"\"\n    Returns True if query occurs as a substring in at least one element,\n    otherwise False. This is the public API function.\n    \"\"\"\n    finder = FindSubstring(list_of_strings, query)\n    return finder.execute()\n```"}
{"task_id": "Mbpp/93", "solution": "```python\n# src/power_module.py\n\nclass PowerFunction:\n    \"\"\"\n    Responsibility: Compute numeric exponentiation a^b.\n    \"\"\"\n    def compute(self, a, b) -> float:\n        \"\"\"Returns 'a' raised to the power of 'b'.\"\"\"\n        return a ** b\n\nclass PowerModule:\n    \"\"\"\n    Responsibility: Provide the public API method power(a, b)\n    that delegates to PowerFunction.compute.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the power computation engine.\"\"\"\n        self._engine = PowerFunction()\n\n    def power(self, a, b) -> float:\n        \"\"\"Computes 'a' raised to the power of 'b' using the internal engine.\"\"\"\n        return self._engine.compute(a, b)\n\ndef power(a, b) -> float:\n    \"\"\"\n    Module-level convenience wrapper for the power API.\n    Delegates the computation to an instance of PowerModule.\n    \"\"\"\n    module_api = PowerModule()\n    return module_api.power(a, b)\n\n```\n```python\n# tests/test_power.py\n\nfrom src.power_module import power\n\nclass UnitTest:\n    \"\"\"\n    Responsibility: Execute the test case asserting power(3,4) == 81\n    and report pass/fail.\n    \"\"\"\n    def run(self) -> bool:\n        \"\"\"\n        Executes the specified unit test case.\n        Returns True on success, False on failure.\n        \"\"\"\n        print(\"Running power function unit test...\")\n        a, b, expected = 3, 4, 81\n        actual = power(a, b)\n        \n        try:\n            self.assertEqual(actual, expected)\n            print(f\"Test passed: power({a},{b}) == {actual} (expected: {expected})\")\n            return True\n        except AssertionError as e:\n            print(f\"Test failed: {e}\")\n            return False\n\n    def assertEqual(self, actual, expected):\n        \"\"\"\n        Asserts that actual equals expected, raising an AssertionError if they differ.\n        \"\"\"\n        if actual != expected:\n            raise AssertionError(f\"Assertion Failed: Expected {expected}, got {actual}\")\n\nif __name__ == '__main__':\n    \"\"\"\n    Main runner to invoke the UnitTest.\n    Prints whether the test passed or failed.\n    \"\"\"\n    test_runner = UnitTest()\n    if test_runner.run():\n        print(\"All tests passed!\")\n    else:\n        print(\"One or more tests failed.\")\n\n```"}
{"task_id": "Mbpp/92", "solution": "```python\nfrom typing import List\n\nclass NumberInput:\n    \"\"\"Represents the integer input value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass DigitSequence:\n    \"\"\"Ordered decimal digits extracted from NumberInput.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the count of digits in the sequence.\"\"\"\n        return len(self.digits)\n\nclass ValidationResult:\n    \"\"\"Result of input validation, indicating validity and an optional reason.\"\"\"\n    def __init__(self, is_valid: bool, reason: str = \"\") -> None:\n        self.is_valid = is_valid\n        self.reason = reason\n\nclass UndulationChecker:\n    \"\"\"Stateless class encapsulating logic for undulation checking.\"\"\"\n    \n    def is_undulating(self, number: int) -> bool:\n        \"\"\"Determines if a number's decimal digits strictly alternate between two distinct digits.\"\"\"\n        if not isinstance(number, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        digits = self.extract_digits(number)\n        return self.check_alternation(digits)\n\n    def extract_digits(self, number: int) -> List[int]:\n        \"\"\"Extracts decimal digits from the absolute value of the number, most-significant first.\"\"\"\n        abs_number = abs(number)\n        if abs_number == 0:\n            return [0]\n        \n        digits = []\n        temp_num = abs_number\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        return digits[::-1]\n\n    def check_alternation(self, digits: List[int]) -> bool:\n        \"\"\"Checks if digits strictly alternate between exactly two distinct digits.\"\"\"\n        num_digits = len(digits)\n        \n        if num_digits < 2:  # Single-digit numbers are not undulating.\n            return False\n            \n        if digits[0] == digits[1]:  # The first two digits must be distinct.\n            return False\n\n        digit1 = digits[0]\n        digit2 = digits[1]\n        \n        for i in range(num_digits):\n            expected_digit = digit1 if i % 2 == 0 else digit2\n            if digits[i] != expected_digit:\n                return False\n        \n        return True\n\n_checker = UndulationChecker()\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"Checks if the provided integer's decimal digits strictly alternate between two distinct digits.\"\"\"\n    return _checker.is_undulating(number)\n```"}
