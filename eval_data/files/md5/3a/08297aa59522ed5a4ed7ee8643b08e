{"task_id": "Mbpp/804", "solution": "To implement the software design specification, the code will be structured into three files as described.\n\n```python\n# src/domain.py\n\"\"\"Domain module for product evenness check.\n\nContains classes representing numbers and boolean results.\n\"\"\"\n\nclass NumberList:\n    \"\"\"Represents a list of integers.\"\"\"\n    def __init__(self, numbers: list[int]) -> None:\n        self.numbers = numbers\n\nclass IntegerElement:\n    \"\"\"Wraps an integer and provides parity check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the integer element is even.\"\"\"\n        return self.value % 2 == 0\n\nclass BooleanResult:\n    \"\"\"Wraps a boolean result value.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\n```\n```python\n# src/is_product_even.py\n\"\"\"Implementation for checking if a product of numbers is even.\n\nIncludes the core logic and the public API function.\n\"\"\"\n\nfrom src.domain import NumberList, IntegerElement, BooleanResult\n\nclass IsProductEvenFunction:\n    \"\"\"Determines if the product of elements in a list is even.\"\"\"\n    def is_product_even(self, numbers: list[int]) -> bool:\n        \"\"\"Checks if any number in the list is even.\n\n        It delegates to IntegerElement for parity checks.\n        \"\"\"\n        number_list_obj = NumberList(numbers)\n        for num in number_list_obj.numbers:\n            element = IntegerElement(num)\n            if element.is_even():\n                return BooleanResult(True).value\n        return BooleanResult(False).value\n\ndef is_product_even(numbers: list[int]) -> bool:\n    \"\"\"Public API function to check if the product of numbers is even.\n\n    It delegates the actual logic to IsProductEvenFunction.\n    \"\"\"\n    return IsProductEvenFunction().is_product_even(numbers)\n\n```\n```python\n# tests/test_is_product_even.py\n\"\"\"Unit test for the is_product_even function.\n\nContains the required acceptance test.\n\"\"\"\n\nfrom src.is_product_even import is_product_even\n\ndef test_assert_is_product_even() -> None:\n    \"\"\"Tests the is_product_even function with a specific case.\"\"\"\n    assert is_product_even([1,2,3]) == True\n\n```"}
{"task_id": "Mbpp/805", "solution": "```python\n# src/models.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass Sublist:\n    \"\"\"Represents an inner list of numbers from the domain model.\"\"\"\n    elements: list[int | float]\n\n    def sum(self) -> float:\n        \"\"\"Returns the sum of all numeric elements in this sublist.\"\"\"\n        return sum(self.elements)\n\n@dataclass\nclass ListOfLists:\n    \"\"\"Represents a collection of Sublist instances from the domain model.\"\"\"\n    sublists: list[Sublist]\n\n```\n```python\n# src/max_sum_list.py\ndef max_sum_list(list_of_lists: list[list[float] | list[int]]) -> list[float] | list[int] | None:\n    \"\"\"Return the sublist (an element from list_of_lists) whose sum of numeric elements is highest.\n    If list_of_lists is empty, returns None.\n    \"\"\"\n    if not list_of_lists:\n        return None\n\n    max_sum_val = float('-inf')\n    max_sublist_ref = None\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum_val:\n            max_sum_val = current_sum\n            max_sublist_ref = sublist\n            \n    return max_sublist_ref\n\n```\n```python\n# src/__init__.py\nfrom .max_sum_list import max_sum_list\n\n__all__ = [\"max_sum_list\"]\n\n```\n```python\n# tests/test_max_sum_list.py\nfrom src.max_sum_list import max_sum_list\n\ndef test_provided_vector():\n    \"\"\"Verify the function correctly identifies the sublist with the maximum sum as per the requirement.\"\"\"\n    assert max_sum_list([[1,2,3], [4,5,6], [10,11,12], [7,8,9]]) == [10, 11, 12]\n\n```"}
{"task_id": "Mbpp/805", "solution": "```python\n# src/max_sum_list.py\ndef max_sum_list(listOfLists: list) -> list:\n    \"\"\"Return the sublist from listOfLists whose arithmetic sum of elements is highest.\n\n    Preconditions:\n      - listOfLists must be a non-empty list (or iterable) of sublists (iterables) of integers.\n\n    Behavior:\n      - If listOfLists is empty, raise ValueError(\"listOfLists must be a non-empty list of sublists\").\n      - Empty sublists are summed as 0 (Python sum semantics).\n      - If multiple sublists tie for highest sum, return the first encountered maximal sublist.\n\n    Returns:\n      - A reference to one of the sublists provided in listOfLists (the one with highest sum).\n    \"\"\"\n    if not listOfLists:\n        raise ValueError(\"listOfLists must be a non-empty list of sublists\")\n    return max(listOfLists, key=sum)\n\n```\n\n```python\n# tests/test_max_sum_list.py\nfrom src.max_sum_list import max_sum_list\n\ndef run_assert_example() -> None:\n    example = [[1,2,3], [4,5,6], [10,11,12], [7,8,9]]\n    assert max_sum_list(example) == [10,11,12]\n\ndef main() -> None:\n    try:\n        run_assert_example()\n        print(\"PASS: example assert succeeded\")\n    except AssertionError:\n        print(\"FAIL: example assert failed\")\n        raise\n\nif __name__ == '__main__':\n    main()\n\n```"}
