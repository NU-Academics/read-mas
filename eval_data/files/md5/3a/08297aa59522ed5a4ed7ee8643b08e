{"task_id": "Mbpp/410", "solution": "```python\ndef _is_numeric(value) -> bool:\n    \"\"\"Classifies a value as numeric if it's an int or float and not NaN.\"\"\"\n    # Check if the value is an int or a float.\n    if isinstance(value, (int, float)):\n        # If it's a float, ensure it's not NaN by checking value == value.\n        # NaN is the only float where value != value is true.\n        return value == value\n    return False\n\ndef _to_number(value) -> (int | float):\n    \"\"\"Canonicalizes numeric input (ints and floats) for comparison.\"\"\"\n    # For Python, ints and floats are directly comparable without explicit conversion.\n    return value\n\ndef min_val(items: list) -> (int | float):\n    \"\"\"Finds the smallest numeric value in a heterogeneous list, ignoring non-numeric elements.\"\"\"\n    numeric_values = []\n    # Iterate through items, filtering for numeric values using the helper.\n    for item in items:\n        if _is_numeric(item):\n            numeric_values.append(_to_number(item))\n\n    # If no numeric values are found, raise a ValueError as per specification.\n    if not numeric_values:\n        raise ValueError(\"no numeric elements provided\")\n\n    # Return the minimum of the collected numeric values.\n    return min(numeric_values)\n```"}
{"task_id": "Mbpp/410", "solution": "```python\nfrom typing import Any, List\nimport math\n\nclass ListInput:\n    \"\"\"Wraps a raw list, validates input, and stores Element wrappers.\"\"\"\n    def __init__(self, raw_list: list) -> None:\n        if not isinstance(raw_list, list):\n            raise TypeError(\"Input must be a list.\")\n        self.elements: List['Element'] = [Element(item) for item in raw_list]\n\n    def get_elements(self) -> List['Element']:\n        \"\"\"Returns the list of Element wrappers.\"\"\"\n        return self.elements\n\nclass Element:\n    \"\"\"Stores a raw value and provides numeric detection and conversion.\"\"\"\n    def __init__(self, raw_value: Any) -> None:\n        self.raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the raw value is a valid numeric type (int/float, not NaN).\"\"\"\n        if isinstance(self.raw_value, (int, float)):\n            return not (isinstance(self.raw_value, float) and math.isnan(self.raw_value))\n        return False\n\n    def as_number(self) -> Any:\n        \"\"\"Returns the numeric value or raises TypeError if not numeric.\"\"\"\n        if not self.is_numeric():\n            raise TypeError(f\"Value '{self.raw_value}' is not a valid number.\")\n        return self.raw_value\n\nclass NumericElement:\n    \"\"\"A wrapper for a validated numeric value.\"\"\"\n    def __init__(self, numeric_value: Any) -> None:\n        self.numeric_value = numeric_value\n\n    def value(self) -> Any:\n        \"\"\"Returns the stored numeric value.\"\"\"\n        return self.numeric_value\n\nclass MinValueCalculator:\n    \"\"\"Performs filtering, minimum computation, and error handling.\"\"\"\n    def min_val(self, list_input: ListInput) -> Any:\n        \"\"\"Processes the ListInput to find the smallest numeric value.\"\"\"\n        elements = list_input.get_elements()\n        numeric_elements = self.filter_numeric(elements)\n\n        if not numeric_elements:\n            raise ValueError(\"no numeric elements found\")\n\n        min_val_result = self.compute_min(numeric_elements)\n        return Result(min_val_result).to_number()\n\n    def filter_numeric(self, elements: List[Element]) -> List[NumericElement]:\n        \"\"\"Filters elements, keeping only valid numeric ones as NumericElement instances.\"\"\"\n        filtered_list = []\n        for element in elements:\n            if element.is_numeric():\n                filtered_list.append(NumericElement(element.as_number()))\n        return filtered_list\n\n    def compute_min(self, numeric_elements: List[NumericElement]) -> Any:\n        \"\"\"Computes the smallest numeric value from a list of NumericElement instances.\"\"\"\n        values = [ne.value() for ne in numeric_elements]\n        return min(values)\n\nclass Result:\n    \"\"\"Wraps the computed minimum value for consistent output.\"\"\"\n    def __init__(self, min_value: Any) -> None:\n        self.min_value = min_value\n\n    def to_number(self) -> Any:\n        \"\"\"Returns the wrapped minimum value.\"\"\"\n        return self.min_value\n\ndef min_val(list_input: List) -> Any:\n    \"\"\"\n    Public API. Accepts a single list argument and returns smallest numeric value\n    or raises ValueError if none found.\n    \"\"\"\n    list_wrapper = ListInput(list_input)\n    calculator = MinValueCalculator()\n    return calculator.min_val(list_wrapper)\n\n# Example usage:\n# >>> # Assuming this file is src/min_val.py and imported correctly\n# >>> # from src.min_val import min_val\n# >>> # min_val(['Python', 3, 2, 4, 5, 'version'])\n# >>> # 2\n```"}
{"task_id": "Mbpp/409", "solution": "```python\n# src/__init__.py\nfrom .min_product import min_product_tuple\n\n```\n```python\n# src/models.py\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    \"\"\"Represents a list of tuples for product calculation.\"\"\"\n    tuples: list\n\n\n@dataclass\nclass Tuple:\n    \"\"\"Domain representation of a two-element integer pair.\"\"\"\n    a: int\n    b: int\n\n    def product(self) -> int:\n        \"\"\"Computes the product of a and b.\"\"\"\n        return self.a * self.b\n\n\n@dataclass\nclass Product:\n    \"\"\"Holder for a single product value.\"\"\"\n    value: int\n\n\n@dataclass\nclass Result:\n    \"\"\"Holder for the resulting minimum product value.\"\"\"\n    min_value: int\n\n```\n```python\n# src/validator.py\nimport collections.abc\n\nclass Validator:\n    \"\"\"Validates input list structure and types, raising clear exceptions.\"\"\"\n\n    def validate(self, input_list) -> None:\n        \"\"\"\n        Validates the input list: non-empty, 2-element sequences, integer elements.\n        Raises ValueError or TypeError for invalid inputs.\n        \"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"input must be a list\")\n\n        if not input_list:\n            raise ValueError(\"input list must not be empty\")\n\n        for element in input_list:\n            if not (isinstance(element, collections.abc.Sequence) and len(element) == 2):\n                raise TypeError(\"each element must be a 2-element tuple or sequence\")\n            \n            if not (isinstance(element[0], int) and isinstance(element[1], int)):\n                raise TypeError(\"tuple elements must be integers\")\n\n```\n```python\n# src/min_product.py\nfrom typing import List, Tuple as TypingTuple, Optional\nfrom .validator import Validator\nfrom .models import Result\n\nclass MinProductService:\n    \"\"\"Orchestrates validation, computation, and selection of the minimum product.\"\"\"\n\n    def __init__(self, validator: Optional[Validator] = None) -> None:\n        \"\"\"Initializes the service with an optional Validator.\"\"\"\n        self._validator = validator if validator is not None else Validator()\n\n    def min_product_tuple(self, input_list: List[TypingTuple[int, int]]) -> int:\n        \"\"\"\n        Validates the input, computes products on-the-fly, and returns the minimum product.\n        Achieves O(n) time and O(1) extra space.\n        \"\"\"\n        self._validator.validate(input_list)\n\n        min_product = float('inf')\n\n        for a, b in input_list:\n            current_product = a * b\n            if current_product < min_product:\n                min_product = current_product\n        \n        return Result(min_product).min_value\n\n\n# Public API function\n_min_product_service_instance = MinProductService()\n\ndef min_product_tuple(input_list: List[TypingTuple[int, int]]) -> int:\n    \"\"\"\n    Finds the minimum product from a list of 2-element integer tuples.\n    Delegates to MinProductService for validation and computation.\n    \"\"\"\n    return _min_product_service_instance.min_product_tuple(input_list)\n\n```"}
