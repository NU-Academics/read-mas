{"task_id": "Mbpp/585", "solution": "```python\n# src/__init__.py\n# Package marker.\n\n\n# src/models.py\nfrom typing import List, Dict, Union\n\nclass Item:\n    \"\"\"Represents an item with a name and a numeric price.\"\"\"\n    def __init__(self, name: str, price: float) -> None:\n        self.name: str = name\n        self.price: float = price\n\n    def to_dict(self) -> Dict[str, Union[str, float]]:\n        \"\"\"Converts the Item object to a dictionary.\"\"\"\n        return {'name': self.name, 'price': self.price}\n\nclass Dataset:\n    \"\"\"Manages a collection of Item entries, providing validation, sorting, and top-N selection.\"\"\"\n    def __init__(self, raw_items: List[Dict[str, object]]) -> None:\n        self.items: List[Item] = []\n        # Temporarily store raw_items for validation before conversion to Item instances.\n        self._raw_items_to_validate = raw_items \n\n    def validate(self) -> None:\n        \"\"\"\n        Validates dataset structure and price types.\n        Raises ValueError on invalid input data.\n        \"\"\"\n        if not isinstance(self._raw_items_to_validate, list):\n            raise ValueError(\"Dataset must be a list.\")\n\n        validated_item_objects: List[Item] = []\n        for i, raw_item in enumerate(self._raw_items_to_validate):\n            if not isinstance(raw_item, dict):\n                raise ValueError(f\"Dataset item at index {i} must be a dictionary.\")\n            if 'name' not in raw_item or 'price' not in raw_item:\n                raise ValueError(f\"Dataset item at index {i} must contain 'name' and 'price' keys.\")\n            if not isinstance(raw_item['name'], str):\n                raise ValueError(f\"Item name at index {i} must be a string.\")\n            \n            try:\n                price = float(raw_item['price'])\n            except (TypeError, ValueError) as e:\n                raise ValueError(f\"Item price at index {i} must be numeric. Original error: {e}\")\n            \n            validated_item_objects.append(Item(name=raw_item['name'], price=price))\n        \n        self.items = validated_item_objects\n        # Clean up temporary storage after successful validation and conversion.\n        del self._raw_items_to_validate\n\n    def sortByPriceDesc(self) -> None:\n        \"\"\"Sorts the internal list of items in-place by numeric price in descending order.\"\"\"\n        self.items.sort(key=lambda item: item.price, reverse=True)\n\n    def getTopN(self, n: int) -> List[Dict[str, Union[str, float]]]:\n        \"\"\"\n        Returns up to N items as a list of dictionaries, ordered descending by price.\n        Returns an empty list if n is less than or equal to 0.\n        \"\"\"\n        if n <= 0:\n            return []\n        \n        # Select the top N items and convert each to a dictionary.\n        return [item.to_dict() for item in self.items[:n]]\n\n\n# src/expensive_items_service.py\nfrom src.models import Dataset\nfrom typing import List, Dict, Union\n\ndef expensive_items(dataset: List[Dict[str, object]], n: int) -> List[Dict[str, Union[str, float]]]:\n    \"\"\"\n    Finds the N most expensive items from a given dataset.\n    This function orchestrates dataset validation, sorting, and top-N selection.\n    \"\"\"\n    dataset_obj = Dataset(raw_items=dataset)\n    dataset_obj.validate()\n    dataset_obj.sortByPriceDesc()\n    return dataset_obj.getTopN(n)\n\nclass ExpensiveItemsService:\n    \"\"\"Provides the public API for finding expensive items.\"\"\"\n    def expensive_items(self, dataset: List[Dict[str, object]], n: int) -> List[Dict[str, Union[str, float]]]:\n        \"\"\"\n        Public method to find the N most expensive items.\n        It delegates to the module-level expensive_items function for execution.\n        \"\"\"\n        return expensive_items(dataset, n)\n```"}
