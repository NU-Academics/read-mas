{"task_id": "Mbpp/608", "solution": "def validateInput(n):\n    \"\"\"Raise ValueError if n is not an int or n < 0.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef computeBell(n):\n    \"\"\"Compute and return the nth Bell number as exact int using integer arithmetic (Bell triangle).\"\"\"\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    return bell_triangle[n][0]\n\ndef bell_Number(n):\n    \"\"\"Validate n and return nth Bell number as exact int (zero-based indexing).\"\"\"\n    validateInput(n)\n    return computeBell(n)"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef find_literals(input_string: str, regex_pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring, start, and end indices.\n    Returns None if no match is found.\n    \"\"\"\n    match = re.search(regex_pattern, input_string)\n    if match:\n        start_index = match.start()\n        end_index = match.end()\n        matched_substring = input_string[start_index:end_index]\n        return (matched_substring, start_index, end_index)\n    return None"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"Return a new list equal to input_list with the k'th element removed (k is 1-based).\n    Raises TypeError if input types are invalid. Raises IndexError if k is out of range.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n    n = len(input_list)\n    if k < 1 or k > n:\n        raise IndexError(\"k is out of range\")\n    return input_list[:k-1] + input_list[k:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"Return the maximum numeric value found in column n (zero-based) of matrix.\"\"\"\n    column_values = []\n    for row in matrix:\n        column_values.append(row[n])\n    return max(column_values)"}
{"task_id": "Mbpp/614", "solution": "def _is_numeric(value):\n    \"\"\"\n    Checks if a value is an int or float, explicitly excluding boolean types.\n    \"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values across a list of tuples,\n    performing strict type validation and raising TypeError on invalid inputs.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for item in tuple_list:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All elements in the list must be tuples.\")\n        for value in item:\n            if not _is_numeric(value):\n                raise TypeError(\"All values within tuples must be numeric (int or float).\")\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "from src.validator import Validator\n\ndef average_tuple(tuples: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple in a tuple of tuples.\n\n    Input is validated to ensure it's a tuple of tuples containing only numeric values.\n    \"\"\"\n    validator = Validator()\n    validator.validate_input(tuples)\n\n    averages = []\n    for inner_tuple in tuples:\n        current_average = sum(inner_tuple) / len(inner_tuple)\n        averages.append(current_average)\n\n    return averages"}
{"task_id": "Mbpp/612", "solution": "def validate(input):\n    \"\"\"\n    Validates the input to ensure it is an iterable of sublists,\n    where each sublist contains exactly two elements.\n    Raises TypeError if input is not iterable, ValueError if sublists are not length 2.\n    \"\"\"\n    # The 'for' loop will implicitly raise a TypeError if 'input' is not iterable,\n    # satisfying the design requirement for non-iterable input.\n    for item in input:\n        # This check assumes 'item' is a sized object (e.g., list, tuple).\n        # If 'item' is not sized, len(item) would raise a TypeError.\n        # The design implies 'item' are \"sublists\", making len(item) valid for checking length.\n        if len(item) != 2:\n            raise ValueError(\"Each sublist within the input must have exactly two elements.\")\n    return True # Validation successful.\n\ndef merge(input):\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    validate(input) # First, validate the input as per design requirements.\n\n    first_elements = []\n    second_elements = []\n\n    # Iterate through each sublist in the input to extract elements.\n    for sublist in input:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    # Return the two newly formed lists as a single list.\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/616", "solution": "class TupleModuloService:\n    def validate_lengths(self, a, b) -> None:\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    def validate_no_zero_divisor(self, b) -> None:\n        if any(x == 0 for x in b):\n            raise ZeroDivisionError(\"Divisor tuple cannot contain zero.\")\n\n    def tuple_modulo(self, a: tuple, b: tuple) -> tuple:\n        self.validate_lengths(a, b)\n        self.validate_no_zero_divisor(b)\n        result_list = [a[i] % b[i] for i in range(len(a))]\n        return tuple(result_list)\n\ndef tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Delegates validation and computation to an internal service class.\n    \"\"\"\n    return TupleModuloService().tuple_modulo(a, b)"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Sequence, Union\n\nclass LengthMismatchError(Exception):\n    \"\"\"Custom exception raised when input lists have different lengths.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef div_list(list_a: Sequence[Union[int, float]], list_b: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"Divides two lists element-wise, returning a list of floats.\n    Raises LengthMismatchError if the input lists have different lengths.\"\"\"\n    if len(list_a) != len(list_b):\n        raise LengthMismatchError(\"Lists must have the same length\")\n\n    result = [float(a) / float(b) for a, b in zip(list_a, list_b)]\n    return result"}
{"task_id": "Mbpp/619", "solution": "class InputString:\n    \"\"\"Data holder for original input string and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass OutputString:\n    \"\"\"Assembles and holds the output string from parts.\"\"\"\n    def __init__(self):\n        self._parts: list[str] = []\n\n    def append_non_digit(self, s: str):\n        self._parts.append(s)\n\n    def append_digits(self, digits_sequence_obj: 'DigitSequence'):\n        self._parts.append(digits_sequence_obj.to_string())\n\n    def finalize(self) -> str:\n        return \"\".join(self._parts)\n\nclass Digit:\n    \"\"\"Represents a single digit character and its original index.\"\"\"\n    def __init__(self, value: str, originalIndex: int):\n        self.value = value\n        self.originalIndex = originalIndex\n\nclass DigitSequence:\n    \"\"\"Ordered collection of Digit objects; preserves input order of digits.\"\"\"\n    def __init__(self):\n        self.digits: list[Digit] = []\n\n    def add(self, digit: Digit):\n        self.digits.append(digit)\n\n    def to_string(self) -> str:\n        return \"\".join(d.value for d in self.digits)\n\nclass NonDigit:\n    \"\"\"Represents a single non-digit character and its original index.\"\"\"\n    def __init__(self, value: str, originalIndex: int):\n        self.value = value\n        self.originalIndex = originalIndex\n\nclass NonDigitSequence:\n    \"\"\"Ordered collection of NonDigit objects; preserves input order of non-digits.\"\"\"\n    def __init__(self):\n        self.chars: list[NonDigit] = []\n\n    def add(self, nd: NonDigit):\n        self.chars.append(nd)\n\n    def to_string(self) -> str:\n        return \"\".join(nd.value for nd in self.chars)\n\nclass MoveNumFunction:\n    \"\"\"Encapsulates the algorithm to move digits to the end of a string.\"\"\"\n    def move_num(self, input_str: str) -> str:\n        # Return an empty string for an empty input as per FR6.\n        if not input_str:\n            return \"\"\n\n        input_obj = InputString(input_str)\n        non_digit_sequence = NonDigitSequence()\n        digit_sequence = DigitSequence()\n\n        for i, char in enumerate(input_obj.value):\n            # Classify characters into digits or non-digits (ASCII '0'..'9').\n            if '0' <= char <= '9':\n                digit_sequence.add(Digit(char, i))\n            else:\n                non_digit_sequence.add(NonDigit(char, i))\n        \n        output_obj = OutputString()\n        output_obj.append_non_digit(non_digit_sequence.to_string())\n        output_obj.append_digits(digit_sequence)\n        \n        return output_obj.finalize()\n\ndef move_num(input_str):\n    \"\"\"\n    Moves all digit characters to the end of the given string,\n    preserving relative order of non-digits and digits.\n    \"\"\"\n    processor = MoveNumFunction()\n    return processor.move_num(input_str)"}
