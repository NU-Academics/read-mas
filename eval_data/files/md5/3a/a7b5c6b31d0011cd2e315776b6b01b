{"task_id": "Mbpp/239", "solution": "import collections\nimport functools\nfrom typing import Dict, Tuple\n\nclass Validator:\n    \"\"\"Validator class for input parameters.\"\"\"\n    def validate(self, m: int, n: int) -> None:\n        \"\"\"Raises ValueError if m or n are not positive integers.\"\"\"\n        if not isinstance(m, int) or m <= 0:\n            raise ValueError(\"m must be a positive integer.\")\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer.\")\n\nclass Constraints:\n    \"\"\"Encapsulates domain constraints for sequence elements.\"\"\"\n    def __init__(self, maxValue: int):\n        self.maxValue = maxValue\n\n    def satisfies(self, prev: int, curr: int) -> bool:\n        \"\"\"Returns True if curr is valid based on maxValue and previous element.\"\"\"\n        if not (1 <= curr <= self.maxValue):\n            return False\n        if prev is not None and curr < 2 * prev:\n            return False\n        return True\n\nclass SequenceCounter:\n    \"\"\"Computes the number of valid sequences.\"\"\"\n    def __init__(self, constraints: Constraints = None):\n        self._constraints = constraints\n\n    def countSequences(self, m: int, n: int) -> int:\n        \"\"\"Returns the integer count of valid sequences of length n, with elements up to m.\"\"\"\n        if self._constraints is None:\n            self._constraints = Constraints(maxValue=m)\n\n        # Memoization cache: (prev_value, remaining_length) -> count\n        memo: Dict[Tuple[int, int], int] = {}\n        \n        # We start with a conceptual 'previous value' that allows any number 'i' (1 <= i <= m)\n        # to be the first element, so we iterate from 1 to m.\n        total_count = 0\n        for i in range(1, m + 1):\n            if self._constraints.satisfies(None, i):\n                total_count += self._count_from(i, n - 1, m, memo)\n        \n        return total_count\n\n    def _count_from(self, prev_value: int, remaining: int, m: int, memo: Dict[Tuple[int, int], int]) -> int:\n        \"\"\"Recursive helper to count sequences given a previous value and remaining positions.\"\"\"\n        if remaining == 0:\n            return 1 # Found one valid sequence ending here\n\n        if (prev_value, remaining) in memo:\n            return memo[(prev_value, remaining)]\n\n        count = 0\n        min_next_val = 2 * prev_value\n        \n        # Optimization: if min_next_val exceeds m, no further elements can satisfy the constraint.\n        if min_next_val > m:\n            memo[(prev_value, remaining)] = 0\n            return 0\n\n        for next_val in range(min_next_val, m + 1):\n            if self._constraints.satisfies(prev_value, next_val):\n                count += self._count_from(next_val, remaining - 1, m, memo)\n        \n        memo[(prev_value, remaining)] = count\n        return count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of sequences of length n, where elements are positive, <= m,\n    and each element >= twice the previous.\n    \"\"\"\n    Validator().validate(m, n)\n    count = SequenceCounter().countSequences(m, n)\n    return count"}
{"task_id": "Mbpp/240", "solution": "from typing import Any, List as TypingList\n\nclass Element:\n    \"\"\"Represents an individual element from a list with its value and original index.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass _List:\n    \"\"\"Domain wrapper for an ordered sequence of Element objects.\"\"\"\n    def __init__(self, raw_list: TypingList[Any]) -> None:\n        self._elements: TypingList[Element] = [Element(value, i) for i, value in enumerate(raw_list)]\n        self.length: int = len(self._elements)\n\n    def get_prefix_except_last(self) -> TypingList[Element]:\n        \"\"\"Returns Element objects representing the list except the last element.\"\"\"\n        if self.length <= 1:\n            return []\n        return self._elements[:-1]\n\n    def to_value_list(self) -> TypingList[Any]:\n        \"\"\"Returns a native list of element values in order.\"\"\"\n        return [e.value for e in self._elements]\n\nclass ResultList:\n    \"\"\"Accumulates Element objects and provides conversion to native list values.\"\"\"\n    def __init__(self) -> None:\n        self._elements: TypingList[Element] = []\n\n    def append(self, elements: TypingList[Element]) -> None:\n        \"\"\"Appends Element objects preserving their order.\"\"\"\n        self._elements.extend(elements)\n\n    def to_value_list(self) -> TypingList[Any]:\n        \"\"\"Returns a native list of element values in order.\"\"\"\n        return [e.value for e in self._elements]\n\nclass ReplaceListFunction:\n    \"\"\"Orchestrates validation and composition to produce the result list.\"\"\"\n    def validate_inputs(self, list1: TypingList[Any], list2: TypingList[Any]) -> None:\n        \"\"\"Ensures list1 is provided; raises ValueError if list1 is None.\"\"\"\n        if list1 is None:\n            raise ValueError(\"list1 must be provided.\")\n\n    def replace_list(self, list1: TypingList[Any], list2: TypingList[Any]) -> TypingList[Any]:\n        \"\"\"Builds List objects, composes ResultList, and returns native list of values.\"\"\"\n        self.validate_inputs(list1, list2)\n\n        wrapped_list1 = _List(list1)\n        wrapped_list2 = _List(list2)\n\n        result_list_accumulator = ResultList()\n        \n        prefix_elements = wrapped_list1.get_prefix_except_last()\n        result_list_accumulator.append(prefix_elements)\n        result_list_accumulator.append(wrapped_list2._elements)\n\n        return result_list_accumulator.to_value_list()\n\ndef replace_list(list1: TypingList[Any], list2: TypingList[Any]) -> TypingList[Any]:\n    \"\"\"Replaces the last element of the first list with the elements of the second list.\n\n    This function returns a new list and does not mutate the input lists.\n    \"\"\"\n    return ReplaceListFunction().replace_list(list1, list2)"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef _integer_sqrt(n: int) -> int:\n    \"\"\"Returns the floor of the square root of n using integer arithmetic.\"\"\"\n    return math.isqrt(n)\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if n is a perfect square.\"\"\"\n    if n < 0:\n        return False\n    root = _integer_sqrt(n)\n    return root * root == n\n\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the smallest perfect square strictly greater than a given number n.\n    If n is itself a perfect square, returns the next perfect square.\n    \"\"\"\n    # Get the integer square root of n.\n    # For n=35, root=5. For n=36, root=6.\n    root = _integer_sqrt(n)\n\n    # If n is a perfect square (e.g., 36), we need the square of (root + 1).\n    # If n is not a perfect square (e.g., 35), we also need the square of (root + 1)\n    # as floor(sqrt(35)) = 5, and (5+1)^2 = 36 is the next perfect square.\n    next_root = root + 1\n    return next_root * next_root"}
