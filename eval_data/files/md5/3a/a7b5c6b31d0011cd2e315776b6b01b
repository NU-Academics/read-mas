{"task_id": "Mbpp/473", "solution": "import collections.abc\nfrom typing import Any, List, Set, Tuple as BuiltinTuple\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\ndef validate_input_lists(list1: Any, list2: Any) -> None:\n    \"\"\"\n    Validates that inputs are iterables containing strictly 2-element built-in tuples.\n    Raises ValidationError if validation fails.\n    \"\"\"\n    if not isinstance(list1, collections.abc.Iterable):\n        raise ValidationError(\"Input list1 must be an iterable.\")\n    if not isinstance(list2, collections.abc.Iterable):\n        raise ValidationError(\"Input list2 must be an iterable.\")\n\n    # Convert to list to iterate multiple times and ensure proper indexing for error messages\n    list1_checked = list(list1)\n    list2_checked = list(list2)\n\n    for i, item in enumerate(list1_checked):\n        if not (isinstance(item, BuiltinTuple) and len(item) == 2):\n            raise ValidationError(f\"Element at index {i} in list1 must be a 2-element tuple.\")\n    for i, item in enumerate(list2_checked):\n        if not (isinstance(item, BuiltinTuple) and len(item) == 2):\n            raise ValidationError(f\"Element at index {i} in list2 must be a 2-element tuple.\")\n\nclass TupleNormalizer:\n    \"\"\"Provides deterministic normalization of a Tuple's two elements.\"\"\"\n    def normalize(self, t: 'Tuple') -> 'Tuple':\n        \"\"\"\n        Produces and returns a normalized Tuple (smaller element first;\n        fallback deterministic ordering applied for non-comparable elements).\n        \"\"\"\n        elements = [t.elementA, t.elementB]\n        try:\n            # Attempt direct comparison/sorting if elements are comparable\n            elements.sort()\n        except TypeError:\n            # Fallback for non-comparable types: sort by string representation\n            # This ensures a deterministic order even if elements can't be directly compared.\n            elements.sort(key=repr)\n        return Tuple(elements[0], elements[1])\n\nclass Tuple:\n    \"\"\"Represents an immutable 2-element tuple value and provides normalization.\"\"\"\n    _normalizer = TupleNormalizer() # Shared stateless normalizer instance\n\n    def __init__(self, elementA: Any, elementB: Any):\n        self.elementA = elementA\n        self.elementB = elementB\n        # Pre-compute normalized form once for efficiency in __eq__ and __hash__\n        normalized_tuple = self._normalizer.normalize(self)\n        self._normalized_elements = (normalized_tuple.elementA, normalized_tuple.elementB)\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, Tuple):\n            return NotImplemented\n        return self._normalized_elements == other._normalized_elements\n\n    def __hash__(self) -> int:\n        return hash(self._normalized_elements)\n\n    def normalized(self) -> 'Tuple':\n        \"\"\"Returns a normalized Tuple instance where elements are ordered deterministically.\"\"\"\n        # A new Tuple instance constructed from the pre-computed normalized elements\n        return Tuple(self._normalized_elements[0], self._normalized_elements[1])\n\n    def to_builtin(self) -> BuiltinTuple:\n        \"\"\"Returns a built-in 2-element tuple (normalized ordering).\"\"\"\n        return self._normalized_elements\n\nclass TupleList:\n    \"\"\"Encapsulates a collection of Tuple objects.\"\"\"\n    def __init__(self, tuples: List['Tuple']):\n        self.tuples = tuples\n\n    @classmethod\n    def from_iterable(cls, iterable: collections.abc.Iterable[BuiltinTuple]) -> 'TupleList':\n        \"\"\"\n        Converts an iterable of 2-element built-in tuples into a TupleList,\n        creating Tuple objects, raising ValidationError if invalid elements found.\n        \"\"\"\n        tuple_objects = []\n        for item in iterable:\n            if not (isinstance(item, BuiltinTuple) and len(item) == 2):\n                raise ValidationError(\"Iterable element must be a 2-element tuple.\")\n            tuple_objects.append(Tuple(item[0], item[1]))\n        return cls(tuple_objects)\n\n    def validate(self) -> bool:\n        \"\"\"Validates that self.tuples contains only Tuple instances with exactly two elements.\"\"\"\n        for item in self.tuples:\n            if not isinstance(item, Tuple) or not hasattr(item, 'elementA') or not hasattr(item, 'elementB'):\n                raise ValidationError(\"TupleList contains non-Tuple or malformed Tuple objects.\")\n        return True\n\nclass TupleSet:\n    \"\"\"Holds a set of normalized Tuple objects and exposes conversion to built-in tuple set.\"\"\"\n    def __init__(self):\n        self._tuples: Set['Tuple'] = set()\n\n    def add(self, t: 'Tuple') -> None:\n        \"\"\"Adds a Tuple (implicitly normalized via Tuple's __hash__ and __eq__) to the set.\"\"\"\n        self._tuples.add(t)\n\n    def to_builtin_set(self) -> Set[BuiltinTuple]:\n        \"\"\"Returns a set of built-in 2-element tuples (normalized ordering).\"\"\"\n        return {t.to_builtin() for t in self._tuples}\n\nclass TupleIntersectionService:\n    \"\"\"Computes the order-insensitive intersection of two TupleList values.\"\"\"\n    def __init__(self):\n        self.normalizer = TupleNormalizer()\n\n    def _compute_normalized_set(self, list_obj: 'TupleList') -> Set['Tuple']:\n        \"\"\"Computes a set of normalized Tuple objects from a TupleList.\"\"\"\n        normalized_set: Set['Tuple'] = set()\n        for t_obj in list_obj.tuples:\n            # Tuple's __init__ already normalizes and sets _normalized_elements,\n            # so adding directly leverages the pre-computed normalized form for hashing/equality.\n            normalized_set.add(t_obj)\n        return normalized_set\n\n    def tuple_intersection(self, list1: 'TupleList', list2: 'TupleList') -> 'TupleSet':\n        \"\"\"\n        Computes the intersection of two TupleList values and returns a TupleSet.\n        \"\"\"\n        set1 = self._compute_normalized_set(list1)\n        set2 = self._compute_normalized_set(list2)\n\n        intersection_tuples = set1.intersection(set2)\n\n        result_tuple_set = TupleSet()\n        for t in intersection_tuples:\n            result_tuple_set.add(t)\n        return result_tuple_set\n\ndef tuple_intersection(list1: Any, list2: Any) -> Set[BuiltinTuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    Returns a set of normalized 2-element built-in tuples.\n    \"\"\"\n    validate_input_lists(list1, list2)\n    list1_obj = TupleList.from_iterable(list1)\n    list2_obj = TupleList.from_iterable(list2)\n    service = TupleIntersectionService()\n    result_tuple_set = service.tuple_intersection(list1_obj, list2_obj)\n    return result_tuple_set.to_builtin_set()"}
