{"task_id": "Mbpp/462", "solution": "def combinations_list(list):\n    \"\"\"\n    Returns all possible combinations (power set) of the elements of a given list,\n    ordered by ascending binary mask integer (LSB maps to input index 0).\n    \"\"\"\n    n = len(list)\n    total_combinations = 1 << n  # 2**n\n    result = []\n\n    for mask in range(total_combinations):\n        current_combination = []\n        for j in range(n):\n            # Check if the j-th bit of the mask is set\n            if (mask >> j) & 1:\n                current_combination.append(list[j])\n        result.append(current_combination)\n\n    return result"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple\n\ndef add_pairwise(input: Tuple[int]) -> Tuple[int]:\n    \"\"\"\n    Finds the pairwise sum of neighboring elements in the given tuple.\n    Returns an empty tuple if the input tuple has fewer than two elements.\n    \"\"\"\n    return tuple(input[i] + input[i+1] for i in range(len(input) - 1))"}
{"task_id": "Mbpp/468", "solution": "class MaxProductCalculator:\n    \"\"\"\n    MaxProductCalculator class with compute(numbers) method.\n    Computes maximum product over contiguous strictly increasing subarrays.\n    \"\"\"\n    def compute(self, numbers) -> float:\n        \"\"\"\n        Compute maximum product over contiguous strictly increasing subarrays.\n        The algorithm processes contiguous strictly increasing runs and treats single-element runs as valid.\n        \"\"\"\n        if not numbers:\n            return 0.0\n\n        # Initialize max_prod and current_prod with the first element,\n        # treating single-element runs as valid as per design notes.\n        max_prod = float(numbers[0])\n        current_prod = float(numbers[0])\n\n        for i in range(1, len(numbers)):\n            if numbers[i] > numbers[i-1]:\n                current_prod *= float(numbers[i])\n            else:\n                # Run ended, update max product and start a new run\n                max_prod = max(max_prod, current_prod)\n                current_prod = float(numbers[i])\n        \n        # After the loop, compare max_prod with the product of the last run\n        max_prod = max(max_prod, current_prod)\n        \n        return max_prod\n\ndef max_product(array) -> float:\n    \"\"\"\n    Public API (FR1): accepts array of numbers and returns numeric maximum product.\n    Delegates to MaxProductCalculator.compute for core logic.\n    \"\"\"\n    calc = MaxProductCalculator()\n    return calc.compute(array)"}
{"task_id": "Mbpp/472", "solution": "def _validate_input(list_input):\n    \"\"\"\n    Validates basic preconditions for the input list.\n    Handles empty list cases.\n    \"\"\"\n    if list_input is None:\n        return False, \"Input is None\"\n    if len(list_input) == 0:\n        return False, \"Empty list\"\n    return True, \"\"\n\ndef _normalize_unique_integers(list_input):\n    \"\"\"\n    Normalizes input to a set of unique integers.\n    Returns None if any non-integer element is present.\n    \"\"\"\n    unique_integers = set()\n    for element in list_input:\n        if not isinstance(element, int):\n            return None\n        unique_integers.add(element)\n    return unique_integers\n\ndef _compute_expected_set(min_value, max_value):\n    \"\"\"\n    Computes the set of consecutive integers from min to max (inclusive).\n    \"\"\"\n    return set(range(min_value, max_value + 1))\n\ndef _compare_sets(unique_set, expected_set):\n    \"\"\"\n    Compares two sets for equality.\n    \"\"\"\n    return unique_set == expected_set\n\ndef check_Consecutive(list_input):\n    \"\"\"\n    Checks if the given list contains unique, consecutive integers.\n    Order and duplicates are ignored. Non-integer elements or empty list result in False.\n    \"\"\"\n    # 1. Validate input (basic checks: None, empty list)\n    is_valid, _ = _validate_input(list_input)\n    if not is_valid:\n        return False\n\n    # 2. Normalize to unique integers, checking for non-integers\n    unique_set = _normalize_unique_integers(list_input)\n    if unique_set is None:  # Non-integer found during normalization\n        return False\n\n    # At this point, unique_set contains only integers and is not empty\n    # (because _validate_input handled empty list, and _normalize... returns None for non-integers)\n\n    # 3. Determine min and max from the unique integers\n    min_val = min(unique_set)\n    max_val = max(unique_set)\n\n    # 4. Compute the expected set of consecutive integers\n    expected_set = _compute_expected_set(min_val, max_val)\n\n    # 5. Compare the unique set from input with the expected set\n    return _compare_sets(unique_set, expected_set)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"Calculates the product of array elements modulo n.\"\"\"\n    product = 1\n    for element in array:\n        product = (product * (element % n)) % n\n    return product"}
