{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    The function evaluates the min-heap property: every child value must be greater than or equal to its parent.\n    \"\"\"\n    n = len(array)\n    for i in range(n):\n        left = 2 * i + 1\n        if left < n and array[left] < array[i]:\n            return False\n        right = 2 * i + 2\n        if right < n and array[right] < array[i]:\n            return False\n    return True"}
{"task_id": "Mbpp/752", "solution": "class Validation:\n    \"\"\"Provides utility methods for input validation.\"\"\"\n    @staticmethod\n    def is_non_negative_integer(n) -> bool:\n        \"\"\"Checks if the input is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass JacobsthalCalculator:\n    \"\"\"Calculates Jacobsthal numbers using different strategies.\"\"\"\n    @staticmethod\n    def compute_iterative(n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number iteratively.\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        a, b = 0, 1  # Corresponds to J(0) and J(1)\n        for _ in range(2, n + 1):\n            next_jacobsthal = b + 2 * a\n            a, b = b, next_jacobsthal\n        return b\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number.\n\n    This function calculates J(n) using the recurrence J(0)=0, J(1)=1, J(n)=J(n-1)+2*J(n-2).\n    \"\"\"\n    if not Validation.is_non_negative_integer(n):\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    return JacobsthalCalculator.compute_iterative(n)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"Return list of elements equal at same indices across l1, l2, l3.\"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/753", "solution": "def min_k(items, k):\n    \"\"\"\n    Finds minimum k records from a tuple list, sorted by their numeric second element.\n    Handles k <= 0, k >= list length, and preserves input order for ties.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    # Materialize the iterable into a list to ensure consistent behavior and enable sorting.\n    # Input validation (isinstance checks, raising ValueError) is omitted as per specific completion instructions.\n    items_list = list(items)\n\n    # Sort the list of tuples based on the second element (numeric value).\n    # Python's `sorted()` uses Timsort, which is a stable sort, preserving the original\n    # order for elements that have equal keys, fulfilling the tie-breaking requirement.\n    items_sorted = sorted(items_list, key=lambda t: t[1])\n\n    # Return the first 'k' elements. If 'items_list' has fewer than 'k' elements,\n    # it returns all available elements up to its length.\n    return items_sorted[:min(k, len(items_list))]"}
{"task_id": "Mbpp/755", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Number:\n    \"\"\"Represents a numeric value.\"\"\"\n    value: float\n\n@dataclass\nclass NumberList:\n    \"\"\"A list of Number objects.\"\"\"\n    numbers: List[Number]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.numbers)\n\n@dataclass\nclass Result:\n    \"\"\"Holds the result of an operation.\"\"\"\n    value: float\n\nclass SecondSmallestFunction:\n    \"\"\"A function object to find the second smallest number.\"\"\"\n    def __init__(self, name: str = \"second_smallest\") -> None:\n        \"\"\"Initializes the function with a given name.\"\"\"\n        self.name = name\n\n    def execute(self, numbers: NumberList) -> Result:\n        \"\"\"\n        Finds the second smallest numeric value in the list.\n        Raises ValueError if the input list has fewer than two elements.\n        \"\"\"\n        if numbers.length() < 2:\n            raise ValueError(\"Input list must contain at least two numeric elements.\")\n\n        # Initialize min1 (smallest) and min2 (second smallest) with the first two elements.\n        if numbers.numbers[0].value < numbers.numbers[1].value:\n            min1 = numbers.numbers[0].value\n            min2 = numbers.numbers[1].value\n        else:\n            min1 = numbers.numbers[1].value\n            min2 = numbers.numbers[0].value\n\n        # Iterate through the rest of the list to update min1 and min2.\n        for i in range(2, numbers.length()):\n            current_value = numbers.numbers[i].value\n            if current_value < min1:\n                min2 = min1\n                min1 = current_value\n            elif current_value < min2:\n                min2 = current_value\n        \n        return Result(value=min2)\n\ndef second_smallest(numbers: list) -> float:\n    \"\"\"\n    Finds the second smallest number in a list of numeric values.\n    Treats duplicate values as distinct entries.\n    \"\"\"\n    # Convert the input list of numbers to a list of Number objects.\n    number_objects = [Number(value=float(n)) for n in numbers]\n    number_list_obj = NumberList(numbers=number_objects)\n\n    # Use the domain-level function to execute the logic.\n    func = SecondSmallestFunction()\n    result = func.execute(number_list_obj)\n    \n    return result.value"}
