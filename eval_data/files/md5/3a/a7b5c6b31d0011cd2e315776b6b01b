{"task_id": "Mbpp/14", "solution": "def compute_base_area(base: float, triangle_height: float) -> float:\n    \"\"\"Calculates the area of the triangular base.\"\"\"\n    return 0.5 * base * triangle_height\n\ndef compute_volume(base_area: float, length: float) -> float:\n    \"\"\"Calculates the volume of the prism from its base area and length.\"\"\"\n    return base_area * length\n\ndef find_Volume(base, triangle_height, length):\n    \"\"\"\n    Finds the volume of a triangular prism.\n    Assumes all inputs are numeric (int or float).\n    \"\"\"\n    base_area = compute_base_area(base, triangle_height)\n    volume = compute_volume(base_area, length)\n    return volume"}
{"task_id": "Mbpp/18", "solution": "class RemoveCharsSet:\n    def __init__(self, value: str) -> None:\n        \"\"\"Initializes the set of characters to be removed.\"\"\"\n        self._removal_chars = set(value)\n\n    def contains(self, c: str) -> bool:\n        \"\"\"Checks if a character is present in the removal set.\"\"\"\n        return c in self._removal_chars\n\ndef remove_dirty_chars(source: str, remove: str) -> str:\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    Preserves order and performs case-sensitive matching.\n    \"\"\"\n    if not remove:\n        return source\n\n    removal_set = RemoveCharsSet(remove)\n    result_chars = []\n\n    for char in source:\n        if not removal_set.contains(char):\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Performs input validation for type and non-negativity.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    def reverse(num: int) -> int:\n        \"\"\"\n        Reverses the decimal digits of a non-negative integer, dropping leading zeros.\n        \"\"\"\n        return int(str(num)[::-1])\n\n    reversed_n = reverse(n)\n    return n == (2 * reversed_n) - 1"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"Checks if the array contains any duplicate element using a hash set.\n    Returns True if a duplicate is found, False otherwise.\"\"\"\n    seen: set[int] = set()\n    for v in arr:\n        if v in seen:\n            return True\n        seen.add(v)\n    return False"}
{"task_id": "Mbpp/20", "solution": "from typing import Optional, Any\n\nclass NumberInput:\n    \"\"\"Encapsulates raw input and provides parsing and validation helpers.\"\"\"\n    def __init__(self, raw: Any):\n        self.raw = raw\n        self.value: Optional[float] = None\n        try:\n            self.value = float(raw)\n        except (ValueError, TypeError):\n            self.value = None\n\n    def isInteger(self) -> bool:\n        \"\"\"Checks if the parsed value is an integer.\"\"\"\n        if self.value is None:\n            return False\n        return self.value == int(self.value)\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the parsed value is positive.\"\"\"\n        if self.value is None:\n            return False\n        return self.value > 0\n\nclass ValidationResult:\n    \"\"\"Represents the outcome of an input validation.\"\"\"\n    def __init__(self, valid: bool, reason: str = \"\"):\n        self.valid = valid\n        self.reason = reason\n\nclass WoodallNumber:\n    \"\"\"Represents a discovered Woodall number and its corresponding 'n'.\"\"\"\n    def __init__(self, value: int, n: int):\n        self.value = value\n        self.n = n\n\nclass WoodallChecker:\n    \"\"\"Performs validation and search logic for Woodall numbers.\"\"\"\n    def validate(self, x: Any) -> ValidationResult:\n        \"\"\"Validates if the input is a positive integer.\"\"\"\n        num_input = NumberInput(x)\n        if num_input.value is None:\n            return ValidationResult(valid=False, reason=\"Input is not numeric.\")\n        if not num_input.isInteger():\n            return ValidationResult(valid=False, reason=\"Input is not an integer.\")\n        if not num_input.isPositive():\n            return ValidationResult(valid=False, reason=\"Input is not positive.\")\n        return ValidationResult(valid=True)\n\n    def find_n_for(self, x: int) -> Optional[int]:\n        \"\"\"Searches for an integer n such that x = n * 2^n - 1.\"\"\"\n        n = 1\n        while True:\n            candidate = n * (2**n) - 1\n            if candidate == x:\n                return n\n            elif candidate > x:\n                return None\n            n += 1\n\n    def is_woodall(self, x: Any) -> bool:\n        \"\"\"Determines if the given input is a Woodall number.\"\"\"\n        validation_result = self.validate(x)\n        if not validation_result.valid:\n            return False\n\n        # If validation passed, x is confirmed to be convertible to a positive integer.\n        # Extract the integer value to pass to find_n_for.\n        try:\n            val_as_int = int(float(x))\n        except (ValueError, TypeError):\n            # This path should ideally not be taken if validate passed.\n            return False\n\n        found_n = self.find_n_for(val_as_int)\n        return found_n is not None\n\ndef is_woodall(number) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is an integer of the form n * 2^n - 1 for some integer n >= 1.\n    \"\"\"\n    checker = WoodallChecker()\n    return checker.is_woodall(number)"}
