{"task_id": "Mbpp/57", "solution": "from typing import List\n\nclass InputValidator:\n    \"\"\"Validates that all elements in a list are integers between 0 and 9.\"\"\"\n    @staticmethod\n    def validate(digits: List[int]) -> None:\n        if not isinstance(digits, list):\n            raise ValueError(\"Input must be a list.\")\n        for digit in digits:\n            if not isinstance(digit, int):\n                raise ValueError(f\"All elements must be integers. Found: {type(digit).__name__}\")\n            if not (0 <= digit <= 9):\n                raise ValueError(f\"All elements must be digits between 0 and 9. Found: {digit}\")\n\nclass DigitList:\n    \"\"\"Encapsulates operations on a list of digits.\"\"\"\n    def __init__(self, digits: List[int]) -> None:\n        self._digits = digits\n\n    def sorted_desc(self) -> List[int]:\n        \"\"\"Returns the digits sorted in non-increasing (descending) order.\"\"\"\n        return sorted(self._digits, reverse=True)\n\nclass ResultNumber:\n    \"\"\"Converts a list of digits into a single integer.\"\"\"\n    @staticmethod\n    def from_digits(digits: List[int]) -> int:\n        \"\"\"Concatenates a list of digits and converts the result to an integer.\"\"\"\n        digit_strings = [str(d) for d in digits]\n        number_string = \"\".join(digit_strings)\n        return int(number_string)\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    assert find_Max_Num([1,2,3]) == 321\n    \"\"\"\n    InputValidator.validate(digits)\n    dl = DigitList(digits)\n    sorted_digits = dl.sorted_desc()\n    return ResultNumber.from_digits(sorted_digits)"}
{"task_id": "Mbpp/59", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to octagonal number calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates input for octagonal number calculation.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"Checks if n is an integer >= 1. Raises InvalidInputError if not.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise InvalidInputError(\"n must be an integer >= 1\")\n\nclass OctagonalCalculator:\n    \"\"\"Calculates octagonal numbers using the closed-form formula.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth octagonal number: n * (3*n - 2).\"\"\"\n        value = n * (3 * n - 2)\n        return value\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"Public API: validate and compute the nth octagonal number. Raises InvalidInputError on invalid input.\"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n\n    calculator = OctagonalCalculator()\n    result = calculator.compute(n)\n\n    return result"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple, Union, Optional\n\nclass SubjectMark:\n    \"\"\"Represents a single subject and its numeric mark.\"\"\"\n    def __init__(self, name: str, mark: Union[float, int]):\n        self.name = name\n        self.mark = mark\n\n    def to_tuple(self) -> Tuple[str, Union[float, int]]:\n        \"\"\"Converts the SubjectMark to a 2-element tuple.\"\"\"\n        return (self.name, self.mark)\n\nclass SubjectList:\n    \"\"\"Represents and converts an input collection into domain items.\"\"\"\n    def __init__(self, items: Union[List[Tuple[str, Union[float, int]]], List[SubjectMark]]):\n        if not items:\n            self.items = []\n        elif isinstance(items[0], tuple):\n            self.items = [SubjectMark(name, mark) for name, mark in items]\n        else:\n            self.items = items\n\n    def to_list(self) -> List[Tuple[str, Union[float, int]]]:\n        \"\"\"Returns the items as a list of 2-element tuples.\"\"\"\n        return [item.to_tuple() for item in self.items]\n\nclass SortAlgorithm:\n    \"\"\"Stateless sorting policy that returns a new list sorted ascending by mark.\"\"\"\n    def sort_by_mark(self, items: List[Tuple[str, Union[float, int]]]) -> List[Tuple[str, Union[float, int]]]:\n        \"\"\"Sorts a list of tuples by the second element (mark) in ascending order.\"\"\"\n        return sorted(items, key=lambda x: x[1])\n\nclass SubjectMarksService:\n    \"\"\"Orchestrates conversion/validation and delegates sorting.\"\"\"\n    def __init__(self, sorter: Optional[SortAlgorithm] = None):\n        self.sorter = sorter if sorter is not None else SortAlgorithm()\n\n    def subject_marks(self, input_list: List[Tuple[str, Union[float, int]]]) -> List[Tuple[str, Union[float, int]]]:\n        \"\"\"Converts input, sorts it, and returns a new sorted list.\"\"\"\n        subject_list_obj = SubjectList(input_list)\n        tuples_for_sorting = subject_list_obj.to_list()\n        sorted_tuples = self.sorter.sort_by_mark(tuples_for_sorting)\n        return sorted_tuples\n\ndef subject_marks(input_list: List[Tuple[str, Union[float, int]]]) -> List[Tuple[str, Union[float, int]]]:\n    \"\"\"Sorts a list of subject-mark tuples by mark, returning a new sorted list.\"\"\"\n    service = SubjectMarksService()\n    return service.subject_marks(input_list)"}
{"task_id": "Mbpp/61", "solution": "from typing import Iterator\n\ndef _validate_digits(s: str) -> None:\n    \"\"\"Validates that the input string contains only digit characters.\"\"\"\n    for char in s:\n        if not char.isdigit():\n            raise ValueError(\"Input string must contain only digits.\")\n\ndef _enumerate_substrings(s: str) -> Iterator[tuple[int, int, str]]:\n    \"\"\"Generates all contiguous substrings of the input string.\"\"\"\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            yield (i, j, s[i : j + 1])\n\ndef _sum_digits(substr: str) -> int:\n    \"\"\"Computes the sum of the integer values of digits in a substring.\"\"\"\n    return sum(int(char) for char in substr)\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings in the input string where the sum of their digits equals their length.\n    \"\"\"\n    _validate_digits(s)\n    \n    count = 0\n    for _, _, substr in _enumerate_substrings(s):\n        digit_sum = _sum_digits(substr)\n        if digit_sum == len(substr):\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(nums: list) -> float:\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n    Raises TypeError for invalid input types or ValueError for an empty list.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not nums:\n        raise ValueError(\"List cannot be empty.\")\n\n    for item in nums:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List elements must be numbers (int or float).\")\n\n    return min(nums)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Flattens a list, summing all numeric elements.\n    Recursively traverses nested lists to arbitrary depth.\n    \"\"\"\n    total = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total += recursive_list_sum(element)\n        else:\n            total += element\n    return total"}
