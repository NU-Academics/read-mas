{"task_id": "Mbpp/66", "solution": "def _is_numeric(value) -> bool:\n    \"\"\"\n    Checks if a value is an accepted numeric type (int or float).\n    \"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_input(numbers) -> None:\n    \"\"\"\n    Validates that the input is a list and contains only numeric elements.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for value in numbers:\n        if not _is_numeric(value):\n            raise TypeError(\"List elements must be numeric (int or float).\")\n\ndef pos_count(numbers: list) -> int:\n    \"\"\"\n    Counts the number of positive numbers in a list.\n    \"\"\"\n    _validate_input(numbers)\n    count = 0\n    for num in numbers:\n        if num > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n):\n    \"\"\"\n    Computes the Bell number for a non-negative integer n using an iterative Bell triangle.\n    The Bell number B_n is the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list (triangle) where bell_triangle[i][j] stores the j-th element of the i-th row.\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # The base case: B(0, 0) = 1\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle iteratively\n    for i in range(1, n + 1):\n        # The first element of the current row (i, 0) is the last element of the previous row (i-1, i-1)\n        bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n        for j in range(1, i + 1):\n            # Subsequent elements are the sum of the element directly to their left (current row)\n            # and the element diagonally above and to their left (previous row).\n            bell_triangle[i][j] = bell_triangle[i][j - 1] + bell_triangle[i - 1][j - 1]\n\n    # The n-th Bell number is the first element of the n-th row (i.e., B(n, 0))\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple, Any\n\ndef get_equal(tuple_list: List[Tuple]) -> bool:\n    \"\"\"Return True if tuple_list is empty, contains one tuple, or all tuples have equal length; otherwise False.\n    Must not modify tuple_list or contained tuples.\"\"\"\n    if not tuple_list:\n        return True\n\n    # Get the length of the first tuple as a reference\n    first_tuple_len = len(tuple_list[0])\n\n    # Iterate through the rest of the tuples and compare their lengths\n    for i in range(1, len(tuple_list)):\n        if len(tuple_list[i]) != first_tuple_len:\n            return False\n\n    return True"}
{"task_id": "Mbpp/68", "solution": "class MonotonicChecker:\n    \"\"\"Helper class to check non-decreasing and non-increasing properties.\"\"\"\n\n    def _check_non_decreasing(self, lst) -> bool:\n        \"\"\"Checks if the list is non-decreasing.\"\"\"\n        for i in range(1, len(lst)):\n            if lst[i] < lst[i-1]:\n                return False\n        return True\n\n    def _check_non_increasing(self, lst) -> bool:\n        \"\"\"Checks if the list is non-increasing.\"\"\"\n        for i in range(1, len(lst)):\n            if lst[i] > lst[i-1]:\n                return False\n        return True\n\ndef is_Monotonic(list_of_numbers) -> bool:\n    \"\"\"Checks if the given array is monotonic (non-decreasing or non-increasing).\"\"\"\n    if len(list_of_numbers) < 2:\n        return True\n\n    checker = MonotonicChecker()\n    if checker._check_non_decreasing(list_of_numbers):\n        return True\n    if checker._check_non_increasing(list_of_numbers):\n        return True\n    return False"}
{"task_id": "Mbpp/69", "solution": "class MainList:\n    \"\"\"Represents the main sequence to be searched.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\nclass CandidateSublist:\n    \"\"\"Represents the candidate subsequence to search for.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\nclass MatchResult:\n    \"\"\"Holds boolean result of containment check.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\nclass ComparisonEngine:\n    \"\"\"Compares two elements using equality (==) semantics.\"\"\"\n    def compare(self, a, b) -> bool:\n        return (a == b)\n\nclass SublistChecker:\n    \"\"\"Executes contiguous-subsequence search over MainList and CandidateSublist.\"\"\"\n    def __init__(self, comparator: ComparisonEngine = None):\n        self.comparator = comparator if comparator is not None else ComparisonEngine()\n\n    def is_sublist(self, main: MainList, sub: CandidateSublist) -> bool:\n        main_len = len(main.elements)\n        sub_len = len(sub.elements)\n\n        if sub_len == 0:\n            return MatchResult(True).value\n\n        if sub_len > main_len:\n            return MatchResult(False).value\n\n        # Iterate through the main list to find a starting point for the sublist\n        for i in range(main_len - sub_len + 1):\n            match = True\n            # Check if the sublist matches the segment in the main list\n            for j in range(sub_len):\n                if not self.comparator.compare(main.elements[i + j], sub.elements[j]):\n                    match = False\n                    break\n            if match:\n                # If a full match is found, produce MatchResult(True)\n                return MatchResult(True).value\n        \n        # If no match is found after checking all possible starting positions, produce MatchResult(False)\n        return MatchResult(False).value\n\ndef is_sublist(main_list, candidate_sublist) -> bool:\n    \"\"\"\n    Checks whether a list contains the given sublist as a contiguous subsequence.\n    \"\"\"\n    main = MainList(main_list)\n    sub = CandidateSublist(candidate_sublist)\n\n    checker = SublistChecker(ComparisonEngine())\n\n    return checker.is_sublist(main, sub)"}
{"task_id": "Mbpp/71", "solution": "class ComparableError(Exception):\n    \"\"\"Custom exception for non-comparable elements.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_input(input_list: list) -> None:\n    \"\"\"Validates that all elements in the list are mutually comparable.\"\"\"\n    if len(input_list) <= 1:\n        return\n\n    for i in range(len(input_list) - 1):\n        try:\n            # Attempt a comparison to check for comparability\n            _ = input_list[i] < input_list[i+1]\n        except TypeError:\n            raise ComparableError(f\"Elements '{input_list[i]}' and '{input_list[i+1]}' are not mutually comparable.\")\n        except Exception as e:\n            raise ComparableError(f\"An unexpected error occurred during comparability check: {e}\")\n\nclass CombSortAlgorithm:\n    \"\"\"Implements the Comb Sort algorithm.\"\"\"\n    def __init__(self, shrink_factor: float = 1.3) -> None:\n        self.shrinkFactor = shrink_factor\n        self.gap = 0\n\n    def compute_next_gap(self, gap: int) -> int:\n        \"\"\"Computes the next gap value.\"\"\"\n        gap = int(gap / self.shrinkFactor)\n        if gap < 1:\n            return 1\n        return gap\n\n    def compare_and_swap(self, arr: list, gap: int) -> bool:\n        \"\"\"Performs a single pass of comparisons and swaps for a given gap.\"\"\"\n        swapped = False\n        n = len(arr)\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n        return swapped\n\n    def sort(self, arr: list) -> list:\n        \"\"\"Sorts the input list using the Comb Sort algorithm.\"\"\"\n        n = len(arr)\n        if n <= 1:\n            return arr[:]\n\n        temp_arr = arr[:]\n        self.gap = n\n        swapped = True\n\n        while self.gap != 1 or swapped:\n            self.gap = self.compute_next_gap(self.gap)\n            swapped = self.compare_and_swap(temp_arr, self.gap)\n        return temp_arr\n\ndef comb_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    validate_input(input_list)\n    algorithm = CombSortAlgorithm()\n    return algorithm.sort(input_list)"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"\n    Checks if an integer can be represented as the difference of two squares.\n    This is true if n is not of the form 4k + 2.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    return (n % 4 != 2)"}
{"task_id": "Mbpp/74", "solution": "class Mapping:\n    \"\"\"Maintains bidirectional maps between pattern and sequence elements and validates consistency.\"\"\"\n    def __init__(self) -> None:\n        self.pattern_to_sequence = {}\n        self.sequence_to_pattern = {}\n\n    def bind(self, pattern_element, sequence_element) -> bool:\n        \"\"\"Attempts to establish a binding between a pattern and sequence element.\n        Returns False if a contradiction is found, True otherwise.\"\"\"\n        # Check if pattern_element is already mapped to a different sequence_element\n        if pattern_element in self.pattern_to_sequence:\n            if self.pattern_to_sequence[pattern_element] != sequence_element:\n                return False\n\n        # Check if sequence_element is already mapped to a different pattern_element\n        if sequence_element in self.sequence_to_pattern:\n            if self.sequence_to_pattern[sequence_element] != pattern_element:\n                return False\n\n        # If no contradiction, establish the binding\n        self.pattern_to_sequence[pattern_element] = sequence_element\n        self.sequence_to_pattern[sequence_element] = pattern_element\n        return True\n\n\nclass PatternChecker:\n    \"\"\"Encapsulates the core logic to determine if two lists follow the same pattern.\"\"\"\n    def is_samepatterns(self, pattern_list: list, sequence: list) -> bool:\n        \"\"\"Checks if two lists follow the same bijective pattern based on element mapping.\"\"\"\n        if len(pattern_list) != len(sequence):\n            return False\n\n        mapping = Mapping()\n        for i in range(len(pattern_list)):\n            p_elem = pattern_list[i]\n            s_elem = sequence[i]\n            if not mapping.bind(p_elem, s_elem):\n                return False\n\n        return True\n\n\ndef is_samepatterns(pattern_list, sequence) -> bool:\n    \"\"\"Checks whether it follows the sequence given in the patterns array.\"\"\"\n    # Per design context and problem constraints, the top-level function delegates\n    # to PatternChecker, assuming valid list inputs as 'isinstance' checks are disallowed.\n    checker = PatternChecker()\n    return checker.is_samepatterns(pattern_list, sequence)"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\n\nclass Element:\n    \"\"\"Value-object wrapper for an integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_divisible_by(self, k: int) -> bool:\n        \"\"\"Checks if the element's value is divisible by k.\"\"\"\n        return self.value % k == 0\n\nclass TupleEntity:\n    \"\"\"Value-object holding ordered integer elements.\"\"\"\n    def __init__(self, original_tuple: Tuple[int, ...]):\n        self.original_tuple = original_tuple\n        self.elements = [Element(e) for e in original_tuple]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass DivisibilityChecker:\n    \"\"\"Encapsulates the logic to check if all elements in a TupleEntity are divisible by k.\"\"\"\n    @staticmethod\n    def is_divisible(tuple_entity: TupleEntity, k: int) -> bool:\n        \"\"\"Returns True if every element in the tuple_entity is divisible by k.\"\"\"\n        for element in tuple_entity.elements:\n            if not element.is_divisible_by(k):\n                return False\n        return True\n\nclass FindTuples:\n    \"\"\"Orchestrates per-tuple checking and collection of matching tuples.\"\"\"\n    @staticmethod\n    def find_tuples(tuples_input: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        \"\"\"Filters a list of tuples, retaining only those where all elements are divisible by k.\"\"\"\n        result: List[Tuple[int, ...]] = []\n        for tup in tuples_input:\n            tuple_entity = TupleEntity(tup)\n            if DivisibilityChecker.is_divisible(tuple_entity, k):\n                result.append(tup)\n        return result\n\ndef find_tuples(tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    This function delegates to a domain-driven design structure for filtering.\n    \"\"\"\n    return FindTuples.find_tuples(tuples, k)"}
