{"task_id": "Mbpp/223", "solution": "from dataclasses import dataclass\nfrom typing import List, Any\n\n# Class: Array\n# Responsibility: Represent input sequence as a read-only domain wrapper.\nclass Array:\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def __len__(self) -> int:\n        return self.length\n\n    def __getitem__(self, idx: int) -> Any:\n        return self.elements[idx]\n\n# Class: Element\n# Responsibility: Encapsulate the value to check.\nclass Element:\n    def __init__(self, value: Any):\n        self.value = value\n\n    def __eq__(self, other: object) -> bool:\n        if isinstance(other, Element):\n            return self.value == other.value\n        return self.value == other\n\n    def __repr__(self) -> str:\n        return f\"Element({self.value!r})\"\n\n# Class: MajorityCheckResult\n# Responsibility: DTO holding occurrence count and majority decision.\n@dataclass\nclass MajorityCheckResult:\n    count: int\n    isMajority: bool\n\n# Class: MajorityChecker\n# Responsibility: Encapsulate algorithm to check majority among first n elements of a sorted array.\nclass MajorityChecker:\n    def check(self, array: List[Any], n: int, element: Any) -> MajorityCheckResult:\n        \"\"\"\n        Counts occurrences of the element among the first n elements of the array\n        and determines if it is a majority element.\n        \"\"\"\n        count = 0\n        for i in range(n):\n            if array[i] == element:\n                count += 1\n\n        threshold = n / 2.0\n        is_majority = count > threshold\n\n        return MajorityCheckResult(count=count, isMajority=is_majority)\n\ndef is_majority(array: List[Any], n: int, element: Any) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in the first n elements of a sorted array.\n    \"\"\"\n    checker = MajorityChecker()\n    result = checker.check(array, n, element)\n    return result.isMajority"}
