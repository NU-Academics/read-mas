{"task_id": "Mbpp/757", "solution": "from typing import List, Tuple, Iterator\nfrom dataclasses import dataclass\nfrom collections import Counter\n\n@dataclass\nclass StringItem:\n    \"\"\"Holder for a single string value.\"\"\"\n    value: str\n\n@dataclass\nclass StringList:\n    \"\"\"Holder for a list of StringItem; represents input as domain model.\"\"\"\n    items: List[StringItem]\n\n    def __iter__(self) -> Iterator[StringItem]:\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        return len(self.items)\n\n@dataclass\nclass ReversePair:\n    \"\"\"Represent an unordered pair of two StringItem that are reverses.\"\"\"\n    a: StringItem\n    b: StringItem\n\n    def as_tuple(self) -> Tuple[str, str]:\n        \"\"\"Returns a canonical tuple representation of the pair for deterministic identity.\"\"\"\n        val_a = self.a.value\n        val_b = self.b.value\n        return tuple(sorted((val_a, val_b)))\n\n@dataclass\nclass CountResult:\n    \"\"\"Wrap resulting integer count.\"\"\"\n    count: int\n\nclass ReversePairCounter:\n    \"\"\"Implement algorithm to compute number of unordered reverse-string pairs.\"\"\"\n\n    def count_reverse_pairs(self, strings: List[str]) -> int:\n        \"\"\"Counts the number of unordered pairs of reverse strings.\"\"\"\n        string_counts = Counter(strings)\n        pair_count = 0\n        processed_strings = set()\n\n        for s, s_count in string_counts.items():\n            if s in processed_strings:\n                continue\n\n            reversed_s = s[::-1]\n\n            if s == reversed_s:  # Palindrome case, e.g., \"racecar\"\n                pair_count += s_count // 2\n                processed_strings.add(s)\n            elif reversed_s in string_counts:\n                reversed_s_count = string_counts[reversed_s]\n                pair_count += min(s_count, reversed_s_count)\n                processed_strings.add(s)\n                processed_strings.add(reversed_s)\n        \n        return pair_count\n\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Public API: accepts list of strings and returns integer count of reverse-string pairs.\"\"\"\n    counter = ReversePairCounter()\n    return counter.count_reverse_pairs(strings)"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with exactly two fractional digits.\n    The string must match the pattern: one or more digits, a dot, then exactly two digits.\n    \"\"\"\n    pattern = r'^[0-9]+\\.[0-9]{2}$'\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, List, Tuple, Dict\n\nclass Sublist:\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = elements\n\n    def to_tuple(self) -> Tuple[Any, ...]:\n        \"\"\"Converts the sublist to a tuple and verifies its hashability.\"\"\"\n        t = tuple(self.elements)\n        try:\n            hash(t)\n        except TypeError:\n            raise TypeError(f\"Sublist cannot be converted to a hashable tuple: {self.elements}\")\n        return t\n\nclass ResultDictionary:\n    def __init__(self) -> None:\n        self.mapping: Dict[Tuple[Any, ...], int] = {}\n\n    def increment(self, key: Tuple[Any, ...]) -> None:\n        \"\"\"Increments the count for a given tuple key.\"\"\"\n        self.mapping[key] = self.mapping.get(key, 0) + 1\n\n    def get(self, key: Tuple[Any, ...]) -> int:\n        \"\"\"Returns the count for a given tuple key, or 0 if not found.\"\"\"\n        return self.mapping.get(key, 0)\n\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts lists within a list, returning a dictionary mapping each sublist\n    (converted to a tuple) to its number of occurrences.\n    \"\"\"\n    if not input_list:\n        return {}\n\n    result_dict = ResultDictionary()\n    for sublist_item in input_list:\n        sublist_wrapper = Sublist(sublist_item)\n        tuple_key = sublist_wrapper.to_tuple()\n        result_dict.increment(tuple_key)\n\n    return result_dict.mapping"}
{"task_id": "Mbpp/762", "solution": "from src.month_repository import get_month\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number has 30 days.\n    Months are given as numbers from 1 to 12.\n    \"\"\"\n    month_data = get_month(month)\n    return month_data.has30Days"}
{"task_id": "Mbpp/763", "solution": "class ArrayInput:\n    \"\"\"Data-holder for elements and n.\"\"\"\n    def __init__(self, elements, n):\n        self.elements = elements\n        self.n = n\n\nclass Result:\n    \"\"\"Data-holder for the computed minimum difference.\"\"\"\n    def __init__(self, min_diff):\n        self.min_diff = min_diff\n\nclass Validator:\n    \"\"\"Verifies preconditions for inputs (type and bounds for n).\"\"\"\n    @staticmethod\n    def validate(arr, n):\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer.\")\n        if n < 2:\n            raise ValueError(\"n must be greater than or equal to 2.\")\n        if n > len(arr):\n            raise ValueError(\"n must be less than or equal to the length of the array.\")\n\nclass Calculator:\n    \"\"\"Computes the minimum absolute difference among provided elements.\"\"\"\n    @staticmethod\n    def compute_min_diff(sorted_slice):\n        # Assumes sorted_slice is sorted ascending and has length >= 2.\n        min_diff = float('inf')\n        for i in range(1, len(sorted_slice)):\n            diff = sorted_slice[i] - sorted_slice[i-1]\n            if diff < min_diff:\n                min_diff = diff\n        return min_diff\n\ndef find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements among the first n elements in a given array.\n    Raises ValueError for invalid n.\n    \"\"\"\n    Validator.validate(arr, n)\n    \n    slice_arr = arr[:n]\n    sorted_slice = sorted(slice_arr)\n    \n    min_difference = Calculator.compute_min_diff(sorted_slice)\n    \n    return min_difference"}
{"task_id": "Mbpp/764", "solution": "def _is_digit(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII digit ('0'-'9').\"\"\"\n    return ch in '0123456789'\n\ndef number_ctr(input: str) -> int:\n    \"\"\"Counts the number of ASCII digit characters in a given string.\"\"\"\n    count = 0\n    for char in input:\n        if _is_digit(char):\n            count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "def validate_input(input_list):\n    \"\"\"Ensures the input is a Python list. Raises TypeError if not a list.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"pair_wise expects a list as input\")\n    return None\n\ndef pair_wise(input_list):\n    \"\"\"Return list of consecutive 2-element tuples from input_list.\n    If len(input_list) < 2 returns [].\n    \"\"\"\n    validate_input(input_list)\n    n = len(input_list)\n    if n < 2:\n        return []\n    result = []\n    for i in range(n - 1):\n        result.append((input_list[i], input_list[i + 1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "import math\n\ndef is_polite(n):\n    \"\"\"\n    Public API: returns nth polite number (1-based).\n    Validates input and orchestrates generation of the polite number.\n    \"\"\"\n    class InputValidator:\n        \"\"\"\n        Validates input parameters for the polite number function.\n        \"\"\"\n        def validateInteger(self, input_val):\n            if not isinstance(input_val, int):\n                ErrorHandler.raiseInvalidInputError(\"Input 'n' must be an integer.\")\n\n        def validatePositive(self, n_val):\n            if n_val < 1:\n                ErrorHandler.raiseInvalidInputError(\"Input 'n' must be a positive integer (>= 1).\")\n\n    class PoliteNumberGenerator:\n        \"\"\"\n        Generates polite numbers by excluding powers of two.\n        \"\"\"\n        def getNthPolite(self, n_val):\n            count = 0\n            num = 0\n            while count < n_val:\n                num += 1\n                if not self.isPowerOfTwo(num):\n                    count += 1\n            return num\n\n        def nextPoliteAfter(self, value):\n            \"\"\"Returns the next polite number strictly greater than value.\"\"\"\n            num = value\n            while True:\n                num += 1\n                if not self.isPowerOfTwo(num):\n                    return num\n\n        def isPowerOfTwo(self, x):\n            \"\"\"Efficiently checks if x is a power of two.\"\"\"\n            if x <= 0:\n                return False\n            return (x & (x - 1)) == 0\n\n    class PoliteNumber:\n        \"\"\"\n        Data model for a polite number item, storing its index and value.\n        \"\"\"\n        def __init__(self, index, value):\n            self.index = index\n            self.value = value\n\n    class ErrorHandler:\n        \"\"\"\n        Handles and raises errors for invalid inputs.\n        \"\"\"\n        @staticmethod\n        def raiseInvalidInputError(message):\n            raise ValueError(message)\n\n    # Main logic for is_polite(n)\n    validator = InputValidator()\n    generator = PoliteNumberGenerator()\n\n    validator.validateInteger(n)\n    validator.validatePositive(n)\n\n    return generator.getNthPolite(n)"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    total = 0\n    for k in range(1, n + 1):\n        odd_num = 2 * k - 1\n        total += odd_num ** 4\n    return total"}
{"task_id": "Mbpp/769", "solution": "def _filter_not_in(list1, list2):\n    \"\"\"\n    Module-private helper that returns a filtered list of elements from list1 not present in list2.\n    It converts list2 to a set for efficient membership checking.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result\n\ndef Diff(list1, list2):\n    \"\"\"\n    Return list of integers in list1 not present in list2 (value equality semantics for integers).\n    The order of elements from list1 is preserved in the result.\n    \"\"\"\n    return _filter_not_in(list1, list2)"}
{"task_id": "Mbpp/767", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\nclass NumberList:\n    \"\"\"Wrapper for the input list with a length helper.\"\"\"\n    def __init__(self, values: List[Number]):\n        self.values = values\n    def length(self) -> int:\n        return len(self.values)\n\nclass Pair:\n    \"\"\"Represents an index-pair and their sum value.\"\"\"\n    def __init__(self, index_i: int, index_j: int, sum_value: Number):\n        self.index_i = index_i\n        self.index_j = index_j\n        self.sum_value = sum_value\n\nclass Result:\n    \"\"\"Wrapper for the resulting count.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n    def value(self) -> int:\n        return self.count\n\nclass PairCounter:\n    \"\"\"Coordinates validation and counting of pairs.\"\"\"\n    def validate_input(self, numbers, target_sum) -> None:\n        \"\"\"Validates input types and raises TypeError for invalid inputs.\"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n        for num in numbers:\n            if not isinstance(num, (int, float)):\n                raise TypeError(\"All elements in 'numbers' must be numeric (int or float).\")\n        if not isinstance(target_sum, (int, float)):\n            raise TypeError(\"Input 'target_sum' must be numeric (int or float).\")\n\n    def count_pairs(self, numbers, target_sum) -> int:\n        \"\"\"Counts pairs (i < j) whose sum equals target_sum.\"\"\"\n        number_list_wrapper = NumberList(numbers)\n        n = number_list_wrapper.length()\n        if n < 2:\n            return 0\n\n        count = 0\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if numbers[i] + numbers[j] == target_sum:\n                    # Constructing Pair object as per design, though not strictly needed for count logic.\n                    _ = Pair(i, j, numbers[i] + numbers[j])\n                    count += 1\n        return count\n\n    def get_pairs_count(self, numbers, target_sum) -> int:\n        \"\"\"Orchestrates validation and counting, returning the result.\"\"\"\n        self.validate_input(numbers, target_sum)\n        result_count = self.count_pairs(numbers, target_sum)\n        final_result = Result(result_count)\n        return final_result.value()\n\ndef get_pairs_count(numbers, target_sum) -> int:\n    \"\"\"Public API entry. Delegates to PairCounter and returns int count.\"\"\"\n    counter = PairCounter()\n    return counter.get_pairs_count(numbers, target_sum)"}
{"task_id": "Mbpp/771", "solution": "class Stack:\n    \"\"\"\n    Minimal LIFO container providing push/pop/peek/is_empty operations.\n    Internal storage is a list.\n    \"\"\"\n    def __init__(self):\n        self._items = []\n\n    def push(self, item: str) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self) -> str:\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        return self._items.pop()\n\n    def peek(self) -> str | None:\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if the stack is empty, False otherwise.\"\"\"\n        return len(self._items) == 0\n\nclass Bracket:\n    \"\"\"Value object representing a bracket character and whether it is opening.\"\"\"\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n        self.opening = symbol in \"({[\"\n\n    def is_opening(self) -> bool:\n        \"\"\"Returns True if the bracket is an opening bracket, False otherwise.\"\"\"\n        return self.opening\n\nclass CheckExpression:\n    \"\"\"\n    Performs a single-pass scan of the expression string using a Stack\n    to validate matching and LIFO nesting of brackets.\n    \"\"\"\n    def __init__(self):\n        self.stack = Stack()\n        self._bracket_pairs = {')': '(', ']': '[', '}': '{'}\n        self._all_bracket_chars = \"()[]{}\"\n\n    def check(self, expression: str) -> bool:\n        \"\"\"\n        Checks if the given expression has balanced brackets.\n        Non-bracket characters are ignored.\n        \"\"\"\n        for char in expression:\n            if char not in self._all_bracket_chars:\n                continue\n\n            current_bracket = Bracket(char)\n\n            if current_bracket.is_opening():\n                self.stack.push(char)\n            else: # It's a closing bracket\n                if self.stack.is_empty():\n                    return False\n\n                top_of_stack = self.stack.pop()\n                expected_opening = self._bracket_pairs[char]\n\n                if top_of_stack != expected_opening:\n                    return False\n\n        return self.stack.is_empty()\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based algorithm.\n    Non-bracket characters in the expression are ignored.\n    \"\"\"\n    checker = CheckExpression()\n    return checker.check(expression)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string, substring):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_index = main_string.find(substring)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(substring)\n    return (substring, start_index, end_index)"}
{"task_id": "Mbpp/772", "solution": "import re\nfrom typing import List\n\nclass Word:\n    \"\"\"Represents a word and provides methods for its length and removal predicate.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the word, including punctuation.\"\"\"\n        return len(self.text)\n\n    def is_removed(self, k: int) -> bool:\n        \"\"\"Determines if the word should be removed based on its length k.\"\"\"\n        return self.length() == k\n\nclass InputString:\n    \"\"\"Handles raw input text and tokenization into Word instances.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def to_words(self) -> List[Word]:\n        \"\"\"Splits the raw string into words based on whitespace and returns a list of Word objects.\"\"\"\n        # Split on one or more whitespace characters; strip ensures no leading/trailing empty strings from split\n        tokens = re.split(r\"\\s+\", self.raw.strip())\n        return [Word(token) for token in tokens if token]\n\nclass ResultString:\n    \"\"\"Composes filtered Word instances into the final normalized output string.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def word_count(self) -> int:\n        \"\"\"Returns the number of words in the result string.\"\"\"\n        if not self.text:\n            return 0\n        return len(self.text.split(' '))\n\n    @staticmethod\n    def from_words(words: List[Word]) -> 'ResultString':\n        \"\"\"Constructs a ResultString by joining words with a single space and trimming.\"\"\"\n        joined_text = ' '.join([w.text for w in words])\n        trimmed_text = joined_text.strip()\n        return ResultString(trimmed_text)\n\nclass RemoveLengthFunction:\n    \"\"\"Orchestrates the process of removing words of a specific length from a string.\"\"\"\n    def remove_length(self, input_str: str, k: int) -> str:\n        \"\"\"Removes all words with length k from the given string.\"\"\"\n        input_obj = InputString(input_str)\n        all_words = input_obj.to_words()\n        \n        filtered_words = [word for word in all_words if not word.is_removed(k)]\n        \n        result_obj = ResultString.from_words(filtered_words)\n        return result_obj.text\n\ndef remove_length(input_str: str, k: int) -> str:\n    \"\"\"\n    Removes all words with k length in the given string.\n    assert remove_length('The person is most value tet', 3) == 'person is most value'\n    \"\"\"\n    return RemoveLengthFunction().remove_length(input_str, k)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst):\n    \"\"\"\n    Checks if every element at an odd (0-based) index in the list is an odd number.\n    Returns True if the condition holds for all odd indices, False otherwise.\n    \"\"\"\n    def is_odd(value):\n        \"\"\"Returns True if the value is an odd integer, False otherwise.\"\"\"\n        return value % 2 == 1\n\n    for i in range(1, len(lst), 2):\n        if not is_odd(lst[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(nums: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the input list.\n    \"\"\"\n    counts = {}\n    for num in nums:\n        counts[num] = counts.get(num, 0) + 1\n\n    total_sum = 0\n    for num, frequency in counts.items():\n        if frequency == 1:\n            total_sum += num\n            \n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Accepts a list and returns a list of sublists grouping consecutive equal elements.\n    Function does not mutate input_list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = [input_list[0]]\n\n    for elem in input_list[1:]:\n        if elem == current_group[-1]:\n            current_group.append(elem)\n        else:\n            result.append(current_group)\n            current_group = [elem]\n    \n    result.append(current_group)\n    return result"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors of n is even.\n    A number has an even count of divisors if and only if it is not a perfect square.\n    \"\"\"\n    # Calculate the integer square root of n.\n    s = math.isqrt(n)\n    \n    # If n is a perfect square (s*s == n), it has an odd number of divisors.\n    # Otherwise, it has an even number of divisors.\n    return s * s != n"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Accepts a list of integers (arr) and returns the integer totalSum equal to the sum of all odd-length contiguous subarrays.\"\"\"\n    n = len(arr)\n    total_sum = 0\n\n    # Iterate through all possible odd lengths for subarrays\n    for length in range(1, n + 1, 2):\n        # For each odd length, slide a window across the array\n        for i in range(n - length + 1):\n            # Calculate the sum of the current subarray and add it to the total sum\n            subarray_sum = sum(arr[i : i + length])\n            total_sum += subarray_sum\n            \n    return total_sum"}
{"task_id": "Mbpp/780", "solution": "def validate_input(list_of_tuples):\n    \"\"\"\n    Validates the input list: it must be a list of 2-element integer tuples.\n    Raises TypeError on the first validation failure.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, item in enumerate(list_of_tuples):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"List element at index {i} is not a tuple.\")\n        if len(item) != 2:\n            raise TypeError(f\"Tuple at index {i} must have exactly 2 elements.\")\n        if not isinstance(item[0], int) or not isinstance(item[1], int):\n            raise TypeError(f\"Tuple elements at index {i} must be integers.\")\n\ndef generate_pairs(list_of_tuples):\n    \"\"\"\n    Yields unique unordered pairs (tupleA, tupleB) from the input list in nested-iteration order.\n    \"\"\"\n    n = len(list_of_tuples)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            yield (list_of_tuples[i], list_of_tuples[j])\n\ndef sum_pair(tupleA, tupleB):\n    \"\"\"\n    Computes the element-wise sum of two 2-element tuples and returns a new tuple.\n    \"\"\"\n    return (tupleA[0] + tupleB[0], tupleA[1] + tupleB[1])\n\nclass ResultList:\n    \"\"\"\n    A simple collector for result tuples, exposing the collected list via .results.\n    \"\"\"\n    def __init__(self):\n        self.results = []\n\n    def append(self, result_tuple):\n        self.results.append(result_tuple)\n\ndef find_combinations(list_of_tuples):\n    \"\"\"\n    Finds the combinations of sums with tuples in the given tuple list.\n    \"\"\"\n    validate_input(list_of_tuples)\n\n    if len(list_of_tuples) < 2:\n        return []\n\n    collector = ResultList()\n    for a, b in generate_pairs(list_of_tuples):\n        summed_tuple = sum_pair(a, b)\n        collector.append(summed_tuple)\n\n    return collector.results"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(lst: list) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Raises ValueError if either an odd or even number is not found.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in lst:\n        if num % 2 != 0 and first_odd is None:\n            first_odd = num\n        elif num % 2 == 0 and first_even is None:\n            first_even = num\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None or first_even is None:\n        raise ValueError(\"input must contain at least one odd and one even integer\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/785", "solution": "from typing import List, Tuple\nimport re\n\nclass ParseError(Exception):\n    \"\"\"Exception raised for parsing errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass TupleString:\n    \"\"\"Represents the raw input tuple string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass IntegerTuple:\n    \"\"\"Holds parsed integer values.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def to_tuple(self) -> Tuple[int, ...]:\n        \"\"\"Converts the list of integers to a native tuple.\"\"\"\n        return tuple(self.values)\n\nclass TupleParser:\n    \"\"\"Stateless parser for converting tuple strings to IntegerTuple objects.\"\"\"\n    @staticmethod\n    def parse(string: str) -> IntegerTuple:\n        \"\"\"Parses a tuple-formatted string into an IntegerTuple.\"\"\"\n        s = string.strip()\n\n        if not (s.startswith('(') and s.endswith(')')):\n            raise ParseError(f\"Input string must start with '(' and end with ')': '{string}'\")\n\n        content = s[1:-1]\n\n        if not content.strip(): # Handles \"()\" or \"( )\"\n            return IntegerTuple([])\n\n        token_strings = content.split(',')\n        parsed_values: List[int] = []\n\n        for ts in token_strings:\n            trimmed_ts = ts.strip()\n            if not trimmed_ts: # Handles empty tokens like in \"(1, ,2)\" or \"(,)\"\n                raise ParseError(f\"Invalid empty item found in tuple string: '{ts}'\")\n            try:\n                parsed_values.append(int(trimmed_ts))\n            except ValueError:\n                raise ParseError(f\"Invalid integer format in item: '{ts}'\")\n\n        return IntegerTuple(parsed_values)\n\n    @staticmethod\n    def tuple_str_int(string: str) -> Tuple[int, ...]:\n        \"\"\"Converts a tuple string to an integer tuple.\"\"\"\n        integer_tuple = TupleParser.parse(string)\n        return integer_tuple.to_tuple()\n\ndef tuple_str_int(string: str) -> Tuple[int, ...]:\n    \"\"\"Converts a tuple string to an integer tuple.\n    Delegates parsing to the TupleParser class.\n    \"\"\"\n    return TupleParser.tuple_str_int(string)"}
{"task_id": "Mbpp/787", "solution": "class MatchPattern:\n    \"\"\"Provides the literal pattern value 'abbb' used for matching.\"\"\"\n    pattern: str = \"abbb\"\n\nclass TextMatcher:\n    \"\"\"Performs matching logic against a MatchPattern.\"\"\"\n    def __init__(self, pattern: MatchPattern = MatchPattern()):\n        self._pattern = pattern\n\n    def text_match_three(self, input: str) -> bool:\n        \"\"\"Returns True if the literal substring 'abbb' occurs in input.\"\"\"\n        return (self._pattern.pattern in input)\n\ndef text_match_three(input: str) -> bool:\n    \"\"\"Top-level API mandated by SRS: text_match_three(string) -> boolean\"\"\"\n    return TextMatcher().text_match_three(input)"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence, Any\n\ndef right_insertion(sorted_list: Sequence[Any], value: Any) -> int:\n    \"\"\"\n    Locate the right insertion point for a specified value in sorted order.\n    Returns an index such that all elements up to this index are less than or equal to the value,\n    and all elements after this index are greater than the value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else: # value >= sorted_list[mid], ensuring insertion to the right of equals\n            low = mid + 1\n    return low"}
