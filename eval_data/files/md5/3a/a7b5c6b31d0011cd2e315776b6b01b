{"task_id": "Mbpp/474", "solution": "class InputString:\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\n\nclass Character:\n    def __init__(self, value: str):\n        self.value = value\n\n    def isSingle(self) -> bool:\n        return isinstance(self.value, str) and len(self.value) == 1\n\nclass ResultString:\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\n\nclass ReplaceOperation:\n    def __init__(self, target: Character, replacement: Character):\n        self.target = target\n        self.replacement = replacement\n\n    def execute(self, input: InputString) -> ResultString:\n        # Performs global replacement of target.value with replacement.value.\n        new_content = input.content.replace(self.target.value, self.replacement.value)\n        return ResultString(new_content)\n\nclass ReplaceCharFunction:\n    name: str = \"replace_char\"\n\n    def replace(self, input: InputString, target: Character, replacement: Character) -> ResultString:\n        # Validates target and replacement characters, then orchestrates the replacement.\n        if not target.isSingle():\n            raise ValueError(\"Target character must be a single character string.\")\n        if not replacement.isSingle():\n            raise ValueError(\"Replacement character must be a single character string.\")\n\n        if input.content == \"\":\n            return ResultString(\"\")\n        if target.value == replacement.value:\n            return ResultString(input.content)\n\n        op = ReplaceOperation(target, replacement)\n        return op.execute(input)\n\ndef replace_char(input_string, target_char, replacement_char):\n    \"\"\"\n    Replaces all occurrences of a target character with a replacement character in a string.\n    \"\"\"\n    input_obj = InputString(input_string)\n    target_obj = Character(target_char)\n    replacement_obj = Character(replacement_char)\n\n    rcf = ReplaceCharFunction()\n    result_obj = rcf.replace(input_obj, target_obj, replacement_obj)\n\n    return result_obj.content"}
{"task_id": "Mbpp/476", "solution": "from dataclasses import dataclass\nfrom typing import List, Sequence\n\n@dataclass\nclass ArrayInput:\n    \"\"\"Lightweight container for validated array input values.\"\"\"\n    values: List[float]\n\n@dataclass\nclass NumericValue:\n    \"\"\"Represents a single numeric value element.\"\"\"\n    value: float\n\n@dataclass\nclass Result:\n    \"\"\"Represents the returned numeric result.\"\"\"\n    sum: float\n\ndef validate_input(array: Sequence) -> ArrayInput:\n    \"\"\"Validates input and returns ArrayInput(values: List[float]) or raises ValueError.\"\"\"\n    if not array:\n        raise ValueError(\"Input array cannot be empty.\")\n    \n    numeric_values: List[float] = []\n    for item in array:\n        try:\n            numeric_values.append(float(item))\n        except (TypeError, ValueError):\n            raise ValueError(f\"Array contains non-numeric value: {item}\")\n    return ArrayInput(values=numeric_values)\n\ndef compute_min(array: Sequence[float]) -> float:\n    \"\"\"Returns minimum numeric value from array.\"\"\"\n    return min(array)\n\ndef compute_max(array: Sequence[float]) -> float:\n    \"\"\"Returns maximum numeric value from array.\"\"\"\n    return max(array)\n\ndef big_sum(array: Sequence[float]) -> float:\n    \"\"\"Public API: returns min(array) + max(array) after validation.\"\"\"\n    validated_input = validate_input(array)\n    min_val = compute_min(validated_input.values)\n    max_val = compute_max(validated_input.values)\n    return min_val + max_val"}
{"task_id": "Mbpp/478", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Character:\n    char: str\n\n    def isLowercase(self) -> bool:\n        \"\"\"Checks if the character is an ASCII lowercase letter.\"\"\"\n        return 'a' <= self.char <= 'z'\n\n@dataclass\nclass LowercaseSubstring:\n    startIndex: int\n    length: int\n    value: str\n\ndef remove_lowercase(s: str) -> str:\n    \"\"\"Removes all contiguous ASCII lowercase substrings from the input string.\"\"\"\n    if not s:\n        return \"\"\n\n    lowercase_runs = []\n    i = 0\n    while i < len(s):\n        char_obj = Character(s[i])\n        if char_obj.isLowercase():\n            run_start_index = i\n            j = i\n            while j < len(s) and Character(s[j]).isLowercase():\n                j += 1\n            \n            run_length = j - run_start_index\n            run_value = s[run_start_index : j]\n            lowercase_runs.append(LowercaseSubstring(run_start_index, run_length, run_value))\n            i = j # Move i to the end of the detected run\n        else:\n            i += 1 # Move to the next character\n\n    # Compose the output string by skipping the identified runs.\n    result_parts = []\n    current_idx = 0\n    for run in lowercase_runs:\n        result_parts.append(s[current_idx : run.startIndex])\n        current_idx = run.startIndex + run.length\n    \n    result_parts.append(s[current_idx : len(s)]) # Append any remaining characters\n\n    return \"\".join(result_parts)"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(n: int) -> int:\n    \"\"\"\n    Returns the most significant decimal digit of the absolute value of n.\n    Raises TypeError if the input is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"first_Digit expects an int parameter\")\n\n    if n == 0:\n        return 0\n\n    num = abs(n)\n    while num >= 10:\n        num //= 10\n    return num"}
{"task_id": "Mbpp/554", "solution": "from typing import List\n\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd ones while preserving their original order.\n    \"\"\"\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "class Validation:\n    @staticmethod\n    def is_positive_integer(n) -> bool:\n        \"\"\"Checks if n is an integer and n >= 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass SumComputation:\n    @staticmethod\n    def sum_naturals(n) -> int:\n        \"\"\"Calculates the sum of the first n natural numbers using a closed-form formula.\"\"\"\n        return n * (n + 1) // 2\n\n    @staticmethod\n    def sum_cubes(n) -> int:\n        \"\"\"Calculates the sum of the cubes of the first n natural numbers using a closed-form formula.\"\"\"\n        return (n * (n + 1) // 2) ** 2\n\ndef difference(n):\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    if not Validation.is_positive_integer(n):\n        raise ValueError(\"n must be an integer >= 1\")\n    \n    s3 = SumComputation.sum_cubes(n)\n    s1 = SumComputation.sum_naturals(n)\n    \n    return s3 - s1"}
{"task_id": "Mbpp/557", "solution": "class Character:\n    \"\"\"Encapsulates a single character with case toggling behavior.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Checks if the character is alphabetic.\"\"\"\n        return self.char.isalpha()\n\n    def toToggled(self) -> str:\n        \"\"\"Returns the character with its case toggled if alphabetic, otherwise returns itself.\"\"\"\n        if self.isAlphabetic():\n            if self.char.islower():\n                return self.char.upper()\n            else: # Must be uppercase if alphabetic and not lowercase\n                return self.char.lower()\n        return self.char\n\nclass InputString:\n    \"\"\"Represents an input string for processing.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"Represents an output string after processing.\"\"\"\n    def __init__(self, value: str = \"\"):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass ToggleStringFunction:\n    \"\"\"Provides the core logic for toggling character cases in a string.\"\"\"\n    def toggle_string(self, input: InputString) -> OutputString:\n        \"\"\"Processes an InputString to toggle character cases and returns an OutputString.\"\"\"\n        toggled_chars = []\n        for char_str in input.value:\n            character_obj = Character(char_str)\n            toggled_chars.append(character_obj.toToggled())\n        return OutputString(value=\"\".join(toggled_chars))\n\ndef toggle_string(input: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    input_obj = InputString(value=input)\n    toggle_func = ToggleStringFunction()\n    output_obj = toggle_func.toggle_string(input=input_obj)\n    return output_obj.value"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with 0 <= i < j < n\n    where arr[i] XOR arr[j] is odd.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    effective_len = min(n, len(arr))\n\n    if effective_len < 2:\n        return 0\n\n    evens = 0\n    odds = 0\n\n    for i in range(effective_len):\n        if arr[i] % 2 == 0:\n            evens += 1\n        else:\n            odds += 1\n\n    return evens * odds"}
{"task_id": "Mbpp/558", "solution": "class IntegerOperand:\n    \"\"\"Holds an integer value and provides its decimal digits ordered LSB-first.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def to_digits(self) -> list[int]:\n        \"\"\"Converts the integer value into a list of its decimal digits, LSB-first.\"\"\"\n        if self.value == 0:\n            return [0]\n        # Use absolute value as digit distance is independent of sign.\n        abs_value = abs(self.value)\n        digits = []\n        while abs_value > 0:\n            digits.append(abs_value % 10)\n            abs_value //= 10\n        return digits\n\nclass DigitPair:\n    \"\"\"Represents a pair of aligned digits and computes their absolute difference.\"\"\"\n    def __init__(self, digit_a: int, digit_b: int):\n        self.digit_a = digit_a\n        self.digit_b = digit_b\n\n    def diff(self) -> int:\n        \"\"\"Computes the absolute difference between the two digits.\"\"\"\n        return abs(self.digit_a - self.digit_b)\n\nclass Result:\n    \"\"\"Accumulates per-digit differences and provides the final sum.\"\"\"\n    def __init__(self):\n        self.sum = 0\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the accumulated sum.\"\"\"\n        self.sum += value\n\n    def value(self) -> int:\n        \"\"\"Returns the current accumulated sum.\"\"\"\n        return self.sum\n\nclass DigitDistanceCalculator:\n    \"\"\"Orchestrates the computation of the sum of per-digit differences.\"\"\"\n    @staticmethod\n    def digit_distance_nums(a: int, b: int) -> int:\n        \"\"\"\n        Calculates the sum of absolute per-digit differences between two integers.\n        Digits are aligned from the least significant digit (LSB), padding the shorter number with zeros.\n        \"\"\"\n        op_a = IntegerOperand(a)\n        op_b = IntegerOperand(b)\n\n        digits_a = op_a.to_digits()\n        digits_b = op_b.to_digits()\n\n        max_len = max(len(digits_a), len(digits_b))\n\n        # Pad shorter digit list with zeros\n        digits_a.extend([0] * (max_len - len(digits_a)))\n        digits_b.extend([0] * (max_len - len(digits_b)))\n\n        result = Result()\n        for i in range(max_len):\n            pair = DigitPair(digits_a[i], digits_b[i])\n            result.add(pair.diff())\n\n        return result.value()\n\ndef digit_distance_nums(a, b):\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    The sum is computed by aligning digits from the least significant digit (LSB),\n    padding the shorter number with zeros, and summing the absolute differences\n    of corresponding digits.\n    \"\"\"\n    return DigitDistanceCalculator.digit_distance_nums(a, b)"}
{"task_id": "Mbpp/559", "solution": "def validate_length(list_of_integers: list[int], n: int) -> None:\n    \"\"\"Validates that the provided length n matches the actual list length.\"\"\"\n    if n != len(list_of_integers):\n        raise ValueError(\"n does not match list length\")\n\ndef _kadane(list_of_integers: list[int]) -> int:\n    \"\"\"\n    Computes the maximum contiguous subarray sum using Kadane's algorithm.\n    It handles lists with all negative numbers and empty lists correctly.\n    \"\"\"\n    if not list_of_integers:\n        return 0\n\n    max_so_far = list_of_integers[0]\n    current_max = list_of_integers[0]\n\n    for x in list_of_integers[1:]:\n        current_max = max(x, current_max + x)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n\ndef max_sub_array_sum(list_of_integers: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n    It validates the list length and then applies Kadane's algorithm.\n    \"\"\"\n    validate_length(list_of_integers, n)\n    return _kadane(list_of_integers)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(t1, t2):\n    \"\"\"\n    Finds the union of elements from two tuples, returning them in a new sorted tuple.\n    Handles unique elements and maintains input immutability.\n    \"\"\"\n    combined_elements = set(t1).union(set(t2))\n    sorted_elements = sorted(list(combined_elements))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list) -> int:\n    \"\"\"\n    Finds the length of the longest sublist within a given list of lists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in list_of_lists:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    raw: str\n\n@dataclass\nclass ExtractedValue:\n    value: str\n    position: int\n\nclass Parser:\n    _pattern: str = r'\"([^\"]*)\"'\n\n    def __init__(self, pattern: str = None) -> None:\n        if pattern:\n            self._pattern = pattern\n\n    def parse(self, input_str: str) -> List[ExtractedValue]:\n        extracted_values: List[ExtractedValue] = []\n        for i, match in enumerate(re.finditer(self._pattern, input_str)):\n            extracted_values.append(ExtractedValue(value=match.group(1), position=i))\n        return extracted_values\n\nclass Extractor:\n    def __init__(self, parser: Parser = None) -> None:\n        self._parser = parser if parser is not None else Parser()\n\n    def extract_values(self, input_str: str) -> List[str]:\n        extracted_items = self._parser.parse(input_str)\n        return [item.value for item in extracted_items]\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n    \"\"\"\n    extractor = Extractor()\n    return extractor.extract_values(input)"}
{"task_id": "Mbpp/565", "solution": "```python\ndef split(s: str) -> list[str]:\n    \"\"\"\n    Splits a string into a list of single-character strings.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"split expects a single argument of type str\")\n    return [c for c in s]\n```"}
{"task_id": "Mbpp/564", "solution": "class Result:\n    \"\"\"Holds the final count.\"\"\"\n    def __init__(self):\n        self.count: int = 0\n\nclass Element:\n    \"\"\"Represents a single element with its index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass Array:\n    \"\"\"Represents the input list prefix as Element objects and provides length.\"\"\"\n    def __init__(self, raw_elements: list):\n        self.elements: list[Element] = []\n        for idx, val in enumerate(raw_elements):\n            self.elements.append(Element(idx, val))\n        self.length = len(self.elements)\n\n    def get_length(self) -> int:\n        return self.length\n\nclass Pair:\n    \"\"\"Represents an unordered index pair and tests for inequality between values.\"\"\"\n    def __init__(self, i: int, j: int):\n        self.i = i\n        self.j = j\n\n    def unequal(self, a_value: int, b_value: int) -> bool:\n        return a_value != b_value\n\nclass CountPairs:\n    \"\"\"Orchestrates the counting of unequal pairs from a list prefix.\"\"\"\n    def __init__(self, arr: list, n: int):\n        # Calculate effective 'n', handling cases where n > len(arr) or n <= 0.\n        # An effective n of 0 or 1 will result in an empty or single-element array,\n        # which correctly leads to 0 pairs being counted by the loops.\n        n_effective = min(n, len(arr)) if n > 0 else 0\n        self.array = Array(arr[0:n_effective])\n\n    def execute(self) -> int:\n        result = Result()\n        length = self.array.get_length()\n\n        for i in range(length):\n            for j in range(i + 1, length):\n                element_i = self.array.elements[i]\n                element_j = self.array.elements[j]\n                \n                pair = Pair(element_i.index, element_j.index)\n                if pair.unequal(element_i.value, element_j.value):\n                    result.count += 1\n        return result.count\n\ndef count_Pairs(arr, n) -> int:\n    \"\"\"Counts the number of possible unordered pairs where both elements are unequal.\"\"\"\n    counter = CountPairs(arr, n)\n    return counter.execute()"}
{"task_id": "Mbpp/567", "solution": "def issort_list(list) -> bool:\n    \"\"\"Checks if a list is sorted in non-decreasing order without modifying it.\"\"\"\n    if len(list) <= 1:\n        return True\n    for i in range(1, len(list)):\n        if list[i] < list[i-1]:\n            return False\n    return True"}
{"task_id": "Mbpp/566", "solution": "class NonNegativeInteger:\n    def __init__(self, value: int):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the stored value is a non-negative integer.\"\"\"\n        return isinstance(self.value, int) and self.value >= 0\n\nclass Digit:\n    def __init__(self, value: int):\n        self.value = value\n\nclass Result:\n    def __init__(self, value: int):\n        self.value = value\n\nclass SumDigits:\n    def computeSum(self, n: int) -> int:\n        \"\"\"Orchestrates validation, digit extraction, and summation.\"\"\"\n        non_negative_int = NonNegativeInteger(n)\n        if not non_negative_int.isValid():\n            raise ValueError(\"Invalid input: n must be integer >= 0\")\n\n        if n == 0:\n            return 0\n\n        current_n = n\n        total_sum = 0\n        while current_n > 0:\n            digit_value = current_n % 10\n            digit = Digit(digit_value)\n            total_sum += digit.value\n            current_n //= 10\n\n        return Result(total_sum).value\n\ndef sum_digits(n) -> int:\n    \"\"\"Computes the sum of the digits of a non-negative integer.\n    This function validates input and orchestrates the calculation.\n    \"\"\"\n    return SumDigits().computeSum(n)"}
{"task_id": "Mbpp/568", "solution": "def empty_list(n) -> list:\n    \"\"\"\n    Creates a list of N empty and distinct dictionary instances.\n    Raises TypeError if n is not an int, ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    return [dict() for _ in range(n)]"}
{"task_id": "Mbpp/569", "solution": "import collections\nfrom typing import List\n\ndef sort_sublists(list_of_lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists in ascending lexicographic order.\n\n    Preserves the order of the outer list.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in list_of_lists:\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
{"task_id": "Mbpp/573", "solution": "import numbers\n\ndef _validate_input(numbers):\n    \"\"\"\n    Validates that the input is a list and all its elements are numeric.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in numbers:\n        if not isinstance(item, numbers.Number):\n            raise TypeError(\"All elements in the list must be numeric.\")\n\ndef _extract_unique_numbers(numbers):\n    \"\"\"\n    Extracts unique numbers from a list into a set.\n    \"\"\"\n    return set(numbers)\n\ndef _compute_product(unique_numbers):\n    \"\"\"\n    Computes the product of numbers in a set, returning 1 for an empty set.\n    \"\"\"\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product\n\ndef unique_product(numbers):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Handles input validation and returns 1 for an empty list.\n    \"\"\"\n    _validate_input(numbers)\n    unique_nums_set = _extract_unique_numbers(numbers)\n    result = _compute_product(unique_nums_set)\n    return result"}
{"task_id": "Mbpp/572", "solution": "import collections\nfrom typing import Iterable, Iterator, List, Dict\n\nclass InputList:\n    \"\"\"Represents and validates an individual input iterable, providing a deterministic iterator.\"\"\"\n    def __init__(self, items: Iterable):\n        if not isinstance(items, Iterable):\n            raise TypeError(\"Input must be an iterable.\")\n        self._items: List[int] = []\n        for item in items:\n            if not isinstance(item, int):\n                raise TypeError(\"Elements of input iterables must be integers.\")\n            self._items.append(item)\n\n    def iterator(self) -> Iterator[int]:\n        \"\"\"Returns an iterator over the validated items.\"\"\"\n        yield from self._items\n\nclass OccurrenceCounter:\n    \"\"\"Maintains a dictionary mapping integer values to their total occurrence counts.\"\"\"\n    def __init__(self):\n        self.counts: Dict[int, int] = collections.defaultdict(int)\n\n    def increment(self, num: int) -> None:\n        \"\"\"Increments the count for a given integer.\"\"\"\n        self.counts[num] += 1\n\n    def get_count(self, num: int) -> int:\n        \"\"\"Returns the count for a given integer, or 0 if not present.\"\"\"\n        return self.counts[num]\n\nclass ResultList:\n    \"\"\"Collects integers that appear exactly once, preserving first-seen order and ensuring uniqueness.\"\"\"\n    def __init__(self):\n        self._items: List[int] = []\n        self._seen_in_result: set[int] = set()\n\n    def append(self, num: int) -> None:\n        \"\"\"Appends the number if it has not already been included in the result.\"\"\"\n        if num not in self._seen_in_result:\n            self._items.append(num)\n            self._seen_in_result.add(num)\n\n    @property\n    def items(self) -> List[int]:\n        \"\"\"Returns the collected unique items.\"\"\"\n        return self._items\n\nclass TwoUniqueNums:\n    \"\"\"Orchestrates validation, counting, and result construction.\"\"\"\n    def __call__(self, *lists: Iterable) -> List[int]:\n        \"\"\"Callable interface delegating to execute.\"\"\"\n        return self.execute(*lists)\n\n    def execute(self, *lists: Iterable) -> List[int]:\n        \"\"\"Performs validation, counting, and result construction.\"\"\"\n        if not lists:\n            return []\n\n        input_lists: List[InputList] = []\n        for lst in lists:\n            input_lists.append(InputList(lst))\n\n        counter = OccurrenceCounter()\n        for input_list in input_lists:\n            for num in input_list.iterator():\n                counter.increment(num)\n\n        result_list = ResultList()\n        for input_list in input_lists:\n            for num in input_list.iterator():\n                if counter.get_count(num) == 1:\n                    result_list.append(num)\n\n        return result_list.items\n\ndef two_unique_nums(*lists: Iterable) -> List[int]:\n    \"\"\"Public API: accepts one or more iterables of integers and returns list[int] of numbers appearing exactly once.\"\"\"\n    return TwoUniqueNums().__call__(*lists)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a: list, list_b: list) -> bool:\n    \"\"\"\n    Parameters:\n      list_a: list\n      list_b: list\n    Returns:\n      bool\n    Behavior: Returns True iff list_b is a contiguous sublist of list_a. Does not modify inputs.\n    \"\"\"\n    len_a = len(list_a)\n    len_b = len(list_b)\n\n    if len_b == 0:\n        return True\n    if len_b > len_a:\n        return False\n\n    for i in range(len_a - len_b + 1):\n        if list_a[i : i + len_b] == list_b:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "def computeFactorial(n: int) -> int:\n    \"\"\"\n    Computes and returns the factorial of n.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n    factorial_value = 1\n    for i in range(1, n + 1):\n        factorial_value *= i\n    return factorial_value\n\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit in the factorial of a given number n.\n    It computes n! and then returns the result modulo 10.\n    \"\"\"\n    factorial_value = computeFactorial(n)\n    return factorial_value % 10"}
{"task_id": "Mbpp/579", "solution": "class Element:\n    \"\"\"Wrapper for a single element value; implements equals using Python equality semantics.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def equals(self, other):\n        \"\"\"Compares this element's value with another element's value.\"\"\"\n        return self.value == other.value\n\nclass EqualityComparator:\n    \"\"\"Provides equality comparison semantics delegating to Element.equals.\"\"\"\n    def equals(self, a: Element, b: Element) -> bool:\n        \"\"\"Compares two Element objects for equality.\"\"\"\n        return a.equals(b)\n\nclass Tuple:\n    \"\"\"Minimal wrapper for an input Python tuple, exposing iteration and membership via equality semantics.\"\"\"\n    def __init__(self, raw_tuple):\n        self._elements = [Element(item) for item in raw_tuple]\n\n    def contains(self, target_element: Element, comparator: EqualityComparator) -> bool:\n        \"\"\"Checks if the tuple contains a given element using the provided comparator.\"\"\"\n        for element_in_tuple in self._elements:\n            if comparator.equals(element_in_tuple, target_element):\n                return True\n        return False\n\n    def __iter__(self):\n        \"\"\"Returns an iterator over the wrapped Element objects.\"\"\"\n        return iter(self._elements)\n\nclass ResultTuple:\n    \"\"\"Collects result elements during computation and produces the final immutable tuple result.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, element: Element):\n        \"\"\"Appends an Element to the result collection.\"\"\"\n        self._elements.append(element)\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the collected Element objects to a native Python tuple of their values.\"\"\"\n        return tuple(e.value for e in self._elements)\n\nclass FindDissimilarFunction:\n    \"\"\"Encapsulates the algorithm to compute the ResultTuple given two Tuple wrappers.\"\"\"\n    def __init__(self):\n        self._comparator = EqualityComparator()\n\n    def execute(self, tupleA: Tuple, tupleB: Tuple) -> ResultTuple:\n        \"\"\"Computes the symmetric difference of two Tuple objects.\"\"\"\n        result_tuple = ResultTuple()\n        elements_in_result_values = set()\n\n        for element_a in tupleA:\n            if not tupleB.contains(element_a, self._comparator):\n                if element_a.value not in elements_in_result_values:\n                    result_tuple.append(element_a)\n                    elements_in_result_values.add(element_a.value)\n\n        for element_b in tupleB:\n            if not tupleA.contains(element_b, self._comparator):\n                if element_b.value not in elements_in_result_values:\n                    result_tuple.append(element_b)\n                    elements_in_result_values.add(element_b.value)\n\n        return result_tuple\n\ndef find_dissimilar(tupleA, tupleB):\n    \"\"\"\n    Finds the dissimilar elements in two given tuples, returning elements\n    present in exactly one of the inputs, preserving relative order.\n    \"\"\"\n    wrapped_tupleA = Tuple(tupleA)\n    wrapped_tupleB = Tuple(tupleB)\n    function_engine = FindDissimilarFunction()\n    result_tuple_wrapper = function_engine.execute(wrapped_tupleA, wrapped_tupleB)\n    return result_tuple_wrapper.to_tuple()"}
{"task_id": "Mbpp/578", "solution": "class LengthMismatchError(Exception):\n    \"\"\"Exception raised when input lists do not have equal lengths.\"\"\"\n    def __init__(self, message: str = \"Input lists must have the same length.\"):\n        super().__init__(message)\n        self.message = message\n\nclass InputList:\n    \"\"\"Lightweight wrapper representing an input list.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\nclass InterleavedList:\n    \"\"\"Container for interleaved elements.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, value) -> None:\n        self._elements.append(value)\n    \n    @property\n    def elements(self) -> list:\n        return self._elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\nclass Validator:\n    \"\"\"Validates input types and lengths.\"\"\"\n    def validate_types(self, list1, list2, list3) -> None:\n        \"\"\"Ensure each argument is list-like; raise TypeError if not.\"\"\"\n        if not isinstance(list1, list):\n            raise TypeError(\"Argument 'list1' must be a list.\")\n        if not isinstance(list2, list):\n            raise TypeError(\"Argument 'list2' must be a list.\")\n        if not isinstance(list3, list):\n            raise TypeError(\"Argument 'list3' must be a list.\")\n\n    def validate_same_length(self, list1, list2, list3) -> None:\n        \"\"\"Ensure lists are of equal length; raise LengthMismatchError if not.\"\"\"\n        len1 = len(list1)\n        len2 = len(list2)\n        len3 = len(list3)\n        if not (len1 == len2 == len3):\n            raise LengthMismatchError(f\"Input lists must have the same length. Got {len1}, {len2}, {len3}.\")\n\nclass Interleaver:\n    \"\"\"Performs the interleaving operation.\"\"\"\n    def interleave_lists(self, list1: list, list2: list, list3: list) -> InterleavedList:\n        \"\"\"Interleaves three equal-length lists into an InterleavedList.\"\"\"\n        interleaved = InterleavedList()\n        n = len(list1)\n        for i in range(n):\n            interleaved.append(list1[i])\n            interleaved.append(list2[i])\n            interleaved.append(list3[i])\n        return interleaved\n\ndef interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves 3 lists of the same length into a single flat list.\n    Validates inputs and returns the interleaved plain list or raises an error.\n    \"\"\"\n    validator = Validator()\n    validator.validate_types(list1, list2, list3)\n    validator.validate_same_length(list1, list2, list3)\n\n    interleaver = Interleaver()\n    interleaved_result = interleaver.interleave_lists(list1, list2, list3)\n    \n    return interleaved_result.elements"}
{"task_id": "Mbpp/580", "solution": "def _is_even(n: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return n % 2 == 0\n\ndef _filter_tuple_recursive(obj):\n    \"\"\"Recursively filters odd integers from nested tuples, preserving structure.\"\"\"\n    if isinstance(obj, int):\n        return (obj,) if _is_even(obj) else ()\n    # If obj is not an int, it is assumed to be a tuple per design context (ignoring error handling).\n    result_items = []\n    for element in obj:\n        if isinstance(element, int):\n            if _is_even(element):\n                result_items.append(element)\n        # If element is not an int, it is assumed to be a tuple.\n        else: # element is a tuple\n            nested_result = _filter_tuple_recursive(element)\n            if nested_result:\n                result_items.append(nested_result)\n    return tuple(result_items)\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes uneven (odd) elements from a nested mixed tuple,\n    preserving structure and relative order of remaining even elements.\n    \"\"\"\n    # The design context implies input_tuple is always a tuple.\n    return _filter_tuple_recursive(input_tuple)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"Compute and return total surface area of a square pyramid.\n    The 'height' parameter is interpreted as the pyramid's slant height.\n    \"\"\"\n    base_area = base_edge ** 2\n    lateral_area = 2 * base_edge * height\n    total_area = base_area + lateral_area\n    return total_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number (zero-based) using dynamic programming.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    def _validate_input(n: int) -> None:\n        \"\"\"Validates that n is an integer and n >= 0.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _compute_dp(n: int) -> int:\n        \"\"\"Computes the nth Catalan number using bottom-up dynamic programming.\"\"\"\n        if n == 0:\n            return 1\n\n        dp = [0] * (n + 1)\n        dp[0] = 1\n\n        for k in range(1, n + 1):\n            current_catalan = 0\n            for i in range(k):\n                current_catalan += dp[i] * dp[k - 1 - i]\n            dp[k] = current_catalan\n        \n        return dp[n]\n\n    _validate_input(n)\n    return _compute_dp(n)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset, n):\n    \"\"\"\n    Finds the n most expensive items in a dataset, sorted by price in descending order.\n    Returns an empty list if n is less than or equal to 0.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Sort the dataset by 'price' in descending order\n    sorted_dataset = sorted(dataset, key=lambda item: item['price'], reverse=True)\n\n    # Return the first n items\n    return sorted_dataset[:n]"}
