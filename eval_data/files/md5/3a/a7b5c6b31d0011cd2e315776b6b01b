{"task_id": "Mbpp/247", "solution": "class InputString:\n    \"\"\"Encapsulates the input string value.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass LPSResult:\n    \"\"\"Encapsulates the integer result of the LPS computation.\"\"\"\n    def __init__(self, length: int):\n        self.length: int = length\n\nclass PalindromicSubsequenceService:\n    \"\"\"Computes the length of the longest palindromic subsequence.\"\"\"\n\n    def lps(self, s: str) -> int:\n        \"\"\"Computes and returns integer length of longest palindromic subsequence for s.\"\"\"\n        computed_length = self._compute_lps_dp(s)\n        result_obj = LPSResult(computed_length)\n        return result_obj.length\n\n    def _compute_lps_dp(self, s: str) -> int:\n        \"\"\"Performs DP computation; returns integer length.\"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n        \n        # dp[i][j] stores the length of the longest palindromic subsequence of s[i...j]\n        dp = [[0] * n for _ in range(n)]\n\n        # All single characters are palindromic subsequences of length 1\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the table for lengths greater than 1\n        # `gap` represents the difference between j and i (length of substring - 1)\n        for gap in range(1, n):\n            for i in range(n - gap):\n                j = i + gap\n                if s[i] == s[j]:\n                    if gap == 1:\n                        dp[i][j] = 2\n                    else:\n                        dp[i][j] = 2 + dp[i+1][j-1]\n                else:\n                    dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n        \n        # The length of the LPS for the entire string s[0...n-1]\n        return dp[0][n-1]\n\ndef lps(s: str) -> int:\n    \"\"\"Public API for finding the length of the longest palindromic subsequence.\"\"\"\n    service = PalindromicSubsequenceService()\n    return service.lps(s)"}
{"task_id": "Mbpp/245", "solution": "import numbers\n\ndef validate_input(array):\n    \"\"\"\n    Validates the input array type and its elements.\n    Raises TypeError if input is not a list or tuple, or ValueError if any element is non-numeric.\n    \"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n    for i, x in enumerate(array):\n        if not isinstance(x, numbers.Number):\n            raise ValueError(f\"Array element at index {i} is not a number: {x}\")\n\ndef compute_lis_sums(array):\n    \"\"\"\n    Computes the maximum sum of strictly increasing subsequences ending at each index.\n    Returns a list where lis_sums[i] is the maximum sum of such a subsequence ending at array[i].\n    \"\"\"\n    n = len(array)\n    if n == 0:\n        return []\n\n    lis_sums = [float(x) for x in array] # Initialize with individual element sums\n\n    for i in range(n):\n        for j in range(i):\n            if array[j] < array[i]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + array[i])\n    return lis_sums\n\ndef compute_lds_sums(array):\n    \"\"\"\n    Computes the maximum sum of strictly decreasing subsequences starting at each index.\n    Returns a list where lds_sums[i] is the maximum sum of such a subsequence starting at array[i].\n    \"\"\"\n    n = len(array)\n    if n == 0:\n        return []\n\n    lds_sums = [float(x) for x in array] # Initialize with individual element sums\n\n    for i in range(n - 1, -1, -1):\n        for j in range(i + 1, n):\n            if array[j] < array[i]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + array[i])\n    return lds_sums\n\ndef combine_bitonic_sums(lis_sums, lds_sums, array):\n    \"\"\"\n    Combines LIS and LDS sums to find the maximum bitonic subsequence sum.\n    It takes the sum for each index `i` as `lis_sums[i] + lds_sums[i] - array[i]` to avoid double-counting the peak element.\n    \"\"\"\n    n = len(array)\n    # This function is called only if n > 0.\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - array[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n    \n    return max_bitonic_sum\n\ndef max_sum(array):\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    validate_input(array)\n\n    if not array:\n        return 0\n\n    lis_sums = compute_lis_sums(array)\n    lds_sums = compute_lds_sums(array)\n\n    return combine_bitonic_sums(lis_sums, lds_sums, array)"}
{"task_id": "Mbpp/251", "solution": "def insert_element(lst, elem) -> list:\n    \"\"\"Inserts an element before each element in a list and returns the resulting new list.\"\"\"\n    result = []\n    for item in lst:\n        result.append(elem)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/253", "solution": "def count_integer(input_list):\n    \"\"\"Return the number of elements in input_list whose exact Python type is int.\n    Raises TypeError if input_list is not a list instance.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    count = 0\n    for element in input_list:\n        if type(element) is int:\n            count += 1\n    return count"}
{"task_id": "Mbpp/252", "solution": "import math\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\nclass PolarCoordinate:\n    \"\"\"Represents polar coordinates with magnitude (r) and argument (theta).\"\"\"\n    def __init__(self, r: float, theta: float):\n        self.r = r\n        self.theta = theta\n\nclass Validator:\n    \"\"\"Validates input type and normalizes to a ComplexNumber.\"\"\"\n    def validate(self, value) -> ComplexNumber:\n        if isinstance(value, (int, float)):\n            return ComplexNumber(float(value), 0.0)\n        elif isinstance(value, complex):\n            return ComplexNumber(float(value.real), float(value.imag))\n        else:\n            raise TypeError(\"Input must be an int, float, or complex number.\")\n\nclass MathUtils:\n    \"\"\"Provides numerically stable computations for magnitude and argument.\"\"\"\n    def magnitude(self, c: ComplexNumber) -> float:\n        return math.hypot(c.real, c.imag)\n\n    def argument(self, c: ComplexNumber) -> float:\n        return math.atan2(c.imag, c.real)\n\nclass Converter:\n    \"\"\"Orchestrates validation and numeric computations to produce polar coordinates.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n        self._math = MathUtils()\n\n    def convert(self, value) -> (float, float):\n        complex_num = self._validator.validate(value)\n        r = self._math.magnitude(complex_num)\n        theta = self._math.argument(complex_num)\n        return (float(r), float(theta))\n\ndef convert(value):\n    \"\"\"Converts a complex number, int, or float to polar coordinates (r, theta).\"\"\"\n    converter_instance = Converter()\n    return converter_instance.convert(value)"}
{"task_id": "Mbpp/255", "solution": "import collections\n\ndef combinations_colors(items, n):\n    \"\"\"\n    Generates all combinations (with repetition) of elements from 'items'\n    of length 'n', returning them as a list of tuples.\n    \"\"\"\n    if not isinstance(items, (list, tuple, collections.abc.Sequence)):\n        raise TypeError(\"Input 'items' must be a sequence or list.\")\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return [()]\n    if not items and n > 0:\n        return []\n\n    # Use a generator to yield combinations, then convert to list\n    def _generate_combinations(current_combination, start_index):\n        if len(current_combination) == n:\n            yield tuple(current_combination)\n            return\n\n        for i in range(start_index, len(items)):\n            current_combination.append(items[i])\n            yield from _generate_combinations(current_combination, i)\n            current_combination.pop() # Backtrack\n\n    results = list(_generate_combinations([], 0))\n    return results"}
{"task_id": "Mbpp/256", "solution": "\"\"\"Provides count_Primes_nums(n) -> int per SRS; raises ValueError for invalid inputs (non-numeric or negative).\"\"\"\nimport math\nfrom typing import Union\n\ndef is_non_negative(n: Union[int, float]) -> bool:\n    \"\"\"Checks if the input n is a non-negative number.\"\"\"\n    return isinstance(n, (int, float)) and n >= 0\n\ndef is_prime(k: int) -> bool:\n    \"\"\"Checks if an integer k (greater than 1) is a prime number using trial division.\"\"\"\n    if k <= 1:\n        return False\n    if k <= 3: # 2 and 3 are prime\n        return True\n    if k % 2 == 0 or k % 3 == 0:\n        return False\n    \n    i = 5\n    while i * i <= k:\n        if k % i == 0 or k % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef count_Primes_nums(n: Union[int, float]) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than a given non-negative number n.\n    Raises ValueError if n is not a non-negative number.\n    \"\"\"\n    if not is_non_negative(n):\n        raise ValueError(\"n must be a non-negative number\")\n\n    count = 0\n    # Primes are numbers >= 2. We need primes < n, so check candidates from 2 up to floor(n) - 1.\n    # int(n) gives floor(n) for non-negative numbers.\n    upper_limit_exclusive = int(n) \n    \n    for k in range(2, upper_limit_exclusive):\n        if is_prime(k):\n            count += 1\n            \n    return count"}
