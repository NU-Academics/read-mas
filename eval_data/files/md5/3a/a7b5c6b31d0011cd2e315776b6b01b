{"task_id": "Mbpp/439", "solution": "def multiple_to_single(list_of_integers):\n    \"\"\"Validate list_of_integers (all ints), concatenate decimal strings in order, convert to int, and return that int. Raises TypeError if any element is not int.\"\"\"\n\n    def _validate_all_integers(items):\n        \"\"\"Iterate items; raise TypeError on first non-int element.\"\"\"\n        for item in items:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def _concatenate_decimal_strings(items) -> str:\n        \"\"\"Convert each int to its decimal string and concatenate them.\"\"\"\n        return \"\".join(str(item) for item in items)\n\n    def _convert_concatenated_to_int(concatenated_str) -> int:\n        \"\"\"Convert a numeric string to an integer.\"\"\"\n        return int(concatenated_str)\n\n    _validate_all_integers(list_of_integers)\n    concatenated_str = _concatenate_decimal_strings(list_of_integers)\n    result_int = _convert_concatenated_to_int(concatenated_str)\n    return result_int"}
{"task_id": "Mbpp/440", "solution": "import re\n\nclass Sentence:\n    \"\"\"Represents a sentence with its text and provides character access.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\n    def char_at(self, i: int) -> str:\n        return self.text[i]\n\nclass Word:\n    \"\"\"Represents a word token with its raw text, alphabetic-only part, and original indices.\"\"\"\n    def __init__(self, raw: str, alpha_only: str, start_index: int, end_index: int):\n        self.raw = raw\n        self.alpha_only = alpha_only\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def is_alpha_only(self) -> bool:\n        return bool(self.alpha_only) and self.alpha_only.isalpha()\n\n    def ends_with_ly(self) -> bool:\n        return self.alpha_only.lower().endswith('ly')\n\nclass Adverb:\n    \"\"\"Represents an identified adverb with its text and original indices.\"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int):\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass Tokenizer:\n    \"\"\"Tokenizes a sentence into Word objects, extracting alphabetic parts and preserving indices.\"\"\"\n    def tokenize(self, sentence: \"Sentence\") -> list:  # returns List[Word]\n        words = []\n        current_index = 0\n        for match in re.finditer(r'\\S+', sentence.text):\n            raw_token = match.group(0)\n            token_start = match.start()\n            token_end = match.end()\n\n            alpha_start = -1\n            alpha_end = -1\n            \n            # Find first alphabetic character\n            for i in range(len(raw_token)):\n                if raw_token[i].isalpha():\n                    alpha_start = token_start + i\n                    break\n            \n            # Find last alphabetic character\n            if alpha_start != -1: # Only proceed if an alphabetic char was found\n                for i in range(len(raw_token) - 1, -1, -1):\n                    if raw_token[i].isalpha():\n                        alpha_end = token_start + i + 1 # exclusive end index\n                        break\n\n            if alpha_start != -1 and alpha_end != -1:\n                alpha_only = sentence.text[alpha_start:alpha_end]\n                words.append(Word(raw_token, alpha_only, alpha_start, alpha_end))\n        return words\n\nclass AdverbFinder:\n    \"\"\"Finds the first adverb in a sentence using a Tokenizer.\"\"\"\n    def find_first_adverb(self, sentence: \"Sentence\") -> \"Adverb\" | None:\n        tokenizer = Tokenizer()\n        words = tokenizer.tokenize(sentence)\n        for word in words:\n            if word.is_alpha_only() and word.ends_with_ly():\n                return Adverb(word.alpha_only, word.start_index, word.end_index)\n        return None\n\ndef find_adverb_position(sentence: str) -> (int, int, str) | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    An adverb is defined as an alphabetic-only word ending in 'ly' (case-insensitive).\n    \"\"\"\n    sentence_obj = Sentence(sentence)\n    finder = AdverbFinder()\n    adverb = finder.find_first_adverb(sentence_obj)\n\n    if adverb:\n        return (adverb.start_index, adverb.end_index, adverb.text)\n    return None"}
{"task_id": "Mbpp/441", "solution": "class Cube:\n    \"\"\"\n    Represents a cube with a given side length.\n    Initializes sideLength and a placeholder for surfaceArea.\n    \"\"\"\n    def __init__(self, sideLength: float):\n        self.sideLength = float(sideLength)\n        self.surfaceArea = 0.0\n\nclass InputValidator:\n    \"\"\"\n    Provides methods to validate if a value is numeric (integer or float).\n    \"\"\"\n    def isNumeric(self, value) -> bool:\n        return isinstance(value, (int, float))\n\nclass SurfaceAreaCalculator:\n    \"\"\"\n    Calculates the surface area of a cube.\n    Uses the formula 6 * side_length^2.\n    \"\"\"\n    NUM_FACES = 6\n\n    def computeSurfaceArea(self, cube: Cube) -> float:\n        area = self.NUM_FACES * (cube.sideLength ** 2)\n        cube.surfaceArea = area\n        return area\n\ndef surfacearea_cube(size):\n    \"\"\"\n    Calculates the surface area of a cube.\n    Validates the input and uses helper classes for computation.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isNumeric(size):\n        raise TypeError(\"Side length must be a numeric value (int or float).\")\n\n    cube = Cube(sideLength=size)\n    calculator = SurfaceAreaCalculator()\n    surface_area = calculator.computeSurfaceArea(cube)\n\n    return surface_area"}
