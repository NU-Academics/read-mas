{"task_id": "Mbpp/77", "solution": "def is_Diff(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is divisible by 11.\n    Raises TypeError if the input is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    return n % 11 == 0"}
{"task_id": "Mbpp/85", "solution": "class MathConstants:\n    PI: float = 3.141592653589793\n\nclass Sphere:\n    def __init__(self, radius: float) -> None:\n        self.radius: float = float(radius)\n\n    def surface_area(self) -> float:\n        return 4.0 * MathConstants.PI * (self.radius ** 2)\n\nclass SurfaceAreaService:\n    def surfacearea_sphere(self, radius: float) -> float:\n        s = Sphere(float(radius))\n        return float(s.surface_area())\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Computes the surface area of a sphere using the formula 4 * PI * radius^2.\"\"\"\n    service = SurfaceAreaService()\n    return service.surfacearea_sphere(radius)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n):\n    \"\"\"Computes the nth centered hexagonal number. Raises ValueError if n is not an integer or n < 1.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/84", "solution": "class ErrorResult:\n    \"\"\"Represents error information with a message and a code.\"\"\"\n    def __init__(self, message: str, code: int) -> None:\n        self.message = message\n        self.code = code\n\nclass InputValidator:\n    \"\"\"Validates if an input value is a positive integer.\"\"\"\n    def isValidNumber(self, value) -> bool:\n        \"\"\"Checks if the value is an integer and is greater than or equal to 1.\"\"\"\n        return isinstance(value, int) and value >= 1\n\n    def assertValid(self, value) -> None:\n        \"\"\"Raises a ValueError if the value is not a valid positive integer.\"\"\"\n        if not self.isValidNumber(value):\n            error_msg = \"\"\n            if not isinstance(value, int):\n                error_msg = f\"Input must be an integer, but received type {type(value).__name__}.\"\n            elif value < 1:\n                error_msg = f\"Input must be greater than or equal to 1, but received {value}.\"\n            raise ValueError(ErrorResult(error_msg, 400).message)\n\nclass NewmanConwayCalculator:\n    \"\"\"Calculates Newman-Conway sequence numbers with memoization.\"\"\"\n    def __init__(self) -> None:\n        self.cache: dict[int, int] = {1: 1, 2: 1}\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Newman-Conway number using memoized recursion.\"\"\"\n        if n in self.cache:\n            return self.cache[n]\n\n        # Recurrence: a(n) = a(a(n-1)) + a(n - a(n-1))\n        an_minus_1 = self.compute(n - 1)\n        term1 = self.compute(an_minus_1)\n        term2 = self.compute(n - an_minus_1)\n        \n        result = term1 + term2\n        self.cache[n] = result\n        return result\n\nclass SequenceFunction:\n    \"\"\"Facade for Newman-Conway sequence operations, coordinating validation and computation.\"\"\"\n    def __init__(self) -> None:\n        self.validator = InputValidator()\n        self.calculator = NewmanConwayCalculator()\n\n    def sequence(self, n: int) -> int:\n        \"\"\"Validates input and computes the nth Newman-Conway number.\"\"\"\n        self.validator.assertValid(n)\n        return self.calculator.compute(n)\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence using a facade.\n    The sequence is defined by a(1)=1, a(2)=1, and a(n)=a(a(n-1))+a(n-a(n-1)) for n>2.\n    \"\"\"\n    facade = SequenceFunction()\n    return facade.sequence(n)"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom datetime import datetime\n\nclass Sphere:\n    def __init__(self, r) -> None:\n        if not isinstance(r, (int, float)):\n            raise TypeError(\"Radius must be a numeric value.\")\n        if r < 0:\n            raise ValueError(\"Radius cannot be negative.\")\n        self.radius = float(r)\n\n    def getRadius(self) -> float:\n        return self.radius\n\n    def setRadius(self, r) -> None:\n        if not isinstance(r, (int, float)):\n            raise TypeError(\"Radius must be a numeric value.\")\n        if r < 0:\n            raise ValueError(\"Radius cannot be negative.\")\n        self.radius = float(r)\n\nclass MathConstants:\n    PI = math.pi\n\nclass VolumeCalculator:\n    @staticmethod\n    def volume_sphere(r) -> float:\n        return VolumeCalculator.computeUsingFormula(r)\n\n    @staticmethod\n    def computeUsingFormula(r) -> float:\n        # V = (4/3) * pi * r^3\n        return (4.0 / 3.0) * MathConstants.PI * (r ** 3)\n\nclass CALCULATION:\n    def __init__(self, functionName: str, inputRadius: float, outputVolume: float, timestamp: str) -> None:\n        self.functionName = functionName\n        self.inputRadius = inputRadius\n        self.outputVolume = outputVolume\n        self.timestamp = timestamp\n\ndef volume_sphere(r) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    Validates input and uses a precise PI constant for computation.\n    \"\"\"\n    sphere_instance = Sphere(r)\n    result = VolumeCalculator.volume_sphere(sphere_instance.getRadius())\n    \n    # Optional: create a CALCULATION record for logging purposes\n    # calculation_record = CALCULATION(\"volume_sphere\", sphere_instance.getRadius(), result, datetime.now().isoformat())\n    \n    return float(result)"}
{"task_id": "Mbpp/80", "solution": "class InputValidationError(ValueError):\n    \"\"\"Represents validation errors for invalid input.\n    Provides a custom message for the error.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass Validator:\n    \"\"\"Stateless checks for input positivity and integer type.\n    Determines if an input 'n' is a positive integer.\"\"\"\n    def isPositiveInteger(self, n) -> bool:\n        \"\"\"Returns True if n is an int and n >= 1, False otherwise.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass Formula:\n    \"\"\"Encapsulates the tetrahedral number formula.\n    Performs exact integer arithmetic for computation.\"\"\"\n    expression: str = \"n*(n+1)*(n+2)/6\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth tetrahedral number using the formula n*(n+1)*(n+2)//6.\"\"\"\n        return (n * (n + 1) * (n + 2)) // 6\n\nclass InputParameter:\n    \"\"\"Holds and validates the input parameter 'n'.\n    Uses a Validator to ensure 'n' is a positive integer.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates the stored 'n'; raises InputValidationError if invalid.\n        Validation is done using the isPositiveInteger method of a Validator instance.\"\"\"\n        validator = Validator()\n        if not validator.isPositiveInteger(self.n):\n            raise InputValidationError(\"Input n must be a positive integer (n >= 1).\")\n\nclass TetrahedralFunction:\n    \"\"\"Orchestrates validation and computation of tetrahedral numbers.\n    It combines validation via InputParameter and computation via Formula.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n        self._formula = Formula()\n\n    def tetrahedral_number(self, n) -> int:\n        \"\"\"Validates 'n', computes T(n), and returns the integer result.\n        Raises InputValidationError for invalid inputs.\"\"\"\n        input_param = InputParameter(n)\n        input_param.validate()\n\n        result_value = self._formula.compute(n)\n        return result_value\n\nclass Result:\n    \"\"\"A simple data holder for a computed integer value.\n    Encapsulates the final integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass TestCase:\n    \"\"\"Encapsulates and provides a method to run a specific test case.\n    It verifies the tetrahedral_number function for n=5.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n\n    def run(self) -> bool:\n        \"\"\"Calls tetrahedral_number(5) and asserts it equals 35.\n        Returns True on pass, raises AssertionError on failure.\"\"\"\n        computed = tetrahedral_number(5)\n        if computed == 35:\n            return True\n        else:\n            raise AssertionError(f\"Test case '{self.name}' failed: tetrahedral_number(5) expected 35, got {computed}\")\n\ndef tetrahedral_number(n) -> int:\n    \"\"\"Finds the nth tetrahedral number.\n    Accepts a positive integer n and returns the corresponding integer result.\"\"\"\n    tetra_func_calculator = TetrahedralFunction()\n    return tetra_func_calculator.tetrahedral_number(n)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict_a: dict, dict_b: dict, dict_c: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary, applying a \"first observed value\" policy for duplicate keys.\n    If a key exists in multiple dictionaries, the value from the dictionary processed first is retained.\n    \"\"\"\n    merged_dict = {}\n\n    # Iterate through dict_a and add its items if the key is not already present.\n    for key, value in dict_a.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    # Iterate through dict_b and add its items if the key is not already present.\n    for key, value in dict_b.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    # Iterate through dict_c and add its items if the key is not already present.\n    for key, value in dict_c.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    return merged_dict"}
