{"task_id": "Mbpp/282", "solution": "def sub_list(a, b):\n    \"\"\"\n    Subtracts two lists element-wise.\n    Raises ValueError if lists have different lengths.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(a)):\n        result.append(a[i] - b[i])\n    return result"}
{"task_id": "Mbpp/283", "solution": "import collections\n\ndef validate(n: int) -> bool:\n    \"\"\"Validate digit-frequency rule for the absolute value of the input integer.\n    Return True if each digit's frequency is less than or equal to its value.\n    \"\"\"\n    s_n = str(abs(n))\n    digit_counts = collections.Counter(s_n)\n\n    for digit_char, count in digit_counts.items():\n        digit_value = int(digit_char)\n        if count > digit_value:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Searches for an element in an array using a sequential scan.\n    Returns a tuple (found: bool, index: int) indicating if the element was found and its first index, or -1 if not found.\n    \"\"\"\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
