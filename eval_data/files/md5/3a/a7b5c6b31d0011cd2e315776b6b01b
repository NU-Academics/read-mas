{"task_id": "Mbpp/794", "solution": "def text_starta_endb(input: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a' and ends with 'b', allowing any characters in between.\n    Returns False for an empty string.\n    \"\"\"\n    if not input:\n        return False\n    return input[0] == 'a' and input[-1] == 'b'"}
{"task_id": "Mbpp/793", "solution": "def last(array, element):\n    \"\"\"Finds the last position of an element in a sorted array using binary search.\n    Returns -1 if the element is not found.\"\"\"\n    n = len(array)\n    low = 0\n    high = n - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == element:\n            result = mid  # Found a potential last occurrence\n            low = mid + 1 # Try to find an even later occurrence in the right half\n        elif array[mid] < element:\n            low = mid + 1 # Element must be in the right half\n        else: # array[mid] > element\n            high = mid - 1 # Element must be in the left half\n            \n    return result"}
{"task_id": "Mbpp/796", "solution": "class SumResult:\n    \"\"\"Immutable value object representing the numeric total.\"\"\"\n    def __init__(self, total: float):\n        self.total = total\n    def get_total(self) -> float:\n        return self.total\n\nclass ReturnSumFunction:\n    \"\"\"Computes the sum of all numeric values in a dictionary.\"\"\"\n    def return_sum(self, input_dict: dict) -> float:\n        total_sum = sum(input_dict.values())\n        result_obj = SumResult(total_sum)\n        return result_obj.get_total()\n\ndef return_sum(input_dict: dict) -> float:\n    \"\"\"\n    Finds the sum of all items (values) in the given dictionary.\n    Delegates summation logic to ReturnSumFunction.\n    \"\"\"\n    sum_calculator = ReturnSumFunction()\n    return sum_calculator.return_sum(input_dict)"}
{"task_id": "Mbpp/798", "solution": "from typing import List\nfrom numbers import Number\n\ndef _validate_numbers(numbers: List[Number]) -> None:\n    \"\"\"Validate that input is a list of numeric elements.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in numbers:\n        if not isinstance(item, Number):\n            raise TypeError(\"All elements in the list must be numeric.\")\n\ndef _sum(numbers: List[Number]) -> Number:\n    \"\"\"Calculates the arithmetic sum of a list of numbers.\n    Input is validated to be a list of numeric values.\n    \"\"\"\n    _validate_numbers(numbers)\n    total_sum = 0\n    for num in numbers:\n        total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"Compute sum of odd natural numbers in inclusive range [l, r]. Precondition: l <= r.\"\"\"\n    total = 0\n    effective_lower = max(l, 1)\n    for n in range(effective_lower, r + 1):\n        if n % 2 != 0:  # Check if n is odd\n            total += n\n    return total"}
{"task_id": "Mbpp/799", "solution": "MASK: int = 0xFFFFFFFF\n\nclass InputValue:\n    \"\"\"Encapsulates an input integer and provides its 32-bit masked representation.\"\"\"\n    def __init__(self, raw: int):\n        self.raw = raw\n\n    def masked(self) -> int:\n        return self.raw & MASK\n\nclass RotationParameters:\n    \"\"\"Normalizes the rotation count to ensure it's within the 0-31 range.\"\"\"\n    def __init__(self, d: int):\n        self.d = d\n\n    def effective_d(self) -> int:\n        return ((self.d % 32) + 32) % 32\n\nclass RotationResult:\n    \"\"\"Holds the rotation output and ensures final masking before return.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def masked(self) -> int:\n        return self.value & MASK\n\nclass BitRotator:\n    \"\"\"Performs the full 32-bit circular left rotation operation.\"\"\"\n    def left_rotate(self, value: int, d: int) -> int:\n        masked_value = InputValue(raw=value).masked()\n        eff = RotationParameters(d=d).effective_d()\n\n        if eff == 0:\n            rotated = masked_value\n        else:\n            # Perform circular left rotation, ensuring result stays within 32 bits.\n            rotated = ((masked_value << eff) | (masked_value >> (32 - eff))) & MASK\n        \n        return RotationResult(value=rotated).masked()\n\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Performs a 32-bit circular left rotation of a given number by d bits.\n    The input value and the result are treated as 32-bit unsigned integers.\n    \"\"\"\n    rotator = BitRotator()\n    return rotator.left_rotate(value, d)"}
{"task_id": "Mbpp/801", "solution": "def _validate_int(value, name):\n    \"\"\"\n    Validates if a value is an integer. Raises TypeError if not.\n    \"\"\"\n    if not isinstance(value, int):\n        raise TypeError(f\"{name} must be an integer.\")\n\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal integers among three given inputs.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    _validate_int(a, 'a')\n    _validate_int(b, 'b')\n    _validate_int(c, 'c')\n\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/800", "solution": "import unicodedata\n\ndef remove_all_spaces(value: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from a string, preserving the order of non-whitespace characters.\n    Handles various Unicode whitespace characters.\n    \"\"\"\n    if not value:\n        return \"\"\n    \n    cleaned_chars = []\n    for char in value:\n        if not unicodedata.category(char).startswith('Z'): # 'Z' category includes all types of spaces\n            cleaned_chars.append(char)\n    \n    return \"\".join(cleaned_chars)"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns False for non-integer or negative inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n    if n < 0:\n        return False\n    \n    root = math.isqrt(n)\n    return root * root == n"}
{"task_id": "Mbpp/804", "solution": "from typing import List\n\ndef is_product_even(numbers: List[float]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    for num in numbers:\n        # A number is considered even if its remainder when divided by 2 is 0.\n        # This applies to integers and float representations of integers (e.g., 2, 4.0, -6).\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Optional, Union\n\ndef max_sum_list(lists: List[List[Union[int, float]]]) -> Optional[List[Union[int, float]]]:\n    \"\"\"\n    Returns the sublist in a list of lists whose sum of elements is the highest.\n    Returns None if the input list is empty or contains no valid sublists.\n    \"\"\"\n    highest_sum = -float('inf')\n    highest_sum_list: Optional[List[Union[int, float]]] = None\n\n    for current_list in lists:\n        # Sums are computed directly. Per design constraints, explicit isinstance checks\n        # and raising exceptions for non-numeric sublist elements are omitted.\n        current_sum = sum(current_list)\n\n        if current_sum > highest_sum:\n            highest_sum = current_sum\n            highest_sum_list = current_list\n\n    return highest_sum_list"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"Finds the maximum contiguous run of ASCII uppercase characters (A-Z) in a string.\n    This function operates in O(n) time and O(1) space.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/808", "solution": "def check_K(tuple_input, k):\n    \"\"\"Return True if k is an element of tuple_input, else False. Raises TypeError if tuple_input is not a tuple.\"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise TypeError(\"tuple_input must be a tuple\")\n    return k in tuple_input"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first, second):\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its\n    corresponding element in the first tuple.\n    \"\"\"\n    return all(s_elem < f_elem for f_elem, s_elem in zip(first, second))"}
{"task_id": "Mbpp/807", "solution": "from typing import List\n\ndef first_odd(numbers: List[int]) -> int | None:\n    \"\"\"Finds the first odd number in a list. Returns None if no odd number is found.\"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
