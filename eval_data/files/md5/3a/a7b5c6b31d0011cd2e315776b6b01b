{"task_id": "Mbpp/745", "solution": "from typing import List\n\nclass Validator:\n    \"\"\"Validates input types and ranges.\"\"\"\n    def isInteger(self, x) -> bool:\n        \"\"\"Checks if the input is an integer.\"\"\"\n        return type(x) is int\n\n    def validateRange(self, start: int, end: int) -> None:\n        \"\"\"Validates that start and end are integers, raising ValueError if not.\"\"\"\n        if not self.isInteger(start):\n            raise ValueError(f\"startnum must be an integer, but got {type(start).__name__}\")\n        if not self.isInteger(end):\n            raise ValueError(f\"endnum must be an integer, but got {type(end).__name__}\")\n\nclass NumberCheck:\n    \"\"\"Performs checks on a single number for divisibility properties.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def hasZeroDigit(self) -> bool:\n        \"\"\"Checks if the number contains the digit zero.\"\"\"\n        return '0' in str(self.value)\n\n    def allNonZeroDigitsDivide(self) -> bool:\n        \"\"\"Checks if the number is divisible by every non-zero digit it contains.\"\"\"\n        num_str = str(self.value)\n        for digit_char in num_str:\n            digit = int(digit_char)\n            # The problem context implies non-zero digits, and hasZeroDigit handles 0 explicitly\n            if self.value % digit != 0:\n                return False\n        return True\n\nclass ResultList:\n    \"\"\"Collects and manages the list of qualifying numbers.\"\"\"\n    def __init__(self):\n        self.numbers: List[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds a number to the list.\"\"\"\n        self.numbers.append(n)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected numbers in ascending order.\"\"\"\n        self.numbers.sort()\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list of numbers is empty.\"\"\"\n        return not self.numbers\n\nclass RangeQuery:\n    \"\"\"Orchestrates the iteration and checking for numbers within a range.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def validate(self) -> None:\n        \"\"\"Validates the start and end numbers using a Validator.\"\"\"\n        validator = Validator()\n        validator.validateRange(self.startnum, self.endnum)\n\n    def execute(self) -> ResultList:\n        \"\"\"Executes the range query, checks numbers, and collects results.\"\"\"\n        result_list = ResultList()\n        if self.startnum > self.endnum:\n            return result_list\n\n        for num in range(self.startnum, self.endnum + 1):\n            number_check = NumberCheck(num)\n            if not number_check.hasZeroDigit():\n                if number_check.allNonZeroDigitsDivide():\n                    result_list.add(num)\n        \n        result_list.sortAscending()\n        return result_list\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    range_query = RangeQuery(startnum, endnum)\n    range_query.validate()\n    result_list = range_query.execute()\n    return result_list.numbers"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\nclass NumericString:\n    \"\"\"Represents an input string that can be converted to an integer.\"\"\"\n    def __init__(self, raw_value: str):\n        self.raw_value = raw_value\n\n    def to_integer(self) -> int:\n        \"\"\"Converts the raw string value to an integer.\"\"\"\n        return int(self.raw_value)\n\nclass IntegerValue:\n    \"\"\"A simple wrapper for an integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass SortedResult:\n    \"\"\"Holds a sorted list of integer values.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\ndef sort_numeric_strings(input: List[str]) -> List[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers, sorts them numerically, and returns the sorted list.\n    \"\"\"\n    integer_values: List[int] = []\n    for s in input:\n        numeric_string_instance = NumericString(s)\n        int_value = numeric_string_instance.to_integer()\n        integer_values.append(int_value)\n\n    sorted_list_of_ints = sorted(integer_values)\n    return sorted_list_of_ints"}
{"task_id": "Mbpp/748", "solution": "class InputString:\n    \"\"\"Represents the incoming raw input string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the raw input string is empty.\"\"\"\n        return not self.raw\n\nclass Character:\n    \"\"\"Encapsulates queries about a single character.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_uppercase(self) -> bool:\n        \"\"\"Checks if the character is an uppercase letter.\"\"\"\n        return self.value.isupper()\n\n    def is_whitespace(self) -> bool:\n        \"\"\"Checks if the character is whitespace.\"\"\"\n        return self.value.isspace()\n\n    def is_letter(self) -> bool:\n        \"\"\"Checks if the character is a letter.\"\"\"\n        return self.value.isalpha()\n\nclass OutputString:\n    \"\"\"Represents the result produced by the processing function.\"\"\"\n    def __init__(self, result: str):\n        self.result = result\n\nclass CapitalWordsProcessor:\n    \"\"\"Performs character-level processing to insert spaces before uppercase letters.\"\"\"\n    def capital_words_spaces(self, s: str) -> str:\n        \"\"\"\n        Processes the input string to insert spaces before words starting with capital letters.\n        \"\"\"\n        input_string_obj = InputString(s)\n        if input_string_obj.is_empty():\n            return OutputString(\"\").result\n\n        char_objects = [Character(c) for c in s]\n        result_chars = []\n\n        for i, char_obj in enumerate(char_objects):\n            if self._should_insert_space(i, char_objects):\n                result_chars.append(' ')\n            result_chars.append(char_obj.value)\n\n        return OutputString(\"\".join(result_chars)).result\n\n    def _should_insert_space(self, pos: int, char_objects: list[Character]) -> bool:\n        \"\"\"\n        Determines if a space should be inserted before the character at the given position.\n        \"\"\"\n        # A space should be inserted if:\n        # 1. It's not the first character.\n        # 2. The current character is uppercase.\n        # 3. The previous character is NOT whitespace.\n        if pos == 0:\n            return False\n\n        current_char = char_objects[pos]\n        previous_char = char_objects[pos - 1]\n\n        return current_char.is_uppercase() and not previous_char.is_whitespace()\n\ndef capital_words_spaces(s: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    \"\"\"\n    processor = CapitalWordsProcessor()\n    return processor.capital_words_spaces(s)"}
