{"task_id": "Mbpp/453", "solution": "from typing import Iterator\nimport math\n\n__all__ = ['sumofFactors']\n\ndef _validate_input(n) -> None:\n    \"\"\"Validates that the input n is an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"sumofFactors requires an integer input\")\n\ndef _even_divisors(n: int) -> Iterator[int]:\n    \"\"\"Yields unique even positive divisors of n.\"\"\"\n    if n <= 0:\n        return\n\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            # Check divisor i\n            if i > 0 and i % 2 == 0:\n                yield i\n            \n            # Check divisor n // i\n            j = n // i\n            if j != i and j > 0 and j % 2 == 0:\n                yield j\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even positive factors of a given number n.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    _validate_input(n)\n    \n    total_sum = 0\n    for factor in _even_divisors(n):\n        total_sum += factor\n        \n    return total_sum"}
{"task_id": "Mbpp/458", "solution": "def _is_numeric(value):\n    \"\"\"Return True if value is int or float (but not bool).\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef rectangle_area(width, height):\n    \"\"\"Validate width and height are numeric (int or float), then return width * height; raise TypeError on invalid input.\"\"\"\n    if not _is_numeric(width) or not _is_numeric(height):\n        raise TypeError(\"width and height must be numeric\")\n    return width * height"}
{"task_id": "Mbpp/454", "solution": "import re\n\nclass Word:\n    \"\"\"Value object representing an alphabetic token.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def contains_lowercase_z(self) -> bool:\n        \"\"\"Checks if the word contains the lowercase character 'z'.\"\"\"\n        return 'z' in self.value\n\nclass MatchResult:\n    \"\"\"Encapsulates match outcome and first matched word (optional).\"\"\"\n    def __init__(self, matched: bool, matched_word: str | None = None):\n        self.matched = matched\n        self.matched_word = matched_word\n\nclass Tokenizer:\n    \"\"\"Extracts contiguous ASCII alphabetic tokens from the input string.\"\"\"\n    def tokenize(self, input_string: str) -> list[Word]:\n        # Finds all contiguous sequences of ASCII alphabetic characters.\n        words_str = re.findall(r'[a-zA-Z]+', input_string)\n        return [Word(s) for s in words_str]\n\nclass Matcher:\n    \"\"\"Inspects Word tokens to find any that contain lowercase 'z'.\"\"\"\n    def find_match(self, words: list[Word]) -> MatchResult:\n        for word in words:\n            if word.contains_lowercase_z():\n                return MatchResult(True, word.value)\n        return MatchResult(False)\n\n\ndef text_match_wordz(input_string):\n    \"\"\"\n    Checks if the input string contains at least one word that includes the lowercase letter 'z'.\n    Non-alphabetic characters act as word boundaries.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not input_string:\n        return False\n\n    tokenizer = Tokenizer()\n    words = tokenizer.tokenize(input_string)\n\n    matcher = Matcher()\n    match_result = matcher.find_match(words)\n\n    return match_result.matched"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list: list) -> list:\n    \"\"\"Return one of the input sublists that has the minimum length.\n    Tie-break: return first encountered minimum.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"input_list must contain at least one sublist\")\n\n    min_sublist = input_list[0]\n    min_length = len(min_sublist)\n\n    for sublist in input_list[1:]:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Removes all ASCII uppercase letters (A-Z) from the input string.\n    The order of remaining characters is preserved.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        # Check if the character is NOT an ASCII uppercase letter\n        if not ('A' <= char <= 'Z'):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\nclass StringElement:\n    \"\"\"\n    Represents a single string element and provides per-element utilities.\n    \"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def reverse(self) -> str:\n        \"\"\"Returns the character-by-character reversal of the string.\"\"\"\n        return self.value[::-1]\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n\n    Validates input according to design specifications and reverses strings.\n    \"\"\"\n    if input_list is None:\n        raise ValueError(\"reverse_string_list: input must be a list of strings\")\n    \n    if not isinstance(input_list, list):\n        raise ValueError(\"reverse_string_list: input must be a list of strings\")\n\n    reversed_items = []\n    for item in input_list:\n        if not isinstance(item, str):\n            raise TypeError(f\"reverse_string_list: all elements must be strings; found element of type {type(item).__name__}\")\n        \n        string_element = StringElement(item)\n        reversed_items.append(string_element.reverse())\n    \n    return reversed_items"}
