{"task_id": "Mbpp/722", "solution": "def is_numeric_tuple(value):\n    \"\"\"Checks if a value is a 2-element tuple of numbers (int or float).\"\"\"\n    if not isinstance(value, tuple):\n        return False\n    if len(value) != 2:\n        return False\n    if not (isinstance(value[0], (int, float)) and isinstance(value[1], (int, float))):\n        return False\n    return True\n\ndef filter_data(student_data, min_height, min_weight):\n    \"\"\"\n    Filters student data, returning only students whose height and weight meet minimum criteria.\n    Malformed entries in the input dictionary are ignored.\n    \"\"\"\n    filtered_students = {}\n    for name, data_tuple in student_data.items():\n        # Validate entry: key must be string, value must be 2-element numeric tuple\n        if not isinstance(name, str):\n            continue\n        if not is_numeric_tuple(data_tuple):\n            continue\n\n        height, weight = data_tuple\n\n        # Apply filtering criteria\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = data_tuple\n            \n    return filtered_students"}
{"task_id": "Mbpp/643", "solution": "import typing\n\nclass Word:\n    \"\"\"Represents a contiguous sequence of ASCII-letter characters with its original indices.\"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int):\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\n\nclass MatchResult:\n    \"\"\"Summary of a found match for a 'z' in the middle of a word.\"\"\"\n    def __init__(self, found: bool, word_index: int = -1, char_index: int = -1, matched_word: str = \"\"):\n        self.found = found\n        self.word_index = word_index\n        self.char_index = char_index\n        self.matched_word = matched_word\n\ndef is_ascii_letter(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII letter (A-Z or a-z).\"\"\"\n    return 'a' <= ch <= 'z' or 'A' <= ch <= 'Z'\n\nclass Tokenizer:\n    \"\"\"Tokenizes raw string into Word objects based on ASCII letters.\"\"\"\n    def tokenize(self, raw: str) -> typing.List[Word]:\n        \"\"\"Scans raw string and yields Word tokens.\"\"\"\n        words: typing.List[Word] = []\n        current_word_start_index: typing.Optional[int] = None\n\n        for i, char in enumerate(raw):\n            if is_ascii_letter(char):\n                if current_word_start_index is None:\n                    current_word_start_index = i\n            else: # Not an ASCII letter, so a separator\n                if current_word_start_index is not None:\n                    word_text = raw[current_word_start_index:i]\n                    words.append(Word(word_text, current_word_start_index, i))\n                    current_word_start_index = None\n        \n        # Add the last word if it ends at the end of the string\n        if current_word_start_index is not None:\n            word_text = raw[current_word_start_index:len(raw)]\n            words.append(Word(word_text, current_word_start_index, len(raw)))\n            \n        return words\n\ndef has_middle_z(word: Word) -> bool:\n    \"\"\"Checks if a word contains a lowercase 'z' not at its start or end.\"\"\"\n    if word.length() < 3:\n        return False\n    \n    for i in range(1, word.length() - 1): # Check interior characters (indexes 1 to length-2)\n        if word.text[i] == 'z':\n            return True\n    return False\n\nclass Matcher:\n    \"\"\"Inspects words to detect the first qualifying interior lowercase 'z'.\"\"\"\n    def find_first_middle_z(self, words: typing.List[Word]) -> MatchResult:\n        \"\"\"Iterates through words and returns MatchResult on first 'z' match.\"\"\"\n        for word_idx, word in enumerate(words):\n            if has_middle_z(word):\n                for char_idx_in_word in range(1, word.length() - 1):\n                    if word.text[char_idx_in_word] == 'z':\n                        return MatchResult(True, word_idx, char_idx_in_word, word.text)\n        return MatchResult(False)\n\ndef text_match_wordz_middle(raw: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of a word.\n    A word is a contiguous sequence of ASCII alphabetic characters.\n    \"\"\"\n    if not isinstance(raw, str):\n        raise TypeError(\"Input must be a string.\")\n\n    tokenizer = Tokenizer()\n    words = tokenizer.tokenize(raw)\n\n    matcher = Matcher()\n    match_result = matcher.find_first_middle_z(words)\n\n    return match_result.found"}
{"task_id": "Mbpp/723", "solution": "class LengthMismatchError(Exception):\n    \"\"\"Exception raised when input lists have different lengths.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef count_same_pair(list1, list2) -> int:\n    \"\"\"\n    Counts indices where two lists have the same values. Raises LengthMismatchError if lengths differ.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise LengthMismatchError(\"list lengths differ\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Assumes base and power are valid integers, with power being non-negative.\n    \"\"\"\n    computed_value = base ** power\n    digits_string = str(abs(computed_value))\n    total_digit_sum = 0\n    for digit_char in digits_string:\n        total_digit_sum += int(digit_char)\n    return total_digit_sum"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Optional, Any\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float) -> None:\n        self.row = row\n        self.col = col\n        self.cost = cost\n\n    def __repr__(self) -> str:\n        return f\"Cell({self.row}, {self.col}, {self.cost})\"\n\nclass Path:\n    \"\"\"Represents a path as a sequence of cells.\"\"\"\n    def __init__(self, cells: List[Cell]) -> None:\n        self.cells = cells\n\n    def length(self) -> int:\n        return len(self.cells)\n\n    def totalCost(self) -> float:\n        return sum(cell.cost for cell in self.cells)\n\n    def average(self) -> float:\n        path_length = self.length()\n        # For valid paths from (0,0) to (N-1,N-1), length will always be >= 1.\n        return self.totalCost() / path_length\n\nclass Matrix:\n    \"\"\"Represents the square matrix of costs.\"\"\"\n    def __init__(self, costs: List[List[float]]) -> None:\n        self.costs = costs\n        self.N = len(costs)\n\n    def getCell(self, i: int, j: int) -> float:\n        return self.costs[i][j]\n\nclass ValidationResult:\n    \"\"\"Result of a validation operation.\"\"\"\n    def __init__(self, is_valid: bool, error_message: Optional[str]=None, error_code: Optional[str]=None) -> None:\n        self.is_valid = is_valid\n        self.error_message = error_message\n        self.error_code = error_code\n\nclass Validator:\n    \"\"\"Validates raw matrix input.\"\"\"\n    def validateMatrix(self, raw_matrix: List[List[Any]]) -> ValidationResult:\n        if not raw_matrix:\n            return ValidationResult(False, \"Input matrix cannot be empty.\", \"EMPTY_MATRIX\")\n\n        N = len(raw_matrix)\n        if not all(isinstance(row, list) and len(row) == N for row in raw_matrix):\n            return ValidationResult(False, \"Input matrix must be square.\", \"NON_SQUARE\")\n\n        for r in range(N):\n            for c in range(N):\n                cell_value = raw_matrix[r][c]\n                if not isinstance(cell_value, (int, float)):\n                    return ValidationResult(False, f\"Cell at ({r},{c}) is not numeric.\", \"NON_NUMERIC\")\n        \n        return ValidationResult(True)\n\nclass Evaluator:\n    \"\"\"Computes numeric metrics for a path.\"\"\"\n    TOLERANCE: float = 1e-9\n\n    def computeTotal(self, path: Path) -> float:\n        return path.totalCost()\n\n    def computeAverage(self, path: Path) -> float:\n        return path.average()\n\nclass Result:\n    \"\"\"Holds the maximum average and the path that achieved it.\"\"\"\n    def __init__(self, maxAverage: float, chosenPath: Path) -> None:\n        self.maxAverage = maxAverage\n        self.chosenPath = chosenPath\n\nclass PathFinder:\n    \"\"\"Finds paths and determines the maximum average path.\"\"\"\n    def __init__(self, evaluator: Evaluator) -> None:\n        self.evaluator = evaluator\n\n    def enumeratePaths(self, matrix: Matrix) -> List[Path]:\n        \"\"\"Enumerates all right/down paths from (0,0) to (N-1,N-1).\"\"\"\n        all_paths: List[Path] = []\n        N = matrix.N\n\n        def _dfs(r: int, c: int, current_cells: List[Cell]):\n            cell = Cell(r, c, matrix.getCell(r, c))\n            # Create a new list for the current path branch to avoid modifying shared list in recursion.\n            new_current_cells = current_cells + [cell]\n\n            if r == N - 1 and c == N - 1:\n                all_paths.append(Path(new_current_cells))\n                return\n\n            # Move right\n            if c + 1 < N:\n                _dfs(r, c + 1, new_current_cells)\n            # Move down\n            if r + 1 < N:\n                _dfs(r + 1, c, new_current_cells)\n\n        _dfs(0, 0, [])\n        return all_paths\n\n    def findMaxAverage(self, matrix: Matrix) -> Result:\n        \"\"\"Finds the path with the maximum average cost.\"\"\"\n        paths = self.enumeratePaths(matrix)\n        \n        # For a valid N>=1 matrix, paths list will always have at least one element.\n        max_avg = self.evaluator.computeAverage(paths[0])\n        chosen_path = paths[0]\n\n        for i in range(1, len(paths)):\n            path = paths[i]\n            avg = self.evaluator.computeAverage(path)\n            if avg > max_avg:\n                max_avg = avg\n                chosen_path = path\n        \n        return Result(max_avg, chosen_path)\n\ndef maxAverageOfPath(matrix: List[List[float]], return_path: bool = False) -> float | Result:\n    \"\"\"\n    Finds a path from the top-left to bottom-right cell with the maximum average cost\n    in a given square matrix, moving only right or down.\n    \"\"\"\n    validator = Validator()\n    validation_result = validator.validateMatrix(matrix)\n\n    if not validation_result.is_valid:\n        raise ValueError(f\"Matrix validation failed: {validation_result.error_message} (Code: {validation_result.error_code})\")\n\n    # Convert all cell values to float, as validation ensures numeric types.\n    float_matrix_costs = [[float(val) for val in row] for row in matrix]\n    matrix_obj = Matrix(float_matrix_costs)\n\n    evaluator = Evaluator()\n    path_finder = PathFinder(evaluator)\n\n    result_obj = path_finder.findMaxAverage(matrix_obj)\n\n    if return_path:\n        return result_obj\n    else:\n        return result_obj.maxAverage"}
{"task_id": "Mbpp/725", "solution": "import re\nfrom typing import List, Tuple\n\ndef _parse_between_quotes(s: str) -> List[Tuple[int, int, str]]:\n    \"\"\"\n    Finds all substrings enclosed in double quotes and returns their values\n    along with their start and end indices.\n    \"\"\"\n    results: List[Tuple[int, int, str]] = []\n    # Matches a double quote, then captures any characters that are not a double quote,\n    # and finally matches another double quote.\n    pattern = r'\"([^\"]*)\"'\n    for match in re.finditer(pattern, s):\n        # match.group(1) retrieves the captured content between the quotes.\n        # match.start(1) and match.end(1) provide the span of the captured content.\n        results.append((match.start(1), match.end(1), match.group(1)))\n    return results\n\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks from the given string.\n    \"\"\"\n    parsed_items = _parse_between_quotes(input)\n    # Return only the extracted string values.\n    return [item[2] for item in parsed_items]"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Any, Union\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_input(input_tuple: Tuple[Any, ...]) -> None:\n    \"\"\"Validates if input_tuple is a tuple of numeric elements, raising TypeError on failure.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    for element in input_tuple:\n        if not _is_numeric(element):\n            raise TypeError(\"All elements in the tuple must be numeric (int or float).\")\n\ndef _compute_products(input_tuple: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"Computes adjacent products for a validated numeric tuple.\"\"\"\n    return tuple(input_tuple[i] * input_tuple[i + 1] for i in range(len(input_tuple) - 1))\n\ndef multiply_elements(input_tuple: Tuple[Any, ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Takes a tuple of numbers (t_1,...,t_{N+1}) and returns a tuple of length N\n    where the i-th element of the tuple is equal to t_i * t_{i+1}.\n    \"\"\"\n    _validate_input(input_tuple)\n\n    if len(input_tuple) < 2:\n        return ()\n\n    # At this point, input_tuple is guaranteed to be a tuple of numeric (int or float) elements.\n    # The type hint for _compute_products expects this narrower type.\n    return _compute_products(input_tuple)"}
{"task_id": "Mbpp/728", "solution": "from typing import List, Union\n\nclass NumericElement:\n    \"\"\"Represents a single numeric value in a list.\n    Validates input to be numeric during initialization.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Value must be numeric, got {type(value)}\")\n        self._value = value\n\n    def getValue(self) -> Union[int, float]:\n        \"\"\"Returns the numeric value.\"\"\"\n        return self._value\n\nclass InputList:\n    \"\"\"A domain class representing an input list of numeric elements.\n    Converts raw list items to NumericElement objects.\"\"\"\n    def __init__(self, items: list) -> None:\n        self._elements: List[NumericElement] = []\n        for item in items:\n            self._elements.append(NumericElement(item))\n        self._length = len(self._elements)\n\n    def isNumeric(self) -> bool:\n        \"\"\"Checks if all elements in the list are numeric.\n        Always returns true if InputList construction succeeded.\"\"\"\n        return True\n\n    def get_elements(self) -> List[NumericElement]:\n        \"\"\"Returns the internal list of NumericElement objects.\"\"\"\n        return self._elements\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return self._length\n\nclass ResultList:\n    \"\"\"A domain class representing a result list of numeric elements.\"\"\"\n    def __init__(self, elements: List[NumericElement]) -> None:\n        self._elements = elements\n        self._length = len(elements)\n\n    def to_list(self) -> list:\n        \"\"\"Converts the ResultList to a plain Python list of numbers.\"\"\"\n        return [element.getValue() for element in self._elements]\n\nclass SumListService:\n    \"\"\"Service for validating and summing lists of numeric elements.\"\"\"\n    def validate(self, a: InputList, b: InputList) -> bool:\n        \"\"\"Validates if both InputLists are numeric and have equal length.\"\"\"\n        if not a.isNumeric() or not b.isNumeric():\n            return False # Redundant if InputList's init validates strictly.\n        if a.length != b.length:\n            return False\n        return True\n\n    def sum_list(self, a: InputList, b: InputList) -> ResultList:\n        \"\"\"Computes element-wise sums and returns a ResultList.\"\"\"\n        result_elements: List[NumericElement] = []\n        for i in range(a.length):\n            sum_val = a.get_elements()[i].getValue() + b.get_elements()[i].getValue()\n            result_elements.append(NumericElement(sum_val))\n        return ResultList(result_elements)\n\ndef sum_list(a: list, b: list) -> list:\n    \"\"\"\n    Computes the element-wise sum of two lists of numbers.\n\n    Raises ValueError if inputs are not numeric or have unequal length.\n    \"\"\"\n    service = SumListService()\n\n    try:\n        a_input = InputList(a)\n        b_input = InputList(b)\n    except TypeError as e:\n        raise ValueError(f\"Invalid inputs: {e}\") from e\n\n    if not service.validate(a_input, b_input):\n        raise ValueError(\"Invalid inputs: Lists must have equal length.\")\n\n    result = service.sum_list(a_input, b_input)\n    return result.to_list()"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Formula: A = \u03c0 * r * sqrt(r^2 + h^2)\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order and returning a new list.\"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    for item in input_list:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/732", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass OutputString:\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass CharacterMapper:\n    _map_table: dict[str, str] = {' ': ':', ',': ':', '.': ':'}\n\n    def map(self, c: str) -> str:\n        \"\"\"Map single-character string c to replacement per SRS.\"\"\"\n        return CharacterMapper._map_table.get(c, c)\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"Accepts input string and returns transformed string where ' ', ',', '.' => ':' per SRS.\"\"\"\n    input_obj = InputString(input)\n    mapper = CharacterMapper()\n    \n    result_chars = []\n    for char in input_obj.value:\n        result_chars.append(mapper.map(char))\n    \n    output_str = \"\".join(result_chars)\n    output_obj = OutputString(output_str)\n    \n    return output_obj.value"}
{"task_id": "Mbpp/733", "solution": "from typing import List\n\ndef _binary_search_first(array: List[int], target: int) -> int:\n    \"\"\"\n    Performs binary search to find the leftmost index of the target.\n    Returns the index if found; returns -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result_index = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n\n    return result_index\n\ndef find_first_occurrence(array: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    This function delegates to a private binary search helper.\n    \"\"\"\n    return _binary_search_first(array, target)"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(values: list) -> float:\n    \"\"\"\n    Computes the sum of products of all contiguous subarrays in the given list.\n    For an empty list, it returns 0.\n    \"\"\"\n    total_sum = 0.0\n\n    if not values:\n        return 0.0\n\n    n = len(values)\n    for i in range(n):\n        current_product = 1.0\n        for j in range(i, n):\n            current_product *= values[j]\n            total_sum += current_product\n            \n    return total_sum"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(arr, value) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array.\n    Uses binary search to find the first index i such that arr[i] >= value.\n    \"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of the number n except the most significant bit (MSB) and least significant bit (LSB).\n    Returns n unchanged if its bit length is less than 3.\n    \"\"\"\n    b = n.bit_length()\n\n    if b < 3:\n        return n\n\n    # Calculate the number of middle bits to toggle\n    middle_count = b - 2\n\n    # Create a mask with 1s at the middle bit positions\n    # (1 << middle_count) - 1 generates 'middle_count' ones starting from position 0.\n    # Shifting it left by 1 moves these ones to positions 1 through middle_count.\n    mask = ((1 << middle_count) - 1) << 1\n\n    # XOR the number with the mask to toggle the middle bits\n    result = n ^ mask\n    return result"}
{"task_id": "Mbpp/737", "solution": "import re\n\nclass InputString:\n    \"\"\"Encapsulates a string value and provides utility methods.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def trim(self) -> str:\n        # Trims leading whitespace from the string.\n        return self.value.lstrip()\n\nclass RegexPattern:\n    \"\"\"Manages a regular expression pattern and its compilation.\"\"\"\n    def __init__(self, expression: str = '^[aeiou]', flags: str = 'i'):\n        self.expression = expression\n        self.flags = flags\n        self._compiled: re.Pattern | None = None\n\n    def compile(self) -> re.Pattern:\n        if self._compiled is None:\n            # Compiles the regex with re.IGNORECASE if 'i' flag is specified.\n            if self.flags == 'i':\n                self._compiled = re.compile(self.expression, re.IGNORECASE)\n            else:\n                self._compiled = re.compile(self.expression)\n        return self._compiled\n\nclass VowelChecker:\n    \"\"\"Checks if an InputString starts with a vowel using a RegexPattern.\"\"\"\n    def __init__(self, pattern: RegexPattern = None):\n        self.pattern = pattern if pattern is not None else RegexPattern()\n\n    def check(self, input_obj: InputString) -> bool:\n        # Returns False immediately for an empty input string.\n        if not input_obj.length():\n            return False\n        \n        # Matches the compiled pattern against the trimmed input string.\n        compiled_pattern = self.pattern.compile()\n        return bool(compiled_pattern.match(input_obj.trim()))\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"Checks if the given string starts with a vowel using regex.\"\"\"\n    input_obj = InputString(input_string)\n    checker = VowelChecker()\n    return checker.check(input_obj)"}
{"task_id": "Mbpp/739", "solution": "class InputValidator:\n    \"\"\"Validates input n and raises ValueError for invalid inputs.\"\"\"\n    @staticmethod\n    def validate(n):\n        \"\"\"Raise ValueError if n is not int or n < 1.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input n must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input n must be greater than or equal to 1.\")\n\nclass TriangularNumber:\n    \"\"\"Encapsulates triangular number computation and digit-count logic.\"\"\"\n    @staticmethod\n    def compute(k):\n        \"\"\"Return integer T_k = k*(k+1)//2.\"\"\"\n        return k * (k + 1) // 2\n\n    @staticmethod\n    def digits(value):\n        \"\"\"Return decimal digit count for positive integer value.\"\"\"\n        # For positive integers, len(str(value)) gives the digit count.\n        # This handles value = 0 if it were allowed, returning 1 digit.\n        # Given context, value will always be positive (T_k for k>=1 is >=1).\n        return len(str(value))\n\ndef _compute_k_for_digits(n):\n    \"\"\"\n    Internal helper that returns the minimal k for given digit count n.\n    Iteratively finds the smallest k such that T_k has n digits.\n    \"\"\"\n    k = 1\n    while True:\n        t_k = TriangularNumber.compute(k)\n        num_digits = TriangularNumber.digits(t_k)\n        if num_digits == n:\n            return k\n        k += 1\n\ndef find_Index(n):\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Validates input n and returns the smallest integer k such that T_k = k*(k+1)/2\n    has exactly n decimal digits.\n    \"\"\"\n    InputValidator.validate(n)\n    return _compute_k_for_digits(n)"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input: str) -> bool:\n    \"\"\"Return True iff every character in the input string is the same; otherwise False.\"\"\"\n    return len(set(input)) <= 1"}
{"task_id": "Mbpp/740", "solution": "def _pair_iterator(t: tuple):\n    \"\"\"Yields (key, value) pairs from the tuple.\"\"\"\n    for i in range(0, len(t), 2):\n        yield t[i], t[i+1]\n\ndef tuple_to_dict(t: tuple) -> dict:\n    \"\"\"Converts a tuple to a dictionary using adjacent elements as key-value pairs.\"\"\"\n    result = {}\n    for key, value in _pair_iterator(t):\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/742", "solution": "from math import sqrt\n\nclass CalculationService:\n    \"\"\"\n    A service to encapsulate the calculation logic for a tetrahedron's surface area.\n    \"\"\"\n    def area_tetrahedron(self, a) -> float:\n        \"\"\"\n        Validates input and returns the computed surface area by delegating to computeSurfaceArea.\n        \"\"\"\n        # Design explicitly states: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        return float(self.computeSurfaceArea(a))\n\n    def computeSurfaceArea(self, a) -> float:\n        \"\"\"\n        Implements the formula for the surface area of a regular tetrahedron: sqrt(3) * a^2.\n        \"\"\"\n        return sqrt(3) * (float(a) ** 2)\n\ndef area_tetrahedron(a) -> float:\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron with edge length 'a'.\n    \"\"\"\n    service = CalculationService()\n    return service.area_tetrahedron(a)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, count: int) -> list:\n    \"\"\"\n    Rotates a list to the right by a specified number of items.\n    Handles validation, effective shift computation, and performs rotation using slicing.\n    \"\"\"\n    # Validate inputs as per design: count must be an integer and non-negative.\n    if not isinstance(count, int):\n        raise TypeError(\"count must be an integer\")\n    if count < 0:\n        raise ValueError(\"count cannot be negative\")\n\n    # Handle empty list: an empty list rotated is still an empty list.\n    if not input_list:\n        return []\n\n    list_length = len(input_list)\n\n    # Compute the effective shift using modulo to handle counts larger than list length.\n    effective_shift = count % list_length\n\n    # Perform the rotation using list slicing.\n    if effective_shift == 0:\n        # If the effective shift is 0, no rotation is needed; return a shallow copy.\n        return list(input_list)\n    else:\n        # Split the list into two parts and concatenate them in reverse order.\n        # The last 'effective_shift' elements go to the front.\n        return input_list[-effective_shift:] + input_list[:-effective_shift]"}
