{"task_id": "Mbpp/409", "solution": "from typing import Sequence, Tuple, List, Union\n\nNumber = Union[int, float]\n\nclass TuplePair:\n    \"\"\"Concrete data holder for two numeric values with a method to compute their product.\"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = a\n        self.b = b\n\n    def product(self) -> Number:\n        \"\"\"Returns the product of the two numeric values.\"\"\"\n        return self.a * self.b\n\nclass InputList:\n    \"\"\"Lightweight adapter to hold a sequence of TuplePair instances.\"\"\"\n    def __init__(self, tuples_input: Sequence[Tuple[Number, Number]]):\n        self.tuples: List[TuplePair] = [TuplePair(t[0], t[1]) for t in tuples_input]\n\nclass Result:\n    \"\"\"Holds and exposes the resulting minimum product.\"\"\"\n    def __init__(self, min_value: Number):\n        self.min_value = min_value\n\ndef _validate_input(tuples) -> None:\n    \"\"\"Validates the input structure and element types, raising exceptions for invalid input.\"\"\"\n    if not isinstance(tuples, Sequence) or isinstance(tuples, str):\n        raise TypeError(\"Input must be a sequence of 2-element numeric tuples.\")\n\n    if not tuples:\n        raise ValueError(\"No products to evaluate.\")\n\n    for i, element in enumerate(tuples):\n        if not isinstance(element, Sequence) or isinstance(element, str):\n            raise TypeError(f\"Element at index {i} is not a sequence. Each element must be a 2-element tuple/sequence.\")\n        \n        if len(element) != 2:\n            raise TypeError(f\"Element at index {i} has length {len(element)}. Each element must be a 2-element tuple/sequence.\")\n        \n        for j, val in enumerate(element):\n            if not isinstance(val, (int, float)):\n                raise TypeError(f\"Tuple element '{val}' at index {i} position {j} is of type {type(val).__name__}. Tuple elements must be numeric (int or float).\")\n\ndef min_product_tuple(tuples: Sequence[Tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Validates input and returns the minimum product.\n    \"\"\"\n    _validate_input(tuples)\n    \n    input_list_obj = InputList(tuples)\n    \n    products = [tp.product() for tp in input_list_obj.tuples]\n    \n    min_prod = min(products)\n    \n    return min_prod"}
{"task_id": "Mbpp/412", "solution": "from typing import List\n\ndef remove_odd(input_list: List[int]) -> List[int]:\n    \"\"\"Return a new list containing only the even integers from input_list.\"\"\"\n    return [x for x in input_list if x % 2 == 0]"}
{"task_id": "Mbpp/410", "solution": "from typing import Union\n\ndef min_val(elements: list) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Raises ValueError if no numeric elements are found.\n    \"\"\"\n    numeric_elements = [item for item in elements if isinstance(item, (int, float))]\n\n    if not numeric_elements:\n        raise ValueError('no numeric elements in input list')\n\n    return min(numeric_elements)"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2) -> bool:\n    \"\"\"\n    Checks if any value in the first sequence exists in the second sequence.\n    Returns False if either input sequence is empty.\n    \"\"\"\n    if not seq1 or not seq2:\n        return False\n\n    try:\n        # Attempt to convert the second sequence to a set for O(1) membership checks.\n        set2 = set(seq2)\n        for item1 in seq1:\n            if item1 in set2:\n                return True\n    except TypeError:\n        # If seq2 contains unhashable elements, fall back to nested iteration.\n        for item1 in seq1:\n            for item2 in seq2:\n                if item1 == item2:\n                    return True\n\n    return False"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(tuple_list, n):\n    \"\"\"\n    Extracts the element at index n from each tuple in a list of tuples.\n    Returns a new list with the extracted elements, preserving order.\n    \"\"\"\n    return [tup[n] for tup in tuple_list]"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list: list) -> list:\n    \"\"\"Return the element of input_list with maximum length (len()).\n    Raises ValueError if input_list is empty, and handles ties by returning the first occurrence.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"input_list must not be empty\")\n\n    max_length = -1\n    max_element = None\n\n    for element in input_list:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n            \n    return max_element"}
{"task_id": "Mbpp/415", "solution": "import math\n\nclass ErrorCondition:\n    \"\"\"Represents an error condition, mapping to ValueError for API raising.\"\"\"\n    def __init__(self, message: str, type: str):\n        self.message = message\n        self.type = type\n\n    def as_exception(self) -> Exception:\n        return ValueError(self.message)\n\nclass ResultPair:\n    \"\"\"Holds a pair of integers ensuring a <= b and provides their product.\"\"\"\n    def __init__(self, a: int, b: int):\n        if a > b:\n            self.a = b\n            self.b = a\n        else:\n            self.a = a\n            self.b = b\n\n    def product(self) -> int:\n        return self.a * self.b\n\nclass ProductCalculator:\n    \"\"\"Calculates the pair with the highest product from a list of integers, applying tie-breaking rules.\"\"\"\n    def __init__(self, algorithm_name: str = 'enumeration-min-first-tiebreak'):\n        self.algorithm_name = algorithm_name\n\n    def find_max_pair(self, elements: list[int]) -> ResultPair:\n        max_product = -math.inf\n        best_pair_a = None\n        best_pair_b = None\n\n        n = len(elements)\n        for i in range(n):\n            for j in range(i + 1, n):\n                x = elements[i]\n                y = elements[j]\n                current_product = x * y\n\n                if current_product > max_product:\n                    max_product = current_product\n                    best_pair_a = min(x, y)\n                    best_pair_b = max(x, y)\n                elif current_product == max_product:\n                    current_min = min(x, y)\n                    current_max = max(x, y)\n\n                    if current_min < best_pair_a:\n                        best_pair_a = current_min\n                        best_pair_b = current_max\n                    elif current_min == best_pair_a:\n                        if current_max < best_pair_b:\n                            best_pair_a = current_min\n                            best_pair_b = current_max\n        \n        return ResultPair(best_pair_a, best_pair_b)\n\ndef max_Product(list_of_ints: list) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n\n    When multiple unordered pairs yield equal maximal product, choose the pair whose first element\n    (the smaller of the pair) is numerically smallest; if still tied, choose the pair whose second\n    element is smallest. Input must contain at least two integers or coercible elements;\n    otherwise, a ValueError is raised.\n    \"\"\"\n    if not isinstance(list_of_ints, (list, tuple)):\n        raise ValueError(\"Input must be a list or tuple of integers.\")\n\n    coerced_elements = []\n    for item in list_of_ints:\n        try:\n            coerced_elements.append(int(item))\n        except (ValueError, TypeError):\n            raise ValueError(f\"Input elements must be integers or coercible to int. Found non-coercible element: {item}\")\n\n    if len(coerced_elements) < 2:\n        raise ValueError(\"Input list must contain at least two integer elements after coercion.\")\n\n    calculator = ProductCalculator()\n    result_pair = calculator.find_max_pair(coerced_elements)\n\n    return (result_pair.a, result_pair.b)"}
{"task_id": "Mbpp/419", "solution": "from typing import List, Union\n\nclass Number:\n    \"\"\"Wrapper for a numeric value, normalized to float.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = float(value)\n\nclass NumericList:\n    \"\"\"Wrapper for a list of numeric elements, normalizing them to Number instances.\"\"\"\n    def __init__(self, numbers: List[Union[int, float, Number]]):\n        self.elements = [Number(n) if not isinstance(n, Number) else n for n in numbers]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\ndef _validate_input(numbers: List[Union[int, float, Number]]) -> None:\n    \"\"\"Validates that input is a list and all elements are numeric.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list of numeric values\")\n    for item in numbers:\n        if not isinstance(item, (int, float, Number)):\n            raise TypeError(\"numbers must be a list of numeric values\")\n\ndef print_result(result: int) -> None:\n    \"\"\"Prints the given integer result to stdout.\"\"\"\n    print(result)\n\ndef round_and_sum(numbers: List[Union[int, float, Number]]) -> int:\n    \"Validate input, round each number using host-language round(), compute sum, multiply by len(input), print and return int result.\"\n    _validate_input(numbers)\n\n    numeric_list = NumericList(numbers)\n    \n    sum_of_rounded = 0\n    for num_obj in numeric_list.elements:\n        rounded_val = round(num_obj.value)\n        sum_of_rounded += rounded_val\n\n    list_length = numeric_list.length()\n    \n    multiplied_result = sum_of_rounded * list_length\n    \n    print_result(multiplied_result)\n    \n    return multiplied_result"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers.\n    Assumes n is an integer greater than or equal to 1.\n    \"\"\"\n    return 2 * n**2 * (n + 1)**2"}
{"task_id": "Mbpp/421", "solution": "def _validate_input(inputTuple):\n    \"\"\"Validates that the input is a tuple.\"\"\"\n    if not isinstance(inputTuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n\ndef _convert_elements(inputTuple):\n    \"\"\"Converts each element of the tuple to its string representation.\"\"\"\n    return [str(element) for element in inputTuple]\n\ndef _join_strings(str_list, delimiter):\n    \"\"\"Joins a list of strings using the specified delimiter.\"\"\"\n    return delimiter.join(str_list)\n\ndef concatenate_tuple(inputTuple, delimiter='-'):\n    \"\"\"\n    Concatenates each element of a tuple by a specified delimiter.\n    Raises TypeError if inputTuple is not a tuple.\n    \"\"\"\n    _validate_input(inputTuple)\n    str_elements = _convert_elements(inputTuple)\n    return _join_strings(str_elements, delimiter)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Write a python function to find the average of cubes of first n natural numbers.\n    \"\"\"\n    # Calculate the sum of the first n natural numbers, which will be a float in Python 3.\n    sum_of_first_n_numbers = n * (n + 1) / 2\n\n    # The sum of the cubes of the first n natural numbers is the square of sum_of_first_n_numbers.\n    sum_of_cubes = sum_of_first_n_numbers ** 2\n\n    # The average is the total sum of cubes divided by n.\n    average = sum_of_cubes / n\n    \n    return average"}
{"task_id": "Mbpp/424", "solution": "def extract_rear(input_tuple):\n    \"\"\"\n    Extracts the last character of each string in a tuple and returns them as a list.\n    Enforces that the input is a tuple, raising TypeError otherwise.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n\n    result = []\n    for s in input_tuple:\n        result.append(s[-1])\n    return result"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists, target_element):\n    \"\"\"Return int: number of sublists in list_of_sublists that contain target_element (using ==).\"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        if target_element in sublist:\n            count += 1\n    return count"}
{"task_id": "Mbpp/426", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"\n    A lightweight wrapper for an input list of integers.\n    \"\"\"\n    def __init__(self, items: List[int]):\n        self.items = items\n\nclass FilteredList:\n    \"\"\"\n    A lightweight wrapper for a filtered list of integers.\n    \"\"\"\n    def __init__(self, items: List[int]):\n        self.items = items\n\nclass OddFilterService:\n    \"\"\"\n    Service to filter odd numbers from a list.\n    \"\"\"\n    def filter_oddnumbers(self, input_list_arg):\n        \"\"\"\n        Filters odd integers from the input list and returns them in a FilteredList.\n        \"\"\"\n        items: List[int]\n        if isinstance(input_list_arg, InputList):\n            items = input_list_arg.items\n        else:\n            items = input_list_arg\n\n        filtered_items = []\n        for item in items:\n            if item % 2 != 0:\n                filtered_items.append(item)\n\n        return FilteredList(filtered_items)\n\ndef filter_oddnumbers(input_list):\n    \"\"\"\n    Filters odd numbers from the provided list, delegating to an OddFilterService.\n    Returns a plain Python list of odd integers, preserving original order.\n    \"\"\"\n    svc = OddFilterService()\n    result_filtered = svc.filter_oddnumbers(input_list)\n    return result_filtered.items"}
{"task_id": "Mbpp/427", "solution": "import re\nfrom datetime import datetime\n\nclass DateString:\n    \"\"\"Data holder for original input, parsed components, and converted output.\"\"\"\n    def __init__(self, original: str, year: int, month: int, day: int, converted: str = \"\"):\n        self.original = original\n        self.year = year\n        self.month = month\n        self.day = day\n        self.converted = converted\n\nclass ValidationResult:\n    \"\"\"Value object for validation outcome.\"\"\"\n    def __init__(self, isValid: bool, message: str = \"\"):\n        self.isValid = isValid\n        self.message = message\n\nclass ChangeDateFormatService:\n    \"\"\"Stateless service for converting date formats, including parsing and validation.\"\"\"\n    DATE_PATTERN = r\"^\\d{4}-\\d{2}-\\d{2}$\"\n\n    @staticmethod\n    def _match_pattern(date_str: str) -> bool:\n        \"\"\"Verifies if the date string matches the yyyy-mm-dd pattern.\"\"\"\n        return re.match(ChangeDateFormatService.DATE_PATTERN, date_str) is not None\n\n    @staticmethod\n    def _validate_calendar(year: int, month: int, day: int) -> ValidationResult:\n        \"\"\"Validates if the given year, month, and day form a calendrically valid date.\"\"\"\n        try:\n            datetime(year, month, day)\n            return ValidationResult(isValid=True)\n        except ValueError as e:\n            return ValidationResult(isValid=False, message=str(e))\n\n    @staticmethod\n    def _format_dd_mm_yyyy(day: int, month: int, year: int) -> str:\n        \"\"\"Formats the given date components into dd-mm-yyyy with zero-padding.\"\"\"\n        return f\"{day:02d}-{month:02d}-{year}\"\n\n    @staticmethod\n    def change_date_format(dateStr: str) -> str:\n        \"\"\"\n        Converts a date from yyyy-mm-dd format to dd-mm-yyyy format.\n        Raises ValueError for invalid pattern or calendrically invalid dates.\n        \"\"\"\n        if not ChangeDateFormatService._match_pattern(dateStr):\n            raise ValueError(f\"Input does not match pattern {ChangeDateFormatService.DATE_PATTERN}\")\n\n        try:\n            year_str, month_str, day_str = dateStr.split('-')\n            year = int(year_str)\n            month = int(month_str)\n            day = int(day_str)\n        except ValueError:\n            # This case should ideally be caught by _match_pattern if regex is strict enough\n            # but as a safeguard if input passed regex but split/int conversion failed for non-numeric parts.\n            raise ValueError(\"Input date parts are not valid integers.\")\n\n        calendar_validation = ChangeDateFormatService._validate_calendar(year, month, day)\n        if not calendar_validation.isValid:\n            raise ValueError(f\"Invalid calendar date: {calendar_validation.message}\")\n\n        converted_date = ChangeDateFormatService._format_dd_mm_yyyy(day, month, year)\n        # Per design, instantiate DateString, though not explicitly returned, for internal consistency.\n        # This instance is not returned directly by the public function.\n        DateString(original=dateStr, year=year, month=month, day=day, converted=converted_date)\n        \n        return converted_date\n\ndef change_date_format(dateStr: str) -> str:\n    \"\"\"\n    Converts a date from yyyy-mm-dd format to dd-mm-yyyy format.\n    Raises ValueError for invalid pattern or calendrically invalid dates.\n    \"\"\"\n    return ChangeDateFormatService.change_date_format(dateStr)"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(lst):\n    \"\"\"Sorts a list in ascending order using Shell sort and returns the sorted list.\n    The function sorts the input list in-place.\"\"\"\n    n = len(lst)\n    # Start with a large gap and reduce it\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for the current gap size\n        for i in range(gap, n):\n            temp = lst[i]\n            j = i\n            # Shift elements greater than temp to the right\n            while j >= gap and lst[j - gap] > temp:\n                lst[j] = lst[j - gap]\n                j -= gap\n            lst[j] = temp\n        gap //= 2\n    return lst"}
{"task_id": "Mbpp/429", "solution": "def _validate_is_tuple_of_ints(x: tuple, name: str) -> None:\n    \"\"\"Ensures x is a tuple and all elements are integers, raising ValueError on violation.\"\"\"\n    if not isinstance(x, tuple):\n        raise ValueError(f\"'{name}' must be a tuple\")\n    if any(not isinstance(elem, int) for elem in x):\n        raise ValueError(f\"all elements of '{name}' must be integers\")\n\ndef _validate_equal_length(a: tuple, b: tuple) -> None:\n    \"\"\"Ensures input tuples a and b have the same length, raising ValueError on mismatch.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"input tuples must have the same length\")\n\ndef and_tuples(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the element-wise bitwise AND of two input tuples of integers.\n    The function validates inputs for type and length before computation.\n    \"\"\"\n    _validate_is_tuple_of_ints(a, 'a')\n    _validate_is_tuple_of_ints(b, 'b')\n    _validate_equal_length(a, b)\n\n    return tuple(a_elem & b_elem for a_elem, b_elem in zip(a, b))"}
