{"task_id": "Mbpp/630", "solution": "class Coordinate:\n    \"\"\"Represents a coordinate with x and y integer values.\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = x\n        self.y = y\n\n    def toList(self):\n        \"\"\"Returns the coordinate as a two-element list [x, y].\"\"\"\n        return [self.x, self.y]\n\nclass CoordinateList:\n    \"\"\"A container for ordered Coordinate objects with conversion to a nested list.\"\"\"\n    def __init__(self):\n        self.coordinates = []\n\n    def add(self, coord: Coordinate):\n        \"\"\"Adds a Coordinate object to the list.\"\"\"\n        self.coordinates.append(coord)\n\n    def toNestedLists(self):\n        \"\"\"Converts the stored coordinates to a list of two-element lists.\"\"\"\n        return [c.toList() for c in self.coordinates]\n\nclass Validator:\n    \"\"\"Validates input for the get_coordinates function.\"\"\"\n    def validateInput(self, input):\n        \"\"\"Checks if input is a two-element tuple of integers, raising TypeError if not.\"\"\"\n        if not isinstance(input, tuple) or len(input) != 2:\n            raise TypeError(\"input must be a two-element tuple of integers\")\n        x, y = input\n        if not isinstance(x, int) or not isinstance(y, int):\n            raise TypeError(\"input must be a two-element tuple of integers\")\n        return None\n\nclass GetCoordinatesService:\n    \"\"\"Computes and orders the 3x3 grid of adjacent coordinates.\"\"\"\n    def get_coordinates(self, input):\n        \"\"\"Generates the 3x3 grid of coordinates centered around the input.\"\"\"\n        x, y = input\n        cl = CoordinateList()\n        for x_iter in (x - 1, x, x + 1):\n            for y_iter in (y - 1, y, y + 1):\n                cl.add(Coordinate(x_iter, y_iter))\n        return cl.toNestedLists()\n\ndef get_coordinates(input_coord):\n    \"\"\"\n    Extracts all adjacent coordinates (3x3 grid) of the given coordinate tuple.\n    Includes the input coordinate itself, ordered by x ascending then y ascending.\n    \"\"\"\n    Validator().validateInput(input_coord)\n    return GetCoordinatesService().get_coordinates(input_coord)"}
{"task_id": "Mbpp/632", "solution": "class Element:\n    \"\"\"Wrapper for an individual value providing an is_zero() method.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_zero(self):\n        \"\"\"Checks if the element's value compares equal to 0.\"\"\"\n        return self.value == 0\n\nclass InputList:\n    \"\"\"Adapter for a Python list, representing the input domain object.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def length(self):\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass OutputList:\n    \"\"\"Adapter for a Python list, representing the output domain object.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def length(self):\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass MoveZeroFunction:\n    \"\"\"Stateless domain service that executes the move-zero operation.\"\"\"\n    def execute(self, input_list_adapter: InputList) -> OutputList:\n        \"\"\"Processes the input list, separating zeros and non-zeros, then recombining.\"\"\"\n        non_zeros = []\n        zeros = []\n\n        for element_value in input_list_adapter.elements:\n            element = Element(element_value)\n            if element.is_zero():\n                zeros.append(element_value)\n            else:\n                non_zeros.append(element_value)\n\n        result_elements = non_zeros + zeros\n        return OutputList(result_elements)\n\ndef move_zero(input_list):\n    \"\"\"Moves all zero-equivalent elements to the end of the given list.\"\"\"\n    input_adapter = InputList(input_list)\n    mover = MoveZeroFunction()\n    output_adapter = mover.execute(input_adapter)\n    return output_adapter.elements"}
{"task_id": "Mbpp/633", "solution": "def _validate_inputs(values: list, n: int) -> None:\n    \"\"\"Validates the types of the input parameters.\"\"\"\n    if not isinstance(values, list) or not isinstance(n, int):\n        raise TypeError(\"Input 'values' must be a list and 'n' must be an integer.\")\n\ndef _effective_n(values: list, n: int) -> int:\n    \"\"\"Computes the effective number of elements to consider, ensuring it does not exceed list length.\"\"\"\n    return min(n, len(values))\n\ndef _sum_xor_pairs(values: list, n: int) -> int:\n    \"\"\"Calculates the sum of XORs for all unique unordered pairs within the first 'n' elements.\"\"\"\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (values[i] ^ values[j])\n    return total_xor_sum\n\ndef pair_xor_Sum(values: list, n: int) -> int:\n    \"\"\"\n    Finds the sum of XORs of all pairs of numbers in the given list, considering up to 'n' elements.\n    It returns 0 if fewer than two elements are effectively considered.\n    \"\"\"\n    _validate_inputs(values, n)\n    \n    n_effective = _effective_n(values, n)\n    \n    if n_effective < 2:\n        return 0\n    \n    return _sum_xor_pairs(values, n_effective)"}
{"task_id": "Mbpp/631", "solution": "import enum\n\nclass Direction(enum.Enum):\n    \"\"\"Enumeration for the direction of whitespace replacement.\"\"\"\n    space_to_underscore = \"space_to_underscore\"\n    underscore_to_space = \"underscore_to_space\"\n\n    @classmethod\n    def from_value(cls, value: 'Direction | str | None') -> 'Direction':\n        \"\"\"Converts a string or None to a Direction enum member, defaulting for None or raising ValueError.\"\"\"\n        if value is None:\n            return cls.space_to_underscore\n        if isinstance(value, cls):\n            return value\n        if isinstance(value, str):\n            for member in cls:\n                if member.value == value:\n                    return member\n        raise ValueError(f\"Invalid direction value: {value}. Expected 'space_to_underscore', 'underscore_to_space', or None.\")\n\n\nclass InputString:\n    \"\"\"A value object representing an input string.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n        self.length = len(content)\n\nclass OutputString:\n    \"\"\"A value object representing an output string.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n\nclass ReplaceSpacesService:\n    \"\"\"Stateless service for replacing spaces with underscores and vice versa.\"\"\"\n    def replace(self, input_str_obj: InputString, direction: Direction) -> OutputString:\n        \"\"\"Performs the character replacement based on the specified direction.\"\"\"\n        if direction == Direction.space_to_underscore:\n            result = input_str_obj.content.replace(' ', '_')\n        elif direction == Direction.underscore_to_space:\n            result = input_str_obj.content.replace('_', ' ')\n        else:\n            # This case should ideally be caught by Direction.from_value, but for robustness\n            raise ValueError(f\"Unknown direction: {direction}\")\n        return OutputString(result)\n\n\ndef replace_spaces(input: str, direction: 'Direction | str | None' = None) -> str:\n    \"\"\"\n    Replaces whitespaces with an underscore and vice versa in a given string.\n    The default direction is replacing spaces with underscores.\n    \"\"\"\n    chosen_direction = Direction.from_value(direction)\n    service = ReplaceSpacesService()\n    input_obj = InputString(input)\n    output_obj = service.replace(input_obj, chosen_direction)\n    return output_obj.content"}
