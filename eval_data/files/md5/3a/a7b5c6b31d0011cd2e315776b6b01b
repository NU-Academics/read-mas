{"task_id": "Mbpp/2", "solution": "def similar_elements(seq1, seq2):\n    \"\"\"Compute an iterable of unique elements present in both seq1 and seq2.\n\n    Args:\n      seq1: list or tuple of hashable items\n      seq2: list or tuple of hashable items\n\n    Returns:\n      Iterable yielding each shared value exactly once (generator).\n    \"\"\"\n    set1 = set(seq1)\n    yielded_items = set()\n    for item in seq2:\n        if item in set1 and item not in yielded_items:\n            yielded_items.add(item)\n            yield item"}
{"task_id": "Mbpp/9", "solution": "def rotate(s: str, k: int) -> str:\n    \"\"\"\n    Returns the left cyclic rotation of string s by k positions.\n    \"\"\"\n    n = len(s)\n    k = k % n  # Handle rotations greater than string length\n    return s[k:] + s[:k]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0 # Or handle as per specific design, but 0 seems logical for an empty string.\n                 # The design mentions raising ValueError for empty string but also \"may raise ValueError\".\n                 # Given no explicit instruction to raise, returning 0 is consistent with finding 0 rotations for 0 length.\n\n    for k in range(1, n + 1):\n        if rotate(s, k) == s:\n            return k\n    return n # Fallback, though a string always equals itself after n rotations."}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Sequence\n\ndef heap_queue_largest(numbers: Sequence[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Duplicates are treated as separate elements.\n    \"\"\"\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a number is non-prime.\n    Returns True if n is non-prime, False if n is prime.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"is_not_prime expects int input\")\n\n    if n < 2:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to sqrt(n)\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/8", "solution": "def square_nums(input_list: list) -> list:\n    \"\"\"\n    Calculates the square of each element in the input list.\n    Assumes the input is a list of numbers.\n    \"\"\"\n    return [x * x for x in input_list]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is true if their XOR sum is a power of two.\n    \"\"\"\n    xor_result = a ^ b\n    # A number is a power of two if it's positive and (number & (number - 1)) is 0.\n    # We also require that the numbers actually differ, so xor_result must not be 0.\n    return (xor_result != 0) and ((xor_result & (xor_result - 1)) == 0)"}
{"task_id": "Mbpp/7", "solution": "class StringInput:\n    \"\"\"Lightweight wrapper holding rawText: str.\"\"\"\n    def __init__(self, rawText: str):\n        self.rawText = rawText\n\nclass Tokenizer:\n    \"\"\"Tokenize input text by splitting on whitespace.\"\"\"\n    def tokenize(self, text: str) -> list[str]:\n        \"\"\"Splits the text by whitespace and returns a list of tokens.\"\"\"\n        return text.split()\n\nclass Word:\n    \"\"\"Represent a token and provide length calculation.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's text.\"\"\"\n        return len(self.text)\n\nclass WordCollection:\n    \"\"\"Collect qualifying tokens and expose results.\"\"\"\n    def __init__(self):\n        self._words: list[str] = []\n\n    def add(self, word: str) -> None:\n        \"\"\"Adds a word to the collection.\"\"\"\n        self._words.append(word)\n\n    def to_list(self) -> list[str]:\n        \"\"\"Returns the collected words as a list.\"\"\"\n        return self._words\n\nclass FinderFunction:\n    \"\"\"Coordinate processing: wrap input, tokenize, filter, collect.\"\"\"\n    def find_char_long(self, input_str: str) -> list[str]:\n        \"\"\"Orchestrates tokenization, filtering, and collection of words.\"\"\"\n        string_input = StringInput(input_str)\n        tokenizer = Tokenizer()\n        tokens = tokenizer.tokenize(string_input.rawText)\n        \n        word_collection = WordCollection()\n        for token in tokens:\n            word = Word(token)\n            if word.length() >= 4:\n                word_collection.add(word.text)\n        \n        return word_collection.to_list()\n\ndef find_char_long(input: str) -> list[str]:\n    \"\"\"Public API: returns a list of strings, each a word from input with length >= 4.\"\"\"\n    finder = FinderFunction()\n    return finder.find_char_long(input)"}
{"task_id": "Mbpp/11", "solution": "from dataclasses import dataclass\nfrom typing import List, Set\n\n@dataclass\nclass InputString:\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass Character:\n    value: str\n\n    def is_single(self) -> bool:\n        return isinstance(self.value, str) and len(self.value) == 1\n\n@dataclass\nclass Occurrence:\n    index: int\n\n@dataclass\nclass Result:\n    value: str\n\n@dataclass\nclass TestCase:\n    name: str\n    expected: str\n\ndef validate_target_char(target_char: str) -> None:\n    \"\"\"Validates that target_char is a single-character string.\"\"\"\n    char_obj = Character(value=target_char)\n    if not char_obj.is_single():\n        raise ValueError(\"Target character must be a single-character string.\")\n\ndef find_occurrence_indices(input_str: str, ch: str) -> List[int]:\n    \"\"\"Finds all 0-based indices where character 'ch' occurs in 'input_str'.\"\"\"\n    indices = []\n    for i, char in enumerate(input_str):\n        if char == ch:\n            indices.append(i)\n    return indices\n\ndef assemble_result_from_indices(input_str: str, remove_indices: Set[int]) -> str:\n    \"\"\"Assembles a string from input_str, excluding characters at remove_indices.\"\"\"\n    result_chars = []\n    for i, char in enumerate(input_str):\n        if i not in remove_indices:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef remove_Occ(input_string: str, target_char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Returns the modified string, or the original if no changes are made.\n    \"\"\"\n    validate_target_char(target_char)\n\n    indices = find_occurrence_indices(input_string, target_char)\n\n    if not indices:\n        return input_string\n\n    remove_indices: Set[int]\n    if len(indices) == 1:\n        remove_indices = {indices[0]}\n    else:\n        remove_indices = {indices[0], indices[-1]}\n\n    return assemble_result_from_indices(input_string, remove_indices)"}
{"task_id": "Mbpp/17", "solution": "class Square:\n    \"\"\"Data holder for a square's side length.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self.side_length = side_length\n\nclass PerimeterResult:\n    \"\"\"Data holder for the computed perimeter value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass PerimeterCalculator:\n    \"\"\"Encapsulates the computation of a square's perimeter.\"\"\"\n    def square_perimeter(self, side_length: float) -> float:\n        square = Square(side_length)\n        value = 4 * square.side_length\n        result = PerimeterResult(value)\n        return result.value\n\ndef square_perimeter(side_length: float) -> float:\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    Delegates the computation to an internal PerimeterCalculator.\n    \"\"\"\n    calculator = PerimeterCalculator()\n    return calculator.square_perimeter(side_length)"}
