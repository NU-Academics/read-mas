{"task_id": "Mbpp/446", "solution": "def count_Occurrence(t: tuple, lst: list) -> int:\n    \"\"\"\n    Counts the total occurrences of elements from a list within a tuple.\n    Each element in the tuple that matches any element in the list increments the count.\n    \"\"\"\n    count = 0\n    for element_in_t in t:\n        for element_in_lst in lst:\n            if element_in_t == element_in_lst:\n                count += 1\n    return count"}
{"task_id": "Mbpp/445", "solution": "from typing import Tuple\n\nclass ValidationException(Exception):\n    \"\"\"Exception raised for validation failures due to length mismatches.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\ndef validate_outer_lengths(left: Tuple[Tuple, ...], right: Tuple[Tuple, ...]) -> None:\n    \"\"\"Raises ValidationException if the outer lengths of the two tuples do not match.\"\"\"\n    if len(left) != len(right):\n        raise ValidationException(\"Outer tuple lengths do not match.\")\n\ndef validate_inner_lengths(left_i: Tuple, right_i: Tuple) -> None:\n    \"\"\"Raises ValidationException if corresponding inner tuple lengths do not match.\"\"\"\n    if len(left_i) != len(right_i):\n        raise ValidationException(\"Inner tuple lengths do not match for corresponding elements.\")\n\ndef multiply_inner_pairs(left_i: Tuple, right_i: Tuple) -> Tuple:\n    \"\"\"Performs element-wise multiplication of two inner tuples.\"\"\"\n    return tuple(left_i[j] * right_i[j] for j in range(len(left_i)))\n\ndef index_multiplication(left: Tuple[Tuple, ...], right: Tuple[Tuple, ...]) -> Tuple[Tuple, ...]:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements from two given tuples of tuples.\n    Raises ValidationException if outer or corresponding inner tuple lengths do not match.\n    \"\"\"\n    validate_outer_lengths(left, right)\n\n    result_outer_tuple = []\n    for i in range(len(left)):\n        left_inner = left[i]\n        right_inner = right[i]\n\n        validate_inner_lengths(left_inner, right_inner)\n\n        multiplied_inner_tuple = multiply_inner_pairs(left_inner, right_inner)\n        result_outer_tuple.append(multiplied_inner_tuple)\n\n    return tuple(result_outer_tuple)"}
{"task_id": "Mbpp/448", "solution": "class PerrinCalculator:\n    \"\"\"\n    Calculates Perrin numbers and their sums using memoization.\n    \"\"\"\n    def __init__(self):\n        self._memo = {0: 3, 1: 0, 2: 2}\n\n    def compute_perrin(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Perrin number using memoization based on the recurrence P(n)=P(n-2)+P(n-3).\n        \"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        result = self.compute_perrin(n - 2) + self.compute_perrin(n - 3)\n        self._memo[n] = result\n        return result\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of Perrin numbers from P(0) to P(n).\n        \"\"\"\n        total_sum = 0\n        for i in range(n + 1):\n            total_sum += self.compute_perrin(i)\n        return total_sum\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n).\n    \"\"\"\n    calculator = PerrinCalculator()\n    return calculator.cal_sum(n)"}
{"task_id": "Mbpp/450", "solution": "from typing import List\n\ndef extract_string(strings: List[str], size: int) -> List[str]:\n    \"\"\"\n    Extracts strings of a specified size from a list of strings.\n    Validates input parameters and returns a new list with matching strings.\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"strings must be a list of str\")\n    if not isinstance(size, int):\n        raise TypeError(\"size must be an int\")\n    if size < 0:\n        raise ValueError(\"size must be a non-negative integer\")\n\n    result_list = []\n    for item in strings:\n        # The design context assumes List[str] for string items,\n        # so explicit checks for item type are not required per design.\n        if len(item) == size:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all specified whitespace characters from the input string.\"\"\"\n    def _is_whitespace(ch: str) -> bool:\n        # Checks if a character is one of the specified whitespace characters.\n        return ch in (' ', '\\t', '\\n', '\\r')\n\n    result_chars = []\n    for char in input:\n        if not _is_whitespace(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
