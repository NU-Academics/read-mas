{"task_id": "Mbpp/142", "solution": "def count_samepair(a: list, b: list, c: list) -> int:\n    \"\"\"Accept exactly three lists and return an integer count of positions where all three elements are equal up to the shortest list length.\"\"\"\n    count = 0\n    min_length = min(len(a), len(b), len(c))\n\n    for i in range(min_length):\n        if a[i] == b[i] == c[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def _validate_sequence_is_tuple_or_list(values):\n    \"\"\"\n    Validates if the input is a tuple or a list.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(values, (tuple, list)):\n        raise TypeError(\"Input must be a tuple or a list.\")\n\ndef _validate_elements_are_numeric(values):\n    \"\"\"\n    Validates if all elements in the sequence are numeric (int or float).\n    Raises TypeError if validation fails.\n    \"\"\"\n    for element in values:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n\ndef max_Abs_Diff(values):\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in the input sequence.\n    The input must be a tuple or list of numeric values.\n    \"\"\"\n    _validate_sequence_is_tuple_or_list(values)\n    _validate_elements_are_numeric(values)\n\n    max_val = max(values)\n    min_val = min(values)\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/161", "solution": "from typing import Any, List, Set\n\ndef _compare_and_filter(source_list: List[Any], remove_set: Set[Any]) -> List[Any]:\n    \"\"\"\n    Filters elements from source_list that are not present in remove_set,\n    preserving the original order.\n    \"\"\"\n    result = []\n    for item in source_list:\n        if item not in remove_set:\n            result.append(item)\n    return result\n\ndef remove_elements(source_list, elements_to_remove):\n    \"\"\"\n    Removes all elements from source_list that are present in elements_to_remove,\n    returning a new list.\n    \"\"\"\n    if not source_list:\n        return []\n\n    if not elements_to_remove:\n        return list(source_list)\n\n    remove_set = set(elements_to_remove)\n\n    return _compare_and_filter(source_list, remove_set)"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    def _validate_integers(val_a, val_b, val_n):\n        \"\"\"Validates that inputs are integers, raising ValueError if not.\"\"\"\n        if not isinstance(val_a, int) or not isinstance(val_b, int) or not isinstance(val_n, int):\n            raise ValueError(\"Inputs a, b, and n must be integers.\")\n\n    def _extended_gcd(num1: int, num2: int) -> tuple[int, int, int]:\n        \"\"\"\n        Computes (g, x, y) such that num1*x + num2*y = g = gcd(num1, num2).\n        The gcd g is always positive.\n        \"\"\"\n        sign_a = 1 if num1 >= 0 else -1\n        sign_b = 1 if num2 >= 0 else -1\n        \n        abs_a = abs(num1)\n        abs_b = abs(num2)\n\n        if abs_a == 0:\n            return (abs_b, 0, sign_b if abs_b != 0 else 0)\n\n        x_prev, y_prev = 1, 0\n        x_curr, y_curr = 0, 1\n        \n        while abs_b != 0:\n            q = abs_a // abs_b\n            abs_a, abs_b = abs_b, abs_a % abs_b\n            \n            x_prev, x_curr = x_curr, x_prev - q * x_curr\n            y_prev, y_curr = y_curr, y_prev - q * y_curr\n        \n        g = abs_a\n        final_x = x_prev * sign_a\n        final_y = y_prev * sign_b\n            \n        return (g, final_x, final_y)\n\n    _validate_integers(a, b, n)\n\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        else:\n            return None\n    elif a == 0:\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    elif b == 0:\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n    \n    # General case: a != 0 and b != 0\n    g, x0, y0 = _extended_gcd(a, b)\n\n    if n % g != 0:\n        return None\n\n    scale = n // g\n    x_particular = x0 * scale\n    y_particular = y0 * scale\n\n    # Adjust the particular solution to return a canonical solution\n    # (e.g., smallest non-negative x) to match specific example requirements.\n    b_factor = abs(b // g)\n    # b_factor will always be >= 1 here because b != 0 and g divides b.\n    \n    x_adjusted = (x_particular % b_factor + b_factor) % b_factor\n    y_adjusted = (n - a * x_adjusted) // b\n\n    return (x_adjusted, y_adjusted)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\"\"\"\n    k = n // 2 + 1\n    if k <= 0:\n        return 0\n    return k * (n - (k - 1))"}
{"task_id": "Mbpp/165", "solution": "ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based position in the English alphabet (case-insensitive).\n    Only letters 'a'-'z' are considered, and only for positions 1-26.\n    \"\"\"\n    count = 0\n    for i, ch in enumerate(input, start=1):\n        if i > 26:\n            continue\n        expected_letter = ALPHABET[i - 1]\n        normalized_char = ch.lower()\n        if 'a' <= normalized_char <= 'z' and normalized_char == expected_letter:\n            count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Return the smallest power of two greater than or equal to n.\n    Handles n <= 1 by returning 1.\"\"\"\n    p = 1\n    while p < n:\n        p *= 2\n    return p"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(arr: List[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR is an even number.\n    This is equivalent to counting pairs with the same parity (both even or both odd).\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for x in arr:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Number of pairs of even numbers: E * (E - 1) / 2\n    # Number of pairs of odd numbers: O * (O - 1) / 2\n    # Both XOR to an even number.\n    even_pairs = (even_count * (even_count - 1)) // 2\n    odd_pairs = (odd_count * (odd_count - 1)) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/168", "solution": "from typing import Iterable, List, Union\n\nNumber = Union[int, float]\n\nclass NumberElement:\n    \"\"\"Lightweight container for a single numeric value.\"\"\"\n    def __init__(self, value: Number):\n        self.value = value\n\nclass NumberList:\n    \"\"\"Container for NumberElement instances, representing the input list.\"\"\"\n    def __init__(self, elements: Iterable[Number]):\n        self.elements: List[NumberElement] = [NumberElement(e) for e in elements]\n\n    def __iter__(self):\n        return iter(self.elements)\n\nclass FrequencyResult:\n    \"\"\"Encapsulate the target and computed count.\"\"\"\n    def __init__(self, target: Number, count: int):\n        self.target = target\n        self.count = count\n\nclass FrequencyFunction:\n    \"\"\"Provides the concrete algorithm to count occurrences.\"\"\"\n    def frequency(self, list_or_iterable: Union[Iterable[Number], NumberList], target: Number) -> int:\n        # Ensure we have a NumberList to work with, converting if necessary.\n        if isinstance(list_or_iterable, NumberList):\n            number_list = list_or_iterable\n        else:\n            number_list = NumberList(list_or_iterable)\n\n        count = 0\n        for element in number_list:\n            if element.value == target:\n                count += 1\n        return FrequencyResult(target, count).count\n\ndef frequency(list: Iterable[Number], target: Number) -> int:\n    \"\"\"Return integer count of occurrences of target in list.\"\"\"\n    # Delegates to FrequencyFunction.frequency and returns int.\n    return FrequencyFunction().frequency(list, target)"}
{"task_id": "Mbpp/170", "solution": "from typing import Sequence, Union\n\ndef sum_range_list(numbers: Sequence[Union[int, float]], start: int, end: int) -> Union[int, float]:\n    \"\"\"Computes the sum of numbers in a list within a specified range of indices.\"\"\"\n    if start > end:\n        raise ValueError(\"Start index cannot be greater than end index.\")\n    if start < 0 or end >= len(numbers):\n        raise IndexError(\"Indices are out of range for the provided list.\")\n\n    total_sum: Union[int, float] = 0\n    for i in range(start, end + 1):\n        total_sum += numbers[i]\n    return total_sum"}
