{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Encapsulates integer input and computes canonical decimal representation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def decimal_repr(self) -> str:\n        \"\"\"Returns canonical decimal representation without sign or leading zeros.\"\"\"\n        return str(abs(self.value))\n\nclass DigitSequence:\n    \"\"\"Represents a left-to-right digit list and provides indexing and length operations.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def digitAt(self, pos: int) -> int:\n        \"\"\"Returns the digit at the specified 1-based position.\"\"\"\n        return self.digits[pos - 1]\n\n    @staticmethod\n    def parse_digits(number_obj: 'Number') -> 'DigitSequence':\n        \"\"\"Parses a Number's decimal representation into a DigitSequence.\"\"\"\n        decimal_string = number_obj.decimal_repr()\n        digits = [int(d) for d in decimal_string]\n        return DigitSequence(digits)\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating.\n    An undulating number's decimal digits alternate between exactly two distinct digit values.\n    \"\"\"\n    number_obj = Number(number)\n    digit_sequence = DigitSequence.parse_digits(number_obj)\n    seq_length = digit_sequence.length()\n\n    # Numbers with fewer than 2 digits are not undulating (BR5)\n    if seq_length < 2:\n        return False\n\n    # Extract the first two digits to determine the alternating pattern (BR7)\n    odd_value = digit_sequence.digitAt(1)\n    even_value = digit_sequence.digitAt(2)\n\n    # The two alternating digits must be distinct (BR4)\n    if odd_value == even_value:\n        return False\n\n    # Verify all subsequent digits follow the alternation pattern (BR3)\n    for i in range(1, seq_length + 1):\n        current_digit = digit_sequence.digitAt(i)\n        if i % 2 == 1: # Odd position\n            if current_digit != odd_value:\n                return False\n        else: # Even position\n            if current_digit != even_value:\n                return False\n\n    return True"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list of lists is empty.\n    \"\"\"\n    return min((len(inner_list) for inner_list in list_of_lists), default=0)"}
{"task_id": "Mbpp/94", "solution": "class InputTypeError(Exception):\n    \"\"\"Exception raised for invalid input types or structures.\"\"\"\n    pass\n\nclass EmptyInputError(Exception):\n    \"\"\"Exception raised when the input iterable is empty.\"\"\"\n    pass\n\nclass ComparisonError(Exception):\n    \"\"\"Exception raised when elements cannot be compared.\"\"\"\n    pass\n\nclass ErrorHandler:\n    \"\"\"Handles raising specific exception types with descriptive messages.\"\"\"\n    def raise_input_type_error(self, message: str):\n        raise InputTypeError(message)\n\n    def raise_empty_input_error(self):\n        raise EmptyInputError(\"Input iterable cannot be empty.\")\n\n    def raise_comparison_error(self, message: str):\n        raise ComparisonError(message)\n\nclass Validator:\n    \"\"\"Validates the structure and content of the input list of tuples.\"\"\"\n    def __init__(self, error_handler: ErrorHandler):\n        self._error_handler = error_handler\n\n    def validate(self, list_of_tuples):\n        \"\"\"\n        Validates that the input is a non-empty list or tuple,\n        and each item is a 2-element list or tuple.\n        \"\"\"\n        if list_of_tuples is None:\n            self._error_handler.raise_input_type_error(\"Input cannot be None.\")\n\n        if not isinstance(list_of_tuples, (list, tuple)):\n            self._error_handler.raise_input_type_error(\"Input must be a list or tuple.\")\n        \n        if not list_of_tuples: # Checks for empty list/tuple\n            self._error_handler.raise_empty_input_error()\n            \n        for i, item in enumerate(list_of_tuples):\n            if not isinstance(item, (list, tuple)):\n                self._error_handler.raise_input_type_error(\n                    f\"Each item in the list must be a tuple or list, got type {type(item).__name__} at index {i}.\"\n                )\n            if len(item) != 2:\n                self._error_handler.raise_input_type_error(\n                    f\"Each item in the list must be a 2-element tuple or list, got length {len(item)} at index {i} for item {item!r}.\"\n                )\n\nclass Comparator:\n    \"\"\"Finds the tuple with the smallest second value, ensuring stable tie-breaking.\"\"\"\n    def __init__(self, error_handler: ErrorHandler):\n        self._error_handler = error_handler\n\n    def find_min(self, list_of_tuples):\n        \"\"\"\n        Iterates through the list of tuples to find the one with the smallest second value.\n        Ties are resolved by returning the first-occurring tuple.\n        \"\"\"\n        # Validator ensures list_of_tuples is not empty and contains 2-element sequences.\n        first_item = list_of_tuples[0]\n        min_first_value, min_second_value = first_item[0], first_item[1]\n\n        # Iterate from the second element (index 1) to compare\n        for i in range(1, len(list_of_tuples)):\n            item = list_of_tuples[i]\n            current_first_value, current_second_value = item[0], item[1]\n\n            try:\n                if current_second_value < min_second_value:\n                    min_first_value = current_first_value\n                    min_second_value = current_second_value\n                # Stable tie-breaking: if equal, min_first_value/min_second_value remain unchanged.\n            except TypeError as e:\n                self._error_handler.raise_comparison_error(\n                    f\"Cannot compare second elements: {min_second_value!r} and {current_second_value!r} at index {i}. Original error: {e}\"\n                )\n        \n        return (min_first_value, min_second_value)\n\ndef index_minimum(list_of_tuples):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value\n    from a given list of 2-element tuples.\n    \"\"\"\n    error_handler = ErrorHandler()\n    validator = Validator(error_handler)\n    comparator = Comparator(error_handler)\n\n    validator.validate(list_of_tuples)\n    \n    # After validation, list_of_tuples is guaranteed to be a non-empty list/tuple\n    # of 2-element sequences (tuples/lists).\n    min_tuple = comparator.find_min(list_of_tuples)\n    \n    return min_tuple[0]"}
{"task_id": "Mbpp/96", "solution": "def _validate_integer(n):\n    \"\"\"Validates if the input n is an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be int\")\n\ndef _count_divisors(n):\n    \"\"\"Counts the number of positive divisors for a given positive integer n.\"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\n\ndef divisor(n):\n    \"\"\"\n    Finds the number of positive divisors of a given integer n.\n    Handles input validation and absolute value for negative inputs.\n    \"\"\"\n    _validate_integer(n)\n    \n    n_abs = abs(n)\n    \n    if n_abs == 0:\n        raise ValueError(\"divisor count for 0 is undefined\")\n        \n    return _count_divisors(n_abs)"}
{"task_id": "Mbpp/99", "solution": "import math\n\ndef decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Handles the special case where 0 returns '0' and ensures no leading zeros for other numbers.\n    \"\"\"\n    if n == 0:\n        return '0'\n\n    binary_string = []\n    temp_n = n\n    while temp_n > 0:\n        remainder = temp_n % 2\n        binary_string.append(str(remainder))\n        temp_n //= 2\n    \n    return \"\".join(reversed(binary_string))"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a CamelCase (PascalCase) string.\n    Splits on underscores, capitalizes each non-empty segment, and concatenates them.\n    \"\"\"\n    segments = input.split('_')\n    camel_case_segments = [segment[0].upper() + segment[1:] for segment in segments if segment]\n    return ''.join(camel_case_segments)"}
{"task_id": "Mbpp/103", "solution": "class EulerianCalculator:\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Compute Eulerian number a(n, m) using dynamic programming.\"\"\"\n        if n < 0:\n            return 0  # Eulerian numbers are typically defined for non-negative n.\n\n        if n == 0:\n            return 1 if m == 0 else 0\n\n        # For n > 0, a(n, m) is 0 if m is out of range [0, n-1].\n        if m < 0 or m >= n:\n            return 0\n\n        # Initialize DP table: dp[i][j] stores a(i, j).\n        # i runs from 0 to n. j runs from 0 to n-1 (max value for m is n-1).\n        dp = [[0] * (n) for _ in range(n + 1)]\n\n        # Base case: a(0, 0) = 1.\n        # Since n > 0 here, the 0-th row is initialized based on the recurrence implicitly.\n        # For the recurrence, a(1,0) = (0+1)*a(0,0) + (1-0)*a(0,-1). We need a(0,0)=1.\n        # The first meaningful row to compute explicitly is for i=1.\n        # However, to correctly handle the recurrence term a(i-1, j-1) when j=0, we need dp[i-1][0] to be valid.\n        # a(1,0) = 1. This can be seen as dp[1][0]\n        # a(0,0)=1 is the true base case for the recurrence.\n        dp[0][0] = 1\n\n        # Fill the DP table using the recurrence relation:\n        # a(i, j) = (j + 1) * a(i - 1, j) + (i - j) * a(i - 1, j - 1)\n        for i in range(1, n + 1):\n            for j in range(i):  # m can range from 0 to i-1 for a given i\n                term1 = (j + 1) * dp[i - 1][j]\n                term2 = (i - j) * (dp[i - 1][j - 1] if j - 1 >= 0 else 0)\n                dp[i][j] = term1 + term2\n\n        return dp[n][m]\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"Public API function; name must be exactly eulerian_num per SRS. Delegates to EulerianCalculator.eulerian_num.\"\"\"\n    calculator = EulerianCalculator()\n    return calculator.eulerian_num(n, m)"}
{"task_id": "Mbpp/101", "solution": "from typing import List, Any\n\nclass IndexError(Exception):\n    \"\"\"Custom exception for out-of-range indices.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Element:\n    \"\"\"Represents an element with its value and 1-based position.\"\"\"\n    def __init__(self, value: Any, position: int):\n        self.value = value\n        self.position = position\n\nclass Array:\n    \"\"\"A wrapper for an array-like collection, providing 1-based access.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements = list(elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def get_element_at_1_based(self, k: int) -> Element:\n        \"\"\"Returns the Element at the given 1-based index k.\"\"\"\n        return Element(self._elements[k - 1], position=k)\n\nclass Validator:\n    \"\"\"Provides static methods for validating array indices.\"\"\"\n    @staticmethod\n    def validate_index(array_obj: Array, k: int) -> bool:\n        \"\"\"Checks if the 1-based index k is within the bounds of the array.\"\"\"\n        return 1 <= k <= array_obj.length()\n\ndef kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises IndexError if k is out of range.\n    \"\"\"\n    array_wrapper = Array(array)\n    if not Validator.validate_index(array_wrapper, k):\n        raise IndexError(\"k out of range\")\n    \n    element = array_wrapper.get_element_at_1_based(k)\n    return element.value"}
{"task_id": "Mbpp/97", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the frequency_lists function.\"\"\"\n    def __init__(self, message: str = \"Invalid input provided.\"):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates the input structure for frequency_lists.\"\"\"\n    def validate(self, list_of_lists) -> None:\n        if not isinstance(list_of_lists, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        for sublist in list_of_lists:\n            if not isinstance(sublist, list):\n                raise InvalidInputError(\"All elements of the input list must be lists.\")\n\nclass ListFlattener:\n    \"\"\"Flattens a list of lists into a single list.\"\"\"\n    def flatten(self, list_of_lists) -> list:\n        flattened_list = []\n        for sublist in list_of_lists:\n            flattened_list.extend(sublist)\n        return flattened_list\n\nclass FrequencyCounter:\n    \"\"\"Counts the frequency of elements in a list.\"\"\"\n    def __init__(self):\n        self._frequency_map: dict = {}\n\n    def count(self, elements) -> dict:\n        self._frequency_map = {}\n        for element in elements:\n            self._frequency_map[element] = self._frequency_map.get(element, 0) + 1\n        return self._frequency_map\n\nclass FrequencyService:\n    \"\"\"Coordinates validation, flattening, and frequency counting.\"\"\"\n    def frequency_lists(self, list_of_lists) -> dict:\n        InputValidator().validate(list_of_lists)\n        flattened = ListFlattener().flatten(list_of_lists)\n        freq = FrequencyCounter().count(flattened)\n        return freq\n\ndef frequency_lists(list_of_lists) -> dict:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n\n    Validates input, flattens, and counts element occurrences.\n    \"\"\"\n    return FrequencyService().frequency_lists(list_of_lists)"}
{"task_id": "Mbpp/98", "solution": "from typing import Sequence\nfrom numbers import Number\n\nclass NumericSequence:\n    \"\"\"Encapsulates caller-supplied sequence, enforces validation, and provides sequence properties.\"\"\"\n    def __init__(self, elements: Sequence[Number]) -> None:\n        if not isinstance(elements, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple.\")\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated sequence.\"\"\"\n        return len(self.elements)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the encapsulated sequence is empty.\"\"\"\n        return self.length() == 0\n\n    def validateElementsAreNumeric(self) -> bool:\n        \"\"\"Validates if all elements in the sequence are numeric.\"\"\"\n        return all(isinstance(x, Number) for x in self.elements)\n\nclass MultiplyOperation:\n    \"\"\"Computes the numeric product of sequence elements.\"\"\"\n    def computeProduct(self, seq: NumericSequence) -> float:\n        product = 1.0\n        for item in seq.elements:\n            product *= item\n        return product\n\nclass LengthOperation:\n    \"\"\"Computes the integer length of the sequence.\"\"\"\n    def computeLength(self, seq: NumericSequence) -> int:\n        return seq.length()\n\nclass ResultValue:\n    \"\"\"Data holder for the final float result.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\ndef multiply_num(seq: Sequence[Number]) -> float:\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides by the length of the sequence.\n    Raises TypeError for invalid input type or non-numeric elements, ValueError for empty sequences.\n    \"\"\"\n    ns = NumericSequence(seq)\n\n    if ns.isEmpty():\n        raise ValueError(\"Input sequence must be non-empty\")\n\n    if not ns.validateElementsAreNumeric():\n        raise TypeError(\"All elements must be numeric (int or float)\")\n\n    prod = MultiplyOperation().computeProduct(ns)\n    length = LengthOperation().computeLength(ns)\n\n    result = float(prod) / length\n    return float(result)"}
{"task_id": "Mbpp/100", "solution": "def _extract_digits(n: int) -> list[int]:\n    \"\"\"Return a list of decimal digits (most-significant first) for |n|.\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    temp_n = abs(n)\n    while temp_n > 0:\n        digits.append(temp_n % 10)\n        temp_n //= 10\n    return digits[::-1]\n\ndef _mirror_left_to_right(digits: list[int]) -> list[int]:\n    \"\"\"Mirror the left half of digits onto the right half to form a palindrome.\"\"\"\n    length = len(digits)\n    mirrored_digits = list(digits)\n    mid = length // 2\n    for i in range(mid):\n        mirrored_digits[length - 1 - i] = mirrored_digits[i]\n    return mirrored_digits\n\ndef _increment_middle(digits: list[int]) -> list[int]:\n    \"\"\"Increment the middle portion of digits and propagate carry.\"\"\"\n    length = len(digits)\n    mid_idx = length // 2\n    \n    start_point = mid_idx if length % 2 == 1 else mid_idx - 1\n    \n    carry = 1\n    for i in range(start_point, -1, -1):\n        current_val = digits[i] + carry\n        digits[i] = current_val % 10\n        carry = current_val // 10\n        if carry == 0:\n            break\n            \n    if carry > 0:\n        # If carry remains, it implies the number of digits has increased (e.g., 99 -> 101).\n        # The new number will effectively start with '1' and have `length` zeros in between.\n        return [1] + [0] * length\n    \n    return digits\n\ndef _make_palindrome_candidate(digits: list[int], left_greater: bool) -> int:\n    \"\"\"Construct an integer palindrome candidate from a list of digits.\"\"\"\n    num = 0\n    for digit in digits:\n        num = num * 10 + digit\n    return num\n\ndef _is_palindrome(x: int) -> bool:\n    \"\"\"Check whether integer x is a palindrome in decimal representation.\"\"\"\n    if x < 0:\n        return False\n    digits = _extract_digits(x)\n    return digits == digits[::-1]\n\ndef _format_result(candidate: int) -> int:\n    \"\"\"Ensure the returned type is integer.\"\"\"\n    return candidate\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Find the next smallest palindrome of a specified integer, returned as an integer.\"\"\"\n    if n == 0:\n        return 1\n\n    digits = _extract_digits(n)\n    \n    while True:\n        candidate_digits = _mirror_left_to_right(digits)\n        candidate = _make_palindrome_candidate(candidate_digits, False)\n\n        if candidate > n:\n            return _format_result(candidate)\n        \n        # If candidate <= n, we need to increment the base digits.\n        # This handles cases where mirroring `n` gives `n` itself, or a smaller palindrome.\n        # Special handling for single-digit numbers (1-8) to ensure they roll over to 11.\n        if len(digits) == 1 and 1 <= digits[0] <= 8:\n            digits = [1, 0] # Forces to a 2-digit number base for mirroring to 11\n        else:\n            digits = _increment_middle(digits)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\n\nclass SortingAlgorithm:\n    def sort(self, items: Sequence[str]) -> List[str]:\n        \"\"\"Return a newly allocated sorted list of items (ascending lexicographic).\"\"\"\n        return sorted(items)\n\ndef sort_sublists(input_sequence: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"Accepts a sequence (list or tuple) of sublists of strings and returns a newly allocated list of lists with each sublist sorted ascending lexicographically.\"\"\"\n    result_list: List[List[str]] = []\n    sorter = SortingAlgorithm()\n    for sublist in input_sequence:\n        sorted_sublist = sorter.sort(sublist)\n        result_list.append(sorted_sublist)\n    return result_list"}
{"task_id": "Mbpp/105", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass BooleanValue:\n    value: bool\n\n@dataclass\nclass BooleanList:\n    elements: List[BooleanValue]\n\n@dataclass\nclass CountResult:\n    value: int\n\nclass CountFunction:\n    @staticmethod\n    def count(boolean_list: BooleanList) -> CountResult:\n        \"Iterate boolean_list.elements and count BooleanValue.value entries that are True; return CountResult.\"\n        true_count = 0\n        for bv in boolean_list.elements:\n            if bv.value is True:\n                true_count += 1\n        return CountResult(value=true_count)\n\ndef count(values: list[bool]) -> int:\n    \"Public API: accepts a list of boolean values and returns the integer count of values that are True. Constructs domain dataclasses, delegates to CountFunction, and returns the CountResult.value.\"\n    boolean_values = [BooleanValue(v) for v in values]\n    boolean_list_obj = BooleanList(elements=boolean_values)\n    \n    result_obj = CountFunction.count(boolean_list_obj)\n    \n    return result_obj.value"}
{"task_id": "Mbpp/106", "solution": "def add_lists(lst, tpl):\n    \"\"\"\n    Return a tuple whose elements are the elements of tpl followed by the elements of lst.\n    Do not modify lst or tpl.\n    \"\"\"\n    return tpl + tuple(lst)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds elements common to all sublists in a given list of lists.\n    Returns a list of unique common elements; order is not significant.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize common_elements with the first sublist converted to a set.\n    # If the first sublist is empty, no elements can be common to all.\n    if not nested_lists[0]:\n        return []\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the sublists to find the intersection.\n    for sublist in nested_lists[1:]:\n        # If any sublist is empty, there can be no common elements across all lists.\n        if not sublist:\n            return []\n        common_elements = common_elements.intersection(set(sublist))\n        # If at any point the set of common elements becomes empty, further intersections won't change this.\n        if not common_elements:\n            return []\n\n    return list(common_elements)"}
{"task_id": "Mbpp/108", "solution": "class MergeService:\n    \"\"\"\n    Manages validation, merging, and sorting of lists.\n    This class is stateless, providing static methods for core logic.\n    \"\"\"\n    @staticmethod\n    def _validate_list(lst, name):\n        \"\"\"Ensures the given input is a list and contains only integer elements.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(f\"validation error: Argument '{name}' must be a list.\")\n        for i, element in enumerate(lst):\n            if not isinstance(element, int):\n                raise TypeError(f\"validation error: Element at index {i} in '{name}' is not an integer.\")\n\n    @staticmethod\n    def merge_sorted_list(list1, list2, list3):\n        \"\"\"\n        Validates, merges, and sorts three lists of integers.\n        Returns a new list with all elements in non-decreasing order, preserving duplicates.\n        \"\"\"\n        MergeService._validate_list(list1, \"list1\")\n        MergeService._validate_list(list2, \"list2\")\n        MergeService._validate_list(list3, \"list3\")\n\n        combined = list1 + list2 + list3\n        sorted_combined = sorted(combined)\n        return sorted_combined\n\ndef merge_sorted_list(list1, list2, list3):\n    \"\"\"\n    Merges three lists into a single sorted list.\n    Delegates to the MergeService for validation and the core merging/sorting logic.\n    \"\"\"\n    return MergeService.merge_sorted_list(list1, list2, list3)"}
{"task_id": "Mbpp/113", "solution": "import re\n\nINTEGER_PATTERN = re.compile(r'^[+-]?\\d+$')\n\ndef matches_integer_pattern(s: str) -> bool:\n    \"\"\"Return True when s matches ^[+-]?\\\\d+$ (ASCII digits only).\"\"\"\n    return bool(INTEGER_PATTERN.match(s))\n\ndef check_integer(s: str) -> bool:\n    \"\"\"Return True if s represents an integer per BR2, else False.\"\"\"\n    return matches_integer_pattern(s)"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Counts the number of times a binary string has an odd value after left-cyclic rotation.\n    An odd value is determined by the last character being '1'.\n    \"\"\"\n    n = len(s)\n    \n    # If k is 0, no rotations are performed, so the count of odd rotations is 0.\n    # The problem constraints imply valid and non-empty input strings for s.\n    if k == 0:\n        return 0\n\n    odd_count = 0\n    \n    for i in range(k):\n        # Calculate the effective left-cyclic rotation offset for the current iteration.\n        # The design specifies \"rotation i is s rotated left by (i mod n) positions\".\n        rotation_offset = i % n\n        \n        # To determine if the rotated string is 'odd' (its last character is '1'),\n        # we directly find which character from the original string `s` ends up\n        # at the last position (index n-1) after a left rotation by `rotation_offset`.\n        # A character originally at index `j` moves to `(j - rotation_offset + n) % n`.\n        # If we want the character at index `n-1` in the rotated string,\n        # its original index `j` would be `(n-1 + rotation_offset) % n`.\n        # However, a left shift by `rotation_offset` moves element `s[j]` to `s_rotated[(j - rotation_offset + n) % n]`.\n        # We need `s_rotated[n-1]`.\n        # This element was originally at index `(n-1 + rotation_offset) % n` if we consider right shifts,\n        # but for left shifts, it's `(rotation_offset - 1 + n) % n`.\n        last_char_of_rotated_string = s[(rotation_offset - 1 + n) % n]\n        \n        if last_char_of_rotated_string == '1':\n            odd_count += 1\n            \n    return odd_count"}
{"task_id": "Mbpp/116", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass TupleInput:\n    \"\"\"Domain class to hold the input tuple.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n    def length(self) -> int:\n        return len(self.elements)\n\nclass IntegerOutput:\n    \"\"\"Domain class to represent the integer conversion result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates that an object is a tuple and its elements are positive integers.\"\"\"\n    def validate_is_tuple(self, obj) -> bool:\n        if not isinstance(obj, tuple):\n            raise ValidationError(\"Input must be a tuple\")\n        return True\n    def validate_elements_positive_integers(self, t: TupleInput) -> bool:\n        for idx, el in enumerate(t.elements):\n            if not isinstance(el, int):\n                raise ValidationError(f\"Element at index {idx} is not an int\")\n            if el <= 0:\n                raise ValidationError(f\"Element at index {idx} is not a positive integer\")\n        return True\n\nclass Converter:\n    \"\"\"Converts a validated TupleInput into an integer by concatenating its decimal representations.\"\"\"\n    def tuple_to_int(self, t: TupleInput) -> int:\n        concatenated = \"\".join(str(el) for el in t.elements)\n        return int(concatenated)\n\ndef tuple_to_int(t):\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their decimal representations.\n    Raises ValueError for invalid input types or non-positive integer elements.\n    \"\"\"\n    validator = Validator()\n    try:\n        validator.validate_is_tuple(t)\n    except ValidationError as e:\n        raise ValueError(e.message)\n\n    tuple_input = TupleInput(elements=t)\n\n    try:\n        validator.validate_elements_positive_integers(tuple_input)\n    except ValidationError as e:\n        raise ValueError(e.message)\n\n    converter = Converter()\n    result_int = converter.tuple_to_int(tuple_input)\n    return result_int"}
{"task_id": "Mbpp/118", "solution": "def string_to_list(input: str) -> list[str]:\n    \"\"\"Converts a string to a list of strings by splitting on the space character.\n\n    The input string is split by the single space character (' ') into a list of substrings.\n    \"\"\"\n    return input.split(' ')"}
{"task_id": "Mbpp/119", "solution": "def search(nums):\n    \"\"\"Accepts a sorted list nums and returns the element that appears only once.\n    Precondition: nums is sorted and exactly one element appears once while every other element appears exactly twice.\"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure mid always points to an even index.\n        # This way, we consistently check a pair starting at an even index.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If nums[mid] and nums[mid+1] are a pair, the unique element is to their right.\n        if nums[mid] == nums[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is at nums[mid] or to its left.\n        else:\n            high = mid\n            \n    # When the loop terminates, low == high, and nums[low] is the unique element.\n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union, Optional\n\nclass TuplePair:\n    \"\"\"Encapsulates a 2-element numeric pair and computes its absolute product.\n    Validates input type and shape during initialization.\"\"\"\n    def __init__(self, pair: Tuple[Union[int, float], Union[int, float]]):\n        if not (isinstance(pair, tuple) and len(pair) == 2):\n            raise TypeError(\"Each item must be a 2-element tuple.\")\n        \n        element1, element2 = pair\n        if not (isinstance(element1, (int, float)) and isinstance(element2, (int, float))):\n            raise TypeError(\"Tuple elements must be numeric (int or float).\")\n            \n        self._element1 = element1\n        self._element2 = element2\n\n    def abs_product(self) -> Union[int, float]:\n        \"\"\"Returns the absolute product of the encapsulated elements.\"\"\"\n        return abs(self._element1 * self._element2)\n\nclass ProductResult:\n    \"\"\"A simple container for a numeric maximum value.\"\"\"\n    def __init__(self, max_value: Union[int, float]) -> None:\n        self.max_value = max_value\n\ndef max_product_tuple(list_of_tuples: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not list_of_tuples:\n        raise ValueError(\"Input list_of_tuples cannot be empty.\")\n\n    max_abs_product: Optional[Union[int, float]] = None\n\n    for item in list_of_tuples:\n        # TuplePair.__init__ handles validation and raises TypeError for invalid items.\n        tp = TuplePair(item)\n        current_abs_product = tp.abs_product()\n\n        if max_abs_product is None or current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n            \n    # As per design, ProductResult is an internal container; the function returns the raw numeric value.\n    return max_abs_product"}
