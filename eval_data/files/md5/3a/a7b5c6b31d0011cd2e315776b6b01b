{"task_id": "Mbpp/397", "solution": "class NumberInput:\n    \"\"\"Lightweight value holder for a numeric input; normalizes numeric types to float.\"\"\"\n    def __init__(self, value):\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"Input must be a numeric type (int or float).\")\n        self._value = float(value)\n\n    @property\n    def value(self) -> float:\n        return self._value\n\nclass MedianFunction:\n    \"\"\"Encapsulates median computation logic operating on three NumberInput instances.\"\"\"\n    def __init__(self, a: NumberInput, b: NumberInput, c: NumberInput):\n        self._inputs = [a, b, c]\n\n    def computeMedian(self) -> float:\n        \"\"\"Compute the median of the three NumberInput values.\"\"\"\n        values = sorted([ni.value for ni in self._inputs])\n        return values[1]\n\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Computes the median of three numeric values.\n    Accepts int or float and returns the median as a float.\n    \"\"\"\n    na = NumberInput(a)\n    nb = NumberInput(b)\n    nc = NumberInput(c)\n    mf = MedianFunction(na, nb, nc)\n    value = mf.computeMedian()\n    return float(value)"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef _digits_of(n: int) -> List[int]:\n    \"\"\"Return the list of base-10 digits of integer n.\n    This helper treats negative numbers as their absolute value for digit extraction.\"\"\"\n    s = str(abs(n))\n    return [int(digit) for digit in s]\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Compute the total sum of base-10 digits across all integers in the given list.\"\"\"\n    total_sum_all_digits = 0\n    for num in numbers:\n        total_sum_all_digits += sum(_digits_of(num))\n    return total_sum_all_digits"}
