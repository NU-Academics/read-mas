{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple, Any\n\ndef max_length(input_list: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple (maximum_length, selected_sublist), choosing the first encountered sublist in case of ties. Raises ValueError if `input_list` is empty.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_len = len(input_list[0])\n    selected_sublist = input_list[0]\n\n    for sublist in input_list[1:]:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            selected_sublist = sublist\n            \n    return (max_len, selected_sublist)"}
{"task_id": "Mbpp/287", "solution": "def _generate_even_sequence(n: int) -> list[int]:\n    \"\"\"Generates a list of the first n even natural numbers.\"\"\"\n    return [2 * i for i in range(1, n + 1)]\n\ndef _sum_of_squares(seq: list[int]) -> int:\n    \"\"\"Calculates the sum of squares for a given sequence of integers.\"\"\"\n    return sum(x * x for x in seq)\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    The sequence of numbers considered is 2, 4, ..., 2n.\n    \"\"\"\n    even_sequence = _generate_even_sequence(n)\n    result = _sum_of_squares(even_sequence)\n    return result"}
{"task_id": "Mbpp/292", "solution": "from math import floor\n\ndef validate_inputs(dividend, divisor) -> None:\n    \"\"\"Validates that inputs are numeric and divisor is not zero.\"\"\"\n    if not isinstance(dividend, (int, float)) or not isinstance(divisor, (int, float)):\n        raise TypeError(\"dividend and divisor must be numeric\")\n    if divisor == 0:\n        raise ZeroDivisionError(\"division by zero\")\n\ndef compute_floor(dividend, divisor) -> int:\n    \"\"\"Computes the floor of the division of two numbers.\"\"\"\n    return int(floor(dividend / divisor))\n\ndef find(dividend, divisor) -> int:\n    \"\"\"\n    Finds the quotient of two numbers, rounded down to the nearest integer (floor).\n    Handles input validation for numeric types and division by zero.\n    \"\"\"\n    validate_inputs(dividend, divisor)\n    return compute_floor(dividend, divisor)"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the array formed by repeating arr, k times.\n    Handles input validation and uses Kadane's algorithm with optimizations for k repetitions.\n    \"\"\"\n    \n    def _validate_inputs(arr, n, k):\n        \"\"\"Validates inputs arr, n, and k, raising ValueError for invalid cases.\"\"\"\n        if not isinstance(arr, list):\n            raise ValueError(\"validation error: arr must be a list\")\n        if not all(isinstance(x, int) for x in arr):\n            raise ValueError(\"validation error: all elements in arr must be integers\")\n        if not isinstance(n, int):\n            raise ValueError(\"validation error: n must be an integer\")\n        if not isinstance(k, int):\n            raise ValueError(\"validation error: k must be an integer\")\n        if len(arr) != n:\n            raise ValueError(\"validation error: n must be equal to len(arr)\")\n        if k <= 0:\n            raise ValueError(\"validation error: k must be greater than 0\")\n\n    def _kadane_on_iterable(iterable):\n        \"\"\"Applies Kadane's algorithm to find the maximum contiguous subarray sum in an iterable.\"\"\"\n        max_so_far = float('-inf')\n        current_max = 0\n        has_positive = False\n\n        for x in iterable:\n            if x >= 0:\n                has_positive = True\n            current_max += x\n            if current_max > max_so_far:\n                max_so_far = current_max\n            if current_max < 0:\n                current_max = 0\n        \n        # If all numbers are negative, Kadane's above returns 0. Correct by finding the largest single element.\n        if not has_positive and max_so_far == 0:\n            if not arr: # Handle empty array case for _kadane_on_iterable\n                return 0\n            return max(arr)\n        \n        # This handles cases where all elements are negative and max_so_far was only updated by negative numbers,\n        # but current_max reset to 0. If current_max never went above 0, and all numbers are negative,\n        # we need to return the largest single element.\n        # Example: [-2, -3, -1]. max_so_far would be -1, current_max would be 0 at the end.\n        # This check implies that if max_so_far is 0 (meaning no positive segment was found to push it above 0)\n        # and there are actual elements, it should be the max element if all are negative.\n        # However, the loop logic for max_so_far = current_max (if current_max > max_so_far) already correctly\n        # tracks the largest single negative if all are negative, as current_max will become that largest negative value\n        # before resetting to 0. The float('-inf') initialization is critical.\n        # For an array like [-2, -3, -1], max_so_far would be -1.\n        # For an array like [-2, 1, -3], max_so_far would be 1.\n        # The 'has_positive' logic for all-negatives needs to be more robust.\n        # The standard Kadane handles all negatives by ensuring max_so_far is updated.\n        # Let's simplify and rely on standard Kadane behavior directly without 'has_positive' check\n        # as float('-inf') handles it.\n        # If max_so_far is still float('-inf'), it means the iterable was empty, or only had non-numbers.\n        # Given 'arr' is validated as int list, it's ok.\n        \n        # Re-think if max_so_far can be 0 when all elements are negative.\n        # E.g., arr = [-1, -2, -3]. max_so_far = -1 (at x=-1), then current_max becomes -1.\n        # Then x=-2, current_max becomes -3. max_so_far is -1.\n        # Then x=-3, current_max becomes -6. max_so_far is -1.\n        # current_max resets to 0.\n        # Result should be -1.\n        # The logic `if current_max < 0: current_max = 0` handles resetting for _positive_ segments.\n        # If all numbers are negative, current_max will just keep decreasing or reset to 0.\n        # The key is to initialize `max_so_far` to the smallest possible value (or first element).\n\n        # Revised Kadane:\n        if not iterable:\n            return 0 # Or raise error, depending on requirements for empty input\n\n        # Standard Kadane handles all-negative cases by ensuring max_so_far holds the largest negative number.\n        max_so_far_val = float('-inf')\n        current_max_val = 0\n        found_any_value = False\n\n        for x in iterable:\n            found_any_value = True\n            current_max_val += x\n            max_so_far_val = max(max_so_far_val, current_max_val) # Update max_so_far_val\n            if current_max_val < 0:\n                current_max_val = 0 # Reset current_max_val if it becomes negative\n\n        # This case is when all numbers are negative, and current_max_val always reset to 0,\n        # leading to max_so_far_val being stuck at initial float('-inf') IF no positive numbers.\n        # e.g., arr = [-1, -2, -3].\n        # x = -1: current = -1, max_so_far = -1, current becomes 0\n        # x = -2: current = -2, max_so_far = max(-1, -2) = -1, current becomes 0\n        # x = -3: current = -3, max_so_far = max(-1, -3) = -1, current becomes 0\n        # Correct! The standard Kadane logic works even for all negative numbers.\n        # It finds the largest single element if all are negative.\n        \n        if not found_any_value: # Should only happen if input iterable is empty\n            return 0 # Or some other default\n\n        return max_so_far_val if max_so_far_val != float('-inf') else 0\n\n    def _compute_max_sum_for_repeated(arr, n, k):\n        \"\"\"Computes the max subarray sum for repeated array, optimizing for k.\"\"\"\n        max_one = _kadane_on_iterable(arr)\n\n        if k == 1:\n            return max_one\n\n        # For k >= 2, we need to consider subarrays that span the boundary.\n        # This is covered by considering arr + arr.\n        max_two = _kadane_on_iterable(arr + arr)\n        \n        total_sum = sum(arr)\n\n        if total_sum > 0 and k > 2:\n            # If the total sum of the original array is positive, and k is large enough,\n            # we can potentially include (k-2) full copies of the array in the middle\n            # along with the best possible head and tail segments, which is max_one.\n            # max_two already captures the best sum from two concatenated copies, which\n            # can be either entirely within the first copy, entirely within the second,\n            # or spanning the boundary.\n            # The logic should be: max_two covers 2 copies. If total_sum is positive,\n            # for k > 2, we can extend the max_one segment by (k-2) * total_sum.\n            # Compare max_two with max_one + (k-2)*total_sum.\n            # This is subtly incorrect. max_one is the best within _one_ copy.\n            # We want the best segment that includes the first array, plus (k-2) total sums,\n            # plus the best segment that includes the last array.\n            # But max_two already considers all possibilities within arr+arr.\n            # A segment can:\n            # 1. Be entirely within the first arr (max_one candidate).\n            # 2. Be entirely within the second arr (max_one candidate).\n            # 3. Span the boundary between the first and second arr (captured by max_two).\n            # If total_sum > 0 and k > 2, the optimal solution might be:\n            # (best suffix of first arr) + (k-2)*total_sum + (best prefix of last arr).\n            # This sum would be a candidate.\n            # However, the simpler logic, per the design notes, is:\n            # `return max(max_two, max_one + (k - 2) * total_sum)`\n            # This might be simplified.\n            #\n            # Let's re-evaluate the design's `max(max_two, max_one + (k - 2) * total_sum)` logic.\n            # `max_one` represents the maximum subarray sum within a *single* copy.\n            # `max_two` represents the maximum subarray sum within *two* concatenated copies (arr + arr).\n            # If `total_sum` > 0 and `k > 2`, we can have the `max_two` case (spanning up to 2 copies)\n            # OR we can have a case where we take the maximum subarray sum of the first copy (`max_one`),\n            # and then extend it by taking `(k-1)` full repetitions of `total_sum`, but this\n            # assumes `max_one` can be extended with full arrays. This is wrong.\n            #\n            # The common understanding for this problem (and implied by the design) is:\n            # Candidate 1: Max subarray sum entirely within two copies (handled by `max_two`).\n            # Candidate 2: If `total_sum` > 0, we can take `(k-2)` full `total_sum`s,\n            #              and add them to the sum of the best suffix of the first array and\n            #              the best prefix of the last array.\n            # To get this, we need:\n            #  - `max_prefix_sum`: maximum sum of any prefix of `arr`.\n            #  - `max_suffix_sum`: maximum sum of any suffix of `arr`.\n            # A candidate sum for `k > 2` and `total_sum > 0` would be `max_suffix_sum + (k-2)*total_sum + max_prefix_sum`.\n            # The `max_two` already computes the max of `arr+arr`. If `total_sum` is positive,\n            # it means segments that span across multiple full `arr` blocks would likely gain from having `total_sum` added.\n            # `max_two` will compute `max(max_one, best_across_boundary_of_two_arrs)`.\n            # The best `best_across_boundary_of_two_arrs` is `max_suffix_sum(arr) + max_prefix_sum(arr)`.\n            #\n            # Let's follow the design text EXACTLY: `return max(max_two, max_one + (k - 2) * total_sum)`\n            # This simplification suggests that the longest possible positive segment is either within two `arr`s\n            # or it's `max_one` (from a single arr) extended by `(k-2)` full `total_sum`s.\n            # This particular formula implies that `max_one` can be meaningfully extended by full `total_sum` blocks.\n            # This might be valid if `max_one` could be the *entire* array `arr` and `total_sum` is also positive.\n            #\n            # Let's stick to the design as written for the `_compute_max_sum_for_repeated` function.\n            # It's a specific simplification:\n            return max(max_two, max_one + (k - 2) * total_sum)\n        else:\n            # If total_sum is not positive, or k is not > 2, then we don't benefit from extra blocks.\n            # So the max sum is simply within the two-copy array.\n            return max_two\n\n    _validate_inputs(arr, n, k)\n    return _compute_max_sum_for_repeated(arr, n, k)"}
{"task_id": "Mbpp/294", "solution": "def max_val(lst):\n    \"\"\"Return maximum numeric value (int or float) from input list; ignore non-numeric elements. Returns None if no numeric elements present.\"\"\"\n    max_numeric_value = None\n    for item in lst:\n        if isinstance(item, (int, float)):\n            if max_numeric_value is None or item > max_numeric_value:\n                max_numeric_value = item\n    return max_numeric_value"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-sort based approach.\n    An inversion is a pair of indices (i, j) such that i < j and array[i] > array[j].\n    \"\"\"\n    if not arr:\n        return 0\n    _, count = _merge_sort_and_count(arr)\n    return count\n\ndef _merge_sort_and_count(arr: list) -> tuple[list, int]:\n    \"\"\"\n    Recursively sorts the array and counts inversions.\n    Returns a tuple containing the sorted array and its inversion count.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return arr, 0\n\n    mid = n // 2\n    left_half, left_inv_count = _merge_sort_and_count(arr[:mid])\n    right_half, right_inv_count = _merge_sort_and_count(arr[mid:])\n\n    merged_arr, split_inv_count = _merge_and_count_split_inv(left_half, right_half)\n\n    total_inv_count = left_inv_count + right_inv_count + split_inv_count\n    return merged_arr, total_inv_count\n\ndef _merge_and_count_split_inv(left_arr: list, right_arr: list) -> tuple[list, int]:\n    \"\"\"\n    Merges two sorted arrays and counts split inversions between them.\n    Returns a tuple containing the merged sorted array and the count of split inversions.\n    \"\"\"\n    merged = []\n    i, j = 0, 0\n    split_inv_count = 0\n    n_left = len(left_arr)\n\n    while i < n_left and j < len(right_arr):\n        if left_arr[i] <= right_arr[j]:\n            merged.append(left_arr[i])\n            i += 1\n        else:\n            # All remaining elements in left_arr (from i onwards) are greater than right_arr[j].\n            merged.append(right_arr[j])\n            split_inv_count += (n_left - i)\n            j += 1\n\n    merged.extend(left_arr[i:])\n    merged.extend(right_arr[j:])\n\n    return merged, split_inv_count"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a, b):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given two sides.\n    Assumes positive numeric inputs as per problem context.\n    \"\"\"\n    return math.sqrt(a**2 + b**2)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nestedList):\n    \"\"\"\n    Flattens a given nested list structure into a single, flat list.\n    Elements are processed in left-to-right, depth-first order.\n    \"\"\"\n    flat_list = []\n    for element in nestedList:\n        if isinstance(element, list):\n            flat_list.extend(flatten_list(element))\n        else:\n            flat_list.append(element)\n    return flat_list"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of dictionaries within a dictionary.\n    An empty dictionary has a depth of 1.\n    \"\"\"\n    if not d:\n        return 1\n\n    max_child_depth = 0\n    for value in d.values():\n        if isinstance(value, dict):\n            max_child_depth = max(max_child_depth, dict_depth(value))\n\n    return 1 + max_child_depth"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"Return the greater of two numeric inputs (int or float). Raise TypeError for non-numeric inputs.\"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(\"Parameter 'a' must be int or float\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(\"Parameter 'b' must be int or float\")\n    return a if a >= b else b"}
{"task_id": "Mbpp/299", "solution": "import math\nfrom typing import Iterable, Tuple, Union, Dict, Optional\nfrom dataclasses import dataclass\n\n@dataclass\nclass Entry:\n    name: str\n    value: float\n    index: int\n\n@dataclass\nclass AggregationResult:\n    name: str\n    total: float\n\nclass Aggregator:\n    \"\"\"\n    Encapsulates validation, aggregation, and selection business logic for aggregate calculations.\n    \"\"\"\n    def validate(self, entries: Iterable[object]) -> None:\n        \"\"\"\n        Validates that each item in the input is a 2-element tuple with a string name and numeric value.\n        Raises ValueError if any item is invalid.\n        \"\"\"\n        for i, item in enumerate(entries):\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(\"Invalid input: entries must be iterable of 2-element tuples (str, number)\")\n            name, value = item\n            if not isinstance(name, str):\n                raise ValueError(\"Invalid input: entries must be iterable of 2-element tuples (str, number)\")\n            if not isinstance(value, (int, float)):\n                raise ValueError(\"Invalid input: entries must be iterable of 2-element tuples (str, number)\")\n\n    def aggregate(self, entries: Iterable[Tuple[str, Union[int, float]]]) -> Tuple[Dict[str, float], Dict[str, int]]:\n        \"\"\"\n        Aggregates numeric values by name and tracks the first occurrence index for tie-breaking.\n        \"\"\"\n        aggregates: Dict[str, float] = {}\n        first_occurrence: Dict[str, int] = {}\n\n        for i, (name, value) in enumerate(entries):\n            if name not in aggregates:\n                aggregates[name] = 0.0\n                first_occurrence[name] = i\n            aggregates[name] += float(value)\n        return aggregates, first_occurrence\n\n    def select_max(self, aggregates: Dict[str, float], first_occurrence: Dict[str, int]) -> Optional[AggregationResult]:\n        \"\"\"\n        Selects the name with the highest aggregate total, using first occurrence for tie-breaking.\n        Returns None if the aggregates dictionary is empty.\n        \"\"\"\n        if not aggregates:\n            return None\n\n        max_name: Optional[str] = None\n        max_total: float = -math.inf\n        min_first_index: int = math.inf\n\n        for name, total in aggregates.items():\n            current_first_index = first_occurrence[name]\n\n            if total > max_total:\n                max_total = total\n                max_name = name\n                min_first_index = current_first_index\n            elif total == max_total:\n                if current_first_index < min_first_index:\n                    max_name = name\n                    min_first_index = current_first_index\n        \n        if max_name is None: # Should not happen if aggregates is not empty, but for typing.\n            return None\n            \n        return AggregationResult(name=max_name, total=max_total)\n\ndef max_aggregate(entries: Iterable[Tuple[str, Union[int, float]]]) -> Optional[Tuple[str, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of tuples (name, value).\n    Returns a tuple (name, total) or None if input is empty or no valid aggregates.\n    Raises ValueError for invalid input items.\n    \"\"\"\n    aggregator = Aggregator()\n\n    # Check for empty input before validation to return None as per design\n    if not entries:\n        return None\n\n    # Validate all entries first\n    # Convert to a list to allow multiple iterations (validation, then aggregation)\n    # and to handle potential empty input after validation (e.g., all entries filtered out)\n    entries_list = list(entries) \n    \n    # If the input was an empty iterable, entries_list will be empty\n    if not entries_list: \n        return None\n\n    aggregator.validate(entries_list)\n    \n    # After validation, proceed with aggregation and selection\n    aggregates, first_occurrence = aggregator.aggregate(entries_list)\n    result = aggregator.select_max(aggregates, first_occurrence)\n\n    if result is None:\n        return None\n    else:\n        return (result.name, result.total)"}
{"task_id": "Mbpp/306", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass DPEntry:\n    index: int\n    max_sum_ending_here: int\n\ndef _validate_inputs(arr: List[int], n: int, i: int, k: int) -> None:\n    \"\"\"Validates the input parameters for the max_sum_increasing_subseq function.\"\"\"\n    if n != len(arr):\n        raise ValueError(f\"n ({n}) must be equal to len(arr) ({len(arr)})\")\n    if not (0 <= i < n):\n        raise ValueError(f\"i ({i}) must be within the range [0, n-1] (n={n})\")\n    if not (0 <= k < n):\n        raise ValueError(f\"k ({k}) must be within the range [0, n-1] (n={n})\")\n    if k <= i:\n        raise ValueError(f\"k ({k}) must be strictly greater than i ({i})\")\n\ndef _compute_dp_prefix(arr: List[int], i: int) -> List[DPEntry]:\n    \"\"\"Computes the maximum sum of increasing subsequences ending at each index up to i.\"\"\"\n    dp_entries: List[DPEntry] = []\n    for j in range(i + 1):\n        current_max_sum = arr[j] # Initialize with the element itself\n        for p in range(j):\n            if arr[p] < arr[j]:\n                current_max_sum = max(current_max_sum, dp_entries[p].max_sum_ending_here + arr[j])\n        dp_entries.append(DPEntry(index=j, max_sum_ending_here=current_max_sum))\n    return dp_entries\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element which is after i.\n    \"\"\"\n    _validate_inputs(arr, n, i, k)\n\n    dp_entries = _compute_dp_prefix(arr, i)\n\n    max_total_sum = arr[k] # Initialize with arr[k] itself to handle cases where no prefix element is smaller than arr[k].\n    \n    for entry in dp_entries:\n        if arr[entry.index] < arr[k]:\n            candidate_sum = entry.max_sum_ending_here + arr[k]\n            max_total_sum = max(max_total_sum, candidate_sum)\n            \n    return max_total_sum"}
{"task_id": "Mbpp/305", "solution": "from .domain import InputList, Word\nfrom .parser import Parser\n\ndef start_withp(lines: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns the first two words from a list of strings that start with 'p' (case-insensitive).\n    Raises TypeError for invalid input or ValueError if fewer than two matches are found.\n    \"\"\"\n    input_list = InputList(lines)\n    input_list.validate()\n\n    parser = Parser()\n    words = parser.parse(input_list.lines)\n\n    matches = [w.text for w in words if w.starts_with_p()]\n\n    if len(matches) < 2:\n        raise ValueError(\"insufficient matches: fewer than two words starting with 'p'\")\n\n    return (matches[0], matches[1])"}
{"task_id": "Mbpp/300", "solution": "import math\n\nclass InvalidInputError(Exception):\n    \"\"\"Deterministic exception to signal invalid inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputParameter:\n    \"\"\"Encapsulate input validation logic for parameter n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if n is an integer.\"\"\"\n        return isinstance(self.n, int)\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if n is non-negative.\"\"\"\n        return self.n >= 0\n\n    def validate(self) -> None:\n        \"\"\"Validates n; raises InvalidInputError on failure.\"\"\"\n        if not self.is_integer():\n            raise InvalidInputError(f\"Input n must be an integer, but got {type(self.n).__name__}.\")\n        if not self.is_non_negative():\n            raise InvalidInputError(f\"Input n must be non-negative, but got {self.n}.\")\n\nclass CombinatoricsCalculator:\n    \"\"\"Provides exact combinatorial routines.\"\"\"\n    @staticmethod\n    def binomial(n: int, k: int) -> int:\n        \"\"\"Computes the binomial coefficient C(n, k) using a multiplicative formula.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    @staticmethod\n    def c_2n_n(n: int) -> int:\n        \"\"\"Computes C(2n, n), the central binomial coefficient.\"\"\"\n        return CombinatoricsCalculator.binomial(2 * n, n)\n\n    @staticmethod\n    def sum_of_squares(n: int) -> int:\n        \"\"\"Computes sum_{k=0..n} C(n,k)^2.\"\"\"\n        total = 0\n        for k in range(n + 1):\n            term = CombinatoricsCalculator.binomial(n, k)\n            total += term * term\n        return total\n\nclass ComputationResult:\n    \"\"\"Wraps computed integer result and provides as_numeric().\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def as_numeric(self) -> int:\n        \"\"\"Returns the stored integer value.\"\"\"\n        return self.value\n\ndef validate_n(n) -> None:\n    \"\"\"Adapter to InputParameter.validate(); raises InvalidInputError on invalid.\"\"\"\n    InputParameter(n).validate()\n\ndef count_binary_seq(n) -> int:\n    \"\"\"\n    Counts binary sequences of length 2n where sum of first n bits equals sum of last n bits.\n    This count is equal to the central binomial coefficient C(2n, n).\n    \"\"\"\n    validate_n(n)\n    count = CombinatoricsCalculator.c_2n_n(int(n))\n    return ComputationResult(count).as_numeric()"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, k):\n    \"\"\"Public API per SRS: compute and return top-k products (descending).\"\"\"\n    if k <= 0 or not list1 or not list2:\n        return []\n\n    def _generate_pairwise_products(list1, list2):\n        \"\"\"Return list of all pairwise products (duplicates preserved).\"\"\"\n        all_products = []\n        for x in list1:\n            for y in list2:\n                all_products.append(x * y)\n        return all_products\n\n    def _select_top_k(products, k):\n        \"\"\"Sort products descending and return top k (or all if k > len(products)).\"\"\"\n        products.sort(reverse=True)\n        return products[:k]\n\n    products = _generate_pairwise_products(list1, list2)\n    return _select_top_k(products, k)"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of characters, excluding spaces.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n\n    # Filter out space characters and collect the rest\n    filtered_chars = [char for char in s if char != ' ']\n    return tuple(filtered_chars)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Return largest power of two less than or equal to n.\n\n    Precondition: n is an integer and n >= 1 (per SRS FR4).\n    \"\"\"\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Locates the highest-order zero bit (left-most unset bit) up to and including\n    the most significant bit of n, sets that bit to 1, and returns the result.\n    If all bits up to the MSB are set, the bit immediately to the left of the MSB is set.\n    \"\"\"\n    bit_length = n.bit_length()\n\n    # Iterate from MSB position down to 0\n    for i in range(bit_length - 1, -1, -1):\n        # Check if the i-th bit is unset (0)\n        if (n >> i) & 1 == 0:\n            # If unset, set it and return the new number\n            return n | (1 << i)\n\n    # If the loop finishes, all bits up to bit_length-1 were set (e.g., n=7 -> 0b111).\n    # Or, if n was 0, bit_length is 0.\n    # In this case, set the bit immediately to the left of the current 'MSB' position.\n    # This correctly handles n=0 (sets bit 0) and numbers like 7 (0b111) to 8 (0b1000).\n    return n | (1 << bit_length)"}
{"task_id": "Mbpp/390", "solution": "def add_string(input_list, format_string):\n    \"\"\"Return a new list where each element is format_string with '{0}' replaced by str(element) for each element in input_list.\n\n    Parameters:\n    - input_list: list\n    - format_string: str\n\n    Returns:\n    - list\n    \"\"\"\n    return [format_string.replace('{0}', str(element)) for element in input_list]"}
{"task_id": "Mbpp/312", "solution": "import math\nfrom typing import Optional\n\nclass Cone:\n    \"\"\"Domain data holder for cone parameters and computed volume.\"\"\"\n    def __init__(self, radius: float, height: float):\n        self.radius: float = float(radius)\n        self.height: float = float(height)\n        self.volume: Optional[float] = None\n\nclass MathLibrary:\n    \"\"\"Provides math.pi value consistently.\"\"\"\n    pi: float = math.pi\n\nclass InputValidator:\n    \"\"\"Validates input values.\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Checks if a value is numeric (int or float).\"\"\"\n        return isinstance(value, (int, float))\n\n    def isNonNegative(self, value) -> bool:\n        \"\"\"Checks if a value is numeric and non-negative.\"\"\"\n        return self.isNumeric(value) and value >= 0\n\nclass VolumeCalculator:\n    \"\"\"Computes cone volume.\"\"\"\n    def calculateVolume(self, cone: Cone) -> float:\n        \"\"\"Calculates the volume of a given Cone object.\"\"\"\n        volume = (1.0 / 3.0) * MathLibrary.pi * (cone.radius ** 2) * cone.height\n        cone.volume = volume\n        return volume\n\ndef volume_cone(radius, height) -> float:\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    Raises TypeError if radius or height are not numeric.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isNumeric(radius) or not validator.isNumeric(height):\n        raise TypeError(\"radius and height must be numeric\")\n\n    cone = Cone(radius, height)\n    calculator = VolumeCalculator()\n    return calculator.calculateVolume(cone)"}
{"task_id": "Mbpp/389", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n\nclass InputValidator:\n    \"\"\"Validates input for Lucas number computation.\"\"\"\n    def validate(self, n) -> None:\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(\"n must be a non-negative integer\")\n\n\nclass LucasSequence:\n    \"\"\"Computes Lucas numbers.\"\"\"\n    L0: int = 2\n    L1: int = 1\n\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return self.L0\n        if n == 1:\n            return self.L1\n\n        # Compute iteratively for n >= 2\n        l_prev_prev = self.L0\n        l_prev = self.L1\n        for _ in range(2, n + 1):\n            l_current = l_prev_prev + l_prev\n            l_prev_prev = l_prev\n            l_prev = l_current\n        return l_prev\n\n\ndef find_lucas(n) -> int:\n    \"\"\"\n    Finds the n'th Lucas number.\n    Validates input and computes the Lucas number iteratively using helper classes.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n\n    seq = LucasSequence()\n    result = seq.compute(n)\n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses memoization to optimize recursive calls.\n    \"\"\"\n    def _validate_input(val):\n        if not isinstance(val, int) or val < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _get_floor_values(val):\n        return (val // 2, val // 3, val // 4, val // 5)\n\n    class RecursiveComputation:\n        @staticmethod\n        def compute(val, memo):\n            if val in memo:\n                return memo[val]\n\n            if val == 0:\n                memo[0] = 0\n                return 0\n\n            v2, v3, v4, v5 = _get_floor_values(val)\n            sum_sub = (RecursiveComputation.compute(v2, memo) +\n                       RecursiveComputation.compute(v3, memo) +\n                       RecursiveComputation.compute(v4, memo) +\n                       RecursiveComputation.compute(v5, memo))\n            \n            result = max(sum_sub, val)\n            memo[val] = result\n            return result\n\n    _validate_input(n)\n    memo: dict[int, int] = {}\n    return RecursiveComputation.compute(n, memo)"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Dict, Any\n\ndef convert_list_dictionary(keys_list: List[Any], names_list: List[Any], values_list: List[Any]) -> List[Dict[Any, Dict[Any, Any]]]:\n    \"\"\"Converts three parallel lists into a list of nested dictionaries.\n\n    Raises ValueError if the three lists are not the same length.\n    Does not modify input lists.\n    \"\"\"\n    n_keys = len(keys_list)\n    n_names = len(names_list)\n    n_values = len(values_list)\n\n    if not (n_keys == n_names == n_values):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result_list: List[Dict[Any, Dict[Any, Any]]] = []\n    for i in range(n_keys):\n        # Create a new dict for each entry: { keys_list[i]: { names_list[i]: values_list[i] } }\n        nested_item = {keys_list[i]: {names_list[i]: values_list[i]}}\n        result_list.append(nested_item)\n\n    return result_list"}
{"task_id": "Mbpp/394", "solution": "class DistinctChecker:\n    \"\"\"Encapsulates the duplicate-detection algorithm.\"\"\"\n    def check_distinct(self, t: tuple) -> bool:\n        \"\"\"Return True if tuple t has all elements unique by value equality; True for empty tuple.\"\"\"\n        # Comparing lengths of the tuple and its set representation efficiently checks for distinctness.\n        return len(t) == len(set(t))\n\ndef check_distinct(t: tuple) -> bool:\n    \"\"\"Return True if t contains no duplicate elements (value equality); False otherwise.\"\"\"\n    checker = DistinctChecker()\n    return checker.check_distinct(t)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict\nfrom collections import Counter\n\ndef _compute_counts(s: str) -> Dict[str, int]:\n    \"\"\"\n    Computes the frequency count of each character in the given string.\n    \"\"\"\n    return Counter(s)\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a string, returning None if none exist.\n    The search is performed from left-to-right in the original string order.\n    \"\"\"\n    counts = _compute_counts(s)\n    for char in s:\n        if counts[char] == 1:\n            return char\n    return None"}
