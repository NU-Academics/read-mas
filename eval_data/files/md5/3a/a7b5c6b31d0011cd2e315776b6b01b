{"task_id": "Mbpp/234", "solution": "class NumericValue:\n    \"\"\"Encapsulates numeric validation and coercion.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the value is an int or float, and not a boolean.\"\"\"\n        return isinstance(self.value, (int, float)) and not isinstance(self.value, bool)\n\n    def as_float(self) -> float:\n        \"\"\"Coerces the value to float or raises TypeError.\"\"\"\n        if not self.is_numeric():\n            raise TypeError(\"Value must be numeric (int or float).\")\n        return float(self.value)\n\nclass Cube:\n    \"\"\"Encapsulates cube state and volume calculation.\"\"\"\n    def __init__(self, side_length: float):\n        self.side_length = side_length\n        self.volume: float = 0.0\n\n    def calculate_volume(self) -> float:\n        \"\"\"Computes side_length ** 3 and returns the volume.\"\"\"\n        self.volume = self.side_length ** 3\n        return self.volume\n\nclass VolumeFunction:\n    \"\"\"Models the function semantics and orchestrates validation and computation.\"\"\"\n    def __init__(self, name: str = 'volume_cube'):\n        self.name = name\n\n    def call(self, side_length) -> float:\n        \"\"\"Validates input, creates Cube, and returns computed volume.\"\"\"\n        numeric_val = NumericValue(side_length)\n        if not numeric_val.is_numeric():\n            raise TypeError(\"Side length must be a numeric value (int or float).\")\n        \n        s_float = numeric_val.as_float()\n        \n        cube = Cube(s_float)\n        return cube.calculate_volume()\n\ndef volume_cube(side_length):\n    \"\"\"Calculates the volume of a cube given its side length.\"\"\"\n    volume_func = VolumeFunction()\n    return volume_func.call(side_length)"}
{"task_id": "Mbpp/232", "solution": "import heapq\n\ndef _validate_bounds(n, input_list):\n    \"\"\"\n    Validates that n is an integer and within the valid range [0, len(input_list)].\n    Raises ValueError if validation fails.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if not (0 <= n <= len(input_list)):\n        raise ValueError(f\"n must be between 0 and {len(input_list)} (inclusive).\")\n\ndef _validate_comparable(items):\n    \"\"\"\n    Ensures items in the list are pairwise comparable by attempting a full comparison check.\n    Raises TypeError if items are not comparable.\n    \"\"\"\n    if len(items) <= 1:\n        return\n\n    # Attempt to find the maximum element to force pairwise comparisons\n    # This will raise TypeError if items are not consistently comparable\n    try:\n        max(items)\n    except TypeError as e:\n        raise TypeError(\"Items in the list are not pairwise comparable.\") from e\n\ndef _select_n_largest(input_list, n):\n    \"\"\"\n    Returns a list containing the n largest items from input_list.\n    Uses heapq.nlargest for efficient selection.\n    \"\"\"\n    return heapq.nlargest(n, input_list)\n\ndef larg_nnum(input_list, n):\n    \"\"\"\n    Returns a list containing the n largest items from the input list.\n    Validates inputs and selects the largest items.\n    \"\"\"\n    _validate_bounds(n, input_list)\n\n    if n > 0:\n        _validate_comparable(input_list)\n\n    return _select_n_largest(input_list, n)"}
{"task_id": "Mbpp/235", "solution": "class BitMask:\n    def __init__(self, upto_bit: int = None) -> None:\n        self.mask_value = 0\n        if upto_bit is not None:\n            self.generate_mask(upto_bit)\n\n    def generate_mask(self, upto_bit: int) -> int:\n        \"\"\"\n        Generates an integer mask with bits set at 1-indexed even positions up to upto_bit.\n        \"\"\"\n        current_mask = 0\n        # Iterate through 1-indexed even positions and set the corresponding 0-indexed bit.\n        for i in range(2, upto_bit + 1, 2):\n            current_mask |= (1 << (i - 1))\n        self.mask_value = current_mask\n        return current_mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-numbered bit positions (1-indexed: 2, 4, 6, ...) of the input number to 1.\n    \"\"\"\n    # Determine the maximum bit length needed for the mask, ensuring at least 1 for n=0.\n    upto_bit = max(1, n.bit_length())\n\n    # Create a BitMask instance and generate the mask up to the required bit length.\n    masker = BitMask()\n    mask = masker.generate_mask(upto_bit)\n\n    # Apply the generated mask to the input number using a bitwise OR.\n    return n | mask"}
{"task_id": "Mbpp/237", "solution": "def _normalize_tuple(t: tuple) -> tuple:\n    \"\"\"Returns normalized (ascending) 2-element tuple.\"\"\"\n    return (min(t[0], t[1]), max(t[0], t[1]))\n\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"Accepts list of 2-element tuples, returns dict with normalized tuple keys and integer counts.\"\"\"\n    counts = {}\n    for item_tuple in input_list:\n        normalized_tuple = _normalize_tuple(item_tuple)\n        counts[normalized_tuple] = counts.get(normalized_tuple, 0) + 1\n    return counts"}
