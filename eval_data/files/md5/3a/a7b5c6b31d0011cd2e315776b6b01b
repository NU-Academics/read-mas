{"task_id": "Mbpp/635", "solution": "def siftDown(arr, start, end):\n    \"\"\"\n    Restores the heap property by sifting the element at start down\n    to its appropriate position within the sub-heap arr[start:end+1].\n    \"\"\"\n    root = start\n    while True:\n        child = 2 * root + 1 # left child\n        if child > end:\n            break\n        \n        swap = root\n        if arr[swap] < arr[child]:\n            swap = child\n        \n        # Check right child if it exists and is larger\n        if child + 1 <= end and arr[swap] < arr[child + 1]:\n            swap = child + 1\n        \n        if swap == root:\n            # Element is in its correct place\n            break\n        else:\n            arr[root], arr[swap] = arr[swap], arr[root]\n            root = swap\n\ndef heapify(arr):\n    \"\"\"\n    Builds a max-heap from the given list arr using the siftDown operation.\n    \"\"\"\n    n = len(arr)\n    # Start from the last non-leaf node and sift down\n    for i in range(n // 2 - 1, -1, -1):\n        siftDown(arr, i, n - 1)\n\ndef sort(arr):\n    \"\"\"\n    Executes the heap sort algorithm on the list arr by\n    building a heap and repeatedly extracting the maximum element.\n    \"\"\"\n    n = len(arr)\n    heapify(arr) # Build a max-heap\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i] # Swap current root with last element\n        siftDown(arr, 0, i - 1) # Restore heap property on the reduced heap\n\ndef heap_sort(input_list):\n    \"\"\"\n    Sorts a list in ascending order using the heap sort algorithm.\n    It first validates input type, then sorts a copy of the list.\n    \"\"\"\n    if type(input_list) is not list:\n        raise TypeError(\"Input must be a list.\")\n\n    working_list = list(input_list) # Create a working copy to avoid modifying the original list\n    sort(working_list)\n    return working_list"}
{"task_id": "Mbpp/638", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Union\n\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\n@dataclass\nclass WindMeasurement:\n    \"\"\"Data Transfer Object for wind measurement inputs.\"\"\"\n    wind_kmh: float  # Wind velocity in km/h\n    temp_c: float    # Temperature in Celsius\n\n@dataclass\nclass WindChillResult:\n    \"\"\"Value object for the calculated wind chill index.\"\"\"\n    value: int       # Rounded wind chill index\n\nclass WindChillCalculator:\n    \"\"\"Orchestrates validation, computation, and rounding for wind chill.\"\"\"\n\n    def wind_chill(self, wind_kmh: Union[int, float], temp_c: Union[int, float]) -> int:\n        \"\"\"\n        Calculates the wind chill index, rounded up to the next integer.\n        Validates inputs and delegates to _compute_wind_chill_value.\n        \"\"\"\n        if not isinstance(wind_kmh, (int, float)):\n            raise ValidationError(\"Parameter 'wind_kmh' must be numeric.\")\n        if not isinstance(temp_c, (int, float)):\n            raise ValidationError(\"Parameter 'temp_c' must be numeric.\")\n\n        if wind_kmh < 0:\n            raise ValidationError(\"wind_kmh must be >= 0.\")\n\n        # Convert to float for internal consistency and computation\n        measurement = WindMeasurement(wind_kmh=float(wind_kmh), temp_c=float(temp_c))\n\n        numeric_value = self._compute_wind_chill_value(measurement.wind_kmh, measurement.temp_c)\n        integer_value = math.ceil(numeric_value)\n\n        return WindChillResult(value=int(integer_value)).value\n\n    def _compute_wind_chill_value(self, wind_kmh: float, temp_c: float) -> float:\n        \"\"\"\n        Private implementation point for the numeric wind chill formula.\n        Raises NotImplementedError until the formula is supplied by stakeholders.\n        \"\"\"\n        # The design context explicitly states t