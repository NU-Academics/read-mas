{"task_id": "Mbpp/123", "solution": "from typing import List, Dict\nimport math\n\n# --- Domain Model Classes (from src/amicable/models.py) ---\nclass Number:\n    \"\"\"A lightweight holder for a numeric domain value.\"\"\"\n    value: int\n    def __init__(self, value: int):\n        self.value = value\n\nclass ProperDivisors:\n    \"\"\"Stores a list of proper divisors for a number and their sum.\"\"\"\n    number: int\n    divisors: List[int]\n    sum: int\n\n    def __init__(self, number: int, divisors: List[int]):\n        self.number = number\n        self.divisors = sorted(divisors) # Store sorted list for consistency\n        self.sum = self.compute_sum()\n\n    def compute_sum(self) -> int:\n        \"\"\"Computes the sum of the stored proper divisors.\"\"\"\n        return sum(self.divisors)\n\nclass AmicablePair:\n    \"\"\"Represents a detected amicable pair of numbers.\"\"\"\n    a: int\n    b: int\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n# --- Amicable Calculator Service Class (from src/amicable/calculator.py) ---\nclass AmicableCalculator:\n    \"\"\"\n    Provides methods for computing proper divisors, their sums, and identifying amicable numbers.\n    \"\"\"\n    _divisor_sum_cache: Dict[int, int]\n\n    def __init__(self):\n        self._divisor_sum_cache = {}\n\n    def computeProperDivisors(self, n: int) -> List[int]:\n        \"\"\"\n        Computes all positive proper divisors for a given number n.\n        Proper divisors are positive divisors less than n.\n        \"\"\"\n        if n <= 1:\n            return []\n        \n        divs = {1} # 1 is a proper divisor for all n > 1\n        \n        # Iterate from 2 up to the square root of n (inclusive)\n        for i in range(2, math.isqrt(n) + 1):\n            if n % i == 0:\n                divs.add(i)\n                if i * i != n: # Add the paired divisor if it's not the square root itself\n                    divs.add(n // i)\n        \n        return sorted(list(divs)) # Return a sorted list of unique proper divisors\n\n    def sumProperDivisors(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of proper divisors for a given number n, utilizing a cache.\n        This method uses the ProperDivisors model to encapsulate the data.\n        \"\"\"\n        if n in self._divisor_sum_cache:\n            return self._divisor_sum_cache[n]\n        \n        if n <= 1:\n            # For 0 and 1, the list of proper divisors is empty, so their sum is 0.\n            proper_divs_obj = ProperDivisors(number=n, divisors=[])\n            s = proper_divs_obj.sum\n            self._divisor_sum_cache[n] = s\n            return s\n            \n        divisors = self.computeProperDivisors(n) # Get the list of proper divisors\n        proper_divs_obj = ProperDivisors(number=n, divisors=divisors) # Create a ProperDivisors object\n        s = proper_divs_obj.sum # Get the sum from the object\n        self._divisor_sum_cache[n] = s\n        return s\n\n    def isAmicable(self, a: int) -> bool:\n        \"\"\"\n        Checks if a number 'a' is part of an amicable pair.\n        An amicable pair (a, b) requires a != b, sumProperDivisors(a) == b, and sumProperDivisors(b) == a.\n        \"\"\"\n        if a <= 1: # Amicable numbers are positive integers\n            return False\n\n        sum_a = self.sumProperDivisors(a)\n\n        if sum_a == a: # An amicable pair must consist of two different numbers\n            return False\n\n        sum_b = self.sumProperDivisors(sum_a) # Calculate sum of proper divisors for sum_a\n\n        return sum_b == a # If sum_b is equal to a, then (a, sum_a) is an amicable pair\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of all unique amicable numbers in the range from 1 to n (inclusive).\n        \"\"\"\n        if n < 1:\n            return 0\n\n        amicable_set = set()\n        for i in range(1, n + 1):\n            sum_i = self.sumProperDivisors(i) # This is 'b' from the design context\n\n            # Check if (i, sum_i) forms an amicable pair according to the design criteria:\n            # b != i and b <= n and sumProperDivisors(b) == i\n            if sum_i != i:\n                # Calculate sumProperDivisors(b)\n                sum_of_sum_i = self.sumProperDivisors(sum_i)\n                \n                if sum_of_sum_i == i:\n                    # If an amicable pair (i, sum_i) is found:\n                    # Add 'i' to the set (it's guaranteed to be <= n as it comes from the loop range)\n                    amicable_set.add(i)\n                    # Add 'sum_i' only if it is also within the specified range [1, n]\n                    if sum_i <= n:\n                        amicable_set.add(sum_i)\n        \n        return sum(amicable_set)\n\n# --- Public API Function (from src/main.py) ---\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all unique amicable numbers from 1 up to a specified number n.\n    Delegates computation to an AmicableCalculator instance.\n    \"\"\"\n    calc = AmicableCalculator()\n    return calc.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/125", "solution": "class InputString:\n    \"\"\"\n    Represents and validates the input binary string.\n    \"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def validate(self) -> None:\n        \"\"\"\n        Validates that the string contains only '0' or '1' characters and is not empty.\n        Raises ValueError for invalid input.\n        \"\"\"\n        if not self.value:\n            raise ValueError(\"Input string cannot be empty.\")\n        for char in self.value:\n            if char not in ('0', '1'):\n                raise ValueError(\"Input string must contain only '0' or '1' characters.\")\n\ndef find_length(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring\n    of the given binary string, using a Kadane-style algorithm.\n    \"\"\"\n    input_str_obj = InputString(input_string)\n    input_str_obj.validate()\n\n    # Map '0' to +1 and '1' to -1 for the maximum subarray sum algorithm.\n    values = [1 if char == '0' else -1 for char in input_string]\n\n    max_so_far = 0\n    current_max = 0\n\n    for val in values:\n        current_max += val\n        # If current sum becomes negative, reset it to 0 as a new subarray is better.\n        if current_max < 0:\n            current_max = 0\n        # Update the overall maximum sum found so far.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "from src.calculator import CommonDivisorCalculator\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Computes the sum of common divisors of two given numbers by delegating to CommonDivisorCalculator.\n    \"\"\"\n    calculator = CommonDivisorCalculator()\n    return calculator.sum_common_divisors(a, b)"}
{"task_id": "Mbpp/130", "solution": "from typing import Any, Dict\n\nclass Item:\n    \"\"\"Value object wrapping a raw element, providing equality and hashing for dict keys.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def __hash__(self) -> int:\n        return hash(self.value)\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, Item):\n            return NotImplemented\n        return self.value == other.value\n\nclass InputList:\n    \"\"\"Encapsulates the input list, providing an iterable interface.\"\"\"\n    def __init__(self, items: list):\n        self.items = items\n\n    def __iter__(self) -> Any: # Returns an iterator over the items\n        return iter(self.items)\n\nclass FrequencyMap:\n    \"\"\"Manages item counts and determines the item with maximum frequency.\"\"\"\n    def __init__(self):\n        self._map: Dict[Item, int] = {}\n\n    def increment(self, item: Item) -> None:\n        \"\"\"Increases the count for the given item, or adds it with count 1.\"\"\"\n        self._map[item] = self._map.get(item, 0) + 1\n\n    def get_max(self) -> Item:\n        \"\"\"Returns the Item with the highest count, resolving ties by insertion order.\"\"\"\n        if not self._map:\n            raise ValueError(\"Frequency map is empty, cannot determine max occurrence.\")\n\n        max_item: Item = next(iter(self._map)) # Initialize with the first item to ensure tie-breaking\n        max_freq: int = self._map[max_item]\n\n        for item, freq in self._map.items():\n            if freq > max_freq:\n                max_freq = freq\n                max_item = item\n        return max_item\n\nclass OccurrenceResult:\n    \"\"\"A simple container for the resulting Item from frequency analysis.\"\"\"\n    def __init__(self, item: Item):\n        self.item = item\n\ndef max_occurrences(list: list) -> Any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    input_list_obj = InputList(list)\n    freq_map = FrequencyMap()\n\n    for val in input_list_obj:\n        item_obj = Item(val)\n        freq_map.increment(item_obj)\n\n    max_item_obj = freq_map.get_max()\n    result = OccurrenceResult(max_item_obj)\n\n    return result.item.value"}
{"task_id": "Mbpp/128", "solution": "class InputParser:\n    \"\"\"Parses text input by splitting on whitespace.\"\"\"\n    def splitOnWhitespace(self, text):\n        return text.split()\n\nclass Word:\n    \"\"\"Encapsulates a single word and provides its length.\"\"\"\n    def __init__(self, text):\n        self.text = text\n    def length(self):\n        return len(self.text)\n\nclass Result:\n    \"\"\"Holds filtered words and provides a method to retrieve the ordered list.\"\"\"\n    def __init__(self):\n        self.filteredWords = []\n    def preserveOrder(self, words):\n        \"\"\"Returns the accumulated filtered words, preserving their original order.\"\"\"\n        return self.filteredWords\n\nclass LongWordsFunction:\n    \"\"\"Orchestrates the process of finding long words.\"\"\"\n    def long_words(self, n, words):\n        input_parser = InputParser()\n        result = Result()\n\n        if isinstance(words, str):\n            word_list = input_parser.splitOnWhitespace(words)\n        else:\n            word_list = words\n\n        for text_token in word_list:\n            word_obj = Word(text_token)\n            if word_obj.length() > n:\n                result.filteredWords.append(text_token)\n        \n        # The 'words' parameter for result.preserveOrder is unused by its internal logic\n        # but is required by the design's method signature.\n        return result.preserveOrder([])\n\ndef long_words(n, words):\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words or a string.\n    Preserves the original relative order of the selected words.\n    \"\"\"\n    orchestrator = LongWordsFunction()\n    return orchestrator.long_words(n, words)"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Encapsulates a matrix and provides accessors for rows, columns, and diagonals.\"\"\"\n    def __init__(self, elements: list[list[float | int]]):\n        self._elements = elements\n        # n is the dimension of the square matrix\n        self.n = len(elements) if isinstance(elements, list) else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square (n x n) and not ragged.\"\"\"\n        if self.n == 0:\n            return False\n        for row in self._elements:\n            if not isinstance(row, list) or len(row) != self.n:\n                return False\n        return True\n\n    def row(self, i: int) -> list[float | int]:\n        \"\"\"Returns the elements of the i-th row.\"\"\"\n        return self._elements[i]\n\n    def column(self, j: int) -> list[float | int]:\n        \"\"\"Returns the elements of the j-th column.\"\"\"\n        return [self._elements[i][j] for i in range(self.n)]\n\n    def main_diagonal(self) -> list[float | int]:\n        \"\"\"Returns the elements of the main diagonal.\"\"\"\n        return [self._elements[i][i] for i in range(self.n)]\n\n    def anti_diagonal(self) -> list[float | int]:\n        \"\"\"Returns the elements of the anti-diagonal.\"\"\"\n        return [self._elements[i][self.n - 1 - i] for i in range(self.n)]\n\nclass MatrixValidator:\n    \"\"\"Validates the structure and numeric type of matrix elements.\"\"\"\n    def validate_structure(self, matrix_obj: Matrix) -> bool:\n        \"\"\"Checks if the input is a valid non-empty square matrix.\"\"\"\n        if not isinstance(matrix_obj._elements, list) or matrix_obj.n == 0:\n            return False\n        return matrix_obj.is_square()\n\n    def validate_elements_numeric(self, matrix_obj: Matrix) -> bool:\n        \"\"\"Checks if all matrix elements are numbers (int or float).\"\"\"\n        for r in range(matrix_obj.n):\n            for c in range(matrix_obj.n):\n                element = matrix_obj._elements[r][c]\n                if not isinstance(element, (int, float)):\n                    return False\n        return True\n\nclass SumCalculator:\n    \"\"\"Calculates sums for rows, columns, and diagonals of a matrix.\"\"\"\n    def sum(self, nums: list[float | int]) -> float | int:\n        \"\"\"Calculates the sum of a list of numbers.\"\"\"\n        return sum(nums)\n\n    def sum_rows(self, matrix_obj: Matrix) -> list[float | int]:\n        \"\"\"Calculates the sum for each row of the matrix.\"\"\"\n        return [self.sum(matrix_obj.row(i)) for i in range(matrix_obj.n)]\n\n    def sum_columns(self, matrix_obj: Matrix) -> list[float | int]:\n        \"\"\"Calculates the sum for each column of the matrix.\"\"\"\n        return [self.sum(matrix_obj.column(j)) for j in range(matrix_obj.n)]\n\n    def sum_main_diagonal(self, matrix_obj: Matrix) -> float | int:\n        \"\"\"Calculates the sum of the main diagonal.\"\"\"\n        return self.sum(matrix_obj.main_diagonal())\n\n    def sum_anti_diagonal(self, matrix_obj: Matrix) -> float | int:\n        \"\"\"Calculates the sum of the anti-diagonal.\"\"\"\n        return self.sum(matrix_obj.anti_diagonal())\n\nclass MagicSquareTest:\n    \"\"\"Orchestrates validation and summation to determine if a matrix is a magic square.\"\"\"\n    def __init__(self, validator: MatrixValidator, calculator: SumCalculator):\n        self.validator = validator\n        self.calculator = calculator\n\n    def magic_square_test(self, matrix_elements: list[list[float | int]]) -> bool:\n        \"\"\"Determines if the given matrix is a magic square by checking all sums.\"\"\"\n        matrix_obj = Matrix(matrix_elements)\n\n        if not self.validator.validate_structure(matrix_obj):\n            return False\n        if not self.validator.validate_elements_numeric(matrix_obj):\n            return False\n\n        row_sums = self.calculator.sum_rows(matrix_obj)\n        col_sums = self.calculator.sum_columns(matrix_obj)\n        main_diag_sum = self.calculator.sum_main_diagonal(matrix_obj)\n        anti_diag_sum = self.calculator.sum_anti_diagonal(matrix_obj)\n\n        if not row_sums: # This case should be covered by validate_structure, but as a safeguard.\n            return False\n\n        magic_constant = row_sums[0]\n\n        if any(s != magic_constant for s in row_sums):\n            return False\n        if any(s != magic_constant for s in col_sums):\n            return False\n        if main_diag_sum != magic_constant:\n            return False\n        if anti_diag_sum != magic_constant:\n            return False\n\n        return True\n\ndef magic_square_test(matrix: list[list[float | int]]) -> bool:\n    \"\"\"\n    Calculates whether the matrix is a magic square.\n    A magic square has equal sums for all rows, columns, and both main diagonals.\n    \"\"\"\n    validator = MatrixValidator()\n    calculator = SumCalculator()\n    tester = MagicSquareTest(validator, calculator)\n    return tester.magic_square_test(matrix)"}
{"task_id": "Mbpp/131", "solution": "from typing import Set\n\nVOWELS: Set[str] = {'a','e','i','o','u','A','E','I','O','U'}\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Return a new string where only vowels are reversed (vowels defined by VOWELS).\"\"\"\n    vowel_indices = []\n    found_vowels = []\n    \n    for i, char in enumerate(s):\n        if char in VOWELS:\n            vowel_indices.append(i)\n            found_vowels.append(char)\n            \n    if len(found_vowels) <= 1:\n        return s\n        \n    reversed_vowels = found_vowels[::-1]\n    \n    char_list = list(s)\n    for i, original_index in enumerate(vowel_indices):\n        char_list[original_index] = reversed_vowels[i]\n        \n    return \"\".join(char_list)"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth hexagonal number using the formula n * (2 * n - 1).\n    \"\"\"\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/132", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors in the tuple conversion.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\ndef tup_string(t: tuple) -> str:\n    \"\"\"Converts a tuple of characters into a single string.\"\"\"\n    return ''.join(t)"}
{"task_id": "Mbpp/133", "solution": "from typing import List, Union\n\nclass NumericValue:\n    \"\"\"Encapsulates a numeric primitive and evaluates negative predicate.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value: float = value\n\n    def isNegative(self) -> bool:\n        \"\"\"Checks if the value is strictly less than zero.\"\"\"\n        return self.value < 0\n\nclass NegativeNumber(NumericValue):\n    \"\"\"Domain subtype representing values known to be negative.\"\"\"\n    def __init__(self, value: float) -> None:\n        super().__init__(value)\n\nclass InputList:\n    \"\"\"Domain container representing the provided ordered collection.\"\"\"\n    def __init__(self, values: List[Union[int, float]]) -> None:\n        self.values: List[Union[int, float]] = values\n\n    def to_numeric_values(self) -> List[NumericValue]:\n        \"\"\"Converts primitive values to NumericValue instances.\"\"\"\n        return [NumericValue(float(v)) for v in self.values]\n\nclass SumResult:\n    \"\"\"Value object encapsulating the numeric total.\"\"\"\n    def __init__(self, total: Union[int, float]) -> None:\n        self.total: float = float(total)\n\nclass SumNegativeFunction:\n    \"\"\"Domain service implementing the algorithm to sum negative numbers.\"\"\"\n    def sum_negativenum(self, values: List[Union[int, float]]) -> SumResult:\n        \"\"\"Wraps inputs, filters negatives, computes sum, and returns SumResult.\"\"\"\n        input_list = InputList(values)\n        numeric_values = input_list.to_numeric_values()\n        \n        negative_numbers_values = [nv.value for nv in numeric_values if nv.isNegative()]\n        \n        current_sum = sum(negative_numbers_values)\n        return SumResult(current_sum)\n\ndef sum_negativenum(values: List[Union[int, float]]) -> float:\n    \"\"\"\n    Calculates the sum of the negative numbers of a given list of numbers.\n    Returns the numeric sum of values strictly less than zero, or 0 if none.\n    \"\"\"\n    calculator = SumNegativeFunction()\n    result = calculator.sum_negativenum(values)\n    return result.total"}
{"task_id": "Mbpp/137", "solution": "from typing import List\n\nclass IntArray:\n    \"\"\"Represents an array of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\nclass IntegerValue:\n    \"\"\"Represents a single integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Result:\n    \"\"\"Encapsulates the computed ratio.\"\"\"\n    def __init__(self, ratio: float) -> None:\n        self.ratio = ratio\n\nclass ZeroCountFunction:\n    \"\"\"\n    Computes the ratio of zeroes to non-zeroes in an array.\n    Handles division by zero gracefully.\n    \"\"\"\n    def compute(self, array: List[int]) -> float:\n        zeroes = 0\n        non_zeroes = 0\n\n        for element in array:\n            if element == 0:\n                zeroes += 1\n            else:\n                non_zeroes += 1\n\n        if non_zeroes == 0:\n            if zeroes == 0:\n                # For an empty array (0/0), a ratio of 0.0 is returned.\n                return 0.0\n            else:\n                # For an array with only zeroes (X/0 where X > 0), positive infinity is returned.\n                return float('inf')\n        \n        ratio = float(zeroes) / non_zeroes\n        return Result(ratio).ratio\n\ndef zero_count(array: List[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    The ratio is (number of elements equal to 0) / (number of elements not equal to 0).\n    \"\"\"\n    computer = ZeroCountFunction()\n    return computer.compute(array)"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(iterable_of_sequences) -> set:\n    \"\"\"Accepts an iterable of sequences of numbers and returns a set of unique numbers.\"\"\"\n    result_set = set()\n    for sequence in iterable_of_sequences:\n        for element in sequence:\n            result_set.add(element)\n    return result_set"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius):\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Converts the radius to a float and uses math.pi for precision.\n    \"\"\"\n    float_radius = float(radius)\n    circumference = 2 * math.pi * float_radius\n    return circumference"}
{"task_id": "Mbpp/138", "solution": "from typing import Iterator, List\n\ndef _validate_input(n) -> int:\n    \"\"\"Validates input type; raises TypeError if n is not an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    return n\n\ndef _generate_allowed_powers(n: int) -> Iterator[int]:\n    \"\"\"Yields allowed powers of two (2^k for k >= 1) up to n.\"\"\"\n    power = 2\n    while power <= n:\n        yield power\n        power *= 2\n\ndef _subset_sum_check(n: int, allowed_powers: List[int]) -> bool:\n    \"\"\"Determines if n can be formed as a sum of a subset of allowed_powers.\"\"\"\n    achievable = {0}\n    for p in allowed_powers:\n        # Create a new set of sums by adding 'p' to all currently achievable sums.\n        # Use |= for efficient in-place union if preferred, but explicit copy\n        # for clarity or if 'achievable' must remain unchanged during iteration.\n        achievable.update({s + p for s in achievable})\n        if n in achievable:\n            return True\n    return False\n\ndef is_Sum_Of_Powers_Of_Two(n) -> bool:\n    \"\"\"\n    Checks if n can be represented as a sum of non-zero powers of 2 (i.e., 2^k for k >= 1).\n    Raises TypeError if input n is not an integer.\n    \"\"\"\n    _validate_input(n)\n\n    if n <= 1:\n        return False\n\n    allowed_powers = list(_generate_allowed_powers(n))\n    return _subset_sum_check(n, allowed_powers)"}
