{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns the original list unchanged if its length is 0 or 1.\n    \"\"\"\n    list_length = len(input_list)\n    if list_length >= 2:\n        # Create a new list to avoid modifying the original list in place\n        # unless a new list is explicitly preferred by the caller via assignment.\n        # This approach ensures the original list is not altered for cases where\n        # an immutable-like behavior is expected implicitly.\n        new_list = list(input_list) # Make a shallow copy\n        new_list[0], new_list[list_length - 1] = new_list[list_length - 1], new_list[0]\n        return new_list\n    else:\n        return input_list"}
{"task_id": "Mbpp/589", "solution": "import math\n\nclass Range:\n    def __init__(self, start, end):\n        self.start = start\n        self.end = end\n\nclass PerfectSquare:\n    def __init__(self, value: int, root: int):\n        self.value = value\n        self.root = root\n\nclass ResultList:\n    def __init__(self, values: list[int]):\n        self.values = values\n\n    def sortAscending(self) -> None:\n        self.values.sort()\n\nclass PerfectSquaresFunction:\n    \"\"\"\n    Orchestrates validation and computation of perfect squares.\n    \"\"\"\n    def validateInputs(self, start, end) -> None:\n        \"\"\"Raises ValueError if inputs are not numeric.\"\"\"\n        if not isinstance(start, (int, float)) or not isinstance(end, (int, float)):\n            raise ValueError(\"Start and end parameters must be numeric.\")\n\n    def computeSquares(self, start, end) -> list[int]:\n        \"\"\"Computes integer perfect squares within the given range [start, end].\"\"\"\n        squares = []\n\n        # Perfect squares are non-negative; adjust 'start' if it's negative to begin search from 0.\n        effective_start = max(0, start)\n        # If the adjusted start is greater than end, no perfect squares can exist in the range.\n        if effective_start > end:\n            return []\n\n        # Calculate the minimum integer root 'n_min' such that n_min*n_min >= effective_start.\n        n_min = math.ceil(math.sqrt(effective_start))\n\n        # Calculate the maximum integer root 'n_max' such that n_max*n_max <= end.\n        # Ensure the value passed to sqrt is non-negative.\n        n_max = math.floor(math.sqrt(max(0, end)))\n\n        # Iterate from n_min to n_max (inclusive) to find and collect perfect squares.\n        for n in range(int(n_min), int(n_max) + 1):\n            square = n * n\n            squares.append(square)\n        \n        return squares\n\n    def perfect_squares(self, start, end) -> list[int]:\n        \"\"\"Delegates to validate inputs, compute squares, and sort results.\"\"\"\n        self.validateInputs(start, end)\n        computed_squares = self.computeSquares(start, end)\n        result_list = ResultList(computed_squares)\n        result_list.sortAscending()\n        return result_list.values\n\n\ndef perfect_squares(start, end) -> list[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive).\n    \"\"\"\n    function_instance = PerfectSquaresFunction()\n    return function_instance.perfect_squares(start, end)"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(a, b):\n    \"\"\"\n    Converts rectangular (a, b) to polar (r, theta) and polar (a, b) to rectangular complex (z).\n    Returns ((r: float, theta: float), z: complex).\n    \"\"\"\n    # Compute polar coordinates (r, theta) from rectangular inputs (x=a, y=b)\n    r_from_rect = float(math.sqrt(a * a + b * b))\n    theta_from_rect = float(math.atan2(b, a))\n\n    # Compute rectangular complex coordinate (z) from polar inputs (r=a, theta=b)\n    z = complex(a * math.cos(b), a * math.sin(b))\n\n    return ((r_from_rect, theta_from_rect), z)"}
{"task_id": "Mbpp/592", "solution": "import math\n\nclass BinomialCoefficient:\n    @staticmethod\n    def compute(n: int, k: int) -> int:\n        \"\"\"Computes the binomial coefficient C(n, k) using integer arithmetic.\"\"\"\n        if hasattr(math, 'comb'):\n            return math.comb(n, k)\n        \n        # Fallback for older Python versions when math.comb is not available.\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\nclass Computation:\n    def __init__(self, n: int):\n        self._n = n\n\n    def sum(self) -> int:\n        \"\"\"Calculates S(n) using the closed-form identity C(2n, n-1).\"\"\"\n        # The sum S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1) is equal to C(2n, n-1).\n        return BinomialCoefficient.compute(2 * self._n, self._n - 1)\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1) using the identity S(n) = C(2n, n-1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    computation = Computation(n)\n    return computation.sum()"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet string and produces its normalized textual form.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n        self.normalized: str = \"\"\n        self.value: int = 0\n\n    def stripLeadingZeros(self) -> str:\n        \"\"\"Removes leading zeros from the octet while preserving its numeric value.\"\"\"\n        if self.raw == '0':\n            self.normalized = '0'\n        elif all(c == '0' for c in self.raw): # For inputs like \"00\", \"000\"\n            self.normalized = '0'\n        else:\n            self.value = int(self.raw)\n            self.normalized = str(self.value)\n        return self.normalized\n\nclass IPAddress:\n    \"\"\"Parses dotted-decimal raw input into Octet instances and produces normalized string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n        self.octets_raw_strings = self.raw.split('.')\n        self.octets: list[Octet] = []\n        self.normalized: str = \"\"\n\n    def validate(self) -> bool:\n        \"\"\"Checks for exactly 4 octets and that each octet contains only digits.\"\"\"\n        if len(self.octets_raw_strings) != 4:\n            return False\n        for octet_str in self.octets_raw_strings:\n            if not octet_str.isdigit():\n                return False\n        return True\n\n    def normalize(self) -> str:\n        \"\"\"Creates Octet instances, normalizes them, and joins into a normalized IP string.\"\"\"\n        normalized_octet_strings = []\n        for octet_str in self.octets_raw_strings:\n            octet_obj = Octet(octet_str)\n            self.octets.append(octet_obj)\n            normalized_octet_strings.append(octet_obj.stripLeadingZeros())\n        self.normalized = \".\".join(normalized_octet_strings)\n        return self.normalized\n\nclass RemoveZeroService:\n    \"\"\"Provides service-level API and coordinates IPAddress normalization.\"\"\"\n    def removezero_ip(self, ip: str) -> str:\n        \"\"\"Orchestrates IPAddress creation and normalization.\"\"\"\n        ip_address = IPAddress(ip)\n        # The design notes that SRS leaves error handling unspecified.\n        # For simplicity and adherence to the prompt, we proceed with normalization\n        # assuming valid input as per the example.\n        return ip_address.normalize()\n\ndef removezero_ip(ip: str) -> str:\n    \"\"\"\n    Removes leading zeroes from each octet of an IP address string.\n    Example: removezero_ip(\"216.08.094.196\") == '216.8.94.196'\n    \"\"\"\n    service = RemoveZeroService()\n    return service.removezero_ip(ip)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(lst):\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    The order is (first even) - (first odd), scanning left-to-right.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in lst:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even - first_odd"}
