{"task_id": "Mbpp/620", "solution": "import collections\n\nclass NumberElement:\n    \"\"\"Represent a single occurrence with identity and value; provide divisibility predicate.\"\"\"\n    _next_id = 0\n\n    def __init__(self, value: int):\n        self.id = NumberElement._next_id\n        NumberElement._next_id += 1\n        self.value = value\n\n    def divides(self, other: 'NumberElement') -> bool:\n        \"\"\"\n        Returns True if this element's value divides the other element's value.\n        Zero-handling policy: 0 divides only 0. Any non-zero integer divides 0.\n        \"\"\"\n        if self.value == 0:\n            return other.value == 0\n        if other.value == 0:\n            return True\n        return other.value % self.value == 0\n\n    def __repr__(self):\n        return f\"NumberElement(id={self.id}, value={self.value})\"\n\nclass NumberList:\n    \"\"\"Runtime container for caller-supplied occurrences; preserves distinct identity per occurrence.\"\"\"\n    def __init__(self):\n        self.elements: list[NumberElement] = []\n\n    def add(self, number: int) -> None:\n        \"\"\"Create a NumberElement for the provided integer occurrence and append it.\"\"\"\n        self.elements.append(NumberElement(number))\n\n    def size(self) -> int:\n        \"\"\"Return number of elements.\"\"\"\n        return len(self.elements)\n\nclass DivisibilityGraph:\n    \"\"\"Represent nodes and edges where an edge exists if a|b or b|a for the node pair; provide neighbor access.\"\"\"\n    def __init__(self):\n        self.nodes: list[NumberElement] = []\n        self.edges: dict[int, list[int]] = collections.defaultdict(list)\n\n    def build(self, elements: list[NumberElement]) -> None:\n        \"\"\"\n        Construct nodes and edges for each unordered pair where divisibility holds.\n        Treat duplicates as distinct nodes. Zero-handling follows NumberElement.divides policy.\n        \"\"\"\n        self.nodes = elements\n        for i in range(len(self.nodes)):\n            for j in range(i + 1, len(self.nodes)):\n                e1 = self.nodes[i]\n                e2 = self.nodes[j]\n                if e1.divides(e2) or e2.divides(e1):\n                    self.edges[e1.id].append(e2.id)\n                    self.edges[e2.id].append(e1.id)\n\n    def neighbors(self, nodeId: int) -> list[int]:\n        \"\"\"Return neighbor node ids.\"\"\"\n        return self.edges.get(nodeId, [])\n\nclass SubsetResult:\n    \"\"\"Immutable/structured result (size and optional elements).\"\"\"\n    def __init__(self, size: int, elements: list[NumberElement] = None):\n        self.size = size\n        self.elements = elements if elements is not None else []\n\n    def toInt(self) -> int:\n        \"\"\"Return the size.\"\"\"\n        return self.size\n\nclass SubsetFinder:\n    \"\"\"Build the DivisibilityGraph and compute the size of the largest subset.\"\"\"\n    def __init__(self):\n        self.graph: DivisibilityGraph | None = None\n        self.list_ref: NumberList | None = None\n\n    def largestSubset(self, number_list: NumberList) -> int:\n        \"\"\"\n        Top-level operation returning the integer size; returns 0 when list.size() == 0.\n        \"\"\"\n        self.list_ref = number_list\n        if self.list_ref.size() == 0:\n            return 0\n        \n        # The graph is built as per design requirements, even if the optimal DP\n        # for a divisibility chain does not directly query its adjacency list.\n        self.buildGraph() \n        \n        result = self.findMaxCliqueOrChain()\n        return result.toInt()\n\n    def buildGraph(self) -> None:\n        \"\"\"Construct DivisibilityGraph from list_ref.\"\"\"\n        self.graph = DivisibilityGraph()\n        self.graph.build(self.list_ref.elements)\n\n    def findMaxCliqueOrChain(self) -> SubsetResult:\n        \"\"\"\n        Executes the search for the maximal subset (longest divisibility chain) using dynamic programming.\n        The algorithm finds the longest chain `s1|s2|...|sk` by sorting elements and applying a DP approach.\n        \"\"\"\n        elements = self.list_ref.elements\n        if not elements:\n            return SubsetResult(0, [])\n\n        # Sort elements by value, then by ID for a stable sort.\n        # This allows for simpler divisibility checks in the DP loop.\n        sorted_elements = sorted(elements, key=lambda e: (e.value, e.id))\n\n        n = len(sorted_elements)\n        dp = [1] * n  # dp[i] stores the length of the longest chain ending with sorted_elements[i]\n        predecessor_idx = [-1] * n # To reconstruct the actual subset\n\n        max_len = 0\n        last_element_idx = -1\n\n        for i in range(n):\n            for j in range(i):\n                # Check if sorted_elements[j] divides sorted_elements[i].\n                # (sorted_elements[j].value <= sorted_elements[i].value is guaranteed by sort).\n                if sorted_elements[j].divides(sorted_elements[i]):\n                    if dp[j] + 1 > dp[i]:\n                        dp[i] = dp[j] + 1\n                        predecessor_idx[i] = j\n            \n            if dp[i] > max_len:\n                max_len = dp[i]\n                last_element_idx = i\n        \n        # Reconstruct the chain from the predecessor indices.\n        chain = []\n        if last_element_idx != -1:\n            current_idx = last_element_idx\n            while current_idx != -1:\n                chain.append(sorted_elements[current_idx])\n                current_idx = predecessor_idx[current_idx]\n            chain.reverse() # Reverse to get the chain in increasing order of divisibility\n\n        return SubsetResult(max_len, chain)\n\ndef largest_subset(numbers) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    This function orchestrates the use of domain classes to achieve the result.\n    \"\"\"\n    # NumberElement ID counter reset ensures IDs are unique for each call to largest_subset.\n    NumberElement._next_id = 0 \n\n    if not numbers:\n        return 0\n\n    nl = NumberList()\n    for v in numbers:\n        nl.add(v)\n\n    sf = SubsetFinder()\n    return sf.largestSubset(nl)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    The median is the average of the n-th and (n+1)-th smallest elements (1-based index)\n    from the combined 2n elements.\n    \"\"\"\n    # Validate input lengths and 'n' as per design requirements.\n    if len(list1) != n:\n        raise ValueError(f\"Length of list1 ({len(list1)}) must be equal to n ({n}).\")\n    if len(list2) != n:\n        raise ValueError(f\"Length of list2 ({len(list2)}) must be equal to n ({n}).\")\n    if n <= 0:\n        raise ValueError(\"n must be greater than 0.\")\n\n    # Helper function to compute the average of two numbers, ensuring float return type.\n    def _average(a, b):\n        return float((float(a) + float(b)) / 2.0)\n\n    # Helper function to find the k-th smallest element (1-based index) from two sorted lists.\n    def _select_kth(arr1, arr2, k, n_val):\n        ptr1, ptr2 = 0, 0\n        current_element = 0\n\n        for _ in range(k):\n            # If arr1 is exhausted or arr1's current element is smaller than arr2's.\n            if ptr1 < n_val and (ptr2 == n_val or arr1[ptr1] < arr2[ptr2]):\n                current_element = arr1[ptr1]\n                ptr1 += 1\n            # Otherwise, take from arr2.\n            else:\n                current_element = arr2[ptr2]\n                ptr2 += 1\n        return current_element\n\n    # For 2n elements, the median is the average of the n-th and (n+1)-th smallest elements (1-based indexing).\n    nth_element = _select_kth(list1, list2, n, n)\n    n_plus_1th_element = _select_kth(list1, list2, n + 1, n)\n\n    return _average(nth_element, n_plus_1th_element)"}
{"task_id": "Mbpp/623", "solution": "from typing import Any, List\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid inputs, storing structured error metadata.\n    \"\"\"\n    def __init__(self, error_code: str, message: str, invalid_field: str, invalid_value: Any) -> None:\n        super().__init__(message)\n        self.error_code = error_code\n        self.message = message\n        self.invalid_field = invalid_field\n        self.invalid_value = invalid_value\n\nclass Validator:\n    \"\"\"\n    A stateless helper class for input validation, raising ValidationError on invalid inputs.\n    \"\"\"\n    def validateList(self, list: Any) -> None:\n        if not isinstance(list, (list, tuple)):\n            raise ValidationError(\"NOT_A_LIST\", \"First argument must be a list\", \"list\", list)\n\n    def validateElements(self, list: List[Any]) -> None:\n        for i, v in enumerate(list):\n            if not isinstance(v, (int, float)):\n                raise ValidationError(\"NON_NUMERIC_ELEMENT\", f\"List element at index {i} is not numeric\", f\"list[{i}]\", v)\n\n    def validateExponent(self, n: Any) -> None:\n        if not isinstance(n, int):\n            raise ValidationError(\"NON_INTEGER_EXPONENT\", \"Exponent must be an integer\", \"n\", n)\n\ndef nth_nums(list: List[Any], n: Any) -> List[Any]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Validates inputs and raises ValidationError for invalid arguments.\n    \"\"\"\n    validator = Validator()\n    validator.validateList(list)\n    validator.validateElements(list)\n    validator.validateExponent(n)\n\n    if len(list) == 0:\n        return []\n\n    result = [element ** n for element in list]\n    return result"}
{"task_id": "Mbpp/628", "solution": "class Character:\n    \"\"\"\n    Represents a single character and provides a method to check if it's a space.\n    Used by ReplaceSpacesService to process individual characters.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isSpace(self) -> bool:\n        \"\"\"Checks if the character's value is an ASCII space.\"\"\"\n        return self.value == ' '\n\nclass InputString:\n    \"\"\"\n    A lightweight wrapper for the input string, providing a length accessor.\n    Encapsulates the raw input for traceability and potential future enhancements.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped string.\"\"\"\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"\n    A lightweight wrapper for the output string.\n    Holds the transformed string value produced by the service.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass ReplaceSpacesService:\n    \"\"\"\n    Encapsulates the core logic for replacing spaces in a string with '%20'.\n    It processes the input character by character using helper objects.\n    \"\"\"\n    def replace_spaces(self, input_str: str) -> str:\n        input_obj = InputString(input_str)\n        if input_obj.length() == 0:\n            return \"\"\n\n        result_buffer = []\n        for char_val in input_obj.value:\n            char_obj = Character(char_val)\n            if char_obj.isSpace():\n                result_buffer.append('%20')\n            else:\n                result_buffer.append(char_val)\n\n        return \"\".join(result_buffer)\n\ndef replace_spaces(input: str) -> str:\n    \"\"\"\n    Replaces all ASCII space characters (' ') in the given string with '%20'.\n    This function delegates the actual transformation logic to a ReplaceSpacesService.\n    \"\"\"\n    service = ReplaceSpacesService()\n    return service.replace_spaces(input)"}
{"task_id": "Mbpp/626", "solution": "from typing import Optional\n\nclass Result:\n    \"\"\"Encapsulates result value and status metadata.\"\"\"\n    def __init__(self, value: Optional[float], status: str):\n        self._value = value\n        self._status = status\n\n    def as_float(self) -> Optional[float]:\n        \"\"\"Returns float value when present; otherwise None.\"\"\"\n        if self._value is not None:\n            return float(self._value)\n        return None\n\nclass InputValidator:\n    \"\"\"Implements input validation logic.\"\"\"\n    def is_numeric(self, r) -> bool:\n        \"\"\"Checks if r is numeric.\"\"\"\n        return isinstance(r, (int, float))\n\n    def is_negative(self, r) -> bool:\n        \"\"\"Checks if r is negative.\"\"\"\n        return r < 0\n\n    def is_zero(self, r) -> bool:\n        \"\"\"Checks if r is zero.\"\"\"\n        return r == 0\n\nclass TriangleAreaService:\n    \"\"\"Implements geometry logic for computing the area.\"\"\"\n    def triangle_area(self, r: float) -> Result:\n        \"\"\"High-level operation that returns a Result containing area and status string for r >= 0.\"\"\"\n        # This method assumes r is numeric and non-negative as per API layer validation.\n        if r == 0:\n            return Result(0, 'zero')\n        area = self.compute_max_area(r)\n        return Result(area, 'ok')\n\n    def compute_max_area(self, r: float) -> float:\n        \"\"\"Computes area_max = r * r (r^2) and returns float.\"\"\"\n        return r * r\n\ndef triangle_area(r) -> Optional[float]:\n    \"\"\"\n    Public API: returns None for r<0, 0 for r==0, and r*r (float) for r>0.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_numeric(r):\n        return None\n\n    if validator.is_negative(r):\n        return None\n\n    # At this point, r is numeric and non-negative (r >= 0).\n    service = TriangleAreaService()\n    result_obj = service.triangle_area(r)\n    return result_obj.as_float()"}
