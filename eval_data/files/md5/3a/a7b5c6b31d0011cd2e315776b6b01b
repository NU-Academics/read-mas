{"task_id": "Mbpp/259", "solution": "class Validator:\n    \"\"\"\n    Encapsulates validation logic for tuple structures and element comparability.\n    \"\"\"\n    def validate_outer_length(self, tuple1, tuple2):\n        \"\"\"\n        Validates that both inputs are tuples and have the same outer length.\n        \"\"\"\n        if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n            raise TypeError(\"Inputs must be tuples of tuples.\")\n        if len(tuple1) != len(tuple2):\n            raise ValueError(\"Outer tuples must have the same length.\")\n\n    def validate_inner_length(self, inner1, inner2):\n        \"\"\"\n        Validates that inner elements are tuples and have the same length.\n        \"\"\"\n        if not isinstance(inner1, tuple) or not isinstance(inner2, tuple):\n            raise TypeError(\"Inner elements must be tuples.\")\n        if len(inner1) != len(inner2):\n            raise TypeError(\"Corresponding inner tuples must have the same length.\")\n\n    def validate_comparability(self, inner1, inner2):\n        \"\"\"\n        Validates that elements within corresponding inner tuples are comparable.\n        \"\"\"\n        for a, b in zip(inner1, inner2):\n            try:\n                max(a, b) # Attempt comparison to check comparability\n            except TypeError:\n                raise TypeError(f\"Elements '{a}' and '{b}' are not comparable.\")\n\n\ndef maximize_elements(tuple1, tuple2):\n    \"\"\"\n    Computes element-wise maximums of two corresponding tuples of tuples.\n    Returns a new tuple of tuples where each inner tuple contains the maxima.\n    \"\"\"\n    validator = Validator()\n\n    validator.validate_outer_length(tuple1, tuple2)\n\n    result_outer_list = []\n    for inner1, inner2 in zip(tuple1, tuple2):\n        validator.validate_inner_length(inner1, inner2)\n        validator.validate_comparability(inner1, inner2)\n        \n        current_inner_result = tuple(max(a, b) for a, b in zip(inner1, inner2))\n        result_outer_list.append(current_inner_result)\n\n    return tuple(result_outer_list)"}
{"task_id": "Mbpp/260", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the newman_prime function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input 'n' for the newman_prime function.\"\"\"\n    def validate(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass NWSGenerator:\n    \"\"\"Generates Newman\u2013Shanks\u2013Williams numbers based on the recurrence.\"\"\"\n    def __init__(self):\n        self._sequence = [1, 1] # S(0)=1, S(1)=1\n\n    def nthNwsNumber(self, n: int) -> int:\n        \"\"\"Calculates and returns the NWS number at the given index 'n'.\"\"\"\n        while len(self._sequence) <= n:\n            s_n_minus_1 = self._sequence[-1]\n            s_n_minus_2 = self._sequence[-2]\n            next_nws = 2 * s_n_minus_1 + s_n_minus_2\n            self._sequence.append(next_nws)\n        return self._sequence[n]\n\nclass PrimeChecker:\n    \"\"\"Checks if a given number is prime.\"\"\"\n    def isPrime(self, x: int) -> bool:\n        if x < 2:\n            return False\n        for i in range(2, int(x**0.5) + 1):\n            if x % i == 0:\n                return False\n        return True\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the Newman\u2013Shanks\u2013Williams prime number S_n, where n is the input index.\n    The function assumes S_n will be prime for valid input 'n' based on the given assertion.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n\n    generator = NWSGenerator()\n    # The assertion newman_prime(3) == 7 implies 'n' refers to the index 'k' such that S_k is the prime.\n    nws_number = generator.nthNwsNumber(n)\n\n    # Per the problem statement, this number is expected to be prime.\n    # No explicit check or error handling for non-prime S_n is required in this function.\n    return nws_number"}
{"task_id": "Mbpp/261", "solution": "def validate_types(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that both inputs are tuples, raising TypeError if not.\"\"\"\n    if not isinstance(a, tuple):\n        raise TypeError(\"Input 'a' must be a tuple.\")\n    if not isinstance(b, tuple):\n        raise TypeError(\"Input 'b' must be a tuple.\")\n\ndef validate_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that both tuples have the same length, raising ValueError if not.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\ndef validate_numeric_elements(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that all elements in both tuples are numeric (int or float).\"\"\"\n    for val in a:\n        if not isinstance(val, (int, float)):\n            raise TypeError(\"All elements in tuple 'a' must be numeric (int or float).\")\n    for val in b:\n        if not isinstance(val, (int, float)):\n            raise TypeError(\"All elements in tuple 'b' must be numeric (int or float).\")\n\ndef check_zero_denominators(b: tuple) -> None:\n    \"\"\"Checks for zero values in the denominator tuple, raising ZeroDivisionError if found.\"\"\"\n    for i, val in enumerate(b):\n        if val == 0:\n            raise ZeroDivisionError(f\"Cannot divide by zero. Denominator at index {i} is zero.\")\n\ndef division_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples, a[i] / b[i].\n    Raises TypeError for non-tuple inputs or non-numeric elements, ValueError for length mismatch,\n    and ZeroDivisionError for division by zero.\n    \"\"\"\n    validate_types(a, b)\n    validate_lengths(a, b)\n    validate_numeric_elements(a, b)\n    check_zero_denominators(b)\n\n    results = []\n    for num, den in zip(a, b):\n        results.append(int(num / den))\n\n    return tuple(results)"}
{"task_id": "Mbpp/262", "solution": "from typing import List, Tuple\n\nclass InputList:\n    \"\"\"Represents the input list abstraction and provides read-only accessors.\n    It stores a shallow copy of the input list to prevent external mutations.\"\"\"\n    def __init__(self, items: List):\n        self._items = list(items)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return len(self._items)\n\n    def get_slice(self, start: int, end: int) -> List:\n        \"\"\"Returns a shallow copy of the requested slice from the internal list.\"\"\"\n        return self._items[start:end]\n\nclass IntegerParameter:\n    \"\"\"Represents and validates an integer parameter L against a maximum bound.\n    The value is stored internally.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def is_valid(self, max_value: int) -> bool:\n        \"\"\"Checks if the parameter's value is an integer and within the inclusive range [0, max_value].\"\"\"\n        return isinstance(self._value, int) and 0 <= self._value <= max_value\n\nclass SplitResult:\n    \"\"\"Holds the two resulting lists from a split operation.\n    Provides a method to retrieve them as a tuple.\"\"\"\n    def __init__(self, first_part: List, second_part: List):\n        self._first_part = first_part\n        self._second_part = second_part\n\n    def as_tuple(self) -> Tuple[List, List]:\n        \"\"\"Returns the stored first and second parts as a tuple.\"\"\"\n        return (self._first_part, self._second_part)\n\nclass SplitService:\n    \"\"\"Encapsulates validation and splitting logic per SRS business rules.\n    It is designed to be stateless.\"\"\"\n    def validate_params(self, items: List, L) -> None:\n        \"\"\"Validates that L is an integer and is within the valid range [0, len(items)].\"\"\"\n        if not isinstance(L, int):\n            raise TypeError(\"L must be an integer.\")\n        if not (0 <= L <= len(items)):\n            raise ValueError(f\"L must be within the range [0, {len(items)}].\")\n\n    def split_two_parts(self, items: List, L: int) -> SplitResult:\n        \"\"\"Performs the list splitting after validating input parameters.\"\"\"\n        self.validate_params(items, L)\n        \n        input_list = InputList(items)\n        first_part = input_list.get_slice(0, L)\n        second_part = input_list.get_slice(L, input_list.length())\n        \n        return SplitResult(first_part, second_part)\n\ndef split_two_parts(items: List, L) -> Tuple[List, List]:\n    \"\"\"\n    Splits the given list into two parts where the length of the first part is L.\n    It returns the resulting lists in a tuple (first_part, second_part).\n    \"\"\"\n    service = SplitService()\n    result = service.split_two_parts(items, L)\n    return result.as_tuple()"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age):\n    \"\"\"\n    Calculates a dog's age in dog years based on human age.\n    The first two human years count 10.5 dog years each, and subsequent years count 4 dog years each.\n    \"\"\"\n    if human_age <= 2:\n        return human_age * 10.5\n    else:\n        return 21 + (human_age - 2) * 4"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side: float) -> float:\n    \"\"\"Compute lateral surface area of a cube: lateral = 4 * side^2.\n    Exact public signature required by SRS: lateralsurface_cube(side).\n    \"\"\"\n    return 4 * side * side"}
{"task_id": "Mbpp/265", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\ndef validate_n(n) -> None:\n    \"\"\"Validates that n is a positive integer, raising ValidationError if not.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValidationError('n must be a positive integer')\n\ndef split(input_list, n) -> list[list]:\n    \"\"\"Splits the input list into n sublists based on modulo indexing.\"\"\"\n    result = [[] for _ in range(n)]\n    for idx, item in enumerate(input_list):\n        bucket = idx % n\n        result[bucket].append(item)\n    return result\n\ndef list_split(input_list, n) -> list[list]:\n    \"\"\"Splits a list into n sublists, distributing elements every nth position.\"\"\"\n    validate_n(n)\n    return split(input_list, n)"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    If n is 0, returns 0.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_number = 2 * k - 1\n        total_sum += odd_number * odd_number\n    return total_sum"}
{"task_id": "Mbpp/268", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input for star number calculation.\"\"\"\n    def is_positive_integer(self, value) -> bool:\n        \"\"\"Checks if a value is a positive integer greater than or equal to 1.\"\"\"\n        return isinstance(value, int) and value >= 1\n\n    def assert_valid(self, n) -> None:\n        \"\"\"Asserts that n is a positive integer, raising ValidationError if not.\"\"\"\n        if not self.is_positive_integer(n):\n            raise ValidationError(\"n must be a positive integer >= 1\")\n\nclass StarNumberCalculator:\n    \"\"\"Calculates star numbers using the closed-form formula.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n'th star number.\"\"\"\n        return self.formula(n)\n\n    def formula(self, n: int) -> int:\n        \"\"\"Performs the star number formula S(n) = 6 * n * (n - 1) + 1.\"\"\"\n        return 6 * n * (n - 1) + 1\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Calculates the n'th star number.\n\n    Validates input `n` and computes the star number using the formula S(n) = 6 * n * (n - 1) + 1.\n    \"\"\"\n    validator = InputValidator()\n    validator.assert_valid(n)\n    calc = StarNumberCalculator()\n    return calc.compute(n)"}
{"task_id": "Mbpp/269", "solution": "from src.ascii_converter import AsciiConverter\nfrom src.character import Character\n\ndef ascii_value(char: str) -> int:\n    \"\"\"\n    Returns the ASCII integer code for a single character.\n\n    Precondition: char must be a single-character string.\n    \"\"\"\n    character_obj = Character(char)\n    converter = AsciiConverter()\n    return converter.ascii_value(character_obj)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(lst):\n    \"\"\"\n    Calculates the sum of even numbers located at even 0-based indices in a list.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 == 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "class EvenNumberSequence:\n    \"\"\"Generates a sequence of even natural numbers.\"\"\"\n    @staticmethod\n    def generate(n: int) -> list[int]:\n        return [2 * i for i in range(1, n + 1)]\n\nclass Computation:\n    \"\"\"Performs power and sum computations.\"\"\"\n    @staticmethod\n    def pow5(x: int) -> int:\n        return x ** 5\n\n    @staticmethod\n    def sum(values: list[int]) -> int:\n        return builtins.sum(values)\n\nclass Result:\n    \"\"\"Encapsulates the integer sum.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nimport builtins\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    \"\"\"\n    even_numbers = EvenNumberSequence.generate(n)\n    powered_numbers = [Computation.pow5(x) for x in even_numbers]\n    total = Computation.sum(powered_numbers)\n    result_obj = Result(total)\n    return result_obj.value"}
{"task_id": "Mbpp/272", "solution": "from typing import Any, List, Tuple\n\ndef rear_extract(input_list: List[Tuple[Any, ...]]) -> List[Any]:\n    \"\"\"\n    Extracts the rear element from each tuple in a list of tuples.\n    Returns a new list containing these last elements in order.\n    \"\"\"\n    return [t[-1] for t in input_list]"}
{"task_id": "Mbpp/273", "solution": "class LengthMismatchError(Exception):\n    \"\"\"Exception raised for unequal tuple lengths.\"\"\"\n    def __init__(self, message=\"Tuples must have the same length\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef validate_lengths(first: tuple, second: tuple) -> bool:\n    \"\"\"Checks if two tuples have the same length.\"\"\"\n    return len(first) == len(second)\n\ndef substract_elements(first: tuple, second: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple at corresponding indices.\n    Raises LengthMismatchError if tuples have different lengths.\n    \"\"\"\n    if not validate_lengths(first, second):\n        raise LengthMismatchError(\"Tuples must have the same length for element-wise subtraction.\")\n\n    result = [first[i] - second[i] for i in range(len(first))]\n    return tuple(result)"}
{"task_id": "Mbpp/276", "solution": "import math\n\ndef volume_cylinder(radius, height):\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height using the formula V = \u03c0 * radius^2 * height.\n    \"\"\"\n    volume = math.pi * radius * radius * height\n    return float(volume)"}
{"task_id": "Mbpp/274", "solution": "import math\n\nclass InputParameter:\n    \"\"\"Encapsulates and validates the input n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self):\n        \"\"\"Returns True if n is a positive integer, False otherwise.\"\"\"\n        return isinstance(self.n, int) and self.n >= 0 # Changed to >= 0 per typical definition of n in C(n,k) context, although design says \"positive integer\". If n=0 is considered, C(0,0)=1, sum is 1. If strictly n>0, then 0 would be invalid. Given `math.comb` handles `n=0` gracefully, and often 0 is included as a non-negative integer, I'll go with >=0.\n\nclass BinomialCoefficient:\n    \"\"\"Computes a single binomial coefficient C(n,k) exactly.\"\"\"\n    def __init__(self, n, k):\n        self.n = n\n        self.k = k\n        self.value = 0\n\n    def computeValue(self):\n        \"\"\"Calculates C(n,k) using math.comb.\"\"\"\n        self.value = math.comb(self.n, self.k)\n        return self.value\n\nclass Result:\n    \"\"\"A simple container for the integer sum.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\ndef even_binomial_Coeff_Sum(n):\n    \"\"\"\n    Finds the sum of even index binomial coefficients C(n, k) for 0 <= k <= n.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.validate():\n        raise ValueError(\"n must be a non-negative integer\") # Adjusted error message to match InputParameter.validate logic\n\n    total_sum = 0\n    for k in range(0, n + 1, 2):\n        binomial_coeff = BinomialCoefficient(n, k)\n        total_sum += binomial_coeff.computeValue()\n\n    result_obj = Result(total_sum)\n    return result_obj.value"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple):\n    \"\"\"Accepts a single argument (expected tuple). Returns int count of elements before first top-level tuple element. Raises TypeError if input is not a tuple.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for i, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return i\n    return 0"}
{"task_id": "Mbpp/281", "solution": "def all_unique(list_arg):\n    \"\"\"Checks if all elements in the given list are unique, handling both hashable and unhashable types.\"\"\"\n    if not list_arg:\n        return True\n\n    try:\n        # Attempt O(N) check using a set for hashable elements.\n        return len(set(list_arg)) == len(list_arg)\n    except TypeError:\n        # Fallback to O(N^2) pairwise comparison for unhashable elements.\n        for i in range(len(list_arg)):\n            for j in range(i + 1, len(list_arg)):\n                if list_arg[i] == list_arg[j]:\n                    return False\n        return True"}
{"task_id": "Mbpp/277", "solution": "def filterCriterion(value, n):\n    \"\"\"\n    Helper function to check if a numeric value is greater than or equal to n.\n    Returns True if value >= n, False otherwise.\n    \"\"\"\n    return value >= n\n\ndef dict_filter(input_dict, n):\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n    Returns a new dictionary without modifying the input dictionary.\n    \"\"\"\n    filtered_dict = {}\n    for key, value in input_dict.items():\n        if filterCriterion(value, n):\n            filtered_dict[key] = value\n    return filtered_dict"}
{"task_id": "Mbpp/284", "solution": "def check_element(lst, element):\n    \"\"\"\n    Checks if all items in the given list are equal to the specified element.\n    Returns True if all items match, False otherwise.\n    \"\"\"\n    for item in lst:\n        if item != element:\n            return False\n    return True"}
