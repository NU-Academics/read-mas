{"task_id": "Mbpp/597", "solution": "from typing import List, Any\n\nclass SortedArray:\n    \"\"\"Wrapper for a list of integers with sortedness check.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n        self.length = len(values)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Returns True if values are in non-decreasing order.\"\"\"\n        if self.length <= 1:\n            return True\n        for i in range(self.length - 1):\n            if self.values[i] > self.values[i+1]:\n                return False\n        return True\n\nclass KthQuery:\n    \"\"\"Represents a query for the kth element and handles input validation.\"\"\"\n    def __init__(self, A: SortedArray, B: SortedArray, k: int) -> None:\n        self.A = A\n        self.B = B\n        self.k = k\n\n    def validate(self) -> None:\n        \"\"\"Validates arrays are sorted and k is in range. Raises ValueError or IndexError.\"\"\"\n        if not self.A.is_sorted() or not self.B.is_sorted():\n            raise ValueError(\"Input arrays must be sorted in non-decreasing order.\")\n        \n        total_length = self.A.length + self.B.length\n        if not isinstance(self.k, int) or not (1 <= self.k <= total_length):\n            raise IndexError(f\"k must be an integer between 1 and {total_length}, inclusive.\")\n\nclass KthFinder:\n    \"\"\"Contains algorithms to find the kth element from two sorted arrays.\"\"\"\n    def find_kth(self, A: SortedArray, B: SortedArray, k: int) -> int:\n        \"\"\"Public entry for computing the kth smallest element.\"\"\"\n        if A.length == 0 or B.length == 0:\n            return self._find_kth_merge_simulation(A, B, k)\n        return self._find_kth_binary_search(A, B, k)\n\n    def _find_kth_binary_search(self, A: SortedArray, B: SortedArray, k: int) -> int:\n        \"\"\"Efficient partition/binary-search algorithm for finding the kth element.\"\"\"\n        # Ensure A is the shorter array for binary search efficiency.\n        if A.length > B.length:\n            A, B = B, A\n\n        m, n = A.length, B.length\n        \n        # Binary search for 'part_a', the number of elements taken from array A\n        # 'part_a' can range from max(0, k - n) to min(k, m)\n        low = max(0, k - n)\n        high = min(k, m)\n\n        while low <= high:\n            part_a = (low + high) // 2\n            part_b = k - part_a\n\n            max_left_a = A.values[part_a - 1] if part_a > 0 else float('-inf')\n            min_right_a = A.values[part_a] if part_a < m else float('inf')\n            max_left_b = B.values[part_b - 1] if part_b > 0 else float('-inf')\n            min_right_b = B.values[part_b] if part_b < n else float('inf')\n\n            if max_left_a <= min_right_b and max_left_b <= min_right_a:\n                # Correct partition found\n                return max(max_left_a, max_left_b)\n            elif max_left_a > min_right_b:\n                # part_a is too large, need to take fewer elements from A\n                high = part_a - 1\n            else: # max_left_b > min_right_a\n                # part_a is too small, need to take more elements from A\n                low = part_a + 1\n        \n        # This part should ideally not be reached if k is always within valid bounds\n        raise Exception(\"Should not reach here - k-th element not found (internal error).\")\n\n\n    def _find_kth_merge_simulation(self, A: SortedArray, B: SortedArray, k: int) -> int:\n        \"\"\"Linear merge-count fallback for finding the kth element, especially for empty arrays.\"\"\"\n        ptr_a, ptr_b = 0, 0\n        kth_element = -1 \n        \n        for _ in range(k):\n            if ptr_a < A.length and ptr_b < B.length:\n                if A.values[ptr_a] <= B.values[ptr_b]:\n                    kth_element = A.values[ptr_a]\n                    ptr_a += 1\n                else:\n                    kth_element = B.values[ptr_b]\n                    ptr_b += 1\n            elif ptr_a < A.length:\n                kth_element = A.values[ptr_a]\n                ptr_a += 1\n            elif ptr_b < B.length:\n                kth_element = B.values[ptr_b]\n                ptr_b += 1\n            # No else case needed, as k is guaranteed to be within bounds by validation.\n        return kth_element\n\nclass Result:\n    \"\"\"Simple container for the computed result value.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\ndef find_kth(A: List[int], B: List[int], k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays.\n    Validates inputs for sortedness and k's range, then delegates to an efficient finder.\n    \"\"\"\n    sortedA = SortedArray(A)\n    sortedB = SortedArray(B)\n\n    query = KthQuery(sortedA, sortedB, k)\n    query.validate() # Raises ValueError or IndexError on invalid inputs\n\n    finder = KthFinder()\n    value = finder.find_kth(sortedA, sortedB, k)\n\n    result = Result(value)\n    return result.value"}
{"task_id": "Mbpp/598", "solution": "class Number:\n    \"\"\"Represents an integer value and provides methods to extract its digits and count them.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digit_count(self) -> int:\n        \"\"\"Returns the number of decimal digits in the Number's value.\"\"\"\n        if self.value == 0:\n            return 1\n        return len(str(self.value))\n\n    def extract_digits(self) -> list[int]:\n        \"\"\"Extracts the decimal digits of the Number's value into a list.\"\"\"\n        if self.value == 0:\n            return [0]\n        return [int(d) for d in str(self.value)]\n\nclass ArmstrongChecker:\n    \"\"\"Provides methods to compute the powered-digit sum and check the Armstrong property.\"\"\"\n    def compute_sum(self, n: Number) -> int:\n        \"\"\"Computes the sum of each digit raised to the power of the total digit count.\"\"\"\n        k = n.digit_count()\n        digits = n.extract_digits()\n        computed_sum = 0\n        for digit in digits:\n            computed_sum += digit ** k\n        return computed_sum\n\n    def is_armstrong(self, n: Number) -> bool:\n        \"\"\"Determines if the given Number is an Armstrong number.\"\"\"\n        return self.compute_sum(n) == n.value\n\nclass Result:\n    \"\"\"A simple value holder for the boolean outcome of an Armstrong check.\"\"\"\n    def __init__(self, is_armstrong: bool):\n        self.is_armstrong = is_armstrong\n\ndef armstrong_number(n) -> bool:\n    \"\"\"\n    Checks whether the given number is an Armstrong number.\n    Raises TypeError if input is not an integer, ValueError if negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    num = Number(n)\n    checker = ArmstrongChecker()\n    return checker.is_armstrong(num)"}
{"task_id": "Mbpp/600", "solution": "class EvenChecker:\n    def is_Even(self, n) -> bool:\n        \"\"\"Return True if n is an even integer, False if odd.\"\"\"\n        return (int(n) % 2 == 0)\n\ndef is_Even(n) -> bool:\n    \"\"\"Public API. Accepts single argument n and returns boolean parity.\n    Delegates to EvenChecker.is_Even(n).\"\"\"\n    checker = EvenChecker()\n    return checker.is_Even(n)"}
{"task_id": "Mbpp/599", "solution": "class InputValidator:\n    \"\"\"Stateless utility to validate if n is a positive integer.\"\"\"\n    @staticmethod\n    def validate(n) -> bool:\n        \"\"\"Returns True if n is a positive integer, otherwise False.\"\"\"\n        return isinstance(n, int) and n > 0\n\nclass Result:\n    \"\"\"Immutable data carrier for sum and average.\"\"\"\n    def __init__(self, sum: int, average: float):\n        self.sum = sum\n        self.average = average\n\nclass SumAverageFunction:\n    \"\"\"Encapsulates the computation of sum and average for first n natural numbers.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def compute(self) -> (int, float):\n        \"\"\"Computes the sum and average of numbers from 1 to n.\"\"\"\n        # Sum of first n natural numbers: n * (n + 1) / 2\n        total_sum = self.n * (self.n + 1) // 2\n        # Average is sum / n\n        avg = total_sum / self.n\n        return (total_sum, avg)\n\ndef sum_average(n) -> (int, float):\n    \"\"\"\n    Finds the sum and average of the first n natural numbers.\n\n    Validates input n, computes the sum and average, and returns them as a tuple.\n    \"\"\"\n    if not InputValidator.validate(n):\n        raise ValueError(\"n must be a positive integer\")\n\n    computer = SumAverageFunction(n)\n    total_sum, avg = computer.compute()\n\n    return (total_sum, avg)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"Return the earliest character from s that appears again later in s.\n\n    If no repeated character exists, the function returns None.\n    \"\"\"\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/604", "solution": "class InputString:\n    \"\"\"Represents the incoming string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass Word:\n    \"\"\"Represents a single word token.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\nclass WordList:\n    \"\"\"Holds an ordered list of Word objects and provides split and reverse operations.\"\"\"\n    def __init__(self) -> None:\n        self.words: list[Word] = []\n\n    def split(self, input: InputString) -> None:\n        \"\"\"Populates self.words by splitting input.value on ASCII space (0x20).\"\"\"\n        tokens = input.value.split(' ')\n        self.words = [Word(token) for token in tokens]\n\n    def reverse(self) -> None:\n        \"\"\"Reverses the order of Word entries in self.words in place.\"\"\"\n        self.words.reverse()\n\n    def to_list_of_texts(self) -> list[str]:\n        \"\"\"Returns a list of the text content from the Word objects.\"\"\"\n        return [w.text for w in self.words]\n\nclass OutputString:\n    \"\"\"Represents the resulting output string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\ndef reverse_words(input: str) -> str:\n    \"\"\"\n    Reverses the order of words in a given string, separated by spaces.\n    Consecutive spaces and leading/trailing spaces lead to empty words that are preserved.\n    \"\"\"\n    input_str_obj = InputString(input)\n    word_list_obj = WordList()\n    word_list_obj.split(input_str_obj)\n    word_list_obj.reverse()\n    reversed_texts = word_list_obj.to_list_of_texts()\n    output_value = ' '.join(reversed_texts)\n    output_str_obj = OutputString(output_value)\n    return output_str_obj.value"}
{"task_id": "Mbpp/603", "solution": "from typing import List\n\nclass InputParameter:\n    def __init__(self, n: int):\n        self.n: int = n\n    \n    def is_valid(self) -> bool:\n        \"\"\"\n        Validates if n is an integer.\n        Returns True for integers, including those less than 1.\n        \"\"\"\n        return isinstance(self.n, int)\n\nclass LudicNumberList:\n    def __init__(self, numbers: List[int]):\n        self._numbers: List[int] = numbers\n        \n    def sort_ascending(self) -> None:\n        \"\"\"Sorts the numbers in ascending order and removes duplicates.\"\"\"\n        self._numbers = sorted(list(set(self._numbers)))\n        \n    def contains(self, value: int) -> bool:\n        return value in self._numbers\n\nclass LudicGenerator:\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"\n        Computes ludic numbers up to n using a sieve method.\n        Returns an ordered list of unique ludic numbers.\n        \"\"\"\n        if n < 1:\n            return []\n        \n        raw_ludic_numbers = self._apply_sieve(n)\n        ludic_list = LudicNumberList(raw_ludic_numbers)\n        ludic_list.sort_ascending() # Ensures order and uniqueness.\n        return ludic_list._numbers\n\n    def _apply_sieve(self, limit: int) -> List[int]:\n        \"\"\"Internal ludic sieve implementation.\"\"\"\n        candidates = list(range(1, limit + 1))\n        ludics = []\n        \n        while candidates:\n            ludic_num = candidates.pop(0)\n            ludics.append(ludic_num)\n            \n            if ludic_num == 1:\n                continue\n\n            # Build a new list of candidates, skipping elements at 'ludic_num' intervals\n            new_candidates = []\n            for i in range(len(candidates)):\n                # If the (i+1)-th element (1-indexed) in the current candidates list is NOT\n                # a multiple of ludic_num, it is kept.\n                if (i + 1) % ludic_num != 0:\n                    new_candidates.append(candidates[i])\n            candidates = new_candidates\n            \n        return ludics\n\ndef get_ludic(n):\n    \"\"\"Public API: returns list of ludic numbers <= n.\"\"\"\n    param = InputParameter(n)\n    \n    if not param.is_valid():\n        # Non-integer behavior is unspecified in SRS; raising TypeError.\n        raise TypeError(\"n must be an integer\")\n    \n    # Per SRS BR8, if n < 1 (e.g., 0, -5), return an empty list.\n    if n < 1:\n        return []\n        \n    generator = LudicGenerator()\n    numbers = generator.get_ludic(n)\n    return numbers"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Module-private helper implementing a deterministic primality test for n >= 2.\"\"\"\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    limit = int(math.sqrt(n))\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_num(n: int) -> bool:\n    \"\"\"Checks if the given integer is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    \n    return _is_prime(n)"}
