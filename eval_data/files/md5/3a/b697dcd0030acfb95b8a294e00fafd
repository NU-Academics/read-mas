{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in `numbers` are closer than `threshold`.\n\n    The function first sorts the list and then compares each\n    consecutive pair, which is sufficient because the smallest\n    distance in a set of numbers must occur between adjacent numbers\n    in sorted order.\n\n    Parameters\n    ----------\n    numbers : List[float]\n        The list of numbers to check.\n    threshold : float\n        The threshold distance. If any two numbers are strictly less\n        than this distance apart, the function returns ``True``.\n        If ``threshold`` is negative, it is treated as ``0`` because\n        distances cannot be negative.\n\n    Returns\n    -------\n    bool\n        ``True`` if any two distinct numbers are closer than\n        ``threshold``; otherwise ``False``.\n\n    Examples\n    --------\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Ensure threshold is non\u2011negative\n    threshold = max(0.0, float(threshold))\n\n    sorted_numbers = sorted(numbers)\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] - sorted_numbers[i - 1] < threshold:\n            return True\n    return False\n"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separate balanced parenthesis groups from a string.\n\n    Parameters\n    ----------\n    paren_string : str\n        A string that may contain nested and separate groups of\n        parentheses interleaved with arbitrary whitespace.\n\n    Returns\n    -------\n    List[str]\n        A list of the top\u2011level balanced parenthesis substrings, in\n        the order they appear.\n\n    Examples\n    --------\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n\n    \"\"\"\n    # Remove all whitespace to simplify processing.\n    cleaned = ''.join(paren_string.split())\n    groups: List[str] = []\n    depth = 0\n    start_index: int | None = None\n\n    for idx, char in enumerate(cleaned):\n        if char == '(':\n            depth += 1\n            if depth == 1:\n                start_index = idx\n        elif char == ')':\n            depth -= 1\n            if depth < 0:\n                raise ValueError(f\"Unmatched closing parenthesis at position {idx}\")\n            if depth == 0 and start_index is not None:\n                groups.append(cleaned[start_index:idx + 1])\n                start_index = None\n\n    if depth != 0:\n        error_pos = f\" starting at position {start_index}\" if start_index is not None else \"\"\n        raise ValueError(f\"Unmatched opening parenthesis{error_pos}\")\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and\n    decimals (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Number must be non-negative\")\n    return number - math.floor(number)"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Determine whether a bank account balance ever falls below zero.\n\n    The account starts at a balance of zero.  Each integer in *operations*\n    represents a deposit (positive value) or a withdrawal (negative value).\n    If the balance becomes negative at any point, the function returns\n    ``True``; otherwise it returns ``False``.\n\n    Parameters\n    ----------\n    operations : List[int]\n        List of integers representing deposit and withdrawal amounts.\n\n    Returns\n    -------\n    bool\n        ``True`` if the running balance ever drops below zero, otherwise\n        ``False``.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False\n\n# Example usage and simple tests\nif __name__ == \"__main__\":\n    assert below_zero([1, 2, 3]) is False\n    assert below_zero([1, 2, -4, 5]) is True\n    assert below_zero([]) is False\n    print(\"All tests passed.\")"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculate the Mean Absolute Deviation (MAD) of a list of numbers.\n\n    The MAD is defined as the average absolute difference between each\n    element and the mean of the dataset.\n\n    Parameters\n    ----------\n    numbers : list of float\n        The input dataset.\n\n    Returns\n    -------\n    float\n        The mean absolute deviation of the dataset.\n\n    Raises\n    ------\n    ValueError\n        If ``numbers`` is empty.\n\n    Examples\n    --------\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"mean_absolute_deviation requires at least one number\")\n\n    mean = sum(numbers) / len(numbers)\n    total_deviation = sum(abs(x - mean) for x in numbers)\n    return total_deviation / len(numbers)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number `delimeter` between every two consecutive elements of input list `numbers`.\"\"\"\n    if not numbers:\n        return []\n    result = []\n    for i, num in enumerate(numbers[:-1]):\n        result.extend([num, delimeter])\n    result.append(numbers[-1])\n    return result\n"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    For each group of parentheses in `paren_string`, compute the maximum depth of nested\n    parentheses. Groups are separated by whitespace.\n\n    Parameters\n    ----------\n    paren_string : str\n        A whitespace-separated string of parenthesis groups, e.g.\n        '(()()) ((())) () ((())()())'.\n\n    Returns\n    -------\n    List[int]\n        A list containing the maximum depth for each group, in the same order.\n\n    Notes\n    -----\n    * If a group is empty or contains no parentheses, its depth is reported as 0.\n    * Mismatched parentheses that would cause a negative depth are ignored by\n      resetting the depth to 0 when it becomes negative. This treats the group\n      as though any unmatched closing brackets did not contribute to depth.\n    \"\"\"\n    depths: List[int] = []\n\n    for group in paren_string.split():\n        current_depth = 0\n        max_depth = 0\n\n        for char in group:\n            if char == \"(\":\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == \")\":\n                current_depth -= 1\n                if current_depth < 0:\n                    # Ignore unmatched closing parentheses\n                    current_depth = 0\n\n        depths.append(max_depth)\n\n    return depths\n"}
