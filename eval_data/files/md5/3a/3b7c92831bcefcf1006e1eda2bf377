{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    # Return False if the list has fewer than two elements, as no distinct pairs can exist.\n    if n < 2:\n        return False\n\n    # Iterate through all possible distinct pairs (l[i], l[j]) where i < j.\n    for i in range(n):\n        for j in range(i + 1, n):\n            # If a pair sums to zero, return True immediately.\n            if l[i] + l[j] == 0:\n                return True\n    \n    # If no zero-sum pair is found after checking all combinations, return False.\n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    # Return False immediately if the list has fewer than two elements.\n    if len(l) < 2:\n        return False\n\n    # Iterate through all distinct pairs to find if their sum is zero.\n    for i in range(len(l)):\n        for j in range(i + 1, len(l)): # Ensures elements are distinct by position\n            if l[i] + l[j] == 0:\n                return True\n    \n    # No pair summing to zero was found after checking all combinations.\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to the specified base.\n    Returns the string representation after conversion; target bases are less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    negative = x < 0\n    x = abs(x)\n\n    result = \"\"\n    while x > 0:\n        remainder = x % base\n        result = str(remainder) + result\n        x = x // base\n\n    return \"-\" + result if negative else result"}
