{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Returns True if the last character of the given string is an alphabetical\n    character and is not part of a word, and False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    if txt[-1] == ' ':\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # A character is standalone if it's preceded by a space.\n    # If the string has only one character, it cannot be preceded by a space.\n    if len(txt) == 1:\n        return False\n\n    if txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n\n    Examples:\n    check_if_last_char_is_a_letter(\"apple pie\") \u279e False\n    check_if_last_char_is_a_letter(\"apple pi e\") \u279e True\n    check_if_last_char_is_a_letter(\"apple pi e \") \u279e False\n    check_if_last_char_is_a_letter(\"\") \u279e False\n    \"\"\"\n    if not txt:\n        return False\n\n    if txt.endswith(' '):\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # A character is standalone if it's the first character or preceded by a space.\n    # For the last character, this means it's the only character or txt[-2] is a space.\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1.\n    \"\"\"\n    last_violation_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            last_violation_index = i\n    return last_violation_index"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Finds the largest index where an element is less than its predecessor.\n    Returns -1 if all elements are in non-decreasing order.\"\"\"\n    \n    largest_violating_index = -1\n    \n    # Iterate from the second element to compare with its predecessor\n    for i in range(1, len(arr)):\n        # Check if the current element is not greater than or equal to its predecessor\n        if arr[i] < arr[i-1]:\n            largest_violating_index = i\n            \n    return largest_violating_index"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list. If there is no negative or positive integers, return them as None.\n    '''\n    negatives = []\n    positives = []\n\n    for num in lst:\n        if num < 0:\n            negatives.append(num)\n        elif num > 0:\n            positives.append(num)\n\n    largest_neg = max(negatives) if negatives else None\n    smallest_pos = min(positives) if positives else None\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "def normalize_decimal_separator(value: str) -> str:\n    \"\"\"Converts comma decimal separators to dot format for string values.\"\"\"\n    return value.replace(',', '.')\ndef convert_to_numeric(value) -> float:\n    \"\"\"Converts a value to its float representation for comparison.\"\"\"\n    if type(value) is str:\n        value = normalize_decimal_separator(value)\n    return float(value)\ndef preserve_original_type(numeric_value: float, original_value) -> Union[int, float, str]:\n    \"\"\"Returns the numeric value in its original input type.\"\"\"\n    if type(original_value) is int:\n        return int(numeric_value)\n    elif type(original_value) is float:\n        return float(numeric_value)\n    else: # type(original_value) is str\n        # For string originals, return the original string itself as per requirement.\n        return original_value\ndef compare_one(a, b) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two numeric values of mixed types and returns the larger in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    from typing import Union\n\n    a_numeric = convert_to_numeric(a)\n    b_numeric = convert_to_numeric(b)\n\n    if a_numeric == b_numeric:\n        return None\n    elif a_numeric > b_numeric:\n        return preserve_original_type(a_numeric, a)\n    else: # b_numeric > a_numeric\n        return preserve_original_type(b_numeric, b)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numeric values, returning the larger in its original type,\n    or None if they are numerically equal. Handles various input types and decimal separators.\n    \"\"\"\n\n    def _normalize_decimal_separator(value: str) -> str:\n        \"\"\"Replaces comma decimal separators with dots for consistent parsing.\"\"\"\n        return value.replace(',', '.')\n\n    def _parse_numeric_string(value: str) -> float:\n        \"\"\"Converts a string representation of a number to a float.\"\"\"\n        return float(value)\n\n    def _convert_to_numeric(value) -> float:\n        \"\"\"Converts any supported input type (int, float, str) to its float representation.\"\"\"\n        string_representation = str(value)\n        normalized_string = _normalize_decimal_separator(string_representation)\n        return _parse_numeric_string(normalized_string)\n\n    original_a = a\n    original_b = b\n\n    numeric_a = _convert_to_numeric(original_a)\n    numeric_b = _convert_to_numeric(original_b)\n\n    if numeric_a == numeric_b:\n        return None\n    elif numeric_a > numeric_b:\n        return original_a\n    else:\n        return original_b"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if n < 8:\n        return False\n    \n    if n % 2 != 0:\n        return False\n        \n    return True"}
{"task_id": "HumanEval/136", "solution": "from typing import List, Tuple, Optional\ndef _find_largest_negative(negatives: List[int]) -> Optional[int]:\n    \"\"\"Finds the largest (closest to zero) negative integer in a list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not negatives:\n        return None\n    return max(negatives)\ndef _find_smallest_positive(positives: List[int]) -> Optional[int]:\n    \"\"\"Finds the smallest (closest to zero) positive integer in a list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not positives:\n        return None\n    return min(positives)\ndef largest_smallest_integers(lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Identifies the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), or None for missing types.\n    \"\"\"\n    negatives_list = []\n    positives_list = []\n\n    for num in lst:\n        if num < 0:\n            negatives_list.append(num)\n        elif num > 0:\n            positives_list.append(num)\n\n    largest_neg = _find_largest_negative(negatives_list)\n    smallest_pos = _find_smallest_positive(positives_list)\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as n! * (n-1)! * ... * 1! for n > 0.\n    For example, special_factorial(4) returns 288.\n    \"\"\"\n    special_factorial_product = 1\n\n    # Iterate from n down to 1\n    for k in range(n, 0, -1):\n        # Calculate the standard factorial k!\n        current_factorial = 1\n        for i in range(1, k + 1):\n            current_factorial *= i\n\n        # Multiply this factorial into the running product\n        special_factorial_product *= current_factorial\n\n    return special_factorial_product"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as: brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1! where n > 0.\n    The function will receive an integer as input and should return the special factorial of this integer.\"\"\"\n\n    def _calculate_factorial(num):\n        \"\"\"Calculates the standard factorial of a positive integer.\n        Assumes a positive integer input and computes its factorial.\"\"\"\n        fact = 1\n        for i in range(1, num + 1):\n            fact *= i\n        return fact\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        current_factorial = _calculate_factorial(i)\n        special_fact_result *= current_factorial\n        \n    return special_fact_result"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    The minimum sum of four positive even numbers is 8, and the sum must always be an even number.\n    \"\"\"\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # Replace sequences of 3 or more spaces with a single dash first.\n    # This prevents them from being replaced by underscores individually.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with an underscore.\n    # These are spaces that were not part of a 3+ consecutive sequence.\n    final_text = re.sub(r' ', '_', processed_text)\n\n    return final_text"}
{"task_id": "HumanEval/141", "solution": "def validate_digit_count(file_name: str) -> bool:\n    \"\"\"Validates if the file name has at most three digits.\"\"\"\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    return digit_count <= 3\ndef validate_dot_presence(file_name: str) -> bool:\n    \"\"\"Validates if the file name contains exactly one dot.\"\"\"\n    return file_name.count('.') == 1\ndef validate_prefix(file_name: str) -> bool:\n    \"\"\"Validates the prefix: non-empty and starts with a latin letter.\"\"\"\n    # This validator assumes a dot might not be present if called standalone.\n    if '.' not in file_name:\n        return False\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    return bool(prefix) and prefix[0].isalpha()\ndef validate_extension(file_name: str) -> bool:\n    \"\"\"Validates if the extension is one of 'txt', 'exe', 'dll'.\"\"\"\n    # This validator assumes a dot might not be present if called standalone.\n    if '.' not in file_name:\n        return False\n    parts = file_name.split('.', 1)\n    if len(parts) < 2: # This covers cases like \"example.\" where there's no extension\n        return False\n    extension = parts[1]\n    return extension in ['txt', 'exe', 'dll']\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n    # Orchestrates multiple validator functions to determine file name validity.\n    if not validate_dot_presence(file_name):\n        return 'No'\n    \n    is_digit_count_valid = validate_digit_count(file_name)\n    is_prefix_valid = validate_prefix(file_name)\n    is_extension_valid = validate_extension(file_name)\n    \n    if is_digit_count_valid and is_prefix_valid and is_extension_valid:\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/141", "solution": "VALID_EXTENSIONS = ['txt', 'exe', 'dll']\nMAX_DIGITS = 3\ndef _count_digits(file_name: str) -> int:\n    \"\"\"Counts the number of digit characters in a file name.\"\"\"\n    return sum(1 for char in file_name if char.isdigit())\ndef _validate_dot_count(file_name: str) -> bool:\n    \"\"\"Checks if the file name contains exactly one dot separator.\"\"\"\n    return file_name.count('.') == 1\ndef _validate_prefix(prefix: str) -> bool:\n    \"\"\"Validates if the prefix is non-empty and starts with a latin alphabet letter.\"\"\"\n    return bool(prefix) and prefix[0].isalpha()\ndef _validate_extension(extension: str) -> bool:\n    \"\"\"Checks if the file extension is one of the allowed types.\"\"\"\n    return extension in VALID_EXTENSIONS\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Validates a file name according to specific business rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    if not _validate_dot_count(file_name):\n        return 'No'\n\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    if not _validate_prefix(prefix):\n        return 'No'\n\n    if not _validate_extension(extension):\n        return 'No'\n\n    if _count_digits(file_name) > MAX_DIGITS:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replace spaces in text according to transformation rules.\n    Single spaces become underscores; 3+ consecutive spaces become a single dash.\n    \"\"\"\n    result = []\n    space_count = 0\n\n    for char in text:\n        if char == ' ':\n            space_count += 1\n        else:\n            if space_count == 1:\n                result.append('_')\n            elif space_count == 2:\n                result.append('__')\n            elif space_count >= 3:\n                result.append('-')\n            space_count = 0\n            result.append(char)\n\n    # Handle any trailing spaces at the end of the string\n    if space_count == 1:\n        result.append('_')\n    elif space_count == 2:\n        result.append('__')\n    elif space_count >= 3:\n        result.append('-')\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/142", "solution": "def _is_multiple_of_three(index: int) -> bool:\n    \"\"\"Determines if an index is a multiple of 3.\"\"\"\n    return index % 3 == 0\ndef _is_multiple_of_four(index: int) -> bool:\n    \"\"\"Determines if an index is a multiple of 4.\"\"\"\n    return index % 4 == 0\ndef _square(value: int) -> int:\n    \"\"\"Squares an integer value.\"\"\"\n    return value * value\ndef _cube(value: int) -> int:\n    \"\"\"Cubes an integer value.\"\"\"\n    return value * value * value\ndef _transform_value(value: int, index: int) -> int:\n    \"\"\"Applies transformation rules based on index to a value.\n    It squares values at indices multiple of 3, and cubes values at indices multiple of 4 but not 3.\"\"\"\n    if _is_multiple_of_three(index):\n        return _square(value)\n    elif _is_multiple_of_four(index):\n        return _cube(value)\n    else:\n        return value\ndef sum_squares(lst: list) -> int:\n    \"\"\"\n    This function processes a list of integers, applying transformations based on index, and returns their sum.\n    It squares entries whose index is a multiple of 3 and cubes entries whose index is a multiple of 4 (but not 3).\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        transformed_value = _transform_value(value, index)\n        total_sum += transformed_value\n\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Processes integer lists based on index-specific rules (square if index % 3 == 0, cube if index % 4 == 0 and not index % 3 == 0).\n    Returns the sum of all processed entries, handling empty lists by returning 0.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        processed_value = value\n        if index % 3 == 0:\n            processed_value = value * value\n        elif index % 4 == 0:\n            processed_value = value * value * value\n        \n        total_sum += processed_value\n        \n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def validate_input(sentence: str) -> bool:\n    \"\"\"\n    Validates input sentence meets constraints.\n    Per requirements, trusts caller's input so always returns True.\n    \"\"\"\n    return True\ndef split_into_words(sentence: str) -> list[str]:\n    \"\"\"\n    Splits sentence into individual words by spaces.\n    Returns a list of words from the sentence.\n    \"\"\"\n    return sentence.split(' ')\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a number is prime.\n    Checks divisibility up to its square root for efficiency.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef filter_prime_words(words: list[str]) -> list[str]:\n    \"\"\"\n    Filters words, keeping only those with prime lengths.\n    Maintains the original order of words.\n    \"\"\"\n    filtered = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered.append(word)\n    return filtered\ndef format_result(filtered_words: list[str]) -> str:\n    \"\"\"\n    Formats filtered words into a space-separated output string.\n    Returns an empty string if no words are present.\n    \"\"\"\n    return \" \".join(filtered_words)\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence based on prime number lengths.\n    Orchestrates validation, splitting, filtering, and formatting.\n    \"\"\"\n    # Validate input (validation function always returns True per critical requirements)\n    _ = validate_input(sentence) # Call validate_input as per design, but its return value is trusted\n\n    words = split_into_words(sentence)\n    prime_length_words = filter_prime_words(words)\n    result = format_result(prime_length_words)\n    return result"}
{"task_id": "HumanEval/143", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given number is prime.\n    Uses an optimized algorithm for checking primality.\n    \"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef split_into_words(sentence: str) -> list[str]:\n    \"\"\"\n    Splits a sentence string into a list of individual words.\n    Words are separated by spaces.\n    \"\"\"\n    return sentence.split(' ')\ndef filter_prime_words(words: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of words, keeping only those with prime character lengths.\n    It utilizes the is_prime helper function.\n    \"\"\"\n    # is_prime is defined in the same code block per requirements.\n    return [word for word in words if is_prime(len(word))]\ndef join_words(words: list[str]) -> str:\n    \"\"\"\n    Joins a list of words into a single space-separated string.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    return ' '.join(words)\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n    # Per CRITICAL REQUIREMENT: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\n    # Trust the caller's inputs and implement the simplest, most direct logic possible.\"\n    # Input validation is therefore omitted in this implementation.\n    \n    words = split_into_words(sentence)\n    prime_length_words = filter_prime_words(words)\n    result = join_words(prime_length_words)\n    return result"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Determines if the multiplication of two string-represented fractions results in a whole number.\n    It processes positive integer numerators and non-zero denominators.\n    \"\"\"\n\n    def parse_fraction(fraction_str: str) -> tuple[int, int]:\n        \"\"\"Parses a string fraction format into numerator and denominator integers.\"\"\"\n        numerator_str, denominator_str = fraction_str.split('/')\n        return int(numerator_str), int(denominator_str)\n\n    def multiply_fractions(f1: tuple[int, int], f2: tuple[int, int]) -> tuple[int, int]:\n        \"\"\"Multiplies two fractions represented as (numerator, denominator) tuples.\"\"\"\n        num1, den1 = f1\n        num2, den2 = f2\n        return num1 * num2, den1 * den2\n\n    def is_whole_number(fraction: tuple[int, int]) -> bool:\n        \"\"\"Checks if a fraction represents a whole number by testing for even divisibility.\"\"\"\n        numerator, denominator = fraction\n        return numerator % denominator == 0\n\n    fraction1 = parse_fraction(x)\n    fraction2 = parse_fraction(n)\n    product_fraction = multiply_fractions(fraction1, fraction2)\n    return is_whole_number(product_fraction)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Determines if the multiplication of two string-represented fractions results in a whole number.\n    It orchestrates parsing, multiplication, and evaluation of the fractions.\"\"\"\n\n    def parse_fraction(fraction_str: str) -> tuple[int, int]:\n        \"\"\"Parses a string fraction into its numerator and denominator integers.\"\"\"\n        numerator_str, denominator_str = fraction_str.split('/')\n        return int(numerator_str), int(denominator_str)\n\n    def multiply_fractions(num1: int, den1: int, num2: int, den2: int) -> tuple[int, int]:\n        \"\"\"Multiplies two fractions and returns the resulting numerator and denominator.\"\"\"\n        result_numerator = num1 * num2\n        result_denominator = den1 * den2\n        return result_numerator, result_denominator\n\n    def is_whole_number(numerator: int, denominator: int) -> bool:\n        \"\"\"Checks if a fraction (numerator/denominator) represents a whole number.\"\"\"\n        return numerator % denominator == 0\n\n    num_x, den_x = parse_fraction(x)\n    num_n, den_n = parse_fraction(n)\n\n    result_num, result_den = multiply_fractions(num_x, den_x, num_n, den_n)\n\n    return is_whole_number(result_num, result_den)"}
{"task_id": "HumanEval/145", "solution": "def digit_sum(num: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for a given integer, ignoring its sign.\n    Converts the number to its absolute value and then sums its digits.\n    \"\"\"\n    s = 0\n    num_abs = abs(num)\n    while num_abs > 0:\n        s += num_abs % 10\n        num_abs //= 10\n    return s\ndef order_by_points(nums: list) -> list:\n    \"\"\"\n    Sorts a list of integers by the sum of their digits in ascending order.\n    For numbers with identical digit sums, their original relative order is preserved.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Pair each number with its digit sum and original index for stable sorting.\n    # The key for sorting will be (digit_sum, original_index).\n    augmented_nums = []\n    for index, num in enumerate(nums):\n        sum_of_digits = digit_sum(num)\n        augmented_nums.append((sum_of_digits, index, num))\n\n    # Sort the augmented list. Python's `sorted()` uses Timsort, which is stable.\n    # Sorting tuples will prioritize the first element (digit sum), then the second (original index).\n    sorted_augmented_nums = sorted(augmented_nums)\n\n    # Extract the original numbers from the sorted tuples to form the final result.\n    result = [item[2] for item in sorted_augmented_nums]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def get_absolute_value(number: int) -> int:\n    \"\"\"Returns the absolute value of a given number.\"\"\"\n    return abs(number)\ndef is_odd_digit(digit: int) -> bool:\n    \"\"\"Validates if a single digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit in {1, 3, 5, 7, 9}\ndef extract_last_digit(number: int) -> int:\n    \"\"\"Extracts the last digit from a number's absolute value.\"\"\"\n    # Assumes 'number' is already positive or its absolute value.\n    return number % 10\ndef extract_first_digit(number: int) -> int:\n    \"\"\"Extracts the first digit from a number's absolute value.\"\"\"\n    # Assumes 'number' is already positive. For single-digit numbers, it returns the number itself.\n    while number >= 10:\n        number //= 10\n    return number\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Filters an array of numbers, counting elements greater than 10 with both odd first and last digits.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            abs_num = get_absolute_value(num)\n            first_digit = extract_first_digit(abs_num)\n            last_digit = extract_last_digit(abs_num)\n\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    maintaining original order for items with identical digit sums.\n    \"\"\"\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for a given integer, using its absolute value.\"\"\"\n        s = str(abs(num))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    def _create_sort_key(item: tuple) -> tuple:\n        \"\"\"Generates a sort key (digit_sum, original_index) for stable sorting.\"\"\"\n        # item is expected to be (original_index, number, digit_sum_value)\n        original_index, _, digit_sum_value = item\n        return (digit_sum_value, original_index)\n\n    # Prepare items for sorting: (original_index, number, calculated_digit_sum)\n    items_with_sums = []\n    for i, num in enumerate(nums):\n        calculated_sum = _calculate_digit_sum(num)\n        items_with_sums.append((i, num, calculated_sum))\n\n    # Sort the items using the custom sort key\n    sorted_items = sorted(items_with_sums, key=_create_sort_key)\n\n    # Extract the original numbers from the sorted items\n    result = [item[1] for item in sorted_items]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def is_greater_than_10(num: int) -> bool:\n    \"\"\"Checks if a number is greater than 10.\n    This function implements the FR-002 requirement.\n    \"\"\"\n    return num > 10\ndef get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit from the absolute value of a number.\n    It handles negative numbers and single-digit numbers correctly (FR-008, FR-009).\n    \"\"\"\n    abs_num_str = str(abs(num))\n    return int(abs_num_str[0])\ndef get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit from the absolute value of a number.\n    This function processes both positive and negative numbers (FR-008).\n    \"\"\"\n    return abs(num) % 10\ndef is_odd_digit(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\n    This directly supports the FR-005 requirement.\n    \"\"\"\n    return digit % 2 != 0\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Filters an array of numbers, counting those greater than 10 where\n    both the first and last digits (absolute) are odd.\n    It orchestrates the filtering process by calling several utility functions.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if is_greater_than_10(num):\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) where i < j < k and their sum is divisible by 3.\n    The array a is generated using the formula a[i] = i*i - i + 1.\n    \"\"\"\n\n    def _generate_array(length):\n        \"\"\"Generates an integer array of specified length using the formula.\"\"\"\n        arr = []\n        for i in range(1, length + 1):\n            arr.append(i * i - i + 1)\n        return arr\n\n    def _count_valid_triples(arr_data):\n        \"\"\"Counts triples in the array whose sum is a multiple of 3.\"\"\"\n        count = 0\n        arr_len = len(arr_data)\n        for i in range(arr_len):\n            for j in range(i + 1, arr_len):\n                for k in range(j + 1, arr_len):\n                    if (arr_data[i] + arr_data[j] + arr_data[k]) % 3 == 0:\n                        count += 1\n        return count\n\n    generated_array = _generate_array(n)\n    result_count = _count_valid_triples(generated_array)\n    \n    return result_count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculate maximum number of valid triples from mathematically generated array.\n\n    Args:\n        n (int): Positive integer for array length\n\n    Returns:\n        int: Count of valid triples where sum is divisible by 3\n    \"\"\"\n    arr = []\n    for i_val in range(1, n + 1):\n        arr.append(i_val * i_val - i_val + 1)\n\n    valid_triples_count = 0\n    num_elements = len(arr)\n\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements):\n            for k in range(j + 1, num_elements):\n                current_sum = arr[i] + arr[j] + arr[k]\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\nPLANET_POSITIONS = {planet: i + 1 for i, planet in enumerate(PLANETS)}\ndef _validate_planet(planet: str) -> bool:\n    \"\"\"Validates if planet name is in the solar system.\"\"\"\n    return planet in PLANET_POSITIONS\ndef _get_planets_between(pos1: int, pos2: int) -> list[str]:\n    \"\"\"Gets planets between two 1-based positions, sorted by solar proximity.\"\"\"\n    start_index = min(pos1, pos2)\n    end_index = max(pos1, pos2)\n    # Adjust to 0-based list indices and exclude the boundary planets themselves\n    # The slice goes from (start_index - 1) + 1 to (end_index - 1) exclusive\n    # So, from start_index to end_index - 1\n    return PLANETS[start_index:end_index - 1]\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns planets between two specified planets in solar system order.\n    Returns an empty tuple if either planet name is invalid.\n    \"\"\"\n    if not _validate_planet(planet1) or not _validate_planet(planet2):\n        return ()\n\n    pos1 = PLANET_POSITIONS[planet1]\n    pos2 = PLANET_POSITIONS[planet2]\n\n    between_planets = _get_planets_between(pos1, pos2)\n    return tuple(between_planets)"}
{"task_id": "HumanEval/149", "solution": "from typing import List\ndef sorted_list_sum(lst: List[str]) -> List[str]:\n    \"\"\"Filters strings with odd lengths and returns sorted list of even-length strings.\n    Strings are sorted by length ascending, then alphabetically for equal lengths.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result"}
{"task_id": "HumanEval/148", "solution": "class SolarSystem:\n    \"\"\"Manages solar system data and provides planet position calculations.\"\"\"\n    PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    def __init__(self):\n        # Maps planet names to their fixed orbital index, 0 for Mercury to 7 for Neptune.\n        self.planet_positions = {planet: i for i, planet in enumerate(self.PLANETS)}\n\n    def get_position(self, planet_name: str) -> int:\n        \"\"\"Returns the orbital index for a given planet name.\"\"\"\n        # Returns -1 if the planet name is not found, which the validator handles upstream.\n        return self.planet_positions.get(planet_name, -1)\n\n    def get_planets_in_range(self, pos1: int, pos2: int) -> list:\n        \"\"\"Returns a list of planets strictly between two orbital positions, sorted by proximity to the sun.\"\"\"\n        # Ensure the positions are ordered for correct slicing, handling bidirectional queries.\n        start_index = min(pos1, pos2)\n        end_index = max(pos1, pos2)\n        \n        # Slice the PLANETS tuple, exclusive of the start and end positions.\n        return list(self.PLANETS[start_index + 1 : end_index])\nclass PlanetValidator:\n    \"\"\"Validates planet names against the recognized planets in our solar system.\"\"\"\n    \n    def __init__(self, solar_system_data: SolarSystem):\n        # The valid_planets tuple is derived from the SolarSystem's canonical list.\n        self.valid_planets = solar_system_data.PLANETS\n\n    def is_valid_planet(self, name: str) -> bool:\n        \"\"\"Checks if the given planet name is recognized as a valid planet.\"\"\"\n        return name in self.valid_planets\ndef bf(planet1: str, planet2: str) -> tuple:\n    \"\"\"\n    Identifies planets whose orbits lie between two specified planets, sorted by proximity to the Sun.\n    Returns an empty tuple if any input planet name is invalid.\n    \"\"\"\n    solar_system = SolarSystem()\n    validator = PlanetValidator(solar_system)\n\n    # Validate both planet names. If either is invalid, return an empty tuple.\n    if not validator.is_valid_planet(planet1) or not validator.is_valid_planet(planet2):\n        return ()\n\n    # Get the orbital positions of the two input planets.\n    pos1 = solar_system.get_position(planet1)\n    pos2 = solar_system.get_position(planet2)\n\n    # Retrieve the planets located between these two positions.\n    planets_in_between = solar_system.get_planets_in_range(pos1, pos2)\n\n    # Return the result as a tuple, already sorted by proximity to the Sun.\n    return tuple(planets_in_between)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters strings by even length, then sorts them by length and alphabetically.\"\"\"\n    # Filter out strings that have odd character lengths.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the remaining strings, first by length (ascending), then alphabetically (ascending).\n    sorted_result = sorted(filtered_list, key=lambda x: (len(x), x))\n\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer n is a prime number.\n    It checks for divisibility from 2 up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef select_value(is_prime_result: bool, x, y) -> any:\n    \"\"\"Returns x if is_prime_result is True, otherwise returns y.\"\"\"\n    if is_prime_result:\n        return x\n    else:\n        return y\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    prime_status = is_prime(n)\n    result = select_value(prime_status, x, y)\n    return result"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Checks if a number is prime.\n    It iterates up to the square root of n to find divisors.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is prime, otherwise returns y.\n    This function uses a helper to determine primality.\"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def _is_valid_number(num):\n    \"\"\"\n    Validates if a number meets all criteria (positive, integer, odd).\n    Ignores non-integer types to prevent exceptions during arithmetic operations.\n    \"\"\"\n    if not isinstance(num, int):\n        return False\n    if num <= 0:\n        return False\n    if num % 2 == 0:\n        return False\n    return True\ndef _calculate_square(num):\n    \"\"\"\n    Calculates the square of a validated positive odd integer.\n    Assumes the input 'num' has already passed validation.\n    \"\"\"\n    return num * num\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, returns the sum of squares of positive odd integers.\n    Ignores negative numbers, zero, even numbers, and non-integer types.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n    for item in lst:\n        if _is_valid_number(item):\n            squared_value = _calculate_square(item)\n            total_sum_of_squares += squared_value\n    return total_sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Compares game scores with user guesses, returning the absolute difference for each match.\n    A value of 0 indicates a correct guess, otherwise it's the absolute difference.\n    \"\"\"\n    return [abs(g_score - u_guess) for g_score, u_guess in zip(game, guess)]"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of odd numbers.\n    Numbers must be positive integers; others are ignored.\n    \"\"\"\n    if not lst:\n        return 0\n\n    sum_of_squares = 0\n\n    for num in lst:\n        # Ignore numbers that are negative or are not integer values.\n        # This relies on the input being numeric (int or float) as per \"Trust the caller's inputs\".\n        if num < 0 or num != int(num):\n            continue\n\n        # Process only positive integer odd numbers.\n        if num % 2 == 1:\n            sum_of_squares += num * num\n\n    return sum_of_squares"}
{"task_id": "HumanEval/154", "solution": "def generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all possible cyclic rotations of the input string.\"\"\"\n    if not s:\n        return [\"\"]\n    rotations = []\n    n = len(s)\n    for i in range(n):\n        rotations.append(s[i:] + s[:i])\n    return rotations\ndef check_substring(main_str: str, pattern: str) -> bool:\n    \"\"\"Checks if a pattern string exists as a substring within the main string.\"\"\"\n    return pattern in main_str\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"\n    You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n    \"\"\"\n    \n    rotations_of_b = generate_rotations(b)\n    \n    for rotation in rotations_of_b:\n        if check_substring(a, rotation):\n            return True\n            \n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM formula and returns a formatted string.\"\"\"\n\n    def count_uppercase(text: str) -> int:\n        \"\"\"Counts uppercase alphabetic characters in a string.\"\"\"\n        count = 0\n        for char in text:\n            if char.isalpha() and char.isupper():\n                count += 1\n        return count\n\n    def count_lowercase(text: str) -> int:\n        \"\"\"Counts lowercase alphabetic characters in a string.\"\"\"\n        count = 0\n        for char in text:\n            if char.isalpha() and char.islower():\n                count += 1\n        return count\n\n    def calculate_extension_strength(extension_name: str) -> int:\n        \"\"\"Calculates extension strength using CAP - SM formula.\"\"\"\n        cap_count = count_uppercase(extension_name)\n        sm_count = count_lowercase(extension_name)\n        return cap_count - sm_count\n\n    def find_strongest_extension(extensions: list) -> str:\n        \"\"\"Identifies the extension with the highest strength value.\"\"\"\n        if not extensions:\n            return \"\"\n\n        max_strength = float('-inf')\n        strongest_extension_name = \"\"\n\n        for extension in extensions:\n            current_strength = calculate_extension_strength(extension)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension_name = extension\n        return strongest_extension_name\n\n    def format_result(class_name: str, extension_name: str) -> str:\n        \"\"\"Formats the output string in ClassName.ExtensionName format.\"\"\"\n        return f\"{class_name}.{extension_name}\"\n\n    strongest_ext = find_strongest_extension(extensions)\n    return format_result(class_name, strongest_ext)"}
{"task_id": "HumanEval/153", "solution": "def count_uppercase(text: str) -> int:\n    \"\"\"Counts uppercase letters in text.\"\"\"\n    count = 0\n    for char in text:\n        if char.isupper():\n            count += 1\n    return count\ndef count_lowercase(text: str) -> int:\n    \"\"\"Counts lowercase letters in text.\"\"\"\n    count = 0\n    for char in text:\n        if char.islower():\n            count += 1\n    return count\ndef calculate_strength(extension: str) -> int:\n    \"\"\"Calculates extension strength as CAP - SM.\"\"\"\n    cap_count = count_uppercase(extension)\n    sm_count = count_lowercase(extension)\n    return cap_count - sm_count\ndef find_strongest_extension(extensions: list) -> str:\n    \"\"\"Finds extension with highest strength, handles tie-breaking.\"\"\"\n    strongest_ext = extensions[0]\n    max_strength = calculate_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_ext = extensions[i]\n        current_strength = calculate_strength(current_ext)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext = current_ext\n    return strongest_ext\ndef format_result(class_name: str, strongest_ext: str) -> str:\n    \"\"\"Formats result as 'ClassName.StrongestExtension'.\"\"\"\n    return f\"{class_name}.{strongest_ext}\"\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Main entry point implementing complete algorithm.\"\"\"\n    strongest_ext_name = find_strongest_extension(extensions)\n    return format_result(class_name, strongest_ext_name)"}
{"task_id": "HumanEval/152", "solution": "def _calculate_difference(score: int, guess: int) -> int:\n    \"\"\"Calculates absolute difference between score and guess.\n    Returns 0 for exact matches, else the absolute difference.\n    \"\"\"\n    if score == guess:\n        return 0\n    else:\n        return abs(score - guess)\ndef compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"Determines how far off each guess was compared to the actual score.\n    Returns an array of the same length with absolute differences.\n    \"\"\"\n    result_array = []\n    for i in range(len(game)):\n        score = game[i]\n        prediction = guess[i]\n        diff = _calculate_difference(score, prediction)\n        result_array.append(diff)\n    return result_array"}
{"task_id": "HumanEval/154", "solution": "def is_substring_present(main_str, pattern):\n    \"\"\"Checks if a pattern string exists as a substring within a main string.\n    Performs a case-sensitive substring detection.\"\"\"\n    return pattern in main_str\ndef generate_rotations(s):\n    \"\"\"Generates all possible rotations of the input string s.\n    Returns a list of strings, including the original string.\"\"\"\n    if not s:\n        return [\"\"]\n    rotations = []\n    n = len(s)\n    for i in range(n):\n        rotations.append(s[i:] + s[:i])\n    return rotations\ndef cycpattern_check(a, b):\n    \"\"\"Determines if the second input string or any of its rotations is a substring of the first.\n    It orchestrates rotation generation and substring checking.\"\"\"\n    rotations_b = generate_rotations(b)\n    for rotation in rotations_b:\n        if is_substring_present(a, rotation):\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    The function handles negative integers by ignoring the sign.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Handle negative integers by taking the absolute value and converting to string\n    for digit_char in str(abs(num)):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n\n    def _extract_digits(n: int) -> str:\n        \"\"\"Extracts digits from an integer as a string, ignoring any negative sign.\"\"\"\n        s = str(n)\n        if s.startswith('-'):\n            return s[1:]\n        return s\n\n    def _count_even_digits(digit_string: str) -> int:\n        \"\"\"Counts the occurrences of even digits (0, 2, 4, 6, 8) in a digit string.\"\"\"\n        count = 0\n        for digit_char in digit_string:\n            digit_val = int(digit_char)\n            if digit_val % 2 == 0:\n                count += 1\n        return count\n\n    def _count_odd_digits(digit_string: str) -> int:\n        \"\"\"Counts the occurrences of odd digits (1, 3, 5, 7, 9) in a digit string.\"\"\"\n        count = 0\n        for digit_char in digit_string:\n            digit_val = int(digit_char)\n            if digit_val % 2 != 0:\n                count += 1\n        return count\n\n    digits_as_string = _extract_digits(num)\n    even_count = _count_even_digits(digits_as_string)\n    odd_count = _count_odd_digits(digits_as_string)\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n\n    # --- src/conversion_rules.py components ---\n    _ROMAN_NUMERALS_MAP = {\n        1000: 'M', 900: 'CM', 500: 'D', 400: 'CD', 100: 'C',\n        90: 'XC', 50: 'L', 40: 'XL', 10: 'X', 9: 'IX', 5: 'V',\n        4: 'IV', 1: 'I'\n    }\n\n    def get_conversion_rules():\n        \"\"\"Provides the Roman numeral mapping data.\"\"\"\n        return _ROMAN_NUMERALS_MAP\n\n    # --- src/validator.py components ---\n    def is_in_range(num_to_check: int) -> bool:\n        \"\"\"Checks if the number is within the valid range [1, 1000].\"\"\"\n        return 1 <= num_to_check <= 1000\n\n    def validate_input(num_to_validate: int) -> bool:\n        \"\"\"Validates the input number based on system rules.\"\"\"\n        return is_in_range(num_to_validate)\n\n    # --- src/converter.py components ---\n    def apply_conversion_rules(num_to_convert: int, rules_map: dict) -> str:\n        \"\"\"Applies the Roman numeral conversion rules greedily.\"\"\"\n        roman_numeral_parts = []\n        current_num = num_to_convert\n        \n        # Iterate through rules in descending order of value, as defined in _ROMAN_NUMERALS_MAP.\n        for value, symbol in rules_map.items():\n            while current_num >= value:\n                roman_numeral_parts.append(symbol)\n                current_num -= value\n        return \"\".join(roman_numeral_parts)\n\n    def convert_to_roman(num_to_convert: int) -> str:\n        \"\"\"Converts an integer to its Roman numeral string.\"\"\"\n        rules_data = get_conversion_rules()\n        return apply_conversion_rules(num_to_convert, rules_data)\n\n    # --- src/formatter.py components ---\n    def to_lowercase(roman_str_to_lower: str) -> str:\n        \"\"\"Converts a Roman numeral string to lowercase.\"\"\"\n        return roman_str_to_lower.lower()\n\n    # --- Orchestration (int_to_mini_roman's main logic) ---\n    # Validate input as per design; its boolean result is not used to halt execution.\n    _ = validate_input(number)\n\n    # Convert the number to its uppercase Roman numeral representation.\n    roman_upper = convert_to_roman(number)\n    \n    # Format the Roman numeral string to lowercase.\n    roman_lower = to_lowercase(roman_upper)\n\n    return roman_lower"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, convert it to its lowercase Roman numeral equivalent.\n    The input number is guaranteed to be between 1 and 1000 inclusive.\n    \"\"\"\n    val_to_roman = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n    \n    roman_numeral_parts = []\n    \n    for value, symbol in val_to_roman:\n        while number >= value:\n            roman_numeral_parts.append(symbol)\n            number -= value\n            \n    return \"\".join(roman_numeral_parts).lower()"}
{"task_id": "HumanEval/157", "solution": "def float_equal(a: float, b: float, tolerance: float = 1e-9) -> bool:\n    \"\"\"Compares two float numbers for equality within a given tolerance.\n    This helps in managing floating-point precision errors.\"\"\"\n    return abs(a - b) < tolerance\ndef validate_inputs(a: float, b: float, c: float) -> bool:\n    \"\"\"Checks if side lengths are positive.\n    The design specifies to trust types, so only positive values are checked.\"\"\"\n    return a > 0 and b > 0 and c > 0\ndef check_triangle_inequality(a: float, b: float, c: float) -> bool:\n    \"\"\"Verifies the triangle inequality rule: the sum of any two sides must be greater than the third.\n    This ensures that the given sides can form a real triangle.\"\"\"\n    return (a + b > c) and (a + c > b) and (b + c > a)\ndef sort_sides(a: float, b: float, c: float) -> tuple[float, float, float]:\n    \"\"\"Sorts the three side lengths in ascending order.\n    This helps in easily identifying the two shorter sides and the hypotenuse.\"\"\"\n    sides = sorted([a, b, c])\n    return sides[0], sides[1], sides[2]\ndef apply_pythagorean_theorem(sides: tuple[float, float, float]) -> bool:\n    \"\"\"Applies the Pythagorean theorem (a\u00b2 + b\u00b2 = c\u00b2) using sorted sides.\n    It checks if the square of the longest side equals the sum of the squares of the other two.\"\"\"\n    s1, s2, hypotenuse = sides\n    return float_equal(s1*s1 + s2*s2, hypotenuse*hypotenuse)\ndef is_right_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"Coordinates geometric validation by sorting sides and applying the Pythagorean theorem.\n    This function determines if the triangle formed by the given sides is right-angled.\"\"\"\n    s1, s2, hypotenuse = sort_sides(a, b, c)\n    return apply_pythagorean_theorem((s1, s2, hypotenuse))\ndef right_angle_triangle(a, b, c):\n    \"\"\"Determines if three given side lengths form a right-angled triangle.\n    It orchestrates validation and geometric calculation steps.\"\"\"\n    if not validate_inputs(a, b, c):\n        return False\n    if not check_triangle_inequality(a, b, c):\n        return False\n    \n    return is_right_triangle(a, b, c)"}
{"task_id": "HumanEval/157", "solution": "import math\ndef _identify_longest_side(a: float, b: float, c: float) -> tuple:\n    \"\"\"Helper function to identify the longest side as potential hypotenuse.\n    Returns (side1, side2, hypotenuse).\n    \"\"\"\n    sides = sorted([a, b, c])\n    return sides[0], sides[1], sides[2]\ndef _apply_pythagorean_theorem(side1: float, side2: float, hypotenuse: float) -> bool:\n    \"\"\"Helper function to apply Pythagorean theorem with floating-point precision.\n    Compares the sum of squares of two sides to the square of the hypotenuse.\n    \"\"\"\n    sum_of_squares = side1**2 + side2**2\n    hypotenuse_squared = hypotenuse**2\n    return math.isclose(sum_of_squares, hypotenuse_squared)\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Determine if three side lengths form a right-angled triangle.\n    It identifies the longest side as the hypotenuse and applies the Pythagorean theorem.\n    \"\"\"\n    s1, s2, h = _identify_longest_side(a, b, c)\n    return _apply_pythagorean_theorem(s1, s2, h)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the string with the maximum number of unique characters from a list of strings.\n    In case of a tie, the lexicographically first string is returned.\n    \"\"\"\n\n    def _count_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    def _compare_lexicographically(word1: str, word2: str) -> str:\n        \"\"\"Returns the lexicographically first string between two given strings.\"\"\"\n        return word1 if word1 < word2 else word2\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            result_word = _compare_lexicographically(word, result_word)\n\n    return result_word"}
{"task_id": "HumanEval/158", "solution": "from typing import List\nclass StringAnalysis:\n    \"\"\"Stores analysis results for a single string.\"\"\"\n    def __init__(self, original_string: str, unique_char_count: int) -> None:\n        self.original_string = original_string\n        self.unique_char_count = unique_char_count\ndef count_unique_chars(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a string.\"\"\"\n    return len(set(word))\ndef is_empty_list(words: List[str]) -> bool:\n    \"\"\"Checks if the input list is empty.\"\"\"\n    return len(words) == 0\ndef validate_input(words: List[str]) -> bool:\n    \"\"\"Validates the input list, returning True if valid.\"\"\"\n    return not is_empty_list(words)\ndef handle_ties(candidates: List[StringAnalysis]) -> str:\n    \"\"\"Resolves ties using lexicographical ordering.\"\"\"\n    sorted_candidates = sorted(candidates, key=lambda x: x.original_string)\n    return sorted_candidates[0].original_string\ndef select_best_string(analyses: List[StringAnalysis]) -> str:\n    \"\"\"Identifies the string with maximum unique characters and handles ties.\"\"\"\n    if not analyses:\n        return \"\" \n\n    max_unique_count = -1\n    best_candidates = []\n\n    for analysis in analyses:\n        if analysis.unique_char_count > max_unique_count:\n            max_unique_count = analysis.unique_char_count\n            best_candidates = [analysis]\n        elif analysis.unique_char_count == max_unique_count:\n            best_candidates.append(analysis)\n\n    if len(best_candidates) == 1:\n        return best_candidates[0].original_string\n    else:\n        return handle_ties(best_candidates)\ndef find_max(words: List[str]) -> str:\n    \"\"\"Orchestrates string processing to find the optimal string.\"\"\"\n    if not validate_input(words):\n        return \"\"\n\n    analyses = []\n    for word in words:\n        unique_count = count_unique_chars(word)\n        analyses.append(StringAnalysis(word, unique_count))\n\n    return select_best_string(analyses)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Simulates a rabbit's carrot consumption based on hunger and stock.\n    Returns total carrots eaten and remaining inventory.\n    \"\"\"\n    \n    carrots_to_eat_now = min(need, remaining)\n    \n    total_eaten = number + carrots_to_eat_now\n    remaining_stock = remaining - carrots_to_eat_now\n    \n    return [total_eaten, remaining_stock]"}
{"task_id": "HumanEval/159", "solution": "def validate_inputs(number: int, need: int, remaining: int) -> bool:\n    \"\"\"Validate input parameters are within acceptable range 0-1000.\n    This function confirms inputs meet constraints but does not raise exceptions.\"\"\"\n    if not (0 <= number <= 1000 and\n            0 <= need <= 1000 and\n            0 <= remaining <= 1000):\n        return False\n    return True\ndef calculate_consumption(need: int, available: int) -> int:\n    \"\"\"Calculate how many carrots to consume based on need and availability.\"\"\"\n    return min(need, available)\ndef eat(number, need, remaining):\n    \"\"\"\n    Main function implementing carrot eating logic.\n    Returns [total_eaten, remaining_after_meal].\n    \"\"\"\n    # Validate inputs as per design; \"trust the caller's inputs\" means we assume they pass.\n    _ = validate_inputs(number, need, remaining)\n\n    carrots_consumed = calculate_consumption(need, remaining)\n\n    total_eaten = number + carrots_consumed\n    remaining_after_meal = remaining - carrots_consumed\n\n    return [total_eaten, remaining_after_meal]"}
{"task_id": "HumanEval/161", "solution": "def _has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any letter characters.\n    It iterates through the string to find any alphabetic character.\n    \"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\ndef _process_with_letters(s: str) -> str:\n    \"\"\"Reverses the case of letter characters in the string.\n    Non-letter characters are preserved in their original positions.\n    \"\"\"\n    result = []\n    for char in s:\n        if char.islower():\n            result.append(char.upper())\n        elif char.isupper():\n            result.append(char.lower())\n        else:\n            result.append(char)\n    return \"\".join(result)\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the entire string character order.\n    This uses Python's slicing notation for efficient string reversal.\n    \"\"\"\n    return s[::-1]\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n    if _has_letters(s):\n        return _process_with_letters(s)\n    else:\n        return _reverse_string(s)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its MD5 hash equivalent.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/160", "solution": "class Operator:\n    \"\"\"Encapsulates operator symbol and precedence.\"\"\"\n    _precedence_map = {\n        '**': 3,\n        '*': 2,\n        '//': 2,\n        '+': 1,\n        '-': 1,\n    }\n\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n        self.precedence = self._precedence_map.get(symbol, 0)\n\n    def get_precedence(self) -> int:\n        \"\"\"Returns the precedence level of the operator.\"\"\"\n        return self.precedence\nclass Operand:\n    \"\"\"Encapsulates an operand's integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the operand.\"\"\"\n        return self.value\nclass Expression:\n    \"\"\"Represents a mathematical expression, holding lists of operator and operand objects.\"\"\"\n    def __init__(self, operators: list, operands: list):\n        self._operators = operators\n        self._operands = operands\n\n    def get_operators(self) -> list:\n        \"\"\"Returns the list of operator objects in the expression.\"\"\"\n        return self._operators\n\n    def get_operands(self) -> list:\n        \"\"\"Returns the list of operand objects in the expression.\"\"\"\n        return self._operands\nclass ExpressionBuilder:\n    \"\"\"Constructs an Expression object from raw operator symbols and operand values.\"\"\"\n    def build_expression(self, operator_symbols: list, operand_values: list) -> 'Expression':\n        \"\"\"Creates an Expression object populated with Operator and Operand instances.\"\"\"\n        operators = [Operator(op_sym) for op_sym in operator_symbols]\n        operands = [Operand(val) for val in operand_values]\n        return Expression(operators, operands)\nclass ExpressionEvaluator:\n    \"\"\"Evaluates mathematical expressions stored in an Expression object following operator precedence.\"\"\"\n    def evaluate_expression(self, expression_obj: 'Expression') -> int:\n        \"\"\"Calculates the numerical result of the expression using standard precedence rules.\"\"\"\n        operators = expression_obj.get_operators()\n        operands = expression_obj.get_operands()\n\n        combined_list = []\n        for i in range(len(operands)):\n            combined_list.append(operands[i])\n            if i < len(operators):\n                combined_list.append(operators[i])\n\n        # Extract unique precedence levels and sort them in descending order\n        all_operator_precedences = {op.get_precedence() for op in operators}\n        precedence_levels = sorted(list(all_operator_precedences), reverse=True)\n\n        for current_precedence in precedence_levels:\n            i = 0\n            while i < len(combined_list):\n                item = combined_list[i]\n                # If current item is an Operator and matches the current precedence level\n                if isinstance(item, Operator) and item.get_precedence() == current_precedence:\n                    left_operand_val = combined_list[i-1].get_value()\n                    right_operand_val = combined_list[i+1].get_value()\n                    op_symbol = item.symbol\n                    \n                    # Perform the operation based on the operator symbol\n                    if op_symbol == '+':\n                        result_val = left_operand_val + right_operand_val\n                    elif op_symbol == '-':\n                        result_val = left_operand_val - right_operand_val\n                    elif op_symbol == '*':\n                        result_val = left_operand_val * right_operand_val\n                    elif op_symbol == '//':\n                        result_val = left_operand_val // right_operand_val\n                    elif op_symbol == '**':\n                        result_val = left_operand_val ** right_operand_val\n                    \n                    # Replace the evaluated segment (operand, operator, operand) with the new result operand\n                    combined_list[i-1:i+2] = [Operand(result_val)]\n                    i -= 1 \n                else:\n                    i += 1\n        \n        # The final remaining item in the list should be the single Operand object with the result\n        return combined_list[0].get_value()\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given operator and operand lists, builds and evaluates an algebraic expression.\n    Returns the numerical result, applying standard mathematical operator precedence.\n    \"\"\"\n    # Input validation is skipped as per critical requirements.\n    \n    builder = ExpressionBuilder()\n    expression_obj = builder.build_expression(operator, operand)\n    \n    evaluator = ExpressionEvaluator()\n    result = evaluator.evaluate_expression(expression_obj)\n    \n    return result"}
{"task_id": "HumanEval/160", "solution": "def _build_expression(operator, operand):\n    \"\"\"\n    Constructs an evaluable mathematical expression string.\n    Combines operands and operators into a single string for evaluation.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n    return \" \".join(expression_parts)\ndef _evaluate_expression(expression_string):\n    \"\"\"\n    Evaluates the expression string using Python's eval.\n    Returns the integer result, respecting standard operator precedence.\n    \"\"\"\n    return int(eval(expression_string))\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists, operator and operand, this function builds an algebraic expression\n    and returns its integer evaluation following standard operator precedence.\n    \"\"\"\n    expression_string = _build_expression(operator, operand)\n    result = _evaluate_expression(expression_string)\n    return result"}
{"task_id": "HumanEval/161", "solution": "def has_letters(s: str) -> bool:\n    \"\"\"Determines if the string contains any letter characters.\n    Returns True if letters are present, False otherwise.\n    \"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\ndef reverse_case(char: str) -> str:\n    \"\"\"Converts the case of a single letter character.\n    Returns the character with opposite case if a letter, or unchanged otherwise.\n    \"\"\"\n    if char.isalpha():\n        if char.islower():\n            return char.upper()\n        else:\n            return char.lower()\n    return char\ndef reverse_string(s: str) -> str:\n    \"\"\"Reverses the order of characters in a string.\n    Returns the string with characters in reverse order.\n    \"\"\"\n    return s[::-1]\ndef solve(s):\n    \"\"\"Processes an input string by converting letter case or reversing the string.\n    Returns the processed string based on its content.\n    \"\"\"\n    if has_letters(s):\n        processed_chars = [reverse_case(char) for char in s]\n        return \"\".join(processed_chars)\n    else:\n        return reverse_string(s)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef _validate_input(text: str) -> bool:\n    \"\"\"\n    Checks if the input string is non-empty.\n    Returns True for non-empty, False for empty strings.\n    \"\"\"\n    return len(text) > 0\ndef _generate_hash(text: str) -> str:\n    \"\"\"\n    Generates the MD5 hash for a given string.\n    Encodes the string to utf-8 before hashing.\n    \"\"\"\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()\ndef _format_result(hash_value: str | None) -> str | None:\n    \"\"\"\n    Passes through the hash value or None.\n    This function primarily serves as a design placeholder for output formatting.\n    \"\"\"\n    return hash_value\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if _validate_input(text):\n        computed_hash = _generate_hash(text)\n        return _format_result(computed_hash)\n    else:\n        return _format_result(None)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    def _validate_inputs(a: int, b: int) -> bool:\n        \"\"\"\n        Validates that input parameters are positive integers.\n        As per critical requirements, this function trusts the caller's inputs and returns True.\n        \"\"\"\n        return True\n\n    def _determine_range(a: int, b: int) -> tuple[int, int]:\n        \"\"\"\n        Determines the minimum and maximum values from the two input parameters.\n        It returns a tuple containing (min_value, max_value).\n        \"\"\"\n        return (min(a, b), max(a, b))\n\n    def _filter_even_digits(min_val: int, max_val: int) -> list[int]:\n        \"\"\"\n        Identifies even single digits (0, 2, 4, 6, 8) that fall within the specified range boundaries.\n        This function maintains O(1) complexity by checking only the 10 single digits.\n        \"\"\"\n        even_digits_in_range = []\n        for digit in [0, 2, 4, 6, 8]:\n            if min_val <= digit <= max_val:\n                even_digits_in_range.append(digit)\n        return even_digits_in_range\n\n    def _sort_result(digits: list[int]) -> list[int]:\n        \"\"\"\n        Sorts the provided list of digits in ascending order.\n        It returns the newly sorted list.\n        \"\"\"\n        return sorted(digits)\n\n    # Orchestration of the function calls\n    _validate_inputs(a, b) # Input validation is performed but assumes valid inputs based on requirements.\n    min_val, max_val = _determine_range(a, b)\n    found_even_digits = _filter_even_digits(min_val, max_val)\n    final_result = _sort_result(found_even_digits)\n\n    return final_result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    It normalizes parameters and filters for single even digits within the range.\n    \"\"\"\n    def _get_even_digits_in_range(min_val: int, max_val: int) -> list[int]:\n        \"\"\"\n        Filters and returns even single digits (0-9) that fall within the given range.\n        The fixed set of even digits ensures O(1) time complexity.\n        \"\"\"\n        even_digits = [0, 2, 4, 6, 8]\n        result = []\n        for digit in even_digits:\n            if min_val <= digit <= max_val:\n                result.append(digit)\n        return result\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    return _get_even_digits_in_range(min_val, max_val)"}
