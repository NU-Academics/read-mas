{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance: int = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates multiple groups of nested parentheses into individual strings.\n    Each returned group is balanced and spaces are ignored.\n    \"\"\"\n\n    def _remove_spaces(input_str: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return input_str.replace(' ', '')\n\n    def _extract_groups(cleaned_str: str) -> List[str]:\n        \"\"\"Parses the cleaned string and extracts individual parentheses groups using a balance counter.\"\"\"\n        groups = []\n        current_group = []\n        balance = 0\n        for char in cleaned_str:\n            current_group.append(char)\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and len(current_group) > 0:\n                groups.append(\"\".join(current_group))\n                current_group = []\n        return groups\n\n    def _is_balanced(group: str) -> bool:\n        \"\"\"Validates if a single parentheses group is properly balanced.\"\"\"\n        count = 0\n        for char in group:\n            if char == '(':\n                count += 1\n            elif char == ')':\n                count -= 1\n            if count < 0:  # Closing parenthesis without a matching open one\n                return False\n        return count == 0\n\n    cleaned_string = _remove_spaces(paren_string)\n    extracted_groups = _extract_groups(cleaned_string)\n\n    # As per the design, validate each extracted group, though _extract_groups already ensures balance.\n    final_groups = [group for group in extracted_groups if _is_balanced(group)]\n\n    return final_groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates groups of nested parentheses in a string into individual balanced strings.\n    Ignores spaces and maintains the original order of groups.\n    \"\"\"\n\n    def _remove_spaces(input_str: str) -> str:\n        \"\"\" Removes all space characters from the input string.\n        This prepares the string for parsing by consolidating parentheses.\n        \"\"\"\n        return input_str.replace(\" \", \"\")\n\n    def _validate_balance(group: str) -> None:\n        \"\"\" Validates if a given string of parentheses is balanced.\n        Raises ValueError if the string is unbalanced at any point.\n        \"\"\"\n        balance = 0\n        for char in group:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                raise ValueError(\"Unbalanced parentheses.\")\n        if balance != 0:\n            raise ValueError(\"Unbalanced parentheses.\")\n\n    def _find_group_end(s: str, start: int) -> int:\n        \"\"\" Finds the index of the closing parenthesis that balances the opening one at 'start'.\n        It tracks the balance and returns the index when balance returns to zero.\n        \"\"\"\n        balance = 0\n        for i in range(start, len(s)):\n            if s[i] == '(':\n                balance += 1\n            elif s[i] == ')':\n                balance -= 1\n            if balance == 0:\n                return i\n        return len(s) - 1\n\n    def _parse_groups(cleaned_str: str) -> List[str]:\n        \"\"\" Parses a string (without spaces) into a list of balanced parenthesis groups.\n        It identifies distinct top-level groups and validates each for balance.\n        \"\"\"\n        groups = []\n        i = 0\n        while i < len(cleaned_str):\n            if cleaned_str[i] == '(':\n                end_idx = _find_group_end(cleaned_str, i)\n                current_group = cleaned_str[i : end_idx + 1]\n                \n                _validate_balance(current_group)\n\n                groups.append(current_group)\n                i = end_idx + 1\n            else:\n                i += 1\n        return groups\n\n    cleaned_string = _remove_spaces(paren_string)\n    groups = _parse_groups(cleaned_string)\n    return groups"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    \"\"\"\n    # Calculate the arithmetic mean of the input numbers.\n    mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute difference between each number and the mean.\n    absolute_differences = [abs(x - mean) for x in numbers]\n\n    # Return the average of these absolute differences.\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the arithmetic mean of the input numbers.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Compute the absolute differences between each number and the mean.\n    absolute_differences = [abs(num - data_mean) for num in numbers]\n\n    # Return the average of these absolute differences.\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    if len(numbers) == 1:\n        return numbers\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
