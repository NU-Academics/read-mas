{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to a binary string, formatted with 'db' prefix and suffix.\n    Uses Python's built-in bin() function for conversion and string slicing for formatting.\n    \"\"\"\n    binary_string = bin(decimal)\n    stripped_binary = binary_string[2:]\n    return \"db\" + stripped_binary + \"db\""}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Convert decimal number to binary format with db prefix/suffix.\n    This function internally handles conversion and formatting as required.\n    \"\"\"\n\n    def _convert_to_binary_algorithm(number: int) -> str:\n        \"\"\"\n        Converts a decimal number to its binary string representation.\n        It uses Python's built-in binary conversion and removes the '0b' prefix.\n        \"\"\"\n        return bin(number)[2:]\n\n    def _format_binary_output(binary_string: str) -> str:\n        \"\"\"\n        Adds the specified 'db' prefix and suffix to the binary string.\n        This directly concatenates the markers around the binary value.\n        \"\"\"\n        return f\"db{binary_string}db\"\n\n    # As per CRITICAL REQUIREMENTS, input validation is omitted.\n    # The 'decimal' input is trusted to be a positive integer.\n\n    binary_representation = _convert_to_binary_algorithm(decimal)\n    formatted_string = _format_binary_output(binary_representation)\n\n    return formatted_string"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy: at least 3 characters long and every 3 consecutive letters are distinct.\n    Returns True if happy, False otherwise.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/80", "solution": "def _are_distinct(triplet: str) -> bool:\n    \"\"\"Checks if all characters in a 3-character string are distinct.\n    Returns True if all characters are different, False otherwise.\n    \"\"\"\n    return len(set(triplet)) == 3\ndef _extract_triplets(s: str) -> list[str]:\n    \"\"\"Extracts all 3-character consecutive substrings from a string.\n    Returns a list of these 3-character substrings.\n    \"\"\"\n    triplets = []\n    for i in range(len(s) - 2):\n        triplets.append(s[i:i+3])\n    return triplets\ndef _check_length(s: str) -> bool:\n    \"\"\"Validates if the string meets the minimum length requirement.\n    Returns True if length is 3 or more, False otherwise.\n    \"\"\"\n    return len(s) >= 3\ndef is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    \"\"\"\n    if not _check_length(s):\n        return False\n\n    triplets = _extract_triplets(s)\n    for triplet in triplets:\n        if not _are_distinct(triplet):\n            return False\n            \n    return True"}
{"task_id": "HumanEval/82", "solution": "def _calculate_length(string: str) -> int:\n    \"\"\"Calculates the character length of a given string.\"\"\"\n    return len(string)\ndef _is_prime(number: int) -> bool:\n    \"\"\"Determines if a number is prime.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for odd divisors up to the square root of the number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\"\"\"\n    length = _calculate_length(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def _calculate_length(string: str) -> int:\n    \"\"\"Calculates the length of the input string.\n    This is a helper function used by prime_length.\n    \"\"\"\n    return len(string)\ndef _is_prime(number: int) -> bool:\n    \"\"\"Determines if a number is prime with O(\u221an) complexity.\n    Handles prime checking for the string length.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = _calculate_length(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "def _convert_single_grade(gpa: float) -> str:\n    \"\"\"Converts a single numerical GPA value to its corresponding letter grade.\n    This helper applies the specific 13-tier grading scale.\n    \"\"\"\n    if gpa == 4.0:\n        return 'A+'\n    elif gpa > 3.7:\n        return 'A'\n    elif gpa > 3.3:\n        return 'A-'\n    elif gpa > 3.0:\n        return 'B+'\n    elif gpa > 2.7:\n        return 'B'\n    elif gpa > 2.3:\n        return 'B-'\n    elif gpa > 2.0:\n        return 'C+'\n    elif gpa > 1.7:\n        return 'C'\n    elif gpa > 1.3:\n        return 'C-'\n    elif gpa > 1.0:\n        return 'D+'\n    elif gpa > 0.7:\n        return 'D'\n    elif gpa > 0.0:\n        return 'D-'\n    # Covers gpa == 0.0 explicitly as the final condition.\n    return 'E'\ndef numerical_letter_grade(grades: list) -> list:\n    \"\"\"Converts a list of numerical GPA values to a list of corresponding letter grades.\n    It uses a standardized 13-tier grading scale for conversion.\n    \"\"\"\n    result_grades = []\n    for gpa_value in grades:\n        letter_grade = _convert_single_grade(gpa_value)\n        result_grades.append(letter_grade)\n    return result_grades"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values to corresponding letter grades.\n    The conversion follows a specific 13-level grading scale.\n    \"\"\"\n    result = []\n    for gpa in grades:\n        if gpa == 4.0:\n            result.append('A+')\n        elif gpa > 3.7:\n            result.append('A')\n        elif gpa > 3.3:\n            result.append('A-')\n        elif gpa > 3.0:\n            result.append('B+')\n        elif gpa > 2.7:\n            result.append('B')\n        elif gpa > 2.3:\n            result.append('B-')\n        elif gpa > 2.0:\n            result.append('C+')\n        elif gpa > 1.7:\n            result.append('C')\n        elif gpa > 1.3:\n            result.append('C-')\n        elif gpa > 1.0:\n            result.append('D+')\n        elif gpa > 0.7:\n            result.append('D')\n        elif gpa > 0.0:\n            result.append('D-')\n        elif gpa == 0.0:\n            result.append('E')\n    return result"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, count n-digit numbers that start or end with 1.\n    This uses the inclusion-exclusion principle for O(1) complexity.\n    \"\"\"\n\n    def calculate_power_of_10(exponent):\n        \"\"\"Calculates 10 raised to the given exponent.\"\"\"\n        return 10 ** exponent\n\n    def apply_inclusion_exclusion(starts, ends, both):\n        \"\"\"Applies the inclusion-exclusion principle: A + B - (A intersect B).\"\"\"\n        return starts + ends - both\n\n    if n == 1:\n        # Special case: The only 1-digit number starting or ending with 1 is '1'.\n        return 1\n    else:\n        # Count numbers starting with 1: The first digit is 1, remaining (n-1) digits can be any of 10.\n        starts_count = calculate_power_of_10(n - 1)\n\n        # Count numbers ending with 1: The last digit is 1, first digit 1-9 (9 options), middle (n-2) digits any of 10.\n        ends_count = 9 * calculate_power_of_10(n - 2)\n\n        # Count numbers both starting and ending with 1: First and last digits are 1, middle (n-2) digits any of 10.\n        both_count = calculate_power_of_10(n - 2)\n\n        # Apply the inclusion-exclusion principle to get the total count.\n        total_count = apply_inclusion_exclusion(starts_count, ends_count, both_count)\n        return total_count"}
{"task_id": "HumanEval/85", "solution": "def _is_odd_index(index: int) -> bool:\n    \"\"\"Determines if an index is odd.\"\"\"\n    return index % 2 != 0\ndef _is_even(number: int) -> bool:\n    \"\"\"Determines if a number is even.\"\"\"\n    return number % 2 == 0\ndef _get_odd_indices(lst: list) -> list:\n    \"\"\"Extracts elements at odd indices from the input list.\"\"\"\n    elements_at_odd_indices = []\n    for index, element in enumerate(lst):\n        if _is_odd_index(index):\n            elements_at_odd_indices.append(element)\n    return elements_at_odd_indices\ndef _filter_even_numbers(numbers: list) -> list:\n    \"\"\"Filters a list to retain only even numbers.\"\"\"\n    even_numbers = []\n    for number in numbers:\n        if _is_even(number):\n            even_numbers.append(number)\n    return even_numbers\ndef _calculate_sum(numbers: list) -> int:\n    \"\"\"Calculates the sum of numbers in a list.\"\"\"\n    return sum(numbers)\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\"\"\"\n\n    # Extract elements located at odd indices from the input list.\n    elements_at_odd_indices = _get_odd_indices(lst)\n\n    # Filter these extracted elements to keep only the even numbers.\n    even_elements_at_odd_indices = _filter_even_numbers(elements_at_odd_indices)\n\n    # Calculate and return the sum of the filtered even numbers.\n    final_sum = _calculate_sum(even_elements_at_odd_indices)\n    return final_sum"}
{"task_id": "HumanEval/83", "solution": "class MathematicalCalculator:\n    \"\"\"Core mathematical calculations, including set union logic.\"\"\"\n    @staticmethod\n    def apply_set_union_logic(start_count: int, end_count: int, both_count: int) -> int:\n        \"\"\"Calculates total count using inclusion-exclusion principle.\"\"\"\n        return start_count + end_count - both_count\n\n    @staticmethod\n    def calculate_power_of_ten(exponent: int) -> int:\n        \"\"\"Calculates 10 raised to the given exponent.\"\"\"\n        return 10**exponent\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers that start or end with 1.\n    This function uses mathematical formulas for O(1) complexity.\n    \"\"\"\n\n    if n == 1:\n        # For n=1, the only 1-digit number starting or ending with 1 is '1'.\n        starting_with_one = 1\n        ending_with_one = 1\n        both_start_end_one = 1\n    else:\n        # Count n-digit numbers starting with 1: '1' followed by (n-1) digits (10^(n-1) choices).\n        starting_with_one = MathematicalCalculator.calculate_power_of_ten(n - 1)\n\n        # Count n-digit numbers ending with 1: (n-2) middle digits (10^(n-2) choices), first digit (1-9).\n        ending_with_one = 9 * MathematicalCalculator.calculate_power_of_ten(n - 2)\n\n        # Count n-digit numbers both starting and ending with 1: '1...1', with (n-2) middle digits (10^(n-2) choices).\n        both_start_end_one = MathematicalCalculator.calculate_power_of_ten(n - 2)\n\n    # Apply the set union logic (inclusion-exclusion principle) to get the total count.\n    total_count = MathematicalCalculator.apply_set_union_logic(\n        starting_with_one, ending_with_one, both_start_end_one\n    )\n\n    return total_count"}
{"task_id": "HumanEval/84", "solution": "def extract_digits(N):\n    \"\"\"Extracts individual decimal digits from the input integer N.\n    Returns a list of these digits.\"\"\"\n    return [int(d) for d in str(N)]\ndef calculate_digit_sum(N):\n    \"\"\"Calculates the sum of all decimal digits of N.\n    It uses the extract_digits helper function.\"\"\"\n    digits = extract_digits(N)\n    return sum(digits)\ndef convert_to_binary(num):\n    \"\"\"Converts an integer to its binary string representation.\n    The result does not include a '0b' prefix.\"\"\"\n    return bin(num)[2:]\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Orchestrates digit sum calculation and binary conversion.\"\"\"\n    digit_sum_result = calculate_digit_sum(N)\n    binary_string_result = convert_to_binary(digit_sum_result)\n    return binary_string_result"}
{"task_id": "HumanEval/84", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"Calculates the sum of all decimal digits in a given number.\n    Converts the number to a string to iterate through its digits.\"\"\"\n    return sum(int(digit) for digit in str(number))\ndef convert_to_binary(decimal: int) -> str:\n    \"\"\"Converts a decimal number to its binary string representation.\n    The output string will not contain a '0b' prefix or leading zeros.\"\"\"\n    return bin(decimal)[2:]\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    This function orchestrates digit sum calculation and binary conversion.\"\"\"\n    \n    # As per \"Trust the caller's inputs\", we assume N is valid and do not explicitly\n    # handle validation failure or use the return value of validate_input to raise errors.\n    \n    digit_sum = sum_digits(N)\n    binary_result = convert_to_binary(digit_sum)\n    return binary_result"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n    This function iterates through the list, identifying and summing elements that meet the criteria.\n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        # Check if the index is odd (1, 3, 5, ...) and the element is even.\n        if index % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "def _sort_word_characters(word: str) -> str:\n    \"\"\"Sorts characters within a word by ASCII value in ascending order.\"\"\"\n    return ''.join(sorted(word))\ndef _split_preserving_spaces(s: str) -> list[tuple[str, bool]]:\n    \"\"\"Splits string into segments while preserving space information.\"\"\"\n    if not s:\n        return []\n\n    segments = []\n    current_segment_start = 0\n    # Determine if the first character (and thus the first segment) is a space\n    is_current_segment_space = s[0].isspace()\n\n    for i in range(len(s)):\n        # Check if the character type (space/non-space) changes\n        if s[i].isspace() != is_current_segment_space:\n            # Add the completed segment to the list\n            segments.append((s[current_segment_start:i], is_current_segment_space))\n            # Start a new segment\n            current_segment_start = i\n            is_current_segment_space = not is_current_segment_space # Toggle type\n\n    # Add the last segment after the loop\n    segments.append((s[current_segment_start:], is_current_segment_space))\n    return segments\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string and returns an ordered version where characters within each word\n    are sorted in ascending ASCII order, preserving word order and spacing.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    processed_parts = []\n    segments = _split_preserving_spaces(s)\n\n    for segment, is_space in segments:\n        if is_space:\n            processed_parts.append(segment)\n        else:\n            processed_parts.append(_sort_word_characters(segment))\n\n    return ''.join(processed_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in a 2D nested list (matrix-like) and returns sorted coordinates.\n    Coordinates are (row, column) zero-indexed, sorted by row ascending and column descending.\n    \"\"\"\n    found_coordinates = []\n    for row_index, row in enumerate(lst):\n        for col_index, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_index, col_index))\n\n    # Sort by row (ascending) and then by column (descending)\n    # Sorting by coord[0] ascending and -coord[1] ascending achieves the desired effect\n    sorted_coordinates = sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))\n\n    return sorted_coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting lowercase letters by 4 positions with wraparound.\n    Non-alphabetic characters are preserved unchanged.\n    \"\"\"\n    encrypted_chars = []\n    shift_value = 4 \n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the new character code with wraparound\n            shifted_char_code = (ord(char) - ord('a') + shift_value) % 26\n            encrypted_chars.append(chr(ord('a') + shifted_char_code))\n        else:\n            # Preserve non-alphabetic characters as is\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                coordinates.append((row_idx, col_idx))\n    \n    # Sort coordinates by row ascending, then by column descending.\n    # Negating the column index achieves descending sort for columns.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    \n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Returns an ascending sorted copy if the sum is odd, or a descending sorted copy if even.\n    \"\"\"\n\n    def _calculate_sum_first_last(arr):\n        \"\"\"Calculates the sum of the first and last elements of an array.\"\"\"\n        return arr[0] + arr[-1]\n\n    def _is_sum_odd(sum_value):\n        \"\"\"Determines if a sum value is odd.\"\"\"\n        return sum_value % 2 == 1\n\n    def _sort_ascending(arr):\n        \"\"\"Sorts an array in ascending order, returning a new list.\"\"\"\n        return sorted(arr)\n\n    def _sort_descending(arr):\n        \"\"\"Sorts an array in descending order, returning a new list.\"\"\"\n        return sorted(arr, reverse=True)\n\n    if not array:\n        return []\n    if len(array) == 1:\n        return array[:]\n\n    sum_first_last = _calculate_sum_first_last(array)\n\n    if _is_sum_odd(sum_first_last):\n        return _sort_ascending(array)\n    else:\n        return _sort_descending(array)"}
{"task_id": "HumanEval/88", "solution": "from typing import List\ndef _validate_input(array: List[int]) -> bool:\n    \"\"\"This function trusts the caller's input and performs no validation.\n    It always returns True as per critical requirements.\n    \"\"\"\n    return True\ndef _calculate_sum(array: List[int]) -> int:\n    \"\"\"Calculates the sum of the first and last elements of a non-empty array.\"\"\"\n    return array[0] + array[-1]\ndef _sort_array_copy(array: List[int], ascending: bool) -> List[int]:\n    \"\"\"Creates and returns a sorted copy of the array in the specified order.\"\"\"\n    return sorted(array, reverse=not ascending)\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The sorting order depends on the sum of the first and last elements.\n    \"\"\"\n    _validate_input(array)\n\n    if not array:\n        return []\n\n    sum_first_last = _calculate_sum(array)\n\n    if sum_first_last % 2 == 1:  # Odd sum, sort ascending\n        return _sort_array_copy(array, True)\n    else:  # Even sum, sort descending\n        return _sort_array_copy(array, False)"}
{"task_id": "HumanEval/86", "solution": "def split_preserve_spaces(s: str) -> tuple[list[str], list[str]]:\n    \"\"\"\n    Splits a string into words and preserves all spacing, including leading/trailing.\n    Returns a tuple of (list of words, list of space chunks) where len(spaces) = len(words) + 1.\n    \"\"\"\n    words = []\n    spaces = []\n    current_segment_chars = []\n\n    if not s:\n        return ([], [\"\"])\n\n    is_current_segment_space = s[0].isspace()\n\n    for char in s:\n        if char.isspace() == is_current_segment_space:\n            current_segment_chars.append(char)\n        else:\n            if is_current_segment_space:\n                spaces.append(\"\".join(current_segment_chars))\n            else:\n                words.append(\"\".join(current_segment_chars))\n            current_segment_chars = [char]\n            is_current_segment_space = not is_current_segment_space\n\n    # Append the last segment\n    if current_segment_chars:\n        if is_current_segment_space:\n            spaces.append(\"\".join(current_segment_chars))\n        else:\n            words.append(\"\".join(current_segment_chars))\n\n    # Ensure len(spaces) == len(words) + 1 for consistent reconstruction.\n    # This handles cases where the string starts or ends with a word.\n    if len(spaces) == len(words):\n        if s and not s[0].isspace():  # String starts with a word, add leading empty space\n            spaces.insert(0, \"\")\n        if s and not s[-1].isspace():  # String ends with a word, add trailing empty space\n            spaces.append(\"\")\n    # If len(spaces) is still equal to len(words) after above logic, it implies input like \"word1 space1 word2\".\n    # This scenario needs both a leading and a trailing empty space.\n    if len(spaces) == len(words) and words:\n        spaces.insert(0, \"\")\n        spaces.append(\"\")\n\n    return (words, spaces)\ndef sort_word_characters(word: str) -> str:\n    \"\"\"\n    Sorts characters within a single word in ascending ASCII order.\n    \"\"\"\n    return \"\".join(sorted(word))\ndef reconstruct_output(words: list[str], spaces: list[str]) -> str:\n    \"\"\"\n    Reconstructs the final string from processed words and spacing.\n    Assumes spaces list has one more element than words list for proper interleaving.\n    \"\"\"\n    result_parts = []\n    num_words = len(words)\n    num_spaces = len(spaces)\n\n    # Append leading space if present\n    if num_spaces > 0:\n        result_parts.append(spaces[0])\n\n    # Interleave words and their following spaces\n    for i in range(num_words):\n        result_parts.append(words[i])\n        # Add space after the word, if available\n        if i + 1 < num_spaces:\n            result_parts.append(spaces[i+1])\n    \n    return \"\".join(result_parts)\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string and returns an ordered version where characters within each word\n    are sorted in ascending ASCII order, preserving word order and spacing.\n    \"\"\"\n    words, spaces = split_preserve_spaces(s)\n    \n    processed_words = [sort_word_characters(word) for word in words]\n    \n    return reconstruct_output(processed_words, spaces)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each lowercase letter by 4 positions in the alphabet with wraparound. Non-lowercase characters remain unchanged, maintaining original string length.\"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate 0-indexed position (a=0, b=1, ..., z=25)\n            position = ord(char) - ord('a')\n            # Apply 4-position shift with wraparound using modulo 26\n            shifted_position = (position + 4) % 26\n            # Convert back to character\n            encrypted_char = chr(ord('a') + shifted_position)\n            encrypted_chars.append(encrypted_char)\n        else:\n            # Keep non-lowercase characters unchanged\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the second smallest unique element from a list of integers.\n    Returns None if the list has fewer than two unique elements.\n    \"\"\"\n    # Convert the list to a set to get only unique elements, then back to a list.\n    unique_elements = list(set(lst))\n\n    # Sort the unique elements in ascending order.\n    unique_elements.sort()\n\n    # If there are fewer than two unique elements, return None.\n    if len(unique_elements) < 2:\n        return None\n    else:\n        # Otherwise, return the element at index 1, which is the second smallest.\n        return unique_elements[1]"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of three numbers equals the sum of the other two,\n    and ensures all three inputs are strict integers (not floats or booleans).\n    \"\"\"\n    if not (isinstance(x, int) and not isinstance(x, bool) and\n            isinstance(y, int) and not isinstance(y, bool) and\n            isinstance(z, int) and not isinstance(z, bool)):\n        return False\n\n    return (x == y + z or\n            y == x + z or\n            z == x + y)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the second smallest unique element in a list of integers.\n    Returns None if the list is empty or has fewer than two unique elements.\n    \"\"\"\n\n    def _validate_input(input_list):\n        # Validates the input structure, always returns True as per design constraints.\n        return True\n\n    def _remove_duplicates(input_list):\n        # Converts list to a set for unique elements, then sorts them.\n        unique_elements = sorted(list(set(input_list)))\n        return unique_elements\n\n    def _find_second_smallest(unique_elements):\n        # Returns the second element if enough unique elements exist, otherwise None.\n        if len(unique_elements) >= 2:\n            return unique_elements[1]\n        return None\n\n    # Initial check for empty list as per design sequence diagram.\n    if not lst:\n        return None\n\n    # The _validate_input helper is called but its return value is not used to\n    # branch, consistent with \"trust caller's inputs\" and \"no isinstance\".\n    _validate_input(lst) \n\n    unique_sorted_elements = _remove_duplicates(lst)\n    result = _find_second_smallest(unique_sorted_elements)\n    return result"}
{"task_id": "HumanEval/91", "solution": "import re\ndef split_into_sentences(text: str) -> list[str]:\n    \"\"\"Splits the input text into a list of sentences using specified delimiters.\n    It handles multiple delimiters and filters out empty results.\"\"\"\n    sentences = re.split(r'[.?!]', text)\n    return [s.strip() for s in sentences if s.strip()]\ndef get_first_word(sentence: str) -> str:\n    \"\"\"Extracts the first word from a given sentence string.\n    Returns an empty string if the sentence is empty or contains only whitespace.\"\"\"\n    cleaned_sentence = sentence.strip()\n    if not cleaned_sentence:\n        return \"\"\n    return cleaned_sentence.split(maxsplit=1)[0]\ndef is_sentence_boredom(sentence: str) -> bool:\n    \"\"\"Determines if a sentence qualifies as a boredom, i.e., starts with 'I'.\n    It uses a case-sensitive comparison of the first word.\"\"\"\n    first_word = get_first_word(sentence)\n    return first_word == \"I\"\ndef is_bored(S: str) -> int:\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    boredom_count = 0\n    sentences = split_into_sentences(S)\n    for sentence in sentences:\n        if is_sentence_boredom(sentence):\n            boredom_count += 1\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def _is_integer(value) -> bool:\n    \"\"\"\n    Helper function to check if value is an integer type.\n    Returns False for floats, even if they represent whole numbers.\n    \"\"\"\n    # Uses type() to strictly check for int, rejecting floats as per design.\n    return type(value) is int\ndef _check_sum_conditions(x: int, y: int, z: int) -> bool:\n    \"\"\"\n    Helper function to check if x+y=z OR x+z=y OR y+z=x.\n    Assumes all inputs are already validated as integers.\n    \"\"\"\n    # Checks all three possible sum conditions.\n    return (x + y == z) or \\\n           (x + z == y) or \\\n           (y + z == x)\ndef any_int(x, y, z) -> bool:\n    \"\"\"\n    Main function that validates inputs and checks sum conditions.\n    Returns True if all inputs are integers and one equals sum of other two.\n    \"\"\"\n    # Validate all inputs are strict integers using the helper function.\n    if not (_is_integer(x) and _is_integer(y) and _is_integer(z)):\n        return False\n    \n    # If all are integers, check the sum conditions.\n    return _check_sum_conditions(x, y, z)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S: str) -> int:\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    boredom_count = 0\n    # Replace all sentence delimiters with a unique character to simplify splitting.\n    # This prepares the string for consistent fragmentation.\n    temp_S = S\n    for delimiter in ['.', '?', '!']:\n        temp_S = temp_S.replace(delimiter, '|')\n\n    # Split the modified string by the unique character into potential sentence fragments.\n    sentences_fragments = temp_S.split('|')\n\n    for fragment in sentences_fragments:\n        # Remove leading/trailing whitespace from each fragment.\n        # If the cleaned fragment starts with 'I ' or is just 'I', increment the boredom count.\n        stripped_sentence = fragment.strip()\n        if stripped_sentence and (stripped_sentence == \"I\" or stripped_sentence.startswith(\"I \")):\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/93", "solution": "VOWEL_MAPPING = {\n    'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'\n}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"\n    Checks if a character is a vowel (case-insensitive).\n    \"\"\"\n    return char.lower() in VOWEL_MAPPING\ndef _get_vowel_replacement(char: str) -> str:\n    \"\"\"\n    Returns the replacement character for a given vowel.\n    The replacement is always in lowercase for consistency before case-swapping.\n    \"\"\"\n    return VOWEL_MAPPING[char.lower()]\ndef _swap_case(char: str) -> str:\n    \"\"\"\n    Swaps the case of an alphabetic character.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    return char.swapcase()\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping character case and replacing vowels.\n    Vowels are replaced by letters two positions ahead, then case-swapped.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            if _is_vowel(char):\n                # Get the lowercase replacement, then swap its case\n                processed_char = _swap_case(_get_vowel_replacement(char))\n            else:\n                # Consonants are just case-swapped\n                processed_char = _swap_case(char)\n        else:\n            # Non-alphabetic characters are preserved\n            processed_char = char\n        encoded_chars.append(processed_char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by applying vowel replacement and case swapping.\n    Vowels are replaced by the letter 2 places ahead, then case is swapped.\n    \"\"\"\n\n    VOWEL_REPLACEMENTS = {\n        'a': 'c', 'A': 'C',\n        'e': 'g', 'E': 'G',\n        'i': 'k', 'I': 'K',\n        'o': 'q', 'O': 'Q',\n        'u': 'w', 'U': 'W'\n    }\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _swap_case(char):\n        \"\"\"Swaps the case of an alphabetic character.\"\"\"\n        return char.swapcase()\n\n    def _replace_vowel(char):\n        \"\"\"Replaces a vowel with the letter 2 positions ahead.\"\"\"\n        return VOWEL_REPLACEMENTS.get(char, char)\n\n    def _process_character(char):\n        \"\"\"Applies encoding transformations to a single character.\"\"\"\n        processed_char = char\n        if _is_vowel(char):\n            processed_char = _replace_vowel(char)\n        \n        return _swap_case(processed_char)\n\n    encoded_chars = []\n    for char in message:\n        if char == ' ':\n            encoded_chars.append(' ')\n        else:\n            encoded_chars.append(_process_character(char))\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "import math\ndef is_prime_optimized(n: int) -> bool:\n    \"\"\"Optimized prime checking algorithm.\n    Checks if a given integer n is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef validate_integer_list(lst: list) -> bool:\n    \"\"\"Validate input list contains integers.\n    This function will always return True as per the critical requirements.\"\"\"\n    return True\ndef is_prime(n: int) -> bool:\n    \"\"\"Check if a number is prime.\n    Delegates to the optimized prime checking utility.\"\"\"\n    return is_prime_optimized(n)\ndef find_primes(numbers: list) -> list:\n    \"\"\"Identify all prime numbers in the input list.\n    Filters the list using the is_prime helper.\"\"\"\n    return [num for num in numbers if is_prime(num)]\ndef find_largest_prime(primes: list) -> int:\n    \"\"\"Find the largest prime from a list of primes.\n    Returns 0 if the list of primes is empty.\"\"\"\n    if not primes:\n        return 0\n    return max(primes)\ndef extract_digits(number: int) -> list:\n    \"\"\"Extract individual digits from a number.\n    Converts the number to a string to get its digits.\"\"\"\n    return [int(d) for d in str(number)]\ndef calculate_digit_sum(number: int) -> int:\n    \"\"\"Calculate the sum of digits in a number.\n    Uses extract_digits to get individual digits and sums them.\"\"\"\n    return sum(extract_digits(number))\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\"\"\"\n\n    _ = validate_integer_list(lst)\n\n    primes = find_primes(lst)\n\n    largest_prime = find_largest_prime(primes)\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return calculate_digit_sum(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are consistently lowercase or uppercase strings.\n    Returns False for empty dictionaries, non-string keys, or mixed-case keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Fail fast if any key is not a string, as per requirement for non-string keys.\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # Check if all string keys are lowercase or all are uppercase.\n    all_lowercase = all(key.islower() for key in keys)\n    all_uppercase = all(key.isupper() for key in keys)\n\n    return all_lowercase or all_uppercase"}
{"task_id": "HumanEval/94", "solution": "from typing import List\nclass MathUtils:\n    def isPositive(self, number: int) -> bool:\n        \"\"\"Checks if a number is positive.\n        Returns True if the number is greater than 0.\"\"\"\n        return number > 0\n\n    def sqrt(self, number: int) -> int:\n        \"\"\"Calculates the integer square root of a non-negative number.\n        Returns 0 for negative input.\"\"\"\n        if number < 0:\n            return 0\n        x = 0\n        while (x + 1) * (x + 1) <= number:\n            x += 1\n        return x\nclass DigitSumCalculator:\n    def calculateDigitSum(self, number: int) -> int:\n        \"\"\"Calculates the sum of the digits of a number.\n        Processes the absolute value of the number.\"\"\"\n        s = 0\n        num_str = str(abs(number))\n        for digit_char in num_str:\n            s += int(digit_char)\n        return s\n\n    def sumDigits(self, prime: int) -> int:\n        \"\"\"Calculates the sum of digits for a given prime number.\n        This is an alias for calculateDigitSum.\"\"\"\n        return self.calculateDigitSum(prime)\nclass PrimeDetector:\n    def __init__(self):\n        \"\"\"Initializes the PrimeDetector with an instance of MathUtils.\"\"\"\n        self._math_utils = MathUtils()\n\n    def isPrime(self, number: int) -> bool:\n        \"\"\"Checks if a given number is prime.\n        Handles numbers <= 1 and checks for divisors up to its square root.\"\"\"\n        if not self._math_utils.isPositive(number) or number == 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n\n        limit = self._math_utils.sqrt(number)\n        for i in range(3, limit + 1, 2):\n            if number % i == 0:\n                return False\n        return True\n\n    def findPrimes(self, lst: List[int]) -> List[int]:\n        \"\"\"Identifies all prime numbers within a list.\n        Returns a new list containing only the prime numbers found.\"\"\"\n        primes = []\n        for num in lst:\n            if self.isPrime(num):\n                primes.append(num)\n        return primes\n\n    def findLargestPrime(self, primes: List[int]) -> int:\n        \"\"\"Finds the largest prime number from a list of primes.\n        It is assumed that the input list 'primes' is not empty.\"\"\"\n        return max(primes)\nclass PrimeDigitSumProcessor:\n    def __init__(self):\n        \"\"\"Initializes the processor with instances of PrimeDetector and DigitSumCalculator.\"\"\"\n        self._prime_detector = PrimeDetector()\n        self._digit_sum_calculator = DigitSumCalculator()\n\n    def execute(self, lst: List[int]) -> int:\n        \"\"\"Orchestrates the process to find the largest prime's digit sum.\n        Returns the digit sum, or 0 if no primes are found in the list.\"\"\"\n        primes_list = self._prime_detector.findPrimes(lst)\n\n        if not primes_list:\n            return 0\n\n        largest_prime = self._prime_detector.findLargestPrime(primes_list)\n        digit_sum = self._digit_sum_calculator.calculateDigitSum(largest_prime)\n        return digit_sum\n\n    def processListForLargestPrimeDigitSum(self, input_list: List[int]) -> int:\n        \"\"\"Processes a list to find the largest prime digit sum.\n        This method delegates to the execute method for its core logic.\"\"\"\n        return self.execute(input_list)\ndef skjkasdkd(lst: List[int]) -> int:\n    \"\"\"Finds the largest prime value in a list and returns the sum of its digits.\n    This function serves as the entry point and delegates to PrimeDigitSumProcessor.\"\"\"\n    processor = PrimeDigitSumProcessor()\n    return processor.execute(lst)"}
{"task_id": "HumanEval/96", "solution": "def is_prime(number):\n    \"\"\"Determines if a given number is mathematically prime using trial division.\n    It checks for divisibility up to its square root.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    \n    i = 3\n    # Check for factors up to the square root of the number.\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef count_up_to(n):\n    \"\"\"Generates an array of prime numbers less than n, starting from 2.\n    It utilizes the is_prime helper function to identify primes.\"\"\"\n    primes = []\n    if n <= 1:\n        return primes # Handles n=0 and n=1 as per requirements.\n\n    for candidate in range(2, n):\n        if is_prime(candidate):\n            primes.append(candidate)\n            \n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    keys = list(dict.keys())\n\n    if not keys:\n        return False\n\n    first_key = keys[0]\n\n    # If the first key is not a string, consistency cannot be met.\n    if not isinstance(first_key, str):\n        return False\n\n    # Determine the expected case based on the first key.\n    is_lower_case_expected = first_key.islower()\n    is_upper_case_expected = first_key.isupper()\n\n    # If the first key is neither all lowercase nor all uppercase,\n    # then no consistent case can be established for the dictionary.\n    if not is_lower_case_expected and not is_upper_case_expected:\n        return False\n\n    # Iterate through all keys to ensure consistency with the determined case.\n    for key in keys:\n        # If any key is not a string, it violates the requirement.\n        if not isinstance(key, str):\n            return False\n        \n        # Check if the current key matches the expected case.\n        if is_lower_case_expected:\n            if not key.islower():\n                return False\n        # If not lower-case-expected, it must be upper-case-expected.\n        elif is_upper_case_expected:\n            if not key.isupper():\n                return False\n            \n    return True"}
{"task_id": "HumanEval/96", "solution": "def _handle_edge_cases(n: int) -> list[int] | None:\n    \"\"\"Handles special cases for n <= 1 by returning an empty list.\"\"\"\n    if n <= 1:\n        return []\n    return None\ndef _is_prime(number: int) -> bool:\n    \"\"\"Determines if a number is prime using trial division.\"\"\"\n    if number < 2:\n        return False\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return False\n    return True\ndef _generate_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates all prime numbers less than the given limit.\"\"\"\n    primes = []\n    for candidate in range(2, limit):\n        if _is_prime(candidate):\n            primes.append(candidate)\n    return primes\ndef _build_result_array(primes: list[int]) -> list[int]:\n    \"\"\"Constructs the final result array from a list of prime numbers.\"\"\"\n    return primes\ndef _sort_ascending(array: list[int]) -> list[int]:\n    \"\"\"Sorts an array of integers in ascending order.\"\"\"\n    return sorted(array)\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of\n    prime numbers less than that value.\n    \"\"\"\n    edge_case_result = _handle_edge_cases(n)\n    if edge_case_result is not None:\n        return edge_case_result\n\n    primes_list = _generate_primes_up_to(n)\n    result_array = _build_result_array(primes_list)\n    sorted_array = _sort_ascending(result_array)\n    return sorted_array"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Calculates the product of the unit digits of two integers.\n    It assumes valid input and correctly handles negative numbers by using absolute values.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/97", "solution": "def _extract_unit_digit(number: int) -> int:\n    \"\"\"Extracts the unit digit of an integer, handling negative numbers by using their absolute value.\"\"\"\n    return abs(number) % 10\ndef _calculate_product(digit1: int, digit2: int) -> int:\n    \"\"\"Calculates the product of two single-digit integers.\"\"\"\n    return digit1 * digit2\ndef multiply(a, b):\n    \"\"\"Completes the function that takes two integers and returns the product of their unit digits.\n    Handles negative integers and zero products correctly.\n    \"\"\"\n    unit_digit_a = _extract_unit_digit(a)\n    unit_digit_b = _extract_unit_digit(b)\n    return _calculate_product(unit_digit_a, unit_digit_b)"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Counts uppercase vowels at even indices in a string.\n    Processes string input through direct character analysis.\n    \"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for index, char in enumerate(s):\n        if index % 2 == 0:\n            if char in UPPERCASE_VOWELS:\n                count += 1\n    return count"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    \"\"\"\n    Count uppercase vowels at even indices in string.\n    Processes characters at even indices and validates them as uppercase vowels.\n    \"\"\"\n    def _is_uppercase_vowel(char: str) -> bool:\n        \"\"\"Helper function to check if a character is an uppercase vowel.\"\"\"\n        return char in 'AEIOU'\n\n    def _is_even_index(index: int) -> bool:\n        \"\"\"Helper function to check if an index is even.\"\"\"\n        return index % 2 == 0\n\n    count = 0\n    for i, char in enumerate(s):\n        if _is_even_index(i) and _is_uppercase_vowel(char):\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "def _parse_string_to_number(value: str) -> float:\n    \"\"\"Parse string input to float.\n    Trusts the input is a valid numerical string representation.\n    \"\"\"\n    return float(value)\ndef _is_equidistant(num: float) -> bool:\n    \"\"\"Check if number is exactly halfway between two integers.\n    This identifies numbers with a fractional part of exactly 0.5.\n    \"\"\"\n    return abs(num) % 1 == 0.5\ndef _round_away_from_zero(num: float) -> int:\n    \"\"\"Round equidistant values away from zero.\n    For positive numbers, it rounds up; for negative, it rounds down.\n    \"\"\"\n    if num >= 0:\n        return int(num + 0.5)\n    else:\n        return int(num - 0.5)\ndef closest_integer(value: str) -> int:\n    \"\"\"Main function for converting string to closest integer with away-from-zero rounding.\n    Handles both standard rounding and away-from-zero for equidistant values.\n    \"\"\"\n    f_val = _parse_string_to_number(value)\n\n    if _is_equidistant(f_val):\n        return _round_away_from_zero(f_val)\n    else:\n        # For non-equidistant values, standard rounding applies.\n        # Python's round() provides the nearest integer, which we convert to int.\n        return int(round(f_val))"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    '''\n    Converts a string number to its closest integer, rounding equidistant values away from zero.\n    This ensures numbers like 14.5 round to 15 and -14.5 round to -15.\n    '''\n    num_float = float(value)\n\n    if num_float >= 0:\n        return int(num_float + 0.5)\n    else:\n        return int(num_float - 0.5)"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits an input string into words, treating commas and spaces as delimiters.\n    It preserves word case and order, returning a list of extracted words.\n    \"\"\"\n    # First, replace all commas with spaces to unify delimiters.\n    # Then, split the string by spaces; .split() handles multiple spaces and leading/trailing spaces correctly.\n    return s.replace(',', ' ').split()"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Generates a list representing stone counts across n levels,\n    following a progression where each subsequent level has 2 more stones.\n    \"\"\"\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
{"task_id": "HumanEval/100", "solution": "from typing import List\ndef make_a_pile(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, generate a pile of n levels.\n    The first level has n stones, and subsequent levels increment by 2 stones to maintain the odd/even sequence type set by n.\n    \"\"\"\n    pile_of_stones = []\n    current_level_stones = n\n\n    for _ in range(n):\n        pile_of_stones.append(current_level_stones)\n        current_level_stones += 2\n    \n    return pile_of_stones"}
{"task_id": "HumanEval/101", "solution": "def words_string(s: str) -> list[str]:\n    \"\"\"\n    Split string into words separated by commas or spaces.\n    Returns a list of individual words preserving original order.\n    \"\"\"\n    # Replace all commas with spaces to unify delimiters.\n    # Then split the resulting string by whitespace, which handles multiple spaces\n    # and removes empty strings, effectively preserving word content and order.\n    return s.replace(\",\", \" \").split()"}
{"task_id": "HumanEval/102", "solution": "import math\ndef _is_even(number):\n    \"\"\"Checks if number is even using modulo operation.\"\"\"\n    return int(number) % 2 == 0\ndef _validate_input(x, y):\n    \"\"\"Validates inputs are positive numbers and x <= y.\"\"\"\n    return x > 0 and y > 0 and x <= y\ndef _find_largest_even_in_range(start_val, end_val):\n    \"\"\"Finds largest even integer in inclusive range [start_val, end_val].\"\"\"\n    start_int = math.ceil(start_val)\n    end_int = math.floor(end_val)\n\n    if start_int > end_int:\n        return -1 # No valid integer range\n\n    # Check from the upper bound downwards for the largest even number.\n    if _is_even(end_int):\n        return end_int\n    elif end_int - 1 >= start_int:\n        return end_int - 1\n    else:\n        return -1 # No even number found in the valid integer range.\ndef choose_num(x, y):\n    \"\"\"Main function that finds largest even integer in range [x, y].\"\"\"\n    if not _validate_input(x, y):\n        return -1\n    \n    return _find_largest_even_in_range(x, y)"}
{"task_id": "HumanEval/102", "solution": "def validate_inputs(x, y):\n    \"\"\"Validates that input parameters x and y are positive numbers.\"\"\"\n    return x > 0 and y > 0\ndef validate_range(x, y):\n    \"\"\"Validates that x is less than or equal to y for a valid range.\"\"\"\n    return x <= y\ndef find_largest_even_in_range(start, end):\n    \"\"\"Calculates the largest even integer in the given range [start, end] with O(1) complexity.\n    Returns -1 if no even integer exists within the range.\"\"\"\n    \n    if end % 2 == 0:\n        candidate_largest_even = end\n    else:\n        candidate_largest_even = end - 1\n        \n    if candidate_largest_even >= start:\n        return int(candidate_largest_even)\n    else:\n        return -1\ndef choose_num(x, y):\n    \"\"\"This function finds the largest even integer within the inclusive range [x, y].\n    It returns -1 if the range is invalid or no such even number exists.\"\"\"\n    \n    x_int = int(x)\n    y_int = int(y)\n\n    if not validate_inputs(x_int, y_int):\n        return -1\n\n    if not validate_range(x_int, y_int):\n        return -1\n\n    return find_largest_even_in_range(x_int, y_int)"}
{"task_id": "HumanEval/103", "solution": "import math\ndef validate_range_order(n: int, m: int) -> bool:\n    \"\"\"Validates that n <= m for a valid range.\n    Returns True if n <= m, False otherwise.\n    \"\"\"\n    return n <= m\ndef calculate_range_sum(n: int, m: int) -> int:\n    \"\"\"Calculates the sum of integers from n to m inclusive.\n    Uses the arithmetic series formula for efficiency.\n    \"\"\"\n    return (m - n + 1) * (n + m) // 2\ndef calculate_range_count(n: int, m: int) -> int:\n    \"\"\"Calculates the count of integers from n to m inclusive.\n    Returns the number of integers in the range.\n    \"\"\"\n    return m - n + 1\ndef compute_average(total_sum: int, count: int) -> float:\n    \"\"\"Computes the arithmetic average from a sum and count.\n    Returns the average as a float.\n    \"\"\"\n    return total_sum / count\ndef round_to_nearest(value: float) -> int:\n    \"\"\"Rounds a float value to the nearest integer, using half-up rounding for positive values.\n    Returns the rounded integer.\n    \"\"\"\n    return math.floor(value + 0.5)\ndef convert_to_binary(value: int) -> str:\n    \"\"\"Converts an integer to its binary representation without the '0b' prefix.\n    Uses the built-in bin() function and slices the result.\n    \"\"\"\n    return bin(value)[2:]\ndef format_binary_string(binary_str: str) -> str:\n    \"\"\"Adds the '0b' prefix to a binary string.\n    Returns the formatted binary string.\n    \"\"\"\n    return f\"0b{binary_str}\"\ndef rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers in a range and converts the result to binary.\n    Returns -1 if n is greater than m, otherwise returns a binary string with a '0b' prefix.\n    \"\"\"\n    if not validate_range_order(n, m):\n        return -1\n\n    total_sum = calculate_range_sum(n, m)\n    count = calculate_range_count(n, m)\n    \n    average = compute_average(total_sum, count)\n    rounded_int = round_to_nearest(average)\n    \n    binary_str_no_prefix = convert_to_binary(rounded_int)\n    formatted_binary = format_binary_string(binary_str_no_prefix)\n    \n    return formatted_binary"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n\n    def extract_digits(number: int) -> list[int]:\n        \"\"\"Extracts individual digits from a number for analysis.\n        It converts the number to a string and then to a list of integers.\n        \"\"\"\n        return [int(d) for d in str(number)]\n\n    def has_even_digit(number: int) -> bool:\n        \"\"\"Determines if a number contains any even digit (0,2,4,6,8).\n        It checks each digit obtained from extract_digits.\n        \"\"\"\n        for digit in extract_digits(number):\n            if digit % 2 == 0:\n                return True\n        return False\n\n    filtered_numbers = []\n    for num in x:\n        if not has_even_digit(num):\n            filtered_numbers.append(num)\n\n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n: int, m: int) -> str | int:\n    \"\"\"Computes the rounded average of integers in a range and converts it to binary.\n    Returns -1 if the range is invalid (n > m).\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the count of numbers in the range [n, m]\n    count = m - n + 1\n    # Calculate the sum of integers from n to m using arithmetic series formula\n    total_sum = (count * (n + m)) // 2\n\n    # Compute the average and round it to the nearest integer\n    average = total_sum / count\n    rounded_result = round(average)\n\n    # Convert the rounded result to its binary representation\n    return bin(rounded_result)"}
{"task_id": "HumanEval/104", "solution": "def _has_only_odd_digits(number: int) -> bool:\n    \"\"\"Checks if all digits in the given integer are odd.\n    Returns True if all digits are odd, False otherwise.\"\"\"\n    return all(int(digit) % 2 != 0 for digit in str(number))\ndef unique_digits(x: list[int]) -> list[int]:\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n    filtered_numbers = [num for num in x if _has_only_odd_digits(num)]\n    return sorted(filtered_numbers)"}
{"task_id": "HumanEval/105", "solution": "from typing import List\nDIGIT_TO_WORD_MAP = {\n    1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n    6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n}\ndef _filter_valid_digits(arr: List[int]) -> List[int]:\n    \"\"\"Helper function to filter digits 1-9.\"\"\"\n    return [n for n in arr if 1 <= n <= 9]\ndef _convert_digit_to_word(digit: int) -> str:\n    \"\"\"Helper function to convert digit to word.\"\"\"\n    return DIGIT_TO_WORD_MAP[digit]\ndef by_length(arr: List[int]) -> List[str]:\n    \"\"\"\n    Given an array of integers, sort valid digits, reverse, and convert to word names.\n    Ignores numbers outside the 1-9 range and returns an empty array for empty input.\n    \"\"\"\n    if not arr:\n        return []\n\n    filtered_digits = _filter_valid_digits(arr)\n    sorted_digits = sorted(filtered_digits)\n    reversed_digits = sorted_digits[::-1]\n    word_names = [_convert_digit_to_word(digit) for digit in reversed_digits]\n\n    return word_names"}
{"task_id": "HumanEval/105", "solution": "class DigitConverter:\n    \"\"\"Handles digit to name conversion logic.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes digit name mappings.\"\"\"\n        self._digit_names = {\n            1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n            6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n        }\n\n    def convert_to_name(self, digit: int) -> str:\n        \"\"\"Converts a single digit (1-9) to its English name.\"\"\"\n        return self._digit_names[digit]\n\n    def convert_array(self, digits: list[int]) -> list[str]:\n        \"\"\"Converts an array of digits (1-9) to their English names.\"\"\"\n        return [self.convert_to_name(d) for d in digits]\nclass IntegerArray:\n    \"\"\"Encapsulates integer array operations and transformations.\"\"\"\n    def __init__(self, integers: list[int]):\n        \"\"\"Initializes with a list of integers.\"\"\"\n        self._integers = list(integers)\n\n    def filter(self, min_val: int, max_val: int) -> 'IntegerArray':\n        \"\"\"Filters values to include only those within the specified range.\"\"\"\n        filtered_list = [i for i in self._integers if min_val <= i <= max_val]\n        return IntegerArray(filtered_list)\n\n    def sort(self) -> 'IntegerArray':\n        \"\"\"Sorts the integers in ascending numerical order.\"\"\"\n        sorted_list = sorted(self._integers)\n        return IntegerArray(sorted_list)\n\n    def reverse(self) -> 'IntegerArray':\n        \"\"\"Reverses the order of the integers in the array.\"\"\"\n        reversed_list = list(reversed(self._integers))\n        return IntegerArray(reversed_list)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the array of integers is empty.\"\"\"\n        return not self._integers\n\n    def to_list(self) -> list[int]:\n        \"\"\"Returns the internal list of integers.\"\"\"\n        return self._integers\nclass ArrayProcessor:\n    \"\"\"Orchestrates the complete by_length algorithm workflow.\"\"\"\n    def process_array(self, input_array: list[int]) -> list[str]:\n        \"\"\"Processes an integer array through filtering, sorting, reversing, and conversion.\"\"\"\n        integer_arr = IntegerArray(input_array)\n        processed_integers = integer_arr.filter(1, 9).sort().reverse().to_list()\n\n        digit_converter = DigitConverter()\n        result_names = digit_converter.convert_array(processed_integers)\n        return result_names\ndef by_length(arr):\n    \"\"\"\n    Filters, sorts, reverses, and converts integers in an array to their English names.\n    Ignores numbers outside the 1-9 range and handles empty inputs.\n    \"\"\"\n    processor = ArrayProcessor()\n    return processor.process_array(arr)"}
{"task_id": "HumanEval/106", "solution": "def factorial(i: int) -> int:\n    \"\"\"Calculates the factorial of a given integer.\n    Returns i! (1 * 2 * ... * i).\"\"\"\n    res = 1\n    for k in range(1, i + 1):\n        res *= k\n    return res\ndef sum_range(i: int) -> int:\n    \"\"\"Calculates the sum of numbers from 1 up to a given integer.\n    Returns 1 + 2 + ... + i.\"\"\"\n    res = 0\n    for k in range(1, i + 1):\n        res += k\n    return res\ndef f(n: int) -> list:\n    \"\"\"Implement the function f that takes n as a parameter,\n    and returns a list of size n, based on index parity.\"\"\"\n    \n    result_list = []\n    for i in range(1, n + 1):  # i starts from 1, up to n (1-based indexing)\n        if i % 2 == 0:  # If i is even, calculate factorial\n            calculated_value = factorial(i)\n        else:  # If i is odd, calculate sum from 1 to i\n            calculated_value = sum_range(i)\n        result_list.append(calculated_value) # Place value at position (i-1)\n    return result_list"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Implement the function f that takes n as a parameter, and returns a list of size n,\n    where each element is a factorial for even indices or a sum for odd indices (1-based).\n    \"\"\"\n\n    def factorial_calc(i):\n        \"\"\"Calculates the factorial of i (multiplication of numbers from 1 to i).\"\"\"\n        res = 1\n        for j in range(1, i + 1):\n            res *= j\n        return res\n\n    def sum_calc(i):\n        \"\"\"Calculates the sum of numbers from 1 to i (addition of numbers from 1 to i).\"\"\"\n        res = 0\n        for j in range(1, i + 1):\n            res += j\n        return res\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result.append(factorial_calc(i))\n        else:  # i is odd\n            result.append(sum_calc(i))\n    return result"}
{"task_id": "HumanEval/107", "solution": "def is_palindrome(num: int) -> bool:\n    \"\"\"\n    Check if a number is a palindrome by comparing its string representation.\n    This helper is used by even_odd_palindrome.\n    \"\"\"\n    return str(num) == str(num)[::-1]\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    if not (1 <= n <= 1000):\n        raise ValueError(\"Input must be between 1 and 1000\")\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/107", "solution": "def _is_palindrome(num):\n    \"\"\"Checks if an integer is a palindrome by comparing its string representation with its reverse.\"\"\"\n    s = str(num)\n    return s == s[::-1]\ndef even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of digits is greater than zero.\n    Handles special digit sum rules for negative numbers where only the first digit is negative.\n    \"\"\"\n\n    def _calculate_digit_sum(number):\n        \"\"\"\n        Calculates the sum of digits for a given number, applying special rules for negative numbers.\n        The first digit of a negative number carries the sign, while subsequent digits are positive.\n        \"\"\"\n        str_num = str(number)\n        total_sum = 0\n        \n        if str_num.startswith('-'):\n            # For negative numbers, the first digit (after the sign) is negative\n            # and subsequent digits are positive.\n            first_digit_val = int(str_num[1])\n            total_sum -= first_digit_val\n            \n            # Sum the rest of the digits as positive\n            for digit_char in str_num[2:]:\n                total_sum += int(digit_char)\n        else:\n            # For positive numbers and zero, sum all digits as positive.\n            for digit_char in str_num:\n                total_sum += int(digit_char)\n                \n        return total_sum\n\n    if not arr:\n        return 0\n\n    count = 0\n    for num in arr:\n        digit_sum = _calculate_digit_sum(num)\n        if digit_sum > 0:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/108", "solution": "def extract_digits(number: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer's absolute value.\n    This function handles the conversion of a number to its absolute string representation.\"\"\"\n    s = str(abs(number))\n    return [int(digit) for digit in s]\ndef apply_sign_rules(digits: list[int], is_negative: bool) -> int:\n    \"\"\"Applies signed digit rules, making the first digit negative if the original number was negative.\n    Subsequent digits retain their positive value as extracted.\"\"\"\n    if not digits:\n        return 0\n    \n    signed_digits_sum = 0\n    if is_negative:\n        signed_digits_sum += -digits[0]  # First digit is negative\n        for i in range(1, len(digits)):\n            signed_digits_sum += digits[i] # Remaining digits are positive\n    else:\n        for digit in digits:\n            signed_digits_sum += digit # All digits are positive\n            \n    return signed_digits_sum\ndef calculate_digit_sum(number: int) -> int:\n    \"\"\"Calculates the digit sum of a number following specialized signed digit rules.\n    It determines negativity, extracts digits, and then applies the sign rules to sum them.\"\"\"\n    is_negative = number < 0\n    digits = extract_digits(number)\n    return apply_sign_rules(digits, is_negative)\ndef count_nums(arr: list) -> int:\n    \"\"\"\n    Counts elements in an array where the sum of digits is greater than zero.\n    For negative numbers, the first digit carries the negative sign while subsequent digits are positive.\n    \"\"\"\n    count = 0\n    if not arr:\n        return 0\n    \n    for num in arr:\n        digit_sum = calculate_digit_sum(num)\n        if digit_sum > 0:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/110", "solution": "def count_even_numbers(numbers):\n    \"\"\"Counts the number of even integers in a list.\n    Iterates through the list and checks divisibility by 2.\"\"\"\n    even_count = 0\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n    return even_count\ndef exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made all even by exchanging elements with lst2.\n    Counts total even numbers across both lists and compares with lst1's length.\"\"\"\n    \n    even_count_lst1 = count_even_numbers(lst1)\n    even_count_lst2 = count_even_numbers(lst2)\n    \n    total_available_even_numbers = even_count_lst1 + even_count_lst2\n    \n    if total_available_even_numbers >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/109", "solution": "from typing import List\nclass ArrayUtils:\n    @staticmethod\n    def is_empty(arr: List[int]) -> bool:\n        \"\"\"Checks if the given array is empty.\"\"\"\n        return not arr\n\n    @staticmethod\n    def validate_input(arr: List[int]) -> bool:\n        \"\"\"Validates input array format, trusting caller's input types and uniqueness guarantees.\"\"\"\n        return True\nclass RightShiftOperation:\n    @staticmethod\n    def execute(arr: List[int]) -> List[int]:\n        \"\"\"Performs a single right shift operation on the array.\"\"\"\n        if not arr:\n            return []\n        return [arr[-1]] + arr[:-1]\n\n    @staticmethod\n    def get_all_rotations(arr: List[int]) -> List[List[int]]:\n        \"\"\"Generates all possible right shift rotations of the array.\"\"\"\n        if not arr:\n            return [[]]\n        n = len(arr)\n        rotations = []\n        current_arr = list(arr)\n        for _ in range(n):\n            rotations.append(list(current_arr))\n            current_arr = RightShiftOperation.execute(current_arr)\n        return rotations\nclass SortValidator:\n    @staticmethod\n    def is_non_decreasing(arr: List[int]) -> bool:\n        \"\"\"Checks if the array is in non-decreasing order.\"\"\"\n        return all(arr[i] <= arr[i+1] for i in range(len(arr) - 1))\n\n    @staticmethod\n    def can_be_sorted_by_rotation(arr: List[int]) -> bool:\n        \"\"\"Determines if the given array, or any of its rotations, could be sorted.\n        This checks if the input `arr` itself is non-decreasing.\"\"\"\n        return SortValidator.is_non_decreasing(arr)\nclass ArraySorter:\n    def __init__(self):\n        \"\"\"Initializes ArraySorter with its necessary dependencies.\"\"\"\n        self._sort_validator = SortValidator()\n        self._right_shift_operation = RightShiftOperation()\n\n    def check_sortability(self, arr: List[int]) -> bool:\n        \"\"\"Determines if the array can be sorted into non-decreasing order by right shifts.\"\"\"\n        if self._sort_validator.is_non_decreasing(arr):\n            return True\n        return self._simulate_rotations(arr)\n\n    def _simulate_rotations(self, arr: List[int]) -> bool:\n        \"\"\"Simulates all possible right shift rotations and checks if any are sorted.\"\"\"\n        all_rotations = self._right_shift_operation.get_all_rotations(arr)\n        for rotation in all_rotations:\n            if self._sort_validator.is_non_decreasing(rotation):\n                return True\n        return False\ndef move_one_ball(arr: List[int]) -> bool:\n    \"\"\"We have an array 'arr' of N integers. Determine if it is possible to get\n    an array sorted in non-decreasing order using only right shift operations.\"\"\"\n\n    array_utils = ArrayUtils()\n    array_sorter = ArraySorter()\n\n    if array_utils.is_empty(arr):\n        return True\n\n    array_utils.validate_input(arr)\n    return array_sorter.check_sortability(arr)"}
{"task_id": "HumanEval/109", "solution": "from typing import List\ndef is_empty(arr: List[int]) -> bool:\n    \"\"\"Checks if the input array is empty. Returns True if empty, False otherwise.\"\"\"\n    return len(arr) == 0\ndef is_sorted(arr: List[int]) -> bool:\n    \"\"\"Checks if an array is in non-decreasing order. Returns True if sorted, False otherwise.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            return False\n    return True\ndef find_rotation_point(arr: List[int]) -> int:\n    \"\"\"Detects the index where a sorted array was rotated (index of the minimum element). Returns 0 if already sorted.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    # Find the pivot point where arr[i] > arr[i+1]. The rotation point is i+1.\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            return i + 1\n    return 0 # Array is already sorted, rotation point is 0.\ndef is_rotated_sorted(arr: List[int]) -> bool:\n    \"\"\"Determines if an array is sorted or can be sorted by right shifts. Checks if it's a rotated sorted array.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    rotation_idx = find_rotation_point(arr)\n    \n    # Reconstruct the array as if it were sorted from its minimum element.\n    sorted_candidate = arr[rotation_idx:] + arr[:rotation_idx]\n\n    return is_sorted(sorted_candidate)\ndef analyze_sortability(arr: List[int]) -> bool:\n    \"\"\"Core sortability analysis logic for a non-empty array. Uses rotation detection to determine sortability.\"\"\"\n    return is_rotated_sorted(arr)\ndef move_one_ball(arr: List[int]) -> bool:\n    \"\"\"Determines if an array can be sorted non-decreasingly by right shifts. Handles empty arrays and orchestrates analysis.\"\"\"\n    if is_empty(arr):\n        return True\n    \n    return analyze_sortability(arr)"}
{"task_id": "HumanEval/110", "solution": "def count_even_numbers(numbers):\n    \"\"\"Counts the number of even integers in a list.\n    This helper function supports the main exchange logic.\"\"\"\n    even_count = 0\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n    return even_count\ndef exchange(lst1, lst2):\n    \"\"\"Determines if elements can be exchanged between two lists to make lst1 contain only even numbers.\n    Returns \"YES\" if possible, otherwise \"NO\".\"\"\"\n    \n    # Calculate the total count of even numbers available across both lists.\n    total_even_available = count_even_numbers(lst1) + count_even_numbers(lst2)\n    \n    # If there are enough even numbers to fill lst1, then it's possible.\n    if total_even_available >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n\n    # Helper function to remove characters from a string.\n    def _filter_characters(source: str, to_delete: str) -> str:\n        deleted_chars_set = set(to_delete)\n        result_chars = [char for char in source if char not in deleted_chars_set]\n        return \"\".join(result_chars)\n\n    # Helper function to check if a string is a palindrome.\n    def _is_palindrome(text: str) -> bool:\n        return text == text[::-1]\n\n    processed_string = _filter_characters(s, c)\n    is_pal = _is_palindrome(processed_string)\n    return (processed_string, is_pal)"}
{"task_id": "HumanEval/111", "solution": "def histogram(test: str) -> dict:\n    \"\"\"Given a string representing space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    # Collect all valid lowercase letters from the input string, ignoring spaces and other characters.\n    all_letters = []\n    for part in test.split(' '):\n        for char in part:\n            if 'a' <= char <= 'z':\n                all_letters.append(char)\n\n    # Count the frequency of each collected letter.\n    counts = {}\n    for letter in all_letters:\n        counts[letter] = counts.get(letter, 0) + 1\n\n    # Find the maximum frequency among all letters.\n    if not counts:\n        return {}\n\n    max_frequency = 0\n    for count in counts.values():\n        if count > max_frequency:\n            max_frequency = count\n\n    # Filter the counts to include only letters that have the maximum frequency.\n    result = {}\n    for letter, count in counts.items():\n        if count == max_frequency:\n            result[letter] = count\n            \n    return result"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string, counts letter frequencies and returns a dictionary of the most frequent letters and their counts.\n    Handles multiple letters with identical maximum frequencies and empty input strings.\n    \"\"\"\n    letter_counts = {}\n    for char in test:\n        if char != ' ':\n            letter_counts[char] = letter_counts.get(char, 0) + 1\n\n    max_freq = 0\n    if letter_counts:\n        max_freq = max(letter_counts.values())\n\n    result = {}\n    for letter, count in letter_counts.items():\n        if count == max_freq:\n            result[letter] = count\n    return result"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n\n    def _filter_characters(source: str, chars_to_delete: str) -> str:\n        \"\"\"Removes characters from the source string that are present in chars_to_delete.\"\"\"\n        deletion_set = set(chars_to_delete)\n        filtered_chars = [char for char in source if char not in deletion_set]\n        return \"\".join(filtered_chars)\n\n    def _is_palindrome(text: str) -> bool:\n        \"\"\"Checks if a string is a palindrome by comparing it to its reverse.\"\"\"\n        return text == text[::-1]\n\n    filtered_s = _filter_characters(s, c)\n    is_palindrome_status = _is_palindrome(filtered_s)\n    return (filtered_s, is_palindrome_status)"}
{"task_id": "HumanEval/113", "solution": "TEMPLATE = \"the number of odd elements in the string i of the input.\"\nODD_DIGITS_CHARS = {'1', '3', '5', '7', '9'}\ndef _validate_input(lst: list) -> bool:\n    \"\"\"Validates the input list.\n    Per critical requirements, no actual validation logic is performed; input is trusted.\n    \"\"\"\n    return True\ndef _count_odd_digits(digit_string: str) -> int:\n    \"\"\"Counts odd digits in a given string.\n    It iterates through characters and checks against predefined odd digits.\n    \"\"\"\n    count = 0\n    for digit_char in digit_string:\n        if digit_char in ODD_DIGITS_CHARS:\n            count += 1\n    return count\ndef _format_output(count: int) -> str:\n    \"\"\"Formats an output string using a template, replacing 'i' with the given count.\n    The specific replacement ensures 'in' becomes '<count>n' and 'i' becomes '<count>'.\n    \"\"\"\n    return TEMPLATE.replace('i', str(count))\ndef odd_count(lst: list) -> list:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    _validate_input(lst)\n    result = []\n    for digit_string in lst:\n        odd_digit_count = _count_odd_digits(digit_string)\n        formatted_string = _format_output(odd_digit_count)\n        result.append(formatted_string)\n    return result"}
{"task_id": "HumanEval/114", "solution": "from typing import List\ndef minSubArraySum(nums: List[int]) -> int:\n    \"\"\"\n    Finds the minimum sum of any non-empty contiguous subarray using a modified Kadane's algorithm.\n    It handles arrays with positive, negative, or mixed integer values efficiently.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each output element replaces 'i' with the count of odd digits from the corresponding input string.\n    \"\"\"\n\n    def is_odd_digit(digit: str) -> bool:\n        \"\"\"Determines if a single character digit is odd (1, 3, 5, 7, 9).\"\"\"\n        return digit in ['1', '3', '5', '7', '9']\n\n    def count_odd_digits(digit_string: str) -> int:\n        \"\"\"Counts the number of odd digits in a given string.\"\"\"\n        count = 0\n        for digit_char in digit_string:\n            if is_odd_digit(digit_char):\n                count += 1\n        return count\n\n    def format_output_string(odd_count_val: int) -> str:\n        \"\"\"Formats the output message string using the provided odd digit count.\"\"\"\n        return f\"the number of odd elements {odd_count_val}n the str{odd_count_val}ng {odd_count_val} of the {odd_count_val}nput.\"\n\n    results = []\n    for digit_string_item in lst:\n        odd_digits_count = count_odd_digits(digit_string_item)\n        formatted_message = format_output_string(odd_digits_count)\n        results.append(formatted_message)\n    return results"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Calculates the minimum sum of any non-empty contiguous subarray.\n    This uses a modified Kadane's algorithm variant for O(N) time complexity.\n    \"\"\"\n    current_min_sum = nums[0]\n    overall_min_sum = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min_sum = min(nums[i], current_min_sum + nums[i])\n        overall_min_sum = min(overall_min_sum, current_min_sum)\n\n    return overall_min_sum"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of bucket operations needed to extract water from a grid of wells.\n    It processes each well to count its water and sums the required bucket lowering operations.\n    \"\"\"\n\n    def _validate_inputs(grid, capacity):\n        \"\"\"\n        This function would typically validate inputs per NFR-003, NFR-004, NFR-005.\n        As per critical requirements, it trusts caller's inputs and performs no checks or raises exceptions.\n        \"\"\"\n        pass\n\n    def _count_water_in_well(well_row):\n        \"\"\"\n        Counts the total water units (represented by 1s) present in a single well row.\n        This directly implements the interpretation of binary grid values for water presence.\n        \"\"\"\n        return sum(well_row)\n\n    def _calculate_operations(water_count, capacity):\n        \"\"\"\n        Calculates the minimum number of bucket operations required to extract a given amount of water.\n        It uses ceiling division to ensure all water is extracted, even if it's a partial bucket.\n        \"\"\"\n        if water_count == 0:\n            return 0\n        return math.ceil(water_count / capacity)\n\n    _validate_inputs(grid, capacity)\n\n    total_operations = 0\n    for well_row in grid:\n        water_count = _count_water_in_well(well_row)\n        operations_needed = _calculate_operations(water_count, capacity)\n        total_operations += operations_needed\n\n    return total_operations"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum bucket operations to empty all wells in a grid.\n    Each operation lowers a bucket into a well to extract water.\n    \"\"\"\n    total_operations = 0\n    for well in grid:\n        water_units = sum(well)\n        if water_units > 0:\n            operations_for_well = math.ceil(water_units / capacity)\n            total_operations += operations_for_well\n    return total_operations"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers based on the number of ones in their binary representation.\n    Numbers with the same count of ones are sorted by their decimal value.\n    \"\"\"\n\n    def _count_binary_ones(number: int) -> int:\n        \"\"\"\n        Counts the number of set bits (ones) in the binary representation of an integer.\n        For negative numbers, a 32-bit two's complement representation is used.\n        \"\"\"\n        if number == 0:\n            return 0\n        elif number > 0:\n            return bin(number).count('1')\n        else:  # number < 0\n            # For negative numbers, interpret as 32-bit two's complement.\n            # This aligns with common fixed-width interpretations for negative integers.\n            return bin(number & 0xFFFFFFFF).count('1')\n\n    def _get_sort_key(number: int) -> tuple:\n        \"\"\"\n        Generates a sort key tuple (ones_count, decimal_value) for a given number.\n        This tuple is used for primary (ones_count) and secondary (decimal_value) sorting.\n        \"\"\"\n        ones_count = _count_binary_ones(number)\n        return (ones_count, number)\n\n    # Use the helper function as the key for Python's built-in sorted function.\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/116", "solution": "def count_binary_ones(num):\n    \"\"\"Counts the number of ones in the binary representation of a non-negative integer.\n    It converts the number to binary string and counts '1's.\"\"\"\n    return bin(num).count('1')\ndef get_sort_key(num):\n    \"\"\"Generates a sorting key tuple based on binary ones count and decimal value.\n    Negative numbers are sorted by decimal value only.\"\"\"\n    if num < 0:\n        return (0, num)  # Primary sort by 0, secondary by decimal value for negatives\n    else:\n        ones_count = count_binary_ones(num)\n        return (ones_count, num)\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n    return sorted(arr, key=get_sort_key)"}
{"task_id": "HumanEval/117", "solution": "class StringProcessor:\n    \"\"\"Handles string parsing and validation operations.\n    Provides utilities for splitting strings and checking for emptiness.\n    \"\"\"\n    @staticmethod\n    def split_string(input_string: str) -> list[str]:\n        \"\"\"Splits the input string into words using spaces as delimiters.\"\"\"\n        return input_string.split()\n\n    @staticmethod\n    def is_empty(input_string: str) -> bool:\n        \"\"\"Checks if the given input string is empty.\"\"\"\n        return not input_string\nclass ConsonantCounter:\n    \"\"\"Provides consonant identification and counting functionality.\n    Includes methods to check for vowels and consonants, and to count consonants in a word.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    @staticmethod\n    def is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in ConsonantCounter.VOWELS\n\n    @staticmethod\n    def is_consonant(char: str) -> bool:\n        \"\"\"Determines if a character is a consonant, considering only letters.\"\"\"\n        return char.isalpha() and not ConsonantCounter.is_vowel(char)\n\n    @staticmethod\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        return sum(1 for char in word if ConsonantCounter.is_consonant(char))\nclass WordFilter:\n    \"\"\"Coordinates the word filtering process based on consonant count.\n    It utilizes ConsonantCounter to apply the filtering logic.\n    \"\"\"\n    @staticmethod\n    def filter_words(words: list[str], target_count: int) -> list[str]:\n        \"\"\"Filters words to include only those with an exact consonant count.\"\"\"\n        filtered_results = []\n        for word in words:\n            if ConsonantCounter.count_consonants(word) == target_count:\n                filtered_results.append(word)\n        return filtered_results\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of words\n    from s that contain exactly n consonants, maintaining original order.\n    It handles empty string inputs gracefully by returning an empty list.\n    \"\"\"\n    if StringProcessor.is_empty(s):\n        return []\n\n    words = StringProcessor.split_string(s)\n    return WordFilter.filter_words(words, n)"}
{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef is_vowel(char: str) -> bool:\n    \"\"\"Determine if a character is a vowel (case-insensitive).\n    Checks if the lowercase character is in the predefined VOWELS set.\n    \"\"\"\n    return char.lower() in VOWELS\ndef count_consonants(word: str) -> int:\n    \"\"\"Count consonants in a single word.\n    Iterates through characters, identifying letters that are not vowels.\n    \"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not is_vowel(char):\n            consonant_count += 1\n    return consonant_count\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"Filter words from string s that contain exactly n consonants.\n    Words are split by spaces, and results maintain original order.\n    \"\"\"\n    if not s:\n        return []\n\n    filtered_words = []\n    # Split using ' ' to strictly adhere to space delimiters and maintain order.\n    words = s.split(' ') \n\n    for word in words:\n        # Only process non-empty strings as actual words.\n        if word: \n            if count_consonants(word) == n:\n                filtered_words.append(word)\n    \n    return filtered_words"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the rightmost vowel between two consonants, ignoring word boundaries.\n    Returns the vowel or an empty string if none is found or word is too short.\n    \"\"\"\n    # CharacterHelper Component: Provides character classification utilities.\n    VOWELS = \"aeiouAEIOU\"\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English vowel.\"\"\"\n        return char in VOWELS\n\n    def is_valid_english_letter(char: str) -> bool:\n        \"\"\"Checks if a character is an English letter.\"\"\"\n        return char.isalpha()\n\n    def is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is an English consonant.\"\"\"\n        return is_valid_english_letter(char) and not is_vowel(char)\n\n    # PositionValidator Component: Provides position validation utilities.\n    def is_boundary_position(word_local: str, index_local: int) -> bool:\n        \"\"\"Checks if the given index is at a word boundary.\"\"\"\n        return index_local == 0 or index_local == len(word_local) - 1\n\n    def has_consonant_neighbors(word_local: str, index_local: int) -> bool:\n        \"\"\"Checks if a character at index has consonant neighbors.\"\"\"\n        # Requires at least 3 characters for neighbors to exist beyond boundaries.\n        if len(word_local) < 3 or is_boundary_position(word_local, index_local):\n            return False\n        left_char = word_local[index_local - 1]\n        right_char = word_local[index_local + 1]\n        return is_consonant(left_char) and is_consonant(right_char)\n\n    def is_valid_position(word_local: str, index_local: int) -> bool:\n        \"\"\"Validates if a vowel position is between two consonants and not at a boundary.\"\"\"\n        return (not is_boundary_position(word_local, index_local)) and \\\n               has_consonant_neighbors(word_local, index_local)\n\n    # Main logic of get_closest_vowel function\n    # Returns empty string if word is shorter than 3 characters.\n    if len(word) < 3:\n        return \"\"\n\n    # Searches from right to left, ignoring word boundaries (index 0 and len-1).\n    # The loop range goes from (len(word) - 2) down to 1.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        if is_vowel(char) and is_valid_position(word, i):\n            return char\n    \n    # Returns empty string if no valid vowel is found after the search.\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "import collections\nfrom typing import List, Tuple\nclass InputValidator:\n    \"\"\"\n    Validates input list format and character content.\n    \"\"\"\n    def validate_list_size(self, lst: List) -> bool:\n        \"\"\"Checks if the list contains exactly two elements.\"\"\"\n        return len(lst) == 2\n\n    def validate_parentheses_only(self, s: str) -> bool:\n        \"\"\"Checks if a string contains only '(' or ')' characters.\"\"\"\n        return all(c in '()' for c in s)\n\n    def validate_input(self, lst: List[str]) -> bool:\n        \"\"\"Validates the entire input list for size and character constraints.\"\"\"\n        if not self.validate_list_size(lst):\n            return False\n        for s in lst:\n            if not self.validate_parentheses_only(s):\n                return False\n        return True\nclass BalanceChecker:\n    \"\"\"\n    Determines if a string has balanced parentheses.\n    \"\"\"\n    def check_balance(self, s: str) -> bool:\n        \"\"\"Checks if all parentheses in a string are balanced using a counter.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0: # Closing parenthesis without an opening one\n                return False\n        return balance == 0\n\n    def count_parentheses(self, s: str) -> int:\n        \"\"\"Counts the net balance of parentheses (open - close).\"\"\"\n        open_count = s.count('(')\n        close_count = s.count(')')\n        return open_count - close_count\nclass ConcatenationHandler:\n    \"\"\"\n    Manages string concatenation operations and order testing.\n    \"\"\"\n    def concatenate(self, s1: str, s2: str) -> str:\n        \"\"\"Concatenates two strings.\"\"\"\n        return s1 + s2\n\n    def try_both_orders(self, s1: str, s2: str, balance_checker: BalanceChecker) -> bool:\n        \"\"\"Tests both concatenation orders to see if either produces a balanced string.\"\"\"\n        if balance_checker.check_balance(self.concatenate(s1, s2)):\n            return True\n        if balance_checker.check_balance(self.concatenate(s2, s1)):\n            return True\n        return False\nclass ParenthesesMatcher:\n    \"\"\"\n    Orchestrates the validation and balance checking process for parentheses strings.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the matcher with its required utility components.\"\"\"\n        self.input_validator = InputValidator()\n        self.balance_checker = BalanceChecker()\n        self.concatenation_handler = ConcatenationHandler()\n\n    def _validate_and_extract(self, lst: List[str]) -> Tuple[str, str]:\n        \"\"\"Validates the input list and extracts the two strings.\"\"\"\n        # This method is for internal use, assuming validation has passed\n        return lst[0], lst[1]\n\n    def process_input(self, lst: List[str]) -> str:\n        \"\"\"Processes the input list to determine if a balanced string can be formed.\"\"\"\n        if not self.input_validator.validate_input(lst):\n            return 'No'\n\n        s1, s2 = self._validate_and_extract(lst)\n        \n        if self.concatenation_handler.try_both_orders(s1, s2, self.balance_checker):\n            return 'Yes'\n        else:\n            return 'No'\ndef match_parens(lst: List[str]) -> str:\n    '''\n    Checks if two parentheses strings can be concatenated in some order to form a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise, handling input validation and edge cases gracefully.\n    '''\n    matcher = ParenthesesMatcher()\n    return matcher.process_input(lst)"}
{"task_id": "HumanEval/118", "solution": "def is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-sensitive).\"\"\"\n    return char in 'aeiouAEIOU'\ndef is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant (case-sensitive).\"\"\"\n    return char.isalpha() and not is_vowel(char)\ndef has_consonant_neighbors(word: str, position: int) -> bool:\n    \"\"\"Checks if a character at a given position has consonant neighbors.\"\"\"\n    return is_consonant(word[position - 1]) and is_consonant(word[position + 1])\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the rightmost vowel between two consonants in a word, case-sensitive.\"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and len-1).\n    for i in range(len(word) - 2, 0, -1):\n        if is_vowel(word[i]):\n            if has_consonant_neighbors(word, i):\n                return word[i]\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if two strings of parentheses can form a balanced string when concatenated in any order.\n    Delegates to helper functions for input validation, balance checking, and order testing.\n    '''\n\n    def is_balanced(s):\n        '''\n        Determines if a string of parentheses is balanced.\n        Uses a counter to track balance, returning False if balance drops below zero or is not zero at the end.\n        '''\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def validate_input(lst):\n        '''\n        Validates the input list format and string content.\n        Checks if the list contains exactly two strings composed only of '(' or ')'.\n        '''\n        if len(lst) != 2:\n            return False\n\n        for s in lst:\n            for char in s:\n                if char not in '()':\n                    return False\n        return True\n\n    def check_both_orders(s1, s2):\n        '''\n        Tests both possible concatenation orders of two strings for balance.\n        It returns True if either s1+s2 or s2+s1 forms a balanced string.\n        '''\n        if is_balanced(s1 + s2):\n            return True\n        if is_balanced(s2 + s1):\n            return True\n        return False\n\n    if not validate_input(lst):\n        return 'No'\n\n    s1, s2 = lst[0], lst[1]\n\n    if check_both_orders(s1, s2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/120", "solution": "def validate_array_length(length):\n    \"\"\"Checks if array length is within the valid range [1, 1000].\"\"\"\n    return 1 <= length <= 1000\ndef validate_element_range(arr):\n    \"\"\"Checks if all array elements are within the valid range [-1000, 1000].\"\"\"\n    for x in arr:\n        if not (-1000 <= x <= 1000):\n            return False\n    return True\ndef validate_k_range(k, array_length):\n    \"\"\"Checks if k is within the valid range [0, array_length].\"\"\"\n    return 0 <= k <= array_length\ndef validate_inputs(arr, k):\n    \"\"\"Performs comprehensive input validation for arr and k parameters.\"\"\"\n    if not validate_array_length(len(arr)):\n        return False\n    if not validate_element_range(arr):\n        return False\n    if not validate_k_range(k, len(arr)):\n        return False\n    return True\ndef find_k_maximum(arr, k):\n    \"\"\"Identifies the k largest elements from the array.\"\"\"\n    if k == 0:\n        return []\n    temp_arr = list(arr)\n    temp_arr.sort()  # Sorts in ascending order.\n    return temp_arr[-k:] # Returns the k largest elements, which are already sorted.\ndef sort_result(elements):\n    \"\"\"Sorts the given elements in ascending order.\"\"\"\n    return sorted(elements)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if not validate_inputs(arr, k):\n        raise ValueError(\"Invalid input parameters detected.\")\n\n    # Edge case: if k is 0, return an empty list immediately after validation.\n    if k == 0:\n        return []\n\n    k_elements = find_k_maximum(arr, k)\n    sorted_result = sort_result(k_elements)\n    return sorted_result"}
{"task_id": "HumanEval/120", "solution": "class InputValidator:\n    \"\"\"Input parameter validation and constraint checking.\"\"\"\n    @staticmethod\n    def validate_array_length(arr: list[int]) -> bool:\n        \"\"\"Validate array length is between 1 and 1000.\"\"\"\n        return 1 <= len(arr) <= 1000\n\n    @staticmethod\n    def validate_element_range(element: int) -> bool:\n        \"\"\"Validate element is between -1000 and 1000.\"\"\"\n        return -1000 <= element <= 1000\n\n    @staticmethod\n    def validate_k_value(k: int, array_length: int) -> bool:\n        \"\"\"Validate k is between 0 and array length.\"\"\"\n        return 0 <= k <= array_length\n\n    @staticmethod\n    def validate_inputs(arr: list[int], k: int) -> bool:\n        \"\"\"Validate all input parameters against defined constraints.\"\"\"\n        if not InputValidator.validate_array_length(arr):\n            return False\n        if not InputValidator.validate_k_value(k, len(arr)):\n            return False\n        for element in arr:\n            if not InputValidator.validate_element_range(element):\n                return False\n        return True\nclass ArrayProcessor:\n    \"\"\"Core algorithm for finding maximum k elements from array.\"\"\"\n    @staticmethod\n    def find_maximum_elements(arr: list[int], k: int) -> list[int]:\n        \"\"\"Find k maximum elements from array by sorting in descending order.\"\"\"\n        sorted_arr_desc = sorted(arr, reverse=True)\n        return sorted_arr_desc[:k]\nclass ResultFormatter:\n    \"\"\"Result sorting and output formatting.\"\"\"\n    @staticmethod\n    def sort_ascending(elements: list[int]) -> list[int]:\n        \"\"\"Sort elements in ascending order.\"\"\"\n        return sorted(elements)\ndef maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"Main entry point for maximum k elements function.\"\"\"\n    if k == 0:\n        return []\n\n    # Validate inputs as per design. Per critical requirements,\n    # we trust the caller's inputs and do not raise exceptions.\n    InputValidator.validate_inputs(arr, k)\n\n    max_elements = ArrayProcessor.find_maximum_elements(arr, k)\n    sorted_result = ResultFormatter.sort_ascending(max_elements)\n\n    return sorted_result"}
{"task_id": "HumanEval/121", "solution": "from typing import List\ndef _validate_input(lst: List[int]) -> bool:\n    \"\"\"Validates non-empty list requirement.\n    Returns True if the list is not empty, False otherwise.\n    \"\"\"\n    return len(lst) > 0\ndef _get_even_positions(lst: List[int]) -> List[int]:\n    \"\"\"Gets elements at even positions (0, 2, 4, etc.).\n    It iterates through the list and collects elements whose index is even.\n    \"\"\"\n    return [element for index, element in enumerate(lst) if index % 2 == 0]\ndef _filter_odd_elements(elements: List[int]) -> List[int]:\n    \"\"\"Filters a list to include only odd elements.\n    It checks each element and retains only those that are odd.\n    \"\"\"\n    return [element for element in elements if element % 2 != 0]\ndef _calculate_sum(elements: List[int]) -> int:\n    \"\"\"Calculates the sum of all elements in a list.\n    If the list is empty, it returns 0.\n    \"\"\"\n    return sum(elements)\ndef solution(lst: List[int]) -> int:\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    This function implements a functional pipeline for input processing.\n    \"\"\"\n    if not _validate_input(lst):\n        return 0\n\n    elements_at_even_positions = _get_even_positions(lst)\n    odd_elements_at_even_positions = _filter_odd_elements(elements_at_even_positions)\n    final_sum = _calculate_sum(odd_elements_at_even_positions)\n\n    return final_sum"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 2 == 0 and value % 2 != 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "from typing import List\ndef is_two_digit_element(value: int) -> bool:\n    \"\"\"Checks if an integer has at most two digits (absolute value <= 99).\"\"\"\n    return -99 <= value <= 99\ndef extract_first_k_elements(arr: List[int], k: int) -> List[int]:\n    \"\"\"Extracts the first k elements from the input array.\"\"\"\n    return arr[:k]\ndef filter_two_digit_elements(elements: List[int]) -> List[int]:\n    \"\"\"Filters a list of elements, keeping only those with at most two digits.\"\"\"\n    return [e for e in elements if is_two_digit_element(e)]\ndef calculate_sum(elements: List[int]) -> int:\n    \"\"\"Calculates the sum of all integers in the provided list.\"\"\"\n    return sum(elements)\ndef add_elements(arr: List[int], k: int) -> int:\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    Example:\n\n        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4\n        Output: 24 # sum of 21 + 3\n\n    Constraints:\n        1. 1 <= len(arr) <= 100\n        2. 1 <= k <= len(arr)\n    \"\"\"\n    # Per critical requirements, input validation is omitted; we trust the caller's inputs.\n    \n    first_k_elements = extract_first_k_elements(arr, k)\n    filtered_elements = filter_two_digit_elements(first_k_elements)\n    total_sum = calculate_sum(filtered_elements)\n    \n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "from typing import List\ndef add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    Orchestrates validation, processing, and calculation components.\n    \"\"\"\n\n    # --- Validation Layer ---\n    def validate_array(arr_param: List[int]) -> bool:\n        \"\"\"\n        Validates the array input constraints.\n        Checks if the array length is between 1 and 100 elements.\n        \"\"\"\n        return 1 <= len(arr_param) <= 100\n\n    def validate_k(k_param: int, arr_length: int) -> bool:\n        \"\"\"\n        Validates the k parameter constraints.\n        Ensures k is between 1 and the array length (inclusive).\n        \"\"\"\n        return 1 <= k_param <= arr_length\n\n    # --- Processing Layer ---\n    def extract_first_k(arr_param: List[int], k_param: int) -> List[int]:\n        \"\"\"\n        Extracts the first k elements from the input array.\n        Returns a new list containing these elements.\n        \"\"\"\n        return arr_param[:k_param]\n\n    def is_two_digit_or_less(value: int) -> bool:\n        \"\"\"\n        Checks if an integer's absolute value is at most two digits.\n        This means the value must be between -99 and 99, inclusive.\n        \"\"\"\n        return -99 <= value <= 99\n\n    def filter_two_digit(elements_param: List[int]) -> List[int]:\n        \"\"\"\n        Filters a list to include only elements with at most two digits.\n        It uses the is_two_digit_or_less helper for the filtering logic.\n        \"\"\"\n        return [e for e in elements_param if is_two_digit_or_less(e)]\n\n    # --- Calculation Layer ---\n    def calculate_sum(elements_param: List[int]) -> int:\n        \"\"\"\n        Calculates the sum of integers in a given list.\n        Returns 0 if the list is empty.\n        \"\"\"\n        return sum(elements_param)\n\n    # --- Main Function Orchestration ---\n    # Validators are called as per design, but their results are trusted (not explicitly handled for False).\n    validate_array(arr)\n    validate_k(k, len(arr))\n\n    # Process elements according to the design flow.\n    first_k_elements = extract_first_k(arr, k)\n    filtered_elements = filter_two_digit(first_k_elements)\n\n    # Calculate the final sum.\n    final_sum = calculate_sum(filtered_elements)\n\n    return final_sum"}
{"task_id": "HumanEval/123", "solution": "def _apply_collatz_rule(term):\n    \"\"\"Applies a single Collatz transformation rule.\"\"\"\n    if term % 2 == 0:\n        return term // 2\n    else:\n        return 3 * term + 1\ndef _generate_collatz_sequence(n):\n    \"\"\"Generates the complete Collatz sequence from n down to 1.\"\"\"\n    sequence = [n]\n    current = n\n    while current != 1:\n        current = _apply_collatz_rule(current)\n        sequence.append(current)\n    return sequence\ndef _extract_odd_numbers(sequence):\n    \"\"\"Filters a list of numbers to retain only the odd ones.\"\"\"\n    return [num for num in sequence if num % 2 != 0]\ndef _sort_ascending(numbers):\n    \"\"\"Sorts a list of numbers in ascending order.\"\"\"\n    return sorted(numbers)\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function orchestrates Collatz sequence generation, odd number extraction, and sorting.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    odd_numbers = _extract_odd_numbers(collatz_sequence)\n    return _sort_ascending(odd_numbers)"}
{"task_id": "HumanEval/123", "solution": "def validate_positive_integer(n: int) -> bool:\n    \"\"\"\n    Validates that input is a positive integer.\n    Ensures input meets business rule BR-001.\n    \"\"\"\n    return n > 0\ndef apply_collatz_rule(current: int) -> int:\n    \"\"\"\n    Applies single Collatz transformation rule to current number.\n    Implements mathematical rule: even numbers divided by 2, odd numbers multiplied by 3 plus 1.\n    \"\"\"\n    if current % 2 == 0:\n        return current // 2\n    else:\n        return 3 * current + 1\ndef generate_collatz_sequence(n: int) -> list[int]:\n    \"\"\"\n    Generates complete Collatz sequence from starting number to 1.\n    Implements core Collatz algorithm following business rules BR-002 and BR-003.\n    \"\"\"\n    sequence = []\n    current = n\n    while True:\n        sequence.append(current)\n        if current == 1:\n            break\n        current = apply_collatz_rule(current)\n    return sequence\ndef extract_odd_numbers(sequence: list[int]) -> list[int]:\n    \"\"\"\n    Extracts and sorts odd numbers from sequence.\n    Filters odd numbers and sorts them following business rules BR-004 and BR-005.\n    \"\"\"\n    odd_numbers = []\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.append(num)\n    odd_numbers.sort()\n    return odd_numbers\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Main entry point orchestrating the complete Collatz odd number calculation.\n    Coordinates input validation, sequence generation, odd extraction, and sorting.\n    \"\"\"\n    # As per \"Trust the caller's inputs\", we assume n is a positive integer,\n    # so validate_positive_integer(n) will implicitly be True.\n    # The explicit call is for design adherence.\n    _ = validate_positive_integer(n)\n\n    collatz_sequence = generate_collatz_sequence(n)\n    sorted_odd_numbers = extract_odd_numbers(collatz_sequence)\n    return sorted_odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def _check_empty(date_str):\n    \"\"\"Checks if the date string is empty.\"\"\"\n    return bool(date_str)\ndef _check_format(date_str):\n    \"\"\"Validates the mm-dd-yyyy format with hyphens.\"\"\"\n    if len(date_str) != 10:\n        return False\n    if date_str[2] != '-' or date_str[5] != '-':\n        return False\n    \n    # Check if all parts are digits\n    if not (date_str[0:2].isdigit() and date_str[3:5].isdigit() and date_str[6:10].isdigit()):\n        return False\n    return True\ndef _parse_components(date_str):\n    \"\"\"Parses month, day, year from a valid mm-dd-yyyy format string.\"\"\"\n    parts = date_str.split('-')\n    month = int(parts[0])\n    day = int(parts[1])\n    year = int(parts[2])\n    return month, day, year\ndef _validate_month(month):\n    \"\"\"Validates if the month is within the 1-12 range.\"\"\"\n    return 1 <= month <= 12\ndef _get_max_days_for_month(month):\n    \"\"\"Determines the maximum number of days for a given month.\"\"\"\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        return 31\n    elif month in {4, 6, 9, 11}:\n        return 30\n    elif month == 2:\n        return 29  # Fixed 29 days for February, no leap year logic required.\n    return 0 # Should not be reached with prior month validation\ndef _validate_day(day, month):\n    \"\"\"Validates if the day is within the valid range for the given month.\"\"\"\n    max_days = _get_max_days_for_month(month)\n    return 1 <= day <= max_days\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not _check_empty(date):\n        return False\n    if not _check_format(date):\n        return False\n    \n    month, day, year = _parse_components(date) # Year is parsed but not used in validation rules.\n\n    if not _validate_month(month):\n        return False\n    if not _validate_day(day, month):\n        return False\n    \n    return True"}
{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _has_whitespace(txt: str) -> bool:\n    \"\"\"Detects if the input string contains any whitespace characters.\"\"\"\n    return any(c.isspace() for c in txt)\ndef _has_commas(txt: str) -> bool:\n    \"\"\"Detects if the input string contains any comma characters.\"\"\"\n    return ',' in txt\ndef _count_odd_letters(txt: str) -> int:\n    \"\"\"Counts lowercase letters with odd alphabetical order (a=0, b=1...).\"\"\"\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Processes string input: splits on whitespace, then commas, or counts odd-ordered letters.\n    Returns a list of strings for splitting, or an integer for counting.\n    \"\"\"\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_commas(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_letters(txt)"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date: str):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example:\n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n\n    class DateComponents:\n        \"\"\"Represents parsed date components.\"\"\"\n        def __init__(self, month_val: int, day_val: int, year_val: int):\n            self.month = month_val\n            self.day = day_val\n            self.year = year_val\n            self.is_valid = True\n\n        @classmethod\n        def from_string(cls, date_string: str):\n            \"\"\"Parses a mm-dd-yyyy string into DateComponents.\"\"\"\n            parts = date_string.split('-')\n            \n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            \n            return cls(month, day, year)\n\n\n    class FormatValidator:\n        \"\"\"Handles date string format validation.\"\"\"\n        def is_valid_format(self, date_string: str) -> bool:\n            \"\"\"Checks overall format validity.\"\"\"\n            if not self.has_hyphen_separators(date_string):\n                return False\n            if not self.matches_pattern(date_string):\n                return False\n            return True\n\n        def has_hyphen_separators(self, date_string: str) -> bool:\n            \"\"\"Verifies hyphen separators are correct.\"\"\"\n            if len(date_string) != 10:\n                return False\n            return date_string[2] == '-' and date_string[5] == '-'\n\n        def matches_pattern(self, date_string: str) -> bool:\n            \"\"\"Checks mm-dd-yyyy digit pattern.\"\"\"\n            return (date_string[0:2].isdigit() and\n                    date_string[3:5].isdigit() and\n                    date_string[6:10].isdigit())\n\n\n    class RangeValidator:\n        \"\"\"Validates month and day ranges according to calendar rules.\"\"\"\n        def is_valid_month(self, month: int) -> bool:\n            \"\"\"Checks month range 1-12.\"\"\"\n            return 1 <= month <= 12\n\n        def get_max_days_for_month(self, month: int) -> int:\n            \"\"\"Returns maximum days for a given month.\"\"\"\n            if month in [1, 3, 5, 7, 8, 10, 12]:\n                return 31\n            elif month in [4, 6, 9, 11]:\n                return 30\n            elif month == 2:\n                return 29\n            return 0\n\n        def is_valid_day_for_month(self, day: int, month: int) -> bool:\n            \"\"\"Checks day range for specific month.\"\"\"\n            max_days = self.get_max_days_for_month(month)\n            return 1 <= day <= max_days\n\n\n    class DateValidator:\n        \"\"\"Orchestrates the complete date validation process.\"\"\"\n\n        def _validate_empty(self, date_string: str) -> bool:\n            \"\"\"Checks for empty input string.\"\"\"\n            return bool(date_string)\n\n        def _validate_format(self, date_string: str) -> bool:\n            \"\"\"Validates the date string's format.\"\"\"\n            formatter = FormatValidator()\n            return formatter.is_valid_format(date_string)\n\n        def _validate_components(self, components: DateComponents) -> bool:\n            \"\"\"Validates parsed date components against calendar rules.\"\"\"\n            if not components.is_valid:\n                return False\n\n            range_validator = RangeValidator()\n            if not range_validator.is_valid_month(components.month):\n                return False\n            if not range_validator.is_valid_day_for_month(components.day, components.month):\n                return False\n            return True\n\n        def validate(self, date_string: str) -> bool:\n            \"\"\"Main validation entry point for the DateValidator class.\"\"\"\n            if not self._validate_empty(date_string):\n                return False\n            \n            if not self._validate_format(date_string):\n                return False\n            \n            components = DateComponents.from_string(date_string)\n            \n            if not self._validate_components(components):\n                return False\n                \n            return True\n\n    validator_instance = DateValidator()\n    return validator_instance.validate(date)"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, or commas, or count odd-order lowercase letters.\n    The processing strategy is based on delimiter presence: whitespace > commas > character counting.\n    '''\n    \n    # First priority: Split on whitespace if present.\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace:\n        return txt.split()\n    \n    # Second priority: Split on commas if no whitespace but commas are present.\n    if ',' in txt:\n        return txt.split(',')\n    \n    # Fallback: Count lowercase letters with odd alphabetical order positions if no delimiters.\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z': # Check if the character is a lowercase letter\n            # Calculate alphabetical order (a=0, b=1, ...)\n            alphabet_order = ord(char) - ord('a')\n            if alphabet_order % 2 != 0: # Check if the alphabetical order position is odd\n                count += 1\n                \n    return count"}
{"task_id": "HumanEval/126", "solution": "def _is_single_element(lst):\n    '''\n    Checks if the given list contains exactly one element.\n    Returns True if the list length is 1, False otherwise.\n    '''\n    return len(lst) == 1\ndef _check_ascending_order(lst):\n    '''\n    Validates if the elements in the list are sorted in ascending order.\n    Returns False if any element is smaller than its predecessor, True otherwise.\n    '''\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i - 1]:\n            return False\n    return True\ndef _count_occurrences(lst):\n    '''\n    Counts the frequency of each number within the list.\n    Returns a dictionary mapping each number to its count.\n    '''\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n    return counts\ndef _validate_duplicates(lst):\n    '''\n    Ensures that no number in the list appears more than twice.\n    Returns False if any number's count exceeds two, True otherwise.\n    '''\n    counts = _count_occurrences(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n    return True\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    if _is_single_element(lst):\n        return True\n\n    if not _check_ascending_order(lst):\n        return False\n\n    if not _validate_duplicates(lst):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Validates if a list of non-negative integers is sorted in ascending order.\n    It returns False if any value appears more than twice.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    for i in range(1, len(lst)):\n        # Check for ascending order violation.\n        if lst[i] < lst[i-1]:\n            return False\n        \n        # Check for excessive duplicates (three or more consecutive identical elements).\n        if lst[i] == lst[i-1] and i > 1 and lst[i-1] == lst[i-2]:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/127", "solution": "def is_prime(number):\n    \"\"\"Checks if a number is prime.\n    Handles edge cases and checks divisibility up to its square root.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number: \n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef calculate_intersection(interval1, interval2):\n    \"\"\"Calculates the intersection of two closed intervals and its length.\n    Returns (start, end, length) if intersecting, otherwise None; length is end - start.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start > intersection_end:\n        return None  # No intersection\n    else:\n        # The problem examples imply length is calculated as end - start\n        length = intersection_end - intersection_start\n        return (intersection_start, intersection_end, length)\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of intersection between two intervals is a prime number.\n    Returns \"YES\" for prime lengths, \"NO\" otherwise or if no intersection.\"\"\"\n    \n    intersection_result = calculate_intersection(interval1, interval2)\n\n    if intersection_result is None:\n        return \"NO\"\n    else:\n        _, _, length = intersection_result\n        if is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array, and 0 if any element is zero.\n    \"\"\"\n    if not arr:\n        return None\n\n    magnitude_sum = 0\n    sign_product = 1\n\n    for num in arr:\n        magnitude_sum += abs(num)\n        \n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else: # num == 0\n            current_sign = 0\n        \n        sign_product *= current_sign\n    \n    return magnitude_sum * sign_product"}
{"task_id": "HumanEval/127", "solution": "def has_intersection(interval1, interval2):\n    \"\"\"Checks if two closed intervals intersect.\"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n    return max(s1, s2) <= min(e1, e2)\ndef calculate_intersection(interval1, interval2):\n    \"\"\"Calculates the intersection of two closed intervals.\"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n    # This function is called only if has_intersection is true.\n    return (max(s1, s2), min(e1, e2))\ndef get_intersection_length(start, end):\n    \"\"\"Calculates the length of a closed interval.\"\"\"\n    # For a closed interval [start, end], its length is end - start + 1.\n    return end - start + 1\ndef is_prime(number):\n    \"\"\"Determines if a number is prime.\"\"\"\n    # Primes are positive integers greater than 1.\n    if number <= 1:\n        return False\n\n    # Check for small prime numbers (2 and 3).\n    if number <= 3:\n        return True\n\n    # Numbers divisible by 2 or 3 are not prime (except 2 and 3 themselves).\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n\n    # Check for divisibility by numbers of the form 6k +/- 1.\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef generate_result(has_intersection_flag, is_prime_flag):\n    \"\"\"Generates \"YES\" if intersection length is prime, \"NO\" otherwise.\"\"\"\n    # Returns \"NO\" if intervals do not intersect or the length is not prime.\n    if not has_intersection_flag:\n        return \"NO\"\n    if is_prime_flag:\n        return \"YES\"\n    return \"NO\"\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise, or if intervals don't intersect.\n    \"\"\"\n    \n    # Check if the two intervals intersect.\n    intersect_exists = has_intersection(interval1, interval2)\n\n    if not intersect_exists:\n        # If there is no intersection, the result is \"NO\" as per requirements.\n        return generate_result(False, False)\n\n    # Calculate the intersection interval, which is guaranteed to exist.\n    intersect_interval = calculate_intersection(interval1, interval2)\n    intersection_start, intersection_end = intersect_interval\n    \n    # Determine the length of the intersection.\n    length = get_intersection_length(intersection_start, intersection_end)\n\n    # Check if the calculated length is a prime number.\n    is_length_prime = is_prime(length)\n\n    # Generate and return the final \"YES\" or \"NO\" result.\n    return generate_result(True, is_length_prime)"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for empty arrays, 0 if any array element is zero.\n    \"\"\"\n\n    def _get_sign(number: int) -> int:\n        \"\"\"Determines the sign of a single number, returning 1, -1, or 0.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _calculate_magnitude_sum(arr: list[int]) -> int:\n        \"\"\"Calculates the sum of the absolute values (magnitudes) of numbers.\"\"\"\n        total_magnitude = 0\n        for number in arr:\n            total_magnitude += abs(number)\n        return total_magnitude\n\n    def _calculate_sign_product(arr: list[int]) -> int:\n        \"\"\"Calculates the product of the signs of all numbers in the array.\"\"\"\n        sign_product = 1\n        for number in arr:\n            current_sign = _get_sign(number)\n            if current_sign == 0:\n                return 0  # A zero in the array makes the overall sign product zero\n            sign_product *= current_sign\n        return sign_product\n\n    if not arr:\n        return None\n\n    magnitude_sum = _calculate_magnitude_sum(arr)\n    sign_product = _calculate_sign_product(arr)\n\n    final_result = magnitude_sum * sign_product\n    return final_result"}
{"task_id": "HumanEval/129", "solution": "class Position:\n    \"\"\"Represents grid coordinates.\"\"\"\n    def __init__(self, row: int, col: int):\n        self.row = row\n        self.col = col\n\n    def getRow(self) -> int:\n        return self.row\n\n    def getCol(self) -> int:\n        return self.col\n\n    def __eq__(self, other):\n        if not isinstance(other, Position):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        return hash((self.row, self.col))\n\n    def __repr__(self):\n        return f\"Position({self.row}, {self.col})\"\nclass Grid:\n    \"\"\"Manages grid data and operations.\"\"\"\n    def __init__(self, cells: list[list[int]]):\n        self.cells = cells\n        self.N = len(cells)\n\n    def getCell(self, row: int, col: int) -> int:\n        return self.cells[row][col]\n\n    def isValidPosition(self, row: int, col: int) -> bool:\n        return 0 <= row < self.N and 0 <= col < self.N\n\n    def getNeighbors(self, row: int, col: int) -> list[Position]:\n        neighbors = []\n        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Orthogonal movements\n        for dr, dc in deltas:\n            new_row, new_col = row + dr, col + dc\n            if self.isValidPosition(new_row, new_col):\n                neighbors.append(Position(new_row, new_col))\n        return neighbors\nclass Path:\n    \"\"\"Represents path data and comparison logic.\"\"\"\n    def __init__(self):\n        self.values: list[int] = []\n        self.positions: list[Position] = []\n\n    def addCell(self, value: int, position: Position):\n        self.values.append(value)\n        self.positions.append(position)\n\n    def getValues(self) -> list[int]:\n        return list(self.values) # Return a copy\n\n    def getLength(self) -> int:\n        return len(self.values)\n\n    def isLexicographicallySmaller(self, otherPath: 'Path') -> bool:\n        # Compares two paths lexicographically, assuming they have the same length.\n        for i in range(len(self.values)):\n            if self.values[i] < otherPath.values[i]:\n                return True\n            elif self.values[i] > otherPath.values[i]:\n                return False\n        return False # Paths are identical or otherPath is smaller/equal.\nclass PathFinder:\n    \"\"\"Implements the pathfinding algorithm with lexicographic comparison.\"\"\"\n    def __init__(self, grid: 'Grid', k: int):\n        self.grid = grid\n        self.k = k\n        self.min_path: 'Path' = None\n\n    def findMinPath(self) -> 'Path':\n        for r in range(self.grid.N):\n            for c in range(self.grid.N):\n                start_pos = Position(r, c)\n                start_value = self.grid.getCell(r, c)\n                current_path = Path()\n                current_path.addCell(start_value, start_pos)\n                self._dfs(start_pos, current_path)\n        return self.min_path\n\n    def _dfs(self, current_pos: 'Position', current_path: 'Path'):\n        if current_path.getLength() == self.k:\n            if self.min_path is None or current_path.isLexicographicallySmaller(self.min_path):\n                # A deep copy is necessary to store the path state without mutation from other branches.\n                self.min_path = Path()\n                self.min_path.values = list(current_path.values)\n                self.min_path.positions = list(current_path.positions)\n            return\n\n        neighbors = self.grid.getNeighbors(current_pos.getRow(), current_pos.getCol())\n        # Sort neighbors by their cell values to prioritize lexicographically smaller paths.\n        sorted_neighbors = sorted(neighbors, key=lambda p: self.grid.getCell(p.getRow(), p.getCol()))\n\n        for neighbor_pos in sorted_neighbors:\n            next_path = Path()\n            next_path.values = list(current_path.values) # Create a new path state for the next step.\n            next_path.positions = list(current_path.positions)\n            next_path.addCell(self.grid.getCell(neighbor_pos.getRow(), neighbor_pos.getCol()), neighbor_pos)\n            self._dfs(neighbor_pos, next_path)\nclass MinPathAlgorithm:\n    \"\"\"Orchestrates the MinPath finding process.\"\"\"\n    def minPath(self, grid_data: list[list[int]], k: int) -> list[int]:\n        self._validate_input(grid_data, k) # Perform basic input checks.\n\n        grid_obj = Grid(grid_data)\n        path_finder = PathFinder(grid_obj, k)\n        \n        result_path = path_finder.findMinPath()\n        return result_path.getValues()\n\n    def _validate_input(self, grid_data: list[list[int]], k: int):\n        # Input validation is minimal as per critical requirements.\n        pass\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in an N\u00d7N grid.\n    This function orchestrates the algorithm using the layered architecture.\n    \"\"\"\n    algorithm = MinPathAlgorithm()\n    return algorithm.minPath(grid, k)"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to the n-th term.\n    It uses memoization to efficiently compute terms including forward dependencies.\"\"\"\n\n    memo = {}\n\n    def _get_tribonacci_value(k):\n        \"\"\"Helper to compute the k-th Tribonacci number with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            val_k_minus_1 = _get_tribonacci_value(k - 1)\n            val_k_minus_2 = _get_tribonacci_value(k - 2)\n            val_k_plus_1 = _get_tribonacci_value(k + 1)\n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_value(i))\n\n    return sequence"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Generates the first n+1 numbers of the Tribonacci sequence.\n    It computes even indices first, then odd indices using the forward-referencing recurrence.\n    \"\"\"\n    # Initialize a list to temporarily store sequence values up to index n+1,\n    # because tri(n+1) might be needed for tri(n) if n is odd.\n    temp_sequence = [0] * (n + 2)\n\n    # Set the initial base cases for tri(0) and tri(1).\n    if n >= 0:\n        temp_sequence[0] = 1\n    if n >= 1:\n        temp_sequence[1] = 3\n\n    # First pass: Calculate all even indexed values up to n+1.\n    # This ensures that tri(i+1) is available when needed for odd i in the second pass.\n    for i in range(2, n + 2):\n        if i % 2 == 0:  # If the current index i is even\n            temp_sequence[i] = 1 + i // 2\n\n    # Second pass: Calculate odd indexed values from 2 up to n.\n    # Base cases for tri(0) and tri(1) are already handled.\n    for i in range(2, n + 1):\n        if i % 2 != 0:  # If the current index i is odd\n            # Apply the recurrence relation: tri(i) = tri(i-1) + tri(i-2) + tri(i+1).\n            # All required terms (i-1, i-2, i+1) are now available in temp_sequence.\n            temp_sequence[i] = temp_sequence[i - 1] + temp_sequence[i - 2] + temp_sequence[i + 1]\n\n    # Return the first n+1 elements from the temporary sequence.\n    return temp_sequence[:n + 1]"}
{"task_id": "HumanEval/131", "solution": "def _extract_digits(n: int) -> list[int]:\n    \"\"\"Helper function to extract individual digits from an integer.\n    Converts the integer to a string and then to a list of integers.\"\"\"\n    return [int(d) for d in str(n)]\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Helper function to check if a single digit is odd.\n    Returns True for odd digits (1, 3, 5, 7, 9), False otherwise.\"\"\"\n    return digit % 2 == 1\ndef _calculate_product(odd_digits: list[int]) -> int:\n    \"\"\"Helper function to calculate the product of a list of odd digits.\n    Returns 0 if the list is empty (no odd digits found).\"\"\"\n    if not odd_digits:\n        return 0\n    product = 1\n    for digit in odd_digits:\n        product *= digit\n    return product\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    extracted_digits = _extract_digits(n)\n\n    odd_digits_list = []\n    for digit in extracted_digits:\n        if _is_odd(digit):\n            odd_digits_list.append(digit)\n\n    return _calculate_product(odd_digits_list)"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Determines if a digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _extract_digits(n: int) -> list[int]:\n        \"\"\"Extracts individual digits from an integer.\"\"\"\n        return [int(d) for d in str(n)]\n\n    def _filter_odd_digits(digits: list[int]) -> list[int]:\n        \"\"\"Filters a list to contain only odd digits.\"\"\"\n        return [d for d in digits if _is_odd(d)]\n\n    def _calculate_product(odd_digits: list[int]) -> int:\n        \"\"\"Calculates the product of odd digits, returns 0 for an empty list.\"\"\"\n        if not odd_digits:\n            return 0\n        product = 1\n        for digit in odd_digits:\n            product *= digit\n        return product\n\n    extracted = _extract_digits(n)\n    odd_filtered = _filter_odd_digits(extracted)\n    result = _calculate_product(odd_filtered)\n    return result"}
{"task_id": "HumanEval/129", "solution": "class Position:\n    \"\"\"Represents a coordinate in the grid.\"\"\"\n    def __init__(self, row: int, col: int):\n        \"\"\"Initializes a position with row and column.\"\"\"\n        self._row = row\n        self._col = col\n\n    def getRow(self) -> int:\n        \"\"\"Returns the row coordinate.\"\"\"\n        return self._row\n\n    def getCol(self) -> int:\n        \"\"\"Returns the column coordinate.\"\"\"\n        return self._col\n\n    def equals(self, other: 'Position') -> bool:\n        \"\"\"Compares two positions for equality.\"\"\"\n        return self._row == other.getRow() and self._col == other.getCol()\n\n    def __str__(self) -> str:\n        \"\"\"Returns a string representation of the position.\"\"\"\n        return f\"({self._row}, {self._col})\"\nclass Path:\n    \"\"\"Represents a sequence of cells visited and their values.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes an empty path.\"\"\"\n        self._cellValues = []\n        self._positions = []\n\n    def addStep(self, value: int, position: Position) -> None:\n        \"\"\"Adds a step (cell value and position) to the path.\"\"\"\n        self._cellValues.append(value)\n        self._positions.append(position)\n\n    def getValues(self) -> list[int]:\n        \"\"\"Returns the ordered list of cell values in the path.\"\"\"\n        return self._cellValues\n\n    def getLength(self) -> int:\n        \"\"\"Returns the number of steps in the path.\"\"\"\n        return len(self._cellValues)\n\n    def copy(self) -> 'Path':\n        \"\"\"Creates a deep copy of the path.\"\"\"\n        new_path = Path()\n        new_path._cellValues = list(self._cellValues)\n        new_path._positions = list(self._positions)\n        return new_path\n\n    def isLexicographicallySmaller(self, other: 'Path') -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        return self._cellValues < other._cellValues\nclass Grid:\n    \"\"\"Manages grid structure and provides grid operations.\"\"\"\n    def __init__(self, cells: list[list[int]]):\n        \"\"\"Initializes the grid.\"\"\"\n        self._cells = cells\n        self._n = len(cells)\n\n    def getCell(self, row: int, col: int) -> int:\n        \"\"\"Returns the value of the cell at the given position.\"\"\"\n        return self._cells[row][col]\n\n    def getNeighbors(self, row: int, col: int) -> list[Position]:\n        \"\"\"Returns a list of valid orthogonally adjacent neighbor positions.\"\"\"\n        neighbors = []\n        movements = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n        for dr, dc in movements:\n            new_row, new_col = row + dr, col + dc\n            if self.isValidPosition(new_row, new_col):\n                neighbors.append(Position(new_row, new_col))\n        return neighbors\n\n    def isValidPosition(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a position is within grid boundaries.\"\"\"\n        return 0 <= row < self._n and 0 <= col < self._n\n\n    def getSize(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._n\nclass PathFinder:\n    \"\"\"Implements core pathfinding logic to find the lexicographically minimum path.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        \"\"\"Initializes PathFinder with a grid and required path length k.\"\"\"\n        self._grid = grid\n        self._k = k\n\n    def findMinPath(self) -> list[int]:\n        \"\"\"Finds and returns the lexicographically minimum path.\"\"\"\n        all_paths = self.generateAllPaths()\n        min_path = self.findLexicographicallySmallest(all_paths)\n        return min_path.getValues()\n\n    def generateAllPaths(self) -> list[Path]:\n        \"\"\"Generates all possible paths of length k starting from any cell.\"\"\"\n        all_generated_paths: list[Path] = []\n        n = self._grid.getSize()\n\n        for r in range(n):\n            for c in range(n):\n                start_pos = Position(r, c)\n                current_path = Path()\n                \n                # Add the first step (the starting cell itself)\n                current_path.addStep(self._grid.getCell(r, c), start_pos)\n                \n                if self._k == 1:\n                    all_generated_paths.append(current_path)\n                else:\n                    # Recursively generate paths for the remaining k-1 steps\n                    self.generatePathsFromPosition(start_pos, current_path, self._k - 1, all_generated_paths)\n        return all_generated_paths\n\n    def generatePathsFromPosition(self, current_pos: Position, current_path: Path, remaining_steps: int, results: list[Path]) -> None:\n        \"\"\"Recursively generates paths from a given position.\"\"\"\n        if remaining_steps == 0:\n            results.append(current_path)\n            return\n\n        for neighbor_pos in self._grid.getNeighbors(current_pos.getRow(), current_pos.getCol()):\n            next_path = current_path.copy()\n            next_path.addStep(self._grid.getCell(neighbor_pos.getRow(), neighbor_pos.getCol()), neighbor_pos)\n            self.generatePathsFromPosition(neighbor_pos, next_path, remaining_steps - 1, results)\n\n    def findLexicographicallySmallest(self, paths: list[Path]) -> Path:\n        \"\"\"Finds the lexicographically smallest path from a list of paths.\"\"\"\n        # It's guaranteed that paths will not be empty and a unique solution exists.\n        smallest_path = paths[0]\n        for path in paths[1:]:\n            if path.isLexicographicallySmaller(smallest_path):\n                smallest_path = path\n        return smallest_path\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in an N\u00d7N grid.\n    Returns an ordered list of cell values in the minimum path.\n    \"\"\"\n    grid_obj = Grid(grid)\n    path_finder = PathFinder(grid_obj, k)\n    return path_finder.findMinPath()"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    \"\"\"\n    Determines if a string contains nested square brackets.\n    Nesting is detected if an opening bracket appears inside another pair.\n    \"\"\"\n    current_nesting_level = 0  # Tracks the current depth of open brackets.\n    has_nested_pattern = False  # Flag set if current_nesting_level ever exceeds 1.\n    balance_check_counter = 0  # Tracks overall bracket balance to detect premature malformation.\n\n    for char in string:\n        if char == '[':\n            current_nesting_level += 1\n            balance_check_counter += 1\n            if current_nesting_level > 1:\n                has_nested_pattern = True\n        elif char == ']':\n            balance_check_counter -= 1\n            # If balance_check_counter drops below zero, it means a closing bracket\n            # appeared without a preceding open one, indicating a malformed sequence\n            # that should result in False, as per problem examples like '[]]]]]]][[[[[]'.\n            if balance_check_counter < 0:\n                return False\n            \n            # Decrease the current nesting level only if there was an active open bracket.\n            current_nesting_level = max(0, current_nesting_level - 1)\n            \n    # Returns True if a nested pattern was found and no premature malformation occurred.\n    # Unbalanced sequences at the end (e.g., '[[]][[' which returns True) are handled.\n    return has_nested_pattern"}
{"task_id": "HumanEval/132", "solution": "class StringProcessor:\n    \"\"\"Provides string manipulation and access utilities.\"\"\"\n\n    @staticmethod\n    def process_string(input_string: str) -> str:\n        \"\"\"Processes the input string. Currently returns the string as is.\"\"\"\n        return input_string\n\n    @staticmethod\n    def get_character_at(input_string: str, index: int) -> str:\n        \"\"\"Safely gets the character at a specified index.\"\"\"\n        return input_string[index]\n\n    @staticmethod\n    def get_length(input_string: str) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(input_string)\nclass BracketValidator:\n    \"\"\"Validates input string contains only square bracket characters.\"\"\"\n\n    @staticmethod\n    def contains_only_brackets(input_string: str) -> bool:\n        \"\"\"Checks if the input string contains only '[' and ']' characters.\"\"\"\n        for i in range(StringProcessor.get_length(input_string)):\n            char = StringProcessor.get_character_at(input_string, i)\n            if char not in ['[', ']']:\n                return False\n        return True\n\n    @staticmethod\n    def validate_input(input_string: str) -> bool:\n        \"\"\"Validates input contains only bracket characters.\"\"\"\n        return BracketValidator.contains_only_brackets(input_string)\nclass NestedAnalyzer:\n    \"\"\"Detects nested bracket subsequences in validated strings.\"\"\"\n\n    @staticmethod\n    def is_valid_bracket_pair(open_char: str, close_char: str) -> bool:\n        \"\"\"Validates if two characters form a basic '[]' bracket pair.\"\"\"\n        return open_char == '[' and close_char == ']'\n\n    @staticmethod\n    def find_nested_subsequence(input_string: str) -> bool:\n        \"\"\"Implements the core algorithm to detect if a valid nested bracket subsequence exists.\"\"\"\n        stack = []  # Stores indices of open brackets to check for nesting.\n        balance = 0  # Tracks overall bracket balance for validity.\n\n        for i in range(StringProcessor.get_length(input_string)):\n            char = StringProcessor.get_character_at(input_string, i)\n\n            if char == '[':\n                stack.append(i)\n                balance += 1\n            elif char == ']':\n                balance -= 1\n                if balance < 0:\n                    # If balance drops below zero, the string is malformed at this point.\n                    # No valid subsequence can be formed past this, so return False.\n                    return False\n                \n                if stack:\n                    stack.pop()  # Match the current ']' with the most recent '['.\n                    if stack:\n                        # If the stack is still not empty, it means the current pair was enclosed\n                        # within another, thus a nested subsequence is found.\n                        return True\n        \n        # If the loop completes, no nested subsequence was found.\n        return False\n\n    @staticmethod\n    def has_nesting(input_string: str) -> bool:\n        \"\"\"Determines if nesting exists by calling the main detection algorithm.\"\"\"\n        return NestedAnalyzer.find_nested_subsequence(input_string)\nclass ResultHandler:\n    \"\"\"Formats and returns boolean results.\"\"\"\n\n    @staticmethod\n    def format_output(result: bool) -> bool:\n        \"\"\"Ensures the output is a proper boolean value.\"\"\"\n        return result\n\n    @staticmethod\n    def return_result(has_nesting: bool) -> bool:\n        \"\"\"Returns the formatted boolean result of the analysis.\"\"\"\n        return ResultHandler.format_output(has_nesting)\ndef is_nested(string: str) -> bool:\n    '''\n    Analyzes a string of square brackets to determine if a valid nested bracket subsequence exists.\n    Orchestrates validation, analysis, and result handling components.\n    '''\n    # 1. Input Validation Layer\n    if not BracketValidator.validate_input(string):\n        return ResultHandler.return_result(False)\n\n    # 2. Bracket Analysis Layer\n    has_nesting_result = NestedAnalyzer.has_nesting(string)\n\n    # 3. Result Handler Layer\n    return ResultHandler.return_result(has_nesting_result)"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    This function calculates the sum of squared ceiling-rounded numbers.\n    \"\"\"\n    return sum([math.ceil(num) ** 2 for num in lst])"}
