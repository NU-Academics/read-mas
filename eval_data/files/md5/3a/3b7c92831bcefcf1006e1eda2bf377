{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits an input string by spaces into a list of group strings.\n    Empty strings resulting from multiple spaces are filtered out.\n    \"\"\"\n    return [group for group in input_string.split(' ') if group]\ndef _calculate_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group.\n    It tracks the current and maximum depth while iterating through characters.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = _split_groups(paren_string)\n    depths = [_calculate_depth(group) for group in groups]\n    return depths"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass GroupProcessor:\n    \"\"\"Helper class to track current and maximum depth during group parsing.\"\"\"\n    def __init__(self) -> None:\n        self.current_depth: int = 0\n        self.max_depth: int = 0\n\n    def process_character(self, char: str) -> None:\n        \"\"\"Processes a single character to update depth counts.\"\"\"\n        if char == '(':\n            self.current_depth += 1\n            if self.current_depth > self.max_depth:\n                self.max_depth = self.current_depth\n        elif char == ')':\n            # Decrement depth, ensuring it doesn't fall below zero.\n            if self.current_depth > 0:\n                self.current_depth -= 1\n\n    def get_max_depth(self) -> int:\n        \"\"\"Returns the calculated maximum nesting depth.\"\"\"\n        return self.max_depth\n\n    def reset(self) -> None:\n        \"\"\"Resets the depth counters for processing a new group (though not explicitly used for new instances).\"\"\"\n        self.current_depth = 0\n        self.max_depth = 0\ndef _validate_input(input_string: str) -> bool:\n    \"\"\"Validates the input string format. This function assumes input is trusted as per requirements.\"\"\"\n    return True\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits the input string into individual parentheses groups separated by spaces.\"\"\"\n    return [group for group in input_string.split(' ') if group]\ndef _calculate_group_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group string.\"\"\"\n    processor = GroupProcessor()\n    for char in group:\n        processor.process_character(char)\n    return processor.get_max_depth()\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    _validate_input(paren_string)\n    groups = _split_groups(paren_string)\n    \n    depths: List[int] = []\n    for group in groups:\n        depths.append(_calculate_group_depth(group))\n    \n    return depths"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of integers in a list.\n    Returns (0, 1) for an empty list as identity values.\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    total_sum = sum(numbers)\n\n    for number in numbers:\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum element\n    found until given moment in the sequence.\n\n    Args:\n        numbers: List of integers to process\n\n    Returns:\n        List of rolling maximum values\n\n    Example:\n        >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n        [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    # Implementation follows sequential processing requirement.\n    # Maintains current maximum and updates when larger value found.\n    rolling_maximums: List[int] = []\n    \n    current_max: int = numbers[0]\n    rolling_maximums.append(current_max)\n\n    for i in range(1, len(numbers)):\n        number = numbers[i]\n        if number > current_max:\n            current_max = number\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    It identifies the longest palindromic postfix and prepends the reverse of the remaining prefix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        current_postfix = string[i:]\n        if current_postfix == current_postfix[::-1]:\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple, Optional\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum element\n    found until given moment in the sequence.\n    \"\"\"\n    result: List[int] = []\n    current_max: Optional[int] = None\n\n    for num in numbers:\n        if current_max is None:\n            current_max = num\n        else:\n            current_max = max(current_max, num)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    for i in range(len(a)):\n        xor_result = int(a[i]) ^ int(b[i])\n        result_chars.append(str(xor_result))\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    It does this by finding the longest palindromic postfix and appending the reversed prefix before it.\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    for i in range(len(string)):\n        # Find the smallest 'i' such that string[i:] is a palindrome (which implies string[i:] is the longest palindromic postfix).\n        if is_palindrome(string[i:]):\n            # The prefix string[:i] needs to be reversed and appended to the original string.\n            return string + string[:i][::-1]\n\n    # This point should theoretically not be reached for non-empty strings\n    # because at least a single character (string[len(string)-1:]) is always a palindrome.\n    # The empty string case is handled by the initial check.\n    return string"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest_string = strings[0]\n    max_length = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > max_length:\n            max_length = len(s)\n            current_longest_string = s\n\n    return current_longest_string"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two integers a and b.\n    This function implements the Euclidean algorithm for GCD calculation.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    return [string[0:i] for i in range(1, len(string) + 1)]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Take absolute values to handle negative inputs and ensure a positive result.\n    a, b = abs(a), abs(b)\n    # Apply the Euclidean algorithm to find the greatest common divisor.\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"Return a list of all prefixes of the input string, ordered from shortest to longest.\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes: List[str] = []\n    for i in range(len(string)):\n        prefixes.append(string[:i + 1])\n    return prefixes"}
