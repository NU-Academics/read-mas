{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns a string representation after the conversion; base numbers are less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    return \"\".join(digits[::-1])"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence using an iterative approach.\n    This function efficiently calculates the sequence value without recursion.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four values (fib4(0), fib4(1), fib4(2), fib4(3))\n    # 'a' represents fib4(i-4), 'b' fib4(i-3), 'c' fib4(i-2), 'd' fib4(i-1)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired 'n'\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    return d"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    # Define the base values for n = 0, 1, 2, 3.\n    base_values = [0, 0, 2, 0]\n\n    # Return base values directly if n is within the base range.\n    if n < 4:\n        return base_values[n]\n\n    # Initialize the four preceding values for iterative computation.\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iteratively compute fib4(n) for n >= 4 using a sliding window.\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a, b, c, d = b, c, d, next_fib\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # For odd-length lists, return the middle element.\n        return sorted_list[n // 2]\n    else:\n        # For even-length lists, return the average of the two middle elements.\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2"}
