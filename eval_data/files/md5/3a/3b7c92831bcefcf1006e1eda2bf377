{"task_id": "HumanEval/33", "solution": "class EdgeCaseHandler:\n    \"\"\"Handles edge cases for list processing, such as empty or short lists.\"\"\"\n    def handle_empty_list(self) -> list:\n        \"\"\"Returns an empty list for an empty input.\"\"\"\n        return []\n\n    def handle_short_list(self, input_list: list) -> list:\n        \"\"\"Returns the original list for lists with length less than 3.\"\"\"\n        return input_list\nclass IndexProcessor:\n    \"\"\"Identifies indices that are divisible by three within a given list length.\"\"\"\n    def is_divisible_by_three(self, index: int) -> bool:\n        \"\"\"Checks if a given index is divisible by three.\"\"\"\n        return index % 3 == 0\n\n    def identify_divisible_indices(self, list_length: int) -> list[int]:\n        \"\"\"Generates a list of all indices divisible by three up to the given length.\"\"\"\n        return [i for i in range(list_length) if self.is_divisible_by_three(i)]\nclass ValueExtractor:\n    \"\"\"Extracts values from a list at specified indices.\"\"\"\n    def extract_values_at_indices(self, input_list: list, indices: list[int]) -> list:\n        \"\"\"Returns a new list containing values from input_list at the given indices.\"\"\"\n        return [input_list[i] for i in indices]\nclass SortingEngine:\n    \"\"\"Sorts a list of values in ascending order.\"\"\"\n    def sort_values_ascending(self, values: list) -> list:\n        \"\"\"Returns a new list with the input values sorted in ascending order.\"\"\"\n        return sorted(values)\nclass ListAssembler:\n    \"\"\"Constructs the final output list by placing sorted values at specific indices.\"\"\"\n    def assemble_output_list(self, original_list: list, sorted_values: list, divisible_indices: list[int]) -> list:\n        \"\"\"Creates a new list, copying original_list and placing sorted_values at divisible_indices.\"\"\"\n        output_list = list(original_list)\n        for i, val in enumerate(sorted_values):\n            output_list[divisible_indices[i]] = val\n        return output_list\ndef sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    list_length = len(l)\n\n    edge_case_handler = EdgeCaseHandler()\n    if list_length == 0:\n        return edge_case_handler.handle_empty_list()\n    if list_length < 3:\n        return edge_case_handler.handle_short_list(l)\n\n    index_processor = IndexProcessor()\n    divisible_indices = index_processor.identify_divisible_indices(list_length)\n\n    value_extractor = ValueExtractor()\n    extracted_values = value_extractor.extract_values_at_indices(l, divisible_indices)\n\n    sorting_engine = SortingEngine()\n    sorted_values = sorting_engine.sort_values_ascending(extracted_values)\n\n    list_assembler = ListAssembler()\n    return list_assembler.assemble_output_list(l, sorted_values, divisible_indices)"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 or 13.\n    Returns True if divisible by either, False otherwise.\"\"\"\n    return num % 11 == 0 or num % 13 == 0\ndef _count_digit_7(num: int) -> int:\n    \"\"\"Counts occurrences of the digit 7 in a given integer.\n    Converts the number to a string to count '7' characters.\"\"\"\n    return str(num).count('7')\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    Processes numbers from 0 up to n-1, applying divisibility and digit counting rules.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens_count += _count_digit_7(i)\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def extract_even_values(l: list) -> list:\n    \"\"\"Extracts values from a list at even indices.\n    This function iterates through the input list and collects elements at indices 0, 2, 4, etc.\n    \"\"\"\n    even_values = []\n    for i in range(0, len(l), 2):\n        even_values.append(l[i])\n    return even_values\ndef sort_values(values: list) -> list:\n    \"\"\"Sorts a list of values in ascending order.\n    This function uses Python's built-in sorting capability to arrange the elements.\n    \"\"\"\n    return sorted(values)\ndef reconstruct_list(original: list, sorted_even: list) -> list:\n    \"\"\"Rebuilds the list by placing sorted even values back into their original positions.\n    Odd-indexed values from the original list are preserved in their respective positions.\n    \"\"\"\n    result = list(original) # Create a mutable copy to modify\n    even_idx_counter = 0\n    for i in range(0, len(original), 2):\n        result[i] = sorted_even[even_idx_counter]\n        even_idx_counter += 1\n    return result\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    \n    even_values_extracted = extract_even_values(l)\n    sorted_even_values = sort_values(even_values_extracted)\n    final_list = reconstruct_list(l, sorted_even_values)\n    return final_list"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count_of_seven = 0\n    # Iterate through numbers from 0 up to n-1.\n    for i in range(n):\n        # Check if the number is divisible by 11 or 13.\n        if i % 11 == 0 or i % 13 == 0:\n            # Convert the number to a string and count occurrences of the digit '7'.\n            total_count_of_seven += str(i).count('7')\n    return total_count_of_seven"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n\n    def extract_even_values(lst: list) -> list:\n        \"\"\"Extracts values from even indices of a list.\"\"\"\n        even_values = []\n        for i in range(0, len(lst), 2):\n            even_values.append(lst[i])\n        return even_values\n\n    def sort_values(values: list) -> list:\n        \"\"\"Sorts a list of values in ascending order.\"\"\"\n        return sorted(values)\n\n    def reconstruct_list(original: list, sorted_evens: list) -> list:\n        \"\"\"Reconstructs a list with sorted even values and preserved odd values.\"\"\"\n        result = [0] * len(original)\n        sorted_even_idx = 0\n        for i in range(len(original)):\n            if i % 2 == 0:\n                result[i] = sorted_evens[sorted_even_idx]\n                sorted_even_idx += 1\n            else:\n                result[i] = original[i]\n        return result\n\n    if not l or len(l) == 1:\n        return l\n\n    even_values = extract_even_values(l)\n    sorted_even_values = sort_values(even_values)\n    return reconstruct_list(l, sorted_even_values)"}
{"task_id": "HumanEval/39", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"Tests if a number is prime using an efficient algorithm.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef find_nth_prime_fib(n: int) -> int:\n    \"\"\"Finds the n-th prime Fibonacci number by iterating and testing.\"\"\"\n    prime_count = 0\n    for fib_num in fibonacci_generator():\n        if fib_num <= 1:\n            continue\n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # Delegates the main logic to find_nth_prime_fib as per design.\n    return find_nth_prime_fib(n)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decodes a string that was cyclically encoded by shifting characters in 3-character groups.\n    It reverses the cyclic shift by moving the last character of each group to the beginning.\n    \"\"\"\n    # Split the input string into groups of three characters, handling remaining characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Reverse the cyclic shift for groups that originally had three characters.\n    processed_groups = []\n    for group in groups:\n        if len(group) == 3:\n            processed_groups.append(group[-1] + group[:-1])\n        else:\n            processed_groups.append(group)\n    \n    # Join all processed groups back into the decoded string.\n    return \"\".join(processed_groups)"}
{"task_id": "HumanEval/39", "solution": "from typing import Generator\ndef _is_prime(number: int) -> bool:\n    \"\"\"Check if a number is prime by verifying it has exactly two positive divisors.\n    Uses an optimized trial division method for efficiency.\"\"\"\n    if number <= 1:\n        return False\n    if number <= 3: # 2 and 3 are prime\n        return True\n    if number % 2 == 0 or number % 3 == 0: # Exclude multiples of 2 and 3\n        return False\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    found_prime_fib = 0\n    fib_gen = _generate_fibonacci()\n\n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            count += 1\n            if count == n:\n                found_prime_fib = fib_num\n                break\n    return found_prime_fib"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:  # Handle edge cases with fewer than three elements.\n        return False\n\n    # Iterate through all unique combinations of three distinct indices (i, j, k).\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
