{"task_id": "HumanEval/30", "solution": "def get_positive(l: list) -> list:\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    # This filters the input list to include only numbers greater than zero.\n    # The original order of positive numbers is maintained.\n    return [x for x in l if x > 0]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisors from 3 up to the square root of n, incrementing by 2.\n    # This optimization avoids checking even divisors.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list) -> list:\n    \"\"\"Return only positive numbers in the list.\n\n    Args:\n        l: A list of numbers\n\n    Returns:\n        A new list containing only positive numbers from the input list\n\n    Examples:\n        >>> get_positive([-1, 2, -4, 5, 6])\n        [2, 5, 6]\n        >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n        [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [x for x in l if x > 0]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisors from 3 up to sqrt(n), only odd numbers\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Implement a numerical method (bisection) to find a zero point.\n    # The problem guarantees a solution given the input constraints.\n    \n    # Define an initial search interval and parameters for convergence.\n    low, high = -1000.0, 1000.0\n    epsilon = 1e-7\n    max_iterations = 1000\n    \n    for _ in range(max_iterations):\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < epsilon:\n            return mid\n        \n        p_low = poly(xs, low)\n        \n        # Adjust the search interval based on the sign of poly(mid).\n        if p_low * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n            \n    # Return the midpoint of the final interval if the maximum iterations are reached.\n    return (low + high) / 2"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function selectively sorts elements at indices divisible by three.\n    It returns a new list with these elements sorted, while others remain in place.\n    \"\"\"\n    if not l:\n        return []\n\n    divisible_elements = []\n    divisible_indices = []\n\n    # Extract elements at indices divisible by three and store their original positions.\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            divisible_elements.append(item)\n            divisible_indices.append(i)\n\n    # Sort the extracted elements.\n    sorted_divisible_elements = sorted(divisible_elements)\n\n    # Create a mutable copy of the original list for reconstruction.\n    result_list = l[:]\n\n    # Place the sorted elements back into their original divisible-by-three positions.\n    for j in range(len(sorted_divisible_elements)):\n        result_list[divisible_indices[j]] = sorted_divisible_elements[j]\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef _bisection_method(xs: list, a: float, b: float, tolerance: float = 1e-10) -> float:\n    \"\"\"\n    Internal root finding using the bisection algorithm.\n    It iteratively narrows the interval [a, b] until a root is found within tolerance.\n    \"\"\"\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    while (b - a) > tolerance:\n        mid = (a + b) / 2\n        fmid = poly(xs, mid)\n\n        if fmid == 0.0:\n            return mid\n\n        if fa * fmid < 0:\n            b = mid\n            fb = fmid\n        else:\n            a = mid\n            fa = fmid\n            \n    return (a + b) / 2\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    lower_bound = -1000.0\n    upper_bound = 1000.0\n    \n    return _bisection_method(xs, lower_bound, upper_bound)"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert the list to a set to remove duplicates, then sort the unique elements.\n    return sorted(set(l))"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    current_max = l[0]  # Initialize with the first element, trusting non-empty input.\n    for element in l[1:]:  # Compare subsequent elements to find the largest.\n        if element > current_max:\n            current_max = element\n    return current_max"}
