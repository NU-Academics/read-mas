{"task_id": "HumanEval/62", "solution": "def _validate_input(xs: list) -> bool:\n    \"\"\"Validates the input list of coefficients.\n    Trusts the caller's inputs as valid, returning True directly.\"\"\"\n    return True\ndef _apply_power_rule(coefficient: float, power: int) -> float:\n    \"\"\"Applies the mathematical power rule for a single term.\n    Calculates the new coefficient as (original coefficient * power).\"\"\"\n    return coefficient * power\ndef _format_output(coefficients: list) -> list:\n    \"\"\"Formats the calculated derivative coefficients for output.\n    Returns the list as-is, which is the desired output format.\"\"\"\n    return coefficients\ndef derivative(xs: list):\n    \"\"\"xs represent coefficients of a polynomial: xs[0] + xs[1]*x + xs[2]*x^2 + ....\n    Returns the derivative of this polynomial in the same list format.\"\"\"\n    _validate_input(xs) # Validate input as per design, though simplified.\n\n    derivative_coefficients = []\n    # The derivative of xs[0] (constant term) is 0.\n    # The derivative of xs[i]*x^i is xs[i]*i*x^(i-1).\n    for i in range(1, len(xs)):\n        new_coefficient = _apply_power_rule(xs[i], i)\n        derivative_coefficients.append(new_coefficient)\n\n    return _format_output(derivative_coefficients)"}
{"task_id": "HumanEval/63", "solution": "_memoization_cache: dict[int, int] = {}\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number, utilizing memoization for efficiency.\n    It serves as the main entry point to the FibFib sequence computation.\"\"\"\n    if n in _memoization_cache:\n        return _memoization_cache[n]\n\n    result = _compute_fibfib_recursive(n)\n    _memoization_cache[n] = result\n    return result\ndef _compute_fibfib_recursive(n: int) -> int:\n    \"\"\"Internal helper function to recursively compute FibFib numbers.\n    It handles base cases and the three-term recurrence relation.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n    \n    return fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)"}
{"task_id": "HumanEval/62", "solution": "def validate_input(xs):\n    \"\"\"Checks if input is valid list of numbers.\"\"\"\n    # Per CRITICAL REQUIREMENTS, type checks and validation logic are omitted.\n    return True\ndef multiply_by_power(coeff, power):\n    \"\"\"Multiplies a coefficient by its corresponding power.\"\"\"\n    return coeff * power\ndef apply_power_rule(coefficients: list) -> list:\n    \"\"\"Applies the power rule to calculate derivative coefficients.\"\"\"\n    if not coefficients or len(coefficients) == 1:\n        return []\n    \n    derived_coeffs = []\n    # The derivative of c_i * x^i is i * c_i * x^(i-1).\n    # The new coefficient for x^(i-1) is i * original_coefficients[i].\n    for i in range(1, len(coefficients)):\n        derived_coeffs.append(multiply_by_power(coefficients[i], i))\n        \n    return derived_coeffs\ndef remove_constant_term(coefficients: list) -> list:\n    \"\"\"Removes the constant term from the derivative result.\"\"\"\n    # The apply_power_rule correctly produces a list without the original constant term.\n    return coefficients\ndef format_derivative_result(coefficients: list) -> list:\n    \"\"\"Formats the final derivative result list.\"\"\"\n    # No additional formatting changes are needed after calculation.\n    return coefficients\ndef derivative(xs: list):\n    \"\"\"xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n    Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    validate_input(xs) # Input validation is called, but logic is simplified.\n    \n    calculated_coeffs = apply_power_rule(xs)\n    \n    formatted_coeffs = remove_constant_term(calculated_coeffs)\n    final_result = format_derivative_result(formatted_coeffs)\n    \n    return final_result"}
{"task_id": "HumanEval/63", "solution": "def _compute_base_case(n: int) -> int:\n    \"\"\"Handles base case computations for n=0,1,2.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\ndef _compute_iterative(n: int) -> int:\n    \"\"\"Efficiently computes FibFib values for n>=3 using iteration.\"\"\"\n    a, b, c = 0, 0, 1  # Corresponds to fibfib(0), fibfib(1), fibfib(2)\n    for _ in range(3, n + 1):\n        next_val = a + b + c\n        a, b, c = b, c, next_val\n    return c\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is defined with base cases fibfib(0)=0, fibfib(1)=0, fibfib(2)=1,\n    and for n\u22653, fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\"\"\"\n    if n < 3:\n        return _compute_base_case(n)\n    else:\n        return _compute_iterative(n)"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x right by shift positions.\n    Returns the result as a string, reversing digits if shift exceeds the digit count.\"\"\"\n    \n    # Preserve the sign and get absolute value for digit manipulation\n    x_str = str(x)\n    sign = \"-\" if x_str.startswith('-') else \"\"\n    digits = x_str.lstrip('-')\n    \n    digit_count = len(digits)\n\n    # FR-004: Digit reversal when shift exceeds digit count\n    if shift > digit_count:\n        return sign + digits[::-1]\n    \n    # FR-006: Full cycle shift returns original number (handled by modulo)\n    # FR-002: Circular right shift operation\n    # FR-005: Single position shift moving rightmost digit to leftmost\n    effective_shift = shift % digit_count\n    \n    # Perform the circular right shift\n    # The last 'effective_shift' digits are moved to the front\n    shifted_digits = digits[-effective_shift:] + digits[:-effective_shift]\n    \n    # FR-003, FR-007: String return type for all results\n    return sign + shifted_digits"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Calculates the sum of ASCII values for uppercase characters in a string.\n    Ignores lowercase and non-alphabetic characters, returning 0 for empty strings.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    vowels = \"aeiou\"\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "def _extract_digits(x: int) -> str:\n    \"\"\"Extracts digits from an integer as a string. Handles negative numbers by removing the sign.\"\"\"\n    s = str(x)\n    return s[1:] if s.startswith('-') else s\ndef _calculate_effective_shift(shift: int, digit_count: int) -> int:\n    \"\"\"Calculates the effective right shift amount, considering the number of digits.\"\"\"\n    return shift % digit_count\ndef _perform_shift(digits: str, shift: int) -> str:\n    \"\"\"Performs a circular right shift on a string of digits.\"\"\"\n    # The shift should be pre-calculated as effective_shift.\n    return digits[-shift:] + digits[:-shift]\ndef _reverse_digits(digits: str) -> str:\n    \"\"\"Reverses the order of a string of digits.\"\"\"\n    return digits[::-1]\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    digits = _extract_digits(x)\n    digit_count = len(digits)\n\n    if shift > digit_count:\n        result = _reverse_digits(digits)\n    else:\n        effective_shift = _calculate_effective_shift(shift, digit_count)\n        result = _perform_shift(digits, effective_shift)\n    \n    return result"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    vowels = \"aeiou\"\n\n    # Count standard vowels for all characters except the last one.\n    # 'y' is not counted here, even if present, as it's only a vowel at the end.\n    for char in s[:-1]:\n        if char.lower() in vowels:\n            count += 1\n\n    # Check the last character specifically for vowel status, including the 'y' rule.\n    if len(s) > 0:\n        last_char = s[-1].lower()\n        if last_char in vowels or last_char == 'y':\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII codes for all uppercase characters in the input string.\n    Ignores lowercase and non-alphabetic characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "import re\ndef extract_numbers(s: str) -> list[int]:\n    \"\"\"Extracts all integer numbers from a given string.\n    It uses regular expressions to find digit sequences.\"\"\"\n    return [int(num) for num in re.findall(r'\\d+', s)]\ndef validate_counts(apples: int, oranges: int, total: int) -> bool:\n    \"\"\"Validates if fruit counts and total are non-negative and consistent.\n    This function adheres to the design's validation responsibility.\"\"\"\n    return apples >= 0 and oranges >= 0 and total >= 0 and (apples + oranges <= total)\ndef parse_fruit_string(s: str) -> tuple[int, int]:\n    \"\"\"Parses the input string to extract apple and orange counts.\n    It relies on `extract_numbers` for numerical values.\"\"\"\n    # Per constraints, input format is trusted, so explicit format validation result isn't branched on.\n    numbers = extract_numbers(s)\n    return numbers[0], numbers[1]\ndef calculate_mango_count(total: int, apples: int, oranges: int) -> int:\n    \"\"\"Calculates the number of mango fruits based on total fruits, apples, and oranges.\n    It performs the subtraction and calls `validate_counts` as per design.\"\"\"\n    # The result of validate_counts is not used to alter flow due to \"no exceptions\" constraint.\n    _ = validate_counts(apples, oranges, total)\n    return total - apples - oranges\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given string input for apples and oranges\n    and the total number of fruits. It subtracts apple and orange counts from the total.\n    \"\"\"\n    apple_count, orange_count = parse_fruit_string(s)\n    mango_count = calculate_mango_count(n, apple_count, orange_count)\n    return mango_count"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits based on apple, orange, and total fruit counts.\n    Parses counts from a string and applies a subtraction formula.\n    \"\"\"\n    import re\n\n    # Regex pattern for parsing the input string\n    _re_pattern = r'(\\d+) apples and (\\d+) oranges'\n\n    def _validate_format(text: str) -> bool:\n        \"\"\"Validate string matches required format.\"\"\"\n        return re.fullmatch(_re_pattern, text) is not None\n\n    def _validate_total_count(count: int) -> bool:\n        \"\"\"Validate total count is non-negative.\"\"\"\n        return count >= 0\n\n    def _extract_numbers(text: str) -> list:\n        \"\"\"Extract all numbers from string using regex.\"\"\"\n        match = re.fullmatch(_re_pattern, text)\n        return [int(match.group(1)), int(match.group(2))]\n\n    def _parse_apple_count(text: str) -> int:\n        \"\"\"Extract apple count from formatted string.\"\"\"\n        return _extract_numbers(text)[0]\n\n    def _parse_orange_count(text: str) -> int:\n        \"\"\"Extract orange count from formatted string.\"\"\"\n        return _extract_numbers(text)[1]\n\n    def _calculate_mangoes(total: int, apples_count: int, oranges_count: int) -> int:\n        \"\"\"Calculate mango count using subtraction formula.\"\"\"\n        return total - apples_count - oranges_count\n\n    # The design implies these validations are performed, trusting inputs are valid.\n    _validate_format(s)\n    _validate_total_count(n)\n\n    # Parse apple and orange counts\n    apples = _parse_apple_count(s)\n    oranges = _parse_orange_count(s)\n\n    # Calculate mangoes\n    mangoes = _calculate_mangoes(n, apples, oranges)\n\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its first occurrence index in an array.\n    Returns [value, index] or [] if no even values or an empty array.\n    \"\"\"\n    min_even = None\n    min_index = -1\n\n    if not arr:\n        return []\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if min_even is None or value < min_even:\n                min_even = value\n                min_index = index\n            elif value == min_even:\n                # If values are equal, the first encountered (smallest index) is kept due to this logic.\n                # No action needed as min_index already holds the smallest index for this value.\n                pass \n\n    if min_even is None:\n        return []\n    else:\n        return [min_even, min_index]"}
{"task_id": "HumanEval/69", "solution": "from typing import List, Dict\ndef calculate_frequencies(lst: List[int]) -> Dict[int, int]:\n    \"\"\"\n    Calculates the frequency of each integer in the input list.\n    Returns a dictionary mapping each integer to its count.\n    \"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\ndef find_qualifying_integers(frequencies: Dict[int, int]) -> List[int]:\n    \"\"\"\n    Identifies integers from the frequencies dictionary that meet the qualification criterion.\n    An integer qualifies if its frequency is greater than or equal to its value.\n    \"\"\"\n    qualifying_integers = []\n    for value, frequency in frequencies.items():\n        if frequency >= value:\n            qualifying_integers.append(value)\n    return qualifying_integers\ndef get_maximum(candidates: List[int]) -> int:\n    \"\"\"\n    Finds the greatest integer from a list of candidates.\n    If the list is empty, returns -1.\n    \"\"\"\n    if not candidates:\n        return -1\n    return max(candidates)\ndef search(lst: List[int]) -> int:\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = calculate_frequencies(lst)\n    qualifying_integers = find_qualifying_integers(frequencies)\n    result = get_maximum(qualifying_integers)\n    return result"}
{"task_id": "HumanEval/69", "solution": "def _calculate_frequency(lst):\n    \"\"\"Counts occurrences of each integer in the input list.\n    Returns a dictionary mapping integer to its frequency count.\n    \"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\ndef _find_qualifying_integers(frequencies):\n    \"\"\"Identifies integers where frequency is greater than or equal to their value.\n    Returns a list of these qualifying integers.\n    \"\"\"\n    qualifying_candidates = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying_candidates.append(num)\n    return qualifying_candidates\ndef _get_maximum_or_negative_one(candidates):\n    \"\"\"Returns the maximum value from a list of candidates, or -1 if the list is empty.\n    \"\"\"\n    if not candidates:\n        return -1\n    return max(candidates)\ndef search(lst):\n    \"\"\"Finds the greatest integer in a list whose frequency is greater than or equal to its own value.\n    Returns the greatest qualifying integer, or -1 if none exist.\n    \"\"\"\n    frequencies = _calculate_frequency(lst)\n    qualifying_integers = _find_qualifying_integers(frequencies)\n    result = _get_maximum_or_negative_one(qualifying_integers)\n    return result"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node in an array, returning its value and smallest index as [value, index].\n    Returns an empty list [] if the array is empty or contains no even values.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even = None\n    best_index = -1\n\n    for i, element in enumerate(arr):\n        if element % 2 == 0:  # Check if the element is even\n            if smallest_even is None or element < smallest_even:\n                # Found the first even value, or a new smaller even value\n                smallest_even = element\n                best_index = i\n            elif element == smallest_even and i < best_index:\n                # Tie-breaking: found same smallest even value at an earlier index\n                best_index = i\n\n    if smallest_even is None:\n        return []  # No even values were found in the array\n\n    return [smallest_even, best_index]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Starts with the minimum, then maximum of remaining, then minimum, and so on.\n    '''\n    if not lst:\n        return []\n\n    working_copy = list(lst)\n    result = []\n    is_min_turn = True\n\n    while working_copy:\n        if is_min_turn:\n            # Find the minimum value and its index\n            current_val = min(working_copy)\n            idx = working_copy.index(current_val)\n        else:\n            # Find the maximum value and its index\n            current_val = max(working_copy)\n            idx = working_copy.index(current_val)\n        \n        result.append(current_val)\n        working_copy.pop(idx)\n        is_min_turn = not is_min_turn\n            \n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Sorts a list by alternating between minimum and maximum values from the remaining elements.\n    Returns an empty list if the input list is empty.\n    '''\n\n    # Helper function to find the index of the minimum element in a list.\n    def _find_min_index(remaining_list: list) -> int:\n        min_val = remaining_list[0]\n        min_idx = 0\n        for i in range(1, len(remaining_list)):\n            if remaining_list[i] < min_val:\n                min_val = remaining_list[i]\n                min_idx = i\n        return min_idx\n\n    # Helper function to find the index of the maximum element in a list.\n    def _find_max_index(remaining_list: list) -> int:\n        max_val = remaining_list[0]\n        max_idx = 0\n        for i in range(1, len(remaining_list)):\n            if remaining_list[i] > max_val:\n                max_val = remaining_list[i]\n                max_idx = i\n        return max_idx\n\n    # Helper function to remove an element at a specific index, returning a new list.\n    def _remove_element_at_index(current_list: list, index: int) -> list:\n        return current_list[:index] + current_list[index+1:]\n\n    # Return an empty list for empty input as specified.\n    if not lst:\n        return []\n\n    # Create a mutable copy to process, ensuring the original input list remains unchanged.\n    remaining_elements = list(lst)\n    result = []\n    is_min_turn = True\n\n    # Continue the sorting process until all elements are moved to the result list.\n    while remaining_elements:\n        if is_min_turn:\n            idx_to_remove = _find_min_index(remaining_elements)\n        else:\n            idx_to_remove = _find_max_index(remaining_elements)\n\n        result.append(remaining_elements[idx_to_remove])\n        remaining_elements = _remove_element_at_index(remaining_elements, idx_to_remove)\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef validate_triangle(a, b, c):\n    \"\"\"Checks if three side lengths form a valid triangle.\n    Sides must be positive and satisfy the triangle inequality theorem.\"\"\"\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n    return (a + b > c) and (a + c > b) and (b + c > a)\ndef calculate_area(a, b, c):\n    \"\"\"Calculates the area of a triangle using Heron's formula.\n    Requires valid side lengths a, b, and c.\"\"\"\n    s = (a + b + c) / 2\n    return math.sqrt(s * (s - a) * (s - b) * (s - c))\ndef format_output(area):\n    \"\"\"Rounds the calculated area to exactly two decimal places.\n    This prepares the area for the final output format.\"\"\"\n    return round(area, 2)\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, returns the area rounded to 2 decimal points if valid.\n    Otherwise, returns -1 for invalid triangles.\n    \"\"\"\n    if validate_triangle(a, b, c):\n        area = calculate_area(a, b, c)\n        return format_output(area)\n    else:\n        return -1"}
{"task_id": "HumanEval/71", "solution": "import math\ndef is_valid_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Validate triangle inequality theorem.\n    Checks if all sides are positive and satisfy the sum property.\n    \"\"\"\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n    return (a + b > c and a + c > b and b + c > a)\ndef calculate_area_heron(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculate triangle area using Heron's formula.\n    It first computes the semi-perimeter 's' then applies the formula.\n    \"\"\"\n    s = (a + b + c) / 2\n    return math.sqrt(s * (s - a) * (s - b) * (s - c))\ndef round_to_two_decimals(value: float) -> float:\n    \"\"\"\n    Round value to exactly 2 decimal places.\n    Uses the built-in round function for floating-point values.\n    \"\"\"\n    return round(value, 2)\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculate triangle area or return -1 for invalid triangle.\n    It validates triangle geometry before proceeding with area calculation and rounding.\n    \"\"\"\n    if not is_valid_triangle(a, b, c):\n        return -1.0\n    \n    area = calculate_area_heron(a, b, c)\n    return round_to_two_decimals(area)"}
{"task_id": "HumanEval/72", "solution": "def is_palindromic(lst):\n    \"\"\"Checks if a list is palindromic. Handles empty and single-element lists.\"\"\"\n    return lst == lst[::-1]\ndef calculate_sum(lst):\n    \"\"\"Calculates the sum of all numeric elements in a list.\"\"\"\n    return sum(lst)\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    \n    is_balanced = is_palindromic(q)\n    \n    if not is_balanced:\n        return False\n        \n    total_weight = calculate_sum(q)\n    \n    return total_weight <= w"}
{"task_id": "HumanEval/72", "solution": "def validate_inputs(q, w):\n    \"\"\"\n    Validates input parameters q and w according to the design. This function assumes inputs are valid as per critical requirements.\n    \"\"\"\n    # As per critical requirement: \"Trust the caller's inputs and implement the simplest, most direct logic possible.\"\n    # and \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n    # Thus, this function will simply return True.\n    return True\ndef is_palindromic(q):\n    \"\"\"\n    Check if the list `q` is palindromic. It compares elements from both ends moving inwards, achieving O(n) time and O(1) space complexity.\n    \"\"\"\n    left, right = 0, len(q) - 1\n    while left < right:\n        if q[left] != q[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\ndef calculate_sum(q):\n    \"\"\"\n    Calculate the sum of all numeric elements in list `q`. This function iterates through the list to accumulate the sum.\n    \"\"\"\n    total_sum = 0\n    for item in q:\n        total_sum += item\n    return total_sum\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if an object `q` will fly based on structural balance (palindromic property) and weight constraints `w`. It returns True if both conditions are met, False otherwise.\n    \"\"\"\n    if not validate_inputs(q, w):\n        return False\n\n    is_balanced = is_palindromic(q)\n    if not is_balanced:\n        return False\n\n    current_weight = calculate_sum(q)\n    weight_compliant = current_weight <= w\n\n    return is_balanced and weight_compliant"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n\n    def validate_input(input_arr):\n        \"\"\"\n        Validates input array format and type.\n        Per system constraints, it trusts the input and always returns True.\n        \"\"\"\n        return True\n\n    def compare_elements(left_val, right_val):\n        \"\"\"\n        Compares symmetric elements for equality.\n        Returns True if the elements are identical, False otherwise.\n        \"\"\"\n        return left_val == right_val\n\n    def calculate_changes(input_arr):\n        \"\"\"\n        Calculates minimum changes required using a two-pointer approach.\n        It iterates through the array from both ends to count mismatches.\n        \"\"\"\n        changes = 0\n        left = 0\n        right = len(input_arr) - 1\n\n        while left < right:\n            if not compare_elements(input_arr[left], input_arr[right]):\n                changes += 1\n            left += 1\n            right -= 1\n        return changes\n\n    # Main execution flow as per design sequence diagram\n    # The validate_input function, constrained to trust input, will always return True.\n    if validate_input(arr):\n        return calculate_changes(arr)\n    else:\n        # This branch is unreachable due to validate_input's current implementation constraints.\n        return 0 # Or an appropriate error value, though not expected to be reached."}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings by their total character count, returning the list with fewer characters.\n    If counts are equal, the first list is returned.\n    '''\n    count_lst1 = sum(len(s) for s in lst1)\n    count_lst2 = sum(len(s) for s in lst2)\n\n    if count_lst1 <= count_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/73", "solution": "def _validate_input(arr: list) -> bool:\n    \"\"\"Validate input array parameter.\n    This function always returns True due to critical constraints.\n    \"\"\"\n    return True\ndef _is_palindromic(arr: list) -> bool:\n    \"\"\"Check if array is palindromic.\n    Compares elements from both ends inwards.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\ndef _calculate_changes(arr: list) -> int:\n    \"\"\"Core algorithm to count minimum changes.\n    Compares elements from both ends and counts mismatches.\n    \"\"\"\n    changes = 0\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\ndef smallest_change(arr: list) -> int:\n    \"\"\"Calculate minimum changes for palindrome formation.\"\"\"\n    _validate_input(arr)  # Adheres to architectural design calling validation.\n\n    if _is_palindromic(arr):\n        return 0\n\n    return _calculate_changes(arr)"}
{"task_id": "HumanEval/74", "solution": "from typing import List\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Compares two string lists by their total character count and returns the list with fewer characters.\n    If counts are equal, the first list (lst1) is returned as a tie-breaker.\n    \"\"\"\n    # Calculate total character count for the first list.\n    count1 = sum(len(s) for s in lst1)\n\n    # Calculate total character count for the second list.\n    count2 = sum(len(s) for s in lst2)\n\n    # Return the list with fewer characters, or the first list if counts are equal.\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "import math\ndef is_prime(n):\n    \"\"\"Checks if a number is prime. Handles numbers up to 100 efficiently.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to sqrt(n).\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef get_prime_factors(n):\n    \"\"\"Gets all prime factors of a number with repetition, verifying primality as per design.\"\"\"\n    factors = []\n    temp_n = n\n\n    # Handle factor 2.\n    while temp_n % 2 == 0:\n        if is_prime(2): # Verifies primality of factor 2, as per sequence diagram.\n            factors.append(2)\n            temp_n //= 2\n    \n    # Handle odd factors starting from 3.\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            if is_prime(d): # Verifies primality of factor 'd', as per sequence diagram.\n                factors.append(d)\n                temp_n //= d\n        d += 2 # Move to the next odd number.\n\n    # If a number greater than 1 remains, it must be a prime factor.\n    if temp_n > 1:\n        if is_prime(temp_n): # Verifies primality of the last remaining factor.\n            factors.append(temp_n)\n    return factors\ndef validate_multiply_prime(n):\n    \"\"\"Validates if a number is the product of exactly 3 prime numbers.\"\"\"\n    if n < 2: # Numbers less than 2 cannot have prime factors.\n        return False\n    factors = get_prime_factors(n)\n    return len(factors) == 3\ndef is_multiply_prime(a):\n    \"\"\"Checks if 'a' is the product of exactly three prime numbers.\n    'a' is an integer less than 100.\n    \"\"\"\n    if a < 1: # Numbers less than 1 are not products of primes.\n        return False\n    return validate_multiply_prime(a)"}
{"task_id": "HumanEval/75", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"Determines if a number is prime.\n    Returns True if prime, False otherwise.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    d = 3\n    while d * d <= number:\n        if number % d == 0:\n            return False\n        d += 2\n    return True\ndef get_prime_factors(number: int) -> list:\n    \"\"\"Performs prime factorization of the input number.\n    Returns a list of prime factors, including multiplicities.\"\"\"\n    factors = []\n    temp_num = number\n    d = 2\n    while d * d <= temp_num:\n        if is_prime(d):\n            while temp_num % d == 0:\n                factors.append(d)\n                temp_num //= d\n        d += 1\n    if temp_num > 1:\n        factors.append(temp_num)\n    return factors\ndef count_prime_factors(factors: list) -> int:\n    \"\"\"Counts the total number of prime factors in a list.\n    Returns the count, including multiplicities.\"\"\"\n    return len(factors)\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Checks if the given number is the product of exactly three prime numbers.\n    The input 'a' is expected to be less than 100.\"\"\"\n    if a < 2: # Numbers less than 2 cannot be products of primes\n        return False\n    \n    prime_factors = get_prime_factors(a)\n    num_prime_factors = count_prime_factors(prime_factors)\n    \n    return num_prime_factors == 3"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"\n    Determines if x is a simple integer power of n (n^k = x for integer k).\n    It handles various numerical inputs including floating-point values.\n    \"\"\"\n    # Case 1: x is 1. Any non-zero 'n' raised to power 0 is 1.\n    if x == 1:\n        return n != 0\n\n    # Case 2: n is 1 (and x is not 1, as handled above).\n    # If n is 1, 1^k will always be 1. So if x is not 1, it cannot be a power of 1.\n    if n == 1:\n        return False\n\n    # Case 3: n is 0 (and x is not 1, as handled above).\n    # If n is 0, 0^k = 0 for k > 0. So x must be 0.\n    if n == 0:\n        return x == 0\n\n    # Case 4: n < 0.\n    # For n < 0, n^k alternates sign. We calculate k for absolute values and then verify.\n    if n < 0:\n        if x == 0:  # If n < 0, n^k cannot be 0.\n            return False\n\n        try:\n            k_candidate = math.log(abs(x), abs(n))\n        except ValueError: # Occurs if abs(x) <= 0 or abs(n) <= 0 or abs(n) == 1 (already handled).\n            return False\n\n        k_int = round(k_candidate)\n\n        # Check if k_candidate is close to an integer\n        if not math.isclose(k_candidate, k_int, rel_tol=1e-9, abs_tol=1e-9):\n            return False\n\n        # Verify n^k_int against x, Python's ** handles negative bases.\n        return math.isclose(n**k_int, x, rel_tol=1e-9, abs_tol=1e-9)\n\n    # Case 5: x <= 0 (and n > 0, n != 1, n != 0).\n    # If n > 0, n^k will always be positive for any real k.\n    # Thus, if x is zero or negative, it cannot be a power of a positive n.\n    if x <= 0:\n        return False\n\n    # General Case: x > 0, n > 0, n != 1.\n    # Calculate the exponent k = log_n(x).\n    k_candidate = math.log(x, n)\n\n    # Check if k is an integer, accounting for floating-point inaccuracies.\n    k_int = round(k_candidate)\n\n    if not math.isclose(k_candidate, k_int, rel_tol=1e-9, abs_tol=1e-9):\n        return False\n\n    # Final verification using the integer exponent.\n    return math.isclose(n**k_int, x, rel_tol=1e-9, abs_tol=1e-9)"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Checks if an integer is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root, which correctly handles negative numbers.\n    cube_root_float = math.cbrt(a)\n\n    # Round the floating-point cube root to the nearest integer.\n    # This helps mitigate floating-point precision issues.\n    rounded_root = round(cube_root_float)\n\n    # Check if cubing the rounded integer yields the original number.\n    # This comparison validates if 'a' is indeed a perfect cube.\n    return rounded_root * rounded_root * rounded_root == a"}
{"task_id": "HumanEval/77", "solution": "import math\ndef _calculate_cube_root(a: int) -> float:\n    \"\"\"\n    Calculates the cube root of an integer, preserving its sign.\n    Uses the standard math library for numerical computation.\n    \"\"\"\n    if a == 0:\n        return 0.0\n    abs_root = math.pow(abs(a), 1/3)\n    return abs_root if a > 0 else -abs_root\ndef _is_perfect_cube(a: int, root: float) -> bool:\n    \"\"\"\n    Validates if the calculated root corresponds to a perfect cube.\n    Compares the original number to the cube of the rounded root.\n    \"\"\"\n    rounded_root = round(root)\n    # Cast to int for comparison with original integer 'a'\n    return a == int(math.pow(rounded_root, 3))\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Determines if an integer is a perfect cube of some integer number.\n    It coordinates cube root calculation and validation steps.\n    \"\"\"\n    cube_root = _calculate_cube_root(a)\n    return _is_perfect_cube(a, cube_root)"}
{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\ndef hex_key(num: str) -> int:\n    \"\"\"Counts prime hexadecimal digits in the input string.\n    Identifies prime digits as 2, 3, 5, 7, B (11), D (13) and returns their total count.\n    \"\"\"\n    count = 0\n    for char in num:\n        if char in PRIME_HEX_DIGITS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    \"\"\"\n\n    class EdgeCaseHandler:\n        \"\"\"Handles specific mathematical edge cases related to bases 0 and 1.\"\"\"\n        def handle_base_one(self, x_val: float, n_val: float) -> bool | None:\n            \"\"\"Determines if x_val is a simple power of n_val when n_val is 1.\n            Returns True if x_val=1, n_val=1; False if x_val!=1, n_val=1; None otherwise.\n            \"\"\"\n            if n_val == 1:\n                return x_val == 1\n            return None\n\n        def handle_base_zero(self, x_val: float, n_val: float) -> bool | None:\n            \"\"\"Determines if x_val is a simple power of n_val when n_val is 0.\n            Returns True if x_val is 0 or 1, False otherwise, when n_val=0; None otherwise.\n            \"\"\"\n            if n_val == 0:\n                if x_val == 1:  # 0**0 = 1\n                    return True\n                elif x_val == 0:  # 0**k = 0 for k > 0\n                    return True\n                else:\n                    return False\n            return None\n\n        def validate_inputs(self, x_val: float, n_val: float) -> bool:\n            \"\"\"Placeholder for input validation; returns True as type checks are forbidden.\"\"\"\n            # Critical requirements forbid explicit type checks or exceptions.\n            # This method acts as a no-op but fulfills the architectural component usage.\n            return True\n\n    class PowerValidator:\n        \"\"\"Performs mathematical power relationship validation for non-negative integer exponents.\"\"\"\n        def calculate_power(self, base: float, exponent: int) -> float:\n            \"\"\"Calculates base raised to a non-negative integer exponent.\"\"\"\n            return base ** exponent\n\n        def validate_power_relationship(self, x_val: float, n_val: float) -> bool:\n            \"\"\"Checks if x_val is n_val raised to a non-negative integer power.\n            It iteratively tests exponents up to a safe limit.\n            \"\"\"\n            k = 0\n            MAX_EXPONENT_LIMIT = 200  # Safeguard against very large exponents or infinite loops.\n\n            while k <= MAX_EXPONENT_LIMIT:\n                current_power = self.calculate_power(n_val, k)\n\n                if current_power == x_val:\n                    return True\n\n                # --- Termination conditions based on n_val's behavior ---\n                if n_val > 1:\n                    # If powers grow and exceed x_val, no further match.\n                    # If x_val is negative, a positive base cannot match it.\n                    if current_power > x_val or x_val < 0:\n                        return False\n                elif 0 < n_val < 1:\n                    # If powers shrink and drop below x_val (for non-negative x_val), no further match.\n                    # If x_val is negative, a positive base cannot match it.\n                    if current_power < x_val or x_val < 0:\n                        return False\n                elif n_val < 0:\n                    # If absolute powers grow past absolute x_val without a match, then stop.\n                    # This handles alternating signs for negative bases.\n                    if abs(current_power) > abs(x_val):\n                        return False\n                # Cases where n_val is 0 or 1 are handled by EdgeCaseHandler and will not reach here.\n                \n                k += 1\n            \n            return False  # No integer power found within the iteration limit.\n\n    # --- Orchestration in the is_simple_power function ---\n    edge_handler = EdgeCaseHandler()\n    power_validator = PowerValidator()\n\n    # Call validate_inputs as per design, but its logic is a no-op due to critical constraints.\n    _ = edge_handler.validate_inputs(x, n) \n\n    # Handle n=0 and n=1 specific edge cases first.\n    result = edge_handler.handle_base_zero(x, n)\n    if result is not None:\n        return result\n    \n    result = edge_handler.handle_base_one(x, n)\n    if result is not None:\n        return result\n\n    # Handle x=0 explicitly for cases where n is not 0.\n    # If x is 0 and n is not 0 (e.g., n=2), then n**k can never be 0 for a non-negative integer k.\n    if x == 0:\n        return False\n\n    # For all other general cases, delegate to the core power validation logic.\n    return power_validator.validate_power_relationship(x, n)"}
