{"task_id": "Mbpp/255", "solution": "import itertools\nfrom typing import List, Any, Tuple\ndef combinations_colors(input_list: List[Any], length_n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generates all combinations with repetition from a list for a specified length.\n    Returns a list of tuples, where each tuple is a combination.\n    \"\"\"\n    return list(itertools.product(input_list, repeat=length_n))"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(input_list: list, n: int) -> list[tuple]:\n    \"\"\"\n    Generates all combinations with repetition from a list for a specified length.\n    Returns combinations as a list of tuples.\n    \"\"\"\n    results = []\n    num_elements = len(input_list)\n\n    if n == 0:\n        return [()]\n    if num_elements == 0:\n        return []\n\n    def generate(current_combo, start_index):\n        if len(current_combo) == n:\n            results.append(tuple(current_combo))\n            return\n\n        for i in range(start_index, num_elements):\n            current_combo.append(input_list[i])\n            generate(current_combo, i)\n            current_combo.pop()\n\n    generate([], 0)\n    return results"}
{"task_id": "Mbpp/256", "solution": "import math\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than n using the Sieve of Eratosthenes.\n    Returns 0 if n is less than or equal to 2.\n    \"\"\"\n    if n <= 2:\n        return 0\n\n    # Initialize a boolean list marking all numbers as potentially prime.\n    is_prime = [True] * n\n    is_prime[0] = False\n    is_prime[1] = False\n\n    # Apply the Sieve of Eratosthenes to mark non-prime numbers.\n    for p in range(2, int(math.sqrt(n)) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Count all numbers marked as prime.\n    prime_count = 0\n    for i in range(2, n):\n        if is_prime[i]:\n            prime_count += 1\n\n    return prime_count"}
{"task_id": "Mbpp/244", "solution": "def next_Perfect_Square(number: int) -> int:\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than the input number.\n    This function implicitly assumes the input 'number' is a non-negative integer.\n    \"\"\"\n    root = int(number**0.5)\n    return (root + 1) ** 2"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(num: int) -> int:\n    \"\"\"\n    Calculates the number of prime numbers strictly less than a given non-negative integer.\n    It uses the Sieve of Eratosthenes algorithm for efficient prime identification.\n    \"\"\"\n    if num <= 2:\n        return 0\n\n    is_prime = [True] * num\n    is_prime[0] = False\n    is_prime[1] = False\n\n    for p in range(2, int(num**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, num, p):\n                is_prime[multiple] = False\n\n    prime_count = 0\n    for i in range(2, num):\n        if is_prime[i]:\n            prime_count += 1\n\n    return prime_count"}
