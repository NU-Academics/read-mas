{"task_id": "Mbpp/758", "solution": "import collections\ndef unique_sublists(input_list_of_lists):\n    \"\"\"Counts occurrences of unique sublists after converting them to tuples.\n    Returns a dictionary mapping unique tuples to their counts.\"\"\"\n\n    tuple_representations = [tuple(sublist) for sublist in input_list_of_lists]\n    counts = collections.Counter(tuple_representations)\n    return counts"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts pairs of strings where one is the reverse of the other.\n    Each unique string value participates in at most one pair, and palindromes do not form pairs with themselves.\"\"\"\n\n    count = 0\n    processed_strings = set()\n    string_set = set(string_list) # Use a set for efficient O(1) average time lookups.\n\n    for s in string_list:\n        if s in processed_strings:\n            continue\n\n        reversed_s = s[::-1]\n\n        # Check if the reversed string exists, is different from the original,\n        # and hasn't been processed yet to form a pair.\n        if reversed_s in string_set and reversed_s != s and reversed_s not in processed_strings:\n            count += 1\n            processed_strings.add(s)\n            processed_strings.add(reversed_s)\n\n    return count"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Validates if the input_string represents a decimal number with exactly two digits after the decimal point.\n    The pattern matches an optional sign, one or more digits, a literal decimal point, and exactly two digits.\n    \"\"\"\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Validates if a string represents a decimal number with exactly two digits after the decimal point.\n    The regex matches an optional sign, followed by either 'digits.two_digits' (e.g., '123.11', '0.00') or '.two_digits' (e.g., '.11').\n    \"\"\"\n    pattern = r\"^[+-]?(\\d+\\.\\d{2}|\\.\\d{2})$\"\n    return re.fullmatch(pattern, input_string) is not None"}
