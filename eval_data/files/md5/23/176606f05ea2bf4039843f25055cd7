{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\n    This function computes pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    r_squared = r * r\n    h_squared = h * h\n\n    # Compute the slant height using the Pythagorean theorem.\n    slant_height = math.sqrt(r_squared + h_squared)\n\n    # The lateral surface area is pi multiplied by radius and slant height.\n    area = math.pi * r * slant_height\n\n    return area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots in an input string with a colon.\n    This function processes the string by chaining replace operations for each target character.\n    \"\"\"\n    # Replace spaces with colons\n    modified_string = input_string.replace(' ', ':')\n    # Replace commas with colons\n    modified_string = modified_string.replace(',', ':')\n    # Replace dots with colons\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(sorted_array, target_number):\n    \"\"\"\n    Finds the 0-based index of the first occurrence of a target number in a sorted array.\n    Uses an iterative binary search algorithm to efficiently locate the index.\n    \"\"\"\n    low = 0\n    high = len(sorted_array) - 1\n    potential_result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if sorted_array[mid] == target_number:\n            potential_result = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif sorted_array[mid] < target_number:\n            low = mid + 1\n        else:  # sorted_array[mid] > target_number\n            high = mid - 1\n    return potential_result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(sorted_list: list[int], target_number: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted list.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(sorted_list) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] == target_number:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif sorted_list[mid] < target_number:\n            low = mid + 1\n        else:  # sorted_list[mid] > target_number\n            high = mid - 1\n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list[int]) -> int:\n    \"\"\"Calculates the sum of products of all possible sublists within a given list.\n    It efficiently iterates through all sublists, computing their product and adding it to a total.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Determines the leftmost insertion point for a value in a sorted list using binary search.\n    This ensures O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value > sorted_list[mid]:\n            low = mid + 1\n        else:  # value <= sorted_list[mid] to find the leftmost insertion point\n            high = mid\n    return low"}
