{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of the number except the first (MSB) and the last (LSB).\n    The function handles cases where there are no middle bits to toggle.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    num_bits = number.bit_length()\n\n    # If there are 2 or fewer bits, there are no middle bits to toggle.\n    if num_bits <= 2:\n        return number\n\n    # Create a mask with 1s only for the middle bits.\n    # For example, if num_bits = 4, (1 << (4 - 2)) - 1 = (1 << 2) - 1 = 3 (0011 binary).\n    # Shifting left by 1 gives 0110 binary, which masks the middle bits.\n    middle_bits_mask = ((1 << (num_bits - 2)) - 1) << 1\n\n    # Toggle only the middle bits using XOR.\n    toggled_number = number ^ middle_bits_mask\n\n    return toggled_number"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(text: str) -> bool:\n    \"\"\"Checks if a string starts with a vowel using a case-insensitive regular expression.\n    Returns True if it starts with a vowel (a, e, i, o, u), False otherwise.\"\"\"\n    pattern = r\"^[aeiou]\"\n    return bool(re.search(pattern, text, re.IGNORECASE))"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n):\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    The index k corresponds to the k-th triangular number, T(k) = k*(k+1)/2.\n    \"\"\"\n    min_val = 10**(n - 1)\n    k = 1\n    while True:\n        triangular_num = k * (k + 1) // 2\n        if triangular_num >= min_val:\n            return k\n        k += 1"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list, number_to_insert: float) -> int:\n    \"\"\"\n    Locates the leftmost insertion point for a value in a sorted list using binary search.\n    Returns the index where the number should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] < number_to_insert:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"Calculates the index of the smallest triangular number with n digits.\n    This function determines the smallest integer k such that T_k is greater than or equal to 10^(n-1).\n    \"\"\"\n    lower_bound_value = 10**(n-1)\n    C = 2 * lower_bound_value  # This intermediate constant is computed as per the design specification.\n    k_float = (-1 + math.sqrt(1 + 8 * lower_bound_value)) / 2\n    k = int(math.ceil(k_float))\n    return k"}
