{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a perfect square using binary search.\n    This method efficiently determines if the square root is an integer.\"\"\"\n    if number < 0:\n        # Per design, input is non-negative, but a robust check would handle this.\n        # For simplicity, based on \"trust the caller's inputs\", this path is unreachable.\n        return False\n    if number == 0 or number == 1:\n        return True\n\n    low, high = 1, number\n    while low <= high:\n        mid = (low + high) // 2\n        square = mid * mid\n        if square == number:\n            return True\n        elif square < number:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"Identifies the inner list with the highest sum of elements.\n    It returns this identified inner list.\"\"\"\n\n    highest_sum = sum(list_of_lists[0])\n    list_with_highest_sum = list_of_lists[0]\n\n    for inner_list in list_of_lists[1:]:\n        current_sum = sum(inner_list)\n        if current_sum > highest_sum:\n            highest_sum = current_sum\n            list_with_highest_sum = inner_list\n\n    return list_with_highest_sum"}
{"task_id": "Mbpp/804", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if a single integer is an even number.\n    Returns True if the number is even, False otherwise.\"\"\"\n    return number % 2 == 0\ndef is_product_even(numbers: list) -> bool:\n    \"\"\"Determines if the product of numbers in a list is even.\n    Returns True if the product is even, False if it's odd.\"\"\"\n    if not numbers:\n        # An empty list's product (conventionally 1) is considered odd.\n        return False\n\n    # If any number in the list is 0, the product is 0, which is even.\n    if 0 in numbers:\n        return True\n\n    # The product is even if at least one non-zero number in the list is even.\n    for number in numbers:\n        if _is_even(number):\n            return True\n\n    # If no even numbers were found, all numbers are odd, so their product is odd.\n    return False"}
{"task_id": "Mbpp/804", "solution": "class ProductCalculator:\n    \"\"\"Calculates the product of a list of numbers.\n    Returns the product as a float, accommodating non-integer values.\"\"\"\n    def calculate_product(self, numbers: list) -> float:\n        product_value = 1.0\n        for num in numbers:\n            product_value *= num\n        return product_value\nclass EvennessChecker:\n    \"\"\"Determines if a given number is even.\n    Checks the integer part of the number for evenness.\"\"\"\n    def is_even(self, number: float) -> bool:\n        integer_part = int(number)\n        return integer_part % 2 == 0\ndef is_product_even(numbers: list) -> bool:\n    \"\"\"Checks if the product of numbers in a list is even.\n    Delegates product calculation and evenness determination to helper classes.\"\"\"\n    if not numbers:\n        # As per design, an empty list results in a product of 1 (multiplicative identity).\n        product_result = 1.0\n    else:\n        product_calculator = ProductCalculator()\n        product_result = product_calculator.calculate_product(numbers)\n\n    evenness_checker = EvennessChecker()\n    return evenness_checker.is_even(product_result)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"Calculates the maximum run of consecutive uppercase characters in a string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n\n    if not input_string:\n        return 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n\n    # Account for a run ending at the end of the string\n    max_run = max(max_run, current_run)\n\n    return max_run"}
