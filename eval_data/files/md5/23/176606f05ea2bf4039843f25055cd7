{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n\n    The Eulerian number A(n, m) (or a(n, m)) is the number of permutations\n    of the set {1, 2, ..., n} in which exactly m elements are greater\n    than the preceding element (i.e., have m ascents).\n\n    Args:\n        n: A non-negative integer.\n        m: A non-negative integer.\n\n    Returns:\n        The Eulerian number a(n, m).\n    \"\"\"\n\n    def _factorial(k: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k < 0:\n            return 0\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    def _combinations(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates 'n choose k' (binomial coefficient).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val  # Optimization: C(n, k) = C(n, n-k)\n\n        num = _factorial(n_val)\n        den = _factorial(k_val) * _factorial(n_val - k_val)\n        return num // den\n\n    # Handle edge cases as per design document (FR3, FR4)\n    if m >= n:\n        return 0\n    if n == 0 and m == 0:\n        return 1\n\n    # Calculate Eulerian Number for 0 < n and 0 <= m < n (FR5)\n    # Formula: A(n, m) = sum_{k=0}^{m} (-1)^k * C(n+1, k) * (m - k + 1)^n\n    eulerian_number_result = 0\n    for k in range(m + 1):\n        term = ((-1) ** k) * \\\n               _combinations(n + 1, k) * \\\n               ((m - k + 1) ** n)\n        eulerian_number_result += term\n    return eulerian_number_result"}
