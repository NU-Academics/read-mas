{"task_id": "Mbpp/7", "solution": "def find_char_long(text: str) -> list[str]:\n    \"\"\"Extracts words from a string that are at least 4 characters long.\n    The function splits the input by whitespace and filters by word length.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) >= 4]\n    return filtered_words"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(text_string: str) -> set[str]:\n    \"\"\"\n    Identifies and returns a set of unique words from an input string\n    that are at least 4 characters long.\n    \"\"\"\n    filtered_words = set()\n    words = text_string.split()\n\n    for word in words:\n        if len(word) >= 4:\n            filtered_words.add(word)\n\n    return filtered_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"Calculates the minimum positive rotations for a string to return to its original state.\n    It iterates through possible rotation counts, returning the first match found.\n    \"\"\"\n    n = len(input_string)\n    for k in range(1, n): # Iterate through possible rotation counts from 1 up to n-1.\n        rotated_string = input_string[k:] + input_string[:k]\n        if rotated_string == input_string:\n            return k\n    # If the loop completes, no smaller positive rotation (k < n) returned the original string.\n    # In such cases, the string only returns to its original state after n rotations.\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a specified character from a string.\n    Returns the modified string or the original if the character is not found.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == -1:\n        # Character not found, return original string\n        return input_string\n    elif first_idx == last_idx:\n        # Character appears exactly once, remove that single occurrence\n        return input_string[:first_idx] + input_string[first_idx+1:]\n    else:\n        # Character appears multiple times, remove first then last\n        # Remove the first occurrence\n        temp_string = input_string[:first_idx] + input_string[first_idx+1:]\n        # Find and remove the last occurrence in the temporary string\n        last_idx_in_temp = temp_string.rfind(char_to_remove)\n        return temp_string[:last_idx_in_temp] + temp_string[last_idx_in_temp+1:]"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the square of each number in the input list.\n    Returns a new list containing the squared values.\n    \"\"\"\n    squared_numbers = []\n    for num in numbers:\n        squared_numbers.append(num * num)\n    return squared_numbers"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum positive number of rotations required to transform a string back into itself.\n    For \"aaaa\", it returns 1; for \"abc\", it returns 3.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        # For an empty string, 1 is the smallest positive rotation.\n        return 1\n\n    # Searches for the original string `s` within `s + s` starting from index 1.\n    # This finds the smallest positive rotation that results in the original string.\n    return (s + s).find(s, 1)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(string: str, char: str) -> str:\n    \"\"\"Removes the first and last occurrences of a character from a string.\n\n    If the character appears only once, that single occurrence is removed.\n    \"\"\"\n    first_idx = string.find(char)\n\n    if first_idx == -1:\n        return string\n\n    last_idx = string.rfind(char)\n\n    if first_idx == last_idx:\n        # Character exists only once, remove that single occurrence.\n        return string[:first_idx] + string[first_idx+1:]\n    else:\n        # Remove the first occurrence.\n        string_after_first_removal = string[:first_idx] + string[first_idx+1:]\n\n        # Adjust last_idx for the modified string.\n        # If first_idx was before last_idx, last_idx shifts left by 1.\n        adjusted_last_idx = last_idx - 1\n\n        # Remove the adjusted last occurrence from the intermediate string.\n        return string_after_first_removal[:adjusted_last_idx] + string_after_first_removal[adjusted_last_idx+1:]"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"Checks if the input string consists of lowercase letter sequences joined by underscores.\n    Uses a regular expression for efficient pattern matching.\"\"\"\n    pattern = r\"^[a-z]+(_[a-z]+)*$\"\n    return re.fullmatch(pattern, text) is not None"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(inputString: str) -> bool:\n    \"\"\"\n    Evaluates an input string to determine if it contains sequences of lowercase\n    letters joined by an underscore.\n    \"\"\"\n    # Regex to match sequences of lowercase letters joined by an underscore.\n    pattern = r\"([a-z]+_[a-z]*)|([a-z]*_[a-z]+)\"\n\n    return bool(re.search(pattern, inputString))"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts the rows of a matrix based on the sum of their elements in ascending order.\n    Returns a new matrix, leaving the original input matrix unmodified.\n    \"\"\"\n    row_sums_and_rows = []\n    for row in matrix:\n        row_sum = sum(row)\n        # Appending a tuple (row_sum, original_row) ensures the original row object\n        # is referenced without modification to the input matrix.\n        row_sums_and_rows.append((row_sum, row))\n\n    # Sort the list of tuples based on the row_sum (the first element).\n    sorted_row_sums_and_rows = sorted(row_sums_and_rows)\n\n    # Extract the original rows from the sorted tuples to construct the new matrix.\n    new_sorted_matrix = [row for row_sum, row in sorted_row_sums_and_rows]\n\n    return new_sorted_matrix"}
