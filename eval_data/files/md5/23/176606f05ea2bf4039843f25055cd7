{"task_id": "Mbpp/56", "solution": "def _reverse_number(num: int) -> int:\n    \"\"\"\n    Reverses the digits of an integer, preserving its sign.\n    Handles negative numbers and drops leading zeros in the reversed representation.\n    \"\"\"\n    sign = -1 if num < 0 else 1\n    abs_num_str = str(abs(num))\n    reversed_abs_num_str = abs_num_str[::-1]\n    return sign * int(reversed_abs_num_str)\ndef _multiply_by_two(num: int) -> int:\n    \"\"\"\n    Multiplies an integer by two.\n    \"\"\"\n    return num * 2\ndef _subtract_one(num: int) -> int:\n    \"\"\"\n    Subtracts one from an integer.\n    \"\"\"\n    return num - 1\ndef check(number: int) -> bool:\n    \"\"\"\n    Determines if the original number is one less than twice its reverse.\n    It orchestrates helper functions to perform the necessary calculations and comparison.\n    \"\"\"\n    reversed_num = _reverse_number(number)\n    twice_reversed_num = _multiply_by_two(reversed_num)\n    calculated_value = _subtract_one(twice_reversed_num)\n    return number == calculated_value"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if a given integer is a Woodall number.\n    Returns True if it is, False otherwise, including for numbers less than 1.\n    \"\"\"\n    if number < 1:\n        return False\n\n    n = 1\n    while True:\n        # Calculate Wn using the formula n * 2^n - 1\n        wn = n * (2**n) - 1\n\n        if wn == number:\n            return True\n        elif wn > number:\n            return False\n\n        # If wn is less than number, increment n and continue the loop\n        n += 1"}
{"task_id": "Mbpp/57", "solution": "import functools\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed by concatenating the given list of digits.\n    Returns 0 if the input list is empty or if all digits result in 0.\n    \"\"\"\n    str_digits = [str(d) for d in digits]\n\n    def compare(a, b):\n        \"\"\"Custom comparison to sort strings for largest concatenated number.\"\"\"\n        if (b + a) > (a + b):\n            return -1\n        elif (b + a) < (a + b):\n            return 1\n        else:\n            return 0\n\n    str_digits.sort(key=functools.cmp_to_key(compare))\n\n    result_str = \"\".join(str_digits)\n\n    if not result_str:\n        return 0\n    elif int(result_str) == 0:\n        return 0\n    else:\n        return int(result_str)"}
{"task_id": "Mbpp/56", "solution": "def check(num: int) -> bool:\n    # Determines if the given number is one less than twice its reverse.\n    # It handles positive, zero, and negative integers by preserving the original sign during reversal.\n    is_negative = num < 0\n    abs_num = abs(num)\n\n    reversed_abs_num = int(str(abs_num)[::-1])\n    reversed_integer = -reversed_abs_num if is_negative else reversed_abs_num\n\n    target_value = (reversed_integer * 2) - 1\n    return num == target_value"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\n\n    A Woodall number is of the form n * 2^n - 1 for some non-negative integer n.\n    \"\"\"\n    if number <= 0:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/57", "solution": "class Comparator(str):\n    \"\"\"\n    A helper class for custom string comparison during sorting.\n    It defines a custom less-than operation to order strings for largest concatenation.\n    \"\"\"\n    def __lt__(self, other):\n        # Compares (self + other) with (other + self) to determine the correct order.\n        return self + other > other + self\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed by concatenating a given list of digits.\n    The function converts digits to strings and sorts them using a custom comparison logic.\n    \"\"\"\n    if not digits:\n        return 0\n\n    # Convert all input integers to strings to facilitate concatenation.\n    digits_str = [str(num) for num in digits]\n\n    # Sort these string representations using the custom Comparator class.\n    # The Comparator determines order based on which concatenation (str1 + str2 or str2 + str1) is larger.\n    sorted_digits_str = sorted([Comparator(s) for s in digits_str])\n\n    # Join the sorted string representations to form the largest number string.\n    largest_num_str = \"\".join(sorted_digits_str)\n\n    # Convert the resulting concatenated string back to an integer.\n    # This also correctly handles cases like ['0', '0'] becoming \"00\" which converts to 0.\n    return int(largest_num_str)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digit characters equals the substring's length.\n    Non-digit characters are ignored when summing.\n    \"\"\"\n    total_count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            substring = input_string[i:j]\n            substring_length = len(substring)\n\n            digit_sum = 0\n            for char in substring:\n                if char.isdigit():\n                    digit_sum += int(char)\n\n            if digit_sum == substring_length:\n                total_count += 1\n\n    return total_count"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(int1: int, int2: int) -> bool:\n    \"\"\"Determines if two integers have opposite signs. Returns False if one or both are zero.\"\"\"\n    # Check for zero inputs as per specification.\n    if int1 == 0 or int2 == 0:\n        return False\n\n    # Opposite signs result in a negative product.\n    if (int1 * int2) < 0:\n        return True\n\n    # Otherwise, they have the same sign.\n    return False"}
