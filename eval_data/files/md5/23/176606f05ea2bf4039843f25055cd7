{"task_id": "Mbpp/259", "solution": "def maximize_elements(tuple1: tuple[tuple[int | float, int | float], ...],\n                      tuple2: tuple[tuple[int | float, int | float], ...]) -> tuple[tuple[int | float, int | float], ...]:\n    \"\"\"\n    Calculates the element-wise maximum of two input tuples of tuples.\n    Returns a new tuple of tuples with maximized corresponding elements.\n    \"\"\"\n    result_outer_list = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        max_val0 = max(inner_tuple1[0], inner_tuple2[0])\n        max_val1 = max(inner_tuple1[1], inner_tuple2[1])\n        new_inner_tuple = (max_val0, max_val1)\n        result_outer_list.append(new_inner_tuple)\n    return tuple(result_outer_list)"}
{"task_id": "Mbpp/260", "solution": "def _calculate_Sn(n: int) -> int:\n    # Computes the nth term of the Newman-Shanks-Williams sequence.\n    # S_0 = 1, S_1 = 1, S_k = 2S_{k-1} + S_{k-2} for k > 1.\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n    s_prev2 = 1\n    s_prev1 = 1\n    for _ in range(2, n + 1):\n        s_current = 2 * s_prev1 + s_prev2\n        s_prev2 = s_prev1\n        s_prev1 = s_current\n    return s_prev1\ndef _is_prime(num: int) -> bool:\n    # Checks if a given integer is a prime number.\n    # This function uses a basic trial division method for primality.\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef newman_prime(n: int) -> int:\n    # Calculates the nth Newman-Shanks-Williams prime number.\n    # As per the design, it validates input, computes S_n, and confirms its primality.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    s_n_value = _calculate_Sn(n)\n\n    if _is_prime(s_n_value):\n        return s_n_value\n    else:\n        # As per design, raise ValueError if S_n is not prime\n        raise ValueError(f\"S_{n} = {s_n_value} is not a prime number, therefore it is not an NSW prime.\")"}
{"task_id": "Mbpp/259", "solution": "from typing import Union, Tuple\ndef maximize_elements(\n    tup1: Tuple[Tuple[Union[int, float], Union[int, float]], ...],\n    tup2: Tuple[Tuple[Union[int, float], Union[int, float]], ...]\n) -> Tuple[Tuple[Union[int, float], Union[int, float]], ...]:\n    \"\"\"\n    Performs an element-wise maximum operation on two input tuples of tuples.\n    It returns a new tuple of tuples where each inner tuple's elements are the maximum of corresponding elements from the inputs.\n    \"\"\"\n    result_list = []\n    for sub_tup1, sub_tup2 in zip(tup1, tup2):\n        max_first = max(sub_tup1[0], sub_tup2[0])\n        max_second = max(sub_tup1[1], sub_tup2[1])\n        result_list.append((max_first, max_second))\n    return tuple(result_list)"}
{"task_id": "Mbpp/260", "solution": "def _calculate_Sn(k: int) -> int:\n    \"\"\"Calculates the k-th term of the Newman-Shanks-Williams sequence iteratively.\"\"\"\n    if k == 0:\n        return 1\n    if k == 1:\n        return 1\n    s_prev2 = 1\n    s_prev1 = 1\n    for _ in range(2, k + 1):\n        s_current = 2 * s_prev1 + s_prev2\n        s_prev2 = s_prev1\n        s_prev1 = s_current\n    return s_prev1\ndef newman_prime(n: int) -> int:\n    \"\"\"Returns the nth Newman-Shanks-Williams prime number, where n is the sequence index.\"\"\"\n    # Based on the requirement newman_prime(3) == 7, n is interpreted as the index k for S_k.\n    # The function calculates S_n and assumes it is prime as per problem constraints.\n    nsw_term = _calculate_Sn(n)\n    # The design mentioned checking if S_k / 2 is prime, but the example implies S_n itself.\n    # We return the calculated S_n, assuming it satisfies the primality condition for the given n.\n    return nsw_term"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples, handling division by zero.\n    Trusts input types, lengths, and element types as numeric as per critical requirements.\n    \"\"\"\n    results = []\n    # Iterate over elements, assuming inputs are tuples of equal length with numeric elements.\n    for i in range(len(tuple1)):\n        dividend = tuple1[i]\n        divisor = tuple2[i]\n\n        # Handle division by zero by returning float('inf') as a predefined value.\n        # This specific behavior aligns with the design's requirement for division by zero.\n        if divisor == 0:\n            results.append(float('inf'))\n        else:\n            results.append(dividend / divisor)\n\n    return tuple(results)"}
