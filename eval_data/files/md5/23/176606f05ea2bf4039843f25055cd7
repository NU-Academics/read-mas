{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if a given month number has 31 days.\n    Returns True for months with 31 days, False otherwise.\n    \"\"\"\n    # Business Rule BR2: Months 1 (January), 3 (March), 5 (May), 7 (July),\n    # 8 (August), 10 (October), and 12 (December) have 31 days.\n    months_with_31_days = {1, 3, 5, 7, 8, 10, 12}\n\n    # BR5: Returns True if month_number is in months_with_31_days.\n    # BR6: Returns False otherwise, adhering to the specified business rules.\n    return month_number in months_with_31_days"}
{"task_id": "Mbpp/456", "solution": "def _reverse_single_string(s: str) -> str:\n    \"\"\"Reverses a single input string using slice notation.\n    This creates a new string without modifying the original.\n    \"\"\"\n    return s[::-1]\ndef reverse_string_list(input_list: list[str]) -> list[str]:\n    \"\"\"Reverses each string in the input list and returns a new list.\n    The original input list remains unchanged, adhering to FR3.\n    \"\"\"\n    reversed_list = []\n    for s in input_list:\n        reversed_list.append(_reverse_single_string(s))\n    return reversed_list"}
