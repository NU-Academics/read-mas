{"task_id": "Mbpp/620", "solution": "def largest_subset(nums: list[int]) -> int:\n    \"\"\"Calculates the size of the largest divisible subset from a given list of integers.\"\"\"\n    if not nums:\n        return 0\n\n    nums.sort()\n    n = len(nums)\n    dp = [1] * n\n    max_size = 1\n\n    for i in range(n):\n        for j in range(i):\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], 1 + dp[j])\n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset where every pair of numbers is mutually divisible.\n    This uses a dynamic programming approach after sorting the input list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the numbers to facilitate dynamic programming.\n    numbers.sort()\n    n = len(numbers)\n    # dp[i] stores the size of the largest divisible subset ending with numbers[i].\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            # If numbers[i] is divisible by numbers[j], it can extend the subset ending at numbers[j].\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    # The maximum value in the dp array is the size of the largest divisible subset.\n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list, list2: list, n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size n.\n\n    The median is the average of the elements at indices n-1 and n\n    of the conceptually merged sorted list.\n    \"\"\"\n    i = 0\n    j = 0\n    count = 0\n    median_element1 = -1\n    median_element2 = -1\n\n    while count <= n:\n        if i == n:\n            median_element = list2[j]\n            j += 1\n        elif j == n:\n            median_element = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            median_element = list1[i]\n            i += 1\n        else:\n            median_element = list2[j]\n            j += 1\n\n        if count == n - 1:\n            median_element1 = median_element\n        if count == n:\n            median_element2 = median_element\n            break\n        count += 1\n\n    return float(median_element1 + median_element2) / 2.0"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Finds the maximum value within the specified column of a matrix.\n    Assumes matrix is non-empty and n is a valid column index for all rows.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"Input 'matrix' must be a list.\")\n    if not all(isinstance(row, list) for row in matrix):\n        raise TypeError(\"Input 'matrix' must be a list of lists.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Column index 'n' must be non-negative.\")\n    if not matrix:\n        raise ValueError(\"Input 'matrix' cannot be empty.\")\n\n    max_value = None\n    found_valid_element = False\n\n    for row_index, row in enumerate(matrix):\n        if n >= len(row):\n            # As per design, raise an error if n is out of bounds for any row\n            # The design states IndexError or ValueError. IndexError is more specific here.\n            raise IndexError(f\"Column index {n} is out of bounds for row {row_index} with length {len(row)}.\")\n\n        current_element = row[n]\n\n        # Type checking for numerical elements\n        if not (isinstance(current_element, (int, float))):\n            # This is not explicitly in the error handling section but implied by \"elements are expected to be numerical\"\n            # However, the problem only mentions \"max of the n'th column\", implying numerical.\n            # For strictness, if non-numerical elements are encountered in the target column,\n            # it should be handled. For this problem, we'll assume numerical.\n            pass\n\n        if not found_valid_element:\n            max_value = current_element\n            found_valid_element = True\n        else:\n            if current_element > max_value:\n                max_value = current_element\n\n    # If no valid elements were found (e.g., all rows were too short, and IndexError was not raised\n    # because of an early return, or if matrix was [[]] and n=0).\n    # However, with the current IndexError logic, this specific path might not be easily hit.\n    # The design states \"If no valid elements were processed (e.g., due to all rows being too short),\n    # ensure an appropriate error was raised earlier or a specific default value is returned.\"\n    # With the IndexError check, an error will be raised.\n    if not found_valid_element:\n        # This case should ideally be covered by earlier errors (empty matrix, index out of bounds)\n        # but as a fallback, if a column ends up being \"empty\" for other reasons not caught by existing checks.\n        # Given the strict error handling (IndexError for out of bounds), this specific `ValueError`\n        # for \"no valid elements found\" might be redundant unless a non-strict interpretation\n        # of ragged matrices was taken. Sticking to the strict interpretation where IndexError is raised.\n        pass"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"Calculates the median of two sorted lists of integers of the same size.\n\n    This function assumes valid, pre-sorted inputs as per SRS.\n    \"\"\"\n    # For a combined list of 2*n elements, the median is the average of the\n    # n-th and (n+1)-th elements (1-indexed). These correspond to indices n-1 and n (0-indexed).\n\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    m1 = -1 # Stores the (n-1)-th element found so far\n    m2 = -1 # Stores the n-th element found so far\n\n    # The loop runs n + 1 times to find the elements at 0-indexed positions n-1 and n.\n    for count in range(n + 1):\n        if i == n: # list1 exhausted, take from list2\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        elif j == n: # list2 exhausted, take from list1\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]: # Take from list1 if smaller or equal\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        else: # Take from list2\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n\n    return float(m1 + m2) / 2.0"}
