{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the Shell Sort algorithm.\n    Returns a new list with the sorted elements.\"\"\"\n    n = len(arr)\n    sorted_arr = list(arr)\n\n    # Initialize the gap, using a common sequence (Knuth's, or N/2 decreasing).\n    # Here we use N/2, then N/4, etc.\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for elements separated by 'gap'\n        for i in range(gap, n):\n            # Store the current element to be inserted\n            temp = sorted_arr[i]\n            # Shift earlier 'gap'-sorted elements up until the correct position for 'temp' is found\n            j = i\n            while j >= gap and sorted_arr[j - gap] > temp:\n                sorted_arr[j] = sorted_arr[j - gap]\n                j -= gap\n            # Place 'temp' in its correct location\n            sorted_arr[j] = temp\n        # Reduce the gap for the next pass\n        gap //= 2\n    return sorted_arr"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(tuple1: tuple[int], tuple2: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Performs an element-wise bitwise AND operation on two tuples of integers.\n    Returns a new tuple containing the results of the bitwise AND operations.\n    \"\"\"\n    results = []\n    for i in range(len(tuple1)):\n        element_and = tuple1[i] & tuple2[i]\n        results.append(element_and)\n    return tuple(results)"}
