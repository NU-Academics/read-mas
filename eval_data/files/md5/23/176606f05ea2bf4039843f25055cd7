{"task_id": "Mbpp/771", "solution": "OPENING_DELIMITERS = {\n    '(': ')',\n    '[': ']',\n    '{': '}',\n}\nCLOSING_DELIMITERS = {')', ']', '}'}\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given string expression has balanced parentheses, square brackets, and curly braces.\n    Returns True if balanced, False otherwise.\n    \"\"\"\n    stack = [] # Stack to keep track of opening delimiters.\n\n    for char in expression:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            if not stack:\n                return False\n\n            last_opening = stack.pop()\n            if OPENING_DELIMITERS[last_opening] != char:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n    It iterates to find each odd number, raises it to the fourth power, and accumulates the sum.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number.\n\n    The sequence starts 0, 1, 1, 3, 5, 11, 21, 43, 85, 171, 341, 683, 1365, 2731, ...\n\n    Args:\n        n: The non-negative integer index of the desired Jacobsthal number.\n\n    Returns:\n        The nth Jacobsthal number.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # J(n) = J(n-1) + 2 * J(n-2)\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Filters a string, removing words of a specific length.\n    Preserves the original order of remaining words.\n    \"\"\"\n    words = input_string.split(' ')\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr: tuple, n: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two distinct elements in a tuple.\n    First sorts the tuple, then iterates through adjacent pairs.\n    \"\"\"\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(1, n):\n        current_diff = abs(sorted_arr[i] - sorted_arr[i-1])\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return int(min_diff)"}
