{"task_id": "Mbpp/286", "solution": "def _kadane(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum contiguous subarray sum in a single array.\n    Handles arrays with all negative numbers by returning the largest negative number.\n    \"\"\"\n    if not arr:\n        return 0 # Or handle as an error/specific case, depending on requirements\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\ndef max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Calculates the maximum contiguous subarray sum in an array repeated k times.\n    It optimizes for k > 1 to avoid explicit large array construction.\n    The parameter 'n' is the length of the array 'arr', and can be derived\n    from len(arr). It is kept for signature compliance with the problem statement.\n    \"\"\"\n    if not arr:\n        return 0 # Empty array case\n\n    # The original design document suggested using _kadane for arr + arr for total_sum_arr <= 0\n    # and a more complex formula for total_sum_arr > 0.\n\n    # First, handle the k=1 case\n    if k == 1:\n        return _kadane(arr)\n\n    # General approach for k > 1\n    # Max sum could be entirely within one repetition of the array\n    max_in_single_arr = _kadane(arr)\n\n    # Max sum could span across the boundary of two arrays\n    # This is equivalent to finding the max subarray sum in arr + arr\n    max_in_two_arr = _kadane(arr + arr)\n\n    # Calculate total sum of the array\n    total_arr_sum = sum(arr)\n\n    # If the total sum of the array is positive, then repeating it multiple times\n    # might increase the max sum.\n    # The potential maximum sum can be formed by:\n    # 1. The maximum sum within a single array (covered by max_in_single_arr).\n    # 2. The maximum sum spanning across two arrays (covered by max_in_two_arr).\n    # 3. If total_arr_sum > 0, and k > 2, the largest sum could involve\n    #    a suffix sum of the first array, (k-2) full array sums, and a prefix sum of the last array.\n    if total_arr_sum > 0:\n        # Calculate max prefix sum of the input array\n        max_prefix_sum = 0\n        current_prefix_sum = 0\n        for x in arr:\n            current_prefix_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n        # Calculate max suffix sum of the input array\n        max_suffix_sum = 0\n        current_suffix_sum = 0\n        for x in reversed(arr):\n            current_suffix_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n        # The maximum sum would be the max of:\n        # - Max sum within a single array\n        # - Max sum spanning two arrays\n        # - Max suffix sum + (k-2)*total_arr_sum + Max prefix sum (for k >= 2)\n        # Note: if k=2, (k-2)*total_arr_sum is 0, so this reduces to max_suffix_sum + max_prefix_sum,\n        # which is covered by _kadane(arr+arr) or specific suffix/prefix sums from the single array.\n        # However, to be robust for the case where the optimal subarray spans all k repetitions\n        # and benefits from positive total_arr_sum, this term is important.\n        # But for k=2, max_in_two_arr already handles the best possible combination of prefix+suffix across a single join.\n        # For k > 2, the total_arr_sum acts as an amplifier.\n        return max(max_in_single_arr, max_in_two_arr, max_suffix_sum + (k - 2) * total_arr_sum + max_prefix_sum)\n    else:\n        # If the total sum of the array is not positive, repeating it won't yield a larger sum\n        # beyond what's found in one or two repetitions.\n        # So the maximum sum will be either within one array or spanning at most two arrays.\n        return max(max_in_single_arr, max_in_two_arr)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    It iterates from 1 to n, computes each even number's square, and adds it to a running total.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        squared_value = even_num * even_num\n        total_sum += squared_value\n    return total_sum"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    The input n is expected to be a positive integer.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 2\n    return total_sum"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in an array repeated k times.\n    This uses Kadane's algorithm and handles cases for k=1 and k>1.\n    \"\"\"\n\n    def _kadane(current_arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum subarray sum within a single array.\"\"\"\n        if not current_arr:\n            return 0\n        max_so_far = current_arr[0]\n        current_max = current_arr[0]\n        for x in current_arr[1:]:\n            current_max = max(x, current_max + x)\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # If the array is empty, the max subarray sum is 0.\n    if n == 0:\n        return 0\n\n    # Case 1: k = 1\n    # Simply apply Kadane's algorithm to the original array.\n    if k == 1:\n        return _kadane(arr)\n\n    # Case 2: k > 1\n    # Calculate components required for repeated array logic.\n    max_single_arr_sum = _kadane(arr)\n    total_arr_sum = sum(arr)\n\n    # Calculate max prefix sum.\n    current_prefix_sum = 0\n    max_prefix_sum = float('-inf')\n    for x in arr:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n    # Calculate max suffix sum.\n    current_suffix_sum = 0\n    max_suffix_sum = float('-inf')\n    for x in reversed(arr):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    # Initialize overall answer with the max sum found within a single array.\n    ans = max_single_arr_sum\n\n    # Consider sums that span across two adjacent array repetitions (e.g., suffix of first + prefix of second).\n    ans = max(ans, max_prefix_sum + max_suffix_sum)\n\n    # If the total sum of the array is positive, it can contribute to a larger sum by including\n    # middle repetitions. This applies for k > 2, hence (k - 2) * total_arr_sum.\n    if total_arr_sum > 0:\n        ans = max(ans, max_prefix_sum + total_arr_sum * (k - 2) + max_suffix_sum)\n\n    return ans"}
{"task_id": "Mbpp/290", "solution": "def max_length(input_lists: list[list]) -> tuple[int, list]:\n    \"\"\"\n    Identifies the list with the maximum length from a given list of lists.\n    Returns a tuple containing the maximum length and the corresponding list.\n    \"\"\"\n    max_length_val = 0\n    max_list_val = []\n\n    for inner_list in input_lists:\n        current_length = len(inner_list)\n        if current_length > max_length_val:\n            max_length_val = current_length\n            max_list_val = inner_list\n\n    return (max_length_val, max_list_val)"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(side1: float, side2: float) -> float:\n    \"\"\"Calculates the hypotenuse of a right-angled triangle.\n    Uses the Pythagorean theorem (a^2 + b^2 = c^2).\n    \"\"\"\n    hypotenuse_squared = side1**2 + side2**2\n    hypotenuse = math.sqrt(hypotenuse_squared)\n    return hypotenuse"}
{"task_id": "Mbpp/294", "solution": "from typing import List, Any, Union\ndef max_val(input_list: List[Any]) -> Union[int, float, None]:\n    \"\"\"\n    Identifies and returns the maximum numeric value (int or float) from a heterogeneous list.\n    Non-numeric elements encountered in the list are automatically ignored.\n    \"\"\"\n    current_max = None\n\n    for item in input_list:\n        if isinstance(item, (int, float)):\n            if current_max is None or item > current_max:\n                current_max = item\n    return current_max"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list[int|float]) -> int:\n    \"\"\"\n    Calculates the total number of inversions in a given array.\n    An inversion is a pair (arr[i], arr[j]) such that arr[i] > arr[j] and i < j.\n    \"\"\"\n    inversion_count = 0\n    n = len(arr)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/294", "solution": "def max_val(input_list):\n    \"\"\"\n    Finds the maximum numerical value within a heterogeneous list.\n    Only considers int and float types, ignoring others.\n    \"\"\"\n    max_value = None\n\n    for element in input_list:\n        # Check if the element is a numerical type (int or float).\n        if isinstance(element, (int, float)):\n            # Update max_value if it's currently None or the element is greater.\n            if max_value is None or element > max_value:\n                max_value = element\n    return max_value"}
{"task_id": "Mbpp/296", "solution": "def _merge_and_count_inversions(arr, temp_arr, left, mid, right):\n    \"\"\"Merges two sorted subarrays and counts inversions where elements from the right subarray precede left subarray elements.\n    It places sorted elements into temp_arr, then copies them back to arr.\n    \"\"\"\n    i = left  # Starting index for left subarray\n    j = mid + 1  # Starting index for right subarray\n    k = left  # Starting index for merged array in temp_arr\n    inv_count = 0\n\n    while i <= mid and j <= right:\n        if arr[i] <= arr[j]:\n            temp_arr[k] = arr[i]\n            i += 1\n        else:\n            temp_arr[k] = arr[j]\n            j += 1\n            inv_count += (mid - i + 1)\n        k += 1\n\n    while i <= mid:\n        temp_arr[k] = arr[i]\n        i += 1\n        k += 1\n\n    while j <= right:\n        temp_arr[k] = arr[j]\n        j += 1\n        k += 1\n\n    for idx in range(left, right + 1):\n        arr[idx] = temp_arr[idx]\n\n    return inv_count\ndef _merge_sort_and_count(arr, temp_arr, left, right):\n    \"\"\"Recursively divides the array, sorts halves, and accumulates inversions from merge operations.\n    This function implements the \"divide\" and \"conquer\" steps of merge sort.\n    \"\"\"\n    inv_count = 0\n    if left < right:\n        mid = (left + right) // 2\n        inv_count += _merge_sort_and_count(arr, temp_arr, left, mid)\n        inv_count += _merge_sort_and_count(arr, temp_arr, mid + 1, right)\n        inv_count += _merge_and_count_inversions(arr, temp_arr, left, mid, right)\n    return inv_count\ndef get_Inv_Count(arr: list) -> int:\n    \"\"\"Counts the total number of inversions in the input array using a merge sort-based algorithm.\n    An inversion is a pair of indices (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    temp_arr = [0] * n\n    return _merge_sort_and_count(arr, temp_arr, 0, n - 1)"}
{"task_id": "Mbpp/292", "solution": "def find(a, b):\n    \"\"\"\n    Finds the quotient of two numbers, rounded down to the nearest integer.\n\n    Args:\n        a: The numerator.\n        b: The denominator.\n\n    Returns:\n        The quotient rounded down to the nearest integer.\n\n    Raises:\n        ZeroDivisionError: If the denominator is zero.\n    \"\"\"\n    if b == 0:\n        raise ZeroDivisionError(\"Cannot divide by zero.\")\n    return a // b"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(side1, side2):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given its two legs.\n    This function assumes the input sides are the legs of the triangle.\n    \"\"\"\n    hypotenuse_squared = side1**2 + side2**2\n    return math.sqrt(hypotenuse_squared)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    It collects all primitive elements in depth-first order.\n    \"\"\"\n    result = []\n    for element in nested_list:\n        if isinstance(element, list):\n            result.extend(flatten_list(element))\n        else:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"Flattens a nested list of integers into a single list.\n    Preserves the order of elements from the original nested structure.\n    \"\"\"\n    flat_list = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flat_list.extend(flatten_list(item))\n        else:\n            flat_list.append(item)\n    return flat_list"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\ndef max_aggregate(input_list: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"Aggregates scores by name and returns the name with the highest total score.\n    Returns ('', 0) if the input list is empty.\n    \"\"\"\n    aggregated_scores = defaultdict(int)\n\n    for name, score in input_list:\n        aggregated_scores[name] += score\n\n    # Find the name with the maximum total score.\n    # The 'default' argument handles the case where aggregated_scores is empty.\n    highest_name, highest_score = max(aggregated_scores.items(), key=lambda item: item[1], default=('', 0))\n\n    return highest_name, highest_score"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words):\n    \"\"\"\n    Finds and returns the first two words starting with 'p' (case-insensitive) from a list of strings.\n    Each string in the input list may contain multiple space-separated words.\n    \"\"\"\n    found_p_words = []\n    for s in words:\n        for word in s.split():\n            if word.lower().startswith('p'):\n                found_p_words.append(word)\n                if len(found_p_words) == 2:\n                    return tuple(found_p_words)\n    return tuple(found_p_words) # In case fewer than two are found, as per problem context."}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the sum of scores for each unique name and identifies the name with the highest total score.\n    Returns the name and its aggregate score, or (\"\", 0) if the input list is empty.\n    \"\"\"\n    aggregates: dict[str, int] = {}\n    for name, score in data:\n        aggregates[name] = aggregates.get(name, 0) + score\n\n    if not aggregates:\n        return (\"\", 0)\n\n    max_name, max_score = max(aggregates.items(), key=lambda item: item[1])\n    return (max_name, max_score)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a given dictionary.\n    The outermost dictionary is depth 1, with depth increasing by 1 for each level of nested dictionaries.\"\"\"\n    max_depth = 1\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n such that the sum\n    of the first n bits is the same as the sum of the last n bits.\n    This is equivalent to C(2n, n).\n    Precondition: n must be a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    # The formula is sum_{k=0 to n} (C(n, k))^2, which simplifies to C(2n, n).\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This uses the combinatorial identity for the sum of squares of binomial coefficients C(n, k).\"\"\"\n    total_count = 0\n    for k in range(n + 1):\n        combinations_nk = math.comb(n, k)\n        total_count += combinations_nk * combinations_nk\n    return total_count"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words_list: list) -> tuple:\n    \"\"\"\n    Finds the first two words (case-insensitive) that start with 'p'\n    from all words in the input list.\n\n    Args:\n        words_list: A list of strings to search through.\n\n    Returns:\n        A tuple containing the first two 'p'-starting words found.\n        If fewer than two are found, None is used for missing words.\n    \"\"\"\n    p_words = []\n    for item_string in words_list:\n        # Split each string into individual words and iterate.\n        for word in item_string.split():\n            if word and word[0].lower() == 'p':\n                p_words.append(word)\n            if len(p_words) == 2:\n                break\n        if len(p_words) == 2:\n            break\n\n    first_word = p_words[0] if len(p_words) > 0 else None\n    second_word = p_words[1] if len(p_words) > 1 else None\n\n    return (first_word, second_word)"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, k):\n    \"\"\"\n    Identifies and returns the k largest products formed by multiplying elements from two input lists.\n    The function iterates all possible pairs, calculates their products, and returns the top k in descending order.\n    \"\"\"\n    all_products = []\n\n    for x in list1:\n        for y in list2:\n            all_products.append(x * y)\n\n    all_products.sort(reverse=True)\n\n    return all_products[:k]"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i] that includes arr[k], where k > i.\n    Returns the maximum sum, or arr[k] if no suitable prefix elements are found.\n    \"\"\"\n    # Initialize dp array for maximum increasing subsequence sum ending at each index up to i.\n    dp = [0] * (i + 1)\n\n    # Calculate max sum increasing subsequence for the prefix arr[0...i].\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx] # Subsequence ending at current_idx is at least arr[current_idx].\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Find the maximum sum from dp array that can precede arr[k] and is less than arr[k].\n    max_prefix_sum = 0\n    for idx_in_prefix in range(i + 1):\n        if arr[idx_in_prefix] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[idx_in_prefix])\n\n    # The final result is the max_prefix_sum plus arr[k].\n    # If no prefix element is smaller than arr[k], max_prefix_sum remains 0.\n    return max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/309", "solution": "def maximum(num1, num2):\n    \"\"\"\n    Compares two numbers and returns the larger of the two.\n    This function adheres to the design specification for finding the maximum.\n    \"\"\"\n    if num1 >= num2:\n        return num1\n    else:\n        return num2"}
{"task_id": "Mbpp/306", "solution": "import math\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i], always including arr[k] (k > i).\n    Returns 0 if inputs are invalid or no valid prefix subsequence can be formed.\n    \"\"\"\n    # Validate inputs as per design, returning 0 for invalid conditions or k <= i.\n    if not arr or n <= 0 or not (0 <= i < n) or not (0 <= k < n) or not (k > i):\n        return 0\n\n    # dp_sums stores max increasing subsequence sums ending at each index j <= i.\n    dp_sums = [0] * (i + 1)\n\n    # Compute max sum increasing subsequence for elements within arr[0...i].\n    for current_idx in range(i + 1):\n        dp_sums[current_idx] = arr[current_idx]\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp_sums[current_idx] = max(dp_sums[current_idx], arr[current_idx] + dp_sums[prev_idx])\n\n    # Find the max sum from dp_sums for elements less than arr[k] to form the prefix.\n    max_prefix_sum = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp_sums[j])\n\n    # Return the combined sum of the chosen prefix and arr[k].\n    return max_prefix_sum + arr[k]"}
