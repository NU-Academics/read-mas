{"task_id": "Mbpp/166", "solution": "def find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR operation results in an even number.\n    This relies on the rule that x XOR y is even if and only if x and y have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for number in integer_list:\n        if number % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate combinations of 2 from even_count and odd_count\n    # C(n, 2) = n * (n - 1) // 2\n    pairs_from_evens = (even_count * (even_count - 1)) // 2\n    pairs_from_odds = (odd_count * (odd_count - 1)) // 2\n\n    return pairs_from_evens + pairs_from_odds"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    Handles the edge case where n is 0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/166", "solution": "def _calculate_combinations(n: int) -> int:\n    \"\"\"Calculates the number of unique pairs from 'n' items using the combinations formula.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\ndef find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in integer_list:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    even_pairs_count = _calculate_combinations(even_count)\n    odd_pairs_count = _calculate_combinations(odd_count)\n\n    return even_pairs_count + odd_pairs_count"}
