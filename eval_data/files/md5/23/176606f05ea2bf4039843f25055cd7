{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"Performs a left bitwise rotation on a 32-bit integer.\n    Bits shifted off the left end wrap around to the right end.\"\"\"\n    # Normalize the rotation amount to be within the 0-31 range.\n    effective_d = d % 32\n\n    # Perform the left shift and combine with the bits that wrapped around from the right shift.\n    rotated_value = (number << effective_d) | (number >> (32 - effective_d))\n\n    # Apply a 32-bit mask to ensure the result strictly remains within 32 bits.\n    return rotated_value & ((1 << 32) - 1)"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(inputNumber):\n    \"\"\"\n    Checks if the given numerical input is a perfect square.\n    Returns True if it is, False otherwise.\n    \"\"\"\n    if inputNumber < 0:\n        return False\n\n    # Calculate the square root of the number.\n    sqrt_val = math.sqrt(inputNumber)\n\n    # A number is a perfect square if its square root is an integer.\n    return sqrt_val == int(sqrt_val)"}
{"task_id": "Mbpp/799", "solution": "BIT_LENGTH = 32\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bitwise rotation on 'number' by 'd' bits,\n    assuming the number is 32-bit.\n    \"\"\"\n    d_normalized = d % BIT_LENGTH\n    unsigned_number = number & (2**BIT_LENGTH - 1)\n\n    shifted_left = unsigned_number << d_normalized\n    shifted_right = unsigned_number >> (BIT_LENGTH - d_normalized)\n\n    result = (shifted_left | shifted_right) & (2**BIT_LENGTH - 1)\n\n    return result"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(int1, int2, int3):\n    \"\"\"Counts the number of equal integers among the three inputs.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    if int1 == int2 and int2 == int3:\n        return 3\n    elif int1 == int2 or int1 == int3 or int2 == int3:\n        return 2\n    else:\n        return 0"}
