{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(input_number):\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than the given number.\n    It handles both positive and negative numerical inputs gracefully.\n    \"\"\"\n    # Ensure the number for square root calculation is non-negative, as perfect squares are non-negative.\n    # This also helps handle negative inputs by treating them as 0 for initial root finding.\n    non_negative_input = max(0, input_number)\n\n    # Calculate the square root of the (potentially adjusted) input.\n    sqrt_val = math.sqrt(non_negative_input)\n\n    # Determine the next integer root. Adding 1 ensures we get a perfect square strictly greater than the input.\n    # For example, if input is 36 (sqrt 6), next_integer_root becomes 7 (for 49).\n    next_integer_root = math.floor(sqrt_val) + 1\n\n    # Square this next integer root to find the result.\n    result = next_integer_root * next_integer_root\n    return result"}
{"task_id": "Mbpp/232", "solution": "import heapq\ndef larg_nnum(input_list: list, n: int) -> list:\n    \"\"\"\n    Identifies and returns the `n` largest items from a given input list.\n    Uses a min-heap for efficient retrieval of the largest elements.\n    \"\"\"\n    # Handle edge cases: empty list or n <= 0.\n    if not input_list or n <= 0:\n        return []\n\n    # Handle edge case: n is larger than or equal to the list's length.\n    if n >= len(input_list):\n        return sorted(input_list, reverse=True)\n\n    # Normal case: use a min-heap of size n to find the n largest elements.\n    min_heap = []\n    for item in input_list:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, item)\n        elif item > min_heap[0]:\n            heapq.heapreplace(min_heap, item)\n\n    # The heap now contains the n largest elements. Sort them in descending order before returning.\n    return sorted(min_heap, reverse=True)"}
{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence for a given string.\n    This function uses dynamic programming to efficiently compute the LPS length.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the LPS for substring input_string[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the dp table for gaps of length 1 to n-1\n    for gap in range(1, n):\n        for i in range(n - gap):\n            j = i + gap\n            if input_string[i] == input_string[j]:\n                # If characters match, extend the palindrome from the inner substring\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if gap > 1 else 0)\n            else:\n                # If characters don't match, take the maximum of excluding either character\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "def _longest_increasing_subsequence_sums(arr: list[int]) -> list[int]:\n    \"\"\"Calculates the maximum sum of an increasing subsequence ending at each position.\n    Uses dynamic programming with O(N^2) time complexity.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lis_sums = list(arr)\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\ndef _longest_decreasing_subsequence_sums_reversed(arr: list[int]) -> list[int]:\n    \"\"\"Calculates the maximum sum of a decreasing subsequence starting at each position.\n    This is achieved by reversing the array, computing LIS sums, and reversing the result.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    reversed_arr = arr[::-1]\n    lis_sums_on_reversed = _longest_increasing_subsequence_sums(reversed_arr)\n    return lis_sums_on_reversed[::-1]\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _longest_increasing_subsequence_sums(arr)\n    lds_sums = _longest_decreasing_subsequence_sums_reversed(arr)\n\n    max_bitonic_sum = float('-inf')\n\n    # For each element arr[i], consider it as the peak of a bitonic subsequence.\n    # The sum is LIS ending at arr[i] + LDS starting at arr[i] - arr[i] (as arr[i] is counted twice).\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, lis_sums[i] + lds_sums[i] - arr[i])\n\n    return max_bitonic_sum"}
