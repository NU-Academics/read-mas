{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in the input list,\n    preserving their original order of first appearance.\n    It counts element frequencies and then filters the original list.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists_of_strings: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings within a given list of lists.\n    Returns a new list of lists with each sublist's strings sorted in ascending lexicographical order.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in list_of_lists_of_strings:\n        # Use sorted() to create a new sorted list from the current sublist\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    \"\"\"\n    Returns a new list containing only the numbers that appear exactly once\n    in the input list.\n    \"\"\"\n    counts = {}\n    for num in input_list:\n        counts[num] = counts.get(num, 0) + 1\n\n    unique_elements = []\n    for num, count in counts.items():\n        if count == 1:\n            unique_elements.append(num)\n\n    return unique_elements"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list) -> int:\n    \"\"\"Calculates the product of unique numbers in a list.\n    Returns 1 if there are no unique numbers.\n    \"\"\"\n    unique_numbers = set(numbers)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
