{"task_id": "Mbpp/780", "solution": "def find_combinations(input_list: list[tuple]) -> list[tuple]:\n    \"\"\"Calculates the element-wise sum of all unique pairs of distinct tuples from the input list.\n    It returns an empty list if there are fewer than two tuples in the input.\n    \"\"\"\n    results_list = []\n    n = len(input_list)\n\n    if n < 2:\n        return results_list\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            t1 = input_list[i]\n            t2 = input_list[j]\n            sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n            results_list.append(sum_tuple)\n\n    return results_list"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"Groups consecutive identical list elements into sublists.\"\"\"\n    result_list = []\n    current_group = []\n\n    for element in input_list:\n        if not current_group or element == current_group[-1]:\n            current_group.append(element)\n        else:\n            result_list.append(current_group)\n            current_group = [element]\n\n    if current_group:  # Append any remaining group after the loop\n        result_list.append(current_group)\n\n    return result_list"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n    Iterates n times, finding each odd number and adding its fourth power to a running sum.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd length subarrays of the input array.\n\n    It efficiently determines how many times each element contributes to the total sum.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        # Calculate the number of subarrays starting from the left up to index i (inclusive).\n        num_elements_left = i + 1\n        # Calculate the number of subarrays ending from index i (inclusive) up to the right.\n        num_elements_right = n - i\n\n        # The number of odd-length subarrays containing arr[i] is ceil((left_choices * right_choices) / 2).\n        occurrences = (num_elements_left * num_elements_right + 1) // 2\n\n        total_sum += arr[i] * occurrences\n\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"Calculates if the count of positive divisors for a given number is even.\n    It returns True if the divisor count is even, False otherwise.\"\"\"\n\n    divisor_count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n\n    return (divisor_count % 2 == 0)"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Calculates the element-wise sum of two distinct tuples from the input list.\n    Returns a list of tuples, where each inner tuple is the element-wise sum of two distinct input tuples.\n    \"\"\"\n    combinations_list: list[tuple[int, int]] = []\n\n    for i in range(len(tuple_list)):\n        for j in range(i + 1, len(tuple_list)):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n\n            sum_first = tuple1[0] + tuple2[0]\n            sum_second = tuple1[1] + tuple2[1]\n\n            new_combination_tuple = (sum_first, sum_second)\n            combinations_list.append(new_combination_tuple)\n\n    return combinations_list"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"\n    Calculates the number of positive divisors for an integer and checks if the count is even.\n    Returns True if the count is even, False otherwise.\n    \"\"\"\n    abs_number = abs(number)\n\n    if abs_number == 0:\n        # For 0, which has infinite divisors, return False as it's not a finite even count.\n        return False\n\n    if abs_number == 1:\n        # For 1, which has one divisor (odd count), return False.\n        return False\n\n    divisor_count = 0\n    i = 1\n    while i * i <= abs_number:\n        if abs_number % i == 0:\n            if i * i == abs_number:\n                divisor_count += 1  # Perfect square, count once.\n            else:\n                divisor_count += 2  # Count i and abs_number/i.\n        i += 1\n\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/771", "solution": "from enum import Enum\nclass BracketType(Enum):\n    \"\"\"Enumeration for different types of brackets.\"\"\"\n    PARENTHESIS = 1\n    SQUARE_BRACKET = 2\n    CURLY_BRACE = 3\n_BRACKET_PAIRS = {\n    '(': ')',\n    '[': ']',\n    '{': '}'\n}\n_CLOSING_BRACKETS = set(_BRACKET_PAIRS.values())\ndef _get_bracket_info(char: str) -> tuple[bool, bool, BracketType | None]:\n    \"\"\"\n    Determines if a character is a bracket, if it's opening, and its type.\n    Returns (is_bracket, is_opening, bracket_type).\n    \"\"\"\n    if char in _BRACKET_PAIRS:\n        # It's an opening bracket\n        if char == '(':\n            return True, True, BracketType.PARENTHESIS\n        elif char == '[':\n            return True, True, BracketType.SQUARE_BRACKET\n        elif char == '{':\n            return True, True, BracketType.CURLY_BRACE\n    elif char in _CLOSING_BRACKETS:\n        # It's a closing bracket\n        if char == ')':\n            return True, False, BracketType.PARENTHESIS\n        elif char == ']':\n            return True, False, BracketType.SQUARE_BRACKET\n        elif char == '}':\n            return True, False, BracketType.CURLY_BRACE\n    return False, False, None # Not a bracket\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced opening and closing brackets.\n    Returns True if the expression is balanced, False otherwise.\n    \"\"\"\n    stack = []\n    for char in expression_string:\n        is_bracket, is_opening, bracket_type = _get_bracket_info(char)\n\n        if not is_bracket:\n            continue # Ignore non-bracket characters\n\n        if is_opening:\n            stack.append(char)\n        else: # It's a closing bracket\n            if not stack:\n                return False # Closing bracket with no corresponding opening bracket\n\n            last_opening_bracket = stack.pop()\n            if _BRACKET_PAIRS[last_opening_bracket] != char:\n                return False # Mismatched closing bracket\n\n    return not stack # Expression is balanced if the stack is empty at the end"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple of numbers into a tuple of integers.\n    This function processes the string by removing parentheses, splitting by commas, and converting each part to an integer.\n    \"\"\"\n    cleaned_string = input_string.strip('()')\n    if not cleaned_string: # Handle empty tuple case like \"()\"\n        return ()\n\n    # Split by comma, strip whitespace from each element, and convert to integer\n    return tuple(int(s.strip()) for s in cleaned_string.split(','))"}
