{"task_id": "Mbpp/119", "solution": "def search(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    This uses a binary search approach to efficiently locate the unique element.\n    \"\"\"\n    low, high = 0, len(input_list) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Adjust mid to be an even index if it's odd and comparing with next element\n        # This ensures we consistently check pairs starting at an even index.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Compare element at 'mid' (which is now guaranteed to be even) with the next element\n        if input_list[mid] == input_list[mid + 1]:\n            # If they are a pair, the unique element must be in the right half\n            # Move 'low' past this pair\n            low = mid + 2\n        else:\n            # If they are not a pair, the unique element is either at 'mid' or in the left half\n            # Shrink 'high' to 'mid'\n            high = mid\n\n    # When the loop terminates, low == high, and this index points to the unique element.\n    return input_list[low]"}
{"task_id": "Mbpp/105", "solution": "def count(boolean_list: list[bool]) -> int:\n    \"\"\"Counts the occurrences of True boolean values in the given list.\n    This function iterates through the list and increments a counter for each True value.\"\"\"\n    true_count = 0\n    for item in boolean_list:\n        if item is True:\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list) -> int:\n    \"\"\"\n    Finds the single unique element in a sorted array where all other elements appear twice.\n    Assumes the input array is sorted and all elements except one appear exactly twice.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n\n        # Ensure mid is at an even index for easier comparison.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If pair is complete, unique element is in the right half.\n        if arr[mid] == arr[mid + 1]:\n            left = mid + 2\n        # Otherwise, unique element is in the left half (including mid).\n        else:\n            right = mid\n\n    return arr[left]"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer, handling optional signs and no whitespace.\n    Returns True for valid integers, False otherwise.\n    \"\"\"\n    # 1. Empty String Check: An empty string is not a valid integer.\n    if not input_string:\n        return False\n\n    # 2. Whitespace Check: Strings with leading or trailing whitespace are invalid.\n    if input_string != input_string.strip():\n        return False\n\n    # Determine the part of the string that should contain only digits.\n    # This handles both unsigned and signed numbers by adjusting the starting point.\n    content_to_check = input_string\n    if input_string.startswith('+') or input_string.startswith('-'):\n        content_to_check = input_string[1:]\n        # If a sign is present, but no digits follow (e.g., \"+\", \"-\"), it's invalid.\n        if not content_to_check:\n            return False\n\n    # 3. Digit-only Check: The determined content must consist solely of digits.\n    return content_to_check.isdigit()"}
{"task_id": "Mbpp/123", "solution": "def _sum_proper_divisors(n, memo):\n    \"\"\"Calculates the sum of proper divisors of n, using a memoization cache.\"\"\"\n    if n in memo:\n        return memo[n]\n\n    if n <= 1:\n        memo[n] = 0\n        return 0\n\n    div_sum = 1\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            div_sum += i\n            if i * i != n:\n                div_sum += n // i\n        i += 1\n\n    memo[n] = div_sum\n    return div_sum\ndef amicable_numbers_sum(limit):\n    \"\"\"Calculates the sum of all amicable numbers up to the specified limit.\"\"\"\n    total_sum = 0\n    memo = {}\n\n    for n in range(1, limit + 1):\n        sum_div_n = _sum_proper_divisors(n, memo)\n\n        if sum_div_n > n and sum_div_n <= limit:\n            sum_div_m = _sum_proper_divisors(sum_div_n, memo)\n\n            if sum_div_m == n:\n                total_sum += n\n\n    return total_sum"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(data):\n    \"\"\"\n    Finds the maximum absolute product from pairs of numbers within a list of tuples.\n    Assumes valid input structure as per critical requirements.\n    \"\"\"\n    max_abs_product = 0.0\n\n    for tpl in data:\n        num1, num2 = tpl\n        product = num1 * num2\n        abs_product = abs(product)\n\n        if abs_product > max_abs_product:\n            max_abs_product = abs_product\n\n    return max_abs_product"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the number of 0s and 1s in any substring.\n    This uses Kadane's algorithm, treating '0' as +1 and '1' as -1.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    transformed_array = []\n    for char in binary_string:\n        # Assuming input contains only '0's and '1's based on requirements.\n        if char == '0':\n            transformed_array.append(1)\n        else:  # char == '1'\n            transformed_array.append(-1)\n\n    max_so_far = transformed_array[0]\n    current_max = transformed_array[0]\n\n    for i in range(1, len(transformed_array)):\n        current_max = max(transformed_array[i], current_max + transformed_array[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/124", "solution": "import cmath\nfrom typing import Union\ndef angle_complex(real_part: Union[int, float], imag_part: complex) -> float:\n    \"\"\"Calculates the angle (phase) of a complex number.\n    It combines the real and imaginary parts and uses cmath.phase.\"\"\"\n    combined_complex_number = real_part + imag_part\n    angle_in_radians = cmath.phase(combined_complex_number)\n    return angle_in_radians"}
{"task_id": "Mbpp/123", "solution": "def _get_proper_divisors_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of proper divisors for a given number n.\n    Proper divisors are all positive divisors of n excluding n itself.\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    s = 0\n    for i in range(1, n // 2 + 1):\n        if n % i == 0:\n            s += i\n    return s\ndef _is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two numbers a and b form an amicable pair.\n    This function verifies if the sum of proper divisors of b equals a,\n    given that a and b are distinct.\n    \"\"\"\n    if a == b: # Amicable pairs must be distinct numbers.\n        return False\n    # In the main logic, sum_proper_divisors(a) == b is already established.\n    # We now verify if sum_proper_divisors(b) == a.\n    return _get_proper_divisors_sum(b) == a\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all unique amicable numbers up to the specified limit.\n    Amicable numbers are part of an amicable pair (a, b) where a != b,\n    sum of proper divisors of a is b, and sum of proper divisors of b is a.\n    \"\"\"\n    unique_amicable_numbers_set = set()\n\n    for number in range(1, limit + 1):\n        # Calculate sum_a, the sum of proper divisors of number.\n        sum_a = _get_proper_divisors_sum(number)\n\n        # Check if sum_a is greater than number and also within the limit.\n        # This filters out perfect numbers (sum_a == number) and ensures 'b' is in range.\n        if sum_a > number and sum_a <= limit:\n            # Calculate sum_b, the sum of proper divisors of sum_a.\n            sum_b = _get_proper_divisors_sum(sum_a)\n\n            # Determine if number and sum_a form an amicable pair (i.e., if sum_b equals number).\n            if _is_amicable_pair(number, sum_a):\n                # If they form an amicable pair, add both to the set.\n                unique_amicable_numbers_set.add(number)\n                unique_amicable_numbers_set.add(sum_a)\n\n    # Calculate and return the total sum of all unique amicable numbers found.\n    total_sum = sum(unique_amicable_numbers_set)\n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "def find_length(binaryString: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between '0's and '1's in any substring.\n    It transforms '0' to 1 and '1' to -1, then applies Kadane's algorithm.\n    \"\"\"\n    transformed_values = []\n    for char in binaryString:\n        if char == '0':\n            transformed_values.append(1)\n        else:  # char == '1'\n            transformed_values.append(-1)\n\n    max_so_far = 0\n    current_max = 0\n\n    for value in transformed_values:\n        current_max += value\n        if current_max < 0:\n            current_max = 0\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    return max_so_far"}
{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(real, imag):\n  \"\"\"\n  Calculates the angle (argument) of a complex number.\n\n  Args:\n    real: The real component of the complex number.\n    imag: A complex number whose imaginary part is used as the imaginary component.\n\n  Returns:\n    The angle of the complex number in radians, in the range (-pi, pi].\n  \"\"\"\n  return math.atan2(imag.imag, real)"}
{"task_id": "Mbpp/126", "solution": "def sum(a, b):\n    \"\"\"Calculate the sum of common divisors for two numbers.\n    It iterates up to the minimum of the two numbers to find common divisors.\"\"\"\n    common_divisor_sum = 0\n    min_num = min(a, b)\n    for i in range(1, min_num + 1):\n        if a % i == 0 and b % i == 0:\n            common_divisor_sum += i\n    return common_divisor_sum"}
{"task_id": "Mbpp/126", "solution": "def _get_divisors(number: int) -> set[int]:\n    \"\"\"Identifies all positive divisors for a given number.\n    It iterates from 1 up to the number to find all divisors.\n    \"\"\"\n    divs = set()\n    for i in range(1, number + 1):\n        if number % i == 0:\n            divs.add(i)\n    return divs\ndef _find_common_divisors(divisors1: set[int], divisors2: set[int]) -> set[int]:\n    \"\"\"Finds the intersection of two sets of divisors.\n    It uses set intersection for efficient common element identification.\n    \"\"\"\n    return divisors1.intersection(divisors2)\ndef sum(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of common divisors for two given positive integers.\n    This function orchestrates finding individual divisors, then common ones, and finally their sum.\n    Note: This function overrides the built-in 'sum' function to match the prompt's assertion.\n    \"\"\"\n    # Input validation for positive integers as per design spec is omitted,\n    # prioritizing the critical requirement to not raise exceptions for edge cases.\n\n    divisors1 = _get_divisors(num1)\n    divisors2 = _get_divisors(num2)\n    common_divs = _find_common_divisors(divisors1, divisors2)\n\n    total_sum = 0\n    for divisor in common_divs:\n        total_sum += divisor\n    return total_sum"}
