{"task_id": "Mbpp/426", "solution": "from typing import List, Optional\nclass Number:\n    \"\"\"Represents a single numerical value with methods to check its properties.\"\"\"\n    _value: int\n\n    def __init__(self, value: int):\n        \"\"\"Initializes a Number object with an integer value.\"\"\"\n        self._value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the number is odd by checking divisibility by 2.\"\"\"\n        return self._value % 2 != 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the raw integer value stored in the Number object.\"\"\"\n        return self._value\nclass Collection:\n    \"\"\"Represents a collection of Number objects, allowing for additions and conversions.\"\"\"\n    _numbers: List[Number]\n\n    def __init__(self, numbers: Optional[List[Number]] = None):\n        \"\"\"Initializes the collection, optionally with an existing list of Number objects.\"\"\"\n        self._numbers = numbers if numbers is not None else []\n\n    def add_number(self, number: Number):\n        \"\"\"Adds a single Number object to the internal list of the collection.\"\"\"\n        self._numbers.append(number)\n\n    def get_numbers(self) -> List[Number]:\n        \"\"\"Returns the internal list of Number objects within the collection.\"\"\"\n        return self._numbers\n\n    def to_list(self) -> List[int]:\n        \"\"\"Converts the collection of Number objects into a list of their raw integer values.\"\"\"\n        return [number.get_value() for number in self._numbers]\nclass OddFilter:\n    \"\"\"Encapsulates the core business logic for identifying and filtering odd numbers.\"\"\"\n\n    def filter_odd_numbers(self, input_collection: Collection) -> Collection:\n        \"\"\"Filters an input collection, returning a new collection containing only the odd numbers.\"\"\"\n        output_collection = Collection()\n        for number_obj in input_collection.get_numbers():\n            if number_obj.is_odd():\n                output_collection.add_number(number_obj)\n        return output_collection\ndef filter_oddnumbers(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of raw integers, returning a new list containing only the odd numbers.\n    This function orchestrates the process using Number, Collection, and OddFilter components.\n    \"\"\"\n    input_number_objects = [Number(num) for num in numbers]\n    input_collection = Collection(input_number_objects)\n\n    odd_filter = OddFilter()\n    result_collection = odd_filter.filter_odd_numbers(input_collection)\n\n    return result_collection.to_list()"}
{"task_id": "Mbpp/426", "solution": "from typing import List\ndef filter_oddnumbers(numbers: List[int]) -> List[int]:\n    \"\"\"Filters a list of numbers, returning only the odd numbers.\n    It iterates through the input list and appends odd numbers to a new list.\n    \"\"\"\n    odd_numbers = []\n    for number in numbers:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/427", "solution": "def change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    This function splits the input by hyphens and reorders the components.\n    \"\"\"\n    parts = date_str.split('-')\n    # parts[0] is year, parts[1] is month, parts[2] is day\n    return f\"{parts[2]}-{parts[1]}-{parts[0]}\""}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements using the Shell Sort algorithm.\n    Returns a new sorted list, leaving the original unchanged.\n    \"\"\"\n    n = len(arr)\n    # Create a mutable copy to perform sorting without modifying the original.\n    arr_copy = arr[:]\n\n    gap = n // 2\n    while gap > 0:\n        for i in range(gap, n):\n            temp = arr_copy[i]\n            j = i\n            # Shift elements for the current gap.\n            while j >= gap and arr_copy[j - gap] > temp:\n                arr_copy[j] = arr_copy[j - gap]\n                j -= gap\n            arr_copy[j] = temp\n        gap //= 2\n    return arr_copy"}
