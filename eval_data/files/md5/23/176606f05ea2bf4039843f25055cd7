{"task_id": "Mbpp/137", "solution": "def zero_count(numbers: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Returns 0.0 if there are no non-zeroes, no zeroes, or if the list is empty, handling division by zero.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    for number in numbers:\n        if number == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        return 0.0\n    else:\n        return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(array: tuple) -> (int | float):\n    \"\"\"Calculates the maximum absolute difference between any two elements in a given tuple.\n    Returns 0 if the tuple has fewer than two elements.\"\"\"\n    max_diff = 0.0\n\n    for i in range(len(array)):\n        for j in range(i + 1, len(array)):\n            current_diff = abs(array[i] - array[j])\n            if current_diff > max_diff:\n                max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/160", "solution": "def _extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Implements the Extended Euclidean Algorithm to find gcd(a, b) and\n    coefficients x, y such that ax + by = gcd(a, b).\n    \"\"\"\n    if b == 0:\n        return (a, 1, 0)\n    else:\n        gcd, x, y = _extended_gcd(b, a % b)\n        return (gcd, y, x - (a // b) * y)\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Solves the linear Diophantine equation ax + by = n for integer x and y.\n    Returns a tuple (x, y) if a solution exists, otherwise None.\n    \"\"\"\n    gcd, x0, y0 = _extended_gcd(a, b)\n\n    if n % gcd != 0:\n        return None\n    else:\n        # Scale the Bezout coefficients to find a particular solution for n.\n        k = n // gcd\n        x = x0 * k\n        y = y0 * k\n        return (x, y)"}
