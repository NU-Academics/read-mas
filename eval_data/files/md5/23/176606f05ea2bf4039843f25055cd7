{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list) -> int:\n    \"\"\"\n    Calculates the product of the first even and first odd numbers in a list.\n    Raises ValueError if either an odd or an even number is not found.\n    \"\"\"\n    first_odd = None\n    for num in numbers:\n        if num % 2 != 0:\n            first_odd = num\n            break\n\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    first_even = None\n    for num in numbers:\n        if num % 2 == 0:\n            first_even = num\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/784", "solution": "def _is_even(number: int | float) -> bool:\n    \"\"\"Determines if a number is even, checking its integer part if it's a float.\"\"\"\n    return number % 1 == 0 and number % 2 == 0\ndef _is_odd(number: int | float) -> bool:\n    \"\"\"Determines if a number is odd, checking its integer part if it's a float.\"\"\"\n    return number % 1 == 0 and number % 2 != 0\ndef mul_even_odd(numbers: list) -> int | float:\n    \"\"\"Calculates the product of the first even and first odd numbers in a list.\n    Raises ValueError if either number type is not found.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_even is None and _is_even(number):\n            first_even = number\n        if first_odd is None and _is_odd(number):\n            first_odd = number\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found\")\n\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple into an actual tuple of integers.\n    Assumes the input string is always in the format \"(x, y, z)\" with integer values.\n    \"\"\"\n    # Remove leading '(' and trailing ')'\n    content = s[1:-1]\n    # Split the string by commas and process each part\n    parts = content.split(',')\n    # Convert each part to an integer after stripping whitespace\n    int_values = [int(part.strip()) for part in parts]\n    return tuple(int_values)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This uses a binary search approach to efficiently find the index.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else:\n            low = mid + 1\n    return low"}
