{"task_id": "Mbpp/392", "solution": "_memo = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"Calculates the maximum sum for n using f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\"\"\"\n    # Base case: for n less than or equal to 1, the maximum sum is n itself.\n    if n <= 1:\n        return n\n\n    # Check if the result for n is already in the memoization cache.\n    if n in _memo:\n        return _memo[n]\n\n    # Recursively calculate the sum of subproblems using integer division.\n    sum_of_subproblems = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # Determine the maximum sum by comparing the sum of subproblems with n.\n    current_max_sum = max(sum_of_subproblems, n)\n\n    # Store the computed result in the memoization cache before returning.\n    _memo[n] = current_max_sum\n    return current_max_sum"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int, memo: dict = None) -> int:\n    \"\"\"Calculates the maximum sum for n using a recursive equation with memoization.\n    It stores computed results in a dictionary to avoid redundant calculations.\n    \"\"\"\n    if memo is None:\n        memo = {}\n\n    if n in memo:\n        return memo[n]\n\n    if n == 0:\n        return 0\n\n    sum_of_subproblems = (\n        get_max_sum(n // 2, memo)\n        + get_max_sum(n // 3, memo)\n        + get_max_sum(n // 4, memo)\n        + get_max_sum(n // 5, memo)\n    )\n\n    result = max(sum_of_subproblems, n)\n    memo[n] = result\n    return result"}
