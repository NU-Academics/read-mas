{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(wind_velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer given the wind velocity in km/h and a temperature in celsius.\n    \"\"\"\n    T = temperature\n    V = wind_velocity\n\n    # Wind chill formula for Celsius and km/h.\n    # WCI = 13.12 + 0.6215 * T - 11.37 * V^0.16 + 0.3965 * T * V^0.16\n    v_power = V**0.16\n    raw_wind_chill = (\n        13.12\n        + 0.6215 * T\n        - 11.37 * v_power\n        + 0.3965 * T * v_power\n    )\n    return int(math.ceil(raw_wind_chill))"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer given the wind velocity in km/h and a temperature in celsius.\n    The formula used is the standard Canadian/US wind chill formula (Celsius, km/h).\n    WCI = 13.12 + 0.6215T - 11.37V^0.16 + 0.3965TV^0.16\n    Where T is temperature in Celsius and V is wind velocity in km/h.\n\n    Args:\n        velocity: Wind velocity in kilometers per hour (km/h).\n        temperature: Temperature in Celsius (\u00b0C).\n\n    Returns:\n        The calculated wind chill index rounded up to the next integer.\n    \"\"\"\n    v_pow_0_16 = math.pow(velocity, 0.16)\n\n    wind_chill_float = (\n        13.12\n        + (0.6215 * temperature)\n        - (11.37 * v_pow_0_16)\n        + (0.3965 * temperature * v_pow_0_16)\n    )\n\n    return math.ceil(wind_chill_float)"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(listOfNames: list[str]) -> int:\n    \"\"\"Calculates the sum of lengths of names starting with an uppercase letter.\n    Names starting with a lowercase letter or other characters are excluded.\n    \"\"\"\n    running_sum = 0\n    for name in listOfNames:\n        if name and name[0].isupper():\n            running_sum += len(name)\n    return running_sum"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius: float) -> float | None:\n    \"\"\"\n    Calculates the area of the largest triangle that can be inscribed in a semicircle with a given radius.\n\n    The largest triangle inscribed in a semicircle has its base as the diameter\n    (2 * radius) and its height as the radius. The area is 0.5 * base * height,\n    which simplifies to radius * radius.\n\n    Args:\n        radius (float): The radius of the semicircle.\n\n    Returns:\n        float: The calculated area of the largest inscribed triangle.\n        None: If the radius is negative, as a triangle cannot have a negative radius.\n    \"\"\"\n    if radius < 0:\n        return None\n    return radius * radius"}
