{"task_id": "Mbpp/264", "solution": "import math\ndef dog_age(human_age: int) -> int:\n    \"\"\"\n    Calculates a dog's age in dog years based on its human age.\n    Applies specific conversion rules for different age ranges.\n    \"\"\"\n    dog_years: float = 0.0\n\n    if human_age <= 0:\n        dog_years = 0.0\n    elif human_age == 1:\n        dog_years = 15.0\n    elif human_age == 2:\n        dog_years = 24.0  # 15 (year 1) + 9 (year 2)\n    else:  # human_age > 2\n        # For ages greater than 2, add 3.7 dog years for each subsequent human year.\n        dog_years = 24.0 + (human_age - 2) * 3.7\n\n    return int(math.ceil(dog_years)) if dog_years - int(dog_years) > 0.5 else int(dog_years)"}
{"task_id": "Mbpp/245", "solution": "from typing import List\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence first increases and then decreases.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    inc_sum = [0] * n\n    dec_sum = [0] * n\n\n    # Calculate inc_sum: maximum sum of an increasing subsequence ending at arr[i]\n    for i in range(n):\n        inc_sum[i] = arr[i]\n        for j in range(i):\n            if arr[i] > arr[j]:\n                inc_sum[i] = max(inc_sum[i], inc_sum[j] + arr[i])\n\n    # Calculate dec_sum: maximum sum of a decreasing subsequence starting at arr[i]\n    for i in range(n - 1, -1, -1):\n        dec_sum[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                dec_sum[i] = max(dec_sum[i], dec_sum[j] + arr[i])\n\n    # Calculate the maximum bitonic sum\n    max_bitonic_sum = 0\n    for i in range(n):\n        # Subtract arr[i] because it's counted in both inc_sum[i] and dec_sum[i]\n        max_bitonic_sum = max(max_bitonic_sum, inc_sum[i] + dec_sum[i] - arr[i])\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> int:\n    \"\"\"\n    Calculates a dog's age in dog years from its age in human years.\n    First two years count as 10.5 dog years each, subsequent years as 4 dog years each.\n    \"\"\"\n    if human_years <= 0:\n        return 0\n    elif human_years == 1:\n        dog_years = 10.5\n    elif human_years == 2:\n        dog_years = 2 * 10.5\n    else:\n        dog_years = (2 * 10.5) + ((human_years - 2) * 4)\n\n    return int(dog_years)"}
