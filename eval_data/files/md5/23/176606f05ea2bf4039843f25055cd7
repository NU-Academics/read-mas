{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1, tuple2):\n    \"\"\"\n    Checks if each element in the second tuple is strictly smaller than\n    its corresponding element in the first tuple.\n    Assumes inputs are tuples of equal length.\n    \"\"\"\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/809", "solution": "from typing import Tuple, Union\nNumber = Union[int, float]\nNumericTuple = Tuple[Number, ...]\ndef check_smaller(tuple1: NumericTuple, tuple2: NumericTuple) -> bool:\n    \"\"\"Compares two tuples element-wise for strict smaller condition and equal length.\n    Returns True if every element in tuple2 is strictly smaller than its corresponding element in tuple1, and lengths are equal.\"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for val1, val2 in zip(tuple1, tuple2):\n        if not (val2 < val1):\n            return False\n\n    return True"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(x, y, z):\n    \"\"\"\n    Counts how many of the three input integers are equal.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    unique_numbers = {x, y, z}\n    num_unique = len(unique_numbers)\n\n    if num_unique == 1:\n        return 3\n    elif num_unique == 2:\n        return 2\n    else:  # num_unique == 3\n        return 0"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int | float]]) -> list[int | float]:\n    \"\"\"\n    Finds the sublist within a list of lists whose elements sum to the highest value.\n    Handles empty input lists by returning an empty list, and empty sublists with a sum of 0.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    sublist_with_highest_sum = []\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            sublist_with_highest_sum = sublist\n\n    return sublist_with_highest_sum"}
