{"task_id": "Mbpp/84", "solution": "_memo = {}\ndef sequence(n: int) -> int:\n    \"\"\"Calculates the nth Newman-Conway number using memoization.\n\n    Returns 1 for n=1 or n=2, and recursively calculates p(p(n - 1)) + p(n - p(n - 1)) for n > 2.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 1 or n == 2:\n        result = 1\n    else:\n        # Calculate p(n) = p(p(n - 1)) + p(n - p(n - 1))\n        p_n_minus_1 = sequence(n - 1)\n        term1 = sequence(p_n_minus_1)\n        term2 = sequence(n - p_n_minus_1)\n        result = term1 + term2\n\n    _memo[n] = result\n    return result"}
