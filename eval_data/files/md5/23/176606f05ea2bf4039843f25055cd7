{"task_id": "Mbpp/603", "solution": "def _sieve_of_eratosthenes(limit: int) -> list[int]:\n    \"\"\"Generates all prime numbers up to a given limit using the Sieve of Eratosthenes algorithm.\n    Returns an empty list if the limit is less than 2.\"\"\"\n    if limit < 2:\n        return []\n\n    is_prime = [True] * (limit + 1)\n    is_prime[0] = is_prime[1] = False\n\n    for p in range(2, int(limit**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, limit + 1, p):\n                is_prime[multiple] = False\n\n    primes = [i for i, prime_status in enumerate(is_prime) if prime_status]\n    return primes\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"Calculates and returns a sorted list of ludic numbers (1 and primes) up to a given integer n.\n    The list always includes 1 (if n >= 1) followed by prime numbers in ascending order.\"\"\"\n    ludic_numbers = []\n\n    if n >= 1:\n        ludic_numbers.append(1)\n\n    primes = _sieve_of_eratosthenes(n)\n    ludic_numbers.extend(primes)\n\n    return ludic_numbers"}
{"task_id": "Mbpp/603", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Returns True if the number is prime, False otherwise.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"Calculates all lucid numbers less than or equal to n.\n    Returns a list of integers representing lucid numbers, sorted in ascending order.\n    \"\"\"\n    lucid_numbers = []\n    if n < 1:\n        return lucid_numbers\n\n    lucid_numbers.append(1)\n\n    for num in range(2, n + 1):\n        if is_prime(num):\n            lucid_numbers.append(num)\n\n    return lucid_numbers"}
