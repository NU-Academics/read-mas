{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the highest power of 2 less than or equal to n.\n    Returns 0 if n is less than or equal to 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n    # For positive n, find the position of the most significant bit\n    # and return 2 raised to that power.\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 less than or equal to n.\n    Returns 0 if n is 0, as specified in the design.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer\")\n    if n == 0:\n        return 0\n    # For n > 0, the highest power of 2 is found by getting the\n    # position of the most significant bit and shifting 1 left.\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(integer_value: int) -> int:\n    \"\"\"Sets the left-most unset bit (0) in the given integer to 1.\n    This searches from the bit position equal to bit_length() downwards.\"\"\"\n\n    if integer_value == 0:\n        # For an input of 0, the left-most unset bit is at position 0.\n        return 1\n\n    # Iterate from the bit position one higher than the current most significant bit down to 0.\n    # This ensures finding the highest '0' bit, even if it's beyond the original number's magnitude.\n    for p in range(integer_value.bit_length(), -1, -1):\n        if not (integer_value >> p) & 1:  # Check if the p-th bit is 0\n            return integer_value | (1 << p) # Set the identified bit and return.\n\n    # This return statement should ideally not be reached for positive integers,\n    # as there will always be an unset bit to the left when considering Python's arbitrary-precision integers.\n    # It acts as a fallback to return the original integer if no unset bit is found within the checked range.\n    return integer_value"}
