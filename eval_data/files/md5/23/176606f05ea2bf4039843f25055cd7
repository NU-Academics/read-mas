{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Converts a tuple into a dictionary using adjacent elements as key-value pairs.\n    The first element of each pair is the key, and the second is the value; odd trailing elements are ignored.\"\"\"\n    result = {}\n    # Iterate through the tuple in steps of two to form key-value pairs.\n    for i in range(0, len(input_tuple) - 1, 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Converts a tuple into a dictionary by pairing adjacent elements.\n    Even-indexed elements become keys, and subsequent odd-indexed elements become values.\"\"\"\n    keys = input_tuple[::2]\n    values = input_tuple[1::2]\n    return dict(zip(keys, values))"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(side: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron.\n\n    Args:\n        side: The side length of the regular tetrahedron.\n\n    Returns:\n        The total surface area of the tetrahedron.\n    \"\"\"\n    if side <= 0:\n        raise ValueError(\"Side length must be a positive number for calculation.\")\n\n    # Formula: Total Surface Area = sqrt(3) * side^2\n    return math.sqrt(3) * (side ** 2)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range that are divisible by every digit they contain.\n    Zero digits are ignored for the divisibility check.\n    \"\"\"\n    result = []\n    for num in range(startnum, endnum + 1):\n        is_divisible = True\n        temp_num = num\n        # Handle single digit numbers correctly, especially 0 if it were in range\n        if temp_num == 0:\n            # Special case for 0: no digits to divide by, could be considered valid or invalid\n            # Based on the example 1 to 22, 0 is not expected in the range.\n            # If 0 was included, it has no non-zero digits, so it would pass vacuously.\n            # For simplicity and adhering to problem statement (1 to 22 example doesn't show 0),\n            # we'll assume standard digit processing applies.\n            # If we were to treat 0 explicitly, it's a number that contains only 0.\n            # Since division by 0 is not allowed, it effectively has no non-zero digits.\n            # This logic will naturally handle 0 if it appears in the range.\n            # For now, rely on string conversion as it simplifies digit extraction for all numbers.\n            pass\n\n        # Convert number to string to easily iterate over digits\n        num_str = str(num)\n        for digit_char in num_str:\n            digit = int(digit_char)\n            if digit == 0:\n                continue  # Skip zero digits as division by zero is undefined\n            if num % digit != 0:\n                is_divisible = False\n                break\n\n        if is_divisible:\n            result.append(num)\n\n    return result"}
