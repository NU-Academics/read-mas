{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"Finds the nth polite number.\n\n    A polite number is a positive integer that can be expressed as the sum\n    of two or more consecutive positive integers. Numbers that are powers\n    of 2 are not polite numbers. This function calculates the nth such number.\n\n    Args:\n        n: The position of the polite number to find (1-indexed).\n\n    Returns:\n        The nth polite number.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    count = 0\n    num = 0\n    while count < n:\n        num += 1\n        # Check if num is a power of 2\n        # A number is a power of 2 if it's positive and has only one bit set (num & (num - 1) == 0)\n        if not (num > 0 and (num & (num - 1) == 0)):\n            count += 1\n    return num"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Calculates the nth polite number.\n    Polite numbers are positive integers that are not powers of 2.\n    \"\"\"\n    polite_count = 0\n    num = 0\n    while polite_count < n:\n        num += 1\n        # Check if num is a power of 2 using bitwise operation:\n        # A number is a power of 2 if it's positive and (num & (num - 1)) is 0.\n        if num > 0 and (num & (num - 1)) == 0:\n            # It's a power of 2, so it's not a polite number.\n            continue\n        else:\n            # It's not a power of 2, so it's a polite number.\n            polite_count += 1\n    return num"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list:\n    \"\"\"\n    Transforms a list into a new list of tuples, each containing two consecutive elements.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_list = []\n    for i in range(len(input_list) - 1):\n        first = input_list[i]\n        second = input_list[i + 1]\n        result_list.append((first, second))\n\n    return result_list"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"Counts pairs of numbers in a list that sum to a target value.\n    Pairs are formed by elements at distinct indices.\"\"\"\n    pair_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"Counts pairs in a list that sum to a specified target, handling duplicates.\n\n    Returns the total count of unique pairs whose elements sum up to the target sum.\n    \"\"\"\n    freq_map = {}\n    for num in numbers:\n        freq_map[num] = freq_map.get(num, 0) + 1\n\n    count = 0\n\n    # Iterate through a copy of keys to safely modify the dictionary during iteration.\n    for num in list(freq_map.keys()):\n        # Skip if this number's frequency has been reduced to 0 by processing its complement.\n        if freq_map[num] == 0:\n            continue\n\n        complement = target_sum - num\n\n        if complement in freq_map and freq_map[complement] > 0:\n            if num == complement:\n                # If num is its own complement, we need to pick two instances of num.\n                # The number of pairs is nC2 where n is freq_map[num].\n                n = freq_map[num]\n                count += (n * (n - 1)) // 2\n                freq_map[num] = 0  # Mark as used completely.\n            else:\n                # If num and complement are different, number of pairs is freq[num] * freq[complement].\n                count += freq_map[num] * freq_map[complement]\n                freq_map[num] = 0  # Mark both as used completely.\n                freq_map[complement] = 0\n    return count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Generates a list of all consecutive item pairs from the input_list.\n    Returns an empty list if the input_list has fewer than two items.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_pairs = []\n    for i in range(len(input_list) - 1):\n        pair = (input_list[i], input_list[i+1])\n        result_pairs.append(pair)\n    return result_pairs"}
