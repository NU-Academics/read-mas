{"task_id": "Mbpp/564", "solution": "def count_Pairs(input_list: list[int]) -> int:\n    \"\"\"\n    Counts the number of unique unordered pairs from a list where elements are unequal.\n    Iterates through all possible pairs and increments a counter if their values differ.\n    \"\"\"\n    pair_count = 0\n    n = len(input_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):  # Ensures unique unordered pairs (j > i)\n            if input_list[i] != input_list[j]:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(input_integer: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\n    It processes the number digit by digit, adding each to a running sum.\n    \"\"\"\n    if input_integer == 0:\n        return 0\n\n    digit_sum = 0\n    temp_num = input_integer\n    while temp_num > 0:\n        digit_sum += temp_num % 10\n        temp_num //= 10\n    return digit_sum"}
{"task_id": "Mbpp/564", "solution": "from collections import Counter\ndef count_Pairs(arr: list[int]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs with unequal elements in a list.\n    It calculates total possible pairs and subtracts pairs with equal elements.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return 0\n\n    total_pairs = n * (n - 1) // 2\n\n    freq_map = Counter(arr)\n\n    equal_pairs_count = 0\n    for freq in freq_map.values():\n        if freq >= 2:\n            pairs_for_this_number = freq * (freq - 1) // 2\n            equal_pairs_count += pairs_for_this_number\n\n    final_result = total_pairs - equal_pairs_count\n    return final_result"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of a non-negative integer.\n    Returns the sum of its digits.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    total_sum = 0\n    while number > 0:\n        digit = number % 10\n        total_sum += digit\n        number //= 10\n    return total_sum"}
