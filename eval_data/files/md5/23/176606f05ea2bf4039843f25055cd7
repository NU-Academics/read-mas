{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(target_string: str, pattern: str) -> tuple[str | None, int, int]:\n    \"\"\"\n    Searches a target string for a regex pattern and returns matching details.\n    Returns the matched substring, its start index, and its end index, or (None, -1, -1) if no match.\n    \"\"\"\n    match_object = re.search(pattern, target_string)\n    if match_object:\n        matched_substring = match_object.group(0)\n        start_index = match_object.start()\n        end_index = match_object.end()\n        return (matched_substring, start_index, end_index)\n    else:\n        return (None, -1, -1)"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches for the first occurrence of a regex pattern within a text.\n    Returns the matched substring, its start index, and its end index if found, otherwise None.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number. This uses a dynamic programming approach based on Stirling numbers of the second kind.\"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list for Stirling numbers of the second kind, dp[i][j] stores S(i, j).\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case for Stirling numbers of the second kind.\n    dp[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            # Apply the recurrence relation for S(i, j).\n            dp[i][j] = dp[i-1][j-1] + j * dp[i-1][j]\n\n    # The nth Bell number is the sum of S(n, k) for k from 0 to n.\n    bell_number = sum(dp[n][k] for k in range(n + 1))\n    return bell_number"}
