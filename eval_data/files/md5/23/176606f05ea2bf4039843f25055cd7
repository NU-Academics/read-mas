{"task_id": "Mbpp/74", "solution": "def is_samepatterns(strings: list, patterns: list) -> bool:\n    \"\"\"\n    Determines if a list of strings follows a specified patterns sequence, ensuring a one-to-one\n    and consistent mapping between unique elements.\n    \"\"\"\n    if not strings and not patterns:\n        return True\n\n    if len(strings) != len(patterns):\n        return False\n\n    pattern_to_string_map = {}\n    string_to_pattern_map = {}\n\n    for s, p in zip(strings, patterns):\n        if p in pattern_to_string_map:\n            if pattern_to_string_map[p] != s:\n                return False\n        else:\n            pattern_to_string_map[p] = s\n\n        if s in string_to_pattern_map:\n            if string_to_pattern_map[s] != p:\n                return False\n        else:\n            string_to_pattern_map[s] = p\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "def _is_tuple_divisible_by_k(current_tuple: tuple, k: int) -> bool:\n    \"\"\"Checks if all elements in a tuple are perfectly divisible by k.\n    This is a private helper function for find_tuples.\"\"\"\n    return all(element % k == 0 for element in current_tuple)\ndef find_tuples(list_of_tuples: list[tuple], k: int) -> list[tuple]:\n    \"\"\"Identifies and collects tuples where all elements are divisible by k.\n    It utilizes a helper function to check individual tuple divisibility.\"\"\"\n    result_list = []\n    for current_tuple in list_of_tuples:\n        if _is_tuple_divisible_by_k(current_tuple, k):\n            result_list.append(current_tuple)\n    return result_list"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(strings: list[str], patterns: list[str]) -> bool:\n    \"\"\"\n    Checks if the 'strings' list follows the pattern defined by the 'patterns' list.\n    Establishes a consistent one-to-one mapping between elements.\n    \"\"\"\n    if not strings and not patterns:\n        return True\n\n    if len(strings) != len(patterns):\n        return False\n\n    string_to_pattern_map = {}\n    pattern_to_string_map = {}\n\n    for i in range(len(strings)):\n        s_element = strings[i]\n        p_element = patterns[i]\n\n        if s_element in string_to_pattern_map:\n            if string_to_pattern_map[s_element] != p_element:\n                return False\n        elif p_element in pattern_to_string_map:\n            if pattern_to_string_map[p_element] != s_element:\n                return False\n        else:\n            string_to_pattern_map[s_element] = p_element\n            pattern_to_string_map[p_element] = s_element\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where every element in the tuple\n    is perfectly divisible by k. An empty list is returned if no tuples meet the criteria or if the input list is empty.\n    \"\"\"\n    filtered_tuples = []\n    for current_tuple in list_of_tuples:\n        all_elements_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                all_elements_divisible = False\n                break\n        if all_elements_divisible:\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(number: int) -> bool:\n    \"\"\"\n    Checks if a positive integer can be represented as the difference of two perfect squares.\n    This is true if the number is odd or a multiple of 4.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input number must be an integer.\")\n    if number <= 0:\n        raise ValueError(\"Input number must be a positive integer.\")\n\n    # An integer 'n' can be expressed as a^2 - b^2 if and only if 'n' is odd or 'n' is a multiple of 4.\n    return (number % 2 != 0) or (number % 4 == 0)"}
{"task_id": "Mbpp/67", "solution": "def combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient \"n choose k\".\n    This computes C(n, k) = n! / (k! * (n-k)!).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using dynamic programming.\n    It uses the recurrence B_n = sum(k=0 to n-1) of C(n-1, k) * B_k.\"\"\"\n    if n == 0:\n        return 1\n\n    # bell_numbers[i] will store the i-th Bell number\n    bell_numbers = [0] * (n + 1)\n    bell_numbers[0] = 1\n\n    for i in range(1, n + 1):\n        current_bell = 0\n        for k in range(i):\n            current_bell += combinations(i - 1, k) * bell_numbers[k]\n        bell_numbers[i] = current_bell\n\n    return bell_numbers[n]"}
