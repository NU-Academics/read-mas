{"task_id": "Mbpp/3", "solution": "def is_not_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is not a prime number. It returns True if the number is less than or equal to 1 or is a composite number, and False if it is a prime number.\n    \"\"\"\n    # Numbers less than or equal to 1 are not prime.\n    if num <= 1:\n        return True\n\n    # Check for divisors from 2 up to the square root of num. If a divisor is found, the number is composite (not prime).\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return True  # A divisor was found, indicating a composite number.\n\n    return False  # No divisors found, so the number is prime."}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1, list2):\n    \"\"\"\n    Identifies and returns common elements between two input collections.\n    Leverages sets for efficient intersection to meet performance requirements.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    common_elements_set = set1.intersection(set2)\n    return list(common_elements_set)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(num: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime, including numbers less than or equal to 1.\n    Returns True if num is not prime, False if num is prime.\n    \"\"\"\n    if num <= 1:\n        return True\n\n    # Checks for primality for numbers greater than 1.\n    # Iterates through potential divisors from 2 up to the square root of num.\n    i = 2\n    while i * i <= num:\n        if num % i == 0:\n            return True  # Found a divisor, so num is not prime\n        i += 1\n\n    return False  # No divisors found, so num is prime"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1, list2):\n    \"\"\"Finds elements common to both input iterables.\n    Converts inputs to sets for efficient intersection finding.\"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    common_elements_set = set1.intersection(set2)\n    return list(common_elements_set)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1, num2):\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position in their binary representations.\n    Returns True if exactly one bit differs, False otherwise.\n    \"\"\"\n    # Calculate XOR; bits set in xor_result indicate differing bits between num1 and num2.\n    xor_result = num1 ^ num2\n\n    # A number N has exactly one bit set if N > 0 and (N & (N - 1)) == 0.\n    # This property identifies powers of two, which have a single set bit.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1, num2):\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is determined by XORing the numbers and checking if the result has only one bit set.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/4", "solution": "def heap_queue_largest(numbers, n):\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Uses an inline min-heap implementation to efficiently track the largest elements.\n    \"\"\"\n    if n <= 0 or not numbers:\n        return []\n\n    min_heap = []\n\n    # --- Start of inline min-heap implementation ---\n    # These functions are defined internally to satisfy the \"inline\" constraint.\n\n    def _siftup(heap, pos):\n        \"\"\"Sift up element at pos to maintain heap invariant.\"\"\"\n        newitem = heap[pos]\n        while pos > 0:\n            parentpos = (pos - 1) >> 1\n            parent = heap[parentpos]\n            if newitem < parent:\n                heap[pos] = parent\n                pos = parentpos\n                continue\n            break\n        heap[pos] = newitem\n\n    def _siftdown(heap, pos):\n        \"\"\"Sift down element at pos to maintain heap invariant.\"\"\"\n        endpos = len(heap)\n        newitem = heap[pos]\n        childpos = 2 * pos + 1\n        while childpos < endpos:\n            rightpos = childpos + 1\n            if rightpos < endpos and not heap[childpos] < heap[rightpos]:\n                childpos = rightpos\n            if heap[childpos] < newitem:\n                heap[pos] = heap[childpos]\n                pos = childpos\n                childpos = 2 * pos + 1\n            else:\n                break\n        heap[pos] = newitem\n\n    def _heappush(heap, item):\n        \"\"\"Push item onto heap, maintaining heap invariant.\"\"\"\n        heap.append(item)\n        _siftup(heap, len(heap) - 1)\n\n    def _heapreplace(heap, item):\n        \"\"\"Pop smallest item and push new item, maintaining heap invariant.\"\"\"\n        returnitem = heap[0]\n        heap[0] = item\n        _siftdown(heap, 0)\n        return returnitem\n\n    # --- End of inline min-heap implementation ---\n\n    for number in numbers:\n        if len(min_heap) < n:\n            _heappush(min_heap, number)\n        elif number > min_heap[0]:\n            _heapreplace(min_heap, number)\n\n    result = list(min_heap)\n    result.sort(reverse=True)\n    return result"}
{"task_id": "Mbpp/4", "solution": "def heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"Finds the n largest numbers from a list using a min-heap, returning them in descending order.\n    Nested functions implement the min-heap operations required for efficient processing.\n    \"\"\"\n\n    min_heap = []\n\n    def _heapify_up(heap, index):\n        # Moves the element at index up the heap to maintain the min-heap property.\n        parent_idx = (index - 1) // 2\n        while index > 0 and heap[index] < heap[parent_idx]:\n            heap[index], heap[parent_idx] = heap[parent_idx], heap[index]\n            index = parent_idx\n            parent_idx = (index - 1) // 2\n\n    def _heapify_down(heap, index):\n        # Moves the element at index down the heap to maintain the min-heap property.\n        size = len(heap)\n        while True:\n            left_child_idx = 2 * index + 1\n            right_child_idx = 2 * index + 2\n            smallest = index\n\n            if left_child_idx < size and heap[left_child_idx] < heap[smallest]:\n                smallest = left_child_idx\n            if right_child_idx < size and heap[right_child_idx] < heap[smallest]:\n                smallest = right_child_idx\n\n            if smallest != index:\n                heap[index], heap[smallest] = heap[smallest], heap[index]\n                index = smallest\n            else:\n                break\n\n    def _heappush(heap, item):\n        # Adds an item to the min-heap, maintaining the heap property.\n        heap.append(item)\n        _heapify_up(heap, len(heap) - 1)\n\n    def _heappop(heap):\n        # Removes and returns the smallest item from the min-heap, then re-heapifies.\n        if not heap:\n            return None\n        if len(heap) == 1:\n            return heap.pop()\n\n        root = heap[0]\n        heap[0] = heap.pop()\n        _heapify_down(heap, 0)\n        return root\n\n    for num in numbers:\n        if len(min_heap) < n:\n            _heappush(min_heap, num)\n        elif num > min_heap[0]:\n            _heappop(min_heap)\n            _heappush(min_heap, num)\n\n    # Extract all elements from the min-heap.\n    result = []\n    while min_heap:\n        result.append(_heappop(min_heap))\n\n    # Sort the extracted elements in descending order as required.\n    result.sort(reverse=True)\n    return result"}
