{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words in a text that are strictly longer than a specified integer 'n'.\n    It leverages an internal Word class to manage word properties and stripping.\n    \"\"\"\n\n    class Word:\n        \"\"\"Represents a single word, managing its value and length.\"\"\"\n        def __init__(self, value: str):\n            # Strips common leading/trailing punctuation, preserving internal punctuation like apostrophes or hyphens.\n            punctuation_to_strip = \".,!?;:\\\"()[]{}<>\"\n            self._value = value.strip(punctuation_to_strip)\n            self._length = len(self._value)\n\n        def getLength(self) -> int:\n            return self._length\n\n        def getValue(self) -> str:\n            return self._value\n\n    # The main logic for finding long words, acting as the WordAnalyzerModule's function.\n    result_words = []\n    raw_words = text.split()\n\n    for raw_word in raw_words:\n        word_obj = Word(raw_word)\n        if word_obj.getLength() > n:\n            result_words.append(word_obj.getValue())\n\n    return result_words"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"Filters words from text, returning those strictly longer than n characters.\"\"\"\n    words = text.split()\n    long_words_list = []\n    for word in words:\n        if len(word) > n:\n            long_words_list.append(word)\n    return long_words_list"}
{"task_id": "Mbpp/129", "solution": "def _is_square_and_consistent(matrix: list[list[int]]) -> tuple[bool, int]:\n    \"\"\"\n    Checks if the matrix is square and all rows have consistent lengths.\n    Returns a tuple: (is_valid_square, size).\n    \"\"\"\n    num_rows = len(matrix)\n    if num_rows == 0:\n        return False, 0\n\n    first_row_len = len(matrix[0])\n    if first_row_len == 0: # Handle cases like [[]]\n        return False, 0\n\n    if num_rows != first_row_len:\n        return False, 0\n\n    for row in matrix:\n        if len(row) != first_row_len:\n            return False, 0\n\n    return True, num_rows\ndef _calculate_row_sum(matrix: list[list[int]], row_index: int) -> int:\n    \"\"\"\n    Calculates the sum of elements in a specific row.\n    \"\"\"\n    return sum(matrix[row_index])\ndef _calculate_column_sum(matrix: list[list[int]], col_index: int, size: int) -> int:\n    \"\"\"\n    Calculates the sum of elements in a specific column.\n    \"\"\"\n    col_sum = 0\n    for i in range(size):\n        col_sum += matrix[i][col_index]\n    return col_sum\ndef _calculate_main_diagonal_sum(matrix: list[list[int]], size: int) -> int:\n    \"\"\"\n    Calculates the sum of elements along the main diagonal (top-left to bottom-right).\n    \"\"\"\n    diag_sum = 0\n    for i in range(size):\n        diag_sum += matrix[i][i]\n    return diag_sum\ndef _calculate_anti_diagonal_sum(matrix: list[list[int]], size: int) -> int:\n    \"\"\"\n    Calculates the sum of elements along the anti-diagonal (top-right to bottom-left).\n    \"\"\"\n    anti_diag_sum = 0\n    for i in range(size):\n        anti_diag_sum += matrix[i][size - 1 - i]\n    return anti_diag_sum\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given 2D list `matrix` is a magic square.\n    It orchestrates checks for square shape, consistent rows, and equal sums.\n    \"\"\"\n    is_valid, size = _is_square_and_consistent(matrix)\n    if not is_valid:\n        return False\n\n    if size == 0: # An empty matrix is not a magic square\n        return False\n\n    magic_sum = _calculate_row_sum(matrix, 0) # Reference sum from the first row\n\n    # Check all row sums\n    for i in range(size):\n        if _calculate_row_sum(matrix, i) != magic_sum:\n            return False\n\n    # Check all column sums\n    for j in range(size):\n        if _calculate_column_sum(matrix, j, size) != magic_sum:\n            return False\n\n    # Check main diagonal sum\n    if _calculate_main_diagonal_sum(matrix, size) != magic_sum:\n        return False\n\n    # Check anti-diagonal sum\n    if _calculate_anti_diagonal_sum(matrix, size) != magic_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in the given list.\n    Returns None if the input list is empty; otherwise, returns one of the most frequent items.\n    \"\"\"\n    if not input_list:\n        return None\n\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_freq_item = None\n    max_freq_count = -1\n\n    for item, count in frequency_map.items():\n        if count > max_freq_count:\n            max_freq_count = count\n            max_freq_item = item\n\n    return max_freq_item"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty, otherwise one of the highest frequency items.\n    \"\"\"\n    if not items:\n        return None\n\n    counts = {}\n    for item in items:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_count = -1\n    max_item = None\n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"\n    Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\n    'y' is not considered a vowel.\n    \"\"\"\n    lower_char = char.lower()\n    return lower_char in ('a', 'e', 'i', 'o', 'u')\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels (a, e, i, o, u, case-insensitive) in the input string.\n    Non-vowel characters remain in their original positions.\n    \"\"\"\n    s_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(s_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = vowels_found[i]\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive, 'y' excluded).\"\"\"\n    return char.lower() in 'aeiou'\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels in the given string (case-insensitive, 'y' is not a vowel).\"\"\"\n    s_list = list(input_string)\n    left, right = 0, len(s_list) - 1\n\n    while left < right:\n        while left < right and not _is_vowel(s_list[left]):\n            left += 1\n        while left < right and not _is_vowel(s_list[right]):\n            right -= 1\n\n        if left < right:\n            s_list[left], s_list[right] = s_list[right], s_list[left]\n            left += 1\n            right -= 1\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "from typing import List\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n\n    A magic square is a square matrix where the sum of the numbers in each row,\n    each column, and both main diagonals are the same.\n\n    Args:\n        matrix: A list of lists of integers representing the matrix.\n\n    Returns:\n        True if the matrix is a magic square, False otherwise.\n    \"\"\"\n    # --- Input Validation and Matrix Structure Checks ---\n    # Check if matrix is a list and not empty\n    if not isinstance(matrix, list) or not matrix:\n        return False\n\n    num_rows = len(matrix)\n\n    # Check if all elements in matrix are lists (representing rows)\n    if not all(isinstance(row, list) for row in matrix):\n        return False\n\n    # Determine the number of columns from the first row. Handle empty first row.\n    num_cols = len(matrix[0])\n\n    # Check for jagged arrays (all rows must have the same number of columns)\n    if not all(len(row) == num_cols for row in matrix):\n        return False\n\n    # Validate all elements are integers\n    for row in matrix:\n        if not all(isinstance(item, int) for item in row):\n            return False\n\n    # Check if it's a square matrix (N x N) and has at least one element (N >= 1)\n    if num_rows != num_cols or num_rows == 0:\n        return False\n\n    size = num_rows # The dimension N for an N x N square matrix\n\n    # --- Magic Square Property Checks ---\n\n    # Calculate row sums\n    row_sums = [sum(row) for row in matrix]\n\n    # The magic sum is the sum of the first row\n    magic_sum = row_sums[0]\n\n    # Verify all row sums are equal to the magic sum\n    if not all(s == magic_sum for s in row_sums):\n        return False\n\n    # Calculate column sums\n    col_sums = [0] * size\n    for r in range(size):\n        for c in range(size):\n            col_sums[c] += matrix[r][c]\n\n    # Verify all column sums are equal to the magic sum\n    if not all(s == magic_sum for s in col_sums):\n        return False\n\n    # Calculate main diagonal sum\n    main_diag_sum = 0\n    for i in range(size):\n        main_diag_sum += matrix[i][i]\n\n    # Verify main diagonal sum is equal to the magic sum\n    if main_diag_sum != magic_sum:\n        return False\n\n    # Calculate anti-diagonal sum\n    anti_diag_sum = 0\n    for i in range(size):\n        anti_diag_sum += matrix[i][size - 1 - i]\n\n    # Verify anti-diagonal sum is equal to the magic sum\n    if anti_diag_sum != magic_sum:\n        return False\n\n    # If all checks pass, it's a magic square\n    return True"}
