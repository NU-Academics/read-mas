{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], n: int) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs of numbers in a list.\n    It iterates through all distinct pairs, computes their XOR, and sums the results.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Rearranges a list by moving all zero elements to its end, preserving non-zero order.\"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(element)\n\n    # Append the counted zeros to the list of non-zeros.\n    non_zeros.extend([0] * zero_count)\n\n    return non_zeros"}
{"task_id": "Mbpp/632", "solution": "def move_zeroes(input_list: list) -> list:\n    \"\"\"\n    Moves all zeroes to the end of the list while preserving the relative order of non-zero elements.\n    Returns a new list with the modified order.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(element)\n\n    # Concatenate non-zero elements with the appropriate number of zeroes\n    result_list = non_zero_elements + [0] * zero_count\n    return result_list"}
