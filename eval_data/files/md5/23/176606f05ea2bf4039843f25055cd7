{"task_id": "Mbpp/721", "solution": "class Path:\n    \"\"\"Represents a sequence of cells forming a path and calculates its metrics.\"\"\"\n    def __init__(self, sequence_of_cells: List[Cell]):\n        # Initializes a Path object and calculates its metrics.\n        self.sequence_of_cells = sequence_of_cells\n        self.total_cost: float = 0.0\n        self.number_of_cells: int = 0\n        self.average_cost: float = 0.0\n        self._calculate_metrics()\n\n    def _calculate_metrics(self):\n        \"\"\"Helper to compute all path metrics upon initialization.\"\"\"\n        self.calculate_total_cost()\n        self.calculate_number_of_cells()\n        self.calculate_average_cost()\n\n    def calculate_total_cost(self) -> float:\n        \"\"\"Calculates and sets the total cost of the path.\"\"\"\n        self.total_cost = sum(cell.cost for cell in self.sequence_of_cells)\n        return self.total_cost\n\n    def calculate_number_of_cells(self) -> int:\n        \"\"\"Counts and sets the number of cells in the path.\"\"\"\n        self.number_of_cells = len(self.sequence_of_cells)\n        return self.number_of_cells\n\n    def calculate_average_cost(self) -> float:\n        \"\"\"Computes and sets the average cost of the path.\"\"\"\n        if self.number_of_cells == 0:\n            self.average_cost = 0.0\n        else:\n            self.average_cost = self.total_cost / self.number_of_cells\n        return self.average_cost\n\n    def __repr__(self) -> str:\n        cells_repr = \", \".join(f\"({c.row},{c.col})\" for c in self.sequence_of_cells)\n        return f\"Path(cells=[{cells_repr}], avg={self.average_cost:.2f})\"\ndef _parse_matrix_input_internal(cell_costs_list: List[List[int]]) -> Matrix:\n    \"\"\"\n    Parses a list of lists of integers into a Matrix object.\n    Includes validation as per the design specification.\n    \"\"\"\n    if not isinstance(cell_costs_list, list) or not all(isinstance(row, list) for row in cell_costs_list):\n        raise ValueError(\"Input must be a list of lists.\")\n\n    if not cell_costs_list:\n        raise ValueError(\"Input matrix cannot be empty.\")\n\n    N = len(cell_costs_list)\n    if not all(len(row) == N for row in cell_costs_list):\n        raise ValueError(\"Input matrix is not square (N*N).\")\n\n    for r_idx, row in enumerate(cell_costs_list):\n        for c_idx, cost in enumerate(row):\n            if not isinstance(cost, int):\n                raise ValueError(f\"Cell cost at ({r_idx},{c_idx}) is not an integer: {cost}\")\n\n    return Matrix(N, cell_costs_list)\ndef _find_all_paths_internal(matrix: Matrix) -> List[Path]:\n    \"\"\"\n    Identifies all valid paths from (0,0) to (N-1, N-1) with right/down movements.\n    Uses a recursive depth-first search (DFS) approach.\n    \"\"\"\n    all_paths: List[Path] = []\n    N = matrix.N\n\n    def dfs(current_row: int, current_col: int, current_path_cells: List[Cell]):\n        current_path_cells.append(matrix.get_cell(current_row, current_col))\n\n        if current_row == N - 1 and current_col == N - 1:\n            all_paths.append(Path(list(current_path_cells)))\n            current_path_cells.pop()\n            return\n\n        if current_col + 1 < N:\n            dfs(current_row, current_col + 1, current_path_cells)\n\n        if current_row + 1 < N:\n            dfs(current_row + 1, current_col, current_path_cells)\n\n        current_path_cells.pop()\n\n    if N > 0:\n        dfs(0, 0, [])\n\n    return all_paths\ndef _find_max_average_path_cost_internal(paths: List[Path]) -> float:\n    \"\"\"\n    Determines the path with the maximum average cost among all paths.\n    Returns 0.0 if the list of paths is empty.\n    \"\"\"\n    if not paths:\n        return 0.0\n\n    max_avg_cost = -float('inf')\n    for path in paths:\n        if path.average_cost > max_avg_cost:\n            max_avg_cost = path.average_cost\n\n    return max_avg_cost\ndef maxAverageOfPath(matrix_cost_list: List[List[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost in a square matrix.\n    This function orchestrates the system components as per the design.\n    \"\"\"\n    matrix = _parse_matrix_input_internal(matrix_cost_list)\n\n    all_paths = _find_all_paths_internal(matrix)\n\n    max_avg_cost = _find_max_average_path_cost_internal(all_paths)\n\n    return max_avg_cost"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Finds the path with the maximum average cost from top-left to bottom-right,\n    moving only right or down.\n    \"\"\"\n    N = len(matrix)\n    max_avg = -float('inf')\n\n    def _dfs(r, c, current_sum, current_length):\n        nonlocal max_avg\n\n        # Add current cell's cost and increment length\n        current_sum += matrix[r][c]\n        current_length += 1\n\n        # Check if reached the bottom-right cell\n        if r == N - 1 and c == N - 1:\n            current_average = current_sum / current_length\n            if current_average > max_avg:\n                max_avg = current_average\n            return\n\n        # Move Right\n        if c + 1 < N:\n            _dfs(r, c + 1, current_sum, current_length)\n\n        # Move Down\n        if r + 1 < N:\n            _dfs(r + 1, c, current_sum, current_length)\n\n    # Start DFS from top-left cell (0,0)\n    _dfs(0, 0, 0.0, 0)\n\n    return max_avg"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(string):\n    \"\"\"Extracts all substrings enclosed by double quotation marks from the given string.\n    Assumes well-formed input with balanced quotes.\"\"\"\n    quotations = []\n    in_quote = False\n    start_index = -1\n\n    for i in range(len(string)):\n        if string[i] == '\"':\n            if in_quote:\n                quotations.append(string[start_index:i])\n                in_quote = False\n            else:\n                start_index = i + 1\n                in_quote = True\n    return quotations"}
{"task_id": "Mbpp/724", "solution": "class PowerDigitSumCalculator:\n    \"\"\"\n    Encapsulates core logic for exponentiation and digit summation.\n    Handles large numbers by converting the power result to a string.\n    \"\"\"\n    def _calculate_power(self, base: int, power: int) -> str:\n        \"\"\"\n        Calculates base raised to the power and returns the result as a string.\n        \"\"\"\n        result = base ** power\n        return str(result)\n\n    def _sum_digits(self, number_string: str) -> int:\n        \"\"\"\n        Sums the integer value of each character in a number string.\n        \"\"\"\n        total_sum = 0\n        for digit_char in number_string:\n            total_sum += int(digit_char)\n        return total_sum\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of base raised to the power.\n    This function serves as the entry point for the system.\n    \"\"\"\n    calculator = PowerDigitSumCalculator()\n    result_string = calculator._calculate_power(base, power)\n    final_sum = calculator._sum_digits(result_string)\n    return final_sum"}
