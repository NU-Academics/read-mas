{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(radius: float, angle: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y).\n    The angle input is interpreted in radians for trigonometric calculations.\n    \"\"\"\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    return (x, y), complex(x, y)"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(r: float, theta: float) -> tuple[float, float]:\n    \"\"\"Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\"\"\"\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return (x, y)"}
{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients.\n    Computes sum(C(n, k) * C(n, k+1)) for k from 0 to n-1.\"\"\"\n    total_sum = 0\n    for k in range(n):\n        c_nk = math.comb(n, k)\n        c_nk_plus_1 = math.comb(n, k + 1)\n        total_sum += c_nk * c_nk_plus_1\n    return total_sum"}
