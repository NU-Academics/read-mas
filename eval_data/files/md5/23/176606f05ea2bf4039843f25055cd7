{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Encapsulates a binary string and provides methods for LSB retrieval and left rotation.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def get_lsb(self) -> str:\n        \"\"\"Returns the least significant bit of the binary string.\"\"\"\n        return self.value[-1]\n\n    def rotate_left(self) -> None:\n        \"\"\"Performs a left rotation on the binary string.\"\"\"\n        if not self.value:\n            return\n        self.value = self.value[1:] + self.value[0]\nclass RotationCounter:\n    \"\"\"Manages the count of odd equivalent rotations and orchestrates the rotation loop.\"\"\"\n    def __init__(self):\n        self._odd_count = 0\n\n    def increment_count(self) -> None:\n        \"\"\"Increments the internal counter for odd occurrences.\"\"\"\n        self._odd_count += 1\n\n    def perform_rotations(self, binary_string_obj: 'BinaryString', n: int) -> int:\n        \"\"\"Executes the rotation loop and counts odd binary string equivalents.\"\"\"\n        for _ in range(n):\n            if binary_string_obj.get_lsb() == '1':\n                self.increment_count()\n            binary_string_obj.rotate_left()\n        return self._odd_count\ndef odd_Equivalent(binary_string: str, n: int) -> int:\n    \"\"\"Orchestrates the calculation of odd equivalent binary rotations using BinaryString and RotationCounter.\"\"\"\n    binary_string_obj = BinaryString(binary_string)\n    rotation_counter_obj = RotationCounter()\n    return rotation_counter_obj.perform_rotations(binary_string_obj, n)"}
{"task_id": "Mbpp/111", "solution": "from typing import Any, List\ndef common_in_nested_lists(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds elements common to all nested lists within a given list of lists.\n    Returns a list of these common elements.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    # Initialize common_elements with the set of the first nested list.\n    common_elements = set(list_of_lists[0])\n\n    # Iterate through the remaining nested lists, finding intersections.\n    for sublist in list_of_lists[1:]:\n        common_elements = common_elements.intersection(set(sublist))\n        if not common_elements: # If no common elements remain, further intersections won't change this.\n            break\n\n    return list(common_elements)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds elements common to all sublists within a given list of lists.\n    Returns a set containing only these common elements.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    common_set = set(nested_lists[0])\n    for sublist in nested_lists[1:]:\n        common_set.intersection_update(sublist)\n\n    return common_set"}
{"task_id": "Mbpp/109", "solution": "def _rotate_string(s: str) -> str:\n    \"\"\"Rotates the input string s one position to the left.\"\"\"\n    if not s:\n        return s\n    return s[1:] + s[0]\ndef _binary_to_decimal(binary_str: str) -> int:\n    \"\"\"Converts a binary string into its decimal integer representation.\"\"\"\n    if not binary_str:\n        return 0 # An empty binary string can be considered 0.\n    return int(binary_str, 2)\ndef odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"Counts how many of the n rotated binary strings represent an odd decimal number.\"\"\"\n    odd_count = 0\n    current_s = s\n    for _ in range(n):\n        current_s = _rotate_string(current_s)\n        decimal_value = _binary_to_decimal(current_s)\n        if decimal_value % 2 != 0:\n            odd_count += 1\n    return odd_count"}
